45,"_1875":36978},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_9127":111,"_25351":34,"_21542":36980,"_5":25505,"_17356":36745,"_1875":36981},[],"`-l`, `--local-chart-path`",{"_9127":112,"_25351":34,"_21542":36983,"_5":25505,"_17356":36745,"_1875":3528},[],{"_9127":113,"_25351":34,"_21542":36985,"_5":25505,"_17356":36745,"_1875":36986},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_9127":114,"_25351":34,"_21542":36988,"_5":25505,"_17356":36749,"_1875":36989},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_9127":115,"_25351":34,"_21542":36991,"_5":25505,"_17356":36749,"_1875":36992},[],"`microk8s`",{"_9127":116,"_25351":34,"_21542":36994,"_5":25505,"_17356":36749,"_1875":36995},[],"`k3s`",{"_9127":117,"_25351":34,"_21542":36997,"_5":25505,"_17356":36749,"_1875":36998},[],"`kind`",{"_9127":118,"_25351":34,"_21542":37000,"_5":25505,"_17356":36749,"_1875":37001},[],"Kubernetes estándar",{"_9127":119,"_25351":34,"_21542":37003,"_5":25505,"_17356":36749,"_1875":37004},[],"Comportamientos específicos:",{"_9127":120,"_25351":34,"_21542":37006,"_5":25505,"_17356":36749,"_1875":37007},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_9127":121,"_25351":34,"_21542":37009,"_5":25505,"_17356":36749,"_1875":37010},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_9127":122,"_25351":34,"_21542":37012,"_5":25505,"_17356":36753,"_1875":37013},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_9127":123,"_25351":34,"_21542":37015,"_5":25505,"_17356":36753,"_1875":37016},[],"Requisitos generales:",{"_9127":124,"_25351":34,"_21542":37018,"_5":25505,"_17356":36753,"_1875":37019},[],"`yq`",{"_9127":125,"_25351":34,"_21542":37021,"_5":25505,"_17356":36753,"_1875":37022},[],"CLI de la distribución detectada",{"_9127":126,"_25351":34,"_21542":37024,"_5":25505,"_17356":36753,"_1875":37025},[],"Requisitos específicos:",{"_9127":127,"_25351":34,"_21542":37027,"_5":25505,"_17356":36753,"_1875":37028},[],"Distribución",{"_9127":128,"_25351":34,"_21542":37030,"_5":25505,"_17356":36753,"_1875":37031},[],"Herramientas requeridas",{"_9127":129,"_25351":34,"_21542":37033,"_5":25505,"_17356":36753,"_1875":36995},[],{"_9127":130,"_25351":34,"_21542":37035,"_5":25505,"_17356":36753,"_1875":37036},[],"`kubectl`, `helm`",{"_9127":131,"_25351":34,"_21542":37038,"_5":25505,"_17356":36753,"_1875":36992},[],{"_9127":132,"_25351":34,"_21542":37040,"_5":25505,"_17356":36753,"_1875":37041},[],"`microk8s kubectl`, `microk8s helm`",{"_9127":133,"_25351":34,"_21542":37043,"_5":25505,"_17356":36757,"_1875":37044},[],"Se valida que estén habilitados:",{"_9127":134,"_25351":34,"_21542":37046,"_5":25505,"_17356":36757,"_1875":37047},[],"`helm`",{"_9127":135,"_25351":34,"_21542":37049,"_5":25505,"_17356":36757,"_1875":37050},[],"`hostpath-storage`",{"_9127":136,"_25351":34,"_21542":37052,"_5":25505,"_17356":36757,"_1875":37053},[],"`dns`",{"_9127":137,"_25351":34,"_21542":37055,"_5":25505,"_17356":36757,"_1875":37056},[],"`cert-manager`",{"_9127":138,"_25351":34,"_21542":37058,"_5":25505,"_17356":36757,"_1875":37059},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_9127":139,"_25351":34,"_21542":37061,"_5":25505,"_17356":36765,"_1875":37062},[],"La función `request_config_data` solicita:",{"_9127":140,"_25351":34,"_21542":37064,"_5":25505,"_17356":36765,"_1875":37065},[],"Dominio Lamassu",{"_9127":141,"_25351":34,"_21542":37067,"_5":25505,"_17356":36765,"_1875":37068},[],"Usuario y contraseña admin PostgreSQL",{"_9127":142,"_25351":34,"_21542":37070,"_5":25505,"_17356":36765,"_1875":37071},[],"Usuario y contraseña admin RabbitMQ",{"_9127":143,"_25351":34,"_21542":37073,"_5":25505,"_17356":36765,"_1875":37074},[],"Usuario y contraseña admin Keycloak",{"_9127":144,"_25351":34,"_21542":37076,"_5":25505,"_17356":36765,"_1875":37077},[],"Namespace Kubernetes",{"_9127":145,"_25351":34,"_21542":37079,"_5":25505,"_17356":36769,"_1875":37080},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_9127":146,"_25351":34,"_21542":37082,"_5":25505,"_17356":36769,"_1875":37083},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_9127":147,"_25351":34,"_21542":37085,"_5":25505,"_17356":36773,"_1875":37086},[],"El script admite dos estrategias para obtener charts Helm.",{"_9127":148,"_25351":34,"_21542":37088,"_5":25505,"_17356":36777,"_1875":37089},[],"Los charts se descargan desde repositorios remotos.",{"_9127":149,"_25351":34,"_21542":37091,"_5":25505,"_17356":36781,"_1875":37092},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_9127":150,"_25351":34,"_21542":37094,"_5":25505,"_17356":36781,"_1875":36949},[],{"_9127":151,"_25351":34,"_21542":37096,"_5":25505,"_17356":36781,"_1875":36957},[],{"_9127":152,"_25351":34,"_21542":37098,"_5":25505,"_17356":36781,"_1875":36965},[],{"_9127":153,"_25351":34,"_21542":37100,"_5":25505,"_17356":36781,"_1875":36973},[],{"_9127":154,"_25351":34,"_21542":37102,"_5":25505,"_17356":36781,"_1875":37103},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_9127":155,"_25351":34,"_21542":37105,"_5":25505,"_17356":36781,"_1875":37106},[],"En este modo se fuerza:",{"_9127":156,"_25351":34,"_21542":37108,"_5":25505,"_17356":36789,"_1875":37109},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_9127":157,"_25351":34,"_21542":37111,"_5":25505,"_17356":36789,"_1875":37112},[],"Versión del chart: `0.19.0`",{"_9127":158,"_25351":34,"_21542":37114,"_5":25505,"_17356":36789,"_1875":37115},[],"Release: `postgres`",{"_9127":159,"_25351":34,"_21542":37117,"_5":25505,"_17356":36789,"_1875":37118},[],"`fullnameOverride: \"postgresql\"`",{"_9127":160,"_25351":34,"_21542":37120,"_5":25505,"_17356":36789,"_1875":37121},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_9127":161,"_25351":34,"_21542":37123,"_5":25505,"_17356":36789,"_1875":37124},[],"Base de datos",{"_9127":162,"_25351":34,"_21542":37126,"_5":25505,"_17356":36789,"_1875":37127},[],"Servicio",{"_9127":163,"_25351":34,"_21542":37129,"_5":25505,"_17356":36789,"_1875":37130},[],"`auth`",{"_9127":164,"_25351":34,"_21542":37132,"_5":25505,"_17356":36789,"_1875":36842},[],{"_9127":165,"_25351":34,"_21542":37134,"_5":25505,"_17356":36789,"_1875":37135},[],"`alerts`",{"_9127":166,"_25351":34,"_21542":37137,"_5":25505,"_17356":36789,"_1875":37138},[],"Alerts",{"_9127":167,"_25351":34,"_21542":37140,"_5":25505,"_17356":36789,"_1875":37141},[],"`ca`",{"_9127":168,"_25351":34,"_21542":37143,"_5":25505,"_17356":36789,"_1875":37144},[],"CA",{"_9127":169,"_25351":34,"_21542":37146,"_5":25505,"_17356":36789,"_1875":37147},[],"`va`",{"_9127":170,"_25351":34,"_21542":37149,"_5":25505,"_17356":36789,"_1875":37150},[],"VA",{"_9127":171,"_25351":34,"_21542":37152,"_5":25505,"_17356":36789,"_1875":37153},[],"`cloudproxy`",{"_9127":172,"_25351":34,"_21542":37155,"_5":25505,"_17356":36789,"_1875":37156},[],"Cloud Proxy",{"_9127":173,"_25351":34,"_21542":37158,"_5":25505,"_17356":36789,"_1875":37159},[],"`devicemanager`",{"_9127":174,"_25351":34,"_21542":37161,"_5":25505,"_17356":36789,"_1875":37162},[],"Device Manager",{"_9127":175,"_25351":34,"_21542":37164,"_5":25505,"_17356":36789,"_1875":37165},[],"`dmsmanager`",{"_9127":176,"_25351":34,"_21542":37167,"_5":25505,"_17356":36789,"_1875":37168},[],"DMS Manager",{"_9127":177,"_25351":34,"_21542":37170,"_5":25505,"_17356":36789,"_1875":37171},[],"`kms`",{"_9127":178,"_25351":34,"_21542":37173,"_5":25505,"_17356":36789,"_1875":37174},[],"KMS",{"_9127":179,"_25351":34,"_21542":37176,"_5":25505,"_17356":36793,"_1875":37177},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_9127":180,"_25351":34,"_21542":37179,"_5":25505,"_17356":36793,"_1875":37180},[],"Versión del chart: `0.20.0`",{"_9127":181,"_25351":34,"_21542":37182,"_5":25505,"_17356":36793,"_1875":37183},[],"Release: `auth`",{"_9127":182,"_25351":34,"_21542":37185,"_5":25505,"_17356":36793,"_1875":37186},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_9127":183,"_25351":34,"_21542":37188,"_5":25505,"_17356":36793,"_1875":37189},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_9127":184,"_25351":34,"_21542":37191,"_5":25505,"_17356":36793,"_1875":37192},[],"`httpRelativePath: /auth/`",{"_9127":185,"_25351":34,"_21542":37194,"_5":25505,"_17356":36793,"_1875":37195},[],"`proxyHeaders: xforwarded`",{"_9127":186,"_25351":34,"_21542":37197,"_5":25505,"_17356":36793,"_1875":37198},[],"Configuración automática del realm `lamassu`:",{"_9127":187,"_25351":34,"_21542":37200,"_5":25505,"_17356":36793,"_1875":37201},[],"Rol: `pki-admin`",{"_9127":188,"_25351":34,"_21542":37203,"_5":25505,"_17356":36793,"_1875":37204},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_9127":189,"_25351":34,"_21542":37206,"_5":25505,"_17356":36793,"_1875":37207},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_9127":190,"_25351":34,"_21542":37209,"_5":25505,"_17356":36793,"_1875":37210},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_9127":191,"_25351":34,"_21542":37212,"_5":25505,"_17356":36793,"_1875":37213},[],"`github.com/lamassuiot/keycloak-theme`",{"_9127":192,"_25351":34,"_21542":37215,"_5":25505,"_17356":36797,"_1875":37216},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_9127":193,"_25351":34,"_21542":37218,"_5":25505,"_17356":36797,"_1875":37180},[],{"_9127":194,"_25351":34,"_21542":37220,"_5":25505,"_17356":36797,"_1875":37221},[],"Release: `rabbitmq`",{"_9127":195,"_25351":34,"_21542":37223,"_5":25505,"_17356":36797,"_1875":37224},[],"`fullnameOverride: \"rabbitmq\"`",{"_9127":196,"_25351":34,"_21542":37226,"_5":25505,"_17356":36797,"_1875":37227},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_9127":197,"_25351":34,"_21542":37229,"_5":25505,"_17356":36801,"_1875":37230},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_9127":198,"_25351":34,"_21542":37232,"_5":25505,"_17356":36801,"_1875":37233},[],"Configuraciones principales:",{"_9127":199,"_25351":34,"_21542":37235,"_5":25505,"_17356":36801,"_1875":37236},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_9127":200,"_25351":34,"_21542":37238,"_5":25505,"_17356":36801,"_1875":37239},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_9127":201,"_25351":34,"_21542":37241,"_5":25505,"_17356":36801,"_1875":37242},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_9127":202,"_25351":34,"_21542":37244,"_5":25505,"_17356":36801,"_1875":37245},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_9127":203,"_25351":34,"_21542":37247,"_5":25505,"_17356":36801,"_1875":37248},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_9127":204,"_25351":34,"_21542":37250,"_5":25505,"_17356":36801,"_1875":37251},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_9127":205,"_25351":34,"_21542":37253,"_5":25505,"_17356":36801,"_1875":37254},[],"Dominios CA: valor de `--domain`",{"_9127":206,"_25351":34,"_21542":37256,"_5":25505,"_17356":36801,"_1875":37257},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_9127":207,"_25351":34,"_21542":37259,"_5":25505,"_17356":36801,"_1875":37260},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_9127":208,"_25351":34,"_21542":37262,"_5":25505,"_17356":36801,"_1875":37263},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_9127":209,"_25351":34,"_21542":37265,"_5":25505,"_17356":36809,"_1875":37266},[],"Si se proporcionan:",{"_9127":210,"_25351":34,"_21542":37268,"_5":25505,"_17356":36809,"_1875":36933},[],{"_9127":211,"_25351":34,"_21542":37270,"_5":25505,"_17356":36809,"_1875":36941},[],{"_9127":212,"_25351":34,"_21542":37272,"_5":25505,"_17356":36809,"_1875":37273},[],"Se crea un secret Kubernetes:",{"_9127":213,"_25351":34,"_21542":37275,"_5":25505,"_17356":36809,"_1875":37276},[],"`downstream-provided-crt`",{"_9127":214,"_25351":34,"_21542":37278,"_5":25505,"_17356":36809,"_1875":37279},[],"Y se configura:",{"_9127":215,"_25351":34,"_21542":37281,"_5":25505,"_17356":36813,"_1875":37282},[],"Si no se proporciona certificado:",{"_9127":216,"_25351":34,"_21542":37284,"_5":25505,"_17356":36813,"_1875":37285},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_9127":217,"_25351":34,"_21542":37287,"_5":25505,"_17356":36813,"_1875":37288},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_9127":218,"_25351":34,"_21542":37290,"_5":25505,"_17356":36817,"_1875":37291},[],"En caso de éxito, se muestra:",{"_9127":219,"_25351":34,"_21542":37293,"_5":25505,"_17356":36817,"_1875":37294},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_9127":220,"_25351":34,"_21542":37296,"_5":25505,"_17356":36817,"_1875":37297},[],"Credenciales iniciales: `lamassu / lamassu`",{"_9127":221,"_25351":34,"_21542":37299,"_5":25505,"_17356":36817,"_1875":37300},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_9127":222,"_25351":34,"_21542":37302,"_5":25505,"_17356":36817,"_1875":37303},[],"Credenciales admin de Keycloak",{"_9127":223,"_25351":34,"_21542":37305,"_5":25505,"_17356":36817,"_1875":37306},[],"El usuario `lamassu` se crea con:",{"_9127":224,"_25351":34,"_21542":37308,"_5":25505,"_17356":36817,"_1875":37309},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_9127":225,"_25351":34,"_21542":37311,"_5":25505,"_17356":36821,"_1875":37312},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_9127":226,"_25351":34,"_21542":37314,"_5":25505,"_17356":36821,"_1875":37315},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_9127":227,"_25351":34,"_21542":37317,"_5":25505,"_17356":36821,"_1875":37318},[],"Ejemplo:",{"_9127":228,"_25351":34,"_21542":37320,"_5":25505,"_17356":36821,"_1875":37321},[],"En este escenario:",{"_9127":229,"_25351":34,"_21542":37323,"_5":25505,"_17356":36821,"_1875":37324},[],"`-n`: modo no interactivo",{"_9127":230,"_25351":34,"_21542":37326,"_5":25505,"_17356":36821,"_1875":37327},[],"`-ns`: namespace específico",{"_9127":231,"_25351":34,"_21542":37329,"_5":25505,"_17356":36821,"_1875":37330},[],"`-d`: dominio de CI",{"_9127":232,"_25351":34,"_21542":37332,"_5":25505,"_17356":36821,"_1875":37333},[],"`-l`: chart local",{"_9127":233,"_25351":34,"_21542":37335,"_5":25505,"_17356":36829,"_1875":37336},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_9127":234,"_25351":34,"_21542":37338,"_5":25505,"_17356":36829,"_1875":37339},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_9127":235,"_25351":235,"_5":25500,"_1875":37341,"_25513":37342,"_21542":37343,"_17356":235},"Introducción",[36657,36658,36709],[],{"_9127":236,"_25351":235,"_21542":37345,"_5":25505,"_17356":235,"_1875":37346},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_9127":237,"_25351":235,"_5":25510,"_21542":37348,"_17356":37349,"_1875":37350},[],"/docs/pr-preview/pr-24/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_9127":238,"_25351":235,"_5":25510,"_21542":37352,"_17356":37353,"_1875":37354},[],"/docs/pr-preview/pr-24/despliegue/onprem#quickstart","Quickstart",{"_9127":239,"_25351":235,"_5":25510,"_21542":37356,"_17356":37357,"_1875":37358},[],"/docs/pr-preview/pr-24/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_9127":240,"_25351":235,"_5":25510,"_21542":37360,"_17356":37361,"_1875":37362},[],"/docs/pr-preview/pr-24/despliegue/onprem#requisitos-previos","Requisitos previos",{"_9127":241,"_25351":235,"_5":25510,"_21542":37364,"_17356":37365,"_1875":37366},[],"/docs/pr-preview/pr-24/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_9127":242,"_25351":235,"_5":25510,"_21542":37368,"_17356":37369,"_1875":37370},[],"/docs/pr-preview/pr-24/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_9127":243,"_25351":235,"_5":25510,"_21542":37372,"_17356":37373,"_1875":37374},[],"/docs/pr-preview/pr-24/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_9127":244,"_25351":235,"_5":25510,"_21542":37376,"_17356":37377,"_1875":37378},[],"/docs/pr-preview/pr-24/despliegue/onprem#arquitectura","Arquitectura",{"_9127":245,"_25351":235,"_5":25510,"_21542":37380,"_17356":37381,"_1875":37382},[],"/docs/pr-preview/pr-24/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_9127":246,"_25351":235,"_5":25510,"_21542":37384,"_17356":37385,"_1875":37386},[],"/docs/pr-preview/pr-24/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_9127":247,"_25351":235,"_5":25510,"_21542":37388,"_17356":37389,"_1875":37390},[],"/docs/pr-preview/pr-24/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_9127":248,"_25351":235,"_5":25510,"_21542":37392,"_17356":37393,"_1875":37394},[],"/docs/pr-preview/pr-24/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_9127":249,"_25351":235,"_5":25510,"_21542":37396,"_17356":37397,"_1875":37398},[],"/docs/pr-preview/pr-24/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_9127":250,"_25351":235,"_5":25510,"_21542":37400,"_17356":37401,"_1875":37402},[],"/docs/pr-preview/pr-24/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_9127":251,"_25351":235,"_5":25510,"_21542":37404,"_17356":37405,"_1875":37406},[],"/docs/pr-preview/pr-24/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_9127":252,"_25351":235,"_21542":37408,"_5":25505,"_17356":37349,"_1875":37409},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_9127":253,"_25351":235,"_21542":37411,"_5":25505,"_17356":37349,"_1875":37412},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_9127":254,"_25351":235,"_21542":37414,"_5":25505,"_17356":37349,"_1875":37415},[],"el chart principal de Lamassu",{"_9127":255,"_25351":235,"_21542":37417,"_5":25505,"_17356":37349,"_1875":37418},[],"un chart auxiliar de SoftHSM",{"_9127":256,"_25351":235,"_21542":37420,"_5":25505,"_17356":37349,"_1875":37421},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_9127":257,"_25351":235,"_21542":37423,"_5":25505,"_17356":37353,"_1875":37424},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_9127":258,"_25351":235,"_21542":37426,"_5":25505,"_17356":37353,"_1875":37427},[],"Ese flujo:",{"_9127":259,"_25351":235,"_21542":37429,"_5":25505,"_17356":37353,"_1875":37430},[],"crea o reutiliza el namespace indicado",{"_9127":260,"_25351":235,"_21542":37432,"_5":25505,"_17356":37353,"_1875":37433},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_9127":261,"_25351":235,"_21542":37435,"_5":25505,"_17356":37353,"_1875":37436},[],"despliega el chart de Lamassu",{"_9127":262,"_25351":235,"_21542":37438,"_5":25505,"_17356":37353,"_1875":37439},[],"deja la UI expuesta en `https://<dominio>`",{"_9127":263,"_25351":235,"_21542":37441,"_5":25505,"_17356":37353,"_1875":37442},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_9127":264,"_25351":235,"_21542":37444,"_5":25505,"_17356":37357,"_1875":37445},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_9127":265,"_25351":235,"_21542":37447,"_5":25505,"_17356":37357,"_1875":37448},[],"`ui`",{"_9127":266,"_25351":235,"_21542":37450,"_5":25505,"_17356":37357,"_1875":37141},[],{"_9127":267,"_25351":235,"_21542":37452,"_5":25505,"_17356":37357,"_1875":37147},[],{"_9127":268,"_25351":235,"_21542":37454,"_5":25505,"_17356":37357,"_1875":37171},[],{"_9127":269,"_25351":235,"_21542":37456,"_5":25505,"_17356":37357,"_1875":37457},[],"`device-manager`",{"_9127":270,"_25351":235,"_21542":37459,"_5":25505,"_17356":37357,"_1875":37460},[],"`dms-manager`",{"_9127":271,"_25351":235,"_21542":37462,"_5":25505,"_17356":37357,"_1875":37135},[],{"_9127":272,"_25351":235,"_21542":37464,"_5":25505,"_17356":37357,"_1875":37465},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_9127":273,"_25351":235,"_21542":37467,"_5":25505,"_17356":37357,"_1875":37468},[],"job de migraciones de base de datos",{"_9127":274,"_25351":235,"_21542":37470,"_5":25505,"_17356":37361,"_1875":37471},[],"Clúster Kubernetes `1.19+`",{"_9127":275,"_25351":235,"_21542":37473,"_5":25505,"_17356":37361,"_1875":37474},[],"`kubectl` configurado con acceso al clúster",{"_9127":276,"_25351":235,"_21542":37476,"_5":25505,"_17356":37361,"_1875":37477},[],"Helm `3.2.0+`",{"_9127":277,"_25351":235,"_21542":37479,"_5":25505,"_17356":37361,"_1875":37480},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_9127":278,"_25351":235,"_21542":37482,"_5":25505,"_17356":37361,"_1875":37483},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_9127":279,"_25351":235,"_21542":37485,"_5":25505,"_17356":37361,"_1875":37486},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_9127":280,"_25351":235,"_21542":37488,"_5":25505,"_17356":37361,"_1875":37489},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_9127":281,"_25351":235,"_21542":37491,"_5":25505,"_17356":37365,"_1875":37492},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_9127":282,"_25351":235,"_21542":37494,"_5":25505,"_17356":37369,"_1875":37495},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_9127":283,"_25351":235,"_21542":37497,"_5":25505,"_17356":37373,"_1875":37498},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_9127":284,"_25351":235,"_21542":37500,"_5":25505,"_17356":37377,"_1875":37501},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_9127":285,"_25351":235,"_21542":37503,"_5":25505,"_17356":37377,"_1875":37504},[],"Dependencias externas requeridas por el chart principal:",{"_9127":286,"_25351":235,"_21542":37506,"_5":25505,"_17356":37377,"_1875":36839},[],{"_9127":287,"_25351":235,"_21542":37508,"_5":25505,"_17356":37377,"_1875":36845},[],{"_9127":288,"_25351":235,"_21542":37510,"_5":25505,"_17356":37377,"_1875":37511},[],"proveedor OIDC, típicamente Keycloak",{"_9127":289,"_25351":235,"_21542":37513,"_5":25505,"_17356":37377,"_1875":37514},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_9127":290,"_25351":235,"_21542":37516,"_5":25505,"_17356":37381,"_1875":37517},[],"Agregar el repositorio Helm:",{"_9127":291,"_25351":235,"_21542":37519,"_5":25505,"_17356":37381,"_1875":37520},[],"O instalar desde una copia local del repositorio:",{"_9127":292,"_25351":235,"_21542":37522,"_5":25505,"_17356":37385,"_1875":37523},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_9127":293,"_25351":235,"_21542":37525,"_5":25505,"_17356":37385,"_1875":37526},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_9127":294,"_25351":235,"_21542":37528,"_5":25505,"_17356":37385,"_1875":37529},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_9127":295,"_25351":235,"_21542":37531,"_5":25505,"_17356":37385,"_1875":37532},[],"`auth.oidc.frontend.authority`",{"_9127":296,"_25351":235,"_21542":37534,"_5":25505,"_17356":37385,"_1875":37535},[],"`auth.oidc.apiGateway.jwks`",{"_9127":297,"_25351":235,"_21542":37537,"_5":25505,"_17356":37385,"_1875":37538},[],"`services.ca.domains`",{"_9127":298,"_25351":235,"_21542":37540,"_5":25505,"_17356":37385,"_1875":37541},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_9127":299,"_25351":235,"_21542":37543,"_5":25505,"_17356":37385,"_1875":37544},[],"`tls.*` según se use `certManager` o certificado externo",{"_9127":300,"_25351":235,"_21542":37546,"_5":25505,"_17356":37385,"_1875":37547},[],"Ejemplo base:",{"_9127":301,"_25351":235,"_21542":37549,"_5":25505,"_17356":37389,"_1875":37550},[],"Área",{"_9127":302,"_25351":235,"_21542":37552,"_5":25505,"_17356":37389,"_1875":37553},[],"Valores clave",{"_9127":303,"_25351":235,"_21542":37555,"_5":25505,"_17356":37389,"_1875":37556},[],"Uso",{"_9127":304,"_25351":235,"_21542":37558,"_5":25505,"_17356":37389,"_1875":37559},[],"TLS",{"_9127":305,"_25351":235,"_21542":37561,"_5":25505,"_17356":37389,"_1875":37562},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_9127":306,"_25351":235,"_21542":37564,"_5":25505,"_17356":37389,"_1875":37565},[],"Certificado downstream del Gateway",{"_9127":307,"_25351":235,"_21542":37567,"_5":25505,"_17356":37389,"_1875":37568},[],"Gateway",{"_9127":308,"_25351":235,"_21542":37570,"_5":25505,"_17356":37389,"_1875":37571},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_9127":309,"_25351":235,"_21542":37573,"_5":25505,"_17356":37389,"_1875":37574},[],"Exposición de UI y APIs vía Envoy Gateway",{"_9127":310,"_25351":235,"_21542":37576,"_5":25505,"_17356":37389,"_1875":37124},[],{"_9127":311,"_25351":235,"_21542":37578,"_5":25505,"_17356":37389,"_1875":37579},[],"`postgres.*`",{"_9127":312,"_25351":235,"_21542":37581,"_5":25505,"_17356":37389,"_1875":37582},[],"Conexión a PostgreSQL externa",{"_9127":313,"_25351":235,"_21542":37584,"_5":25505,"_17356":37389,"_1875":37585},[],"Mensajería",{"_9127":314,"_25351":235,"_21542":37587,"_5":25505,"_17356":37389,"_1875":37588},[],"`amqp.*`",{"_9127":315,"_25351":235,"_21542":37590,"_5":25505,"_17356":37389,"_1875":37591},[],"Conexión a RabbitMQ",{"_9127":316,"_25351":235,"_21542":37593,"_5":25505,"_17356":37389,"_1875":37594},[],"OIDC",{"_9127":317,"_25351":235,"_21542":37596,"_5":25505,"_17356":37389,"_1875":37597},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_9127":318,"_25351":235,"_21542":37599,"_5":25505,"_17356":37389,"_1875":37600},[],"Login de UI y validación JWT en el Gateway",{"_9127":319,"_25351":235,"_21542":37602,"_5":25505,"_17356":37389,"_1875":37144},[],{"_9127":320,"_25351":235,"_21542":37604,"_5":25505,"_17356":37389,"_1875":37538},[],{"_9127":321,"_25351":235,"_21542":37606,"_5":25505,"_17356":37389,"_1875":37607},[],"Dominios autorizados para CA y certificados",{"_9127":322,"_25351":235,"_21542":37609,"_5":25505,"_17356":37389,"_1875":37174},[],{"_9127":323,"_25351":235,"_21542":37611,"_5":25505,"_17356":37389,"_1875":37612},[],"`services.kms.cryptoEngines.*`",{"_9127":324,"_25351":235,"_21542":37614,"_5":25505,"_17356":37389,"_1875":37615},[],"Motor criptográfico y almacenamiento de claves",{"_9127":325,"_25351":235,"_21542":37617,"_5":25505,"_17356":37389,"_1875":37138},[],{"_9127":326,"_25351":235,"_21542":37619,"_5":25505,"_17356":37389,"_1875":37620},[],"`services.alerts.smtp_server.*`",{"_9127":327,"_25351":235,"_21542":37622,"_5":25505,"_17356":37389,"_1875":37623},[],"Envío de correo para alertas",{"_9127":328,"_25351":235,"_21542":37625,"_5":25505,"_17356":37393,"_1875":37626},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_9127":329,"_25351":235,"_21542":37628,"_5":25505,"_17356":37393,"_1875":37629},[],"La prueba comprueba al menos:",{"_9127":330,"_25351":235,"_21542":37631,"_5":25505,"_17356":37393,"_1875":37632},[],"salud de `ca`",{"_9127":331,"_25351":235,"_21542":37634,"_5":25505,"_17356":37393,"_1875":37635},[],"salud de `dms-manager`",{"_9127":332,"_25351":235,"_21542":37637,"_5":25505,"_17356":37393,"_1875":37638},[],"salud de `device-manager`",{"_9127":333,"_25351":235,"_21542":37640,"_5":25505,"_17356":37393,"_1875":37641},[],"salud de `va`",{"_9127":334,"_25351":235,"_21542":37643,"_5":25505,"_17356":37393,"_1875":37644},[],"respuesta HTML esperada del servicio `ui`",{"_9127":335,"_25351":235,"_21542":37646,"_5":25505,"_17356":37397,"_1875":37647},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_9127":336,"_25351":235,"_21542":37649,"_5":25505,"_17356":37397,"_1875":37650},[],"`charts/lamassu`: chart principal de Lamassu",{"_9127":337,"_25351":235,"_21542":37652,"_5":25505,"_17356":37397,"_1875":37653},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_9127":338,"_25351":235,"_21542":37655,"_5":25505,"_17356":37397,"_1875":37656},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_9127":339,"_25351":235,"_21542":37658,"_5":25505,"_17356":37401,"_1875":37659},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_9127":340,"_25351":235,"_21542":37661,"_5":25505,"_17356":37405,"_1875":37662},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_9127":341,"_25351":341,"_5":25500,"_1875":37664,"_25513":37665,"_21542":37666,"_17356":341},"SaaS · Suscripción",[36657,36658,36716],[],{"_9127":342,"_25351":341,"_21542":37668,"_5":25505,"_17356":341,"_1875":37669},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_9127":343,"_25351":341,"_5":25510,"_21542":37671,"_17356":37672,"_1875":37673},[],"/docs/pr-preview/pr-24/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_9127":344,"_25351":341,"_5":25510,"_21542":37675,"_17356":37676,"_1875":37677},[],"/docs/pr-preview/pr-24/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_9127":345,"_25351":341,"_5":25510,"_21542":37679,"_17356":37680,"_1875":37681},[],"/docs/pr-preview/pr-24/despliegue/saas#planes-disponibles","Planes disponibles",{"_9127":346,"_25351":341,"_5":25510,"_21542":37683,"_17356":37684,"_1875":37685},[],"/docs/pr-preview/pr-24/despliegue/saas#contacto","Contacto",{"_9127":347,"_25351":341,"_21542":37687,"_5":25505,"_17356":37672,"_1875":37688},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_9127":348,"_25351":341,"_21542":37690,"_5":25505,"_17356":37676,"_1875":37691},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_9127":349,"_25351":341,"_21542":37693,"_5":25505,"_17356":37676,"_1875":37694},[],"Alta disponibilidad y backups automáticos",{"_9127":350,"_25351":341,"_21542":37696,"_5":25505,"_17356":37676,"_1875":37697},[],"Actualizaciones automáticas a las últimas versiones",{"_9127":351,"_25351":341,"_21542":37699,"_5":25505,"_17356":37676,"_1875":37700},[],"Soporte técnico incluido",{"_9127":352,"_25351":341,"_21542":37702,"_5":25505,"_17356":37676,"_1875":37703},[],"SLA garantizado",{"_9127":353,"_25351":341,"_21542":37705,"_5":25505,"_17356":37680,"_1875":37706},[],"Plan",{"_9127":354,"_25351":341,"_21542":37708,"_5":25505,"_17356":37680,"_1875":37709},[],"Dispositivos",{"_9127":355,"_25351":341,"_21542":37711,"_5":25505,"_17356":37680,"_1875":37712},[],"Soporte",{"_9127":356,"_25351":341,"_21542":37714,"_5":25505,"_17356":37680,"_1875":37715},[],"SLA",{"_9127":357,"_25351":341,"_21542":37717,"_5":25505,"_17356":37680,"_1875":37718},[],"Starter",{"_9127":358,"_25351":341,"_21542":37720,"_5":25505,"_17356":37680,"_1875":37721},[],"Hasta 1.000",{"_9127":359,"_25351":341,"_21542":37723,"_5":25505,"_17356":37680,"_1875":37724},[],"Email",{"_9127":360,"_25351":341,"_21542":37726,"_5":25505,"_17356":37680,"_1875":37727},[],"99,5%",{"_9127":361,"_25351":341,"_21542":37729,"_5":25505,"_17356":37680,"_1875":37730},[],"Professional",{"_9127":362,"_25351":341,"_21542":37732,"_5":25505,"_17356":37680,"_1875":37733},[],"Hasta 10.000",{"_9127":363,"_25351":341,"_21542":37735,"_5":25505,"_17356":37680,"_1875":37736},[],"Email + Chat",{"_9127":364,"_25351":341,"_21542":37738,"_5":25505,"_17356":37680,"_1875":37739},[],"99,9%",{"_9127":365,"_25351":341,"_21542":37741,"_5":25505,"_17356":37680,"_1875":37742},[],"Enterprise",{"_9127":366,"_25351":341,"_21542":37744,"_5":25505,"_17356":37680,"_1875":37745},[],"Ilimitado",{"_9127":367,"_25351":341,"_21542":37747,"_5":25505,"_17356":37680,"_1875":37748},[],"Dedicado",{"_9127":368,"_25351":341,"_21542":37750,"_5":25505,"_17356":37680,"_1875":37751},[],"99,99%",{"_9127":369,"_25351":341,"_21542":37753,"_5":25505,"_17356":37684,"_1875":37754},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_9127":370,"_25351":370,"_5":25500,"_1875":37756,"_25513":37757,"_21542":37758,"_17356":370},"Manual de Usuario",[36657,37756],[],{"_9127":371,"_25351":370,"_21542":37760,"_5":25505,"_17356":370,"_1875":37761},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_9127":372,"_25351":370,"_5":25510,"_21542":37763,"_17356":37764,"_1875":37765},[],"/docs/pr-preview/pr-24/manual#servicios-core","Servicios Core",{"_9127":373,"_25351":370,"_5":25510,"_21542":37767,"_17356":37768,"_1875":37769},[],"/docs/pr-preview/pr-24/manual#integraciones-con-terceros","Integraciones con terceros",{"_9127":374,"_25351":370,"_21542":37771,"_5":25505,"_17356":370,"_1875":37772},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_9127":375,"_25351":370,"_21542":37774,"_5":25505,"_17356":37764,"_1875":37775},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_9127":376,"_25351":370,"_21542":37777,"_5":25505,"_17356":37764,"_1875":37778},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_9127":377,"_25351":370,"_21542":37780,"_5":25505,"_17356":37764,"_1875":37781},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_9127":378,"_25351":370,"_21542":37783,"_5":25505,"_17356":37764,"_1875":37784},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_9127":379,"_25351":370,"_21542":37786,"_5":25505,"_17356":37764,"_1875":37787},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_9127":380,"_25351":370,"_21542":37789,"_5":25505,"_17356":37764,"_1875":37790},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_9127":381,"_25351":370,"_21542":37792,"_5":25505,"_17356":37764,"_1875":37793},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_9127":382,"_25351":370,"_21542":37795,"_5":25505,"_17356":37768,"_1875":37796},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_9127":383,"_25351":383,"_5":25500,"_1875":37798,"_25513":37799,"_21542":37800,"_17356":383},"Integración con AWS IoT Core",[36657,37756,37769],[],{"_9127":384,"_25351":383,"_21542":37802,"_5":25505,"_17356":383,"_1875":37803},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_9127":385,"_25351":383,"_5":25510,"_21542":37805,"_17356":37806,"_1875":37807},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_9127":386,"_25351":383,"_5":25510,"_21542":37809,"_17356":37810,"_1875":37811},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_9127":387,"_25351":383,"_5":25510,"_21542":37813,"_17356":37814,"_1875":37815},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_9127":388,"_25351":383,"_5":25510,"_21542":37817,"_17356":37818,"_1875":37819},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_9127":389,"_25351":383,"_5":25510,"_21542":37821,"_17356":37822,"_1875":37823},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_9127":390,"_25351":383,"_5":25510,"_21542":37825,"_17356":37826,"_1875":37827},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_9127":391,"_25351":383,"_5":25510,"_21542":37829,"_17356":37830,"_1875":37831},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#primary-account","Primary Account",{"_9127":392,"_25351":383,"_5":25510,"_21542":37833,"_17356":37834,"_1875":37835},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_9127":393,"_25351":383,"_5":25510,"_21542":37837,"_17356":37838,"_1875":37839},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_9127":394,"_25351":383,"_5":25510,"_21542":37841,"_17356":37842,"_1875":37843},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#modo-none","Modo `none`",{"_9127":395,"_25351":383,"_5":25510,"_21542":37845,"_17356":37846,"_1875":37847},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#modo-auto","Modo `auto`",{"_9127":396,"_25351":383,"_5":25510,"_21542":37849,"_17356":37850,"_1875":37851},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_9127":397,"_25351":383,"_5":25510,"_21542":37853,"_17356":37854,"_1875":37855},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_9127":398,"_25351":383,"_5":25510,"_21542":37857,"_17356":37858,"_1875":37859},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_9127":399,"_25351":383,"_5":25510,"_21542":37861,"_17356":37862,"_1875":37863},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_9127":400,"_25351":383,"_5":25510,"_21542":37865,"_17356":37866,"_1875":37867},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_9127":401,"_25351":383,"_5":25510,"_21542":37869,"_17356":37870,"_1875":37871},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_9127":402,"_25351":383,"_5":25510,"_21542":37873,"_17356":37874,"_1875":37875},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_9127":403,"_25351":383,"_5":25510,"_21542":37877,"_17356":37878,"_1875":37879},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_9127":404,"_25351":383,"_5":25510,"_21542":37881,"_17356":37882,"_1875":37883},[],"/docs/pr-preview/pr-24/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_9127":405,"_25351":383,"_21542":37885,"_5":25505,"_17356":383,"_1875":37886},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_9127":406,"_25351":383,"_21542":37888,"_5":25505,"_17356":383,"_1875":37889},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_9127":407,"_25351":383,"_21542":37891,"_5":25505,"_17356":383,"_1875":37892},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_9127":408,"_25351":383,"_21542":37894,"_5":25505,"_17356":37806,"_1875":37895},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_9127":409,"_25351":383,"_21542":37897,"_5":25505,"_17356":37806,"_1875":37898},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_9127":410,"_25351":383,"_21542":37900,"_5":25505,"_17356":37806,"_1875":37901},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_9127":411,"_25351":383,"_21542":37903,"_5":25505,"_17356":37806,"_1875":37904},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_9127":412,"_25351":383,"_21542":37906,"_5":25505,"_17356":37810,"_1875":37907},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_9127":413,"_25351":383,"_21542":37909,"_5":25505,"_17356":37814,"_1875":37910},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_9127":414,"_25351":383,"_21542":37912,"_5":25505,"_17356":37814,"_1875":37913},[],"Acción IAM",{"_9127":415,"_25351":383,"_21542":37915,"_5":25505,"_17356":37814,"_1875":37916},[],"Propósito",{"_9127":416,"_25351":383,"_21542":37918,"_5":25505,"_17356":37814,"_1875":37919},[],"`iot:GetRegistrationCode`",{"_9127":417,"_25351":383,"_21542":37921,"_5":25505,"_17356":37814,"_1875":37922},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_9127":418,"_25351":383,"_21542":37924,"_5":25505,"_17356":37814,"_1875":37925},[],"`iot:RegisterCACertificate`",{"_9127":419,"_25351":383,"_21542":37927,"_5":25505,"_17356":37814,"_1875":37928},[],"Registrar la CA en AWS IoT",{"_9127":420,"_25351":383,"_21542":37930,"_5":25505,"_17356":37814,"_1875":37931},[],"`iot:DescribeCACertificate`",{"_9127":421,"_25351":383,"_21542":37933,"_5":25505,"_17356":37814,"_1875":37934},[],"Consultar el estado del registro de la CA",{"_9127":422,"_25351":383,"_21542":37936,"_5":25505,"_17356":37814,"_1875":37937},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_9127":423,"_25351":383,"_21542":37939,"_5":25505,"_17356":37814,"_1875":37940},[],"Crear o actualizar Things en IoT Core",{"_9127":424,"_25351":383,"_21542":37942,"_5":25505,"_17356":37814,"_1875":37943},[],"`iot:RegisterThing`",{"_9127":425,"_25351":383,"_21542":37945,"_5":25505,"_17356":37814,"_1875":37946},[],"Aprovisionar Things mediante plantilla",{"_9127":426,"_25351":383,"_21542":37948,"_5":25505,"_17356":37814,"_1875":37949},[],"`iot:RegisterCertificate`",{"_9127":427,"_25351":383,"_21542":37951,"_5":25505,"_17356":37814,"_1875":37952},[],"Registrar certificados de dispositivo",{"_9127":428,"_25351":383,"_21542":37954,"_5":25505,"_17356":37814,"_1875":37955},[],"`iot:UpdateCertificate`",{"_9127":429,"_25351":383,"_21542":37957,"_5":25505,"_17356":37814,"_1875":37958},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_9127":430,"_25351":383,"_21542":37960,"_5":25505,"_17356":37814,"_1875":37961},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_9127":431,"_25351":383,"_21542":37963,"_5":25505,"_17356":37814,"_1875":37964},[],"Crear y adjuntar políticas IoT",{"_9127":432,"_25351":383,"_21542":37966,"_5":25505,"_17356":37814,"_1875":37967},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_9127":433,"_25351":383,"_21542":37969,"_5":25505,"_17356":37814,"_1875":37970},[],"Gestionar grupos de Things",{"_9127":434,"_25351":383,"_21542":37972,"_5":25505,"_17356":37814,"_1875":37973},[],"`iot:CreateProvisioningTemplate`",{"_9127":435,"_25351":383,"_21542":37975,"_5":25505,"_17356":37814,"_1875":37976},[],"Crear plantillas JITP",{"_9127":436,"_25351":383,"_21542":37978,"_5":25505,"_17356":37814,"_1875":37979},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_9127":437,"_25351":383,"_21542":37981,"_5":25505,"_17356":37814,"_1875":37982},[],"Leer y escribir el Device Shadow",{"_9127":438,"_25351":383,"_21542":37984,"_5":25505,"_17356":37814,"_1875":37985},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_9127":439,"_25351":383,"_21542":37987,"_5":25505,"_17356":37818,"_1875":37988},[],"Parámetro",{"_9127":440,"_25351":383,"_21542":37990,"_5":25505,"_17356":37818,"_1875":37991},[],"Tipo",{"_9127":441,"_25351":383,"_21542":37993,"_5":25505,"_17356":37818,"_1875":37994},[],"Requerido",{"_9127":442,"_25351":383,"_21542":37996,"_5":25505,"_17356":37818,"_1875":36860},[],{"_9127":443,"_25351":383,"_21542":37998,"_5":25505,"_17356":37818,"_1875":37999},[],"`connector_id`",{"_9127":444,"_25351":383,"_21542":38001,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":445,"_25351":383,"_21542":38003,"_5":25505,"_17356":37818,"_1875":38004},[],"Sí",{"_9127":446,"_25351":383,"_21542":38006,"_5":25505,"_17356":37818,"_1875":38007},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_9127":447,"_25351":383,"_21542":38009,"_5":25505,"_17356":37818,"_1875":38010},[],"`aws_config.region`",{"_9127":448,"_25351":383,"_21542":38012,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":449,"_25351":383,"_21542":38014,"_5":25505,"_17356":37818,"_1875":38004},[],{"_9127":450,"_25351":383,"_21542":38016,"_5":25505,"_17356":37818,"_1875":38017},[],"Región AWS donde opera el conector.",{"_9127":451,"_25351":383,"_21542":38019,"_5":25505,"_17356":37818,"_1875":38020},[],"`aws_config.auth_method`",{"_9127":452,"_25351":383,"_21542":38022,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":453,"_25351":383,"_21542":38024,"_5":25505,"_17356":37818,"_1875":38004},[],{"_9127":454,"_25351":383,"_21542":38026,"_5":25505,"_17356":37818,"_1875":38027},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_9127":455,"_25351":383,"_21542":38029,"_5":25505,"_17356":37818,"_1875":38030},[],"`aws_config.access_key_id`",{"_9127":456,"_25351":383,"_21542":38032,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":457,"_25351":383,"_21542":38034,"_5":25505,"_17356":37818,"_1875":38035},[],"Solo con `auth_method=static`",{"_9127":458,"_25351":383,"_21542":38037,"_5":25505,"_17356":37818,"_1875":38038},[],"Clave de acceso AWS.",{"_9127":459,"_25351":383,"_21542":38040,"_5":25505,"_17356":37818,"_1875":38041},[],"`aws_config.secret_access_key`",{"_9127":460,"_25351":383,"_21542":38043,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":461,"_25351":383,"_21542":38045,"_5":25505,"_17356":37818,"_1875":38035},[],{"_9127":462,"_25351":383,"_21542":38047,"_5":25505,"_17356":37818,"_1875":38048},[],"Clave secreta AWS.",{"_9127":463,"_25351":383,"_21542":38050,"_5":25505,"_17356":37818,"_1875":38051},[],"`aws_config.session_token`",{"_9127":464,"_25351":383,"_21542":38053,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":465,"_25351":383,"_21542":38055,"_5":25505,"_17356":37818,"_1875":38056},[],"No",{"_9127":466,"_25351":383,"_21542":38058,"_5":25505,"_17356":37818,"_1875":38059},[],"Token de sesión (con `auth_method=static`).",{"_9127":467,"_25351":383,"_21542":38061,"_5":25505,"_17356":37818,"_1875":38062},[],"`aws_config.role_arn`",{"_9127":468,"_25351":383,"_21542":38064,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":469,"_25351":383,"_21542":38066,"_5":25505,"_17356":37818,"_1875":38067},[],"Solo con `auth_method=role`",{"_9127":470,"_25351":383,"_21542":38069,"_5":25505,"_17356":37818,"_1875":38070},[],"ARN del rol a asumir.",{"_9127":471,"_25351":383,"_21542":38072,"_5":25505,"_17356":37818,"_1875":38073},[],"`aws_config.endpoint_url`",{"_9127":472,"_25351":383,"_21542":38075,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":473,"_25351":383,"_21542":38077,"_5":25505,"_17356":37818,"_1875":38056},[],{"_9127":474,"_25351":383,"_21542":38079,"_5":25505,"_17356":37818,"_1875":38080},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_9127":475,"_25351":383,"_21542":38082,"_5":25505,"_17356":37818,"_1875":38083},[],"`subscriber_event_bus`",{"_9127":476,"_25351":383,"_21542":38085,"_5":25505,"_17356":37818,"_1875":21867},[],{"_9127":477,"_25351":383,"_21542":38087,"_5":25505,"_17356":37818,"_1875":38004},[],{"_9127":478,"_25351":383,"_21542":38089,"_5":25505,"_17356":37818,"_1875":38090},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_9127":479,"_25351":383,"_21542":38092,"_5":25505,"_17356":37818,"_1875":38093},[],"`dms_manager_client`",{"_9127":480,"_25351":383,"_21542":38095,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":481,"_25351":383,"_21542":38097,"_5":25505,"_17356":37818,"_1875":38004},[],{"_9127":482,"_25351":383,"_21542":38099,"_5":25505,"_17356":37818,"_1875":38100},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_9127":483,"_25351":383,"_21542":38102,"_5":25505,"_17356":37818,"_1875":38103},[],"`device_manager_client`",{"_9127":484,"_25351":383,"_21542":38105,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":485,"_25351":383,"_21542":38107,"_5":25505,"_17356":37818,"_1875":38004},[],{"_9127":486,"_25351":383,"_21542":38109,"_5":25505,"_17356":37818,"_1875":38110},[],"URL HTTP del Device Manager de Lamassu.",{"_9127":487,"_25351":383,"_21542":38112,"_5":25505,"_17356":37818,"_1875":38113},[],"`ca_client`",{"_9127":488,"_25351":383,"_21542":38115,"_5":25505,"_17356":37818,"_1875":13131},[],{"_9127":489,"_25351":383,"_21542":38117,"_5":25505,"_17356":37818,"_1875":38004},[],{"_9127":490,"_25351":383,"_21542":38119,"_5":25505,"_17356":37818,"_1875":38120},[],"URL HTTP del servicio de CA de Lamassu.",{"_9127":491,"_25351":383,"_21542":38122,"_5":25505,"_17356":37822,"_1875":38123},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_9127":492,"_25351":383,"_21542":38125,"_5":25505,"_17356":37826,"_1875":38126},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_9127":493,"_25351":383,"_21542":38128,"_5":25505,"_17356":37826,"_1875":38129},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_9127":494,"_25351":383,"_21542":38131,"_5":25505,"_17356":37830,"_1875":38132},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_9127":495,"_25351":383,"_21542":38134,"_5":25505,"_17356":37830,"_1875":38135},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_9127":496,"_25351":383,"_21542":38137,"_5":25505,"_17356":37830,"_1875":38138},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_9127":497,"_25351":383,"_21542":38140,"_5":25505,"_17356":37830,"_1875":38141},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_9127":498,"_25351":383,"_21542":38143,"_5":25505,"_17356":37830,"_1875":38144},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_9127":499,"_25351":383,"_21542":38146,"_5":25505,"_17356":37830,"_1875":38147},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_9127":500,"_25351":383,"_21542":38149,"_5":25505,"_17356":37834,"_1875":38150},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_9127":501,"_25351":383,"_21542":38152,"_5":25505,"_17356":37838,"_1875":38153},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_9127":502,"_25351":383,"_21542":38155,"_5":25505,"_17356":37838,"_1875":38156},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_9127":503,"_25351":383,"_21542":38158,"_5":25505,"_17356":37842,"_1875":38159},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_9127":504,"_25351":383,"_21542":38161,"_5":25505,"_17356":37846,"_1875":38162},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_9127":505,"_25351":383,"_21542":38164,"_5":25505,"_17356":37846,"_1875":38165},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_9127":506,"_25351":383,"_21542":38167,"_5":25505,"_17356":37846,"_1875":38168},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_9127":507,"_25351":383,"_21542":38170,"_5":25505,"_17356":37846,"_1875":38171},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_9127":508,"_25351":383,"_21542":38173,"_5":25505,"_17356":37846,"_1875":38174},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_9127":509,"_25351":383,"_21542":38176,"_5":25505,"_17356":37846,"_1875":38177},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_9127":510,"_25351":383,"_21542":38179,"_5":25505,"_17356":37850,"_1875":38180},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_9127":511,"_25351":383,"_21542":38182,"_5":25505,"_17356":37850,"_1875":38183},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_9127":512,"_25351":383,"_21542":38185,"_5":25505,"_17356":37850,"_1875":38186},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_9127":513,"_25351":383,"_21542":38188,"_5":25505,"_17356":37854,"_1875":38189},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_9127":514,"_25351":383,"_21542":38191,"_5":25505,"_17356":37854,"_1875":38192},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_9127":515,"_25351":383,"_21542":38194,"_5":25505,"_17356":37854,"_1875":38195},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_9127":516,"_25351":383,"_21542":38197,"_5":25505,"_17356":37858,"_1875":38198},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_9127":517,"_25351":383,"_21542":38200,"_5":25505,"_17356":37858,"_1875":38201},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_9127":518,"_25351":383,"_21542":38203,"_5":25505,"_17356":37858,"_1875":38204},[],"Para que el flujo JITP funcione correctamente:",{"_9127":519,"_25351":383,"_21542":38206,"_5":25505,"_17356":37858,"_1875":38207},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_9127":520,"_25351":383,"_21542":38209,"_5":25505,"_17356":37858,"_1875":38210},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_9127":521,"_25351":383,"_21542":38212,"_5":25505,"_17356":37858,"_1875":38213},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_9127":522,"_25351":383,"_21542":38215,"_5":25505,"_17356":37858,"_1875":38216},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_9127":523,"_25351":383,"_21542":38218,"_5":25505,"_17356":37862,"_1875":38219},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_9127":524,"_25351":383,"_21542":38221,"_5":25505,"_17356":37862,"_1875":38222},[],"Estado en Lamassu",{"_9127":525,"_25351":383,"_21542":38224,"_5":25505,"_17356":37862,"_1875":38225},[],"Razón de revocación",{"_9127":526,"_25351":383,"_21542":38227,"_5":25505,"_17356":37862,"_1875":38228},[],"Estado en AWS IoT Core",{"_9127":527,"_25351":383,"_21542":38230,"_5":25505,"_17356":37862,"_1875":38231},[],"`Active`",{"_9127":528,"_25351":383,"_21542":38233,"_5":25505,"_17356":37862,"_1875":38234},[],"—",{"_9127":529,"_25351":383,"_21542":38236,"_5":25505,"_17356":37862,"_1875":38237},[],"`ACTIVE`",{"_9127":530,"_25351":383,"_21542":38239,"_5":25505,"_17356":37862,"_1875":38240},[],"`Revoked`",{"_9127":531,"_25351":383,"_21542":38242,"_5":25505,"_17356":37862,"_1875":38243},[],"`certificateHold`",{"_9127":532,"_25351":383,"_21542":38245,"_5":25505,"_17356":37862,"_1875":38246},[],"`INACTIVE`",{"_9127":533,"_25351":383,"_21542":38248,"_5":25505,"_17356":37862,"_1875":38240},[],{"_9127":534,"_25351":383,"_21542":38250,"_5":25505,"_17356":37862,"_1875":38251},[],"Cualquier otra razón",{"_9127":535,"_25351":383,"_21542":38253,"_5":25505,"_17356":37862,"_1875":38254},[],"`REVOKED`",{"_9127":536,"_25351":383,"_21542":38256,"_5":25505,"_17356":37862,"_1875":38257},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_9127":537,"_25351":383,"_21542":38259,"_5":25505,"_17356":37866,"_1875":38260},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_9127":538,"_25351":383,"_21542":38262,"_5":25505,"_17356":37866,"_1875":38263},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_9127":539,"_25351":383,"_21542":38265,"_5":25505,"_17356":37866,"_1875":38266},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_9127":540,"_25351":383,"_21542":38268,"_5":25505,"_17356":37870,"_1875":38269},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_9127":541,"_25351":383,"_21542":38271,"_5":25505,"_17356":37870,"_1875":38272},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_9127":542,"_25351":383,"_21542":38274,"_5":25505,"_17356":37874,"_1875":38275},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_9127":543,"_25351":383,"_21542":38277,"_5":25505,"_17356":37874,"_1875":38278},[],"Existen dos tipos de acciones:",{"_9127":544,"_25351":383,"_21542":38280,"_5":25505,"_17356":37874,"_1875":38281},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_9127":545,"_25351":383,"_21542":38283,"_5":25505,"_17356":37874,"_1875":38284},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_9127":546,"_25351":383,"_21542":38286,"_5":25505,"_17356":37874,"_1875":38287},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_9127":547,"_25351":383,"_21542":38289,"_5":25505,"_17356":37878,"_1875":38290},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_9127":548,"_25351":383,"_21542":38292,"_5":25505,"_17356":37878,"_1875":38293},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_9127":549,"_25351":383,"_21542":38295,"_5":25505,"_17356":37878,"_1875":38296},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_9127":550,"_25351":383,"_21542":38298,"_5":25505,"_17356":37882,"_1875":38299},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_9127":551,"_25351":383,"_21542":38301,"_5":25505,"_17356":37882,"_1875":38302},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_9127":552,"_25351":383,"_21542":38304,"_5":25505,"_17356":37882,"_1875":38305},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_9127":553,"_25351":383,"_21542":38307,"_5":25505,"_17356":37882,"_1875":38308},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_9127":554,"_25351":383,"_21542":38310,"_5":25505,"_17356":37882,"_1875":38311},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_9127":555,"_25351":383,"_21542":38313,"_5":25505,"_17356":37882,"_1875":38314},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_9127":556,"_25351":383,"_21542":38316,"_5":25505,"_17356":37882,"_1875":38317},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_9127":557,"_25351":383,"_21542":38319,"_5":25505,"_17356":37882,"_1875":38320},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_9127":558,"_25351":383,"_21542":38322,"_5":25505,"_17356":37882,"_1875":38323},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_9127":559,"_25351":383,"_21542":38325,"_5":25505,"_17356":37882,"_1875":38326},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_9127":560,"_25351":383,"_21542":38328,"_5":25505,"_17356":37882,"_1875":38329},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_9127":561,"_25351":383,"_21542":38331,"_5":25505,"_17356":37882,"_1875":38332},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_9127":562,"_25351":383,"_21542":38334,"_5":25505,"_17356":37882,"_1875":38335},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_9127":563,"_25351":383,"_21542":38337,"_5":25505,"_17356":37882,"_1875":38338},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_9127":564,"_25351":383,"_21542":38340,"_5":25505,"_17356":37882,"_1875":38341},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_9127":565,"_25351":383,"_21542":38343,"_5":25505,"_17356":37882,"_1875":38344},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_9127":566,"_25351":383,"_21542":38346,"_5":25505,"_17356":37882,"_1875":38347},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_9127":567,"_25351":383,"_21542":38349,"_5":25505,"_17356":37882,"_1875":38350},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_9127":568,"_25351":383,"_21542":38352,"_5":25505,"_17356":37882,"_1875":38353},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_9127":569,"_25351":383,"_21542":38355,"_5":25505,"_17356":37882,"_1875":38356},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_9127":570,"_25351":383,"_21542":38358,"_5":25505,"_17356":37882,"_1875":38359},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_9127":571,"_25351":571,"_5":25500,"_1875":38361,"_25513":38362,"_21542":38363,"_17356":571},"[Alerts] Alertas y Suscripciones",[36657,37756,37765],[],{"_9127":572,"_25351":571,"_21542":38365,"_5":25505,"_17356":571,"_1875":38366},[],"Monitorización proactiva mediante eventos y suscripciones",{"_9127":573,"_25351":571,"_5":25510,"_21542":38368,"_17356":38369,"_1875":38370},[],"/docs/pr-preview/pr-24/manual/servicios-core/alerts#alertas","Alertas",{"_9127":574,"_25351":571,"_5":25510,"_21542":38372,"_17356":38373,"_1875":38374},[],"/docs/pr-preview/pr-24/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_9127":575,"_25351":571,"_5":25510,"_21542":38376,"_17356":38377,"_1875":38378},[],"/docs/pr-preview/pr-24/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_9127":576,"_25351":571,"_5":25510,"_21542":38380,"_17356":38381,"_1875":38382},[],"/docs/pr-preview/pr-24/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_9127":577,"_25351":571,"_5":25510,"_21542":38384,"_17356":38385,"_1875":38386},[],"/docs/pr-preview/pr-24/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_9127":578,"_25351":571,"_5":25510,"_21542":38388,"_17356":38389,"_1875":38390},[],"/docs/pr-preview/pr-24/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_9127":579,"_25351":571,"_5":25510,"_21542":38392,"_17356":38393,"_1875":38394},[],"/docs/pr-preview/pr-24/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_9127":580,"_25351":571,"_21542":38396,"_5":25505,"_17356":38369,"_1875":38397},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_9127":581,"_25351":571,"_21542":38399,"_5":25505,"_17356":38373,"_1875":38400},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_9127":582,"_25351":571,"_21542":38402,"_5":25505,"_17356":38373,"_1875":38403},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_9127":583,"_25351":571,"_21542":38405,"_5":25505,"_17356":38373,"_1875":38406},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_9127":584,"_25351":571,"_21542":38408,"_5":25505,"_17356":38373,"_1875":38409},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_9127":585,"_25351":571,"_21542":38411,"_5":25505,"_17356":38373,"_1875":38412},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_9127":586,"_25351":571,"_21542":38414,"_5":25505,"_17356":38373,"_1875":38415},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_9127":587,"_25351":571,"_21542":38417,"_5":25505,"_17356":38377,"_1875":38418},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_9127":588,"_25351":571,"_21542":38420,"_5":25505,"_17356":38377,"_1875":38421},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_9127":589,"_25351":571,"_21542":38423,"_5":25505,"_17356":38377,"_1875":38424},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_9127":590,"_25351":571,"_21542":38426,"_5":25505,"_17356":38377,"_1875":38427},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_9127":591,"_25351":571,"_21542":38429,"_5":25505,"_17356":38377,"_1875":38430},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_9127":592,"_25351":571,"_21542":38432,"_5":25505,"_17356":38381,"_1875":38433},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_9127":593,"_25351":571,"_21542":38435,"_5":25505,"_17356":38381,"_1875":38436},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_9127":594,"_25351":571,"_21542":38438,"_5":25505,"_17356":38381,"_1875":38439},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_9127":595,"_25351":571,"_21542":38441,"_5":25505,"_17356":38381,"_1875":38442},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_9127":596,"_25351":571,"_21542":38444,"_5":25505,"_17356":38381,"_1875":38445},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_9127":597,"_25351":571,"_21542":38447,"_5":25505,"_17356":38385,"_1875":38448},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_9127":598,"_25351":571,"_21542":38450,"_5":25505,"_17356":38385,"_1875":38451},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_9127":599,"_25351":571,"_21542":38453,"_5":25505,"_17356":38389,"_1875":38454},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_9127":600,"_25351":571,"_21542":38456,"_5":25505,"_17356":38389,"_1875":38457},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_9127":601,"_25351":571,"_21542":38459,"_5":25505,"_17356":38389,"_1875":38460},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_9127":602,"_25351":571,"_21542":38462,"_5":25505,"_17356":38389,"_1875":38463},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_9127":603,"_25351":571,"_21542":38465,"_5":25505,"_17356":38393,"_1875":38466},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_9127":604,"_25351":571,"_21542":38468,"_5":25505,"_17356":38393,"_1875":38469},[],"Evento",{"_9127":605,"_25351":571,"_21542":38471,"_5":25505,"_17356":38393,"_1875":36860},[],{"_9127":606,"_25351":571,"_21542":38473,"_5":25505,"_17356":38393,"_1875":38474},[],"**ca.create**",{"_9127":607,"_25351":571,"_21542":38476,"_5":25505,"_17356":38393,"_1875":38477},[],"Creación de una CA",{"_9127":608,"_25351":571,"_21542":38479,"_5":25505,"_17356":38393,"_1875":38480},[],"**ca.import**",{"_9127":609,"_25351":571,"_21542":38482,"_5":25505,"_17356":38393,"_1875":38483},[],"Importación de una CA",{"_9127":610,"_25351":571,"_21542":38485,"_5":25505,"_17356":38393,"_1875":38486},[],"**ca.profile.update**",{"_9127":611,"_25351":571,"_21542":38488,"_5":25505,"_17356":38393,"_1875":38489},[],"Actualización de perfil de CA",{"_9127":612,"_25351":571,"_21542":38491,"_5":25505,"_17356":38393,"_1875":38492},[],"**ca.reissue**",{"_9127":613,"_25351":571,"_21542":38494,"_5":25505,"_17356":38393,"_1875":38495},[],"Reemisión de una CA",{"_9127":614,"_25351":571,"_21542":38497,"_5":25505,"_17356":38393,"_1875":38498},[],"**ca.sign.certificate**",{"_9127":615,"_25351":571,"_21542":38500,"_5":25505,"_17356":38393,"_1875":38501},[],"Firma / emisión de certificado",{"_9127":616,"_25351":571,"_21542":38503,"_5":25505,"_17356":38393,"_1875":38504},[],"**ca.signature.sign**",{"_9127":617,"_25351":571,"_21542":38506,"_5":25505,"_17356":38393,"_1875":38507},[],"Operación de firma criptográfica",{"_9127":618,"_25351":571,"_21542":38509,"_5":25505,"_17356":38393,"_1875":38510},[],"**ca.delete**",{"_9127":619,"_25351":571,"_21542":38512,"_5":25505,"_17356":38393,"_1875":38513},[],"Eliminación de una CA",{"_9127":620,"_25351":571,"_21542":38515,"_5":25505,"_17356":38393,"_1875":38516},[],"**certificate.delete**",{"_9127":621,"_25351":571,"_21542":38518,"_5":25505,"_17356":38393,"_1875":38519},[],"Eliminación de un certificado",{"_9127":622,"_25351":571,"_21542":38521,"_5":25505,"_17356":38393,"_1875":38522},[],"**profile.create**",{"_9127":623,"_25351":571,"_21542":38524,"_5":25505,"_17356":38393,"_1875":38525},[],"Creación de perfil de emisión",{"_9127":624,"_25351":571,"_21542":38527,"_5":25505,"_17356":38393,"_1875":38528},[],"**profile.update**",{"_9127":625,"_25351":571,"_21542":38530,"_5":25505,"_17356":38393,"_1875":38531},[],"Actualización de perfil de emisión",{"_9127":626,"_25351":571,"_21542":38533,"_5":25505,"_17356":38393,"_1875":38534},[],"**profile.delete**",{"_9127":627,"_25351":571,"_21542":38536,"_5":25505,"_17356":38393,"_1875":38537},[],"Eliminación de perfil de emisión",{"_9127":628,"_25351":571,"_21542":38539,"_5":25505,"_17356":38393,"_1875":38540},[],"**dms.create**",{"_9127":629,"_25351":571,"_21542":38542,"_5":25505,"_17356":38393,"_1875":38543},[],"Creación de un DMS",{"_9127":630,"_25351":571,"_21542":38545,"_5":25505,"_17356":38393,"_1875":38546},[],"**dms.update**",{"_9127":631,"_25351":571,"_21542":38548,"_5":25505,"_17356":38393,"_1875":38549},[],"Actualización de un DMS",{"_9127":632,"_25351":571,"_21542":38551,"_5":25505,"_17356":38393,"_1875":38552},[],"**dms.delete**",{"_9127":633,"_25351":571,"_21542":38554,"_5":25505,"_17356":38393,"_1875":38555},[],"Eliminación de un DMS",{"_9127":634,"_25351":571,"_21542":38557,"_5":25505,"_17356":38393,"_1875":38558},[],"**dms.enroll**",{"_9127":635,"_25351":571,"_21542":38560,"_5":25505,"_17356":38393,"_1875":38561},[],"Inscripción (enroll) de dispositivo",{"_9127":636,"_25351":571,"_21542":38563,"_5":25505,"_17356":38393,"_1875":38564},[],"**dms.reenroll**",{"_9127":637,"_25351":571,"_21542":38566,"_5":25505,"_17356":38393,"_1875":38567},[],"Re-inscripción (reenroll) de dispositivo",{"_9127":638,"_25351":571,"_21542":38569,"_5":25505,"_17356":38393,"_1875":38570},[],"**dms.bind-device-id**",{"_9127":639,"_25351":571,"_21542":38572,"_5":25505,"_17356":38393,"_1875":38573},[],"Asociación de identidad a dispositivo",{"_9127":640,"_25351":571,"_21542":38575,"_5":25505,"_17356":38393,"_1875":38576},[],"**device.create**",{"_9127":641,"_25351":571,"_21542":38578,"_5":25505,"_17356":38393,"_1875":38579},[],"Creación de dispositivo",{"_9127":642,"_25351":571,"_21542":38581,"_5":25505,"_17356":38393,"_1875":38582},[],"**device.identity.update**",{"_9127":643,"_25351":571,"_21542":38584,"_5":25505,"_17356":38393,"_1875":38585},[],"Actualización de identidad del dispositivo",{"_9127":644,"_25351":571,"_21542":38587,"_5":25505,"_17356":38393,"_1875":38588},[],"**device.status.update**",{"_9127":645,"_25351":571,"_21542":38590,"_5":25505,"_17356":38393,"_1875":38591},[],"Cambio de estado del dispositivo",{"_9127":646,"_25351":571,"_21542":38593,"_5":25505,"_17356":38393,"_1875":38594},[],"**device.metadata.update**",{"_9127":647,"_25351":571,"_21542":38596,"_5":25505,"_17356":38393,"_1875":38597},[],"Actualización de metadatos del dispositivo",{"_9127":648,"_25351":571,"_21542":38599,"_5":25505,"_17356":38393,"_1875":38600},[],"**device.delete**",{"_9127":649,"_25351":571,"_21542":38602,"_5":25505,"_17356":38393,"_1875":38603},[],"Eliminación de un dispositivo",{"_9127":650,"_25351":571,"_21542":38605,"_5":25505,"_17356":38393,"_1875":38606},[],"**va.role.crl.create**",{"_9127":651,"_25351":571,"_21542":38608,"_5":25505,"_17356":38393,"_1875":38609},[],"Cálculo/creación de CRL",{"_9127":652,"_25351":571,"_21542":38611,"_5":25505,"_17356":38393,"_1875":38612},[],"**kms.create**",{"_9127":653,"_25351":571,"_21542":38614,"_5":25505,"_17356":38393,"_1875":38615},[],"Creación de clave en KMS",{"_9127":654,"_25351":571,"_21542":38617,"_5":25505,"_17356":38393,"_1875":38618},[],"**kms.import**",{"_9127":655,"_25351":571,"_21542":38620,"_5":25505,"_17356":38393,"_1875":38621},[],"Importación de una clave KMS",{"_9127":656,"_25351":571,"_21542":38623,"_5":25505,"_17356":38393,"_1875":38624},[],"**kms.update.metadata**",{"_9127":657,"_25351":571,"_21542":38626,"_5":25505,"_17356":38393,"_1875":38627},[],"Actualización de metadatos de clave KMS",{"_9127":658,"_25351":571,"_21542":38629,"_5":25505,"_17356":38393,"_1875":38630},[],"**kms.update.aliases**",{"_9127":659,"_25351":571,"_21542":38632,"_5":25505,"_17356":38393,"_1875":38633},[],"Actualización de alias de clave KMS",{"_9127":660,"_25351":571,"_21542":38635,"_5":25505,"_17356":38393,"_1875":38636},[],"**kms.update.name**",{"_9127":661,"_25351":571,"_21542":38638,"_5":25505,"_17356":38393,"_1875":38639},[],"Cambio de nombre de una clave KMS",{"_9127":662,"_25351":571,"_21542":38641,"_5":25505,"_17356":38393,"_1875":38642},[],"**kms.update.tags**",{"_9127":663,"_25351":571,"_21542":38644,"_5":25505,"_17356":38393,"_1875":38645},[],"Actualización de etiquetas (tags) de clave KMS",{"_9127":664,"_25351":571,"_21542":38647,"_5":25505,"_17356":38393,"_1875":38648},[],"**kms.delete**",{"_9127":665,"_25351":571,"_21542":38650,"_5":25505,"_17356":38393,"_1875":38651},[],"Eliminación de una clave KMS",{"_9127":666,"_25351":571,"_21542":38653,"_5":25505,"_17356":38393,"_1875":38654},[],"**kms.sign.message**",{"_9127":667,"_25351":571,"_21542":38656,"_5":25505,"_17356":38393,"_1875":38657},[],"Firma de un mensaje con clave KMS",{"_9127":668,"_25351":571,"_21542":38659,"_5":25505,"_17356":38393,"_1875":38660},[],"**kms.verify.signature**",{"_9127":669,"_25351":571,"_21542":38662,"_5":25505,"_17356":38393,"_1875":38663},[],"Verificación de firma con clave KMS",{"_9127":670,"_25351":670,"_5":25500,"_1875":38665,"_25513":38666,"_21542":38667,"_17356":670},"[CA] Gestión de Entidades de Confianza",[36657,37756,37765],[],{"_9127":671,"_25351":670,"_21542":38669,"_5":25505,"_17356":670,"_1875":38670},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_9127":672,"_25351":670,"_5":25510,"_21542":38672,"_17356":38673,"_1875":38674},[],"/docs/pr-preview/pr-24/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_9127":673,"_25351":670,"_5":25510,"_21542":38676,"_17356":38677,"_1875":38678},[],"/docs/pr-preview/pr-24/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_9127":674,"_25351":670,"_5":25510,"_21542":38680,"_17356":38681,"_1875":38682},[],"/docs/pr-preview/pr-24/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_9127":675,"_25351":670,"_5":25510,"_21542":38684,"_17356":38685,"_1875":38686},[],"/docs/pr-preview/pr-24/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_9127":676,"_25351":670,"_5":25510,"_21542":38688,"_17356":38689,"_1875":38690},[],"/docs/pr-preview/pr-24/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_9127":677,"_25351":670,"_5":25510,"_21542":38692,"_17356":38693,"_1875":38694},[],"/docs/pr-preview/pr-24/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_9127":678,"_25351":670,"_5":25510,"_21542":38696,"_17356":38697,"_1875":38698},[],"/docs/pr-preview/pr-24/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_9127":679,"_25351":670,"_5":25510,"_21542":38700,"_17356":38701,"_1875":38702},[],"/docs/pr-preview/pr-24/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_9127":680,"_25351":670,"_5":25510,"_21542":38704,"_17356":38705,"_1875":38706},[],"/docs/pr-preview/pr-24/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_9127":681,"_25351":670,"_21542":38708,"_5":25505,"_17356":38677,"_1875":38709},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_9127":682,"_25351":670,"_21542":38711,"_5":25505,"_17356":38677,"_1875":38712},[],"Actualmente hay disponibles 3 acciones:",{"_9127":683,"_25351":670,"_21542":38714,"_5":25505,"_17356":38677,"_1875":38715},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_9127":684,"_25351":670,"_21542":38717,"_5":25505,"_17356":38677,"_1875":38718},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_9127":685,"_25351":670,"_21542":38720,"_5":25505,"_17356":38677,"_1875":38721},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_9127":686,"_25351":670,"_21542":38723,"_5":25505,"_17356":38681,"_1875":38724},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_9127":687,"_25351":670,"_21542":38726,"_5":25505,"_17356":38681,"_1875":38727},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_9127":688,"_25351":670,"_21542":38729,"_5":25505,"_17356":38681,"_1875":38730},[],"**Motor criptográfico**",{"_9127":689,"_25351":670,"_21542":38732,"_5":25505,"_17356":38681,"_1875":38733},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_9127":690,"_25351":670,"_21542":38735,"_5":25505,"_17356":38681,"_1875":38736},[],"**Ejemplo mostrado:** go1.24.3",{"_9127":691,"_25351":670,"_21542":38738,"_5":25505,"_17356":38681,"_1875":38739},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_9127":692,"_25351":670,"_21542":38741,"_5":25505,"_17356":38681,"_1875":38742},[],"**Parámetros de clave**",{"_9127":693,"_25351":670,"_21542":38744,"_5":25505,"_17356":38681,"_1875":38745},[],"**Key Type:** RSA / EC (Elliptic Curve)",{"_9127":694,"_25351":670,"_21542":38747,"_5":25505,"_17356":38681,"_1875":38748},[],"**Key Size:**",{"_9127":695,"_25351":670,"_21542":38750,"_5":25505,"_17356":38681,"_1875":38751},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_9127":696,"_25351":670,"_21542":38753,"_5":25505,"_17356":38681,"_1875":38754},[],"EC: P-256, P-384, P-521",{"_9127":697,"_25351":670,"_21542":38756,"_5":25505,"_17356":38681,"_1875":38757},[],"**Recomendado:** EC P-384",{"_9127":698,"_25351":670,"_21542":38759,"_5":25505,"_17356":38681,"_1875":38760},[],"**Perfil de emisión del certificado de la CA**",{"_9127":699,"_25351":670,"_21542":38762,"_5":25505,"_17356":38681,"_1875":38763},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_9127":700,"_25351":670,"_21542":38765,"_5":25505,"_17356":38681,"_1875":38766},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_9127":701,"_25351":670,"_21542":38768,"_5":25505,"_17356":38681,"_1875":38769},[],"**Configuración de la CA**",{"_9127":702,"_25351":670,"_21542":38771,"_5":25505,"_17356":38681,"_1875":38772},[],"**Tipo de CA**",{"_9127":703,"_25351":670,"_21542":38774,"_5":25505,"_17356":38681,"_1875":38775},[],"**Root CA:** Autoridad raíz autofirmada",{"_9127":704,"_25351":670,"_21542":38777,"_5":25505,"_17356":38681,"_1875":38778},[],"**Intermediate CA:** Autoridad subordinada",{"_9127":705,"_25351":670,"_21542":38780,"_5":25505,"_17356":38681,"_1875":38781},[],"**Emisor**",{"_9127":706,"_25351":670,"_21542":38783,"_5":25505,"_17356":38681,"_1875":38784},[],"**Root CA:** Self-signed (auto-firmada)",{"_9127":707,"_25351":670,"_21542":38786,"_5":25505,"_17356":38681,"_1875":38787},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_9127":708,"_25351":670,"_21542":38789,"_5":25505,"_17356":38681,"_1875":38790},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_9127":709,"_25351":670,"_21542":38792,"_5":25505,"_17356":38681,"_1875":38793},[],"**Identificación**",{"_9127":710,"_25351":670,"_21542":38795,"_5":25505,"_17356":38681,"_1875":38796},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_9127":711,"_25351":670,"_21542":38798,"_5":25505,"_17356":38681,"_1875":38799},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_9127":712,"_25351":670,"_21542":38801,"_5":25505,"_17356":38681,"_1875":38802},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_9127":713,"_25351":670,"_21542":38804,"_5":25505,"_17356":38681,"_1875":38805},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_9127":714,"_25351":670,"_21542":38807,"_5":25505,"_17356":38681,"_1875":38808},[],"**Subject Distinguished Name (DN)**",{"_9127":715,"_25351":670,"_21542":38810,"_5":25505,"_17356":38681,"_1875":38811},[],"Campos opcionales:",{"_9127":716,"_25351":670,"_21542":38813,"_5":25505,"_17356":38681,"_1875":38814},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_9127":717,"_25351":670,"_21542":38816,"_5":25505,"_17356":38681,"_1875":38817},[],"Ejemplo: US, ES, DE",{"_9127":718,"_25351":670,"_21542":38819,"_5":25505,"_17356":38681,"_1875":38820},[],"**State/Province (ST):** Estado o provincia",{"_9127":719,"_25351":670,"_21542":38822,"_5":25505,"_17356":38681,"_1875":38823},[],"Ejemplo: California, Madrid",{"_9127":720,"_25351":670,"_21542":38825,"_5":25505,"_17356":38681,"_1875":38826},[],"**Locality (L):** Ciudad o localidad",{"_9127":721,"_25351":670,"_21542":38828,"_5":25505,"_17356":38681,"_1875":38829},[],"Ejemplo: San Francisco, Arrasate",{"_9127":722,"_25351":670,"_21542":38831,"_5":25505,"_17356":38681,"_1875":38832},[],"**Organization (O):** Nombre de la organización",{"_9127":723,"_25351":670,"_21542":38834,"_5":25505,"_17356":38681,"_1875":38835},[],"Ejemplo: Lamassu IoT Corp",{"_9127":724,"_25351":670,"_21542":38837,"_5":25505,"_17356":38681,"_1875":38838},[],"**Organizational Unit (OU):** Unidad organizacional",{"_9127":725,"_25351":670,"_21542":38840,"_5":25505,"_17356":38681,"_1875":38841},[],"Ejemplo: Secure Devices Division",{"_9127":726,"_25351":670,"_21542":38843,"_5":25505,"_17356":38681,"_1875":38844},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_9127":727,"_25351":670,"_21542":38846,"_5":25505,"_17356":38681,"_1875":38847},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_9127":728,"_25351":670,"_21542":38849,"_5":25505,"_17356":38681,"_1875":38850},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_9127":729,"_25351":670,"_21542":38852,"_5":25505,"_17356":38681,"_1875":38853},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_9127":730,"_25351":670,"_21542":38855,"_5":25505,"_17356":38681,"_1875":38856},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_9127":731,"_25351":670,"_21542":38858,"_5":25505,"_17356":38681,"_1875":38859},[],"**Duración:** Configurable según necesidades organizacionales",{"_9127":732,"_25351":670,"_21542":38861,"_5":25505,"_17356":38681,"_1875":38862},[],"**Valor por defecto:** 10 años (10y)",{"_9127":733,"_25351":670,"_21542":38864,"_5":25505,"_17356":38681,"_1875":38865},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_9127":734,"_25351":670,"_21542":38867,"_5":25505,"_17356":38681,"_1875":38868},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_9127":735,"_25351":670,"_21542":38870,"_5":25505,"_17356":38681,"_1875":38871},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_9127":736,"_25351":670,"_21542":38873,"_5":25505,"_17356":38681,"_1875":38874},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_9127":737,"_25351":670,"_21542":38876,"_5":25505,"_17356":38681,"_1875":38877},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_9127":738,"_25351":670,"_21542":38879,"_5":25505,"_17356":38681,"_1875":38880},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_9127":739,"_25351":670,"_21542":38882,"_5":25505,"_17356":38681,"_1875":38883},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_9127":740,"_25351":670,"_21542":38885,"_5":25505,"_17356":38681,"_1875":38886},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_9127":741,"_25351":670,"_21542":38888,"_5":25505,"_17356":38681,"_1875":38889},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_9127":742,"_25351":670,"_21542":38891,"_5":25505,"_17356":38681,"_1875":38892},[],"**Valor por defecto:** 1 año (1y)",{"_9127":743,"_25351":670,"_21542":38894,"_5":25505,"_17356":38681,"_1875":38895},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_9127":744,"_25351":670,"_21542":38897,"_5":25505,"_17356":38681,"_1875":38898},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_9127":745,"_25351":670,"_21542":38900,"_5":25505,"_17356":38685,"_1875":38901},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_9127":746,"_25351":670,"_21542":38903,"_5":25505,"_17356":38685,"_1875":38904},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_9127":747,"_25351":670,"_21542":38906,"_5":25505,"_17356":38685,"_1875":38907},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_9127":748,"_25351":670,"_21542":38909,"_5":25505,"_17356":38689,"_1875":38910},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_9127":749,"_25351":670,"_21542":38912,"_5":25505,"_17356":38689,"_1875":38913},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_9127":750,"_25351":670,"_21542":38915,"_5":25505,"_17356":38689,"_1875":38733},[],{"_9127":751,"_25351":670,"_21542":38917,"_5":25505,"_17356":38689,"_1875":38736},[],{"_9127":752,"_25351":670,"_21542":38919,"_5":25505,"_17356":38689,"_1875":38739},[],{"_9127":753,"_25351":670,"_21542":38921,"_5":25505,"_17356":38689,"_1875":38922},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_9127":754,"_25351":670,"_21542":38924,"_5":25505,"_17356":38689,"_1875":38883},[],{"_9127":755,"_25351":670,"_21542":38926,"_5":25505,"_17356":38689,"_1875":38886},[],{"_9127":756,"_25351":670,"_21542":38928,"_5":25505,"_17356":38689,"_1875":38889},[],{"_9127":757,"_25351":670,"_21542":38930,"_5":25505,"_17356":38689,"_1875":38892},[],{"_9127":758,"_25351":670,"_21542":38932,"_5":25505,"_17356":38689,"_1875":38895},[],{"_9127":759,"_25351":670,"_21542":38934,"_5":25505,"_17356":38689,"_1875":38935},[],"Se debe proporcionar de manera obligatoria:",{"_9127":760,"_25351":670,"_21542":38937,"_5":25505,"_17356":38689,"_1875":38938},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_9127":761,"_25351":670,"_21542":38940,"_5":25505,"_17356":38689,"_1875":38941},[],"Clave privada de la CA en formato PEM",{"_9127":762,"_25351":670,"_21542":38943,"_5":25505,"_17356":38689,"_1875":38944},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_9127":763,"_25351":670,"_21542":38946,"_5":25505,"_17356":38697,"_1875":38947},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_9127":764,"_25351":670,"_21542":38949,"_5":25505,"_17356":38697,"_1875":38950},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_9127":765,"_25351":670,"_21542":38952,"_5":25505,"_17356":38697,"_1875":38953},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_9127":766,"_25351":670,"_21542":38955,"_5":25505,"_17356":38697,"_1875":38956},[],"Se ofrecen dos acciones:",{"_9127":767,"_25351":670,"_21542":38958,"_5":25505,"_17356":38697,"_1875":38959},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_9127":768,"_25351":670,"_21542":38961,"_5":25505,"_17356":38697,"_1875":38962},[],"la acción de revocación de la CA",{"_9127":769,"_25351":670,"_21542":38964,"_5":25505,"_17356":38697,"_1875":38965},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_9127":770,"_25351":670,"_21542":38967,"_5":25505,"_17356":38701,"_1875":38968},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_9127":771,"_25351":670,"_21542":38970,"_5":25505,"_17356":38701,"_1875":38971},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_9127":772,"_25351":670,"_21542":38973,"_5":25505,"_17356":38701,"_1875":38974},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_9127":773,"_25351":670,"_21542":38976,"_5":25505,"_17356":38701,"_1875":38977},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_9127":774,"_25351":670,"_21542":38979,"_5":25505,"_17356":38701,"_1875":38980},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_9127":775,"_25351":670,"_21542":38982,"_5":25505,"_17356":38701,"_1875":38983},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_9127":776,"_25351":670,"_21542":38985,"_5":25505,"_17356":38701,"_1875":38986},[],"Emisión a partir de un CSR generado de manera externa",{"_9127":777,"_25351":670,"_21542":38988,"_5":25505,"_17356":38701,"_1875":38989},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_9127":778,"_25351":670,"_21542":38991,"_5":25505,"_17356":38701,"_1875":38992},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_9127":779,"_25351":670,"_21542":38994,"_5":25505,"_17356":38701,"_1875":38995},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_9127":780,"_25351":670,"_21542":38997,"_5":25505,"_17356":38701,"_1875":38998},[],"**Certificate Subject (Sujeto del certificado)**",{"_9127":781,"_25351":670,"_21542":39000,"_5":25505,"_17356":38701,"_1875":39001},[],"**Common Name (CN)**",{"_9127":782,"_25351":670,"_21542":39003,"_5":25505,"_17356":38701,"_1875":39004},[],"**Campo:** Obligatorio",{"_9127":783,"_25351":670,"_21542":39006,"_5":25505,"_17356":38701,"_1875":39007},[],"**Función:** Identifica de forma única al titular del certificado",{"_9127":784,"_25351":670,"_21542":39009,"_5":25505,"_17356":38701,"_1875":39010},[],"**Ejemplos:**",{"_9127":785,"_25351":670,"_21542":39012,"_5":25505,"_17356":38701,"_1875":39013},[],"Para dispositivos: device001.company.com",{"_9127":786,"_25351":670,"_21542":39015,"_5":25505,"_17356":38701,"_1875":39016},[],"Para usuarios: john.doe\\@company.com",{"_9127":787,"_25351":670,"_21542":39018,"_5":25505,"_17356":38701,"_1875":39019},[],"Para servicios: api.service.company.com",{"_9127":788,"_25351":670,"_21542":39021,"_5":25505,"_17356":38701,"_1875":39022},[],"**Campos Organizacionales**",{"_9127":789,"_25351":670,"_21542":39024,"_5":25505,"_17356":38701,"_1875":39025},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_9127":790,"_25351":670,"_21542":39027,"_5":25505,"_17356":38701,"_1875":39028},[],"Ejemplo: IT Department, Manufacturing",{"_9127":791,"_25351":670,"_21542":39030,"_5":25505,"_17356":38701,"_1875":38832},[],{"_9127":792,"_25351":670,"_21542":39032,"_5":25505,"_17356":38701,"_1875":39033},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_9127":793,"_25351":670,"_21542":39035,"_5":25505,"_17356":38701,"_1875":39036},[],"**Información Geográfica**",{"_9127":794,"_25351":670,"_21542":39038,"_5":25505,"_17356":38701,"_1875":39039},[],"**Locality (L):** Ciudad o localidad del titular",{"_9127":795,"_25351":670,"_21542":39041,"_5":25505,"_17356":38701,"_1875":38820},[],{"_9127":796,"_25351":670,"_21542":39043,"_5":25505,"_17356":38701,"_1875":39044},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_9127":797,"_25351":670,"_21542":39046,"_5":25505,"_17356":38701,"_1875":39047},[],"Valor por defecto mostrado: US",{"_9127":798,"_25351":670,"_21542":39049,"_5":25505,"_17356":38701,"_1875":39050},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_9127":799,"_25351":670,"_21542":39052,"_5":25505,"_17356":38701,"_1875":39053},[],"**Tipos de SAN Disponibles**",{"_9127":800,"_25351":670,"_21542":39055,"_5":25505,"_17356":38701,"_1875":39056},[],"**DNS:** Nombres de dominio",{"_9127":801,"_25351":670,"_21542":39058,"_5":25505,"_17356":38701,"_1875":39059},[],"Ejemplo: example.com, \\*.example.com",{"_9127":802,"_25351":670,"_21542":39061,"_5":25505,"_17356":38701,"_1875":39062},[],"**IP Address:** Direcciones IP",{"_9127":803,"_25351":670,"_21542":39064,"_5":25505,"_17356":38701,"_1875":39065},[],"**Email:** Direcciones de correo electrónico",{"_9127":804,"_25351":670,"_21542":39067,"_5":25505,"_17356":38701,"_1875":39068},[],"**URI:** Identificadores de recursos uniformes",{"_9127":805,"_25351":670,"_21542":39070,"_5":25505,"_17356":38701,"_1875":39071},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_9127":806,"_25351":670,"_21542":39073,"_5":25505,"_17356":38701,"_1875":39074},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado.",{"_9127":807,"_25351":670,"_21542":39076,"_5":25505,"_17356":38701,"_1875":39077},[],"**Algorithm (Algoritmo)**",{"_9127":808,"_25351":670,"_21542":39079,"_5":25505,"_17356":38701,"_1875":39080},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_9127":809,"_25351":670,"_21542":39082,"_5":25505,"_17356":38701,"_1875":39083},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_9127":810,"_25351":670,"_21542":39085,"_5":25505,"_17356":38701,"_1875":39086},[],"**Certificate Configuration (Configuración del certificado)**",{"_9127":811,"_25351":670,"_21542":39088,"_5":25505,"_17356":38701,"_1875":39089},[],"**Validity Duration (Duración de validez)**",{"_9127":812,"_25351":670,"_21542":39091,"_5":25505,"_17356":38701,"_1875":39092},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_9127":813,"_25351":670,"_21542":39094,"_5":25505,"_17356":38701,"_1875":39095},[],"**Campo:** Configurable según necesidades",{"_9127":814,"_25351":670,"_21542":39097,"_5":25505,"_17356":38701,"_1875":38892},[],{"_9127":815,"_25351":670,"_21542":39099,"_5":25505,"_17356":38701,"_1875":39100},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_9127":816,"_25351":670,"_21542":39102,"_5":25505,"_17356":38701,"_1875":39103},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_9127":817,"_25351":670,"_21542":39105,"_5":25505,"_17356":38701,"_1875":39106},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_9127":818,"_25351":670,"_21542":39108,"_5":25505,"_17356":38701,"_1875":39109},[],"**Usos Básicos**",{"_9127":819,"_25351":670,"_21542":39111,"_5":25505,"_17356":38701,"_1875":39112},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_9127":820,"_25351":670,"_21542":39114,"_5":25505,"_17356":38701,"_1875":39115},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_9127":821,"_25351":670,"_21542":39117,"_5":25505,"_17356":38701,"_1875":39118},[],"**Key Encipherment:** Cifrado de claves",{"_9127":822,"_25351":670,"_21542":39120,"_5":25505,"_17356":38701,"_1875":39121},[],"**Data Encipherment:** Cifrado de datos",{"_9127":823,"_25351":670,"_21542":39123,"_5":25505,"_17356":38701,"_1875":39124},[],"**Key Agreement:** Acuerdo de claves",{"_9127":824,"_25351":670,"_21542":39126,"_5":25505,"_17356":38701,"_1875":39127},[],"**Certificate Signing:** Firma de certificados",{"_9127":825,"_25351":670,"_21542":39129,"_5":25505,"_17356":38701,"_1875":39130},[],"**CRL Signing:** Firma de listas de revocación",{"_9127":826,"_25351":670,"_21542":39132,"_5":25505,"_17356":38701,"_1875":39133},[],"**Encipher Only:** Solo cifrado",{"_9127":827,"_25351":670,"_21542":39135,"_5":25505,"_17356":38701,"_1875":39136},[],"**Decipher Only:** Solo descifrado",{"_9127":828,"_25351":670,"_21542":39138,"_5":25505,"_17356":38701,"_1875":39139},[],"**Uso Extendido de Claves**",{"_9127":829,"_25351":670,"_21542":39141,"_5":25505,"_17356":38701,"_1875":39142},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_9127":830,"_25351":670,"_21542":39144,"_5":25505,"_17356":38701,"_1875":39145},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_9127":831,"_25351":670,"_21542":39147,"_5":25505,"_17356":38701,"_1875":39148},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_9127":832,"_25351":670,"_21542":39150,"_5":25505,"_17356":38701,"_1875":39151},[],"**Code Signing:** Firma de código",{"_9127":833,"_25351":670,"_21542":39153,"_5":25505,"_17356":38701,"_1875":39154},[],"**Email Protection:** Protección de correo electrónico",{"_9127":834,"_25351":670,"_21542":39156,"_5":25505,"_17356":38701,"_1875":39157},[],"**Time Stamping:** Sellado de tiempo",{"_9127":835,"_25351":670,"_21542":39159,"_5":25505,"_17356":38701,"_1875":39160},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_9127":836,"_25351":670,"_21542":39162,"_5":25505,"_17356":38701,"_1875":39163},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_9127":837,"_25351":670,"_21542":39165,"_5":25505,"_17356":38701,"_1875":39166},[],"**Emisión a partir de un CSR generado de manera externa**",{"_9127":838,"_25351":670,"_21542":39168,"_5":25505,"_17356":38701,"_1875":39169},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_9127":839,"_25351":670,"_21542":39171,"_5":25505,"_17356":38701,"_1875":39172},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_9127":840,"_25351":670,"_21542":39174,"_5":25505,"_17356":38701,"_1875":39175},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_9127":841,"_25351":670,"_21542":39177,"_5":25505,"_17356":38705,"_1875":39178},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_9127":842,"_25351":670,"_21542":39180,"_5":25505,"_17356":38705,"_1875":39181},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_9127":843,"_25351":670,"_21542":39183,"_5":25505,"_17356":38705,"_1875":39184},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_9127":844,"_25351":670,"_21542":39186,"_5":25505,"_17356":38705,"_1875":39187},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_9127":845,"_25351":670,"_21542":39189,"_5":25505,"_17356":38705,"_1875":39190},[],"Unspecified (No especificado)",{"_9127":846,"_25351":670,"_21542":39192,"_5":25505,"_17356":38705,"_1875":39193},[],"KeyCompromise (Compromiso de clave)",{"_9127":847,"_25351":670,"_21542":39195,"_5":25505,"_17356":38705,"_1875":39196},[],"CACompromise (Compromiso de CA)",{"_9127":848,"_25351":670,"_21542":39198,"_5":25505,"_17356":38705,"_1875":39199},[],"AffiliationChanged (Afiliación cambiada)",{"_9127":849,"_25351":670,"_21542":39201,"_5":25505,"_17356":38705,"_1875":39202},[],"Superseded (Sustituida)",{"_9127":850,"_25351":670,"_21542":39204,"_5":25505,"_17356":38705,"_1875":39205},[],"CessationOfOperation (Cese de operación)",{"_9127":851,"_25351":670,"_21542":39207,"_5":25505,"_17356":38705,"_1875":39208},[],"CertificateHold (Retención de certificado)",{"_9127":852,"_25351":670,"_21542":39210,"_5":25505,"_17356":38705,"_1875":39211},[],"RemoveFromCRL (Eliminar de la CRL)",{"_9127":853,"_25351":670,"_21542":39213,"_5":25505,"_17356":38705,"_1875":39214},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_9127":854,"_25351":670,"_21542":39216,"_5":25505,"_17356":38705,"_1875":39217},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_9127":855,"_25351":670,"_21542":39219,"_5":25505,"_17356":38705,"_1875":39220},[],"Consideraciones importantes:",{"_9127":856,"_25351":670,"_21542":39222,"_5":25505,"_17356":38705,"_1875":39223},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_9127":857,"_25351":670,"_21542":39225,"_5":25505,"_17356":38705,"_1875":39226},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_9127":858,"_25351":858,"_5":25500,"_1875":39228,"_25513":39229,"_21542":39230,"_17356":858},"[Certs] Gestión de Certificados",[36657,37756,37765],[],{"_9127":859,"_25351":858,"_21542":39232,"_5":25505,"_17356":858,"_1875":39233},[],"Visualización y gestión de certificados emitidos",{"_9127":860,"_25351":858,"_5":25510,"_21542":39235,"_17356":39236,"_1875":39237},[],"/docs/pr-preview/pr-24/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_9127":861,"_25351":858,"_5":25510,"_21542":39239,"_17356":39240,"_1875":39241},[],"/docs/pr-preview/pr-24/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_9127":862,"_25351":858,"_21542":39243,"_5":25505,"_17356":39236,"_1875":39244},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_9127":863,"_25351":858,"_21542":39246,"_5":25505,"_17356":39236,"_1875":39247},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_9127":864,"_25351":858,"_21542":39249,"_5":25505,"_17356":39236,"_1875":39250},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_9127":865,"_25351":858,"_21542":39252,"_5":25505,"_17356":39240,"_1875":39253},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_9127":866,"_25351":858,"_21542":39255,"_5":25505,"_17356":39240,"_1875":39256},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_9127":867,"_25351":867,"_5":25500,"_1875":39258,"_25513":39259,"_21542":39260,"_17356":867},"CMP: Certificate Management Protocol",[36657,37756,37765],[],{"_9127":868,"_25351":867,"_21542":39262,"_5":25505,"_17356":867,"_1875":39263},[],"Guía del protocolo CMP en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia del endpoint para el integrador de dispositivos.",{"_9127":869,"_25351":867,"_5":25510,"_21542":39265,"_17356":39266,"_1875":39258},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#cmp-certificate-management-protocol",{"_9127":870,"_25351":867,"_5":25510,"_21542":39268,"_17356":39269,"_1875":37839},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#configuración-del-dms",{"_9127":871,"_25351":867,"_5":25510,"_21542":39271,"_17356":39272,"_1875":37362},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#requisitos-previos",{"_9127":872,"_25351":867,"_5":25510,"_21542":39274,"_17356":39275,"_1875":39276},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#selección-de-protocolo","Selección de protocolo",{"_9127":873,"_25351":867,"_5":25510,"_21542":39278,"_17356":39279,"_1875":39280},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#configuración-de-enrollment","Configuración de enrollment",{"_9127":874,"_25351":867,"_5":25510,"_21542":39282,"_17356":39283,"_1875":39284},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#modo-de-autenticación","Modo de autenticación",{"_9127":875,"_25351":867,"_5":25510,"_21542":39286,"_17356":39287,"_1875":39288},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#confirmación-y-flujo-de-emisión","Confirmación y flujo de emisión",{"_9127":876,"_25351":867,"_5":25510,"_21542":39290,"_17356":39291,"_1875":39292},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#certificado-de-protección-y-prueba-de-posesión","Certificado de protección y prueba de posesión",{"_9127":877,"_25351":867,"_5":25510,"_21542":39294,"_17356":39295,"_1875":39296},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#generación-de-claves-en-servidor-central-key-generation","Generación de claves en servidor (Central Key Generation)",{"_9127":878,"_25351":867,"_5":25510,"_21542":39298,"_17356":39299,"_1875":39300},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#ajustes-por-operación","Ajustes por operación",{"_9127":879,"_25351":867,"_5":25510,"_21542":39302,"_17356":39303,"_1875":39304},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#configuración-de-re-enrollment","Configuración de re-enrollment",{"_9127":880,"_25351":867,"_5":25510,"_21542":39306,"_17356":39307,"_1875":39308},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#perfil-de-emisión","Perfil de emisión",{"_9127":881,"_25351":867,"_5":25510,"_21542":39310,"_17356":39311,"_1875":39312},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#transacciones-cmp","Transacciones CMP",{"_9127":882,"_25351":867,"_5":25510,"_21542":39314,"_17356":39315,"_1875":39316},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#monitor-de-confirmación","Monitor de confirmación",{"_9127":883,"_25351":867,"_5":25510,"_21542":39318,"_17356":39319,"_1875":39320},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#integración-con-wfx-opcional","Integración con WFX (opcional)",{"_9127":884,"_25351":867,"_5":25510,"_21542":39322,"_17356":39323,"_1875":39324},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#verificar-la-configuración","Verificar la configuración",{"_9127":885,"_25351":867,"_5":25510,"_21542":39326,"_17356":39327,"_1875":39328},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#integración-de-dispositivos","Integración de dispositivos",{"_9127":886,"_25351":867,"_5":25510,"_21542":39330,"_17356":39331,"_1875":39332},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#antes-de-empezar","Antes de empezar",{"_9127":887,"_25351":867,"_5":25510,"_21542":39334,"_17356":39335,"_1875":39336},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#operaciones-soportadas","Operaciones soportadas",{"_9127":888,"_25351":867,"_5":25510,"_21542":39338,"_17356":39339,"_1875":39340},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#modelo-de-autenticación","Modelo de autenticación",{"_9127":889,"_25351":867,"_5":25510,"_21542":39342,"_17356":39343,"_1875":39344},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#el-endpoint-cmp","El endpoint CMP",{"_9127":890,"_25351":867,"_5":25510,"_21542":39346,"_17356":39347,"_1875":39348},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#generación-de-claves-en-servidor-kga","Generación de claves en servidor (KGA)",{"_9127":891,"_25351":867,"_5":25510,"_21542":39350,"_17356":39351,"_1875":39352},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#ejemplo-con-openssl-cmp","Ejemplo con openssl cmp",{"_9127":892,"_25351":867,"_5":25510,"_21542":39354,"_17356":39355,"_1875":39356},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_9127":893,"_25351":867,"_5":25510,"_21542":39358,"_17356":39359,"_1875":39360},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_9127":894,"_25351":867,"_5":25510,"_21542":39362,"_17356":39363,"_1875":39364},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_9127":895,"_25351":867,"_5":25510,"_21542":39366,"_17356":39367,"_1875":39368},[],"/docs/pr-preview/pr-24/manual/servicios-core/cmp#notas-de-compatibilidad","Notas de compatibilidad",{"_9127":896,"_25351":867,"_21542":39370,"_5":25505,"_17356":39266,"_1875":39371},[],"Lamassu IoT implementa el &#x2A;*Lightweight CMP Profile (RFC 9483)**, sobre el protocolo base &#x2A;*CMP (RFC 4210)**, como mecanismo alternativo de inscripción de certificados para dispositivos. Un DMS habla **EST o CMP, nunca ambos a la vez**: el protocolo se selecciona con el campo `protocol` del DMS (`EST_RFC7030` o `CMP_RFC9483`) y cada uno tiene su propio bloque de configuración (`est_settings` / `cmp_settings`). Cambiar el protocolo de un DMS existente descarta la configuración del protocolo anterior.",{"_9127":897,"_25351":867,"_21542":39373,"_5":25505,"_17356":39266,"_1875":39374},[],"Frente a EST, que expone un endpoint HTTP distinto por operación, CMP publica un **único endpoint** que recibe mensajes binarios (`PKIMessage`) y despacha la operación según su contenido, no según la URL. La autenticación también es distinta: en CMP no hay TLS mutuo a nivel de transporte, sino **protección del propio mensaje** mediante firma o MAC.",{"_9127":898,"_25351":867,"_21542":39376,"_5":25505,"_17356":39266,"_1875":39377},[],"Esta guía está dividida en dos partes:",{"_9127":899,"_25351":867,"_21542":39379,"_5":25505,"_17356":39266,"_1875":39380},[],"Configuración del DMS, para el administrador PKI.",{"_9127":900,"_25351":867,"_21542":39382,"_5":25505,"_17356":39266,"_1875":39383},[],"Integración de dispositivos, para quien consume el endpoint CMP desde firmware, scripts o servicios de aprovisionamiento.",{"_9127":901,"_25351":867,"_21542":39385,"_5":25505,"_17356":39266,"_1875":39386},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_9127":902,"_25351":867,"_21542":39388,"_5":25505,"_17356":39266,"_1875":39389},[],"Perfil",{"_9127":903,"_25351":867,"_21542":39391,"_5":25505,"_17356":39266,"_1875":39392},[],"Leer primero",{"_9127":904,"_25351":867,"_21542":39394,"_5":25505,"_17356":39266,"_1875":39395},[],"Después",{"_9127":905,"_25351":867,"_21542":39397,"_5":25505,"_17356":39266,"_1875":39398},[],"Administrador PKI",{"_9127":906,"_25351":867,"_21542":39400,"_5":25505,"_17356":39266,"_1875":37839},[],{"_9127":907,"_25351":867,"_21542":39402,"_5":25505,"_17356":39266,"_1875":39360},[],{"_9127":908,"_25351":867,"_21542":39404,"_5":25505,"_17356":39266,"_1875":39405},[],"Integrador de dispositivos",{"_9127":909,"_25351":867,"_21542":39407,"_5":25505,"_17356":39266,"_1875":39332},[],{"_9127":910,"_25351":867,"_21542":39409,"_5":25505,"_17356":39266,"_1875":39410},[],"Operaciones soportadas, según el flujo",{"_9127":911,"_25351":867,"_21542":39412,"_5":25505,"_17356":39272,"_1875":39413},[],"Antes de configurar un DMS para CMP, deben existir los siguientes recursos en la plataforma:",{"_9127":912,"_25351":867,"_21542":39415,"_5":25505,"_17356":39272,"_1875":39416},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo. Si se habilita generación de claves en servidor (KGA), las CAs listadas en `ckg_trusted_encryption_cas` también deben existir.",{"_9127":913,"_25351":867,"_21542":39418,"_5":25505,"_17356":39272,"_1875":39419},[],"**Un certificado de protección**: CMP firma sus propias respuestas. El DMS necesita un certificado de tipo End Entity cuya clave privada resida en el KMS de Lamassu (`protection_certificate`, ver más abajo).",{"_9127":914,"_25351":867,"_21542":39421,"_5":25505,"_17356":39272,"_1875":39422},[],"**Un DMS creado**: la configuración CMP se aplica sobre un DMS existente, no lo crea.",{"_9127":915,"_25351":867,"_21542":39424,"_5":25505,"_17356":39272,"_1875":39425},[],"Los ajustes de **CA Distribution** (qué CAs recibe el dispositivo como ancla de confianza) son idénticos para ambos protocolos y se documentan en la visión general del DMS.",{"_9127":916,"_25351":867,"_21542":39427,"_5":25505,"_17356":39275,"_1875":39428},[],"Al crear o editar un DMS, el campo `protocol` decide qué bloque de configuración aplica:",{"_9127":917,"_25351":867,"_21542":39430,"_5":25505,"_17356":39275,"_1875":39431},[],"Valor",{"_9127":918,"_25351":867,"_21542":39433,"_5":25505,"_17356":39275,"_1875":39434},[],"Protocolo",{"_9127":919,"_25351":867,"_21542":39436,"_5":25505,"_17356":39275,"_1875":39437},[],"`EST_RFC7030`",{"_9127":920,"_25351":867,"_21542":39439,"_5":25505,"_17356":39275,"_1875":39440},[],"EST — ver la guía EST",{"_9127":921,"_25351":867,"_21542":39442,"_5":25505,"_17356":39275,"_1875":39443},[],"`CMP_RFC9483`",{"_9127":922,"_25351":867,"_21542":39445,"_5":25505,"_17356":39275,"_1875":39446},[],"CMP — esta página",{"_9127":923,"_25351":867,"_21542":39448,"_5":25505,"_17356":39275,"_1875":39449},[],"Cambiar el `protocol` de un DMS de `EST_RFC7030` a `CMP_RFC9483` (o viceversa) sustituye por completo el bloque de configuración del protocolo saliente. No hay migración automática de ajustes entre uno y otro.",{"_9127":924,"_25351":867,"_21542":39451,"_5":25505,"_17356":39283,"_1875":39452},[],"CMP reconoce los mismos cuatro modos que EST, expuestos en `enrollment_settings.auth_mode`, pero con una diferencia importante: **la autenticación se verifica dentro del propio mensaje CMP, no en la capa de transporte**.",{"_9127":925,"_25351":867,"_21542":39454,"_5":25505,"_17356":39283,"_1875":39455},[],"Modo",{"_9127":926,"_25351":867,"_21542":39457,"_5":25505,"_17356":39283,"_1875":36860},[],{"_9127":927,"_25351":867,"_21542":39459,"_5":25505,"_17356":39283,"_1875":39460},[],"`CLIENT_CERTIFICATE`",{"_9127":928,"_25351":867,"_21542":39462,"_5":25505,"_17356":39283,"_1875":39463},[],"El mensaje debe ir protegido por firma con el certificado del dispositivo (`extraCerts[0]` del `PKIMessage`), validado contra las CAs declaradas en **Validation CAs**. No es mTLS: es la firma sobre el propio `PKIMessage` (RFC 9483 §3.2).",{"_9127":929,"_25351":867,"_21542":39465,"_5":25505,"_17356":39283,"_1875":39466},[],"`EXTERNAL_WEBHOOK`",{"_9127":930,"_25351":867,"_21542":39468,"_5":25505,"_17356":39283,"_1875":39469},[],"La decisión de autorización se delega en un servicio HTTP externo, con el mismo contrato que en EST.",{"_9127":931,"_25351":867,"_21542":39471,"_5":25505,"_17356":39283,"_1875":39472},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_9127":932,"_25351":867,"_21542":39474,"_5":25505,"_17356":39283,"_1875":39475},[],"Combina los dos anteriores: firma válida **y** confirmación del webhook.",{"_9127":933,"_25351":867,"_21542":39477,"_5":25505,"_17356":39283,"_1875":39478},[],"`NO_AUTH`",{"_9127":934,"_25351":867,"_21542":39480,"_5":25505,"_17356":39283,"_1875":39481},[],"Sin autenticación obligatoria. El mensaje puede llegar sin protección; si trae una firma, igualmente se valida. **Exclusivo para entornos de laboratorio**; no debe usarse en producción.",{"_9127":935,"_25351":867,"_21542":39483,"_5":25505,"_17356":39283,"_1875":39484},[],"`NONE` se acepta como alias heredado de `NO_AUTH` desde el panel de administración.",{"_9127":936,"_25351":867,"_21542":39486,"_5":25505,"_17356":39283,"_1875":39487},[],"Cuando el modo incluye `CLIENT_CERTIFICATE`, se configuran los mismos parámetros que en EST (**Validation CAs**, **Chain Validation Level**, **Allow Authenticating Expired Certificates**). Cuando incluye `EXTERNAL_WEBHOOK`, se configuran los mismos parámetros de webhook que en EST (URL, método, timeout, modo de autenticación del webhook) — ver la sección equivalente de la guía EST para el detalle de cada campo; el contrato del servicio webhook es el mismo en ambos protocolos.",{"_9127":937,"_25351":867,"_21542":39489,"_5":25505,"_17356":39287,"_1875":39490},[],"A diferencia de EST, CMP incluye un protocolo de confirmación explícito (RFC 4210 §5.2.8) y admite un flujo de aprobación diferida:",{"_9127":938,"_25351":867,"_21542":39492,"_5":25505,"_17356":39287,"_1875":39493},[],"Campo",{"_9127":939,"_25351":867,"_21542":39495,"_5":25505,"_17356":39287,"_1875":37991},[],{"_9127":940,"_25351":867,"_21542":39497,"_5":25505,"_17356":39287,"_1875":36860},[],{"_9127":941,"_25351":867,"_21542":39499,"_5":25505,"_17356":39287,"_1875":39500},[],"`accept_implicit`",{"_9127":942,"_25351":867,"_21542":39502,"_5":25505,"_17356":39287,"_1875":23460},[],{"_9127":943,"_25351":867,"_21542":39504,"_5":25505,"_17356":39287,"_1875":39505},[],"Permite omitir el paso `certConf` cuando el dispositivo solicita confirmación implícita (`id-it-implicitConfirm`). Solo tiene efecto si el dispositivo también la solicita; no la fuerza.",{"_9127":944,"_25351":867,"_21542":39507,"_5":25505,"_17356":39287,"_1875":39508},[],"`confirmation_timeout`",{"_9127":945,"_25351":867,"_21542":39510,"_5":25505,"_17356":39287,"_1875":39511},[],"duración",{"_9127":946,"_25351":867,"_21542":39513,"_5":25505,"_17356":39287,"_1875":39514},[],"Tiempo máximo de espera del `certConf`. Si no se especifica (o es cero/negativo), el valor por defecto es **5 minutos**.",{"_9127":947,"_25351":867,"_21542":39516,"_5":25505,"_17356":39287,"_1875":39517},[],"`workflow`",{"_9127":948,"_25351":867,"_21542":39519,"_5":25505,"_17356":39287,"_1875":39520},[],"`direct` / `phased`",{"_9127":949,"_25351":867,"_21542":39522,"_5":25505,"_17356":39287,"_1875":39523},[],"`direct` (por defecto) emite el certificado en línea, en la misma respuesta a `ir`/`cr`/`kur`/`p10cr`. `phased` retiene la solicitud hasta que un administrador la apruebe; el dispositivo la recupera después con `pollReq`.",{"_9127":950,"_25351":867,"_21542":39525,"_5":25505,"_17356":39287,"_1875":39526},[],"`approval_timeout`",{"_9127":951,"_25351":867,"_21542":39528,"_5":25505,"_17356":39287,"_1875":39511},[],{"_9127":952,"_25351":867,"_21542":39530,"_5":25505,"_17356":39287,"_1875":39531},[],"Solo aplica con `workflow: phased`. Tiempo que una transacción permanece `PENDING` esperando aprobación. Si no se especifica, el valor por defecto es **7 días**.",{"_9127":953,"_25351":867,"_21542":39533,"_5":25505,"_17356":39287,"_1875":39534},[],"Un certificado emitido y nunca confirmado por el dispositivo dentro de `confirmation_timeout` es revocado automáticamente — ver Monitor de confirmación.",{"_9127":954,"_25351":867,"_21542":39536,"_5":25505,"_17356":39291,"_1875":39537},[],"**Protection Certificate** (`protection_certificate`): número de serie del certificado End Entity, respaldado por el KMS, con el que el DMS firma sus respuestas CMP. Es obligatorio para que el dispositivo pueda validar la autenticidad de la respuesta.",{"_9127":955,"_25351":867,"_21542":39539,"_5":25505,"_17356":39291,"_1875":39540},[],"**Enforce POPO** (`enforce_popo`): controla si `ir`/`cr` deben incluir una prueba de posesión CRMF válida y si `kur` debe llegar protegido por firma. Una `POPOSigningKey` recibida se verifica siempre, sea cual sea este valor; los métodos indirectos (`trusted_ra`, `challenge_response`, `encrypted_certificate`) siguen su propia validación. En `p10cr` la firma del propio CSR PKCS#10 es siempre la prueba de posesión, con independencia de este ajuste.",{"_9127":956,"_25351":867,"_21542":39542,"_5":25505,"_17356":39291,"_1875":39543},[],"**Expected Authenticator** (`expected_authenticator`): respuesta compartida que se compara contra el control `id-regCtrl-authenticator` (RFC 4211 §6.2), si el CSR lo incluye. Vacío por defecto: un control presente se acepta sin comparar su valor. **Marcado como legado** en favor de los controles `registration_token`/`authenticator_control` por operación (ver Ajustes por operación).",{"_9127":957,"_25351":867,"_21542":39545,"_5":25505,"_17356":39295,"_1875":39546},[],"CMP permite que el propio DMS genere el par de claves del dispositivo cuando la solicitud (`ir`/`cr`) llega con la clave pública vacía en el `CertTemplate` (RFC 9483 §4.1.6, también llamado **KGA**, Key Generation Authority).",{"_9127":958,"_25351":867,"_21542":39548,"_5":25505,"_17356":39295,"_1875":39493},[],{"_9127":959,"_25351":867,"_21542":39550,"_5":25505,"_17356":39295,"_1875":37991},[],{"_9127":960,"_25351":867,"_21542":39552,"_5":25505,"_17356":39295,"_1875":36860},[],{"_9127":961,"_25351":867,"_21542":39554,"_5":25505,"_17356":39295,"_1875":39555},[],"`server_key_gen_enabled`",{"_9127":962,"_25351":867,"_21542":39557,"_5":25505,"_17356":39295,"_1875":23460},[],{"_9127":963,"_25351":867,"_21542":39559,"_5":25505,"_17356":39295,"_1875":39560},[],"Habilita la generación de claves en servidor. Desactivado por defecto: una solicitud con clave pública vacía se rechaza con `PKIFailureInfo notAuthorized`.",{"_9127":964,"_25351":867,"_21542":39562,"_5":25505,"_17356":39295,"_1875":39563},[],"`ckg_trusted_encryption_cas`",{"_9127":965,"_25351":867,"_21542":39565,"_5":25505,"_17356":39295,"_1875":39566},[],"lista de IDs de CA",{"_9127":966,"_25351":867,"_21542":39568,"_5":25505,"_17356":39295,"_1875":39569},[],"CAs a las que debe encadenar el certificado destinatario (el certificado al que se cifra la clave generada). Vacío por defecto, lo que **deniega toda solicitud de KGA** aunque el `auth_mode` general sea `NO_AUTH`: KGA es un límite de confianza independiente y más estricto que la autenticación general, porque implica entregar material de clave privada.",{"_9127":967,"_25351":867,"_21542":39571,"_5":25505,"_17356":39295,"_1875":39572},[],"La clave generada por KGA se produce con el motor criptográfico software del proceso (no con AWS KMS, PKCS#11 ni ningún Crypto Engine de hardware), porque la clave debe poder exportarse cifrada hacia el dispositivo — algo incompatible por diseño con un HSM que nunca expone claves privadas en claro. La clave existe en memoria del proceso únicamente durante la duración de la solicitud, envuelta en una estructura CMS (`EnvelopedData` + `SignedData`, mediante transporte RSA o acuerdo de clave ECDH) antes de enviarse. Prefiera la generación de clave en el propio dispositivo siempre que sea posible; reserve KGA para dispositivos que genuinamente no puedan generar su propia clave.",{"_9127":968,"_25351":867,"_21542":39574,"_5":25505,"_17356":39299,"_1875":39575},[],"Además de los campos generales anteriores, cada operación CMP (`ir`, `cr`, `p10cr`, `kur`, `rr`, `genm`, `ccr`) tiene su propio bloque de configuración con un interruptor `enabled` y una política específica. La mayoría admite además `policy_overrides.workflow` y `policy_overrides.confirmation` con el valor `inherit` (toma el ajuste general de la sección anterior) o un valor explícito que lo sustituye para esa operación.",{"_9127":969,"_25351":867,"_21542":39577,"_5":25505,"_17356":39299,"_1875":39578},[],"**`ir` — Initialization Request** (alta inicial, equivalente a `/simpleenroll` de EST):",{"_9127":970,"_25351":867,"_21542":39580,"_5":25505,"_17356":39299,"_1875":39493},[],{"_9127":971,"_25351":867,"_21542":39582,"_5":25505,"_17356":39299,"_1875":36860},[],{"_9127":972,"_25351":867,"_21542":39584,"_5":25505,"_17356":39299,"_1875":39585},[],"`proof_of_possession.required` / `.allowed_methods`",{"_9127":973,"_25351":867,"_21542":39587,"_5":25505,"_17356":39299,"_1875":39588},[],"Si la POPO es obligatoria y qué métodos se aceptan: `signature`, `trusted_ra`, `challenge_response`, `encrypted_certificate`.",{"_9127":974,"_25351":867,"_21542":39590,"_5":25505,"_17356":39299,"_1875":39591},[],"`registration_token` / `authenticator_control`",{"_9127":975,"_25351":867,"_21542":39593,"_5":25505,"_17356":39299,"_1875":39594},[],"Controles opcionales de RFC 4211 §6, con modo `disabled` / `optional` / `required`.",{"_9127":976,"_25351":867,"_21542":39596,"_5":25505,"_17356":39299,"_1875":39597},[],"`central_key_generation.enabled` / `.allowed_recipient_methods`",{"_9127":977,"_25351":867,"_21542":39599,"_5":25505,"_17356":39299,"_1875":39600},[],"Habilita KGA para esta operación en concreto y qué método de entrega admite (`rsa_key_transport`, `ecdh_key_agreement`).",{"_9127":978,"_25351":867,"_21542":39602,"_5":25505,"_17356":39299,"_1875":39603},[],"`identity_source`",{"_9127":979,"_25351":867,"_21542":39605,"_5":25505,"_17356":39299,"_1875":39606},[],"Selecciona de dónde se toma la identidad cuando el subject llega vacío (`subject_only` / `subject_or_san`). **Aún no aplicado** por el servidor: el comportamiento actual es fijo.",{"_9127":980,"_25351":867,"_21542":39608,"_5":25505,"_17356":39299,"_1875":39609},[],"**`cr` — Certification Request** (alta cuando el dispositivo ya tiene una identidad registrada en la plataforma):",{"_9127":981,"_25351":867,"_21542":39611,"_5":25505,"_17356":39299,"_1875":39493},[],{"_9127":982,"_25351":867,"_21542":39613,"_5":25505,"_17356":39299,"_1875":36860},[],{"_9127":983,"_25351":867,"_21542":39615,"_5":25505,"_17356":39299,"_1875":39616},[],"`require_existing_device`",{"_9127":984,"_25351":867,"_21542":39618,"_5":25505,"_17356":39299,"_1875":39619},[],"Exige que el dispositivo ya exista en Lamassu.",{"_9127":985,"_25351":867,"_21542":39621,"_5":25505,"_17356":39299,"_1875":39622},[],"`certificate_behavior`",{"_9127":986,"_25351":867,"_21542":39624,"_5":25505,"_17356":39299,"_1875":39625},[],"`additional` (emite un certificado más, en paralelo) o `replace` (sustituye el certificado activo).",{"_9127":987,"_25351":867,"_21542":39627,"_5":25505,"_17356":39299,"_1875":39628},[],"`maximum_active_certificates`",{"_9127":988,"_25351":867,"_21542":39630,"_5":25505,"_17356":39299,"_1875":39631},[],"Límite de certificados activos simultáneos por dispositivo.",{"_9127":989,"_25351":867,"_21542":39633,"_5":25505,"_17356":39299,"_1875":39634},[],"`allowed_profile_ids`",{"_9127":990,"_25351":867,"_21542":39636,"_5":25505,"_17356":39299,"_1875":39637},[],"Lista blanca de perfiles de emisión permitidos para esta operación.",{"_9127":991,"_25351":867,"_21542":39639,"_5":25505,"_17356":39299,"_1875":39640},[],"`proof_of_possession`, `central_key_generation`",{"_9127":992,"_25351":867,"_21542":39642,"_5":25505,"_17356":39299,"_1875":39643},[],"Mismo esquema que en `ir`.",{"_9127":993,"_25351":867,"_21542":39645,"_5":25505,"_17356":39299,"_1875":39646},[],"**`p10cr` — PKCS#10 Certification Request** (CSR autofirmado en lugar de la estructura CRMF; la firma del propio CSR es la prueba de posesión, sin control de registro ni KGA):",{"_9127":994,"_25351":867,"_21542":39648,"_5":25505,"_17356":39299,"_1875":39493},[],{"_9127":995,"_25351":867,"_21542":39650,"_5":25505,"_17356":39299,"_1875":36860},[],{"_9127":996,"_25351":867,"_21542":39652,"_5":25505,"_17356":39299,"_1875":39634},[],{"_9127":997,"_25351":867,"_21542":39654,"_5":25505,"_17356":39299,"_1875":39655},[],"Lista blanca de perfiles de emisión permitidos.",{"_9127":998,"_25351":867,"_21542":39657,"_5":25505,"_17356":39299,"_1875":39658},[],"**`kur` — Key Update Request** (renovación, equivalente a `/simplereenroll` de EST; el mensaje debe ir protegido con el certificado que se renueva):",{"_9127":999,"_25351":867,"_21542":39660,"_5":25505,"_17356":39299,"_1875":39493},[],{"_9127":1000,"_25351":867,"_21542":39662,"_5":25505,"_17356":39299,"_1875":36860},[],{"_9127":1001,"_25351":867,"_21542":39664,"_5":25505,"_17356":39299,"_1875":39665},[],"`key_policy`",{"_9127":1002,"_25351":867,"_21542":39667,"_5":25505,"_17356":39299,"_1875":39668},[],"`require_new_key` exige una clave distinta a la vigente; `permit_reuse` permite reutilizarla.",{"_9127":1003,"_25351":867,"_21542":39670,"_5":25505,"_17356":39299,"_1875":39671},[],"`identity_change_policy`",{"_9127":1004,"_25351":867,"_21542":39673,"_5":25505,"_17356":39299,"_1875":39674},[],"Cuánto puede variar la identidad respecto al certificado vigente: `forbid`, `san_only` o `subject_and_san`.",{"_9127":1005,"_25351":867,"_21542":39676,"_5":25505,"_17356":39299,"_1875":39677},[],"La ventana de renovación propiamente dicha (deltas, `AllowExpiredRenewal`, CAs de validación adicionales) vive en `reenrollment_settings` — ver Configuración de re-enrollment.",{"_9127":1006,"_25351":867,"_21542":39679,"_5":25505,"_17356":39299,"_1875":39680},[],"**`rr` — Revocation Request** (revocación vía CMP; el mensaje siempre debe ir protegido por firma, no es configurable):",{"_9127":1007,"_25351":867,"_21542":39682,"_5":25505,"_17356":39299,"_1875":39493},[],{"_9127":1008,"_25351":867,"_21542":39684,"_5":25505,"_17356":39299,"_1875":36860},[],{"_9127":1009,"_25351":867,"_21542":39686,"_5":25505,"_17356":39299,"_1875":39687},[],"`authorization`",{"_9127":1010,"_25351":867,"_21542":39689,"_5":25505,"_17356":39299,"_1875":39690},[],"`self_only` (solo el propio dispositivo puede revocar su certificado) o `self_and_trusted_ra` (también una RA de confianza puede revocar en su nombre).",{"_9127":1011,"_25351":867,"_21542":39692,"_5":25505,"_17356":39299,"_1875":39693},[],"`allow_revival`",{"_9127":1012,"_25351":867,"_21542":39695,"_5":25505,"_17356":39299,"_1875":39696},[],"Permite reactivar un certificado en estado `certificateHold`.",{"_9127":1013,"_25351":867,"_21542":39698,"_5":25505,"_17356":39299,"_1875":39699},[],"`allowed_reasons`",{"_9127":1014,"_25351":867,"_21542":39701,"_5":25505,"_17356":39299,"_1875":39702},[],"Lista blanca de razones de revocación aceptadas (`key_compromise`, `ca_compromise`, `affiliation_changed`, `superseded`, `cessation_of_operation`, `privilege_withdrawn`, `aa_compromise`, `unspecified`).",{"_9127":1015,"_25351":867,"_21542":39704,"_5":25505,"_17356":39299,"_1875":39705},[],"`trusted_ra.validation_ca_ids` / `.require_cmc_ra_eku`",{"_9127":1016,"_25351":867,"_21542":39707,"_5":25505,"_17356":39299,"_1875":39708},[],"Cuando `authorization` incluye una RA de confianza, restringe qué CAs debe validar su certificado y si exige el EKU de RA.",{"_9127":1017,"_25351":867,"_21542":39710,"_5":25505,"_17356":39299,"_1875":39711},[],"**`genm`/`genp` — General Message** (canal de descubrimiento, no de inscripción — el dispositivo consulta capacidades del DMS):",{"_9127":1018,"_25351":867,"_21542":39713,"_5":25505,"_17356":39299,"_1875":39493},[],{"_9127":1019,"_25351":867,"_21542":39715,"_5":25505,"_17356":39299,"_1875":36860},[],{"_9127":1020,"_25351":867,"_21542":39717,"_5":25505,"_17356":39299,"_1875":39718},[],"`access_policy`",{"_9127":1021,"_25351":867,"_21542":39720,"_5":25505,"_17356":39299,"_1875":39721},[],"`public_discovery` responde sin exigir mensaje protegido; `require_signed` exige firma válida.",{"_9127":1022,"_25351":867,"_21542":39723,"_5":25505,"_17356":39299,"_1875":39724},[],"`information_types.*`",{"_9127":1023,"_25351":867,"_21542":39726,"_5":25505,"_17356":39299,"_1875":39727},[],"Interruptores independientes por tipo de información: certificados de CA, tipos de clave de firma/cifrado, algoritmo simétrico preferido, idiomas soportados, actualización de CA raíz, plantilla de solicitud de certificado, CRL vigente y actualizaciones de CRL.",{"_9127":1024,"_25351":867,"_21542":39729,"_5":25505,"_17356":39299,"_1875":39730},[],"**`ccr`/`ccp` — Cross-Certification Request** (operación privilegiada CA-a-CA, deshabilitada por defecto; el firmante del mensaje debe ser él mismo un certificado de CA):",{"_9127":1025,"_25351":867,"_21542":39732,"_5":25505,"_17356":39299,"_1875":39493},[],{"_9127":1026,"_25351":867,"_21542":39734,"_5":25505,"_17356":39299,"_1875":36860},[],{"_9127":1027,"_25351":867,"_21542":39736,"_5":25505,"_17356":39299,"_1875":39737},[],"`requester_mode`",{"_9127":1028,"_25351":867,"_21542":39739,"_5":25505,"_17356":39299,"_1875":39740},[],"`any` (cualquier CA firmante, sujeto a `require_ca_certificate`) o `restricted` (solo CAs listadas en `trusted_requester_ca_ids`; vacío deniega a todos).",{"_9127":1029,"_25351":867,"_21542":39742,"_5":25505,"_17356":39299,"_1875":39743},[],"`require_ca_certificate` / `require_proof_of_possession`",{"_9127":1030,"_25351":867,"_21542":39745,"_5":25505,"_17356":39299,"_1875":39746},[],"Exige que el firmante sea certificado de CA y/o prueba de posesión.",{"_9127":1031,"_25351":867,"_21542":39748,"_5":25505,"_17356":39299,"_1875":39749},[],"`issuance_profile_id`, `maximum_validity`, `subject_constraints`",{"_9127":1032,"_25351":867,"_21542":39751,"_5":25505,"_17356":39299,"_1875":39752},[],"Perfil de emisión, validez máxima y restricciones de subject/SAN para el certificado cruzado emitido.",{"_9127":1033,"_25351":867,"_21542":39754,"_5":25505,"_17356":39299,"_1875":39517},[],{"_9127":1034,"_25351":867,"_21542":39756,"_5":25505,"_17356":39299,"_1875":39757},[],"`direct` o `administrator_approval`, independiente del `workflow` general de la sección de enrollment.",{"_9127":1035,"_25351":867,"_21542":39759,"_5":25505,"_17356":39299,"_1875":39760},[],"`ccr` no está pensado para inscripción de dispositivos, sino para interoperabilidad entre PKIs (una CA emite un certificado cruzado para la identidad de otra CA).",{"_9127":1036,"_25351":867,"_21542":39762,"_5":25505,"_17356":39303,"_1875":39763},[],"La sección `reenrollment_settings` gobierna la renovación (`kur`) con los mismos campos que EST:",{"_9127":1037,"_25351":867,"_21542":39765,"_5":25505,"_17356":39303,"_1875":39493},[],{"_9127":1038,"_25351":867,"_21542":39767,"_5":25505,"_17356":39303,"_1875":39768},[],"Efecto",{"_9127":1039,"_25351":867,"_21542":39770,"_5":25505,"_17356":39303,"_1875":39771},[],"`reenrollment_delta`",{"_9127":1040,"_25351":867,"_21542":39773,"_5":25505,"_17356":39303,"_1875":39774},[],"Ventana previa a la caducidad durante la cual se permite renovar.",{"_9127":1041,"_25351":867,"_21542":39776,"_5":25505,"_17356":39303,"_1875":39777},[],"`enable_expired_renewal`",{"_9127":1042,"_25351":867,"_21542":39779,"_5":25505,"_17356":39303,"_1875":39780},[],"Permite renovar un certificado ya caducado.",{"_9127":1043,"_25351":867,"_21542":39782,"_5":25505,"_17356":39303,"_1875":39783},[],"`revoke_on_reenrollment`",{"_9127":1044,"_25351":867,"_21542":39785,"_5":25505,"_17356":39303,"_1875":39786},[],"Revoca automáticamente el certificado anterior (`superseded`) tras emitir el nuevo.",{"_9127":1045,"_25351":867,"_21542":39788,"_5":25505,"_17356":39303,"_1875":39789},[],"`additional_validation_cas`",{"_9127":1046,"_25351":867,"_21542":39791,"_5":25505,"_17356":39303,"_1875":39792},[],"CAs adicionales aceptadas como emisoras del certificado en vigor durante la renovación.",{"_9127":1047,"_25351":867,"_21542":39794,"_5":25505,"_17356":39303,"_1875":39795},[],"`preventive_delta` / `critical_delta`",{"_9127":1048,"_25351":867,"_21542":39797,"_5":25505,"_17356":39303,"_1875":39798},[],"Umbrales para alertas de renovación preventiva y crítica.",{"_9127":1049,"_25351":867,"_21542":39800,"_5":25505,"_17356":39303,"_1875":39801},[],"Consulte la sección equivalente de la guía EST para el detalle de cada campo; el significado es idéntico.",{"_9127":1050,"_25351":867,"_21542":39803,"_5":25505,"_17356":39307,"_1875":39804},[],"El certificado emitido está gobernado por el mismo `IssuanceProfile` (`HonorSubject`, `HonorKeyUsage`, `HonorExtendedKeyUsages`, `HonorExtensions`) que en EST. Consulte Perfil de emisión en la guía EST para el detalle de cada campo — el efecto sobre el certificado final es el mismo con independencia del protocolo de inscripción.",{"_9127":1051,"_25351":867,"_21542":39806,"_5":25505,"_17356":39311,"_1875":39807},[],"Cada `ir`/`cr`/`kur`/`p10cr` recibido por un DMS en CMP queda registrado como una **transacción CMP**, identificada por el `transactionID` hexadecimal del `PKIHeader`. Su estado es visible desde el panel de administración y a través de la API de gestión:",{"_9127":1052,"_25351":867,"_21542":39809,"_5":25505,"_17356":39311,"_1875":39810},[],"Endpoint",{"_9127":1053,"_25351":867,"_21542":39812,"_5":25505,"_17356":39311,"_1875":36860},[],{"_9127":1054,"_25351":867,"_21542":39814,"_5":25505,"_17356":39311,"_1875":39815},[],"`GET /v1/dms/{id}/cmp/transactions`",{"_9127":1055,"_25351":867,"_21542":39817,"_5":25505,"_17356":39311,"_1875":39818},[],"Lista paginada de transacciones del DMS (`page_size`, `bookmark`, `sort_by`, `filter`). No incluye el DER del certificado o CSR; el certificado se recupera aparte desde la API de CAs usando `certificate_serial_number`.",{"_9127":1056,"_25351":867,"_21542":39820,"_5":25505,"_17356":39311,"_1875":39821},[],"`POST /v1/dms/{id}/cmp/transactions/{txid}/approve`",{"_9127":1057,"_25351":867,"_21542":39823,"_5":25505,"_17356":39311,"_1875":39824},[],"Aprueba una transacción `PENDING` de un DMS con `workflow: phased`, emitiendo el certificado. El dispositivo lo recupera en su siguiente `pollReq`.",{"_9127":1058,"_25351":867,"_21542":39826,"_5":25505,"_17356":39311,"_1875":39827},[],"`POST /v1/dms/{id}/cmp/transactions/{txid}/reject`",{"_9127":1059,"_25351":867,"_21542":39829,"_5":25505,"_17356":39311,"_1875":39830},[],"Rechaza una transacción `PENDING`; pasa a `ISSUE_FAILED` con un motivo opcional (`{\"reason\": \"...\"}`) que el dispositivo recibe en su siguiente `pollReq`.",{"_9127":1060,"_25351":867,"_21542":39832,"_5":25505,"_17356":39311,"_1875":39833},[],"Los estados visibles de una transacción son:",{"_9127":1061,"_25351":867,"_21542":39835,"_5":25505,"_17356":39311,"_1875":39836},[],"Estado",{"_9127":1062,"_25351":867,"_21542":39838,"_5":25505,"_17356":39311,"_1875":39839},[],"Significado",{"_9127":1063,"_25351":867,"_21542":39841,"_5":25505,"_17356":39311,"_1875":39842},[],"`PENDING`",{"_9127":1064,"_25351":867,"_21542":39844,"_5":25505,"_17356":39311,"_1875":39845},[],"Solicitud aceptada, pendiente de emisión (flujo `phased`) o de aprobación administrativa.",{"_9127":1065,"_25351":867,"_21542":39847,"_5":25505,"_17356":39311,"_1875":39848},[],"`ISSUED`",{"_9127":1066,"_25351":867,"_21542":39850,"_5":25505,"_17356":39311,"_1875":39851},[],"Certificado emitido, a la espera de `certConf` del dispositivo.",{"_9127":1067,"_25351":867,"_21542":39853,"_5":25505,"_17356":39311,"_1875":39854},[],"`CONFIRMED`",{"_9127":1068,"_25351":867,"_21542":39856,"_5":25505,"_17356":39311,"_1875":39857},[],"El dispositivo confirmó la recepción con `certConf`. Estado terminal.",{"_9127":1069,"_25351":867,"_21542":39859,"_5":25505,"_17356":39311,"_1875":39860},[],"`ISSUE_FAILED`",{"_9127":1070,"_25351":867,"_21542":39862,"_5":25505,"_17356":39311,"_1875":39863},[],"La CA rechazó la emisión, o un administrador rechazó la transacción. Estado terminal.",{"_9127":1071,"_25351":867,"_21542":39865,"_5":25505,"_17356":39311,"_1875":38254},[],{"_9127":1072,"_25351":867,"_21542":39867,"_5":25505,"_17356":39311,"_1875":39868},[],"El certificado emitido fue revocado (por expiración del plazo de confirmación o por un `rr` posterior). Estado terminal.",{"_9127":1073,"_25351":867,"_21542":39870,"_5":25505,"_17356":39311,"_1875":39871},[],"Las aprobaciones/rechazos solo tienen efecto sobre DMS configurados con `workflow: phased`; en `workflow: direct` una transacción nace ya en `ISSUED`.",{"_9127":1074,"_25351":867,"_21542":39873,"_5":25505,"_17356":39315,"_1875":39874},[],"Un certificado `ISSUED` que el dispositivo nunca confirma dentro de `confirmation_timeout` queda, por definición del RFC 4210 §5.2.8, en un estado de confianza indeterminado. Un job periódico de fondo — habilitado y programado mediante la clave de configuración del servicio `cmp_confirmation_monitoring_job` (`enabled`, `frequency`), con el mismo esquema que el job de monitorización de certificados de la CA — se encarga de:",{"_9127":1075,"_25351":867,"_21542":39876,"_5":25505,"_17356":39315,"_1875":39877},[],"**Revocar certificados sin confirmar**: transacciones `ISSUED` cuya ventana de confirmación expiró se revocan en la CA con la razón `cessationOfOperation` y pasan a `REVOKED`.",{"_9127":1076,"_25351":867,"_21542":39879,"_5":25505,"_17356":39315,"_1875":39880},[],"**Cerrar aprobaciones pendientes**: transacciones `PENDING` en flujo `phased` que ningún administrador resolvió dentro de `approval_timeout` pasan a `ISSUE_FAILED`, y se conservan **7 días** para que un `pollReq` tardío pueda ver el motivo del rechazo.",{"_9127":1077,"_25351":867,"_21542":39882,"_5":25505,"_17356":39315,"_1875":39883},[],"Cada ejecución procesa como máximo **100 transacciones** por lote, para evitar una ráfaga de revocaciones tras una interrupción prolongada del servicio.",{"_9127":1078,"_25351":867,"_21542":39885,"_5":25505,"_17356":39319,"_1875":39886},[],"Si el cliente WFX del servicio está habilitado (`wfx.enabled`), cada transición de una transacción CMP se refleja además como un job en WFX (motor de workflows de Siemens), bajo dos plantillas predefinidas según el `workflow` del DMS (`direct` o `phased`). Esto es puramente observabilidad/orquestación externa: si WFX no está habilitado, o si una llamada a WFX falla, la operación CMP en Lamassu no se ve afectada.",{"_9127":1079,"_25351":867,"_21542":39888,"_5":25505,"_17356":39323,"_1875":39889},[],"**Desde la consola**: acceda al detalle del DMS y compruebe que la sección CMP muestra el protocolo activo, la CA de enrolamiento y el certificado de protección configurados.",{"_9127":1080,"_25351":867,"_21542":39891,"_5":25505,"_17356":39323,"_1875":39892},[],"**Con una solicitud de prueba**: use `openssl cmp` con el comando `genm` (o `ir`, si ya dispone de un firmante válido) contra el endpoint del DMS — ver Ejemplo con openssl cmp.",{"_9127":1081,"_25351":867,"_21542":39894,"_5":25505,"_17356":39327,"_1875":39895},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_9127":1082,"_25351":867,"_21542":39897,"_5":25505,"_17356":39331,"_1875":39898},[],"El administrador PKI debe haber configurado un DMS con el protocolo `CMP_RFC9483`, una CA de enrolamiento, un certificado de protección y al menos un modo de autenticación. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_9127":1083,"_25351":867,"_21542":39900,"_5":25505,"_17356":39331,"_1875":39901},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_9127":1084,"_25351":867,"_21542":39903,"_5":25505,"_17356":39331,"_1875":39904},[],"Elemento",{"_9127":1085,"_25351":867,"_21542":39906,"_5":25505,"_17356":39331,"_1875":36860},[],{"_9127":1086,"_25351":867,"_21542":39908,"_5":25505,"_17356":39331,"_1875":39909},[],"**URL del host CMP**",{"_9127":1087,"_25351":867,"_21542":39911,"_5":25505,"_17356":39331,"_1875":39912},[],"Dirección base del servidor, por ejemplo `https://cmp.lamassu.example`. La proporciona el administrador PKI.",{"_9127":1088,"_25351":867,"_21542":39914,"_5":25505,"_17356":39331,"_1875":39915},[],"**ID del DMS**",{"_9127":1089,"_25351":867,"_21542":39917,"_5":25505,"_17356":39331,"_1875":39918},[],"Identificador del DMS, incluido en la ruta del endpoint (`/.well-known/cmp/p/{id}`).",{"_9127":1090,"_25351":867,"_21542":39920,"_5":25505,"_17356":39331,"_1875":39921},[],"**Certificado y clave de firma del mensaje**",{"_9127":1091,"_25351":867,"_21542":39923,"_5":25505,"_17356":39331,"_1875":39924},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. A diferencia de EST, no se usa como credencial mTLS: se incluye como `extraCerts[0]` y firma el `PKIMessage`.",{"_9127":1092,"_25351":867,"_21542":39926,"_5":25505,"_17356":39335,"_1875":39927},[],"Operación",{"_9127":1093,"_25351":867,"_21542":39929,"_5":25505,"_17356":39335,"_1875":37556},[],{"_9127":1094,"_25351":867,"_21542":39931,"_5":25505,"_17356":39335,"_1875":39932},[],"Requiere identidad previa",{"_9127":1095,"_25351":867,"_21542":39934,"_5":25505,"_17356":39335,"_1875":39935},[],"`ir`",{"_9127":1096,"_25351":867,"_21542":39937,"_5":25505,"_17356":39335,"_1875":39938},[],"Alta inicial de un dispositivo nuevo.",{"_9127":1097,"_25351":867,"_21542":39940,"_5":25505,"_17356":39335,"_1875":38056},[],{"_9127":1098,"_25351":867,"_21542":39942,"_5":25505,"_17356":39335,"_1875":39943},[],"`cr`",{"_9127":1099,"_25351":867,"_21542":39945,"_5":25505,"_17356":39335,"_1875":39946},[],"Emisión adicional o de sustitución para un dispositivo ya identificado.",{"_9127":1100,"_25351":867,"_21542":39948,"_5":25505,"_17356":39335,"_1875":39949},[],"Sí (según `require_existing_device`)",{"_9127":1101,"_25351":867,"_21542":39951,"_5":25505,"_17356":39335,"_1875":39952},[],"`p10cr`",{"_9127":1102,"_25351":867,"_21542":39954,"_5":25505,"_17356":39335,"_1875":39955},[],"Alta con un CSR PKCS#10 autofirmado, sin controles CRMF ni KGA.",{"_9127":1103,"_25351":867,"_21542":39957,"_5":25505,"_17356":39335,"_1875":38056},[],{"_9127":1104,"_25351":867,"_21542":39959,"_5":25505,"_17356":39335,"_1875":39960},[],"`kur`",{"_9127":1105,"_25351":867,"_21542":39962,"_5":25505,"_17356":39335,"_1875":39963},[],"Renovación de un certificado existente; el mensaje se firma con el certificado vigente.",{"_9127":1106,"_25351":867,"_21542":39965,"_5":25505,"_17356":39335,"_1875":39966},[],"Sí (el certificado que se renueva)",{"_9127":1107,"_25351":867,"_21542":39968,"_5":25505,"_17356":39335,"_1875":39969},[],"`rr`",{"_9127":1108,"_25351":867,"_21542":39971,"_5":25505,"_17356":39335,"_1875":39972},[],"Revocación de un certificado, siempre firmada.",{"_9127":1109,"_25351":867,"_21542":39974,"_5":25505,"_17356":39335,"_1875":38004},[],{"_9127":1110,"_25351":867,"_21542":39976,"_5":25505,"_17356":39335,"_1875":39977},[],"`genm`/`genp`",{"_9127":1111,"_25351":867,"_21542":39979,"_5":25505,"_17356":39335,"_1875":39980},[],"Consulta de capacidades del DMS (CAs, tipos de clave, CRL vigente, etc.). No emite certificados.",{"_9127":1112,"_25351":867,"_21542":39982,"_5":25505,"_17356":39335,"_1875":38056},[],{"_9127":1113,"_25351":867,"_21542":39984,"_5":25505,"_17356":39335,"_1875":39985},[],"`ccr`/`ccp`",{"_9127":1114,"_25351":867,"_21542":39987,"_5":25505,"_17356":39335,"_1875":39988},[],"Certificación cruzada entre CAs. Solo para operadores de CA, deshabilitada por defecto.",{"_9127":1115,"_25351":867,"_21542":39990,"_5":25505,"_17356":39335,"_1875":39991},[],"El firmante debe ser una CA",{"_9127":1116,"_25351":867,"_21542":39993,"_5":25505,"_17356":39335,"_1875":39994},[],"`nested`",{"_9127":1117,"_25351":867,"_21542":39996,"_5":25505,"_17356":39335,"_1875":39997},[],"Envoltorio que agrupa varios mensajes o añade una capa extra de protección (p. ej. una RA contrafirmando a un dispositivo). No es una operación en sí misma.",{"_9127":1118,"_25351":867,"_21542":39999,"_5":25505,"_17356":39335,"_1875":38234},[],{"_9127":1119,"_25351":867,"_21542":40001,"_5":25505,"_17356":39335,"_1875":40002},[],"Los pasos de protocolo `certConf` (confirmación), `pollReq` (sondeo en flujo `phased` o mientras se espera respuesta) y `popdecc`/`popdecr` (prueba de posesión por reto-respuesta) forman parte del ciclo de vida de las operaciones anteriores, no son operaciones que el integrador elija por separado.",{"_9127":1120,"_25351":867,"_21542":40004,"_5":25505,"_17356":39339,"_1875":40005},[],"CMP autentica **el mensaje**, no la conexión: no hay handshake mTLS equivalente al de EST. Cuando el `auth_mode` del DMS exige `CLIENT_CERTIFICATE`, el dispositivo debe:",{"_9127":1121,"_25351":867,"_21542":40007,"_5":25505,"_17356":39339,"_1875":40008},[],"Incluir su certificado en el campo `extraCerts` del `PKIMessage` (primera posición).",{"_9127":1122,"_25351":867,"_21542":40010,"_5":25505,"_17356":39339,"_1875":40011},[],"Firmar el `PKIMessage` completo con la clave privada correspondiente a ese certificado (protección basada en firma, RFC 9483 §3.2).",{"_9127":1123,"_25351":867,"_21542":40013,"_5":25505,"_17356":39339,"_1875":40014},[],"El servidor valida esa firma contra las CAs declaradas en `client_certificate_settings.validation_cas`, con los mismos parámetros de profundidad de cadena y tolerancia a certificados caducados que EST. En modos `EXTERNAL_WEBHOOK` y `NO_AUTH` el mensaje puede llegar sin protección, aunque si el cliente incluye una firma igualmente se verifica.",{"_9127":1124,"_25351":867,"_21542":40016,"_5":25505,"_17356":39343,"_1875":40017},[],"A diferencia de EST, CMP se sirve desde un **único endpoint**:",{"_9127":1125,"_25351":867,"_21542":40019,"_5":25505,"_17356":39343,"_1875":40020},[],"donde `{id}` es el identificador del DMS — la ruta sigue el formato de URI *well-known* del RFC 9480 §3.3, por lo que clientes CMP estándar la reconocen sin configuración adicional (`openssl cmp -server <host> -path /.well-known/cmp/p/<dms-id>`).",{"_9127":1126,"_25351":867,"_21542":40022,"_5":25505,"_17356":39343,"_1875":40023},[],"**Content-Type**: `application/pkixcmp` tanto en la solicitud como en la respuesta. Una solicitud con un `Content-Type` distinto se rechaza con `415 Unsupported Media Type`.",{"_9127":1127,"_25351":867,"_21542":40025,"_5":25505,"_17356":39343,"_1875":40026},[],"**Cuerpo**: un `PKIMessage` en DER binario (no base64, a diferencia de los endpoints EST). La respuesta es igualmente DER binario.",{"_9127":1128,"_25351":867,"_21542":40028,"_5":25505,"_17356":39343,"_1875":40029},[],"**Despacho por contenido, no por ruta**: el servidor decodifica el `PKIMessage`, valida la cabecera (versión de protocolo, `transactionID`, `senderNonce`, deriva temporal) y despacha la operación según la etiqueta (`tag`) del `PKIBody` — `ir`, `cr`, `p10cr`, `kur`, `rr`, `certConf`, `pollReq`, `genm`, `ccr`, `nested`, etc.",{"_9127":1129,"_25351":867,"_21542":40031,"_5":25505,"_17356":39343,"_1875":40032},[],"**Sin autenticación a nivel de transporte**: el endpoint no exige mTLS ni cabeceras de autorización; toda la autenticación viaja dentro del mensaje, como se describe en Modelo de autenticación.",{"_9127":1130,"_25351":867,"_21542":40034,"_5":25505,"_17356":39343,"_1875":40035},[],"**Tamaño máximo de solicitud**: 1 MiB. Una solicitud mayor se rechaza antes de intentar decodificarla.",{"_9127":1131,"_25351":867,"_21542":40037,"_5":25505,"_17356":39343,"_1875":40038},[],"La mayoría de rechazos de protocolo se devuelven como un `PKIMessage` de error firmado, con `HTTP 200` — el integrador debe inspeccionar el cuerpo CMP, no solo el código HTTP, para detectar un fallo. Los códigos HTTP de error (`400`, `415`) se reservan para los casos en los que ni siquiera se puede construir una respuesta CMP válida — ver Códigos de error y diagnóstico.",{"_9127":1132,"_25351":867,"_21542":40040,"_5":25505,"_17356":39347,"_1875":40041},[],"Cuando el DMS tiene `server_key_gen_enabled: true` para la operación correspondiente, un dispositivo puede enviar un `ir`/`cr` con el campo de clave pública del `CertTemplate` vacío para solicitar que el servidor genere el par de claves. El servidor:",{"_9127":1133,"_25351":867,"_21542":40043,"_5":25505,"_17356":39347,"_1875":40044},[],"Genera la clave con el algoritmo implícito en la solicitud.",{"_9127":1134,"_25351":867,"_21542":40046,"_5":25505,"_17356":39347,"_1875":40047},[],"Cifra la clave privada para el destinatario indicado en el mensaje, usando transporte de clave RSA (CMS `KeyTransRecipientInfo`) o acuerdo de clave ECDH (CMS `KeyAgreeRecipientInfo`), según lo que la solicitud pida y `central_key_generation.allowed_recipient_methods` permita.",{"_9127":1135,"_25351":867,"_21542":40049,"_5":25505,"_17356":39347,"_1875":40050},[],"Devuelve la clave envuelta junto con el certificado emitido, en la misma respuesta.",{"_9127":1136,"_25351":867,"_21542":40052,"_5":25505,"_17356":39347,"_1875":40053},[],"El certificado destinatario debe encadenar a una de las CAs de `ckg_trusted_encryption_cas`; si esa lista está vacía, el DMS deniega toda solicitud de KGA aunque el resto del enrolamiento use `NO_AUTH`. Consulte el aviso de seguridad en Generación de claves en servidor — la clave se genera con criptografía software, no en el motor de hardware que respalda el resto de claves de la plataforma.",{"_9127":1137,"_25351":867,"_21542":40055,"_5":25505,"_17356":39351,"_1875":40056},[],"Los siguientes comandos usan el cliente `cmp` de OpenSSL (≥ 3.0) contra un DMS configurado en modo `CLIENT_CERTIFICATE`.",{"_9127":1138,"_25351":867,"_21542":40058,"_5":25505,"_17356":39351,"_1875":40059},[],"**Alta inicial (`ir`)**, firmando con un certificado bootstrap (`signer.crt`/`signer.key`) emitido por una de las `validation_cas` del DMS, y generando una clave EC nueva para el dispositivo:",{"_9127":1139,"_25351":867,"_21542":40061,"_5":25505,"_17356":39351,"_1875":40062},[],"`-tls_used` es necesario en OpenSSL 3.0.x cuando la URL del servidor usa `https` sin pin del certificado del servidor (`-srvcert`); versiones ≥ 3.2 lo infieren automáticamente. `-unprotected_errors` permite aceptar respuestas de error del servidor aunque no vengan protegidas, útil mientras se depura la configuración inicial.",{"_9127":1140,"_25351":867,"_21542":40064,"_5":25505,"_17356":39351,"_1875":40065},[],"**Renovación (`kur`)**, autenticando con el certificado vigente del dispositivo:",{"_9127":1141,"_25351":867,"_21542":40067,"_5":25505,"_17356":39351,"_1875":40068},[],"`-srvcert` fija el certificado con el que se espera que el DMS firme su respuesta (el **Protection Certificate** configurado en el DMS); sin él, OpenSSL no puede validar la protección de la respuesta salvo que se use `-unprotected_errors` para los casos de error.",{"_9127":1142,"_25351":867,"_21542":40070,"_5":25505,"_17356":39355,"_1875":40071},[],"**Confirmar el certificado**: salvo que `accept_implicit` esté activo en el DMS y el dispositivo lo solicite, el flujo no se considera completo hasta que el dispositivo envía `certConf`. `openssl cmp -cmd ir`/`kur` lo hace automáticamente; una integración manual debe implementar este paso.",{"_9127":1143,"_25351":867,"_21542":40073,"_5":25505,"_17356":39355,"_1875":40074},[],"**Planificar la renovación**: igual que en EST, programe `kur` dentro de la ventana `reenrollment_delta` antes de la caducidad del certificado.",{"_9127":1144,"_25351":867,"_21542":40076,"_5":25505,"_17356":39355,"_1875":40077},[],"**Flujo `phased`**: si el DMS usa `workflow: phased`, la primera respuesta a `ir`/`cr`/`kur` será un estado de espera (`waiting`); el dispositivo debe reintentar con `pollReq` hasta que un administrador apruebe o rechace la transacción.",{"_9127":1145,"_25351":867,"_21542":40079,"_5":25505,"_17356":39363,"_1875":40080},[],"Un `PKIMessage` de error firmado, devuelto con `HTTP 200`, es la respuesta normal ante una solicitud rechazada por política (autenticación fallida, operación deshabilitada, ventana de renovación cerrada, etc.). Los códigos HTTP de error están reservados para fallos de transporte donde no se puede construir un `PKIMessage` de respuesta.",{"_9127":1146,"_25351":867,"_21542":40082,"_5":25505,"_17356":39363,"_1875":40083},[],"HTTP",{"_9127":1147,"_25351":867,"_21542":40085,"_5":25505,"_17356":39363,"_1875":40086},[],"Causa",{"_9127":1148,"_25351":867,"_21542":40088,"_5":25505,"_17356":39363,"_1875":40089},[],"Acción del integrador",{"_9127":1149,"_25351":867,"_21542":40091,"_5":25505,"_17356":39363,"_1875":22465},[],{"_9127":1150,"_25351":867,"_21542":40093,"_5":25505,"_17356":39363,"_1875":40094},[],"`Content-Type` distinto de `application/pkixcmp`.",{"_9127":1151,"_25351":867,"_21542":40096,"_5":25505,"_17356":39363,"_1875":40097},[],"Fijar la cabecera correcta.",{"_9127":1152,"_25351":867,"_21542":40099,"_5":25505,"_17356":39363,"_1875":22430},[],{"_9127":1153,"_25351":867,"_21542":40101,"_5":25505,"_17356":39363,"_1875":40102},[],"El cuerpo no se puede decodificar como `PKIMessage` ASN.1 (no hay `PKIHeader` válido con el que construir un error CMP firmado).",{"_9127":1154,"_25351":867,"_21542":40104,"_5":25505,"_17356":39363,"_1875":40105},[],"Verificar que el cuerpo es DER binario, no base64 ni PEM.",{"_9127":1155,"_25351":867,"_21542":40107,"_5":25505,"_17356":39363,"_1875":40108},[],"400 (como `PKIMessage` de error)",{"_9127":1156,"_25351":867,"_21542":40110,"_5":25505,"_17356":39363,"_1875":40111},[],"Cabecera `PKIHeader` malformada, `transactionID`/`senderNonce`/deriva temporal inválidos, o `recipNonce` presente en una solicitud inicial (`ir`/`cr`/`p10cr`), lo que viola RFC 9483 §3.1.",{"_9127":1157,"_25351":867,"_21542":40113,"_5":25505,"_17356":39363,"_1875":40114},[],"Revisar la implementación del cliente CMP; con `openssl cmp` esto no debería ocurrir salvo mensajes construidos a mano.",{"_9127":1158,"_25351":867,"_21542":40116,"_5":25505,"_17356":39363,"_1875":40117},[],"200 (`PKIMessage` de error, `notAuthorized`)",{"_9127":1159,"_25351":867,"_21542":40119,"_5":25505,"_17356":39363,"_1875":40120},[],"Operación deshabilitada para el DMS, o solicitud de KGA sin CA destinataria de confianza configurada.",{"_9127":1160,"_25351":867,"_21542":40122,"_5":25505,"_17356":39363,"_1875":40123},[],"Confirmar con el administrador PKI que la operación y, si aplica, KGA están habilitadas.",{"_9127":1161,"_25351":867,"_21542":40125,"_5":25505,"_17356":39363,"_1875":40126},[],"Para interpretar el motivo exacto de un rechazo CMP, inspeccione el campo `PKIFailureInfo`/`statusString` del `PKIMessage` de respuesta (por ejemplo con `openssl cmp ... -rspout response.der` y `openssl asn1parse -inform DER -in response.der`).",{"_9127":1162,"_25351":867,"_21542":40128,"_5":25505,"_17356":39367,"_1875":40129},[],"CMP se sirve en un único endpoint multiplexado (`/.well-known/cmp/p/{id}`); no existen rutas separadas por operación como en EST.",{"_9127":1163,"_25351":867,"_21542":40131,"_5":25505,"_17356":39367,"_1875":40132},[],"La autenticación es a nivel de mensaje (firma sobre el `PKIMessage`), no de transporte: no hay mTLS equivalente en CMP.",{"_9127":1164,"_25351":867,"_21542":40134,"_5":25505,"_17356":39367,"_1875":40135},[],"Las operaciones `ir`, `cr` y `p10cr` no admiten `recipNonce` en la solicitud inicial (RFC 9483 §3.1); un cliente que lo incluya recibe `badRecipientNonce`.",{"_9127":1165,"_25351":867,"_21542":40137,"_5":25505,"_17356":39367,"_1875":40138},[],"Los estados internos `APPROVING` y `REVOKING` de una transacción (usados para evitar condiciones de carrera durante la aprobación o revocación) son transitorios y no se exponen como valores posibles en la API de listado de transacciones; solo aparecen `PENDING`, `ISSUED`, `CONFIRMED`, `ISSUE_FAILED` y `REVOKED`.",{"_9127":1166,"_25351":867,"_21542":40140,"_5":25505,"_17356":39367,"_1875":40141},[],"`ExpectedAuthenticator` (control heredado, ver Certificado de protección y prueba de posesión) coexiste con los controles `registration_token`/`authenticator_control` por operación, pero no se migra automáticamente a ellos.",{"_9127":1167,"_25351":867,"_21542":40143,"_5":25505,"_17356":39367,"_1875":40144},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_9127":1168,"_25351":867,"_21542":40146,"_5":25505,"_17356":39367,"_1875":40147},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_9127":1169,"_25351":867,"_21542":40149,"_5":25505,"_17356":39367,"_1875":40150},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_9127":1170,"_25351":1170,"_5":25500,"_1875":40152,"_25513":40153,"_21542":40154,"_17356":1170},"[Devices] Dispositivos e Identidades",[36657,37756,37765],[],{"_9127":1171,"_25351":1170,"_21542":40156,"_5":25505,"_17356":1170,"_1875":40157},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_9127":1172,"_25351":1170,"_5":25510,"_21542":40159,"_17356":40160,"_1875":40161},[],"/docs/pr-preview/pr-24/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_9127":1173,"_25351":1170,"_5":25510,"_21542":40163,"_17356":40164,"_1875":40165},[],"/docs/pr-preview/pr-24/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_9127":1174,"_25351":1170,"_5":25510,"_21542":40167,"_17356":40168,"_1875":40169},[],"/docs/pr-preview/pr-24/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_9127":1175,"_25351":1170,"_5":25510,"_21542":40171,"_17356":40172,"_1875":40173},[],"/docs/pr-preview/pr-24/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_9127":1176,"_25351":1170,"_5":25510,"_21542":40175,"_17356":40176,"_1875":40177},[],"/docs/pr-preview/pr-24/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_9127":1177,"_25351":1170,"_5":25510,"_21542":40179,"_17356":40180,"_1875":40181},[],"/docs/pr-preview/pr-24/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_9127":1178,"_25351":1170,"_5":25510,"_21542":40183,"_17356":40184,"_1875":40185},[],"/docs/pr-preview/pr-24/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_9127":1179,"_25351":1170,"_5":25510,"_21542":40187,"_17356":40188,"_1875":40189},[],"/docs/pr-preview/pr-24/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_9127":1180,"_25351":1170,"_21542":40191,"_5":25505,"_17356":40160,"_1875":40192},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_9127":1181,"_25351":1170,"_21542":40194,"_5":25505,"_17356":40164,"_1875":40195},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_9127":1182,"_25351":1170,"_21542":40197,"_5":25505,"_17356":40164,"_1875":40198},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_9127":1183,"_25351":1170,"_21542":40200,"_5":25505,"_17356":40164,"_1875":40201},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_9127":1184,"_25351":1170,"_21542":40203,"_5":25505,"_17356":40164,"_1875":40204},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_9127":1185,"_25351":1170,"_21542":40206,"_5":25505,"_17356":40164,"_1875":40207},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_9127":1186,"_25351":1170,"_21542":40209,"_5":25505,"_17356":40164,"_1875":40210},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_9127":1187,"_25351":1170,"_21542":40212,"_5":25505,"_17356":40164,"_1875":40213},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_9127":1188,"_25351":1170,"_21542":40215,"_5":25505,"_17356":40164,"_1875":40216},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_9127":1189,"_25351":1170,"_21542":40218,"_5":25505,"_17356":40164,"_1875":40219},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_9127":1190,"_25351":1170,"_21542":40221,"_5":25505,"_17356":40168,"_1875":40222},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_9127":1191,"_25351":1170,"_21542":40224,"_5":25505,"_17356":40168,"_1875":40225},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_9127":1192,"_25351":1170,"_21542":40227,"_5":25505,"_17356":40172,"_1875":40228},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_9127":1193,"_25351":1170,"_21542":40230,"_5":25505,"_17356":40172,"_1875":40231},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_9127":1194,"_25351":1170,"_21542":40233,"_5":25505,"_17356":40176,"_1875":40234},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_9127":1195,"_25351":1170,"_21542":40236,"_5":25505,"_17356":40176,"_1875":40237},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_9127":1196,"_25351":1170,"_21542":40239,"_5":25505,"_17356":40176,"_1875":40240},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_9127":1197,"_25351":1170,"_21542":40242,"_5":25505,"_17356":40176,"_1875":40243},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_9127":1198,"_25351":1170,"_21542":40245,"_5":25505,"_17356":40176,"_1875":40246},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_9127":1199,"_25351":1170,"_21542":40248,"_5":25505,"_17356":40176,"_1875":40249},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_9127":1200,"_25351":1170,"_21542":40251,"_5":25505,"_17356":40176,"_1875":40252},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_9127":1201,"_25351":1170,"_21542":40254,"_5":25505,"_17356":40176,"_1875":40255},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_9127":1202,"_25351":1170,"_21542":40257,"_5":25505,"_17356":40180,"_1875":40258},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_9127":1203,"_25351":1170,"_21542":40260,"_5":25505,"_17356":40180,"_1875":40261},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_9127":1204,"_25351":1170,"_21542":40263,"_5":25505,"_17356":40180,"_1875":40264},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_9127":1205,"_25351":1170,"_21542":40266,"_5":25505,"_17356":40180,"_1875":40267},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_9127":1206,"_25351":1170,"_21542":40269,"_5":25505,"_17356":40180,"_1875":40270},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_9127":1207,"_25351":1170,"_21542":40272,"_5":25505,"_17356":40180,"_1875":40273},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_9127":1208,"_25351":1170,"_21542":40275,"_5":25505,"_17356":40184,"_1875":40276},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_9127":1209,"_25351":1170,"_21542":40278,"_5":25505,"_17356":40184,"_1875":40279},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_9127":1210,"_25351":1170,"_21542":40281,"_5":25505,"_17356":40184,"_1875":40282},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_9127":1211,"_25351":1170,"_21542":40284,"_5":25505,"_17356":40184,"_1875":40285},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_9127":1212,"_25351":1170,"_21542":40287,"_5":25505,"_17356":40184,"_1875":40288},[],"**Unspecified**: Motivo de revocación no especificado.",{"_9127":1213,"_25351":1170,"_21542":40290,"_5":25505,"_17356":40184,"_1875":40291},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_9127":1214,"_25351":1170,"_21542":40293,"_5":25505,"_17356":40184,"_1875":40294},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_9127":1215,"_25351":1170,"_21542":40296,"_5":25505,"_17356":40184,"_1875":40297},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_9127":1216,"_25351":1170,"_21542":40299,"_5":25505,"_17356":40184,"_1875":40300},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_9127":1217,"_25351":1170,"_21542":40302,"_5":25505,"_17356":40184,"_1875":40303},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_9127":1218,"_25351":1170,"_21542":40305,"_5":25505,"_17356":40184,"_1875":40306},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_9127":1219,"_25351":1170,"_21542":40308,"_5":25505,"_17356":40184,"_1875":40309},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_9127":1220,"_25351":1170,"_21542":40311,"_5":25505,"_17356":40184,"_1875":40312},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_9127":1221,"_25351":1170,"_21542":40314,"_5":25505,"_17356":40184,"_1875":40315},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_9127":1222,"_25351":1170,"_21542":40317,"_5":25505,"_17356":40184,"_1875":40318},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_9127":1223,"_25351":1170,"_21542":40320,"_5":25505,"_17356":40184,"_1875":40321},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_9127":1224,"_25351":1170,"_21542":40323,"_5":25505,"_17356":40188,"_1875":40324},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_9127":1225,"_25351":1170,"_21542":40326,"_5":25505,"_17356":40188,"_1875":40327},[],"El proceso se realiza de la siguiente manera:",{"_9127":1226,"_25351":1170,"_21542":40329,"_5":25505,"_17356":40188,"_1875":40330},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_9127":1227,"_25351":1170,"_21542":40332,"_5":25505,"_17356":40188,"_1875":40333},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_9127":1228,"_25351":1170,"_21542":40335,"_5":25505,"_17356":40188,"_1875":40336},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_9127":1229,"_25351":1229,"_5":25500,"_1875":40338,"_25513":40339,"_21542":40340,"_17356":1229},"EST: Enrollment over Secure Transport",[36657,37756,37765],[],{"_9127":1230,"_25351":1229,"_21542":40342,"_5":25505,"_17356":1229,"_1875":40343},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_9127":1231,"_25351":1229,"_5":25510,"_21542":40345,"_17356":40346,"_1875":40338},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_9127":1232,"_25351":1229,"_5":25510,"_21542":40348,"_17356":40349,"_1875":37839},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#configuración-del-dms",{"_9127":1233,"_25351":1229,"_5":25510,"_21542":40351,"_17356":40352,"_1875":37362},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#requisitos-previos",{"_9127":1234,"_25351":1229,"_5":25510,"_21542":40354,"_17356":40355,"_1875":39280},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#configuración-de-enrollment",{"_9127":1235,"_25351":1229,"_5":25510,"_21542":40357,"_17356":40358,"_1875":40359},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_9127":1236,"_25351":1229,"_5":25510,"_21542":40361,"_17356":40362,"_1875":40363},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_9127":1237,"_25351":1229,"_5":25510,"_21542":40365,"_17356":40366,"_1875":39308},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#perfil-de-emisión",{"_9127":1238,"_25351":1229,"_5":25510,"_21542":40368,"_17356":40369,"_1875":39304},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#configuración-de-re-enrollment",{"_9127":1239,"_25351":1229,"_5":25510,"_21542":40371,"_17356":40372,"_1875":40373},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_9127":1240,"_25351":1229,"_5":25510,"_21542":40375,"_17356":40376,"_1875":39324},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#verificar-la-configuración",{"_9127":1241,"_25351":1229,"_5":25510,"_21542":40378,"_17356":40379,"_1875":39328},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#integración-de-dispositivos",{"_9127":1242,"_25351":1229,"_5":25510,"_21542":40381,"_17356":40382,"_1875":39332},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#antes-de-empezar",{"_9127":1243,"_25351":1229,"_5":25510,"_21542":40384,"_17356":40385,"_1875":40386},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_9127":1244,"_25351":1229,"_5":25510,"_21542":40388,"_17356":40389,"_1875":40390},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_9127":1245,"_25351":1229,"_5":25510,"_21542":40392,"_17356":40393,"_1875":40394},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_9127":1246,"_25351":1229,"_5":25510,"_21542":40396,"_17356":40397,"_1875":40398},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#cacerts","`/cacerts`",{"_9127":1247,"_25351":1229,"_5":25510,"_21542":40400,"_17356":40401,"_1875":40402},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_9127":1248,"_25351":1229,"_5":25510,"_21542":40404,"_17356":40405,"_1875":40406},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_9127":1249,"_25351":1229,"_5":25510,"_21542":40408,"_17356":40409,"_1875":40410},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_9127":1250,"_25351":1229,"_5":25510,"_21542":40412,"_17356":40413,"_1875":40414},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#flujos-completos","Flujos completos",{"_9127":1251,"_25351":1229,"_5":25510,"_21542":40416,"_17356":40417,"_1875":40418},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_9127":1252,"_25351":1229,"_5":25510,"_21542":40420,"_17356":40421,"_1875":40422},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_9127":1253,"_25351":1229,"_5":25510,"_21542":40424,"_17356":40425,"_1875":39356},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento",{"_9127":1254,"_25351":1229,"_5":25510,"_21542":40427,"_17356":40428,"_1875":39360},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#diagnóstico-y-compatibilidad",{"_9127":1255,"_25351":1229,"_5":25510,"_21542":40430,"_17356":40431,"_1875":39364},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#códigos-de-error-y-diagnóstico",{"_9127":1256,"_25351":1229,"_5":25510,"_21542":40433,"_17356":40434,"_1875":39368},[],"/docs/pr-preview/pr-24/manual/servicios-core/est#notas-de-compatibilidad",{"_9127":1257,"_25351":1229,"_21542":40436,"_5":25505,"_17356":40346,"_1875":40437},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como uno de sus mecanismos de inscripción de certificados para dispositivos — el otro es CMP (RFC 9483). Cada DMS expone uno de los dos protocolos, nunca ambos a la vez; el que expone EST valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_9127":1258,"_25351":1229,"_21542":40439,"_5":25505,"_17356":40346,"_1875":40440},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_9127":1259,"_25351":1229,"_21542":40442,"_5":25505,"_17356":40346,"_1875":39377},[],{"_9127":1260,"_25351":1229,"_21542":40444,"_5":25505,"_17356":40346,"_1875":39380},[],{"_9127":1261,"_25351":1229,"_21542":40446,"_5":25505,"_17356":40346,"_1875":40447},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_9127":1262,"_25351":1229,"_21542":40449,"_5":25505,"_17356":40346,"_1875":39386},[],{"_9127":1263,"_25351":1229,"_21542":40451,"_5":25505,"_17356":40346,"_1875":39389},[],{"_9127":1264,"_25351":1229,"_21542":40453,"_5":25505,"_17356":40346,"_1875":39392},[],{"_9127":1265,"_25351":1229,"_21542":40455,"_5":25505,"_17356":40346,"_1875":39395},[],{"_9127":1266,"_25351":1229,"_21542":40457,"_5":25505,"_17356":40346,"_1875":39398},[],{"_9127":1267,"_25351":1229,"_21542":40459,"_5":25505,"_17356":40346,"_1875":37839},[],{"_9127":1268,"_25351":1229,"_21542":40461,"_5":25505,"_17356":40346,"_1875":39360},[],{"_9127":1269,"_25351":1229,"_21542":40463,"_5":25505,"_17356":40346,"_1875":39405},[],{"_9127":1270,"_25351":1229,"_21542":40465,"_5":25505,"_17356":40346,"_1875":39332},[],{"_9127":1271,"_25351":1229,"_21542":40467,"_5":25505,"_17356":40346,"_1875":40468},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_9127":1272,"_25351":1229,"_21542":40470,"_5":25505,"_17356":40352,"_1875":40471},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_9127":1273,"_25351":1229,"_21542":40473,"_5":25505,"_17356":40352,"_1875":40474},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_9127":1274,"_25351":1229,"_21542":40476,"_5":25505,"_17356":40352,"_1875":40477},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_9127":1275,"_25351":1229,"_21542":40479,"_5":25505,"_17356":40352,"_1875":40480},[],"Conviene separar cuatro bloques de configuración:",{"_9127":1276,"_25351":1229,"_21542":40482,"_5":25505,"_17356":40352,"_1875":40483},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_9127":1277,"_25351":1229,"_21542":40485,"_5":25505,"_17356":40352,"_1875":40486},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_9127":1278,"_25351":1229,"_21542":40488,"_5":25505,"_17356":40352,"_1875":40489},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_9127":1279,"_25351":1229,"_21542":40491,"_5":25505,"_17356":40352,"_1875":40492},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_9127":1280,"_25351":1229,"_21542":40494,"_5":25505,"_17356":40358,"_1875":40495},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_9127":1281,"_25351":1229,"_21542":40497,"_5":25505,"_17356":40358,"_1875":40498},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_9127":1282,"_25351":1229,"_21542":40500,"_5":25505,"_17356":40358,"_1875":40501},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_9127":1283,"_25351":1229,"_21542":40503,"_5":25505,"_17356":40358,"_1875":40504},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_9127":1284,"_25351":1229,"_21542":40506,"_5":25505,"_17356":40362,"_1875":40507},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_9127":1285,"_25351":1229,"_21542":40509,"_5":25505,"_17356":40362,"_1875":40510},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_9127":1286,"_25351":1229,"_21542":40512,"_5":25505,"_17356":40362,"_1875":40513},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_9127":1287,"_25351":1229,"_21542":40515,"_5":25505,"_17356":40362,"_1875":40516},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_9127":1288,"_25351":1229,"_21542":40518,"_5":25505,"_17356":40362,"_1875":39455},[],{"_9127":1289,"_25351":1229,"_21542":40520,"_5":25505,"_17356":40362,"_1875":36860},[],{"_9127":1290,"_25351":1229,"_21542":40522,"_5":25505,"_17356":40362,"_1875":39460},[],{"_9127":1291,"_25351":1229,"_21542":40524,"_5":25505,"_17356":40362,"_1875":40525},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_9127":1292,"_25351":1229,"_21542":40527,"_5":25505,"_17356":40362,"_1875":39466},[],{"_9127":1293,"_25351":1229,"_21542":40529,"_5":25505,"_17356":40362,"_1875":40530},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_9127":1294,"_25351":1229,"_21542":40532,"_5":25505,"_17356":40362,"_1875":39472},[],{"_9127":1295,"_25351":1229,"_21542":40534,"_5":25505,"_17356":40362,"_1875":40535},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_9127":1296,"_25351":1229,"_21542":40537,"_5":25505,"_17356":40362,"_1875":39478},[],{"_9127":1297,"_25351":1229,"_21542":40539,"_5":25505,"_17356":40362,"_1875":40540},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_9127":1298,"_25351":1229,"_21542":40542,"_5":25505,"_17356":40362,"_1875":40543},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_9127":1299,"_25351":1229,"_21542":40545,"_5":25505,"_17356":40362,"_1875":40546},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_9127":1300,"_25351":1229,"_21542":40548,"_5":25505,"_17356":40362,"_1875":40549},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_9127":1301,"_25351":1229,"_21542":40551,"_5":25505,"_17356":40362,"_1875":40552},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_9127":1302,"_25351":1229,"_21542":40554,"_5":25505,"_17356":40362,"_1875":40555},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_9127":1303,"_25351":1229,"_21542":40557,"_5":25505,"_17356":40362,"_1875":40558},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_9127":1304,"_25351":1229,"_21542":40560,"_5":25505,"_17356":40362,"_1875":40561},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_9127":1305,"_25351":1229,"_21542":40563,"_5":25505,"_17356":40362,"_1875":40564},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_9127":1306,"_25351":1229,"_21542":40566,"_5":25505,"_17356":40362,"_1875":40567},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_9127":1307,"_25351":1229,"_21542":40569,"_5":25505,"_17356":40362,"_1875":40570},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_9127":1308,"_25351":1229,"_21542":40572,"_5":25505,"_17356":40366,"_1875":40573},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_9127":1309,"_25351":1229,"_21542":40575,"_5":25505,"_17356":40366,"_1875":39493},[],{"_9127":1310,"_25351":1229,"_21542":40577,"_5":25505,"_17356":40366,"_1875":37991},[],{"_9127":1311,"_25351":1229,"_21542":40579,"_5":25505,"_17356":40366,"_1875":40580},[],"Efecto sobre el certificado emitido",{"_9127":1312,"_25351":1229,"_21542":40582,"_5":25505,"_17356":40366,"_1875":40583},[],"`HonorSubject`",{"_9127":1313,"_25351":1229,"_21542":40585,"_5":25505,"_17356":40366,"_1875":23460},[],{"_9127":1314,"_25351":1229,"_21542":40587,"_5":25505,"_17356":40366,"_1875":40588},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_9127":1315,"_25351":1229,"_21542":40590,"_5":25505,"_17356":40366,"_1875":40591},[],"`HonorKeyUsage`",{"_9127":1316,"_25351":1229,"_21542":40593,"_5":25505,"_17356":40366,"_1875":23460},[],{"_9127":1317,"_25351":1229,"_21542":40595,"_5":25505,"_17356":40366,"_1875":40596},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_9127":1318,"_25351":1229,"_21542":40598,"_5":25505,"_17356":40366,"_1875":40599},[],"`HonorExtendedKeyUsages`",{"_9127":1319,"_25351":1229,"_21542":40601,"_5":25505,"_17356":40366,"_1875":23460},[],{"_9127":1320,"_25351":1229,"_21542":40603,"_5":25505,"_17356":40366,"_1875":40604},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_9127":1321,"_25351":1229,"_21542":40606,"_5":25505,"_17356":40366,"_1875":40607},[],"`HonorExtensions`",{"_9127":1322,"_25351":1229,"_21542":40609,"_5":25505,"_17356":40366,"_1875":23460},[],{"_9127":1323,"_25351":1229,"_21542":40611,"_5":25505,"_17356":40366,"_1875":40612},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_9127":1324,"_25351":1229,"_21542":40614,"_5":25505,"_17356":40366,"_1875":40615},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_9127":1325,"_25351":1229,"_21542":40617,"_5":25505,"_17356":40369,"_1875":40618},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_9127":1326,"_25351":1229,"_21542":40620,"_5":25505,"_17356":40369,"_1875":40621},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_9127":1327,"_25351":1229,"_21542":40623,"_5":25505,"_17356":40369,"_1875":40624},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_9127":1328,"_25351":1229,"_21542":40626,"_5":25505,"_17356":40369,"_1875":40627},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_9127":1329,"_25351":1229,"_21542":40629,"_5":25505,"_17356":40369,"_1875":40630},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_9127":1330,"_25351":1229,"_21542":40632,"_5":25505,"_17356":40369,"_1875":40633},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_9127":1331,"_25351":1229,"_21542":40635,"_5":25505,"_17356":40369,"_1875":40636},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_9127":1332,"_25351":1229,"_21542":40638,"_5":25505,"_17356":40372,"_1875":40639},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_9127":1333,"_25351":1229,"_21542":40641,"_5":25505,"_17356":40372,"_1875":40642},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_9127":1334,"_25351":1229,"_21542":40644,"_5":25505,"_17356":40372,"_1875":40645},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_9127":1335,"_25351":1229,"_21542":40647,"_5":25505,"_17356":40372,"_1875":40648},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_9127":1336,"_25351":1229,"_21542":40650,"_5":25505,"_17356":40376,"_1875":40651},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_9127":1337,"_25351":1229,"_21542":40653,"_5":25505,"_17356":40376,"_1875":40654},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_9127":1338,"_25351":1229,"_21542":40656,"_5":25505,"_17356":40376,"_1875":40657},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_9127":1339,"_25351":1229,"_21542":40659,"_5":25505,"_17356":40376,"_1875":40660},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_9127":1340,"_25351":1229,"_21542":40662,"_5":25505,"_17356":40379,"_1875":39895},[],{"_9127":1341,"_25351":1229,"_21542":40664,"_5":25505,"_17356":40379,"_1875":40665},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_9127":1342,"_25351":1229,"_21542":40667,"_5":25505,"_17356":40379,"_1875":40668},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_9127":1343,"_25351":1229,"_21542":40670,"_5":25505,"_17356":40382,"_1875":40671},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_9127":1344,"_25351":1229,"_21542":40673,"_5":25505,"_17356":40382,"_1875":39901},[],{"_9127":1345,"_25351":1229,"_21542":40675,"_5":25505,"_17356":40382,"_1875":39904},[],{"_9127":1346,"_25351":1229,"_21542":40677,"_5":25505,"_17356":40382,"_1875":36860},[],{"_9127":1347,"_25351":1229,"_21542":40679,"_5":25505,"_17356":40382,"_1875":40680},[],"**URL del host EST**",{"_9127":1348,"_25351":1229,"_21542":40682,"_5":25505,"_17356":40382,"_1875":40683},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_9127":1349,"_25351":1229,"_21542":40685,"_5":25505,"_17356":40382,"_1875":40686},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_9127":1350,"_25351":1229,"_21542":40688,"_5":25505,"_17356":40382,"_1875":40689},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_9127":1351,"_25351":1229,"_21542":40691,"_5":25505,"_17356":40382,"_1875":40692},[],"**Certificado bootstrap + clave privada**",{"_9127":1352,"_25351":1229,"_21542":40694,"_5":25505,"_17356":40382,"_1875":40695},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_9127":1353,"_25351":1229,"_21542":40697,"_5":25505,"_17356":40382,"_1875":40698},[],"**ID del DMS** (`{aps}`)",{"_9127":1354,"_25351":1229,"_21542":40700,"_5":25505,"_17356":40382,"_1875":40701},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_9127":1355,"_25351":1229,"_21542":40703,"_5":25505,"_17356":40385,"_1875":40704},[],"Caso",{"_9127":1356,"_25351":1229,"_21542":40706,"_5":25505,"_17356":40385,"_1875":40707},[],"Credencial habitual",{"_9127":1357,"_25351":1229,"_21542":40709,"_5":25505,"_17356":40385,"_1875":40710},[],"Endpoint principal",{"_9127":1358,"_25351":1229,"_21542":40712,"_5":25505,"_17356":40385,"_1875":40713},[],"Resultado",{"_9127":1359,"_25351":1229,"_21542":40715,"_5":25505,"_17356":40385,"_1875":40716},[],"Alta inicial",{"_9127":1360,"_25351":1229,"_21542":40718,"_5":25505,"_17356":40385,"_1875":40719},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_9127":1361,"_25351":1229,"_21542":40721,"_5":25505,"_17356":40385,"_1875":40402},[],{"_9127":1362,"_25351":1229,"_21542":40723,"_5":25505,"_17356":40385,"_1875":40724},[],"Certificado de dispositivo",{"_9127":1363,"_25351":1229,"_21542":40726,"_5":25505,"_17356":40385,"_1875":40727},[],"Renovación",{"_9127":1364,"_25351":1229,"_21542":40729,"_5":25505,"_17356":40385,"_1875":40730},[],"Certificado actual del dispositivo",{"_9127":1365,"_25351":1229,"_21542":40732,"_5":25505,"_17356":40385,"_1875":40406},[],{"_9127":1366,"_25351":1229,"_21542":40734,"_5":25505,"_17356":40385,"_1875":40735},[],"Certificado renovado",{"_9127":1367,"_25351":1229,"_21542":40737,"_5":25505,"_17356":40385,"_1875":40738},[],"Descarga de confianza",{"_9127":1368,"_25351":1229,"_21542":40740,"_5":25505,"_17356":40385,"_1875":40741},[],"TLS del servidor",{"_9127":1369,"_25351":1229,"_21542":40743,"_5":25505,"_17356":40385,"_1875":40398},[],{"_9127":1370,"_25351":1229,"_21542":40745,"_5":25505,"_17356":40385,"_1875":40746},[],"PKCS#7 o PEM con certificados",{"_9127":1371,"_25351":1229,"_21542":40748,"_5":25505,"_17356":40385,"_1875":40749},[],"Clave generada en servidor",{"_9127":1372,"_25351":1229,"_21542":40751,"_5":25505,"_17356":40385,"_1875":40752},[],"Igual que `/simpleenroll`",{"_9127":1373,"_25351":1229,"_21542":40754,"_5":25505,"_17356":40385,"_1875":40410},[],{"_9127":1374,"_25351":1229,"_21542":40756,"_5":25505,"_17356":40385,"_1875":40757},[],"Clave privada PKCS#8 + certificado",{"_9127":1375,"_25351":1229,"_21542":40759,"_5":25505,"_17356":40389,"_1875":40760},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_9127":1376,"_25351":1229,"_21542":40762,"_5":25505,"_17356":40389,"_1875":40763},[],"Modo (`AuthMode`)",{"_9127":1377,"_25351":1229,"_21542":40765,"_5":25505,"_17356":40389,"_1875":36860},[],{"_9127":1378,"_25351":1229,"_21542":40767,"_5":25505,"_17356":40389,"_1875":40768},[],"Credencial esperada",{"_9127":1379,"_25351":1229,"_21542":40770,"_5":25505,"_17356":40389,"_1875":40771},[],"Aplica en enroll",{"_9127":1380,"_25351":1229,"_21542":40773,"_5":25505,"_17356":40389,"_1875":40774},[],"Aplica en reenroll",{"_9127":1381,"_25351":1229,"_21542":40776,"_5":25505,"_17356":40389,"_1875":39460},[],{"_9127":1382,"_25351":1229,"_21542":40778,"_5":25505,"_17356":40389,"_1875":40779},[],"mTLS con certificado X.509",{"_9127":1383,"_25351":1229,"_21542":40781,"_5":25505,"_17356":40389,"_1875":40782},[],"Certificado y clave privada cliente",{"_9127":1384,"_25351":1229,"_21542":40784,"_5":25505,"_17356":40389,"_1875":38004},[],{"_9127":1385,"_25351":1229,"_21542":40786,"_5":25505,"_17356":40389,"_1875":40787},[],"Sí (con el certificado en vigor)",{"_9127":1386,"_25351":1229,"_21542":40789,"_5":25505,"_17356":40389,"_1875":39472},[],{"_9127":1387,"_25351":1229,"_21542":40791,"_5":25505,"_17356":40389,"_1875":40792},[],"mTLS más validación por webhook",{"_9127":1388,"_25351":1229,"_21542":40794,"_5":25505,"_17356":40389,"_1875":40795},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_9127":1389,"_25351":1229,"_21542":40797,"_5":25505,"_17356":40389,"_1875":38004},[],{"_9127":1390,"_25351":1229,"_21542":40799,"_5":25505,"_17356":40389,"_1875":40800},[],"No como combinación; en reenroll no mantiene ambos controles",{"_9127":1391,"_25351":1229,"_21542":40802,"_5":25505,"_17356":40389,"_1875":39466},[],{"_9127":1392,"_25351":1229,"_21542":40804,"_5":25505,"_17356":40389,"_1875":40805},[],"Webhook externo de autorización",{"_9127":1393,"_25351":1229,"_21542":40807,"_5":25505,"_17356":40389,"_1875":40808},[],"Ninguna en el canal TLS",{"_9127":1394,"_25351":1229,"_21542":40810,"_5":25505,"_17356":40389,"_1875":38004},[],{"_9127":1395,"_25351":1229,"_21542":40812,"_5":25505,"_17356":40389,"_1875":40813},[],"No, degrada a `NO_AUTH`",{"_9127":1396,"_25351":1229,"_21542":40815,"_5":25505,"_17356":40389,"_1875":39478},[],{"_9127":1397,"_25351":1229,"_21542":40817,"_5":25505,"_17356":40389,"_1875":40818},[],"Sin autenticación",{"_9127":1398,"_25351":1229,"_21542":40820,"_5":25505,"_17356":40389,"_1875":40821},[],"Ninguna",{"_9127":1399,"_25351":1229,"_21542":40823,"_5":25505,"_17356":40389,"_1875":40824},[],"Sí (uso restringido)",{"_9127":1400,"_25351":1229,"_21542":40826,"_5":25505,"_17356":40389,"_1875":40824},[],{"_9127":1401,"_25351":1229,"_21542":40828,"_5":25505,"_17356":40389,"_1875":40829},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_9127":1402,"_25351":1229,"_21542":40831,"_5":25505,"_17356":40389,"_1875":40832},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_9127":1403,"_25351":1229,"_21542":40834,"_5":25505,"_17356":40389,"_1875":37988},[],{"_9127":1404,"_25351":1229,"_21542":40836,"_5":25505,"_17356":40389,"_1875":37991},[],{"_9127":1405,"_25351":1229,"_21542":40838,"_5":25505,"_17356":40389,"_1875":36860},[],{"_9127":1406,"_25351":1229,"_21542":40840,"_5":25505,"_17356":40389,"_1875":40841},[],"`ValidationCAs`",{"_9127":1407,"_25351":1229,"_21542":40843,"_5":25505,"_17356":40389,"_1875":39566},[],{"_9127":1408,"_25351":1229,"_21542":40845,"_5":25505,"_17356":40389,"_1875":40846},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_9127":1409,"_25351":1229,"_21542":40848,"_5":25505,"_17356":40389,"_1875":40849},[],"`AllowExpired`",{"_9127":1410,"_25351":1229,"_21542":40851,"_5":25505,"_17356":40389,"_1875":23460},[],{"_9127":1411,"_25351":1229,"_21542":40853,"_5":25505,"_17356":40389,"_1875":40854},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_9127":1412,"_25351":1229,"_21542":40856,"_5":25505,"_17356":40389,"_1875":40857},[],"`ChainLevelValidation`",{"_9127":1413,"_25351":1229,"_21542":40859,"_5":25505,"_17356":40389,"_1875":5062},[],{"_9127":1414,"_25351":1229,"_21542":40861,"_5":25505,"_17356":40389,"_1875":40862},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_9127":1415,"_25351":1229,"_21542":40864,"_5":25505,"_17356":40389,"_1875":40865},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_9127":1416,"_25351":1229,"_21542":40867,"_5":25505,"_17356":40389,"_1875":40868},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_9127":1417,"_25351":1229,"_21542":40870,"_5":25505,"_17356":40389,"_1875":40871},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_9127":1418,"_25351":1229,"_21542":40873,"_5":25505,"_17356":40389,"_1875":40874},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_9127":1419,"_25351":1229,"_21542":40876,"_5":25505,"_17356":40393,"_1875":40877},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_9127":1420,"_25351":1229,"_21542":40879,"_5":25505,"_17356":40393,"_1875":40880},[],"`/cacerts`: descarga de la cadena de confianza.",{"_9127":1421,"_25351":1229,"_21542":40882,"_5":25505,"_17356":40393,"_1875":40883},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_9127":1422,"_25351":1229,"_21542":40885,"_5":25505,"_17356":40393,"_1875":40886},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_9127":1423,"_25351":1229,"_21542":40888,"_5":25505,"_17356":40393,"_1875":40889},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_9127":1424,"_25351":1229,"_21542":40891,"_5":25505,"_17356":40397,"_1875":40892},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_9127":1425,"_25351":1229,"_21542":40894,"_5":25505,"_17356":40397,"_1875":40895},[],"Campo de `CADistributionSettings`",{"_9127":1426,"_25351":1229,"_21542":40897,"_5":25505,"_17356":40397,"_1875":37991},[],{"_9127":1427,"_25351":1229,"_21542":40899,"_5":25505,"_17356":40397,"_1875":36860},[],{"_9127":1428,"_25351":1229,"_21542":40901,"_5":25505,"_17356":40397,"_1875":40902},[],"`IncludeLamassuSystemCA`",{"_9127":1429,"_25351":1229,"_21542":40904,"_5":25505,"_17356":40397,"_1875":23460},[],{"_9127":1430,"_25351":1229,"_21542":40906,"_5":25505,"_17356":40397,"_1875":40907},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_9127":1431,"_25351":1229,"_21542":40909,"_5":25505,"_17356":40397,"_1875":40910},[],"`IncludeEnrollmentCA`",{"_9127":1432,"_25351":1229,"_21542":40912,"_5":25505,"_17356":40397,"_1875":23460},[],{"_9127":1433,"_25351":1229,"_21542":40914,"_5":25505,"_17356":40397,"_1875":40915},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_9127":1434,"_25351":1229,"_21542":40917,"_5":25505,"_17356":40397,"_1875":40918},[],"`ManagedCAs`",{"_9127":1435,"_25351":1229,"_21542":40920,"_5":25505,"_17356":40397,"_1875":39566},[],{"_9127":1436,"_25351":1229,"_21542":40922,"_5":25505,"_17356":40397,"_1875":40923},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_9127":1437,"_25351":1229,"_21542":40925,"_5":25505,"_17356":40397,"_1875":40926},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_9127":1438,"_25351":1229,"_21542":40928,"_5":25505,"_17356":40397,"_1875":40929},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_9127":1439,"_25351":1229,"_21542":40931,"_5":25505,"_17356":40397,"_1875":40932},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_9127":1440,"_25351":1229,"_21542":40934,"_5":25505,"_17356":40397,"_1875":40935},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_9127":1441,"_25351":1229,"_21542":40937,"_5":25505,"_17356":40401,"_1875":40938},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_9127":1442,"_25351":1229,"_21542":40940,"_5":25505,"_17356":40401,"_1875":40941},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_9127":1443,"_25351":1229,"_21542":40943,"_5":25505,"_17356":40401,"_1875":40944},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_9127":1444,"_25351":1229,"_21542":40946,"_5":25505,"_17356":40401,"_1875":39493},[],{"_9127":1445,"_25351":1229,"_21542":40948,"_5":25505,"_17356":40401,"_1875":37991},[],{"_9127":1446,"_25351":1229,"_21542":40950,"_5":25505,"_17356":40401,"_1875":39768},[],{"_9127":1447,"_25351":1229,"_21542":40952,"_5":25505,"_17356":40401,"_1875":40953},[],"`EnrollmentSettings.RegistrationMode`",{"_9127":1448,"_25351":1229,"_21542":40955,"_5":25505,"_17356":40401,"_1875":40956},[],"`JITP` / `PRE_REGISTRATION`",{"_9127":1449,"_25351":1229,"_21542":40958,"_5":25505,"_17356":40401,"_1875":40959},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_9127":1450,"_25351":1229,"_21542":40961,"_5":25505,"_17356":40401,"_1875":40962},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_9127":1451,"_25351":1229,"_21542":40964,"_5":25505,"_17356":40401,"_1875":23460},[],{"_9127":1452,"_25351":1229,"_21542":40966,"_5":25505,"_17356":40401,"_1875":40967},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_9127":1453,"_25351":1229,"_21542":40969,"_5":25505,"_17356":40401,"_1875":40970},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_9127":1454,"_25351":1229,"_21542":40972,"_5":25505,"_17356":40401,"_1875":23460},[],{"_9127":1455,"_25351":1229,"_21542":40974,"_5":25505,"_17356":40401,"_1875":40975},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_9127":1456,"_25351":1229,"_21542":40977,"_5":25505,"_17356":40401,"_1875":40978},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_9127":1457,"_25351":1229,"_21542":40980,"_5":25505,"_17356":40405,"_1875":40981},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_9127":1458,"_25351":1229,"_21542":40983,"_5":25505,"_17356":40405,"_1875":40984},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_9127":1459,"_25351":1229,"_21542":40986,"_5":25505,"_17356":40405,"_1875":40987},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_9127":1460,"_25351":1229,"_21542":40989,"_5":25505,"_17356":40405,"_1875":39493},[],{"_9127":1461,"_25351":1229,"_21542":40991,"_5":25505,"_17356":40405,"_1875":37991},[],{"_9127":1462,"_25351":1229,"_21542":40993,"_5":25505,"_17356":40405,"_1875":39768},[],{"_9127":1463,"_25351":1229,"_21542":40995,"_5":25505,"_17356":40405,"_1875":40996},[],"`ReEnrollmentDelta`",{"_9127":1464,"_25351":1229,"_21542":40998,"_5":25505,"_17356":40405,"_1875":39511},[],{"_9127":1465,"_25351":1229,"_21542":41000,"_5":25505,"_17356":40405,"_1875":41001},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_9127":1466,"_25351":1229,"_21542":41003,"_5":25505,"_17356":40405,"_1875":41004},[],"`EnableExpiredRenewal`",{"_9127":1467,"_25351":1229,"_21542":41006,"_5":25505,"_17356":40405,"_1875":23460},[],{"_9127":1468,"_25351":1229,"_21542":41008,"_5":25505,"_17356":40405,"_1875":41009},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_9127":1469,"_25351":1229,"_21542":41011,"_5":25505,"_17356":40405,"_1875":41012},[],"`RevokeOnReEnrollment`",{"_9127":1470,"_25351":1229,"_21542":41014,"_5":25505,"_17356":40405,"_1875":23460},[],{"_9127":1471,"_25351":1229,"_21542":41016,"_5":25505,"_17356":40405,"_1875":41017},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_9127":1472,"_25351":1229,"_21542":41019,"_5":25505,"_17356":40405,"_1875":41020},[],"`AdditionalValidationCAs`",{"_9127":1473,"_25351":1229,"_21542":41022,"_5":25505,"_17356":40405,"_1875":39566},[],{"_9127":1474,"_25351":1229,"_21542":41024,"_5":25505,"_17356":40405,"_1875":41025},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_9127":1475,"_25351":1229,"_21542":41027,"_5":25505,"_17356":40405,"_1875":41028},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_9127":1476,"_25351":1229,"_21542":41030,"_5":25505,"_17356":40405,"_1875":41031},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_9127":1477,"_25351":1229,"_21542":41033,"_5":25505,"_17356":40409,"_1875":41034},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_9127":1478,"_25351":1229,"_21542":41036,"_5":25505,"_17356":40409,"_1875":41037},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_9127":1479,"_25351":1229,"_21542":41039,"_5":25505,"_17356":40409,"_1875":41040},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_9127":1480,"_25351":1229,"_21542":41042,"_5":25505,"_17356":40409,"_1875":41043},[],"Tipo de clave",{"_9127":1481,"_25351":1229,"_21542":41045,"_5":25505,"_17356":40409,"_1875":41046},[],"Parámetro válido",{"_9127":1482,"_25351":1229,"_21542":41048,"_5":25505,"_17356":40409,"_1875":41049},[],"Curva NIST equivalente",{"_9127":1483,"_25351":1229,"_21542":41051,"_5":25505,"_17356":40409,"_1875":41052},[],"Comportamiento ante valores no válidos",{"_9127":1484,"_25351":1229,"_21542":41054,"_5":25505,"_17356":40409,"_1875":41055},[],"`RSA`",{"_9127":1485,"_25351":1229,"_21542":41057,"_5":25505,"_17356":40409,"_1875":41058},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_9127":1486,"_25351":1229,"_21542":41060,"_5":25505,"_17356":40409,"_1875":41061},[],"No aplica",{"_9127":1487,"_25351":1229,"_21542":41063,"_5":25505,"_17356":40409,"_1875":41064},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_9127":1488,"_25351":1229,"_21542":41066,"_5":25505,"_17356":40409,"_1875":41067},[],"`ECDSA`",{"_9127":1489,"_25351":1229,"_21542":41069,"_5":25505,"_17356":40409,"_1875":41070},[],"224, 256, 384, 521",{"_9127":1490,"_25351":1229,"_21542":41072,"_5":25505,"_17356":40409,"_1875":41073},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_9127":1491,"_25351":1229,"_21542":41075,"_5":25505,"_17356":40409,"_1875":41076},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_9127":1492,"_25351":1229,"_21542":41078,"_5":25505,"_17356":40409,"_1875":41079},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_9127":1493,"_25351":1229,"_21542":41081,"_5":25505,"_17356":40409,"_1875":41082},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_9127":1494,"_25351":1229,"_21542":41084,"_5":25505,"_17356":40409,"_1875":41085},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_9127":1495,"_25351":1229,"_21542":41087,"_5":25505,"_17356":40409,"_1875":41088},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_9127":1496,"_25351":1229,"_21542":41090,"_5":25505,"_17356":40409,"_1875":41091},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_9127":1497,"_25351":1229,"_21542":41093,"_5":25505,"_17356":40409,"_1875":41094},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_9127":1498,"_25351":1229,"_21542":41096,"_5":25505,"_17356":40409,"_1875":41097},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_9127":1499,"_25351":1229,"_21542":41099,"_5":25505,"_17356":40413,"_1875":41100},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_9127":1500,"_25351":1229,"_21542":41102,"_5":25505,"_17356":40417,"_1875":41103},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_9127":1501,"_25351":1229,"_21542":41105,"_5":25505,"_17356":40421,"_1875":41106},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_9127":1502,"_25351":1229,"_21542":41108,"_5":25505,"_17356":40425,"_1875":41109},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_9127":1503,"_25351":1229,"_21542":41111,"_5":25505,"_17356":40425,"_1875":41112},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_9127":1504,"_25351":1229,"_21542":41114,"_5":25505,"_17356":40425,"_1875":41115},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_9127":1505,"_25351":1229,"_21542":41117,"_5":25505,"_17356":40425,"_1875":41118},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_9127":1506,"_25351":1229,"_21542":41120,"_5":25505,"_17356":40431,"_1875":41121},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_9127":1507,"_25351":1229,"_21542":41123,"_5":25505,"_17356":40431,"_1875":40083},[],{"_9127":1508,"_25351":1229,"_21542":41125,"_5":25505,"_17356":40431,"_1875":41126},[],"Mensaje",{"_9127":1509,"_25351":1229,"_21542":41128,"_5":25505,"_17356":40431,"_1875":40086},[],{"_9127":1510,"_25351":1229,"_21542":41130,"_5":25505,"_17356":40431,"_1875":40089},[],{"_9127":1511,"_25351":1229,"_21542":41132,"_5":25505,"_17356":40431,"_1875":22430},[],{"_9127":1512,"_25351":1229,"_21542":41134,"_5":25505,"_17356":40431,"_1875":41135},[],"`Field validation for 'APS' failed`",{"_9127":1513,"_25351":1229,"_21542":41137,"_5":25505,"_17356":40431,"_1875":41138},[],"El segmento `{aps}` falta en la URL.",{"_9127":1514,"_25351":1229,"_21542":41140,"_5":25505,"_17356":40431,"_1875":41141},[],"Incluir el ID del DMS en la ruta.",{"_9127":1515,"_25351":1229,"_21542":41143,"_5":25505,"_17356":40431,"_1875":22430},[],{"_9127":1516,"_25351":1229,"_21542":41145,"_5":25505,"_17356":40431,"_1875":41146},[],"`content-type must be application/pkcs10`",{"_9127":1517,"_25351":1229,"_21542":41148,"_5":25505,"_17356":40431,"_1875":41149},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_9127":1518,"_25351":1229,"_21542":41151,"_5":25505,"_17356":40431,"_1875":41152},[],"Fijar `Content-Type: application/pkcs10`.",{"_9127":1519,"_25351":1229,"_21542":41154,"_5":25505,"_17356":40431,"_1875":22430},[],{"_9127":1520,"_25351":1229,"_21542":41156,"_5":25505,"_17356":40431,"_1875":41157},[],"`body payload must be base64 encoded`",{"_9127":1521,"_25351":1229,"_21542":41159,"_5":25505,"_17356":40431,"_1875":41160},[],"El cuerpo no es base64 válido.",{"_9127":1522,"_25351":1229,"_21542":41162,"_5":25505,"_17356":40431,"_1875":41163},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_9127":1523,"_25351":1229,"_21542":41165,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1524,"_25351":1229,"_21542":41167,"_5":25505,"_17356":40431,"_1875":41168},[],"`DMS not found`",{"_9127":1525,"_25351":1229,"_21542":41170,"_5":25505,"_17356":40431,"_1875":41171},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_9127":1526,"_25351":1229,"_21542":41173,"_5":25505,"_17356":40431,"_1875":41174},[],"Verificar el identificador con el administrador PKI.",{"_9127":1527,"_25351":1229,"_21542":41176,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1528,"_25351":1229,"_21542":41178,"_5":25505,"_17356":40431,"_1875":41179},[],"`invalid certificate`",{"_9127":1529,"_25351":1229,"_21542":41181,"_5":25505,"_17356":40431,"_1875":41182},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_9127":1530,"_25351":1229,"_21542":41184,"_5":25505,"_17356":40431,"_1875":41185},[],"Comprobar la cadena del certificado bootstrap.",{"_9127":1531,"_25351":1229,"_21542":41187,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1532,"_25351":1229,"_21542":41189,"_5":25505,"_17356":40431,"_1875":41190},[],"`certificate is revoked`",{"_9127":1533,"_25351":1229,"_21542":41192,"_5":25505,"_17356":40431,"_1875":41193},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_9127":1534,"_25351":1229,"_21542":41195,"_5":25505,"_17356":40431,"_1875":41196},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_9127":1535,"_25351":1229,"_21542":41198,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1536,"_25351":1229,"_21542":41200,"_5":25505,"_17356":40431,"_1875":41201},[],"`revoked certificate`",{"_9127":1537,"_25351":1229,"_21542":41203,"_5":25505,"_17356":40431,"_1875":41204},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_9127":1538,"_25351":1229,"_21542":41206,"_5":25505,"_17356":40431,"_1875":41207},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_9127":1539,"_25351":1229,"_21542":41209,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1540,"_25351":1229,"_21542":41211,"_5":25505,"_17356":40431,"_1875":41212},[],"`expired certificate`",{"_9127":1541,"_25351":1229,"_21542":41214,"_5":25505,"_17356":40431,"_1875":41215},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_9127":1542,"_25351":1229,"_21542":41217,"_5":25505,"_17356":40431,"_1875":41218},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_9127":1543,"_25351":1229,"_21542":41220,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1544,"_25351":1229,"_21542":41222,"_5":25505,"_17356":40431,"_1875":41223},[],"`forbiddenNewEnrollment`",{"_9127":1545,"_25351":1229,"_21542":41225,"_5":25505,"_17356":40431,"_1875":41226},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_9127":1546,"_25351":1229,"_21542":41228,"_5":25505,"_17356":40431,"_1875":41229},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_9127":1547,"_25351":1229,"_21542":41231,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1548,"_25351":1229,"_21542":41233,"_5":25505,"_17356":40431,"_1875":41234},[],"`device not preregistered`",{"_9127":1549,"_25351":1229,"_21542":41236,"_5":25505,"_17356":40431,"_1875":41237},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_9127":1550,"_25351":1229,"_21542":41239,"_5":25505,"_17356":40431,"_1875":41240},[],"Registrar el dispositivo antes de inscribirlo.",{"_9127":1551,"_25351":1229,"_21542":41242,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1552,"_25351":1229,"_21542":41244,"_5":25505,"_17356":40431,"_1875":41245},[],"`invalid reenroll window`",{"_9127":1553,"_25351":1229,"_21542":41247,"_5":25505,"_17356":40431,"_1875":41248},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_9127":1554,"_25351":1229,"_21542":41250,"_5":25505,"_17356":40431,"_1875":41251},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_9127":1555,"_25351":1229,"_21542":41253,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1556,"_25351":1229,"_21542":41255,"_5":25505,"_17356":40431,"_1875":41256},[],"`invalid RawSubject bytes`",{"_9127":1557,"_25351":1229,"_21542":41258,"_5":25505,"_17356":40431,"_1875":41259},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_9127":1558,"_25351":1229,"_21542":41261,"_5":25505,"_17356":40431,"_1875":41262},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_9127":1559,"_25351":1229,"_21542":41264,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1560,"_25351":1229,"_21542":41266,"_5":25505,"_17356":40431,"_1875":41267},[],"`external webhook denied enrollment`",{"_9127":1561,"_25351":1229,"_21542":41269,"_5":25505,"_17356":40431,"_1875":41270},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_9127":1562,"_25351":1229,"_21542":41272,"_5":25505,"_17356":40431,"_1875":41273},[],"Revisar los logs del servicio webhook.",{"_9127":1563,"_25351":1229,"_21542":41275,"_5":25505,"_17356":40431,"_1875":23030},[],{"_9127":1564,"_25351":1229,"_21542":41277,"_5":25505,"_17356":40431,"_1875":41278},[],"`server key generation not enabled`",{"_9127":1565,"_25351":1229,"_21542":41280,"_5":25505,"_17356":40431,"_1875":41281},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_9127":1566,"_25351":1229,"_21542":41283,"_5":25505,"_17356":40431,"_1875":41284},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_9127":1567,"_25351":1229,"_21542":41286,"_5":25505,"_17356":40431,"_1875":41287},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_9127":1568,"_25351":1229,"_21542":41289,"_5":25505,"_17356":40434,"_1875":41290},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_9127":1569,"_25351":1229,"_21542":41292,"_5":25505,"_17356":40434,"_1875":41293},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_9127":1570,"_25351":1229,"_21542":41295,"_5":25505,"_17356":40434,"_1875":41296},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_9127":1571,"_25351":1229,"_21542":41298,"_5":25505,"_17356":40434,"_1875":41299},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_9127":1572,"_25351":1229,"_21542":41301,"_5":25505,"_17356":40434,"_1875":41302},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_9127":1573,"_25351":1229,"_21542":41304,"_5":25505,"_17356":40434,"_1875":41305},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_9127":1574,"_25351":1229,"_21542":41307,"_5":25505,"_17356":40434,"_1875":41308},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_9127":1575,"_25351":1229,"_21542":41310,"_5":25505,"_17356":40434,"_1875":40144},[],{"_9127":1576,"_25351":1229,"_21542":41312,"_5":25505,"_17356":40434,"_1875":41313},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_9127":1577,"_25351":1229,"_21542":41315,"_5":25505,"_17356":40434,"_1875":40150},[],{"_9127":1578,"_25351":1578,"_5":25500,"_1875":41317,"_25513":41318,"_21542":41319,"_17356":1578},"[KMS] Gestión de Claves Criptográficas",[36657,37756,37765],[],{"_9127":1579,"_25351":1578,"_21542":41321,"_5":25505,"_17356":1578,"_1875":41322},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_9127":1580,"_25351":1578,"_5":25510,"_21542":41324,"_17356":41325,"_1875":41326},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_9127":1581,"_25351":1578,"_5":25510,"_21542":41328,"_17356":41329,"_1875":41330},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_9127":1582,"_25351":1578,"_5":25510,"_21542":41332,"_17356":41333,"_1875":41334},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_9127":1583,"_25351":1578,"_5":25510,"_21542":41336,"_17356":41337,"_1875":41338},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_9127":1584,"_25351":1578,"_5":25510,"_21542":41340,"_17356":41341,"_1875":41342},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_9127":1585,"_25351":1578,"_5":25510,"_21542":41344,"_17356":41345,"_1875":41346},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_9127":1586,"_25351":1578,"_5":25510,"_21542":41348,"_17356":41349,"_1875":41350},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_9127":1587,"_25351":1578,"_5":25510,"_21542":41352,"_17356":41353,"_1875":41354},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_9127":1588,"_25351":1578,"_5":25510,"_21542":41356,"_17356":41357,"_1875":41358},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_9127":1589,"_25351":1578,"_5":25510,"_21542":41360,"_17356":41361,"_1875":41362},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_9127":1590,"_25351":1578,"_5":25510,"_21542":41364,"_17356":41365,"_1875":41366},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#sign","Sign",{"_9127":1591,"_25351":1578,"_5":25510,"_21542":41368,"_17356":41369,"_1875":41370},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#verify","Verify",{"_9127":1592,"_25351":1578,"_5":25510,"_21542":41372,"_17356":41373,"_1875":41374},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_9127":1593,"_25351":1578,"_5":25510,"_21542":41376,"_17356":41377,"_1875":41378},[],"/docs/pr-preview/pr-24/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_9127":1594,"_25351":1578,"_21542":41380,"_5":25505,"_17356":41325,"_1875":41381},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_9127":1595,"_25351":1578,"_21542":41383,"_5":25505,"_17356":41325,"_1875":41384},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_9127":1596,"_25351":1578,"_21542":41386,"_5":25505,"_17356":41329,"_1875":41387},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_9127":1597,"_25351":1578,"_21542":41389,"_5":25505,"_17356":41329,"_1875":41390},[],"En la práctica, permite:",{"_9127":1598,"_25351":1578,"_21542":41392,"_5":25505,"_17356":41329,"_1875":41393},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_9127":1599,"_25351":1578,"_21542":41395,"_5":25505,"_17356":41329,"_1875":41396},[],"Importar claves creadas externamente.",{"_9127":1600,"_25351":1578,"_21542":41398,"_5":25505,"_17356":41329,"_1875":41399},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_9127":1601,"_25351":1578,"_21542":41401,"_5":25505,"_17356":41329,"_1875":41402},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_9127":1602,"_25351":1578,"_21542":41404,"_5":25505,"_17356":41333,"_1875":41405},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_9127":1603,"_25351":1578,"_21542":41407,"_5":25505,"_17356":41333,"_1875":41408},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_9127":1604,"_25351":1578,"_21542":41410,"_5":25505,"_17356":41333,"_1875":41411},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_9127":1605,"_25351":1578,"_21542":41413,"_5":25505,"_17356":41333,"_1875":41414},[],"Crypto Engine",{"_9127":1606,"_25351":1578,"_21542":41416,"_5":25505,"_17356":41333,"_1875":41417},[],"Nivel de seguridad",{"_9127":1607,"_25351":1578,"_21542":41419,"_5":25505,"_17356":41333,"_1875":41420},[],"OnPrem / Cloud",{"_9127":1608,"_25351":1578,"_21542":41422,"_5":25505,"_17356":41333,"_1875":41423},[],"Coste adicional",{"_9127":1609,"_25351":1578,"_21542":41425,"_5":25505,"_17356":41333,"_1875":41426},[],"Generación de claves",{"_9127":1610,"_25351":1578,"_21542":41428,"_5":25505,"_17356":41333,"_1875":41429},[],"Persistencia *at-rest* segura",{"_9127":1611,"_25351":1578,"_21542":41431,"_5":25505,"_17356":41333,"_1875":41432},[],"Filtración de claves",{"_9127":1612,"_25351":1578,"_21542":41434,"_5":25505,"_17356":41333,"_1875":41435},[],"Consideraciones",{"_9127":1613,"_25351":1578,"_21542":41437,"_5":25505,"_17356":41333,"_1875":41438},[],"File System",{"_9127":1614,"_25351":1578,"_21542":41440,"_5":25505,"_17356":41333,"_1875":4389},[],{"_9127":1615,"_25351":1578,"_21542":41442,"_5":25505,"_17356":41333,"_1875":41443},[],"OnPrem y Cloud",{"_9127":1616,"_25351":1578,"_21542":41445,"_5":25505,"_17356":41333,"_1875":38056},[],{"_9127":1617,"_25351":1578,"_21542":41447,"_5":25505,"_17356":41333,"_1875":41448},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_9127":1618,"_25351":1578,"_21542":41450,"_5":25505,"_17356":41333,"_1875":41451},[],"**Insegura**. Delegada en el sistema de archivos.",{"_9127":1619,"_25351":1578,"_21542":41453,"_5":25505,"_17356":41333,"_1875":41451},[],{"_9127":1620,"_25351":1578,"_21542":41455,"_5":25505,"_17356":41333,"_1875":41456},[],"No recomendado para producción.",{"_9127":1621,"_25351":1578,"_21542":41458,"_5":25505,"_17356":41333,"_1875":41459},[],"HashiCorp Vault",{"_9127":1622,"_25351":1578,"_21542":41461,"_5":25505,"_17356":41333,"_1875":4716},[],{"_9127":1623,"_25351":1578,"_21542":41463,"_5":25505,"_17356":41333,"_1875":41443},[],{"_9127":1624,"_25351":1578,"_21542":41465,"_5":25505,"_17356":41333,"_1875":38056},[],{"_9127":1625,"_25351":1578,"_21542":41467,"_5":25505,"_17356":41333,"_1875":41468},[],"Depende de la configuración de Vault.",{"_9127":1626,"_25351":1578,"_21542":41470,"_5":25505,"_17356":41333,"_1875":41471},[],"**Segura**",{"_9127":1627,"_25351":1578,"_21542":41473,"_5":25505,"_17356":41333,"_1875":41474},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_9127":1628,"_25351":1578,"_21542":41476,"_5":25505,"_17356":41333,"_1875":41477},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_9127":1629,"_25351":1578,"_21542":41479,"_5":25505,"_17356":41333,"_1875":41480},[],"AWS Secrets Manager",{"_9127":1630,"_25351":1578,"_21542":41482,"_5":25505,"_17356":41333,"_1875":4716},[],{"_9127":1631,"_25351":1578,"_21542":41484,"_5":25505,"_17356":41333,"_1875":41485},[],"Cloud",{"_9127":1632,"_25351":1578,"_21542":41487,"_5":25505,"_17356":41333,"_1875":38004},[],{"_9127":1633,"_25351":1578,"_21542":41489,"_5":25505,"_17356":41333,"_1875":41490},[],"Depende del proceso de alta de la clave.",{"_9127":1634,"_25351":1578,"_21542":41492,"_5":25505,"_17356":41333,"_1875":41471},[],{"_9127":1635,"_25351":1578,"_21542":41494,"_5":25505,"_17356":41333,"_1875":41474},[],{"_9127":1636,"_25351":1578,"_21542":41496,"_5":25505,"_17356":41333,"_1875":41497},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_9127":1637,"_25351":1578,"_21542":41499,"_5":25505,"_17356":41333,"_1875":41500},[],"AWS KMS",{"_9127":1638,"_25351":1578,"_21542":41502,"_5":25505,"_17356":41333,"_1875":15297},[],{"_9127":1639,"_25351":1578,"_21542":41504,"_5":25505,"_17356":41333,"_1875":41485},[],{"_9127":1640,"_25351":1578,"_21542":41506,"_5":25505,"_17356":41333,"_1875":38004},[],{"_9127":1641,"_25351":1578,"_21542":41508,"_5":25505,"_17356":41333,"_1875":41509},[],"**Entropía hardware**",{"_9127":1642,"_25351":1578,"_21542":41511,"_5":25505,"_17356":41333,"_1875":41471},[],{"_9127":1643,"_25351":1578,"_21542":41513,"_5":25505,"_17356":41333,"_1875":41471},[],{"_9127":1644,"_25351":1578,"_21542":41515,"_5":25505,"_17356":41333,"_1875":41516},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_9127":1645,"_25351":1578,"_21542":41518,"_5":25505,"_17356":41333,"_1875":41519},[],"PKCS11",{"_9127":1646,"_25351":1578,"_21542":41521,"_5":25505,"_17356":41333,"_1875":41522},[],"3\\*",{"_9127":1647,"_25351":1578,"_21542":41524,"_5":25505,"_17356":41333,"_1875":41525},[],"AirGap OnPrem y Cloud",{"_9127":1648,"_25351":1578,"_21542":41527,"_5":25505,"_17356":41333,"_1875":41528},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_9127":1649,"_25351":1578,"_21542":41530,"_5":25505,"_17356":41333,"_1875":41509},[],{"_9127":1650,"_25351":1578,"_21542":41532,"_5":25505,"_17356":41333,"_1875":41533},[],"**Segura**\\*",{"_9127":1651,"_25351":1578,"_21542":41535,"_5":25505,"_17356":41333,"_1875":41536},[],"Depende del HSM",{"_9127":1652,"_25351":1578,"_21542":41538,"_5":25505,"_17356":41333,"_1875":41539},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_9127":1653,"_25351":1578,"_21542":41541,"_5":25505,"_17356":41333,"_1875":41542},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_9127":1654,"_25351":1578,"_21542":41544,"_5":25505,"_17356":41333,"_1875":41545},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_9127":1655,"_25351":1578,"_21542":41547,"_5":25505,"_17356":41333,"_1875":41548},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_9127":1656,"_25351":1578,"_21542":41550,"_5":25505,"_17356":41337,"_1875":41551},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_9127":1657,"_25351":1578,"_21542":41553,"_5":25505,"_17356":41337,"_1875":41554},[],"La tabla incluye los siguientes campos:",{"_9127":1658,"_25351":1578,"_21542":41556,"_5":25505,"_17356":41337,"_1875":41557},[],"**Name**: nombre descriptivo de la clave.",{"_9127":1659,"_25351":1578,"_21542":41559,"_5":25505,"_17356":41337,"_1875":41560},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_9127":1660,"_25351":1578,"_21542":41562,"_5":25505,"_17356":41337,"_1875":41563},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_9127":1661,"_25351":1578,"_21542":41565,"_5":25505,"_17356":41337,"_1875":41566},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_9127":1662,"_25351":1578,"_21542":41568,"_5":25505,"_17356":41337,"_1875":41569},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_9127":1663,"_25351":1578,"_21542":41571,"_5":25505,"_17356":41337,"_1875":41572},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_9127":1664,"_25351":1578,"_21542":41574,"_5":25505,"_17356":41337,"_1875":41575},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_9127":1665,"_25351":1578,"_21542":41577,"_5":25505,"_17356":41337,"_1875":41578},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_9127":1666,"_25351":1578,"_21542":41580,"_5":25505,"_17356":41337,"_1875":41581},[],"Desde esta vista también se accede a las acciones más habituales:",{"_9127":1667,"_25351":1578,"_21542":41583,"_5":25505,"_17356":41337,"_1875":41584},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_9127":1668,"_25351":1578,"_21542":41586,"_5":25505,"_17356":41337,"_1875":41587},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_9127":1669,"_25351":1578,"_21542":41589,"_5":25505,"_17356":41337,"_1875":41590},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_9127":1670,"_25351":1578,"_21542":41592,"_5":25505,"_17356":41337,"_1875":41593},[],"**Delete Key** para eliminar la clave del sistema.",{"_9127":1671,"_25351":1578,"_21542":41595,"_5":25505,"_17356":41341,"_1875":41596},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_9127":1672,"_25351":1578,"_21542":41598,"_5":25505,"_17356":41345,"_1875":41599},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_9127":1673,"_25351":1578,"_21542":41601,"_5":25505,"_17356":41345,"_1875":41602},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_9127":1674,"_25351":1578,"_21542":41604,"_5":25505,"_17356":41345,"_1875":41605},[],"**Key Name**: nombre único y descriptivo.",{"_9127":1675,"_25351":1578,"_21542":41607,"_5":25505,"_17356":41345,"_1875":41608},[],"**Crypto Engine**: motor que custodiará la clave.",{"_9127":1676,"_25351":1578,"_21542":41610,"_5":25505,"_17356":41345,"_1875":41611},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_9127":1677,"_25351":1578,"_21542":41613,"_5":25505,"_17356":41345,"_1875":41614},[],"**Tags**: metadatos para clasificar la clave.",{"_9127":1678,"_25351":1578,"_21542":41616,"_5":25505,"_17356":41345,"_1875":41617},[],"**Metadata**: información adicional para usos avanzados.",{"_9127":1679,"_25351":1578,"_21542":41619,"_5":25505,"_17356":41349,"_1875":41620},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_9127":1680,"_25351":1578,"_21542":41622,"_5":25505,"_17356":41349,"_1875":41623},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_9127":1681,"_25351":1578,"_21542":41625,"_5":25505,"_17356":41349,"_1875":41626},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_9127":1682,"_25351":1578,"_21542":41628,"_5":25505,"_17356":41349,"_1875":41629},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_9127":1683,"_25351":1578,"_21542":41631,"_5":25505,"_17356":41349,"_1875":41632},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_9127":1684,"_25351":1578,"_21542":41634,"_5":25505,"_17356":41349,"_1875":41635},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_9127":1685,"_25351":1578,"_21542":41637,"_5":25505,"_17356":41349,"_1875":41638},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_9127":1686,"_25351":1578,"_21542":41640,"_5":25505,"_17356":41349,"_1875":41641},[],"**Tags**: etiquetas para organización y búsqueda.",{"_9127":1687,"_25351":1578,"_21542":41643,"_5":25505,"_17356":41349,"_1875":41644},[],"**Metadata**: información adicional opcional.",{"_9127":1688,"_25351":1578,"_21542":41646,"_5":25505,"_17356":41349,"_1875":41647},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_9127":1689,"_25351":1578,"_21542":41649,"_5":25505,"_17356":41349,"_1875":41650},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_9127":1690,"_25351":1578,"_21542":41652,"_5":25505,"_17356":41353,"_1875":41653},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_9127":1691,"_25351":1578,"_21542":41655,"_5":25505,"_17356":41357,"_1875":41656},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_9127":1692,"_25351":1578,"_21542":41658,"_5":25505,"_17356":41357,"_1875":41659},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_9127":1693,"_25351":1578,"_21542":41661,"_5":25505,"_17356":41357,"_1875":41662},[],"**Key Name**: nombre descriptivo.",{"_9127":1694,"_25351":1578,"_21542":41664,"_5":25505,"_17356":41357,"_1875":41665},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_9127":1695,"_25351":1578,"_21542":41667,"_5":25505,"_17356":41357,"_1875":41668},[],"**Tags**: etiquetas asociadas.",{"_9127":1696,"_25351":1578,"_21542":41670,"_5":25505,"_17356":41357,"_1875":41671},[],"**Aliases**: nombres alternativos.",{"_9127":1697,"_25351":1578,"_21542":41673,"_5":25505,"_17356":41357,"_1875":41674},[],"**Crypto Engine**: motor en el que reside la clave.",{"_9127":1698,"_25351":1578,"_21542":41676,"_5":25505,"_17356":41357,"_1875":41677},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_9127":1699,"_25351":1578,"_21542":41679,"_5":25505,"_17356":41357,"_1875":41680},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_9127":1700,"_25351":1578,"_21542":41682,"_5":25505,"_17356":41357,"_1875":41683},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_9127":1701,"_25351":1578,"_21542":41685,"_5":25505,"_17356":41361,"_1875":41686},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_9127":1702,"_25351":1578,"_21542":41688,"_5":25505,"_17356":41361,"_1875":41689},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_9127":1703,"_25351":1578,"_21542":41691,"_5":25505,"_17356":41365,"_1875":41692},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_9127":1704,"_25351":1578,"_21542":41694,"_5":25505,"_17356":41365,"_1875":41695},[],"Campos principales:",{"_9127":1705,"_25351":1578,"_21542":41697,"_5":25505,"_17356":41365,"_1875":41698},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_9127":1706,"_25351":1578,"_21542":41700,"_5":25505,"_17356":41365,"_1875":41701},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_9127":1707,"_25351":1578,"_21542":41703,"_5":25505,"_17356":41365,"_1875":41704},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_9127":1708,"_25351":1578,"_21542":41706,"_5":25505,"_17356":41365,"_1875":41707},[],"**Message**: contenido que se va a firmar.",{"_9127":1709,"_25351":1578,"_21542":41709,"_5":25505,"_17356":41365,"_1875":41710},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_9127":1710,"_25351":1578,"_21542":41712,"_5":25505,"_17356":41369,"_1875":41713},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_9127":1711,"_25351":1578,"_21542":41715,"_5":25505,"_17356":41369,"_1875":41695},[],{"_9127":1712,"_25351":1578,"_21542":41717,"_5":25505,"_17356":41369,"_1875":41718},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_9127":1713,"_25351":1578,"_21542":41720,"_5":25505,"_17356":41369,"_1875":41721},[],"**Message Type**: `Raw` o `Digest`.",{"_9127":1714,"_25351":1578,"_21542":41723,"_5":25505,"_17356":41369,"_1875":41724},[],"**Payload Encoding**: codificación del mensaje.",{"_9127":1715,"_25351":1578,"_21542":41726,"_5":25505,"_17356":41369,"_1875":41727},[],"**Message**: mensaje original o hash.",{"_9127":1716,"_25351":1578,"_21542":41729,"_5":25505,"_17356":41369,"_1875":41730},[],"**Signature**: firma que se desea comprobar.",{"_9127":1717,"_25351":1578,"_21542":41732,"_5":25505,"_17356":41369,"_1875":41733},[],"**Result**: indicador del resultado de la validación.",{"_9127":1718,"_25351":1578,"_21542":41735,"_5":25505,"_17356":41373,"_1875":41736},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_9127":1719,"_25351":1578,"_21542":41738,"_5":25505,"_17356":41373,"_1875":41739},[],"Este flujo es útil para:",{"_9127":1720,"_25351":1578,"_21542":41741,"_5":25505,"_17356":41373,"_1875":41742},[],"Solicitar certificados a una CA externa.",{"_9127":1721,"_25351":1578,"_21542":41744,"_5":25505,"_17356":41373,"_1875":41745},[],"Renovar una identidad manteniendo la misma clave.",{"_9127":1722,"_25351":1578,"_21542":41747,"_5":25505,"_17356":41373,"_1875":41748},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_9127":1723,"_25351":1578,"_21542":41750,"_5":25505,"_17356":41373,"_1875":41751},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_9127":1724,"_25351":1578,"_21542":41753,"_5":25505,"_17356":41373,"_1875":41754},[],"**Organization (O)**: organización o empresa.",{"_9127":1725,"_25351":1578,"_21542":41756,"_5":25505,"_17356":41373,"_1875":41757},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_9127":1726,"_25351":1578,"_21542":41759,"_5":25505,"_17356":41373,"_1875":41760},[],"**Country (C)**: código de país de dos letras.",{"_9127":1727,"_25351":1578,"_21542":41762,"_5":25505,"_17356":41373,"_1875":41763},[],"**State / Province (ST)**: estado o provincia.",{"_9127":1728,"_25351":1578,"_21542":41765,"_5":25505,"_17356":41373,"_1875":41766},[],"**Locality (L)**: ciudad o localidad.",{"_9127":1729,"_25351":1578,"_21542":41768,"_5":25505,"_17356":41373,"_1875":41769},[],"**Email Address**: correo de contacto.",{"_9127":1730,"_25351":1578,"_21542":41771,"_5":25505,"_17356":41373,"_1875":41772},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_9127":1731,"_25351":1578,"_21542":41774,"_5":25505,"_17356":41373,"_1875":41775},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_9127":1732,"_25351":1578,"_21542":41777,"_5":25505,"_17356":41377,"_1875":41778},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_9127":1733,"_25351":1578,"_21542":41780,"_5":25505,"_17356":41377,"_1875":41781},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_9127":1734,"_25351":1734,"_5":25500,"_1875":41783,"_25513":41784,"_21542":41785,"_17356":1734},"[DMS] Device Management Service",[36657,37756,37765],[],{"_9127":1735,"_25351":1734,"_21542":41787,"_5":25505,"_17356":1734,"_1875":41788},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_9127":1736,"_25351":1734,"_5":25510,"_21542":41790,"_17356":41791,"_1875":41792},[],"/docs/pr-preview/pr-24/manual/servicios-core/ra#device-management-service","Device Management Service",{"_9127":1737,"_25351":1734,"_5":25510,"_21542":41794,"_17356":41795,"_1875":39332},[],"/docs/pr-preview/pr-24/manual/servicios-core/ra#antes-de-empezar",{"_9127":1738,"_25351":1734,"_5":25510,"_21542":41797,"_17356":41798,"_1875":41799},[],"/docs/pr-preview/pr-24/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_9127":1739,"_25351":1734,"_5":25510,"_21542":41801,"_17356":41802,"_1875":41803},[],"/docs/pr-preview/pr-24/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_9127":1740,"_25351":1734,"_5":25510,"_21542":41805,"_17356":41806,"_1875":41807},[],"/docs/pr-preview/pr-24/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_9127":1741,"_25351":1734,"_21542":41809,"_5":25505,"_17356":41791,"_1875":41810},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_9127":1742,"_25351":1734,"_21542":41812,"_5":25505,"_17356":41791,"_1875":41813},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_9127":1743,"_25351":1734,"_21542":41815,"_5":25505,"_17356":41795,"_1875":41816},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_9127":1744,"_25351":1734,"_21542":41818,"_5":25505,"_17356":41798,"_1875":41819},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_9127":1745,"_25351":1734,"_21542":41821,"_5":25505,"_17356":41798,"_1875":41822},[],"Acción",{"_9127":1746,"_25351":1734,"_21542":41824,"_5":25505,"_17356":41798,"_1875":36860},[],{"_9127":1747,"_25351":1734,"_21542":41826,"_5":25505,"_17356":41798,"_1875":41827},[],"**Edit**",{"_9127":1748,"_25351":1734,"_21542":41829,"_5":25505,"_17356":41798,"_1875":41830},[],"Modifica la configuración del DMS.",{"_9127":1749,"_25351":1734,"_21542":41832,"_5":25505,"_17356":41798,"_1875":41833},[],"**Go to DMS owned devices**",{"_9127":1750,"_25351":1734,"_21542":41835,"_5":25505,"_17356":41798,"_1875":41836},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_9127":1751,"_25351":1734,"_21542":41838,"_5":25505,"_17356":41798,"_1875":41839},[],"**Show/Edit Metadata**",{"_9127":1752,"_25351":1734,"_21542":41841,"_5":25505,"_17356":41798,"_1875":41842},[],"Accede a los metadatos del DMS para usos avanzados.",{"_9127":1753,"_25351":1734,"_21542":41844,"_5":25505,"_17356":41798,"_1875":41845},[],"**EST (RFC-7030)**",{"_9127":1754,"_25351":1734,"_21542":41847,"_5":25505,"_17356":41798,"_1875":41848},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_9127":1755,"_25351":1734,"_21542":41850,"_5":25505,"_17356":41798,"_1875":41851},[],"**Delete**",{"_9127":1756,"_25351":1734,"_21542":41853,"_5":25505,"_17356":41798,"_1875":41854},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_9127":1757,"_25351":1734,"_21542":41856,"_5":25505,"_17356":41802,"_1875":41857},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_9127":1758,"_25351":1734,"_21542":41859,"_5":25505,"_17356":41802,"_1875":37988},[],{"_9127":1759,"_25351":1734,"_21542":41861,"_5":25505,"_17356":41802,"_1875":36860},[],{"_9127":1760,"_25351":1734,"_21542":41863,"_5":25505,"_17356":41802,"_1875":41864},[],"**Include Lamassu System CA**",{"_9127":1761,"_25351":1734,"_21542":41866,"_5":25505,"_17356":41802,"_1875":41867},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_9127":1762,"_25351":1734,"_21542":41869,"_5":25505,"_17356":41802,"_1875":41870},[],"**Include Enrollment CA**",{"_9127":1763,"_25351":1734,"_21542":41872,"_5":25505,"_17356":41802,"_1875":41873},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_9127":1764,"_25351":1734,"_21542":41875,"_5":25505,"_17356":41802,"_1875":41876},[],"**Managed CAs**",{"_9127":1765,"_25351":1734,"_21542":41878,"_5":25505,"_17356":41802,"_1875":41879},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_9127":1766,"_25351":1734,"_21542":41881,"_5":25505,"_17356":41806,"_1875":41882},[],"Cada DMS expone un único protocolo de enrolamiento a los dispositivos, seleccionado al crear o editar el DMS. Lamassu soporta dos protocolos alternativos y mutuamente excluyentes: &#x2A;*EST (RFC 7030)** y &#x2A;*CMP (RFC 9483 Lightweight CMP Profile / RFC 4210)**. Cambiar el protocolo de un DMS existente sustituye por completo su configuración de enrolamiento; no hay migración automática de ajustes entre uno y otro. La configuración de cada protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_9127":1767,"_25351":1734,"_21542":41884,"_5":25505,"_17356":41806,"_1875":40147},[],{"_9127":1768,"_25351":1734,"_21542":41886,"_5":25505,"_17356":41806,"_1875":41887},[],"<Card title=\"CMP (RFC 9483)\" href=\"/docs/manual/servicios-core/cmp\" />",{"_9127":1769,"_25351":1734,"_21542":41889,"_5":25505,"_17356":41806,"_1875":40150},[],{"_9127":1770,"_25351":1770,"_5":25500,"_1875":41891,"_25513":41892,"_21542":41893,"_17356":1770},"[VA] Servicio CRL",[36657,37756,37765],[],{"_9127":1771,"_25351":1770,"_21542":41895,"_5":25505,"_17356":1770,"_1875":41896},[],"Gestión y consulta de listas de revocación para validación offline",{"_9127":1772,"_25351":1770,"_5":25510,"_21542":41898,"_17356":41899,"_1875":41900},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_9127":1773,"_25351":1770,"_5":25510,"_21542":41902,"_17356":41903,"_1875":41904},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_9127":1774,"_25351":1770,"_5":25510,"_21542":41906,"_17356":41907,"_1875":41908},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_9127":1775,"_25351":1770,"_5":25510,"_21542":41910,"_17356":41911,"_1875":41912},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_9127":1776,"_25351":1770,"_5":25510,"_21542":41914,"_17356":41915,"_1875":41916},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_9127":1777,"_25351":1770,"_5":25510,"_21542":41918,"_17356":41919,"_1875":41920},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_9127":1778,"_25351":1770,"_5":25510,"_21542":41922,"_17356":41923,"_1875":41924},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_9127":1779,"_25351":1770,"_5":25510,"_21542":41926,"_17356":41927,"_1875":41928},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-crl#referencias","Referencias",{"_9127":1780,"_25351":1770,"_21542":41930,"_5":25505,"_17356":41899,"_1875":41931},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_9127":1781,"_25351":1770,"_21542":41933,"_5":25505,"_17356":41899,"_1875":41934},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_9127":1782,"_25351":1770,"_21542":41936,"_5":25505,"_17356":41903,"_1875":41937},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_9127":1783,"_25351":1770,"_21542":41939,"_5":25505,"_17356":41903,"_1875":41940},[],"Los parámetros principales son:",{"_9127":1784,"_25351":1770,"_21542":41942,"_5":25505,"_17356":41903,"_1875":37988},[],{"_9127":1785,"_25351":1770,"_21542":41944,"_5":25505,"_17356":41903,"_1875":36857},[],{"_9127":1786,"_25351":1770,"_21542":41946,"_5":25505,"_17356":41903,"_1875":36860},[],{"_9127":1787,"_25351":1770,"_21542":41948,"_5":25505,"_17356":41903,"_1875":41949},[],"`validity`",{"_9127":1788,"_25351":1770,"_21542":41951,"_5":25505,"_17356":41903,"_1875":41952},[],"7 días",{"_9127":1789,"_25351":1770,"_21542":41954,"_5":25505,"_17356":41903,"_1875":41955},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_9127":1790,"_25351":1770,"_21542":41957,"_5":25505,"_17356":41903,"_1875":41958},[],"`refresh_interval`",{"_9127":1791,"_25351":1770,"_21542":41960,"_5":25505,"_17356":41903,"_1875":41961},[],"\\~6 días y 23 horas",{"_9127":1792,"_25351":1770,"_21542":41963,"_5":25505,"_17356":41903,"_1875":41964},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_9127":1793,"_25351":1770,"_21542":41966,"_5":25505,"_17356":41903,"_1875":41967},[],"`regenerate_on_revoke`",{"_9127":1794,"_25351":1770,"_21542":41969,"_5":25505,"_17356":41903,"_1875":41970},[],"`true`",{"_9127":1795,"_25351":1770,"_21542":41972,"_5":25505,"_17356":41903,"_1875":41973},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_9127":1796,"_25351":1770,"_21542":41975,"_5":25505,"_17356":41903,"_1875":41976},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_9127":1797,"_25351":1770,"_21542":41978,"_5":25505,"_17356":41903,"_1875":41979},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_9127":1798,"_25351":1770,"_21542":41981,"_5":25505,"_17356":41907,"_1875":41982},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_9127":1799,"_25351":1770,"_21542":41984,"_5":25505,"_17356":41907,"_1875":41985},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_9127":1800,"_25351":1770,"_21542":41987,"_5":25505,"_17356":41911,"_1875":41988},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_9127":1801,"_25351":1770,"_21542":41990,"_5":25505,"_17356":41911,"_1875":41991},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_9127":1802,"_25351":1770,"_21542":41993,"_5":25505,"_17356":41915,"_1875":41994},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_9127":1803,"_25351":1770,"_21542":41996,"_5":25505,"_17356":41915,"_1875":41997},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_9127":1804,"_25351":1770,"_21542":41999,"_5":25505,"_17356":41919,"_1875":42000},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_9127":1805,"_25351":1770,"_21542":42002,"_5":25505,"_17356":41919,"_1875":42003},[],"Método",{"_9127":1806,"_25351":1770,"_21542":42005,"_5":25505,"_17356":41919,"_1875":42006},[],"Ruta",{"_9127":1807,"_25351":1770,"_21542":42008,"_5":25505,"_17356":41919,"_1875":36860},[],{"_9127":1808,"_25351":1770,"_21542":42010,"_5":25505,"_17356":41919,"_1875":42011},[],"`GET`",{"_9127":1809,"_25351":1770,"_21542":42013,"_5":25505,"_17356":41919,"_1875":42014},[],"`/v1/roles/{ca-ski}`",{"_9127":1810,"_25351":1770,"_21542":42016,"_5":25505,"_17356":41919,"_1875":42017},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_9127":1811,"_25351":1770,"_21542":42019,"_5":25505,"_17356":41919,"_1875":42020},[],"`PUT`",{"_9127":1812,"_25351":1770,"_21542":42022,"_5":25505,"_17356":41919,"_1875":42014},[],{"_9127":1813,"_25351":1770,"_21542":42024,"_5":25505,"_17356":41919,"_1875":42025},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_9127":1814,"_25351":1770,"_21542":42027,"_5":25505,"_17356":41919,"_1875":42028},[],"Ejemplo de consulta del rol VA:",{"_9127":1815,"_25351":1770,"_21542":42030,"_5":25505,"_17356":41919,"_1875":42031},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_9127":1816,"_25351":1770,"_21542":42033,"_5":25505,"_17356":41923,"_1875":42034},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_9127":1817,"_25351":1770,"_21542":42036,"_5":25505,"_17356":41927,"_1875":42037},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_9127":1818,"_25351":1770,"_21542":42039,"_5":25505,"_17356":41927,"_1875":42040},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_9127":1819,"_25351":1770,"_21542":42042,"_5":25505,"_17356":41927,"_1875":42043},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_9127":1820,"_25351":1820,"_5":25500,"_1875":42045,"_25513":42046,"_21542":42047,"_17356":1820},"[VA] Servicio OCSP",[36657,37756,37765],[],{"_9127":1821,"_25351":1820,"_21542":42049,"_5":25505,"_17356":1820,"_1875":42050},[],"Validación online del estado de certificados mediante OCSP",{"_9127":1822,"_25351":1820,"_5":25510,"_21542":42052,"_17356":42053,"_1875":42054},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_9127":1823,"_25351":1820,"_5":25510,"_21542":42056,"_17356":42057,"_1875":42058},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_9127":1824,"_25351":1820,"_5":25510,"_21542":42060,"_17356":42061,"_1875":42062},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_9127":1825,"_25351":1820,"_5":25510,"_21542":42064,"_17356":42065,"_1875":42066},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_9127":1826,"_25351":1820,"_5":25510,"_21542":42068,"_17356":42069,"_1875":42070},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_9127":1827,"_25351":1820,"_5":25510,"_21542":42072,"_17356":42073,"_1875":41928},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation-ocsp#referencias",{"_9127":1828,"_25351":1820,"_21542":42075,"_5":25505,"_17356":42053,"_1875":42076},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_9127":1829,"_25351":1820,"_21542":42078,"_5":25505,"_17356":42053,"_1875":42079},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_9127":1830,"_25351":1820,"_21542":42081,"_5":25505,"_17356":42057,"_1875":42082},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_9127":1831,"_25351":1820,"_21542":42084,"_5":25505,"_17356":42057,"_1875":42085},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_9127":1832,"_25351":1820,"_21542":42087,"_5":25505,"_17356":42057,"_1875":42088},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_9127":1833,"_25351":1820,"_21542":42090,"_5":25505,"_17356":42057,"_1875":42091},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_9127":1834,"_25351":1820,"_21542":42093,"_5":25505,"_17356":42057,"_1875":42094},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_9127":1835,"_25351":1820,"_21542":42096,"_5":25505,"_17356":42057,"_1875":42097},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_9127":1836,"_25351":1820,"_21542":42099,"_5":25505,"_17356":42061,"_1875":42100},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_9127":1837,"_25351":1820,"_21542":42102,"_5":25505,"_17356":42065,"_1875":42103},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_9127":1838,"_25351":1820,"_21542":42105,"_5":25505,"_17356":42065,"_1875":42003},[],{"_9127":1839,"_25351":1820,"_21542":42107,"_5":25505,"_17356":42065,"_1875":42006},[],{"_9127":1840,"_25351":1820,"_21542":42109,"_5":25505,"_17356":42065,"_1875":36860},[],{"_9127":1841,"_25351":1820,"_21542":42111,"_5":25505,"_17356":42065,"_1875":42011},[],{"_9127":1842,"_25351":1820,"_21542":42113,"_5":25505,"_17356":42065,"_1875":42114},[],"`/ocsp/{ocsp_request}`",{"_9127":1843,"_25351":1820,"_21542":42116,"_5":25505,"_17356":42065,"_1875":42117},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_9127":1844,"_25351":1820,"_21542":42119,"_5":25505,"_17356":42065,"_1875":42120},[],"`POST`",{"_9127":1845,"_25351":1820,"_21542":42122,"_5":25505,"_17356":42065,"_1875":42123},[],"`/ocsp`",{"_9127":1846,"_25351":1820,"_21542":42125,"_5":25505,"_17356":42065,"_1875":42126},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_9127":1847,"_25351":1820,"_21542":42128,"_5":25505,"_17356":42065,"_1875":42129},[],"Ejemplo de consulta con `curl` mediante POST:",{"_9127":1848,"_25351":1820,"_21542":42131,"_5":25505,"_17356":42065,"_1875":42132},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_9127":1849,"_25351":1820,"_21542":42134,"_5":25505,"_17356":42069,"_1875":42135},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_9127":1850,"_25351":1820,"_21542":42137,"_5":25505,"_17356":42073,"_1875":42138},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_9127":1851,"_25351":1820,"_21542":42140,"_5":25505,"_17356":42073,"_1875":42141},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_9127":1852,"_25351":1820,"_21542":42143,"_5":25505,"_17356":42073,"_1875":42144},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_9127":1853,"_25351":1820,"_21542":42146,"_5":25505,"_17356":42073,"_1875":42043},[],{"_9127":1854,"_25351":1854,"_5":25500,"_1875":42148,"_25513":42149,"_21542":42150,"_17356":1854},"[VA] Validación de Certificados",[36657,37756,37765],[],{"_9127":1855,"_25351":1854,"_21542":42152,"_5":25505,"_17356":1854,"_1875":42153},[],"Servicios OCSP y CRL para validación de certificados",{"_9127":1856,"_25351":1854,"_5":25510,"_21542":42155,"_17356":42156,"_1875":42157},[],"/docs/pr-preview/pr-24/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_9127":1857,"_25351":1854,"_21542":42159,"_5":25505,"_17356":42156,"_1875":42160},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_9127":1858,"_25351":1854,"_21542":42162,"_5":25505,"_17356":42156,"_1875":42163},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_9127":1859,"_25351":1854,"_21542":42165,"_5":25505,"_17356":42156,"_1875":42166},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_9127":1860,"_25351":1854,"_21542":42168,"_5":25505,"_17356":42156,"_1875":42169},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_9127":1861,"_25351":1861,"_5":25500,"_1875":42171,"_21542":42172,"_17356":1861},"Test",[],{"_9127":1862,"_25351":1861,"_21542":42174,"_5":25505,"_17356":1861,"_1875":42175},[],"A document to test Fumadocs",{"_9127":1863,"_25351":1861,"_5":25510,"_21542":42177,"_17356":42178,"_1875":42179},[],"/docs/pr-preview/pr-24/test#cards","Cards",{"_9127":1864,"_25351":1861,"_5":25510,"_21542":42181,"_17356":42182,"_1875":42183},[],"/docs/pr-preview/pr-24/test#codeblock","CodeBlock",{"_9127":1865,"_25351":1861,"_5":25510,"_21542":42185,"_17356":42186,"_1875":42187},[],"/docs/pr-preview/pr-24/test#list","List",{"_9127":1866,"_25351":1861,"_21542":42189,"_5":25505,"_17356":1861,"_1875":42190},[],"Hey there!",{"_9127":1867,"_25351":1861,"_21542":42192,"_5":25505,"_17356":42178,"_1875":42193},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_9127":1868,"_25351":1861,"_21542":42195,"_5":25505,"_17356":42178,"_1875":42196},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_9127":1869,"_25351":1861,"_21542":42198,"_5":25505,"_17356":42186,"_1875":42199},[],"Hello",{"_9127":1870,"_25351":1861,"_21542":42201,"_5":25505,"_17356":42186,"_1875":42202},[],"World","sorting",{"_42205":42206,"_42207":42208,"_42209":42210,"_42211":42212,"_5318":1893,"_49666":1893},"language","english","sortableProperties",[1875,25351,5,17356],"sortablePropertiesWithTypes",{"_1875":13131,"_25351":13131,"_5":13131,"_17356":13131},"sorts",{"_1875":42213,"_25351":44077,"_5":45940,"_17356":47803},{"_9418":42214,"_42215":42216,"_5":13131},{"_4389":4789,"_4716":2016,"_15297":8041,"_22405":5168,"_15284":3110,"_23051":5064,"_15245":3494,"_15268":4832,"_22422":5400,"_25026":7861,"_25021":6177,"_27318":3413,"_27321":2727,"_25016":3599,"_22466":3723,"_27326":22435,"_27328":7833,"_27331":9696,"_25011":2385,"_25062":5154,"_22450":8403,"_27338":8401,"_25126":9597,"_15293":19295,"_27343":4493,"_25082":12694,"_27347":2061,"_25131":5871,"_25110":4244,"_24974":3533,"_27352":3311,"_27354":2449,"_27356":7864,"_27358":3827,"_27360":6652,"_27362":7272,"_27365":22917,"_27367":7867,"_27369":2316,"_22418":2097,"_27372":3234,"_27374":2682,"_22412":1989,"_27377":1990,"_27379":6000,"_27381":2472,"_27383":4224,"_27385":2099,"_27387":5163,"_23020":14563,"_27391":5893,"_23064":4152,"_27394":6212,"_27396":2362,"_27398":2471,"_15287":2688,"_27401":8055,"_27403":74