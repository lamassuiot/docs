yment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2886":60108,"_27469":60101,"_5":27746,"_18854":100125,"_25963":100126,"_2424":100127},[],"/docs/pr-preview/pr-24/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2886":60109,"_27469":60101,"_5":27746,"_18854":100129,"_25963":100130,"_2424":100131},[],"/docs/pr-preview/pr-24/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2886":60110,"_27469":60101,"_18854":100133,"_5":12679,"_25963":60101,"_2424":100134},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2886":60111,"_27469":60101,"_18854":100136,"_5":12679,"_25963":100106,"_2424":100137},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2886":60112,"_27469":60101,"_18854":100139,"_5":12679,"_25963":100106,"_2424":100140},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2886":60113,"_27469":60101,"_18854":100142,"_5":12679,"_25963":100106,"_2424":100143},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2886":60114,"_27469":60101,"_18854":100145,"_5":12679,"_25963":100110,"_2424":100146},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2886":60115,"_27469":60101,"_18854":100148,"_5":12679,"_25963":100110,"_2424":100149},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2886":60116,"_27469":60101,"_18854":100151,"_5":12679,"_25963":100110,"_2424":100152},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2886":60117,"_27469":60101,"_18854":100154,"_5":12679,"_25963":100114,"_2424":100155},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2886":60118,"_27469":60101,"_18854":100157,"_5":12679,"_25963":100118,"_2424":100158},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2886":60119,"_27469":60101,"_18854":100160,"_5":12679,"_25963":100122,"_2424":100161},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2886":60120,"_27469":60101,"_18854":100163,"_5":12679,"_25963":100126,"_2424":100164},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2886":60121,"_27469":60101,"_18854":100166,"_5":12679,"_25963":100130,"_2424":100167},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2886":60122,"_27469":60122,"_5":13057,"_2424":100169,"_27749":100170,"_18854":100171,"_25963":60122},"Despliega Lamassu",[43001,100098],[],{"_2886":60123,"_27469":60122,"_18854":100173,"_5":12679,"_25963":60122,"_2424":100174},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2886":60124,"_27469":60122,"_5":27746,"_18854":100176,"_25963":100177,"_2424":100178},[],"/docs/pr-preview/pr-24/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2886":60125,"_27469":60122,"_5":27746,"_18854":100180,"_25963":100181,"_2424":100182},[],"/docs/pr-preview/pr-24/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2886":60126,"_27469":60122,"_5":27746,"_18854":100184,"_25963":100185,"_2424":100186},[],"/docs/pr-preview/pr-24/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2886":60127,"_27469":60122,"_18854":100188,"_5":12679,"_25963":60122,"_2424":100189},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2886":60128,"_27469":60122,"_18854":100191,"_5":12679,"_25963":100177,"_2424":100192},[],"Modelo",{"_2886":60129,"_27469":60122,"_18854":100194,"_5":12679,"_25963":100177,"_2424":100195},[],"Recomendado para",{"_2886":60130,"_27469":60122,"_18854":100197,"_5":12679,"_25963":100177,"_2424":100198},[],"Quién opera la infraestructura",{"_2886":60131,"_27469":60122,"_18854":100200,"_5":12679,"_25963":100177,"_2424":100201},[],"Punto de partida",{"_2886":60132,"_27469":60122,"_18854":100203,"_5":12679,"_25963":100177,"_2424":43108},[],{"_2886":60133,"_27469":60122,"_18854":100205,"_5":12679,"_25963":100177,"_2424":100206},[],"Producción, entornos regulados y despliegues personalizados",{"_2886":60134,"_27469":60122,"_18854":100208,"_5":12679,"_25963":100177,"_2424":100209},[],"Tu equipo",{"_2886":60135,"_27469":60122,"_18854":100211,"_5":12679,"_25963":100177,"_2424":100212},[],"Helm o Fastlane",{"_2886":60136,"_27469":60122,"_18854":100214,"_5":12679,"_25963":100177,"_2424":43120},[],{"_2886":60137,"_27469":60122,"_18854":100216,"_5":12679,"_25963":100177,"_2424":100217},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2886":60138,"_27469":60122,"_18854":100219,"_5":12679,"_25963":100177,"_2424":100209},[],{"_2886":60139,"_27469":60122,"_18854":100221,"_5":12679,"_25963":100177,"_2424":100222},[],"Imagen preconfigurada en EC2",{"_2886":60140,"_27469":60122,"_18854":100224,"_5":12679,"_25963":100177,"_2424":43131},[],{"_2886":60141,"_27469":60122,"_18854":100226,"_5":12679,"_25963":100177,"_2424":100227},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2886":60142,"_27469":60122,"_18854":100229,"_5":12679,"_25963":100177,"_2424":43137},[],{"_2886":60143,"_27469":60122,"_18854":100231,"_5":12679,"_25963":100177,"_2424":100232},[],"Suscripción gestionada",{"_2886":60144,"_27469":60122,"_18854":100234,"_5":12679,"_25963":100177,"_2424":100235},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2886":60145,"_27469":60122,"_18854":100237,"_5":12679,"_25963":100177,"_2424":100238},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2886":60146,"_27469":60122,"_18854":100240,"_5":12679,"_25963":100177,"_2424":100241},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2886":60147,"_27469":60122,"_18854":100243,"_5":12679,"_25963":100181,"_2424":100244},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2886":60148,"_27469":60122,"_18854":100246,"_5":12679,"_25963":100185,"_2424":100247},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2886":60149,"_27469":60149,"_5":13057,"_2424":100249,"_27749":100250,"_18854":100251,"_25963":60149},"Utiliza Lamassu como SaaS",[43001,100098,100099],[],{"_2886":60150,"_27469":60149,"_18854":100253,"_5":12679,"_25963":60149,"_2424":100254},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2886":60151,"_27469":60149,"_5":27746,"_18854":100256,"_25963":100257,"_2424":100258},[],"/docs/pr-preview/pr-24/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2886":60152,"_27469":60149,"_5":27746,"_18854":100260,"_25963":100261,"_2424":100262},[],"/docs/pr-preview/pr-24/es/deployment/saas#planes","Planes",{"_2886":60153,"_27469":60149,"_5":27746,"_18854":100264,"_25963":100265,"_2424":100266},[],"/docs/pr-preview/pr-24/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2886":60154,"_27469":60149,"_18854":100268,"_5":12679,"_25963":60149,"_2424":100269},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2886":60155,"_27469":60149,"_18854":100271,"_5":12679,"_25963":100257,"_2424":100272},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2886":60156,"_27469":60149,"_18854":100274,"_5":12679,"_25963":100257,"_2424":100275},[],"Copias de seguridad automáticas.",{"_2886":60157,"_27469":60149,"_18854":100277,"_5":12679,"_25963":100257,"_2424":100278},[],"Actualizaciones de versión.",{"_2886":60158,"_27469":60149,"_18854":100280,"_5":12679,"_25963":100257,"_2424":100281},[],"Soporte técnico y SLA según el plan contratado.",{"_2886":60159,"_27469":60149,"_18854":100283,"_5":12679,"_25963":100261,"_2424":43192},[],{"_2886":60160,"_27469":60149,"_18854":100285,"_5":12679,"_25963":100261,"_2424":100286},[],"Dispositivos",{"_2886":60161,"_27469":60149,"_18854":100288,"_5":12679,"_25963":100261,"_2424":100289},[],"Soporte",{"_2886":60162,"_27469":60149,"_18854":100291,"_5":12679,"_25963":100261,"_2424":43201},[],{"_2886":60163,"_27469":60149,"_18854":100293,"_5":12679,"_25963":100261,"_2424":43204},[],{"_2886":60164,"_27469":60149,"_18854":100295,"_5":12679,"_25963":100261,"_2424":100296},[],"Hasta 1.000",{"_2886":60165,"_27469":60149,"_18854":100298,"_5":12679,"_25963":100261,"_2424":43210},[],{"_2886":60166,"_27469":60149,"_18854":100300,"_5":12679,"_25963":100261,"_2424":100301},[],"99,5 %",{"_2886":60167,"_27469":60149,"_18854":100303,"_5":12679,"_25963":100261,"_2424":43216},[],{"_2886":60168,"_27469":60149,"_18854":100305,"_5":12679,"_25963":100261,"_2424":100306},[],"Hasta 10.000",{"_2886":60169,"_27469":60149,"_18854":100308,"_5":12679,"_25963":100261,"_2424":100309},[],"Email y chat",{"_2886":60170,"_27469":60149,"_18854":100311,"_5":12679,"_25963":100261,"_2424":100312},[],"99,9 %",{"_2886":60171,"_27469":60149,"_18854":100314,"_5":12679,"_25963":100261,"_2424":43228},[],{"_2886":60172,"_27469":60149,"_18854":100316,"_5":12679,"_25963":100261,"_2424":100317},[],"Ilimitados",{"_2886":60173,"_27469":60149,"_18854":100319,"_5":12679,"_25963":100261,"_2424":100320},[],"Dedicado",{"_2886":60174,"_27469":60149,"_18854":100322,"_5":12679,"_25963":100261,"_2424":100323},[],"99,99 %",{"_2886":60175,"_27469":60149,"_18854":100325,"_5":12679,"_25963":100265,"_2424":100326},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2886":60176,"_27469":60149,"_18854":100328,"_5":12679,"_25963":100265,"_2424":100329},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2886":60177,"_27469":60177,"_5":13057,"_2424":43245,"_27749":100331,"_18854":100332,"_25963":60177},[43001,100098,43108],[],{"_2886":60178,"_27469":60177,"_18854":100334,"_5":12679,"_25963":60177,"_2424":100335},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2886":60179,"_27469":60177,"_5":27746,"_18854":100337,"_25963":100338,"_2424":100339},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2886":60180,"_27469":60177,"_5":27746,"_18854":100341,"_25963":100342,"_2424":100343},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2886":60181,"_27469":60177,"_5":27746,"_18854":100345,"_25963":100346,"_2424":100347},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2886":60182,"_27469":60177,"_5":27746,"_18854":100349,"_25963":100350,"_2424":100351},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2886":60183,"_27469":60177,"_5":27746,"_18854":100353,"_25963":100354,"_2424":100355},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2886":60184,"_27469":60177,"_5":27746,"_18854":100357,"_25963":100358,"_2424":100359},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2886":60185,"_27469":60177,"_5":27746,"_18854":100361,"_25963":100362,"_2424":100363},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2886":60186,"_27469":60177,"_5":27746,"_18854":100365,"_25963":100366,"_2424":100367},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2886":60187,"_27469":60177,"_5":27746,"_18854":100369,"_25963":100370,"_2424":100371},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2886":60188,"_27469":60177,"_5":27746,"_18854":100373,"_25963":100374,"_2424":100375},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2886":60189,"_27469":60177,"_18854":100377,"_5":12679,"_25963":100338,"_2424":100378},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2886":60190,"_27469":60177,"_18854":100380,"_5":12679,"_25963":100338,"_2424":100381},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2886":60191,"_27469":60177,"_18854":100383,"_5":12679,"_25963":100342,"_2424":100384},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2886":60192,"_27469":60177,"_18854":100386,"_5":12679,"_25963":100342,"_2424":100387},[],"Fastlane instala o configura",{"_2886":60193,"_27469":60177,"_18854":100389,"_5":12679,"_25963":100342,"_2424":100390},[],"Tú sigues proporcionando",{"_2886":60194,"_27469":60177,"_18854":100392,"_5":12679,"_25963":100342,"_2424":100393},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2886":60195,"_27469":60177,"_18854":100395,"_5":12679,"_25963":100342,"_2424":100396},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2886":60196,"_27469":60177,"_18854":100398,"_5":12679,"_25963":100342,"_2424":100399},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2886":60197,"_27469":60177,"_18854":100401,"_5":12679,"_25963":100342,"_2424":100402},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2886":60198,"_27469":60177,"_18854":100404,"_5":12679,"_25963":100342,"_2424":100405},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2886":60199,"_27469":60177,"_18854":100407,"_5":12679,"_25963":100342,"_2424":100408},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2886":60200,"_27469":60177,"_18854":100410,"_5":12679,"_25963":100342,"_2424":100411},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2886":60201,"_27469":60177,"_18854":100413,"_5":12679,"_25963":100342,"_2424":100414},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2886":60202,"_27469":60177,"_18854":100416,"_5":12679,"_25963":100342,"_2424":100417},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2886":60203,"_27469":60177,"_18854":100419,"_5":12679,"_25963":100346,"_2424":100420},[],"Necesitas:",{"_2886":60204,"_27469":60177,"_18854":100422,"_5":12679,"_25963":100346,"_2424":100423},[],"un clúster Kubernetes existente",{"_2886":60205,"_27469":60177,"_18854":100425,"_5":12679,"_25963":100346,"_2424":100426},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2886":60206,"_27469":60177,"_18854":100428,"_5":12679,"_25963":100346,"_2424":43343},[],{"_2886":60207,"_27469":60177,"_18854":100430,"_5":12679,"_25963":100346,"_2424":21246},[],{"_2886":60208,"_27469":60177,"_18854":100432,"_5":12679,"_25963":100346,"_2424":100433},[],"`jq` solo si usas `--sample-data`",{"_2886":60209,"_27469":60177,"_18854":100435,"_5":12679,"_25963":100346,"_2424":100436},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2886":60210,"_27469":60177,"_18854":100438,"_5":12679,"_25963":100346,"_2424":100439},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2886":60211,"_27469":60177,"_18854":100441,"_5":12679,"_25963":100346,"_2424":100442},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2886":60212,"_27469":60177,"_18854":100444,"_5":12679,"_25963":100350,"_2424":100445},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2886":60213,"_27469":60177,"_18854":100447,"_5":12679,"_25963":100350,"_2424":100448},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2886":60214,"_27469":60177,"_18854":100450,"_5":12679,"_25963":100354,"_2424":100451},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2886":60215,"_27469":60177,"_18854":100453,"_5":12679,"_25963":100354,"_2424":100454},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2886":60216,"_27469":60177,"_18854":100456,"_5":12679,"_25963":100354,"_2424":100457},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2886":60217,"_27469":60177,"_18854":100459,"_5":12679,"_25963":100354,"_2424":100460},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2886":60218,"_27469":60177,"_18854":100462,"_5":12679,"_25963":100358,"_2424":100463},[],"Opción",{"_2886":60219,"_27469":60177,"_18854":100465,"_5":12679,"_25963":100358,"_2424":100466},[],"Valor predeterminado",{"_2886":60220,"_27469":60177,"_18854":100468,"_5":12679,"_25963":100358,"_2424":100469},[],"Propósito",{"_2886":60221,"_27469":60177,"_18854":100471,"_5":12679,"_25963":100358,"_2424":43387},[],{"_2886":60222,"_27469":60177,"_18854":100473,"_5":12679,"_25963":100358,"_2424":43390},[],{"_2886":60223,"_27469":60177,"_18854":100475,"_5":12679,"_25963":100358,"_2424":100476},[],"Muestra la ayuda",{"_2886":60224,"_27469":60177,"_18854":100478,"_5":12679,"_25963":100358,"_2424":43396},[],{"_2886":60225,"_27469":60177,"_18854":100480,"_5":12679,"_25963":100358,"_2424":100481},[],"contexto actual",{"_2886":60226,"_27469":60177,"_18854":100483,"_5":12679,"_25963":100358,"_2424":100484},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2886":60227,"_27469":60177,"_18854":100486,"_5":12679,"_25963":100358,"_2424":43405},[],{"_2886":60228,"_27469":60177,"_18854":100488,"_5":12679,"_25963":100358,"_2424":5412},[],{"_2886":60229,"_27469":60177,"_18854":100490,"_5":12679,"_25963":100358,"_2424":100491},[],"Omite prompts y genera credenciales para las dependencias",{"_2886":60230,"_27469":60177,"_18854":100493,"_5":12679,"_25963":100358,"_2424":43413},[],{"_2886":60231,"_27469":60177,"_18854":100495,"_5":12679,"_25963":100358,"_2424":43416},[],{"_2886":60232,"_27469":60177,"_18854":100497,"_5":12679,"_25963":100358,"_2424":100498},[],"Namespace de la instalación",{"_2886":60233,"_27469":60177,"_18854":100500,"_5":12679,"_25963":100358,"_2424":43422},[],{"_2886":60234,"_27469":60177,"_18854":100502,"_5":12679,"_25963":100358,"_2424":43425},[],{"_2886":60235,"_27469":60177,"_18854":100504,"_5":12679,"_25963":100358,"_2424":100505},[],"Dominio usado por la UI, OIDC y el certificado",{"_2886":60236,"_27469":60177,"_18854":100507,"_5":12679,"_25963":100358,"_2424":43431},[],{"_2886":60237,"_27469":60177,"_18854":100509,"_5":12679,"_25963":100358,"_2424":13324},[],{"_2886":60238,"_27469":60177,"_18854":100511,"_5":12679,"_25963":100358,"_2424":100512},[],"Versión del chart de Lamassu",{"_2886":60239,"_27469":60177,"_18854":100514,"_5":12679,"_25963":100358,"_2424":43439},[],{"_2886":60240,"_27469":60177,"_18854":100516,"_5":12679,"_25963":100358,"_2424":43442},[],{"_2886":60241,"_27469":60177,"_18854":100518,"_5":12679,"_25963":100358,"_2424":100519},[],"Puerto del listener HTTPS",{"_2886":60242,"_27469":60177,"_18854":100521,"_5":12679,"_25963":100358,"_2424":43448},[],{"_2886":60243,"_27469":60177,"_18854":100523,"_5":12679,"_25963":100358,"_2424":43451},[],{"_2886":60244,"_27469":60177,"_18854":100525,"_5":12679,"_25963":100358,"_2424":100526},[],"Puerto del listener HTTP",{"_2886":60245,"_27469":60177,"_18854":100528,"_5":12679,"_25963":100358,"_2424":43457},[],{"_2886":60246,"_27469":60177,"_18854":100530,"_5":12679,"_25963":100358,"_2424":43390},[],{"_2886":60247,"_27469":60177,"_18854":100532,"_5":12679,"_25963":100358,"_2424":100533},[],"Certificado PEM para TLS downstream",{"_2886":60248,"_27469":60177,"_18854":100535,"_5":12679,"_25963":100358,"_2424":43465},[],{"_2886":60249,"_27469":60177,"_18854":100537,"_5":12679,"_25963":100358,"_2424":43390},[],{"_2886":60250,"_27469":60177,"_18854":100539,"_5":12679,"_25963":100358,"_2424":100540},[],"Clave privada PEM para TLS downstream",{"_2886":60251,"_27469":60177,"_18854":100542,"_5":12679,"_25963":100358,"_2424":43473},[],{"_2886":60252,"_27469":60177,"_18854":100544,"_5":12679,"_25963":100358,"_2424":100545},[],"chart del repositorio",{"_2886":60253,"_27469":60177,"_18854":100547,"_5":12679,"_25963":100358,"_2424":100548},[],"Usa un chart local de Lamassu sin empaquetar",{"_2886":60254,"_27469":60177,"_18854":100550,"_5":12679,"_25963":100358,"_2424":43482},[],{"_2886":60255,"_27469":60177,"_18854":100552,"_5":12679,"_25963":100358,"_2424":100553},[],"detección automática",{"_2886":60256,"_27469":60177,"_18854":100555,"_5":12679,"_25963":100358,"_2424":100556},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2886":60257,"_27469":60177,"_18854":100558,"_5":12679,"_25963":100358,"_2424":43490},[],{"_2886":60258,"_27469":60177,"_18854":100560,"_5":12679,"_25963":100358,"_2424":5412},[],{"_2886":60259,"_27469":60177,"_18854":100562,"_5":12679,"_25963":100358,"_2424":100563},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2886":60260,"_27469":60177,"_18854":100565,"_5":12679,"_25963":100358,"_2424":43498},[],{"_2886":60261,"_27469":60177,"_18854":100567,"_5":12679,"_25963":100358,"_2424":5412},[],{"_2886":60262,"_27469":60177,"_18854":100569,"_5":12679,"_25963":100358,"_2424":100570},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2886":60263,"_27469":60177,"_18854":100572,"_5":12679,"_25963":100358,"_2424":43506},[],{"_2886":60264,"_27469":60177,"_18854":100574,"_5":12679,"_25963":100358,"_2424":5412},[],{"_2886":60265,"_27469":60177,"_18854":100576,"_5":12679,"_25963":100358,"_2424":100577},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2886":60266,"_27469":60177,"_18854":100579,"_5":12679,"_25963":100358,"_2424":43514},[],{"_2886":60267,"_27469":60177,"_18854":100581,"_5":12679,"_25963":100358,"_2424":43517},[],{"_2886":60268,"_27469":60177,"_18854":100583,"_5":12679,"_25963":100358,"_2424":100584},[],"Usa otro chart local de SoftHSM",{"_2886":60269,"_27469":60177,"_18854":100586,"_5":12679,"_25963":100358,"_2424":100587},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2886":60270,"_27469":60177,"_18854":100589,"_5":12679,"_25963":100362,"_2424":43526},[],{"_2886":60271,"_27469":60177,"_18854":100591,"_5":12679,"_25963":100362,"_2424":100592},[],"valida las herramientas locales y el clúster seleccionado",{"_2886":60272,"_27469":60177,"_18854":100594,"_5":12679,"_25963":100362,"_2424":100595},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2886":60273,"_27469":60177,"_18854":100597,"_5":12679,"_25963":100362,"_2424":100598},[],"crea el namespace",{"_2886":60274,"_27469":60177,"_18854":100600,"_5":12679,"_25963":100362,"_2424":100601},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2886":60275,"_27469":60177,"_18854":100603,"_5":12679,"_25963":100362,"_2424":100604},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2886":60276,"_27469":60177,"_18854":100606,"_5":12679,"_25963":100362,"_2424":100607},[],"instala RabbitMQ",{"_2886":60277,"_27469":60177,"_18854":100609,"_5":12679,"_25963":100362,"_2424":100610},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2886":60278,"_27469":60177,"_18854":100612,"_5":12679,"_25963":100362,"_2424":100613},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2886":60279,"_27469":60177,"_18854":100615,"_5":12679,"_25963":100362,"_2424":100616},[],"carga datos de ejemplo opcionalmente",{"_2886":60280,"_27469":60177,"_18854":100618,"_5":12679,"_25963":100362,"_2424":100619},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2886":60281,"_27469":60177,"_18854":100621,"_5":12679,"_25963":100366,"_2424":100622},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2886":60282,"_27469":60177,"_18854":100624,"_5":12679,"_25963":100366,"_2424":100625},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2886":60283,"_27469":60177,"_18854":100627,"_5":12679,"_25963":100370,"_2424":100628},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2886":60284,"_27469":60177,"_18854":100630,"_5":12679,"_25963":100370,"_2424":100631},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2886":60285,"_27469":60177,"_18854":100633,"_5":12679,"_25963":100370,"_2424":100634},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2886":60286,"_27469":60177,"_18854":100636,"_5":12679,"_25963":100374,"_2424":100637},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2886":60287,"_27469":60287,"_5":13057,"_2424":100639,"_27749":100640,"_18854":100641,"_25963":60287},"Instala con Helm",[43001,100098,43108],[],{"_2886":60288,"_27469":60287,"_18854":100643,"_5":12679,"_25963":60287,"_2424":100644},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2886":60289,"_27469":60287,"_5":27746,"_18854":100646,"_25963":100647,"_2424":100648},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2886":60290,"_27469":60287,"_5":27746,"_18854":100650,"_25963":100651,"_2424":100347},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2886":60291,"_27469":60287,"_5":27746,"_18854":100653,"_25963":100654,"_2424":100655},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2886":60292,"_27469":60287,"_5":27746,"_18854":100657,"_25963":100658,"_2424":100659},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2886":60293,"_27469":60287,"_5":27746,"_18854":100661,"_25963":100662,"_2424":100663},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2886":60294,"_27469":60287,"_5":27746,"_18854":100665,"_25963":100666,"_2424":100667},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2886":60295,"_27469":60287,"_5":27746,"_18854":100669,"_25963":100670,"_2424":100671},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2886":60296,"_27469":60287,"_5":27746,"_18854":100673,"_25963":100674,"_2424":100675},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2886":60297,"_27469":60287,"_5":27746,"_18854":100677,"_25963":100678,"_2424":100679},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2886":60298,"_27469":60287,"_18854":100681,"_5":12679,"_25963":100647,"_2424":100682},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2886":60299,"_27469":60287,"_18854":100684,"_5":12679,"_25963":100651,"_2424":100685},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2886":60300,"_27469":60287,"_18854":100687,"_5":12679,"_25963":100651,"_2424":100688},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2886":60301,"_27469":60287,"_18854":100690,"_5":12679,"_25963":100651,"_2424":100691},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2886":60302,"_27469":60287,"_18854":100693,"_5":12679,"_25963":100651,"_2424":100694},[],"un broker RabbitMQ accesible y sus credenciales",{"_2886":60303,"_27469":60287,"_18854":100696,"_5":12679,"_25963":100651,"_2424":100697},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2886":60304,"_27469":60287,"_18854":100699,"_5":12679,"_25963":100651,"_2424":100700},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2886":60305,"_27469":60287,"_18854":100702,"_5":12679,"_25963":100651,"_2424":100703},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2886":60306,"_27469":60287,"_18854":100705,"_5":12679,"_25963":100651,"_2424":100706},[],"una StorageClass y un diseño de tráfico externo",{"_2886":60307,"_27469":60287,"_18854":100708,"_5":12679,"_25963":100651,"_2424":100709},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2886":60308,"_27469":60287,"_18854":100711,"_5":12679,"_25963":100651,"_2424":100712},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2886":60309,"_27469":60287,"_18854":100714,"_5":12679,"_25963":100651,"_2424":100715},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2886":60310,"_27469":60287,"_18854":100717,"_5":12679,"_25963":100654,"_2424":100718},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2886":60311,"_27469":60287,"_18854":100720,"_5":12679,"_25963":100654,"_2424":100721},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2886":60312,"_27469":60287,"_18854":100723,"_5":12679,"_25963":100654,"_2424":100724},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2886":60313,"_27469":60287,"_18854":100726,"_5":12679,"_25963":100658,"_2424":100727},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2886":60314,"_27469":60287,"_18854":100729,"_5":12679,"_25963":100658,"_2424":100730},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2886":60315,"_27469":60287,"_18854":100732,"_5":12679,"_25963":100658,"_2424":100733},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2886":60316,"_27469":60287,"_18854":100735,"_5":12679,"_25963":100662,"_2424":100736},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2886":60317,"_27469":60287,"_18854":100738,"_5":12679,"_25963":100666,"_2424":100739},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2886":60318,"_27469":60287,"_18854":100741,"_5":12679,"_25963":100666,"_2424":100742},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2886":60319,"_27469":60287,"_18854":100744,"_5":12679,"_25963":100666,"_2424":100745},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2886":60320,"_27469":60287,"_18854":100747,"_5":12679,"_25963":100666,"_2424":100748},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2886":60321,"_27469":60287,"_18854":100750,"_5":12679,"_25963":100670,"_2424":100751},[],"Para instalar un checkout local:",{"_2886":60322,"_27469":60287,"_18854":100753,"_5":12679,"_25963":100674,"_2424":100754},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2886":60323,"_27469":60287,"_18854":100756,"_5":12679,"_25963":100674,"_2424":100757},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2886":60324,"_27469":60287,"_18854":100759,"_5":12679,"_25963":100678,"_2424":100760},[],"Antes de pasar a producción, revisa:",{"_2886":60325,"_27469":60287,"_18854":100762,"_5":12679,"_25963":100678,"_2424":100763},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2886":60326,"_27469":60287,"_18854":100765,"_5":12679,"_25963":100678,"_2424":100766},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2886":60327,"_27469":60287,"_18854":100768,"_5":12679,"_25963":100678,"_2424":100769},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2886":60328,"_27469":60287,"_18854":100771,"_5":12679,"_25963":100678,"_2424":100772},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2886":60329,"_27469":60287,"_18854":100774,"_5":12679,"_25963":100678,"_2424":100775},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2886":60330,"_27469":60287,"_18854":100777,"_5":12679,"_25963":100678,"_2424":100778},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2886":60331,"_27469":60287,"_18854":100780,"_5":12679,"_25963":100678,"_2424":100781},[],"SMTP, observabilidad y entrega de alertas",{"_2886":60332,"_27469":60287,"_18854":100783,"_5":12679,"_25963":100678,"_2424":100784},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2886":60333,"_27469":60287,"_18854":100786,"_5":12679,"_25963":100678,"_2424":100787},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2886":60334,"_27469":60334,"_5":13057,"_2424":100789,"_27749":100790,"_18854":100791,"_25963":60334},"Expón el Gateway",[43001,100098,43108],[],{"_2886":60335,"_27469":60334,"_18854":100793,"_5":12679,"_25963":60334,"_2424":100794},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2886":60336,"_27469":60334,"_5":27746,"_18854":100796,"_25963":100797,"_2424":100798},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2886":60337,"_27469":60334,"_5":27746,"_18854":100800,"_25963":100801,"_2424":100802},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2886":60338,"_27469":60334,"_5":27746,"_18854":100804,"_25963":100805,"_2424":100806},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2886":60339,"_27469":60334,"_5":27746,"_18854":100808,"_25963":100809,"_2424":43747},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/networking#k3s",{"_2886":60340,"_27469":60334,"_5":27746,"_18854":100811,"_25963":100812,"_2424":100813},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2886":60341,"_27469":60334,"_5":27746,"_18854":100815,"_25963":100816,"_2424":100817},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2886":60342,"_27469":60334,"_5":27746,"_18854":100819,"_25963":100820,"_2424":100821},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2886":60343,"_27469":60334,"_5":27746,"_18854":100823,"_25963":100824,"_2424":100825},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2886":60344,"_27469":60334,"_5":27746,"_18854":100827,"_25963":100828,"_2424":100829},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2886":60345,"_27469":60334,"_18854":100831,"_5":12679,"_25963":100797,"_2424":100832},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2886":60346,"_27469":60334,"_18854":100834,"_5":12679,"_25963":100797,"_2424":100835},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2886":60347,"_27469":60334,"_18854":100837,"_5":12679,"_25963":100801,"_2424":100838},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2886":60348,"_27469":60334,"_18854":100840,"_5":12679,"_25963":100801,"_2424":100841},[],"Defínelo únicamente cuando:",{"_2886":60349,"_27469":60334,"_18854":100843,"_5":12679,"_25963":100801,"_2424":100844},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2886":60350,"_27469":60334,"_18854":100846,"_5":12679,"_25963":100801,"_2424":100847},[],"esa dirección está asignada a este Gateway",{"_2886":60351,"_27469":60334,"_18854":100849,"_5":12679,"_25963":100801,"_2424":100850},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2886":60352,"_27469":60334,"_18854":100852,"_5":12679,"_25963":100801,"_2424":100853},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2886":60353,"_27469":60334,"_18854":100855,"_5":12679,"_25963":100801,"_2424":100856},[],"No confundas estos valores:",{"_2886":60354,"_27469":60334,"_18854":100858,"_5":12679,"_25963":100801,"_2424":100859},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2886":60355,"_27469":60334,"_18854":100861,"_5":12679,"_25963":100801,"_2424":100862},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2886":60356,"_27469":60334,"_18854":100864,"_5":12679,"_25963":100801,"_2424":100865},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2886":60357,"_27469":60334,"_18854":100867,"_5":12679,"_25963":100805,"_2424":100868},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2886":60358,"_27469":60334,"_18854":100870,"_5":12679,"_25963":100805,"_2424":100871},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2886":60359,"_27469":60334,"_18854":100873,"_5":12679,"_25963":100809,"_2424":100874},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2886":60360,"_27469":60334,"_18854":100876,"_5":12679,"_25963":100809,"_2424":100877},[],"Para el diseño recomendado:",{"_2886":60361,"_27469":60334,"_18854":100879,"_5":12679,"_25963":100809,"_2424":100880},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2886":60362,"_27469":60334,"_18854":100882,"_5":12679,"_25963":100809,"_2424":100883},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2886":60363,"_27469":60334,"_18854":100885,"_5":12679,"_25963":100809,"_2424":100886},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2886":60364,"_27469":60334,"_18854":100888,"_5":12679,"_25963":100809,"_2424":100889},[],"Apunta DNS a la dirección accesible de la VM.",{"_2886":60365,"_27469":60334,"_18854":100891,"_5":12679,"_25963":100809,"_2424":100892},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2886":60366,"_27469":60334,"_18854":100894,"_5":12679,"_25963":100812,"_2424":100895},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2886":60367,"_27469":60334,"_18854":100897,"_5":12679,"_25963":100816,"_2424":100898},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2886":60368,"_27469":60334,"_18854":100900,"_5":12679,"_25963":100816,"_2424":100901},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2886":60369,"_27469":60334,"_18854":100903,"_5":12679,"_25963":100820,"_2424":100904},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2886":60370,"_27469":60334,"_18854":100906,"_5":12679,"_25963":100820,"_2424":100907},[],"Requisito",{"_2886":60371,"_27469":60334,"_18854":100909,"_5":12679,"_25963":100820,"_2424":100910},[],"Diseño recomendado",{"_2886":60372,"_27469":60334,"_18854":100912,"_5":12679,"_25963":100820,"_2424":100913},[],"Consecuencia",{"_2886":60373,"_27469":60334,"_18854":100915,"_5":12679,"_25963":100820,"_2424":100916},[],"Varias URL o servicios de Lamassu",{"_2886":60374,"_27469":60334,"_18854":100918,"_5":12679,"_25963":100820,"_2424":100919},[],"Un Gateway con varias rutas",{"_2886":60375,"_27469":60334,"_18854":100921,"_5":12679,"_25963":100820,"_2424":100922},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2886":60376,"_27469":60334,"_18854":100924,"_5":12679,"_25963":100820,"_2424":100925},[],"Gateways independientes e IP externas distintas",{"_2886":60377,"_27469":60334,"_18854":100927,"_5":12679,"_25963":100820,"_2424":100928},[],"Una VIP por Gateway",{"_2886":60378,"_27469":60334,"_18854":100930,"_5":12679,"_25963":100820,"_2424":100931},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2886":60379,"_27469":60334,"_18854":100933,"_5":12679,"_25963":100820,"_2424":100934},[],"Gateways independientes, un nodo y una IP",{"_2886":60380,"_27469":60334,"_18854":100936,"_5":12679,"_25963":100820,"_2424":100937},[],"Puertos externos diferentes",{"_2886":60381,"_27469":60334,"_18854":100939,"_5":12679,"_25963":100820,"_2424":100940},[],"Los clientes deben indicar puertos no estándar",{"_2886":60382,"_27469":60334,"_18854":100942,"_5":12679,"_25963":100820,"_2424":100943},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2886":60383,"_27469":60334,"_18854":100945,"_5":12679,"_25963":100820,"_2424":100946},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2886":60384,"_27469":60334,"_18854":100948,"_5":12679,"_25963":100820,"_2424":100949},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2886":60385,"_27469":60334,"_18854":100951,"_5":12679,"_25963":100820,"_2424":100952},[],"Recursos Gateway separados pero proxy compartido",{"_2886":60386,"_27469":60334,"_18854":100954,"_5":12679,"_25963":100820,"_2424":100955},[],"Modo merged Gateway de Envoy",{"_2886":60387,"_27469":60334,"_18854":100957,"_5":12679,"_25963":100820,"_2424":100958},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2886":60388,"_27469":60334,"_18854":100960,"_5":12679,"_25963":100820,"_2424":100961},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2886":60389,"_27469":60334,"_18854":100963,"_5":12679,"_25963":100820,"_2424":100964},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2886":60390,"_27469":60334,"_18854":100966,"_5":12679,"_25963":100820,"_2424":100967},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2886":60391,"_27469":60334,"_18854":100969,"_5":12679,"_25963":100820,"_2424":100970},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2886":60392,"_27469":60334,"_18854":100972,"_5":12679,"_25963":100824,"_2424":100973},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2886":60393,"_27469":60334,"_18854":100975,"_5":12679,"_25963":100824,"_2424":100976},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2886":60394,"_27469":60334,"_18854":100978,"_5":12679,"_25963":100824,"_2424":100979},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2886":60395,"_27469":60334,"_18854":100981,"_5":12679,"_25963":100824,"_2424":100982},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2886":60396,"_27469":60334,"_18854":100984,"_5":12679,"_25963":100824,"_2424":100985},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2886":60397,"_27469":60334,"_18854":100987,"_5":12679,"_25963":100828,"_2424":100988},[],"Comprueba, en orden:",{"_2886":60398,"_27469":60334,"_18854":100990,"_5":12679,"_25963":100828,"_2424":100991},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2886":60399,"_27469":60334,"_18854":100993,"_5":12679,"_25963":100828,"_2424":100994},[],"Su estado contiene la dirección esperada.",{"_2886":60400,"_27469":60334,"_18854":100996,"_5":12679,"_25963":100828,"_2424":100997},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2886":60401,"_27469":60334,"_18854":100999,"_5":12679,"_25963":100828,"_2424":101000},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2886":60402,"_27469":60334,"_18854":101002,"_5":12679,"_25963":100828,"_2424":101003},[],"DNS resuelve al endpoint accesible externamente.",{"_2886":60403,"_27469":60334,"_18854":101005,"_5":12679,"_25963":100828,"_2424":101006},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2886":60404,"_27469":60334,"_18854":101008,"_5":12679,"_25963":100828,"_2424":101009},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2886":60405,"_27469":60405,"_5":13057,"_2424":43108,"_27749":101011,"_18854":101012,"_25963":60405},[43001,100098,43108],[],{"_2886":60406,"_27469":60405,"_18854":101014,"_5":12679,"_25963":60405,"_2424":101015},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2886":60407,"_27469":60405,"_5":27746,"_18854":101017,"_25963":101018,"_2424":101019},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2886":60408,"_27469":60405,"_5":27746,"_18854":101021,"_25963":101022,"_2424":101023},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2886":60409,"_27469":60405,"_5":27746,"_18854":101025,"_25963":101026,"_2424":101027},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2886":60410,"_27469":60405,"_5":27746,"_18854":101029,"_25963":101030,"_2424":101031},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2886":60411,"_27469":60405,"_5":27746,"_18854":101033,"_25963":101034,"_2424":101035},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2886":60412,"_27469":60405,"_5":27746,"_18854":101037,"_25963":101038,"_2424":101039},[],"/docs/pr-preview/pr-24/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2886":60413,"_27469":60405,"_18854":101041,"_5":12679,"_25963":101018,"_2424":101042},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2886":60414,"_27469":60405,"_18854":101044,"_5":12679,"_25963":101022,"_2424":101045},[],"Flujo",{"_2886":60415,"_27469":60405,"_18854":101047,"_5":12679,"_25963":101022,"_2424":101048},[],"Úsalo para",{"_2886":60416,"_27469":60405,"_18854":101050,"_5":12679,"_25963":101022,"_2424":101051},[],"Qué instala",{"_2886":60417,"_27469":60405,"_18854":101053,"_5":12679,"_25963":101022,"_2424":43992},[],{"_2886":60418,"_27469":60405,"_18854":101055,"_5":12679,"_25963":101022,"_2424":101056},[],"Producción y entornos controlados",{"_2886":60419,"_27469":60405,"_18854":101058,"_5":12679,"_25963":101022,"_2424":101059},[],"Servicios de Lamassu y recursos de Gateway API",{"_2886":60420,"_27469":60405,"_18854":101061,"_5":12679,"_25963":101022,"_2424":43245},[],{"_2886":60421,"_27469":60405,"_18854":101063,"_5":12679,"_25963":101022,"_2424":101064},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2886":60422,"_27469":60405,"_18854":101066,"_5":12679,"_25963":101022,"_2424":101067},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2886":60423,"_27469":60405,"_18854":101069,"_5":12679,"_25963":101026,"_2424":101070},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2886":60424,"_27469":60405,"_18854":101072,"_5":12679,"_25963":101026,"_2424":101073},[],"Área",{"_2886":60425,"_27469":60405,"_18854":101075,"_5":12679,"_25963":101026,"_2424":101076},[],"El chart de Lamassu proporciona",{"_2886":60426,"_27469":60405,"_18854":101078,"_5":12679,"_25963":101026,"_2424":101079},[],"Tú proporcionas",{"_2886":60427,"_27469":60405,"_18854":101081,"_5":12679,"_25963":101026,"_2424":101082},[],"Aplicaciones Lamassu",{"_2886":60428,"_27469":60405,"_18854":101084,"_5":12679,"_25963":101026,"_2424":101085},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2886":60429,"_27469":60405,"_18854":101087,"_5":12679,"_25963":101026,"_2424":101088},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2886":60430,"_27469":60405,"_18854":101090,"_5":12679,"_25963":101026,"_2424":101091},[],"Datos PostgreSQL",{"_2886":60431,"_27469":60405,"_18854":101093,"_5":12679,"_25963":101026,"_2424":101094},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2886":60432,"_27469":60405,"_18854":101096,"_5":12679,"_25963":101026,"_2424":101097},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2886":60433,"_27469":60405,"_18854":101099,"_5":12679,"_25963":101026,"_2424":101100},[],"Mensajería",{"_2886":60434,"_27469":60405,"_18854":101102,"_5":12679,"_25963":101026,"_2424":101103},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2886":60435,"_27469":60405,"_18854":101105,"_5":12679,"_25963":101026,"_2424":101106},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2886":60436,"_27469":60405,"_18854":101108,"_5":12679,"_25963":101026,"_2424":101109},[],"Identidad",{"_2886":60437,"_27469":60405,"_18854":101111,"_5":12679,"_25963":101026,"_2424":101112},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2886":60438,"_27469":60405,"_18854":101114,"_5":12679,"_25963":101026,"_2424":101115},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2886":60439,"_27469":60405,"_18854":101117,"_5":12679,"_25963":101026,"_2424":101118},[],"Enrutamiento externo",{"_2886":60440,"_27469":60405,"_18854":101120,"_5":12679,"_25963":101026,"_2424":101121},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2886":60441,"_27469":60405,"_18854":101123,"_5":12679,"_25963":101026,"_2424":101124},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2886":60442,"_27469":60405,"_18854":101126,"_5":12679,"_25963":101026,"_2424":44066},[],{"_2886":60443,"_27469":60405,"_18854":101128,"_5":12679,"_25963":101026,"_2424":101129},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2886":60444,"_27469":60405,"_18854":101131,"_5":12679,"_25963":101026,"_2424":101132},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2886":60445,"_27469":60405,"_18854":101134,"_5":12679,"_25963":101026,"_2424":101135},[],"Datos persistentes de la aplicación",{"_2886":60446,"_27469":60405,"_18854":101137,"_5":12679,"_25963":101026,"_2424":101138},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2886":60447,"_27469":60405,"_18854":101140,"_5":12679,"_25963":101026,"_2424":101141},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2886":60448,"_27469":60405,"_18854":101143,"_5":12679,"_25963":101026,"_2424":101144},[],"Integraciones opcionales",{"_2886":60449,"_27469":60405,"_18854":101146,"_5":12679,"_25963":101026,"_2424":101147},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2886":60450,"_27469":60405,"_18854":101149,"_5":12679,"_25963":101026,"_2424":101150},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2886":60451,"_27469":60405,"_18854":101152,"_5":12679,"_25963":101026,"_2424":101153},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2886":60452,"_27469":60405,"_18854":101155,"_5":12679,"_25963":101026,"_2424":101156},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2886":60453,"_27469":60405,"_18854":101158,"_5":12679,"_25963":101030,"_2424":101159},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2886":60454,"_27469":60405,"_18854":101161,"_5":12679,"_25963":101030,"_2424":101162},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2886":60455,"_27469":60405,"_18854":101164,"_5":12679,"_25963":101034,"_2424":101165},[],"Kubernetes 1.24 o posterior",{"_2886":60456,"_27469":60405,"_18854":101167,"_5":12679,"_25963":101034,"_2424":101168},[],"Helm 3.2 o posterior",{"_2886":60457,"_27469":60405,"_18854":101170,"_5":12679,"_25963":101034,"_2424":101171},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2886":60458,"_27469":60405,"_18854":101173,"_5":12679,"_25963":101034,"_2424":101174},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2886":60459,"_27469":60405,"_18854":101176,"_5":12679,"_25963":101034,"_2424":101177},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2886":60460,"_27469":60405,"_18854":101179,"_5":12679,"_25963":101034,"_2424":101180},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2886":60461,"_27469":60405,"_18854":101182,"_5":12679,"_25963":101034,"_2424":101183},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2886":60462,"_27469":60405,"_18854":101185,"_5":12679,"_25963":101038,"_2424":101186},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2886":60463,"_27469":60405,"_18854":101188,"_5":12679,"_25963":101038,"_2424":101189},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2886":60464,"_27469":60405,"_18854":101191,"_5":12679,"_25963":101038,"_2424":101192},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2886":60465,"_27469":60465,"_5":13057,"_2424":101194,"_27749":101195,"_18854":101198,"_25963":60465},"Control de acceso",[43001,101196,101197],"Plataforma","Administrar Lamassu",[],{"_2886":60466,"_27469":60465,"_18854":101200,"_5":12679,"_25963":60465,"_2424":101201},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2886":60467,"_27469":60465,"_5":27746,"_18854":101203,"_25963":101204,"_2424":101205},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#conceptos-esenciales","Conceptos esenciales",{"_2886":60468,"_27469":60465,"_5":27746,"_18854":101207,"_25963":101208,"_2424":101209},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2886":60469,"_27469":60465,"_5":27746,"_18854":101211,"_25963":101212,"_2424":101213},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2886":60470,"_27469":60465,"_5":27746,"_18854":101215,"_25963":101216,"_2424":101217},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2886":60471,"_27469":60465,"_5":27746,"_18854":101219,"_25963":101220,"_2424":101221},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2886":60472,"_27469":60465,"_5":27746,"_18854":101223,"_25963":101224,"_2424":101225},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#principales-oidc","Principales OIDC",{"_2886":60473,"_27469":60465,"_5":27746,"_18854":101227,"_25963":101228,"_2424":101229},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#principales-x509","Principales X.509",{"_2886":60474,"_27469":60465,"_5":27746,"_18854":101231,"_25963":101232,"_2424":101233},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2886":60475,"_27469":60465,"_5":27746,"_18854":101235,"_25963":101236,"_2424":101237},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2886":60476,"_27469":60465,"_5":27746,"_18854":101239,"_25963":101240,"_2424":101241},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2886":60477,"_27469":60465,"_5":27746,"_18854":101243,"_25963":101244,"_2424":101245},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2886":60478,"_27469":60465,"_5":27746,"_18854":101247,"_25963":101248,"_2424":101249},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2886":60479,"_27469":60465,"_5":27746,"_18854":101251,"_25963":101252,"_2424":101253},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#reglas-http","Reglas HTTP",{"_2886":60480,"_27469":60465,"_5":27746,"_18854":101255,"_25963":101256,"_2424":101257},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#políticas-incluidas","Políticas incluidas",{"_2886":60481,"_27469":60465,"_5":27746,"_18854":101259,"_25963":101260,"_2424":100667},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#provisiona-el-primer-administrador",{"_2886":60482,"_27469":60465,"_5":27746,"_18854":101262,"_25963":101263,"_2424":101264},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2886":60483,"_27469":60465,"_5":27746,"_18854":101266,"_25963":101267,"_2424":101268},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2886":60484,"_27469":60465,"_5":27746,"_18854":101270,"_25963":101271,"_2424":101272},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2886":60485,"_27469":60465,"_5":27746,"_18854":101274,"_25963":101275,"_2424":101276},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2886":60486,"_27469":60465,"_5":27746,"_18854":101278,"_25963":101279,"_2424":101280},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2886":60487,"_27469":60465,"_5":27746,"_18854":101282,"_25963":101283,"_2424":101284},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2886":60488,"_27469":60465,"_5":27746,"_18854":101286,"_25963":101287,"_2424":101288},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2886":60489,"_27469":60465,"_5":27746,"_18854":101290,"_25963":101291,"_2424":101292},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2886":60490,"_27469":60465,"_5":27746,"_18854":101294,"_25963":101295,"_2424":101296},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2886":60491,"_27469":60465,"_5":27746,"_18854":101298,"_25963":101299,"_2424":101300},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#diagnóstico","Diagnóstico",{"_2886":60492,"_27469":60465,"_5":27746,"_18854":101302,"_25963":101303,"_2424":101304},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#la-respuesta-es-401","La respuesta es 401",{"_2886":60493,"_27469":60465,"_5":27746,"_18854":101306,"_25963":101307,"_2424":101308},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#la-respuesta-es-403","La respuesta es 403",{"_2886":60494,"_27469":60465,"_5":27746,"_18854":101310,"_25963":101311,"_2424":101312},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#todo-devuelve-403","Todo devuelve 403",{"_2886":60495,"_27469":60465,"_5":27746,"_18854":101314,"_25963":101315,"_2424":101316},[],"/docs/pr-preview/pr-24/es/platform/pki/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2886":60496,"_27469":60465,"_18854":101318,"_5":12679,"_25963":60465,"_2424":101319},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2886":60497,"_27469":60465,"_18854":101321,"_5":12679,"_25963":60465,"_2424":101322},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2886":60498,"_27469":60465,"_18854":101324,"_5":12679,"_25963":60465,"_2424":101325},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2886":60499,"_27469":60465,"_18854":101327,"_5":12679,"_25963":101204,"_2424":101328},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2886":60500,"_27469":60465,"_18854":101330,"_5":12679,"_25963":101204,"_2424":101331},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2886":60501,"_27469":60465,"_18854":101333,"_5":12679,"_25963":101204,"_2424":101334},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2886":60502,"_27469":60465,"_18854":101336,"_5":12679,"_25963":101204,"_2424":101337},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2886":60503,"_27469":60465,"_18854":101339,"_5":12679,"_25963":101204,"_2424":101340},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2886":60504,"_27469":60465,"_18854":101342,"_5":12679,"_25963":101204,"_2424":101343},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y alguna de sus políticas debe permitir la operación solicitada.",{"_2886":60505,"_27469":60465,"_18854":101345,"_5":12679,"_25963":101208,"_2424":101346},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2886":60506,"_27469":60465,"_18854":101348,"_5":12679,"_25963":101208,"_2424":101349},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2886":60507,"_27469":60465,"_18854":101351,"_5":12679,"_25963":101212,"_2424":101352},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2886":60508,"_27469":60465,"_18854":101354,"_5":12679,"_25963":101212,"_2424":101355},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2886":60509,"_27469":60465,"_18854":101357,"_5":12679,"_25963":101212,"_2424":101358},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2886":60510,"_27469":60465,"_18854":101360,"_5":12679,"_25963":101212,"_2424":101361},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2886":60511,"_27469":60465,"_18854":101363,"_5":12679,"_25963":101212,"_2424":101364},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2886":60512,"_27469":60465,"_18854":101366,"_5":12679,"_25963":101212,"_2424":101367},[],"Carga por separado las políticas concedidas a cada principal.",{"_2886":60513,"_27469":60465,"_18854":101369,"_5":12679,"_25963":101212,"_2424":101370},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2886":60514,"_27469":60465,"_18854":101372,"_5":12679,"_25963":101212,"_2424":101373},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2886":60515,"_27469":60465,"_18854":101375,"_5":12679,"_25963":101212,"_2424":101376},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política.",{"_2886":60516,"_27469":60465,"_18854":101378,"_5":12679,"_25963":101212,"_2424":101379},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2886":60517,"_27469":60465,"_18854":101381,"_5":12679,"_25963":101212,"_2424":101382},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en `x-current-user`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2886":60518,"_27469":60465,"_18854":101384,"_5":12679,"_25963":101212,"_2424":101385},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, el esquema debe declarar una restricción que relacione un valor de la petición con un atributo normalizado del principal.",{"_2886":60519,"_27469":60465,"_18854":101387,"_5":12679,"_25963":101216,"_2424":101388},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2886":60520,"_27469":60465,"_18854":101390,"_5":12679,"_25963":101216,"_2424":101391},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2886":60521,"_27469":60465,"_18854":101393,"_5":12679,"_25963":101216,"_2424":101394},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2886":60522,"_27469":60465,"_18854":101396,"_5":12679,"_25963":101216,"_2424":101397},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2886":60523,"_27469":60465,"_18854":101399,"_5":12679,"_25963":101216,"_2424":101400},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2886":60524,"_27469":60465,"_18854":101402,"_5":12679,"_25963":101216,"_2424":101403},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2886":60525,"_27469":60465,"_18854":101405,"_5":12679,"_25963":101216,"_2424":101406},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2886":60526,"_27469":60465,"_18854":101408,"_5":12679,"_25963":101216,"_2424":101409},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2886":60527,"_27469":60465,"_18854":101411,"_5":12679,"_25963":101216,"_2424":101412},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2886":60528,"_27469":60465,"_18854":101414,"_5":12679,"_25963":101216,"_2424":101415},[],"Las acciones se dividen en dos grupos:",{"_2886":60529,"_27469":60465,"_18854":101417,"_5":12679,"_25963":101216,"_2424":101418},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2886":60530,"_27469":60465,"_18854":101420,"_5":12679,"_25963":101216,"_2424":101421},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2886":60531,"_27469":60465,"_18854":101423,"_5":12679,"_25963":101216,"_2424":101424},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2886":60532,"_27469":60465,"_18854":101426,"_5":12679,"_25963":101220,"_2424":101427},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2886":60533,"_27469":60465,"_18854":101429,"_5":12679,"_25963":101220,"_2424":101430},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2886":60534,"_27469":60465,"_18854":101432,"_5":12679,"_25963":101220,"_2424":101433},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega. Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2886":60535,"_27469":60465,"_18854":101435,"_5":12679,"_25963":101224,"_2424":101436},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2886":60536,"_27469":60465,"_18854":101438,"_5":12679,"_25963":101224,"_2424":101439},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2886":60537,"_27469":60465,"_18854":101441,"_5":12679,"_25963":101224,"_2424":101442},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2886":60538,"_27469":60465,"_18854":101444,"_5":12679,"_25963":101224,"_2424":101445},[],"Los operadores implementados son:",{"_2886":60539,"_27469":60465,"_18854":101447,"_5":12679,"_25963":101224,"_2424":101448},[],"`equals`, para igualdad exacta;",{"_2886":60540,"_27469":60465,"_18854":101450,"_5":12679,"_25963":101224,"_2424":101451},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2886":60541,"_27469":60465,"_18854":101453,"_5":12679,"_25963":101224,"_2424":101454},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2886":60542,"_27469":60465,"_18854":101456,"_5":12679,"_25963":101224,"_2424":101457},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2886":60543,"_27469":60465,"_18854":101459,"_5":12679,"_25963":101228,"_2424":101460},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2886":60544,"_27469":60465,"_18854":101462,"_5":12679,"_25963":101228,"_2424":101463},[],"Los modos disponibles son:",{"_2886":60545,"_27469":60465,"_18854":101465,"_5":12679,"_25963":101228,"_2424":101466},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2886":60546,"_27469":60465,"_18854":101468,"_5":12679,"_25963":101228,"_2424":101469},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2886":60547,"_27469":60465,"_18854":101471,"_5":12679,"_25963":101228,"_2424":101472},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2886":60548,"_27469":60465,"_18854":101474,"_5":12679,"_25963":101228,"_2424":101475},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2886":60549,"_27469":60465,"_18854":101477,"_5":12679,"_25963":101228,"_2424":101478},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2886":60550,"_27469":60465,"_18854":101480,"_5":12679,"_25963":101228,"_2424":101481},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2886":60551,"_27469":60465,"_18854":101483,"_5":12679,"_25963":101232,"_2424":101484},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2886":60552,"_27469":60465,"_18854":101486,"_5":12679,"_25963":101232,"_2424":101487},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2886":60553,"_27469":60465,"_18854":101489,"_5":12679,"_25963":101232,"_2424":101490},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2886":60554,"_27469":60465,"_18854":101492,"_5":12679,"_25963":101232,"_2424":101493},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2886":60555,"_27469":60465,"_18854":101495,"_5":12679,"_25963":101240,"_2424":101496},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2886":60556,"_27469":60465,"_18854":101498,"_5":12679,"_25963":101240,"_2424":101499},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2886":60557,"_27469":60465,"_18854":101501,"_5":12679,"_25963":101244,"_2424":101502},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2886":60558,"_27469":60465,"_18854":101504,"_5":12679,"_25963":101244,"_2424":101505},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2886":60559,"_27469":60465,"_18854":101507,"_5":12679,"_25963":101248,"_2424":101508},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2886":60560,"_27469":60465,"_18854":101510,"_5":12679,"_25963":101248,"_2424":101511},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2886":60561,"_27469":60465,"_18854":101513,"_5":12679,"_25963":101248,"_2424":101514},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2886":60562,"_27469":60465,"_18854":101516,"_5":12679,"_25963":101252,"_2424":101517},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2886":60563,"_27469":60465,"_18854":101519,"_5":12679,"_25963":101252,"_2424":101520},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2886":60564,"_27469":60465,"_18854":101522,"_5":12679,"_25963":101252,"_2424":101523},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2886":60565,"_27469":60465,"_18854":101525,"_5":12679,"_25963":101256,"_2424":101526},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2886":60566,"_27469":60465,"_18854":101528,"_5":12679,"_25963":101256,"_2424":101529},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2886":60567,"_27469":60465,"_18854":101531,"_5":12679,"_25963":101256,"_2424":101532},[],"acceso completo y de solo lectura a KMS;",{"_2886":60568,"_27469":60465,"_18854":101534,"_5":12679,"_25963":101256,"_2424":101535},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2886":60569,"_27469":60465,"_18854":101537,"_5":12679,"_25963":101256,"_2424":101538},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2886":60570,"_27469":60465,"_18854":101540,"_5":12679,"_25963":101256,"_2424":101541},[],"acceso a la interfaz;",{"_2886":60571,"_27469":60465,"_18854":101543,"_5":12679,"_25963":101256,"_2424":101544},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2886":60572,"_27469":60465,"_18854":101546,"_5":12679,"_25963":101256,"_2424":101547},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2886":60573,"_27469":60465,"_18854":101549,"_5":12679,"_25963":101256,"_2424":101550},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2886":60574,"_27469":60465,"_18854":101552,"_5":12679,"_25963":101260,"_2424":101553},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2886":60575,"_27469":60465,"_18854":101555,"_5":12679,"_25963":101260,"_2424":101556},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2886":60576,"_27469":60465,"_18854":101558,"_5":12679,"_25963":101260,"_2424":101559},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2886":60577,"_27469":60465,"_18854":101561,"_5":12679,"_25963":101263,"_2424":101562},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2886":60578,"_27469":60465,"_18854":101564,"_5":12679,"_25963":101267,"_2424":101565},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2886":60579,"_27469":60465,"_18854":101567,"_5":12679,"_25963":101271,"_2424":101568},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2886":60580,"_27469":60465,"_18854":101570,"_5":12679,"_25963":101275,"_2424":101571},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2886":60581,"_27469":60465,"_18854":101573,"_5":12679,"_25963":101279,"_2424":101574},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2886":60582,"_27469":60465,"_18854":101576,"_5":12679,"_25963":101283,"_2424":101577},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2886":60583,"_27469":60465,"_18854":101579,"_5":12679,"_25963":101283,"_2424":101580},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2886":60584,"_27469":60465,"_18854":101582,"_5":12679,"_25963":101287,"_2424":101583},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2886":60585,"_27469":60465,"_18854":101585,"_5":12679,"_25963":101287,"_2424":101586},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2886":60586,"_27469":60465,"_18854":101588,"_5":12679,"_25963":101287,"_2424":101589},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2886":60587,"_27469":60465,"_18854":101591,"_5":12679,"_25963":101287,"_2424":101592},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2886":60588,"_27469":60465,"_18854":101594,"_5":12679,"_25963":101287,"_2424":101595},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2886":60589,"_27469":60465,"_18854":101597,"_5":12679,"_25963":101287,"_2424":101598},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2886":60590,"_27469":60465,"_18854":101600,"_5":12679,"_25963":101287,"_2424":101601},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2886":60591,"_27469":60465,"_18854":101603,"_5":12679,"_25963":101287,"_2424":101604},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2886":60592,"_27469":60465,"_18854":101606,"_5":12679,"_25963":101291,"_2424":101607},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2886":60593,"_27469":60465,"_18854":101609,"_5":12679,"_25963":101291,"_2424":101610},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2886":60594,"_27469":60465,"_18854":101612,"_5":12679,"_25963":101291,"_2424":101613},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2886":60595,"_27469":60465,"_18854":101615,"_5":12679,"_25963":101295,"_2424":101616},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2886":60596,"_27469":60465,"_18854":101618,"_5":12679,"_25963":101295,"_2424":101619},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2886":60597,"_27469":60465,"_18854":101621,"_5":12679,"_25963":101295,"_2424":101622},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2886":60598,"_27469":60465,"_18854":101624,"_5":12679,"_25963":101295,"_2424":101625},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2886":60599,"_27469":60465,"_18854":101627,"_5":12679,"_25963":101295,"_2424":101628},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2886":60600,"_27469":60465,"_18854":101630,"_5":12679,"_25963":101295,"_2424":101631},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2886":60601,"_27469":60465,"_18854":101633,"_5":12679,"_25963":101295,"_2424":101634},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2886":60602,"_27469":60465,"_18854":101636,"_5":12679,"_25963":101303,"_2424":101637},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2886":60603,"_27469":60465,"_18854":101639,"_5":12679,"_25963":101307,"_2424":101640},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2886":60604,"_27469":60465,"_18854":101642,"_5":12679,"_25963":101307,"_2424":101643},[],"que exista un principal activo del tipo correcto;",{"_2886":60605,"_27469":60465,"_18854":101645,"_5":12679,"_25963":101307,"_2424":101646},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2886":60606,"_27469":60465,"_18854":101648,"_5":12679,"_25963":101307,"_2424":101649},[],"que todas las condiciones del principal se cumplan;",{"_2886":60607,"_27469":60465,"_18854":101651,"_5":12679,"_25963":101307,"_2424":101652},[],"que el principal tenga concedida la política esperada;",{"_2886":60608,"_27469":60465,"_18854":101654,"_5":12679,"_25963":101307,"_2424":101655},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2886":60609,"_27469":60465,"_18854":101657,"_5":12679,"_25963":101307,"_2424":101658},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2886":60610,"_27469":60465,"_18854":101660,"_5":12679,"_25963":101307,"_2424":101661},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos.",{"_2886":60611,"_27469":60465,"_18854":101663,"_5":12679,"_25963":101311,"_2424":101664},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2886":60612,"_27469":60465,"_18854":101666,"_5":12679,"_25963":101315,"_2424":101667},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2886":60613,"_27469":60465,"_18854":101669,"_5":12679,"_25963":101315,"_2424":101670},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2886":60614,"_27469":60614,"_5":13057,"_2424":101672,"_27749":101673,"_18854":101675,"_25963":60614},"Alertas y suscripciones",[43001,101196,101674],"Operar Lamassu",[],{"_2886":60615,"_27469":60614,"_18854":101677,"_5":12679,"_25963":60614,"_2424":101678},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2886":60616,"_27469":60614,"_5":27746,"_18854":101680,"_25963":101681,"_2424":101682},[],"/docs/pr-preview/pr-24/es/platform/pki/alerts#cómo-funciona","Cómo funciona",{"_2886":60617,"_27469":60614,"_5":27746,"_18854":101684,"_25963":101685,"_2424":101686},[],"/docs/pr-preview/pr-24/es/platform/pki/alerts#canales-disponibles","Canales disponibles",{"_2886":60618,"_27469":60614,"_5":27746,"_18854":101688,"_25963":101689,"_2424":101690},[],"/docs/pr-preview/pr-24/es/platform/pki/alerts#crea-una-suscripción","Crea una suscripción",{"_2886":60619,"_27469":60614,"_5":27746,"_18854":101692,"_25963":101693,"_2424":101694},[],"/docs/pr-preview/pr-24/es/platform/pki/alerts#elige-el-evento","Elige el evento",{"_2886":60620,"_27469":60614,"_5":27746,"_18854":101696,"_25963":101697,"_2424":101698},[],"/docs/pr-preview/pr-24/es/platform/pki/alerts#configura-el-destino","Configura el destino",{"_2886":60621,"_27469":60614,"_5":27746,"_18854":101700,"_25963":101701,"_2424":101702},[],"/docs/pr-preview/pr-24/es/platform/pki/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2886":60622,"_27469":60614,"_5":27746,"_18854":101704,"_25963":101705,"_2424":101706},[],"/docs/pr-preview/pr-24/es/platform/pki/alerts#revisa-y-activa","Revisa y activa",{"_2886":60623,"_27469":60614,"_5":27746,"_18854":101708,"_25963":101709,"_2424":101710},[],"/docs/pr-preview/pr-24/es/platform/pki/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2886":60624,"_27469":60614,"_5":27746,"_18854":101712,"_25963":101713,"_2424":101714},[],"/docs/pr-preview/pr-24/es/platform/pki/alerts#familias-de-eventos","Familias de eventos",{"_2886":60625,"_27469":60614,"_18854":101716,"_5":12679,"_25963":60614,"_2424":101717},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2886":60626,"_27469":60614,"_18854":101719,"_5":12679,"_25963":101681,"_2424":101720},[],"Un servicio publica un evento de dominio.",{"_2886":60627,"_27469":60614,"_18854":101722,"_5":12679,"_25963":101681,"_2424":101723},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2886":60628,"_27469":60614,"_18854":101725,"_5":12679,"_25963":101681,"_2424":101726},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2886":60629,"_27469":60614,"_18854":101728,"_5":12679,"_25963":101681,"_2424":101729},[],"Lamassu entrega el evento al canal configurado.",{"_2886":60630,"_27469":60614,"_18854":101731,"_5":12679,"_25963":101681,"_2424":101732},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2886":60631,"_27469":60614,"_18854":101734,"_5":12679,"_25963":101685,"_2424":101735},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_2886":60632,"_27469":60614,"_18854":101737,"_5":12679,"_25963":101685,"_2424":101738},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2886":60633,"_27469":60614,"_18854":101740,"_5":12679,"_25963":101685,"_2424":101741},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2886":60634,"_27469":60614,"_18854":101743,"_5":12679,"_25963":101693,"_2424":101744},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2886":60635,"_27469":60614,"_18854":101746,"_5":12679,"_25963":101697,"_2424":101747},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2886":60636,"_27469":60614,"_18854":101749,"_5":12679,"_25963":101701,"_2424":101750},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2886":60637,"_27469":60614,"_18854":101752,"_5":12679,"_25963":101701,"_2424":101753},[],"**None** notifica todas las instancias del evento.",{"_2886":60638,"_27469":60614,"_18854":101755,"_5":12679,"_25963":101701,"_2424":101756},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2886":60639,"_27469":60614,"_18854":101758,"_5":12679,"_25963":101701,"_2424":101759},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2886":60640,"_27469":60614,"_18854":101761,"_5":12679,"_25963":101701,"_2424":101762},[],"**JavaScript** permite expresar lógica personalizada.",{"_2886":60641,"_27469":60614,"_18854":101764,"_5":12679,"_25963":101701,"_2424":101765},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2886":60642,"_27469":60614,"_18854":101767,"_5":12679,"_25963":101705,"_2424":101768},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2886":60643,"_27469":60614,"_18854":101770,"_5":12679,"_25963":101709,"_2424":101771},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2886":60644,"_27469":60614,"_18854":101773,"_5":12679,"_25963":101713,"_2424":101774},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2886":60645,"_27469":60614,"_18854":101776,"_5":12679,"_25963":101713,"_2424":101777},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2886":60646,"_27469":60614,"_18854":101779,"_5":12679,"_25963":101713,"_2424":101780},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_2886":60647,"_27469":60614,"_18854":101782,"_5":12679,"_25963":101713,"_2424":101783},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2886":60648,"_27469":60614,"_18854":101785,"_5":12679,"_25963":101713,"_2424":101786},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2886":60649,"_27469":60614,"_18854":101788,"_5":12679,"_25963":101713,"_2424":101789},[],"**Validación:** `va.role.crl.create`.",{"_2886":60650,"_27469":60614,"_18854":101791,"_5":12679,"_25963":101713,"_2424":101792},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_2886":60651,"_27469":60614,"_18854":101794,"_5":12679,"_25963":101713,"_2424":101795},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2886":60652,"_27469":60652,"_5":13057,"_2424":101797,"_27749":101798,"_18854":101799,"_25963":60652},"Registros de auditoría",[43001,101196,101197],[],{"_2886":60653,"_27469":60652,"_18854":101801,"_5":12679,"_25963":60652,"_2424":101802},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2886":60654,"_27469":60652,"_5":27746,"_18854":101804,"_25963":101805,"_2424":101806},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2886":60655,"_27469":60652,"_5":27746,"_18854":101808,"_25963":101809,"_2424":101810},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#cobertura","Cobertura",{"_2886":60656,"_27469":60652,"_5":27746,"_18854":101812,"_25963":101813,"_2424":101814},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2886":60657,"_27469":60652,"_5":27746,"_18854":101816,"_25963":101817,"_2424":101818},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#datos-sensibles","Datos sensibles",{"_2886":60658,"_27469":60652,"_5":27746,"_18854":101820,"_25963":101821,"_2424":101822},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2886":60659,"_27469":60652,"_5":27746,"_18854":101824,"_25963":101825,"_2424":101826},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2886":60660,"_27469":60652,"_5":27746,"_18854":101828,"_25963":101829,"_2424":101830},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#identifica-la-operación","Identifica la operación",{"_2886":60661,"_27469":60652,"_5":27746,"_18854":101832,"_25963":101833,"_2424":101834},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2886":60662,"_27469":60652,"_5":27746,"_18854":101836,"_25963":101837,"_2424":101838},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2886":60663,"_27469":60652,"_5":27746,"_18854":101840,"_25963":101841,"_2424":101842},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2886":60664,"_27469":60652,"_5":27746,"_18854":101844,"_25963":101845,"_2424":101846},[],"/docs/pr-preview/pr-24/es/platform/pki/audit-logs#verificación-periódica","Verificación periódica",{"_2886":60665,"_27469":60652,"_18854":101848,"_5":12679,"_25963":60652,"_2424":101849},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2886":60666,"_27469":60652,"_18854":101851,"_5":12679,"_25963":101805,"_2424":101852},[],"El cuerpo de auditoría incluye:",{"_2886":60667,"_27469":60652,"_18854":101854,"_5":12679,"_25963":101805,"_2424":101855},[],"input: datos recibidos por la operación;",{"_2886":60668,"_27469":60652,"_18854":101857,"_5":12679,"_25963":101805,"_2424":101858},[],"has\\_error: indica si el servicio devolvió un error;",{"_2886":60669,"_27469":60652,"_18854":101860,"_5":12679,"_25963":101805,"_2424":101861},[],"output: resultado producido o mensaje de error;",{"_2886":60670,"_27469":60652,"_18854":101863,"_5":12679,"_25963":101805,"_2424":101864},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2886":60671,"_27469":60652,"_18854":101866,"_5":12679,"_25963":101805,"_2424":101867},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2886":60672,"_27469":60652,"_18854":101869,"_5":12679,"_25963":101805,"_2424":101870},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2886":60673,"_27469":60652,"_18854":101872,"_5":12679,"_25963":101809,"_2424":101873},[],"El backend aplica auditoría a mutaciones de:",{"_2886":60674,"_27469":60652,"_18854":101875,"_5":12679,"_25963":101809,"_2424":101876},[],"autoridades, certificados y perfiles de emisión;",{"_2886":60675,"_27469":60652,"_18854":101878,"_5":12679,"_25963":101809,"_2424":101879},[],"claves y motores KMS;",{"_2886":60676,"_27469":60652,"_18854":101881,"_5":12679,"_25963":101809,"_2424":101882},[],"dispositivos e identidades;",{"_2886":60677,"_27469":60652,"_18854":101884,"_5":12679,"_25963":101809,"_2424":101885},[],"DMS y operaciones de enrolamiento;",{"_2886":60678,"_27469":60652,"_18854":101887,"_5":12679,"_25963":101809,"_2424":101888},[],"funciones de validación y CRL;",{"_2886":60679,"_27469":60652,"_18854":101890,"_5":12679,"_25963":101809,"_2424":101891},[],"principales, políticas y concesiones de autorización.",{"_2886":60680,"_27469":60652,"_18854":101893,"_5":12679,"_25963":101809,"_2424":101894},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2886":60681,"_27469":60652,"_18854":101896,"_5":12679,"_25963":101813,"_2424":101897},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2886":60682,"_27469":60652,"_18854":101899,"_5":12679,"_25963":101813,"_2424":101900},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2886":60683,"_27469":60652,"_18854":101902,"_5":12679,"_25963":101813,"_2424":101903},[],"Diseña el consumidor para:",{"_2886":60684,"_27469":60652,"_18854":101905,"_5":12679,"_25963":101813,"_2424":101906},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2886":60685,"_27469":60652,"_18854":101908,"_5":12679,"_25963":101813,"_2424":101909},[],"conservar el CloudEvent completo sin modificar;",{"_2886":60686,"_27469":60652,"_18854":101911,"_5":12679,"_25963":101813,"_2424":101912},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2886":60687,"_27469":60652,"_18854":101914,"_5":12679,"_25963":101813,"_2424":101915},[],"cifrar en tránsito y en reposo;",{"_2886":60688,"_27469":60652,"_18854":101917,"_5":12679,"_25963":101813,"_2424":101918},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2886":60689,"_27469":60652,"_18854":101920,"_5":12679,"_25963":101813,"_2424":101921},[],"aplicar una política explícita de retención y legal hold;",{"_2886":60690,"_27469":60652,"_18854":101923,"_5":12679,"_25963":101813,"_2424":101924},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2886":60691,"_27469":60652,"_18854":101926,"_5":12679,"_25963":101817,"_2424":101927},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2886":60692,"_27469":60652,"_18854":101929,"_5":12679,"_25963":101817,"_2424":101930},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2886":60693,"_27469":60652,"_18854":101932,"_5":12679,"_25963":101825,"_2424":101933},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2886":60694,"_27469":60652,"_18854":101935,"_5":12679,"_25963":101829,"_2424":101936},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2886":60695,"_27469":60652,"_18854":101938,"_5":12679,"_25963":101833,"_2424":101939},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2886":60696,"_27469":60652,"_18854":101941,"_5":12679,"_25963":101837,"_2424":101942},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2886":60697,"_27469":60652,"_18854":101944,"_5":12679,"_25963":101841,"_2424":101945},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2886":60698,"_27469":60652,"_18854":101947,"_5":12679,"_25963":101845,"_2424":101948},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2886":60699,"_27469":60652,"_18854":101950,"_5":12679,"_25963":101845,"_2424":101951},[],"aparece un evento de auditoría correcto;",{"_2886":60700,"_27469":60652,"_18854":101953,"_5":12679,"_25963":101845,"_2424":101954},[],"el principal coincide con la identidad utilizada;",{"_2886":60701,"_27469":60652,"_18854":101956,"_5":12679,"_25963":101845,"_2424":101957},[],"el consumidor lo persiste una sola vez;",{"_2886":60702,"_27469":60652,"_18854":101959,"_5":12679,"_25963":101845,"_2424":101960},[],"puede recuperarse por recurso, actor y periodo;",{"_2886":60703,"_27469":60652,"_18854":101962,"_5":12679,"_25963":101845,"_2424":101963},[],"una interrupción del consumidor produce una alerta.",{"_2886":60704,"_27469":60652,"_18854":101965,"_5":12679,"_25963":101845,"_2424":101966},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2886":60705,"_27469":60705,"_5":13057,"_2424":101968,"_27749":101969,"_18854":101970,"_25963":60705},"Jerarquía y rotación de CAs",[43001,101196,101674],[],{"_2886":60706,"_27469":60705,"_18854":101972,"_5":12679,"_25963":60705,"_2424":101973},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2886":60707,"_27469":60705,"_5":27746,"_18854":101975,"_25963":101976,"_2424":101977},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2886":60708,"_27469":60705,"_5":27746,"_18854":101979,"_25963":101980,"_2424":101981},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2886":60709,"_27469":60705,"_5":27746,"_18854":101983,"_25963":101984,"_2424":101985},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2886":60710,"_27469":60705,"_5":27746,"_18854":101987,"_25963":101988,"_2424":101989},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2886":60711,"_27469":60705,"_5":27746,"_18854":101991,"_25963":101992,"_2424":101993},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2886":60712,"_27469":60705,"_5":27746,"_18854":101995,"_25963":101996,"_2424":101997},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2886":60713,"_27469":60705,"_5":27746,"_18854":101999,"_25963":102000,"_2424":102001},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2886":60714,"_27469":60705,"_5":27746,"_18854":102003,"_25963":102004,"_2424":102005},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2886":60715,"_27469":60705,"_5":27746,"_18854":102007,"_25963":102008,"_2424":102009},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2886":60716,"_27469":60705,"_5":27746,"_18854":102011,"_25963":102012,"_2424":102013},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2886":60717,"_27469":60705,"_5":27746,"_18854":102015,"_25963":102016,"_2424":102017},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2886":60718,"_27469":60705,"_5":27746,"_18854":102019,"_25963":102020,"_2424":102021},[],"/docs/pr-preview/pr-24/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2886":60719,"_27469":60705,"_18854":102023,"_5":12679,"_25963":60705,"_2424":102024},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2886":60720,"_27469":60705,"_18854":102026,"_5":12679,"_25963":101976,"_2424":102027},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2886":60721,"_27469":60705,"_18854":102029,"_5":12679,"_25963":101976,"_2424":102030},[],"entorno, como producción y preproducción;",{"_2886":60722,"_27469":60705,"_18854":102032,"_5":12679,"_25963":101976,"_2424":102033},[],"propietario o equipo operador;",{"_2886":60723,"_27469":60705,"_18854":102035,"_5":12679,"_25963":101976,"_2424":102036},[],"familia de dispositivos o proceso de fabricación;",{"_2886":60724,"_27469":60705,"_18854":102038,"_5":12679,"_25963":101976,"_2424":102039},[],"región o requisito regulatorio;",{"_2886":60725,"_27469":60705,"_18854":102041,"_5":12679,"_25963":101976,"_2424":102042},[],"motor criptográfico o política de clave;",{"_2886":60726,"_27469":60705,"_18854":102044,"_5":12679,"_25963":101976,"_2424":102045},[],"ventana de mantenimiento y ritmo de renovación.",{"_2886":60727,"_27469":60705,"_18854":102047,"_5":12679,"_25963":101976,"_2424":102048},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2886":60728,"_27469":60705,"_18854":102050,"_5":12679,"_25963":101976,"_2424":102051},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2886":60729,"_27469":60705,"_18854":102053,"_5":12679,"_25963":101980,"_2424":102054},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2886":60730,"_27469":60705,"_18854":102056,"_5":12679,"_25963":101980,"_2424":102057},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2886":60731,"_27469":60705,"_18854":102059,"_5":12679,"_25963":101980,"_2424":102060},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2886":60732,"_27469":60705,"_18854":102062,"_5":12679,"_25963":101984,"_2424":102063},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2886":60733,"_27469":60705,"_18854":102065,"_5":12679,"_25963":101984,"_2424":102066},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2886":60734,"_27469":60705,"_18854":102068,"_5":12679,"_25963":101984,"_2424":102069},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2886":60735,"_27469":60705,"_18854":102071,"_5":12679,"_25963":101984,"_2424":102072},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2886":60736,"_27469":60705,"_18854":102074,"_5":12679,"_25963":101992,"_2424":102075},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2886":60737,"_27469":60705,"_18854":102077,"_5":12679,"_25963":101996,"_2424":102078},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2886":60738,"_27469":60705,"_18854":102080,"_5":12679,"_25963":102000,"_2424":102081},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. En un DMS, utiliza las CAs gestionadas de `/cacerts` para mantener temporalmente las cadenas antigua y nueva.",{"_2886":60739,"_27469":60705,"_18854":102083,"_5":12679,"_25963":102004,"_2424":102084},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2886":60740,"_27469":60705,"_18854":102086,"_5":12679,"_25963":102008,"_2424":102087},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2886":60741,"_27469":60705,"_18854":102089,"_5":12679,"_25963":102012,"_2424":102090},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2886":60742,"_27469":60705,"_18854":102092,"_5":12679,"_25963":102016,"_2424":102093},[],"Al revocar una CA, Lamassu actualiza también sus CAs hijas y certificados emitidos a `REVOKED` con razón `CessationOfOperation`. Las revocaciones de las hijas propagan el efecto a sus propias ramas.",{"_2886":60743,"_27469":60705,"_18854":102095,"_5":12679,"_25963":102016,"_2424":102096},[],"Esto protege la coherencia de la jerarquía, pero convierte la revocación en una acción de gran impacto. No la utilices como mecanismo ordinario para dejar de emitir: primero completa la migración y elimina la CA de los flujos operativos.",{"_2886":60744,"_27469":60705,"_18854":102098,"_5":12679,"_25963":102020,"_2424":102099},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2886":60745,"_27469":60705,"_18854":102101,"_5":12679,"_25963":102020,"_2424":102102},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2886":60746,"_27469":60705,"_18854":102104,"_5":12679,"_25963":102020,"_2424":102105},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2886":60747,"_27469":60705,"_18854":102107,"_5":12679,"_25963":102020,"_2424":102108},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2886":60748,"_27469":60705,"_18854":102110,"_5":12679,"_25963":102020,"_2424":102111},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2886":60749,"_27469":60705,"_18854":102113,"_5":12679,"_25963":102020,"_2424":102114},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2886":60750,"_27469":60705,"_18854":102116,"_5":12679,"_25963":102020,"_2424":102117},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2886":60751,"_27469":60751,"_5":13057,"_2424":102119,"_27749":102120,"_18854":102121,"_25963":60751},"Autoridades de certificación",[43001,101196,101674],[],{"_2886":60752,"_27469":60751,"_18854":102123,"_5":12679,"_25963":60751,"_2424":102124},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2886":60753,"_27469":60751,"_5":27746,"_18854":102126,"_25963":102127,"_2424":102128},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2886":60754,"_27469":60751,"_5":27746,"_18854":102130,"_25963":102131,"_2424":102132},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2886":60755,"_27469":60751,"_5":27746,"_18854":102134,"_25963":102135,"_2424":100107},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2886":60756,"_27469":60751,"_5":27746,"_18854":102137,"_25963":102138,"_2424":102139},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2886":60757,"_27469":60751,"_5":27746,"_18854":102141,"_25963":102142,"_2424":102143},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2886":60758,"_27469":60751,"_5":27746,"_18854":102145,"_25963":102146,"_2424":102147},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2886":60759,"_27469":60751,"_5":27746,"_18854":102149,"_25963":102150,"_2424":102151},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2886":60760,"_27469":60751,"_5":27746,"_18854":102153,"_25963":102154,"_2424":102155},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2886":60761,"_27469":60751,"_5":27746,"_18854":102157,"_25963":102158,"_2424":102159},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2886":60762,"_27469":60751,"_5":27746,"_18854":102161,"_25963":102162,"_2424":102163},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2886":60763,"_27469":60751,"_5":27746,"_18854":102165,"_25963":102166,"_2424":102167},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2886":60764,"_27469":60751,"_5":27746,"_18854":102169,"_25963":102170,"_2424":102171},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2886":60765,"_27469":60751,"_5":27746,"_18854":102173,"_25963":102174,"_2424":102175},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2886":60766,"_27469":60751,"_5":27746,"_18854":102177,"_25963":102178,"_2424":102179},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2886":60767,"_27469":60751,"_5":27746,"_18854":102181,"_25963":102182,"_2424":102183},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2886":60768,"_27469":60751,"_5":27746,"_18854":102185,"_25963":102186,"_2424":102187},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2886":60769,"_27469":60751,"_5":27746,"_18854":102189,"_25963":102190,"_2424":102191},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2886":60770,"_27469":60751,"_5":27746,"_18854":102193,"_25963":102194,"_2424":102195},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2886":60771,"_27469":60751,"_5":27746,"_18854":102197,"_25963":102198,"_2424":102199},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2886":60772,"_27469":60751,"_5":27746,"_18854":102201,"_25963":102202,"_2424":102203},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2886":60773,"_27469":60751,"_5":27746,"_18854":102205,"_25963":102206,"_2424":102207},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2886":60774,"_27469":60751,"_5":27746,"_18854":102209,"_25963":102210,"_2424":102211},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2886":60775,"_27469":60751,"_18854":102213,"_5":12679,"_25963":60751,"_2424":102214},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2886":60776,"_27469":60751,"_18854":102216,"_5":12679,"_25963":60751,"_2424":102217},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2886":60777,"_27469":60751,"_18854":102219,"_5":12679,"_25963":102127,"_2424":102220},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2886":60778,"_27469":60751,"_18854":102222,"_5":12679,"_25963":102127,"_2424":102223},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2886":60779,"_27469":60751,"_18854":102225,"_5":12679,"_25963":102127,"_2424":102226},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2886":60780,"_27469":60751,"_18854":102228,"_5":12679,"_25963":102127,"_2424":102229},[],"**Importar solo el certificado:** añade una autoridad para construir cadenas y validar, pero no para emitir.",{"_2886":60781,"_27469":60751,"_18854":102231,"_5":12679,"_25963":102127,"_2424":102232},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2886":60782,"_27469":60751,"_18854":102234,"_5":12679,"_25963":102135,"_2424":102235},[],"Decide si la CA será raíz o intermedia.",{"_2886":60783,"_27469":60751,"_18854":102237,"_5":12679,"_25963":102135,"_2424":102238},[],"Elige el motor que custodiará la clave.",{"_2886":60784,"_27469":60751,"_18854":102240,"_5":12679,"_25963":102135,"_2424":102241},[],"Define una validez superior a la de los certificados que emitirá.",{"_2886":60785,"_27469":60751,"_18854":102243,"_5":12679,"_25963":102135,"_2424":102244},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2886":60786,"_27469":60751,"_18854":102246,"_5":12679,"_25963":102138,"_2424":102247},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2886":60787,"_27469":60751,"_18854":102249,"_5":12679,"_25963":102142,"_2424":102250},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2886":60788,"_27469":60751,"_18854":102252,"_5":12679,"_25963":102142,"_2424":102253},[],"Para RSA puedes elegir 1024, 2048, 3072 o 4096 bits. Para EC están disponibles las curvas P-256, P-384 y P-521.",{"_2886":60789,"_27469":60751,"_18854":102255,"_5":12679,"_25963":102146,"_2424":102256},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2886":60790,"_27469":60751,"_18854":102258,"_5":12679,"_25963":102150,"_2424":102259},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2886":60791,"_27469":60751,"_18854":102261,"_5":12679,"_25963":102150,"_2424":102262},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2886":60792,"_27469":60751,"_18854":102264,"_5":12679,"_25963":102150,"_2424":102265},[],"`ST`: estado o provincia.",{"_2886":60793,"_27469":60751,"_18854":102267,"_5":12679,"_25963":102150,"_2424":102268},[],"`L`: localidad.",{"_2886":60794,"_27469":60751,"_18854":102270,"_5":12679,"_25963":102150,"_2424":102271},[],"`O`: organización.",{"_2886":60795,"_27469":60751,"_18854":102273,"_5":12679,"_25963":102150,"_2424":102274},[],"`OU`: unidad organizativa.",{"_2886":60796,"_27469":60751,"_18854":102276,"_5":12679,"_25963":102150,"_2424":102277},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2886":60797,"_27469":60751,"_18854":102279,"_5":12679,"_25963":102154,"_2424":102280},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2886":60798,"_27469":60751,"_18854":102282,"_5":12679,"_25963":102154,"_2424":102283},[],"Selecciona un perfil de emisión existente o configura los `Key Usage` y `Extended Key Usage` en el formulario. Si no eliges un perfil, Lamassu aplica los usos básicos predeterminados.",{"_2886":60799,"_27469":60751,"_18854":102285,"_5":12679,"_25963":102158,"_2424":102286},[],"Confirma el formulario. La CA debe aparecer en el inventario con su certificado PEM, estado, fecha de expiración y relación de certificados emitidos.",{"_2886":60800,"_27469":60751,"_18854":102288,"_5":12679,"_25963":102158,"_2424":102289},[],"Una CA no puede emitir certificados que superen su propia fecha de expiración. Deja margen suficiente para renovar o sustituir la autoridad sin interrumpir a los consumidores.",{"_2886":60801,"_27469":60751,"_18854":102291,"_5":12679,"_25963":102162,"_2424":102292},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2886":60802,"_27469":60751,"_18854":102294,"_5":12679,"_25963":102162,"_2424":102295},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2886":60803,"_27469":60751,"_18854":102297,"_5":12679,"_25963":102166,"_2424":102298},[],"La importación conserva una autoridad creada fuera de Lamassu.",{"_2886":60804,"_27469":60751,"_18854":102300,"_5":12679,"_25963":102170,"_2424":102301},[],"Elige el motor que custodiará la clave importada.",{"_2886":60805,"_27469":60751,"_18854":102303,"_5":12679,"_25963":102174,"_2424":102304},[],"Proporciona el certificado de CA y la clave privada en formato PEM. Para una CA subordinada, añade opcionalmente la cadena de validación.",{"_2886":60806,"_27469":60751,"_18854":102306,"_5":12679,"_25963":102178,"_2424":102307},[],"Configura la validez que recibirán los certificados finales cuando una solicitud no indique otra duración.",{"_2886":60807,"_27469":60751,"_18854":102309,"_5":12679,"_25963":102182,"_2424":102310},[],"Lamassu comprueba que el certificado pertenece a una CA y que el material es coherente antes de registrarlo.",{"_2886":60808,"_27469":60751,"_18854":102312,"_5":12679,"_25963":102182,"_2424":102313},[],"Si no dispones de la clave privada, importa únicamente el certificado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu.",{"_2886":60809,"_27469":60751,"_18854":102315,"_5":12679,"_25963":102186,"_2424":102316},[],"Abre una CA desde el inventario para consultar:",{"_2886":60810,"_27469":60751,"_18854":102318,"_5":12679,"_25963":102186,"_2424":102319},[],"Estado y periodo de validez.",{"_2886":60811,"_27469":60751,"_18854":102321,"_5":12679,"_25963":102186,"_2424":102322},[],"Certificado y cadena en formato PEM.",{"_2886":60812,"_27469":60751,"_18854":102324,"_5":12679,"_25963":102186,"_2424":102325},[],"Número de certificados activos, expirados y revocados.",{"_2886":60813,"_27469":60751,"_18854":102327,"_5":12679,"_25963":102186,"_2424":102328},[],"Certificados emitidos en **Issued Certificates**.",{"_2886":60814,"_27469":60751,"_18854":102330,"_5":12679,"_25963":102186,"_2424":102331},[],"CRL vinculada a la autoridad.",{"_2886":60815,"_27469":60751,"_18854":102333,"_5":12679,"_25963":102186,"_2424":102334},[],"Metadatos y motor criptográfico asociado.",{"_2886":60816,"_27469":60751,"_18854":102336,"_5":12679,"_25963":102186,"_2424":102337},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2886":60817,"_27469":60751,"_18854":102339,"_5":12679,"_25963":102190,"_2424":102340},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2886":60818,"_27469":60751,"_18854":102342,"_5":12679,"_25963":102190,"_2424":102343},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2886":60819,"_27469":60751,"_18854":102345,"_5":12679,"_25963":102190,"_2424":102346},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2886":60820,"_27469":60751,"_18854":102348,"_5":12679,"_25963":102190,"_2424":102349},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2886":60821,"_27469":60751,"_18854":102351,"_5":12679,"_25963":102194,"_2424":102352},[],"Revocar una CA invalida la confianza en los certificados que ha emitido y puede interrumpir dispositivos y servicios. La acción es irreversible.",{"_2886":60822,"_27469":60751,"_18854":102354,"_5":12679,"_25963":102198,"_2424":102355},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2886":60823,"_27469":60751,"_18854":102357,"_5":12679,"_25963":102202,"_2424":102358},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2886":60824,"_27469":60751,"_18854":102360,"_5":12679,"_25963":102206,"_2424":102361},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2886":60825,"_27469":60751,"_18854":102363,"_5":12679,"_25963":102210,"_2424":102364},[],"El estado debe cambiar a **REVOKED** y la CRL debe reflejar la nueva información. La CA deja de poder emitir certificados.",{"_2886":60826,"_27469":60751,"_18854":102366,"_5":12679,"_25963":102210,"_2424":102367},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2886":60827,"_27469":60827,"_5":13057,"_2424":102369,"_27749":102370,"_18854":102371,"_25963":60827},"Perfiles de certificado",[43001,101196,101674],[],{"_2886":60828,"_27469":60827,"_18854":102373,"_5":12679,"_25963":60827,"_2424":102374},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2886":60829,"_27469":60827,"_5":27746,"_18854":102376,"_25963":102377,"_2424":102378},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2886":60830,"_27469":60827,"_5":27746,"_18854":102380,"_25963":102381,"_2424":102382},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#validez","Validez",{"_2886":60831,"_27469":60827,"_5":27746,"_18854":102384,"_25963":102385,"_2424":102386},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2886":60832,"_27469":60827,"_5":27746,"_18854":102388,"_25963":102389,"_2424":102390},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2886":60833,"_27469":60827,"_5":27746,"_18854":102392,"_25963":102393,"_2424":102394},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2886":60834,"_27469":60827,"_5":27746,"_18854":102396,"_25963":102397,"_2424":102398},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2886":60835,"_27469":60827,"_5":27746,"_18854":102400,"_25963":102401,"_2424":102402},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2886":60836,"_27469":60827,"_5":27746,"_18854":102404,"_25963":102405,"_2424":102406},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2886":60837,"_27469":60827,"_5":27746,"_18854":102408,"_25963":102409,"_2424":102410},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2886":60838,"_27469":60827,"_5":27746,"_18854":102412,"_25963":102413,"_2424":102414},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2886":60839,"_27469":60827,"_5":27746,"_18854":102416,"_25963":102417,"_2424":102418},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2886":60840,"_27469":60827,"_5":27746,"_18854":102420,"_25963":102421,"_2424":102422},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2886":60841,"_27469":60827,"_5":27746,"_18854":102424,"_25963":102425,"_2424":102426},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2886":60842,"_27469":60827,"_5":27746,"_18854":102428,"_25963":102429,"_2424":102430},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2886":60843,"_27469":60827,"_5":27746,"_18854":102432,"_25963":102433,"_2424":102434},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2886":60844,"_27469":60827,"_5":27746,"_18854":102436,"_25963":102437,"_2424":102438},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2886":60845,"_27469":60827,"_18854":102440,"_5":12679,"_25963":60827,"_2424":102441},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2886":60846,"_27469":60827,"_18854":102443,"_5":12679,"_25963":102381,"_2424":102444},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2886":60847,"_27469":60827,"_18854":102446,"_5":12679,"_25963":102381,"_2424":102447},[],"La fecha final nunca debe superar la de la CA emisora.",{"_2886":60848,"_27469":60827,"_18854":102449,"_5":12679,"_25963":102385,"_2424":102450},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2886":60849,"_27469":60827,"_18854":102452,"_5":12679,"_25963":102389,"_2424":102453},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2886":60850,"_27469":60827,"_18854":102455,"_5":12679,"_25963":102389,"_2424":102456},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2886":60851,"_27469":60827,"_18854":102458,"_5":12679,"_25963":102389,"_2424":102459},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2886":60852,"_27469":60827,"_18854":102461,"_5":12679,"_25963":102393,"_2424":102462},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2886":60853,"_27469":60827,"_18854":102464,"_5":12679,"_25963":102397,"_2424":102465},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2886":60854,"_27469":60827,"_18854":102467,"_5":12679,"_25963":102397,"_2424":102468},[],"Este comportamiento permite aceptar DNS, IP, correo o URI como identidades alternativas sin aceptar extensiones arbitrarias.",{"_2886":60855,"_27469":60827,"_18854":102470,"_5":12679,"_25963":102401,"_2424":102471},[],"La aplicación criptográfica puede:",{"_2886":60856,"_27469":60827,"_18854":102473,"_5":12679,"_25963":102401,"_2424":102474},[],"permitir o bloquear claves RSA;",{"_2886":60857,"_27469":60827,"_18854":102476,"_5":12679,"_25963":102401,"_2424":102477},[],"limitar los tamaños RSA admitidos;",{"_2886":60858,"_27469":60827,"_18854":102479,"_5":12679,"_25963":102401,"_2424":102480},[],"permitir o bloquear claves ECDSA;",{"_2886":60859,"_27469":60827,"_18854":102482,"_5":12679,"_25963":102401,"_2424":102483},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2886":60860,"_27469":60827,"_18854":102485,"_5":12679,"_25963":102401,"_2424":102486},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2886":60861,"_27469":60827,"_18854":102488,"_5":12679,"_25963":102405,"_2424":102489},[],"En operaciones que admiten varias fuentes, Lamassu resuelve el perfil en este orden:",{"_2886":60862,"_27469":60827,"_18854":102491,"_5":12679,"_25963":102405,"_2424":102492},[],"Perfil enviado dentro de la operación.",{"_2886":60863,"_27469":60827,"_18854":102494,"_5":12679,"_25963":102405,"_2424":102495},[],"Identificador de perfil enviado en la operación.",{"_2886":60864,"_27469":60827,"_18854":102497,"_5":12679,"_25963":102405,"_2424":102498},[],"Perfil predeterminado asociado a la CA.",{"_2886":60865,"_27469":60827,"_18854":102500,"_5":12679,"_25963":102405,"_2424":102501},[],"Un DMS también puede referenciar su propio perfil de emisión. De este modo, varias flotas pueden usar la misma CA con políticas distintas.",{"_2886":60866,"_27469":60827,"_18854":102503,"_5":12679,"_25963":102413,"_2424":102504},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2886":60867,"_27469":60827,"_18854":102506,"_5":12679,"_25963":102417,"_2424":102507},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2886":60868,"_27469":60827,"_18854":102509,"_5":12679,"_25963":102421,"_2424":102510},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2886":60869,"_27469":60827,"_18854":102512,"_5":12679,"_25963":102425,"_2424":102513},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2886":60870,"_27469":60827,"_18854":102515,"_5":12679,"_25963":102429,"_2424":102516},[],"Asocia el perfil a una CA o DMS. Emite un certificado de prueba y comprueba sujeto, SAN, KU, EKU, restricciones básicas y fechas con una herramienta X.509 independiente.",{"_2886":60871,"_27469":60827,"_18854":102518,"_5":12679,"_25963":102433,"_2424":102519},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2886":60872,"_27469":60827,"_18854":102521,"_5":12679,"_25963":102433,"_2424":102522},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2886":60873,"_27469":60827,"_18854":102524,"_5":12679,"_25963":102433,"_2424":102525},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2886":60874,"_27469":60827,"_18854":102527,"_5":12679,"_25963":102433,"_2424":102528},[],"Son patrones de partida, no una política universal. Verifica siempre los requisitos del protocolo, del consumidor y del marco regulatorio aplicable.",{"_2886":60875,"_27469":60827,"_18854":102530,"_5":12679,"_25963":102437,"_2424":102531},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2886":60876,"_27469":60827,"_18854":102533,"_5":12679,"_25963":102437,"_2424":102534},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2886":60877,"_27469":60877,"_5":13057,"_2424":102536,"_27749":102537,"_18854":102538,"_25963":60877},"Validación de certificados",[43001,101196,101674],[],{"_2886":60878,"_27469":60877,"_18854":102540,"_5":12679,"_25963":60877,"_2424":102541},[],"Publica el estado de las identidades mediante OCSP y CRL.",{"_2886":60879,"_27469":60877,"_5":27746,"_18854":102543,"_25963":102544,"_2424":102545},[],"/docs/pr-preview/pr-24/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2886":60880,"_27469":60877,"_18854":102547,"_5":12679,"_25963":60877,"_2424":102548},[],"La emisión demuestra quién firmó un certificado; la validación permite saber si todavía debe aceptarse. Lamassu publica el estado mediante dos mecanismos complementarios.",{"_2886":60881,"_27469":60877,"_18854":102550,"_5":12679,"_25963":102544,"_2424":102551},[],"Usa **OCSP** cuando el consumidor esté conectado y necesite consultar el estado más reciente de un certificado concreto.",{"_2886":60882,"_27469":60877,"_18854":102553,"_5":12679,"_25963":102544,"_2424":102554},[],"Usa una **CRL** cuando la validación deba realizarse localmente, sin conexión o sobre un volumen elevado de certificados. El consumidor descarga periódicamente una lista firmada y la conserva hasta la siguiente actualización.",{"_2886":60883,"_27469":60877,"_18854":102556,"_5":12679,"_25963":102544,"_2424":102557},[],"Muchos entornos utilizan ambos: OCSP como comprobación primaria y CRL como mecanismo local o de respaldo.",{"_2886":60884,"_27469":60877,"_18854":102559,"_5":12679,"_25963":102544,"_2424":102560},[],"<Card title=\"Validación online con OCSP\" description=\"Consulta estados Good, Revoked y Unknown en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_2886":60885,"_27469":60877,"_18854":102562,"_5":12679,"_25963":102544,"_2424":102563},[],"<Card title=\"Listas de revocación\" description=\"Genera, publica y distribuye CRLs por autoridad.\" href=\"/docs/platform/pki/crl\" />",{"_2886":60886,"_27469":60886,"_5":13057,"_2424":102565,"_27749":102566,"_18854":102567,"_25963":60886},"Certificados",[43001,101196,101674],[],{"_2886":60887,"_27469":60886,"_18854":102569,"_5":12679,"_25963":60886,"_2424":102570},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2886":60888,"_27469":60886,"_5":27746,"_18854":102572,"_25963":102573,"_2424":102574},[],"/docs/pr-preview/pr-24/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2886":60889,"_27469":60886,"_5":27746,"_18854":102576,"_25963":102577,"_2424":102578},[],"/docs/pr-preview/pr-24/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2886":60890,"_27469":60886,"_5":27746,"_18854":102580,"_25963":102581,"_2424":102582},[],"/docs/pr-preview/pr-24/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2886":60891,"_27469":60886,"_5":27746,"_18854":102584,"_25963":102585,"_2424":102586},[],"/docs/pr-preview/pr-24/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2886":60892,"_27469":60886,"_5":27746,"_18854":102588,"_25963":102589,"_2424":102590},[],"/docs/pr-preview/pr-24/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2886":60893,"_27469":60886,"_5":27746,"_18854":102592,"_25963":102593,"_2424":102594},[],"/docs/pr-preview/pr-24/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2886":60894,"_27469":60886,"_5":27746,"_18854":102596,"_25963":102597,"_2424":102598},[],"/docs/pr-preview/pr-24/es/platform/pki/certificates#continúa","Continúa",{"_2886":60895,"_27469":60886,"_18854":102600,"_5":12679,"_25963":60886,"_2424":102601},[],"El inventario de certificados ofrece una vista global de las identidades emitidas por todas las autoridades. También puedes abrir **Issued Certificates** dentro de una CA para limitar la vista a ese emisor.",{"_2886":60896,"_27469":60886,"_18854":102603,"_5":12679,"_25963":102573,"_2424":102604},[],"Abre **Certificates** y filtra por:",{"_2886":60897,"_27469":60886,"_18854":102606,"_5":12679,"_25963":102573,"_2424":102607},[],"`Common Name` del sujeto.",{"_2886":60898,"_27469":60886,"_18854":102609,"_5":12679,"_25963":102573,"_2424":102610},[],"Número de serie.",{"_2886":60899,"_27469":60886,"_18854":102612,"_5":12679,"_25963":102573,"_2424":102613},[],"Estado.",{"_2886":60900,"_27469":60886,"_18854":102615,"_5":12679,"_25963":102573,"_2424":102616},[],"Autoridad emisora.",{"_2886":60901,"_27469":60886,"_18854":102618,"_5":12679,"_25963":102573,"_2424":102619},[],"Utiliza **Quick Inspect** para una comprobación rápida o **View Details** para ver el sujeto, SANs, usos, cadena, periodo de validez y metadatos completos.",{"_2886":60902,"_27469":60886,"_18854":102621,"_5":12679,"_25963":102577,"_2424":102622},[],"La acción de descarga entrega el certificado en formato PEM. Si el certificado se emitió mediante un CSR externo, la clave privada permanece en el sistema que generó ese CSR. Si se generó en el navegador, la clave solo estuvo disponible al finalizar la emisión.",{"_2886":60903,"_27469":60886,"_18854":102624,"_5":12679,"_25963":102581,"_2424":102625},[],"Revoca una identidad cuando la clave se haya comprometido, el sujeto ya no esté autorizado o el certificado deba dejar de aceptarse antes de expirar.",{"_2886":60904,"_27469":60886,"_18854":102627,"_5":12679,"_25963":102585,"_2424":102628},[],"En el inventario o la vista de detalle, selecciona **Revoke Certificate**.",{"_2886":60905,"_27469":60886,"_18854":102630,"_5":12679,"_25963":102589,"_2424":102631},[],"Selecciona la razón que represente el incidente. Esta información se publica en OCSP y en la CRL.",{"_2886":60906,"_27469":60886,"_18854":102633,"_5":12679,"_25963":102593,"_2424":102634},[],"Confirma la operación y comprueba que el estado sea **Revoked**. Si la CA regenera la CRL al revocar, verifica también que exista una versión nueva.",{"_2886":60907,"_27469":60886,"_18854":102636,"_5":12679,"_25963":102593,"_2424":102637},[],"Una revocación con la razón `CertificateHold` puede reactivarse. Las demás razones producen una revocación definitiva.",{"_2886":60908,"_27469":60886,"_18854":102639,"_5":12679,"_25963":102597,"_2424":102640},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado de un certificado en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_2886":60909,"_27469":60886,"_18854":102642,"_5":12679,"_25963":102597,"_2424":102643},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación offline.\" href=\"/docs/platform/pki/crl\" />",{"_2886":60910,"_27469":60910,"_5":13057,"_2424":102645,"_18854":102646,"_25963":60910},"Enrolamiento de dispositivos con CMP",[],{"_2886":60911,"_27469":60910,"_18854":102648,"_5":12679,"_25963":60910,"_2424":102649},[],"Guía del protocolo CMP en Lamassu IoT, con la referencia completa de ajustes generales y por operación del DMS, y la referencia de operaciones para el integrador de dispositivos.",{"_2886":60912,"_27469":60910,"_5":27746,"_18854":102651,"_25963":102652,"_2424":45594},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#cmp-certificate-management-protocol",{"_2886":60913,"_27469":60910,"_5":27746,"_18854":102654,"_25963":102655,"_2424":102656},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#configuración-del-dms","Configuración del DMS",{"_2886":60914,"_27469":60910,"_5":27746,"_18854":102658,"_25963":102659,"_2424":102660},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#requisitos-previos","Requisitos previos",{"_2886":60915,"_27469":60910,"_5":27746,"_18854":102662,"_25963":102663,"_2424":102664},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#selección-de-protocolo","Selección de protocolo",{"_2886":60916,"_27469":60910,"_5":27746,"_18854":102666,"_25963":102667,"_2424":102668},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#ajustes-generales-de-enrollment","Ajustes generales de enrollment",{"_2886":60917,"_27469":60910,"_5":27746,"_18854":102670,"_25963":102671,"_2424":102672},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#ajustes-compartidos-con-est","Ajustes compartidos con EST",{"_2886":60918,"_27469":60910,"_5":27746,"_18854":102674,"_25963":102675,"_2424":102676},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#modo-de-autenticación","Modo de autenticación",{"_2886":60919,"_27469":60910,"_5":27746,"_18854":102678,"_25963":102679,"_2424":102680},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#confirmación-y-flujo-de-emisión","Confirmación y flujo de emisión",{"_2886":60920,"_27469":60910,"_5":27746,"_18854":102682,"_25963":102683,"_2424":102684},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#certificado-de-protección-y-prueba-de-posesión","Certificado de protección y prueba de posesión",{"_2886":60921,"_27469":60910,"_5":27746,"_18854":102686,"_25963":102687,"_2424":102688},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#ajustes-por-operación","Ajustes por operación",{"_2886":60922,"_27469":60910,"_5":27746,"_18854":102690,"_25963":102691,"_2424":45634},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#ir--initialization-request",{"_2886":60923,"_27469":60910,"_5":27746,"_18854":102693,"_25963":102694,"_2424":45638},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#cr--certification-request",{"_2886":60924,"_27469":60910,"_5":27746,"_18854":102696,"_25963":102697,"_2424":45642},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#p10cr--pkcs10-certification-request",{"_2886":60925,"_27469":60910,"_5":27746,"_18854":102699,"_25963":102700,"_2424":45646},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#kur--key-update-request",{"_2886":60926,"_27469":60910,"_5":27746,"_18854":102702,"_25963":102703,"_2424":45650},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#rr--revocation-request",{"_2886":60927,"_27469":60910,"_5":27746,"_18854":102705,"_25963":102706,"_2424":45654},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#genm--general-message",{"_2886":60928,"_27469":60910,"_5":27746,"_18854":102708,"_25963":102709,"_2424":45658},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#ccr--cross-certification-request",{"_2886":60929,"_27469":60910,"_5":27746,"_18854":102711,"_25963":102712,"_2424":102713},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#generación-de-claves-en-servidor-central-key-generation","Generación de claves en servidor (Central Key Generation)",{"_2886":60930,"_27469":60910,"_5":27746,"_18854":102715,"_25963":102716,"_2424":102717},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2886":60931,"_27469":60910,"_5":27746,"_18854":102719,"_25963":102720,"_2424":102721},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#transacciones-cmp","Transacciones CMP",{"_2886":60932,"_27469":60910,"_5":27746,"_18854":102723,"_25963":102724,"_2424":102725},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#monitor-de-confirmación","Monitor de confirmación",{"_2886":60933,"_27469":60910,"_5":27746,"_18854":102727,"_25963":102728,"_2424":102729},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#integración-con-wfx-opcional","Integración con WFX (opcional)",{"_2886":60934,"_27469":60910,"_5":27746,"_18854":102731,"_25963":102732,"_2424":102733},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#verificar-la-configuración","Verificar la configuración",{"_2886":60935,"_27469":60910,"_5":27746,"_18854":102735,"_25963":102736,"_2424":102737},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#integración-de-dispositivos","Integración de dispositivos",{"_2886":60936,"_27469":60910,"_5":27746,"_18854":102739,"_25963":102740,"_2424":100107},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#antes-de-empezar",{"_2886":60937,"_27469":60910,"_5":27746,"_18854":102742,"_25963":102743,"_2424":102744},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#el-endpoint-cmp","El endpoint CMP",{"_2886":60938,"_27469":60910,"_5":27746,"_18854":102746,"_25963":102747,"_2424":102748},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#modelo-de-autenticación","Modelo de autenticación",{"_2886":60939,"_27469":60910,"_5":27746,"_18854":102750,"_25963":102751,"_2424":102752},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#operaciones-soportadas","Operaciones soportadas",{"_2886":60940,"_27469":60910,"_5":27746,"_18854":102754,"_25963":102755,"_2424":102756},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#ir-y-cr","`ir` y `cr`",{"_2886":60941,"_27469":60910,"_5":27746,"_18854":102758,"_25963":102759,"_2424":45709},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#kur",{"_2886":60942,"_27469":60910,"_5":27746,"_18854":102761,"_25963":102762,"_2424":45713},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#p10cr",{"_2886":60943,"_27469":60910,"_5":27746,"_18854":102764,"_25963":102765,"_2424":45717},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#rr",{"_2886":60944,"_27469":60910,"_5":27746,"_18854":102767,"_25963":102768,"_2424":45721},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#genm",{"_2886":60945,"_27469":60910,"_5":27746,"_18854":102770,"_25963":102771,"_2424":45725},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#ccr",{"_2886":60946,"_27469":60910,"_5":27746,"_18854":102773,"_25963":102774,"_2424":102775},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#certconf-y-pollreq","`certConf` y `pollReq`",{"_2886":60947,"_27469":60910,"_5":27746,"_18854":102777,"_25963":102778,"_2424":45733},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#nested",{"_2886":60948,"_27469":60910,"_5":27746,"_18854":102780,"_25963":102781,"_2424":102782},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#generación-de-claves-en-servidor-kga","Generación de claves en servidor (KGA)",{"_2886":60949,"_27469":60910,"_5":27746,"_18854":102784,"_25963":102785,"_2424":102786},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#ejemplo-con-openssl-cmp","Ejemplo con openssl cmp",{"_2886":60950,"_27469":60910,"_5":27746,"_18854":102788,"_25963":102789,"_2424":102790},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_2886":60951,"_27469":60910,"_5":27746,"_18854":102792,"_25963":102793,"_2424":102794},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2886":60952,"_27469":60910,"_5":27746,"_18854":102796,"_25963":102797,"_2424":102798},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2886":60953,"_27469":60910,"_5":27746,"_18854":102800,"_25963":102801,"_2424":102802},[],"/docs/pr-preview/pr-24/es/platform/pki/cmp#notas-de-compatibilidad","Notas de compatibilidad",{"_2886":60954,"_27469":60910,"_18854":102804,"_5":12679,"_25963":102652,"_2424":102805},[],"Lamassu IoT implementa el protocolo &#x2A;*CMP (RFC 4210)** siguiendo el perfil &#x2A;*Lightweight CMP (RFC 9483)** como su segundo mecanismo de inscripción de certificados para dispositivos, junto a EST (RFC 7030). Cada DMS expone uno de los dos protocolos — nunca ambos a la vez — y el que expone CMP actúa como autoridad de registro (RA) frente al cliente.",{"_2886":60955,"_27469":60910,"_18854":102807,"_5":12679,"_25963":102652,"_2424":102808},[],"Frente a EST, CMP cambia tres ideas fundamentales:",{"_2886":60956,"_27469":60910,"_18854":102810,"_5":12679,"_25963":102652,"_2424":102811},[],"Aspecto",{"_2886":60957,"_27469":60910,"_18854":102813,"_5":12679,"_25963":102652,"_2424":45769},[],{"_2886":60958,"_27469":60910,"_18854":102815,"_5":12679,"_25963":102652,"_2424":45772},[],{"_2886":60959,"_27469":60910,"_18854":102817,"_5":12679,"_25963":102652,"_2424":45775},[],{"_2886":60960,"_27469":60910,"_18854":102819,"_5":12679,"_25963":102652,"_2424":102820},[],"Uno por operación (`/cacerts`, `/simpleenroll`, …)",{"_2886":60961,"_27469":60910,"_18854":102822,"_5":12679,"_25963":102652,"_2424":102823},[],"Un **único endpoint multiplexado** (`/.well-known/cmp/p/{id}`); la operación se determina por el contenido del mensaje",{"_2886":60962,"_27469":60910,"_18854":102825,"_5":12679,"_25963":102652,"_2424":102826},[],"Autenticación",{"_2886":60963,"_27469":60910,"_18854":102828,"_5":12679,"_25963":102652,"_2424":102829},[],"mTLS en la capa de transporte",{"_2886":60964,"_27469":60910,"_18854":102831,"_5":12679,"_25963":102652,"_2424":102832},[],"**Protección del propio mensaje** (`PKIMessage`) mediante firma o, en `ir`/`cr`, prueba de posesión CRMF",{"_2886":60965,"_27469":60910,"_18854":102834,"_5":12679,"_25963":102652,"_2424":102835},[],"Ajustes",{"_2886":60966,"_27469":60910,"_18854":102837,"_5":12679,"_25963":102652,"_2424":102838},[],"Bloques generales de enrollment y re-enrollment",{"_2886":60967,"_27469":60910,"_18854":102840,"_5":12679,"_25963":102652,"_2424":102841},[],"Ajustes generales **más un bloque de política por operación** (`ir`, `cr`, `p10cr`, `kur`, `rr`, `genm`, `ccr`)",{"_2886":60968,"_27469":60910,"_18854":102843,"_5":12679,"_25963":102652,"_2424":102844},[],"Confirmación",{"_2886":60969,"_27469":60910,"_18854":102846,"_5":12679,"_25963":102652,"_2424":102847},[],"La respuesta es el final del flujo",{"_2886":60970,"_27469":60910,"_18854":102849,"_5":12679,"_25963":102652,"_2424":102850},[],"Protocolo de confirmación explícito (`certConf`), confirmación implícita negociable y transacciones con estados",{"_2886":60971,"_27469":60910,"_18854":102852,"_5":12679,"_25963":102652,"_2424":102853},[],"Renovación",{"_2886":60972,"_27469":60910,"_18854":102855,"_5":12679,"_25963":102652,"_2424":102856},[],"`/simplereenroll` con el certificado en vigor",{"_2886":60973,"_27469":60910,"_18854":102858,"_5":12679,"_25963":102652,"_2424":102859},[],"`kur` protegido por el certificado que se renueva, con política de clave e identidad por DMS",{"_2886":60974,"_27469":60910,"_18854":102861,"_5":12679,"_25963":102652,"_2424":102862},[],"El protocolo se selecciona con el campo `protocol` del DMS (`EST_RFC7030` o `CMP_RFC9483`) y cada uno tiene su propio bloque de configuración (`est_settings` / `cmp_settings`). Cambiar el protocolo de un DMS existente sustituye por completo el bloque del protocolo anterior: no hay migración de ajustes entre uno y otro.",{"_2886":60975,"_27469":60910,"_18854":102864,"_5":12679,"_25963":102652,"_2424":102865},[],"Esta guía está dividida en dos partes:",{"_2886":60976,"_27469":60910,"_18854":102867,"_5":12679,"_25963":102652,"_2424":102868},[],"Configuración del DMS, para el administrador PKI: todos los ajustes disponibles, generales y por operación.",{"_2886":60977,"_27469":60910,"_18854":102870,"_5":12679,"_25963":102652,"_2424":102871},[],"Integración de dispositivos, para quien consume el endpoint CMP desde firmware, librerías CMP estándar o servicios de aprovisionamiento.",{"_2886":60978,"_27469":60910,"_18854":102873,"_5":12679,"_25963":102652,"_2424":102874},[],"Si solo necesita una orientación rápida:",{"_2886":60979,"_27469":60910,"_18854":102876,"_5":12679,"_25963":102652,"_2424":102877},[],"Perfil",{"_2886":60980,"_27469":60910,"_18854":102879,"_5":12679,"_25963":102652,"_2424":102880},[],"Leer primero",{"_2886":60981,"_27469":60910,"_18854":102882,"_5":12679,"_25963":102652,"_2424":102883},[],"Después",{"_2886":60982,"_27469":60910,"_18854":102885,"_5":12679,"_25963":102652,"_2424":102886},[],"Administrador PKI",{"_2886":60983,"_27469":60910,"_18854":102888,"_5":12679,"_25963":102652,"_2424":102889},[],"Selección de protocolo y Ajustes por operación",{"_2886":60984,"_27469":60910,"_18854":102891,"_5":12679,"_25963":102652,"_2424":102892},[],"Transacciones CMP y Monitor de confirmación",{"_2886":60985,"_27469":60910,"_18854":102894,"_5":12679,"_25963":102652,"_2424":102895},[],"Integrador de dispositivos",{"_2886":60986,"_27469":60910,"_18854":102897,"_5":12679,"_25963":102652,"_2424":102898},[],"El endpoint CMP y Modelo de autenticación",{"_2886":60987,"_27469":60910,"_18854":102900,"_5":12679,"_25963":102652,"_2424":102901},[],"Operaciones soportadas y Códigos de error y diagnóstico",{"_2886":60988,"_27469":60910,"_18854":102903,"_5":12679,"_25963":102659,"_2424":102904},[],"Antes de configurar un DMS para CMP, deben existir los siguientes recursos en la plataforma:",{"_2886":60989,"_27469":60910,"_18854":102906,"_5":12679,"_25963":102659,"_2424":102907},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo. Si se habilita la generación de claves en servidor (KGA), las CAs contra las que se validará el certificado destinatario también deben existir (ver Generación de claves en servidor).",{"_2886":60990,"_27469":60910,"_18854":102909,"_5":12679,"_25963":102659,"_2424":102910},[],"**Un certificado de protección**: CMP firma sus propias respuestas. El DMS necesita un certificado de tipo End Entity cuya clave privada resida en el KMS de Lamassu (`protection_certificate`, ver más abajo).",{"_2886":60991,"_27469":60910,"_18854":102912,"_5":12679,"_25963":102659,"_2424":102913},[],"**Un DMS creado**: la configuración CMP se aplica sobre un DMS existente, no lo crea.",{"_2886":60992,"_27469":60910,"_18854":102915,"_5":12679,"_25963":102659,"_2424":102916},[],"Los ajustes de **CA Distribution** (qué autoridades recibe el dispositivo como anclas de confianza) son idénticos para ambos protocolos y se describen en la visión general del DMS.",{"_2886":60993,"_27469":60910,"_18854":102918,"_5":12679,"_25963":102663,"_2424":102919},[],"Al crear o editar un DMS, el campo `protocol` decide qué bloque de configuración aplica:",{"_2886":60994,"_27469":60910,"_18854":102921,"_5":12679,"_25963":102663,"_2424":102922},[],"Valor",{"_2886":60995,"_27469":60910,"_18854":102924,"_5":12679,"_25963":102663,"_2424":102925},[],"Protocolo",{"_2886":60996,"_27469":60910,"_18854":102927,"_5":12679,"_25963":102663,"_2424":45886},[],{"_2886":60997,"_27469":60910,"_18854":102929,"_5":12679,"_25963":102663,"_2424":102930},[],"EST — ver la guía EST",{"_2886":60998,"_27469":60910,"_18854":102932,"_5":12679,"_25963":102663,"_2424":45892},[],{"_2886":60999,"_27469":60910,"_18854":102934,"_5":12679,"_25963":102663,"_2424":102935},[],"CMP — esta página",{"_2886":61000,"_27469":60910,"_18854":102937,"_5":12679,"_25963":102663,"_2424":102938},[],"Un valor distinto de los dos anteriores hace fallar la creación o edición del DMS con el error `DMS enrollment protocol must be EST_RFC7030 or CMP_RFC9483`. Al cambiar el `protocol` de un DMS, el bloque del protocolo saliente se descarta por completo y se sustituye por el entrante: los ajustes de cada protocolo son autónomos y no se copian entre sí.",{"_2886":61001,"_27469":60910,"_18854":102940,"_5":12679,"_25963":102671,"_2424":102941},[],"Estos campos son comunes a los dos protocolos y significan lo mismo en ambos:",{"_2886":61002,"_27469":60910,"_18854":102943,"_5":12679,"_25963":102671,"_2424":102944},[],"Campo",{"_2886":61003,"_27469":60910,"_18854":102946,"_5":12679,"_25963":102671,"_2424":102947},[],"Descripción",{"_2886":61004,"_27469":60910,"_18854":102949,"_5":12679,"_25963":102671,"_2424":45910},[],{"_2886":61005,"_27469":60910,"_18854":102951,"_5":12679,"_25963":102671,"_2424":102952},[],"CA que firmará los certificados de identidad emitidos por este DMS.",{"_2886":61006,"_27469":60910,"_18854":102954,"_5":12679,"_25963":102671,"_2424":45916},[],{"_2886":61007,"_27469":60910,"_18854":102956,"_5":12679,"_25963":102671,"_2424":102957},[],"`JITP` (*Just-In-Time Provisioning*) crea el dispositivo automáticamente en la primera inscripción, aplicando el perfil de aprovisionamiento; `PRE_REGISTRATION` exige que el dispositivo exista previamente y rechaza lo contrario con `device not preregistered`.",{"_2886":61008,"_27469":60910,"_18854":102959,"_5":12679,"_25963":102671,"_2424":45922},[],{"_2886":61009,"_27469":60910,"_18854":102961,"_5":12679,"_25963":102671,"_2424":102962},[],"Icono, color, metadatos y tags aplicados a cada dispositivo creado en modo JITP.",{"_2886":61010,"_27469":60910,"_18854":102964,"_5":12679,"_25963":102671,"_2424":45928},[],{"_2886":61011,"_27469":60910,"_18854":102966,"_5":12679,"_25963":102671,"_2424":102967},[],"Permite que un dispositivo ya enrolado vuelva a inscribirse. Cuando está inactiva, un segundo intento de `ir`/`cr` sobre un dispositivo existente se rechaza con `forbiddenNewEnrollment`. Si la sustitución de la identidad revoca el certificado anterior (con la razón `superseded`) lo decide `revoke_on_reenrollment`, o el `certificate_behavior` de `cr` — ver Configuración de re-enrollment.",{"_2886":61012,"_27469":60910,"_18854":102969,"_5":12679,"_25963":102671,"_2424":45934},[],{"_2886":61013,"_27469":60910,"_18854":102971,"_5":12679,"_25963":102671,"_2424":102972},[],"**Sin efecto en CMP.** El servidor sintetiza el CSR a partir del `CertTemplate` (su firma es sustituida por un valor ficticio) y la prueba de posesión se establece por otras vías: la POPO de `ir`/`cr`, el CSR PKCS#10 de `p10cr` (verificado siempre) o la protección de `kur`.",{"_2886":61014,"_27469":60910,"_18854":102974,"_5":12679,"_25963":102675,"_2424":102975},[],"`auth_mode` define cómo el DMS valida la identidad del solicitante. CMP reconoce los mismos cuatro modos que EST, pero el mecanismo cambia: **la autenticación se verifica dentro del propio mensaje CMP, no en la capa de transporte**.",{"_2886":61015,"_27469":60910,"_18854":102977,"_5":12679,"_25963":102675,"_2424":102978},[],"Modo",{"_2886":61016,"_27469":60910,"_18854":102980,"_5":12679,"_25963":102675,"_2424":102947},[],{"_2886":61017,"_27469":60910,"_18854":102982,"_5":12679,"_25963":102675,"_2424":45948},[],{"_2886":61018,"_27469":60910,"_18854":102984,"_5":12679,"_25963":102675,"_2424":102985},[],"El mensaje debe ir **protegido por firma** con el certificado del dispositivo (`extraCerts[0]` del `PKIMessage`), validado contra las CAs declaradas en `client_certificate_settings.validation_cas`. No es mTLS: es la firma sobre el `PKIMessage` (RFC 9483 §3.2).",{"_2886":61019,"_27469":60910,"_18854":102987,"_5":12679,"_25963":102675,"_2424":45954},[],{"_2886":61020,"_27469":60910,"_18854":102989,"_5":12679,"_25963":102675,"_2424":102990},[],"Combina los dos controles: firma válida **y** aprobación del webhook.",{"_2886":61021,"_27469":60910,"_18854":102992,"_5":12679,"_25963":102675,"_2424":45960},[],{"_2886":61022,"_27469":60910,"_18854":102994,"_5":12679,"_25963":102675,"_2424":102995},[],"La decisión de autorización se delega en un servicio HTTP externo, con el mismo contrato que en EST. El mensaje puede llegar sin protección.",{"_2886":61023,"_27469":60910,"_18854":102997,"_5":12679,"_25963":102675,"_2424":45966},[],{"_2886":61024,"_27469":60910,"_18854":102999,"_5":12679,"_25963":102675,"_2424":103000},[],"Sin autenticación obligatoria. El mensaje puede llegar sin protección; si trae una firma, igualmente se valida. &#x2A;*Exclusivo para laboratorios o redes de aprovisionamiento aisladas.**",{"_2886":61025,"_27469":60910,"_18854":103002,"_5":12679,"_25963":102675,"_2424":103003},[],"Un DMS cuya `auth_mode` está vacía o no definida se considera mal configurado: toda solicitud se rechaza con `DMS auth mode not supported`, en lugar de aceptarse sin autenticación. El valor `NONE` se acepta como alias heredado de `NO_AUTH` desde el panel de administración.",{"_2886":61026,"_27469":60910,"_18854":103005,"_5":12679,"_25963":102675,"_2424":103006},[],"Cuando el modo incluye `CLIENT_CERTIFICATE`, se configuran los mismos parámetros que en EST: **Validation CAs**, **Chain Validation Level** (`-1` valida la cadena completa) y **Allow Authenticating Expired Certificates**. Cuando incluye `EXTERNAL_WEBHOOK`, se configuran los mismos parámetros de webhook que en EST (URL, método, timeout — 10 segundos por defecto — y modo de autenticación del webhook). El contrato del servicio webhook es idéntico en ambos protocolos; consulte la sección equivalente de la guía EST para el detalle de cada campo y la referencia del webhook de autorización para el esquema.",{"_2886":61027,"_27469":60910,"_18854":103008,"_5":12679,"_25963":102675,"_2424":103009},[],"A diferencia de EST, CMP no tiene un modo de autenticación separado para la renovación: `kur` siempre se autentica con la protección por firma del propio certificado que se renueva.",{"_2886":61028,"_27469":60910,"_18854":103011,"_5":12679,"_25963":102679,"_2424":103012},[],"A diferencia de EST, CMP incluye un protocolo de confirmación explícito (RFC 4210 §5.2.8) y admite un flujo de aprobación diferida:",{"_2886":61029,"_27469":60910,"_18854":103014,"_5":12679,"_25963":102679,"_2424":102944},[],{"_2886":61030,"_27469":60910,"_18854":103016,"_5":12679,"_25963":102679,"_2424":103017},[],"Tipo",{"_2886":61031,"_27469":60910,"_18854":103019,"_5":12679,"_25963":102679,"_2424":102947},[],{"_2886":61032,"_27469":60910,"_18854":103021,"_5":12679,"_25963":102679,"_2424":45991},[],{"_2886":61033,"_27469":60910,"_18854":103023,"_5":12679,"_25963":102679,"_2424":86032},[],{"_2886":61034,"_27469":60910,"_18854":103025,"_5":12679,"_25963":102679,"_2424":103026},[],"Permite **omitir** el paso `certConf` cuando el dispositivo solicita confirmación implícita (`id-it-implicitConfirm` en `generalInfo`). Solo tiene efecto si el dispositivo también la solicita; la solicitud sola no la fuerza. Desactivado por defecto.",{"_2886":61035,"_27469":60910,"_18854":103028,"_5":12679,"_25963":102679,"_2424":45999},[],{"_2886":61036,"_27469":60910,"_18854":103030,"_5":12679,"_25963":102679,"_2424":103031},[],"duración",{"_2886":61037,"_27469":60910,"_18854":103033,"_5":12679,"_25963":102679,"_2424":103034},[],"Ventana de espera del `certConf` (por ejemplo `30s`, `5m`, `1h`). Un valor cero o negativo usa el por defecto: **5 minutos**.",{"_2886":61038,"_27469":60910,"_18854":103036,"_5":12679,"_25963":102679,"_2424":46007},[],{"_2886":61039,"_27469":60910,"_18854":103038,"_5":12679,"_25963":102679,"_2424":46010},[],{"_2886":61040,"_27469":60910,"_18854":103040,"_5":12679,"_25963":102679,"_2424":103041},[],"`direct` (por defecto) emite el certificado en línea, en la misma respuesta a `ir`/`cr`/`kur`/`p10cr`. `phased` retiene la solicitud hasta que un administrador la apruebe; el dispositivo recupera el resultado con `pollReq`. La generación de claves en servidor y la certificación cruzada tienen su propio flujo y no dependen de este campo.",{"_2886":61041,"_27469":60910,"_18854":103043,"_5":12679,"_25963":102679,"_2424":46016},[],{"_2886":61042,"_27469":60910,"_18854":103045,"_5":12679,"_25963":102679,"_2424":103031},[],{"_2886":61043,"_27469":60910,"_18854":103047,"_5":12679,"_25963":102679,"_2424":103048},[],"Solo aplica con `workflow: phased`. Tiempo que una transacción permanece `PENDING` esperando aprobación. Sin valor, el por defecto es **7 días**.",{"_2886":61044,"_27469":60910,"_18854":103050,"_5":12679,"_25963":102683,"_2424":103051},[],"**Protection Certificate** (`protection_certificate`): número de serie del certificado End Entity, respaldado por el KMS, con el que el DMS protege (firma) sus respuestas CMP. El servidor no obliga a configurarlo, pero sin él **todas** las respuestas — incluidos los mensajes de error — salen sin protección, y los clientes CMP estándar (`openssl cmp` incluido) rechazan por defecto las respuestas sin protección. En la práctica es imprescindible.",{"_2886":61045,"_27469":60910,"_18854":103053,"_5":12679,"_25963":102683,"_2424":103054},[],"**Enforce POPO** (`enforce_popo`): opción heredada que **ya no gobierna ninguna verificación**. La política de prueba de posesión de `ir`/`cr` vive en su bloque por operación (`proof_of_possession.required`), `kur` y `rr` están siempre protegidos por firma como invariantes del protocolo, y la firma del CSR de `p10cr` se verifica siempre. El campo persiste y round-trip en la API, pero su valor no altera el comportamiento.",{"_2886":61046,"_27469":60910,"_18854":103056,"_5":12679,"_25963":102683,"_2424":103057},[],"**Expected Authenticator** (`expected_authenticator`): respuesta compartida que se compara contra el control `id-regCtrl-authenticator` (RFC 4211 §6.2) cuando una solicitud de emisión (`ir`/`cr`/`kur`) lo incluye. Vacío por defecto: un control presente se acepta sin comparar su valor. Con valor configurado, un control cuyo contenido no coincide se rechaza con `incorrectData`. **Marcado como legado**: almacena un secreto en claro en el DMS; la configuración nueva debe usar los controles `registration_token`/`authenticator_control` por operación, que solo almacenan un modo.",{"_2886":61047,"_27469":60910,"_18854":103059,"_5":12679,"_25963":102687,"_2424":103060},[],"Además de los campos generales anteriores, cada operación CMP tiene su propio bloque de configuración con un interruptor `enabled` y una política específica. Las operaciones de emisión (`ir`, `cr`, `p10cr`, `kur`) admiten además `policy_overrides`:",{"_2886":61048,"_27469":60910,"_18854":103062,"_5":12679,"_25963":102687,"_2424":103063},[],"`policy_overrides.workflow`: `inherit` (toma el `workflow` general), `direct` o `phased`.",{"_2886":61049,"_27469":60910,"_18854":103065,"_5":12679,"_25963":102687,"_2424":103066},[],"`policy_overrides.confirmation`: `inherit`, `implicit` (fuerza disposición a la confirmación implícita) o `explicit` (fuerza el `certConf`).",{"_2886":61050,"_27469":60910,"_18854":103068,"_5":12679,"_25963":102687,"_2424":103069},[],"`policy_overrides.issuance_profile_id`: fija un perfil de emisión específico para esa operación. Se aplica en `ir`, `cr` y `p10cr`; el `kur` renueva siempre con el perfil general del DMS.",{"_2886":61051,"_27469":60910,"_18854":103071,"_5":12679,"_25963":102687,"_2424":103072},[],"La confirmación implícita efectiva siempre requiere además que el dispositivo la pida (`id-it-implicitConfirm`): el ajuste solo expresa la disposición del servidor.",{"_2886":61052,"_27469":60910,"_18854":103074,"_5":12679,"_25963":102687,"_2424":103075},[],"Cada bloque por operación detecta si nunca se configuró observando un **campo clave**: `identity_source` en `ir`, `certificate_behavior` en `cr`, `key_policy` en `kur`, `authorization` en `rr`, `access_policy` en `genm` y `workflow` en `ccr`. Si ese campo llega vacío, el bloque se rellena íntegro con sus valores por defecto en cada lectura del DMS — incluido cualquier otro campo que se haya enviado. Para ajustar un campo secundario (por ejemplo, `maximum_active_certificates` de `cr`) debe fijarse también el campo clave del bloque, o la resolución lo devuelve a su valor por defecto. `p10cr` no tiene campo clave: permanece deshabilitado salvo que se ponga `enabled: true` explícitamente.",{"_2886":61053,"_27469":60910,"_18854":103077,"_5":12679,"_25963":102691,"_2424":103078},[],"Alta inicial de un dispositivo nuevo (RFC 9483 §4.1.1), equivalente al `/simpleenroll` de EST. Habilitado por defecto.",{"_2886":61054,"_27469":60910,"_18854":103080,"_5":12679,"_25963":102691,"_2424":102944},[],{"_2886":61055,"_27469":60910,"_18854":103082,"_5":12679,"_25963":102691,"_2424":102947},[],{"_2886":61056,"_27469":60910,"_18854":103084,"_5":12679,"_25963":102691,"_2424":46058},[],{"_2886":61057,"_27469":60910,"_18854":103086,"_5":12679,"_25963":102691,"_2424":103087},[],"Habilita la operación. Deshabilitarla rechaza cualquier `ir` con `notAuthorized`.",{"_2886":61058,"_27469":60910,"_18854":103089,"_5":12679,"_25963":102691,"_2424":46064},[],{"_2886":61059,"_27469":60910,"_18854":103091,"_5":12679,"_25963":102691,"_2424":103092},[],"Si la POPO es obligatoria. Por defecto `true`: un `ir` sin prueba de posesión aceptable se rechaza con `badPOP`.",{"_2886":61060,"_27469":60910,"_18854":103094,"_5":12679,"_25963":102691,"_2424":46070},[],{"_2886":61061,"_27469":60910,"_18854":103096,"_5":12679,"_25963":102691,"_2424":103097},[],"Métodos de POPO aceptados: `signature` (POPOSigningKey sobre el CertRequest), `trusted_ra` (`raVerified` de una RA de confianza con EKU `id-kp-cmcRA`), `challenge_response` (reto-respuesta `popdecc`/`popdecr`) y `encrypted_certificate` (el certificado se entrega cifrado al destinatario, que demuestra posesión al descifrarlo). Por defecto `signature` + `trusted_ra`. Una lista vacía no admite ningún método.",{"_2886":61062,"_27469":60910,"_18854":103099,"_5":12679,"_25963":102691,"_2424":46076},[],{"_2886":61063,"_27469":60910,"_18854":103101,"_5":12679,"_25963":102691,"_2424":103102},[],"Control RFC 4211 §6.1 con modo `disabled` (por defecto), `optional` o `required`. El modo gobierna la **presencia** del control: `disabled` rechaza un `ir` que lo traiga; `required` exige traerlo; `optional` lo procesa cuando está presente. Los valores de regToken son credenciales de un solo uso, aprovisionadas fuera del DMS (nunca se almacenan en la configuración): un valor ya consumido se rechaza con `the regToken control was already used (RFC 4211 §6.1)`, y el token se quema aunque la emisión falle después.",{"_2886":61064,"_27469":60910,"_18854":103104,"_5":12679,"_25963":102691,"_2424":46082},[],{"_2886":61065,"_27469":60910,"_18854":103106,"_5":12679,"_25963":102691,"_2424":103107},[],"Control RFC 4211 §6.2 con los mismos tres modos. Con `expected_authenticator` configurado, `optional`/`required` validan el valor; sin él, la presencia basta.",{"_2886":61066,"_27469":60910,"_18854":103109,"_5":12679,"_25963":102691,"_2424":46088},[],{"_2886":61067,"_27469":60910,"_18854":103111,"_5":12679,"_25963":102691,"_2424":103112},[],"Métodos de entrega de la clave generada que acepta esta operación: `rsa_key_transport` y/o `ecdh_key_agreement`. Sin configurar se aceptan ambos; una lista explícitamente vacía deniega cualquier entrega de clave generada.",{"_2886":61068,"_27469":60910,"_18854":103114,"_5":12679,"_25963":102691,"_2424":46094},[],{"_2886":61069,"_27469":60910,"_18854":103116,"_5":12679,"_25963":102691,"_2424":103117},[],"Se funde con el interruptor general `server_key_gen_enabled` y con el de `cr` en una única puerta de KGA (ver Generación de claves en servidor).",{"_2886":61070,"_27469":60910,"_18854":103119,"_5":12679,"_25963":102691,"_2424":46100},[],{"_2886":61071,"_27469":60910,"_18854":103121,"_5":12679,"_25963":102691,"_2424":103122},[],"Selecciona de dónde se toma la identidad cuando el subject llega vacío (`subject_only` / `subject_or_san`). **Persistido pero aún no aplicado**: el comportamiento actual es fijo — con subject vacío, la identidad se deduce del SAN (`dNSName`, correo, URI, IP, en ese orden) y el certificado emitido conserva el subject NULL-DN.",{"_2886":61072,"_27469":60910,"_18854":103124,"_5":12679,"_25963":102691,"_2424":46106},[],{"_2886":61073,"_27469":60910,"_18854":103126,"_5":12679,"_25963":102691,"_2424":103127},[],"Ver la introducción de esta sección.",{"_2886":61074,"_27469":60910,"_18854":103129,"_5":12679,"_25963":102694,"_2424":103130},[],"Emisión para un dispositivo que ya participa en la PKI (RFC 9483 §4.1.2). Habilitado por defecto. Comparte con `ir` la estructura de `proof_of_possession`, `central_key_generation` y `policy_overrides`, y añade:",{"_2886":61075,"_27469":60910,"_18854":103132,"_5":12679,"_25963":102694,"_2424":102944},[],{"_2886":61076,"_27469":60910,"_18854":103134,"_5":12679,"_25963":102694,"_2424":102947},[],{"_2886":61077,"_27469":60910,"_18854":103136,"_5":12679,"_25963":102694,"_2424":46119},[],{"_2886":61078,"_27469":60910,"_18854":103138,"_5":12679,"_25963":102694,"_2424":103139},[],"Por defecto `true`: un `cr` contra un dispositivo no registrado se rechaza con `certification request requires a pre-existing device identity`. Desactivarlo permite que un `cr` también dé de alta el dispositivo (sujeto al modo de registro y, si el dispositivo ya existe, a `enable_replaceable_enrollment`).",{"_2886":61079,"_27469":60910,"_18854":103141,"_5":12679,"_25963":102694,"_2424":46125},[],{"_2886":61080,"_27469":60910,"_18854":103143,"_5":12679,"_25963":102694,"_2424":103144},[],"`additional` (por defecto) emite un certificado más sin revocar el anterior; `replace` sustituye el certificado activo (el anterior se revoca como `superseded` tras emitir y vincular el nuevo). El modelo de datos mantiene un único slot de identidad activa por dispositivo, así que `additional` no crea una segunda identidad activa en paralelo: solo evita revocar la anterior.",{"_2886":61081,"_27469":60910,"_18854":103146,"_5":12679,"_25963":102694,"_2424":46131},[],{"_2886":61082,"_27469":60910,"_18854":103148,"_5":12679,"_25963":102694,"_2424":103149},[],"Límite de certificados no revocados por dispositivo. Por defecto `2`; `0` desactiva el límite. El recuento se revalida bajo bloqueo justo antes de firmar, para cerrar la carrera entre dos `cr` concurrentes.",{"_2886":61083,"_27469":60910,"_18854":103151,"_5":12679,"_25963":102694,"_2424":46137},[],{"_2886":61084,"_27469":60910,"_18854":103153,"_5":12679,"_25963":102694,"_2424":103154},[],"Lista blanca de perfiles de emisión permitidos para esta operación. El perfil resuelto (fijado por `policy_overrides.issuance_profile_id` o el general del DMS) debe estar en la lista; vacía no restringe.",{"_2886":61085,"_27469":60910,"_18854":103156,"_5":12679,"_25963":102694,"_2424":103157},[],"`cr` hereda además las salvaguardas generales del alta: el dispositivo debe pertenecer a este DMS (un dispositivo registrado en otro DMS se rechaza con `device already registered to another DMS`) y si ya existe se exige `enable_replaceable_enrollment`. Cuando un `cr` con `replace` sustituye la identidad, la política `key_policy` de `kur` también se aplica: con `require_new_key`, el `cr` no puede sustituir el certificado activo usando la misma clave pública.",{"_2886":61086,"_27469":60910,"_18854":103159,"_5":12679,"_25963":102697,"_2424":103160},[],"Alta con un CSR PKCS#10 completo en lugar de la estructura CRMF (RFC 9483 §4.1.4). **Llega deshabilitado**: hay que activar `enabled: true` en el DMS o toda solicitud `p10cr` se rechaza con `notAuthorized`.",{"_2886":61087,"_27469":60910,"_18854":103162,"_5":12679,"_25963":102697,"_2424":102944},[],{"_2886":61088,"_27469":60910,"_18854":103164,"_5":12679,"_25963":102697,"_2424":102947},[],{"_2886":61089,"_27469":60910,"_18854":103166,"_5":12679,"_25963":102697,"_2424":46058},[],{"_2886":61090,"_27469":60910,"_18854":103168,"_5":12679,"_25963":102697,"_2424":103169},[],"Habilita la operación. Deshabilitado por defecto.",{"_2886":61091,"_27469":60910,"_18854":103171,"_5":12679,"_25963":102697,"_2424":46137},[],{"_2886":61092,"_27469":60910,"_18854":103173,"_5":12679,"_25963":102697,"_2424":103174},[],"Lista blanca de perfiles de emisión permitidos, igual que en `cr`.",{"_2886":61093,"_27469":60910,"_18854":103176,"_5":12679,"_25963":102697,"_2424":46106},[],{"_2886":61094,"_27469":60910,"_18854":103178,"_5":12679,"_25963":102697,"_2424":103127},[],{"_2886":61095,"_27469":60910,"_18854":103180,"_5":12679,"_25963":102697,"_2424":103181},[],"Invariantes fijos del protocolo, no configurables: la firma del propio CSR **es** la prueba de posesión y se verifica siempre; no hay POPO CRMF que configurar; la generación de claves en servidor no está disponible (el cliente aporta su clave); y los controles CRMF de registro (`regToken`, `authenticator`) no aplican. La respuesta es un `cp` con `certReqId` `-1`, valor que el `certConf` posterior debe usar (RFC 4210 Errata 8806).",{"_2886":61096,"_27469":60910,"_18854":103183,"_5":12679,"_25963":102700,"_2424":103184},[],"Renovación de un certificado (RFC 9483 §4.1.3), equivalente al `/simplereenroll` de EST. Habilitado por defecto. El mensaje debe ir **protegido por firma con el certificado que se renueva** — invariante del protocolo, no configurable.",{"_2886":61097,"_27469":60910,"_18854":103186,"_5":12679,"_25963":102700,"_2424":102944},[],{"_2886":61098,"_27469":60910,"_18854":103188,"_5":12679,"_25963":102700,"_2424":102947},[],{"_2886":61099,"_27469":60910,"_18854":103190,"_5":12679,"_25963":102700,"_2424":46058},[],{"_2886":61100,"_27469":60910,"_18854":103192,"_5":12679,"_25963":102700,"_2424":103193},[],"Habilita la operación.",{"_2886":61101,"_27469":60910,"_18854":103195,"_5":12679,"_25963":102700,"_2424":46182},[],{"_2886":61102,"_27469":60910,"_18854":103197,"_5":12679,"_25963":102700,"_2424":103198},[],"`require_new_key` (por defecto) exige una clave pública distinta a la del certificado que se renueva (`key update must present a new key`); `permit_reuse` permite renovar sin rotar la clave.",{"_2886":61103,"_27469":60910,"_18854":103200,"_5":12679,"_25963":102700,"_2424":46188},[],{"_2886":61104,"_27469":60910,"_18854":103202,"_5":12679,"_25963":102700,"_2424":103203},[],"Cuánto puede variar la identidad respecto al certificado vigente: `forbid` (por defecto; subject y SAN deben coincidir), `san_only` (el subject debe coincidir; el SAN puede variar) o `subject_and_san` (cualquier cambio).",{"_2886":61105,"_27469":60910,"_18854":103205,"_5":12679,"_25963":102700,"_2424":46194},[],{"_2886":61106,"_27469":60910,"_18854":103207,"_5":12679,"_25963":102700,"_2424":103208},[],"Igual que en las demás operaciones de emisión.",{"_2886":61107,"_27469":60910,"_18854":103210,"_5":12679,"_25963":102700,"_2424":103211},[],"Invariantes fijos: solo puede haber una actualización de clave abierta por certificado (un segundo `kur` mientras el primero espera `certConf` se rechaza con `badRequest`); la identidad anterior sigue activa hasta la confirmación; y un certificado nuevo nunca confirmado se revoca al expirar la ventana. El control opcional `id-regCtrl-oldCertID`, si se envía, debe referenciar exactamente el certificado que se renueva (`badCertId` en caso contrario). `policy_overrides.issuance_profile_id` está definido en el esquema pero **aún no aplicado** en `kur`.",{"_2886":61108,"_27469":60910,"_18854":103213,"_5":12679,"_25963":102703,"_2424":103214},[],"Revocación vía CMP (RFC 9483 §4.2). Habilitado por defecto. El mensaje **siempre debe ir protegido por firma** — invariante del protocolo, independientemente del `auth_mode`: un `rr` sin firma nunca se acepta, ni siquiera en modo `NO_AUTH`.",{"_2886":61109,"_27469":60910,"_18854":103216,"_5":12679,"_25963":102703,"_2424":102944},[],{"_2886":61110,"_27469":60910,"_18854":103218,"_5":12679,"_25963":102703,"_2424":102947},[],{"_2886":61111,"_27469":60910,"_18854":103220,"_5":12679,"_25963":102703,"_2424":46058},[],{"_2886":61112,"_27469":60910,"_18854":103222,"_5":12679,"_25963":102703,"_2424":103193},[],{"_2886":61113,"_27469":60910,"_18854":103224,"_5":12679,"_25963":102703,"_2424":46214},[],{"_2886":61114,"_27469":60910,"_18854":103226,"_5":12679,"_25963":102703,"_2424":103227},[],"`self_only` (por defecto): solo el propio dispositivo puede revocar su certificado — el firmante del mensaje debe ser el certificado revocado. `self_and_trusted_ra`: una entidad de gestión PKI de confianza (EKU `id-kp-cmcRA` validado contra las CAs del DMS) puede además revocar el certificado de otro.",{"_2886":61115,"_27469":60910,"_18854":103229,"_5":12679,"_25963":102703,"_2424":46220},[],{"_2886":61116,"_27469":60910,"_18854":103231,"_5":12679,"_25963":102703,"_2424":103232},[],"Por defecto desactivado. Permite reactivar un certificado en estado revocado mediante la razón `removeFromCRL`; la reactivación solo es posible sobre certificados cuya revocación fue una suspensión (`certificateHold`).",{"_2886":61117,"_27469":60910,"_18854":103234,"_5":12679,"_25963":102703,"_2424":46226},[],{"_2886":61118,"_27469":60910,"_18854":103236,"_5":12679,"_25963":102703,"_2424":103237},[],"Lista blanca de razones de revocación aceptadas. Por defecto `unspecified`, `key_compromise`, `cessation_of_operation` y `superseded`. Valores admitidos: `unspecified`, `key_compromise`, `ca_compromise`, `affiliation_changed`, `superseded`, `cessation_of_operation`, `privilege_withdrawn`, `aa_compromise`. La razón `certificateHold` no está en la lista ni está sujeta a ella: suspende el certificado y es la única revocación reversible; la reactivación la gobierna `allow_revival`.",{"_2886":61119,"_27469":60910,"_18854":103239,"_5":12679,"_25963":102703,"_2424":46232},[],{"_2886":61120,"_27469":60910,"_18854":103241,"_5":12679,"_25963":102703,"_2424":103242},[],"Por defecto `true`: exige el EKU `id-kp-cmcRA` en el firmante RA.",{"_2886":61121,"_27469":60910,"_18854":103244,"_5":12679,"_25963":102703,"_2424":46238},[],{"_2886":61122,"_27469":60910,"_18854":103246,"_5":12679,"_25963":102703,"_2424":103247},[],"Fija qué CAs deben validar el certificado del RA; una lista explícita sustituye el límite general. Vacío: se aplica el límite de confianza general del DMS (la `EnrollmentCA` más las CAs de validación de autenticación y de re-enrollment).",{"_2886":61123,"_27469":60910,"_18854":103249,"_5":12679,"_25963":102703,"_2424":103250},[],"Notas operativas: la revocación de un certificado ya caducado nunca está permitida (el servicio de CA rechaza transiciones de estado sobre certificados expirados); el certificado objetivo debe pertenecer a un dispositivo gestionado por este DMS — un RA de confianza no puede revocar certificados de otros DMS (`notAuthorized`); mientras un certificado tenga una actualización de clave pendiente de confirmar, su estado no puede cambiar (`badRequest`); y un `rr` no puede repetirse con el mismo `transactionID` (`transactionIdInUse`).",{"_2886":61124,"_27469":60910,"_18854":103252,"_5":12679,"_25963":102706,"_2424":103253},[],"Canal de descubrimiento (RFC 9483 §4.3): el dispositivo consulta capacidades del DMS y este responde con un `genp`. No emite certificados. Habilitado por defecto.",{"_2886":61125,"_27469":60910,"_18854":103255,"_5":12679,"_25963":102706,"_2424":102944},[],{"_2886":61126,"_27469":60910,"_18854":103257,"_5":12679,"_25963":102706,"_2424":102947},[],{"_2886":61127,"_27469":60910,"_18854":103259,"_5":12679,"_25963":102706,"_2424":46254},[],{"_2886":61128,"_27469":60910,"_18854":103261,"_5":12679,"_25963":102706,"_2424":103262},[],"`public_discovery` (por defecto) responde sin exigir mensaje protegido; `require_signed` rechaza un `genm` sin firma con `notAuthorized`.",{"_2886":61129,"_27469":60910,"_18854":103264,"_5":12679,"_25963":102706,"_2424":46260},[],{"_2886":61130,"_27469":60910,"_18854":103266,"_5":12679,"_25963":102706,"_2424":103267},[],"Algoritmo simétrico que el DMS anuncia para el cifrado de contenido hacia la CA: `aes128_cbc`, `aes192_cbc`, `aes256_cbc` (por defecto), `aes128_gcm`, `aes192_gcm` o `aes256_gcm`.",{"_2886":61131,"_27469":60910,"_18854":103269,"_5":12679,"_25963":102706,"_2424":46266},[],{"_2886":61132,"_27469":60910,"_18854":103271,"_5":12679,"_25963":102706,"_2424":103272},[],"Interruptores independientes por tipo de información — ver la tabla siguiente.",{"_2886":61133,"_27469":60910,"_18854":103274,"_5":12679,"_25963":102706,"_2424":103275},[],"Cada interruptor `information_types.*` corresponde a un tipo de información del RFC 9483 §4.3. Los tipos puramente descriptivos (estáticos) están activados por defecto; los que dependen de la configuración concreta del DMS — sus CAs, su perfil de emisión o su cliente VA — quedan desactivados hasta que el operador los habilite:",{"_2886":61134,"_27469":60910,"_18854":103277,"_5":12679,"_25963":102706,"_2424":103278},[],"Tipo de información",{"_2886":61135,"_27469":60910,"_18854":103280,"_5":12679,"_25963":102706,"_2424":46278},[],{"_2886":61136,"_27469":60910,"_18854":103282,"_5":12679,"_25963":102706,"_2424":103283},[],"Por defecto",{"_2886":61137,"_27469":60910,"_18854":103285,"_5":12679,"_25963":102706,"_2424":103286},[],"Contenido de la respuesta",{"_2886":61138,"_27469":60910,"_18854":103288,"_5":12679,"_25963":102706,"_2424":46286},[],{"_2886":61139,"_27469":60910,"_18854":103290,"_5":12679,"_25963":102706,"_2424":46289},[],{"_2886":61140,"_27469":60910,"_18854":103292,"_5":12679,"_25963":102706,"_2424":103293},[],"Activado",{"_2886":61141,"_27469":60910,"_18854":103295,"_5":12679,"_25963":102706,"_2424":103296},[],"Certificados de las CAs del DMS, con la misma distribución de confianza que el `/cacerts` de EST.",{"_2886":61142,"_27469":60910,"_18854":103298,"_5":12679,"_25963":102706,"_2424":46298},[],{"_2886":61143,"_27469":60910,"_18854":103300,"_5":12679,"_25963":102706,"_2424":46301},[],{"_2886":61144,"_27469":60910,"_18854":103302,"_5":12679,"_25963":102706,"_2424":103293},[],{"_2886":61145,"_27469":60910,"_18854":103304,"_5":12679,"_25963":102706,"_2424":103305},[],"Algoritmos de firma admitidos: RSA y ECC (valor estático).",{"_2886":61146,"_27469":60910,"_18854":103307,"_5":12679,"_25963":102706,"_2424":46309},[],{"_2886":61147,"_27469":60910,"_18854":103309,"_5":12679,"_25963":102706,"_2424":46312},[],{"_2886":61148,"_27469":60910,"_18854":103311,"_5":12679,"_25963":102706,"_2424":103293},[],{"_2886":61149,"_27469":60910,"_18854":103313,"_5":12679,"_25963":102706,"_2424":103314},[],"Algoritmos de cifrado/acuerdo admitidos: RSA (valor estático).",{"_2886":61150,"_27469":60910,"_18854":103316,"_5":12679,"_25963":102706,"_2424":46260},[],{"_2886":61151,"_27469":60910,"_18854":103318,"_5":12679,"_25963":102706,"_2424":46322},[],{"_2886":61152,"_27469":60910,"_18854":103320,"_5":12679,"_25963":102706,"_2424":103293},[],{"_2886":61153,"_27469":60910,"_18854":103322,"_5":12679,"_25963":102706,"_2424":103323},[],"El algoritmo configurado en `preferred_symmetric_algorithm`.",{"_2886":61154,"_27469":60910,"_18854":103325,"_5":12679,"_25963":102706,"_2424":46330},[],{"_2886":61155,"_27469":60910,"_18854":103327,"_5":12679,"_25963":102706,"_2424":46333},[],{"_2886":61156,"_27469":60910,"_18854":103329,"_5":12679,"_25963":102706,"_2424":103293},[],{"_2886":61157,"_27469":60910,"_18854":103331,"_5":12679,"_25963":102706,"_2424":103332},[],"Negociación de idioma para `PKIFreeText`; el único soportado es `en`.",{"_2886":61158,"_27469":60910,"_18854":103334,"_5":12679,"_25963":102706,"_2424":46341},[],{"_2886":61159,"_27469":60910,"_18854":103336,"_5":12679,"_25963":102706,"_2424":46344},[],{"_2886":61160,"_27469":60910,"_18854":103338,"_5":12679,"_25963":102706,"_2424":103339},[],"Desactivado",{"_2886":61161,"_27469":60910,"_18854":103341,"_5":12679,"_25963":102706,"_2424":103342},[],"Actualización de la raíz vigente (`newWithNew`/`newWithOld`), comparada contra la raíz que el dispositivo declara.",{"_2886":61162,"_27469":60910,"_18854":103344,"_5":12679,"_25963":102706,"_2424":46353},[],{"_2886":61163,"_27469":60910,"_18854":103346,"_5":12679,"_25963":102706,"_2424":46356},[],{"_2886":61164,"_27469":60910,"_18854":103348,"_5":12679,"_25963":102706,"_2424":103339},[],{"_2886":61165,"_27469":60910,"_18854":103350,"_5":12679,"_25963":102706,"_2424":103351},[],"Plantilla derivada del perfil de emisión del DMS: algoritmos y tamaños de clave admitidos y validez del certificado.",{"_2886":61166,"_27469":60910,"_18854":103353,"_5":12679,"_25963":102706,"_2424":46364},[],{"_2886":61167,"_27469":60910,"_18854":103355,"_5":12679,"_25963":102706,"_2424":46367},[],{"_2886":61168,"_27469":60910,"_18854":103357,"_5":12679,"_25963":102706,"_2424":103339},[],{"_2886":61169,"_27469":60910,"_18854":103359,"_5":12679,"_25963":102706,"_2424":103360},[],"CRL vigente, servida a través del cliente VA del servicio DMS Manager.",{"_2886":61170,"_27469":60910,"_18854":103362,"_5":12679,"_25963":102706,"_2424":46375},[],{"_2886":61171,"_27469":60910,"_18854":103364,"_5":12679,"_25963":102706,"_2424":46378},[],{"_2886":61172,"_27469":60910,"_18854":103366,"_5":12679,"_25963":102706,"_2424":103339},[],{"_2886":61173,"_27469":60910,"_18854":103368,"_5":12679,"_25963":102706,"_2424":103369},[],"Actualizaciones de CRL por emisor, solo las más recientes que la que el dispositivo declara.",{"_2886":61174,"_27469":60910,"_18854":103371,"_5":12679,"_25963":102706,"_2424":46386},[],{"_2886":61175,"_27469":60910,"_18854":103373,"_5":12679,"_25963":102706,"_2424":46389},[],{"_2886":61176,"_27469":60910,"_18854":103375,"_5":12679,"_25963":102706,"_2424":103339},[],{"_2886":61177,"_27469":60910,"_18854":103377,"_5":12679,"_25963":102706,"_2424":103378},[],"Siempre se responde sin valor — Lamassu no provisiona un certificado de cifrado de protocolo dedicado.",{"_2886":61178,"_27469":60910,"_18854":103380,"_5":12679,"_25963":102706,"_2424":103381},[],"Reglas del intercambio: un `genm` que solicite un tipo deshabilitado se rechaza por completo con `notAuthorized`; los tipos `caCerts`, `certReqTemplate`, `currentCRL`, `signKeyPairTypes`, `encKeyPairTypes` y `preferredSymmAlg` deben llegar sin `infoValue`; `supportedLangTags` debe llegar con la lista de lenguajes ofrecidos (si no se soporta ninguno, `badRequest`); `crlStatusList` debe llevar al menos una entrada `CRLStatus`. Un tipo habilitado cuyo proveedor de datos no tenga nada que devolver (por ejemplo, un DMS sin cliente VA para los tipos de CRL, o una raíz sin actualización más reciente) responde con el `infoValue` ausente — un *no disponible* válido según el RFC, no un error. El tipo `id-it-revPassphrase` (RFC 4210bis §5.3.19.9) está deshabilitado de forma permanente: no está conectado al flujo de revocación.",{"_2886":61179,"_27469":60910,"_18854":103383,"_5":12679,"_25963":102709,"_2424":103384},[],"Certificación cruzada entre CAs (RFC 4210bis §5.3.11): una CA pide a la CA de enrolamiento del DMS un certificado cruzado para su identidad. Es una operación privilegiada CA-a-CA, **deshabilitada por defecto**.",{"_2886":61180,"_27469":60910,"_18854":103386,"_5":12679,"_25963":102709,"_2424":102944},[],{"_2886":61181,"_27469":60910,"_18854":103388,"_5":12679,"_25963":102709,"_2424":102947},[],{"_2886":61182,"_27469":60910,"_18854":103390,"_5":12679,"_25963":102709,"_2424":46058},[],{"_2886":61183,"_27469":60910,"_18854":103392,"_5":12679,"_25963":102709,"_2424":103169},[],{"_2886":61184,"_27469":60910,"_18854":103394,"_5":12679,"_25963":102709,"_2424":46007},[],{"_2886":61185,"_27469":60910,"_18854":103396,"_5":12679,"_25963":102709,"_2424":103397},[],"`administrator_approval` (por defecto) o `direct`. Es independiente del `workflow` general de enrollment: la aprobación administrativa de un `ccr` no se mezcla con la de `ir`/`cr`. Con `administrator_approval`, la solicitud queda `PENDING` (tipo `ccr`) y el CA solicitante recupera el certificado cruzado con `pollReq`.",{"_2886":61186,"_27469":60910,"_18854":103399,"_5":12679,"_25963":102709,"_2424":46416},[],{"_2886":61187,"_27469":60910,"_18854":103401,"_5":12679,"_25963":102709,"_2424":103402},[],"`any` (por defecto): cualquier firmante que supere `require_ca_certificate` puede solicitar. `restricted`: el firmante debe encadenar a una CA de `trusted_requester_ca_ids` — una lista vacía en modo `restricted` **no autoriza a nadie**.",{"_2886":61188,"_27469":60910,"_18854":103404,"_5":12679,"_25963":102709,"_2424":46422},[],{"_2886":61189,"_27469":60910,"_18854":103406,"_5":12679,"_25963":102709,"_2424":103407},[],"CAs autorizadas en modo `restricted`.",{"_2886":61190,"_27469":60910,"_18854":103409,"_5":12679,"_25963":102709,"_2424":46428},[],{"_2886":61191,"_27469":60910,"_18854":103411,"_5":12679,"_25963":102709,"_2424":103412},[],"Por defecto `true`: el certificado de protección del firmante debe ser un certificado de CA.",{"_2886":61192,"_27469":60910,"_18854":103414,"_5":12679,"_25963":102709,"_2424":46434},[],{"_2886":61193,"_27469":60910,"_18854":103416,"_5":12679,"_25963":102709,"_2424":103417},[],"Por defecto `true`: exige una POPO de tipo `POPOSigningKey` sobre la clave del `CertTemplate`. Las POPO de tipo `EncryptedKey` (que revelarían la clave privada del solicitante) se rechazan siempre, con o sin esta opción.",{"_2886":61194,"_27469":60910,"_18854":103419,"_5":12679,"_25963":102709,"_2424":46440},[],{"_2886":61195,"_27469":60910,"_18854":103421,"_5":12679,"_25963":102709,"_2424":103422},[],"Validez máxima del certificado cruzado. Por defecto &#x2A;*8760 horas (365 días)**. El `notBefore` solicitado se respeta tal cual (puede estar en el pasado) y el `notAfter` se **trunca** a este límite, no se rechaza.",{"_2886":61196,"_27469":60910,"_18854":103424,"_5":12679,"_25963":102709,"_2424":46446},[],{"_2886":61197,"_27469":60910,"_18854":103426,"_5":12679,"_25963":102709,"_2424":103427},[],"Restricciones de identidad del certificado cruzado: `allowed_dn_patterns` (coincidencia por subcadena del subject en formato RFC 2253) y `allowed_dns_suffixes` (coincidencia por sufijo del SAN `dNSName`). Una lista vacía en una dimensión no impone restricción en esa dimensión — a diferencia de la lista de `central_key_generation`, que vacía deniega todo.",{"_2886":61198,"_27469":60910,"_18854":103429,"_5":12679,"_25963":102709,"_2424":46452},[],{"_2886":61199,"_27469":60910,"_18854":103431,"_5":12679,"_25963":102709,"_2424":103432},[],"**Persistido pero aún no aplicado**: el certificado cruzado se emite con un perfil interno fijo (`CMP Cross Certification`), que produce un certificado de CA con `keyCertSign`, `cRLSign` y `digitalSignature`.",{"_2886":61200,"_27469":60910,"_18854":103434,"_5":12679,"_25963":102709,"_2424":103435},[],"El `ccr` exige además: `CertTemplate` completo (versión, algoritmo de firma, emisor, validez, subject y clave pública; versión v3 o v1, no v2), una clave con capacidad de firma (las claves solo de acuerdo, como X25519/X448, se rechazan) y ninguna solicitud de generación de claves en servidor. No está pensado para inscripción de dispositivos, sino para interoperabilidad entre PKIs.",{"_2886":61201,"_27469":60910,"_18854":103437,"_5":12679,"_25963":102712,"_2424":103438},[],"CMP permite que el propio DMS genere el par de claves del dispositivo cuando la solicitud (`ir`/`cr`) llega con la clave pública vacía en el `CertTemplate` (RFC 9483 §4.1.6, también llamado **KGA**, Key Generation Authority).",{"_2886":61202,"_27469":60910,"_18854":103440,"_5":12679,"_25963":102712,"_2424":102944},[],{"_2886":61203,"_27469":60910,"_18854":103442,"_5":12679,"_25963":102712,"_2424":103017},[],{"_2886":61204,"_27469":60910,"_18854":103444,"_5":12679,"_25963":102712,"_2424":102947},[],{"_2886":61205,"_27469":60910,"_18854":103446,"_5":12679,"_25963":102712,"_2424":46470},[],{"_2886":61206,"_27469":60910,"_18854":103448,"_5":12679,"_25963":102712,"_2424":86032},[],{"_2886":61207,"_27469":60910,"_18854":103450,"_5":12679,"_25963":102712,"_2424":103451},[],"Habilita la generación de claves en servidor. Desactivado por defecto: una solicitud con clave pública vacía se rechaza con `notAuthorized`. Este interruptor y los `central_key_generation.enabled` de `ir`/`cr` se resuelven en una única puerta: basta activar cualquiera de los tres, y el valor resultante se reescribe en los tres.",{"_2886":61208,"_27469":60910,"_18854":103453,"_5":12679,"_25963":102712,"_2424":46478},[],{"_2886":61209,"_27469":60910,"_18854":103455,"_5":12679,"_25963":102712,"_2424":103456},[],"lista de IDs de CA",{"_2886":61210,"_27469":60910,"_18854":103458,"_5":12679,"_25963":102712,"_2424":103459},[],"CAs a las que debe encadenar el certificado destinatario (el certificado al que se cifra la clave generada — el propio certificado de protección del solicitante). Vacío por defecto: en ese caso se aplica el límite de confianza general del DMS (la `EnrollmentCA` más las CAs de validación de `auth_mode` y de `reenrollment_settings.additional_validation_cas`). Una lista explícita **sustituye** ese límite: el destinatario debe encadenar a alguna de las CAs listadas. La validación del destinatario es incondicional, también con `auth_mode: NO_AUTH`: KGA entrega material de clave privada, así que es un límite de confianza independiente del modo de autenticación.",{"_2886":61211,"_27469":60910,"_18854":103461,"_5":12679,"_25963":102712,"_2424":103462},[],"El flujo del servidor: genera la clave con el algoritmo implícito en la solicitud (RSA-2048 si el `CertTemplate` no declara algoritmo; ECDSA P-256 si declara ECC), emite el certificado por la vía normal de enrollment y devuelve en la misma respuesta `ip`/`cp` el certificado junto con la clave privada PKCS#8 envuelta en una estructura CMS `EnvelopedData`(`SignedData`(`AsymmetricKeyPackage`)). El destinatario es el certificado de protección del solicitante: con clave RSA se usa transporte de clave (`rsa_key_transport`), que exige `keyEncipherment` en el destinatario; con clave ECC se usa acuerdo de clave ECDH (`ecdh_key_agreement`), que exige `keyAgreement`. Un destinatario fuera del límite de confianza se rechaza con `signerNotTrusted`.",{"_2886":61212,"_27469":60910,"_18854":103464,"_5":12679,"_25963":102712,"_2424":103465},[],"La clave generada por KGA se produce con el motor criptográfico software del proceso (no con AWS KMS, PKCS#11 ni ningún Crypto Engine de hardware), porque la clave debe poder exportarse cifrada hacia el dispositivo — algo incompatible por diseño con un HSM que nunca expone claves privadas. La clave existe en memoria del proceso únicamente durante la duración de la solicitud y nunca se persiste: si el dispositivo pierde la respuesta, no puede recuperarla con `pollReq` — debe repetir la inscripción con un nuevo `transactionID`. Para el transporte, el DMS emite además certificados auxiliares efímeros (`Lamassu CMP KGA Signer` con EKU `id-kp-cmKGA`, y `Lamassu CMP KARI Originator` para el acuerdo ECDH), con validez de una hora y firmados por la CA de enrolamiento. Prefiera la generación de clave en el propio dispositivo siempre que sea posible; reserve KGA para dispositivos que genuinamente no puedan generar su propia clave.",{"_2886":61213,"_27469":60910,"_18854":103467,"_5":12679,"_25963":102716,"_2424":103468},[],"La sección `reenrollment_settings` del bloque CMP gobierna la renovación (`kur`) con los mismos campos que EST:",{"_2886":61214,"_27469":60910,"_18854":103470,"_5":12679,"_25963":102716,"_2424":102944},[],{"_2886":61215,"_27469":60910,"_18854":103472,"_5":12679,"_25963":102716,"_2424":103473},[],"Efecto en CMP",{"_2886":61216,"_27469":60910,"_18854":103475,"_5":12679,"_25963":102716,"_2424":46501},[],{"_2886":61217,"_27469":60910,"_18854":103477,"_5":12679,"_25963":102716,"_2424":103478},[],"CAs adicionales aceptadas como emisoras del certificado en vigor durante la renovación. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados.",{"_2886":61218,"_27469":60910,"_18854":103480,"_5":12679,"_25963":102716,"_2424":46507},[],{"_2886":61219,"_27469":60910,"_18854":103482,"_5":12679,"_25963":102716,"_2424":103483},[],"Revoca el certificado anterior con la razón `superseded` una vez emitido y confirmado el nuevo. En el alta (`ir`/`cr`/`p10cr`) controla si la sustitución de la identidad revoca el certificado anterior.",{"_2886":61220,"_27469":60910,"_18854":103485,"_5":12679,"_25963":102716,"_2424":46513},[],{"_2886":61221,"_27469":60910,"_18854":103487,"_5":12679,"_25963":102716,"_2424":103488},[],"Permite usar un certificado ya caducado como credencial de protección del `kur`.",{"_2886":61222,"_27469":60910,"_18854":103490,"_5":12679,"_25963":102716,"_2424":46519},[],{"_2886":61223,"_27469":60910,"_18854":103492,"_5":12679,"_25963":102716,"_2424":103493},[],"**No se aplica a CMP.** La ventana previa a la caducidad que limita el `/simplereenroll` de EST no restringe el `kur` de CMP; la política de cuándo renovar es del dispositivo.",{"_2886":61224,"_27469":60910,"_18854":103495,"_5":12679,"_25963":102716,"_2424":46525},[],{"_2886":61225,"_27469":60910,"_18854":103497,"_5":12679,"_25963":102716,"_2424":103498},[],"Umbrales para las alertas de renovación preventiva y crítica. Se materializan sobre los metadatos del certificado al vincular la identidad, igual que en EST.",{"_2886":61226,"_27469":60910,"_18854":103500,"_5":12679,"_25963":102716,"_2424":103501},[],"La política de clave e identidad del `kur` (qué puede cambiar y si la clave debe rotar) vive en su bloque por operación, descrito en Ajustes por operación.",{"_2886":61227,"_27469":60910,"_18854":103503,"_5":12679,"_25963":102720,"_2424":103504},[],"Cada `ir`/`cr`/`kur`/`p10cr`/`ccr` recibido por un DMS en CMP queda registrado como una **transacción CMP**, identificada por el `transactionID` hexadecimal del `PKIHeader`. El registro conserva el estado, el certificado emitido (sin el DER en la respuesta de la API), el método de prueba de posesión empleado y el `auth_mode` vigente en el momento del alta. Cuando la integración WFX está activa, cada transición de la transacción se refleja además como un job de workflow con los mensajes del intercambio adjuntos — ver Integración con WFX.",{"_2886":61228,"_27469":60910,"_18854":103506,"_5":12679,"_25963":102720,"_2424":103507},[],"Estado",{"_2886":61229,"_27469":60910,"_18854":103509,"_5":12679,"_25963":102720,"_2424":103510},[],"Significado",{"_2886":61230,"_27469":60910,"_18854":103512,"_5":12679,"_25963":102720,"_2424":46543},[],{"_2886":61231,"_27469":60910,"_18854":103514,"_5":12679,"_25963":102720,"_2424":103515},[],"Solicitud aceptada, pendiente de emisión: flujo `phased` esperando aprobación, o `ir`/`cr` esperando el `popdecr` de una POPO por reto-respuesta.",{"_2886":61232,"_27469":60910,"_18854":103517,"_5":12679,"_25963":102720,"_2424":46549},[],{"_2886":61233,"_27469":60910,"_18854":103519,"_5":12679,"_25963":102720,"_2424":103520},[],"Certificado emitido, a la espera de `certConf` del dispositivo.",{"_2886":61234,"_27469":60910,"_18854":103522,"_5":12679,"_25963":102720,"_2424":46555},[],{"_2886":61235,"_27469":60910,"_18854":103524,"_5":12679,"_25963":102720,"_2424":103525},[],"El dispositivo confirmó la recepción con `certConf` (o se concedió confirmación implícita). Estado terminal.",{"_2886":61236,"_27469":60910,"_18854":103527,"_5":12679,"_25963":102720,"_2424":46561},[],{"_2886":61237,"_27469":60910,"_18854":103529,"_5":12679,"_25963":102720,"_2424":103530},[],"La CA rechazó la emisión o un administrador rechazó la transacción. El motivo queda disponible para el dispositivo vía `pollReq`. Estado terminal.",{"_2886":61238,"_27469":60910,"_18854":103532,"_5":12679,"_25963":102720,"_2424":46567},[],{"_2886":61239,"_27469":60910,"_18854":103534,"_5":12679,"_25963":102720,"_2424":103535},[],"El certificado emitido fue revocado (por expiración del plazo de confirmación o por un `rr` posterior). Estado terminal.",{"_2886":61240,"_27469":60910,"_18854":103537,"_5":12679,"_25963":102720,"_2424":103538},[],"Internamente, el servidor emplea además los estados transitorios `APPROVING` y `REVOKING` como marcas de bloqueo mientras resuelve una aprobación administrativa o una revocación: suelen durar solo instantes y solo podrían observarse si el servicio se interrumpe a mitad de la operación, caso en el que la tarea de monitorización los finaliza automáticamente. Los estados expuestos por la API de listado son solo los cinco anteriores.",{"_2886":61241,"_27469":60910,"_18854":103540,"_5":12679,"_25963":102720,"_2424":45775},[],{"_2886":61242,"_27469":60910,"_18854":103542,"_5":12679,"_25963":102720,"_2424":102947},[],{"_2886":61243,"_27469":60910,"_18854":103544,"_5":12679,"_25963":102720,"_2424":46580},[],{"_2886":61244,"_27469":60910,"_18854":103546,"_5":12679,"_25963":102720,"_2424":103547},[],"Lista paginada de transacciones del DMS (`page_size`, `bookmark`, `sort_by`, `sort_mode` con valores `asc`/`desc`, `filter`). No incluye el DER del certificado; recupérelo desde la API de CAs usando `certificate_serial_number`.",{"_2886":61245,"_27469":60910,"_18854":103549,"_5":12679,"_25963":102720,"_2424":46586},[],{"_2886":61246,"_27469":60910,"_18854":103551,"_5":12679,"_25963":102720,"_2424":103552},[],"Aprueba una transacción `PENDING` de un DMS con flujo `phased`, emitiendo el certificado. El dispositivo lo recupera en su siguiente `pollReq`. La aprobación y el rechazo usan una reclamación atómica del registro, así que dos llamadas concurrentes no emiten el certificado dos veces. Tras aprobar, la ventana de confirmación del dispositivo pasa a ser la de `confirmation_timeout` (mínimo 2 minutos).",{"_2886":61247,"_27469":60910,"_18854":103554,"_5":12679,"_25963":102720,"_2424":46592},[],{"_2886":61248,"_27469":60910,"_18854":103556,"_5":12679,"_25963":102720,"_2424":103557},[],"Rechaza una transacción `PENDING`; pasa a `ISSUE_FAILED` con un motivo opcional (`{\"reason\": \"...\"}`; por defecto `transaction rejected by administrator`) que el dispositivo recibe en su siguiente `pollReq`.",{"_2886":61249,"_27469":60910,"_18854":103559,"_5":12679,"_25963":102720,"_2424":103560},[],"Ambas operaciones requieren el permiso de **lectura** para el listado y de **actualización** para aprobar o rechazar, dentro de las acciones del DMS. Las aprobaciones y rechazos solo tienen efecto sobre transacciones `PENDING`: en `workflow: direct` una transacción nace ya en `ISSUED`.",{"_2886":61250,"_27469":60910,"_18854":103562,"_5":12679,"_25963":102724,"_2424":103563},[],"Un certificado `ISSUED` que el dispositivo nunca confirma dentro de `confirmation_timeout` queda, por definición del RFC 4210 §5.2.8, en un estado de confianza indeterminado. Un job periódico de fondo — habilitado y programado mediante la clave de configuración del servicio DMS Manager `cmp_confirmation_monitoring_job` (`enabled`, `frequency`; por defecto cada 5 segundos cuando la monitorización global está activa) — se encarga de:",{"_2886":61251,"_27469":60910,"_18854":103565,"_5":12679,"_25963":102724,"_2424":103566},[],"**Revocar certificados sin confirmar**: transacciones `ISSUED` cuya ventana de confirmación expiró se revocan en la CA con la razón `cessationOfOperation` y pasan a `REVOKED`. La reclamación atómica del registro impide revocar un certificado que un `certConf` legítimo está confirmando en ese mismo instante.",{"_2886":61252,"_27469":60910,"_18854":103568,"_5":12679,"_25963":102724,"_2424":103569},[],"**Cerrar aprobaciones pendientes**: transacciones `PENDING` en flujo `phased` que ningún administrador resolvió dentro de `approval_timeout` pasan a `ISSUE_FAILED` con el motivo `approval window expired`, y se conservan **7 días** para que un `pollReq` tardío pueda ver el motivo del rechazo.",{"_2886":61253,"_27469":60910,"_18854":103571,"_5":12679,"_25963":102724,"_2424":103572},[],"Cada ejecución procesa como máximo **100 transacciones** por lote, para evitar una ráfaga de revocaciones tras una interrupción prolongada del servicio.",{"_2886":61254,"_27469":60910,"_18854":103574,"_5":12679,"_25963":102728,"_2424":103575},[],"Si el cliente WFX del servicio está habilitado (`wfx.enabled` en la configuración del DMS Manager), cada transición de una transacción CMP se refleja como un job en WFX (motor de workflows de Siemens), bajo dos plantillas predefinidas según el `workflow` del DMS: `lamassu.cmp.transaction.direct.v1` para el flujo directo y `lamassu.cmp.transaction.phased.v1` para el flujo con aprobación administrativa (que añade el estado `AwaitingApproval`). Los estados del workflow — `Received`, `Validated`, `Responded`, `AwaitingCertConf`, `Confirmed`, `LogicallyComplete` (confirmación implícita) y `Rejected` — permiten seguir el ciclo de vida de cada transacción desde el panel de WFX; el job se identifica por el CN del dispositivo y adjunta los mensajes del intercambio codificados en base64. Esto es puramente observabilidad/orquestación externa: si WFX no está habilitado, o si una llamada a WFX falla, la operación CMP en Lamassu no se ve afectada.",{"_2886":61255,"_27469":60910,"_18854":103577,"_5":12679,"_25963":102732,"_2424":103578},[],"**Desde la consola**: acceda al detalle del DMS y compruebe que la sección CMP muestra el protocolo activo, la CA de enrolamiento, el certificado de protección y las operaciones habilitadas.",{"_2886":61256,"_27469":60910,"_18854":103580,"_5":12679,"_25963":102732,"_2424":103581},[],"**Con el listado de transacciones**: `GET /v1/dms/{id}/cmp/transactions` confirma que el endpoint responde aunque no haya tráfico de dispositivos.",{"_2886":61257,"_27469":60910,"_18854":103583,"_5":12679,"_25963":102732,"_2424":103584},[],"**Con una solicitud de prueba**: use `openssl cmp` con el comando `ir` (si dispone de un firmante válido) o `genm` contra el endpoint del DMS — ver Ejemplo con openssl cmp.",{"_2886":61258,"_27469":60910,"_18854":103586,"_5":12679,"_25963":102736,"_2424":103587},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_2886":61259,"_27469":60910,"_18854":103589,"_5":12679,"_25963":102740,"_2424":103590},[],"El administrador PKI debe haber configurado un DMS con el protocolo `CMP_RFC9483`, una CA de enrolamiento, un certificado de protección y un modo de autenticación. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_2886":61260,"_27469":60910,"_18854":103592,"_5":12679,"_25963":102740,"_2424":103593},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_2886":61261,"_27469":60910,"_18854":103595,"_5":12679,"_25963":102740,"_2424":103596},[],"Elemento",{"_2886":61262,"_27469":60910,"_18854":103598,"_5":12679,"_25963":102740,"_2424":102947},[],{"_2886":61263,"_27469":60910,"_18854":103600,"_5":12679,"_25963":102740,"_2424":103601},[],"**URL del host CMP**",{"_2886":61264,"_27469":60910,"_18854":103603,"_5":12679,"_25963":102740,"_2424":103604},[],"Dirección base del servidor, por ejemplo `https://cmp.lamassu.example`. La proporciona el administrador PKI.",{"_2886":61265,"_27469":60910,"_18854":103606,"_5":12679,"_25963":102740,"_2424":103607},[],"**ID del DMS**",{"_2886":61266,"_27469":60910,"_18854":103609,"_5":12679,"_25963":102740,"_2424":103610},[],"Identificador del DMS, incluido en la ruta del endpoint (`/.well-known/cmp/p/{id}`).",{"_2886":61267,"_27469":60910,"_18854":103612,"_5":12679,"_25963":102740,"_2424":103613},[],"**Certificado y clave de firma del mensaje**",{"_2886":61268,"_27469":60910,"_18854":103615,"_5":12679,"_25963":102740,"_2424":103616},[],"Solo para los modos `CLIENT_CERTIFICATE` y `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK` (y siempre para `kur`/`rr`). A diferencia de EST, no se usa como credencial mTLS: se incluye como `extraCerts[0]` y firma el `PKIMessage`.",{"_2886":61269,"_27469":60910,"_18854":103618,"_5":12679,"_25963":102740,"_2424":103619},[],"**Certificado de protección del DMS**",{"_2886":61270,"_27469":60910,"_18854":103621,"_5":12679,"_25963":102740,"_2424":103622},[],"El certificado con el que el DMS firma sus respuestas. Los clientes que fijen la identidad del respondedor (por ejemplo `openssl cmp -srvcert`) lo necesitan.",{"_2886":61271,"_27469":60910,"_18854":103624,"_5":12679,"_25963":102743,"_2424":103625},[],"CMP se sirve desde un **único endpoint**:",{"_2886":61272,"_27469":60910,"_18854":103627,"_5":12679,"_25963":102743,"_2424":103628},[],"donde `{id}` es el identificador del DMS. La ruta sigue el formato de URI *well-known* del RFC 9480 §3.3, por lo que clientes CMP estándar la reconocen sin configuración adicional (`openssl cmp -server <host> -path /.well-known/cmp/p/<dms-id>`).",{"_2886":61273,"_27469":60910,"_18854":103630,"_5":12679,"_25963":102743,"_2424":103631},[],"**Content-Type**: `application/pkixcmp` tanto en la solicitud como en la respuesta. Una solicitud con otro `Content-Type` se rechaza con `415 Unsupported Media Type`.",{"_2886":61274,"_27469":60910,"_18854":103633,"_5":12679,"_25963":102743,"_2424":103634},[],"**Cuerpo**: un `PKIMessage` en DER binario (no base64, a diferencia de los endpoints EST). La respuesta es igualmente DER binario.",{"_2886":61275,"_27469":60910,"_18854":103636,"_5":12679,"_25963":102743,"_2424":103637},[],"**Despacho por contenido, no por ruta**: el servidor decodifica el `PKIMessage`, valida el sobre (versión de protocolo, `transactionID`, `senderNonce`, `messageTime`) y despacha la operación según la etiqueta (`tag`) del `PKIBody` — `ir`, `cr`, `p10cr`, `kur`, `rr`, `certConf`, `pollReq`, `genm`, `ccr`, `nested`, etc.",{"_2886":61276,"_27469":60910,"_18854":103639,"_5":12679,"_25963":102743,"_2424":103640},[],"**Sin autenticación a nivel de transporte**: el endpoint no exige mTLS ni cabeceras de autorización; toda la autenticación viaja dentro del mensaje, como se describe en Modelo de autenticación.",{"_2886":61277,"_27469":60910,"_18854":103642,"_5":12679,"_25963":102743,"_2424":103643},[],"**Tamaño máximo de solicitud**: 1 MiB. Una solicitud mayor se rechaza antes de intentar decodificarla.",{"_2886":61278,"_27469":60910,"_18854":103645,"_5":12679,"_25963":102743,"_2424":103646},[],"Un rechazo llega con `HTTP 200` en la forma que corresponde a la operación: como un `PKIMessage` de error ante fallos previos al despacho (operación deshabilitada, cabecera inválida, protección fallida), como un cuerpo de rechazo dentro de la respuesta de la propia operación (`ip`/`cp`/`kup` con `status: rejection`) ante fallos de política de emisión, o como un cuerpo `rp` con estado de rechazo en las revocaciones. En todos los casos hay que inspeccionar el cuerpo CMP, no solo el código HTTP. Los códigos HTTP de error (`400`, `415` y, ante fallos internos del servidor, `500`) se reservan para los casos en los que no se puede entregar una respuesta CMP válida — ver Códigos de error y diagnóstico.",{"_2886":61279,"_27469":60910,"_18854":103648,"_5":12679,"_25963":102747,"_2424":103649},[],"CMP autentica **el mensaje**, no la conexión: no hay handshake mTLS equivalente al de EST. Cuando el `auth_mode` del DMS exige `CLIENT_CERTIFICATE`, el dispositivo debe:",{"_2886":61280,"_27469":60910,"_18854":103651,"_5":12679,"_25963":102747,"_2424":103652},[],"Incluir su certificado en el campo `extraCerts` del `PKIMessage` (primera posición).",{"_2886":61281,"_27469":60910,"_18854":103654,"_5":12679,"_25963":102747,"_2424":103655},[],"Firmar el `PKIMessage` completo con la clave privada correspondiente a ese certificado (protección basada en firma, RFC 9483 §3.2).",{"_2886":61282,"_27469":60910,"_18854":103657,"_5":12679,"_25963":102747,"_2424":103658},[],"Sobre el mensaje protegido, el servidor exige además dos ataduras del RFC 9483: el campo `sender` de la cabecera debe coincidir con el subject del certificado de protección y el `senderKID` debe ser su `SubjectKeyIdentifier`. Una solicitud protegida que incumpla cualquiera se rechaza con `badMessageCheck`. Si un mensaje trae firma aunque el modo no la exija, la firma igualmente se verifica y esas ataduras aplican.",{"_2886":61283,"_27469":60910,"_18854":103660,"_5":12679,"_25963":102747,"_2424":103661},[],"El requisito de protección por tipo de mensaje:",{"_2886":61284,"_27469":60910,"_18854":103663,"_5":12679,"_25963":102747,"_2424":103664},[],"Mensaje",{"_2886":61285,"_27469":60910,"_18854":103666,"_5":12679,"_25963":102747,"_2424":103667},[],"¿Protección obligatoria?",{"_2886":61286,"_27469":60910,"_18854":103669,"_5":12679,"_25963":102747,"_2424":46708},[],{"_2886":61287,"_27469":60910,"_18854":103671,"_5":12679,"_25963":102747,"_2424":103672},[],"Solo si el `auth_mode` es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2886":61288,"_27469":60910,"_18854":103674,"_5":12679,"_25963":102747,"_2424":45709},[],{"_2886":61289,"_27469":60910,"_18854":103676,"_5":12679,"_25963":102747,"_2424":103677},[],"Siempre (la firma es la prueba de posesión de la renovación)",{"_2886":61290,"_27469":60910,"_18854":103679,"_5":12679,"_25963":102747,"_2424":45717},[],{"_2886":61291,"_27469":60910,"_18854":103681,"_5":12679,"_25963":102747,"_2424":103682},[],"Siempre (la firma es lo que autoriza la revocación)",{"_2886":61292,"_27469":60910,"_18854":103684,"_5":12679,"_25963":102747,"_2424":45721},[],{"_2886":61293,"_27469":60910,"_18854":103686,"_5":12679,"_25963":102747,"_2424":103687},[],"Según `access_policy`: `public_discovery` admite mensajes sin firma; `require_signed` exige firma",{"_2886":61294,"_27469":60910,"_18854":103689,"_5":12679,"_25963":102747,"_2424":46729},[],{"_2886":61295,"_27469":60910,"_18854":103691,"_5":12679,"_25963":102747,"_2424":103692},[],"Siguen la regla del `auth_mode` del DMS",{"_2886":61296,"_27469":60910,"_18854":103694,"_5":12679,"_25963":102747,"_2424":103695},[],"En la capa de servicio, el certificado de protección debe encadenar a una CA declarada en `client_certificate_settings.validation_cas` (o, en `kur`, a la CA de enrolamiento y las CAs adicionales de re-enrollment), con los mismos parámetros de profundidad de cadena y tolerancia a certificados caducados que EST, y se comprueba su estado de revocación igual que en el flujo EST. Además, un certificado que fue identidad de un dispositivo sigue estando sujeto al estado de la identidad: mientras haya una actualización de clave pendiente de confirmar no puede iniciar operaciones nuevas, y una vez confirmada la sustitución deja de ser utilizable como credencial (`certRevoked`). Un certificado que no es identidad de ningún dispositivo (por ejemplo, un firmante bootstrap) pasa sin esas comprobaciones.",{"_2886":61297,"_27469":60910,"_18854":103697,"_5":12679,"_25963":102751,"_2424":103698},[],"Operación",{"_2886":61298,"_27469":60910,"_18854":103700,"_5":12679,"_25963":102751,"_2424":103701},[],"Uso",{"_2886":61299,"_27469":60910,"_18854":103703,"_5":12679,"_25963":102751,"_2424":103704},[],"Requiere identidad previa",{"_2886":61300,"_27469":60910,"_18854":103706,"_5":12679,"_25963":102751,"_2424":46747},[],{"_2886":61301,"_27469":60910,"_18854":103708,"_5":12679,"_25963":102751,"_2424":103709},[],"Alta inicial de un dispositivo nuevo.",{"_2886":61302,"_27469":60910,"_18854":103711,"_5":12679,"_25963":102751,"_2424":46753},[],{"_2886":61303,"_27469":60910,"_18854":103713,"_5":12679,"_25963":102751,"_2424":46756},[],{"_2886":61304,"_27469":60910,"_18854":103715,"_5":12679,"_25963":102751,"_2424":103716},[],"Emisión adicional o de sustitución para un dispositivo ya identificado.",{"_2886":61305,"_27469":60910,"_18854":103718,"_5":12679,"_25963":102751,"_2424":103719},[],"Sí (si `require_existing_device`)",{"_2886":61306,"_27469":60910,"_18854":103721,"_5":12679,"_25963":102751,"_2424":45713},[],{"_2886":61307,"_27469":60910,"_18854":103723,"_5":12679,"_25963":102751,"_2424":103724},[],"Alta con un CSR PKCS#10, sin controles CRMF ni KGA. Debe estar habilitado en el DMS.",{"_2886":61308,"_27469":60910,"_18854":103726,"_5":12679,"_25963":102751,"_2424":46753},[],{"_2886":61309,"_27469":60910,"_18854":103728,"_5":12679,"_25963":102751,"_2424":45709},[],{"_2886":61310,"_27469":60910,"_18854":103730,"_5":12679,"_25963":102751,"_2424":103731},[],"Renovación de un certificado; el mensaje se firma con el certificado vigente.",{"_2886":61311,"_27469":60910,"_18854":103733,"_5":12679,"_25963":102751,"_2424":103734},[],"Sí (el certificado que se renueva)",{"_2886":61312,"_27469":60910,"_18854":103736,"_5":12679,"_25963":102751,"_2424":45717},[],{"_2886":61313,"_27469":60910,"_18854":103738,"_5":12679,"_25963":102751,"_2424":103739},[],"Revocación de un certificado, siempre firmada.",{"_2886":61314,"_27469":60910,"_18854":103741,"_5":12679,"_25963":102751,"_2424":103742},[],"Sí",{"_2886":61315,"_27469":60910,"_18854":103744,"_5":12679,"_25963":102751,"_2424":46788},[],{"_2886":61316,"_27469":60910,"_18854":103746,"_5":12679,"_25963":102751,"_2424":103747},[],"Consulta de capacidades del DMS (CAs, tipos de clave, CRL vigente, etc.). No emite certificados.",{"_2886":61317,"_27469":60910,"_18854":103749,"_5":12679,"_25963":102751,"_2424":46753},[],{"_2886":61318,"_27469":60910,"_18854":103751,"_5":12679,"_25963":102751,"_2424":46796},[],{"_2886":61319,"_27469":60910,"_18854":103753,"_5":12679,"_25963":102751,"_2424":103754},[],"Certificación cruzada entre CAs. Solo para operadores de CA, deshabilitada por defecto.",{"_2886":61320,"_27469":60910,"_18854":103756,"_5":12679,"_25963":102751,"_2424":103757},[],"El firmante debe ser una CA",{"_2886":61321,"_27469":60910,"_18854":103759,"_5":12679,"_25963":102751,"_2424":45733},[],{"_2886":61322,"_27469":60910,"_18854":103761,"_5":12679,"_25963":102751,"_2424":103762},[],"Envoltorio que añade una capa extra de protección (una RA contrafirmando a un dispositivo) o agrupa varios mensajes en lote. No es una operación en sí misma.",{"_2886":61323,"_27469":60910,"_18854":103764,"_5":12679,"_25963":102751,"_2424":43390},[],{"_2886":61324,"_27469":60910,"_18854":103766,"_5":12679,"_25963":102751,"_2424":103767},[],"Los pasos de protocolo `certConf` (confirmación), `pollReq` (sondeo), `popdecc`/`popdecr` (prueba de posesión por reto-respuesta) y `error` forman parte del ciclo de vida de las operaciones anteriores, no son operaciones que el integrador elija por separado.",{"_2886":61325,"_27469":60910,"_18854":103769,"_5":12679,"_25963":102755,"_2424":103770},[],"Ambas llevan un cuerpo `CertReqMessages` con la plantilla de certificado (`CertTemplate`), los controles CRMF y la prueba de posesión. El subject puede llegar vacío (NULL-DN) siempre que una extensión `SubjectAltName` porte la identidad; sin subject ni SAN, el `ir` se rechaza. Las respuestas son `ip` para `ir` y `cp` para `cr`.",{"_2886":61326,"_27469":60910,"_18854":103772,"_5":12679,"_25963":102755,"_2424":103773},[],"El alta respeta el modo de registro del DMS: con `JITP`, la primera solicitud crea el dispositivo con el perfil de aprovisionamiento; con `PRE_REGISTRATION`, un dispositivo desconocido se rechaza con `device not preregistered`. Reinscribir un dispositivo ya enrolado exige `enable_replaceable_enrollment` en el DMS (`forbiddenNewEnrollment` en caso contrario). Las restricciones de plantilla son las mismas para ambas operaciones: Lamassu nunca emite certificados de CA vía CMP (`BasicConstraints cA=TRUE` → `notAuthorized`), el uso de `keyCertSign` sin ser CA o un `pathLenConstraint` en una plantilla de entidad final son `badCertTemplate`, y el RSA admitido va de 2048 a 8192 bits.",{"_2886":61327,"_27469":60910,"_18854":103775,"_5":12679,"_25963":102755,"_2424":103776},[],"Si el perfil de emisión del DMS descarta una extensión **crítica** solicitada por el `CertTemplate`, la respuesta llega con estado `grantedWithMods` (1) en lugar de `accepted` (0): el integrador debe comparar el certificado emitido con lo que pidió, no asumir que la aceptación implica correspondencia exacta.",{"_2886":61328,"_27469":60910,"_18854":103778,"_5":12679,"_25963":102755,"_2424":103779},[],"Los controles CRMF, cuando el DMS los exige, van en la solicitud: `id-regCtrl-regToken` (RFC 4211 §6.1) si el modo del DMS lo requiere — valor de un solo uso que se consume aunque la emisión falle después — y `id-regCtrl-authenticator` (§6.2) si el DMS configuró una respuesta esperada. Un control presente cuando el DMS lo tiene deshabilitado, o ausente cuando es obligatorio, se rechaza con `badRequest`.",{"_2886":61329,"_27469":60910,"_18854":103781,"_5":12679,"_25963":102759,"_2424":103782},[],"El mensaje lleva la plantilla del certificado renovado y se **protege por firma con el certificado que se renueva** — esa firma es la prueba de posesión. Con `key_policy: require_new_key`, la clave pública debe ser distinta a la vigente; con `identity_change_policy: forbid`, el subject y el SAN deben coincidir con el certificado en vigor (`san_only` permite cambiar el SAN; `subject_and_san` permite ambos cambios). La respuesta es `kup`.",{"_2886":61330,"_27469":60910,"_18854":103784,"_5":12679,"_25963":102759,"_2424":103785},[],"El intercambio queda pendiente hasta el `certConf`: hasta que el dispositivo confirma, el certificado anterior sigue siendo la identidad activa del dispositivo y puede seguir usándose; el nuevo se vincula y el anterior se revoca como `superseded` solo al confirmar (o inmediatamente si se negoció confirmación implícita). El control opcional `id-regCtrl-oldCertID` debe referenciar el certificado que se renueva.",{"_2886":61331,"_27469":60910,"_18854":103787,"_5":12679,"_25963":102762,"_2424":103788},[],"El cuerpo es un CSR PKCS#10 completo. La firma del CSR sobre su propia `CertificationRequestInfo` es la prueba de posesión y se verifica siempre. La política de algoritmos de firma sigue el RFC 9481 §3: RSA, RSA-PSS, ECDSA o Ed25519 con SHA-256/384/512; los firmados con SHA-1, SHA-224, MD5 o DSA se rechazan con `badPOP`, y un algoritmo desconocido se rechaza con `badAlg`. La respuesta es un `cp` con `certReqId` `-1`, y el `certConf` posterior debe llevar ese mismo valor.",{"_2886":61332,"_27469":60910,"_18854":103790,"_5":12679,"_25963":102765,"_2424":103791},[],"El cuerpo lleva `RevReqContent` con el `CertTemplate` del certificado a revocar y la razón. La firma del mensaje debe ser del propio certificado revocado (revocación propia) o de una entidad RA de confianza (EKU `id-kp-cmcRA`, validada contra las CAs del DMS según `trusted_ra`). Los campos del `CertTemplate` — emisor, número de serie, subject, clave pública y extensiones — deben coincidir con el certificado presentado. La razón `certificateHold` suspende el certificado (y no está sujeta a la lista de razones permitidas); la razón `removeFromCRL` no revoca: solicita reactivar un certificado previamente revocado — solo posible si esa revocación fue una suspensión —, operación que el DMS debe tener habilitada con `allow_revival`.",{"_2886":61333,"_27469":60910,"_18854":103793,"_5":12679,"_25963":102765,"_2424":103794},[],"La respuesta es siempre un `rp` — tanto en éxito (`Certificate revoked` / `Certificate revived`) como en rechazo, con el motivo en su `PKIStatusInfo`.",{"_2886":61334,"_27469":60910,"_18854":103796,"_5":12679,"_25963":102768,"_2424":103797},[],"El cuerpo es una secuencia de `InfoTypeAndValue`; la respuesta es un `genp` con una entrada por solicitud. Consulte la tabla de tipos de información para saber qué anuncia cada DMS. Los tipos dependientes de infraestructura (CRL) requieren que el administrador haya configurado un cliente VA en el servicio DMS Manager.",{"_2886":61335,"_27469":60910,"_18854":103799,"_5":12679,"_25963":102771,"_2424":103800},[],"Reservado a operadores de CA. El firmante debe ser un certificado de CA y la plantilla debe ir completa. Con `workflow: administrator_approval` (el por defecto), la primera respuesta es un `ccp` de espera y el certificado cruzado se recupera con `pollReq` una vez aprobado. La validez solicitada se respeta hasta el límite de `maximum_validity` del DMS.",{"_2886":61336,"_27469":60910,"_18854":103802,"_5":12679,"_25963":102774,"_2424":103803},[],"`certConf` cierra el ciclo de una emisión con confirmación explícita. Reglas principales:",{"_2886":61337,"_27469":60910,"_18854":103805,"_5":12679,"_25963":102774,"_2424":103806},[],"Debe llevar **exactamente un** `CertStatus`, con `certReqId` `0` para `ir`/`cr`/`kur` y `-1` para `p10cr`.",{"_2886":61338,"_27469":60910,"_18854":103808,"_5":12679,"_25963":102774,"_2424":103809},[],"El `certHash` se verifica contra el certificado emitido; sin `hashAlg` se usa el resumen que dicta el RFC 9481 §3.3 según el algoritmo de firma del propio certificado (SHA-256, salvo certificados firmados con SHA-384/512 o Ed25519), y declarar un `hashAlg` exige `pvno` `cmp2021(3)`.",{"_2886":61339,"_27469":60910,"_18854":103811,"_5":12679,"_25963":102774,"_2424":103812},[],"Debe ir protegido con **la credencial de la solicitud original**, no con el certificado recién emitido.",{"_2886":61340,"_27469":60910,"_18854":103814,"_5":12679,"_25963":102774,"_2424":103815},[],"El `recipNonce` debe devolver el `senderNonce` de la respuesta, y su propio `senderNonce` debe ser nuevo (reutilizar el de la solicitud inicial es `badSenderNonce`).",{"_2886":61341,"_27469":60910,"_18854":103817,"_5":12679,"_25963":102774,"_2424":103818},[],"Confirmar dos veces el mismo certificado responde con el error `certConfirmed`, útil tras perder un `pkiConf`.",{"_2886":61342,"_27469":60910,"_18854":103820,"_5":12679,"_25963":102774,"_2424":103821},[],"`pollReq` sondea el estado de la transacción y permite dos flujos: la recuperación de respuesta perdida (el certificado `ISSUED` se re-entrega en el `ip`/`cp`/`kup` original, sin consumir la transacción) y el sondeo del flujo `phased` (mientras la transacción está `PENDING`, la respuesta es un `pollRep` con la sugerencia de reintento, 60 segundos por defecto). Una transacción `ISSUE_FAILED` devuelve el motivo del fallo y una `REVOKED` indica que debe repetirse la inscripción. La respuesta de una transacción con generación de claves en servidor **no se puede recuperar**: la clave privada nunca se almacena, así que un `pollReq` sobre ella se rechaza y el dispositivo debe repetir la inscripción con un nuevo `transactionID`.",{"_2886":61343,"_27469":60910,"_18854":103823,"_5":12679,"_25963":102778,"_2424":103824},[],"Un `nested` (RFC 4210 §5.1.3) es un sobre cuyo cuerpo contiene uno o varios `PKIMessage`. Con **un solo** mensaje interior es *added protection* (RFC 9483 §5.2.2.1): una RA envuelve y contrafirma una solicitud ya protegida del dispositivo; la cabecera exterior debe copiar el `transactionID` y el `senderNonce` del interior, la protección interior se verifica y la solicitud se procesa con normalidad. Con **dos o más** mensajes es un lote (§5.2.2.2): la cabecera exterior lleva `transactionID`/`senderNonce` nuevos, la protección de cada mensaje interior se verifica antes de procesar ninguno y las respuestas vuelven envueltas en un `nested`, en el mismo orden. Un `ccr` dentro de un `nested` no se reexpide, y no se admite anidar dentro de un lote.",{"_2886":61344,"_27469":60910,"_18854":103826,"_5":12679,"_25963":102781,"_2424":103827},[],"Cuando el DMS tiene `server_key_gen_enabled: true`, un dispositivo puede enviar un `ir`/`cr` con el campo de clave pública del `CertTemplate` vacío para solicitar que el servidor genere el par de claves. El mecanismo y sus límites se describen en la sección de configuración; desde el integrador:",{"_2886":61345,"_27469":60910,"_18854":103829,"_5":12679,"_25963":102781,"_2424":103830},[],"El certificado de protección del mensaje hace de destinatario: RSA → `rsa_key_transport`, ECC → `ecdh_key_agreement`. La clave y el uso de clave del certificado deben permitir la técnica elegida.",{"_2886":61346,"_27469":60910,"_18854":103832,"_5":12679,"_25963":102781,"_2424":103833},[],"La respuesta (`ip`/`cp`) lleva el certificado emitido y la clave envuelta en el mismo cuerpo; la clave PKCS#8 viaja dentro de `EnvelopedData`(`SignedData`(`AsymmetricKeyPackage`)) y el certificado con el que abrir el sobre está en `extraCerts[0]`.",{"_2886":61347,"_27469":60910,"_18854":103835,"_5":12679,"_25963":102781,"_2424":103836},[],"La clave nunca se guarda en el servidor: si la respuesta se pierde, no hay `pollReq` que la recupere — repita la inscripción con un nuevo `transactionID`.",{"_2886":61348,"_27469":60910,"_18854":103838,"_5":12679,"_25963":102781,"_2424":103839},[],"El `certConf` posterior funciona igual que en una emisión ordinaria.",{"_2886":61349,"_27469":60910,"_18854":103841,"_5":12679,"_25963":102785,"_2424":103842},[],"Los siguientes comandos usan el cliente `cmp` de OpenSSL (≥ 3.0) contra un DMS configurado en modo `CLIENT_CERTIFICATE`.",{"_2886":61350,"_27469":60910,"_18854":103844,"_5":12679,"_25963":102785,"_2424":103845},[],"**Alta inicial (`ir`)**, firmando con un certificado bootstrap (`signer.crt`/`signer.key`) emitido por una de las `validation_cas` del DMS, y generando una clave nueva para el dispositivo:",{"_2886":61351,"_27469":60910,"_18854":103847,"_5":12679,"_25963":102785,"_2424":103848},[],"`-tls_used` es necesario en OpenSSL 3.0.x cuando la URL del servidor usa `https` sin fijar el certificado del servidor (`-srvcert`); las versiones ≥ 3.2 lo infieren automáticamente. `-unprotected_errors` permite aceptar respuestas de error que lleguen sin protección (aquellas cuyo algoritmo de protección es NULL); mientras el DMS no tenga configurado el `protection_certificate`, todas sus respuestas — incluidos los errores — salen sin protección, así que esta opción evita que `openssl cmp` las descarte.",{"_2886":61352,"_27469":60910,"_18854":103850,"_5":12679,"_25963":102785,"_2424":103851},[],"**Renovación (`kur`)**, autenticando con el certificado vigente del dispositivo:",{"_2886":61353,"_27469":60910,"_18854":103853,"_5":12679,"_25963":102785,"_2424":103854},[],"`-srvcert` fija el certificado con el que se espera que el DMS proteja su respuesta (el **Protection Certificate** configurado en el DMS). Sin él, OpenSSL valida la protección de la respuesta contra sus propios anclajes de confianza; `-unprotected_errors` solo cubre los mensajes de error sin protección y no sustituye a `-srvcert` para las respuestas correctas.",{"_2886":61354,"_27469":60910,"_18854":103856,"_5":12679,"_25963":102789,"_2424":103857},[],"**Confirmar el certificado**: salvo que `accept_implicit` esté activo en el DMS y el dispositivo lo solicite, el flujo no se considera completo hasta que el dispositivo envía `certConf`. `openssl cmp -cmd ir`/`kur` lo hace automáticamente; una integración manual debe implementar este paso.",{"_2886":61355,"_27469":60910,"_18854":103859,"_5":12679,"_25963":102789,"_2424":103860},[],"**Planificar la renovación**: programe el `kur` antes de la caducidad del certificado. A diferencia de EST, la ventana `reenrollment_delta` no restringe el `kur` de CMP, así que la política de cuándo renovar es del dispositivo.",{"_2886":61356,"_27469":60910,"_18854":103862,"_5":12679,"_25963":102789,"_2424":103863},[],"**Flujo `phased`**: si el DMS usa `workflow: phased` en la operación, la primera respuesta a `ir`/`cr`/`kur`/`p10cr` es una espera; el dispositivo debe reintentar con `pollReq` hasta que un administrador apruebe o rechace la transacción.",{"_2886":61357,"_27469":60910,"_18854":103865,"_5":12679,"_25963":102789,"_2424":103866},[],"**Recuperación de respuestas perdidas**: ante una respuesta que no llegó, repita la operación con `pollReq` (el certificado `ISSUED` se re-entrega) salvo en transacciones con generación de claves en servidor, donde hay que repetir la inscripción.",{"_2886":61358,"_27469":60910,"_18854":103868,"_5":12679,"_25963":102797,"_2424":103869},[],"Un `PKIMessage` de error devuelto con `HTTP 200` es la respuesta normal ante una solicitud rechazada por política (autenticación fallida, operación deshabilitada, ventana de confirmación expirada, etc.). Va protegido — firmado con el certificado de protección — si el DMS tiene uno configurado; en caso contrario va sin protección, y los clientes estrictos como `openssl cmp` lo descartan salvo que se use `-unprotected_errors`. Los códigos HTTP de error están reservados para fallos donde no se puede construir un `PKIMessage` de respuesta.",{"_2886":61359,"_27469":60910,"_18854":103871,"_5":12679,"_25963":102797,"_2424":46917},[],{"_2886":61360,"_27469":60910,"_18854":103873,"_5":12679,"_25963":102797,"_2424":103874},[],"Dónde está el fallo",{"_2886":61361,"_27469":60910,"_18854":103876,"_5":12679,"_25963":102797,"_2424":103877},[],"Causa típica",{"_2886":61362,"_27469":60910,"_18854":103879,"_5":12679,"_25963":102797,"_2424":103880},[],"Acción del integrador",{"_2886":61363,"_27469":60910,"_18854":103882,"_5":12679,"_25963":102797,"_2424":26654},[],{"_2886":61364,"_27469":60910,"_18854":103884,"_5":12679,"_25963":102797,"_2424":103885},[],"Cuerpo JSON de error",{"_2886":61365,"_27469":60910,"_18854":103887,"_5":12679,"_25963":102797,"_2424":103888},[],"`Content-Type` distinto de `application/pkixcmp`.",{"_2886":61366,"_27469":60910,"_18854":103890,"_5":12679,"_25963":102797,"_2424":103891},[],"Fijar la cabecera correcta.",{"_2886":61367,"_27469":60910,"_18854":103893,"_5":12679,"_25963":102797,"_2424":26614},[],{"_2886":61368,"_27469":60910,"_18854":103895,"_5":12679,"_25963":102797,"_2424":103896},[],"Sin cuerpo",{"_2886":61369,"_27469":60910,"_18854":103898,"_5":12679,"_25963":102797,"_2424":103899},[],"El cuerpo no se puede decodificar como `PKIMessage` ASN.1 (no hay cabecera válida con la que construir una respuesta CMP).",{"_2886":61370,"_27469":60910,"_18854":103901,"_5":12679,"_25963":102797,"_2424":103902},[],"Verificar que el cuerpo es DER binario, no base64 ni PEM.",{"_2886":61371,"_27469":60910,"_18854":103904,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61372,"_27469":60910,"_18854":103906,"_5":12679,"_25963":102797,"_2424":103907},[],"`PKIFailureInfo` del cuerpo",{"_2886":61373,"_27469":60910,"_18854":103909,"_5":12679,"_25963":102797,"_2424":103910},[],"`unsupportedVersion`: pvno distinto de `cmp2000(2)`/`cmp2021(3)`.",{"_2886":61374,"_27469":60910,"_18854":103912,"_5":12679,"_25963":102797,"_2424":103913},[],"Usar una versión soportada.",{"_2886":61375,"_27469":60910,"_18854":103915,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61376,"_27469":60910,"_18854":103917,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61377,"_27469":60910,"_18854":103919,"_5":12679,"_25963":102797,"_2424":103920},[],"`badDataFormat`: `transactionID`/`senderNonce` ausentes o menores de 128 bits; `PKIHeader` malformado; `error` desde el EE.",{"_2886":61378,"_27469":60910,"_18854":103922,"_5":12679,"_25963":102797,"_2424":103923},[],"Revisar la implementación del cliente CMP.",{"_2886":61379,"_27469":60910,"_18854":103925,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61380,"_27469":60910,"_18854":103927,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61381,"_27469":60910,"_18854":103929,"_5":12679,"_25963":102797,"_2424":103930},[],"`badTime`: `messageTime` ausente o con más de 5 minutos de deriva.",{"_2886":61382,"_27469":60910,"_18854":103932,"_5":12679,"_25963":102797,"_2424":103933},[],"Sincronizar el reloj del dispositivo.",{"_2886":61383,"_27469":60910,"_18854":103935,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61384,"_27469":60910,"_18854":103937,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61385,"_27469":60910,"_18854":103939,"_5":12679,"_25963":102797,"_2424":103940},[],"`badSenderNonce`/`badRecipientNonce`: `senderNonce` reutilizado, `recipNonce` presente en una solicitud inicial o desajustado.",{"_2886":61386,"_27469":60910,"_18854":103942,"_5":12679,"_25963":102797,"_2424":103943},[],"Seguir las reglas de nonces del RFC 9483 §3.1.",{"_2886":61387,"_27469":60910,"_18854":103945,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61388,"_27469":60910,"_18854":103947,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61389,"_27469":60910,"_18854":103949,"_5":12679,"_25963":102797,"_2424":103950},[],"`badMessageCheck`: firma inválida, `sender`/`senderKID` no coinciden con el certificado de protección, o protección fallida en un mensaje anidado.",{"_2886":61390,"_27469":60910,"_18854":103952,"_5":12679,"_25963":102797,"_2424":103953},[],"Revisar el certificado con el que se firmó.",{"_2886":61391,"_27469":60910,"_18854":103955,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61392,"_27469":60910,"_18854":103957,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61393,"_27469":60910,"_18854":103959,"_5":12679,"_25963":102797,"_2424":103960},[],"`transactionIdInUse`: `transactionID` ya registrado (repetición de un `rr`).",{"_2886":61394,"_27469":60910,"_18854":103962,"_5":12679,"_25963":102797,"_2424":103963},[],"Generar un `transactionID` nuevo.",{"_2886":61395,"_27469":60910,"_18854":103965,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61396,"_27469":60910,"_18854":103967,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61397,"_27469":60910,"_18854":103969,"_5":12679,"_25963":102797,"_2424":103970},[],"`notAuthorized`: operación deshabilitada para el DMS, o revocación de un certificado de otro DMS.",{"_2886":61398,"_27469":60910,"_18854":103972,"_5":12679,"_25963":102797,"_2424":103973},[],"Confirmar con el administrador PKI que la operación está habilitada.",{"_2886":61399,"_27469":60910,"_18854":103975,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61400,"_27469":60910,"_18854":103977,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61401,"_27469":60910,"_18854":103979,"_5":12679,"_25963":102797,"_2424":103980},[],"`signerNotTrusted`: el firmante no encadena a las CAs de validación del DMS, o el destinatario de KGA está fuera del límite de confianza.",{"_2886":61402,"_27469":60910,"_18854":103982,"_5":12679,"_25963":102797,"_2424":103983},[],"Revisar el certificado con el que se firmó y las CAs configuradas.",{"_2886":61403,"_27469":60910,"_18854":103985,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61404,"_27469":60910,"_18854":103987,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61405,"_27469":60910,"_18854":103989,"_5":12679,"_25963":102797,"_2424":103990},[],"`certRevoked`: el certificado de protección fue sustituido por una renovación confirmada, o el certificado objetivo ya está revocado.",{"_2886":61406,"_27469":60910,"_18854":103992,"_5":12679,"_25963":102797,"_2424":103993},[],"Repetir el enrolamiento o revisar el estado de la identidad.",{"_2886":61407,"_27469":60910,"_18854":103995,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61408,"_27469":60910,"_18854":103997,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61409,"_27469":60910,"_18854":103999,"_5":12679,"_25963":102797,"_2424":104000},[],"`certConfirmed`: `certConf` duplicado (la confirmación ya se recibió).",{"_2886":61410,"_27469":60910,"_18854":104002,"_5":12679,"_25963":102797,"_2424":104003},[],"No repetir la confirmación salvo que se haya perdido el `pkiConf`.",{"_2886":61411,"_27469":60910,"_18854":104005,"_5":12679,"_25963":102797,"_2424":46951},[],{"_2886":61412,"_27469":60910,"_18854":104007,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61413,"_27469":60910,"_18854":104009,"_5":12679,"_25963":102797,"_2424":104010},[],"`badRequest`: transacción desconocida o expirada, sin certificado que confirmar, segunda renovación pendiente, o destinatario de KGA sin el uso de clave necesario.",{"_2886":61414,"_27469":60910,"_18854":104012,"_5":12679,"_25963":102797,"_2424":104013},[],"Inspeccionar el motivo exacto (`statusString`) y corregir el flujo.",{"_2886":61415,"_27469":60910,"_18854":104015,"_5":12679,"_25963":102797,"_2424":104016},[],"200 (`ip`/`cp`/`kup` con `status: rejection`)",{"_2886":61416,"_27469":60910,"_18854":104018,"_5":12679,"_25963":102797,"_2424":103907},[],{"_2886":61417,"_27469":60910,"_18854":104020,"_5":12679,"_25963":102797,"_2424":104021},[],"Política de emisión: POPO ausente o fallida (`badPOP`), solicitud de certificado de CA o RSA fuera de 2048–8192 bits (`badCertTemplate`), `notAuthorized` para POPO/destinatario de KGA no permitidos, `certReqId` inválido.",{"_2886":61418,"_27469":60910,"_18854":104023,"_5":12679,"_25963":102797,"_2424":104024},[],"Inspeccionar el `PKIFailureInfo` del cuerpo y contrastarlo con la configuración por operación del DMS.",{"_2886":61419,"_27469":60910,"_18854":104026,"_5":12679,"_25963":102797,"_2424":104027},[],"200 (`rp` con `status: rejection`)",{"_2886":61420,"_27469":60910,"_18854":104029,"_5":12679,"_25963":102797,"_2424":104030},[],"`PKIStatusInfo` del cuerpo",{"_2886":61421,"_27469":60910,"_18854":104032,"_5":12679,"_25963":102797,"_2424":104033},[],"Revocación: motivo no permitido (`badRequest`), `transactionID` repetido, certificado no encontrado (`badCertId`), ya revocado (`certRevoked`) o no revivible (`badCertId`), o firmante sin autoridad sobre el certificado (`signerNotTrusted`/`notAuthorized`).",{"_2886":61422,"_27469":60910,"_18854":104035,"_5":12679,"_25963":102797,"_2424":104036},[],"Contrastar con la política `rr` del DMS.",{"_2886":61423,"_27469":60910,"_18854":104038,"_5":12679,"_25963":102797,"_2424":104039},[],"Para interpretar el motivo exacto de un rechazo CMP, inspeccione el campo `PKIFailureInfo`/`statusString` del `PKIMessage` de respuesta (por ejemplo con `openssl cmp ... -rspout response.der` y `openssl asn1parse -inform DER -in response.der`). En los logs del servidor Lamassu, cada rechazo genera un evento estructurado `CMP operation rejected` con los campos `dms`, `pkiStatus`, `pkiFailureInfo`, `reason` y `txid`; los fallos de cliente se registran como `WARN` y los internos (`systemFailure`) como `ERROR`.",{"_2886":61424,"_27469":60910,"_18854":104041,"_5":12679,"_25963":102801,"_2424":104042},[],"La implementación de Lamassu sigue el perfil Lightweight CMP con las siguientes particularidades que afectan a clientes CMP estrictos:",{"_2886":61425,"_27469":60910,"_18854":104044,"_5":12679,"_25963":102801,"_2424":104045},[],"CMP se sirve en un único endpoint multiplexado (`/.well-known/cmp/p/{id}`); no existen rutas separadas por operación como en EST.",{"_2886":61426,"_27469":60910,"_18854":104047,"_5":12679,"_25963":102801,"_2424":104048},[],"Se aceptan y responden las versiones `cmp2000(2)` y `cmp2021(3)`; la respuesta devuelve el mismo `pvno` que la solicitud.",{"_2886":61427,"_27469":60910,"_18854":104050,"_5":12679,"_25963":102801,"_2424":104051},[],"`messageTime` es obligatorio en **todos** los mensajes (no solo en los protegidos), con una tolerancia de deriva de 5 minutos (`badTime`).",{"_2886":61428,"_27469":60910,"_18854":104053,"_5":12679,"_25963":102801,"_2424":104054},[],"`transactionID` y `senderNonce` deben tener al menos 128 bits de entropía, y el `senderNonce` debe ser nuevo en cada mensaje.",{"_2886":61429,"_27469":60910,"_18854":104056,"_5":12679,"_25963":102801,"_2424":104057},[],"Las operaciones `ir`, `cr` y `p10cr` no admiten `recipNonce` en la solicitud inicial (RFC 9483 §3.1); un cliente que lo incluya recibe `badRecipientNonce`. Las reglas de `generalInfo` se imponen igualmente: `implicitConfirm` y `confirmWaitTime` son mutuamente excluyentes, el valor de `implicitConfirm` debe ser `NULL` y el de `confirmWaitTime` un `GeneralizedTime`.",{"_2886":61430,"_27469":60910,"_18854":104059,"_5":12679,"_25963":102801,"_2424":104060},[],"Con protección por firma, el `sender` de la cabecera debe coincidir con el subject del certificado de protección y el `senderKID` con su `SubjectKeyIdentifier` (`badMessageCheck` en caso contrario). Los `genm` quedan exentos de esta comprobación de identidad.",{"_2886":61431,"_27469":60910,"_18854":104062,"_5":12679,"_25963":102801,"_2424":104063},[],"El subject puede ser NULL-DN solo si el SAN porta la identidad; para la identidad interna del dispositivo el SAN se usa como reserva, pero el certificado emitido conserva el subject vacío.",{"_2886":61432,"_27469":60910,"_18854":104065,"_5":12679,"_25963":102801,"_2424":104066},[],"Lamassu nunca emite certificados de CA vía CMP; la única operación que produce certificados de CA es `ccr`.",{"_2886":61433,"_27469":60910,"_18854":104068,"_5":12679,"_25963":102801,"_2424":104069},[],"El tipo `id-it-revPassphrase` del `genm` está deshabilitado de forma permanente.",{"_2886":61434,"_27469":60910,"_18854":104071,"_5":12679,"_25963":102801,"_2424":104072},[],"Los estados internos `APPROVING` y `REVOKING` de una transacción son transitorios y no se exponen en la API de listado; solo aparecen `PENDING`, `ISSUED`, `ISSUE_FAILED`, `CONFIRMED` y `REVOKED`.",{"_2886":61435,"_27469":60910,"_18854":104074,"_5":12679,"_25963":102801,"_2424":104075},[],"Los registros de transacción en estado terminal (`CONFIRMED`, `REVOKED`) se conservan para auditoría y no se borran por expiración; un `transactionID` completado puede reutilizarse en una operación nueva, salvo en `rr`, donde la protección contra repetición también mira los registros terminales.",{"_2886":61436,"_27469":60910,"_18854":104077,"_5":12679,"_25963":102801,"_2424":104078},[],"El certificado de protección debe renovarse manualmente antes de caducar: el DMS no lo renueva automáticamente, y mientras no haya uno configurado, todas las respuestas salen sin protección.",{"_2886":61437,"_27469":60910,"_18854":104080,"_5":12679,"_25963":102801,"_2424":104081},[],"<Card title=\"Visión general del DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2886":61438,"_27469":60910,"_18854":104083,"_5":12679,"_25963":102801,"_2424":47131},[],{"_2886":61439,"_27469":60910,"_18854":104085,"_5":12679,"_25963":102801,"_2424":104086},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/platform/pki/device-management\" />",{"_2886":61440,"_27469":61440,"_5":13057,"_2424":104088,"_27749":104089,"_18854":104091,"_25963":61440},"Arquitectura de la plataforma",[43001,101196,104090],"Conceptos",[],{"_2886":61441,"_27469":61440,"_18854":104093,"_5":12679,"_25963":61440,"_2424":104094},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2886":61442,"_27469":61440,"_5":27746,"_18854":104096,"_25963":104097,"_2424":104098},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/architecture#plano-de-control","Plano de control",{"_2886":61443,"_27469":61440,"_5":27746,"_18854":104100,"_25963":104101,"_2424":104102},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2886":61444,"_27469":61440,"_5":27746,"_18854":104104,"_25963":104105,"_2424":104106},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2886":61445,"_27469":61440,"_5":27746,"_18854":104108,"_25963":104109,"_2424":104110},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/architecture#estado-y-validación","Estado y validación",{"_2886":61446,"_27469":61440,"_5":27746,"_18854":104112,"_25963":104113,"_2424":104114},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2886":61447,"_27469":61440,"_18854":104116,"_5":12679,"_25963":61440,"_2424":104117},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2886":61448,"_27469":61440,"_18854":104119,"_5":12679,"_25963":104097,"_2424":104120},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2886":61449,"_27469":61440,"_18854":104122,"_5":12679,"_25963":104101,"_2424":104123},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2886":61450,"_27469":61440,"_18854":104125,"_5":12679,"_25963":104105,"_2424":104126},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos del protocolo configurado —EST o CMP— para que un dispositivo solicite o renueve una identidad.",{"_2886":61451,"_27469":61440,"_18854":104128,"_5":12679,"_25963":104109,"_2424":104129},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2886":61452,"_27469":61440,"_18854":104131,"_5":12679,"_25963":104113,"_2424":104132},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2886":61453,"_27469":61453,"_5":13057,"_2424":104134,"_27749":104135,"_18854":104136,"_25963":61453},"Ciclo de vida de un certificado",[43001,101196,104090],[],{"_2886":61454,"_27469":61453,"_18854":104138,"_5":12679,"_25963":61453,"_2424":104139},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2886":61455,"_27469":61453,"_5":27746,"_18854":104141,"_25963":104142,"_2424":104143},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2886":61456,"_27469":61453,"_5":27746,"_18854":104145,"_25963":104146,"_2424":104147},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2886":61457,"_27469":61453,"_5":27746,"_18854":104149,"_25963":104150,"_2424":104151},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2886":61458,"_27469":61453,"_5":27746,"_18854":104153,"_25963":104154,"_2424":104155},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2886":61459,"_27469":61453,"_5":27746,"_18854":104157,"_25963":104158,"_2424":104159},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2886":61460,"_27469":61453,"_5":27746,"_18854":104161,"_25963":104162,"_2424":104163},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2886":61461,"_27469":61453,"_5":27746,"_18854":104165,"_25963":104166,"_2424":104167},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2886":61462,"_27469":61453,"_5":27746,"_18854":104169,"_25963":104170,"_2424":104171},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2886":61463,"_27469":61453,"_5":27746,"_18854":104173,"_25963":104174,"_2424":104175},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2886":61464,"_27469":61453,"_5":27746,"_18854":104177,"_25963":104178,"_2424":104179},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2886":61465,"_27469":61453,"_18854":104181,"_5":12679,"_25963":61453,"_2424":104182},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2886":61466,"_27469":61453,"_18854":104184,"_5":12679,"_25963":104146,"_2424":104185},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2886":61467,"_27469":61453,"_18854":104187,"_5":12679,"_25963":104150,"_2424":104188},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2886":61468,"_27469":61453,"_18854":104190,"_5":12679,"_25963":104154,"_2424":104191},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2886":61469,"_27469":61453,"_18854":104193,"_5":12679,"_25963":104158,"_2424":104194},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2886":61470,"_27469":61453,"_18854":104196,"_5":12679,"_25963":104162,"_2424":104197},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2886":61471,"_27469":61453,"_18854":104199,"_5":12679,"_25963":104166,"_2424":104200},[],"Lamassu persiste cuatro estados X.509:",{"_2886":61472,"_27469":61453,"_18854":104202,"_5":12679,"_25963":104166,"_2424":104203},[],"**`ACTIVE`**: el certificado está habilitado y dentro de su periodo de validez.",{"_2886":61473,"_27469":61453,"_18854":104205,"_5":12679,"_25963":104166,"_2424":104206},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2886":61474,"_27469":61453,"_18854":104208,"_5":12679,"_25963":104166,"_2424":104209},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2886":61475,"_27469":61453,"_18854":104211,"_5":12679,"_25963":104166,"_2424":104212},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2886":61476,"_27469":61453,"_18854":104214,"_5":12679,"_25963":104166,"_2424":104215},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2886":61477,"_27469":61453,"_18854":104217,"_5":12679,"_25963":104170,"_2424":104218},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2886":61478,"_27469":61453,"_18854":104220,"_5":12679,"_25963":104170,"_2424":104221},[],"Solo una revocación con razón `CertificateHold` puede revertirse. Una revocación con cualquier otra razón es definitiva en Lamassu.",{"_2886":61479,"_27469":61453,"_18854":104223,"_5":12679,"_25963":104170,"_2424":104224},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2886":61480,"_27469":61453,"_18854":104226,"_5":12679,"_25963":104174,"_2424":104227},[],"Revocar una CA es una operación en cascada. Lamassu revoca sus CAs hijas y los certificados que ha emitido con la razón `CessationOfOperation`. La propagación continúa por la jerarquía.",{"_2886":61481,"_27469":61453,"_18854":104229,"_5":12679,"_25963":104174,"_2424":104230},[],"Antes de confirmar:",{"_2886":61482,"_27469":61453,"_18854":104232,"_5":12679,"_25963":104174,"_2424":104233},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2886":61483,"_27469":61453,"_18854":104235,"_5":12679,"_25963":104174,"_2424":104236},[],"Distribuye la nueva cadena de confianza.",{"_2886":61484,"_27469":61453,"_18854":104238,"_5":12679,"_25963":104174,"_2424":104239},[],"Reemite las identidades necesarias.",{"_2886":61485,"_27469":61453,"_18854":104241,"_5":12679,"_25963":104174,"_2424":104242},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2886":61486,"_27469":61453,"_18854":104244,"_5":12679,"_25963":104174,"_2424":104245},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2886":61487,"_27469":61453,"_18854":104247,"_5":12679,"_25963":104174,"_2424":104248},[],"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente.",{"_2886":61488,"_27469":61453,"_18854":104250,"_5":12679,"_25963":104178,"_2424":104251},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2886":61489,"_27469":61453,"_18854":104253,"_5":12679,"_25963":104178,"_2424":104254},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2886":61490,"_27469":61453,"_18854":104256,"_5":12679,"_25963":104178,"_2424":104257},[],"Cambios de estado y razones de revocación.",{"_2886":61491,"_27469":61453,"_18854":104259,"_5":12679,"_25963":104178,"_2424":104260},[],"Publicación y vigencia de OCSP y CRLs.",{"_2886":61492,"_27469":61453,"_18854":104262,"_5":12679,"_25963":104178,"_2424":104263},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2886":61493,"_27469":61453,"_18854":104265,"_5":12679,"_25963":104178,"_2424":104266},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2886":61494,"_27469":61494,"_5":13057,"_2424":104268,"_27749":104269,"_18854":104270,"_25963":61494},"Glosario",[43001,101196,104090],[],{"_2886":61495,"_27469":61494,"_18854":104272,"_5":12679,"_25963":61494,"_2424":104273},[],"Términos de PKI, certificados y gestión de identidades usados en Lamassu.",{"_2886":61496,"_27469":61494,"_5":27746,"_18854":104275,"_25963":104276,"_2424":47325},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/glossary#ac",{"_2886":61497,"_27469":61494,"_5":27746,"_18854":104278,"_25963":104279,"_2424":47329},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/glossary#dk",{"_2886":61498,"_27469":61494,"_5":27746,"_18854":104281,"_25963":104282,"_2424":47333},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/glossary#mr",{"_2886":61499,"_27469":61494,"_5":27746,"_18854":104284,"_25963":104285,"_2424":47337},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/glossary#sz",{"_2886":61500,"_27469":61494,"_18854":104287,"_5":12679,"_25963":104276,"_2424":104288},[],"**AKI (Authority Key Identifier)**\\\nIdentificador de la clave pública de la autoridad que firmó un certificado. Ayuda a construir la cadena hacia el emisor correcto.",{"_2886":61501,"_27469":61494,"_18854":104290,"_5":12679,"_25963":104276,"_2424":104291},[],"**Ancla de confianza**\\\nCertificado, normalmente de una CA raíz, que un consumidor acepta de forma explícita como punto final de una cadena.",{"_2886":61502,"_27469":61494,"_18854":104293,"_5":12679,"_25963":104276,"_2424":104294},[],"**CA (Certification Authority)**\\\nAutoridad que firma certificados y vincula una identidad con una clave pública.",{"_2886":61503,"_27469":61494,"_18854":104296,"_5":12679,"_25963":104276,"_2424":104297},[],"**CA intermedia**\\\nCA firmada por otra autoridad. Se utiliza para emitir sin exponer la raíz a la operación diaria.",{"_2886":61504,"_27469":61494,"_18854":104299,"_5":12679,"_25963":104276,"_2424":104300},[],"**CA raíz**\\\nCA autofirmada que inicia una jerarquía de confianza.",{"_2886":61505,"_27469":61494,"_18854":104302,"_5":12679,"_25963":104276,"_2424":104303},[],"**Certificado X.509**\\\nDocumento firmado que contiene una clave pública, un sujeto, un emisor, un periodo de validez y extensiones que delimitan su uso.",{"_2886":61506,"_27469":61494,"_18854":104305,"_5":12679,"_25963":104276,"_2424":104306},[],"**CRL (Certificate Revocation List)**\\\nLista firmada de certificados revocados publicada por una CA.",{"_2886":61507,"_27469":61494,"_18854":104308,"_5":12679,"_25963":104276,"_2424":104309},[],"**CSR (Certificate Signing Request)**\\\nSolicitud PKCS#10 que contiene una clave pública y atributos solicitados. La firma de la CSR demuestra posesión de la clave privada correspondiente.",{"_2886":61508,"_27469":61494,"_18854":104311,"_5":12679,"_25963":104279,"_2424":104312},[],"**DMS (Device Management Service)**\\\nConfiguración que agrupa reglas de registro, enrolamiento, re-enrolamiento, emisión y distribución de CAs para una flota.",{"_2886":61509,"_27469":61494,"_18854":104314,"_5":12679,"_25963":104279,"_2424":104315},[],"**Distinguished Name (DN)**\\\nConjunto de atributos del sujeto o emisor, como `CN`, `O`, `OU`, `C`, `ST` y `L`.",{"_2886":61510,"_27469":61494,"_18854":104317,"_5":12679,"_25963":104279,"_2424":104318},[],"**EST (Enrollment over Secure Transport)**\\\nProtocolo definido en RFC 7030 para obtener CAs, enrolar y re-enrolar certificados sobre HTTPS.",{"_2886":61511,"_27469":61494,"_18854":104320,"_5":12679,"_25963":104279,"_2424":104321},[],"**Extended Key Usage (EKU)**\\\nExtensión que acota finalidades como autenticación de cliente, autenticación de servidor, firma de código u OCSP.",{"_2886":61512,"_27469":61494,"_18854":104323,"_5":12679,"_25963":104279,"_2424":104324},[],"**Identidad de dispositivo**\\\nRelación entre un dispositivo y uno de sus certificados. Un dispositivo puede conservar un historial de identidades.",{"_2886":61513,"_27469":61494,"_18854":104326,"_5":12679,"_25963":104279,"_2424":104327},[],"**Identity slot**\\\nPosición lógica en un dispositivo donde Lamassu vincula una identidad activa o histórica.",{"_2886":61514,"_27469":61494,"_18854":104329,"_5":12679,"_25963":104279,"_2424":104330},[],"**JITP (Just-in-Time Provisioning)**\\\nRegistro automático de un dispositivo cuando completa correctamente su primer enrolamiento.",{"_2886":61515,"_27469":61494,"_18854":104332,"_5":12679,"_25963":104279,"_2424":104333},[],"**KMS (Key Management Service)**\\\nServicio de Lamassu que normaliza generación, importación y uso de claves sobre distintos motores criptográficos.",{"_2886":61516,"_27469":61494,"_18854":104335,"_5":12679,"_25963":104279,"_2424":104336},[],"**Key Usage**\\\nExtensión X.509 que permite operaciones básicas como firma digital, cifrado de clave o firma de certificados.",{"_2886":61517,"_27469":61494,"_18854":104338,"_5":12679,"_25963":104282,"_2424":104339},[],"**mTLS (Mutual TLS)**\\\nTLS donde cliente y servidor presentan certificados. Un DMS puede usar el certificado cliente como método de autenticación.",{"_2886":61518,"_27469":61494,"_18854":104341,"_5":12679,"_25963":104282,"_2424":104342},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocolo para consultar en línea si un certificado está vigente, revocado o es desconocido.",{"_2886":61519,"_27469":61494,"_18854":104344,"_5":12679,"_25963":104282,"_2424":104345},[],"**Perfil de emisión**\\\nPolítica reutilizable que define cómo Lamassu construye un certificado y qué claves acepta.",{"_2886":61520,"_27469":61494,"_18854":104347,"_5":12679,"_25963":104282,"_2424":104348},[],"**Principal**\\\nIdentidad de operador o cliente de API reconocida por el servicio de autorización. Lamassu admite principales OIDC y X.509.",{"_2886":61521,"_27469":61494,"_18854":104350,"_5":12679,"_25963":104282,"_2424":104351},[],"**Política**\\\nConjunto de permisos asignable a uno o varios principales.",{"_2886":61522,"_27469":61494,"_18854":104353,"_5":12679,"_25963":104282,"_2424":104354},[],"**RA (Registration Authority)**\\\nComponente que verifica al solicitante antes de pedir a una CA que emita. El DMS cumple este papel en los flujos de enrolamiento de dispositivos.",{"_2886":61523,"_27469":61494,"_18854":104356,"_5":12679,"_25963":104282,"_2424":104357},[],"**Relying party**\\\nSistema consumidor que decide si acepta un certificado presentado.",{"_2886":61524,"_27469":61494,"_18854":104359,"_5":12679,"_25963":104282,"_2424":104360},[],"**Revocación**\\\nInvalidación de un certificado antes de su fecha de expiración.",{"_2886":61525,"_27469":61494,"_18854":104362,"_5":12679,"_25963":104285,"_2424":104363},[],"**SAN (Subject Alternative Name)**\\\nExtensión que añade identidades como nombres DNS, direcciones IP, correos o URIs.",{"_2886":61526,"_27469":61494,"_18854":104365,"_5":12679,"_25963":104285,"_2424":104366},[],"**SKI (Subject Key Identifier)**\\\nIdentificador derivado de la clave pública del propio certificado.",{"_2886":61527,"_27469":61494,"_18854":104368,"_5":12679,"_25963":104285,"_2424":104369},[],"**VA (Validation Authority)**\\\nServicio de Lamassu responsable de las respuestas OCSP y la generación o publicación de CRLs.",{"_2886":61528,"_27469":61494,"_18854":104371,"_5":12679,"_25963":104285,"_2424":104372},[],"**Ventana de renovación**\\\nPeriodo anterior a la expiración durante el que un dispositivo puede o debe solicitar otra identidad.",{"_2886":61529,"_27469":61494,"_18854":104374,"_5":12679,"_25963":104285,"_2424":104375},[],"¿Falta un término operativo? Consulta primero Cómo funciona Lamassu y el Modelo de confianza, donde estos conceptos aparecen conectados.",{"_2886":61530,"_27469":61530,"_5":13057,"_2424":104377,"_27749":104378,"_18854":104379,"_25963":61530},"Cómo funciona Lamassu",[43001,101196,104090],[],{"_2886":61531,"_27469":61530,"_18854":104381,"_5":12679,"_25963":61530,"_2424":104382},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2886":61532,"_27469":61530,"_5":27746,"_18854":104384,"_25963":104385,"_2424":104386},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2886":61533,"_27469":61530,"_5":27746,"_18854":104388,"_25963":104389,"_2424":104390},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2886":61534,"_27469":61530,"_18854":104392,"_5":12679,"_25963":61530,"_2424":104393},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2886":61535,"_27469":61530,"_18854":104395,"_5":12679,"_25963":104385,"_2424":104396},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2886":61536,"_27469":61530,"_18854":104398,"_5":12679,"_25963":104385,"_2424":104399},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2886":61537,"_27469":61530,"_18854":104401,"_5":12679,"_25963":104385,"_2424":104402},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2886":61538,"_27469":61530,"_18854":104404,"_5":12679,"_25963":104385,"_2424":104405},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2886":61539,"_27469":61530,"_18854":104407,"_5":12679,"_25963":104385,"_2424":104408},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2886":61540,"_27469":61530,"_18854":104410,"_5":12679,"_25963":104389,"_2424":104411},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2886":61541,"_27469":61530,"_18854":104413,"_5":12679,"_25963":104389,"_2424":104414},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2886":61542,"_27469":61530,"_18854":104416,"_5":12679,"_25963":104389,"_2424":104417},[],"El dispositivo genera una clave y solicita un certificado mediante EST o CMP, o un operador le asigna una identidad.",{"_2886":61543,"_27469":61530,"_18854":104419,"_5":12679,"_25963":104389,"_2424":104420},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2886":61544,"_27469":61530,"_18854":104422,"_5":12679,"_25963":104389,"_2424":104423},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2886":61545,"_27469":61530,"_18854":104425,"_5":12679,"_25963":104389,"_2424":104426},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_2886":61546,"_27469":61530,"_18854":104428,"_5":12679,"_25963":104389,"_2424":104429},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2886":61547,"_27469":61547,"_5":13057,"_2424":104431,"_27749":104432,"_18854":104433,"_25963":61547},"Modelo de confianza",[43001,101196,104090],[],{"_2886":61548,"_27469":61547,"_18854":104435,"_5":12679,"_25963":61547,"_2424":104436},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2886":61549,"_27469":61547,"_5":27746,"_18854":104438,"_25963":104439,"_2424":104440},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2886":61550,"_27469":61547,"_5":27746,"_18854":104442,"_25963":104443,"_2424":104444},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2886":61551,"_27469":61547,"_5":27746,"_18854":104446,"_25963":104447,"_2424":104448},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2886":61552,"_27469":61547,"_5":27746,"_18854":104450,"_25963":104451,"_2424":104452},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2886":61553,"_27469":61547,"_5":27746,"_18854":104454,"_25963":104455,"_2424":104456},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2886":61554,"_27469":61547,"_5":27746,"_18854":104458,"_25963":104459,"_2424":104460},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2886":61555,"_27469":61547,"_5":27746,"_18854":104462,"_25963":104463,"_2424":104464},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2886":61556,"_27469":61547,"_5":27746,"_18854":104466,"_25963":104467,"_2424":104468},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2886":61557,"_27469":61547,"_5":27746,"_18854":104470,"_25963":104471,"_2424":104472},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2886":61558,"_27469":61547,"_5":27746,"_18854":104474,"_25963":104475,"_2424":104476},[],"/docs/pr-preview/pr-24/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2886":61559,"_27469":61547,"_18854":104478,"_5":12679,"_25963":61547,"_2424":104479},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2886":61560,"_27469":61547,"_18854":104481,"_5":12679,"_25963":104443,"_2424":104482},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2886":61561,"_27469":61547,"_18854":104484,"_5":12679,"_25963":104447,"_2424":104485},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2886":61562,"_27469":61547,"_18854":104487,"_5":12679,"_25963":104451,"_2424":104488},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2886":61563,"_27469":61547,"_18854":104490,"_5":12679,"_25963":104455,"_2424":104491},[],"El servicio o dispositivo consumidor mantiene su propio almacén de confianza. Lamassu puede distribuir la CA del sistema, la CA de enrolamiento y otras CAs gestionadas mediante `/cacerts`, pero el consumidor decide cuáles instala y cómo aplica la validación.",{"_2886":61564,"_27469":61547,"_18854":104493,"_5":12679,"_25963":104459,"_2424":104494},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2886":61565,"_27469":61547,"_18854":104496,"_5":12679,"_25963":104459,"_2424":104497},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2886":61566,"_27469":61547,"_18854":104499,"_5":12679,"_25963":104459,"_2424":104500},[],"La CA aplica el perfil y firma sin recibir la clave privada del dispositivo.",{"_2886":61567,"_27469":61547,"_18854":104502,"_5":12679,"_25963":104459,"_2424":104503},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2886":61568,"_27469":61547,"_18854":104505,"_5":12679,"_25963":104459,"_2424":104506},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2886":61569,"_27469":61547,"_18854":104508,"_5":12679,"_25963":104459,"_2424":104509},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2886":61570,"_27469":61547,"_18854":104511,"_5":12679,"_25963":104463,"_2424":104512},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2886":61571,"_27469":61547,"_18854":104514,"_5":12679,"_25963":104463,"_2424":104515},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2886":61572,"_27469":61547,"_18854":104517,"_5":12679,"_25963":104463,"_2424":104518},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2886":61573,"_27469":61547,"_18854":104520,"_5":12679,"_25963":104463,"_2424":104521},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir la CA del sistema, la CA de enrolamiento y una lista de CAs gestionadas.",{"_2886":61574,"_27469":61547,"_18854":104523,"_5":12679,"_25963":104463,"_2424":104524},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2886":61575,"_27469":61547,"_18854":104526,"_5":12679,"_25963":104467,"_2424":104527},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2886":61576,"_27469":61547,"_18854":104529,"_5":12679,"_25963":104467,"_2424":104530},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2886":61577,"_27469":61547,"_18854":104532,"_5":12679,"_25963":104467,"_2424":104533},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2886":61578,"_27469":61547,"_18854":104535,"_5":12679,"_25963":104467,"_2424":104536},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2886":61579,"_27469":61547,"_18854":104538,"_5":12679,"_25963":104467,"_2424":104539},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2886":61580,"_27469":61547,"_18854":104541,"_5":12679,"_25963":104467,"_2424":104542},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2886":61581,"_27469":61547,"_18854":104544,"_5":12679,"_25963":104471,"_2424":104545},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2886":61582,"_27469":61547,"_18854":104547,"_5":12679,"_25963":104475,"_2424":104548},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2886":61583,"_27469":61547,"_18854":104550,"_5":12679,"_25963":104475,"_2424":104551},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2886":61584,"_27469":61547,"_18854":104553,"_5":12679,"_25963":104475,"_2424":104554},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2886":61585,"_27469":61547,"_18854":104556,"_5":12679,"_25963":104475,"_2424":104557},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2886":61586,"_27469":61547,"_18854":104559,"_5":12679,"_25963":104475,"_2424":104560},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2886":61587,"_27469":61547,"_18854":104562,"_5":12679,"_25963":104475,"_2424":104563},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2886":61588,"_27469":61547,"_18854":104565,"_5":12679,"_25963":104475,"_2424":104566},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2886":61589,"_27469":61589,"_5":13057,"_2424":104568,"_27749":104569,"_18854":104570,"_25963":61589},"Listas de revocación (CRL)",[43001,101196,101674],[],{"_2886":61590,"_27469":61589,"_18854":104572,"_5":12679,"_25963":61589,"_2424":104573},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2886":61591,"_27469":61589,"_5":27746,"_18854":104575,"_25963":104576,"_2424":104577},[],"/docs/pr-preview/pr-24/es/platform/pki/crl#servicio-crl","Servicio CRL",{"_2886":61592,"_27469":61589,"_5":27746,"_18854":104579,"_25963":104580,"_2424":104581},[],"/docs/pr-preview/pr-24/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2886":61593,"_27469":61589,"_5":27746,"_18854":104583,"_25963":104584,"_2424":104585},[],"/docs/pr-preview/pr-24/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2886":61594,"_27469":61589,"_5":27746,"_18854":104587,"_25963":104588,"_2424":104589},[],"/docs/pr-preview/pr-24/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2886":61595,"_27469":61589,"_5":27746,"_18854":104591,"_25963":104592,"_2424":104593},[],"/docs/pr-preview/pr-24/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2886":61596,"_27469":61589,"_5":27746,"_18854":104595,"_25963":104596,"_2424":104597},[],"/docs/pr-preview/pr-24/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2886":61597,"_27469":61589,"_5":27746,"_18854":104599,"_25963":104600,"_2424":104601},[],"/docs/pr-preview/pr-24/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2886":61598,"_27469":61589,"_5":27746,"_18854":104603,"_25963":104604,"_2424":104605},[],"/docs/pr-preview/pr-24/es/platform/pki/crl#referencias","Referencias",{"_2886":61599,"_27469":61589,"_18854":104607,"_5":12679,"_25963":104576,"_2424":104608},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_2886":61600,"_27469":61589,"_18854":104610,"_5":12679,"_25963":104576,"_2424":104611},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_2886":61601,"_27469":61589,"_18854":104613,"_5":12679,"_25963":104580,"_2424":104614},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_2886":61602,"_27469":61589,"_18854":104616,"_5":12679,"_25963":104580,"_2424":104617},[],"Los parámetros principales son:",{"_2886":61603,"_27469":61589,"_18854":104619,"_5":12679,"_25963":104580,"_2424":104620},[],"**`validity`** define el periodo de validez reflejado en `nextUpdate`. Su valor predeterminado es 7 días.",{"_2886":61604,"_27469":61589,"_18854":104622,"_5":12679,"_25963":104580,"_2424":104623},[],"**`refresh_interval`** establece el intervalo mínimo entre regeneraciones programadas. Por defecto es aproximadamente 6 días y 23 horas.",{"_2886":61605,"_27469":61589,"_18854":104625,"_5":12679,"_25963":104580,"_2424":104626},[],"**`regenerate_on_revoke`** ordena publicar una versión nueva inmediatamente después de una revocación. Está activo por defecto.",{"_2886":61606,"_27469":61589,"_18854":104628,"_5":12679,"_25963":104580,"_2424":104629},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_2886":61607,"_27469":61589,"_18854":104631,"_5":12679,"_25963":104580,"_2424":104632},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_2886":61608,"_27469":61589,"_18854":104634,"_5":12679,"_25963":104584,"_2424":104635},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_2886":61609,"_27469":61589,"_18854":104637,"_5":12679,"_25963":104584,"_2424":104638},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_2886":61610,"_27469":61589,"_18854":104640,"_5":12679,"_25963":104588,"_2424":104641},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_2886":61611,"_27469":61589,"_18854":104643,"_5":12679,"_25963":104588,"_2424":104644},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_2886":61612,"_27469":61589,"_18854":104646,"_5":12679,"_25963":104592,"_2424":104647},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_2886":61613,"_27469":61589,"_18854":104649,"_5":12679,"_25963":104592,"_2424":104650},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_2886":61614,"_27469":61589,"_18854":104652,"_5":12679,"_25963":104596,"_2424":104653},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_2886":61615,"_27469":61589,"_18854":104655,"_5":12679,"_25963":104596,"_2424":104656},[],"Método",{"_2886":61616,"_27469":61589,"_18854":104658,"_5":12679,"_25963":104596,"_2424":104659},[],"Ruta",{"_2886":61617,"_27469":61589,"_18854":104661,"_5":12679,"_25963":104596,"_2424":102947},[],{"_2886":61618,"_27469":61589,"_18854":104663,"_5":12679,"_25963":104596,"_2424":47716},[],{"_2886":61619,"_27469":61589,"_18854":104665,"_5":12679,"_25963":104596,"_2424":47719},[],{"_2886":61620,"_27469":61589,"_18854":104667,"_5":12679,"_25963":104596,"_2424":104668},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_2886":61621,"_27469":61589,"_18854":104670,"_5":12679,"_25963":104596,"_2424":47725},[],{"_2886":61622,"_27469":61589,"_18854":104672,"_5":12679,"_25963":104596,"_2424":47719},[],{"_2886":61623,"_27469":61589,"_18854":104674,"_5":12679,"_25963":104596,"_2424":104675},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_2886":61624,"_27469":61589,"_18854":104677,"_5":12679,"_25963":104596,"_2424":104678},[],"Ejemplo de consulta del rol VA:",{"_2886":61625,"_27469":61589,"_18854":104680,"_5":12679,"_25963":104596,"_2424":104681},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_2886":61626,"_27469":61589,"_18854":104683,"_5":12679,"_25963":104600,"_2424":104684},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_2886":61627,"_27469":61589,"_18854":104686,"_5":12679,"_25963":104604,"_2424":47742},[],{"_2886":61628,"_27469":61589,"_18854":104688,"_5":12679,"_25963":104604,"_2424":104689},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2886":61629,"_27469":61589,"_18854":104691,"_5":12679,"_25963":104604,"_2424":104692},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2886":61630,"_27469":61630,"_5":13057,"_2424":47750,"_27749":104694,"_18854":104695,"_25963":61630},[43001,101196,101674],[],{"_2886":61631,"_27469":61630,"_18854":104697,"_5":12679,"_25963":61630,"_2424":104698},[],"Define cómo una flota recibe, renueva y utiliza sus identidades.",{"_2886":61632,"_27469":61630,"_5":27746,"_18854":104700,"_25963":104701,"_2424":100107},[],"/docs/pr-preview/pr-24/es/platform/pki/device-enrollment#antes-de-empezar",{"_2886":61633,"_27469":61630,"_5":27746,"_18854":104703,"_25963":104704,"_2424":104705},[],"/docs/pr-preview/pr-24/es/platform/pki/device-enrollment#configura-un-dms","Configura un DMS",{"_2886":61634,"_27469":61630,"_5":27746,"_18854":104707,"_25963":104708,"_2424":104709},[],"/docs/pr-preview/pr-24/es/platform/pki/device-enrollment#identifica-la-flota","Identifica la flota",{"_2886":61635,"_27469":61630,"_5":27746,"_18854":104711,"_25963":104712,"_2424":104713},[],"/docs/pr-preview/pr-24/es/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2886":61636,"_27469":61630,"_5":27746,"_18854":104715,"_25963":104716,"_2424":104717},[],"/docs/pr-preview/pr-24/es/platform/pki/device-enrollment#configura-el-protocolo-de-enrolamiento","Configura el protocolo de enrolamiento",{"_2886":61637,"_27469":61630,"_5":27746,"_18854":104719,"_25963":104720,"_2424":104721},[],"/docs/pr-preview/pr-24/es/platform/pki/device-enrollment#distribuye-la-confianza","Distribuye la confianza",{"_2886":61638,"_27469":61630,"_5":27746,"_18854":104723,"_25963":104724,"_2424":104725},[],"/docs/pr-preview/pr-24/es/platform/pki/device-enrollment#verifica-los-endpoints","Verifica los endpoints",{"_2886":61639,"_27469":61630,"_5":27746,"_18854":104727,"_25963":104728,"_2424":104729},[],"/docs/pr-preview/pr-24/es/platform/pki/device-enrollment#distribución-de-confianza","Distribución de confianza",{"_2886":61640,"_27469":61630,"_5":27746,"_18854":104731,"_25963":104732,"_2424":104733},[],"/docs/pr-preview/pr-24/es/platform/pki/device-enrollment#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2886":61641,"_27469":61630,"_5":27746,"_18854":104735,"_25963":104736,"_2424":104737},[],"/docs/pr-preview/pr-24/es/platform/pki/device-enrollment#integra-los-dispositivos","Integra los dispositivos",{"_2886":61642,"_27469":61630,"_18854":104739,"_5":12679,"_25963":61630,"_2424":104740},[],"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada.",{"_2886":61643,"_27469":61630,"_18854":104742,"_5":12679,"_25963":61630,"_2424":104743},[],"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación.",{"_2886":61644,"_27469":61630,"_18854":104745,"_5":12679,"_25963":61630,"_2424":104746},[],"Cada DMS expone un único protocolo de enrolamiento, seleccionado al crearlo o editarlo: &#x2A;*EST (RFC 7030)** o &#x2A;*CMP (RFC 9483 Lightweight CMP Profile / RFC 4210)**. Los dos protocolos son mutuamente excluyentes: cambiar el protocolo de un DMS existente sustituye por completo su configuración de enrolamiento, sin migración automática de ajustes. La configuración de cada protocolo y la guía de integración para dispositivos se documentan en las páginas de EST y CMP.",{"_2886":61645,"_27469":61630,"_18854":104748,"_5":12679,"_25963":104701,"_2424":104749},[],"Crea o importa al menos una CA activa.",{"_2886":61646,"_27469":61630,"_18854":104751,"_5":12679,"_25963":104701,"_2424":104752},[],"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento.",{"_2886":61647,"_27469":61630,"_18854":104754,"_5":12679,"_25963":104701,"_2424":104755},[],"Define qué autoridades debe recibir el dispositivo como anclas de confianza.",{"_2886":61648,"_27469":61630,"_18854":104757,"_5":12679,"_25963":104701,"_2424":104758},[],"Asegúrate de tener permisos para administrar DMS.",{"_2886":61649,"_27469":61630,"_18854":104760,"_5":12679,"_25963":104708,"_2424":104761},[],"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno.",{"_2886":61650,"_27469":61630,"_18854":104763,"_5":12679,"_25963":104712,"_2424":104764},[],"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota.",{"_2886":61651,"_27469":61630,"_18854":104766,"_5":12679,"_25963":104716,"_2424":104767},[],"Selecciona EST (RFC 7030) o CMP (RFC 9483) y define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, la generación de claves en servidor.",{"_2886":61652,"_27469":61630,"_18854":104769,"_5":12679,"_25963":104720,"_2424":104770},[],"Configura **CA Distribution** para controlar qué autoridades recibe el dispositivo como anclas de confianza, con independencia del protocolo de enrolamiento.",{"_2886":61653,"_27469":61630,"_18854":104772,"_5":12679,"_25963":104724,"_2424":104773},[],"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware.",{"_2886":61654,"_27469":61630,"_18854":104775,"_5":12679,"_25963":104728,"_2424":104776},[],"**Include Lamassu System CA** distribuye el certificado TLS del servidor Lamassu, útil para *pinning*. No representa una CA de emisión.",{"_2886":61655,"_27469":61630,"_18854":104778,"_5":12679,"_25963":104728,"_2424":104779},[],"**Include Enrollment CA** añade la autoridad configurada para emitir las identidades del DMS.",{"_2886":61656,"_27469":61630,"_18854":104781,"_5":12679,"_25963":104728,"_2424":104782},[],"**Managed CAs** permite incluir autoridades adicionales que el dispositivo debe considerar de confianza.",{"_2886":61657,"_27469":61630,"_18854":104784,"_5":12679,"_25963":104732,"_2424":104785},[],"**Edit** modifica la política del DMS.",{"_2886":61658,"_27469":61630,"_18854":104787,"_5":12679,"_25963":104732,"_2424":104788},[],"**Go to DMS owned devices** abre únicamente los dispositivos de esa flota.",{"_2886":61659,"_27469":61630,"_18854":104790,"_5":12679,"_25963":104732,"_2424":104791},[],"**Show/Edit Metadata** permite gestionar configuración avanzada y datos de integraciones.",{"_2886":61660,"_27469":61630,"_18854":104793,"_5":12679,"_25963":104732,"_2424":104794},[],"**EST (RFC-7030)** muestra los endpoints y ejemplos específicos del DMS.",{"_2886":61661,"_27469":61630,"_18854":104796,"_5":12679,"_25963":104732,"_2424":104797},[],"**Delete** elimina el DMS y su configuración. La acción es irreversible.",{"_2886":61662,"_27469":61630,"_18854":104799,"_5":12679,"_25963":104736,"_2424":104800},[],"<Card title=\"Enrolamiento EST\" description=\"Configura autenticación, endpoints y flujos para firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2886":61663,"_27469":61630,"_18854":104802,"_5":12679,"_25963":104736,"_2424":104803},[],"<Card title=\"Enrolamiento CMP\" description=\"Configura autenticación, operaciones y transacciones para firmware.\" href=\"/docs/platform/pki/cmp\" />",{"_2886":61664,"_27469":61630,"_18854":104805,"_5":12679,"_25963":104736,"_2424":104806},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta estados, historial y acciones operativas.\" href=\"/docs/platform/pki/device-management\" />",{"_2886":61665,"_27469":61665,"_5":13057,"_2424":104808,"_27749":104809,"_18854":104810,"_25963":61665},"Dispositivos e identidades",[43001,101196,101674],[],{"_2886":61666,"_27469":61665,"_18854":104812,"_5":12679,"_25963":61665,"_2424":104813},[],"Registra dispositivos y controla sus identidades durante todo el ciclo de vida.",{"_2886":61667,"_27469":61665,"_5":27746,"_18854":104815,"_25963":104816,"_2424":104817},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2886":61668,"_27469":61665,"_5":27746,"_18854":104819,"_25963":104820,"_2424":104821},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2886":61669,"_27469":61665,"_5":27746,"_18854":104823,"_25963":104824,"_2424":104825},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2886":61670,"_27469":61665,"_5":27746,"_18854":104827,"_25963":104828,"_2424":104829},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2886":61671,"_27469":61665,"_5":27746,"_18854":104831,"_25963":104832,"_2424":104833},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#define-su-pertenencia","Define su pertenencia",{"_2886":61672,"_27469":61665,"_5":27746,"_18854":104835,"_25963":104836,"_2424":104837},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2886":61673,"_27469":61665,"_5":27746,"_18854":104839,"_25963":104840,"_2424":104841},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#verifica-el-alta","Verifica el alta",{"_2886":61674,"_27469":61665,"_5":27746,"_18854":104843,"_25963":104844,"_2424":104845},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2886":61675,"_27469":61665,"_5":27746,"_18854":104847,"_25963":104848,"_2424":104849},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2886":61676,"_27469":61665,"_5":27746,"_18854":104851,"_25963":104852,"_2424":104853},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2886":61677,"_27469":61665,"_5":27746,"_18854":104855,"_25963":104856,"_2424":104857},[],"/docs/pr-preview/pr-24/es/platform/pki/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2886":61678,"_27469":61665,"_18854":104859,"_5":12679,"_25963":61665,"_2424":104860},[],"Un dispositivo gestionado representa una entidad de tu flota y conserva el historial de los certificados que ha utilizado. Lamassu separa el dispositivo de su identidad actual para que puedas renovar o sustituir certificados sin perder trazabilidad.",{"_2886":61679,"_27469":61665,"_18854":104862,"_5":12679,"_25963":104816,"_2424":104863},[],"**Active** indica que el dispositivo tiene una identidad válida.",{"_2886":61680,"_27469":61665,"_18854":104865,"_5":12679,"_25963":104816,"_2424":104866},[],"**No Identity** aparece cuando está registrado, pero todavía no tiene un certificado asociado.",{"_2886":61681,"_27469":61665,"_18854":104868,"_5":12679,"_25963":104816,"_2424":104869},[],"**Renewal Pending** señala que ha entrado en la ventana de renovación.",{"_2886":61682,"_27469":61665,"_18854":104871,"_5":12679,"_25963":104816,"_2424":104872},[],"**Expiring Soon** advierte que el certificado está próximo a expirar.",{"_2886":61683,"_27469":61665,"_18854":104874,"_5":12679,"_25963":104816,"_2424":104875},[],"**Expired** indica que la identidad ha superado su fecha de validez.",{"_2886":61684,"_27469":61665,"_18854":104877,"_5":12679,"_25963":104816,"_2424":104878},[],"**Revoked** identifica un certificado invalidado antes de su expiración.",{"_2886":61685,"_27469":61665,"_18854":104880,"_5":12679,"_25963":104816,"_2424":104881},[],"**Decommissioned** corresponde a un dispositivo retirado de forma permanente.",{"_2886":61686,"_27469":61665,"_18854":104883,"_5":12679,"_25963":104816,"_2424":104884},[],"El inventario permite filtrar por `Device ID`, etiquetas y estado.",{"_2886":61687,"_27469":61665,"_18854":104886,"_5":12679,"_25963":104820,"_2424":104887},[],"La vista de detalle separa dos perspectivas:",{"_2886":61688,"_27469":61665,"_18854":104889,"_5":12679,"_25963":104820,"_2424":104890},[],"**Certificate History** conserva todos los certificados asociados, con su número de serie, emisor, estado y periodo de validez.",{"_2886":61689,"_27469":61665,"_18854":104892,"_5":12679,"_25963":104820,"_2424":104893},[],"**Device Event Timeline** ordena cronológicamente registros, enrolamientos, renovaciones y cambios de estado.",{"_2886":61690,"_27469":61665,"_18854":104895,"_5":12679,"_25963":104820,"_2424":104896},[],"Utiliza el historial para auditoría y la línea de tiempo para reconstruir un incidente o diagnosticar una transición inesperada.",{"_2886":61691,"_27469":61665,"_18854":104898,"_5":12679,"_25963":104824,"_2424":104899},[],"El registro previo es útil cuando la política exige que el dispositivo exista antes de solicitar su primer certificado.",{"_2886":61692,"_27469":61665,"_18854":104901,"_5":12679,"_25963":104828,"_2424":104902},[],"Desde **Managed Devices**, abre el formulario de registro.",{"_2886":61693,"_27469":61665,"_18854":104904,"_5":12679,"_25963":104832,"_2424":104905},[],"Introduce un **Device ID** único y selecciona el DMS que aplicará las políticas de enrolamiento y renovación.",{"_2886":61694,"_27469":61665,"_18854":104907,"_5":12679,"_25963":104836,"_2424":104908},[],"Añade un icono y etiquetas si necesitas agruparlo por modelo, ubicación, entorno u otro criterio operativo.",{"_2886":61695,"_27469":61665,"_18854":104910,"_5":12679,"_25963":104840,"_2424":104911},[],"El dispositivo debe aparecer con estado **No Identity** hasta que complete el enrolamiento o reciba una identidad manual.",{"_2886":61696,"_27469":61665,"_18854":104913,"_5":12679,"_25963":104844,"_2424":104914},[],"La acción **Assign Identity** está disponible mientras el dispositivo permanece en **No Identity**.",{"_2886":61697,"_27469":61665,"_18854":104916,"_5":12679,"_25963":104844,"_2424":104917},[],"Abre el dispositivo y selecciona **Assign Identity**.",{"_2886":61698,"_27469":61665,"_18854":104919,"_5":12679,"_25963":104844,"_2424":104920},[],"Elige un certificado activo cuyo `Common Name` coincida con el `Device ID`.",{"_2886":61699,"_27469":61665,"_18854":104922,"_5":12679,"_25963":104844,"_2424":104923},[],"Si no existe, selecciona **Issue New Instead** y elige una CA vinculada al DMS.",{"_2886":61700,"_27469":61665,"_18854":104925,"_5":12679,"_25963":104844,"_2424":104926},[],"Confirma la asignación.",{"_2886":61701,"_27469":61665,"_18854":104928,"_5":12679,"_25963":104844,"_2424":104929},[],"El dispositivo debe cambiar a **Active** y el certificado debe aparecer en su historial.",{"_2886":61702,"_27469":61665,"_18854":104931,"_5":12679,"_25963":104848,"_2424":104932},[],"En **Device Event Timeline**, localiza el último certificado activo y selecciona **Revoke**. Elige una razón conforme a tu política y confirma la operación.",{"_2886":61703,"_27469":61665,"_18854":104934,"_5":12679,"_25963":104848,"_2424":104935},[],"La revocación invalida el certificado, pero no elimina el dispositivo. Puedes restaurar su operación asignándole una identidad nueva. `CertificateHold` permite reactivar el certificado retenido; el resto de razones son definitivas.",{"_2886":61704,"_27469":61665,"_18854":104937,"_5":12679,"_25963":104852,"_2424":104938},[],"Esta acción revoca todos los certificados del dispositivo e impide que vuelva a obtener una identidad.",{"_2886":61705,"_27469":61665,"_18854":104940,"_5":12679,"_25963":104852,"_2424":104941},[],"Usa **Decommission** únicamente cuando el dispositivo haya dejado de operar o ya no sea fiable. Tras confirmar, Lamassu revoca la identidad activa con `CessationOfOperation` y cambia el estado a **Decommissioned**.",{"_2886":61706,"_27469":61665,"_18854":104943,"_5":12679,"_25963":104856,"_2424":104944},[],"<Card title=\"Configura un DMS\" description=\"Define la CA, confianza y políticas de la flota.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2886":61707,"_27469":61665,"_18854":104946,"_5":12679,"_25963":104856,"_2424":104947},[],"<Card title=\"Integra EST\" description=\"Permite que el dispositivo solicite y renueve su identidad.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2886":61708,"_27469":61665,"_18854":104949,"_5":12679,"_25963":104856,"_2424":104950},[],"<Card title=\"Integra CMP\" description=\"Permite que el dispositivo enrolle y renueve su identidad con CMP.\" href=\"/docs/platform/pki/cmp\" />",{"_2886":61709,"_27469":61709,"_5":13057,"_2424":104952,"_27749":104953,"_18854":104954,"_25963":61709},"Enrolamiento de dispositivos con EST",[43001,101196,101674],[],{"_2886":61710,"_27469":61709,"_18854":104956,"_5":12679,"_25963":61709,"_2424":104957},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_2886":61711,"_27469":61709,"_5":27746,"_18854":104959,"_25963":104960,"_2424":48018},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#est-enrollment-over-secure-transport",{"_2886":61712,"_27469":61709,"_5":27746,"_18854":104962,"_25963":104963,"_2424":102656},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#configuración-del-dms",{"_2886":61713,"_27469":61709,"_5":27746,"_18854":104965,"_25963":104966,"_2424":102660},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#requisitos-previos",{"_2886":61714,"_27469":61709,"_5":27746,"_18854":104968,"_25963":104969,"_2424":104970},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#configuración-de-enrollment","Configuración de enrollment",{"_2886":61715,"_27469":61709,"_5":27746,"_18854":104972,"_25963":104973,"_2424":48032},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#enrollment-device-registration",{"_2886":61716,"_27469":61709,"_5":27746,"_18854":104975,"_25963":104976,"_2424":48036},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#enrollment-settings",{"_2886":61717,"_27469":61709,"_5":27746,"_18854":104978,"_25963":104979,"_2424":104980},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#perfil-de-emisión","Perfil de emisión",{"_2886":61718,"_27469":61709,"_5":27746,"_18854":104982,"_25963":104983,"_2424":102717},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#configuración-de-re-enrollment",{"_2886":61719,"_27469":61709,"_5":27746,"_18854":104985,"_25963":104986,"_2424":104987},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_2886":61720,"_27469":61709,"_5":27746,"_18854":104989,"_25963":104990,"_2424":102733},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#verificar-la-configuración",{"_2886":61721,"_27469":61709,"_5":27746,"_18854":104992,"_25963":104993,"_2424":102737},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#integración-de-dispositivos",{"_2886":61722,"_27469":61709,"_5":27746,"_18854":104995,"_25963":104996,"_2424":100107},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#antes-de-empezar",{"_2886":61723,"_27469":61709,"_5":27746,"_18854":104998,"_25963":104999,"_2424":105000},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#resumen-del-flujo","Resumen del flujo",{"_2886":61724,"_27469":61709,"_5":27746,"_18854":105002,"_25963":105003,"_2424":105004},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_2886":61725,"_27469":61709,"_5":27746,"_18854":105006,"_25963":105007,"_2424":105008},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#referencia-de-endpoints","Referencia de endpoints",{"_2886":61726,"_27469":61709,"_5":27746,"_18854":105010,"_25963":105011,"_2424":48072},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#cacerts",{"_2886":61727,"_27469":61709,"_5":27746,"_18854":105013,"_25963":105014,"_2424":48076},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#simpleenroll",{"_2886":61728,"_27469":61709,"_5":27746,"_18854":105016,"_25963":105017,"_2424":48080},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#simplereenroll",{"_2886":61729,"_27469":61709,"_5":27746,"_18854":105019,"_25963":105020,"_2424":48084},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#serverkeygen",{"_2886":61730,"_27469":61709,"_5":27746,"_18854":105022,"_25963":105023,"_2424":105024},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#flujos-completos","Flujos completos",{"_2886":61731,"_27469":61709,"_5":27746,"_18854":105026,"_25963":105027,"_2424":105028},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_2886":61732,"_27469":61709,"_5":27746,"_18854":105030,"_25963":105031,"_2424":105032},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_2886":61733,"_27469":61709,"_5":27746,"_18854":105034,"_25963":105035,"_2424":102790},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento",{"_2886":61734,"_27469":61709,"_5":27746,"_18854":105037,"_25963":105038,"_2424":102794},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#diagnóstico-y-compatibilidad",{"_2886":61735,"_27469":61709,"_5":27746,"_18854":105040,"_25963":105041,"_2424":102798},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico",{"_2886":61736,"_27469":61709,"_5":27746,"_18854":105043,"_25963":105044,"_2424":102802},[],"/docs/pr-preview/pr-24/es/platform/pki/est-enrollment#notas-de-compatibilidad",{"_2886":61737,"_27469":61709,"_18854":105046,"_5":12679,"_25963":104960,"_2424":105047},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como uno de sus mecanismos de inscripción de certificados para dispositivos — el otro es CMP (RFC 9483). Cada DMS expone uno de los dos protocolos, nunca ambos a la vez; el que expone EST valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_2886":61738,"_27469":61709,"_18854":105049,"_5":12679,"_25963":104960,"_2424":105050},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_2886":61739,"_27469":61709,"_18854":105052,"_5":12679,"_25963":104960,"_2424":102865},[],{"_2886":61740,"_27469":61709,"_18854":105054,"_5":12679,"_25963":104960,"_2424":105055},[],"Configuración del DMS, para el administrador PKI.",{"_2886":61741,"_27469":61709,"_18854":105057,"_5":12679,"_25963":104960,"_2424":105058},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_2886":61742,"_27469":61709,"_18854":105060,"_5":12679,"_25963":104960,"_2424":105061},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_2886":61743,"_27469":61709,"_18854":105063,"_5":12679,"_25963":104960,"_2424":105064},[],"**Administrador PKI:** empiece por Configuración del DMS y termine con Diagnóstico y compatibilidad.",{"_2886":61744,"_27469":61709,"_18854":105066,"_5":12679,"_25963":104960,"_2424":105067},[],"**Integrador de dispositivos:** empiece por Antes de empezar y continúe con `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo que vaya a implementar.",{"_2886":61745,"_27469":61709,"_18854":105069,"_5":12679,"_25963":104966,"_2424":105070},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_2886":61746,"_27469":61709,"_18854":105072,"_5":12679,"_25963":104966,"_2424":105073},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_2886":61747,"_27469":61709,"_18854":105075,"_5":12679,"_25963":104966,"_2424":105076},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_2886":61748,"_27469":61709,"_18854":105078,"_5":12679,"_25963":104966,"_2424":105079},[],"Conviene separar cuatro bloques de configuración:",{"_2886":61749,"_27469":61709,"_18854":105081,"_5":12679,"_25963":104966,"_2424":105082},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_2886":61750,"_27469":61709,"_18854":105084,"_5":12679,"_25963":104966,"_2424":105085},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_2886":61751,"_27469":61709,"_18854":105087,"_5":12679,"_25963":104966,"_2424":105088},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_2886":61752,"_27469":61709,"_18854":105090,"_5":12679,"_25963":104966,"_2424":105091},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_2886":61753,"_27469":61709,"_18854":105093,"_5":12679,"_25963":104973,"_2424":105094},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_2886":61754,"_27469":61709,"_18854":105096,"_5":12679,"_25963":104973,"_2424":105097},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_2886":61755,"_27469":61709,"_18854":105099,"_5":12679,"_25963":104973,"_2424":105100},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_2886":61756,"_27469":61709,"_18854":105102,"_5":12679,"_25963":104973,"_2424":105103},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_2886":61757,"_27469":61709,"_18854":105105,"_5":12679,"_25963":104976,"_2424":105106},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_2886":61758,"_27469":61709,"_18854":105108,"_5":12679,"_25963":104976,"_2424":105109},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_2886":61759,"_27469":61709,"_18854":105111,"_5":12679,"_25963":104976,"_2424":105112},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_2886":61760,"_27469":61709,"_18854":105114,"_5":12679,"_25963":104976,"_2424":105115},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Puede exigir un certificado mTLS (`CLIENT_CERTIFICATE`), delegar la autorización en un webhook (`EXTERNAL_WEBHOOK`), combinar ambos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) o aceptar solicitudes sin autenticación (`NO_AUTH`). Este último modo debe limitarse a laboratorios o redes de aprovisionamiento aisladas.",{"_2886":61761,"_27469":61709,"_18854":105117,"_5":12679,"_25963":104976,"_2424":105118},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_2886":61762,"_27469":61709,"_18854":105120,"_5":12679,"_25963":104976,"_2424":105121},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_2886":61763,"_27469":61709,"_18854":105123,"_5":12679,"_25963":104976,"_2424":105124},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_2886":61764,"_27469":61709,"_18854":105126,"_5":12679,"_25963":104976,"_2424":105127},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_2886":61765,"_27469":61709,"_18854":105129,"_5":12679,"_25963":104976,"_2424":105130},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_2886":61766,"_27469":61709,"_18854":105132,"_5":12679,"_25963":104976,"_2424":105133},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_2886":61767,"_27469":61709,"_18854":105135,"_5":12679,"_25963":104976,"_2424":105136},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_2886":61768,"_27469":61709,"_18854":105138,"_5":12679,"_25963":104976,"_2424":105139},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_2886":61769,"_27469":61709,"_18854":105141,"_5":12679,"_25963":104976,"_2424":105142},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_2886":61770,"_27469":61709,"_18854":105144,"_5":12679,"_25963":104976,"_2424":105145},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_2886":61771,"_27469":61709,"_18854":105147,"_5":12679,"_25963":104979,"_2424":105148},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_2886":61772,"_27469":61709,"_18854":105150,"_5":12679,"_25963":104979,"_2424":105151},[],"**`HonorSubject`** controla si el subject del CSR se traslada literalmente al certificado. Si está desactivado, la CA aplica la plantilla del perfil e ignora el subject recibido.",{"_2886":61773,"_27469":61709,"_18854":105153,"_5":12679,"_25963":104979,"_2424":105154},[],"**`HonorKeyUsage`** decide si se respeta el `KeyUsage` del CSR o se sustituye por el definido en la plantilla.",{"_2886":61774,"_27469":61709,"_18854":105156,"_5":12679,"_25963":104979,"_2424":105157},[],"**`HonorExtendedKeyUsages`** aplica la misma regla a `ExtKeyUsage`.",{"_2886":61775,"_27469":61709,"_18854":105159,"_5":12679,"_25963":104979,"_2424":105160},[],"**`HonorExtensions`** controla si el resto de extensiones del CSR, como SAN o CDP, se incluyen en el certificado.",{"_2886":61776,"_27469":61709,"_18854":105162,"_5":12679,"_25963":104979,"_2424":105163},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_2886":61777,"_27469":61709,"_18854":105165,"_5":12679,"_25963":104983,"_2424":105166},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_2886":61778,"_27469":61709,"_18854":105168,"_5":12679,"_25963":104983,"_2424":105169},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_2886":61779,"_27469":61709,"_18854":105171,"_5":12679,"_25963":104983,"_2424":105172},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_2886":61780,"_27469":61709,"_18854":105174,"_5":12679,"_25963":104983,"_2424":105175},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_2886":61781,"_27469":61709,"_18854":105177,"_5":12679,"_25963":104983,"_2424":105178},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_2886":61782,"_27469":61709,"_18854":105180,"_5":12679,"_25963":104983,"_2424":105181},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_2886":61783,"_27469":61709,"_18854":105183,"_5":12679,"_25963":104983,"_2424":105184},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_2886":61784,"_27469":61709,"_18854":105186,"_5":12679,"_25963":104986,"_2424":105187},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_2886":61785,"_27469":61709,"_18854":105189,"_5":12679,"_25963":104986,"_2424":105190},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_2886":61786,"_27469":61709,"_18854":105192,"_5":12679,"_25963":104986,"_2424":105193},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_2886":61787,"_27469":61709,"_18854":105195,"_5":12679,"_25963":104986,"_2424":105196},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_2886":61788,"_27469":61709,"_18854":105198,"_5":12679,"_25963":104990,"_2424":105199},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_2886":61789,"_27469":61709,"_18854":105201,"_5":12679,"_25963":104990,"_2424":105202},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_2886":61790,"_27469":61709,"_18854":105204,"_5":12679,"_25963":104990,"_2424":105205},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_2886":61791,"_27469":61709,"_18854":105207,"_5":12679,"_25963":104990,"_2424":105208},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_2886":61792,"_27469":61709,"_18854":105210,"_5":12679,"_25963":104993,"_2424":103587},[],{"_2886":61793,"_27469":61709,"_18854":105212,"_5":12679,"_25963":104993,"_2424":105213},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_2886":61794,"_27469":61709,"_18854":105215,"_5":12679,"_25963":104993,"_2424":105216},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_2886":61795,"_27469":61709,"_18854":105218,"_5":12679,"_25963":104996,"_2424":105219},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_2886":61796,"_27469":61709,"_18854":105221,"_5":12679,"_25963":104996,"_2424":103593},[],{"_2886":61797,"_27469":61709,"_18854":105223,"_5":12679,"_25963":104996,"_2424":105224},[],"**La URL del host EST**, por ejemplo `https://est.lamassu.example`, proporcionada por el administrador PKI.",{"_2886":61798,"_27469":61709,"_18854":105226,"_5":12679,"_25963":104996,"_2424":105227},[],"**El ancla de confianza del servidor** (`lamassu-trust.pem`), raíz o intermedia, con la que el cliente validará el TLS de Lamassu.",{"_2886":61799,"_27469":61709,"_18854":105229,"_5":12679,"_25963":104996,"_2424":105230},[],"**El certificado bootstrap y su clave privada** si el DMS usa `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Esta identidad debe proceder de una de las `ValidationCAs` configuradas, normalmente una CA de aprovisionamiento distinta de la CA de enrolamiento.",{"_2886":61800,"_27469":61709,"_18854":105232,"_5":12679,"_25963":104996,"_2424":105233},[],"**El ID del DMS** (`{aps}`), que debe aparecer en todas las rutas EST.",{"_2886":61801,"_27469":61709,"_18854":105235,"_5":12679,"_25963":104999,"_2424":105236},[],"**Descargue la confianza con `/cacerts`:** el cliente valida el TLS del servidor y recibe los certificados en PKCS#7 o PEM.",{"_2886":61802,"_27469":61709,"_18854":105238,"_5":12679,"_25963":104999,"_2424":105239},[],"**Realice el alta inicial con `/simpleenroll`:** presente el certificado bootstrap o la credencial definida por `AuthMode` para obtener el certificado del dispositivo.",{"_2886":61803,"_27469":61709,"_18854":105241,"_5":12679,"_25963":104999,"_2424":105242},[],"**Renueve con `/simplereenroll`:** autentíquese con el certificado actual del dispositivo para obtener uno nuevo.",{"_2886":61804,"_27469":61709,"_18854":105244,"_5":12679,"_25963":104999,"_2424":105245},[],"**Use `/serverkeygen` solo si necesita generación de claves en servidor:** aplica la misma autenticación que `/simpleenroll` y devuelve la clave privada PKCS#8 junto con el certificado.",{"_2886":61805,"_27469":61709,"_18854":105247,"_5":12679,"_25963":105003,"_2424":105248},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_2886":61806,"_27469":61709,"_18854":105250,"_5":12679,"_25963":105003,"_2424":105251},[],"Modo (`AuthMode`)",{"_2886":61807,"_27469":61709,"_18854":105253,"_5":12679,"_25963":105003,"_2424":102947},[],{"_2886":61808,"_27469":61709,"_18854":105255,"_5":12679,"_25963":105003,"_2424":105256},[],"Credencial esperada",{"_2886":61809,"_27469":61709,"_18854":105258,"_5":12679,"_25963":105003,"_2424":105259},[],"Aplica en enroll",{"_2886":61810,"_27469":61709,"_18854":105261,"_5":12679,"_25963":105003,"_2424":105262},[],"Aplica en reenroll",{"_2886":61811,"_27469":61709,"_18854":105264,"_5":12679,"_25963":105003,"_2424":45948},[],{"_2886":61812,"_27469":61709,"_18854":105266,"_5":12679,"_25963":105003,"_2424":105267},[],"mTLS con certificado X.509",{"_2886":61813,"_27469":61709,"_18854":105269,"_5":12679,"_25963":105003,"_2424":105270},[],"Certificado y clave privada cliente",{"_2886":61814,"_27469":61709,"_18854":105272,"_5":12679,"_25963":105003,"_2424":103742},[],{"_2886":61815,"_27469":61709,"_18854":105274,"_5":12679,"_25963":105003,"_2424":105275},[],"Sí (con el certificado en vigor)",{"_2886":61816,"_27469":61709,"_18854":105277,"_5":12679,"_25963":105003,"_2424":45954},[],{"_2886":61817,"_27469":61709,"_18854":105279,"_5":12679,"_25963":105003,"_2424":105280},[],"mTLS más validación por webhook",{"_2886":61818,"_27469":61709,"_18854":105282,"_5":12679,"_25963":105003,"_2424":105283},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_2886":61819,"_27469":61709,"_18854":105285,"_5":12679,"_25963":105003,"_2424":103742},[],{"_2886":61820,"_27469":61709,"_18854":105287,"_5":12679,"_25963":105003,"_2424":105288},[],"No como combinación; en reenroll no mantiene ambos controles",{"_2886":61821,"_27469":61709,"_18854":105290,"_5":12679,"_25963":105003,"_2424":45960},[],{"_2886":61822,"_27469":61709,"_18854":105292,"_5":12679,"_25963":105003,"_2424":105293},[],"Webhook externo de autorización",{"_2886":61823,"_27469":61709,"_18854":105295,"_5":12679,"_25963":105003,"_2424":105296},[],"Ninguna en el canal TLS",{"_2886":61824,"_27469":61709,"_18854":105298,"_5":12679,"_25963":105003,"_2424":103742},[],{"_2886":61825,"_27469":61709,"_18854":105300,"_5":12679,"_25963":105003,"_2424":105301},[],"No, degrada a `NO_AUTH`",{"_2886":61826,"_27469":61709,"_18854":105303,"_5":12679,"_25963":105003,"_2424":45966},[],{"_2886":61827,"_27469":61709,"_18854":105305,"_5":12679,"_25963":105003,"_2424":105306},[],"Sin autenticación",{"_2886":61828,"_27469":61709,"_18854":105308,"_5":12679,"_25963":105003,"_2424":105309},[],"Ninguna",{"_2886":61829,"_27469":61709,"_18854":105311,"_5":12679,"_25963":105003,"_2424":105312},[],"Sí (uso restringido)",{"_2886":61830,"_27469":61709,"_18854":105314,"_5":12679,"_25963":105003,"_2424":105312},[],{"_2886":61831,"_27469":61709,"_18854":105316,"_5":12679,"_25963":105003,"_2424":105317},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_2886":61832,"_27469":61709,"_18854":105319,"_5":12679,"_25963":105003,"_2424":105320},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_2886":61833,"_27469":61709,"_18854":105322,"_5":12679,"_25963":105003,"_2424":105323},[],"Sus parámetros principales son `ValidationCAs`, la lista de CAs que pueden validar el certificado bootstrap o el certificado en vigor; `AllowExpired`, que permite aceptar certificados cliente caducados; y `ChainLevelValidation`, que limita la profundidad de la cadena cuando su valor es mayor que cero.",{"_2886":61834,"_27469":61709,"_18854":105325,"_5":12679,"_25963":105003,"_2424":105326},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_2886":61835,"_27469":61709,"_18854":105328,"_5":12679,"_25963":105003,"_2424":105329},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_2886":61836,"_27469":61709,"_18854":105331,"_5":12679,"_25963":105003,"_2424":105332},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll`. El cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_2886":61837,"_27469":61709,"_18854":105334,"_5":12679,"_25963":105003,"_2424":105335},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_2886":61838,"_27469":61709,"_18854":105337,"_5":12679,"_25963":105007,"_2424":105338},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_2886":61839,"_27469":61709,"_18854":105340,"_5":12679,"_25963":105007,"_2424":105341},[],"`/cacerts`: descarga de la cadena de confianza.",{"_2886":61840,"_27469":61709,"_18854":105343,"_5":12679,"_25963":105007,"_2424":105344},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_2886":61841,"_27469":61709,"_18854":105346,"_5":12679,"_25963":105007,"_2424":105347},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_2886":61842,"_27469":61709,"_18854":105349,"_5":12679,"_25963":105007,"_2424":105350},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_2886":61843,"_27469":61709,"_18854":105352,"_5":12679,"_25963":105011,"_2424":105353},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_2886":61844,"_27469":61709,"_18854":105355,"_5":12679,"_25963":105011,"_2424":105356},[],"`CADistributionSettings` permite decidir qué se publica:",{"_2886":61845,"_27469":61709,"_18854":105358,"_5":12679,"_25963":105011,"_2424":105359},[],"**`IncludeLamassuSystemCA`** añade el certificado *downstream* del servidor Lamassu. Es la hoja TLS que el cliente puede usar para anclar la conexión, no una CA.",{"_2886":61846,"_27469":61709,"_18854":105361,"_5":12679,"_25963":105011,"_2424":105362},[],"**`IncludeEnrollmentCA`** añade la CA emisora del DMS, responsable de firmar los certificados de dispositivo.",{"_2886":61847,"_27469":61709,"_18854":105364,"_5":12679,"_25963":105011,"_2424":105365},[],"**`ManagedCAs`** publica CAs adicionales como anclas de confianza.",{"_2886":61848,"_27469":61709,"_18854":105367,"_5":12679,"_25963":105011,"_2424":105368},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_2886":61849,"_27469":61709,"_18854":105370,"_5":12679,"_25963":105011,"_2424":105371},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_2886":61850,"_27469":61709,"_18854":105373,"_5":12679,"_25963":105011,"_2424":105374},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_2886":61851,"_27469":61709,"_18854":105376,"_5":12679,"_25963":105011,"_2424":105377},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_2886":61852,"_27469":61709,"_18854":105379,"_5":12679,"_25963":105014,"_2424":105380},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_2886":61853,"_27469":61709,"_18854":105382,"_5":12679,"_25963":105014,"_2424":105383},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_2886":61854,"_27469":61709,"_18854":105385,"_5":12679,"_25963":105014,"_2424":105386},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos:",{"_2886":61855,"_27469":61709,"_18854":105388,"_5":12679,"_25963":105014,"_2424":105389},[],"**`EnrollmentSettings.RegistrationMode`** decide si el dispositivo se crea durante la primera inscripción (`JITP`) o debe existir previamente (`PRE_REGISTRATION`).",{"_2886":61856,"_27469":61709,"_18854":105391,"_5":12679,"_25963":105014,"_2424":105392},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** permite repetir `/simpleenroll` para un dispositivo ya enrolado. Al hacerlo, revoca el certificado anterior como `superseded`; si está desactivado, el servidor responde con `forbiddenNewEnrollment`.",{"_2886":61857,"_27469":61709,"_18854":105394,"_5":12679,"_25963":105014,"_2424":105395},[],"**`EnrollmentSettings.VerifyCSRSignature`** valida que quien envía el CSR controla la clave privada declarada. Para flotas IoT en redes abiertas debe estar activo.",{"_2886":61858,"_27469":61709,"_18854":105397,"_5":12679,"_25963":105014,"_2424":105398},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_2886":61859,"_27469":61709,"_18854":105400,"_5":12679,"_25963":105017,"_2424":105401},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_2886":61860,"_27469":61709,"_18854":105403,"_5":12679,"_25963":105017,"_2424":105404},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_2886":61861,"_27469":61709,"_18854":105406,"_5":12679,"_25963":105017,"_2424":105407},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_2886":61862,"_27469":61709,"_18854":105409,"_5":12679,"_25963":105017,"_2424":105410},[],"**`ReEnrollmentDelta`** abre la ventana de renovación en `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_2886":61863,"_27469":61709,"_18854":105412,"_5":12679,"_25963":105017,"_2424":105413},[],"**`EnableExpiredRenewal`** permite usar un certificado ya caducado como prueba de identidad; si está desactivado, el servidor responde con `expired certificate`.",{"_2886":61864,"_27469":61709,"_18854":105415,"_5":12679,"_25963":105017,"_2424":105416},[],"**`RevokeOnReEnrollment`** revoca el certificado anterior como `superseded` después de emitir el nuevo.",{"_2886":61865,"_27469":61709,"_18854":105418,"_5":12679,"_25963":105017,"_2424":105419},[],"**`AdditionalValidationCAs`** añade emisores válidos para el certificado actual, además de la CA de enrolamiento del DMS.",{"_2886":61866,"_27469":61709,"_18854":105421,"_5":12679,"_25963":105017,"_2424":105422},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_2886":61867,"_27469":61709,"_18854":105424,"_5":12679,"_25963":105017,"_2424":105425},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_2886":61868,"_27469":61709,"_18854":105427,"_5":12679,"_25963":105020,"_2424":105428},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_2886":61869,"_27469":61709,"_18854":105430,"_5":12679,"_25963":105020,"_2424":105431},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_2886":61870,"_27469":61709,"_18854":105433,"_5":12679,"_25963":105020,"_2424":105434},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_2886":61871,"_27469":61709,"_18854":105436,"_5":12679,"_25963":105020,"_2424":105437},[],"**RSA** admite cualquier tamaño aceptado por `crypto/rsa`; los valores habituales son 2048, 3072 y 4096 bits. Un valor no válido hace fallar la generación con un error `500`.",{"_2886":61872,"_27469":61709,"_18854":105439,"_5":12679,"_25963":105020,"_2424":105440},[],"**ECDSA** admite 224, 256, 384 y 521 bits, equivalentes a P-224, P-256 (`prime256v1`), P-384 y P-521. Cualquier otro valor degrada **silenciosamente** a P-256 y solo deja un aviso en el log: el cliente no recibe un error y puede obtener una curva distinta de la esperada.",{"_2886":61873,"_27469":61709,"_18854":105442,"_5":12679,"_25963":105020,"_2424":105443},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_2886":61874,"_27469":61709,"_18854":105445,"_5":12679,"_25963":105020,"_2424":105446},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_2886":61875,"_27469":61709,"_18854":105448,"_5":12679,"_25963":105020,"_2424":105449},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_2886":61876,"_27469":61709,"_18854":105451,"_5":12679,"_25963":105020,"_2424":105452},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_2886":61877,"_27469":61709,"_18854":105454,"_5":12679,"_25963":105020,"_2424":105455},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_2886":61878,"_27469":61709,"_18854":105457,"_5":12679,"_25963":105020,"_2424":105458},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_2886":61879,"_27469":61709,"_18854":105460,"_5":12679,"_25963":105020,"_2424":105461},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_2886":61880,"_27469":61709,"_18854":105463,"_5":12679,"_25963":105023,"_2424":105464},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_2886":61881,"_27469":61709,"_18854":105466,"_5":12679,"_25963":105027,"_2424":105467},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_2886":61882,"_27469":61709,"_18854":105469,"_5":12679,"_25963":105031,"_2424":105470},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_2886":61883,"_27469":61709,"_18854":105472,"_5":12679,"_25963":105035,"_2424":105473},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_2886":61884,"_27469":61709,"_18854":105475,"_5":12679,"_25963":105035,"_2424":105476},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_2886":61885,"_27469":61709,"_18854":105478,"_5":12679,"_25963":105035,"_2424":105479},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_2886":61886,"_27469":61709,"_18854":105481,"_5":12679,"_25963":105035,"_2424":105482},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_2886":61887,"_27469":61709,"_18854":105484,"_5":12679,"_25963":105041,"_2424":105485},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_2886":61888,"_27469":61709,"_18854":105487,"_5":12679,"_25963":105041,"_2424":46917},[],{"_2886":61889,"_27469":61709,"_18854":105489,"_5":12679,"_25963":105041,"_2424":103664},[],{"_2886":61890,"_27469":61709,"_18854":105491,"_5":12679,"_25963":105041,"_2424":105492},[],"Causa",{"_2886":61891,"_27469":61709,"_18854":105494,"_5":12679,"_25963":105041,"_2424":103880},[],{"_2886":61892,"_27469":61709,"_18854":105496,"_5":12679,"_25963":105041,"_2424":26614},[],{"_2886":61893,"_27469":61709,"_18854":105498,"_5":12679,"_25963":105041,"_2424":48565},[],{"_2886":61894,"_27469":61709,"_18854":105500,"_5":12679,"_25963":105041,"_2424":105501},[],"El segmento `{aps}` falta en la URL.",{"_2886":61895,"_27469":61709,"_18854":105503,"_5":12679,"_25963":105041,"_2424":105504},[],"Incluir el ID del DMS en la ruta.",{"_2886":61896,"_27469":61709,"_18854":105506,"_5":12679,"_25963":105041,"_2424":26614},[],{"_2886":61897,"_27469":61709,"_18854":105508,"_5":12679,"_25963":105041,"_2424":48576},[],{"_2886":61898,"_27469":61709,"_18854":105510,"_5":12679,"_25963":105041,"_2424":105511},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_2886":61899,"_27469":61709,"_18854":105513,"_5":12679,"_25963":105041,"_2424":105514},[],"Fijar `Content-Type: application/pkcs10`.",{"_2886":61900,"_27469":61709,"_18854":105516,"_5":12679,"_25963":105041,"_2424":26614},[],{"_2886":61901,"_27469":61709,"_18854":105518,"_5":12679,"_25963":105041,"_2424":48587},[],{"_2886":61902,"_27469":61709,"_18854":105520,"_5":12679,"_25963":105041,"_2424":105521},[],"El cuerpo no es base64 válido.",{"_2886":61903,"_27469":61709,"_18854":105523,"_5":12679,"_25963":105041,"_2424":105524},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_2886":61904,"_27469":61709,"_18854":105526,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61905,"_27469":61709,"_18854":105528,"_5":12679,"_25963":105041,"_2424":48598},[],{"_2886":61906,"_27469":61709,"_18854":105530,"_5":12679,"_25963":105041,"_2424":105531},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_2886":61907,"_27469":61709,"_18854":105533,"_5":12679,"_25963":105041,"_2424":105534},[],"Verificar el identificador con el administrador PKI.",{"_2886":61908,"_27469":61709,"_18854":105536,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61909,"_27469":61709,"_18854":105538,"_5":12679,"_25963":105041,"_2424":48609},[],{"_2886":61910,"_27469":61709,"_18854":105540,"_5":12679,"_25963":105041,"_2424":105541},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_2886":61911,"_27469":61709,"_18854":105543,"_5":12679,"_25963":105041,"_2424":105544},[],"Comprobar la cadena del certificado bootstrap.",{"_2886":61912,"_27469":61709,"_18854":105546,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61913,"_27469":61709,"_18854":105548,"_5":12679,"_25963":105041,"_2424":48620},[],{"_2886":61914,"_27469":61709,"_18854":105550,"_5":12679,"_25963":105041,"_2424":105551},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_2886":61915,"_27469":61709,"_18854":105553,"_5":12679,"_25963":105041,"_2424":105554},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_2886":61916,"_27469":61709,"_18854":105556,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61917,"_27469":61709,"_18854":105558,"_5":12679,"_25963":105041,"_2424":48631},[],{"_2886":61918,"_27469":61709,"_18854":105560,"_5":12679,"_25963":105041,"_2424":105561},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_2886":61919,"_27469":61709,"_18854":105563,"_5":12679,"_25963":105041,"_2424":105564},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_2886":61920,"_27469":61709,"_18854":105566,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61921,"_27469":61709,"_18854":105568,"_5":12679,"_25963":105041,"_2424":48642},[],{"_2886":61922,"_27469":61709,"_18854":105570,"_5":12679,"_25963":105041,"_2424":105571},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_2886":61923,"_27469":61709,"_18854":105573,"_5":12679,"_25963":105041,"_2424":105574},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_2886":61924,"_27469":61709,"_18854":105576,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61925,"_27469":61709,"_18854":105578,"_5":12679,"_25963":105041,"_2424":48653},[],{"_2886":61926,"_27469":61709,"_18854":105580,"_5":12679,"_25963":105041,"_2424":105581},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_2886":61927,"_27469":61709,"_18854":105583,"_5":12679,"_25963":105041,"_2424":105584},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_2886":61928,"_27469":61709,"_18854":105586,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61929,"_27469":61709,"_18854":105588,"_5":12679,"_25963":105041,"_2424":48664},[],{"_2886":61930,"_27469":61709,"_18854":105590,"_5":12679,"_25963":105041,"_2424":105591},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_2886":61931,"_27469":61709,"_18854":105593,"_5":12679,"_25963":105041,"_2424":105594},[],"Registrar el dispositivo antes de inscribirlo.",{"_2886":61932,"_27469":61709,"_18854":105596,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61933,"_27469":61709,"_18854":105598,"_5":12679,"_25963":105041,"_2424":48675},[],{"_2886":61934,"_27469":61709,"_18854":105600,"_5":12679,"_25963":105041,"_2424":105601},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_2886":61935,"_27469":61709,"_18854":105603,"_5":12679,"_25963":105041,"_2424":105604},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_2886":61936,"_27469":61709,"_18854":105606,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61937,"_27469":61709,"_18854":105608,"_5":12679,"_25963":105041,"_2424":48686},[],{"_2886":61938,"_27469":61709,"_18854":105610,"_5":12679,"_25963":105041,"_2424":105611},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_2886":61939,"_27469":61709,"_18854":105613,"_5":12679,"_25963":105041,"_2424":105614},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_2886":61940,"_27469":61709,"_18854":105616,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61941,"_27469":61709,"_18854":105618,"_5":12679,"_25963":105041,"_2424":48697},[],{"_2886":61942,"_27469":61709,"_18854":105620,"_5":12679,"_25963":105041,"_2424":105621},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_2886":61943,"_27469":61709,"_18854":105623,"_5":12679,"_25963":105041,"_2424":105624},[],"Revisar los logs del servicio webhook.",{"_2886":61944,"_27469":61709,"_18854":105626,"_5":12679,"_25963":105041,"_2424":26517},[],{"_2886":61945,"_27469":61709,"_18854":105628,"_5":12679,"_25963":105041,"_2424":48708},[],{"_2886":61946,"_27469":61709,"_18854":105630,"_5":12679,"_25963":105041,"_2424":105631},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_2886":61947,"_27469":61709,"_18854":105633,"_5":12679,"_25963":105041,"_2424":105634},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_2886":61948,"_27469":61709,"_18854":105636,"_5":12679,"_25963":105041,"_2424":105637},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_2886":61949,"_27469":61709,"_18854":105639,"_5":12679,"_25963":105044,"_2424":105640},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_2886":61950,"_27469":61709,"_18854":105642,"_5":12679,"_25963":105044,"_2424":105643},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_2886":61951,"_27469":61709,"_18854":105645,"_5":12679,"_25963":105044,"_2424":105646},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_2886":61952,"_27469":61709,"_18854":105648,"_5":12679,"_25963":105044,"_2424":105649},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_2886":61953,"_27469":61709,"_18854":105651,"_5":12679,"_25963":105044,"_2424":105652},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_2886":61954,"_27469":61709,"_18854":105654,"_5":12679,"_25963":105044,"_2424":105655},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_2886":61955,"_27469":61709,"_18854":105657,"_5":12679,"_25963":105044,"_2424":105658},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_2886":61956,"_27469":61709,"_18854":105660,"_5":12679,"_25963":105044,"_2424":104081},[],{"_2886":61957,"_27469":61709,"_18854":105662,"_5":12679,"_25963":105044,"_2424":105663},[],"<Card title=\"Enrolamiento CMP\" href=\"/docs/platform/pki/cmp\" />",{"_2886":61958,"_27469":61709,"_18854":105665,"_5":12679,"_25963":105044,"_2424":105666},[],"<Card title=\"Validación OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2886":61959,"_27469":61709,"_18854":105668,"_5":12679,"_25963":105044,"_2424":104086},[],{"_2886":61960,"_27469":61960,"_5":13057,"_2424":48750,"_27749":105670,"_18854":105672,"_25963":61960},[43001,101196,105671],"Integraciones",[],{"_2886":61961,"_27469":61960,"_18854":105674,"_5":12679,"_25963":61960,"_2424":105675},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2886":61962,"_27469":61960,"_5":27746,"_18854":105677,"_25963":105678,"_2424":105679},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2886":61963,"_27469":61960,"_5":27746,"_18854":105681,"_25963":105682,"_2424":105683},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2886":61964,"_27469":61960,"_5":27746,"_18854":105685,"_25963":105686,"_2424":105687},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2886":61965,"_27469":61960,"_5":27746,"_18854":105689,"_25963":105690,"_2424":105691},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2886":61966,"_27469":61960,"_5":27746,"_18854":105693,"_25963":105694,"_2424":105695},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2886":61967,"_27469":61960,"_5":27746,"_18854":105697,"_25963":105698,"_2424":105699},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2886":61968,"_27469":61960,"_5":27746,"_18854":105701,"_25963":105702,"_2424":48783},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#primary-account",{"_2886":61969,"_27469":61960,"_5":27746,"_18854":105704,"_25963":105705,"_2424":48787},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#secondary-account-sni-only",{"_2886":61970,"_27469":61960,"_5":27746,"_18854":105707,"_25963":105708,"_2424":102656},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#configuración-del-dms",{"_2886":61971,"_27469":61960,"_5":27746,"_18854":105710,"_25963":105711,"_2424":105712},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#modo-none","Modo `none`",{"_2886":61972,"_27469":61960,"_5":27746,"_18854":105714,"_25963":105715,"_2424":105716},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2886":61973,"_27469":61960,"_5":27746,"_18854":105718,"_25963":105719,"_2424":105720},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2886":61974,"_27469":61960,"_5":27746,"_18854":105722,"_25963":105723,"_2424":105724},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2886":61975,"_27469":61960,"_5":27746,"_18854":105726,"_25963":105727,"_2424":105728},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2886":61976,"_27469":61960,"_5":27746,"_18854":105730,"_25963":105731,"_2424":105732},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2886":61977,"_27469":61960,"_5":27746,"_18854":105734,"_25963":105735,"_2424":105736},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2886":61978,"_27469":61960,"_5":27746,"_18854":105738,"_25963":105739,"_2424":105740},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2886":61979,"_27469":61960,"_5":27746,"_18854":105742,"_25963":105743,"_2424":105744},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2886":61980,"_27469":61960,"_5":27746,"_18854":105746,"_25963":105747,"_2424":105748},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2886":61981,"_27469":61960,"_5":27746,"_18854":105750,"_25963":105751,"_2424":105752},[],"/docs/pr-preview/pr-24/es/platform/pki/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2886":61982,"_27469":61960,"_18854":105754,"_5":12679,"_25963":61960,"_2424":105755},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2886":61983,"_27469":61960,"_18854":105757,"_5":12679,"_25963":61960,"_2424":105758},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2886":61984,"_27469":61960,"_18854":105760,"_5":12679,"_25963":61960,"_2424":105761},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2886":61985,"_27469":61960,"_18854":105763,"_5":12679,"_25963":105678,"_2424":105764},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2886":61986,"_27469":61960,"_18854":105766,"_5":12679,"_25963":105678,"_2424":105767},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2886":61987,"_27469":61960,"_18854":105769,"_5":12679,"_25963":105678,"_2424":105770},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2886":61988,"_27469":61960,"_18854":105772,"_5":12679,"_25963":105678,"_2424":105773},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2886":61989,"_27469":61960,"_18854":105775,"_5":12679,"_25963":105682,"_2424":105776},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2886":61990,"_27469":61960,"_18854":105778,"_5":12679,"_25963":105686,"_2424":105779},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2886":61991,"_27469":61960,"_18854":105781,"_5":12679,"_25963":105686,"_2424":105782},[],"Acción IAM",{"_2886":61992,"_27469":61960,"_18854":105784,"_5":12679,"_25963":105686,"_2424":100469},[],{"_2886":61993,"_27469":61960,"_18854":105786,"_5":12679,"_25963":105686,"_2424":48869},[],{"_2886":61994,"_27469":61960,"_18854":105788,"_5":12679,"_25963":105686,"_2424":105789},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2886":61995,"_27469":61960,"_18854":105791,"_5":12679,"_25963":105686,"_2424":48875},[],{"_2886":61996,"_27469":61960,"_18854":105793,"_5":12679,"_25963":105686,"_2424":105794},[],"Registrar la CA en AWS IoT",{"_2886":61997,"_27469":61960,"_18854":105796,"_5":12679,"_25963":105686,"_2424":48881},[],{"_2886":61998,"_27469":61960,"_18854":105798,"_5":12679,"_25963":105686,"_2424":105799},[],"Consultar el estado del registro de la CA",{"_2886":61999,"_27469":61960,"_18854":105801,"_5":12679,"_25963":105686,"_2424":48887},[],{"_2886":62000,"_27469":61960,"_18854":105803,"_5":12679,"_25963":105686,"_2424":105804},[],"Crear o actualizar Things en IoT Core",{"_2886":62001,"_27469":61960,"_18854":105806,"_5":12679,"_25963":105686,"_2424":48893},[],{"_2886":62002,"_27469":61960,"_18854":105808,"_5":12679,"_25963":105686,"_2424":105809},[],"Aprovisionar Things mediante plantilla",{"_2886":62003,"_27469":61960,"_18854":105811,"_5":12679,"_25963":105686,"_2424":48899},[],{"_2886":62004,"_27469":61960,"_18854":105813,"_5":12679,"_25963":105686,"_2424":105814},[],"Registrar certificados de dispositivo",{"_2886":62005,"_27469":61960,"_18854":105816,"_5":12679,"_25963":105686,"_2424":48905},[],{"_2886":62006,"_27469":61960,"_18854":105818,"_5":12679,"_25963":105686,"_2424":105819},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2886":62007,"_27469":61960,"_18854":105821,"_5":12679,"_25963":105686,"_2424":48911},[],{"_2886":62008,"_27469":61960,"_18854":105823,"_5":12679,"_25963":105686,"_2424":105824},[],"Crear y adjuntar políticas IoT",{"_2886":62009,"_27469":61960,"_18854":105826,"_5":12679,"_25963":105686,"_2424":48917},[],{"_2886":62010,"_27469":61960,"_18854":105828,"_5":12679,"_25963":105686,"_2424":105829},[],"Gestionar grupos de Things",{"_2886":62011,"_27469":61960,"_18854":105831,"_5":12679,"_25963":105686,"_2424":48923},[],{"_2886":62012,"_27469":61960,"_18854":105833,"_5":12679,"_25963":105686,"_2424":105834},[],"Crear plantillas JITP",{"_2886":62013,"_27469":61960,"_18854":105836,"_5":12679,"_25963":105686,"_2424":48929},[],{"_2886":62014,"_27469":61960,"_18854":105838,"_5":12679,"_25963":105686,"_2424":105839},[],"Leer y escribir el Device Shadow",{"_2886":62015,"_27469":61960,"_18854":105841,"_5":12679,"_25963":105686,"_2424":105842},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2886":62016,"_27469":61960,"_18854":105844,"_5":12679,"_25963":105690,"_2424":105845},[],"Parámetro",{"_2886":62017,"_27469":61960,"_18854":105847,"_5":12679,"_25963":105690,"_2424":103017},[],{"_2886":62018,"_27469":61960,"_18854":105849,"_5":12679,"_25963":105690,"_2424":105850},[],"Requerido",{"_2886":62019,"_27469":61960,"_18854":105852,"_5":12679,"_25963":105690,"_2424":102947},[],{"_2886":62020,"_27469":61960,"_18854":105854,"_5":12679,"_25963":105690,"_2424":48948},[],{"_2886":62021,"_27469":61960,"_18854":105856,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62022,"_27469":61960,"_18854":105858,"_5":12679,"_25963":105690,"_2424":103742},[],{"_2886":62023,"_27469":61960,"_18854":105860,"_5":12679,"_25963":105690,"_2424":105861},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2886":62024,"_27469":61960,"_18854":105863,"_5":12679,"_25963":105690,"_2424":48958},[],{"_2886":62025,"_27469":61960,"_18854":105865,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62026,"_27469":61960,"_18854":105867,"_5":12679,"_25963":105690,"_2424":103742},[],{"_2886":62027,"_27469":61960,"_18854":105869,"_5":12679,"_25963":105690,"_2424":105870},[],"Región AWS donde opera el conector.",{"_2886":62028,"_27469":61960,"_18854":105872,"_5":12679,"_25963":105690,"_2424":48968},[],{"_2886":62029,"_27469":61960,"_18854":105874,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62030,"_27469":61960,"_18854":105876,"_5":12679,"_25963":105690,"_2424":103742},[],{"_2886":62031,"_27469":61960,"_18854":105878,"_5":12679,"_25963":105690,"_2424":105879},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2886":62032,"_27469":61960,"_18854":105881,"_5":12679,"_25963":105690,"_2424":48978},[],{"_2886":62033,"_27469":61960,"_18854":105883,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62034,"_27469":61960,"_18854":105885,"_5":12679,"_25963":105690,"_2424":105886},[],"Solo con `auth_method=static`",{"_2886":62035,"_27469":61960,"_18854":105888,"_5":12679,"_25963":105690,"_2424":105889},[],"Clave de acceso AWS.",{"_2886":62036,"_27469":61960,"_18854":105891,"_5":12679,"_25963":105690,"_2424":48989},[],{"_2886":62037,"_27469":61960,"_18854":105893,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62038,"_27469":61960,"_18854":105895,"_5":12679,"_25963":105690,"_2424":105886},[],{"_2886":62039,"_27469":61960,"_18854":105897,"_5":12679,"_25963":105690,"_2424":105898},[],"Clave secreta AWS.",{"_2886":62040,"_27469":61960,"_18854":105900,"_5":12679,"_25963":105690,"_2424":48999},[],{"_2886":62041,"_27469":61960,"_18854":105902,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62042,"_27469":61960,"_18854":105904,"_5":12679,"_25963":105690,"_2424":46753},[],{"_2886":62043,"_27469":61960,"_18854":105906,"_5":12679,"_25963":105690,"_2424":105907},[],"Token de sesión (con `auth_method=static`).",{"_2886":62044,"_27469":61960,"_18854":105909,"_5":12679,"_25963":105690,"_2424":49009},[],{"_2886":62045,"_27469":61960,"_18854":105911,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62046,"_27469":61960,"_18854":105913,"_5":12679,"_25963":105690,"_2424":105914},[],"Solo con `auth_method=role`",{"_2886":62047,"_27469":61960,"_18854":105916,"_5":12679,"_25963":105690,"_2424":105917},[],"ARN del rol a asumir.",{"_2886":62048,"_27469":61960,"_18854":105919,"_5":12679,"_25963":105690,"_2424":49020},[],{"_2886":62049,"_27469":61960,"_18854":105921,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62050,"_27469":61960,"_18854":105923,"_5":12679,"_25963":105690,"_2424":46753},[],{"_2886":62051,"_27469":61960,"_18854":105925,"_5":12679,"_25963":105690,"_2424":105926},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2886":62052,"_27469":61960,"_18854":105928,"_5":12679,"_25963":105690,"_2424":49030},[],{"_2886":62053,"_27469":61960,"_18854":105930,"_5":12679,"_25963":105690,"_2424":77353},[],{"_2886":62054,"_27469":61960,"_18854":105932,"_5":12679,"_25963":105690,"_2424":103742},[],{"_2886":62055,"_27469":61960,"_18854":105934,"_5":12679,"_25963":105690,"_2424":105935},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2886":62056,"_27469":61960,"_18854":105937,"_5":12679,"_25963":105690,"_2424":49040},[],{"_2886":62057,"_27469":61960,"_18854":105939,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62058,"_27469":61960,"_18854":105941,"_5":12679,"_25963":105690,"_2424":103742},[],{"_2886":62059,"_27469":61960,"_18854":105943,"_5":12679,"_25963":105690,"_2424":105944},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2886":62060,"_27469":61960,"_18854":105946,"_5":12679,"_25963":105690,"_2424":49050},[],{"_2886":62061,"_27469":61960,"_18854":105948,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62062,"_27469":61960,"_18854":105950,"_5":12679,"_25963":105690,"_2424":103742},[],{"_2886":62063,"_27469":61960,"_18854":105952,"_5":12679,"_25963":105690,"_2424":105953},[],"URL HTTP del Device Manager de Lamassu.",{"_2886":62064,"_27469":61960,"_18854":105955,"_5":12679,"_25963":105690,"_2424":49060},[],{"_2886":62065,"_27469":61960,"_18854":105957,"_5":12679,"_25963":105690,"_2424":22534},[],{"_2886":62066,"_27469":61960,"_18854":105959,"_5":12679,"_25963":105690,"_2424":103742},[],{"_2886":62067,"_27469":61960,"_18854":105961,"_5":12679,"_25963":105690,"_2424":105962},[],"URL HTTP del servicio de CA de Lamassu.",{"_2886":62068,"_27469":61960,"_18854":105964,"_5":12679,"_25963":105694,"_2424":105965},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2886":62069,"_27469":61960,"_18854":105967,"_5":12679,"_25963":105698,"_2424":105968},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2886":62070,"_27469":61960,"_18854":105970,"_5":12679,"_25963":105698,"_2424":105971},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2886":62071,"_27469":61960,"_18854":105973,"_5":12679,"_25963":105702,"_2424":105974},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2886":62072,"_27469":61960,"_18854":105976,"_5":12679,"_25963":105702,"_2424":105977},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2886":62073,"_27469":61960,"_18854":105979,"_5":12679,"_25963":105702,"_2424":105980},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2886":62074,"_27469":61960,"_18854":105982,"_5":12679,"_25963":105702,"_2424":105983},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2886":62075,"_27469":61960,"_18854":105985,"_5":12679,"_25963":105702,"_2424":105986},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2886":62076,"_27469":61960,"_18854":105988,"_5":12679,"_25963":105702,"_2424":105989},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2886":62077,"_27469":61960,"_18854":105991,"_5":12679,"_25963":105705,"_2424":105992},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2886":62078,"_27469":61960,"_18854":105994,"_5":12679,"_25963":105708,"_2424":105995},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2886":62079,"_27469":61960,"_18854":105997,"_5":12679,"_25963":105708,"_2424":105998},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2886":62080,"_27469":61960,"_18854":106000,"_5":12679,"_25963":105711,"_2424":106001},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2886":62081,"_27469":61960,"_18854":106003,"_5":12679,"_25963":105715,"_2424":106004},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2886":62082,"_27469":61960,"_18854":106006,"_5":12679,"_25963":105715,"_2424":106007},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2886":62083,"_27469":61960,"_18854":106009,"_5":12679,"_25963":105715,"_2424":106010},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2886":62084,"_27469":61960,"_18854":106012,"_5":12679,"_25963":105715,"_2424":106013},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2886":62085,"_27469":61960,"_18854":106015,"_5":12679,"_25963":105715,"_2424":106016},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2886":62086,"_27469":61960,"_18854":106018,"_5":12679,"_25963":105715,"_2424":106019},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2886":62087,"_27469":61960,"_18854":106021,"_5":12679,"_25963":105719,"_2424":106022},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2886":62088,"_27469":61960,"_18854":106024,"_5":12679,"_25963":105719,"_2424":106025},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2886":62089,"_27469":61960,"_18854":106027,"_5":12679,"_25963":105719,"_2424":106028},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2886":62090,"_27469":61960,"_18854":106030,"_5":12679,"_25963":105723,"_2424":106031},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2886":62091,"_27469":61960,"_18854":106033,"_5":12679,"_25963":105723,"_2424":106034},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2886":62092,"_27469":61960,"_18854":106036,"_5":12679,"_25963":105723,"_2424":106037},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2886":62093,"_27469":61960,"_18854":106039,"_5":12679,"_25963":105727,"_2424":106040},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2886":62094,"_27469":61960,"_18854":106042,"_5":12679,"_25963":105727,"_2424":106043},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2886":62095,"_27469":61960,"_18854":106045,"_5":12679,"_25963":105727,"_2424":106046},[],"Para que el flujo JITP funcione correctamente:",{"_2886":62096,"_27469":61960,"_18854":106048,"_5":12679,"_25963":105727,"_2424":106049},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2886":62097,"_27469":61960,"_18854":106051,"_5":12679,"_25963":105727,"_2424":106052},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2886":62098,"_27469":61960,"_18854":106054,"_5":12679,"_25963":105727,"_2424":106055},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2886":62099,"_27469":61960,"_18854":106057,"_5":12679,"_25963":105727,"_2424":106058},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2886":62100,"_27469":61960,"_18854":106060,"_5":12679,"_25963":105731,"_2424":106061},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2886":62101,"_27469":61960,"_18854":106063,"_5":12679,"_25963":105731,"_2424":106064},[],"Estado en Lamassu",{"_2886":62102,"_27469":61960,"_18854":106066,"_5":12679,"_25963":105731,"_2424":106067},[],"Razón de revocación",{"_2886":62103,"_27469":61960,"_18854":106069,"_5":12679,"_25963":105731,"_2424":106070},[],"Estado en AWS IoT Core",{"_2886":62104,"_27469":61960,"_18854":106072,"_5":12679,"_25963":105731,"_2424":49181},[],{"_2886":62105,"_27469":61960,"_18854":106074,"_5":12679,"_25963":105731,"_2424":105309},[],{"_2886":62106,"_27469":61960,"_18854":106076,"_5":12679,"_25963":105731,"_2424":49186},[],{"_2886":62107,"_27469":61960,"_18854":106078,"_5":12679,"_25963":105731,"_2424":49189},[],{"_2886":62108,"_27469":61960,"_18854":106080,"_5":12679,"_25963":105731,"_2424":49192},[],{"_2886":62109,"_27469":61960,"_18854":106082,"_5":12679,"_25963":105731,"_2424":49195},[],{"_2886":62110,"_27469":61960,"_18854":106084,"_5":12679,"_25963":105731,"_2424":49189},[],{"_2886":62111,"_27469":61960,"_18854":106086,"_5":12679,"_25963":105731,"_2424":106087},[],"Cualquier otra razón",{"_2886":62112,"_27469":61960,"_18854":106089,"_5":12679,"_25963":105731,"_2424":46567},[],{"_2886":62113,"_27469":61960,"_18854":106091,"_5":12679,"_25963":105731,"_2424":106092},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2886":62114,"_27469":61960,"_18854":106094,"_5":12679,"_25963":105735,"_2424":106095},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2886":62115,"_27469":61960,"_18854":106097,"_5":12679,"_25963":105735,"_2424":106098},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2886":62116,"_27469":61960,"_18854":106100,"_5":12679,"_25963":105735,"_2424":106101},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2886":62117,"_27469":61960,"_18854":106103,"_5":12679,"_25963":105739,"_2424":106104},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2886":62118,"_27469":61960,"_18854":106106,"_5":12679,"_25963":105739,"_2424":106107},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2886":62119,"_27469":61960,"_18854":106109,"_5":12679,"_25963":105743,"_2424":106110},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2886":62120,"_27469":61960,"_18854":106112,"_5":12679,"_25963":105743,"_2424":106113},[],"Existen dos tipos de acciones:",{"_2886":62121,"_27469":61960,"_18854":106115,"_5":12679,"_25963":105743,"_2424":106116},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2886":62122,"_27469":61960,"_18854":106118,"_5":12679,"_25963":105743,"_2424":106119},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2886":62123,"_27469":61960,"_18854":106121,"_5":12679,"_25963":105743,"_2424":106122},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2886":62124,"_27469":61960,"_18854":106124,"_5":12679,"_25963":105747,"_2424":106125},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2886":62125,"_27469":61960,"_18854":106127,"_5":12679,"_25963":105747,"_2424":106128},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2886":62126,"_27469":61960,"_18854":106130,"_5":12679,"_25963":105747,"_2424":106131},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2886":62127,"_27469":61960,"_18854":106133,"_5":12679,"_25963":105751,"_2424":106134},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2886":62128,"_27469":61960,"_18854":106136,"_5":12679,"_25963":105751,"_2424":106137},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2886":62129,"_27469":61960,"_18854":106139,"_5":12679,"_25963":105751,"_2424":106140},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2886":62130,"_27469":61960,"_18854":106142,"_5":12679,"_25963":105751,"_2424":106143},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2886":62131,"_27469":61960,"_18854":106145,"_5":12679,"_25963":105751,"_2424":106146},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2886":62132,"_27469":61960,"_18854":106148,"_5":12679,"_25963":105751,"_2424":106149},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2886":62133,"_27469":61960,"_18854":106151,"_5":12679,"_25963":105751,"_2424":106152},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2886":62134,"_27469":61960,"_18854":106154,"_5":12679,"_25963":105751,"_2424":106155},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2886":62135,"_27469":61960,"_18854":106157,"_5":12679,"_25963":105751,"_2424":106158},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2886":62136,"_27469":61960,"_18854":106160,"_5":12679,"_25963":105751,"_2424":106161},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2886":62137,"_27469":61960,"_18854":106163,"_5":12679,"_25963":105751,"_2424":106164},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2886":62138,"_27469":61960,"_18854":106166,"_5":12679,"_25963":105751,"_2424":106167},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2886":62139,"_27469":61960,"_18854":106169,"_5":12679,"_25963":105751,"_2424":106170},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2886":62140,"_27469":61960,"_18854":106172,"_5":12679,"_25963":105751,"_2424":106173},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2886":62141,"_27469":61960,"_18854":106175,"_5":12679,"_25963":105751,"_2424":106176},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2886":62142,"_27469":61960,"_18854":106178,"_5":12679,"_25963":105751,"_2424":106179},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2886":62143,"_27469":61960,"_18854":106181,"_5":12679,"_25963":105751,"_2424":106182},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2886":62144,"_27469":61960,"_18854":106184,"_5":12679,"_25963":105751,"_2424":106185},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2886":62145,"_27469":61960,"_18854":106187,"_5":12679,"_25963":105751,"_2424":106188},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2886":62146,"_27469":61960,"_18854":106190,"_5":12679,"_25963":105751,"_2424":106191},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2886":62147,"_27469":61960,"_18854":106193,"_5":12679,"_25963":105751,"_2424":106194},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2886":62148,"_27469":62148,"_5":13057,"_2424":106196,"_27749":106197,"_18854":106198,"_25963":62148},"Claves y motores criptográficos",[43001,101196,101674],[],{"_2886":62149,"_27469":62148,"_18854":106200,"_5":12679,"_25963":62148,"_2424":106201},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2886":62150,"_27469":62148,"_5":27746,"_18854":106203,"_25963":106204,"_2424":106205},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_2886":62151,"_27469":62148,"_5":27746,"_18854":106207,"_25963":106208,"_2424":106209},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2886":62152,"_27469":62148,"_5":27746,"_18854":106211,"_25963":106212,"_2424":106213},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2886":62153,"_27469":62148,"_5":27746,"_18854":106215,"_25963":106216,"_2424":49330},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#file-system",{"_2886":62154,"_27469":62148,"_5":27746,"_18854":106218,"_25963":106219,"_2424":49334},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#hashicorp-vault",{"_2886":62155,"_27469":62148,"_5":27746,"_18854":106221,"_25963":106222,"_2424":49338},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#aws-secrets-manager",{"_2886":62156,"_27469":62148,"_5":27746,"_18854":106224,"_25963":106225,"_2424":49342},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#aws-kms",{"_2886":62157,"_27469":62148,"_5":27746,"_18854":106227,"_25963":106228,"_2424":49346},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#pkcs11",{"_2886":62158,"_27469":62148,"_5":27746,"_18854":106230,"_25963":106231,"_2424":106232},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2886":62159,"_27469":62148,"_5":27746,"_18854":106234,"_25963":106235,"_2424":106236},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2886":62160,"_27469":62148,"_5":27746,"_18854":106238,"_25963":106239,"_2424":106240},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2886":62161,"_27469":62148,"_5":27746,"_18854":106242,"_25963":106243,"_2424":106244},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2886":62162,"_27469":62148,"_5":27746,"_18854":106246,"_25963":106247,"_2424":106248},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2886":62163,"_27469":62148,"_5":27746,"_18854":106250,"_25963":106251,"_2424":106252},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2886":62164,"_27469":62148,"_5":27746,"_18854":106254,"_25963":106255,"_2424":106256},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2886":62165,"_27469":62148,"_5":27746,"_18854":106258,"_25963":106259,"_2424":49378},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#sign",{"_2886":62166,"_27469":62148,"_5":27746,"_18854":106261,"_25963":106262,"_2424":49382},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#verify",{"_2886":62167,"_27469":62148,"_5":27746,"_18854":106264,"_25963":106265,"_2424":106266},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2886":62168,"_27469":62148,"_5":27746,"_18854":106268,"_25963":106269,"_2424":106270},[],"/docs/pr-preview/pr-24/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2886":62169,"_27469":62148,"_18854":106272,"_5":12679,"_25963":106204,"_2424":106273},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2886":62170,"_27469":62148,"_18854":106275,"_5":12679,"_25963":106204,"_2424":106276},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2886":62171,"_27469":62148,"_18854":106278,"_5":12679,"_25963":106208,"_2424":106279},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2886":62172,"_27469":62148,"_18854":106281,"_5":12679,"_25963":106208,"_2424":106282},[],"En la práctica, permite:",{"_2886":62173,"_27469":62148,"_18854":106284,"_5":12679,"_25963":106208,"_2424":106285},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2886":62174,"_27469":62148,"_18854":106287,"_5":12679,"_25963":106208,"_2424":106288},[],"Importar claves creadas externamente.",{"_2886":62175,"_27469":62148,"_18854":106290,"_5":12679,"_25963":106208,"_2424":106291},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2886":62176,"_27469":62148,"_18854":106293,"_5":12679,"_25963":106208,"_2424":106294},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2886":62177,"_27469":62148,"_18854":106296,"_5":12679,"_25963":106212,"_2424":106297},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2886":62178,"_27469":62148,"_18854":106299,"_5":12679,"_25963":106212,"_2424":106300},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2886":62179,"_27469":62148,"_18854":106302,"_5":12679,"_25963":106212,"_2424":106303},[],"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado.",{"_2886":62180,"_27469":62148,"_18854":106305,"_5":12679,"_25963":106216,"_2424":106306},[],"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción.",{"_2886":62181,"_27469":62148,"_18854":106308,"_5":12679,"_25963":106219,"_2424":106309},[],"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*.",{"_2886":62182,"_27469":62148,"_18854":106311,"_5":12679,"_25963":106222,"_2424":106312},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2886":62183,"_27469":62148,"_18854":106314,"_5":12679,"_25963":106225,"_2424":106315},[],"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica.",{"_2886":62184,"_27469":62148,"_18854":106317,"_5":12679,"_25963":106228,"_2424":106318},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2886":62185,"_27469":62148,"_18854":106320,"_5":12679,"_25963":106228,"_2424":106321},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_2886":62186,"_27469":62148,"_18854":106323,"_5":12679,"_25963":106228,"_2424":106324},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2886":62187,"_27469":62148,"_18854":106326,"_5":12679,"_25963":106228,"_2424":106327},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2886":62188,"_27469":62148,"_18854":106329,"_5":12679,"_25963":106231,"_2424":106330},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2886":62189,"_27469":62148,"_18854":106332,"_5":12679,"_25963":106231,"_2424":106333},[],"La tabla incluye los siguientes campos:",{"_2886":62190,"_27469":62148,"_18854":106335,"_5":12679,"_25963":106231,"_2424":106336},[],"**Name**: nombre descriptivo de la clave.",{"_2886":62191,"_27469":62148,"_18854":106338,"_5":12679,"_25963":106231,"_2424":106339},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2886":62192,"_27469":62148,"_18854":106341,"_5":12679,"_25963":106231,"_2424":106342},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2886":62193,"_27469":62148,"_18854":106344,"_5":12679,"_25963":106231,"_2424":106345},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2886":62194,"_27469":62148,"_18854":106347,"_5":12679,"_25963":106231,"_2424":106348},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2886":62195,"_27469":62148,"_18854":106350,"_5":12679,"_25963":106231,"_2424":106351},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2886":62196,"_27469":62148,"_18854":106353,"_5":12679,"_25963":106231,"_2424":106354},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2886":62197,"_27469":62148,"_18854":106356,"_5":12679,"_25963":106231,"_2424":106357},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2886":62198,"_27469":62148,"_18854":106359,"_5":12679,"_25963":106231,"_2424":106360},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2886":62199,"_27469":62148,"_18854":106362,"_5":12679,"_25963":106231,"_2424":106363},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2886":62200,"_27469":62148,"_18854":106365,"_5":12679,"_25963":106231,"_2424":106366},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2886":62201,"_27469":62148,"_18854":106368,"_5":12679,"_25963":106231,"_2424":106369},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2886":62202,"_27469":62148,"_18854":106371,"_5":12679,"_25963":106231,"_2424":106372},[],"**Delete Key** para eliminar la clave del sistema.",{"_2886":62203,"_27469":62148,"_18854":106374,"_5":12679,"_25963":106235,"_2424":106375},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_2886":62204,"_27469":62148,"_18854":106377,"_5":12679,"_25963":106239,"_2424":106378},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2886":62205,"_27469":62148,"_18854":106380,"_5":12679,"_25963":106239,"_2424":106381},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_2886":62206,"_27469":62148,"_18854":106383,"_5":12679,"_25963":106239,"_2424":106384},[],"**Key Name**: nombre único y descriptivo.",{"_2886":62207,"_27469":62148,"_18854":106386,"_5":12679,"_25963":106239,"_2424":106387},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2886":62208,"_27469":62148,"_18854":106389,"_5":12679,"_25963":106239,"_2424":106390},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2886":62209,"_27469":62148,"_18854":106392,"_5":12679,"_25963":106239,"_2424":106393},[],"**Tags**: metadatos para clasificar la clave.",{"_2886":62210,"_27469":62148,"_18854":106395,"_5":12679,"_25963":106239,"_2424":106396},[],"**Metadata**: información adicional para usos avanzados.",{"_2886":62211,"_27469":62148,"_18854":106398,"_5":12679,"_25963":106243,"_2424":106399},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2886":62212,"_27469":62148,"_18854":106401,"_5":12679,"_25963":106243,"_2424":106402},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_2886":62213,"_27469":62148,"_18854":106404,"_5":12679,"_25963":106243,"_2424":106405},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2886":62214,"_27469":62148,"_18854":106407,"_5":12679,"_25963":106243,"_2424":106408},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2886":62215,"_27469":62148,"_18854":106410,"_5":12679,"_25963":106243,"_2424":106411},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_2886":62216,"_27469":62148,"_18854":106413,"_5":12679,"_25963":106243,"_2424":106414},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2886":62217,"_27469":62148,"_18854":106416,"_5":12679,"_25963":106243,"_2424":106417},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2886":62218,"_27469":62148,"_18854":106419,"_5":12679,"_25963":106243,"_2424":106420},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2886":62219,"_27469":62148,"_18854":106422,"_5":12679,"_25963":106243,"_2424":106423},[],"**Metadata**: información adicional opcional.",{"_2886":62220,"_27469":62148,"_18854":106425,"_5":12679,"_25963":106243,"_2424":106426},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2886":62221,"_27469":62148,"_18854":106428,"_5":12679,"_25963":106243,"_2424":106429},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_2886":62222,"_27469":62148,"_18854":106431,"_5":12679,"_25963":106247,"_2424":106432},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2886":62223,"_27469":62148,"_18854":106434,"_5":12679,"_25963":106251,"_2424":106435},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2886":62224,"_27469":62148,"_18854":106437,"_5":12679,"_25963":106251,"_2424":106438},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2886":62225,"_27469":62148,"_18854":106440,"_5":12679,"_25963":106251,"_2424":106441},[],"**Key Name**: nombre descriptivo.",{"_2886":62226,"_27469":62148,"_18854":106443,"_5":12679,"_25963":106251,"_2424":106444},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2886":62227,"_27469":62148,"_18854":106446,"_5":12679,"_25963":106251,"_2424":106447},[],"**Tags**: etiquetas asociadas.",{"_2886":62228,"_27469":62148,"_18854":106449,"_5":12679,"_25963":106251,"_2424":106450},[],"**Aliases**: nombres alternativos.",{"_2886":62229,"_27469":62148,"_18854":106452,"_5":12679,"_25963":106251,"_2424":106453},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2886":62230,"_27469":62148,"_18854":106455,"_5":12679,"_25963":106251,"_2424":106456},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2886":62231,"_27469":62148,"_18854":106458,"_5":12679,"_25963":106251,"_2424":106459},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2886":62232,"_27469":62148,"_18854":106461,"_5":12679,"_25963":106251,"_2424":106462},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_2886":62233,"_27469":62148,"_18854":106464,"_5":12679,"_25963":106255,"_2424":106465},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2886":62234,"_27469":62148,"_18854":106467,"_5":12679,"_25963":106255,"_2424":106468},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2886":62235,"_27469":62148,"_18854":106470,"_5":12679,"_25963":106259,"_2424":106471},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2886":62236,"_27469":62148,"_18854":106473,"_5":12679,"_25963":106259,"_2424":106474},[],"Campos principales:",{"_2886":62237,"_27469":62148,"_18854":106476,"_5":12679,"_25963":106259,"_2424":106477},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2886":62238,"_27469":62148,"_18854":106479,"_5":12679,"_25963":106259,"_2424":106480},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2886":62239,"_27469":62148,"_18854":106482,"_5":12679,"_25963":106259,"_2424":106483},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2886":62240,"_27469":62148,"_18854":106485,"_5":12679,"_25963":106259,"_2424":106486},[],"**Message**: contenido que se va a firmar.",{"_2886":62241,"_27469":62148,"_18854":106488,"_5":12679,"_25963":106259,"_2424":106489},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2886":62242,"_27469":62148,"_18854":106491,"_5":12679,"_25963":106262,"_2424":106492},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2886":62243,"_27469":62148,"_18854":106494,"_5":12679,"_25963":106262,"_2424":106474},[],{"_2886":62244,"_27469":62148,"_18854":106496,"_5":12679,"_25963":106262,"_2424":106497},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2886":62245,"_27469":62148,"_18854":106499,"_5":12679,"_25963":106262,"_2424":106500},[],"**Message Type**: `Raw` o `Digest`.",{"_2886":62246,"_27469":62148,"_18854":106502,"_5":12679,"_25963":106262,"_2424":106503},[],"**Payload Encoding**: codificación del mensaje.",{"_2886":62247,"_27469":62148,"_18854":106505,"_5":12679,"_25963":106262,"_2424":106506},[],"**Message**: mensaje original o hash.",{"_2886":62248,"_27469":62148,"_18854":106508,"_5":12679,"_25963":106262,"_2424":106509},[],"**Signature**: firma que se desea comprobar.",{"_2886":62249,"_27469":62148,"_18854":106511,"_5":12679,"_25963":106262,"_2424":106512},[],"**Result**: indicador del resultado de la validación.",{"_2886":62250,"_27469":62148,"_18854":106514,"_5":12679,"_25963":106265,"_2424":106515},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2886":62251,"_27469":62148,"_18854":106517,"_5":12679,"_25963":106265,"_2424":106518},[],"Este flujo es útil para:",{"_2886":62252,"_27469":62148,"_18854":106520,"_5":12679,"_25963":106265,"_2424":106521},[],"Solicitar certificados a una CA externa.",{"_2886":62253,"_27469":62148,"_18854":106523,"_5":12679,"_25963":106265,"_2424":106524},[],"Renovar una identidad manteniendo la misma clave.",{"_2886":62254,"_27469":62148,"_18854":106526,"_5":12679,"_25963":106265,"_2424":106527},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2886":62255,"_27469":62148,"_18854":106529,"_5":12679,"_25963":106265,"_2424":106530},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2886":62256,"_27469":62148,"_18854":106532,"_5":12679,"_25963":106265,"_2424":106533},[],"**Organization (O)**: organización o empresa.",{"_2886":62257,"_27469":62148,"_18854":106535,"_5":12679,"_25963":106265,"_2424":106536},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2886":62258,"_27469":62148,"_18854":106538,"_5":12679,"_25963":106265,"_2424":106539},[],"**Country (C)**: código de país de dos letras.",{"_2886":62259,"_27469":62148,"_18854":106541,"_5":12679,"_25963":106265,"_2424":106542},[],"**State / Province (ST)**: estado o provincia.",{"_2886":62260,"_27469":62148,"_18854":106544,"_5":12679,"_25963":106265,"_2424":106545},[],"**Locality (L)**: ciudad o localidad.",{"_2886":62261,"_27469":62148,"_18854":106547,"_5":12679,"_25963":106265,"_2424":106548},[],"**Email Address**: correo de contacto.",{"_2886":62262,"_27469":62148,"_18854":106550,"_5":12679,"_25963":106265,"_2424":106551},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2886":62263,"_27469":62148,"_18854":106553,"_5":12679,"_25963":106265,"_2424":106554},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_2886":62264,"_27469":62148,"_18854":106556,"_5":12679,"_25963":106269,"_2424":106557},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2886":62265,"_27469":62148,"_18854":106559,"_5":12679,"_25963":106269,"_2424":106560},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_2886":62266,"_27469":62266,"_5":13057,"_2424":106562,"_27749":106563,"_18854":106564,"_25963":62266},"Validación online con OCSP",[43001,101196,101674],[],{"_2886":62267,"_27469":62266,"_18854":106566,"_5":12679,"_25963":62266,"_2424":106567},[],"Consulta en tiempo real si un certificado sigue vigente o se ha revocado.",{"_2886":62268,"_27469":62266,"_5":27746,"_18854":106569,"_25963":106570,"_2424":106571},[],"/docs/pr-preview/pr-24/es/platform/pki/ocsp#servicio-ocsp","Servicio OCSP",{"_2886":62269,"_27469":62266,"_5":27746,"_18854":106573,"_25963":106574,"_2424":106575},[],"/docs/pr-preview/pr-24/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2886":62270,"_27469":62266,"_5":27746,"_18854":106577,"_25963":106578,"_2424":106579},[],"/docs/pr-preview/pr-24/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2886":62271,"_27469":62266,"_5":27746,"_18854":106581,"_25963":106582,"_2424":106583},[],"/docs/pr-preview/pr-24/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2886":62272,"_27469":62266,"_5":27746,"_18854":106585,"_25963":106586,"_2424":106587},[],"/docs/pr-preview/pr-24/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2886":62273,"_27469":62266,"_5":27746,"_18854":106589,"_25963":106590,"_2424":104605},[],"/docs/pr-preview/pr-24/es/platform/pki/ocsp#referencias",{"_2886":62274,"_27469":62266,"_18854":106592,"_5":12679,"_25963":106570,"_2424":106593},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_2886":62275,"_27469":62266,"_18854":106595,"_5":12679,"_25963":106570,"_2424":106596},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_2886":62276,"_27469":62266,"_18854":106598,"_5":12679,"_25963":106574,"_2424":106599},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_2886":62277,"_27469":62266,"_18854":106601,"_5":12679,"_25963":106574,"_2424":106602},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_2886":62278,"_27469":62266,"_18854":106604,"_5":12679,"_25963":106574,"_2424":106605},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_2886":62279,"_27469":62266,"_18854":106607,"_5":12679,"_25963":106574,"_2424":106608},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_2886":62280,"_27469":62266,"_18854":106610,"_5":12679,"_25963":106574,"_2424":106611},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_2886":62281,"_27469":62266,"_18854":106613,"_5":12679,"_25963":106574,"_2424":106614},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_2886":62282,"_27469":62266,"_18854":106616,"_5":12679,"_25963":106578,"_2424":106617},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_2886":62283,"_27469":62266,"_18854":106619,"_5":12679,"_25963":106582,"_2424":106620},[],"El respondedor acepta los dos formatos definidos en RFC 6960:",{"_2886":62284,"_27469":62266,"_18854":106622,"_5":12679,"_25963":106582,"_2424":106623},[],"`GET /ocsp/{ocsp_request}` incluye la petición OCSP codificada en Base64url dentro de la propia URL.",{"_2886":62285,"_27469":62266,"_18854":106625,"_5":12679,"_25963":106582,"_2424":106626},[],"`POST /ocsp` envía la petición en el cuerpo con `Content-Type: application/ocsp-request`.",{"_2886":62286,"_27469":62266,"_18854":106628,"_5":12679,"_25963":106582,"_2424":106629},[],"Ejemplo de consulta con `curl` mediante POST:",{"_2886":62287,"_27469":62266,"_18854":106631,"_5":12679,"_25963":106582,"_2424":106632},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_2886":62288,"_27469":62266,"_18854":106634,"_5":12679,"_25963":106586,"_2424":106635},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_2886":62289,"_27469":62266,"_18854":106637,"_5":12679,"_25963":106590,"_2424":49758},[],{"_2886":62290,"_27469":62266,"_18854":106639,"_5":12679,"_25963":106590,"_2424":106640},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_2886":62291,"_27469":62266,"_18854":106642,"_5":12679,"_25963":106590,"_2424":106643},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2886":62292,"_27469":62266,"_18854":106645,"_5":12679,"_25963":106590,"_2424":104692},[],{"_2886":62293,"_27469":62293,"_5":13057,"_2424":106647,"_27749":106648,"_18854":106649,"_25963":62293},"Plataforma Lamassu IoT",[43001,101196],[],{"_2886":62294,"_27469":62293,"_18854":106651,"_5":12679,"_25963":62293,"_2424":106652},[],"Gestiona la PKI y las identidades digitales de tus dispositivos desde una única plataforma.",{"_2886":62295,"_27469":62293,"_5":27746,"_18854":106654,"_25963":106655,"_2424":106656},[],"/docs/pr-preview/pr-24/es/platform/pki/overview#empieza-aquí","Empieza aquí",{"_2886":62296,"_27469":62293,"_5":27746,"_18854":106658,"_25963":106659,"_2424":106660},[],"/docs/pr-preview/pr-24/es/platform/pki/overview#capacidades-principales","Capacidades principales",{"_2886":62297,"_27469":62293,"_5":27746,"_18854":106662,"_25963":106663,"_2424":106664},[],"/docs/pr-preview/pr-24/es/platform/pki/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2886":62298,"_27469":62293,"_5":27746,"_18854":106666,"_25963":106667,"_2424":106668},[],"/docs/pr-preview/pr-24/es/platform/pki/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2886":62299,"_27469":62293,"_5":27746,"_18854":106670,"_25963":106671,"_2424":106672},[],"/docs/pr-preview/pr-24/es/platform/pki/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2886":62300,"_27469":62293,"_5":27746,"_18854":106674,"_25963":106675,"_2424":106676},[],"/docs/pr-preview/pr-24/es/platform/pki/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2886":62301,"_27469":62293,"_5":27746,"_18854":106678,"_25963":106679,"_2424":106680},[],"/docs/pr-preview/pr-24/es/platform/pki/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2886":62302,"_27469":62293,"_5":27746,"_18854":106682,"_25963":106683,"_2424":106684},[],"/docs/pr-preview/pr-24/es/platform/pki/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2886":62303,"_27469":62293,"_5":27746,"_18854":106686,"_25963":106687,"_2424":106688},[],"/docs/pr-preview/pr-24/es/platform/pki/overview#elige-tu-recorrido","Elige tu recorrido",{"_2886":62304,"_27469":62293,"_5":27746,"_18854":106690,"_25963":106691,"_2424":106692},[],"/docs/pr-preview/pr-24/es/platform/pki/overview#referencia-operativa","Referencia operativa",{"_2886":62305,"_27469":62293,"_18854":106694,"_5":12679,"_25963":62293,"_2424":106695},[],"Lamassu IoT centraliza la emisión, distribución, renovación y revocación de identidades X.509 para dispositivos conectados. Puedes construir una PKI privada, proteger sus claves y automatizar el enrolamiento de una flota sin perder visibilidad sobre cada certificado.",{"_2886":62306,"_27469":62293,"_18854":106697,"_5":12679,"_25963":106655,"_2424":106698},[],"<Card title=\"Primeros pasos\" description=\"Crea una CA, emite un certificado y registra tu primer dispositivo.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2886":62307,"_27469":62293,"_18854":106700,"_5":12679,"_25963":106655,"_2424":106701},[],"<Card title=\"Cómo funciona Lamassu\" description=\"Construye el modelo mental de autoridades, claves, identidades y validación.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_2886":62308,"_27469":62293,"_18854":106703,"_5":12679,"_25963":106663,"_2424":106704},[],"Crea autoridades raíz e intermedias o importa una PKI existente. Define qué autoridad puede emitir cada identidad y conserva la cadena de confianza completa.",{"_2886":62309,"_27469":62293,"_18854":106706,"_5":12679,"_25963":106667,"_2424":106707},[],"Genera y custodia claves mediante motores software, HSMs PKCS#11 o servicios cloud. Lamassu desacopla las operaciones de la ubicación física de la clave.",{"_2886":62310,"_27469":62293,"_18854":106709,"_5":12679,"_25963":106671,"_2424":106710},[],"Emite certificados desde la consola o a partir de un CSR, consulta su estado y revócalos cuando dejan de ser fiables.",{"_2886":62311,"_27469":62293,"_18854":106712,"_5":12679,"_25963":106675,"_2424":106713},[],"Define políticas de enrolamiento mediante un Device Management Service (DMS) y deja que los dispositivos soliciten o renueven su identidad a través de EST o CMP.",{"_2886":62312,"_27469":62293,"_18854":106715,"_5":12679,"_25963":106679,"_2424":106716},[],"Ofrece validación online mediante OCSP y distribuye CRLs para consumidores que necesitan comprobar certificados sin conexión.",{"_2886":62313,"_27469":62293,"_18854":106718,"_5":12679,"_25963":106683,"_2424":106719},[],"Suscríbete a cambios del ciclo de vida y envía notificaciones por correo, Microsoft Teams o webhooks.",{"_2886":62314,"_27469":62293,"_18854":106721,"_5":12679,"_25963":106687,"_2424":106722},[],"<Card title=\"Administro la PKI\" description=\"Configura motores, autoridades, emisión y validación.\" href=\"/docs/platform/pki/key-management\" />",{"_2886":62315,"_27469":62293,"_18854":106724,"_5":12679,"_25963":106687,"_2424":106725},[],"<Card title=\"Integro un dispositivo\" description=\"Configura el DMS y usa EST o CMP para obtener una identidad.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2886":62316,"_27469":62293,"_18854":106727,"_5":12679,"_25963":106687,"_2424":106728},[],"<Card title=\"Opero la plataforma\" description=\"Despliega Lamassu y prepara sus dependencias.\" href=\"/docs/deployment/overview\" />",{"_2886":62317,"_27469":62293,"_18854":106730,"_5":12679,"_25963":106687,"_2424":106731},[],"<Card title=\"Integro otro sistema\" description=\"Conecta Lamassu con AWS IoT Core y otros destinos.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_2886":62318,"_27469":62293,"_18854":106733,"_5":12679,"_25963":106691,"_2424":106734},[],"<Card title=\"Perfiles de certificado\" description=\"Convierte la política de emisión en restricciones reutilizables.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_2886":62319,"_27469":62293,"_18854":106736,"_5":12679,"_25963":106691,"_2424":106737},[],"<Card title=\"Jerarquía y rotación\" description=\"Sustituye certificados o claves de CA sin romper la confianza.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_2886":62320,"_27469":62293,"_18854":106739,"_5":12679,"_25963":106691,"_2424":106740},[],"<Card title=\"Control de acceso\" description=\"Configura principales, políticas y el primer administrador.\" href=\"/docs/platform/pki/access-control\" />",{"_2886":62321,"_27469":62293,"_18854":106742,"_5":12679,"_25963":106691,"_2424":106743},[],"<Card title=\"Resolución de problemas\" description=\"Diagnostica Gateway, servicios, emisión y enrolamiento.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2886":62322,"_27469":62322,"_5":13057,"_2424":106745,"_27749":106746,"_18854":106748,"_25963":62322},"Crea tu primera CA",[43001,101196,106747],"Primeros pasos",[],{"_2886":62323,"_27469":62322,"_18854":106750,"_5":12679,"_25963":62322,"_2424":106751},[],"Crea una autoridad raíz y comprueba que está preparada para emitir certificados.",{"_2886":62324,"_27469":62322,"_5":27746,"_18854":106753,"_25963":106754,"_2424":100107},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2886":62325,"_27469":62322,"_5":27746,"_18854":106756,"_25963":106757,"_2424":106758},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2886":62326,"_27469":62322,"_5":27746,"_18854":106760,"_25963":106761,"_2424":106762},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2886":62327,"_27469":62322,"_5":27746,"_18854":106764,"_25963":106765,"_2424":106766},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2886":62328,"_27469":62322,"_5":27746,"_18854":106768,"_25963":106769,"_2424":106770},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2886":62329,"_27469":62322,"_5":27746,"_18854":106772,"_25963":106773,"_2424":106774},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2886":62330,"_27469":62322,"_5":27746,"_18854":106776,"_25963":106777,"_2424":100131},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2886":62331,"_27469":62322,"_18854":106779,"_5":12679,"_25963":62322,"_2424":106780},[],"En este quickstart crearás una autoridad de certificación raíz con un nuevo par de claves. Al terminar tendrás una CA activa que podrás usar en el siguiente quickstart.",{"_2886":62332,"_27469":62322,"_18854":106782,"_5":12679,"_25963":106754,"_2424":106783},[],"Acceso a la consola con permisos para gestionar autoridades.",{"_2886":62333,"_27469":62322,"_18854":106785,"_5":12679,"_25963":106754,"_2424":106786},[],"Al menos un motor criptográfico disponible.",{"_2886":62334,"_27469":62322,"_18854":106788,"_5":12679,"_25963":106754,"_2424":106789},[],"Un nombre que identifique el propósito de la CA, por ejemplo `Acme Device Root CA`.",{"_2886":62335,"_27469":62322,"_18854":106791,"_5":12679,"_25963":106754,"_2424":106792},[],"Una CA raíz se autofirma y actúa como ancla de confianza. Para producción suele ser preferible mantener la raíz más protegida y emitir desde una CA intermedia.",{"_2886":62336,"_27469":62322,"_18854":106794,"_5":12679,"_25963":106757,"_2424":106795},[],"En el menú lateral, abre **Certification Authorities** y selecciona **Create New CA**.",{"_2886":62337,"_27469":62322,"_18854":106797,"_5":12679,"_25963":106757,"_2424":106798},[],"Elige crear una CA con un par de claves nuevo. Si ya tienes la clave en el KMS, usa &#x2A;*Create New CA (Existing Key)**.",{"_2886":62338,"_27469":62322,"_18854":106800,"_5":12679,"_25963":106761,"_2424":106801},[],"Elige el motor criptográfico que custodiará la clave y configura el algoritmo. Para una primera CA puedes usar **EC P-384**, siempre que sea compatible con tus consumidores.",{"_2886":62339,"_27469":62322,"_18854":106803,"_5":12679,"_25963":106761,"_2424":106804},[],"La clave privada permanecerá bajo el control del motor seleccionado.",{"_2886":62340,"_27469":62322,"_18854":106806,"_5":12679,"_25963":106765,"_2424":106807},[],"Selecciona **Root CA** y completa:",{"_2886":62341,"_27469":62322,"_18854":106809,"_5":12679,"_25963":106765,"_2424":106810},[],"**CA Name**: un nombre único y reconocible.",{"_2886":62342,"_27469":62322,"_18854":106812,"_5":12679,"_25963":106765,"_2424":106813},[],"**Subject**: al menos la organización y el país que identificarán a la autoridad.",{"_2886":62343,"_27469":62322,"_18854":106815,"_5":12679,"_25963":106765,"_2424":106816},[],"**CA Certificate Expiration**: una validez mayor que la de los certificados que emitirá.",{"_2886":62344,"_27469":62322,"_18854":106818,"_5":12679,"_25963":106765,"_2424":106819},[],"**Default End-Entity Certificate Issuance Expiration**: la validez predeterminada de los certificados finales.",{"_2886":62345,"_27469":62322,"_18854":106821,"_5":12679,"_25963":106765,"_2424":106822},[],"El nombre de la CA se utilizará como `Common Name` del certificado.",{"_2886":62346,"_27469":62322,"_18854":106824,"_5":12679,"_25963":106769,"_2424":106825},[],"Comprueba el algoritmo, el sujeto y las fechas antes de confirmar. Estos valores definen el ancla de confianza y no deberían elegirse como simples datos de prueba en un entorno productivo.",{"_2886":62347,"_27469":62322,"_18854":106827,"_5":12679,"_25963":106773,"_2424":106828},[],"Abre la nueva CA desde el listado. Debe aparecer activa y mostrar su certificado PEM, la fecha de expiración y la pestaña **Issued Certificates**.",{"_2886":62348,"_27469":62322,"_18854":106830,"_5":12679,"_25963":106777,"_2424":106831},[],"Usa la autoridad para emitir tu primer certificado, o consulta la guía completa de autoridades para crear una CA intermedia, importar una CA o definir perfiles avanzados.",{"_2886":62349,"_27469":62349,"_5":13057,"_2424":106833,"_27749":106834,"_18854":106835,"_25963":62349},"Emite tu primer certificado",[43001,101196,106747],[],{"_2886":62350,"_27469":62349,"_18854":106837,"_5":12679,"_25963":62349,"_2424":106838},[],"Emite una identidad X.509 desde la consola y verifica el resultado.",{"_2886":62351,"_27469":62349,"_5":27746,"_18854":106840,"_25963":106841,"_2424":100107},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2886":62352,"_27469":62349,"_5":27746,"_18854":106843,"_25963":106844,"_2424":106845},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2886":62353,"_27469":62349,"_5":27746,"_18854":106847,"_25963":106848,"_2424":106849},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2886":62354,"_27469":62349,"_5":27746,"_18854":106851,"_25963":106852,"_2424":106853},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2886":62355,"_27469":62349,"_5":27746,"_18854":106855,"_25963":106856,"_2424":106857},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2886":62356,"_27469":62349,"_5":27746,"_18854":106859,"_25963":106860,"_2424":106861},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2886":62357,"_27469":62349,"_5":27746,"_18854":106863,"_25963":106864,"_2424":106774},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2886":62358,"_27469":62349,"_5":27746,"_18854":106866,"_25963":106867,"_2424":100131},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2886":62359,"_27469":62349,"_18854":106869,"_5":12679,"_25963":62349,"_2424":106870},[],"En este quickstart Lamassu generará la clave y el CSR en el navegador, y la CA emitirá el certificado. Al terminar descargarás el certificado y su clave privada.",{"_2886":62360,"_27469":62349,"_18854":106872,"_5":12679,"_25963":106841,"_2424":106873},[],"Una CA activa con permiso para emitir certificados.",{"_2886":62361,"_27469":62349,"_18854":106875,"_5":12679,"_25963":106841,"_2424":106876},[],"Un nombre para la identidad, por ejemplo `device-001.example.internal`.",{"_2886":62362,"_27469":62349,"_18854":106878,"_5":12679,"_25963":106841,"_2424":106879},[],"Un lugar seguro en el que custodiar la clave privada descargada.",{"_2886":62363,"_27469":62349,"_18854":106881,"_5":12679,"_25963":106841,"_2424":106882},[],"En este flujo la clave se genera en el navegador y Lamassu no la almacena. Descárgala y protégela antes de cerrar el resultado de la operación.",{"_2886":62364,"_27469":62349,"_18854":106884,"_5":12679,"_25963":106844,"_2424":106885},[],"Abre la CA creada en el quickstart anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2886":62365,"_27469":62349,"_18854":106887,"_5":12679,"_25963":106848,"_2424":106888},[],"Selecciona **Generate Key & CSR in Browser**. Usa **Upload Existing CSR** cuando la clave privada deba generarse y permanecer en el sistema de destino.",{"_2886":62366,"_27469":62349,"_18854":106890,"_5":12679,"_25963":106852,"_2424":106891},[],"Introduce el `Common Name` y, si corresponde, la organización, unidad organizativa y ubicación. Añade SANs para cada nombre DNS, dirección IP, correo o URI con el que se vaya a validar la identidad.",{"_2886":62367,"_27469":62349,"_18854":106893,"_5":12679,"_25963":106856,"_2424":106894},[],"Elige RSA o ECDSA, define la validez y selecciona los usos de clave. Para una identidad de dispositivo que usa mTLS, habilita **Digital Signature** y **Client Authentication**.",{"_2886":62368,"_27469":62349,"_18854":106896,"_5":12679,"_25963":106856,"_2424":106897},[],"La validez no puede superar la fecha de expiración de la CA emisora.",{"_2886":62369,"_27469":62349,"_18854":106899,"_5":12679,"_25963":106860,"_2424":106900},[],"Confirma la emisión y descarga inmediatamente el certificado y la clave privada en formato PEM.",{"_2886":62370,"_27469":62349,"_18854":106902,"_5":12679,"_25963":106864,"_2424":106903},[],"El certificado debe aparecer en **Issued Certificates** con estado activo. Comprueba su sujeto, SANs, emisor, usos y periodo de validez.",{"_2886":62371,"_27469":62349,"_18854":106905,"_5":12679,"_25963":106867,"_2424":106906},[],"Registra tu primer dispositivo para asociar la identidad a una entidad gestionada, o consulta la gestión de certificados.",{"_2886":62372,"_27469":62372,"_5":13057,"_2424":106747,"_27749":106908,"_18854":106909,"_25963":62372},[43001,101196,106747],[],{"_2886":62373,"_27469":62372,"_18854":106911,"_5":12679,"_25963":62372,"_2424":106912},[],"Obtén un primer resultado con Lamassu y continúa desde una base funcional.",{"_2886":62374,"_27469":62372,"_5":27746,"_18854":106914,"_25963":106915,"_2424":106916},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2886":62375,"_27469":62372,"_5":27746,"_18854":106918,"_25963":106919,"_2424":100107},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2886":62376,"_27469":62372,"_18854":106921,"_5":12679,"_25963":62372,"_2424":106922},[],"Los quickstarts te llevan desde una instancia preparada hasta una identidad de dispositivo activa. Cada guía produce un resultado verificable y enlaza la explicación detallada cuando necesitas ir más allá.",{"_2886":62377,"_27469":62372,"_18854":106924,"_5":12679,"_25963":106915,"_2424":106925},[],"<Card title=\"1. Crea tu primera CA\" description=\"Establece una raíz de confianza capaz de emitir certificados.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2886":62378,"_27469":62372,"_18854":106927,"_5":12679,"_25963":106915,"_2424":106928},[],"<Card title=\"2. Emite un certificado\" description=\"Crea una identidad X.509 y verifica su contenido.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2886":62379,"_27469":62372,"_18854":106930,"_5":12679,"_25963":106915,"_2424":106931},[],"<Card title=\"3. Registra un dispositivo\" description=\"Añade un dispositivo y asígnale su primera identidad.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_2886":62380,"_27469":62372,"_18854":106933,"_5":12679,"_25963":106919,"_2424":106934},[],"Necesitas acceso a la consola de Lamassu IoT y permisos para administrar claves, autoridades y dispositivos. La instancia debe tener al menos un motor criptográfico configurado.",{"_2886":62381,"_27469":62372,"_18854":106936,"_5":12679,"_25963":106919,"_2424":106937},[],"Si todavía no tienes una instancia, elige primero un modelo de despliegue.",{"_2886":62382,"_27469":62382,"_5":13057,"_2424":106939,"_27749":106940,"_18854":106941,"_25963":62382},"Registra tu primer dispositivo",[43001,101196,106747],[],{"_2886":62383,"_27469":62382,"_18854":106943,"_5":12679,"_25963":62382,"_2424":106944},[],"Añade un dispositivo a Lamassu y asígnale una identidad activa.",{"_2886":62384,"_27469":62382,"_5":27746,"_18854":106946,"_25963":106947,"_2424":100107},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/register-device#antes-de-empezar",{"_2886":62385,"_27469":62382,"_5":27746,"_18854":106949,"_25963":106950,"_2424":106951},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2886":62386,"_27469":62382,"_5":27746,"_18854":106953,"_25963":106954,"_2424":106955},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2886":62387,"_27469":62382,"_5":27746,"_18854":106957,"_25963":106958,"_2424":106959},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2886":62388,"_27469":62382,"_5":27746,"_18854":106961,"_25963":106962,"_2424":106963},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2886":62389,"_27469":62382,"_5":27746,"_18854":106965,"_25963":106966,"_2424":106967},[],"/docs/pr-preview/pr-24/es/platform/pki/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2886":62390,"_27469":62382,"_18854":106969,"_5":12679,"_25963":62382,"_2424":106970},[],"En este quickstart registrarás manualmente un dispositivo y le asignarás su primer certificado. Es el recorrido más corto para entender cómo Lamassu relaciona una entidad física con su historial de identidades.",{"_2886":62391,"_27469":62382,"_18854":106972,"_5":12679,"_25963":106947,"_2424":106973},[],"Un DMS configurado.",{"_2886":62392,"_27469":62382,"_18854":106975,"_5":12679,"_25963":106947,"_2424":106976},[],"Una CA asociada al DMS.",{"_2886":62393,"_27469":62382,"_18854":106978,"_5":12679,"_25963":106947,"_2424":106979},[],"Un identificador único para el dispositivo.",{"_2886":62394,"_27469":62382,"_18854":106981,"_5":12679,"_25963":106950,"_2424":106982},[],"Abre **Managed Devices**, selecciona la acción para registrar un dispositivo y completa:",{"_2886":62395,"_27469":62382,"_18854":106984,"_5":12679,"_25963":106950,"_2424":106985},[],"**Device ID**: identificador único del dispositivo.",{"_2886":62396,"_27469":62382,"_18854":106987,"_5":12679,"_25963":106950,"_2424":106988},[],"**Registration Authority**: DMS que aplicará las políticas de enrolamiento.",{"_2886":62397,"_27469":62382,"_18854":106990,"_5":12679,"_25963":106950,"_2424":106991},[],"**Icon** y **Tags**: clasificación opcional para localizarlo después.",{"_2886":62398,"_27469":62382,"_18854":106993,"_5":12679,"_25963":106954,"_2424":106994},[],"Abre el dispositivo recién creado. Debe aparecer con estado **No Identity**: existe en el inventario, pero todavía no tiene un certificado asociado.",{"_2886":62399,"_27469":62382,"_18854":106996,"_5":12679,"_25963":106958,"_2424":106997},[],"Selecciona **Assign Identity**. Lamassu buscará certificados activos cuyo `Common Name` coincida con el `Device ID`.",{"_2886":62400,"_27469":62382,"_18854":106999,"_5":12679,"_25963":106958,"_2424":107000},[],"Selecciona un certificado existente o usa **Issue New Instead** para emitir uno desde una CA vinculada al DMS.",{"_2886":62401,"_27469":62382,"_18854":107002,"_5":12679,"_25963":106962,"_2424":107003},[],"Tras confirmar, el estado debe cambiar a **Active**. Revisa **Certificate History** para comprobar la identidad asociada y **Device Event Timeline** para ver el evento de asignación.",{"_2886":62402,"_27469":62382,"_18854":107005,"_5":12679,"_25963":106966,"_2424":107006},[],"El registro manual ayuda a entender el modelo, pero una flota debe usar enrolamiento automatizado. Continúa con Device Management Service y la integración EST o CMP.",{"_2886":62403,"_27469":62403,"_5":13057,"_2424":107008,"_27749":107009,"_18854":107010,"_25963":62403},"Resolución de problemas",[43001,101196,101197],[],{"_2886":62404,"_27469":62403,"_18854":107012,"_5":12679,"_25963":62403,"_2424":107013},[],"Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.",{"_2886":62405,"_27469":62403,"_5":27746,"_18854":107015,"_25963":107016,"_2424":107017},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2886":62406,"_27469":62403,"_5":27746,"_18854":107019,"_25963":107020,"_2424":107021},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2886":62407,"_27469":62403,"_5":27746,"_18854":107023,"_25963":107024,"_2424":107025},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2886":62408,"_27469":62403,"_5":27746,"_18854":107027,"_25963":107028,"_2424":107029},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2886":62409,"_27469":62403,"_5":27746,"_18854":107031,"_25963":107032,"_2424":107033},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2886":62410,"_27469":62403,"_5":27746,"_18854":107035,"_25963":107036,"_2424":107037},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2886":62411,"_27469":62403,"_5":27746,"_18854":107039,"_25963":107040,"_2424":107041},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2886":62412,"_27469":62403,"_5":27746,"_18854":107043,"_25963":107044,"_2424":107045},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2886":62413,"_27469":62403,"_5":27746,"_18854":107047,"_25963":107048,"_2424":107049},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2886":62414,"_27469":62403,"_5":27746,"_18854":107051,"_25963":107052,"_2424":107053},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2886":62415,"_27469":62403,"_5":27746,"_18854":107055,"_25963":107056,"_2424":107057},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2886":62416,"_27469":62403,"_5":27746,"_18854":107059,"_25963":107060,"_2424":107061},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2886":62417,"_27469":62403,"_5":27746,"_18854":107063,"_25963":107064,"_2424":107065},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2886":62418,"_27469":62403,"_5":27746,"_18854":107067,"_25963":107068,"_2424":107069},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2886":62419,"_27469":62403,"_5":27746,"_18854":107071,"_25963":107072,"_2424":107073},[],"/docs/pr-preview/pr-24/es/platform/pki/troubleshooting#observabilidad","Observabilidad",{"_2886":62420,"_27469":62403,"_18854":107075,"_5":12679,"_25963":62403,"_2424":107076},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway, un pod no preparado y una emisión rechazada pueden parecer el mismo problema desde la consola, pero requieren evidencias distintas.",{"_2886":62421,"_27469":62403,"_18854":107078,"_5":12679,"_25963":107020,"_2424":107079},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2886":62422,"_27469":62403,"_18854":107081,"_5":12679,"_25963":107024,"_2424":107082},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2886":62423,"_27469":62403,"_18854":107084,"_5":12679,"_25963":107028,"_2424":107085},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2886":62424,"_27469":62403,"_18854":107087,"_5":12679,"_25963":107032,"_2424":107088},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2886":62425,"_27469":62403,"_18854":107090,"_5":12679,"_25963":107036,"_2424":107091},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2886":62426,"_27469":62403,"_18854":107093,"_5":12679,"_25963":107040,"_2424":107094},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2886":62427,"_27469":62403,"_18854":107096,"_5":12679,"_25963":107040,"_2424":107097},[],"Ejecuta también la prueba de conectividad del chart:",{"_2886":62428,"_27469":62403,"_18854":107099,"_5":12679,"_25963":107040,"_2424":107100},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2886":62429,"_27469":62403,"_18854":107102,"_5":12679,"_25963":107040,"_2424":107103},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2886":62430,"_27469":62403,"_18854":107105,"_5":12679,"_25963":107044,"_2424":107106},[],"Si recibes un 401:",{"_2886":62431,"_27469":62403,"_18854":107108,"_5":12679,"_25963":107044,"_2424":107109},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2886":62432,"_27469":62403,"_18854":107111,"_5":12679,"_25963":107044,"_2424":107112},[],"verifica emisor, audiencia y expiración del token;",{"_2886":62433,"_27469":62403,"_18854":107114,"_5":12679,"_25963":107044,"_2424":107115},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2886":62434,"_27469":62403,"_18854":107117,"_5":12679,"_25963":107044,"_2424":107118},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2886":62435,"_27469":62403,"_18854":107120,"_5":12679,"_25963":107044,"_2424":107121},[],"Si el login termina pero las APIs devuelven 403:",{"_2886":62436,"_27469":62403,"_18854":107123,"_5":12679,"_25963":107044,"_2424":107124},[],"inspecciona los claims reales del token;",{"_2886":62437,"_27469":62403,"_18854":107126,"_5":12679,"_25963":107044,"_2424":107127},[],"confirma que coinciden con un principal activo;",{"_2886":62438,"_27469":62403,"_18854":107129,"_5":12679,"_25963":107044,"_2424":107130},[],"revisa las políticas concedidas al principal;",{"_2886":62439,"_27469":62403,"_18854":107132,"_5":12679,"_25963":107044,"_2424":107133},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2886":62440,"_27469":62403,"_18854":107135,"_5":12679,"_25963":107044,"_2424":107136},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2886":62441,"_27469":62403,"_18854":107138,"_5":12679,"_25963":107048,"_2424":107139},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2886":62442,"_27469":62403,"_18854":107141,"_5":12679,"_25963":107048,"_2424":107142},[],"Localiza el pod y Service de authz.",{"_2886":62443,"_27469":62403,"_18854":107144,"_5":12679,"_25963":107048,"_2424":107145},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2886":62444,"_27469":62403,"_18854":107147,"_5":12679,"_25963":107048,"_2424":107148},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2886":62445,"_27469":62403,"_18854":107150,"_5":12679,"_25963":107048,"_2424":107151},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2886":62446,"_27469":62403,"_18854":107153,"_5":12679,"_25963":107048,"_2424":107154},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2886":62447,"_27469":62403,"_18854":107156,"_5":12679,"_25963":107052,"_2424":107157},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2886":62448,"_27469":62403,"_18854":107159,"_5":12679,"_25963":107052,"_2424":107160},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2886":62449,"_27469":62403,"_18854":107162,"_5":12679,"_25963":107052,"_2424":107163},[],"volumen persistente sin enlazar;",{"_2886":62450,"_27469":62403,"_18854":107165,"_5":12679,"_25963":107052,"_2424":107166},[],"imagen inaccesible o política de pull incorrecta;",{"_2886":62451,"_27469":62403,"_18854":107168,"_5":12679,"_25963":107052,"_2424":107169},[],"configuración inválida del motor criptográfico;",{"_2886":62452,"_27469":62403,"_18854":107171,"_5":12679,"_25963":107052,"_2424":107172},[],"límites de CPU o memoria demasiado bajos;",{"_2886":62453,"_27469":62403,"_18854":107174,"_5":12679,"_25963":107052,"_2424":107175},[],"migración previa incompleta.",{"_2886":62454,"_27469":62403,"_18854":107177,"_5":12679,"_25963":107052,"_2424":107178},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2886":62455,"_27469":62403,"_18854":107180,"_5":12679,"_25963":107052,"_2424":107181},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2886":62456,"_27469":62403,"_18854":107183,"_5":12679,"_25963":107056,"_2424":107184},[],"Acota el error siguiendo este orden:",{"_2886":62457,"_27469":62403,"_18854":107186,"_5":12679,"_25963":107056,"_2424":107187},[],"La CA existe, está activa y no ha expirado.",{"_2886":62458,"_27469":62403,"_18854":107189,"_5":12679,"_25963":107056,"_2424":107190},[],"La CA tiene una clave privada utilizable y el motor está disponible.",{"_2886":62459,"_27469":62403,"_18854":107192,"_5":12679,"_25963":107056,"_2424":107193},[],"La CSR tiene una firma válida.",{"_2886":62460,"_27469":62403,"_18854":107195,"_5":12679,"_25963":107056,"_2424":107196},[],"El perfil permite el tipo y tamaño de clave.",{"_2886":62461,"_27469":62403,"_18854":107198,"_5":12679,"_25963":107056,"_2424":107199},[],"La validez solicitada cabe dentro de la vigencia de la CA.",{"_2886":62462,"_27469":62403,"_18854":107201,"_5":12679,"_25963":107056,"_2424":107202},[],"KU, EKU, sujeto y extensiones cumplen el perfil.",{"_2886":62463,"_27469":62403,"_18854":107204,"_5":12679,"_25963":107056,"_2424":107205},[],"Si la reemisión de una CA falla, recuerda que no se admite para una CA revocada o ya expirada. Para cambiar su clave, sigue Jerarquía y rotación de CAs.",{"_2886":62464,"_27469":62403,"_18854":107207,"_5":12679,"_25963":107060,"_2424":107208},[],"Comprueba:",{"_2886":62465,"_27469":62403,"_18854":107210,"_5":12679,"_25963":107060,"_2424":107211},[],"el identificador del DMS en el path EST;",{"_2886":62466,"_27469":62403,"_18854":107213,"_5":12679,"_25963":107060,"_2424":107214},[],"el método de autenticación configurado;",{"_2886":62467,"_27469":62403,"_18854":107216,"_5":12679,"_25963":107060,"_2424":107217},[],"la cadena presentada por el cliente;",{"_2886":62468,"_27469":62403,"_18854":107219,"_5":12679,"_25963":107060,"_2424":107220},[],"las CAs de validación y el límite de niveles;",{"_2886":62469,"_27469":62403,"_18854":107222,"_5":12679,"_25963":107060,"_2424":107223},[],"el estado de revocación del certificado cliente;",{"_2886":62470,"_27469":62403,"_18854":107225,"_5":12679,"_25963":107060,"_2424":107226},[],"la firma de la CSR;",{"_2886":62471,"_27469":62403,"_18854":107228,"_5":12679,"_25963":107060,"_2424":107229},[],"la CA y el perfil usados para emitir;",{"_2886":62472,"_27469":62403,"_18854":107231,"_5":12679,"_25963":107060,"_2424":107232},[],"la ventana de re-enrolamiento.",{"_2886":62473,"_27469":62403,"_18854":107234,"_5":12679,"_25963":107060,"_2424":107235},[],"En re-enrolamiento, Lamassu intenta validar primero con la CA de enrolamiento y después con las CAs adicionales. Durante una migración, conserva la CA anterior en ese segundo conjunto hasta terminar el solapamiento.",{"_2886":62474,"_27469":62403,"_18854":107237,"_5":12679,"_25963":107064,"_2424":107238},[],"Confirma que la revocación quedó persistida y tiene razón y timestamp.",{"_2886":62475,"_27469":62403,"_18854":107240,"_5":12679,"_25963":107064,"_2424":107241},[],"Revisa la configuración y logs de VA.",{"_2886":62476,"_27469":62403,"_18854":107243,"_5":12679,"_25963":107064,"_2424":107244},[],"Comprueba la periodicidad y próxima actualización de la CRL.",{"_2886":62477,"_27469":62403,"_18854":107246,"_5":12679,"_25963":107064,"_2424":107247},[],"Descarta cachés intermedias en proxy y cliente.",{"_2886":62478,"_27469":62403,"_18854":107249,"_5":12679,"_25963":107064,"_2424":107250},[],"Verifica que el certificado apunta al endpoint que estás consultando.",{"_2886":62479,"_27469":62403,"_18854":107252,"_5":12679,"_25963":107064,"_2424":107253},[],"Consulta por número de serie y emisor correctos.",{"_2886":62480,"_27469":62403,"_18854":107255,"_5":12679,"_25963":107068,"_2424":107256},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2886":62481,"_27469":62403,"_18854":107258,"_5":12679,"_25963":107068,"_2424":107259},[],"verifica que esté habilitado en el servicio emisor;",{"_2886":62482,"_27469":62403,"_18854":107261,"_5":12679,"_25963":107068,"_2424":107262},[],"comprueba conectividad y credenciales AMQP;",{"_2886":62483,"_27469":62403,"_18854":107264,"_5":12679,"_25963":107068,"_2424":107265},[],"revisa exchange, routing key, colas y consumidores;",{"_2886":62484,"_27469":62403,"_18854":107267,"_5":12679,"_25963":107068,"_2424":107268},[],"inspecciona dead-letter queues;",{"_2886":62485,"_27469":62403,"_18854":107270,"_5":12679,"_25963":107068,"_2424":107271},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2886":62486,"_27469":62403,"_18854":107273,"_5":12679,"_25963":107068,"_2424":107274},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2886":62487,"_27469":62403,"_18854":107276,"_5":12679,"_25963":107072,"_2424":107277},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2886":62488,"_27469":62403,"_18854":107279,"_5":12679,"_25963":107072,"_2424":107280},[],"Antes de cerrar una incidencia, guarda:",{"_2886":62489,"_27469":62403,"_18854":107282,"_5":12679,"_25963":107072,"_2424":107283},[],"causa confirmada;",{"_2886":62490,"_27469":62403,"_18854":107285,"_5":12679,"_25963":107072,"_2424":107286},[],"alcance temporal y recursos afectados;",{"_2886":62491,"_27469":62403,"_18854":107288,"_5":12679,"_25963":107072,"_2424":107289},[],"comandos o consultas utilizados;",{"_2886":62492,"_27469":62403,"_18854":107291,"_5":12679,"_25963":107072,"_2424":107292},[],"cambio aplicado y forma de revertirlo;",{"_2886":62493,"_27469":62403,"_18854":107294,"_5":12679,"_25963":107072,"_2424":107295},[],"validación desde un consumidor;",{"_2886":62494,"_27469":62403,"_18854":107297,"_5":12679,"_25963":107072,"_2424":107298},[],"acción preventiva y propietario.",{"_2886":62495,"_27469":62495,"_5":13057,"_2424":50421,"_18854":107300,"_25963":62495},[],{"_2886":62496,"_27469":62495,"_18854":107302,"_5":12679,"_25963":62495,"_2424":50425},[],{"_2886":62497,"_27469":62495,"_5":27746,"_18854":107304,"_25963":107305,"_2424":50429},[],"/docs/pr-preview/pr-24/es/test#cards",{"_2886":62498,"_27469":62495,"_5":27746,"_18854":107307,"_25963":107308,"_2424":50433},[],"/docs/pr-preview/pr-24/es/test#codeblock",{"_2886":62499,"_27469":62495,"_5":27746,"_18854":107310,"_25963":107311,"_2424":50437},[],"/docs/pr-preview/pr-24/es/test#list",{"_2886":62500,"_27469":62495,"_18854":107313,"_5":12679,"_25963":62495,"_2424":50440},[],{"_2886":62501,"_27469":62495,"_18854":107315,"_5":12679,"_25963":107305,"_2424":50443},[],{"_2886":62502,"_27469":62495,"_18854":107317,"_5":12679,"_25963":107305,"_2424":50446},[],{"_2886":62503,"_27469":62495,"_18854":107319,"_5":12679,"_25963":107311,"_2424":50449},[],{"_2886":62504,"_27469":62495,"_18854":107321,"_5":12679,"_25963":107311,"_2424":50452},[],{"_13351":107323,"_50456":107324,"_50458":107325,"_50460":107326,"_16221":244