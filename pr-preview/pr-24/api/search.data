ssu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes",{"_9127":36,"_25351":34,"_5":25510,"_21542":36740,"_17356":36741,"_1875":36742},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#fastlane---despliegue-automatizado-en-kubernetes","Fastlane - Despliegue automatizado en Kubernetes",{"_9127":37,"_25351":34,"_5":25510,"_21542":36744,"_17356":36745,"_1875":36746},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#flags-de-línea-de-comandos","Flags de línea de comandos",{"_9127":38,"_25351":34,"_5":25510,"_21542":36748,"_17356":36749,"_1875":36750},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#detección-de-distribución-kubernetes","Detección de distribución Kubernetes",{"_9127":39,"_25351":34,"_5":25510,"_21542":36752,"_17356":36753,"_1875":36754},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#verificación-de-dependencias","Verificación de dependencias",{"_9127":40,"_25351":34,"_5":25510,"_21542":36756,"_17356":36757,"_1875":36758},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#addons-obligatorios-en-microk8s","Addons obligatorios en MicroK8s",{"_9127":41,"_25351":34,"_5":25510,"_21542":36760,"_17356":36761,"_1875":36762},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#modo-interactivo-vs-no-interactivo","Modo interactivo vs no interactivo",{"_9127":42,"_25351":34,"_5":25510,"_21542":36764,"_17356":36765,"_1875":36766},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#modo-interactivo-por-defecto","Modo interactivo (por defecto)",{"_9127":43,"_25351":34,"_5":25510,"_21542":36768,"_17356":36769,"_1875":36770},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_9127":44,"_25351":34,"_5":25510,"_21542":36772,"_17356":36773,"_1875":36774},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#modo-online-vs-offline","Modo online vs offline",{"_9127":45,"_25351":34,"_5":25510,"_21542":36776,"_17356":36777,"_1875":36778},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_9127":46,"_25351":34,"_5":25510,"_21542":36780,"_17356":36781,"_1875":36782},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#modo-offline","Modo offline",{"_9127":47,"_25351":34,"_5":25510,"_21542":36784,"_17356":36785,"_1875":36786},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#instalación-de-componentes","Instalación de componentes",{"_9127":48,"_25351":34,"_5":25510,"_21542":36788,"_17356":36789,"_1875":36790},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_9127":49,"_25351":34,"_5":25510,"_21542":36792,"_17356":36793,"_1875":36794},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_9127":50,"_25351":34,"_5":25510,"_21542":36796,"_17356":36797,"_1875":36798},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_9127":51,"_25351":34,"_5":25510,"_21542":36800,"_17356":36801,"_1875":36802},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_9127":52,"_25351":34,"_5":25510,"_21542":36804,"_17356":36805,"_1875":36806},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#configuración-tls","Configuración TLS",{"_9127":53,"_25351":34,"_5":25510,"_21542":36808,"_17356":36809,"_1875":36810},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#certificado-externo","Certificado externo",{"_9127":54,"_25351":34,"_5":25510,"_21542":36812,"_17356":36813,"_1875":36814},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_9127":55,"_25351":34,"_5":25510,"_21542":36816,"_17356":36817,"_1875":36818},[],"/docs/pr-preview/pr-24/despliegue/onprem/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_9127":56,"_25351":34,"_5":25510,"_