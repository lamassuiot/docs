4":50348,"_35656":50351,"_35658":50354,"_35660":50357,"_35662":50360,"_35664":50363,"_35666":50366,"_35668":50369,"_35670":50372,"_35672":50375,"_35674":50378,"_35676":50381,"_35678":50384,"_35680":50387,"_35682":50390,"_35684":50393,"_35686":50396,"_35688":50399,"_35690":50402,"_35692":50405,"_35694":50408,"_35696":50411,"_35698":50414,"_35700":50417,"_35702":50420,"_35704":50423,"_35706":50426,"_35708":50430,"_35710":50434,"_35712":50438,"_35714":50441,"_35716":50444,"_35718":50447,"_35720":50450},{"_2886":15,"_27469":15,"_5":13057,"_2424":42999,"_27749":43000,"_18854":43004,"_25963":15},"Deploy from AWS Marketplace",[43001,43002,43003],"Docs","Deployment","Other models",[],{"_2886":16,"_27469":15,"_18854":43006,"_5":12679,"_25963":15,"_2424":43007},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2886":17,"_27469":15,"_5":27746,"_18854":43009,"_25963":43010,"_2424":43011},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2886":18,"_27469":15,"_5":27746,"_18854":43013,"_25963":43014,"_2424":43015},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2886":19,"_27469":15,"_5":27746,"_18854":43017,"_25963":43018,"_2424":43019},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2886":20,"_27469":15,"_5":27746,"_18854":43021,"_25963":43022,"_2424":43023},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2886":21,"_27469":15,"_5":27746,"_18854":43025,"_25963":43026,"_2424":43027},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2886":22,"_27469":15,"_5":27746,"_18854":43029,"_25963":43030,"_2424":43031},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2886":23,"_27469":15,"_5":27746,"_18854":43033,"_25963":43034,"_2424":43035},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#next-step","Next step",{"_2886":24,"_27469":15,"_18854":43037,"_5":12679,"_25963":15,"_2424":43038},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2886":25,"_27469":15,"_18854":43040,"_5":12679,"_25963":43010,"_2424":43041},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2886":26,"_27469":15,"_18854":43043,"_5":12679,"_25963":43010,"_2424":43044},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2886":27,"_27469":15,"_18854":43046,"_5":12679,"_25963":43010,"_2424":43047},[],"A security group allowing the necessary endpoints.",{"_2886":28,"_27469":15,"_18854":43049,"_5":12679,"_25963":43014,"_2424":43050},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2886":29,"_27469":15,"_18854":43052,"_5":12679,"_25963":43014,"_2424":43053},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2886":30,"_27469":15,"_18854":43055,"_5":12679,"_25963":43014,"_2424":43056},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2886":31,"_27469":15,"_18854":43058,"_5":12679,"_25963":43018,"_2424":43059},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2886":32,"_27469":15,"_18854":43061,"_5":12679,"_25963":43022,"_2424":43062},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2886":33,"_27469":15,"_18854":43064,"_5":12679,"_25963":43026,"_2424":43065},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2886":34,"_27469":15,"_18854":43067,"_5":12679,"_25963":43030,"_2424":43068},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2886":35,"_27469":15,"_18854":43070,"_5":12679,"_25963":43034,"_2424":43071},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2886":36,"_27469":36,"_5":13057,"_2424":43073,"_27749":43074,"_18854":43075,"_25963":36},"Deploy Lamassu",[43001,43002],[],{"_2886":37,"_27469":36,"_18854":43077,"_5":12679,"_25963":36,"_2424":43078},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2886":38,"_27469":36,"_5":27746,"_18854":43080,"_25963":43081,"_2424":43082},[],"/docs/pr-preview/pr-24/deployment/overview#choose-a-model","Choose a model",{"_2886":39,"_27469":36,"_5":27746,"_18854":43084,"_25963":43085,"_2424":43086},[],"/docs/pr-preview/pr-24/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2886":40,"_27469":36,"_5":27746,"_18854":43088,"_25963":43089,"_2424":43090},[],"/docs/pr-preview/pr-24/deployment/overview#after-deployment","After deployment",{"_2886":41,"_27469":36,"_18854":43092,"_5":12679,"_25963":36,"_2424":43093},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2886":42,"_27469":36,"_18854":43095,"_5":12679,"_25963":43081,"_2424":43096},[],"Model",{"_2886":43,"_27469":36,"_18854":43098,"_5":12679,"_25963":43081,"_2424":43099},[],"Recommended for",{"_2886":44,"_27469":36,"_18854":43101,"_5":12679,"_25963":43081,"_2424":43102},[],"Who operates the infrastructure",{"_2886":45,"_27469":36,"_18854":43104,"_5":12679,"_25963":43081,"_2424":43105},[],"Starting point",{"_2886":46,"_27469":36,"_18854":43107,"_5":12679,"_25963":43081,"_2424":43108},[],"Kubernetes self-managed",{"_2886":47,"_27469":36,"_18854":43110,"_5":12679,"_25963":43081,"_2424":43111},[],"Production, regulated environments and custom deployments",{"_2886":48,"_27469":36,"_18854":43113,"_5":12679,"_25963":43081,"_2424":43114},[],"Your team",{"_2886":49,"_27469":36,"_18854":43116,"_5":12679,"_25963":43081,"_2424":43117},[],"Helm or Fastlane",{"_2886":50,"_27469":36,"_18854":43119,"_5":12679,"_25963":43081,"_2424":43120},[],"AWS Marketplace",{"_2886":51,"_27469":36,"_18854":43122,"_5":12679,"_25963":43081,"_2424":43123},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2886":52,"_27469":36,"_18854":43125,"_5":12679,"_25963":43081,"_2424":43114},[],{"_2886":53,"_27469":36,"_18854":43127,"_5":12679,"_25963":43081,"_2424":43128},[],"Preconfigured image on EC2",{"_2886":54,"_27469":36,"_18854":43130,"_5":12679,"_25963":43081,"_2424":43131},[],"SaaS",{"_2886":55,"_27469":36,"_18854":43133,"_5":12679,"_25963":43081,"_2424":43134},[],"Teams that want to use the platform without operating it",{"_2886":56,"_27469":36,"_18854":43136,"_5":12679,"_25963":43081,"_2424":43137},[],"Lamassu",{"_2886":57,"_27469":36,"_18854":43139,"_5":12679,"_25963":43081,"_2424":43140},[],"Managed subscription",{"_2886":58,"_27469":36,"_18854":43142,"_5":12679,"_25963":43081,"_2424":43143},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2886":59,"_27469":36,"_18854":43145,"_5":12679,"_25963":43081,"_2424":43146},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2886":60,"_27469":36,"_18854":43148,"_5":12679,"_25963":43081,"_2424":43149},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2886":61,"_27469":36,"_18854":43151,"_5":12679,"_25963":43085,"_2424":43152},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2886":62,"_27469":36,"_18854":43154,"_5":12679,"_25963":43089,"_2424":43155},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2886":63,"_27469":63,"_5":13057,"_2424":43157,"_27749":43158,"_18854":43159,"_25963":63},"Use Lamassu as SaaS",[43001,43002,43003],[],{"_2886":64,"_27469":63,"_18854":43161,"_5":12679,"_25963":63,"_2424":43162},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2886":65,"_27469":63,"_5":27746,"_18854":43164,"_25963":43165,"_2424":43166},[],"/docs/pr-preview/pr-24/deployment/saas#what-the-service-manages","What the service manages",{"_2886":66,"_27469":63,"_5":27746,"_18854":43168,"_25963":43169,"_2424":43170},[],"/docs/pr-preview/pr-24/deployment/saas#plans","Plans",{"_2886":67,"_27469":63,"_5":27746,"_18854":43172,"_25963":43173,"_2424":43174},[],"/docs/pr-preview/pr-24/deployment/saas#request-access","Request access",{"_2886":68,"_27469":63,"_18854":43176,"_5":12679,"_25963":63,"_2424":43177},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2886":69,"_27469":63,"_18854":43179,"_5":12679,"_25963":43165,"_2424":43180},[],"Platform availability and maintenance.",{"_2886":70,"_27469":63,"_18854":43182,"_5":12679,"_25963":43165,"_2424":43183},[],"Automatic backups.",{"_2886":71,"_27469":63,"_18854":43185,"_5":12679,"_25963":43165,"_2424":43186},[],"Version upgrades.",{"_2886":72,"_27469":63,"_18854":43188,"_5":12679,"_25963":43165,"_2424":43189},[],"Technical support and SLA according to your plan.",{"_2886":73,"_27469":63,"_18854":43191,"_5":12679,"_25963":43169,"_2424":43192},[],"Plan",{"_2886":74,"_27469":63,"_18854":43194,"_5":12679,"_25963":43169,"_2424":43195},[],"Devices",{"_2886":75,"_27469":63,"_18854":43197,"_5":12679,"_25963":43169,"_2424":43198},[],"Support",{"_2886":76,"_27469":63,"_18854":43200,"_5":12679,"_25963":43169,"_2424":43201},[],"SLA",{"_2886":77,"_27469":63,"_18854":43203,"_5":12679,"_25963":43169,"_2424":43204},[],"Starter",{"_2886":78,"_27469":63,"_18854":43206,"_5":12679,"_25963":43169,"_2424":43207},[],"Up to 1,000",{"_2886":79,"_27469":63,"_18854":43209,"_5":12679,"_25963":43169,"_2424":43210},[],"Email",{"_2886":80,"_27469":63,"_18854":43212,"_5":12679,"_25963":43169,"_2424":43213},[],"99.5 %",{"_2886":81,"_27469":63,"_18854":43215,"_5":12679,"_25963":43169,"_2424":43216},[],"Professional",{"_2886":82,"_27469":63,"_18854":43218,"_5":12679,"_25963":43169,"_2424":43219},[],"Up to 10,000",{"_2886":83,"_27469":63,"_18854":43221,"_5":12679,"_25963":43169,"_2424":43222},[],"Email and chat",{"_2886":84,"_27469":63,"_18854":43224,"_5":12679,"_25963":43169,"_2424":43225},[],"99.9 %",{"_2886":85,"_27469":63,"_18854":43227,"_5":12679,"_25963":43169,"_2424":43228},[],"Enterprise",{"_2886":86,"_27469":63,"_18854":43230,"_5":12679,"_25963":43169,"_2424":43231},[],"Unlimited",{"_2886":87,"_27469":63,"_18854":43233,"_5":12679,"_25963":43169,"_2424":43234},[],"Dedicated",{"_2886":88,"_27469":63,"_18854":43236,"_5":12679,"_25963":43169,"_2424":43237},[],"99.99 %",{"_2886":89,"_27469":63,"_18854":43239,"_5":12679,"_25963":43173,"_2424":43240},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2886":90,"_27469":63,"_18854":43242,"_5":12679,"_25963":43173,"_2424":43243},[],"When you receive your instance's credentials, continue with Get started.",{"_2886":91,"_27469":91,"_5":13057,"_2424":43245,"_27749":43246,"_18854":43247,"_25963":91},"Fastlane",[43001,43002,43108],[],{"_2886":92,"_27469":91,"_18854":43249,"_5":12679,"_25963":91,"_2424":43250},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2886":93,"_27469":91,"_5":27746,"_18854":43252,"_25963":43253,"_2424":43254},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2886":94,"_27469":91,"_5":27746,"_18854":43256,"_25963":43257,"_2424":43258},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2886":95,"_27469":91,"_5":27746,"_18854":43260,"_25963":43261,"_2424":43011},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#before-you-begin",{"_2886":96,"_27469":91,"_5":27746,"_18854":43263,"_25963":43264,"_2424":43265},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2886":97,"_27469":91,"_5":27746,"_18854":43267,"_25963":43268,"_2424":43269},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2886":98,"_27469":91,"_5":27746,"_18854":43271,"_25963":43272,"_2424":43273},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2886":99,"_27469":91,"_5":27746,"_18854":43275,"_25963":43276,"_2424":43277},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2886":100,"_27469":91,"_5":27746,"_18854":43279,"_25963":43280,"_2424":43281},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2886":101,"_27469":91,"_5":27746,"_18854":43283,"_25963":43284,"_2424":43285},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2886":102,"_27469":91,"_5":27746,"_18854":43287,"_25963":43288,"_2424":43289},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2886":103,"_27469":91,"_18854":43291,"_5":12679,"_25963":43253,"_2424":43292},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2886":104,"_27469":91,"_18854":43294,"_5":12679,"_25963":43253,"_2424":43295},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2886":105,"_27469":91,"_18854":43297,"_5":12679,"_25963":43257,"_2424":43298},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2886":106,"_27469":91,"_18854":43300,"_5":12679,"_25963":43257,"_2424":43301},[],"Fastlane installs or configures",{"_2886":107,"_27469":91,"_18854":43303,"_5":12679,"_25963":43257,"_2424":43304},[],"You still provide",{"_2886":108,"_27469":91,"_18854":43306,"_5":12679,"_25963":43257,"_2424":43307},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2886":109,"_27469":91,"_18854":43309,"_5":12679,"_25963":43257,"_2424":43310},[],"The Kubernetes cluster, nodes and persistent storage",{"_2886":110,"_27469":91,"_18854":43312,"_5":12679,"_25963":43257,"_2424":43313},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2886":111,"_27469":91,"_18854":43315,"_5":12679,"_25963":43257,"_2424":43316},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2886":112,"_27469":91,"_18854":43318,"_5":12679,"_25963":43257,"_2424":43319},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2886":113,"_27469":91,"_18854":43321,"_5":12679,"_25963":43257,"_2424":43322},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2886":114,"_27469":91,"_18854":43324,"_5":12679,"_25963":43257,"_2424":43325},[],"Optional observability and lab HSM components",{"_2886":115,"_27469":91,"_18854":43327,"_5":12679,"_25963":43257,"_2424":43328},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2886":116,"_27469":91,"_18854":43330,"_5":12679,"_25963":43257,"_2424":43331},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2886":117,"_27469":91,"_18854":43333,"_5":12679,"_25963":43261,"_2424":43334},[],"You need:",{"_2886":118,"_27469":91,"_18854":43336,"_5":12679,"_25963":43261,"_2424":43337},[],"an existing Kubernetes cluster",{"_2886":119,"_27469":91,"_18854":43339,"_5":12679,"_25963":43261,"_2424":43340},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2886":120,"_27469":91,"_18854":43342,"_5":12679,"_25963":43261,"_2424":43343},[],"`yq`",{"_2886":121,"_27469":91,"_18854":43345,"_5":12679,"_25963":43261,"_2424":21246},[],{"_2886":122,"_27469":91,"_18854":43347,"_5":12679,"_25963":43261,"_2424":43348},[],"`jq` only when using `--sample-data`",{"_2886":123,"_27469":91,"_18854":43350,"_5":12679,"_25963":43261,"_2424":43351},[],"free external ports 80 and 443 on a single-node K3s host",{"_2886":124,"_27469":91,"_18854":43353,"_5":12679,"_25963":43261,"_2424":43354},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2886":125,"_27469":91,"_18854":43356,"_5":12679,"_25963":43261,"_2424":43357},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2886":126,"_27469":91,"_18854":43359,"_5":12679,"_25963":43264,"_2424":43360},[],"Run the script from a clone of the Helm repository:",{"_2886":127,"_27469":91,"_18854":43362,"_5":12679,"_25963":43264,"_2424":43363},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2886":128,"_27469":91,"_18854":43365,"_5":12679,"_25963":43268,"_2424":43366},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2886":129,"_27469":91,"_18854":43368,"_5":12679,"_25963":43268,"_2424":43369},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2886":130,"_27469":91,"_18854":43371,"_5":12679,"_25963":43268,"_2424":43372},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2886":131,"_27469":91,"_18854":43374,"_5":12679,"_25963":43268,"_2424":43375},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2886":132,"_27469":91,"_18854":43377,"_5":12679,"_25963":43272,"_2424":43378},[],"Option",{"_2886":133,"_27469":91,"_18854":43380,"_5":12679,"_25963":43272,"_2424":43381},[],"Default",{"_2886":134,"_27469":91,"_18854":43383,"_5":12679,"_25963":43272,"_2424":43384},[],"Purpose",{"_2886":135,"_27469":91,"_18854":43386,"_5":12679,"_25963":43272,"_2424":43387},[],"`-h`, `--help`",{"_2886":136,"_27469":91,"_18854":43389,"_5":12679,"_25963":43272,"_2424":43390},[],"—",{"_2886":137,"_27469":91,"_18854":43392,"_5":12679,"_25963":43272,"_2424":43393},[],"Show help",{"_2886":138,"_27469":91,"_18854":43395,"_5":12679,"_25963":43272,"_2424":43396},[],"`-c`, `--context`",{"_2886":139,"_27469":91,"_18854":43398,"_5":12679,"_25963":43272,"_2424":43399},[],"current context",{"_2886":140,"_27469":91,"_18854":43401,"_5":12679,"_25963":43272,"_2424":43402},[],"Select the kubeconfig context for kubectl and Helm",{"_2886":141,"_27469":91,"_18854":43404,"_5":12679,"_25963":43272,"_2424":43405},[],"`-n`, `--non-interactive`",{"_2886":142,"_27469":91,"_18854":43407,"_5":12679,"_25963":43272,"_2424":5412},[],{"_2886":143,"_27469":91,"_18854":43409,"_5":12679,"_25963":43272,"_2424":43410},[],"Skip prompts and generate dependency credentials",{"_2886":144,"_27469":91,"_18854":43412,"_5":12679,"_25963":43272,"_2424":43413},[],"`-ns`, `--namespace`",{"_2886":145,"_27469":91,"_18854":43415,"_5":12679,"_25963":43272,"_2424":43416},[],"`lamassu-dev`",{"_2886":146,"_27469":91,"_18854":43418,"_5":12679,"_25963":43272,"_2424":43419},[],"Namespace for the installation",{"_2886":147,"_27469":91,"_18854":43421,"_5":12679,"_25963":43272,"_2424":43422},[],"`-d`, `--domain`",{"_2886":148,"_27469":91,"_18854":43424,"_5":12679,"_25963":43272,"_2424":43425},[],"`dev.lamassu.io`",{"_2886":149,"_27469":91,"_18854":43427,"_5":12679,"_25963":43272,"_2424":43428},[],"Domain used by the UI, OIDC and certificate",{"_2886":150,"_27469":91,"_18854":43430,"_5":12679,"_25963":43272,"_2424":43431},[],"`-v`, `--version`",{"_2886":151,"_27469":91,"_18854":43433,"_5":12679,"_25963":43272,"_2424":13324},[],{"_2886":152,"_27469":91,"_18854":43435,"_5":12679,"_25963":43272,"_2424":43436},[],"Lamassu chart version",{"_2886":153,"_27469":91,"_18854":43438,"_5":12679,"_25963":43272,"_2424":43439},[],"`--https-port`",{"_2886":154,"_27469":91,"_18854":43441,"_5":12679,"_25963":43272,"_2424":43442},[],"`443`",{"_2886":155,"_27469":91,"_18854":43444,"_5":12679,"_25963":43272,"_2424":43445},[],"Gateway HTTPS listener port",{"_2886":156,"_27469":91,"_18854":43447,"_5":12679,"_25963":43272,"_2424":43448},[],"`--http-port`",{"_2886":157,"_27469":91,"_18854":43450,"_5":12679,"_25963":43272,"_2424":43451},[],"`80`",{"_2886":158,"_27469":91,"_18854":43453,"_5":12679,"_25963":43272,"_2424":43454},[],"Gateway HTTP listener port",{"_2886":159,"_27469":91,"_18854":43456,"_5":12679,"_25963":43272,"_2424":43457},[],"`--tls-crt`",{"_2886":160,"_27469":91,"_18854":43459,"_5":12679,"_25963":43272,"_2424":43390},[],{"_2886":161,"_27469":91,"_18854":43461,"_5":12679,"_25963":43272,"_2424":43462},[],"PEM certificate for downstream TLS",{"_2886":162,"_27469":91,"_18854":43464,"_5":12679,"_25963":43272,"_2424":43465},[],"`--tls-key`",{"_2886":163,"_27469":91,"_18854":43467,"_5":12679,"_25963":43272,"_2424":43390},[],{"_2886":164,"_27469":91,"_18854":43469,"_5":12679,"_25963":43272,"_2424":43470},[],"PEM private key for downstream TLS",{"_2886":165,"_27469":91,"_18854":43472,"_5":12679,"_25963":43272,"_2424":43473},[],"`-l`, `--local-chart-path`",{"_2886":166,"_27469":91,"_18854":43475,"_5":12679,"_25963":43272,"_2424":43476},[],"repository chart",{"_2886":167,"_27469":91,"_18854":43478,"_5":12679,"_25963":43272,"_2424":43479},[],"Use an unpacked local Lamassu chart",{"_2886":168,"_27469":91,"_18854":43481,"_5":12679,"_25963":43272,"_2424":43482},[],"`-ip`, `--gateway-ip`",{"_2886":169,"_27469":91,"_18854":43484,"_5":12679,"_25963":43272,"_2424":7565},[],{"_2886":170,"_27469":91,"_18854":43486,"_5":12679,"_25963":43272,"_2424":43487},[],"Override the address written to `gateway.addresses`",{"_2886":171,"_27469":91,"_18854":43489,"_5":12679,"_25963":43272,"_2424":43490},[],"`--otel`",{"_2886":172,"_27469":91,"_18854":43492,"_5":12679,"_25963":43272,"_2424":5412},[],{"_2886":173,"_27469":91,"_18854":43494,"_5":12679,"_25963":43272,"_2424":43495},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2886":174,"_27469":91,"_18854":43497,"_5":12679,"_25963":43272,"_2424":43498},[],"`--sample-data`",{"_2886":175,"_27469":91,"_18854":43500,"_5":12679,"_25963":43272,"_2424":5412},[],{"_2886":176,"_27469":91,"_18854":43502,"_5":12679,"_25963":43272,"_2424":43503},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2886":177,"_27469":91,"_18854":43505,"_5":12679,"_25963":43272,"_2424":43506},[],"`--with-hsm`",{"_2886":178,"_27469":91,"_18854":43508,"_5":12679,"_25963":43272,"_2424":5412},[],{"_2886":179,"_27469":91,"_18854":43510,"_5":12679,"_25963":43272,"_2424":43511},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2886":180,"_27469":91,"_18854":43513,"_5":12679,"_25963":43272,"_2424":43514},[],"`--softhsm-chart-path`",{"_2886":181,"_27469":91,"_18854":43516,"_5":12679,"_25963":43272,"_2424":43517},[],"`./charts/softhsm`",{"_2886":182,"_27469":91,"_18854":43519,"_5":12679,"_25963":43272,"_2424":43520},[],"Use a different local SoftHSM chart",{"_2886":183,"_27469":91,"_18854":43522,"_5":12679,"_25963":43272,"_2424":43523},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2886":184,"_27469":91,"_18854":43525,"_5":12679,"_25963":43276,"_2424":43526},[],"Fastlane:",{"_2886":185,"_27469":91,"_18854":43528,"_5":12679,"_25963":43276,"_2424":43529},[],"validates local tools and the selected cluster",{"_2886":186,"_27469":91,"_18854":43531,"_5":12679,"_25963":43276,"_2424":43532},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2886":187,"_27469":91,"_18854":43534,"_5":12679,"_25963":43276,"_2424":43535},[],"creates the namespace",{"_2886":188,"_27469":91,"_18854":43537,"_5":12679,"_25963":43276,"_2424":43538},[],"installs PostgreSQL and creates the required databases",{"_2886":189,"_27469":91,"_18854":43540,"_5":12679,"_25963":43276,"_2424":43541},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2886":190,"_27469":91,"_18854":43543,"_5":12679,"_25963":43276,"_2424":43544},[],"installs RabbitMQ",{"_2886":191,"_27469":91,"_18854":43546,"_5":12679,"_25963":43276,"_2424":43547},[],"optionally installs observability and lab HSM components",{"_2886":192,"_27469":91,"_18854":43549,"_5":12679,"_25963":43276,"_2424":43550},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2886":193,"_27469":91,"_18854":43552,"_5":12679,"_25963":43276,"_2424":43553},[],"optionally loads sample data",{"_2886":194,"_27469":91,"_18854":43555,"_5":12679,"_25963":43276,"_2424":43556},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2886":195,"_27469":91,"_18854":43558,"_5":12679,"_25963":43280,"_2424":43559},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2886":196,"_27469":91,"_18854":43561,"_5":12679,"_25963":43280,"_2424":43562},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2886":197,"_27469":91,"_18854":43564,"_5":12679,"_25963":43284,"_2424":43565},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2886":198,"_27469":91,"_18854":43567,"_5":12679,"_25963":43284,"_2424":43568},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2886":199,"_27469":91,"_18854":43570,"_5":12679,"_25963":43284,"_2424":43571},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2886":200,"_27469":91,"_18854":43573,"_5":12679,"_25963":43288,"_2424":43574},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2886":201,"_27469":201,"_5":13057,"_2424":43576,"_27749":43577,"_18854":43578,"_25963":201},"Install with Helm",[43001,43002,43108],[],{"_2886":202,"_27469":201,"_18854":43580,"_5":12679,"_25963":201,"_2424":43581},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2886":203,"_27469":201,"_5":27746,"_18854":43583,"_25963":43584,"_2424":43585},[],"/docs/pr-preview/pr-24/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2886":204,"_27469":201,"_5":27746,"_18854":43587,"_25963":43588,"_2424":43011},[],"/docs/pr-preview/pr-24/deployment/self-hosted/helm#before-you-begin",{"_2886":205,"_27469":201,"_5":27746,"_18854":43590,"_25963":43591,"_2424":43592},[],"/docs/pr-preview/pr-24/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2886":206,"_27469":201,"_5":27746,"_18854":43594,"_25963":43595,"_2424":43596},[],"/docs/pr-preview/pr-24/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2886":207,"_27469":201,"_5":27746,"_18854":43598,"_25963":43599,"_2424":43600},[],"/docs/pr-preview/pr-24/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2886":208,"_27469":201,"_5":27746,"_18854":43602,"_25963":43603,"_2424":43604},[],"/docs/pr-preview/pr-24/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2886":209,"_27469":201,"_5":27746,"_18854":43606,"_25963":43607,"_2424":43608},[],"/docs/pr-preview/pr-24/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2886":210,"_27469":201,"_5":27746,"_18854":43610,"_25963":43611,"_2424":43612},[],"/docs/pr-preview/pr-24/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2886":211,"_27469":201,"_5":27746,"_18854":43614,"_25963":43615,"_2424":43616},[],"/docs/pr-preview/pr-24/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2886":212,"_27469":201,"_18854":43618,"_5":12679,"_25963":43584,"_2424":43619},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2886":213,"_27469":201,"_18854":43621,"_5":12679,"_25963":43588,"_2424":43622},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2886":214,"_27469":201,"_18854":43624,"_5":12679,"_25963":43588,"_2424":43625},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2886":215,"_27469":201,"_18854":43627,"_5":12679,"_25963":43588,"_2424":43628},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2886":216,"_27469":201,"_18854":43630,"_5":12679,"_25963":43588,"_2424":43631},[],"a reachable RabbitMQ broker and credentials",{"_2886":217,"_27469":201,"_18854":43633,"_5":12679,"_25963":43588,"_2424":43634},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2886":218,"_27469":201,"_18854":43636,"_5":12679,"_25963":43588,"_2424":43637},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2886":219,"_27469":201,"_18854":43639,"_5":12679,"_25963":43588,"_2424":43640},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2886":220,"_27469":201,"_18854":43642,"_5":12679,"_25963":43588,"_2424":43643},[],"a StorageClass and an external traffic design",{"_2886":221,"_27469":201,"_18854":43645,"_5":12679,"_25963":43588,"_2424":43646},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2886":222,"_27469":201,"_18854":43648,"_5":12679,"_25963":43588,"_2424":43649},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2886":223,"_27469":201,"_18854":43651,"_5":12679,"_25963":43588,"_2424":43652},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2886":224,"_27469":201,"_18854":43654,"_5":12679,"_25963":43591,"_2424":43655},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2886":225,"_27469":201,"_18854":43657,"_5":12679,"_25963":43591,"_2424":43658},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2886":226,"_27469":201,"_18854":43660,"_5":12679,"_25963":43591,"_2424":43661},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2886":227,"_27469":201,"_18854":43663,"_5":12679,"_25963":43595,"_2424":43664},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2886":228,"_27469":201,"_18854":43666,"_5":12679,"_25963":43595,"_2424":43667},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2886":229,"_27469":201,"_18854":43669,"_5":12679,"_25963":43595,"_2424":43670},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2886":230,"_27469":201,"_18854":43672,"_5":12679,"_25963":43599,"_2424":43673},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2886":231,"_27469":201,"_18854":43675,"_5":12679,"_25963":43603,"_2424":43676},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2886":232,"_27469":201,"_18854":43678,"_5":12679,"_25963":43603,"_2424":43679},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2886":233,"_27469":201,"_18854":43681,"_5":12679,"_25963":43603,"_2424":43682},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2886":234,"_27469":201,"_18854":43684,"_5":12679,"_25963":43603,"_2424":43685},[],"See Access control for the principal and policy model.",{"_2886":235,"_27469":201,"_18854":43687,"_5":12679,"_25963":43607,"_2424":43688},[],"To install a local checkout instead:",{"_2886":236,"_27469":201,"_18854":43690,"_5":12679,"_25963":43611,"_2424":43691},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2886":237,"_27469":201,"_18854":43693,"_5":12679,"_25963":43611,"_2424":43694},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2886":238,"_27469":201,"_18854":43696,"_5":12679,"_25963":43615,"_2424":43697},[],"Before going live, review:",{"_2886":239,"_27469":201,"_18854":43699,"_5":12679,"_25963":43615,"_2424":43700},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2886":240,"_27469":201,"_18854":43702,"_5":12679,"_25963":43615,"_2424":43703},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2886":241,"_27469":201,"_18854":43705,"_5":12679,"_25963":43615,"_2424":43706},[],"shared VA storage before increasing VA replicas",{"_2886":242,"_27469":201,"_18854":43708,"_5":12679,"_25963":43615,"_2424":43709},[],"managed OIDC roles and removal of evaluation credentials",{"_2886":243,"_27469":201,"_18854":43711,"_5":12679,"_25963":43615,"_2424":43712},[],"a trusted TLS issuer or externally managed certificate",{"_2886":244,"_27469":201,"_18854":43714,"_5":12679,"_25963":43615,"_2424":43715},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2886":245,"_27469":201,"_18854":43717,"_5":12679,"_25963":43615,"_2424":43718},[],"SMTP, observability and alert delivery",{"_2886":246,"_27469":201,"_18854":43720,"_5":12679,"_25963":43615,"_2424":43721},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2886":247,"_27469":201,"_18854":43723,"_5":12679,"_25963":43615,"_2424":43724},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2886":248,"_27469":248,"_5":13057,"_2424":43726,"_27749":43727,"_18854":43728,"_25963":248},"Expose the Gateway",[43001,43002,43108],[],{"_2886":249,"_27469":248,"_18854":43730,"_5":12679,"_25963":248,"_2424":43731},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2886":250,"_27469":248,"_5":27746,"_18854":43733,"_25963":43734,"_2424":43735},[],"/docs/pr-preview/pr-24/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2886":251,"_27469":248,"_5":27746,"_18854":43737,"_25963":43738,"_2424":43739},[],"/docs/pr-preview/pr-24/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2886":252,"_27469":248,"_5":27746,"_18854":43741,"_25963":43742,"_2424":43743},[],"/docs/pr-preview/pr-24/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2886":253,"_27469":248,"_5":27746,"_18854":43745,"_25963":43746,"_2424":43747},[],"/docs/pr-preview/pr-24/deployment/self-hosted/networking#k3s","K3s",{"_2886":254,"_27469":248,"_5":27746,"_18854":43749,"_25963":43750,"_2424":43751},[],"/docs/pr-preview/pr-24/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2886":255,"_27469":248,"_5":27746,"_18854":43753,"_25963":43754,"_2424":43755},[],"/docs/pr-preview/pr-24/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2886":256,"_27469":248,"_5":27746,"_18854":43757,"_25963":43758,"_2424":43759},[],"/docs/pr-preview/pr-24/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2886":257,"_27469":248,"_5":27746,"_18854":43761,"_25963":43762,"_2424":43763},[],"/docs/pr-preview/pr-24/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2886":258,"_27469":248,"_5":27746,"_18854":43765,"_25963":43766,"_2424":43767},[],"/docs/pr-preview/pr-24/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2886":259,"_27469":248,"_18854":43769,"_5":12679,"_25963":43734,"_2424":43770},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2886":260,"_27469":248,"_18854":43772,"_5":12679,"_25963":43734,"_2424":43773},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2886":261,"_27469":248,"_18854":43775,"_5":12679,"_25963":43738,"_2424":43776},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2886":262,"_27469":248,"_18854":43778,"_5":12679,"_25963":43738,"_2424":43779},[],"Set it only when:",{"_2886":263,"_27469":248,"_18854":43781,"_5":12679,"_25963":43738,"_2424":43782},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2886":264,"_27469":248,"_18854":43784,"_5":12679,"_25963":43738,"_2424":43785},[],"that address is allocated to this Gateway",{"_2886":265,"_27469":248,"_18854":43787,"_5":12679,"_25963":43738,"_2424":43788},[],"the surrounding network already routes traffic for it to the cluster",{"_2886":266,"_27469":248,"_18854":43790,"_5":12679,"_25963":43738,"_2424":43791},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2886":267,"_27469":248,"_18854":43793,"_5":12679,"_25963":43738,"_2424":43794},[],"Keep these two settings separate:",{"_2886":268,"_27469":248,"_18854":43796,"_5":12679,"_25963":43738,"_2424":43797},[],"`gateway.addresses` requests an address for the Gateway.",{"_2886":269,"_27469":248,"_18854":43799,"_5":12679,"_25963":43738,"_2424":43800},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2886":270,"_27469":248,"_18854":43802,"_5":12679,"_25963":43738,"_2424":43803},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2886":271,"_27469":248,"_18854":43805,"_5":12679,"_25963":43742,"_2424":43806},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2886":272,"_27469":248,"_18854":43808,"_5":12679,"_25963":43742,"_2424":43809},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2886":273,"_27469":248,"_18854":43811,"_5":12679,"_25963":43746,"_2424":43812},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2886":274,"_27469":248,"_18854":43814,"_5":12679,"_25963":43746,"_2424":43815},[],"For the recommended design:",{"_2886":275,"_27469":248,"_18854":43817,"_5":12679,"_25963":43746,"_2424":43818},[],"Use only one externally exposed Lamassu Gateway.",{"_2886":276,"_27469":248,"_18854":43820,"_5":12679,"_25963":43746,"_2424":43821},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2886":277,"_27469":248,"_18854":43823,"_5":12679,"_25963":43746,"_2424":43824},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2886":278,"_27469":248,"_18854":43826,"_5":12679,"_25963":43746,"_2424":43827},[],"Point DNS at the VM's reachable address.",{"_2886":279,"_27469":248,"_18854":43829,"_5":12679,"_25963":43746,"_2424":43830},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2886":280,"_27469":248,"_18854":43832,"_5":12679,"_25963":43750,"_2424":43833},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2886":281,"_27469":248,"_18854":43835,"_5":12679,"_25963":43754,"_2424":43836},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2886":282,"_27469":248,"_18854":43838,"_5":12679,"_25963":43754,"_2424":43839},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2886":283,"_27469":248,"_18854":43841,"_5":12679,"_25963":43758,"_2424":43842},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2886":284,"_27469":248,"_18854":43844,"_5":12679,"_25963":43758,"_2424":43845},[],"Requirement",{"_2886":285,"_27469":248,"_18854":43847,"_5":12679,"_25963":43758,"_2424":43848},[],"Recommended design",{"_2886":286,"_27469":248,"_18854":43850,"_5":12679,"_25963":43758,"_2424":43851},[],"Consequence",{"_2886":287,"_27469":248,"_18854":43853,"_5":12679,"_25963":43758,"_2424":43854},[],"Several Lamassu URLs or services",{"_2886":288,"_27469":248,"_18854":43856,"_5":12679,"_25963":43758,"_2424":43857},[],"One Gateway with multiple routes",{"_2886":289,"_27469":248,"_18854":43859,"_5":12679,"_25963":43758,"_2424":43860},[],"One IP and one proxy fleet; this is the chart default",{"_2886":290,"_27469":248,"_18854":43862,"_5":12679,"_25963":43758,"_2424":43863},[],"Independent Gateways and separate external IPs",{"_2886":291,"_27469":248,"_18854":43865,"_5":12679,"_25963":43758,"_2424":43866},[],"One VIP per Gateway",{"_2886":292,"_27469":248,"_18854":43868,"_5":12679,"_25963":43758,"_2424":43869},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2886":293,"_27469":248,"_18854":43871,"_5":12679,"_25963":43758,"_2424":43872},[],"Independent Gateways on one node and one IP",{"_2886":294,"_27469":248,"_18854":43874,"_5":12679,"_25963":43758,"_2424":43875},[],"Use different external ports",{"_2886":295,"_27469":248,"_18854":43877,"_5":12679,"_25963":43758,"_2424":43878},[],"Clients must include non-standard ports",{"_2886":296,"_27469":248,"_18854":43880,"_5":12679,"_25963":43758,"_2424":43881},[],"Separate TLS/mTLS termination behind one IP",{"_2886":297,"_27469":248,"_18854":43883,"_5":12679,"_25963":43758,"_2424":43884},[],"Front-door SNI routing to internal Gateways",{"_2886":298,"_27469":248,"_18854":43886,"_5":12679,"_25963":43758,"_2424":43887},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2886":299,"_27469":248,"_18854":43889,"_5":12679,"_25963":43758,"_2424":43890},[],"Separate Gateway resources but shared proxy infrastructure",{"_2886":300,"_27469":248,"_18854":43892,"_5":12679,"_25963":43758,"_2424":43893},[],"Envoy merged-Gateway mode",{"_2886":301,"_27469":248,"_18854":43895,"_5":12679,"_25963":43758,"_2424":43896},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2886":302,"_27469":248,"_18854":43898,"_5":12679,"_25963":43758,"_2424":43899},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2886":303,"_27469":248,"_18854":43901,"_5":12679,"_25963":43758,"_2424":43902},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2886":304,"_27469":248,"_18854":43904,"_5":12679,"_25963":43758,"_2424":43905},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2886":305,"_27469":248,"_18854":43907,"_5":12679,"_25963":43758,"_2424":43908},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2886":306,"_27469":248,"_18854":43910,"_5":12679,"_25963":43762,"_2424":43911},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2886":307,"_27469":248,"_18854":43913,"_5":12679,"_25963":43762,"_2424":43914},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2886":308,"_27469":248,"_18854":43916,"_5":12679,"_25963":43762,"_2424":43917},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2886":309,"_27469":248,"_18854":43919,"_5":12679,"_25963":43762,"_2424":43920},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2886":310,"_27469":248,"_18854":43922,"_5":12679,"_25963":43762,"_2424":43923},[],"If none of those are possible, use different external ports or change the external network design.",{"_2886":311,"_27469":248,"_18854":43925,"_5":12679,"_25963":43766,"_2424":43926},[],"Check, in order:",{"_2886":312,"_27469":248,"_18854":43928,"_5":12679,"_25963":43766,"_2424":43929},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2886":313,"_27469":248,"_18854":43931,"_5":12679,"_25963":43766,"_2424":43932},[],"Its status contains the expected address.",{"_2886":314,"_27469":248,"_18854":43934,"_5":12679,"_25963":43766,"_2424":43935},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2886":315,"_27469":248,"_18854":43937,"_5":12679,"_25963":43766,"_2424":43938},[],"Port 443 reaches that address from the client network.",{"_2886":316,"_27469":248,"_18854":43940,"_5":12679,"_25963":43766,"_2424":43941},[],"DNS resolves to the externally reachable endpoint.",{"_2886":317,"_27469":248,"_18854":43943,"_5":12679,"_25963":43766,"_2424":43944},[],"The certificate contains the DNS name or IP used by the client.",{"_2886":318,"_27469":248,"_18854":43946,"_5":12679,"_25963":43766,"_2424":43947},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2886":319,"_27469":319,"_5":13057,"_2424":43108,"_27749":43949,"_18854":43950,"_25963":319},[43001,43002,43108],[],{"_2886":320,"_27469":319,"_18854":43952,"_5":12679,"_25963":319,"_2424":43953},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2886":321,"_27469":319,"_5":27746,"_18854":43955,"_25963":43956,"_2424":43957},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2886":322,"_27469":319,"_5":27746,"_18854":43959,"_25963":43960,"_2424":43961},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2886":323,"_27469":319,"_5":27746,"_18854":43963,"_25963":43964,"_2424":43965},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2886":324,"_27469":319,"_5":27746,"_18854":43967,"_25963":43968,"_2424":43969},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2886":325,"_27469":319,"_5":27746,"_18854":43971,"_25963":43972,"_2424":43973},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2886":326,"_27469":319,"_5":27746,"_18854":43975,"_25963":43976,"_2424":43977},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2886":327,"_27469":319,"_18854":43979,"_5":12679,"_25963":43956,"_2424":43980},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2886":328,"_27469":319,"_18854":43982,"_5":12679,"_25963":43960,"_2424":43983},[],"Workflow",{"_2886":329,"_27469":319,"_18854":43985,"_5":12679,"_25963":43960,"_2424":43986},[],"Use it for",{"_2886":330,"_27469":319,"_18854":43988,"_5":12679,"_25963":43960,"_2424":43989},[],"What it installs",{"_2886":331,"_27469":319,"_18854":43991,"_5":12679,"_25963":43960,"_2424":43992},[],"Helm",{"_2886":332,"_27469":319,"_18854":43994,"_5":12679,"_25963":43960,"_2424":43995},[],"Production and controlled environments",{"_2886":333,"_27469":319,"_18854":43997,"_5":12679,"_25963":43960,"_2424":43998},[],"Lamassu services and Gateway API resources",{"_2886":334,"_27469":319,"_18854":44000,"_5":12679,"_25963":43960,"_2424":43245},[],{"_2886":335,"_27469":319,"_18854":44002,"_5":12679,"_25963":43960,"_2424":44003},[],"Evaluation, demos, CI and small lab clusters",{"_2886":336,"_27469":319,"_18854":44005,"_5":12679,"_25963":43960,"_2424":44006},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2886":337,"_27469":319,"_18854":44008,"_5":12679,"_25963":43964,"_2424":44009},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2886":338,"_27469":319,"_18854":44011,"_5":12679,"_25963":43964,"_2424":44012},[],"Area",{"_2886":339,"_27469":319,"_18854":44014,"_5":12679,"_25963":43964,"_2424":44015},[],"The Lamassu chart provides",{"_2886":340,"_27469":319,"_18854":44017,"_5":12679,"_25963":43964,"_2424":44018},[],"You provide",{"_2886":341,"_27469":319,"_18854":44020,"_5":12679,"_25963":43964,"_2424":44021},[],"Lamassu applications",{"_2886":342,"_27469":319,"_18854":44023,"_5":12679,"_25963":43964,"_2424":44024},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2886":343,"_27469":319,"_18854":44026,"_5":12679,"_25963":43964,"_2424":44027},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2886":344,"_27469":319,"_18854":44029,"_5":12679,"_25963":43964,"_2424":44030},[],"PostgreSQL data",{"_2886":345,"_27469":319,"_18854":44032,"_5":12679,"_25963":43964,"_2424":44033},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2886":346,"_27469":319,"_18854":44035,"_5":12679,"_25963":43964,"_2424":44036},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2886":347,"_27469":319,"_18854":44038,"_5":12679,"_25963":43964,"_2424":44039},[],"Messaging",{"_2886":348,"_27469":319,"_18854":44041,"_5":12679,"_25963":43964,"_2424":44042},[],"RabbitMQ connection configuration for the Lamassu services",{"_2886":349,"_27469":319,"_18854":44044,"_5":12679,"_25963":43964,"_2424":44045},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2886":350,"_27469":319,"_18854":44047,"_5":12679,"_25963":43964,"_2424":44048},[],"Identity",{"_2886":351,"_27469":319,"_18854":44050,"_5":12679,"_25963":43964,"_2424":44051},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2886":352,"_27469":319,"_18854":44053,"_5":12679,"_25963":43964,"_2424":44054},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2886":353,"_27469":319,"_18854":44056,"_5":12679,"_25963":43964,"_2424":44057},[],"External routing",{"_2886":354,"_27469":319,"_18854":44059,"_5":12679,"_25963":43964,"_2424":44060},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2886":355,"_27469":319,"_18854":44062,"_5":12679,"_25963":43964,"_2424":44063},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2886":356,"_27469":319,"_18854":44065,"_5":12679,"_25963":43964,"_2424":44066},[],"TLS",{"_2886":357,"_27469":319,"_18854":44068,"_5":12679,"_25963":43964,"_2424":44069},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2886":358,"_27469":319,"_18854":44071,"_5":12679,"_25963":43964,"_2424":44072},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2886":359,"_27469":319,"_18854":44074,"_5":12679,"_25963":43964,"_2424":44075},[],"Persistent application data",{"_2886":360,"_27469":319,"_18854":44077,"_5":12679,"_25963":43964,"_2424":44078},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2886":361,"_27469":319,"_18854":44080,"_5":12679,"_25963":43964,"_2424":44081},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2886":362,"_27469":319,"_18854":44083,"_5":12679,"_25963":43964,"_2424":44084},[],"Optional integrations",{"_2886":363,"_27469":319,"_18854":44086,"_5":12679,"_25963":43964,"_2424":44087},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2886":364,"_27469":319,"_18854":44089,"_5":12679,"_25963":43964,"_2424":44090},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2886":365,"_27469":319,"_18854":44092,"_5":12679,"_25963":43964,"_2424":44093},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2886":366,"_27469":319,"_18854":44095,"_5":12679,"_25963":43964,"_2424":44096},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2886":367,"_27469":319,"_18854":44098,"_5":12679,"_25963":43968,"_2424":44099},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2886":368,"_27469":319,"_18854":44101,"_5":12679,"_25963":43968,"_2424":44102},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2886":369,"_27469":319,"_18854":44104,"_5":12679,"_25963":43972,"_2424":44105},[],"Kubernetes 1.24 or newer",{"_2886":370,"_27469":319,"_18854":44107,"_5":12679,"_25963":43972,"_2424":44108},[],"Helm 3.2 or newer",{"_2886":371,"_27469":319,"_18854":44110,"_5":12679,"_25963":43972,"_2424":44111},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2886":372,"_27469":319,"_18854":44113,"_5":12679,"_25963":43972,"_2424":44114},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2886":373,"_27469":319,"_18854":44116,"_5":12679,"_25963":43972,"_2424":44117},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2886":374,"_27469":319,"_18854":44119,"_5":12679,"_25963":43972,"_2424":44120},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2886":375,"_27469":319,"_18854":44122,"_5":12679,"_25963":43972,"_2424":44123},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2886":376,"_27469":319,"_18854":44125,"_5":12679,"_25963":43976,"_2424":44126},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2886":377,"_27469":319,"_18854":44128,"_5":12679,"_25963":43976,"_2424":44129},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2886":378,"_27469":319,"_18854":44131,"_5":12679,"_25963":43976,"_2424":44132},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2886":379,"_27469":379,"_5":13057,"_2424":44134,"_27749":44135,"_18854":44138,"_25963":379},"Access control",[43001,44136,44137],"Platform","Administer Lamassu",[],{"_2886":380,"_27469":379,"_18854":44140,"_5":12679,"_25963":379,"_2424":44141},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2886":381,"_27469":379,"_5":27746,"_18854":44143,"_25963":44144,"_2424":44145},[],"/docs/pr-preview/pr-24/platform/pki/access-control#essential-concepts","Essential concepts",{"_2886":382,"_27469":379,"_5":27746,"_18854":44147,"_25963":44148,"_2424":44149},[],"/docs/pr-preview/pr-24/platform/pki/access-control#two-decision-systems","Two decision systems",{"_2886":383,"_27469":379,"_5":27746,"_18854":44151,"_25963":44152,"_2424":44153},[],"/docs/pr-preview/pr-24/platform/pki/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2886":384,"_27469":379,"_5":27746,"_18854":44155,"_25963":44156,"_2424":44157},[],"/docs/pr-preview/pr-24/platform/pki/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2886":385,"_27469":379,"_5":27746,"_18854":44159,"_25963":44160,"_2424":44161},[],"/docs/pr-preview/pr-24/platform/pki/access-control#how-the-two-paths-relate","How the two paths relate",{"_2886":386,"_27469":379,"_5":27746,"_18854":44163,"_25963":44164,"_2424":44165},[],"/docs/pr-preview/pr-24/platform/pki/access-control#oidc-principals","OIDC principals",{"_2886":387,"_27469":379,"_5":27746,"_18854":44167,"_25963":44168,"_2424":44169},[],"/docs/pr-preview/pr-24/platform/pki/access-control#x509-principals","X.509 principals",{"_2886":388,"_27469":379,"_5":27746,"_18854":44171,"_25963":44172,"_2424":44173},[],"/docs/pr-preview/pr-24/platform/pki/access-control#when-several-principals-match","When several principals match",{"_2886":389,"_27469":379,"_5":27746,"_18854":44175,"_25963":44176,"_2424":44177},[],"/docs/pr-preview/pr-24/platform/pki/access-control#how-policies-express-access","How policies express access",{"_2886":390,"_27469":379,"_5":27746,"_18854":44179,"_25963":44180,"_2424":44181},[],"/docs/pr-preview/pr-24/platform/pki/access-control#global-and-direct-access","Global and direct access",{"_2886":391,"_27469":379,"_5":27746,"_18854":44183,"_25963":44184,"_2424":44185},[],"/docs/pr-preview/pr-24/platform/pki/access-control#access-inherited-through-relations","Access inherited through relations",{"_2886":392,"_27469":379,"_5":27746,"_18854":44187,"_25963":44188,"_2424":44189},[],"/docs/pr-preview/pr-24/platform/pki/access-control#attribute-filtered-access","Attribute-filtered access",{"_2886":393,"_27469":379,"_5":27746,"_18854":44191,"_25963":44192,"_2424":44193},[],"/docs/pr-preview/pr-24/platform/pki/access-control#http-rules","HTTP rules",{"_2886":394,"_27469":379,"_5":27746,"_18854":44195,"_25963":44196,"_2424":44197},[],"/docs/pr-preview/pr-24/platform/pki/access-control#included-policies","Included policies",{"_2886":395,"_27469":379,"_5":27746,"_18854":44199,"_25963":44200,"_2424":43604},[],"/docs/pr-preview/pr-24/platform/pki/access-control#provision-the-first-administrator",{"_2886":396,"_27469":379,"_5":27746,"_18854":44202,"_25963":44203,"_2424":44204},[],"/docs/pr-preview/pr-24/platform/pki/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2886":397,"_27469":379,"_5":27746,"_18854":44206,"_25963":44207,"_2424":44208},[],"/docs/pr-preview/pr-24/platform/pki/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2886":398,"_27469":379,"_5":27746,"_18854":44210,"_25963":44211,"_2424":44212},[],"/docs/pr-preview/pr-24/platform/pki/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2886":399,"_27469":379,"_5":27746,"_18854":44214,"_25963":44215,"_2424":44216},[],"/docs/pr-preview/pr-24/platform/pki/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2886":400,"_27469":379,"_5":27746,"_18854":44218,"_25963":44219,"_2424":44220},[],"/docs/pr-preview/pr-24/platform/pki/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2886":401,"_27469":379,"_5":27746,"_18854":44222,"_25963":44223,"_2424":44224},[],"/docs/pr-preview/pr-24/platform/pki/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2886":402,"_27469":379,"_5":27746,"_18854":44226,"_25963":44227,"_2424":44228},[],"/docs/pr-preview/pr-24/platform/pki/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2886":403,"_27469":379,"_5":27746,"_18854":44230,"_25963":44231,"_2424":44232},[],"/docs/pr-preview/pr-24/platform/pki/access-control#changes-and-access-revocation","Changes and access revocation",{"_2886":404,"_27469":379,"_5":27746,"_18854":44234,"_25963":44235,"_2424":44236},[],"/docs/pr-preview/pr-24/platform/pki/access-control#operational-checklist","Operational checklist",{"_2886":405,"_27469":379,"_5":27746,"_18854":44238,"_25963":44239,"_2424":44240},[],"/docs/pr-preview/pr-24/platform/pki/access-control#diagnostics","Diagnostics",{"_2886":406,"_27469":379,"_5":27746,"_18854":44242,"_25963":44243,"_2424":44244},[],"/docs/pr-preview/pr-24/platform/pki/access-control#the-response-is-401","The response is 401",{"_2886":407,"_27469":379,"_5":27746,"_18854":44246,"_25963":44247,"_2424":44248},[],"/docs/pr-preview/pr-24/platform/pki/access-control#the-response-is-403","The response is 403",{"_2886":408,"_27469":379,"_5":27746,"_18854":44250,"_25963":44251,"_2424":44252},[],"/docs/pr-preview/pr-24/platform/pki/access-control#everything-returns-403","Everything returns 403",{"_2886":409,"_27469":379,"_5":27746,"_18854":44254,"_25963":44255,"_2424":44256},[],"/docs/pr-preview/pr-24/platform/pki/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2886":410,"_27469":379,"_18854":44258,"_5":12679,"_25963":379,"_2424":44259},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2886":411,"_27469":379,"_18854":44261,"_5":12679,"_25963":379,"_2424":44262},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2886":412,"_27469":379,"_18854":44264,"_5":12679,"_25963":379,"_2424":44265},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2886":413,"_27469":379,"_18854":44267,"_5":12679,"_25963":44144,"_2424":44268},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2886":414,"_27469":379,"_18854":44270,"_5":12679,"_25963":44144,"_2424":44271},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2886":415,"_27469":379,"_18854":44273,"_5":12679,"_25963":44144,"_2424":44274},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2886":416,"_27469":379,"_18854":44276,"_5":12679,"_25963":44144,"_2424":44277},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2886":417,"_27469":379,"_18854":44279,"_5":12679,"_25963":44144,"_2424":44280},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2886":418,"_27469":379,"_18854":44282,"_5":12679,"_25963":44144,"_2424":44283},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and one of its policies must allow the requested operation.",{"_2886":419,"_27469":379,"_18854":44285,"_5":12679,"_25963":44148,"_2424":44286},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2886":420,"_27469":379,"_18854":44288,"_5":12679,"_25963":44148,"_2424":44289},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2886":421,"_27469":379,"_18854":44291,"_5":12679,"_25963":44152,"_2424":44292},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2886":422,"_27469":379,"_18854":44294,"_5":12679,"_25963":44152,"_2424":44295},[],"The decision is made **before forwarding the request to the service**:",{"_2886":423,"_27469":379,"_18854":44297,"_5":12679,"_25963":44152,"_2424":44298},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2886":424,"_27469":379,"_18854":44300,"_5":12679,"_25963":44152,"_2424":44301},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2886":425,"_27469":379,"_18854":44303,"_5":12679,"_25963":44152,"_2424":44304},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2886":426,"_27469":379,"_18854":44306,"_5":12679,"_25963":44152,"_2424":44307},[],"It separately loads the policies granted to each principal.",{"_2886":427,"_27469":379,"_18854":44309,"_5":12679,"_25963":44152,"_2424":44310},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2886":428,"_27469":379,"_18854":44312,"_5":12679,"_25963":44152,"_2424":44313},[],"`authz` looks for an HTTP rule granting that action.",{"_2886":429,"_27469":379,"_18854":44315,"_5":12679,"_25963":44152,"_2424":44316},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy.",{"_2886":430,"_27469":379,"_18854":44318,"_5":12679,"_25963":44152,"_2424":44319},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2886":431,"_27469":379,"_18854":44321,"_5":12679,"_25963":44152,"_2424":44322},[],"When it allows access, `authz` returns the selected principal in `x-current-user`. The Gateway can propagate that header to the service to preserve the identity context.",{"_2886":432,"_27469":379,"_18854":44324,"_5":12679,"_25963":44152,"_2424":44325},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, the schema must declare a constraint relating a request value to a normalized attribute of the principal.",{"_2886":433,"_27469":379,"_18854":44327,"_5":12679,"_25963":44156,"_2424":44328},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2886":434,"_27469":379,"_18854":44330,"_5":12679,"_25963":44156,"_2424":44331},[],"The decision is made with the domain operation context:",{"_2886":435,"_27469":379,"_18854":44333,"_5":12679,"_25963":44156,"_2424":44334},[],"The middleware extracts the credential and resolves the matching principals.",{"_2886":436,"_27469":379,"_18854":44336,"_5":12679,"_25963":44156,"_2424":44337},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2886":437,"_27469":379,"_18854":44339,"_5":12679,"_25963":44156,"_2424":44340},[],"`authz` gathers the entity rules of the granted policies.",{"_2886":438,"_27469":379,"_18854":44342,"_5":12679,"_25963":44156,"_2424":44343},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2886":439,"_27469":379,"_18854":44345,"_5":12679,"_25963":44156,"_2424":44346},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2886":440,"_27469":379,"_18854":44348,"_5":12679,"_25963":44156,"_2424":44349},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2886":441,"_27469":379,"_18854":44351,"_5":12679,"_25963":44156,"_2424":44352},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2886":442,"_27469":379,"_18854":44354,"_5":12679,"_25963":44156,"_2424":44355},[],"Actions fall into two groups:",{"_2886":443,"_27469":379,"_18854":44357,"_5":12679,"_25963":44156,"_2424":44358},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2886":444,"_27469":379,"_18854":44360,"_5":12679,"_25963":44156,"_2424":44361},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2886":445,"_27469":379,"_18854":44363,"_5":12679,"_25963":44156,"_2424":44364},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2886":446,"_27469":379,"_18854":44366,"_5":12679,"_25963":44160,"_2424":44367},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2886":447,"_27469":379,"_18854":44369,"_5":12679,"_25963":44160,"_2424":44370},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2886":448,"_27469":379,"_18854":44372,"_5":12679,"_25963":44160,"_2424":44373},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it. Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2886":449,"_27469":379,"_18854":44375,"_5":12679,"_25963":44164,"_2424":44376},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2886":450,"_27469":379,"_18854":44378,"_5":12679,"_25963":44164,"_2424":44379},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2886":451,"_27469":379,"_18854":44381,"_5":12679,"_25963":44164,"_2424":44382},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2886":452,"_27469":379,"_18854":44384,"_5":12679,"_25963":44164,"_2424":44385},[],"The implemented operators are:",{"_2886":453,"_27469":379,"_18854":44387,"_5":12679,"_25963":44164,"_2424":44388},[],"`equals`, for exact equality;",{"_2886":454,"_27469":379,"_18854":44390,"_5":12679,"_25963":44164,"_2424":44391},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2886":455,"_27469":379,"_18854":44393,"_5":12679,"_25963":44164,"_2424":44394},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2886":456,"_27469":379,"_18854":44396,"_5":12679,"_25963":44164,"_2424":44397},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2886":457,"_27469":379,"_18854":44399,"_5":12679,"_25963":44168,"_2424":44400},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2886":458,"_27469":379,"_18854":44402,"_5":12679,"_25963":44168,"_2424":44403},[],"The available modes are:",{"_2886":459,"_27469":379,"_18854":44405,"_5":12679,"_25963":44168,"_2424":44406},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2886":460,"_27469":379,"_18854":44408,"_5":12679,"_25963":44168,"_2424":44409},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2886":461,"_27469":379,"_18854":44411,"_5":12679,"_25963":44168,"_2424":44412},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2886":462,"_27469":379,"_18854":44414,"_5":12679,"_25963":44168,"_2424":44415},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2886":463,"_27469":379,"_18854":44417,"_5":12679,"_25963":44168,"_2424":44418},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2886":464,"_27469":379,"_18854":44420,"_5":12679,"_25963":44168,"_2424":44421},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2886":465,"_27469":379,"_18854":44423,"_5":12679,"_25963":44172,"_2424":44424},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2886":466,"_27469":379,"_18854":44426,"_5":12679,"_25963":44172,"_2424":44427},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2886":467,"_27469":379,"_18854":44429,"_5":12679,"_25963":44172,"_2424":44430},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2886":468,"_27469":379,"_18854":44432,"_5":12679,"_25963":44172,"_2424":44433},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2886":469,"_27469":379,"_18854":44435,"_5":12679,"_25963":44180,"_2424":44436},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2886":470,"_27469":379,"_18854":44438,"_5":12679,"_25963":44180,"_2424":44439},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2886":471,"_27469":379,"_18854":44441,"_5":12679,"_25963":44184,"_2424":44442},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2886":472,"_27469":379,"_18854":44444,"_5":12679,"_25963":44184,"_2424":44445},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2886":473,"_27469":379,"_18854":44447,"_5":12679,"_25963":44188,"_2424":44448},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2886":474,"_27469":379,"_18854":44450,"_5":12679,"_25963":44188,"_2424":44451},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2886":475,"_27469":379,"_18854":44453,"_5":12679,"_25963":44188,"_2424":44454},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2886":476,"_27469":379,"_18854":44456,"_5":12679,"_25963":44192,"_2424":44457},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2886":477,"_27469":379,"_18854":44459,"_5":12679,"_25963":44192,"_2424":44460},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2886":478,"_27469":379,"_18854":44462,"_5":12679,"_25963":44192,"_2424":44463},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2886":479,"_27469":379,"_18854":44465,"_5":12679,"_25963":44196,"_2424":44466},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2886":480,"_27469":379,"_18854":44468,"_5":12679,"_25963":44196,"_2424":44469},[],"full and read-only access to certificates and authorities;",{"_2886":481,"_27469":379,"_18854":44471,"_5":12679,"_25963":44196,"_2424":44472},[],"full and read-only access to the KMS;",{"_2886":482,"_27469":379,"_18854":44474,"_5":12679,"_25963":44196,"_2424":44475},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2886":483,"_27469":379,"_18854":44477,"_5":12679,"_25963":44196,"_2424":44478},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2886":484,"_27469":379,"_18854":44480,"_5":12679,"_25963":44196,"_2424":44481},[],"console access;",{"_2886":485,"_27469":379,"_18854":44483,"_5":12679,"_25963":44196,"_2424":44484},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2886":486,"_27469":379,"_18854":44486,"_5":12679,"_25963":44196,"_2424":44487},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2886":487,"_27469":379,"_18854":44489,"_5":12679,"_25963":44196,"_2424":44490},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2886":488,"_27469":379,"_18854":44492,"_5":12679,"_25963":44200,"_2424":44493},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2886":489,"_27469":379,"_18854":44495,"_5":12679,"_25963":44200,"_2424":44496},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2886":490,"_27469":379,"_18854":44498,"_5":12679,"_25963":44200,"_2424":44499},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2886":491,"_27469":379,"_18854":44501,"_5":12679,"_25963":44203,"_2424":44502},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2886":492,"_27469":379,"_18854":44504,"_5":12679,"_25963":44207,"_2424":44505},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2886":493,"_27469":379,"_18854":44507,"_5":12679,"_25963":44211,"_2424":44508},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2886":494,"_27469":379,"_18854":44510,"_5":12679,"_25963":44215,"_2424":44511},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2886":495,"_27469":379,"_18854":44513,"_5":12679,"_25963":44219,"_2424":44514},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2886":496,"_27469":379,"_18854":44516,"_5":12679,"_25963":44223,"_2424":44517},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2886":497,"_27469":379,"_18854":44519,"_5":12679,"_25963":44223,"_2424":44520},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2886":498,"_27469":379,"_18854":44522,"_5":12679,"_25963":44227,"_2424":44523},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2886":499,"_27469":379,"_18854":44525,"_5":12679,"_25963":44227,"_2424":44526},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2886":500,"_27469":379,"_18854":44528,"_5":12679,"_25963":44227,"_2424":44529},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2886":501,"_27469":379,"_18854":44531,"_5":12679,"_25963":44227,"_2424":44532},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2886":502,"_27469":379,"_18854":44534,"_5":12679,"_25963":44227,"_2424":44535},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2886":503,"_27469":379,"_18854":44537,"_5":12679,"_25963":44227,"_2424":44538},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2886":504,"_27469":379,"_18854":44540,"_5":12679,"_25963":44227,"_2424":44541},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2886":505,"_27469":379,"_18854":44543,"_5":12679,"_25963":44227,"_2424":44544},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2886":506,"_27469":379,"_18854":44546,"_5":12679,"_25963":44231,"_2424":44547},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2886":507,"_27469":379,"_18854":44549,"_5":12679,"_25963":44231,"_2424":44550},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2886":508,"_27469":379,"_18854":44552,"_5":12679,"_25963":44231,"_2424":44553},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2886":509,"_27469":379,"_18854":44555,"_5":12679,"_25963":44235,"_2424":44556},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2886":510,"_27469":379,"_18854":44558,"_5":12679,"_25963":44235,"_2424":44559},[],"Use groups or stable roles for people and independent identities for automations.",{"_2886":511,"_27469":379,"_18854":44561,"_5":12679,"_25963":44235,"_2424":44562},[],"Keep at least two recovery administrators and test their access periodically.",{"_2886":512,"_27469":379,"_18854":44564,"_5":12679,"_25963":44235,"_2424":44565},[],"Review active principals, their matches and their grants after IdP changes.",{"_2886":513,"_27469":379,"_18854":44567,"_5":12679,"_25963":44235,"_2424":44568},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2886":514,"_27469":379,"_18854":44570,"_5":12679,"_25963":44235,"_2424":44571},[],"Always test one allowed and one denied operation for each role.",{"_2886":515,"_27469":379,"_18854":44573,"_5":12679,"_25963":44235,"_2424":44574},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2886":516,"_27469":379,"_18854":44576,"_5":12679,"_25963":44243,"_2424":44577},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2886":517,"_27469":379,"_18854":44579,"_5":12679,"_25963":44247,"_2424":44580},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2886":518,"_27469":379,"_18854":44582,"_5":12679,"_25963":44247,"_2424":44583},[],"that an active principal of the correct type exists;",{"_2886":519,"_27469":379,"_18854":44585,"_5":12679,"_25963":44247,"_2424":44586},[],"that the claim paths and values match the real token exactly;",{"_2886":520,"_27469":379,"_18854":44588,"_5":12679,"_25963":44247,"_2424":44589},[],"that all of the principal's conditions hold;",{"_2886":521,"_27469":379,"_18854":44591,"_5":12679,"_25963":44247,"_2424":44592},[],"that the principal has the expected policy granted;",{"_2886":522,"_27469":379,"_18854":44594,"_5":12679,"_25963":44247,"_2424":44595},[],"that the policy includes the action and the requested resource type or route;",{"_2886":523,"_27469":379,"_18854":44597,"_5":12679,"_25963":44247,"_2424":44598},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2886":524,"_27469":379,"_18854":44600,"_5":12679,"_25963":44247,"_2424":44601},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure.",{"_2886":525,"_27469":379,"_18854":44603,"_5":12679,"_25963":44251,"_2424":44604},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2886":526,"_27469":379,"_18854":44606,"_5":12679,"_25963":44255,"_2424":44607},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2886":527,"_27469":379,"_18854":44609,"_5":12679,"_25963":44255,"_2424":44610},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2886":528,"_27469":528,"_5":13057,"_2424":44612,"_27749":44613,"_18854":44615,"_25963":528},"Alerts and subscriptions",[43001,44136,44614],"Operate Lamassu",[],{"_2886":529,"_27469":528,"_18854":44617,"_5":12679,"_25963":528,"_2424":44618},[],"Send PKI events to people and external systems.",{"_2886":530,"_27469":528,"_5":27746,"_18854":44620,"_25963":44621,"_2424":44622},[],"/docs/pr-preview/pr-24/platform/pki/alerts#how-it-works","How it works",{"_2886":531,"_27469":528,"_5":27746,"_18854":44624,"_25963":44625,"_2424":44626},[],"/docs/pr-preview/pr-24/platform/pki/alerts#available-channels","Available channels",{"_2886":532,"_27469":528,"_5":27746,"_18854":44628,"_25963":44629,"_2424":44630},[],"/docs/pr-preview/pr-24/platform/pki/alerts#create-a-subscription","Create a subscription",{"_2886":533,"_27469":528,"_5":27746,"_18854":44632,"_25963":44633,"_2424":44634},[],"/docs/pr-preview/pr-24/platform/pki/alerts#choose-the-event","Choose the event",{"_2886":534,"_27469":528,"_5":27746,"_18854":44636,"_25963":44637,"_2424":44638},[],"/docs/pr-preview/pr-24/platform/pki/alerts#configure-the-destination","Configure the destination",{"_2886":535,"_27469":528,"_5":27746,"_18854":44640,"_25963":44641,"_2424":44642},[],"/docs/pr-preview/pr-24/platform/pki/alerts#limit-the-notifications","Limit the notifications",{"_2886":536,"_27469":528,"_5":27746,"_18854":44644,"_25963":44645,"_2424":44646},[],"/docs/pr-preview/pr-24/platform/pki/alerts#review-and-activate","Review and activate",{"_2886":537,"_27469":528,"_5":27746,"_18854":44648,"_25963":44649,"_2424":44650},[],"/docs/pr-preview/pr-24/platform/pki/alerts#manage-a-subscription","Manage a subscription",{"_2886":538,"_27469":528,"_5":27746,"_18854":44652,"_25963":44653,"_2424":44654},[],"/docs/pr-preview/pr-24/platform/pki/alerts#event-families","Event families",{"_2886":539,"_27469":528,"_18854":44656,"_5":12679,"_25963":528,"_2424":44657},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2886":540,"_27469":528,"_18854":44659,"_5":12679,"_25963":44621,"_2424":44660},[],"A service publishes a domain event.",{"_2886":541,"_27469":528,"_18854":44662,"_5":12679,"_25963":44621,"_2424":44663},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2886":542,"_27469":528,"_18854":44665,"_5":12679,"_25963":44621,"_2424":44666},[],"Each subscription's filter decides whether it should be notified.",{"_2886":543,"_27469":528,"_18854":44668,"_5":12679,"_25963":44621,"_2424":44669},[],"Lamassu delivers the event to the configured channel.",{"_2886":544,"_27469":528,"_18854":44671,"_5":12679,"_25963":44621,"_2424":44672},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2886":545,"_27469":528,"_18854":44674,"_5":12679,"_25963":44625,"_2424":44675},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address.",{"_2886":546,"_27469":528,"_18854":44677,"_5":12679,"_25963":44625,"_2424":44678},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2886":547,"_27469":528,"_18854":44680,"_5":12679,"_25963":44625,"_2424":44681},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2886":548,"_27469":528,"_18854":44683,"_5":12679,"_25963":44633,"_2424":44684},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2886":549,"_27469":528,"_18854":44686,"_5":12679,"_25963":44637,"_2424":44687},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2886":550,"_27469":528,"_18854":44689,"_5":12679,"_25963":44641,"_2424":44690},[],"Add a filter if you don't want to receive every instance of the event.",{"_2886":551,"_27469":528,"_18854":44692,"_5":12679,"_25963":44641,"_2424":44693},[],"**None** notifies all instances of the event.",{"_2886":552,"_27469":528,"_18854":44695,"_5":12679,"_25963":44641,"_2424":44696},[],"**JSON Path** evaluates one or more specific fields.",{"_2886":553,"_27469":528,"_18854":44698,"_5":12679,"_25963":44641,"_2424":44699},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2886":554,"_27469":528,"_18854":44701,"_5":12679,"_25963":44641,"_2424":44702},[],"**JavaScript** lets you express custom logic.",{"_2886":555,"_27469":528,"_18854":44704,"_5":12679,"_25963":44641,"_2424":44705},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2886":556,"_27469":528,"_18854":44707,"_5":12679,"_25963":44645,"_2424":44708},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2886":557,"_27469":528,"_18854":44710,"_5":12679,"_25963":44649,"_2424":44711},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2886":558,"_27469":528,"_18854":44713,"_5":12679,"_25963":44653,"_2424":44714},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2886":559,"_27469":528,"_18854":44716,"_5":12679,"_25963":44653,"_2424":44717},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2886":560,"_27469":528,"_18854":44719,"_5":12679,"_25963":44653,"_2424":44720},[],"**Profiles:** `profile.create`, `profile.update` and `profile.delete`.",{"_2886":561,"_27469":528,"_18854":44722,"_5":12679,"_25963":44653,"_2424":44723},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2886":562,"_27469":528,"_18854":44725,"_5":12679,"_25963":44653,"_2424":44726},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2886":563,"_27469":528,"_18854":44728,"_5":12679,"_25963":44653,"_2424":44729},[],"**Validation:** `va.role.crl.create`.",{"_2886":564,"_27469":528,"_18854":44731,"_5":12679,"_25963":44653,"_2424":44732},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign.message` and `kms.delete`.",{"_2886":565,"_27469":528,"_18854":44734,"_5":12679,"_25963":44653,"_2424":44735},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2886":566,"_27469":566,"_5":13057,"_2424":44737,"_27749":44738,"_18854":44739,"_25963":566},"Audit logs",[43001,44136,44137],[],{"_2886":567,"_27469":566,"_18854":44741,"_5":12679,"_25963":566,"_2424":44742},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2886":568,"_27469":566,"_5":27746,"_18854":44744,"_25963":44745,"_2424":44746},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#what-an-event-contains","What an event contains",{"_2886":569,"_27469":566,"_5":27746,"_18854":44748,"_25963":44749,"_2424":44750},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#coverage","Coverage",{"_2886":570,"_27469":566,"_5":27746,"_18854":44752,"_25963":44753,"_2424":44754},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#publication-and-persistence","Publication and persistence",{"_2886":571,"_27469":566,"_5":27746,"_18854":44756,"_25963":44757,"_2424":44758},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#sensitive-data","Sensitive data",{"_2886":572,"_27469":566,"_5":27746,"_18854":44760,"_25963":44761,"_2424":44762},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2886":573,"_27469":566,"_5":27746,"_18854":44764,"_25963":44765,"_2424":44766},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#bound-the-interval","Bound the interval",{"_2886":574,"_27469":566,"_5":27746,"_18854":44768,"_25963":44769,"_2424":44770},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#identify-the-operation","Identify the operation",{"_2886":575,"_27469":566,"_5":27746,"_18854":44772,"_25963":44773,"_2424":44774},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#attribute-the-principal","Attribute the principal",{"_2886":576,"_27469":566,"_5":27746,"_18854":44776,"_25963":44777,"_2424":44778},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#compare-intent-and-result","Compare intent and result",{"_2886":577,"_27469":566,"_5":27746,"_18854":44780,"_25963":44781,"_2424":44782},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#follow-the-effect","Follow the effect",{"_2886":578,"_27469":566,"_5":27746,"_18854":44784,"_25963":44785,"_2424":44786},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#periodic-verification","Periodic verification",{"_2886":579,"_27469":566,"_18854":44788,"_5":12679,"_25963":566,"_2424":44789},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2886":580,"_27469":566,"_18854":44791,"_5":12679,"_25963":44745,"_2424":44792},[],"The audit body includes:",{"_2886":581,"_27469":566,"_18854":44794,"_5":12679,"_25963":44745,"_2424":44795},[],"input: data received by the operation;",{"_2886":582,"_27469":566,"_18854":44797,"_5":12679,"_25963":44745,"_2424":44798},[],"has\\_error: whether the service returned an error;",{"_2886":583,"_27469":566,"_18854":44800,"_5":12679,"_25963":44745,"_2424":44801},[],"output: produced result or error message;",{"_2886":584,"_27469":566,"_18854":44803,"_5":12679,"_25963":44745,"_2424":44804},[],"principals: identifiers of the principals that matched the request.",{"_2886":585,"_27469":566,"_18854":44806,"_5":12679,"_25963":44745,"_2424":44807},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2886":586,"_27469":566,"_18854":44809,"_5":12679,"_25963":44745,"_2424":44810},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2886":587,"_27469":566,"_18854":44812,"_5":12679,"_25963":44749,"_2424":44813},[],"The backend applies auditing to mutations of:",{"_2886":588,"_27469":566,"_18854":44815,"_5":12679,"_25963":44749,"_2424":44816},[],"authorities, certificates and issuance profiles;",{"_2886":589,"_27469":566,"_18854":44818,"_5":12679,"_25963":44749,"_2424":44819},[],"keys and KMS engines;",{"_2886":590,"_27469":566,"_18854":44821,"_5":12679,"_25963":44749,"_2424":44822},[],"devices and identities;",{"_2886":591,"_27469":566,"_18854":44824,"_5":12679,"_25963":44749,"_2424":44825},[],"DMSs and enrollment operations;",{"_2886":592,"_27469":566,"_18854":44827,"_5":12679,"_25963":44749,"_2424":44828},[],"validation functions and CRL;",{"_2886":593,"_27469":566,"_18854":44830,"_5":12679,"_25963":44749,"_2424":44831},[],"principals, policies and authorization grants.",{"_2886":594,"_27469":566,"_18854":44833,"_5":12679,"_25963":44749,"_2424":44834},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2886":595,"_27469":566,"_18854":44836,"_5":12679,"_25963":44753,"_2424":44837},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2886":596,"_27469":566,"_18854":44839,"_5":12679,"_25963":44753,"_2424":44840},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2886":597,"_27469":566,"_18854":44842,"_5":12679,"_25963":44753,"_2424":44843},[],"Design the consumer to:",{"_2886":598,"_27469":566,"_18854":44845,"_5":12679,"_25963":44753,"_2424":44846},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2886":599,"_27469":566,"_18854":44848,"_5":12679,"_25963":44753,"_2424":44849},[],"keep the complete CloudEvent unmodified;",{"_2886":600,"_27469":566,"_18854":44851,"_5":12679,"_25963":44753,"_2424":44852},[],"record the ingestion time and detect duplicates by ID;",{"_2886":601,"_27469":566,"_18854":44854,"_5":12679,"_25963":44753,"_2424":44855},[],"encrypt in transit and at rest;",{"_2886":602,"_27469":566,"_18854":44857,"_5":12679,"_25963":44753,"_2424":44858},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2886":603,"_27469":566,"_18854":44860,"_5":12679,"_25963":44753,"_2424":44861},[],"apply an explicit retention and legal hold policy;",{"_2886":604,"_27469":566,"_18854":44863,"_5":12679,"_25963":44753,"_2424":44864},[],"alert if it stops consuming or the pending queue grows.",{"_2886":605,"_27469":566,"_18854":44866,"_5":12679,"_25963":44757,"_2424":44867},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2886":606,"_27469":566,"_18854":44869,"_5":12679,"_25963":44757,"_2424":44870},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2886":607,"_27469":566,"_18854":44872,"_5":12679,"_25963":44765,"_2424":44873},[],"Start from the reported time and normalize every source to UTC.",{"_2886":608,"_27469":566,"_18854":44875,"_5":12679,"_25963":44769,"_2424":44876},[],"Filter by event type, service source and resource identifier.",{"_2886":609,"_27469":566,"_18854":44878,"_5":12679,"_25963":44773,"_2424":44879},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2886":610,"_27469":566,"_18854":44881,"_5":12679,"_25963":44777,"_2424":44882},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2886":611,"_27469":566,"_18854":44884,"_5":12679,"_25963":44781,"_2424":44885},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2886":612,"_27469":566,"_18854":44887,"_5":12679,"_25963":44785,"_2424":44888},[],"Generate a controlled mutation in a test environment and check that:",{"_2886":613,"_27469":566,"_18854":44890,"_5":12679,"_25963":44785,"_2424":44891},[],"a successful audit event appears;",{"_2886":614,"_27469":566,"_18854":44893,"_5":12679,"_25963":44785,"_2424":44894},[],"the principal matches the identity used;",{"_2886":615,"_27469":566,"_18854":44896,"_5":12679,"_25963":44785,"_2424":44897},[],"the consumer persists it exactly once;",{"_2886":616,"_27469":566,"_18854":44899,"_5":12679,"_25963":44785,"_2424":44900},[],"it can be retrieved by resource, actor and period;",{"_2886":617,"_27469":566,"_18854":44902,"_5":12679,"_25963":44785,"_2424":44903},[],"a consumer outage raises an alert.",{"_2886":618,"_27469":566,"_18854":44905,"_5":12679,"_25963":44785,"_2424":44906},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2886":619,"_27469":619,"_5":13057,"_2424":44908,"_27749":44909,"_18854":44910,"_25963":619},"CA hierarchy and rotation",[43001,44136,44614],[],{"_2886":620,"_27469":619,"_18854":44912,"_5":12679,"_25963":619,"_2424":44913},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2886":621,"_27469":619,"_5":27746,"_18854":44915,"_25963":44916,"_2424":44917},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2886":622,"_27469":619,"_5":27746,"_18854":44919,"_25963":44920,"_2424":44921},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2886":623,"_27469":619,"_5":27746,"_18854":44923,"_25963":44924,"_2424":44925},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2886":624,"_27469":619,"_5":27746,"_18854":44927,"_25963":44928,"_2424":44929},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2886":625,"_27469":619,"_5":27746,"_18854":44931,"_25963":44932,"_2424":44933},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2886":626,"_27469":619,"_5":27746,"_18854":44935,"_25963":44936,"_2424":44937},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2886":627,"_27469":619,"_5":27746,"_18854":44939,"_25963":44940,"_2424":44941},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2886":628,"_27469":619,"_5":27746,"_18854":44943,"_25963":44944,"_2424":44945},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2886":629,"_27469":619,"_5":27746,"_18854":44947,"_25963":44948,"_2424":44949},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2886":630,"_27469":619,"_5":27746,"_18854":44951,"_25963":44952,"_2424":44953},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2886":631,"_27469":619,"_5":27746,"_18854":44955,"_25963":44956,"_2424":44957},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2886":632,"_27469":619,"_5":27746,"_18854":44959,"_25963":44960,"_2424":44961},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2886":633,"_27469":619,"_18854":44963,"_5":12679,"_25963":619,"_2424":44964},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2886":634,"_27469":619,"_18854":44966,"_5":12679,"_25963":44916,"_2424":44967},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2886":635,"_27469":619,"_18854":44969,"_5":12679,"_25963":44916,"_2424":44970},[],"environment, such as production and preproduction;",{"_2886":636,"_27469":619,"_18854":44972,"_5":12679,"_25963":44916,"_2424":44973},[],"owner or operating team;",{"_2886":637,"_27469":619,"_18854":44975,"_5":12679,"_25963":44916,"_2424":44976},[],"device family or manufacturing process;",{"_2886":638,"_27469":619,"_18854":44978,"_5":12679,"_25963":44916,"_2424":44979},[],"region or regulatory requirement;",{"_2886":639,"_27469":619,"_18854":44981,"_5":12679,"_25963":44916,"_2424":44982},[],"cryptographic engine or key policy;",{"_2886":640,"_27469":619,"_18854":44984,"_5":12679,"_25963":44916,"_2424":44985},[],"maintenance window and renewal cadence.",{"_2886":641,"_27469":619,"_18854":44987,"_5":12679,"_25963":44916,"_2424":44988},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2886":642,"_27469":619,"_18854":44990,"_5":12679,"_25963":44916,"_2424":44991},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2886":643,"_27469":619,"_18854":44993,"_5":12679,"_25963":44920,"_2424":44994},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2886":644,"_27469":619,"_18854":44996,"_5":12679,"_25963":44920,"_2424":44997},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2886":645,"_27469":619,"_18854":44999,"_5":12679,"_25963":44920,"_2424":45000},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2886":646,"_27469":619,"_18854":45002,"_5":12679,"_25963":44924,"_2424":45003},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2886":647,"_27469":619,"_18854":45005,"_5":12679,"_25963":44924,"_2424":45006},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2886":648,"_27469":619,"_18854":45008,"_5":12679,"_25963":44924,"_2424":45009},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2886":649,"_27469":619,"_18854":45011,"_5":12679,"_25963":44924,"_2424":45012},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2886":650,"_27469":619,"_18854":45014,"_5":12679,"_25963":44932,"_2424":45015},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2886":651,"_27469":619,"_18854":45017,"_5":12679,"_25963":44936,"_2424":45018},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2886":652,"_27469":619,"_18854":45020,"_5":12679,"_25963":44940,"_2424":45021},[],"Add the new root or chain to consumers before issuing with it. In a DMS, use the managed CAs of `/cacerts` to temporarily keep both the old and new chains.",{"_2886":653,"_27469":619,"_18854":45023,"_5":12679,"_25963":44944,"_2424":45024},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2886":654,"_27469":619,"_18854":45026,"_5":12679,"_25963":44948,"_2424":45027},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2886":655,"_27469":619,"_18854":45029,"_5":12679,"_25963":44952,"_2424":45030},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2886":656,"_27469":619,"_18854":45032,"_5":12679,"_25963":44956,"_2424":45033},[],"When you revoke a CA, Lamassu also updates its child CAs and issued certificates to `REVOKED` with the reason `CessationOfOperation`. The children's revocations propagate the effect to their own branches.",{"_2886":657,"_27469":619,"_18854":45035,"_5":12679,"_25963":44956,"_2424":45036},[],"This protects the coherence of the hierarchy, but it makes revocation a high-impact action. Do not use it as the ordinary mechanism to stop issuing: first complete the migration and remove the CA from operational flows.",{"_2886":658,"_27469":619,"_18854":45038,"_5":12679,"_25963":44960,"_2424":45039},[],"The new chain ends in an anchor installed by the consumer.",{"_2886":659,"_27469":619,"_18854":45041,"_5":12679,"_25963":44960,"_2424":45042},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2886":660,"_27469":619,"_18854":45044,"_5":12679,"_25963":44960,"_2424":45045},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2886":661,"_27469":619,"_18854":45047,"_5":12679,"_25963":44960,"_2424":45048},[],"Re-enrollment accepts the old identity during the planned period.",{"_2886":662,"_27469":619,"_18854":45050,"_5":12679,"_25963":44960,"_2424":45051},[],"OCSP and CRL respond for the authorities that remain active.",{"_2886":663,"_27469":619,"_18854":45053,"_5":12679,"_25963":44960,"_2424":45054},[],"No DMS is left accidentally issuing from the old CA.",{"_2886":664,"_27469":619,"_18854":45056,"_5":12679,"_25963":44960,"_2424":45057},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2886":665,"_27469":665,"_5":13057,"_2424":45059,"_27749":45060,"_18854":45061,"_25963":665},"Certification authorities",[43001,44136,44614],[],{"_2886":666,"_27469":665,"_18854":45063,"_5":12679,"_25963":665,"_2424":45064},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2886":667,"_27469":665,"_5":27746,"_18854":45066,"_25963":45067,"_2424":45068},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2886":668,"_27469":665,"_5":27746,"_18854":45070,"_25963":45071,"_2424":45072},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2886":669,"_27469":665,"_5":27746,"_18854":45074,"_25963":45075,"_2424":43011},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#before-you-begin",{"_2886":670,"_27469":665,"_5":27746,"_18854":45077,"_25963":45078,"_2424":45079},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2886":671,"_27469":665,"_5":27746,"_18854":45081,"_25963":45082,"_2424":45083},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2886":672,"_27469":665,"_5":27746,"_18854":45085,"_25963":45086,"_2424":45087},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2886":673,"_27469":665,"_5":27746,"_18854":45089,"_25963":45090,"_2424":45091},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2886":674,"_27469":665,"_5":27746,"_18854":45093,"_25963":45094,"_2424":45095},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2886":675,"_27469":665,"_5":27746,"_18854":45097,"_25963":45098,"_2424":45099},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2886":676,"_27469":665,"_5":27746,"_18854":45101,"_25963":45102,"_2424":45103},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2886":677,"_27469":665,"_5":27746,"_18854":45105,"_25963":45106,"_2424":45107},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2886":678,"_27469":665,"_5":27746,"_18854":45109,"_25963":45110,"_2424":45111},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2886":679,"_27469":665,"_5":27746,"_18854":45113,"_25963":45114,"_2424":45115},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2886":680,"_27469":665,"_5":27746,"_18854":45117,"_25963":45118,"_2424":45119},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2886":681,"_27469":665,"_5":27746,"_18854":45121,"_25963":45122,"_2424":45123},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2886":682,"_27469":665,"_5":27746,"_18854":45125,"_25963":45126,"_2424":45127},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2886":683,"_27469":665,"_5":27746,"_18854":45129,"_25963":45130,"_2424":45131},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2886":684,"_27469":665,"_5":27746,"_18854":45133,"_25963":45134,"_2424":45135},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2886":685,"_27469":665,"_5":27746,"_18854":45137,"_25963":45138,"_2424":45139},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2886":686,"_27469":665,"_5":27746,"_18854":45141,"_25963":45142,"_2424":45143},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2886":687,"_27469":665,"_5":27746,"_18854":45145,"_25963":45146,"_2424":45147},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2886":688,"_27469":665,"_5":27746,"_18854":45149,"_25963":45150,"_2424":45151},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2886":689,"_27469":665,"_18854":45153,"_5":12679,"_25963":665,"_2424":45154},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2886":690,"_27469":665,"_18854":45156,"_5":12679,"_25963":665,"_2424":45157},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2886":691,"_27469":665,"_18854":45159,"_5":12679,"_25963":45067,"_2424":45160},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2886":692,"_27469":665,"_18854":45162,"_5":12679,"_25963":45067,"_2424":45163},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2886":693,"_27469":665,"_18854":45165,"_5":12679,"_25963":45067,"_2424":45166},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2886":694,"_27469":665,"_18854":45168,"_5":12679,"_25963":45067,"_2424":45169},[],"**Import only the certificate:** add an authority for building chains and validating, but not for issuing.",{"_2886":695,"_27469":665,"_18854":45171,"_5":12679,"_25963":45067,"_2424":45172},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2886":696,"_27469":665,"_18854":45174,"_5":12679,"_25963":45075,"_2424":45175},[],"Decide whether the CA will be a root or an intermediate.",{"_2886":697,"_27469":665,"_18854":45177,"_5":12679,"_25963":45075,"_2424":45178},[],"Choose the engine that will keep the key.",{"_2886":698,"_27469":665,"_18854":45180,"_5":12679,"_25963":45075,"_2424":45181},[],"Define a validity longer than that of the certificates it will issue.",{"_2886":699,"_27469":665,"_18854":45183,"_5":12679,"_25963":45075,"_2424":45184},[],"For an intermediate CA, make sure the parent CA is active.",{"_2886":700,"_27469":665,"_18854":45186,"_5":12679,"_25963":45078,"_2424":45187},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2886":701,"_27469":665,"_18854":45189,"_5":12679,"_25963":45082,"_2424":45190},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2886":702,"_27469":665,"_18854":45192,"_5":12679,"_25963":45082,"_2424":45193},[],"For RSA you can choose 1024, 2048, 3072 or 4096 bits. For EC, the P-256, P-384 and P-521 curves are available.",{"_2886":703,"_27469":665,"_18854":45195,"_5":12679,"_25963":45086,"_2424":45196},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2886":704,"_27469":665,"_18854":45198,"_5":12679,"_25963":45090,"_2424":45199},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2886":705,"_27469":665,"_18854":45201,"_5":12679,"_25963":45090,"_2424":45202},[],"`C`: two-letter ISO 3166-1 country code.",{"_2886":706,"_27469":665,"_18854":45204,"_5":12679,"_25963":45090,"_2424":45205},[],"`ST`: state or province.",{"_2886":707,"_27469":665,"_18854":45207,"_5":12679,"_25963":45090,"_2424":45208},[],"`L`: locality.",{"_2886":708,"_27469":665,"_18854":45210,"_5":12679,"_25963":45090,"_2424":45211},[],"`O`: organization.",{"_2886":709,"_27469":665,"_18854":45213,"_5":12679,"_25963":45090,"_2424":45214},[],"`OU`: organizational unit.",{"_2886":710,"_27469":665,"_18854":45216,"_5":12679,"_25963":45090,"_2424":45217},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2886":711,"_27469":665,"_18854":45219,"_5":12679,"_25963":45094,"_2424":45220},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2886":712,"_27469":665,"_18854":45222,"_5":12679,"_25963":45094,"_2424":45223},[],"Select an existing issuance profile or configure the `Key Usage` and `Extended Key Usage` in the form. If you don't choose a profile, Lamassu applies the default basic usages.",{"_2886":713,"_27469":665,"_18854":45225,"_5":12679,"_25963":45098,"_2424":45226},[],"Confirm the form. The CA should appear in the inventory with its PEM certificate, status, expiration date and list of issued certificates.",{"_2886":714,"_27469":665,"_18854":45228,"_5":12679,"_25963":45098,"_2424":45229},[],"A CA cannot issue certificates that outlive its own expiration date. Leave enough margin to renew or replace the authority without interrupting consumers.",{"_2886":715,"_27469":665,"_18854":45231,"_5":12679,"_25963":45102,"_2424":45232},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2886":716,"_27469":665,"_18854":45234,"_5":12679,"_25963":45102,"_2424":45235},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2886":717,"_27469":665,"_18854":45237,"_5":12679,"_25963":45106,"_2424":45238},[],"Importing preserves an authority created outside Lamassu.",{"_2886":718,"_27469":665,"_18854":45240,"_5":12679,"_25963":45110,"_2424":45241},[],"Choose the engine that will keep the imported key.",{"_2886":719,"_27469":665,"_18854":45243,"_5":12679,"_25963":45114,"_2424":45244},[],"Provide the CA certificate and the private key in PEM format. For a subordinate CA, optionally add the validation chain.",{"_2886":720,"_27469":665,"_18854":45246,"_5":12679,"_25963":45118,"_2424":45247},[],"Configure the validity that end-entity certificates will receive when a request does not specify another duration.",{"_2886":721,"_27469":665,"_18854":45249,"_5":12679,"_25963":45122,"_2424":45250},[],"Lamassu checks that the certificate belongs to a CA and that the material is coherent before registering it.",{"_2886":722,"_27469":665,"_18854":45252,"_5":12679,"_25963":45122,"_2424":45253},[],"If you don't have the private key, import only the certificate. The authority can take part in chains of trust and validation processes, but it cannot issue certificates from Lamassu.",{"_2886":723,"_27469":665,"_18854":45255,"_5":12679,"_25963":45126,"_2424":45256},[],"Open a CA from the inventory to review:",{"_2886":724,"_27469":665,"_18854":45258,"_5":12679,"_25963":45126,"_2424":45259},[],"Status and validity period.",{"_2886":725,"_27469":665,"_18854":45261,"_5":12679,"_25963":45126,"_2424":45262},[],"Certificate and chain in PEM format.",{"_2886":726,"_27469":665,"_18854":45264,"_5":12679,"_25963":45126,"_2424":45265},[],"Number of active, expired and revoked certificates.",{"_2886":727,"_27469":665,"_18854":45267,"_5":12679,"_25963":45126,"_2424":45268},[],"Certificates issued in **Issued Certificates**.",{"_2886":728,"_27469":665,"_18854":45270,"_5":12679,"_25963":45126,"_2424":45271},[],"The CRL linked to the authority.",{"_2886":729,"_27469":665,"_18854":45273,"_5":12679,"_25963":45126,"_2424":45274},[],"Metadata and the associated cryptographic engine.",{"_2886":730,"_27469":665,"_18854":45276,"_5":12679,"_25963":45126,"_2424":45277},[],"You can filter the inventory by name, status and CA type.",{"_2886":731,"_27469":665,"_18854":45279,"_5":12679,"_25963":45130,"_2424":45280},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2886":732,"_27469":665,"_18854":45282,"_5":12679,"_25963":45130,"_2424":45283},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2886":733,"_27469":665,"_18854":45285,"_5":12679,"_25963":45130,"_2424":45286},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2886":734,"_27469":665,"_18854":45288,"_5":12679,"_25963":45130,"_2424":45289},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2886":735,"_27469":665,"_18854":45291,"_5":12679,"_25963":45134,"_2424":45292},[],"Revoking a CA invalidates trust in the certificates it issued and can interrupt devices and services. The action is irreversible.",{"_2886":736,"_27469":665,"_18854":45294,"_5":12679,"_25963":45138,"_2424":45295},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2886":737,"_27469":665,"_18854":45297,"_5":12679,"_25963":45142,"_2424":45298},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2886":738,"_27469":665,"_18854":45300,"_5":12679,"_25963":45146,"_2424":45301},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2886":739,"_27469":665,"_18854":45303,"_5":12679,"_25963":45150,"_2424":45304},[],"The status should change to **REVOKED** and the CRL should reflect the new information. The CA can no longer issue certificates.",{"_2886":740,"_27469":665,"_18854":45306,"_5":12679,"_25963":45150,"_2424":45307},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2886":741,"_27469":741,"_5":13057,"_2424":45309,"_27749":45310,"_18854":45311,"_25963":741},"Certificate profiles",[43001,44136,44614],[],{"_2886":742,"_27469":741,"_18854":45313,"_5":12679,"_25963":741,"_2424":45314},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2886":743,"_27469":741,"_5":27746,"_18854":45316,"_25963":45317,"_2424":45318},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2886":744,"_27469":741,"_5":27746,"_18854":45320,"_25963":45321,"_2424":45322},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#validity","Validity",{"_2886":745,"_27469":741,"_5":27746,"_18854":45324,"_25963":45325,"_2424":45326},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2886":746,"_27469":741,"_5":27746,"_18854":45328,"_25963":45329,"_2424":45330},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2886":747,"_27469":741,"_5":27746,"_18854":45332,"_25963":45333,"_2424":45334},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#subject","Subject",{"_2886":748,"_27469":741,"_5":27746,"_18854":45336,"_25963":45337,"_2424":45338},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2886":749,"_27469":741,"_5":27746,"_18854":45340,"_25963":45341,"_2424":45342},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2886":750,"_27469":741,"_5":27746,"_18854":45344,"_25963":45345,"_2424":45346},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2886":751,"_27469":741,"_5":27746,"_18854":45348,"_25963":45349,"_2424":45350},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2886":752,"_27469":741,"_5":27746,"_18854":45352,"_25963":45353,"_2424":45354},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2886":753,"_27469":741,"_5":27746,"_18854":45356,"_25963":45357,"_2424":45358},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2886":754,"_27469":741,"_5":27746,"_18854":45360,"_25963":45361,"_2424":45362},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2886":755,"_27469":741,"_5":27746,"_18854":45364,"_25963":45365,"_2424":45366},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2886":756,"_27469":741,"_5":27746,"_18854":45368,"_25963":45369,"_2424":45370},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2886":757,"_27469":741,"_5":27746,"_18854":45372,"_25963":45373,"_2424":45374},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#design-examples","Design examples",{"_2886":758,"_27469":741,"_5":27746,"_18854":45376,"_25963":45377,"_2424":45378},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2886":759,"_27469":741,"_18854":45380,"_5":12679,"_25963":741,"_2424":45381},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2886":760,"_27469":741,"_18854":45383,"_5":12679,"_25963":45321,"_2424":45384},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2886":761,"_27469":741,"_18854":45386,"_5":12679,"_25963":45321,"_2424":45387},[],"The end date must never outlive the issuing CA.",{"_2886":762,"_27469":741,"_18854":45389,"_5":12679,"_25963":45325,"_2424":45390},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2886":763,"_27469":741,"_18854":45392,"_5":12679,"_25963":45329,"_2424":45393},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2886":764,"_27469":741,"_18854":45395,"_5":12679,"_25963":45329,"_2424":45396},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2886":765,"_27469":741,"_18854":45398,"_5":12679,"_25963":45329,"_2424":45399},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2886":766,"_27469":741,"_18854":45401,"_5":12679,"_25963":45333,"_2424":45402},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2886":767,"_27469":741,"_18854":45404,"_5":12679,"_25963":45337,"_2424":45405},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2886":768,"_27469":741,"_18854":45407,"_5":12679,"_25963":45337,"_2424":45408},[],"This behavior allows accepting DNS, IP, email or URI as alternative identities without accepting arbitrary extensions.",{"_2886":769,"_27469":741,"_18854":45410,"_5":12679,"_25963":45341,"_2424":45411},[],"The cryptographic enforcement can:",{"_2886":770,"_27469":741,"_18854":45413,"_5":12679,"_25963":45341,"_2424":45414},[],"allow or block RSA keys;",{"_2886":771,"_27469":741,"_18854":45416,"_5":12679,"_25963":45341,"_2424":45417},[],"limit the supported RSA sizes;",{"_2886":772,"_27469":741,"_18854":45419,"_5":12679,"_25963":45341,"_2424":45420},[],"allow or block ECDSA keys;",{"_2886":773,"_27469":741,"_18854":45422,"_5":12679,"_25963":45341,"_2424":45423},[],"limit the supported ECDSA sizes or curves.",{"_2886":774,"_27469":741,"_18854":45425,"_5":12679,"_25963":45341,"_2424":45426},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2886":775,"_27469":741,"_18854":45428,"_5":12679,"_25963":45345,"_2424":45429},[],"In operations that accept multiple sources, Lamassu resolves the profile in this order:",{"_2886":776,"_27469":741,"_18854":45431,"_5":12679,"_25963":45345,"_2424":45432},[],"The profile sent within the operation.",{"_2886":777,"_27469":741,"_18854":45434,"_5":12679,"_25963":45345,"_2424":45435},[],"The profile identifier sent in the operation.",{"_2886":778,"_27469":741,"_18854":45437,"_5":12679,"_25963":45345,"_2424":45438},[],"The default profile associated with the CA.",{"_2886":779,"_27469":741,"_18854":45440,"_5":12679,"_25963":45345,"_2424":45441},[],"A DMS can also reference its own issuance profile. This way, several fleets can use the same CA with different policies.",{"_2886":780,"_27469":741,"_18854":45443,"_5":12679,"_25963":45353,"_2424":45444},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2886":781,"_27469":741,"_18854":45446,"_5":12679,"_25963":45357,"_2424":45447},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2886":782,"_27469":741,"_18854":45449,"_5":12679,"_25963":45361,"_2424":45450},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2886":783,"_27469":741,"_18854":45452,"_5":12679,"_25963":45365,"_2424":45453},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2886":784,"_27469":741,"_18854":45455,"_5":12679,"_25963":45369,"_2424":45456},[],"Attach the profile to a CA or DMS. Issue a test certificate and check subject, SAN, KU, EKU, basic constraints and dates with an independent X.509 tool.",{"_2886":785,"_27469":741,"_18854":45458,"_5":12679,"_25963":45373,"_2424":45459},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2886":786,"_27469":741,"_18854":45461,"_5":12679,"_25963":45373,"_2424":45462},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2886":787,"_27469":741,"_18854":45464,"_5":12679,"_25963":45373,"_2424":45465},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2886":788,"_27469":741,"_18854":45467,"_5":12679,"_25963":45373,"_2424":45468},[],"These are starting patterns, not a universal policy. Always verify the requirements of the protocol, the consumer and the applicable regulatory framework.",{"_2886":789,"_27469":741,"_18854":45470,"_5":12679,"_25963":45377,"_2424":45471},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2886":790,"_27469":741,"_18854":45473,"_5":12679,"_25963":45377,"_2424":45474},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2886":791,"_27469":791,"_5":13057,"_2424":45476,"_27749":45477,"_18854":45478,"_25963":791},"Certificate validation",[43001,44136,44614],[],{"_2886":792,"_27469":791,"_18854":45480,"_5":12679,"_25963":791,"_2424":45481},[],"Publish the status of identities through OCSP and CRL.",{"_2886":793,"_27469":791,"_5":27746,"_18854":45483,"_25963":45484,"_2424":45485},[],"/docs/pr-preview/pr-24/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2886":794,"_27469":791,"_18854":45487,"_5":12679,"_25963":791,"_2424":45488},[],"Issuance proves who signed a certificate; validation tells you whether it should still be accepted. Lamassu publishes status through two complementary mechanisms.",{"_2886":795,"_27469":791,"_18854":45490,"_5":12679,"_25963":45484,"_2424":45491},[],"Use **OCSP** when the consumer is online and needs to check the latest status of a specific certificate.",{"_2886":796,"_27469":791,"_18854":45493,"_5":12679,"_25963":45484,"_2424":45494},[],"Use a **CRL** when validation must happen locally, offline or over a high volume of certificates. The consumer periodically downloads a signed list and keeps it until the next update.",{"_2886":797,"_27469":791,"_18854":45496,"_5":12679,"_25963":45484,"_2424":45497},[],"Many environments use both: OCSP as the primary check and a CRL as the local or fallback mechanism.",{"_2886":798,"_27469":791,"_18854":45499,"_5":12679,"_25963":45484,"_2424":45500},[],"<Card title=\"Online validation with OCSP\" description=\"Query Good, Revoked and Unknown statuses in real time.\" href=\"/docs/platform/pki/ocsp\" />",{"_2886":799,"_27469":791,"_18854":45502,"_5":12679,"_25963":45484,"_2424":45503},[],"<Card title=\"Revocation lists\" description=\"Generate, publish and distribute CRLs per authority.\" href=\"/docs/platform/pki/crl\" />",{"_2886":800,"_27469":800,"_5":13057,"_2424":45505,"_27749":45506,"_18854":45507,"_25963":800},"Certificates",[43001,44136,44614],[],{"_2886":801,"_27469":800,"_18854":45509,"_5":12679,"_25963":800,"_2424":45510},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2886":802,"_27469":800,"_5":27746,"_18854":45512,"_25963":45513,"_2424":45514},[],"/docs/pr-preview/pr-24/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2886":803,"_27469":800,"_5":27746,"_18854":45516,"_25963":45517,"_2424":45518},[],"/docs/pr-preview/pr-24/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2886":804,"_27469":800,"_5":27746,"_18854":45520,"_25963":45521,"_2424":45522},[],"/docs/pr-preview/pr-24/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2886":805,"_27469":800,"_5":27746,"_18854":45524,"_25963":45525,"_2424":45526},[],"/docs/pr-preview/pr-24/platform/pki/certificates#open-the-action","Open the action",{"_2886":806,"_27469":800,"_5":27746,"_18854":45528,"_25963":45529,"_2424":45530},[],"/docs/pr-preview/pr-24/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2886":807,"_27469":800,"_5":27746,"_18854":45532,"_25963":45533,"_2424":45534},[],"/docs/pr-preview/pr-24/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2886":808,"_27469":800,"_5":27746,"_18854":45536,"_25963":45537,"_2424":45538},[],"/docs/pr-preview/pr-24/platform/pki/certificates#continue","Continue",{"_2886":809,"_27469":800,"_18854":45540,"_5":12679,"_25963":800,"_2424":45541},[],"The certificate inventory offers a global view of the identities issued by all authorities. You can also open **Issued Certificates** inside a CA to limit the view to that issuer.",{"_2886":810,"_27469":800,"_18854":45543,"_5":12679,"_25963":45513,"_2424":45544},[],"Open **Certificates** and filter by:",{"_2886":811,"_27469":800,"_18854":45546,"_5":12679,"_25963":45513,"_2424":45547},[],"Subject's `Common Name`.",{"_2886":812,"_27469":800,"_18854":45549,"_5":12679,"_25963":45513,"_2424":45550},[],"Serial number.",{"_2886":813,"_27469":800,"_18854":45552,"_5":12679,"_25963":45513,"_2424":45553},[],"Status.",{"_2886":814,"_27469":800,"_18854":45555,"_5":12679,"_25963":45513,"_2424":45556},[],"Issuing authority.",{"_2886":815,"_27469":800,"_18854":45558,"_5":12679,"_25963":45513,"_2424":45559},[],"Use **Quick Inspect** for a quick check or **View Details** to see the subject, SANs, usages, chain, validity period and full metadata.",{"_2886":816,"_27469":800,"_18854":45561,"_5":12679,"_25963":45517,"_2424":45562},[],"The download action delivers the certificate in PEM format. If the certificate was issued from an external CSR, the private key stays on the system that generated that CSR. If it was generated in the browser, the key was only available when the issuance finished.",{"_2886":817,"_27469":800,"_18854":45564,"_5":12679,"_25963":45521,"_2424":45565},[],"Revoke an identity when the key has been compromised, the subject is no longer authorized or the certificate must stop being accepted before it expires.",{"_2886":818,"_27469":800,"_18854":45567,"_5":12679,"_25963":45525,"_2424":45568},[],"In the inventory or detail view, select **Revoke Certificate**.",{"_2886":819,"_27469":800,"_18854":45570,"_5":12679,"_25963":45529,"_2424":45571},[],"Select the reason that represents the incident. This information is published in OCSP and in the CRL.",{"_2886":820,"_27469":800,"_18854":45573,"_5":12679,"_25963":45533,"_2424":45574},[],"Confirm the operation and check that the status is **Revoked**. If the CA regenerates the CRL upon revocation, also verify that a new version exists.",{"_2886":821,"_27469":800,"_18854":45576,"_5":12679,"_25963":45533,"_2424":45577},[],"A revocation with the reason `CertificateHold` can be reactivated. All other reasons produce a final revocation.",{"_2886":822,"_27469":800,"_18854":45579,"_5":12679,"_25963":45537,"_2424":45580},[],"<Card title=\"Validate with OCSP\" description=\"Query the status of a certificate in real time.\" href=\"/docs/platform/pki/ocsp\" />",{"_2886":823,"_27469":800,"_18854":45582,"_5":12679,"_25963":45537,"_2424":45583},[],"<Card title=\"Distribute a CRL\" description=\"Publish the status for offline validation.\" href=\"/docs/platform/pki/crl\" />",{"_2886":824,"_27469":824,"_5":13057,"_2424":45585,"_27749":45586,"_18854":45587,"_25963":824},"Device enrollment with CMP",[43001,44136,44614],[],{"_2886":825,"_27469":824,"_18854":45589,"_5":12679,"_25963":824,"_2424":45590},[],"CMP protocol guide for Lamassu IoT, with the complete reference of DMS general and per-operation settings, and the operation reference for device integrators.",{"_2886":826,"_27469":824,"_5":27746,"_18854":45592,"_25963":45593,"_2424":45594},[],"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","CMP: Certificate Management Protocol",{"_2886":827,"_27469":824,"_5":27746,"_18854":45596,"_25963":45597,"_2424":45598},[],"/docs/pr-preview/pr-24/platform/pki/cmp#dms-configuration","DMS configuration",{"_2886":828,"_27469":824,"_5":27746,"_18854":45600,"_25963":45601,"_2424":45602},[],"/docs/pr-preview/pr-24/platform/pki/cmp#prerequisites","Prerequisites",{"_2886":829,"_27469":824,"_5":27746,"_18854":45604,"_25963":45605,"_2424":45606},[],"/docs/pr-preview/pr-24/platform/pki/cmp#protocol-selection","Protocol selection",{"_2886":830,"_27469":824,"_5":27746,"_18854":45608,"_25963":45609,"_2424":45610},[],"/docs/pr-preview/pr-24/platform/pki/cmp#general-enrollment-settings","General enrollment settings",{"_2886":831,"_27469":824,"_5":27746,"_18854":45612,"_25963":45613,"_2424":45614},[],"/docs/pr-preview/pr-24/platform/pki/cmp#settings-shared-with-est","Settings shared with EST",{"_2886":832,"_27469":824,"_5":27746,"_18854":45616,"_25963":45617,"_2424":45618},[],"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-mode","Authentication mode",{"_2886":833,"_27469":824,"_5":27746,"_18854":45620,"_25963":45621,"_2424":45622},[],"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-and-issuance-flow","Confirmation and issuance flow",{"_2886":834,"_27469":824,"_5":27746,"_18854":45624,"_25963":45625,"_2424":45626},[],"/docs/pr-preview/pr-24/platform/pki/cmp#protection-certificate-and-proof-of-possession","Protection certificate and proof of possession",{"_2886":835,"_27469":824,"_5":27746,"_18854":45628,"_25963":45629,"_2424":45630},[],"/docs/pr-preview/pr-24/platform/pki/cmp#per-operation-settings","Per-operation settings",{"_2886":836,"_27469":824,"_5":27746,"_18854":45632,"_25963":45633,"_2424":45634},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","`ir` — Initialization Request",{"_2886":837,"_27469":824,"_5":27746,"_18854":45636,"_25963":45637,"_2424":45638},[],"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","`cr` — Certification Request",{"_2886":838,"_27469":824,"_5":27746,"_18854":45640,"_25963":45641,"_2424":45642},[],"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","`p10cr` — PKCS#10 Certification Request",{"_2886":839,"_27469":824,"_5":27746,"_18854":45644,"_25963":45645,"_2424":45646},[],"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","`kur` — Key Update Request",{"_2886":840,"_27469":824,"_5":27746,"_18854":45648,"_25963":45649,"_2424":45650},[],"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","`rr` — Revocation Request",{"_2886":841,"_27469":824,"_5":27746,"_18854":45652,"_25963":45653,"_2424":45654},[],"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","`genm` — General Message",{"_2886":842,"_27469":824,"_5":27746,"_18854":45656,"_25963":45657,"_2424":45658},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","`ccr` — Cross-Certification Request",{"_2886":843,"_27469":824,"_5":27746,"_18854":45660,"_25963":45661,"_2424":45662},[],"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-central-key-generation","Server-side key generation (Central Key Generation)",{"_2886":844,"_27469":824,"_5":27746,"_18854":45664,"_25963":45665,"_2424":45666},[],"/docs/pr-preview/pr-24/platform/pki/cmp#re-enrollment-configuration","Re-enrollment configuration",{"_2886":845,"_27469":824,"_5":27746,"_18854":45668,"_25963":45669,"_2424":45670},[],"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-transactions","CMP transactions",{"_2886":846,"_27469":824,"_5":27746,"_18854":45672,"_25963":45673,"_2424":45674},[],"/docs/pr-preview/pr-24/platform/pki/cmp#confirmation-monitor","Confirmation monitor",{"_2886":847,"_27469":824,"_5":27746,"_18854":45676,"_25963":45677,"_2424":45678},[],"/docs/pr-preview/pr-24/platform/pki/cmp#wfx-integration-optional","WFX integration (optional)",{"_2886":848,"_27469":824,"_5":27746,"_18854":45680,"_25963":45681,"_2424":45682},[],"/docs/pr-preview/pr-24/platform/pki/cmp#verify-the-configuration","Verify the configuration",{"_2886":849,"_27469":824,"_5":27746,"_18854":45684,"_25963":45685,"_2424":45686},[],"/docs/pr-preview/pr-24/platform/pki/cmp#device-integration","Device integration",{"_2886":850,"_27469":824,"_5":27746,"_18854":45688,"_25963":45689,"_2424":43011},[],"/docs/pr-preview/pr-24/platform/pki/cmp#before-you-begin",{"_2886":851,"_27469":824,"_5":27746,"_18854":45691,"_25963":45692,"_2424":45693},[],"/docs/pr-preview/pr-24/platform/pki/cmp#the-cmp-endpoint","The CMP endpoint",{"_2886":852,"_27469":824,"_5":27746,"_18854":45695,"_25963":45696,"_2424":45697},[],"/docs/pr-preview/pr-24/platform/pki/cmp#authentication-model","Authentication model",{"_2886":853,"_27469":824,"_5":27746,"_18854":45699,"_25963":45700,"_2424":45701},[],"/docs/pr-preview/pr-24/platform/pki/cmp#supported-operations","Supported operations",{"_2886":854,"_27469":824,"_5":27746,"_18854":45703,"_25963":45704,"_2424":45705},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ir-and-cr","`ir` and `cr`",{"_2886":855,"_27469":824,"_5":27746,"_18854":45707,"_25963":45708,"_2424":45709},[],"/docs/pr-preview/pr-24/platform/pki/cmp#kur","`kur`",{"_2886":856,"_27469":824,"_5":27746,"_18854":45711,"_25963":45712,"_2424":45713},[],"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr","`p10cr`",{"_2886":857,"_27469":824,"_5":27746,"_18854":45715,"_25963":45716,"_2424":45717},[],"/docs/pr-preview/pr-24/platform/pki/cmp#rr","`rr`",{"_2886":858,"_27469":824,"_5":27746,"_18854":45719,"_25963":45720,"_2424":45721},[],"/docs/pr-preview/pr-24/platform/pki/cmp#genm","`genm`",{"_2886":859,"_27469":824,"_5":27746,"_18854":45723,"_25963":45724,"_2424":45725},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ccr","`ccr`",{"_2886":860,"_27469":824,"_5":27746,"_18854":45727,"_25963":45728,"_2424":45729},[],"/docs/pr-preview/pr-24/platform/pki/cmp#certconf-and-pollreq","`certConf` and `pollReq`",{"_2886":861,"_27469":824,"_5":27746,"_18854":45731,"_25963":45732,"_2424":45733},[],"/docs/pr-preview/pr-24/platform/pki/cmp#nested","`nested`",{"_2886":862,"_27469":824,"_5":27746,"_18854":45735,"_25963":45736,"_2424":45737},[],"/docs/pr-preview/pr-24/platform/pki/cmp#server-side-key-generation-kga","Server-side key generation (KGA)",{"_2886":863,"_27469":824,"_5":27746,"_18854":45739,"_25963":45740,"_2424":45741},[],"/docs/pr-preview/pr-24/platform/pki/cmp#example-with-openssl-cmp","Example with openssl cmp",{"_2886":864,"_27469":824,"_5":27746,"_18854":45743,"_25963":45744,"_2424":45745},[],"/docs/pr-preview/pr-24/platform/pki/cmp#next-steps-after-enrollment","Next steps after enrollment",{"_2886":865,"_27469":824,"_5":27746,"_18854":45747,"_25963":45748,"_2424":45749},[],"/docs/pr-preview/pr-24/platform/pki/cmp#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2886":866,"_27469":824,"_5":27746,"_18854":45751,"_25963":45752,"_2424":45753},[],"/docs/pr-preview/pr-24/platform/pki/cmp#error-codes-and-diagnostics","Error codes and diagnostics",{"_2886":867,"_27469":824,"_5":27746,"_18854":45755,"_25963":45756,"_2424":45757},[],"/docs/pr-preview/pr-24/platform/pki/cmp#compatibility-notes","Compatibility notes",{"_2886":868,"_27469":824,"_18854":45759,"_5":12679,"_25963":45593,"_2424":45760},[],"Lamassu IoT implements the &#x2A;*CMP (RFC 4210)** protocol following the &#x2A;*Lightweight CMP (RFC 9483)** profile as its second certificate enrollment mechanism for devices, alongside EST (RFC 7030). Each DMS exposes one of the two protocols — never both at once — and the one that exposes CMP acts as the Registration Authority (RA) facing the client.",{"_2886":869,"_27469":824,"_18854":45762,"_5":12679,"_25963":45593,"_2424":45763},[],"Compared with EST, CMP changes three fundamental ideas:",{"_2886":870,"_27469":824,"_18854":45765,"_5":12679,"_25963":45593,"_2424":45766},[],"Aspect",{"_2886":871,"_27469":824,"_18854":45768,"_5":12679,"_25963":45593,"_2424":45769},[],"EST (RFC 7030)",{"_2886":872,"_27469":824,"_18854":45771,"_5":12679,"_25963":45593,"_2424":45772},[],"CMP (RFC 4210 / RFC 9483)",{"_2886":873,"_27469":824,"_18854":45774,"_5":12679,"_25963":45593,"_2424":45775},[],"Endpoint",{"_2886":874,"_27469":824,"_18854":45777,"_5":12679,"_25963":45593,"_2424":45778},[],"One per operation (`/cacerts`, `/simpleenroll`, …)",{"_2886":875,"_27469":824,"_18854":45780,"_5":12679,"_25963":45593,"_2424":45781},[],"A **single multiplexed endpoint** (`/.well-known/cmp/p/{id}`); the operation is determined by the message content",{"_2886":876,"_27469":824,"_18854":45783,"_5":12679,"_25963":45593,"_2424":45784},[],"Authentication",{"_2886":877,"_27469":824,"_18854":45786,"_5":12679,"_25963":45593,"_2424":45787},[],"mTLS at the transport layer",{"_2886":878,"_27469":824,"_18854":45789,"_5":12679,"_25963":45593,"_2424":45790},[],"**Protection of the message itself** (`PKIMessage`) by signature or, in `ir`/`cr`, CRMF proof of possession",{"_2886":879,"_27469":824,"_18854":45792,"_5":12679,"_25963":45593,"_2424":45793},[],"Settings",{"_2886":880,"_27469":824,"_18854":45795,"_5":12679,"_25963":45593,"_2424":45796},[],"General enrollment and re-enrollment blocks",{"_2886":881,"_27469":824,"_18854":45798,"_5":12679,"_25963":45593,"_2424":45799},[],"General settings **plus a per-operation policy block** (`ir`, `cr`, `p10cr`, `kur`, `rr`, `genm`, `ccr`)",{"_2886":882,"_27469":824,"_18854":45801,"_5":12679,"_25963":45593,"_2424":45802},[],"Confirmation",{"_2886":883,"_27469":824,"_18854":45804,"_5":12679,"_25963":45593,"_2424":45805},[],"The response is the end of the flow",{"_2886":884,"_27469":824,"_18854":45807,"_5":12679,"_25963":45593,"_2424":45808},[],"An explicit confirmation protocol (`certConf`), negotiable implicit confirmation and stateful transactions",{"_2886":885,"_27469":824,"_18854":45810,"_5":12679,"_25963":45593,"_2424":45811},[],"Renewal",{"_2886":886,"_27469":824,"_18854":45813,"_5":12679,"_25963":45593,"_2424":45814},[],"`/simplereenroll` with the current certificate",{"_2886":887,"_27469":824,"_18854":45816,"_5":12679,"_25963":45593,"_2424":45817},[],"`kur` protected by the certificate being renewed, with per-DMS key and identity policy",{"_2886":888,"_27469":824,"_18854":45819,"_5":12679,"_25963":45593,"_2424":45820},[],"The protocol is selected with the DMS's `protocol` field (`EST_RFC7030` or `CMP_RFC9483`) and each has its own configuration block (`est_settings` / `cmp_settings`). Changing the protocol of an existing DMS replaces the previous protocol's block entirely: settings are not migrated from one to the other.",{"_2886":889,"_27469":824,"_18854":45822,"_5":12679,"_25963":45593,"_2424":45823},[],"This guide is split in two parts:",{"_2886":890,"_27469":824,"_18854":45825,"_5":12679,"_25963":45593,"_2424":45826},[],"DMS configuration, for the PKI administrator: every available setting, general and per-operation.",{"_2886":891,"_27469":824,"_18854":45828,"_5":12679,"_25963":45593,"_2424":45829},[],"Device integration, for anyone consuming the CMP endpoint from firmware, standard CMP libraries or provisioning services.",{"_2886":892,"_27469":824,"_18854":45831,"_5":12679,"_25963":45593,"_2424":45832},[],"If you only need a quick orientation:",{"_2886":893,"_27469":824,"_18854":45834,"_5":12679,"_25963":45593,"_2424":45835},[],"Profile",{"_2886":894,"_27469":824,"_18854":45837,"_5":12679,"_25963":45593,"_2424":45838},[],"Read first",{"_2886":895,"_27469":824,"_18854":45840,"_5":12679,"_25963":45593,"_2424":45841},[],"Then",{"_2886":896,"_27469":824,"_18854":45843,"_5":12679,"_25963":45593,"_2424":45844},[],"PKI administrator",{"_2886":897,"_27469":824,"_18854":45846,"_5":12679,"_25963":45593,"_2424":45847},[],"Protocol selection and Per-operation settings",{"_2886":898,"_27469":824,"_18854":45849,"_5":12679,"_25963":45593,"_2424":45850},[],"CMP transactions and Confirmation monitor",{"_2886":899,"_27469":824,"_18854":45852,"_5":12679,"_25963":45593,"_2424":45853},[],"Device integrator",{"_2886":900,"_27469":824,"_18854":45855,"_5":12679,"_25963":45593,"_2424":45856},[],"The CMP endpoint and Authentication model",{"_2886":901,"_27469":824,"_18854":45858,"_5":12679,"_25963":45593,"_2424":45859},[],"Supported operations and Error codes and diagnostics",{"_2886":902,"_27469":824,"_18854":45861,"_5":12679,"_25963":45601,"_2424":45862},[],"Before configuring a DMS for CMP, the following resources must exist on the platform:",{"_2886":903,"_27469":824,"_18854":45864,"_5":12679,"_25963":45601,"_2424":45865},[],"**An available CA**: the CA acting as `EnrollmentCA` must be created and active. If server-side key generation (KGA) is enabled, the CAs against which the recipient certificate is validated must also exist (see Server-side key generation).",{"_2886":904,"_27469":824,"_18854":45867,"_5":12679,"_25963":45601,"_2424":45868},[],"**A protection certificate**: CMP signs its own responses. The DMS needs an End Entity certificate whose private key lives in the Lamassu KMS (`protection_certificate`, see below).",{"_2886":905,"_27469":824,"_18854":45870,"_5":12679,"_25963":45601,"_2424":45871},[],"**A created DMS**: the CMP configuration is applied over an existing DMS, it does not create one.",{"_2886":906,"_27469":824,"_18854":45873,"_5":12679,"_25963":45601,"_2424":45874},[],"The **CA Distribution** settings (which authorities the device receives as anchors of trust) are identical for both protocols and are described in the DMS overview.",{"_2886":907,"_27469":824,"_18854":45876,"_5":12679,"_25963":45605,"_2424":45877},[],"When creating or editing a DMS, the `protocol` field decides which configuration block applies:",{"_2886":908,"_27469":824,"_18854":45879,"_5":12679,"_25963":45605,"_2424":45880},[],"Value",{"_2886":909,"_27469":824,"_18854":45882,"_5":12679,"_25963":45605,"_2424":45883},[],"Protocol",{"_2886":910,"_27469":824,"_18854":45885,"_5":12679,"_25963":45605,"_2424":45886},[],"`EST_RFC7030`",{"_2886":911,"_27469":824,"_18854":45888,"_5":12679,"_25963":45605,"_2424":45889},[],"EST — see the EST guide",{"_2886":912,"_27469":824,"_18854":45891,"_5":12679,"_25963":45605,"_2424":45892},[],"`CMP_RFC9483`",{"_2886":913,"_27469":824,"_18854":45894,"_5":12679,"_25963":45605,"_2424":45895},[],"CMP — this page",{"_2886":914,"_27469":824,"_18854":45897,"_5":12679,"_25963":45605,"_2424":45898},[],"Any value other than these two makes DMS creation or edition fail with the error `DMS enrollment protocol must be EST_RFC7030 or CMP_RFC9483`. When the `protocol` of an existing DMS changes, the outgoing protocol's block is discarded entirely and replaced by the incoming one: each protocol's settings are self-contained and are not copied across.",{"_2886":915,"_27469":824,"_18854":45900,"_5":12679,"_25963":45613,"_2424":45901},[],"These fields are common to both protocols and mean the same in each:",{"_2886":916,"_27469":824,"_18854":45903,"_5":12679,"_25963":45613,"_2424":45904},[],"Field",{"_2886":917,"_27469":824,"_18854":45906,"_5":12679,"_25963":45613,"_2424":45907},[],"Description",{"_2886":918,"_27469":824,"_18854":45909,"_5":12679,"_25963":45613,"_2424":45910},[],"`enrollment_ca`",{"_2886":919,"_27469":824,"_18854":45912,"_5":12679,"_25963":45613,"_2424":45913},[],"CA that will sign the identity certificates issued by this DMS.",{"_2886":920,"_27469":824,"_18854":45915,"_5":12679,"_25963":45613,"_2424":45916},[],"`registration_mode`",{"_2886":921,"_27469":824,"_18854":45918,"_5":12679,"_25963":45613,"_2424":45919},[],"`JITP` (*Just-In-Time Provisioning*) creates the device automatically on the first enrollment, applying the provisioning profile; `PRE_REGISTRATION` requires the device to exist beforehand and rejects anything else with `device not preregistered`.",{"_2886":922,"_27469":824,"_18854":45921,"_5":12679,"_25963":45613,"_2424":45922},[],"`device_provisioning_profile`",{"_2886":923,"_27469":824,"_18854":45924,"_5":12679,"_25963":45613,"_2424":45925},[],"Icon, color, metadata and tags applied to each device created in JITP mode.",{"_2886":924,"_27469":824,"_18854":45927,"_5":12679,"_25963":45613,"_2424":45928},[],"`enable_replaceable_enrollment`",{"_2886":925,"_27469":824,"_18854":45930,"_5":12679,"_25963":45613,"_2424":45931},[],"Allows an already-enrolled device to enroll again. When inactive, a second `ir`/`cr` attempt against an existing device is rejected with `forbiddenNewEnrollment`. Whether replacing the identity revokes the previous certificate (with the reason `superseded`) is decided by `revoke_on_reenrollment`, or by `cr`'s `certificate_behavior` — see Re-enrollment configuration.",{"_2886":926,"_27469":824,"_18854":45933,"_5":12679,"_25963":45613,"_2424":45934},[],"`verify_csr_signature`",{"_2886":927,"_27469":824,"_18854":45936,"_5":12679,"_25963":45613,"_2424":45937},[],"**No effect in CMP.** The server synthesizes the CSR from the `CertTemplate` (its signature is replaced with a dummy value) and proof of possession is established through other means: the POPO of `ir`/`cr`, the PKCS#10 CSR of `p10cr` (always verified) or the protection of `kur`.",{"_2886":928,"_27469":824,"_18854":45939,"_5":12679,"_25963":45617,"_2424":45940},[],"`auth_mode` defines how the DMS validates the requester's identity. CMP recognizes the same four modes as EST, but the mechanism changes: **authentication is verified inside the CMP message itself, not at the transport layer**.",{"_2886":929,"_27469":824,"_18854":45942,"_5":12679,"_25963":45617,"_2424":45943},[],"Mode",{"_2886":930,"_27469":824,"_18854":45945,"_5":12679,"_25963":45617,"_2424":45907},[],{"_2886":931,"_27469":824,"_18854":45947,"_5":12679,"_25963":45617,"_2424":45948},[],"`CLIENT_CERTIFICATE`",{"_2886":932,"_27469":824,"_18854":45950,"_5":12679,"_25963":45617,"_2424":45951},[],"The message must be **protected by signature** with the device's certificate (`extraCerts[0]` of the `PKIMessage`), validated against the CAs declared in `client_certificate_settings.validation_cas`. This is not mTLS: it is the signature over the `PKIMessage` (RFC 9483 §3.2).",{"_2886":933,"_27469":824,"_18854":45953,"_5":12679,"_25963":45617,"_2424":45954},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2886":934,"_27469":824,"_18854":45956,"_5":12679,"_25963":45617,"_2424":45957},[],"Combines both controls: valid signature **and** webhook approval.",{"_2886":935,"_27469":824,"_18854":45959,"_5":12679,"_25963":45617,"_2424":45960},[],"`EXTERNAL_WEBHOOK`",{"_2886":936,"_27469":824,"_18854":45962,"_5":12679,"_25963":45617,"_2424":45963},[],"The authorization decision is delegated to an external HTTP service, with the same contract as in EST. The message may arrive unprotected.",{"_2886":937,"_27469":824,"_18854":45965,"_5":12679,"_25963":45617,"_2424":45966},[],"`NO_AUTH`",{"_2886":938,"_27469":824,"_18854":45968,"_5":12679,"_25963":45617,"_2424":45969},[],"No mandatory authentication. The message may arrive unprotected; if it carries a signature, it is still validated. &#x2A;*For laboratories or isolated provisioning networks only.**",{"_2886":939,"_27469":824,"_18854":45971,"_5":12679,"_25963":45617,"_2424":45972},[],"A DMS whose `auth_mode` is empty or undefined is considered misconfigured: every request is rejected with `DMS auth mode not supported`, instead of being accepted unauthenticated. The value `NONE` is accepted as a legacy alias of `NO_AUTH` from the admin console.",{"_2886":940,"_27469":824,"_18854":45974,"_5":12679,"_25963":45617,"_2424":45975},[],"When the mode includes `CLIENT_CERTIFICATE`, the same parameters as in EST are configured: **Validation CAs**, **Chain Validation Level** (`-1` validates the full chain) and **Allow Authenticating Expired Certificates**. When it includes `EXTERNAL_WEBHOOK`, the same webhook parameters as in EST are configured (URL, method, timeout — 10 seconds by default — and the webhook's authentication mode). The webhook service contract is identical in both protocols; see the equivalent section of the EST guide for the detail of each field and the authorization webhook reference for the schema.",{"_2886":941,"_27469":824,"_18854":45977,"_5":12679,"_25963":45617,"_2424":45978},[],"Unlike EST, CMP has no separate authentication mode for renewal: `kur` is always authenticated with the signature protection of the certificate being renewed.",{"_2886":942,"_27469":824,"_18854":45980,"_5":12679,"_25963":45621,"_2424":45981},[],"Unlike EST, CMP includes an explicit confirmation protocol (RFC 4210 §5.2.8) and supports a deferred-approval flow:",{"_2886":943,"_27469":824,"_18854":45983,"_5":12679,"_25963":45621,"_2424":45904},[],{"_2886":944,"_27469":824,"_18854":45985,"_5":12679,"_25963":45621,"_2424":45986},[],"Type",{"_2886":945,"_27469":824,"_18854":45988,"_5":12679,"_25963":45621,"_2424":45907},[],{"_2886":946,"_27469":824,"_18854":45990,"_5":12679,"_25963":45621,"_2424":45991},[],"`accept_implicit`",{"_2886":947,"_27469":824,"_18854":45993,"_5":12679,"_25963":45621,"_2424":17610},[],{"_2886":948,"_27469":824,"_18854":45995,"_5":12679,"_25963":45621,"_2424":45996},[],"Allows **skipping** the `certConf` step when the device requests implicit confirmation (`id-it-implicitConfirm` in `generalInfo`). It only takes effect if the device also requests it; the request alone does not force it. Disabled by default.",{"_2886":949,"_27469":824,"_18854":45998,"_5":12679,"_25963":45621,"_2424":45999},[],"`confirmation_timeout`",{"_2886":950,"_27469":824,"_18854":46001,"_5":12679,"_25963":45621,"_2424":4756},[],{"_2886":951,"_27469":824,"_18854":46003,"_5":12679,"_25963":45621,"_2424":46004},[],"Waiting window for the `certConf` (for example `30s`, `5m`, `1h`). A zero or negative value uses the default: **5 minutes**.",{"_2886":952,"_27469":824,"_18854":46006,"_5":12679,"_25963":45621,"_2424":46007},[],"`workflow`",{"_2886":953,"_27469":824,"_18854":46009,"_5":12679,"_25963":45621,"_2424":46010},[],"`direct` / `phased`",{"_2886":954,"_27469":824,"_18854":46012,"_5":12679,"_25963":45621,"_2424":46013},[],"`direct` (default) issues the certificate online, in the same response to `ir`/`cr`/`kur`/`p10cr`. `phased` holds the request until an administrator approves it; the device retrieves the result with `pollReq`. Server-side key generation and cross-certification have their own flow and do not depend on this field.",{"_2886":955,"_27469":824,"_18854":46015,"_5":12679,"_25963":45621,"_2424":46016},[],"`approval_timeout`",{"_2886":956,"_27469":824,"_18854":46018,"_5":12679,"_25963":45621,"_2424":4756},[],{"_2886":957,"_27469":824,"_18854":46020,"_5":12679,"_25963":45621,"_2424":46021},[],"Only applies with `workflow: phased`. Time a transaction remains `PENDING` awaiting approval. With no value, the default is **7 days**.",{"_2886":958,"_27469":824,"_18854":46023,"_5":12679,"_25963":45625,"_2424":46024},[],"**Protection Certificate** (`protection_certificate`): serial number of the End Entity certificate, backed by the KMS, with which the DMS protects (signs) its CMP responses. The server does not require it, but without it **every** response — including error messages — goes out unprotected, and standard CMP clients (`openssl cmp` included) reject unprotected responses by default. In practice it is essential.",{"_2886":959,"_27469":824,"_18854":46026,"_5":12679,"_25963":45625,"_2424":46027},[],"**Enforce POPO** (`enforce_popo`): a legacy option that **no longer governs any verification**. The proof-of-possession policy of `ir`/`cr` lives in its per-operation block (`proof_of_possession.required`), `kur` and `rr` are always signature-protected as protocol invariants, and the `p10cr` CSR signature is always verified. The field persists and round-trips through the API, but its value does not change behavior.",{"_2886":960,"_27469":824,"_18854":46029,"_5":12679,"_25963":45625,"_2424":46030},[],"**Expected Authenticator** (`expected_authenticator`): shared answer compared against the `id-regCtrl-authenticator` control (RFC 4211 §6.2) when an issuance request (`ir`/`cr`/`kur`) includes it. Empty by default: a present control is accepted without comparing its value. With a value configured, a control whose content does not match is rejected with `incorrectData`. **Marked as legacy**: it stores a plaintext secret on the DMS; new configuration should use the per-operation `registration_token`/`authenticator_control` controls, which store only a mode.",{"_2886":961,"_27469":824,"_18854":46032,"_5":12679,"_25963":45629,"_2424":46033},[],"Besides the general fields above, each CMP operation has its own configuration block with an `enabled` switch and a specific policy. The issuance operations (`ir`, `cr`, `p10cr`, `kur`) also support `policy_overrides`:",{"_2886":962,"_27469":824,"_18854":46035,"_5":12679,"_25963":45629,"_2424":46036},[],"`policy_overrides.workflow`: `inherit` (takes the general `workflow`), `direct` or `phased`.",{"_2886":963,"_27469":824,"_18854":46038,"_5":12679,"_25963":45629,"_2424":46039},[],"`policy_overrides.confirmation`: `inherit`, `implicit` (forces willingness to accept implicit confirmation) or `explicit` (forces the `certConf`).",{"_2886":964,"_27469":824,"_18854":46041,"_5":12679,"_25963":45629,"_2424":46042},[],"`policy_overrides.issuance_profile_id`: pins a specific issuance profile for that operation. It applies in `ir`, `cr` and `p10cr`; `kur` always renews with the DMS's general profile.",{"_2886":965,"_27469":824,"_18854":46044,"_5":12679,"_25963":45629,"_2424":46045},[],"Effective implicit confirmation always additionally requires the device to request it (`id-it-implicitConfirm`): the setting only expresses the server's willingness.",{"_2886":966,"_27469":824,"_18854":46047,"_5":12679,"_25963":45629,"_2424":46048},[],"Each per-operation block detects whether it has never been configured by observing a **key field**: `identity_source` in `ir`, `certificate_behavior` in `cr`, `key_policy` in `kur`, `authorization` in `rr`, `access_policy` in `genm` and `workflow` in `ccr`. If that field arrives empty, the block is filled in entirely with its default values on every read of the DMS — including any other field that was sent. To adjust a secondary field (for example, `cr`'s `maximum_active_certificates`) you must also set the block's key field, or resolution resets it to the default. `p10cr` has no key field: it stays disabled unless `enabled: true` is set explicitly.",{"_2886":967,"_27469":824,"_18854":46050,"_5":12679,"_25963":45633,"_2424":46051},[],"Initial enrollment of a new device (RFC 9483 §4.1.1), the equivalent of EST's `/simpleenroll`. Enabled by default.",{"_2886":968,"_27469":824,"_18854":46053,"_5":12679,"_25963":45633,"_2424":45904},[],{"_2886":969,"_27469":824,"_18854":46055,"_5":12679,"_25963":45633,"_2424":45907},[],{"_2886":970,"_27469":824,"_18854":46057,"_5":12679,"_25963":45633,"_2424":46058},[],"`enabled`",{"_2886":971,"_27469":824,"_18854":46060,"_5":12679,"_25963":45633,"_2424":46061},[],"Enables the operation. Disabling it rejects any `ir` with `notAuthorized`.",{"_2886":972,"_27469":824,"_18854":46063,"_5":12679,"_25963":45633,"_2424":46064},[],"`proof_of_possession.required`",{"_2886":973,"_27469":824,"_18854":46066,"_5":12679,"_25963":45633,"_2424":46067},[],"Whether the POPO is mandatory. Default `true`: an `ir` without an acceptable proof of possession is rejected with `badPOP`.",{"_2886":974,"_27469":824,"_18854":46069,"_5":12679,"_25963":45633,"_2424":46070},[],"`proof_of_possession.allowed_methods`",{"_2886":975,"_27469":824,"_18854":46072,"_5":12679,"_25963":45633,"_2424":46073},[],"Accepted POPO methods: `signature` (POPOSigningKey over the CertRequest), `trusted_ra` (`raVerified` from a trusted RA with EKU `id-kp-cmcRA`), `challenge_response` (challenge-response `popdecc`/`popdecr`) and `encrypted_certificate` (the certificate is delivered encrypted to the recipient, who proves possession by decrypting it). Default `signature` + `trusted_ra`. An empty list admits no method.",{"_2886":976,"_27469":824,"_18854":46075,"_5":12679,"_25963":45633,"_2424":46076},[],"`registration_token`",{"_2886":977,"_27469":824,"_18854":46078,"_5":12679,"_25963":45633,"_2424":46079},[],"RFC 4211 §6.1 control with mode `disabled` (default), `optional` or `required`. The mode governs the **presence** of the control: `disabled` rejects an `ir` that carries it; `required` demands it; `optional` processes it when present. regToken values are one-use credentials provisioned outside the DMS (never stored in the configuration): an already-consumed value is rejected with `the regToken control was already used (RFC 4211 §6.1)`, and the token is burned even if issuance later fails.",{"_2886":978,"_27469":824,"_18854":46081,"_5":12679,"_25963":45633,"_2424":46082},[],"`authenticator_control`",{"_2886":979,"_27469":824,"_18854":46084,"_5":12679,"_25963":45633,"_2424":46085},[],"RFC 4211 §6.2 control with the same three modes. With `expected_authenticator` configured, `optional`/`required` validate the value; without it, presence is enough.",{"_2886":980,"_27469":824,"_18854":46087,"_5":12679,"_25963":45633,"_2424":46088},[],"`central_key_generation.allowed_recipient_methods`",{"_2886":981,"_27469":824,"_18854":46090,"_5":12679,"_25963":45633,"_2424":46091},[],"Key-delivery methods this operation accepts for the generated key: `rsa_key_transport` and/or `ecdh_key_agreement`. Unset accepts both; an explicitly empty list denies any generated-key delivery.",{"_2886":982,"_27469":824,"_18854":46093,"_5":12679,"_25963":45633,"_2424":46094},[],"`central_key_generation.enabled`",{"_2886":983,"_27469":824,"_18854":46096,"_5":12679,"_25963":45633,"_2424":46097},[],"Merges with the general `server_key_gen_enabled` switch and with `cr`'s into a single KGA gate (see Server-side key generation).",{"_2886":984,"_27469":824,"_18854":46099,"_5":12679,"_25963":45633,"_2424":46100},[],"`identity_source`",{"_2886":985,"_27469":824,"_18854":46102,"_5":12679,"_25963":45633,"_2424":46103},[],"Selects where the identity is taken from when the subject arrives empty (`subject_only` / `subject_or_san`). **Persisted but not yet enforced**: the current behavior is fixed — with an empty subject, the identity is derived from the SAN (`dNSName`, email, URI, IP, in that order) and the issued certificate keeps the NULL-DN subject.",{"_2886":986,"_27469":824,"_18854":46105,"_5":12679,"_25963":45633,"_2424":46106},[],"`policy_overrides`",{"_2886":987,"_27469":824,"_18854":46108,"_5":12679,"_25963":45633,"_2424":46109},[],"See the introduction of this section.",{"_2886":988,"_27469":824,"_18854":46111,"_5":12679,"_25963":45637,"_2424":46112},[],"Issuance for a device that already participates in the PKI (RFC 9483 §4.1.2). Enabled by default. Shares with `ir` the `proof_of_possession`, `central_key_generation` and `policy_overrides` structure, and adds:",{"_2886":989,"_27469":824,"_18854":46114,"_5":12679,"_25963":45637,"_2424":45904},[],{"_2886":990,"_27469":824,"_18854":46116,"_5":12679,"_25963":45637,"_2424":45907},[],{"_2886":991,"_27469":824,"_18854":46118,"_5":12679,"_25963":45637,"_2424":46119},[],"`require_existing_device`",{"_2886":992,"_27469":824,"_18854":46121,"_5":12679,"_25963":45637,"_2424":46122},[],"Default `true`: a `cr` against an unregistered device is rejected with `certification request requires a pre-existing device identity`. Disabling it lets a `cr` also register the device (subject to the registration mode and, if the device already exists, to `enable_replaceable_enrollment`).",{"_2886":993,"_27469":824,"_18854":46124,"_5":12679,"_25963":45637,"_2424":46125},[],"`certificate_behavior`",{"_2886":994,"_27469":824,"_18854":46127,"_5":12679,"_25963":45637,"_2424":46128},[],"`additional` (default) issues one more certificate without revoking the previous one; `replace` replaces the active certificate (the previous one is revoked as `superseded` after the new one is issued and bound). The data model keeps a single active identity slot per device, so `additional` does not create a second active identity in parallel: it only avoids revoking the previous one.",{"_2886":995,"_27469":824,"_18854":46130,"_5":12679,"_25963":45637,"_2424":46131},[],"`maximum_active_certificates`",{"_2886":996,"_27469":824,"_18854":46133,"_5":12679,"_25963":45637,"_2424":46134},[],"Cap on non-revoked certificates per device. Default `2`; `0` disables the cap. The count is revalidated under lock right before signing, to close the race between two concurrent `cr` requests.",{"_2886":997,"_27469":824,"_18854":46136,"_5":12679,"_25963":45637,"_2424":46137},[],"`allowed_profile_ids`",{"_2886":998,"_27469":824,"_18854":46139,"_5":12679,"_25963":45637,"_2424":46140},[],"Allow-list of issuance profiles permitted for this operation. The resolved profile (pinned by `policy_overrides.issuance_profile_id` or the DMS's general one) must be on the list; empty does not restrict.",{"_2886":999,"_27469":824,"_18854":46142,"_5":12679,"_25963":45637,"_2424":46143},[],"`cr` also inherits the general enrollment safeguards: the device must belong to this DMS (a device registered to another DMS is rejected with `device already registered to another DMS`) and, if it already exists, `enable_replaceable_enrollment` is required. When a `cr` with `replace` replaces the identity, `kur`'s `key_policy` also applies: with `require_new_key`, the `cr` cannot replace the active certificate using the same public key.",{"_2886":1000,"_27469":824,"_18854":46145,"_5":12679,"_25963":45641,"_2424":46146},[],"Enrollment with a complete PKCS#10 CSR instead of the CRMF structure (RFC 9483 §4.1.4). **Shipped disabled**: `enabled: true` must be set on the DMS or every `p10cr` request is rejected with `notAuthorized`.",{"_2886":1001,"_27469":824,"_18854":46148,"_5":12679,"_25963":45641,"_2424":45904},[],{"_2886":1002,"_27469":824,"_18854":46150,"_5":12679,"_25963":45641,"_2424":45907},[],{"_2886":1003,"_27469":824,"_18854":46152,"_5":12679,"_25963":45641,"_2424":46058},[],{"_2886":1004,"_27469":824,"_18854":46154,"_5":12679,"_25963":45641,"_2424":46155},[],"Enables the operation. Disabled by default.",{"_2886":1005,"_27469":824,"_18854":46157,"_5":12679,"_25963":45641,"_2424":46137},[],{"_2886":1006,"_27469":824,"_18854":46159,"_5":12679,"_25963":45641,"_2424":46160},[],"Allow-list of permitted issuance profiles, same as in `cr`.",{"_2886":1007,"_27469":824,"_18854":46162,"_5":12679,"_25963":45641,"_2424":46106},[],{"_2886":1008,"_27469":824,"_18854":46164,"_5":12679,"_25963":45641,"_2424":46109},[],{"_2886":1009,"_27469":824,"_18854":46166,"_5":12679,"_25963":45641,"_2424":46167},[],"Fixed protocol invariants, not configurable: the CSR's own signature **is** the proof of possession and is always verified; there is no CRMF POPO to configure; server-side key generation is not available (the client supplies its key); and the CRMF registration controls (`regToken`, `authenticator`) do not apply. The response is a `cp` with `certReqId` `-1`, the value the subsequent `certConf` must use (RFC 4210 Errata 8806).",{"_2886":1010,"_27469":824,"_18854":46169,"_5":12679,"_25963":45645,"_2424":46170},[],"Renewal of a certificate (RFC 9483 §4.1.3), the equivalent of EST's `/simplereenroll`. Enabled by default. The message must be **protected by signature with the certificate being renewed** — a protocol invariant, not configurable.",{"_2886":1011,"_27469":824,"_18854":46172,"_5":12679,"_25963":45645,"_2424":45904},[],{"_2886":1012,"_27469":824,"_18854":46174,"_5":12679,"_25963":45645,"_2424":45907},[],{"_2886":1013,"_27469":824,"_18854":46176,"_5":12679,"_25963":45645,"_2424":46058},[],{"_2886":1014,"_27469":824,"_18854":46178,"_5":12679,"_25963":45645,"_2424":46179},[],"Enables the operation.",{"_2886":1015,"_27469":824,"_18854":46181,"_5":12679,"_25963":45645,"_2424":46182},[],"`key_policy`",{"_2886":1016,"_27469":824,"_18854":46184,"_5":12679,"_25963":45645,"_2424":46185},[],"`require_new_key` (default) requires a public key different from the certificate being renewed (`key update must present a new key`); `permit_reuse` allows renewing without rotating the key.",{"_2886":1017,"_27469":824,"_18854":46187,"_5":12679,"_25963":45645,"_2424":46188},[],"`identity_change_policy`",{"_2886":1018,"_27469":824,"_18854":46190,"_5":12679,"_25963":45645,"_2424":46191},[],"How much the identity may change relative to the current certificate: `forbid` (default; subject and SAN must match), `san_only` (the subject must match; the SAN may change) or `subject_and_san` (any change).",{"_2886":1019,"_27469":824,"_18854":46193,"_5":12679,"_25963":45645,"_2424":46194},[],"`policy_overrides.workflow` / `.confirmation`",{"_2886":1020,"_27469":824,"_18854":46196,"_5":12679,"_25963":45645,"_2424":46197},[],"Same as in the other issuance operations.",{"_2886":1021,"_27469":824,"_18854":46199,"_5":12679,"_25963":45645,"_2424":46200},[],"Fixed invariants: only one key update may be open per certificate (a second `kur` while the first awaits `certConf` is rejected with `badRequest`); the previous identity stays active until confirmation; and a never-confirmed new certificate is revoked when the window expires. The optional `id-regCtrl-oldCertID` control, if sent, must reference exactly the certificate being renewed (`badCertId` otherwise). `policy_overrides.issuance_profile_id` is defined in the schema but **not yet enforced** in `kur`.",{"_2886":1022,"_27469":824,"_18854":46202,"_5":12679,"_25963":45649,"_2424":46203},[],"Revocation over CMP (RFC 9483 §4.2). Enabled by default. The message **must always be protected by signature** — a protocol invariant, independent of `auth_mode`: an unsigned `rr` is never accepted, not even in `NO_AUTH` mode.",{"_2886":1023,"_27469":824,"_18854":46205,"_5":12679,"_25963":45649,"_2424":45904},[],{"_2886":1024,"_27469":824,"_18854":46207,"_5":12679,"_25963":45649,"_2424":45907},[],{"_2886":1025,"_27469":824,"_18854":46209,"_5":12679,"_25963":45649,"_2424":46058},[],{"_2886":1026,"_27469":824,"_18854":46211,"_5":12679,"_25963":45649,"_2424":46179},[],{"_2886":1027,"_27469":824,"_18854":46213,"_5":12679,"_25963":45649,"_2424":46214},[],"`authorization`",{"_2886":1028,"_27469":824,"_18854":46216,"_5":12679,"_25963":45649,"_2424":46217},[],"`self_only` (default): only the device itself may revoke its certificate — the message signer must be the revoked certificate. `self_and_trusted_ra`: a trusted PKI management entity (EKU `id-kp-cmcRA`, validated against the DMS's CAs) may additionally revoke another's certificate.",{"_2886":1029,"_27469":824,"_18854":46219,"_5":12679,"_25963":45649,"_2424":46220},[],"`allow_revival`",{"_2886":1030,"_27469":824,"_18854":46222,"_5":12679,"_25963":45649,"_2424":46223},[],"Disabled by default. Allows reactivating a revoked certificate through the reason `removeFromCRL`; revival is only possible for certificates whose revocation was a suspension (`certificateHold`).",{"_2886":1031,"_27469":824,"_18854":46225,"_5":12679,"_25963":45649,"_2424":46226},[],"`allowed_reasons`",{"_2886":1032,"_27469":824,"_18854":46228,"_5":12679,"_25963":45649,"_2424":46229},[],"Allow-list of accepted revocation reasons. Default `unspecified`, `key_compromise`, `cessation_of_operation` and `superseded`. Accepted values: `unspecified`, `key_compromise`, `ca_compromise`, `affiliation_changed`, `superseded`, `cessation_of_operation`, `privilege_withdrawn`, `aa_compromise`. The reason `certificateHold` is not on the list and is not subject to it: it suspends the certificate and is the only reversible revocation; reactivation is governed by `allow_revival`.",{"_2886":1033,"_27469":824,"_18854":46231,"_5":12679,"_25963":45649,"_2424":46232},[],"`trusted_ra.require_cmc_ra_eku`",{"_2886":1034,"_27469":824,"_18854":46234,"_5":12679,"_25963":45649,"_2424":46235},[],"Default `true`: requires the EKU `id-kp-cmcRA` on the RA signer.",{"_2886":1035,"_27469":824,"_18854":46237,"_5":12679,"_25963":45649,"_2424":46238},[],"`trusted_ra.validation_ca_ids`",{"_2886":1036,"_27469":824,"_18854":46240,"_5":12679,"_25963":45649,"_2424":46241},[],"Fixes which CAs must validate the RA certificate; an explicit list replaces the general boundary. Empty: the DMS's general trust boundary applies (the `EnrollmentCA` plus the authentication and re-enrollment validation CAs).",{"_2886":1037,"_27469":824,"_18854":46243,"_5":12679,"_25963":45649,"_2424":46244},[],"Operational notes: revoking an already-expired certificate is never permitted (the CA service rejects status transitions on expired certificates); the target certificate must belong to a device managed by this DMS — a trusted RA cannot revoke certificates of other DMSs (`notAuthorized`); while a certificate has a key update pending confirmation its status cannot change (`badRequest`); and an `rr` cannot be replayed with the same `transactionID` (`transactionIdInUse`).",{"_2886":1038,"_27469":824,"_18854":46246,"_5":12679,"_25963":45653,"_2424":46247},[],"Discovery channel (RFC 9483 §4.3): the device queries the DMS's capabilities and the DMS answers with a `genp`. It issues no certificates. Enabled by default.",{"_2886":1039,"_27469":824,"_18854":46249,"_5":12679,"_25963":45653,"_2424":45904},[],{"_2886":1040,"_27469":824,"_18854":46251,"_5":12679,"_25963":45653,"_2424":45907},[],{"_2886":1041,"_27469":824,"_18854":46253,"_5":12679,"_25963":45653,"_2424":46254},[],"`access_policy`",{"_2886":1042,"_27469":824,"_18854":46256,"_5":12679,"_25963":45653,"_2424":46257},[],"`public_discovery` (default) answers without requiring a protected message; `require_signed` rejects an unsigned `genm` with `notAuthorized`.",{"_2886":1043,"_27469":824,"_18854":46259,"_5":12679,"_25963":45653,"_2424":46260},[],"`preferred_symmetric_algorithm`",{"_2886":1044,"_27469":824,"_18854":46262,"_5":12679,"_25963":45653,"_2424":46263},[],"Symmetric algorithm the DMS advertises for content encryption toward the CA: `aes128_cbc`, `aes192_cbc`, `aes256_cbc` (default), `aes128_gcm`, `aes192_gcm` or `aes256_gcm`.",{"_2886":1045,"_27469":824,"_18854":46265,"_5":12679,"_25963":45653,"_2424":46266},[],"`information_types.*`",{"_2886":1046,"_27469":824,"_18854":46268,"_5":12679,"_25963":45653,"_2424":46269},[],"Independent switches per information type — see the table below.",{"_2886":1047,"_27469":824,"_18854":46271,"_5":12679,"_25963":45653,"_2424":46272},[],"Each `information_types.*` switch corresponds to an RFC 9483 §4.3 information type. The purely descriptive (static) types are enabled by default; the ones that depend on the DMS's concrete configuration — its CAs, its issuance profile or its VA client — stay disabled until the operator enables them:",{"_2886":1048,"_27469":824,"_18854":46274,"_5":12679,"_25963":45653,"_2424":46275},[],"Information type",{"_2886":1049,"_27469":824,"_18854":46277,"_5":12679,"_25963":45653,"_2424":46278},[],"OID (`id-it-*`)",{"_2886":1050,"_27469":824,"_18854":46280,"_5":12679,"_25963":45653,"_2424":43381},[],{"_2886":1051,"_27469":824,"_18854":46282,"_5":12679,"_25963":45653,"_2424":46283},[],"Response content",{"_2886":1052,"_27469":824,"_18854":46285,"_5":12679,"_25963":45653,"_2424":46286},[],"`ca_certificates`",{"_2886":1053,"_27469":824,"_18854":46288,"_5":12679,"_25963":45653,"_2424":46289},[],"`caCerts` (17)",{"_2886":1054,"_27469":824,"_18854":46291,"_5":12679,"_25963":45653,"_2424":46292},[],"Enabled",{"_2886":1055,"_27469":824,"_18854":46294,"_5":12679,"_25963":45653,"_2424":46295},[],"Certificates of the DMS's CAs, with the same trust distribution as EST's `/cacerts`.",{"_2886":1056,"_27469":824,"_18854":46297,"_5":12679,"_25963":45653,"_2424":46298},[],"`signing_key_types`",{"_2886":1057,"_27469":824,"_18854":46300,"_5":12679,"_25963":45653,"_2424":46301},[],"`signKeyPairTypes` (2)",{"_2886":1058,"_27469":824,"_18854":46303,"_5":12679,"_25963":45653,"_2424":46292},[],{"_2886":1059,"_27469":824,"_18854":46305,"_5":12679,"_25963":45653,"_2424":46306},[],"Supported signature algorithms: RSA and ECC (static value).",{"_2886":1060,"_27469":824,"_18854":46308,"_5":12679,"_25963":45653,"_2424":46309},[],"`encryption_key_types`",{"_2886":1061,"_27469":824,"_18854":46311,"_5":12679,"_25963":45653,"_2424":46312},[],"`encKeyPairTypes` (3)",{"_2886":1062,"_27469":824,"_18854":46314,"_5":12679,"_25963":45653,"_2424":46292},[],{"_2886":1063,"_27469":824,"_18854":46316,"_5":12679,"_25963":45653,"_2424":46317},[],"Supported encryption/agreement algorithms: RSA (static value).",{"_2886":1064,"_27469":824,"_18854":46319,"_5":12679,"_25963":45653,"_2424":46260},[],{"_2886":1065,"_27469":824,"_18854":46321,"_5":12679,"_25963":45653,"_2424":46322},[],"`preferredSymmAlg` (4)",{"_2886":1066,"_27469":824,"_18854":46324,"_5":12679,"_25963":45653,"_2424":46292},[],{"_2886":1067,"_27469":824,"_18854":46326,"_5":12679,"_25963":45653,"_2424":46327},[],"The algorithm configured in `preferred_symmetric_algorithm`.",{"_2886":1068,"_27469":824,"_18854":46329,"_5":12679,"_25963":45653,"_2424":46330},[],"`supported_languages`",{"_2886":1069,"_27469":824,"_18854":46332,"_5":12679,"_25963":45653,"_2424":46333},[],"`supportedLangTags` (16)",{"_2886":1070,"_27469":824,"_18854":46335,"_5":12679,"_25963":45653,"_2424":46292},[],{"_2886":1071,"_27469":824,"_18854":46337,"_5":12679,"_25963":45653,"_2424":46338},[],"Language negotiation for `PKIFreeText`; the only supported one is `en`.",{"_2886":1072,"_27469":824,"_18854":46340,"_5":12679,"_25963":45653,"_2424":46341},[],"`root_ca_update`",{"_2886":1073,"_27469":824,"_18854":46343,"_5":12679,"_25963":45653,"_2424":46344},[],"`rootCaCert` (20)",{"_2886":1074,"_27469":824,"_18854":46346,"_5":12679,"_25963":45653,"_2424":46347},[],"Disabled",{"_2886":1075,"_27469":824,"_18854":46349,"_5":12679,"_25963":45653,"_2424":46350},[],"Update of the current root (`newWithNew`/`newWithOld`), compared against the root the device declares.",{"_2886":1076,"_27469":824,"_18854":46352,"_5":12679,"_25963":45653,"_2424":46353},[],"`certificate_request_template`",{"_2886":1077,"_27469":824,"_18854":46355,"_5":12679,"_25963":45653,"_2424":46356},[],"`certReqTemplate` (19)",{"_2886":1078,"_27469":824,"_18854":46358,"_5":12679,"_25963":45653,"_2424":46347},[],{"_2886":1079,"_27469":824,"_18854":46360,"_5":12679,"_25963":45653,"_2424":46361},[],"Template derived from the DMS's issuance profile: supported key algorithms and sizes, and certificate validity.",{"_2886":1080,"_27469":824,"_18854":46363,"_5":12679,"_25963":45653,"_2424":46364},[],"`current_crl`",{"_2886":1081,"_27469":824,"_18854":46366,"_5":12679,"_25963":45653,"_2424":46367},[],"`currentCRL` (6)",{"_2886":1082,"_27469":824,"_18854":46369,"_5":12679,"_25963":45653,"_2424":46347},[],{"_2886":1083,"_27469":824,"_18854":46371,"_5":12679,"_25963":45653,"_2424":46372},[],"Current CRL, served through the VA client of the DMS Manager service.",{"_2886":1084,"_27469":824,"_18854":46374,"_5":12679,"_25963":45653,"_2424":46375},[],"`crl_update`",{"_2886":1085,"_27469":824,"_18854":46377,"_5":12679,"_25963":45653,"_2424":46378},[],"`crlStatusList` (22)",{"_2886":1086,"_27469":824,"_18854":46380,"_5":12679,"_25963":45653,"_2424":46347},[],{"_2886":1087,"_27469":824,"_18854":46382,"_5":12679,"_25963":45653,"_2424":46383},[],"CRL updates per issuer, only those newer than the one the device declares.",{"_2886":1088,"_27469":824,"_18854":46385,"_5":12679,"_25963":45653,"_2424":46386},[],"`protocol_encryption_certificate`",{"_2886":1089,"_27469":824,"_18854":46388,"_5":12679,"_25963":45653,"_2424":46389},[],"`caProtEncCert` (1)",{"_2886":1090,"_27469":824,"_18854":46391,"_5":12679,"_25963":45653,"_2424":46347},[],{"_2886":1091,"_27469":824,"_18854":46393,"_5":12679,"_25963":45653,"_2424":46394},[],"Always answered without a value — Lamassu does not provision a dedicated protocol-encryption certificate.",{"_2886":1092,"_27469":824,"_18854":46396,"_5":12679,"_25963":45653,"_2424":46397},[],"Exchange rules: a `genm` requesting a disabled type is rejected entirely with `notAuthorized`; the types `caCerts`, `certReqTemplate`, `currentCRL`, `signKeyPairTypes`, `encKeyPairTypes` and `preferredSymmAlg` must arrive without `infoValue`; `supportedLangTags` must arrive with the list of offered languages (if none is supported, `badRequest`); `crlStatusList` must carry at least one `CRLStatus` entry. An enabled type whose data provider has nothing to return (for example, a DMS without a VA client for the CRL types, or a root with no newer update) answers with the absent `infoValue` — a valid *not available* per the RFC, not an error. The type `id-it-revPassphrase` (RFC 4210bis §5.3.19.9) is permanently disabled: it is not wired into the revocation flow.",{"_2886":1093,"_27469":824,"_18854":46399,"_5":12679,"_25963":45657,"_2424":46400},[],"Cross-certification between CAs (RFC 4210bis §5.3.11): a CA asks the DMS's enrollment CA for a cross-certificate for its identity. It is a privileged CA-to-CA operation, **disabled by default**.",{"_2886":1094,"_27469":824,"_18854":46402,"_5":12679,"_25963":45657,"_2424":45904},[],{"_2886":1095,"_27469":824,"_18854":46404,"_5":12679,"_25963":45657,"_2424":45907},[],{"_2886":1096,"_27469":824,"_18854":46406,"_5":12679,"_25963":45657,"_2424":46058},[],{"_2886":1097,"_27469":824,"_18854":46408,"_5":12679,"_25963":45657,"_2424":46155},[],{"_2886":1098,"_27469":824,"_18854":46410,"_5":12679,"_25963":45657,"_2424":46007},[],{"_2886":1099,"_27469":824,"_18854":46412,"_5":12679,"_25963":45657,"_2424":46413},[],"`administrator_approval` (default) or `direct`. It is independent of the general enrollment `workflow`: the administrative approval of a `ccr` is not mixed with that of `ir`/`cr`. With `administrator_approval`, the request stays `PENDING` (type `ccr`) and the requesting CA retrieves the cross-certificate with `pollReq`.",{"_2886":1100,"_27469":824,"_18854":46415,"_5":12679,"_25963":45657,"_2424":46416},[],"`requester_mode`",{"_2886":1101,"_27469":824,"_18854":46418,"_5":12679,"_25963":45657,"_2424":46419},[],"`any` (default): any signer that passes `require_ca_certificate` may request. `restricted`: the signer must chain to a CA in `trusted_requester_ca_ids` — an empty list in `restricted` mode **authorizes nobody**.",{"_2886":1102,"_27469":824,"_18854":46421,"_5":12679,"_25963":45657,"_2424":46422},[],"`trusted_requester_ca_ids`",{"_2886":1103,"_27469":824,"_18854":46424,"_5":12679,"_25963":45657,"_2424":46425},[],"CAs authorized in `restricted` mode.",{"_2886":1104,"_27469":824,"_18854":46427,"_5":12679,"_25963":45657,"_2424":46428},[],"`require_ca_certificate`",{"_2886":1105,"_27469":824,"_18854":46430,"_5":12679,"_25963":45657,"_2424":46431},[],"Default `true`: the signer's protection certificate must be a CA certificate.",{"_2886":1106,"_27469":824,"_18854":46433,"_5":12679,"_25963":45657,"_2424":46434},[],"`require_proof_of_possession`",{"_2886":1107,"_27469":824,"_18854":46436,"_5":12679,"_25963":45657,"_2424":46437},[],"Default `true`: requires a `POPOSigningKey` POPO over the `CertTemplate` key. `EncryptedKey` POPOs (which would disclose the requester's private key) are always rejected, with or without this option.",{"_2886":1108,"_27469":824,"_18854":46439,"_5":12679,"_25963":45657,"_2424":46440},[],"`maximum_validity`",{"_2886":1109,"_27469":824,"_18854":46442,"_5":12679,"_25963":45657,"_2424":46443},[],"Maximum validity of the cross-certificate. Default &#x2A;*8760 hours (365 days)**. The requested `notBefore` is honored as-is (it may be in the past) and the `notAfter` is **truncated** to this limit, not rejected.",{"_2886":1110,"_27469":824,"_18854":46445,"_5":12679,"_25963":45657,"_2424":46446},[],"`subject_constraints`",{"_2886":1111,"_27469":824,"_18854":46448,"_5":12679,"_25963":45657,"_2424":46449},[],"Identity constraints of the cross-certificate: `allowed_dn_patterns` (substring match of the subject in RFC 2253 format) and `allowed_dns_suffixes` (suffix match of the `dNSName` SAN). An empty list on a dimension imposes no constraint on that dimension — unlike the `central_key_generation` list, which denies everything when empty.",{"_2886":1112,"_27469":824,"_18854":46451,"_5":12679,"_25963":45657,"_2424":46452},[],"`issuance_profile_id`",{"_2886":1113,"_27469":824,"_18854":46454,"_5":12679,"_25963":45657,"_2424":46455},[],"**Persisted but not yet enforced**: the cross-certificate is issued with a fixed internal profile (`CMP Cross Certification`), which produces a CA certificate with `keyCertSign`, `cRLSign` and `digitalSignature`.",{"_2886":1114,"_27469":824,"_18854":46457,"_5":12679,"_25963":45657,"_2424":46458},[],"The `ccr` additionally requires: a complete `CertTemplate` (version, signature algorithm, issuer, validity, subject and public key; version v3 or v1, not v2), a signing-capable key (agreement-only keys such as X25519/X448 are rejected) and no request for server-side key generation. It is not intended for device enrollment, but for interoperability between PKIs.",{"_2886":1115,"_27469":824,"_18854":46460,"_5":12679,"_25963":45661,"_2424":46461},[],"CMP allows the DMS itself to generate the device's key pair when the request (`ir`/`cr`) arrives with an empty public key in the `CertTemplate` (RFC 9483 §4.1.6, also called **KGA**, Key Generation Authority).",{"_2886":1116,"_27469":824,"_18854":46463,"_5":12679,"_25963":45661,"_2424":45904},[],{"_2886":1117,"_27469":824,"_18854":46465,"_5":12679,"_25963":45661,"_2424":45986},[],{"_2886":1118,"_27469":824,"_18854":46467,"_5":12679,"_25963":45661,"_2424":45907},[],{"_2886":1119,"_27469":824,"_18854":46469,"_5":12679,"_25963":45661,"_2424":46470},[],"`server_key_gen_enabled`",{"_2886":1120,"_27469":824,"_18854":46472,"_5":12679,"_25963":45661,"_2424":17610},[],{"_2886":1121,"_27469":824,"_18854":46474,"_5":12679,"_25963":45661,"_2424":46475},[],"Enables server-side key generation. Disabled by default: a request with an empty public key is rejected with `notAuthorized`. This switch and the `central_key_generation.enabled` of `ir`/`cr` resolve into a single gate: enabling any of the three is enough, and the resulting value is written back to all three.",{"_2886":1122,"_27469":824,"_18854":46477,"_5":12679,"_25963":45661,"_2424":46478},[],"`ckg_trusted_encryption_cas`",{"_2886":1123,"_27469":824,"_18854":46480,"_5":12679,"_25963":45661,"_2424":46481},[],"list of CA IDs",{"_2886":1124,"_27469":824,"_18854":46483,"_5":12679,"_25963":45661,"_2424":46484},[],"CAs the recipient certificate (the certificate the generated key is encrypted to — the requester's own protection certificate) must chain to. Empty by default: in that case the DMS's general trust boundary applies (the `EnrollmentCA` plus the validation CAs of `auth_mode` and of `reenrollment_settings.additional_validation_cas`). An explicit list **replaces** that boundary: the recipient must chain to one of the listed CAs. Recipient validation is unconditional, also with `auth_mode: NO_AUTH`: KGA delivers private key material, so it is a trust boundary independent of the authentication mode.",{"_2886":1125,"_27469":824,"_18854":46486,"_5":12679,"_25963":45661,"_2424":46487},[],"The server flow: it generates the key with the algorithm implied by the request (RSA-2048 if the `CertTemplate` declares no algorithm; ECDSA P-256 if it declares ECC), issues the certificate through the normal enrollment path and returns in the same `ip`/`cp` response the certificate together with the PKCS#8 private key wrapped in a CMS `EnvelopedData`(`SignedData`(`AsymmetricKeyPackage`)) structure. The recipient is the requester's protection certificate: with an RSA key it uses key transport (`rsa_key_transport`), which requires `keyEncipherment` on the recipient; with an ECC key it uses ECDH key agreement (`ecdh_key_agreement`), which requires `keyAgreement`. A recipient outside the trust boundary is rejected with `signerNotTrusted`.",{"_2886":1126,"_27469":824,"_18854":46489,"_5":12679,"_25963":45661,"_2424":46490},[],"The KGA-generated key is produced with the process's software cryptographic engine (not AWS KMS, PKCS#11 or any hardware Crypto Engine), because the key must be exportable in encrypted form to the device — something fundamentally incompatible with an HSM that never exposes private keys. The key exists in process memory only for the duration of the request and is never persisted: if the device loses the response, it cannot recover it with `pollReq` — it must repeat the enrollment with a new `transactionID`. For transport, the DMS also mints ephemeral helper certificates (`Lamassu CMP KGA Signer` with EKU `id-kp-cmKGA`, and `Lamassu CMP KARI Originator` for ECDH agreement), valid for one hour and signed by the enrollment CA. Prefer on-device key generation whenever possible; reserve KGA for devices that genuinely cannot generate their own key.",{"_2886":1127,"_27469":824,"_18854":46492,"_5":12679,"_25963":45665,"_2424":46493},[],"The `reenrollment_settings` section of the CMP block governs renewal (`kur`) with the same fields as EST:",{"_2886":1128,"_27469":824,"_18854":46495,"_5":12679,"_25963":45665,"_2424":45904},[],{"_2886":1129,"_27469":824,"_18854":46497,"_5":12679,"_25963":45665,"_2424":46498},[],"Effect in CMP",{"_2886":1130,"_27469":824,"_18854":46500,"_5":12679,"_25963":45665,"_2424":46501},[],"`additional_validation_cas`",{"_2886":1131,"_27469":824,"_18854":46503,"_5":12679,"_25963":45665,"_2424":46504},[],"Additional CAs accepted as issuers of the current certificate during renewal. It allows migrating to a new enrollment CA without interrupting the renewal of already-enrolled devices.",{"_2886":1132,"_27469":824,"_18854":46506,"_5":12679,"_25963":45665,"_2424":46507},[],"`revoke_on_reenrollment`",{"_2886":1133,"_27469":824,"_18854":46509,"_5":12679,"_25963":45665,"_2424":46510},[],"Revokes the previous certificate with the reason `superseded` once the new one is issued and confirmed. In initial enrollment (`ir`/`cr`/`p10cr`) it controls whether replacing the identity revokes the previous certificate.",{"_2886":1134,"_27469":824,"_18854":46512,"_5":12679,"_25963":45665,"_2424":46513},[],"`enable_expired_renewal`",{"_2886":1135,"_27469":824,"_18854":46515,"_5":12679,"_25963":45665,"_2424":46516},[],"Allows using an already-expired certificate as the protection credential of the `kur`.",{"_2886":1136,"_27469":824,"_18854":46518,"_5":12679,"_25963":45665,"_2424":46519},[],"`reenrollment_delta`",{"_2886":1137,"_27469":824,"_18854":46521,"_5":12679,"_25963":45665,"_2424":46522},[],"**Not applied in CMP.** The pre-expiry window that limits EST's `/simplereenroll` does not restrict CMP's `kur`; the policy of when to renew is the device's.",{"_2886":1138,"_27469":824,"_18854":46524,"_5":12679,"_25963":45665,"_2424":46525},[],"`preventive_delta` / `critical_delta`",{"_2886":1139,"_27469":824,"_18854":46527,"_5":12679,"_25963":45665,"_2424":46528},[],"Thresholds for preventive and critical renewal alerts. They are materialized on the certificate's metadata when the identity is bound, as in EST.",{"_2886":1140,"_27469":824,"_18854":46530,"_5":12679,"_25963":45665,"_2424":46531},[],"The `kur` key and identity policy (what may change and whether the key must rotate) lives in its per-operation block, described in Per-operation settings.",{"_2886":1141,"_27469":824,"_18854":46533,"_5":12679,"_25963":45669,"_2424":46534},[],"Every `ir`/`cr`/`kur`/`p10cr`/`ccr` received by a DMS over CMP is recorded as a **CMP transaction**, identified by the hexadecimal `transactionID` of the `PKIHeader`. The record keeps the state, the issued certificate (without the DER in the API response), the proof-of-possession method used and the `auth_mode` in effect at enrollment time. When the WFX integration is active, each transaction transition is also reflected as a workflow job with the exchange messages attached — see WFX integration.",{"_2886":1142,"_27469":824,"_18854":46536,"_5":12679,"_25963":45669,"_2424":46537},[],"State",{"_2886":1143,"_27469":824,"_18854":46539,"_5":12679,"_25963":45669,"_2424":46540},[],"Meaning",{"_2886":1144,"_27469":824,"_18854":46542,"_5":12679,"_25963":45669,"_2424":46543},[],"`PENDING`",{"_2886":1145,"_27469":824,"_18854":46545,"_5":12679,"_25963":45669,"_2424":46546},[],"Request accepted, awaiting issuance: a `phased` flow waiting for approval, or an `ir`/`cr` waiting for the `popdecr` of a challenge-response POPO.",{"_2886":1146,"_27469":824,"_18854":46548,"_5":12679,"_25963":45669,"_2424":46549},[],"`ISSUED`",{"_2886":1147,"_27469":824,"_18854":46551,"_5":12679,"_25963":45669,"_2424":46552},[],"Certificate issued, awaiting the device's `certConf`.",{"_2886":1148,"_27469":824,"_18854":46554,"_5":12679,"_25963":45669,"_2424":46555},[],"`CONFIRMED`",{"_2886":1149,"_27469":824,"_18854":46557,"_5":12679,"_25963":45669,"_2424":46558},[],"The device confirmed receipt with `certConf` (or implicit confirmation was granted). Terminal state.",{"_2886":1150,"_27469":824,"_18854":46560,"_5":12679,"_25963":45669,"_2424":46561},[],"`ISSUE_FAILED`",{"_2886":1151,"_27469":824,"_18854":46563,"_5":12679,"_25963":45669,"_2424":46564},[],"The CA rejected issuance or an administrator rejected the transaction. The reason remains available to the device via `pollReq`. Terminal state.",{"_2886":1152,"_27469":824,"_18854":46566,"_5":12679,"_25963":45669,"_2424":46567},[],"`REVOKED`",{"_2886":1153,"_27469":824,"_18854":46569,"_5":12679,"_25963":45669,"_2424":46570},[],"The issued certificate was revoked (by expiry of the confirmation window or by a later `rr`). Terminal state.",{"_2886":1154,"_27469":824,"_18854":46572,"_5":12679,"_25963":45669,"_2424":46573},[],"Internally, the server also uses the transient states `APPROVING` and `REVOKING` as lock markers while it resolves an administrative approval or a revocation: they usually last only instants and could only be observed if the service is interrupted mid-operation, in which case the monitoring job finalizes them automatically. The states exposed by the listing API are only the five above.",{"_2886":1155,"_27469":824,"_18854":46575,"_5":12679,"_25963":45669,"_2424":45775},[],{"_2886":1156,"_27469":824,"_18854":46577,"_5":12679,"_25963":45669,"_2424":45907},[],{"_2886":1157,"_27469":824,"_18854":46579,"_5":12679,"_25963":45669,"_2424":46580},[],"`GET /v1/dms/{id}/cmp/transactions`",{"_2886":1158,"_27469":824,"_18854":46582,"_5":12679,"_25963":45669,"_2424":46583},[],"Paginated list of the DMS's transactions (`page_size`, `bookmark`, `sort_by`, `sort_mode` with values `asc`/`desc`, `filter`). It does not include the certificate DER; retrieve it from the CAs API using `certificate_serial_number`.",{"_2886":1159,"_27469":824,"_18854":46585,"_5":12679,"_25963":45669,"_2424":46586},[],"`POST /v1/dms/{id}/cmp/transactions/{txid}/approve`",{"_2886":1160,"_27469":824,"_18854":46588,"_5":12679,"_25963":45669,"_2424":46589},[],"Approves a `PENDING` transaction of a `phased`-flow DMS, issuing the certificate. The device retrieves it in its next `pollReq`. Approval and rejection use an atomic claim of the record, so two concurrent calls do not issue the certificate twice. After approval, the device's confirmation window becomes that of `confirmation_timeout` (minimum 2 minutes).",{"_2886":1161,"_27469":824,"_18854":46591,"_5":12679,"_25963":45669,"_2424":46592},[],"`POST /v1/dms/{id}/cmp/transactions/{txid}/reject`",{"_2886":1162,"_27469":824,"_18854":46594,"_5":12679,"_25963":45669,"_2424":46595},[],"Rejects a `PENDING` transaction; it moves to `ISSUE_FAILED` with an optional reason (`{\"reason\": \"...\"}`; default `transaction rejected by administrator`) that the device receives in its next `pollReq`.",{"_2886":1163,"_27469":824,"_18854":46597,"_5":12679,"_25963":45669,"_2424":46598},[],"Both operations require the **read** permission for the listing and the **update** permission to approve or reject, within the DMS's actions. Approvals and rejections only affect `PENDING` transactions: in `workflow: direct` a transaction is born already in `ISSUED`.",{"_2886":1164,"_27469":824,"_18854":46600,"_5":12679,"_25963":45673,"_2424":46601},[],"An `ISSUED` certificate that the device never confirms within `confirmation_timeout` is, by RFC 4210 §5.2.8's definition, in a state of indeterminate trust. A periodic background job — enabled and scheduled through the DMS Manager service configuration key `cmp_confirmation_monitoring_job` (`enabled`, `frequency`; every 5 seconds by default when global monitoring is active) — takes care of:",{"_2886":1165,"_27469":824,"_18854":46603,"_5":12679,"_25963":45673,"_2424":46604},[],"**Revoking unconfirmed certificates**: `ISSUED` transactions whose confirmation window expired are revoked at the CA with the reason `cessationOfOperation` and move to `REVOKED`. The atomic claim of the record prevents revoking a certificate that a legitimate `certConf` is confirming at that exact moment.",{"_2886":1166,"_27469":824,"_18854":46606,"_5":12679,"_25963":45673,"_2424":46607},[],"**Closing pending approvals**: `PENDING` transactions in `phased` flow that no administrator resolved within `approval_timeout` move to `ISSUE_FAILED` with the reason `approval window expired`, and are kept for **7 days** so a late `pollReq` can still see the rejection reason.",{"_2886":1167,"_27469":824,"_18854":46609,"_5":12679,"_25963":45673,"_2424":46610},[],"Each run processes at most **100 transactions** per batch, to avoid a burst of revocations after a prolonged service interruption.",{"_2886":1168,"_27469":824,"_18854":46612,"_5":12679,"_25963":45677,"_2424":46613},[],"If the service's WFX client is enabled (`wfx.enabled` in the DMS Manager configuration), every transition of a CMP transaction is reflected as a job in WFX (Siemens' workflow engine), under two predefined templates depending on the DMS's `workflow`: `lamassu.cmp.transaction.direct.v1` for the direct flow and `lamassu.cmp.transaction.phased.v1` for the flow with administrative approval (which adds the `AwaitingApproval` state). The workflow states — `Received`, `Validated`, `Responded`, `AwaitingCertConf`, `Confirmed`, `LogicallyComplete` (implicit confirmation) and `Rejected` — let you follow the lifecycle of each transaction from the WFX console; the job is identified by the device's CN and attaches the base64-encoded exchange messages. This is purely external observability/orchestration: if WFX is not enabled, or if a call to WFX fails, the CMP operation in Lamassu is unaffected.",{"_2886":1169,"_27469":824,"_18854":46615,"_5":12679,"_25963":45681,"_2424":46616},[],"**From the console**: open the DMS detail and check that the CMP section shows the active protocol, the enrollment CA, the protection certificate and the enabled operations.",{"_2886":1170,"_27469":824,"_18854":46618,"_5":12679,"_25963":45681,"_2424":46619},[],"**With the transaction listing**: `GET /v1/dms/{id}/cmp/transactions` confirms the endpoint responds even without device traffic.",{"_2886":1171,"_27469":824,"_18854":46621,"_5":12679,"_25963":45681,"_2424":46622},[],"**With a test request**: use `openssl cmp` with the `ir` command (if you have a valid signer) or `genm` against the DMS's endpoint — see Example with openssl cmp.",{"_2886":1172,"_27469":824,"_18854":46624,"_5":12679,"_25963":45685,"_2424":46625},[],"*This section is aimed at the device integrator.*",{"_2886":1173,"_27469":824,"_18854":46627,"_5":12679,"_25963":45689,"_2424":46628},[],"The PKI administrator must have configured a DMS with the `CMP_RFC9483` protocol, an enrollment CA, a protection certificate and an authentication mode. The details of that configuration are in the DMS configuration section of this same page.",{"_2886":1174,"_27469":824,"_18854":46630,"_5":12679,"_25963":45689,"_2424":46631},[],"Before the first call, make sure you have:",{"_2886":1175,"_27469":824,"_18854":46633,"_5":12679,"_25963":45689,"_2424":46634},[],"Item",{"_2886":1176,"_27469":824,"_18854":46636,"_5":12679,"_25963":45689,"_2424":45907},[],{"_2886":1177,"_27469":824,"_18854":46638,"_5":12679,"_25963":45689,"_2424":46639},[],"**CMP host URL**",{"_2886":1178,"_27469":824,"_18854":46641,"_5":12679,"_25963":45689,"_2424":46642},[],"Base address of the server, for example `https://cmp.lamassu.example`. Provided by the PKI administrator.",{"_2886":1179,"_27469":824,"_18854":46644,"_5":12679,"_25963":45689,"_2424":46645},[],"**DMS ID**",{"_2886":1180,"_27469":824,"_18854":46647,"_5":12679,"_25963":45689,"_2424":46648},[],"Identifier of the DMS, included in the endpoint path (`/.well-known/cmp/p/{id}`).",{"_2886":1181,"_27469":824,"_18854":46650,"_5":12679,"_25963":45689,"_2424":46651},[],"**Message signing certificate and key**",{"_2886":1182,"_27469":824,"_18854":46653,"_5":12679,"_25963":45689,"_2424":46654},[],"Only for the `CLIENT_CERTIFICATE` and `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK` modes (and always for `kur`/`rr`). Unlike EST, it is not used as an mTLS credential: it is included as `extraCerts[0]` and signs the `PKIMessage`.",{"_2886":1183,"_27469":824,"_18854":46656,"_5":12679,"_25963":45689,"_2424":46657},[],"**DMS protection certificate**",{"_2886":1184,"_27469":824,"_18854":46659,"_5":12679,"_25963":45689,"_2424":46660},[],"The certificate with which the DMS signs its responses. Clients that pin the responder's identity (for example `openssl cmp -srvcert`) need it.",{"_2886":1185,"_27469":824,"_18854":46662,"_5":12679,"_25963":45692,"_2424":46663},[],"CMP is served from a **single endpoint**:",{"_2886":1186,"_27469":824,"_18854":46665,"_5":12679,"_25963":45692,"_2424":46666},[],"where `{id}` is the DMS identifier. The path follows the *well-known* URI format of RFC 9480 §3.3, so standard CMP clients recognize it without additional configuration (`openssl cmp -server <host> -path /.well-known/cmp/p/<dms-id>`).",{"_2886":1187,"_27469":824,"_18854":46668,"_5":12679,"_25963":45692,"_2424":46669},[],"**Content-Type**: `application/pkixcmp` in both the request and the response. A request with a different `Content-Type` is rejected with `415 Unsupported Media Type`.",{"_2886":1188,"_27469":824,"_18854":46671,"_5":12679,"_25963":45692,"_2424":46672},[],"**Body**: a `PKIMessage` in binary DER (not base64, unlike the EST endpoints). The response is equally binary DER.",{"_2886":1189,"_27469":824,"_18854":46674,"_5":12679,"_25963":45692,"_2424":46675},[],"**Dispatch by content, not by path**: the server decodes the `PKIMessage`, validates the envelope (protocol version, `transactionID`, `senderNonce`, `messageTime`) and dispatches the operation according to the `PKIBody` tag — `ir`, `cr`, `p10cr`, `kur`, `rr`, `certConf`, `pollReq`, `genm`, `ccr`, `nested`, etc.",{"_2886":1190,"_27469":824,"_18854":46677,"_5":12679,"_25963":45692,"_2424":46678},[],"**No transport-layer authentication**: the endpoint requires neither mTLS nor authorization headers; all authentication travels inside the message, as described in Authentication model.",{"_2886":1191,"_27469":824,"_18854":46680,"_5":12679,"_25963":45692,"_2424":46681},[],"**Maximum request size**: 1 MiB. A larger request is rejected before decoding is attempted.",{"_2886":1192,"_27469":824,"_18854":46683,"_5":12679,"_25963":45692,"_2424":46684},[],"A rejection arrives with `HTTP 200` in the form corresponding to the operation: as an error `PKIMessage` for failures before dispatch (operation disabled, invalid header, failed protection), as a rejection body inside the operation's own response (`ip`/`cp`/`kup` with `status: rejection`) for issuance policy failures, or as an `rp` body with a rejection status for revocations. In all cases you must inspect the CMP body, not just the HTTP code. The HTTP error codes (`400`, `415` and, for internal server failures, `500`) are reserved for cases where a valid CMP response cannot be delivered — see Error codes and diagnostics.",{"_2886":1193,"_27469":824,"_18854":46686,"_5":12679,"_25963":45696,"_2424":46687},[],"CMP authenticates **the message**, not the connection: there is no mTLS handshake equivalent to EST's. When the DMS's `auth_mode` requires `CLIENT_CERTIFICATE`, the device must:",{"_2886":1194,"_27469":824,"_18854":46689,"_5":12679,"_25963":45696,"_2424":46690},[],"Include its certificate in the `PKIMessage`'s `extraCerts` field (first position).",{"_2886":1195,"_27469":824,"_18854":46692,"_5":12679,"_25963":45696,"_2424":46693},[],"Sign the entire `PKIMessage` with the private key corresponding to that certificate (signature-based protection, RFC 9483 §3.2).",{"_2886":1196,"_27469":824,"_18854":46695,"_5":12679,"_25963":45696,"_2424":46696},[],"On top of the protected message, the server additionally enforces two RFC 9483 bindings: the header's `sender` field must match the protection certificate's subject, and the `senderKID` must be its `SubjectKeyIdentifier`. A protected request that violates either is rejected with `badMessageCheck`. If a message carries a signature even though the mode does not require one, the signature is still verified and those bindings apply.",{"_2886":1197,"_27469":824,"_18854":46698,"_5":12679,"_25963":45696,"_2424":46699},[],"The protection requirement per message type:",{"_2886":1198,"_27469":824,"_18854":46701,"_5":12679,"_25963":45696,"_2424":46702},[],"Message",{"_2886":1199,"_27469":824,"_18854":46704,"_5":12679,"_25963":45696,"_2424":46705},[],"Protection mandatory?",{"_2886":1200,"_27469":824,"_18854":46707,"_5":12679,"_25963":45696,"_2424":46708},[],"`ir`, `cr`, `p10cr`",{"_2886":1201,"_27469":824,"_18854":46710,"_5":12679,"_25963":45696,"_2424":46711},[],"Only if `auth_mode` is `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2886":1202,"_27469":824,"_18854":46713,"_5":12679,"_25963":45696,"_2424":45709},[],{"_2886":1203,"_27469":824,"_18854":46715,"_5":12679,"_25963":45696,"_2424":46716},[],"Always (the signature is the renewal's proof of possession)",{"_2886":1204,"_27469":824,"_18854":46718,"_5":12679,"_25963":45696,"_2424":45717},[],{"_2886":1205,"_27469":824,"_18854":46720,"_5":12679,"_25963":45696,"_2424":46721},[],"Always (the signature is what authorizes the revocation)",{"_2886":1206,"_27469":824,"_18854":46723,"_5":12679,"_25963":45696,"_2424":45721},[],{"_2886":1207,"_27469":824,"_18854":46725,"_5":12679,"_25963":45696,"_2424":46726},[],"Depending on `access_policy`: `public_discovery` admits unprotected messages; `require_signed` demands a signature",{"_2886":1208,"_27469":824,"_18854":46728,"_5":12679,"_25963":45696,"_2424":46729},[],"`certConf`, `pollReq`, `popdecr`, `nested`",{"_2886":1209,"_27469":824,"_18854":46731,"_5":12679,"_25963":45696,"_2424":46732},[],"Follow the DMS's `auth_mode` rule",{"_2886":1210,"_27469":824,"_18854":46734,"_5":12679,"_25963":45696,"_2424":46735},[],"At the service layer, the protection certificate must chain to a CA declared in `client_certificate_settings.validation_cas` (or, in `kur`, to the enrollment CA and the additional re-enrollment CAs), with the same chain-depth and expired-certificate tolerance parameters as EST, and its revocation status is checked as in the EST flow. In addition, a certificate that was a device's identity remains subject to the identity's state: while a key update is pending confirmation it cannot start new operations, and once the replacement is confirmed it stops being usable as a credential (`certRevoked`). A certificate that is no device's identity (for example, a bootstrap signer) passes without those checks.",{"_2886":1211,"_27469":824,"_18854":46737,"_5":12679,"_25963":45700,"_2424":46738},[],"Operation",{"_2886":1212,"_27469":824,"_18854":46740,"_5":12679,"_25963":45700,"_2424":46741},[],"Use",{"_2886":1213,"_27469":824,"_18854":46743,"_5":12679,"_25963":45700,"_2424":46744},[],"Requires prior identity",{"_2886":1214,"_27469":824,"_18854":46746,"_5":12679,"_25963":45700,"_2424":46747},[],"`ir`",{"_2886":1215,"_27469":824,"_18854":46749,"_5":12679,"_25963":45700,"_2424":46750},[],"Initial enrollment of a new device.",{"_2886":1216,"_27469":824,"_18854":46752,"_5":12679,"_25963":45700,"_2424":46753},[],"No",{"_2886":1217,"_27469":824,"_18854":46755,"_5":12679,"_25963":45700,"_2424":46756},[],"`cr`",{"_2886":1218,"_27469":824,"_18854":46758,"_5":12679,"_25963":45700,"_2424":46759},[],"Additional or replacement issuance for an already-identified device.",{"_2886":1219,"_27469":824,"_18854":46761,"_5":12679,"_25963":45700,"_2424":46762},[],"Yes (if `require_existing_device`)",{"_2886":1220,"_27469":824,"_18854":46764,"_5":12679,"_25963":45700,"_2424":45713},[],{"_2886":1221,"_27469":824,"_18854":46766,"_5":12679,"_25963":45700,"_2424":46767},[],"Enrollment with a PKCS#10 CSR, without CRMF controls or KGA. Must be enabled on the DMS.",{"_2886":1222,"_27469":824,"_18854":46769,"_5":12679,"_25963":45700,"_2424":46753},[],{"_2886":1223,"_27469":824,"_18854":46771,"_5":12679,"_25963":45700,"_2424":45709},[],{"_2886":1224,"_27469":824,"_18854":46773,"_5":12679,"_25963":45700,"_2424":46774},[],"Renewal of a certificate; the message is signed with the current certificate.",{"_2886":1225,"_27469":824,"_18854":46776,"_5":12679,"_25963":45700,"_2424":46777},[],"Yes (the certificate being renewed)",{"_2886":1226,"_27469":824,"_18854":46779,"_5":12679,"_25963":45700,"_2424":45717},[],{"_2886":1227,"_27469":824,"_18854":46781,"_5":12679,"_25963":45700,"_2424":46782},[],"Revocation of a certificate, always signed.",{"_2886":1228,"_27469":824,"_18854":46784,"_5":12679,"_25963":45700,"_2424":46785},[],"Yes",{"_2886":1229,"_27469":824,"_18854":46787,"_5":12679,"_25963":45700,"_2424":46788},[],"`genm`/`genp`",{"_2886":1230,"_27469":824,"_18854":46790,"_5":12679,"_25963":45700,"_2424":46791},[],"Query of the DMS's capabilities (CAs, key types, current CRL, etc.). Issues no certificates.",{"_2886":1231,"_27469":824,"_18854":46793,"_5":12679,"_25963":45700,"_2424":46753},[],{"_2886":1232,"_27469":824,"_18854":46795,"_5":12679,"_25963":45700,"_2424":46796},[],"`ccr`/`ccp`",{"_2886":1233,"_27469":824,"_18854":46798,"_5":12679,"_25963":45700,"_2424":46799},[],"Cross-certification between CAs. For CA operators only, disabled by default.",{"_2886":1234,"_27469":824,"_18854":46801,"_5":12679,"_25963":45700,"_2424":46802},[],"The signer must be a CA",{"_2886":1235,"_27469":824,"_18854":46804,"_5":12679,"_25963":45700,"_2424":45733},[],{"_2886":1236,"_27469":824,"_18854":46806,"_5":12679,"_25963":45700,"_2424":46807},[],"Wrapper that adds an extra layer of protection (an RA countersigning a device) or groups several messages into a batch. Not an operation in itself.",{"_2886":1237,"_27469":824,"_18854":46809,"_5":12679,"_25963":45700,"_2424":43390},[],{"_2886":1238,"_27469":824,"_18854":46811,"_5":12679,"_25963":45700,"_2424":46812},[],"The protocol steps `certConf` (confirmation), `pollReq` (polling), `popdecc`/`popdecr` (challenge-response proof of possession) and `error` are part of the lifecycle of the operations above, not operations the integrator chooses separately.",{"_2886":1239,"_27469":824,"_18854":46814,"_5":12679,"_25963":45704,"_2424":46815},[],"Both carry a `CertReqMessages` body with the certificate template (`CertTemplate`), the CRMF controls and the proof of possession. The subject may arrive empty (NULL-DN) as long as a `SubjectAltName` extension carries the identity; with neither subject nor SAN, the `ir` is rejected. Responses are `ip` for `ir` and `cp` for `cr`.",{"_2886":1240,"_27469":824,"_18854":46817,"_5":12679,"_25963":45704,"_2424":46818},[],"Enrollment respects the DMS's registration mode: with `JITP`, the first request creates the device with the provisioning profile; with `PRE_REGISTRATION`, an unknown device is rejected with `device not preregistered`. Re-enrolling an already-enrolled device requires `enable_replaceable_enrollment` on the DMS (`forbiddenNewEnrollment` otherwise). The template restrictions are the same for both operations: Lamassu never issues CA certificates over CMP (`BasicConstraints cA=TRUE` → `notAuthorized`), using `keyCertSign` without being a CA or a `pathLenConstraint` in an end-entity template are `badCertTemplate`, and the accepted RSA range is 2048 to 8192 bits.",{"_2886":1241,"_27469":824,"_18854":46820,"_5":12679,"_25963":45704,"_2424":46821},[],"If the DMS's issuance profile drops a **critical** extension requested by the `CertTemplate`, the response arrives with status `grantedWithMods` (1) instead of `accepted` (0): the integrator must compare the issued certificate with what was requested, not assume that acceptance implies an exact match.",{"_2886":1242,"_27469":824,"_18854":46823,"_5":12679,"_25963":45704,"_2424":46824},[],"The CRMF controls, when the DMS requires them, go in the request: `id-regCtrl-regToken` (RFC 4211 §6.1) if the DMS's mode requires it — a one-use value consumed even if issuance later fails — and `id-regCtrl-authenticator` (§6.2) if the DMS configured an expected answer. A control present when the DMS has it disabled, or absent when it is mandatory, is rejected with `badRequest`.",{"_2886":1243,"_27469":824,"_18854":46826,"_5":12679,"_25963":45708,"_2424":46827},[],"The message carries the template of the renewed certificate and is **protected by signature with the certificate being renewed** — that signature is the proof of possession. With `key_policy: require_new_key`, the public key must differ from the current one; with `identity_change_policy: forbid`, the subject and the SAN must match the current certificate (`san_only` allows changing the SAN; `subject_and_san` allows both changes). The response is `kup`.",{"_2886":1244,"_27469":824,"_18854":46829,"_5":12679,"_25963":45708,"_2424":46830},[],"The exchange stays pending until the `certConf`: until the device confirms, the previous certificate remains the device's active identity and can keep being used; the new one is bound and the previous one is revoked as `superseded` only upon confirmation (or immediately if implicit confirmation was negotiated). The optional `id-regCtrl-oldCertID` control must reference the certificate being renewed.",{"_2886":1245,"_27469":824,"_18854":46832,"_5":12679,"_25963":45712,"_2424":46833},[],"The body is a complete PKCS#10 CSR. The CSR's signature over its own `CertificationRequestInfo` is the proof of possession and is always verified. The signature algorithm policy follows RFC 9481 §3: RSA, RSA-PSS, ECDSA or Ed25519 with SHA-256/384/512; those signed with SHA-1, SHA-224, MD5 or DSA are rejected with `badPOP`, and an unknown algorithm is rejected with `badAlg`. The response is a `cp` with `certReqId` `-1`, and the subsequent `certConf` must carry that same value.",{"_2886":1246,"_27469":824,"_18854":46835,"_5":12679,"_25963":45716,"_2424":46836},[],"The body carries `RevReqContent` with the `CertTemplate` of the certificate to revoke and the reason. The message signature must be from the revoked certificate itself (self-revocation) or from a trusted RA entity (EKU `id-kp-cmcRA`, validated against the DMS's CAs according to `trusted_ra`). The fields of the `CertTemplate` — issuer, serial number, subject, public key and extensions — must match the presented certificate. The reason `certificateHold` suspends the certificate (and is not subject to the allowed-reasons list); the reason `removeFromCRL` does not revoke: it asks to reactivate a previously revoked certificate — only possible if that revocation was a suspension —, an operation the DMS must have enabled with `allow_revival`.",{"_2886":1247,"_27469":824,"_18854":46838,"_5":12679,"_25963":45716,"_2424":46839},[],"The response is always an `rp` — both on success (`Certificate revoked` / `Certificate revived`) and on rejection, with the reason in its `PKIStatusInfo`.",{"_2886":1248,"_27469":824,"_18854":46841,"_5":12679,"_25963":45720,"_2424":46842},[],"The body is a sequence of `InfoTypeAndValue`; the response is a `genp` with one entry per request. See the information types table to know what each DMS advertises. The infrastructure-dependent types (CRL) require the administrator to have configured a VA client on the DMS Manager service.",{"_2886":1249,"_27469":824,"_18854":46844,"_5":12679,"_25963":45724,"_2424":46845},[],"Reserved for CA operators. The signer must be a CA certificate and the template must be complete. With `workflow: administrator_approval` (the default), the first response is a waiting `ccp` and the cross-certificate is retrieved with `pollReq` once approved. The requested validity is honored up to the DMS's `maximum_validity` limit.",{"_2886":1250,"_27469":824,"_18854":46847,"_5":12679,"_25963":45728,"_2424":46848},[],"`certConf` closes the cycle of an issuance with explicit confirmation. Main rules:",{"_2886":1251,"_27469":824,"_18854":46850,"_5":12679,"_25963":45728,"_2424":46851},[],"It must carry **exactly one** `CertStatus`, with `certReqId` `0` for `ir`/`cr`/`kur` and `-1` for `p10cr`.",{"_2886":1252,"_27469":824,"_18854":46853,"_5":12679,"_25963":45728,"_2424":46854},[],"The `certHash` is verified against the issued certificate; without `hashAlg`, the digest dictated by RFC 9481 §3.3 according to the certificate's own signature algorithm is used (SHA-256, except for certificates signed with SHA-384/512 or Ed25519), and declaring a `hashAlg` requires `pvno` `cmp2021(3)`.",{"_2886":1253,"_27469":824,"_18854":46856,"_5":12679,"_25963":45728,"_2424":46857},[],"It must be protected with **the credential of the original request**, not with the freshly issued certificate.",{"_2886":1254,"_27469":824,"_18854":46859,"_5":12679,"_25963":45728,"_2424":46860},[],"The `recipNonce` must return the response's `senderNonce`, and its own `senderNonce` must be new (reusing the one from the initial request is `badSenderNonce`).",{"_2886":1255,"_27469":824,"_18854":46862,"_5":12679,"_25963":45728,"_2424":46863},[],"Confirming the same certificate twice answers with the error `certConfirmed`, useful after losing a `pkiConf`.",{"_2886":1256,"_27469":824,"_18854":46865,"_5":12679,"_25963":45728,"_2424":46866},[],"`pollReq` polls the transaction's state and supports two flows: lost-response recovery (the `ISSUED` certificate is re-delivered in the original `ip`/`cp`/`kup`, without consuming the transaction) and polling of the `phased` flow (while the transaction is `PENDING`, the response is a `pollRep` with the retry hint, 60 seconds by default). An `ISSUE_FAILED` transaction returns the failure reason and a `REVOKED` one indicates the enrollment must be repeated. The response of a transaction with server-side key generation **cannot be recovered**: the private key is never stored, so a `pollReq` on it is rejected and the device must repeat the enrollment with a new `transactionID`.",{"_2886":1257,"_27469":824,"_18854":46868,"_5":12679,"_25963":45732,"_2424":46869},[],"A `nested` (RFC 4210 §5.1.3) is an envelope whose body contains one or more `PKIMessage`. With **a single** inner message it is *added protection* (RFC 9483 §5.2.2.1): an RA wraps and countersigns an already-protected device request; the outer header must copy the inner `transactionID` and `senderNonce`, the inner protection is verified and the request is processed normally. With **two or more** messages it is a batch (§5.2.2.2): the outer header carries new `transactionID`/`senderNonce`, the protection of each inner message is verified before any is processed and the responses come back wrapped in a `nested`, in the same order. A `ccr` inside a `nested` is not re-expedited, and nesting inside a batch is not supported.",{"_2886":1258,"_27469":824,"_18854":46871,"_5":12679,"_25963":45736,"_2424":46872},[],"When the DMS has `server_key_gen_enabled: true`, a device may send an `ir`/`cr` with an empty public key field in the `CertTemplate` to ask the server to generate the key pair. The mechanism and its limits are described in the configuration section; from the integrator's side:",{"_2886":1259,"_27469":824,"_18854":46874,"_5":12679,"_25963":45736,"_2424":46875},[],"The message's protection certificate acts as the recipient: RSA → `rsa_key_transport`, ECC → `ecdh_key_agreement`. The certificate's key and key usage must allow the chosen technique.",{"_2886":1260,"_27469":824,"_18854":46877,"_5":12679,"_25963":45736,"_2424":46878},[],"The response (`ip`/`cp`) carries the issued certificate and the wrapped key in the same body; the PKCS#8 key travels inside `EnvelopedData`(`SignedData`(`AsymmetricKeyPackage`)) and the certificate to open the envelope with is in `extraCerts[0]`.",{"_2886":1261,"_27469":824,"_18854":46880,"_5":12679,"_25963":45736,"_2424":46881},[],"The key is never stored on the server: if the response is lost, no `pollReq` can recover it — repeat the enrollment with a new `transactionID`.",{"_2886":1262,"_27469":824,"_18854":46883,"_5":12679,"_25963":45736,"_2424":46884},[],"The subsequent `certConf` works the same as in an ordinary issuance.",{"_2886":1263,"_27469":824,"_18854":46886,"_5":12679,"_25963":45740,"_2424":46887},[],"The following commands use OpenSSL's `cmp` client (≥ 3.0) against a DMS configured in `CLIENT_CERTIFICATE` mode.",{"_2886":1264,"_27469":824,"_18854":46889,"_5":12679,"_25963":45740,"_2424":46890},[],"**Initial enrollment (`ir`)**, signing with a bootstrap certificate (`signer.crt`/`signer.key`) issued by one of the DMS's `validation_cas`, and generating a new key for the device:",{"_2886":1265,"_27469":824,"_18854":46892,"_5":12679,"_25963":45740,"_2424":46893},[],"`-tls_used` is necessary in OpenSSL 3.0.x when the server URL uses `https` without pinning the server certificate (`-srvcert`); versions ≥ 3.2 infer it automatically. `-unprotected_errors` allows accepting error responses that arrive unprotected (those whose protection algorithm is NULL); while the DMS has no `protection_certificate` configured, all its responses — including errors — go out unprotected, so this option keeps `openssl cmp` from discarding them.",{"_2886":1266,"_27469":824,"_18854":46895,"_5":12679,"_25963":45740,"_2424":46896},[],"**Renewal (`kur`)**, authenticating with the device's current certificate:",{"_2886":1267,"_27469":824,"_18854":46898,"_5":12679,"_25963":45740,"_2424":46899},[],"`-srvcert` pins the certificate the DMS is expected to protect its response with (the **Protection Certificate** configured on the DMS). Without it, OpenSSL validates the response's protection against its own trust anchors; `-unprotected_errors` only covers unprotected error messages and does not replace `-srvcert` for successful responses.",{"_2886":1268,"_27469":824,"_18854":46901,"_5":12679,"_25963":45744,"_2424":46902},[],"**Confirm the certificate**: unless `accept_implicit` is active on the DMS and the device requests it, the flow is not complete until the device sends `certConf`. `openssl cmp -cmd ir`/`kur` does it automatically; a manual integration must implement this step.",{"_2886":1269,"_27469":824,"_18854":46904,"_5":12679,"_25963":45744,"_2424":46905},[],"**Plan the renewal**: schedule the `kur` before the certificate expires. Unlike EST, the `reenrollment_delta` window does not restrict CMP's `kur`, so the policy of when to renew is the device's.",{"_2886":1270,"_27469":824,"_18854":46907,"_5":12679,"_25963":45744,"_2424":46908},[],"**`phased` flow**: if the DMS uses `workflow: phased` on the operation, the first response to `ir`/`cr`/`kur`/`p10cr` is a wait; the device must retry with `pollReq` until an administrator approves or rejects the transaction.",{"_2886":1271,"_27469":824,"_18854":46910,"_5":12679,"_25963":45744,"_2424":46911},[],"**Recovering lost responses**: if a response did not arrive, repeat the operation with `pollReq` (the `ISSUED` certificate is re-delivered), except for transactions with server-side key generation, where the enrollment must be repeated.",{"_2886":1272,"_27469":824,"_18854":46913,"_5":12679,"_25963":45752,"_2424":46914},[],"An error `PKIMessage` returned with `HTTP 200` is the normal answer to a request rejected by policy (failed authentication, disabled operation, expired confirmation window, etc.). It is protected — signed with the protection certificate — if the DMS has one configured; otherwise it goes out unprotected, and strict clients like `openssl cmp` discard it unless `-unprotected_errors` is used. The HTTP error codes are reserved for failures where a response `PKIMessage` cannot be built.",{"_2886":1273,"_27469":824,"_18854":46916,"_5":12679,"_25963":45752,"_2424":46917},[],"HTTP",{"_2886":1274,"_27469":824,"_18854":46919,"_5":12679,"_25963":45752,"_2424":46920},[],"Where the failure is",{"_2886":1275,"_27469":824,"_18854":46922,"_5":12679,"_25963":45752,"_2424":46923},[],"Typical cause",{"_2886":1276,"_27469":824,"_18854":46925,"_5":12679,"_25963":45752,"_2424":46926},[],"Integrator action",{"_2886":1277,"_27469":824,"_18854":46928,"_5":12679,"_25963":45752,"_2424":26654},[],{"_2886":1278,"_27469":824,"_18854":46930,"_5":12679,"_25963":45752,"_2424":46931},[],"JSON error body",{"_2886":1279,"_27469":824,"_18854":46933,"_5":12679,"_25963":45752,"_2424":46934},[],"`Content-Type` other than `application/pkixcmp`.",{"_2886":1280,"_27469":824,"_18854":46936,"_5":12679,"_25963":45752,"_2424":46937},[],"Set the correct header.",{"_2886":1281,"_27469":824,"_18854":46939,"_5":12679,"_25963":45752,"_2424":26614},[],{"_2886":1282,"_27469":824,"_18854":46941,"_5":12679,"_25963":45752,"_2424":46942},[],"No body",{"_2886":1283,"_27469":824,"_18854":46944,"_5":12679,"_25963":45752,"_2424":46945},[],"The body cannot be decoded as an ASN.1 `PKIMessage` (no valid header to build a CMP response from).",{"_2886":1284,"_27469":824,"_18854":46947,"_5":12679,"_25963":45752,"_2424":46948},[],"Check the body is binary DER, not base64 or PEM.",{"_2886":1285,"_27469":824,"_18854":46950,"_5":12679,"_25963":45752,"_2424":46951},[],"200 (`error`)",{"_2886":1286,"_27469":824,"_18854":46953,"_5":12679,"_25963":45752,"_2424":46954},[],"Body's `PKIFailureInfo`",{"_2886":1287,"_27469":824,"_18854":46956,"_5":12679,"_25963":45752,"_2424":46957},[],"`unsupportedVersion`: pvno other than `cmp2000(2)`/`cmp2021(3)`.",{"_2886":1288,"_27469":824,"_18854":46959,"_5":12679,"_25963":45752,"_2424":46960},[],"Use a supported version.",{"_2886":1289,"_27469":824,"_18854":46962,"_5":12679,"_25963":45752,"_2424":46951},[],{"_2886":1290,"_27469":824,"_18854":46964,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1291,"_27469":824,"_18854":46966,"_5":12679,"_25963":45752,"_2424":46967},[],"`badDataFormat`: missing or under-128-bit `transactionID`/`senderNonce`; malformed `PKIHeader`; `error` from the EE.",{"_2886":1292,"_27469":824,"_18854":46969,"_5":12679,"_25963":45752,"_2424":46970},[],"Review the CMP client implementation.",{"_2886":1293,"_27469":824,"_18854":46972,"_5":12679,"_25963":45752,"_2424":46951},[],{"_2886":1294,"_27469":824,"_18854":46974,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1295,"_27469":824,"_18854":46976,"_5":12679,"_25963":45752,"_2424":46977},[],"`badTime`: `messageTime` absent or drifting more than 5 minutes.",{"_2886":1296,"_27469":824,"_18854":46979,"_5":12679,"_25963":45752,"_2424":46980},[],"Synchronize the device's clock.",{"_2886":1297,"_27469":824,"_18854":46982,"_5":12679,"_25963":45752,"_2424":46951},[],{"_2886":1298,"_27469":824,"_18854":46984,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1299,"_27469":824,"_18854":46986,"_5":12679,"_25963":45752,"_2424":46987},[],"`badSenderNonce`/`badRecipientNonce`: reused `senderNonce`, `recipNonce` present in an initial request or mismatched.",{"_2886":1300,"_27469":824,"_18854":46989,"_5":12679,"_25963":45752,"_2424":46990},[],"Follow the nonce rules of RFC 9483 §3.1.",{"_2886":1301,"_27469":824,"_18854":46992,"_5":12679,"_25963":45752,"_2424":46951},[],{"_2886":1302,"_27469":824,"_18854":46994,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1303,"_27469":824,"_18854":46996,"_5":12679,"_25963":45752,"_2424":46997},[],"`badMessageCheck`: invalid signature, `sender`/`senderKID` not matching the protection certificate, or failed protection in a nested message.",{"_2886":1304,"_27469":824,"_18854":46999,"_5":12679,"_25963":45752,"_2424":47000},[],"Review the certificate used to sign.",{"_2886":1305,"_27469":824,"_18854":47002,"_5":12679,"_25963":45752,"_2424":46951},[],{"_2886":1306,"_27469":824,"_18854":47004,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1307,"_27469":824,"_18854":47006,"_5":12679,"_25963":45752,"_2424":47007},[],"`transactionIdInUse`: `transactionID` already registered (replay of an `rr`).",{"_2886":1308,"_27469":824,"_18854":47009,"_5":12679,"_25963":45752,"_2424":47010},[],"Generate a new `transactionID`.",{"_2886":1309,"_27469":824,"_18854":47012,"_5":12679,"_25963":45752,"_2424":46951},[],{"_2886":1310,"_27469":824,"_18854":47014,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1311,"_27469":824,"_18854":47016,"_5":12679,"_25963":45752,"_2424":47017},[],"`notAuthorized`: operation disabled for the DMS, or revocation of another DMS's certificate.",{"_2886":1312,"_27469":824,"_18854":47019,"_5":12679,"_25963":45752,"_2424":47020},[],"Confirm with the PKI administrator that the operation is enabled.",{"_2886":1313,"_27469":824,"_18854":47022,"_5":12679,"_25963":45752,"_2424":46951},[],{"_2886":1314,"_27469":824,"_18854":47024,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1315,"_27469":824,"_18854":47026,"_5":12679,"_25963":45752,"_2424":47027},[],"`signerNotTrusted`: the signer does not chain to the DMS's validation CAs, or the KGA recipient is outside the trust boundary.",{"_2886":1316,"_27469":824,"_18854":47029,"_5":12679,"_25963":45752,"_2424":47030},[],"Review the signing certificate and the configured CAs.",{"_2886":1317,"_27469":824,"_18854":47032,"_5":12679,"_25963":45752,"_2424":46951},[],{"_2886":1318,"_27469":824,"_18854":47034,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1319,"_27469":824,"_18854":47036,"_5":12679,"_25963":45752,"_2424":47037},[],"`certRevoked`: the protection certificate was replaced by a confirmed renewal, or the target certificate is already revoked.",{"_2886":1320,"_27469":824,"_18854":47039,"_5":12679,"_25963":45752,"_2424":47040},[],"Repeat the enrollment or review the identity's state.",{"_2886":1321,"_27469":824,"_18854":47042,"_5":12679,"_25963":45752,"_2424":46951},[],{"_2886":1322,"_27469":824,"_18854":47044,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1323,"_27469":824,"_18854":47046,"_5":12679,"_25963":45752,"_2424":47047},[],"`certConfirmed`: duplicate `certConf` (the confirmation was already received).",{"_2886":1324,"_27469":824,"_18854":47049,"_5":12679,"_25963":45752,"_2424":47050},[],"Do not repeat the confirmation unless the `pkiConf` was lost.",{"_2886":1325,"_27469":824,"_18854":47052,"_5":12679,"_25963":45752,"_2424":46951},[],{"_2886":1326,"_27469":824,"_18854":47054,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1327,"_27469":824,"_18854":47056,"_5":12679,"_25963":45752,"_2424":47057},[],"`badRequest`: unknown or expired transaction, no certificate to confirm, second pending renewal, or KGA recipient without the necessary key usage.",{"_2886":1328,"_27469":824,"_18854":47059,"_5":12679,"_25963":45752,"_2424":47060},[],"Inspect the exact reason (`statusString`) and fix the flow.",{"_2886":1329,"_27469":824,"_18854":47062,"_5":12679,"_25963":45752,"_2424":47063},[],"200 (`ip`/`cp`/`kup` with `status: rejection`)",{"_2886":1330,"_27469":824,"_18854":47065,"_5":12679,"_25963":45752,"_2424":46954},[],{"_2886":1331,"_27469":824,"_18854":47067,"_5":12679,"_25963":45752,"_2424":47068},[],"Issuance policy: missing or failed POPO (`badPOP`), CA certificate request or RSA outside 2048–8192 bits (`badCertTemplate`), `notAuthorized` for POPO/KGA recipients not allowed, invalid `certReqId`.",{"_2886":1332,"_27469":824,"_18854":47070,"_5":12679,"_25963":45752,"_2424":47071},[],"Inspect the body's `PKIFailureInfo` and check it against the DMS's per-operation configuration.",{"_2886":1333,"_27469":824,"_18854":47073,"_5":12679,"_25963":45752,"_2424":47074},[],"200 (`rp` with `status: rejection`)",{"_2886":1334,"_27469":824,"_18854":47076,"_5":12679,"_25963":45752,"_2424":47077},[],"Body's `PKIStatusInfo`",{"_2886":1335,"_27469":824,"_18854":47079,"_5":12679,"_25963":45752,"_2424":47080},[],"Revocation: reason not allowed (`badRequest`), repeated `transactionID`, certificate not found (`badCertId`), already revoked (`certRevoked`) or not revivable (`badCertId`), or signer without authority over the certificate (`signerNotTrusted`/`notAuthorized`).",{"_2886":1336,"_27469":824,"_18854":47082,"_5":12679,"_25963":45752,"_2424":47083},[],"Check against the DMS's `rr` policy.",{"_2886":1337,"_27469":824,"_18854":47085,"_5":12679,"_25963":45752,"_2424":47086},[],"To interpret the exact reason of a CMP rejection, inspect the response `PKIMessage`'s `PKIFailureInfo`/`statusString` field (for example with `openssl cmp ... -rspout response.der` and `openssl asn1parse -inform DER -in response.der`). In the Lamassu server logs, every rejection generates a structured `CMP operation rejected` event with the fields `dms`, `pkiStatus`, `pkiFailureInfo`, `reason` and `txid`; client failures are logged as `WARN` and internal ones (`systemFailure`) as `ERROR`.",{"_2886":1338,"_27469":824,"_18854":47088,"_5":12679,"_25963":45756,"_2424":47089},[],"Lamassu's implementation follows the Lightweight CMP profile with the following quirks that affect strict CMP clients:",{"_2886":1339,"_27469":824,"_18854":47091,"_5":12679,"_25963":45756,"_2424":47092},[],"CMP is served from a single multiplexed endpoint (`/.well-known/cmp/p/{id}`); there are no per-operation routes as in EST.",{"_2886":1340,"_27469":824,"_18854":47094,"_5":12679,"_25963":45756,"_2424":47095},[],"Both versions `cmp2000(2)` and `cmp2021(3)` are accepted and answered; the response returns the same `pvno` as the request.",{"_2886":1341,"_27469":824,"_18854":47097,"_5":12679,"_25963":45756,"_2424":47098},[],"`messageTime` is mandatory in **all** messages (not only protected ones), with a 5-minute drift tolerance (`badTime`).",{"_2886":1342,"_27469":824,"_18854":47100,"_5":12679,"_25963":45756,"_2424":47101},[],"`transactionID` and `senderNonce` must carry at least 128 bits of entropy, and the `senderNonce` must be new in every message.",{"_2886":1343,"_27469":824,"_18854":47103,"_5":12679,"_25963":45756,"_2424":47104},[],"The `ir`, `cr` and `p10cr` operations do not admit `recipNonce` in the initial request (RFC 9483 §3.1); a client that includes it receives `badRecipientNonce`. The `generalInfo` rules are enforced equally: `implicitConfirm` and `confirmWaitTime` are mutually exclusive, the value of `implicitConfirm` must be `NULL` and that of `confirmWaitTime` a `GeneralizedTime`.",{"_2886":1344,"_27469":824,"_18854":47106,"_5":12679,"_25963":45756,"_2424":47107},[],"With signature-based protection, the header's `sender` must match the protection certificate's subject and the `senderKID` its `SubjectKeyIdentifier` (`badMessageCheck` otherwise). `genm` messages are exempt from this identity check.",{"_2886":1345,"_27469":824,"_18854":47109,"_5":12679,"_25963":45756,"_2424":47110},[],"The subject may be NULL-DN only if the SAN carries the identity; for the device's internal identity the SAN is used as a fallback, but the issued certificate keeps the empty subject.",{"_2886":1346,"_27469":824,"_18854":47112,"_5":12679,"_25963":45756,"_2424":47113},[],"Lamassu never issues CA certificates over CMP; the only operation that produces CA certificates is `ccr`.",{"_2886":1347,"_27469":824,"_18854":47115,"_5":12679,"_25963":45756,"_2424":47116},[],"The `id-it-revPassphrase` type of the `genm` is permanently disabled.",{"_2886":1348,"_27469":824,"_18854":47118,"_5":12679,"_25963":45756,"_2424":47119},[],"The internal `APPROVING` and `REVOKING` states of a transaction are transient and are not exposed by the listing API; only `PENDING`, `ISSUED`, `ISSUE_FAILED`, `CONFIRMED` and `REVOKED` appear.",{"_2886":1349,"_27469":824,"_18854":47121,"_5":12679,"_25963":45756,"_2424":47122},[],"Transaction records in terminal states (`CONFIRMED`, `REVOKED`) are kept for audit and are not purged by expiration; a completed `transactionID` may be reused in a new operation, except in `rr`, where replay protection also looks at terminal records.",{"_2886":1350,"_27469":824,"_18854":47124,"_5":12679,"_25963":45756,"_2424":47125},[],"The protection certificate must be renewed manually before it expires: the DMS does not renew it automatically, and while none is configured, all responses go out unprotected.",{"_2886":1351,"_27469":824,"_18854":47127,"_5":12679,"_25963":45756,"_2424":47128},[],"<Card title=\"DMS overview\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2886":1352,"_27469":824,"_18854":47130,"_5":12679,"_25963":45756,"_2424":47131},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2886":1353,"_27469":824,"_18854":47133,"_5":12679,"_25963":45756,"_2424":47134},[],"<Card title=\"Manage devices\" href=\"/docs/platform/pki/device-management\" />",{"_2886":1354,"_27469":1354,"_5":13057,"_2424":47136,"_27749":47137,"_18854":47139,"_25963":1354},"Platform architecture",[43001,44136,47138],"Concepts",[],{"_2886":1355,"_27469":1354,"_18854":47141,"_5":12679,"_25963":1354,"_2424":47142},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2886":1356,"_27469":1354,"_5":27746,"_18854":47144,"_25963":47145,"_2424":47146},[],"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#control-plane","Control plane",{"_2886":1357,"_27469":1354,"_5":27746,"_18854":47148,"_25963":47149,"_2424":47150},[],"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2886":1358,"_27469":1354,"_5":27746,"_18854":47152,"_25963":47153,"_2424":47154},[],"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2886":1359,"_27469":1354,"_5":27746,"_18854":47156,"_25963":47157,"_2424":47158},[],"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#status-and-validation","Status and validation",{"_2886":1360,"_27469":1354,"_5":27746,"_18854":47160,"_25963":47161,"_2424":47162},[],"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#platform-dependencies","Platform dependencies",{"_2886":1361,"_27469":1354,"_18854":47164,"_5":12679,"_25963":1354,"_2424":47165},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2886":1362,"_27469":1354,"_18854":47167,"_5":12679,"_25963":47145,"_2424":47168},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2886":1363,"_27469":1354,"_18854":47170,"_5":12679,"_25963":47149,"_2424":47171},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2886":1364,"_27469":1354,"_18854":47173,"_5":12679,"_25963":47153,"_2424":47174},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the flows of the configured protocol — EST or CMP — so a device can request or renew an identity.",{"_2886":1365,"_27469":1354,"_18854":47176,"_5":12679,"_25963":47157,"_2424":47177},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2886":1366,"_27469":1354,"_18854":47179,"_5":12679,"_25963":47161,"_2424":47180},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2886":1367,"_27469":1367,"_5":13057,"_2424":47182,"_27749":47183,"_18854":47184,"_25963":1367},"Certificate lifecycle",[43001,44136,47138],[],{"_2886":1368,"_27469":1367,"_18854":47186,"_5":12679,"_25963":1367,"_2424":47187},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2886":1369,"_27469":1367,"_5":27746,"_18854":47189,"_25963":47190,"_2424":47191},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2886":1370,"_27469":1367,"_5":27746,"_18854":47193,"_25963":47194,"_2424":47195},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2886":1371,"_27469":1367,"_5":27746,"_18854":47197,"_25963":47198,"_2424":47199},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2886":1372,"_27469":1367,"_5":27746,"_18854":47201,"_25963":47202,"_2424":47203},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2886":1373,"_27469":1367,"_5":27746,"_18854":47205,"_25963":47206,"_2424":47207},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2886":1374,"_27469":1367,"_5":27746,"_18854":47209,"_25963":47210,"_2424":47211},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2886":1375,"_27469":1367,"_5":27746,"_18854":47213,"_25963":47214,"_2424":47215},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2886":1376,"_27469":1367,"_5":27746,"_18854":47217,"_25963":47218,"_2424":47219},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2886":1377,"_27469":1367,"_5":27746,"_18854":47221,"_25963":47222,"_2424":47223},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2886":1378,"_27469":1367,"_5":27746,"_18854":47225,"_25963":47226,"_2424":47227},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2886":1379,"_27469":1367,"_18854":47229,"_5":12679,"_25963":1367,"_2424":47230},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2886":1380,"_27469":1367,"_18854":47232,"_5":12679,"_25963":47194,"_2424":47233},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2886":1381,"_27469":1367,"_18854":47235,"_5":12679,"_25963":47198,"_2424":47236},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2886":1382,"_27469":1367,"_18854":47238,"_5":12679,"_25963":47202,"_2424":47239},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2886":1383,"_27469":1367,"_18854":47241,"_5":12679,"_25963":47206,"_2424":47242},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2886":1384,"_27469":1367,"_18854":47244,"_5":12679,"_25963":47210,"_2424":47245},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2886":1385,"_27469":1367,"_18854":47247,"_5":12679,"_25963":47214,"_2424":47248},[],"Lamassu persists four X.509 states:",{"_2886":1386,"_27469":1367,"_18854":47250,"_5":12679,"_25963":47214,"_2424":47251},[],"**`ACTIVE`**: the certificate is enabled and within its validity period.",{"_2886":1387,"_27469":1367,"_18854":47253,"_5":12679,"_25963":47214,"_2424":47254},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2886":1388,"_27469":1367,"_18854":47256,"_5":12679,"_25963":47214,"_2424":47257},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2886":1389,"_27469":1367,"_18854":47259,"_5":12679,"_25963":47214,"_2424":47260},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2886":1390,"_27469":1367,"_18854":47262,"_5":12679,"_25963":47214,"_2424":47263},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2886":1391,"_27469":1367,"_18854":47265,"_5":12679,"_25963":47218,"_2424":47266},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2886":1392,"_27469":1367,"_18854":47268,"_5":12679,"_25963":47218,"_2424":47269},[],"Only a revocation with the reason `CertificateHold` can be undone. A revocation with any other reason is final in Lamassu.",{"_2886":1393,"_27469":1367,"_18854":47271,"_5":12679,"_25963":47218,"_2424":47272},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2886":1394,"_27469":1367,"_18854":47274,"_5":12679,"_25963":47222,"_2424":47275},[],"Revoking a CA is a cascading operation. Lamassu revokes its child CAs and the certificates it issued, with the reason `CessationOfOperation`. The propagation continues down the hierarchy.",{"_2886":1395,"_27469":1367,"_18854":47277,"_5":12679,"_25963":47222,"_2424":47278},[],"Before confirming:",{"_2886":1396,"_27469":1367,"_18854":47280,"_5":12679,"_25963":47222,"_2424":47281},[],"Identify DMSs, devices and services that trust that chain.",{"_2886":1397,"_27469":1367,"_18854":47283,"_5":12679,"_25963":47222,"_2424":47284},[],"Distribute the new chain of trust.",{"_2886":1398,"_27469":1367,"_18854":47286,"_5":12679,"_25963":47222,"_2424":47287},[],"Reissue the necessary identities.",{"_2886":1399,"_27469":1367,"_18854":47289,"_5":12679,"_25963":47222,"_2424":47290},[],"Check OCSP and CRL from a real consumer.",{"_2886":1400,"_27469":1367,"_18854":47292,"_5":12679,"_25963":47222,"_2424":47293},[],"Revoke the old CA once no legitimate traffic remains.",{"_2886":1401,"_27469":1367,"_18854":47295,"_5":12679,"_25963":47222,"_2424":47296},[],"Decommissioning a device revokes its certificates and prevents it from obtaining new identities. Use this action only when the device is being retired permanently.",{"_2886":1402,"_27469":1367,"_18854":47298,"_5":12679,"_25963":47226,"_2424":47299},[],"Certificates entering the preventive or critical renewal window.",{"_2886":1403,"_27469":1367,"_18854":47301,"_5":12679,"_25963":47226,"_2424":47302},[],"Repeated enrollment or re-enrollment failures.",{"_2886":1404,"_27469":1367,"_18854":47304,"_5":12679,"_25963":47226,"_2424":47305},[],"Status changes and revocation reasons.",{"_2886":1405,"_27469":1367,"_18854":47307,"_5":12679,"_25963":47226,"_2424":47308},[],"OCSP and CRL publication and validity.",{"_2886":1406,"_27469":1367,"_18854":47310,"_5":12679,"_25963":47226,"_2424":47311},[],"Dependencies still presenting a replaced certificate.",{"_2886":1407,"_27469":1367,"_18854":47313,"_5":12679,"_25963":47226,"_2424":47314},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2886":1408,"_27469":1408,"_5":13057,"_2424":47316,"_27749":47317,"_18854":47318,"_25963":1408},"Glossary",[43001,44136,47138],[],{"_2886":1409,"_27469":1408,"_18854":47320,"_5":12679,"_25963":1408,"_2424":47321},[],"PKI, certificate and identity management terms used in Lamassu.",{"_2886":1410,"_27469":1408,"_5":27746,"_18854":47323,"_25963":47324,"_2424":47325},[],"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","A–C",{"_2886":1411,"_27469":1408,"_5":27746,"_18854":47327,"_25963":47328,"_2424":47329},[],"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","D–K",{"_2886":1412,"_27469":1408,"_5":27746,"_18854":47331,"_25963":47332,"_2424":47333},[],"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","M–R",{"_2886":1413,"_27469":1408,"_5":27746,"_18854":47335,"_25963":47336,"_2424":47337},[],"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","S–Z",{"_2886":1414,"_27469":1408,"_18854":47339,"_5":12679,"_25963":47324,"_2424":47340},[],"**AKI (Authority Key Identifier)**\\\nIdentifier of the public key of the authority that signed a certificate. It helps build the chain toward the correct issuer.",{"_2886":1415,"_27469":1408,"_18854":47342,"_5":12679,"_25963":47324,"_2424":47343},[],"**Anchor of trust**\\\nA certificate, usually from a root CA, that a consumer explicitly accepts as the endpoint of a chain.",{"_2886":1416,"_27469":1408,"_18854":47345,"_5":12679,"_25963":47324,"_2424":47346},[],"**CA (Certification Authority)**\\\nAuthority that signs certificates and binds an identity to a public key.",{"_2886":1417,"_27469":1408,"_18854":47348,"_5":12679,"_25963":47324,"_2424":47349},[],"**Intermediate CA**\\\nA CA signed by another authority. Used to issue without exposing the root to daily operation.",{"_2886":1418,"_27469":1408,"_18854":47351,"_5":12679,"_25963":47324,"_2424":47352},[],"**Root CA**\\\nA self-signed CA that starts a hierarchy of trust.",{"_2886":1419,"_27469":1408,"_18854":47354,"_5":12679,"_25963":47324,"_2424":47355},[],"**X.509 certificate**\\\nA signed document containing a public key, a subject, an issuer, a validity period and extensions that constrain its use.",{"_2886":1420,"_27469":1408,"_18854":47357,"_5":12679,"_25963":47324,"_2424":47358},[],"**CRL (Certificate Revocation List)**\\\nSigned list of revoked certificates published by a CA.",{"_2886":1421,"_27469":1408,"_18854":47360,"_5":12679,"_25963":47324,"_2424":47361},[],"**CSR (Certificate Signing Request)**\\\nPKCS#10 request containing a public key and requested attributes. Signing the CSR proves possession of the corresponding private key.",{"_2886":1422,"_27469":1408,"_18854":47363,"_5":12679,"_25963":47328,"_2424":47364},[],"**DMS (Device Management Service)**\\\nConfiguration that groups registration, enrollment, re-enrollment, issuance and CA distribution rules for a fleet.",{"_2886":1423,"_27469":1408,"_18854":47366,"_5":12679,"_25963":47328,"_2424":47367},[],"**Distinguished Name (DN)**\\\nSet of subject or issuer attributes, such as `CN`, `O`, `OU`, `C`, `ST` and `L`.",{"_2886":1424,"_27469":1408,"_18854":47369,"_5":12679,"_25963":47328,"_2424":47370},[],"**EST (Enrollment over Secure Transport)**\\\nProtocol defined in RFC 7030 to obtain CAs, enroll and re-enroll certificates over HTTPS.",{"_2886":1425,"_27469":1408,"_18854":47372,"_5":12679,"_25963":47328,"_2424":47373},[],"**Extended Key Usage (EKU)**\\\nExtension that constrains purposes such as client authentication, server authentication, code signing or OCSP.",{"_2886":1426,"_27469":1408,"_18854":47375,"_5":12679,"_25963":47328,"_2424":47376},[],"**Device identity**\\\nRelationship between a device and one of its certificates. A device can keep a history of identities.",{"_2886":1427,"_27469":1408,"_18854":47378,"_5":12679,"_25963":47328,"_2424":47379},[],"**Identity slot**\\\nLogical position on a device where Lamassu binds an active or historical identity.",{"_2886":1428,"_27469":1408,"_18854":47381,"_5":12679,"_25963":47328,"_2424":47382},[],"**JITP (Just-in-Time Provisioning)**\\\nAutomatic registration of a device when it successfully completes its first enrollment.",{"_2886":1429,"_27469":1408,"_18854":47384,"_5":12679,"_25963":47328,"_2424":47385},[],"**KMS (Key Management Service)**\\\nLamassu service that normalizes key generation, import and use across different cryptographic engines.",{"_2886":1430,"_27469":1408,"_18854":47387,"_5":12679,"_25963":47328,"_2424":47388},[],"**Key Usage**\\\nX.509 extension that allows basic operations such as digital signature, key encryption or certificate signing.",{"_2886":1431,"_27469":1408,"_18854":47390,"_5":12679,"_25963":47332,"_2424":47391},[],"**mTLS (Mutual TLS)**\\\nTLS where both client and server present certificates. A DMS can use the client certificate as an authentication method.",{"_2886":1432,"_27469":1408,"_18854":47393,"_5":12679,"_25963":47332,"_2424":47394},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocol for querying online whether a certificate is valid, revoked or unknown.",{"_2886":1433,"_27469":1408,"_18854":47396,"_5":12679,"_25963":47332,"_2424":47397},[],"**Issuance profile**\\\nReusable policy that defines how Lamassu builds a certificate and which keys it accepts.",{"_2886":1434,"_27469":1408,"_18854":47399,"_5":12679,"_25963":47332,"_2424":47400},[],"**Principal**\\\nOperator or API client identity recognized by the authorization service. Lamassu supports OIDC and X.509 principals.",{"_2886":1435,"_27469":1408,"_18854":47402,"_5":12679,"_25963":47332,"_2424":47403},[],"**Policy**\\\nSet of permissions assignable to one or more principals.",{"_2886":1436,"_27469":1408,"_18854":47405,"_5":12679,"_25963":47332,"_2424":47406},[],"**RA (Registration Authority)**\\\nComponent that verifies the requester before asking a CA to issue. The DMS plays this role in device enrollment flows.",{"_2886":1437,"_27469":1408,"_18854":47408,"_5":12679,"_25963":47332,"_2424":47409},[],"**Relying party**\\\nConsuming system that decides whether to accept a presented certificate.",{"_2886":1438,"_27469":1408,"_18854":47411,"_5":12679,"_25963":47332,"_2424":47412},[],"**Revocation**\\\nInvalidation of a certificate before its expiration date.",{"_2886":1439,"_27469":1408,"_18854":47414,"_5":12679,"_25963":47336,"_2424":47415},[],"**SAN (Subject Alternative Name)**\\\nExtension that adds identities such as DNS names, IP addresses, emails or URIs.",{"_2886":1440,"_27469":1408,"_18854":47417,"_5":12679,"_25963":47336,"_2424":47418},[],"**SKI (Subject Key Identifier)**\\\nIdentifier derived from the public key of the certificate itself.",{"_2886":1441,"_27469":1408,"_18854":47420,"_5":12679,"_25963":47336,"_2424":47421},[],"**VA (Validation Authority)**\\\nLamassu service responsible for OCSP responses and the generation or publication of CRLs.",{"_2886":1442,"_27469":1408,"_18854":47423,"_5":12679,"_25963":47336,"_2424":47424},[],"**Renewal window**\\\nPeriod before expiration during which a device may or must request another identity.",{"_2886":1443,"_27469":1408,"_18854":47426,"_5":12679,"_25963":47336,"_2424":47427},[],"Missing an operational term? Check How Lamassu works and the Trust model first, where these concepts appear connected.",{"_2886":1444,"_27469":1444,"_5":13057,"_2424":47429,"_27749":47430,"_18854":47431,"_25963":1444},"How Lamassu works",[43001,44136,47138],[],{"_2886":1445,"_27469":1444,"_18854":47433,"_5":12679,"_25963":1444,"_2424":47434},[],"The mental model of trust, keys, certificates and devices.",{"_2886":1446,"_27469":1444,"_5":27746,"_18854":47436,"_25963":47437,"_2424":47438},[],"/docs/pr-preview/pr-24/platform/pki/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2886":1447,"_27469":1444,"_5":27746,"_18854":47440,"_25963":47441,"_2424":47442},[],"/docs/pr-preview/pr-24/platform/pki/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2886":1448,"_27469":1444,"_18854":47444,"_5":12679,"_25963":1444,"_2424":47445},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2886":1449,"_27469":1444,"_18854":47447,"_5":12679,"_25963":47437,"_2424":47448},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2886":1450,"_27469":1444,"_18854":47450,"_5":12679,"_25963":47437,"_2424":47451},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2886":1451,"_27469":1444,"_18854":47453,"_5":12679,"_25963":47437,"_2424":47454},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2886":1452,"_27469":1444,"_18854":47456,"_5":12679,"_25963":47437,"_2424":47457},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2886":1453,"_27469":1444,"_18854":47459,"_5":12679,"_25963":47437,"_2424":47460},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2886":1454,"_27469":1444,"_18854":47462,"_5":12679,"_25963":47441,"_2424":47463},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2886":1455,"_27469":1444,"_18854":47465,"_5":12679,"_25963":47441,"_2424":47466},[],"A DMS relates that CA to an enrollment policy.",{"_2886":1456,"_27469":1444,"_18854":47468,"_5":12679,"_25963":47441,"_2424":47469},[],"The device generates a key and requests a certificate through EST or CMP, or an operator assigns it an identity.",{"_2886":1457,"_27469":1444,"_18854":47471,"_5":12679,"_25963":47441,"_2424":47472},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2886":1458,"_27469":1444,"_18854":47474,"_5":12679,"_25963":47441,"_2424":47475},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2886":1459,"_27469":1444,"_18854":47477,"_5":12679,"_25963":47441,"_2424":47478},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_2886":1460,"_27469":1444,"_18854":47480,"_5":12679,"_25963":47441,"_2424":47481},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2886":1461,"_27469":1461,"_5":13057,"_2424":47483,"_27749":47484,"_18854":47485,"_25963":1461},"Trust model",[43001,44136,47138],[],{"_2886":1462,"_27469":1461,"_18854":47487,"_5":12679,"_25963":1461,"_2424":47488},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2886":1463,"_27469":1461,"_5":27746,"_18854":47490,"_25963":47491,"_2424":47492},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2886":1464,"_27469":1461,"_5":27746,"_18854":47494,"_25963":47495,"_2424":47496},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2886":1465,"_27469":1461,"_5":27746,"_18854":47498,"_25963":47499,"_2424":47500},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2886":1466,"_27469":1461,"_5":27746,"_18854":47502,"_25963":47503,"_2424":47504},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2886":1467,"_27469":1461,"_5":27746,"_18854":47506,"_25963":47507,"_2424":47508},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2886":1468,"_27469":1461,"_5":27746,"_18854":47510,"_25963":47511,"_2424":47512},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2886":1469,"_27469":1461,"_5":27746,"_18854":47514,"_25963":47515,"_2424":47516},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2886":1470,"_27469":1461,"_5":27746,"_18854":47518,"_25963":47519,"_2424":47520},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2886":1471,"_27469":1461,"_5":27746,"_18854":47522,"_25963":47523,"_2424":47524},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2886":1472,"_27469":1461,"_5":27746,"_18854":47526,"_25963":47527,"_2424":47528},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2886":1473,"_27469":1461,"_18854":47530,"_5":12679,"_25963":1461,"_2424":47531},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2886":1474,"_27469":1461,"_18854":47533,"_5":12679,"_25963":47495,"_2424":47534},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2886":1475,"_27469":1461,"_18854":47536,"_5":12679,"_25963":47499,"_2424":47537},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2886":1476,"_27469":1461,"_18854":47539,"_5":12679,"_25963":47503,"_2424":47540},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2886":1477,"_27469":1461,"_18854":47542,"_5":12679,"_25963":47507,"_2424":47543},[],"The consuming service or device keeps its own trust store. Lamassu can distribute the system CA, the enrollment CA and other managed CAs through `/cacerts`, but the consumer decides which ones it installs and how it applies validation.",{"_2886":1478,"_27469":1461,"_18854":47545,"_5":12679,"_25963":47511,"_2424":47546},[],"The device proves it can enroll according to the DMS policy.",{"_2886":1479,"_27469":1461,"_18854":47548,"_5":12679,"_25963":47511,"_2424":47549},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2886":1480,"_27469":1461,"_18854":47551,"_5":12679,"_25963":47511,"_2424":47552},[],"The CA applies the profile and signs without ever receiving the device's private key.",{"_2886":1481,"_27469":1461,"_18854":47554,"_5":12679,"_25963":47511,"_2424":47555},[],"The device installs the certificate and the chain it needs.",{"_2886":1482,"_27469":1461,"_18854":47557,"_5":12679,"_25963":47511,"_2424":47558},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2886":1483,"_27469":1461,"_18854":47560,"_5":12679,"_25963":47511,"_2424":47561},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2886":1484,"_27469":1461,"_18854":47563,"_5":12679,"_25963":47515,"_2424":47564},[],"A DMS relates three sets that are worth designing separately:",{"_2886":1485,"_27469":1461,"_18854":47566,"_5":12679,"_25963":47515,"_2424":47567},[],"**Enrollment CA:** signs the new identities.",{"_2886":1486,"_27469":1461,"_18854":47569,"_5":12679,"_25963":47515,"_2424":47570},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2886":1487,"_27469":1461,"_18854":47572,"_5":12679,"_25963":47515,"_2424":47573},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the system CA, the enrollment CA and a list of managed CAs.",{"_2886":1488,"_27469":1461,"_18854":47575,"_5":12679,"_25963":47515,"_2424":47576},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2886":1489,"_27469":1461,"_18854":47578,"_5":12679,"_25963":47519,"_2424":47579},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2886":1490,"_27469":1461,"_18854":47581,"_5":12679,"_25963":47519,"_2424":47582},[],"that the current date is between `Not Before` and `Not After`;",{"_2886":1491,"_27469":1461,"_18854":47584,"_5":12679,"_25963":47519,"_2424":47585},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2886":1492,"_27469":1461,"_18854":47587,"_5":12679,"_25963":47519,"_2424":47588},[],"that names, SANs and subject match the expected identity;",{"_2886":1493,"_27469":1461,"_18854":47590,"_5":12679,"_25963":47519,"_2424":47591},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2886":1494,"_27469":1461,"_18854":47593,"_5":12679,"_25963":47519,"_2424":47594},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2886":1495,"_27469":1461,"_18854":47596,"_5":12679,"_25963":47523,"_2424":47597},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2886":1496,"_27469":1461,"_18854":47599,"_5":12679,"_25963":47527,"_2424":47600},[],"Keep the root out of daily operations, or with very restricted access.",{"_2886":1497,"_27469":1461,"_18854":47602,"_5":12679,"_25963":47527,"_2424":47603},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2886":1498,"_27469":1461,"_18854":47605,"_5":12679,"_25963":47527,"_2424":47606},[],"Assign explicit profiles to every use case.",{"_2886":1499,"_27469":1461,"_18854":47608,"_5":12679,"_25963":47527,"_2424":47609},[],"Distribute the new trust before starting a rotation.",{"_2886":1500,"_27469":1461,"_18854":47611,"_5":12679,"_25963":47527,"_2424":47612},[],"Keep enough overlap to renew a disconnected fleet.",{"_2886":1501,"_27469":1461,"_18854":47614,"_5":12679,"_25963":47527,"_2424":47615},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2886":1502,"_27469":1461,"_18854":47617,"_5":12679,"_25963":47527,"_2424":47618},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2886":1503,"_27469":1503,"_5":13057,"_2424":47620,"_27749":47621,"_18854":47622,"_25963":1503},"Revocation lists (CRL)",[43001,44136,44614],[],{"_2886":1504,"_27469":1503,"_18854":47624,"_5":12679,"_25963":1503,"_2424":47625},[],"Generate and distribute signed lists to validate certificates offline.",{"_2886":1505,"_27469":1503,"_5":27746,"_18854":47627,"_25963":47628,"_2424":47629},[],"/docs/pr-preview/pr-24/platform/pki/crl#crl-service","CRL service",{"_2886":1506,"_27469":1503,"_5":27746,"_18854":47631,"_25963":47632,"_2424":47633},[],"/docs/pr-preview/pr-24/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2886":1507,"_27469":1503,"_5":27746,"_18854":47635,"_25963":47636,"_2424":47637},[],"/docs/pr-preview/pr-24/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2886":1508,"_27469":1503,"_5":27746,"_18854":47639,"_25963":47640,"_2424":47641},[],"/docs/pr-preview/pr-24/platform/pki/crl#crl-contents","CRL contents",{"_2886":1509,"_27469":1503,"_5":27746,"_18854":47643,"_25963":47644,"_2424":47645},[],"/docs/pr-preview/pr-24/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2886":1510,"_27469":1503,"_5":27746,"_18854":47647,"_25963":47648,"_2424":47649},[],"/docs/pr-preview/pr-24/platform/pki/crl#va-role-management-api","VA role management API",{"_2886":1511,"_27469":1503,"_5":27746,"_18854":47651,"_25963":47652,"_2424":47653},[],"/docs/pr-preview/pr-24/platform/pki/crl#from-the-interface","From the interface",{"_2886":1512,"_27469":1503,"_5":27746,"_18854":47655,"_25963":47656,"_2424":47657},[],"/docs/pr-preview/pr-24/platform/pki/crl#references","References",{"_2886":1513,"_27469":1503,"_18854":47659,"_5":12679,"_25963":47628,"_2424":47660},[],"A CRL (*Certificate Revocation List*) is a signed list containing the serial numbers of certificates revoked before their expiration date. Unlike OCSP, it does not require a real-time query: the relying party downloads the list periodically and consults it locally.",{"_2886":1514,"_27469":1503,"_18854":47662,"_5":12679,"_25963":47628,"_2424":47663},[],"Lamassu generates and maintains one CRL per CA it manages. Each CRL is signed with the private key of the issuing CA itself and is stored in the object storage configured on the platform.",{"_2886":1515,"_27469":1503,"_18854":47665,"_5":12679,"_25963":47632,"_2424":47666},[],"The publication of each CA's CRL is controlled by a *VA role*. This object defines how it is generated, when it is regenerated and which key signs it.",{"_2886":1516,"_27469":1503,"_18854":47668,"_5":12679,"_25963":47632,"_2424":47669},[],"The main parameters are:",{"_2886":1517,"_27469":1503,"_18854":47671,"_5":12679,"_25963":47632,"_2424":47672},[],"**`validity`** defines the validity period reflected in `nextUpdate`. Its default value is 7 days.",{"_2886":1518,"_27469":1503,"_18854":47674,"_5":12679,"_25963":47632,"_2424":47675},[],"**`refresh_interval`** sets the minimum interval between scheduled regenerations. By default it is approximately 6 days and 23 hours.",{"_2886":1519,"_27469":1503,"_18854":47677,"_5":12679,"_25963":47632,"_2424":47678},[],"**`regenerate_on_revoke`** orders publishing a new version immediately after a revocation. It is enabled by default.",{"_2886":1520,"_27469":1503,"_18854":47680,"_5":12679,"_25963":47632,"_2424":47681},[],"The `subject_key_id_signer` field identifies the CA whose private key signs the CRL. By default, each CA signs its own CRL.",{"_2886":1521,"_27469":1503,"_18854":47683,"_5":12679,"_25963":47632,"_2424":47684},[],"Each CRL carries an incremental version number. Lamassu stores all versions under the path `pki/va/crl/{subject_key_id}/{version}.crl` in object storage.",{"_2886":1522,"_27469":1503,"_18854":47686,"_5":12679,"_25963":47636,"_2424":47687},[],"A background process monitors active VA roles. When the remaining validity of the current CRL falls below the configured watch period (*blind period*), the system requests the generation of a new CRL. This prevents the published CRL from expiring without a valid version available.",{"_2886":1523,"_27469":1503,"_18854":47689,"_5":12679,"_25963":47636,"_2424":47690},[],"Additionally, when `regenerate_on_revoke` is enabled, which is the default behavior, any certificate revocation immediately triggers the generation of a new CRL for the affected CA. This minimizes the time between revocation and its publication.",{"_2886":1524,"_27469":1503,"_18854":47692,"_5":12679,"_25963":47640,"_2424":47693},[],"Each entry of the CRL includes the serial number of the revoked certificate, the revocation date and the RFC 5280 reason code.",{"_2886":1525,"_27469":1503,"_18854":47695,"_5":12679,"_25963":47640,"_2424":47696},[],"The CRL also includes the *Issuing Distribution Point* (IDP, OID 2.5.29.28) extension, marked as critical, which indicates the public URL from which it can be downloaded. That URL points to the `/crl/{subject_key_id}` endpoint of each configured VA domain.",{"_2886":1526,"_27469":1503,"_18854":47698,"_5":12679,"_25963":47644,"_2424":47699},[],"The latest CRL of a CA can be obtained directly without authentication:",{"_2886":1527,"_27469":1503,"_18854":47701,"_5":12679,"_25963":47644,"_2424":47702},[],"The response has `Content-Type: application/pkix-crl` and contains the CRL in DER format.",{"_2886":1528,"_27469":1503,"_18854":47704,"_5":12679,"_25963":47648,"_2424":47705},[],"The VA role of a CA can be queried and updated through the API:",{"_2886":1529,"_27469":1503,"_18854":47707,"_5":12679,"_25963":47648,"_2424":47708},[],"Method",{"_2886":1530,"_27469":1503,"_18854":47710,"_5":12679,"_25963":47648,"_2424":47711},[],"Path",{"_2886":1531,"_27469":1503,"_18854":47713,"_5":12679,"_25963":47648,"_2424":45907},[],{"_2886":1532,"_27469":1503,"_18854":47715,"_5":12679,"_25963":47648,"_2424":47716},[],"`GET`",{"_2886":1533,"_27469":1503,"_18854":47718,"_5":12679,"_25963":47648,"_2424":47719},[],"`/v1/roles/{ca-ski}`",{"_2886":1534,"_27469":1503,"_18854":47721,"_5":12679,"_25963":47648,"_2424":47722},[],"Returns the VA role configuration and the metadata of the last issued CRL.",{"_2886":1535,"_27469":1503,"_18854":47724,"_5":12679,"_25963":47648,"_2424":47725},[],"`PUT`",{"_2886":1536,"_27469":1503,"_18854":47727,"_5":12679,"_25963":47648,"_2424":47719},[],{"_2886":1537,"_27469":1503,"_18854":47729,"_5":12679,"_25963":47648,"_2424":47730},[],"Updates the VA role configuration parameters (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_2886":1538,"_27469":1503,"_18854":47732,"_5":12679,"_25963":47648,"_2424":47733},[],"Example of querying the VA role:",{"_2886":1539,"_27469":1503,"_18854":47735,"_5":12679,"_25963":47648,"_2424":47736},[],"The response includes the `latest_crl` field with the version, the start of validity and the expiration date of the currently published CRL.",{"_2886":1540,"_27469":1503,"_18854":47738,"_5":12679,"_25963":47652,"_2424":47739},[],"From a CA's detail panel you can preview the content of the active CRL and download it directly for offline use or for importing into applications that perform local validation.",{"_2886":1541,"_27469":1503,"_18854":47741,"_5":12679,"_25963":47656,"_2424":47742},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_2886":1542,"_27469":1503,"_18854":47744,"_5":12679,"_25963":47656,"_2424":47745},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2886":1543,"_27469":1503,"_18854":47747,"_5":12679,"_25963":47656,"_2424":47748},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2886":1544,"_27469":1544,"_5":13057,"_2424":47750,"_27749":47751,"_18854":47752,"_25963":1544},"Device Management Service",[43001,44136,44614],[],{"_2886":1545,"_27469":1544,"_18854":47754,"_5":12679,"_25963":1544,"_2424":47755},[],"Define how a fleet receives, renews and uses its identities.",{"_2886":1546,"_27469":1544,"_5":27746,"_18854":47757,"_25963":47758,"_2424":43011},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#before-you-begin",{"_2886":1547,"_27469":1544,"_5":27746,"_18854":47760,"_25963":47761,"_2424":47762},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#configure-a-dms","Configure a DMS",{"_2886":1548,"_27469":1544,"_5":27746,"_18854":47764,"_25963":47765,"_2424":47766},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#identify-the-fleet","Identify the fleet",{"_2886":1549,"_27469":1544,"_5":27746,"_18854":47768,"_25963":47769,"_2424":47770},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#select-the-enrollment-ca","Select the enrollment CA",{"_2886":1550,"_27469":1544,"_5":27746,"_18854":47772,"_25963":47773,"_2424":47774},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#configure-the-enrollment-protocol","Configure the enrollment protocol",{"_2886":1551,"_27469":1544,"_5":27746,"_18854":47776,"_25963":47777,"_2424":47778},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#distribute-trust","Distribute trust",{"_2886":1552,"_27469":1544,"_5":27746,"_18854":47780,"_25963":47781,"_2424":47782},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#verify-the-endpoints","Verify the endpoints",{"_2886":1553,"_27469":1544,"_5":27746,"_18854":47784,"_25963":47785,"_2424":47786},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#trust-distribution","Trust distribution",{"_2886":1554,"_27469":1544,"_5":27746,"_18854":47788,"_25963":47789,"_2424":47790},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#operate-the-dms-inventory","Operate the DMS inventory",{"_2886":1555,"_27469":1544,"_5":27746,"_18854":47792,"_25963":47793,"_2424":47794},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#integrate-the-devices","Integrate the devices",{"_2886":1556,"_27469":1544,"_18854":47796,"_5":12679,"_25963":1544,"_2424":47797},[],"A &#x2A;*Device Management Service (DMS)** acts as the registration authority facing a fleet. It receives requests, applies the authentication policy and delegates issuance to the configured CA.",{"_2886":1557,"_27469":1544,"_18854":47799,"_5":12679,"_25963":1544,"_2424":47800},[],"Each DMS is an independent operational boundary: it can represent a product line, an environment or a device type with its own CA, authentication rules, distributed trust and renewal window.",{"_2886":1558,"_27469":1544,"_18854":47802,"_5":12679,"_25963":1544,"_2424":47803},[],"Each DMS exposes a single enrollment protocol, selected when it is created or edited: &#x2A;*EST (RFC 7030)** or &#x2A;*CMP (RFC 9483 Lightweight CMP Profile / RFC 4210)**. The two protocols are mutually exclusive: changing the protocol of an existing DMS replaces its enrollment configuration entirely, without automatic migration of settings. Each protocol's configuration and the device integration guide are documented in the EST and CMP pages.",{"_2886":1559,"_27469":1544,"_18854":47805,"_5":12679,"_25963":47758,"_2424":47806},[],"Create or import at least one active CA.",{"_2886":1560,"_27469":1544,"_18854":47808,"_5":12679,"_25963":47758,"_2424":47809},[],"Decide how devices will authenticate during initial enrollment.",{"_2886":1561,"_27469":1544,"_18854":47811,"_5":12679,"_25963":47758,"_2424":47812},[],"Define which authorities the device should receive as anchors of trust.",{"_2886":1562,"_27469":1544,"_18854":47814,"_5":12679,"_25963":47758,"_2424":47815},[],"Make sure you have permissions to administer DMSs.",{"_2886":1563,"_27469":1544,"_18854":47817,"_5":12679,"_25963":47765,"_2424":47818},[],"Give the DMS a name that describes its scope, for example a device family or an environment.",{"_2886":1564,"_27469":1544,"_18854":47820,"_5":12679,"_25963":47769,"_2424":47821},[],"Choose the authority that will issue the identities. Its policy and validity period constrain the certificates the fleet can obtain.",{"_2886":1565,"_27469":1544,"_18854":47823,"_5":12679,"_25963":47773,"_2424":47824},[],"Select EST (RFC 7030) or CMP (RFC 9483) and define the authentication of `enroll`, the `reenroll` policy, the renewal window and, if needed, server-side key generation.",{"_2886":1566,"_27469":1544,"_18854":47826,"_5":12679,"_25963":47777,"_2424":47827},[],"Configure **CA Distribution** to control which authorities the device receives as anchors of trust, regardless of the enrollment protocol.",{"_2886":1567,"_27469":1544,"_18854":47829,"_5":12679,"_25963":47781,"_2424":47830},[],"From the DMS menu, open &#x2A;*EST (RFC-7030)** and check the base URL and the invocation examples before integrating the firmware.",{"_2886":1568,"_27469":1544,"_18854":47832,"_5":12679,"_25963":47785,"_2424":47833},[],"**Include Lamassu System CA** distributes the TLS certificate of the Lamassu server, useful for *pinning*. It does not represent an issuing CA.",{"_2886":1569,"_27469":1544,"_18854":47835,"_5":12679,"_25963":47785,"_2424":47836},[],"**Include Enrollment CA** adds the authority configured to issue the DMS's identities.",{"_2886":1570,"_27469":1544,"_18854":47838,"_5":12679,"_25963":47785,"_2424":47839},[],"**Managed CAs** lets you include additional authorities the device must consider trusted.",{"_2886":1571,"_27469":1544,"_18854":47841,"_5":12679,"_25963":47789,"_2424":47842},[],"**Edit** modifies the DMS policy.",{"_2886":1572,"_27469":1544,"_18854":47844,"_5":12679,"_25963":47789,"_2424":47845},[],"**Go to DMS owned devices** opens only the devices of that fleet.",{"_2886":1573,"_27469":1544,"_18854":47847,"_5":12679,"_25963":47789,"_2424":47848},[],"**Show/Edit Metadata** manages advanced configuration and integration data.",{"_2886":1574,"_27469":1544,"_18854":47850,"_5":12679,"_25963":47789,"_2424":47851},[],"**EST (RFC-7030)** shows the endpoints and examples specific to the DMS.",{"_2886":1575,"_27469":1544,"_18854":47853,"_5":12679,"_25963":47789,"_2424":47854},[],"**Delete** removes the DMS and its configuration. The action is irreversible.",{"_2886":1576,"_27469":1544,"_18854":47856,"_5":12679,"_25963":47793,"_2424":47857},[],"<Card title=\"EST enrollment\" description=\"Configure authentication, endpoints and flows for firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2886":1577,"_27469":1544,"_18854":47859,"_5":12679,"_25963":47793,"_2424":47860},[],"<Card title=\"CMP enrollment\" description=\"Configure authentication, operations and transactions for firmware.\" href=\"/docs/platform/pki/cmp\" />",{"_2886":1578,"_27469":1544,"_18854":47862,"_5":12679,"_25963":47793,"_2424":47863},[],"<Card title=\"Devices and identities\" description=\"Review statuses, history and operational actions.\" href=\"/docs/platform/pki/device-management\" />",{"_2886":1579,"_27469":1579,"_5":13057,"_2424":47865,"_27749":47866,"_18854":47867,"_25963":1579},"Devices and identities",[43001,44136,44614],[],{"_2886":1580,"_27469":1579,"_18854":47869,"_5":12679,"_25963":1579,"_2424":47870},[],"Register devices and control their identities throughout the lifecycle.",{"_2886":1581,"_27469":1579,"_5":27746,"_18854":47872,"_25963":47873,"_2424":47874},[],"/docs/pr-preview/pr-24/platform/pki/device-management#device-states","Device states",{"_2886":1582,"_27469":1579,"_5":27746,"_18854":47876,"_25963":47877,"_2424":47878},[],"/docs/pr-preview/pr-24/platform/pki/device-management#inspect-a-device","Inspect a device",{"_2886":1583,"_27469":1579,"_5":27746,"_18854":47880,"_25963":47881,"_2424":47882},[],"/docs/pr-preview/pr-24/platform/pki/device-management#register-a-device-manually","Register a device manually",{"_2886":1584,"_27469":1579,"_5":27746,"_18854":47884,"_25963":47885,"_2424":47886},[],"/docs/pr-preview/pr-24/platform/pki/device-management#create-the-device","Create the device",{"_2886":1585,"_27469":1579,"_5":27746,"_18854":47888,"_25963":47889,"_2424":47890},[],"/docs/pr-preview/pr-24/platform/pki/device-management#define-its-membership","Define its membership",{"_2886":1586,"_27469":1579,"_5":27746,"_18854":47892,"_25963":47893,"_2424":47894},[],"/docs/pr-preview/pr-24/platform/pki/device-management#classify-the-device","Classify the device",{"_2886":1587,"_27469":1579,"_5":27746,"_18854":47896,"_25963":47897,"_2424":47898},[],"/docs/pr-preview/pr-24/platform/pki/device-management#verify-the-registration","Verify the registration",{"_2886":1588,"_27469":1579,"_5":27746,"_18854":47900,"_25963":47901,"_2424":47902},[],"/docs/pr-preview/pr-24/platform/pki/device-management#assign-an-identity-manually","Assign an identity manually",{"_2886":1589,"_27469":1579,"_5":27746,"_18854":47904,"_25963":47905,"_2424":47906},[],"/docs/pr-preview/pr-24/platform/pki/device-management#revoke-the-current-identity","Revoke the current identity",{"_2886":1590,"_27469":1579,"_5":27746,"_18854":47908,"_25963":47909,"_2424":47910},[],"/docs/pr-preview/pr-24/platform/pki/device-management#decommission-a-device","Decommission a device",{"_2886":1591,"_27469":1579,"_5":27746,"_18854":47912,"_25963":47913,"_2424":47914},[],"/docs/pr-preview/pr-24/platform/pki/device-management#automate-enrollment","Automate enrollment",{"_2886":1592,"_27469":1579,"_18854":47916,"_5":12679,"_25963":1579,"_2424":47917},[],"A managed device represents an entity in your fleet and keeps the history of the certificates it has used. Lamassu separates the device from its current identity so you can renew or replace certificates without losing traceability.",{"_2886":1593,"_27469":1579,"_18854":47919,"_5":12679,"_25963":47873,"_2424":47920},[],"**Active** indicates the device has a valid identity.",{"_2886":1594,"_27469":1579,"_18854":47922,"_5":12679,"_25963":47873,"_2424":47923},[],"**No Identity** appears when it is registered but does not yet have an associated certificate.",{"_2886":1595,"_27469":1579,"_18854":47925,"_5":12679,"_25963":47873,"_2424":47926},[],"**Renewal Pending** signals that it has entered the renewal window.",{"_2886":1596,"_27469":1579,"_18854":47928,"_5":12679,"_25963":47873,"_2424":47929},[],"**Expiring Soon** warns that the certificate is close to expiring.",{"_2886":1597,"_27469":1579,"_18854":47931,"_5":12679,"_25963":47873,"_2424":47932},[],"**Expired** indicates the identity has passed its validity date.",{"_2886":1598,"_27469":1579,"_18854":47934,"_5":12679,"_25963":47873,"_2424":47935},[],"**Revoked** identifies a certificate invalidated before its expiration.",{"_2886":1599,"_27469":1579,"_18854":47937,"_5":12679,"_25963":47873,"_2424":47938},[],"**Decommissioned** corresponds to a device permanently retired.",{"_2886":1600,"_27469":1579,"_18854":47940,"_5":12679,"_25963":47873,"_2424":47941},[],"The inventory lets you filter by `Device ID`, tags and status.",{"_2886":1601,"_27469":1579,"_18854":47943,"_5":12679,"_25963":47877,"_2424":47944},[],"The detail view separates two perspectives:",{"_2886":1602,"_27469":1579,"_18854":47946,"_5":12679,"_25963":47877,"_2424":47947},[],"**Certificate History** keeps every certificate associated with the device, with its serial number, issuer, status and validity period.",{"_2886":1603,"_27469":1579,"_18854":47949,"_5":12679,"_25963":47877,"_2424":47950},[],"**Device Event Timeline** orders registrations, enrollments, renewals and status changes chronologically.",{"_2886":1604,"_27469":1579,"_18854":47952,"_5":12679,"_25963":47877,"_2424":47953},[],"Use the history for audit and the timeline to reconstruct an incident or diagnose an unexpected transition.",{"_2886":1605,"_27469":1579,"_18854":47955,"_5":12679,"_25963":47881,"_2424":47956},[],"Pre-registration is useful when policy requires the device to exist before requesting its first certificate.",{"_2886":1606,"_27469":1579,"_18854":47958,"_5":12679,"_25963":47885,"_2424":47959},[],"From **Managed Devices**, open the registration form.",{"_2886":1607,"_27469":1579,"_18854":47961,"_5":12679,"_25963":47889,"_2424":47962},[],"Enter a unique **Device ID** and select the DMS that will apply the enrollment and renewal policies.",{"_2886":1608,"_27469":1579,"_18854":47964,"_5":12679,"_25963":47893,"_2424":47965},[],"Add an icon and tags if you need to group devices by model, location, environment or another operational criterion.",{"_2886":1609,"_27469":1579,"_18854":47967,"_5":12679,"_25963":47897,"_2424":47968},[],"The device should appear with status **No Identity** until it completes enrollment or receives a manually assigned identity.",{"_2886":1610,"_27469":1579,"_18854":47970,"_5":12679,"_25963":47901,"_2424":47971},[],"The **Assign Identity** action is available while the device remains in **No Identity**.",{"_2886":1611,"_27469":1579,"_18854":47973,"_5":12679,"_25963":47901,"_2424":47974},[],"Open the device and select **Assign Identity**.",{"_2886":1612,"_27469":1579,"_18854":47976,"_5":12679,"_25963":47901,"_2424":47977},[],"Choose an active certificate whose `Common Name` matches the `Device ID`.",{"_2886":1613,"_27469":1579,"_18854":47979,"_5":12679,"_25963":47901,"_2424":47980},[],"If none exists, select **Issue New Instead** and choose a CA linked to the DMS.",{"_2886":1614,"_27469":1579,"_18854":47982,"_5":12679,"_25963":47901,"_2424":47983},[],"Confirm the assignment.",{"_2886":1615,"_27469":1579,"_18854":47985,"_5":12679,"_25963":47901,"_2424":47986},[],"The device should change to **Active** and the certificate should appear in its history.",{"_2886":1616,"_27469":1579,"_18854":47988,"_5":12679,"_25963":47905,"_2424":47989},[],"In **Device Event Timeline**, locate the latest active certificate and select **Revoke**. Choose a reason consistent with your policy and confirm the operation.",{"_2886":1617,"_27469":1579,"_18854":47991,"_5":12679,"_25963":47905,"_2424":47992},[],"Revocation invalidates the certificate but does not delete the device. You can restore its operation by assigning it a new identity. `CertificateHold` allows reactivating the retained certificate; all other reasons are final.",{"_2886":1618,"_27469":1579,"_18854":47994,"_5":12679,"_25963":47909,"_2424":47995},[],"This action revokes all the device's certificates and prevents it from obtaining an identity again.",{"_2886":1619,"_27469":1579,"_18854":47997,"_5":12679,"_25963":47909,"_2424":47998},[],"Use **Decommission** only when the device has stopped operating or is no longer trustworthy. After confirming, Lamassu revokes the active identity with `CessationOfOperation` and changes the status to **Decommissioned**.",{"_2886":1620,"_27469":1579,"_18854":48000,"_5":12679,"_25963":47913,"_2424":48001},[],"<Card title=\"Configure a DMS\" description=\"Define the CA, trust and policies of the fleet.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2886":1621,"_27469":1579,"_18854":48003,"_5":12679,"_25963":47913,"_2424":48004},[],"<Card title=\"Integrate EST\" description=\"Let the device request and renew its identity.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2886":1622,"_27469":1579,"_18854":48006,"_5":12679,"_25963":47913,"_2424":48007},[],"<Card title=\"Integrate CMP\" description=\"Let the device enroll and renew its identity with CMP.\" href=\"/docs/platform/pki/cmp\" />",{"_2886":1623,"_27469":1623,"_5":13057,"_2424":48009,"_27749":48010,"_18854":48011,"_25963":1623},"Device enrollment with EST",[43001,44136,44614],[],{"_2886":1624,"_27469":1623,"_18854":48013,"_5":12679,"_25963":1623,"_2424":48014},[],"EST protocol guide for Lamassu IoT, with DMS configuration for the PKI administrator and the endpoint reference for device integrators.",{"_2886":1625,"_27469":1623,"_5":27746,"_18854":48016,"_25963":48017,"_2424":48018},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_2886":1626,"_27469":1623,"_5":27746,"_18854":48020,"_25963":48021,"_2424":45598},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#dms-configuration",{"_2886":1627,"_27469":1623,"_5":27746,"_18854":48023,"_25963":48024,"_2424":45602},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#prerequisites",{"_2886":1628,"_27469":1623,"_5":27746,"_18854":48026,"_25963":48027,"_2424":48028},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#enrollment-configuration","Enrollment configuration",{"_2886":1629,"_27469":1623,"_5":27746,"_18854":48030,"_25963":48031,"_2424":48032},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_2886":1630,"_27469":1623,"_5":27746,"_18854":48034,"_25963":48035,"_2424":48036},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_2886":1631,"_27469":1623,"_5":27746,"_18854":48038,"_25963":48039,"_2424":48040},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#issuance-profile","Issuance profile",{"_2886":1632,"_27469":1623,"_5":27746,"_18854":48042,"_25963":48043,"_2424":45666},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#re-enrollment-configuration",{"_2886":1633,"_27469":1623,"_5":27746,"_18854":48045,"_25963":48046,"_2424":48047},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#serverkeygen-configuration","ServerKeyGen configuration",{"_2886":1634,"_27469":1623,"_5":27746,"_18854":48049,"_25963":48050,"_2424":45682},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#verify-the-configuration",{"_2886":1635,"_27469":1623,"_5":27746,"_18854":48052,"_25963":48053,"_2424":45686},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#device-integration",{"_2886":1636,"_27469":1623,"_5":27746,"_18854":48055,"_25963":48056,"_2424":43011},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#before-you-begin",{"_2886":1637,"_27469":1623,"_5":27746,"_18854":48058,"_25963":48059,"_2424":48060},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#flow-overview","Flow overview",{"_2886":1638,"_27469":1623,"_5":27746,"_18854":48062,"_25963":48063,"_2424":48064},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#client-authentication-model","Client authentication model",{"_2886":1639,"_27469":1623,"_5":27746,"_18854":48066,"_25963":48067,"_2424":48068},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#endpoint-reference","Endpoint reference",{"_2886":1640,"_27469":1623,"_5":27746,"_18854":48070,"_25963":48071,"_2424":48072},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_2886":1641,"_27469":1623,"_5":27746,"_18854":48074,"_25963":48075,"_2424":48076},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_2886":1642,"_27469":1623,"_5":27746,"_18854":48078,"_25963":48079,"_2424":48080},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_2886":1643,"_27469":1623,"_5":27746,"_18854":48082,"_25963":48083,"_2424":48084},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_2886":1644,"_27469":1623,"_5":27746,"_18854":48086,"_25963":48087,"_2424":48088},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#full-flows","Full flows",{"_2886":1645,"_27469":1623,"_5":27746,"_18854":48090,"_25963":48091,"_2424":48092},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#end-to-end-example-enroll","End-to-end example: enroll",{"_2886":1646,"_27469":1623,"_5":27746,"_18854":48094,"_25963":48095,"_2424":48096},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#end-to-end-example-reenroll","End-to-end example: reenroll",{"_2886":1647,"_27469":1623,"_5":27746,"_18854":48098,"_25963":48099,"_2424":45745},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#next-steps-after-enrollment",{"_2886":1648,"_27469":1623,"_5":27746,"_18854":48101,"_25963":48102,"_2424":45749},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#diagnostics-and-compatibility",{"_2886":1649,"_27469":1623,"_5":27746,"_18854":48104,"_25963":48105,"_2424":45753},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#error-codes-and-diagnostics",{"_2886":1650,"_27469":1623,"_5":27746,"_18854":48107,"_25963":48108,"_2424":45757},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#compatibility-notes",{"_2886":1651,"_27469":1623,"_18854":48110,"_5":12679,"_25963":48017,"_2424":48111},[],"Lamassu IoT implements the &#x2A;*EST (Enrollment over Secure Transport)** protocol described in RFC 7030 as one of its device certificate-enrollment mechanisms — the other is CMP (RFC 9483). Each DMS exposes one of the two protocols, never both at once. The DMS that exposes EST validates the device and applies its own authentication, registration and renewal policies — acting as the Registration Authority (RA) facing the client.",{"_2886":1652,"_27469":1623,"_18854":48113,"_5":12679,"_25963":48017,"_2424":48114},[],"The entity that issues and cryptographically signs the certificate is always the **CA associated with the DMS**, not the DMS. The DMS coordinates the process: it receives the CSR, authenticates the device and applies the issuance policy. This distinction matters for the PKI administrator when selecting the `EnrollmentCA` and for the integrator when interpreting the chain of trust received from `/cacerts`.",{"_2886":1653,"_27469":1623,"_18854":48116,"_5":12679,"_25963":48017,"_2424":45823},[],{"_2886":1654,"_27469":1623,"_18854":48118,"_5":12679,"_25963":48017,"_2424":48119},[],"DMS configuration, for the PKI administrator.",{"_2886":1655,"_27469":1623,"_18854":48121,"_5":12679,"_25963":48017,"_2424":48122},[],"Device integration, for anyone consuming the EST endpoints from firmware, scripts or provisioning services.",{"_2886":1656,"_27469":1623,"_18854":48124,"_5":12679,"_25963":48017,"_2424":48125},[],"If you only need a quick orientation, this is the recommended route:",{"_2886":1657,"_27469":1623,"_18854":48127,"_5":12679,"_25963":48017,"_2424":48128},[],"**PKI administrator:** start with DMS configuration and finish with Diagnostics and compatibility.",{"_2886":1658,"_27469":1623,"_18854":48130,"_5":12679,"_25963":48017,"_2424":48131},[],"**Device integrator:** start with Before you begin and continue with `/cacerts`, `/simpleenroll`, `/simplereenroll` or `/serverkeygen`, depending on the flow you will implement.",{"_2886":1659,"_27469":1623,"_18854":48133,"_5":12679,"_25963":48024,"_2424":48134},[],"Before configuring a DMS for EST, the following resources must exist on the platform:",{"_2886":1660,"_27469":1623,"_18854":48136,"_5":12679,"_25963":48024,"_2424":48137},[],"**An available CA**: the CA acting as `EnrollmentCA` must be created and active in Lamassu. If the authentication mode is `CLIENT_CERTIFICATE`, the validation CAs for the bootstrap certificate must also have been created.",{"_2886":1661,"_27469":1623,"_18854":48139,"_5":12679,"_25963":48024,"_2424":48140},[],"**A created DMS**: the DMS this configuration applies to must already exist. The EST configuration is applied over an existing DMS, it does not create one.",{"_2886":1662,"_27469":1623,"_18854":48142,"_5":12679,"_25963":48024,"_2424":48143},[],"It is worth separating four configuration blocks:",{"_2886":1663,"_27469":1623,"_18854":48145,"_5":12679,"_25963":48024,"_2424":48146},[],"How the initial enrollment will be performed, including the registration mode and client authentication.",{"_2886":1664,"_27469":1623,"_18854":48148,"_5":12679,"_25963":48024,"_2424":48149},[],"How the re-enrollment of already-issued certificates will be handled.",{"_2886":1665,"_27469":1623,"_18854":48151,"_5":12679,"_25963":48024,"_2424":48152},[],"How the cacerts endpoint will be configured to distribute the CAs devices use as trust anchors.",{"_2886":1666,"_27469":1623,"_18854":48154,"_5":12679,"_25963":48024,"_2424":48155},[],"Whether server-side key generation through `ServerKeyGen` will be enabled.",{"_2886":1667,"_27469":1623,"_18854":48157,"_5":12679,"_25963":48031,"_2424":48158},[],"This section defines how new devices are registered and with which credentials they authenticate.",{"_2886":1668,"_27469":1623,"_18854":48160,"_5":12679,"_25963":48031,"_2424":48161},[],"**Registration Mode**: determines the behavior when receiving an initial enrollment. In `JITP` (*Just-In-Time Provisioning*) mode, the device is created automatically the first time it presents itself, applying the tags, metadata and icon defined in the provisioning profile. In `PRE_REGISTRATION` mode, the device must already exist on the platform; if it does not, the request is rejected with `device not preregistered`. JITP mode suits large fleets where the inventory is built during deployment; `PRE_REGISTRATION` fits high-security environments where each device is explicitly approved before receiving a certificate.",{"_2886":1669,"_27469":1623,"_18854":48163,"_5":12679,"_25963":48031,"_2424":48164},[],"**Tags**: applied to each device automatically created by this DMS. They are optional and only take effect in JITP mode. Tags improve device search.",{"_2886":1670,"_27469":1623,"_18854":48166,"_5":12679,"_25963":48031,"_2424":48167},[],"**Icon**: applied to each device automatically created by this DMS. It is optional and only takes effect in JITP mode. Purely visual.",{"_2886":1671,"_27469":1623,"_18854":48169,"_5":12679,"_25963":48035,"_2424":48170},[],"**Enrollment CA**: identifies the CA that will sign the identity certificates issued through this DMS. Its choice determines the chain of trust the device will receive and the root against which backend systems will validate fleet certificates.",{"_2886":1672,"_27469":1623,"_18854":48172,"_5":12679,"_25963":48035,"_2424":48173},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): allows an already-enrolled device to enroll again through `/simpleenroll`. When active, the previous certificate is revoked with the reason `superseded` and the identity slot is updated. When inactive, a second `simpleenroll` attempt is rejected with `forbiddenNewEnrollment`. This option must be enabled with care in production environments, since it lets you replace a device's identity without going through the re-enrollment flow.",{"_2886":1673,"_27469":1623,"_18854":48175,"_5":12679,"_25963":48035,"_2424":48176},[],"**Verify CSR Signature** (`verify_csr_signature`): controls whether the server validates the CSR signature against the public key declared in it (PKCS#10 proof of possession). When inactive, a requester could submit a CSR with a public key it does not control and obtain a certificate bound to it. For IoT fleets on open networks it must be enabled.",{"_2886":1674,"_27469":1623,"_18854":48178,"_5":12679,"_25963":48035,"_2424":48179},[],"**Authentication Mode**: defines how the DMS validates the device identity during enrollment. It can require an mTLS certificate (`CLIENT_CERTIFICATE`), delegate authorization to a webhook (`EXTERNAL_WEBHOOK`), combine both controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) or accept unauthenticated requests (`NO_AUTH`). The latter must be limited to isolated labs or provisioning networks.",{"_2886":1675,"_27469":1623,"_18854":48181,"_5":12679,"_25963":48035,"_2424":48182},[],"When the mode is `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, these parameters are also configured:",{"_2886":1676,"_27469":1623,"_18854":48184,"_5":12679,"_25963":48035,"_2424":48185},[],"**Validation CAs**: list of trusted CAs to validate the bootstrap certificate presented by the device.",{"_2886":1677,"_27469":1623,"_18854":48187,"_5":12679,"_25963":48035,"_2424":48188},[],"**Chain Validation Level**: maximum depth of the validation chain. The value `-1` validates the full chain up to the root CA.",{"_2886":1678,"_27469":1623,"_18854":48190,"_5":12679,"_25963":48035,"_2424":48191},[],"**Allow Authenticating Expired Certificates**: if active, accepts expired client certificates. Useful in recovery scenarios where the device could not renew its certificate in time.",{"_2886":1679,"_27469":1623,"_18854":48193,"_5":12679,"_25963":48035,"_2424":48194},[],"When the mode includes `EXTERNAL_WEBHOOK`, these parameters are also configured:",{"_2886":1680,"_27469":1623,"_18854":48196,"_5":12679,"_25963":48035,"_2424":48197},[],"**Webhook URL**: address of the external service that will decide authorization.",{"_2886":1681,"_27469":1623,"_18854":48199,"_5":12679,"_25963":48035,"_2424":48200},[],"**HTTP Method**: HTTP method used to invoke the webhook. Supports `POST` (default) or `PUT`; both are equivalent for the webhook, only the verb Lamassu uses changes.",{"_2886":1682,"_27469":1623,"_18854":48202,"_5":12679,"_25963":48035,"_2424":48203},[],"**Timeout**: maximum wait time for the webhook call. If not specified, the default is **10 seconds**; after that without a response, Lamassu denies the operation.",{"_2886":1683,"_27469":1623,"_18854":48205,"_5":12679,"_25963":48035,"_2424":48206},[],"**Webhook Authentication Mode**: authentication mode of the webhook toward the external service, for example `ApiKey`, `OIDC` or `mTLS`.",{"_2886":1684,"_27469":1623,"_18854":48208,"_5":12679,"_25963":48035,"_2424":48209},[],"The exact contract the webhook service must implement (request and response schema, examples) is published as an OpenAPI specification: authorization webhook reference.",{"_2886":1685,"_27469":1623,"_18854":48211,"_5":12679,"_25963":48039,"_2424":48212},[],"The behavior of the issued certificate is not determined solely by the device's CSR, but by the **issuance profile** (`IssuanceProfile`) associated with the DMS. The integrator does not configure this profile, but its rules affect the content of the final certificate:",{"_2886":1686,"_27469":1623,"_18854":48214,"_5":12679,"_25963":48039,"_2424":48215},[],"**`HonorSubject`** controls whether the CSR's subject is copied verbatim into the certificate. If disabled, the CA applies the profile's template and ignores the received subject.",{"_2886":1687,"_27469":1623,"_18854":48217,"_5":12679,"_25963":48039,"_2424":48218},[],"**`HonorKeyUsage`** decides whether the CSR's `KeyUsage` is respected or replaced by the one defined in the template.",{"_2886":1688,"_27469":1623,"_18854":48220,"_5":12679,"_25963":48039,"_2424":48221},[],"**`HonorExtendedKeyUsages`** applies the same rule to `ExtKeyUsage`.",{"_2886":1689,"_27469":1623,"_18854":48223,"_5":12679,"_25963":48039,"_2424":48224},[],"**`HonorExtensions`** controls whether the rest of the CSR's extensions, such as SAN or CDP, are included in the certificate.",{"_2886":1690,"_27469":1623,"_18854":48226,"_5":12679,"_25963":48039,"_2424":48227},[],"This matters for the integrator: the `KeyUsage`, `ExtKeyUsage` and SANs declared in the CSR may not appear as-is in the final certificate if the profile decides otherwise. Check with the PKI administrator if the issued certificate does not contain the expected extensions.",{"_2886":1691,"_27469":1623,"_18854":48229,"_5":12679,"_25963":48043,"_2424":48230},[],"The **Re-Enrollment Settings** section controls the certificate renewal process. Re-enrollment can only be performed while the certificate is within the configured window, and optionally also when the certificate has already expired.",{"_2886":1692,"_27469":1623,"_18854":48232,"_5":12679,"_25963":48043,"_2424":48233},[],"**Revoke On Re-Enroll**: if active, the previous certificate is automatically revoked with the reason `superseded` once the new one is issued.",{"_2886":1693,"_27469":1623,"_18854":48235,"_5":12679,"_25963":48043,"_2424":48236},[],"**Allow Expired Renewal**: allows renewing an already-expired certificate. Useful when a device has been offline and could not renew within the window.",{"_2886":1694,"_27469":1623,"_18854":48238,"_5":12679,"_25963":48043,"_2424":48239},[],"**Allowed Renewal Delta**: time window before expiration during which re-enrollment is allowed. Before this window opens, the request is rejected with `invalid reenroll window`.",{"_2886":1695,"_27469":1623,"_18854":48241,"_5":12679,"_25963":48043,"_2424":48242},[],"**Preventive Renewal Delta**: time before expiration from which preventive renewal alerts are raised.",{"_2886":1696,"_27469":1623,"_18854":48244,"_5":12679,"_25963":48043,"_2424":48245},[],"**Critical Renewal Delta**: threshold closest to expiration that triggers critical status alerts.",{"_2886":1697,"_27469":1623,"_18854":48247,"_5":12679,"_25963":48043,"_2424":48248},[],"**Additional Validation CAs**: additional CAs accepted as issuers of the active certificate during re-enrollment. It allows migrating to a new enrollment CA without interrupting the renewal of devices already enrolled with the previous CA.",{"_2886":1698,"_27469":1623,"_18854":48250,"_5":12679,"_25963":48046,"_2424":48251},[],"The **Server Key Generation** section lets Lamassu generate the device's key pair on the server and return it together with the issued certificate. It is useful for devices with limited cryptographic capability.",{"_2886":1699,"_27469":1623,"_18854":48253,"_5":12679,"_25963":48046,"_2424":48254},[],"The **Enable Server-Side Key Generation** option activates the `/serverkeygen` endpoint. When inactive, any call to that endpoint is rejected with `server key generation not enabled`.",{"_2886":1700,"_27469":1623,"_18854":48256,"_5":12679,"_25963":48046,"_2424":48257},[],"**Key Type** selects the algorithm: `RSA` or `ECDSA`. The &#x2A;*Key Size (bits)** field determines the key size. For ECDSA, the size in bits also determines the curve: 256 corresponds to P-256, 384 to P-384 and 521 to P-521.",{"_2886":1701,"_27469":1623,"_18854":48259,"_5":12679,"_25963":48046,"_2424":48260},[],"The key is generated in the server's software engine, not in a hardware Crypto Engine such as AWS KMS or PKCS#11. The only protection of the key in transit is the TLS channel; no additional encryption (CMS EnvelopedData) is applied to the key before sending it to the device. See the `/serverkeygen` section of the integrator reference for the exact response format and security considerations.",{"_2886":1702,"_27469":1623,"_18854":48262,"_5":12679,"_25963":48050,"_2424":48263},[],"Once the enrollment, re-enrollment and ServerKeyGen settings are applied, you can confirm the DMS is operational as follows:",{"_2886":1703,"_27469":1623,"_18854":48265,"_5":12679,"_25963":48050,"_2424":48266},[],"**From the console**: open the DMS detail and check that the EST section shows the assigned enrollment CA and the configured authentication mode.",{"_2886":1704,"_27469":1623,"_18854":48268,"_5":12679,"_25963":48050,"_2424":48269},[],"**With a test request**: invoke the DMS's `/cacerts` endpoint from a `curl` client with server trust. A `200 OK` response with base64 content confirms the DMS is active and the enrollment CA is reachable.",{"_2886":1705,"_27469":1623,"_18854":48271,"_5":12679,"_25963":48050,"_2424":48272},[],"If the DMS does not exist or the CA is not available, the server responds with `DMS not found` or another error message. See the Diagnostics and compatibility section to interpret error messages.",{"_2886":1706,"_27469":1623,"_18854":48274,"_5":12679,"_25963":48053,"_2424":48275},[],"*This section is aimed at device integrators.*",{"_2886":1707,"_27469":1623,"_18854":48277,"_5":12679,"_25963":48053,"_2424":48278},[],"Lamassu's EST endpoints are published under the `/.well-known/est` prefix and always require the presence of the `{aps}` path segment, interpreted as the identifier of the DMS the operation targets. The association is direct: the `{aps}` value received in the URL is used as the DMS ID when querying the internal store. Variants registered without `{aps}` (for example `/.well-known/est/cacerts`) are routed in the code, but their handler requires the `APS` field and returns `400 Bad Request` with the message `Field validation for 'APS' failed` when the segment is not provided.",{"_2886":1708,"_27469":1623,"_18854":48280,"_5":12679,"_25963":48053,"_2424":48281},[],"This part follows the integrator's usual working order: first the prerequisites and the authentication model, then the reference for each endpoint and, finally, complete examples and diagnostic material.",{"_2886":1709,"_27469":1623,"_18854":48283,"_5":12679,"_25963":48056,"_2424":48284},[],"The PKI administrator must have configured a DMS with the `EST_RFC7030` protocol, an assigned enrollment CA and at least one authentication mode. Without that prior configuration, Lamassu rejects any enrollment request. The details of that configuration are in the DMS configuration section of this same page.",{"_2886":1710,"_27469":1623,"_18854":48286,"_5":12679,"_25963":48056,"_2424":48287},[],"Before making the first call, make sure you have:",{"_2886":1711,"_27469":1623,"_18854":48289,"_5":12679,"_25963":48056,"_2424":48290},[],"**The EST host URL**, for example `https://est.lamassu.example`, provided by the PKI administrator.",{"_2886":1712,"_27469":1623,"_18854":48292,"_5":12679,"_25963":48056,"_2424":48293},[],"**The server trust anchor** (`lamassu-trust.pem`), root or intermediate, with which the client will validate Lamassu's TLS.",{"_2886":1713,"_27469":1623,"_18854":48295,"_5":12679,"_25963":48056,"_2424":48296},[],"**The bootstrap certificate and its private key** if the DMS uses `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. This identity must come from one of the configured `ValidationCAs`, usually a provisioning CA different from the enrollment CA.",{"_2886":1714,"_27469":1623,"_18854":48298,"_5":12679,"_25963":48056,"_2424":48299},[],"**The DMS ID** (`{aps}`), which must appear in every EST route.",{"_2886":1715,"_27469":1623,"_18854":48301,"_5":12679,"_25963":48059,"_2424":48302},[],"**Download trust with `/cacerts`:** the client validates the server's TLS and receives the certificates in PKCS#7 or PEM.",{"_2886":1716,"_27469":1623,"_18854":48304,"_5":12679,"_25963":48059,"_2424":48305},[],"**Perform initial enrollment with `/simpleenroll`:** present the bootstrap certificate or the credential defined by `AuthMode` to obtain the device certificate.",{"_2886":1717,"_27469":1623,"_18854":48307,"_5":12679,"_25963":48059,"_2424":48308},[],"**Renew with `/simplereenroll`:** authenticate with the device's current certificate to obtain a new one.",{"_2886":1718,"_27469":1623,"_18854":48310,"_5":12679,"_25963":48059,"_2424":48311},[],"**Use `/serverkeygen` only if you need server-side key generation:** it applies the same authentication as `/simpleenroll` and returns the PKCS#8 private key together with the certificate.",{"_2886":1719,"_27469":1623,"_18854":48313,"_5":12679,"_25963":48063,"_2424":48314},[],"Lamassu's implementation recognizes four authentication configurations for `/simpleenroll`, expressed through the DMS's `EnrollmentOptionsESTRFC7030.AuthMode` field. Three are simple modes (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) and one combines two controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). The client must present itself in the mode the DMS expects; any other combination fails the enrollment.",{"_2886":1720,"_27469":1623,"_18854":48316,"_5":12679,"_25963":48063,"_2424":48317},[],"Mode (`AuthMode`)",{"_2886":1721,"_27469":1623,"_18854":48319,"_5":12679,"_25963":48063,"_2424":45907},[],{"_2886":1722,"_27469":1623,"_18854":48321,"_5":12679,"_25963":48063,"_2424":48322},[],"Expected credential",{"_2886":1723,"_27469":1623,"_18854":48324,"_5":12679,"_25963":48063,"_2424":48325},[],"Applies in enroll",{"_2886":1724,"_27469":1623,"_18854":48327,"_5":12679,"_25963":48063,"_2424":48328},[],"Applies in reenroll",{"_2886":1725,"_27469":1623,"_18854":48330,"_5":12679,"_25963":48063,"_2424":45948},[],{"_2886":1726,"_27469":1623,"_18854":48332,"_5":12679,"_25963":48063,"_2424":48333},[],"mTLS with X.509 certificate",{"_2886":1727,"_27469":1623,"_18854":48335,"_5":12679,"_25963":48063,"_2424":48336},[],"Client certificate and private key",{"_2886":1728,"_27469":1623,"_18854":48338,"_5":12679,"_25963":48063,"_2424":46785},[],{"_2886":1729,"_27469":1623,"_18854":48340,"_5":12679,"_25963":48063,"_2424":48341},[],"Yes (with the active certificate)",{"_2886":1730,"_27469":1623,"_18854":48343,"_5":12679,"_25963":48063,"_2424":45954},[],{"_2886":1731,"_27469":1623,"_18854":48345,"_5":12679,"_25963":48063,"_2424":48346},[],"mTLS plus webhook validation",{"_2886":1732,"_27469":1623,"_18854":48348,"_5":12679,"_25963":48063,"_2424":48349},[],"Client certificate and private key, plus webhook approval",{"_2886":1733,"_27469":1623,"_18854":48351,"_5":12679,"_25963":48063,"_2424":46785},[],{"_2886":1734,"_27469":1623,"_18854":48353,"_5":12679,"_25963":48063,"_2424":48354},[],"Not as a combination; in reenroll both controls are not kept",{"_2886":1735,"_27469":1623,"_18854":48356,"_5":12679,"_25963":48063,"_2424":45960},[],{"_2886":1736,"_27469":1623,"_18854":48358,"_5":12679,"_25963":48063,"_2424":48359},[],"External authorization webhook",{"_2886":1737,"_27469":1623,"_18854":48361,"_5":12679,"_25963":48063,"_2424":48362},[],"None on the TLS channel",{"_2886":1738,"_27469":1623,"_18854":48364,"_5":12679,"_25963":48063,"_2424":46785},[],{"_2886":1739,"_27469":1623,"_18854":48366,"_5":12679,"_25963":48063,"_2424":48367},[],"No, degrades to `NO_AUTH`",{"_2886":1740,"_27469":1623,"_18854":48369,"_5":12679,"_25963":48063,"_2424":45966},[],{"_2886":1741,"_27469":1623,"_18854":48371,"_5":12679,"_25963":48063,"_2424":48372},[],"No authentication",{"_2886":1742,"_27469":1623,"_18854":48374,"_5":12679,"_25963":48063,"_2424":48375},[],"None",{"_2886":1743,"_27469":1623,"_18854":48377,"_5":12679,"_25963":48063,"_2424":48378},[],"Yes (restricted use)",{"_2886":1744,"_27469":1623,"_18854":48380,"_5":12679,"_25963":48063,"_2424":48378},[],{"_2886":1745,"_27469":1623,"_18854":48382,"_5":12679,"_25963":48063,"_2424":48383},[],"JWT **is not a valid authentication mode in EST**. The JWT identity extractor exists in the code but is only evaluated in Lamassu's administration API. Any *Bearer token* sent to `/.well-known/est/...` is silently ignored. When the DMS is configured with `AuthMode: CLIENT_CERTIFICATE`, a request carrying only a JWT is rejected for lack of a client certificate. When the DMS is in `AuthMode: NO_AUTH`, the request is processed as such and the JWT neither adds nor removes authorization.",{"_2886":1746,"_27469":1623,"_18854":48385,"_5":12679,"_25963":48063,"_2424":48386},[],"**`CLIENT_CERTIFICATE`**: the client presents an X.509 certificate issued by one of the CAs declared in `AuthOptionsMTLS.ValidationCAs`. The process validates the certificate chain against those CAs through the `ValidationCAs`, `AllowExpired` and `ChainLevelValidation` parameters. In addition, the service checks the revocation status in three steps: first it looks up the cert in Lamassu's local database; if not found, it queries the OCSP responders listed in the AIA extension; if OCSP fails, it tries the CRL Distribution Points (CDP). A revoked certificate interrupts the enrollment with `certificate is revoked`.",{"_2886":1747,"_27469":1623,"_18854":48388,"_5":12679,"_25963":48063,"_2424":48389},[],"Its main parameters are `ValidationCAs`, the list of CAs that can validate the bootstrap certificate or the active certificate; `AllowExpired`, which allows accepting expired client certificates; and `ChainLevelValidation`, which limits the chain depth when its value is greater than zero.",{"_2886":1748,"_27469":1623,"_18854":48391,"_5":12679,"_25963":48063,"_2424":48392},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delegates the authorization decision to an external HTTP service. The EST server builds a `POST` request to the configured webhook with a JSON body reproducing the enrollment context.",{"_2886":1749,"_27469":1623,"_18854":48394,"_5":12679,"_25963":48063,"_2424":48395},[],"The value of the `csr` field is the **base64 encoding of the CSR's PEM** (not the DER, and not the plain PEM). The webhook must respond with `2xx` and a JSON body `{\"authorized\": true}` to continue; any other response aborts the enrollment with `external webhook denied enrollment`. A `204 No Content` **is not a valid response** even though it is a `2xx` code: Lamassu requires a JSON body with the `authorized` field, so a webhook responding without a body denies the operation just like an error.",{"_2886":1750,"_27469":1623,"_18854":48397,"_5":12679,"_25963":48063,"_2424":48398},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combines the two previous modes during `/simpleenroll`. The client must present a valid mTLS certificate and the webhook must return `authorized: true`. In `/simplereenroll` the combination is not preserved: the joint mTLS + webhook check is not maintained, so the integrator must not assume the same guarantees of the initial enrollment apply in reenroll.",{"_2886":1751,"_27469":1623,"_18854":48400,"_5":12679,"_25963":48063,"_2424":48401},[],"**`NO_AUTH`**: the DMS accepts any CSR without validating the client's identity. Lamassu logs a warning (`DMS is configured with NoAuth, allowing enrollment`) and proceeds with the registration. It must be restricted to controlled environments (an isolated provisioning network); any network exposed to the internet with a DMS in `NO_AUTH` is open to certificate issuance by unauthorized third parties.",{"_2886":1752,"_27469":1623,"_18854":48403,"_5":12679,"_25963":48067,"_2424":48404},[],"The following sections describe the endpoints in the usual order of use within the device lifecycle:",{"_2886":1753,"_27469":1623,"_18854":48406,"_5":12679,"_25963":48067,"_2424":48407},[],"`/cacerts`: download of the trust chain.",{"_2886":1754,"_27469":1623,"_18854":48409,"_5":12679,"_25963":48067,"_2424":48410},[],"`/simpleenroll`: initial certificate enrollment.",{"_2886":1755,"_27469":1623,"_18854":48412,"_5":12679,"_25963":48067,"_2424":48413},[],"`/simplereenroll`: renewal of an already-issued certificate.",{"_2886":1756,"_27469":1623,"_18854":48415,"_5":12679,"_25963":48067,"_2424":48416},[],"`/serverkeygen`: enrollment with server-side key generation.",{"_2886":1757,"_27469":1623,"_18854":48418,"_5":12679,"_25963":48071,"_2424":48419},[],"The endpoint `GET /.well-known/est/{aps}/cacerts` distributes the certificates the device needs to validate the EST server and the rest of the CAs managed by the DMS. Lamassu inserts the certificates in this order: first the **downstream** certificate of the Lamassu server, which is the server's TLS leaf and not a CA, useful for pinning if `IncludeLamassuSystemCA` is enabled; then the `ManagedCAs` list declared in the DMS; and last the enrollment CA, if `IncludeEnrollmentCA` is enabled.",{"_2886":1758,"_27469":1623,"_18854":48421,"_5":12679,"_25963":48071,"_2424":48422},[],"`CADistributionSettings` lets you decide what is published:",{"_2886":1759,"_27469":1623,"_18854":48424,"_5":12679,"_25963":48071,"_2424":48425},[],"**`IncludeLamassuSystemCA`** adds the *downstream* certificate of the Lamassu server. It is the TLS leaf the client can use to pin the connection, not a CA.",{"_2886":1760,"_27469":1623,"_18854":48427,"_5":12679,"_25963":48071,"_2424":48428},[],"**`IncludeEnrollmentCA`** adds the DMS's issuing CA, responsible for signing device certificates.",{"_2886":1761,"_27469":1623,"_18854":48430,"_5":12679,"_25963":48071,"_2424":48431},[],"**`ManagedCAs`** publishes additional CAs as trust anchors.",{"_2886":1762,"_27469":1623,"_18854":48433,"_5":12679,"_25963":48071,"_2424":48434},[],"The default format is *degenerate* PKCS#7 (certificates only) base64-encoded. The response declares `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The base64 is wrapped in lines of **76 characters** terminated with CRLF, a width compliant with S/MIME (RFC 5751), not the 64 that some RFC 7030 guides suggest. This wrapping applies only to `/cacerts` and `/simpleenroll`; the internal parts of `/serverkeygen` carry no wrap, as explained below.",{"_2886":1763,"_27469":1623,"_18854":48436,"_5":12679,"_25963":48071,"_2424":48437},[],"*Degenerate* PKCS#7 is a **set** of certificates with no defined semantic order. Although Lamassu inserts them in the order stated, the integrator must not assume that order when validating chains: the chain must be built by `Subject`/`Issuer` matching (or by AKI/SKI), not by position in the response.",{"_2886":1764,"_27469":1623,"_18854":48439,"_5":12679,"_25963":48071,"_2424":48440},[],"The `-i` flag (ignore garbage) helps tolerate the CRLF Lamassu adds and is necessary on some `base64` implementations (BusyBox, BSD); on GNU coreutils it is ignored.",{"_2886":1765,"_27469":1623,"_18854":48442,"_5":12679,"_25963":48071,"_2424":48443},[],"Lamassu additionally adds an extension over the RFC: if the client sends the `Accept: application/x-pem-file` header, the server responds with the PEM concatenation of the same certificates, without the PKCS#7 wrapper. This makes consumption from scripts easier. The extension also works on `/simpleenroll` and `/simplereenroll`.",{"_2886":1766,"_27469":1623,"_18854":48445,"_5":12679,"_25963":48075,"_2424":48446},[],"The endpoint `POST /.well-known/est/{aps}/simpleenroll` receives a CSR and returns the issued certificate. The request body must be the **PKCS#10 (CSR) in DER, base64-encoded** without line breaks. The base64 wraps the DER directly, not a PEM. The `Content-Type` header must be `application/pkcs10`. If the `Content-Type` is different, the server responds `400` with `content-type must be application/pkcs10`; if the body is not valid base64, it responds `400` with `body payload must be base64 encoded`.",{"_2886":1767,"_27469":1623,"_18854":48448,"_5":12679,"_25963":48075,"_2424":48449},[],"The response follows the same wrapper as `/cacerts`: *degenerate* PKCS#7 in base64, with `Content-Type: application/pkcs7-mime; smime-type=certs-only`. The PKCS#7 contains **only the newly issued leaf certificate**; it does not include the issuing CA or intermediates. This complies with RFC 7030 §4.2.3 (where the chain is optional) but implies the integrator must combine this certificate with the chain obtained from `/cacerts` before presenting it to any relying party that validates the full chain (for example, an MQTT broker with strict mTLS).",{"_2886":1768,"_27469":1623,"_18854":48451,"_5":12679,"_25963":48075,"_2424":48452},[],"Several DMS fields govern the behavior of `/simpleenroll`. The integrator does not configure them, but it helps to know them to interpret rejections:",{"_2886":1769,"_27469":1623,"_18854":48454,"_5":12679,"_25963":48075,"_2424":48455},[],"**`EnrollmentSettings.RegistrationMode`** decides whether the device is created during the first enrollment (`JITP`) or must exist beforehand (`PRE_REGISTRATION`).",{"_2886":1770,"_27469":1623,"_18854":48457,"_5":12679,"_25963":48075,"_2424":48458},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** allows repeating `/simpleenroll` for an already-enrolled device. When doing so, it revokes the previous certificate as `superseded`; if disabled, the server responds with `forbiddenNewEnrollment`.",{"_2886":1771,"_27469":1623,"_18854":48460,"_5":12679,"_25963":48075,"_2424":48461},[],"**`EnrollmentSettings.VerifyCSRSignature`** validates that whoever submits the CSR controls the declared private key. For IoT fleets on open networks it must be enabled.",{"_2886":1772,"_27469":1623,"_18854":48463,"_5":12679,"_25963":48075,"_2424":48464},[],"In `JITP` mode, the first `simpleenroll` with a `CommonName` that does not yet exist in Lamassu creates the device automatically. In `PRE_REGISTRATION` mode, the device must exist beforehand; an unknown `CommonName` is rejected with `device not preregistered`. See Enrollment configuration for more details on both modes and the behavior of the issuance profile.",{"_2886":1773,"_27469":1623,"_18854":48466,"_5":12679,"_25963":48079,"_2424":48467},[],"The endpoint `POST /.well-known/est/{aps}/simplereenroll` renews the certificate of an already-enrolled device. The body format is identical to `/simpleenroll` (DER base64 without line breaks, `Content-Type: application/pkcs10`). The difference lies in authentication: the client must present **the device's active certificate** (not the bootstrap) as the mTLS credential.",{"_2886":1774,"_27469":1623,"_18854":48469,"_5":12679,"_25963":48079,"_2424":48470},[],"If the DMS is configured with `AuthMode: EXTERNAL_WEBHOOK`, the webhook is **not invoked** during `/simplereenroll`. The renewal flow silently degrades to `NO_AUTH`: any client that knows a valid `CommonName` can request reenroll for that device without authentication (`allowing reenroll: using NO AUTH mode` in the log). A DMS with `EXTERNAL_WEBHOOK` must not be used in production for reenroll flows unless access to the endpoint is network-controlled.",{"_2886":1775,"_27469":1623,"_18854":48472,"_5":12679,"_25963":48079,"_2424":48473},[],"The behavior of reenroll is governed by several `ReEnrollmentSettings` fields:",{"_2886":1776,"_27469":1623,"_18854":48475,"_5":12679,"_25963":48079,"_2424":48476},[],"**`ReEnrollmentDelta`** opens the renewal window at `NotAfter - ReEnrollmentDelta`. Before that instant, the server responds with `invalid reenroll window`.",{"_2886":1777,"_27469":1623,"_18854":48478,"_5":12679,"_25963":48079,"_2424":48479},[],"**`EnableExpiredRenewal`** allows using an already-expired certificate as proof of identity; if disabled, the server responds with `expired certificate`.",{"_2886":1778,"_27469":1623,"_18854":48481,"_5":12679,"_25963":48079,"_2424":48482},[],"**`RevokeOnReEnrollment`** revokes the previous certificate as `superseded` after issuing the new one.",{"_2886":1779,"_27469":1623,"_18854":48484,"_5":12679,"_25963":48079,"_2424":48485},[],"**`AdditionalValidationCAs`** adds valid issuers for the current certificate, in addition to the DMS's enrollment CA.",{"_2886":1780,"_27469":1623,"_18854":48487,"_5":12679,"_25963":48079,"_2424":48488},[],"**Subject immutability**: the renewal CSR must have exactly the same subject as the active certificate. Lamassu compares, byte by byte, the `RawSubject` of the CSR with the certificate's (`slices.Compare`). If the bytes differ, the server falls back to a semantic comparison over the `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` and `Country` attributes. If all those attributes match, the reenroll continues despite the byte difference (rescuing cases where only the encoding changes, `PrintableString` versus `UTF8String`). If any attribute differs, the reenroll aborts with `invalid RawSubject bytes`. The integrator must regenerate the CSR with exactly the same subject as in the initial enrollment to avoid depending on fallback behavior.",{"_2886":1781,"_27469":1623,"_18854":48490,"_5":12679,"_25963":48079,"_2424":48491},[],"**Validation of the presented certificate's chain**: validation is first attempted against the DMS's enrollment CA; if it fails, it walks the `AdditionalValidationCAs`. Validation is \"shallow\": each CA is tested as an anchor, no multi-level chain is composed. The client must present the complete chain in the mTLS handshake. A revoked certificate aborts the reenroll with `certificate is revoked`.",{"_2886":1782,"_27469":1623,"_18854":48493,"_5":12679,"_25963":48083,"_2424":48494},[],"The endpoint `POST /.well-known/est/{aps}/serverkeygen` lets Lamassu generate the device's key pair on the server and return, in the same response, the private key and the issued certificate. It is useful for devices with limited cryptographic capability or flows where the key is provisioned during manufacturing.",{"_2886":1783,"_27469":1623,"_18854":48496,"_5":12679,"_25963":48083,"_2424":48497},[],"This endpoint requires `ServerKeyGen.Enabled` to be `true` in the DMS. If it is not enabled, the server responds with `server key generation not enabled`. Authentication applies the same way as in `/simpleenroll`: the integrator presents the credential matching the DMS's `AuthMode`.",{"_2886":1784,"_27469":1623,"_18854":48499,"_5":12679,"_25963":48083,"_2424":48500},[],"The algorithm and size of the generated key are decided by the DMS, not by the client.",{"_2886":1785,"_27469":1623,"_18854":48502,"_5":12679,"_25963":48083,"_2424":48503},[],"**RSA** supports any size accepted by `crypto/rsa`; common values are 2048, 3072 and 4096 bits. An invalid value fails generation with a `500` error.",{"_2886":1786,"_27469":1623,"_18854":48505,"_5":12679,"_25963":48083,"_2424":48506},[],"**ECDSA** supports 224, 256, 384 and 521 bits, equivalent to P-224, P-256 (`prime256v1`), P-384 and P-521. Any other value **silently** degrades to P-256 and only leaves a warning in the log: the client receives no error and may obtain a curve different from the expected one.",{"_2886":1787,"_27469":1623,"_18854":48508,"_5":12679,"_25963":48083,"_2424":48509},[],"The CSR sent by the client serves only to carry the subject and extensions; the PKCS#10 proof of possession does not apply here because the client is not the one who generated the key. Lamassu discards the original CSR's public key, generates a new key pair with its internal entropy, in a software engine and not in a hardware Crypto Engine such as AWS KMS or PKCS#11, builds a new CSR with that key and proceeds with an internal enrollment equivalent to `/simpleenroll`.",{"_2886":1788,"_27469":1623,"_18854":48511,"_5":12679,"_25963":48083,"_2424":48512},[],"The response is a `multipart/mixed` with the literal boundary `estServerLamassuBoundary`. It contains two parts:",{"_2886":1789,"_27469":1623,"_18854":48514,"_5":12679,"_25963":48083,"_2424":48515},[],"The private key in **unencrypted PKCS#8** format, base64-encoded inside a part with `Content-Type: application/pkcs8`.",{"_2886":1790,"_27469":1623,"_18854":48517,"_5":12679,"_25963":48083,"_2424":48518},[],"The issued certificate in *degenerate* PKCS#7 base64, inside a part with `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_2886":1791,"_27469":1623,"_18854":48520,"_5":12679,"_25963":48083,"_2424":48521},[],"Unlike `/cacerts` and `/simpleenroll`, where the base64 is wrapped in 76-character lines, each part of `/serverkeygen` travels as **a single base64 line without breaks**. Any reverse proxy that rewrites the body (for example, normalizing line endings) can break the parsing.",{"_2886":1792,"_27469":1623,"_18854":48523,"_5":12679,"_25963":48083,"_2424":48524},[],"This endpoint reverses the PKI principle whereby the subscriber controls its own private key. The key is serialized as unencrypted PKCS#8 (`PrivateKeyInfo`, without `EncryptedPrivateKeyInfo`). The CMS `EnvelopedData` wrapper contemplated in RFC 7030 §4.4.2 is not applied; no AES key wrap or password-based symmetric encryption is used. The only protection is the channel's TLS. The integrator must guarantee that: (a) no reverse proxy terminates TLS and logs the response body; (b) the key is encrypted at rest immediately after receipt; (c) the audit account on the Lamassu server remains the single point of origin of the key.",{"_2886":1793,"_27469":1623,"_18854":48526,"_5":12679,"_25963":48083,"_2424":48527},[],"To separate the two parts, the following snippet uses `awk` with the literal boundary. It works with Lamassu's exact structure (each part = headers + blank line + a single base64 line); any intermediate proxy rewriting the body will break it.",{"_2886":1794,"_27469":1623,"_18854":48529,"_5":12679,"_25963":48087,"_2424":48530},[],"Once the endpoints have been reviewed individually, these examples show how to chain them in two common scenarios: the initial enrollment of a device and the renewal of an already-issued certificate.",{"_2886":1795,"_27469":1623,"_18854":48532,"_5":12679,"_25963":48091,"_2424":48533},[],"The following script illustrates the complete process of enrolling a device with a locally generated EC P-256 key and mTLS authentication against a bootstrap certificate.",{"_2886":1796,"_27469":1623,"_18854":48535,"_5":12679,"_25963":48095,"_2424":48536},[],"The following script reproduces a renewal process: it detects the expiration of the current certificate, regenerates the CSR with the **same subject** and authenticates with the active certificate.",{"_2886":1797,"_27469":1623,"_18854":48538,"_5":12679,"_25963":48099,"_2424":48539},[],"Once the device has obtained its identity certificate, the usual steps are:",{"_2886":1798,"_27469":1623,"_18854":48541,"_5":12679,"_25963":48099,"_2424":48542},[],"**Install the trust chain** (`cacerts.pem`) into the device's trust store. The MQTT broker, the HTTPS server or any relying party validating mTLS will need this chain.",{"_2886":1799,"_27469":1623,"_18854":48544,"_5":12679,"_25963":48099,"_2424":48545},[],"**Combine the leaf certificate with the chain** before presenting it in mTLS connections. The `/simpleenroll` response contains only the leaf certificate; the relying party may reject the connection if it does not receive the full chain.",{"_2886":1800,"_27469":1623,"_18854":48547,"_5":12679,"_25963":48099,"_2424":48548},[],"**Plan renewal**: configure a timer on the device that invokes `/simplereenroll` within the `ReEnrollmentDelta` window before the certificate expires. Do not wait for expiry unless `EnableExpiredRenewal` is enabled.",{"_2886":1801,"_27469":1623,"_18854":48550,"_5":12679,"_25963":48105,"_2424":48551},[],"Lamassu maps almost every business error to `500 Internal Server Error`, not to `4xx`. The HTTP status code is not enough to distinguish a network error from a policy error. The integrator must inspect the `err` field of the JSON body (`{\"err\": \"<message>\"}`) to determine the exact cause of the failure.",{"_2886":1802,"_27469":1623,"_18854":48553,"_5":12679,"_25963":48105,"_2424":46917},[],{"_2886":1803,"_27469":1623,"_18854":48555,"_5":12679,"_25963":48105,"_2424":46702},[],{"_2886":1804,"_27469":1623,"_18854":48557,"_5":12679,"_25963":48105,"_2424":48558},[],"Cause",{"_2886":1805,"_27469":1623,"_18854":48560,"_5":12679,"_25963":48105,"_2424":46926},[],{"_2886":1806,"_27469":1623,"_18854":48562,"_5":12679,"_25963":48105,"_2424":26614},[],{"_2886":1807,"_27469":1623,"_18854":48564,"_5":12679,"_25963":48105,"_2424":48565},[],"`Field validation for 'APS' failed`",{"_2886":1808,"_27469":1623,"_18854":48567,"_5":12679,"_25963":48105,"_2424":48568},[],"The `{aps}` segment is missing from the URL.",{"_2886":1809,"_27469":1623,"_18854":48570,"_5":12679,"_25963":48105,"_2424":48571},[],"Include the DMS ID in the path.",{"_2886":1810,"_27469":1623,"_18854":48573,"_5":12679,"_25963":48105,"_2424":26614},[],{"_2886":1811,"_27469":1623,"_18854":48575,"_5":12679,"_25963":48105,"_2424":48576},[],"`content-type must be application/pkcs10`",{"_2886":1812,"_27469":1623,"_18854":48578,"_5":12679,"_25963":48105,"_2424":48579},[],"`Content-Type` header missing or incorrect.",{"_2886":1813,"_27469":1623,"_18854":48581,"_5":12679,"_25963":48105,"_2424":48582},[],"Set `Content-Type: application/pkcs10`.",{"_2886":1814,"_27469":1623,"_18854":48584,"_5":12679,"_25963":48105,"_2424":26614},[],{"_2886":1815,"_27469":1623,"_18854":48586,"_5":12679,"_25963":48105,"_2424":48587},[],"`body payload must be base64 encoded`",{"_2886":1816,"_27469":1623,"_18854":48589,"_5":12679,"_25963":48105,"_2424":48590},[],"The body is not valid base64.",{"_2886":1817,"_27469":1623,"_18854":48592,"_5":12679,"_25963":48105,"_2424":48593},[],"Use `base64 -w 0` to avoid line breaks.",{"_2886":1818,"_27469":1623,"_18854":48595,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1819,"_27469":1623,"_18854":48597,"_5":12679,"_25963":48105,"_2424":48598},[],"`DMS not found`",{"_2886":1820,"_27469":1623,"_18854":48600,"_5":12679,"_25963":48105,"_2424":48601},[],"The `{aps}` value does not match any DMS.",{"_2886":1821,"_27469":1623,"_18854":48603,"_5":12679,"_25963":48105,"_2424":48604},[],"Verify the identifier with the PKI administrator.",{"_2886":1822,"_27469":1623,"_18854":48606,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1823,"_27469":1623,"_18854":48608,"_5":12679,"_25963":48105,"_2424":48609},[],"`invalid certificate`",{"_2886":1824,"_27469":1623,"_18854":48611,"_5":12679,"_25963":48105,"_2424":48612},[],"The client certificate is not valid against `ValidationCAs`.",{"_2886":1825,"_27469":1623,"_18854":48614,"_5":12679,"_25963":48105,"_2424":48615},[],"Check the bootstrap certificate chain.",{"_2886":1826,"_27469":1623,"_18854":48617,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1827,"_27469":1623,"_18854":48619,"_5":12679,"_25963":48105,"_2424":48620},[],"`certificate is revoked`",{"_2886":1828,"_27469":1623,"_18854":48622,"_5":12679,"_25963":48105,"_2424":48623},[],"The certificate **presented as the mTLS credential** is revoked in Lamassu or via external OCSP/CRL.",{"_2886":1829,"_27469":1623,"_18854":48625,"_5":12679,"_25963":48105,"_2424":48626},[],"Request a new bootstrap certificate or investigate the revocation.",{"_2886":1830,"_27469":1623,"_18854":48628,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1831,"_27469":1623,"_18854":48630,"_5":12679,"_25963":48105,"_2424":48631},[],"`revoked certificate`",{"_2886":1832,"_27469":1623,"_18854":48633,"_5":12679,"_25963":48105,"_2424":48634},[],"In reenroll, the device's **active certificate in the database** is listed as revoked.",{"_2886":1833,"_27469":1623,"_18854":48636,"_5":12679,"_25963":48105,"_2424":48637},[],"Review the identity slot status; if the revocation was intentional, issue a new enroll instead of reenroll.",{"_2886":1834,"_27469":1623,"_18854":48639,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1835,"_27469":1623,"_18854":48641,"_5":12679,"_25963":48105,"_2424":48642},[],"`expired certificate`",{"_2886":1836,"_27469":1623,"_18854":48644,"_5":12679,"_25963":48105,"_2424":48645},[],"The presented certificate has expired and the DMS does not allow `AllowExpired`/`EnableExpiredRenewal`.",{"_2886":1837,"_27469":1623,"_18854":48647,"_5":12679,"_25963":48105,"_2424":48648},[],"Renew before expiration or request `EnableExpiredRenewal` to be enabled.",{"_2886":1838,"_27469":1623,"_18854":48650,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1839,"_27469":1623,"_18854":48652,"_5":12679,"_25963":48105,"_2424":48653},[],"`forbiddenNewEnrollment`",{"_2886":1840,"_27469":1623,"_18854":48655,"_5":12679,"_25963":48105,"_2424":48656},[],"The device is already enrolled and `EnableReplaceableEnrollment` is `false`.",{"_2886":1841,"_27469":1623,"_18854":48658,"_5":12679,"_25963":48105,"_2424":48659},[],"Use `/simplereenroll` or ask the administrator to enable the flag.",{"_2886":1842,"_27469":1623,"_18854":48661,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1843,"_27469":1623,"_18854":48663,"_5":12679,"_25963":48105,"_2424":48664},[],"`device not preregistered`",{"_2886":1844,"_27469":1623,"_18854":48666,"_5":12679,"_25963":48105,"_2424":48667},[],"The DMS is in `PRE_REGISTRATION` and the device does not exist.",{"_2886":1845,"_27469":1623,"_18854":48669,"_5":12679,"_25963":48105,"_2424":48670},[],"Register the device before enrolling it.",{"_2886":1846,"_27469":1623,"_18854":48672,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1847,"_27469":1623,"_18854":48674,"_5":12679,"_25963":48105,"_2424":48675},[],"`invalid reenroll window`",{"_2886":1848,"_27469":1623,"_18854":48677,"_5":12679,"_25963":48105,"_2424":48678},[],"Renewal attempted before `NotAfter - ReEnrollmentDelta`.",{"_2886":1849,"_27469":1623,"_18854":48680,"_5":12679,"_25963":48105,"_2424":48681},[],"Wait for the window to open or request a larger `ReEnrollmentDelta`.",{"_2886":1850,"_27469":1623,"_18854":48683,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1851,"_27469":1623,"_18854":48685,"_5":12679,"_25963":48105,"_2424":48686},[],"`invalid RawSubject bytes`",{"_2886":1852,"_27469":1623,"_18854":48688,"_5":12679,"_25963":48105,"_2424":48689},[],"The renewal CSR's subject does not match the active certificate's.",{"_2886":1853,"_27469":1623,"_18854":48691,"_5":12679,"_25963":48105,"_2424":48692},[],"Regenerate the CSR with the exact subject of the previous cert.",{"_2886":1854,"_27469":1623,"_18854":48694,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1855,"_27469":1623,"_18854":48696,"_5":12679,"_25963":48105,"_2424":48697},[],"`external webhook denied enrollment`",{"_2886":1856,"_27469":1623,"_18854":48699,"_5":12679,"_25963":48105,"_2424":48700},[],"The webhook returned a non-`2xx` code or `authorized != true`.",{"_2886":1857,"_27469":1623,"_18854":48702,"_5":12679,"_25963":48105,"_2424":48703},[],"Review the webhook service logs.",{"_2886":1858,"_27469":1623,"_18854":48705,"_5":12679,"_25963":48105,"_2424":26517},[],{"_2886":1859,"_27469":1623,"_18854":48707,"_5":12679,"_25963":48105,"_2424":48708},[],"`server key generation not enabled`",{"_2886":1860,"_27469":1623,"_18854":48710,"_5":12679,"_25963":48105,"_2424":48711},[],"`/serverkeygen` is disabled on the DMS.",{"_2886":1861,"_27469":1623,"_18854":48713,"_5":12679,"_25963":48105,"_2424":48714},[],"Ask the administrator to enable `ServerKeyGen.Enabled`.",{"_2886":1862,"_27469":1623,"_18854":48716,"_5":12679,"_25963":48105,"_2424":48717},[],"For messages not listed in this table, the Lamassu server logs (with the fields `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) are the first place to look for the cause.",{"_2886":1863,"_27469":1623,"_18854":48719,"_5":12679,"_25963":48108,"_2424":48720},[],"Lamassu's implementation follows RFC 7030 in its essentials but introduces several quirks that can affect strict EST clients or third-party libraries:",{"_2886":1864,"_27469":1623,"_18854":48722,"_5":12679,"_25963":48108,"_2424":48723},[],"The `/csrattrs` and `/fullcmc` endpoints of RFC 7030 are **not implemented** in Lamassu. A client invoking `/.well-known/est/<DMS_ID>/csrattrs` receives `404 Not Found` instead of the `204 No Content` the RFC suggests for \"no attributes\". Strict EST libraries must be configured not to attempt `csrattrs`.",{"_2886":1865,"_27469":1623,"_18854":48725,"_5":12679,"_25963":48108,"_2424":48726},[],"The base64 of the `/cacerts` and `/simpleenroll` responses is wrapped in lines of **76 characters** terminated with CRLF (S/MIME compliant, RFC 5751). The parts of `/serverkeygen` apply no wrap.",{"_2886":1866,"_27469":1623,"_18854":48728,"_5":12679,"_25963":48108,"_2424":48729},[],"The `multipart/mixed` boundary in `/serverkeygen` is fixed and cannot be negotiated.",{"_2886":1867,"_27469":1623,"_18854":48731,"_5":12679,"_25963":48108,"_2424":48732},[],"The `{aps}` segment is **mandatory** in all EST routes. Routes registered without `{aps}` are in the code but respond `400`.",{"_2886":1868,"_27469":1623,"_18854":48734,"_5":12679,"_25963":48108,"_2424":48735},[],"The body of `/cacerts`, `/simpleenroll` and `/simplereenroll` can be returned as concatenated PEM if the client sends `Accept: application/x-pem-file`. This is a Lamassu-specific extension and does not appear in the RFC.",{"_2886":1869,"_27469":1623,"_18854":48737,"_5":12679,"_25963":48108,"_2424":48738},[],"The server does not explicitly reject CSRs signed with SHA-1 or MD5; the integrator must generate the CSR with SHA-256 or higher.",{"_2886":1870,"_27469":1623,"_18854":48740,"_5":12679,"_25963":48108,"_2424":47128},[],{"_2886":1871,"_27469":1623,"_18854":48742,"_5":12679,"_25963":48108,"_2424":48743},[],"<Card title=\"CMP enrollment\" href=\"/docs/platform/pki/cmp\" />",{"_2886":1872,"_27469":1623,"_18854":48745,"_5":12679,"_25963":48108,"_2424":48746},[],"<Card title=\"OCSP validation\" href=\"/docs/platform/pki/ocsp\" />",{"_2886":1873,"_27469":1623,"_18854":48748,"_5":12679,"_25963":48108,"_2424":47134},[],{"_2886":1874,"_27469":1874,"_5":13057,"_2424":48750,"_27749":48751,"_18854":48753,"_25963":1874},"AWS IoT Core",[43001,44136,48752],"Integrations",[],{"_2886":1875,"_27469":1874,"_18854":48755,"_5":12679,"_25963":1874,"_2424":48756},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2886":1876,"_27469":1874,"_5":27746,"_18854":48758,"_25963":48759,"_2424":48760},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2886":1877,"_27469":1874,"_5":27746,"_18854":48762,"_25963":48763,"_2424":45602},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#prerequisites",{"_2886":1878,"_27469":1874,"_5":27746,"_18854":48765,"_25963":48766,"_2424":48767},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2886":1879,"_27469":1874,"_5":27746,"_18854":48769,"_25963":48770,"_2424":48771},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2886":1880,"_27469":1874,"_5":27746,"_18854":48773,"_25963":48774,"_2424":48775},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2886":1881,"_27469":1874,"_5":27746,"_18854":48777,"_25963":48778,"_2424":48779},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2886":1882,"_27469":1874,"_5":27746,"_18854":48781,"_25963":48782,"_2424":48783},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_2886":1883,"_27469":1874,"_5":27746,"_18854":48785,"_25963":48786,"_2424":48787},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2886":1884,"_27469":1874,"_5":27746,"_18854":48789,"_25963":48790,"_2424":45598},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#dms-configuration",{"_2886":1885,"_27469":1874,"_5":27746,"_18854":48792,"_25963":48793,"_2424":48794},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#none-mode","`none` mode",{"_2886":1886,"_27469":1874,"_5":27746,"_18854":48796,"_25963":48797,"_2424":48798},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2886":1887,"_27469":1874,"_5":27746,"_18854":48800,"_25963":48801,"_2424":48802},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2886":1888,"_27469":1874,"_5":27746,"_18854":48804,"_25963":48805,"_2424":48806},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2886":1889,"_27469":1874,"_5":27746,"_18854":48808,"_25963":48809,"_2424":48810},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2886":1890,"_27469":1874,"_5":27746,"_18854":48812,"_25963":48813,"_2424":48814},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2886":1891,"_27469":1874,"_5":27746,"_18854":48816,"_25963":48817,"_2424":48818},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2886":1892,"_27469":1874,"_5":27746,"_18854":48820,"_25963":48821,"_2424":48822},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2886":1893,"_27469":1874,"_5":27746,"_18854":48824,"_25963":48825,"_2424":48826},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2886":1894,"_27469":1874,"_5":27746,"_18854":48828,"_25963":48829,"_2424":48830},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2886":1895,"_27469":1874,"_5":27746,"_18854":48832,"_25963":48833,"_2424":48834},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2886":1896,"_27469":1874,"_18854":48836,"_5":12679,"_25963":1874,"_2424":48837},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2886":1897,"_27469":1874,"_18854":48839,"_5":12679,"_25963":1874,"_2424":48840},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2886":1898,"_27469":1874,"_18854":48842,"_5":12679,"_25963":1874,"_2424":48843},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2886":1899,"_27469":1874,"_18854":48845,"_5":12679,"_25963":48759,"_2424":48846},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2886":1900,"_27469":1874,"_18854":48848,"_5":12679,"_25963":48759,"_2424":48849},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2886":1901,"_27469":1874,"_18854":48851,"_5":12679,"_25963":48759,"_2424":48852},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2886":1902,"_27469":1874,"_18854":48854,"_5":12679,"_25963":48759,"_2424":48855},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2886":1903,"_27469":1874,"_18854":48857,"_5":12679,"_25963":48763,"_2424":48858},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2886":1904,"_27469":1874,"_18854":48860,"_5":12679,"_25963":48766,"_2424":48861},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2886":1905,"_27469":1874,"_18854":48863,"_5":12679,"_25963":48766,"_2424":48864},[],"IAM action",{"_2886":1906,"_27469":1874,"_18854":48866,"_5":12679,"_25963":48766,"_2424":43384},[],{"_2886":1907,"_27469":1874,"_18854":48868,"_5":12679,"_25963":48766,"_2424":48869},[],"`iot:GetRegistrationCode`",{"_2886":1908,"_27469":1874,"_18854":48871,"_5":12679,"_25963":48766,"_2424":48872},[],"Obtain the verification code for CA registration in the Primary Account",{"_2886":1909,"_27469":1874,"_18854":48874,"_5":12679,"_25963":48766,"_2424":48875},[],"`iot:RegisterCACertificate`",{"_2886":1910,"_27469":1874,"_18854":48877,"_5":12679,"_25963":48766,"_2424":48878},[],"Register the CA in AWS IoT",{"_2886":1911,"_27469":1874,"_18854":48880,"_5":12679,"_25963":48766,"_2424":48881},[],"`iot:DescribeCACertificate`",{"_2886":1912,"_27469":1874,"_18854":48883,"_5":12679,"_25963":48766,"_2424":48884},[],"Check the CA registration status",{"_2886":1913,"_27469":1874,"_18854":48886,"_5":12679,"_25963":48766,"_2424":48887},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2886":1914,"_27469":1874,"_18854":48889,"_5":12679,"_25963":48766,"_2424":48890},[],"Create or update Things in IoT Core",{"_2886":1915,"_27469":1874,"_18854":48892,"_5":12679,"_25963":48766,"_2424":48893},[],"`iot:RegisterThing`",{"_2886":1916,"_27469":1874,"_18854":48895,"_5":12679,"_25963":48766,"_2424":48896},[],"Provision Things through a template",{"_2886":1917,"_27469":1874,"_18854":48898,"_5":12679,"_25963":48766,"_2424":48899},[],"`iot:RegisterCertificate`",{"_2886":1918,"_27469":1874,"_18854":48901,"_5":12679,"_25963":48766,"_2424":48902},[],"Register device certificates",{"_2886":1919,"_27469":1874,"_18854":48904,"_5":12679,"_25963":48766,"_2424":48905},[],"`iot:UpdateCertificate`",{"_2886":1920,"_27469":1874,"_18854":48907,"_5":12679,"_25963":48766,"_2424":48908},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2886":1921,"_27469":1874,"_18854":48910,"_5":12679,"_25963":48766,"_2424":48911},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2886":1922,"_27469":1874,"_18854":48913,"_5":12679,"_25963":48766,"_2424":48914},[],"Create and attach IoT policies",{"_2886":1923,"_27469":1874,"_18854":48916,"_5":12679,"_25963":48766,"_2424":48917},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2886":1924,"_27469":1874,"_18854":48919,"_5":12679,"_25963":48766,"_2424":48920},[],"Manage Thing groups",{"_2886":1925,"_27469":1874,"_18854":48922,"_5":12679,"_25963":48766,"_2424":48923},[],"`iot:CreateProvisioningTemplate`",{"_2886":1926,"_27469":1874,"_18854":48925,"_5":12679,"_25963":48766,"_2424":48926},[],"Create JITP templates",{"_2886":1927,"_27469":1874,"_18854":48928,"_5":12679,"_25963":48766,"_2424":48929},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2886":1928,"_27469":1874,"_18854":48931,"_5":12679,"_25963":48766,"_2424":48932},[],"Read and write the Device Shadow",{"_2886":1929,"_27469":1874,"_18854":48934,"_5":12679,"_25963":48766,"_2424":48935},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2886":1930,"_27469":1874,"_18854":48937,"_5":12679,"_25963":48770,"_2424":48938},[],"Parameter",{"_2886":1931,"_27469":1874,"_18854":48940,"_5":12679,"_25963":48770,"_2424":45986},[],{"_2886":1932,"_27469":1874,"_18854":48942,"_5":12679,"_25963":48770,"_2424":48943},[],"Required",{"_2886":1933,"_27469":1874,"_18854":48945,"_5":12679,"_25963":48770,"_2424":45907},[],{"_2886":1934,"_27469":1874,"_18854":48947,"_5":12679,"_25963":48770,"_2424":48948},[],"`connector_id`",{"_2886":1935,"_27469":1874,"_18854":48950,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1936,"_27469":1874,"_18854":48952,"_5":12679,"_25963":48770,"_2424":46785},[],{"_2886":1937,"_27469":1874,"_18854":48954,"_5":12679,"_25963":48770,"_2424":48955},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2886":1938,"_27469":1874,"_18854":48957,"_5":12679,"_25963":48770,"_2424":48958},[],"`aws_config.region`",{"_2886":1939,"_27469":1874,"_18854":48960,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1940,"_27469":1874,"_18854":48962,"_5":12679,"_25963":48770,"_2424":46785},[],{"_2886":1941,"_27469":1874,"_18854":48964,"_5":12679,"_25963":48770,"_2424":48965},[],"AWS region where the connector operates.",{"_2886":1942,"_27469":1874,"_18854":48967,"_5":12679,"_25963":48770,"_2424":48968},[],"`aws_config.auth_method`",{"_2886":1943,"_27469":1874,"_18854":48970,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1944,"_27469":1874,"_18854":48972,"_5":12679,"_25963":48770,"_2424":46785},[],{"_2886":1945,"_27469":1874,"_18854":48974,"_5":12679,"_25963":48770,"_2424":48975},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2886":1946,"_27469":1874,"_18854":48977,"_5":12679,"_25963":48770,"_2424":48978},[],"`aws_config.access_key_id`",{"_2886":1947,"_27469":1874,"_18854":48980,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1948,"_27469":1874,"_18854":48982,"_5":12679,"_25963":48770,"_2424":48983},[],"Only with `auth_method=static`",{"_2886":1949,"_27469":1874,"_18854":48985,"_5":12679,"_25963":48770,"_2424":48986},[],"AWS access key.",{"_2886":1950,"_27469":1874,"_18854":48988,"_5":12679,"_25963":48770,"_2424":48989},[],"`aws_config.secret_access_key`",{"_2886":1951,"_27469":1874,"_18854":48991,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1952,"_27469":1874,"_18854":48993,"_5":12679,"_25963":48770,"_2424":48983},[],{"_2886":1953,"_27469":1874,"_18854":48995,"_5":12679,"_25963":48770,"_2424":48996},[],"AWS secret key.",{"_2886":1954,"_27469":1874,"_18854":48998,"_5":12679,"_25963":48770,"_2424":48999},[],"`aws_config.session_token`",{"_2886":1955,"_27469":1874,"_18854":49001,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1956,"_27469":1874,"_18854":49003,"_5":12679,"_25963":48770,"_2424":46753},[],{"_2886":1957,"_27469":1874,"_18854":49005,"_5":12679,"_25963":48770,"_2424":49006},[],"Session token (with `auth_method=static`).",{"_2886":1958,"_27469":1874,"_18854":49008,"_5":12679,"_25963":48770,"_2424":49009},[],"`aws_config.role_arn`",{"_2886":1959,"_27469":1874,"_18854":49011,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1960,"_27469":1874,"_18854":49013,"_5":12679,"_25963":48770,"_2424":49014},[],"Only with `auth_method=role`",{"_2886":1961,"_27469":1874,"_18854":49016,"_5":12679,"_25963":48770,"_2424":49017},[],"ARN of the role to assume.",{"_2886":1962,"_27469":1874,"_18854":49019,"_5":12679,"_25963":48770,"_2424":49020},[],"`aws_config.endpoint_url`",{"_2886":1963,"_27469":1874,"_18854":49022,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1964,"_27469":1874,"_18854":49024,"_5":12679,"_25963":48770,"_2424":46753},[],{"_2886":1965,"_27469":1874,"_18854":49026,"_5":12679,"_25963":48770,"_2424":49027},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2886":1966,"_27469":1874,"_18854":49029,"_5":12679,"_25963":48770,"_2424":49030},[],"`subscriber_event_bus`",{"_2886":1967,"_27469":1874,"_18854":49032,"_5":12679,"_25963":48770,"_2424":15766},[],{"_2886":1968,"_27469":1874,"_18854":49034,"_5":12679,"_25963":48770,"_2424":46785},[],{"_2886":1969,"_27469":1874,"_18854":49036,"_5":12679,"_25963":48770,"_2424":49037},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2886":1970,"_27469":1874,"_18854":49039,"_5":12679,"_25963":48770,"_2424":49040},[],"`dms_manager_client`",{"_2886":1971,"_27469":1874,"_18854":49042,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1972,"_27469":1874,"_18854":49044,"_5":12679,"_25963":48770,"_2424":46785},[],{"_2886":1973,"_27469":1874,"_18854":49046,"_5":12679,"_25963":48770,"_2424":49047},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2886":1974,"_27469":1874,"_18854":49049,"_5":12679,"_25963":48770,"_2424":49050},[],"`device_manager_client`",{"_2886":1975,"_27469":1874,"_18854":49052,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1976,"_27469":1874,"_18854":49054,"_5":12679,"_25963":48770,"_2424":46785},[],{"_2886":1977,"_27469":1874,"_18854":49056,"_5":12679,"_25963":48770,"_2424":49057},[],"HTTP URL of Lamassu's Device Manager.",{"_2886":1978,"_27469":1874,"_18854":49059,"_5":12679,"_25963":48770,"_2424":49060},[],"`ca_client`",{"_2886":1979,"_27469":1874,"_18854":49062,"_5":12679,"_25963":48770,"_2424":22534},[],{"_2886":1980,"_27469":1874,"_18854":49064,"_5":12679,"_25963":48770,"_2424":46785},[],{"_2886":1981,"_27469":1874,"_18854":49066,"_5":12679,"_25963":48770,"_2424":49067},[],"HTTP URL of Lamassu's CA service.",{"_2886":1982,"_27469":1874,"_18854":49069,"_5":12679,"_25963":48774,"_2424":49070},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2886":1983,"_27469":1874,"_18854":49072,"_5":12679,"_25963":48778,"_2424":49073},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2886":1984,"_27469":1874,"_18854":49075,"_5":12679,"_25963":48778,"_2424":49076},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2886":1985,"_27469":1874,"_18854":49078,"_5":12679,"_25963":48782,"_2424":49079},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2886":1986,"_27469":1874,"_18854":49081,"_5":12679,"_25963":48782,"_2424":49082},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2886":1987,"_27469":1874,"_18854":49084,"_5":12679,"_25963":48782,"_2424":49085},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2886":1988,"_27469":1874,"_18854":49087,"_5":12679,"_25963":48782,"_2424":49088},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2886":1989,"_27469":1874,"_18854":49090,"_5":12679,"_25963":48782,"_2424":49091},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2886":1990,"_27469":1874,"_18854":49093,"_5":12679,"_25963":48782,"_2424":49094},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2886":1991,"_27469":1874,"_18854":49096,"_5":12679,"_25963":48786,"_2424":49097},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2886":1992,"_27469":1874,"_18854":49099,"_5":12679,"_25963":48790,"_2424":49100},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2886":1993,"_27469":1874,"_18854":49102,"_5":12679,"_25963":48790,"_2424":49103},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2886":1994,"_27469":1874,"_18854":49105,"_5":12679,"_25963":48793,"_2424":49106},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2886":1995,"_27469":1874,"_18854":49108,"_5":12679,"_25963":48797,"_2424":49109},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2886":1996,"_27469":1874,"_18854":49111,"_5":12679,"_25963":48797,"_2424":49112},[],"Creates or updates the IoT policies configured in the DMS.",{"_2886":1997,"_27469":1874,"_18854":49114,"_5":12679,"_25963":48797,"_2424":49115},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2886":1998,"_27469":1874,"_18854":49117,"_5":12679,"_25963":48797,"_2424":49118},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2886":1999,"_27469":1874,"_18854":49120,"_5":12679,"_25963":48797,"_2424":49121},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2886":2000,"_27469":1874,"_18854":49123,"_5":12679,"_25963":48797,"_2424":49124},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2886":2001,"_27469":1874,"_18854":49126,"_5":12679,"_25963":48797,"_2424":49127},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2886":2002,"_27469":1874,"_18854":49129,"_5":12679,"_25963":48801,"_2424":49130},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2886":2003,"_27469":1874,"_18854":49132,"_5":12679,"_25963":48801,"_2424":49133},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2886":2004,"_27469":1874,"_18854":49135,"_5":12679,"_25963":48801,"_2424":49136},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2886":2005,"_27469":1874,"_18854":49138,"_5":12679,"_25963":48805,"_2424":49139},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2886":2006,"_27469":1874,"_18854":49141,"_5":12679,"_25963":48805,"_2424":49142},[],"The full flow from the device's perspective is:",{"_2886":2007,"_27469":1874,"_18854":49144,"_5":12679,"_25963":48805,"_2424":49145},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2886":2008,"_27469":1874,"_18854":49147,"_5":12679,"_25963":48809,"_2424":49148},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2886":2009,"_27469":1874,"_18854":49150,"_5":12679,"_25963":48809,"_2424":49151},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2886":2010,"_27469":1874,"_18854":49153,"_5":12679,"_25963":48809,"_2424":49154},[],"For the JITP flow to work correctly:",{"_2886":2011,"_27469":1874,"_18854":49156,"_5":12679,"_25963":48809,"_2424":49157},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2886":2012,"_27469":1874,"_18854":49159,"_5":12679,"_25963":48809,"_2424":49160},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2886":2013,"_27469":1874,"_18854":49162,"_5":12679,"_25963":48809,"_2424":49163},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2886":2014,"_27469":1874,"_18854":49165,"_5":12679,"_25963":48809,"_2424":49166},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2886":2015,"_27469":1874,"_18854":49168,"_5":12679,"_25963":48813,"_2424":49169},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2886":2016,"_27469":1874,"_18854":49171,"_5":12679,"_25963":48813,"_2424":49172},[],"Status in Lamassu",{"_2886":2017,"_27469":1874,"_18854":49174,"_5":12679,"_25963":48813,"_2424":49175},[],"Revocation reason",{"_2886":2018,"_27469":1874,"_18854":49177,"_5":12679,"_25963":48813,"_2424":49178},[],"Status in AWS IoT Core",{"_2886":2019,"_27469":1874,"_18854":49180,"_5":12679,"_25963":48813,"_2424":49181},[],"`Active`",{"_2886":2020,"_27469":1874,"_18854":49183,"_5":12679,"_25963":48813,"_2424":48375},[],{"_2886":2021,"_27469":1874,"_18854":49185,"_5":12679,"_25963":48813,"_2424":49186},[],"`ACTIVE`",{"_2886":2022,"_27469":1874,"_18854":49188,"_5":12679,"_25963":48813,"_2424":49189},[],"`Revoked`",{"_2886":2023,"_27469":1874,"_18854":49191,"_5":12679,"_25963":48813,"_2424":49192},[],"`certificateHold`",{"_2886":2024,"_27469":1874,"_18854":49194,"_5":12679,"_25963":48813,"_2424":49195},[],"`INACTIVE`",{"_2886":2025,"_27469":1874,"_18854":49197,"_5":12679,"_25963":48813,"_2424":49189},[],{"_2886":2026,"_27469":1874,"_18854":49199,"_5":12679,"_25963":48813,"_2424":49200},[],"Any other reason",{"_2886":2027,"_27469":1874,"_18854":49202,"_5":12679,"_25963":48813,"_2424":46567},[],{"_2886":2028,"_27469":1874,"_18854":49204,"_5":12679,"_25963":48813,"_2424":49205},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2886":2029,"_27469":1874,"_18854":49207,"_5":12679,"_25963":48817,"_2424":49208},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2886":2030,"_27469":1874,"_18854":49210,"_5":12679,"_25963":48817,"_2424":49211},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2886":2031,"_27469":1874,"_18854":49213,"_5":12679,"_25963":48817,"_2424":49214},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2886":2032,"_27469":1874,"_18854":49216,"_5":12679,"_25963":48821,"_2424":49217},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2886":2033,"_27469":1874,"_18854":49219,"_5":12679,"_25963":48821,"_2424":49220},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2886":2034,"_27469":1874,"_18854":49222,"_5":12679,"_25963":48825,"_2424":49223},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2886":2035,"_27469":1874,"_18854":49225,"_5":12679,"_25963":48825,"_2424":49226},[],"There are two action types:",{"_2886":2036,"_27469":1874,"_18854":49228,"_5":12679,"_25963":48825,"_2424":49229},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2886":2037,"_27469":1874,"_18854":49231,"_5":12679,"_25963":48825,"_2424":49232},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2886":2038,"_27469":1874,"_18854":49234,"_5":12679,"_25963":48825,"_2424":49235},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2886":2039,"_27469":1874,"_18854":49237,"_5":12679,"_25963":48829,"_2424":49238},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2886":2040,"_27469":1874,"_18854":49240,"_5":12679,"_25963":48829,"_2424":49241},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2886":2041,"_27469":1874,"_18854":49243,"_5":12679,"_25963":48829,"_2424":49244},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2886":2042,"_27469":1874,"_18854":49246,"_5":12679,"_25963":48833,"_2424":49247},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2886":2043,"_27469":1874,"_18854":49249,"_5":12679,"_25963":48833,"_2424":49250},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2886":2044,"_27469":1874,"_18854":49252,"_5":12679,"_25963":48833,"_2424":49253},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2886":2045,"_27469":1874,"_18854":49255,"_5":12679,"_25963":48833,"_2424":49256},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2886":2046,"_27469":1874,"_18854":49258,"_5":12679,"_25963":48833,"_2424":49259},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2886":2047,"_27469":1874,"_18854":49261,"_5":12679,"_25963":48833,"_2424":49262},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2886":2048,"_27469":1874,"_18854":49264,"_5":12679,"_25963":48833,"_2424":49265},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2886":2049,"_27469":1874,"_18854":49267,"_5":12679,"_25963":48833,"_2424":49268},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2886":2050,"_27469":1874,"_18854":49270,"_5":12679,"_25963":48833,"_2424":49271},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2886":2051,"_27469":1874,"_18854":49273,"_5":12679,"_25963":48833,"_2424":49274},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2886":2052,"_27469":1874,"_18854":49276,"_5":12679,"_25963":48833,"_2424":49277},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2886":2053,"_27469":1874,"_18854":49279,"_5":12679,"_25963":48833,"_2424":49280},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2886":2054,"_27469":1874,"_18854":49282,"_5":12679,"_25963":48833,"_2424":49283},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2886":2055,"_27469":1874,"_18854":49285,"_5":12679,"_25963":48833,"_2424":49286},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2886":2056,"_27469":1874,"_18854":49288,"_5":12679,"_25963":48833,"_2424":49289},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2886":2057,"_27469":1874,"_18854":49291,"_5":12679,"_25963":48833,"_2424":49292},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2886":2058,"_27469":1874,"_18854":49294,"_5":12679,"_25963":48833,"_2424":49295},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2886":2059,"_27469":1874,"_18854":49297,"_5":12679,"_25963":48833,"_2424":49298},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2886":2060,"_27469":1874,"_18854":49300,"_5":12679,"_25963":48833,"_2424":49301},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2886":2061,"_27469":1874,"_18854":49303,"_5":12679,"_25963":48833,"_2424":49304},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2886":2062,"_27469":1874,"_18854":49306,"_5":12679,"_25963":48833,"_2424":49307},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2886":2063,"_27469":2063,"_5":13057,"_2424":49309,"_27749":49310,"_18854":49311,"_25963":2063},"Keys and cryptographic engines",[43001,44136,44614],[],{"_2886":2064,"_27469":2063,"_18854":49313,"_5":12679,"_25963":2063,"_2424":49314},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2886":2065,"_27469":2063,"_5":27746,"_18854":49316,"_25963":49317,"_2424":49318},[],"/docs/pr-preview/pr-24/platform/pki/key-management#cryptographic-key-management","Cryptographic key management",{"_2886":2066,"_27469":2063,"_5":27746,"_18854":49320,"_25963":49321,"_2424":49322},[],"/docs/pr-preview/pr-24/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2886":2067,"_27469":2063,"_5":27746,"_18854":49324,"_25963":49325,"_2424":49326},[],"/docs/pr-preview/pr-24/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2886":2068,"_27469":2063,"_5":27746,"_18854":49328,"_25963":49329,"_2424":49330},[],"/docs/pr-preview/pr-24/platform/pki/key-management#file-system","File System",{"_2886":2069,"_27469":2063,"_5":27746,"_18854":49332,"_25963":49333,"_2424":49334},[],"/docs/pr-preview/pr-24/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2886":2070,"_27469":2063,"_5":27746,"_18854":49336,"_25963":49337,"_2424":49338},[],"/docs/pr-preview/pr-24/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2886":2071,"_27469":2063,"_5":27746,"_18854":49340,"_25963":49341,"_2424":49342},[],"/docs/pr-preview/pr-24/platform/pki/key-management#aws-kms","AWS KMS",{"_2886":2072,"_27469":2063,"_5":27746,"_18854":49344,"_25963":49345,"_2424":49346},[],"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","PKCS#11",{"_2886":2073,"_27469":2063,"_5":27746,"_18854":49348,"_25963":49349,"_2424":49350},[],"/docs/pr-preview/pr-24/platform/pki/key-management#key-inventory","Key inventory",{"_2886":2074,"_27469":2063,"_5":27746,"_18854":49352,"_25963":49353,"_2424":49354},[],"/docs/pr-preview/pr-24/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2886":2075,"_27469":2063,"_5":27746,"_18854":49356,"_25963":49357,"_2424":49358},[],"/docs/pr-preview/pr-24/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2886":2076,"_27469":2063,"_5":27746,"_18854":49360,"_25963":49361,"_2424":49362},[],"/docs/pr-preview/pr-24/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2886":2077,"_27469":2063,"_5":27746,"_18854":49364,"_25963":49365,"_2424":49366},[],"/docs/pr-preview/pr-24/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2886":2078,"_27469":2063,"_5":27746,"_18854":49368,"_25963":49369,"_2424":49370},[],"/docs/pr-preview/pr-24/platform/pki/key-management#view-details","View details",{"_2886":2079,"_27469":2063,"_5":27746,"_18854":49372,"_25963":49373,"_2424":49374},[],"/docs/pr-preview/pr-24/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2886":2080,"_27469":2063,"_5":27746,"_18854":49376,"_25963":49377,"_2424":49378},[],"/docs/pr-preview/pr-24/platform/pki/key-management#sign","Sign",{"_2886":2081,"_27469":2063,"_5":27746,"_18854":49380,"_25963":49381,"_2424":49382},[],"/docs/pr-preview/pr-24/platform/pki/key-management#verify","Verify",{"_2886":2082,"_27469":2063,"_5":27746,"_18854":49384,"_25963":49385,"_2424":49386},[],"/docs/pr-preview/pr-24/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2886":2083,"_27469":2063,"_5":27746,"_18854":49388,"_25963":49389,"_2424":49390},[],"/docs/pr-preview/pr-24/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2886":2084,"_27469":2063,"_18854":49392,"_5":12679,"_25963":49317,"_2424":49393},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2886":2085,"_27469":2063,"_18854":49395,"_5":12679,"_25963":49317,"_2424":49396},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2886":2086,"_27469":2063,"_18854":49398,"_5":12679,"_25963":49321,"_2424":49399},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2886":2087,"_27469":2063,"_18854":49401,"_5":12679,"_25963":49321,"_2424":49402},[],"In practice, it lets you:",{"_2886":2088,"_27469":2063,"_18854":49404,"_5":12679,"_25963":49321,"_2424":49405},[],"Generate new key pairs from Lamassu IoT.",{"_2886":2089,"_27469":2063,"_18854":49407,"_5":12679,"_25963":49321,"_2424":49408},[],"Import keys created externally.",{"_2886":2090,"_27469":2063,"_18854":49410,"_5":12679,"_25963":49321,"_2424":49411},[],"Delegate custody and cryptographic operations to external engines.",{"_2886":2091,"_27469":2063,"_18854":49413,"_5":12679,"_25963":49321,"_2424":49414},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2886":2092,"_27469":2063,"_18854":49416,"_5":12679,"_25963":49325,"_2424":49417},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2886":2093,"_27469":2063,"_18854":49419,"_5":12679,"_25963":49325,"_2424":49420},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2886":2094,"_27469":2063,"_18854":49422,"_5":12679,"_25963":49325,"_2424":49423},[],"Currently, Lamassu supports five engine types. Choose according to the isolation level you need and who should be able to access private material.",{"_2886":2095,"_27469":2063,"_18854":49425,"_5":12679,"_25963":49329,"_2424":49426},[],"Generates keys with Go's cryptographic libraries and delegates their protection to the file system. It works both on-premise and in the cloud, but it does not prevent key extraction and is not recommended for production.",{"_2886":2096,"_27469":2063,"_18854":49428,"_5":12679,"_25963":49333,"_2424":49429},[],"Protects keys at rest and can run on-premise or in the cloud. An administrator with sufficient permissions can still view private material, so it is wise to limit administrative access and safeguard the *unseal* keys.",{"_2886":2097,"_27469":2063,"_18854":49431,"_5":12679,"_25963":49337,"_2424":49432},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2886":2098,"_27469":2063,"_18854":49434,"_5":12679,"_25963":49341,"_2424":49435},[],"Generates keys with hardware entropy and never exposes the private key. Operations run inside the service. Even so, an identity with sufficient permissions could use the key to sign, so IAM policy remains critical.",{"_2886":2099,"_27469":2063,"_18854":49437,"_5":12679,"_25963":49345,"_2424":49438},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2886":2100,"_27469":2063,"_18854":49440,"_5":12679,"_25963":49345,"_2424":49441},[],"Lamassu shows the full list of enabled engines in the console.",{"_2886":2101,"_27469":2063,"_18854":49443,"_5":12679,"_25963":49345,"_2424":49444},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2886":2102,"_27469":2063,"_18854":49446,"_5":12679,"_25963":49345,"_2424":49447},[],"During deployment it is mandatory to define a default engine. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2886":2103,"_27469":2063,"_18854":49449,"_5":12679,"_25963":49349,"_2424":49450},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2886":2104,"_27469":2063,"_18854":49452,"_5":12679,"_25963":49349,"_2424":49453},[],"The table includes the following fields:",{"_2886":2105,"_27469":2063,"_18854":49455,"_5":12679,"_25963":49349,"_2424":49456},[],"**Name**: descriptive name of the key.",{"_2886":2106,"_27469":2063,"_18854":49458,"_5":12679,"_25963":49349,"_2424":49459},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2886":2107,"_27469":2063,"_18854":49461,"_5":12679,"_25963":49349,"_2424":49462},[],"**Strength**: visual indicator of cryptographic strength.",{"_2886":2108,"_27469":2063,"_18854":49464,"_5":12679,"_25963":49349,"_2424":49465},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2886":2109,"_27469":2063,"_18854":49467,"_5":12679,"_25963":49349,"_2424":49468},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2886":2110,"_27469":2063,"_18854":49470,"_5":12679,"_25963":49349,"_2424":49471},[],"**Aliases**: alternative names associated with the key.",{"_2886":2111,"_27469":2063,"_18854":49473,"_5":12679,"_25963":49349,"_2424":49474},[],"**Tags**: labels for classification and search.",{"_2886":2112,"_27469":2063,"_18854":49476,"_5":12679,"_25963":49349,"_2424":49477},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2886":2113,"_27469":2063,"_18854":49479,"_5":12679,"_25963":49349,"_2424":49480},[],"From this view you also reach the most common actions:",{"_2886":2114,"_27469":2063,"_18854":49482,"_5":12679,"_25963":49349,"_2424":49483},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2886":2115,"_27469":2063,"_18854":49485,"_5":12679,"_25963":49349,"_2424":49486},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2886":2116,"_27469":2063,"_18854":49488,"_5":12679,"_25963":49349,"_2424":49489},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2886":2117,"_27469":2063,"_18854":49491,"_5":12679,"_25963":49349,"_2424":49492},[],"**Delete Key** to remove the key from the system.",{"_2886":2118,"_27469":2063,"_18854":49494,"_5":12679,"_25963":49353,"_2424":49495},[],"Keys are registered from the wizard opened with **Create New Key**.",{"_2886":2119,"_27469":2063,"_18854":49497,"_5":12679,"_25963":49357,"_2424":49498},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2886":2120,"_27469":2063,"_18854":49500,"_5":12679,"_25963":49357,"_2424":49501},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2886":2121,"_27469":2063,"_18854":49503,"_5":12679,"_25963":49357,"_2424":49504},[],"**Key Name**: unique and descriptive name.",{"_2886":2122,"_27469":2063,"_18854":49506,"_5":12679,"_25963":49357,"_2424":49507},[],"**Crypto Engine**: engine that will keep the key.",{"_2886":2123,"_27469":2063,"_18854":49509,"_5":12679,"_25963":49357,"_2424":49510},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2886":2124,"_27469":2063,"_18854":49512,"_5":12679,"_25963":49357,"_2424":49513},[],"**Tags**: metadata to classify the key.",{"_2886":2125,"_27469":2063,"_18854":49515,"_5":12679,"_25963":49357,"_2424":49516},[],"**Metadata**: additional information for advanced uses.",{"_2886":2126,"_27469":2063,"_18854":49518,"_5":12679,"_25963":49361,"_2424":49519},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2886":2127,"_27469":2063,"_18854":49521,"_5":12679,"_25963":49361,"_2424":49522},[],"When the key was generated in an isolated environment or an external HSM.",{"_2886":2128,"_27469":2063,"_18854":49524,"_5":12679,"_25963":49361,"_2424":49525},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2886":2129,"_27469":2063,"_18854":49527,"_5":12679,"_25963":49361,"_2424":49528},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2886":2130,"_27469":2063,"_18854":49530,"_5":12679,"_25963":49361,"_2424":49531},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2886":2131,"_27469":2063,"_18854":49533,"_5":12679,"_25963":49361,"_2424":49534},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2886":2132,"_27469":2063,"_18854":49536,"_5":12679,"_25963":49361,"_2424":49537},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2886":2133,"_27469":2063,"_18854":49539,"_5":12679,"_25963":49361,"_2424":49540},[],"**Tags**: labels for organization and search.",{"_2886":2134,"_27469":2063,"_18854":49542,"_5":12679,"_25963":49361,"_2424":49543},[],"**Metadata**: additional optional information.",{"_2886":2135,"_27469":2063,"_18854":49545,"_5":12679,"_25963":49361,"_2424":49546},[],"**Private Key (PEM)**: private key in PEM format.",{"_2886":2136,"_27469":2063,"_18854":49548,"_5":12679,"_25963":49361,"_2424":49549},[],"Once the wizard is complete, the key is stored in the selected engine and can be used for signing, CSR generation and the rest of the operations supported by the KMS.",{"_2886":2137,"_27469":2063,"_18854":49551,"_5":12679,"_25963":49365,"_2424":49552},[],"Each registered key has a detail view and several operational actions.",{"_2886":2138,"_27469":2063,"_18854":49554,"_5":12679,"_25963":49369,"_2424":49555},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2886":2139,"_27469":2063,"_18854":49557,"_5":12679,"_25963":49369,"_2424":49558},[],"The **Overview** tab shows, among others, these fields:",{"_2886":2140,"_27469":2063,"_18854":49560,"_5":12679,"_25963":49369,"_2424":49561},[],"**Key Name**: descriptive name.",{"_2886":2141,"_27469":2063,"_18854":49563,"_5":12679,"_25963":49369,"_2424":49564},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2886":2142,"_27469":2063,"_18854":49566,"_5":12679,"_25963":49369,"_2424":49567},[],"**Tags**: associated labels.",{"_2886":2143,"_27469":2063,"_18854":49569,"_5":12679,"_25963":49369,"_2424":49570},[],"**Aliases**: alternative names.",{"_2886":2144,"_27469":2063,"_18854":49572,"_5":12679,"_25963":49369,"_2424":49573},[],"**Crypto Engine**: engine where the key resides.",{"_2886":2145,"_27469":2063,"_18854":49575,"_5":12679,"_25963":49369,"_2424":49576},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2886":2146,"_27469":2063,"_18854":49578,"_5":12679,"_25963":49369,"_2424":49579},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2886":2147,"_27469":2063,"_18854":49581,"_5":12679,"_25963":49369,"_2424":49582},[],"The **Public Key** tab presents the public key in PEM format, ready to consult or copy.",{"_2886":2148,"_27469":2063,"_18854":49584,"_5":12679,"_25963":49373,"_2424":49585},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2886":2149,"_27469":2063,"_18854":49587,"_5":12679,"_25963":49373,"_2424":49588},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2886":2150,"_27469":2063,"_18854":49590,"_5":12679,"_25963":49377,"_2424":49591},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2886":2151,"_27469":2063,"_18854":49593,"_5":12679,"_25963":49377,"_2424":49594},[],"Main fields:",{"_2886":2152,"_27469":2063,"_18854":49596,"_5":12679,"_25963":49377,"_2424":49597},[],"**Algorithm**: signing algorithm available for the key type.",{"_2886":2153,"_27469":2063,"_18854":49599,"_5":12679,"_25963":49377,"_2424":49600},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2886":2154,"_27469":2063,"_18854":49602,"_5":12679,"_25963":49377,"_2424":49603},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2886":2155,"_27469":2063,"_18854":49605,"_5":12679,"_25963":49377,"_2424":49606},[],"**Message**: content to sign.",{"_2886":2156,"_27469":2063,"_18854":49608,"_5":12679,"_25963":49377,"_2424":49609},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2886":2157,"_27469":2063,"_18854":49611,"_5":12679,"_25963":49381,"_2424":49612},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2886":2158,"_27469":2063,"_18854":49614,"_5":12679,"_25963":49381,"_2424":49594},[],{"_2886":2159,"_27469":2063,"_18854":49616,"_5":12679,"_25963":49381,"_2424":49617},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2886":2160,"_27469":2063,"_18854":49619,"_5":12679,"_25963":49381,"_2424":49620},[],"**Message Type**: `Raw` or `Digest`.",{"_2886":2161,"_27469":2063,"_18854":49622,"_5":12679,"_25963":49381,"_2424":49623},[],"**Payload Encoding**: encoding of the message.",{"_2886":2162,"_27469":2063,"_18854":49625,"_5":12679,"_25963":49381,"_2424":49626},[],"**Message**: original message or hash.",{"_2886":2163,"_27469":2063,"_18854":49628,"_5":12679,"_25963":49381,"_2424":49629},[],"**Signature**: signature to check.",{"_2886":2164,"_27469":2063,"_18854":49631,"_5":12679,"_25963":49381,"_2424":49632},[],"**Result**: indicator of the validation result.",{"_2886":2165,"_27469":2063,"_18854":49634,"_5":12679,"_25963":49385,"_2424":49635},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2886":2166,"_27469":2063,"_18854":49637,"_5":12679,"_25963":49385,"_2424":49638},[],"This flow is useful for:",{"_2886":2167,"_27469":2063,"_18854":49640,"_5":12679,"_25963":49385,"_2424":49641},[],"Requesting certificates from an external CA.",{"_2886":2168,"_27469":2063,"_18854":49643,"_5":12679,"_25963":49385,"_2424":49644},[],"Renewing an identity while keeping the same key.",{"_2886":2169,"_27469":2063,"_18854":49646,"_5":12679,"_25963":49385,"_2424":49647},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2886":2170,"_27469":2063,"_18854":49649,"_5":12679,"_25963":49385,"_2424":49650},[],"**Common Name (CN)**: main name of the identity.",{"_2886":2171,"_27469":2063,"_18854":49652,"_5":12679,"_25963":49385,"_2424":49653},[],"**Organization (O)**: organization or company.",{"_2886":2172,"_27469":2063,"_18854":49655,"_5":12679,"_25963":49385,"_2424":49656},[],"**Organizational Unit (OU)**: department or unit.",{"_2886":2173,"_27469":2063,"_18854":49658,"_5":12679,"_25963":49385,"_2424":49659},[],"**Country (C)**: two-letter country code.",{"_2886":2174,"_27469":2063,"_18854":49661,"_5":12679,"_25963":49385,"_2424":49662},[],"**State / Province (ST)**: state or province.",{"_2886":2175,"_27469":2063,"_18854":49664,"_5":12679,"_25963":49385,"_2424":49665},[],"**Locality (L)**: city or locality.",{"_2886":2176,"_27469":2063,"_18854":49667,"_5":12679,"_25963":49385,"_2424":49668},[],"**Email Address**: contact email.",{"_2886":2177,"_27469":2063,"_18854":49670,"_5":12679,"_25963":49385,"_2424":49671},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2886":2178,"_27469":2063,"_18854":49673,"_5":12679,"_25963":49385,"_2424":49674},[],"Once the form is complete, Lamassu generates the CSR and presents it for download or copy.",{"_2886":2179,"_27469":2063,"_18854":49676,"_5":12679,"_25963":49389,"_2424":49677},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2886":2180,"_27469":2063,"_18854":49679,"_5":12679,"_25963":49389,"_2424":49680},[],"This option shows the steps needed to configure the local environment, load the PKCS#11 module and perform signatures with tools like OpenSSL without extracting the private key from the secured environment.",{"_2886":2181,"_27469":2181,"_5":13057,"_2424":49682,"_27749":49683,"_18854":49684,"_25963":2181},"Online validation with OCSP",[43001,44136,44614],[],{"_2886":2182,"_27469":2181,"_18854":49686,"_5":12679,"_25963":2181,"_2424":49687},[],"Check in real time whether a certificate is still valid or has been revoked.",{"_2886":2183,"_27469":2181,"_5":27746,"_18854":49689,"_25963":49690,"_2424":49691},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#ocsp-service","OCSP service",{"_2886":2184,"_27469":2181,"_5":27746,"_18854":49693,"_25963":49694,"_2424":49695},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2886":2185,"_27469":2181,"_5":27746,"_18854":49697,"_25963":49698,"_2424":49699},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2886":2186,"_27469":2181,"_5":27746,"_18854":49701,"_25963":49702,"_2424":49703},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2886":2187,"_27469":2181,"_5":27746,"_18854":49705,"_25963":49706,"_2424":49707},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2886":2188,"_27469":2181,"_5":27746,"_18854":49709,"_25963":49710,"_2424":47657},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#references",{"_2886":2189,"_27469":2181,"_18854":49712,"_5":12679,"_25963":49690,"_2424":49713},[],"OCSP (Online Certificate Status Protocol) is the mechanism that lets a relying party check, in real time, whether a specific certificate is valid or has been revoked. Instead of downloading a full list of revoked certificates, the client sends a query with the certificate's serial number and receives a signed response with the current status.",{"_2886":2190,"_27469":2181,"_18854":49715,"_5":12679,"_25963":49690,"_2424":49716},[],"Lamassu integrates its own OCSP responder that serves these queries by consulting the internal certificate database directly. No external component is required.",{"_2886":2191,"_27469":2181,"_18854":49718,"_5":12679,"_25963":49694,"_2424":49719},[],"When a client requests the status of a certificate, the responder locates the certificate by its serial number and determines its status from the internal record:",{"_2886":2192,"_27469":2181,"_18854":49721,"_5":12679,"_25963":49694,"_2424":49722},[],"If the certificate is active, the response indicates `Good`.",{"_2886":2193,"_27469":2181,"_18854":49724,"_5":12679,"_25963":49694,"_2424":49725},[],"If the certificate has been revoked, the response indicates `Revoked` and includes the revocation timestamp and the RFC 5280 reason code.",{"_2886":2194,"_27469":2181,"_18854":49727,"_5":12679,"_25963":49694,"_2424":49728},[],"If the serial number is not found or the status is not recognizable, the response indicates `Unknown`.",{"_2886":2195,"_27469":2181,"_18854":49730,"_5":12679,"_25963":49694,"_2424":49731},[],"The OCSP response is signed by the issuing CA of the queried certificate, using the cryptographic engine associated with that CA. Lamassu does not use a delegated OCSP signing certificate: the CA acts directly as the responder.",{"_2886":2196,"_27469":2181,"_18854":49733,"_5":12679,"_25963":49694,"_2424":49734},[],"Each response has a validity window of 24 hours, reflected in the response's `thisUpdate` and `nextUpdate` fields. Clients that cache responses must take this window into account when determining how long a response remains valid.",{"_2886":2197,"_27469":2181,"_18854":49736,"_5":12679,"_25963":49698,"_2424":49737},[],"The OCSP responder URL is automatically embedded in the AIA (*Authority Information Access*) extension of every certificate issued by Lamassu. Clients that verify certificates can read this URL directly from the certificate without additional configuration.",{"_2886":2198,"_27469":2181,"_18854":49739,"_5":12679,"_25963":49702,"_2424":49740},[],"The responder accepts both formats defined in RFC 6960:",{"_2886":2199,"_27469":2181,"_18854":49742,"_5":12679,"_25963":49702,"_2424":49743},[],"`GET /ocsp/{ocsp_request}` includes the OCSP request Base64url-encoded within the URL itself.",{"_2886":2200,"_27469":2181,"_18854":49745,"_5":12679,"_25963":49702,"_2424":49746},[],"`POST /ocsp` sends the request in the body with `Content-Type: application/ocsp-request`.",{"_2886":2201,"_27469":2181,"_18854":49748,"_5":12679,"_25963":49702,"_2424":49749},[],"Example query with `curl` using POST:",{"_2886":2202,"_27469":2181,"_18854":49751,"_5":12679,"_25963":49702,"_2424":49752},[],"The response has `Content-Type: application/ocsp-response` and contains the OCSP response in DER format.",{"_2886":2203,"_27469":2181,"_18854":49754,"_5":12679,"_25963":49706,"_2424":49755},[],"From the certificates screen of Lamassu you can launch an OCSP request directly against the selected certificate with the **OCSP Check** action. This action shows the status returned by the responder without needing external tools.",{"_2886":2204,"_27469":2181,"_18854":49757,"_5":12679,"_25963":49710,"_2424":49758},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_2886":2205,"_27469":2181,"_18854":49760,"_5":12679,"_25963":49710,"_2424":49761},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (revocation reasons, section 5.3.1)",{"_2886":2206,"_27469":2181,"_18854":49763,"_5":12679,"_25963":49710,"_2424":49764},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2886":2207,"_27469":2181,"_18854":49766,"_5":12679,"_25963":49710,"_2424":47748},[],{"_2886":2208,"_27469":2208,"_5":13057,"_2424":49768,"_27749":49769,"_18854":49770,"_25963":2208},"Lamassu IoT Platform",[43001,44136],[],{"_2886":2209,"_27469":2208,"_18854":49772,"_5":12679,"_25963":2208,"_2424":49773},[],"Manage PKI and digital identities for your devices from a single platform.",{"_2886":2210,"_27469":2208,"_5":27746,"_18854":49775,"_25963":49776,"_2424":49777},[],"/docs/pr-preview/pr-24/platform/pki/overview#start-here","Start here",{"_2886":2211,"_27469":2208,"_5":27746,"_18854":49779,"_25963":49780,"_2424":49781},[],"/docs/pr-preview/pr-24/platform/pki/overview#core-capabilities","Core capabilities",{"_2886":2212,"_27469":2208,"_5":27746,"_18854":49783,"_25963":49784,"_2424":49785},[],"/docs/pr-preview/pr-24/platform/pki/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2886":2213,"_27469":2208,"_5":27746,"_18854":49787,"_25963":49788,"_2424":49789},[],"/docs/pr-preview/pr-24/platform/pki/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2886":2214,"_27469":2208,"_5":27746,"_18854":49791,"_25963":49792,"_2424":49793},[],"/docs/pr-preview/pr-24/platform/pki/overview#issue-and-control-certificates","Issue and control certificates",{"_2886":2215,"_27469":2208,"_5":27746,"_18854":49795,"_25963":49796,"_2424":49797},[],"/docs/pr-preview/pr-24/platform/pki/overview#automate-device-identities","Automate device identities",{"_2886":2216,"_27469":2208,"_5":27746,"_18854":49799,"_25963":49800,"_2424":49801},[],"/docs/pr-preview/pr-24/platform/pki/overview#publish-validation-status","Publish validation status",{"_2886":2217,"_27469":2208,"_5":27746,"_18854":49803,"_25963":49804,"_2424":49805},[],"/docs/pr-preview/pr-24/platform/pki/overview#react-to-events","React to events",{"_2886":2218,"_27469":2208,"_5":27746,"_18854":49807,"_25963":49808,"_2424":49809},[],"/docs/pr-preview/pr-24/platform/pki/overview#choose-your-path","Choose your path",{"_2886":2219,"_27469":2208,"_5":27746,"_18854":49811,"_25963":49812,"_2424":49813},[],"/docs/pr-preview/pr-24/platform/pki/overview#operational-reference","Operational reference",{"_2886":2220,"_27469":2208,"_18854":49815,"_5":12679,"_25963":2208,"_2424":49816},[],"Lamassu IoT centralizes the issuance, distribution, renewal and revocation of X.509 identities for connected devices. You can build a private PKI, protect its keys and automate the enrollment of a fleet without losing visibility into every certificate.",{"_2886":2221,"_27469":2208,"_18854":49818,"_5":12679,"_25963":49776,"_2424":49819},[],"<Card title=\"Get started\" description=\"Create a CA, issue a certificate and register your first device.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2886":2222,"_27469":2208,"_18854":49821,"_5":12679,"_25963":49776,"_2424":49822},[],"<Card title=\"How Lamassu works\" description=\"Build the mental model of authorities, keys, identities and validation.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_2886":2223,"_27469":2208,"_18854":49824,"_5":12679,"_25963":49784,"_2424":49825},[],"Create root and intermediate authorities or import an existing PKI. Define which authority can issue each identity and keep the full chain of trust.",{"_2886":2224,"_27469":2208,"_18854":49827,"_5":12679,"_25963":49788,"_2424":49828},[],"Generate and safeguard keys using software engines, PKCS#11 HSMs or cloud services. Lamassu decouples operations from the physical location of the key.",{"_2886":2225,"_27469":2208,"_18854":49830,"_5":12679,"_25963":49792,"_2424":49831},[],"Issue certificates from the console or from a CSR, check their status and revoke them when they stop being trustworthy.",{"_2886":2226,"_27469":2208,"_18854":49833,"_5":12679,"_25963":49796,"_2424":49834},[],"Define enrollment policies with a Device Management Service (DMS) and let devices request or renew their identity through EST or CMP.",{"_2886":2227,"_27469":2208,"_18854":49836,"_5":12679,"_25963":49800,"_2424":49837},[],"Offer online validation through OCSP and distribute CRLs for consumers that need to check certificates offline.",{"_2886":2228,"_27469":2208,"_18854":49839,"_5":12679,"_25963":49804,"_2424":49840},[],"Subscribe to lifecycle changes and send notifications by email, Microsoft Teams or webhooks.",{"_2886":2229,"_27469":2208,"_18854":49842,"_5":12679,"_25963":49808,"_2424":49843},[],"<Card title=\"I administer the PKI\" description=\"Configure engines, authorities, issuance and validation.\" href=\"/docs/platform/pki/key-management\" />",{"_2886":2230,"_27469":2208,"_18854":49845,"_5":12679,"_25963":49808,"_2424":49846},[],"<Card title=\"I integrate a device\" description=\"Configure the DMS and use EST or CMP to obtain an identity.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2886":2231,"_27469":2208,"_18854":49848,"_5":12679,"_25963":49808,"_2424":49849},[],"<Card title=\"I operate the platform\" description=\"Deploy Lamassu and prepare its dependencies.\" href=\"/docs/deployment/overview\" />",{"_2886":2232,"_27469":2208,"_18854":49851,"_5":12679,"_25963":49808,"_2424":49852},[],"<Card title=\"I integrate another system\" description=\"Connect Lamassu with AWS IoT Core and other destinations.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_2886":2233,"_27469":2208,"_18854":49854,"_5":12679,"_25963":49812,"_2424":49855},[],"<Card title=\"Certificate profiles\" description=\"Turn issuance policy into reusable constraints.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_2886":2234,"_27469":2208,"_18854":49857,"_5":12679,"_25963":49812,"_2424":49858},[],"<Card title=\"Hierarchy and rotation\" description=\"Replace CA certificates or keys without breaking trust.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_2886":2235,"_27469":2208,"_18854":49860,"_5":12679,"_25963":49812,"_2424":49861},[],"<Card title=\"Access control\" description=\"Configure principals, policies and the first administrator.\" href=\"/docs/platform/pki/access-control\" />",{"_2886":2236,"_27469":2208,"_18854":49863,"_5":12679,"_25963":49812,"_2424":49864},[],"<Card title=\"Troubleshooting\" description=\"Diagnose the Gateway, services, issuance and enrollment.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2886":2237,"_27469":2237,"_5":13057,"_2424":49866,"_27749":49867,"_18854":49869,"_25963":2237},"Create your first CA",[43001,44136,49868],"Getting started",[],{"_2886":2238,"_27469":2237,"_18854":49871,"_5":12679,"_25963":2237,"_2424":49872},[],"Create a root authority and check that it is ready to issue certificates.",{"_2886":2239,"_27469":2237,"_5":27746,"_18854":49874,"_25963":49875,"_2424":43011},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2886":2240,"_27469":2237,"_5":27746,"_18854":49877,"_25963":49878,"_2424":49879},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2886":2241,"_27469":2237,"_5":27746,"_18854":49881,"_25963":49882,"_2424":49883},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2886":2242,"_27469":2237,"_5":27746,"_18854":49885,"_25963":49886,"_2424":49887},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2886":2243,"_27469":2237,"_5":27746,"_18854":49889,"_25963":49890,"_2424":49891},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2886":2244,"_27469":2237,"_5":27746,"_18854":49893,"_25963":49894,"_2424":49895},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2886":2245,"_27469":2237,"_5":27746,"_18854":49897,"_25963":49898,"_2424":43035},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2886":2246,"_27469":2237,"_18854":49900,"_5":12679,"_25963":2237,"_2424":49901},[],"In this quickstart you will create a root certification authority with a new key pair. When you finish you will have an active CA that you can use in the next quickstart.",{"_2886":2247,"_27469":2237,"_18854":49903,"_5":12679,"_25963":49875,"_2424":49904},[],"Console access with permissions to manage authorities.",{"_2886":2248,"_27469":2237,"_18854":49906,"_5":12679,"_25963":49875,"_2424":49907},[],"At least one cryptographic engine available.",{"_2886":2249,"_27469":2237,"_18854":49909,"_5":12679,"_25963":49875,"_2424":49910},[],"A name that identifies the purpose of the CA, for example `Acme Device Root CA`.",{"_2886":2250,"_27469":2237,"_18854":49912,"_5":12679,"_25963":49875,"_2424":49913},[],"A root CA is self-signed and acts as the anchor of trust. For production it is usually preferable to keep the root more protected and issue from an intermediate CA.",{"_2886":2251,"_27469":2237,"_18854":49915,"_5":12679,"_25963":49878,"_2424":49916},[],"In the side menu, open **Certification Authorities** and select **Create New CA**.",{"_2886":2252,"_27469":2237,"_18854":49918,"_5":12679,"_25963":49878,"_2424":49919},[],"Choose to create a CA with a new key pair. If you already have the key in the KMS, use &#x2A;*Create New CA (Existing Key)**.",{"_2886":2253,"_27469":2237,"_18854":49921,"_5":12679,"_25963":49882,"_2424":49922},[],"Choose the cryptographic engine that will keep the key and configure the algorithm. For a first CA you can use **EC P-384**, as long as it is compatible with your consumers.",{"_2886":2254,"_27469":2237,"_18854":49924,"_5":12679,"_25963":49882,"_2424":49925},[],"The private key will remain under the control of the selected engine.",{"_2886":2255,"_27469":2237,"_18854":49927,"_5":12679,"_25963":49886,"_2424":49928},[],"Select **Root CA** and complete:",{"_2886":2256,"_27469":2237,"_18854":49930,"_5":12679,"_25963":49886,"_2424":49931},[],"**CA Name**: a unique, recognizable name.",{"_2886":2257,"_27469":2237,"_18854":49933,"_5":12679,"_25963":49886,"_2424":49934},[],"**Subject**: at least the organization and country that will identify the authority.",{"_2886":2258,"_27469":2237,"_18854":49936,"_5":12679,"_25963":49886,"_2424":49937},[],"**CA Certificate Expiration**: a validity longer than that of the certificates it will issue.",{"_2886":2259,"_27469":2237,"_18854":49939,"_5":12679,"_25963":49886,"_2424":49940},[],"**Default End-Entity Certificate Issuance Expiration**: the default validity of end-entity certificates.",{"_2886":2260,"_27469":2237,"_18854":49942,"_5":12679,"_25963":49886,"_2424":49943},[],"The CA name will be used as the certificate's `Common Name`.",{"_2886":2261,"_27469":2237,"_18854":49945,"_5":12679,"_25963":49890,"_2424":49946},[],"Check the algorithm, subject and dates before confirming. These values define the anchor of trust and should not be chosen as throwaway test data in a production environment.",{"_2886":2262,"_27469":2237,"_18854":49948,"_5":12679,"_25963":49894,"_2424":49949},[],"Open the new CA from the list. It should appear active and show its PEM certificate, the expiration date and the **Issued Certificates** tab.",{"_2886":2263,"_27469":2237,"_18854":49951,"_5":12679,"_25963":49898,"_2424":49952},[],"Use the authority to issue your first certificate, or see the full authorities guide to create an intermediate CA, import a CA or define advanced profiles.",{"_2886":2264,"_27469":2264,"_5":13057,"_2424":49954,"_27749":49955,"_18854":49956,"_25963":2264},"Issue your first certificate",[43001,44136,49868],[],{"_2886":2265,"_27469":2264,"_18854":49958,"_5":12679,"_25963":2264,"_2424":49959},[],"Issue an X.509 identity from the console and verify the result.",{"_2886":2266,"_27469":2264,"_5":27746,"_18854":49961,"_25963":49962,"_2424":43011},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2886":2267,"_27469":2264,"_5":27746,"_18854":49964,"_25963":49965,"_2424":49966},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2886":2268,"_27469":2264,"_5":27746,"_18854":49968,"_25963":49969,"_2424":49970},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2886":2269,"_27469":2264,"_5":27746,"_18854":49972,"_25963":49973,"_2424":49974},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2886":2270,"_27469":2264,"_5":27746,"_18854":49976,"_25963":49977,"_2424":49978},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2886":2271,"_27469":2264,"_5":27746,"_18854":49980,"_25963":49981,"_2424":49982},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2886":2272,"_27469":2264,"_5":27746,"_18854":49984,"_25963":49985,"_2424":49895},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2886":2273,"_27469":2264,"_5":27746,"_18854":49987,"_25963":49988,"_2424":43035},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#next-step",{"_2886":2274,"_27469":2264,"_18854":49990,"_5":12679,"_25963":2264,"_2424":49991},[],"In this quickstart Lamassu will generate the key and the CSR in the browser, and the CA will issue the certificate. When you finish you will download the certificate and its private key.",{"_2886":2275,"_27469":2264,"_18854":49993,"_5":12679,"_25963":49962,"_2424":49994},[],"An active CA with permission to issue certificates.",{"_2886":2276,"_27469":2264,"_18854":49996,"_5":12679,"_25963":49962,"_2424":49997},[],"A name for the identity, for example `device-001.example.internal`.",{"_2886":2277,"_27469":2264,"_18854":49999,"_5":12679,"_25963":49962,"_2424":50000},[],"A safe place to keep the downloaded private key.",{"_2886":2278,"_27469":2264,"_18854":50002,"_5":12679,"_25963":49962,"_2424":50003},[],"In this flow the key is generated in the browser and Lamassu does not store it. Download it and protect it before closing the operation result.",{"_2886":2279,"_27469":2264,"_18854":50005,"_5":12679,"_25963":49965,"_2424":50006},[],"Open the CA created in the previous quickstart, go to **Issued Certificates** and select **Issue New**.",{"_2886":2280,"_27469":2264,"_18854":50008,"_5":12679,"_25963":49969,"_2424":50009},[],"Select **Generate Key & CSR in Browser**. Use **Upload Existing CSR** when the private key must be generated and kept on the target system.",{"_2886":2281,"_27469":2264,"_18854":50011,"_5":12679,"_25963":49973,"_2424":50012},[],"Enter the `Common Name` and, if applicable, the organization, organizational unit and location. Add SANs for each DNS name, IP address, email or URI the identity will be validated with.",{"_2886":2282,"_27469":2264,"_18854":50014,"_5":12679,"_25963":49977,"_2424":50015},[],"Choose RSA or ECDSA, define the validity and select the key usages. For a device identity that uses mTLS, enable **Digital Signature** and **Client Authentication**.",{"_2886":2283,"_27469":2264,"_18854":50017,"_5":12679,"_25963":49977,"_2424":50018},[],"The validity cannot exceed the expiration date of the issuing CA.",{"_2886":2284,"_27469":2264,"_18854":50020,"_5":12679,"_25963":49981,"_2424":50021},[],"Confirm the issuance and immediately download the certificate and the private key in PEM format.",{"_2886":2285,"_27469":2264,"_18854":50023,"_5":12679,"_25963":49985,"_2424":50024},[],"The certificate should appear in **Issued Certificates** with an active status. Check its subject, SANs, issuer, usages and validity period.",{"_2886":2286,"_27469":2264,"_18854":50026,"_5":12679,"_25963":49988,"_2424":50027},[],"Register your first device to associate the identity with a managed entity, or see certificate management.",{"_2886":2287,"_27469":2287,"_5":13057,"_2424":50029,"_27749":50030,"_18854":50031,"_25963":2287},"Get started",[43001,44136,49868],[],{"_2886":2288,"_27469":2287,"_18854":50033,"_5":12679,"_25963":2287,"_2424":50034},[],"Get a first result with Lamassu and continue from a working base.",{"_2886":2289,"_27469":2287,"_5":27746,"_18854":50036,"_25963":50037,"_2424":50038},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2886":2290,"_27469":2287,"_5":27746,"_18854":50040,"_25963":50041,"_2424":43011},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/overview#before-you-begin",{"_2886":2291,"_27469":2287,"_18854":50043,"_5":12679,"_25963":2287,"_2424":50044},[],"The quickstarts take you from a prepared instance to an active device identity. Each guide produces a verifiable result and links the detailed explanation when you need to go deeper.",{"_2886":2292,"_27469":2287,"_18854":50046,"_5":12679,"_25963":50037,"_2424":50047},[],"<Card title=\"1. Create your first CA\" description=\"Establish a root of trust capable of issuing certificates.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2886":2293,"_27469":2287,"_18854":50049,"_5":12679,"_25963":50037,"_2424":50050},[],"<Card title=\"2. Issue a certificate\" description=\"Create an X.509 identity and verify its contents.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2886":2294,"_27469":2287,"_18854":50052,"_5":12679,"_25963":50037,"_2424":50053},[],"<Card title=\"3. Register a device\" description=\"Add a device and assign it its first identity.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_2886":2295,"_27469":2287,"_18854":50055,"_5":12679,"_25963":50041,"_2424":50056},[],"You need access to the Lamassu IoT console and permissions to administer keys, authorities and devices. The instance must have at least one cryptographic engine configured.",{"_2886":2296,"_27469":2287,"_18854":50058,"_5":12679,"_25963":50041,"_2424":50059},[],"If you don't have an instance yet, first choose a deployment model.",{"_2886":2297,"_27469":2297,"_5":13057,"_2424":50061,"_27749":50062,"_18854":50063,"_25963":2297},"Register your first device",[43001,44136,49868],[],{"_2886":2298,"_27469":2297,"_18854":50065,"_5":12679,"_25963":2297,"_2424":50066},[],"Add a device to Lamassu and assign it an active identity.",{"_2886":2299,"_27469":2297,"_5":27746,"_18854":50068,"_25963":50069,"_2424":43011},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#before-you-begin",{"_2886":2300,"_27469":2297,"_5":27746,"_18854":50071,"_25963":50072,"_2424":50073},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#register-the-device","Register the device",{"_2886":2301,"_27469":2297,"_5":27746,"_18854":50075,"_25963":50076,"_2424":50077},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2886":2302,"_27469":2297,"_5":27746,"_18854":50079,"_25963":50080,"_2424":50081},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2886":2303,"_27469":2297,"_5":27746,"_18854":50083,"_25963":50084,"_2424":50085},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#verify-the-device","Verify the device",{"_2886":2304,"_27469":2297,"_5":27746,"_18854":50087,"_25963":50088,"_2424":50089},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2886":2305,"_27469":2297,"_18854":50091,"_5":12679,"_25963":2297,"_2424":50092},[],"In this quickstart you will manually register a device and assign it its first certificate. It is the shortest path to understanding how Lamassu relates a physical entity to its identity history.",{"_2886":2306,"_27469":2297,"_18854":50094,"_5":12679,"_25963":50069,"_2424":50095},[],"A configured DMS.",{"_2886":2307,"_27469":2297,"_18854":50097,"_5":12679,"_25963":50069,"_2424":50098},[],"A CA associated with the DMS.",{"_2886":2308,"_27469":2297,"_18854":50100,"_5":12679,"_25963":50069,"_2424":50101},[],"A unique identifier for the device.",{"_2886":2309,"_27469":2297,"_18854":50103,"_5":12679,"_25963":50072,"_2424":50104},[],"Open **Managed Devices**, select the action to register a device and complete:",{"_2886":2310,"_27469":2297,"_18854":50106,"_5":12679,"_25963":50072,"_2424":50107},[],"**Device ID**: unique identifier of the device.",{"_2886":2311,"_27469":2297,"_18854":50109,"_5":12679,"_25963":50072,"_2424":50110},[],"**Registration Authority**: the DMS that will apply the enrollment policies.",{"_2886":2312,"_27469":2297,"_18854":50112,"_5":12679,"_25963":50072,"_2424":50113},[],"**Icon** and **Tags**: optional classification to locate it later.",{"_2886":2313,"_27469":2297,"_18854":50115,"_5":12679,"_25963":50076,"_2424":50116},[],"Open the newly created device. It should appear with status **No Identity**: it exists in the inventory but does not yet have an associated certificate.",{"_2886":2314,"_27469":2297,"_18854":50118,"_5":12679,"_25963":50080,"_2424":50119},[],"Select **Assign Identity**. Lamassu will search for active certificates whose `Common Name` matches the `Device ID`.",{"_2886":2315,"_27469":2297,"_18854":50121,"_5":12679,"_25963":50080,"_2424":50122},[],"Select an existing certificate or use **Issue New Instead** to issue one from a CA linked to the DMS.",{"_2886":2316,"_27469":2297,"_18854":50124,"_5":12679,"_25963":50084,"_2424":50125},[],"After confirming, the status should change to **Active**. Review **Certificate History** to check the associated identity and **Device Event Timeline** to see the assignment event.",{"_2886":2317,"_27469":2297,"_18854":50127,"_5":12679,"_25963":50088,"_2424":50128},[],"Manual registration helps you understand the model, but a fleet should use automated enrollment. Continue with Device Management Service and the EST integration or CMP.",{"_2886":2318,"_27469":2318,"_5":13057,"_2424":48834,"_27749":50130,"_18854":50131,"_25963":2318},[43001,44136,44137],[],{"_2886":2319,"_27469":2318,"_18854":50133,"_5":12679,"_25963":2318,"_2424":50134},[],"Diagnose access, health, issuance, enrollment and dependencies in a Lamassu deployment.",{"_2886":2320,"_27469":2318,"_5":27746,"_18854":50136,"_25963":50137,"_2424":50138},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2886":2321,"_27469":2318,"_5":27746,"_18854":50140,"_25963":50141,"_2424":50142},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2886":2322,"_27469":2318,"_5":27746,"_18854":50144,"_25963":50145,"_2424":50146},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2886":2323,"_27469":2318,"_5":27746,"_18854":50148,"_25963":50149,"_2424":50150},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2886":2324,"_27469":2318,"_5":27746,"_18854":50152,"_25963":50153,"_2424":50154},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#query-the-affected-service","Query the affected service",{"_2886":2325,"_27469":2318,"_5":27746,"_18854":50156,"_25963":50157,"_2424":50158},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2886":2326,"_27469":2318,"_5":27746,"_18854":50160,"_25963":50161,"_2424":50162},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2886":2327,"_27469":2318,"_5":27746,"_18854":50164,"_25963":50165,"_2424":50166},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2886":2328,"_27469":2318,"_5":27746,"_18854":50168,"_25963":50169,"_2424":50170},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2886":2329,"_27469":2318,"_5":27746,"_18854":50172,"_25963":50173,"_2424":50174},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2886":2330,"_27469":2318,"_5":27746,"_18854":50176,"_25963":50177,"_2424":50178},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2886":2331,"_27469":2318,"_5":27746,"_18854":50180,"_25963":50181,"_2424":50182},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2886":2332,"_27469":2318,"_5":27746,"_18854":50184,"_25963":50185,"_2424":50186},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2886":2333,"_27469":2318,"_5":27746,"_18854":50188,"_25963":50189,"_2424":50190},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2886":2334,"_27469":2318,"_5":27746,"_18854":50192,"_25963":50193,"_2424":50194},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#observability","Observability",{"_2886":2335,"_27469":2318,"_18854":50196,"_5":12679,"_25963":2318,"_2424":50197},[],"Start by locating the failing layer. A Gateway response, an unready pod and a rejected issuance can look like the same problem from the console, but they require different evidence.",{"_2886":2336,"_27469":2318,"_18854":50199,"_5":12679,"_25963":50141,"_2424":50200},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2886":2337,"_27469":2318,"_18854":50202,"_5":12679,"_25963":50145,"_2424":50203},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2886":2338,"_27469":2318,"_18854":50205,"_5":12679,"_25963":50149,"_2424":50206},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2886":2339,"_27469":2318,"_18854":50208,"_5":12679,"_25963":50153,"_2424":50209},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2886":2340,"_27469":2318,"_18854":50211,"_5":12679,"_25963":50157,"_2424":50212},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2886":2341,"_27469":2318,"_18854":50214,"_5":12679,"_25963":50161,"_2424":50215},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2886":2342,"_27469":2318,"_18854":50217,"_5":12679,"_25963":50161,"_2424":50218},[],"Also run the chart's connectivity test:",{"_2886":2343,"_27469":2318,"_18854":50220,"_5":12679,"_25963":50161,"_2424":50221},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2886":2344,"_27469":2318,"_18854":50223,"_5":12679,"_25963":50161,"_2424":50224},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2886":2345,"_27469":2318,"_18854":50226,"_5":12679,"_25963":50165,"_2424":50227},[],"If you receive a 401:",{"_2886":2346,"_27469":2318,"_18854":50229,"_5":12679,"_25963":50165,"_2424":50230},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2886":2347,"_27469":2318,"_18854":50232,"_5":12679,"_25963":50165,"_2424":50233},[],"verify issuer, audience and expiration of the token;",{"_2886":2348,"_27469":2318,"_18854":50235,"_5":12679,"_25963":50165,"_2424":50236},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2886":2349,"_27469":2318,"_18854":50238,"_5":12679,"_25963":50165,"_2424":50239},[],"check that the provider's public and internal routes point to the same realm.",{"_2886":2350,"_27469":2318,"_18854":50241,"_5":12679,"_25963":50165,"_2424":50242},[],"If login succeeds but the APIs return 403:",{"_2886":2351,"_27469":2318,"_18854":50244,"_5":12679,"_25963":50165,"_2424":50245},[],"inspect the token's real claims;",{"_2886":2352,"_27469":2318,"_18854":50247,"_5":12679,"_25963":50165,"_2424":50248},[],"confirm they match an active principal;",{"_2886":2353,"_27469":2318,"_18854":50250,"_5":12679,"_25963":50165,"_2424":50251},[],"review the policies granted to that principal;",{"_2886":2354,"_27469":2318,"_18854":50253,"_5":12679,"_25963":50165,"_2424":50254},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2886":2355,"_27469":2318,"_18854":50256,"_5":12679,"_25963":50165,"_2424":50257},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2886":2356,"_27469":2318,"_18854":50259,"_5":12679,"_25963":50169,"_2424":50260},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2886":2357,"_27469":2318,"_18854":50262,"_5":12679,"_25963":50169,"_2424":50263},[],"Locate the authz pod and Service.",{"_2886":2358,"_27469":2318,"_18854":50265,"_5":12679,"_25963":50169,"_2424":50266},[],"Check /health, logs and its database connection.",{"_2886":2359,"_27469":2318,"_18854":50268,"_5":12679,"_25963":50169,"_2424":50269},[],"Verify the DNS and port configured in externalAuthorization.",{"_2886":2360,"_27469":2318,"_18854":50271,"_5":12679,"_25963":50169,"_2424":50272},[],"Check the check route is /v1/ext\\_authz/check.",{"_2886":2361,"_27469":2318,"_18854":50274,"_5":12679,"_25963":50169,"_2424":50275},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2886":2362,"_27469":2318,"_18854":50277,"_5":12679,"_25963":50173,"_2424":50278},[],"Review kubectl describe pod first. Common causes are:",{"_2886":2363,"_27469":2318,"_18854":50280,"_5":12679,"_25963":50173,"_2424":50281},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2886":2364,"_27469":2318,"_18854":50283,"_5":12679,"_25963":50173,"_2424":50284},[],"unbound persistent volume;",{"_2886":2365,"_27469":2318,"_18854":50286,"_5":12679,"_25963":50173,"_2424":50287},[],"inaccessible image or incorrect pull policy;",{"_2886":2366,"_27469":2318,"_18854":50289,"_5":12679,"_25963":50173,"_2424":50290},[],"invalid cryptographic engine configuration;",{"_2886":2367,"_27469":2318,"_18854":50292,"_5":12679,"_25963":50173,"_2424":50293},[],"CPU or memory limits set too low;",{"_2886":2368,"_27469":2318,"_18854":50295,"_5":12679,"_25963":50173,"_2424":50296},[],"an incomplete prior migration.",{"_2886":2369,"_27469":2318,"_18854":50298,"_5":12679,"_25963":50173,"_2424":50299},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2886":2370,"_27469":2318,"_18854":50301,"_5":12679,"_25963":50173,"_2424":50302},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2886":2371,"_27469":2318,"_18854":50304,"_5":12679,"_25963":50177,"_2424":50305},[],"Narrow the error following this order:",{"_2886":2372,"_27469":2318,"_18854":50307,"_5":12679,"_25963":50177,"_2424":50308},[],"The CA exists, is active and has not expired.",{"_2886":2373,"_27469":2318,"_18854":50310,"_5":12679,"_25963":50177,"_2424":50311},[],"The CA has a usable private key and the engine is available.",{"_2886":2374,"_27469":2318,"_18854":50313,"_5":12679,"_25963":50177,"_2424":50314},[],"The CSR has a valid signature.",{"_2886":2375,"_27469":2318,"_18854":50316,"_5":12679,"_25963":50177,"_2424":50317},[],"The profile allows the key type and size.",{"_2886":2376,"_27469":2318,"_18854":50319,"_5":12679,"_25963":50177,"_2424":50320},[],"The requested validity fits within the CA's lifetime.",{"_2886":2377,"_27469":2318,"_18854":50322,"_5":12679,"_25963":50177,"_2424":50323},[],"KU, EKU, subject and extensions comply with the profile.",{"_2886":2378,"_27469":2318,"_18854":50325,"_5":12679,"_25963":50177,"_2424":50326},[],"If the reissuance of a CA fails, remember it is not supported for a revoked or already-expired CA. To change its key, follow CA hierarchy and rotation.",{"_2886":2379,"_27469":2318,"_18854":50328,"_5":12679,"_25963":50181,"_2424":50329},[],"Check:",{"_2886":2380,"_27469":2318,"_18854":50331,"_5":12679,"_25963":50181,"_2424":50332},[],"the DMS identifier in the EST path;",{"_2886":2381,"_27469":2318,"_18854":50334,"_5":12679,"_25963":50181,"_2424":50335},[],"the configured authentication method;",{"_2886":2382,"_27469":2318,"_18854":50337,"_5":12679,"_25963":50181,"_2424":50338},[],"the chain presented by the client;",{"_2886":2383,"_27469":2318,"_18854":50340,"_5":12679,"_25963":50181,"_2424":50341},[],"the validation CAs and the level limit;",{"_2886":2384,"_27469":2318,"_18854":50343,"_5":12679,"_25963":50181,"_2424":50344},[],"the revocation status of the client certificate;",{"_2886":2385,"_27469":2318,"_18854":50346,"_5":12679,"_25963":50181,"_2424":50347},[],"the CSR signature;",{"_2886":2386,"_27469":2318,"_18854":50349,"_5":12679,"_25963":50181,"_2424":50350},[],"the CA and profile used for issuance;",{"_2886":2387,"_27469":2318,"_18854":50352,"_5":12679,"_25963":50181,"_2424":50353},[],"the re-enrollment window.",{"_2886":2388,"_27469":2318,"_18854":50355,"_5":12679,"_25963":50181,"_2424":50356},[],"During re-enrollment, Lamassu first tries to validate with the enrollment CA and then with the additional CAs. During a migration, keep the old CA in that second set until the overlap ends.",{"_2886":2389,"_27469":2318,"_18854":50358,"_5":12679,"_25963":50185,"_2424":50359},[],"Confirm the revocation was persisted and has reason and timestamp.",{"_2886":2390,"_27469":2318,"_18854":50361,"_5":12679,"_25963":50185,"_2424":50362},[],"Review VA configuration and logs.",{"_2886":2391,"_27469":2318,"_18854":50364,"_5":12679,"_25963":50185,"_2424":50365},[],"Check the CRL's periodicity and next update.",{"_2886":2392,"_27469":2318,"_18854":50367,"_5":12679,"_25963":50185,"_2424":50368},[],"Rule out intermediate caches in proxy and client.",{"_2886":2393,"_27469":2318,"_18854":50370,"_5":12679,"_25963":50185,"_2424":50371},[],"Verify the certificate points to the endpoint you are querying.",{"_2886":2394,"_27469":2318,"_18854":50373,"_5":12679,"_25963":50185,"_2424":50374},[],"Query by the correct serial number and issuer.",{"_2886":2395,"_27469":2318,"_18854":50376,"_5":12679,"_25963":50189,"_2424":50377},[],"Domain and audit events depend on the bus publisher:",{"_2886":2396,"_27469":2318,"_18854":50379,"_5":12679,"_25963":50189,"_2424":50380},[],"verify it is enabled in the emitting service;",{"_2886":2397,"_27469":2318,"_18854":50382,"_5":12679,"_25963":50189,"_2424":50383},[],"check AMQP connectivity and credentials;",{"_2886":2398,"_27469":2318,"_18854":50385,"_5":12679,"_25963":50189,"_2424":50386},[],"review exchange, routing key, queues and consumers;",{"_2886":2399,"_27469":2318,"_18854":50388,"_5":12679,"_25963":50189,"_2424":50389},[],"inspect dead-letter queues;",{"_2886":2400,"_27469":2318,"_18854":50391,"_5":12679,"_25963":50189,"_2424":50392},[],"alert on orphan durable queues and backlog growth.",{"_2886":2401,"_27469":2318,"_18854":50394,"_5":12679,"_25963":50189,"_2424":50395},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2886":2402,"_27469":2318,"_18854":50397,"_5":12679,"_25963":50193,"_2424":50398},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2886":2403,"_27469":2318,"_18854":50400,"_5":12679,"_25963":50193,"_2424":50401},[],"Before closing an incident, record:",{"_2886":2404,"_27469":2318,"_18854":50403,"_5":12679,"_25963":50193,"_2424":50404},[],"the confirmed cause;",{"_2886":2405,"_27469":2318,"_18854":50406,"_5":12679,"_25963":50193,"_2424":50407},[],"the time scope and affected resources;",{"_2886":2406,"_27469":2318,"_18854":50409,"_5":12679,"_25963":50193,"_2424":50410},[],"the commands or queries used;",{"_2886":2407,"_27469":2318,"_18854":50412,"_5":12679,"_25963":50193,"_2424":50413},[],"the applied change and how to revert it;",{"_2886":2408,"_27469":2318,"_18854":50415,"_5":12679,"_25963":50193,"_2424":50416},[],"validation from a consumer;",{"_2886":2409,"_27469":2318,"_18854":50418,"_5":12679,"_25963":50193,"_2424":50419},[],"the preventive action and its owner.",{"_2886":2410,"_27469":2410,"_5":13057,"_2424":50421,"_18854":50422,"_25963":2410},"Test",[],{"_2886":2411,"_27469":2410,"_18854":50424,"_5":12679,"_25963":2410,"_2424":50425},[],"A document to test Fumadocs",{"_2886":2412,"_27469":2410,"_5":27746,"_18854":50427,"_25963":50428,"_2424":50429},[],"/docs/pr-preview/pr-24/test#cards","Cards",{"_2886":2413,"_27469":2410,"_5":27746,"_18854":50431,"_25963":50432,"_2424":50433},[],"/docs/pr-preview/pr-24/test#codeblock","CodeBlock",{"_2886":2414,"_27469":2410,"_5":27746,"_18854":50435,"_25963":50436,"_2424":50437},[],"/docs/pr-preview/pr-24/test#list","List",{"_2886":2415,"_27469":2410,"_18854":50439,"_5":12679,"_25963":2410,"_2424":50440},[],"Hey there!",{"_2886":2416,"_27469":2410,"_18854":50442,"_5":12679,"_25963":50428,"_2424":50443},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_2886":2417,"_27469":2410,"_18854":50445,"_5":12679,"_25963":50428,"_2424":50446},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_2886":2418,"_27469":2410,"_18854":50448,"_5":12679,"_25963":50436,"_2424":50449},[],"Hello",{"_2886":2419,"_27469":2410,"_18854":50451,"_5":12679,"_25963":50436,"_2424":50452},[],"World","sorting",{"_13351":50455,"_50456":50457,"_50458":50459,"_50460":50461,"_16221":2441,"_60095":2441},"english","sortableProperties",[2424,27469,5,25963],"sortablePropertiesWithTypes",{"_2424":22534,"_27469":22534,"_5":22534,"_25963":22534},"sorts",{"_2424":50462,"_27469":52871,"_5":55279,"_25963":57687},{"_3880":50463,"_50464":50465,"_5":22534},{"_7308":3350,"_8032":26527,"_13142":3024,"_26062":7137,"_9039":2490,"_17772":18951,"_12819":17361,"_12846":3399,"_8051":2719,"_26966":2791,"_26981":2752,"_26544":5745,"_30932":18124,"_26986":26745,"_26655":4933,"_27000":4929,"_27015":9827,"_30943":3968,"_26991":6062,"_21456":5795,"_21462":3339,"_27321":9665,"_27337":3508,"_13138":5761,"_30954":2703,"_30957":6109,"_30959":6211,"_27021":2716,"_27298":4012,"_27360":4285,"_30964":6404,"_30966":4461,"_30968":20958,"_30970":2617,"_30972":12754,"_30974":2638,"_30976":11213,"_30978":