":52600,"_38655":52603,"_38657":52606,"_38659":52609,"_38661":52612,"_38663":52615,"_38665":52618,"_38667":52621,"_38669":52624,"_38671":52627,"_38673":52630,"_30316":52633,"_38676":52636,"_38678":52639,"_38680":52642,"_38682":52645,"_38684":52648,"_38686":52651,"_38688":52654,"_38690":52657,"_38692":52660,"_38694":52663,"_38696":52666,"_38698":52669,"_38700":52672,"_38702":52675,"_38704":52678,"_38706":52681,"_38708":52684,"_38710":52687,"_38712":52690,"_38714":52693,"_38716":52696,"_38718":52699,"_38720":52702,"_38722":52705,"_38724":52708,"_38726":52711,"_38728":52714,"_38730":52718,"_38732":52722,"_38734":52726,"_38736":52729,"_38738":52732,"_38740":52735,"_38742":52738},{"_5620":11,"_30634":11,"_5":30895,"_2302":45665,"_30908":45666,"_25947":45670,"_12136":11},"Despliega desde AWS Marketplace",[45667,45668,45669],"Docs","Despliegue","Otros modelos",[],{"_5620":12,"_30634":11,"_25947":45672,"_5":30900,"_12136":11,"_2302":45673},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_5620":13,"_30634":11,"_5":30905,"_25947":45675,"_12136":45676,"_2302":45677},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_5620":14,"_30634":11,"_5":30905,"_25947":45679,"_12136":45680,"_2302":45681},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_5620":15,"_30634":11,"_5":30905,"_25947":45683,"_12136":45684,"_2302":45685},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_5620":16,"_30634":11,"_5":30905,"_25947":45687,"_12136":45688,"_2302":45689},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_5620":17,"_30634":11,"_5":30905,"_25947":45691,"_12136":45692,"_2302":45693},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_5620":18,"_30634":11,"_5":30905,"_25947":45695,"_12136":45696,"_2302":45697},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_5620":19,"_30634":11,"_5":30905,"_25947":45699,"_12136":45700,"_2302":45701},[],"/docs/pr-preview/pr-24/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_5620":20,"_30634":11,"_25947":45703,"_5":30900,"_12136":11,"_2302":45704},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_5620":21,"_30634":11,"_25947":45706,"_5":30900,"_12136":45676,"_2302":45707},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_5620":22,"_30634":11,"_25947":45709,"_5":30900,"_12136":45676,"_2302":45710},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_5620":23,"_30634":11,"_25947":45712,"_5":30900,"_12136":45676,"_2302":45713},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_5620":24,"_30634":11,"_25947":45715,"_5":30900,"_12136":45680,"_2302":45716},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_5620":25,"_30634":11,"_25947":45718,"_5":30900,"_12136":45680,"_2302":45719},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_5620":26,"_30634":11,"_25947":45721,"_5":30900,"_12136":45680,"_2302":45722},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_5620":27,"_30634":11,"_25947":45724,"_5":30900,"_12136":45684,"_2302":45725},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_5620":28,"_30634":11,"_25947":45727,"_5":30900,"_12136":45688,"_2302":45728},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_5620":29,"_30634":11,"_25947":45730,"_5":30900,"_12136":45692,"_2302":45731},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_5620":30,"_30634":11,"_25947":45733,"_5":30900,"_12136":45696,"_2302":45734},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_5620":31,"_30634":11,"_25947":45736,"_5":30900,"_12136":45700,"_2302":45737},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_5620":32,"_30634":32,"_5":30895,"_2302":45739,"_30908":45740,"_25947":45741,"_12136":32},"Despliega Lamassu",[45667,45668],[],{"_5620":33,"_30634":32,"_25947":45743,"_5":30900,"_12136":32,"_2302":45744},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_5620":34,"_30634":32,"_5":30905,"_25947":45746,"_12136":45747,"_2302":45748},[],"/docs/pr-preview/pr-24/deployment/overview#elige-un-modelo","Elige un modelo",{"_5620":35,"_30634":32,"_5":30905,"_25947":45750,"_12136":45751,"_2302":45752},[],"/docs/pr-preview/pr-24/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_5620":36,"_30634":32,"_5":30905,"_25947":45754,"_12136":45755,"_2302":45756},[],"/docs/pr-preview/pr-24/deployment/overview#después-del-despliegue","Después del despliegue",{"_5620":37,"_30634":32,"_25947":45758,"_5":30900,"_12136":32,"_2302":45759},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_5620":38,"_30634":32,"_25947":45761,"_5":30900,"_12136":45747,"_2302":45762},[],"Modelo",{"_5620":39,"_30634":32,"_25947":45764,"_5":30900,"_12136":45747,"_2302":45765},[],"Recomendado para",{"_5620":40,"_30634":32,"_25947":45767,"_5":30900,"_12136":45747,"_2302":45768},[],"Quién opera la infraestructura",{"_5620":41,"_30634":32,"_25947":45770,"_5":30900,"_12136":45747,"_2302":45771},[],"Punto de partida",{"_5620":42,"_30634":32,"_25947":45773,"_5":30900,"_12136":45747,"_2302":45774},[],"Kubernetes self-managed",{"_5620":43,"_30634":32,"_25947":45776,"_5":30900,"_12136":45747,"_2302":45777},[],"Producción, entornos regulados y despliegues personalizados",{"_5620":44,"_30634":32,"_25947":45779,"_5":30900,"_12136":45747,"_2302":45780},[],"Tu equipo",{"_5620":45,"_30634":32,"_25947":45782,"_5":30900,"_12136":45747,"_2302":45783},[],"Helm o Fastlane",{"_5620":46,"_30634":32,"_25947":45785,"_5":30900,"_12136":45747,"_2302":45786},[],"AWS Marketplace",{"_5620":47,"_30634":32,"_25947":45788,"_5":30900,"_12136":45747,"_2302":45789},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_5620":48,"_30634":32,"_25947":45791,"_5":30900,"_12136":45747,"_2302":45780},[],{"_5620":49,"_30634":32,"_25947":45793,"_5":30900,"_12136":45747,"_2302":45794},[],"Imagen preconfigurada en EC2",{"_5620":50,"_30634":32,"_25947":45796,"_5":30900,"_12136":45747,"_2302":45797},[],"SaaS",{"_5620":51,"_30634":32,"_25947":45799,"_5":30900,"_12136":45747,"_2302":45800},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_5620":52,"_30634":32,"_25947":45802,"_5":30900,"_12136":45747,"_2302":45803},[],"Lamassu",{"_5620":53,"_30634":32,"_25947":45805,"_5":30900,"_12136":45747,"_2302":45806},[],"Suscripción gestionada",{"_5620":54,"_30634":32,"_25947":45808,"_5":30900,"_12136":45747,"_2302":45809},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_5620":55,"_30634":32,"_25947":45811,"_5":30900,"_12136":45747,"_2302":45812},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_5620":56,"_30634":32,"_25947":45814,"_5":30900,"_12136":45747,"_2302":45815},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_5620":57,"_30634":32,"_25947":45817,"_5":30900,"_12136":45751,"_2302":45818},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_5620":58,"_30634":32,"_25947":45820,"_5":30900,"_12136":45755,"_2302":45821},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_5620":59,"_30634":59,"_5":30895,"_2302":45823,"_30908":45824,"_25947":45825,"_12136":59},"Utiliza Lamassu como SaaS",[45667,45668,45669],[],{"_5620":60,"_30634":59,"_25947":45827,"_5":30900,"_12136":59,"_2302":45828},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_5620":61,"_30634":59,"_5":30905,"_25947":45830,"_12136":45831,"_2302":45832},[],"/docs/pr-preview/pr-24/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_5620":62,"_30634":59,"_5":30905,"_25947":45834,"_12136":45835,"_2302":45836},[],"/docs/pr-preview/pr-24/deployment/saas#planes","Planes",{"_5620":63,"_30634":59,"_5":30905,"_25947":45838,"_12136":45839,"_2302":45840},[],"/docs/pr-preview/pr-24/deployment/saas#solicita-acceso","Solicita acceso",{"_5620":64,"_30634":59,"_25947":45842,"_5":30900,"_12136":59,"_2302":45843},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_5620":65,"_30634":59,"_25947":45845,"_5":30900,"_12136":45831,"_2302":45846},[],"Disponibilidad y mantenimiento de la plataforma.",{"_5620":66,"_30634":59,"_25947":45848,"_5":30900,"_12136":45831,"_2302":45849},[],"Copias de seguridad automáticas.",{"_5620":67,"_30634":59,"_25947":45851,"_5":30900,"_12136":45831,"_2302":45852},[],"Actualizaciones de versión.",{"_5620":68,"_30634":59,"_25947":45854,"_5":30900,"_12136":45831,"_2302":45855},[],"Soporte técnico y SLA según el plan contratado.",{"_5620":69,"_30634":59,"_25947":45857,"_5":30900,"_12136":45835,"_2302":45858},[],"Plan",{"_5620":70,"_30634":59,"_25947":45860,"_5":30900,"_12136":45835,"_2302":45861},[],"Dispositivos",{"_5620":71,"_30634":59,"_25947":45863,"_5":30900,"_12136":45835,"_2302":45864},[],"Soporte",{"_5620":72,"_30634":59,"_25947":45866,"_5":30900,"_12136":45835,"_2302":45867},[],"SLA",{"_5620":73,"_30634":59,"_25947":45869,"_5":30900,"_12136":45835,"_2302":45870},[],"Starter",{"_5620":74,"_30634":59,"_25947":45872,"_5":30900,"_12136":45835,"_2302":45873},[],"Hasta 1.000",{"_5620":75,"_30634":59,"_25947":45875,"_5":30900,"_12136":45835,"_2302":45876},[],"Email",{"_5620":76,"_30634":59,"_25947":45878,"_5":30900,"_12136":45835,"_2302":45879},[],"99,5 %",{"_5620":77,"_30634":59,"_25947":45881,"_5":30900,"_12136":45835,"_2302":45882},[],"Professional",{"_5620":78,"_30634":59,"_25947":45884,"_5":30900,"_12136":45835,"_2302":45885},[],"Hasta 10.000",{"_5620":79,"_30634":59,"_25947":45887,"_5":30900,"_12136":45835,"_2302":45888},[],"Email y chat",{"_5620":80,"_30634":59,"_25947":45890,"_5":30900,"_12136":45835,"_2302":45891},[],"99,9 %",{"_5620":81,"_30634":59,"_25947":45893,"_5":30900,"_12136":45835,"_2302":45894},[],"Enterprise",{"_5620":82,"_30634":59,"_25947":45896,"_5":30900,"_12136":45835,"_2302":45897},[],"Ilimitados",{"_5620":83,"_30634":59,"_25947":45899,"_5":30900,"_12136":45835,"_2302":45900},[],"Dedicado",{"_5620":84,"_30634":59,"_25947":45902,"_5":30900,"_12136":45835,"_2302":45903},[],"99,99 %",{"_5620":85,"_30634":59,"_25947":45905,"_5":30900,"_12136":45839,"_2302":45906},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_5620":86,"_30634":59,"_25947":45908,"_5":30900,"_12136":45839,"_2302":45909},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_5620":87,"_30634":87,"_5":30895,"_2302":45911,"_30908":45912,"_25947":45913,"_12136":87},"Fastlane",[45667,45668,45774],[],{"_5620":88,"_30634":87,"_25947":45915,"_5":30900,"_12136":87,"_2302":45916},[],"Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes",{"_5620":89,"_30634":87,"_5":30905,"_25947":45918,"_12136":45919,"_2302":45920},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#fastlane---despliegue-automatizado-en-kubernetes","Fastlane - Despliegue automatizado en Kubernetes",{"_5620":90,"_30634":87,"_5":30905,"_25947":45922,"_12136":45923,"_2302":45924},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#flags-de-línea-de-comandos","Flags de línea de comandos",{"_5620":91,"_30634":87,"_5":30905,"_25947":45926,"_12136":45927,"_2302":45928},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#detección-de-distribución-kubernetes","Detección de distribución Kubernetes",{"_5620":92,"_30634":87,"_5":30905,"_25947":45930,"_12136":45931,"_2302":45932},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#verificación-de-dependencias","Verificación de dependencias",{"_5620":93,"_30634":87,"_5":30905,"_25947":45934,"_12136":45935,"_2302":45936},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#addons-obligatorios-en-microk8s","Addons obligatorios en MicroK8s",{"_5620":94,"_30634":87,"_5":30905,"_25947":45938,"_12136":45939,"_2302":45940},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#modo-interactivo-vs-no-interactivo","Modo interactivo vs no interactivo",{"_5620":95,"_30634":87,"_5":30905,"_25947":45942,"_12136":45943,"_2302":45944},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#modo-interactivo-por-defecto","Modo interactivo (por defecto)",{"_5620":96,"_30634":87,"_5":30905,"_25947":45946,"_12136":45947,"_2302":45948},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_5620":97,"_30634":87,"_5":30905,"_25947":45950,"_12136":45951,"_2302":45952},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#modo-online-vs-offline","Modo online vs offline",{"_5620":98,"_30634":87,"_5":30905,"_25947":45954,"_12136":45955,"_2302":45956},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_5620":99,"_30634":87,"_5":30905,"_25947":45958,"_12136":45959,"_2302":45960},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#modo-offline","Modo offline",{"_5620":100,"_30634":87,"_5":30905,"_25947":45962,"_12136":45963,"_2302":45964},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#instalación-de-componentes","Instalación de componentes",{"_5620":101,"_30634":87,"_5":30905,"_25947":45966,"_12136":45967,"_2302":45968},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_5620":102,"_30634":87,"_5":30905,"_25947":45970,"_12136":45971,"_2302":45972},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_5620":103,"_30634":87,"_5":30905,"_25947":45974,"_12136":45975,"_2302":45976},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_5620":104,"_30634":87,"_5":30905,"_25947":45978,"_12136":45979,"_2302":45980},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_5620":105,"_30634":87,"_5":30905,"_25947":45982,"_12136":45983,"_2302":45984},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#configuración-tls","Configuración TLS",{"_5620":106,"_30634":87,"_5":30905,"_25947":45986,"_12136":45987,"_2302":45988},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#certificado-externo","Certificado externo",{"_5620":107,"_30634":87,"_5":30905,"_25947":45990,"_12136":45991,"_2302":45992},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_5620":108,"_30634":87,"_5":30905,"_25947":45994,"_12136":45995,"_2302":45996},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_5620":109,"_30634":87,"_5":30905,"_25947":45998,"_12136":45999,"_2302":46000},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#uso-en-ci","Uso en CI",{"_5620":110,"_30634":87,"_5":30905,"_25947":46002,"_12136":46003,"_2302":46004},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#ejemplo-rápido","Ejemplo rápido",{"_5620":111,"_30634":87,"_5":30905,"_25947":46006,"_12136":46007,"_2302":46008},[],"/docs/pr-preview/pr-24/deployment/self-hosted/fastlane#resumen","Resumen",{"_5620":112,"_30634":87,"_25947":46010,"_5":30900,"_12136":45919,"_2302":46011},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_5620":113,"_30634":87,"_25947":46013,"_5":30900,"_12136":45919,"_2302":46014},[],"La instalación incluye:",{"_5620":114,"_30634":87,"_25947":46016,"_5":30900,"_12136":45919,"_2302":46017},[],"PostgreSQL",{"_5620":115,"_30634":87,"_25947":46019,"_5":30900,"_12136":45919,"_2302":46020},[],"Keycloak",{"_5620":116,"_30634":87,"_25947":46022,"_5":30900,"_12136":45919,"_2302":46023},[],"RabbitMQ",{"_5620":117,"_30634":87,"_25947":46025,"_5":30900,"_12136":45919,"_2302":46026},[],"Chart Helm de Lamassu",{"_5620":118,"_30634":87,"_25947":46028,"_5":30900,"_12136":45923,"_2302":46029},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_5620":119,"_30634":87,"_25947":46031,"_5":30900,"_12136":45923,"_2302":46032},[],"Flag",{"_5620":120,"_30634":87,"_25947":46034,"_5":30900,"_12136":45923,"_2302":46035},[],"Valor por defecto",{"_5620":121,"_30634":87,"_25947":46037,"_5":30900,"_12136":45923,"_2302":46038},[],"Descripción",{"_5620":122,"_30634":87,"_25947":46040,"_5":30900,"_12136":45923,"_2302":46041},[],"`-h`, `--help`",{"_5620":123,"_30634":87,"_25947":46043,"_5":30900,"_12136":45923,"_2302":4492},[],{"_5620":124,"_30634":87,"_25947":46045,"_5":30900,"_12136":45923,"_2302":46046},[],"Muestra la ayuda y finaliza",{"_5620":125,"_30634":87,"_25947":46048,"_5":30900,"_12136":45923,"_2302":46049},[],"`-n`, `--non-interactive`",{"_5620":126,"_30634":87,"_25947":46051,"_5":30900,"_12136":45923,"_2302":46052},[],"`false`",{"_5620":127,"_30634":87,"_25947":46054,"_5":30900,"_12136":45923,"_2302":46055},[],"Omite prompts y genera/usa credenciales por defecto",{"_5620":128,"_30634":87,"_25947":46057,"_5":30900,"_12136":45923,"_2302":46058},[],"`-ns`, `--namespace`",{"_5620":129,"_30634":87,"_25947":46060,"_5":30900,"_12136":45923,"_2302":46061},[],"`lamassu-dev`",{"_5620":130,"_30634":87,"_25947":46063,"_5":30900,"_12136":45923,"_2302":46064},[],"Namespace Kubernetes donde se despliegan los recursos",{"_5620":131,"_30634":87,"_25947":46066,"_5":30900,"_12136":45923,"_2302":46067},[],"`-d`, `--domain`",{"_5620":132,"_30634":87,"_25947":46069,"_5":30900,"_12136":45923,"_2302":46070},[],"`dev.lamassu.io`",{"_5620":133,"_30634":87,"_25947":46072,"_5":30900,"_12136":45923,"_2302":46073},[],"Dominio usado para endpoint y certificados TLS",{"_5620":134,"_30634":87,"_25947":46075,"_5":30900,"_12136":45923,"_2302":46076},[],"`-v`, `--version`",{"_5620":135,"_30634":87,"_25947":46078,"_5":30900,"_12136":45923,"_2302":46079},[],"`latest`",{"_5620":136,"_30634":87,"_25947":46081,"_5":30900,"_12136":45923,"_2302":46082},[],"Versión del chart Helm de Lamassu",{"_5620":137,"_30634":87,"_25947":46084,"_5":30900,"_12136":45923,"_2302":46085},[],"`--https-port`",{"_5620":138,"_30634":87,"_25947":46087,"_5":30900,"_12136":45923,"_2302":46088},[],"`443`",{"_5620":139,"_30634":87,"_25947":46090,"_5":30900,"_12136":45923,"_2302":46091},[],"Puerto HTTPS del gateway",{"_5620":140,"_30634":87,"_25947":46093,"_5":30900,"_12136":45923,"_2302":46094},[],"`--http-port`",{"_5620":141,"_30634":87,"_25947":46096,"_5":30900,"_12136":45923,"_2302":46097},[],"`80`",{"_5620":142,"_30634":87,"_25947":46099,"_5":30900,"_12136":45923,"_2302":46100},[],"Puerto HTTP del gateway",{"_5620":143,"_30634":87,"_25947":46102,"_5":30900,"_12136":45923,"_2302":46103},[],"`--offline`",{"_5620":144,"_30634":87,"_25947":46105,"_5":30900,"_12136":45923,"_2302":46052},[],{"_5620":145,"_30634":87,"_25947":46107,"_5":30900,"_12136":45923,"_2302":46108},[],"Activa modo offline",{"_5620":146,"_30634":87,"_25947":46110,"_5":30900,"_12136":45923,"_2302":46111},[],"`--tls-crt`",{"_5620":147,"_30634":87,"_25947":46113,"_5":30900,"_12136":45923,"_2302":4492},[],{"_5620":148,"_30634":87,"_25947":46115,"_5":30900,"_12136":45923,"_2302":46116},[],"Ruta al certificado TLS (PEM)",{"_5620":149,"_30634":87,"_25947":46118,"_5":30900,"_12136":45923,"_2302":46119},[],"`--tls-key`",{"_5620":150,"_30634":87,"_25947":46121,"_5":30900,"_12136":45923,"_2302":4492},[],{"_5620":151,"_30634":87,"_25947":46123,"_5":30900,"_12136":45923,"_2302":46124},[],"Ruta a la clave privada TLS (PEM)",{"_5620":152,"_30634":87,"_25947":46126,"_5":30900,"_12136":45923,"_2302":46127},[],"`--helm-chart-lamassu`",{"_5620":153,"_30634":87,"_25947":46129,"_5":30900,"_12136":45923,"_2302":4492},[],{"_5620":154,"_30634":87,"_25947":46131,"_5":30900,"_12136":45923,"_2302":46132},[],"Ruta a chart local Lamassu (`.tgz`)",{"_5620":155,"_30634":87,"_25947":46134,"_5":30900,"_12136":45923,"_2302":46135},[],"`--helm-chart-postgres`",{"_5620":156,"_30634":87,"_25947":46137,"_5":30900,"_12136":45923,"_2302":4492},[],{"_5620":157,"_30634":87,"_25947":46139,"_5":30900,"_12136":45923,"_2302":46140},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_5620":158,"_30634":87,"_25947":46142,"_5":30900,"_12136":45923,"_2302":46143},[],"`--helm-chart-keycloak`",{"_5620":159,"_30634":87,"_25947":46145,"_5":30900,"_12136":45923,"_2302":4492},[],{"_5620":160,"_30634":87,"_25947":46147,"_5":30900,"_12136":45923,"_2302":46148},[],"Ruta a chart local Keycloak (`.tgz`)",{"_5620":161,"_30634":87,"_25947":46150,"_5":30900,"_12136":45923,"_2302":46151},[],"`--helm-chart-rabbitmq`",{"_5620":162,"_30634":87,"_25947":46153,"_5":30900,"_12136":45923,"_2302":4492},[],{"_5620":163,"_30634":87,"_25947":46155,"_5":30900,"_12136":45923,"_2302":46156},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_5620":164,"_30634":87,"_25947":46158,"_5":30900,"_12136":45923,"_2302":46159},[],"`-l`, `--local-chart-path`",{"_5620":165,"_30634":87,"_25947":46161,"_5":30900,"_12136":45923,"_2302":4492},[],{"_5620":166,"_30634":87,"_25947":46163,"_5":30900,"_12136":45923,"_2302":46164},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_5620":167,"_30634":87,"_25947":46166,"_5":30900,"_12136":45927,"_2302":46167},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_5620":168,"_30634":87,"_25947":46169,"_5":30900,"_12136":45927,"_2302":46170},[],"`microk8s`",{"_5620":169,"_30634":87,"_25947":46172,"_5":30900,"_12136":45927,"_2302":46173},[],"`k3s`",{"_5620":170,"_30634":87,"_25947":46175,"_5":30900,"_12136":45927,"_2302":46176},[],"`kind`",{"_5620":171,"_30634":87,"_25947":46178,"_5":30900,"_12136":45927,"_2302":46179},[],"Kubernetes estándar",{"_5620":172,"_30634":87,"_25947":46181,"_5":30900,"_12136":45927,"_2302":46182},[],"Comportamientos específicos:",{"_5620":173,"_30634":87,"_25947":46184,"_5":30900,"_12136":45927,"_2302":46185},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_5620":174,"_30634":87,"_25947":46187,"_5":30900,"_12136":45927,"_2302":46188},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_5620":175,"_30634":87,"_25947":46190,"_5":30900,"_12136":45931,"_2302":46191},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_5620":176,"_30634":87,"_25947":46193,"_5":30900,"_12136":45931,"_2302":46194},[],"Requisitos generales:",{"_5620":177,"_30634":87,"_25947":46196,"_5":30900,"_12136":45931,"_2302":46197},[],"`yq`",{"_5620":178,"_30634":87,"_25947":46199,"_5":30900,"_12136":45931,"_2302":46200},[],"CLI de la distribución detectada",{"_5620":179,"_30634":87,"_25947":46202,"_5":30900,"_12136":45931,"_2302":46203},[],"Los requisitos específicos dependen de la distribución: `k3s` necesita `kubectl` y `helm`, mientras que `microk8s` utiliza `microk8s kubectl` y `microk8s helm`.",{"_5620":180,"_30634":87,"_25947":46205,"_5":30900,"_12136":45935,"_2302":46206},[],"Se valida que estén habilitados:",{"_5620":181,"_30634":87,"_25947":46208,"_5":30900,"_12136":45935,"_2302":46209},[],"`helm`",{"_5620":182,"_30634":87,"_25947":46211,"_5":30900,"_12136":45935,"_2302":46212},[],"`hostpath-storage`",{"_5620":183,"_30634":87,"_25947":46214,"_5":30900,"_12136":45935,"_2302":46215},[],"`dns`",{"_5620":184,"_30634":87,"_25947":46217,"_5":30900,"_12136":45935,"_2302":46218},[],"`cert-manager`",{"_5620":185,"_30634":87,"_25947":46220,"_5":30900,"_12136":45935,"_2302":46221},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_5620":186,"_30634":87,"_25947":46223,"_5":30900,"_12136":45943,"_2302":46224},[],"La función `request_config_data` solicita:",{"_5620":187,"_30634":87,"_25947":46226,"_5":30900,"_12136":45943,"_2302":46227},[],"Dominio Lamassu",{"_5620":188,"_30634":87,"_25947":46229,"_5":30900,"_12136":45943,"_2302":46230},[],"Usuario y contraseña admin PostgreSQL",{"_5620":189,"_30634":87,"_25947":46232,"_5":30900,"_12136":45943,"_2302":46233},[],"Usuario y contraseña admin RabbitMQ",{"_5620":190,"_30634":87,"_25947":46235,"_5":30900,"_12136":45943,"_2302":46236},[],"Usuario y contraseña admin Keycloak",{"_5620":191,"_30634":87,"_25947":46238,"_5":30900,"_12136":45943,"_2302":46239},[],"Namespace Kubernetes",{"_5620":192,"_30634":87,"_25947":46241,"_5":30900,"_12136":45947,"_2302":46242},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_5620":193,"_30634":87,"_25947":46244,"_5":30900,"_12136":45947,"_2302":46245},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_5620":194,"_30634":87,"_25947":46247,"_5":30900,"_12136":45951,"_2302":46248},[],"El script admite dos estrategias para obtener charts Helm.",{"_5620":195,"_30634":87,"_25947":46250,"_5":30900,"_12136":45955,"_2302":46251},[],"Los charts se descargan desde repositorios remotos.",{"_5620":196,"_30634":87,"_25947":46253,"_5":30900,"_12136":45959,"_2302":46254},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_5620":197,"_30634":87,"_25947":46256,"_5":30900,"_12136":45959,"_2302":46127},[],{"_5620":198,"_30634":87,"_25947":46258,"_5":30900,"_12136":45959,"_2302":46135},[],{"_5620":199,"_30634":87,"_25947":46260,"_5":30900,"_12136":45959,"_2302":46143},[],{"_5620":200,"_30634":87,"_25947":46262,"_5":30900,"_12136":45959,"_2302":46151},[],{"_5620":201,"_30634":87,"_25947":46264,"_5":30900,"_12136":45959,"_2302":46265},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_5620":202,"_30634":87,"_25947":46267,"_5":30900,"_12136":45959,"_2302":46268},[],"En este modo se fuerza:",{"_5620":203,"_30634":87,"_25947":46270,"_5":30900,"_12136":45967,"_2302":46271},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_5620":204,"_30634":87,"_25947":46273,"_5":30900,"_12136":45967,"_2302":46274},[],"Versión del chart: `0.19.0`",{"_5620":205,"_30634":87,"_25947":46276,"_5":30900,"_12136":45967,"_2302":46277},[],"Release: `postgres`",{"_5620":206,"_30634":87,"_25947":46279,"_5":30900,"_12136":45967,"_2302":46280},[],"`fullnameOverride: \"postgresql\"`",{"_5620":207,"_30634":87,"_25947":46282,"_5":30900,"_12136":45967,"_2302":46283},[],"El script SQL de inicialización crea una base de datos por servicio: `auth` para Keycloak, `alerts` para Alerts, `ca` para CA, `va` para VA, `cloudproxy` para Cloud Proxy, `devicemanager` para Device Manager, `dmsmanager` para DMS Manager y `kms` para KMS.",{"_5620":208,"_30634":87,"_25947":46285,"_5":30900,"_12136":45971,"_2302":46286},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_5620":209,"_30634":87,"_25947":46288,"_5":30900,"_12136":45971,"_2302":46289},[],"Versión del chart: `0.20.0`",{"_5620":210,"_30634":87,"_25947":46291,"_5":30900,"_12136":45971,"_2302":46292},[],"Release: `auth`",{"_5620":211,"_30634":87,"_25947":46294,"_5":30900,"_12136":45971,"_2302":46295},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_5620":212,"_30634":87,"_25947":46297,"_5":30900,"_12136":45971,"_2302":46298},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_5620":213,"_30634":87,"_25947":46300,"_5":30900,"_12136":45971,"_2302":46301},[],"`httpRelativePath: /auth/`",{"_5620":214,"_30634":87,"_25947":46303,"_5":30900,"_12136":45971,"_2302":46304},[],"`proxyHeaders: xforwarded`",{"_5620":215,"_30634":87,"_25947":46306,"_5":30900,"_12136":45971,"_2302":46307},[],"Configuración automática del realm `lamassu`:",{"_5620":216,"_30634":87,"_25947":46309,"_5":30900,"_12136":45971,"_2302":46310},[],"Rol: `pki-admin`",{"_5620":217,"_30634":87,"_25947":46312,"_5":30900,"_12136":45971,"_2302":46313},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_5620":218,"_30634":87,"_25947":46315,"_5":30900,"_12136":45971,"_2302":46316},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_5620":219,"_30634":87,"_25947":46318,"_5":30900,"_12136":45971,"_2302":46319},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_5620":220,"_30634":87,"_25947":46321,"_5":30900,"_12136":45971,"_2302":46322},[],"`github.com/lamassuiot/keycloak-theme`",{"_5620":221,"_30634":87,"_25947":46324,"_5":30900,"_12136":45975,"_2302":46325},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_5620":222,"_30634":87,"_25947":46327,"_5":30900,"_12136":45975,"_2302":46289},[],{"_5620":223,"_30634":87,"_25947":46329,"_5":30900,"_12136":45975,"_2302":46330},[],"Release: `rabbitmq`",{"_5620":224,"_30634":87,"_25947":46332,"_5":30900,"_12136":45975,"_2302":46333},[],"`fullnameOverride: \"rabbitmq\"`",{"_5620":225,"_30634":87,"_25947":46335,"_5":30900,"_12136":45975,"_2302":46336},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_5620":226,"_30634":87,"_25947":46338,"_5":30900,"_12136":45979,"_2302":46339},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_5620":227,"_30634":87,"_25947":46341,"_5":30900,"_12136":45979,"_2302":46342},[],"Configuraciones principales:",{"_5620":228,"_30634":87,"_25947":46344,"_5":30900,"_12136":45979,"_2302":46345},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_5620":229,"_30634":87,"_25947":46347,"_5":30900,"_12136":45979,"_2302":46348},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_5620":230,"_30634":87,"_25947":46350,"_5":30900,"_12136":45979,"_2302":46351},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_5620":231,"_30634":87,"_25947":46353,"_5":30900,"_12136":45979,"_2302":46354},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_5620":232,"_30634":87,"_25947":46356,"_5":30900,"_12136":45979,"_2302":46357},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_5620":233,"_30634":87,"_25947":46359,"_5":30900,"_12136":45979,"_2302":46360},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_5620":234,"_30634":87,"_25947":46362,"_5":30900,"_12136":45979,"_2302":46363},[],"Dominios CA: valor de `--domain`",{"_5620":235,"_30634":87,"_25947":46365,"_5":30900,"_12136":45979,"_2302":46366},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_5620":236,"_30634":87,"_25947":46368,"_5":30900,"_12136":45979,"_2302":46369},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_5620":237,"_30634":87,"_25947":46371,"_5":30900,"_12136":45979,"_2302":46372},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_5620":238,"_30634":87,"_25947":46374,"_5":30900,"_12136":45987,"_2302":46375},[],"Si se proporcionan:",{"_5620":239,"_30634":87,"_25947":46377,"_5":30900,"_12136":45987,"_2302":46111},[],{"_5620":240,"_30634":87,"_25947":46379,"_5":30900,"_12136":45987,"_2302":46119},[],{"_5620":241,"_30634":87,"_25947":46381,"_5":30900,"_12136":45987,"_2302":46382},[],"Se crea un secret Kubernetes:",{"_5620":242,"_30634":87,"_25947":46384,"_5":30900,"_12136":45987,"_2302":46385},[],"`downstream-provided-crt`",{"_5620":243,"_30634":87,"_25947":46387,"_5":30900,"_12136":45987,"_2302":46388},[],"Y se configura:",{"_5620":244,"_30634":87,"_25947":46390,"_5":30900,"_12136":45991,"_2302":46391},[],"Si no se proporciona certificado:",{"_5620":245,"_30634":87,"_25947":46393,"_5":30900,"_12136":45991,"_2302":46394},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_5620":246,"_30634":87,"_25947":46396,"_5":30900,"_12136":45991,"_2302":46397},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_5620":247,"_30634":87,"_25947":46399,"_5":30900,"_12136":45995,"_2302":46400},[],"En caso de éxito, se muestra:",{"_5620":248,"_30634":87,"_25947":46402,"_5":30900,"_12136":45995,"_2302":46403},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_5620":249,"_30634":87,"_25947":46405,"_5":30900,"_12136":45995,"_2302":46406},[],"Credenciales iniciales: `lamassu / lamassu`",{"_5620":250,"_30634":87,"_25947":46408,"_5":30900,"_12136":45995,"_2302":46409},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_5620":251,"_30634":87,"_25947":46411,"_5":30900,"_12136":45995,"_2302":46412},[],"Credenciales admin de Keycloak",{"_5620":252,"_30634":87,"_25947":46414,"_5":30900,"_12136":45995,"_2302":46415},[],"El usuario `lamassu` se crea con:",{"_5620":253,"_30634":87,"_25947":46417,"_5":30900,"_12136":45995,"_2302":46418},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_5620":254,"_30634":87,"_25947":46420,"_5":30900,"_12136":45995,"_2302":46421},[],"Fastlane también provisiona un principal de autorización `oidc:lamassu` que coincide con el claim `preferred_username=lamassu` y le concede la política `SUPER ADMIN`. Si activas los datos de ejemplo, crea además un principal independiente para la cuenta de servicio correspondiente.",{"_5620":255,"_30634":87,"_25947":46423,"_5":30900,"_12136":45995,"_2302":46424},[],"Este bootstrap está pensado para laboratorio, demos y CI. En producción, sustituye el principal por un rol o grupo administrado en tu proveedor OIDC y sigue Control de acceso.",{"_5620":256,"_30634":87,"_25947":46426,"_5":30900,"_12136":45999,"_2302":46427},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_5620":257,"_30634":87,"_25947":46429,"_5":30900,"_12136":45999,"_2302":46430},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_5620":258,"_30634":87,"_25947":46432,"_5":30900,"_12136":45999,"_2302":46433},[],"Ejemplo:",{"_5620":259,"_30634":87,"_25947":46435,"_5":30900,"_12136":45999,"_2302":46436},[],"En este escenario:",{"_5620":260,"_30634":87,"_25947":46438,"_5":30900,"_12136":45999,"_2302":46439},[],"`-n`: modo no interactivo",{"_5620":261,"_30634":87,"_25947":46441,"_5":30900,"_12136":45999,"_2302":46442},[],"`-ns`: namespace específico",{"_5620":262,"_30634":87,"_25947":46444,"_5":30900,"_12136":45999,"_2302":46445},[],"`-d`: dominio de CI",{"_5620":263,"_30634":87,"_25947":46447,"_5":30900,"_12136":45999,"_2302":46448},[],"`-l`: chart local",{"_5620":264,"_30634":87,"_25947":46450,"_5":30900,"_12136":46007,"_2302":46451},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_5620":265,"_30634":87,"_25947":46453,"_5":30900,"_12136":46007,"_2302":46454},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_5620":266,"_30634":266,"_5":30895,"_2302":45774,"_30908":46456,"_25947":46457,"_12136":266},[45667,45668,45774],[],{"_5620":267,"_30634":266,"_25947":46459,"_5":30900,"_12136":266,"_2302":46460},[],"Despliega Lamassu en tu propio clúster Kubernetes con Helm o Fastlane.",{"_5620":268,"_30634":266,"_5":30905,"_25947":46462,"_12136":46463,"_2302":46464},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_5620":269,"_30634":266,"_5":30905,"_25947":46466,"_12136":46467,"_2302":46468},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#quickstart","Quickstart",{"_5620":270,"_30634":266,"_5":30905,"_25947":46470,"_12136":46471,"_2302":46472},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#qué-se-despliega","Qué se despliega",{"_5620":271,"_30634":266,"_5":30905,"_25947":46474,"_12136":46475,"_2302":46476},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#requisitos-previos","Requisitos previos",{"_5620":272,"_30634":266,"_5":30905,"_25947":46478,"_12136":46479,"_2302":46480},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#opciones-de-despliegue","Opciones de despliegue",{"_5620":273,"_30634":266,"_5":30905,"_25947":46482,"_12136":46483,"_2302":46484},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_5620":274,"_30634":266,"_5":30905,"_25947":46486,"_12136":46487,"_2302":46488},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_5620":275,"_30634":266,"_5":30905,"_25947":46490,"_12136":46491,"_2302":46492},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#arquitectura","Arquitectura",{"_5620":276,"_30634":266,"_5":30905,"_25947":46494,"_12136":46495,"_2302":46496},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#instalación-manual-con-helm","Instalación manual con Helm",{"_5620":277,"_30634":266,"_5":30905,"_25947":46498,"_12136":46499,"_2302":46500},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_5620":278,"_30634":266,"_5":30905,"_25947":46502,"_12136":46503,"_2302":46504},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_5620":279,"_30634":266,"_5":30905,"_25947":46506,"_12136":46507,"_2302":46508},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_5620":280,"_30634":266,"_5":30905,"_25947":46510,"_12136":46511,"_2302":46512},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#verificación-del-despliegue","Verificación del despliegue",{"_5620":281,"_30634":266,"_5":30905,"_25947":46514,"_12136":46515,"_2302":46516},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#repositorio-helm","Repositorio Helm",{"_5620":282,"_30634":266,"_5":30905,"_25947":46518,"_12136":46519,"_2302":46520},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_5620":283,"_30634":266,"_5":30905,"_25947":46522,"_12136":46523,"_2302":46524},[],"/docs/pr-preview/pr-24/deployment/self-hosted/overview#versionado-y-migraciones","Versionado y migraciones",{"_5620":284,"_30634":266,"_25947":46526,"_5":30900,"_12136":46463,"_2302":46527},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_5620":285,"_30634":266,"_25947":46529,"_5":30900,"_12136":46463,"_2302":46530},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_5620":286,"_30634":266,"_25947":46532,"_5":30900,"_12136":46463,"_2302":46533},[],"el chart principal de Lamassu",{"_5620":287,"_30634":266,"_25947":46535,"_5":30900,"_12136":46463,"_2302":46536},[],"un chart auxiliar de SoftHSM",{"_5620":288,"_30634":266,"_25947":46538,"_5":30900,"_12136":46463,"_2302":46539},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_5620":289,"_30634":266,"_25947":46541,"_5":30900,"_12136":46467,"_2302":46542},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_5620":290,"_30634":266,"_25947":46544,"_5":30900,"_12136":46467,"_2302":46545},[],"Ese flujo:",{"_5620":291,"_30634":266,"_25947":46547,"_5":30900,"_12136":46467,"_2302":46548},[],"crea o reutiliza el namespace indicado",{"_5620":292,"_30634":266,"_25947":46550,"_5":30900,"_12136":46467,"_2302":46551},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_5620":293,"_30634":266,"_25947":46553,"_5":30900,"_12136":46467,"_2302":46554},[],"despliega el chart de Lamassu",{"_5620":294,"_30634":266,"_25947":46556,"_5":30900,"_12136":46467,"_2302":46557},[],"deja la UI expuesta en `https://<dominio>`",{"_5620":295,"_30634":266,"_25947":46559,"_5":30900,"_12136":46467,"_2302":46560},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_5620":296,"_30634":266,"_25947":46562,"_5":30900,"_12136":46471,"_2302":46563},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_5620":297,"_30634":266,"_25947":46565,"_5":30900,"_12136":46471,"_2302":46566},[],"`ui`",{"_5620":298,"_30634":266,"_25947":46568,"_5":30900,"_12136":46471,"_2302":46569},[],"`ca`",{"_5620":299,"_30634":266,"_25947":46571,"_5":30900,"_12136":46471,"_2302":46572},[],"`va`",{"_5620":300,"_30634":266,"_25947":46574,"_5":30900,"_12136":46471,"_2302":46575},[],"`kms`",{"_5620":301,"_30634":266,"_25947":46577,"_5":30900,"_12136":46471,"_2302":46578},[],"`device-manager`",{"_5620":302,"_30634":266,"_25947":46580,"_5":30900,"_12136":46471,"_2302":46581},[],"`dms-manager`",{"_5620":303,"_30634":266,"_25947":46583,"_5":30900,"_12136":46471,"_2302":46584},[],"`alerts`",{"_5620":304,"_30634":266,"_25947":46586,"_5":30900,"_12136":46471,"_2302":46587},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_5620":305,"_30634":266,"_25947":46589,"_5":30900,"_12136":46471,"_2302":46590},[],"job de migraciones de base de datos",{"_5620":306,"_30634":266,"_25947":46592,"_5":30900,"_12136":46475,"_2302":46593},[],"Clúster Kubernetes `1.19+`",{"_5620":307,"_30634":266,"_25947":46595,"_5":30900,"_12136":46475,"_2302":46596},[],"`kubectl` configurado con acceso al clúster",{"_5620":308,"_30634":266,"_25947":46598,"_5":30900,"_12136":46475,"_2302":46599},[],"Helm `3.2.0+`",{"_5620":309,"_30634":266,"_25947":46601,"_5":30900,"_12136":46475,"_2302":46602},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_5620":310,"_30634":266,"_25947":46604,"_5":30900,"_12136":46475,"_2302":46605},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_5620":311,"_30634":266,"_25947":46607,"_5":30900,"_12136":46475,"_2302":46608},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_5620":312,"_30634":266,"_25947":46610,"_5":30900,"_12136":46475,"_2302":46611},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_5620":313,"_30634":266,"_25947":46613,"_5":30900,"_12136":46479,"_2302":46614},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_5620":314,"_30634":266,"_25947":46616,"_5":30900,"_12136":46483,"_2302":46617},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_5620":315,"_30634":266,"_25947":46619,"_5":30900,"_12136":46487,"_2302":46620},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_5620":316,"_30634":266,"_25947":46622,"_5":30900,"_12136":46491,"_2302":46623},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_5620":317,"_30634":266,"_25947":46625,"_5":30900,"_12136":46491,"_2302":46626},[],"Dependencias externas requeridas por el chart principal:",{"_5620":318,"_30634":266,"_25947":46628,"_5":30900,"_12136":46491,"_2302":46017},[],{"_5620":319,"_30634":266,"_25947":46630,"_5":30900,"_12136":46491,"_2302":46023},[],{"_5620":320,"_30634":266,"_25947":46632,"_5":30900,"_12136":46491,"_2302":46633},[],"proveedor OIDC, típicamente Keycloak",{"_5620":321,"_30634":266,"_25947":46635,"_5":30900,"_12136":46491,"_2302":46636},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_5620":322,"_30634":266,"_25947":46638,"_5":30900,"_12136":46495,"_2302":46639},[],"Agregar el repositorio Helm:",{"_5620":323,"_30634":266,"_25947":46641,"_5":30900,"_12136":46495,"_2302":46642},[],"O instalar desde una copia local del repositorio:",{"_5620":324,"_30634":266,"_25947":46644,"_5":30900,"_12136":46499,"_2302":46645},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_5620":325,"_30634":266,"_25947":46647,"_5":30900,"_12136":46499,"_2302":46648},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_5620":326,"_30634":266,"_25947":46650,"_5":30900,"_12136":46499,"_2302":46651},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_5620":327,"_30634":266,"_25947":46653,"_5":30900,"_12136":46499,"_2302":46654},[],"`auth.oidc.frontend.authority`",{"_5620":328,"_30634":266,"_25947":46656,"_5":30900,"_12136":46499,"_2302":46657},[],"`auth.oidc.apiGateway.jwks`",{"_5620":329,"_30634":266,"_25947":46659,"_5":30900,"_12136":46499,"_2302":46660},[],"`services.authz.jwkUrl` y un principal de bootstrap que coincida con un administrador real",{"_5620":330,"_30634":266,"_25947":46662,"_5":30900,"_12136":46499,"_2302":46663},[],"`services.ca.domains`",{"_5620":331,"_30634":266,"_25947":46665,"_5":30900,"_12136":46499,"_2302":46666},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_5620":332,"_30634":266,"_25947":46668,"_5":30900,"_12136":46499,"_2302":46669},[],"`tls.*` según se use `certManager` o certificado externo",{"_5620":333,"_30634":266,"_25947":46671,"_5":30900,"_12136":46499,"_2302":46672},[],"Ejemplo base:",{"_5620":334,"_30634":266,"_25947":46674,"_5":30900,"_12136":46503,"_2302":46675},[],"No hay un superusuario implícito. Antes de instalar, crea el rol `pki-admin` en el proveedor OIDC y asígnalo al grupo que administrará Lamassu. El principal del ejemplo concede la política `SUPER ADMIN` a cualquier token que contenga ese rol.",{"_5620":335,"_30634":266,"_25947":46677,"_5":30900,"_12136":46503,"_2302":46678},[],"El Job `pre-install` y `pre-upgrade` prepara las bases de datos, ejecuta las migraciones de authz, precarga las políticas y aplica `services.authz.bootstrap` antes de que arranquen los Deployments. El bootstrap es idempotente: conserva los principales existentes y añade únicamente los grants que falten.",{"_5620":336,"_30634":266,"_25947":46680,"_5":30900,"_12136":46503,"_2302":46681},[],"Si ningún token coincide con un principal activo, nadie podrá administrar la PKI. Prueba una identidad autorizada y otra denegada, y conserva un procedimiento de recuperación.",{"_5620":337,"_30634":266,"_25947":46683,"_5":30900,"_12136":46503,"_2302":46684},[],"Consulta Control de acceso para diseñar principales y políticas.",{"_5620":338,"_30634":266,"_25947":46686,"_5":30900,"_12136":46507,"_2302":46687},[],"**TLS:** `tls.type`, `tls.certManagerOptions.*` y `tls.externalOptions.secretName` controlan el certificado *downstream* del Gateway.",{"_5620":339,"_30634":266,"_25947":46689,"_5":30900,"_12136":46507,"_2302":46690},[],"**Gateway:** `gateway.addresses`, `gateway.ports.*` y `gateway.extraRouting` publican la UI y las APIs mediante Envoy Gateway.",{"_5620":340,"_30634":266,"_25947":46692,"_5":30900,"_12136":46507,"_2302":46693},[],"**Persistencia:** `postgres.*` define la conexión a PostgreSQL.",{"_5620":341,"_30634":266,"_25947":46695,"_5":30900,"_12136":46507,"_2302":46696},[],"**Mensajería:** `amqp.*` configura la conexión a RabbitMQ.",{"_5620":342,"_30634":266,"_25947":46698,"_5":30900,"_12136":46507,"_2302":46699},[],"**Identidad y autorización:** `auth.oidc.*`, `services.authz.jwkUrl` y `services.authz.bootstrap` configuran login, validación JWT y permisos iniciales.",{"_5620":343,"_30634":266,"_25947":46701,"_5":30900,"_12136":46507,"_2302":46702},[],"**Autoridades:** `services.ca.domains` establece los dominios autorizados para CA y certificados.",{"_5620":344,"_30634":266,"_25947":46704,"_5":30900,"_12136":46507,"_2302":46705},[],"**Claves:** `services.kms.cryptoEngines.*` configura los motores criptográficos y su almacenamiento.",{"_5620":345,"_30634":266,"_25947":46707,"_5":30900,"_12136":46507,"_2302":46708},[],"**Alertas:** `services.alerts.smtp_server.*` prepara el envío de correo.",{"_5620":346,"_30634":266,"_25947":46710,"_5":30900,"_12136":46511,"_2302":46711},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_5620":347,"_30634":266,"_25947":46713,"_5":30900,"_12136":46511,"_2302":46714},[],"La prueba comprueba al menos:",{"_5620":348,"_30634":266,"_25947":46716,"_5":30900,"_12136":46511,"_2302":46717},[],"salud de `ca`",{"_5620":349,"_30634":266,"_25947":46719,"_5":30900,"_12136":46511,"_2302":46720},[],"salud de `dms-manager`",{"_5620":350,"_30634":266,"_25947":46722,"_5":30900,"_12136":46511,"_2302":46723},[],"salud de `device-manager`",{"_5620":351,"_30634":266,"_25947":46725,"_5":30900,"_12136":46511,"_2302":46726},[],"salud de `va`",{"_5620":352,"_30634":266,"_25947":46728,"_5":30900,"_12136":46511,"_2302":46729},[],"respuesta HTML esperada del servicio `ui`",{"_5620":353,"_30634":266,"_25947":46731,"_5":30900,"_12136":46515,"_2302":46732},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_5620":354,"_30634":266,"_25947":46734,"_5":30900,"_12136":46515,"_2302":46735},[],"`charts/lamassu`: chart principal de Lamassu",{"_5620":355,"_30634":266,"_25947":46737,"_5":30900,"_12136":46515,"_2302":46738},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_5620":356,"_30634":266,"_25947":46740,"_5":30900,"_12136":46515,"_2302":46741},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_5620":357,"_30634":266,"_25947":46743,"_5":30900,"_12136":46519,"_2302":46744},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_5620":358,"_30634":266,"_25947":46746,"_5":30900,"_12136":46523,"_2302":46747},[],"La versión actual del chart en el repositorio es `3.8.0`. Para upgrades entre versiones, consulta las guías de `charts/lamassu/CHANGELOG/` y revisa especialmente las migraciones de base de datos y el bootstrap de authz.",{"_5620":359,"_30634":359,"_5":30895,"_2302":46749,"_30908":46750,"_25947":46753,"_12136":359},"Control de acceso",[45667,46751,46752],"Plataforma","Administrar Lamassu",[],{"_5620":360,"_30634":359,"_25947":46755,"_5":30900,"_12136":359,"_2302":46756},[],"Conecta una identidad OIDC o X.509 con principales, políticas y permisos de Lamassu.",{"_5620":361,"_30634":359,"_5":30905,"_25947":46758,"_12136":46759,"_2302":46760},[],"/docs/pr-preview/pr-24/platform/pki/access-control#cómo-se-toma-una-decisión","Cómo se toma una decisión",{"_5620":362,"_30634":359,"_5":30905,"_25947":46762,"_12136":46763,"_2302":46764},[],"/docs/pr-preview/pr-24/platform/pki/access-control#principales","Principales",{"_5620":363,"_30634":359,"_5":30905,"_25947":46766,"_12136":46767,"_2302":46768},[],"/docs/pr-preview/pr-24/platform/pki/access-control#políticas","Políticas",{"_5620":364,"_30634":359,"_5":30905,"_25947":46770,"_12136":46771,"_2302":46504},[],"/docs/pr-preview/pr-24/platform/pki/access-control#provisiona-el-primer-administrador",{"_5620":365,"_30634":359,"_5":30905,"_25947":46773,"_12136":46774,"_2302":46775},[],"/docs/pr-preview/pr-24/platform/pki/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_5620":366,"_30634":359,"_5":30905,"_25947":46777,"_12136":46778,"_2302":46779},[],"/docs/pr-preview/pr-24/platform/pki/access-control#operación-segura","Operación segura",{"_5620":367,"_30634":359,"_5":30905,"_25947":46781,"_12136":46782,"_2302":46783},[],"/docs/pr-preview/pr-24/platform/pki/access-control#diagnóstico-rápido","Diagnóstico rápido",{"_5620":368,"_30634":359,"_25947":46785,"_5":30900,"_12136":359,"_2302":46786},[],"Lamassu separa autenticación y autorización. El proveedor OIDC o el certificado cliente demuestra quién realiza la petición; el servicio authz relaciona esa identidad con uno o varios principales y decide qué acciones están permitidas.",{"_5620":369,"_30634":359,"_25947":46788,"_5":30900,"_12136":46759,"_2302":46789},[],"El Gateway valida la autenticación configurada, normalmente un JWT mediante JWKS.",{"_5620":370,"_30634":359,"_25947":46791,"_5":30900,"_12136":46759,"_2302":46792},[],"Envoy envía la petición al endpoint de autorización externa /v1/ext\\_authz/check.",{"_5620":371,"_30634":359,"_25947":46794,"_5":30900,"_12136":46759,"_2302":46795},[],"authz compara las credenciales con principales activos.",{"_5620":372,"_30634":359,"_25947":46797,"_5":30900,"_12136":46759,"_2302":46798},[],"Reúne las políticas concedidas a los principales coincidentes.",{"_5620":373,"_30634":359,"_25947":46800,"_5":30900,"_12136":46759,"_2302":46801},[],"Evalúa la acción HTTP o el recurso solicitado y permite o deniega.",{"_5620":374,"_30634":359,"_25947":46803,"_5":30900,"_12136":46759,"_2302":46804},[],"Por defecto, auth.externalAuthorization.failOpen es false. Si authz no responde, el Gateway bloquea la petición protegida.",{"_5620":375,"_30634":359,"_25947":46806,"_5":30900,"_12136":46763,"_2302":46807},[],"Un principal representa una identidad autorizable, no necesariamente una persona individual. Tiene un identificador estable, nombre, tipo, configuración de coincidencia, estado activo y políticas concedidas.",{"_5620":376,"_30634":359,"_25947":46809,"_5":30900,"_12136":46763,"_2302":46810},[],"Lamassu admite dos tipos:",{"_5620":377,"_30634":359,"_25947":46812,"_5":30900,"_12136":46763,"_2302":46813},[],"**oidc**: coincide con claims de un token, por ejemplo un rol, grupo o preferred\\_username.",{"_5620":378,"_30634":359,"_25947":46815,"_5":30900,"_12136":46763,"_2302":46816},[],"**x509**: coincide con una identidad autenticada mediante certificado y su configuración de confianza.",{"_5620":379,"_30634":359,"_25947":46818,"_5":30900,"_12136":46763,"_2302":46819},[],"Diseña los principales alrededor de identidades estables del proveedor. Para administración humana suele ser preferible un grupo o rol gestionado centralmente; para automatización, usa una identidad técnica independiente.",{"_5620":380,"_30634":359,"_25947":46821,"_5":30900,"_12136":46767,"_2302":46822},[],"Una política agrupa reglas reutilizables. Las reglas pueden:",{"_5620":381,"_30634":359,"_25947":46824,"_5":30900,"_12136":46767,"_2302":46825},[],"permitir acciones sobre un tipo de entidad;",{"_5620":382,"_30634":359,"_25947":46827,"_5":30900,"_12136":46767,"_2302":46828},[],"limitar el acceso a identificadores concretos;",{"_5620":383,"_30634":359,"_25947":46830,"_5":30900,"_12136":46767,"_2302":46831},[],"seguir relaciones entre entidades;",{"_5620":384,"_30634":359,"_25947":46833,"_5":30900,"_12136":46767,"_2302":46834},[],"aplicar filtros por atributos;",{"_5620":385,"_30634":359,"_25947":46836,"_5":30900,"_12136":46767,"_2302":46837},[],"conceder acciones HTTP lógicas definidas por el esquema de una API.",{"_5620":386,"_30634":359,"_25947":46839,"_5":30900,"_12136":46767,"_2302":46840},[],"La acción \\* en una regla HTTP concede todas las acciones definidas por ese esquema. Resérvala para roles administrativos controlados.",{"_5620":387,"_30634":359,"_25947":46842,"_5":30900,"_12136":46771,"_2302":46843},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la PKI. Define el bootstrap y configura el IdP antes de exponer la plataforma.",{"_5620":388,"_30634":359,"_25947":46845,"_5":30900,"_12136":46771,"_2302":46846},[],"El chart crea por defecto un principal que busca el rol OIDC pki-admin en realm\\_access.roles y le concede las políticas de administración incluidas. El Job Helm de preinstalación y preactualización ejecuta las migraciones de authz, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios.",{"_5620":389,"_30634":359,"_25947":46848,"_5":30900,"_12136":46771,"_2302":46849},[],"Antes de instalar:",{"_5620":390,"_30634":359,"_25947":46851,"_5":30900,"_12136":46771,"_2302":46852},[],"Crea el rol pki-admin en tu proveedor OIDC.",{"_5620":391,"_30634":359,"_25947":46854,"_5":30900,"_12136":46771,"_2302":46855},[],"Asígnalo a un grupo administrativo pequeño y verificable.",{"_5620":392,"_30634":359,"_25947":46857,"_5":30900,"_12136":46771,"_2302":46858},[],"Configura la URL JWKS interna que alcanzará authz.",{"_5620":393,"_30634":359,"_25947":46860,"_5":30900,"_12136":46771,"_2302":46861},[],"Mantén al menos dos identidades humanas de recuperación.",{"_5620":394,"_30634":359,"_25947":46863,"_5":30900,"_12136":46771,"_2302":46864},[],"Prueba acceso permitido y denegado con usuarios distintos.",{"_5620":395,"_30634":359,"_25947":46866,"_5":30900,"_12136":46771,"_2302":46867},[],"El bootstrap es idempotente: si el principal ya existe, no lo reemplaza; solo añade las políticas configuradas que todavía falten. Por eso puedes mantenerlo en values.yaml durante las actualizaciones.",{"_5620":396,"_30634":359,"_25947":46869,"_5":30900,"_12136":46774,"_2302":46870},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario lamassu con contraseña temporal lamassu, rol pki-admin y acción obligatoria de cambio de contraseña. Su principal de bootstrap coincide por preferred\\_username=lamassu.",{"_5620":397,"_30634":359,"_25947":46872,"_5":30900,"_12136":46774,"_2302":46873},[],"Cambia la contraseña en el primer acceso. No reutilices este usuario ni el IdP de ejemplo como diseño de producción.",{"_5620":398,"_30634":359,"_25947":46875,"_5":30900,"_12136":46778,"_2302":46876},[],"Concede políticas a grupos o identidades técnicas, no a claims ambiguos.",{"_5620":399,"_30634":359,"_25947":46878,"_5":30900,"_12136":46778,"_2302":46879},[],"Desactiva un principal cuando deba perder acceso de inmediato.",{"_5620":400,"_30634":359,"_25947":46881,"_5":30900,"_12136":46778,"_2302":46882},[],"Separa administración de PKI, operación de dispositivos y automatizaciones.",{"_5620":401,"_30634":359,"_25947":46884,"_5":30900,"_12136":46778,"_2302":46885},[],"Revisa los grants tras cambios en el proveedor OIDC.",{"_5620":402,"_30634":359,"_25947":46887,"_5":30900,"_12136":46778,"_2302":46888},[],"Mantén failOpen: false salvo una decisión de riesgo explícita.",{"_5620":403,"_30634":359,"_25947":46890,"_5":30900,"_12136":46778,"_2302":46891},[],"Conserva un procedimiento probado para recuperar acceso sin desactivar autorización.",{"_5620":404,"_30634":359,"_25947":46893,"_5":30900,"_12136":46782,"_2302":46894},[],"Un 401 suele indicar que el Gateway no pudo validar la autenticación. Revisa emisor, audiencia, expiración y JWKS.",{"_5620":405,"_30634":359,"_25947":46896,"_5":30900,"_12136":46782,"_2302":46897},[],"Un 403 indica normalmente que la identidad se autenticó, pero ningún principal activo y sus políticas autorizaron la acción. Comprueba claims reales del token, regla de coincidencia, grants y acción solicitada.",{"_5620":406,"_30634":359,"_25947":46899,"_5":30900,"_12136":46782,"_2302":46900},[],"Si todas las rutas protegidas fallan, verifica la salud y conectividad de authz, su acceso a PostgreSQL y la URL JWKS. Continúa con Resolución de problemas.",{"_5620":407,"_30634":407,"_5":30895,"_2302":46902,"_30908":46903,"_25947":46905,"_12136":407},"Alertas y suscripciones",[45667,46751,46904],"Operar Lamassu",[],{"_5620":408,"_30634":407,"_25947":46907,"_5":30900,"_12136":407,"_2302":46908},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_5620":409,"_30634":407,"_5":30905,"_25947":46910,"_12136":46911,"_2302":46912},[],"/docs/pr-preview/pr-24/platform/pki/alerts#cómo-funciona","Cómo funciona",{"_5620":410,"_30634":407,"_5":30905,"_25947":46914,"_12136":46915,"_2302":46916},[],"/docs/pr-preview/pr-24/platform/pki/alerts#canales-disponibles","Canales disponibles",{"_5620":411,"_30634":407,"_5":30905,"_25947":46918,"_12136":46919,"_2302":46920},[],"/docs/pr-preview/pr-24/platform/pki/alerts#crea-una-suscripción","Crea una suscripción",{"_5620":412,"_30634":407,"_5":30905,"_25947":46922,"_12136":46923,"_2302":46924},[],"/docs/pr-preview/pr-24/platform/pki/alerts#elige-el-evento","Elige el evento",{"_5620":413,"_30634":407,"_5":30905,"_25947":46926,"_12136":46927,"_2302":46928},[],"/docs/pr-preview/pr-24/platform/pki/alerts#configura-el-destino","Configura el destino",{"_5620":414,"_30634":407,"_5":30905,"_25947":46930,"_12136":46931,"_2302":46932},[],"/docs/pr-preview/pr-24/platform/pki/alerts#limita-las-notificaciones","Limita las notificaciones",{"_5620":415,"_30634":407,"_5":30905,"_25947":46934,"_12136":46935,"_2302":46936},[],"/docs/pr-preview/pr-24/platform/pki/alerts#revisa-y-activa","Revisa y activa",{"_5620":416,"_30634":407,"_5":30905,"_25947":46938,"_12136":46939,"_2302":46940},[],"/docs/pr-preview/pr-24/platform/pki/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_5620":417,"_30634":407,"_5":30905,"_25947":46942,"_12136":46943,"_2302":46944},[],"/docs/pr-preview/pr-24/platform/pki/alerts#familias-de-eventos","Familias de eventos",{"_5620":418,"_30634":407,"_25947":46946,"_5":30900,"_12136":407,"_2302":46947},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_5620":419,"_30634":407,"_25947":46949,"_5":30900,"_12136":46911,"_2302":46950},[],"Un servicio publica un evento de dominio.",{"_5620":420,"_30634":407,"_25947":46952,"_5":30900,"_12136":46911,"_2302":46953},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_5620":421,"_30634":407,"_25947":46955,"_5":30900,"_12136":46911,"_2302":46956},[],"El filtro de cada suscripción decide si debe notificarse.",{"_5620":422,"_30634":407,"_25947":46958,"_5":30900,"_12136":46911,"_2302":46959},[],"Lamassu entrega el evento al canal configurado.",{"_5620":423,"_30634":407,"_25947":46961,"_5":30900,"_12136":46911,"_2302":46962},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_5620":424,"_30634":407,"_25947":46964,"_5":30900,"_12136":46915,"_2302":46965},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_5620":425,"_30634":407,"_25947":46967,"_5":30900,"_12136":46915,"_2302":46968},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_5620":426,"_30634":407,"_25947":46970,"_5":30900,"_12136":46915,"_2302":46971},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_5620":427,"_30634":407,"_25947":46973,"_5":30900,"_12136":46923,"_2302":46974},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_5620":428,"_30634":407,"_25947":46976,"_5":30900,"_12136":46927,"_2302":46977},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_5620":429,"_30634":407,"_25947":46979,"_5":30900,"_12136":46931,"_2302":46980},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_5620":430,"_30634":407,"_25947":46982,"_5":30900,"_12136":46931,"_2302":46983},[],"**None** notifica todas las instancias del evento.",{"_5620":431,"_30634":407,"_25947":46985,"_5":30900,"_12136":46931,"_2302":46986},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_5620":432,"_30634":407,"_25947":46988,"_5":30900,"_12136":46931,"_2302":46989},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_5620":433,"_30634":407,"_25947":46991,"_5":30900,"_12136":46931,"_2302":46992},[],"**JavaScript** permite expresar lógica personalizada.",{"_5620":434,"_30634":407,"_25947":46994,"_5":30900,"_12136":46931,"_2302":46995},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_5620":435,"_30634":407,"_25947":46997,"_5":30900,"_12136":46935,"_2302":46998},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_5620":436,"_30634":407,"_25947":47000,"_5":30900,"_12136":46939,"_2302":47001},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_5620":437,"_30634":407,"_25947":47003,"_5":30900,"_12136":46943,"_2302":47004},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_5620":438,"_30634":407,"_25947":47006,"_5":30900,"_12136":46943,"_2302":47007},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_5620":439,"_30634":407,"_25947":47009,"_5":30900,"_12136":46943,"_2302":47010},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_5620":440,"_30634":407,"_25947":47012,"_5":30900,"_12136":46943,"_2302":47013},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_5620":441,"_30634":407,"_25947":47015,"_5":30900,"_12136":46943,"_2302":47016},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_5620":442,"_30634":407,"_25947":47018,"_5":30900,"_12136":46943,"_2302":47019},[],"**Validación:** `va.role.crl.create`.",{"_5620":443,"_30634":407,"_25947":47021,"_5":30900,"_12136":46943,"_2302":47022},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_5620":444,"_30634":407,"_25947":47024,"_5":30900,"_12136":46943,"_2302":47025},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_5620":445,"_30634":445,"_5":30895,"_2302":47027,"_30908":47028,"_25947":47029,"_12136":445},"Registros de auditoría",[45667,46751,46752],[],{"_5620":446,"_30634":445,"_25947":47031,"_5":30900,"_12136":445,"_2302":47032},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_5620":447,"_30634":445,"_5":30905,"_25947":47034,"_12136":47035,"_2302":47036},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_5620":448,"_30634":445,"_5":30905,"_25947":47038,"_12136":47039,"_2302":47040},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#cobertura","Cobertura",{"_5620":449,"_30634":445,"_5":30905,"_25947":47042,"_12136":47043,"_2302":47044},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_5620":450,"_30634":445,"_5":30905,"_25947":47046,"_12136":47047,"_2302":47048},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#datos-sensibles","Datos sensibles",{"_5620":451,"_30634":445,"_5":30905,"_25947":47050,"_12136":47051,"_2302":47052},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_5620":452,"_30634":445,"_5":30905,"_25947":47054,"_12136":47055,"_2302":47056},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#acota-el-intervalo","Acota el intervalo",{"_5620":453,"_30634":445,"_5":30905,"_25947":47058,"_12136":47059,"_2302":47060},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#identifica-la-operación","Identifica la operación",{"_5620":454,"_30634":445,"_5":30905,"_25947":47062,"_12136":47063,"_2302":47064},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#atribuye-el-principal","Atribuye el principal",{"_5620":455,"_30634":445,"_5":30905,"_25947":47066,"_12136":47067,"_2302":47068},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_5620":456,"_30634":445,"_5":30905,"_25947":47070,"_12136":47071,"_2302":47072},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#sigue-el-efecto","Sigue el efecto",{"_5620":457,"_30634":445,"_5":30905,"_25947":47074,"_12136":47075,"_2302":47076},[],"/docs/pr-preview/pr-24/platform/pki/audit-logs#verificación-periódica","Verificación periódica",{"_5620":458,"_30634":445,"_25947":47078,"_5":30900,"_12136":445,"_2302":47079},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_5620":459,"_30634":445,"_25947":47081,"_5":30900,"_12136":47035,"_2302":47082},[],"El cuerpo de auditoría incluye:",{"_5620":460,"_30634":445,"_25947":47084,"_5":30900,"_12136":47035,"_2302":47085},[],"input: datos recibidos por la operación;",{"_5620":461,"_30634":445,"_25947":47087,"_5":30900,"_12136":47035,"_2302":47088},[],"has\\_error: indica si el servicio devolvió un error;",{"_5620":462,"_30634":445,"_25947":47090,"_5":30900,"_12136":47035,"_2302":47091},[],"output: resultado producido o mensaje de error;",{"_5620":463,"_30634":445,"_25947":47093,"_5":30900,"_12136":47035,"_2302":47094},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_5620":464,"_30634":445,"_25947":47096,"_5":30900,"_12136":47035,"_2302":47097},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_5620":465,"_30634":445,"_25947":47099,"_5":30900,"_12136":47035,"_2302":47100},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_5620":466,"_30634":445,"_25947":47102,"_5":30900,"_12136":47039,"_2302":47103},[],"El backend aplica auditoría a mutaciones de:",{"_5620":467,"_30634":445,"_25947":47105,"_5":30900,"_12136":47039,"_2302":47106},[],"autoridades, certificados y perfiles de emisión;",{"_5620":468,"_30634":445,"_25947":47108,"_5":30900,"_12136":47039,"_2302":47109},[],"claves y motores KMS;",{"_5620":469,"_30634":445,"_25947":47111,"_5":30900,"_12136":47039,"_2302":47112},[],"dispositivos e identidades;",{"_5620":470,"_30634":445,"_25947":47114,"_5":30900,"_12136":47039,"_2302":47115},[],"DMS y operaciones de enrolamiento;",{"_5620":471,"_30634":445,"_25947":47117,"_5":30900,"_12136":47039,"_2302":47118},[],"funciones de validación y CRL;",{"_5620":472,"_30634":445,"_25947":47120,"_5":30900,"_12136":47039,"_2302":47121},[],"principales, políticas y concesiones de autorización.",{"_5620":473,"_30634":445,"_25947":47123,"_5":30900,"_12136":47039,"_2302":47124},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_5620":474,"_30634":445,"_25947":47126,"_5":30900,"_12136":47043,"_2302":47127},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_5620":475,"_30634":445,"_25947":47129,"_5":30900,"_12136":47043,"_2302":47130},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_5620":476,"_30634":445,"_25947":47132,"_5":30900,"_12136":47043,"_2302":47133},[],"Diseña el consumidor para:",{"_5620":477,"_30634":445,"_25947":47135,"_5":30900,"_12136":47043,"_2302":47136},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_5620":478,"_30634":445,"_25947":47138,"_5":30900,"_12136":47043,"_2302":47139},[],"conservar el CloudEvent completo sin modificar;",{"_5620":479,"_30634":445,"_25947":47141,"_5":30900,"_12136":47043,"_2302":47142},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_5620":480,"_30634":445,"_25947":47144,"_5":30900,"_12136":47043,"_2302":47145},[],"cifrar en tránsito y en reposo;",{"_5620":481,"_30634":445,"_25947":47147,"_5":30900,"_12136":47043,"_2302":47148},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_5620":482,"_30634":445,"_25947":47150,"_5":30900,"_12136":47043,"_2302":47151},[],"aplicar una política explícita de retención y legal hold;",{"_5620":483,"_30634":445,"_25947":47153,"_5":30900,"_12136":47043,"_2302":47154},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_5620":484,"_30634":445,"_25947":47156,"_5":30900,"_12136":47047,"_2302":47157},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_5620":485,"_30634":445,"_25947":47159,"_5":30900,"_12136":47047,"_2302":47160},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_5620":486,"_30634":445,"_25947":47162,"_5":30900,"_12136":47055,"_2302":47163},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_5620":487,"_30634":445,"_25947":47165,"_5":30900,"_12136":47059,"_2302":47166},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_5620":488,"_30634":445,"_25947":47168,"_5":30900,"_12136":47063,"_2302":47169},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_5620":489,"_30634":445,"_25947":47171,"_5":30900,"_12136":47067,"_2302":47172},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_5620":490,"_30634":445,"_25947":47174,"_5":30900,"_12136":47071,"_2302":47175},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_5620":491,"_30634":445,"_25947":47177,"_5":30900,"_12136":47075,"_2302":47178},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_5620":492,"_30634":445,"_25947":47180,"_5":30900,"_12136":47075,"_2302":47181},[],"aparece un evento de auditoría correcto;",{"_5620":493,"_30634":445,"_25947":47183,"_5":30900,"_12136":47075,"_2302":47184},[],"el principal coincide con la identidad utilizada;",{"_5620":494,"_30634":445,"_25947":47186,"_5":30900,"_12136":47075,"_2302":47187},[],"el consumidor lo persiste una sola vez;",{"_5620":495,"_30634":445,"_25947":47189,"_5":30900,"_12136":47075,"_2302":47190},[],"puede recuperarse por recurso, actor y periodo;",{"_5620":496,"_30634":445,"_25947":47192,"_5":30900,"_12136":47075,"_2302":47193},[],"una interrupción del consumidor produce una alerta.",{"_5620":497,"_30634":445,"_25947":47195,"_5":30900,"_12136":47075,"_2302":47196},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_5620":498,"_30634":498,"_5":30895,"_2302":47198,"_30908":47199,"_25947":47200,"_12136":498},"Jerarquía y rotación de CAs",[45667,46751,46904],[],{"_5620":499,"_30634":498,"_25947":47202,"_5":30900,"_12136":498,"_2302":47203},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_5620":500,"_30634":498,"_5":30905,"_25947":47205,"_12136":47206,"_2302":47207},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_5620":501,"_30634":498,"_5":30905,"_25947":47209,"_12136":47210,"_2302":47211},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_5620":502,"_30634":498,"_5":30905,"_25947":47213,"_12136":47214,"_2302":47215},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_5620":503,"_30634":498,"_5":30905,"_25947":47217,"_12136":47218,"_2302":47219},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_5620":504,"_30634":498,"_5":30905,"_25947":47221,"_12136":47222,"_2302":47223},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_5620":505,"_30634":498,"_5":30905,"_25947":47225,"_12136":47226,"_2302":47227},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_5620":506,"_30634":498,"_5":30905,"_25947":47229,"_12136":47230,"_2302":47231},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_5620":507,"_30634":498,"_5":30905,"_25947":47233,"_12136":47234,"_2302":47235},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_5620":508,"_30634":498,"_5":30905,"_25947":47237,"_12136":47238,"_2302":47239},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_5620":509,"_30634":498,"_5":30905,"_25947":47241,"_12136":47242,"_2302":47243},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_5620":510,"_30634":498,"_5":30905,"_25947":47245,"_12136":47246,"_2302":47247},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_5620":511,"_30634":498,"_5":30905,"_25947":47249,"_12136":47250,"_2302":47251},[],"/docs/pr-preview/pr-24/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_5620":512,"_30634":498,"_25947":47253,"_5":30900,"_12136":498,"_2302":47254},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_5620":513,"_30634":498,"_25947":47256,"_5":30900,"_12136":47206,"_2302":47257},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_5620":514,"_30634":498,"_25947":47259,"_5":30900,"_12136":47206,"_2302":47260},[],"entorno, como producción y preproducción;",{"_5620":515,"_30634":498,"_25947":47262,"_5":30900,"_12136":47206,"_2302":47263},[],"propietario o equipo operador;",{"_5620":516,"_30634":498,"_25947":47265,"_5":30900,"_12136":47206,"_2302":47266},[],"familia de dispositivos o proceso de fabricación;",{"_5620":517,"_30634":498,"_25947":47268,"_5":30900,"_12136":47206,"_2302":47269},[],"región o requisito regulatorio;",{"_5620":518,"_30634":498,"_25947":47271,"_5":30900,"_12136":47206,"_2302":47272},[],"motor criptográfico o política de clave;",{"_5620":519,"_30634":498,"_25947":47274,"_5":30900,"_12136":47206,"_2302":47275},[],"ventana de mantenimiento y ritmo de renovación.",{"_5620":520,"_30634":498,"_25947":47277,"_5":30900,"_12136":47206,"_2302":47278},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_5620":521,"_30634":498,"_25947":47280,"_5":30900,"_12136":47206,"_2302":47281},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_5620":522,"_30634":498,"_25947":47283,"_5":30900,"_12136":47210,"_2302":47284},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_5620":523,"_30634":498,"_25947":47286,"_5":30900,"_12136":47210,"_2302":47287},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_5620":524,"_30634":498,"_25947":47289,"_5":30900,"_12136":47210,"_2302":47290},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_5620":525,"_30634":498,"_25947":47292,"_5":30900,"_12136":47214,"_2302":47293},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_5620":526,"_30634":498,"_25947":47295,"_5":30900,"_12136":47214,"_2302":47296},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_5620":527,"_30634":498,"_25947":47298,"_5":30900,"_12136":47214,"_2302":47299},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_5620":528,"_30634":498,"_25947":47301,"_5":30900,"_12136":47214,"_2302":47302},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_5620":529,"_30634":498,"_25947":47304,"_5":30900,"_12136":47222,"_2302":47305},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_5620":530,"_30634":498,"_25947":47307,"_5":30900,"_12136":47226,"_2302":47308},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_5620":531,"_30634":498,"_25947":47310,"_5":30900,"_12136":47230,"_2302":47311},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. En un DMS, utiliza las CAs gestionadas de `/cacerts` para mantener temporalmente las cadenas antigua y nueva.",{"_5620":532,"_30634":498,"_25947":47313,"_5":30900,"_12136":47234,"_2302":47314},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_5620":533,"_30634":498,"_25947":47316,"_5":30900,"_12136":47238,"_2302":47317},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_5620":534,"_30634":498,"_25947":47319,"_5":30900,"_12136":47242,"_2302":47320},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_5620":535,"_30634":498,"_25947":47322,"_5":30900,"_12136":47246,"_2302":47323},[],"Al revocar una CA, Lamassu actualiza también sus CAs hijas y certificados emitidos a `REVOKED` con razón `CessationOfOperation`. Las revocaciones de las hijas propagan el efecto a sus propias ramas.",{"_5620":536,"_30634":498,"_25947":47325,"_5":30900,"_12136":47246,"_2302":47326},[],"Esto protege la coherencia de la jerarquía, pero convierte la revocación en una acción de gran impacto. No la utilices como mecanismo ordinario para dejar de emitir: primero completa la migración y elimina la CA de los flujos operativos.",{"_5620":537,"_30634":498,"_25947":47328,"_5":30900,"_12136":47250,"_2302":47329},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_5620":538,"_30634":498,"_25947":47331,"_5":30900,"_12136":47250,"_2302":47332},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_5620":539,"_30634":498,"_25947":47334,"_5":30900,"_12136":47250,"_2302":47335},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_5620":540,"_30634":498,"_25947":47337,"_5":30900,"_12136":47250,"_2302":47338},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_5620":541,"_30634":498,"_25947":47340,"_5":30900,"_12136":47250,"_2302":47341},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_5620":542,"_30634":498,"_25947":47343,"_5":30900,"_12136":47250,"_2302":47344},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_5620":543,"_30634":498,"_25947":47346,"_5":30900,"_12136":47250,"_2302":47347},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_5620":544,"_30634":544,"_5":30895,"_2302":47349,"_30908":47350,"_25947":47351,"_12136":544},"Autoridades de certificación",[45667,46751,46904],[],{"_5620":545,"_30634":544,"_25947":47353,"_5":30900,"_12136":544,"_2302":47354},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_5620":546,"_30634":544,"_5":30905,"_25947":47356,"_12136":47357,"_2302":47358},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_5620":547,"_30634":544,"_5":30905,"_25947":47360,"_12136":47361,"_2302":47362},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_5620":548,"_30634":544,"_5":30905,"_25947":47364,"_12136":47365,"_2302":45677},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#antes-de-empezar",{"_5620":549,"_30634":544,"_5":30905,"_25947":47367,"_12136":47368,"_2302":47369},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_5620":550,"_30634":544,"_5":30905,"_25947":47371,"_12136":47372,"_2302":47373},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_5620":551,"_30634":544,"_5":30905,"_25947":47375,"_12136":47376,"_2302":47377},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_5620":552,"_30634":544,"_5":30905,"_25947":47379,"_12136":47380,"_2302":47381},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_5620":553,"_30634":544,"_5":30905,"_25947":47383,"_12136":47384,"_2302":47385},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_5620":554,"_30634":544,"_5":30905,"_25947":47387,"_12136":47388,"_2302":47389},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_5620":555,"_30634":544,"_5":30905,"_25947":47391,"_12136":47392,"_2302":47393},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_5620":556,"_30634":544,"_5":30905,"_25947":47395,"_12136":47396,"_2302":47397},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_5620":557,"_30634":544,"_5":30905,"_25947":47399,"_12136":47400,"_2302":47401},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_5620":558,"_30634":544,"_5":30905,"_25947":47403,"_12136":47404,"_2302":47405},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_5620":559,"_30634":544,"_5":30905,"_25947":47407,"_12136":47408,"_2302":47409},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_5620":560,"_30634":544,"_5":30905,"_25947":47411,"_12136":47412,"_2302":47413},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_5620":561,"_30634":544,"_5":30905,"_25947":47415,"_12136":47416,"_2302":47417},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_5620":562,"_30634":544,"_5":30905,"_25947":47419,"_12136":47420,"_2302":47421},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_5620":563,"_30634":544,"_5":30905,"_25947":47423,"_12136":47424,"_2302":47425},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_5620":564,"_30634":544,"_5":30905,"_25947":47427,"_12136":47428,"_2302":47429},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_5620":565,"_30634":544,"_5":30905,"_25947":47431,"_12136":47432,"_2302":47433},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_5620":566,"_30634":544,"_5":30905,"_25947":47435,"_12136":47436,"_2302":47437},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_5620":567,"_30634":544,"_5":30905,"_25947":47439,"_12136":47440,"_2302":47441},[],"/docs/pr-preview/pr-24/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_5620":568,"_30634":544,"_25947":47443,"_5":30900,"_12136":544,"_2302":47444},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_5620":569,"_30634":544,"_25947":47446,"_5":30900,"_12136":544,"_2302":47447},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_5620":570,"_30634":544,"_25947":47449,"_5":30900,"_12136":47357,"_2302":47450},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_5620":571,"_30634":544,"_25947":47452,"_5":30900,"_12136":47357,"_2302":47453},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_5620":572,"_30634":544,"_25947":47455,"_5":30900,"_12136":47357,"_2302":47456},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_5620":573,"_30634":544,"_25947":47458,"_5":30900,"_12136":47357,"_2302":47459},[],"**Importar solo el certificado:** añade una autoridad para construir cadenas y validar, pero no para emitir.",{"_5620":574,"_30634":544,"_25947":47461,"_5":30900,"_12136":47357,"_2302":47462},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_5620":575,"_30634":544,"_25947":47464,"_5":30900,"_12136":47365,"_2302":47465},[],"Decide si la CA será raíz o intermedia.",{"_5620":576,"_30634":544,"_25947":47467,"_5":30900,"_12136":47365,"_2302":47468},[],"Elige el motor que custodiará la clave.",{"_5620":577,"_30634":544,"_25947":47470,"_5":30900,"_12136":47365,"_2302":47471},[],"Define una validez superior a la de los certificados que emitirá.",{"_5620":578,"_30634":544,"_25947":47473,"_5":30900,"_12136":47365,"_2302":47474},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_5620":579,"_30634":544,"_25947":47476,"_5":30900,"_12136":47368,"_2302":47477},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_5620":580,"_30634":544,"_25947":47479,"_5":30900,"_12136":47372,"_2302":47480},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_5620":581,"_30634":544,"_25947":47482,"_5":30900,"_12136":47372,"_2302":47483},[],"Para RSA puedes elegir 1024, 2048, 3072 o 4096 bits. Para EC están disponibles las curvas P-256, P-384 y P-521.",{"_5620":582,"_30634":544,"_25947":47485,"_5":30900,"_12136":47376,"_2302":47486},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_5620":583,"_30634":544,"_25947":47488,"_5":30900,"_12136":47380,"_2302":47489},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_5620":584,"_30634":544,"_25947":47491,"_5":30900,"_12136":47380,"_2302":47492},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_5620":585,"_30634":544,"_25947":47494,"_5":30900,"_12136":47380,"_2302":47495},[],"`ST`: estado o provincia.",{"_5620":586,"_30634":544,"_25947":47497,"_5":30900,"_12136":47380,"_2302":47498},[],"`L`: localidad.",{"_5620":587,"_30634":544,"_25947":47500,"_5":30900,"_12136":47380,"_2302":47501},[],"`O`: organización.",{"_5620":588,"_30634":544,"_25947":47503,"_5":30900,"_12136":47380,"_2302":47504},[],"`OU`: unidad organizativa.",{"_5620":589,"_30634":544,"_25947":47506,"_5":30900,"_12136":47380,"_2302":47507},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_5620":590,"_30634":544,"_25947":47509,"_5":30900,"_12136":47384,"_2302":47510},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_5620":591,"_30634":544,"_25947":47512,"_5":30900,"_12136":47384,"_2302":47513},[],"Selecciona un perfil de emisión existente o configura los `Key Usage` y `Extended Key Usage` en el formulario. Si no eliges un perfil, Lamassu aplica los usos básicos predeterminados.",{"_5620":592,"_30634":544,"_25947":47515,"_5":30900,"_12136":47388,"_2302":47516},[],"Confirma el formulario. La CA debe aparecer en el inventario con su certificado PEM, estado, fecha de expiración y relación de certificados emitidos.",{"_5620":593,"_30634":544,"_25947":47518,"_5":30900,"_12136":47388,"_2302":47519},[],"Una CA no puede emitir certificados que superen su propia fecha de expiración. Deja margen suficiente para renovar o sustituir la autoridad sin interrumpir a los consumidores.",{"_5620":594,"_30634":544,"_25947":47521,"_5":30900,"_12136":47392,"_2302":47522},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_5620":595,"_30634":544,"_25947":47524,"_5":30900,"_12136":47392,"_2302":47525},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_5620":596,"_30634":544,"_25947":47527,"_5":30900,"_12136":47396,"_2302":47528},[],"La importación conserva una autoridad creada fuera de Lamassu.",{"_5620":597,"_30634":544,"_25947":47530,"_5":30900,"_12136":47400,"_2302":47531},[],"Elige el motor que custodiará la clave importada.",{"_5620":598,"_30634":544,"_25947":47533,"_5":30900,"_12136":47404,"_2302":47534},[],"Proporciona el certificado de CA y la clave privada en formato PEM. Para una CA subordinada, añade opcionalmente la cadena de validación.",{"_5620":599,"_30634":544,"_25947":47536,"_5":30900,"_12136":47408,"_2302":47537},[],"Configura la validez que recibirán los certificados finales cuando una solicitud no indique otra duración.",{"_5620":600,"_30634":544,"_25947":47539,"_5":30900,"_12136":47412,"_2302":47540},[],"Lamassu comprueba que el certificado pertenece a una CA y que el material es coherente antes de registrarlo.",{"_5620":601,"_30634":544,"_25947":47542,"_5":30900,"_12136":47412,"_2302":47543},[],"Si no dispones de la clave privada, importa únicamente el certificado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu.",{"_5620":602,"_30634":544,"_25947":47545,"_5":30900,"_12136":47416,"_2302":47546},[],"Abre una CA desde el inventario para consultar:",{"_5620":603,"_30634":544,"_25947":47548,"_5":30900,"_12136":47416,"_2302":47549},[],"Estado y periodo de validez.",{"_5620":604,"_30634":544,"_25947":47551,"_5":30900,"_12136":47416,"_2302":47552},[],"Certificado y cadena en formato PEM.",{"_5620":605,"_30634":544,"_25947":47554,"_5":30900,"_12136":47416,"_2302":47555},[],"Número de certificados activos, expirados y revocados.",{"_5620":606,"_30634":544,"_25947":47557,"_5":30900,"_12136":47416,"_2302":47558},[],"Certificados emitidos en **Issued Certificates**.",{"_5620":607,"_30634":544,"_25947":47560,"_5":30900,"_12136":47416,"_2302":47561},[],"CRL vinculada a la autoridad.",{"_5620":608,"_30634":544,"_25947":47563,"_5":30900,"_12136":47416,"_2302":47564},[],"Metadatos y motor criptográfico asociado.",{"_5620":609,"_30634":544,"_25947":47566,"_5":30900,"_12136":47416,"_2302":47567},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_5620":610,"_30634":544,"_25947":47569,"_5":30900,"_12136":47420,"_2302":47570},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_5620":611,"_30634":544,"_25947":47572,"_5":30900,"_12136":47420,"_2302":47573},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_5620":612,"_30634":544,"_25947":47575,"_5":30900,"_12136":47420,"_2302":47576},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_5620":613,"_30634":544,"_25947":47578,"_5":30900,"_12136":47420,"_2302":47579},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_5620":614,"_30634":544,"_25947":47581,"_5":30900,"_12136":47424,"_2302":47582},[],"Revocar una CA invalida la confianza en los certificados que ha emitido y puede interrumpir dispositivos y servicios. La acción es irreversible.",{"_5620":615,"_30634":544,"_25947":47584,"_5":30900,"_12136":47428,"_2302":47585},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_5620":616,"_30634":544,"_25947":47587,"_5":30900,"_12136":47432,"_2302":47588},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_5620":617,"_30634":544,"_25947":47590,"_5":30900,"_12136":47436,"_2302":47591},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_5620":618,"_30634":544,"_25947":47593,"_5":30900,"_12136":47440,"_2302":47594},[],"El estado debe cambiar a **REVOKED** y la CRL debe reflejar la nueva información. La CA deja de poder emitir certificados.",{"_5620":619,"_30634":544,"_25947":47596,"_5":30900,"_12136":47440,"_2302":47597},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_5620":620,"_30634":620,"_5":30895,"_2302":47599,"_30908":47600,"_25947":47601,"_12136":620},"Perfiles de certificado",[45667,46751,46904],[],{"_5620":621,"_30634":620,"_25947":47603,"_5":30900,"_12136":620,"_2302":47604},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_5620":622,"_30634":620,"_5":30905,"_25947":47606,"_12136":47607,"_2302":47608},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_5620":623,"_30634":620,"_5":30905,"_25947":47610,"_12136":47611,"_2302":47612},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#validez","Validez",{"_5620":624,"_30634":620,"_5":30905,"_25947":47614,"_12136":47615,"_2302":47616},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_5620":625,"_30634":620,"_5":30905,"_25947":47618,"_12136":47619,"_2302":47620},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_5620":626,"_30634":620,"_5":30905,"_25947":47622,"_12136":47623,"_2302":47624},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#sujeto","Sujeto",{"_5620":627,"_30634":620,"_5":30905,"_25947":47626,"_12136":47627,"_2302":47628},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_5620":628,"_30634":620,"_5":30905,"_25947":47630,"_12136":47631,"_2302":47632},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_5620":629,"_30634":620,"_5":30905,"_25947":47634,"_12136":47635,"_2302":47636},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_5620":630,"_30634":620,"_5":30905,"_25947":47638,"_12136":47639,"_2302":47640},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_5620":631,"_30634":620,"_5":30905,"_25947":47642,"_12136":47643,"_2302":47644},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_5620":632,"_30634":620,"_5":30905,"_25947":47646,"_12136":47647,"_2302":47648},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_5620":633,"_30634":620,"_5":30905,"_25947":47650,"_12136":47651,"_2302":47652},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_5620":634,"_30634":620,"_5":30905,"_25947":47654,"_12136":47655,"_2302":47656},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_5620":635,"_30634":620,"_5":30905,"_25947":47658,"_12136":47659,"_2302":47660},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_5620":636,"_30634":620,"_5":30905,"_25947":47662,"_12136":47663,"_2302":47664},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_5620":637,"_30634":620,"_5":30905,"_25947":47666,"_12136":47667,"_2302":47668},[],"/docs/pr-preview/pr-24/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_5620":638,"_30634":620,"_25947":47670,"_5":30900,"_12136":620,"_2302":47671},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_5620":639,"_30634":620,"_25947":47673,"_5":30900,"_12136":47611,"_2302":47674},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_5620":640,"_30634":620,"_25947":47676,"_5":30900,"_12136":47611,"_2302":47677},[],"La fecha final nunca debe superar la de la CA emisora.",{"_5620":641,"_30634":620,"_25947":47679,"_5":30900,"_12136":47615,"_2302":47680},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_5620":642,"_30634":620,"_25947":47682,"_5":30900,"_12136":47619,"_2302":47683},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_5620":643,"_30634":620,"_25947":47685,"_5":30900,"_12136":47619,"_2302":47686},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_5620":644,"_30634":620,"_25947":47688,"_5":30900,"_12136":47619,"_2302":47689},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_5620":645,"_30634":620,"_25947":47691,"_5":30900,"_12136":47623,"_2302":47692},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_5620":646,"_30634":620,"_25947":47694,"_5":30900,"_12136":47627,"_2302":47695},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_5620":647,"_30634":620,"_25947":47697,"_5":30900,"_12136":47627,"_2302":47698},[],"Este comportamiento permite aceptar DNS, IP, correo o URI como identidades alternativas sin aceptar extensiones arbitrarias.",{"_5620":648,"_30634":620,"_25947":47700,"_5":30900,"_12136":47631,"_2302":47701},[],"La aplicación criptográfica puede:",{"_5620":649,"_30634":620,"_25947":47703,"_5":30900,"_12136":47631,"_2302":47704},[],"permitir o bloquear claves RSA;",{"_5620":650,"_30634":620,"_25947":47706,"_5":30900,"_12136":47631,"_2302":47707},[],"limitar los tamaños RSA admitidos;",{"_5620":651,"_30634":620,"_25947":47709,"_5":30900,"_12136":47631,"_2302":47710},[],"permitir o bloquear claves ECDSA;",{"_5620":652,"_30634":620,"_25947":47712,"_5":30900,"_12136":47631,"_2302":47713},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_5620":653,"_30634":620,"_25947":47715,"_5":30900,"_12136":47631,"_2302":47716},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_5620":654,"_30634":620,"_25947":47718,"_5":30900,"_12136":47635,"_2302":47719},[],"En operaciones que admiten varias fuentes, Lamassu resuelve el perfil en este orden:",{"_5620":655,"_30634":620,"_25947":47721,"_5":30900,"_12136":47635,"_2302":47722},[],"Perfil enviado dentro de la operación.",{"_5620":656,"_30634":620,"_25947":47724,"_5":30900,"_12136":47635,"_2302":47725},[],"Identificador de perfil enviado en la operación.",{"_5620":657,"_30634":620,"_25947":47727,"_5":30900,"_12136":47635,"_2302":47728},[],"Perfil predeterminado asociado a la CA.",{"_5620":658,"_30634":620,"_25947":47730,"_5":30900,"_12136":47635,"_2302":47731},[],"Un DMS también puede referenciar su propio perfil de emisión. De este modo, varias flotas pueden usar la misma CA con políticas distintas.",{"_5620":659,"_30634":620,"_25947":47733,"_5":30900,"_12136":47643,"_2302":47734},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_5620":660,"_30634":620,"_25947":47736,"_5":30900,"_12136":47647,"_2302":47737},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_5620":661,"_30634":620,"_25947":47739,"_5":30900,"_12136":47651,"_2302":47740},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_5620":662,"_30634":620,"_25947":47742,"_5":30900,"_12136":47655,"_2302":47743},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_5620":663,"_30634":620,"_25947":47745,"_5":30900,"_12136":47659,"_2302":47746},[],"Asocia el perfil a una CA o DMS. Emite un certificado de prueba y comprueba sujeto, SAN, KU, EKU, restricciones básicas y fechas con una herramienta X.509 independiente.",{"_5620":664,"_30634":620,"_25947":47748,"_5":30900,"_12136":47663,"_2302":47749},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_5620":665,"_30634":620,"_25947":47751,"_5":30900,"_12136":47663,"_2302":47752},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_5620":666,"_30634":620,"_25947":47754,"_5":30900,"_12136":47663,"_2302":47755},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_5620":667,"_30634":620,"_25947":47757,"_5":30900,"_12136":47663,"_2302":47758},[],"Son patrones de partida, no una política universal. Verifica siempre los requisitos del protocolo, del consumidor y del marco regulatorio aplicable.",{"_5620":668,"_30634":620,"_25947":47760,"_5":30900,"_12136":47667,"_2302":47761},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_5620":669,"_30634":620,"_25947":47763,"_5":30900,"_12136":47667,"_2302":47764},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_5620":670,"_30634":670,"_5":30895,"_2302":47766,"_30908":47767,"_25947":47768,"_12136":670},"Validación de certificados",[45667,46751,46904],[],{"_5620":671,"_30634":670,"_25947":47770,"_5":30900,"_12136":670,"_2302":47771},[],"Publica el estado de las identidades mediante OCSP y CRL.",{"_5620":672,"_30634":670,"_5":30905,"_25947":47773,"_12136":47774,"_2302":47775},[],"/docs/pr-preview/pr-24/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_5620":673,"_30634":670,"_25947":47777,"_5":30900,"_12136":670,"_2302":47778},[],"La emisión demuestra quién firmó un certificado; la validación permite saber si todavía debe aceptarse. Lamassu publica el estado mediante dos mecanismos complementarios.",{"_5620":674,"_30634":670,"_25947":47780,"_5":30900,"_12136":47774,"_2302":47781},[],"Usa **OCSP** cuando el consumidor esté conectado y necesite consultar el estado más reciente de un certificado concreto.",{"_5620":675,"_30634":670,"_25947":47783,"_5":30900,"_12136":47774,"_2302":47784},[],"Usa una **CRL** cuando la validación deba realizarse localmente, sin conexión o sobre un volumen elevado de certificados. El consumidor descarga periódicamente una lista firmada y la conserva hasta la siguiente actualización.",{"_5620":676,"_30634":670,"_25947":47786,"_5":30900,"_12136":47774,"_2302":47787},[],"Muchos entornos utilizan ambos: OCSP como comprobación primaria y CRL como mecanismo local o de respaldo.",{"_5620":677,"_30634":670,"_25947":47789,"_5":30900,"_12136":47774,"_2302":47790},[],"<Card title=\"Validación online con OCSP\" description=\"Consulta estados Good, Revoked y Unknown en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_5620":678,"_30634":670,"_25947":47792,"_5":30900,"_12136":47774,"_2302":47793},[],"<Card title=\"Listas de revocación\" description=\"Genera, publica y distribuye CRLs por autoridad.\" href=\"/docs/platform/pki/crl\" />",{"_5620":679,"_30634":679,"_5":30895,"_2302":47795,"_30908":47796,"_25947":47797,"_12136":679},"Certificados",[45667,46751,46904],[],{"_5620":680,"_30634":679,"_25947":47799,"_5":30900,"_12136":679,"_2302":47800},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_5620":681,"_30634":679,"_5":30905,"_25947":47802,"_12136":47803,"_2302":47804},[],"/docs/pr-preview/pr-24/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_5620":682,"_30634":679,"_5":30905,"_25947":47806,"_12136":47807,"_2302":47808},[],"/docs/pr-preview/pr-24/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_5620":683,"_30634":679,"_5":30905,"_25947":47810,"_12136":47811,"_2302":47812},[],"/docs/pr-preview/pr-24/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_5620":684,"_30634":679,"_5":30905,"_25947":47814,"_12136":47815,"_2302":47816},[],"/docs/pr-preview/pr-24/platform/pki/certificates#abre-la-acción","Abre la acción",{"_5620":685,"_30634":679,"_5":30905,"_25947":47818,"_12136":47819,"_2302":47820},[],"/docs/pr-preview/pr-24/platform/pki/certificates#elige-una-razón","Elige una razón",{"_5620":686,"_30634":679,"_5":30905,"_25947":47822,"_12136":47823,"_2302":47824},[],"/docs/pr-preview/pr-24/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_5620":687,"_30634":679,"_5":30905,"_25947":47826,"_12136":47827,"_2302":47828},[],"/docs/pr-preview/pr-24/platform/pki/certificates#continúa","Continúa",{"_5620":688,"_30634":679,"_25947":47830,"_5":30900,"_12136":679,"_2302":47831},[],"El inventario de certificados ofrece una vista global de las identidades emitidas por todas las autoridades. También puedes abrir **Issued Certificates** dentro de una CA para limitar la vista a ese emisor.",{"_5620":689,"_30634":679,"_25947":47833,"_5":30900,"_12136":47803,"_2302":47834},[],"Abre **Certificates** y filtra por:",{"_5620":690,"_30634":679,"_25947":47836,"_5":30900,"_12136":47803,"_2302":47837},[],"`Common Name` del sujeto.",{"_5620":691,"_30634":679,"_25947":47839,"_5":30900,"_12136":47803,"_2302":47840},[],"Número de serie.",{"_5620":692,"_30634":679,"_25947":47842,"_5":30900,"_12136":47803,"_2302":47843},[],"Estado.",{"_5620":693,"_30634":679,"_25947":47845,"_5":30900,"_12136":47803,"_2302":47846},[],"Autoridad emisora.",{"_5620":694,"_30634":679,"_25947":47848,"_5":30900,"_12136":47803,"_2302":47849},[],"Utiliza **Quick Inspect** para una comprobación rápida o **View Details** para ver el sujeto, SANs, usos, cadena, periodo de validez y metadatos completos.",{"_5620":695,"_30634":679,"_25947":47851,"_5":30900,"_12136":47807,"_2302":47852},[],"La acción de descarga entrega el certificado en formato PEM. Si el certificado se emitió mediante un CSR externo, la clave privada permanece en el sistema que generó ese CSR. Si se generó en el navegador, la clave solo estuvo disponible al finalizar la emisión.",{"_5620":696,"_30634":679,"_25947":47854,"_5":30900,"_12136":47811,"_2302":47855},[],"Revoca una identidad cuando la clave se haya comprometido, el sujeto ya no esté autorizado o el certificado deba dejar de aceptarse antes de expirar.",{"_5620":697,"_30634":679,"_25947":47857,"_5":30900,"_12136":47815,"_2302":47858},[],"En el inventario o la vista de detalle, selecciona **Revoke Certificate**.",{"_5620":698,"_30634":679,"_25947":47860,"_5":30900,"_12136":47819,"_2302":47861},[],"Selecciona la razón que represente el incidente. Esta información se publica en OCSP y en la CRL.",{"_5620":699,"_30634":679,"_25947":47863,"_5":30900,"_12136":47823,"_2302":47864},[],"Confirma la operación y comprueba que el estado sea **Revoked**. Si la CA regenera la CRL al revocar, verifica también que exista una versión nueva.",{"_5620":700,"_30634":679,"_25947":47866,"_5":30900,"_12136":47823,"_2302":47867},[],"Una revocación con la razón `CertificateHold` puede reactivarse. Las demás razones producen una revocación definitiva.",{"_5620":701,"_30634":679,"_25947":47869,"_5":30900,"_12136":47827,"_2302":47870},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado de un certificado en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_5620":702,"_30634":679,"_25947":47872,"_5":30900,"_12136":47827,"_2302":47873},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación offline.\" href=\"/docs/platform/pki/crl\" />",{"_5620":703,"_30634":703,"_5":30895,"_2302":47875,"_30908":47876,"_25947":47877,"_12136":703},"Enrolamiento de dispositivos con CMP",[45667,46751,46904],[],{"_5620":704,"_30634":703,"_25947":47879,"_5":30900,"_12136":703,"_2302":47880},[],"Guía del protocolo CMP en Lamassu IoT, con la referencia completa de ajustes generales y por operación del DMS, y la referencia de operaciones para el integrador de dispositivos.",{"_5620":705,"_30634":703,"_5":30905,"_25947":47882,"_12136":47883,"_2302":47884},[],"/docs/pr-preview/pr-24/platform/pki/cmp#cmp-certificate-management-protocol","CMP: Certificate Management Protocol",{"_5620":706,"_30634":703,"_5":30905,"_25947":47886,"_12136":47887,"_2302":47888},[],"/docs/pr-preview/pr-24/platform/pki/cmp#configuración-del-dms","Configuración del DMS",{"_5620":707,"_30634":703,"_5":30905,"_25947":47890,"_12136":47891,"_2302":46476},[],"/docs/pr-preview/pr-24/platform/pki/cmp#requisitos-previos",{"_5620":708,"_30634":703,"_5":30905,"_25947":47893,"_12136":47894,"_2302":47895},[],"/docs/pr-preview/pr-24/platform/pki/cmp#selección-de-protocolo","Selección de protocolo",{"_5620":709,"_30634":703,"_5":30905,"_25947":47897,"_12136":47898,"_2302":47899},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-generales-de-enrollment","Ajustes generales de enrollment",{"_5620":710,"_30634":703,"_5":30905,"_25947":47901,"_12136":47902,"_2302":47903},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-compartidos-con-est","Ajustes compartidos con EST",{"_5620":711,"_30634":703,"_5":30905,"_25947":47905,"_12136":47906,"_2302":47907},[],"/docs/pr-preview/pr-24/platform/pki/cmp#modo-de-autenticación","Modo de autenticación",{"_5620":712,"_30634":703,"_5":30905,"_25947":47909,"_12136":47910,"_2302":47911},[],"/docs/pr-preview/pr-24/platform/pki/cmp#confirmación-y-flujo-de-emisión","Confirmación y flujo de emisión",{"_5620":713,"_30634":703,"_5":30905,"_25947":47913,"_12136":47914,"_2302":47915},[],"/docs/pr-preview/pr-24/platform/pki/cmp#certificado-de-protección-y-prueba-de-posesión","Certificado de protección y prueba de posesión",{"_5620":714,"_30634":703,"_5":30905,"_25947":47917,"_12136":47918,"_2302":47919},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ajustes-por-operación","Ajustes por operación",{"_5620":715,"_30634":703,"_5":30905,"_25947":47921,"_12136":47922,"_2302":47923},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ir--initialization-request","`ir` — Initialization Request",{"_5620":716,"_30634":703,"_5":30905,"_25947":47925,"_12136":47926,"_2302":47927},[],"/docs/pr-preview/pr-24/platform/pki/cmp#cr--certification-request","`cr` — Certification Request",{"_5620":717,"_30634":703,"_5":30905,"_25947":47929,"_12136":47930,"_2302":47931},[],"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr--pkcs10-certification-request","`p10cr` — PKCS#10 Certification Request",{"_5620":718,"_30634":703,"_5":30905,"_25947":47933,"_12136":47934,"_2302":47935},[],"/docs/pr-preview/pr-24/platform/pki/cmp#kur--key-update-request","`kur` — Key Update Request",{"_5620":719,"_30634":703,"_5":30905,"_25947":47937,"_12136":47938,"_2302":47939},[],"/docs/pr-preview/pr-24/platform/pki/cmp#rr--revocation-request","`rr` — Revocation Request",{"_5620":720,"_30634":703,"_5":30905,"_25947":47941,"_12136":47942,"_2302":47943},[],"/docs/pr-preview/pr-24/platform/pki/cmp#genm--general-message","`genm` — General Message",{"_5620":721,"_30634":703,"_5":30905,"_25947":47945,"_12136":47946,"_2302":47947},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ccr--cross-certification-request","`ccr` — Cross-Certification Request",{"_5620":722,"_30634":703,"_5":30905,"_25947":47949,"_12136":47950,"_2302":47951},[],"/docs/pr-preview/pr-24/platform/pki/cmp#generación-de-claves-en-servidor-central-key-generation","Generación de claves en servidor (Central Key Generation)",{"_5620":723,"_30634":703,"_5":30905,"_25947":47953,"_12136":47954,"_2302":47955},[],"/docs/pr-preview/pr-24/platform/pki/cmp#configuración-de-re-enrollment","Configuración de re-enrollment",{"_5620":724,"_30634":703,"_5":30905,"_25947":47957,"_12136":47958,"_2302":47959},[],"/docs/pr-preview/pr-24/platform/pki/cmp#transacciones-cmp","Transacciones CMP",{"_5620":725,"_30634":703,"_5":30905,"_25947":47961,"_12136":47962,"_2302":47963},[],"/docs/pr-preview/pr-24/platform/pki/cmp#monitor-de-confirmación","Monitor de confirmación",{"_5620":726,"_30634":703,"_5":30905,"_25947":47965,"_12136":47966,"_2302":47967},[],"/docs/pr-preview/pr-24/platform/pki/cmp#integración-con-wfx-opcional","Integración con WFX (opcional)",{"_5620":727,"_30634":703,"_5":30905,"_25947":47969,"_12136":47970,"_2302":47971},[],"/docs/pr-preview/pr-24/platform/pki/cmp#verificar-la-configuración","Verificar la configuración",{"_5620":728,"_30634":703,"_5":30905,"_25947":47973,"_12136":47974,"_2302":47975},[],"/docs/pr-preview/pr-24/platform/pki/cmp#integración-de-dispositivos","Integración de dispositivos",{"_5620":729,"_30634":703,"_5":30905,"_25947":47977,"_12136":47978,"_2302":45677},[],"/docs/pr-preview/pr-24/platform/pki/cmp#antes-de-empezar",{"_5620":730,"_30634":703,"_5":30905,"_25947":47980,"_12136":47981,"_2302":47982},[],"/docs/pr-preview/pr-24/platform/pki/cmp#el-endpoint-cmp","El endpoint CMP",{"_5620":731,"_30634":703,"_5":30905,"_25947":47984,"_12136":47985,"_2302":47986},[],"/docs/pr-preview/pr-24/platform/pki/cmp#modelo-de-autenticación","Modelo de autenticación",{"_5620":732,"_30634":703,"_5":30905,"_25947":47988,"_12136":47989,"_2302":47990},[],"/docs/pr-preview/pr-24/platform/pki/cmp#operaciones-soportadas","Operaciones soportadas",{"_5620":733,"_30634":703,"_5":30905,"_25947":47992,"_12136":47993,"_2302":47994},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ir-y-cr","`ir` y `cr`",{"_5620":734,"_30634":703,"_5":30905,"_25947":47996,"_12136":47997,"_2302":47998},[],"/docs/pr-preview/pr-24/platform/pki/cmp#kur","`kur`",{"_5620":735,"_30634":703,"_5":30905,"_25947":48000,"_12136":48001,"_2302":48002},[],"/docs/pr-preview/pr-24/platform/pki/cmp#p10cr","`p10cr`",{"_5620":736,"_30634":703,"_5":30905,"_25947":48004,"_12136":48005,"_2302":48006},[],"/docs/pr-preview/pr-24/platform/pki/cmp#rr","`rr`",{"_5620":737,"_30634":703,"_5":30905,"_25947":48008,"_12136":48009,"_2302":48010},[],"/docs/pr-preview/pr-24/platform/pki/cmp#genm","`genm`",{"_5620":738,"_30634":703,"_5":30905,"_25947":48012,"_12136":48013,"_2302":48014},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ccr","`ccr`",{"_5620":739,"_30634":703,"_5":30905,"_25947":48016,"_12136":48017,"_2302":48018},[],"/docs/pr-preview/pr-24/platform/pki/cmp#certconf-y-pollreq","`certConf` y `pollReq`",{"_5620":740,"_30634":703,"_5":30905,"_25947":48020,"_12136":48021,"_2302":48022},[],"/docs/pr-preview/pr-24/platform/pki/cmp#nested","`nested`",{"_5620":741,"_30634":703,"_5":30905,"_25947":48024,"_12136":48025,"_2302":48026},[],"/docs/pr-preview/pr-24/platform/pki/cmp#generación-de-claves-en-servidor-kga","Generación de claves en servidor (KGA)",{"_5620":742,"_30634":703,"_5":30905,"_25947":48028,"_12136":48029,"_2302":48030},[],"/docs/pr-preview/pr-24/platform/pki/cmp#ejemplo-con-openssl-cmp","Ejemplo con openssl cmp",{"_5620":743,"_30634":703,"_5":30905,"_25947":48032,"_12136":48033,"_2302":48034},[],"/docs/pr-preview/pr-24/platform/pki/cmp#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_5620":744,"_30634":703,"_5":30905,"_25947":48036,"_12136":48037,"_2302":48038},[],"/docs/pr-preview/pr-24/platform/pki/cmp#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_5620":745,"_30634":703,"_5":30905,"_25947":48040,"_12136":48041,"_2302":48042},[],"/docs/pr-preview/pr-24/platform/pki/cmp#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_5620":746,"_30634":703,"_5":30905,"_25947":48044,"_12136":48045,"_2302":48046},[],"/docs/pr-preview/pr-24/platform/pki/cmp#notas-de-compatibilidad","Notas de compatibilidad",{"_5620":747,"_30634":703,"_25947":48048,"_5":30900,"_12136":47883,"_2302":48049},[],"Lamassu IoT implementa el protocolo &#x2A;*CMP (RFC 4210)** siguiendo el perfil &#x2A;*Lightweight CMP (RFC 9483)** como su segundo mecanismo de inscripción de certificados para dispositivos, junto a EST (RFC 7030). Cada DMS expone uno de los dos protocolos — nunca ambos a la vez — y el que expone CMP actúa como autoridad de registro (RA) frente al cliente.",{"_5620":748,"_30634":703,"_25947":48051,"_5":30900,"_12136":47883,"_2302":48052},[],"Frente a EST, CMP cambia tres ideas fundamentales:",{"_5620":749,"_30634":703,"_25947":48054,"_5":30900,"_12136":47883,"_2302":48055},[],"Aspecto",{"_5620":750,"_30634":703,"_25947":48057,"_5":30900,"_12136":47883,"_2302":48058},[],"EST (RFC 7030)",{"_5620":751,"_30634":703,"_25947":48060,"_5":30900,"_12136":47883,"_2302":48061},[],"CMP (RFC 4210 / RFC 9483)",{"_5620":752,"_30634":703,"_25947":48063,"_5":30900,"_12136":47883,"_2302":48064},[],"Endpoint",{"_5620":753,"_30634":703,"_25947":48066,"_5":30900,"_12136":47883,"_2302":48067},[],"Uno por operación (`/cacerts`, `/simpleenroll`, …)",{"_5620":754,"_30634":703,"_25947":48069,"_5":30900,"_12136":47883,"_2302":48070},[],"Un **único endpoint multiplexado** (`/.well-known/cmp/p/{id}`); la operación se determina por el contenido del mensaje",{"_5620":755,"_30634":703,"_25947":48072,"_5":30900,"_12136":47883,"_2302":48073},[],"Autenticación",{"_5620":756,"_30634":703,"_25947":48075,"_5":30900,"_12136":47883,"_2302":48076},[],"mTLS en la capa de transporte",{"_5620":757,"_30634":703,"_25947":48078,"_5":30900,"_12136":47883,"_2302":48079},[],"**Protección del propio mensaje** (`PKIMessage`) mediante firma o, en `ir`/`cr`, prueba de posesión CRMF",{"_5620":758,"_30634":703,"_25947":48081,"_5":30900,"_12136":47883,"_2302":48082},[],"Ajustes",{"_5620":759,"_30634":703,"_25947":48084,"_5":30900,"_12136":47883,"_2302":48085},[],"Bloques generales de enrollment y re-enrollment",{"_5620":760,"_30634":703,"_25947":48087,"_5":30900,"_12136":47883,"_2302":48088},[],"Ajustes generales **más un bloque de política por operación** (`ir`, `cr`, `p10cr`, `kur`, `rr`, `genm`, `ccr`)",{"_5620":761,"_30634":703,"_25947":48090,"_5":30900,"_12136":47883,"_2302":48091},[],"Confirmación",{"_5620":762,"_30634":703,"_25947":48093,"_5":30900,"_12136":47883,"_2302":48094},[],"La respuesta es el final del flujo",{"_5620":763,"_30634":703,"_25947":48096,"_5":30900,"_12136":47883,"_2302":48097},[],"Protocolo de confirmación explícito (`certConf`), confirmación implícita negociable y transacciones con estados",{"_5620":764,"_30634":703,"_25947":48099,"_5":30900,"_12136":47883,"_2302":48100},[],"Renovación",{"_5620":765,"_30634":703,"_25947":48102,"_5":30900,"_12136":47883,"_2302":48103},[],"`/simplereenroll` con el certificado en vigor",{"_5620":766,"_30634":703,"_25947":48105,"_5":30900,"_12136":47883,"_2302":48106},[],"`kur` protegido por el certificado que se renueva, con política de clave e identidad por DMS",{"_5620":767,"_30634":703,"_25947":48108,"_5":30900,"_12136":47883,"_2302":48109},[],"El protocolo se selecciona con el campo `protocol` del DMS (`EST_RFC7030` o `CMP_RFC9483`) y cada uno tiene su propio bloque de configuración (`est_settings` / `cmp_settings`). Cambiar el protocolo de un DMS existente sustituye por completo el bloque del protocolo anterior: no hay migración de ajustes entre uno y otro.",{"_5620":768,"_30634":703,"_25947":48111,"_5":30900,"_12136":47883,"_2302":48112},[],"Esta guía está dividida en dos partes:",{"_5620":769,"_30634":703,"_25947":48114,"_5":30900,"_12136":47883,"_2302":48115},[],"Configuración del DMS, para el administrador PKI: todos los ajustes disponibles, generales y por operación.",{"_5620":770,"_30634":703,"_25947":48117,"_5":30900,"_12136":47883,"_2302":48118},[],"Integración de dispositivos, para quien consume el endpoint CMP desde firmware, librerías CMP estándar o servicios de aprovisionamiento.",{"_5620":771,"_30634":703,"_25947":48120,"_5":30900,"_12136":47883,"_2302":48121},[],"Si solo necesita una orientación rápida:",{"_5620":772,"_30634":703,"_25947":48123,"_5":30900,"_12136":47883,"_2302":48124},[],"Perfil",{"_5620":773,"_30634":703,"_25947":48126,"_5":30900,"_12136":47883,"_2302":48127},[],"Leer primero",{"_5620":774,"_30634":703,"_25947":48129,"_5":30900,"_12136":47883,"_2302":48130},[],"Después",{"_5620":775,"_30634":703,"_25947":48132,"_5":30900,"_12136":47883,"_2302":48133},[],"Administrador PKI",{"_5620":776,"_30634":703,"_25947":48135,"_5":30900,"_12136":47883,"_2302":48136},[],"Selección de protocolo y Ajustes por operación",{"_5620":777,"_30634":703,"_25947":48138,"_5":30900,"_12136":47883,"_2302":48139},[],"Transacciones CMP y Monitor de confirmación",{"_5620":778,"_30634":703,"_25947":48141,"_5":30900,"_12136":47883,"_2302":48142},[],"Integrador de dispositivos",{"_5620":779,"_30634":703,"_25947":48144,"_5":30900,"_12136":47883,"_2302":48145},[],"El endpoint CMP y Modelo de autenticación",{"_5620":780,"_30634":703,"_25947":48147,"_5":30900,"_12136":47883,"_2302":48148},[],"Operaciones soportadas y Códigos de error y diagnóstico",{"_5620":781,"_30634":703,"_25947":48150,"_5":30900,"_12136":47891,"_2302":48151},[],"Antes de configurar un DMS para CMP, deben existir los siguientes recursos en la plataforma:",{"_5620":782,"_30634":703,"_25947":48153,"_5":30900,"_12136":47891,"_2302":48154},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo. Si se habilita la generación de claves en servidor (KGA), las CAs contra las que se validará el certificado destinatario también deben existir (ver Generación de claves en servidor).",{"_5620":783,"_30634":703,"_25947":48156,"_5":30900,"_12136":47891,"_2302":48157},[],"**Un certificado de protección**: CMP firma sus propias respuestas. El DMS necesita un certificado de tipo End Entity cuya clave privada resida en el KMS de Lamassu (`protection_certificate`, ver más abajo).",{"_5620":784,"_30634":703,"_25947":48159,"_5":30900,"_12136":47891,"_2302":48160},[],"**Un DMS creado**: la configuración CMP se aplica sobre un DMS existente, no lo crea.",{"_5620":785,"_30634":703,"_25947":48162,"_5":30900,"_12136":47891,"_2302":48163},[],"Los ajustes de **CA Distribution** (qué autoridades recibe el dispositivo como anclas de confianza) son idénticos para ambos protocolos y se describen en la visión general del DMS.",{"_5620":786,"_30634":703,"_25947":48165,"_5":30900,"_12136":47894,"_2302":48166},[],"Al crear o editar un DMS, el campo `protocol` decide qué bloque de configuración aplica:",{"_5620":787,"_30634":703,"_25947":48168,"_5":30900,"_12136":47894,"_2302":48169},[],"Valor",{"_5620":788,"_30634":703,"_25947":48171,"_5":30900,"_12136":47894,"_2302":48172},[],"Protocolo",{"_5620":789,"_30634":703,"_25947":48174,"_5":30900,"_12136":47894,"_2302":48175},[],"`EST_RFC7030`",{"_5620":790,"_30634":703,"_25947":48177,"_5":30900,"_12136":47894,"_2302":48178},[],"EST — ver la guía EST",{"_5620":791,"_30634":703,"_25947":48180,"_5":30900,"_12136":47894,"_2302":48181},[],"`CMP_RFC9483`",{"_5620":792,"_30634":703,"_25947":48183,"_5":30900,"_12136":47894,"_2302":48184},[],"CMP — esta página",{"_5620":793,"_30634":703,"_25947":48186,"_5":30900,"_12136":47894,"_2302":48187},[],"Un valor distinto de los dos anteriores hace fallar la creación o edición del DMS con el error `DMS enrollment protocol must be EST_RFC7030 or CMP_RFC9483`. Al cambiar el `protocol` de un DMS, el bloque del protocolo saliente se descarta por completo y se sustituye por el entrante: los ajustes de cada protocolo son autónomos y no se copian entre sí.",{"_5620":794,"_30634":703,"_25947":48189,"_5":30900,"_12136":47902,"_2302":48190},[],"Estos campos son comunes a los dos protocolos y significan lo mismo en ambos:",{"_5620":795,"_30634":703,"_25947":48192,"_5":30900,"_12136":47902,"_2302":48193},[],"Campo",{"_5620":796,"_30634":703,"_25947":48195,"_5":30900,"_12136":47902,"_2302":46038},[],{"_5620":797,"_30634":703,"_25947":48197,"_5":30900,"_12136":47902,"_2302":48198},[],"`enrollment_ca`",{"_5620":798,"_30634":703,"_25947":48200,"_5":30900,"_12136":47902,"_2302":48201},[],"CA que firmará los certificados de identidad emitidos por este DMS.",{"_5620":799,"_30634":703,"_25947":48203,"_5":30900,"_12136":47902,"_2302":48204},[],"`registration_mode`",{"_5620":800,"_30634":703,"_25947":48206,"_5":30900,"_12136":47902,"_2302":48207},[],"`JITP` (*Just-In-Time Provisioning*) crea el dispositivo automáticamente en la primera inscripción, aplicando el perfil de aprovisionamiento; `PRE_REGISTRATION` exige que el dispositivo exista previamente y rechaza lo contrario con `device not preregistered`.",{"_5620":801,"_30634":703,"_25947":48209,"_5":30900,"_12136":47902,"_2302":48210},[],"`device_provisioning_profile`",{"_5620":802,"_30634":703,"_25947":48212,"_5":30900,"_12136":47902,"_2302":48213},[],"Icono, color, metadatos y tags aplicados a cada dispositivo creado en modo JITP.",{"_5620":803,"_30634":703,"_25947":48215,"_5":30900,"_12136":47902,"_2302":48216},[],"`enable_replaceable_enrollment`",{"_5620":804,"_30634":703,"_25947":48218,"_5":30900,"_12136":47902,"_2302":48219},[],"Permite que un dispositivo ya enrolado vuelva a inscribirse. Cuando está inactiva, un segundo intento de `ir`/`cr` sobre un dispositivo existente se rechaza con `forbiddenNewEnrollment`. Si la sustitución de la identidad revoca el certificado anterior (con la razón `superseded`) lo decide `revoke_on_reenrollment`, o el `certificate_behavior` de `cr` — ver Configuración de re-enrollment.",{"_5620":805,"_30634":703,"_25947":48221,"_5":30900,"_12136":47902,"_2302":48222},[],"`verify_csr_signature`",{"_5620":806,"_30634":703,"_25947":48224,"_5":30900,"_12136":47902,"_2302":48225},[],"**Sin efecto en CMP.** El servidor sintetiza el CSR a partir del `CertTemplate` (su firma es sustituida por un valor ficticio) y la prueba de posesión se establece por otras vías: la POPO de `ir`/`cr`, el CSR PKCS#10 de `p10cr` (verificado siempre) o la protección de `kur`.",{"_5620":807,"_30634":703,"_25947":48227,"_5":30900,"_12136":47906,"_2302":48228},[],"`auth_mode` define cómo el DMS valida la identidad del solicitante. CMP reconoce los mismos cuatro modos que EST, pero el mecanismo cambia: **la autenticación se verifica dentro del propio mensaje CMP, no en la capa de transporte**.",{"_5620":808,"_30634":703,"_25947":48230,"_5":30900,"_12136":47906,"_2302":48231},[],"Modo",{"_5620":809,"_30634":703,"_25947":48233,"_5":30900,"_12136":47906,"_2302":46038},[],{"_5620":810,"_30634":703,"_25947":48235,"_5":30900,"_12136":47906,"_2302":48236},[],"`CLIENT_CERTIFICATE`",{"_5620":811,"_30634":703,"_25947":48238,"_5":30900,"_12136":47906,"_2302":48239},[],"El mensaje debe ir **protegido por firma** con el certificado del dispositivo (`extraCerts[0]` del `PKIMessage`), validado contra las CAs declaradas en `client_certificate_settings.validation_cas`. No es mTLS: es la firma sobre el `PKIMessage` (RFC 9483 §3.2).",{"_5620":812,"_30634":703,"_25947":48241,"_5":30900,"_12136":47906,"_2302":48242},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_5620":813,"_30634":703,"_25947":48244,"_5":30900,"_12136":47906,"_2302":48245},[],"Combina los dos controles: firma válida **y** aprobación del webhook.",{"_5620":814,"_30634":703,"_25947":48247,"_5":30900,"_12136":47906,"_2302":48248},[],"`EXTERNAL_WEBHOOK`",{"_5620":815,"_30634":703,"_25947":48250,"_5":30900,"_12136":47906,"_2302":48251},[],"La decisión de autorización se delega en un servicio HTTP externo, con el mismo contrato que en EST. El mensaje puede llegar sin protección.",{"_5620":816,"_30634":703,"_25947":48253,"_5":30900,"_12136":47906,"_2302":48254},[],"`NO_AUTH`",{"_5620":817,"_30634":703,"_25947":48256,"_5":30900,"_12136":47906,"_2302":48257},[],"Sin autenticación obligatoria. El mensaje puede llegar sin protección; si trae una firma, igualmente se valida. &#x2A;*Exclusivo para laboratorios o redes de aprovisionamiento aisladas.**",{"_5620":818,"_30634":703,"_25947":48259,"_5":30900,"_12136":47906,"_2302":48260},[],"Un DMS cuya `auth_mode` está vacía o no definida se considera mal configurado: toda solicitud se rechaza con `DMS auth mode not supported`, en lugar de aceptarse sin autenticación. El valor `NONE` se acepta como alias heredado de `NO_AUTH` desde el panel de administración.",{"_5620":819,"_30634":703,"_25947":48262,"_5":30900,"_12136":47906,"_2302":48263},[],"Cuando el modo incluye `CLIENT_CERTIFICATE`, se configuran los mismos parámetros que en EST: **Validation CAs**, **Chain Validation Level** (`-1` valida la cadena completa) y **Allow Authenticating Expired Certificates**. Cuando incluye `EXTERNAL_WEBHOOK`, se configuran los mismos parámetros de webhook que en EST (URL, método, timeout — 10 segundos por defecto — y modo de autenticación del webhook). El contrato del servicio webhook es idéntico en ambos protocolos; consulte la sección equivalente de la guía EST para el detalle de cada campo y la referencia del webhook de autorización para el esquema.",{"_5620":820,"_30634":703,"_25947":48265,"_5":30900,"_12136":47906,"_2302":48266},[],"A diferencia de EST, CMP no tiene un modo de autenticación separado para la renovación: `kur` siempre se autentica con la protección por firma del propio certificado que se renueva.",{"_5620":821,"_30634":703,"_25947":48268,"_5":30900,"_12136":47910,"_2302":48269},[],"A diferencia de EST, CMP incluye un protocolo de confirmación explícito (RFC 4210 §5.2.8) y admite un flujo de aprobación diferida:",{"_5620":822,"_30634":703,"_25947":48271,"_5":30900,"_12136":47910,"_2302":48193},[],{"_5620":823,"_30634":703,"_25947":48273,"_5":30900,"_12136":47910,"_2302":48274},[],"Tipo",{"_5620":824,"_30634":703,"_25947":48276,"_5":30900,"_12136":47910,"_2302":46038},[],{"_5620":825,"_30634":703,"_25947":48278,"_5":30900,"_12136":47910,"_2302":48279},[],"`accept_implicit`",{"_5620":826,"_30634":703,"_25947":48281,"_5":30900,"_12136":47910,"_2302":29519},[],{"_5620":827,"_30634":703,"_25947":48283,"_5":30900,"_12136":47910,"_2302":48284},[],"Permite **omitir** el paso `certConf` cuando el dispositivo solicita confirmación implícita (`id-it-implicitConfirm` en `generalInfo`). Solo tiene efecto si el dispositivo también la solicita; la solicitud sola no la fuerza. Desactivado por defecto.",{"_5620":828,"_30634":703,"_25947":48286,"_5":30900,"_12136":47910,"_2302":48287},[],"`confirmation_timeout`",{"_5620":829,"_30634":703,"_25947":48289,"_5":30900,"_12136":47910,"_2302":48290},[],"duración",{"_5620":830,"_30634":703,"_25947":48292,"_5":30900,"_12136":47910,"_2302":48293},[],"Ventana de espera del `certConf` (por ejemplo `30s`, `5m`, `1h`). Un valor cero o negativo usa el por defecto: **5 minutos**.",{"_5620":831,"_30634":703,"_25947":48295,"_5":30900,"_12136":47910,"_2302":48296},[],"`workflow`",{"_5620":832,"_30634":703,"_25947":48298,"_5":30900,"_12136":47910,"_2302":48299},[],"`direct` / `phased`",{"_5620":833,"_30634":703,"_25947":48301,"_5":30900,"_12136":47910,"_2302":48302},[],"`direct` (por defecto) emite el certificado en línea, en la misma respuesta a `ir`/`cr`/`kur`/`p10cr`. `phased` retiene la solicitud hasta que un administrador la apruebe; el dispositivo recupera el resultado con `pollReq`. La generación de claves en servidor y la certificación cruzada tienen su propio flujo y no dependen de este campo.",{"_5620":834,"_30634":703,"_25947":48304,"_5":30900,"_12136":47910,"_2302":48305},[],"`approval_timeout`",{"_5620":835,"_30634":703,"_25947":48307,"_5":30900,"_12136":47910,"_2302":48290},[],{"_5620":836,"_30634":703,"_25947":48309,"_5":30900,"_12136":47910,"_2302":48310},[],"Solo aplica con `workflow: phased`. Tiempo que una transacción permanece `PENDING` esperando aprobación. Sin valor, el por defecto es **7 días**.",{"_5620":837,"_30634":703,"_25947":48312,"_5":30900,"_12136":47914,"_2302":48313},[],"**Protection Certificate** (`protection_certificate`): número de serie del certificado End Entity, respaldado por el KMS, con el que el DMS protege (firma) sus respuestas CMP. El servidor no obliga a configurarlo, pero sin él **todas** las respuestas — incluidos los mensajes de error — salen sin protección, y los clientes CMP estándar (`openssl cmp` incluido) rechazan por defecto las respuestas sin protección. En la práctica es imprescindible.",{"_5620":838,"_30634":703,"_25947":48315,"_5":30900,"_12136":47914,"_2302":48316},[],"**Enforce POPO** (`enforce_popo`): opción heredada que **ya no gobierna ninguna verificación**. La política de prueba de posesión de `ir`/`cr` vive en su bloque por operación (`proof_of_possession.required`), `kur` y `rr` están siempre protegidos por firma como invariantes del protocolo, y la firma del CSR de `p10cr` se verifica siempre. El campo persiste y round-trip en la API, pero su valor no altera el comportamiento.",{"_5620":839,"_30634":703,"_25947":48318,"_5":30900,"_12136":47914,"_2302":48319},[],"**Expected Authenticator** (`expected_authenticator`): respuesta compartida que se compara contra el control `id-regCtrl-authenticator` (RFC 4211 §6.2) cuando una solicitud de emisión (`ir`/`cr`/`kur`) lo incluye. Vacío por defecto: un control presente se acepta sin comparar su valor. Con valor configurado, un control cuyo contenido no coincide se rechaza con `incorrectData`. **Marcado como legado**: almacena un secreto en claro en el DMS; la configuración nueva debe usar los controles `registration_token`/`authenticator_control` por operación, que solo almacenan un modo.",{"_5620":840,"_30634":703,"_25947":48321,"_5":30900,"_12136":47918,"_2302":48322},[],"Además de los campos generales anteriores, cada operación CMP tiene su propio bloque de configuración con un interruptor `enabled` y una política específica. Las operaciones de emisión (`ir`, `cr`, `p10cr`, `kur`) admiten además `policy_overrides`:",{"_5620":841,"_30634":703,"_25947":48324,"_5":30900,"_12136":47918,"_2302":48325},[],"`policy_overrides.workflow`: `inherit` (toma el `workflow` general), `direct` o `phased`.",{"_5620":842,"_30634":703,"_25947":48327,"_5":30900,"_12136":47918,"_2302":48328},[],"`policy_overrides.confirmation`: `inherit`, `implicit` (fuerza disposición a la confirmación implícita) o `explicit` (fuerza el `certConf`).",{"_5620":843,"_30634":703,"_25947":48330,"_5":30900,"_12136":47918,"_2302":48331},[],"`policy_overrides.issuance_profile_id`: fija un perfil de emisión específico para esa operación. Se aplica en `ir`, `cr` y `p10cr`; el `kur` renueva siempre con el perfil general del DMS.",{"_5620":844,"_30634":703,"_25947":48333,"_5":30900,"_12136":47918,"_2302":48334},[],"La confirmación implícita efectiva siempre requiere además que el dispositivo la pida (`id-it-implicitConfirm`): el ajuste solo expresa la disposición del servidor.",{"_5620":845,"_30634":703,"_25947":48336,"_5":30900,"_12136":47918,"_2302":48337},[],"Cada bloque por operación detecta si nunca se configuró observando un **campo clave**: `identity_source` en `ir`, `certificate_behavior` en `cr`, `key_policy` en `kur`, `authorization` en `rr`, `access_policy` en `genm` y `workflow` en `ccr`. Si ese campo llega vacío, el bloque se rellena íntegro con sus valores por defecto en cada lectura del DMS — incluido cualquier otro campo que se haya enviado. Para ajustar un campo secundario (por ejemplo, `maximum_active_certificates` de `cr`) debe fijarse también el campo clave del bloque, o la resolución lo devuelve a su valor por defecto. `p10cr` no tiene campo clave: permanece deshabilitado salvo que se ponga `enabled: true` explícitamente.",{"_5620":846,"_30634":703,"_25947":48339,"_5":30900,"_12136":47922,"_2302":48340},[],"Alta inicial de un dispositivo nuevo (RFC 9483 §4.1.1), equivalente al `/simpleenroll` de EST. Habilitado por defecto.",{"_5620":847,"_30634":703,"_25947":48342,"_5":30900,"_12136":47922,"_2302":48193},[],{"_5620":848,"_30634":703,"_25947":48344,"_5":30900,"_12136":47922,"_2302":46038},[],{"_5620":849,"_30634":703,"_25947":48346,"_5":30900,"_12136":47922,"_2302":48347},[],"`enabled`",{"_5620":850,"_30634":703,"_25947":48349,"_5":30900,"_12136":47922,"_2302":48350},[],"Habilita la operación. Deshabilitarla rechaza cualquier `ir` con `notAuthorized`.",{"_5620":851,"_30634":703,"_25947":48352,"_5":30900,"_12136":47922,"_2302":48353},[],"`proof_of_possession.required`",{"_5620":852,"_30634":703,"_25947":48355,"_5":30900,"_12136":47922,"_2302":48356},[],"Si la POPO es obligatoria. Por defecto `true`: un `ir` sin prueba de posesión aceptable se rechaza con `badPOP`.",{"_5620":853,"_30634":703,"_25947":48358,"_5":30900,"_12136":47922,"_2302":48359},[],"`proof_of_possession.allowed_methods`",{"_5620":854,"_30634":703,"_25947":48361,"_5":30900,"_12136":47922,"_2302":48362},[],"Métodos de POPO aceptados: `signature` (POPOSigningKey sobre el CertRequest), `trusted_ra` (`raVerified` de una RA de confianza con EKU `id-kp-cmcRA`), `challenge_response` (reto-respuesta `popdecc`/`popdecr`) y `encrypted_certificate` (el certificado se entrega cifrado al destinatario, que demuestra posesión al descifrarlo). Por defecto `signature` + `trusted_ra`. Una lista vacía no admite ningún método.",{"_5620":855,"_30634":703,"_25947":48364,"_5":30900,"_12136":47922,"_2302":48365},[],"`registration_token`",{"_5620":856,"_30634":703,"_25947":48367,"_5":30900,"_12136":47922,"_2302":48368},[],"Control RFC 4211 §6.1 con modo `disabled` (por defecto), `optional` o `required`. El modo gobierna la **presencia** del control: `disabled` rechaza un `ir` que lo traiga; `required` exige traerlo; `optional` lo procesa cuando está presente. Los valores de regToken son credenciales de un solo uso, aprovisionadas fuera del DMS (nunca se almacenan en la configuración): un valor ya consumido se rechaza con `the regToken control was already used (RFC 4211 §6.1)`, y el token se quema aunque la emisión falle después.",{"_5620":857,"_30634":703,"_25947":48370,"_5":30900,"_12136":47922,"_2302":48371},[],"`authenticator_control`",{"_5620":858,"_30634":703,"_25947":48373,"_5":30900,"_12136":47922,"_2302":48374},[],"Control RFC 4211 §6.2 con los mismos tres modos. Con `expected_authenticator` configurado, `optional`/`required` validan el valor; sin él, la presencia basta.",{"_5620":859,"_30634":703,"_25947":48376,"_5":30900,"_12136":47922,"_2302":48377},[],"`central_key_generation.allowed_recipient_methods`",{"_5620":860,"_30634":703,"_25947":48379,"_5":30900,"_12136":47922,"_2302":48380},[],"Métodos de entrega de la clave generada que acepta esta operación: `rsa_key_transport` y/o `ecdh_key_agreement`. Sin configurar se aceptan ambos; una lista explícitamente vacía deniega cualquier entrega de clave generada.",{"_5620":861,"_30634":703,"_25947":48382,"_5":30900,"_12136":47922,"_2302":48383},[],"`central_key_generation.enabled`",{"_5620":862,"_30634":703,"_25947":48385,"_5":30900,"_12136":47922,"_2302":48386},[],"Se funde con el interruptor general `server_key_gen_enabled` y con el de `cr` en una única puerta de KGA (ver Generación de claves en servidor).",{"_5620":863,"_30634":703,"_25947":48388,"_5":30900,"_12136":47922,"_2302":48389},[],"`identity_source`",{"_5620":864,"_30634":703,"_25947":48391,"_5":30900,"_12136":47922,"_2302":48392},[],"Selecciona de dónde se toma la identidad cuando el subject llega vacío (`subject_only` / `subject_or_san`). **Persistido pero aún no aplicado**: el comportamiento actual es fijo — con subject vacío, la identidad se deduce del SAN (`dNSName`, correo, URI, IP, en ese orden) y el certificado emitido conserva el subject NULL-DN.",{"_5620":865,"_30634":703,"_25947":48394,"_5":30900,"_12136":47922,"_2302":48395},[],"`policy_overrides`",{"_5620":866,"_30634":703,"_25947":48397,"_5":30900,"_12136":47922,"_2302":48398},[],"Ver la introducción de esta sección.",{"_5620":867,"_30634":703,"_25947":48400,"_5":30900,"_12136":47926,"_2302":48401},[],"Emisión para un dispositivo que ya participa en la PKI (RFC 9483 §4.1.2). Habilitado por defecto. Comparte con `ir` la estructura de `proof_of_possession`, `central_key_generation` y `policy_overrides`, y añade:",{"_5620":868,"_30634":703,"_25947":48403,"_5":30900,"_12136":47926,"_2302":48193},[],{"_5620":869,"_30634":703,"_25947":48405,"_5":30900,"_12136":47926,"_2302":46038},[],{"_5620":870,"_30634":703,"_25947":48407,"_5":30900,"_12136":47926,"_2302":48408},[],"`require_existing_device`",{"_5620":871,"_30634":703,"_25947":48410,"_5":30900,"_12136":47926,"_2302":48411},[],"Por defecto `true`: un `cr` contra un dispositivo no registrado se rechaza con `certification request requires a pre-existing device identity`. Desactivarlo permite que un `cr` también dé de alta el dispositivo (sujeto al modo de registro y, si el dispositivo ya existe, a `enable_replaceable_enrollment`).",{"_5620":872,"_30634":703,"_25947":48413,"_5":30900,"_12136":47926,"_2302":48414},[],"`certificate_behavior`",{"_5620":873,"_30634":703,"_25947":48416,"_5":30900,"_12136":47926,"_2302":48417},[],"`additional` (por defecto) emite un certificado más sin revocar el anterior; `replace` sustituye el certificado activo (el anterior se revoca como `superseded` tras emitir y vincular el nuevo). El modelo de datos mantiene un único slot de identidad activa por dispositivo, así que `additional` no crea una segunda identidad activa en paralelo: solo evita revocar la anterior.",{"_5620":874,"_30634":703,"_25947":48419,"_5":30900,"_12136":47926,"_2302":48420},[],"`maximum_active_certificates`",{"_5620":875,"_30634":703,"_25947":48422,"_5":30900,"_12136":47926,"_2302":48423},[],"Límite de certificados no revocados por dispositivo. Por defecto `2`; `0` desactiva el límite. El recuento se revalida bajo bloqueo justo antes de firmar, para cerrar la carrera entre dos `cr` concurrentes.",{"_5620":876,"_30634":703,"_25947":48425,"_5":30900,"_12136":47926,"_2302":48426},[],"`allowed_profile_ids`",{"_5620":877,"_30634":703,"_25947":48428,"_5":30900,"_12136":47926,"_2302":48429},[],"Lista blanca de perfiles de emisión permitidos para esta operación. El perfil resuelto (fijado por `policy_overrides.issuance_profile_id` o el general del DMS) debe estar en la lista; vacía no restringe.",{"_5620":878,"_30634":703,"_25947":48431,"_5":30900,"_12136":47926,"_2302":48432},[],"`cr` hereda además las salvaguardas generales del alta: el dispositivo debe pertenecer a este DMS (un dispositivo registrado en otro DMS se rechaza con `device already registered to another DMS`) y si ya existe se exige `enable_replaceable_enrollment`. Cuando un `cr` con `replace` sustituye la identidad, la política `key_policy` de `kur` también se aplica: con `require_new_key`, el `cr` no puede sustituir el certificado activo usando la misma clave pública.",{"_5620":879,"_30634":703,"_25947":48434,"_5":30900,"_12136":47930,"_2302":48435},[],"Alta con un CSR PKCS#10 completo en lugar de la estructura CRMF (RFC 9483 §4.1.4). **Llega deshabilitado**: hay que activar `enabled: true` en el DMS o toda solicitud `p10cr` se rechaza con `notAuthorized`.",{"_5620":880,"_30634":703,"_25947":48437,"_5":30900,"_12136":47930,"_2302":48193},[],{"_5620":881,"_30634":703,"_25947":48439,"_5":30900,"_12136":47930,"_2302":46038},[],{"_5620":882,"_30634":703,"_25947":48441,"_5":30900,"_12136":47930,"_2302":48347},[],{"_5620":883,"_30634":703,"_25947":48443,"_5":30900,"_12136":47930,"_2302":48444},[],"Habilita la operación. Deshabilitado por defecto.",{"_5620":884,"_30634":703,"_25947":48446,"_5":30900,"_12136":47930,"_2302":48426},[],{"_5620":885,"_30634":703,"_25947":48448,"_5":30900,"_12136":47930,"_2302":48449},[],"Lista blanca de perfiles de emisión permitidos, igual que en `cr`.",{"_5620":886,"_30634":703,"_25947":48451,"_5":30900,"_12136":47930,"_2302":48395},[],{"_5620":887,"_30634":703,"_25947":48453,"_5":30900,"_12136":47930,"_2302":48398},[],{"_5620":888,"_30634":703,"_25947":48455,"_5":30900,"_12136":47930,"_2302":48456},[],"Invariantes fijos del protocolo, no configurables: la firma del propio CSR **es** la prueba de posesión y se verifica siempre; no hay POPO CRMF que configurar; la generación de claves en servidor no está disponible (el cliente aporta su clave); y los controles CRMF de registro (`regToken`, `authenticator`) no aplican. La respuesta es un `cp` con `certReqId` `-1`, valor que el `certConf` posterior debe usar (RFC 4210 Errata 8806).",{"_5620":889,"_30634":703,"_25947":48458,"_5":30900,"_12136":47934,"_2302":48459},[],"Renovación de un certificado (RFC 9483 §4.1.3), equivalente al `/simplereenroll` de EST. Habilitado por defecto. El mensaje debe ir **protegido por firma con el certificado que se renueva** — invariante del protocolo, no configurable.",{"_5620":890,"_30634":703,"_25947":48461,"_5":30900,"_12136":47934,"_2302":48193},[],{"_5620":891,"_30634":703,"_25947":48463,"_5":30900,"_12136":47934,"_2302":46038},[],{"_5620":892,"_30634":703,"_25947":48465,"_5":30900,"_12136":47934,"_2302":48347},[],{"_5620":893,"_30634":703,"_25947":48467,"_5":30900,"_12136":47934,"_2302":48468},[],"Habilita la operación.",{"_5620":894,"_30634":703,"_25947":48470,"_5":30900,"_12136":47934,"_2302":48471},[],"`key_policy`",{"_5620":895,"_30634":703,"_25947":48473,"_5":30900,"_12136":47934,"_2302":48474},[],"`require_new_key` (por defecto) exige una clave pública distinta a la del certificado que se renueva (`key update must present a new key`); `permit_reuse` permite renovar sin rotar la clave.",{"_5620":896,"_30634":703,"_25947":48476,"_5":30900,"_12136":47934,"_2302":48477},[],"`identity_change_policy`",{"_5620":897,"_30634":703,"_25947":48479,"_5":30900,"_12136":47934,"_2302":48480},[],"Cuánto puede variar la identidad respecto al certificado vigente: `forbid` (por defecto; subject y SAN deben coincidir), `san_only` (el subject debe coincidir; el SAN puede variar) o `subject_and_san` (cualquier cambio).",{"_5620":898,"_30634":703,"_25947":48482,"_5":30900,"_12136":47934,"_2302":48483},[],"`policy_overrides.workflow` / `.confirmation`",{"_5620":899,"_30634":703,"_25947":48485,"_5":30900,"_12136":47934,"_2302":48486},[],"Igual que en las demás operaciones de emisión.",{"_5620":900,"_30634":703,"_25947":48488,"_5":30900,"_12136":47934,"_2302":48489},[],"Invariantes fijos: solo puede haber una actualización de clave abierta por certificado (un segundo `kur` mientras el primero espera `certConf` se rechaza con `badRequest`); la identidad anterior sigue activa hasta la confirmación; y un certificado nuevo nunca confirmado se revoca al expirar la ventana. El control opcional `id-regCtrl-oldCertID`, si se envía, debe referenciar exactamente el certificado que se renueva (`badCertId` en caso contrario). `policy_overrides.issuance_profile_id` está definido en el esquema pero **aún no aplicado** en `kur`.",{"_5620":901,"_30634":703,"_25947":48491,"_5":30900,"_12136":47938,"_2302":48492},[],"Revocación vía CMP (RFC 9483 §4.2). Habilitado por defecto. El mensaje **siempre debe ir protegido por firma** — invariante del protocolo, independientemente del `auth_mode`: un `rr` sin firma nunca se acepta, ni siquiera en modo `NO_AUTH`.",{"_5620":902,"_30634":703,"_25947":48494,"_5":30900,"_12136":47938,"_2302":48193},[],{"_5620":903,"_30634":703,"_25947":48496,"_5":30900,"_12136":47938,"_2302":46038},[],{"_5620":904,"_30634":703,"_25947":48498,"_5":30900,"_12136":47938,"_2302":48347},[],{"_5620":905,"_30634":703,"_25947":48500,"_5":30900,"_12136":47938,"_2302":48468},[],{"_5620":906,"_30634":703,"_25947":48502,"_5":30900,"_12136":47938,"_2302":48503},[],"`authorization`",{"_5620":907,"_30634":703,"_25947":48505,"_5":30900,"_12136":47938,"_2302":48506},[],"`self_only` (por defecto): solo el propio dispositivo puede revocar su certificado — el firmante del mensaje debe ser el certificado revocado. `self_and_trusted_ra`: una entidad de gestión PKI de confianza (EKU `id-kp-cmcRA` validado contra las CAs del DMS) puede además revocar el certificado de otro.",{"_5620":908,"_30634":703,"_25947":48508,"_5":30900,"_12136":47938,"_2302":48509},[],"`allow_revival`",{"_5620":909,"_30634":703,"_25947":48511,"_5":30900,"_12136":47938,"_2302":48512},[],"Por defecto desactivado. Permite reactivar un certificado en estado revocado mediante la razón `removeFromCRL`; la reactivación solo es posible sobre certificados cuya revocación fue una suspensión (`certificateHold`).",{"_5620":910,"_30634":703,"_25947":48514,"_5":30900,"_12136":47938,"_2302":48515},[],"`allowed_reasons`",{"_5620":911,"_30634":703,"_25947":48517,"_5":30900,"_12136":47938,"_2302":48518},[],"Lista blanca de razones de revocación aceptadas. Por defecto `unspecified`, `key_compromise`, `cessation_of_operation` y `superseded`. Valores admitidos: `unspecified`, `key_compromise`, `ca_compromise`, `affiliation_changed`, `superseded`, `cessation_of_operation`, `privilege_withdrawn`, `aa_compromise`. La razón `certificateHold` no está en la lista ni está sujeta a ella: suspende el certificado y es la única revocación reversible; la reactivación la gobierna `allow_revival`.",{"_5620":912,"_30634":703,"_25947":48520,"_5":30900,"_12136":47938,"_2302":48521},[],"`trusted_ra.require_cmc_ra_eku`",{"_5620":913,"_30634":703,"_25947":48523,"_5":30900,"_12136":47938,"_2302":48524},[],"Por defecto `true`: exige el EKU `id-kp-cmcRA` en el firmante RA.",{"_5620":914,"_30634":703,"_25947":48526,"_5":30900,"_12136":47938,"_2302":48527},[],"`trusted_ra.validation_ca_ids`",{"_5620":915,"_30634":703,"_25947":48529,"_5":30900,"_12136":47938,"_2302":48530},[],"Fija qué CAs deben validar el certificado del RA; una lista explícita sustituye el límite general. Vacío: se aplica el límite de confianza general del DMS (la `EnrollmentCA` más las CAs de validación de autenticación y de re-enrollment).",{"_5620":916,"_30634":703,"_25947":48532,"_5":30900,"_12136":47938,"_2302":48533},[],"Notas operativas: la revocación de un certificado ya caducado nunca está permitida (el servicio de CA rechaza transiciones de estado sobre certificados expirados); el certificado objetivo debe pertenecer a un dispositivo gestionado por este DMS — un RA de confianza no puede revocar certificados de otros DMS (`notAuthorized`); mientras un certificado tenga una actualización de clave pendiente de confirmar, su estado no puede cambiar (`badRequest`); y un `rr` no puede repetirse con el mismo `transactionID` (`transactionIdInUse`).",{"_5620":917,"_30634":703,"_25947":48535,"_5":30900,"_12136":47942,"_2302":48536},[],"Canal de descubrimiento (RFC 9483 §4.3): el dispositivo consulta capacidades del DMS y este responde con un `genp`. No emite certificados. Habilitado por defecto.",{"_5620":918,"_30634":703,"_25947":48538,"_5":30900,"_12136":47942,"_2302":48193},[],{"_5620":919,"_30634":703,"_25947":48540,"_5":30900,"_12136":47942,"_2302":46038},[],{"_5620":920,"_30634":703,"_25947":48542,"_5":30900,"_12136":47942,"_2302":48543},[],"`access_policy`",{"_5620":921,"_30634":703,"_25947":48545,"_5":30900,"_12136":47942,"_2302":48546},[],"`public_discovery` (por defecto) responde sin exigir mensaje protegido; `require_signed` rechaza un `genm` sin firma con `notAuthorized`.",{"_5620":922,"_30634":703,"_25947":48548,"_5":30900,"_12136":47942,"_2302":48549},[],"`preferred_symmetric_algorithm`",{"_5620":923,"_30634":703,"_25947":48551,"_5":30900,"_12136":47942,"_2302":48552},[],"Algoritmo simétrico que el DMS anuncia para el cifrado de contenido hacia la CA: `aes128_cbc`, `aes192_cbc`, `aes256_cbc` (por defecto), `aes128_gcm`, `aes192_gcm` o `aes256_gcm`.",{"_5620":924,"_30634":703,"_25947":48554,"_5":30900,"_12136":47942,"_2302":48555},[],"`information_types.*`",{"_5620":925,"_30634":703,"_25947":48557,"_5":30900,"_12136":47942,"_2302":48558},[],"Interruptores independientes por tipo de información — ver la tabla siguiente.",{"_5620":926,"_30634":703,"_25947":48560,"_5":30900,"_12136":47942,"_2302":48561},[],"Cada interruptor `information_types.*` corresponde a un tipo de información del RFC 9483 §4.3. Los tipos puramente descriptivos (estáticos) están activados por defecto; los que dependen de la configuración concreta del DMS — sus CAs, su perfil de emisión o su cliente VA — quedan desactivados hasta que el operador los habilite:",{"_5620":927,"_30634":703,"_25947":48563,"_5":30900,"_12136":47942,"_2302":48564},[],"Tipo de información",{"_5620":928,"_30634":703,"_25947":48566,"_5":30900,"_12136":47942,"_2302":48567},[],"OID (`id-it-*`)",{"_5620":929,"_30634":703,"_25947":48569,"_5":30900,"_12136":47942,"_2302":48570},[],"Por defecto",{"_5620":930,"_30634":703,"_25947":48572,"_5":30900,"_12136":47942,"_2302":48573},[],"Contenido de la respuesta",{"_5620":931,"_30634":703,"_25947":48575,"_5":30900,"_12136":47942,"_2302":48576},[],"`ca_certificates`",{"_5620":932,"_30634":703,"_25947":48578,"_5":30900,"_12136":47942,"_2302":48579},[],"`caCerts` (17)",{"_5620":933,"_30634":703,"_25947":48581,"_5":30900,"_12136":47942,"_2302":48582},[],"Activado",{"_5620":934,"_30634":703,"_25947":48584,"_5":30900,"_12136":47942,"_2302":48585},[],"Certificados de las CAs del DMS, con la misma distribución de confianza que el `/cacerts` de EST.",{"_5620":935,"_30634":703,"_25947":48587,"_5":30900,"_12136":47942,"_2302":48588},[],"`signing_key_types`",{"_5620":936,"_30634":703,"_25947":48590,"_5":30900,"_12136":47942,"_2302":48591},[],"`signKeyPairTypes` (2)",{"_5620":937,"_30634":703,"_25947":48593,"_5":30900,"_12136":47942,"_2302":48582},[],{"_5620":938,"_30634":703,"_25947":48595,"_5":30900,"_12136":47942,"_2302":48596},[],"Algoritmos de firma admitidos: RSA y ECC (valor estático).",{"_5620":939,"_30634":703,"_25947":48598,"_5":30900,"_12136":47942,"_2302":48599},[],"`encryption_key_types`",{"_5620":940,"_30634":703,"_25947":48601,"_5":30900,"_12136":47942,"_2302":48602},[],"`encKeyPairTypes` (3)",{"_5620":941,"_30634":703,"_25947":48604,"_5":30900,"_12136":47942,"_2302":48582},[],{"_5620":942,"_30634":703,"_25947":48606,"_5":30900,"_12136":47942,"_2302":48607},[],"Algoritmos de cifrado/acuerdo admitidos: RSA (valor estático).",{"_5620":943,"_30634":703,"_25947":48609,"_5":30900,"_12136":47942,"_2302":48549},[],{"_5620":944,"_30634":703,"_25947":48611,"_5":30900,"_12136":47942,"_2302":48612},[],"`preferredSymmAlg` (4)",{"_5620":945,"_30634":703,"_25947":48614,"_5":30900,"_12136":47942,"_2302":48582},[],{"_5620":946,"_30634":703,"_25947":48616,"_5":30900,"_12136":47942,"_2302":48617},[],"El algoritmo configurado en `preferred_symmetric_algorithm`.",{"_5620":947,"_30634":703,"_25947":48619,"_5":30900,"_12136":47942,"_2302":48620},[],"`supported_languages`",{"_5620":948,"_30634":703,"_25947":48622,"_5":30900,"_12136":47942,"_2302":48623},[],"`supportedLangTags` (16)",{"_5620":949,"_30634":703,"_25947":48625,"_5":30900,"_12136":47942,"_2302":48582},[],{"_5620":950,"_30634":703,"_25947":48627,"_5":30900,"_12136":47942,"_2302":48628},[],"Negociación de idioma para `PKIFreeText`; el único soportado es `en`.",{"_5620":951,"_30634":703,"_25947":48630,"_5":30900,"_12136":47942,"_2302":48631},[],"`root_ca_update`",{"_5620":952,"_30634":703,"_25947":48633,"_5":30900,"_12136":47942,"_2302":48634},[],"`rootCaCert` (20)",{"_5620":953,"_30634":703,"_25947":48636,"_5":30900,"_12136":47942,"_2302":48637},[],"Desactivado",{"_5620":954,"_30634":703,"_25947":48639,"_5":30900,"_12136":47942,"_2302":48640},[],"Actualización de la raíz vigente (`newWithNew`/`newWithOld`), comparada contra la raíz que el dispositivo declara.",{"_5620":955,"_30634":703,"_25947":48642,"_5":30900,"_12136":47942,"_2302":48643},[],"`certificate_request_template`",{"_5620":956,"_30634":703,"_25947":48645,"_5":30900,"_12136":47942,"_2302":48646},[],"`certReqTemplate` (19)",{"_5620":957,"_30634":703,"_25947":48648,"_5":30900,"_12136":47942,"_2302":48637},[],{"_5620":958,"_30634":703,"_25947":48650,"_5":30900,"_12136":47942,"_2302":48651},[],"Plantilla derivada del perfil de emisión del DMS: algoritmos y tamaños de clave admitidos y validez del certificado.",{"_5620":959,"_30634":703,"_25947":48653,"_5":30900,"_12136":47942,"_2302":48654},[],"`current_crl`",{"_5620":960,"_30634":703,"_25947":48656,"_5":30900,"_12136":47942,"_2302":48657},[],"`currentCRL` (6)",{"_5620":961,"_30634":703,"_25947":48659,"_5":30900,"_12136":47942,"_2302":48637},[],{"_5620":962,"_30634":703,"_25947":48661,"_5":30900,"_12136":47942,"_2302":48662},[],"CRL vigente, servida a través del cliente VA del servicio DMS Manager.",{"_5620":963,"_30634":703,"_25947":48664,"_5":30900,"_12136":47942,"_2302":48665},[],"`crl_update`",{"_5620":964,"_30634":703,"_25947":48667,"_5":30900,"_12136":47942,"_2302":48668},[],"`crlStatusList` (22)",{"_5620":965,"_30634":703,"_25947":48670,"_5":30900,"_12136":47942,"_2302":48637},[],{"_5620":966,"_30634":703,"_25947":48672,"_5":30900,"_12136":47942,"_2302":48673},[],"Actualizaciones de CRL por emisor, solo las más recientes que la que el dispositivo declara.",{"_5620":967,"_30634":703,"_25947":48675,"_5":30900,"_12136":47942,"_2302":48676},[],"`protocol_encryption_certificate`",{"_5620":968,"_30634":703,"_25947":48678,"_5":30900,"_12136":47942,"_2302":48679},[],"`caProtEncCert` (1)",{"_5620":969,"_30634":703,"_25947":48681,"_5":30900,"_12136":47942,"_2302":48637},[],{"_5620":970,"_30634":703,"_25947":48683,"_5":30900,"_12136":47942,"_2302":48684},[],"Siempre se responde sin valor — Lamassu no provisiona un certificado de cifrado de protocolo dedicado.",{"_5620":971,"_30634":703,"_25947":48686,"_5":30900,"_12136":47942,"_2302":48687},[],"Reglas del intercambio: un `genm` que solicite un tipo deshabilitado se rechaza por completo con `notAuthorized`; los tipos `caCerts`, `certReqTemplate`, `currentCRL`, `signKeyPairTypes`, `encKeyPairTypes` y `preferredSymmAlg` deben llegar sin `infoValue`; `supportedLangTags` debe llegar con la lista de lenguajes ofrecidos (si no se soporta ninguno, `badRequest`); `crlStatusList` debe llevar al menos una entrada `CRLStatus`. Un tipo habilitado cuyo proveedor de datos no tenga nada que devolver (por ejemplo, un DMS sin cliente VA para los tipos de CRL, o una raíz sin actualización más reciente) responde con el `infoValue` ausente — un *no disponible* válido según el RFC, no un error. El tipo `id-it-revPassphrase` (RFC 4210bis §5.3.19.9) está deshabilitado de forma permanente: no está conectado al flujo de revocación.",{"_5620":972,"_30634":703,"_25947":48689,"_5":30900,"_12136":47946,"_2302":48690},[],"Certificación cruzada entre CAs (RFC 4210bis §5.3.11): una CA pide a la CA de enrolamiento del DMS un certificado cruzado para su identidad. Es una operación privilegiada CA-a-CA, **deshabilitada por defecto**.",{"_5620":973,"_30634":703,"_25947":48692,"_5":30900,"_12136":47946,"_2302":48193},[],{"_5620":974,"_30634":703,"_25947":48694,"_5":30900,"_12136":47946,"_2302":46038},[],{"_5620":975,"_30634":703,"_25947":48696,"_5":30900,"_12136":47946,"_2302":48347},[],{"_5620":976,"_30634":703,"_25947":48698,"_5":30900,"_12136":47946,"_2302":48444},[],{"_5620":977,"_30634":703,"_25947":48700,"_5":30900,"_12136":47946,"_2302":48296},[],{"_5620":978,"_30634":703,"_25947":48702,"_5":30900,"_12136":47946,"_2302":48703},[],"`administrator_approval` (por defecto) o `direct`. Es independiente del `workflow` general de enrollment: la aprobación administrativa de un `ccr` no se mezcla con la de `ir`/`cr`. Con `administrator_approval`, la solicitud queda `PENDING` (tipo `ccr`) y el CA solicitante recupera el certificado cruzado con `pollReq`.",{"_5620":979,"_30634":703,"_25947":48705,"_5":30900,"_12136":47946,"_2302":48706},[],"`requester_mode`",{"_5620":980,"_30634":703,"_25947":48708,"_5":30900,"_12136":47946,"_2302":48709},[],"`any` (por defecto): cualquier firmante que supere `require_ca_certificate` puede solicitar. `restricted`: el firmante debe encadenar a una CA de `trusted_requester_ca_ids` — una lista vacía en modo `restricted` **no autoriza a nadie**.",{"_5620":981,"_30634":703,"_25947":48711,"_5":30900,"_12136":47946,"_2302":48712},[],"`trusted_requester_ca_ids`",{"_5620":982,"_30634":703,"_25947":48714,"_5":30900,"_12136":47946,"_2302":48715},[],"CAs autorizadas en modo `restricted`.",{"_5620":983,"_30634":703,"_25947":48717,"_5":30900,"_12136":47946,"_2302":48718},[],"`require_ca_certificate`",{"_5620":984,"_30634":703,"_25947":48720,"_5":30900,"_12136":47946,"_2302":48721},[],"Por defecto `true`: el certificado de protección del firmante debe ser un certificado de CA.",{"_5620":985,"_30634":703,"_25947":48723,"_5":30900,"_12136":47946,"_2302":48724},[],"`require_proof_of_possession`",{"_5620":986,"_30634":703,"_25947":48726,"_5":30900,"_12136":47946,"_2302":48727},[],"Por defecto `true`: exige una POPO de tipo `POPOSigningKey` sobre la clave del `CertTemplate`. Las POPO de tipo `EncryptedKey` (que revelarían la clave privada del solicitante) se rechazan siempre, con o sin esta opción.",{"_5620":987,"_30634":703,"_25947":48729,"_5":30900,"_12136":47946,"_2302":48730},[],"`maximum_validity`",{"_5620":988,"_30634":703,"_25947":48732,"_5":30900,"_12136":47946,"_2302":48733},[],"Validez máxima del certificado cruzado. Por defecto &#x2A;*8760 horas (365 días)**. El `notBefore` solicitado se respeta tal cual (puede estar en el pasado) y el `notAfter` se **trunca** a este límite, no se rechaza.",{"_5620":989,"_30634":703,"_25947":48735,"_5":30900,"_12136":47946,"_2302":48736},[],"`subject_constraints`",{"_5620":990,"_30634":703,"_25947":48738,"_5":30900,"_12136":47946,"_2302":48739},[],"Restricciones de identidad del certificado cruzado: `allowed_dn_patterns` (coincidencia por subcadena del subject en formato RFC 2253) y `allowed_dns_suffixes` (coincidencia por sufijo del SAN `dNSName`). Una lista vacía en una dimensión no impone restricción en esa dimensión — a diferencia de la lista de `central_key_generation`, que vacía deniega todo.",{"_5620":991,"_30634":703,"_25947":48741,"_5":30900,"_12136":47946,"_2302":48742},[],"`issuance_profile_id`",{"_5620":992,"_30634":703,"_25947":48744,"_5":30900,"_12136":47946,"_2302":48745},[],"**Persistido pero aún no aplicado**: el certificado cruzado se emite con un perfil interno fijo (`CMP Cross Certification`), que produce un certificado de CA con `keyCertSign`, `cRLSign` y `digitalSignature`.",{"_5620":993,"_30634":703,"_25947":48747,"_5":30900,"_12136":47946,"_2302":48748},[],"El `ccr` exige además: `CertTemplate` completo (versión, algoritmo de firma, emisor, validez, subject y clave pública; versión v3 o v1, no v2), una clave con capacidad de firma (las claves solo de acuerdo, como X25519/X448, se rechazan) y ninguna solicitud de generación de claves en servidor. No está pensado para inscripción de dispositivos, sino para interoperabilidad entre PKIs.",{"_5620":994,"_30634":703,"_25947":48750,"_5":30900,"_12136":47950,"_2302":48751},[],"CMP permite que el propio DMS genere el par de claves del dispositivo cuando la solicitud (`ir`/`cr`) llega con la clave pública vacía en el `CertTemplate` (RFC 9483 §4.1.6, también llamado **KGA**, Key Generation Authority).",{"_5620":995,"_30634":703,"_25947":48753,"_5":30900,"_12136":47950,"_2302":48193},[],{"_5620":996,"_30634":703,"_25947":48755,"_5":30900,"_12136":47950,"_2302":48274},[],{"_5620":997,"_30634":703,"_25947":48757,"_5":30900,"_12136":47950,"_2302":46038},[],{"_5620":998,"_30634":703,"_25947":48759,"_5":30900,"_12136":47950,"_2302":48760},[],"`server_key_gen_enabled`",{"_5620":999,"_30634":703,"_25947":48762,"_5":30900,"_12136":47950,"_2302":29519},[],{"_5620":1000,"_30634":703,"_25947":48764,"_5":30900,"_12136":47950,"_2302":48765},[],"Habilita la generación de claves en servidor. Desactivado por defecto: una solicitud con clave pública vacía se rechaza con `notAuthorized`. Este interruptor y los `central_key_generation.enabled` de `ir`/`cr` se resuelven en una única puerta: basta activar cualquiera de los tres, y el valor resultante se reescribe en los tres.",{"_5620":1001,"_30634":703,"_25947":48767,"_5":30900,"_12136":47950,"_2302":48768},[],"`ckg_trusted_encryption_cas`",{"_5620":1002,"_30634":703,"_25947":48770,"_5":30900,"_12136":47950,"_2302":48771},[],"lista de IDs de CA",{"_5620":1003,"_30634":703,"_25947":48773,"_5":30900,"_12136":47950,"_2302":48774},[],"CAs a las que debe encadenar el certificado destinatario (el certificado al que se cifra la clave generada — el propio certificado de protección del solicitante). Vacío por defecto: en ese caso se aplica el límite de confianza general del DMS (la `EnrollmentCA` más las CAs de validación de `auth_mode` y de `reenrollment_settings.additional_validation_cas`). Una lista explícita **sustituye** ese límite: el destinatario debe encadenar a alguna de las CAs listadas. La validación del destinatario es incondicional, también con `auth_mode: NO_AUTH`: KGA entrega material de clave privada, así que es un límite de confianza independiente del modo de autenticación.",{"_5620":1004,"_30634":703,"_25947":48776,"_5":30900,"_12136":47950,"_2302":48777},[],"El flujo del servidor: genera la clave con el algoritmo implícito en la solicitud (RSA-2048 si el `CertTemplate` no declara algoritmo; ECDSA P-256 si declara ECC), emite el certificado por la vía normal de enrollment y devuelve en la misma respuesta `ip`/`cp` el certificado junto con la clave privada PKCS#8 envuelta en una estructura CMS `EnvelopedData`(`SignedData`(`AsymmetricKeyPackage`)). El destinatario es el certificado de protección del solicitante: con clave RSA se usa transporte de clave (`rsa_key_transport`), que exige `keyEncipherment` en el destinatario; con clave ECC se usa acuerdo de clave ECDH (`ecdh_key_agreement`), que exige `keyAgreement`. Un destinatario fuera del límite de confianza se rechaza con `signerNotTrusted`.",{"_5620":1005,"_30634":703,"_25947":48779,"_5":30900,"_12136":47950,"_2302":48780},[],"La clave generada por KGA se produce con el motor criptográfico software del proceso (no con AWS KMS, PKCS#11 ni ningún Crypto Engine de hardware), porque la clave debe poder exportarse cifrada hacia el dispositivo — algo incompatible por diseño con un HSM que nunca expone claves privadas. La clave existe en memoria del proceso únicamente durante la duración de la solicitud y nunca se persiste: si el dispositivo pierde la respuesta, no puede recuperarla con `pollReq` — debe repetir la inscripción con un nuevo `transactionID`. Para el transporte, el DMS emite además certificados auxiliares efímeros (`Lamassu CMP KGA Signer` con EKU `id-kp-cmKGA`, y `Lamassu CMP KARI Originator` para el acuerdo ECDH), con validez de una hora y firmados por la CA de enrolamiento. Prefiera la generación de clave en el propio dispositivo siempre que sea posible; reserve KGA para dispositivos que genuinamente no puedan generar su propia clave.",{"_5620":1006,"_30634":703,"_25947":48782,"_5":30900,"_12136":47954,"_2302":48783},[],"La sección `reenrollment_settings` del bloque CMP gobierna la renovación (`kur`) con los mismos campos que EST:",{"_5620":1007,"_30634":703,"_25947":48785,"_5":30900,"_12136":47954,"_2302":48193},[],{"_5620":1008,"_30634":703,"_25947":48787,"_5":30900,"_12136":47954,"_2302":48788},[],"Efecto en CMP",{"_5620":1009,"_30634":703,"_25947":48790,"_5":30900,"_12136":47954,"_2302":48791},[],"`additional_validation_cas`",{"_5620":1010,"_30634":703,"_25947":48793,"_5":30900,"_12136":47954,"_2302":48794},[],"CAs adicionales aceptadas como emisoras del certificado en vigor durante la renovación. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados.",{"_5620":1011,"_30634":703,"_25947":48796,"_5":30900,"_12136":47954,"_2302":48797},[],"`revoke_on_reenrollment`",{"_5620":1012,"_30634":703,"_25947":48799,"_5":30900,"_12136":47954,"_2302":48800},[],"Revoca el certificado anterior con la razón `superseded` una vez emitido y confirmado el nuevo. En el alta (`ir`/`cr`/`p10cr`) controla si la sustitución de la identidad revoca el certificado anterior.",{"_5620":1013,"_30634":703,"_25947":48802,"_5":30900,"_12136":47954,"_2302":48803},[],"`enable_expired_renewal`",{"_5620":1014,"_30634":703,"_25947":48805,"_5":30900,"_12136":47954,"_2302":48806},[],"Permite usar un certificado ya caducado como credencial de protección del `kur`.",{"_5620":1015,"_30634":703,"_25947":48808,"_5":30900,"_12136":47954,"_2302":48809},[],"`reenrollment_delta`",{"_5620":1016,"_30634":703,"_25947":48811,"_5":30900,"_12136":47954,"_2302":48812},[],"**No se aplica a CMP.** La ventana previa a la caducidad que limita el `/simplereenroll` de EST no restringe el `kur` de CMP; la política de cuándo renovar es del dispositivo.",{"_5620":1017,"_30634":703,"_25947":48814,"_5":30900,"_12136":47954,"_2302":48815},[],"`preventive_delta` / `critical_delta`",{"_5620":1018,"_30634":703,"_25947":48817,"_5":30900,"_12136":47954,"_2302":48818},[],"Umbrales para las alertas de renovación preventiva y crítica. Se materializan sobre los metadatos del certificado al vincular la identidad, igual que en EST.",{"_5620":1019,"_30634":703,"_25947":48820,"_5":30900,"_12136":47954,"_2302":48821},[],"La política de clave e identidad del `kur` (qué puede cambiar y si la clave debe rotar) vive en su bloque por operación, descrito en Ajustes por operación.",{"_5620":1020,"_30634":703,"_25947":48823,"_5":30900,"_12136":47958,"_2302":48824},[],"Cada `ir`/`cr`/`kur`/`p10cr`/`ccr` recibido por un DMS en CMP queda registrado como una **transacción CMP**, identificada por el `transactionID` hexadecimal del `PKIHeader`. El registro conserva el estado, el certificado emitido (sin el DER en la respuesta de la API), el método de prueba de posesión empleado y el `auth_mode` vigente en el momento del alta. Cuando la integración WFX está activa, cada transición de la transacción se refleja además como un job de workflow con los mensajes del intercambio adjuntos — ver Integración con WFX.",{"_5620":1021,"_30634":703,"_25947":48826,"_5":30900,"_12136":47958,"_2302":48827},[],"Estado",{"_5620":1022,"_30634":703,"_25947":48829,"_5":30900,"_12136":47958,"_2302":48830},[],"Significado",{"_5620":1023,"_30634":703,"_25947":48832,"_5":30900,"_12136":47958,"_2302":48833},[],"`PENDING`",{"_5620":1024,"_30634":703,"_25947":48835,"_5":30900,"_12136":47958,"_2302":48836},[],"Solicitud aceptada, pendiente de emisión: flujo `phased` esperando aprobación, o `ir`/`cr` esperando el `popdecr` de una POPO por reto-respuesta.",{"_5620":1025,"_30634":703,"_25947":48838,"_5":30900,"_12136":47958,"_2302":48839},[],"`ISSUED`",{"_5620":1026,"_30634":703,"_25947":48841,"_5":30900,"_12136":47958,"_2302":48842},[],"Certificado emitido, a la espera de `certConf` del dispositivo.",{"_5620":1027,"_30634":703,"_25947":48844,"_5":30900,"_12136":47958,"_2302":48845},[],"`CONFIRMED`",{"_5620":1028,"_30634":703,"_25947":48847,"_5":30900,"_12136":47958,"_2302":48848},[],"El dispositivo confirmó la recepción con `certConf` (o se concedió confirmación implícita). Estado terminal.",{"_5620":1029,"_30634":703,"_25947":48850,"_5":30900,"_12136":47958,"_2302":48851},[],"`ISSUE_FAILED`",{"_5620":1030,"_30634":703,"_25947":48853,"_5":30900,"_12136":47958,"_2302":48854},[],"La CA rechazó la emisión o un administrador rechazó la transacción. El motivo queda disponible para el dispositivo vía `pollReq`. Estado terminal.",{"_5620":1031,"_30634":703,"_25947":48856,"_5":30900,"_12136":47958,"_2302":48857},[],"`REVOKED`",{"_5620":1032,"_30634":703,"_25947":48859,"_5":30900,"_12136":47958,"_2302":48860},[],"El certificado emitido fue revocado (por expiración del plazo de confirmación o por un `rr` posterior). Estado terminal.",{"_5620":1033,"_30634":703,"_25947":48862,"_5":30900,"_12136":47958,"_2302":48863},[],"Internamente, el servidor emplea además los estados transitorios `APPROVING` y `REVOKING` como marcas de bloqueo mientras resuelve una aprobación administrativa o una revocación: suelen durar solo instantes y solo podrían observarse si el servicio se interrumpe a mitad de la operación, caso en el que la tarea de monitorización los finaliza automáticamente. Los estados expuestos por la API de listado son solo los cinco anteriores.",{"_5620":1034,"_30634":703,"_25947":48865,"_5":30900,"_12136":47958,"_2302":48064},[],{"_5620":1035,"_30634":703,"_25947":48867,"_5":30900,"_12136":47958,"_2302":46038},[],{"_5620":1036,"_30634":703,"_25947":48869,"_5":30900,"_12136":47958,"_2302":48870},[],"`GET /v1/dms/{id}/cmp/transactions`",{"_5620":1037,"_30634":703,"_25947":48872,"_5":30900,"_12136":47958,"_2302":48873},[],"Lista paginada de transacciones del DMS (`page_size`, `bookmark`, `sort_by`, `sort_mode` con valores `asc`/`desc`, `filter`). No incluye el DER del certificado; recupérelo desde la API de CAs usando `certificate_serial_number`.",{"_5620":1038,"_30634":703,"_25947":48875,"_5":30900,"_12136":47958,"_2302":48876},[],"`POST /v1/dms/{id}/cmp/transactions/{txid}/approve`",{"_5620":1039,"_30634":703,"_25947":48878,"_5":30900,"_12136":47958,"_2302":48879},[],"Aprueba una transacción `PENDING` de un DMS con flujo `phased`, emitiendo el certificado. El dispositivo lo recupera en su siguiente `pollReq`. La aprobación y el rechazo usan una reclamación atómica del registro, así que dos llamadas concurrentes no emiten el certificado dos veces. Tras aprobar, la ventana de confirmación del dispositivo pasa a ser la de `confirmation_timeout` (mínimo 2 minutos).",{"_5620":1040,"_30634":703,"_25947":48881,"_5":30900,"_12136":47958,"_2302":48882},[],"`POST /v1/dms/{id}/cmp/transactions/{txid}/reject`",{"_5620":1041,"_30634":703,"_25947":48884,"_5":30900,"_12136":47958,"_2302":48885},[],"Rechaza una transacción `PENDING`; pasa a `ISSUE_FAILED` con un motivo opcional (`{\"reason\": \"...\"}`; por defecto `transaction rejected by administrator`) que el dispositivo recibe en su siguiente `pollReq`.",{"_5620":1042,"_30634":703,"_25947":48887,"_5":30900,"_12136":47958,"_2302":48888},[],"Ambas operaciones requieren el permiso de **lectura** para el listado y de **actualización** para aprobar o rechazar, dentro de las acciones del DMS. Las aprobaciones y rechazos solo tienen efecto sobre transacciones `PENDING`: en `workflow: direct` una transacción nace ya en `ISSUED`.",{"_5620":1043,"_30634":703,"_25947":48890,"_5":30900,"_12136":47962,"_2302":48891},[],"Un certificado `ISSUED` que el dispositivo nunca confirma dentro de `confirmation_timeout` queda, por definición del RFC 4210 §5.2.8, en un estado de confianza indeterminado. Un job periódico de fondo — habilitado y programado mediante la clave de configuración del servicio DMS Manager `cmp_confirmation_monitoring_job` (`enabled`, `frequency`; por defecto cada 5 segundos cuando la monitorización global está activa) — se encarga de:",{"_5620":1044,"_30634":703,"_25947":48893,"_5":30900,"_12136":47962,"_2302":48894},[],"**Revocar certificados sin confirmar**: transacciones `ISSUED` cuya ventana de confirmación expiró se revocan en la CA con la razón `cessationOfOperation` y pasan a `REVOKED`. La reclamación atómica del registro impide revocar un certificado que un `certConf` legítimo está confirmando en ese mismo instante.",{"_5620":1045,"_30634":703,"_25947":48896,"_5":30900,"_12136":47962,"_2302":48897},[],"**Cerrar aprobaciones pendientes**: transacciones `PENDING` en flujo `phased` que ningún administrador resolvió dentro de `approval_timeout` pasan a `ISSUE_FAILED` con el motivo `approval window expired`, y se conservan **7 días** para que un `pollReq` tardío pueda ver el motivo del rechazo.",{"_5620":1046,"_30634":703,"_25947":48899,"_5":30900,"_12136":47962,"_2302":48900},[],"Cada ejecución procesa como máximo **100 transacciones** por lote, para evitar una ráfaga de revocaciones tras una interrupción prolongada del servicio.",{"_5620":1047,"_30634":703,"_25947":48902,"_5":30900,"_12136":47966,"_2302":48903},[],"Si el cliente WFX del servicio está habilitado (`wfx.enabled` en la configuración del DMS Manager), cada transición de una transacción CMP se refleja como un job en WFX (motor de workflows de Siemens), bajo dos plantillas predefinidas según el `workflow` del DMS: `lamassu.cmp.transaction.direct.v1` para el flujo directo y `lamassu.cmp.transaction.phased.v1` para el flujo con aprobación administrativa (que añade el estado `AwaitingApproval`). Los estados del workflow — `Received`, `Validated`, `Responded`, `AwaitingCertConf`, `Confirmed`, `LogicallyComplete` (confirmación implícita) y `Rejected` — permiten seguir el ciclo de vida de cada transacción desde el panel de WFX; el job se identifica por el CN del dispositivo y adjunta los mensajes del intercambio codificados en base64. Esto es puramente observabilidad/orquestación externa: si WFX no está habilitado, o si una llamada a WFX falla, la operación CMP en Lamassu no se ve afectada.",{"_5620":1048,"_30634":703,"_25947":48905,"_5":30900,"_12136":47970,"_2302":48906},[],"**Desde la consola**: acceda al detalle del DMS y compruebe que la sección CMP muestra el protocolo activo, la CA de enrolamiento, el certificado de protección y las operaciones habilitadas.",{"_5620":1049,"_30634":703,"_25947":48908,"_5":30900,"_12136":47970,"_2302":48909},[],"**Con el listado de transacciones**: `GET /v1/dms/{id}/cmp/transactions` confirma que el endpoint responde aunque no haya tráfico de dispositivos.",{"_5620":1050,"_30634":703,"_25947":48911,"_5":30900,"_12136":47970,"_2302":48912},[],"**Con una solicitud de prueba**: use `openssl cmp` con el comando `ir` (si dispone de un firmante válido) o `genm` contra el endpoint del DMS — ver Ejemplo con openssl cmp.",{"_5620":1051,"_30634":703,"_25947":48914,"_5":30900,"_12136":47974,"_2302":48915},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_5620":1052,"_30634":703,"_25947":48917,"_5":30900,"_12136":47978,"_2302":48918},[],"El administrador PKI debe haber configurado un DMS con el protocolo `CMP_RFC9483`, una CA de enrolamiento, un certificado de protección y un modo de autenticación. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_5620":1053,"_30634":703,"_25947":48920,"_5":30900,"_12136":47978,"_2302":48921},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_5620":1054,"_30634":703,"_25947":48923,"_5":30900,"_12136":47978,"_2302":48924},[],"Elemento",{"_5620":1055,"_30634":703,"_25947":48926,"_5":30900,"_12136":47978,"_2302":46038},[],{"_5620":1056,"_30634":703,"_25947":48928,"_5":30900,"_12136":47978,"_2302":48929},[],"**URL del host CMP**",{"_5620":1057,"_30634":703,"_25947":48931,"_5":30900,"_12136":47978,"_2302":48932},[],"Dirección base del servidor, por ejemplo `https://cmp.lamassu.example`. La proporciona el administrador PKI.",{"_5620":1058,"_30634":703,"_25947":48934,"_5":30900,"_12136":47978,"_2302":48935},[],"**ID del DMS**",{"_5620":1059,"_30634":703,"_25947":48937,"_5":30900,"_12136":47978,"_2302":48938},[],"Identificador del DMS, incluido en la ruta del endpoint (`/.well-known/cmp/p/{id}`).",{"_5620":1060,"_30634":703,"_25947":48940,"_5":30900,"_12136":47978,"_2302":48941},[],"**Certificado y clave de firma del mensaje**",{"_5620":1061,"_30634":703,"_25947":48943,"_5":30900,"_12136":47978,"_2302":48944},[],"Solo para los modos `CLIENT_CERTIFICATE` y `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK` (y siempre para `kur`/`rr`). A diferencia de EST, no se usa como credencial mTLS: se incluye como `extraCerts[0]` y firma el `PKIMessage`.",{"_5620":1062,"_30634":703,"_25947":48946,"_5":30900,"_12136":47978,"_2302":48947},[],"**Certificado de protección del DMS**",{"_5620":1063,"_30634":703,"_25947":48949,"_5":30900,"_12136":47978,"_2302":48950},[],"El certificado con el que el DMS firma sus respuestas. Los clientes que fijen la identidad del respondedor (por ejemplo `openssl cmp -srvcert`) lo necesitan.",{"_5620":1064,"_30634":703,"_25947":48952,"_5":30900,"_12136":47981,"_2302":48953},[],"CMP se sirve desde un **único endpoint**:",{"_5620":1065,"_30634":703,"_25947":48955,"_5":30900,"_12136":47981,"_2302":48956},[],"donde `{id}` es el identificador del DMS. La ruta sigue el formato de URI *well-known* del RFC 9480 §3.3, por lo que clientes CMP estándar la reconocen sin configuración adicional (`openssl cmp -server <host> -path /.well-known/cmp/p/<dms-id>`).",{"_5620":1066,"_30634":703,"_25947":48958,"_5":30900,"_12136":47981,"_2302":48959},[],"**Content-Type**: `application/pkixcmp` tanto en la solicitud como en la respuesta. Una solicitud con otro `Content-Type` se rechaza con `415 Unsupported Media Type`.",{"_5620":1067,"_30634":703,"_25947":48961,"_5":30900,"_12136":47981,"_2302":48962},[],"**Cuerpo**: un `PKIMessage` en DER binario (no base64, a diferencia de los endpoints EST). La respuesta es igualmente DER binario.",{"_5620":1068,"_30634":703,"_25947":48964,"_5":30900,"_12136":47981,"_2302":48965},[],"**Despacho por contenido, no por ruta**: el servidor decodifica el `PKIMessage`, valida el sobre (versión de protocolo, `transactionID`, `senderNonce`, `messageTime`) y despacha la operación según la etiqueta (`tag`) del `PKIBody` — `ir`, `cr`, `p10cr`, `kur`, `rr`, `certConf`, `pollReq`, `genm`, `ccr`, `nested`, etc.",{"_5620":1069,"_30634":703,"_25947":48967,"_5":30900,"_12136":47981,"_2302":48968},[],"**Sin autenticación a nivel de transporte**: el endpoint no exige mTLS ni cabeceras de autorización; toda la autenticación viaja dentro del mensaje, como se describe en Modelo de autenticación.",{"_5620":1070,"_30634":703,"_25947":48970,"_5":30900,"_12136":47981,"_2302":48971},[],"**Tamaño máximo de solicitud**: 1 MiB. Una solicitud mayor se rechaza antes de intentar decodificarla.",{"_5620":1071,"_30634":703,"_25947":48973,"_5":30900,"_12136":47981,"_2302":48974},[],"Un rechazo llega con `HTTP 200` en la forma que corresponde a la operación: como un `PKIMessage` de error ante fallos previos al despacho (operación deshabilitada, cabecera inválida, protección fallida), como un cuerpo de rechazo dentro de la respuesta de la propia operación (`ip`/`cp`/`kup` con `status: rejection`) ante fallos de política de emisión, o como un cuerpo `rp` con estado de rechazo en las revocaciones. En todos los casos hay que inspeccionar el cuerpo CMP, no solo el código HTTP. Los códigos HTTP de error (`400`, `415` y, ante fallos internos del servidor, `500`) se reservan para los casos en los que no se puede entregar una respuesta CMP válida — ver Códigos de error y diagnóstico.",{"_5620":1072,"_30634":703,"_25947":48976,"_5":30900,"_12136":47985,"_2302":48977},[],"CMP autentica **el mensaje**, no la conexión: no hay handshake mTLS equivalente al de EST. Cuando el `auth_mode` del DMS exige `CLIENT_CERTIFICATE`, el dispositivo debe:",{"_5620":1073,"_30634":703,"_25947":48979,"_5":30900,"_12136":47985,"_2302":48980},[],"Incluir su certificado en el campo `extraCerts` del `PKIMessage` (primera posición).",{"_5620":1074,"_30634":703,"_25947":48982,"_5":30900,"_12136":47985,"_2302":48983},[],"Firmar el `PKIMessage` completo con la clave privada correspondiente a ese certificado (protección basada en firma, RFC 9483 §3.2).",{"_5620":1075,"_30634":703,"_25947":48985,"_5":30900,"_12136":47985,"_2302":48986},[],"Sobre el mensaje protegido, el servidor exige además dos ataduras del RFC 9483: el campo `sender` de la cabecera debe coincidir con el subject del certificado de protección y el `senderKID` debe ser su `SubjectKeyIdentifier`. Una solicitud protegida que incumpla cualquiera se rechaza con `badMessageCheck`. Si un mensaje trae firma aunque el modo no la exija, la firma igualmente se verifica y esas ataduras aplican.",{"_5620":1076,"_30634":703,"_25947":48988,"_5":30900,"_12136":47985,"_2302":48989},[],"El requisito de protección por tipo de mensaje:",{"_5620":1077,"_30634":703,"_25947":48991,"_5":30900,"_12136":47985,"_2302":48992},[],"Mensaje",{"_5620":1078,"_30634":703,"_25947":48994,"_5":30900,"_12136":47985,"_2302":48995},[],"¿Protección obligatoria?",{"_5620":1079,"_30634":703,"_25947":48997,"_5":30900,"_12136":47985,"_2302":48998},[],"`ir`, `cr`, `p10cr`",{"_5620":1080,"_30634":703,"_25947":49000,"_5":30900,"_12136":47985,"_2302":49001},[],"Solo si el `auth_mode` es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_5620":1081,"_30634":703,"_25947":49003,"_5":30900,"_12136":47985,"_2302":47998},[],{"_5620":1082,"_30634":703,"_25947":49005,"_5":30900,"_12136":47985,"_2302":49006},[],"Siempre (la firma es la prueba de posesión de la renovación)",{"_5620":1083,"_30634":703,"_25947":49008,"_5":30900,"_12136":47985,"_2302":48006},[],{"_5620":1084,"_30634":703,"_25947":49010,"_5":30900,"_12136":47985,"_2302":49011},[],"Siempre (la firma es lo que autoriza la revocación)",{"_5620":1085,"_30634":703,"_25947":49013,"_5":30900,"_12136":47985,"_2302":48010},[],{"_5620":1086,"_30634":703,"_25947":49015,"_5":30900,"_12136":47985,"_2302":49016},[],"Según `access_policy`: `public_discovery` admite mensajes sin firma; `require_signed` exige firma",{"_5620":1087,"_30634":703,"_25947":49018,"_5":30900,"_12136":47985,"_2302":49019},[],"`certConf`, `pollReq`, `popdecr`, `nested`",{"_5620":1088,"_30634":703,"_25947":49021,"_5":30900,"_12136":47985,"_2302":49022},[],"Siguen la regla del `auth_mode` del DMS",{"_5620":1089,"_30634":703,"_25947":49024,"_5":30900,"_12136":47985,"_2302":49025},[],"En la capa de servicio, el certificado de protección debe encadenar a una CA declarada en `client_certificate_settings.validation_cas` (o, en `kur`, a la CA de enrolamiento y las CAs adicionales de re-enrollment), con los mismos parámetros de profundidad de cadena y tolerancia a certificados caducados que EST, y se comprueba su estado de revocación igual que en el flujo EST. Además, un certificado que fue identidad de un dispositivo sigue estando sujeto al estado de la identidad: mientras haya una actualización de clave pendiente de confirmar no puede iniciar operaciones nuevas, y una vez confirmada la sustitución deja de ser utilizable como credencial (`certRevoked`). Un certificado que no es identidad de ningún dispositivo (por ejemplo, un firmante bootstrap) pasa sin esas comprobaciones.",{"_5620":1090,"_30634":703,"_25947":49027,"_5":30900,"_12136":47989,"_2302":49028},[],"Operación",{"_5620":1091,"_30634":703,"_25947":49030,"_5":30900,"_12136":47989,"_2302":49031},[],"Uso",{"_5620":1092,"_30634":703,"_25947":49033,"_5":30900,"_12136":47989,"_2302":49034},[],"Requiere identidad previa",{"_5620":1093,"_30634":703,"_25947":49036,"_5":30900,"_12136":47989,"_2302":49037},[],"`ir`",{"_5620":1094,"_30634":703,"_25947":49039,"_5":30900,"_12136":47989,"_2302":49040},[],"Alta inicial de un dispositivo nuevo.",{"_5620":1095,"_30634":703,"_25947":49042,"_5":30900,"_12136":47989,"_2302":49043},[],"No",{"_5620":1096,"_30634":703,"_25947":49045,"_5":30900,"_12136":47989,"_2302":49046},[],"`cr`",{"_5620":1097,"_30634":703,"_25947":49048,"_5":30900,"_12136":47989,"_2302":49049},[],"Emisión adicional o de sustitución para un dispositivo ya identificado.",{"_5620":1098,"_30634":703,"_25947":49051,"_5":30900,"_12136":47989,"_2302":49052},[],"Sí (si `require_existing_device`)",{"_5620":1099,"_30634":703,"_25947":49054,"_5":30900,"_12136":47989,"_2302":48002},[],{"_5620":1100,"_30634":703,"_25947":49056,"_5":30900,"_12136":47989,"_2302":49057},[],"Alta con un CSR PKCS#10, sin controles CRMF ni KGA. Debe estar habilitado en el DMS.",{"_5620":1101,"_30634":703,"_25947":49059,"_5":30900,"_12136":47989,"_2302":49043},[],{"_5620":1102,"_30634":703,"_25947":49061,"_5":30900,"_12136":47989,"_2302":47998},[],{"_5620":1103,"_30634":703,"_25947":49063,"_5":30900,"_12136":47989,"_2302":49064},[],"Renovación de un certificado; el mensaje se firma con el certificado vigente.",{"_5620":1104,"_30634":703,"_25947":49066,"_5":30900,"_12136":47989,"_2302":49067},[],"Sí (el certificado que se renueva)",{"_5620":1105,"_30634":703,"_25947":49069,"_5":30900,"_12136":47989,"_2302":48006},[],{"_5620":1106,"_30634":703,"_25947":49071,"_5":30900,"_12136":47989,"_2302":49072},[],"Revocación de un certificado, siempre firmada.",{"_5620":1107,"_30634":703,"_25947":49074,"_5":30900,"_12136":47989,"_2302":49075},[],"Sí",{"_5620":1108,"_30634":703,"_25947":49077,"_5":30900,"_12136":47989,"_2302":49078},[],"`genm`/`genp`",{"_5620":1109,"_30634":703,"_25947":49080,"_5":30900,"_12136":47989,"_2302":49081},[],"Consulta de capacidades del DMS (CAs, tipos de clave, CRL vigente, etc.). No emite certificados.",{"_5620":1110,"_30634":703,"_25947":49083,"_5":30900,"_12136":47989,"_2302":49043},[],{"_5620":1111,"_30634":703,"_25947":49085,"_5":30900,"_12136":47989,"_2302":49086},[],"`ccr`/`ccp`",{"_5620":1112,"_30634":703,"_25947":49088,"_5":30900,"_12136":47989,"_2302":49089},[],"Certificación cruzada entre CAs. Solo para operadores de CA, deshabilitada por defecto.",{"_5620":1113,"_30634":703,"_25947":49091,"_5":30900,"_12136":47989,"_2302":49092},[],"El firmante debe ser una CA",{"_5620":1114,"_30634":703,"_25947":49094,"_5":30900,"_12136":47989,"_2302":48022},[],{"_5620":1115,"_30634":703,"_25947":49096,"_5":30900,"_12136":47989,"_2302":49097},[],"Envoltorio que añade una capa extra de protección (una RA contrafirmando a un dispositivo) o agrupa varios mensajes en lote. No es una operación en sí misma.",{"_5620":1116,"_30634":703,"_25947":49099,"_5":30900,"_12136":47989,"_2302":49100},[],"—",{"_5620":1117,"_30634":703,"_25947":49102,"_5":30900,"_12136":47989,"_2302":49103},[],"Los pasos de protocolo `certConf` (confirmación), `pollReq` (sondeo), `popdecc`/`popdecr` (prueba de posesión por reto-respuesta) y `error` forman parte del ciclo de vida de las operaciones anteriores, no son operaciones que el integrador elija por separado.",{"_5620":1118,"_30634":703,"_25947":49105,"_5":30900,"_12136":47993,"_2302":49106},[],"Ambas llevan un cuerpo `CertReqMessages` con la plantilla de certificado (`CertTemplate`), los controles CRMF y la prueba de posesión. El subject puede llegar vacío (NULL-DN) siempre que una extensión `SubjectAltName` porte la identidad; sin subject ni SAN, el `ir` se rechaza. Las respuestas son `ip` para `ir` y `cp` para `cr`.",{"_5620":1119,"_30634":703,"_25947":49108,"_5":30900,"_12136":47993,"_2302":49109},[],"El alta respeta el modo de registro del DMS: con `JITP`, la primera solicitud crea el dispositivo con el perfil de aprovisionamiento; con `PRE_REGISTRATION`, un dispositivo desconocido se rechaza con `device not preregistered`. Reinscribir un dispositivo ya enrolado exige `enable_replaceable_enrollment` en el DMS (`forbiddenNewEnrollment` en caso contrario). Las restricciones de plantilla son las mismas para ambas operaciones: Lamassu nunca emite certificados de CA vía CMP (`BasicConstraints cA=TRUE` → `notAuthorized`), el uso de `keyCertSign` sin ser CA o un `pathLenConstraint` en una plantilla de entidad final son `badCertTemplate`, y el RSA admitido va de 2048 a 8192 bits.",{"_5620":1120,"_30634":703,"_25947":49111,"_5":30900,"_12136":47993,"_2302":49112},[],"Si el perfil de emisión del DMS descarta una extensión **crítica** solicitada por el `CertTemplate`, la respuesta llega con estado `grantedWithMods` (1) en lugar de `accepted` (0): el integrador debe comparar el certificado emitido con lo que pidió, no asumir que la aceptación implica correspondencia exacta.",{"_5620":1121,"_30634":703,"_25947":49114,"_5":30900,"_12136":47993,"_2302":49115},[],"Los controles CRMF, cuando el DMS los exige, van en la solicitud: `id-regCtrl-regToken` (RFC 4211 §6.1) si el modo del DMS lo requiere — valor de un solo uso que se consume aunque la emisión falle después — y `id-regCtrl-authenticator` (§6.2) si el DMS configuró una respuesta esperada. Un control presente cuando el DMS lo tiene deshabilitado, o ausente cuando es obligatorio, se rechaza con `badRequest`.",{"_5620":1122,"_30634":703,"_25947":49117,"_5":30900,"_12136":47997,"_2302":49118},[],"El mensaje lleva la plantilla del certificado renovado y se **protege por firma con el certificado que se renueva** — esa firma es la prueba de posesión. Con `key_policy: require_new_key`, la clave pública debe ser distinta a la vigente; con `identity_change_policy: forbid`, el subject y el SAN deben coincidir con el certificado en vigor (`san_only` permite cambiar el SAN; `subject_and_san` permite ambos cambios). La respuesta es `kup`.",{"_5620":1123,"_30634":703,"_25947":49120,"_5":30900,"_12136":47997,"_2302":49121},[],"El intercambio queda pendiente hasta el `certConf`: hasta que el dispositivo confirma, el certificado anterior sigue siendo la identidad activa del dispositivo y puede seguir usándose; el nuevo se vincula y el anterior se revoca como `superseded` solo al confirmar (o inmediatamente si se negoció confirmación implícita). El control opcional `id-regCtrl-oldCertID` debe referenciar el certificado que se renueva.",{"_5620":1124,"_30634":703,"_25947":49123,"_5":30900,"_12136":48001,"_2302":49124},[],"El cuerpo es un CSR PKCS#10 completo. La firma del CSR sobre su propia `CertificationRequestInfo` es la prueba de posesión y se verifica siempre. La política de algoritmos de firma sigue el RFC 9481 §3: RSA, RSA-PSS, ECDSA o Ed25519 con SHA-256/384/512; los firmados con SHA-1, SHA-224, MD5 o DSA se rechazan con `badPOP`, y un algoritmo desconocido se rechaza con `badAlg`. La respuesta es un `cp` con `certReqId` `-1`, y el `certConf` posterior debe llevar ese mismo valor.",{"_5620":1125,"_30634":703,"_25947":49126,"_5":30900,"_12136":48005,"_2302":49127},[],"El cuerpo lleva `RevReqContent` con el `CertTemplate` del certificado a revocar y la razón. La firma del mensaje debe ser del propio certificado revocado (revocación propia) o de una entidad RA de confianza (EKU `id-kp-cmcRA`, validada contra las CAs del DMS según `trusted_ra`). Los campos del `CertTemplate` — emisor, número de serie, subject, clave pública y extensiones — deben coincidir con el certificado presentado. La razón `certificateHold` suspende el certificado (y no está sujeta a la lista de razones permitidas); la razón `removeFromCRL` no revoca: solicita reactivar un certificado previamente revocado — solo posible si esa revocación fue una suspensión —, operación que el DMS debe tener habilitada con `allow_revival`.",{"_5620":1126,"_30634":703,"_25947":49129,"_5":30900,"_12136":48005,"_2302":49130},[],"La respuesta es siempre un `rp` — tanto en éxito (`Certificate revoked` / `Certificate revived`) como en rechazo, con el motivo en su `PKIStatusInfo`.",{"_5620":1127,"_30634":703,"_25947":49132,"_5":30900,"_12136":48009,"_2302":49133},[],"El cuerpo es una secuencia de `InfoTypeAndValue`; la respuesta es un `genp` con una entrada por solicitud. Consulte la tabla de tipos de información para saber qué anuncia cada DMS. Los tipos dependientes de infraestructura (CRL) requieren que el administrador haya configurado un cliente VA en el servicio DMS Manager.",{"_5620":1128,"_30634":703,"_25947":49135,"_5":30900,"_12136":48013,"_2302":49136},[],"Reservado a operadores de CA. El firmante debe ser un certificado de CA y la plantilla debe ir completa. Con `workflow: administrator_approval` (el por defecto), la primera respuesta es un `ccp` de espera y el certificado cruzado se recupera con `pollReq` una vez aprobado. La validez solicitada se respeta hasta el límite de `maximum_validity` del DMS.",{"_5620":1129,"_30634":703,"_25947":49138,"_5":30900,"_12136":48017,"_2302":49139},[],"`certConf` cierra el ciclo de una emisión con confirmación explícita. Reglas principales:",{"_5620":1130,"_30634":703,"_25947":49141,"_5":30900,"_12136":48017,"_2302":49142},[],"Debe llevar **exactamente un** `CertStatus`, con `certReqId` `0` para `ir`/`cr`/`kur` y `-1` para `p10cr`.",{"_5620":1131,"_30634":703,"_25947":49144,"_5":30900,"_12136":48017,"_2302":49145},[],"El `certHash` se verifica contra el certificado emitido; sin `hashAlg` se usa el resumen que dicta el RFC 9481 §3.3 según el algoritmo de firma del propio certificado (SHA-256, salvo certificados firmados con SHA-384/512 o Ed25519), y declarar un `hashAlg` exige `pvno` `cmp2021(3)`.",{"_5620":1132,"_30634":703,"_25947":49147,"_5":30900,"_12136":48017,"_2302":49148},[],"Debe ir protegido con **la credencial de la solicitud original**, no con el certificado recién emitido.",{"_5620":1133,"_30634":703,"_25947":49150,"_5":30900,"_12136":48017,"_2302":49151},[],"El `recipNonce` debe devolver el `senderNonce` de la respuesta, y su propio `senderNonce` debe ser nuevo (reutilizar el de la solicitud inicial es `badSenderNonce`).",{"_5620":1134,"_30634":703,"_25947":49153,"_5":30900,"_12136":48017,"_2302":49154},[],"Confirmar dos veces el mismo certificado responde con el error `certConfirmed`, útil tras perder un `pkiConf`.",{"_5620":1135,"_30634":703,"_25947":49156,"_5":30900,"_12136":48017,"_2302":49157},[],"`pollReq` sondea el estado de la transacción y permite dos flujos: la recuperación de respuesta perdida (el certificado `ISSUED` se re-entrega en el `ip`/`cp`/`kup` original, sin consumir la transacción) y el sondeo del flujo `phased` (mientras la transacción está `PENDING`, la respuesta es un `pollRep` con la sugerencia de reintento, 60 segundos por defecto). Una transacción `ISSUE_FAILED` devuelve el motivo del fallo y una `REVOKED` indica que debe repetirse la inscripción. La respuesta de una transacción con generación de claves en servidor **no se puede recuperar**: la clave privada nunca se almacena, así que un `pollReq` sobre ella se rechaza y el dispositivo debe repetir la inscripción con un nuevo `transactionID`.",{"_5620":1136,"_30634":703,"_25947":49159,"_5":30900,"_12136":48021,"_2302":49160},[],"Un `nested` (RFC 4210 §5.1.3) es un sobre cuyo cuerpo contiene uno o varios `PKIMessage`. Con **un solo** mensaje interior es *added protection* (RFC 9483 §5.2.2.1): una RA envuelve y contrafirma una solicitud ya protegida del dispositivo; la cabecera exterior debe copiar el `transactionID` y el `senderNonce` del interior, la protección interior se verifica y la solicitud se procesa con normalidad. Con **dos o más** mensajes es un lote (§5.2.2.2): la cabecera exterior lleva `transactionID`/`senderNonce` nuevos, la protección de cada mensaje interior se verifica antes de procesar ninguno y las respuestas vuelven envueltas en un `nested`, en el mismo orden. Un `ccr` dentro de un `nested` no se reexpide, y no se admite anidar dentro de un lote.",{"_5620":1137,"_30634":703,"_25947":49162,"_5":30900,"_12136":48025,"_2302":49163},[],"Cuando el DMS tiene `server_key_gen_enabled: true`, un dispositivo puede enviar un `ir`/`cr` con el campo de clave pública del `CertTemplate` vacío para solicitar que el servidor genere el par de claves. El mecanismo y sus límites se describen en la sección de configuración; desde el integrador:",{"_5620":1138,"_30634":703,"_25947":49165,"_5":30900,"_12136":48025,"_2302":49166},[],"El certificado de protección del mensaje hace de destinatario: RSA → `rsa_key_transport`, ECC → `ecdh_key_agreement`. La clave y el uso de clave del certificado deben permitir la técnica elegida.",{"_5620":1139,"_30634":703,"_25947":49168,"_5":30900,"_12136":48025,"_2302":49169},[],"La respuesta (`ip`/`cp`) lleva el certificado emitido y la clave envuelta en el mismo cuerpo; la clave PKCS#8 viaja dentro de `EnvelopedData`(`SignedData`(`AsymmetricKeyPackage`)) y el certificado con el que abrir el sobre está en `extraCerts[0]`.",{"_5620":1140,"_30634":703,"_25947":49171,"_5":30900,"_12136":48025,"_2302":49172},[],"La clave nunca se guarda en el servidor: si la respuesta se pierde, no hay `pollReq` que la recupere — repita la inscripción con un nuevo `transactionID`.",{"_5620":1141,"_30634":703,"_25947":49174,"_5":30900,"_12136":48025,"_2302":49175},[],"El `certConf` posterior funciona igual que en una emisión ordinaria.",{"_5620":1142,"_30634":703,"_25947":49177,"_5":30900,"_12136":48029,"_2302":49178},[],"Los siguientes comandos usan el cliente `cmp` de OpenSSL (≥ 3.0) contra un DMS configurado en modo `CLIENT_CERTIFICATE`.",{"_5620":1143,"_30634":703,"_25947":49180,"_5":30900,"_12136":48029,"_2302":49181},[],"**Alta inicial (`ir`)**, firmando con un certificado bootstrap (`signer.crt`/`signer.key`) emitido por una de las `validation_cas` del DMS, y generando una clave nueva para el dispositivo:",{"_5620":1144,"_30634":703,"_25947":49183,"_5":30900,"_12136":48029,"_2302":49184},[],"`-tls_used` es necesario en OpenSSL 3.0.x cuando la URL del servidor usa `https` sin fijar el certificado del servidor (`-srvcert`); las versiones ≥ 3.2 lo infieren automáticamente. `-unprotected_errors` permite aceptar respuestas de error que lleguen sin protección (aquellas cuyo algoritmo de protección es NULL); mientras el DMS no tenga configurado el `protection_certificate`, todas sus respuestas — incluidos los errores — salen sin protección, así que esta opción evita que `openssl cmp` las descarte.",{"_5620":1145,"_30634":703,"_25947":49186,"_5":30900,"_12136":48029,"_2302":49187},[],"**Renovación (`kur`)**, autenticando con el certificado vigente del dispositivo:",{"_5620":1146,"_30634":703,"_25947":49189,"_5":30900,"_12136":48029,"_2302":49190},[],"`-srvcert` fija el certificado con el que se espera que el DMS proteja su respuesta (el **Protection Certificate** configurado en el DMS). Sin él, OpenSSL valida la protección de la respuesta contra sus propios anclajes de confianza; `-unprotected_errors` solo cubre los mensajes de error sin protección y no sustituye a `-srvcert` para las respuestas correctas.",{"_5620":1147,"_30634":703,"_25947":49192,"_5":30900,"_12136":48033,"_2302":49193},[],"**Confirmar el certificado**: salvo que `accept_implicit` esté activo en el DMS y el dispositivo lo solicite, el flujo no se considera completo hasta que el dispositivo envía `certConf`. `openssl cmp -cmd ir`/`kur` lo hace automáticamente; una integración manual debe implementar este paso.",{"_5620":1148,"_30634":703,"_25947":49195,"_5":30900,"_12136":48033,"_2302":49196},[],"**Planificar la renovación**: programe el `kur` antes de la caducidad del certificado. A diferencia de EST, la ventana `reenrollment_delta` no restringe el `kur` de CMP, así que la política de cuándo renovar es del dispositivo.",{"_5620":1149,"_30634":703,"_25947":49198,"_5":30900,"_12136":48033,"_2302":49199},[],"**Flujo `phased`**: si el DMS usa `workflow: phased` en la operación, la primera respuesta a `ir`/`cr`/`kur`/`p10cr` es una espera; el dispositivo debe reintentar con `pollReq` hasta que un administrador apruebe o rechace la transacción.",{"_5620":1150,"_30634":703,"_25947":49201,"_5":30900,"_12136":48033,"_2302":49202},[],"**Recuperación de respuestas perdidas**: ante una respuesta que no llegó, repita la operación con `pollReq` (el certificado `ISSUED` se re-entrega) salvo en transacciones con generación de claves en servidor, donde hay que repetir la inscripción.",{"_5620":1151,"_30634":703,"_25947":49204,"_5":30900,"_12136":48041,"_2302":49205},[],"Un `PKIMessage` de error devuelto con `HTTP 200` es la respuesta normal ante una solicitud rechazada por política (autenticación fallida, operación deshabilitada, ventana de confirmación expirada, etc.). Va protegido — firmado con el certificado de protección — si el DMS tiene uno configurado; en caso contrario va sin protección, y los clientes estrictos como `openssl cmp` lo descartan salvo que se use `-unprotected_errors`. Los códigos HTTP de error están reservados para fallos donde no se puede construir un `PKIMessage` de respuesta.",{"_5620":1152,"_30634":703,"_25947":49207,"_5":30900,"_12136":48041,"_2302":49208},[],"HTTP",{"_5620":1153,"_30634":703,"_25947":49210,"_5":30900,"_12136":48041,"_2302":49211},[],"Dónde está el fallo",{"_5620":1154,"_30634":703,"_25947":49213,"_5":30900,"_12136":48041,"_2302":49214},[],"Causa típica",{"_5620":1155,"_30634":703,"_25947":49216,"_5":30900,"_12136":48041,"_2302":49217},[],"Acción del integrador",{"_5620":1156,"_30634":703,"_25947":49219,"_5":30900,"_12136":48041,"_2302":28526},[],{"_5620":1157,"_30634":703,"_25947":49221,"_5":30900,"_12136":48041,"_2302":49222},[],"Cuerpo JSON de error",{"_5620":1158,"_30634":703,"_25947":49224,"_5":30900,"_12136":48041,"_2302":49225},[],"`Content-Type` distinto de `application/pkixcmp`.",{"_5620":1159,"_30634":703,"_25947":49227,"_5":30900,"_12136":48041,"_2302":49228},[],"Fijar la cabecera correcta.",{"_5620":1160,"_30634":703,"_25947":49230,"_5":30900,"_12136":48041,"_2302":28486},[],{"_5620":1161,"_30634":703,"_25947":49232,"_5":30900,"_12136":48041,"_2302":49233},[],"Sin cuerpo",{"_5620":1162,"_30634":703,"_25947":49235,"_5":30900,"_12136":48041,"_2302":49236},[],"El cuerpo no se puede decodificar como `PKIMessage` ASN.1 (no hay cabecera válida con la que construir una respuesta CMP).",{"_5620":1163,"_30634":703,"_25947":49238,"_5":30900,"_12136":48041,"_2302":49239},[],"Verificar que el cuerpo es DER binario, no base64 ni PEM.",{"_5620":1164,"_30634":703,"_25947":49241,"_5":30900,"_12136":48041,"_2302":49242},[],"200 (`error`)",{"_5620":1165,"_30634":703,"_25947":49244,"_5":30900,"_12136":48041,"_2302":49245},[],"`PKIFailureInfo` del cuerpo",{"_5620":1166,"_30634":703,"_25947":49247,"_5":30900,"_12136":48041,"_2302":49248},[],"`unsupportedVersion`: pvno distinto de `cmp2000(2)`/`cmp2021(3)`.",{"_5620":1167,"_30634":703,"_25947":49250,"_5":30900,"_12136":48041,"_2302":49251},[],"Usar una versión soportada.",{"_5620":1168,"_30634":703,"_25947":49253,"_5":30900,"_12136":48041,"_2302":49242},[],{"_5620":1169,"_30634":703,"_25947":49255,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1170,"_30634":703,"_25947":49257,"_5":30900,"_12136":48041,"_2302":49258},[],"`badDataFormat`: `transactionID`/`senderNonce` ausentes o menores de 128 bits; `PKIHeader` malformado; `error` desde el EE.",{"_5620":1171,"_30634":703,"_25947":49260,"_5":30900,"_12136":48041,"_2302":49261},[],"Revisar la implementación del cliente CMP.",{"_5620":1172,"_30634":703,"_25947":49263,"_5":30900,"_12136":48041,"_2302":49242},[],{"_5620":1173,"_30634":703,"_25947":49265,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1174,"_30634":703,"_25947":49267,"_5":30900,"_12136":48041,"_2302":49268},[],"`badTime`: `messageTime` ausente o con más de 5 minutos de deriva.",{"_5620":1175,"_30634":703,"_25947":49270,"_5":30900,"_12136":48041,"_2302":49271},[],"Sincronizar el reloj del dispositivo.",{"_5620":1176,"_30634":703,"_25947":49273,"_5":30900,"_12136":48041,"_2302":49242},[],{"_5620":1177,"_30634":703,"_25947":49275,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1178,"_30634":703,"_25947":49277,"_5":30900,"_12136":48041,"_2302":49278},[],"`badSenderNonce`/`badRecipientNonce`: `senderNonce` reutilizado, `recipNonce` presente en una solicitud inicial o desajustado.",{"_5620":1179,"_30634":703,"_25947":49280,"_5":30900,"_12136":48041,"_2302":49281},[],"Seguir las reglas de nonces del RFC 9483 §3.1.",{"_5620":1180,"_30634":703,"_25947":49283,"_5":30900,"_12136":48041,"_2302":49242},[],{"_5620":1181,"_30634":703,"_25947":49285,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1182,"_30634":703,"_25947":49287,"_5":30900,"_12136":48041,"_2302":49288},[],"`badMessageCheck`: firma inválida, `sender`/`senderKID` no coinciden con el certificado de protección, o protección fallida en un mensaje anidado.",{"_5620":1183,"_30634":703,"_25947":49290,"_5":30900,"_12136":48041,"_2302":49291},[],"Revisar el certificado con el que se firmó.",{"_5620":1184,"_30634":703,"_25947":49293,"_5":30900,"_12136":48041,"_2302":49242},[],{"_5620":1185,"_30634":703,"_25947":49295,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1186,"_30634":703,"_25947":49297,"_5":30900,"_12136":48041,"_2302":49298},[],"`transactionIdInUse`: `transactionID` ya registrado (repetición de un `rr`).",{"_5620":1187,"_30634":703,"_25947":49300,"_5":30900,"_12136":48041,"_2302":49301},[],"Generar un `transactionID` nuevo.",{"_5620":1188,"_30634":703,"_25947":49303,"_5":30900,"_12136":48041,"_2302":49242},[],{"_5620":1189,"_30634":703,"_25947":49305,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1190,"_30634":703,"_25947":49307,"_5":30900,"_12136":48041,"_2302":49308},[],"`notAuthorized`: operación deshabilitada para el DMS, o revocación de un certificado de otro DMS.",{"_5620":1191,"_30634":703,"_25947":49310,"_5":30900,"_12136":48041,"_2302":49311},[],"Confirmar con el administrador PKI que la operación está habilitada.",{"_5620":1192,"_30634":703,"_25947":49313,"_5":30900,"_12136":48041,"_2302":49242},[],{"_5620":1193,"_30634":703,"_25947":49315,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1194,"_30634":703,"_25947":49317,"_5":30900,"_12136":48041,"_2302":49318},[],"`signerNotTrusted`: el firmante no encadena a las CAs de validación del DMS, o el destinatario de KGA está fuera del límite de confianza.",{"_5620":1195,"_30634":703,"_25947":49320,"_5":30900,"_12136":48041,"_2302":49321},[],"Revisar el certificado con el que se firmó y las CAs configuradas.",{"_5620":1196,"_30634":703,"_25947":49323,"_5":30900,"_12136":48041,"_2302":49242},[],{"_5620":1197,"_30634":703,"_25947":49325,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1198,"_30634":703,"_25947":49327,"_5":30900,"_12136":48041,"_2302":49328},[],"`certRevoked`: el certificado de protección fue sustituido por una renovación confirmada, o el certificado objetivo ya está revocado.",{"_5620":1199,"_30634":703,"_25947":49330,"_5":30900,"_12136":48041,"_2302":49331},[],"Repetir el enrolamiento o revisar el estado de la identidad.",{"_5620":1200,"_30634":703,"_25947":49333,"_5":30900,"_12136":48041,"_2302":49242},[],{"_5620":1201,"_30634":703,"_25947":49335,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1202,"_30634":703,"_25947":49337,"_5":30900,"_12136":48041,"_2302":49338},[],"`certConfirmed`: `certConf` duplicado (la confirmación ya se recibió).",{"_5620":1203,"_30634":703,"_25947":49340,"_5":30900,"_12136":48041,"_2302":49341},[],"No repetir la confirmación salvo que se haya perdido el `pkiConf`.",{"_5620":1204,"_30634":703,"_25947":49343,"_5":30900,"_12136":48041,"_2302":49242},[],{"_5620":1205,"_30634":703,"_25947":49345,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1206,"_30634":703,"_25947":49347,"_5":30900,"_12136":48041,"_2302":49348},[],"`badRequest`: transacción desconocida o expirada, sin certificado que confirmar, segunda renovación pendiente, o destinatario de KGA sin el uso de clave necesario.",{"_5620":1207,"_30634":703,"_25947":49350,"_5":30900,"_12136":48041,"_2302":49351},[],"Inspeccionar el motivo exacto (`statusString`) y corregir el flujo.",{"_5620":1208,"_30634":703,"_25947":49353,"_5":30900,"_12136":48041,"_2302":49354},[],"200 (`ip`/`cp`/`kup` con `status: rejection`)",{"_5620":1209,"_30634":703,"_25947":49356,"_5":30900,"_12136":48041,"_2302":49245},[],{"_5620":1210,"_30634":703,"_25947":49358,"_5":30900,"_12136":48041,"_2302":49359},[],"Política de emisión: POPO ausente o fallida (`badPOP`), solicitud de certificado de CA o RSA fuera de 2048–8192 bits (`badCertTemplate`), `notAuthorized` para POPO/destinatario de KGA no permitidos, `certReqId` inválido.",{"_5620":1211,"_30634":703,"_25947":49361,"_5":30900,"_12136":48041,"_2302":49362},[],"Inspeccionar el `PKIFailureInfo` del cuerpo y contrastarlo con la configuración por operación del DMS.",{"_5620":1212,"_30634":703,"_25947":49364,"_5":30900,"_12136":48041,"_2302":49365},[],"200 (`rp` con `status: rejection`)",{"_5620":1213,"_30634":703,"_25947":49367,"_5":30900,"_12136":48041,"_2302":49368},[],"`PKIStatusInfo` del cuerpo",{"_5620":1214,"_30634":703,"_25947":49370,"_5":30900,"_12136":48041,"_2302":49371},[],"Revocación: motivo no permitido (`badRequest`), `transactionID` repetido, certificado no encontrado (`badCertId`), ya revocado (`certRevoked`) o no revivible (`badCertId`), o firmante sin autoridad sobre el certificado (`signerNotTrusted`/`notAuthorized`).",{"_5620":1215,"_30634":703,"_25947":49373,"_5":30900,"_12136":48041,"_2302":49374},[],"Contrastar con la política `rr` del DMS.",{"_5620":1216,"_30634":703,"_25947":49376,"_5":30900,"_12136":48041,"_2302":49377},[],"Para interpretar el motivo exacto de un rechazo CMP, inspeccione el campo `PKIFailureInfo`/`statusString` del `PKIMessage` de respuesta (por ejemplo con `openssl cmp ... -rspout response.der` y `openssl asn1parse -inform DER -in response.der`). En los logs del servidor Lamassu, cada rechazo genera un evento estructurado `CMP operation rejected` con los campos `dms`, `pkiStatus`, `pkiFailureInfo`, `reason` y `txid`; los fallos de cliente se registran como `WARN` y los internos (`systemFailure`) como `ERROR`.",{"_5620":1217,"_30634":703,"_25947":49379,"_5":30900,"_12136":48045,"_2302":49380},[],"La implementación de Lamassu sigue el perfil Lightweight CMP con las siguientes particularidades que afectan a clientes CMP estrictos:",{"_5620":1218,"_30634":703,"_25947":49382,"_5":30900,"_12136":48045,"_2302":49383},[],"CMP se sirve en un único endpoint multiplexado (`/.well-known/cmp/p/{id}`); no existen rutas separadas por operación como en EST.",{"_5620":1219,"_30634":703,"_25947":49385,"_5":30900,"_12136":48045,"_2302":49386},[],"Se aceptan y responden las versiones `cmp2000(2)` y `cmp2021(3)`; la respuesta devuelve el mismo `pvno` que la solicitud.",{"_5620":1220,"_30634":703,"_25947":49388,"_5":30900,"_12136":48045,"_2302":49389},[],"`messageTime` es obligatorio en **todos** los mensajes (no solo en los protegidos), con una tolerancia de deriva de 5 minutos (`badTime`).",{"_5620":1221,"_30634":703,"_25947":49391,"_5":30900,"_12136":48045,"_2302":49392},[],"`transactionID` y `senderNonce` deben tener al menos 128 bits de entropía, y el `senderNonce` debe ser nuevo en cada mensaje.",{"_5620":1222,"_30634":703,"_25947":49394,"_5":30900,"_12136":48045,"_2302":49395},[],"Las operaciones `ir`, `cr` y `p10cr` no admiten `recipNonce` en la solicitud inicial (RFC 9483 §3.1); un cliente que lo incluya recibe `badRecipientNonce`. Las reglas de `generalInfo` se imponen igualmente: `implicitConfirm` y `confirmWaitTime` son mutuamente excluyentes, el valor de `implicitConfirm` debe ser `NULL` y el de `confirmWaitTime` un `GeneralizedTime`.",{"_5620":1223,"_30634":703,"_25947":49397,"_5":30900,"_12136":48045,"_2302":49398},[],"Con protección por firma, el `sender` de la cabecera debe coincidir con el subject del certificado de protección y el `senderKID` con su `SubjectKeyIdentifier` (`badMessageCheck` en caso contrario). Los `genm` quedan exentos de esta comprobación de identidad.",{"_5620":1224,"_30634":703,"_25947":49400,"_5":30900,"_12136":48045,"_2302":49401},[],"El subject puede ser NULL-DN solo si el SAN porta la identidad; para la identidad interna del dispositivo el SAN se usa como reserva, pero el certificado emitido conserva el subject vacío.",{"_5620":1225,"_30634":703,"_25947":49403,"_5":30900,"_12136":48045,"_2302":49404},[],"Lamassu nunca emite certificados de CA vía CMP; la única operación que produce certificados de CA es `ccr`.",{"_5620":1226,"_30634":703,"_25947":49406,"_5":30900,"_12136":48045,"_2302":49407},[],"El tipo `id-it-revPassphrase` del `genm` está deshabilitado de forma permanente.",{"_5620":1227,"_30634":703,"_25947":49409,"_5":30900,"_12136":48045,"_2302":49410},[],"Los estados internos `APPROVING` y `REVOKING` de una transacción son transitorios y no se exponen en la API de listado; solo aparecen `PENDING`, `ISSUED`, `ISSUE_FAILED`, `CONFIRMED` y `REVOKED`.",{"_5620":1228,"_30634":703,"_25947":49412,"_5":30900,"_12136":48045,"_2302":49413},[],"Los registros de transacción en estado terminal (`CONFIRMED`, `REVOKED`) se conservan para auditoría y no se borran por expiración; un `transactionID` completado puede reutilizarse en una operación nueva, salvo en `rr`, donde la protección contra repetición también mira los registros terminales.",{"_5620":1229,"_30634":703,"_25947":49415,"_5":30900,"_12136":48045,"_2302":49416},[],"El certificado de protección debe renovarse manualmente antes de caducar: el DMS no lo renueva automáticamente, y mientras no haya uno configurado, todas las respuestas salen sin protección.",{"_5620":1230,"_30634":703,"_25947":49418,"_5":30900,"_12136":48045,"_2302":49419},[],"<Card title=\"Visión general del DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_5620":1231,"_30634":703,"_25947":49421,"_5":30900,"_12136":48045,"_2302":49422},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_5620":1232,"_30634":703,"_25947":49424,"_5":30900,"_12136":48045,"_2302":49425},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/platform/pki/device-management\" />",{"_5620":1233,"_30634":1233,"_5":30895,"_2302":49427,"_30908":49428,"_25947":49430,"_12136":1233},"Arquitectura de la plataforma",[45667,46751,49429],"Conceptos",[],{"_5620":1234,"_30634":1233,"_25947":49432,"_5":30900,"_12136":1233,"_2302":49433},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_5620":1235,"_30634":1233,"_5":30905,"_25947":49435,"_12136":49436,"_2302":49437},[],"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#plano-de-control","Plano de control",{"_5620":1236,"_30634":1233,"_5":30905,"_25947":49439,"_12136":49440,"_2302":49441},[],"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_5620":1237,"_30634":1233,"_5":30905,"_25947":49443,"_12136":49444,"_2302":49445},[],"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_5620":1238,"_30634":1233,"_5":30905,"_25947":49447,"_12136":49448,"_2302":49449},[],"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#estado-y-validación","Estado y validación",{"_5620":1239,"_30634":1233,"_5":30905,"_25947":49451,"_12136":49452,"_2302":49453},[],"/docs/pr-preview/pr-24/platform/pki/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_5620":1240,"_30634":1233,"_25947":49455,"_5":30900,"_12136":1233,"_2302":49456},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_5620":1241,"_30634":1233,"_25947":49458,"_5":30900,"_12136":49436,"_2302":49459},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_5620":1242,"_30634":1233,"_25947":49461,"_5":30900,"_12136":49440,"_2302":49462},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_5620":1243,"_30634":1233,"_25947":49464,"_5":30900,"_12136":49444,"_2302":49465},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos del protocolo configurado —EST o CMP— para que un dispositivo solicite o renueve una identidad.",{"_5620":1244,"_30634":1233,"_25947":49467,"_5":30900,"_12136":49448,"_2302":49468},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_5620":1245,"_30634":1233,"_25947":49470,"_5":30900,"_12136":49452,"_2302":49471},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_5620":1246,"_30634":1246,"_5":30895,"_2302":49473,"_30908":49474,"_25947":49475,"_12136":1246},"Ciclo de vida de un certificado",[45667,46751,49429],[],{"_5620":1247,"_30634":1246,"_25947":49477,"_5":30900,"_12136":1246,"_2302":49478},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_5620":1248,"_30634":1246,"_5":30905,"_25947":49480,"_12136":49481,"_2302":49482},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_5620":1249,"_30634":1246,"_5":30905,"_25947":49484,"_12136":49485,"_2302":49486},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_5620":1250,"_30634":1246,"_5":30905,"_25947":49488,"_12136":49489,"_2302":49490},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_5620":1251,"_30634":1246,"_5":30905,"_25947":49492,"_12136":49493,"_2302":49494},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_5620":1252,"_30634":1246,"_5":30905,"_25947":49496,"_12136":49497,"_2302":49498},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_5620":1253,"_30634":1246,"_5":30905,"_25947":49500,"_12136":49501,"_2302":49502},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_5620":1254,"_30634":1246,"_5":30905,"_25947":49504,"_12136":49505,"_2302":49506},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_5620":1255,"_30634":1246,"_5":30905,"_25947":49508,"_12136":49509,"_2302":49510},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_5620":1256,"_30634":1246,"_5":30905,"_25947":49512,"_12136":49513,"_2302":49514},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_5620":1257,"_30634":1246,"_5":30905,"_25947":49516,"_12136":49517,"_2302":49518},[],"/docs/pr-preview/pr-24/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_5620":1258,"_30634":1246,"_25947":49520,"_5":30900,"_12136":1246,"_2302":49521},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_5620":1259,"_30634":1246,"_25947":49523,"_5":30900,"_12136":49485,"_2302":49524},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_5620":1260,"_30634":1246,"_25947":49526,"_5":30900,"_12136":49489,"_2302":49527},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_5620":1261,"_30634":1246,"_25947":49529,"_5":30900,"_12136":49493,"_2302":49530},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_5620":1262,"_30634":1246,"_25947":49532,"_5":30900,"_12136":49497,"_2302":49533},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_5620":1263,"_30634":1246,"_25947":49535,"_5":30900,"_12136":49501,"_2302":49536},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_5620":1264,"_30634":1246,"_25947":49538,"_5":30900,"_12136":49505,"_2302":49539},[],"Lamassu persiste cuatro estados X.509:",{"_5620":1265,"_30634":1246,"_25947":49541,"_5":30900,"_12136":49505,"_2302":49542},[],"**`ACTIVE`**: el certificado está habilitado y dentro de su periodo de validez.",{"_5620":1266,"_30634":1246,"_25947":49544,"_5":30900,"_12136":49505,"_2302":49545},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_5620":1267,"_30634":1246,"_25947":49547,"_5":30900,"_12136":49505,"_2302":49548},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_5620":1268,"_30634":1246,"_25947":49550,"_5":30900,"_12136":49505,"_2302":49551},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_5620":1269,"_30634":1246,"_25947":49553,"_5":30900,"_12136":49505,"_2302":49554},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_5620":1270,"_30634":1246,"_25947":49556,"_5":30900,"_12136":49509,"_2302":49557},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_5620":1271,"_30634":1246,"_25947":49559,"_5":30900,"_12136":49509,"_2302":49560},[],"Solo una revocación con razón `CertificateHold` puede revertirse. Una revocación con cualquier otra razón es definitiva en Lamassu.",{"_5620":1272,"_30634":1246,"_25947":49562,"_5":30900,"_12136":49509,"_2302":49563},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_5620":1273,"_30634":1246,"_25947":49565,"_5":30900,"_12136":49513,"_2302":49566},[],"Revocar una CA es una operación en cascada. Lamassu revoca sus CAs hijas y los certificados que ha emitido con la razón `CessationOfOperation`. La propagación continúa por la jerarquía.",{"_5620":1274,"_30634":1246,"_25947":49568,"_5":30900,"_12136":49513,"_2302":49569},[],"Antes de confirmar:",{"_5620":1275,"_30634":1246,"_25947":49571,"_5":30900,"_12136":49513,"_2302":49572},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_5620":1276,"_30634":1246,"_25947":49574,"_5":30900,"_12136":49513,"_2302":49575},[],"Distribuye la nueva cadena de confianza.",{"_5620":1277,"_30634":1246,"_25947":49577,"_5":30900,"_12136":49513,"_2302":49578},[],"Reemite las identidades necesarias.",{"_5620":1278,"_30634":1246,"_25947":49580,"_5":30900,"_12136":49513,"_2302":49581},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_5620":1279,"_30634":1246,"_25947":49583,"_5":30900,"_12136":49513,"_2302":49584},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_5620":1280,"_30634":1246,"_25947":49586,"_5":30900,"_12136":49513,"_2302":49587},[],"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente.",{"_5620":1281,"_30634":1246,"_25947":49589,"_5":30900,"_12136":49517,"_2302":49590},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_5620":1282,"_30634":1246,"_25947":49592,"_5":30900,"_12136":49517,"_2302":49593},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_5620":1283,"_30634":1246,"_25947":49595,"_5":30900,"_12136":49517,"_2302":49596},[],"Cambios de estado y razones de revocación.",{"_5620":1284,"_30634":1246,"_25947":49598,"_5":30900,"_12136":49517,"_2302":49599},[],"Publicación y vigencia de OCSP y CRLs.",{"_5620":1285,"_30634":1246,"_25947":49601,"_5":30900,"_12136":49517,"_2302":49602},[],"Dependencias que todavía presentan un certificado sustituido.",{"_5620":1286,"_30634":1246,"_25947":49604,"_5":30900,"_12136":49517,"_2302":49605},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_5620":1287,"_30634":1287,"_5":30895,"_2302":49607,"_30908":49608,"_25947":49609,"_12136":1287},"Glosario",[45667,46751,49429],[],{"_5620":1288,"_30634":1287,"_25947":49611,"_5":30900,"_12136":1287,"_2302":49612},[],"Términos de PKI, certificados y gestión de identidades usados en Lamassu.",{"_5620":1289,"_30634":1287,"_5":30905,"_25947":49614,"_12136":49615,"_2302":49616},[],"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#ac","A–C",{"_5620":1290,"_30634":1287,"_5":30905,"_25947":49618,"_12136":49619,"_2302":49620},[],"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#dk","D–K",{"_5620":1291,"_30634":1287,"_5":30905,"_25947":49622,"_12136":49623,"_2302":49624},[],"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#mr","M–R",{"_5620":1292,"_30634":1287,"_5":30905,"_25947":49626,"_12136":49627,"_2302":49628},[],"/docs/pr-preview/pr-24/platform/pki/concepts/glossary#sz","S–Z",{"_5620":1293,"_30634":1287,"_25947":49630,"_5":30900,"_12136":49615,"_2302":49631},[],"**AKI (Authority Key Identifier)**\\\nIdentificador de la clave pública de la autoridad que firmó un certificado. Ayuda a construir la cadena hacia el emisor correcto.",{"_5620":1294,"_30634":1287,"_25947":49633,"_5":30900,"_12136":49615,"_2302":49634},[],"**Ancla de confianza**\\\nCertificado, normalmente de una CA raíz, que un consumidor acepta de forma explícita como punto final de una cadena.",{"_5620":1295,"_30634":1287,"_25947":49636,"_5":30900,"_12136":49615,"_2302":49637},[],"**CA (Certification Authority)**\\\nAutoridad que firma certificados y vincula una identidad con una clave pública.",{"_5620":1296,"_30634":1287,"_25947":49639,"_5":30900,"_12136":49615,"_2302":49640},[],"**CA intermedia**\\\nCA firmada por otra autoridad. Se utiliza para emitir sin exponer la raíz a la operación diaria.",{"_5620":1297,"_30634":1287,"_25947":49642,"_5":30900,"_12136":49615,"_2302":49643},[],"**CA raíz**\\\nCA autofirmada que inicia una jerarquía de confianza.",{"_5620":1298,"_30634":1287,"_25947":49645,"_5":30900,"_12136":49615,"_2302":49646},[],"**Certificado X.509**\\\nDocumento firmado que contiene una clave pública, un sujeto, un emisor, un periodo de validez y extensiones que delimitan su uso.",{"_5620":1299,"_30634":1287,"_25947":49648,"_5":30900,"_12136":49615,"_2302":49649},[],"**CRL (Certificate Revocation List)**\\\nLista firmada de certificados revocados publicada por una CA.",{"_5620":1300,"_30634":1287,"_25947":49651,"_5":30900,"_12136":49615,"_2302":49652},[],"**CSR (Certificate Signing Request)**\\\nSolicitud PKCS#10 que contiene una clave pública y atributos solicitados. La firma de la CSR demuestra posesión de la clave privada correspondiente.",{"_5620":1301,"_30634":1287,"_25947":49654,"_5":30900,"_12136":49619,"_2302":49655},[],"**DMS (Device Management Service)**\\\nConfiguración que agrupa reglas de registro, enrolamiento, re-enrolamiento, emisión y distribución de CAs para una flota.",{"_5620":1302,"_30634":1287,"_25947":49657,"_5":30900,"_12136":49619,"_2302":49658},[],"**Distinguished Name (DN)**\\\nConjunto de atributos del sujeto o emisor, como `CN`, `O`, `OU`, `C`, `ST` y `L`.",{"_5620":1303,"_30634":1287,"_25947":49660,"_5":30900,"_12136":49619,"_2302":49661},[],"**EST (Enrollment over Secure Transport)**\\\nProtocolo definido en RFC 7030 para obtener CAs, enrolar y re-enrolar certificados sobre HTTPS.",{"_5620":1304,"_30634":1287,"_25947":49663,"_5":30900,"_12136":49619,"_2302":49664},[],"**Extended Key Usage (EKU)**\\\nExtensión que acota finalidades como autenticación de cliente, autenticación de servidor, firma de código u OCSP.",{"_5620":1305,"_30634":1287,"_25947":49666,"_5":30900,"_12136":49619,"_2302":49667},[],"**Identidad de dispositivo**\\\nRelación entre un dispositivo y uno de sus certificados. Un dispositivo puede conservar un historial de identidades.",{"_5620":1306,"_30634":1287,"_25947":49669,"_5":30900,"_12136":49619,"_2302":49670},[],"**Identity slot**\\\nPosición lógica en un dispositivo donde Lamassu vincula una identidad activa o histórica.",{"_5620":1307,"_30634":1287,"_25947":49672,"_5":30900,"_12136":49619,"_2302":49673},[],"**JITP (Just-in-Time Provisioning)**\\\nRegistro automático de un dispositivo cuando completa correctamente su primer enrolamiento.",{"_5620":1308,"_30634":1287,"_25947":49675,"_5":30900,"_12136":49619,"_2302":49676},[],"**KMS (Key Management Service)**\\\nServicio de Lamassu que normaliza generación, importación y uso de claves sobre distintos motores criptográficos.",{"_5620":1309,"_30634":1287,"_25947":49678,"_5":30900,"_12136":49619,"_2302":49679},[],"**Key Usage**\\\nExtensión X.509 que permite operaciones básicas como firma digital, cifrado de clave o firma de certificados.",{"_5620":1310,"_30634":1287,"_25947":49681,"_5":30900,"_12136":49623,"_2302":49682},[],"**mTLS (Mutual TLS)**\\\nTLS donde cliente y servidor presentan certificados. Un DMS puede usar el certificado cliente como método de autenticación.",{"_5620":1311,"_30634":1287,"_25947":49684,"_5":30900,"_12136":49623,"_2302":49685},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocolo para consultar en línea si un certificado está vigente, revocado o es desconocido.",{"_5620":1312,"_30634":1287,"_25947":49687,"_5":30900,"_12136":49623,"_2302":49688},[],"**Perfil de emisión**\\\nPolítica reutilizable que define cómo Lamassu construye un certificado y qué claves acepta.",{"_5620":1313,"_30634":1287,"_25947":49690,"_5":30900,"_12136":49623,"_2302":49691},[],"**Principal**\\\nIdentidad de operador o cliente de API reconocida por el servicio de autorización. Lamassu admite principales OIDC y X.509.",{"_5620":1314,"_30634":1287,"_25947":49693,"_5":30900,"_12136":49623,"_2302":49694},[],"**Política**\\\nConjunto de permisos asignable a uno o varios principales.",{"_5620":1315,"_30634":1287,"_25947":49696,"_5":30900,"_12136":49623,"_2302":49697},[],"**RA (Registration Authority)**\\\nComponente que verifica al solicitante antes de pedir a una CA que emita. El DMS cumple este papel en los flujos de enrolamiento de dispositivos.",{"_5620":1316,"_30634":1287,"_25947":49699,"_5":30900,"_12136":49623,"_2302":49700},[],"**Relying party**\\\nSistema consumidor que decide si acepta un certificado presentado.",{"_5620":1317,"_30634":1287,"_25947":49702,"_5":30900,"_12136":49623,"_2302":49703},[],"**Revocación**\\\nInvalidación de un certificado antes de su fecha de expiración.",{"_5620":1318,"_30634":1287,"_25947":49705,"_5":30900,"_12136":49627,"_2302":49706},[],"**SAN (Subject Alternative Name)**\\\nExtensión que añade identidades como nombres DNS, direcciones IP, correos o URIs.",{"_5620":1319,"_30634":1287,"_25947":49708,"_5":30900,"_12136":49627,"_2302":49709},[],"**SKI (Subject Key Identifier)**\\\nIdentificador derivado de la clave pública del propio certificado.",{"_5620":1320,"_30634":1287,"_25947":49711,"_5":30900,"_12136":49627,"_2302":49712},[],"**VA (Validation Authority)**\\\nServicio de Lamassu responsable de las respuestas OCSP y la generación o publicación de CRLs.",{"_5620":1321,"_30634":1287,"_25947":49714,"_5":30900,"_12136":49627,"_2302":49715},[],"**Ventana de renovación**\\\nPeriodo anterior a la expiración durante el que un dispositivo puede o debe solicitar otra identidad.",{"_5620":1322,"_30634":1287,"_25947":49717,"_5":30900,"_12136":49627,"_2302":49718},[],"¿Falta un término operativo? Consulta primero Cómo funciona Lamassu y el Modelo de confianza, donde estos conceptos aparecen conectados.",{"_5620":1323,"_30634":1323,"_5":30895,"_2302":49720,"_30908":49721,"_25947":49722,"_12136":1323},"Cómo funciona Lamassu",[45667,46751,49429],[],{"_5620":1324,"_30634":1323,"_25947":49724,"_5":30900,"_12136":1323,"_2302":49725},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_5620":1325,"_30634":1323,"_5":30905,"_25947":49727,"_12136":49728,"_2302":49729},[],"/docs/pr-preview/pr-24/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_5620":1326,"_30634":1323,"_5":30905,"_25947":49731,"_12136":49732,"_2302":49733},[],"/docs/pr-preview/pr-24/platform/pki/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_5620":1327,"_30634":1323,"_25947":49735,"_5":30900,"_12136":1323,"_2302":49736},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_5620":1328,"_30634":1323,"_25947":49738,"_5":30900,"_12136":49728,"_2302":49739},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_5620":1329,"_30634":1323,"_25947":49741,"_5":30900,"_12136":49728,"_2302":49742},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_5620":1330,"_30634":1323,"_25947":49744,"_5":30900,"_12136":49728,"_2302":49745},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_5620":1331,"_30634":1323,"_25947":49747,"_5":30900,"_12136":49728,"_2302":49748},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_5620":1332,"_30634":1323,"_25947":49750,"_5":30900,"_12136":49728,"_2302":49751},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_5620":1333,"_30634":1323,"_25947":49753,"_5":30900,"_12136":49732,"_2302":49754},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_5620":1334,"_30634":1323,"_25947":49756,"_5":30900,"_12136":49732,"_2302":49757},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_5620":1335,"_30634":1323,"_25947":49759,"_5":30900,"_12136":49732,"_2302":49760},[],"El dispositivo genera una clave y solicita un certificado mediante EST o CMP, o un operador le asigna una identidad.",{"_5620":1336,"_30634":1323,"_25947":49762,"_5":30900,"_12136":49732,"_2302":49763},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_5620":1337,"_30634":1323,"_25947":49765,"_5":30900,"_12136":49732,"_2302":49766},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_5620":1338,"_30634":1323,"_25947":49768,"_5":30900,"_12136":49732,"_2302":49769},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_5620":1339,"_30634":1323,"_25947":49771,"_5":30900,"_12136":49732,"_2302":49772},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_5620":1340,"_30634":1340,"_5":30895,"_2302":49774,"_30908":49775,"_25947":49776,"_12136":1340},"Modelo de confianza",[45667,46751,49429],[],{"_5620":1341,"_30634":1340,"_25947":49778,"_5":30900,"_12136":1340,"_2302":49779},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_5620":1342,"_30634":1340,"_5":30905,"_25947":49781,"_12136":49782,"_2302":49783},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_5620":1343,"_30634":1340,"_5":30905,"_25947":49785,"_12136":49786,"_2302":49787},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_5620":1344,"_30634":1340,"_5":30905,"_25947":49789,"_12136":49790,"_2302":49791},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_5620":1345,"_30634":1340,"_5":30905,"_25947":49793,"_12136":49794,"_2302":49795},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_5620":1346,"_30634":1340,"_5":30905,"_25947":49797,"_12136":49798,"_2302":49799},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_5620":1347,"_30634":1340,"_5":30905,"_25947":49801,"_12136":49802,"_2302":49803},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_5620":1348,"_30634":1340,"_5":30905,"_25947":49805,"_12136":49806,"_2302":49807},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_5620":1349,"_30634":1340,"_5":30905,"_25947":49809,"_12136":49810,"_2302":49811},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_5620":1350,"_30634":1340,"_5":30905,"_25947":49813,"_12136":49814,"_2302":49815},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_5620":1351,"_30634":1340,"_5":30905,"_25947":49817,"_12136":49818,"_2302":49819},[],"/docs/pr-preview/pr-24/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_5620":1352,"_30634":1340,"_25947":49821,"_5":30900,"_12136":1340,"_2302":49822},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_5620":1353,"_30634":1340,"_25947":49824,"_5":30900,"_12136":49786,"_2302":49825},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_5620":1354,"_30634":1340,"_25947":49827,"_5":30900,"_12136":49790,"_2302":49828},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_5620":1355,"_30634":1340,"_25947":49830,"_5":30900,"_12136":49794,"_2302":49831},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_5620":1356,"_30634":1340,"_25947":49833,"_5":30900,"_12136":49798,"_2302":49834},[],"El servicio o dispositivo consumidor mantiene su propio almacén de confianza. Lamassu puede distribuir la CA del sistema, la CA de enrolamiento y otras CAs gestionadas mediante `/cacerts`, pero el consumidor decide cuáles instala y cómo aplica la validación.",{"_5620":1357,"_30634":1340,"_25947":49836,"_5":30900,"_12136":49802,"_2302":49837},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_5620":1358,"_30634":1340,"_25947":49839,"_5":30900,"_12136":49802,"_2302":49840},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_5620":1359,"_30634":1340,"_25947":49842,"_5":30900,"_12136":49802,"_2302":49843},[],"La CA aplica el perfil y firma sin recibir la clave privada del dispositivo.",{"_5620":1360,"_30634":1340,"_25947":49845,"_5":30900,"_12136":49802,"_2302":49846},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_5620":1361,"_30634":1340,"_25947":49848,"_5":30900,"_12136":49802,"_2302":49849},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_5620":1362,"_30634":1340,"_25947":49851,"_5":30900,"_12136":49802,"_2302":49852},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_5620":1363,"_30634":1340,"_25947":49854,"_5":30900,"_12136":49806,"_2302":49855},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_5620":1364,"_30634":1340,"_25947":49857,"_5":30900,"_12136":49806,"_2302":49858},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_5620":1365,"_30634":1340,"_25947":49860,"_5":30900,"_12136":49806,"_2302":49861},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_5620":1366,"_30634":1340,"_25947":49863,"_5":30900,"_12136":49806,"_2302":49864},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir la CA del sistema, la CA de enrolamiento y una lista de CAs gestionadas.",{"_5620":1367,"_30634":1340,"_25947":49866,"_5":30900,"_12136":49806,"_2302":49867},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_5620":1368,"_30634":1340,"_25947":49869,"_5":30900,"_12136":49810,"_2302":49870},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_5620":1369,"_30634":1340,"_25947":49872,"_5":30900,"_12136":49810,"_2302":49873},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_5620":1370,"_30634":1340,"_25947":49875,"_5":30900,"_12136":49810,"_2302":49876},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_5620":1371,"_30634":1340,"_25947":49878,"_5":30900,"_12136":49810,"_2302":49879},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_5620":1372,"_30634":1340,"_25947":49881,"_5":30900,"_12136":49810,"_2302":49882},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_5620":1373,"_30634":1340,"_25947":49884,"_5":30900,"_12136":49810,"_2302":49885},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_5620":1374,"_30634":1340,"_25947":49887,"_5":30900,"_12136":49814,"_2302":49888},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_5620":1375,"_30634":1340,"_25947":49890,"_5":30900,"_12136":49818,"_2302":49891},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_5620":1376,"_30634":1340,"_25947":49893,"_5":30900,"_12136":49818,"_2302":49894},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_5620":1377,"_30634":1340,"_25947":49896,"_5":30900,"_12136":49818,"_2302":49897},[],"Asigna perfiles explícitos a cada caso de uso.",{"_5620":1378,"_30634":1340,"_25947":49899,"_5":30900,"_12136":49818,"_2302":49900},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_5620":1379,"_30634":1340,"_25947":49902,"_5":30900,"_12136":49818,"_2302":49903},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_5620":1380,"_30634":1340,"_25947":49905,"_5":30900,"_12136":49818,"_2302":49906},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_5620":1381,"_30634":1340,"_25947":49908,"_5":30900,"_12136":49818,"_2302":49909},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_5620":1382,"_30634":1382,"_5":30895,"_2302":49911,"_30908":49912,"_25947":49913,"_12136":1382},"Listas de revocación (CRL)",[45667,46751,46904],[],{"_5620":1383,"_30634":1382,"_25947":49915,"_5":30900,"_12136":1382,"_2302":49916},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_5620":1384,"_30634":1382,"_5":30905,"_25947":49918,"_12136":49919,"_2302":49920},[],"/docs/pr-preview/pr-24/platform/pki/crl#servicio-crl","Servicio CRL",{"_5620":1385,"_30634":1382,"_5":30905,"_25947":49922,"_12136":49923,"_2302":49924},[],"/docs/pr-preview/pr-24/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_5620":1386,"_30634":1382,"_5":30905,"_25947":49926,"_12136":49927,"_2302":49928},[],"/docs/pr-preview/pr-24/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_5620":1387,"_30634":1382,"_5":30905,"_25947":49930,"_12136":49931,"_2302":49932},[],"/docs/pr-preview/pr-24/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_5620":1388,"_30634":1382,"_5":30905,"_25947":49934,"_12136":49935,"_2302":49936},[],"/docs/pr-preview/pr-24/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_5620":1389,"_30634":1382,"_5":30905,"_25947":49938,"_12136":49939,"_2302":49940},[],"/docs/pr-preview/pr-24/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_5620":1390,"_30634":1382,"_5":30905,"_25947":49942,"_12136":49943,"_2302":49944},[],"/docs/pr-preview/pr-24/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_5620":1391,"_30634":1382,"_5":30905,"_25947":49946,"_12136":49947,"_2302":49948},[],"/docs/pr-preview/pr-24/platform/pki/crl#referencias","Referencias",{"_5620":1392,"_30634":1382,"_25947":49950,"_5":30900,"_12136":49919,"_2302":49951},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_5620":1393,"_30634":1382,"_25947":49953,"_5":30900,"_12136":49919,"_2302":49954},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_5620":1394,"_30634":1382,"_25947":49956,"_5":30900,"_12136":49923,"_2302":49957},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_5620":1395,"_30634":1382,"_25947":49959,"_5":30900,"_12136":49923,"_2302":49960},[],"Los parámetros principales son:",{"_5620":1396,"_30634":1382,"_25947":49962,"_5":30900,"_12136":49923,"_2302":49963},[],"**`validity`** define el periodo de validez reflejado en `nextUpdate`. Su valor predeterminado es 7 días.",{"_5620":1397,"_30634":1382,"_25947":49965,"_5":30900,"_12136":49923,"_2302":49966},[],"**`refresh_interval`** establece el intervalo mínimo entre regeneraciones programadas. Por defecto es aproximadamente 6 días y 23 horas.",{"_5620":1398,"_30634":1382,"_25947":49968,"_5":30900,"_12136":49923,"_2302":49969},[],"**`regenerate_on_revoke`** ordena publicar una versión nueva inmediatamente después de una revocación. Está activo por defecto.",{"_5620":1399,"_30634":1382,"_25947":49971,"_5":30900,"_12136":49923,"_2302":49972},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_5620":1400,"_30634":1382,"_25947":49974,"_5":30900,"_12136":49923,"_2302":49975},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_5620":1401,"_30634":1382,"_25947":49977,"_5":30900,"_12136":49927,"_2302":49978},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_5620":1402,"_30634":1382,"_25947":49980,"_5":30900,"_12136":49927,"_2302":49981},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_5620":1403,"_30634":1382,"_25947":49983,"_5":30900,"_12136":49931,"_2302":49984},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_5620":1404,"_30634":1382,"_25947":49986,"_5":30900,"_12136":49931,"_2302":49987},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_5620":1405,"_30634":1382,"_25947":49989,"_5":30900,"_12136":49935,"_2302":49990},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_5620":1406,"_30634":1382,"_25947":49992,"_5":30900,"_12136":49935,"_2302":49993},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_5620":1407,"_30634":1382,"_25947":49995,"_5":30900,"_12136":49939,"_2302":49996},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_5620":1408,"_30634":1382,"_25947":49998,"_5":30900,"_12136":49939,"_2302":49999},[],"Método",{"_5620":1409,"_30634":1382,"_25947":50001,"_5":30900,"_12136":49939,"_2302":50002},[],"Ruta",{"_5620":1410,"_30634":1382,"_25947":50004,"_5":30900,"_12136":49939,"_2302":46038},[],{"_5620":1411,"_30634":1382,"_25947":50006,"_5":30900,"_12136":49939,"_2302":50007},[],"`GET`",{"_5620":1412,"_30634":1382,"_25947":50009,"_5":30900,"_12136":49939,"_2302":50010},[],"`/v1/roles/{ca-ski}`",{"_5620":1413,"_30634":1382,"_25947":50012,"_5":30900,"_12136":49939,"_2302":50013},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_5620":1414,"_30634":1382,"_25947":50015,"_5":30900,"_12136":49939,"_2302":50016},[],"`PUT`",{"_5620":1415,"_30634":1382,"_25947":50018,"_5":30900,"_12136":49939,"_2302":50010},[],{"_5620":1416,"_30634":1382,"_25947":50020,"_5":30900,"_12136":49939,"_2302":50021},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_5620":1417,"_30634":1382,"_25947":50023,"_5":30900,"_12136":49939,"_2302":50024},[],"Ejemplo de consulta del rol VA:",{"_5620":1418,"_30634":1382,"_25947":50026,"_5":30900,"_12136":49939,"_2302":50027},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_5620":1419,"_30634":1382,"_25947":50029,"_5":30900,"_12136":49943,"_2302":50030},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_5620":1420,"_30634":1382,"_25947":50032,"_5":30900,"_12136":49947,"_2302":50033},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_5620":1421,"_30634":1382,"_25947":50035,"_5":30900,"_12136":49947,"_2302":50036},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_5620":1422,"_30634":1382,"_25947":50038,"_5":30900,"_12136":49947,"_2302":50039},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_5620":1423,"_30634":1423,"_5":30895,"_2302":50041,"_30908":50042,"_25947":50043,"_12136":1423},"Device Management Service",[45667,46751,46904],[],{"_5620":1424,"_30634":1423,"_25947":50045,"_5":30900,"_12136":1423,"_2302":50046},[],"Define cómo una flota recibe, renueva y utiliza sus identidades.",{"_5620":1425,"_30634":1423,"_5":30905,"_25947":50048,"_12136":50049,"_2302":45677},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#antes-de-empezar",{"_5620":1426,"_30634":1423,"_5":30905,"_25947":50051,"_12136":50052,"_2302":50053},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#configura-un-dms","Configura un DMS",{"_5620":1427,"_30634":1423,"_5":30905,"_25947":50055,"_12136":50056,"_2302":50057},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#identifica-la-flota","Identifica la flota",{"_5620":1428,"_30634":1423,"_5":30905,"_25947":50059,"_12136":50060,"_2302":50061},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_5620":1429,"_30634":1423,"_5":30905,"_25947":50063,"_12136":50064,"_2302":50065},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#configura-el-protocolo-de-enrolamiento","Configura el protocolo de enrolamiento",{"_5620":1430,"_30634":1423,"_5":30905,"_25947":50067,"_12136":50068,"_2302":50069},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#distribuye-la-confianza","Distribuye la confianza",{"_5620":1431,"_30634":1423,"_5":30905,"_25947":50071,"_12136":50072,"_2302":50073},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#verifica-los-endpoints","Verifica los endpoints",{"_5620":1432,"_30634":1423,"_5":30905,"_25947":50075,"_12136":50076,"_2302":50077},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#distribución-de-confianza","Distribución de confianza",{"_5620":1433,"_30634":1423,"_5":30905,"_25947":50079,"_12136":50080,"_2302":50081},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_5620":1434,"_30634":1423,"_5":30905,"_25947":50083,"_12136":50084,"_2302":50085},[],"/docs/pr-preview/pr-24/platform/pki/device-enrollment#integra-los-dispositivos","Integra los dispositivos",{"_5620":1435,"_30634":1423,"_25947":50087,"_5":30900,"_12136":1423,"_2302":50088},[],"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada.",{"_5620":1436,"_30634":1423,"_25947":50090,"_5":30900,"_12136":1423,"_2302":50091},[],"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación.",{"_5620":1437,"_30634":1423,"_25947":50093,"_5":30900,"_12136":1423,"_2302":50094},[],"Cada DMS expone un único protocolo de enrolamiento, seleccionado al crearlo o editarlo: &#x2A;*EST (RFC 7030)** o &#x2A;*CMP (RFC 9483 Lightweight CMP Profile / RFC 4210)**. Los dos protocolos son mutuamente excluyentes: cambiar el protocolo de un DMS existente sustituye por completo su configuración de enrolamiento, sin migración automática de ajustes. La configuración de cada protocolo y la guía de integración para dispositivos se documentan en las páginas de EST y CMP.",{"_5620":1438,"_30634":1423,"_25947":50096,"_5":30900,"_12136":50049,"_2302":50097},[],"Crea o importa al menos una CA activa.",{"_5620":1439,"_30634":1423,"_25947":50099,"_5":30900,"_12136":50049,"_2302":50100},[],"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento.",{"_5620":1440,"_30634":1423,"_25947":50102,"_5":30900,"_12136":50049,"_2302":50103},[],"Define qué autoridades debe recibir el dispositivo como anclas de confianza.",{"_5620":1441,"_30634":1423,"_25947":50105,"_5":30900,"_12136":50049,"_2302":50106},[],"Asegúrate de tener permisos para administrar DMS.",{"_5620":1442,"_30634":1423,"_25947":50108,"_5":30900,"_12136":50056,"_2302":50109},[],"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno.",{"_5620":1443,"_30634":1423,"_25947":50111,"_5":30900,"_12136":50060,"_2302":50112},[],"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota.",{"_5620":1444,"_30634":1423,"_25947":50114,"_5":30900,"_12136":50064,"_2302":50115},[],"Selecciona EST (RFC 7030) o CMP (RFC 9483) y define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, la generación de claves en servidor.",{"_5620":1445,"_30634":1423,"_25947":50117,"_5":30900,"_12136":50068,"_2302":50118},[],"Configura **CA Distribution** para controlar qué autoridades recibe el dispositivo como anclas de confianza, con independencia del protocolo de enrolamiento.",{"_5620":1446,"_30634":1423,"_25947":50120,"_5":30900,"_12136":50072,"_2302":50121},[],"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware.",{"_5620":1447,"_30634":1423,"_25947":50123,"_5":30900,"_12136":50076,"_2302":50124},[],"**Include Lamassu System CA** distribuye el certificado TLS del servidor Lamassu, útil para *pinning*. No representa una CA de emisión.",{"_5620":1448,"_30634":1423,"_25947":50126,"_5":30900,"_12136":50076,"_2302":50127},[],"**Include Enrollment CA** añade la autoridad configurada para emitir las identidades del DMS.",{"_5620":1449,"_30634":1423,"_25947":50129,"_5":30900,"_12136":50076,"_2302":50130},[],"**Managed CAs** permite incluir autoridades adicionales que el dispositivo debe considerar de confianza.",{"_5620":1450,"_30634":1423,"_25947":50132,"_5":30900,"_12136":50080,"_2302":50133},[],"**Edit** modifica la política del DMS.",{"_5620":1451,"_30634":1423,"_25947":50135,"_5":30900,"_12136":50080,"_2302":50136},[],"**Go to DMS owned devices** abre únicamente los dispositivos de esa flota.",{"_5620":1452,"_30634":1423,"_25947":50138,"_5":30900,"_12136":50080,"_2302":50139},[],"**Show/Edit Metadata** permite gestionar configuración avanzada y datos de integraciones.",{"_5620":1453,"_30634":1423,"_25947":50141,"_5":30900,"_12136":50080,"_2302":50142},[],"**EST (RFC-7030)** muestra los endpoints y ejemplos específicos del DMS.",{"_5620":1454,"_30634":1423,"_25947":50144,"_5":30900,"_12136":50080,"_2302":50145},[],"**Delete** elimina el DMS y su configuración. La acción es irreversible.",{"_5620":1455,"_30634":1423,"_25947":50147,"_5":30900,"_12136":50084,"_2302":50148},[],"<Card title=\"Enrolamiento EST\" description=\"Configura autenticación, endpoints y flujos para firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_5620":1456,"_30634":1423,"_25947":50150,"_5":30900,"_12136":50084,"_2302":50151},[],"<Card title=\"Enrolamiento CMP\" description=\"Configura autenticación, operaciones y transacciones para firmware.\" href=\"/docs/platform/pki/cmp\" />",{"_5620":1457,"_30634":1423,"_25947":50153,"_5":30900,"_12136":50084,"_2302":50154},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta estados, historial y acciones operativas.\" href=\"/docs/platform/pki/device-management\" />",{"_5620":1458,"_30634":1458,"_5":30895,"_2302":50156,"_30908":50157,"_25947":50158,"_12136":1458},"Dispositivos e identidades",[45667,46751,46904],[],{"_5620":1459,"_30634":1458,"_25947":50160,"_5":30900,"_12136":1458,"_2302":50161},[],"Registra dispositivos y controla sus identidades durante todo el ciclo de vida.",{"_5620":1460,"_30634":1458,"_5":30905,"_25947":50163,"_12136":50164,"_2302":50165},[],"/docs/pr-preview/pr-24/platform/pki/device-management#estados-del-dispositivo","Estados del dispositivo",{"_5620":1461,"_30634":1458,"_5":30905,"_25947":50167,"_12136":50168,"_2302":50169},[],"/docs/pr-preview/pr-24/platform/pki/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_5620":1462,"_30634":1458,"_5":30905,"_25947":50171,"_12136":50172,"_2302":50173},[],"/docs/pr-preview/pr-24/platform/pki/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_5620":1463,"_30634":1458,"_5":30905,"_25947":50175,"_12136":50176,"_2302":50177},[],"/docs/pr-preview/pr-24/platform/pki/device-management#crea-el-dispositivo","Crea el dispositivo",{"_5620":1464,"_30634":1458,"_5":30905,"_25947":50179,"_12136":50180,"_2302":50181},[],"/docs/pr-preview/pr-24/platform/pki/device-management#define-su-pertenencia","Define su pertenencia",{"_5620":1465,"_30634":1458,"_5":30905,"_25947":50183,"_12136":50184,"_2302":50185},[],"/docs/pr-preview/pr-24/platform/pki/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_5620":1466,"_30634":1458,"_5":30905,"_25947":50187,"_12136":50188,"_2302":50189},[],"/docs/pr-preview/pr-24/platform/pki/device-management#verifica-el-alta","Verifica el alta",{"_5620":1467,"_30634":1458,"_5":30905,"_25947":50191,"_12136":50192,"_2302":50193},[],"/docs/pr-preview/pr-24/platform/pki/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_5620":1468,"_30634":1458,"_5":30905,"_25947":50195,"_12136":50196,"_2302":50197},[],"/docs/pr-preview/pr-24/platform/pki/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_5620":1469,"_30634":1458,"_5":30905,"_25947":50199,"_12136":50200,"_2302":50201},[],"/docs/pr-preview/pr-24/platform/pki/device-management#retira-un-dispositivo","Retira un dispositivo",{"_5620":1470,"_30634":1458,"_5":30905,"_25947":50203,"_12136":50204,"_2302":50205},[],"/docs/pr-preview/pr-24/platform/pki/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_5620":1471,"_30634":1458,"_25947":50207,"_5":30900,"_12136":1458,"_2302":50208},[],"Un dispositivo gestionado representa una entidad de tu flota y conserva el historial de los certificados que ha utilizado. Lamassu separa el dispositivo de su identidad actual para que puedas renovar o sustituir certificados sin perder trazabilidad.",{"_5620":1472,"_30634":1458,"_25947":50210,"_5":30900,"_12136":50164,"_2302":50211},[],"**Active** indica que el dispositivo tiene una identidad válida.",{"_5620":1473,"_30634":1458,"_25947":50213,"_5":30900,"_12136":50164,"_2302":50214},[],"**No Identity** aparece cuando está registrado, pero todavía no tiene un certificado asociado.",{"_5620":1474,"_30634":1458,"_25947":50216,"_5":30900,"_12136":50164,"_2302":50217},[],"**Renewal Pending** señala que ha entrado en la ventana de renovación.",{"_5620":1475,"_30634":1458,"_25947":50219,"_5":30900,"_12136":50164,"_2302":50220},[],"**Expiring Soon** advierte que el certificado está próximo a expirar.",{"_5620":1476,"_30634":1458,"_25947":50222,"_5":30900,"_12136":50164,"_2302":50223},[],"**Expired** indica que la identidad ha superado su fecha de validez.",{"_5620":1477,"_30634":1458,"_25947":50225,"_5":30900,"_12136":50164,"_2302":50226},[],"**Revoked** identifica un certificado invalidado antes de su expiración.",{"_5620":1478,"_30634":1458,"_25947":50228,"_5":30900,"_12136":50164,"_2302":50229},[],"**Decommissioned** corresponde a un dispositivo retirado de forma permanente.",{"_5620":1479,"_30634":1458,"_25947":50231,"_5":30900,"_12136":50164,"_2302":50232},[],"El inventario permite filtrar por `Device ID`, etiquetas y estado.",{"_5620":1480,"_30634":1458,"_25947":50234,"_5":30900,"_12136":50168,"_2302":50235},[],"La vista de detalle separa dos perspectivas:",{"_5620":1481,"_30634":1458,"_25947":50237,"_5":30900,"_12136":50168,"_2302":50238},[],"**Certificate History** conserva todos los certificados asociados, con su número de serie, emisor, estado y periodo de validez.",{"_5620":1482,"_30634":1458,"_25947":50240,"_5":30900,"_12136":50168,"_2302":50241},[],"**Device Event Timeline** ordena cronológicamente registros, enrolamientos, renovaciones y cambios de estado.",{"_5620":1483,"_30634":1458,"_25947":50243,"_5":30900,"_12136":50168,"_2302":50244},[],"Utiliza el historial para auditoría y la línea de tiempo para reconstruir un incidente o diagnosticar una transición inesperada.",{"_5620":1484,"_30634":1458,"_25947":50246,"_5":30900,"_12136":50172,"_2302":50247},[],"El registro previo es útil cuando la política exige que el dispositivo exista antes de solicitar su primer certificado.",{"_5620":1485,"_30634":1458,"_25947":50249,"_5":30900,"_12136":50176,"_2302":50250},[],"Desde **Managed Devices**, abre el formulario de registro.",{"_5620":1486,"_30634":1458,"_25947":50252,"_5":30900,"_12136":50180,"_2302":50253},[],"Introduce un **Device ID** único y selecciona el DMS que aplicará las políticas de enrolamiento y renovación.",{"_5620":1487,"_30634":1458,"_25947":50255,"_5":30900,"_12136":50184,"_2302":50256},[],"Añade un icono y etiquetas si necesitas agruparlo por modelo, ubicación, entorno u otro criterio operativo.",{"_5620":1488,"_30634":1458,"_25947":50258,"_5":30900,"_12136":50188,"_2302":50259},[],"El dispositivo debe aparecer con estado **No Identity** hasta que complete el enrolamiento o reciba una identidad manual.",{"_5620":1489,"_30634":1458,"_25947":50261,"_5":30900,"_12136":50192,"_2302":50262},[],"La acción **Assign Identity** está disponible mientras el dispositivo permanece en **No Identity**.",{"_5620":1490,"_30634":1458,"_25947":50264,"_5":30900,"_12136":50192,"_2302":50265},[],"Abre el dispositivo y selecciona **Assign Identity**.",{"_5620":1491,"_30634":1458,"_25947":50267,"_5":30900,"_12136":50192,"_2302":50268},[],"Elige un certificado activo cuyo `Common Name` coincida con el `Device ID`.",{"_5620":1492,"_30634":1458,"_25947":50270,"_5":30900,"_12136":50192,"_2302":50271},[],"Si no existe, selecciona **Issue New Instead** y elige una CA vinculada al DMS.",{"_5620":1493,"_30634":1458,"_25947":50273,"_5":30900,"_12136":50192,"_2302":50274},[],"Confirma la asignación.",{"_5620":1494,"_30634":1458,"_25947":50276,"_5":30900,"_12136":50192,"_2302":50277},[],"El dispositivo debe cambiar a **Active** y el certificado debe aparecer en su historial.",{"_5620":1495,"_30634":1458,"_25947":50279,"_5":30900,"_12136":50196,"_2302":50280},[],"En **Device Event Timeline**, localiza el último certificado activo y selecciona **Revoke**. Elige una razón conforme a tu política y confirma la operación.",{"_5620":1496,"_30634":1458,"_25947":50282,"_5":30900,"_12136":50196,"_2302":50283},[],"La revocación invalida el certificado, pero no elimina el dispositivo. Puedes restaurar su operación asignándole una identidad nueva. `CertificateHold` permite reactivar el certificado retenido; el resto de razones son definitivas.",{"_5620":1497,"_30634":1458,"_25947":50285,"_5":30900,"_12136":50200,"_2302":50286},[],"Esta acción revoca todos los certificados del dispositivo e impide que vuelva a obtener una identidad.",{"_5620":1498,"_30634":1458,"_25947":50288,"_5":30900,"_12136":50200,"_2302":50289},[],"Usa **Decommission** únicamente cuando el dispositivo haya dejado de operar o ya no sea fiable. Tras confirmar, Lamassu revoca la identidad activa con `CessationOfOperation` y cambia el estado a **Decommissioned**.",{"_5620":1499,"_30634":1458,"_25947":50291,"_5":30900,"_12136":50204,"_2302":50292},[],"<Card title=\"Configura un DMS\" description=\"Define la CA, confianza y políticas de la flota.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_5620":1500,"_30634":1458,"_25947":50294,"_5":30900,"_12136":50204,"_2302":50295},[],"<Card title=\"Integra EST\" description=\"Permite que el dispositivo solicite y renueve su identidad.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_5620":1501,"_30634":1458,"_25947":50297,"_5":30900,"_12136":50204,"_2302":50298},[],"<Card title=\"Integra CMP\" description=\"Permite que el dispositivo enrolle y renueve su identidad con CMP.\" href=\"/docs/platform/pki/cmp\" />",{"_5620":1502,"_30634":1502,"_5":30895,"_2302":50300,"_30908":50301,"_25947":50302,"_12136":1502},"Enrolamiento de dispositivos con EST",[45667,46751,46904],[],{"_5620":1503,"_30634":1502,"_25947":50304,"_5":30900,"_12136":1502,"_2302":50305},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_5620":1504,"_30634":1502,"_5":30905,"_25947":50307,"_12136":50308,"_2302":50309},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_5620":1505,"_30634":1502,"_5":30905,"_25947":50311,"_12136":50312,"_2302":47888},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#configuración-del-dms",{"_5620":1506,"_30634":1502,"_5":30905,"_25947":50314,"_12136":50315,"_2302":46476},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#requisitos-previos",{"_5620":1507,"_30634":1502,"_5":30905,"_25947":50317,"_12136":50318,"_2302":50319},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#configuración-de-enrollment","Configuración de enrollment",{"_5620":1508,"_30634":1502,"_5":30905,"_25947":50321,"_12136":50322,"_2302":50323},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_5620":1509,"_30634":1502,"_5":30905,"_25947":50325,"_12136":50326,"_2302":50327},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_5620":1510,"_30634":1502,"_5":30905,"_25947":50329,"_12136":50330,"_2302":50331},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#perfil-de-emisión","Perfil de emisión",{"_5620":1511,"_30634":1502,"_5":30905,"_25947":50333,"_12136":50334,"_2302":47955},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#configuración-de-re-enrollment",{"_5620":1512,"_30634":1502,"_5":30905,"_25947":50336,"_12136":50337,"_2302":50338},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_5620":1513,"_30634":1502,"_5":30905,"_25947":50340,"_12136":50341,"_2302":47971},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#verificar-la-configuración",{"_5620":1514,"_30634":1502,"_5":30905,"_25947":50343,"_12136":50344,"_2302":47975},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#integración-de-dispositivos",{"_5620":1515,"_30634":1502,"_5":30905,"_25947":50346,"_12136":50347,"_2302":45677},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#antes-de-empezar",{"_5620":1516,"_30634":1502,"_5":30905,"_25947":50349,"_12136":50350,"_2302":50351},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#resumen-del-flujo","Resumen del flujo",{"_5620":1517,"_30634":1502,"_5":30905,"_25947":50353,"_12136":50354,"_2302":50355},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_5620":1518,"_30634":1502,"_5":30905,"_25947":50357,"_12136":50358,"_2302":50359},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#referencia-de-endpoints","Referencia de endpoints",{"_5620":1519,"_30634":1502,"_5":30905,"_25947":50361,"_12136":50362,"_2302":50363},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_5620":1520,"_30634":1502,"_5":30905,"_25947":50365,"_12136":50366,"_2302":50367},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_5620":1521,"_30634":1502,"_5":30905,"_25947":50369,"_12136":50370,"_2302":50371},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_5620":1522,"_30634":1502,"_5":30905,"_25947":50373,"_12136":50374,"_2302":50375},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_5620":1523,"_30634":1502,"_5":30905,"_25947":50377,"_12136":50378,"_2302":50379},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#flujos-completos","Flujos completos",{"_5620":1524,"_30634":1502,"_5":30905,"_25947":50381,"_12136":50382,"_2302":50383},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_5620":1525,"_30634":1502,"_5":30905,"_25947":50385,"_12136":50386,"_2302":50387},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_5620":1526,"_30634":1502,"_5":30905,"_25947":50389,"_12136":50390,"_2302":48034},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento",{"_5620":1527,"_30634":1502,"_5":30905,"_25947":50392,"_12136":50393,"_2302":48038},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#diagnóstico-y-compatibilidad",{"_5620":1528,"_30634":1502,"_5":30905,"_25947":50395,"_12136":50396,"_2302":48042},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico",{"_5620":1529,"_30634":1502,"_5":30905,"_25947":50398,"_12136":50399,"_2302":48046},[],"/docs/pr-preview/pr-24/platform/pki/est-enrollment#notas-de-compatibilidad",{"_5620":1530,"_30634":1502,"_25947":50401,"_5":30900,"_12136":50308,"_2302":50402},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como uno de sus mecanismos de inscripción de certificados para dispositivos — el otro es CMP (RFC 9483). Cada DMS expone uno de los dos protocolos, nunca ambos a la vez; el que expone EST valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_5620":1531,"_30634":1502,"_25947":50404,"_5":30900,"_12136":50308,"_2302":50405},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_5620":1532,"_30634":1502,"_25947":50407,"_5":30900,"_12136":50308,"_2302":48112},[],{"_5620":1533,"_30634":1502,"_25947":50409,"_5":30900,"_12136":50308,"_2302":50410},[],"Configuración del DMS, para el administrador PKI.",{"_5620":1534,"_30634":1502,"_25947":50412,"_5":30900,"_12136":50308,"_2302":50413},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_5620":1535,"_30634":1502,"_25947":50415,"_5":30900,"_12136":50308,"_2302":50416},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_5620":1536,"_30634":1502,"_25947":50418,"_5":30900,"_12136":50308,"_2302":50419},[],"**Administrador PKI:** empiece por Configuración del DMS y termine con Diagnóstico y compatibilidad.",{"_5620":1537,"_30634":1502,"_25947":50421,"_5":30900,"_12136":50308,"_2302":50422},[],"**Integrador de dispositivos:** empiece por Antes de empezar y continúe con `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo que vaya a implementar.",{"_5620":1538,"_30634":1502,"_25947":50424,"_5":30900,"_12136":50315,"_2302":50425},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_5620":1539,"_30634":1502,"_25947":50427,"_5":30900,"_12136":50315,"_2302":50428},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_5620":1540,"_30634":1502,"_25947":50430,"_5":30900,"_12136":50315,"_2302":50431},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_5620":1541,"_30634":1502,"_25947":50433,"_5":30900,"_12136":50315,"_2302":50434},[],"Conviene separar cuatro bloques de configuración:",{"_5620":1542,"_30634":1502,"_25947":50436,"_5":30900,"_12136":50315,"_2302":50437},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_5620":1543,"_30634":1502,"_25947":50439,"_5":30900,"_12136":50315,"_2302":50440},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_5620":1544,"_30634":1502,"_25947":50442,"_5":30900,"_12136":50315,"_2302":50443},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_5620":1545,"_30634":1502,"_25947":50445,"_5":30900,"_12136":50315,"_2302":50446},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_5620":1546,"_30634":1502,"_25947":50448,"_5":30900,"_12136":50322,"_2302":50449},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_5620":1547,"_30634":1502,"_25947":50451,"_5":30900,"_12136":50322,"_2302":50452},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_5620":1548,"_30634":1502,"_25947":50454,"_5":30900,"_12136":50322,"_2302":50455},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_5620":1549,"_30634":1502,"_25947":50457,"_5":30900,"_12136":50322,"_2302":50458},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_5620":1550,"_30634":1502,"_25947":50460,"_5":30900,"_12136":50326,"_2302":50461},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_5620":1551,"_30634":1502,"_25947":50463,"_5":30900,"_12136":50326,"_2302":50464},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_5620":1552,"_30634":1502,"_25947":50466,"_5":30900,"_12136":50326,"_2302":50467},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_5620":1553,"_30634":1502,"_25947":50469,"_5":30900,"_12136":50326,"_2302":50470},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Puede exigir un certificado mTLS (`CLIENT_CERTIFICATE`), delegar la autorización en un webhook (`EXTERNAL_WEBHOOK`), combinar ambos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) o aceptar solicitudes sin autenticación (`NO_AUTH`). Este último modo debe limitarse a laboratorios o redes de aprovisionamiento aisladas.",{"_5620":1554,"_30634":1502,"_25947":50472,"_5":30900,"_12136":50326,"_2302":50473},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_5620":1555,"_30634":1502,"_25947":50475,"_5":30900,"_12136":50326,"_2302":50476},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_5620":1556,"_30634":1502,"_25947":50478,"_5":30900,"_12136":50326,"_2302":50479},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_5620":1557,"_30634":1502,"_25947":50481,"_5":30900,"_12136":50326,"_2302":50482},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_5620":1558,"_30634":1502,"_25947":50484,"_5":30900,"_12136":50326,"_2302":50485},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_5620":1559,"_30634":1502,"_25947":50487,"_5":30900,"_12136":50326,"_2302":50488},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_5620":1560,"_30634":1502,"_25947":50490,"_5":30900,"_12136":50326,"_2302":50491},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_5620":1561,"_30634":1502,"_25947":50493,"_5":30900,"_12136":50326,"_2302":50494},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_5620":1562,"_30634":1502,"_25947":50496,"_5":30900,"_12136":50326,"_2302":50497},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_5620":1563,"_30634":1502,"_25947":50499,"_5":30900,"_12136":50326,"_2302":50500},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_5620":1564,"_30634":1502,"_25947":50502,"_5":30900,"_12136":50330,"_2302":50503},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_5620":1565,"_30634":1502,"_25947":50505,"_5":30900,"_12136":50330,"_2302":50506},[],"**`HonorSubject`** controla si el subject del CSR se traslada literalmente al certificado. Si está desactivado, la CA aplica la plantilla del perfil e ignora el subject recibido.",{"_5620":1566,"_30634":1502,"_25947":50508,"_5":30900,"_12136":50330,"_2302":50509},[],"**`HonorKeyUsage`** decide si se respeta el `KeyUsage` del CSR o se sustituye por el definido en la plantilla.",{"_5620":1567,"_30634":1502,"_25947":50511,"_5":30900,"_12136":50330,"_2302":50512},[],"**`HonorExtendedKeyUsages`** aplica la misma regla a `ExtKeyUsage`.",{"_5620":1568,"_30634":1502,"_25947":50514,"_5":30900,"_12136":50330,"_2302":50515},[],"**`HonorExtensions`** controla si el resto de extensiones del CSR, como SAN o CDP, se incluyen en el certificado.",{"_5620":1569,"_30634":1502,"_25947":50517,"_5":30900,"_12136":50330,"_2302":50518},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_5620":1570,"_30634":1502,"_25947":50520,"_5":30900,"_12136":50334,"_2302":50521},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_5620":1571,"_30634":1502,"_25947":50523,"_5":30900,"_12136":50334,"_2302":50524},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_5620":1572,"_30634":1502,"_25947":50526,"_5":30900,"_12136":50334,"_2302":50527},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_5620":1573,"_30634":1502,"_25947":50529,"_5":30900,"_12136":50334,"_2302":50530},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_5620":1574,"_30634":1502,"_25947":50532,"_5":30900,"_12136":50334,"_2302":50533},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_5620":1575,"_30634":1502,"_25947":50535,"_5":30900,"_12136":50334,"_2302":50536},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_5620":1576,"_30634":1502,"_25947":50538,"_5":30900,"_12136":50334,"_2302":50539},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_5620":1577,"_30634":1502,"_25947":50541,"_5":30900,"_12136":50337,"_2302":50542},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_5620":1578,"_30634":1502,"_25947":50544,"_5":30900,"_12136":50337,"_2302":50545},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_5620":1579,"_30634":1502,"_25947":50547,"_5":30900,"_12136":50337,"_2302":50548},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_5620":1580,"_30634":1502,"_25947":50550,"_5":30900,"_12136":50337,"_2302":50551},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_5620":1581,"_30634":1502,"_25947":50553,"_5":30900,"_12136":50341,"_2302":50554},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_5620":1582,"_30634":1502,"_25947":50556,"_5":30900,"_12136":50341,"_2302":50557},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_5620":1583,"_30634":1502,"_25947":50559,"_5":30900,"_12136":50341,"_2302":50560},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_5620":1584,"_30634":1502,"_25947":50562,"_5":30900,"_12136":50341,"_2302":50563},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_5620":1585,"_30634":1502,"_25947":50565,"_5":30900,"_12136":50344,"_2302":48915},[],{"_5620":1586,"_30634":1502,"_25947":50567,"_5":30900,"_12136":50344,"_2302":50568},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_5620":1587,"_30634":1502,"_25947":50570,"_5":30900,"_12136":50344,"_2302":50571},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_5620":1588,"_30634":1502,"_25947":50573,"_5":30900,"_12136":50347,"_2302":50574},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_5620":1589,"_30634":1502,"_25947":50576,"_5":30900,"_12136":50347,"_2302":48921},[],{"_5620":1590,"_30634":1502,"_25947":50578,"_5":30900,"_12136":50347,"_2302":50579},[],"**La URL del host EST**, por ejemplo `https://est.lamassu.example`, proporcionada por el administrador PKI.",{"_5620":1591,"_30634":1502,"_25947":50581,"_5":30900,"_12136":50347,"_2302":50582},[],"**El ancla de confianza del servidor** (`lamassu-trust.pem`), raíz o intermedia, con la que el cliente validará el TLS de Lamassu.",{"_5620":1592,"_30634":1502,"_25947":50584,"_5":30900,"_12136":50347,"_2302":50585},[],"**El certificado bootstrap y su clave privada** si el DMS usa `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Esta identidad debe proceder de una de las `ValidationCAs` configuradas, normalmente una CA de aprovisionamiento distinta de la CA de enrolamiento.",{"_5620":1593,"_30634":1502,"_25947":50587,"_5":30900,"_12136":50347,"_2302":50588},[],"**El ID del DMS** (`{aps}`), que debe aparecer en todas las rutas EST.",{"_5620":1594,"_30634":1502,"_25947":50590,"_5":30900,"_12136":50350,"_2302":50591},[],"**Descargue la confianza con `/cacerts`:** el cliente valida el TLS del servidor y recibe los certificados en PKCS#7 o PEM.",{"_5620":1595,"_30634":1502,"_25947":50593,"_5":30900,"_12136":50350,"_2302":50594},[],"**Realice el alta inicial con `/simpleenroll`:** presente el certificado bootstrap o la credencial definida por `AuthMode` para obtener el certificado del dispositivo.",{"_5620":1596,"_30634":1502,"_25947":50596,"_5":30900,"_12136":50350,"_2302":50597},[],"**Renueve con `/simplereenroll`:** autentíquese con el certificado actual del dispositivo para obtener uno nuevo.",{"_5620":1597,"_30634":1502,"_25947":50599,"_5":30900,"_12136":50350,"_2302":50600},[],"**Use `/serverkeygen` solo si necesita generación de claves en servidor:** aplica la misma autenticación que `/simpleenroll` y devuelve la clave privada PKCS#8 junto con el certificado.",{"_5620":1598,"_30634":1502,"_25947":50602,"_5":30900,"_12136":50354,"_2302":50603},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_5620":1599,"_30634":1502,"_25947":50605,"_5":30900,"_12136":50354,"_2302":50606},[],"Modo (`AuthMode`)",{"_5620":1600,"_30634":1502,"_25947":50608,"_5":30900,"_12136":50354,"_2302":46038},[],{"_5620":1601,"_30634":1502,"_25947":50610,"_5":30900,"_12136":50354,"_2302":50611},[],"Credencial esperada",{"_5620":1602,"_30634":1502,"_25947":50613,"_5":30900,"_12136":50354,"_2302":50614},[],"Aplica en enroll",{"_5620":1603,"_30634":1502,"_25947":50616,"_5":30900,"_12136":50354,"_2302":50617},[],"Aplica en reenroll",{"_5620":1604,"_30634":1502,"_25947":50619,"_5":30900,"_12136":50354,"_2302":48236},[],{"_5620":1605,"_30634":1502,"_25947":50621,"_5":30900,"_12136":50354,"_2302":50622},[],"mTLS con certificado X.509",{"_5620":1606,"_30634":1502,"_25947":50624,"_5":30900,"_12136":50354,"_2302":50625},[],"Certificado y clave privada cliente",{"_5620":1607,"_30634":1502,"_25947":50627,"_5":30900,"_12136":50354,"_2302":49075},[],{"_5620":1608,"_30634":1502,"_25947":50629,"_5":30900,"_12136":50354,"_2302":50630},[],"Sí (con el certificado en vigor)",{"_5620":1609,"_30634":1502,"_25947":50632,"_5":30900,"_12136":50354,"_2302":48242},[],{"_5620":1610,"_30634":1502,"_25947":50634,"_5":30900,"_12136":50354,"_2302":50635},[],"mTLS más validación por webhook",{"_5620":1611,"_30634":1502,"_25947":50637,"_5":30900,"_12136":50354,"_2302":50638},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_5620":1612,"_30634":1502,"_25947":50640,"_5":30900,"_12136":50354,"_2302":49075},[],{"_5620":1613,"_30634":1502,"_25947":50642,"_5":30900,"_12136":50354,"_2302":50643},[],"No como combinación; en reenroll no mantiene ambos controles",{"_5620":1614,"_30634":1502,"_25947":50645,"_5":30900,"_12136":50354,"_2302":48248},[],{"_5620":1615,"_30634":1502,"_25947":50647,"_5":30900,"_12136":50354,"_2302":50648},[],"Webhook externo de autorización",{"_5620":1616,"_30634":1502,"_25947":50650,"_5":30900,"_12136":50354,"_2302":50651},[],"Ninguna en el canal TLS",{"_5620":1617,"_30634":1502,"_25947":50653,"_5":30900,"_12136":50354,"_2302":49075},[],{"_5620":1618,"_30634":1502,"_25947":50655,"_5":30900,"_12136":50354,"_2302":50656},[],"No, degrada a `NO_AUTH`",{"_5620":1619,"_30634":1502,"_25947":50658,"_5":30900,"_12136":50354,"_2302":48254},[],{"_5620":1620,"_30634":1502,"_25947":50660,"_5":30900,"_12136":50354,"_2302":50661},[],"Sin autenticación",{"_5620":1621,"_30634":1502,"_25947":50663,"_5":30900,"_12136":50354,"_2302":50664},[],"Ninguna",{"_5620":1622,"_30634":1502,"_25947":50666,"_5":30900,"_12136":50354,"_2302":50667},[],"Sí (uso restringido)",{"_5620":1623,"_30634":1502,"_25947":50669,"_5":30900,"_12136":50354,"_2302":50667},[],{"_5620":1624,"_30634":1502,"_25947":50671,"_5":30900,"_12136":50354,"_2302":50672},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_5620":1625,"_30634":1502,"_25947":50674,"_5":30900,"_12136":50354,"_2302":50675},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_5620":1626,"_30634":1502,"_25947":50677,"_5":30900,"_12136":50354,"_2302":50678},[],"Sus parámetros principales son `ValidationCAs`, la lista de CAs que pueden validar el certificado bootstrap o el certificado en vigor; `AllowExpired`, que permite aceptar certificados cliente caducados; y `ChainLevelValidation`, que limita la profundidad de la cadena cuando su valor es mayor que cero.",{"_5620":1627,"_30634":1502,"_25947":50680,"_5":30900,"_12136":50354,"_2302":50681},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_5620":1628,"_30634":1502,"_25947":50683,"_5":30900,"_12136":50354,"_2302":50684},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_5620":1629,"_30634":1502,"_25947":50686,"_5":30900,"_12136":50354,"_2302":50687},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll`. El cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_5620":1630,"_30634":1502,"_25947":50689,"_5":30900,"_12136":50354,"_2302":50690},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_5620":1631,"_30634":1502,"_25947":50692,"_5":30900,"_12136":50358,"_2302":50693},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_5620":1632,"_30634":1502,"_25947":50695,"_5":30900,"_12136":50358,"_2302":50696},[],"`/cacerts`: descarga de la cadena de confianza.",{"_5620":1633,"_30634":1502,"_25947":50698,"_5":30900,"_12136":50358,"_2302":50699},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_5620":1634,"_30634":1502,"_25947":50701,"_5":30900,"_12136":50358,"_2302":50702},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_5620":1635,"_30634":1502,"_25947":50704,"_5":30900,"_12136":50358,"_2302":50705},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_5620":1636,"_30634":1502,"_25947":50707,"_5":30900,"_12136":50362,"_2302":50708},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_5620":1637,"_30634":1502,"_25947":50710,"_5":30900,"_12136":50362,"_2302":50711},[],"`CADistributionSettings` permite decidir qué se publica:",{"_5620":1638,"_30634":1502,"_25947":50713,"_5":30900,"_12136":50362,"_2302":50714},[],"**`IncludeLamassuSystemCA`** añade el certificado *downstream* del servidor Lamassu. Es la hoja TLS que el cliente puede usar para anclar la conexión, no una CA.",{"_5620":1639,"_30634":1502,"_25947":50716,"_5":30900,"_12136":50362,"_2302":50717},[],"**`IncludeEnrollmentCA`** añade la CA emisora del DMS, responsable de firmar los certificados de dispositivo.",{"_5620":1640,"_30634":1502,"_25947":50719,"_5":30900,"_12136":50362,"_2302":50720},[],"**`ManagedCAs`** publica CAs adicionales como anclas de confianza.",{"_5620":1641,"_30634":1502,"_25947":50722,"_5":30900,"_12136":50362,"_2302":50723},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_5620":1642,"_30634":1502,"_25947":50725,"_5":30900,"_12136":50362,"_2302":50726},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_5620":1643,"_30634":1502,"_25947":50728,"_5":30900,"_12136":50362,"_2302":50729},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_5620":1644,"_30634":1502,"_25947":50731,"_5":30900,"_12136":50362,"_2302":50732},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_5620":1645,"_30634":1502,"_25947":50734,"_5":30900,"_12136":50366,"_2302":50735},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_5620":1646,"_30634":1502,"_25947":50737,"_5":30900,"_12136":50366,"_2302":50738},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_5620":1647,"_30634":1502,"_25947":50740,"_5":30900,"_12136":50366,"_2302":50741},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos:",{"_5620":1648,"_30634":1502,"_25947":50743,"_5":30900,"_12136":50366,"_2302":50744},[],"**`EnrollmentSettings.RegistrationMode`** decide si el dispositivo se crea durante la primera inscripción (`JITP`) o debe existir previamente (`PRE_REGISTRATION`).",{"_5620":1649,"_30634":1502,"_25947":50746,"_5":30900,"_12136":50366,"_2302":50747},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** permite repetir `/simpleenroll` para un dispositivo ya enrolado. Al hacerlo, revoca el certificado anterior como `superseded`; si está desactivado, el servidor responde con `forbiddenNewEnrollment`.",{"_5620":1650,"_30634":1502,"_25947":50749,"_5":30900,"_12136":50366,"_2302":50750},[],"**`EnrollmentSettings.VerifyCSRSignature`** valida que quien envía el CSR controla la clave privada declarada. Para flotas IoT en redes abiertas debe estar activo.",{"_5620":1651,"_30634":1502,"_25947":50752,"_5":30900,"_12136":50366,"_2302":50753},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_5620":1652,"_30634":1502,"_25947":50755,"_5":30900,"_12136":50370,"_2302":50756},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_5620":1653,"_30634":1502,"_25947":50758,"_5":30900,"_12136":50370,"_2302":50759},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_5620":1654,"_30634":1502,"_25947":50761,"_5":30900,"_12136":50370,"_2302":50762},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_5620":1655,"_30634":1502,"_25947":50764,"_5":30900,"_12136":50370,"_2302":50765},[],"**`ReEnrollmentDelta`** abre la ventana de renovación en `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_5620":1656,"_30634":1502,"_25947":50767,"_5":30900,"_12136":50370,"_2302":50768},[],"**`EnableExpiredRenewal`** permite usar un certificado ya caducado como prueba de identidad; si está desactivado, el servidor responde con `expired certificate`.",{"_5620":1657,"_30634":1502,"_25947":50770,"_5":30900,"_12136":50370,"_2302":50771},[],"**`RevokeOnReEnrollment`** revoca el certificado anterior como `superseded` después de emitir el nuevo.",{"_5620":1658,"_30634":1502,"_25947":50773,"_5":30900,"_12136":50370,"_2302":50774},[],"**`AdditionalValidationCAs`** añade emisores válidos para el certificado actual, además de la CA de enrolamiento del DMS.",{"_5620":1659,"_30634":1502,"_25947":50776,"_5":30900,"_12136":50370,"_2302":50777},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_5620":1660,"_30634":1502,"_25947":50779,"_5":30900,"_12136":50370,"_2302":50780},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_5620":1661,"_30634":1502,"_25947":50782,"_5":30900,"_12136":50374,"_2302":50783},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_5620":1662,"_30634":1502,"_25947":50785,"_5":30900,"_12136":50374,"_2302":50786},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_5620":1663,"_30634":1502,"_25947":50788,"_5":30900,"_12136":50374,"_2302":50789},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_5620":1664,"_30634":1502,"_25947":50791,"_5":30900,"_12136":50374,"_2302":50792},[],"**RSA** admite cualquier tamaño aceptado por `crypto/rsa`; los valores habituales son 2048, 3072 y 4096 bits. Un valor no válido hace fallar la generación con un error `500`.",{"_5620":1665,"_30634":1502,"_25947":50794,"_5":30900,"_12136":50374,"_2302":50795},[],"**ECDSA** admite 224, 256, 384 y 521 bits, equivalentes a P-224, P-256 (`prime256v1`), P-384 y P-521. Cualquier otro valor degrada **silenciosamente** a P-256 y solo deja un aviso en el log: el cliente no recibe un error y puede obtener una curva distinta de la esperada.",{"_5620":1666,"_30634":1502,"_25947":50797,"_5":30900,"_12136":50374,"_2302":50798},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_5620":1667,"_30634":1502,"_25947":50800,"_5":30900,"_12136":50374,"_2302":50801},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_5620":1668,"_30634":1502,"_25947":50803,"_5":30900,"_12136":50374,"_2302":50804},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_5620":1669,"_30634":1502,"_25947":50806,"_5":30900,"_12136":50374,"_2302":50807},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_5620":1670,"_30634":1502,"_25947":50809,"_5":30900,"_12136":50374,"_2302":50810},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_5620":1671,"_30634":1502,"_25947":50812,"_5":30900,"_12136":50374,"_2302":50813},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_5620":1672,"_30634":1502,"_25947":50815,"_5":30900,"_12136":50374,"_2302":50816},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_5620":1673,"_30634":1502,"_25947":50818,"_5":30900,"_12136":50378,"_2302":50819},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_5620":1674,"_30634":1502,"_25947":50821,"_5":30900,"_12136":50382,"_2302":50822},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_5620":1675,"_30634":1502,"_25947":50824,"_5":30900,"_12136":50386,"_2302":50825},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_5620":1676,"_30634":1502,"_25947":50827,"_5":30900,"_12136":50390,"_2302":50828},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_5620":1677,"_30634":1502,"_25947":50830,"_5":30900,"_12136":50390,"_2302":50831},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_5620":1678,"_30634":1502,"_25947":50833,"_5":30900,"_12136":50390,"_2302":50834},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_5620":1679,"_30634":1502,"_25947":50836,"_5":30900,"_12136":50390,"_2302":50837},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_5620":1680,"_30634":1502,"_25947":50839,"_5":30900,"_12136":50396,"_2302":50840},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_5620":1681,"_30634":1502,"_25947":50842,"_5":30900,"_12136":50396,"_2302":49208},[],{"_5620":1682,"_30634":1502,"_25947":50844,"_5":30900,"_12136":50396,"_2302":48992},[],{"_5620":1683,"_30634":1502,"_25947":50846,"_5":30900,"_12136":50396,"_2302":50847},[],"Causa",{"_5620":1684,"_30634":1502,"_25947":50849,"_5":30900,"_12136":50396,"_2302":49217},[],{"_5620":1685,"_30634":1502,"_25947":50851,"_5":30900,"_12136":50396,"_2302":28486},[],{"_5620":1686,"_30634":1502,"_25947":50853,"_5":30900,"_12136":50396,"_2302":50854},[],"`Field validation for 'APS' failed`",{"_5620":1687,"_30634":1502,"_25947":50856,"_5":30900,"_12136":50396,"_2302":50857},[],"El segmento `{aps}` falta en la URL.",{"_5620":1688,"_30634":1502,"_25947":50859,"_5":30900,"_12136":50396,"_2302":50860},[],"Incluir el ID del DMS en la ruta.",{"_5620":1689,"_30634":1502,"_25947":50862,"_5":30900,"_12136":50396,"_2302":28486},[],{"_5620":1690,"_30634":1502,"_25947":50864,"_5":30900,"_12136":50396,"_2302":50865},[],"`content-type must be application/pkcs10`",{"_5620":1691,"_30634":1502,"_25947":50867,"_5":30900,"_12136":50396,"_2302":50868},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_5620":1692,"_30634":1502,"_25947":50870,"_5":30900,"_12136":50396,"_2302":50871},[],"Fijar `Content-Type: application/pkcs10`.",{"_5620":1693,"_30634":1502,"_25947":50873,"_5":30900,"_12136":50396,"_2302":28486},[],{"_5620":1694,"_30634":1502,"_25947":50875,"_5":30900,"_12136":50396,"_2302":50876},[],"`body payload must be base64 encoded`",{"_5620":1695,"_30634":1502,"_25947":50878,"_5":30900,"_12136":50396,"_2302":50879},[],"El cuerpo no es base64 válido.",{"_5620":1696,"_30634":1502,"_25947":50881,"_5":30900,"_12136":50396,"_2302":50882},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_5620":1697,"_30634":1502,"_25947":50884,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1698,"_30634":1502,"_25947":50886,"_5":30900,"_12136":50396,"_2302":50887},[],"`DMS not found`",{"_5620":1699,"_30634":1502,"_25947":50889,"_5":30900,"_12136":50396,"_2302":50890},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_5620":1700,"_30634":1502,"_25947":50892,"_5":30900,"_12136":50396,"_2302":50893},[],"Verificar el identificador con el administrador PKI.",{"_5620":1701,"_30634":1502,"_25947":50895,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1702,"_30634":1502,"_25947":50897,"_5":30900,"_12136":50396,"_2302":50898},[],"`invalid certificate`",{"_5620":1703,"_30634":1502,"_25947":50900,"_5":30900,"_12136":50396,"_2302":50901},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_5620":1704,"_30634":1502,"_25947":50903,"_5":30900,"_12136":50396,"_2302":50904},[],"Comprobar la cadena del certificado bootstrap.",{"_5620":1705,"_30634":1502,"_25947":50906,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1706,"_30634":1502,"_25947":50908,"_5":30900,"_12136":50396,"_2302":50909},[],"`certificate is revoked`",{"_5620":1707,"_30634":1502,"_25947":50911,"_5":30900,"_12136":50396,"_2302":50912},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_5620":1708,"_30634":1502,"_25947":50914,"_5":30900,"_12136":50396,"_2302":50915},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_5620":1709,"_30634":1502,"_25947":50917,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1710,"_30634":1502,"_25947":50919,"_5":30900,"_12136":50396,"_2302":50920},[],"`revoked certificate`",{"_5620":1711,"_30634":1502,"_25947":50922,"_5":30900,"_12136":50396,"_2302":50923},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_5620":1712,"_30634":1502,"_25947":50925,"_5":30900,"_12136":50396,"_2302":50926},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_5620":1713,"_30634":1502,"_25947":50928,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1714,"_30634":1502,"_25947":50930,"_5":30900,"_12136":50396,"_2302":50931},[],"`expired certificate`",{"_5620":1715,"_30634":1502,"_25947":50933,"_5":30900,"_12136":50396,"_2302":50934},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_5620":1716,"_30634":1502,"_25947":50936,"_5":30900,"_12136":50396,"_2302":50937},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_5620":1717,"_30634":1502,"_25947":50939,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1718,"_30634":1502,"_25947":50941,"_5":30900,"_12136":50396,"_2302":50942},[],"`forbiddenNewEnrollment`",{"_5620":1719,"_30634":1502,"_25947":50944,"_5":30900,"_12136":50396,"_2302":50945},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_5620":1720,"_30634":1502,"_25947":50947,"_5":30900,"_12136":50396,"_2302":50948},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_5620":1721,"_30634":1502,"_25947":50950,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1722,"_30634":1502,"_25947":50952,"_5":30900,"_12136":50396,"_2302":50953},[],"`device not preregistered`",{"_5620":1723,"_30634":1502,"_25947":50955,"_5":30900,"_12136":50396,"_2302":50956},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_5620":1724,"_30634":1502,"_25947":50958,"_5":30900,"_12136":50396,"_2302":50959},[],"Registrar el dispositivo antes de inscribirlo.",{"_5620":1725,"_30634":1502,"_25947":50961,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1726,"_30634":1502,"_25947":50963,"_5":30900,"_12136":50396,"_2302":50964},[],"`invalid reenroll window`",{"_5620":1727,"_30634":1502,"_25947":50966,"_5":30900,"_12136":50396,"_2302":50967},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_5620":1728,"_30634":1502,"_25947":50969,"_5":30900,"_12136":50396,"_2302":50970},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_5620":1729,"_30634":1502,"_25947":50972,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1730,"_30634":1502,"_25947":50974,"_5":30900,"_12136":50396,"_2302":50975},[],"`invalid RawSubject bytes`",{"_5620":1731,"_30634":1502,"_25947":50977,"_5":30900,"_12136":50396,"_2302":50978},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_5620":1732,"_30634":1502,"_25947":50980,"_5":30900,"_12136":50396,"_2302":50981},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_5620":1733,"_30634":1502,"_25947":50983,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1734,"_30634":1502,"_25947":50985,"_5":30900,"_12136":50396,"_2302":50986},[],"`external webhook denied enrollment`",{"_5620":1735,"_30634":1502,"_25947":50988,"_5":30900,"_12136":50396,"_2302":50989},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_5620":1736,"_30634":1502,"_25947":50991,"_5":30900,"_12136":50396,"_2302":50992},[],"Revisar los logs del servicio webhook.",{"_5620":1737,"_30634":1502,"_25947":50994,"_5":30900,"_12136":50396,"_2302":27919},[],{"_5620":1738,"_30634":1502,"_25947":50996,"_5":30900,"_12136":50396,"_2302":50997},[],"`server key generation not enabled`",{"_5620":1739,"_30634":1502,"_25947":50999,"_5":30900,"_12136":50396,"_2302":51000},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_5620":1740,"_30634":1502,"_25947":51002,"_5":30900,"_12136":50396,"_2302":51003},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_5620":1741,"_30634":1502,"_25947":51005,"_5":30900,"_12136":50396,"_2302":51006},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_5620":1742,"_30634":1502,"_25947":51008,"_5":30900,"_12136":50399,"_2302":51009},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_5620":1743,"_30634":1502,"_25947":51011,"_5":30900,"_12136":50399,"_2302":51012},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_5620":1744,"_30634":1502,"_25947":51014,"_5":30900,"_12136":50399,"_2302":51015},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_5620":1745,"_30634":1502,"_25947":51017,"_5":30900,"_12136":50399,"_2302":51018},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_5620":1746,"_30634":1502,"_25947":51020,"_5":30900,"_12136":50399,"_2302":51021},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_5620":1747,"_30634":1502,"_25947":51023,"_5":30900,"_12136":50399,"_2302":51024},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_5620":1748,"_30634":1502,"_25947":51026,"_5":30900,"_12136":50399,"_2302":51027},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_5620":1749,"_30634":1502,"_25947":51029,"_5":30900,"_12136":50399,"_2302":49419},[],{"_5620":1750,"_30634":1502,"_25947":51031,"_5":30900,"_12136":50399,"_2302":51032},[],"<Card title=\"Enrolamiento CMP\" href=\"/docs/platform/pki/cmp\" />",{"_5620":1751,"_30634":1502,"_25947":51034,"_5":30900,"_12136":50399,"_2302":51035},[],"<Card title=\"Validación OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_5620":1752,"_30634":1502,"_25947":51037,"_5":30900,"_12136":50399,"_2302":49425},[],{"_5620":1753,"_30634":1753,"_5":30895,"_2302":51039,"_30908":51040,"_25947":51042,"_12136":1753},"AWS IoT Core",[45667,46751,51041],"Integraciones",[],{"_5620":1754,"_30634":1753,"_25947":51044,"_5":30900,"_12136":1753,"_2302":51045},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_5620":1755,"_30634":1753,"_5":30905,"_25947":51047,"_12136":51048,"_2302":51049},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_5620":1756,"_30634":1753,"_5":30905,"_25947":51051,"_12136":51052,"_2302":51053},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_5620":1757,"_30634":1753,"_5":30905,"_25947":51055,"_12136":51056,"_2302":51057},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_5620":1758,"_30634":1753,"_5":30905,"_25947":51059,"_12136":51060,"_2302":51061},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_5620":1759,"_30634":1753,"_5":30905,"_25947":51063,"_12136":51064,"_2302":51065},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_5620":1760,"_30634":1753,"_5":30905,"_25947":51067,"_12136":51068,"_2302":51069},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_5620":1761,"_30634":1753,"_5":30905,"_25947":51071,"_12136":51072,"_2302":51073},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_5620":1762,"_30634":1753,"_5":30905,"_25947":51075,"_12136":51076,"_2302":51077},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_5620":1763,"_30634":1753,"_5":30905,"_25947":51079,"_12136":51080,"_2302":47888},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#configuración-del-dms",{"_5620":1764,"_30634":1753,"_5":30905,"_25947":51082,"_12136":51083,"_2302":51084},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-none","Modo `none`",{"_5620":1765,"_30634":1753,"_5":30905,"_25947":51086,"_12136":51087,"_2302":51088},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_5620":1766,"_30634":1753,"_5":30905,"_25947":51090,"_12136":51091,"_2302":51092},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_5620":1767,"_30634":1753,"_5":30905,"_25947":51094,"_12136":51095,"_2302":51096},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_5620":1768,"_30634":1753,"_5":30905,"_25947":51098,"_12136":51099,"_2302":51100},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_5620":1769,"_30634":1753,"_5":30905,"_25947":51102,"_12136":51103,"_2302":51104},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_5620":1770,"_30634":1753,"_5":30905,"_25947":51106,"_12136":51107,"_2302":51108},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_5620":1771,"_30634":1753,"_5":30905,"_25947":51110,"_12136":51111,"_2302":51112},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_5620":1772,"_30634":1753,"_5":30905,"_25947":51114,"_12136":51115,"_2302":51116},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_5620":1773,"_30634":1753,"_5":30905,"_25947":51118,"_12136":51119,"_2302":51120},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_5620":1774,"_30634":1753,"_5":30905,"_25947":51122,"_12136":51123,"_2302":51124},[],"/docs/pr-preview/pr-24/platform/pki/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_5620":1775,"_30634":1753,"_25947":51126,"_5":30900,"_12136":1753,"_2302":51127},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_5620":1776,"_30634":1753,"_25947":51129,"_5":30900,"_12136":1753,"_2302":51130},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_5620":1777,"_30634":1753,"_25947":51132,"_5":30900,"_12136":1753,"_2302":51133},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_5620":1778,"_30634":1753,"_25947":51135,"_5":30900,"_12136":51048,"_2302":51136},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_5620":1779,"_30634":1753,"_25947":51138,"_5":30900,"_12136":51048,"_2302":51139},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_5620":1780,"_30634":1753,"_25947":51141,"_5":30900,"_12136":51048,"_2302":51142},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_5620":1781,"_30634":1753,"_25947":51144,"_5":30900,"_12136":51048,"_2302":51145},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_5620":1782,"_30634":1753,"_25947":51147,"_5":30900,"_12136":51052,"_2302":51148},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_5620":1783,"_30634":1753,"_25947":51150,"_5":30900,"_12136":51056,"_2302":51151},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_5620":1784,"_30634":1753,"_25947":51153,"_5":30900,"_12136":51056,"_2302":51154},[],"Acción IAM",{"_5620":1785,"_30634":1753,"_25947":51156,"_5":30900,"_12136":51056,"_2302":51157},[],"Propósito",{"_5620":1786,"_30634":1753,"_25947":51159,"_5":30900,"_12136":51056,"_2302":51160},[],"`iot:GetRegistrationCode`",{"_5620":1787,"_30634":1753,"_25947":51162,"_5":30900,"_12136":51056,"_2302":51163},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_5620":1788,"_30634":1753,"_25947":51165,"_5":30900,"_12136":51056,"_2302":51166},[],"`iot:RegisterCACertificate`",{"_5620":1789,"_30634":1753,"_25947":51168,"_5":30900,"_12136":51056,"_2302":51169},[],"Registrar la CA en AWS IoT",{"_5620":1790,"_30634":1753,"_25947":51171,"_5":30900,"_12136":51056,"_2302":51172},[],"`iot:DescribeCACertificate`",{"_5620":1791,"_30634":1753,"_25947":51174,"_5":30900,"_12136":51056,"_2302":51175},[],"Consultar el estado del registro de la CA",{"_5620":1792,"_30634":1753,"_25947":51177,"_5":30900,"_12136":51056,"_2302":51178},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_5620":1793,"_30634":1753,"_25947":51180,"_5":30900,"_12136":51056,"_2302":51181},[],"Crear o actualizar Things en IoT Core",{"_5620":1794,"_30634":1753,"_25947":51183,"_5":30900,"_12136":51056,"_2302":51184},[],"`iot:RegisterThing`",{"_5620":1795,"_30634":1753,"_25947":51186,"_5":30900,"_12136":51056,"_2302":51187},[],"Aprovisionar Things mediante plantilla",{"_5620":1796,"_30634":1753,"_25947":51189,"_5":30900,"_12136":51056,"_2302":51190},[],"`iot:RegisterCertificate`",{"_5620":1797,"_30634":1753,"_25947":51192,"_5":30900,"_12136":51056,"_2302":51193},[],"Registrar certificados de dispositivo",{"_5620":1798,"_30634":1753,"_25947":51195,"_5":30900,"_12136":51056,"_2302":51196},[],"`iot:UpdateCertificate`",{"_5620":1799,"_30634":1753,"_25947":51198,"_5":30900,"_12136":51056,"_2302":51199},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_5620":1800,"_30634":1753,"_25947":51201,"_5":30900,"_12136":51056,"_2302":51202},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_5620":1801,"_30634":1753,"_25947":51204,"_5":30900,"_12136":51056,"_2302":51205},[],"Crear y adjuntar políticas IoT",{"_5620":1802,"_30634":1753,"_25947":51207,"_5":30900,"_12136":51056,"_2302":51208},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_5620":1803,"_30634":1753,"_25947":51210,"_5":30900,"_12136":51056,"_2302":51211},[],"Gestionar grupos de Things",{"_5620":1804,"_30634":1753,"_25947":51213,"_5":30900,"_12136":51056,"_2302":51214},[],"`iot:CreateProvisioningTemplate`",{"_5620":1805,"_30634":1753,"_25947":51216,"_5":30900,"_12136":51056,"_2302":51217},[],"Crear plantillas JITP",{"_5620":1806,"_30634":1753,"_25947":51219,"_5":30900,"_12136":51056,"_2302":51220},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_5620":1807,"_30634":1753,"_25947":51222,"_5":30900,"_12136":51056,"_2302":51223},[],"Leer y escribir el Device Shadow",{"_5620":1808,"_30634":1753,"_25947":51225,"_5":30900,"_12136":51056,"_2302":51226},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_5620":1809,"_30634":1753,"_25947":51228,"_5":30900,"_12136":51060,"_2302":51229},[],"Parámetro",{"_5620":1810,"_30634":1753,"_25947":51231,"_5":30900,"_12136":51060,"_2302":48274},[],{"_5620":1811,"_30634":1753,"_25947":51233,"_5":30900,"_12136":51060,"_2302":51234},[],"Requerido",{"_5620":1812,"_30634":1753,"_25947":51236,"_5":30900,"_12136":51060,"_2302":46038},[],{"_5620":1813,"_30634":1753,"_25947":51238,"_5":30900,"_12136":51060,"_2302":51239},[],"`connector_id`",{"_5620":1814,"_30634":1753,"_25947":51241,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1815,"_30634":1753,"_25947":51243,"_5":30900,"_12136":51060,"_2302":49075},[],{"_5620":1816,"_30634":1753,"_25947":51245,"_5":30900,"_12136":51060,"_2302":51246},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_5620":1817,"_30634":1753,"_25947":51248,"_5":30900,"_12136":51060,"_2302":51249},[],"`aws_config.region`",{"_5620":1818,"_30634":1753,"_25947":51251,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1819,"_30634":1753,"_25947":51253,"_5":30900,"_12136":51060,"_2302":49075},[],{"_5620":1820,"_30634":1753,"_25947":51255,"_5":30900,"_12136":51060,"_2302":51256},[],"Región AWS donde opera el conector.",{"_5620":1821,"_30634":1753,"_25947":51258,"_5":30900,"_12136":51060,"_2302":51259},[],"`aws_config.auth_method`",{"_5620":1822,"_30634":1753,"_25947":51261,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1823,"_30634":1753,"_25947":51263,"_5":30900,"_12136":51060,"_2302":49075},[],{"_5620":1824,"_30634":1753,"_25947":51265,"_5":30900,"_12136":51060,"_2302":51266},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_5620":1825,"_30634":1753,"_25947":51268,"_5":30900,"_12136":51060,"_2302":51269},[],"`aws_config.access_key_id`",{"_5620":1826,"_30634":1753,"_25947":51271,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1827,"_30634":1753,"_25947":51273,"_5":30900,"_12136":51060,"_2302":51274},[],"Solo con `auth_method=static`",{"_5620":1828,"_30634":1753,"_25947":51276,"_5":30900,"_12136":51060,"_2302":51277},[],"Clave de acceso AWS.",{"_5620":1829,"_30634":1753,"_25947":51279,"_5":30900,"_12136":51060,"_2302":51280},[],"`aws_config.secret_access_key`",{"_5620":1830,"_30634":1753,"_25947":51282,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1831,"_30634":1753,"_25947":51284,"_5":30900,"_12136":51060,"_2302":51274},[],{"_5620":1832,"_30634":1753,"_25947":51286,"_5":30900,"_12136":51060,"_2302":51287},[],"Clave secreta AWS.",{"_5620":1833,"_30634":1753,"_25947":51289,"_5":30900,"_12136":51060,"_2302":51290},[],"`aws_config.session_token`",{"_5620":1834,"_30634":1753,"_25947":51292,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1835,"_30634":1753,"_25947":51294,"_5":30900,"_12136":51060,"_2302":49043},[],{"_5620":1836,"_30634":1753,"_25947":51296,"_5":30900,"_12136":51060,"_2302":51297},[],"Token de sesión (con `auth_method=static`).",{"_5620":1837,"_30634":1753,"_25947":51299,"_5":30900,"_12136":51060,"_2302":51300},[],"`aws_config.role_arn`",{"_5620":1838,"_30634":1753,"_25947":51302,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1839,"_30634":1753,"_25947":51304,"_5":30900,"_12136":51060,"_2302":51305},[],"Solo con `auth_method=role`",{"_5620":1840,"_30634":1753,"_25947":51307,"_5":30900,"_12136":51060,"_2302":51308},[],"ARN del rol a asumir.",{"_5620":1841,"_30634":1753,"_25947":51310,"_5":30900,"_12136":51060,"_2302":51311},[],"`aws_config.endpoint_url`",{"_5620":1842,"_30634":1753,"_25947":51313,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1843,"_30634":1753,"_25947":51315,"_5":30900,"_12136":51060,"_2302":49043},[],{"_5620":1844,"_30634":1753,"_25947":51317,"_5":30900,"_12136":51060,"_2302":51318},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_5620":1845,"_30634":1753,"_25947":51320,"_5":30900,"_12136":51060,"_2302":51321},[],"`subscriber_event_bus`",{"_5620":1846,"_30634":1753,"_25947":51323,"_5":30900,"_12136":51060,"_2302":19933},[],{"_5620":1847,"_30634":1753,"_25947":51325,"_5":30900,"_12136":51060,"_2302":49075},[],{"_5620":1848,"_30634":1753,"_25947":51327,"_5":30900,"_12136":51060,"_2302":51328},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_5620":1849,"_30634":1753,"_25947":51330,"_5":30900,"_12136":51060,"_2302":51331},[],"`dms_manager_client`",{"_5620":1850,"_30634":1753,"_25947":51333,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1851,"_30634":1753,"_25947":51335,"_5":30900,"_12136":51060,"_2302":49075},[],{"_5620":1852,"_30634":1753,"_25947":51337,"_5":30900,"_12136":51060,"_2302":51338},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_5620":1853,"_30634":1753,"_25947":51340,"_5":30900,"_12136":51060,"_2302":51341},[],"`device_manager_client`",{"_5620":1854,"_30634":1753,"_25947":51343,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1855,"_30634":1753,"_25947":51345,"_5":30900,"_12136":51060,"_2302":49075},[],{"_5620":1856,"_30634":1753,"_25947":51347,"_5":30900,"_12136":51060,"_2302":51348},[],"URL HTTP del Device Manager de Lamassu.",{"_5620":1857,"_30634":1753,"_25947":51350,"_5":30900,"_12136":51060,"_2302":51351},[],"`ca_client`",{"_5620":1858,"_30634":1753,"_25947":51353,"_5":30900,"_12136":51060,"_2302":25559},[],{"_5620":1859,"_30634":1753,"_25947":51355,"_5":30900,"_12136":51060,"_2302":49075},[],{"_5620":1860,"_30634":1753,"_25947":51357,"_5":30900,"_12136":51060,"_2302":51358},[],"URL HTTP del servicio de CA de Lamassu.",{"_5620":1861,"_30634":1753,"_25947":51360,"_5":30900,"_12136":51064,"_2302":51361},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_5620":1862,"_30634":1753,"_25947":51363,"_5":30900,"_12136":51068,"_2302":51364},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_5620":1863,"_30634":1753,"_25947":51366,"_5":30900,"_12136":51068,"_2302":51367},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_5620":1864,"_30634":1753,"_25947":51369,"_5":30900,"_12136":51072,"_2302":51370},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_5620":1865,"_30634":1753,"_25947":51372,"_5":30900,"_12136":51072,"_2302":51373},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_5620":1866,"_30634":1753,"_25947":51375,"_5":30900,"_12136":51072,"_2302":51376},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_5620":1867,"_30634":1753,"_25947":51378,"_5":30900,"_12136":51072,"_2302":51379},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_5620":1868,"_30634":1753,"_25947":51381,"_5":30900,"_12136":51072,"_2302":51382},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_5620":1869,"_30634":1753,"_25947":51384,"_5":30900,"_12136":51072,"_2302":51385},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_5620":1870,"_30634":1753,"_25947":51387,"_5":30900,"_12136":51076,"_2302":51388},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_5620":1871,"_30634":1753,"_25947":51390,"_5":30900,"_12136":51080,"_2302":51391},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_5620":1872,"_30634":1753,"_25947":51393,"_5":30900,"_12136":51080,"_2302":51394},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_5620":1873,"_30634":1753,"_25947":51396,"_5":30900,"_12136":51083,"_2302":51397},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_5620":1874,"_30634":1753,"_25947":51399,"_5":30900,"_12136":51087,"_2302":51400},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_5620":1875,"_30634":1753,"_25947":51402,"_5":30900,"_12136":51087,"_2302":51403},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_5620":1876,"_30634":1753,"_25947":51405,"_5":30900,"_12136":51087,"_2302":51406},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_5620":1877,"_30634":1753,"_25947":51408,"_5":30900,"_12136":51087,"_2302":51409},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_5620":1878,"_30634":1753,"_25947":51411,"_5":30900,"_12136":51087,"_2302":51412},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_5620":1879,"_30634":1753,"_25947":51414,"_5":30900,"_12136":51087,"_2302":51415},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_5620":1880,"_30634":1753,"_25947":51417,"_5":30900,"_12136":51091,"_2302":51418},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_5620":1881,"_30634":1753,"_25947":51420,"_5":30900,"_12136":51091,"_2302":51421},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_5620":1882,"_30634":1753,"_25947":51423,"_5":30900,"_12136":51091,"_2302":51424},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_5620":1883,"_30634":1753,"_25947":51426,"_5":30900,"_12136":51095,"_2302":51427},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_5620":1884,"_30634":1753,"_25947":51429,"_5":30900,"_12136":51095,"_2302":51430},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_5620":1885,"_30634":1753,"_25947":51432,"_5":30900,"_12136":51095,"_2302":51433},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_5620":1886,"_30634":1753,"_25947":51435,"_5":30900,"_12136":51099,"_2302":51436},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_5620":1887,"_30634":1753,"_25947":51438,"_5":30900,"_12136":51099,"_2302":51439},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_5620":1888,"_30634":1753,"_25947":51441,"_5":30900,"_12136":51099,"_2302":51442},[],"Para que el flujo JITP funcione correctamente:",{"_5620":1889,"_30634":1753,"_25947":51444,"_5":30900,"_12136":51099,"_2302":51445},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_5620":1890,"_30634":1753,"_25947":51447,"_5":30900,"_12136":51099,"_2302":51448},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_5620":1891,"_30634":1753,"_25947":51450,"_5":30900,"_12136":51099,"_2302":51451},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_5620":1892,"_30634":1753,"_25947":51453,"_5":30900,"_12136":51099,"_2302":51454},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_5620":1893,"_30634":1753,"_25947":51456,"_5":30900,"_12136":51103,"_2302":51457},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_5620":1894,"_30634":1753,"_25947":51459,"_5":30900,"_12136":51103,"_2302":51460},[],"Estado en Lamassu",{"_5620":1895,"_30634":1753,"_25947":51462,"_5":30900,"_12136":51103,"_2302":51463},[],"Razón de revocación",{"_5620":1896,"_30634":1753,"_25947":51465,"_5":30900,"_12136":51103,"_2302":51466},[],"Estado en AWS IoT Core",{"_5620":1897,"_30634":1753,"_25947":51468,"_5":30900,"_12136":51103,"_2302":51469},[],"`Active`",{"_5620":1898,"_30634":1753,"_25947":51471,"_5":30900,"_12136":51103,"_2302":50664},[],{"_5620":1899,"_30634":1753,"_25947":51473,"_5":30900,"_12136":51103,"_2302":51474},[],"`ACTIVE`",{"_5620":1900,"_30634":1753,"_25947":51476,"_5":30900,"_12136":51103,"_2302":51477},[],"`Revoked`",{"_5620":1901,"_30634":1753,"_25947":51479,"_5":30900,"_12136":51103,"_2302":51480},[],"`certificateHold`",{"_5620":1902,"_30634":1753,"_25947":51482,"_5":30900,"_12136":51103,"_2302":51483},[],"`INACTIVE`",{"_5620":1903,"_30634":1753,"_25947":51485,"_5":30900,"_12136":51103,"_2302":51477},[],{"_5620":1904,"_30634":1753,"_25947":51487,"_5":30900,"_12136":51103,"_2302":51488},[],"Cualquier otra razón",{"_5620":1905,"_30634":1753,"_25947":51490,"_5":30900,"_12136":51103,"_2302":48857},[],{"_5620":1906,"_30634":1753,"_25947":51492,"_5":30900,"_12136":51103,"_2302":51493},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_5620":1907,"_30634":1753,"_25947":51495,"_5":30900,"_12136":51107,"_2302":51496},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_5620":1908,"_30634":1753,"_25947":51498,"_5":30900,"_12136":51107,"_2302":51499},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_5620":1909,"_30634":1753,"_25947":51501,"_5":30900,"_12136":51107,"_2302":51502},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_5620":1910,"_30634":1753,"_25947":51504,"_5":30900,"_12136":51111,"_2302":51505},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_5620":1911,"_30634":1753,"_25947":51507,"_5":30900,"_12136":51111,"_2302":51508},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_5620":1912,"_30634":1753,"_25947":51510,"_5":30900,"_12136":51115,"_2302":51511},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_5620":1913,"_30634":1753,"_25947":51513,"_5":30900,"_12136":51115,"_2302":51514},[],"Existen dos tipos de acciones:",{"_5620":1914,"_30634":1753,"_25947":51516,"_5":30900,"_12136":51115,"_2302":51517},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_5620":1915,"_30634":1753,"_25947":51519,"_5":30900,"_12136":51115,"_2302":51520},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_5620":1916,"_30634":1753,"_25947":51522,"_5":30900,"_12136":51115,"_2302":51523},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_5620":1917,"_30634":1753,"_25947":51525,"_5":30900,"_12136":51119,"_2302":51526},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_5620":1918,"_30634":1753,"_25947":51528,"_5":30900,"_12136":51119,"_2302":51529},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_5620":1919,"_30634":1753,"_25947":51531,"_5":30900,"_12136":51119,"_2302":51532},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_5620":1920,"_30634":1753,"_25947":51534,"_5":30900,"_12136":51123,"_2302":51535},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_5620":1921,"_30634":1753,"_25947":51537,"_5":30900,"_12136":51123,"_2302":51538},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_5620":1922,"_30634":1753,"_25947":51540,"_5":30900,"_12136":51123,"_2302":51541},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_5620":1923,"_30634":1753,"_25947":51543,"_5":30900,"_12136":51123,"_2302":51544},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_5620":1924,"_30634":1753,"_25947":51546,"_5":30900,"_12136":51123,"_2302":51547},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_5620":1925,"_30634":1753,"_25947":51549,"_5":30900,"_12136":51123,"_2302":51550},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_5620":1926,"_30634":1753,"_25947":51552,"_5":30900,"_12136":51123,"_2302":51553},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_5620":1927,"_30634":1753,"_25947":51555,"_5":30900,"_12136":51123,"_2302":51556},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_5620":1928,"_30634":1753,"_25947":51558,"_5":30900,"_12136":51123,"_2302":51559},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_5620":1929,"_30634":1753,"_25947":51561,"_5":30900,"_12136":51123,"_2302":51562},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_5620":1930,"_30634":1753,"_25947":51564,"_5":30900,"_12136":51123,"_2302":51565},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_5620":1931,"_30634":1753,"_25947":51567,"_5":30900,"_12136":51123,"_2302":51568},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_5620":1932,"_30634":1753,"_25947":51570,"_5":30900,"_12136":51123,"_2302":51571},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_5620":1933,"_30634":1753,"_25947":51573,"_5":30900,"_12136":51123,"_2302":51574},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_5620":1934,"_30634":1753,"_25947":51576,"_5":30900,"_12136":51123,"_2302":51577},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_5620":1935,"_30634":1753,"_25947":51579,"_5":30900,"_12136":51123,"_2302":51580},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_5620":1936,"_30634":1753,"_25947":51582,"_5":30900,"_12136":51123,"_2302":51583},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_5620":1937,"_30634":1753,"_25947":51585,"_5":30900,"_12136":51123,"_2302":51586},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_5620":1938,"_30634":1753,"_25947":51588,"_5":30900,"_12136":51123,"_2302":51589},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_5620":1939,"_30634":1753,"_25947":51591,"_5":30900,"_12136":51123,"_2302":51592},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_5620":1940,"_30634":1753,"_25947":51594,"_5":30900,"_12136":51123,"_2302":51595},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_5620":1941,"_30634":1941,"_5":30895,"_2302":51597,"_30908":51598,"_25947":51599,"_12136":1941},"Claves y motores criptográficos",[45667,46751,46904],[],{"_5620":1942,"_30634":1941,"_25947":51601,"_5":30900,"_12136":1941,"_2302":51602},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_5620":1943,"_30634":1941,"_5":30905,"_25947":51604,"_12136":51605,"_2302":51606},[],"/docs/pr-preview/pr-24/platform/pki/key-management#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_5620":1944,"_30634":1941,"_5":30905,"_25947":51608,"_12136":51609,"_2302":51610},[],"/docs/pr-preview/pr-24/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_5620":1945,"_30634":1941,"_5":30905,"_25947":51612,"_12136":51613,"_2302":51614},[],"/docs/pr-preview/pr-24/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_5620":1946,"_30634":1941,"_5":30905,"_25947":51616,"_12136":51617,"_2302":51618},[],"/docs/pr-preview/pr-24/platform/pki/key-management#file-system","File System",{"_5620":1947,"_30634":1941,"_5":30905,"_25947":51620,"_12136":51621,"_2302":51622},[],"/docs/pr-preview/pr-24/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_5620":1948,"_30634":1941,"_5":30905,"_25947":51624,"_12136":51625,"_2302":51626},[],"/docs/pr-preview/pr-24/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_5620":1949,"_30634":1941,"_5":30905,"_25947":51628,"_12136":51629,"_2302":51630},[],"/docs/pr-preview/pr-24/platform/pki/key-management#aws-kms","AWS KMS",{"_5620":1950,"_30634":1941,"_5":30905,"_25947":51632,"_12136":51633,"_2302":51634},[],"/docs/pr-preview/pr-24/platform/pki/key-management#pkcs11","PKCS#11",{"_5620":1951,"_30634":1941,"_5":30905,"_25947":51636,"_12136":51637,"_2302":51638},[],"/docs/pr-preview/pr-24/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_5620":1952,"_30634":1941,"_5":30905,"_25947":51640,"_12136":51641,"_2302":51642},[],"/docs/pr-preview/pr-24/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_5620":1953,"_30634":1941,"_5":30905,"_25947":51644,"_12136":51645,"_2302":51646},[],"/docs/pr-preview/pr-24/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_5620":1954,"_30634":1941,"_5":30905,"_25947":51648,"_12136":51649,"_2302":51650},[],"/docs/pr-preview/pr-24/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_5620":1955,"_30634":1941,"_5":30905,"_25947":51652,"_12136":51653,"_2302":51654},[],"/docs/pr-preview/pr-24/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_5620":1956,"_30634":1941,"_5":30905,"_25947":51656,"_12136":51657,"_2302":51658},[],"/docs/pr-preview/pr-24/platform/pki/key-management#ver-detalles","Ver detalles",{"_5620":1957,"_30634":1941,"_5":30905,"_25947":51660,"_12136":51661,"_2302":51662},[],"/docs/pr-preview/pr-24/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_5620":1958,"_30634":1941,"_5":30905,"_25947":51664,"_12136":51665,"_2302":51666},[],"/docs/pr-preview/pr-24/platform/pki/key-management#sign","Sign",{"_5620":1959,"_30634":1941,"_5":30905,"_25947":51668,"_12136":51669,"_2302":51670},[],"/docs/pr-preview/pr-24/platform/pki/key-management#verify","Verify",{"_5620":1960,"_30634":1941,"_5":30905,"_25947":51672,"_12136":51673,"_2302":51674},[],"/docs/pr-preview/pr-24/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_5620":1961,"_30634":1941,"_5":30905,"_25947":51676,"_12136":51677,"_2302":51678},[],"/docs/pr-preview/pr-24/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_5620":1962,"_30634":1941,"_25947":51680,"_5":30900,"_12136":51605,"_2302":51681},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_5620":1963,"_30634":1941,"_25947":51683,"_5":30900,"_12136":51605,"_2302":51684},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_5620":1964,"_30634":1941,"_25947":51686,"_5":30900,"_12136":51609,"_2302":51687},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_5620":1965,"_30634":1941,"_25947":51689,"_5":30900,"_12136":51609,"_2302":51690},[],"En la práctica, permite:",{"_5620":1966,"_30634":1941,"_25947":51692,"_5":30900,"_12136":51609,"_2302":51693},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_5620":1967,"_30634":1941,"_25947":51695,"_5":30900,"_12136":51609,"_2302":51696},[],"Importar claves creadas externamente.",{"_5620":1968,"_30634":1941,"_25947":51698,"_5":30900,"_12136":51609,"_2302":51699},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_5620":1969,"_30634":1941,"_25947":51701,"_5":30900,"_12136":51609,"_2302":51702},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_5620":1970,"_30634":1941,"_25947":51704,"_5":30900,"_12136":51613,"_2302":51705},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_5620":1971,"_30634":1941,"_25947":51707,"_5":30900,"_12136":51613,"_2302":51708},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_5620":1972,"_30634":1941,"_25947":51710,"_5":30900,"_12136":51613,"_2302":51711},[],"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado.",{"_5620":1973,"_30634":1941,"_25947":51713,"_5":30900,"_12136":51617,"_2302":51714},[],"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción.",{"_5620":1974,"_30634":1941,"_25947":51716,"_5":30900,"_12136":51621,"_2302":51717},[],"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*.",{"_5620":1975,"_30634":1941,"_25947":51719,"_5":30900,"_12136":51625,"_2302":51720},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_5620":1976,"_30634":1941,"_25947":51722,"_5":30900,"_12136":51629,"_2302":51723},[],"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica.",{"_5620":1977,"_30634":1941,"_25947":51725,"_5":30900,"_12136":51633,"_2302":51726},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_5620":1978,"_30634":1941,"_25947":51728,"_5":30900,"_12136":51633,"_2302":51729},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_5620":1979,"_30634":1941,"_25947":51731,"_5":30900,"_12136":51633,"_2302":51732},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_5620":1980,"_30634":1941,"_25947":51734,"_5":30900,"_12136":51633,"_2302":51735},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_5620":1981,"_30634":1941,"_25947":51737,"_5":30900,"_12136":51637,"_2302":51738},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_5620":1982,"_30634":1941,"_25947":51740,"_5":30900,"_12136":51637,"_2302":51741},[],"La tabla incluye los siguientes campos:",{"_5620":1983,"_30634":1941,"_25947":51743,"_5":30900,"_12136":51637,"_2302":51744},[],"**Name**: nombre descriptivo de la clave.",{"_5620":1984,"_30634":1941,"_25947":51746,"_5":30900,"_12136":51637,"_2302":51747},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_5620":1985,"_30634":1941,"_25947":51749,"_5":30900,"_12136":51637,"_2302":51750},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_5620":1986,"_30634":1941,"_25947":51752,"_5":30900,"_12136":51637,"_2302":51753},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_5620":1987,"_30634":1941,"_25947":51755,"_5":30900,"_12136":51637,"_2302":51756},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_5620":1988,"_30634":1941,"_25947":51758,"_5":30900,"_12136":51637,"_2302":51759},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_5620":1989,"_30634":1941,"_25947":51761,"_5":30900,"_12136":51637,"_2302":51762},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_5620":1990,"_30634":1941,"_25947":51764,"_5":30900,"_12136":51637,"_2302":51765},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_5620":1991,"_30634":1941,"_25947":51767,"_5":30900,"_12136":51637,"_2302":51768},[],"Desde esta vista también se accede a las acciones más habituales:",{"_5620":1992,"_30634":1941,"_25947":51770,"_5":30900,"_12136":51637,"_2302":51771},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_5620":1993,"_30634":1941,"_25947":51773,"_5":30900,"_12136":51637,"_2302":51774},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_5620":1994,"_30634":1941,"_25947":51776,"_5":30900,"_12136":51637,"_2302":51777},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_5620":1995,"_30634":1941,"_25947":51779,"_5":30900,"_12136":51637,"_2302":51780},[],"**Delete Key** para eliminar la clave del sistema.",{"_5620":1996,"_30634":1941,"_25947":51782,"_5":30900,"_12136":51641,"_2302":51783},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_5620":1997,"_30634":1941,"_25947":51785,"_5":30900,"_12136":51645,"_2302":51786},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_5620":1998,"_30634":1941,"_25947":51788,"_5":30900,"_12136":51645,"_2302":51789},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_5620":1999,"_30634":1941,"_25947":51791,"_5":30900,"_12136":51645,"_2302":51792},[],"**Key Name**: nombre único y descriptivo.",{"_5620":2000,"_30634":1941,"_25947":51794,"_5":30900,"_12136":51645,"_2302":51795},[],"**Crypto Engine**: motor que custodiará la clave.",{"_5620":2001,"_30634":1941,"_25947":51797,"_5":30900,"_12136":51645,"_2302":51798},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_5620":2002,"_30634":1941,"_25947":51800,"_5":30900,"_12136":51645,"_2302":51801},[],"**Tags**: metadatos para clasificar la clave.",{"_5620":2003,"_30634":1941,"_25947":51803,"_5":30900,"_12136":51645,"_2302":51804},[],"**Metadata**: información adicional para usos avanzados.",{"_5620":2004,"_30634":1941,"_25947":51806,"_5":30900,"_12136":51649,"_2302":51807},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_5620":2005,"_30634":1941,"_25947":51809,"_5":30900,"_12136":51649,"_2302":51810},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_5620":2006,"_30634":1941,"_25947":51812,"_5":30900,"_12136":51649,"_2302":51813},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_5620":2007,"_30634":1941,"_25947":51815,"_5":30900,"_12136":51649,"_2302":51816},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_5620":2008,"_30634":1941,"_25947":51818,"_5":30900,"_12136":51649,"_2302":51819},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_5620":2009,"_30634":1941,"_25947":51821,"_5":30900,"_12136":51649,"_2302":51822},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_5620":2010,"_30634":1941,"_25947":51824,"_5":30900,"_12136":51649,"_2302":51825},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_5620":2011,"_30634":1941,"_25947":51827,"_5":30900,"_12136":51649,"_2302":51828},[],"**Tags**: etiquetas para organización y búsqueda.",{"_5620":2012,"_30634":1941,"_25947":51830,"_5":30900,"_12136":51649,"_2302":51831},[],"**Metadata**: información adicional opcional.",{"_5620":2013,"_30634":1941,"_25947":51833,"_5":30900,"_12136":51649,"_2302":51834},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_5620":2014,"_30634":1941,"_25947":51836,"_5":30900,"_12136":51649,"_2302":51837},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_5620":2015,"_30634":1941,"_25947":51839,"_5":30900,"_12136":51653,"_2302":51840},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_5620":2016,"_30634":1941,"_25947":51842,"_5":30900,"_12136":51657,"_2302":51843},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_5620":2017,"_30634":1941,"_25947":51845,"_5":30900,"_12136":51657,"_2302":51846},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_5620":2018,"_30634":1941,"_25947":51848,"_5":30900,"_12136":51657,"_2302":51849},[],"**Key Name**: nombre descriptivo.",{"_5620":2019,"_30634":1941,"_25947":51851,"_5":30900,"_12136":51657,"_2302":51852},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_5620":2020,"_30634":1941,"_25947":51854,"_5":30900,"_12136":51657,"_2302":51855},[],"**Tags**: etiquetas asociadas.",{"_5620":2021,"_30634":1941,"_25947":51857,"_5":30900,"_12136":51657,"_2302":51858},[],"**Aliases**: nombres alternativos.",{"_5620":2022,"_30634":1941,"_25947":51860,"_5":30900,"_12136":51657,"_2302":51861},[],"**Crypto Engine**: motor en el que reside la clave.",{"_5620":2023,"_30634":1941,"_25947":51863,"_5":30900,"_12136":51657,"_2302":51864},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_5620":2024,"_30634":1941,"_25947":51866,"_5":30900,"_12136":51657,"_2302":51867},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_5620":2025,"_30634":1941,"_25947":51869,"_5":30900,"_12136":51657,"_2302":51870},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_5620":2026,"_30634":1941,"_25947":51872,"_5":30900,"_12136":51661,"_2302":51873},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_5620":2027,"_30634":1941,"_25947":51875,"_5":30900,"_12136":51661,"_2302":51876},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_5620":2028,"_30634":1941,"_25947":51878,"_5":30900,"_12136":51665,"_2302":51879},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_5620":2029,"_30634":1941,"_25947":51881,"_5":30900,"_12136":51665,"_2302":51882},[],"Campos principales:",{"_5620":2030,"_30634":1941,"_25947":51884,"_5":30900,"_12136":51665,"_2302":51885},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_5620":2031,"_30634":1941,"_25947":51887,"_5":30900,"_12136":51665,"_2302":51888},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_5620":2032,"_30634":1941,"_25947":51890,"_5":30900,"_12136":51665,"_2302":51891},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_5620":2033,"_30634":1941,"_25947":51893,"_5":30900,"_12136":51665,"_2302":51894},[],"**Message**: contenido que se va a firmar.",{"_5620":2034,"_30634":1941,"_25947":51896,"_5":30900,"_12136":51665,"_2302":51897},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_5620":2035,"_30634":1941,"_25947":51899,"_5":30900,"_12136":51669,"_2302":51900},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_5620":2036,"_30634":1941,"_25947":51902,"_5":30900,"_12136":51669,"_2302":51882},[],{"_5620":2037,"_30634":1941,"_25947":51904,"_5":30900,"_12136":51669,"_2302":51905},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_5620":2038,"_30634":1941,"_25947":51907,"_5":30900,"_12136":51669,"_2302":51908},[],"**Message Type**: `Raw` o `Digest`.",{"_5620":2039,"_30634":1941,"_25947":51910,"_5":30900,"_12136":51669,"_2302":51911},[],"**Payload Encoding**: codificación del mensaje.",{"_5620":2040,"_30634":1941,"_25947":51913,"_5":30900,"_12136":51669,"_2302":51914},[],"**Message**: mensaje original o hash.",{"_5620":2041,"_30634":1941,"_25947":51916,"_5":30900,"_12136":51669,"_2302":51917},[],"**Signature**: firma que se desea comprobar.",{"_5620":2042,"_30634":1941,"_25947":51919,"_5":30900,"_12136":51669,"_2302":51920},[],"**Result**: indicador del resultado de la validación.",{"_5620":2043,"_30634":1941,"_25947":51922,"_5":30900,"_12136":51673,"_2302":51923},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_5620":2044,"_30634":1941,"_25947":51925,"_5":30900,"_12136":51673,"_2302":51926},[],"Este flujo es útil para:",{"_5620":2045,"_30634":1941,"_25947":51928,"_5":30900,"_12136":51673,"_2302":51929},[],"Solicitar certificados a una CA externa.",{"_5620":2046,"_30634":1941,"_25947":51931,"_5":30900,"_12136":51673,"_2302":51932},[],"Renovar una identidad manteniendo la misma clave.",{"_5620":2047,"_30634":1941,"_25947":51934,"_5":30900,"_12136":51673,"_2302":51935},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_5620":2048,"_30634":1941,"_25947":51937,"_5":30900,"_12136":51673,"_2302":51938},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_5620":2049,"_30634":1941,"_25947":51940,"_5":30900,"_12136":51673,"_2302":51941},[],"**Organization (O)**: organización o empresa.",{"_5620":2050,"_30634":1941,"_25947":51943,"_5":30900,"_12136":51673,"_2302":51944},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_5620":2051,"_30634":1941,"_25947":51946,"_5":30900,"_12136":51673,"_2302":51947},[],"**Country (C)**: código de país de dos letras.",{"_5620":2052,"_30634":1941,"_25947":51949,"_5":30900,"_12136":51673,"_2302":51950},[],"**State / Province (ST)**: estado o provincia.",{"_5620":2053,"_30634":1941,"_25947":51952,"_5":30900,"_12136":51673,"_2302":51953},[],"**Locality (L)**: ciudad o localidad.",{"_5620":2054,"_30634":1941,"_25947":51955,"_5":30900,"_12136":51673,"_2302":51956},[],"**Email Address**: correo de contacto.",{"_5620":2055,"_30634":1941,"_25947":51958,"_5":30900,"_12136":51673,"_2302":51959},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_5620":2056,"_30634":1941,"_25947":51961,"_5":30900,"_12136":51673,"_2302":51962},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_5620":2057,"_30634":1941,"_25947":51964,"_5":30900,"_12136":51677,"_2302":51965},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_5620":2058,"_30634":1941,"_25947":51967,"_5":30900,"_12136":51677,"_2302":51968},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_5620":2059,"_30634":2059,"_5":30895,"_2302":51970,"_30908":51971,"_25947":51972,"_12136":2059},"Validación online con OCSP",[45667,46751,46904],[],{"_5620":2060,"_30634":2059,"_25947":51974,"_5":30900,"_12136":2059,"_2302":51975},[],"Consulta en tiempo real si un certificado sigue vigente o se ha revocado.",{"_5620":2061,"_30634":2059,"_5":30905,"_25947":51977,"_12136":51978,"_2302":51979},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#servicio-ocsp","Servicio OCSP",{"_5620":2062,"_30634":2059,"_5":30905,"_25947":51981,"_12136":51982,"_2302":51983},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_5620":2063,"_30634":2059,"_5":30905,"_25947":51985,"_12136":51986,"_2302":51987},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_5620":2064,"_30634":2059,"_5":30905,"_25947":51989,"_12136":51990,"_2302":51991},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_5620":2065,"_30634":2059,"_5":30905,"_25947":51993,"_12136":51994,"_2302":51995},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_5620":2066,"_30634":2059,"_5":30905,"_25947":51997,"_12136":51998,"_2302":49948},[],"/docs/pr-preview/pr-24/platform/pki/ocsp#referencias",{"_5620":2067,"_30634":2059,"_25947":52000,"_5":30900,"_12136":51978,"_2302":52001},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_5620":2068,"_30634":2059,"_25947":52003,"_5":30900,"_12136":51978,"_2302":52004},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_5620":2069,"_30634":2059,"_25947":52006,"_5":30900,"_12136":51982,"_2302":52007},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_5620":2070,"_30634":2059,"_25947":52009,"_5":30900,"_12136":51982,"_2302":52010},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_5620":2071,"_30634":2059,"_25947":52012,"_5":30900,"_12136":51982,"_2302":52013},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_5620":2072,"_30634":2059,"_25947":52015,"_5":30900,"_12136":51982,"_2302":52016},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_5620":2073,"_30634":2059,"_25947":52018,"_5":30900,"_12136":51982,"_2302":52019},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_5620":2074,"_30634":2059,"_25947":52021,"_5":30900,"_12136":51982,"_2302":52022},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_5620":2075,"_30634":2059,"_25947":52024,"_5":30900,"_12136":51986,"_2302":52025},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_5620":2076,"_30634":2059,"_25947":52027,"_5":30900,"_12136":51990,"_2302":52028},[],"El respondedor acepta los dos formatos definidos en RFC 6960:",{"_5620":2077,"_30634":2059,"_25947":52030,"_5":30900,"_12136":51990,"_2302":52031},[],"`GET /ocsp/{ocsp_request}` incluye la petición OCSP codificada en Base64url dentro de la propia URL.",{"_5620":2078,"_30634":2059,"_25947":52033,"_5":30900,"_12136":51990,"_2302":52034},[],"`POST /ocsp` envía la petición en el cuerpo con `Content-Type: application/ocsp-request`.",{"_5620":2079,"_30634":2059,"_25947":52036,"_5":30900,"_12136":51990,"_2302":52037},[],"Ejemplo de consulta con `curl` mediante POST:",{"_5620":2080,"_30634":2059,"_25947":52039,"_5":30900,"_12136":51990,"_2302":52040},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_5620":2081,"_30634":2059,"_25947":52042,"_5":30900,"_12136":51994,"_2302":52043},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_5620":2082,"_30634":2059,"_25947":52045,"_5":30900,"_12136":51998,"_2302":52046},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_5620":2083,"_30634":2059,"_25947":52048,"_5":30900,"_12136":51998,"_2302":52049},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_5620":2084,"_30634":2059,"_25947":52051,"_5":30900,"_12136":51998,"_2302":52052},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_5620":2085,"_30634":2059,"_25947":52054,"_5":30900,"_12136":51998,"_2302":50039},[],{"_5620":2086,"_30634":2086,"_5":30895,"_2302":52056,"_30908":52057,"_25947":52058,"_12136":2086},"Plataforma Lamassu IoT",[45667,46751],[],{"_5620":2087,"_30634":2086,"_25947":52060,"_5":30900,"_12136":2086,"_2302":52061},[],"Gestiona la PKI y las identidades digitales de tus dispositivos desde una única plataforma.",{"_5620":2088,"_30634":2086,"_5":30905,"_25947":52063,"_12136":52064,"_2302":52065},[],"/docs/pr-preview/pr-24/platform/pki/overview#empieza-aquí","Empieza aquí",{"_5620":2089,"_30634":2086,"_5":30905,"_25947":52067,"_12136":52068,"_2302":52069},[],"/docs/pr-preview/pr-24/platform/pki/overview#capacidades-principales","Capacidades principales",{"_5620":2090,"_30634":2086,"_5":30905,"_25947":52071,"_12136":52072,"_2302":52073},[],"/docs/pr-preview/pr-24/platform/pki/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_5620":2091,"_30634":2086,"_5":30905,"_25947":52075,"_12136":52076,"_2302":52077},[],"/docs/pr-preview/pr-24/platform/pki/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_5620":2092,"_30634":2086,"_5":30905,"_25947":52079,"_12136":52080,"_2302":52081},[],"/docs/pr-preview/pr-24/platform/pki/overview#emite-y-controla-certificados","Emite y controla certificados",{"_5620":2093,"_30634":2086,"_5":30905,"_25947":52083,"_12136":52084,"_2302":52085},[],"/docs/pr-preview/pr-24/platform/pki/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_5620":2094,"_30634":2086,"_5":30905,"_25947":52087,"_12136":52088,"_2302":52089},[],"/docs/pr-preview/pr-24/platform/pki/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_5620":2095,"_30634":2086,"_5":30905,"_25947":52091,"_12136":52092,"_2302":52093},[],"/docs/pr-preview/pr-24/platform/pki/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_5620":2096,"_30634":2086,"_5":30905,"_25947":52095,"_12136":52096,"_2302":52097},[],"/docs/pr-preview/pr-24/platform/pki/overview#elige-tu-recorrido","Elige tu recorrido",{"_5620":2097,"_30634":2086,"_5":30905,"_25947":52099,"_12136":52100,"_2302":52101},[],"/docs/pr-preview/pr-24/platform/pki/overview#referencia-operativa","Referencia operativa",{"_5620":2098,"_30634":2086,"_25947":52103,"_5":30900,"_12136":2086,"_2302":52104},[],"Lamassu IoT centraliza la emisión, distribución, renovación y revocación de identidades X.509 para dispositivos conectados. Puedes construir una PKI privada, proteger sus claves y automatizar el enrolamiento de una flota sin perder visibilidad sobre cada certificado.",{"_5620":2099,"_30634":2086,"_25947":52106,"_5":30900,"_12136":52064,"_2302":52107},[],"<Card title=\"Primeros pasos\" description=\"Crea una CA, emite un certificado y registra tu primer dispositivo.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_5620":2100,"_30634":2086,"_25947":52109,"_5":30900,"_12136":52064,"_2302":52110},[],"<Card title=\"Cómo funciona Lamassu\" description=\"Construye el modelo mental de autoridades, claves, identidades y validación.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_5620":2101,"_30634":2086,"_25947":52112,"_5":30900,"_12136":52072,"_2302":52113},[],"Crea autoridades raíz e intermedias o importa una PKI existente. Define qué autoridad puede emitir cada identidad y conserva la cadena de confianza completa.",{"_5620":2102,"_30634":2086,"_25947":52115,"_5":30900,"_12136":52076,"_2302":52116},[],"Genera y custodia claves mediante motores software, HSMs PKCS#11 o servicios cloud. Lamassu desacopla las operaciones de la ubicación física de la clave.",{"_5620":2103,"_30634":2086,"_25947":52118,"_5":30900,"_12136":52080,"_2302":52119},[],"Emite certificados desde la consola o a partir de un CSR, consulta su estado y revócalos cuando dejan de ser fiables.",{"_5620":2104,"_30634":2086,"_25947":52121,"_5":30900,"_12136":52084,"_2302":52122},[],"Define políticas de enrolamiento mediante un Device Management Service (DMS) y deja que los dispositivos soliciten o renueven su identidad a través de EST o CMP.",{"_5620":2105,"_30634":2086,"_25947":52124,"_5":30900,"_12136":52088,"_2302":52125},[],"Ofrece validación online mediante OCSP y distribuye CRLs para consumidores que necesitan comprobar certificados sin conexión.",{"_5620":2106,"_30634":2086,"_25947":52127,"_5":30900,"_12136":52092,"_2302":52128},[],"Suscríbete a cambios del ciclo de vida y envía notificaciones por correo, Microsoft Teams o webhooks.",{"_5620":2107,"_30634":2086,"_25947":52130,"_5":30900,"_12136":52096,"_2302":52131},[],"<Card title=\"Administro la PKI\" description=\"Configura motores, autoridades, emisión y validación.\" href=\"/docs/platform/pki/key-management\" />",{"_5620":2108,"_30634":2086,"_25947":52133,"_5":30900,"_12136":52096,"_2302":52134},[],"<Card title=\"Integro un dispositivo\" description=\"Configura el DMS y usa EST o CMP para obtener una identidad.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_5620":2109,"_30634":2086,"_25947":52136,"_5":30900,"_12136":52096,"_2302":52137},[],"<Card title=\"Opero la plataforma\" description=\"Despliega Lamassu y prepara sus dependencias.\" href=\"/docs/deployment/overview\" />",{"_5620":2110,"_30634":2086,"_25947":52139,"_5":30900,"_12136":52096,"_2302":52140},[],"<Card title=\"Integro otro sistema\" description=\"Conecta Lamassu con AWS IoT Core y otros destinos.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_5620":2111,"_30634":2086,"_25947":52142,"_5":30900,"_12136":52100,"_2302":52143},[],"<Card title=\"Perfiles de certificado\" description=\"Convierte la política de emisión en restricciones reutilizables.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_5620":2112,"_30634":2086,"_25947":52145,"_5":30900,"_12136":52100,"_2302":52146},[],"<Card title=\"Jerarquía y rotación\" description=\"Sustituye certificados o claves de CA sin romper la confianza.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_5620":2113,"_30634":2086,"_25947":52148,"_5":30900,"_12136":52100,"_2302":52149},[],"<Card title=\"Control de acceso\" description=\"Configura principales, políticas y el primer administrador.\" href=\"/docs/platform/pki/access-control\" />",{"_5620":2114,"_30634":2086,"_25947":52151,"_5":30900,"_12136":52100,"_2302":52152},[],"<Card title=\"Resolución de problemas\" description=\"Diagnostica Gateway, servicios, emisión y enrolamiento.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_5620":2115,"_30634":2115,"_5":30895,"_2302":52154,"_30908":52155,"_25947":52157,"_12136":2115},"Crea tu primera CA",[45667,46751,52156],"Primeros pasos",[],{"_5620":2116,"_30634":2115,"_25947":52159,"_5":30900,"_12136":2115,"_2302":52160},[],"Crea una autoridad raíz y comprueba que está preparada para emitir certificados.",{"_5620":2117,"_30634":2115,"_5":30905,"_25947":52162,"_12136":52163,"_2302":45677},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_5620":2118,"_30634":2115,"_5":30905,"_25947":52165,"_12136":52166,"_2302":52167},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_5620":2119,"_30634":2115,"_5":30905,"_25947":52169,"_12136":52170,"_2302":52171},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_5620":2120,"_30634":2115,"_5":30905,"_25947":52173,"_12136":52174,"_2302":52175},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_5620":2121,"_30634":2115,"_5":30905,"_25947":52177,"_12136":52178,"_2302":52179},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_5620":2122,"_30634":2115,"_5":30905,"_25947":52181,"_12136":52182,"_2302":52183},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_5620":2123,"_30634":2115,"_5":30905,"_25947":52185,"_12136":52186,"_2302":45701},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_5620":2124,"_30634":2115,"_25947":52188,"_5":30900,"_12136":2115,"_2302":52189},[],"En este quickstart crearás una autoridad de certificación raíz con un nuevo par de claves. Al terminar tendrás una CA activa que podrás usar en el siguiente quickstart.",{"_5620":2125,"_30634":2115,"_25947":52191,"_5":30900,"_12136":52163,"_2302":52192},[],"Acceso a la consola con permisos para gestionar autoridades.",{"_5620":2126,"_30634":2115,"_25947":52194,"_5":30900,"_12136":52163,"_2302":52195},[],"Al menos un motor criptográfico disponible.",{"_5620":2127,"_30634":2115,"_25947":52197,"_5":30900,"_12136":52163,"_2302":52198},[],"Un nombre que identifique el propósito de la CA, por ejemplo `Acme Device Root CA`.",{"_5620":2128,"_30634":2115,"_25947":52200,"_5":30900,"_12136":52163,"_2302":52201},[],"Una CA raíz se autofirma y actúa como ancla de confianza. Para producción suele ser preferible mantener la raíz más protegida y emitir desde una CA intermedia.",{"_5620":2129,"_30634":2115,"_25947":52203,"_5":30900,"_12136":52166,"_2302":52204},[],"En el menú lateral, abre **Certification Authorities** y selecciona **Create New CA**.",{"_5620":2130,"_30634":2115,"_25947":52206,"_5":30900,"_12136":52166,"_2302":52207},[],"Elige crear una CA con un par de claves nuevo. Si ya tienes la clave en el KMS, usa &#x2A;*Create New CA (Existing Key)**.",{"_5620":2131,"_30634":2115,"_25947":52209,"_5":30900,"_12136":52170,"_2302":52210},[],"Elige el motor criptográfico que custodiará la clave y configura el algoritmo. Para una primera CA puedes usar **EC P-384**, siempre que sea compatible con tus consumidores.",{"_5620":2132,"_30634":2115,"_25947":52212,"_5":30900,"_12136":52170,"_2302":52213},[],"La clave privada permanecerá bajo el control del motor seleccionado.",{"_5620":2133,"_30634":2115,"_25947":52215,"_5":30900,"_12136":52174,"_2302":52216},[],"Selecciona **Root CA** y completa:",{"_5620":2134,"_30634":2115,"_25947":52218,"_5":30900,"_12136":52174,"_2302":52219},[],"**CA Name**: un nombre único y reconocible.",{"_5620":2135,"_30634":2115,"_25947":52221,"_5":30900,"_12136":52174,"_2302":52222},[],"**Subject**: al menos la organización y el país que identificarán a la autoridad.",{"_5620":2136,"_30634":2115,"_25947":52224,"_5":30900,"_12136":52174,"_2302":52225},[],"**CA Certificate Expiration**: una validez mayor que la de los certificados que emitirá.",{"_5620":2137,"_30634":2115,"_25947":52227,"_5":30900,"_12136":52174,"_2302":52228},[],"**Default End-Entity Certificate Issuance Expiration**: la validez predeterminada de los certificados finales.",{"_5620":2138,"_30634":2115,"_25947":52230,"_5":30900,"_12136":52174,"_2302":52231},[],"El nombre de la CA se utilizará como `Common Name` del certificado.",{"_5620":2139,"_30634":2115,"_25947":52233,"_5":30900,"_12136":52178,"_2302":52234},[],"Comprueba el algoritmo, el sujeto y las fechas antes de confirmar. Estos valores definen el ancla de confianza y no deberían elegirse como simples datos de prueba en un entorno productivo.",{"_5620":2140,"_30634":2115,"_25947":52236,"_5":30900,"_12136":52182,"_2302":52237},[],"Abre la nueva CA desde el listado. Debe aparecer activa y mostrar su certificado PEM, la fecha de expiración y la pestaña **Issued Certificates**.",{"_5620":2141,"_30634":2115,"_25947":52239,"_5":30900,"_12136":52186,"_2302":52240},[],"Usa la autoridad para emitir tu primer certificado, o consulta la guía completa de autoridades para crear una CA intermedia, importar una CA o definir perfiles avanzados.",{"_5620":2142,"_30634":2142,"_5":30895,"_2302":52242,"_30908":52243,"_25947":52244,"_12136":2142},"Emite tu primer certificado",[45667,46751,52156],[],{"_5620":2143,"_30634":2142,"_25947":52246,"_5":30900,"_12136":2142,"_2302":52247},[],"Emite una identidad X.509 desde la consola y verifica el resultado.",{"_5620":2144,"_30634":2142,"_5":30905,"_25947":52249,"_12136":52250,"_2302":45677},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_5620":2145,"_30634":2142,"_5":30905,"_25947":52252,"_12136":52253,"_2302":52254},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_5620":2146,"_30634":2142,"_5":30905,"_25947":52256,"_12136":52257,"_2302":52258},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_5620":2147,"_30634":2142,"_5":30905,"_25947":52260,"_12136":52261,"_2302":52262},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_5620":2148,"_30634":2142,"_5":30905,"_25947":52264,"_12136":52265,"_2302":52266},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_5620":2149,"_30634":2142,"_5":30905,"_25947":52268,"_12136":52269,"_2302":52270},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_5620":2150,"_30634":2142,"_5":30905,"_25947":52272,"_12136":52273,"_2302":52183},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_5620":2151,"_30634":2142,"_5":30905,"_25947":52275,"_12136":52276,"_2302":45701},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_5620":2152,"_30634":2142,"_25947":52278,"_5":30900,"_12136":2142,"_2302":52279},[],"En este quickstart Lamassu generará la clave y el CSR en el navegador, y la CA emitirá el certificado. Al terminar descargarás el certificado y su clave privada.",{"_5620":2153,"_30634":2142,"_25947":52281,"_5":30900,"_12136":52250,"_2302":52282},[],"Una CA activa con permiso para emitir certificados.",{"_5620":2154,"_30634":2142,"_25947":52284,"_5":30900,"_12136":52250,"_2302":52285},[],"Un nombre para la identidad, por ejemplo `device-001.example.internal`.",{"_5620":2155,"_30634":2142,"_25947":52287,"_5":30900,"_12136":52250,"_2302":52288},[],"Un lugar seguro en el que custodiar la clave privada descargada.",{"_5620":2156,"_30634":2142,"_25947":52290,"_5":30900,"_12136":52250,"_2302":52291},[],"En este flujo la clave se genera en el navegador y Lamassu no la almacena. Descárgala y protégela antes de cerrar el resultado de la operación.",{"_5620":2157,"_30634":2142,"_25947":52293,"_5":30900,"_12136":52253,"_2302":52294},[],"Abre la CA creada en el quickstart anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_5620":2158,"_30634":2142,"_25947":52296,"_5":30900,"_12136":52257,"_2302":52297},[],"Selecciona **Generate Key & CSR in Browser**. Usa **Upload Existing CSR** cuando la clave privada deba generarse y permanecer en el sistema de destino.",{"_5620":2159,"_30634":2142,"_25947":52299,"_5":30900,"_12136":52261,"_2302":52300},[],"Introduce el `Common Name` y, si corresponde, la organización, unidad organizativa y ubicación. Añade SANs para cada nombre DNS, dirección IP, correo o URI con el que se vaya a validar la identidad.",{"_5620":2160,"_30634":2142,"_25947":52302,"_5":30900,"_12136":52265,"_2302":52303},[],"Elige RSA o ECDSA, define la validez y selecciona los usos de clave. Para una identidad de dispositivo que usa mTLS, habilita **Digital Signature** y **Client Authentication**.",{"_5620":2161,"_30634":2142,"_25947":52305,"_5":30900,"_12136":52265,"_2302":52306},[],"La validez no puede superar la fecha de expiración de la CA emisora.",{"_5620":2162,"_30634":2142,"_25947":52308,"_5":30900,"_12136":52269,"_2302":52309},[],"Confirma la emisión y descarga inmediatamente el certificado y la clave privada en formato PEM.",{"_5620":2163,"_30634":2142,"_25947":52311,"_5":30900,"_12136":52273,"_2302":52312},[],"El certificado debe aparecer en **Issued Certificates** con estado activo. Comprueba su sujeto, SANs, emisor, usos y periodo de validez.",{"_5620":2164,"_30634":2142,"_25947":52314,"_5":30900,"_12136":52276,"_2302":52315},[],"Registra tu primer dispositivo para asociar la identidad a una entidad gestionada, o consulta la gestión de certificados.",{"_5620":2165,"_30634":2165,"_5":30895,"_2302":52156,"_30908":52317,"_25947":52318,"_12136":2165},[45667,46751,52156],[],{"_5620":2166,"_30634":2165,"_25947":52320,"_5":30900,"_12136":2165,"_2302":52321},[],"Obtén un primer resultado con Lamassu y continúa desde una base funcional.",{"_5620":2167,"_30634":2165,"_5":30905,"_25947":52323,"_12136":52324,"_2302":52325},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_5620":2168,"_30634":2165,"_5":30905,"_25947":52327,"_12136":52328,"_2302":45677},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/overview#antes-de-empezar",{"_5620":2169,"_30634":2165,"_25947":52330,"_5":30900,"_12136":2165,"_2302":52331},[],"Los quickstarts te llevan desde una instancia preparada hasta una identidad de dispositivo activa. Cada guía produce un resultado verificable y enlaza la explicación detallada cuando necesitas ir más allá.",{"_5620":2170,"_30634":2165,"_25947":52333,"_5":30900,"_12136":52324,"_2302":52334},[],"<Card title=\"1. Crea tu primera CA\" description=\"Establece una raíz de confianza capaz de emitir certificados.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_5620":2171,"_30634":2165,"_25947":52336,"_5":30900,"_12136":52324,"_2302":52337},[],"<Card title=\"2. Emite un certificado\" description=\"Crea una identidad X.509 y verifica su contenido.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_5620":2172,"_30634":2165,"_25947":52339,"_5":30900,"_12136":52324,"_2302":52340},[],"<Card title=\"3. Registra un dispositivo\" description=\"Añade un dispositivo y asígnale su primera identidad.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_5620":2173,"_30634":2165,"_25947":52342,"_5":30900,"_12136":52328,"_2302":52343},[],"Necesitas acceso a la consola de Lamassu IoT y permisos para administrar claves, autoridades y dispositivos. La instancia debe tener al menos un motor criptográfico configurado.",{"_5620":2174,"_30634":2165,"_25947":52345,"_5":30900,"_12136":52328,"_2302":52346},[],"Si todavía no tienes una instancia, elige primero un modelo de despliegue.",{"_5620":2175,"_30634":2175,"_5":30895,"_2302":52348,"_30908":52349,"_25947":52350,"_12136":2175},"Registra tu primer dispositivo",[45667,46751,52156],[],{"_5620":2176,"_30634":2175,"_25947":52352,"_5":30900,"_12136":2175,"_2302":52353},[],"Añade un dispositivo a Lamassu y asígnale una identidad activa.",{"_5620":2177,"_30634":2175,"_5":30905,"_25947":52355,"_12136":52356,"_2302":45677},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#antes-de-empezar",{"_5620":2178,"_30634":2175,"_5":30905,"_25947":52358,"_12136":52359,"_2302":52360},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_5620":2179,"_30634":2175,"_5":30905,"_25947":52362,"_12136":52363,"_2302":52364},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_5620":2180,"_30634":2175,"_5":30905,"_25947":52366,"_12136":52367,"_2302":52368},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_5620":2181,"_30634":2175,"_5":30905,"_25947":52370,"_12136":52371,"_2302":52372},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_5620":2182,"_30634":2175,"_5":30905,"_25947":52374,"_12136":52375,"_2302":52376},[],"/docs/pr-preview/pr-24/platform/pki/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_5620":2183,"_30634":2175,"_25947":52378,"_5":30900,"_12136":2175,"_2302":52379},[],"En este quickstart registrarás manualmente un dispositivo y le asignarás su primer certificado. Es el recorrido más corto para entender cómo Lamassu relaciona una entidad física con su historial de identidades.",{"_5620":2184,"_30634":2175,"_25947":52381,"_5":30900,"_12136":52356,"_2302":52382},[],"Un DMS configurado.",{"_5620":2185,"_30634":2175,"_25947":52384,"_5":30900,"_12136":52356,"_2302":52385},[],"Una CA asociada al DMS.",{"_5620":2186,"_30634":2175,"_25947":52387,"_5":30900,"_12136":52356,"_2302":52388},[],"Un identificador único para el dispositivo.",{"_5620":2187,"_30634":2175,"_25947":52390,"_5":30900,"_12136":52359,"_2302":52391},[],"Abre **Managed Devices**, selecciona la acción para registrar un dispositivo y completa:",{"_5620":2188,"_30634":2175,"_25947":52393,"_5":30900,"_12136":52359,"_2302":52394},[],"**Device ID**: identificador único del dispositivo.",{"_5620":2189,"_30634":2175,"_25947":52396,"_5":30900,"_12136":52359,"_2302":52397},[],"**Registration Authority**: DMS que aplicará las políticas de enrolamiento.",{"_5620":2190,"_30634":2175,"_25947":52399,"_5":30900,"_12136":52359,"_2302":52400},[],"**Icon** y **Tags**: clasificación opcional para localizarlo después.",{"_5620":2191,"_30634":2175,"_25947":52402,"_5":30900,"_12136":52363,"_2302":52403},[],"Abre el dispositivo recién creado. Debe aparecer con estado **No Identity**: existe en el inventario, pero todavía no tiene un certificado asociado.",{"_5620":2192,"_30634":2175,"_25947":52405,"_5":30900,"_12136":52367,"_2302":52406},[],"Selecciona **Assign Identity**. Lamassu buscará certificados activos cuyo `Common Name` coincida con el `Device ID`.",{"_5620":2193,"_30634":2175,"_25947":52408,"_5":30900,"_12136":52367,"_2302":52409},[],"Selecciona un certificado existente o usa **Issue New Instead** para emitir uno desde una CA vinculada al DMS.",{"_5620":2194,"_30634":2175,"_25947":52411,"_5":30900,"_12136":52371,"_2302":52412},[],"Tras confirmar, el estado debe cambiar a **Active**. Revisa **Certificate History** para comprobar la identidad asociada y **Device Event Timeline** para ver el evento de asignación.",{"_5620":2195,"_30634":2175,"_25947":52414,"_5":30900,"_12136":52375,"_2302":52415},[],"El registro manual ayuda a entender el modelo, pero una flota debe usar enrolamiento automatizado. Continúa con Device Management Service y la integración EST o CMP.",{"_5620":2196,"_30634":2196,"_5":30895,"_2302":52417,"_30908":52418,"_25947":52419,"_12136":2196},"Resolución de problemas",[45667,46751,46752],[],{"_5620":2197,"_30634":2196,"_25947":52421,"_5":30900,"_12136":2196,"_2302":52422},[],"Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.",{"_5620":2198,"_30634":2196,"_5":30905,"_25947":52424,"_12136":52425,"_2302":52426},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_5620":2199,"_30634":2196,"_5":30905,"_25947":52428,"_12136":52429,"_2302":52430},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_5620":2200,"_30634":2196,"_5":30905,"_25947":52432,"_12136":52433,"_2302":52434},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_5620":2201,"_30634":2196,"_5":30905,"_25947":52436,"_12136":52437,"_2302":52438},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_5620":2202,"_30634":2196,"_5":30905,"_25947":52440,"_12136":52441,"_2302":52442},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_5620":2203,"_30634":2196,"_5":30905,"_25947":52444,"_12136":52445,"_2302":52446},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_5620":2204,"_30634":2196,"_5":30905,"_25947":52448,"_12136":52449,"_2302":52450},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_5620":2205,"_30634":2196,"_5":30905,"_25947":52452,"_12136":52453,"_2302":52454},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_5620":2206,"_30634":2196,"_5":30905,"_25947":52456,"_12136":52457,"_2302":52458},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_5620":2207,"_30634":2196,"_5":30905,"_25947":52460,"_12136":52461,"_2302":52462},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_5620":2208,"_30634":2196,"_5":30905,"_25947":52464,"_12136":52465,"_2302":52466},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_5620":2209,"_30634":2196,"_5":30905,"_25947":52468,"_12136":52469,"_2302":52470},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_5620":2210,"_30634":2196,"_5":30905,"_25947":52472,"_12136":52473,"_2302":52474},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_5620":2211,"_30634":2196,"_5":30905,"_25947":52476,"_12136":52477,"_2302":52478},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_5620":2212,"_30634":2196,"_5":30905,"_25947":52480,"_12136":52481,"_2302":52482},[],"/docs/pr-preview/pr-24/platform/pki/troubleshooting#observabilidad","Observabilidad",{"_5620":2213,"_30634":2196,"_25947":52484,"_5":30900,"_12136":2196,"_2302":52485},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway, un pod no preparado y una emisión rechazada pueden parecer el mismo problema desde la consola, pero requieren evidencias distintas.",{"_5620":2214,"_30634":2196,"_25947":52487,"_5":30900,"_12136":52429,"_2302":52488},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_5620":2215,"_30634":2196,"_25947":52490,"_5":30900,"_12136":52433,"_2302":52491},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_5620":2216,"_30634":2196,"_25947":52493,"_5":30900,"_12136":52437,"_2302":52494},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_5620":2217,"_30634":2196,"_25947":52496,"_5":30900,"_12136":52441,"_2302":52497},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_5620":2218,"_30634":2196,"_25947":52499,"_5":30900,"_12136":52445,"_2302":52500},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_5620":2219,"_30634":2196,"_25947":52502,"_5":30900,"_12136":52449,"_2302":52503},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_5620":2220,"_30634":2196,"_25947":52505,"_5":30900,"_12136":52449,"_2302":52506},[],"Ejecuta también la prueba de conectividad del chart:",{"_5620":2221,"_30634":2196,"_25947":52508,"_5":30900,"_12136":52449,"_2302":52509},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_5620":2222,"_30634":2196,"_25947":52511,"_5":30900,"_12136":52449,"_2302":52512},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_5620":2223,"_30634":2196,"_25947":52514,"_5":30900,"_12136":52453,"_2302":52515},[],"Si recibes un 401:",{"_5620":2224,"_30634":2196,"_25947":52517,"_5":30900,"_12136":52453,"_2302":52518},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_5620":2225,"_30634":2196,"_25947":52520,"_5":30900,"_12136":52453,"_2302":52521},[],"verifica emisor, audiencia y expiración del token;",{"_5620":2226,"_30634":2196,"_25947":52523,"_5":30900,"_12136":52453,"_2302":52524},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_5620":2227,"_30634":2196,"_25947":52526,"_5":30900,"_12136":52453,"_2302":52527},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_5620":2228,"_30634":2196,"_25947":52529,"_5":30900,"_12136":52453,"_2302":52530},[],"Si el login termina pero las APIs devuelven 403:",{"_5620":2229,"_30634":2196,"_25947":52532,"_5":30900,"_12136":52453,"_2302":52533},[],"inspecciona los claims reales del token;",{"_5620":2230,"_30634":2196,"_25947":52535,"_5":30900,"_12136":52453,"_2302":52536},[],"confirma que coinciden con un principal activo;",{"_5620":2231,"_30634":2196,"_25947":52538,"_5":30900,"_12136":52453,"_2302":52539},[],"revisa las políticas concedidas al principal;",{"_5620":2232,"_30634":2196,"_25947":52541,"_5":30900,"_12136":52453,"_2302":52542},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_5620":2233,"_30634":2196,"_25947":52544,"_5":30900,"_12136":52453,"_2302":52545},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_5620":2234,"_30634":2196,"_25947":52547,"_5":30900,"_12136":52457,"_2302":52548},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_5620":2235,"_30634":2196,"_25947":52550,"_5":30900,"_12136":52457,"_2302":52551},[],"Localiza el pod y Service de authz.",{"_5620":2236,"_30634":2196,"_25947":52553,"_5":30900,"_12136":52457,"_2302":52554},[],"Comprueba /health, logs y conexión a su base de datos.",{"_5620":2237,"_30634":2196,"_25947":52556,"_5":30900,"_12136":52457,"_2302":52557},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_5620":2238,"_30634":2196,"_25947":52559,"_5":30900,"_12136":52457,"_2302":52560},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_5620":2239,"_30634":2196,"_25947":52562,"_5":30900,"_12136":52457,"_2302":52563},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_5620":2240,"_30634":2196,"_25947":52565,"_5":30900,"_12136":52461,"_2302":52566},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_5620":2241,"_30634":2196,"_25947":52568,"_5":30900,"_12136":52461,"_2302":52569},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_5620":2242,"_30634":2196,"_25947":52571,"_5":30900,"_12136":52461,"_2302":52572},[],"volumen persistente sin enlazar;",{"_5620":2243,"_30634":2196,"_25947":52574,"_5":30900,"_12136":52461,"_2302":52575},[],"imagen inaccesible o política de pull incorrecta;",{"_5620":2244,"_30634":2196,"_25947":52577,"_5":30900,"_12136":52461,"_2302":52578},[],"configuración inválida del motor criptográfico;",{"_5620":2245,"_30634":2196,"_25947":52580,"_5":30900,"_12136":52461,"_2302":52581},[],"límites de CPU o memoria demasiado bajos;",{"_5620":2246,"_30634":2196,"_25947":52583,"_5":30900,"_12136":52461,"_2302":52584},[],"migración previa incompleta.",{"_5620":2247,"_30634":2196,"_25947":52586,"_5":30900,"_12136":52461,"_2302":52587},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_5620":2248,"_30634":2196,"_25947":52589,"_5":30900,"_12136":52461,"_2302":52590},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_5620":2249,"_30634":2196,"_25947":52592,"_5":30900,"_12136":52465,"_2302":52593},[],"Acota el error siguiendo este orden:",{"_5620":2250,"_30634":2196,"_25947":52595,"_5":30900,"_12136":52465,"_2302":52596},[],"La CA existe, está activa y no ha expirado.",{"_5620":2251,"_30634":2196,"_25947":52598,"_5":30900,"_12136":52465,"_2302":52599},[],"La CA tiene una clave privada utilizable y el motor está disponible.",{"_5620":2252,"_30634":2196,"_25947":52601,"_5":30900,"_12136":52465,"_2302":52602},[],"La CSR tiene una firma válida.",{"_5620":2253,"_30634":2196,"_25947":52604,"_5":30900,"_12136":52465,"_2302":52605},[],"El perfil permite el tipo y tamaño de clave.",{"_5620":2254,"_30634":2196,"_25947":52607,"_5":30900,"_12136":52465,"_2302":52608},[],"La validez solicitada cabe dentro de la vigencia de la CA.",{"_5620":2255,"_30634":2196,"_25947":52610,"_5":30900,"_12136":52465,"_2302":52611},[],"KU, EKU, sujeto y extensiones cumplen el perfil.",{"_5620":2256,"_30634":2196,"_25947":52613,"_5":30900,"_12136":52465,"_2302":52614},[],"Si la reemisión de una CA falla, recuerda que no se admite para una CA revocada o ya expirada. Para cambiar su clave, sigue Jerarquía y rotación de CAs.",{"_5620":2257,"_30634":2196,"_25947":52616,"_5":30900,"_12136":52469,"_2302":52617},[],"Comprueba:",{"_5620":2258,"_30634":2196,"_25947":52619,"_5":30900,"_12136":52469,"_2302":52620},[],"el identificador del DMS en el path EST;",{"_5620":2259,"_30634":2196,"_25947":52622,"_5":30900,"_12136":52469,"_2302":52623},[],"el método de autenticación configurado;",{"_5620":2260,"_30634":2196,"_25947":52625,"_5":30900,"_12136":52469,"_2302":52626},[],"la cadena presentada por el cliente;",{"_5620":2261,"_30634":2196,"_25947":52628,"_5":30900,"_12136":52469,"_2302":52629},[],"las CAs de validación y el límite de niveles;",{"_5620":2262,"_30634":2196,"_25947":52631,"_5":30900,"_12136":52469,"_2302":52632},[],"el estado de revocación del certificado cliente;",{"_5620":2263,"_30634":2196,"_25947":52634,"_5":30900,"_12136":52469,"_2302":52635},[],"la firma de la CSR;",{"_5620":2264,"_30634":2196,"_25947":52637,"_5":30900,"_12136":52469,"_2302":52638},[],"la CA y el perfil usados para emitir;",{"_5620":2265,"_30634":2196,"_25947":52640,"_5":30900,"_12136":52469,"_2302":52641},[],"la ventana de re-enrolamiento.",{"_5620":2266,"_30634":2196,"_25947":52643,"_5":30900,"_12136":52469,"_2302":52644},[],"En re-enrolamiento, Lamassu intenta validar primero con la CA de enrolamiento y después con las CAs adicionales. Durante una migración, conserva la CA anterior en ese segundo conjunto hasta terminar el solapamiento.",{"_5620":2267,"_30634":2196,"_25947":52646,"_5":30900,"_12136":52473,"_2302":52647},[],"Confirma que la revocación quedó persistida y tiene razón y timestamp.",{"_5620":2268,"_30634":2196,"_25947":52649,"_5":30900,"_12136":52473,"_2302":52650},[],"Revisa la configuración y logs de VA.",{"_5620":2269,"_30634":2196,"_25947":52652,"_5":30900,"_12136":52473,"_2302":52653},[],"Comprueba la periodicidad y próxima actualización de la CRL.",{"_5620":2270,"_30634":2196,"_25947":52655,"_5":30900,"_12136":52473,"_2302":52656},[],"Descarta cachés intermedias en proxy y cliente.",{"_5620":2271,"_30634":2196,"_25947":52658,"_5":30900,"_12136":52473,"_2302":52659},[],"Verifica que el certificado apunta al endpoint que estás consultando.",{"_5620":2272,"_30634":2196,"_25947":52661,"_5":30900,"_12136":52473,"_2302":52662},[],"Consulta por número de serie y emisor correctos.",{"_5620":2273,"_30634":2196,"_25947":52664,"_5":30900,"_12136":52477,"_2302":52665},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_5620":2274,"_30634":2196,"_25947":52667,"_5":30900,"_12136":52477,"_2302":52668},[],"verifica que esté habilitado en el servicio emisor;",{"_5620":2275,"_30634":2196,"_25947":52670,"_5":30900,"_12136":52477,"_2302":52671},[],"comprueba conectividad y credenciales AMQP;",{"_5620":2276,"_30634":2196,"_25947":52673,"_5":30900,"_12136":52477,"_2302":52674},[],"revisa exchange, routing key, colas y consumidores;",{"_5620":2277,"_30634":2196,"_25947":52676,"_5":30900,"_12136":52477,"_2302":52677},[],"inspecciona dead-letter queues;",{"_5620":2278,"_30634":2196,"_25947":52679,"_5":30900,"_12136":52477,"_2302":52680},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_5620":2279,"_30634":2196,"_25947":52682,"_5":30900,"_12136":52477,"_2302":52683},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_5620":2280,"_30634":2196,"_25947":52685,"_5":30900,"_12136":52481,"_2302":52686},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_5620":2281,"_30634":2196,"_25947":52688,"_5":30900,"_12136":52481,"_2302":52689},[],"Antes de cerrar una incidencia, guarda:",{"_5620":2282,"_30634":2196,"_25947":52691,"_5":30900,"_12136":52481,"_2302":52692},[],"causa confirmada;",{"_5620":2283,"_30634":2196,"_25947":52694,"_5":30900,"_12136":52481,"_2302":52695},[],"alcance temporal y recursos afectados;",{"_5620":2284,"_30634":2196,"_25947":52697,"_5":30900,"_12136":52481,"_2302":52698},[],"comandos o consultas utilizados;",{"_5620":2285,"_30634":2196,"_25947":52700,"_5":30900,"_12136":52481,"_2302":52701},[],"cambio aplicado y forma de revertirlo;",{"_5620":2286,"_30634":2196,"_25947":52703,"_5":30900,"_12136":52481,"_2302":52704},[],"validación desde un consumidor;",{"_5620":2287,"_30634":2196,"_25947":52706,"_5":30900,"_12136":52481,"_2302":52707},[],"acción preventiva y propietario.",{"_5620":2288,"_30634":2288,"_5":30895,"_2302":52709,"_25947":52710,"_12136":2288},"Test",[],{"_5620":2289,"_30634":2288,"_25947":52712,"_5":30900,"_12136":2288,"_2302":52713},[],"A document to test Fumadocs",{"_5620":2290,"_30634":2288,"_5":30905,"_25947":52715,"_12136":52716,"_2302":52717},[],"/docs/pr-preview/pr-24/test#cards","Cards",{"_5620":2291,"_30634":2288,"_5":30905,"_25947":52719,"_12136":52720,"_2302":52721},[],"/docs/pr-preview/pr-24/test#codeblock","CodeBlock",{"_5620":2292,"_30634":2288,"_5":30905,"_25947":52723,"_12136":52724,"_2302":52725},[],"/docs/pr-preview/pr-24/test#list","List",{"_5620":2293,"_30634":2288,"_25947":52727,"_5":30900,"_12136":2288,"_2302":52728},[],"Hey there!",{"_5620":2294,"_30634":2288,"_25947":52730,"_5":30900,"_12136":52716,"_2302":52731},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_5620":2295,"_30634":2288,"_25947":52733,"_5":30900,"_12136":52716,"_2302":52734},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_5620":2296,"_30634":2288,"_25947":52736,"_5":30900,"_12136":52724,"_2302":52737},[],"Hello",{"_5620":2297,"_30634":2288,"_25947":52739,"_5":30900,"_12136":52724,"_2302":52740},[],"World","count","sorting",{"_52744":52745,"_52746":52747,"_52748":52749,"_52750":52751,"_10108":2319,"_61913":2319},"language","english","sortableProperties",[2302,30634,5,12136],"sortablePropertiesWithTypes",{"_2302":25559,"_30634":25559,"_5":25559,"_12136":25559},"sorts",{"_2302":52752,"_30634":55043,"_5":57333,"_12136":59623},{"_5406":52753,"_52754":52755,"_5":25559},{"_7428":16438,"_8508":2741,"_16420":11832,"_27891":16280,"_16407":10418,"_27940":6368,"_16284":2997,"_12006":2991,"_8527":3171,"_29935":2967,"_29960":5806,"_27959":3211,"_34187":3343,"_29955":9036,"_28527":2353,"_29975":12090,"_29970":2559,"_34197":8830,"_29950":2651,"_23406":2915,"_23412":7591,"_30311":27488,"_30327":2804,"_16416":2814,"_34210