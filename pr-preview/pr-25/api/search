eview/pr-25/manual/servicios-core/kms#ver-detalles","content":"Ver detalles"},"1279":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-11","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#firmar-y-verificar","content":"Firmar y verificar"},"1280":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-12","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#sign","content":"Sign"},"1281":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-13","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#verify","content":"Verify"},"1282":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-14","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-csr","content":"Generar un CSR"},"1283":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-15","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#firma-local-con-pkcs11","content":"Firma local con PKCS#11"},"1284":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-16","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#gestión-de-claves-criptográficas","content":"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI."},"1285":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-17","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#gestión-de-claves-criptográficas","content":"En la configuración actual, Lamassu IoT trabaja con claves asimétricas. Además de los algoritmos clásicos, RSA y curvas elípticas, el KMS soporta claves Ed25519 y claves de firma post-cuántica (ML-DSA, SLH-DSA y Composite ML-DSA). Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema."},"1286":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-18","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#algoritmos-y-tamaños-de-clave-soportados","content":"El catálogo de claves que puede gestionar el KMS combina algoritmos clásicos y de firma post-cuántica:"},"1287":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-19","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#algoritmos-y-tamaños-de-clave-soportados","content":"Familia"},"1288":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-20","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#algoritmos-y-tamaños-de-clave-soportados","content":"Algoritmo (`Algorithm`)"},"1289":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-21","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#algoritmos-y-tamaños-de-clave-soportados","content":"Tamaños y parámetros (`Size`)"},"1290":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/kms-22","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/kms","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/kms#algoritmos-y-tamaños-de-clave-soportados","content":"RSA"},"1291":{"id":"/d