e_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Consideración:** No puede exceder la validez de la CA emisora"},"809":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-148","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado."},"810":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-149","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Usos Básicos**"},"811":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-150","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales"},"812":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-151","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Content Commitment (Non-Repudiation):** No repudio"},"813":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-152","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Key Encipherment:** Cifrado de claves"},"814":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-153","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Data Encipherment:** Cifrado de datos"},"815":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-154","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Key Agreement:** Acuerdo de claves"},"816":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-155","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Certificate Signing:** Firma de certificados"},"817":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-156","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**CRL Signing:** Firma de listas de revocación"},"818":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-157","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Encipher Only:** Solo cifrado"},"819":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-158","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Decipher Only:** Solo descifrado"},"820":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-159","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Uso Extendido de Claves**"},"821":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-160","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"Especifica aplicaciones específicas para las que está autorizado el certificado."},"822":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-161","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor"},"823":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-162","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente"},"824":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-163","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Code Signing:** Firma de código"},"825":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-164","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Email Protection:** Protección de correo electrónico"},"826":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-165","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Time Stamping:** Sellado de tiempo"},"827":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-166","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**OCSP Signing:** Firma de respuestas OCSP"},"828":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-167","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener."},"829":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-168","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"**Emisión a partir de un CSR generado de manera externa**"},"830":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-169","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”."},"831":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-170","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,.."},"832":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-171","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","content":"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior."},"833":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-172","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución."},"834":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-173","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**."},"835":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-174","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**."},"836":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-175","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:"},"837":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-176","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"Unspecified (No especificado)"},"838":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-177","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"KeyCompromise (Compromiso de clave)"},"839":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-178","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"CACompromise (Compromiso de CA)"},"840":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-179","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"AffiliationChanged (Afiliación cambiada)"},"841":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-180","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"Superseded (Sustituida)"},"842":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-181","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"CessationOfOperation (Cese de operación)"},"843":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-182","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"CertificateHold (Retención de certificado)"},"844":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-183","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"RemoveFromCRL (Eliminar de la CRL)"},"845":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-184","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**."},"846":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-185","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente)."},"847":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-186","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"Consideraciones importantes:"},"848":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-187","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder."},"849":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-188","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","content":"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT."},"850":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","type":"page","content":"[Certs] Gestión de Certificados","breadcrumbs":["Docs","Manual de Usuario","Servicios Core"],"tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/certificates"},"851":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates-0","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","content":"Visualización y gestión de certificados emitidos"},"852":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates-1","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/certificates#gestión-de-certificados","content":"Gestión de certificados"},"853":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates-2","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/certificates#revocación-de-certificados","content":"Revocación de certificados"},"854":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates-3","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/certificates#gestión-de-certificados","content":"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada."},"855":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates-4","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/certificates#gestión-de-certificados","content":"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió."},"856":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates-5","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/certificates#gestión-de-certificados","content":"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación."},"857":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates-6","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/certificates#revocación-de-certificados","content":"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación."},"858":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates-7","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/certificates#revocación-de-certificados","content":"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación."},"859":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","type":"page","content":"[Devices] Dispositivos e Identidades","breadcrumbs":["Docs","Manual de Usuario","Servicios Core"],"tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/devices"},"860":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-0","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices","content":"Gestión de dispositivos IoT y sus identidades digitales"},"861":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-1","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","content":"Dispositivos y gestión de las identidades – End entities"},"862":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-2","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","content":"Visualización de Dispositivos Gestionados"},"863":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-3","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","content":"Detalle del Dispositivo: Historial de Certificados"},"864":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-4","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","content":"Detalle del Dispositivo: Línea de tiempo de eventos"},"865":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-5","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","content":"Registro de Nuevos Dispositivos"},"866":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-6","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","content":"Asignación Manual de Identidad"},"867":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-7","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"Revocación de Identidad"},"868":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-8","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","content":"Desactivación de Dispositivos (Decommissioning)"},"869":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-9","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","content":"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida."},"870":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-10","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","content":"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad."},"871":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-11","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","content":"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:"},"872":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-12","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","content":"**Active**: El dispositivo y su certificado están en uso y son válidos."},"873":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-13","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","content":"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada."},"874":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-14","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","content":"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto."},"875":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-15","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","content":"**Expiring Soon**: El certificado del dispositivo está a punto de caducar."},"876":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-16","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","content":"**Expired**: El certificado del dispositivo ha caducado."},"877":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-17","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","content":"**Revoked**: El certificado del dispositivo ha sido revocado."},"878":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-18","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","content":"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso."},"879":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-19","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","content":"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez."},"880":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-20","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","content":"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento."},"881":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-21","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","content":"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado."},"882":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-22","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","content":"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo."},"883":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-23","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","content":"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado."},"884":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-24","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","content":"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:"},"885":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-25","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","content":"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier)."},"886":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-26","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","content":"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán."},"887":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-27","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","content":"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo."},"888":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-28","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","content":"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo."},"889":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-29","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","content":"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares."},"890":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-30","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","content":"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado."},"891":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-31","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","content":"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual."},"892":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-32","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","content":"El proceso se lleva a cabo desde la vista de detalles del dispositivo:"},"893":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-33","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","content":"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente."},"894":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-34","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","content":"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo."},"895":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-35","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","content":"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo."},"896":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-36","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","content":"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial."},"897":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-37","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos."},"898":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-38","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"El proceso de revocación se lleva a cabo de la siguiente manera:"},"899":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-39","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación."},"900":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-40","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:"},"901":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-41","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**Unspecified**: Motivo de revocación no especificado."},"902":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-42","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**KeyCompromise**: La clave privada del certificado ha sido comprometida."},"903":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-43","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**CACompromise**: La clave privada de la CA ha sido comprometida."},"904":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-44","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado."},"905":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-45","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**Superseded**: El certificado ha sido reemplazado por uno nuevo."},"906":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-46","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado."},"907":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-47","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**CertificateHold**: El certificado está temporalmente en espera de revocación."},"908":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-48","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente."},"909":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-49","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado."},"910":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-50","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida."},"911":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-51","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos."},"912":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-52","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","content":"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación."},"913":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-53","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","content":"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza."},"914":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-54","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","content":"El proceso se realiza de la siguiente manera:"},"915":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-55","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","content":"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**."},"916":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-56","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","content":"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad."},"917":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/devices-57","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/devices","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","content":"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI."},"918":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"page","content":"EST: Enrollment over Secure Transport","breadcrumbs":["Docs","Manual de Usuario","Servicios Core"],"tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est"},"919":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-0","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est","content":"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos."},"920":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-1","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"EST: Enrollment over Secure Transport"},"921":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-2","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-del-dms","content":"Configuración del DMS"},"922":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-3","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos","content":"Requisitos previos"},"923":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-4","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-enrollment","content":"Configuración de enrollment"},"924":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-5","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-device-registration","content":"Enrollment Device Registration"},"925":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-6","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"Enrollment Settings"},"926":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-7","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"Perfil de emisión"},"927":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-8","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","content":"Configuración de re-enrollment"},"928":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-9","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-serverkeygen","content":"Configuración de ServerKeyGen"},"929":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-10","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#verificar-la-configuración","content":"Verificar la configuración"},"930":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-11","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#integración-de-dispositivos","content":"Integración de dispositivos"},"931":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-12","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"Antes de empezar"},"932":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-13","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","content":"Resumen del flujo"},"933":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-14","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#modelo-de-autenticación-del-cliente","content":"Modelo de autenticación del cliente"},"934":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-15","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#referencia-de-endpoints","content":"Referencia de endpoints"},"935":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-16","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#cacerts","content":"`/cacerts`"},"936":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-17","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#simpleenroll","content":"`/simpleenroll`"},"937":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-18","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#simplereenroll","content":"`/simplereenroll`"},"938":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-19","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#serverkeygen","content":"`/serverkeygen`"},"939":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-20","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#flujos-completos","content":"Flujos completos"},"940":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-21","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-enroll","content":"Ejemplo end-to-end: enroll"},"941":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-22","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-reenroll","content":"Ejemplo end-to-end: reenroll"},"942":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-23","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","content":"Próximos pasos tras el enrolamiento"},"943":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-24","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#diagnóstico-y-compatibilidad","content":"Diagnóstico y compatibilidad"},"944":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-25","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#códigos-de-error-y-diagnóstico","content":"Códigos de error y diagnóstico"},"945":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-26","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","type":"heading","tags":[],"url":"/docs/pr-preview/pr-25/manual/servicios-core/est#notas-de-compatibilidad","content":"Notas de compatibilidad"},"946":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-27","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente."},"947":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-28","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`."},"948":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-29","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Esta guía está dividida en dos partes:"},"949":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-30","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Configuración del DMS, para el administrador PKI."},"950":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-31","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento."},"951":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-32","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Si solo necesita una orientación rápida, este es el recorrido recomendado:"},"952":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-33","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Perfil"},"953":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-34","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Leer primero"},"954":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-35","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Después"},"955":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-36","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Administrador PKI"},"956":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-37","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Configuración del DMS"},"957":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-38","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Diagnóstico y compatibilidad"},"958":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-39","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Integrador de dispositivos"},"959":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-40","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Antes de empezar"},"960":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-41","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport","content":"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo"},"961":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-42","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos","content":"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:"},"962":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-43","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos","content":"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap."},"963":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-44","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos","content":"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea."},"964":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-45","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos","content":"Conviene separar cuatro bloques de configuración:"},"965":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-46","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos","content":"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente."},"966":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-47","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos","content":"Cómo se gestionará el re-enrollment de certificados ya emitidos."},"967":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-48","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos","content":"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos."},"968":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-49","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos","content":"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`."},"969":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-50","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-device-registration","content":"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican."},"970":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-51","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-device-registration","content":"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado."},"971":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-52","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-device-registration","content":"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos."},"972":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-53","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-device-registration","content":"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual."},"973":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-54","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota."},"974":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-55","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment."},"975":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-56","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa."},"976":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-57","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:"},"977":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-58","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"Modo"},"978":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-59","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"Descripción"},"979":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-60","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"`CLIENT_CERTIFICATE`"},"980":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-61","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**."},"981":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-62","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"`EXTERNAL_WEBHOOK`"},"982":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-63","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`."},"983":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-64","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"984":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-65","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo."},"985":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-66","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"`NO_AUTH`"},"986":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-67","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción."},"987":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-68","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:"},"988":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-69","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo."},"989":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-70","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz."},"990":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-71","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo."},"991":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-72","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:"},"992":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-73","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**Webhook URL**: dirección del servicio externo que decidirá la autorización."},"993":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-74","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada."},"994":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-75","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación."},"995":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-76","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`."},"996":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-77","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","content":"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización."},"997":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-78","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:"},"998":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-79","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"Campo"},"999":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-80","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"Tipo"},"1000":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-81","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"Efecto sobre el certificado emitido"},"1001":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-82","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"`HonorSubject`"},"1002":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-83","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"booleano"},"1003":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-84","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR."},"1004":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-85","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"`HonorKeyUsage`"},"1005":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-86","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"booleano"},"1006":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-87","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil."},"1007":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-88","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"`HonorExtendedKeyUsages`"},"1008":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-89","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"booleano"},"1009":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-90","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`."},"1010":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-91","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"`HonorExtensions`"},"1011":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-92","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"booleano"},"1012":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-93","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado."},"1013":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-94","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","content":"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas."},"1014":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-95","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","content":"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado."},"1015":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-96","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","content":"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo."},"1016":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-97","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","content":"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana."},"1017":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-98","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","content":"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`."},"1018":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-99","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","content":"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva."},"1019":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-100","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","content":"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico."},"1020":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-101","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","content":"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior."},"1021":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-102","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-serverkeygen","content":"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada."},"1022":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-103","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-serverkeygen","content":"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`."},"1023":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-104","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-serverkeygen","content":"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521."},"1024":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-105","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-serverkeygen","content":"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad."},"1025":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-106","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#verificar-la-configuración","content":"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:"},"1026":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-107","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#verificar-la-configuración","content":"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado."},"1027":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-108","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#verificar-la-configuración","content":"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible."},"1028":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-109","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#verificar-la-configuración","content":"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error."},"1029":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-110","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#integración-de-dispositivos","content":"*Esta sección está dirigida al integrador de dispositivos.*"},"1030":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-111","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#integración-de-dispositivos","content":"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona."},"1031":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-112","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#integración-de-dispositivos","content":"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico."},"1032":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-113","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página."},"1033":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-114","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"Antes de realizar la primera llamada, asegúrese de tener:"},"1034":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-115","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"Elemento"},"1035":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-116","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"Descripción"},"1036":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-117","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"**URL del host EST**"},"1037":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-118","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI."},"1038":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-119","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"**Ancla de confianza del servidor** (`lamassu-trust.pem`)"},"1039":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-120","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor."},"1040":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-121","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"**Certificado bootstrap + clave privada**"},"1041":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-122","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento."},"1042":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-123","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"**ID del DMS** (`{aps}`)"},"1043":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-124","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","content":"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI."},"1044":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-125","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","content":"Caso"},"1045":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-126","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","content":"Credencial habitual"},"1046":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-127","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","content":"Endpoint principal"},"1047":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-128","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","content":"Resultado"},"1048":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-129","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","content":"Alta inicial"},"1049":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-130","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","content":"Certificado bootstrap o el modo definido en `AuthMode`"},"1050":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-131","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/est","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","content":"`/simpleenroll`"},"1051":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/est-132","page_id":"/docs/pr-preview/pr-25/manua