ca de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves."},"678":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-16","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"En el formulario de creación se definen los siguientes bloques de configuración."},"679":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-17","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"**Motor criptográfico**"},"680":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-18","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema."},"681":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-19","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"**Ejemplo mostrado:** go1.24.3"},"682":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-20","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"**Función:** Permite seleccionar el motor criptográfico deseado"},"683":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-21","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"**Parámetros de clave**"},"684":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-22","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"**Key Type:** RSA / EC (Elliptic Curve), ML-DSA, SLH-DSA, Ed25519 y firmas compuestas (Composite ML-DSA)"},"685":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-23","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"**Key Size:**"},"686":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-24","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"RSA: 1024, 2048, 3072, 4096 bits"},"687":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-25","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"EC: P-256, P-384, P-521"},"688":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-26","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"ML-DSA: 44, 65 o 87"},"689":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-27","page_id":"/docs/pr-preview/pr-25/manual/servicios-core/cas","tags":[],"type":"text","url":"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","content":"SLH-DSA: parámetro 1 a 12"},"690":{"id":"/docs/pr-preview/pr-25/manual/servicios-core/cas-28","page_id":"/docs/pr-preview/pr-25/ma