-interactivo--n","Modo no interactivo (`-n`)",{"_8437":44,"_23077":34,"_5":23236,"_19595":33660,"_15751":33661,"_1713":33662},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-online-vs-offline","Modo online vs offline",{"_8437":45,"_23077":34,"_5":23236,"_19595":33664,"_15751":33665,"_1713":33666},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_8437":46,"_23077":34,"_5":23236,"_19595":33668,"_15751":33669,"_1713":33670},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-offline","Modo offline",{"_8437":47,"_23077":34,"_5":23236,"_19595":33672,"_15751":33673,"_1713":33674},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#instalación-de-componentes","Instalación de componentes",{"_8437":48,"_23077":34,"_5":23236,"_19595":33676,"_15751":33677,"_1713":33678},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_8437":49,"_23077":34,"_5":23236,"_19595":33680,"_15751":33681,"_1713":33682},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_8437":50,"_23077":34,"_5":23236,"_19595":33684,"_15751":33685,"_1713":33686},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_8437":51,"_23077":34,"_5":23236,"_19595":33688,"_15751":33689,"_1713":33690},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_8437":52,"_23077":34,"_5":23236,"_19595":33692,"_15751":33693,"_1713":33694},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#configuración-tls","Configuración TLS",{"_8437":53,"_23077":34,"_5":23236,"_19595":33696,"_15751":33697,"_1713":33698},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#certificado-externo","Certificado externo",{"_8437":54,"_23077":34,"_5":23236,"_19595":33700,"_15751":33701,"_1713":33702},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_8437":55,"_23077":34,"_5":23236,"_19595":33704,"_15751":33705,"_1713":33706},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_8437":56,"_23077":34,"_5":23236,"_19595":33708,"_15751":33709,"_1713":33710},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#uso-en-ci","Uso en CI",{"_8437":57,"_23077":34,"_5":23236,"_19595":33712,"_15751":33713,"_1713":33714},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#ejemplo-rápido","Ejemplo rápido",{"_8437":58,"_23077":34,"_5":23236,"_19595":33716,"_15751":33717,"_1713":33718},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#resumen","Resumen",{"_8437":59,"_23077":34,"_19595":33720,"_5":23231,"_15751":33629,"_1713":33721},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_8437":60,"_23077":34,"_19595":33723,"_5":23231,"_15751":33629,"_1713":33724},[],"La instalación incluye:",{"_8437":61,"_23077":34,"_19595":33726,"_5":23231,"_15751":33629,"_1713":33727},[],"PostgreSQL",{"_8437":62,"_23077":34,"_19595":33729,"_5":23231,"_15751":33629,"_1713":33730},[],"Keycloak",{"_8437":63,"_23077":34,"_19595":33732,"_5":23231,"_15751":33629,"_1713":33733},[],"RabbitMQ",{"_8437":64,"_23077":34,"_19595":33735,"_5":23231,"_15751":33629,"_1713":33736},[],"Chart Helm de Lamassu",{"_8437":65,"_23077":34,"_19595":33738,"_5":23231,"_15751":33633,"_1713":33739},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_8437":66,"_23077":34,"_19595":33741,"_5":23231,"_15751":33633,"_1713":33742},[],"Flag",{"_8437":67,"_23077":34,"_19595":33744,"_5":23231,"_15751":33633,"_1713":33745},[],"Valor por defecto",{"_8437":68,"_23077":34,"_19595":33747,"_5":23231,"_15751":33633,"_1713":33748},[],"Descripción",{"_8437":69,"_23077":34,"_19595":33750,"_5":23231,"_15751":33633,"_1713":33751},[],"`-h`, `--help`",{"_8437":70,"_23077":34,"_19595":33753,"_5":23231,"_15751":33633,"_1713":3202},[],{"_8437":71,"_23077":34,"_19595":33755,"_5":23231,"_15751":33633,"_1713":33756},[],"Muestra la ayuda y finaliza",{"_8437":72,"_23077":34,"_19595":33758,"_5":23231,"_15751":33633,"_1713":33759},[],"`-n`, `--non-interactive`",{"_8437":73,"_23077":34,"_19595":33761,"_5":23231,"_15751":33633,"_1713":33762},[],"`false`",{"_8437":74,"_23077":34,"_19595":33764,"_5":23231,"_15751":33633,"_1713":33765},[],"Omite prompts y genera/usa credenciales por defecto",{"_8437":75,"_23077":34,"_19595":33767,"_5":23231,"_15751":33633,"_1713":33768},[],"`-ns`, `--namespace`",{"_8437":76,"_23077":34,"_19595":33770,"_5":23231,"_15751":33633,"_1713":33771},[],"`lamassu-dev`",{"_8437":77,"_23077":34,"_19595":33773,"_5":23231,"_15751":33633,"_1713":33774},[],"Namespace Kubernetes donde se despliegan los recursos",{"_8437":78,"_23077":34,"_19595":33776,"_5":23231,"_15751":33633,"_1713":33777},[],"`-d`, `--domain`",{"_8437":79,"_23077":34,"_19595":33779,"_5":23231,"_15751":33633,"_1713":33780},[],"`dev.lamassu.io`",{"_8437":80,"_23077":34,"_19595":33782,"_5":23231,"_15751":33633,"_1713":33783},[],"Dominio usado para endpoint y certificados TLS",{"_8437":81,"_23077":34,"_19595":33785,"_5":23231,"_15751":33633,"_1713":33786},[],"`-v`, `--version`",{"_8437":82,"_23077":34,"_19595":33788,"_5":23231,"_15751":33633,"_1713":33789},[],"`latest`",{"_8437":83,"_23077":34,"_19595":33791,"_5":23231,"_15751":33633,"_1713":33792},[],"Versión del chart Helm de Lamassu",{"_8437":84,"_23077":34,"_19595":33794,"_5":23231,"_15751":33633,"_1713":33795},[],"`--https-port`",{"_8437":85,"_23077":34,"_19595":33797,"_5":23231,"_15751":33633,"_1713":33798},[],"`443`",{"_8437":86,"_23077":34,"_19595":33800,"_5":23231,"_15751":33633,"_1713":33801},[],"Puerto HTTPS del gateway",{"_8437":87,"_23077":34,"_19595":33803,"_5":23231,"_15751":33633,"_1713":33804},[],"`--http-port`",{"_8437":88,"_23077":34,"_19595":33806,"_5":23231,"_15751":33633,"_1713":33807},[],"`80`",{"_8437":89,"_23077":34,"_19595":33809,"_5":23231,"_15751":33633,"_1713":33810},[],"Puerto HTTP del gateway",{"_8437":90,"_23077":34,"_19595":33812,"_5":23231,"_15751":33633,"_1713":33813},[],"`--offline`",{"_8437":91,"_23077":34,"_19595":33815,"_5":23231,"_15751":33633,"_1713":33762},[],{"_8437":92,"_23077":34,"_19595":33817,"_5":23231,"_15751":33633,"_1713":33818},[],"Activa modo offline",{"_8437":93,"_23077":34,"_19595":33820,"_5":23231,"_15751":33633,"_1713":33821},[],"`--tls-crt`",{"_8437":94,"_23077":34,"_19595":33823,"_5":23231,"_15751":33633,"_1713":3202},[],{"_8437":95,"_23077":34,"_19595":33825,"_5":23231,"_15751":33633,"_1713":33826},[],"Ruta al certificado TLS (PEM)",{"_8437":96,"_23077":34,"_19595":33828,"_5":23231,"_15751":33633,"_1713":33829},[],"`--tls-key`",{"_8437":97,"_23077":34,"_19595":33831,"_5":23231,"_15751":33633,"_1713":3202},[],{"_8437":98,"_23077":34,"_19595":33833,"_5":23231,"_15751":33633,"_1713":33834},[],"Ruta a la clave privada TLS (PEM)",{"_8437":99,"_23077":34,"_19595":33836,"_5":23231,"_15751":33633,"_1713":33837},[],"`--helm-chart-lamassu`",{"_8437":100,"_23077":34,"_19595":33839,"_5":23231,"_15751":33633,"_1713":3202},[],{"_8437":101,"_23077":34,"_19595":33841,"_5":23231,"_15751":33633,"_1713":33842},[],"Ruta a chart local Lamassu (`.tgz`)",{"_8437":102,"_23077":34,"_19595":33844,"_5":23231,"_15751":33633,"_1713":33845},[],"`--helm-chart-postgres`",{"_8437":103,"_23077":34,"_19595":33847,"_5":23231,"_15751":33633,"_1713":3202},[],{"_8437":104,"_23077":34,"_19595":33849,"_5":23231,"_15751":33633,"_1713":33850},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_8437":105,"_23077":34,"_19595":33852,"_5":23231,"_15751":33633,"_1713":33853},[],"`--helm-chart-keycloak`",{"_8437":106,"_23077":34,"_19595":33855,"_5":23231,"_15751":33633,"_1713":3202},[],{"_8437":107,"_23077":34,"_19595":33857,"_5":23231,"_15751":33633,"_1713":33858},[],"Ruta a chart local Keycloak (`.tgz`)",{"_8437":108,"_23077":34,"_19595":33860,"_5":23231,"_15751":33633,"_1713":33861},[],"`--helm-chart-rabbitmq`",{"_8437":109,"_23077":34,"_19595":33863,"_5":23231,"_15751":33633,"_1713":3202},[],{"_8437":110,"_23077":34,"_19595":33865,"_5":23231,"_15751":33633,"_1713":33866},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_8437":111,"_23077":34,"_19595":33868,"_5":23231,"_15751":33633,"_1713":33869},[],"`-l`, `--local-chart-path`",{"_8437":112,"_23077":34,"_19595":33871,"_5":23231,"_15751":33633,"_1713":3202},[],{"_8437":113,"_23077":34,"_19595":33873,"_5":23231,"_15751":33633,"_1713":33874},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_8437":114,"_23077":34,"_19595":33876,"_5":23231,"_15751":33637,"_1713":33877},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_8437":115,"_23077":34,"_19595":33879,"_5":23231,"_15751":33637,"_1713":33880},[],"`microk8s`",{"_8437":116,"_23077":34,"_19595":33882,"_5":23231,"_15751":33637,"_1713":33883},[],"`k3s`",{"_8437":117,"_23077":34,"_19595":33885,"_5":23231,"_15751":33637,"_1713":33886},[],"`kind`",{"_8437":118,"_23077":34,"_19595":33888,"_5":23231,"_15751":33637,"_1713":33889},[],"Kubernetes estándar",{"_8437":119,"_23077":34,"_19595":33891,"_5":23231,"_15751":33637,"_1713":33892},[],"Comportamientos específicos:",{"_8437":120,"_23077":34,"_19595":33894,"_5":23231,"_15751":33637,"_1713":33895},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_8437":121,"_23077":34,"_19595":33897,"_5":23231,"_15751":33637,"_1713":33898},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_8437":122,"_23077":34,"_19595":33900,"_5":23231,"_15751":33641,"_1713":33901},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_8437":123,"_23077":34,"_19595":33903,"_5":23231,"_15751":33641,"_1713":33904},[],"Requisitos generales:",{"_8437":124,"_23077":34,"_19595":33906,"_5":23231,"_15751":33641,"_1713":33907},[],"`yq`",{"_8437":125,"_23077":34,"_19595":33909,"_5":23231,"_15751":33641,"_1713":33910},[],"CLI de la distribución detectada",{"_8437":126,"_23077":34,"_19595":33912,"_5":23231,"_15751":33641,"_1713":33913},[],"Requisitos específicos:",{"_8437":127,"_23077":34,"_19595":33915,"_5":23231,"_15751":33641,"_1713":33916},[],"Distribución",{"_8437":128,"_23077":34,"_19595":33918,"_5":23231,"_15751":33641,"_1713":33919},[],"Herramientas requeridas",{"_8437":129,"_23077":34,"_19595":33921,"_5":23231,"_15751":33641,"_1713":33883},[],{"_8437":130,"_23077":34,"_19595":33923,"_5":23231,"_15751":33641,"_1713":33924},[],"`kubectl`, `helm`",{"_8437":131,"_23077":34,"_19595":33926,"_5":23231,"_15751":33641,"_1713":33880},[],{"_8437":132,"_23077":34,"_19595":33928,"_5":23231,"_15751":33641,"_1713":33929},[],"`microk8s kubectl`, `microk8s helm`",{"_8437":133,"_23077":34,"_19595":33931,"_5":23231,"_15751":33645,"_1713":33932},[],"Se valida que estén habilitados:",{"_8437":134,"_23077":34,"_19595":33934,"_5":23231,"_15751":33645,"_1713":33935},[],"`helm`",{"_8437":135,"_23077":34,"_19595":33937,"_5":23231,"_15751":33645,"_1713":33938},[],"`hostpath-storage`",{"_8437":136,"_23077":34,"_19595":33940,"_5":23231,"_15751":33645,"_1713":33941},[],"`dns`",{"_8437":137,"_23077":34,"_19595":33943,"_5":23231,"_15751":33645,"_1713":33944},[],"`cert-manager`",{"_8437":138,"_23077":34,"_19595":33946,"_5":23231,"_15751":33645,"_1713":33947},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_8437":139,"_23077":34,"_19595":33949,"_5":23231,"_15751":33653,"_1713":33950},[],"La función `request_config_data` solicita:",{"_8437":140,"_23077":34,"_19595":33952,"_5":23231,"_15751":33653,"_1713":33953},[],"Dominio Lamassu",{"_8437":141,"_23077":34,"_19595":33955,"_5":23231,"_15751":33653,"_1713":33956},[],"Usuario y contraseña admin PostgreSQL",{"_8437":142,"_23077":34,"_19595":33958,"_5":23231,"_15751":33653,"_1713":33959},[],"Usuario y contraseña admin RabbitMQ",{"_8437":143,"_23077":34,"_19595":33961,"_5":23231,"_15751":33653,"_1713":33962},[],"Usuario y contraseña admin Keycloak",{"_8437":144,"_23077":34,"_19595":33964,"_5":23231,"_15751":33653,"_1713":33965},[],"Namespace Kubernetes",{"_8437":145,"_23077":34,"_19595":33967,"_5":23231,"_15751":33657,"_1713":33968},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_8437":146,"_23077":34,"_19595":33970,"_5":23231,"_15751":33657,"_1713":33971},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_8437":147,"_23077":34,"_19595":33973,"_5":23231,"_15751":33661,"_1713":33974},[],"El script admite dos estrategias para obtener charts Helm.",{"_8437":148,"_23077":34,"_19595":33976,"_5":23231,"_15751":33665,"_1713":33977},[],"Los charts se descargan desde repositorios remotos.",{"_8437":149,"_23077":34,"_19595":33979,"_5":23231,"_15751":33669,"_1713":33980},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_8437":150,"_23077":34,"_19595":33982,"_5":23231,"_15751":33669,"_1713":33837},[],{"_8437":151,"_23077":34,"_19595":33984,"_5":23231,"_15751":33669,"_1713":33845},[],{"_8437":152,"_23077":34,"_19595":33986,"_5":23231,"_15751":33669,"_1713":33853},[],{"_8437":153,"_23077":34,"_19595":33988,"_5":23231,"_15751":33669,"_1713":33861},[],{"_8437":154,"_23077":34,"_19595":33990,"_5":23231,"_15751":33669,"_1713":33991},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_8437":155,"_23077":34,"_19595":33993,"_5":23231,"_15751":33669,"_1713":33994},[],"En este modo se fuerza:",{"_8437":156,"_23077":34,"_19595":33996,"_5":23231,"_15751":33677,"_1713":33997},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_8437":157,"_23077":34,"_19595":33999,"_5":23231,"_15751":33677,"_1713":34000},[],"Versión del chart: `0.19.0`",{"_8437":158,"_23077":34,"_19595":34002,"_5":23231,"_15751":33677,"_1713":34003},[],"Release: `postgres`",{"_8437":159,"_23077":34,"_19595":34005,"_5":23231,"_15751":33677,"_1713":34006},[],"`fullnameOverride: \"postgresql\"`",{"_8437":160,"_23077":34,"_19595":34008,"_5":23231,"_15751":33677,"_1713":34009},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_8437":161,"_23077":34,"_19595":34011,"_5":23231,"_15751":33677,"_1713":34012},[],"Base de datos",{"_8437":162,"_23077":34,"_19595":34014,"_5":23231,"_15751":33677,"_1713":34015},[],"Servicio",{"_8437":163,"_23077":34,"_19595":34017,"_5":23231,"_15751":33677,"_1713":34018},[],"`auth`",{"_8437":164,"_23077":34,"_19595":34020,"_5":23231,"_15751":33677,"_1713":33730},[],{"_8437":165,"_23077":34,"_19595":34022,"_5":23231,"_15751":33677,"_1713":34023},[],"`alerts`",{"_8437":166,"_23077":34,"_19595":34025,"_5":23231,"_15751":33677,"_1713":34026},[],"Alerts",{"_8437":167,"_23077":34,"_19595":34028,"_5":23231,"_15751":33677,"_1713":34029},[],"`ca`",{"_8437":168,"_23077":34,"_19595":34031,"_5":23231,"_15751":33677,"_1713":34032},[],"CA",{"_8437":169,"_23077":34,"_19595":34034,"_5":23231,"_15751":33677,"_1713":34035},[],"`va`",{"_8437":170,"_23077":34,"_19595":34037,"_5":23231,"_15751":33677,"_1713":34038},[],"VA",{"_8437":171,"_23077":34,"_19595":34040,"_5":23231,"_15751":33677,"_1713":34041},[],"`cloudproxy`",{"_8437":172,"_23077":34,"_19595":34043,"_5":23231,"_15751":33677,"_1713":34044},[],"Cloud Proxy",{"_8437":173,"_23077":34,"_19595":34046,"_5":23231,"_15751":33677,"_1713":34047},[],"`devicemanager`",{"_8437":174,"_23077":34,"_19595":34049,"_5":23231,"_15751":33677,"_1713":34050},[],"Device Manager",{"_8437":175,"_23077":34,"_19595":34052,"_5":23231,"_15751":33677,"_1713":34053},[],"`dmsmanager`",{"_8437":176,"_23077":34,"_19595":34055,"_5":23231,"_15751":33677,"_1713":34056},[],"DMS Manager",{"_8437":177,"_23077":34,"_19595":34058,"_5":23231,"_15751":33677,"_1713":34059},[],"`kms`",{"_8437":178,"_23077":34,"_19595":34061,"_5":23231,"_15751":33677,"_1713":34062},[],"KMS",{"_8437":179,"_23077":34,"_19595":34064,"_5":23231,"_15751":33681,"_1713":34065},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_8437":180,"_23077":34,"_19595":34067,"_5":23231,"_15751":33681,"_1713":34068},[],"Versión del chart: `0.20.0`",{"_8437":181,"_23077":34,"_19595":34070,"_5":23231,"_15751":33681,"_1713":34071},[],"Release: `auth`",{"_8437":182,"_23077":34,"_19595":34073,"_5":23231,"_15751":33681,"_1713":34074},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_8437":183,"_23077":34,"_19595":34076,"_5":23231,"_15751":33681,"_1713":34077},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_8437":184,"_23077":34,"_19595":34079,"_5":23231,"_15751":33681,"_1713":34080},[],"`httpRelativePath: /auth/`",{"_8437":185,"_23077":34,"_19595":34082,"_5":23231,"_15751":33681,"_1713":34083},[],"`proxyHeaders: xforwarded`",{"_8437":186,"_23077":34,"_19595":34085,"_5":23231,"_15751":33681,"_1713":34086},[],"Configuración automática del realm `lamassu`:",{"_8437":187,"_23077":34,"_19595":34088,"_5":23231,"_15751":33681,"_1713":34089},[],"Rol: `pki-admin`",{"_8437":188,"_23077":34,"_19595":34091,"_5":23231,"_15751":33681,"_1713":34092},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_8437":189,"_23077":34,"_19595":34094,"_5":23231,"_15751":33681,"_1713":34095},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_8437":190,"_23077":34,"_19595":34097,"_5":23231,"_15751":33681,"_1713":34098},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_8437":191,"_23077":34,"_19595":34100,"_5":23231,"_15751":33681,"_1713":34101},[],"`github.com/lamassuiot/keycloak-theme`",{"_8437":192,"_23077":34,"_19595":34103,"_5":23231,"_15751":33685,"_1713":34104},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_8437":193,"_23077":34,"_19595":34106,"_5":23231,"_15751":33685,"_1713":34068},[],{"_8437":194,"_23077":34,"_19595":34108,"_5":23231,"_15751":33685,"_1713":34109},[],"Release: `rabbitmq`",{"_8437":195,"_23077":34,"_19595":34111,"_5":23231,"_15751":33685,"_1713":34112},[],"`fullnameOverride: \"rabbitmq\"`",{"_8437":196,"_23077":34,"_19595":34114,"_5":23231,"_15751":33685,"_1713":34115},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_8437":197,"_23077":34,"_19595":34117,"_5":23231,"_15751":33689,"_1713":34118},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_8437":198,"_23077":34,"_19595":34120,"_5":23231,"_15751":33689,"_1713":34121},[],"Configuraciones principales:",{"_8437":199,"_23077":34,"_19595":34123,"_5":23231,"_15751":33689,"_1713":34124},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_8437":200,"_23077":34,"_19595":34126,"_5":23231,"_15751":33689,"_1713":34127},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_8437":201,"_23077":34,"_19595":34129,"_5":23231,"_15751":33689,"_1713":34130},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_8437":202,"_23077":34,"_19595":34132,"_5":23231,"_15751":33689,"_1713":34133},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_8437":203,"_23077":34,"_19595":34135,"_5":23231,"_15751":33689,"_1713":34136},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_8437":204,"_23077":34,"_19595":34138,"_5":23231,"_15751":33689,"_1713":34139},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_8437":205,"_23077":34,"_19595":34141,"_5":23231,"_15751":33689,"_1713":34142},[],"Dominios CA: valor de `--domain`",{"_8437":206,"_23077":34,"_19595":34144,"_5":23231,"_15751":33689,"_1713":34145},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_8437":207,"_23077":34,"_19595":34147,"_5":23231,"_15751":33689,"_1713":34148},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_8437":208,"_23077":34,"_19595":34150,"_5":23231,"_15751":33689,"_1713":34151},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_8437":209,"_23077":34,"_19595":34153,"_5":23231,"_15751":33697,"_1713":34154},[],"Si se proporcionan:",{"_8437":210,"_23077":34,"_19595":34156,"_5":23231,"_15751":33697,"_1713":33821},[],{"_8437":211,"_23077":34,"_19595":34158,"_5":23231,"_15751":33697,"_1713":33829},[],{"_8437":212,"_23077":34,"_19595":34160,"_5":23231,"_15751":33697,"_1713":34161},[],"Se crea un secret Kubernetes:",{"_8437":213,"_23077":34,"_19595":34163,"_5":23231,"_15751":33697,"_1713":34164},[],"`downstream-provided-crt`",{"_8437":214,"_23077":34,"_19595":34166,"_5":23231,"_15751":33697,"_1713":34167},[],"Y se configura:",{"_8437":215,"_23077":34,"_19595":34169,"_5":23231,"_15751":33701,"_1713":34170},[],"Si no se proporciona certificado:",{"_8437":216,"_23077":34,"_19595":34172,"_5":23231,"_15751":33701,"_1713":34173},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_8437":217,"_23077":34,"_19595":34175,"_5":23231,"_15751":33701,"_1713":34176},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_8437":218,"_23077":34,"_19595":34178,"_5":23231,"_15751":33705,"_1713":34179},[],"En caso de éxito, se muestra:",{"_8437":219,"_23077":34,"_19595":34181,"_5":23231,"_15751":33705,"_1713":34182},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_8437":220,"_23077":34,"_19595":34184,"_5":23231,"_15751":33705,"_1713":34185},[],"Credenciales iniciales: `lamassu / lamassu`",{"_8437":221,"_23077":34,"_19595":34187,"_5":23231,"_15751":33705,"_1713":34188},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_8437":222,"_23077":34,"_19595":34190,"_5":23231,"_15751":33705,"_1713":34191},[],"Credenciales admin de Keycloak",{"_8437":223,"_23077":34,"_19595":34193,"_5":23231,"_15751":33705,"_1713":34194},[],"El usuario `lamassu` se crea con:",{"_8437":224,"_23077":34,"_19595":34196,"_5":23231,"_15751":33705,"_1713":34197},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_8437":225,"_23077":34,"_19595":34199,"_5":23231,"_15751":33709,"_1713":34200},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_8437":226,"_23077":34,"_19595":34202,"_5":23231,"_15751":33709,"_1713":34203},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_8437":227,"_23077":34,"_19595":34205,"_5":23231,"_15751":33709,"_1713":34206},[],"Ejemplo:",{"_8437":228,"_23077":34,"_19595":34208,"_5":23231,"_15751":33709,"_1713":34209},[],"En este escenario:",{"_8437":229,"_23077":34,"_19595":34211,"_5":23231,"_15751":33709,"_1713":34212},[],"`-n`: modo no interactivo",{"_8437":230,"_23077":34,"_19595":34214,"_5":23231,"_15751":33709,"_1713":34215},[],"`-ns`: namespace específico",{"_8437":231,"_23077":34,"_19595":34217,"_5":23231,"_15751":33709,"_1713":34218},[],"`-d`: dominio de CI",{"_8437":232,"_23077":34,"_19595":34220,"_5":23231,"_15751":33709,"_1713":34221},[],"`-l`: chart local",{"_8437":233,"_23077":34,"_19595":34223,"_5":23231,"_15751":33717,"_1713":34224},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_8437":234,"_23077":34,"_19595":34226,"_5":23231,"_15751":33717,"_1713":34227},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_8437":235,"_23077":235,"_5":23226,"_1713":34229,"_23239":34230,"_19595":34231,"_15751":235},"Introducción",[33545,33546,33597],[],{"_8437":236,"_23077":235,"_19595":34233,"_5":23231,"_15751":235,"_1713":34234},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_8437":237,"_23077":235,"_5":23236,"_19595":34236,"_15751":34237,"_1713":34238},[],"/docs/pr-preview/pr-25/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_8437":238,"_23077":235,"_5":23236,"_19595":34240,"_15751":34241,"_1713":34242},[],"/docs/pr-preview/pr-25/despliegue/onprem#quickstart","Quickstart",{"_8437":239,"_23077":235,"_5":23236,"_19595":34244,"_15751":34245,"_1713":34246},[],"/docs/pr-preview/pr-25/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_8437":240,"_23077":235,"_5":23236,"_19595":34248,"_15751":34249,"_1713":34250},[],"/docs/pr-preview/pr-25/despliegue/onprem#requisitos-previos","Requisitos previos",{"_8437":241,"_23077":235,"_5":23236,"_19595":34252,"_15751":34253,"_1713":34254},[],"/docs/pr-preview/pr-25/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_8437":242,"_23077":235,"_5":23236,"_19595":34256,"_15751":34257,"_1713":34258},[],"/docs/pr-preview/pr-25/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_8437":243,"_23077":235,"_5":23236,"_19595":34260,"_15751":34261,"_1713":34262},[],"/docs/pr-preview/pr-25/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_8437":244,"_23077":235,"_5":23236,"_19595":34264,"_15751":34265,"_1713":34266},[],"/docs/pr-preview/pr-25/despliegue/onprem#arquitectura","Arquitectura",{"_8437":245,"_23077":235,"_5":23236,"_19595":34268,"_15751":34269,"_1713":34270},[],"/docs/pr-preview/pr-25/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_8437":246,"_23077":235,"_5":23236,"_19595":34272,"_15751":34273,"_1713":34274},[],"/docs/pr-preview/pr-25/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_8437":247,"_23077":235,"_5":23236,"_19595":34276,"_15751":34277,"_1713":34278},[],"/docs/pr-preview/pr-25/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_8437":248,"_23077":235,"_5":23236,"_19595":34280,"_15751":34281,"_1713":34282},[],"/docs/pr-preview/pr-25/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_8437":249,"_23077":235,"_5":23236,"_19595":34284,"_15751":34285,"_1713":34286},[],"/docs/pr-preview/pr-25/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_8437":250,"_23077":235,"_5":23236,"_19595":34288,"_15751":34289,"_1713":34290},[],"/docs/pr-preview/pr-25/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_8437":251,"_23077":235,"_5":23236,"_19595":34292,"_15751":34293,"_1713":34294},[],"/docs/pr-preview/pr-25/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_8437":252,"_23077":235,"_19595":34296,"_5":23231,"_15751":34237,"_1713":34297},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_8437":253,"_23077":235,"_19595":34299,"_5":23231,"_15751":34237,"_1713":34300},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_8437":254,"_23077":235,"_19595":34302,"_5":23231,"_15751":34237,"_1713":34303},[],"el chart principal de Lamassu",{"_8437":255,"_23077":235,"_19595":34305,"_5":23231,"_15751":34237,"_1713":34306},[],"un chart auxiliar de SoftHSM",{"_8437":256,"_23077":235,"_19595":34308,"_5":23231,"_15751":34237,"_1713":34309},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_8437":257,"_23077":235,"_19595":34311,"_5":23231,"_15751":34241,"_1713":34312},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_8437":258,"_23077":235,"_19595":34314,"_5":23231,"_15751":34241,"_1713":34315},[],"Ese flujo:",{"_8437":259,"_23077":235,"_19595":34317,"_5":23231,"_15751":34241,"_1713":34318},[],"crea o reutiliza el namespace indicado",{"_8437":260,"_23077":235,"_19595":34320,"_5":23231,"_15751":34241,"_1713":34321},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_8437":261,"_23077":235,"_19595":34323,"_5":23231,"_15751":34241,"_1713":34324},[],"despliega el chart de Lamassu",{"_8437":262,"_23077":235,"_19595":34326,"_5":23231,"_15751":34241,"_1713":34327},[],"deja la UI expuesta en `https://<dominio>`",{"_8437":263,"_23077":235,"_19595":34329,"_5":23231,"_15751":34241,"_1713":34330},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_8437":264,"_23077":235,"_19595":34332,"_5":23231,"_15751":34245,"_1713":34333},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_8437":265,"_23077":235,"_19595":34335,"_5":23231,"_15751":34245,"_1713":34336},[],"`ui`",{"_8437":266,"_23077":235,"_19595":34338,"_5":23231,"_15751":34245,"_1713":34029},[],{"_8437":267,"_23077":235,"_19595":34340,"_5":23231,"_15751":34245,"_1713":34035},[],{"_8437":268,"_23077":235,"_19595":34342,"_5":23231,"_15751":34245,"_1713":34059},[],{"_8437":269,"_23077":235,"_19595":34344,"_5":23231,"_15751":34245,"_1713":34345},[],"`device-manager`",{"_8437":270,"_23077":235,"_19595":34347,"_5":23231,"_15751":34245,"_1713":34348},[],"`dms-manager`",{"_8437":271,"_23077":235,"_19595":34350,"_5":23231,"_15751":34245,"_1713":34023},[],{"_8437":272,"_23077":235,"_19595":34352,"_5":23231,"_15751":34245,"_1713":34353},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_8437":273,"_23077":235,"_19595":34355,"_5":23231,"_15751":34245,"_1713":34356},[],"job de migraciones de base de datos",{"_8437":274,"_23077":235,"_19595":34358,"_5":23231,"_15751":34249,"_1713":34359},[],"Clúster Kubernetes `1.19+`",{"_8437":275,"_23077":235,"_19595":34361,"_5":23231,"_15751":34249,"_1713":34362},[],"`kubectl` configurado con acceso al clúster",{"_8437":276,"_23077":235,"_19595":34364,"_5":23231,"_15751":34249,"_1713":34365},[],"Helm `3.2.0+`",{"_8437":277,"_23077":235,"_19595":34367,"_5":23231,"_15751":34249,"_1713":34368},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_8437":278,"_23077":235,"_19595":34370,"_5":23231,"_15751":34249,"_1713":34371},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_8437":279,"_23077":235,"_19595":34373,"_5":23231,"_15751":34249,"_1713":34374},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_8437":280,"_23077":235,"_19595":34376,"_5":23231,"_15751":34249,"_1713":34377},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_8437":281,"_23077":235,"_19595":34379,"_5":23231,"_15751":34253,"_1713":34380},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_8437":282,"_23077":235,"_19595":34382,"_5":23231,"_15751":34257,"_1713":34383},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_8437":283,"_23077":235,"_19595":34385,"_5":23231,"_15751":34261,"_1713":34386},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_8437":284,"_23077":235,"_19595":34388,"_5":23231,"_15751":34265,"_1713":34389},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_8437":285,"_23077":235,"_19595":34391,"_5":23231,"_15751":34265,"_1713":34392},[],"Dependencias externas requeridas por el chart principal:",{"_8437":286,"_23077":235,"_19595":34394,"_5":23231,"_15751":34265,"_1713":33727},[],{"_8437":287,"_23077":235,"_19595":34396,"_5":23231,"_15751":34265,"_1713":33733},[],{"_8437":288,"_23077":235,"_19595":34398,"_5":23231,"_15751":34265,"_1713":34399},[],"proveedor OIDC, típicamente Keycloak",{"_8437":289,"_23077":235,"_19595":34401,"_5":23231,"_15751":34265,"_1713":34402},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_8437":290,"_23077":235,"_19595":34404,"_5":23231,"_15751":34269,"_1713":34405},[],"Agregar el repositorio Helm:",{"_8437":291,"_23077":235,"_19595":34407,"_5":23231,"_15751":34269,"_1713":34408},[],"O instalar desde una copia local del repositorio:",{"_8437":292,"_23077":235,"_19595":34410,"_5":23231,"_15751":34273,"_1713":34411},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_8437":293,"_23077":235,"_19595":34413,"_5":23231,"_15751":34273,"_1713":34414},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_8437":294,"_23077":235,"_19595":34416,"_5":23231,"_15751":34273,"_1713":34417},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_8437":295,"_23077":235,"_19595":34419,"_5":23231,"_15751":34273,"_1713":34420},[],"`auth.oidc.frontend.authority`",{"_8437":296,"_23077":235,"_19595":34422,"_5":23231,"_15751":34273,"_1713":34423},[],"`auth.oidc.apiGateway.jwks`",{"_8437":297,"_23077":235,"_19595":34425,"_5":23231,"_15751":34273,"_1713":34426},[],"`services.ca.domains`",{"_8437":298,"_23077":235,"_19595":34428,"_5":23231,"_15751":34273,"_1713":34429},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_8437":299,"_23077":235,"_19595":34431,"_5":23231,"_15751":34273,"_1713":34432},[],"`tls.*` según se use `certManager` o certificado externo",{"_8437":300,"_23077":235,"_19595":34434,"_5":23231,"_15751":34273,"_1713":34435},[],"Ejemplo base:",{"_8437":301,"_23077":235,"_19595":34437,"_5":23231,"_15751":34277,"_1713":34438},[],"Área",{"_8437":302,"_23077":235,"_19595":34440,"_5":23231,"_15751":34277,"_1713":34441},[],"Valores clave",{"_8437":303,"_23077":235,"_19595":34443,"_5":23231,"_15751":34277,"_1713":34444},[],"Uso",{"_8437":304,"_23077":235,"_19595":34446,"_5":23231,"_15751":34277,"_1713":34447},[],"TLS",{"_8437":305,"_23077":235,"_19595":34449,"_5":23231,"_15751":34277,"_1713":34450},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_8437":306,"_23077":235,"_19595":34452,"_5":23231,"_15751":34277,"_1713":34453},[],"Certificado downstream del Gateway",{"_8437":307,"_23077":235,"_19595":34455,"_5":23231,"_15751":34277,"_1713":34456},[],"Gateway",{"_8437":308,"_23077":235,"_19595":34458,"_5":23231,"_15751":34277,"_1713":34459},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_8437":309,"_23077":235,"_19595":34461,"_5":23231,"_15751":34277,"_1713":34462},[],"Exposición de UI y APIs vía Envoy Gateway",{"_8437":310,"_23077":235,"_19595":34464,"_5":23231,"_15751":34277,"_1713":34012},[],{"_8437":311,"_23077":235,"_19595":34466,"_5":23231,"_15751":34277,"_1713":34467},[],"`postgres.*`",{"_8437":312,"_23077":235,"_19595":34469,"_5":23231,"_15751":34277,"_1713":34470},[],"Conexión a PostgreSQL externa",{"_8437":313,"_23077":235,"_19595":34472,"_5":23231,"_15751":34277,"_1713":34473},[],"Mensajería",{"_8437":314,"_23077":235,"_19595":34475,"_5":23231,"_15751":34277,"_1713":34476},[],"`amqp.*`",{"_8437":315,"_23077":235,"_19595":34478,"_5":23231,"_15751":34277,"_1713":34479},[],"Conexión a RabbitMQ",{"_8437":316,"_23077":235,"_19595":34481,"_5":23231,"_15751":34277,"_1713":34482},[],"OIDC",{"_8437":317,"_23077":235,"_19595":34484,"_5":23231,"_15751":34277,"_1713":34485},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_8437":318,"_23077":235,"_19595":34487,"_5":23231,"_15751":34277,"_1713":34488},[],"Login de UI y validación JWT en el Gateway",{"_8437":319,"_23077":235,"_19595":34490,"_5":23231,"_15751":34277,"_1713":34032},[],{"_8437":320,"_23077":235,"_19595":34492,"_5":23231,"_15751":34277,"_1713":34426},[],{"_8437":321,"_23077":235,"_19595":34494,"_5":23231,"_15751":34277,"_1713":34495},[],"Dominios autorizados para CA y certificados",{"_8437":322,"_23077":235,"_19595":34497,"_5":23231,"_15751":34277,"_1713":34062},[],{"_8437":323,"_23077":235,"_19595":34499,"_5":23231,"_15751":34277,"_1713":34500},[],"`services.kms.cryptoEngines.*`",{"_8437":324,"_23077":235,"_19595":34502,"_5":23231,"_15751":34277,"_1713":34503},[],"Motor criptográfico y almacenamiento de claves",{"_8437":325,"_23077":235,"_19595":34505,"_5":23231,"_15751":34277,"_1713":34026},[],{"_8437":326,"_23077":235,"_19595":34507,"_5":23231,"_15751":34277,"_1713":34508},[],"`services.alerts.smtp_server.*`",{"_8437":327,"_23077":235,"_19595":34510,"_5":23231,"_15751":34277,"_1713":34511},[],"Envío de correo para alertas",{"_8437":328,"_23077":235,"_19595":34513,"_5":23231,"_15751":34281,"_1713":34514},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_8437":329,"_23077":235,"_19595":34516,"_5":23231,"_15751":34281,"_1713":34517},[],"La prueba comprueba al menos:",{"_8437":330,"_23077":235,"_19595":34519,"_5":23231,"_15751":34281,"_1713":34520},[],"salud de `ca`",{"_8437":331,"_23077":235,"_19595":34522,"_5":23231,"_15751":34281,"_1713":34523},[],"salud de `dms-manager`",{"_8437":332,"_23077":235,"_19595":34525,"_5":23231,"_15751":34281,"_1713":34526},[],"salud de `device-manager`",{"_8437":333,"_23077":235,"_19595":34528,"_5":23231,"_15751":34281,"_1713":34529},[],"salud de `va`",{"_8437":334,"_23077":235,"_19595":34531,"_5":23231,"_15751":34281,"_1713":34532},[],"respuesta HTML esperada del servicio `ui`",{"_8437":335,"_23077":235,"_19595":34534,"_5":23231,"_15751":34285,"_1713":34535},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_8437":336,"_23077":235,"_19595":34537,"_5":23231,"_15751":34285,"_1713":34538},[],"`charts/lamassu`: chart principal de Lamassu",{"_8437":337,"_23077":235,"_19595":34540,"_5":23231,"_15751":34285,"_1713":34541},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_8437":338,"_23077":235,"_19595":34543,"_5":23231,"_15751":34285,"_1713":34544},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_8437":339,"_23077":235,"_19595":34546,"_5":23231,"_15751":34289,"_1713":34547},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_8437":340,"_23077":235,"_19595":34549,"_5":23231,"_15751":34293,"_1713":34550},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_8437":341,"_23077":341,"_5":23226,"_1713":34552,"_23239":34553,"_19595":34554,"_15751":341},"SaaS · Suscripción",[33545,33546,33604],[],{"_8437":342,"_23077":341,"_19595":34556,"_5":23231,"_15751":341,"_1713":34557},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_8437":343,"_23077":341,"_5":23236,"_19595":34559,"_15751":34560,"_1713":34561},[],"/docs/pr-preview/pr-25/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_8437":344,"_23077":341,"_5":23236,"_19595":34563,"_15751":34564,"_1713":34565},[],"/docs/pr-preview/pr-25/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_8437":345,"_23077":341,"_5":23236,"_19595":34567,"_15751":34568,"_1713":34569},[],"/docs/pr-preview/pr-25/despliegue/saas#planes-disponibles","Planes disponibles",{"_8437":346,"_23077":341,"_5":23236,"_19595":34571,"_15751":34572,"_1713":34573},[],"/docs/pr-preview/pr-25/despliegue/saas#contacto","Contacto",{"_8437":347,"_23077":341,"_19595":34575,"_5":23231,"_15751":34560,"_1713":34576},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_8437":348,"_23077":341,"_19595":34578,"_5":23231,"_15751":34564,"_1713":34579},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_8437":349,"_23077":341,"_19595":34581,"_5":23231,"_15751":34564,"_1713":34582},[],"Alta disponibilidad y backups automáticos",{"_8437":350,"_23077":341,"_19595":34584,"_5":23231,"_15751":34564,"_1713":34585},[],"Actualizaciones automáticas a las últimas versiones",{"_8437":351,"_23077":341,"_19595":34587,"_5":23231,"_15751":34564,"_1713":34588},[],"Soporte técnico incluido",{"_8437":352,"_23077":341,"_19595":34590,"_5":23231,"_15751":34564,"_1713":34591},[],"SLA garantizado",{"_8437":353,"_23077":341,"_19595":34593,"_5":23231,"_15751":34568,"_1713":34594},[],"Plan",{"_8437":354,"_23077":341,"_19595":34596,"_5":23231,"_15751":34568,"_1713":34597},[],"Dispositivos",{"_8437":355,"_23077":341,"_19595":34599,"_5":23231,"_15751":34568,"_1713":34600},[],"Soporte",{"_8437":356,"_23077":341,"_19595":34602,"_5":23231,"_15751":34568,"_1713":34603},[],"SLA",{"_8437":357,"_23077":341,"_19595":34605,"_5":23231,"_15751":34568,"_1713":34606},[],"Starter",{"_8437":358,"_23077":341,"_19595":34608,"_5":23231,"_15751":34568,"_1713":34609},[],"Hasta 1.000",{"_8437":359,"_23077":341,"_19595":34611,"_5":23231,"_15751":34568,"_1713":34612},[],"Email",{"_8437":360,"_23077":341,"_19595":34614,"_5":23231,"_15751":34568,"_1713":34615},[],"99,5%",{"_8437":361,"_23077":341,"_19595":34617,"_5":23231,"_15751":34568,"_1713":34618},[],"Professional",{"_8437":362,"_23077":341,"_19595":34620,"_5":23231,"_15751":34568,"_1713":34621},[],"Hasta 10.000",{"_8437":363,"_23077":341,"_19595":34623,"_5":23231,"_15751":34568,"_1713":34624},[],"Email + Chat",{"_8437":364,"_23077":341,"_19595":34626,"_5":23231,"_15751":34568,"_1713":34627},[],"99,9%",{"_8437":365,"_23077":341,"_19595":34629,"_5":23231,"_15751":34568,"_1713":34630},[],"Enterprise",{"_8437":366,"_23077":341,"_19595":34632,"_5":23231,"_15751":34568,"_1713":34633},[],"Ilimitado",{"_8437":367,"_23077":341,"_19595":34635,"_5":23231,"_15751":34568,"_1713":34636},[],"Dedicado",{"_8437":368,"_23077":341,"_19595":34638,"_5":23231,"_15751":34568,"_1713":34639},[],"99,99%",{"_8437":369,"_23077":341,"_19595":34641,"_5":23231,"_15751":34572,"_1713":34642},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_8437":370,"_23077":370,"_5":23226,"_1713":34644,"_23239":34645,"_19595":34646,"_15751":370},"Manual de Usuario",[33545,34644],[],{"_8437":371,"_23077":370,"_19595":34648,"_5":23231,"_15751":370,"_1713":34649},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_8437":372,"_23077":370,"_5":23236,"_19595":34651,"_15751":34652,"_1713":34653},[],"/docs/pr-preview/pr-25/manual#servicios-core","Servicios Core",{"_8437":373,"_23077":370,"_5":23236,"_19595":34655,"_15751":34656,"_1713":34657},[],"/docs/pr-preview/pr-25/manual#integraciones-con-terceros","Integraciones con terceros",{"_8437":374,"_23077":370,"_19595":34659,"_5":23231,"_15751":370,"_1713":34660},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_8437":375,"_23077":370,"_19595":34662,"_5":23231,"_15751":34652,"_1713":34663},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_8437":376,"_23077":370,"_19595":34665,"_5":23231,"_15751":34652,"_1713":34666},[],"<Card title=\"Criptografía post-cuántica (LamassuQ)\" description=\"Tipos de clave post-cuánticos, variantes compuestas, modo PURE y motores compatibles\" href=\"/docs/manual/servicios-core/lamassuq\" />",{"_8437":377,"_23077":370,"_19595":34668,"_5":23231,"_15751":34652,"_1713":34669},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_8437":378,"_23077":370,"_19595":34671,"_5":23231,"_15751":34652,"_1713":34672},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_8437":379,"_23077":370,"_19595":34674,"_5":23231,"_15751":34652,"_1713":34675},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_8437":380,"_23077":370,"_19595":34677,"_5":23231,"_15751":34652,"_1713":34678},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_8437":381,"_23077":370,"_19595":34680,"_5":23231,"_15751":34652,"_1713":34681},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_8437":382,"_23077":370,"_19595":34683,"_5":23231,"_15751":34652,"_1713":34684},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_8437":383,"_23077":370,"_19595":34686,"_5":23231,"_15751":34656,"_1713":34687},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_8437":384,"_23077":384,"_5":23226,"_1713":34689,"_23239":34690,"_19595":34691,"_15751":384},"Integración con AWS IoT Core",[33545,34644,34657],[],{"_8437":385,"_23077":384,"_19595":34693,"_5":23231,"_15751":384,"_1713":34694},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_8437":386,"_23077":384,"_5":23236,"_19595":34696,"_15751":34697,"_1713":34698},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_8437":387,"_23077":384,"_5":23236,"_19595":34700,"_15751":34701,"_1713":34702},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_8437":388,"_23077":384,"_5":23236,"_19595":34704,"_15751":34705,"_1713":34706},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_8437":389,"_23077":384,"_5":23236,"_19595":34708,"_15751":34709,"_1713":34710},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_8437":390,"_23077":384,"_5":23236,"_19595":34712,"_15751":34713,"_1713":34714},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_8437":391,"_23077":384,"_5":23236,"_19595":34716,"_15751":34717,"_1713":34718},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_8437":392,"_23077":384,"_5":23236,"_19595":34720,"_15751":34721,"_1713":34722},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#primary-account","Primary Account",{"_8437":393,"_23077":384,"_5":23236,"_19595":34724,"_15751":34725,"_1713":34726},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_8437":394,"_23077":384,"_5":23236,"_19595":34728,"_15751":34729,"_1713":34730},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_8437":395,"_23077":384,"_5":23236,"_19595":34732,"_15751":34733,"_1713":34734},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-none","Modo `none`",{"_8437":396,"_23077":384,"_5":23236,"_19595":34736,"_15751":34737,"_1713":34738},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-auto","Modo `auto`",{"_8437":397,"_23077":384,"_5":23236,"_19595":34740,"_15751":34741,"_1713":34742},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_8437":398,"_23077":384,"_5":23236,"_19595":34744,"_15751":34745,"_1713":34746},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_8437":399,"_23077":384,"_5":23236,"_19595":34748,"_15751":34749,"_1713":34750},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_8437":400,"_23077":384,"_5":23236,"_19595":34752,"_15751":34753,"_1713":34754},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_8437":401,"_23077":384,"_5":23236,"_19595":34756,"_15751":34757,"_1713":34758},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_8437":402,"_23077":384,"_5":23236,"_19595":34760,"_15751":34761,"_1713":34762},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_8437":403,"_23077":384,"_5":23236,"_19595":34764,"_15751":34765,"_1713":34766},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_8437":404,"_23077":384,"_5":23236,"_19595":34768,"_15751":34769,"_1713":34770},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_8437":405,"_23077":384,"_5":23236,"_19595":34772,"_15751":34773,"_1713":34774},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_8437":406,"_23077":384,"_19595":34776,"_5":23231,"_15751":384,"_1713":34777},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_8437":407,"_23077":384,"_19595":34779,"_5":23231,"_15751":384,"_1713":34780},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_8437":408,"_23077":384,"_19595":34782,"_5":23231,"_15751":384,"_1713":34783},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_8437":409,"_23077":384,"_19595":34785,"_5":23231,"_15751":34697,"_1713":34786},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_8437":410,"_23077":384,"_19595":34788,"_5":23231,"_15751":34697,"_1713":34789},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_8437":411,"_23077":384,"_19595":34791,"_5":23231,"_15751":34697,"_1713":34792},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_8437":412,"_23077":384,"_19595":34794,"_5":23231,"_15751":34697,"_1713":34795},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_8437":413,"_23077":384,"_19595":34797,"_5":23231,"_15751":34701,"_1713":34798},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_8437":414,"_23077":384,"_19595":34800,"_5":23231,"_15751":34705,"_1713":34801},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_8437":415,"_23077":384,"_19595":34803,"_5":23231,"_15751":34705,"_1713":34804},[],"Acción IAM",{"_8437":416,"_23077":384,"_19595":34806,"_5":23231,"_15751":34705,"_1713":34807},[],"Propósito",{"_8437":417,"_23077":384,"_19595":34809,"_5":23231,"_15751":34705,"_1713":34810},[],"`iot:GetRegistrationCode`",{"_8437":418,"_23077":384,"_19595":34812,"_5":23231,"_15751":34705,"_1713":34813},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_8437":419,"_23077":384,"_19595":34815,"_5":23231,"_15751":34705,"_1713":34816},[],"`iot:RegisterCACertificate`",{"_8437":420,"_23077":384,"_19595":34818,"_5":23231,"_15751":34705,"_1713":34819},[],"Registrar la CA en AWS IoT",{"_8437":421,"_23077":384,"_19595":34821,"_5":23231,"_15751":34705,"_1713":34822},[],"`iot:DescribeCACertificate`",{"_8437":422,"_23077":384,"_19595":34824,"_5":23231,"_15751":34705,"_1713":34825},[],"Consultar el estado del registro de la CA",{"_8437":423,"_23077":384,"_19595":34827,"_5":23231,"_15751":34705,"_1713":34828},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_8437":424,"_23077":384,"_19595":34830,"_5":23231,"_15751":34705,"_1713":34831},[],"Crear o actualizar Things en IoT Core",{"_8437":425,"_23077":384,"_19595":34833,"_5":23231,"_15751":34705,"_1713":34834},[],"`iot:RegisterThing`",{"_8437":426,"_23077":384,"_19595":34836,"_5":23231,"_15751":34705,"_1713":34837},[],"Aprovisionar Things mediante plantilla",{"_8437":427,"_23077":384,"_19595":34839,"_5":23231,"_15751":34705,"_1713":34840},[],"`iot:RegisterCertificate`",{"_8437":428,"_23077":384,"_19595":34842,"_5":23231,"_15751":34705,"_1713":34843},[],"Registrar certificados de dispositivo",{"_8437":429,"_23077":384,"_19595":34845,"_5":23231,"_15751":34705,"_1713":34846},[],"`iot:UpdateCertificate`",{"_8437":430,"_23077":384,"_19595":34848,"_5":23231,"_15751":34705,"_1713":34849},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_8437":431,"_23077":384,"_19595":34851,"_5":23231,"_15751":34705,"_1713":34852},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_8437":432,"_23077":384,"_19595":34854,"_5":23231,"_15751":34705,"_1713":34855},[],"Crear y adjuntar políticas IoT",{"_8437":433,"_23077":384,"_19595":34857,"_5":23231,"_15751":34705,"_1713":34858},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_8437":434,"_23077":384,"_19595":34860,"_5":23231,"_15751":34705,"_1713":34861},[],"Gestionar grupos de Things",{"_8437":435,"_23077":384,"_19595":34863,"_5":23231,"_15751":34705,"_1713":34864},[],"`iot:CreateProvisioningTemplate`",{"_8437":436,"_23077":384,"_19595":34866,"_5":23231,"_15751":34705,"_1713":34867},[],"Crear plantillas JITP",{"_8437":437,"_23077":384,"_19595":34869,"_5":23231,"_15751":34705,"_1713":34870},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_8437":438,"_23077":384,"_19595":34872,"_5":23231,"_15751":34705,"_1713":34873},[],"Leer y escribir el Device Shadow",{"_8437":439,"_23077":384,"_19595":34875,"_5":23231,"_15751":34705,"_1713":34876},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_8437":440,"_23077":384,"_19595":34878,"_5":23231,"_15751":34709,"_1713":34879},[],"Parámetro",{"_8437":441,"_23077":384,"_19595":34881,"_5":23231,"_15751":34709,"_1713":34882},[],"Tipo",{"_8437":442,"_23077":384,"_19595":34884,"_5":23231,"_15751":34709,"_1713":34885},[],"Requerido",{"_8437":443,"_23077":384,"_19595":34887,"_5":23231,"_15751":34709,"_1713":33748},[],{"_8437":444,"_23077":384,"_19595":34889,"_5":23231,"_15751":34709,"_1713":34890},[],"`connector_id`",{"_8437":445,"_23077":384,"_19595":34892,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":446,"_23077":384,"_19595":34894,"_5":23231,"_15751":34709,"_1713":34895},[],"Sí",{"_8437":447,"_23077":384,"_19595":34897,"_5":23231,"_15751":34709,"_1713":34898},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_8437":448,"_23077":384,"_19595":34900,"_5":23231,"_15751":34709,"_1713":34901},[],"`aws_config.region`",{"_8437":449,"_23077":384,"_19595":34903,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":450,"_23077":384,"_19595":34905,"_5":23231,"_15751":34709,"_1713":34895},[],{"_8437":451,"_23077":384,"_19595":34907,"_5":23231,"_15751":34709,"_1713":34908},[],"Región AWS donde opera el conector.",{"_8437":452,"_23077":384,"_19595":34910,"_5":23231,"_15751":34709,"_1713":34911},[],"`aws_config.auth_method`",{"_8437":453,"_23077":384,"_19595":34913,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":454,"_23077":384,"_19595":34915,"_5":23231,"_15751":34709,"_1713":34895},[],{"_8437":455,"_23077":384,"_19595":34917,"_5":23231,"_15751":34709,"_1713":34918},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_8437":456,"_23077":384,"_19595":34920,"_5":23231,"_15751":34709,"_1713":34921},[],"`aws_config.access_key_id`",{"_8437":457,"_23077":384,"_19595":34923,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":458,"_23077":384,"_19595":34925,"_5":23231,"_15751":34709,"_1713":34926},[],"Solo con `auth_method=static`",{"_8437":459,"_23077":384,"_19595":34928,"_5":23231,"_15751":34709,"_1713":34929},[],"Clave de acceso AWS.",{"_8437":460,"_23077":384,"_19595":34931,"_5":23231,"_15751":34709,"_1713":34932},[],"`aws_config.secret_access_key`",{"_8437":461,"_23077":384,"_19595":34934,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":462,"_23077":384,"_19595":34936,"_5":23231,"_15751":34709,"_1713":34926},[],{"_8437":463,"_23077":384,"_19595":34938,"_5":23231,"_15751":34709,"_1713":34939},[],"Clave secreta AWS.",{"_8437":464,"_23077":384,"_19595":34941,"_5":23231,"_15751":34709,"_1713":34942},[],"`aws_config.session_token`",{"_8437":465,"_23077":384,"_19595":34944,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":466,"_23077":384,"_19595":34946,"_5":23231,"_15751":34709,"_1713":34947},[],"No",{"_8437":467,"_23077":384,"_19595":34949,"_5":23231,"_15751":34709,"_1713":34950},[],"Token de sesión (con `auth_method=static`).",{"_8437":468,"_23077":384,"_19595":34952,"_5":23231,"_15751":34709,"_1713":34953},[],"`aws_config.role_arn`",{"_8437":469,"_23077":384,"_19595":34955,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":470,"_23077":384,"_19595":34957,"_5":23231,"_15751":34709,"_1713":34958},[],"Solo con `auth_method=role`",{"_8437":471,"_23077":384,"_19595":34960,"_5":23231,"_15751":34709,"_1713":34961},[],"ARN del rol a asumir.",{"_8437":472,"_23077":384,"_19595":34963,"_5":23231,"_15751":34709,"_1713":34964},[],"`aws_config.endpoint_url`",{"_8437":473,"_23077":384,"_19595":34966,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":474,"_23077":384,"_19595":34968,"_5":23231,"_15751":34709,"_1713":34947},[],{"_8437":475,"_23077":384,"_19595":34970,"_5":23231,"_15751":34709,"_1713":34971},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_8437":476,"_23077":384,"_19595":34973,"_5":23231,"_15751":34709,"_1713":34974},[],"`subscriber_event_bus`",{"_8437":477,"_23077":384,"_19595":34976,"_5":23231,"_15751":34709,"_1713":19901},[],{"_8437":478,"_23077":384,"_19595":34978,"_5":23231,"_15751":34709,"_1713":34895},[],{"_8437":479,"_23077":384,"_19595":34980,"_5":23231,"_15751":34709,"_1713":34981},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_8437":480,"_23077":384,"_19595":34983,"_5":23231,"_15751":34709,"_1713":34984},[],"`dms_manager_client`",{"_8437":481,"_23077":384,"_19595":34986,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":482,"_23077":384,"_19595":34988,"_5":23231,"_15751":34709,"_1713":34895},[],{"_8437":483,"_23077":384,"_19595":34990,"_5":23231,"_15751":34709,"_1713":34991},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_8437":484,"_23077":384,"_19595":34993,"_5":23231,"_15751":34709,"_1713":34994},[],"`device_manager_client`",{"_8437":485,"_23077":384,"_19595":34996,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":486,"_23077":384,"_19595":34998,"_5":23231,"_15751":34709,"_1713":34895},[],{"_8437":487,"_23077":384,"_19595":35000,"_5":23231,"_15751":34709,"_1713":35001},[],"URL HTTP del Device Manager de Lamassu.",{"_8437":488,"_23077":384,"_19595":35003,"_5":23231,"_15751":34709,"_1713":35004},[],"`ca_client`",{"_8437":489,"_23077":384,"_19595":35006,"_5":23231,"_15751":34709,"_1713":12095},[],{"_8437":490,"_23077":384,"_19595":35008,"_5":23231,"_15751":34709,"_1713":34895},[],{"_8437":491,"_23077":384,"_19595":35010,"_5":23231,"_15751":34709,"_1713":35011},[],"URL HTTP del servicio de CA de Lamassu.",{"_8437":492,"_23077":384,"_19595":35013,"_5":23231,"_15751":34713,"_1713":35014},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_8437":493,"_23077":384,"_19595":35016,"_5":23231,"_15751":34717,"_1713":35017},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_8437":494,"_23077":384,"_19595":35019,"_5":23231,"_15751":34717,"_1713":35020},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_8437":495,"_23077":384,"_19595":35022,"_5":23231,"_15751":34721,"_1713":35023},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_8437":496,"_23077":384,"_19595":35025,"_5":23231,"_15751":34721,"_1713":35026},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_8437":497,"_23077":384,"_19595":35028,"_5":23231,"_15751":34721,"_1713":35029},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_8437":498,"_23077":384,"_19595":35031,"_5":23231,"_15751":34721,"_1713":35032},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_8437":499,"_23077":384,"_19595":35034,"_5":23231,"_15751":34721,"_1713":35035},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_8437":500,"_23077":384,"_19595":35037,"_5":23231,"_15751":34721,"_1713":35038},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_8437":501,"_23077":384,"_19595":35040,"_5":23231,"_15751":34725,"_1713":35041},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_8437":502,"_23077":384,"_19595":35043,"_5":23231,"_15751":34729,"_1713":35044},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_8437":503,"_23077":384,"_19595":35046,"_5":23231,"_15751":34729,"_1713":35047},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_8437":504,"_23077":384,"_19595":35049,"_5":23231,"_15751":34733,"_1713":35050},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_8437":505,"_23077":384,"_19595":35052,"_5":23231,"_15751":34737,"_1713":35053},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_8437":506,"_23077":384,"_19595":35055,"_5":23231,"_15751":34737,"_1713":35056},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_8437":507,"_23077":384,"_19595":35058,"_5":23231,"_15751":34737,"_1713":35059},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_8437":508,"_23077":384,"_19595":35061,"_5":23231,"_15751":34737,"_1713":35062},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_8437":509,"_23077":384,"_19595":35064,"_5":23231,"_15751":34737,"_1713":35065},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_8437":510,"_23077":384,"_19595":35067,"_5":23231,"_15751":34737,"_1713":35068},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_8437":511,"_23077":384,"_19595":35070,"_5":23231,"_15751":34741,"_1713":35071},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_8437":512,"_23077":384,"_19595":35073,"_5":23231,"_15751":34741,"_1713":35074},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_8437":513,"_23077":384,"_19595":35076,"_5":23231,"_15751":34741,"_1713":35077},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_8437":514,"_23077":384,"_19595":35079,"_5":23231,"_15751":34745,"_1713":35080},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_8437":515,"_23077":384,"_19595":35082,"_5":23231,"_15751":34745,"_1713":35083},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_8437":516,"_23077":384,"_19595":35085,"_5":23231,"_15751":34745,"_1713":35086},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_8437":517,"_23077":384,"_19595":35088,"_5":23231,"_15751":34749,"_1713":35089},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_8437":518,"_23077":384,"_19595":35091,"_5":23231,"_15751":34749,"_1713":35092},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_8437":519,"_23077":384,"_19595":35094,"_5":23231,"_15751":34749,"_1713":35095},[],"Para que el flujo JITP funcione correctamente:",{"_8437":520,"_23077":384,"_19595":35097,"_5":23231,"_15751":34749,"_1713":35098},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_8437":521,"_23077":384,"_19595":35100,"_5":23231,"_15751":34749,"_1713":35101},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_8437":522,"_23077":384,"_19595":35103,"_5":23231,"_15751":34749,"_1713":35104},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_8437":523,"_23077":384,"_19595":35106,"_5":23231,"_15751":34749,"_1713":35107},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_8437":524,"_23077":384,"_19595":35109,"_5":23231,"_15751":34753,"_1713":35110},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_8437":525,"_23077":384,"_19595":35112,"_5":23231,"_15751":34753,"_1713":35113},[],"Estado en Lamassu",{"_8437":526,"_23077":384,"_19595":35115,"_5":23231,"_15751":34753,"_1713":35116},[],"Razón de revocación",{"_8437":527,"_23077":384,"_19595":35118,"_5":23231,"_15751":34753,"_1713":35119},[],"Estado en AWS IoT Core",{"_8437":528,"_23077":384,"_19595":35121,"_5":23231,"_15751":34753,"_1713":35122},[],"`Active`",{"_8437":529,"_23077":384,"_19595":35124,"_5":23231,"_15751":34753,"_1713":35125},[],"—",{"_8437":530,"_23077":384,"_19595":35127,"_5":23231,"_15751":34753,"_1713":35128},[],"`ACTIVE`",{"_8437":531,"_23077":384,"_19595":35130,"_5":23231,"_15751":34753,"_1713":35131},[],"`Revoked`",{"_8437":532,"_23077":384,"_19595":35133,"_5":23231,"_15751":34753,"_1713":35134},[],"`certificateHold`",{"_8437":533,"_23077":384,"_19595":35136,"_5":23231,"_15751":34753,"_1713":35137},[],"`INACTIVE`",{"_8437":534,"_23077":384,"_19595":35139,"_5":23231,"_15751":34753,"_1713":35131},[],{"_8437":535,"_23077":384,"_19595":35141,"_5":23231,"_15751":34753,"_1713":35142},[],"Cualquier otra razón",{"_8437":536,"_23077":384,"_19595":35144,"_5":23231,"_15751":34753,"_1713":35145},[],"`REVOKED`",{"_8437":537,"_23077":384,"_19595":35147,"_5":23231,"_15751":34753,"_1713":35148},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_8437":538,"_23077":384,"_19595":35150,"_5":23231,"_15751":34757,"_1713":35151},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_8437":539,"_23077":384,"_19595":35153,"_5":23231,"_15751":34757,"_1713":35154},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_8437":540,"_23077":384,"_19595":35156,"_5":23231,"_15751":34757,"_1713":35157},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_8437":541,"_23077":384,"_19595":35159,"_5":23231,"_15751":34761,"_1713":35160},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_8437":542,"_23077":384,"_19595":35162,"_5":23231,"_15751":34761,"_1713":35163},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_8437":543,"_23077":384,"_19595":35165,"_5":23231,"_15751":34765,"_1713":35166},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_8437":544,"_23077":384,"_19595":35168,"_5":23231,"_15751":34765,"_1713":35169},[],"Existen dos tipos de acciones:",{"_8437":545,"_23077":384,"_19595":35171,"_5":23231,"_15751":34765,"_1713":35172},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_8437":546,"_23077":384,"_19595":35174,"_5":23231,"_15751":34765,"_1713":35175},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_8437":547,"_23077":384,"_19595":35177,"_5":23231,"_15751":34765,"_1713":35178},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_8437":548,"_23077":384,"_19595":35180,"_5":23231,"_15751":34769,"_1713":35181},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_8437":549,"_23077":384,"_19595":35183,"_5":23231,"_15751":34769,"_1713":35184},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_8437":550,"_23077":384,"_19595":35186,"_5":23231,"_15751":34769,"_1713":35187},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_8437":551,"_23077":384,"_19595":35189,"_5":23231,"_15751":34773,"_1713":35190},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_8437":552,"_23077":384,"_19595":35192,"_5":23231,"_15751":34773,"_1713":35193},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_8437":553,"_23077":384,"_19595":35195,"_5":23231,"_15751":34773,"_1713":35196},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_8437":554,"_23077":384,"_19595":35198,"_5":23231,"_15751":34773,"_1713":35199},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_8437":555,"_23077":384,"_19595":35201,"_5":23231,"_15751":34773,"_1713":35202},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_8437":556,"_23077":384,"_19595":35204,"_5":23231,"_15751":34773,"_1713":35205},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_8437":557,"_23077":384,"_19595":35207,"_5":23231,"_15751":34773,"_1713":35208},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_8437":558,"_23077":384,"_19595":35210,"_5":23231,"_15751":34773,"_1713":35211},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_8437":559,"_23077":384,"_19595":35213,"_5":23231,"_15751":34773,"_1713":35214},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_8437":560,"_23077":384,"_19595":35216,"_5":23231,"_15751":34773,"_1713":35217},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_8437":561,"_23077":384,"_19595":35219,"_5":23231,"_15751":34773,"_1713":35220},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_8437":562,"_23077":384,"_19595":35222,"_5":23231,"_15751":34773,"_1713":35223},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_8437":563,"_23077":384,"_19595":35225,"_5":23231,"_15751":34773,"_1713":35226},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_8437":564,"_23077":384,"_19595":35228,"_5":23231,"_15751":34773,"_1713":35229},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_8437":565,"_23077":384,"_19595":35231,"_5":23231,"_15751":34773,"_1713":35232},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_8437":566,"_23077":384,"_19595":35234,"_5":23231,"_15751":34773,"_1713":35235},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_8437":567,"_23077":384,"_19595":35237,"_5":23231,"_15751":34773,"_1713":35238},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_8437":568,"_23077":384,"_19595":35240,"_5":23231,"_15751":34773,"_1713":35241},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_8437":569,"_23077":384,"_19595":35243,"_5":23231,"_15751":34773,"_1713":35244},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_8437":570,"_23077":384,"_19595":35246,"_5":23231,"_15751":34773,"_1713":35247},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_8437":571,"_23077":384,"_19595":35249,"_5":23231,"_15751":34773,"_1713":35250},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_8437":572,"_23077":572,"_5":23226,"_1713":35252,"_23239":35253,"_19595":35254,"_15751":572},"[Alerts] Alertas y Suscripciones",[33545,34644,34653],[],{"_8437":573,"_23077":572,"_19595":35256,"_5":23231,"_15751":572,"_1713":35257},[],"Monitorización proactiva mediante eventos y suscripciones",{"_8437":574,"_23077":572,"_5":23236,"_19595":35259,"_15751":35260,"_1713":35261},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#alertas","Alertas",{"_8437":575,"_23077":572,"_5":23236,"_19595":35263,"_15751":35264,"_1713":35265},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_8437":576,"_23077":572,"_5":23236,"_19595":35267,"_15751":35268,"_1713":35269},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_8437":577,"_23077":572,"_5":23236,"_19595":35271,"_15751":35272,"_1713":35273},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_8437":578,"_23077":572,"_5":23236,"_19595":35275,"_15751":35276,"_1713":35277},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_8437":579,"_23077":572,"_5":23236,"_19595":35279,"_15751":35280,"_1713":35281},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_8437":580,"_23077":572,"_5":23236,"_19595":35283,"_15751":35284,"_1713":35285},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_8437":581,"_23077":572,"_19595":35287,"_5":23231,"_15751":35260,"_1713":35288},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_8437":582,"_23077":572,"_19595":35290,"_5":23231,"_15751":35264,"_1713":35291},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_8437":583,"_23077":572,"_19595":35293,"_5":23231,"_15751":35264,"_1713":35294},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_8437":584,"_23077":572,"_19595":35296,"_5":23231,"_15751":35264,"_1713":35297},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_8437":585,"_23077":572,"_19595":35299,"_5":23231,"_15751":35264,"_1713":35300},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_8437":586,"_23077":572,"_19595":35302,"_5":23231,"_15751":35264,"_1713":35303},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_8437":587,"_23077":572,"_19595":35305,"_5":23231,"_15751":35264,"_1713":35306},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_8437":588,"_23077":572,"_19595":35308,"_5":23231,"_15751":35268,"_1713":35309},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_8437":589,"_23077":572,"_19595":35311,"_5":23231,"_15751":35268,"_1713":35312},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_8437":590,"_23077":572,"_19595":35314,"_5":23231,"_15751":35268,"_1713":35315},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_8437":591,"_23077":572,"_19595":35317,"_5":23231,"_15751":35268,"_1713":35318},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_8437":592,"_23077":572,"_19595":35320,"_5":23231,"_15751":35268,"_1713":35321},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_8437":593,"_23077":572,"_19595":35323,"_5":23231,"_15751":35272,"_1713":35324},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_8437":594,"_23077":572,"_19595":35326,"_5":23231,"_15751":35272,"_1713":35327},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_8437":595,"_23077":572,"_19595":35329,"_5":23231,"_15751":35272,"_1713":35330},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_8437":596,"_23077":572,"_19595":35332,"_5":23231,"_15751":35272,"_1713":35333},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_8437":597,"_23077":572,"_19595":35335,"_5":23231,"_15751":35272,"_1713":35336},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_8437":598,"_23077":572,"_19595":35338,"_5":23231,"_15751":35276,"_1713":35339},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_8437":599,"_23077":572,"_19595":35341,"_5":23231,"_15751":35276,"_1713":35342},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_8437":600,"_23077":572,"_19595":35344,"_5":23231,"_15751":35280,"_1713":35345},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_8437":601,"_23077":572,"_19595":35347,"_5":23231,"_15751":35280,"_1713":35348},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_8437":602,"_23077":572,"_19595":35350,"_5":23231,"_15751":35280,"_1713":35351},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_8437":603,"_23077":572,"_19595":35353,"_5":23231,"_15751":35280,"_1713":35354},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_8437":604,"_23077":572,"_19595":35356,"_5":23231,"_15751":35284,"_1713":35357},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_8437":605,"_23077":572,"_19595":35359,"_5":23231,"_15751":35284,"_1713":35360},[],"Evento",{"_8437":606,"_23077":572,"_19595":35362,"_5":23231,"_15751":35284,"_1713":33748},[],{"_8437":607,"_23077":572,"_19595":35364,"_5":23231,"_15751":35284,"_1713":35365},[],"**ca.create**",{"_8437":608,"_23077":572,"_19595":35367,"_5":23231,"_15751":35284,"_1713":35368},[],"Creación de una CA",{"_8437":609,"_23077":572,"_19595":35370,"_5":23231,"_15751":35284,"_1713":35371},[],"**ca.import**",{"_8437":610,"_23077":572,"_19595":35373,"_5":23231,"_15751":35284,"_1713":35374},[],"Importación de una CA",{"_8437":611,"_23077":572,"_19595":35376,"_5":23231,"_15751":35284,"_1713":35377},[],"**ca.profile.update**",{"_8437":612,"_23077":572,"_19595":35379,"_5":23231,"_15751":35284,"_1713":35380},[],"Actualización de perfil de CA",{"_8437":613,"_23077":572,"_19595":35382,"_5":23231,"_15751":35284,"_1713":35383},[],"**ca.reissue**",{"_8437":614,"_23077":572,"_19595":35385,"_5":23231,"_15751":35284,"_1713":35386},[],"Reemisión de una CA",{"_8437":615,"_23077":572,"_19595":35388,"_5":23231,"_15751":35284,"_1713":35389},[],"**ca.sign.certificate**",{"_8437":616,"_23077":572,"_19595":35391,"_5":23231,"_15751":35284,"_1713":35392},[],"Firma / emisión de certificado",{"_8437":617,"_23077":572,"_19595":35394,"_5":23231,"_15751":35284,"_1713":35395},[],"**ca.signature.sign**",{"_8437":618,"_23077":572,"_19595":35397,"_5":23231,"_15751":35284,"_1713":35398},[],"Operación de firma criptográfica",{"_8437":619,"_23077":572,"_19595":35400,"_5":23231,"_15751":35284,"_1713":35401},[],"**ca.delete**",{"_8437":620,"_23077":572,"_19595":35403,"_5":23231,"_15751":35284,"_1713":35404},[],"Eliminación de una CA",{"_8437":621,"_23077":572,"_19595":35406,"_5":23231,"_15751":35284,"_1713":35407},[],"**certificate.delete**",{"_8437":622,"_23077":572,"_19595":35409,"_5":23231,"_15751":35284,"_1713":35410},[],"Eliminación de un certificado",{"_8437":623,"_23077":572,"_19595":35412,"_5":23231,"_15751":35284,"_1713":35413},[],"**profile.create**",{"_8437":624,"_23077":572,"_19595":35415,"_5":23231,"_15751":35284,"_1713":35416},[],"Creación de perfil de emisión",{"_8437":625,"_23077":572,"_19595":35418,"_5":23231,"_15751":35284,"_1713":35419},[],"**profile.update**",{"_8437":626,"_23077":572,"_19595":35421,"_5":23231,"_15751":35284,"_1713":35422},[],"Actualización de perfil de emisión",{"_8437":627,"_23077":572,"_19595":35424,"_5":23231,"_15751":35284,"_1713":35425},[],"**profile.delete**",{"_8437":628,"_23077":572,"_19595":35427,"_5":23231,"_15751":35284,"_1713":35428},[],"Eliminación de perfil de emisión",{"_8437":629,"_23077":572,"_19595":35430,"_5":23231,"_15751":35284,"_1713":35431},[],"**dms.create**",{"_8437":630,"_23077":572,"_19595":35433,"_5":23231,"_15751":35284,"_1713":35434},[],"Creación de un DMS",{"_8437":631,"_23077":572,"_19595":35436,"_5":23231,"_15751":35284,"_1713":35437},[],"**dms.update**",{"_8437":632,"_23077":572,"_19595":35439,"_5":23231,"_15751":35284,"_1713":35440},[],"Actualización de un DMS",{"_8437":633,"_23077":572,"_19595":35442,"_5":23231,"_15751":35284,"_1713":35443},[],"**dms.delete**",{"_8437":634,"_23077":572,"_19595":35445,"_5":23231,"_15751":35284,"_1713":35446},[],"Eliminación de un DMS",{"_8437":635,"_23077":572,"_19595":35448,"_5":23231,"_15751":35284,"_1713":35449},[],"**dms.enroll**",{"_8437":636,"_23077":572,"_19595":35451,"_5":23231,"_15751":35284,"_1713":35452},[],"Inscripción (enroll) de dispositivo",{"_8437":637,"_23077":572,"_19595":35454,"_5":23231,"_15751":35284,"_1713":35455},[],"**dms.reenroll**",{"_8437":638,"_23077":572,"_19595":35457,"_5":23231,"_15751":35284,"_1713":35458},[],"Re-inscripción (reenroll) de dispositivo",{"_8437":639,"_23077":572,"_19595":35460,"_5":23231,"_15751":35284,"_1713":35461},[],"**dms.bind-device-id**",{"_8437":640,"_23077":572,"_19595":35463,"_5":23231,"_15751":35284,"_1713":35464},[],"Asociación de identidad a dispositivo",{"_8437":641,"_23077":572,"_19595":35466,"_5":23231,"_15751":35284,"_1713":35467},[],"**device.create**",{"_8437":642,"_23077":572,"_19595":35469,"_5":23231,"_15751":35284,"_1713":35470},[],"Creación de dispositivo",{"_8437":643,"_23077":572,"_19595":35472,"_5":23231,"_15751":35284,"_1713":35473},[],"**device.identity.update**",{"_8437":644,"_23077":572,"_19595":35475,"_5":23231,"_15751":35284,"_1713":35476},[],"Actualización de identidad del dispositivo",{"_8437":645,"_23077":572,"_19595":35478,"_5":23231,"_15751":35284,"_1713":35479},[],"**device.status.update**",{"_8437":646,"_23077":572,"_19595":35481,"_5":23231,"_15751":35284,"_1713":35482},[],"Cambio de estado del dispositivo",{"_8437":647,"_23077":572,"_19595":35484,"_5":23231,"_15751":35284,"_1713":35485},[],"**device.metadata.update**",{"_8437":648,"_23077":572,"_19595":35487,"_5":23231,"_15751":35284,"_1713":35488},[],"Actualización de metadatos del dispositivo",{"_8437":649,"_23077":572,"_19595":35490,"_5":23231,"_15751":35284,"_1713":35491},[],"**device.delete**",{"_8437":650,"_23077":572,"_19595":35493,"_5":23231,"_15751":35284,"_1713":35494},[],"Eliminación de un dispositivo",{"_8437":651,"_23077":572,"_19595":35496,"_5":23231,"_15751":35284,"_1713":35497},[],"**va.role.crl.create**",{"_8437":652,"_23077":572,"_19595":35499,"_5":23231,"_15751":35284,"_1713":35500},[],"Cálculo/creación de CRL",{"_8437":653,"_23077":572,"_19595":35502,"_5":23231,"_15751":35284,"_1713":35503},[],"**kms.create**",{"_8437":654,"_23077":572,"_19595":35505,"_5":23231,"_15751":35284,"_1713":35506},[],"Creación de clave en KMS",{"_8437":655,"_23077":572,"_19595":35508,"_5":23231,"_15751":35284,"_1713":35509},[],"**kms.import**",{"_8437":656,"_23077":572,"_19595":35511,"_5":23231,"_15751":35284,"_1713":35512},[],"Importación de una clave KMS",{"_8437":657,"_23077":572,"_19595":35514,"_5":23231,"_15751":35284,"_1713":35515},[],"**kms.update.metadata**",{"_8437":658,"_23077":572,"_19595":35517,"_5":23231,"_15751":35284,"_1713":35518},[],"Actualización de metadatos de clave KMS",{"_8437":659,"_23077":572,"_19595":35520,"_5":23231,"_15751":35284,"_1713":35521},[],"**kms.update.aliases**",{"_8437":660,"_23077":572,"_19595":35523,"_5":23231,"_15751":35284,"_1713":35524},[],"Actualización de alias de clave KMS",{"_8437":661,"_23077":572,"_19595":35526,"_5":23231,"_15751":35284,"_1713":35527},[],"**kms.update.name**",{"_8437":662,"_23077":572,"_19595":35529,"_5":23231,"_15751":35284,"_1713":35530},[],"Cambio de nombre de una clave KMS",{"_8437":663,"_23077":572,"_19595":35532,"_5":23231,"_15751":35284,"_1713":35533},[],"**kms.update.tags**",{"_8437":664,"_23077":572,"_19595":35535,"_5":23231,"_15751":35284,"_1713":35536},[],"Actualización de etiquetas (tags) de clave KMS",{"_8437":665,"_23077":572,"_19595":35538,"_5":23231,"_15751":35284,"_1713":35539},[],"**kms.delete**",{"_8437":666,"_23077":572,"_19595":35541,"_5":23231,"_15751":35284,"_1713":35542},[],"Eliminación de una clave KMS",{"_8437":667,"_23077":572,"_19595":35544,"_5":23231,"_15751":35284,"_1713":35545},[],"**kms.sign.message**",{"_8437":668,"_23077":572,"_19595":35547,"_5":23231,"_15751":35284,"_1713":35548},[],"Firma de un mensaje con clave KMS",{"_8437":669,"_23077":572,"_19595":35550,"_5":23231,"_15751":35284,"_1713":35551},[],"**kms.verify.signature**",{"_8437":670,"_23077":572,"_19595":35553,"_5":23231,"_15751":35284,"_1713":35554},[],"Verificación de firma con clave KMS",{"_8437":671,"_23077":671,"_5":23226,"_1713":35556,"_23239":35557,"_19595":35558,"_15751":671},"[CA] Gestión de Entidades de Confianza",[33545,34644,34653],[],{"_8437":672,"_23077":671,"_19595":35560,"_5":23231,"_15751":671,"_1713":35561},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_8437":673,"_23077":671,"_5":23236,"_19595":35563,"_15751":35564,"_1713":35565},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_8437":674,"_23077":671,"_5":23236,"_19595":35567,"_15751":35568,"_1713":35569},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_8437":675,"_23077":671,"_5":23236,"_19595":35571,"_15751":35572,"_1713":35573},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_8437":676,"_23077":671,"_5":23236,"_19595":35575,"_15751":35576,"_1713":35577},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_8437":677,"_23077":671,"_5":23236,"_19595":35579,"_15751":35580,"_1713":35581},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_8437":678,"_23077":671,"_5":23236,"_19595":35583,"_15751":35584,"_1713":35585},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_8437":679,"_23077":671,"_5":23236,"_19595":35587,"_15751":35588,"_1713":35589},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_8437":680,"_23077":671,"_5":23236,"_19595":35591,"_15751":35592,"_1713":35593},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_8437":681,"_23077":671,"_5":23236,"_19595":35595,"_15751":35596,"_1713":35597},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_8437":682,"_23077":671,"_19595":35599,"_5":23231,"_15751":35568,"_1713":35600},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_8437":683,"_23077":671,"_19595":35602,"_5":23231,"_15751":35568,"_1713":35603},[],"Actualmente hay disponibles 3 acciones:",{"_8437":684,"_23077":671,"_19595":35605,"_5":23231,"_15751":35568,"_1713":35606},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_8437":685,"_23077":671,"_19595":35608,"_5":23231,"_15751":35568,"_1713":35609},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_8437":686,"_23077":671,"_19595":35611,"_5":23231,"_15751":35568,"_1713":35612},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_8437":687,"_23077":671,"_19595":35614,"_5":23231,"_15751":35572,"_1713":35615},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_8437":688,"_23077":671,"_19595":35617,"_5":23231,"_15751":35572,"_1713":35618},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_8437":689,"_23077":671,"_19595":35620,"_5":23231,"_15751":35572,"_1713":35621},[],"**Motor criptográfico**",{"_8437":690,"_23077":671,"_19595":35623,"_5":23231,"_15751":35572,"_1713":35624},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_8437":691,"_23077":671,"_19595":35626,"_5":23231,"_15751":35572,"_1713":35627},[],"**Ejemplo mostrado:** go1.24.3",{"_8437":692,"_23077":671,"_19595":35629,"_5":23231,"_15751":35572,"_1713":35630},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_8437":693,"_23077":671,"_19595":35632,"_5":23231,"_15751":35572,"_1713":35633},[],"**Parámetros de clave**",{"_8437":694,"_23077":671,"_19595":35635,"_5":23231,"_15751":35572,"_1713":35636},[],"**Key Type:** RSA / EC (Elliptic Curve), ML-DSA, SLH-DSA, Ed25519 y firmas compuestas (Composite ML-DSA)",{"_8437":695,"_23077":671,"_19595":35638,"_5":23231,"_15751":35572,"_1713":35639},[],"**Key Size:**",{"_8437":696,"_23077":671,"_19595":35641,"_5":23231,"_15751":35572,"_1713":35642},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_8437":697,"_23077":671,"_19595":35644,"_5":23231,"_15751":35572,"_1713":35645},[],"EC: P-256, P-384, P-521",{"_8437":698,"_23077":671,"_19595":35647,"_5":23231,"_15751":35572,"_1713":35648},[],"ML-DSA: 44, 65 o 87",{"_8437":699,"_23077":671,"_19595":35650,"_5":23231,"_15751":35572,"_1713":35651},[],"SLH-DSA: parámetro 1 a 12",{"_8437":700,"_23077":671,"_19595":35653,"_5":23231,"_15751":35572,"_1713":35654},[],"Ed25519: 256",{"_8437":701,"_23077":671,"_19595":35656,"_5":23231,"_15751":35572,"_1713":35657},[],"Composite ML-DSA: variante 1 a 15",{"_8437":702,"_23077":671,"_19595":35659,"_5":23231,"_15751":35572,"_1713":35660},[],"**Recomendado:** EC P-384",{"_8437":703,"_23077":671,"_19595":35662,"_5":23231,"_15751":35572,"_1713":35663},[],"Los tipos de clave disponibles dependen del motor criptográfico seleccionado: los tipos post-cuánticos, Ed25519 y las firmas compuestas solo los soportan el motor software y el motor File System. Consulte Criptografía post-cuántica (LamassuQ) para el detalle de variantes y motores.",{"_8437":704,"_23077":671,"_19595":35665,"_5":23231,"_15751":35572,"_1713":35666},[],"**Perfil de emisión del certificado de la CA**",{"_8437":705,"_23077":671,"_19595":35668,"_5":23231,"_15751":35572,"_1713":35669},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_8437":706,"_23077":671,"_19595":35671,"_5":23231,"_15751":35572,"_1713":35672},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_8437":707,"_23077":671,"_19595":35674,"_5":23231,"_15751":35572,"_1713":35675},[],"**Configuración de la CA**",{"_8437":708,"_23077":671,"_19595":35677,"_5":23231,"_15751":35572,"_1713":35678},[],"**Tipo de CA**",{"_8437":709,"_23077":671,"_19595":35680,"_5":23231,"_15751":35572,"_1713":35681},[],"**Root CA:** Autoridad raíz autofirmada",{"_8437":710,"_23077":671,"_19595":35683,"_5":23231,"_15751":35572,"_1713":35684},[],"**Intermediate CA:** Autoridad subordinada",{"_8437":711,"_23077":671,"_19595":35686,"_5":23231,"_15751":35572,"_1713":35687},[],"**Emisor**",{"_8437":712,"_23077":671,"_19595":35689,"_5":23231,"_15751":35572,"_1713":35690},[],"**Root CA:** Self-signed (auto-firmada)",{"_8437":713,"_23077":671,"_19595":35692,"_5":23231,"_15751":35572,"_1713":35693},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_8437":714,"_23077":671,"_19595":35695,"_5":23231,"_15751":35572,"_1713":35696},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_8437":715,"_23077":671,"_19595":35698,"_5":23231,"_15751":35572,"_1713":35699},[],"**Identificación**",{"_8437":716,"_23077":671,"_19595":35701,"_5":23231,"_15751":35572,"_1713":35702},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_8437":717,"_23077":671,"_19595":35704,"_5":23231,"_15751":35572,"_1713":35705},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_8437":718,"_23077":671,"_19595":35707,"_5":23231,"_15751":35572,"_1713":35708},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_8437":719,"_23077":671,"_19595":35710,"_5":23231,"_15751":35572,"_1713":35711},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_8437":720,"_23077":671,"_19595":35713,"_5":23231,"_15751":35572,"_1713":35714},[],"**Subject Distinguished Name (DN)**",{"_8437":721,"_23077":671,"_19595":35716,"_5":23231,"_15751":35572,"_1713":35717},[],"Campos opcionales:",{"_8437":722,"_23077":671,"_19595":35719,"_5":23231,"_15751":35572,"_1713":35720},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_8437":723,"_23077":671,"_19595":35722,"_5":23231,"_15751":35572,"_1713":35723},[],"Ejemplo: US, ES, DE",{"_8437":724,"_23077":671,"_19595":35725,"_5":23231,"_15751":35572,"_1713":35726},[],"**State/Province (ST):** Estado o provincia",{"_8437":725,"_23077":671,"_19595":35728,"_5":23231,"_15751":35572,"_1713":35729},[],"Ejemplo: California, Madrid",{"_8437":726,"_23077":671,"_19595":35731,"_5":23231,"_15751":35572,"_1713":35732},[],"**Locality (L):** Ciudad o localidad",{"_8437":727,"_23077":671,"_19595":35734,"_5":23231,"_15751":35572,"_1713":35735},[],"Ejemplo: San Francisco, Arrasate",{"_8437":728,"_23077":671,"_19595":35737,"_5":23231,"_15751":35572,"_1713":35738},[],"**Organization (O):** Nombre de la organización",{"_8437":729,"_23077":671,"_19595":35740,"_5":23231,"_15751":35572,"_1713":35741},[],"Ejemplo: Lamassu IoT Corp",{"_8437":730,"_23077":671,"_19595":35743,"_5":23231,"_15751":35572,"_1713":35744},[],"**Organizational Unit (OU):** Unidad organizacional",{"_8437":731,"_23077":671,"_19595":35746,"_5":23231,"_15751":35572,"_1713":35747},[],"Ejemplo: Secure Devices Division",{"_8437":732,"_23077":671,"_19595":35749,"_5":23231,"_15751":35572,"_1713":35750},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_8437":733,"_23077":671,"_19595":35752,"_5":23231,"_15751":35572,"_1713":35753},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_8437":734,"_23077":671,"_19595":35755,"_5":23231,"_15751":35572,"_1713":35756},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_8437":735,"_23077":671,"_19595":35758,"_5":23231,"_15751":35572,"_1713":35759},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_8437":736,"_23077":671,"_19595":35761,"_5":23231,"_15751":35572,"_1713":35762},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_8437":737,"_23077":671,"_19595":35764,"_5":23231,"_15751":35572,"_1713":35765},[],"**Duración:** Configurable según necesidades organizacionales",{"_8437":738,"_23077":671,"_19595":35767,"_5":23231,"_15751":35572,"_1713":35768},[],"**Valor por defecto:** 10 años (10y)",{"_8437":739,"_23077":671,"_19595":35770,"_5":23231,"_15751":35572,"_1713":35771},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_8437":740,"_23077":671,"_19595":35773,"_5":23231,"_15751":35572,"_1713":35774},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_8437":741,"_23077":671,"_19595":35776,"_5":23231,"_15751":35572,"_1713":35777},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_8437":742,"_23077":671,"_19595":35779,"_5":23231,"_15751":35572,"_1713":35780},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_8437":743,"_23077":671,"_19595":35782,"_5":23231,"_15751":35572,"_1713":35783},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_8437":744,"_23077":671,"_19595":35785,"_5":23231,"_15751":35572,"_1713":35786},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_8437":745,"_23077":671,"_19595":35788,"_5":23231,"_15751":35572,"_1713":35789},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_8437":746,"_23077":671,"_19595":35791,"_5":23231,"_15751":35572,"_1713":35792},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_8437":747,"_23077":671,"_19595":35794,"_5":23231,"_15751":35572,"_1713":35795},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_8437":748,"_23077":671,"_19595":35797,"_5":23231,"_15751":35572,"_1713":35798},[],"**Valor por defecto:** 1 año (1y)",{"_8437":749,"_23077":671,"_19595":35800,"_5":23231,"_15751":35572,"_1713":35801},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_8437":750,"_23077":671,"_19595":35803,"_5":23231,"_15751":35572,"_1713":35804},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_8437":751,"_23077":671,"_19595":35806,"_5":23231,"_15751":35576,"_1713":35807},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_8437":752,"_23077":671,"_19595":35809,"_5":23231,"_15751":35576,"_1713":35810},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_8437":753,"_23077":671,"_19595":35812,"_5":23231,"_15751":35576,"_1713":35813},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_8437":754,"_23077":671,"_19595":35815,"_5":23231,"_15751":35580,"_1713":35816},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_8437":755,"_23077":671,"_19595":35818,"_5":23231,"_15751":35580,"_1713":35819},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_8437":756,"_23077":671,"_19595":35821,"_5":23231,"_15751":35580,"_1713":35624},[],{"_8437":757,"_23077":671,"_19595":35823,"_5":23231,"_15751":35580,"_1713":35627},[],{"_8437":758,"_23077":671,"_19595":35825,"_5":23231,"_15751":35580,"_1713":35630},[],{"_8437":759,"_23077":671,"_19595":35827,"_5":23231,"_15751":35580,"_1713":35828},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_8437":760,"_23077":671,"_19595":35830,"_5":23231,"_15751":35580,"_1713":35789},[],{"_8437":761,"_23077":671,"_19595":35832,"_5":23231,"_15751":35580,"_1713":35792},[],{"_8437":762,"_23077":671,"_19595":35834,"_5":23231,"_15751":35580,"_1713":35795},[],{"_8437":763,"_23077":671,"_19595":35836,"_5":23231,"_15751":35580,"_1713":35798},[],{"_8437":764,"_23077":671,"_19595":35838,"_5":23231,"_15751":35580,"_1713":35801},[],{"_8437":765,"_23077":671,"_19595":35840,"_5":23231,"_15751":35580,"_1713":35841},[],"Se debe proporcionar de manera obligatoria:",{"_8437":766,"_23077":671,"_19595":35843,"_5":23231,"_15751":35580,"_1713":35844},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_8437":767,"_23077":671,"_19595":35846,"_5":23231,"_15751":35580,"_1713":35847},[],"Clave privada de la CA en formato PEM",{"_8437":768,"_23077":671,"_19595":35849,"_5":23231,"_15751":35580,"_1713":35850},[],"Para las CAs con claves post-cuánticas, Ed25519 o compuestas, la clave privada debe proporcionarse en formato PKCS#8 y el motor seleccionado debe soportar el tipo de clave; consulte Criptografía post-cuántica (LamassuQ).",{"_8437":769,"_23077":671,"_19595":35852,"_5":23231,"_15751":35580,"_1713":35853},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_8437":770,"_23077":671,"_19595":35855,"_5":23231,"_15751":35588,"_1713":35856},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_8437":771,"_23077":671,"_19595":35858,"_5":23231,"_15751":35588,"_1713":35859},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_8437":772,"_23077":671,"_19595":35861,"_5":23231,"_15751":35588,"_1713":35862},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_8437":773,"_23077":671,"_19595":35864,"_5":23231,"_15751":35588,"_1713":35865},[],"Se ofrecen dos acciones:",{"_8437":774,"_23077":671,"_19595":35867,"_5":23231,"_15751":35588,"_1713":35868},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_8437":775,"_23077":671,"_19595":35870,"_5":23231,"_15751":35588,"_1713":35871},[],"la acción de revocación de la CA",{"_8437":776,"_23077":671,"_19595":35873,"_5":23231,"_15751":35588,"_1713":35874},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_8437":777,"_23077":671,"_19595":35876,"_5":23231,"_15751":35592,"_1713":35877},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_8437":778,"_23077":671,"_19595":35879,"_5":23231,"_15751":35592,"_1713":35880},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_8437":779,"_23077":671,"_19595":35882,"_5":23231,"_15751":35592,"_1713":35883},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_8437":780,"_23077":671,"_19595":35885,"_5":23231,"_15751":35592,"_1713":35886},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_8437":781,"_23077":671,"_19595":35888,"_5":23231,"_15751":35592,"_1713":35889},[],"El tipo de clave del certificado emitido no tiene por qué coincidir con el de la CA emisora, ya que la firma del certificado la realiza siempre la clave de la CA emisora. Una CA con clave post-cuántica, Ed25519 o compuesta puede emitir certificados para claves tradicionales, y una CA tradicional puede emitir certificados para CSRs con claves post-cuánticas, Ed25519 o compuestas. Consulte Cadenas de certificados mixtas.",{"_8437":782,"_23077":671,"_19595":35891,"_5":23231,"_15751":35592,"_1713":35892},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_8437":783,"_23077":671,"_19595":35894,"_5":23231,"_15751":35592,"_1713":35895},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_8437":784,"_23077":671,"_19595":35897,"_5":23231,"_15751":35592,"_1713":35898},[],"Emisión a partir de un CSR generado de manera externa",{"_8437":785,"_23077":671,"_19595":35900,"_5":23231,"_15751":35592,"_1713":35901},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_8437":786,"_23077":671,"_19595":35903,"_5":23231,"_15751":35592,"_1713":35904},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_8437":787,"_23077":671,"_19595":35906,"_5":23231,"_15751":35592,"_1713":35907},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_8437":788,"_23077":671,"_19595":35909,"_5":23231,"_15751":35592,"_1713":35910},[],"**Certificate Subject (Sujeto del certificado)**",{"_8437":789,"_23077":671,"_19595":35912,"_5":23231,"_15751":35592,"_1713":35913},[],"**Common Name (CN)**",{"_8437":790,"_23077":671,"_19595":35915,"_5":23231,"_15751":35592,"_1713":35916},[],"**Campo:** Obligatorio",{"_8437":791,"_23077":671,"_19595":35918,"_5":23231,"_15751":35592,"_1713":35919},[],"**Función:** Identifica de forma única al titular del certificado",{"_8437":792,"_23077":671,"_19595":35921,"_5":23231,"_15751":35592,"_1713":35922},[],"**Ejemplos:**",{"_8437":793,"_23077":671,"_19595":35924,"_5":23231,"_15751":35592,"_1713":35925},[],"Para dispositivos: device001.company.com",{"_8437":794,"_23077":671,"_19595":35927,"_5":23231,"_15751":35592,"_1713":35928},[],"Para usuarios: john.doe\\@company.com",{"_8437":795,"_23077":671,"_19595":35930,"_5":23231,"_15751":35592,"_1713":35931},[],"Para servicios: api.service.company.com",{"_8437":796,"_23077":671,"_19595":35933,"_5":23231,"_15751":35592,"_1713":35934},[],"**Campos Organizacionales**",{"_8437":797,"_23077":671,"_19595":35936,"_5":23231,"_15751":35592,"_1713":35937},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_8437":798,"_23077":671,"_19595":35939,"_5":23231,"_15751":35592,"_1713":35940},[],"Ejemplo: IT Department, Manufacturing",{"_8437":799,"_23077":671,"_19595":35942,"_5":23231,"_15751":35592,"_1713":35738},[],{"_8437":800,"_23077":671,"_19595":35944,"_5":23231,"_15751":35592,"_1713":35945},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_8437":801,"_23077":671,"_19595":35947,"_5":23231,"_15751":35592,"_1713":35948},[],"**Información Geográfica**",{"_8437":802,"_23077":671,"_19595":35950,"_5":23231,"_15751":35592,"_1713":35951},[],"**Locality (L):** Ciudad o localidad del titular",{"_8437":803,"_23077":671,"_19595":35953,"_5":23231,"_15751":35592,"_1713":35726},[],{"_8437":804,"_23077":671,"_19595":35955,"_5":23231,"_15751":35592,"_1713":35956},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_8437":805,"_23077":671,"_19595":35958,"_5":23231,"_15751":35592,"_1713":35959},[],"Valor por defecto mostrado: US",{"_8437":806,"_23077":671,"_19595":35961,"_5":23231,"_15751":35592,"_1713":35962},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_8437":807,"_23077":671,"_19595":35964,"_5":23231,"_15751":35592,"_1713":35965},[],"**Tipos de SAN Disponibles**",{"_8437":808,"_23077":671,"_19595":35967,"_5":23231,"_15751":35592,"_1713":35968},[],"**DNS:** Nombres de dominio",{"_8437":809,"_23077":671,"_19595":35970,"_5":23231,"_15751":35592,"_1713":35971},[],"Ejemplo: example.com, \\*.example.com",{"_8437":810,"_23077":671,"_19595":35973,"_5":23231,"_15751":35592,"_1713":35974},[],"**IP Address:** Direcciones IP",{"_8437":811,"_23077":671,"_19595":35976,"_5":23231,"_15751":35592,"_1713":35977},[],"**Email:** Direcciones de correo electrónico",{"_8437":812,"_23077":671,"_19595":35979,"_5":23231,"_15751":35592,"_1713":35980},[],"**URI:** Identificadores de recursos uniformes",{"_8437":813,"_23077":671,"_19595":35982,"_5":23231,"_15751":35592,"_1713":35983},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_8437":814,"_23077":671,"_19595":35985,"_5":23231,"_15751":35592,"_1713":35986},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado. La generación en el navegador solo está disponible para los algoritmos tradicionales (ECDSA y RSA); para claves post-cuánticas, Ed25519 o compuestas, utilice la opción de emisión a partir de un CSR generado de manera externa.",{"_8437":815,"_23077":671,"_19595":35988,"_5":23231,"_15751":35592,"_1713":35989},[],"**Algorithm (Algoritmo)**",{"_8437":816,"_23077":671,"_19595":35991,"_5":23231,"_15751":35592,"_1713":35992},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_8437":817,"_23077":671,"_19595":35994,"_5":23231,"_15751":35592,"_1713":35995},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_8437":818,"_23077":671,"_19595":35997,"_5":23231,"_15751":35592,"_1713":35998},[],"**Certificate Configuration (Configuración del certificado)**",{"_8437":819,"_23077":671,"_19595":36000,"_5":23231,"_15751":35592,"_1713":36001},[],"**Validity Duration (Duración de validez)**",{"_8437":820,"_23077":671,"_19595":36003,"_5":23231,"_15751":35592,"_1713":36004},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_8437":821,"_23077":671,"_19595":36006,"_5":23231,"_15751":35592,"_1713":36007},[],"**Campo:** Configurable según necesidades",{"_8437":822,"_23077":671,"_19595":36009,"_5":23231,"_15751":35592,"_1713":35798},[],{"_8437":823,"_23077":671,"_19595":36011,"_5":23231,"_15751":35592,"_1713":36012},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_8437":824,"_23077":671,"_19595":36014,"_5":23231,"_15751":35592,"_1713":36015},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_8437":825,"_23077":671,"_19595":36017,"_5":23231,"_15751":35592,"_1713":36018},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_8437":826,"_23077":671,"_19595":36020,"_5":23231,"_15751":35592,"_1713":36021},[],"**Usos Básicos**",{"_8437":827,"_23077":671,"_19595":36023,"_5":23231,"_15751":35592,"_1713":36024},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_8437":828,"_23077":671,"_19595":36026,"_5":23231,"_15751":35592,"_1713":36027},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_8437":829,"_23077":671,"_19595":36029,"_5":23231,"_15751":35592,"_1713":36030},[],"**Key Encipherment:** Cifrado de claves",{"_8437":830,"_23077":671,"_19595":36032,"_5":23231,"_15751":35592,"_1713":36033},[],"**Data Encipherment:** Cifrado de datos",{"_8437":831,"_23077":671,"_19595":36035,"_5":23231,"_15751":35592,"_1713":36036},[],"**Key Agreement:** Acuerdo de claves",{"_8437":832,"_23077":671,"_19595":36038,"_5":23231,"_15751":35592,"_1713":36039},[],"**Certificate Signing:** Firma de certificados",{"_8437":833,"_23077":671,"_19595":36041,"_5":23231,"_15751":35592,"_1713":36042},[],"**CRL Signing:** Firma de listas de revocación",{"_8437":834,"_23077":671,"_19595":36044,"_5":23231,"_15751":35592,"_1713":36045},[],"**Encipher Only:** Solo cifrado",{"_8437":835,"_23077":671,"_19595":36047,"_5":23231,"_15751":35592,"_1713":36048},[],"**Decipher Only:** Solo descifrado",{"_8437":836,"_23077":671,"_19595":36050,"_5":23231,"_15751":35592,"_1713":36051},[],"**Uso Extendido de Claves**",{"_8437":837,"_23077":671,"_19595":36053,"_5":23231,"_15751":35592,"_1713":36054},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_8437":838,"_23077":671,"_19595":36056,"_5":23231,"_15751":35592,"_1713":36057},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_8437":839,"_23077":671,"_19595":36059,"_5":23231,"_15751":35592,"_1713":36060},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_8437":840,"_23077":671,"_19595":36062,"_5":23231,"_15751":35592,"_1713":36063},[],"**Code Signing:** Firma de código",{"_8437":841,"_23077":671,"_19595":36065,"_5":23231,"_15751":35592,"_1713":36066},[],"**Email Protection:** Protección de correo electrónico",{"_8437":842,"_23077":671,"_19595":36068,"_5":23231,"_15751":35592,"_1713":36069},[],"**Time Stamping:** Sellado de tiempo",{"_8437":843,"_23077":671,"_19595":36071,"_5":23231,"_15751":35592,"_1713":36072},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_8437":844,"_23077":671,"_19595":36074,"_5":23231,"_15751":35592,"_1713":36075},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_8437":845,"_23077":671,"_19595":36077,"_5":23231,"_15751":35592,"_1713":36078},[],"**Emisión a partir de un CSR generado de manera externa**",{"_8437":846,"_23077":671,"_19595":36080,"_5":23231,"_15751":35592,"_1713":36081},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_8437":847,"_23077":671,"_19595":36083,"_5":23231,"_15751":35592,"_1713":36084},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_8437":848,"_23077":671,"_19595":36086,"_5":23231,"_15751":35592,"_1713":36087},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_8437":849,"_23077":671,"_19595":36089,"_5":23231,"_15751":35596,"_1713":36090},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_8437":850,"_23077":671,"_19595":36092,"_5":23231,"_15751":35596,"_1713":36093},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_8437":851,"_23077":671,"_19595":36095,"_5":23231,"_15751":35596,"_1713":36096},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_8437":852,"_23077":671,"_19595":36098,"_5":23231,"_15751":35596,"_1713":36099},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_8437":853,"_23077":671,"_19595":36101,"_5":23231,"_15751":35596,"_1713":36102},[],"Unspecified (No especificado)",{"_8437":854,"_23077":671,"_19595":36104,"_5":23231,"_15751":35596,"_1713":36105},[],"KeyCompromise (Compromiso de clave)",{"_8437":855,"_23077":671,"_19595":36107,"_5":23231,"_15751":35596,"_1713":36108},[],"CACompromise (Compromiso de CA)",{"_8437":856,"_23077":671,"_19595":36110,"_5":23231,"_15751":35596,"_1713":36111},[],"AffiliationChanged (Afiliación cambiada)",{"_8437":857,"_23077":671,"_19595":36113,"_5":23231,"_15751":35596,"_1713":36114},[],"Superseded (Sustituida)",{"_8437":858,"_23077":671,"_19595":36116,"_5":23231,"_15751":35596,"_1713":36117},[],"CessationOfOperation (Cese de operación)",{"_8437":859,"_23077":671,"_19595":36119,"_5":23231,"_15751":35596,"_1713":36120},[],"CertificateHold (Retención de certificado)",{"_8437":860,"_23077":671,"_19595":36122,"_5":23231,"_15751":35596,"_1713":36123},[],"RemoveFromCRL (Eliminar de la CRL)",{"_8437":861,"_23077":671,"_19595":36125,"_5":23231,"_15751":35596,"_1713":36126},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_8437":862,"_23077":671,"_19595":36128,"_5":23231,"_15751":35596,"_1713":36129},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_8437":863,"_23077":671,"_19595":36131,"_5":23231,"_15751":35596,"_1713":36132},[],"Consideraciones importantes:",{"_8437":864,"_23077":671,"_19595":36134,"_5":23231,"_15751":35596,"_1713":36135},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_8437":865,"_23077":671,"_19595":36137,"_5":23231,"_15751":35596,"_1713":36138},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_8437":866,"_23077":866,"_5":23226,"_1713":36140,"_23239":36141,"_19595":36142,"_15751":866},"[Certs] Gestión de Certificados",[33545,34644,34653],[],{"_8437":867,"_23077":866,"_19595":36144,"_5":23231,"_15751":866,"_1713":36145},[],"Visualización y gestión de certificados emitidos",{"_8437":868,"_23077":866,"_5":23236,"_19595":36147,"_15751":36148,"_1713":36149},[],"/docs/pr-preview/pr-25/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_8437":869,"_23077":866,"_5":23236,"_19595":36151,"_15751":36152,"_1713":36153},[],"/docs/pr-preview/pr-25/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_8437":870,"_23077":866,"_19595":36155,"_5":23231,"_15751":36148,"_1713":36156},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_8437":871,"_23077":866,"_19595":36158,"_5":23231,"_15751":36148,"_1713":36159},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_8437":872,"_23077":866,"_19595":36161,"_5":23231,"_15751":36148,"_1713":36162},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_8437":873,"_23077":866,"_19595":36164,"_5":23231,"_15751":36152,"_1713":36165},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_8437":874,"_23077":866,"_19595":36167,"_5":23231,"_15751":36152,"_1713":36168},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_8437":875,"_23077":875,"_5":23226,"_1713":36170,"_23239":36171,"_19595":36172,"_15751":875},"[Devices] Dispositivos e Identidades",[33545,34644,34653],[],{"_8437":876,"_23077":875,"_19595":36174,"_5":23231,"_15751":875,"_1713":36175},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_8437":877,"_23077":875,"_5":23236,"_19595":36177,"_15751":36178,"_1713":36179},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_8437":878,"_23077":875,"_5":23236,"_19595":36181,"_15751":36182,"_1713":36183},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_8437":879,"_23077":875,"_5":23236,"_19595":36185,"_15751":36186,"_1713":36187},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_8437":880,"_23077":875,"_5":23236,"_19595":36189,"_15751":36190,"_1713":36191},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_8437":881,"_23077":875,"_5":23236,"_19595":36193,"_15751":36194,"_1713":36195},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_8437":882,"_23077":875,"_5":23236,"_19595":36197,"_15751":36198,"_1713":36199},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_8437":883,"_23077":875,"_5":23236,"_19595":36201,"_15751":36202,"_1713":36203},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_8437":884,"_23077":875,"_5":23236,"_19595":36205,"_15751":36206,"_1713":36207},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_8437":885,"_23077":875,"_19595":36209,"_5":23231,"_15751":36178,"_1713":36210},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_8437":886,"_23077":875,"_19595":36212,"_5":23231,"_15751":36182,"_1713":36213},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_8437":887,"_23077":875,"_19595":36215,"_5":23231,"_15751":36182,"_1713":36216},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_8437":888,"_23077":875,"_19595":36218,"_5":23231,"_15751":36182,"_1713":36219},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_8437":889,"_23077":875,"_19595":36221,"_5":23231,"_15751":36182,"_1713":36222},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_8437":890,"_23077":875,"_19595":36224,"_5":23231,"_15751":36182,"_1713":36225},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_8437":891,"_23077":875,"_19595":36227,"_5":23231,"_15751":36182,"_1713":36228},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_8437":892,"_23077":875,"_19595":36230,"_5":23231,"_15751":36182,"_1713":36231},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_8437":893,"_23077":875,"_19595":36233,"_5":23231,"_15751":36182,"_1713":36234},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_8437":894,"_23077":875,"_19595":36236,"_5":23231,"_15751":36182,"_1713":36237},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_8437":895,"_23077":875,"_19595":36239,"_5":23231,"_15751":36186,"_1713":36240},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_8437":896,"_23077":875,"_19595":36242,"_5":23231,"_15751":36186,"_1713":36243},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_8437":897,"_23077":875,"_19595":36245,"_5":23231,"_15751":36190,"_1713":36246},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_8437":898,"_23077":875,"_19595":36248,"_5":23231,"_15751":36190,"_1713":36249},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_8437":899,"_23077":875,"_19595":36251,"_5":23231,"_15751":36194,"_1713":36252},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_8437":900,"_23077":875,"_19595":36254,"_5":23231,"_15751":36194,"_1713":36255},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_8437":901,"_23077":875,"_19595":36257,"_5":23231,"_15751":36194,"_1713":36258},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_8437":902,"_23077":875,"_19595":36260,"_5":23231,"_15751":36194,"_1713":36261},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_8437":903,"_23077":875,"_19595":36263,"_5":23231,"_15751":36194,"_1713":36264},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_8437":904,"_23077":875,"_19595":36266,"_5":23231,"_15751":36194,"_1713":36267},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_8437":905,"_23077":875,"_19595":36269,"_5":23231,"_15751":36194,"_1713":36270},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_8437":906,"_23077":875,"_19595":36272,"_5":23231,"_15751":36194,"_1713":36273},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_8437":907,"_23077":875,"_19595":36275,"_5":23231,"_15751":36198,"_1713":36276},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_8437":908,"_23077":875,"_19595":36278,"_5":23231,"_15751":36198,"_1713":36279},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_8437":909,"_23077":875,"_19595":36281,"_5":23231,"_15751":36198,"_1713":36282},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_8437":910,"_23077":875,"_19595":36284,"_5":23231,"_15751":36198,"_1713":36285},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_8437":911,"_23077":875,"_19595":36287,"_5":23231,"_15751":36198,"_1713":36288},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_8437":912,"_23077":875,"_19595":36290,"_5":23231,"_15751":36198,"_1713":36291},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_8437":913,"_23077":875,"_19595":36293,"_5":23231,"_15751":36202,"_1713":36294},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_8437":914,"_23077":875,"_19595":36296,"_5":23231,"_15751":36202,"_1713":36297},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_8437":915,"_23077":875,"_19595":36299,"_5":23231,"_15751":36202,"_1713":36300},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_8437":916,"_23077":875,"_19595":36302,"_5":23231,"_15751":36202,"_1713":36303},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_8437":917,"_23077":875,"_19595":36305,"_5":23231,"_15751":36202,"_1713":36306},[],"**Unspecified**: Motivo de revocación no especificado.",{"_8437":918,"_23077":875,"_19595":36308,"_5":23231,"_15751":36202,"_1713":36309},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_8437":919,"_23077":875,"_19595":36311,"_5":23231,"_15751":36202,"_1713":36312},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_8437":920,"_23077":875,"_19595":36314,"_5":23231,"_15751":36202,"_1713":36315},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_8437":921,"_23077":875,"_19595":36317,"_5":23231,"_15751":36202,"_1713":36318},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_8437":922,"_23077":875,"_19595":36320,"_5":23231,"_15751":36202,"_1713":36321},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_8437":923,"_23077":875,"_19595":36323,"_5":23231,"_15751":36202,"_1713":36324},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_8437":924,"_23077":875,"_19595":36326,"_5":23231,"_15751":36202,"_1713":36327},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_8437":925,"_23077":875,"_19595":36329,"_5":23231,"_15751":36202,"_1713":36330},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_8437":926,"_23077":875,"_19595":36332,"_5":23231,"_15751":36202,"_1713":36333},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_8437":927,"_23077":875,"_19595":36335,"_5":23231,"_15751":36202,"_1713":36336},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_8437":928,"_23077":875,"_19595":36338,"_5":23231,"_15751":36202,"_1713":36339},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_8437":929,"_23077":875,"_19595":36341,"_5":23231,"_15751":36206,"_1713":36342},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_8437":930,"_23077":875,"_19595":36344,"_5":23231,"_15751":36206,"_1713":36345},[],"El proceso se realiza de la siguiente manera:",{"_8437":931,"_23077":875,"_19595":36347,"_5":23231,"_15751":36206,"_1713":36348},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_8437":932,"_23077":875,"_19595":36350,"_5":23231,"_15751":36206,"_1713":36351},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_8437":933,"_23077":875,"_19595":36353,"_5":23231,"_15751":36206,"_1713":36354},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_8437":934,"_23077":934,"_5":23226,"_1713":36356,"_23239":36357,"_19595":36358,"_15751":934},"EST: Enrollment over Secure Transport",[33545,34644,34653],[],{"_8437":935,"_23077":934,"_19595":36360,"_5":23231,"_15751":934,"_1713":36361},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_8437":936,"_23077":934,"_5":23236,"_19595":36363,"_15751":36364,"_1713":36356},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_8437":937,"_23077":934,"_5":23236,"_19595":36366,"_15751":36367,"_1713":34730},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-del-dms",{"_8437":938,"_23077":934,"_5":23236,"_19595":36369,"_15751":36370,"_1713":34250},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos",{"_8437":939,"_23077":934,"_5":23236,"_19595":36372,"_15751":36373,"_1713":36374},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_8437":940,"_23077":934,"_5":23236,"_19595":36376,"_15751":36377,"_1713":36378},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_8437":941,"_23077":934,"_5":23236,"_19595":36380,"_15751":36381,"_1713":36382},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_8437":942,"_23077":934,"_5":23236,"_19595":36384,"_15751":36385,"_1713":36386},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_8437":943,"_23077":934,"_5":23236,"_19595":36388,"_15751":36389,"_1713":36390},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_8437":944,"_23077":934,"_5":23236,"_19595":36392,"_15751":36393,"_1713":36394},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_8437":945,"_23077":934,"_5":23236,"_19595":36396,"_15751":36397,"_1713":36398},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_8437":946,"_23077":934,"_5":23236,"_19595":36400,"_15751":36401,"_1713":36402},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_8437":947,"_23077":934,"_5":23236,"_19595":36404,"_15751":36405,"_1713":36406},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","Antes de empezar",{"_8437":948,"_23077":934,"_5":23236,"_19595":36408,"_15751":36409,"_1713":36410},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_8437":949,"_23077":934,"_5":23236,"_19595":36412,"_15751":36413,"_1713":36414},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_8437":950,"_23077":934,"_5":23236,"_19595":36416,"_15751":36417,"_1713":36418},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_8437":951,"_23077":934,"_5":23236,"_19595":36420,"_15751":36421,"_1713":36422},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#cacerts","`/cacerts`",{"_8437":952,"_23077":934,"_5":23236,"_19595":36424,"_15751":36425,"_1713":36426},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_8437":953,"_23077":934,"_5":23236,"_19595":36428,"_15751":36429,"_1713":36430},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_8437":954,"_23077":934,"_5":23236,"_19595":36432,"_15751":36433,"_1713":36434},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_8437":955,"_23077":934,"_5":23236,"_19595":36436,"_15751":36437,"_1713":36438},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#flujos-completos","Flujos completos",{"_8437":956,"_23077":934,"_5":23236,"_19595":36440,"_15751":36441,"_1713":36442},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_8437":957,"_23077":934,"_5":23236,"_19595":36444,"_15751":36445,"_1713":36446},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_8437":958,"_23077":934,"_5":23236,"_19595":36448,"_15751":36449,"_1713":36450},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_8437":959,"_23077":934,"_5":23236,"_19595":36452,"_15751":36453,"_1713":36454},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_8437":960,"_23077":934,"_5":23236,"_19595":36456,"_15751":36457,"_1713":36458},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_8437":961,"_23077":934,"_5":23236,"_19595":36460,"_15751":36461,"_1713":36462},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_8437":962,"_23077":934,"_19595":36464,"_5":23231,"_15751":36364,"_1713":36465},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_8437":963,"_23077":934,"_19595":36467,"_5":23231,"_15751":36364,"_1713":36468},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_8437":964,"_23077":934,"_19595":36470,"_5":23231,"_15751":36364,"_1713":36471},[],"Esta guía está dividida en dos partes:",{"_8437":965,"_23077":934,"_19595":36473,"_5":23231,"_15751":36364,"_1713":36474},[],"Configuración del DMS, para el administrador PKI.",{"_8437":966,"_23077":934,"_19595":36476,"_5":23231,"_15751":36364,"_1713":36477},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_8437":967,"_23077":934,"_19595":36479,"_5":23231,"_15751":36364,"_1713":36480},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_8437":968,"_23077":934,"_19595":36482,"_5":23231,"_15751":36364,"_1713":36483},[],"Perfil",{"_8437":969,"_23077":934,"_19595":36485,"_5":23231,"_15751":36364,"_1713":36486},[],"Leer primero",{"_8437":970,"_23077":934,"_19595":36488,"_5":23231,"_15751":36364,"_1713":36489},[],"Después",{"_8437":971,"_23077":934,"_19595":36491,"_5":23231,"_15751":36364,"_1713":36492},[],"Administrador PKI",{"_8437":972,"_23077":934,"_19595":36494,"_5":23231,"_15751":36364,"_1713":34730},[],{"_8437":973,"_23077":934,"_19595":36496,"_5":23231,"_15751":36364,"_1713":36454},[],{"_8437":974,"_23077":934,"_19595":36498,"_5":23231,"_15751":36364,"_1713":36499},[],"Integrador de dispositivos",{"_8437":975,"_23077":934,"_19595":36501,"_5":23231,"_15751":36364,"_1713":36406},[],{"_8437":976,"_23077":934,"_19595":36503,"_5":23231,"_15751":36364,"_1713":36504},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_8437":977,"_23077":934,"_19595":36506,"_5":23231,"_15751":36370,"_1713":36507},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_8437":978,"_23077":934,"_19595":36509,"_5":23231,"_15751":36370,"_1713":36510},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_8437":979,"_23077":934,"_19595":36512,"_5":23231,"_15751":36370,"_1713":36513},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_8437":980,"_23077":934,"_19595":36515,"_5":23231,"_15751":36370,"_1713":36516},[],"Conviene separar cuatro bloques de configuración:",{"_8437":981,"_23077":934,"_19595":36518,"_5":23231,"_15751":36370,"_1713":36519},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_8437":982,"_23077":934,"_19595":36521,"_5":23231,"_15751":36370,"_1713":36522},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_8437":983,"_23077":934,"_19595":36524,"_5":23231,"_15751":36370,"_1713":36525},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_8437":984,"_23077":934,"_19595":36527,"_5":23231,"_15751":36370,"_1713":36528},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_8437":985,"_23077":934,"_19595":36530,"_5":23231,"_15751":36377,"_1713":36531},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_8437":986,"_23077":934,"_19595":36533,"_5":23231,"_15751":36377,"_1713":36534},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_8437":987,"_23077":934,"_19595":36536,"_5":23231,"_15751":36377,"_1713":36537},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_8437":988,"_23077":934,"_19595":36539,"_5":23231,"_15751":36377,"_1713":36540},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_8437":989,"_23077":934,"_19595":36542,"_5":23231,"_15751":36381,"_1713":36543},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_8437":990,"_23077":934,"_19595":36545,"_5":23231,"_15751":36381,"_1713":36546},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_8437":991,"_23077":934,"_19595":36548,"_5":23231,"_15751":36381,"_1713":36549},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_8437":992,"_23077":934,"_19595":36551,"_5":23231,"_15751":36381,"_1713":36552},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_8437":993,"_23077":934,"_19595":36554,"_5":23231,"_15751":36381,"_1713":36555},[],"Modo",{"_8437":994,"_23077":934,"_19595":36557,"_5":23231,"_15751":36381,"_1713":33748},[],{"_8437":995,"_23077":934,"_19595":36559,"_5":23231,"_15751":36381,"_1713":36560},[],"`CLIENT_CERTIFICATE`",{"_8437":996,"_23077":934,"_19595":36562,"_5":23231,"_15751":36381,"_1713":36563},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_8437":997,"_23077":934,"_19595":36565,"_5":23231,"_15751":36381,"_1713":36566},[],"`EXTERNAL_WEBHOOK`",{"_8437":998,"_23077":934,"_19595":36568,"_5":23231,"_15751":36381,"_1713":36569},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_8437":999,"_23077":934,"_19595":36571,"_5":23231,"_15751":36381,"_1713":36572},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_8437":1000,"_23077":934,"_19595":36574,"_5":23231,"_15751":36381,"_1713":36575},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_8437":1001,"_23077":934,"_19595":36577,"_5":23231,"_15751":36381,"_1713":36578},[],"`NO_AUTH`",{"_8437":1002,"_23077":934,"_19595":36580,"_5":23231,"_15751":36381,"_1713":36581},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_8437":1003,"_23077":934,"_19595":36583,"_5":23231,"_15751":36381,"_1713":36584},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_8437":1004,"_23077":934,"_19595":36586,"_5":23231,"_15751":36381,"_1713":36587},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_8437":1005,"_23077":934,"_19595":36589,"_5":23231,"_15751":36381,"_1713":36590},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_8437":1006,"_23077":934,"_19595":36592,"_5":23231,"_15751":36381,"_1713":36593},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_8437":1007,"_23077":934,"_19595":36595,"_5":23231,"_15751":36381,"_1713":36596},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_8437":1008,"_23077":934,"_19595":36598,"_5":23231,"_15751":36381,"_1713":36599},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_8437":1009,"_23077":934,"_19595":36601,"_5":23231,"_15751":36381,"_1713":36602},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_8437":1010,"_23077":934,"_19595":36604,"_5":23231,"_15751":36381,"_1713":36605},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_8437":1011,"_23077":934,"_19595":36607,"_5":23231,"_15751":36381,"_1713":36608},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_8437":1012,"_23077":934,"_19595":36610,"_5":23231,"_15751":36381,"_1713":36611},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_8437":1013,"_23077":934,"_19595":36613,"_5":23231,"_15751":36385,"_1713":36614},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_8437":1014,"_23077":934,"_19595":36616,"_5":23231,"_15751":36385,"_1713":36617},[],"Campo",{"_8437":1015,"_23077":934,"_19595":36619,"_5":23231,"_15751":36385,"_1713":34882},[],{"_8437":1016,"_23077":934,"_19595":36621,"_5":23231,"_15751":36385,"_1713":36622},[],"Efecto sobre el certificado emitido",{"_8437":1017,"_23077":934,"_19595":36624,"_5":23231,"_15751":36385,"_1713":36625},[],"`HonorSubject`",{"_8437":1018,"_23077":934,"_19595":36627,"_5":23231,"_15751":36385,"_1713":21337},[],{"_8437":1019,"_23077":934,"_19595":36629,"_5":23231,"_15751":36385,"_1713":36630},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_8437":1020,"_23077":934,"_19595":36632,"_5":23231,"_15751":36385,"_1713":36633},[],"`HonorKeyUsage`",{"_8437":1021,"_23077":934,"_19595":36635,"_5":23231,"_15751":36385,"_1713":21337},[],{"_8437":1022,"_23077":934,"_19595":36637,"_5":23231,"_15751":36385,"_1713":36638},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_8437":1023,"_23077":934,"_19595":36640,"_5":23231,"_15751":36385,"_1713":36641},[],"`HonorExtendedKeyUsages`",{"_8437":1024,"_23077":934,"_19595":36643,"_5":23231,"_15751":36385,"_1713":21337},[],{"_8437":1025,"_23077":934,"_19595":36645,"_5":23231,"_15751":36385,"_1713":36646},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_8437":1026,"_23077":934,"_19595":36648,"_5":23231,"_15751":36385,"_1713":36649},[],"`HonorExtensions`",{"_8437":1027,"_23077":934,"_19595":36651,"_5":23231,"_15751":36385,"_1713":21337},[],{"_8437":1028,"_23077":934,"_19595":36653,"_5":23231,"_15751":36385,"_1713":36654},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_8437":1029,"_23077":934,"_19595":36656,"_5":23231,"_15751":36385,"_1713":36657},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_8437":1030,"_23077":934,"_19595":36659,"_5":23231,"_15751":36389,"_1713":36660},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_8437":1031,"_23077":934,"_19595":36662,"_5":23231,"_15751":36389,"_1713":36663},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_8437":1032,"_23077":934,"_19595":36665,"_5":23231,"_15751":36389,"_1713":36666},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_8437":1033,"_23077":934,"_19595":36668,"_5":23231,"_15751":36389,"_1713":36669},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_8437":1034,"_23077":934,"_19595":36671,"_5":23231,"_15751":36389,"_1713":36672},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_8437":1035,"_23077":934,"_19595":36674,"_5":23231,"_15751":36389,"_1713":36675},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_8437":1036,"_23077":934,"_19595":36677,"_5":23231,"_15751":36389,"_1713":36678},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_8437":1037,"_23077":934,"_19595":36680,"_5":23231,"_15751":36393,"_1713":36681},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_8437":1038,"_23077":934,"_19595":36683,"_5":23231,"_15751":36393,"_1713":36684},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_8437":1039,"_23077":934,"_19595":36686,"_5":23231,"_15751":36393,"_1713":36687},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_8437":1040,"_23077":934,"_19595":36689,"_5":23231,"_15751":36393,"_1713":36690},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_8437":1041,"_23077":934,"_19595":36692,"_5":23231,"_15751":36397,"_1713":36693},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_8437":1042,"_23077":934,"_19595":36695,"_5":23231,"_15751":36397,"_1713":36696},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_8437":1043,"_23077":934,"_19595":36698,"_5":23231,"_15751":36397,"_1713":36699},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_8437":1044,"_23077":934,"_19595":36701,"_5":23231,"_15751":36397,"_1713":36702},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_8437":1045,"_23077":934,"_19595":36704,"_5":23231,"_15751":36401,"_1713":36705},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_8437":1046,"_23077":934,"_19595":36707,"_5":23231,"_15751":36401,"_1713":36708},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_8437":1047,"_23077":934,"_19595":36710,"_5":23231,"_15751":36401,"_1713":36711},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_8437":1048,"_23077":934,"_19595":36713,"_5":23231,"_15751":36405,"_1713":36714},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_8437":1049,"_23077":934,"_19595":36716,"_5":23231,"_15751":36405,"_1713":36717},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_8437":1050,"_23077":934,"_19595":36719,"_5":23231,"_15751":36405,"_1713":36720},[],"Elemento",{"_8437":1051,"_23077":934,"_19595":36722,"_5":23231,"_15751":36405,"_1713":33748},[],{"_8437":1052,"_23077":934,"_19595":36724,"_5":23231,"_15751":36405,"_1713":36725},[],"**URL del host EST**",{"_8437":1053,"_23077":934,"_19595":36727,"_5":23231,"_15751":36405,"_1713":36728},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_8437":1054,"_23077":934,"_19595":36730,"_5":23231,"_15751":36405,"_1713":36731},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_8437":1055,"_23077":934,"_19595":36733,"_5":23231,"_15751":36405,"_1713":36734},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_8437":1056,"_23077":934,"_19595":36736,"_5":23231,"_15751":36405,"_1713":36737},[],"**Certificado bootstrap + clave privada**",{"_8437":1057,"_23077":934,"_19595":36739,"_5":23231,"_15751":36405,"_1713":36740},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_8437":1058,"_23077":934,"_19595":36742,"_5":23231,"_15751":36405,"_1713":36743},[],"**ID del DMS** (`{aps}`)",{"_8437":1059,"_23077":934,"_19595":36745,"_5":23231,"_15751":36405,"_1713":36746},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_8437":1060,"_23077":934,"_19595":36748,"_5":23231,"_15751":36409,"_1713":36749},[],"Caso",{"_8437":1061,"_23077":934,"_19595":36751,"_5":23231,"_15751":36409,"_1713":36752},[],"Credencial habitual",{"_8437":1062,"_23077":934,"_19595":36754,"_5":23231,"_15751":36409,"_1713":36755},[],"Endpoint principal",{"_8437":1063,"_23077":934,"_19595":36757,"_5":23231,"_15751":36409,"_1713":36758},[],"Resultado",{"_8437":1064,"_23077":934,"_19595":36760,"_5":23231,"_15751":36409,"_1713":36761},[],"Alta inicial",{"_8437":1065,"_23077":934,"_19595":36763,"_5":23231,"_15751":36409,"_1713":36764},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_8437":1066,"_23077":934,"_19595":36766,"_5":23231,"_15751":36409,"_1713":36426},[],{"_8437":1067,"_23077":934,"_19595":36768,"_5":23231,"_15751":36409,"_1713":36769},[],"Certificado de dispositivo",{"_8437":1068,"_23077":934,"_19595":36771,"_5":23231,"_15751":36409,"_1713":36772},[],"Renovación",{"_8437":1069,"_23077":934,"_19595":36774,"_5":23231,"_15751":36409,"_1713":36775},[],"Certificado actual del dispositivo",{"_8437":1070,"_23077":934,"_19595":36777,"_5":23231,"_15751":36409,"_1713":36430},[],{"_8437":1071,"_23077":934,"_19595":36779,"_5":23231,"_15751":36409,"_1713":36780},[],"Certificado renovado",{"_8437":1072,"_23077":934,"_19595":36782,"_5":23231,"_15751":36409,"_1713":36783},[],"Descarga de confianza",{"_8437":1073,"_23077":934,"_19595":36785,"_5":23231,"_15751":36409,"_1713":36786},[],"TLS del servidor",{"_8437":1074,"_23077":934,"_19595":36788,"_5":23231,"_15751":36409,"_1713":36422},[],{"_8437":1075,"_23077":934,"_19595":36790,"_5":23231,"_15751":36409,"_1713":36791},[],"PKCS#7 o PEM con certificados",{"_8437":1076,"_23077":934,"_19595":36793,"_5":23231,"_15751":36409,"_1713":36794},[],"Clave generada en servidor",{"_8437":1077,"_23077":934,"_19595":36796,"_5":23231,"_15751":36409,"_1713":36797},[],"Igual que `/simpleenroll`",{"_8437":1078,"_23077":934,"_19595":36799,"_5":23231,"_15751":36409,"_1713":36434},[],{"_8437":1079,"_23077":934,"_19595":36801,"_5":23231,"_15751":36409,"_1713":36802},[],"Clave privada PKCS#8 + certificado",{"_8437":1080,"_23077":934,"_19595":36804,"_5":23231,"_15751":36413,"_1713":36805},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_8437":1081,"_23077":934,"_19595":36807,"_5":23231,"_15751":36413,"_1713":36808},[],"Modo (`AuthMode`)",{"_8437":1082,"_23077":934,"_19595":36810,"_5":23231,"_15751":36413,"_1713":33748},[],{"_8437":1083,"_23077":934,"_19595":36812,"_5":23231,"_15751":36413,"_1713":36813},[],"Credencial esperada",{"_8437":1084,"_23077":934,"_19595":36815,"_5":23231,"_15751":36413,"_1713":36816},[],"Aplica en enroll",{"_8437":1085,"_23077":934,"_19595":36818,"_5":23231,"_15751":36413,"_1713":36819},[],"Aplica en reenroll",{"_8437":1086,"_23077":934,"_19595":36821,"_5":23231,"_15751":36413,"_1713":36560},[],{"_8437":1087,"_23077":934,"_19595":36823,"_5":23231,"_15751":36413,"_1713":36824},[],"mTLS con certificado X.509",{"_8437":1088,"_23077":934,"_19595":36826,"_5":23231,"_15751":36413,"_1713":36827},[],"Certificado y clave privada cliente",{"_8437":1089,"_23077":934,"_19595":36829,"_5":23231,"_15751":36413,"_1713":34895},[],{"_8437":1090,"_23077":934,"_19595":36831,"_5":23231,"_15751":36413,"_1713":36832},[],"Sí (con el certificado en vigor)",{"_8437":1091,"_23077":934,"_19595":36834,"_5":23231,"_15751":36413,"_1713":36572},[],{"_8437":1092,"_23077":934,"_19595":36836,"_5":23231,"_15751":36413,"_1713":36837},[],"mTLS más validación por webhook",{"_8437":1093,"_23077":934,"_19595":36839,"_5":23231,"_15751":36413,"_1713":36840},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_8437":1094,"_23077":934,"_19595":36842,"_5":23231,"_15751":36413,"_1713":34895},[],{"_8437":1095,"_23077":934,"_19595":36844,"_5":23231,"_15751":36413,"_1713":36845},[],"No como combinación; en reenroll no mantiene ambos controles",{"_8437":1096,"_23077":934,"_19595":36847,"_5":23231,"_15751":36413,"_1713":36566},[],{"_8437":1097,"_23077":934,"_19595":36849,"_5":23231,"_15751":36413,"_1713":36850},[],"Webhook externo de autorización",{"_8437":1098,"_23077":934,"_19595":36852,"_5":23231,"_15751":36413,"_1713":36853},[],"Ninguna en el canal TLS",{"_8437":1099,"_23077":934,"_19595":36855,"_5":23231,"_15751":36413,"_1713":34895},[],{"_8437":1100,"_23077":934,"_19595":36857,"_5":23231,"_15751":36413,"_1713":36858},[],"No, degrada a `NO_AUTH`",{"_8437":1101,"_23077":934,"_19595":36860,"_5":23231,"_15751":36413,"_1713":36578},[],{"_8437":1102,"_23077":934,"_19595":36862,"_5":23231,"_15751":36413,"_1713":36863},[],"Sin autenticación",{"_8437":1103,"_23077":934,"_19595":36865,"_5":23231,"_15751":36413,"_1713":36866},[],"Ninguna",{"_8437":1104,"_23077":934,"_19595":36868,"_5":23231,"_15751":36413,"_1713":36869},[],"Sí (uso restringido)",{"_8437":1105,"_23077":934,"_19595":36871,"_5":23231,"_15751":36413,"_1713":36869},[],{"_8437":1106,"_23077":934,"_19595":36873,"_5":23231,"_15751":36413,"_1713":36874},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_8437":1107,"_23077":934,"_19595":36876,"_5":23231,"_15751":36413,"_1713":36877},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_8437":1108,"_23077":934,"_19595":36879,"_5":23231,"_15751":36413,"_1713":34879},[],{"_8437":1109,"_23077":934,"_19595":36881,"_5":23231,"_15751":36413,"_1713":34882},[],{"_8437":1110,"_23077":934,"_19595":36883,"_5":23231,"_15751":36413,"_1713":33748},[],{"_8437":1111,"_23077":934,"_19595":36885,"_5":23231,"_15751":36413,"_1713":36886},[],"`ValidationCAs`",{"_8437":1112,"_23077":934,"_19595":36888,"_5":23231,"_15751":36413,"_1713":36889},[],"lista de IDs de CA",{"_8437":1113,"_23077":934,"_19595":36891,"_5":23231,"_15751":36413,"_1713":36892},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_8437":1114,"_23077":934,"_19595":36894,"_5":23231,"_15751":36413,"_1713":36895},[],"`AllowExpired`",{"_8437":1115,"_23077":934,"_19595":36897,"_5":23231,"_15751":36413,"_1713":21337},[],{"_8437":1116,"_23077":934,"_19595":36899,"_5":23231,"_15751":36413,"_1713":36900},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_8437":1117,"_23077":934,"_19595":36902,"_5":23231,"_15751":36413,"_1713":36903},[],"`ChainLevelValidation`",{"_8437":1118,"_23077":934,"_19595":36905,"_5":23231,"_15751":36413,"_1713":4524},[],{"_8437":1119,"_23077":934,"_19595":36907,"_5":23231,"_15751":36413,"_1713":36908},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_8437":1120,"_23077":934,"_19595":36910,"_5":23231,"_15751":36413,"_1713":36911},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_8437":1121,"_23077":934,"_19595":36913,"_5":23231,"_15751":36413,"_1713":36914},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_8437":1122,"_23077":934,"_19595":36916,"_5":23231,"_15751":36413,"_1713":36917},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_8437":1123,"_23077":934,"_19595":36919,"_5":23231,"_15751":36413,"_1713":36920},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_8437":1124,"_23077":934,"_19595":36922,"_5":23231,"_15751":36417,"_1713":36923},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_8437":1125,"_23077":934,"_19595":36925,"_5":23231,"_15751":36417,"_1713":36926},[],"`/cacerts`: descarga de la cadena de confianza.",{"_8437":1126,"_23077":934,"_19595":36928,"_5":23231,"_15751":36417,"_1713":36929},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_8437":1127,"_23077":934,"_19595":36931,"_5":23231,"_15751":36417,"_1713":36932},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_8437":1128,"_23077":934,"_19595":36934,"_5":23231,"_15751":36417,"_1713":36935},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_8437":1129,"_23077":934,"_19595":36937,"_5":23231,"_15751":36421,"_1713":36938},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_8437":1130,"_23077":934,"_19595":36940,"_5":23231,"_15751":36421,"_1713":36941},[],"Campo de `CADistributionSettings`",{"_8437":1131,"_23077":934,"_19595":36943,"_5":23231,"_15751":36421,"_1713":34882},[],{"_8437":1132,"_23077":934,"_19595":36945,"_5":23231,"_15751":36421,"_1713":33748},[],{"_8437":1133,"_23077":934,"_19595":36947,"_5":23231,"_15751":36421,"_1713":36948},[],"`IncludeLamassuSystemCA`",{"_8437":1134,"_23077":934,"_19595":36950,"_5":23231,"_15751":36421,"_1713":21337},[],{"_8437":1135,"_23077":934,"_19595":36952,"_5":23231,"_15751":36421,"_1713":36953},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_8437":1136,"_23077":934,"_19595":36955,"_5":23231,"_15751":36421,"_1713":36956},[],"`IncludeEnrollmentCA`",{"_8437":1137,"_23077":934,"_19595":36958,"_5":23231,"_15751":36421,"_1713":21337},[],{"_8437":1138,"_23077":934,"_19595":36960,"_5":23231,"_15751":36421,"_1713":36961},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_8437":1139,"_23077":934,"_19595":36963,"_5":23231,"_15751":36421,"_1713":36964},[],"`ManagedCAs`",{"_8437":1140,"_23077":934,"_19595":36966,"_5":23231,"_15751":36421,"_1713":36889},[],{"_8437":1141,"_23077":934,"_19595":36968,"_5":23231,"_15751":36421,"_1713":36969},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_8437":1142,"_23077":934,"_19595":36971,"_5":23231,"_15751":36421,"_1713":36972},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_8437":1143,"_23077":934,"_19595":36974,"_5":23231,"_15751":36421,"_1713":36975},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_8437":1144,"_23077":934,"_19595":36977,"_5":23231,"_15751":36421,"_1713":36978},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_8437":1145,"_23077":934,"_19595":36980,"_5":23231,"_15751":36421,"_1713":36981},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_8437":1146,"_23077":934,"_19595":36983,"_5":23231,"_15751":36425,"_1713":36984},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_8437":1147,"_23077":934,"_19595":36986,"_5":23231,"_15751":36425,"_1713":36987},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_8437":1148,"_23077":934,"_19595":36989,"_5":23231,"_15751":36425,"_1713":36990},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_8437":1149,"_23077":934,"_19595":36992,"_5":23231,"_15751":36425,"_1713":36617},[],{"_8437":1150,"_23077":934,"_19595":36994,"_5":23231,"_15751":36425,"_1713":34882},[],{"_8437":1151,"_23077":934,"_19595":36996,"_5":23231,"_15751":36425,"_1713":36997},[],"Efecto",{"_8437":1152,"_23077":934,"_19595":36999,"_5":23231,"_15751":36425,"_1713":37000},[],"`EnrollmentSettings.RegistrationMode`",{"_8437":1153,"_23077":934,"_19595":37002,"_5":23231,"_15751":36425,"_1713":37003},[],"`JITP` / `PRE_REGISTRATION`",{"_8437":1154,"_23077":934,"_19595":37005,"_5":23231,"_15751":36425,"_1713":37006},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_8437":1155,"_23077":934,"_19595":37008,"_5":23231,"_15751":36425,"_1713":37009},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_8437":1156,"_23077":934,"_19595":37011,"_5":23231,"_15751":36425,"_1713":21337},[],{"_8437":1157,"_23077":934,"_19595":37013,"_5":23231,"_15751":36425,"_1713":37014},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_8437":1158,"_23077":934,"_19595":37016,"_5":23231,"_15751":36425,"_1713":37017},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_8437":1159,"_23077":934,"_19595":37019,"_5":23231,"_15751":36425,"_1713":21337},[],{"_8437":1160,"_23077":934,"_19595":37021,"_5":23231,"_15751":36425,"_1713":37022},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_8437":1161,"_23077":934,"_19595":37024,"_5":23231,"_15751":36425,"_1713":37025},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_8437":1162,"_23077":934,"_19595":37027,"_5":23231,"_15751":36429,"_1713":37028},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_8437":1163,"_23077":934,"_19595":37030,"_5":23231,"_15751":36429,"_1713":37031},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_8437":1164,"_23077":934,"_19595":37033,"_5":23231,"_15751":36429,"_1713":37034},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_8437":1165,"_23077":934,"_19595":37036,"_5":23231,"_15751":36429,"_1713":36617},[],{"_8437":1166,"_23077":934,"_19595":37038,"_5":23231,"_15751":36429,"_1713":34882},[],{"_8437":1167,"_23077":934,"_19595":37040,"_5":23231,"_15751":36429,"_1713":36997},[],{"_8437":1168,"_23077":934,"_19595":37042,"_5":23231,"_15751":36429,"_1713":37043},[],"`ReEnrollmentDelta`",{"_8437":1169,"_23077":934,"_19595":37045,"_5":23231,"_15751":36429,"_1713":37046},[],"duración",{"_8437":1170,"_23077":934,"_19595":37048,"_5":23231,"_15751":36429,"_1713":37049},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_8437":1171,"_23077":934,"_19595":37051,"_5":23231,"_15751":36429,"_1713":37052},[],"`EnableExpiredRenewal`",{"_8437":1172,"_23077":934,"_19595":37054,"_5":23231,"_15751":36429,"_1713":21337},[],{"_8437":1173,"_23077":934,"_19595":37056,"_5":23231,"_15751":36429,"_1713":37057},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_8437":1174,"_23077":934,"_19595":37059,"_5":23231,"_15751":36429,"_1713":37060},[],"`RevokeOnReEnrollment`",{"_8437":1175,"_23077":934,"_19595":37062,"_5":23231,"_15751":36429,"_1713":21337},[],{"_8437":1176,"_23077":934,"_19595":37064,"_5":23231,"_15751":36429,"_1713":37065},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_8437":1177,"_23077":934,"_19595":37067,"_5":23231,"_15751":36429,"_1713":37068},[],"`AdditionalValidationCAs`",{"_8437":1178,"_23077":934,"_19595":37070,"_5":23231,"_15751":36429,"_1713":36889},[],{"_8437":1179,"_23077":934,"_19595":37072,"_5":23231,"_15751":36429,"_1713":37073},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_8437":1180,"_23077":934,"_19595":37075,"_5":23231,"_15751":36429,"_1713":37076},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_8437":1181,"_23077":934,"_19595":37078,"_5":23231,"_15751":36429,"_1713":37079},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_8437":1182,"_23077":934,"_19595":37081,"_5":23231,"_15751":36433,"_1713":37082},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_8437":1183,"_23077":934,"_19595":37084,"_5":23231,"_15751":36433,"_1713":37085},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_8437":1184,"_23077":934,"_19595":37087,"_5":23231,"_15751":36433,"_1713":37088},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_8437":1185,"_23077":934,"_19595":37090,"_5":23231,"_15751":36433,"_1713":37091},[],"Tipo de clave",{"_8437":1186,"_23077":934,"_19595":37093,"_5":23231,"_15751":36433,"_1713":37094},[],"Parámetro válido",{"_8437":1187,"_23077":934,"_19595":37096,"_5":23231,"_15751":36433,"_1713":37097},[],"Curva NIST equivalente",{"_8437":1188,"_23077":934,"_19595":37099,"_5":23231,"_15751":36433,"_1713":37100},[],"Comportamiento ante valores no válidos",{"_8437":1189,"_23077":934,"_19595":37102,"_5":23231,"_15751":36433,"_1713":37103},[],"`RSA`",{"_8437":1190,"_23077":934,"_19595":37105,"_5":23231,"_15751":36433,"_1713":37106},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_8437":1191,"_23077":934,"_19595":37108,"_5":23231,"_15751":36433,"_1713":37109},[],"No aplica",{"_8437":1192,"_23077":934,"_19595":37111,"_5":23231,"_15751":36433,"_1713":37112},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_8437":1193,"_23077":934,"_19595":37114,"_5":23231,"_15751":36433,"_1713":37115},[],"`ECDSA`",{"_8437":1194,"_23077":934,"_19595":37117,"_5":23231,"_15751":36433,"_1713":37118},[],"224, 256, 384, 521",{"_8437":1195,"_23077":934,"_19595":37120,"_5":23231,"_15751":36433,"_1713":37121},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_8437":1196,"_23077":934,"_19595":37123,"_5":23231,"_15751":36433,"_1713":37124},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_8437":1197,"_23077":934,"_19595":37126,"_5":23231,"_15751":36433,"_1713":37127},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_8437":1198,"_23077":934,"_19595":37129,"_5":23231,"_15751":36433,"_1713":37130},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_8437":1199,"_23077":934,"_19595":37132,"_5":23231,"_15751":36433,"_1713":37133},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_8437":1200,"_23077":934,"_19595":37135,"_5":23231,"_15751":36433,"_1713":37136},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_8437":1201,"_23077":934,"_19595":37138,"_5":23231,"_15751":36433,"_1713":37139},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_8437":1202,"_23077":934,"_19595":37141,"_5":23231,"_15751":36433,"_1713":37142},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_8437":1203,"_23077":934,"_19595":37144,"_5":23231,"_15751":36433,"_1713":37145},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_8437":1204,"_23077":934,"_19595":37147,"_5":23231,"_15751":36437,"_1713":37148},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_8437":1205,"_23077":934,"_19595":37150,"_5":23231,"_15751":36441,"_1713":37151},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_8437":1206,"_23077":934,"_19595":37153,"_5":23231,"_15751":36445,"_1713":37154},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_8437":1207,"_23077":934,"_19595":37156,"_5":23231,"_15751":36449,"_1713":37157},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_8437":1208,"_23077":934,"_19595":37159,"_5":23231,"_15751":36449,"_1713":37160},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_8437":1209,"_23077":934,"_19595":37162,"_5":23231,"_15751":36449,"_1713":37163},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_8437":1210,"_23077":934,"_19595":37165,"_5":23231,"_15751":36449,"_1713":37166},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_8437":1211,"_23077":934,"_19595":37168,"_5":23231,"_15751":36457,"_1713":37169},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_8437":1212,"_23077":934,"_19595":37171,"_5":23231,"_15751":36457,"_1713":37172},[],"HTTP",{"_8437":1213,"_23077":934,"_19595":37174,"_5":23231,"_15751":36457,"_1713":37175},[],"Mensaje",{"_8437":1214,"_23077":934,"_19595":37177,"_5":23231,"_15751":36457,"_1713":37178},[],"Causa",{"_8437":1215,"_23077":934,"_19595":37180,"_5":23231,"_15751":36457,"_1713":37181},[],"Acción del integrador",{"_8437":1216,"_23077":934,"_19595":37183,"_5":23231,"_15751":36457,"_1713":20431},[],{"_8437":1217,"_23077":934,"_19595":37185,"_5":23231,"_15751":36457,"_1713":37186},[],"`Field validation for 'APS' failed`",{"_8437":1218,"_23077":934,"_19595":37188,"_5":23231,"_15751":36457,"_1713":37189},[],"El segmento `{aps}` falta en la URL.",{"_8437":1219,"_23077":934,"_19595":37191,"_5":23231,"_15751":36457,"_1713":37192},[],"Incluir el ID del DMS en la ruta.",{"_8437":1220,"_23077":934,"_19595":37194,"_5":23231,"_15751":36457,"_1713":20431},[],{"_8437":1221,"_23077":934,"_19595":37196,"_5":23231,"_15751":36457,"_1713":37197},[],"`content-type must be application/pkcs10`",{"_8437":1222,"_23077":934,"_19595":37199,"_5":23231,"_15751":36457,"_1713":37200},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_8437":1223,"_23077":934,"_19595":37202,"_5":23231,"_15751":36457,"_1713":37203},[],"Fijar `Content-Type: application/pkcs10`.",{"_8437":1224,"_23077":934,"_19595":37205,"_5":23231,"_15751":36457,"_1713":20431},[],{"_8437":1225,"_23077":934,"_19595":37207,"_5":23231,"_15751":36457,"_1713":37208},[],"`body payload must be base64 encoded`",{"_8437":1226,"_23077":934,"_19595":37210,"_5":23231,"_15751":36457,"_1713":37211},[],"El cuerpo no es base64 válido.",{"_8437":1227,"_23077":934,"_19595":37213,"_5":23231,"_15751":36457,"_1713":37214},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_8437":1228,"_23077":934,"_19595":37216,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1229,"_23077":934,"_19595":37218,"_5":23231,"_15751":36457,"_1713":37219},[],"`DMS not found`",{"_8437":1230,"_23077":934,"_19595":37221,"_5":23231,"_15751":36457,"_1713":37222},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_8437":1231,"_23077":934,"_19595":37224,"_5":23231,"_15751":36457,"_1713":37225},[],"Verificar el identificador con el administrador PKI.",{"_8437":1232,"_23077":934,"_19595":37227,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1233,"_23077":934,"_19595":37229,"_5":23231,"_15751":36457,"_1713":37230},[],"`invalid certificate`",{"_8437":1234,"_23077":934,"_19595":37232,"_5":23231,"_15751":36457,"_1713":37233},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_8437":1235,"_23077":934,"_19595":37235,"_5":23231,"_15751":36457,"_1713":37236},[],"Comprobar la cadena del certificado bootstrap.",{"_8437":1236,"_23077":934,"_19595":37238,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1237,"_23077":934,"_19595":37240,"_5":23231,"_15751":36457,"_1713":37241},[],"`certificate is revoked`",{"_8437":1238,"_23077":934,"_19595":37243,"_5":23231,"_15751":36457,"_1713":37244},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_8437":1239,"_23077":934,"_19595":37246,"_5":23231,"_15751":36457,"_1713":37247},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_8437":1240,"_23077":934,"_19595":37249,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1241,"_23077":934,"_19595":37251,"_5":23231,"_15751":36457,"_1713":37252},[],"`revoked certificate`",{"_8437":1242,"_23077":934,"_19595":37254,"_5":23231,"_15751":36457,"_1713":37255},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_8437":1243,"_23077":934,"_19595":37257,"_5":23231,"_15751":36457,"_1713":37258},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_8437":1244,"_23077":934,"_19595":37260,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1245,"_23077":934,"_19595":37262,"_5":23231,"_15751":36457,"_1713":37263},[],"`expired certificate`",{"_8437":1246,"_23077":934,"_19595":37265,"_5":23231,"_15751":36457,"_1713":37266},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_8437":1247,"_23077":934,"_19595":37268,"_5":23231,"_15751":36457,"_1713":37269},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_8437":1248,"_23077":934,"_19595":37271,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1249,"_23077":934,"_19595":37273,"_5":23231,"_15751":36457,"_1713":37274},[],"`forbiddenNewEnrollment`",{"_8437":1250,"_23077":934,"_19595":37276,"_5":23231,"_15751":36457,"_1713":37277},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_8437":1251,"_23077":934,"_19595":37279,"_5":23231,"_15751":36457,"_1713":37280},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_8437":1252,"_23077":934,"_19595":37282,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1253,"_23077":934,"_19595":37284,"_5":23231,"_15751":36457,"_1713":37285},[],"`device not preregistered`",{"_8437":1254,"_23077":934,"_19595":37287,"_5":23231,"_15751":36457,"_1713":37288},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_8437":1255,"_23077":934,"_19595":37290,"_5":23231,"_15751":36457,"_1713":37291},[],"Registrar el dispositivo antes de inscribirlo.",{"_8437":1256,"_23077":934,"_19595":37293,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1257,"_23077":934,"_19595":37295,"_5":23231,"_15751":36457,"_1713":37296},[],"`invalid reenroll window`",{"_8437":1258,"_23077":934,"_19595":37298,"_5":23231,"_15751":36457,"_1713":37299},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_8437":1259,"_23077":934,"_19595":37301,"_5":23231,"_15751":36457,"_1713":37302},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_8437":1260,"_23077":934,"_19595":37304,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1261,"_23077":934,"_19595":37306,"_5":23231,"_15751":36457,"_1713":37307},[],"`invalid RawSubject bytes`",{"_8437":1262,"_23077":934,"_19595":37309,"_5":23231,"_15751":36457,"_1713":37310},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_8437":1263,"_23077":934,"_19595":37312,"_5":23231,"_15751":36457,"_1713":37313},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_8437":1264,"_23077":934,"_19595":37315,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1265,"_23077":934,"_19595":37317,"_5":23231,"_15751":36457,"_1713":37318},[],"`external webhook denied enrollment`",{"_8437":1266,"_23077":934,"_19595":37320,"_5":23231,"_15751":36457,"_1713":37321},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_8437":1267,"_23077":934,"_19595":37323,"_5":23231,"_15751":36457,"_1713":37324},[],"Revisar los logs del servicio webhook.",{"_8437":1268,"_23077":934,"_19595":37326,"_5":23231,"_15751":36457,"_1713":20962},[],{"_8437":1269,"_23077":934,"_19595":37328,"_5":23231,"_15751":36457,"_1713":37329},[],"`server key generation not enabled`",{"_8437":1270,"_23077":934,"_19595":37331,"_5":23231,"_15751":36457,"_1713":37332},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_8437":1271,"_23077":934,"_19595":37334,"_5":23231,"_15751":36457,"_1713":37335},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_8437":1272,"_23077":934,"_19595":37337,"_5":23231,"_15751":36457,"_1713":37338},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_8437":1273,"_23077":934,"_19595":37340,"_5":23231,"_15751":36461,"_1713":37341},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_8437":1274,"_23077":934,"_19595":37343,"_5":23231,"_15751":36461,"_1713":37344},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_8437":1275,"_23077":934,"_19595":37346,"_5":23231,"_15751":36461,"_1713":37347},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_8437":1276,"_23077":934,"_19595":37349,"_5":23231,"_15751":36461,"_1713":37350},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_8437":1277,"_23077":934,"_19595":37352,"_5":23231,"_15751":36461,"_1713":37353},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_8437":1278,"_23077":934,"_19595":37355,"_5":23231,"_15751":36461,"_1713":37356},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_8437":1279,"_23077":934,"_19595":37358,"_5":23231,"_15751":36461,"_1713":37359},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_8437":1280,"_23077":934,"_19595":37361,"_5":23231,"_15751":36461,"_1713":37362},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_8437":1281,"_23077":934,"_19595":37364,"_5":23231,"_15751":36461,"_1713":37365},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_8437":1282,"_23077":934,"_19595":37367,"_5":23231,"_15751":36461,"_1713":37368},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_8437":1283,"_23077":1283,"_5":23226,"_1713":37370,"_23239":37371,"_19595":37372,"_15751":1283},"[KMS] Gestión de Claves Criptográficas",[33545,34644,34653],[],{"_8437":1284,"_23077":1283,"_19595":37374,"_5":23231,"_15751":1283,"_1713":37375},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_8437":1285,"_23077":1283,"_5":23236,"_19595":37377,"_15751":37378,"_1713":37379},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_8437":1286,"_23077":1283,"_5":23236,"_19595":37381,"_15751":37382,"_1713":37383},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_8437":1287,"_23077":1283,"_5":23236,"_19595":37385,"_15751":37386,"_1713":37387},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_8437":1288,"_23077":1283,"_5":23236,"_19595":37389,"_15751":37390,"_1713":37391},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_8437":1289,"_23077":1283,"_5":23236,"_19595":37393,"_15751":37394,"_1713":37395},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_8437":1290,"_23077":1283,"_5":23236,"_19595":37397,"_15751":37398,"_1713":37399},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_8437":1291,"_23077":1283,"_5":23236,"_19595":37401,"_15751":37402,"_1713":37403},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_8437":1292,"_23077":1283,"_5":23236,"_19595":37405,"_15751":37406,"_1713":37407},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_8437":1293,"_23077":1283,"_5":23236,"_19595":37409,"_15751":37410,"_1713":37411},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_8437":1294,"_23077":1283,"_5":23236,"_19595":37413,"_15751":37414,"_1713":37415},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_8437":1295,"_23077":1283,"_5":23236,"_19595":37417,"_15751":37418,"_1713":37419},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#sign","Sign",{"_8437":1296,"_23077":1283,"_5":23236,"_19595":37421,"_15751":37422,"_1713":37423},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#verify","Verify",{"_8437":1297,"_23077":1283,"_5":23236,"_19595":37425,"_15751":37426,"_1713":37427},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_8437":1298,"_23077":1283,"_5":23236,"_19595":37429,"_15751":37430,"_1713":37431},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_8437":1299,"_23077":1283,"_19595":37433,"_5":23231,"_15751":37378,"_1713":37434},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_8437":1300,"_23077":1283,"_19595":37436,"_5":23231,"_15751":37378,"_1713":37437},[],"Lamassu IoT trabaja con claves asimétricas: además de RSA y curvas elípticas, soporta algoritmos post-cuánticos (ML-DSA y SLH-DSA), Ed25519 y firmas compuestas que combinan ML-DSA con un algoritmo tradicional. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_8437":1301,"_23077":1283,"_19595":37439,"_5":23231,"_15751":37378,"_1713":37440},[],"Consulte Criptografía post-cuántica (LamassuQ) para conocer los nuevos tipos de clave, sus parámetros y las limitaciones de motor que aplican.",{"_8437":1302,"_23077":1283,"_19595":37442,"_5":23231,"_15751":37382,"_1713":37443},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_8437":1303,"_23077":1283,"_19595":37445,"_5":23231,"_15751":37382,"_1713":37446},[],"En la práctica, permite:",{"_8437":1304,"_23077":1283,"_19595":37448,"_5":23231,"_15751":37382,"_1713":37449},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_8437":1305,"_23077":1283,"_19595":37451,"_5":23231,"_15751":37382,"_1713":37452},[],"Importar claves creadas externamente.",{"_8437":1306,"_23077":1283,"_19595":37454,"_5":23231,"_15751":37382,"_1713":37455},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_8437":1307,"_23077":1283,"_19595":37457,"_5":23231,"_15751":37382,"_1713":37458},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_8437":1308,"_23077":1283,"_19595":37460,"_5":23231,"_15751":37386,"_1713":37461},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_8437":1309,"_23077":1283,"_19595":37463,"_5":23231,"_15751":37386,"_1713":37464},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_8437":1310,"_23077":1283,"_19595":37466,"_5":23231,"_15751":37386,"_1713":37467},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_8437":1311,"_23077":1283,"_19595":37469,"_5":23231,"_15751":37386,"_1713":37470},[],"Crypto Engine",{"_8437":1312,"_23077":1283,"_19595":37472,"_5":23231,"_15751":37386,"_1713":37473},[],"Nivel de seguridad",{"_8437":1313,"_23077":1283,"_19595":37475,"_5":23231,"_15751":37386,"_1713":37476},[],"OnPrem / Cloud",{"_8437":1314,"_23077":1283,"_19595":37478,"_5":23231,"_15751":37386,"_1713":37479},[],"Coste adicional",{"_8437":1315,"_23077":1283,"_19595":37481,"_5":23231,"_15751":37386,"_1713":37482},[],"Generación de claves",{"_8437":1316,"_23077":1283,"_19595":37484,"_5":23231,"_15751":37386,"_1713":37485},[],"Persistencia *at-rest* segura",{"_8437":1317,"_23077":1283,"_19595":37487,"_5":23231,"_15751":37386,"_1713":37488},[],"Filtración de claves",{"_8437":1318,"_23077":1283,"_19595":37490,"_5":23231,"_15751":37386,"_1713":37491},[],"Consideraciones",{"_8437":1319,"_23077":1283,"_19595":37493,"_5":23231,"_15751":37386,"_1713":37494},[],"File System",{"_8437":1320,"_23077":1283,"_19595":37496,"_5":23231,"_15751":37386,"_1713":11799},[],{"_8437":1321,"_23077":1283,"_19595":37498,"_5":23231,"_15751":37386,"_1713":37499},[],"OnPrem y Cloud",{"_8437":1322,"_23077":1283,"_19595":37501,"_5":23231,"_15751":37386,"_1713":34947},[],{"_8437":1323,"_23077":1283,"_19595":37503,"_5":23231,"_15751":37386,"_1713":37504},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_8437":1324,"_23077":1283,"_19595":37506,"_5":23231,"_15751":37386,"_1713":37507},[],"**Insegura**. Delegada en el sistema de archivos.",{"_8437":1325,"_23077":1283,"_19595":37509,"_5":23231,"_15751":37386,"_1713":37507},[],{"_8437":1326,"_23077":1283,"_19595":37511,"_5":23231,"_15751":37386,"_1713":37512},[],"No recomendado para producción.",{"_8437":1327,"_23077":1283,"_19595":37514,"_5":23231,"_15751":37386,"_1713":37515},[],"HashiCorp Vault",{"_8437":1328,"_23077":1283,"_19595":37517,"_5":23231,"_15751":37386,"_1713":4218},[],{"_8437":1329,"_23077":1283,"_19595":37519,"_5":23231,"_15751":37386,"_1713":37499},[],{"_8437":1330,"_23077":1283,"_19595":37521,"_5":23231,"_15751":37386,"_1713":34947},[],{"_8437":1331,"_23077":1283,"_19595":37523,"_5":23231,"_15751":37386,"_1713":37524},[],"Depende de la configuración de Vault.",{"_8437":1332,"_23077":1283,"_19595":37526,"_5":23231,"_15751":37386,"_1713":37527},[],"**Segura**",{"_8437":1333,"_23077":1283,"_19595":37529,"_5":23231,"_15751":37386,"_1713":37530},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_8437":1334,"_23077":1283,"_19595":37532,"_5":23231,"_15751":37386,"_1713":37533},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_8437":1335,"_23077":1283,"_19595":37535,"_5":23231,"_15751":37386,"_1713":37536},[],"AWS Secrets Manager",{"_8437":1336,"_23077":1283,"_19595":37538,"_5":23231,"_15751":37386,"_1713":4218},[],{"_8437":1337,"_23077":1283,"_19595":37540,"_5":23231,"_15751":37386,"_1713":37541},[],"Cloud",{"_8437":1338,"_23077":1283,"_19595":37543,"_5":23231,"_15751":37386,"_1713":34895},[],{"_8437":1339,"_23077":1283,"_19595":37545,"_5":23231,"_15751":37386,"_1713":37546},[],"Depende del proceso de alta de la clave.",{"_8437":1340,"_23077":1283,"_19595":37548,"_5":23231,"_15751":37386,"_1713":37527},[],{"_8437":1341,"_23077":1283,"_19595":37550,"_5":23231,"_15751":37386,"_1713":37530},[],{"_8437":1342,"_23077":1283,"_19595":37552,"_5":23231,"_15751":37386,"_1713":37553},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_8437":1343,"_23077":1283,"_19595":37555,"_5":23231,"_15751":37386,"_1713":37556},[],"AWS KMS",{"_8437":1344,"_23077":1283,"_19595":37558,"_5":23231,"_15751":37386,"_1713":7042},[],{"_8437":1345,"_23077":1283,"_19595":37560,"_5":23231,"_15751":37386,"_1713":37541},[],{"_8437":1346,"_23077":1283,"_19595":37562,"_5":23231,"_15751":37386,"_1713":34895},[],{"_8437":1347,"_23077":1283,"_19595":37564,"_5":23231,"_15751":37386,"_1713":37565},[],"**Entropía hardware**",{"_8437":1348,"_23077":1283,"_19595":37567,"_5":23231,"_15751":37386,"_1713":37527},[],{"_8437":1349,"_23077":1283,"_19595":37569,"_5":23231,"_15751":37386,"_1713":37527},[],{"_8437":1350,"_23077":1283,"_19595":37571,"_5":23231,"_15751":37386,"_1713":37572},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_8437":1351,"_23077":1283,"_19595":37574,"_5":23231,"_15751":37386,"_1713":37575},[],"PKCS11",{"_8437":1352,"_23077":1283,"_19595":37577,"_5":23231,"_15751":37386,"_1713":37578},[],"3\\*",{"_8437":1353,"_23077":1283,"_19595":37580,"_5":23231,"_15751":37386,"_1713":37581},[],"AirGap OnPrem y Cloud",{"_8437":1354,"_23077":1283,"_19595":37583,"_5":23231,"_15751":37386,"_1713":37584},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_8437":1355,"_23077":1283,"_19595":37586,"_5":23231,"_15751":37386,"_1713":37565},[],{"_8437":1356,"_23077":1283,"_19595":37588,"_5":23231,"_15751":37386,"_1713":37589},[],"**Segura**\\*",{"_8437":1357,"_23077":1283,"_19595":37591,"_5":23231,"_15751":37386,"_1713":37592},[],"Depende del HSM",{"_8437":1358,"_23077":1283,"_19595":37594,"_5":23231,"_15751":37386,"_1713":37595},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_8437":1359,"_23077":1283,"_19595":37597,"_5":23231,"_15751":37386,"_1713":37598},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_8437":1360,"_23077":1283,"_19595":37600,"_5":23231,"_15751":37386,"_1713":37601},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_8437":1361,"_23077":1283,"_19595":37603,"_5":23231,"_15751":37386,"_1713":37604},[],"Los algoritmos post-cuánticos, Ed25519 y las firmas compuestas solo pueden generarse e importarse en el motor software (Golang) y en el motor File System. El resto de motores externos rechazan estos tipos de clave con el error `unsupported key type`. Consulte Motores criptográficos compatibles.",{"_8437":1362,"_23077":1283,"_19595":37606,"_5":23231,"_15751":37386,"_1713":37607},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_8437":1363,"_23077":1283,"_19595":37609,"_5":23231,"_15751":37390,"_1713":37610},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_8437":1364,"_23077":1283,"_19595":37612,"_5":23231,"_15751":37390,"_1713":37613},[],"La tabla incluye los siguientes campos:",{"_8437":1365,"_23077":1283,"_19595":37615,"_5":23231,"_15751":37390,"_1713":37616},[],"**Name**: nombre descriptivo de la clave.",{"_8437":1366,"_23077":1283,"_19595":37618,"_5":23231,"_15751":37390,"_1713":37619},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048, EC P-256, ML-DSA 65 o Composite-ML-DSA-ECDSA 10.",{"_8437":1367,"_23077":1283,"_19595":37621,"_5":23231,"_15751":37390,"_1713":37622},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_8437":1368,"_23077":1283,"_19595":37624,"_5":23231,"_15751":37390,"_1713":37625},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_8437":1369,"_23077":1283,"_19595":37627,"_5":23231,"_15751":37390,"_1713":37628},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_8437":1370,"_23077":1283,"_19595":37630,"_5":23231,"_15751":37390,"_1713":37631},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_8437":1371,"_23077":1283,"_19595":37633,"_5":23231,"_15751":37390,"_1713":37634},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_8437":1372,"_23077":1283,"_19595":37636,"_5":23231,"_15751":37390,"_1713":37637},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_8437":1373,"_23077":1283,"_19595":37639,"_5":23231,"_15751":37390,"_1713":37640},[],"Desde esta vista también se accede a las acciones más habituales:",{"_8437":1374,"_23077":1283,"_19595":37642,"_5":23231,"_15751":37390,"_1713":37643},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_8437":1375,"_23077":1283,"_19595":37645,"_5":23231,"_15751":37390,"_1713":37646},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_8437":1376,"_23077":1283,"_19595":37648,"_5":23231,"_15751":37390,"_1713":37649},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_8437":1377,"_23077":1283,"_19595":37651,"_5":23231,"_15751":37390,"_1713":37652},[],"**Delete Key** para eliminar la clave del sistema.",{"_8437":1378,"_23077":1283,"_19595":37654,"_5":23231,"_15751":37394,"_1713":37655},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_8437":1379,"_23077":1283,"_19595":37657,"_5":23231,"_15751":37398,"_1713":37658},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_8437":1380,"_23077":1283,"_19595":37660,"_5":23231,"_15751":37398,"_1713":37661},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_8437":1381,"_23077":1283,"_19595":37663,"_5":23231,"_15751":37398,"_1713":37664},[],"**Key Name**: nombre único y descriptivo.",{"_8437":1382,"_23077":1283,"_19595":37666,"_5":23231,"_15751":37398,"_1713":37667},[],"**Crypto Engine**: motor que custodiará la clave.",{"_8437":1383,"_23077":1283,"_19595":37669,"_5":23231,"_15751":37398,"_1713":37670},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva. Además de RSA y curvas elípticas, se pueden seleccionar ML-DSA (44, 65 o 87), SLH-DSA (parámetros 1 a 12), Ed25519 y las variantes compuestas; consulte Criptografía post-cuántica (LamassuQ).",{"_8437":1384,"_23077":1283,"_19595":37672,"_5":23231,"_15751":37398,"_1713":37673},[],"**Tags**: metadatos para clasificar la clave.",{"_8437":1385,"_23077":1283,"_19595":37675,"_5":23231,"_15751":37398,"_1713":37676},[],"**Metadata**: información adicional para usos avanzados.",{"_8437":1386,"_23077":1283,"_19595":37678,"_5":23231,"_15751":37402,"_1713":37679},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_8437":1387,"_23077":1283,"_19595":37681,"_5":23231,"_15751":37402,"_1713":37682},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_8437":1388,"_23077":1283,"_19595":37684,"_5":23231,"_15751":37402,"_1713":37685},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_8437":1389,"_23077":1283,"_19595":37687,"_5":23231,"_15751":37402,"_1713":37688},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_8437":1390,"_23077":1283,"_19595":37690,"_5":23231,"_15751":37402,"_1713":37691},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_8437":1391,"_23077":1283,"_19595":37693,"_5":23231,"_15751":37402,"_1713":37694},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_8437":1392,"_23077":1283,"_19595":37696,"_5":23231,"_15751":37402,"_1713":37697},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_8437":1393,"_23077":1283,"_19595":37699,"_5":23231,"_15751":37402,"_1713":37700},[],"**Tags**: etiquetas para organización y búsqueda.",{"_8437":1394,"_23077":1283,"_19595":37702,"_5":23231,"_15751":37402,"_1713":37703},[],"**Metadata**: información adicional opcional.",{"_8437":1395,"_23077":1283,"_19595":37705,"_5":23231,"_15751":37402,"_1713":37706},[],"**Private Key (PEM)**: clave privada en formato PEM. Para los tipos post-cuánticos, Ed25519 y compuestos, el formato requerido es PKCS#8; consulte Importación de claves post-cuánticas.",{"_8437":1396,"_23077":1283,"_19595":37708,"_5":23231,"_15751":37402,"_1713":37709},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_8437":1397,"_23077":1283,"_19595":37711,"_5":23231,"_15751":37406,"_1713":37712},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_8437":1398,"_23077":1283,"_19595":37714,"_5":23231,"_15751":37410,"_1713":37715},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_8437":1399,"_23077":1283,"_19595":37717,"_5":23231,"_15751":37410,"_1713":37718},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_8437":1400,"_23077":1283,"_19595":37720,"_5":23231,"_15751":37410,"_1713":37721},[],"**Key Name**: nombre descriptivo.",{"_8437":1401,"_23077":1283,"_19595":37723,"_5":23231,"_15751":37410,"_1713":37724},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_8437":1402,"_23077":1283,"_19595":37726,"_5":23231,"_15751":37410,"_1713":37727},[],"**Tags**: etiquetas asociadas.",{"_8437":1403,"_23077":1283,"_19595":37729,"_5":23231,"_15751":37410,"_1713":37730},[],"**Aliases**: nombres alternativos.",{"_8437":1404,"_23077":1283,"_19595":37732,"_5":23231,"_15751":37410,"_1713":37733},[],"**Crypto Engine**: motor en el que reside la clave.",{"_8437":1405,"_23077":1283,"_19595":37735,"_5":23231,"_15751":37410,"_1713":37736},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_8437":1406,"_23077":1283,"_19595":37738,"_5":23231,"_15751":37410,"_1713":37739},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_8437":1407,"_23077":1283,"_19595":37741,"_5":23231,"_15751":37410,"_1713":37742},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_8437":1408,"_23077":1283,"_19595":37744,"_5":23231,"_15751":37414,"_1713":37745},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_8437":1409,"_23077":1283,"_19595":37747,"_5":23231,"_15751":37414,"_1713":37748},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_8437":1410,"_23077":1283,"_19595":37750,"_5":23231,"_15751":37418,"_1713":37751},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_8437":1411,"_23077":1283,"_19595":37753,"_5":23231,"_15751":37418,"_1713":37754},[],"Campos principales:",{"_8437":1412,"_23077":1283,"_19595":37756,"_5":23231,"_15751":37418,"_1713":37757},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_8437":1413,"_23077":1283,"_19595":37759,"_5":23231,"_15751":37418,"_1713":37760},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_8437":1414,"_23077":1283,"_19595":37762,"_5":23231,"_15751":37418,"_1713":37763},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_8437":1415,"_23077":1283,"_19595":37765,"_5":23231,"_15751":37418,"_1713":37766},[],"**Message**: contenido que se va a firmar.",{"_8437":1416,"_23077":1283,"_19595":37768,"_5":23231,"_15751":37418,"_1713":37769},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_8437":1417,"_23077":1283,"_19595":37771,"_5":23231,"_15751":37418,"_1713":37772},[],"Los algoritmos post-cuánticos, Ed25519 y las firmas compuestas operan en modo PURE: firman el mensaje tal cual, sin pre-hash. En las pestañas **Sign** y **Verify**, seleccione el tipo de mensaje `Raw`. Consulte Firmas en modo PURE para los identificadores de algoritmo disponibles.",{"_8437":1418,"_23077":1283,"_19595":37774,"_5":23231,"_15751":37422,"_1713":37775},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_8437":1419,"_23077":1283,"_19595":37777,"_5":23231,"_15751":37422,"_1713":37754},[],{"_8437":1420,"_23077":1283,"_19595":37779,"_5":23231,"_15751":37422,"_1713":37780},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_8437":1421,"_23077":1283,"_19595":37782,"_5":23231,"_15751":37422,"_1713":37783},[],"**Message Type**: `Raw` o `Digest`.",{"_8437":1422,"_23077":1283,"_19595":37785,"_5":23231,"_15751":37422,"_1713":37786},[],"**Payload Encoding**: codificación del mensaje.",{"_8437":1423,"_23077":1283,"_19595":37788,"_5":23231,"_15751":37422,"_1713":37789},[],"**Message**: mensaje original o hash.",{"_8437":1424,"_23077":1283,"_19595":37791,"_5":23231,"_15751":37422,"_1713":37792},[],"**Signature**: firma que se desea comprobar.",{"_8437":1425,"_23077":1283,"_19595":37794,"_5":23231,"_15751":37422,"_1713":37795},[],"**Result**: indicador del resultado de la validación.",{"_8437":1426,"_23077":1283,"_19595":37797,"_5":23231,"_15751":37426,"_1713":37798},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_8437":1427,"_23077":1283,"_19595":37800,"_5":23231,"_15751":37426,"_1713":37801},[],"Este flujo es útil para:",{"_8437":1428,"_23077":1283,"_19595":37803,"_5":23231,"_15751":37426,"_1713":37804},[],"Solicitar certificados a una CA externa.",{"_8437":1429,"_23077":1283,"_19595":37806,"_5":23231,"_15751":37426,"_1713":37807},[],"Renovar una identidad manteniendo la misma clave.",{"_8437":1430,"_23077":1283,"_19595":37809,"_5":23231,"_15751":37426,"_1713":37810},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_8437":1431,"_23077":1283,"_19595":37812,"_5":23231,"_15751":37426,"_1713":37813},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_8437":1432,"_23077":1283,"_19595":37815,"_5":23231,"_15751":37426,"_1713":37816},[],"**Organization (O)**: organización o empresa.",{"_8437":1433,"_23077":1283,"_19595":37818,"_5":23231,"_15751":37426,"_1713":37819},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_8437":1434,"_23077":1283,"_19595":37821,"_5":23231,"_15751":37426,"_1713":37822},[],"**Country (C)**: código de país de dos letras.",{"_8437":1435,"_23077":1283,"_19595":37824,"_5":23231,"_15751":37426,"_1713":37825},[],"**State / Province (ST)**: estado o provincia.",{"_8437":1436,"_23077":1283,"_19595":37827,"_5":23231,"_15751":37426,"_1713":37828},[],"**Locality (L)**: ciudad o localidad.",{"_8437":1437,"_23077":1283,"_19595":37830,"_5":23231,"_15751":37426,"_1713":37831},[],"**Email Address**: correo de contacto.",{"_8437":1438,"_23077":1283,"_19595":37833,"_5":23231,"_15751":37426,"_1713":37834},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_8437":1439,"_23077":1283,"_19595":37836,"_5":23231,"_15751":37426,"_1713":37837},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_8437":1440,"_23077":1283,"_19595":37839,"_5":23231,"_15751":37430,"_1713":37840},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_8437":1441,"_23077":1283,"_19595":37842,"_5":23231,"_15751":37430,"_1713":37843},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_8437":1442,"_23077":1442,"_5":23226,"_1713":37845,"_23239":37846,"_19595":37847,"_15751":1442},"[LamassuQ] Criptografía post-cuántica",[33545,34644,34653],[],{"_8437":1443,"_23077":1442,"_19595":37849,"_5":23231,"_15751":1442,"_1713":37850},[],"Tipos de clave post-cuántica y compuestas disponibles en Lamassu IoT, variantes, firma en modo PURE y motores compatibles",{"_8437":1444,"_23077":1442,"_5":23236,"_19595":37852,"_15751":37853,"_1713":37854},[],"/docs/pr-preview/pr-25/manual/servicios-core/lamassuq#criptografía-post-cuántica-lamassuq","Criptografía post-cuántica (LamassuQ)",{"_8437":1445,"_23077":1442,"_5":23236,"_19595":37856,"_15751":37857,"_1713":37858},[],"/docs/pr-preview/pr-25/manual/servicios-core/lamassuq#tipos-de-clave-soportados","Tipos de clave soportados",{"_8437":1446,"_23077":1442,"_5":23236,"_19595":37860,"_15751":37861,"_1713":37862},[],"/docs/pr-preview/pr-25/manual/servicios-core/lamassuq#variantes-compuestas","Variantes compuestas",{"_8437":1447,"_23077":1442,"_5":23236,"_19595":37864,"_15751":37865,"_1713":37866},[],"/docs/pr-preview/pr-25/manual/servicios-core/lamassuq#motores-criptográficos-compatibles","Motores criptográficos compatibles",{"_8437":1448,"_23077":1442,"_5":23236,"_19595":37868,"_15751":37869,"_1713":37870},[],"/docs/pr-preview/pr-25/manual/servicios-core/lamassuq#firmas-en-modo-pure","Firmas en modo PURE",{"_8437":1449,"_23077":1442,"_5":23236,"_19595":37872,"_15751":37873,"_1713":37874},[],"/docs/pr-preview/pr-25/manual/servicios-core/lamassuq#importación-de-claves-post-cuánticas","Importación de claves post-cuánticas",{"_8437":1450,"_23077":1442,"_5":23236,"_19595":37876,"_15751":37877,"_1713":37878},[],"/docs/pr-preview/pr-25/manual/servicios-core/lamassuq#cadenas-de-certificados-mixtas","Cadenas de certificados mixtas",{"_8437":1451,"_23077":1442,"_5":23236,"_19595":37880,"_15751":37881,"_1713":37882},[],"/docs/pr-preview/pr-25/manual/servicios-core/lamassuq#referencias-relacionadas","Referencias relacionadas",{"_8437":1452,"_23077":1442,"_19595":37884,"_5":23231,"_15751":37853,"_1713":37885},[],"LamassuQ incorpora a Lamassu IoT el soporte de criptografía post-cuántica (PQC). La plataforma puede generar, importar y custodiar claves de firma basadas en los algoritmos estandarizados por el NIST, además de firmas compuestas (*composites*) que combinan ML-DSA con un algoritmo tradicional en una única clave y un único certificado. Los algoritmos post-cuánticos están diseñados para resistir los ataques de los ordenadores cuánticos; las firmas compuestas permiten adoptarlos de forma gradual manteniendo la compatibilidad con la criptografía tradicional.",{"_8437":1453,"_23077":1442,"_19595":37887,"_5":23231,"_15751":37853,"_1713":37888},[],"Los nuevos tipos de clave están disponibles en el servicio KMS, para generación, importación, firma y verificación, y en la gestión de entidades de confianza, para crear e importar CAs y emitir certificados.",{"_8437":1454,"_23077":1442,"_19595":37890,"_5":23231,"_15751":37857,"_1713":37091},[],{"_8437":1455,"_23077":1442,"_19595":37892,"_5":23231,"_15751":37857,"_1713":37893},[],"Identificador",{"_8437":1456,"_23077":1442,"_19595":37895,"_5":23231,"_15751":37857,"_1713":37896},[],"Parámetros",{"_8437":1457,"_23077":1442,"_19595":37898,"_5":23231,"_15751":37857,"_1713":33748},[],{"_8437":1458,"_23077":1442,"_19595":37900,"_5":23231,"_15751":37857,"_1713":37901},[],"ML-DSA",{"_8437":1459,"_23077":1442,"_19595":37903,"_5":23231,"_15751":37857,"_1713":37904},[],"`ML-DSA`",{"_8437":1460,"_23077":1442,"_19595":37906,"_5":23231,"_15751":37857,"_1713":37907},[],"44, 65 o 87",{"_8437":1461,"_23077":1442,"_19595":37909,"_5":23231,"_15751":37857,"_1713":37910},[],"Firma digital post-cuántica basada en retículas (FIPS 204). El valor indica el nivel de seguridad del juego de parámetros.",{"_8437":1462,"_23077":1442,"_19595":37912,"_5":23231,"_15751":37857,"_1713":37913},[],"SLH-DSA",{"_8437":1463,"_23077":1442,"_19595":37915,"_5":23231,"_15751":37857,"_1713":37916},[],"`SLH-DSA`",{"_8437":1464,"_23077":1442,"_19595":37918,"_5":23231,"_15751":37857,"_1713":37919},[],"1 a 12",{"_8437":1465,"_23077":1442,"_19595":37921,"_5":23231,"_15751":37857,"_1713":37922},[],"Firma digital post-cuántica basada en funciones hash (FIPS 205). El valor selecciona el juego de parámetros; el valor 1 corresponde a SHA2-128s.",{"_8437":1466,"_23077":1442,"_19595":37924,"_5":23231,"_15751":37857,"_1713":37925},[],"Ed25519",{"_8437":1467,"_23077":1442,"_19595":37927,"_5":23231,"_15751":37857,"_1713":37928},[],"`Ed25519`",{"_8437":1468,"_23077":1442,"_19595":37930,"_5":23231,"_15751":37857,"_1713":11807},[],{"_8437":1469,"_23077":1442,"_19595":37932,"_5":23231,"_15751":37857,"_1713":37933},[],"Firma EdDSA clásica sobre Ed25519.",{"_8437":1470,"_23077":1442,"_19595":37935,"_5":23231,"_15751":37857,"_1713":37936},[],"Composite ML-DSA + RSA",{"_8437":1471,"_23077":1442,"_19595":37938,"_5":23231,"_15751":37857,"_1713":37939},[],"`Composite-ML-DSA-RSA`",{"_8437":1472,"_23077":1442,"_19595":37941,"_5":23231,"_15751":37857,"_1713":37942},[],"1 a 8 (variante)",{"_8437":1473,"_23077":1442,"_19595":37944,"_5":23231,"_15751":37857,"_1713":37945},[],"Firma compuesta ML-DSA + RSA.",{"_8437":1474,"_23077":1442,"_19595":37947,"_5":23231,"_15751":37857,"_1713":37948},[],"Composite ML-DSA + ECDSA",{"_8437":1475,"_23077":1442,"_19595":37950,"_5":23231,"_15751":37857,"_1713":37951},[],"`Composite-ML-DSA-ECDSA`",{"_8437":1476,"_23077":1442,"_19595":37953,"_5":23231,"_15751":37857,"_1713":37954},[],"9 a 13 (variante)",{"_8437":1477,"_23077":1442,"_19595":37956,"_5":23231,"_15751":37857,"_1713":37957},[],"Firma compuesta ML-DSA + ECDSA.",{"_8437":1478,"_23077":1442,"_19595":37959,"_5":23231,"_15751":37857,"_1713":37960},[],"Composite ML-DSA + Ed25519",{"_8437":1479,"_23077":1442,"_19595":37962,"_5":23231,"_15751":37857,"_1713":37963},[],"`Composite-ML-DSA-Ed25519`",{"_8437":1480,"_23077":1442,"_19595":37965,"_5":23231,"_15751":37857,"_1713":37966},[],"14 a 15 (variante)",{"_8437":1481,"_23077":1442,"_19595":37968,"_5":23231,"_15751":37857,"_1713":37969},[],"Firma compuesta ML-DSA + Ed25519.",{"_8437":1482,"_23077":1442,"_19595":37971,"_5":23231,"_15751":37857,"_1713":37972},[],"Para las claves compuestas, el valor de **Key Size** se corresponde con la variante del algoritmo compuesto; consulte la tabla de variantes.",{"_8437":1483,"_23077":1442,"_19595":37974,"_5":23231,"_15751":37861,"_1713":37975},[],"Cada variante fija el juego de parámetros ML-DSA, el algoritmo tradicional acompañante y la función hash del algoritmo compuesto. Una firma compuesta incluye las firmas de ambos componentes, de forma que el resultado se verifica como una única firma que cubre ambos algoritmos.",{"_8437":1484,"_23077":1442,"_19595":37977,"_5":23231,"_15751":37861,"_1713":37978},[],"Variante",{"_8437":1485,"_23077":1442,"_19595":37980,"_5":23231,"_15751":37861,"_1713":37981},[],"Familia",{"_8437":1486,"_23077":1442,"_19595":37983,"_5":23231,"_15751":37861,"_1713":37984},[],"Algoritmo compuesto",{"_8437":1487,"_23077":1442,"_19595":37986,"_5":23231,"_15751":37861,"_1713":11799},[],{"_8437":1488,"_23077":1442,"_19595":37988,"_5":23231,"_15751":37861,"_1713":37989},[],"RSA",{"_8437":1489,"_23077":1442,"_19595":37991,"_5":23231,"_15751":37861,"_1713":37992},[],"MLDSA44-RSA2048-PSS-SHA256",{"_8437":1490,"_23077":1442,"_19595":37994,"_5":23231,"_15751":37861,"_1713":4218},[],{"_8437":1491,"_23077":1442,"_19595":37996,"_5":23231,"_15751":37861,"_1713":37989},[],{"_8437":1492,"_23077":1442,"_19595":37998,"_5":23231,"_15751":37861,"_1713":37999},[],"MLDSA44-RSA2048-PKCS15-SHA256",{"_8437":1493,"_23077":1442,"_19595":38001,"_5":23231,"_15751":37861,"_1713":7042},[],{"_8437":1494,"_23077":1442,"_19595":38003,"_5":23231,"_15751":37861,"_1713":37989},[],{"_8437":1495,"_23077":1442,"_19595":38005,"_5":23231,"_15751":37861,"_1713":38006},[],"MLDSA65-RSA3072-PSS-SHA512",{"_8437":1496,"_23077":1442,"_19595":38008,"_5":23231,"_15751":37861,"_1713":6983},[],{"_8437":1497,"_23077":1442,"_19595":38010,"_5":23231,"_15751":37861,"_1713":37989},[],{"_8437":1498,"_23077":1442,"_19595":38012,"_5":23231,"_15751":37861,"_1713":38013},[],"MLDSA65-RSA3072-PKCS15-SHA512",{"_8437":1499,"_23077":1442,"_19595":38015,"_5":23231,"_15751":37861,"_1713":7150},[],{"_8437":1500,"_23077":1442,"_19595":38017,"_5":23231,"_15751":37861,"_1713":37989},[],{"_8437":1501,"_23077":1442,"_19595":38019,"_5":23231,"_15751":37861,"_1713":38020},[],"MLDSA65-RSA4096-PSS-SHA512",{"_8437":1502,"_23077":1442,"_19595":38022,"_5":23231,"_15751":37861,"_1713":7029},[],{"_8437":1503,"_23077":1442,"_19595":38024,"_5":23231,"_15751":37861,"_1713":37989},[],{"_8437":1504,"_23077":1442,"_19595":38026,"_5":23231,"_15751":37861,"_1713":38027},[],"MLDSA65-RSA4096-PKCS15-SHA512",{"_8437":1505,"_23077":1442,"_19595":38029,"_5":23231,"_15751":37861,"_1713":13937},[],{"_8437":1506,"_23077":1442,"_19595":38031,"_5":23231,"_15751":37861,"_1713":37989},[],{"_8437":1507,"_23077":1442,"_19595":38033,"_5":23231,"_15751":37861,"_1713":38034},[],"MLDSA87-RSA3072-PSS-SHA512",{"_8437":1508,"_23077":1442,"_19595":38036,"_5":23231,"_15751":37861,"_1713":7112},[],{"_8437":1509,"_23077":1442,"_19595":38038,"_5":23231,"_15751":37861,"_1713":37989},[],{"_8437":1510,"_23077":1442,"_19595":38040,"_5":23231,"_15751":37861,"_1713":38041},[],"MLDSA87-RSA4096-PSS-SHA512",{"_8437":1511,"_23077":1442,"_19595":38043,"_5":23231,"_15751":37861,"_1713":20423},[],{"_8437":1512,"_23077":1442,"_19595":38045,"_5":23231,"_15751":37861,"_1713":38046},[],"ECDSA",{"_8437":1513,"_23077":1442,"_19595":38048,"_5":23231,"_15751":37861,"_1713":38049},[],"MLDSA44-ECDSA-P256-SHA256",{"_8437":1514,"_23077":1442,"_19595":38051,"_5":23231,"_15751":37861,"_1713":22743},[],{"_8437":1515,"_23077":1442,"_19595":38053,"_5":23231,"_15751":37861,"_1713":38046},[],{"_8437":1516,"_23077":1442,"_19595":38055,"_5":23231,"_15751":37861,"_1713":38056},[],"MLDSA65-ECDSA-P256-SHA512",{"_8437":1517,"_23077":1442,"_19595":38058,"_5":23231,"_15751":37861,"_1713":22737},[],{"_8437":1518,"_23077":1442,"_19595":38060,"_5":23231,"_15751":37861,"_1713":38046},[],{"_8437":1519,"_23077":1442,"_19595":38062,"_5":23231,"_15751":37861,"_1713":38063},[],"MLDSA65-ECDSA-P384-SHA512",{"_8437":1520,"_23077":1442,"_19595":38065,"_5":23231,"_15751":37861,"_1713":22759},[],{"_8437":1521,"_23077":1442,"_19595":38067,"_5":23231,"_15751":37861,"_1713":38046},[],{"_8437":1522,"_23077":1442,"_19595":38069,"_5":23231,"_15751":37861,"_1713":38070},[],"MLDSA87-ECDSA-P384-SHA512",{"_8437":1523,"_23077":1442,"_19595":38072,"_5":23231,"_15751":37861,"_1713":22781},[],{"_8437":1524,"_23077":1442,"_19595":38074,"_5":23231,"_15751":37861,"_1713":38046},[],{"_8437":1525,"_23077":1442,"_19595":38076,"_5":23231,"_15751":37861,"_1713":38077},[],"MLDSA87-ECDSA-P521-SHA512",{"_8437":1526,"_23077":1442,"_19595":38079,"_5":23231,"_15751":37861,"_1713":22731},[],{"_8437":1527,"_23077":1442,"_19595":38081,"_5":23231,"_15751":37861,"_1713":37925},[],{"_8437":1528,"_23077":1442,"_19595":38083,"_5":23231,"_15751":37861,"_1713":38084},[],"MLDSA44-Ed25519-SHA512",{"_8437":1529,"_23077":1442,"_19595":38086,"_5":23231,"_15751":37861,"_1713":22765},[],{"_8437":1530,"_23077":1442,"_19595":38088,"_5":23231,"_15751":37861,"_1713":37925},[],{"_8437":1531,"_23077":1442,"_19595":38090,"_5":23231,"_15751":37861,"_1713":38091},[],"MLDSA65-Ed25519-SHA512",{"_8437":1532,"_23077":1442,"_19595":38093,"_5":23231,"_15751":37861,"_1713":38094},[],"Cada variante solo es válida para su familia: las variantes 1 a 8 con el tipo `Composite-ML-DSA-RSA`, las variantes 9 a 13 con `Composite-ML-DSA-ECDSA` y las variantes 14 a 15 con `Composite-ML-DSA-Ed25519`. El KMS rechaza cualquier combinación que no cumpla esta correspondencia.",{"_8437":1533,"_23077":1442,"_19595":38096,"_5":23231,"_15751":37865,"_1713":38097},[],"Motor",{"_8437":1534,"_23077":1442,"_19595":38099,"_5":23231,"_15751":37865,"_1713":38100},[],"Claves post-cuánticas y compuestas",{"_8437":1535,"_23077":1442,"_19595":38102,"_5":23231,"_15751":37865,"_1713":38103},[],"Software (Golang)",{"_8437":1536,"_23077":1442,"_19595":38105,"_5":23231,"_15751":37865,"_1713":38106},[],"Soportadas: generación, importación, firma y verificación.",{"_8437":1537,"_23077":1442,"_19595":38108,"_5":23231,"_15751":37865,"_1713":37494},[],{"_8437":1538,"_23077":1442,"_19595":38110,"_5":23231,"_15751":37865,"_1713":38111},[],"Soportadas: delega en el motor software.",{"_8437":1539,"_23077":1442,"_19595":38113,"_5":23231,"_15751":37865,"_1713":38114},[],"AWS KMS, AWS Secrets Manager, Azure KeyVault, Azure KeyVault Secrets, HashiCorp Vault (KV2), PKCS#11",{"_8437":1540,"_23077":1442,"_19595":38116,"_5":23231,"_15751":37865,"_1713":38117},[],"No soportadas. La generación o importación de estos tipos devuelve el error `unsupported key type`.",{"_8437":1541,"_23077":1442,"_19595":38119,"_5":23231,"_15751":37865,"_1713":38120},[],"Los motores AWS Secrets Manager y HashiCorp Vault KV2 anuncian en su catálogo los mismos tipos de clave que el motor software, incluidos los nuevos tipos post-cuánticos y compuestos. La consola o la API pueden aceptar la solicitud, pero la operación falla después con el error `unsupported key type`. Utilice el motor software o File System para estos tipos de clave hasta que el motor externo los soporte de forma nativa.",{"_8437":1542,"_23077":1442,"_19595":38122,"_5":23231,"_15751":37869,"_1713":38123},[],"Los algoritmos de firma tradicionales (por ejemplo `RSASSA_PSS_SHA_256` o `ECDSA_SHA_384`) firman un *digest* calculado previamente sobre el mensaje. Los algoritmos post-cuánticos, Ed25519 y las firmas compuestas operan en modo PURE: firman el mensaje tal cual, sin aplicar un pre-hash.",{"_8437":1543,"_23077":1442,"_19595":38125,"_5":23231,"_15751":37869,"_1713":38126},[],"La tabla siguiente resume los identificadores de algoritmo disponibles para cada tipo de clave:",{"_8437":1544,"_23077":1442,"_19595":38128,"_5":23231,"_15751":37869,"_1713":37091},[],{"_8437":1545,"_23077":1442,"_19595":38130,"_5":23231,"_15751":37869,"_1713":38131},[],"Algoritmo de firma",{"_8437":1546,"_23077":1442,"_19595":38133,"_5":23231,"_15751":37869,"_1713":38134},[],"ML-DSA 44",{"_8437":1547,"_23077":1442,"_19595":38136,"_5":23231,"_15751":37869,"_1713":38137},[],"`MLDSA_44_PURE`",{"_8437":1548,"_23077":1442,"_19595":38139,"_5":23231,"_15751":37869,"_1713":38140},[],"ML-DSA 65",{"_8437":1549,"_23077":1442,"_19595":38142,"_5":23231,"_15751":37869,"_1713":38143},[],"`MLDSA_65_PURE`",{"_8437":1550,"_23077":1442,"_19595":38145,"_5":23231,"_15751":37869,"_1713":38146},[],"ML-DSA 87",{"_8437":1551,"_23077":1442,"_19595":38148,"_5":23231,"_15751":37869,"_1713":38149},[],"`MLDSA_87_PURE`",{"_8437":1552,"_23077":1442,"_19595":38151,"_5":23231,"_15751":37869,"_1713":37913},[],{"_8437":1553,"_23077":1442,"_19595":38153,"_5":23231,"_15751":37869,"_1713":38154},[],"`SLHDSA_PURE`",{"_8437":1554,"_23077":1442,"_19595":38156,"_5":23231,"_15751":37869,"_1713":37925},[],{"_8437":1555,"_23077":1442,"_19595":38158,"_5":23231,"_15751":37869,"_1713":38159},[],"`Ed25519_PURE`",{"_8437":1556,"_23077":1442,"_19595":38161,"_5":23231,"_15751":37869,"_1713":38162},[],"Composite-ML-DSA-RSA",{"_8437":1557,"_23077":1442,"_19595":38164,"_5":23231,"_15751":37869,"_1713":38165},[],"`COMPOSITE_MLDSA_RSA_PURE`",{"_8437":1558,"_23077":1442,"_19595":38167,"_5":23231,"_15751":37869,"_1713":38168},[],"Composite-ML-DSA-ECDSA",{"_8437":1559,"_23077":1442,"_19595":38170,"_5":23231,"_15751":37869,"_1713":38171},[],"`COMPOSITE_MLDSA_ECDSA_PURE`",{"_8437":1560,"_23077":1442,"_19595":38173,"_5":23231,"_15751":37869,"_1713":38174},[],"Composite-ML-DSA-Ed25519",{"_8437":1561,"_23077":1442,"_19595":38176,"_5":23231,"_15751":37869,"_1713":38177},[],"`COMPOSITE_MLDSA_ED25519_PURE`",{"_8437":1562,"_23077":1442,"_19595":38179,"_5":23231,"_15751":37869,"_1713":38180},[],"Para ML-DSA, el identificador se deriva del nivel del juego de parámetros de la clave (44, 65 o 87). Para SLH-DSA y las familias compuestas, el identificador es único y no incluye el juego de parámetros ni la variante.",{"_8437":1563,"_23077":1442,"_19595":38182,"_5":23231,"_15751":37869,"_1713":38183},[],"En las operaciones **Sign** y **Verify** de la consola, seleccione el tipo de mensaje `Raw` con estos algoritmos, ya que el mensaje se firma tal cual. Consulte Firmar y verificar para los detalles de la operación.",{"_8437":1564,"_23077":1442,"_19595":38185,"_5":23231,"_15751":37873,"_1713":38186},[],"Las claves generadas fuera de Lamassu IoT pueden importarse mediante el asistente de importación del KMS, igual que las claves tradicionales. Para los nuevos tipos de clave se aplican las siguientes reglas:",{"_8437":1565,"_23077":1442,"_19595":38188,"_5":23231,"_15751":37873,"_1713":38189},[],"La clave privada debe proporcionarse en formato **PKCS#8** (PEM).",{"_8437":1566,"_23077":1442,"_19595":38191,"_5":23231,"_15751":37873,"_1713":38192},[],"Se admiten claves ML-DSA, SLH-DSA, Ed25519 y firmas compuestas.",{"_8437":1567,"_23077":1442,"_19595":38194,"_5":23231,"_15751":37873,"_1713":38195},[],"La clave debe usar uno de los juegos de parámetros soportados: ML-DSA 44, 65 o 87, o SLH-DSA con un parámetro entre 1 y 12.",{"_8437":1568,"_23077":1442,"_19595":38197,"_5":23231,"_15751":37873,"_1713":38198},[],"Solo pueden importarse en los motores con soporte de estos tipos; consulte la tabla de motores.",{"_8437":1569,"_23077":1442,"_19595":38200,"_5":23231,"_15751":37877,"_1713":38201},[],"Las CAs creadas o importadas con claves post-cuánticas, Ed25519 o compuestas pueden emitir certificados para solicitudes generadas con claves tradicionales, y viceversa. La firma del certificado la realiza siempre la clave de la CA emisora, por lo que la clave del certificado emitido no necesita compartir algoritmo con la de la CA.",{"_8437":1570,"_23077":1442,"_19595":38203,"_5":23231,"_15751":37877,"_1713":38204},[],"Las claves de las CAs se generan e importan a través del KMS, de forma que a la creación o importación de una CA con estos tipos se aplican las mismas restricciones de motor y de parámetros descritas en las secciones anteriores.",{"_8437":1571,"_23077":1442,"_19595":38206,"_5":23231,"_15751":37881,"_1713":38207},[],"<Card title=\"Gestión de Claves (KMS)\" href=\"/docs/manual/servicios-core/kms\" />",{"_8437":1572,"_23077":1442,"_19595":38209,"_5":23231,"_15751":37881,"_1713":38210},[],"<Card title=\"Entidades de Confianza (CAs)\" href=\"/docs/manual/servicios-core/cas\" />",{"_8437":1573,"_23077":1573,"_5":23226,"_1713":38212,"_23239":38213,"_19595":38214,"_15751":1573},"[DMS] Device Management Service",[33545,34644,34653],[],{"_8437":1574,"_23077":1573,"_19595":38216,"_5":23231,"_15751":1573,"_1713":38217},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_8437":1575,"_23077":1573,"_5":23236,"_19595":38219,"_15751":38220,"_1713":38221},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#device-management-service","Device Management Service",{"_8437":1576,"_23077":1573,"_5":23236,"_19595":38223,"_15751":38224,"_1713":36406},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#antes-de-empezar",{"_8437":1577,"_23077":1573,"_5":23236,"_19595":38226,"_15751":38227,"_1713":38228},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_8437":1578,"_23077":1573,"_5":23236,"_19595":38230,"_15751":38231,"_1713":38232},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_8437":1579,"_23077":1573,"_5":23236,"_19595":38234,"_15751":38235,"_1713":38236},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_8437":1580,"_23077":1573,"_19595":38238,"_5":23231,"_15751":38220,"_1713":38239},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_8437":1581,"_23077":1573,"_19595":38241,"_5":23231,"_15751":38220,"_1713":38242},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_8437":1582,"_23077":1573,"_19595":38244,"_5":23231,"_15751":38224,"_1713":38245},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_8437":1583,"_23077":1573,"_19595":38247,"_5":23231,"_15751":38227,"_1713":38248},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_8437":1584,"_23077":1573,"_19595":38250,"_5":23231,"_15751":38227,"_1713":38251},[],"Acción",{"_8437":1585,"_23077":1573,"_19595":38253,"_5":23231,"_15751":38227,"_1713":33748},[],{"_8437":1586,"_23077":1573,"_19595":38255,"_5":23231,"_15751":38227,"_1713":38256},[],"**Edit**",{"_8437":1587,"_23077":1573,"_19595":38258,"_5":23231,"_15751":38227,"_1713":38259},[],"Modifica la configuración del DMS.",{"_8437":1588,"_23077":1573,"_19595":38261,"_5":23231,"_15751":38227,"_1713":38262},[],"**Go to DMS owned devices**",{"_8437":1589,"_23077":1573,"_19595":38264,"_5":23231,"_15751":38227,"_1713":38265},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_8437":1590,"_23077":1573,"_19595":38267,"_5":23231,"_15751":38227,"_1713":38268},[],"**Show/Edit Metadata**",{"_8437":1591,"_23077":1573,"_19595":38270,"_5":23231,"_15751":38227,"_1713":38271},[],"Accede a los metadatos del DMS para usos avanzados.",{"_8437":1592,"_23077":1573,"_19595":38273,"_5":23231,"_15751":38227,"_1713":38274},[],"**EST (RFC-7030)**",{"_8437":1593,"_23077":1573,"_19595":38276,"_5":23231,"_15751":38227,"_1713":38277},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_8437":1594,"_23077":1573,"_19595":38279,"_5":23231,"_15751":38227,"_1713":38280},[],"**Delete**",{"_8437":1595,"_23077":1573,"_19595":38282,"_5":23231,"_15751":38227,"_1713":38283},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_8437":1596,"_23077":1573,"_19595":38285,"_5":23231,"_15751":38231,"_1713":38286},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_8437":1597,"_23077":1573,"_19595":38288,"_5":23231,"_15751":38231,"_1713":34879},[],{"_8437":1598,"_23077":1573,"_19595":38290,"_5":23231,"_15751":38231,"_1713":33748},[],{"_8437":1599,"_23077":1573,"_19595":38292,"_5":23231,"_15751":38231,"_1713":38293},[],"**Include Lamassu System CA**",{"_8437":1600,"_23077":1573,"_19595":38295,"_5":23231,"_15751":38231,"_1713":38296},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_8437":1601,"_23077":1573,"_19595":38298,"_5":23231,"_15751":38231,"_1713":38299},[],"**Include Enrollment CA**",{"_8437":1602,"_23077":1573,"_19595":38301,"_5":23231,"_15751":38231,"_1713":38302},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_8437":1603,"_23077":1573,"_19595":38304,"_5":23231,"_15751":38231,"_1713":38305},[],"**Managed CAs**",{"_8437":1604,"_23077":1573,"_19595":38307,"_5":23231,"_15751":38231,"_1713":38308},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_8437":1605,"_23077":1573,"_19595":38310,"_5":23231,"_15751":38235,"_1713":38311},[],"El DMS expone un protocolo de enrolamiento a los dispositivos. En la versión actual de Lamassu, el único protocolo soportado es &#x2A;*EST (RFC 7030)**. La configuración del protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_8437":1606,"_23077":1573,"_19595":38313,"_5":23231,"_15751":38235,"_1713":38314},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_8437":1607,"_23077":1573,"_19595":38316,"_5":23231,"_15751":38235,"_1713":37368},[],{"_8437":1608,"_23077":1608,"_5":23226,"_1713":38318,"_23239":38319,"_19595":38320,"_15751":1608},"[VA] Servicio CRL",[33545,34644,34653],[],{"_8437":1609,"_23077":1608,"_19595":38322,"_5":23231,"_15751":1608,"_1713":38323},[],"Gestión y consulta de listas de revocación para validación offline",{"_8437":1610,"_23077":1608,"_5":23236,"_19595":38325,"_15751":38326,"_1713":38327},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_8437":1611,"_23077":1608,"_5":23236,"_19595":38329,"_15751":38330,"_1713":38331},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_8437":1612,"_23077":1608,"_5":23236,"_19595":38333,"_15751":38334,"_1713":38335},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_8437":1613,"_23077":1608,"_5":23236,"_19595":38337,"_15751":38338,"_1713":38339},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_8437":1614,"_23077":1608,"_5":23236,"_19595":38341,"_15751":38342,"_1713":38343},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_8437":1615,"_23077":1608,"_5":23236,"_19595":38345,"_15751":38346,"_1713":38347},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_8437":1616,"_23077":1608,"_5":23236,"_19595":38349,"_15751":38350,"_1713":38351},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_8437":1617,"_23077":1608,"_5":23236,"_19595":38353,"_15751":38354,"_1713":38355},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#referencias","Referencias",{"_8437":1618,"_23077":1608,"_19595":38357,"_5":23231,"_15751":38326,"_1713":38358},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_8437":1619,"_23077":1608,"_19595":38360,"_5":23231,"_15751":38326,"_1713":38361},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_8437":1620,"_23077":1608,"_19595":38363,"_5":23231,"_15751":38330,"_1713":38364},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_8437":1621,"_23077":1608,"_19595":38366,"_5":23231,"_15751":38330,"_1713":38367},[],"Los parámetros principales son:",{"_8437":1622,"_23077":1608,"_19595":38369,"_5":23231,"_15751":38330,"_1713":34879},[],{"_8437":1623,"_23077":1608,"_19595":38371,"_5":23231,"_15751":38330,"_1713":33745},[],{"_8437":1624,"_23077":1608,"_19595":38373,"_5":23231,"_15751":38330,"_1713":33748},[],{"_8437":1625,"_23077":1608,"_19595":38375,"_5":23231,"_15751":38330,"_1713":38376},[],"`validity`",{"_8437":1626,"_23077":1608,"_19595":38378,"_5":23231,"_15751":38330,"_1713":38379},[],"7 días",{"_8437":1627,"_23077":1608,"_19595":38381,"_5":23231,"_15751":38330,"_1713":38382},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_8437":1628,"_23077":1608,"_19595":38384,"_5":23231,"_15751":38330,"_1713":38385},[],"`refresh_interval`",{"_8437":1629,"_23077":1608,"_19595":38387,"_5":23231,"_15751":38330,"_1713":38388},[],"\\~6 días y 23 horas",{"_8437":1630,"_23077":1608,"_19595":38390,"_5":23231,"_15751":38330,"_1713":38391},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_8437":1631,"_23077":1608,"_19595":38393,"_5":23231,"_15751":38330,"_1713":38394},[],"`regenerate_on_revoke`",{"_8437":1632,"_23077":1608,"_19595":38396,"_5":23231,"_15751":38330,"_1713":38397},[],"`true`",{"_8437":1633,"_23077":1608,"_19595":38399,"_5":23231,"_15751":38330,"_1713":38400},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_8437":1634,"_23077":1608,"_19595":38402,"_5":23231,"_15751":38330,"_1713":38403},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_8437":1635,"_23077":1608,"_19595":38405,"_5":23231,"_15751":38330,"_1713":38406},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_8437":1636,"_23077":1608,"_19595":38408,"_5":23231,"_15751":38334,"_1713":38409},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_8437":1637,"_23077":1608,"_19595":38411,"_5":23231,"_15751":38334,"_1713":38412},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_8437":1638,"_23077":1608,"_19595":38414,"_5":23231,"_15751":38338,"_1713":38415},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_8437":1639,"_23077":1608,"_19595":38417,"_5":23231,"_15751":38338,"_1713":38418},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_8437":1640,"_23077":1608,"_19595":38420,"_5":23231,"_15751":38342,"_1713":38421},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_8437":1641,"_23077":1608,"_19595":38423,"_5":23231,"_15751":38342,"_1713":38424},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_8437":1642,"_23077":1608,"_19595":38426,"_5":23231,"_15751":38346,"_1713":38427},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_8437":1643,"_23077":1608,"_19595":38429,"_5":23231,"_15751":38346,"_1713":38430},[],"Método",{"_8437":1644,"_23077":1608,"_19595":38432,"_5":23231,"_15751":38346,"_1713":38433},[],"Ruta",{"_8437":1645,"_23077":1608,"_19595":38435,"_5":23231,"_15751":38346,"_1713":33748},[],{"_8437":1646,"_23077":1608,"_19595":38437,"_5":23231,"_15751":38346,"_1713":38438},[],"`GET`",{"_8437":1647,"_23077":1608,"_19595":38440,"_5":23231,"_15751":38346,"_1713":38441},[],"`/v1/roles/{ca-ski}`",{"_8437":1648,"_23077":1608,"_19595":38443,"_5":23231,"_15751":38346,"_1713":38444},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_8437":1649,"_23077":1608,"_19595":38446,"_5":23231,"_15751":38346,"_1713":38447},[],"`PUT`",{"_8437":1650,"_23077":1608,"_19595":38449,"_5":23231,"_15751":38346,"_1713":38441},[],{"_8437":1651,"_23077":1608,"_19595":38451,"_5":23231,"_15751":38346,"_1713":38452},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_8437":1652,"_23077":1608,"_19595":38454,"_5":23231,"_15751":38346,"_1713":38455},[],"Ejemplo de consulta del rol VA:",{"_8437":1653,"_23077":1608,"_19595":38457,"_5":23231,"_15751":38346,"_1713":38458},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_8437":1654,"_23077":1608,"_19595":38460,"_5":23231,"_15751":38350,"_1713":38461},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_8437":1655,"_23077":1608,"_19595":38463,"_5":23231,"_15751":38354,"_1713":38464},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_8437":1656,"_23077":1608,"_19595":38466,"_5":23231,"_15751":38354,"_1713":38467},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_8437":1657,"_23077":1608,"_19595":38469,"_5":23231,"_15751":38354,"_1713":38470},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_8437":1658,"_23077":1658,"_5":23226,"_1713":38472,"_23239":38473,"_19595":38474,"_15751":1658},"[VA] Servicio OCSP",[33545,34644,34653],[],{"_8437":1659,"_23077":1658,"_19595":38476,"_5":23231,"_15751":1658,"_1713":38477},[],"Validación online del estado de certificados mediante OCSP",{"_8437":1660,"_23077":1658,"_5":23236,"_19595":38479,"_15751":38480,"_1713":38481},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_8437":1661,"_23077":1658,"_5":23236,"_19595":38483,"_15751":38484,"_1713":38485},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_8437":1662,"_23077":1658,"_5":23236,"_19595":38487,"_15751":38488,"_1713":38489},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_8437":1663,"_23077":1658,"_5":23236,"_19595":38491,"_15751":38492,"_1713":38493},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_8437":1664,"_23077":1658,"_5":23236,"_19595":38495,"_15751":38496,"_1713":38497},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_8437":1665,"_23077":1658,"_5":23236,"_19595":38499,"_15751":38500,"_1713":38355},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#referencias",{"_8437":1666,"_23077":1658,"_19595":38502,"_5":23231,"_15751":38480,"_1713":38503},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_8437":1667,"_23077":1658,"_19595":38505,"_5":23231,"_15751":38480,"_1713":38506},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_8437":1668,"_23077":1658,"_19595":38508,"_5":23231,"_15751":38484,"_1713":38509},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_8437":1669,"_23077":1658,"_19595":38511,"_5":23231,"_15751":38484,"_1713":38512},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_8437":1670,"_23077":1658,"_19595":38514,"_5":23231,"_15751":38484,"_1713":38515},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_8437":1671,"_23077":1658,"_19595":38517,"_5":23231,"_15751":38484,"_1713":38518},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_8437":1672,"_23077":1658,"_19595":38520,"_5":23231,"_15751":38484,"_1713":38521},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_8437":1673,"_23077":1658,"_19595":38523,"_5":23231,"_15751":38484,"_1713":38524},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_8437":1674,"_23077":1658,"_19595":38526,"_5":23231,"_15751":38488,"_1713":38527},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_8437":1675,"_23077":1658,"_19595":38529,"_5":23231,"_15751":38492,"_1713":38530},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_8437":1676,"_23077":1658,"_19595":38532,"_5":23231,"_15751":38492,"_1713":38430},[],{"_8437":1677,"_23077":1658,"_19595":38534,"_5":23231,"_15751":38492,"_1713":38433},[],{"_8437":1678,"_23077":1658,"_19595":38536,"_5":23231,"_15751":38492,"_1713":33748},[],{"_8437":1679,"_23077":1658,"_19595":38538,"_5":23231,"_15751":38492,"_1713":38438},[],{"_8437":1680,"_23077":1658,"_19595":38540,"_5":23231,"_15751":38492,"_1713":38541},[],"`/ocsp/{ocsp_request}`",{"_8437":1681,"_23077":1658,"_19595":38543,"_5":23231,"_15751":38492,"_1713":38544},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_8437":1682,"_23077":1658,"_19595":38546,"_5":23231,"_15751":38492,"_1713":38547},[],"`POST`",{"_8437":1683,"_23077":1658,"_19595":38549,"_5":23231,"_15751":38492,"_1713":38550},[],"`/ocsp`",{"_8437":1684,"_23077":1658,"_19595":38552,"_5":23231,"_15751":38492,"_1713":38553},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_8437":1685,"_23077":1658,"_19595":38555,"_5":23231,"_15751":38492,"_1713":38556},[],"Ejemplo de consulta con `curl` mediante POST:",{"_8437":1686,"_23077":1658,"_19595":38558,"_5":23231,"_15751":38492,"_1713":38559},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_8437":1687,"_23077":1658,"_19595":38561,"_5":23231,"_15751":38496,"_1713":38562},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_8437":1688,"_23077":1658,"_19595":38564,"_5":23231,"_15751":38500,"_1713":38565},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_8437":1689,"_23077":1658,"_19595":38567,"_5":23231,"_15751":38500,"_1713":38568},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_8437":1690,"_23077":1658,"_19595":38570,"_5":23231,"_15751":38500,"_1713":38571},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_8437":1691,"_23077":1658,"_19595":38573,"_5":23231,"_15751":38500,"_1713":38470},[],{"_8437":1692,"_23077":1692,"_5":23226,"_1713":38575,"_23239":38576,"_19595":38577,"_15751":1692},"[VA] Validación de Certificados",[33545,34644,34653],[],{"_8437":1693,"_23077":1692,"_19595":38579,"_5":23231,"_15751":1692,"_1713":38580},[],"Servicios OCSP y CRL para validación de certificados",{"_8437":1694,"_23077":1692,"_5":23236,"_19595":38582,"_15751":38583,"_1713":38584},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_8437":1695,"_23077":1692,"_19595":38586,"_5":23231,"_15751":38583,"_1713":38587},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_8437":1696,"_23077":1692,"_19595":38589,"_5":23231,"_15751":38583,"_1713":38590},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_8437":1697,"_23077":1692,"_19595":38592,"_5":23231,"_15751":38583,"_1713":38593},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_8437":1698,"_23077":1692,"_19595":38595,"_5":23231,"_15751":38583,"_1713":38596},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_8437":1699,"_23077":1699,"_5":23226,"_1713":38598,"_19595":38599,"_15751":1699},"Test",[],{"_8437":1700,"_23077":1699,"_19595":38601,"_5":23231,"_15751":1699,"_1713":38602},[],"A document to test Fumadocs",{"_8437":1701,"_23077":1699,"_5":23236,"_19595":38604,"_15751":38605,"_1713":38606},[],"/docs/pr-preview/pr-25/test#cards","Cards",{"_8437":1702,"_23077":1699,"_5":23236,"_19595":38608,"_15751":38609,"_1713":38610},[],"/docs/pr-preview/pr-25/test#codeblock","CodeBlock",{"_8437":1703,"_23077":1699,"_5":23236,"_19595":38612,"_15751":38613,"_1713":38614},[],"/docs/pr-preview/pr-25/test#list","List",{"_8437":1704,"_23077":1699,"_19595":38616,"_5":23231,"_15751":1699,"_1713":38617},[],"Hey there!",{"_8437":1705,"_23077":1699,"_19595":38619,"_5":23231,"_15751":38605,"_1713":38620},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_8437":1706,"_23077":1699,"_19595":38622,"_5":23231,"_15751":38605,"_1713":38623},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_8437":1707,"_23077":1699,"_19595":38625,"_5":23231,"_15751":38613,"_1713":38626},[],"Hello",{"_8437":1708,"_23077":1699,"_19595":38628,"_5":23231,"_15751":38613,"_1713":38629},[],"World","sorting",{"_38632":38633,"_38634":38635,"_38636":38637,"_38638":38639,"_4747":1731,"_45445":1731},"language","english","sortableProperties",[1713,23077,5,15751],"sortablePropertiesWithTypes",{"_1713":12095,"_23077":12095,"_5":12095,"_15751":12095},"sorts",{"_1713":38640,"_23077":40342,"_5":42043,"_15751":43744},{"_8703":38641,"_38642":38643,"_5":12095},{"_11799":3192,"_4218":6093,"_7042":3935,"_6983":4319,"_7150":16680,"_7029":20972,"_13937":2319,"_7112":2989,"_20423":8060,"_22743":1894,"_22737":3101,"_22759":2264,"_22781":2999,"_22731":7266,"_22765":7280,"_25