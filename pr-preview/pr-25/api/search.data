:11},"AWS EC2 · AWS Marketplace",[32429,32430,32431],"Docs","Despliegue Lamassu IoT","Cloud · AWS EC2 · AWS Marketplace",[],{"_8073":12,"_22563":11,"_19084":32434,"_5":22713,"_15335":11,"_1612":32435},[],"Despliegue de Lamassu IoT en AWS EC2 mediante la suscripción en AWS Marketplace",{"_8073":13,"_22563":11,"_5":22718,"_19084":32437,"_15335":32438,"_1612":32439},[],"/docs/pr-preview/pr-25/despliegue/cloud#despliegue-en-aws-ec2--aws-marketplace","Despliegue en AWS EC2 – AWS Marketplace",{"_8073":14,"_22563":11,"_5":22718,"_19084":32441,"_15335":32442,"_1612":32443},[],"/docs/pr-preview/pr-25/despliegue/cloud#pasos","Pasos",{"_8073":15,"_22563":11,"_5":22718,"_19084":32445,"_15335":32446,"_1612":32447},[],"/docs/pr-preview/pr-25/despliegue/cloud#requisitos-de-infraestructura","Requisitos de infraestructura",{"_8073":16,"_22563":11,"_19084":32449,"_5":22713,"_15335":32438,"_1612":32450},[],"Lamassu IoT está disponible en **AWS Marketplace**, lo que permite lanzar una instancia preconfigurada en AWS EC2 con un único clic.",{"_8073":17,"_22563":11,"_19084":32452,"_5":22713,"_15335":32442,"_1612":32453},[],"Acceder a la página del producto de Lamassu IoT en AWS Marketplace",{"_8073":18,"_22563":11,"_19084":32455,"_5":22713,"_15335":32442,"_1612":32456},[],"Seleccionar el tipo de instancia recomendado (`t3.large` o superior)",{"_8073":19,"_22563":11,"_19084":32458,"_5":22713,"_15335":32442,"_1612":32459},[],"Configurar el grupo de seguridad: puertos `443`, `8443` y `9443`",{"_8073":20,"_22563":11,"_19084":32461,"_5":22713,"_15335":32442,"_1612":32462},[],"Lanzar la instancia y acceder a la consola de administración en `https://<ip-publica>`",{"_8073":21,"_22563":11,"_19084":32464,"_5":22713,"_15335":32446,"_1612":32465},[],"Instancia EC2 `t3.large` mínimo (recomendado `t3.xlarge`)",{"_8073":22,"_22563":11,"_19084":32467,"_5":22713,"_15335":32446,"_1612":32468},[],"EBS `gp3` de al menos 50 GB",{"_8073":23,"_22563":11,"_19084":32470,"_5":22713,"_15335":32446,"_1612":32471},