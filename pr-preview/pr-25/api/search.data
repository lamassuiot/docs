"_1713":33584},[],"EBS `gp3` de al menos 50 GB",{"_8437":23,"_23077":11,"_19595":33586,"_5":23231,"_15751":33562,"_1713":33587},[],"Security Group con acceso HTTPS desde los dispositivos IoT",{"_8437":24,"_23077":24,"_5":23226,"_1713":33546,"_23239":33589,"_19595":33590,"_15751":24},[33545,33546],[],{"_8437":25,"_23077":24,"_19595":33592,"_5":23231,"_15751":24,"_1713":33593},[],"Guía de despliegue e instalación de la plataforma Lamassu IoT",{"_8437":26,"_23077":24,"_5":23236,"_19595":33595,"_15751":33596,"_1713":33597},[],"/docs/pr-preview/pr-25/despliegue#onprem--selfmanaged--kubernetes","OnPrem & SelfManaged · Kubernetes",{"_8437":27,"_23077":24,"_5":23236,"_19595":33599,"_15751":33600,"_1713":33547},[],"/docs/pr-preview/pr-25/despliegue#cloud--aws-ec2--aws-marketplace",{"_8437":28,"_23077":24,"_5":23236,"_19595":33602,"_15751":33603,"_1713":33604},[],"/docs/pr-preview/pr-25/despliegue#saas--basada-en-suscripción","SaaS · Basada en suscripción",{"_8437":29,"_23077":24,"_19595":33606,"_5":23231,"_15751":24,"_1713":33607},[],"Bienvenido a la guía de **Despliegue de Lamassu IoT**. Selecciona la modalidad que mejor se adapta a tu infraestructura.",{"_8437":30,"_23077":24,"_19595":33609,"_5":23231,"_15751":33596,"_1713":33610},[],"<Card title=\"Introducción\" description=\"Requisitos y arquitectura para despliegue en Kubernetes propio\" href=\"/docs/despliegue/onprem\" />",{"_8437":31,"_23077":24,"_19595":33612,"_5":23231,"_15751":33596,"_1713":33613},[],"<Card title=\"Fastlane\" description=\"Despliegue rápido y automatizado con el script Fastlane\" href=\"/docs/despliegue/onprem/fastlane\" />",{"_8437":32,"_23077":24,"_19595":33615,"_5":23231,"_15751":33600,"_1713":33616},[],"<Card title=\"AWS EC2 · AWS Marketplace\" description=\"Lanza Lamassu IoT en AWS con un clic desde el Marketplace\" href=\"/docs/despliegue/cloud\" />",{"_8437":33,"_23077":24,"_19595":33618,"_5":23231,"_15751":33603,"_1713":33619},[],"<Card title=\"SaaS · Suscripción\" description=\"Plataforma 