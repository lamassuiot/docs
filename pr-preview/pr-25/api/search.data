m/fastlane#modo-interactivo-por-defecto","Modo interactivo (por defecto)",{"_8047":43,"_22539":34,"_5":22694,"_19069":32521,"_15331":32522,"_1610":32523},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_8047":44,"_22539":34,"_5":22694,"_19069":32525,"_15331":32526,"_1610":32527},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-online-vs-offline","Modo online vs offline",{"_8047":45,"_22539":34,"_5":22694,"_19069":32529,"_15331":32530,"_1610":32531},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_8047":46,"_22539":34,"_5":22694,"_19069":32533,"_15331":32534,"_1610":32535},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-offline","Modo offline",{"_8047":47,"_22539":34,"_5":22694,"_19069":32537,"_15331":32538,"_1610":32539},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#instalación-de-componentes","Instalación de componentes",{"_8047":48,"_22539":34,"_5":22694,"_19069":32541,"_15331":32542,"_1610":32543},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_8047":49,"_22539":34,"_5":22694,"_19069":32545,"_15331":32546,"_1610":32547},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_8047":50,"_22539":34,"_5":22694,"_19069":32549,"_15331":32550,"_1610":32551},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_8047":51,"_22539":34,"_5":22694,"_19069":32553,"_15331":32554,"_1610":32555},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_8047":52,"_22539":34,"_5":22694,"_19069":32557,"_15331":32558,"_1610":32559},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#configuración-tls","Configuración TLS",{"_8047":53,"_22539":34,"_5":22694,"_19069":32561,"_15331":32562,"_1610":32563},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#certificado-externo","Certificado externo",{"_8047":54,"_22539":34,"_5":22694,"_19069":32565,"_15331":32566,"_1610":32567},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_8047":55,"_22539":34,"_5":22694,"_19069":32569,"_15331":32570,"_1610":32571},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_8047":56,"_22539":34,"_5":22694,"_19069":32573,"_15331":32574,"_1610":32575},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#uso-en-ci","Uso en CI",{"_8047":57,"_22539":34,"_5":22694,"_19069":32577,"_15331":32578,"_1610":32579},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#ejemplo-rápido","Ejemplo rápido",{"_8047":58,"_22539":34,"_5":22694,"_19069":32581,"_15331":32582,"_1610":32583},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#resumen","Resumen",{"_8047":59,"_22539":34,"_19069":32585,"_5":22689,"_15331":32494,"_1610":32586},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_8047":60,"_22539":34,"_19069":32588,"_5":22689,"_15331":32494,"_1610":32589},[],"La instalación incluye:",{"_8047":61,"_22539":34,"_19069":32591,"_5":22689,"_15331":32494,"_1610":32592},[],"PostgreSQL",{"_8047":62,"_22539":34,"_19069":32594,"_5":22689,"_15331":32494,"_1610":32595},[],"Keycloak",{"_8047":63,"_22539":34,"_19069":32597,"_5":22689,"_15331":32494,"_1610":32598},[],"RabbitMQ",{"_8047":64,"_22539":34,"_19069":32600,"_5":22689,"_15331":32494,"_1610":32601},[],"Chart Helm de Lamassu",{"_8047":65,"_22539":34,"_19069":32603,"_5":22689,"_15331":32498,"_1610":32604},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_8047":66,"_22539":34,"_19069":32606,"_5":22689,"_15331":32498,"_1610":32607},[],"Flag",{"_8047":67,"_22539":34,"_19069":32609,"_5":22689,"_15331":32498,"_1610":32610},[],"Valor por defecto",{"_8047":68,"_22539":34,"_19069":32612,"_5":22689,"_15331":32498,"_1610":32613},[],"Descripción",{"_8047":69,"_22539":34,"_19069":32615,"_5":22689,"_15331":32498,"_1610":32616},[],"`-h`, `--help`",{"_8047":70,"_22539":34,"_19069":32618,"_5":22689,"_15331":32498,"_1610":3067},[],{"_8047":71,"_22539":34,"_19069":32620,"_5":22689,"_15331":32498,"_1610":32621},[],"Muestra la ayuda y finaliza",{"_8047":72,"_22539":34,"_19069":32623,"_5":22689,"_15331":32498,"_1610":32624},[],"`-n`, `--non-interactive`",{"_8047":73,"_22539":34,"_19069":32626,"_5":22689,"_15331":32498,"_1610":32627},[],"`false`",{"_8047":74,"_22539":34,"_19069":32629,"_5":22689,"_15331":32498,"_1610":32630},[],"Omite prompts y genera/usa credenciales por defecto",{"_8047":75,"_22539":34,"_19069":32632,"_5":22689,"_15331":32498,"_1610":32633},[],"`-ns`, `--namespace`",{"_8047":76,"_22539":34,"_19069":32635,"_5":22689,"_15331":32498,"_1610":32636},[],"`lamassu-dev`",{"_8047":77,"_22539":34,"_19069":32638,"_5":22689,"_15331":32498,"_1610":32639},[],"Namespace Kubernetes donde se despliegan los recursos",{"_8047":78,"_22539":34,"_19069":32641,"_5":22689,"_15331":32498,"_1610":32642},[],"`-d`, `--domain`",{"_8047":79,"_22539":34,"_19069":32644,"_5":22689,"_15331":32498,"_1610":32645},[],"`dev.lamassu.io`",{"_8047":80,"_22539":34,"_19069":32647,"_5":22689,"_15331":32498,"_1610":32648},[],"Dominio usado para endpoint y certificados TLS",{"_8047":81,"_22539":34,"_19069":32650,"_5":22689,"_15331":32498,"_1610":32651},[],"`-v`, `--version`",{"_8047":82,"_22539":34,"_19069":32653,"_5":22689,"_15331":32498,"_1610":32654},[],"`latest`",{"_8047":83,"_22539":34,"_19069":32656,"_5":22689,"_15331":32498,"_1610":32657},[],"Versión del chart Helm de Lamassu",{"_8047":84,"_22539":34,"_19069":32659,"_5":22689,"_15331":32498,"_1610":32660},[],"`--https-port`",{"_8047":85,"_22539":34,"_19069":32662,"_5":22689,"_15331":32498,"_1610":32663},[],"`443`",{"_8047":86,"_22539":34,"_19069":32665,"_5":22689,"_15331":32498,"_1610":32666},[],"Puerto HTTPS del gateway",{"_8047":87,"_22539":34,"_19069":32668,"_5":22689,"_15331":32498,"_1610":32669},[],"`--http-port`",{"_8047":88,"_22539":34,"_19069":32671,"_5":22689,"_15331":32498,"_1610":32672},[],"`80`",{"_8047":89,"_22539":34,"_19069":32674,"_5":22689,"_15331":32498,"_1610":32675},[],"Puerto HTTP del gateway",{"_8047":90,"_22539":34,"_19069":32677,"_5":22689,"_15331":32498,"_1610":32678},[],"`--offline`",{"_8047":91,"_22539":34,"_19069":32680,"_5":22689,"_15331":32498,"_1610":32627},[],{"_8047":92,"_22539":34,"_19069":32682,"_5":22689,"_15331":32498,"_1610":32683},[],"Activa modo offline",{"_8047":93,"_22539":34,"_19069":32685,"_5":22689,"_15331":32498,"_1610":32686},[],"`--tls-crt`",{"_8047":94,"_22539":34,"_19069":32688,"_5":22689,"_15331":32498,"_1610":3067},[],{"_8047":95,"_22539":34,"_19069":32690,"_5":22689,"_15331":32498,"_1610":32691},[],"Ruta al certificado TLS (PEM)",{"_8047":96,"_22539":34,"_19069":32693,"_5":22689,"_15331":32498,"_1610":32694},[],"`--tls-key`",{"_8047":97,"_22539":34,"_19069":32696,"_5":22689,"_15331":32498,"_1610":3067},[],{"_8047":98,"_22539":34,"_19069":32698,"_5":22689,"_15331":32498,"_1610":32699},[],"Ruta a la clave privada TLS (PEM)",{"_8047":99,"_22539":34,"_19069":32701,"_5":22689,"_15331":32498,"_1610":32702},[],"`--helm-chart-lamassu`",{"_8047":100,"_22539":34,"_19069":32704,"_5":22689,"_15331":32498,"_1610":3067},[],{"_8047":101,"_22539":34,"_19069":32706,"_5":22689,"_15331":32498,"_1610":32707},[],"Ruta a chart local Lamassu (`.tgz`)",{"_8047":102,"_22539":34,"_19069":32709,"_5":22689,"_15331":32498,"_1610":32710},[],"`--helm-chart-postgres`",{"_8047":103,"_22539":34,"_19069":32712,"_5":22689,"_15331":32498,"_1610":3067},[],{"_8047":104,"_22539":34,"_19069":32714,"_5":22689,"_15331":32498,"_1610":32715},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_8047":105,"_22539":34,"_19069":32717,"_5":22689,"_15331":32498,"_1610":32718},[],"`--helm-chart-keycloak`",{"_8047":106,"_22539":34,"_19069":32720,"_5":22689,"_15331":32498,"_1610":3067},[],{"_8047":107,"_22539":34,"_19069":32722,"_5":22689,"_15331":32498,"_1610":32723},[],"Ruta a chart local Keycloak (`.tgz`)",{"_8047":108,"_22539":34,"_19069":32725,"_5":22689,"_15331":32498,"_1610":32726},[],"`--helm-chart-rabbitmq`",{"_8047":109,"_22539":34,"_19069":32728,"_5":22689,"_15331":32498,"_1610":3067},[],{"_8047":110,"_22539":34,"_19069":32730,"_5":22689,"_15331":32498,"_1610":32731},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_8047":111,"_22539":34,"_19069":32733,"_5":22689,"_15331":32498,"_1610":32734},[],"`-l`, `--local-chart-path`",{"_8047":112,"_22539":34,"_19069":32736,"_5":22689,"_15331":32498,"_1610":3067},[],{"_8047":113,"_22539":34,"_19069":32738,"_5":22689,"_15331":32498,"_1610":32739},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_8047":114,"_22539":34,"_19069":32741,"_5":22689,"_15331":32502,"_1610":32742},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_8047":115,"_22539":34,"_19069":32744,"_5":22689,"_15331":32502,"_1610":32745},[],"`microk8s`",{"_8047":116,"_22539":34,"_19069":32747,"_5":22689,"_15331":32502,"_1610":32748},[],"`k3s`",{"_8047":117,"_22539":34,"_19069":32750,"_5":22689,"_15331":32502,"_1610":32751},[],"`kind`",{"_8047":118,"_22539":34,"_19069":32753,"_5":22689,"_15331":32502,"_1610":32754},[],"Kubernetes estándar",{"_8047":119,"_22539":34,"_19069":32756,"_5":22689,"_15331":32502,"_1610":32757},[],"Comportamientos específicos:",{"_8047":120,"_22539":34,"_19069":32759,"_5":22689,"_15331":32502,"_1610":32760},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_8047":121,"_22539":34,"_19069":32762,"_5":22689,"_15331":32502,"_1610":32763},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_8047":122,"_22539":34,"_19069":32765,"_5":22689,"_15331":32506,"_1610":32766},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_8047":123,"_22539":34,"_19069":32768,"_5":22689,"_15331":32506,"_1610":32769},[],"Requisitos generales:",{"_8047":124,"_22539":34,"_19069":32771,"_5":22689,"_15331":32506,"_1610":32772},[],"`yq`",{"_8047":125,"_22539":34,"_19069":32774,"_5":22689,"_15331":32506,"_1610":32775},[],"CLI de la distribución detectada",{"_8047":126,"_22539":34,"_19069":32777,"_5":22689,"_15331":32506,"_1610":32778},[],"Requisitos específicos:",{"_8047":127,"_22539":34,"_19069":32780,"_5":22689,"_15331":32506,"_1610":32781},[],"Distribución",{"_8047":128,"_22539":34,"_19069":32783,"_5":22689,"_15331":32506,"_1610":32784},[],"Herramientas requeridas",{"_8047":129,"_22539":34,"_19069":32786,"_5":22689,"_15331":32506,"_1610":32748},[],{"_8047":130,"_22539":34,"_19069":32788,"_5":22689,"_15331":32506,"_1610":32789},[],"`kubectl`, `helm`",{"_8047":131,"_22539":34,"_19069":32791,"_5":22689,"_15331":32506,"_1610":32745},[],{"_8047":132,"_22539":34,"_19069":32793,"_5":22689,"_15331":32506,"_1610":32794},[],"`microk8s kubectl`, `microk8s helm`",{"_8047":133,"_22539":34,"_19069":32796,"_5":22689,"_15331":32510,"_1610":32797},[],"Se valida que estén habilitados:",{"_8047":134,"_22539":34,"_19069":32799,"_5":22689,"_15331":32510,"_1610":32800},[],"`helm`",{"_8047":135,"_22539":34,"_19069":32802,"_5":22689,"_15331":32510,"_1610":32803},[],"`hostpath-storage`",{"_8047":136,"_22539":34,"_19069":32805,"_5":22689,"_15331":32510,"_1610":32806},[],"`dns`",{"_8047":137,"_22539":34,"_19069":32808,"_5":22689,"_15331":32510,"_1610":32809},[],"`cert-manager`",{"_8047":138,"_22539":34,"_19069":32811,"_5":22689,"_15331":32510,"_1610":32812},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_8047":139,"_22539":34,"_19069":32814,"_5":22689,"_15331":32518,"_1610":32815},[],"La función `request_config_data` solicita:",{"_8047":140,"_22539":34,"_19069":32817,"_5":22689,"_15331":32518,"_1610":32818},[],"Dominio Lamassu",{"_8047":141,"_22539":34,"_19069":32820,"_5":22689,"_15331":32518,"_1610":32821},[],"Usuario y contraseña admin PostgreSQL",{"_8047":142,"_22539":34,"_19069":32823,"_5":22689,"_15331":32518,"_1610":32824},[],"Usuario y contraseña admin RabbitMQ",{"_8047":143,"_22539":34,"_19069":32826,"_5":22689,"_15331":32518,"_1610":32827},[],"Usuario y contraseña admin Keycloak",{"_8047":144,"_22539":34,"_19069":32829,"_5":22689,"_15331":32518,"_1610":32830},[],"Namespace Kubernetes",{"_8047":145,"_22539":34,"_19069":32832,"_5":22689,"_15331":32522,"_1610":32833},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_8047":146,"_22539":34,"_19069":32835,"_5":22689,"_15331":32522,"_1610":32836},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_8047":147,"_22539":34,"_19069":32838,"_5":22689,"_15331":32526,"_1610":32839},[],"El script admite dos estrategias para obtener charts Helm.",{"_8047":148,"_22539":34,"_19069":32841,"_5":22689,"_15331":32530,"_1610":32842},[],"Los charts se descargan desde repositorios remotos.",{"_8047":149,"_22539":34,"_19069":32844,"_5":22689,"_15331":32534,"_1610":32845},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_8047":150,"_22539":34,"_19069":32847,"_5":22689,"_15331":32534,"_1610":32702},[],{"_8047":151,"_22539":34,"_19069":32849,"_5":22689,"_15331":32534,"_1610":32710},[],{"_8047":152,"_22539":34,"_19069":32851,"_5":22689,"_15331":32534,"_1610":32718},[],{"_8047":153,"_22539":34,"_19069":32853,"_5":22689,"_15331":32534,"_1610":32726},[],{"_8047":154,"_22539":34,"_19069":32855,"_5":22689,"_15331":32534,"_1610":32856},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_8047":155,"_22539":34,"_19069":32858,"_5":22689,"_15331":32534,"_1610":32859},[],"En este modo se fuerza:",{"_8047":156,"_22539":34,"_19069":32861,"_5":22689,"_15331":32542,"_1610":32862},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_8047":157,"_22539":34,"_19069":32864,"_5":22689,"_15331":32542,"_1610":32865},[],"Versión del chart: `0.19.0`",{"_8047":158,"_22539":34,"_19069":32867,"_5":22689,"_15331":32542,"_1610":32868},[],"Release: `postgres`",{"_8047":159,"_22539":34,"_19069":32870,"_5":22689,"_15331":32542,"_1610":32871},[],"`fullnameOverride: \"postgresql\"`",{"_8047":160,"_22539":34,"_19069":32873,"_5":22689,"_15331":32542,"_1610":32874},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_8047":161,"_22539":34,"_19069":32876,"_5":22689,"_15331":32542,"_1610":32877},[],"Base de datos",{"_8047":162,"_22539":34,"_19069":32879,"_5":22689,"_15331":32542,"_1610":32880},[],"Servicio",{"_8047":163,"_22539":34,"_19069":32882,"_5":22689,"_15331":32542,"_1610":32883},[],"`auth`",{"_8047":164,"_22539":34,"_19069":32885,"_5":22689,"_15331":32542,"_1610":32595},[],{"_8047":165,"_22539":34,"_19069":32887,"_5":22689,"_15331":32542,"_1610":32888},[],"`alerts`",{"_8047":166,"_22539":34,"_19069":32890,"_5":22689,"_15331":32542,"_1610":32891},[],"Alerts",{"_8047":167,"_22539":34,"_19069":32893,"_5":22689,"_15331":32542,"_1610":32894},[],"`ca`",{"_8047":168,"_22539":34,"_19069":32896,"_5":22689,"_15331":32542,"_1610":32897},[],"CA",{"_8047":169,"_22539":34,"_19069":32899,"_5":22689,"_15331":32542,"_1610":32900},[],"`va`",{"_8047":170,"_22539":34,"_19069":32902,"_5":22689,"_15331":32542,"_1610":32903},[],"VA",{"_8047":171,"_22539":34,"_19069":32905,"_5":22689,"_15331":32542,"_1610":32906},[],"`cloudproxy`",{"_8047":172,"_22539":34,"_19069":32908,"_5":22689,"_15331":32542,"_1610":32909},[],"Cloud Proxy",{"_8047":173,"_22539":34,"_19069":32911,"_5":22689,"_15331":32542,"_1610":32912},[],"`devicemanager`",{"_8047":174,"_22539":34,"_19069":32914,"_5":22689,"_15331":32542,"_1610":32915},[],"Device Manager",{"_8047":175,"_22539":34,"_19069":32917,"_5":22689,"_15331":32542,"_1610":32918},[],"`dmsmanager`",{"_8047":176,"_22539":34,"_19069":32920,"_5":22689,"_15331":32542,"_1610":32921},[],"DMS Manager",{"_8047":177,"_22539":34,"_19069":32923,"_5":22689,"_15331":32542,"_1610":32924},[],"`kms`",{"_8047":178,"_22539":34,"_19069":32926,"_5":22689,"_15331":32542,"_1610":32927},[],"KMS",{"_8047":179,"_22539":34,"_19069":32929,"_5":22689,"_15331":32546,"_1610":32930},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_8047":180,"_22539":34,"_19069":32932,"_5":22689,"_15331":32546,"_1610":32933},[],"Versión del chart: `0.20.0`",{"_8047":181,"_22539":34,"_19069":32935,"_5":22689,"_15331":32546,"_1610":32936},[],"Release: `auth`",{"_8047":182,"_22539":34,"_19069":32938,"_5":22689,"_15331":32546,"_1610":32939},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_8047":183,"_22539":34,"_19069":32941,"_5":22689,"_15331":32546,"_1610":32942},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_8047":184,"_22539":34,"_19069":32944,"_5":22689,"_15331":32546,"_1610":32945},[],"`httpRelativePath: /auth/`",{"_8047":185,"_22539":34,"_19069":32947,"_5":22689,"_15331":32546,"_1610":32948},[],"`proxyHeaders: xforwarded`",{"_8047":186,"_22539":34,"_19069":32950,"_5":22689,"_15331":32546,"_1610":32951},[],"Configuración automática del realm `lamassu`:",{"_8047":187,"_22539":34,"_19069":32953,"_5":22689,"_15331":32546,"_1610":32954},[],"Rol: `pki-admin`",{"_8047":188,"_22539":34,"_19069":32956,"_5":22689,"_15331":32546,"_1610":32957},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_8047":189,"_22539":34,"_19069":32959,"_5":22689,"_15331":32546,"_1610":32960},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_8047":190,"_22539":34,"_19069":32962,"_5":22689,"_15331":32546,"_1610":32963},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_8047":191,"_22539":34,"_19069":32965,"_5":22689,"_15331":32546,"_1610":32966},[],"`github.com/lamassuiot/keycloak-theme`",{"_8047":192,"_22539":34,"_19069":32968,"_5":22689,"_15331":32550,"_1610":32969},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_8047":193,"_22539":34,"_19069":32971,"_5":22689,"_15331":32550,"_1610":32933},[],{"_8047":194,"_22539":34,"_19069":32973,"_5":22689,"_15331":32550,"_1610":32974},[],"Release: `rabbitmq`",{"_8047":195,"_22539":34,"_19069":32976,"_5":22689,"_15331":32550,"_1610":32977},[],"`fullnameOverride: \"rabbitmq\"`",{"_8047":196,"_22539":34,"_19069":32979,"_5":22689,"_15331":32550,"_1610":32980},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_8047":197,"_22539":34,"_19069":32982,"_5":22689,"_15331":32554,"_1610":32983},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_8047":198,"_22539":34,"_19069":32985,"_5":22689,"_15331":32554,"_1610":32986},[],"Configuraciones principales:",{"_8047":199,"_22539":34,"_19069":32988,"_5":22689,"_15331":32554,"_1610":32989},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_8047":200,"_22539":34,"_19069":32991,"_5":22689,"_15331":32554,"_1610":32992},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_8047":201,"_22539":34,"_19069":32994,"_5":22689,"_15331":32554,"_1610":32995},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_8047":202,"_22539":34,"_19069":32997,"_5":22689,"_15331":32554,"_1610":32998},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_8047":203,"_22539":34,"_19069":33000,"_5":22689,"_15331":32554,"_1610":33001},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_8047":204,"_22539":34,"_19069":33003,"_5":22689,"_15331":32554,"_1610":33004},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_8047":205,"_22539":34,"_19069":33006,"_5":22689,"_15331":32554,"_1610":33007},[],"Dominios CA: valor de `--domain`",{"_8047":206,"_22539":34,"_19069":33009,"_5":22689,"_15331":32554,"_1610":33010},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_8047":207,"_22539":34,"_19069":33012,"_5":22689,"_15331":32554,"_1610":33013},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_8047":208,"_22539":34,"_19069":33015,"_5":22689,"_15331":32554,"_1610":33016},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_8047":209,"_22539":34,"_19069":33018,"_5":22689,"_15331":32562,"_1610":33019},[],"Si se proporcionan:",{"_8047":210,"_22539":34,"_19069":33021,"_5":22689,"_15331":32562,"_1610":32686},[],{"_8047":211,"_22539":34,"_19069":33023,"_5":22689,"_15331":32562,"_1610":32694},[],{"_8047":212,"_22539":34,"_19069":33025,"_5":22689,"_15331":32562,"_1610":33026},[],"Se crea un secret Kubernetes:",{"_8047":213,"_22539":34,"_19069":33028,"_5":22689,"_15331":32562,"_1610":33029},[],"`downstream-provided-crt`",{"_8047":214,"_22539":34,"_19069":33031,"_5":22689,"_15331":32562,"_1610":33032},[],"Y se configura:",{"_8047":215,"_22539":34,"_19069":33034,"_5":22689,"_15331":32566,"_1610":33035},[],"Si no se proporciona certificado:",{"_8047":216,"_22539":34,"_19069":33037,"_5":22689,"_15331":32566,"_1610":33038},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_8047":217,"_22539":34,"_19069":33040,"_5":22689,"_15331":32566,"_1610":33041},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_8047":218,"_22539":34,"_19069":33043,"_5":22689,"_15331":32570,"_1610":33044},[],"En caso de éxito, se muestra:",{"_8047":219,"_22539":34,"_19069":33046,"_5":22689,"_15331":32570,"_1610":33047},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_8047":220,"_22539":34,"_19069":33049,"_5":22689,"_15331":32570,"_1610":33050},[],"Credenciales iniciales: `lamassu / lamassu`",{"_8047":221,"_22539":34,"_19069":33052,"_5":22689,"_15331":32570,"_1610":33053},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_8047":222,"_22539":34,"_19069":33055,"_5":22689,"_15331":32570,"_1610":33056},[],"Credenciales admin de Keycloak",{"_8047":223,"_22539":34,"_19069":33058,"_5":22689,"_15331":32570,"_1610":33059},[],"El usuario `lamassu` se crea con:",{"_8047":224,"_22539":34,"_19069":33061,"_5":22689,"_15331":32570,"_1610":33062},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_8047":225,"_22539":34,"_19069":33064,"_5":22689,"_15331":32574,"_1610":33065},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_8047":226,"_22539":34,"_19069":33067,"_5":22689,"_15331":32574,"_1610":33068},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_8047":227,"_22539":34,"_19069":33070,"_5":22689,"_15331":32574,"_1610":33071},[],"Ejemplo:",{"_8047":228,"_22539":34,"_19069":33073,"_5":22689,"_15331":32574,"_1610":33074},[],"En este escenario:",{"_8047":229,"_22539":34,"_19069":33076,"_5":22689,"_15331":32574,"_1610":33077},[],"`-n`: modo no interactivo",{"_8047":230,"_22539":34,"_19069":33079,"_5":22689,"_15331":32574,"_1610":33080},[],"`-ns`: namespace específico",{"_8047":231,"_22539":34,"_19069":33082,"_5":22689,"_15331":32574,"_1610":33083},[],"`-d`: dominio de CI",{"_8047":232,"_22539":34,"_19069":33085,"_5":22689,"_15331":32574,"_1610":33086},[],"`-l`: chart local",{"_8047":233,"_22539":34,"_19069":33088,"_5":22689,"_15331":32582,"_1610":33089},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_8047":234,"_22539":34,"_19069":33091,"_5":22689,"_15331":32582,"_1610":33092},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_8047":235,"_22539":235,"_5":22684,"_1610":33094,"_22697":33095,"_19069":33096,"_15331":235},"Introducción",[32410,32411,32462],[],{"_8047":236,"_22539":235,"_19069":33098,"_5":22689,"_15331":235,"_1610":33099},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_8047":237,"_22539":235,"_5":22694,"_19069":33101,"_15331":33102,"_1610":33103},[],"/docs/pr-preview/pr-25/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_8047":238,"_22539":235,"_5":22694,"_19069":33105,"_15331":33106,"_1610":33107},[],"/docs/pr-preview/pr-25/despliegue/onprem#quickstart","Quickstart",{"_8047":239,"_22539":235,"_5":22694,"_19069":33109,"_15331":33110,"_1610":33111},[],"/docs/pr-preview/pr-25/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_8047":240,"_22539":235,"_5":22694,"_19069":33113,"_15331":33114,"_1610":33115},[],"/docs/pr-preview/pr-25/despliegue/onprem#requisitos-previos","Requisitos previos",{"_8047":241,"_22539":235,"_5":22694,"_19069":33117,"_15331":33118,"_1610":33119},[],"/docs/pr-preview/pr-25/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_8047":242,"_22539":235,"_5":22694,"_19069":33121,"_15331":33122,"_1610":33123},[],"/docs/pr-preview/pr-25/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_8047":243,"_22539":235,"_5":22694,"_19069":33125,"_15331":33126,"_1610":33127},[],"/docs/pr-preview/pr-25/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_8047":244,"_22539":235,"_5":22694,"_19069":33129,"_15331":33130,"_1610":33131},[],"/docs/pr-preview/pr-25/despliegue/onprem#arquitectura","Arquitectura",{"_8047":245,"_22539":235,"_5":22694,"_19069":33133,"_15331":33134,"_1610":33135},[],"/docs/pr-preview/pr-25/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_8047":246,"_22539":235,"_5":22694,"_19069":33137,"_15331":33138,"_1610":33139},[],"/docs/pr-preview/pr-25/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_8047":247,"_22539":235,"_5":22694,"_19069":33141,"_15331":33142,"_1610":33143},[],"/docs/pr-preview/pr-25/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_8047":248,"_22539":235,"_5":22694,"_19069":33145,"_15331":33146,"_1610":33147},[],"/docs/pr-preview/pr-25/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_8047":249,"_22539":235,"_5":22694,"_19069":33149,"_15331":33150,"_1610":33151},[],"/docs/pr-preview/pr-25/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_8047":250,"_22539":235,"_5":22694,"_19069":33153,"_15331":33154,"_1610":33155},[],"/docs/pr-preview/pr-25/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_8047":251,"_22539":235,"_5":22694,"_19069":33157,"_15331":33158,"_1610":33159},[],"/docs/pr-preview/pr-25/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_8047":252,"_22539":235,"_19069":33161,"_5":22689,"_15331":33102,"_1610":33162},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_8047":253,"_22539":235,"_19069":33164,"_5":22689,"_15331":33102,"_1610":33165},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_8047":254,"_22539":235,"_19069":33167,"_5":22689,"_15331":33102,"_1610":33168},[],"el chart principal de Lamassu",{"_8047":255,"_22539":235,"_19069":33170,"_5":22689,"_15331":33102,"_1610":33171},[],"un chart auxiliar de SoftHSM",{"_8047":256,"_22539":235,"_19069":33173,"_5":22689,"_15331":33102,"_1610":33174},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_8047":257,"_22539":235,"_19069":33176,"_5":22689,"_15331":33106,"_1610":33177},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_8047":258,"_22539":235,"_19069":33179,"_5":22689,"_15331":33106,"_1610":33180},[],"Ese flujo:",{"_8047":259,"_22539":235,"_19069":33182,"_5":22689,"_15331":33106,"_1610":33183},[],"crea o reutiliza el namespace indicado",{"_8047":260,"_22539":235,"_19069":33185,"_5":22689,"_15331":33106,"_1610":33186},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_8047":261,"_22539":235,"_19069":33188,"_5":22689,"_15331":33106,"_1610":33189},[],"despliega el chart de Lamassu",{"_8047":262,"_22539":235,"_19069":33191,"_5":22689,"_15331":33106,"_1610":33192},[],"deja la UI expuesta en `https://<dominio>`",{"_8047":263,"_22539":235,"_19069":33194,"_5":22689,"_15331":33106,"_1610":33195},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_8047":264,"_22539":235,"_19069":33197,"_5":22689,"_15331":33110,"_1610":33198},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_8047":265,"_22539":235,"_19069":33200,"_5":22689,"_15331":33110,"_1610":33201},[],"`ui`",{"_8047":266,"_22539":235,"_19069":33203,"_5":22689,"_15331":33110,"_1610":32894},[],{"_8047":267,"_22539":235,"_19069":33205,"_5":22689,"_15331":33110,"_1610":32900},[],{"_8047":268,"_22539":235,"_19069":33207,"_5":22689,"_15331":33110,"_1610":32924},[],{"_8047":269,"_22539":235,"_19069":33209,"_5":22689,"_15331":33110,"_1610":33210},[],"`device-manager`",{"_8047":270,"_22539":235,"_19069":33212,"_5":22689,"_15331":33110,"_1610":33213},[],"`dms-manager`",{"_8047":271,"_22539":235,"_19069":33215,"_5":22689,"_15331":33110,"_1610":32888},[],{"_8047":272,"_22539":235,"_19069":33217,"_5":22689,"_15331":33110,"_1610":33218},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_8047":273,"_22539":235,"_19069":33220,"_5":22689,"_15331":33110,"_1610":33221},[],"job de migraciones de base de datos",{"_8047":274,"_22539":235,"_19069":33223,"_5":22689,"_15331":33114,"_1610":33224},[],"Clúster Kubernetes `1.19+`",{"_8047":275,"_22539":235,"_19069":33226,"_5":22689,"_15331":33114,"_1610":33227},[],"`kubectl` configurado con acceso al clúster",{"_8047":276,"_22539":235,"_19069":33229,"_5":22689,"_15331":33114,"_1610":33230},[],"Helm `3.2.0+`",{"_8047":277,"_22539":235,"_19069":33232,"_5":22689,"_15331":33114,"_1610":33233},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_8047":278,"_22539":235,"_19069":33235,"_5":22689,"_15331":33114,"_1610":33236},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_8047":279,"_22539":235,"_19069":33238,"_5":22689,"_15331":33114,"_1610":33239},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_8047":280,"_22539":235,"_19069":33241,"_5":22689,"_15331":33114,"_1610":33242},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_8047":281,"_22539":235,"_19069":33244,"_5":22689,"_15331":33118,"_1610":33245},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_8047":282,"_22539":235,"_19069":33247,"_5":22689,"_15331":33122,"_1610":33248},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_8047":283,"_22539":235,"_19069":33250,"_5":22689,"_15331":33126,"_1610":33251},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_8047":284,"_22539":235,"_19069":33253,"_5":22689,"_15331":33130,"_1610":33254},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_8047":285,"_22539":235,"_19069":33256,"_5":22689,"_15331":33130,"_1610":33257},[],"Dependencias externas requeridas por el chart principal:",{"_8047":286,"_22539":235,"_19069":33259,"_5":22689,"_15331":33130,"_1610":32592},[],{"_8047":287,"_22539":235,"_19069":33261,"_5":22689,"_15331":33130,"_1610":32598},[],{"_8047":288,"_22539":235,"_19069":33263,"_5":22689,"_15331":33130,"_1610":33264},[],"proveedor OIDC, típicamente Keycloak",{"_8047":289,"_22539":235,"_19069":33266,"_5":22689,"_15331":33130,"_1610":33267},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_8047":290,"_22539":235,"_19069":33269,"_5":22689,"_15331":33134,"_1610":33270},[],"Agregar el repositorio Helm:",{"_8047":291,"_22539":235,"_19069":33272,"_5":22689,"_15331":33134,"_1610":33273},[],"O instalar desde una copia local del repositorio:",{"_8047":292,"_22539":235,"_19069":33275,"_5":22689,"_15331":33138,"_1610":33276},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_8047":293,"_22539":235,"_19069":33278,"_5":22689,"_15331":33138,"_1610":33279},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_8047":294,"_22539":235,"_19069":33281,"_5":22689,"_15331":33138,"_1610":33282},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_8047":295,"_22539":235,"_19069":33284,"_5":22689,"_15331":33138,"_1610":33285},[],"`auth.oidc.frontend.authority`",{"_8047":296,"_22539":235,"_19069":33287,"_5":22689,"_15331":33138,"_1610":33288},[],"`auth.oidc.apiGateway.jwks`",{"_8047":297,"_22539":235,"_19069":33290,"_5":22689,"_15331":33138,"_1610":33291},[],"`services.ca.domains`",{"_8047":298,"_22539":235,"_19069":33293,"_5":22689,"_15331":33138,"_1610":33294},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_8047":299,"_22539":235,"_19069":33296,"_5":22689,"_15331":33138,"_1610":33297},[],"`tls.*` según se use `certManager` o certificado externo",{"_8047":300,"_22539":235,"_19069":33299,"_5":22689,"_15331":33138,"_1610":33300},[],"Ejemplo base:",{"_8047":301,"_22539":235,"_19069":33302,"_5":22689,"_15331":33142,"_1610":33303},[],"Área",{"_8047":302,"_22539":235,"_19069":33305,"_5":22689,"_15331":33142,"_1610":33306},[],"Valores clave",{"_8047":303,"_22539":235,"_19069":33308,"_5":22689,"_15331":33142,"_1610":33309},[],"Uso",{"_8047":304,"_22539":235,"_19069":33311,"_5":22689,"_15331":33142,"_1610":33312},[],"TLS",{"_8047":305,"_22539":235,"_19069":33314,"_5":22689,"_15331":33142,"_1610":33315},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_8047":306,"_22539":235,"_19069":33317,"_5":22689,"_15331":33142,"_1610":33318},[],"Certificado downstream del Gateway",{"_8047":307,"_22539":235,"_19069":33320,"_5":22689,"_15331":33142,"_1610":33321},[],"Gateway",{"_8047":308,"_22539":235,"_19069":33323,"_5":22689,"_15331":33142,"_1610":33324},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_8047":309,"_22539":235,"_19069":33326,"_5":22689,"_15331":33142,"_1610":33327},[],"Exposición de UI y APIs vía Envoy Gateway",{"_8047":310,"_22539":235,"_19069":33329,"_5":22689,"_15331":33142,"_1610":32877},[],{"_8047":311,"_22539":235,"_19069":33331,"_5":22689,"_15331":33142,"_1610":33332},[],"`postgres.*`",{"_8047":312,"_22539":235,"_19069":33334,"_5":22689,"_15331":33142,"_1610":33335},[],"Conexión a PostgreSQL externa",{"_8047":313,"_22539":235,"_19069":33337,"_5":22689,"_15331":33142,"_1610":33338},[],"Mensajería",{"_8047":314,"_22539":235,"_19069":33340,"_5":22689,"_15331":33142,"_1610":33341},[],"`amqp.*`",{"_8047":315,"_22539":235,"_19069":33343,"_5":22689,"_15331":33142,"_1610":33344},[],"Conexión a RabbitMQ",{"_8047":316,"_22539":235,"_19069":33346,"_5":22689,"_15331":33142,"_1610":33347},[],"OIDC",{"_8047":317,"_22539":235,"_19069":33349,"_5":22689,"_15331":33142,"_1610":33350},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_8047":318,"_22539":235,"_19069":33352,"_5":22689,"_15331":33142,"_1610":33353},[],"Login de UI y validación JWT en el Gateway",{"_8047":319,"_22539":235,"_19069":33355,"_5":22689,"_15331":33142,"_1610":32897},[],{"_8047":320,"_22539":235,"_19069":33357,"_5":22689,"_15331":33142,"_1610":33291},[],{"_8047":321,"_22539":235,"_19069":33359,"_5":22689,"_15331":33142,"_1610":33360},[],"Dominios autorizados para CA y certificados",{"_8047":322,"_22539":235,"_19069":33362,"_5":22689,"_15331":33142,"_1610":32927},[],{"_8047":323,"_22539":235,"_19069":33364,"_5":22689,"_15331":33142,"_1610":33365},[],"`services.kms.cryptoEngines.*`",{"_8047":324,"_22539":235,"_19069":33367,"_5":22689,"_15331":33142,"_1610":33368},[],"Motor criptográfico y almacenamiento de claves",{"_8047":325,"_22539":235,"_19069":33370,"_5":22689,"_15331":33142,"_1610":32891},[],{"_8047":326,"_22539":235,"_19069":33372,"_5":22689,"_15331":33142,"_1610":33373},[],"`services.alerts.smtp_server.*`",{"_8047":327,"_22539":235,"_19069":33375,"_5":22689,"_15331":33142,"_1610":33376},[],"Envío de correo para alertas",{"_8047":328,"_22539":235,"_19069":33378,"_5":22689,"_15331":33146,"_1610":33379},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_8047":329,"_22539":235,"_19069":33381,"_5":22689,"_15331":33146,"_1610":33382},[],"La prueba comprueba al menos:",{"_8047":330,"_22539":235,"_19069":33384,"_5":22689,"_15331":33146,"_1610":33385},[],"salud de `ca`",{"_8047":331,"_22539":235,"_19069":33387,"_5":22689,"_15331":33146,"_1610":33388},[],"salud de `dms-manager`",{"_8047":332,"_22539":235,"_19069":33390,"_5":22689,"_15331":33146,"_1610":33391},[],"salud de `device-manager`",{"_8047":333,"_22539":235,"_19069":33393,"_5":22689,"_15331":33146,"_1610":33394},[],"salud de `va`",{"_8047":334,"_22539":235,"_19069":33396,"_5":22689,"_15331":33146,"_1610":33397},[],"respuesta HTML esperada del servicio `ui`",{"_8047":335,"_22539":235,"_19069":33399,"_5":22689,"_15331":33150,"_1610":33400},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_8047":336,"_22539":235,"_19069":33402,"_5":22689,"_15331":33150,"_1610":33403},[],"`charts/lamassu`: chart principal de Lamassu",{"_8047":337,"_22539":235,"_19069":33405,"_5":22689,"_15331":33150,"_1610":33406},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_8047":338,"_22539":235,"_19069":33408,"_5":22689,"_15331":33150,"_1610":33409},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_8047":339,"_22539":235,"_19069":33411,"_5":22689,"_15331":33154,"_1610":33412},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_8047":340,"_22539":235,"_19069":33414,"_5":22689,"_15331":33158,"_1610":33415},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_8047":341,"_22539":341,"_5":22684,"_1610":33417,"_22697":33418,"_19069":33419,"_15331":341},"SaaS · Suscripción",[32410,32411,32469],[],{"_8047":342,"_22539":341,"_19069":33421,"_5":22689,"_15331":341,"_1610":33422},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_8047":343,"_22539":341,"_5":22694,"_19069":33424,"_15331":33425,"_1610":33426},[],"/docs/pr-preview/pr-25/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_8047":344,"_22539":341,"_5":22694,"_19069":33428,"_15331":33429,"_1610":33430},[],"/docs/pr-preview/pr-25/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_8047":345,"_22539":341,"_5":22694,"_19069":33432,"_15331":33433,"_1610":33434},[],"/docs/pr-preview/pr-25/despliegue/saas#planes-disponibles","Planes disponibles",{"_8047":346,"_22539":341,"_5":22694,"_19069":33436,"_15331":33437,"_1610":33438},[],"/docs/pr-preview/pr-25/despliegue/saas#contacto","Contacto",{"_8047":347,"_22539":341,"_19069":33440,"_5":22689,"_15331":33425,"_1610":33441},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_8047":348,"_22539":341,"_19069":33443,"_5":22689,"_15331":33429,"_1610":33444},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_8047":349,"_22539":341,"_19069":33446,"_5":22689,"_15331":33429,"_1610":33447},[],"Alta disponibilidad y backups automáticos",{"_8047":350,"_22539":341,"_19069":33449,"_5":22689,"_15331":33429,"_1610":33450},[],"Actualizaciones automáticas a las últimas versiones",{"_8047":351,"_22539":341,"_19069":33452,"_5":22689,"_15331":33429,"_1610":33453},[],"Soporte técnico incluido",{"_8047":352,"_22539":341,"_19069":33455,"_5":22689,"_15331":33429,"_1610":33456},[],"SLA garantizado",{"_8047":353,"_22539":341,"_19069":33458,"_5":22689,"_15331":33433,"_1610":33459},[],"Plan",{"_8047":354,"_22539":341,"_19069":33461,"_5":22689,"_15331":33433,"_1610":33462},[],"Dispositivos",{"_8047":355,"_22539":341,"_19069":33464,"_5":22689,"_15331":33433,"_1610":33465},[],"Soporte",{"_8047":356,"_22539":341,"_19069":33467,"_5":22689,"_15331":33433,"_1610":33468},[],"SLA",{"_8047":357,"_22539":341,"_19069":33470,"_5":22689,"_15331":33433,"_1610":33471},[],"Starter",{"_8047":358,"_22539":341,"_19069":33473,"_5":22689,"_15331":33433,"_1610":33474},[],"Hasta 1.000",{"_8047":359,"_22539":341,"_19069":33476,"_5":22689,"_15331":33433,"_1610":33477},[],"Email",{"_8047":360,"_22539":341,"_19069":33479,"_5":22689,"_15331":33433,"_1610":33480},[],"99,5%",{"_8047":361,"_22539":341,"_19069":33482,"_5":22689,"_15331":33433,"_1610":33483},[],"Professional",{"_8047":362,"_22539":341,"_19069":33485,"_5":22689,"_15331":33433,"_1610":33486},[],"Hasta 10.000",{"_8047":363,"_22539":341,"_19069":33488,"_5":22689,"_15331":33433,"_1610":33489},[],"Email + Chat",{"_8047":364,"_22539":341,"_19069":33491,"_5":22689,"_15331":33433,"_1610":33492},[],"99,9%",{"_8047":365,"_22539":341,"_19069":33494,"_5":22689,"_15331":33433,"_1610":33495},[],"Enterprise",{"_8047":366,"_22539":341,"_19069":33497,"_5":22689,"_15331":33433,"_1610":33498},[],"Ilimitado",{"_8047":367,"_22539":341,"_19069":33500,"_5":22689,"_15331":33433,"_1610":33501},[],"Dedicado",{"_8047":368,"_22539":341,"_19069":33503,"_5":22689,"_15331":33433,"_1610":33504},[],"99,99%",{"_8047":369,"_22539":341,"_19069":33506,"_5":22689,"_15331":33437,"_1610":33507},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_8047":370,"_22539":370,"_5":22684,"_1610":33509,"_22697":33510,"_19069":33511,"_15331":370},"Manual de Usuario",[32410,33509],[],{"_8047":371,"_22539":370,"_19069":33513,"_5":22689,"_15331":370,"_1610":33514},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_8047":372,"_22539":370,"_5":22694,"_19069":33516,"_15331":33517,"_1610":33518},[],"/docs/pr-preview/pr-25/manual#servicios-core","Servicios Core",{"_8047":373,"_22539":370,"_5":22694,"_19069":33520,"_15331":33521,"_1610":33522},[],"/docs/pr-preview/pr-25/manual#integraciones-con-terceros","Integraciones con terceros",{"_8047":374,"_22539":370,"_19069":33524,"_5":22689,"_15331":370,"_1610":33525},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_8047":375,"_22539":370,"_19069":33527,"_5":22689,"_15331":33517,"_1610":33528},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_8047":376,"_22539":370,"_19069":33530,"_5":22689,"_15331":33517,"_1610":33531},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_8047":377,"_22539":370,"_19069":33533,"_5":22689,"_15331":33517,"_1610":33534},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_8047":378,"_22539":370,"_19069":33536,"_5":22689,"_15331":33517,"_1610":33537},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_8047":379,"_22539":370,"_19069":33539,"_5":22689,"_15331":33517,"_1610":33540},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_8047":380,"_22539":370,"_19069":33542,"_5":22689,"_15331":33517,"_1610":33543},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_8047":381,"_22539":370,"_19069":33545,"_5":22689,"_15331":33517,"_1610":33546},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_8047":382,"_22539":370,"_19069":33548,"_5":22689,"_15331":33521,"_1610":33549},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_8047":383,"_22539":383,"_5":22684,"_1610":33551,"_22697":33552,"_19069":33553,"_15331":383},"Integración con AWS IoT Core",[32410,33509,33522],[],{"_8047":384,"_22539":383,"_19069":33555,"_5":22689,"_15331":383,"_1610":33556},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_8047":385,"_22539":383,"_5":22694,"_19069":33558,"_15331":33559,"_1610":33560},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_8047":386,"_22539":383,"_5":22694,"_19069":33562,"_15331":33563,"_1610":33564},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_8047":387,"_22539":383,"_5":22694,"_19069":33566,"_15331":33567,"_1610":33568},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_8047":388,"_22539":383,"_5":22694,"_19069":33570,"_15331":33571,"_1610":33572},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_8047":389,"_22539":383,"_5":22694,"_19069":33574,"_15331":33575,"_1610":33576},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_8047":390,"_22539":383,"_5":22694,"_19069":33578,"_15331":33579,"_1610":33580},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_8047":391,"_22539":383,"_5":22694,"_19069":33582,"_15331":33583,"_1610":33584},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#primary-account","Primary Account",{"_8047":392,"_22539":383,"_5":22694,"_19069":33586,"_15331":33587,"_1610":33588},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_8047":393,"_22539":383,"_5":22694,"_19069":33590,"_15331":33591,"_1610":33592},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_8047":394,"_22539":383,"_5":22694,"_19069":33594,"_15331":33595,"_1610":33596},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-none","Modo `none`",{"_8047":395,"_22539":383,"_5":22694,"_19069":33598,"_15331":33599,"_1610":33600},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-auto","Modo `auto`",{"_8047":396,"_22539":383,"_5":22694,"_19069":33602,"_15331":33603,"_1610":33604},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_8047":397,"_22539":383,"_5":22694,"_19069":33606,"_15331":33607,"_1610":33608},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_8047":398,"_22539":383,"_5":22694,"_19069":33610,"_15331":33611,"_1610":33612},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_8047":399,"_22539":383,"_5":22694,"_19069":33614,"_15331":33615,"_1610":33616},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_8047":400,"_22539":383,"_5":22694,"_19069":33618,"_15331":33619,"_1610":33620},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_8047":401,"_22539":383,"_5":22694,"_19069":33622,"_15331":33623,"_1610":33624},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_8047":402,"_22539":383,"_5":22694,"_19069":33626,"_15331":33627,"_1610":33628},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_8047":403,"_22539":383,"_5":22694,"_19069":33630,"_15331":33631,"_1610":33632},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_8047":404,"_22539":383,"_5":22694,"_19069":33634,"_15331":33635,"_1610":33636},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_8047":405,"_22539":383,"_19069":33638,"_5":22689,"_15331":383,"_1610":33639},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_8047":406,"_22539":383,"_19069":33641,"_5":22689,"_15331":383,"_1610":33642},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_8047":407,"_22539":383,"_19069":33644,"_5":22689,"_15331":383,"_1610":33645},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_8047":408,"_22539":383,"_19069":33647,"_5":22689,"_15331":33559,"_1610":33648},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_8047":409,"_22539":383,"_19069":33650,"_5":22689,"_15331":33559,"_1610":33651},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_8047":410,"_22539":383,"_19069":33653,"_5":22689,"_15331":33559,"_1610":33654},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_8047":411,"_22539":383,"_19069":33656,"_5":22689,"_15331":33559,"_1610":33657},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_8047":412,"_22539":383,"_19069":33659,"_5":22689,"_15331":33563,"_1610":33660},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_8047":413,"_22539":383,"_19069":33662,"_5":22689,"_15331":33567,"_1610":33663},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_8047":414,"_22539":383,"_19069":33665,"_5":22689,"_15331":33567,"_1610":33666},[],"Acción IAM",{"_8047":415,"_22539":383,"_19069":33668,"_5":22689,"_15331":33567,"_1610":33669},[],"Propósito",{"_8047":416,"_22539":383,"_19069":33671,"_5":22689,"_15331":33567,"_1610":33672},[],"`iot:GetRegistrationCode`",{"_8047":417,"_22539":383,"_19069":33674,"_5":22689,"_15331":33567,"_1610":33675},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_8047":418,"_22539":383,"_19069":33677,"_5":22689,"_15331":33567,"_1610":33678},[],"`iot:RegisterCACertificate`",{"_8047":419,"_22539":383,"_19069":33680,"_5":22689,"_15331":33567,"_1610":33681},[],"Registrar la CA en AWS IoT",{"_8047":420,"_22539":383,"_19069":33683,"_5":22689,"_15331":33567,"_1610":33684},[],"`iot:DescribeCACertificate`",{"_8047":421,"_22539":383,"_19069":33686,"_5":22689,"_15331":33567,"_1610":33687},[],"Consultar el estado del registro de la CA",{"_8047":422,"_22539":383,"_19069":33689,"_5":22689,"_15331":33567,"_1610":33690},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_8047":423,"_22539":383,"_19069":33692,"_5":22689,"_15331":33567,"_1610":33693},[],"Crear o actualizar Things en IoT Core",{"_8047":424,"_22539":383,"_19069":33695,"_5":22689,"_15331":33567,"_1610":33696},[],"`iot:RegisterThing`",{"_8047":425,"_22539":383,"_19069":33698,"_5":22689,"_15331":33567,"_1610":33699},[],"Aprovisionar Things mediante plantilla",{"_8047":426,"_22539":383,"_19069":33701,"_5":22689,"_15331":33567,"_1610":33702},[],"`iot:RegisterCertificate`",{"_8047":427,"_22539":383,"_19069":33704,"_5":22689,"_15331":33567,"_1610":33705},[],"Registrar certificados de dispositivo",{"_8047":428,"_22539":383,"_19069":33707,"_5":22689,"_15331":33567,"_1610":33708},[],"`iot:UpdateCertificate`",{"_8047":429,"_22539":383,"_19069":33710,"_5":22689,"_15331":33567,"_1610":33711},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_8047":430,"_22539":383,"_19069":33713,"_5":22689,"_15331":33567,"_1610":33714},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_8047":431,"_22539":383,"_19069":33716,"_5":22689,"_15331":33567,"_1610":33717},[],"Crear y adjuntar políticas IoT",{"_8047":432,"_22539":383,"_19069":33719,"_5":22689,"_15331":33567,"_1610":33720},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_8047":433,"_22539":383,"_19069":33722,"_5":22689,"_15331":33567,"_1610":33723},[],"Gestionar grupos de Things",{"_8047":434,"_22539":383,"_19069":33725,"_5":22689,"_15331":33567,"_1610":33726},[],"`iot:CreateProvisioningTemplate`",{"_8047":435,"_22539":383,"_19069":33728,"_5":22689,"_15331":33567,"_1610":33729},[],"Crear plantillas JITP",{"_8047":436,"_22539":383,"_19069":33731,"_5":22689,"_15331":33567,"_1610":33732},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_8047":437,"_22539":383,"_19069":33734,"_5":22689,"_15331":33567,"_1610":33735},[],"Leer y escribir el Device Shadow",{"_8047":438,"_22539":383,"_19069":33737,"_5":22689,"_15331":33567,"_1610":33738},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_8047":439,"_22539":383,"_19069":33740,"_5":22689,"_15331":33571,"_1610":33741},[],"Parámetro",{"_8047":440,"_22539":383,"_19069":33743,"_5":22689,"_15331":33571,"_1610":33744},[],"Tipo",{"_8047":441,"_22539":383,"_19069":33746,"_5":22689,"_15331":33571,"_1610":33747},[],"Requerido",{"_8047":442,"_22539":383,"_19069":33749,"_5":22689,"_15331":33571,"_1610":32613},[],{"_8047":443,"_22539":383,"_19069":33751,"_5":22689,"_15331":33571,"_1610":33752},[],"`connector_id`",{"_8047":444,"_22539":383,"_19069":33754,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":445,"_22539":383,"_19069":33756,"_5":22689,"_15331":33571,"_1610":33757},[],"Sí",{"_8047":446,"_22539":383,"_19069":33759,"_5":22689,"_15331":33571,"_1610":33760},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_8047":447,"_22539":383,"_19069":33762,"_5":22689,"_15331":33571,"_1610":33763},[],"`aws_config.region`",{"_8047":448,"_22539":383,"_19069":33765,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":449,"_22539":383,"_19069":33767,"_5":22689,"_15331":33571,"_1610":33757},[],{"_8047":450,"_22539":383,"_19069":33769,"_5":22689,"_15331":33571,"_1610":33770},[],"Región AWS donde opera el conector.",{"_8047":451,"_22539":383,"_19069":33772,"_5":22689,"_15331":33571,"_1610":33773},[],"`aws_config.auth_method`",{"_8047":452,"_22539":383,"_19069":33775,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":453,"_22539":383,"_19069":33777,"_5":22689,"_15331":33571,"_1610":33757},[],{"_8047":454,"_22539":383,"_19069":33779,"_5":22689,"_15331":33571,"_1610":33780},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_8047":455,"_22539":383,"_19069":33782,"_5":22689,"_15331":33571,"_1610":33783},[],"`aws_config.access_key_id`",{"_8047":456,"_22539":383,"_19069":33785,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":457,"_22539":383,"_19069":33787,"_5":22689,"_15331":33571,"_1610":33788},[],"Solo con `auth_method=static`",{"_8047":458,"_22539":383,"_19069":33790,"_5":22689,"_15331":33571,"_1610":33791},[],"Clave de acceso AWS.",{"_8047":459,"_22539":383,"_19069":33793,"_5":22689,"_15331":33571,"_1610":33794},[],"`aws_config.secret_access_key`",{"_8047":460,"_22539":383,"_19069":33796,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":461,"_22539":383,"_19069":33798,"_5":22689,"_15331":33571,"_1610":33788},[],{"_8047":462,"_22539":383,"_19069":33800,"_5":22689,"_15331":33571,"_1610":33801},[],"Clave secreta AWS.",{"_8047":463,"_22539":383,"_19069":33803,"_5":22689,"_15331":33571,"_1610":33804},[],"`aws_config.session_token`",{"_8047":464,"_22539":383,"_19069":33806,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":465,"_22539":383,"_19069":33808,"_5":22689,"_15331":33571,"_1610":33809},[],"No",{"_8047":466,"_22539":383,"_19069":33811,"_5":22689,"_15331":33571,"_1610":33812},[],"Token de sesión (con `auth_method=static`).",{"_8047":467,"_22539":383,"_19069":33814,"_5":22689,"_15331":33571,"_1610":33815},[],"`aws_config.role_arn`",{"_8047":468,"_22539":383,"_19069":33817,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":469,"_22539":383,"_19069":33819,"_5":22689,"_15331":33571,"_1610":33820},[],"Solo con `auth_method=role`",{"_8047":470,"_22539":383,"_19069":33822,"_5":22689,"_15331":33571,"_1610":33823},[],"ARN del rol a asumir.",{"_8047":471,"_22539":383,"_19069":33825,"_5":22689,"_15331":33571,"_1610":33826},[],"`aws_config.endpoint_url`",{"_8047":472,"_22539":383,"_19069":33828,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":473,"_22539":383,"_19069":33830,"_5":22689,"_15331":33571,"_1610":33809},[],{"_8047":474,"_22539":383,"_19069":33832,"_5":22689,"_15331":33571,"_1610":33833},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_8047":475,"_22539":383,"_19069":33835,"_5":22689,"_15331":33571,"_1610":33836},[],"`subscriber_event_bus`",{"_8047":476,"_22539":383,"_19069":33838,"_5":22689,"_15331":33571,"_1610":19374},[],{"_8047":477,"_22539":383,"_19069":33840,"_5":22689,"_15331":33571,"_1610":33757},[],{"_8047":478,"_22539":383,"_19069":33842,"_5":22689,"_15331":33571,"_1610":33843},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_8047":479,"_22539":383,"_19069":33845,"_5":22689,"_15331":33571,"_1610":33846},[],"`dms_manager_client`",{"_8047":480,"_22539":383,"_19069":33848,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":481,"_22539":383,"_19069":33850,"_5":22689,"_15331":33571,"_1610":33757},[],{"_8047":482,"_22539":383,"_19069":33852,"_5":22689,"_15331":33571,"_1610":33853},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_8047":483,"_22539":383,"_19069":33855,"_5":22689,"_15331":33571,"_1610":33856},[],"`device_manager_client`",{"_8047":484,"_22539":383,"_19069":33858,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":485,"_22539":383,"_19069":33860,"_5":22689,"_15331":33571,"_1610":33757},[],{"_8047":486,"_22539":383,"_19069":33862,"_5":22689,"_15331":33571,"_1610":33863},[],"URL HTTP del Device Manager de Lamassu.",{"_8047":487,"_22539":383,"_19069":33865,"_5":22689,"_15331":33571,"_1610":33866},[],"`ca_client`",{"_8047":488,"_22539":383,"_19069":33868,"_5":22689,"_15331":33571,"_1610":11706},[],{"_8047":489,"_22539":383,"_19069":33870,"_5":22689,"_15331":33571,"_1610":33757},[],{"_8047":490,"_22539":383,"_19069":33872,"_5":22689,"_15331":33571,"_1610":33873},[],"URL HTTP del servicio de CA de Lamassu.",{"_8047":491,"_22539":383,"_19069":33875,"_5":22689,"_15331":33575,"_1610":33876},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_8047":492,"_22539":383,"_19069":33878,"_5":22689,"_15331":33579,"_1610":33879},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_8047":493,"_22539":383,"_19069":33881,"_5":22689,"_15331":33579,"_1610":33882},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_8047":494,"_22539":383,"_19069":33884,"_5":22689,"_15331":33583,"_1610":33885},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_8047":495,"_22539":383,"_19069":33887,"_5":22689,"_15331":33583,"_1610":33888},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_8047":496,"_22539":383,"_19069":33890,"_5":22689,"_15331":33583,"_1610":33891},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_8047":497,"_22539":383,"_19069":33893,"_5":22689,"_15331":33583,"_1610":33894},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_8047":498,"_22539":383,"_19069":33896,"_5":22689,"_15331":33583,"_1610":33897},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_8047":499,"_22539":383,"_19069":33899,"_5":22689,"_15331":33583,"_1610":33900},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_8047":500,"_22539":383,"_19069":33902,"_5":22689,"_15331":33587,"_1610":33903},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_8047":501,"_22539":383,"_19069":33905,"_5":22689,"_15331":33591,"_1610":33906},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_8047":502,"_22539":383,"_19069":33908,"_5":22689,"_15331":33591,"_1610":33909},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_8047":503,"_22539":383,"_19069":33911,"_5":22689,"_15331":33595,"_1610":33912},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_8047":504,"_22539":383,"_19069":33914,"_5":22689,"_15331":33599,"_1610":33915},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_8047":505,"_22539":383,"_19069":33917,"_5":22689,"_15331":33599,"_1610":33918},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_8047":506,"_22539":383,"_19069":33920,"_5":22689,"_15331":33599,"_1610":33921},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_8047":507,"_22539":383,"_19069":33923,"_5":22689,"_15331":33599,"_1610":33924},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_8047":508,"_22539":383,"_19069":33926,"_5":22689,"_15331":33599,"_1610":33927},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_8047":509,"_22539":383,"_19069":33929,"_5":22689,"_15331":33599,"_1610":33930},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_8047":510,"_22539":383,"_19069":33932,"_5":22689,"_15331":33603,"_1610":33933},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_8047":511,"_22539":383,"_19069":33935,"_5":22689,"_15331":33603,"_1610":33936},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_8047":512,"_22539":383,"_19069":33938,"_5":22689,"_15331":33603,"_1610":33939},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_8047":513,"_22539":383,"_19069":33941,"_5":22689,"_15331":33607,"_1610":33942},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_8047":514,"_22539":383,"_19069":33944,"_5":22689,"_15331":33607,"_1610":33945},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_8047":515,"_22539":383,"_19069":33947,"_5":22689,"_15331":33607,"_1610":33948},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_8047":516,"_22539":383,"_19069":33950,"_5":22689,"_15331":33611,"_1610":33951},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_8047":517,"_22539":383,"_19069":33953,"_5":22689,"_15331":33611,"_1610":33954},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_8047":518,"_22539":383,"_19069":33956,"_5":22689,"_15331":33611,"_1610":33957},[],"Para que el flujo JITP funcione correctamente:",{"_8047":519,"_22539":383,"_19069":33959,"_5":22689,"_15331":33611,"_1610":33960},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_8047":520,"_22539":383,"_19069":33962,"_5":22689,"_15331":33611,"_1610":33963},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_8047":521,"_22539":383,"_19069":33965,"_5":22689,"_15331":33611,"_1610":33966},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_8047":522,"_22539":383,"_19069":33968,"_5":22689,"_15331":33611,"_1610":33969},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_8047":523,"_22539":383,"_19069":33971,"_5":22689,"_15331":33615,"_1610":33972},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_8047":524,"_22539":383,"_19069":33974,"_5":22689,"_15331":33615,"_1610":33975},[],"Estado en Lamassu",{"_8047":525,"_22539":383,"_19069":33977,"_5":22689,"_15331":33615,"_1610":33978},[],"Razón de revocación",{"_8047":526,"_22539":383,"_19069":33980,"_5":22689,"_15331":33615,"_1610":33981},[],"Estado en AWS IoT Core",{"_8047":527,"_22539":383,"_19069":33983,"_5":22689,"_15331":33615,"_1610":33984},[],"`Active`",{"_8047":528,"_22539":383,"_19069":33986,"_5":22689,"_15331":33615,"_1610":33987},[],"—",{"_8047":529,"_22539":383,"_19069":33989,"_5":22689,"_15331":33615,"_1610":33990},[],"`ACTIVE`",{"_8047":530,"_22539":383,"_19069":33992,"_5":22689,"_15331":33615,"_1610":33993},[],"`Revoked`",{"_8047":531,"_22539":383,"_19069":33995,"_5":22689,"_15331":33615,"_1610":33996},[],"`certificateHold`",{"_8047":532,"_22539":383,"_19069":33998,"_5":22689,"_15331":33615,"_1610":33999},[],"`INACTIVE`",{"_8047":533,"_22539":383,"_19069":34001,"_5":22689,"_15331":33615,"_1610":33993},[],{"_8047":534,"_22539":383,"_19069":34003,"_5":22689,"_15331":33615,"_1610":34004},[],"Cualquier otra razón",{"_8047":535,"_22539":383,"_19069":34006,"_5":22689,"_15331":33615,"_1610":34007},[],"`REVOKED`",{"_8047":536,"_22539":383,"_19069":34009,"_5":22689,"_15331":33615,"_1610":34010},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_8047":537,"_22539":383,"_19069":34012,"_5":22689,"_15331":33619,"_1610":34013},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_8047":538,"_22539":383,"_19069":34015,"_5":22689,"_15331":33619,"_1610":34016},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_8047":539,"_22539":383,"_19069":34018,"_5":22689,"_15331":33619,"_1610":34019},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_8047":540,"_22539":383,"_19069":34021,"_5":22689,"_15331":33623,"_1610":34022},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_8047":541,"_22539":383,"_19069":34024,"_5":22689,"_15331":33623,"_1610":34025},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_8047":542,"_22539":383,"_19069":34027,"_5":22689,"_15331":33627,"_1610":34028},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_8047":543,"_22539":383,"_19069":34030,"_5":22689,"_15331":33627,"_1610":34031},[],"Existen dos tipos de acciones:",{"_8047":544,"_22539":383,"_19069":34033,"_5":22689,"_15331":33627,"_1610":34034},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_8047":545,"_22539":383,"_19069":34036,"_5":22689,"_15331":33627,"_1610":34037},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_8047":546,"_22539":383,"_19069":34039,"_5":22689,"_15331":33627,"_1610":34040},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_8047":547,"_22539":383,"_19069":34042,"_5":22689,"_15331":33631,"_1610":34043},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_8047":548,"_22539":383,"_19069":34045,"_5":22689,"_15331":33631,"_1610":34046},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_8047":549,"_22539":383,"_19069":34048,"_5":22689,"_15331":33631,"_1610":34049},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_8047":550,"_22539":383,"_19069":34051,"_5":22689,"_15331":33635,"_1610":34052},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_8047":551,"_22539":383,"_19069":34054,"_5":22689,"_15331":33635,"_1610":34055},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_8047":552,"_22539":383,"_19069":34057,"_5":22689,"_15331":33635,"_1610":34058},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_8047":553,"_22539":383,"_19069":34060,"_5":22689,"_15331":33635,"_1610":34061},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_8047":554,"_22539":383,"_19069":34063,"_5":22689,"_15331":33635,"_1610":34064},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_8047":555,"_22539":383,"_19069":34066,"_5":22689,"_15331":33635,"_1610":34067},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_8047":556,"_22539":383,"_19069":34069,"_5":22689,"_15331":33635,"_1610":34070},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_8047":557,"_22539":383,"_19069":34072,"_5":22689,"_15331":33635,"_1610":34073},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_8047":558,"_22539":383,"_19069":34075,"_5":22689,"_15331":33635,"_1610":34076},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_8047":559,"_22539":383,"_19069":34078,"_5":22689,"_15331":33635,"_1610":34079},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_8047":560,"_22539":383,"_19069":34081,"_5":22689,"_15331":33635,"_1610":34082},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_8047":561,"_22539":383,"_19069":34084,"_5":22689,"_15331":33635,"_1610":34085},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_8047":562,"_22539":383,"_19069":34087,"_5":22689,"_15331":33635,"_1610":34088},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_8047":563,"_22539":383,"_19069":34090,"_5":22689,"_15331":33635,"_1610":34091},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_8047":564,"_22539":383,"_19069":34093,"_5":22689,"_15331":33635,"_1610":34094},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_8047":565,"_22539":383,"_19069":34096,"_5":22689,"_15331":33635,"_1610":34097},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_8047":566,"_22539":383,"_19069":34099,"_5":22689,"_15331":33635,"_1610":34100},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_8047":567,"_22539":383,"_19069":34102,"_5":22689,"_15331":33635,"_1610":34103},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_8047":568,"_22539":383,"_19069":34105,"_5":22689,"_15331":33635,"_1610":34106},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_8047":569,"_22539":383,"_19069":34108,"_5":22689,"_15331":33635,"_1610":34109},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_8047":570,"_22539":383,"_19069":34111,"_5":22689,"_15331":33635,"_1610":34112},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_8047":571,"_22539":571,"_5":22684,"_1610":34114,"_22697":34115,"_19069":34116,"_15331":571},"[Alerts] Alertas y Suscripciones",[32410,33509,33518],[],{"_8047":572,"_22539":571,"_19069":34118,"_5":22689,"_15331":571,"_1610":34119},[],"Monitorización proactiva mediante eventos y suscripciones",{"_8047":573,"_22539":571,"_5":22694,"_19069":34121,"_15331":34122,"_1610":34123},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#alertas","Alertas",{"_8047":574,"_22539":571,"_5":22694,"_19069":34125,"_15331":34126,"_1610":34127},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_8047":575,"_22539":571,"_5":22694,"_19069":34129,"_15331":34130,"_1610":34131},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_8047":576,"_22539":571,"_5":22694,"_19069":34133,"_15331":34134,"_1610":34135},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_8047":577,"_22539":571,"_5":22694,"_19069":34137,"_15331":34138,"_1610":34139},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_8047":578,"_22539":571,"_5":22694,"_19069":34141,"_15331":34142,"_1610":34143},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_8047":579,"_22539":571,"_5":22694,"_19069":34145,"_15331":34146,"_1610":34147},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_8047":580,"_22539":571,"_19069":34149,"_5":22689,"_15331":34122,"_1610":34150},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_8047":581,"_22539":571,"_19069":34152,"_5":22689,"_15331":34126,"_1610":34153},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_8047":582,"_22539":571,"_19069":34155,"_5":22689,"_15331":34126,"_1610":34156},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_8047":583,"_22539":571,"_19069":34158,"_5":22689,"_15331":34126,"_1610":34159},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_8047":584,"_22539":571,"_19069":34161,"_5":22689,"_15331":34126,"_1610":34162},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_8047":585,"_22539":571,"_19069":34164,"_5":22689,"_15331":34126,"_1610":34165},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_8047":586,"_22539":571,"_19069":34167,"_5":22689,"_15331":34126,"_1610":34168},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_8047":587,"_22539":571,"_19069":34170,"_5":22689,"_15331":34130,"_1610":34171},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_8047":588,"_22539":571,"_19069":34173,"_5":22689,"_15331":34130,"_1610":34174},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_8047":589,"_22539":571,"_19069":34176,"_5":22689,"_15331":34130,"_1610":34177},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_8047":590,"_22539":571,"_19069":34179,"_5":22689,"_15331":34130,"_1610":34180},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_8047":591,"_22539":571,"_19069":34182,"_5":22689,"_15331":34130,"_1610":34183},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_8047":592,"_22539":571,"_19069":34185,"_5":22689,"_15331":34134,"_1610":34186},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_8047":593,"_22539":571,"_19069":34188,"_5":22689,"_15331":34134,"_1610":34189},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_8047":594,"_22539":571,"_19069":34191,"_5":22689,"_15331":34134,"_1610":34192},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_8047":595,"_22539":571,"_19069":34194,"_5":22689,"_15331":34134,"_1610":34195},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_8047":596,"_22539":571,"_19069":34197,"_5":22689,"_15331":34134,"_1610":34198},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_8047":597,"_22539":571,"_19069":34200,"_5":22689,"_15331":34138,"_1610":34201},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_8047":598,"_22539":571,"_19069":34203,"_5":22689,"_15331":34138,"_1610":34204},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_8047":599,"_22539":571,"_19069":34206,"_5":22689,"_15331":34142,"_1610":34207},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_8047":600,"_22539":571,"_19069":34209,"_5":22689,"_15331":34142,"_1610":34210},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_8047":601,"_22539":571,"_19069":34212,"_5":22689,"_15331":34142,"_1610":34213},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_8047":602,"_22539":571,"_19069":34215,"_5":22689,"_15331":34142,"_1610":34216},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_8047":603,"_22539":571,"_19069":34218,"_5":22689,"_15331":34146,"_1610":34219},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_8047":604,"_22539":571,"_19069":34221,"_5":22689,"_15331":34146,"_1610":34222},[],"Evento",{"_8047":605,"_22539":571,"_19069":34224,"_5":22689,"_15331":34146,"_1610":32613},[],{"_8047":606,"_22539":571,"_19069":34226,"_5":22689,"_15331":34146,"_1610":34227},[],"**ca.create**",{"_8047":607,"_22539":571,"_19069":34229,"_5":22689,"_15331":34146,"_1610":34230},[],"Creación de una CA",{"_8047":608,"_22539":571,"_19069":34232,"_5":22689,"_15331":34146,"_1610":34233},[],"**ca.import**",{"_8047":609,"_22539":571,"_19069":34235,"_5":22689,"_15331":34146,"_1610":34236},[],"Importación de una CA",{"_8047":610,"_22539":571,"_19069":34238,"_5":22689,"_15331":34146,"_1610":34239},[],"**ca.profile.update**",{"_8047":611,"_22539":571,"_19069":34241,"_5":22689,"_15331":34146,"_1610":34242},[],"Actualización de perfil de CA",{"_8047":612,"_22539":571,"_19069":34244,"_5":22689,"_15331":34146,"_1610":34245},[],"**ca.reissue**",{"_8047":613,"_22539":571,"_19069":34247,"_5":22689,"_15331":34146,"_1610":34248},[],"Reemisión de una CA",{"_8047":614,"_22539":571,"_19069":34250,"_5":22689,"_15331":34146,"_1610":34251},[],"**ca.sign.certificate**",{"_8047":615,"_22539":571,"_19069":34253,"_5":22689,"_15331":34146,"_1610":34254},[],"Firma / emisión de certificado",{"_8047":616,"_22539":571,"_19069":34256,"_5":22689,"_15331":34146,"_1610":34257},[],"**ca.signature.sign**",{"_8047":617,"_22539":571,"_19069":34259,"_5":22689,"_15331":34146,"_1610":34260},[],"Operación de firma criptográfica",{"_8047":618,"_22539":571,"_19069":34262,"_5":22689,"_15331":34146,"_1610":34263},[],"**ca.delete**",{"_8047":619,"_22539":571,"_19069":34265,"_5":22689,"_15331":34146,"_1610":34266},[],"Eliminación de una CA",{"_8047":620,"_22539":571,"_19069":34268,"_5":22689,"_15331":34146,"_1610":34269},[],"**certificate.delete**",{"_8047":621,"_22539":571,"_19069":34271,"_5":22689,"_15331":34146,"_1610":34272},[],"Eliminación de un certificado",{"_8047":622,"_22539":571,"_19069":34274,"_5":22689,"_15331":34146,"_1610":34275},[],"**profile.create**",{"_8047":623,"_22539":571,"_19069":34277,"_5":22689,"_15331":34146,"_1610":34278},[],"Creación de perfil de emisión",{"_8047":624,"_22539":571,"_19069":34280,"_5":22689,"_15331":34146,"_1610":34281},[],"**profile.update**",{"_8047":625,"_22539":571,"_19069":34283,"_5":22689,"_15331":34146,"_1610":34284},[],"Actualización de perfil de emisión",{"_8047":626,"_22539":571,"_19069":34286,"_5":22689,"_15331":34146,"_1610":34287},[],"**profile.delete**",{"_8047":627,"_22539":571,"_19069":34289,"_5":22689,"_15331":34146,"_1610":34290},[],"Eliminación de perfil de emisión",{"_8047":628,"_22539":571,"_19069":34292,"_5":22689,"_15331":34146,"_1610":34293},[],"**dms.create**",{"_8047":629,"_22539":571,"_19069":34295,"_5":22689,"_15331":34146,"_1610":34296},[],"Creación de un DMS",{"_8047":630,"_22539":571,"_19069":34298,"_5":22689,"_15331":34146,"_1610":34299},[],"**dms.update**",{"_8047":631,"_22539":571,"_19069":34301,"_5":22689,"_15331":34146,"_1610":34302},[],"Actualización de un DMS",{"_8047":632,"_22539":571,"_19069":34304,"_5":22689,"_15331":34146,"_1610":34305},[],"**dms.delete**",{"_8047":633,"_22539":571,"_19069":34307,"_5":22689,"_15331":34146,"_1610":34308},[],"Eliminación de un DMS",{"_8047":634,"_22539":571,"_19069":34310,"_5":22689,"_15331":34146,"_1610":34311},[],"**dms.enroll**",{"_8047":635,"_22539":571,"_19069":34313,"_5":22689,"_15331":34146,"_1610":34314},[],"Inscripción (enroll) de dispositivo",{"_8047":636,"_22539":571,"_19069":34316,"_5":22689,"_15331":34146,"_1610":34317},[],"**dms.reenroll**",{"_8047":637,"_22539":571,"_19069":34319,"_5":22689,"_15331":34146,"_1610":34320},[],"Re-inscripción (reenroll) de dispositivo",{"_8047":638,"_22539":571,"_19069":34322,"_5":22689,"_15331":34146,"_1610":34323},[],"**dms.bind-device-id**",{"_8047":639,"_22539":571,"_19069":34325,"_5":22689,"_15331":34146,"_1610":34326},[],"Asociación de identidad a dispositivo",{"_8047":640,"_22539":571,"_19069":34328,"_5":22689,"_15331":34146,"_1610":34329},[],"**device.create**",{"_8047":641,"_22539":571,"_19069":34331,"_5":22689,"_15331":34146,"_1610":34332},[],"Creación de dispositivo",{"_8047":642,"_22539":571,"_19069":34334,"_5":22689,"_15331":34146,"_1610":34335},[],"**device.identity.update**",{"_8047":643,"_22539":571,"_19069":34337,"_5":22689,"_15331":34146,"_1610":34338},[],"Actualización de identidad del dispositivo",{"_8047":644,"_22539":571,"_19069":34340,"_5":22689,"_15331":34146,"_1610":34341},[],"**device.status.update**",{"_8047":645,"_22539":571,"_19069":34343,"_5":22689,"_15331":34146,"_1610":34344},[],"Cambio de estado del dispositivo",{"_8047":646,"_22539":571,"_19069":34346,"_5":22689,"_15331":34146,"_1610":34347},[],"**device.metadata.update**",{"_8047":647,"_22539":571,"_19069":34349,"_5":22689,"_15331":34146,"_1610":34350},[],"Actualización de metadatos del dispositivo",{"_8047":648,"_22539":571,"_19069":34352,"_5":22689,"_15331":34146,"_1610":34353},[],"**device.delete**",{"_8047":649,"_22539":571,"_19069":34355,"_5":22689,"_15331":34146,"_1610":34356},[],"Eliminación de un dispositivo",{"_8047":650,"_22539":571,"_19069":34358,"_5":22689,"_15331":34146,"_1610":34359},[],"**va.role.crl.create**",{"_8047":651,"_22539":571,"_19069":34361,"_5":22689,"_15331":34146,"_1610":34362},[],"Cálculo/creación de CRL",{"_8047":652,"_22539":571,"_19069":34364,"_5":22689,"_15331":34146,"_1610":34365},[],"**kms.create**",{"_8047":653,"_22539":571,"_19069":34367,"_5":22689,"_15331":34146,"_1610":34368},[],"Creación de clave en KMS",{"_8047":654,"_22539":571,"_19069":34370,"_5":22689,"_15331":34146,"_1610":34371},[],"**kms.import**",{"_8047":655,"_22539":571,"_19069":34373,"_5":22689,"_15331":34146,"_1610":34374},[],"Importación de una clave KMS",{"_8047":656,"_22539":571,"_19069":34376,"_5":22689,"_15331":34146,"_1610":34377},[],"**kms.update.metadata**",{"_8047":657,"_22539":571,"_19069":34379,"_5":22689,"_15331":34146,"_1610":34380},[],"Actualización de metadatos de clave KMS",{"_8047":658,"_22539":571,"_19069":34382,"_5":22689,"_15331":34146,"_1610":34383},[],"**kms.update.aliases**",{"_8047":659,"_22539":571,"_19069":34385,"_5":22689,"_15331":34146,"_1610":34386},[],"Actualización de alias de clave KMS",{"_8047":660,"_22539":571,"_19069":34388,"_5":22689,"_15331":34146,"_1610":34389},[],"**kms.update.name**",{"_8047":661,"_22539":571,"_19069":34391,"_5":22689,"_15331":34146,"_1610":34392},[],"Cambio de nombre de una clave KMS",{"_8047":662,"_22539":571,"_19069":34394,"_5":22689,"_15331":34146,"_1610":34395},[],"**kms.update.tags**",{"_8047":663,"_22539":571,"_19069":34397,"_5":22689,"_15331":34146,"_1610":34398},[],"Actualización de etiquetas (tags) de clave KMS",{"_8047":664,"_22539":571,"_19069":34400,"_5":22689,"_15331":34146,"_1610":34401},[],"**kms.delete**",{"_8047":665,"_22539":571,"_19069":34403,"_5":22689,"_15331":34146,"_1610":34404},[],"Eliminación de una clave KMS",{"_8047":666,"_22539":571,"_19069":34406,"_5":22689,"_15331":34146,"_1610":34407},[],"**kms.sign.message**",{"_8047":667,"_22539":571,"_19069":34409,"_5":22689,"_15331":34146,"_1610":34410},[],"Firma de un mensaje con clave KMS",{"_8047":668,"_22539":571,"_19069":34412,"_5":22689,"_15331":34146,"_1610":34413},[],"**kms.verify.signature**",{"_8047":669,"_22539":571,"_19069":34415,"_5":22689,"_15331":34146,"_1610":34416},[],"Verificación de firma con clave KMS",{"_8047":670,"_22539":670,"_5":22684,"_1610":34418,"_22697":34419,"_19069":34420,"_15331":670},"[CA] Gestión de Entidades de Confianza",[32410,33509,33518],[],{"_8047":671,"_22539":670,"_19069":34422,"_5":22689,"_15331":670,"_1610":34423},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_8047":672,"_22539":670,"_5":22694,"_19069":34425,"_15331":34426,"_1610":34427},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_8047":673,"_22539":670,"_5":22694,"_19069":34429,"_15331":34430,"_1610":34431},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_8047":674,"_22539":670,"_5":22694,"_19069":34433,"_15331":34434,"_1610":34435},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_8047":675,"_22539":670,"_5":22694,"_19069":34437,"_15331":34438,"_1610":34439},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_8047":676,"_22539":670,"_5":22694,"_19069":34441,"_15331":34442,"_1610":34443},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_8047":677,"_22539":670,"_5":22694,"_19069":34445,"_15331":34446,"_1610":34447},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_8047":678,"_22539":670,"_5":22694,"_19069":34449,"_15331":34450,"_1610":34451},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_8047":679,"_22539":670,"_5":22694,"_19069":34453,"_15331":34454,"_1610":34455},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_8047":680,"_22539":670,"_5":22694,"_19069":34457,"_15331":34458,"_1610":34459},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_8047":681,"_22539":670,"_19069":34461,"_5":22689,"_15331":34430,"_1610":34462},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_8047":682,"_22539":670,"_19069":34464,"_5":22689,"_15331":34430,"_1610":34465},[],"Actualmente hay disponibles 3 acciones:",{"_8047":683,"_22539":670,"_19069":34467,"_5":22689,"_15331":34430,"_1610":34468},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_8047":684,"_22539":670,"_19069":34470,"_5":22689,"_15331":34430,"_1610":34471},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_8047":685,"_22539":670,"_19069":34473,"_5":22689,"_15331":34430,"_1610":34474},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_8047":686,"_22539":670,"_19069":34476,"_5":22689,"_15331":34434,"_1610":34477},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_8047":687,"_22539":670,"_19069":34479,"_5":22689,"_15331":34434,"_1610":34480},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_8047":688,"_22539":670,"_19069":34482,"_5":22689,"_15331":34434,"_1610":34483},[],"**Motor criptográfico**",{"_8047":689,"_22539":670,"_19069":34485,"_5":22689,"_15331":34434,"_1610":34486},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_8047":690,"_22539":670,"_19069":34488,"_5":22689,"_15331":34434,"_1610":34489},[],"**Ejemplo mostrado:** go1.24.3",{"_8047":691,"_22539":670,"_19069":34491,"_5":22689,"_15331":34434,"_1610":34492},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_8047":692,"_22539":670,"_19069":34494,"_5":22689,"_15331":34434,"_1610":34495},[],"**Parámetros de clave**",{"_8047":693,"_22539":670,"_19069":34497,"_5":22689,"_15331":34434,"_1610":34498},[],"**Key Type:** RSA / EC (Elliptic Curve)",{"_8047":694,"_22539":670,"_19069":34500,"_5":22689,"_15331":34434,"_1610":34501},[],"**Key Size:**",{"_8047":695,"_22539":670,"_19069":34503,"_5":22689,"_15331":34434,"_1610":34504},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_8047":696,"_22539":670,"_19069":34506,"_5":22689,"_15331":34434,"_1610":34507},[],"EC: P-256, P-384, P-521",{"_8047":697,"_22539":670,"_19069":34509,"_5":22689,"_15331":34434,"_1610":34510},[],"**Recomendado:** EC P-384",{"_8047":698,"_22539":670,"_19069":34512,"_5":22689,"_15331":34434,"_1610":34513},[],"El formulario de la consola ofrece los tipos clásicos RSA y EC. A través de la API se pueden crear CAs con cualquiera de los tipos de clave soportados por el motor seleccionado, incluidos Ed25519 y los algoritmos post-cuánticos (ML-DSA, SLH-DSA y Composite ML-DSA). Consulte la sección de algoritmos de la página de gestión de claves del KMS para conocer el catálogo completo y las restricciones por motor.",{"_8047":699,"_22539":670,"_19069":34515,"_5":22689,"_15331":34434,"_1610":34516},[],"**Perfil de emisión del certificado de la CA**",{"_8047":700,"_22539":670,"_19069":34518,"_5":22689,"_15331":34434,"_1610":34519},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_8047":701,"_22539":670,"_19069":34521,"_5":22689,"_15331":34434,"_1610":34522},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_8047":702,"_22539":670,"_19069":34524,"_5":22689,"_15331":34434,"_1610":34525},[],"**Configuración de la CA**",{"_8047":703,"_22539":670,"_19069":34527,"_5":22689,"_15331":34434,"_1610":34528},[],"**Tipo de CA**",{"_8047":704,"_22539":670,"_19069":34530,"_5":22689,"_15331":34434,"_1610":34531},[],"**Root CA:** Autoridad raíz autofirmada",{"_8047":705,"_22539":670,"_19069":34533,"_5":22689,"_15331":34434,"_1610":34534},[],"**Intermediate CA:** Autoridad subordinada",{"_8047":706,"_22539":670,"_19069":34536,"_5":22689,"_15331":34434,"_1610":34537},[],"**Emisor**",{"_8047":707,"_22539":670,"_19069":34539,"_5":22689,"_15331":34434,"_1610":34540},[],"**Root CA:** Self-signed (auto-firmada)",{"_8047":708,"_22539":670,"_19069":34542,"_5":22689,"_15331":34434,"_1610":34543},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_8047":709,"_22539":670,"_19069":34545,"_5":22689,"_15331":34434,"_1610":34546},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_8047":710,"_22539":670,"_19069":34548,"_5":22689,"_15331":34434,"_1610":34549},[],"La CA superior seleccionada no está limitada a un algoritmo concreto: Lamassu permite combinar jerarquías con algoritmos distintos, por ejemplo una CA intermedia post-cuántica bajo una raíz clásica o al contrario. Tenga en cuenta que la interoperabilidad de la jerarquía resultante dependerá de que los clientes que validen los certificados soporten los algoritmos utilizados en cada nivel.",{"_8047":711,"_22539":670,"_19069":34551,"_5":22689,"_15331":34434,"_1610":34552},[],"**Identificación**",{"_8047":712,"_22539":670,"_19069":34554,"_5":22689,"_15331":34434,"_1610":34555},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_8047":713,"_22539":670,"_19069":34557,"_5":22689,"_15331":34434,"_1610":34558},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_8047":714,"_22539":670,"_19069":34560,"_5":22689,"_15331":34434,"_1610":34561},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_8047":715,"_22539":670,"_19069":34563,"_5":22689,"_15331":34434,"_1610":34564},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_8047":716,"_22539":670,"_19069":34566,"_5":22689,"_15331":34434,"_1610":34567},[],"**Subject Distinguished Name (DN)**",{"_8047":717,"_22539":670,"_19069":34569,"_5":22689,"_15331":34434,"_1610":34570},[],"Campos opcionales:",{"_8047":718,"_22539":670,"_19069":34572,"_5":22689,"_15331":34434,"_1610":34573},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_8047":719,"_22539":670,"_19069":34575,"_5":22689,"_15331":34434,"_1610":34576},[],"Ejemplo: US, ES, DE",{"_8047":720,"_22539":670,"_19069":34578,"_5":22689,"_15331":34434,"_1610":34579},[],"**State/Province (ST):** Estado o provincia",{"_8047":721,"_22539":670,"_19069":34581,"_5":22689,"_15331":34434,"_1610":34582},[],"Ejemplo: California, Madrid",{"_8047":722,"_22539":670,"_19069":34584,"_5":22689,"_15331":34434,"_1610":34585},[],"**Locality (L):** Ciudad o localidad",{"_8047":723,"_22539":670,"_19069":34587,"_5":22689,"_15331":34434,"_1610":34588},[],"Ejemplo: San Francisco, Arrasate",{"_8047":724,"_22539":670,"_19069":34590,"_5":22689,"_15331":34434,"_1610":34591},[],"**Organization (O):** Nombre de la organización",{"_8047":725,"_22539":670,"_19069":34593,"_5":22689,"_15331":34434,"_1610":34594},[],"Ejemplo: Lamassu IoT Corp",{"_8047":726,"_22539":670,"_19069":34596,"_5":22689,"_15331":34434,"_1610":34597},[],"**Organizational Unit (OU):** Unidad organizacional",{"_8047":727,"_22539":670,"_19069":34599,"_5":22689,"_15331":34434,"_1610":34600},[],"Ejemplo: Secure Devices Division",{"_8047":728,"_22539":670,"_19069":34602,"_5":22689,"_15331":34434,"_1610":34603},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_8047":729,"_22539":670,"_19069":34605,"_5":22689,"_15331":34434,"_1610":34606},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_8047":730,"_22539":670,"_19069":34608,"_5":22689,"_15331":34434,"_1610":34609},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_8047":731,"_22539":670,"_19069":34611,"_5":22689,"_15331":34434,"_1610":34612},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_8047":732,"_22539":670,"_19069":34614,"_5":22689,"_15331":34434,"_1610":34615},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_8047":733,"_22539":670,"_19069":34617,"_5":22689,"_15331":34434,"_1610":34618},[],"**Duración:** Configurable según necesidades organizacionales",{"_8047":734,"_22539":670,"_19069":34620,"_5":22689,"_15331":34434,"_1610":34621},[],"**Valor por defecto:** 10 años (10y)",{"_8047":735,"_22539":670,"_19069":34623,"_5":22689,"_15331":34434,"_1610":34624},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_8047":736,"_22539":670,"_19069":34626,"_5":22689,"_15331":34434,"_1610":34627},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_8047":737,"_22539":670,"_19069":34629,"_5":22689,"_15331":34434,"_1610":34630},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_8047":738,"_22539":670,"_19069":34632,"_5":22689,"_15331":34434,"_1610":34633},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_8047":739,"_22539":670,"_19069":34635,"_5":22689,"_15331":34434,"_1610":34636},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_8047":740,"_22539":670,"_19069":34638,"_5":22689,"_15331":34434,"_1610":34639},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_8047":741,"_22539":670,"_19069":34641,"_5":22689,"_15331":34434,"_1610":34642},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_8047":742,"_22539":670,"_19069":34644,"_5":22689,"_15331":34434,"_1610":34645},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_8047":743,"_22539":670,"_19069":34647,"_5":22689,"_15331":34434,"_1610":34648},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_8047":744,"_22539":670,"_19069":34650,"_5":22689,"_15331":34434,"_1610":34651},[],"**Valor por defecto:** 1 año (1y)",{"_8047":745,"_22539":670,"_19069":34653,"_5":22689,"_15331":34434,"_1610":34654},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_8047":746,"_22539":670,"_19069":34656,"_5":22689,"_15331":34434,"_1610":34657},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_8047":747,"_22539":670,"_19069":34659,"_5":22689,"_15331":34438,"_1610":34660},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_8047":748,"_22539":670,"_19069":34662,"_5":22689,"_15331":34438,"_1610":34663},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_8047":749,"_22539":670,"_19069":34665,"_5":22689,"_15331":34438,"_1610":34666},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_8047":750,"_22539":670,"_19069":34668,"_5":22689,"_15331":34442,"_1610":34669},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_8047":751,"_22539":670,"_19069":34671,"_5":22689,"_15331":34442,"_1610":34672},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_8047":752,"_22539":670,"_19069":34674,"_5":22689,"_15331":34442,"_1610":34486},[],{"_8047":753,"_22539":670,"_19069":34676,"_5":22689,"_15331":34442,"_1610":34489},[],{"_8047":754,"_22539":670,"_19069":34678,"_5":22689,"_15331":34442,"_1610":34492},[],{"_8047":755,"_22539":670,"_19069":34680,"_5":22689,"_15331":34442,"_1610":34681},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_8047":756,"_22539":670,"_19069":34683,"_5":22689,"_15331":34442,"_1610":34642},[],{"_8047":757,"_22539":670,"_19069":34685,"_5":22689,"_15331":34442,"_1610":34645},[],{"_8047":758,"_22539":670,"_19069":34687,"_5":22689,"_15331":34442,"_1610":34648},[],{"_8047":759,"_22539":670,"_19069":34689,"_5":22689,"_15331":34442,"_1610":34651},[],{"_8047":760,"_22539":670,"_19069":34691,"_5":22689,"_15331":34442,"_1610":34654},[],{"_8047":761,"_22539":670,"_19069":34693,"_5":22689,"_15331":34442,"_1610":34694},[],"Se debe proporcionar de manera obligatoria:",{"_8047":762,"_22539":670,"_19069":34696,"_5":22689,"_15331":34442,"_1610":34697},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_8047":763,"_22539":670,"_19069":34699,"_5":22689,"_15331":34442,"_1610":34700},[],"Clave privada de la CA en formato PEM",{"_8047":764,"_22539":670,"_19069":34702,"_5":22689,"_15331":34442,"_1610":34703},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_8047":765,"_22539":670,"_19069":34705,"_5":22689,"_15331":34450,"_1610":34706},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_8047":766,"_22539":670,"_19069":34708,"_5":22689,"_15331":34450,"_1610":34709},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_8047":767,"_22539":670,"_19069":34711,"_5":22689,"_15331":34450,"_1610":34712},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_8047":768,"_22539":670,"_19069":34714,"_5":22689,"_15331":34450,"_1610":34715},[],"Se ofrecen dos acciones:",{"_8047":769,"_22539":670,"_19069":34717,"_5":22689,"_15331":34450,"_1610":34718},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_8047":770,"_22539":670,"_19069":34720,"_5":22689,"_15331":34450,"_1610":34721},[],"la acción de revocación de la CA",{"_8047":771,"_22539":670,"_19069":34723,"_5":22689,"_15331":34450,"_1610":34724},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_8047":772,"_22539":670,"_19069":34726,"_5":22689,"_15331":34454,"_1610":34727},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_8047":773,"_22539":670,"_19069":34729,"_5":22689,"_15331":34454,"_1610":34730},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_8047":774,"_22539":670,"_19069":34732,"_5":22689,"_15331":34454,"_1610":34733},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_8047":775,"_22539":670,"_19069":34735,"_5":22689,"_15331":34454,"_1610":34736},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_8047":776,"_22539":670,"_19069":34738,"_5":22689,"_15331":34454,"_1610":34739},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_8047":777,"_22539":670,"_19069":34741,"_5":22689,"_15331":34454,"_1610":34742},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_8047":778,"_22539":670,"_19069":34744,"_5":22689,"_15331":34454,"_1610":34745},[],"Emisión a partir de un CSR generado de manera externa",{"_8047":779,"_22539":670,"_19069":34747,"_5":22689,"_15331":34454,"_1610":34748},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_8047":780,"_22539":670,"_19069":34750,"_5":22689,"_15331":34454,"_1610":34751},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_8047":781,"_22539":670,"_19069":34753,"_5":22689,"_15331":34454,"_1610":34754},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_8047":782,"_22539":670,"_19069":34756,"_5":22689,"_15331":34454,"_1610":34757},[],"**Certificate Subject (Sujeto del certificado)**",{"_8047":783,"_22539":670,"_19069":34759,"_5":22689,"_15331":34454,"_1610":34760},[],"**Common Name (CN)**",{"_8047":784,"_22539":670,"_19069":34762,"_5":22689,"_15331":34454,"_1610":34763},[],"**Campo:** Obligatorio",{"_8047":785,"_22539":670,"_19069":34765,"_5":22689,"_15331":34454,"_1610":34766},[],"**Función:** Identifica de forma única al titular del certificado",{"_8047":786,"_22539":670,"_19069":34768,"_5":22689,"_15331":34454,"_1610":34769},[],"**Ejemplos:**",{"_8047":787,"_22539":670,"_19069":34771,"_5":22689,"_15331":34454,"_1610":34772},[],"Para dispositivos: device001.company.com",{"_8047":788,"_22539":670,"_19069":34774,"_5":22689,"_15331":34454,"_1610":34775},[],"Para usuarios: john.doe\\@company.com",{"_8047":789,"_22539":670,"_19069":34777,"_5":22689,"_15331":34454,"_1610":34778},[],"Para servicios: api.service.company.com",{"_8047":790,"_22539":670,"_19069":34780,"_5":22689,"_15331":34454,"_1610":34781},[],"**Campos Organizacionales**",{"_8047":791,"_22539":670,"_19069":34783,"_5":22689,"_15331":34454,"_1610":34784},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_8047":792,"_22539":670,"_19069":34786,"_5":22689,"_15331":34454,"_1610":34787},[],"Ejemplo: IT Department, Manufacturing",{"_8047":793,"_22539":670,"_19069":34789,"_5":22689,"_15331":34454,"_1610":34591},[],{"_8047":794,"_22539":670,"_19069":34791,"_5":22689,"_15331":34454,"_1610":34792},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_8047":795,"_22539":670,"_19069":34794,"_5":22689,"_15331":34454,"_1610":34795},[],"**Información Geográfica**",{"_8047":796,"_22539":670,"_19069":34797,"_5":22689,"_15331":34454,"_1610":34798},[],"**Locality (L):** Ciudad o localidad del titular",{"_8047":797,"_22539":670,"_19069":34800,"_5":22689,"_15331":34454,"_1610":34579},[],{"_8047":798,"_22539":670,"_19069":34802,"_5":22689,"_15331":34454,"_1610":34803},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_8047":799,"_22539":670,"_19069":34805,"_5":22689,"_15331":34454,"_1610":34806},[],"Valor por defecto mostrado: US",{"_8047":800,"_22539":670,"_19069":34808,"_5":22689,"_15331":34454,"_1610":34809},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_8047":801,"_22539":670,"_19069":34811,"_5":22689,"_15331":34454,"_1610":34812},[],"**Tipos de SAN Disponibles**",{"_8047":802,"_22539":670,"_19069":34814,"_5":22689,"_15331":34454,"_1610":34815},[],"**DNS:** Nombres de dominio",{"_8047":803,"_22539":670,"_19069":34817,"_5":22689,"_15331":34454,"_1610":34818},[],"Ejemplo: example.com, \\*.example.com",{"_8047":804,"_22539":670,"_19069":34820,"_5":22689,"_15331":34454,"_1610":34821},[],"**IP Address:** Direcciones IP",{"_8047":805,"_22539":670,"_19069":34823,"_5":22689,"_15331":34454,"_1610":34824},[],"**Email:** Direcciones de correo electrónico",{"_8047":806,"_22539":670,"_19069":34826,"_5":22689,"_15331":34454,"_1610":34827},[],"**URI:** Identificadores de recursos uniformes",{"_8047":807,"_22539":670,"_19069":34829,"_5":22689,"_15331":34454,"_1610":34830},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_8047":808,"_22539":670,"_19069":34832,"_5":22689,"_15331":34454,"_1610":34833},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado.",{"_8047":809,"_22539":670,"_19069":34835,"_5":22689,"_15331":34454,"_1610":34836},[],"**Algorithm (Algoritmo)**",{"_8047":810,"_22539":670,"_19069":34838,"_5":22689,"_15331":34454,"_1610":34839},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_8047":811,"_22539":670,"_19069":34841,"_5":22689,"_15331":34454,"_1610":34842},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_8047":812,"_22539":670,"_19069":34844,"_5":22689,"_15331":34454,"_1610":34845},[],"**Certificate Configuration (Configuración del certificado)**",{"_8047":813,"_22539":670,"_19069":34847,"_5":22689,"_15331":34454,"_1610":34848},[],"**Validity Duration (Duración de validez)**",{"_8047":814,"_22539":670,"_19069":34850,"_5":22689,"_15331":34454,"_1610":34851},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_8047":815,"_22539":670,"_19069":34853,"_5":22689,"_15331":34454,"_1610":34854},[],"**Campo:** Configurable según necesidades",{"_8047":816,"_22539":670,"_19069":34856,"_5":22689,"_15331":34454,"_1610":34651},[],{"_8047":817,"_22539":670,"_19069":34858,"_5":22689,"_15331":34454,"_1610":34859},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_8047":818,"_22539":670,"_19069":34861,"_5":22689,"_15331":34454,"_1610":34862},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_8047":819,"_22539":670,"_19069":34864,"_5":22689,"_15331":34454,"_1610":34865},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_8047":820,"_22539":670,"_19069":34867,"_5":22689,"_15331":34454,"_1610":34868},[],"**Usos Básicos**",{"_8047":821,"_22539":670,"_19069":34870,"_5":22689,"_15331":34454,"_1610":34871},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_8047":822,"_22539":670,"_19069":34873,"_5":22689,"_15331":34454,"_1610":34874},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_8047":823,"_22539":670,"_19069":34876,"_5":22689,"_15331":34454,"_1610":34877},[],"**Key Encipherment:** Cifrado de claves",{"_8047":824,"_22539":670,"_19069":34879,"_5":22689,"_15331":34454,"_1610":34880},[],"**Data Encipherment:** Cifrado de datos",{"_8047":825,"_22539":670,"_19069":34882,"_5":22689,"_15331":34454,"_1610":34883},[],"**Key Agreement:** Acuerdo de claves",{"_8047":826,"_22539":670,"_19069":34885,"_5":22689,"_15331":34454,"_1610":34886},[],"**Certificate Signing:** Firma de certificados",{"_8047":827,"_22539":670,"_19069":34888,"_5":22689,"_15331":34454,"_1610":34889},[],"**CRL Signing:** Firma de listas de revocación",{"_8047":828,"_22539":670,"_19069":34891,"_5":22689,"_15331":34454,"_1610":34892},[],"**Encipher Only:** Solo cifrado",{"_8047":829,"_22539":670,"_19069":34894,"_5":22689,"_15331":34454,"_1610":34895},[],"**Decipher Only:** Solo descifrado",{"_8047":830,"_22539":670,"_19069":34897,"_5":22689,"_15331":34454,"_1610":34898},[],"**Uso Extendido de Claves**",{"_8047":831,"_22539":670,"_19069":34900,"_5":22689,"_15331":34454,"_1610":34901},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_8047":832,"_22539":670,"_19069":34903,"_5":22689,"_15331":34454,"_1610":34904},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_8047":833,"_22539":670,"_19069":34906,"_5":22689,"_15331":34454,"_1610":34907},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_8047":834,"_22539":670,"_19069":34909,"_5":22689,"_15331":34454,"_1610":34910},[],"**Code Signing:** Firma de código",{"_8047":835,"_22539":670,"_19069":34912,"_5":22689,"_15331":34454,"_1610":34913},[],"**Email Protection:** Protección de correo electrónico",{"_8047":836,"_22539":670,"_19069":34915,"_5":22689,"_15331":34454,"_1610":34916},[],"**Time Stamping:** Sellado de tiempo",{"_8047":837,"_22539":670,"_19069":34918,"_5":22689,"_15331":34454,"_1610":34919},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_8047":838,"_22539":670,"_19069":34921,"_5":22689,"_15331":34454,"_1610":34922},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_8047":839,"_22539":670,"_19069":34924,"_5":22689,"_15331":34454,"_1610":34925},[],"**Emisión a partir de un CSR generado de manera externa**",{"_8047":840,"_22539":670,"_19069":34927,"_5":22689,"_15331":34454,"_1610":34928},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_8047":841,"_22539":670,"_19069":34930,"_5":22689,"_15331":34454,"_1610":34931},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_8047":842,"_22539":670,"_19069":34933,"_5":22689,"_15331":34454,"_1610":34934},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_8047":843,"_22539":670,"_19069":34936,"_5":22689,"_15331":34458,"_1610":34937},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_8047":844,"_22539":670,"_19069":34939,"_5":22689,"_15331":34458,"_1610":34940},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_8047":845,"_22539":670,"_19069":34942,"_5":22689,"_15331":34458,"_1610":34943},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_8047":846,"_22539":670,"_19069":34945,"_5":22689,"_15331":34458,"_1610":34946},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_8047":847,"_22539":670,"_19069":34948,"_5":22689,"_15331":34458,"_1610":34949},[],"Unspecified (No especificado)",{"_8047":848,"_22539":670,"_19069":34951,"_5":22689,"_15331":34458,"_1610":34952},[],"KeyCompromise (Compromiso de clave)",{"_8047":849,"_22539":670,"_19069":34954,"_5":22689,"_15331":34458,"_1610":34955},[],"CACompromise (Compromiso de CA)",{"_8047":850,"_22539":670,"_19069":34957,"_5":22689,"_15331":34458,"_1610":34958},[],"AffiliationChanged (Afiliación cambiada)",{"_8047":851,"_22539":670,"_19069":34960,"_5":22689,"_15331":34458,"_1610":34961},[],"Superseded (Sustituida)",{"_8047":852,"_22539":670,"_19069":34963,"_5":22689,"_15331":34458,"_1610":34964},[],"CessationOfOperation (Cese de operación)",{"_8047":853,"_22539":670,"_19069":34966,"_5":22689,"_15331":34458,"_1610":34967},[],"CertificateHold (Retención de certificado)",{"_8047":854,"_22539":670,"_19069":34969,"_5":22689,"_15331":34458,"_1610":34970},[],"RemoveFromCRL (Eliminar de la CRL)",{"_8047":855,"_22539":670,"_19069":34972,"_5":22689,"_15331":34458,"_1610":34973},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_8047":856,"_22539":670,"_19069":34975,"_5":22689,"_15331":34458,"_1610":34976},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_8047":857,"_22539":670,"_19069":34978,"_5":22689,"_15331":34458,"_1610":34979},[],"Consideraciones importantes:",{"_8047":858,"_22539":670,"_19069":34981,"_5":22689,"_15331":34458,"_1610":34982},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_8047":859,"_22539":670,"_19069":34984,"_5":22689,"_15331":34458,"_1610":34985},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_8047":860,"_22539":860,"_5":22684,"_1610":34987,"_22697":34988,"_19069":34989,"_15331":860},"[Certs] Gestión de Certificados",[32410,33509,33518],[],{"_8047":861,"_22539":860,"_19069":34991,"_5":22689,"_15331":860,"_1610":34992},[],"Visualización y gestión de certificados emitidos",{"_8047":862,"_22539":860,"_5":22694,"_19069":34994,"_15331":34995,"_1610":34996},[],"/docs/pr-preview/pr-25/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_8047":863,"_22539":860,"_5":22694,"_19069":34998,"_15331":34999,"_1610":35000},[],"/docs/pr-preview/pr-25/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_8047":864,"_22539":860,"_19069":35002,"_5":22689,"_15331":34995,"_1610":35003},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_8047":865,"_22539":860,"_19069":35005,"_5":22689,"_15331":34995,"_1610":35006},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_8047":866,"_22539":860,"_19069":35008,"_5":22689,"_15331":34995,"_1610":35009},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_8047":867,"_22539":860,"_19069":35011,"_5":22689,"_15331":34999,"_1610":35012},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_8047":868,"_22539":860,"_19069":35014,"_5":22689,"_15331":34999,"_1610":35015},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_8047":869,"_22539":869,"_5":22684,"_1610":35017,"_22697":35018,"_19069":35019,"_15331":869},"[Devices] Dispositivos e Identidades",[32410,33509,33518],[],{"_8047":870,"_22539":869,"_19069":35021,"_5":22689,"_15331":869,"_1610":35022},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_8047":871,"_22539":869,"_5":22694,"_19069":35024,"_15331":35025,"_1610":35026},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_8047":872,"_22539":869,"_5":22694,"_19069":35028,"_15331":35029,"_1610":35030},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_8047":873,"_22539":869,"_5":22694,"_19069":35032,"_15331":35033,"_1610":35034},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_8047":874,"_22539":869,"_5":22694,"_19069":35036,"_15331":35037,"_1610":35038},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_8047":875,"_22539":869,"_5":22694,"_19069":35040,"_15331":35041,"_1610":35042},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_8047":876,"_22539":869,"_5":22694,"_19069":35044,"_15331":35045,"_1610":35046},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_8047":877,"_22539":869,"_5":22694,"_19069":35048,"_15331":35049,"_1610":35050},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_8047":878,"_22539":869,"_5":22694,"_19069":35052,"_15331":35053,"_1610":35054},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_8047":879,"_22539":869,"_19069":35056,"_5":22689,"_15331":35025,"_1610":35057},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_8047":880,"_22539":869,"_19069":35059,"_5":22689,"_15331":35029,"_1610":35060},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_8047":881,"_22539":869,"_19069":35062,"_5":22689,"_15331":35029,"_1610":35063},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_8047":882,"_22539":869,"_19069":35065,"_5":22689,"_15331":35029,"_1610":35066},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_8047":883,"_22539":869,"_19069":35068,"_5":22689,"_15331":35029,"_1610":35069},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_8047":884,"_22539":869,"_19069":35071,"_5":22689,"_15331":35029,"_1610":35072},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_8047":885,"_22539":869,"_19069":35074,"_5":22689,"_15331":35029,"_1610":35075},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_8047":886,"_22539":869,"_19069":35077,"_5":22689,"_15331":35029,"_1610":35078},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_8047":887,"_22539":869,"_19069":35080,"_5":22689,"_15331":35029,"_1610":35081},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_8047":888,"_22539":869,"_19069":35083,"_5":22689,"_15331":35029,"_1610":35084},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_8047":889,"_22539":869,"_19069":35086,"_5":22689,"_15331":35033,"_1610":35087},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_8047":890,"_22539":869,"_19069":35089,"_5":22689,"_15331":35033,"_1610":35090},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_8047":891,"_22539":869,"_19069":35092,"_5":22689,"_15331":35037,"_1610":35093},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_8047":892,"_22539":869,"_19069":35095,"_5":22689,"_15331":35037,"_1610":35096},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_8047":893,"_22539":869,"_19069":35098,"_5":22689,"_15331":35041,"_1610":35099},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_8047":894,"_22539":869,"_19069":35101,"_5":22689,"_15331":35041,"_1610":35102},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_8047":895,"_22539":869,"_19069":35104,"_5":22689,"_15331":35041,"_1610":35105},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_8047":896,"_22539":869,"_19069":35107,"_5":22689,"_15331":35041,"_1610":35108},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_8047":897,"_22539":869,"_19069":35110,"_5":22689,"_15331":35041,"_1610":35111},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_8047":898,"_22539":869,"_19069":35113,"_5":22689,"_15331":35041,"_1610":35114},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_8047":899,"_22539":869,"_19069":35116,"_5":22689,"_15331":35041,"_1610":35117},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_8047":900,"_22539":869,"_19069":35119,"_5":22689,"_15331":35041,"_1610":35120},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_8047":901,"_22539":869,"_19069":35122,"_5":22689,"_15331":35045,"_1610":35123},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_8047":902,"_22539":869,"_19069":35125,"_5":22689,"_15331":35045,"_1610":35126},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_8047":903,"_22539":869,"_19069":35128,"_5":22689,"_15331":35045,"_1610":35129},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_8047":904,"_22539":869,"_19069":35131,"_5":22689,"_15331":35045,"_1610":35132},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_8047":905,"_22539":869,"_19069":35134,"_5":22689,"_15331":35045,"_1610":35135},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_8047":906,"_22539":869,"_19069":35137,"_5":22689,"_15331":35045,"_1610":35138},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_8047":907,"_22539":869,"_19069":35140,"_5":22689,"_15331":35049,"_1610":35141},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_8047":908,"_22539":869,"_19069":35143,"_5":22689,"_15331":35049,"_1610":35144},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_8047":909,"_22539":869,"_19069":35146,"_5":22689,"_15331":35049,"_1610":35147},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_8047":910,"_22539":869,"_19069":35149,"_5":22689,"_15331":35049,"_1610":35150},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_8047":911,"_22539":869,"_19069":35152,"_5":22689,"_15331":35049,"_1610":35153},[],"**Unspecified**: Motivo de revocación no especificado.",{"_8047":912,"_22539":869,"_19069":35155,"_5":22689,"_15331":35049,"_1610":35156},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_8047":913,"_22539":869,"_19069":35158,"_5":22689,"_15331":35049,"_1610":35159},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_8047":914,"_22539":869,"_19069":35161,"_5":22689,"_15331":35049,"_1610":35162},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_8047":915,"_22539":869,"_19069":35164,"_5":22689,"_15331":35049,"_1610":35165},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_8047":916,"_22539":869,"_19069":35167,"_5":22689,"_15331":35049,"_1610":35168},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_8047":917,"_22539":869,"_19069":35170,"_5":22689,"_15331":35049,"_1610":35171},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_8047":918,"_22539":869,"_19069":35173,"_5":22689,"_15331":35049,"_1610":35174},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_8047":919,"_22539":869,"_19069":35176,"_5":22689,"_15331":35049,"_1610":35177},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_8047":920,"_22539":869,"_19069":35179,"_5":22689,"_15331":35049,"_1610":35180},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_8047":921,"_22539":869,"_19069":35182,"_5":22689,"_15331":35049,"_1610":35183},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_8047":922,"_22539":869,"_19069":35185,"_5":22689,"_15331":35049,"_1610":35186},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_8047":923,"_22539":869,"_19069":35188,"_5":22689,"_15331":35053,"_1610":35189},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_8047":924,"_22539":869,"_19069":35191,"_5":22689,"_15331":35053,"_1610":35192},[],"El proceso se realiza de la siguiente manera:",{"_8047":925,"_22539":869,"_19069":35194,"_5":22689,"_15331":35053,"_1610":35195},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_8047":926,"_22539":869,"_19069":35197,"_5":22689,"_15331":35053,"_1610":35198},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_8047":927,"_22539":869,"_19069":35200,"_5":22689,"_15331":35053,"_1610":35201},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_8047":928,"_22539":928,"_5":22684,"_1610":35203,"_22697":35204,"_19069":35205,"_15331":928},"EST: Enrollment over Secure Transport",[32410,33509,33518],[],{"_8047":929,"_22539":928,"_19069":35207,"_5":22689,"_15331":928,"_1610":35208},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_8047":930,"_22539":928,"_5":22694,"_19069":35210,"_15331":35211,"_1610":35203},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_8047":931,"_22539":928,"_5":22694,"_19069":35213,"_15331":35214,"_1610":33592},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-del-dms",{"_8047":932,"_22539":928,"_5":22694,"_19069":35216,"_15331":35217,"_1610":33115},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos",{"_8047":933,"_22539":928,"_5":22694,"_19069":35219,"_15331":35220,"_1610":35221},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_8047":934,"_22539":928,"_5":22694,"_19069":35223,"_15331":35224,"_1610":35225},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_8047":935,"_22539":928,"_5":22694,"_19069":35227,"_15331":35228,"_1610":35229},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_8047":936,"_22539":928,"_5":22694,"_19069":35231,"_15331":35232,"_1610":35233},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_8047":937,"_22539":928,"_5":22694,"_19069":35235,"_15331":35236,"_1610":35237},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_8047":938,"_22539":928,"_5":22694,"_19069":35239,"_15331":35240,"_1610":35241},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_8047":939,"_22539":928,"_5":22694,"_19069":35243,"_15331":35244,"_1610":35245},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_8047":940,"_22539":928,"_5":22694,"_19069":35247,"_15331":35248,"_1610":35249},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_8047":941,"_22539":928,"_5":22694,"_19069":35251,"_15331":35252,"_1610":35253},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","Antes de empezar",{"_8047":942,"_22539":928,"_5":22694,"_19069":35255,"_15331":35256,"_1610":35257},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_8047":943,"_22539":928,"_5":22694,"_19069":35259,"_15331":35260,"_1610":35261},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_8047":944,"_22539":928,"_5":22694,"_19069":35263,"_15331":35264,"_1610":35265},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_8047":945,"_22539":928,"_5":22694,"_19069":35267,"_15331":35268,"_1610":35269},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#cacerts","`/cacerts`",{"_8047":946,"_22539":928,"_5":22694,"_19069":35271,"_15331":35272,"_1610":35273},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_8047":947,"_22539":928,"_5":22694,"_19069":35275,"_15331":35276,"_1610":35277},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_8047":948,"_22539":928,"_5":22694,"_19069":35279,"_15331":35280,"_1610":35281},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_8047":949,"_22539":928,"_5":22694,"_19069":35283,"_15331":35284,"_1610":35285},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#flujos-completos","Flujos completos",{"_8047":950,"_22539":928,"_5":22694,"_19069":35287,"_15331":35288,"_1610":35289},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_8047":951,"_22539":928,"_5":22694,"_19069":35291,"_15331":35292,"_1610":35293},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_8047":952,"_22539":928,"_5":22694,"_19069":35295,"_15331":35296,"_1610":35297},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_8047":953,"_22539":928,"_5":22694,"_19069":35299,"_15331":35300,"_1610":35301},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_8047":954,"_22539":928,"_5":22694,"_19069":35303,"_15331":35304,"_1610":35305},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_8047":955,"_22539":928,"_5":22694,"_19069":35307,"_15331":35308,"_1610":35309},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_8047":956,"_22539":928,"_19069":35311,"_5":22689,"_15331":35211,"_1610":35312},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_8047":957,"_22539":928,"_19069":35314,"_5":22689,"_15331":35211,"_1610":35315},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_8047":958,"_22539":928,"_19069":35317,"_5":22689,"_15331":35211,"_1610":35318},[],"Esta guía está dividida en dos partes:",{"_8047":959,"_22539":928,"_19069":35320,"_5":22689,"_15331":35211,"_1610":35321},[],"Configuración del DMS, para el administrador PKI.",{"_8047":960,"_22539":928,"_19069":35323,"_5":22689,"_15331":35211,"_1610":35324},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_8047":961,"_22539":928,"_19069":35326,"_5":22689,"_15331":35211,"_1610":35327},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_8047":962,"_22539":928,"_19069":35329,"_5":22689,"_15331":35211,"_1610":35330},[],"Perfil",{"_8047":963,"_22539":928,"_19069":35332,"_5":22689,"_15331":35211,"_1610":35333},[],"Leer primero",{"_8047":964,"_22539":928,"_19069":35335,"_5":22689,"_15331":35211,"_1610":35336},[],"Después",{"_8047":965,"_22539":928,"_19069":35338,"_5":22689,"_15331":35211,"_1610":35339},[],"Administrador PKI",{"_8047":966,"_22539":928,"_19069":35341,"_5":22689,"_15331":35211,"_1610":33592},[],{"_8047":967,"_22539":928,"_19069":35343,"_5":22689,"_15331":35211,"_1610":35301},[],{"_8047":968,"_22539":928,"_19069":35345,"_5":22689,"_15331":35211,"_1610":35346},[],"Integrador de dispositivos",{"_8047":969,"_22539":928,"_19069":35348,"_5":22689,"_15331":35211,"_1610":35253},[],{"_8047":970,"_22539":928,"_19069":35350,"_5":22689,"_15331":35211,"_1610":35351},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_8047":971,"_22539":928,"_19069":35353,"_5":22689,"_15331":35217,"_1610":35354},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_8047":972,"_22539":928,"_19069":35356,"_5":22689,"_15331":35217,"_1610":35357},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_8047":973,"_22539":928,"_19069":35359,"_5":22689,"_15331":35217,"_1610":35360},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_8047":974,"_22539":928,"_19069":35362,"_5":22689,"_15331":35217,"_1610":35363},[],"Conviene separar cuatro bloques de configuración:",{"_8047":975,"_22539":928,"_19069":35365,"_5":22689,"_15331":35217,"_1610":35366},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_8047":976,"_22539":928,"_19069":35368,"_5":22689,"_15331":35217,"_1610":35369},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_8047":977,"_22539":928,"_19069":35371,"_5":22689,"_15331":35217,"_1610":35372},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_8047":978,"_22539":928,"_19069":35374,"_5":22689,"_15331":35217,"_1610":35375},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_8047":979,"_22539":928,"_19069":35377,"_5":22689,"_15331":35224,"_1610":35378},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_8047":980,"_22539":928,"_19069":35380,"_5":22689,"_15331":35224,"_1610":35381},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_8047":981,"_22539":928,"_19069":35383,"_5":22689,"_15331":35224,"_1610":35384},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_8047":982,"_22539":928,"_19069":35386,"_5":22689,"_15331":35224,"_1610":35387},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_8047":983,"_22539":928,"_19069":35389,"_5":22689,"_15331":35228,"_1610":35390},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_8047":984,"_22539":928,"_19069":35392,"_5":22689,"_15331":35228,"_1610":35393},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_8047":985,"_22539":928,"_19069":35395,"_5":22689,"_15331":35228,"_1610":35396},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_8047":986,"_22539":928,"_19069":35398,"_5":22689,"_15331":35228,"_1610":35399},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_8047":987,"_22539":928,"_19069":35401,"_5":22689,"_15331":35228,"_1610":35402},[],"Modo",{"_8047":988,"_22539":928,"_19069":35404,"_5":22689,"_15331":35228,"_1610":32613},[],{"_8047":989,"_22539":928,"_19069":35406,"_5":22689,"_15331":35228,"_1610":35407},[],"`CLIENT_CERTIFICATE`",{"_8047":990,"_22539":928,"_19069":35409,"_5":22689,"_15331":35228,"_1610":35410},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_8047":991,"_22539":928,"_19069":35412,"_5":22689,"_15331":35228,"_1610":35413},[],"`EXTERNAL_WEBHOOK`",{"_8047":992,"_22539":928,"_19069":35415,"_5":22689,"_15331":35228,"_1610":35416},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_8047":993,"_22539":928,"_19069":35418,"_5":22689,"_15331":35228,"_1610":35419},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_8047":994,"_22539":928,"_19069":35421,"_5":22689,"_15331":35228,"_1610":35422},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_8047":995,"_22539":928,"_19069":35424,"_5":22689,"_15331":35228,"_1610":35425},[],"`NO_AUTH`",{"_8047":996,"_22539":928,"_19069":35427,"_5":22689,"_15331":35228,"_1610":35428},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_8047":997,"_22539":928,"_19069":35430,"_5":22689,"_15331":35228,"_1610":35431},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_8047":998,"_22539":928,"_19069":35433,"_5":22689,"_15331":35228,"_1610":35434},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_8047":999,"_22539":928,"_19069":35436,"_5":22689,"_15331":35228,"_1610":35437},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_8047":1000,"_22539":928,"_19069":35439,"_5":22689,"_15331":35228,"_1610":35440},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_8047":1001,"_22539":928,"_19069":35442,"_5":22689,"_15331":35228,"_1610":35443},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_8047":1002,"_22539":928,"_19069":35445,"_5":22689,"_15331":35228,"_1610":35446},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_8047":1003,"_22539":928,"_19069":35448,"_5":22689,"_15331":35228,"_1610":35449},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_8047":1004,"_22539":928,"_19069":35451,"_5":22689,"_15331":35228,"_1610":35452},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_8047":1005,"_22539":928,"_19069":35454,"_5":22689,"_15331":35228,"_1610":35455},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_8047":1006,"_22539":928,"_19069":35457,"_5":22689,"_15331":35228,"_1610":35458},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_8047":1007,"_22539":928,"_19069":35460,"_5":22689,"_15331":35232,"_1610":35461},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_8047":1008,"_22539":928,"_19069":35463,"_5":22689,"_15331":35232,"_1610":35464},[],"Campo",{"_8047":1009,"_22539":928,"_19069":35466,"_5":22689,"_15331":35232,"_1610":33744},[],{"_8047":1010,"_22539":928,"_19069":35468,"_5":22689,"_15331":35232,"_1610":35469},[],"Efecto sobre el certificado emitido",{"_8047":1011,"_22539":928,"_19069":35471,"_5":22689,"_15331":35232,"_1610":35472},[],"`HonorSubject`",{"_8047":1012,"_22539":928,"_19069":35474,"_5":22689,"_15331":35232,"_1610":20793},[],{"_8047":1013,"_22539":928,"_19069":35476,"_5":22689,"_15331":35232,"_1610":35477},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_8047":1014,"_22539":928,"_19069":35479,"_5":22689,"_15331":35232,"_1610":35480},[],"`HonorKeyUsage`",{"_8047":1015,"_22539":928,"_19069":35482,"_5":22689,"_15331":35232,"_1610":20793},[],{"_8047":1016,"_22539":928,"_19069":35484,"_5":22689,"_15331":35232,"_1610":35485},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_8047":1017,"_22539":928,"_19069":35487,"_5":22689,"_15331":35232,"_1610":35488},[],"`HonorExtendedKeyUsages`",{"_8047":1018,"_22539":928,"_19069":35490,"_5":22689,"_15331":35232,"_1610":20793},[],{"_8047":1019,"_22539":928,"_19069":35492,"_5":22689,"_15331":35232,"_1610":35493},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_8047":1020,"_22539":928,"_19069":35495,"_5":22689,"_15331":35232,"_1610":35496},[],"`HonorExtensions`",{"_8047":1021,"_22539":928,"_19069":35498,"_5":22689,"_15331":35232,"_1610":20793},[],{"_8047":1022,"_22539":928,"_19069":35500,"_5":22689,"_15331":35232,"_1610":35501},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_8047":1023,"_22539":928,"_19069":35503,"_5":22689,"_15331":35232,"_1610":35504},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_8047":1024,"_22539":928,"_19069":35506,"_5":22689,"_15331":35236,"_1610":35507},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_8047":1025,"_22539":928,"_19069":35509,"_5":22689,"_15331":35236,"_1610":35510},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_8047":1026,"_22539":928,"_19069":35512,"_5":22689,"_15331":35236,"_1610":35513},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_8047":1027,"_22539":928,"_19069":35515,"_5":22689,"_15331":35236,"_1610":35516},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_8047":1028,"_22539":928,"_19069":35518,"_5":22689,"_15331":35236,"_1610":35519},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_8047":1029,"_22539":928,"_19069":35521,"_5":22689,"_15331":35236,"_1610":35522},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_8047":1030,"_22539":928,"_19069":35524,"_5":22689,"_15331":35236,"_1610":35525},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_8047":1031,"_22539":928,"_19069":35527,"_5":22689,"_15331":35240,"_1610":35528},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_8047":1032,"_22539":928,"_19069":35530,"_5":22689,"_15331":35240,"_1610":35531},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_8047":1033,"_22539":928,"_19069":35533,"_5":22689,"_15331":35240,"_1610":35534},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_8047":1034,"_22539":928,"_19069":35536,"_5":22689,"_15331":35240,"_1610":35537},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_8047":1035,"_22539":928,"_19069":35539,"_5":22689,"_15331":35244,"_1610":35540},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_8047":1036,"_22539":928,"_19069":35542,"_5":22689,"_15331":35244,"_1610":35543},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_8047":1037,"_22539":928,"_19069":35545,"_5":22689,"_15331":35244,"_1610":35546},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_8047":1038,"_22539":928,"_19069":35548,"_5":22689,"_15331":35244,"_1610":35549},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_8047":1039,"_22539":928,"_19069":35551,"_5":22689,"_15331":35248,"_1610":35552},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_8047":1040,"_22539":928,"_19069":35554,"_5":22689,"_15331":35248,"_1610":35555},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_8047":1041,"_22539":928,"_19069":35557,"_5":22689,"_15331":35248,"_1610":35558},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_8047":1042,"_22539":928,"_19069":35560,"_5":22689,"_15331":35252,"_1610":35561},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_8047":1043,"_22539":928,"_19069":35563,"_5":22689,"_15331":35252,"_1610":35564},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_8047":1044,"_22539":928,"_19069":35566,"_5":22689,"_15331":35252,"_1610":35567},[],"Elemento",{"_8047":1045,"_22539":928,"_19069":35569,"_5":22689,"_15331":35252,"_1610":32613},[],{"_8047":1046,"_22539":928,"_19069":35571,"_5":22689,"_15331":35252,"_1610":35572},[],"**URL del host EST**",{"_8047":1047,"_22539":928,"_19069":35574,"_5":22689,"_15331":35252,"_1610":35575},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_8047":1048,"_22539":928,"_19069":35577,"_5":22689,"_15331":35252,"_1610":35578},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_8047":1049,"_22539":928,"_19069":35580,"_5":22689,"_15331":35252,"_1610":35581},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_8047":1050,"_22539":928,"_19069":35583,"_5":22689,"_15331":35252,"_1610":35584},[],"**Certificado bootstrap + clave privada**",{"_8047":1051,"_22539":928,"_19069":35586,"_5":22689,"_15331":35252,"_1610":35587},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_8047":1052,"_22539":928,"_19069":35589,"_5":22689,"_15331":35252,"_1610":35590},[],"**ID del DMS** (`{aps}`)",{"_8047":1053,"_22539":928,"_19069":35592,"_5":22689,"_15331":35252,"_1610":35593},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_8047":1054,"_22539":928,"_19069":35595,"_5":22689,"_15331":35256,"_1610":35596},[],"Caso",{"_8047":1055,"_22539":928,"_19069":35598,"_5":22689,"_15331":35256,"_1610":35599},[],"Credencial habitual",{"_8047":1056,"_22539":928,"_19069":35601,"_5":22689,"_15331":35256,"_1610":35602},[],"Endpoint principal",{"_8047":1057,"_22539":928,"_19069":35604,"_5":22689,"_15331":35256,"_1610":35605},[],"Resultado",{"_8047":1058,"_22539":928,"_19069":35607,"_5":22689,"_15331":35256,"_1610":35608},[],"Alta inicial",{"_8047":1059,"_22539":928,"_19069":35610,"_5":22689,"_15331":35256,"_1610":35611},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_8047":1060,"_22539":928,"_19069":35613,"_5":22689,"_15331":35256,"_1610":35273},[],{"_8047":1061,"_22539":928,"_19069":35615,"_5":22689,"_15331":35256,"_1610":35616},[],"Certificado de dispositivo",{"_8047":1062,"_22539":928,"_19069":35618,"_5":22689,"_15331":35256,"_1610":35619},[],"Renovación",{"_8047":1063,"_22539":928,"_19069":35621,"_5":22689,"_15331":35256,"_1610":35622},[],"Certificado actual del dispositivo",{"_8047":1064,"_22539":928,"_19069":35624,"_5":22689,"_15331":35256,"_1610":35277},[],{"_8047":1065,"_22539":928,"_19069":35626,"_5":22689,"_15331":35256,"_1610":35627},[],"Certificado renovado",{"_8047":1066,"_22539":928,"_19069":35629,"_5":22689,"_15331":35256,"_1610":35630},[],"Descarga de confianza",{"_8047":1067,"_22539":928,"_19069":35632,"_5":22689,"_15331":35256,"_1610":35633},[],"TLS del servidor",{"_8047":1068,"_22539":928,"_19069":35635,"_5":22689,"_15331":35256,"_1610":35269},[],{"_8047":1069,"_22539":928,"_19069":35637,"_5":22689,"_15331":35256,"_1610":35638},[],"PKCS#7 o PEM con certificados",{"_8047":1070,"_22539":928,"_19069":35640,"_5":22689,"_15331":35256,"_1610":35641},[],"Clave generada en servidor",{"_8047":1071,"_22539":928,"_19069":35643,"_5":22689,"_15331":35256,"_1610":35644},[],"Igual que `/simpleenroll`",{"_8047":1072,"_22539":928,"_19069":35646,"_5":22689,"_15331":35256,"_1610":35281},[],{"_8047":1073,"_22539":928,"_19069":35648,"_5":22689,"_15331":35256,"_1610":35649},[],"Clave privada PKCS#8 + certificado",{"_8047":1074,"_22539":928,"_19069":35651,"_5":22689,"_15331":35260,"_1610":35652},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_8047":1075,"_22539":928,"_19069":35654,"_5":22689,"_15331":35260,"_1610":35655},[],"Modo (`AuthMode`)",{"_8047":1076,"_22539":928,"_19069":35657,"_5":22689,"_15331":35260,"_1610":32613},[],{"_8047":1077,"_22539":928,"_19069":35659,"_5":22689,"_15331":35260,"_1610":35660},[],"Credencial esperada",{"_8047":1078,"_22539":928,"_19069":35662,"_5":22689,"_15331":35260,"_1610":35663},[],"Aplica en enroll",{"_8047":1079,"_22539":928,"_19069":35665,"_5":22689,"_15331":35260,"_1610":35666},[],"Aplica en reenroll",{"_8047":1080,"_22539":928,"_19069":35668,"_5":22689,"_15331":35260,"_1610":35407},[],{"_8047":1081,"_22539":928,"_19069":35670,"_5":22689,"_15331":35260,"_1610":35671},[],"mTLS con certificado X.509",{"_8047":1082,"_22539":928,"_19069":35673,"_5":22689,"_15331":35260,"_1610":35674},[],"Certificado y clave privada cliente",{"_8047":1083,"_22539":928,"_19069":35676,"_5":22689,"_15331":35260,"_1610":33757},[],{"_8047":1084,"_22539":928,"_19069":35678,"_5":22689,"_15331":35260,"_1610":35679},[],"Sí (con el certificado en vigor)",{"_8047":1085,"_22539":928,"_19069":35681,"_5":22689,"_15331":35260,"_1610":35419},[],{"_8047":1086,"_22539":928,"_19069":35683,"_5":22689,"_15331":35260,"_1610":35684},[],"mTLS más validación por webhook",{"_8047":1087,"_22539":928,"_19069":35686,"_5":22689,"_15331":35260,"_1610":35687},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_8047":1088,"_22539":928,"_19069":35689,"_5":22689,"_15331":35260,"_1610":33757},[],{"_8047":1089,"_22539":928,"_19069":35691,"_5":22689,"_15331":35260,"_1610":35692},[],"No como combinación; en reenroll no mantiene ambos controles",{"_8047":1090,"_22539":928,"_19069":35694,"_5":22689,"_15331":35260,"_1610":35413},[],{"_8047":1091,"_22539":928,"_19069":35696,"_5":22689,"_15331":35260,"_1610":35697},[],"Webhook externo de autorización",{"_8047":1092,"_22539":928,"_19069":35699,"_5":22689,"_15331":35260,"_1610":35700},[],"Ninguna en el canal TLS",{"_8047":1093,"_22539":928,"_19069":35702,"_5":22689,"_15331":35260,"_1610":33757},[],{"_8047":1094,"_22539":928,"_19069":35704,"_5":22689,"_15331":35260,"_1610":35705},[],"No, degrada a `NO_AUTH`",{"_8047":1095,"_22539":928,"_19069":35707,"_5":22689,"_15331":35260,"_1610":35425},[],{"_8047":1096,"_22539":928,"_19069":35709,"_5":22689,"_15331":35260,"_1610":35710},[],"Sin autenticación",{"_8047":1097,"_22539":928,"_19069":35712,"_5":22689,"_15331":35260,"_1610":35713},[],"Ninguna",{"_8047":1098,"_22539":928,"_19069":35715,"_5":22689,"_15331":35260,"_1610":35716},[],"Sí (uso restringido)",{"_8047":1099,"_22539":928,"_19069":35718,"_5":22689,"_15331":35260,"_1610":35716},[],{"_8047":1100,"_22539":928,"_19069":35720,"_5":22689,"_15331":35260,"_1610":35721},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_8047":1101,"_22539":928,"_19069":35723,"_5":22689,"_15331":35260,"_1610":35724},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_8047":1102,"_22539":928,"_19069":35726,"_5":22689,"_15331":35260,"_1610":33741},[],{"_8047":1103,"_22539":928,"_19069":35728,"_5":22689,"_15331":35260,"_1610":33744},[],{"_8047":1104,"_22539":928,"_19069":35730,"_5":22689,"_15331":35260,"_1610":32613},[],{"_8047":1105,"_22539":928,"_19069":35732,"_5":22689,"_15331":35260,"_1610":35733},[],"`ValidationCAs`",{"_8047":1106,"_22539":928,"_19069":35735,"_5":22689,"_15331":35260,"_1610":35736},[],"lista de IDs de CA",{"_8047":1107,"_22539":928,"_19069":35738,"_5":22689,"_15331":35260,"_1610":35739},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_8047":1108,"_22539":928,"_19069":35741,"_5":22689,"_15331":35260,"_1610":35742},[],"`AllowExpired`",{"_8047":1109,"_22539":928,"_19069":35744,"_5":22689,"_15331":35260,"_1610":20793},[],{"_8047":1110,"_22539":928,"_19069":35746,"_5":22689,"_15331":35260,"_1610":35747},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_8047":1111,"_22539":928,"_19069":35749,"_5":22689,"_15331":35260,"_1610":35750},[],"`ChainLevelValidation`",{"_8047":1112,"_22539":928,"_19069":35752,"_5":22689,"_15331":35260,"_1610":4340},[],{"_8047":1113,"_22539":928,"_19069":35754,"_5":22689,"_15331":35260,"_1610":35755},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_8047":1114,"_22539":928,"_19069":35757,"_5":22689,"_15331":35260,"_1610":35758},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_8047":1115,"_22539":928,"_19069":35760,"_5":22689,"_15331":35260,"_1610":35761},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_8047":1116,"_22539":928,"_19069":35763,"_5":22689,"_15331":35260,"_1610":35764},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_8047":1117,"_22539":928,"_19069":35766,"_5":22689,"_15331":35260,"_1610":35767},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_8047":1118,"_22539":928,"_19069":35769,"_5":22689,"_15331":35264,"_1610":35770},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_8047":1119,"_22539":928,"_19069":35772,"_5":22689,"_15331":35264,"_1610":35773},[],"`/cacerts`: descarga de la cadena de confianza.",{"_8047":1120,"_22539":928,"_19069":35775,"_5":22689,"_15331":35264,"_1610":35776},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_8047":1121,"_22539":928,"_19069":35778,"_5":22689,"_15331":35264,"_1610":35779},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_8047":1122,"_22539":928,"_19069":35781,"_5":22689,"_15331":35264,"_1610":35782},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_8047":1123,"_22539":928,"_19069":35784,"_5":22689,"_15331":35268,"_1610":35785},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_8047":1124,"_22539":928,"_19069":35787,"_5":22689,"_15331":35268,"_1610":35788},[],"Campo de `CADistributionSettings`",{"_8047":1125,"_22539":928,"_19069":35790,"_5":22689,"_15331":35268,"_1610":33744},[],{"_8047":1126,"_22539":928,"_19069":35792,"_5":22689,"_15331":35268,"_1610":32613},[],{"_8047":1127,"_22539":928,"_19069":35794,"_5":22689,"_15331":35268,"_1610":35795},[],"`IncludeLamassuSystemCA`",{"_8047":1128,"_22539":928,"_19069":35797,"_5":22689,"_15331":35268,"_1610":20793},[],{"_8047":1129,"_22539":928,"_19069":35799,"_5":22689,"_15331":35268,"_1610":35800},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_8047":1130,"_22539":928,"_19069":35802,"_5":22689,"_15331":35268,"_1610":35803},[],"`IncludeEnrollmentCA`",{"_8047":1131,"_22539":928,"_19069":35805,"_5":22689,"_15331":35268,"_1610":20793},[],{"_8047":1132,"_22539":928,"_19069":35807,"_5":22689,"_15331":35268,"_1610":35808},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_8047":1133,"_22539":928,"_19069":35810,"_5":22689,"_15331":35268,"_1610":35811},[],"`ManagedCAs`",{"_8047":1134,"_22539":928,"_19069":35813,"_5":22689,"_15331":35268,"_1610":35736},[],{"_8047":1135,"_22539":928,"_19069":35815,"_5":22689,"_15331":35268,"_1610":35816},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_8047":1136,"_22539":928,"_19069":35818,"_5":22689,"_15331":35268,"_1610":35819},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_8047":1137,"_22539":928,"_19069":35821,"_5":22689,"_15331":35268,"_1610":35822},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_8047":1138,"_22539":928,"_19069":35824,"_5":22689,"_15331":35268,"_1610":35825},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_8047":1139,"_22539":928,"_19069":35827,"_5":22689,"_15331":35268,"_1610":35828},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_8047":1140,"_22539":928,"_19069":35830,"_5":22689,"_15331":35272,"_1610":35831},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_8047":1141,"_22539":928,"_19069":35833,"_5":22689,"_15331":35272,"_1610":35834},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_8047":1142,"_22539":928,"_19069":35836,"_5":22689,"_15331":35272,"_1610":35837},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_8047":1143,"_22539":928,"_19069":35839,"_5":22689,"_15331":35272,"_1610":35464},[],{"_8047":1144,"_22539":928,"_19069":35841,"_5":22689,"_15331":35272,"_1610":33744},[],{"_8047":1145,"_22539":928,"_19069":35843,"_5":22689,"_15331":35272,"_1610":35844},[],"Efecto",{"_8047":1146,"_22539":928,"_19069":35846,"_5":22689,"_15331":35272,"_1610":35847},[],"`EnrollmentSettings.RegistrationMode`",{"_8047":1147,"_22539":928,"_19069":35849,"_5":22689,"_15331":35272,"_1610":35850},[],"`JITP` / `PRE_REGISTRATION`",{"_8047":1148,"_22539":928,"_19069":35852,"_5":22689,"_15331":35272,"_1610":35853},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_8047":1149,"_22539":928,"_19069":35855,"_5":22689,"_15331":35272,"_1610":35856},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_8047":1150,"_22539":928,"_19069":35858,"_5":22689,"_15331":35272,"_1610":20793},[],{"_8047":1151,"_22539":928,"_19069":35860,"_5":22689,"_15331":35272,"_1610":35861},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_8047":1152,"_22539":928,"_19069":35863,"_5":22689,"_15331":35272,"_1610":35864},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_8047":1153,"_22539":928,"_19069":35866,"_5":22689,"_15331":35272,"_1610":20793},[],{"_8047":1154,"_22539":928,"_19069":35868,"_5":22689,"_15331":35272,"_1610":35869},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_8047":1155,"_22539":928,"_19069":35871,"_5":22689,"_15331":35272,"_1610":35872},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_8047":1156,"_22539":928,"_19069":35874,"_5":22689,"_15331":35276,"_1610":35875},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_8047":1157,"_22539":928,"_19069":35877,"_5":22689,"_15331":35276,"_1610":35878},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_8047":1158,"_22539":928,"_19069":35880,"_5":22689,"_15331":35276,"_1610":35881},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_8047":1159,"_22539":928,"_19069":35883,"_5":22689,"_15331":35276,"_1610":35464},[],{"_8047":1160,"_22539":928,"_19069":35885,"_5":22689,"_15331":35276,"_1610":33744},[],{"_8047":1161,"_22539":928,"_19069":35887,"_5":22689,"_15331":35276,"_1610":35844},[],{"_8047":1162,"_22539":928,"_19069":35889,"_5":22689,"_15331":35276,"_1610":35890},[],"`ReEnrollmentDelta`",{"_8047":1163,"_22539":928,"_19069":35892,"_5":22689,"_15331":35276,"_1610":35893},[],"duración",{"_8047":1164,"_22539":928,"_19069":35895,"_5":22689,"_15331":35276,"_1610":35896},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_8047":1165,"_22539":928,"_19069":35898,"_5":22689,"_15331":35276,"_1610":35899},[],"`EnableExpiredRenewal`",{"_8047":1166,"_22539":928,"_19069":35901,"_5":22689,"_15331":35276,"_1610":20793},[],{"_8047":1167,"_22539":928,"_19069":35903,"_5":22689,"_15331":35276,"_1610":35904},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_8047":1168,"_22539":928,"_19069":35906,"_5":22689,"_15331":35276,"_1610":35907},[],"`RevokeOnReEnrollment`",{"_8047":1169,"_22539":928,"_19069":35909,"_5":22689,"_15331":35276,"_1610":20793},[],{"_8047":1170,"_22539":928,"_19069":35911,"_5":22689,"_15331":35276,"_1610":35912},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_8047":1171,"_22539":928,"_19069":35914,"_5":22689,"_15331":35276,"_1610":35915},[],"`AdditionalValidationCAs`",{"_8047":1172,"_22539":928,"_19069":35917,"_5":22689,"_15331":35276,"_1610":35736},[],{"_8047":1173,"_22539":928,"_19069":35919,"_5":22689,"_15331":35276,"_1610":35920},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_8047":1174,"_22539":928,"_19069":35922,"_5":22689,"_15331":35276,"_1610":35923},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_8047":1175,"_22539":928,"_19069":35925,"_5":22689,"_15331":35276,"_1610":35926},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_8047":1176,"_22539":928,"_19069":35928,"_5":22689,"_15331":35280,"_1610":35929},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_8047":1177,"_22539":928,"_19069":35931,"_5":22689,"_15331":35280,"_1610":35932},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_8047":1178,"_22539":928,"_19069":35934,"_5":22689,"_15331":35280,"_1610":35935},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_8047":1179,"_22539":928,"_19069":35937,"_5":22689,"_15331":35280,"_1610":35938},[],"Tipo de clave",{"_8047":1180,"_22539":928,"_19069":35940,"_5":22689,"_15331":35280,"_1610":35941},[],"Parámetro válido",{"_8047":1181,"_22539":928,"_19069":35943,"_5":22689,"_15331":35280,"_1610":35944},[],"Curva NIST equivalente",{"_8047":1182,"_22539":928,"_19069":35946,"_5":22689,"_15331":35280,"_1610":35947},[],"Comportamiento ante valores no válidos",{"_8047":1183,"_22539":928,"_19069":35949,"_5":22689,"_15331":35280,"_1610":35950},[],"`RSA`",{"_8047":1184,"_22539":928,"_19069":35952,"_5":22689,"_15331":35280,"_1610":35953},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_8047":1185,"_22539":928,"_19069":35955,"_5":22689,"_15331":35280,"_1610":35956},[],"No aplica",{"_8047":1186,"_22539":928,"_19069":35958,"_5":22689,"_15331":35280,"_1610":35959},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_8047":1187,"_22539":928,"_19069":35961,"_5":22689,"_15331":35280,"_1610":35962},[],"`ECDSA`",{"_8047":1188,"_22539":928,"_19069":35964,"_5":22689,"_15331":35280,"_1610":35965},[],"224, 256, 384, 521",{"_8047":1189,"_22539":928,"_19069":35967,"_5":22689,"_15331":35280,"_1610":35968},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_8047":1190,"_22539":928,"_19069":35970,"_5":22689,"_15331":35280,"_1610":35971},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_8047":1191,"_22539":928,"_19069":35973,"_5":22689,"_15331":35280,"_1610":35974},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_8047":1192,"_22539":928,"_19069":35976,"_5":22689,"_15331":35280,"_1610":35977},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_8047":1193,"_22539":928,"_19069":35979,"_5":22689,"_15331":35280,"_1610":35980},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_8047":1194,"_22539":928,"_19069":35982,"_5":22689,"_15331":35280,"_1610":35983},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_8047":1195,"_22539":928,"_19069":35985,"_5":22689,"_15331":35280,"_1610":35986},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_8047":1196,"_22539":928,"_19069":35988,"_5":22689,"_15331":35280,"_1610":35989},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_8047":1197,"_22539":928,"_19069":35991,"_5":22689,"_15331":35280,"_1610":35992},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_8047":1198,"_22539":928,"_19069":35994,"_5":22689,"_15331":35284,"_1610":35995},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_8047":1199,"_22539":928,"_19069":35997,"_5":22689,"_15331":35288,"_1610":35998},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_8047":1200,"_22539":928,"_19069":36000,"_5":22689,"_15331":35292,"_1610":36001},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_8047":1201,"_22539":928,"_19069":36003,"_5":22689,"_15331":35296,"_1610":36004},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_8047":1202,"_22539":928,"_19069":36006,"_5":22689,"_15331":35296,"_1610":36007},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_8047":1203,"_22539":928,"_19069":36009,"_5":22689,"_15331":35296,"_1610":36010},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_8047":1204,"_22539":928,"_19069":36012,"_5":22689,"_15331":35296,"_1610":36013},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_8047":1205,"_22539":928,"_19069":36015,"_5":22689,"_15331":35304,"_1610":36016},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_8047":1206,"_22539":928,"_19069":36018,"_5":22689,"_15331":35304,"_1610":36019},[],"HTTP",{"_8047":1207,"_22539":928,"_19069":36021,"_5":22689,"_15331":35304,"_1610":36022},[],"Mensaje",{"_8047":1208,"_22539":928,"_19069":36024,"_5":22689,"_15331":35304,"_1610":36025},[],"Causa",{"_8047":1209,"_22539":928,"_19069":36027,"_5":22689,"_15331":35304,"_1610":36028},[],"Acción del integrador",{"_8047":1210,"_22539":928,"_19069":36030,"_5":22689,"_15331":35304,"_1610":19898},[],{"_8047":1211,"_22539":928,"_19069":36032,"_5":22689,"_15331":35304,"_1610":36033},[],"`Field validation for 'APS' failed`",{"_8047":1212,"_22539":928,"_19069":36035,"_5":22689,"_15331":35304,"_1610":36036},[],"El segmento `{aps}` falta en la URL.",{"_8047":1213,"_22539":928,"_19069":36038,"_5":22689,"_15331":35304,"_1610":36039},[],"Incluir el ID del DMS en la ruta.",{"_8047":1214,"_22539":928,"_19069":36041,"_5":22689,"_15331":35304,"_1610":19898},[],{"_8047":1215,"_22539":928,"_19069":36043,"_5":22689,"_15331":35304,"_1610":36044},[],"`content-type must be application/pkcs10`",{"_8047":1216,"_22539":928,"_19069":36046,"_5":22689,"_15331":35304,"_1610":36047},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_8047":1217,"_22539":928,"_19069":36049,"_5":22689,"_15331":35304,"_1610":36050},[],"Fijar `Content-Type: application/pkcs10`.",{"_8047":1218,"_22539":928,"_19069":36052,"_5":22689,"_15331":35304,"_1610":19898},[],{"_8047":1219,"_22539":928,"_19069":36054,"_5":22689,"_15331":35304,"_1610":36055},[],"`body payload must be base64 encoded`",{"_8047":1220,"_22539":928,"_19069":36057,"_5":22689,"_15331":35304,"_1610":36058},[],"El cuerpo no es base64 válido.",{"_8047":1221,"_22539":928,"_19069":36060,"_5":22689,"_15331":35304,"_1610":36061},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_8047":1222,"_22539":928,"_19069":36063,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1223,"_22539":928,"_19069":36065,"_5":22689,"_15331":35304,"_1610":36066},[],"`DMS not found`",{"_8047":1224,"_22539":928,"_19069":36068,"_5":22689,"_15331":35304,"_1610":36069},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_8047":1225,"_22539":928,"_19069":36071,"_5":22689,"_15331":35304,"_1610":36072},[],"Verificar el identificador con el administrador PKI.",{"_8047":1226,"_22539":928,"_19069":36074,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1227,"_22539":928,"_19069":36076,"_5":22689,"_15331":35304,"_1610":36077},[],"`invalid certificate`",{"_8047":1228,"_22539":928,"_19069":36079,"_5":22689,"_15331":35304,"_1610":36080},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_8047":1229,"_22539":928,"_19069":36082,"_5":22689,"_15331":35304,"_1610":36083},[],"Comprobar la cadena del certificado bootstrap.",{"_8047":1230,"_22539":928,"_19069":36085,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1231,"_22539":928,"_19069":36087,"_5":22689,"_15331":35304,"_1610":36088},[],"`certificate is revoked`",{"_8047":1232,"_22539":928,"_19069":36090,"_5":22689,"_15331":35304,"_1610":36091},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_8047":1233,"_22539":928,"_19069":36093,"_5":22689,"_15331":35304,"_1610":36094},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_8047":1234,"_22539":928,"_19069":36096,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1235,"_22539":928,"_19069":36098,"_5":22689,"_15331":35304,"_1610":36099},[],"`revoked certificate`",{"_8047":1236,"_22539":928,"_19069":36101,"_5":22689,"_15331":35304,"_1610":36102},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_8047":1237,"_22539":928,"_19069":36104,"_5":22689,"_15331":35304,"_1610":36105},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_8047":1238,"_22539":928,"_19069":36107,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1239,"_22539":928,"_19069":36109,"_5":22689,"_15331":35304,"_1610":36110},[],"`expired certificate`",{"_8047":1240,"_22539":928,"_19069":36112,"_5":22689,"_15331":35304,"_1610":36113},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_8047":1241,"_22539":928,"_19069":36115,"_5":22689,"_15331":35304,"_1610":36116},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_8047":1242,"_22539":928,"_19069":36118,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1243,"_22539":928,"_19069":36120,"_5":22689,"_15331":35304,"_1610":36121},[],"`forbiddenNewEnrollment`",{"_8047":1244,"_22539":928,"_19069":36123,"_5":22689,"_15331":35304,"_1610":36124},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_8047":1245,"_22539":928,"_19069":36126,"_5":22689,"_15331":35304,"_1610":36127},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_8047":1246,"_22539":928,"_19069":36129,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1247,"_22539":928,"_19069":36131,"_5":22689,"_15331":35304,"_1610":36132},[],"`device not preregistered`",{"_8047":1248,"_22539":928,"_19069":36134,"_5":22689,"_15331":35304,"_1610":36135},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_8047":1249,"_22539":928,"_19069":36137,"_5":22689,"_15331":35304,"_1610":36138},[],"Registrar el dispositivo antes de inscribirlo.",{"_8047":1250,"_22539":928,"_19069":36140,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1251,"_22539":928,"_19069":36142,"_5":22689,"_15331":35304,"_1610":36143},[],"`invalid reenroll window`",{"_8047":1252,"_22539":928,"_19069":36145,"_5":22689,"_15331":35304,"_1610":36146},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_8047":1253,"_22539":928,"_19069":36148,"_5":22689,"_15331":35304,"_1610":36149},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_8047":1254,"_22539":928,"_19069":36151,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1255,"_22539":928,"_19069":36153,"_5":22689,"_15331":35304,"_1610":36154},[],"`invalid RawSubject bytes`",{"_8047":1256,"_22539":928,"_19069":36156,"_5":22689,"_15331":35304,"_1610":36157},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_8047":1257,"_22539":928,"_19069":36159,"_5":22689,"_15331":35304,"_1610":36160},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_8047":1258,"_22539":928,"_19069":36162,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1259,"_22539":928,"_19069":36164,"_5":22689,"_15331":35304,"_1610":36165},[],"`external webhook denied enrollment`",{"_8047":1260,"_22539":928,"_19069":36167,"_5":22689,"_15331":35304,"_1610":36168},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_8047":1261,"_22539":928,"_19069":36170,"_5":22689,"_15331":35304,"_1610":36171},[],"Revisar los logs del servicio webhook.",{"_8047":1262,"_22539":928,"_19069":36173,"_5":22689,"_15331":35304,"_1610":20426},[],{"_8047":1263,"_22539":928,"_19069":36175,"_5":22689,"_15331":35304,"_1610":36176},[],"`server key generation not enabled`",{"_8047":1264,"_22539":928,"_19069":36178,"_5":22689,"_15331":35304,"_1610":36179},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_8047":1265,"_22539":928,"_19069":36181,"_5":22689,"_15331":35304,"_1610":36182},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_8047":1266,"_22539":928,"_19069":36184,"_5":22689,"_15331":35304,"_1610":36185},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_8047":1267,"_22539":928,"_19069":36187,"_5":22689,"_15331":35308,"_1610":36188},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_8047":1268,"_22539":928,"_19069":36190,"_5":22689,"_15331":35308,"_1610":36191},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_8047":1269,"_22539":928,"_19069":36193,"_5":22689,"_15331":35308,"_1610":36194},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_8047":1270,"_22539":928,"_19069":36196,"_5":22689,"_15331":35308,"_1610":36197},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_8047":1271,"_22539":928,"_19069":36199,"_5":22689,"_15331":35308,"_1610":36200},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_8047":1272,"_22539":928,"_19069":36202,"_5":22689,"_15331":35308,"_1610":36203},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_8047":1273,"_22539":928,"_19069":36205,"_5":22689,"_15331":35308,"_1610":36206},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_8047":1274,"_22539":928,"_19069":36208,"_5":22689,"_15331":35308,"_1610":36209},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_8047":1275,"_22539":928,"_19069":36211,"_5":22689,"_15331":35308,"_1610":36212},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_8047":1276,"_22539":928,"_19069":36214,"_5":22689,"_15331":35308,"_1610":36215},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_8047":1277,"_22539":1277,"_5":22684,"_1610":36217,"_22697":36218,"_19069":36219,"_15331":1277},"[KMS] Gestión de Claves Criptográficas",[32410,33509,33518],[],{"_8047":1278,"_22539":1277,"_19069":36221,"_5":22689,"_15331":1277,"_1610":36222},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_8047":1279,"_22539":1277,"_5":22694,"_19069":36224,"_15331":36225,"_1610":36226},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_8047":1280,"_22539":1277,"_5":22694,"_19069":36228,"_15331":36229,"_1610":36230},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#algoritmos-y-tamaños-de-clave-soportados","Algoritmos y tamaños de clave soportados",{"_8047":1281,"_22539":1277,"_5":22694,"_19069":36232,"_15331":36233,"_1610":36234},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_8047":1282,"_22539":1277,"_5":22694,"_19069":36236,"_15331":36237,"_1610":36238},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_8047":1283,"_22539":1277,"_5":22694,"_19069":36240,"_15331":36241,"_1610":36242},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_8047":1284,"_22539":1277,"_5":22694,"_19069":36244,"_15331":36245,"_1610":36246},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_8047":1285,"_22539":1277,"_5":22694,"_19069":36248,"_15331":36249,"_1610":36250},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_8047":1286,"_22539":1277,"_5":22694,"_19069":36252,"_15331":36253,"_1610":36254},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_8047":1287,"_22539":1277,"_5":22694,"_19069":36256,"_15331":36257,"_1610":36258},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_8047":1288,"_22539":1277,"_5":22694,"_19069":36260,"_15331":36261,"_1610":36262},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_8047":1289,"_22539":1277,"_5":22694,"_19069":36264,"_15331":36265,"_1610":36266},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_8047":1290,"_22539":1277,"_5":22694,"_19069":36268,"_15331":36269,"_1610":36270},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#sign","Sign",{"_8047":1291,"_22539":1277,"_5":22694,"_19069":36272,"_15331":36273,"_1610":36274},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#verify","Verify",{"_8047":1292,"_22539":1277,"_5":22694,"_19069":36276,"_15331":36277,"_1610":36278},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_8047":1293,"_22539":1277,"_5":22694,"_19069":36280,"_15331":36281,"_1610":36282},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_8047":1294,"_22539":1277,"_19069":36284,"_5":22689,"_15331":36225,"_1610":36285},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_8047":1295,"_22539":1277,"_19069":36287,"_5":22689,"_15331":36225,"_1610":36288},[],"En la configuración actual, Lamassu IoT trabaja con claves asimétricas. Además de los algoritmos clásicos, RSA y curvas elípticas, el KMS soporta claves Ed25519 y claves de firma post-cuántica (ML-DSA, SLH-DSA y Composite ML-DSA). Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_8047":1296,"_22539":1277,"_19069":36290,"_5":22689,"_15331":36229,"_1610":36291},[],"El catálogo de claves que puede gestionar el KMS combina algoritmos clásicos y de firma post-cuántica:",{"_8047":1297,"_22539":1277,"_19069":36293,"_5":22689,"_15331":36229,"_1610":36294},[],"Familia",{"_8047":1298,"_22539":1277,"_19069":36296,"_5":22689,"_15331":36229,"_1610":36297},[],"Algoritmo (`Algorithm`)",{"_8047":1299,"_22539":1277,"_19069":36299,"_5":22689,"_15331":36229,"_1610":36300},[],"Tamaños y parámetros (`Size`)",{"_8047":1300,"_22539":1277,"_19069":36302,"_5":22689,"_15331":36229,"_1610":36303},[],"RSA",{"_8047":1301,"_22539":1277,"_19069":36305,"_5":22689,"_15331":36229,"_1610":36303},[],{"_8047":1302,"_22539":1277,"_19069":36307,"_5":22689,"_15331":36229,"_1610":36308},[],"1024, 2048, 3072, 4096, 7680 y 15360 bits",{"_8047":1303,"_22539":1277,"_19069":36310,"_5":22689,"_15331":36229,"_1610":36311},[],"Curvas elípticas",{"_8047":1304,"_22539":1277,"_19069":36313,"_5":22689,"_15331":36229,"_1610":36314},[],"ECDSA",{"_8047":1305,"_22539":1277,"_19069":36316,"_5":22689,"_15331":36229,"_1610":36317},[],"P-224, P-256, P-384 y P-521",{"_8047":1306,"_22539":1277,"_19069":36319,"_5":22689,"_15331":36229,"_1610":36320},[],"Ed25519",{"_8047":1307,"_22539":1277,"_19069":36322,"_5":22689,"_15331":36229,"_1610":36320},[],{"_8047":1308,"_22539":1277,"_19069":36324,"_5":22689,"_15331":36229,"_1610":36325},[],"Tamaño fijo de 256 bits",{"_8047":1309,"_22539":1277,"_19069":36327,"_5":22689,"_15331":36229,"_1610":36328},[],"ML-DSA",{"_8047":1310,"_22539":1277,"_19069":36330,"_5":22689,"_15331":36229,"_1610":36328},[],{"_8047":1311,"_22539":1277,"_19069":36332,"_5":22689,"_15331":36229,"_1610":36333},[],"Variantes 44, 65 y 87",{"_8047":1312,"_22539":1277,"_19069":36335,"_5":22689,"_15331":36229,"_1610":36336},[],"SLH-DSA",{"_8047":1313,"_22539":1277,"_19069":36338,"_5":22689,"_15331":36229,"_1610":36336},[],{"_8047":1314,"_22539":1277,"_19069":36340,"_5":22689,"_15331":36229,"_1610":36341},[],"Conjuntos de parámetros del 1 al 12",{"_8047":1315,"_22539":1277,"_19069":36343,"_5":22689,"_15331":36229,"_1610":36344},[],"Composite ML-DSA",{"_8047":1316,"_22539":1277,"_19069":36346,"_5":22689,"_15331":36229,"_1610":36347},[],"Composite-ML-DSA-RSA",{"_8047":1317,"_22539":1277,"_19069":36349,"_5":22689,"_15331":36229,"_1610":36350},[],"Variantes 1 a 8",{"_8047":1318,"_22539":1277,"_19069":36352,"_5":22689,"_15331":36229,"_1610":36344},[],{"_8047":1319,"_22539":1277,"_19069":36354,"_5":22689,"_15331":36229,"_1610":36355},[],"Composite-ML-DSA-ECDSA",{"_8047":1320,"_22539":1277,"_19069":36357,"_5":22689,"_15331":36229,"_1610":36358},[],"Variantes 9 a 13",{"_8047":1321,"_22539":1277,"_19069":36360,"_5":22689,"_15331":36229,"_1610":36344},[],{"_8047":1322,"_22539":1277,"_19069":36362,"_5":22689,"_15331":36229,"_1610":36363},[],"Composite-ML-DSA-Ed25519",{"_8047":1323,"_22539":1277,"_19069":36365,"_5":22689,"_15331":36229,"_1610":36366},[],"Variantes 14 a 15",{"_8047":1324,"_22539":1277,"_19069":36368,"_5":22689,"_15331":36229,"_1610":36369},[],"Consideraciones sobre estos algoritmos:",{"_8047":1325,"_22539":1277,"_19069":36371,"_5":22689,"_15331":36229,"_1610":36372},[],"**ML-DSA** y **SLH-DSA** son los esquemas de firma digital post-cuántica estandarizados por NIST en las publicaciones FIPS 204 y FIPS 205. En ML-DSA el tamaño selecciona el nivel de seguridad (ML-DSA-44, ML-DSA-65 o ML-DSA-87); en SLH-DSA, el valor del 1 al 12 identifica el conjunto de parámetros del esquema.",{"_8047":1326,"_22539":1277,"_19069":36374,"_5":22689,"_15331":36229,"_1610":36375},[],"**Composite ML-DSA** combina ML-DSA con un algoritmo clásico (RSA, ECDSA o Ed25519) en una única clave, lo que facilita la migración post-cuántica manteniendo compatibilidad con las infraestructuras clásicas. El número de variante identifica la combinación exacta de ML-DSA, algoritmo clásico y función hash; por ejemplo, la variante 1 equivale a ML-DSA-44 con RSA 2048 (PSS-SHA256) y la variante 14 a ML-DSA-44 con Ed25519.",{"_8047":1327,"_22539":1277,"_19069":36377,"_5":22689,"_15331":36229,"_1610":36378},[],"**Ed25519** es un esquema de firma de curva elíptica con tamaño fijo; no es necesario indicar un tamaño al crear la clave.",{"_8047":1328,"_22539":1277,"_19069":36380,"_5":22689,"_15331":36229,"_1610":36381},[],"La disponibilidad de estos tipos depende del motor criptográfico seleccionado. Todos los motores trabajan con el catálogo clásico basado en RSA y ECDSA, si bien los tamaños concretos pueden variar según el proveedor o el HSM. Los nuevos tipos (Ed25519, ML-DSA, SLH-DSA y Composite ML-DSA) están soportados de extremo a extremo, tanto en generación como en importación, por el motor File System. Si se solicita a un motor un tipo o tamaño que no soporta, la operación se rechaza con un error.",{"_8047":1329,"_22539":1277,"_19069":36383,"_5":22689,"_15331":36233,"_1610":36384},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_8047":1330,"_22539":1277,"_19069":36386,"_5":22689,"_15331":36233,"_1610":36387},[],"En la práctica, permite:",{"_8047":1331,"_22539":1277,"_19069":36389,"_5":22689,"_15331":36233,"_1610":36390},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_8047":1332,"_22539":1277,"_19069":36392,"_5":22689,"_15331":36233,"_1610":36393},[],"Importar claves creadas externamente.",{"_8047":1333,"_22539":1277,"_19069":36395,"_5":22689,"_15331":36233,"_1610":36396},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_8047":1334,"_22539":1277,"_19069":36398,"_5":22689,"_15331":36233,"_1610":36399},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_8047":1335,"_22539":1277,"_19069":36401,"_5":22689,"_15331":36237,"_1610":36402},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_8047":1336,"_22539":1277,"_19069":36404,"_5":22689,"_15331":36237,"_1610":36405},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_8047":1337,"_22539":1277,"_19069":36407,"_5":22689,"_15331":36237,"_1610":36408},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_8047":1338,"_22539":1277,"_19069":36410,"_5":22689,"_15331":36237,"_1610":36411},[],"Crypto Engine",{"_8047":1339,"_22539":1277,"_19069":36413,"_5":22689,"_15331":36237,"_1610":36414},[],"Nivel de seguridad",{"_8047":1340,"_22539":1277,"_19069":36416,"_5":22689,"_15331":36237,"_1610":36417},[],"OnPrem / Cloud",{"_8047":1341,"_22539":1277,"_19069":36419,"_5":22689,"_15331":36237,"_1610":36420},[],"Coste adicional",{"_8047":1342,"_22539":1277,"_19069":36422,"_5":22689,"_15331":36237,"_1610":36423},[],"Generación de claves",{"_8047":1343,"_22539":1277,"_19069":36425,"_5":22689,"_15331":36237,"_1610":36426},[],"Persistencia *at-rest* segura",{"_8047":1344,"_22539":1277,"_19069":36428,"_5":22689,"_15331":36237,"_1610":36429},[],"Filtración de claves",{"_8047":1345,"_22539":1277,"_19069":36431,"_5":22689,"_15331":36237,"_1610":36432},[],"Consideraciones",{"_8047":1346,"_22539":1277,"_19069":36434,"_5":22689,"_15331":36237,"_1610":36435},[],"File System",{"_8047":1347,"_22539":1277,"_19069":36437,"_5":22689,"_15331":36237,"_1610":11412},[],{"_8047":1348,"_22539":1277,"_19069":36439,"_5":22689,"_15331":36237,"_1610":36440},[],"OnPrem y Cloud",{"_8047":1349,"_22539":1277,"_19069":36442,"_5":22689,"_15331":36237,"_1610":33809},[],{"_8047":1350,"_22539":1277,"_19069":36444,"_5":22689,"_15331":36237,"_1610":36445},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_8047":1351,"_22539":1277,"_19069":36447,"_5":22689,"_15331":36237,"_1610":36448},[],"**Insegura**. Delegada en el sistema de archivos.",{"_8047":1352,"_22539":1277,"_19069":36450,"_5":22689,"_15331":36237,"_1610":36448},[],{"_8047":1353,"_22539":1277,"_19069":36452,"_5":22689,"_15331":36237,"_1610":36453},[],"No recomendado para producción.",{"_8047":1354,"_22539":1277,"_19069":36455,"_5":22689,"_15331":36237,"_1610":36456},[],"HashiCorp Vault",{"_8047":1355,"_22539":1277,"_19069":36458,"_5":22689,"_15331":36237,"_1610":4058},[],{"_8047":1356,"_22539":1277,"_19069":36460,"_5":22689,"_15331":36237,"_1610":36440},[],{"_8047":1357,"_22539":1277,"_19069":36462,"_5":22689,"_15331":36237,"_1610":33809},[],{"_8047":1358,"_22539":1277,"_19069":36464,"_5":22689,"_15331":36237,"_1610":36465},[],"Depende de la configuración de Vault.",{"_8047":1359,"_22539":1277,"_19069":36467,"_5":22689,"_15331":36237,"_1610":36468},[],"**Segura**",{"_8047":1360,"_22539":1277,"_19069":36470,"_5":22689,"_15331":36237,"_1610":36471},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_8047":1361,"_22539":1277,"_19069":36473,"_5":22689,"_15331":36237,"_1610":36474},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_8047":1362,"_22539":1277,"_19069":36476,"_5":22689,"_15331":36237,"_1610":36477},[],"AWS Secrets Manager",{"_8047":1363,"_22539":1277,"_19069":36479,"_5":22689,"_15331":36237,"_1610":4058},[],{"_8047":1364,"_22539":1277,"_19069":36481,"_5":22689,"_15331":36237,"_1610":36482},[],"Cloud",{"_8047":1365,"_22539":1277,"_19069":36484,"_5":22689,"_15331":36237,"_1610":33757},[],{"_8047":1366,"_22539":1277,"_19069":36486,"_5":22689,"_15331":36237,"_1610":36487},[],"Depende del proceso de alta de la clave.",{"_8047":1367,"_22539":1277,"_19069":36489,"_5":22689,"_15331":36237,"_1610":36468},[],{"_8047":1368,"_22539":1277,"_19069":36491,"_5":22689,"_15331":36237,"_1610":36471},[],{"_8047":1369,"_22539":1277,"_19069":36493,"_5":22689,"_15331":36237,"_1610":36494},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_8047":1370,"_22539":1277,"_19069":36496,"_5":22689,"_15331":36237,"_1610":36497},[],"AWS KMS",{"_8047":1371,"_22539":1277,"_19069":36499,"_5":22689,"_15331":36237,"_1610":13594},[],{"_8047":1372,"_22539":1277,"_19069":36501,"_5":22689,"_15331":36237,"_1610":36482},[],{"_8047":1373,"_22539":1277,"_19069":36503,"_5":22689,"_15331":36237,"_1610":33757},[],{"_8047":1374,"_22539":1277,"_19069":36505,"_5":22689,"_15331":36237,"_1610":36506},[],"**Entropía hardware**",{"_8047":1375,"_22539":1277,"_19069":36508,"_5":22689,"_15331":36237,"_1610":36468},[],{"_8047":1376,"_22539":1277,"_19069":36510,"_5":22689,"_15331":36237,"_1610":36468},[],{"_8047":1377,"_22539":1277,"_19069":36512,"_5":22689,"_15331":36237,"_1610":36513},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_8047":1378,"_22539":1277,"_19069":36515,"_5":22689,"_15331":36237,"_1610":36516},[],"PKCS11",{"_8047":1379,"_22539":1277,"_19069":36518,"_5":22689,"_15331":36237,"_1610":36519},[],"3\\*",{"_8047":1380,"_22539":1277,"_19069":36521,"_5":22689,"_15331":36237,"_1610":36522},[],"AirGap OnPrem y Cloud",{"_8047":1381,"_22539":1277,"_19069":36524,"_5":22689,"_15331":36237,"_1610":36525},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_8047":1382,"_22539":1277,"_19069":36527,"_5":22689,"_15331":36237,"_1610":36506},[],{"_8047":1383,"_22539":1277,"_19069":36529,"_5":22689,"_15331":36237,"_1610":36530},[],"**Segura**\\*",{"_8047":1384,"_22539":1277,"_19069":36532,"_5":22689,"_15331":36237,"_1610":36533},[],"Depende del HSM",{"_8047":1385,"_22539":1277,"_19069":36535,"_5":22689,"_15331":36237,"_1610":36536},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_8047":1386,"_22539":1277,"_19069":36538,"_5":22689,"_15331":36237,"_1610":36539},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_8047":1387,"_22539":1277,"_19069":36541,"_5":22689,"_15331":36237,"_1610":36542},[],"Cada motor define qué algoritmos y tamaños de clave soporta (ver la sección *Algoritmos y tamaños de clave soportados*) y rechaza las operaciones que se le solicitan fuera de ese catálogo.",{"_8047":1388,"_22539":1277,"_19069":36544,"_5":22689,"_15331":36237,"_1610":36545},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_8047":1389,"_22539":1277,"_19069":36547,"_5":22689,"_15331":36241,"_1610":36548},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_8047":1390,"_22539":1277,"_19069":36550,"_5":22689,"_15331":36241,"_1610":36551},[],"La tabla incluye los siguientes campos:",{"_8047":1391,"_22539":1277,"_19069":36553,"_5":22689,"_15331":36241,"_1610":36554},[],"**Name**: nombre descriptivo de la clave.",{"_8047":1392,"_22539":1277,"_19069":36556,"_5":22689,"_15331":36241,"_1610":36557},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048, EC P-256 o ML-DSA 65.",{"_8047":1393,"_22539":1277,"_19069":36559,"_5":22689,"_15331":36241,"_1610":36560},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_8047":1394,"_22539":1277,"_19069":36562,"_5":22689,"_15331":36241,"_1610":36563},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_8047":1395,"_22539":1277,"_19069":36565,"_5":22689,"_15331":36241,"_1610":36566},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_8047":1396,"_22539":1277,"_19069":36568,"_5":22689,"_15331":36241,"_1610":36569},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_8047":1397,"_22539":1277,"_19069":36571,"_5":22689,"_15331":36241,"_1610":36572},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_8047":1398,"_22539":1277,"_19069":36574,"_5":22689,"_15331":36241,"_1610":36575},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_8047":1399,"_22539":1277,"_19069":36577,"_5":22689,"_15331":36241,"_1610":36578},[],"Desde esta vista también se accede a las acciones más habituales:",{"_8047":1400,"_22539":1277,"_19069":36580,"_5":22689,"_15331":36241,"_1610":36581},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_8047":1401,"_22539":1277,"_19069":36583,"_5":22689,"_15331":36241,"_1610":36584},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_8047":1402,"_22539":1277,"_19069":36586,"_5":22689,"_15331":36241,"_1610":36587},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_8047":1403,"_22539":1277,"_19069":36589,"_5":22689,"_15331":36241,"_1610":36590},[],"**Delete Key** para eliminar la clave del sistema.",{"_8047":1404,"_22539":1277,"_19069":36592,"_5":22689,"_15331":36245,"_1610":36593},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_8047":1405,"_22539":1277,"_19069":36595,"_5":22689,"_15331":36249,"_1610":36596},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_8047":1406,"_22539":1277,"_19069":36598,"_5":22689,"_15331":36249,"_1610":36599},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_8047":1407,"_22539":1277,"_19069":36601,"_5":22689,"_15331":36249,"_1610":36602},[],"**Key Name**: nombre único y descriptivo.",{"_8047":1408,"_22539":1277,"_19069":36604,"_5":22689,"_15331":36249,"_1610":36605},[],"**Crypto Engine**: motor que custodiará la clave.",{"_8047":1409,"_22539":1277,"_19069":36607,"_5":22689,"_15331":36249,"_1610":36608},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_8047":1410,"_22539":1277,"_19069":36610,"_5":22689,"_15331":36249,"_1610":36611},[],"**Tags**: metadatos para clasificar la clave.",{"_8047":1411,"_22539":1277,"_19069":36613,"_5":22689,"_15331":36249,"_1610":36614},[],"**Metadata**: información adicional para usos avanzados.",{"_8047":1412,"_22539":1277,"_19069":36616,"_5":22689,"_15331":36249,"_1610":36617},[],"Los tipos y tamaños disponibles dependen del motor seleccionado (ver la sección *Algoritmos y tamaños de clave soportados*). Para las claves Ed25519 no es necesario indicar tamaño y para las familias post-cuánticas el tamaño corresponde a la variante del algoritmo.",{"_8047":1413,"_22539":1277,"_19069":36619,"_5":22689,"_15331":36253,"_1610":36620},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_8047":1414,"_22539":1277,"_19069":36622,"_5":22689,"_15331":36253,"_1610":36623},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_8047":1415,"_22539":1277,"_19069":36625,"_5":22689,"_15331":36253,"_1610":36626},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_8047":1416,"_22539":1277,"_19069":36628,"_5":22689,"_15331":36253,"_1610":36629},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_8047":1417,"_22539":1277,"_19069":36631,"_5":22689,"_15331":36253,"_1610":36632},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_8047":1418,"_22539":1277,"_19069":36634,"_5":22689,"_15331":36253,"_1610":36635},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_8047":1419,"_22539":1277,"_19069":36637,"_5":22689,"_15331":36253,"_1610":36638},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_8047":1420,"_22539":1277,"_19069":36640,"_5":22689,"_15331":36253,"_1610":36641},[],"**Tags**: etiquetas para organización y búsqueda.",{"_8047":1421,"_22539":1277,"_19069":36643,"_5":22689,"_15331":36253,"_1610":36644},[],"**Metadata**: información adicional opcional.",{"_8047":1422,"_22539":1277,"_19069":36646,"_5":22689,"_15331":36253,"_1610":36647},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_8047":1423,"_22539":1277,"_19069":36649,"_5":22689,"_15331":36253,"_1610":36650},[],"La clave puede corresponder a cualquiera de los algoritmos soportados por el motor seleccionado, incluidos Ed25519 y los algoritmos post-cuánticos (ML-DSA, SLH-DSA y Composite ML-DSA).",{"_8047":1424,"_22539":1277,"_19069":36652,"_5":22689,"_15331":36253,"_1610":36653},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_8047":1425,"_22539":1277,"_19069":36655,"_5":22689,"_15331":36257,"_1610":36656},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_8047":1426,"_22539":1277,"_19069":36658,"_5":22689,"_15331":36261,"_1610":36659},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_8047":1427,"_22539":1277,"_19069":36661,"_5":22689,"_15331":36261,"_1610":36662},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_8047":1428,"_22539":1277,"_19069":36664,"_5":22689,"_15331":36261,"_1610":36665},[],"**Key Name**: nombre descriptivo.",{"_8047":1429,"_22539":1277,"_19069":36667,"_5":22689,"_15331":36261,"_1610":36668},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_8047":1430,"_22539":1277,"_19069":36670,"_5":22689,"_15331":36261,"_1610":36671},[],"**Tags**: etiquetas asociadas.",{"_8047":1431,"_22539":1277,"_19069":36673,"_5":22689,"_15331":36261,"_1610":36674},[],"**Aliases**: nombres alternativos.",{"_8047":1432,"_22539":1277,"_19069":36676,"_5":22689,"_15331":36261,"_1610":36677},[],"**Crypto Engine**: motor en el que reside la clave.",{"_8047":1433,"_22539":1277,"_19069":36679,"_5":22689,"_15331":36261,"_1610":36680},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_8047":1434,"_22539":1277,"_19069":36682,"_5":22689,"_15331":36261,"_1610":36683},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_8047":1435,"_22539":1277,"_19069":36685,"_5":22689,"_15331":36261,"_1610":36686},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_8047":1436,"_22539":1277,"_19069":36688,"_5":22689,"_15331":36265,"_1610":36689},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_8047":1437,"_22539":1277,"_19069":36691,"_5":22689,"_15331":36265,"_1610":36692},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_8047":1438,"_22539":1277,"_19069":36694,"_5":22689,"_15331":36269,"_1610":36695},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_8047":1439,"_22539":1277,"_19069":36697,"_5":22689,"_15331":36269,"_1610":36698},[],"Campos principales:",{"_8047":1440,"_22539":1277,"_19069":36700,"_5":22689,"_15331":36269,"_1610":36701},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_8047":1441,"_22539":1277,"_19069":36703,"_5":22689,"_15331":36269,"_1610":36704},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_8047":1442,"_22539":1277,"_19069":36706,"_5":22689,"_15331":36269,"_1610":36707},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_8047":1443,"_22539":1277,"_19069":36709,"_5":22689,"_15331":36269,"_1610":36710},[],"**Message**: contenido que se va a firmar.",{"_8047":1444,"_22539":1277,"_19069":36712,"_5":22689,"_15331":36269,"_1610":36713},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_8047":1445,"_22539":1277,"_19069":36715,"_5":22689,"_15331":36269,"_1610":36716},[],"Para las claves Ed25519 y post-cuánticas (ML-DSA, SLH-DSA y Composite ML-DSA), los algoritmos de firma disponibles operan en modo *pure*: firman el mensaje original directamente, sin necesidad de precalcular un *digest*. Por ello, seleccione `Raw` como **Message Type**, ya que el algoritmo opera directamente sobre el contenido recibido. Los algoritmos correspondientes llevan el sufijo `_PURE`, como `MLDSA_65_PURE`, `SLHDSA_PURE`, `COMPOSITE_MLDSA_RSA_PURE` o `Ed25519_PURE`.",{"_8047":1446,"_22539":1277,"_19069":36718,"_5":22689,"_15331":36273,"_1610":36719},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_8047":1447,"_22539":1277,"_19069":36721,"_5":22689,"_15331":36273,"_1610":36698},[],{"_8047":1448,"_22539":1277,"_19069":36723,"_5":22689,"_15331":36273,"_1610":36724},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_8047":1449,"_22539":1277,"_19069":36726,"_5":22689,"_15331":36273,"_1610":36727},[],"**Message Type**: `Raw` o `Digest`.",{"_8047":1450,"_22539":1277,"_19069":36729,"_5":22689,"_15331":36273,"_1610":36730},[],"**Payload Encoding**: codificación del mensaje.",{"_8047":1451,"_22539":1277,"_19069":36732,"_5":22689,"_15331":36273,"_1610":36733},[],"**Message**: mensaje original o hash.",{"_8047":1452,"_22539":1277,"_19069":36735,"_5":22689,"_15331":36273,"_1610":36736},[],"**Signature**: firma que se desea comprobar.",{"_8047":1453,"_22539":1277,"_19069":36738,"_5":22689,"_15331":36273,"_1610":36739},[],"**Result**: indicador del resultado de la validación.",{"_8047":1454,"_22539":1277,"_19069":36741,"_5":22689,"_15331":36277,"_1610":36742},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_8047":1455,"_22539":1277,"_19069":36744,"_5":22689,"_15331":36277,"_1610":36745},[],"Este flujo es útil para:",{"_8047":1456,"_22539":1277,"_19069":36747,"_5":22689,"_15331":36277,"_1610":36748},[],"Solicitar certificados a una CA externa.",{"_8047":1457,"_22539":1277,"_19069":36750,"_5":22689,"_15331":36277,"_1610":36751},[],"Renovar una identidad manteniendo la misma clave.",{"_8047":1458,"_22539":1277,"_19069":36753,"_5":22689,"_15331":36277,"_1610":36754},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_8047":1459,"_22539":1277,"_19069":36756,"_5":22689,"_15331":36277,"_1610":36757},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_8047":1460,"_22539":1277,"_19069":36759,"_5":22689,"_15331":36277,"_1610":36760},[],"**Organization (O)**: organización o empresa.",{"_8047":1461,"_22539":1277,"_19069":36762,"_5":22689,"_15331":36277,"_1610":36763},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_8047":1462,"_22539":1277,"_19069":36765,"_5":22689,"_15331":36277,"_1610":36766},[],"**Country (C)**: código de país de dos letras.",{"_8047":1463,"_22539":1277,"_19069":36768,"_5":22689,"_15331":36277,"_1610":36769},[],"**State / Province (ST)**: estado o provincia.",{"_8047":1464,"_22539":1277,"_19069":36771,"_5":22689,"_15331":36277,"_1610":36772},[],"**Locality (L)**: ciudad o localidad.",{"_8047":1465,"_22539":1277,"_19069":36774,"_5":22689,"_15331":36277,"_1610":36775},[],"**Email Address**: correo de contacto.",{"_8047":1466,"_22539":1277,"_19069":36777,"_5":22689,"_15331":36277,"_1610":36778},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_8047":1467,"_22539":1277,"_19069":36780,"_5":22689,"_15331":36277,"_1610":36781},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_8047":1468,"_22539":1277,"_19069":36783,"_5":22689,"_15331":36281,"_1610":36784},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_8047":1469,"_22539":1277,"_19069":36786,"_5":22689,"_15331":36281,"_1610":36787},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_8047":1470,"_22539":1470,"_5":22684,"_1610":36789,"_22697":36790,"_19069":36791,"_15331":1470},"[DMS] Device Management Service",[32410,33509,33518],[],{"_8047":1471,"_22539":1470,"_19069":36793,"_5":22689,"_15331":1470,"_1610":36794},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_8047":1472,"_22539":1470,"_5":22694,"_19069":36796,"_15331":36797,"_1610":36798},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#device-management-service","Device Management Service",{"_8047":1473,"_22539":1470,"_5":22694,"_19069":36800,"_15331":36801,"_1610":35253},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#antes-de-empezar",{"_8047":1474,"_22539":1470,"_5":22694,"_19069":36803,"_15331":36804,"_1610":36805},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_8047":1475,"_22539":1470,"_5":22694,"_19069":36807,"_15331":36808,"_1610":36809},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_8047":1476,"_22539":1470,"_5":22694,"_19069":36811,"_15331":36812,"_1610":36813},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_8047":1477,"_22539":1470,"_19069":36815,"_5":22689,"_15331":36797,"_1610":36816},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_8047":1478,"_22539":1470,"_19069":36818,"_5":22689,"_15331":36797,"_1610":36819},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_8047":1479,"_22539":1470,"_19069":36821,"_5":22689,"_15331":36801,"_1610":36822},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_8047":1480,"_22539":1470,"_19069":36824,"_5":22689,"_15331":36804,"_1610":36825},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_8047":1481,"_22539":1470,"_19069":36827,"_5":22689,"_15331":36804,"_1610":36828},[],"Acción",{"_8047":1482,"_22539":1470,"_19069":36830,"_5":22689,"_15331":36804,"_1610":32613},[],{"_8047":1483,"_22539":1470,"_19069":36832,"_5":22689,"_15331":36804,"_1610":36833},[],"**Edit**",{"_8047":1484,"_22539":1470,"_19069":36835,"_5":22689,"_15331":36804,"_1610":36836},[],"Modifica la configuración del DMS.",{"_8047":1485,"_22539":1470,"_19069":36838,"_5":22689,"_15331":36804,"_1610":36839},[],"**Go to DMS owned devices**",{"_8047":1486,"_22539":1470,"_19069":36841,"_5":22689,"_15331":36804,"_1610":36842},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_8047":1487,"_22539":1470,"_19069":36844,"_5":22689,"_15331":36804,"_1610":36845},[],"**Show/Edit Metadata**",{"_8047":1488,"_22539":1470,"_19069":36847,"_5":22689,"_15331":36804,"_1610":36848},[],"Accede a los metadatos del DMS para usos avanzados.",{"_8047":1489,"_22539":1470,"_19069":36850,"_5":22689,"_15331":36804,"_1610":36851},[],"**EST (RFC-7030)**",{"_8047":1490,"_22539":1470,"_19069":36853,"_5":22689,"_15331":36804,"_1610":36854},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_8047":1491,"_22539":1470,"_19069":36856,"_5":22689,"_15331":36804,"_1610":36857},[],"**Delete**",{"_8047":1492,"_22539":1470,"_19069":36859,"_5":22689,"_15331":36804,"_1610":36860},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_8047":1493,"_22539":1470,"_19069":36862,"_5":22689,"_15331":36808,"_1610":36863},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_8047":1494,"_22539":1470,"_19069":36865,"_5":22689,"_15331":36808,"_1610":33741},[],{"_8047":1495,"_22539":1470,"_19069":36867,"_5":22689,"_15331":36808,"_1610":32613},[],{"_8047":1496,"_22539":1470,"_19069":36869,"_5":22689,"_15331":36808,"_1610":36870},[],"**Include Lamassu System CA**",{"_8047":1497,"_22539":1470,"_19069":36872,"_5":22689,"_15331":36808,"_1610":36873},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_8047":1498,"_22539":1470,"_19069":36875,"_5":22689,"_15331":36808,"_1610":36876},[],"**Include Enrollment CA**",{"_8047":1499,"_22539":1470,"_19069":36878,"_5":22689,"_15331":36808,"_1610":36879},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_8047":1500,"_22539":1470,"_19069":36881,"_5":22689,"_15331":36808,"_1610":36882},[],"**Managed CAs**",{"_8047":1501,"_22539":1470,"_19069":36884,"_5":22689,"_15331":36808,"_1610":36885},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_8047":1502,"_22539":1470,"_19069":36887,"_5":22689,"_15331":36812,"_1610":36888},[],"El DMS expone un protocolo de enrolamiento a los dispositivos. En la versión actual de Lamassu, el único protocolo soportado es &#x2A;*EST (RFC 7030)**. La configuración del protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_8047":1503,"_22539":1470,"_19069":36890,"_5":22689,"_15331":36812,"_1610":36891},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_8047":1504,"_22539":1470,"_19069":36893,"_5":22689,"_15331":36812,"_1610":36215},[],{"_8047":1505,"_22539":1505,"_5":22684,"_1610":36895,"_22697":36896,"_19069":36897,"_15331":1505},"[VA] Servicio CRL",[32410,33509,33518],[],{"_8047":1506,"_22539":1505,"_19069":36899,"_5":22689,"_15331":1505,"_1610":36900},[],"Gestión y consulta de listas de revocación para validación offline",{"_8047":1507,"_22539":1505,"_5":22694,"_19069":36902,"_15331":36903,"_1610":36904},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_8047":1508,"_22539":1505,"_5":22694,"_19069":36906,"_15331":36907,"_1610":36908},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_8047":1509,"_22539":1505,"_5":22694,"_19069":36910,"_15331":36911,"_1610":36912},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_8047":1510,"_22539":1505,"_5":22694,"_19069":36914,"_15331":36915,"_1610":36916},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_8047":1511,"_22539":1505,"_5":22694,"_19069":36918,"_15331":36919,"_1610":36920},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_8047":1512,"_22539":1505,"_5":22694,"_19069":36922,"_15331":36923,"_1610":36924},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_8047":1513,"_22539":1505,"_5":22694,"_19069":36926,"_15331":36927,"_1610":36928},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_8047":1514,"_22539":1505,"_5":22694,"_19069":36930,"_15331":36931,"_1610":36932},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#referencias","Referencias",{"_8047":1515,"_22539":1505,"_19069":36934,"_5":22689,"_15331":36903,"_1610":36935},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_8047":1516,"_22539":1505,"_19069":36937,"_5":22689,"_15331":36903,"_1610":36938},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_8047":1517,"_22539":1505,"_19069":36940,"_5":22689,"_15331":36907,"_1610":36941},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_8047":1518,"_22539":1505,"_19069":36943,"_5":22689,"_15331":36907,"_1610":36944},[],"Los parámetros principales son:",{"_8047":1519,"_22539":1505,"_19069":36946,"_5":22689,"_15331":36907,"_1610":33741},[],{"_8047":1520,"_22539":1505,"_19069":36948,"_5":22689,"_15331":36907,"_1610":32610},[],{"_8047":1521,"_22539":1505,"_19069":36950,"_5":22689,"_15331":36907,"_1610":32613},[],{"_8047":1522,"_22539":1505,"_19069":36952,"_5":22689,"_15331":36907,"_1610":36953},[],"`validity`",{"_8047":1523,"_22539":1505,"_19069":36955,"_5":22689,"_15331":36907,"_1610":36956},[],"7 días",{"_8047":1524,"_22539":1505,"_19069":36958,"_5":22689,"_15331":36907,"_1610":36959},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_8047":1525,"_22539":1505,"_19069":36961,"_5":22689,"_15331":36907,"_1610":36962},[],"`refresh_interval`",{"_8047":1526,"_22539":1505,"_19069":36964,"_5":22689,"_15331":36907,"_1610":36965},[],"\\~6 días y 23 horas",{"_8047":1527,"_22539":1505,"_19069":36967,"_5":22689,"_15331":36907,"_1610":36968},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_8047":1528,"_22539":1505,"_19069":36970,"_5":22689,"_15331":36907,"_1610":36971},[],"`regenerate_on_revoke`",{"_8047":1529,"_22539":1505,"_19069":36973,"_5":22689,"_15331":36907,"_1610":36974},[],"`true`",{"_8047":1530,"_22539":1505,"_19069":36976,"_5":22689,"_15331":36907,"_1610":36977},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_8047":1531,"_22539":1505,"_19069":36979,"_5":22689,"_15331":36907,"_1610":36980},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_8047":1532,"_22539":1505,"_19069":36982,"_5":22689,"_15331":36907,"_1610":36983},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_8047":1533,"_22539":1505,"_19069":36985,"_5":22689,"_15331":36911,"_1610":36986},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_8047":1534,"_22539":1505,"_19069":36988,"_5":22689,"_15331":36911,"_1610":36989},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_8047":1535,"_22539":1505,"_19069":36991,"_5":22689,"_15331":36915,"_1610":36992},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_8047":1536,"_22539":1505,"_19069":36994,"_5":22689,"_15331":36915,"_1610":36995},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_8047":1537,"_22539":1505,"_19069":36997,"_5":22689,"_15331":36919,"_1610":36998},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_8047":1538,"_22539":1505,"_19069":37000,"_5":22689,"_15331":36919,"_1610":37001},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_8047":1539,"_22539":1505,"_19069":37003,"_5":22689,"_15331":36923,"_1610":37004},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_8047":1540,"_22539":1505,"_19069":37006,"_5":22689,"_15331":36923,"_1610":37007},[],"Método",{"_8047":1541,"_22539":1505,"_19069":37009,"_5":22689,"_15331":36923,"_1610":37010},[],"Ruta",{"_8047":1542,"_22539":1505,"_19069":37012,"_5":22689,"_15331":36923,"_1610":32613},[],{"_8047":1543,"_22539":1505,"_19069":37014,"_5":22689,"_15331":36923,"_1610":37015},[],"`GET`",{"_8047":1544,"_22539":1505,"_19069":37017,"_5":22689,"_15331":36923,"_1610":37018},[],"`/v1/roles/{ca-ski}`",{"_8047":1545,"_22539":1505,"_19069":37020,"_5":22689,"_15331":36923,"_1610":37021},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_8047":1546,"_22539":1505,"_19069":37023,"_5":22689,"_15331":36923,"_1610":37024},[],"`PUT`",{"_8047":1547,"_22539":1505,"_19069":37026,"_5":22689,"_15331":36923,"_1610":37018},[],{"_8047":1548,"_22539":1505,"_19069":37028,"_5":22689,"_15331":36923,"_1610":37029},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_8047":1549,"_22539":1505,"_19069":37031,"_5":22689,"_15331":36923,"_1610":37032},[],"Ejemplo de consulta del rol VA:",{"_8047":1550,"_22539":1505,"_19069":37034,"_5":22689,"_15331":36923,"_1610":37035},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_8047":1551,"_22539":1505,"_19069":37037,"_5":22689,"_15331":36927,"_1610":37038},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_8047":1552,"_22539":1505,"_19069":37040,"_5":22689,"_15331":36931,"_1610":37041},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_8047":1553,"_22539":1505,"_19069":37043,"_5":22689,"_15331":36931,"_1610":37044},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_8047":1554,"_22539":1505,"_19069":37046,"_5":22689,"_15331":36931,"_1610":37047},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_8047":1555,"_22539":1555,"_5":22684,"_1610":37049,"_22697":37050,"_19069":37051,"_15331":1555},"[VA] Servicio OCSP",[32410,33509,33518],[],{"_8047":1556,"_22539":1555,"_19069":37053,"_5":22689,"_15331":1555,"_1610":37054},[],"Validación online del estado de certificados mediante OCSP",{"_8047":1557,"_22539":1555,"_5":22694,"_19069":37056,"_15331":37057,"_1610":37058},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_8047":1558,"_22539":1555,"_5":22694,"_19069":37060,"_15331":37061,"_1610":37062},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_8047":1559,"_22539":1555,"_5":22694,"_19069":37064,"_15331":37065,"_1610":37066},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_8047":1560,"_22539":1555,"_5":22694,"_19069":37068,"_15331":37069,"_1610":37070},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_8047":1561,"_22539":1555,"_5":22694,"_19069":37072,"_15331":37073,"_1610":37074},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_8047":1562,"_22539":1555,"_5":22694,"_19069":37076,"_15331":37077,"_1610":36932},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#referencias",{"_8047":1563,"_22539":1555,"_19069":37079,"_5":22689,"_15331":37057,"_1610":37080},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_8047":1564,"_22539":1555,"_19069":37082,"_5":22689,"_15331":37057,"_1610":37083},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_8047":1565,"_22539":1555,"_19069":37085,"_5":22689,"_15331":37061,"_1610":37086},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_8047":1566,"_22539":1555,"_19069":37088,"_5":22689,"_15331":37061,"_1610":37089},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_8047":1567,"_22539":1555,"_19069":37091,"_5":22689,"_15331":37061,"_1610":37092},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_8047":1568,"_22539":1555,"_19069":37094,"_5":22689,"_15331":37061,"_1610":37095},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_8047":1569,"_22539":1555,"_19069":37097,"_5":22689,"_15331":37061,"_1610":37098},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_8047":1570,"_22539":1555,"_19069":37100,"_5":22689,"_15331":37061,"_1610":37101},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_8047":1571,"_22539":1555,"_19069":37103,"_5":22689,"_15331":37065,"_1610":37104},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_8047":1572,"_22539":1555,"_19069":37106,"_5":22689,"_15331":37069,"_1610":37107},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_8047":1573,"_22539":1555,"_19069":37109,"_5":22689,"_15331":37069,"_1610":37007},[],{"_8047":1574,"_22539":1555,"_19069":37111,"_5":22689,"_15331":37069,"_1610":37010},[],{"_8047":1575,"_22539":1555,"_19069":37113,"_5":22689,"_15331":37069,"_1610":32613},[],{"_8047":1576,"_22539":1555,"_19069":37115,"_5":22689,"_15331":37069,"_1610":37015},[],{"_8047":1577,"_22539":1555,"_19069":37117,"_5":22689,"_15331":37069,"_1610":37118},[],"`/ocsp/{ocsp_request}`",{"_8047":1578,"_22539":1555,"_19069":37120,"_5":22689,"_15331":37069,"_1610":37121},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_8047":1579,"_22539":1555,"_19069":37123,"_5":22689,"_15331":37069,"_1610":37124},[],"`POST`",{"_8047":1580,"_22539":1555,"_19069":37126,"_5":22689,"_15331":37069,"_1610":37127},[],"`/ocsp`",{"_8047":1581,"_22539":1555,"_19069":37129,"_5":22689,"_15331":37069,"_1610":37130},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_8047":1582,"_22539":1555,"_19069":37132,"_5":22689,"_15331":37069,"_1610":37133},[],"Ejemplo de consulta con `curl` mediante POST:",{"_8047":1583,"_22539":1555,"_19069":37135,"_5":22689,"_15331":37069,"_1610":37136},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_8047":1584,"_22539":1555,"_19069":37138,"_5":22689,"_15331":37073,"_1610":37139},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_8047":1585,"_22539":1555,"_19069":37141,"_5":22689,"_15331":37077,"_1610":37142},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_8047":1586,"_22539":1555,"_19069":37144,"_5":22689,"_15331":37077,"_1610":37145},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_8047":1587,"_22539":1555,"_19069":37147,"_5":22689,"_15331":37077,"_1610":37148},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_8047":1588,"_22539":1555,"_19069":37150,"_5":22689,"_15331":37077,"_1610":37047},[],{"_8047":1589,"_22539":1589,"_5":22684,"_1610":37152,"_22697":37153,"_19069":37154,"_15331":1589},"[VA] Validación de Certificados",[32410,33509,33518],[],{"_8047":1590,"_22539":1589,"_19069":37156,"_5":22689,"_15331":1589,"_1610":37157},[],"Servicios OCSP y CRL para validación de certificados",{"_8047":1591,"_22539":1589,"_5":22694,"_19069":37159,"_15331":37160,"_1610":37161},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_8047":1592,"_22539":1589,"_19069":37163,"_5":22689,"_15331":37160,"_1610":37164},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_8047":1593,"_22539":1589,"_19069":37166,"_5":22689,"_15331":37160,"_1610":37167},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_8047":1594,"_22539":1589,"_19069":37169,"_5":22689,"_15331":37160,"_1610":37170},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_8047":1595,"_22539":1589,"_19069":37172,"_5":22689,"_15331":37160,"_1610":37173},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_8047":1596,"_22539":1596,"_5":22684,"_1610":37175,"_19069":37176,"_15331":1596},"Test",[],{"_8047":1597,"_22539":1596,"_19069":37178,"_5":22689,"_15331":1596,"_1610":37179},[],"A document to test Fumadocs",{"_8047":1598,"_22539":1596,"_5":22694,"_19069":37181,"_15331":37182,"_1610":37183