,"/docs/pr-preview/pr-25/despliegue#cloud--aws-ec2--aws-marketplace",{"_5719":28,"_24227":24,"_5":24392,"_20499":35226,"_16438":35227,"_1794":35228},[],"/docs/pr-preview/pr-25/despliegue#saas--basada-en-suscripción","SaaS · Basada en suscripción",{"_5719":29,"_24227":24,"_20499":35230,"_5":24387,"_16438":24,"_1794":35231},[],"Bienvenido a la guía de **Despliegue de Lamassu IoT**. Selecciona la modalidad que mejor se adapta a tu infraestructura.",{"_5719":30,"_24227":24,"_20499":35233,"_5":24387,"_16438":35220,"_1794":35234},[],"<Card title=\"Introducción\" description=\"Requisitos y arquitectura para despliegue en Kubernetes propio\" href=\"/docs/despliegue/onprem\" />",{"_5719":31,"_24227":24,"_20499":35236,"_5":24387,"_16438":35220,"_1794":35237},[],"<Card title=\"Fastlane\" description=\"Despliegue rápido y automatizado con el script Fastlane\" href=\"/docs/despliegue/onprem/fastlane\" />",{"_5719":32,"_24227":24,"_20499":35239,"_5":24387,"_16438":35224,"_1794":35240},[],"<Card title=\"AWS EC2 · AWS Marketplace\" description=\"Lanza Lamassu IoT en AWS con un clic desde el Marketplace\" href=\"/docs/despliegue/cloud\" />",{"_5719":33,"_24227":24,"_20499":35242,"_5":24387,"_16438":35227,"_1794":35243},[],"<Card title=\"SaaS · Suscripción\" description=\"Plataforma totalmente gestionada por LKS Next, sin infraestructura propia\" href=\"/docs/despliegue/saas\" />",{"_5719":34,"_24227":34,"_5":24382,"_1794":35245,"_24395":35246,"_20499":35247,"_16438":34},"Fastlane",[35169,35170,35221],[],{"_5719":35,"_24227":34,"_20499":35249,"_5":24387,"_16438":34,"_1794":35250},[],"Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes",{"_5719":36,"_24227":34,"_5":24392,"_20499":35252,"_16438":35253,"_1794":35254},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#fastlane---despliegue-automatizado-en-kubernetes","Fastlane - Despliegue automatizado en Kubernetes",{"_5719":37,"_24227":34,"_5":24392,"_20499":35256,"_16438":35257,"_1794":35258},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#flags-de-línea-de-comandos","Flags de línea de comandos",{"_5719":38,"_24227":34,"_5":24392,"_20499":35260,"_16438":35261,"_1794":35262},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#detección-de-distribución-kubernetes","Detección de distribución Kubernetes",{"_5719":39,"_24227":34,"_5":24392,"_20499":35264,"_16438":35265,"_1794":35266},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#verificación-de-dependencias","Verificación de dependencias",{"_5719":40,"_24227":34,"_5":24392,"_20499":35268,"_16438":35269,"_1794":35270},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#addons-obligatorios-en-microk8s","Addons obligatorios en MicroK8s",{"_5719":41,"_24227":34,"_5":24392,"_20499":35272,"_16438":35273,"_1794":35274},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-interactivo-vs-no-interactivo","Modo interactivo vs no interactivo",{"_5719":42,"_24227":34,"_5":24392,"_20499":35276,"_16438":35277,"_1794":35278},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-interactivo-por-defecto","Modo interactivo (por defecto)",{"_5719":43,"_24227":34,"_5":24392,"_20499":35280,"_16438":35281,"_1794":35282},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_5719":44,"_24227":34,"_5":24392,"_20499":35284,"_16438":35285,"_1794":35286},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-online-vs-offline","Modo online vs offline",{"_5719":45,"_24227":34,"_5":24392,"_20499":35288,"_16438":35289,"_1794":35290},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_5719":46,"_24227":34,"_5":24392,"_20499":35292,"_16438":35293,"_1794":35294},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-offline","Modo offline",{"_5719":47,"_24227":34,"_5":24392,"_20499":35296,"_16438":35297,"_1794":35298},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#instalación-de-componentes","Instalación de componentes",{"_5719":48,"_24227":34,"_5":24392,"_20499":35300,"_16438":35301,"_1794":35302},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_5719":49,"_24227":34,"_5":24392,"_20499":35304,"_16438":35305,"_1794":35306},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_5719":50,"_24227":34,"_5":24392,"_20499":35308,"_16438":35309,"_1794":35310},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_5719":51,"_24227":34,"_5":24392,"_20499":35312,"_16438":35313,"_1794":35314},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_5719":52,"_24227":34,"_5":24392,"_20499":35316,"_16438":35317,"_1794":35318},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#configuración-tls","Configuración TLS",{"_5719":53,"_24227":34,"_5":24392,"_20499":35320,"_16438":35321,"_1794":35322},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#certificado-externo","Certificado externo",{"_5719":54,"_24227":34,"_5":24392,"_20499":35324,"_16438":35325,"_1794":35326},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_5719":55,"_24227":34,"_5":24392,"_20499":35328,"_16438":35329,"_1794":35330},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_5719":56,"_24227":34,"_5":24392,"_20499":35332,"_16438":35333,"_1794":35334},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#uso-en-ci","Uso en CI",{"_5719":57,"_24227":34,"_5":24392,"_20499":35336,"_16438":35337,"_1794":35338},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#ejemplo-rápido","Ejemplo rápido",{"_5719":58,"_24227":34,"_5":24392,"_20499":35340,"_16438":35341,"_1794":35342},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#resumen","Resumen",{"_5719":59,"_24227":34,"_20499":35344,"_5":24387,"_16438":35253,"_1794":35345},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_5719":60,"_24227":34,"_20499":35347,"_5":24387,"_16438":35253,"_1794":35348},[],"La instalación incluye:",{"_5719":61,"_24227":34,"_20499":35350,"_5":24387,"_16438":35253,"_1794":35351},[],"PostgreSQL",{"_5719":62,"_24227":34,"_20499":35353,"_5":24387,"_16438":35253,"_1794":35354},[],"Keycloak",{"_5719":63,"_24227":34,"_20499":35356,"_5":24387,"_16438":35253,"_1794":35357},[],"RabbitMQ",{"_5719":64,"_24227":34,"_20499":35359,"_5":24387,"_16438":35253,"_1794":35360},[],"Chart Helm de Lamassu",{"_5719":65,"_24227":34,"_20499":35362,"_5":24387,"_16438":35257,"_1794":35363},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_5719":66,"_24227":34,"_20499":35365,"_5":24387,"_16438":35257,"_1794":35366},[],"Flag",{"_5719":67,"_24227":34,"_20499":35368,"_5":24387,"_16438":35257,"_1794":35369},[],"Valor por defecto",{"_5719":68,"_24227":34,"_20499":35371,"_5":24387,"_16438":35257,"_1794":35372},[],"Descripción",{"_5719":69,"_24227":34,"_20499":35374,"_5":24387,"_16438":35257,"_1794":35375},[],"`-h`, `--help`",{"_5719":70,"_24227":34,"_20499":35377,"_5":24387,"_16438":35257,"_1794":3388},[],{"_5719":71,"_24227":34,"_20499":35379,"_5":24387,"_16438":35257,"_1794":35380},[],"Muestra la ayuda y finaliza",{"_5719":72,"_24227":34,"_20499":35382,"_5":24387,"_16438":35257,"_1794":35383},[],"`-n`, `--non-interactive`",{"_5719":73,"_24227":34,"_20499":35385,"_5":24387,"_16438":35257,"_1794":35386},[],"`false`",{"_5719":74,"_24227":34,"_20499":35388,"_5":24387,"_16438":35257,"_1794":35389},[],"Omite prompts y genera/usa credenciales por defecto",{"_5719":75,"_24227":34,"_20499":35391,"_5":24387,"_16438":35257,"_1794":35392},[],"`-ns`, `--namespace`",{"_5719":76,"_24227":34,"_20499":35394,"_5":24387,"_16438":35257,"_1794":35395},[],"`lamassu-dev`",{"_5719":77,"_24227":34,"_20499":35397,"_5":24387,"_16438":35257,"_1794":35398},[],"Namespace Kubernetes donde se despliegan los recursos",{"_5719":78,"_24227":34,"_20499":35400,"_5":24387,"_16438":35257,"_1794":35401},[],"`-d`, `--domain`",{"_5719":79,"_24227":34,"_20499":35403,"_5":24387,"_16438":35257,"_1794":35404},[],"`dev.lamassu.io`",{"_5719":80,"_24227":34,"_20499":35406,"_5":24387,"_16438":35257,"_1794":35407},[],"Dominio usado para endpoint y certificados TLS",{"_5719":81,"_24227":34,"_20499":35409,"_5":24387,"_16438":35257,"_1794":35410},[],"`-v`, `--version`",{"_5719":82,"_24227":34,"_20499":35412,"_5":24387,"_16438":35257,"_1794":35413},[],"`latest`",{"_5719":83,"_24227":34,"_20499":35415,"_5":24387,"_16438":35257,"_1794":35416},[],"Versión del chart Helm de Lamassu",{"_5719":84,"_24227":34,"_20499":35418,"_5":24387,"_16438":35257,"_1794":35419},[],"`--https-port`",{"_5719":85,"_24227":34,"_20499":35421,"_5":24387,"_16438":35257,"_1794":35422},[],"`443`",{"_5719":86,"_24227":34,"_20499":35424,"_5":24387,"_16438":35257,"_1794":35425},[],"Puerto HTTPS del gateway",{"_5719":87,"_24227":34,"_20499":35427,"_5":24387,"_16438":35257,"_1794":35428},[],"`--http-port`",{"_5719":88,"_24227":34,"_20499":35430,"_5":24387,"_16438":35257,"_1794":35431},[],"`80`",{"_5719":89,"_24227":34,"_20499":35433,"_5":24387,"_16438":35257,"_1794":35434},[],"Puerto HTTP del gateway",{"_5719":90,"_24227":34,"_20499":35436,"_5":24387,"_16438":35257,"_1794":35437},[],"`--offline`",{"_5719":91,"_24227":34,"_20499":35439,"_5":24387,"_16438":35257,"_1794":35386},[],{"_5719":92,"_24227":34,"_20499":35441,"_5":24387,"_16438":35257,"_1794":35442},[],"Activa modo offline",{"_5719":93,"_24227":34,"_20499":35444,"_5":24387,"_16438":35257,"_1794":35445},[],"`--tls-crt`",{"_5719":94,"_24227":34,"_20499":35447,"_5":24387,"_16438":35257,"_1794":3388},[],{"_5719":95,"_24227":34,"_20499":35449,"_5":24387,"_16438":35257,"_1794":35450},[],"Ruta al certificado TLS (PEM)",{"_5719":96,"_24227":34,"_20499":35452,"_5":24387,"_16438":35257,"_1794":35453},[],"`--tls-key`",{"_5719":97,"_24227":34,"_20499":35455,"_5":24387,"_16438":35257,"_1794":3388},[],{"_5719":98,"_24227":34,"_20499":35457,"_5":24387,"_16438":35257,"_1794":35458},[],"Ruta a la clave privada TLS (PEM)",{"_5719":99,"_24227":34,"_20499":35460,"_5":24387,"_16438":35257,"_1794":35461},[],"`--helm-chart-lamassu`",{"_5719":100,"_24227":34,"_20499":35463,"_5":24387,"_16438":35257,"_1794":3388},[],{"_5719":101,"_24227":34,"_20499":35465,"_5":24387,"_16438":35257,"_1794":35466},[],"Ruta a chart local Lamassu (`.tgz`)",{"_5719":102,"_24227":34,"_20499":35468,"_5":24387,"_16438":35257,"_1794":35469},[],"`--helm-chart-postgres`",{"_5719":103,"_24227":34,"_20499":35471,"_5":24387,"_16438":35257,"_1794":3388},[],{"_5719":104,"_24227":34,"_20499":35473,"_5":24387,"_16438":35257,"_1794":35474},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_5719":105,"_24227":34,"_20499":35476,"_5":24387,"_16438":35257,"_1794":35477},[],"`--helm-chart-keycloak`",{"_5719":106,"_24227":34,"_20499":35479,"_5":24387,"_16438":35257,"_1794":3388},[],{"_5719":107,"_24227":34,"_20499":35481,"_5":24387,"_16438":35257,"_1794":35482},[],"Ruta a chart local Keycloak (`.tgz`)",{"_5719":108,"_24227":34,"_20499":35484,"_5":24387,"_16438":35257,"_1794":35485},[],"`--helm-chart-rabbitmq`",{"_5719":109,"_24227":34,"_20499":35487,"_5":24387,"_16438":35257,"_1794":3388},[],{"_5719":110,"_24227":34,"_20499":35489,"_5":24387,"_16438":35257,"_1794":35490},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_5719":111,"_24227":34,"_20499":35492,"_5":24387,"_16438":35257,"_1794":35493},[],"`-l`, `--local-chart-path`",{"_5719":112,"_24227":34,"_20499":35495,"_5":24387,"_16438":35257,"_1794":3388},[],{"_5719":113,"_24227":34,"_20499":35497,"_5":24387,"_16438":35257,"_1794":35498},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_5719":114,"_24227":34,"_20499":35500,"_5":24387,"_16438":35261,"_1794":35501},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_5719":115,"_24227":34,"_20499":35503,"_5":24387,"_16438":35261,"_1794":35504},[],"`microk8s`",{"_5719":116,"_24227":34,"_20499":35506,"_5":24387,"_16438":35261,"_1794":35507},[],"`k3s`",{"_5719":117,"_24227":34,"_20499":35509,"_5":24387,"_16438":35261,"_1794":35510},[],"`kind`",{"_5719":118,"_24227":34,"_20499":35512,"_5":24387,"_16438":35261,"_1794":35513},[],"Kubernetes estándar",{"_5719":119,"_24227":34,"_20499":35515,"_5":24387,"_16438":35261,"_1794":35516},[],"Comportamientos específicos:",{"_5719":120,"_24227":34,"_20499":35518,"_5":24387,"_16438":35261,"_1794":35519},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_5719":121,"_24227":34,"_20499":35521,"_5":24387,"_16438":35261,"_1794":35522},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_5719":122,"_24227":34,"_20499":35524,"_5":24387,"_16438":35265,"_1794":35525},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_5719":123,"_24227":34,"_20499":35527,"_5":24387,"_16438":35265,"_1794":35528},[],"Requisitos generales:",{"_5719":124,"_24227":34,"_20499":35530,"_5":24387,"_16438":35265,"_1794":35531},[],"`yq`",{"_5719":125,"_24227":34,"_20499":35533,"_5":24387,"_16438":35265,"_1794":35534},[],"CLI de la distribución detectada",{"_5719":126,"_24227":34,"_20499":35536,"_5":24387,"_16438":35265,"_1794":35537},[],"Requisitos específicos:",{"_5719":127,"_24227":34,"_20499":35539,"_5":24387,"_16438":35265,"_1794":35540},[],"Distribución",{"_5719":128,"_24227":34,"_20499":35542,"_5":24387,"_16438":35265,"_1794":35543},[],"Herramientas requeridas",{"_5719":129,"_24227":34,"_20499":35545,"_5":24387,"_16438":35265,"_1794":35507},[],{"_5719":130,"_24227":34,"_20499":35547,"_5":24387,"_16438":35265,"_1794":35548},[],"`kubectl`, `helm`",{"_5719":131,"_24227":34,"_20499":35550,"_5":24387,"_16438":35265,"_1794":35504},[],{"_5719":132,"_24227":34,"_20499":35552,"_5":24387,"_16438":35265,"_1794":35553},[],"`microk8s kubectl`, `microk8s helm`",{"_5719":133,"_24227":34,"_20499":35555,"_5":24387,"_16438":35269,"_1794":35556},[],"Se valida que estén habilitados:",{"_5719":134,"_24227":34,"_20499":35558,"_5":24387,"_16438":35269,"_1794":35559},[],"`helm`",{"_5719":135,"_24227":34,"_20499":35561,"_5":24387,"_16438":35269,"_1794":35562},[],"`hostpath-storage`",{"_5719":136,"_24227":34,"_20499":35564,"_5":24387,"_16438":35269,"_1794":35565},[],"`dns`",{"_5719":137,"_24227":34,"_20499":35567,"_5":24387,"_16438":35269,"_1794":35568},[],"`cert-manager`",{"_5719":138,"_24227":34,"_20499":35570,"_5":24387,"_16438":35269,"_1794":35571},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_5719":139,"_24227":34,"_20499":35573,"_5":24387,"_16438":35277,"_1794":35574},[],"La función `request_config_data` solicita:",{"_5719":140,"_24227":34,"_20499":35576,"_5":24387,"_16438":35277,"_1794":35577},[],"Dominio Lamassu",{"_5719":141,"_24227":34,"_20499":35579,"_5":24387,"_16438":35277,"_1794":35580},[],"Usuario y contraseña admin PostgreSQL",{"_5719":142,"_24227":34,"_20499":35582,"_5":24387,"_16438":35277,"_1794":35583},[],"Usuario y contraseña admin RabbitMQ",{"_5719":143,"_24227":34,"_20499":35585,"_5":24387,"_16438":35277,"_1794":35586},[],"Usuario y contraseña admin Keycloak",{"_5719":144,"_24227":34,"_20499":35588,"_5":24387,"_16438":35277,"_1794":35589},[],"Namespace Kubernetes",{"_5719":145,"_24227":34,"_20499":35591,"_5":24387,"_16438":35281,"_1794":35592},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_5719":146,"_24227":34,"_20499":35594,"_5":24387,"_16438":35281,"_1794":35595},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_5719":147,"_24227":34,"_20499":35597,"_5":24387,"_16438":35285,"_1794":35598},[],"El script admite dos estrategias para obtener charts Helm.",{"_5719":148,"_24227":34,"_20499":35600,"_5":24387,"_16438":35289,"_1794":35601},[],"Los charts se descargan desde repositorios remotos.",{"_5719":149,"_24227":34,"_20499":35603,"_5":24387,"_16438":35293,"_1794":35604},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_5719":150,"_24227":34,"_20499":35606,"_5":24387,"_16438":35293,"_1794":35461},[],{"_5719":151,"_24227":34,"_20499":35608,"_5":24387,"_16438":35293,"_1794":35469},[],{"_5719":152,"_24227":34,"_20499":35610,"_5":24387,"_16438":35293,"_1794":35477},[],{"_5719":153,"_24227":34,"_20499":35612,"_5":24387,"_16438":35293,"_1794":35485},[],{"_5719":154,"_24227":34,"_20499":35614,"_5":24387,"_16438":35293,"_1794":35615},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_5719":155,"_24227":34,"_20499":35617,"_5":24387,"_16438":35293,"_1794":35618},[],"En este modo se fuerza:",{"_5719":156,"_24227":34,"_20499":35620,"_5":24387,"_16438":35301,"_1794":35621},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_5719":157,"_24227":34,"_20499":35623,"_5":24387,"_16438":35301,"_1794":35624},[],"Versión del chart: `0.19.0`",{"_5719":158,"_24227":34,"_20499":35626,"_5":24387,"_16438":35301,"_1794":35627},[],"Release: `postgres`",{"_5719":159,"_24227":34,"_20499":35629,"_5":24387,"_16438":35301,"_1794":35630},[],"`fullnameOverride: \"postgresql\"`",{"_5719":160,"_24227":34,"_20499":35632,"_5":24387,"_16438":35301,"_1794":35633},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_5719":161,"_24227":34,"_20499":35635,"_5":24387,"_16438":35301,"_1794":35636},[],"Base de datos",{"_5719":162,"_24227":34,"_20499":35638,"_5":24387,"_16438":35301,"_1794":35639},[],"Servicio",{"_5719":163,"_24227":34,"_20499":35641,"_5":24387,"_16438":35301,"_1794":35642},[],"`auth`",{"_5719":164,"_24227":34,"_20499":35644,"_5":24387,"_16438":35301,"_1794":35354},[],{"_5719":165,"_24227":34,"_20499":35646,"_5":24387,"_16438":35301,"_1794":35647},[],"`alerts`",{"_5719":166,"_24227":34,"_20499":35649,"_5":24387,"_16438":35301,"_1794":35650},[],"Alerts",{"_5719":167,"_24227":34,"_20499":35652,"_5":24387,"_16438":35301,"_1794":35653},[],"`ca`",{"_5719":168,"_24227":34,"_20499":35655,"_5":24387,"_16438":35301,"_1794":35656},[],"CA",{"_5719":169,"_24227":34,"_20499":35658,"_5":24387,"_16438":35301,"_1794":35659},[],"`va`",{"_5719":170,"_24227":34,"_20499":35661,"_5":24387,"_16438":35301,"_1794":35662},[],"VA",{"_5719":171,"_24227":34,"_20499":35664,"_5":24387,"_16438":35301,"_1794":35665},[],"`cloudproxy`",{"_5719":172,"_24227":34,"_20499":35667,"_5":24387,"_16438":35301,"_1794":35668},[],"Cloud Proxy",{"_5719":173,"_24227":34,"_20499":35670,"_5":24387,"_16438":35301,"_1794":35671},[],"`devicemanager`",{"_5719":174,"_24227":34,"_20499":35673,"_5":24387,"_16438":35301,"_1794":35674},[],"Device Manager",{"_5719":175,"_24227":34,"_20499":35676,"_5":24387,"_16438":35301,"_1794":35677},[],"`dmsmanager`",{"_5719":176,"_24227":34,"_20499":35679,"_5":24387,"_16438":35301,"_1794":35680},[],"DMS Manager",{"_5719":177,"_24227":34,"_20499":35682,"_5":24387,"_16438":35301,"_1794":35683},[],"`kms`",{"_5719":178,"_24227":34,"_20499":35685,"_5":24387,"_16438":35301,"_1794":35686},[],"KMS",{"_5719":179,"_24227":34,"_20499":35688,"_5":24387,"_16438":35305,"_1794":35689},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_5719":180,"_24227":34,"_20499":35691,"_5":24387,"_16438":35305,"_1794":35692},[],"Versión del chart: `0.20.0`",{"_5719":181,"_24227":34,"_20499":35694,"_5":24387,"_16438":35305,"_1794":35695},[],"Release: `auth`",{"_5719":182,"_24227":34,"_20499":35697,"_5":24387,"_16438":35305,"_1794":35698},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_5719":183,"_24227":34,"_20499":35700,"_5":24387,"_16438":35305,"_1794":35701},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_5719":184,"_24227":34,"_20499":35703,"_5":24387,"_16438":35305,"_1794":35704},[],"`httpRelativePath: /auth/`",{"_5719":185,"_24227":34,"_20499":35706,"_5":24387,"_16438":35305,"_1794":35707},[],"`proxyHeaders: xforwarded`",{"_5719":186,"_24227":34,"_20499":35709,"_5":24387,"_16438":35305,"_1794":35710},[],"Configuración automática del realm `lamassu`:",{"_5719":187,"_24227":34,"_20499":35712,"_5":24387,"_16438":35305,"_1794":35713},[],"Rol: `pki-admin`",{"_5719":188,"_24227":34,"_20499":35715,"_5":24387,"_16438":35305,"_1794":35716},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_5719":189,"_24227":34,"_20499":35718,"_5":24387,"_16438":35305,"_1794":35719},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_5719":190,"_24227":34,"_20499":35721,"_5":24387,"_16438":35305,"_1794":35722},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_5719":191,"_24227":34,"_20499":35724,"_5":24387,"_16438":35305,"_1794":35725},[],"`github.com/lamassuiot/keycloak-theme`",{"_5719":192,"_24227":34,"_20499":35727,"_5":24387,"_16438":35309,"_1794":35728},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_5719":193,"_24227":34,"_20499":35730,"_5":24387,"_16438":35309,"_1794":35692},[],{"_5719":194,"_24227":34,"_20499":35732,"_5":24387,"_16438":35309,"_1794":35733},[],"Release: `rabbitmq`",{"_5719":195,"_24227":34,"_20499":35735,"_5":24387,"_16438":35309,"_1794":35736},[],"`fullnameOverride: \"rabbitmq\"`",{"_5719":196,"_24227":34,"_20499":35738,"_5":24387,"_16438":35309,"_1794":35739},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_5719":197,"_24227":34,"_20499":35741,"_5":24387,"_16438":35313,"_1794":35742},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_5719":198,"_24227":34,"_20499":35744,"_5":24387,"_16438":35313,"_1794":35745},[],"Configuraciones principales:",{"_5719":199,"_24227":34,"_20499":35747,"_5":24387,"_16438":35313,"_1794":35748},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_5719":200,"_24227":34,"_20499":35750,"_5":24387,"_16438":35313,"_1794":35751},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_5719":201,"_24227":34,"_20499":35753,"_5":24387,"_16438":35313,"_1794":35754},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_5719":202,"_24227":34,"_20499":35756,"_5":24387,"_16438":35313,"_1794":35757},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_5719":203,"_24227":34,"_20499":35759,"_5":24387,"_16438":35313,"_1794":35760},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_5719":204,"_24227":34,"_20499":35762,"_5":24387,"_16438":35313,"_1794":35763},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_5719":205,"_24227":34,"_20499":35765,"_5":24387,"_16438":35313,"_1794":35766},[],"Dominios CA: valor de `--domain`",{"_5719":206,"_24227":34,"_20499":35768,"_5":24387,"_16438":35313,"_1794":35769},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_5719":207,"_24227":34,"_20499":35771,"_5":24387,"_16438":35313,"_1794":35772},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_5719":208,"_24227":34,"_20499":35774,"_5":24387,"_16438":35313,"_1794":35775},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_5719":209,"_24227":34,"_20499":35777,"_5":24387,"_16438":35321,"_1794":35778},[],"Si se proporcionan:",{"_5719":210,"_24227":34,"_20499":35780,"_5":24387,"_16438":35321,"_1794":35445},[],{"_5719":211,"_24227":34,"_20499":35782,"_5":24387,"_16438":35321,"_1794":35453},[],{"_5719":212,"_24227":34,"_20499":35784,"_5":24387,"_16438":35321,"_1794":35785},[],"Se crea un secret Kubernetes:",{"_5719":213,"_24227":34,"_20499":35787,"_5":24387,"_16438":35321,"_1794":35788},[],"`downstream-provided-crt`",{"_5719":214,"_24227":34,"_20499":35790,"_5":24387,"_16438":35321,"_1794":35791},[],"Y se configura:",{"_5719":215,"_24227":34,"_20499":35793,"_5":24387,"_16438":35325,"_1794":35794},[],"Si no se proporciona certificado:",{"_5719":216,"_24227":34,"_20499":35796,"_5":24387,"_16438":35325,"_1794":35797},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_5719":217,"_24227":34,"_20499":35799,"_5":24387,"_16438":35325,"_1794":35800},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_5719":218,"_24227":34,"_20499":35802,"_5":24387,"_16438":35329,"_1794":35803},[],"En caso de éxito, se muestra:",{"_5719":219,"_24227":34,"_20499":35805,"_5":24387,"_16438":35329,"_1794":35806},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_5719":220,"_24227":34,"_20499":35808,"_5":24387,"_16438":35329,"_1794":35809},[],"Credenciales iniciales: `lamassu / lamassu`",{"_5719":221,"_24227":34,"_20499":35811,"_5":24387,"_16438":35329,"_1794":35812},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_5719":222,"_24227":34,"_20499":35814,"_5":24387,"_16438":35329,"_1794":35815},[],"Credenciales admin de Keycloak",{"_5719":223,"_24227":34,"_20499":35817,"_5":24387,"_16438":35329,"_1794":35818},[],"El usuario `lamassu` se crea con:",{"_5719":224,"_24227":34,"_20499":35820,"_5":24387,"_16438":35329,"_1794":35821},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_5719":225,"_24227":34,"_20499":35823,"_5":24387,"_16438":35333,"_1794":35824},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_5719":226,"_24227":34,"_20499":35826,"_5":24387,"_16438":35333,"_1794":35827},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_5719":227,"_24227":34,"_20499":35829,"_5":24387,"_16438":35333,"_1794":35830},[],"Ejemplo:",{"_5719":228,"_24227":34,"_20499":35832,"_5":24387,"_16438":35333,"_1794":35833},[],"En este escenario:",{"_5719":229,"_24227":34,"_20499":35835,"_5":24387,"_16438":35333,"_1794":35836},[],"`-n`: modo no interactivo",{"_5719":230,"_24227":34,"_20499":35838,"_5":24387,"_16438":35333,"_1794":35839},[],"`-ns`: namespace específico",{"_5719":231,"_24227":34,"_20499":35841,"_5":24387,"_16438":35333,"_1794":35842},[],"`-d`: dominio de CI",{"_5719":232,"_24227":34,"_20499":35844,"_5":24387,"_16438":35333,"_1794":35845},[],"`-l`: chart local",{"_5719":233,"_24227":34,"_20499":35847,"_5":24387,"_16438":35341,"_1794":35848},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_5719":234,"_24227":34,"_20499":35850,"_5":24387,"_16438":35341,"_1794":35851},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_5719":235,"_24227":235,"_5":24382,"_1794":35853,"_24395":35854,"_20499":35855,"_16438":235},"Introducción",[35169,35170,35221],[],{"_5719":236,"_24227":235,"_20499":35857,"_5":24387,"_16438":235,"_1794":35858},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_5719":237,"_24227":235,"_5":24392,"_20499":35860,"_16438":35861,"_1794":35862},[],"/docs/pr-preview/pr-25/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_5719":238,"_24227":235,"_5":24392,"_20499":35864,"_16438":35865,"_1794":35866},[],"/docs/pr-preview/pr-25/despliegue/onprem#quickstart","Quickstart",{"_5719":239,"_24227":235,"_5":24392,"_20499":35868,"_16438":35869,"_1794":35870},[],"/docs/pr-preview/pr-25/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_5719":240,"_24227":235,"_5":24392,"_20499":35872,"_16438":35873,"_1794":35874},[],"/docs/pr-preview/pr-25/despliegue/onprem#requisitos-previos","Requisitos previos",{"_5719":241,"_24227":235,"_5":24392,"_20499":35876,"_16438":35877,"_1794":35878},[],"/docs/pr-preview/pr-25/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_5719":242,"_24227":235,"_5":24392,"_20499":35880,"_16438":35881,"_1794":35882},[],"/docs/pr-preview/pr-25/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_5719":243,"_24227":235,"_5":24392,"_20499":35884,"_16438":35885,"_1794":35886},[],"/docs/pr-preview/pr-25/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_5719":244,"_24227":235,"_5":24392,"_20499":35888,"_16438":35889,"_1794":35890},[],"/docs/pr-preview/pr-25/despliegue/onprem#arquitectura","Arquitectura",{"_5719":245,"_24227":235,"_5":24392,"_20499":35892,"_16438":35893,"_1794":35894},[],"/docs/pr-preview/pr-25/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_5719":246,"_24227":235,"_5":24392,"_20499":35896,"_16438":35897,"_1794":35898},[],"/docs/pr-preview/pr-25/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_5719":247,"_24227":235,"_5":24392,"_20499":35900,"_16438":35901,"_1794":35902},[],"/docs/pr-preview/pr-25/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_5719":248,"_24227":235,"_5":24392,"_20499":35904,"_16438":35905,"_1794":35906},[],"/docs/pr-preview/pr-25/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_5719":249,"_24227":235,"_5":24392,"_20499":35908,"_16438":35909,"_1794":35910},[],"/docs/pr-preview/pr-25/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_5719":250,"_24227":235,"_5":24392,"_20499":35912,"_16438":35913,"_1794":35914},[],"/docs/pr-preview/pr-25/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_5719":251,"_24227":235,"_5":24392,"_20499":35916,"_16438":35917,"_1794":35918},[],"/docs/pr-preview/pr-25/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_5719":252,"_24227":235,"_20499":35920,"_5":24387,"_16438":35861,"_1794":35921},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_5719":253,"_24227":235,"_20499":35923,"_5":24387,"_16438":35861,"_1794":35924},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_5719":254,"_24227":235,"_20499":35926,"_5":24387,"_16438":35861,"_1794":35927},[],"el chart principal de Lamassu",{"_5719":255,"_24227":235,"_20499":35929,"_5":24387,"_16438":35861,"_1794":35930},[],"un chart auxiliar de SoftHSM",{"_5719":256,"_24227":235,"_20499":35932,"_5":24387,"_16438":35861,"_1794":35933},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_5719":257,"_24227":235,"_20499":35935,"_5":24387,"_16438":35865,"_1794":35936},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_5719":258,"_24227":235,"_20499":35938,"_5":24387,"_16438":35865,"_1794":35939},[],"Ese flujo:",{"_5719":259,"_24227":235,"_20499":35941,"_5":24387,"_16438":35865,"_1794":35942},[],"crea o reutiliza el namespace indicado",{"_5719":260,"_24227":235,"_20499":35944,"_5":24387,"_16438":35865,"_1794":35945},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_5719":261,"_24227":235,"_20499":35947,"_5":24387,"_16438":35865,"_1794":35948},[],"despliega el chart de Lamassu",{"_5719":262,"_24227":235,"_20499":35950,"_5":24387,"_16438":35865,"_1794":35951},[],"deja la UI expuesta en `https://<dominio>`",{"_5719":263,"_24227":235,"_20499":35953,"_5":24387,"_16438":35865,"_1794":35954},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_5719":264,"_24227":235,"_20499":35956,"_5":24387,"_16438":35869,"_1794":35957},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_5719":265,"_24227":235,"_20499":35959,"_5":24387,"_16438":35869,"_1794":35960},[],"`ui`",{"_5719":266,"_24227":235,"_20499":35962,"_5":24387,"_16438":35869,"_1794":35653},[],{"_5719":267,"_24227":235,"_20499":35964,"_5":24387,"_16438":35869,"_1794":35659},[],{"_5719":268,"_24227":235,"_20499":35966,"_5":24387,"_16438":35869,"_1794":35683},[],{"_5719":269,"_24227":235,"_20499":35968,"_5":24387,"_16438":35869,"_1794":35969},[],"`device-manager`",{"_5719":270,"_24227":235,"_20499":35971,"_5":24387,"_16438":35869,"_1794":35972},[],"`dms-manager`",{"_5719":271,"_24227":235,"_20499":35974,"_5":24387,"_16438":35869,"_1794":35647},[],{"_5719":272,"_24227":235,"_20499":35976,"_5":24387,"_16438":35869,"_1794":35977},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_5719":273,"_24227":235,"_20499":35979,"_5":24387,"_16438":35869,"_1794":35980},[],"job de migraciones de base de datos",{"_5719":274,"_24227":235,"_20499":35982,"_5":24387,"_16438":35873,"_1794":35983},[],"Clúster Kubernetes `1.19+`",{"_5719":275,"_24227":235,"_20499":35985,"_5":24387,"_16438":35873,"_1794":35986},[],"`kubectl` configurado con acceso al clúster",{"_5719":276,"_24227":235,"_20499":35988,"_5":24387,"_16438":35873,"_1794":35989},[],"Helm `3.2.0+`",{"_5719":277,"_24227":235,"_20499":35991,"_5":24387,"_16438":35873,"_1794":35992},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_5719":278,"_24227":235,"_20499":35994,"_5":24387,"_16438":35873,"_1794":35995},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_5719":279,"_24227":235,"_20499":35997,"_5":24387,"_16438":35873,"_1794":35998},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_5719":280,"_24227":235,"_20499":36000,"_5":24387,"_16438":35873,"_1794":36001},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_5719":281,"_24227":235,"_20499":36003,"_5":24387,"_16438":35877,"_1794":36004},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_5719":282,"_24227":235,"_20499":36006,"_5":24387,"_16438":35881,"_1794":36007},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_5719":283,"_24227":235,"_20499":36009,"_5":24387,"_16438":35885,"_1794":36010},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_5719":284,"_24227":235,"_20499":36012,"_5":24387,"_16438":35889,"_1794":36013},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_5719":285,"_24227":235,"_20499":36015,"_5":24387,"_16438":35889,"_1794":36016},[],"Dependencias externas requeridas por el chart principal:",{"_5719":286,"_24227":235,"_20499":36018,"_5":24387,"_16438":35889,"_1794":35351},[],{"_5719":287,"_24227":235,"_20499":36020,"_5":24387,"_16438":35889,"_1794":35357},[],{"_5719":288,"_24227":235,"_20499":36022,"_5":24387,"_16438":35889,"_1794":36023},[],"proveedor OIDC, típicamente Keycloak",{"_5719":289,"_24227":235,"_20499":36025,"_5":24387,"_16438":35889,"_1794":36026},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_5719":290,"_24227":235,"_20499":36028,"_5":24387,"_16438":35893,"_1794":36029},[],"Agregar el repositorio Helm:",{"_5719":291,"_24227":235,"_20499":36031,"_5":24387,"_16438":35893,"_1794":36032},[],"O instalar desde una copia local del repositorio:",{"_5719":292,"_24227":235,"_20499":36034,"_5":24387,"_16438":35897,"_1794":36035},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_5719":293,"_24227":235,"_20499":36037,"_5":24387,"_16438":35897,"_1794":36038},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_5719":294,"_24227":235,"_20499":36040,"_5":24387,"_16438":35897,"_1794":36041},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_5719":295,"_24227":235,"_20499":36043,"_5":24387,"_16438":35897,"_1794":36044},[],"`auth.oidc.frontend.authority`",{"_5719":296,"_24227":235,"_20499":36046,"_5":24387,"_16438":35897,"_1794":36047},[],"`auth.oidc.apiGateway.jwks`",{"_5719":297,"_24227":235,"_20499":36049,"_5":24387,"_16438":35897,"_1794":36050},[],"`services.ca.domains`",{"_5719":298,"_24227":235,"_20499":36052,"_5":24387,"_16438":35897,"_1794":36053},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_5719":299,"_24227":235,"_20499":36055,"_5":24387,"_16438":35897,"_1794":36056},[],"`tls.*` según se use `certManager` o certificado externo",{"_5719":300,"_24227":235,"_20499":36058,"_5":24387,"_16438":35897,"_1794":36059},[],"Ejemplo base:",{"_5719":301,"_24227":235,"_20499":36061,"_5":24387,"_16438":35901,"_1794":36062},[],"Área",{"_5719":302,"_24227":235,"_20499":36064,"_5":24387,"_16438":35901,"_1794":36065},[],"Valores clave",{"_5719":303,"_24227":235,"_20499":36067,"_5":24387,"_16438":35901,"_1794":36068},[],"Uso",{"_5719":304,"_24227":235,"_20499":36070,"_5":24387,"_16438":35901,"_1794":36071},[],"TLS",{"_5719":305,"_24227":235,"_20499":36073,"_5":24387,"_16438":35901,"_1794":36074},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_5719":306,"_24227":235,"_20499":36076,"_5":24387,"_16438":35901,"_1794":36077},[],"Certificado downstream del Gateway",{"_5719":307,"_24227":235,"_20499":36079,"_5":24387,"_16438":35901,"_1794":36080},[],"Gateway",{"_5719":308,"_24227":235,"_20499":36082,"_5":24387,"_16438":35901,"_1794":36083},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_5719":309,"_24227":235,"_20499":36085,"_5":24387,"_16438":35901,"_1794":36086},[],"Exposición de UI y APIs vía Envoy Gateway",{"_5719":310,"_24227":235,"_20499":36088,"_5":24387,"_16438":35901,"_1794":35636},[],{"_5719":311,"_24227":235,"_20499":36090,"_5":24387,"_16438":35901,"_1794":36091},[],"`postgres.*`",{"_5719":312,"_24227":235,"_20499":36093,"_5":24387,"_16438":35901,"_1794":36094},[],"Conexión a PostgreSQL externa",{"_5719":313,"_24227":235,"_20499":36096,"_5":24387,"_16438":35901,"_1794":36097},[],"Mensajería",{"_5719":314,"_24227":235,"_20499":36099,"_5":24387,"_16438":35901,"_1794":36100},[],"`amqp.*`",{"_5719":315,"_24227":235,"_20499":36102,"_5":24387,"_16438":35901,"_1794":36103},[],"Conexión a RabbitMQ",{"_5719":316,"_24227":235,"_20499":36105,"_5":24387,"_16438":35901,"_1794":36106},[],"OIDC",{"_5719":317,"_24227":235,"_20499":36108,"_5":24387,"_16438":35901,"_1794":36109},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_5719":318,"_24227":235,"_20499":36111,"_5":24387,"_16438":35901,"_1794":36112},[],"Login de UI y validación JWT en el Gateway",{"_5719":319,"_24227":235,"_20499":36114,"_5":24387,"_16438":35901,"_1794":35656},[],{"_5719":320,"_24227":235,"_20499":36116,"_5":24387,"_16438":35901,"_1794":36050},[],{"_5719":321,"_24227":235,"_20499":36118,"_5":24387,"_16438":35901,"_1794":36119},[],"Dominios autorizados para CA y certificados",{"_5719":322,"_24227":235,"_20499":36121,"_5":24387,"_16438":35901,"_1794":35686},[],{"_5719":323,"_24227":235,"_20499":36123,"_5":24387,"_16438":35901,"_1794":36124},[],"`services.kms.cryptoEngines.*`",{"_5719":324,"_24227":235,"_20499":36126,"_5":24387,"_16438":35901,"_1794":36127},[],"Motor criptográfico y almacenamiento de claves",{"_5719":325,"_24227":235,"_20499":36129,"_5":24387,"_16438":35901,"_1794":35650},[],{"_5719":326,"_24227":235,"_20499":36131,"_5":24387,"_16438":35901,"_1794":36132},[],"`services.alerts.smtp_server.*`",{"_5719":327,"_24227":235,"_20499":36134,"_5":24387,"_16438":35901,"_1794":36135},[],"Envío de correo para alertas",{"_5719":328,"_24227":235,"_20499":36137,"_5":24387,"_16438":35905,"_1794":36138},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_5719":329,"_24227":235,"_20499":36140,"_5":24387,"_16438":35905,"_1794":36141},[],"La prueba comprueba al menos:",{"_5719":330,"_24227":235,"_20499":36143,"_5":24387,"_16438":35905,"_1794":36144},[],"salud de `ca`",{"_5719":331,"_24227":235,"_20499":36146,"_5":24387,"_16438":35905,"_1794":36147},[],"salud de `dms-manager`",{"_5719":332,"_24227":235,"_20499":36149,"_5":24387,"_16438":35905,"_1794":36150},[],"salud de `device-manager`",{"_5719":333,"_24227":235,"_20499":36152,"_5":24387,"_16438":35905,"_1794":36153},[],"salud de `va`",{"_5719":334,"_24227":235,"_20499":36155,"_5":24387,"_16438":35905,"_1794":36156},[],"respuesta HTML esperada del servicio `ui`",{"_5719":335,"_24227":235,"_20499":36158,"_5":24387,"_16438":35909,"_1794":36159},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_5719":336,"_24227":235,"_20499":36161,"_5":24387,"_16438":35909,"_1794":36162},[],"`charts/lamassu`: chart principal de Lamassu",{"_5719":337,"_24227":235,"_20499":36164,"_5":24387,"_16438":35909,"_1794":36165},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_5719":338,"_24227":235,"_20499":36167,"_5":24387,"_16438":35909,"_1794":36168},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_5719":339,"_24227":235,"_20499":36170,"_5":24387,"_16438":35913,"_1794":36171},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_5719":340,"_24227":235,"_20499":36173,"_5":24387,"_16438":35917,"_1794":36174},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_5719":341,"_24227":341,"_5":24382,"_1794":36176,"_24395":36177,"_20499":36178,"_16438":341},"SaaS · Suscripción",[35169,35170,35228],[],{"_5719":342,"_24227":341,"_20499":36180,"_5":24387,"_16438":341,"_1794":36181},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_5719":343,"_24227":341,"_5":24392,"_20499":36183,"_16438":36184,"_1794":36185},[],"/docs/pr-preview/pr-25/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_5719":344,"_24227":341,"_5":24392,"_20499":36187,"_16438":36188,"_1794":36189},[],"/docs/pr-preview/pr-25/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_5719":345,"_24227":341,"_5":24392,"_20499":36191,"_16438":36192,"_1794":36193},[],"/docs/pr-preview/pr-25/despliegue/saas#planes-disponibles","Planes disponibles",{"_5719":346,"_24227":341,"_5":24392,"_20499":36195,"_16438":36196,"_1794":36197},[],"/docs/pr-preview/pr-25/despliegue/saas#contacto","Contacto",{"_5719":347,"_24227":341,"_20499":36199,"_5":24387,"_16438":36184,"_1794":36200},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_5719":348,"_24227":341,"_20499":36202,"_5":24387,"_16438":36188,"_1794":36203},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_5719":349,"_24227":341,"_20499":36205,"_5":24387,"_16438":36188,"_1794":36206},[],"Alta disponibilidad y backups automáticos",{"_5719":350,"_24227":341,"_20499":36208,"_5":24387,"_16438":36188,"_1794":36209},[],"Actualizaciones automáticas a las últimas versiones",{"_5719":351,"_24227":341,"_20499":36211,"_5":24387,"_16438":36188,"_1794":36212},[],"Soporte técnico incluido",{"_5719":352,"_24227":341,"_20499":36214,"_5":24387,"_16438":36188,"_1794":36215},[],"SLA garantizado",{"_5719":353,"_24227":341,"_20499":36217,"_5":24387,"_16438":36192,"_1794":36218},[],"Plan",{"_5719":354,"_24227":341,"_20499":36220,"_5":24387,"_16438":36192,"_1794":36221},[],"Dispositivos",{"_5719":355,"_24227":341,"_20499":36223,"_5":24387,"_16438":36192,"_1794":36224},[],"Soporte",{"_5719":356,"_24227":341,"_20499":36226,"_5":24387,"_16438":36192,"_1794":36227},[],"SLA",{"_5719":357,"_24227":341,"_20499":36229,"_5":24387,"_16438":36192,"_1794":36230},[],"Starter",{"_5719":358,"_24227":341,"_20499":36232,"_5":24387,"_16438":36192,"_1794":36233},[],"Hasta 1.000",{"_5719":359,"_24227":341,"_20499":36235,"_5":24387,"_16438":36192,"_1794":36236},[],"Email",{"_5719":360,"_24227":341,"_20499":36238,"_5":24387,"_16438":36192,"_1794":36239},[],"99,5%",{"_5719":361,"_24227":341,"_20499":36241,"_5":24387,"_16438":36192,"_1794":36242},[],"Professional",{"_5719":362,"_24227":341,"_20499":36244,"_5":24387,"_16438":36192,"_1794":36245},[],"Hasta 10.000",{"_5719":363,"_24227":341,"_20499":36247,"_5":24387,"_16438":36192,"_1794":36248},[],"Email + Chat",{"_5719":364,"_24227":341,"_20499":36250,"_5":24387,"_16438":36192,"_1794":36251},[],"99,9%",{"_5719":365,"_24227":341,"_20499":36253,"_5":24387,"_16438":36192,"_1794":36254},[],"Enterprise",{"_5719":366,"_24227":341,"_20499":36256,"_5":24387,"_16438":36192,"_1794":36257},[],"Ilimitado",{"_5719":367,"_24227":341,"_20499":36259,"_5":24387,"_16438":36192,"_1794":36260},[],"Dedicado",{"_5719":368,"_24227":341,"_20499":36262,"_5":24387,"_16438":36192,"_1794":36263},[],"99,99%",{"_5719":369,"_24227":341,"_20499":36265,"_5":24387,"_16438":36196,"_1794":36266},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_5719":370,"_24227":370,"_5":24382,"_1794":36268,"_24395":36269,"_20499":36270,"_16438":370},"Manual de Usuario",[35169,36268],[],{"_5719":371,"_24227":370,"_20499":36272,"_5":24387,"_16438":370,"_1794":36273},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_5719":372,"_24227":370,"_5":24392,"_20499":36275,"_16438":36276,"_1794":36277},[],"/docs/pr-preview/pr-25/manual#servicios-core","Servicios Core",{"_5719":373,"_24227":370,"_5":24392,"_20499":36279,"_16438":36280,"_1794":36281},[],"/docs/pr-preview/pr-25/manual#integraciones-con-terceros","Integraciones con terceros",{"_5719":374,"_24227":370,"_20499":36283,"_5":24387,"_16438":370,"_1794":36284},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_5719":375,"_24227":370,"_20499":36286,"_5":24387,"_16438":36276,"_1794":36287},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_5719":376,"_24227":370,"_20499":36289,"_5":24387,"_16438":36276,"_1794":36290},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_5719":377,"_24227":370,"_20499":36292,"_5":24387,"_16438":36276,"_1794":36293},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_5719":378,"_24227":370,"_20499":36295,"_5":24387,"_16438":36276,"_1794":36296},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_5719":379,"_24227":370,"_20499":36298,"_5":24387,"_16438":36276,"_1794":36299},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_5719":380,"_24227":370,"_20499":36301,"_5":24387,"_16438":36276,"_1794":36302},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_5719":381,"_24227":370,"_20499":36304,"_5":24387,"_16438":36276,"_1794":36305},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_5719":382,"_24227":370,"_20499":36307,"_5":24387,"_16438":36280,"_1794":36308},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_5719":383,"_24227":383,"_5":24382,"_1794":36310,"_24395":36311,"_20499":36312,"_16438":383},"Integración con AWS IoT Core",[35169,36268,36281],[],{"_5719":384,"_24227":383,"_20499":36314,"_5":24387,"_16438":383,"_1794":36315},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_5719":385,"_24227":383,"_5":24392,"_20499":36317,"_16438":36318,"_1794":36319},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_5719":386,"_24227":383,"_5":24392,"_20499":36321,"_16438":36322,"_1794":36323},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_5719":387,"_24227":383,"_5":24392,"_20499":36325,"_16438":36326,"_1794":36327},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_5719":388,"_24227":383,"_5":24392,"_20499":36329,"_16438":36330,"_1794":36331},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_5719":389,"_24227":383,"_5":24392,"_20499":36333,"_16438":36334,"_1794":36335},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_5719":390,"_24227":383,"_5":24392,"_20499":36337,"_16438":36338,"_1794":36339},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_5719":391,"_24227":383,"_5":24392,"_20499":36341,"_16438":36342,"_1794":36343},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#primary-account","Primary Account",{"_5719":392,"_24227":383,"_5":24392,"_20499":36345,"_16438":36346,"_1794":36347},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_5719":393,"_24227":383,"_5":24392,"_20499":36349,"_16438":36350,"_1794":36351},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_5719":394,"_24227":383,"_5":24392,"_20499":36353,"_16438":36354,"_1794":36355},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-none","Modo `none`",{"_5719":395,"_24227":383,"_5":24392,"_20499":36357,"_16438":36358,"_1794":36359},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-auto","Modo `auto`",{"_5719":396,"_24227":383,"_5":24392,"_20499":36361,"_16438":36362,"_1794":36363},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_5719":397,"_24227":383,"_5":24392,"_20499":36365,"_16438":36366,"_1794":36367},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_5719":398,"_24227":383,"_5":24392,"_20499":36369,"_16438":36370,"_1794":36371},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_5719":399,"_24227":383,"_5":24392,"_20499":36373,"_16438":36374,"_1794":36375},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_5719":400,"_24227":383,"_5":24392,"_20499":36377,"_16438":36378,"_1794":36379},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_5719":401,"_24227":383,"_5":24392,"_20499":36381,"_16438":36382,"_1794":36383},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_5719":402,"_24227":383,"_5":24392,"_20499":36385,"_16438":36386,"_1794":36387},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_5719":403,"_24227":383,"_5":24392,"_20499":36389,"_16438":36390,"_1794":36391},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_5719":404,"_24227":383,"_5":24392,"_20499":36393,"_16438":36394,"_1794":36395},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_5719":405,"_24227":383,"_20499":36397,"_5":24387,"_16438":383,"_1794":36398},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_5719":406,"_24227":383,"_20499":36400,"_5":24387,"_16438":383,"_1794":36401},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_5719":407,"_24227":383,"_20499":36403,"_5":24387,"_16438":383,"_1794":36404},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_5719":408,"_24227":383,"_20499":36406,"_5":24387,"_16438":36318,"_1794":36407},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_5719":409,"_24227":383,"_20499":36409,"_5":24387,"_16438":36318,"_1794":36410},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_5719":410,"_24227":383,"_20499":36412,"_5":24387,"_16438":36318,"_1794":36413},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_5719":411,"_24227":383,"_20499":36415,"_5":24387,"_16438":36318,"_1794":36416},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_5719":412,"_24227":383,"_20499":36418,"_5":24387,"_16438":36322,"_1794":36419},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_5719":413,"_24227":383,"_20499":36421,"_5":24387,"_16438":36326,"_1794":36422},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_5719":414,"_24227":383,"_20499":36424,"_5":24387,"_16438":36326,"_1794":36425},[],"Acción IAM",{"_5719":415,"_24227":383,"_20499":36427,"_5":24387,"_16438":36326,"_1794":36428},[],"Propósito",{"_5719":416,"_24227":383,"_20499":36430,"_5":24387,"_16438":36326,"_1794":36431},[],"`iot:GetRegistrationCode`",{"_5719":417,"_24227":383,"_20499":36433,"_5":24387,"_16438":36326,"_1794":36434},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_5719":418,"_24227":383,"_20499":36436,"_5":24387,"_16438":36326,"_1794":36437},[],"`iot:RegisterCACertificate`",{"_5719":419,"_24227":383,"_20499":36439,"_5":24387,"_16438":36326,"_1794":36440},[],"Registrar la CA en AWS IoT",{"_5719":420,"_24227":383,"_20499":36442,"_5":24387,"_16438":36326,"_1794":36443},[],"`iot:DescribeCACertificate`",{"_5719":421,"_24227":383,"_20499":36445,"_5":24387,"_16438":36326,"_1794":36446},[],"Consultar el estado del registro de la CA",{"_5719":422,"_24227":383,"_20499":36448,"_5":24387,"_16438":36326,"_1794":36449},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_5719":423,"_24227":383,"_20499":36451,"_5":24387,"_16438":36326,"_1794":36452},[],"Crear o actualizar Things en IoT Core",{"_5719":424,"_24227":383,"_20499":36454,"_5":24387,"_16438":36326,"_1794":36455},[],"`iot:RegisterThing`",{"_5719":425,"_24227":383,"_20499":36457,"_5":24387,"_16438":36326,"_1794":36458},[],"Aprovisionar Things mediante plantilla",{"_5719":426,"_24227":383,"_20499":36460,"_5":24387,"_16438":36326,"_1794":36461},[],"`iot:RegisterCertificate`",{"_5719":427,"_24227":383,"_20499":36463,"_5":24387,"_16438":36326,"_1794":36464},[],"Registrar certificados de dispositivo",{"_5719":428,"_24227":383,"_20499":36466,"_5":24387,"_16438":36326,"_1794":36467},[],"`iot:UpdateCertificate`",{"_5719":429,"_24227":383,"_20499":36469,"_5":24387,"_16438":36326,"_1794":36470},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_5719":430,"_24227":383,"_20499":36472,"_5":24387,"_16438":36326,"_1794":36473},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_5719":431,"_24227":383,"_20499":36475,"_5":24387,"_16438":36326,"_1794":36476},[],"Crear y adjuntar políticas IoT",{"_5719":432,"_24227":383,"_20499":36478,"_5":24387,"_16438":36326,"_1794":36479},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_5719":433,"_24227":383,"_20499":36481,"_5":24387,"_16438":36326,"_1794":36482},[],"Gestionar grupos de Things",{"_5719":434,"_24227":383,"_20499":36484,"_5":24387,"_16438":36326,"_1794":36485},[],"`iot:CreateProvisioningTemplate`",{"_5719":435,"_24227":383,"_20499":36487,"_5":24387,"_16438":36326,"_1794":36488},[],"Crear plantillas JITP",{"_5719":436,"_24227":383,"_20499":36490,"_5":24387,"_16438":36326,"_1794":36491},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_5719":437,"_24227":383,"_20499":36493,"_5":24387,"_16438":36326,"_1794":36494},[],"Leer y escribir el Device Shadow",{"_5719":438,"_24227":383,"_20499":36496,"_5":24387,"_16438":36326,"_1794":36497},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_5719":439,"_24227":383,"_20499":36499,"_5":24387,"_16438":36330,"_1794":36500},[],"Parámetro",{"_5719":440,"_24227":383,"_20499":36502,"_5":24387,"_16438":36330,"_1794":36503},[],"Tipo",{"_5719":441,"_24227":383,"_20499":36505,"_5":24387,"_16438":36330,"_1794":36506},[],"Requerido",{"_5719":442,"_24227":383,"_20499":36508,"_5":24387,"_16438":36330,"_1794":35372},[],{"_5719":443,"_24227":383,"_20499":36510,"_5":24387,"_16438":36330,"_1794":36511},[],"`connector_id`",{"_5719":444,"_24227":383,"_20499":36513,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":445,"_24227":383,"_20499":36515,"_5":24387,"_16438":36330,"_1794":36516},[],"Sí",{"_5719":446,"_24227":383,"_20499":36518,"_5":24387,"_16438":36330,"_1794":36519},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_5719":447,"_24227":383,"_20499":36521,"_5":24387,"_16438":36330,"_1794":36522},[],"`aws_config.region`",{"_5719":448,"_24227":383,"_20499":36524,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":449,"_24227":383,"_20499":36526,"_5":24387,"_16438":36330,"_1794":36516},[],{"_5719":450,"_24227":383,"_20499":36528,"_5":24387,"_16438":36330,"_1794":36529},[],"Región AWS donde opera el conector.",{"_5719":451,"_24227":383,"_20499":36531,"_5":24387,"_16438":36330,"_1794":36532},[],"`aws_config.auth_method`",{"_5719":452,"_24227":383,"_20499":36534,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":453,"_24227":383,"_20499":36536,"_5":24387,"_16438":36330,"_1794":36516},[],{"_5719":454,"_24227":383,"_20499":36538,"_5":24387,"_16438":36330,"_1794":36539},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_5719":455,"_24227":383,"_20499":36541,"_5":24387,"_16438":36330,"_1794":36542},[],"`aws_config.access_key_id`",{"_5719":456,"_24227":383,"_20499":36544,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":457,"_24227":383,"_20499":36546,"_5":24387,"_16438":36330,"_1794":36547},[],"Solo con `auth_method=static`",{"_5719":458,"_24227":383,"_20499":36549,"_5":24387,"_16438":36330,"_1794":36550},[],"Clave de acceso AWS.",{"_5719":459,"_24227":383,"_20499":36552,"_5":24387,"_16438":36330,"_1794":36553},[],"`aws_config.secret_access_key`",{"_5719":460,"_24227":383,"_20499":36555,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":461,"_24227":383,"_20499":36557,"_5":24387,"_16438":36330,"_1794":36547},[],{"_5719":462,"_24227":383,"_20499":36559,"_5":24387,"_16438":36330,"_1794":36560},[],"Clave secreta AWS.",{"_5719":463,"_24227":383,"_20499":36562,"_5":24387,"_16438":36330,"_1794":36563},[],"`aws_config.session_token`",{"_5719":464,"_24227":383,"_20499":36565,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":465,"_24227":383,"_20499":36567,"_5":24387,"_16438":36330,"_1794":36568},[],"No",{"_5719":466,"_24227":383,"_20499":36570,"_5":24387,"_16438":36330,"_1794":36571},[],"Token de sesión (con `auth_method=static`).",{"_5719":467,"_24227":383,"_20499":36573,"_5":24387,"_16438":36330,"_1794":36574},[],"`aws_config.role_arn`",{"_5719":468,"_24227":383,"_20499":36576,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":469,"_24227":383,"_20499":36578,"_5":24387,"_16438":36330,"_1794":36579},[],"Solo con `auth_method=role`",{"_5719":470,"_24227":383,"_20499":36581,"_5":24387,"_16438":36330,"_1794":36582},[],"ARN del rol a asumir.",{"_5719":471,"_24227":383,"_20499":36584,"_5":24387,"_16438":36330,"_1794":36585},[],"`aws_config.endpoint_url`",{"_5719":472,"_24227":383,"_20499":36587,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":473,"_24227":383,"_20499":36589,"_5":24387,"_16438":36330,"_1794":36568},[],{"_5719":474,"_24227":383,"_20499":36591,"_5":24387,"_16438":36330,"_1794":36592},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_5719":475,"_24227":383,"_20499":36594,"_5":24387,"_16438":36330,"_1794":36595},[],"`subscriber_event_bus`",{"_5719":476,"_24227":383,"_20499":36597,"_5":24387,"_16438":36330,"_1794":20815},[],{"_5719":477,"_24227":383,"_20499":36599,"_5":24387,"_16438":36330,"_1794":36516},[],{"_5719":478,"_24227":383,"_20499":36601,"_5":24387,"_16438":36330,"_1794":36602},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_5719":479,"_24227":383,"_20499":36604,"_5":24387,"_16438":36330,"_1794":36605},[],"`dms_manager_client`",{"_5719":480,"_24227":383,"_20499":36607,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":481,"_24227":383,"_20499":36609,"_5":24387,"_16438":36330,"_1794":36516},[],{"_5719":482,"_24227":383,"_20499":36611,"_5":24387,"_16438":36330,"_1794":36612},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_5719":483,"_24227":383,"_20499":36614,"_5":24387,"_16438":36330,"_1794":36615},[],"`device_manager_client`",{"_5719":484,"_24227":383,"_20499":36617,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":485,"_24227":383,"_20499":36619,"_5":24387,"_16438":36330,"_1794":36516},[],{"_5719":486,"_24227":383,"_20499":36621,"_5":24387,"_16438":36330,"_1794":36622},[],"URL HTTP del Device Manager de Lamassu.",{"_5719":487,"_24227":383,"_20499":36624,"_5":24387,"_16438":36330,"_1794":36625},[],"`ca_client`",{"_5719":488,"_24227":383,"_20499":36627,"_5":24387,"_16438":36330,"_1794":12452},[],{"_5719":489,"_24227":383,"_20499":36629,"_5":24387,"_16438":36330,"_1794":36516},[],{"_5719":490,"_24227":383,"_20499":36631,"_5":24387,"_16438":36330,"_1794":36632},[],"URL HTTP del servicio de CA de Lamassu.",{"_5719":491,"_24227":383,"_20499":36634,"_5":24387,"_16438":36334,"_1794":36635},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_5719":492,"_24227":383,"_20499":36637,"_5":24387,"_16438":36338,"_1794":36638},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_5719":493,"_24227":383,"_20499":36640,"_5":24387,"_16438":36338,"_1794":36641},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_5719":494,"_24227":383,"_20499":36643,"_5":24387,"_16438":36342,"_1794":36644},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_5719":495,"_24227":383,"_20499":36646,"_5":24387,"_16438":36342,"_1794":36647},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_5719":496,"_24227":383,"_20499":36649,"_5":24387,"_16438":36342,"_1794":36650},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_5719":497,"_24227":383,"_20499":36652,"_5":24387,"_16438":36342,"_1794":36653},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_5719":498,"_24227":383,"_20499":36655,"_5":24387,"_16438":36342,"_1794":36656},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_5719":499,"_24227":383,"_20499":36658,"_5":24387,"_16438":36342,"_1794":36659},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_5719":500,"_24227":383,"_20499":36661,"_5":24387,"_16438":36346,"_1794":36662},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_5719":501,"_24227":383,"_20499":36664,"_5":24387,"_16438":36350,"_1794":36665},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_5719":502,"_24227":383,"_20499":36667,"_5":24387,"_16438":36350,"_1794":36668},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_5719":503,"_24227":383,"_20499":36670,"_5":24387,"_16438":36354,"_1794":36671},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_5719":504,"_24227":383,"_20499":36673,"_5":24387,"_16438":36358,"_1794":36674},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_5719":505,"_24227":383,"_20499":36676,"_5":24387,"_16438":36358,"_1794":36677},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_5719":506,"_24227":383,"_20499":36679,"_5":24387,"_16438":36358,"_1794":36680},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_5719":507,"_24227":383,"_20499":36682,"_5":24387,"_16438":36358,"_1794":36683},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_5719":508,"_24227":383,"_20499":36685,"_5":24387,"_16438":36358,"_1794":36686},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_5719":509,"_24227":383,"_20499":36688,"_5":24387,"_16438":36358,"_1794":36689},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_5719":510,"_24227":383,"_20499":36691,"_5":24387,"_16438":36362,"_1794":36692},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_5719":511,"_24227":383,"_20499":36694,"_5":24387,"_16438":36362,"_1794":36695},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_5719":512,"_24227":383,"_20499":36697,"_5":24387,"_16438":36362,"_1794":36698},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_5719":513,"_24227":383,"_20499":36700,"_5":24387,"_16438":36366,"_1794":36701},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_5719":514,"_24227":383,"_20499":36703,"_5":24387,"_16438":36366,"_1794":36704},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_5719":515,"_24227":383,"_20499":36706,"_5":24387,"_16438":36366,"_1794":36707},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_5719":516,"_24227":383,"_20499":36709,"_5":24387,"_16438":36370,"_1794":36710},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_5719":517,"_24227":383,"_20499":36712,"_5":24387,"_16438":36370,"_1794":36713},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_5719":518,"_24227":383,"_20499":36715,"_5":24387,"_16438":36370,"_1794":36716},[],"Para que el flujo JITP funcione correctamente:",{"_5719":519,"_24227":383,"_20499":36718,"_5":24387,"_16438":36370,"_1794":36719},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_5719":520,"_24227":383,"_20499":36721,"_5":24387,"_16438":36370,"_1794":36722},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_5719":521,"_24227":383,"_20499":36724,"_5":24387,"_16438":36370,"_1794":36725},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_5719":522,"_24227":383,"_20499":36727,"_5":24387,"_16438":36370,"_1794":36728},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_5719":523,"_24227":383,"_20499":36730,"_5":24387,"_16438":36374,"_1794":36731},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_5719":524,"_24227":383,"_20499":36733,"_5":24387,"_16438":36374,"_1794":36734},[],"Estado en Lamassu",{"_5719":525,"_24227":383,"_20499":36736,"_5":24387,"_16438":36374,"_1794":36737},[],"Razón de revocación",{"_5719":526,"_24227":383,"_20499":36739,"_5":24387,"_16438":36374,"_1794":36740},[],"Estado en AWS IoT Core",{"_5719":527,"_24227":383,"_20499":36742,"_5":24387,"_16438":36374,"_1794":36743},[],"`Active`",{"_5719":528,"_24227":383,"_20499":36745,"_5":24387,"_16438":36374,"_1794":36746},[],"—",{"_5719":529,"_24227":383,"_20499":36748,"_5":24387,"_16438":36374,"_1794":36749},[],"`ACTIVE`",{"_5719":530,"_24227":383,"_20499":36751,"_5":24387,"_16438":36374,"_1794":36752},[],"`Revoked`",{"_5719":531,"_24227":383,"_20499":36754,"_5":24387,"_16438":36374,"_1794":36755},[],"`certificateHold`",{"_5719":532,"_24227":383,"_20499":36757,"_5":24387,"_16438":36374,"_1794":36758},[],"`INACTIVE`",{"_5719":533,"_24227":383,"_20499":36760,"_5":24387,"_16438":36374,"_1794":36752},[],{"_5719":534,"_24227":383,"_20499":36762,"_5":24387,"_16438":36374,"_1794":36763},[],"Cualquier otra razón",{"_5719":535,"_24227":383,"_20499":36765,"_5":24387,"_16438":36374,"_1794":36766},[],"`REVOKED`",{"_5719":536,"_24227":383,"_20499":36768,"_5":24387,"_16438":36374,"_1794":36769},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_5719":537,"_24227":383,"_20499":36771,"_5":24387,"_16438":36378,"_1794":36772},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_5719":538,"_24227":383,"_20499":36774,"_5":24387,"_16438":36378,"_1794":36775},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_5719":539,"_24227":383,"_20499":36777,"_5":24387,"_16438":36378,"_1794":36778},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_5719":540,"_24227":383,"_20499":36780,"_5":24387,"_16438":36382,"_1794":36781},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_5719":541,"_24227":383,"_20499":36783,"_5":24387,"_16438":36382,"_1794":36784},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_5719":542,"_24227":383,"_20499":36786,"_5":24387,"_16438":36386,"_1794":36787},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_5719":543,"_24227":383,"_20499":36789,"_5":24387,"_16438":36386,"_1794":36790},[],"Existen dos tipos de acciones:",{"_5719":544,"_24227":383,"_20499":36792,"_5":24387,"_16438":36386,"_1794":36793},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_5719":545,"_24227":383,"_20499":36795,"_5":24387,"_16438":36386,"_1794":36796},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_5719":546,"_24227":383,"_20499":36798,"_5":24387,"_16438":36386,"_1794":36799},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_5719":547,"_24227":383,"_20499":36801,"_5":24387,"_16438":36390,"_1794":36802},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_5719":548,"_24227":383,"_20499":36804,"_5":24387,"_16438":36390,"_1794":36805},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_5719":549,"_24227":383,"_20499":36807,"_5":24387,"_16438":36390,"_1794":36808},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_5719":550,"_24227":383,"_20499":36810,"_5":24387,"_16438":36394,"_1794":36811},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_5719":551,"_24227":383,"_20499":36813,"_5":24387,"_16438":36394,"_1794":36814},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_5719":552,"_24227":383,"_20499":36816,"_5":24387,"_16438":36394,"_1794":36817},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_5719":553,"_24227":383,"_20499":36819,"_5":24387,"_16438":36394,"_1794":36820},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_5719":554,"_24227":383,"_20499":36822,"_5":24387,"_16438":36394,"_1794":36823},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_5719":555,"_24227":383,"_20499":36825,"_5":24387,"_16438":36394,"_1794":36826},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_5719":556,"_24227":383,"_20499":36828,"_5":24387,"_16438":36394,"_1794":36829},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_5719":557,"_24227":383,"_20499":36831,"_5":24387,"_16438":36394,"_1794":36832},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_5719":558,"_24227":383,"_20499":36834,"_5":24387,"_16438":36394,"_1794":36835},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_5719":559,"_24227":383,"_20499":36837,"_5":24387,"_16438":36394,"_1794":36838},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_5719":560,"_24227":383,"_20499":36840,"_5":24387,"_16438":36394,"_1794":36841},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_5719":561,"_24227":383,"_20499":36843,"_5":24387,"_16438":36394,"_1794":36844},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_5719":562,"_24227":383,"_20499":36846,"_5":24387,"_16438":36394,"_1794":36847},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_5719":563,"_24227":383,"_20499":36849,"_5":24387,"_16438":36394,"_1794":36850},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_5719":564,"_24227":383,"_20499":36852,"_5":24387,"_16438":36394,"_1794":36853},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_5719":565,"_24227":383,"_20499":36855,"_5":24387,"_16438":36394,"_1794":36856},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_5719":566,"_24227":383,"_20499":36858,"_5":24387,"_16438":36394,"_1794":36859},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_5719":567,"_24227":383,"_20499":36861,"_5":24387,"_16438":36394,"_1794":36862},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_5719":568,"_24227":383,"_20499":36864,"_5":24387,"_16438":36394,"_1794":36865},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_5719":569,"_24227":383,"_20499":36867,"_5":24387,"_16438":36394,"_1794":36868},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_5719":570,"_24227":383,"_20499":36870,"_5":24387,"_16438":36394,"_1794":36871},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_5719":571,"_24227":571,"_5":24382,"_1794":36873,"_24395":36874,"_20499":36875,"_16438":571},"[Alerts] Alertas y Suscripciones",[35169,36268,36277],[],{"_5719":572,"_24227":571,"_20499":36877,"_5":24387,"_16438":571,"_1794":36878},[],"Monitorización proactiva mediante eventos y suscripciones",{"_5719":573,"_24227":571,"_5":24392,"_20499":36880,"_16438":36881,"_1794":36882},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#alertas","Alertas",{"_5719":574,"_24227":571,"_5":24392,"_20499":36884,"_16438":36885,"_1794":36886},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_5719":575,"_24227":571,"_5":24392,"_20499":36888,"_16438":36889,"_1794":36890},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_5719":576,"_24227":571,"_5":24392,"_20499":36892,"_16438":36893,"_1794":36894},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_5719":577,"_24227":571,"_5":24392,"_20499":36896,"_16438":36897,"_1794":36898},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_5719":578,"_24227":571,"_5":24392,"_20499":36900,"_16438":36901,"_1794":36902},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_5719":579,"_24227":571,"_5":24392,"_20499":36904,"_16438":36905,"_1794":36906},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_5719":580,"_24227":571,"_20499":36908,"_5":24387,"_16438":36881,"_1794":36909},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_5719":581,"_24227":571,"_20499":36911,"_5":24387,"_16438":36885,"_1794":36912},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_5719":582,"_24227":571,"_20499":36914,"_5":24387,"_16438":36885,"_1794":36915},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_5719":583,"_24227":571,"_20499":36917,"_5":24387,"_16438":36885,"_1794":36918},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_5719":584,"_24227":571,"_20499":36920,"_5":24387,"_16438":36885,"_1794":36921},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_5719":585,"_24227":571,"_20499":36923,"_5":24387,"_16438":36885,"_1794":36924},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_5719":586,"_24227":571,"_20499":36926,"_5":24387,"_16438":36885,"_1794":36927},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_5719":587,"_24227":571,"_20499":36929,"_5":24387,"_16438":36889,"_1794":36930},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_5719":588,"_24227":571,"_20499":36932,"_5":24387,"_16438":36889,"_1794":36933},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_5719":589,"_24227":571,"_20499":36935,"_5":24387,"_16438":36889,"_1794":36936},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_5719":590,"_24227":571,"_20499":36938,"_5":24387,"_16438":36889,"_1794":36939},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_5719":591,"_24227":571,"_20499":36941,"_5":24387,"_16438":36889,"_1794":36942},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_5719":592,"_24227":571,"_20499":36944,"_5":24387,"_16438":36893,"_1794":36945},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_5719":593,"_24227":571,"_20499":36947,"_5":24387,"_16438":36893,"_1794":36948},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_5719":594,"_24227":571,"_20499":36950,"_5":24387,"_16438":36893,"_1794":36951},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_5719":595,"_24227":571,"_20499":36953,"_5":24387,"_16438":36893,"_1794":36954},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_5719":596,"_24227":571,"_20499":36956,"_5":24387,"_16438":36893,"_1794":36957},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_5719":597,"_24227":571,"_20499":36959,"_5":24387,"_16438":36897,"_1794":36960},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_5719":598,"_24227":571,"_20499":36962,"_5":24387,"_16438":36897,"_1794":36963},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_5719":599,"_24227":571,"_20499":36965,"_5":24387,"_16438":36901,"_1794":36966},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_5719":600,"_24227":571,"_20499":36968,"_5":24387,"_16438":36901,"_1794":36969},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_5719":601,"_24227":571,"_20499":36971,"_5":24387,"_16438":36901,"_1794":36972},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_5719":602,"_24227":571,"_20499":36974,"_5":24387,"_16438":36901,"_1794":36975},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_5719":603,"_24227":571,"_20499":36977,"_5":24387,"_16438":36905,"_1794":36978},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_5719":604,"_24227":571,"_20499":36980,"_5":24387,"_16438":36905,"_1794":36981},[],"Evento",{"_5719":605,"_24227":571,"_20499":36983,"_5":24387,"_16438":36905,"_1794":35372},[],{"_5719":606,"_24227":571,"_20499":36985,"_5":24387,"_16438":36905,"_1794":36986},[],"**ca.create**",{"_5719":607,"_24227":571,"_20499":36988,"_5":24387,"_16438":36905,"_1794":36989},[],"Creación de una CA",{"_5719":608,"_24227":571,"_20499":36991,"_5":24387,"_16438":36905,"_1794":36992},[],"**ca.import**",{"_5719":609,"_24227":571,"_20499":36994,"_5":24387,"_16438":36905,"_1794":36995},[],"Importación de una CA",{"_5719":610,"_24227":571,"_20499":36997,"_5":24387,"_16438":36905,"_1794":36998},[],"**ca.profile.update**",{"_5719":611,"_24227":571,"_20499":37000,"_5":24387,"_16438":36905,"_1794":37001},[],"Actualización de perfil de CA",{"_5719":612,"_24227":571,"_20499":37003,"_5":24387,"_16438":36905,"_1794":37004},[],"**ca.reissue**",{"_5719":613,"_24227":571,"_20499":37006,"_5":24387,"_16438":36905,"_1794":37007},[],"Reemisión de una CA",{"_5719":614,"_24227":571,"_20499":37009,"_5":24387,"_16438":36905,"_1794":37010},[],"**ca.sign.certificate**",{"_5719":615,"_24227":571,"_20499":37012,"_5":24387,"_16438":36905,"_1794":37013},[],"Firma / emisión de certificado",{"_5719":616,"_24227":571,"_20499":37015,"_5":24387,"_16438":36905,"_1794":37016},[],"**ca.signature.sign**",{"_5719":617,"_24227":571,"_20499":37018,"_5":24387,"_16438":36905,"_1794":37019},[],"Operación de firma criptográfica",{"_5719":618,"_24227":571,"_20499":37021,"_5":24387,"_16438":36905,"_1794":37022},[],"**ca.delete**",{"_5719":619,"_24227":571,"_20499":37024,"_5":24387,"_16438":36905,"_1794":37025},[],"Eliminación de una CA",{"_5719":620,"_24227":571,"_20499":37027,"_5":24387,"_16438":36905,"_1794":37028},[],"**certificate.delete**",{"_5719":621,"_24227":571,"_20499":37030,"_5":24387,"_16438":36905,"_1794":37031},[],"Eliminación de un certificado",{"_5719":622,"_24227":571,"_20499":37033,"_5":24387,"_16438":36905,"_1794":37034},[],"**profile.create**",{"_5719":623,"_24227":571,"_20499":37036,"_5":24387,"_16438":36905,"_1794":37037},[],"Creación de perfil de emisión",{"_5719":624,"_24227":571,"_20499":37039,"_5":24387,"_16438":36905,"_1794":37040},[],"**profile.update**",{"_5719":625,"_24227":571,"_20499":37042,"_5":24387,"_16438":36905,"_1794":37043},[],"Actualización de perfil de emisión",{"_5719":626,"_24227":571,"_20499":37045,"_5":24387,"_16438":36905,"_1794":37046},[],"**profile.delete**",{"_5719":627,"_24227":571,"_20499":37048,"_5":24387,"_16438":36905,"_1794":37049},[],"Eliminación de perfil de emisión",{"_5719":628,"_24227":571,"_20499":37051,"_5":24387,"_16438":36905,"_1794":37052},[],"**dms.create**",{"_5719":629,"_24227":571,"_20499":37054,"_5":24387,"_16438":36905,"_1794":37055},[],"Creación de un DMS",{"_5719":630,"_24227":571,"_20499":37057,"_5":24387,"_16438":36905,"_1794":37058},[],"**dms.update**",{"_5719":631,"_24227":571,"_20499":37060,"_5":24387,"_16438":36905,"_1794":37061},[],"Actualización de un DMS",{"_5719":632,"_24227":571,"_20499":37063,"_5":24387,"_16438":36905,"_1794":37064},[],"**dms.delete**",{"_5719":633,"_24227":571,"_20499":37066,"_5":24387,"_16438":36905,"_1794":37067},[],"Eliminación de un DMS",{"_5719":634,"_24227":571,"_20499":37069,"_5":24387,"_16438":36905,"_1794":37070},[],"**dms.enroll**",{"_5719":635,"_24227":571,"_20499":37072,"_5":24387,"_16438":36905,"_1794":37073},[],"Inscripción (enroll) de dispositivo",{"_5719":636,"_24227":571,"_20499":37075,"_5":24387,"_16438":36905,"_1794":37076},[],"**dms.reenroll**",{"_5719":637,"_24227":571,"_20499":37078,"_5":24387,"_16438":36905,"_1794":37079},[],"Re-inscripción (reenroll) de dispositivo",{"_5719":638,"_24227":571,"_20499":37081,"_5":24387,"_16438":36905,"_1794":37082},[],"**dms.bind-device-id**",{"_5719":639,"_24227":571,"_20499":37084,"_5":24387,"_16438":36905,"_1794":37085},[],"Asociación de identidad a dispositivo",{"_5719":640,"_24227":571,"_20499":37087,"_5":24387,"_16438":36905,"_1794":37088},[],"**device.create**",{"_5719":641,"_24227":571,"_20499":37090,"_5":24387,"_16438":36905,"_1794":37091},[],"Creación de dispositivo",{"_5719":642,"_24227":571,"_20499":37093,"_5":24387,"_16438":36905,"_1794":37094},[],"**device.identity.update**",{"_5719":643,"_24227":571,"_20499":37096,"_5":24387,"_16438":36905,"_1794":37097},[],"Actualización de identidad del dispositivo",{"_5719":644,"_24227":571,"_20499":37099,"_5":24387,"_16438":36905,"_1794":37100},[],"**device.status.update**",{"_5719":645,"_24227":571,"_20499":37102,"_5":24387,"_16438":36905,"_1794":37103},[],"Cambio de estado del dispositivo",{"_5719":646,"_24227":571,"_20499":37105,"_5":24387,"_16438":36905,"_1794":37106},[],"**device.metadata.update**",{"_5719":647,"_24227":571,"_20499":37108,"_5":24387,"_16438":36905,"_1794":37109},[],"Actualización de metadatos del dispositivo",{"_5719":648,"_24227":571,"_20499":37111,"_5":24387,"_16438":36905,"_1794":37112},[],"**device.delete**",{"_5719":649,"_24227":571,"_20499":37114,"_5":24387,"_16438":36905,"_1794":37115},[],"Eliminación de un dispositivo",{"_5719":650,"_24227":571,"_20499":37117,"_5":24387,"_16438":36905,"_1794":37118},[],"**va.role.crl.create**",{"_5719":651,"_24227":571,"_20499":37120,"_5":24387,"_16438":36905,"_1794":37121},[],"Cálculo/creación de CRL",{"_5719":652,"_24227":571,"_20499":37123,"_5":24387,"_16438":36905,"_1794":37124},[],"**kms.create**",{"_5719":653,"_24227":571,"_20499":37126,"_5":24387,"_16438":36905,"_1794":37127},[],"Creación de clave en KMS",{"_5719":654,"_24227":571,"_20499":37129,"_5":24387,"_16438":36905,"_1794":37130},[],"**kms.import**",{"_5719":655,"_24227":571,"_20499":37132,"_5":24387,"_16438":36905,"_1794":37133},[],"Importación de una clave KMS",{"_5719":656,"_24227":571,"_20499":37135,"_5":24387,"_16438":36905,"_1794":37136},[],"**kms.update.metadata**",{"_5719":657,"_24227":571,"_20499":37138,"_5":24387,"_16438":36905,"_1794":37139},[],"Actualización de metadatos de clave KMS",{"_5719":658,"_24227":571,"_20499":37141,"_5":24387,"_16438":36905,"_1794":37142},[],"**kms.update.aliases**",{"_5719":659,"_24227":571,"_20499":37144,"_5":24387,"_16438":36905,"_1794":37145},[],"Actualización de alias de clave KMS",{"_5719":660,"_24227":571,"_20499":37147,"_5":24387,"_16438":36905,"_1794":37148},[],"**kms.update.name**",{"_5719":661,"_24227":571,"_20499":37150,"_5":24387,"_16438":36905,"_1794":37151},[],"Cambio de nombre de una clave KMS",{"_5719":662,"_24227":571,"_20499":37153,"_5":24387,"_16438":36905,"_1794":37154},[],"**kms.update.tags**",{"_5719":663,"_24227":571,"_20499":37156,"_5":24387,"_16438":36905,"_1794":37157},[],"Actualización de etiquetas (tags) de clave KMS",{"_5719":664,"_24227":571,"_20499":37159,"_5":24387,"_16438":36905,"_1794":37160},[],"**kms.delete**",{"_5719":665,"_24227":571,"_20499":37162,"_5":24387,"_16438":36905,"_1794":37163},[],"Eliminación de una clave KMS",{"_5719":666,"_24227":571,"_20499":37165,"_5":24387,"_16438":36905,"_1794":37166},[],"**kms.sign.message**",{"_5719":667,"_24227":571,"_20499":37168,"_5":24387,"_16438":36905,"_1794":37169},[],"Firma de un mensaje con clave KMS",{"_5719":668,"_24227":571,"_20499":37171,"_5":24387,"_16438":36905,"_1794":37172},[],"**kms.verify.signature**",{"_5719":669,"_24227":571,"_20499":37174,"_5":24387,"_16438":36905,"_1794":37175},[],"Verificación de firma con clave KMS",{"_5719":670,"_24227":670,"_5":24382,"_1794":37177,"_24395":37178,"_20499":37179,"_16438":670},"[CA] Gestión de Entidades de Confianza",[35169,36268,36277],[],{"_5719":671,"_24227":670,"_20499":37181,"_5":24387,"_16438":670,"_1794":37182},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_5719":672,"_24227":670,"_5":24392,"_20499":37184,"_16438":37185,"_1794":37186},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_5719":673,"_24227":670,"_5":24392,"_20499":37188,"_16438":37189,"_1794":37190},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_5719":674,"_24227":670,"_5":24392,"_20499":37192,"_16438":37193,"_1794":37194},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_5719":675,"_24227":670,"_5":24392,"_20499":37196,"_16438":37197,"_1794":37198},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_5719":676,"_24227":670,"_5":24392,"_20499":37200,"_16438":37201,"_1794":37202},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_5719":677,"_24227":670,"_5":24392,"_20499":37204,"_16438":37205,"_1794":37206},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_5719":678,"_24227":670,"_5":24392,"_20499":37208,"_16438":37209,"_1794":37210},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_5719":679,"_24227":670,"_5":24392,"_20499":37212,"_16438":37213,"_1794":37214},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_5719":680,"_24227":670,"_5":24392,"_20499":37216,"_16438":37217,"_1794":37218},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_5719":681,"_24227":670,"_20499":37220,"_5":24387,"_16438":37189,"_1794":37221},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_5719":682,"_24227":670,"_20499":37223,"_5":24387,"_16438":37189,"_1794":37224},[],"Actualmente hay disponibles 3 acciones:",{"_5719":683,"_24227":670,"_20499":37226,"_5":24387,"_16438":37189,"_1794":37227},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_5719":684,"_24227":670,"_20499":37229,"_5":24387,"_16438":37189,"_1794":37230},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_5719":685,"_24227":670,"_20499":37232,"_5":24387,"_16438":37189,"_1794":37233},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_5719":686,"_24227":670,"_20499":37235,"_5":24387,"_16438":37193,"_1794":37236},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_5719":687,"_24227":670,"_20499":37238,"_5":24387,"_16438":37193,"_1794":37239},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_5719":688,"_24227":670,"_20499":37241,"_5":24387,"_16438":37193,"_1794":37242},[],"**Motor criptográfico**",{"_5719":689,"_24227":670,"_20499":37244,"_5":24387,"_16438":37193,"_1794":37245},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_5719":690,"_24227":670,"_20499":37247,"_5":24387,"_16438":37193,"_1794":37248},[],"**Ejemplo mostrado:** go1.24.3",{"_5719":691,"_24227":670,"_20499":37250,"_5":24387,"_16438":37193,"_1794":37251},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_5719":692,"_24227":670,"_20499":37253,"_5":24387,"_16438":37193,"_1794":37254},[],"**Parámetros de clave**",{"_5719":693,"_24227":670,"_20499":37256,"_5":24387,"_16438":37193,"_1794":37257},[],"**Key Type:** RSA / EC (Elliptic Curve)",{"_5719":694,"_24227":670,"_20499":37259,"_5":24387,"_16438":37193,"_1794":37260},[],"**Key Size:**",{"_5719":695,"_24227":670,"_20499":37262,"_5":24387,"_16438":37193,"_1794":37263},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_5719":696,"_24227":670,"_20499":37265,"_5":24387,"_16438":37193,"_1794":37266},[],"EC: P-256, P-384, P-521",{"_5719":697,"_24227":670,"_20499":37268,"_5":24387,"_16438":37193,"_1794":37269},[],"**Recomendado:** EC P-384",{"_5719":698,"_24227":670,"_20499":37271,"_5":24387,"_16438":37193,"_1794":37272},[],"**Perfil de emisión del certificado de la CA**",{"_5719":699,"_24227":670,"_20499":37274,"_5":24387,"_16438":37193,"_1794":37275},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_5719":700,"_24227":670,"_20499":37277,"_5":24387,"_16438":37193,"_1794":37278},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_5719":701,"_24227":670,"_20499":37280,"_5":24387,"_16438":37193,"_1794":37281},[],"**Configuración de la CA**",{"_5719":702,"_24227":670,"_20499":37283,"_5":24387,"_16438":37193,"_1794":37284},[],"**Tipo de CA**",{"_5719":703,"_24227":670,"_20499":37286,"_5":24387,"_16438":37193,"_1794":37287},[],"**Root CA:** Autoridad raíz autofirmada",{"_5719":704,"_24227":670,"_20499":37289,"_5":24387,"_16438":37193,"_1794":37290},[],"**Intermediate CA:** Autoridad subordinada",{"_5719":705,"_24227":670,"_20499":37292,"_5":24387,"_16438":37193,"_1794":37293},[],"**Emisor**",{"_5719":706,"_24227":670,"_20499":37295,"_5":24387,"_16438":37193,"_1794":37296},[],"**Root CA:** Self-signed (auto-firmada)",{"_5719":707,"_24227":670,"_20499":37298,"_5":24387,"_16438":37193,"_1794":37299},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_5719":708,"_24227":670,"_20499":37301,"_5":24387,"_16438":37193,"_1794":37302},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_5719":709,"_24227":670,"_20499":37304,"_5":24387,"_16438":37193,"_1794":37305},[],"**Identificación**",{"_5719":710,"_24227":670,"_20499":37307,"_5":24387,"_16438":37193,"_1794":37308},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_5719":711,"_24227":670,"_20499":37310,"_5":24387,"_16438":37193,"_1794":37311},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_5719":712,"_24227":670,"_20499":37313,"_5":24387,"_16438":37193,"_1794":37314},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_5719":713,"_24227":670,"_20499":37316,"_5":24387,"_16438":37193,"_1794":37317},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_5719":714,"_24227":670,"_20499":37319,"_5":24387,"_16438":37193,"_1794":37320},[],"**Subject Distinguished Name (DN)**",{"_5719":715,"_24227":670,"_20499":37322,"_5":24387,"_16438":37193,"_1794":37323},[],"Campos opcionales:",{"_5719":716,"_24227":670,"_20499":37325,"_5":24387,"_16438":37193,"_1794":37326},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_5719":717,"_24227":670,"_20499":37328,"_5":24387,"_16438":37193,"_1794":37329},[],"Ejemplo: US, ES, DE",{"_5719":718,"_24227":670,"_20499":37331,"_5":24387,"_16438":37193,"_1794":37332},[],"**State/Province (ST):** Estado o provincia",{"_5719":719,"_24227":670,"_20499":37334,"_5":24387,"_16438":37193,"_1794":37335},[],"Ejemplo: California, Madrid",{"_5719":720,"_24227":670,"_20499":37337,"_5":24387,"_16438":37193,"_1794":37338},[],"**Locality (L):** Ciudad o localidad",{"_5719":721,"_24227":670,"_20499":37340,"_5":24387,"_16438":37193,"_1794":37341},[],"Ejemplo: San Francisco, Arrasate",{"_5719":722,"_24227":670,"_20499":37343,"_5":24387,"_16438":37193,"_1794":37344},[],"**Organization (O):** Nombre de la organización",{"_5719":723,"_24227":670,"_20499":37346,"_5":24387,"_16438":37193,"_1794":37347},[],"Ejemplo: Lamassu IoT Corp",{"_5719":724,"_24227":670,"_20499":37349,"_5":24387,"_16438":37193,"_1794":37350},[],"**Organizational Unit (OU):** Unidad organizacional",{"_5719":725,"_24227":670,"_20499":37352,"_5":24387,"_16438":37193,"_1794":37353},[],"Ejemplo: Secure Devices Division",{"_5719":726,"_24227":670,"_20499":37355,"_5":24387,"_16438":37193,"_1794":37356},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_5719":727,"_24227":670,"_20499":37358,"_5":24387,"_16438":37193,"_1794":37359},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_5719":728,"_24227":670,"_20499":37361,"_5":24387,"_16438":37193,"_1794":37362},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_5719":729,"_24227":670,"_20499":37364,"_5":24387,"_16438":37193,"_1794":37365},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_5719":730,"_24227":670,"_20499":37367,"_5":24387,"_16438":37193,"_1794":37368},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_5719":731,"_24227":670,"_20499":37370,"_5":24387,"_16438":37193,"_1794":37371},[],"**Duración:** Configurable según necesidades organizacionales",{"_5719":732,"_24227":670,"_20499":37373,"_5":24387,"_16438":37193,"_1794":37374},[],"**Valor por defecto:** 10 años (10y)",{"_5719":733,"_24227":670,"_20499":37376,"_5":24387,"_16438":37193,"_1794":37377},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_5719":734,"_24227":670,"_20499":37379,"_5":24387,"_16438":37193,"_1794":37380},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_5719":735,"_24227":670,"_20499":37382,"_5":24387,"_16438":37193,"_1794":37383},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_5719":736,"_24227":670,"_20499":37385,"_5":24387,"_16438":37193,"_1794":37386},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_5719":737,"_24227":670,"_20499":37388,"_5":24387,"_16438":37193,"_1794":37389},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_5719":738,"_24227":670,"_20499":37391,"_5":24387,"_16438":37193,"_1794":37392},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_5719":739,"_24227":670,"_20499":37394,"_5":24387,"_16438":37193,"_1794":37395},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_5719":740,"_24227":670,"_20499":37397,"_5":24387,"_16438":37193,"_1794":37398},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_5719":741,"_24227":670,"_20499":37400,"_5":24387,"_16438":37193,"_1794":37401},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_5719":742,"_24227":670,"_20499":37403,"_5":24387,"_16438":37193,"_1794":37404},[],"**Valor por defecto:** 1 año (1y)",{"_5719":743,"_24227":670,"_20499":37406,"_5":24387,"_16438":37193,"_1794":37407},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_5719":744,"_24227":670,"_20499":37409,"_5":24387,"_16438":37193,"_1794":37410},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_5719":745,"_24227":670,"_20499":37412,"_5":24387,"_16438":37197,"_1794":37413},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_5719":746,"_24227":670,"_20499":37415,"_5":24387,"_16438":37197,"_1794":37416},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_5719":747,"_24227":670,"_20499":37418,"_5":24387,"_16438":37197,"_1794":37419},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_5719":748,"_24227":670,"_20499":37421,"_5":24387,"_16438":37201,"_1794":37422},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_5719":749,"_24227":670,"_20499":37424,"_5":24387,"_16438":37201,"_1794":37425},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_5719":750,"_24227":670,"_20499":37427,"_5":24387,"_16438":37201,"_1794":37245},[],{"_5719":751,"_24227":670,"_20499":37429,"_5":24387,"_16438":37201,"_1794":37248},[],{"_5719":752,"_24227":670,"_20499":37431,"_5":24387,"_16438":37201,"_1794":37251},[],{"_5719":753,"_24227":670,"_20499":37433,"_5":24387,"_16438":37201,"_1794":37434},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_5719":754,"_24227":670,"_20499":37436,"_5":24387,"_16438":37201,"_1794":37395},[],{"_5719":755,"_24227":670,"_20499":37438,"_5":24387,"_16438":37201,"_1794":37398},[],{"_5719":756,"_24227":670,"_20499":37440,"_5":24387,"_16438":37201,"_1794":37401},[],{"_5719":757,"_24227":670,"_20499":37442,"_5":24387,"_16438":37201,"_1794":37404},[],{"_5719":758,"_24227":670,"_20499":37444,"_5":24387,"_16438":37201,"_1794":37407},[],{"_5719":759,"_24227":670,"_20499":37446,"_5":24387,"_16438":37201,"_1794":37447},[],"Se debe proporcionar de manera obligatoria:",{"_5719":760,"_24227":670,"_20499":37449,"_5":24387,"_16438":37201,"_1794":37450},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_5719":761,"_24227":670,"_20499":37452,"_5":24387,"_16438":37201,"_1794":37453},[],"Clave privada de la CA en formato PEM",{"_5719":762,"_24227":670,"_20499":37455,"_5":24387,"_16438":37201,"_1794":37456},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_5719":763,"_24227":670,"_20499":37458,"_5":24387,"_16438":37209,"_1794":37459},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_5719":764,"_24227":670,"_20499":37461,"_5":24387,"_16438":37209,"_1794":37462},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_5719":765,"_24227":670,"_20499":37464,"_5":24387,"_16438":37209,"_1794":37465},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_5719":766,"_24227":670,"_20499":37467,"_5":24387,"_16438":37209,"_1794":37468},[],"Se ofrecen dos acciones:",{"_5719":767,"_24227":670,"_20499":37470,"_5":24387,"_16438":37209,"_1794":37471},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_5719":768,"_24227":670,"_20499":37473,"_5":24387,"_16438":37209,"_1794":37474},[],"la acción de revocación de la CA",{"_5719":769,"_24227":670,"_20499":37476,"_5":24387,"_16438":37209,"_1794":37477},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_5719":770,"_24227":670,"_20499":37479,"_5":24387,"_16438":37213,"_1794":37480},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_5719":771,"_24227":670,"_20499":37482,"_5":24387,"_16438":37213,"_1794":37483},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_5719":772,"_24227":670,"_20499":37485,"_5":24387,"_16438":37213,"_1794":37486},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_5719":773,"_24227":670,"_20499":37488,"_5":24387,"_16438":37213,"_1794":37489},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_5719":774,"_24227":670,"_20499":37491,"_5":24387,"_16438":37213,"_1794":37492},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_5719":775,"_24227":670,"_20499":37494,"_5":24387,"_16438":37213,"_1794":37495},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_5719":776,"_24227":670,"_20499":37497,"_5":24387,"_16438":37213,"_1794":37498},[],"Emisión a partir de un CSR generado de manera externa",{"_5719":777,"_24227":670,"_20499":37500,"_5":24387,"_16438":37213,"_1794":37501},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_5719":778,"_24227":670,"_20499":37503,"_5":24387,"_16438":37213,"_1794":37504},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_5719":779,"_24227":670,"_20499":37506,"_5":24387,"_16438":37213,"_1794":37507},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_5719":780,"_24227":670,"_20499":37509,"_5":24387,"_16438":37213,"_1794":37510},[],"**Certificate Subject (Sujeto del certificado)**",{"_5719":781,"_24227":670,"_20499":37512,"_5":24387,"_16438":37213,"_1794":37513},[],"**Common Name (CN)**",{"_5719":782,"_24227":670,"_20499":37515,"_5":24387,"_16438":37213,"_1794":37516},[],"**Campo:** Obligatorio",{"_5719":783,"_24227":670,"_20499":37518,"_5":24387,"_16438":37213,"_1794":37519},[],"**Función:** Identifica de forma única al titular del certificado",{"_5719":784,"_24227":670,"_20499":37521,"_5":24387,"_16438":37213,"_1794":37522},[],"**Ejemplos:**",{"_5719":785,"_24227":670,"_20499":37524,"_5":24387,"_16438":37213,"_1794":37525},[],"Para dispositivos: device001.company.com",{"_5719":786,"_24227":670,"_20499":37527,"_5":24387,"_16438":37213,"_1794":37528},[],"Para usuarios: john.doe\\@company.com",{"_5719":787,"_24227":670,"_20499":37530,"_5":24387,"_16438":37213,"_1794":37531},[],"Para servicios: api.service.company.com",{"_5719":788,"_24227":670,"_20499":37533,"_5":24387,"_16438":37213,"_1794":37534},[],"**Campos Organizacionales**",{"_5719":789,"_24227":670,"_20499":37536,"_5":24387,"_16438":37213,"_1794":37537},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_5719":790,"_24227":670,"_20499":37539,"_5":24387,"_16438":37213,"_1794":37540},[],"Ejemplo: IT Department, Manufacturing",{"_5719":791,"_24227":670,"_20499":37542,"_5":24387,"_16438":37213,"_1794":37344},[],{"_5719":792,"_24227":670,"_20499":37544,"_5":24387,"_16438":37213,"_1794":37545},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_5719":793,"_24227":670,"_20499":37547,"_5":24387,"_16438":37213,"_1794":37548},[],"**Información Geográfica**",{"_5719":794,"_24227":670,"_20499":37550,"_5":24387,"_16438":37213,"_1794":37551},[],"**Locality (L):** Ciudad o localidad del titular",{"_5719":795,"_24227":670,"_20499":37553,"_5":24387,"_16438":37213,"_1794":37332},[],{"_5719":796,"_24227":670,"_20499":37555,"_5":24387,"_16438":37213,"_1794":37556},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_5719":797,"_24227":670,"_20499":37558,"_5":24387,"_16438":37213,"_1794":37559},[],"Valor por defecto mostrado: US",{"_5719":798,"_24227":670,"_20499":37561,"_5":24387,"_16438":37213,"_1794":37562},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_5719":799,"_24227":670,"_20499":37564,"_5":24387,"_16438":37213,"_1794":37565},[],"**Tipos de SAN Disponibles**",{"_5719":800,"_24227":670,"_20499":37567,"_5":24387,"_16438":37213,"_1794":37568},[],"**DNS:** Nombres de dominio",{"_5719":801,"_24227":670,"_20499":37570,"_5":24387,"_16438":37213,"_1794":37571},[],"Ejemplo: example.com, \\*.example.com",{"_5719":802,"_24227":670,"_20499":37573,"_5":24387,"_16438":37213,"_1794":37574},[],"**IP Address:** Direcciones IP",{"_5719":803,"_24227":670,"_20499":37576,"_5":24387,"_16438":37213,"_1794":37577},[],"**Email:** Direcciones de correo electrónico",{"_5719":804,"_24227":670,"_20499":37579,"_5":24387,"_16438":37213,"_1794":37580},[],"**URI:** Identificadores de recursos uniformes",{"_5719":805,"_24227":670,"_20499":37582,"_5":24387,"_16438":37213,"_1794":37583},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_5719":806,"_24227":670,"_20499":37585,"_5":24387,"_16438":37213,"_1794":37586},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado.",{"_5719":807,"_24227":670,"_20499":37588,"_5":24387,"_16438":37213,"_1794":37589},[],"**Algorithm (Algoritmo)**",{"_5719":808,"_24227":670,"_20499":37591,"_5":24387,"_16438":37213,"_1794":37592},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_5719":809,"_24227":670,"_20499":37594,"_5":24387,"_16438":37213,"_1794":37595},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_5719":810,"_24227":670,"_20499":37597,"_5":24387,"_16438":37213,"_1794":37598},[],"**Certificate Configuration (Configuración del certificado)**",{"_5719":811,"_24227":670,"_20499":37600,"_5":24387,"_16438":37213,"_1794":37601},[],"**Validity Duration (Duración de validez)**",{"_5719":812,"_24227":670,"_20499":37603,"_5":24387,"_16438":37213,"_1794":37604},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_5719":813,"_24227":670,"_20499":37606,"_5":24387,"_16438":37213,"_1794":37607},[],"**Campo:** Configurable según necesidades",{"_5719":814,"_24227":670,"_20499":37609,"_5":24387,"_16438":37213,"_1794":37404},[],{"_5719":815,"_24227":670,"_20499":37611,"_5":24387,"_16438":37213,"_1794":37612},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_5719":816,"_24227":670,"_20499":37614,"_5":24387,"_16438":37213,"_1794":37615},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_5719":817,"_24227":670,"_20499":37617,"_5":24387,"_16438":37213,"_1794":37618},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_5719":818,"_24227":670,"_20499":37620,"_5":24387,"_16438":37213,"_1794":37621},[],"**Usos Básicos**",{"_5719":819,"_24227":670,"_20499":37623,"_5":24387,"_16438":37213,"_1794":37624},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_5719":820,"_24227":670,"_20499":37626,"_5":24387,"_16438":37213,"_1794":37627},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_5719":821,"_24227":670,"_20499":37629,"_5":24387,"_16438":37213,"_1794":37630},[],"**Key Encipherment:** Cifrado de claves",{"_5719":822,"_24227":670,"_20499":37632,"_5":24387,"_16438":37213,"_1794":37633},[],"**Data Encipherment:** Cifrado de datos",{"_5719":823,"_24227":670,"_20499":37635,"_5":24387,"_16438":37213,"_1794":37636},[],"**Key Agreement:** Acuerdo de claves",{"_5719":824,"_24227":670,"_20499":37638,"_5":24387,"_16438":37213,"_1794":37639},[],"**Certificate Signing:** Firma de certificados",{"_5719":825,"_24227":670,"_20499":37641,"_5":24387,"_16438":37213,"_1794":37642},[],"**CRL Signing:** Firma de listas de revocación",{"_5719":826,"_24227":670,"_20499":37644,"_5":24387,"_16438":37213,"_1794":37645},[],"**Encipher Only:** Solo cifrado",{"_5719":827,"_24227":670,"_20499":37647,"_5":24387,"_16438":37213,"_1794":37648},[],"**Decipher Only:** Solo descifrado",{"_5719":828,"_24227":670,"_20499":37650,"_5":24387,"_16438":37213,"_1794":37651},[],"**Uso Extendido de Claves**",{"_5719":829,"_24227":670,"_20499":37653,"_5":24387,"_16438":37213,"_1794":37654},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_5719":830,"_24227":670,"_20499":37656,"_5":24387,"_16438":37213,"_1794":37657},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_5719":831,"_24227":670,"_20499":37659,"_5":24387,"_16438":37213,"_1794":37660},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_5719":832,"_24227":670,"_20499":37662,"_5":24387,"_16438":37213,"_1794":37663},[],"**Code Signing:** Firma de código",{"_5719":833,"_24227":670,"_20499":37665,"_5":24387,"_16438":37213,"_1794":37666},[],"**Email Protection:** Protección de correo electrónico",{"_5719":834,"_24227":670,"_20499":37668,"_5":24387,"_16438":37213,"_1794":37669},[],"**Time Stamping:** Sellado de tiempo",{"_5719":835,"_24227":670,"_20499":37671,"_5":24387,"_16438":37213,"_1794":37672},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_5719":836,"_24227":670,"_20499":37674,"_5":24387,"_16438":37213,"_1794":37675},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_5719":837,"_24227":670,"_20499":37677,"_5":24387,"_16438":37213,"_1794":37678},[],"**Emisión a partir de un CSR generado de manera externa**",{"_5719":838,"_24227":670,"_20499":37680,"_5":24387,"_16438":37213,"_1794":37681},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_5719":839,"_24227":670,"_20499":37683,"_5":24387,"_16438":37213,"_1794":37684},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_5719":840,"_24227":670,"_20499":37686,"_5":24387,"_16438":37213,"_1794":37687},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_5719":841,"_24227":670,"_20499":37689,"_5":24387,"_16438":37217,"_1794":37690},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_5719":842,"_24227":670,"_20499":37692,"_5":24387,"_16438":37217,"_1794":37693},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_5719":843,"_24227":670,"_20499":37695,"_5":24387,"_16438":37217,"_1794":37696},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_5719":844,"_24227":670,"_20499":37698,"_5":24387,"_16438":37217,"_1794":37699},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_5719":845,"_24227":670,"_20499":37701,"_5":24387,"_16438":37217,"_1794":37702},[],"Unspecified (No especificado)",{"_5719":846,"_24227":670,"_20499":37704,"_5":24387,"_16438":37217,"_1794":37705},[],"KeyCompromise (Compromiso de clave)",{"_5719":847,"_24227":670,"_20499":37707,"_5":24387,"_16438":37217,"_1794":37708},[],"CACompromise (Compromiso de CA)",{"_5719":848,"_24227":670,"_20499":37710,"_5":24387,"_16438":37217,"_1794":37711},[],"AffiliationChanged (Afiliación cambiada)",{"_5719":849,"_24227":670,"_20499":37713,"_5":24387,"_16438":37217,"_1794":37714},[],"Superseded (Sustituida)",{"_5719":850,"_24227":670,"_20499":37716,"_5":24387,"_16438":37217,"_1794":37717},[],"CessationOfOperation (Cese de operación)",{"_5719":851,"_24227":670,"_20499":37719,"_5":24387,"_16438":37217,"_1794":37720},[],"CertificateHold (Retención de certificado)",{"_5719":852,"_24227":670,"_20499":37722,"_5":24387,"_16438":37217,"_1794":37723},[],"RemoveFromCRL (Eliminar de la CRL)",{"_5719":853,"_24227":670,"_20499":37725,"_5":24387,"_16438":37217,"_1794":37726},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_5719":854,"_24227":670,"_20499":37728,"_5":24387,"_16438":37217,"_1794":37729},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_5719":855,"_24227":670,"_20499":37731,"_5":24387,"_16438":37217,"_1794":37732},[],"Consideraciones importantes:",{"_5719":856,"_24227":670,"_20499":37734,"_5":24387,"_16438":37217,"_1794":37735},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_5719":857,"_24227":670,"_20499":37737,"_5":24387,"_16438":37217,"_1794":37738},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_5719":858,"_24227":858,"_5":24382,"_1794":37740,"_24395":37741,"_20499":37742,"_16438":858},"[Certs] Gestión de Certificados",[35169,36268,36277],[],{"_5719":859,"_24227":858,"_20499":37744,"_5":24387,"_16438":858,"_1794":37745},[],"Visualización y gestión de certificados emitidos",{"_5719":860,"_24227":858,"_5":24392,"_20499":37747,"_16438":37748,"_1794":37749},[],"/docs/pr-preview/pr-25/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_5719":861,"_24227":858,"_5":24392,"_20499":37751,"_16438":37752,"_1794":37753},[],"/docs/pr-preview/pr-25/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_5719":862,"_24227":858,"_20499":37755,"_5":24387,"_16438":37748,"_1794":37756},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_5719":863,"_24227":858,"_20499":37758,"_5":24387,"_16438":37748,"_1794":37759},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_5719":864,"_24227":858,"_20499":37761,"_5":24387,"_16438":37748,"_1794":37762},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_5719":865,"_24227":858,"_20499":37764,"_5":24387,"_16438":37752,"_1794":37765},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_5719":866,"_24227":858,"_20499":37767,"_5":24387,"_16438":37752,"_1794":37768},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_5719":867,"_24227":867,"_5":24382,"_1794":37770,"_24395":37771,"_20499":37772,"_16438":867},"[Devices] Dispositivos e Identidades",[35169,36268,36277],[],{"_5719":868,"_24227":867,"_20499":37774,"_5":24387,"_16438":867,"_1794":37775},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_5719":869,"_24227":867,"_5":24392,"_20499":37777,"_16438":37778,"_1794":37779},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_5719":870,"_24227":867,"_5":24392,"_20499":37781,"_16438":37782,"_1794":37783},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_5719":871,"_24227":867,"_5":24392,"_20499":37785,"_16438":37786,"_1794":37787},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_5719":872,"_24227":867,"_5":24392,"_20499":37789,"_16438":37790,"_1794":37791},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_5719":873,"_24227":867,"_5":24392,"_20499":37793,"_16438":37794,"_1794":37795},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_5719":874,"_24227":867,"_5":24392,"_20499":37797,"_16438":37798,"_1794":37799},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_5719":875,"_24227":867,"_5":24392,"_20499":37801,"_16438":37802,"_1794":37803},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_5719":876,"_24227":867,"_5":24392,"_20499":37805,"_16438":37806,"_1794":37807},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_5719":877,"_24227":867,"_20499":37809,"_5":24387,"_16438":37778,"_1794":37810},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_5719":878,"_24227":867,"_20499":37812,"_5":24387,"_16438":37782,"_1794":37813},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_5719":879,"_24227":867,"_20499":37815,"_5":24387,"_16438":37782,"_1794":37816},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_5719":880,"_24227":867,"_20499":37818,"_5":24387,"_16438":37782,"_1794":37819},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_5719":881,"_24227":867,"_20499":37821,"_5":24387,"_16438":37782,"_1794":37822},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_5719":882,"_24227":867,"_20499":37824,"_5":24387,"_16438":37782,"_1794":37825},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_5719":883,"_24227":867,"_20499":37827,"_5":24387,"_16438":37782,"_1794":37828},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_5719":884,"_24227":867,"_20499":37830,"_5":24387,"_16438":37782,"_1794":37831},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_5719":885,"_24227":867,"_20499":37833,"_5":24387,"_16438":37782,"_1794":37834},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_5719":886,"_24227":867,"_20499":37836,"_5":24387,"_16438":37782,"_1794":37837},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_5719":887,"_24227":867,"_20499":37839,"_5":24387,"_16438":37786,"_1794":37840},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_5719":888,"_24227":867,"_20499":37842,"_5":24387,"_16438":37786,"_1794":37843},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_5719":889,"_24227":867,"_20499":37845,"_5":24387,"_16438":37790,"_1794":37846},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_5719":890,"_24227":867,"_20499":37848,"_5":24387,"_16438":37790,"_1794":37849},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_5719":891,"_24227":867,"_20499":37851,"_5":24387,"_16438":37794,"_1794":37852},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_5719":892,"_24227":867,"_20499":37854,"_5":24387,"_16438":37794,"_1794":37855},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_5719":893,"_24227":867,"_20499":37857,"_5":24387,"_16438":37794,"_1794":37858},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_5719":894,"_24227":867,"_20499":37860,"_5":24387,"_16438":37794,"_1794":37861},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_5719":895,"_24227":867,"_20499":37863,"_5":24387,"_16438":37794,"_1794":37864},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_5719":896,"_24227":867,"_20499":37866,"_5":24387,"_16438":37794,"_1794":37867},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_5719":897,"_24227":867,"_20499":37869,"_5":24387,"_16438":37794,"_1794":37870},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_5719":898,"_24227":867,"_20499":37872,"_5":24387,"_16438":37794,"_1794":37873},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_5719":899,"_24227":867,"_20499":37875,"_5":24387,"_16438":37798,"_1794":37876},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_5719":900,"_24227":867,"_20499":37878,"_5":24387,"_16438":37798,"_1794":37879},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_5719":901,"_24227":867,"_20499":37881,"_5":24387,"_16438":37798,"_1794":37882},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_5719":902,"_24227":867,"_20499":37884,"_5":24387,"_16438":37798,"_1794":37885},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_5719":903,"_24227":867,"_20499":37887,"_5":24387,"_16438":37798,"_1794":37888},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_5719":904,"_24227":867,"_20499":37890,"_5":24387,"_16438":37798,"_1794":37891},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_5719":905,"_24227":867,"_20499":37893,"_5":24387,"_16438":37802,"_1794":37894},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_5719":906,"_24227":867,"_20499":37896,"_5":24387,"_16438":37802,"_1794":37897},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_5719":907,"_24227":867,"_20499":37899,"_5":24387,"_16438":37802,"_1794":37900},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_5719":908,"_24227":867,"_20499":37902,"_5":24387,"_16438":37802,"_1794":37903},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_5719":909,"_24227":867,"_20499":37905,"_5":24387,"_16438":37802,"_1794":37906},[],"**Unspecified**: Motivo de revocación no especificado.",{"_5719":910,"_24227":867,"_20499":37908,"_5":24387,"_16438":37802,"_1794":37909},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_5719":911,"_24227":867,"_20499":37911,"_5":24387,"_16438":37802,"_1794":37912},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_5719":912,"_24227":867,"_20499":37914,"_5":24387,"_16438":37802,"_1794":37915},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_5719":913,"_24227":867,"_20499":37917,"_5":24387,"_16438":37802,"_1794":37918},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_5719":914,"_24227":867,"_20499":37920,"_5":24387,"_16438":37802,"_1794":37921},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_5719":915,"_24227":867,"_20499":37923,"_5":24387,"_16438":37802,"_1794":37924},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_5719":916,"_24227":867,"_20499":37926,"_5":24387,"_16438":37802,"_1794":37927},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_5719":917,"_24227":867,"_20499":37929,"_5":24387,"_16438":37802,"_1794":37930},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_5719":918,"_24227":867,"_20499":37932,"_5":24387,"_16438":37802,"_1794":37933},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_5719":919,"_24227":867,"_20499":37935,"_5":24387,"_16438":37802,"_1794":37936},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_5719":920,"_24227":867,"_20499":37938,"_5":24387,"_16438":37802,"_1794":37939},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_5719":921,"_24227":867,"_20499":37941,"_5":24387,"_16438":37806,"_1794":37942},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_5719":922,"_24227":867,"_20499":37944,"_5":24387,"_16438":37806,"_1794":37945},[],"El proceso se realiza de la siguiente manera:",{"_5719":923,"_24227":867,"_20499":37947,"_5":24387,"_16438":37806,"_1794":37948},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_5719":924,"_24227":867,"_20499":37950,"_5":24387,"_16438":37806,"_1794":37951},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_5719":925,"_24227":867,"_20499":37953,"_5":24387,"_16438":37806,"_1794":37954},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_5719":926,"_24227":926,"_5":24382,"_1794":37956,"_24395":37957,"_20499":37958,"_16438":926},"EST: Enrollment over Secure Transport",[35169,36268,36277],[],{"_5719":927,"_24227":926,"_20499":37960,"_5":24387,"_16438":926,"_1794":37961},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_5719":928,"_24227":926,"_5":24392,"_20499":37963,"_16438":37964,"_1794":37956},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_5719":929,"_24227":926,"_5":24392,"_20499":37966,"_16438":37967,"_1794":36351},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-del-dms",{"_5719":930,"_24227":926,"_5":24392,"_20499":37969,"_16438":37970,"_1794":35874},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos",{"_5719":931,"_24227":926,"_5":24392,"_20499":37972,"_16438":37973,"_1794":37974},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_5719":932,"_24227":926,"_5":24392,"_20499":37976,"_16438":37977,"_1794":37978},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_5719":933,"_24227":926,"_5":24392,"_20499":37980,"_16438":37981,"_1794":37982},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_5719":934,"_24227":926,"_5":24392,"_20499":37984,"_16438":37985,"_1794":37986},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_5719":935,"_24227":926,"_5":24392,"_20499":37988,"_16438":37989,"_1794":37990},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_5719":936,"_24227":926,"_5":24392,"_20499":37992,"_16438":37993,"_1794":37994},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_5719":937,"_24227":926,"_5":24392,"_20499":37996,"_16438":37997,"_1794":37998},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_5719":938,"_24227":926,"_5":24392,"_20499":38000,"_16438":38001,"_1794":38002},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_5719":939,"_24227":926,"_5":24392,"_20499":38004,"_16438":38005,"_1794":38006},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","Antes de empezar",{"_5719":940,"_24227":926,"_5":24392,"_20499":38008,"_16438":38009,"_1794":38010},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_5719":941,"_24227":926,"_5":24392,"_20499":38012,"_16438":38013,"_1794":38014},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_5719":942,"_24227":926,"_5":24392,"_20499":38016,"_16438":38017,"_1794":38018},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_5719":943,"_24227":926,"_5":24392,"_20499":38020,"_16438":38021,"_1794":38022},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#cacerts","`/cacerts`",{"_5719":944,"_24227":926,"_5":24392,"_20499":38024,"_16438":38025,"_1794":38026},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_5719":945,"_24227":926,"_5":24392,"_20499":38028,"_16438":38029,"_1794":38030},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_5719":946,"_24227":926,"_5":24392,"_20499":38032,"_16438":38033,"_1794":38034},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_5719":947,"_24227":926,"_5":24392,"_20499":38036,"_16438":38037,"_1794":38038},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#flujos-completos","Flujos completos",{"_5719":948,"_24227":926,"_5":24392,"_20499":38040,"_16438":38041,"_1794":38042},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_5719":949,"_24227":926,"_5":24392,"_20499":38044,"_16438":38045,"_1794":38046},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_5719":950,"_24227":926,"_5":24392,"_20499":38048,"_16438":38049,"_1794":38050},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_5719":951,"_24227":926,"_5":24392,"_20499":38052,"_16438":38053,"_1794":38054},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_5719":952,"_24227":926,"_5":24392,"_20499":38056,"_16438":38057,"_1794":38058},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_5719":953,"_24227":926,"_5":24392,"_20499":38060,"_16438":38061,"_1794":38062},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_5719":954,"_24227":926,"_20499":38064,"_5":24387,"_16438":37964,"_1794":38065},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_5719":955,"_24227":926,"_20499":38067,"_5":24387,"_16438":37964,"_1794":38068},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_5719":956,"_24227":926,"_20499":38070,"_5":24387,"_16438":37964,"_1794":38071},[],"Esta guía está dividida en dos partes:",{"_5719":957,"_24227":926,"_20499":38073,"_5":24387,"_16438":37964,"_1794":38074},[],"Configuración del DMS, para el administrador PKI.",{"_5719":958,"_24227":926,"_20499":38076,"_5":24387,"_16438":37964,"_1794":38077},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_5719":959,"_24227":926,"_20499":38079,"_5":24387,"_16438":37964,"_1794":38080},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_5719":960,"_24227":926,"_20499":38082,"_5":24387,"_16438":37964,"_1794":38083},[],"Perfil",{"_5719":961,"_24227":926,"_20499":38085,"_5":24387,"_16438":37964,"_1794":38086},[],"Leer primero",{"_5719":962,"_24227":926,"_20499":38088,"_5":24387,"_16438":37964,"_1794":38089},[],"Después",{"_5719":963,"_24227":926,"_20499":38091,"_5":24387,"_16438":37964,"_1794":38092},[],"Administrador PKI",{"_5719":964,"_24227":926,"_20499":38094,"_5":24387,"_16438":37964,"_1794":36351},[],{"_5719":965,"_24227":926,"_20499":38096,"_5":24387,"_16438":37964,"_1794":38054},[],{"_5719":966,"_24227":926,"_20499":38098,"_5":24387,"_16438":37964,"_1794":38099},[],"Integrador de dispositivos",{"_5719":967,"_24227":926,"_20499":38101,"_5":24387,"_16438":37964,"_1794":38006},[],{"_5719":968,"_24227":926,"_20499":38103,"_5":24387,"_16438":37964,"_1794":38104},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_5719":969,"_24227":926,"_20499":38106,"_5":24387,"_16438":37970,"_1794":38107},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_5719":970,"_24227":926,"_20499":38109,"_5":24387,"_16438":37970,"_1794":38110},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_5719":971,"_24227":926,"_20499":38112,"_5":24387,"_16438":37970,"_1794":38113},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_5719":972,"_24227":926,"_20499":38115,"_5":24387,"_16438":37970,"_1794":38116},[],"Conviene separar cuatro bloques de configuración:",{"_5719":973,"_24227":926,"_20499":38118,"_5":24387,"_16438":37970,"_1794":38119},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_5719":974,"_24227":926,"_20499":38121,"_5":24387,"_16438":37970,"_1794":38122},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_5719":975,"_24227":926,"_20499":38124,"_5":24387,"_16438":37970,"_1794":38125},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_5719":976,"_24227":926,"_20499":38127,"_5":24387,"_16438":37970,"_1794":38128},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_5719":977,"_24227":926,"_20499":38130,"_5":24387,"_16438":37977,"_1794":38131},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_5719":978,"_24227":926,"_20499":38133,"_5":24387,"_16438":37977,"_1794":38134},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_5719":979,"_24227":926,"_20499":38136,"_5":24387,"_16438":37977,"_1794":38137},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_5719":980,"_24227":926,"_20499":38139,"_5":24387,"_16438":37977,"_1794":38140},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_5719":981,"_24227":926,"_20499":38142,"_5":24387,"_16438":37981,"_1794":38143},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_5719":982,"_24227":926,"_20499":38145,"_5":24387,"_16438":37981,"_1794":38146},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_5719":983,"_24227":926,"_20499":38148,"_5":24387,"_16438":37981,"_1794":38149},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_5719":984,"_24227":926,"_20499":38151,"_5":24387,"_16438":37981,"_1794":38152},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_5719":985,"_24227":926,"_20499":38154,"_5":24387,"_16438":37981,"_1794":38155},[],"Modo",{"_5719":986,"_24227":926,"_20499":38157,"_5":24387,"_16438":37981,"_1794":35372},[],{"_5719":987,"_24227":926,"_20499":38159,"_5":24387,"_16438":37981,"_1794":38160},[],"`CLIENT_CERTIFICATE`",{"_5719":988,"_24227":926,"_20499":38162,"_5":24387,"_16438":37981,"_1794":38163},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_5719":989,"_24227":926,"_20499":38165,"_5":24387,"_16438":37981,"_1794":38166},[],"`EXTERNAL_WEBHOOK`",{"_5719":990,"_24227":926,"_20499":38168,"_5":24387,"_16438":37981,"_1794":38169},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_5719":991,"_24227":926,"_20499":38171,"_5":24387,"_16438":37981,"_1794":38172},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_5719":992,"_24227":926,"_20499":38174,"_5":24387,"_16438":37981,"_1794":38175},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_5719":993,"_24227":926,"_20499":38177,"_5":24387,"_16438":37981,"_1794":38178},[],"`NO_AUTH`",{"_5719":994,"_24227":926,"_20499":38180,"_5":24387,"_16438":37981,"_1794":38181},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_5719":995,"_24227":926,"_20499":38183,"_5":24387,"_16438":37981,"_1794":38184},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_5719":996,"_24227":926,"_20499":38186,"_5":24387,"_16438":37981,"_1794":38187},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_5719":997,"_24227":926,"_20499":38189,"_5":24387,"_16438":37981,"_1794":38190},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_5719":998,"_24227":926,"_20499":38192,"_5":24387,"_16438":37981,"_1794":38193},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_5719":999,"_24227":926,"_20499":38195,"_5":24387,"_16438":37981,"_1794":38196},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_5719":1000,"_24227":926,"_20499":38198,"_5":24387,"_16438":37981,"_1794":38199},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_5719":1001,"_24227":926,"_20499":38201,"_5":24387,"_16438":37981,"_1794":38202},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_5719":1002,"_24227":926,"_20499":38204,"_5":24387,"_16438":37981,"_1794":38205},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_5719":1003,"_24227":926,"_20499":38207,"_5":24387,"_16438":37981,"_1794":38208},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_5719":1004,"_24227":926,"_20499":38210,"_5":24387,"_16438":37981,"_1794":38211},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_5719":1005,"_24227":926,"_20499":38213,"_5":24387,"_16438":37985,"_1794":38214},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_5719":1006,"_24227":926,"_20499":38216,"_5":24387,"_16438":37985,"_1794":38217},[],"Campo",{"_5719":1007,"_24227":926,"_20499":38219,"_5":24387,"_16438":37985,"_1794":36503},[],{"_5719":1008,"_24227":926,"_20499":38221,"_5":24387,"_16438":37985,"_1794":38222},[],"Efecto sobre el certificado emitido",{"_5719":1009,"_24227":926,"_20499":38224,"_5":24387,"_16438":37985,"_1794":38225},[],"`HonorSubject`",{"_5719":1010,"_24227":926,"_20499":38227,"_5":24387,"_16438":37985,"_1794":22304},[],{"_5719":1011,"_24227":926,"_20499":38229,"_5":24387,"_16438":37985,"_1794":38230},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_5719":1012,"_24227":926,"_20499":38232,"_5":24387,"_16438":37985,"_1794":38233},[],"`HonorKeyUsage`",{"_5719":1013,"_24227":926,"_20499":38235,"_5":24387,"_16438":37985,"_1794":22304},[],{"_5719":1014,"_24227":926,"_20499":38237,"_5":24387,"_16438":37985,"_1794":38238},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_5719":1015,"_24227":926,"_20499":38240,"_5":24387,"_16438":37985,"_1794":38241},[],"`HonorExtendedKeyUsages`",{"_5719":1016,"_24227":926,"_20499":38243,"_5":24387,"_16438":37985,"_1794":22304},[],{"_5719":1017,"_24227":926,"_20499":38245,"_5":24387,"_16438":37985,"_1794":38246},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_5719":1018,"_24227":926,"_20499":38248,"_5":24387,"_16438":37985,"_1794":38249},[],"`HonorExtensions`",{"_5719":1019,"_24227":926,"_20499":38251,"_5":24387,"_16438":37985,"_1794":22304},[],{"_5719":1020,"_24227":926,"_20499":38253,"_5":24387,"_16438":37985,"_1794":38254},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_5719":1021,"_24227":926,"_20499":38256,"_5":24387,"_16438":37985,"_1794":38257},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_5719":1022,"_24227":926,"_20499":38259,"_5":24387,"_16438":37989,"_1794":38260},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_5719":1023,"_24227":926,"_20499":38262,"_5":24387,"_16438":37989,"_1794":38263},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_5719":1024,"_24227":926,"_20499":38265,"_5":24387,"_16438":37989,"_1794":38266},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_5719":1025,"_24227":926,"_20499":38268,"_5":24387,"_16438":37989,"_1794":38269},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_5719":1026,"_24227":926,"_20499":38271,"_5":24387,"_16438":37989,"_1794":38272},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_5719":1027,"_24227":926,"_20499":38274,"_5":24387,"_16438":37989,"_1794":38275},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_5719":1028,"_24227":926,"_20499":38277,"_5":24387,"_16438":37989,"_1794":38278},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_5719":1029,"_24227":926,"_20499":38280,"_5":24387,"_16438":37993,"_1794":38281},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_5719":1030,"_24227":926,"_20499":38283,"_5":24387,"_16438":37993,"_1794":38284},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_5719":1031,"_24227":926,"_20499":38286,"_5":24387,"_16438":37993,"_1794":38287},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_5719":1032,"_24227":926,"_20499":38289,"_5":24387,"_16438":37993,"_1794":38290},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_5719":1033,"_24227":926,"_20499":38292,"_5":24387,"_16438":37997,"_1794":38293},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_5719":1034,"_24227":926,"_20499":38295,"_5":24387,"_16438":37997,"_1794":38296},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_5719":1035,"_24227":926,"_20499":38298,"_5":24387,"_16438":37997,"_1794":38299},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_5719":1036,"_24227":926,"_20499":38301,"_5":24387,"_16438":37997,"_1794":38302},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_5719":1037,"_24227":926,"_20499":38304,"_5":24387,"_16438":38001,"_1794":38305},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_5719":1038,"_24227":926,"_20499":38307,"_5":24387,"_16438":38001,"_1794":38308},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_5719":1039,"_24227":926,"_20499":38310,"_5":24387,"_16438":38001,"_1794":38311},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_5719":1040,"_24227":926,"_20499":38313,"_5":24387,"_16438":38005,"_1794":38314},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_5719":1041,"_24227":926,"_20499":38316,"_5":24387,"_16438":38005,"_1794":38317},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_5719":1042,"_24227":926,"_20499":38319,"_5":24387,"_16438":38005,"_1794":38320},[],"Elemento",{"_5719":1043,"_24227":926,"_20499":38322,"_5":24387,"_16438":38005,"_1794":35372},[],{"_5719":1044,"_24227":926,"_20499":38324,"_5":24387,"_16438":38005,"_1794":38325},[],"**URL del host EST**",{"_5719":1045,"_24227":926,"_20499":38327,"_5":24387,"_16438":38005,"_1794":38328},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_5719":1046,"_24227":926,"_20499":38330,"_5":24387,"_16438":38005,"_1794":38331},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_5719":1047,"_24227":926,"_20499":38333,"_5":24387,"_16438":38005,"_1794":38334},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_5719":1048,"_24227":926,"_20499":38336,"_5":24387,"_16438":38005,"_1794":38337},[],"**Certificado bootstrap + clave privada**",{"_5719":1049,"_24227":926,"_20499":38339,"_5":24387,"_16438":38005,"_1794":38340},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_5719":1050,"_24227":926,"_20499":38342,"_5":24387,"_16438":38005,"_1794":38343},[],"**ID del DMS** (`{aps}`)",{"_5719":1051,"_24227":926,"_20499":38345,"_5":24387,"_16438":38005,"_1794":38346},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_5719":1052,"_24227":926,"_20499":38348,"_5":24387,"_16438":38009,"_1794":38349},[],"Caso",{"_5719":1053,"_24227":926,"_20499":38351,"_5":24387,"_16438":38009,"_1794":38352},[],"Credencial habitual",{"_5719":1054,"_24227":926,"_20499":38354,"_5":24387,"_16438":38009,"_1794":38355},[],"Endpoint principal",{"_5719":1055,"_24227":926,"_20499":38357,"_5":24387,"_16438":38009,"_1794":38358},[],"Resultado",{"_5719":1056,"_24227":926,"_20499":38360,"_5":24387,"_16438":38009,"_1794":38361},[],"Alta inicial",{"_5719":1057,"_24227":926,"_20499":38363,"_5":24387,"_16438":38009,"_1794":38364},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_5719":1058,"_24227":926,"_20499":38366,"_5":24387,"_16438":38009,"_1794":38026},[],{"_5719":1059,"_24227":926,"_20499":38368,"_5":24387,"_16438":38009,"_1794":38369},[],"Certificado de dispositivo",{"_5719":1060,"_24227":926,"_20499":38371,"_5":24387,"_16438":38009,"_1794":38372},[],"Renovación",{"_5719":1061,"_24227":926,"_20499":38374,"_5":24387,"_16438":38009,"_1794":38375},[],"Certificado actual del dispositivo",{"_5719":1062,"_24227":926,"_20499":38377,"_5":24387,"_16438":38009,"_1794":38030},[],{"_5719":1063,"_24227":926,"_20499":38379,"_5":24387,"_16438":38009,"_1794":38380},[],"Certificado renovado",{"_5719":1064,"_24227":926,"_20499":38382,"_5":24387,"_16438":38009,"_1794":38383},[],"Descarga de confianza",{"_5719":1065,"_24227":926,"_20499":38385,"_5":24387,"_16438":38009,"_1794":38386},[],"TLS del servidor",{"_5719":1066,"_24227":926,"_20499":38388,"_5":24387,"_16438":38009,"_1794":38022},[],{"_5719":1067,"_24227":926,"_20499":38390,"_5":24387,"_16438":38009,"_1794":38391},[],"PKCS#7 o PEM con certificados",{"_5719":1068,"_24227":926,"_20499":38393,"_5":24387,"_16438":38009,"_1794":38394},[],"Clave generada en servidor",{"_5719":1069,"_24227":926,"_20499":38396,"_5":24387,"_16438":38009,"_1794":38397},[],"Igual que `/simpleenroll`",{"_5719":1070,"_24227":926,"_20499":38399,"_5":24387,"_16438":38009,"_1794":38034},[],{"_5719":1071,"_24227":926,"_20499":38401,"_5":24387,"_16438":38009,"_1794":38402},[],"Clave privada PKCS#8 + certificado",{"_5719":1072,"_24227":926,"_20499":38404,"_5":24387,"_16438":38013,"_1794":38405},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_5719":1073,"_24227":926,"_20499":38407,"_5":24387,"_16438":38013,"_1794":38408},[],"Modo (`AuthMode`)",{"_5719":1074,"_24227":926,"_20499":38410,"_5":24387,"_16438":38013,"_1794":35372},[],{"_5719":1075,"_24227":926,"_20499":38412,"_5":24387,"_16438":38013,"_1794":38413},[],"Credencial esperada",{"_5719":1076,"_24227":926,"_20499":38415,"_5":24387,"_16438":38013,"_1794":38416},[],"Aplica en enroll",{"_5719":1077,"_24227":926,"_20499":38418,"_5":24387,"_16438":38013,"_1794":38419},[],"Aplica en reenroll",{"_5719":1078,"_24227":926,"_20499":38421,"_5":24387,"_16438":38013,"_1794":38160},[],{"_5719":1079,"_24227":926,"_20499":38423,"_5":24387,"_16438":38013,"_1794":38424},[],"mTLS con certificado X.509",{"_5719":1080,"_24227":926,"_20499":38426,"_5":24387,"_16438":38013,"_1794":38427},[],"Certificado y clave privada cliente",{"_5719":1081,"_24227":926,"_20499":38429,"_5":24387,"_16438":38013,"_1794":36516},[],{"_5719":1082,"_24227":926,"_20499":38431,"_5":24387,"_16438":38013,"_1794":38432},[],"Sí (con el certificado en vigor)",{"_5719":1083,"_24227":926,"_20499":38434,"_5":24387,"_16438":38013,"_1794":38172},[],{"_5719":1084,"_24227":926,"_20499":38436,"_5":24387,"_16438":38013,"_1794":38437},[],"mTLS más validación por webhook",{"_5719":1085,"_24227":926,"_20499":38439,"_5":24387,"_16438":38013,"_1794":38440},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_5719":1086,"_24227":926,"_20499":38442,"_5":24387,"_16438":38013,"_1794":36516},[],{"_5719":1087,"_24227":926,"_20499":38444,"_5":24387,"_16438":38013,"_1794":38445},[],"No como combinación; en reenroll no mantiene ambos controles",{"_5719":1088,"_24227":926,"_20499":38447,"_5":24387,"_16438":38013,"_1794":38166},[],{"_5719":1089,"_24227":926,"_20499":38449,"_5":24387,"_16438":38013,"_1794":38450},[],"Webhook externo de autorización",{"_5719":1090,"_24227":926,"_20499":38452,"_5":24387,"_16438":38013,"_1794":38453},[],"Ninguna en el canal TLS",{"_5719":1091,"_24227":926,"_20499":38455,"_5":24387,"_16438":38013,"_1794":36516},[],{"_5719":1092,"_24227":926,"_20499":38457,"_5":24387,"_16438":38013,"_1794":38458},[],"No, degrada a `NO_AUTH`",{"_5719":1093,"_24227":926,"_20499":38460,"_5":24387,"_16438":38013,"_1794":38178},[],{"_5719":1094,"_24227":926,"_20499":38462,"_5":24387,"_16438":38013,"_1794":38463},[],"Sin autenticación",{"_5719":1095,"_24227":926,"_20499":38465,"_5":24387,"_16438":38013,"_1794":38466},[],"Ninguna",{"_5719":1096,"_24227":926,"_20499":38468,"_5":24387,"_16438":38013,"_1794":38469},[],"Sí (uso restringido)",{"_5719":1097,"_24227":926,"_20499":38471,"_5":24387,"_16438":38013,"_1794":38469},[],{"_5719":1098,"_24227":926,"_20499":38473,"_5":24387,"_16438":38013,"_1794":38474},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_5719":1099,"_24227":926,"_20499":38476,"_5":24387,"_16438":38013,"_1794":38477},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_5719":1100,"_24227":926,"_20499":38479,"_5":24387,"_16438":38013,"_1794":36500},[],{"_5719":1101,"_24227":926,"_20499":38481,"_5":24387,"_16438":38013,"_1794":36503},[],{"_5719":1102,"_24227":926,"_20499":38483,"_5":24387,"_16438":38013,"_1794":35372},[],{"_5719":1103,"_24227":926,"_20499":38485,"_5":24387,"_16438":38013,"_1794":38486},[],"`ValidationCAs`",{"_5719":1104,"_24227":926,"_20499":38488,"_5":24387,"_16438":38013,"_1794":38489},[],"lista de IDs de CA",{"_5719":1105,"_24227":926,"_20499":38491,"_5":24387,"_16438":38013,"_1794":38492},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_5719":1106,"_24227":926,"_20499":38494,"_5":24387,"_16438":38013,"_1794":38495},[],"`AllowExpired`",{"_5719":1107,"_24227":926,"_20499":38497,"_5":24387,"_16438":38013,"_1794":22304},[],{"_5719":1108,"_24227":926,"_20499":38499,"_5":24387,"_16438":38013,"_1794":38500},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_5719":1109,"_24227":926,"_20499":38502,"_5":24387,"_16438":38013,"_1794":38503},[],"`ChainLevelValidation`",{"_5719":1110,"_24227":926,"_20499":38505,"_5":24387,"_16438":38013,"_1794":4742},[],{"_5719":1111,"_24227":926,"_20499":38507,"_5":24387,"_16438":38013,"_1794":38508},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_5719":1112,"_24227":926,"_20499":38510,"_5":24387,"_16438":38013,"_1794":38511},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_5719":1113,"_24227":926,"_20499":38513,"_5":24387,"_16438":38013,"_1794":38514},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_5719":1114,"_24227":926,"_20499":38516,"_5":24387,"_16438":38013,"_1794":38517},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_5719":1115,"_24227":926,"_20499":38519,"_5":24387,"_16438":38013,"_1794":38520},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_5719":1116,"_24227":926,"_20499":38522,"_5":24387,"_16438":38017,"_1794":38523},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_5719":1117,"_24227":926,"_20499":38525,"_5":24387,"_16438":38017,"_1794":38526},[],"`/cacerts`: descarga de la cadena de confianza.",{"_5719":1118,"_24227":926,"_20499":38528,"_5":24387,"_16438":38017,"_1794":38529},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_5719":1119,"_24227":926,"_20499":38531,"_5":24387,"_16438":38017,"_1794":38532},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_5719":1120,"_24227":926,"_20499":38534,"_5":24387,"_16438":38017,"_1794":38535},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_5719":1121,"_24227":926,"_20499":38537,"_5":24387,"_16438":38021,"_1794":38538},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_5719":1122,"_24227":926,"_20499":38540,"_5":24387,"_16438":38021,"_1794":38541},[],"Campo de `CADistributionSettings`",{"_5719":1123,"_24227":926,"_20499":38543,"_5":24387,"_16438":38021,"_1794":36503},[],{"_5719":1124,"_24227":926,"_20499":38545,"_5":24387,"_16438":38021,"_1794":35372},[],{"_5719":1125,"_24227":926,"_20499":38547,"_5":24387,"_16438":38021,"_1794":38548},[],"`IncludeLamassuSystemCA`",{"_5719":1126,"_24227":926,"_20499":38550,"_5":24387,"_16438":38021,"_1794":22304},[],{"_5719":1127,"_24227":926,"_20499":38552,"_5":24387,"_16438":38021,"_1794":38553},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_5719":1128,"_24227":926,"_20499":38555,"_5":24387,"_16438":38021,"_1794":38556},[],"`IncludeEnrollmentCA`",{"_5719":1129,"_24227":926,"_20499":38558,"_5":24387,"_16438":38021,"_1794":22304},[],{"_5719":1130,"_24227":926,"_20499":38560,"_5":24387,"_16438":38021,"_1794":38561},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_5719":1131,"_24227":926,"_20499":38563,"_5":24387,"_16438":38021,"_1794":38564},[],"`ManagedCAs`",{"_5719":1132,"_24227":926,"_20499":38566,"_5":24387,"_16438":38021,"_1794":38489},[],{"_5719":1133,"_24227":926,"_20499":38568,"_5":24387,"_16438":38021,"_1794":38569},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_5719":1134,"_24227":926,"_20499":38571,"_5":24387,"_16438":38021,"_1794":38572},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_5719":1135,"_24227":926,"_20499":38574,"_5":24387,"_16438":38021,"_1794":38575},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_5719":1136,"_24227":926,"_20499":38577,"_5":24387,"_16438":38021,"_1794":38578},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_5719":1137,"_24227":926,"_20499":38580,"_5":24387,"_16438":38021,"_1794":38581},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_5719":1138,"_24227":926,"_20499":38583,"_5":24387,"_16438":38025,"_1794":38584},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_5719":1139,"_24227":926,"_20499":38586,"_5":24387,"_16438":38025,"_1794":38587},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_5719":1140,"_24227":926,"_20499":38589,"_5":24387,"_16438":38025,"_1794":38590},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_5719":1141,"_24227":926,"_20499":38592,"_5":24387,"_16438":38025,"_1794":38217},[],{"_5719":1142,"_24227":926,"_20499":38594,"_5":24387,"_16438":38025,"_1794":36503},[],{"_5719":1143,"_24227":926,"_20499":38596,"_5":24387,"_16438":38025,"_1794":38597},[],"Efecto",{"_5719":1144,"_24227":926,"_20499":38599,"_5":24387,"_16438":38025,"_1794":38600},[],"`EnrollmentSettings.RegistrationMode`",{"_5719":1145,"_24227":926,"_20499":38602,"_5":24387,"_16438":38025,"_1794":38603},[],"`JITP` / `PRE_REGISTRATION`",{"_5719":1146,"_24227":926,"_20499":38605,"_5":24387,"_16438":38025,"_1794":38606},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_5719":1147,"_24227":926,"_20499":38608,"_5":24387,"_16438":38025,"_1794":38609},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_5719":1148,"_24227":926,"_20499":38611,"_5":24387,"_16438":38025,"_1794":22304},[],{"_5719":1149,"_24227":926,"_20499":38613,"_5":24387,"_16438":38025,"_1794":38614},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_5719":1150,"_24227":926,"_20499":38616,"_5":24387,"_16438":38025,"_1794":38617},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_5719":1151,"_24227":926,"_20499":38619,"_5":24387,"_16438":38025,"_1794":22304},[],{"_5719":1152,"_24227":926,"_20499":38621,"_5":24387,"_16438":38025,"_1794":38622},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_5719":1153,"_24227":926,"_20499":38624,"_5":24387,"_16438":38025,"_1794":38625},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_5719":1154,"_24227":926,"_20499":38627,"_5":24387,"_16438":38029,"_1794":38628},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_5719":1155,"_24227":926,"_20499":38630,"_5":24387,"_16438":38029,"_1794":38631},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_5719":1156,"_24227":926,"_20499":38633,"_5":24387,"_16438":38029,"_1794":38634},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_5719":1157,"_24227":926,"_20499":38636,"_5":24387,"_16438":38029,"_1794":38217},[],{"_5719":1158,"_24227":926,"_20499":38638,"_5":24387,"_16438":38029,"_1794":36503},[],{"_5719":1159,"_24227":926,"_20499":38640,"_5":24387,"_16438":38029,"_1794":38597},[],{"_5719":1160,"_24227":926,"_20499":38642,"_5":24387,"_16438":38029,"_1794":38643},[],"`ReEnrollmentDelta`",{"_5719":1161,"_24227":926,"_20499":38645,"_5":24387,"_16438":38029,"_1794":38646},[],"duración",{"_5719":1162,"_24227":926,"_20499":38648,"_5":24387,"_16438":38029,"_1794":38649},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_5719":1163,"_24227":926,"_20499":38651,"_5":24387,"_16438":38029,"_1794":38652},[],"`EnableExpiredRenewal`",{"_5719":1164,"_24227":926,"_20499":38654,"_5":24387,"_16438":38029,"_1794":22304},[],{"_5719":1165,"_24227":926,"_20499":38656,"_5":24387,"_16438":38029,"_1794":38657},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_5719":1166,"_24227":926,"_20499":38659,"_5":24387,"_16438":38029,"_1794":38660},[],"`RevokeOnReEnrollment`",{"_5719":1167,"_24227":926,"_20499":38662,"_5":24387,"_16438":38029,"_1794":22304},[],{"_5719":1168,"_24227":926,"_20499":38664,"_5":24387,"_16438":38029,"_1794":38665},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_5719":1169,"_24227":926,"_20499":38667,"_5":24387,"_16438":38029,"_1794":38668},[],"`AdditionalValidationCAs`",{"_5719":1170,"_24227":926,"_20499":38670,"_5":24387,"_16438":38029,"_1794":38489},[],{"_5719":1171,"_24227":926,"_20499":38672,"_5":24387,"_16438":38029,"_1794":38673},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_5719":1172,"_24227":926,"_20499":38675,"_5":24387,"_16438":38029,"_1794":38676},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_5719":1173,"_24227":926,"_20499":38678,"_5":24387,"_16438":38029,"_1794":38679},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_5719":1174,"_24227":926,"_20499":38681,"_5":24387,"_16438":38033,"_1794":38682},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_5719":1175,"_24227":926,"_20499":38684,"_5":24387,"_16438":38033,"_1794":38685},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_5719":1176,"_24227":926,"_20499":38687,"_5":24387,"_16438":38033,"_1794":38688},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_5719":1177,"_24227":926,"_20499":38690,"_5":24387,"_16438":38033,"_1794":38691},[],"Tipo de clave",{"_5719":1178,"_24227":926,"_20499":38693,"_5":24387,"_16438":38033,"_1794":38694},[],"Parámetro válido",{"_5719":1179,"_24227":926,"_20499":38696,"_5":24387,"_16438":38033,"_1794":38697},[],"Curva NIST equivalente",{"_5719":1180,"_24227":926,"_20499":38699,"_5":24387,"_16438":38033,"_1794":38700},[],"Comportamiento ante valores no válidos",{"_5719":1181,"_24227":926,"_20499":38702,"_5":24387,"_16438":38033,"_1794":38703},[],"`RSA`",{"_5719":1182,"_24227":926,"_20499":38705,"_5":24387,"_16438":38033,"_1794":38706},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_5719":1183,"_24227":926,"_20499":38708,"_5":24387,"_16438":38033,"_1794":38709},[],"No aplica",{"_5719":1184,"_24227":926,"_20499":38711,"_5":24387,"_16438":38033,"_1794":38712},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_5719":1185,"_24227":926,"_20499":38714,"_5":24387,"_16438":38033,"_1794":38715},[],"`ECDSA`",{"_5719":1186,"_24227":926,"_20499":38717,"_5":24387,"_16438":38033,"_1794":38718},[],"224, 256, 384, 521",{"_5719":1187,"_24227":926,"_20499":38720,"_5":24387,"_16438":38033,"_1794":38721},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_5719":1188,"_24227":926,"_20499":38723,"_5":24387,"_16438":38033,"_1794":38724},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_5719":1189,"_24227":926,"_20499":38726,"_5":24387,"_16438":38033,"_1794":38727},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_5719":1190,"_24227":926,"_20499":38729,"_5":24387,"_16438":38033,"_1794":38730},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_5719":1191,"_24227":926,"_20499":38732,"_5":24387,"_16438":38033,"_1794":38733},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_5719":1192,"_24227":926,"_20499":38735,"_5":24387,"_16438":38033,"_1794":38736},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_5719":1193,"_24227":926,"_20499":38738,"_5":24387,"_16438":38033,"_1794":38739},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_5719":1194,"_24227":926,"_20499":38741,"_5":24387,"_16438":38033,"_1794":38742},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_5719":1195,"_24227":926,"_20499":38744,"_5":24387,"_16438":38033,"_1794":38745},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_5719":1196,"_24227":926,"_20499":38747,"_5":24387,"_16438":38037,"_1794":38748},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_5719":1197,"_24227":926,"_20499":38750,"_5":24387,"_16438":38041,"_1794":38751},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_5719":1198,"_24227":926,"_20499":38753,"_5":24387,"_16438":38045,"_1794":38754},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_5719":1199,"_24227":926,"_20499":38756,"_5":24387,"_16438":38049,"_1794":38757},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_5719":1200,"_24227":926,"_20499":38759,"_5":24387,"_16438":38049,"_1794":38760},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_5719":1201,"_24227":926,"_20499":38762,"_5":24387,"_16438":38049,"_1794":38763},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_5719":1202,"_24227":926,"_20499":38765,"_5":24387,"_16438":38049,"_1794":38766},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_5719":1203,"_24227":926,"_20499":38768,"_5":24387,"_16438":38057,"_1794":38769},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_5719":1204,"_24227":926,"_20499":38771,"_5":24387,"_16438":38057,"_1794":38772},[],"HTTP",{"_5719":1205,"_24227":926,"_20499":38774,"_5":24387,"_16438":38057,"_1794":38775},[],"Mensaje",{"_5719":1206,"_24227":926,"_20499":38777,"_5":24387,"_16438":38057,"_1794":38778},[],"Causa",{"_5719":1207,"_24227":926,"_20499":38780,"_5":24387,"_16438":38057,"_1794":38781},[],"Acción del integrador",{"_5719":1208,"_24227":926,"_20499":38783,"_5":24387,"_16438":38057,"_1794":21348},[],{"_5719":1209,"_24227":926,"_20499":38785,"_5":24387,"_16438":38057,"_1794":38786},[],"`Field validation for 'APS' failed`",{"_5719":1210,"_24227":926,"_20499":38788,"_5":24387,"_16438":38057,"_1794":38789},[],"El segmento `{aps}` falta en la URL.",{"_5719":1211,"_24227":926,"_20499":38791,"_5":24387,"_16438":38057,"_1794":38792},[],"Incluir el ID del DMS en la ruta.",{"_5719":1212,"_24227":926,"_20499":38794,"_5":24387,"_16438":38057,"_1794":21348},[],{"_5719":1213,"_24227":926,"_20499":38796,"_5":24387,"_16438":38057,"_1794":38797},[],"`content-type must be application/pkcs10`",{"_5719":1214,"_24227":926,"_20499":38799,"_5":24387,"_16438":38057,"_1794":38800},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_5719":1215,"_24227":926,"_20499":38802,"_5":24387,"_16438":38057,"_1794":38803},[],"Fijar `Content-Type: application/pkcs10`.",{"_5719":1216,"_24227":926,"_20499":38805,"_5":24387,"_16438":38057,"_1794":21348},[],{"_5719":1217,"_24227":926,"_20499":38807,"_5":24387,"_16438":38057,"_1794":38808},[],"`body payload must be base64 encoded`",{"_5719":1218,"_24227":926,"_20499":38810,"_5":24387,"_16438":38057,"_1794":38811},[],"El cuerpo no es base64 válido.",{"_5719":1219,"_24227":926,"_20499":38813,"_5":24387,"_16438":38057,"_1794":38814},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_5719":1220,"_24227":926,"_20499":38816,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1221,"_24227":926,"_20499":38818,"_5":24387,"_16438":38057,"_1794":38819},[],"`DMS not found`",{"_5719":1222,"_24227":926,"_20499":38821,"_5":24387,"_16438":38057,"_1794":38822},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_5719":1223,"_24227":926,"_20499":38824,"_5":24387,"_16438":38057,"_1794":38825},[],"Verificar el identificador con el administrador PKI.",{"_5719":1224,"_24227":926,"_20499":38827,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1225,"_24227":926,"_20499":38829,"_5":24387,"_16438":38057,"_1794":38830},[],"`invalid certificate`",{"_5719":1226,"_24227":926,"_20499":38832,"_5":24387,"_16438":38057,"_1794":38833},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_5719":1227,"_24227":926,"_20499":38835,"_5":24387,"_16438":38057,"_1794":38836},[],"Comprobar la cadena del certificado bootstrap.",{"_5719":1228,"_24227":926,"_20499":38838,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1229,"_24227":926,"_20499":38840,"_5":24387,"_16438":38057,"_1794":38841},[],"`certificate is revoked`",{"_5719":1230,"_24227":926,"_20499":38843,"_5":24387,"_16438":38057,"_1794":38844},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_5719":1231,"_24227":926,"_20499":38846,"_5":24387,"_16438":38057,"_1794":38847},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_5719":1232,"_24227":926,"_20499":38849,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1233,"_24227":926,"_20499":38851,"_5":24387,"_16438":38057,"_1794":38852},[],"`revoked certificate`",{"_5719":1234,"_24227":926,"_20499":38854,"_5":24387,"_16438":38057,"_1794":38855},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_5719":1235,"_24227":926,"_20499":38857,"_5":24387,"_16438":38057,"_1794":38858},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_5719":1236,"_24227":926,"_20499":38860,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1237,"_24227":926,"_20499":38862,"_5":24387,"_16438":38057,"_1794":38863},[],"`expired certificate`",{"_5719":1238,"_24227":926,"_20499":38865,"_5":24387,"_16438":38057,"_1794":38866},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_5719":1239,"_24227":926,"_20499":38868,"_5":24387,"_16438":38057,"_1794":38869},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_5719":1240,"_24227":926,"_20499":38871,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1241,"_24227":926,"_20499":38873,"_5":24387,"_16438":38057,"_1794":38874},[],"`forbiddenNewEnrollment`",{"_5719":1242,"_24227":926,"_20499":38876,"_5":24387,"_16438":38057,"_1794":38877},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_5719":1243,"_24227":926,"_20499":38879,"_5":24387,"_16438":38057,"_1794":38880},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_5719":1244,"_24227":926,"_20499":38882,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1245,"_24227":926,"_20499":38884,"_5":24387,"_16438":38057,"_1794":38885},[],"`device not preregistered`",{"_5719":1246,"_24227":926,"_20499":38887,"_5":24387,"_16438":38057,"_1794":38888},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_5719":1247,"_24227":926,"_20499":38890,"_5":24387,"_16438":38057,"_1794":38891},[],"Registrar el dispositivo antes de inscribirlo.",{"_5719":1248,"_24227":926,"_20499":38893,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1249,"_24227":926,"_20499":38895,"_5":24387,"_16438":38057,"_1794":38896},[],"`invalid reenroll window`",{"_5719":1250,"_24227":926,"_20499":38898,"_5":24387,"_16438":38057,"_1794":38899},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_5719":1251,"_24227":926,"_20499":38901,"_5":24387,"_16438":38057,"_1794":38902},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_5719":1252,"_24227":926,"_20499":38904,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1253,"_24227":926,"_20499":38906,"_5":24387,"_16438":38057,"_1794":38907},[],"`invalid RawSubject bytes`",{"_5719":1254,"_24227":926,"_20499":38909,"_5":24387,"_16438":38057,"_1794":38910},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_5719":1255,"_24227":926,"_20499":38912,"_5":24387,"_16438":38057,"_1794":38913},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_5719":1256,"_24227":926,"_20499":38915,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1257,"_24227":926,"_20499":38917,"_5":24387,"_16438":38057,"_1794":38918},[],"`external webhook denied enrollment`",{"_5719":1258,"_24227":926,"_20499":38920,"_5":24387,"_16438":38057,"_1794":38921},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_5719":1259,"_24227":926,"_20499":38923,"_5":24387,"_16438":38057,"_1794":38924},[],"Revisar los logs del servicio webhook.",{"_5719":1260,"_24227":926,"_20499":38926,"_5":24387,"_16438":38057,"_1794":21904},[],{"_5719":1261,"_24227":926,"_20499":38928,"_5":24387,"_16438":38057,"_1794":38929},[],"`server key generation not enabled`",{"_5719":1262,"_24227":926,"_20499":38931,"_5":24387,"_16438":38057,"_1794":38932},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_5719":1263,"_24227":926,"_20499":38934,"_5":24387,"_16438":38057,"_1794":38935},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_5719":1264,"_24227":926,"_20499":38937,"_5":24387,"_16438":38057,"_1794":38938},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_5719":1265,"_24227":926,"_20499":38940,"_5":24387,"_16438":38061,"_1794":38941},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_5719":1266,"_24227":926,"_20499":38943,"_5":24387,"_16438":38061,"_1794":38944},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_5719":1267,"_24227":926,"_20499":38946,"_5":24387,"_16438":38061,"_1794":38947},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_5719":1268,"_24227":926,"_20499":38949,"_5":24387,"_16438":38061,"_1794":38950},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_5719":1269,"_24227":926,"_20499":38952,"_5":24387,"_16438":38061,"_1794":38953},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_5719":1270,"_24227":926,"_20499":38955,"_5":24387,"_16438":38061,"_1794":38956},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_5719":1271,"_24227":926,"_20499":38958,"_5":24387,"_16438":38061,"_1794":38959},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_5719":1272,"_24227":926,"_20499":38961,"_5":24387,"_16438":38061,"_1794":38962},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_5719":1273,"_24227":926,"_20499":38964,"_5":24387,"_16438":38061,"_1794":38965},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_5719":1274,"_24227":926,"_20499":38967,"_5":24387,"_16438":38061,"_1794":38968},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_5719":1275,"_24227":1275,"_5":24382,"_1794":38970,"_24395":38971,"_20499":38972,"_16438":1275},"[KMS] Gestión de Claves Criptográficas",[35169,36268,36277],[],{"_5719":1276,"_24227":1275,"_20499":38974,"_5":24387,"_16438":1275,"_1794":38975},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_5719":1277,"_24227":1275,"_5":24392,"_20499":38977,"_16438":38978,"_1794":38979},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_5719":1278,"_24227":1275,"_5":24392,"_20499":38981,"_16438":38982,"_1794":38983},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_5719":1279,"_24227":1275,"_5":24392,"_20499":38985,"_16438":38986,"_1794":38987},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_5719":1280,"_24227":1275,"_5":24392,"_20499":38989,"_16438":38990,"_1794":38991},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_5719":1281,"_24227":1275,"_5":24392,"_20499":38993,"_16438":38994,"_1794":38995},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_5719":1282,"_24227":1275,"_5":24392,"_20499":38997,"_16438":38998,"_1794":38999},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_5719":1283,"_24227":1275,"_5":24392,"_20499":39001,"_16438":39002,"_1794":39003},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_5719":1284,"_24227":1275,"_5":24392,"_20499":39005,"_16438":39006,"_1794":39007},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_5719":1285,"_24227":1275,"_5":24392,"_20499":39009,"_16438":39010,"_1794":39011},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_5719":1286,"_24227":1275,"_5":24392,"_20499":39013,"_16438":39014,"_1794":39015},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_5719":1287,"_24227":1275,"_5":24392,"_20499":39017,"_16438":39018,"_1794":39019},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#sign","Sign",{"_5719":1288,"_24227":1275,"_5":24392,"_20499":39021,"_16438":39022,"_1794":39023},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#verify","Verify",{"_5719":1289,"_24227":1275,"_5":24392,"_20499":39025,"_16438":39026,"_1794":39027},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_5719":1290,"_24227":1275,"_5":24392,"_20499":39029,"_16438":39030,"_1794":39031},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_5719":1291,"_24227":1275,"_20499":39033,"_5":24387,"_16438":38978,"_1794":39034},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_5719":1292,"_24227":1275,"_20499":39036,"_5":24387,"_16438":38978,"_1794":39037},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_5719":1293,"_24227":1275,"_20499":39039,"_5":24387,"_16438":38982,"_1794":39040},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_5719":1294,"_24227":1275,"_20499":39042,"_5":24387,"_16438":38982,"_1794":39043},[],"En la práctica, permite:",{"_5719":1295,"_24227":1275,"_20499":39045,"_5":24387,"_16438":38982,"_1794":39046},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_5719":1296,"_24227":1275,"_20499":39048,"_5":24387,"_16438":38982,"_1794":39049},[],"Importar claves creadas externamente.",{"_5719":1297,"_24227":1275,"_20499":39051,"_5":24387,"_16438":38982,"_1794":39052},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_5719":1298,"_24227":1275,"_20499":39054,"_5":24387,"_16438":38982,"_1794":39055},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_5719":1299,"_24227":1275,"_20499":39057,"_5":24387,"_16438":38986,"_1794":39058},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_5719":1300,"_24227":1275,"_20499":39060,"_5":24387,"_16438":38986,"_1794":39061},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_5719":1301,"_24227":1275,"_20499":39063,"_5":24387,"_16438":38986,"_1794":39064},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_5719":1302,"_24227":1275,"_20499":39066,"_5":24387,"_16438":38986,"_1794":39067},[],"Crypto Engine",{"_5719":1303,"_24227":1275,"_20499":39069,"_5":24387,"_16438":38986,"_1794":39070},[],"Nivel de seguridad",{"_5719":1304,"_24227":1275,"_20499":39072,"_5":24387,"_16438":38986,"_1794":39073},[],"OnPrem / Cloud",{"_5719":1305,"_24227":1275,"_20499":39075,"_5":24387,"_16438":38986,"_1794":39076},[],"Coste adicional",{"_5719":1306,"_24227":1275,"_20499":39078,"_5":24387,"_16438":38986,"_1794":39079},[],"Generación de claves",{"_5719":1307,"_24227":1275,"_20499":39081,"_5":24387,"_16438":38986,"_1794":39082},[],"Persistencia *at-rest* segura",{"_5719":1308,"_24227":1275,"_20499":39084,"_5":24387,"_16438":38986,"_1794":39085},[],"Filtración de claves",{"_5719":1309,"_24227":1275,"_20499":39087,"_5":24387,"_16438":38986,"_1794":39088},[],"Consideraciones",{"_5719":1310,"_24227":1275,"_20499":39090,"_5":24387,"_16438":38986,"_1794":39091},[],"File System",{"_5719":1311,"_24227":1275,"_20499":39093,"_5":24387,"_16438":38986,"_1794":12141},[],{"_5719":1312,"_24227":1275,"_20499":39095,"_5":24387,"_16438":38986,"_1794":39096},[],"OnPrem y Cloud",{"_5719":1313,"_24227":1275,"_20499":39098,"_5":24387,"_16438":38986,"_1794":36568},[],{"_5719":1314,"_24227":1275,"_20499":39100,"_5":24387,"_16438":38986,"_1794":39101},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_5719":1315,"_24227":1275,"_20499":39103,"_5":24387,"_16438":38986,"_1794":39104},[],"**Insegura**. Delegada en el sistema de archivos.",{"_5719":1316,"_24227":1275,"_20499":39106,"_5":24387,"_16438":38986,"_1794":39104},[],{"_5719":1317,"_24227":1275,"_20499":39108,"_5":24387,"_16438":38986,"_1794":39109},[],"No recomendado para producción.",{"_5719":1318,"_24227":1275,"_20499":39111,"_5":24387,"_16438":38986,"_1794":39112},[],"HashiCorp Vault",{"_5719":1319,"_24227":1275,"_20499":39114,"_5":24387,"_16438":38986,"_1794":4444},[],{"_5719":1320,"_24227":1275,"_20499":39116,"_5":24387,"_16438":38986,"_1794":39096},[],{"_5719":1321,"_24227":1275,"_20499":39118,"_5":24387,"_16438":38986,"_1794":36568},[],{"_5719":1322,"_24227":1275,"_20499":39120,"_5":24387,"_16438":38986,"_1794":39121},[],"Depende de la configuración de Vault.",{"_5719":1323,"_24227":1275,"_20499":39123,"_5":24387,"_16438":38986,"_1794":39124},[],"**Segura**",{"_5719":1324,"_24227":1275,"_20499":39126,"_5":24387,"_16438":38986,"_1794":39127},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_5719":1325,"_24227":1275,"_20499":39129,"_5":24387,"_16438":38986,"_1794":39130},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_5719":1326,"_24227":1275,"_20499":39132,"_5":24387,"_16438":38986,"_1794":39133},[],"AWS Secrets Manager",{"_5719":1327,"_24227":1275,"_20499":39135,"_5":24387,"_16438":38986,"_1794":4444},[],{"_5719":1328,"_24227":1275,"_20499":39137,"_5":24387,"_16438":38986,"_1794":39138},[],"Cloud",{"_5719":1329,"_24227":1275,"_20499":39140,"_5":24387,"_16438":38986,"_1794":36516},[],{"_5719":1330,"_24227":1275,"_20499":39142,"_5":24387,"_16438":38986,"_1794":39143},[],"Depende del proceso de alta de la clave.",{"_5719":1331,"_24227":1275,"_20499":39145,"_5":24387,"_16438":38986,"_1794":39124},[],{"_5719":1332,"_24227":1275,"_20499":39147,"_5":24387,"_16438":38986,"_1794":39127},[],{"_5719":1333,"_24227":1275,"_20499":39149,"_5":24387,"_16438":38986,"_1794":39150},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_5719":1334,"_24227":1275,"_20499":39152,"_5":24387,"_16438":38986,"_1794":39153},[],"AWS KMS",{"_5719":1335,"_24227":1275,"_20499":39155,"_5":24387,"_16438":38986,"_1794":14588},[],{"_5719":1336,"_24227":1275,"_20499":39157,"_5":24387,"_16438":38986,"_1794":39138},[],{"_5719":1337,"_24227":1275,"_20499":39159,"_5":24387,"_16438":38986,"_1794":36516},[],{"_5719":1338,"_24227":1275,"_20499":39161,"_5":24387,"_16438":38986,"_1794":39162},[],"**Entropía hardware**",{"_5719":1339,"_24227":1275,"_20499":39164,"_5":24387,"_16438":38986,"_1794":39124},[],{"_5719":1340,"_24227":1275,"_20499":39166,"_5":24387,"_16438":38986,"_1794":39124},[],{"_5719":1341,"_24227":1275,"_20499":39168,"_5":24387,"_16438":38986,"_1794":39169},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_5719":1342,"_24227":1275,"_20499":39171,"_5":24387,"_16438":38986,"_1794":39172},[],"PKCS11",{"_5719":1343,"_24227":1275,"_20499":39174,"_5":24387,"_16438":38986,"_1794":39175},[],"3\\*",{"_5719":1344,"_24227":1275,"_20499":39177,"_5":24387,"_16438":38986,"_1794":39178},[],"AirGap OnPrem y Cloud",{"_5719":1345,"_24227":1275,"_20499":39180,"_5":24387,"_16438":38986,"_1794":39181},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_5719":1346,"_24227":1275,"_20499":39183,"_5":24387,"_16438":38986,"_1794":39162},[],{"_5719":1347,"_24227":1275,"_20499":39185,"_5":24387,"_16438":38986,"_1794":39186},[],"**Segura**\\*",{"_5719":1348,"_24227":1275,"_20499":39188,"_5":24387,"_16438":38986,"_1794":39189},[],"Depende del HSM",{"_5719":1349,"_24227":1275,"_20499":39191,"_5":24387,"_16438":38986,"_1794":39192},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_5719":1350,"_24227":1275,"_20499":39194,"_5":24387,"_16438":38986,"_1794":39195},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_5719":1351,"_24227":1275,"_20499":39197,"_5":24387,"_16438":38986,"_1794":39198},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_5719":1352,"_24227":1275,"_20499":39200,"_5":24387,"_16438":38986,"_1794":39201},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_5719":1353,"_24227":1275,"_20499":39203,"_5":24387,"_16438":38990,"_1794":39204},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_5719":1354,"_24227":1275,"_20499":39206,"_5":24387,"_16438":38990,"_1794":39207},[],"La tabla incluye los siguientes campos:",{"_5719":1355,"_24227":1275,"_20499":39209,"_5":24387,"_16438":38990,"_1794":39210},[],"**Name**: nombre descriptivo de la clave.",{"_5719":1356,"_24227":1275,"_20499":39212,"_5":24387,"_16438":38990,"_1794":39213},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_5719":1357,"_24227":1275,"_20499":39215,"_5":24387,"_16438":38990,"_1794":39216},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_5719":1358,"_24227":1275,"_20499":39218,"_5":24387,"_16438":38990,"_1794":39219},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_5719":1359,"_24227":1275,"_20499":39221,"_5":24387,"_16438":38990,"_1794":39222},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_5719":1360,"_24227":1275,"_20499":39224,"_5":24387,"_16438":38990,"_1794":39225},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_5719":1361,"_24227":1275,"_20499":39227,"_5":24387,"_16438":38990,"_1794":39228},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_5719":1362,"_24227":1275,"_20499":39230,"_5":24387,"_16438":38990,"_1794":39231},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_5719":1363,"_24227":1275,"_20499":39233,"_5":24387,"_16438":38990,"_1794":39234},[],"Desde esta vista también se accede a las acciones más habituales:",{"_5719":1364,"_24227":1275,"_20499":39236,"_5":24387,"_16438":38990,"_1794":39237},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_5719":1365,"_24227":1275,"_20499":39239,"_5":24387,"_16438":38990,"_1794":39240},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_5719":1366,"_24227":1275,"_20499":39242,"_5":24387,"_16438":38990,"_1794":39243},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_5719":1367,"_24227":1275,"_20499":39245,"_5":24387,"_16438":38990,"_1794":39246},[],"**Delete Key** para eliminar la clave del sistema.",{"_5719":1368,"_24227":1275,"_20499":39248,"_5":24387,"_16438":38994,"_1794":39249},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_5719":1369,"_24227":1275,"_20499":39251,"_5":24387,"_16438":38998,"_1794":39252},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_5719":1370,"_24227":1275,"_20499":39254,"_5":24387,"_16438":38998,"_1794":39255},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_5719":1371,"_24227":1275,"_20499":39257,"_5":24387,"_16438":38998,"_1794":39258},[],"**Key Name**: nombre único y descriptivo.",{"_5719":1372,"_24227":1275,"_20499":39260,"_5":24387,"_16438":38998,"_1794":39261},[],"**Crypto Engine**: motor que custodiará la clave.",{"_5719":1373,"_24227":1275,"_20499":39263,"_5":24387,"_16438":38998,"_1794":39264},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_5719":1374,"_24227":1275,"_20499":39266,"_5":24387,"_16438":38998,"_1794":39267},[],"**Tags**: metadatos para clasificar la clave.",{"_5719":1375,"_24227":1275,"_20499":39269,"_5":24387,"_16438":38998,"_1794":39270},[],"**Metadata**: información adicional para usos avanzados.",{"_5719":1376,"_24227":1275,"_20499":39272,"_5":24387,"_16438":39002,"_1794":39273},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_5719":1377,"_24227":1275,"_20499":39275,"_5":24387,"_16438":39002,"_1794":39276},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_5719":1378,"_24227":1275,"_20499":39278,"_5":24387,"_16438":39002,"_1794":39279},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_5719":1379,"_24227":1275,"_20499":39281,"_5":24387,"_16438":39002,"_1794":39282},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_5719":1380,"_24227":1275,"_20499":39284,"_5":24387,"_16438":39002,"_1794":39285},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_5719":1381,"_24227":1275,"_20499":39287,"_5":24387,"_16438":39002,"_1794":39288},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_5719":1382,"_24227":1275,"_20499":39290,"_5":24387,"_16438":39002,"_1794":39291},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_5719":1383,"_24227":1275,"_20499":39293,"_5":24387,"_16438":39002,"_1794":39294},[],"**Tags**: etiquetas para organización y búsqueda.",{"_5719":1384,"_24227":1275,"_20499":39296,"_5":24387,"_16438":39002,"_1794":39297},[],"**Metadata**: información adicional opcional.",{"_5719":1385,"_24227":1275,"_20499":39299,"_5":24387,"_16438":39002,"_1794":39300},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_5719":1386,"_24227":1275,"_20499":39302,"_5":24387,"_16438":39002,"_1794":39303},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_5719":1387,"_24227":1275,"_20499":39305,"_5":24387,"_16438":39006,"_1794":39306},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_5719":1388,"_24227":1275,"_20499":39308,"_5":24387,"_16438":39010,"_1794":39309},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_5719":1389,"_24227":1275,"_20499":39311,"_5":24387,"_16438":39010,"_1794":39312},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_5719":1390,"_24227":1275,"_20499":39314,"_5":24387,"_16438":39010,"_1794":39315},[],"**Key Name**: nombre descriptivo.",{"_5719":1391,"_24227":1275,"_20499":39317,"_5":24387,"_16438":39010,"_1794":39318},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_5719":1392,"_24227":1275,"_20499":39320,"_5":24387,"_16438":39010,"_1794":39321},[],"**Tags**: etiquetas asociadas.",{"_5719":1393,"_24227":1275,"_20499":39323,"_5":24387,"_16438":39010,"_1794":39324},[],"**Aliases**: nombres alternativos.",{"_5719":1394,"_24227":1275,"_20499":39326,"_5":24387,"_16438":39010,"_1794":39327},[],"**Crypto Engine**: motor en el que reside la clave.",{"_5719":1395,"_24227":1275,"_20499":39329,"_5":24387,"_16438":39010,"_1794":39330},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_5719":1396,"_24227":1275,"_20499":39332,"_5":24387,"_16438":39010,"_1794":39333},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_5719":1397,"_24227":1275,"_20499":39335,"_5":24387,"_16438":39010,"_1794":39336},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_5719":1398,"_24227":1275,"_20499":39338,"_5":24387,"_16438":39014,"_1794":39339},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_5719":1399,"_24227":1275,"_20499":39341,"_5":24387,"_16438":39014,"_1794":39342},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_5719":1400,"_24227":1275,"_20499":39344,"_5":24387,"_16438":39018,"_1794":39345},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_5719":1401,"_24227":1275,"_20499":39347,"_5":24387,"_16438":39018,"_1794":39348},[],"Campos principales:",{"_5719":1402,"_24227":1275,"_20499":39350,"_5":24387,"_16438":39018,"_1794":39351},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_5719":1403,"_24227":1275,"_20499":39353,"_5":24387,"_16438":39018,"_1794":39354},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_5719":1404,"_24227":1275,"_20499":39356,"_5":24387,"_16438":39018,"_1794":39357},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_5719":1405,"_24227":1275,"_20499":39359,"_5":24387,"_16438":39018,"_1794":39360},[],"**Message**: contenido que se va a firmar.",{"_5719":1406,"_24227":1275,"_20499":39362,"_5":24387,"_16438":39018,"_1794":39363},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_5719":1407,"_24227":1275,"_20499":39365,"_5":24387,"_16438":39022,"_1794":39366},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_5719":1408,"_24227":1275,"_20499":39368,"_5":24387,"_16438":39022,"_1794":39348},[],{"_5719":1409,"_24227":1275,"_20499":39370,"_5":24387,"_16438":39022,"_1794":39371},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_5719":1410,"_24227":1275,"_20499":39373,"_5":24387,"_16438":39022,"_1794":39374},[],"**Message Type**: `Raw` o `Digest`.",{"_5719":1411,"_24227":1275,"_20499":39376,"_5":24387,"_16438":39022,"_1794":39377},[],"**Payload Encoding**: codificación del mensaje.",{"_5719":1412,"_24227":1275,"_20499":39379,"_5":24387,"_16438":39022,"_1794":39380},[],"**Message**: mensaje original o hash.",{"_5719":1413,"_24227":1275,"_20499":39382,"_5":24387,"_16438":39022,"_1794":39383},[],"**Signature**: firma que se desea comprobar.",{"_5719":1414,"_24227":1275,"_20499":39385,"_5":24387,"_16438":39022,"_1794":39386},[],"**Result**: indicador del resultado de la validación.",{"_5719":1415,"_24227":1275,"_20499":39388,"_5":24387,"_16438":39026,"_1794":39389},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_5719":1416,"_24227":1275,"_20499":39391,"_5":24387,"_16438":39026,"_1794":39392},[],"Este flujo es útil para:",{"_5719":1417,"_24227":1275,"_20499":39394,"_5":24387,"_16438":39026,"_1794":39395},[],"Solicitar certificados a una CA externa.",{"_5719":1418,"_24227":1275,"_20499":39397,"_5":24387,"_16438":39026,"_1794":39398},[],"Renovar una identidad manteniendo la misma clave.",{"_5719":1419,"_24227":1275,"_20499":39400,"_5":24387,"_16438":39026,"_1794":39401},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_5719":1420,"_24227":1275,"_20499":39403,"_5":24387,"_16438":39026,"_1794":39404},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_5719":1421,"_24227":1275,"_20499":39406,"_5":24387,"_16438":39026,"_1794":39407},[],"**Organization (O)**: organización o empresa.",{"_5719":1422,"_24227":1275,"_20499":39409,"_5":24387,"_16438":39026,"_1794":39410},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_5719":1423,"_24227":1275,"_20499":39412,"_5":24387,"_16438":39026,"_1794":39413},[],"**Country (C)**: código de país de dos letras.",{"_5719":1424,"_24227":1275,"_20499":39415,"_5":24387,"_16438":39026,"_1794":39416},[],"**State / Province (ST)**: estado o provincia.",{"_5719":1425,"_24227":1275,"_20499":39418,"_5":24387,"_16438":39026,"_1794":39419},[],"**Locality (L)**: ciudad o localidad.",{"_5719":1426,"_24227":1275,"_20499":39421,"_5":24387,"_16438":39026,"_1794":39422},[],"**Email Address**: correo de contacto.",{"_5719":1427,"_24227":1275,"_20499":39424,"_5":24387,"_16438":39026,"_1794":39425},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_5719":1428,"_24227":1275,"_20499":39427,"_5":24387,"_16438":39026,"_1794":39428},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_5719":1429,"_24227":1275,"_20499":39430,"_5":24387,"_16438":39030,"_1794":39431},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_5719":1430,"_24227":1275,"_20499":39433,"_5":24387,"_16438":39030,"_1794":39434},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_5719":1431,"_24227":1431,"_5":24382,"_1794":39436,"_24395":39437,"_20499":39438,"_16438":1431},"[PQC] Criptografía post-cuántica (LamassuQ)",[35169,36268,36277],[],{"_5719":1432,"_24227":1431,"_20499":39440,"_5":24387,"_16438":1431,"_1794":39441},[],"Soporte de criptografía post-cuántica en el KMS, la CA y el SDK de Lamassu IoT",{"_5719":1433,"_24227":1431,"_5":24392,"_20499":39443,"_16438":39444,"_1794":39445},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#criptografía-post-cuántica-lamassuq","Criptografía post-cuántica (LamassuQ)",{"_5719":1434,"_24227":1431,"_5":24392,"_20499":39447,"_16438":39448,"_1794":39449},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#qué-aporta-lamassuq","Qué aporta LamassuQ",{"_5719":1435,"_24227":1431,"_5":24392,"_20499":39451,"_16438":39452,"_1794":39453},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#alcance-y-limitaciones","Alcance y limitaciones",{"_5719":1436,"_24227":1431,"_5":24392,"_20499":39455,"_16438":39456,"_1794":39457},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#algoritmos-soportados","Algoritmos soportados",{"_5719":1437,"_24227":1431,"_5":24392,"_20499":39459,"_16438":39460,"_1794":39461},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#conjuntos-de-parámetros-slh-dsa","Conjuntos de parámetros SLH-DSA",{"_5719":1438,"_24227":1431,"_5":24392,"_20499":39463,"_16438":39464,"_1794":39465},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#variantes-compuestas","Variantes compuestas",{"_5719":1439,"_24227":1431,"_5":24392,"_20499":39467,"_16438":39468,"_1794":39469},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#compatibilidad-con-motores-criptográficos","Compatibilidad con motores criptográficos",{"_5719":1440,"_24227":1431,"_5":24392,"_20499":39471,"_16438":39472,"_1794":39473},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#crear-claves-post-cuánticas","Crear claves post-cuánticas",{"_5719":1441,"_24227":1431,"_5":24392,"_20499":39475,"_16438":39476,"_1794":39477},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#importar-claves-post-cuánticas","Importar claves post-cuánticas",{"_5719":1442,"_24227":1431,"_5":24392,"_20499":39479,"_16438":39480,"_1794":39481},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#firmar-y-verificar-con-claves-post-cuánticas","Firmar y verificar con claves post-cuánticas",{"_5719":1443,"_24227":1431,"_5":24392,"_20499":39483,"_16438":39484,"_1794":39485},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#autoridades-de-certificación-post-cuánticas","Autoridades de certificación post-cuánticas",{"_5719":1444,"_24227":1431,"_5":24392,"_20499":39487,"_16438":39488,"_1794":39489},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#crear-una-ca-con-clave-pqc","Crear una CA con clave PQC",{"_5719":1445,"_24227":1431,"_5":24392,"_20499":39491,"_16438":39492,"_1794":39493},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#importar-una-ca-con-clave-pqc","Importar una CA con clave PQC",{"_5719":1446,"_24227":1431,"_5":24392,"_20499":39495,"_16438":39496,"_1794":39497},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#cadenas-de-certificación-mixtas","Cadenas de certificación mixtas",{"_5719":1447,"_24227":1431,"_5":24392,"_20499":39499,"_16438":39500,"_1794":39501},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#sdk-de-go-y-utilidades-criptográficas","SDK de Go y utilidades criptográficas",{"_5719":1448,"_24227":1431,"_5":24392,"_20499":39503,"_16438":39504,"_1794":39505},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#despliegue","Despliegue",{"_5719":1449,"_24227":1431,"_5":24392,"_20499":39507,"_16438":39508,"_1794":39509},[],"/docs/pr-preview/pr-25/manual/servicios-core/pqc#recomendaciones-de-migración-a-pqc","Recomendaciones de migración a PQC",{"_5719":1450,"_24227":1431,"_20499":39511,"_5":24387,"_16438":39444,"_1794":39512},[],"LamassuQ incorpora soporte de criptografía post-cuántica (PQC) a la plataforma: el servicio KMS puede generar e importar claves post-cuánticas, firmar y verificar con ellas, y el servicio de CA puede emitir certificados X.509 apoyados en estas claves, incluidas cadenas de certificación mixtas en las que conviven algoritmos clásicos y post-cuánticos.",{"_5719":1451,"_24227":1431,"_20499":39514,"_5":24387,"_16438":39444,"_1794":39515},[],"El objetivo es preparar la PKI ante la amenaza de un computador cuántico suficiente para romper la criptografía asimétrica actual, manteniendo al mismo tiempo la compatibilidad con los algoritmos clásicos ya desplegados.",{"_5719":1452,"_24227":1431,"_20499":39517,"_5":24387,"_16438":39448,"_1794":39518},[],"**Nuevos algoritmos de firma** en el KMS: ML-DSA, SLH-DSA y firmas compuestas (*composite*) que combinan ML-DSA con RSA, ECDSA o Ed25519.",{"_5719":1453,"_24227":1431,"_20499":39520,"_5":24387,"_16438":39448,"_1794":39521},[],"**Generación e importación de claves** post-cuánticas a través del flujo habitual de claves del KMS.",{"_5719":1454,"_24227":1431,"_20499":39523,"_5":24387,"_16438":39448,"_1794":39524},[],"**Firma y verificación** con los nuevos algoritmos, sobre el mensaje en claro (*pure signing*).",{"_5719":1455,"_24227":1431,"_20499":39526,"_5":24387,"_16438":39448,"_1794":39527},[],"**CAs post-cuánticas**: creación e importación de autoridades de certificación con claves ML-DSA, SLH-DSA o compuestas, y emisión de certificados a partir de ellas.",{"_5719":1456,"_24227":1431,"_20499":39529,"_5":24387,"_16438":39448,"_1794":39530},[],"**Cadenas mixtas**: un motor X.509 puede firmar certificados cruzando familias de algoritmos (por ejemplo, una CA SLH-DSA que emite una hoja ECDSA, o una CA ECDSA que firma un CSR firmado con SLH-DSA).",{"_5719":1457,"_24227":1431,"_20499":39532,"_5":24387,"_16438":39452,"_1794":39533},[],"La funcionalidad se expone a través de la **API REST y el SDK de Go**. Los ejemplos de esta página utilizan ambos canales.",{"_5719":1458,"_24227":1431,"_20499":39535,"_5":24387,"_16438":39452,"_1794":39536},[],"El soporte PQC está disponible de forma completa en el **motor criptográfico software** (y en el motor File System, que delega en él). Consulte la matriz de compatibilidad para conocer el estado del resto de motores.",{"_5719":1459,"_24227":1431,"_20499":39538,"_5":24387,"_16438":39452,"_1794":39539},[],"Los algoritmos PQC de Lamassu son **algoritmos de firma**. No se ha añadido soporte de cifrado/encapsulación de claves (ML-KEM) ni mecanismos de cifrado post-cuántico.",{"_5719":1460,"_24227":1431,"_20499":39541,"_5":24387,"_16438":39452,"_1794":39542},[],"LamassuQ se distribuye mediante **imágenes de contenedor específicas** y una **imagen de Go con soporte PQC**. Consulte la sección de despliegue.",{"_5719":1461,"_24227":1431,"_20499":39544,"_5":24387,"_16438":39456,"_1794":39545},[],"El KMS identifica cada tipo de clave con un valor de `algorithm` y un parámetro `size`. Los algoritmos añadidos por LamassuQ son los siguientes:",{"_5719":1462,"_24227":1431,"_20499":39547,"_5":24387,"_16438":39456,"_1794":39548},[],"Algoritmo (`algorithm`)",{"_5719":1463,"_24227":1431,"_20499":39550,"_5":24387,"_16438":39456,"_1794":39551},[],"Parámetros (`size`)",{"_5719":1464,"_24227":1431,"_20499":39553,"_5":24387,"_16438":39456,"_1794":39554},[],"Estándar",{"_5719":1465,"_24227":1431,"_20499":39556,"_5":24387,"_16438":39456,"_1794":35372},[],{"_5719":1466,"_24227":1431,"_20499":39558,"_5":24387,"_16438":39456,"_1794":39559},[],"`ML-DSA`",{"_5719":1467,"_24227":1431,"_20499":39561,"_5":24387,"_16438":39456,"_1794":39562},[],"44, 65, 87",{"_5719":1468,"_24227":1431,"_20499":39564,"_5":24387,"_16438":39456,"_1794":39565},[],"FIPS 204 (ML-DSA-44/65/87)",{"_5719":1469,"_24227":1431,"_20499":39567,"_5":24387,"_16438":39456,"_1794":39568},[],"Firma post-cuántica basada en retículos (*lattice*).",{"_5719":1470,"_24227":1431,"_20499":39570,"_5":24387,"_16438":39456,"_1794":39571},[],"`SLH-DSA`",{"_5719":1471,"_24227":1431,"_20499":39573,"_5":24387,"_16438":39456,"_1794":39574},[],"1–12 (conjunto de parámetros)",{"_5719":1472,"_24227":1431,"_20499":39576,"_5":24387,"_16438":39456,"_1794":39577},[],"FIPS 205",{"_5719":1473,"_24227":1431,"_20499":39579,"_5":24387,"_16438":39456,"_1794":39580},[],"Firma post-cuántica basada en hash (*stateless hash-based*), considerada el enfoque más conservador.",{"_5719":1474,"_24227":1431,"_20499":39582,"_5":24387,"_16438":39456,"_1794":39583},[],"`Composite-ML-DSA-RSA`",{"_5719":1475,"_24227":1431,"_20499":39585,"_5":24387,"_16438":39456,"_1794":39586},[],"variante 1–8",{"_5719":1476,"_24227":1431,"_20499":39588,"_5":24387,"_16438":39456,"_1794":39589},[],"firma híbrida",{"_5719":1477,"_24227":1431,"_20499":39591,"_5":24387,"_16438":39456,"_1794":39592},[],"Combina ML-DSA con una firma RSA (RSA-PSS o RSA-PKCS#1 v1.5).",{"_5719":1478,"_24227":1431,"_20499":39594,"_5":24387,"_16438":39456,"_1794":39595},[],"`Composite-ML-DSA-ECDSA`",{"_5719":1479,"_24227":1431,"_20499":39597,"_5":24387,"_16438":39456,"_1794":39598},[],"variante 9–13",{"_5719":1480,"_24227":1431,"_20499":39600,"_5":24387,"_16438":39456,"_1794":39589},[],{"_5719":1481,"_24227":1431,"_20499":39602,"_5":24387,"_16438":39456,"_1794":39603},[],"Combina ML-DSA con una firma ECDSA.",{"_5719":1482,"_24227":1431,"_20499":39605,"_5":24387,"_16438":39456,"_1794":39606},[],"`Composite-ML-DSA-Ed25519`",{"_5719":1483,"_24227":1431,"_20499":39608,"_5":24387,"_16438":39456,"_1794":39609},[],"variante 14–15",{"_5719":1484,"_24227":1431,"_20499":39611,"_5":24387,"_16438":39456,"_1794":39589},[],{"_5719":1485,"_24227":1431,"_20499":39613,"_5":24387,"_16438":39456,"_1794":39614},[],"Combina ML-DSA con Ed25519.",{"_5719":1486,"_24227":1431,"_20499":39616,"_5":24387,"_16438":39456,"_1794":39617},[],"`Ed25519`",{"_5719":1487,"_24227":1431,"_20499":39619,"_5":24387,"_16438":39456,"_1794":39620},[],"256 (fijo)",{"_5719":1488,"_24227":1431,"_20499":39622,"_5":24387,"_16438":39456,"_1794":39623},[],"firma clásica",{"_5719":1489,"_24227":1431,"_20499":39625,"_5":24387,"_16438":39456,"_1794":39626},[],"Incluido en el mismo flujo de generación e importación.",{"_5719":1490,"_24227":1431,"_20499":39628,"_5":24387,"_16438":39456,"_1794":39629},[],"Las firmas compuestas (*composite*) producen una única firma que valida contra las dos claves del par: la post-cuántica y la clásica. Son útiles durante la migración, cuando el verificador aún no soporta algoritmos PQC o se exige redundancia criptográfica.",{"_5719":1491,"_24227":1431,"_20499":39631,"_5":24387,"_16438":39460,"_1794":39632},[],"Para `SLH-DSA` el valor de `size` selecciona el conjunto de parámetros FIPS 205:",{"_5719":1492,"_24227":1431,"_20499":39634,"_5":24387,"_16438":39460,"_1794":39635},[],"`size`",{"_5719":1493,"_24227":1431,"_20499":39637,"_5":24387,"_16438":39460,"_1794":39638},[],"Conjunto de parámetros",{"_5719":1494,"_24227":1431,"_20499":39640,"_5":24387,"_16438":39460,"_1794":12141},[],{"_5719":1495,"_24227":1431,"_20499":39642,"_5":24387,"_16438":39460,"_1794":39643},[],"SLH-DSA-SHA2-128s",{"_5719":1496,"_24227":1431,"_20499":39645,"_5":24387,"_16438":39460,"_1794":4444},[],{"_5719":1497,"_24227":1431,"_20499":39647,"_5":24387,"_16438":39460,"_1794":39648},[],"SLH-DSA-SHA2-128f",{"_5719":1498,"_24227":1431,"_20499":39650,"_5":24387,"_16438":39460,"_1794":14588},[],{"_5719":1499,"_24227":1431,"_20499":39652,"_5":24387,"_16438":39460,"_1794":39653},[],"SLH-DSA-SHA2-192s",{"_5719":1500,"_24227":1431,"_20499":39655,"_5":24387,"_16438":39460,"_1794":7300},[],{"_5719":1501,"_24227":1431,"_20499":39657,"_5":24387,"_16438":39460,"_1794":39658},[],"SLH-DSA-SHA2-192f",{"_5719":1502,"_24227":1431,"_20499":39660,"_5":24387,"_16438":39460,"_1794":14575},[],{"_5719":1503,"_24227":1431,"_20499":39662,"_5":24387,"_16438":39460,"_1794":39663},[],"SLH-DSA-SHA2-256s",{"_5719":1504,"_24227":1431,"_20499":39665,"_5":24387,"_16438":39460,"_1794":7308},[],{"_5719":1505,"_24227":1431,"_20499":39667,"_5":24387,"_16438":39460,"_1794":39668},[],"SLH-DSA-SHA2-256f",{"_5719":1506,"_24227":1431,"_20499":39670,"_5":24387,"_16438":39460,"_1794":14537},[],{"_5719":1507,"_24227":1431,"_20499":39672,"_5":24387,"_16438":39460,"_1794":39673},[],"SLH-DSA-SHAKE-128s",{"_5719":1508,"_24227":1431,"_20499":39675,"_5":24387,"_16438":39460,"_1794":7315},[],{"_5719":1509,"_24227":1431,"_20499":39677,"_5":24387,"_16438":39460,"_1794":39678},[],"SLH-DSA-SHAKE-128f",{"_5719":1510,"_24227":1431,"_20499":39680,"_5":24387,"_16438":39460,"_1794":12603},[],{"_5719":1511,"_24227":1431,"_20499":39682,"_5":24387,"_16438":39460,"_1794":39683},[],"SLH-DSA-SHAKE-192s",{"_5719":1512,"_24227":1431,"_20499":39685,"_5":24387,"_16438":39460,"_1794":23792},[],{"_5719":1513,"_24227":1431,"_20499":39687,"_5":24387,"_16438":39460,"_1794":39688},[],"SLH-DSA-SHAKE-192f",{"_5719":1514,"_24227":1431,"_20499":39690,"_5":24387,"_16438":39460,"_1794":23786},[],{"_5719":1515,"_24227":1431,"_20499":39692,"_5":24387,"_16438":39460,"_1794":39693},[],"SLH-DSA-SHAKE-256s",{"_5719":1516,"_24227":1431,"_20499":39695,"_5":24387,"_16438":39460,"_1794":23818},[],{"_5719":1517,"_24227":1431,"_20499":39697,"_5":24387,"_16438":39460,"_1794":39698},[],"SLH-DSA-SHAKE-256f",{"_5719":1518,"_24227":1431,"_20499":39700,"_5":24387,"_16438":39460,"_1794":39701},[],"Los conjuntos terminados en `s` (*small*) optimizan el tamaño de firma y los terminados en `f` (*fast*) la velocidad de firma.",{"_5719":1519,"_24227":1431,"_20499":39703,"_5":24387,"_16438":39464,"_1794":39704},[],"Para las claves compuestas, el valor de `size` selecciona la variante dentro del registro de algoritmos compuestos de la librería criptográfica con la que se ha construido Lamassu (un *fork* con soporte PQC de la librería estándar de Go):",{"_5719":1520,"_24227":1431,"_20499":39706,"_5":24387,"_16438":39464,"_1794":39707},[],"Familia",{"_5719":1521,"_24227":1431,"_20499":39709,"_5":24387,"_16438":39464,"_1794":39710},[],"Variantes admitidas",{"_5719":1522,"_24227":1431,"_20499":39712,"_5":24387,"_16438":39464,"_1794":39713},[],"Composiciones disponibles",{"_5719":1523,"_24227":1431,"_20499":39715,"_5":24387,"_16438":39464,"_1794":39583},[],{"_5719":1524,"_24227":1431,"_20499":39717,"_5":24387,"_16438":39464,"_1794":39718},[],"1–8",{"_5719":1525,"_24227":1431,"_20499":39720,"_5":24387,"_16438":39464,"_1794":39721},[],"MLDSA44\\_RSA2048\\_PSS\\_SHA256, MLDSA44\\_RSA2048\\_PKCS15\\_SHA256, MLDSA65\\_RSA3072\\_PSS\\_SHA512, MLDSA65\\_RSA3072\\_PKCS15\\_SHA512, MLDSA65\\_RSA4096\\_PSS\\_SHA512, MLDSA65\\_RSA4096\\_PKCS15\\_SHA512, MLDSA87\\_RSA3072\\_PSS\\_SHA512, MLDSA87\\_RSA4096\\_PSS\\_SHA512",{"_5719":1526,"_24227":1431,"_20499":39723,"_5":24387,"_16438":39464,"_1794":39595},[],{"_5719":1527,"_24227":1431,"_20499":39725,"_5":24387,"_16438":39464,"_1794":39726},[],"9–13",{"_5719":1528,"_24227":1431,"_20499":39728,"_5":24387,"_16438":39464,"_1794":39729},[],"MLDSA44\\_ECDSA\\_P256\\_SHA256, MLDSA65\\_ECDSA\\_P256\\_SHA512, MLDSA65\\_ECDSA\\_P384\\_SHA512, MLDSA87\\_ECDSA\\_P384\\_SHA512, MLDSA87\\_ECDSA\\_P521\\_SHA512",{"_5719":1529,"_24227":1431,"_20499":39731,"_5":24387,"_16438":39464,"_1794":39606},[],{"_5719":1530,"_24227":1431,"_20499":39733,"_5":24387,"_16438":39464,"_1794":39734},[],"14–15",{"_5719":1531,"_24227":1431,"_20499":39736,"_5":24387,"_16438":39464,"_1794":39737},[],"MLDSA44\\_Ed25519\\_SHA512, MLDSA65\\_Ed25519\\_SHA512",{"_5719":1532,"_24227":1431,"_20499":39739,"_5":24387,"_16438":39464,"_1794":39740},[],"La primera parte del nombre indica la variante ML-DSA (44, 65 o 87) y la segunda el algoritmo clásico que la acompaña. El algoritmo exacto asociado a cada variante queda reflejado en los metadatos de la clave y en los certificados que se emitan con ella.",{"_5719":1533,"_24227":1431,"_20499":39742,"_5":24387,"_16438":39468,"_1794":39743},[],"Al crear o importar una clave, Lamassu comprueba que la especificación de clave (tipo y tamaño) esté declarada como soportada por el motor criptográfico seleccionado.",{"_5719":1534,"_24227":1431,"_20499":39745,"_5":24387,"_16438":39468,"_1794":39746},[],"Motor",{"_5719":1535,"_24227":1431,"_20499":39748,"_5":24387,"_16438":39468,"_1794":39749},[],"Claves PQC en su catálogo",{"_5719":1536,"_24227":1431,"_20499":39751,"_5":24387,"_16438":39468,"_1794":39752},[],"Crear / importar claves PQC",{"_5719":1537,"_24227":1431,"_20499":39754,"_5":24387,"_16438":39468,"_1794":39755},[],"Firmar / verificar con PQC",{"_5719":1538,"_24227":1431,"_20499":39757,"_5":24387,"_16438":39468,"_1794":39758},[],"Software (Go)",{"_5719":1539,"_24227":1431,"_20499":39760,"_5":24387,"_16438":39468,"_1794":36516},[],{"_5719":1540,"_24227":1431,"_20499":39762,"_5":24387,"_16438":39468,"_1794":36516},[],{"_5719":1541,"_24227":1431,"_20499":39764,"_5":24387,"_16438":39468,"_1794":36516},[],{"_5719":1542,"_24227":1431,"_20499":39766,"_5":24387,"_16438":39468,"_1794":39091},[],{"_5719":1543,"_24227":1431,"_20499":39768,"_5":24387,"_16438":39468,"_1794":36516},[],{"_5719":1544,"_24227":1431,"_20499":39770,"_5":24387,"_16438":39468,"_1794":36516},[],{"_5719":1545,"_24227":1431,"_20499":39772,"_5":24387,"_16438":39468,"_1794":36516},[],{"_5719":1546,"_24227":1431,"_20499":39774,"_5":24387,"_16438":39468,"_1794":39775},[],"HashiCorp Vault KV2",{"_5719":1547,"_24227":1431,"_20499":39777,"_5":24387,"_16438":39468,"_1794":39778},[],"Sí\\*",{"_5719":1548,"_24227":1431,"_20499":39780,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1549,"_24227":1431,"_20499":39782,"_5":24387,"_16438":39468,"_1794":36516},[],{"_5719":1550,"_24227":1431,"_20499":39784,"_5":24387,"_16438":39468,"_1794":39133},[],{"_5719":1551,"_24227":1431,"_20499":39786,"_5":24387,"_16438":39468,"_1794":39778},[],{"_5719":1552,"_24227":1431,"_20499":39788,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1553,"_24227":1431,"_20499":39790,"_5":24387,"_16438":39468,"_1794":36516},[],{"_5719":1554,"_24227":1431,"_20499":39792,"_5":24387,"_16438":39468,"_1794":39153},[],{"_5719":1555,"_24227":1431,"_20499":39794,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1556,"_24227":1431,"_20499":39796,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1557,"_24227":1431,"_20499":39798,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1558,"_24227":1431,"_20499":39800,"_5":24387,"_16438":39468,"_1794":39801},[],"Azure KeyVault",{"_5719":1559,"_24227":1431,"_20499":39803,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1560,"_24227":1431,"_20499":39805,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1561,"_24227":1431,"_20499":39807,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1562,"_24227":1431,"_20499":39809,"_5":24387,"_16438":39468,"_1794":39810},[],"Azure KeyVault Secrets",{"_5719":1563,"_24227":1431,"_20499":39812,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1564,"_24227":1431,"_20499":39814,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1565,"_24227":1431,"_20499":39816,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1566,"_24227":1431,"_20499":39818,"_5":24387,"_16438":39468,"_1794":39819},[],"PKCS#11",{"_5719":1567,"_24227":1431,"_20499":39821,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1568,"_24227":1431,"_20499":39823,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1569,"_24227":1431,"_20499":39825,"_5":24387,"_16438":39468,"_1794":36568},[],{"_5719":1570,"_24227":1431,"_20499":39827,"_5":24387,"_16438":39468,"_1794":39828},[],"El motor Software admite la matriz completa: RSA 1024–15360, ECDSA P-224/P-256/P-384/P-521, ML-DSA 44/65/87, SLH-DSA 1–12, compuestas 1–15 y Ed25519. El motor File System delega la generación, la importación y la firma en el motor software, por lo que hereda su soporte completo.",{"_5719":1571,"_24227":1431,"_20499":39830,"_5":24387,"_16438":39468,"_1794":39831},[],"HashiCorp Vault KV2 y AWS Secrets Manager anuncian el mismo catálogo de tipos de clave que el motor software, por lo que las claves PQC **aparecen en sus listados**. Sin embargo, sus operaciones de generación e importación de claves PQC no están implementadas todavía y devuelven errores del tipo `vaultvk2: unsupported key type (ML-DSA)` o `aws/secretsmanager: unsupported key type (ML-DSA)`.",{"_5719":1572,"_24227":1431,"_20499":39833,"_5":24387,"_16438":39468,"_1794":39834},[],"Estos motores **sí pueden custodiar y firmar** con una clave PQC: el motor descarga la clave privada del almacén y las operaciones de firma se ejecutan mediante las primitivas PQC del motor software. La limitación afecta a la creación y a la importación, no al uso posterior de la clave.",{"_5719":1573,"_24227":1431,"_20499":39836,"_5":24387,"_16438":39468,"_1794":39837},[],"Los motores AWS KMS, Azure KeyVault, Azure KeyVault Secrets y PKCS#11 no incluyen tipos de clave PQC en su catálogo y rechazan cualquier especificación de clave post-cuántica con un error de tipo *unsupported key type*. Para despliegues con HSM, considere una estrategia híbrida: claves clásicas custodiadas en el HSM y claves PQC en el motor software (consulte Recomendaciones de migración).",{"_5719":1574,"_24227":1431,"_20499":39839,"_5":24387,"_16438":39472,"_1794":39840},[],"La generación de claves PQC utiliza el mismo endpoint del KMS que los algoritmos clásicos: `POST /v1/keys`. El cuerpo de la petición indica el algoritmo y el tamaño o variante:",{"_5719":1575,"_24227":1431,"_20499":39842,"_5":24387,"_16438":39472,"_1794":39843},[],"Valores admitidos de `algorithm` y `size`:",{"_5719":1576,"_24227":1431,"_20499":39845,"_5":24387,"_16438":39472,"_1794":39846},[],"`algorithm`",{"_5719":1577,"_24227":1431,"_20499":39848,"_5":24387,"_16438":39472,"_1794":39635},[],{"_5719":1578,"_24227":1431,"_20499":39850,"_5":24387,"_16438":39472,"_1794":39559},[],{"_5719":1579,"_24227":1431,"_20499":39852,"_5":24387,"_16438":39472,"_1794":39853},[],"44, 65 o 87",{"_5719":1580,"_24227":1431,"_20499":39855,"_5":24387,"_16438":39472,"_1794":39571},[],{"_5719":1581,"_24227":1431,"_20499":39857,"_5":24387,"_16438":39472,"_1794":39858},[],"1 a 12",{"_5719":1582,"_24227":1431,"_20499":39860,"_5":24387,"_16438":39472,"_1794":39583},[],{"_5719":1583,"_24227":1431,"_20499":39862,"_5":24387,"_16438":39472,"_1794":39863},[],"1 a 8",{"_5719":1584,"_24227":1431,"_20499":39865,"_5":24387,"_16438":39472,"_1794":39595},[],{"_5719":1585,"_24227":1431,"_20499":39867,"_5":24387,"_16438":39472,"_1794":39868},[],"9 a 13",{"_5719":1586,"_24227":1431,"_20499":39870,"_5":24387,"_16438":39472,"_1794":39606},[],{"_5719":1587,"_24227":1431,"_20499":39872,"_5":24387,"_16438":39472,"_1794":39873},[],"14 a 15",{"_5719":1588,"_24227":1431,"_20499":39875,"_5":24387,"_16438":39472,"_1794":39617},[],{"_5719":1589,"_24227":1431,"_20499":39877,"_5":24387,"_16438":39472,"_1794":39878},[],"256 (se aplica automáticamente)",{"_5719":1590,"_24227":1431,"_20499":39880,"_5":24387,"_16438":39472,"_1794":39881},[],"Si no se indica `engine_id`, la clave se crea en el motor por defecto configurado en el despliegue. Para las claves compuestas, la variante debe pertenecer a la familia indicada en `algorithm`; por ejemplo, la variante 9 (ECDSA) no es válida para `Composite-ML-DSA-RSA`.",{"_5719":1591,"_24227":1431,"_20499":39883,"_5":24387,"_16438":39472,"_1794":39884},[],"`invalid MLDSA key size`: el tamaño indicado no es 44, 65 ni 87.",{"_5719":1592,"_24227":1431,"_20499":39886,"_5":24387,"_16438":39472,"_1794":39887},[],"`invalid SLH-DSA parameter set (use 1-12)`: el conjunto de parámetros está fuera del rango 1–12.",{"_5719":1593,"_24227":1431,"_20499":39889,"_5":24387,"_16438":39472,"_1794":39890},[],"`invalid Composite-ML-DSA variant (use 1-15)`: la variante está fuera del rango 1–15.",{"_5719":1594,"_24227":1431,"_20499":39892,"_5":24387,"_16438":39472,"_1794":39893},[],"`composite variant N is not valid for key type X`: la variante existe, pero pertenece a otra familia compuesta.",{"_5719":1595,"_24227":1431,"_20499":39895,"_5":24387,"_16438":39472,"_1794":39896},[],"*unsupported key type* procedente del motor: el motor seleccionado no admite la especificación de clave PQC. Consulte la matriz de compatibilidad.",{"_5719":1596,"_24227":1431,"_20499":39898,"_5":24387,"_16438":39472,"_1794":39899},[],"Con el SDK de Go, la misma operación se realiza con `CreateKey`, que admite exactamente los mismos valores de algoritmo y tamaño:",{"_5719":1597,"_24227":1431,"_20499":39901,"_5":24387,"_16438":39476,"_1794":39902},[],"La importación también reutiliza el endpoint clásico del KMS: `POST /v1/keys/import`. Lamassu parsea la clave privada en formato **PKCS#8** (PEM, codificada en Base64 en el campo `private_key`) e identifica automáticamente el algoritmo y los parámetros:",{"_5719":1598,"_24227":1431,"_20499":39904,"_5":24387,"_16438":39476,"_1794":39905},[],"Al parsear la clave, Lamassu deduce el tipo y el tamaño sin que sea necesario indicarlos:",{"_5719":1599,"_24227":1431,"_20499":39907,"_5":24387,"_16438":39476,"_1794":39908},[],"Claves ML-DSA: se reconocen los parámetros ML-DSA-44, ML-DSA-65 y ML-DSA-87.",{"_5719":1600,"_24227":1431,"_20499":39910,"_5":24387,"_16438":39476,"_1794":39911},[],"Claves SLH-DSA: se reconocen a partir del nombre del esquema del parámetro, con el prefijo `SLH-DSA-` (por ejemplo, `SLH-DSA-SHA2-128s`). El nombre del esquema se traduce al conjunto de parámetros correspondiente de la tabla anterior.",{"_5719":1601,"_24227":1431,"_20499":39913,"_5":24387,"_16438":39476,"_1794":39914},[],"Claves compuestas: se reconoce el algoritmo compuesto del par ML-DSA + clásico y se deriva la variante correspondiente.",{"_5719":1602,"_24227":1431,"_20499":39916,"_5":24387,"_16438":39476,"_1794":39917},[],"Claves Ed25519: tamaño fijo 256.",{"_5719":1603,"_24227":1431,"_20499":39919,"_5":24387,"_16438":39476,"_1794":39920},[],"Como en el caso de la generación, la especificación deducida debe estar soportada por el motor de destino.",{"_5719":1604,"_24227":1431,"_20499":39922,"_5":24387,"_16438":39480,"_1794":39923},[],"Las operaciones de firma y verificación se realizan con los endpoints habituales del KMS (`POST /v1/keys/:id/sign` y `POST /v1/keys/:id/verify`). Los algoritmos de firma disponibles para claves PQC son los siguientes:",{"_5719":1605,"_24227":1431,"_20499":39925,"_5":24387,"_16438":39480,"_1794":39926},[],"Clave",{"_5719":1606,"_24227":1431,"_20499":39928,"_5":24387,"_16438":39480,"_1794":39929},[],"Algoritmo de firma",{"_5719":1607,"_24227":1431,"_20499":39931,"_5":24387,"_16438":39480,"_1794":39932},[],"ML-DSA 44",{"_5719":1608,"_24227":1431,"_20499":39934,"_5":24387,"_16438":39480,"_1794":39935},[],"`MLDSA_44_PURE`",{"_5719":1609,"_24227":1431,"_20499":39937,"_5":24387,"_16438":39480,"_1794":39938},[],"ML-DSA 65",{"_5719":1610,"_24227":1431,"_20499":39940,"_5":24387,"_16438":39480,"_1794":39941},[],"`MLDSA_65_PURE`",{"_5719":1611,"_24227":1431,"_20499":39943,"_5":24387,"_16438":39480,"_1794":39944},[],"ML-DSA 87",{"_5719":1612,"_24227":1431,"_20499":39946,"_5":24387,"_16438":39480,"_1794":39947},[],"`MLDSA_87_PURE`",{"_5719":1613,"_24227":1431,"_20499":39949,"_5":24387,"_16438":39480,"_1794":39950},[],"SLH-DSA",{"_5719":1614,"_24227":1431,"_20499":39952,"_5":24387,"_16438":39480,"_1794":39953},[],"`SLHDSA_PURE`",{"_5719":1615,"_24227":1431,"_20499":39955,"_5":24387,"_16438":39480,"_1794":39956},[],"Composite-ML-DSA-RSA",{"_5719":1616,"_24227":1431,"_20499":39958,"_5":24387,"_16438":39480,"_1794":39959},[],"`COMPOSITE_MLDSA_RSA_PURE`",{"_5719":1617,"_24227":1431,"_20499":39961,"_5":24387,"_16438":39480,"_1794":39962},[],"Composite-ML-DSA-ECDSA",{"_5719":1618,"_24227":1431,"_20499":39964,"_5":24387,"_16438":39480,"_1794":39965},[],"`COMPOSITE_MLDSA_ECDSA_PURE`",{"_5719":1619,"_24227":1431,"_20499":39967,"_5":24387,"_16438":39480,"_1794":39968},[],"Composite-ML-DSA-Ed25519",{"_5719":1620,"_24227":1431,"_20499":39970,"_5":24387,"_16438":39480,"_1794":39971},[],"`COMPOSITE_MLDSA_ED25519_PURE`",{"_5719":1621,"_24227":1431,"_20499":39973,"_5":24387,"_16438":39480,"_1794":39974},[],"Ed25519",{"_5719":1622,"_24227":1431,"_20499":39976,"_5":24387,"_16438":39480,"_1794":39977},[],"`Ed25519_PURE`",{"_5719":1623,"_24227":1431,"_20499":39979,"_5":24387,"_16438":39480,"_1794":39980},[],"Todos estos algoritmos son de modo *pure*: la firma se calcula **directamente sobre el mensaje en claro**, sin un paso previo de resumen (*digest*). Por ello, la petición debe usar el tipo de mensaje `raw`; los algoritmos PQC no aceptan firmar sobre un hash precalculado. El campo `message` es un array de bytes, por lo que el mensaje se envía codificado en **Base64**:",{"_5719":1624,"_24227":1431,"_20499":39982,"_5":24387,"_16438":39480,"_1794":39983},[],"En el caso de las claves compuestas, la firma devuelta es la firma compuesta completa, y la verificación valida simultáneamente la parte ML-DSA y la parte clásica (RSA, ECDSA o Ed25519) según la variante de la clave.",{"_5719":1625,"_24227":1431,"_20499":39985,"_5":24387,"_16438":39480,"_1794":39986},[],"La verificación (`POST /v1/keys/:id/verify`) usa el mismo cuerpo que la firma, añadiendo el campo `signature` (también en Base64) con la firma que se desea comprobar, obtenida del endpoint de firma.",{"_5719":1626,"_24227":1431,"_20499":39988,"_5":24387,"_16438":39488,"_1794":39989},[],"La creación de una CA utiliza el endpoint `POST /v1/cas` con el bloque `key_metadata`, que indica el tipo de clave y su tamaño o variante. Lamassu genera la clave en el motor indicado reutilizando el flujo de creación de claves:",{"_5719":1627,"_24227":1431,"_20499":39991,"_5":24387,"_16438":39488,"_1794":39992},[],"Los valores admitidos en `key_metadata.type` son los mismos que los algoritmos del KMS: `ML-DSA`, `SLH-DSA`, `Composite-ML-DSA-RSA`, `Composite-ML-DSA-ECDSA`, `Composite-ML-DSA-Ed25519`, junto con los clásicos `RSA`, `ECDSA` y `Ed25519`. En `bits` se indica el tamaño o variante según la tabla de algoritmos.",{"_5719":1628,"_24227":1431,"_20499":39994,"_5":24387,"_16438":39488,"_1794":39995},[],"El campo `profile_id` es obligatorio y debe referenciar un perfil de emisión de tipo CA existente: si se omite, la petición responde con un error de validación (400), y si el perfil indicado no existe, con un 404. La expiración se expresa con el bloque `ca_expiration`, que admite una duración relativa (`\"type\": \"Duration\"`, con valores como `\"1y\"`, `\"6m\"` o `\"30d\"`) o una fecha absoluta (`\"type\": \"Time\"`).",{"_5719":1629,"_24227":1431,"_20499":39997,"_5":24387,"_16438":39492,"_1794":39998},[],"La importación de CAs (`POST /v1/cas/import`) admite claves privadas post-cuánticas generadas externamente. La clave privada se envía en formato PEM codificado en Base64 y el SDK la serializa internamente a PKCS#8, soportando los mismos tipos de clave que la importación de claves del KMS: ML-DSA, SLH-DSA, compuestas y Ed25519, además de RSA y ECDSA.",{"_5719":1630,"_24227":1431,"_20499":40000,"_5":24387,"_16438":39496,"_1794":40001},[],"El motor X.509 de Lamassu puede firmar certificados cruzando familias de algoritmos entre la CA emisora y el certificado emitido. Esto habilita arquitecturas de migración graduales, entre otras:",{"_5719":1631,"_24227":1431,"_20499":40003,"_5":24387,"_16438":39496,"_1794":40004},[],"CA raíz SLH-DSA que emite certificados de hoja ECDSA.",{"_5719":1632,"_24227":1431,"_20499":40006,"_5":24387,"_16438":39496,"_1794":40007},[],"CA ECDSA que firma solicitudes de certificado (CSR) firmadas con SLH-DSA.",{"_5719":1633,"_24227":1431,"_20499":40009,"_5":24387,"_16438":39496,"_1794":40010},[],"Cadenas en las que raíz e intermedia son post-cuánticas y la hoja es clásica, o viceversa.",{"_5719":1634,"_24227":1431,"_20499":40012,"_5":24387,"_16438":39496,"_1794":40013},[],"La cadena elegida debe ser verificable por los consumidores finales de los certificados: si un dispositivo o servicio no soporta todavía los algoritmos PQC, las firmas compuestas pueden servir como punto de transición.",{"_5719":1635,"_24227":1431,"_20499":40015,"_5":24387,"_16438":39496,"_1794":40016},[],"Durante la creación o importación de una CA, el servicio puede devolver el error `incompatible expiration time ref` si la referencia temporal de validez no es compatible con el certificado que se intenta registrar. El SDK de Go lo mapea a un error de tipo `400` (y `500` en la creación de CA) para facilitar su gestión desde las integraciones.",{"_5719":1636,"_24227":1431,"_20499":40018,"_5":24387,"_16438":39500,"_1794":40019},[],"El SDK de Go de LamassuQ expone la funcionalidad PQC a través de los mismos clientes de KMS y CA, además de añadir utilidades criptográficas para generar material PQC de forma local:",{"_5719":1637,"_24227":1431,"_20499":40021,"_5":24387,"_16438":39500,"_1794":40022},[],"`GenerateMLDSAKey(dimensions)`: genera una clave ML-DSA (44, 65 o 87).",{"_5719":1638,"_24227":1431,"_20499":40024,"_5":24387,"_16438":39500,"_1794":40025},[],"`GenerateSLHDSAKey(paramSet)`: genera una clave SLH-DSA para el conjunto de parámetros indicado.",{"_5719":1639,"_24227":1431,"_20499":40027,"_5":24387,"_16438":39500,"_1794":40028},[],"`GenerateCompositeMLDSAKey(variant)`: genera una clave compuesta para la variante 1–15. Se mantiene también el alias `GenerateCompositeMLDSARSAKey(variant)` por compatibilidad.",{"_5719":1640,"_24227":1431,"_20499":40030,"_5":24387,"_16438":39500,"_1794":40031},[],"`GenerateEd25519Key()`: genera una clave Ed25519.",{"_5719":1641,"_24227":1431,"_20499":40033,"_5":24387,"_16438":39500,"_1794":40034},[],"`ValidateCertAndPrivKey(...)`: valida que un certificado y su clave privada coincidan, extendida para admitir claves ML-DSA y Ed25519 junto a RSA y ECDSA.",{"_5719":1642,"_24227":1431,"_20499":40036,"_5":24387,"_16438":39500,"_1794":40037},[],"Estas utilidades son útiles para preparar material de prueba, automatizar la importación de claves o construir CSR firmadas con algoritmos PQC antes de registrarlas en la plataforma.",{"_5719":1643,"_24227":1431,"_20499":40039,"_5":24387,"_16438":39504,"_1794":40040},[],"LamassuQ se construye sobre una cadena de herramientas con soporte criptográfico post-cuántico:",{"_5719":1644,"_24227":1431,"_20499":40042,"_5":24387,"_16438":39504,"_1794":40043},[],"Las imágenes de los servicios se compilan con la imagen de Go con soporte PQC `ghcr.io/lamassuiot/golang-pqc:latest`, que incluye las primitivas ML-DSA (paquete `crypto/mldsa` del *fork* de la librería estándar de Go) y las primitivas SLH-DSA y compuestas de la librería `cloudflare/circl`.",{"_5719":1645,"_24227":1431,"_20499":40045,"_5":24387,"_16438":39504,"_1794":40046},[],"Las imágenes de contenedor de cada servicio se publican con la etiqueta `:pqc`, por ejemplo `ghcr.io/lamassuiot/lamassu-ca:pqc` o `ghcr.io/lamassuiot/lamassu-kms:pqc`.",{"_5719":1646,"_24227":1431,"_20499":40048,"_5":24387,"_16438":39504,"_1794":40049},[],"Existe una imagen *monolítica* adicional (`ci/monolithic.dockerfile`) que agrupa los servicios en un único contenedor.",{"_5719":1647,"_24227":1431,"_20499":40051,"_5":24387,"_16438":39504,"_1794":40052},[],"El script `deploy-lamassuq.sh` automatiza la construcción y publicación de las imágenes `:pqc` de cada servicio a partir de los ficheros `ci/pq_<componente>.dockerfile`. La cadena de herramientas se basa en Go 1.27.",{"_5719":1648,"_24227":1431,"_20499":40054,"_5":24387,"_16438":39504,"_1794":40055},[],"Para activar el soporte PQC, las imágenes de los servicios y la imagen de Go de compilación deben actualizarse a las versiones PQC. Un despliegue que mezcle imágenes PQC y no-PQC puede provocar inconsistencias, ya que los binarios no-PQC no reconocen los algoritmos añadidos.",{"_5719":1649,"_24227":1431,"_20499":40057,"_5":24387,"_16438":39508,"_1794":40058},[],"**Inventariar el estado actual**: identifique las CAs, las claves y los perfiles de emisión que operan con RSA y ECDSA, y los consumidores que dependen de ellos.",{"_5719":1650,"_24227":1431,"_20499":40060,"_5":24387,"_16438":39508,"_1794":40061},[],"**Empezar por los motores soportados**: despliegue un motor Software o File System para alojar las primeras claves PQC de prueba. Hasta que los motores externos y los HSM soporten PQC, mantenga las claves clásicas de producción en sus motores actuales.",{"_5719":1651,"_24227":1431,"_20499":40063,"_5":24387,"_16438":39508,"_1794":40064},[],"**Usar firmas compuestas como puente**: durante la transición, las claves compuestas ML-DSA + RSA/ECDSA/Ed25519 permiten emitir certificados verificables tanto por consumidores clásicos como por consumidores preparados para PQC.",{"_5719":1652,"_24227":1431,"_20499":40066,"_5":24387,"_16438":39508,"_1794":40067},[],"**Probar cadenas mixtas**: antes de migrar una raíz de confianza, valide en un entorno de pruebas que los dispositivos y servicios objetivo verifican correctamente las cadenas mixtas y las firmas *pure*.",{"_5719":1653,"_24227":1431,"_20499":40069,"_5":24387,"_16438":39508,"_1794":40070},[],"**Planificar la renovación de las raíces**: la migración definitiva exige emitir nuevas raíces e intermedias post-cuánticas y reemplazar progresivamente las clásicas, respetando los periodos de vida de los certificados ya emitidos.",{"_5719":1654,"_24227":1654,"_5":24382,"_1794":40072,"_24395":40073,"_20499":40074,"_16438":1654},"[DMS] Device Management Service",[35169,36268,36277],[],{"_5719":1655,"_24227":1654,"_20499":40076,"_5":24387,"_16438":1654,"_1794":40077},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_5719":1656,"_24227":1654,"_5":24392,"_20499":40079,"_16438":40080,"_1794":40081},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#device-management-service","Device Management Service",{"_5719":1657,"_24227":1654,"_5":24392,"_20499":40083,"_16438":40084,"_1794":38006},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#antes-de-empezar",{"_5719":1658,"_24227":1654,"_5":24392,"_20499":40086,"_16438":40087,"_1794":40088},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_5719":1659,"_24227":1654,"_5":24392,"_20499":40090,"_16438":40091,"_1794":40092},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_5719":1660,"_24227":1654,"_5":24392,"_20499":40094,"_16438":40095,"_1794":40096},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_5719":1661,"_24227":1654,"_20499":40098,"_5":24387,"_16438":40080,"_1794":40099},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_5719":1662,"_24227":1654,"_20499":40101,"_5":24387,"_16438":40080,"_1794":40102},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_5719":1663,"_24227":1654,"_20499":40104,"_5":24387,"_16438":40084,"_1794":40105},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_5719":1664,"_24227":1654,"_20499":40107,"_5":24387,"_16438":40087,"_1794":40108},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_5719":1665,"_24227":1654,"_20499":40110,"_5":24387,"_16438":40087,"_1794":40111},[],"Acción",{"_5719":1666,"_24227":1654,"_20499":40113,"_5":24387,"_16438":40087,"_1794":35372},[],{"_5719":1667,"_24227":1654,"_20499":40115,"_5":24387,"_16438":40087,"_1794":40116},[],"**Edit**",{"_5719":1668,"_24227":1654,"_20499":40118,"_5":24387,"_16438":40087,"_1794":40119},[],"Modifica la configuración del DMS.",{"_5719":1669,"_24227":1654,"_20499":40121,"_5":24387,"_16438":40087,"_1794":40122},[],"**Go to DMS owned devices**",{"_5719":1670,"_24227":1654,"_20499":40124,"_5":24387,"_16438":40087,"_1794":40125},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_5719":1671,"_24227":1654,"_20499":40127,"_5":24387,"_16438":40087,"_1794":40128},[],"**Show/Edit Metadata**",{"_5719":1672,"_24227":1654,"_20499":40130,"_5":24387,"_16438":40087,"_1794":40131},[],"Accede a los metadatos del DMS para usos avanzados.",{"_5719":1673,"_24227":1654,"_20499":40133,"_5":24387,"_16438":40087,"_1794":40134},[],"**EST (RFC-7030)**",{"_5719":1674,"_24227":1654,"_20499":40136,"_5":24387,"_16438":40087,"_1794":40137},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_5719":1675,"_24227":1654,"_20499":40139,"_5":24387,"_16438":40087,"_1794":40140},[],"**Delete**",{"_5719":1676,"_24227":1654,"_20499":40142,"_5":24387,"_16438":40087,"_1794":40143},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_5719":1677,"_24227":1654,"_20499":40145,"_5":24387,"_16438":40091,"_1794":40146},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_5719":1678,"_24227":1654,"_20499":40148,"_5":24387,"_16438":40091,"_1794":36500},[],{"_5719":1679,"_24227":1654,"_20499":40150,"_5":24387,"_16438":40091,"_1794":35372},[],{"_5719":1680,"_24227":1654,"_20499":40152,"_5":24387,"_16438":40091,"_1794":40153},[],"**Include Lamassu System CA**",{"_5719":1681,"_24227":1654,"_20499":40155,"_5":24387,"_16438":40091,"_1794":40156},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_5719":1682,"_24227":1654,"_20499":40158,"_5":24387,"_16438":40091,"_1794":40159},[],"**Include Enrollment CA**",{"_5719":1683,"_24227":1654,"_20499":40161,"_5":24387,"_16438":40091,"_1794":40162},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_5719":1684,"_24227":1654,"_20499":40164,"_5":24387,"_16438":40091,"_1794":40165},[],"**Managed CAs**",{"_5719":1685,"_24227":1654,"_20499":40167,"_5":24387,"_16438":40091,"_1794":40168},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_5719":1686,"_24227":1654,"_20499":40170,"_5":24387,"_16438":40095,"_1794":40171},[],"El DMS expone un protocolo de enrolamiento a los dispositivos. En la versión actual de Lamassu, el único protocolo soportado es &#x2A;*EST (RFC 7030)**. La configuración del protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_5719":1687,"_24227":1654,"_20499":40173,"_5":24387,"_16438":40095,"_1794":40174},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_5719":1688,"_24227":1654,"_20499":40176,"_5":24387,"_16438":40095,"_1794":38968},[],{"_5719":1689,"_24227":1689,"_5":24382,"_1794":40178,"_24395":40179,"_20499":40180,"_16438":1689},"[VA] Servicio CRL",[35169,36268,36277],[],{"_5719":1690,"_24227":1689,"_20499":40182,"_5":24387,"_16438":1689,"_1794":40183},[],"Gestión y consulta de listas de revocación para validación offline",{"_5719":1691,"_24227":1689,"_5":24392,"_20499":40185,"_16438":40186,"_1794":40187},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_5719":1692,"_24227":1689,"_5":24392,"_20499":40189,"_16438":40190,"_1794":40191},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_5719":1693,"_24227":1689,"_5":24392,"_20499":40193,"_16438":40194,"_1794":40195},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_5719":1694,"_24227":1689,"_5":24392,"_20499":40197,"_16438":40198,"_1794":40199},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_5719":1695,"_24227":1689,"_5":24392,"_20499":40201,"_16438":40202,"_1794":40203},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_5719":1696,"_24227":1689,"_5":24392,"_20499":40205,"_16438":40206,"_1794":40207},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_5719":1697,"_24227":1689,"_5":24392,"_20499":40209,"_16438":40210,"_1794":40211},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_5719":1698,"_24227":1689,"_5":24392,"_20499":40213,"_16438":40214,"_1794":40215},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#referencias","Referencias",{"_5719":1699,"_24227":1689,"_20499":40217,"_5":24387,"_16438":40186,"_1794":40218},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_5719":1700,"_24227":1689,"_20499":40220,"_5":24387,"_16438":40186,"_1794":40221},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_5719":1701,"_24227":1689,"_20499":40223,"_5":24387,"_16438":40190,"_1794":40224},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_5719":1702,"_24227":1689,"_20499":40226,"_5":24387,"_16438":40190,"_1794":40227},[],"Los parámetros principales son:",{"_5719":1703,"_24227":1689,"_20499":40229,"_5":24387,"_16438":40190,"_1794":36500},[],{"_5719":1704,"_24227":1689,"_20499":40231,"_5":24387,"_16438":40190,"_1794":35369},[],{"_5719":1705,"_24227":1689,"_20499":40233,"_5":24387,"_16438":40190,"_1794":35372},[],{"_5719":1706,"_24227":1689,"_20499":40235,"_5":24387,"_16438":40190,"_1794":40236},[],"`validity`",{"_5719":1707,"_24227":1689,"_20499":40238,"_5":24387,"_16438":40190,"_1794":40239},[],"7 días",{"_5719":1708,"_24227":1689,"_20499":40241,"_5":24387,"_16438":40190,"_1794":40242},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_5719":1709,"_24227":1689,"_20499":40244,"_5":24387,"_16438":40190,"_1794":40245},[],"`refresh_interval`",{"_5719":1710,"_24227":1689,"_20499":40247,"_5":24387,"_16438":40190,"_1794":40248},[],"\\~6 días y 23 horas",{"_5719":1711,"_24227":1689,"_20499":40250,"_5":24387,"_16438":40190,"_1794":40251},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_5719":1712,"_24227":1689,"_20499":40253,"_5":24387,"_16438":40190,"_1794":40254},[],"`regenerate_on_revoke`",{"_5719":1713,"_24227":1689,"_20499":40256,"_5":24387,"_16438":40190,"_1794":40257},[],"`true`",{"_5719":1714,"_24227":1689,"_20499":40259,"_5":24387,"_16438":40190,"_1794":40260},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_5719":1715,"_24227":1689,"_20499":40262,"_5":24387,"_16438":40190,"_1794":40263},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_5719":1716,"_24227":1689,"_20499":40265,"_5":24387,"_16438":40190,"_1794":40266},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_5719":1717,"_24227":1689,"_20499":40268,"_5":24387,"_16438":40194,"_1794":40269},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_5719":1718,"_24227":1689,"_20499":40271,"_5":24387,"_16438":40194,"_1794":40272},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_5719":1719,"_24227":1689,"_20499":40274,"_5":24387,"_16438":40198,"_1794":40275},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_5719":1720,"_24227":1689,"_20499":40277,"_5":24387,"_16438":40198,"_1794":40278},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_5719":1721,"_24227":1689,"_20499":40280,"_5":24387,"_16438":40202,"_1794":40281},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_5719":1722,"_24227":1689,"_20499":40283,"_5":24387,"_16438":40202,"_1794":40284},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_5719":1723,"_24227":1689,"_20499":40286,"_5":24387,"_16438":40206,"_1794":40287},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_5719":1724,"_24227":1689,"_20499":40289,"_5":24387,"_16438":40206,"_1794":40290},[],"Método",{"_5719":1725,"_24227":1689,"_20499":40292,"_5":24387,"_16438":40206,"_1794":40293},[],"Ruta",{"_5719":1726,"_24227":1689,"_20499":40295,"_5":24387,"_16438":40206,"_1794":35372},[],{"_5719":1727,"_24227":1689,"_20499":40297,"_5":24387,"_16438":40206,"_1794":40298},[],"`GET`",{"_5719":1728,"_24227":1689,"_20499":40300,"_5":24387,"_16438":40206,"_1794":40301},[],"`/v1/roles/{ca-ski}`",{"_5719":1729,"_24227":1689,"_20499":40303,"_5":24387,"_16438":40206,"_1794":40304},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_5719":1730,"_24227":1689,"_20499":40306,"_5":24387,"_16438":40206,"_1794":40307},[],"`PUT`",{"_5719":1731,"_24227":1689,"_20499":40309,"_5":24387,"_16438":40206,"_1794":40301},[],{"_5719":1732,"_24227":1689,"_20499":40311,"_5":24387,"_16438":40206,"_1794":40312},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_5719":1733,"_24227":1689,"_20499":40314,"_5":24387,"_16438":40206,"_1794":40315},[],"Ejemplo de consulta del rol VA:",{"_5719":1734,"_24227":1689,"_20499":40317,"_5":24387,"_16438":40206,"_1794":40318},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_5719":1735,"_24227":1689,"_20499":40320,"_5":24387,"_16438":40210,"_1794":40321},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_5719":1736,"_24227":1689,"_20499":40323,"_5":24387,"_16438":40214,"_1794":40324},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_5719":1737,"_24227":1689,"_20499":40326,"_5":24387,"_16438":40214,"_1794":40327},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_5719":1738,"_24227":1689,"_20499":40329,"_5":24387,"_16438":40214,"_1794":40330},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_5719":1739,"_24227":1739,"_5":24382,"_1794":40332,"_24395":40333,"_20499":40334,"_16438":1739},"[VA] Servicio OCSP",[35169,36268,36277],[],{"_5719":1740,"_24227":1739,"_20499":40336,"_5":24387,"_16438":1739,"_1794":40337},[],"Validación online del estado de certificados mediante OCSP",{"_5719":1741,"_24227":1739,"_5":24392,"_20499":40339,"_16438":40340,"_1794":40341},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_5719":1742,"_24227":1739,"_5":24392,"_20499":40343,"_16438":40344,"_1794":40345},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_5719":1743,"_24227":1739,"_5":24392,"_20499":40347,"_16438":40348,"_1794":40349},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_5719":1744,"_24227":1739,"_5":24392,"_20499":40351,"_16438":40352,"_1794":40353},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_5719":1745,"_24227":1739,"_5":24392,"_20499":40355,"_16438":40356,"_1794":40357},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_5719":1746,"_24227":1739,"_5":24392,"_20499":40359,"_16438":40360,"_1794":40215},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#referencias",{"_5719":1747,"_24227":1739,"_20499":40362,"_5":24387,"_16438":40340,"_1794":40363},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_5719":1748,"_24227":1739,"_20499":40365,"_5":24387,"_16438":40340,"_1794":40366},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_5719":1749,"_24227":1739,"_20499":40368,"_5":24387,"_16438":40344,"_1794":40369},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_5719":1750,"_24227":1739,"_20499":40371,"_5":24387,"_16438":40344,"_1794":40372},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_5719":1751,"_24227":1739,"_20499":40374,"_5":24387,"_16438":40344,"_1794":40375},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_5719":1752,"_24227":1739,"_20499":40377,"_5":24387,"_16438":40344,"_1794":40378},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_5719":1753,"_24227":1739,"_20499":40380,"_5":24387,"_16438":40344,"_1794":40381},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_5719":1754,"_24227":1739,"_20499":40383,"_5":24387,"_16438":40344,"_1794":40384},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_5719":1755,"_24227":1739,"_20499":40386,"_5":24387,"_16438":40348,"_1794":40387},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_5719":1756,"_24227":1739,"_20499":40389,"_5":24387,"_16438":40352,"_1794":40390},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_5719":1757,"_24227":1739,"_20499":40392,"_5":24387,"_16438":40352,"_1794":40290},[],{"_5719":1758,"_24227":1739,"_20499":40394,"_5":24387,"_16438":40352,"_1794":40293},[],{"_5719":1759,"_24227":1739,"_20499":40396,"_5":24387,"_16438":40352,"_1794":35372},[],{"_5719":1760,"_24227":1739,"_20499":40398,"_5":24387,"_16438":40352,"_1794":40298},[],{"_5719":1761,"_24227":1739,"_20499":40400,"_5":24387,"_16438":40352,"_1794":40401},[],"`/ocsp/{ocsp_request}`",{"_5719":1762,"_24227":1739,"_20499":40403,"_5":24387,"_16438":40352,"_1794":40404},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_5719":1763,"_24227":1739,"_20499":40406,"_5":24387,"_16438":40352,"_1794":40407},[],"`POST`",{"_5719":1764,"_24227":1739,"_20499":40409,"_5":24387,"_16438":40352,"_1794":40410},[],"`/ocsp`",{"_5719":1765,"_24227":1739,"_20499":40412,"_5":24387,"_16438":40352,"_1794":40413},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_5719":1766,"_24227":1739,"_20499":40415,"_5":24387,"_16438":40352,"_1794":40416},[],"Ejemplo de consulta con `curl` mediante POST:",{"_5719":1767,"_24227":1739,"_20499":40418,"_5":24387,"_16438":40352,"_1794":40419},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_5719":1768,"_24227":1739,"_20499":40421,"_5":24387,"_16438":40356,"_1794":40422},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_5719":1769,"_24227":1739,"_20499":40424,"_5":24387,"_16438":40360,"_1794":40425},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_5719":1770,"_24227":1739,"_20499":40427,"_5":24387,"_16438":40360,"_1794":40428},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_5719":1771,"_24227":1739,"_20499":40430,"_5":24387,"_16438":40360,"_1794":40431},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_5719":1772,"_24227":1739,"_20499":40433,"_5":24387,"_16438":40360,"_1794":40330},[],{"_5719":1773,"_24227":1773,"_5":24382,"_1794":40435,"_24395":40436,"_20499":40437,"_16438":1773},"[VA] Validación de Certificados",[35169,36268,36277],[],{"_5719":1774,"_24227":1773,"_20499":40439,"_5":24387,"_16438":1773,"_1794":40440},[],"Servicios OCSP y CRL para validación de certificados",{"_5719":1775,"_24227":1773,"_5":24392,"_20499":40442,"_16438":40443,"_1794":40444},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_5719":1776,"_24227":1773,"_20499":40446,"_5":24387,"_16438":40443,"_1794":40447},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_5719":1777,"_24227":1773,"_20499":40449,"_5":24387,"_16438":40443,"_1794":40450},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_5719":1778,"_24227":1773,"_20499":40452,"_5":24387,"_16438":40443,"_1794":40453},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_5719":1779,"_24227":1773,"_20499":40455,"_5":24387,"_16438":40443,"_1794":40456},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_5719":1780,"_24227":1780,"_5":24382,"_1794":40458,"_20499":40459,"_16438":1780},"Test",[],{"_5719":1781,"_24227":1780,"_20499":40461,"_5":24387,"_16438":1780,"_1794":40462},[],"A document to test Fumadocs",{"_5719":1782,"_24227":1780,"_5":24392,"_20499":40464,"_16438":40465,"_1794":40466},[],"/docs/pr-preview/pr-25/test#cards","Cards",{"_5719":1783,"_24227":1780,"_5":24392,"_20499":40468,"_16438":40469,"_1794":40470},[],"/docs/pr-preview/pr-25/test#codeblock","CodeBlock",{"_5719":1784,"_24227":1780,"_5":24392,"_20499":40472,"_16438":40473,"_1794":40474},[],"/docs/pr-preview/pr-25/test#list","List",{"_5719":1785,"_24227":1780,"_20499":40476,"_5":24387,"_16438":1780,"_1794":40477},[],"Hey there!",{"_5719":1786,"_24227":1780,"_20499":40479,"_5":24387,"_16438":40465,"_1794":40480},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_5719":1787,"_24227":1780,"_20499":40482,"_5":24387,"_16438":40465,"_1794":40483},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_5719":1788,"_24227":1780,"_20499":40485,"_5":24387,"_16438":40473,"_1794":40486},[],"Hello",{"_5719":1789,"_24227":1780,"_20499":40488,"_5":24387,"_16438":40473,"_1794":40489},[],"World","sorting",{"_40492":40493,"_40494":40495,"_40496":40497,"_40498":40499,"_4970":1812,"_47629":1812},"language","english","sortableProperties",[1794,24227,5,16438],"sortablePropertiesWithTypes",{"_1794":12452,"_24227":12452,"_5":12452,"_16438":12452},"sorts",{"_1794":40500,"_24227":42283,"_5":44065,"_16438":45847},{"_8934":40501,"_40502":40503,"_5":12452},{"_12141":9526,"_4444":6324,"_14588":7457,"_7300":23511,"_14575":19400,"_7308":11110,"_14537":8208,"_7315":3154,"_12603":3378,"_23792":23727,"_23786":21911,"_23818":8898,"_238