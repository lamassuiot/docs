"`yq`",{"_8073":125,"_22563":34,"_19084":32793,"_5":22713,"_15335":32525,"_1612":32794},[],"CLI de la distribución detectada",{"_8073":126,"_22563":34,"_19084":32796,"_5":22713,"_15335":32525,"_1612":32797},[],"Requisitos específicos:",{"_8073":127,"_22563":34,"_19084":32799,"_5":22713,"_15335":32525,"_1612":32800},[],"Distribución",{"_8073":128,"_22563":34,"_19084":32802,"_5":22713,"_15335":32525,"_1612":32803},[],"Herramientas requeridas",{"_8073":129,"_22563":34,"_19084":32805,"_5":22713,"_15335":32525,"_1612":32767},[],{"_8073":130,"_22563":34,"_19084":32807,"_5":22713,"_15335":32525,"_1612":32808},[],"`kubectl`, `helm`",{"_8073":131,"_22563":34,"_19084":32810,"_5":22713,"_15335":32525,"_1612":32764},[],{"_8073":132,"_22563":34,"_19084":32812,"_5":22713,"_15335":32525,"_1612":32813},[],"`microk8s kubectl`, `microk8s helm`",{"_8073":133,"_22563":34,"_19084":32815,"_5":22713,"_15335":32529,"_1612":32816},[],"Se valida que estén habilitados:",{"_8073":134,"_22563":34,"_19084":32818,"_5":22713,"_15335":32529,"_1612":32819},[],"`helm`",{"_8073":135,"_22563":34,"_19084":32821,"_5":22713,"_15335":32529,"_1612":32822},[],"`hostpath-storage`",{"_8073":136,"_22563":34,"_19084":32824,"_5":22713,"_15335":32529,"_1612":32825},[],"`dns`",{"_8073":137,"_22563":34,"_19084":32827,"_5":22713,"_15335":32529,"_1612":32828},[],"`cert-manager`",{"_8073":138,"_22563":34,"_19084":32830,"_5":22713,"_15335":32529,"_1612":32831},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_8073":139,"_22563":34,"_19084":32833,"_5":22713,"_15335":32537,"_1612":32834},[],"La función `request_config_data` solicita:",{"_8073":140,"_22563":34,"_19084":32836,"_5":22713,"_15335":32537,"_1612":32837},[],"Dominio Lamassu",{"_8073":141,"_22563":34,"_19084":32839,"_5":22713,"_15335":32537,"_1612":32840},[],"Usuario y contraseña admin PostgreSQL",{"_8073":142,"_22563":34,"_19084":32842,"_5":22713,"_15335":32537,"_1612":32843},[],"Usuario y contraseña admin RabbitMQ",{"_8073":143,"_22563":34,"_19084":32845,"_5":22713,"_15335":32537,"_1612":32846},[],"Usuario y contraseña admin Keycloak",{"_8073":144,"_22563":34,"_19084":32848,"_5":22713,"_15335":32537,"_1612":32849},[],"Namespace Kubernetes",{"_8073":145,"_22563":34,"_19084":32851,"_5":22713,"_15335":32541,"_1612":32852},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_8073":146,"_22563":34,"_19084":32854,"_5":22713,"_15335":32541,"_1612":32855},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_8073":147,"_22563":34,"_19084":32857,"_5":22713,"_15335":32545,"_1612":32858},[],"El script admite dos estrategias para obtener charts Helm.",{"_8073":148,"_22563":34,"_19084":32860,"_5":22713,"_15335":32549,"_1612":32861},[],"Los charts se descargan desde repositorios remotos.",{"_8073":149,"_22563":34,"_19084":32863,"_5":22713,"_15335":32553,"_1612":32864},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_8073":150,"_22563":34,"_19084":32866,"_5":22713,"_15335":32553,"_1612":32721},[],{"_8073":151,"_22563":34,"_19084":32868,"_5":22713,"_15335":32553,"_1612":32729},[],{"_8073":152,"_22563":34,"_19084":32870,"_5":22713,"_15335":32553,"_1612":32737},[],{"_8073":153,"_22563":34,"_19084":32872,"_5":22713,"_15335":32553,"_1612":32745},[],{"_8073":154,"_22563":34,"_19084":32874,"_5":22713,"_15335":32553,"_1612":32875},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_8073":155,"_22563":34,"_19084":32877,"_5":22713,"_15335":32553,"_1612":32878},[],"En este modo se fuerza:",{"_8073":156,"_22563":34,"_19084":32880,"_5":22713,"_15335":32561,"_1612":32881},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_8073":157,"_22563":34,"_19084":32883,"_5":22713,"_15335":32561,"_1612":32884},[],"Versión del chart: `0.19.0`",{"_8073":158,"_22563":34,"_19084":32886,"_5":22713,"_15335":32561,"_1612":32887},[],"Release: `postgres`",{"_8073":159,"_22563":34,"_19084":32889,"_5":22713,"_15335":32561,"_1612":32890},[],"`fullnameOverride: \"postgresql\"`",{"_8073":160,"_22563":34,"_19084":32892,"_5":22713,"_15335":32561,"_1612":32893},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_8073":161,"_22563":34,"_19084":32895,"_5":22713,"_15335":32561,"_1612":32896},[],"Base de datos",{"_8073":162,"_22563":34,"_19084":32898,"_5":22713,"_15335":32561,"_1612":32899},[],"Servicio",{"_8073":163,"_22563":34,"_19084":32901,"_5":22713,"_15335":32561,"_1612":32902},[],"`auth`",{"_8073":164,"_22563":34,"_19084":32904,"_5":22713,"_15335":32561,"_1612":32614},[],{"_8073":165,"_22563":34,"_19084":32906,"_5":22713,"_15335":32561,"_1612":32907},[],"`alerts`",{"_8073":166,"_22563":34,"_19084":32909,"_5":22713,"_15335":32561,"_1612":32910},[],"Alerts",{"_8073":167,"_22563":34,"_19084":32912,"_5":22713,"_15335":32561,"_1612":32913},[],"`ca`",{"_8073":168,"_22563":34,"_19084":32915,"_5":22713,"_15335":32561,"_1612":32916},[],"CA",{"_8073":169,"_22563":34,"_19084":32918,"_5":22713,"_15335":32561,"_1612":32919},[],"`va`",{"_8073":170,"_22563":34,"_19084":32921,"_5":22713,"_15335":32561,"_1612":32922},[],"VA",{"_8073":171,"_22563":34,"_19084":32924,"_5":22713,"_15335":32561,"_1612":32925},[],"`cloudproxy`",{"_8073":172,"_22563":34,"_19084":32927,"_5":22713,"_15335":32561,"_1612":32928},[],"Cloud Proxy",{"_8073":173,"_22563":34,"_19084":32930,"_5":22713,"_15335":32561,"_1612":32931},[],"`devicemanager`",{"_8073":174,"_22563":34,"_19084":32933,"_5":22713,"_15335":32561,"_1612":32934},[],"Device Manager",{"_8073":175,"_22563":34,"_19084":32936,"_5":22713,"_15335":32561,"_1612":32937},[],"`dmsmanager`",{"_8073":176,"_22563":34,"_19084":32939,"_5":22713,"_15335":32561,"_1612":32940},[],"DMS Manager",{"_8073":177,"_22563":34,"_19084":32942,"_5":22713,"_15335":32561,"_1612":32943},[],"`kms`",{"_8073":178,"_22563":34,"_19084":32945,"_5":22713,"_15335":32561,"_1612":32946},[],"KMS",{"_8073":179,"_22563":34,"_19084":32948,"_5":22713,"_15335":32565,"_1612":32949},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_8073":180,"_22563":34,"_19084":32951,"_5":22713,"_15335":32565,"_1612":32952},[],"Versión del chart: `0.20.0`",{"_8073":181,"_22563":34,"_19084":32954,"_5":22713,"_15335":32565,"_1612":32955},[],"Release: `auth`",{"_8073":182,"_22563":34,"_19084":32957,"_5":22713,"_15335":32565,"_1612":32958},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_8073":183,"_22563":34,"_19084":32960,"_5":22713,"_15335":32565,"_1612":32961},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_8073":184,"_22563":34,"_19084":32963,"_5":22713,"_15335":32565,"_1612":32964},[],"`httpRelativePath: /auth/`",{"_8073":185,"_22563":34,"_19084":32966,"_5":22713,"_15335":32565,"_1612":32967},[],"`proxyHeaders: xforwarded`",{"_8073":186,"_22563":34,"_19084":32969,"_5":22713,"_15335":32565,"_1612":32970},[],"Configuración automática del realm `lamassu`:",{"_8073":187,"_22563":34,"_19084":32972,"_5":22713,"_15335":32565,"_1612":32973},[],"Rol: `pki-admin`",{"_8073":188,"_22563":34,"_19084":32975,"_5":22713,"_15335":32565,"_1612":32976},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_8073":189,"_22563":34,"_19084":32978,"_5":22713,"_15335":32565,"_1612":32979},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_8073":190,"_22563":34,"_19084":32981,"_5":22713,"_15335":32565,"_1612":32982},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_8073":191,"_22563":34,"_19084":32984,"_5":22713,"_15335":32565,"_1612":32985},[],"`github.com/lamassuiot/keycloak-theme`",{"_8073":192,"_22563":34,"_19084":32987,"_5":22713,"_15335":32569,"_1612":32988},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_8073":193,"_22563":34,"_19084":32990,"_5":22713,"_15335":32569,"_1612":32952},[],{"_8073":194,"_22563":34,"_19084":32992,"_5":22713,"_15335":32569,"_1612":32993},[],"Release: `rabbitmq`",{"_8073":195,"_22563":34,"_19084":32995,"_5":22713,"_15335":32569,"_1612":32996},[],"`fullnameOverride: \"rabbitmq\"`",{"_8073":196,"_22563":34,"_19084":32998,"_5":22713,"_15335":32569,"_1612":32999},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_8073":197,"_22563":34,"_19084":33001,"_5":22713,"_15335":32573,"_1612":33002},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_8073":198,"_22563":34,"_19084":33004,"_5":22713,"_15335":32573,"_1612":33005},[],"Configuraciones principales:",{"_8073":199,"_22563":34,"_19084":33007,"_5":22713,"_15335":32573,"_1612":33008},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_8073":200,"_22563":34,"_19084":33010,"_5":22713,"_15335":32573,"_1612":33011},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_8073":201,"_22563":34,"_19084":33013,"_5":22713,"_15335":32573,"_1612":33014},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_8073":202,"_22563":34,"_19084":33016,"_5":22713,"_15335":32573,"_1612":33017},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_8073":203,"_22563":34,"_19084":33019,"_5":22713,"_15335":32573,"_1612":33020},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_8073":204,"_22563":34,"_19084":33022,"_5":22713,"_15335":32573,"_1612":33023},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_8073":205,"_22563":34,"_19084":33025,"_5":22713,"_15335":32573,"_1612":33026},[],"Dominios CA: valor de `--domain`",{"_8073":206,"_22563":34,"_19084":33028,"_5":22713,"_15335":32573,"_1612":33029},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_8073":207,"_22563":34,"_19084":33031,"_5":22713,"_15335":32573,"_1612":33032},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_8073":208,"_22563":34,"_19084":33034,"_5":22713,"_15335":32573,"_1612":33035},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_8073":209,"_22563":34,"_19084":33037,"_5":22713,"_15335":32581,"_1612":33038},[],"Si se proporcionan:",{"_8073":210,"_22563":34,"_19084":33040,"_5":22713,"_15335":32581,"_1612":32705},[],{"_8073":211,"_22563":34,"_19084":33042,"_5":22713,"_15335":32581,"_1612":32713},[],{"_8073":212,"_22563":34,"_19084":33044,"_5":22713,"_15335":32581,"_1612":33045},[],"Se crea un secret Kubernetes:",{"_8073":213,"_22563":34,"_19084":33047,"_5":22713,"_15335":32581,"_1612":33048},[],"`downstream-provided-crt`",{"_8073":214,"_22563":34,"_19084":33050,"_5":22713,"_15335":32581,"_1612":33051},[],"Y se configura:",{"_8073":215,"_22563":34,"_19084":33053,"_5":22713,"_15335":32585,"_1612":33054},[],"Si no se proporciona certificado:",{"_8073":216,"_22563":34,"_19084":33056,"_5":22713,"_15335":32585,"_1612":33057},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_8073":217,"_22563":34,"_19084":33059,"_5":22713,"_15335":32585,"_1612":33060},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_8073":218,"_22563":34,"_19084":33062,"_5":22713,"_15335":32589,"_1612":33063},[],"En caso de éxito, se muestra:",{"_8073":219,"_22563":34,"_19084":33065,"_5":22713,"_15335":32589,"_1612":33066},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_8073":220,"_22563":34,"_19084":33068,"_5":22713,"_15335":32589,"_1612":33069},[],"Credenciales iniciales: `lamassu / lamassu`",{"_8073":221,"_22563":34,"_19084":33071,"_5":22713,"_15335":32589,"_1612":33072},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_8073":222,"_22563":34,"_19084":33074,"_5":22713,"_15335":32589,"_1612":33075},[],"Credenciales admin de Keycloak",{"_8073":223,"_22563":34,"_19084":33077,"_5":22713,"_15335":32589,"_1612":33078},[],"El usuario `lamassu` se crea con:",{"_8073":224,"_22563":34,"_19084":33080,"_5":22713,"_15335":32589,"_1612":33081},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_8073":225,"_22563":34,"_19084":33083,"_5":22713,"_15335":32593,"_1612":33084},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_8073":226,"_22563":34,"_19084":33086,"_5":22713,"_15335":32593,"_1612":33087},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_8073":227,"_22563":34,"_19084":33089,"_5":22713,"_15335":32593,"_1612":33090},[],"Ejemplo:",{"_8073":228,"_22563":34,"_19084":33092,"_5":22713,"_15335":32593,"_1612":33093},[],"En este escenario:",{"_8073":229,"_22563":34,"_19084":33095,"_5":22713,"_15335":32593,"_1612":33096},[],"`-n`: modo no interactivo",{"_8073":230,"_22563":34,"_19084":33098,"_5":22713,"_15335":32593,"_1612":33099},[],"`-ns`: namespace específico",{"_8073":231,"_22563":34,"_19084":33101,"_5":22713,"_15335":32593,"_1612":33102},[],"`-d`: dominio de CI",{"_8073":232,"_22563":34,"_19084":33104,"_5":22713,"_15335":32593,"_1612":33105},[],"`-l`: chart local",{"_8073":233,"_22563":34,"_19084":33107,"_5":22713,"_15335":32601,"_1612":33108},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_8073":234,"_22563":34,"_19084":33110,"_5":22713,"_15335":32601,"_1612":33111},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_8073":235,"_22563":235,"_5":22708,"_1612":33113,"_22721":33114,"_19084":33115,"_15335":235},"Introducción",[32429,32430,32481],[],{"_8073":236,"_22563":235,"_19084":33117,"_5":22713,"_15335":235,"_1612":33118},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_8073":237,"_22563":235,"_5":22718,"_19084":33120,"_15335":33121,"_1612":33122},[],"/docs/pr-preview/pr-25/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_8073":238,"_22563":235,"_5":22718,"_19084":33124,"_15335":33125,"_1612":33126},[],"/docs/pr-preview/pr-25/despliegue/onprem#quickstart","Quickstart",{"_8073":239,"_22563":235,"_5":22718,"_19084":33128,"_15335":33129,"_1612":33130},[],"/docs/pr-preview/pr-25/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_8073":240,"_22563":235,"_5":22718,"_19084":33132,"_15335":33133,"_1612":33134},[],"/docs/pr-preview/pr-25/despliegue/onprem#requisitos-previos","Requisitos previos",{"_8073":241,"_22563":235,"_5":22718,"_19084":33136,"_15335":33137,"_1612":33138},[],"/docs/pr-preview/pr-25/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_8073":242,"_22563":235,"_5":22718,"_19084":33140,"_15335":33141,"_1612":33142},[],"/docs/pr-preview/pr-25/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_8073":243,"_22563":235,"_5":22718,"_19084":33144,"_15335":33145,"_1612":33146},[],"/docs/pr-preview/pr-25/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_8073":244,"_22563":235,"_5":22718,"_19084":33148,"_15335":33149,"_1612":33150},[],"/docs/pr-preview/pr-25/despliegue/onprem#arquitectura","Arquitectura",{"_8073":245,"_22563":235,"_5":22718,"_19084":33152,"_15335":33153,"_1612":33154},[],"/docs/pr-preview/pr-25/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_8073":246,"_22563":235,"_5":22718,"_19084":33156,"_15335":33157,"_1612":33158},[],"/docs/pr-preview/pr-25/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_8073":247,"_22563":235,"_5":22718,"_19084":33160,"_15335":33161,"_1612":33162},[],"/docs/pr-preview/pr-25/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_8073":248,"_22563":235,"_5":22718,"_19084":33164,"_15335":33165,"_1612":33166},[],"/docs/pr-preview/pr-25/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_8073":249,"_22563":235,"_5":22718,"_19084":33168,"_15335":33169,"_1612":33170},[],"/docs/pr-preview/pr-25/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_8073":250,"_22563":235,"_5":22718,"_19084":33172,"_15335":33173,"_1612":33174},[],"/docs/pr-preview/pr-25/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_8073":251,"_22563":235,"_5":22718,"_19084":33176,"_15335":33177,"_1612":33178},[],"/docs/pr-preview/pr-25/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_8073":252,"_22563":235,"_19084":33180,"_5":22713,"_15335":33121,"_1612":33181},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_8073":253,"_22563":235,"_19084":33183,"_5":22713,"_15335":33121,"_1612":33184},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_8073":254,"_22563":235,"_19084":33186,"_5":22713,"_15335":33121,"_1612":33187},[],"el chart principal de Lamassu",{"_8073":255,"_22563":235,"_19084":33189,"_5":22713,"_15335":33121,"_1612":33190},[],"un chart auxiliar de SoftHSM",{"_8073":256,"_22563":235,"_19084":33192,"_5":22713,"_15335":33121,"_1612":33193},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_8073":257,"_22563":235,"_19084":33195,"_5":22713,"_15335":33125,"_1612":33196},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_8073":258,"_22563":235,"_19084":33198,"_5":22713,"_15335":33125,"_1612":33199},[],"Ese flujo:",{"_8073":259,"_22563":235,"_19084":33201,"_5":22713,"_15335":33125,"_1612":33202},[],"crea o reutiliza el namespace indicado",{"_8073":260,"_22563":235,"_19084":33204,"_5":22713,"_15335":33125,"_1612":33205},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_8073":261,"_22563":235,"_19084":33207,"_5":22713,"_15335":33125,"_1612":33208},[],"despliega el chart de Lamassu",{"_8073":262,"_22563":235,"_19084":33210,"_5":22713,"_15335":33125,"_1612":33211},[],"deja la UI expuesta en `https://<dominio>`",{"_8073":263,"_22563":235,"_19084":33213,"_5":22713,"_15335":33125,"_1612":33214},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_8073":264,"_22563":235,"_19084":33216,"_5":22713,"_15335":33129,"_1612":33217},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_8073":265,"_22563":235,"_19084":33219,"_5":22713,"_15335":33129,"_1612":33220},[],"`ui`",{"_8073":266,"_22563":235,"_19084":33222,"_5":22713,"_15335":33129,"_1612":32913},[],{"_8073":267,"_22563":235,"_19084":33224,"_5":22713,"_15335":33129,"_1612":32919},[],{"_8073":268,"_22563":235,"_19084":33226,"_5":22713,"_15335":33129,"_1612":32943},[],{"_8073":269,"_22563":235,"_19084":33228,"_5":22713,"_15335":33129,"_1612":33229},[],"`device-manager`",{"_8073":270,"_22563":235,"_19084":33231,"_5":22713,"_15335":33129,"_1612":33232},[],"`dms-manager`",{"_8073":271,"_22563":235,"_19084":33234,"_5":22713,"_15335":33129,"_1612":32907},[],{"_8073":272,"_22563":235,"_19084":33236,"_5":22713,"_15335":33129,"_1612":33237},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_8073":273,"_22563":235,"_19084":33239,"_5":22713,"_15335":33129,"_1612":33240},[],"job de migraciones de base de datos",{"_8073":274,"_22563":235,"_19084":33242,"_5":22713,"_15335":33133,"_1612":33243},[],"Clúster Kubernetes `1.19+`",{"_8073":275,"_22563":235,"_19084":33245,"_5":22713,"_15335":33133,"_1612":33246},[],"`kubectl` configurado con acceso al clúster",{"_8073":276,"_22563":235,"_19084":33248,"_5":22713,"_15335":33133,"_1612":33249},[],"Helm `3.2.0+`",{"_8073":277,"_22563":235,"_19084":33251,"_5":22713,"_15335":33133,"_1612":33252},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_8073":278,"_22563":235,"_19084":33254,"_5":22713,"_15335":33133,"_1612":33255},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_8073":279,"_22563":235,"_19084":33257,"_5":22713,"_15335":33133,"_1612":33258},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_8073":280,"_22563":235,"_19084":33260,"_5":22713,"_15335":33133,"_1612":33261},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_8073":281,"_22563":235,"_19084":33263,"_5":22713,"_15335":33137,"_1612":33264},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_8073":282,"_22563":235,"_19084":33266,"_5":22713,"_15335":33141,"_1612":33267},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_8073":283,"_22563":235,"_19084":33269,"_5":22713,"_15335":33145,"_1612":33270},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_8073":284,"_22563":235,"_19084":33272,"_5":22713,"_15335":33149,"_1612":33273},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_8073":285,"_22563":235,"_19084":33275,"_5":22713,"_15335":33149,"_1612":33276},[],"Dependencias externas requeridas por el chart principal:",{"_8073":286,"_22563":235,"_19084":33278,"_5":22713,"_15335":33149,"_1612":32611},[],{"_8073":287,"_22563":235,"_19084":33280,"_5":22713,"_15335":33149,"_1612":32617},[],{"_8073":288,"_22563":235,"_19084":33282,"_5":22713,"_15335":33149,"_1612":33283},[],"proveedor OIDC, típicamente Keycloak",{"_8073":289,"_22563":235,"_19084":33285,"_5":22713,"_15335":33149,"_1612":33286},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_8073":290,"_22563":235,"_19084":33288,"_5":22713,"_15335":33153,"_1612":33289},[],"Agregar el repositorio Helm:",{"_8073":291,"_22563":235,"_19084":33291,"_5":22713,"_15335":33153,"_1612":33292},[],"O instalar desde una copia local del repositorio:",{"_8073":292,"_22563":235,"_19084":33294,"_5":22713,"_15335":33157,"_1612":33295},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_8073":293,"_22563":235,"_19084":33297,"_5":22713,"_15335":33157,"_1612":33298},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_8073":294,"_22563":235,"_19084":33300,"_5":22713,"_15335":33157,"_1612":33301},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_8073":295,"_22563":235,"_19084":33303,"_5":22713,"_15335":33157,"_1612":33304},[],"`auth.oidc.frontend.authority`",{"_8073":296,"_22563":235,"_19084":33306,"_5":22713,"_15335":33157,"_1612":33307},[],"`auth.oidc.apiGateway.jwks`",{"_8073":297,"_22563":235,"_19084":33309,"_5":22713,"_15335":33157,"_1612":33310},[],"`services.ca.domains`",{"_8073":298,"_22563":235,"_19084":33312,"_5":22713,"_15335":33157,"_1612":33313},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_8073":299,"_22563":235,"_19084":33315,"_5":22713,"_15335":33157,"_1612":33316},[],"`tls.*` según se use `certManager` o certificado externo",{"_8073":300,"_22563":235,"_19084":33318,"_5":22713,"_15335":33157,"_1612":33319},[],"Ejemplo base:",{"_8073":301,"_22563":235,"_19084":33321,"_5":22713,"_15335":33161,"_1612":33322},[],"Área",{"_8073":302,"_22563":235,"_19084":33324,"_5":22713,"_15335":33161,"_1612":33325},[],"Valores clave",{"_8073":303,"_22563":235,"_19084":33327,"_5":22713,"_15335":33161,"_1612":33328},[],"Uso",{"_8073":304,"_22563":235,"_19084":33330,"_5":22713,"_15335":33161,"_1612":33331},[],"TLS",{"_8073":305,"_22563":235,"_19084":33333,"_5":22713,"_15335":33161,"_1612":33334},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_8073":306,"_22563":235,"_19084":33336,"_5":22713,"_15335":33161,"_1612":33337},[],"Certificado downstream del Gateway",{"_8073":307,"_22563":235,"_19084":33339,"_5":22713,"_15335":33161,"_1612":33340},[],"Gateway",{"_8073":308,"_22563":235,"_19084":33342,"_5":22713,"_15335":33161,"_1612":33343},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_8073":309,"_22563":235,"_19084":33345,"_5":22713,"_15335":33161,"_1612":33346},[],"Exposición de UI y APIs vía Envoy Gateway",{"_8073":310,"_22563":235,"_19084":33348,"_5":22713,"_15335":33161,"_1612":32896},[],{"_8073":311,"_22563":235,"_19084":33350,"_5":22713,"_15335":33161,"_1612":33351},[],"`postgres.*`",{"_8073":312,"_22563":235,"_19084":33353,"_5":22713,"_15335":33161,"_1612":33354},[],"Conexión a PostgreSQL externa",{"_8073":313,"_22563":235,"_19084":33356,"_5":22713,"_15335":33161,"_1612":33357},[],"Mensajería",{"_8073":314,"_22563":235,"_19084":33359,"_5":22713,"_15335":33161,"_1612":33360},[],"`amqp.*`",{"_8073":315,"_22563":235,"_19084":33362,"_5":22713,"_15335":33161,"_1612":33363},[],"Conexión a RabbitMQ",{"_8073":316,"_22563":235,"_19084":33365,"_5":22713,"_15335":33161,"_1612":33366},[],"OIDC",{"_8073":317,"_22563":235,"_19084":33368,"_5":22713,"_15335":33161,"_1612":33369},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_8073":318,"_22563":235,"_19084":33371,"_5":22713,"_15335":33161,"_1612":33372},[],"Login de UI y validación JWT en el Gateway",{"_8073":319,"_22563":235,"_19084":33374,"_5":22713,"_15335":33161,"_1612":32916},[],{"_8073":320,"_22563":235,"_19084":33376,"_5":22713,"_15335":33161,"_1612":33310},[],{"_8073":321,"_22563":235,"_19084":33378,"_5":22713,"_15335":33161,"_1612":33379},[],"Dominios autorizados para CA y certificados",{"_8073":322,"_22563":235,"_19084":33381,"_5":22713,"_15335":33161,"_1612":32946},[],{"_8073":323,"_22563":235,"_19084":33383,"_5":22713,"_15335":33161,"_1612":33384},[],"`services.kms.cryptoEngines.*`",{"_8073":324,"_22563":235,"_19084":33386,"_5":22713,"_15335":33161,"_1612":33387},[],"Motor criptográfico y almacenamiento de claves",{"_8073":325,"_22563":235,"_19084":33389,"_5":22713,"_15335":33161,"_1612":32910},[],{"_8073":326,"_22563":235,"_19084":33391,"_5":22713,"_15335":33161,"_1612":33392},[],"`services.alerts.smtp_server.*`",{"_8073":327,"_22563":235,"_19084":33394,"_5":22713,"_15335":33161,"_1612":33395},[],"Envío de correo para alertas",{"_8073":328,"_22563":235,"_19084":33397,"_5":22713,"_15335":33165,"_1612":33398},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_8073":329,"_22563":235,"_19084":33400,"_5":22713,"_15335":33165,"_1612":33401},[],"La prueba comprueba al menos:",{"_8073":330,"_22563":235,"_19084":33403,"_5":22713,"_15335":33165,"_1612":33404},[],"salud de `ca`",{"_8073":331,"_22563":235,"_19084":33406,"_5":22713,"_15335":33165,"_1612":33407},[],"salud de `dms-manager`",{"_8073":332,"_22563":235,"_19084":33409,"_5":22713,"_15335":33165,"_1612":33410},[],"salud de `device-manager`",{"_8073":333,"_22563":235,"_19084":33412,"_5":22713,"_15335":33165,"_1612":33413},[],"salud de `va`",{"_8073":334,"_22563":235,"_19084":33415,"_5":22713,"_15335":33165,"_1612":33416},[],"respuesta HTML esperada del servicio `ui`",{"_8073":335,"_22563":235,"_19084":33418,"_5":22713,"_15335":33169,"_1612":33419},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_8073":336,"_22563":235,"_19084":33421,"_5":22713,"_15335":33169,"_1612":33422},[],"`charts/lamassu`: chart principal de Lamassu",{"_8073":337,"_22563":235,"_19084":33424,"_5":22713,"_15335":33169,"_1612":33425},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_8073":338,"_22563":235,"_19084":33427,"_5":22713,"_15335":33169,"_1612":33428},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_8073":339,"_22563":235,"_19084":33430,"_5":22713,"_15335":33173,"_1612":33431},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_8073":340,"_22563":235,"_19084":33433,"_5":22713,"_15335":33177,"_1612":33434},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_8073":341,"_22563":341,"_5":22708,"_1612":33436,"_22721":33437,"_19084":33438,"_15335":341},"SaaS · Suscripción",[32429,32430,32488],[],{"_8073":342,"_22563":341,"_19084":33440,"_5":22713,"_15335":341,"_1612":33441},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_8073":343,"_22563":341,"_5":22718,"_19084":33443,"_15335":33444,"_1612":33445},[],"/docs/pr-preview/pr-25/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_8073":344,"_22563":341,"_5":22718,"_19084":33447,"_15335":33448,"_1612":33449},[],"/docs/pr-preview/pr-25/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_8073":345,"_22563":341,"_5":22718,"_19084":33451,"_15335":33452,"_1612":33453},[],"/docs/pr-preview/pr-25/despliegue/saas#planes-disponibles","Planes disponibles",{"_8073":346,"_22563":341,"_5":22718,"_19084":33455,"_15335":33456,"_1612":33457},[],"/docs/pr-preview/pr-25/despliegue/saas#contacto","Contacto",{"_8073":347,"_22563":341,"_19084":33459,"_5":22713,"_15335":33444,"_1612":33460},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_8073":348,"_22563":341,"_19084":33462,"_5":22713,"_15335":33448,"_1612":33463},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_8073":349,"_22563":341,"_19084":33465,"_5":22713,"_15335":33448,"_1612":33466},[],"Alta disponibilidad y backups automáticos",{"_8073":350,"_22563":341,"_19084":33468,"_5":22713,"_15335":33448,"_1612":33469},[],"Actualizaciones automáticas a las últimas versiones",{"_8073":351,"_22563":341,"_19084":33471,"_5":22713,"_15335":33448,"_1612":33472},[],"Soporte técnico incluido",{"_8073":352,"_22563":341,"_19084":33474,"_5":22713,"_15335":33448,"_1612":33475},[],"SLA garantizado",{"_8073":353,"_22563":341,"_19084":33477,"_5":22713,"_15335":33452,"_1612":33478},[],"Plan",{"_8073":354,"_22563":341,"_19084":33480,"_5":22713,"_15335":33452,"_1612":33481},[],"Dispositivos",{"_8073":355,"_22563":341,"_19084":33483,"_5":22713,"_15335":33452,"_1612":33484},[],"Soporte",{"_8073":356,"_22563":341,"_19084":33486,"_5":22713,"_15335":33452,"_1612":33487},[],"SLA",{"_8073":357,"_22563":341,"_19084":33489,"_5":22713,"_15335":33452,"_1612":33490},[],"Starter",{"_8073":358,"_22563":341,"_19084":33492,"_5":22713,"_15335":33452,"_1612":33493},[],"Hasta 1.000",{"_8073":359,"_22563":341,"_19084":33495,"_5":22713,"_15335":33452,"_1612":33496},[],"Email",{"_8073":360,"_22563":341,"_19084":33498,"_5":22713,"_15335":33452,"_1612":33499},[],"99,5%",{"_8073":361,"_22563":341,"_19084":33501,"_5":22713,"_15335":33452,"_1612":33502},[],"Professional",{"_8073":362,"_22563":341,"_19084":33504,"_5":22713,"_15335":33452,"_1612":33505},[],"Hasta 10.000",{"_8073":363,"_22563":341,"_19084":33507,"_5":22713,"_15335":33452,"_1612":33508},[],"Email + Chat",{"_8073":364,"_22563":341,"_19084":33510,"_5":22713,"_15335":33452,"_1612":33511},[],"99,9%",{"_8073":365,"_22563":341,"_19084":33513,"_5":22713,"_15335":33452,"_1612":33514},[],"Enterprise",{"_8073":366,"_22563":341,"_19084":33516,"_5":22713,"_15335":33452,"_1612":33517},[],"Ilimitado",{"_8073":367,"_22563":341,"_19084":33519,"_5":22713,"_15335":33452,"_1612":33520},[],"Dedicado",{"_8073":368,"_22563":341,"_19084":33522,"_5":22713,"_15335":33452,"_1612":33523},[],"99,99%",{"_8073":369,"_22563":341,"_19084":33525,"_5":22713,"_15335":33456,"_1612":33526},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_8073":370,"_22563":370,"_5":22708,"_1612":33528,"_22721":33529,"_19084":33530,"_15335":370},"Manual de Usuario",[32429,33528],[],{"_8073":371,"_22563":370,"_19084":33532,"_5":22713,"_15335":370,"_1612":33533},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_8073":372,"_22563":370,"_5":22718,"_19084":33535,"_15335":33536,"_1612":33537},[],"/docs/pr-preview/pr-25/manual#servicios-core","Servicios Core",{"_8073":373,"_22563":370,"_5":22718,"_19084":33539,"_15335":33540,"_1612":33541},[],"/docs/pr-preview/pr-25/manual#integraciones-con-terceros","Integraciones con terceros",{"_8073":374,"_22563":370,"_19084":33543,"_5":22713,"_15335":370,"_1612":33544},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_8073":375,"_22563":370,"_19084":33546,"_5":22713,"_15335":33536,"_1612":33547},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_8073":376,"_22563":370,"_19084":33549,"_5":22713,"_15335":33536,"_1612":33550},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_8073":377,"_22563":370,"_19084":33552,"_5":22713,"_15335":33536,"_1612":33553},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_8073":378,"_22563":370,"_19084":33555,"_5":22713,"_15335":33536,"_1612":33556},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_8073":379,"_22563":370,"_19084":33558,"_5":22713,"_15335":33536,"_1612":33559},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_8073":380,"_22563":370,"_19084":33561,"_5":22713,"_15335":33536,"_1612":33562},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_8073":381,"_22563":370,"_19084":33564,"_5":22713,"_15335":33536,"_1612":33565},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_8073":382,"_22563":370,"_19084":33567,"_5":22713,"_15335":33540,"_1612":33568},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_8073":383,"_22563":383,"_5":22708,"_1612":33570,"_22721":33571,"_19084":33572,"_15335":383},"Integración con AWS IoT Core",[32429,33528,33541],[],{"_8073":384,"_22563":383,"_19084":33574,"_5":22713,"_15335":383,"_1612":33575},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_8073":385,"_22563":383,"_5":22718,"_19084":33577,"_15335":33578,"_1612":33579},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_8073":386,"_22563":383,"_5":22718,"_19084":33581,"_15335":33582,"_1612":33583},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_8073":387,"_22563":383,"_5":22718,"_19084":33585,"_15335":33586,"_1612":33587},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_8073":388,"_22563":383,"_5":22718,"_19084":33589,"_15335":33590,"_1612":33591},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_8073":389,"_22563":383,"_5":22718,"_19084":33593,"_15335":33594,"_1612":33595},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_8073":390,"_22563":383,"_5":22718,"_19084":33597,"_15335":33598,"_1612":33599},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_8073":391,"_22563":383,"_5":22718,"_19084":33601,"_15335":33602,"_1612":33603},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#primary-account","Primary Account",{"_8073":392,"_22563":383,"_5":22718,"_19084":33605,"_15335":33606,"_1612":33607},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_8073":393,"_22563":383,"_5":22718,"_19084":33609,"_15335":33610,"_1612":33611},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_8073":394,"_22563":383,"_5":22718,"_19084":33613,"_15335":33614,"_1612":33615},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-none","Modo `none`",{"_8073":395,"_22563":383,"_5":22718,"_19084":33617,"_15335":33618,"_1612":33619},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-auto","Modo `auto`",{"_8073":396,"_22563":383,"_5":22718,"_19084":33621,"_15335":33622,"_1612":33623},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_8073":397,"_22563":383,"_5":22718,"_19084":33625,"_15335":33626,"_1612":33627},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_8073":398,"_22563":383,"_5":22718,"_19084":33629,"_15335":33630,"_1612":33631},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_8073":399,"_22563":383,"_5":22718,"_19084":33633,"_15335":33634,"_1612":33635},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_8073":400,"_22563":383,"_5":22718,"_19084":33637,"_15335":33638,"_1612":33639},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_8073":401,"_22563":383,"_5":22718,"_19084":33641,"_15335":33642,"_1612":33643},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_8073":402,"_22563":383,"_5":22718,"_19084":33645,"_15335":33646,"_1612":33647},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_8073":403,"_22563":383,"_5":22718,"_19084":33649,"_15335":33650,"_1612":33651},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_8073":404,"_22563":383,"_5":22718,"_19084":33653,"_15335":33654,"_1612":33655},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_8073":405,"_22563":383,"_19084":33657,"_5":22713,"_15335":383,"_1612":33658},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_8073":406,"_22563":383,"_19084":33660,"_5":22713,"_15335":383,"_1612":33661},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_8073":407,"_22563":383,"_19084":33663,"_5":22713,"_15335":383,"_1612":33664},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_8073":408,"_22563":383,"_19084":33666,"_5":22713,"_15335":33578,"_1612":33667},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_8073":409,"_22563":383,"_19084":33669,"_5":22713,"_15335":33578,"_1612":33670},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_8073":410,"_22563":383,"_19084":33672,"_5":22713,"_15335":33578,"_1612":33673},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_8073":411,"_22563":383,"_19084":33675,"_5":22713,"_15335":33578,"_1612":33676},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_8073":412,"_22563":383,"_19084":33678,"_5":22713,"_15335":33582,"_1612":33679},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_8073":413,"_22563":383,"_19084":33681,"_5":22713,"_15335":33586,"_1612":33682},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_8073":414,"_22563":383,"_19084":33684,"_5":22713,"_15335":33586,"_1612":33685},[],"Acción IAM",{"_8073":415,"_22563":383,"_19084":33687,"_5":22713,"_15335":33586,"_1612":33688},[],"Propósito",{"_8073":416,"_22563":383,"_19084":33690,"_5":22713,"_15335":33586,"_1612":33691},[],"`iot:GetRegistrationCode`",{"_8073":417,"_22563":383,"_19084":33693,"_5":22713,"_15335":33586,"_1612":33694},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_8073":418,"_22563":383,"_19084":33696,"_5":22713,"_15335":33586,"_1612":33697},[],"`iot:RegisterCACertificate`",{"_8073":419,"_22563":383,"_19084":33699,"_5":22713,"_15335":33586,"_1612":33700},[],"Registrar la CA en AWS IoT",{"_8073":420,"_22563":383,"_19084":33702,"_5":22713,"_15335":33586,"_1612":33703},[],"`iot:DescribeCACertificate`",{"_8073":421,"_22563":383,"_19084":33705,"_5":22713,"_15335":33586,"_1612":33706},[],"Consultar el estado del registro de la CA",{"_8073":422,"_22563":383,"_19084":33708,"_5":22713,"_15335":33586,"_1612":33709},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_8073":423,"_22563":383,"_19084":33711,"_5":22713,"_15335":33586,"_1612":33712},[],"Crear o actualizar Things en IoT Core",{"_8073":424,"_22563":383,"_19084":33714,"_5":22713,"_15335":33586,"_1612":33715},[],"`iot:RegisterThing`",{"_8073":425,"_22563":383,"_19084":33717,"_5":22713,"_15335":33586,"_1612":33718},[],"Aprovisionar Things mediante plantilla",{"_8073":426,"_22563":383,"_19084":33720,"_5":22713,"_15335":33586,"_1612":33721},[],"`iot:RegisterCertificate`",{"_8073":427,"_22563":383,"_19084":33723,"_5":22713,"_15335":33586,"_1612":33724},[],"Registrar certificados de dispositivo",{"_8073":428,"_22563":383,"_19084":33726,"_5":22713,"_15335":33586,"_1612":33727},[],"`iot:UpdateCertificate`",{"_8073":429,"_22563":383,"_19084":33729,"_5":22713,"_15335":33586,"_1612":33730},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_8073":430,"_22563":383,"_19084":33732,"_5":22713,"_15335":33586,"_1612":33733},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_8073":431,"_22563":383,"_19084":33735,"_5":22713,"_15335":33586,"_1612":33736},[],"Crear y adjuntar políticas IoT",{"_8073":432,"_22563":383,"_19084":33738,"_5":22713,"_15335":33586,"_1612":33739},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_8073":433,"_22563":383,"_19084":33741,"_5":22713,"_15335":33586,"_1612":33742},[],"Gestionar grupos de Things",{"_8073":434,"_22563":383,"_19084":33744,"_5":22713,"_15335":33586,"_1612":33745},[],"`iot:CreateProvisioningTemplate`",{"_8073":435,"_22563":383,"_19084":33747,"_5":22713,"_15335":33586,"_1612":33748},[],"Crear plantillas JITP",{"_8073":436,"_22563":383,"_19084":33750,"_5":22713,"_15335":33586,"_1612":33751},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_8073":437,"_22563":383,"_19084":33753,"_5":22713,"_15335":33586,"_1612":33754},[],"Leer y escribir el Device Shadow",{"_8073":438,"_22563":383,"_19084":33756,"_5":22713,"_15335":33586,"_1612":33757},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_8073":439,"_22563":383,"_19084":33759,"_5":22713,"_15335":33590,"_1612":33760},[],"Parámetro",{"_8073":440,"_22563":383,"_19084":33762,"_5":22713,"_15335":33590,"_1612":33763},[],"Tipo",{"_8073":441,"_22563":383,"_19084":33765,"_5":22713,"_15335":33590,"_1612":33766},[],"Requerido",{"_8073":442,"_22563":383,"_19084":33768,"_5":22713,"_15335":33590,"_1612":32632},[],{"_8073":443,"_22563":383,"_19084":33770,"_5":22713,"_15335":33590,"_1612":33771},[],"`connector_id`",{"_8073":444,"_22563":383,"_19084":33773,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":445,"_22563":383,"_19084":33775,"_5":22713,"_15335":33590,"_1612":33776},[],"Sí",{"_8073":446,"_22563":383,"_19084":33778,"_5":22713,"_15335":33590,"_1612":33779},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_8073":447,"_22563":383,"_19084":33781,"_5":22713,"_15335":33590,"_1612":33782},[],"`aws_config.region`",{"_8073":448,"_22563":383,"_19084":33784,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":449,"_22563":383,"_19084":33786,"_5":22713,"_15335":33590,"_1612":33776},[],{"_8073":450,"_22563":383,"_19084":33788,"_5":22713,"_15335":33590,"_1612":33789},[],"Región AWS donde opera el conector.",{"_8073":451,"_22563":383,"_19084":33791,"_5":22713,"_15335":33590,"_1612":33792},[],"`aws_config.auth_method`",{"_8073":452,"_22563":383,"_19084":33794,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":453,"_22563":383,"_19084":33796,"_5":22713,"_15335":33590,"_1612":33776},[],{"_8073":454,"_22563":383,"_19084":33798,"_5":22713,"_15335":33590,"_1612":33799},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_8073":455,"_22563":383,"_19084":33801,"_5":22713,"_15335":33590,"_1612":33802},[],"`aws_config.access_key_id`",{"_8073":456,"_22563":383,"_19084":33804,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":457,"_22563":383,"_19084":33806,"_5":22713,"_15335":33590,"_1612":33807},[],"Solo con `auth_method=static`",{"_8073":458,"_22563":383,"_19084":33809,"_5":22713,"_15335":33590,"_1612":33810},[],"Clave de acceso AWS.",{"_8073":459,"_22563":383,"_19084":33812,"_5":22713,"_15335":33590,"_1612":33813},[],"`aws_config.secret_access_key`",{"_8073":460,"_22563":383,"_19084":33815,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":461,"_22563":383,"_19084":33817,"_5":22713,"_15335":33590,"_1612":33807},[],{"_8073":462,"_22563":383,"_19084":33819,"_5":22713,"_15335":33590,"_1612":33820},[],"Clave secreta AWS.",{"_8073":463,"_22563":383,"_19084":33822,"_5":22713,"_15335":33590,"_1612":33823},[],"`aws_config.session_token`",{"_8073":464,"_22563":383,"_19084":33825,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":465,"_22563":383,"_19084":33827,"_5":22713,"_15335":33590,"_1612":33828},[],"No",{"_8073":466,"_22563":383,"_19084":33830,"_5":22713,"_15335":33590,"_1612":33831},[],"Token de sesión (con `auth_method=static`).",{"_8073":467,"_22563":383,"_19084":33833,"_5":22713,"_15335":33590,"_1612":33834},[],"`aws_config.role_arn`",{"_8073":468,"_22563":383,"_19084":33836,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":469,"_22563":383,"_19084":33838,"_5":22713,"_15335":33590,"_1612":33839},[],"Solo con `auth_method=role`",{"_8073":470,"_22563":383,"_19084":33841,"_5":22713,"_15335":33590,"_1612":33842},[],"ARN del rol a asumir.",{"_8073":471,"_22563":383,"_19084":33844,"_5":22713,"_15335":33590,"_1612":33845},[],"`aws_config.endpoint_url`",{"_8073":472,"_22563":383,"_19084":33847,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":473,"_22563":383,"_19084":33849,"_5":22713,"_15335":33590,"_1612":33828},[],{"_8073":474,"_22563":383,"_19084":33851,"_5":22713,"_15335":33590,"_1612":33852},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_8073":475,"_22563":383,"_19084":33854,"_5":22713,"_15335":33590,"_1612":33855},[],"`subscriber_event_bus`",{"_8073":476,"_22563":383,"_19084":33857,"_5":22713,"_15335":33590,"_1612":19390},[],{"_8073":477,"_22563":383,"_19084":33859,"_5":22713,"_15335":33590,"_1612":33776},[],{"_8073":478,"_22563":383,"_19084":33861,"_5":22713,"_15335":33590,"_1612":33862},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_8073":479,"_22563":383,"_19084":33864,"_5":22713,"_15335":33590,"_1612":33865},[],"`dms_manager_client`",{"_8073":480,"_22563":383,"_19084":33867,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":481,"_22563":383,"_19084":33869,"_5":22713,"_15335":33590,"_1612":33776},[],{"_8073":482,"_22563":383,"_19084":33871,"_5":22713,"_15335":33590,"_1612":33872},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_8073":483,"_22563":383,"_19084":33874,"_5":22713,"_15335":33590,"_1612":33875},[],"`device_manager_client`",{"_8073":484,"_22563":383,"_19084":33877,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":485,"_22563":383,"_19084":33879,"_5":22713,"_15335":33590,"_1612":33776},[],{"_8073":486,"_22563":383,"_19084":33881,"_5":22713,"_15335":33590,"_1612":33882},[],"URL HTTP del Device Manager de Lamassu.",{"_8073":487,"_22563":383,"_19084":33884,"_5":22713,"_15335":33590,"_1612":33885},[],"`ca_client`",{"_8073":488,"_22563":383,"_19084":33887,"_5":22713,"_15335":33590,"_1612":11737},[],{"_8073":489,"_22563":383,"_19084":33889,"_5":22713,"_15335":33590,"_1612":33776},[],{"_8073":490,"_22563":383,"_19084":33891,"_5":22713,"_15335":33590,"_1612":33892},[],"URL HTTP del servicio de CA de Lamassu.",{"_8073":491,"_22563":383,"_19084":33894,"_5":22713,"_15335":33594,"_1612":33895},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_8073":492,"_22563":383,"_19084":33897,"_5":22713,"_15335":33598,"_1612":33898},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_8073":493,"_22563":383,"_19084":33900,"_5":22713,"_15335":33598,"_1612":33901},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_8073":494,"_22563":383,"_19084":33903,"_5":22713,"_15335":33602,"_1612":33904},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_8073":495,"_22563":383,"_19084":33906,"_5":22713,"_15335":33602,"_1612":33907},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_8073":496,"_22563":383,"_19084":33909,"_5":22713,"_15335":33602,"_1612":33910},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_8073":497,"_22563":383,"_19084":33912,"_5":22713,"_15335":33602,"_1612":33913},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_8073":498,"_22563":383,"_19084":33915,"_5":22713,"_15335":33602,"_1612":33916},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_8073":499,"_22563":383,"_19084":33918,"_5":22713,"_15335":33602,"_1612":33919},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_8073":500,"_22563":383,"_19084":33921,"_5":22713,"_15335":33606,"_1612":33922},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_8073":501,"_22563":383,"_19084":33924,"_5":22713,"_15335":33610,"_1612":33925},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_8073":502,"_22563":383,"_19084":33927,"_5":22713,"_15335":33610,"_1612":33928},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_8073":503,"_22563":383,"_19084":33930,"_5":22713,"_15335":33614,"_1612":33931},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_8073":504,"_22563":383,"_19084":33933,"_5":22713,"_15335":33618,"_1612":33934},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_8073":505,"_22563":383,"_19084":33936,"_5":22713,"_15335":33618,"_1612":33937},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_8073":506,"_22563":383,"_19084":33939,"_5":22713,"_15335":33618,"_1612":33940},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_8073":507,"_22563":383,"_19084":33942,"_5":22713,"_15335":33618,"_1612":33943},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_8073":508,"_22563":383,"_19084":33945,"_5":22713,"_15335":33618,"_1612":33946},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_8073":509,"_22563":383,"_19084":33948,"_5":22713,"_15335":33618,"_1612":33949},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_8073":510,"_22563":383,"_19084":33951,"_5":22713,"_15335":33622,"_1612":33952},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_8073":511,"_22563":383,"_19084":33954,"_5":22713,"_15335":33622,"_1612":33955},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_8073":512,"_22563":383,"_19084":33957,"_5":22713,"_15335":33622,"_1612":33958},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_8073":513,"_22563":383,"_19084":33960,"_5":22713,"_15335":33626,"_1612":33961},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_8073":514,"_22563":383,"_19084":33963,"_5":22713,"_15335":33626,"_1612":33964},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_8073":515,"_22563":383,"_19084":33966,"_5":22713,"_15335":33626,"_1612":33967},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_8073":516,"_22563":383,"_19084":33969,"_5":22713,"_15335":33630,"_1612":33970},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_8073":517,"_22563":383,"_19084":33972,"_5":22713,"_15335":33630,"_1612":33973},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_8073":518,"_22563":383,"_19084":33975,"_5":22713,"_15335":33630,"_1612":33976},[],"Para que el flujo JITP funcione correctamente:",{"_8073":519,"_22563":383,"_19084":33978,"_5":22713,"_15335":33630,"_1612":33979},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_8073":520,"_22563":383,"_19084":33981,"_5":22713,"_15335":33630,"_1612":33982},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_8073":521,"_22563":383,"_19084":33984,"_5":22713,"_15335":33630,"_1612":33985},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_8073":522,"_22563":383,"_19084":33987,"_5":22713,"_15335":33630,"_1612":33988},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_8073":523,"_22563":383,"_19084":33990,"_5":22713,"_15335":33634,"_1612":33991},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_8073":524,"_22563":383,"_19084":33993,"_5":22713,"_15335":33634,"_1612":33994},[],"Estado en Lamassu",{"_8073":525,"_22563":383,"_19084":33996,"_5":22713,"_15335":33634,"_1612":33997},[],"Razón de revocación",{"_8073":526,"_22563":383,"_19084":33999,"_5":22713,"_15335":33634,"_1612":34000},[],"Estado en AWS IoT Core",{"_8073":527,"_22563":383,"_19084":34002,"_5":22713,"_15335":33634,"_1612":34003},[],"`Active`",{"_8073":528,"_22563":383,"_19084":34005,"_5":22713,"_15335":33634,"_1612":34006},[],"—",{"_8073":529,"_22563":383,"_19084":34008,"_5":22713,"_15335":33634,"_1612":34009},[],"`ACTIVE`",{"_8073":530,"_22563":383,"_19084":34011,"_5":22713,"_15335":33634,"_1612":34012},[],"`Revoked`",{"_8073":531,"_22563":383,"_19084":34014,"_5":22713,"_15335":33634,"_1612":34015},[],"`certificateHold`",{"_8073":532,"_22563":383,"_19084":34017,"_5":22713,"_15335":33634,"_1612":34018},[],"`INACTIVE`",{"_8073":533,"_22563":383,"_19084":34020,"_5":22713,"_15335":33634,"_1612":34012},[],{"_8073":534,"_22563":383,"_19084":34022,"_5":22713,"_15335":33634,"_1612":34023},[],"Cualquier otra razón",{"_8073":535,"_22563":383,"_19084":34025,"_5":22713,"_15335":33634,"_1612":34026},[],"`REVOKED`",{"_8073":536,"_22563":383,"_19084":34028,"_5":22713,"_15335":33634,"_1612":34029},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_8073":537,"_22563":383,"_19084":34031,"_5":22713,"_15335":33638,"_1612":34032},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_8073":538,"_22563":383,"_19084":34034,"_5":22713,"_15335":33638,"_1612":34035},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_8073":539,"_22563":383,"_19084":34037,"_5":22713,"_15335":33638,"_1612":34038},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_8073":540,"_22563":383,"_19084":34040,"_5":22713,"_15335":33642,"_1612":34041},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_8073":541,"_22563":383,"_19084":34043,"_5":22713,"_15335":33642,"_1612":34044},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_8073":542,"_22563":383,"_19084":34046,"_5":22713,"_15335":33646,"_1612":34047},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_8073":543,"_22563":383,"_19084":34049,"_5":22713,"_15335":33646,"_1612":34050},[],"Existen dos tipos de acciones:",{"_8073":544,"_22563":383,"_19084":34052,"_5":22713,"_15335":33646,"_1612":34053},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_8073":545,"_22563":383,"_19084":34055,"_5":22713,"_15335":33646,"_1612":34056},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_8073":546,"_22563":383,"_19084":34058,"_5":22713,"_15335":33646,"_1612":34059},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_8073":547,"_22563":383,"_19084":34061,"_5":22713,"_15335":33650,"_1612":34062},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_8073":548,"_22563":383,"_19084":34064,"_5":22713,"_15335":33650,"_1612":34065},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_8073":549,"_22563":383,"_19084":34067,"_5":22713,"_15335":33650,"_1612":34068},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_8073":550,"_22563":383,"_19084":34070,"_5":22713,"_15335":33654,"_1612":34071},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_8073":551,"_22563":383,"_19084":34073,"_5":22713,"_15335":33654,"_1612":34074},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_8073":552,"_22563":383,"_19084":34076,"_5":22713,"_15335":33654,"_1612":34077},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_8073":553,"_22563":383,"_19084":34079,"_5":22713,"_15335":33654,"_1612":34080},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_8073":554,"_22563":383,"_19084":34082,"_5":22713,"_15335":33654,"_1612":34083},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_8073":555,"_22563":383,"_19084":34085,"_5":22713,"_15335":33654,"_1612":34086},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_8073":556,"_22563":383,"_19084":34088,"_5":22713,"_15335":33654,"_1612":34089},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_8073":557,"_22563":383,"_19084":34091,"_5":22713,"_15335":33654,"_1612":34092},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_8073":558,"_22563":383,"_19084":34094,"_5":22713,"_15335":33654,"_1612":34095},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_8073":559,"_22563":383,"_19084":34097,"_5":22713,"_15335":33654,"_1612":34098},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_8073":560,"_22563":383,"_19084":34100,"_5":22713,"_15335":33654,"_1612":34101},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_8073":561,"_22563":383,"_19084":34103,"_5":22713,"_15335":33654,"_1612":34104},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_8073":562,"_22563":383,"_19084":34106,"_5":22713,"_15335":33654,"_1612":34107},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_8073":563,"_22563":383,"_19084":34109,"_5":22713,"_15335":33654,"_1612":34110},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_8073":564,"_22563":383,"_19084":34112,"_5":22713,"_15335":33654,"_1612":34113},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_8073":565,"_22563":383,"_19084":34115,"_5":22713,"_15335":33654,"_1612":34116},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_8073":566,"_22563":383,"_19084":34118,"_5":22713,"_15335":33654,"_1612":34119},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_8073":567,"_22563":383,"_19084":34121,"_5":22713,"_15335":33654,"_1612":34122},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_8073":568,"_22563":383,"_19084":34124,"_5":22713,"_15335":33654,"_1612":34125},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_8073":569,"_22563":383,"_19084":34127,"_5":22713,"_15335":33654,"_1612":34128},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_8073":570,"_22563":383,"_19084":34130,"_5":22713,"_15335":33654,"_1612":34131},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_8073":571,"_22563":571,"_5":22708,"_1612":34133,"_22721":34134,"_19084":34135,"_15335":571},"[Alerts] Alertas y Suscripciones",[32429,33528,33537],[],{"_8073":572,"_22563":571,"_19084":34137,"_5":22713,"_15335":571,"_1612":34138},[],"Monitorización proactiva mediante eventos y suscripciones",{"_8073":573,"_22563":571,"_5":22718,"_19084":34140,"_15335":34141,"_1612":34142},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#alertas","Alertas",{"_8073":574,"_22563":571,"_5":22718,"_19084":34144,"_15335":34145,"_1612":34146},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_8073":575,"_22563":571,"_5":22718,"_19084":34148,"_15335":34149,"_1612":34150},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_8073":576,"_22563":571,"_5":22718,"_19084":34152,"_15335":34153,"_1612":34154},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_8073":577,"_22563":571,"_5":22718,"_19084":34156,"_15335":34157,"_1612":34158},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_8073":578,"_22563":571,"_5":22718,"_19084":34160,"_15335":34161,"_1612":34162},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_8073":579,"_22563":571,"_5":22718,"_19084":34164,"_15335":34165,"_1612":34166},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_8073":580,"_22563":571,"_19084":34168,"_5":22713,"_15335":34141,"_1612":34169},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_8073":581,"_22563":571,"_19084":34171,"_5":22713,"_15335":34145,"_1612":34172},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_8073":582,"_22563":571,"_19084":34174,"_5":22713,"_15335":34145,"_1612":34175},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_8073":583,"_22563":571,"_19084":34177,"_5":22713,"_15335":34145,"_1612":34178},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_8073":584,"_22563":571,"_19084":34180,"_5":22713,"_15335":34145,"_1612":34181},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_8073":585,"_22563":571,"_19084":34183,"_5":22713,"_15335":34145,"_1612":34184},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_8073":586,"_22563":571,"_19084":34186,"_5":22713,"_15335":34145,"_1612":34187},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_8073":587,"_22563":571,"_19084":34189,"_5":22713,"_15335":34149,"_1612":34190},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_8073":588,"_22563":571,"_19084":34192,"_5":22713,"_15335":34149,"_1612":34193},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_8073":589,"_22563":571,"_19084":34195,"_5":22713,"_15335":34149,"_1612":34196},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_8073":590,"_22563":571,"_19084":34198,"_5":22713,"_15335":34149,"_1612":34199},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_8073":591,"_22563":571,"_19084":34201,"_5":22713,"_15335":34149,"_1612":34202},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_8073":592,"_22563":571,"_19084":34204,"_5":22713,"_15335":34153,"_1612":34205},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_8073":593,"_22563":571,"_19084":34207,"_5":22713,"_15335":34153,"_1612":34208},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_8073":594,"_22563":571,"_19084":34210,"_5":22713,"_15335":34153,"_1612":34211},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_8073":595,"_22563":571,"_19084":34213,"_5":22713,"_15335":34153,"_1612":34214},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_8073":596,"_22563":571,"_19084":34216,"_5":22713,"_15335":34153,"_1612":34217},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_8073":597,"_22563":571,"_19084":34219,"_5":22713,"_15335":34157,"_1612":34220},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_8073":598,"_22563":571,"_19084":34222,"_5":22713,"_15335":34157,"_1612":34223},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_8073":599,"_22563":571,"_19084":34225,"_5":22713,"_15335":34161,"_1612":34226},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_8073":600,"_22563":571,"_19084":34228,"_5":22713,"_15335":34161,"_1612":34229},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_8073":601,"_22563":571,"_19084":34231,"_5":22713,"_15335":34161,"_1612":34232},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_8073":602,"_22563":571,"_19084":34234,"_5":22713,"_15335":34161,"_1612":34235},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_8073":603,"_22563":571,"_19084":34237,"_5":22713,"_15335":34165,"_1612":34238},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_8073":604,"_22563":571,"_19084":34240,"_5":22713,"_15335":34165,"_1612":34241},[],"Evento",{"_8073":605,"_22563":571,"_19084":34243,"_5":22713,"_15335":34165,"_1612":32632},[],{"_8073":606,"_22563":571,"_19084":34245,"_5":22713,"_15335":34165,"_1612":34246},[],"**ca.create**",{"_8073":607,"_22563":571,"_19084":34248,"_5":22713,"_15335":34165,"_1612":34249},[],"Creación de una CA",{"_8073":608,"_22563":571,"_19084":34251,"_5":22713,"_15335":34165,"_1612":34252},[],"**ca.import**",{"_8073":609,"_22563":571,"_19084":34254,"_5":22713,"_15335":34165,"_1612":34255},[],"Importación de una CA",{"_8073":610,"_22563":571,"_19084":34257,"_5":22713,"_15335":34165,"_1612":34258},[],"**ca.profile.update**",{"_8073":611,"_22563":571,"_19084":34260,"_5":22713,"_15335":34165,"_1612":34261},[],"Actualización de perfil de CA",{"_8073":612,"_22563":571,"_19084":34263,"_5":22713,"_15335":34165,"_1612":34264},[],"**ca.reissue**",{"_8073":613,"_22563":571,"_19084":34266,"_5":22713,"_15335":34165,"_1612":34267},[],"Reemisión de una CA",{"_8073":614,"_22563":571,"_19084":34269,"_5":22713,"_15335":34165,"_1612":34270},[],"**ca.sign.certificate**",{"_8073":615,"_22563":571,"_19084":34272,"_5":22713,"_15335":34165,"_1612":34273},[],"Firma / emisión de certificado",{"_8073":616,"_22563":571,"_19084":34275,"_5":22713,"_15335":34165,"_1612":34276},[],"**ca.signature.sign**",{"_8073":617,"_22563":571,"_19084":34278,"_5":22713,"_15335":34165,"_1612":34279},[],"Operación de firma criptográfica",{"_8073":618,"_22563":571,"_19084":34281,"_5":22713,"_15335":34165,"_1612":34282},[],"**ca.delete**",{"_8073":619,"_22563":571,"_19084":34284,"_5":22713,"_15335":34165,"_1612":34285},[],"Eliminación de una CA",{"_8073":620,"_22563":571,"_19084":34287,"_5":22713,"_15335":34165,"_1612":34288},[],"**certificate.delete**",{"_8073":621,"_22563":571,"_19084":34290,"_5":22713,"_15335":34165,"_1612":34291},[],"Eliminación de un certificado",{"_8073":622,"_22563":571,"_19084":34293,"_5":22713,"_15335":34165,"_1612":34294},[],"**profile.create**",{"_8073":623,"_22563":571,"_19084":34296,"_5":22713,"_15335":34165,"_1612":34297},[],"Creación de perfil de emisión",{"_8073":624,"_22563":571,"_19084":34299,"_5":22713,"_15335":34165,"_1612":34300},[],"**profile.update**",{"_8073":625,"_22563":571,"_19084":34302,"_5":22713,"_15335":34165,"_1612":34303},[],"Actualización de perfil de emisión",{"_8073":626,"_22563":571,"_19084":34305,"_5":22713,"_15335":34165,"_1612":34306},[],"**profile.delete**",{"_8073":627,"_22563":571,"_19084":34308,"_5":22713,"_15335":34165,"_1612":34309},[],"Eliminación de perfil de emisión",{"_8073":628,"_22563":571,"_19084":34311,"_5":22713,"_15335":34165,"_1612":34312},[],"**dms.create**",{"_8073":629,"_22563":571,"_19084":34314,"_5":22713,"_15335":34165,"_1612":34315},[],"Creación de un DMS",{"_8073":630,"_22563":571,"_19084":34317,"_5":22713,"_15335":34165,"_1612":34318},[],"**dms.update**",{"_8073":631,"_22563":571,"_19084":34320,"_5":22713,"_15335":34165,"_1612":34321},[],"Actualización de un DMS",{"_8073":632,"_22563":571,"_19084":34323,"_5":22713,"_15335":34165,"_1612":34324},[],"**dms.delete**",{"_8073":633,"_22563":571,"_19084":34326,"_5":22713,"_15335":34165,"_1612":34327},[],"Eliminación de un DMS",{"_8073":634,"_22563":571,"_19084":34329,"_5":22713,"_15335":34165,"_1612":34330},[],"**dms.enroll**",{"_8073":635,"_22563":571,"_19084":34332,"_5":22713,"_15335":34165,"_1612":34333},[],"Inscripción (enroll) de dispositivo",{"_8073":636,"_22563":571,"_19084":34335,"_5":22713,"_15335":34165,"_1612":34336},[],"**dms.reenroll**",{"_8073":637,"_22563":571,"_19084":34338,"_5":22713,"_15335":34165,"_1612":34339},[],"Re-inscripción (reenroll) de dispositivo",{"_8073":638,"_22563":571,"_19084":34341,"_5":22713,"_15335":34165,"_1612":34342},[],"**dms.bind-device-id**",{"_8073":639,"_22563":571,"_19084":34344,"_5":22713,"_15335":34165,"_1612":34345},[],"Asociación de identidad a dispositivo",{"_8073":640,"_22563":571,"_19084":34347,"_5":22713,"_15335":34165,"_1612":34348},[],"**device.create**",{"_8073":641,"_22563":571,"_19084":34350,"_5":22713,"_15335":34165,"_1612":34351},[],"Creación de dispositivo",{"_8073":642,"_22563":571,"_19084":34353,"_5":22713,"_15335":34165,"_1612":34354},[],"**device.identity.update**",{"_8073":643,"_22563":571,"_19084":34356,"_5":22713,"_15335":34165,"_1612":34357},[],"Actualización de identidad del dispositivo",{"_8073":644,"_22563":571,"_19084":34359,"_5":22713,"_15335":34165,"_1612":34360},[],"**device.status.update**",{"_8073":645,"_22563":571,"_19084":34362,"_5":22713,"_15335":34165,"_1612":34363},[],"Cambio de estado del dispositivo",{"_8073":646,"_22563":571,"_19084":34365,"_5":22713,"_15335":34165,"_1612":34366},[],"**device.metadata.update**",{"_8073":647,"_22563":571,"_19084":34368,"_5":22713,"_15335":34165,"_1612":34369},[],"Actualización de metadatos del dispositivo",{"_8073":648,"_22563":571,"_19084":34371,"_5":22713,"_15335":34165,"_1612":34372},[],"**device.delete**",{"_8073":649,"_22563":571,"_19084":34374,"_5":22713,"_15335":34165,"_1612":34375},[],"Eliminación de un dispositivo",{"_8073":650,"_22563":571,"_19084":34377,"_5":22713,"_15335":34165,"_1612":34378},[],"**va.role.crl.create**",{"_8073":651,"_22563":571,"_19084":34380,"_5":22713,"_15335":34165,"_1612":34381},[],"Cálculo/creación de CRL",{"_8073":652,"_22563":571,"_19084":34383,"_5":22713,"_15335":34165,"_1612":34384},[],"**kms.create**",{"_8073":653,"_22563":571,"_19084":34386,"_5":22713,"_15335":34165,"_1612":34387},[],"Creación de clave en KMS",{"_8073":654,"_22563":571,"_19084":34389,"_5":22713,"_15335":34165,"_1612":34390},[],"**kms.import**",{"_8073":655,"_22563":571,"_19084":34392,"_5":22713,"_15335":34165,"_1612":34393},[],"Importación de una clave KMS",{"_8073":656,"_22563":571,"_19084":34395,"_5":22713,"_15335":34165,"_1612":34396},[],"**kms.update.metadata**",{"_8073":657,"_22563":571,"_19084":34398,"_5":22713,"_15335":34165,"_1612":34399},[],"Actualización de metadatos de clave KMS",{"_8073":658,"_22563":571,"_19084":34401,"_5":22713,"_15335":34165,"_1612":34402},[],"**kms.update.aliases**",{"_8073":659,"_22563":571,"_19084":34404,"_5":22713,"_15335":34165,"_1612":34405},[],"Actualización de alias de clave KMS",{"_8073":660,"_22563":571,"_19084":34407,"_5":22713,"_15335":34165,"_1612":34408},[],"**kms.update.name**",{"_8073":661,"_22563":571,"_19084":34410,"_5":22713,"_15335":34165,"_1612":34411},[],"Cambio de nombre de una clave KMS",{"_8073":662,"_22563":571,"_19084":34413,"_5":22713,"_15335":34165,"_1612":34414},[],"**kms.update.tags**",{"_8073":663,"_22563":571,"_19084":34416,"_5":22713,"_15335":34165,"_1612":34417},[],"Actualización de etiquetas (tags) de clave KMS",{"_8073":664,"_22563":571,"_19084":34419,"_5":22713,"_15335":34165,"_1612":34420},[],"**kms.delete**",{"_8073":665,"_22563":571,"_19084":34422,"_5":22713,"_15335":34165,"_1612":34423},[],"Eliminación de una clave KMS",{"_8073":666,"_22563":571,"_19084":34425,"_5":22713,"_15335":34165,"_1612":34426},[],"**kms.sign.message**",{"_8073":667,"_22563":571,"_19084":34428,"_5":22713,"_15335":34165,"_1612":34429},[],"Firma de un mensaje con clave KMS",{"_8073":668,"_22563":571,"_19084":34431,"_5":22713,"_15335":34165,"_1612":34432},[],"**kms.verify.signature**",{"_8073":669,"_22563":571,"_19084":34434,"_5":22713,"_15335":34165,"_1612":34435},[],"Verificación de firma con clave KMS",{"_8073":670,"_22563":670,"_5":22708,"_1612":34437,"_22721":34438,"_19084":34439,"_15335":670},"[CA] Gestión de Entidades de Confianza",[32429,33528,33537],[],{"_8073":671,"_22563":670,"_19084":34441,"_5":22713,"_15335":670,"_1612":34442},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_8073":672,"_22563":670,"_5":22718,"_19084":34444,"_15335":34445,"_1612":34446},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_8073":673,"_22563":670,"_5":22718,"_19084":34448,"_15335":34449,"_1612":34450},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_8073":674,"_22563":670,"_5":22718,"_19084":34452,"_15335":34453,"_1612":34454},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_8073":675,"_22563":670,"_5":22718,"_19084":34456,"_15335":34457,"_1612":34458},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_8073":676,"_22563":670,"_5":22718,"_19084":34460,"_15335":34461,"_1612":34462},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_8073":677,"_22563":670,"_5":22718,"_19084":34464,"_15335":34465,"_1612":34466},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_8073":678,"_22563":670,"_5":22718,"_19084":34468,"_15335":34469,"_1612":34470},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_8073":679,"_22563":670,"_5":22718,"_19084":34472,"_15335":34473,"_1612":34474},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_8073":680,"_22563":670,"_5":22718,"_19084":34476,"_15335":34477,"_1612":34478},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_8073":681,"_22563":670,"_19084":34480,"_5":22713,"_15335":34449,"_1612":34481},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_8073":682,"_22563":670,"_19084":34483,"_5":22713,"_15335":34449,"_1612":34484},[],"Actualmente hay disponibles 3 acciones:",{"_8073":683,"_22563":670,"_19084":34486,"_5":22713,"_15335":34449,"_1612":34487},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_8073":684,"_22563":670,"_19084":34489,"_5":22713,"_15335":34449,"_1612":34490},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_8073":685,"_22563":670,"_19084":34492,"_5":22713,"_15335":34449,"_1612":34493},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_8073":686,"_22563":670,"_19084":34495,"_5":22713,"_15335":34453,"_1612":34496},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_8073":687,"_22563":670,"_19084":34498,"_5":22713,"_15335":34453,"_1612":34499},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_8073":688,"_22563":670,"_19084":34501,"_5":22713,"_15335":34453,"_1612":34502},[],"**Motor criptográfico**",{"_8073":689,"_22563":670,"_19084":34504,"_5":22713,"_15335":34453,"_1612":34505},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_8073":690,"_22563":670,"_19084":34507,"_5":22713,"_15335":34453,"_1612":34508},[],"**Ejemplo mostrado:** go1.24.3",{"_8073":691,"_22563":670,"_19084":34510,"_5":22713,"_15335":34453,"_1612":34511},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_8073":692,"_22563":670,"_19084":34513,"_5":22713,"_15335":34453,"_1612":34514},[],"**Parámetros de clave**",{"_8073":693,"_22563":670,"_19084":34516,"_5":22713,"_15335":34453,"_1612":34517},[],"**Key Type:** RSA / EC (Elliptic Curve), Ed25519 y los tipos post-cuánticos e híbridos (ML-DSA, SLH-DSA y Composite-ML-DSA), según el motor seleccionado",{"_8073":694,"_22563":670,"_19084":34519,"_5":22713,"_15335":34453,"_1612":34520},[],"**Key Size:**",{"_8073":695,"_22563":670,"_19084":34522,"_5":22713,"_15335":34453,"_1612":34523},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_8073":696,"_22563":670,"_19084":34525,"_5":22713,"_15335":34453,"_1612":34526},[],"EC: P-256, P-384, P-521",{"_8073":697,"_22563":670,"_19084":34528,"_5":22713,"_15335":34453,"_1612":34529},[],"Ed25519: tamaño fijo 256",{"_8073":698,"_22563":670,"_19084":34531,"_5":22713,"_15335":34453,"_1612":34532},[],"ML-DSA: 44, 65, 87",{"_8073":699,"_22563":670,"_19084":34534,"_5":22713,"_15335":34453,"_1612":34535},[],"SLH-DSA: conjunto de parámetros del 1 al 12",{"_8073":700,"_22563":670,"_19084":34537,"_5":22713,"_15335":34453,"_1612":34538},[],"Composite-ML-DSA: variante del 1 al 15, según la familia (RSA 1-8, ECDSA 9-13, Ed25519 14-15)",{"_8073":701,"_22563":670,"_19084":34540,"_5":22713,"_15335":34453,"_1612":34541},[],"**Recomendado:** EC P-384",{"_8073":702,"_22563":670,"_19084":34543,"_5":22713,"_15335":34453,"_1612":34544},[],"La disponibilidad de estos tipos de clave depende del motor criptográfico seleccionado. Si se elige un tipo de clave que el motor no admite, la creación de la CA se rechaza. Consulte la tabla de tipos de clave del servicio KMS para más detalles.",{"_8073":703,"_22563":670,"_19084":34546,"_5":22713,"_15335":34453,"_1612":34547},[],"**Perfil de emisión del certificado de la CA**",{"_8073":704,"_22563":670,"_19084":34549,"_5":22713,"_15335":34453,"_1612":34550},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_8073":705,"_22563":670,"_19084":34552,"_5":22713,"_15335":34453,"_1612":34553},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_8073":706,"_22563":670,"_19084":34555,"_5":22713,"_15335":34453,"_1612":34556},[],"**Configuración de la CA**",{"_8073":707,"_22563":670,"_19084":34558,"_5":22713,"_15335":34453,"_1612":34559},[],"**Tipo de CA**",{"_8073":708,"_22563":670,"_19084":34561,"_5":22713,"_15335":34453,"_1612":34562},[],"**Root CA:** Autoridad raíz autofirmada",{"_8073":709,"_22563":670,"_19084":34564,"_5":22713,"_15335":34453,"_1612":34565},[],"**Intermediate CA:** Autoridad subordinada",{"_8073":710,"_22563":670,"_19084":34567,"_5":22713,"_15335":34453,"_1612":34568},[],"**Emisor**",{"_8073":711,"_22563":670,"_19084":34570,"_5":22713,"_15335":34453,"_1612":34571},[],"**Root CA:** Self-signed (auto-firmada)",{"_8073":712,"_22563":670,"_19084":34573,"_5":22713,"_15335":34453,"_1612":34574},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_8073":713,"_22563":670,"_19084":34576,"_5":22713,"_15335":34453,"_1612":34577},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_8073":714,"_22563":670,"_19084":34579,"_5":22713,"_15335":34453,"_1612":34580},[],"**Identificación**",{"_8073":715,"_22563":670,"_19084":34582,"_5":22713,"_15335":34453,"_1612":34583},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_8073":716,"_22563":670,"_19084":34585,"_5":22713,"_15335":34453,"_1612":34586},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_8073":717,"_22563":670,"_19084":34588,"_5":22713,"_15335":34453,"_1612":34589},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_8073":718,"_22563":670,"_19084":34591,"_5":22713,"_15335":34453,"_1612":34592},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_8073":719,"_22563":670,"_19084":34594,"_5":22713,"_15335":34453,"_1612":34595},[],"**Subject Distinguished Name (DN)**",{"_8073":720,"_22563":670,"_19084":34597,"_5":22713,"_15335":34453,"_1612":34598},[],"Campos opcionales:",{"_8073":721,"_22563":670,"_19084":34600,"_5":22713,"_15335":34453,"_1612":34601},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_8073":722,"_22563":670,"_19084":34603,"_5":22713,"_15335":34453,"_1612":34604},[],"Ejemplo: US, ES, DE",{"_8073":723,"_22563":670,"_19084":34606,"_5":22713,"_15335":34453,"_1612":34607},[],"**State/Province (ST):** Estado o provincia",{"_8073":724,"_22563":670,"_19084":34609,"_5":22713,"_15335":34453,"_1612":34610},[],"Ejemplo: California, Madrid",{"_8073":725,"_22563":670,"_19084":34612,"_5":22713,"_15335":34453,"_1612":34613},[],"**Locality (L):** Ciudad o localidad",{"_8073":726,"_22563":670,"_19084":34615,"_5":22713,"_15335":34453,"_1612":34616},[],"Ejemplo: San Francisco, Arrasate",{"_8073":727,"_22563":670,"_19084":34618,"_5":22713,"_15335":34453,"_1612":34619},[],"**Organization (O):** Nombre de la organización",{"_8073":728,"_22563":670,"_19084":34621,"_5":22713,"_15335":34453,"_1612":34622},[],"Ejemplo: Lamassu IoT Corp",{"_8073":729,"_22563":670,"_19084":34624,"_5":22713,"_15335":34453,"_1612":34625},[],"**Organizational Unit (OU):** Unidad organizacional",{"_8073":730,"_22563":670,"_19084":34627,"_5":22713,"_15335":34453,"_1612":34628},[],"Ejemplo: Secure Devices Division",{"_8073":731,"_22563":670,"_19084":34630,"_5":22713,"_15335":34453,"_1612":34631},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_8073":732,"_22563":670,"_19084":34633,"_5":22713,"_15335":34453,"_1612":34634},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_8073":733,"_22563":670,"_19084":34636,"_5":22713,"_15335":34453,"_1612":34637},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_8073":734,"_22563":670,"_19084":34639,"_5":22713,"_15335":34453,"_1612":34640},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_8073":735,"_22563":670,"_19084":34642,"_5":22713,"_15335":34453,"_1612":34643},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_8073":736,"_22563":670,"_19084":34645,"_5":22713,"_15335":34453,"_1612":34646},[],"**Duración:** Configurable según necesidades organizacionales",{"_8073":737,"_22563":670,"_19084":34648,"_5":22713,"_15335":34453,"_1612":34649},[],"**Valor por defecto:** 10 años (10y)",{"_8073":738,"_22563":670,"_19084":34651,"_5":22713,"_15335":34453,"_1612":34652},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_8073":739,"_22563":670,"_19084":34654,"_5":22713,"_15335":34453,"_1612":34655},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_8073":740,"_22563":670,"_19084":34657,"_5":22713,"_15335":34453,"_1612":34658},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_8073":741,"_22563":670,"_19084":34660,"_5":22713,"_15335":34453,"_1612":34661},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_8073":742,"_22563":670,"_19084":34663,"_5":22713,"_15335":34453,"_1612":34664},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_8073":743,"_22563":670,"_19084":34666,"_5":22713,"_15335":34453,"_1612":34667},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_8073":744,"_22563":670,"_19084":34669,"_5":22713,"_15335":34453,"_1612":34670},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_8073":745,"_22563":670,"_19084":34672,"_5":22713,"_15335":34453,"_1612":34673},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_8073":746,"_22563":670,"_19084":34675,"_5":22713,"_15335":34453,"_1612":34676},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_8073":747,"_22563":670,"_19084":34678,"_5":22713,"_15335":34453,"_1612":34679},[],"**Valor por defecto:** 1 año (1y)",{"_8073":748,"_22563":670,"_19084":34681,"_5":22713,"_15335":34453,"_1612":34682},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_8073":749,"_22563":670,"_19084":34684,"_5":22713,"_15335":34453,"_1612":34685},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_8073":750,"_22563":670,"_19084":34687,"_5":22713,"_15335":34457,"_1612":34688},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_8073":751,"_22563":670,"_19084":34690,"_5":22713,"_15335":34457,"_1612":34691},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_8073":752,"_22563":670,"_19084":34693,"_5":22713,"_15335":34457,"_1612":34694},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_8073":753,"_22563":670,"_19084":34696,"_5":22713,"_15335":34457,"_1612":34697},[],"Cualquier clave registrada en el KMS puede servir de soporte a una CA, incluidas las de tipo post-cuántico o híbrido. Esto permite construir jerarquías de confianza en las que el tipo de clave del emisor no tiene por qué coincidir con el del sujeto: por ejemplo, una CA raíz ML-DSA puede emitir certificados sobre claves RSA o ECDSA, y viceversa.",{"_8073":754,"_22563":670,"_19084":34699,"_5":22713,"_15335":34461,"_1612":34700},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_8073":755,"_22563":670,"_19084":34702,"_5":22713,"_15335":34461,"_1612":34703},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_8073":756,"_22563":670,"_19084":34705,"_5":22713,"_15335":34461,"_1612":34505},[],{"_8073":757,"_22563":670,"_19084":34707,"_5":22713,"_15335":34461,"_1612":34508},[],{"_8073":758,"_22563":670,"_19084":34709,"_5":22713,"_15335":34461,"_1612":34511},[],{"_8073":759,"_22563":670,"_19084":34711,"_5":22713,"_15335":34461,"_1612":34712},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_8073":760,"_22563":670,"_19084":34714,"_5":22713,"_15335":34461,"_1612":34670},[],{"_8073":761,"_22563":670,"_19084":34716,"_5":22713,"_15335":34461,"_1612":34673},[],{"_8073":762,"_22563":670,"_19084":34718,"_5":22713,"_15335":34461,"_1612":34676},[],{"_8073":763,"_22563":670,"_19084":34720,"_5":22713,"_15335":34461,"_1612":34679},[],{"_8073":764,"_22563":670,"_19084":34722,"_5":22713,"_15335":34461,"_1612":34682},[],{"_8073":765,"_22563":670,"_19084":34724,"_5":22713,"_15335":34461,"_1612":34725},[],"Se debe proporcionar de manera obligatoria:",{"_8073":766,"_22563":670,"_19084":34727,"_5":22713,"_15335":34461,"_1612":34728},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_8073":767,"_22563":670,"_19084":34730,"_5":22713,"_15335":34461,"_1612":34731},[],"Clave privada de la CA en formato PEM",{"_8073":768,"_22563":670,"_19084":34733,"_5":22713,"_15335":34461,"_1612":34734},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_8073":769,"_22563":670,"_19084":34736,"_5":22713,"_15335":34461,"_1612":34737},[],"La clave privada se importa a través del mecanismo de importación de claves del servicio KMS (formato PKCS#8), por lo que se admiten los mismos tipos de clave: RSA, ECDSA, Ed25519, ML-DSA, SLH-DSA y Composite-ML-DSA, según el soporte del motor seleccionado. El algoritmo y el tamaño se detectan automáticamente a partir del material importado.",{"_8073":770,"_22563":670,"_19084":34739,"_5":22713,"_15335":34469,"_1612":34740},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_8073":771,"_22563":670,"_19084":34742,"_5":22713,"_15335":34469,"_1612":34743},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_8073":772,"_22563":670,"_19084":34745,"_5":22713,"_15335":34469,"_1612":34746},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_8073":773,"_22563":670,"_19084":34748,"_5":22713,"_15335":34469,"_1612":34749},[],"Se ofrecen dos acciones:",{"_8073":774,"_22563":670,"_19084":34751,"_5":22713,"_15335":34469,"_1612":34752},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_8073":775,"_22563":670,"_19084":34754,"_5":22713,"_15335":34469,"_1612":34755},[],"la acción de revocación de la CA",{"_8073":776,"_22563":670,"_19084":34757,"_5":22713,"_15335":34469,"_1612":34758},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_8073":777,"_22563":670,"_19084":34760,"_5":22713,"_15335":34473,"_1612":34761},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_8073":778,"_22563":670,"_19084":34763,"_5":22713,"_15335":34473,"_1612":34764},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_8073":779,"_22563":670,"_19084":34766,"_5":22713,"_15335":34473,"_1612":34767},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_8073":780,"_22563":670,"_19084":34769,"_5":22713,"_15335":34473,"_1612":34770},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_8073":781,"_22563":670,"_19084":34772,"_5":22713,"_15335":34473,"_1612":34773},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_8073":782,"_22563":670,"_19084":34775,"_5":22713,"_15335":34473,"_1612":34776},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_8073":783,"_22563":670,"_19084":34778,"_5":22713,"_15335":34473,"_1612":34779},[],"Emisión a partir de un CSR generado de manera externa",{"_8073":784,"_22563":670,"_19084":34781,"_5":22713,"_15335":34473,"_1612":34782},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_8073":785,"_22563":670,"_19084":34784,"_5":22713,"_15335":34473,"_1612":34785},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_8073":786,"_22563":670,"_19084":34787,"_5":22713,"_15335":34473,"_1612":34788},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_8073":787,"_22563":670,"_19084":34790,"_5":22713,"_15335":34473,"_1612":34791},[],"**Certificate Subject (Sujeto del certificado)**",{"_8073":788,"_22563":670,"_19084":34793,"_5":22713,"_15335":34473,"_1612":34794},[],"**Common Name (CN)**",{"_8073":789,"_22563":670,"_19084":34796,"_5":22713,"_15335":34473,"_1612":34797},[],"**Campo:** Obligatorio",{"_8073":790,"_22563":670,"_19084":34799,"_5":22713,"_15335":34473,"_1612":34800},[],"**Función:** Identifica de forma única al titular del certificado",{"_8073":791,"_22563":670,"_19084":34802,"_5":22713,"_15335":34473,"_1612":34803},[],"**Ejemplos:**",{"_8073":792,"_22563":670,"_19084":34805,"_5":22713,"_15335":34473,"_1612":34806},[],"Para dispositivos: device001.company.com",{"_8073":793,"_22563":670,"_19084":34808,"_5":22713,"_15335":34473,"_1612":34809},[],"Para usuarios: john.doe\\@company.com",{"_8073":794,"_22563":670,"_19084":34811,"_5":22713,"_15335":34473,"_1612":34812},[],"Para servicios: api.service.company.com",{"_8073":795,"_22563":670,"_19084":34814,"_5":22713,"_15335":34473,"_1612":34815},[],"**Campos Organizacionales**",{"_8073":796,"_22563":670,"_19084":34817,"_5":22713,"_15335":34473,"_1612":34818},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_8073":797,"_22563":670,"_19084":34820,"_5":22713,"_15335":34473,"_1612":34821},[],"Ejemplo: IT Department, Manufacturing",{"_8073":798,"_22563":670,"_19084":34823,"_5":22713,"_15335":34473,"_1612":34619},[],{"_8073":799,"_22563":670,"_19084":34825,"_5":22713,"_15335":34473,"_1612":34826},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_8073":800,"_22563":670,"_19084":34828,"_5":22713,"_15335":34473,"_1612":34829},[],"**Información Geográfica**",{"_8073":801,"_22563":670,"_19084":34831,"_5":22713,"_15335":34473,"_1612":34832},[],"**Locality (L):** Ciudad o localidad del titular",{"_8073":802,"_22563":670,"_19084":34834,"_5":22713,"_15335":34473,"_1612":34607},[],{"_8073":803,"_22563":670,"_19084":34836,"_5":22713,"_15335":34473,"_1612":34837},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_8073":804,"_22563":670,"_19084":34839,"_5":22713,"_15335":34473,"_1612":34840},[],"Valor por defecto mostrado: US",{"_8073":805,"_22563":670,"_19084":34842,"_5":22713,"_15335":34473,"_1612":34843},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_8073":806,"_22563":670,"_19084":34845,"_5":22713,"_15335":34473,"_1612":34846},[],"**Tipos de SAN Disponibles**",{"_8073":807,"_22563":670,"_19084":34848,"_5":22713,"_15335":34473,"_1612":34849},[],"**DNS:** Nombres de dominio",{"_8073":808,"_22563":670,"_19084":34851,"_5":22713,"_15335":34473,"_1612":34852},[],"Ejemplo: example.com, \\*.example.com",{"_8073":809,"_22563":670,"_19084":34854,"_5":22713,"_15335":34473,"_1612":34855},[],"**IP Address:** Direcciones IP",{"_8073":810,"_22563":670,"_19084":34857,"_5":22713,"_15335":34473,"_1612":34858},[],"**Email:** Direcciones de correo electrónico",{"_8073":811,"_22563":670,"_19084":34860,"_5":22713,"_15335":34473,"_1612":34861},[],"**URI:** Identificadores de recursos uniformes",{"_8073":812,"_22563":670,"_19084":34863,"_5":22713,"_15335":34473,"_1612":34864},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_8073":813,"_22563":670,"_19084":34866,"_5":22713,"_15335":34473,"_1612":34867},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado.",{"_8073":814,"_22563":670,"_19084":34869,"_5":22713,"_15335":34473,"_1612":34870},[],"**Algorithm (Algoritmo)**",{"_8073":815,"_22563":670,"_19084":34872,"_5":22713,"_15335":34473,"_1612":34873},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_8073":816,"_22563":670,"_19084":34875,"_5":22713,"_15335":34473,"_1612":34876},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_8073":817,"_22563":670,"_19084":34878,"_5":22713,"_15335":34473,"_1612":34879},[],"**Certificate Configuration (Configuración del certificado)**",{"_8073":818,"_22563":670,"_19084":34881,"_5":22713,"_15335":34473,"_1612":34882},[],"**Validity Duration (Duración de validez)**",{"_8073":819,"_22563":670,"_19084":34884,"_5":22713,"_15335":34473,"_1612":34885},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_8073":820,"_22563":670,"_19084":34887,"_5":22713,"_15335":34473,"_1612":34888},[],"**Campo:** Configurable según necesidades",{"_8073":821,"_22563":670,"_19084":34890,"_5":22713,"_15335":34473,"_1612":34679},[],{"_8073":822,"_22563":670,"_19084":34892,"_5":22713,"_15335":34473,"_1612":34893},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_8073":823,"_22563":670,"_19084":34895,"_5":22713,"_15335":34473,"_1612":34896},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_8073":824,"_22563":670,"_19084":34898,"_5":22713,"_15335":34473,"_1612":34899},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_8073":825,"_22563":670,"_19084":34901,"_5":22713,"_15335":34473,"_1612":34902},[],"**Usos Básicos**",{"_8073":826,"_22563":670,"_19084":34904,"_5":22713,"_15335":34473,"_1612":34905},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_8073":827,"_22563":670,"_19084":34907,"_5":22713,"_15335":34473,"_1612":34908},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_8073":828,"_22563":670,"_19084":34910,"_5":22713,"_15335":34473,"_1612":34911},[],"**Key Encipherment:** Cifrado de claves",{"_8073":829,"_22563":670,"_19084":34913,"_5":22713,"_15335":34473,"_1612":34914},[],"**Data Encipherment:** Cifrado de datos",{"_8073":830,"_22563":670,"_19084":34916,"_5":22713,"_15335":34473,"_1612":34917},[],"**Key Agreement:** Acuerdo de claves",{"_8073":831,"_22563":670,"_19084":34919,"_5":22713,"_15335":34473,"_1612":34920},[],"**Certificate Signing:** Firma de certificados",{"_8073":832,"_22563":670,"_19084":34922,"_5":22713,"_15335":34473,"_1612":34923},[],"**CRL Signing:** Firma de listas de revocación",{"_8073":833,"_22563":670,"_19084":34925,"_5":22713,"_15335":34473,"_1612":34926},[],"**Encipher Only:** Solo cifrado",{"_8073":834,"_22563":670,"_19084":34928,"_5":22713,"_15335":34473,"_1612":34929},[],"**Decipher Only:** Solo descifrado",{"_8073":835,"_22563":670,"_19084":34931,"_5":22713,"_15335":34473,"_1612":34932},[],"**Uso Extendido de Claves**",{"_8073":836,"_22563":670,"_19084":34934,"_5":22713,"_15335":34473,"_1612":34935},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_8073":837,"_22563":670,"_19084":34937,"_5":22713,"_15335":34473,"_1612":34938},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_8073":838,"_22563":670,"_19084":34940,"_5":22713,"_15335":34473,"_1612":34941},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_8073":839,"_22563":670,"_19084":34943,"_5":22713,"_15335":34473,"_1612":34944},[],"**Code Signing:** Firma de código",{"_8073":840,"_22563":670,"_19084":34946,"_5":22713,"_15335":34473,"_1612":34947},[],"**Email Protection:** Protección de correo electrónico",{"_8073":841,"_22563":670,"_19084":34949,"_5":22713,"_15335":34473,"_1612":34950},[],"**Time Stamping:** Sellado de tiempo",{"_8073":842,"_22563":670,"_19084":34952,"_5":22713,"_15335":34473,"_1612":34953},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_8073":843,"_22563":670,"_19084":34955,"_5":22713,"_15335":34473,"_1612":34956},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_8073":844,"_22563":670,"_19084":34958,"_5":22713,"_15335":34473,"_1612":34959},[],"**Emisión a partir de un CSR generado de manera externa**",{"_8073":845,"_22563":670,"_19084":34961,"_5":22713,"_15335":34473,"_1612":34962},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_8073":846,"_22563":670,"_19084":34964,"_5":22713,"_15335":34473,"_1612":34965},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_8073":847,"_22563":670,"_19084":34967,"_5":22713,"_15335":34473,"_1612":34968},[],"El CSR externo puede estar firmado con cualquier tipo de clave admitido por la plataforma, incluidos los tipos post-cuánticos e híbridos. No es necesario que el tipo de clave del CSR coincida con el de la CA emisora: por ejemplo, una CA RSA o ECDSA puede emitir certificados sobre claves ML-DSA o Composite-ML-DSA, y viceversa.",{"_8073":848,"_22563":670,"_19084":34970,"_5":22713,"_15335":34473,"_1612":34971},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_8073":849,"_22563":670,"_19084":34973,"_5":22713,"_15335":34477,"_1612":34974},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_8073":850,"_22563":670,"_19084":34976,"_5":22713,"_15335":34477,"_1612":34977},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_8073":851,"_22563":670,"_19084":34979,"_5":22713,"_15335":34477,"_1612":34980},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_8073":852,"_22563":670,"_19084":34982,"_5":22713,"_15335":34477,"_1612":34983},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_8073":853,"_22563":670,"_19084":34985,"_5":22713,"_15335":34477,"_1612":34986},[],"Unspecified (No especificado)",{"_8073":854,"_22563":670,"_19084":34988,"_5":22713,"_15335":34477,"_1612":34989},[],"KeyCompromise (Compromiso de clave)",{"_8073":855,"_22563":670,"_19084":34991,"_5":22713,"_15335":34477,"_1612":34992},[],"CACompromise (Compromiso de CA)",{"_8073":856,"_22563":670,"_19084":34994,"_5":22713,"_15335":34477,"_1612":34995},[],"AffiliationChanged (Afiliación cambiada)",{"_8073":857,"_22563":670,"_19084":34997,"_5":22713,"_15335":34477,"_1612":34998},[],"Superseded (Sustituida)",{"_8073":858,"_22563":670,"_19084":35000,"_5":22713,"_15335":34477,"_1612":35001},[],"CessationOfOperation (Cese de operación)",{"_8073":859,"_22563":670,"_19084":35003,"_5":22713,"_15335":34477,"_1612":35004},[],"CertificateHold (Retención de certificado)",{"_8073":860,"_22563":670,"_19084":35006,"_5":22713,"_15335":34477,"_1612":35007},[],"RemoveFromCRL (Eliminar de la CRL)",{"_8073":861,"_22563":670,"_19084":35009,"_5":22713,"_15335":34477,"_1612":35010},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_8073":862,"_22563":670,"_19084":35012,"_5":22713,"_15335":34477,"_1612":35013},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_8073":863,"_22563":670,"_19084":35015,"_5":22713,"_15335":34477,"_1612":35016},[],"Consideraciones importantes:",{"_8073":864,"_22563":670,"_19084":35018,"_5":22713,"_15335":34477,"_1612":35019},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_8073":865,"_22563":670,"_19084":35021,"_5":22713,"_15335":34477,"_1612":35022},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_8073":866,"_22563":866,"_5":22708,"_1612":35024,"_22721":35025,"_19084":35026,"_15335":866},"[Certs] Gestión de Certificados",[32429,33528,33537],[],{"_8073":867,"_22563":866,"_19084":35028,"_5":22713,"_15335":866,"_1612":35029},[],"Visualización y gestión de certificados emitidos",{"_8073":868,"_22563":866,"_5":22718,"_19084":35031,"_15335":35032,"_1612":35033},[],"/docs/pr-preview/pr-25/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_8073":869,"_22563":866,"_5":22718,"_19084":35035,"_15335":35036,"_1612":35037},[],"/docs/pr-preview/pr-25/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_8073":870,"_22563":866,"_19084":35039,"_5":22713,"_15335":35032,"_1612":35040},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_8073":871,"_22563":866,"_19084":35042,"_5":22713,"_15335":35032,"_1612":35043},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_8073":872,"_22563":866,"_19084":35045,"_5":22713,"_15335":35032,"_1612":35046},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_8073":873,"_22563":866,"_19084":35048,"_5":22713,"_15335":35036,"_1612":35049},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_8073":874,"_22563":866,"_19084":35051,"_5":22713,"_15335":35036,"_1612":35052},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_8073":875,"_22563":875,"_5":22708,"_1612":35054,"_22721":35055,"_19084":35056,"_15335":875},"[Devices] Dispositivos e Identidades",[32429,33528,33537],[],{"_8073":876,"_22563":875,"_19084":35058,"_5":22713,"_15335":875,"_1612":35059},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_8073":877,"_22563":875,"_5":22718,"_19084":35061,"_15335":35062,"_1612":35063},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_8073":878,"_22563":875,"_5":22718,"_19084":35065,"_15335":35066,"_1612":35067},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_8073":879,"_22563":875,"_5":22718,"_19084":35069,"_15335":35070,"_1612":35071},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_8073":880,"_22563":875,"_5":22718,"_19084":35073,"_15335":35074,"_1612":35075},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_8073":881,"_22563":875,"_5":22718,"_19084":35077,"_15335":35078,"_1612":35079},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_8073":882,"_22563":875,"_5":22718,"_19084":35081,"_15335":35082,"_1612":35083},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_8073":883,"_22563":875,"_5":22718,"_19084":35085,"_15335":35086,"_1612":35087},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_8073":884,"_22563":875,"_5":22718,"_19084":35089,"_15335":35090,"_1612":35091},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_8073":885,"_22563":875,"_19084":35093,"_5":22713,"_15335":35062,"_1612":35094},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_8073":886,"_22563":875,"_19084":35096,"_5":22713,"_15335":35066,"_1612":35097},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_8073":887,"_22563":875,"_19084":35099,"_5":22713,"_15335":35066,"_1612":35100},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_8073":888,"_22563":875,"_19084":35102,"_5":22713,"_15335":35066,"_1612":35103},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_8073":889,"_22563":875,"_19084":35105,"_5":22713,"_15335":35066,"_1612":35106},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_8073":890,"_22563":875,"_19084":35108,"_5":22713,"_15335":35066,"_1612":35109},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_8073":891,"_22563":875,"_19084":35111,"_5":22713,"_15335":35066,"_1612":35112},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_8073":892,"_22563":875,"_19084":35114,"_5":22713,"_15335":35066,"_1612":35115},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_8073":893,"_22563":875,"_19084":35117,"_5":22713,"_15335":35066,"_1612":35118},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_8073":894,"_22563":875,"_19084":35120,"_5":22713,"_15335":35066,"_1612":35121},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_8073":895,"_22563":875,"_19084":35123,"_5":22713,"_15335":35070,"_1612":35124},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_8073":896,"_22563":875,"_19084":35126,"_5":22713,"_15335":35070,"_1612":35127},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_8073":897,"_22563":875,"_19084":35129,"_5":22713,"_15335":35074,"_1612":35130},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_8073":898,"_22563":875,"_19084":35132,"_5":22713,"_15335":35074,"_1612":35133},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_8073":899,"_22563":875,"_19084":35135,"_5":22713,"_15335":35078,"_1612":35136},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_8073":900,"_22563":875,"_19084":35138,"_5":22713,"_15335":35078,"_1612":35139},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_8073":901,"_22563":875,"_19084":35141,"_5":22713,"_15335":35078,"_1612":35142},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_8073":902,"_22563":875,"_19084":35144,"_5":22713,"_15335":35078,"_1612":35145},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_8073":903,"_22563":875,"_19084":35147,"_5":22713,"_15335":35078,"_1612":35148},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_8073":904,"_22563":875,"_19084":35150,"_5":22713,"_15335":35078,"_1612":35151},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_8073":905,"_22563":875,"_19084":35153,"_5":22713,"_15335":35078,"_1612":35154},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_8073":906,"_22563":875,"_19084":35156,"_5":22713,"_15335":35078,"_1612":35157},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_8073":907,"_22563":875,"_19084":35159,"_5":22713,"_15335":35082,"_1612":35160},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_8073":908,"_22563":875,"_19084":35162,"_5":22713,"_15335":35082,"_1612":35163},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_8073":909,"_22563":875,"_19084":35165,"_5":22713,"_15335":35082,"_1612":35166},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_8073":910,"_22563":875,"_19084":35168,"_5":22713,"_15335":35082,"_1612":35169},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_8073":911,"_22563":875,"_19084":35171,"_5":22713,"_15335":35082,"_1612":35172},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_8073":912,"_22563":875,"_19084":35174,"_5":22713,"_15335":35082,"_1612":35175},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_8073":913,"_22563":875,"_19084":35177,"_5":22713,"_15335":35086,"_1612":35178},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_8073":914,"_22563":875,"_19084":35180,"_5":22713,"_15335":35086,"_1612":35181},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_8073":915,"_22563":875,"_19084":35183,"_5":22713,"_15335":35086,"_1612":35184},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_8073":916,"_22563":875,"_19084":35186,"_5":22713,"_15335":35086,"_1612":35187},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_8073":917,"_22563":875,"_19084":35189,"_5":22713,"_15335":35086,"_1612":35190},[],"**Unspecified**: Motivo de revocación no especificado.",{"_8073":918,"_22563":875,"_19084":35192,"_5":22713,"_15335":35086,"_1612":35193},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_8073":919,"_22563":875,"_19084":35195,"_5":22713,"_15335":35086,"_1612":35196},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_8073":920,"_22563":875,"_19084":35198,"_5":22713,"_15335":35086,"_1612":35199},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_8073":921,"_22563":875,"_19084":35201,"_5":22713,"_15335":35086,"_1612":35202},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_8073":922,"_22563":875,"_19084":35204,"_5":22713,"_15335":35086,"_1612":35205},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_8073":923,"_22563":875,"_19084":35207,"_5":22713,"_15335":35086,"_1612":35208},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_8073":924,"_22563":875,"_19084":35210,"_5":22713,"_15335":35086,"_1612":35211},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_8073":925,"_22563":875,"_19084":35213,"_5":22713,"_15335":35086,"_1612":35214},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_8073":926,"_22563":875,"_19084":35216,"_5":22713,"_15335":35086,"_1612":35217},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_8073":927,"_22563":875,"_19084":35219,"_5":22713,"_15335":35086,"_1612":35220},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_8073":928,"_22563":875,"_19084":35222,"_5":22713,"_15335":35086,"_1612":35223},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_8073":929,"_22563":875,"_19084":35225,"_5":22713,"_15335":35090,"_1612":35226},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_8073":930,"_22563":875,"_19084":35228,"_5":22713,"_15335":35090,"_1612":35229},[],"El proceso se realiza de la siguiente manera:",{"_8073":931,"_22563":875,"_19084":35231,"_5":22713,"_15335":35090,"_1612":35232},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_8073":932,"_22563":875,"_19084":35234,"_5":22713,"_15335":35090,"_1612":35235},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_8073":933,"_22563":875,"_19084":35237,"_5":22713,"_15335":35090,"_1612":35238},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_8073":934,"_22563":934,"_5":22708,"_1612":35240,"_22721":35241,"_19084":35242,"_15335":934},"EST: Enrollment over Secure Transport",[32429,33528,33537],[],{"_8073":935,"_22563":934,"_19084":35244,"_5":22713,"_15335":934,"_1612":35245},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_8073":936,"_22563":934,"_5":22718,"_19084":35247,"_15335":35248,"_1612":35240},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_8073":937,"_22563":934,"_5":22718,"_19084":35250,"_15335":35251,"_1612":33611},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-del-dms",{"_8073":938,"_22563":934,"_5":22718,"_19084":35253,"_15335":35254,"_1612":33134},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos",{"_8073":939,"_22563":934,"_5":22718,"_19084":35256,"_15335":35257,"_1612":35258},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_8073":940,"_22563":934,"_5":22718,"_19084":35260,"_15335":35261,"_1612":35262},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_8073":941,"_22563":934,"_5":22718,"_19084":35264,"_15335":35265,"_1612":35266},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_8073":942,"_22563":934,"_5":22718,"_19084":35268,"_15335":35269,"_1612":35270},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_8073":943,"_22563":934,"_5":22718,"_19084":35272,"_15335":35273,"_1612":35274},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_8073":944,"_22563":934,"_5":22718,"_19084":35276,"_15335":35277,"_1612":35278},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_8073":945,"_22563":934,"_5":22718,"_19084":35280,"_15335":35281,"_1612":35282},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_8073":946,"_22563":934,"_5":22718,"_19084":35284,"_15335":35285,"_1612":35286},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_8073":947,"_22563":934,"_5":22718,"_19084":35288,"_15335":35289,"_1612":35290},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","Antes de empezar",{"_8073":948,"_22563":934,"_5":22718,"_19084":35292,"_15335":35293,"_1612":35294},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_8073":949,"_22563":934,"_5":22718,"_19084":35296,"_15335":35297,"_1612":35298},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_8073":950,"_22563":934,"_5":22718,"_19084":35300,"_15335":35301,"_1612":35302},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_8073":951,"_22563":934,"_5":22718,"_19084":35304,"_15335":35305,"_1612":35306},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#cacerts","`/cacerts`",{"_8073":952,"_22563":934,"_5":22718,"_19084":35308,"_15335":35309,"_1612":35310},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_8073":953,"_22563":934,"_5":22718,"_19084":35312,"_15335":35313,"_1612":35314},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_8073":954,"_22563":934,"_5":22718,"_19084":35316,"_15335":35317,"_1612":35318},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_8073":955,"_22563":934,"_5":22718,"_19084":35320,"_15335":35321,"_1612":35322},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#flujos-completos","Flujos completos",{"_8073":956,"_22563":934,"_5":22718,"_19084":35324,"_15335":35325,"_1612":35326},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_8073":957,"_22563":934,"_5":22718,"_19084":35328,"_15335":35329,"_1612":35330},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_8073":958,"_22563":934,"_5":22718,"_19084":35332,"_15335":35333,"_1612":35334},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_8073":959,"_22563":934,"_5":22718,"_19084":35336,"_15335":35337,"_1612":35338},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_8073":960,"_22563":934,"_5":22718,"_19084":35340,"_15335":35341,"_1612":35342},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_8073":961,"_22563":934,"_5":22718,"_19084":35344,"_15335":35345,"_1612":35346},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_8073":962,"_22563":934,"_19084":35348,"_5":22713,"_15335":35248,"_1612":35349},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_8073":963,"_22563":934,"_19084":35351,"_5":22713,"_15335":35248,"_1612":35352},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_8073":964,"_22563":934,"_19084":35354,"_5":22713,"_15335":35248,"_1612":35355},[],"Esta guía está dividida en dos partes:",{"_8073":965,"_22563":934,"_19084":35357,"_5":22713,"_15335":35248,"_1612":35358},[],"Configuración del DMS, para el administrador PKI.",{"_8073":966,"_22563":934,"_19084":35360,"_5":22713,"_15335":35248,"_1612":35361},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_8073":967,"_22563":934,"_19084":35363,"_5":22713,"_15335":35248,"_1612":35364},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_8073":968,"_22563":934,"_19084":35366,"_5":22713,"_15335":35248,"_1612":35367},[],"Perfil",{"_8073":969,"_22563":934,"_19084":35369,"_5":22713,"_15335":35248,"_1612":35370},[],"Leer primero",{"_8073":970,"_22563":934,"_19084":35372,"_5":22713,"_15335":35248,"_1612":35373},[],"Después",{"_8073":971,"_22563":934,"_19084":35375,"_5":22713,"_15335":35248,"_1612":35376},[],"Administrador PKI",{"_8073":972,"_22563":934,"_19084":35378,"_5":22713,"_15335":35248,"_1612":33611},[],{"_8073":973,"_22563":934,"_19084":35380,"_5":22713,"_15335":35248,"_1612":35338},[],{"_8073":974,"_22563":934,"_19084":35382,"_5":22713,"_15335":35248,"_1612":35383},[],"Integrador de dispositivos",{"_8073":975,"_22563":934,"_19084":35385,"_5":22713,"_15335":35248,"_1612":35290},[],{"_8073":976,"_22563":934,"_19084":35387,"_5":22713,"_15335":35248,"_1612":35388},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_8073":977,"_22563":934,"_19084":35390,"_5":22713,"_15335":35254,"_1612":35391},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_8073":978,"_22563":934,"_19084":35393,"_5":22713,"_15335":35254,"_1612":35394},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_8073":979,"_22563":934,"_19084":35396,"_5":22713,"_15335":35254,"_1612":35397},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_8073":980,"_22563":934,"_19084":35399,"_5":22713,"_15335":35254,"_1612":35400},[],"Conviene separar cuatro bloques de configuración:",{"_8073":981,"_22563":934,"_19084":35402,"_5":22713,"_15335":35254,"_1612":35403},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_8073":982,"_22563":934,"_19084":35405,"_5":22713,"_15335":35254,"_1612":35406},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_8073":983,"_22563":934,"_19084":35408,"_5":22713,"_15335":35254,"_1612":35409},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_8073":984,"_22563":934,"_19084":35411,"_5":22713,"_15335":35254,"_1612":35412},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_8073":985,"_22563":934,"_19084":35414,"_5":22713,"_15335":35261,"_1612":35415},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_8073":986,"_22563":934,"_19084":35417,"_5":22713,"_15335":35261,"_1612":35418},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_8073":987,"_22563":934,"_19084":35420,"_5":22713,"_15335":35261,"_1612":35421},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_8073":988,"_22563":934,"_19084":35423,"_5":22713,"_15335":35261,"_1612":35424},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_8073":989,"_22563":934,"_19084":35426,"_5":22713,"_15335":35265,"_1612":35427},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_8073":990,"_22563":934,"_19084":35429,"_5":22713,"_15335":35265,"_1612":35430},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_8073":991,"_22563":934,"_19084":35432,"_5":22713,"_15335":35265,"_1612":35433},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_8073":992,"_22563":934,"_19084":35435,"_5":22713,"_15335":35265,"_1612":35436},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_8073":993,"_22563":934,"_19084":35438,"_5":22713,"_15335":35265,"_1612":35439},[],"Modo",{"_8073":994,"_22563":934,"_19084":35441,"_5":22713,"_15335":35265,"_1612":32632},[],{"_8073":995,"_22563":934,"_19084":35443,"_5":22713,"_15335":35265,"_1612":35444},[],"`CLIENT_CERTIFICATE`",{"_8073":996,"_22563":934,"_19084":35446,"_5":22713,"_15335":35265,"_1612":35447},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_8073":997,"_22563":934,"_19084":35449,"_5":22713,"_15335":35265,"_1612":35450},[],"`EXTERNAL_WEBHOOK`",{"_8073":998,"_22563":934,"_19084":35452,"_5":22713,"_15335":35265,"_1612":35453},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_8073":999,"_22563":934,"_19084":35455,"_5":22713,"_15335":35265,"_1612":35456},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_8073":1000,"_22563":934,"_19084":35458,"_5":22713,"_15335":35265,"_1612":35459},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_8073":1001,"_22563":934,"_19084":35461,"_5":22713,"_15335":35265,"_1612":35462},[],"`NO_AUTH`",{"_8073":1002,"_22563":934,"_19084":35464,"_5":22713,"_15335":35265,"_1612":35465},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_8073":1003,"_22563":934,"_19084":35467,"_5":22713,"_15335":35265,"_1612":35468},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_8073":1004,"_22563":934,"_19084":35470,"_5":22713,"_15335":35265,"_1612":35471},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_8073":1005,"_22563":934,"_19084":35473,"_5":22713,"_15335":35265,"_1612":35474},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_8073":1006,"_22563":934,"_19084":35476,"_5":22713,"_15335":35265,"_1612":35477},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_8073":1007,"_22563":934,"_19084":35479,"_5":22713,"_15335":35265,"_1612":35480},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_8073":1008,"_22563":934,"_19084":35482,"_5":22713,"_15335":35265,"_1612":35483},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_8073":1009,"_22563":934,"_19084":35485,"_5":22713,"_15335":35265,"_1612":35486},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_8073":1010,"_22563":934,"_19084":35488,"_5":22713,"_15335":35265,"_1612":35489},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_8073":1011,"_22563":934,"_19084":35491,"_5":22713,"_15335":35265,"_1612":35492},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_8073":1012,"_22563":934,"_19084":35494,"_5":22713,"_15335":35265,"_1612":35495},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_8073":1013,"_22563":934,"_19084":35497,"_5":22713,"_15335":35269,"_1612":35498},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_8073":1014,"_22563":934,"_19084":35500,"_5":22713,"_15335":35269,"_1612":35501},[],"Campo",{"_8073":1015,"_22563":934,"_19084":35503,"_5":22713,"_15335":35269,"_1612":33763},[],{"_8073":1016,"_22563":934,"_19084":35505,"_5":22713,"_15335":35269,"_1612":35506},[],"Efecto sobre el certificado emitido",{"_8073":1017,"_22563":934,"_19084":35508,"_5":22713,"_15335":35269,"_1612":35509},[],"`HonorSubject`",{"_8073":1018,"_22563":934,"_19084":35511,"_5":22713,"_15335":35269,"_1612":20809},[],{"_8073":1019,"_22563":934,"_19084":35513,"_5":22713,"_15335":35269,"_1612":35514},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_8073":1020,"_22563":934,"_19084":35516,"_5":22713,"_15335":35269,"_1612":35517},[],"`HonorKeyUsage`",{"_8073":1021,"_22563":934,"_19084":35519,"_5":22713,"_15335":35269,"_1612":20809},[],{"_8073":1022,"_22563":934,"_19084":35521,"_5":22713,"_15335":35269,"_1612":35522},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_8073":1023,"_22563":934,"_19084":35524,"_5":22713,"_15335":35269,"_1612":35525},[],"`HonorExtendedKeyUsages`",{"_8073":1024,"_22563":934,"_19084":35527,"_5":22713,"_15335":35269,"_1612":20809},[],{"_8073":1025,"_22563":934,"_19084":35529,"_5":22713,"_15335":35269,"_1612":35530},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_8073":1026,"_22563":934,"_19084":35532,"_5":22713,"_15335":35269,"_1612":35533},[],"`HonorExtensions`",{"_8073":1027,"_22563":934,"_19084":35535,"_5":22713,"_15335":35269,"_1612":20809},[],{"_8073":1028,"_22563":934,"_19084":35537,"_5":22713,"_15335":35269,"_1612":35538},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_8073":1029,"_22563":934,"_19084":35540,"_5":22713,"_15335":35269,"_1612":35541},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_8073":1030,"_22563":934,"_19084":35543,"_5":22713,"_15335":35273,"_1612":35544},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_8073":1031,"_22563":934,"_19084":35546,"_5":22713,"_15335":35273,"_1612":35547},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_8073":1032,"_22563":934,"_19084":35549,"_5":22713,"_15335":35273,"_1612":35550},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_8073":1033,"_22563":934,"_19084":35552,"_5":22713,"_15335":35273,"_1612":35553},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_8073":1034,"_22563":934,"_19084":35555,"_5":22713,"_15335":35273,"_1612":35556},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_8073":1035,"_22563":934,"_19084":35558,"_5":22713,"_15335":35273,"_1612":35559},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_8073":1036,"_22563":934,"_19084":35561,"_5":22713,"_15335":35273,"_1612":35562},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_8073":1037,"_22563":934,"_19084":35564,"_5":22713,"_15335":35277,"_1612":35565},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_8073":1038,"_22563":934,"_19084":35567,"_5":22713,"_15335":35277,"_1612":35568},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_8073":1039,"_22563":934,"_19084":35570,"_5":22713,"_15335":35277,"_1612":35571},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_8073":1040,"_22563":934,"_19084":35573,"_5":22713,"_15335":35277,"_1612":35574},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_8073":1041,"_22563":934,"_19084":35576,"_5":22713,"_15335":35281,"_1612":35577},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_8073":1042,"_22563":934,"_19084":35579,"_5":22713,"_15335":35281,"_1612":35580},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_8073":1043,"_22563":934,"_19084":35582,"_5":22713,"_15335":35281,"_1612":35583},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_8073":1044,"_22563":934,"_19084":35585,"_5":22713,"_15335":35281,"_1612":35586},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_8073":1045,"_22563":934,"_19084":35588,"_5":22713,"_15335":35285,"_1612":35589},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_8073":1046,"_22563":934,"_19084":35591,"_5":22713,"_15335":35285,"_1612":35592},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_8073":1047,"_22563":934,"_19084":35594,"_5":22713,"_15335":35285,"_1612":35595},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_8073":1048,"_22563":934,"_19084":35597,"_5":22713,"_15335":35289,"_1612":35598},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_8073":1049,"_22563":934,"_19084":35600,"_5":22713,"_15335":35289,"_1612":35601},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_8073":1050,"_22563":934,"_19084":35603,"_5":22713,"_15335":35289,"_1612":35604},[],"Elemento",{"_8073":1051,"_22563":934,"_19084":35606,"_5":22713,"_15335":35289,"_1612":32632},[],{"_8073":1052,"_22563":934,"_19084":35608,"_5":22713,"_15335":35289,"_1612":35609},[],"**URL del host EST**",{"_8073":1053,"_22563":934,"_19084":35611,"_5":22713,"_15335":35289,"_1612":35612},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_8073":1054,"_22563":934,"_19084":35614,"_5":22713,"_15335":35289,"_1612":35615},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_8073":1055,"_22563":934,"_19084":35617,"_5":22713,"_15335":35289,"_1612":35618},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_8073":1056,"_22563":934,"_19084":35620,"_5":22713,"_15335":35289,"_1612":35621},[],"**Certificado bootstrap + clave privada**",{"_8073":1057,"_22563":934,"_19084":35623,"_5":22713,"_15335":35289,"_1612":35624},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_8073":1058,"_22563":934,"_19084":35626,"_5":22713,"_15335":35289,"_1612":35627},[],"**ID del DMS** (`{aps}`)",{"_8073":1059,"_22563":934,"_19084":35629,"_5":22713,"_15335":35289,"_1612":35630},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_8073":1060,"_22563":934,"_19084":35632,"_5":22713,"_15335":35293,"_1612":35633},[],"Caso",{"_8073":1061,"_22563":934,"_19084":35635,"_5":22713,"_15335":35293,"_1612":35636},[],"Credencial habitual",{"_8073":1062,"_22563":934,"_19084":35638,"_5":22713,"_15335":35293,"_1612":35639},[],"Endpoint principal",{"_8073":1063,"_22563":934,"_19084":35641,"_5":22713,"_15335":35293,"_1612":35642},[],"Resultado",{"_8073":1064,"_22563":934,"_19084":35644,"_5":22713,"_15335":35293,"_1612":35645},[],"Alta inicial",{"_8073":1065,"_22563":934,"_19084":35647,"_5":22713,"_15335":35293,"_1612":35648},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_8073":1066,"_22563":934,"_19084":35650,"_5":22713,"_15335":35293,"_1612":35310},[],{"_8073":1067,"_22563":934,"_19084":35652,"_5":22713,"_15335":35293,"_1612":35653},[],"Certificado de dispositivo",{"_8073":1068,"_22563":934,"_19084":35655,"_5":22713,"_15335":35293,"_1612":35656},[],"Renovación",{"_8073":1069,"_22563":934,"_19084":35658,"_5":22713,"_15335":35293,"_1612":35659},[],"Certificado actual del dispositivo",{"_8073":1070,"_22563":934,"_19084":35661,"_5":22713,"_15335":35293,"_1612":35314},[],{"_8073":1071,"_22563":934,"_19084":35663,"_5":22713,"_15335":35293,"_1612":35664},[],"Certificado renovado",{"_8073":1072,"_22563":934,"_19084":35666,"_5":22713,"_15335":35293,"_1612":35667},[],"Descarga de confianza",{"_8073":1073,"_22563":934,"_19084":35669,"_5":22713,"_15335":35293,"_1612":35670},[],"TLS del servidor",{"_8073":1074,"_22563":934,"_19084":35672,"_5":22713,"_15335":35293,"_1612":35306},[],{"_8073":1075,"_22563":934,"_19084":35674,"_5":22713,"_15335":35293,"_1612":35675},[],"PKCS#7 o PEM con certificados",{"_8073":1076,"_22563":934,"_19084":35677,"_5":22713,"_15335":35293,"_1612":35678},[],"Clave generada en servidor",{"_8073":1077,"_22563":934,"_19084":35680,"_5":22713,"_15335":35293,"_1612":35681},[],"Igual que `/simpleenroll`",{"_8073":1078,"_22563":934,"_19084":35683,"_5":22713,"_15335":35293,"_1612":35318},[],{"_8073":1079,"_22563":934,"_19084":35685,"_5":22713,"_15335":35293,"_1612":35686},[],"Clave privada PKCS#8 + certificado",{"_8073":1080,"_22563":934,"_19084":35688,"_5":22713,"_15335":35297,"_1612":35689},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_8073":1081,"_22563":934,"_19084":35691,"_5":22713,"_15335":35297,"_1612":35692},[],"Modo (`AuthMode`)",{"_8073":1082,"_22563":934,"_19084":35694,"_5":22713,"_15335":35297,"_1612":32632},[],{"_8073":1083,"_22563":934,"_19084":35696,"_5":22713,"_15335":35297,"_1612":35697},[],"Credencial esperada",{"_8073":1084,"_22563":934,"_19084":35699,"_5":22713,"_15335":35297,"_1612":35700},[],"Aplica en enroll",{"_8073":1085,"_22563":934,"_19084":35702,"_5":22713,"_15335":35297,"_1612":35703},[],"Aplica en reenroll",{"_8073":1086,"_22563":934,"_19084":35705,"_5":22713,"_15335":35297,"_1612":35444},[],{"_8073":1087,"_22563":934,"_19084":35707,"_5":22713,"_15335":35297,"_1612":35708},[],"mTLS con certificado X.509",{"_8073":1088,"_22563":934,"_19084":35710,"_5":22713,"_15335":35297,"_1612":35711},[],"Certificado y clave privada cliente",{"_8073":1089,"_22563":934,"_19084":35713,"_5":22713,"_15335":35297,"_1612":33776},[],{"_8073":1090,"_22563":934,"_19084":35715,"_5":22713,"_15335":35297,"_1612":35716},[],"Sí (con el certificado en vigor)",{"_8073":1091,"_22563":934,"_19084":35718,"_5":22713,"_15335":35297,"_1612":35456},[],{"_8073":1092,"_22563":934,"_19084":35720,"_5":22713,"_15335":35297,"_1612":35721},[],"mTLS más validación por webhook",{"_8073":1093,"_22563":934,"_19084":35723,"_5":22713,"_15335":35297,"_1612":35724},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_8073":1094,"_22563":934,"_19084":35726,"_5":22713,"_15335":35297,"_1612":33776},[],{"_8073":1095,"_22563":934,"_19084":35728,"_5":22713,"_15335":35297,"_1612":35729},[],"No como combinación; en reenroll no mantiene ambos controles",{"_8073":1096,"_22563":934,"_19084":35731,"_5":22713,"_15335":35297,"_1612":35450},[],{"_8073":1097,"_22563":934,"_19084":35733,"_5":22713,"_15335":35297,"_1612":35734},[],"Webhook externo de autorización",{"_8073":1098,"_22563":934,"_19084":35736,"_5":22713,"_15335":35297,"_1612":35737},[],"Ninguna en el canal TLS",{"_8073":1099,"_22563":934,"_19084":35739,"_5":22713,"_15335":35297,"_1612":33776},[],{"_8073":1100,"_22563":934,"_19084":35741,"_5":22713,"_15335":35297,"_1612":35742},[],"No, degrada a `NO_AUTH`",{"_8073":1101,"_22563":934,"_19084":35744,"_5":22713,"_15335":35297,"_1612":35462},[],{"_8073":1102,"_22563":934,"_19084":35746,"_5":22713,"_15335":35297,"_1612":35747},[],"Sin autenticación",{"_8073":1103,"_22563":934,"_19084":35749,"_5":22713,"_15335":35297,"_1612":35750},[],"Ninguna",{"_8073":1104,"_22563":934,"_19084":35752,"_5":22713,"_15335":35297,"_1612":35753},[],"Sí (uso restringido)",{"_8073":1105,"_22563":934,"_19084":35755,"_5":22713,"_15335":35297,"_1612":35753},[],{"_8073":1106,"_22563":934,"_19084":35757,"_5":22713,"_15335":35297,"_1612":35758},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_8073":1107,"_22563":934,"_19084":35760,"_5":22713,"_15335":35297,"_1612":35761},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_8073":1108,"_22563":934,"_19084":35763,"_5":22713,"_15335":35297,"_1612":33760},[],{"_8073":1109,"_22563":934,"_19084":35765,"_5":22713,"_15335":35297,"_1612":33763},[],{"_8073":1110,"_22563":934,"_19084":35767,"_5":22713,"_15335":35297,"_1612":32632},[],{"_8073":1111,"_22563":934,"_19084":35769,"_5":22713,"_15335":35297,"_1612":35770},[],"`ValidationCAs`",{"_8073":1112,"_22563":934,"_19084":35772,"_5":22713,"_15335":35297,"_1612":35773},[],"lista de IDs de CA",{"_8073":1113,"_22563":934,"_19084":35775,"_5":22713,"_15335":35297,"_1612":35776},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_8073":1114,"_22563":934,"_19084":35778,"_5":22713,"_15335":35297,"_1612":35779},[],"`AllowExpired`",{"_8073":1115,"_22563":934,"_19084":35781,"_5":22713,"_15335":35297,"_1612":20809},[],{"_8073":1116,"_22563":934,"_19084":35783,"_5":22713,"_15335":35297,"_1612":35784},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_8073":1117,"_22563":934,"_19084":35786,"_5":22713,"_15335":35297,"_1612":35787},[],"`ChainLevelValidation`",{"_8073":1118,"_22563":934,"_19084":35789,"_5":22713,"_15335":35297,"_1612":4360},[],{"_8073":1119,"_22563":934,"_19084":35791,"_5":22713,"_15335":35297,"_1612":35792},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_8073":1120,"_22563":934,"_19084":35794,"_5":22713,"_15335":35297,"_1612":35795},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_8073":1121,"_22563":934,"_19084":35797,"_5":22713,"_15335":35297,"_1612":35798},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_8073":1122,"_22563":934,"_19084":35800,"_5":22713,"_15335":35297,"_1612":35801},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_8073":1123,"_22563":934,"_19084":35803,"_5":22713,"_15335":35297,"_1612":35804},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_8073":1124,"_22563":934,"_19084":35806,"_5":22713,"_15335":35301,"_1612":35807},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_8073":1125,"_22563":934,"_19084":35809,"_5":22713,"_15335":35301,"_1612":35810},[],"`/cacerts`: descarga de la cadena de confianza.",{"_8073":1126,"_22563":934,"_19084":35812,"_5":22713,"_15335":35301,"_1612":35813},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_8073":1127,"_22563":934,"_19084":35815,"_5":22713,"_15335":35301,"_1612":35816},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_8073":1128,"_22563":934,"_19084":35818,"_5":22713,"_15335":35301,"_1612":35819},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_8073":1129,"_22563":934,"_19084":35821,"_5":22713,"_15335":35305,"_1612":35822},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_8073":1130,"_22563":934,"_19084":35824,"_5":22713,"_15335":35305,"_1612":35825},[],"Campo de `CADistributionSettings`",{"_8073":1131,"_22563":934,"_19084":35827,"_5":22713,"_15335":35305,"_1612":33763},[],{"_8073":1132,"_22563":934,"_19084":35829,"_5":22713,"_15335":35305,"_1612":32632},[],{"_8073":1133,"_22563":934,"_19084":35831,"_5":22713,"_15335":35305,"_1612":35832},[],"`IncludeLamassuSystemCA`",{"_8073":1134,"_22563":934,"_19084":35834,"_5":22713,"_15335":35305,"_1612":20809},[],{"_8073":1135,"_22563":934,"_19084":35836,"_5":22713,"_15335":35305,"_1612":35837},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_8073":1136,"_22563":934,"_19084":35839,"_5":22713,"_15335":35305,"_1612":35840},[],"`IncludeEnrollmentCA`",{"_8073":1137,"_22563":934,"_19084":35842,"_5":22713,"_15335":35305,"_1612":20809},[],{"_8073":1138,"_22563":934,"_19084":35844,"_5":22713,"_15335":35305,"_1612":35845},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_8073":1139,"_22563":934,"_19084":35847,"_5":22713,"_15335":35305,"_1612":35848},[],"`ManagedCAs`",{"_8073":1140,"_22563":934,"_19084":35850,"_5":22713,"_15335":35305,"_1612":35773},[],{"_8073":1141,"_22563":934,"_19084":35852,"_5":22713,"_15335":35305,"_1612":35853},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_8073":1142,"_22563":934,"_19084":35855,"_5":22713,"_15335":35305,"_1612":35856},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_8073":1143,"_22563":934,"_19084":35858,"_5":22713,"_15335":35305,"_1612":35859},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_8073":1144,"_22563":934,"_19084":35861,"_5":22713,"_15335":35305,"_1612":35862},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_8073":1145,"_22563":934,"_19084":35864,"_5":22713,"_15335":35305,"_1612":35865},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_8073":1146,"_22563":934,"_19084":35867,"_5":22713,"_15335":35309,"_1612":35868},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_8073":1147,"_22563":934,"_19084":35870,"_5":22713,"_15335":35309,"_1612":35871},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_8073":1148,"_22563":934,"_19084":35873,"_5":22713,"_15335":35309,"_1612":35874},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_8073":1149,"_22563":934,"_19084":35876,"_5":22713,"_15335":35309,"_1612":35501},[],{"_8073":1150,"_22563":934,"_19084":35878,"_5":22713,"_15335":35309,"_1612":33763},[],{"_8073":1151,"_22563":934,"_19084":35880,"_5":22713,"_15335":35309,"_1612":35881},[],"Efecto",{"_8073":1152,"_22563":934,"_19084":35883,"_5":22713,"_15335":35309,"_1612":35884},[],"`EnrollmentSettings.RegistrationMode`",{"_8073":1153,"_22563":934,"_19084":35886,"_5":22713,"_15335":35309,"_1612":35887},[],"`JITP` / `PRE_REGISTRATION`",{"_8073":1154,"_22563":934,"_19084":35889,"_5":22713,"_15335":35309,"_1612":35890},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_8073":1155,"_22563":934,"_19084":35892,"_5":22713,"_15335":35309,"_1612":35893},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_8073":1156,"_22563":934,"_19084":35895,"_5":22713,"_15335":35309,"_1612":20809},[],{"_8073":1157,"_22563":934,"_19084":35897,"_5":22713,"_15335":35309,"_1612":35898},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_8073":1158,"_22563":934,"_19084":35900,"_5":22713,"_15335":35309,"_1612":35901},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_8073":1159,"_22563":934,"_19084":35903,"_5":22713,"_15335":35309,"_1612":20809},[],{"_8073":1160,"_22563":934,"_19084":35905,"_5":22713,"_15335":35309,"_1612":35906},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_8073":1161,"_22563":934,"_19084":35908,"_5":22713,"_15335":35309,"_1612":35909},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_8073":1162,"_22563":934,"_19084":35911,"_5":22713,"_15335":35313,"_1612":35912},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_8073":1163,"_22563":934,"_19084":35914,"_5":22713,"_15335":35313,"_1612":35915},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_8073":1164,"_22563":934,"_19084":35917,"_5":22713,"_15335":35313,"_1612":35918},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_8073":1165,"_22563":934,"_19084":35920,"_5":22713,"_15335":35313,"_1612":35501},[],{"_8073":1166,"_22563":934,"_19084":35922,"_5":22713,"_15335":35313,"_1612":33763},[],{"_8073":1167,"_22563":934,"_19084":35924,"_5":22713,"_15335":35313,"_1612":35881},[],{"_8073":1168,"_22563":934,"_19084":35926,"_5":22713,"_15335":35313,"_1612":35927},[],"`ReEnrollmentDelta`",{"_8073":1169,"_22563":934,"_19084":35929,"_5":22713,"_15335":35313,"_1612":35930},[],"duración",{"_8073":1170,"_22563":934,"_19084":35932,"_5":22713,"_15335":35313,"_1612":35933},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_8073":1171,"_22563":934,"_19084":35935,"_5":22713,"_15335":35313,"_1612":35936},[],"`EnableExpiredRenewal`",{"_8073":1172,"_22563":934,"_19084":35938,"_5":22713,"_15335":35313,"_1612":20809},[],{"_8073":1173,"_22563":934,"_19084":35940,"_5":22713,"_15335":35313,"_1612":35941},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_8073":1174,"_22563":934,"_19084":35943,"_5":22713,"_15335":35313,"_1612":35944},[],"`RevokeOnReEnrollment`",{"_8073":1175,"_22563":934,"_19084":35946,"_5":22713,"_15335":35313,"_1612":20809},[],{"_8073":1176,"_22563":934,"_19084":35948,"_5":22713,"_15335":35313,"_1612":35949},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_8073":1177,"_22563":934,"_19084":35951,"_5":22713,"_15335":35313,"_1612":35952},[],"`AdditionalValidationCAs`",{"_8073":1178,"_22563":934,"_19084":35954,"_5":22713,"_15335":35313,"_1612":35773},[],{"_8073":1179,"_22563":934,"_19084":35956,"_5":22713,"_15335":35313,"_1612":35957},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_8073":1180,"_22563":934,"_19084":35959,"_5":22713,"_15335":35313,"_1612":35960},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_8073":1181,"_22563":934,"_19084":35962,"_5":22713,"_15335":35313,"_1612":35963},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_8073":1182,"_22563":934,"_19084":35965,"_5":22713,"_15335":35317,"_1612":35966},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_8073":1183,"_22563":934,"_19084":35968,"_5":22713,"_15335":35317,"_1612":35969},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_8073":1184,"_22563":934,"_19084":35971,"_5":22713,"_15335":35317,"_1612":35972},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_8073":1185,"_22563":934,"_19084":35974,"_5":22713,"_15335":35317,"_1612":35975},[],"Tipo de clave",{"_8073":1186,"_22563":934,"_19084":35977,"_5":22713,"_15335":35317,"_1612":35978},[],"Parámetro válido",{"_8073":1187,"_22563":934,"_19084":35980,"_5":22713,"_15335":35317,"_1612":35981},[],"Curva NIST equivalente",{"_8073":1188,"_22563":934,"_19084":35983,"_5":22713,"_15335":35317,"_1612":35984},[],"Comportamiento ante valores no válidos",{"_8073":1189,"_22563":934,"_19084":35986,"_5":22713,"_15335":35317,"_1612":35987},[],"`RSA`",{"_8073":1190,"_22563":934,"_19084":35989,"_5":22713,"_15335":35317,"_1612":35990},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_8073":1191,"_22563":934,"_19084":35992,"_5":22713,"_15335":35317,"_1612":35993},[],"No aplica",{"_8073":1192,"_22563":934,"_19084":35995,"_5":22713,"_15335":35317,"_1612":35996},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_8073":1193,"_22563":934,"_19084":35998,"_5":22713,"_15335":35317,"_1612":35999},[],"`ECDSA`",{"_8073":1194,"_22563":934,"_19084":36001,"_5":22713,"_15335":35317,"_1612":36002},[],"224, 256, 384, 521",{"_8073":1195,"_22563":934,"_19084":36004,"_5":22713,"_15335":35317,"_1612":36005},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_8073":1196,"_22563":934,"_19084":36007,"_5":22713,"_15335":35317,"_1612":36008},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_8073":1197,"_22563":934,"_19084":36010,"_5":22713,"_15335":35317,"_1612":36011},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_8073":1198,"_22563":934,"_19084":36013,"_5":22713,"_15335":35317,"_1612":36014},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_8073":1199,"_22563":934,"_19084":36016,"_5":22713,"_15335":35317,"_1612":36017},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_8073":1200,"_22563":934,"_19084":36019,"_5":22713,"_15335":35317,"_1612":36020},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_8073":1201,"_22563":934,"_19084":36022,"_5":22713,"_15335":35317,"_1612":36023},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_8073":1202,"_22563":934,"_19084":36025,"_5":22713,"_15335":35317,"_1612":36026},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_8073":1203,"_22563":934,"_19084":36028,"_5":22713,"_15335":35317,"_1612":36029},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_8073":1204,"_22563":934,"_19084":36031,"_5":22713,"_15335":35321,"_1612":36032},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_8073":1205,"_22563":934,"_19084":36034,"_5":22713,"_15335":35325,"_1612":36035},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_8073":1206,"_22563":934,"_19084":36037,"_5":22713,"_15335":35329,"_1612":36038},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_8073":1207,"_22563":934,"_19084":36040,"_5":22713,"_15335":35333,"_1612":36041},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_8073":1208,"_22563":934,"_19084":36043,"_5":22713,"_15335":35333,"_1612":36044},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_8073":1209,"_22563":934,"_19084":36046,"_5":22713,"_15335":35333,"_1612":36047},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_8073":1210,"_22563":934,"_19084":36049,"_5":22713,"_15335":35333,"_1612":36050},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_8073":1211,"_22563":934,"_19084":36052,"_5":22713,"_15335":35341,"_1612":36053},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_8073":1212,"_22563":934,"_19084":36055,"_5":22713,"_15335":35341,"_1612":36056},[],"HTTP",{"_8073":1213,"_22563":934,"_19084":36058,"_5":22713,"_15335":35341,"_1612":36059},[],"Mensaje",{"_8073":1214,"_22563":934,"_19084":36061,"_5":22713,"_15335":35341,"_1612":36062},[],"Causa",{"_8073":1215,"_22563":934,"_19084":36064,"_5":22713,"_15335":35341,"_1612":36065},[],"Acción del integrador",{"_8073":1216,"_22563":934,"_19084":36067,"_5":22713,"_15335":35341,"_1612":19910},[],{"_8073":1217,"_22563":934,"_19084":36069,"_5":22713,"_15335":35341,"_1612":36070},[],"`Field validation for 'APS' failed`",{"_8073":1218,"_22563":934,"_19084":36072,"_5":22713,"_15335":35341,"_1612":36073},[],"El segmento `{aps}` falta en la URL.",{"_8073":1219,"_22563":934,"_19084":36075,"_5":22713,"_15335":35341,"_1612":36076},[],"Incluir el ID del DMS en la ruta.",{"_8073":1220,"_22563":934,"_19084":36078,"_5":22713,"_15335":35341,"_1612":19910},[],{"_8073":1221,"_22563":934,"_19084":36080,"_5":22713,"_15335":35341,"_1612":36081},[],"`content-type must be application/pkcs10`",{"_8073":1222,"_22563":934,"_19084":36083,"_5":22713,"_15335":35341,"_1612":36084},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_8073":1223,"_22563":934,"_19084":36086,"_5":22713,"_15335":35341,"_1612":36087},[],"Fijar `Content-Type: application/pkcs10`.",{"_8073":1224,"_22563":934,"_19084":36089,"_5":22713,"_15335":35341,"_1612":19910},[],{"_8073":1225,"_22563":934,"_19084":36091,"_5":22713,"_15335":35341,"_1612":36092},[],"`body payload must be base64 encoded`",{"_8073":1226,"_22563":934,"_19084":36094,"_5":22713,"_15335":35341,"_1612":36095},[],"El cuerpo no es base64 válido.",{"_8073":1227,"_22563":934,"_19084":36097,"_5":22713,"_15335":35341,"_1612":36098},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_8073":1228,"_22563":934,"_19084":36100,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1229,"_22563":934,"_19084":36102,"_5":22713,"_15335":35341,"_1612":36103},[],"`DMS not found`",{"_8073":1230,"_22563":934,"_19084":36105,"_5":22713,"_15335":35341,"_1612":36106},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_8073":1231,"_22563":934,"_19084":36108,"_5":22713,"_15335":35341,"_1612":36109},[],"Verificar el identificador con el administrador PKI.",{"_8073":1232,"_22563":934,"_19084":36111,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1233,"_22563":934,"_19084":36113,"_5":22713,"_15335":35341,"_1612":36114},[],"`invalid certificate`",{"_8073":1234,"_22563":934,"_19084":36116,"_5":22713,"_15335":35341,"_1612":36117},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_8073":1235,"_22563":934,"_19084":36119,"_5":22713,"_15335":35341,"_1612":36120},[],"Comprobar la cadena del certificado bootstrap.",{"_8073":1236,"_22563":934,"_19084":36122,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1237,"_22563":934,"_19084":36124,"_5":22713,"_15335":35341,"_1612":36125},[],"`certificate is revoked`",{"_8073":1238,"_22563":934,"_19084":36127,"_5":22713,"_15335":35341,"_1612":36128},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_8073":1239,"_22563":934,"_19084":36130,"_5":22713,"_15335":35341,"_1612":36131},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_8073":1240,"_22563":934,"_19084":36133,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1241,"_22563":934,"_19084":36135,"_5":22713,"_15335":35341,"_1612":36136},[],"`revoked certificate`",{"_8073":1242,"_22563":934,"_19084":36138,"_5":22713,"_15335":35341,"_1612":36139},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_8073":1243,"_22563":934,"_19084":36141,"_5":22713,"_15335":35341,"_1612":36142},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_8073":1244,"_22563":934,"_19084":36144,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1245,"_22563":934,"_19084":36146,"_5":22713,"_15335":35341,"_1612":36147},[],"`expired certificate`",{"_8073":1246,"_22563":934,"_19084":36149,"_5":22713,"_15335":35341,"_1612":36150},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_8073":1247,"_22563":934,"_19084":36152,"_5":22713,"_15335":35341,"_1612":36153},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_8073":1248,"_22563":934,"_19084":36155,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1249,"_22563":934,"_19084":36157,"_5":22713,"_15335":35341,"_1612":36158},[],"`forbiddenNewEnrollment`",{"_8073":1250,"_22563":934,"_19084":36160,"_5":22713,"_15335":35341,"_1612":36161},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_8073":1251,"_22563":934,"_19084":36163,"_5":22713,"_15335":35341,"_1612":36164},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_8073":1252,"_22563":934,"_19084":36166,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1253,"_22563":934,"_19084":36168,"_5":22713,"_15335":35341,"_1612":36169},[],"`device not preregistered`",{"_8073":1254,"_22563":934,"_19084":36171,"_5":22713,"_15335":35341,"_1612":36172},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_8073":1255,"_22563":934,"_19084":36174,"_5":22713,"_15335":35341,"_1612":36175},[],"Registrar el dispositivo antes de inscribirlo.",{"_8073":1256,"_22563":934,"_19084":36177,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1257,"_22563":934,"_19084":36179,"_5":22713,"_15335":35341,"_1612":36180},[],"`invalid reenroll window`",{"_8073":1258,"_22563":934,"_19084":36182,"_5":22713,"_15335":35341,"_1612":36183},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_8073":1259,"_22563":934,"_19084":36185,"_5":22713,"_15335":35341,"_1612":36186},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_8073":1260,"_22563":934,"_19084":36188,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1261,"_22563":934,"_19084":36190,"_5":22713,"_15335":35341,"_1612":36191},[],"`invalid RawSubject bytes`",{"_8073":1262,"_22563":934,"_19084":36193,"_5":22713,"_15335":35341,"_1612":36194},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_8073":1263,"_22563":934,"_19084":36196,"_5":22713,"_15335":35341,"_1612":36197},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_8073":1264,"_22563":934,"_19084":36199,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1265,"_22563":934,"_19084":36201,"_5":22713,"_15335":35341,"_1612":36202},[],"`external webhook denied enrollment`",{"_8073":1266,"_22563":934,"_19084":36204,"_5":22713,"_15335":35341,"_1612":36205},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_8073":1267,"_22563":934,"_19084":36207,"_5":22713,"_15335":35341,"_1612":36208},[],"Revisar los logs del servicio webhook.",{"_8073":1268,"_22563":934,"_19084":36210,"_5":22713,"_15335":35341,"_1612":20445},[],{"_8073":1269,"_22563":934,"_19084":36212,"_5":22713,"_15335":35341,"_1612":36213},[],"`server key generation not enabled`",{"_8073":1270,"_22563":934,"_19084":36215,"_5":22713,"_15335":35341,"_1612":36216},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_8073":1271,"_22563":934,"_19084":36218,"_5":22713,"_15335":35341,"_1612":36219},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_8073":1272,"_22563":934,"_19084":36221,"_5":22713,"_15335":35341,"_1612":36222},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_8073":1273,"_22563":934,"_19084":36224,"_5":22713,"_15335":35345,"_1612":36225},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_8073":1274,"_22563":934,"_19084":36227,"_5":22713,"_15335":35345,"_1612":36228},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_8073":1275,"_22563":934,"_19084":36230,"_5":22713,"_15335":35345,"_1612":36231},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_8073":1276,"_22563":934,"_19084":36233,"_5":22713,"_15335":35345,"_1612":36234},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_8073":1277,"_22563":934,"_19084":36236,"_5":22713,"_15335":35345,"_1612":36237},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_8073":1278,"_22563":934,"_19084":36239,"_5":22713,"_15335":35345,"_1612":36240},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_8073":1279,"_22563":934,"_19084":36242,"_5":22713,"_15335":35345,"_1612":36243},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_8073":1280,"_22563":934,"_19084":36245,"_5":22713,"_15335":35345,"_1612":36246},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_8073":1281,"_22563":934,"_19084":36248,"_5":22713,"_15335":35345,"_1612":36249},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_8073":1282,"_22563":934,"_19084":36251,"_5":22713,"_15335":35345,"_1612":36252},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_8073":1283,"_22563":1283,"_5":22708,"_1612":36254,"_22721":36255,"_19084":36256,"_15335":1283},"[KMS] Gestión de Claves Criptográficas",[32429,33528,33537],[],{"_8073":1284,"_22563":1283,"_19084":36258,"_5":22713,"_15335":1283,"_1612":36259},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_8073":1285,"_22563":1283,"_5":22718,"_19084":36261,"_15335":36262,"_1612":36263},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_8073":1286,"_22563":1283,"_5":22718,"_19084":36265,"_15335":36266,"_1612":36267},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_8073":1287,"_22563":1283,"_5":22718,"_19084":36269,"_15335":36270,"_1612":36271},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_8073":1288,"_22563":1283,"_5":22718,"_19084":36273,"_15335":36274,"_1612":36275},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_8073":1289,"_22563":1283,"_5":22718,"_19084":36277,"_15335":36278,"_1612":36279},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_8073":1290,"_22563":1283,"_5":22718,"_19084":36281,"_15335":36282,"_1612":36283},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_8073":1291,"_22563":1283,"_5":22718,"_19084":36285,"_15335":36286,"_1612":36287},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_8073":1292,"_22563":1283,"_5":22718,"_19084":36289,"_15335":36290,"_1612":36291},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_8073":1293,"_22563":1283,"_5":22718,"_19084":36293,"_15335":36294,"_1612":36295},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_8073":1294,"_22563":1283,"_5":22718,"_19084":36297,"_15335":36298,"_1612":36299},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_8073":1295,"_22563":1283,"_5":22718,"_19084":36301,"_15335":36302,"_1612":36303},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#sign","Sign",{"_8073":1296,"_22563":1283,"_5":22718,"_19084":36305,"_15335":36306,"_1612":36307},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#verify","Verify",{"_8073":1297,"_22563":1283,"_5":22718,"_19084":36309,"_15335":36310,"_1612":36311},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_8073":1298,"_22563":1283,"_5":22718,"_19084":36313,"_15335":36314,"_1612":36315},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_8073":1299,"_22563":1283,"_19084":36317,"_5":22713,"_15335":36262,"_1612":36318},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_8073":1300,"_22563":1283,"_19084":36320,"_5":22713,"_15335":36262,"_1612":36321},[],"En la configuración actual, Lamassu IoT trabaja con claves asimétricas RSA y de curva elíptica (ECDSA), junto con Ed25519 y con los algoritmos post-cuánticos ML-DSA, SLH-DSA y las variantes híbridas Composite-ML-DSA. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_8073":1301,"_22563":1283,"_19084":36323,"_5":22713,"_15335":36266,"_1612":36324},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_8073":1302,"_22563":1283,"_19084":36326,"_5":22713,"_15335":36266,"_1612":36327},[],"En la práctica, permite:",{"_8073":1303,"_22563":1283,"_19084":36329,"_5":22713,"_15335":36266,"_1612":36330},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_8073":1304,"_22563":1283,"_19084":36332,"_5":22713,"_15335":36266,"_1612":36333},[],"Importar claves creadas externamente.",{"_8073":1305,"_22563":1283,"_19084":36335,"_5":22713,"_15335":36266,"_1612":36336},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_8073":1306,"_22563":1283,"_19084":36338,"_5":22713,"_15335":36266,"_1612":36339},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_8073":1307,"_22563":1283,"_19084":36341,"_5":22713,"_15335":36270,"_1612":36342},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_8073":1308,"_22563":1283,"_19084":36344,"_5":22713,"_15335":36270,"_1612":36345},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_8073":1309,"_22563":1283,"_19084":36347,"_5":22713,"_15335":36270,"_1612":36348},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_8073":1310,"_22563":1283,"_19084":36350,"_5":22713,"_15335":36270,"_1612":36351},[],"Crypto Engine",{"_8073":1311,"_22563":1283,"_19084":36353,"_5":22713,"_15335":36270,"_1612":36354},[],"Nivel de seguridad",{"_8073":1312,"_22563":1283,"_19084":36356,"_5":22713,"_15335":36270,"_1612":36357},[],"OnPrem / Cloud",{"_8073":1313,"_22563":1283,"_19084":36359,"_5":22713,"_15335":36270,"_1612":36360},[],"Coste adicional",{"_8073":1314,"_22563":1283,"_19084":36362,"_5":22713,"_15335":36270,"_1612":36363},[],"Generación de claves",{"_8073":1315,"_22563":1283,"_19084":36365,"_5":22713,"_15335":36270,"_1612":36366},[],"Persistencia *at-rest* segura",{"_8073":1316,"_22563":1283,"_19084":36368,"_5":22713,"_15335":36270,"_1612":36369},[],"Filtración de claves",{"_8073":1317,"_22563":1283,"_19084":36371,"_5":22713,"_15335":36270,"_1612":36372},[],"Consideraciones",{"_8073":1318,"_22563":1283,"_19084":36374,"_5":22713,"_15335":36270,"_1612":36375},[],"File System",{"_8073":1319,"_22563":1283,"_19084":36377,"_5":22713,"_15335":36270,"_1612":11435},[],{"_8073":1320,"_22563":1283,"_19084":36379,"_5":22713,"_15335":36270,"_1612":36380},[],"OnPrem y Cloud",{"_8073":1321,"_22563":1283,"_19084":36382,"_5":22713,"_15335":36270,"_1612":33828},[],{"_8073":1322,"_22563":1283,"_19084":36384,"_5":22713,"_15335":36270,"_1612":36385},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_8073":1323,"_22563":1283,"_19084":36387,"_5":22713,"_15335":36270,"_1612":36388},[],"**Insegura**. Delegada en el sistema de archivos.",{"_8073":1324,"_22563":1283,"_19084":36390,"_5":22713,"_15335":36270,"_1612":36388},[],{"_8073":1325,"_22563":1283,"_19084":36392,"_5":22713,"_15335":36270,"_1612":36393},[],"No recomendado para producción.",{"_8073":1326,"_22563":1283,"_19084":36395,"_5":22713,"_15335":36270,"_1612":36396},[],"HashiCorp Vault",{"_8073":1327,"_22563":1283,"_19084":36398,"_5":22713,"_15335":36270,"_1612":4075},[],{"_8073":1328,"_22563":1283,"_19084":36400,"_5":22713,"_15335":36270,"_1612":36380},[],{"_8073":1329,"_22563":1283,"_19084":36402,"_5":22713,"_15335":36270,"_1612":33828},[],{"_8073":1330,"_22563":1283,"_19084":36404,"_5":22713,"_15335":36270,"_1612":36405},[],"Depende de la configuración de Vault.",{"_8073":1331,"_22563":1283,"_19084":36407,"_5":22713,"_15335":36270,"_1612":36408},[],"**Segura**",{"_8073":1332,"_22563":1283,"_19084":36410,"_5":22713,"_15335":36270,"_1612":36411},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_8073":1333,"_22563":1283,"_19084":36413,"_5":22713,"_15335":36270,"_1612":36414},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_8073":1334,"_22563":1283,"_19084":36416,"_5":22713,"_15335":36270,"_1612":36417},[],"AWS Secrets Manager",{"_8073":1335,"_22563":1283,"_19084":36419,"_5":22713,"_15335":36270,"_1612":4075},[],{"_8073":1336,"_22563":1283,"_19084":36421,"_5":22713,"_15335":36270,"_1612":36422},[],"Cloud",{"_8073":1337,"_22563":1283,"_19084":36424,"_5":22713,"_15335":36270,"_1612":33776},[],{"_8073":1338,"_22563":1283,"_19084":36426,"_5":22713,"_15335":36270,"_1612":36427},[],"Depende del proceso de alta de la clave.",{"_8073":1339,"_22563":1283,"_19084":36429,"_5":22713,"_15335":36270,"_1612":36408},[],{"_8073":1340,"_22563":1283,"_19084":36431,"_5":22713,"_15335":36270,"_1612":36411},[],{"_8073":1341,"_22563":1283,"_19084":36433,"_5":22713,"_15335":36270,"_1612":36434},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_8073":1342,"_22563":1283,"_19084":36436,"_5":22713,"_15335":36270,"_1612":36437},[],"AWS KMS",{"_8073":1343,"_22563":1283,"_19084":36439,"_5":22713,"_15335":36270,"_1612":13605},[],{"_8073":1344,"_22563":1283,"_19084":36441,"_5":22713,"_15335":36270,"_1612":36422},[],{"_8073":1345,"_22563":1283,"_19084":36443,"_5":22713,"_15335":36270,"_1612":33776},[],{"_8073":1346,"_22563":1283,"_19084":36445,"_5":22713,"_15335":36270,"_1612":36446},[],"**Entropía hardware**",{"_8073":1347,"_22563":1283,"_19084":36448,"_5":22713,"_15335":36270,"_1612":36408},[],{"_8073":1348,"_22563":1283,"_19084":36450,"_5":22713,"_15335":36270,"_1612":36408},[],{"_8073":1349,"_22563":1283,"_19084":36452,"_5":22713,"_15335":36270,"_1612":36453},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_8073":1350,"_22563":1283,"_19084":36455,"_5":22713,"_15335":36270,"_1612":36456},[],"PKCS11",{"_8073":1351,"_22563":1283,"_19084":36458,"_5":22713,"_15335":36270,"_1612":36459},[],"3\\*",{"_8073":1352,"_22563":1283,"_19084":36461,"_5":22713,"_15335":36270,"_1612":36462},[],"AirGap OnPrem y Cloud",{"_8073":1353,"_22563":1283,"_19084":36464,"_5":22713,"_15335":36270,"_1612":36465},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_8073":1354,"_22563":1283,"_19084":36467,"_5":22713,"_15335":36270,"_1612":36446},[],{"_8073":1355,"_22563":1283,"_19084":36469,"_5":22713,"_15335":36270,"_1612":36470},[],"**Segura**\\*",{"_8073":1356,"_22563":1283,"_19084":36472,"_5":22713,"_15335":36270,"_1612":36473},[],"Depende del HSM",{"_8073":1357,"_22563":1283,"_19084":36475,"_5":22713,"_15335":36270,"_1612":36476},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_8073":1358,"_22563":1283,"_19084":36478,"_5":22713,"_15335":36270,"_1612":36479},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_8073":1359,"_22563":1283,"_19084":36481,"_5":22713,"_15335":36270,"_1612":36482},[],"Cada motor define qué algoritmos soporta y qué tamaños o parámetros de clave admite. El motor de software integrado soporta todos los tipos de la tabla siguiente; los motores externos pueden limitar el catálogo disponible, por lo que conviene comprobar las opciones que ofrece cada motor antes de crear o importar una clave.",{"_8073":1360,"_22563":1283,"_19084":36484,"_5":22713,"_15335":36270,"_1612":36485},[],"Key Type",{"_8073":1361,"_22563":1283,"_19084":36487,"_5":22713,"_15335":36270,"_1612":32632},[],{"_8073":1362,"_22563":1283,"_19084":36489,"_5":22713,"_15335":36270,"_1612":36490},[],"Key Size",{"_8073":1363,"_22563":1283,"_19084":36492,"_5":22713,"_15335":36270,"_1612":36493},[],"RSA",{"_8073":1364,"_22563":1283,"_19084":36495,"_5":22713,"_15335":36270,"_1612":36496},[],"RSA clásico",{"_8073":1365,"_22563":1283,"_19084":36498,"_5":22713,"_15335":36270,"_1612":36499},[],"1024, 2048, 3072, 4096 bits",{"_8073":1366,"_22563":1283,"_19084":36501,"_5":22713,"_15335":36270,"_1612":36502},[],"ECDSA",{"_8073":1367,"_22563":1283,"_19084":36504,"_5":22713,"_15335":36270,"_1612":36505},[],"Curvas elípticas clásicas",{"_8073":1368,"_22563":1283,"_19084":36507,"_5":22713,"_15335":36270,"_1612":36508},[],"224 (P-224), 256 (P-256), 384 (P-384), 521 (P-521)",{"_8073":1369,"_22563":1283,"_19084":36510,"_5":22713,"_15335":36270,"_1612":36511},[],"Ed25519",{"_8073":1370,"_22563":1283,"_19084":36513,"_5":22713,"_15335":36270,"_1612":36514},[],"EdDSA sobre Edwards25519",{"_8073":1371,"_22563":1283,"_19084":36516,"_5":22713,"_15335":36270,"_1612":36517},[],"256 (valor fijo)",{"_8073":1372,"_22563":1283,"_19084":36519,"_5":22713,"_15335":36270,"_1612":36520},[],"ML-DSA",{"_8073":1373,"_22563":1283,"_19084":36522,"_5":22713,"_15335":36270,"_1612":36523},[],"Post-cuántica basada en retículos",{"_8073":1374,"_22563":1283,"_19084":36525,"_5":22713,"_15335":36270,"_1612":36526},[],"44, 65, 87",{"_8073":1375,"_22563":1283,"_19084":36528,"_5":22713,"_15335":36270,"_1612":36529},[],"SLH-DSA",{"_8073":1376,"_22563":1283,"_19084":36531,"_5":22713,"_15335":36270,"_1612":36532},[],"Post-cuántica basada en hash",{"_8073":1377,"_22563":1283,"_19084":36534,"_5":22713,"_15335":36270,"_1612":36535},[],"Conjunto de parámetros del 1 al 12",{"_8073":1378,"_22563":1283,"_19084":36537,"_5":22713,"_15335":36270,"_1612":36538},[],"Composite-ML-DSA-RSA",{"_8073":1379,"_22563":1283,"_19084":36540,"_5":22713,"_15335":36270,"_1612":36541},[],"Híbrida: ML-DSA + RSA",{"_8073":1380,"_22563":1283,"_19084":36543,"_5":22713,"_15335":36270,"_1612":36544},[],"Variante del 1 al 8",{"_8073":1381,"_22563":1283,"_19084":36546,"_5":22713,"_15335":36270,"_1612":36547},[],"Composite-ML-DSA-ECDSA",{"_8073":1382,"_22563":1283,"_19084":36549,"_5":22713,"_15335":36270,"_1612":36550},[],"Híbrida: ML-DSA + ECDSA",{"_8073":1383,"_22563":1283,"_19084":36552,"_5":22713,"_15335":36270,"_1612":36553},[],"Variante del 9 al 13",{"_8073":1384,"_22563":1283,"_19084":36555,"_5":22713,"_15335":36270,"_1612":36556},[],"Composite-ML-DSA-Ed25519",{"_8073":1385,"_22563":1283,"_19084":36558,"_5":22713,"_15335":36270,"_1612":36559},[],"Híbrida: ML-DSA + Ed25519",{"_8073":1386,"_22563":1283,"_19084":36561,"_5":22713,"_15335":36270,"_1612":36562},[],"Variante del 14 al 15",{"_8073":1387,"_22563":1283,"_19084":36564,"_5":22713,"_15335":36270,"_1612":36565},[],"Sobre la columna **Key Size**:",{"_8073":1388,"_22563":1283,"_19084":36567,"_5":22713,"_15335":36270,"_1612":36568},[],"Para **SLH-DSA**, el tamaño identifica el conjunto de parámetros de firma. Por ejemplo, 1 corresponde a SHA2-128s y 5 a SHA2-256s.",{"_8073":1389,"_22563":1283,"_19084":36570,"_5":22713,"_15335":36270,"_1612":36571},[],"Para las claves **Composite-ML-DSA**, el tamaño identifica la variante concreta, que combina el componente post-cuántico con el clásico. Por ejemplo, la variante 1 corresponde a MLDSA44-RSA2048-PSS-SHA256, la 9 a MLDSA44-ECDSA-P256-SHA256 y la 14 a MLDSA44-Ed25519-SHA512. La variante debe pertenecer a la familia del tipo de clave (RSA, ECDSA o Ed25519).",{"_8073":1390,"_22563":1283,"_19084":36573,"_5":22713,"_15335":36270,"_1612":36574},[],"Una clave **Composite-ML-DSA** contiene un componente post-cuántico ML-DSA y un componente clásico, y firma con ambos a la vez.",{"_8073":1391,"_22563":1283,"_19084":36576,"_5":22713,"_15335":36270,"_1612":36577},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_8073":1392,"_22563":1283,"_19084":36579,"_5":22713,"_15335":36274,"_1612":36580},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_8073":1393,"_22563":1283,"_19084":36582,"_5":22713,"_15335":36274,"_1612":36583},[],"La tabla incluye los siguientes campos:",{"_8073":1394,"_22563":1283,"_19084":36585,"_5":22713,"_15335":36274,"_1612":36586},[],"**Name**: nombre descriptivo de la clave.",{"_8073":1395,"_22563":1283,"_19084":36588,"_5":22713,"_15335":36274,"_1612":36589},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048, EC P-256 o ML-DSA 65.",{"_8073":1396,"_22563":1283,"_19084":36591,"_5":22713,"_15335":36274,"_1612":36592},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_8073":1397,"_22563":1283,"_19084":36594,"_5":22713,"_15335":36274,"_1612":36595},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_8073":1398,"_22563":1283,"_19084":36597,"_5":22713,"_15335":36274,"_1612":36598},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_8073":1399,"_22563":1283,"_19084":36600,"_5":22713,"_15335":36274,"_1612":36601},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_8073":1400,"_22563":1283,"_19084":36603,"_5":22713,"_15335":36274,"_1612":36604},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_8073":1401,"_22563":1283,"_19084":36606,"_5":22713,"_15335":36274,"_1612":36607},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_8073":1402,"_22563":1283,"_19084":36609,"_5":22713,"_15335":36274,"_1612":36610},[],"Desde esta vista también se accede a las acciones más habituales:",{"_8073":1403,"_22563":1283,"_19084":36612,"_5":22713,"_15335":36274,"_1612":36613},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_8073":1404,"_22563":1283,"_19084":36615,"_5":22713,"_15335":36274,"_1612":36616},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_8073":1405,"_22563":1283,"_19084":36618,"_5":22713,"_15335":36274,"_1612":36619},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_8073":1406,"_22563":1283,"_19084":36621,"_5":22713,"_15335":36274,"_1612":36622},[],"**Delete Key** para eliminar la clave del sistema.",{"_8073":1407,"_22563":1283,"_19084":36624,"_5":22713,"_15335":36278,"_1612":36625},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_8073":1408,"_22563":1283,"_19084":36627,"_5":22713,"_15335":36282,"_1612":36628},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_8073":1409,"_22563":1283,"_19084":36630,"_5":22713,"_15335":36282,"_1612":36631},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_8073":1410,"_22563":1283,"_19084":36633,"_5":22713,"_15335":36282,"_1612":36634},[],"**Key Name**: nombre único y descriptivo.",{"_8073":1411,"_22563":1283,"_19084":36636,"_5":22713,"_15335":36282,"_1612":36637},[],"**Crypto Engine**: motor que custodiará la clave.",{"_8073":1412,"_22563":1283,"_19084":36639,"_5":22713,"_15335":36282,"_1612":36640},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva. Las opciones disponibles dependen del motor seleccionado; consulte la tabla de tipos de clave de la sección de motores criptográficos.",{"_8073":1413,"_22563":1283,"_19084":36642,"_5":22713,"_15335":36282,"_1612":36643},[],"**Tags**: metadatos para clasificar la clave.",{"_8073":1414,"_22563":1283,"_19084":36645,"_5":22713,"_15335":36282,"_1612":36646},[],"**Metadata**: información adicional para usos avanzados.",{"_8073":1415,"_22563":1283,"_19084":36648,"_5":22713,"_15335":36286,"_1612":36649},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_8073":1416,"_22563":1283,"_19084":36651,"_5":22713,"_15335":36286,"_1612":36652},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_8073":1417,"_22563":1283,"_19084":36654,"_5":22713,"_15335":36286,"_1612":36655},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_8073":1418,"_22563":1283,"_19084":36657,"_5":22713,"_15335":36286,"_1612":36658},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_8073":1419,"_22563":1283,"_19084":36660,"_5":22713,"_15335":36286,"_1612":36661},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_8073":1420,"_22563":1283,"_19084":36663,"_5":22713,"_15335":36286,"_1612":36664},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_8073":1421,"_22563":1283,"_19084":36666,"_5":22713,"_15335":36286,"_1612":36667},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_8073":1422,"_22563":1283,"_19084":36669,"_5":22713,"_15335":36286,"_1612":36670},[],"**Tags**: etiquetas para organización y búsqueda.",{"_8073":1423,"_22563":1283,"_19084":36672,"_5":22713,"_15335":36286,"_1612":36673},[],"**Metadata**: información adicional opcional.",{"_8073":1424,"_22563":1283,"_19084":36675,"_5":22713,"_15335":36286,"_1612":36676},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_8073":1425,"_22563":1283,"_19084":36678,"_5":22713,"_15335":36286,"_1612":36679},[],"La clave privada debe seguir el formato PKCS#8. Además de RSA y ECDSA, se pueden importar claves Ed25519, ML-DSA, SLH-DSA y Composite-ML-DSA cuando el motor seleccionado las admite; el algoritmo y el tamaño se detectan automáticamente a partir del material importado.",{"_8073":1426,"_22563":1283,"_19084":36681,"_5":22713,"_15335":36286,"_1612":36682},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_8073":1427,"_22563":1283,"_19084":36684,"_5":22713,"_15335":36290,"_1612":36685},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_8073":1428,"_22563":1283,"_19084":36687,"_5":22713,"_15335":36294,"_1612":36688},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_8073":1429,"_22563":1283,"_19084":36690,"_5":22713,"_15335":36294,"_1612":36691},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_8073":1430,"_22563":1283,"_19084":36693,"_5":22713,"_15335":36294,"_1612":36694},[],"**Key Name**: nombre descriptivo.",{"_8073":1431,"_22563":1283,"_19084":36696,"_5":22713,"_15335":36294,"_1612":36697},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_8073":1432,"_22563":1283,"_19084":36699,"_5":22713,"_15335":36294,"_1612":36700},[],"**Tags**: etiquetas asociadas.",{"_8073":1433,"_22563":1283,"_19084":36702,"_5":22713,"_15335":36294,"_1612":36703},[],"**Aliases**: nombres alternativos.",{"_8073":1434,"_22563":1283,"_19084":36705,"_5":22713,"_15335":36294,"_1612":36706},[],"**Crypto Engine**: motor en el que reside la clave.",{"_8073":1435,"_22563":1283,"_19084":36708,"_5":22713,"_15335":36294,"_1612":36709},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_8073":1436,"_22563":1283,"_19084":36711,"_5":22713,"_15335":36294,"_1612":36712},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_8073":1437,"_22563":1283,"_19084":36714,"_5":22713,"_15335":36294,"_1612":36715},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_8073":1438,"_22563":1283,"_19084":36717,"_5":22713,"_15335":36298,"_1612":36718},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_8073":1439,"_22563":1283,"_19084":36720,"_5":22713,"_15335":36298,"_1612":36721},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_8073":1440,"_22563":1283,"_19084":36723,"_5":22713,"_15335":36298,"_1612":36724},[],"Los algoritmos de firma para claves post-cuánticas y Ed25519 siguen la convención *PURE* (por ejemplo, `MLDSA_65_PURE`, `Ed25519_PURE` o `COMPOSITE_MLDSA_ED25519_PURE`). En estos modos el mensaje se procesa tal cual, sin calcular previamente un *digest*, de modo que el campo **Message Type** no es aplicable.",{"_8073":1441,"_22563":1283,"_19084":36726,"_5":22713,"_15335":36302,"_1612":36727},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_8073":1442,"_22563":1283,"_19084":36729,"_5":22713,"_15335":36302,"_1612":36730},[],"Campos principales:",{"_8073":1443,"_22563":1283,"_19084":36732,"_5":22713,"_15335":36302,"_1612":36733},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_8073":1444,"_22563":1283,"_19084":36735,"_5":22713,"_15335":36302,"_1612":36736},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_8073":1445,"_22563":1283,"_19084":36738,"_5":22713,"_15335":36302,"_1612":36739},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_8073":1446,"_22563":1283,"_19084":36741,"_5":22713,"_15335":36302,"_1612":36742},[],"**Message**: contenido que se va a firmar.",{"_8073":1447,"_22563":1283,"_19084":36744,"_5":22713,"_15335":36302,"_1612":36745},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_8073":1448,"_22563":1283,"_19084":36747,"_5":22713,"_15335":36306,"_1612":36748},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_8073":1449,"_22563":1283,"_19084":36750,"_5":22713,"_15335":36306,"_1612":36730},[],{"_8073":1450,"_22563":1283,"_19084":36752,"_5":22713,"_15335":36306,"_1612":36753},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_8073":1451,"_22563":1283,"_19084":36755,"_5":22713,"_15335":36306,"_1612":36756},[],"**Message Type**: `Raw` o `Digest`.",{"_8073":1452,"_22563":1283,"_19084":36758,"_5":22713,"_15335":36306,"_1612":36759},[],"**Payload Encoding**: codificación del mensaje.",{"_8073":1453,"_22563":1283,"_19084":36761,"_5":22713,"_15335":36306,"_1612":36762},[],"**Message**: mensaje original o hash.",{"_8073":1454,"_22563":1283,"_19084":36764,"_5":22713,"_15335":36306,"_1612":36765},[],"**Signature**: firma que se desea comprobar.",{"_8073":1455,"_22563":1283,"_19084":36767,"_5":22713,"_15335":36306,"_1612":36768},[],"**Result**: indicador del resultado de la validación.",{"_8073":1456,"_22563":1283,"_19084":36770,"_5":22713,"_15335":36310,"_1612":36771},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_8073":1457,"_22563":1283,"_19084":36773,"_5":22713,"_15335":36310,"_1612":36774},[],"Este flujo es útil para:",{"_8073":1458,"_22563":1283,"_19084":36776,"_5":22713,"_15335":36310,"_1612":36777},[],"Solicitar certificados a una CA externa.",{"_8073":1459,"_22563":1283,"_19084":36779,"_5":22713,"_15335":36310,"_1612":36780},[],"Renovar una identidad manteniendo la misma clave.",{"_8073":1460,"_22563":1283,"_19084":36782,"_5":22713,"_15335":36310,"_1612":36783},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_8073":1461,"_22563":1283,"_19084":36785,"_5":22713,"_15335":36310,"_1612":36786},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_8073":1462,"_22563":1283,"_19084":36788,"_5":22713,"_15335":36310,"_1612":36789},[],"**Organization (O)**: organización o empresa.",{"_8073":1463,"_22563":1283,"_19084":36791,"_5":22713,"_15335":36310,"_1612":36792},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_8073":1464,"_22563":1283,"_19084":36794,"_5":22713,"_15335":36310,"_1612":36795},[],"**Country (C)**: código de país de dos letras.",{"_8073":1465,"_22563":1283,"_19084":36797,"_5":22713,"_15335":36310,"_1612":36798},[],"**State / Province (ST)**: estado o provincia.",{"_8073":1466,"_22563":1283,"_19084":36800,"_5":22713,"_15335":36310,"_1612":36801},[],"**Locality (L)**: ciudad o localidad.",{"_8073":1467,"_22563":1283,"_19084":36803,"_5":22713,"_15335":36310,"_1612":36804},[],"**Email Address**: correo de contacto.",{"_8073":1468,"_22563":1283,"_19084":36806,"_5":22713,"_15335":36310,"_1612":36807},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_8073":1469,"_22563":1283,"_19084":36809,"_5":22713,"_15335":36310,"_1612":36810},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_8073":1470,"_22563":1283,"_19084":36812,"_5":22713,"_15335":36314,"_1612":36813},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_8073":1471,"_22563":1283,"_19084":36815,"_5":22713,"_15335":36314,"_1612":36816},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_8073":1472,"_22563":1472,"_5":22708,"_1612":36818,"_22721":36819,"_19084":36820,"_15335":1472},"[DMS] Device Management Service",[32429,33528,33537],[],{"_8073":1473,"_22563":1472,"_19084":36822,"_5":22713,"_15335":1472,"_1612":36823},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_8073":1474,"_22563":1472,"_5":22718,"_19084":36825,"_15335":36826,"_1612":36827},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#device-management-service","Device Management Service",{"_8073":1475,"_22563":1472,"_5":22718,"_19084":36829,"_15335":36830,"_1612":35290},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#antes-de-empezar",{"_8073":1476,"_22563":1472,"_5":22718,"_19084":36832,"_15335":36833,"_1612":36834},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_8073":1477,"_22563":1472,"_5":22718,"_19084":36836,"_15335":36837,"_1612":36838},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_8073":1478,"_22563":1472,"_5":22718,"_19084":36840,"_15335":36841,"_1612":36842},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_8073":1479,"_22563":1472,"_19084":36844,"_5":22713,"_15335":36826,"_1612":36845},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_8073":1480,"_22563":1472,"_19084":36847,"_5":22713,"_15335":36826,"_1612":36848},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_8073":1481,"_22563":1472,"_19084":36850,"_5":22713,"_15335":36830,"_1612":36851},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_8073":1482,"_22563":1472,"_19084":36853,"_5":22713,"_15335":36833,"_1612":36854},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_8073":1483,"_22563":1472,"_19084":36856,"_5":22713,"_15335":36833,"_1612":36857},[],"Acción",{"_8073":1484,"_22563":1472,"_19084":36859,"_5":22713,"_15335":36833,"_1612":32632},[],{"_8073":1485,"_22563":1472,"_19084":36861,"_5":22713,"_15335":36833,"_1612":36862},[],"**Edit**",{"_8073":1486,"_22563":1472,"_19084":36864,"_5":22713,"_15335":36833,"_1612":36865},[],"Modifica la configuración del DMS.",{"_8073":1487,"_22563":1472,"_19084":36867,"_5":22713,"_15335":36833,"_1612":36868},[],"**Go to DMS owned devices**",{"_8073":1488,"_22563":1472,"_19084":36870,"_5":22713,"_15335":36833,"_1612":36871},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_8073":1489,"_22563":1472,"_19084":36873,"_5":22713,"_15335":36833,"_1612":36874},[],"**Show/Edit Metadata**",{"_8073":1490,"_22563":1472,"_19084":36876,"_5":22713,"_15335":36833,"_1612":36877},[],"Accede a los metadatos del DMS para usos avanzados.",{"_8073":1491,"_22563":1472,"_19084":36879,"_5":22713,"_15335":36833,"_1612":36880},[],"**EST (RFC-7030)**",{"_8073":1492,"_22563":1472,"_19084":36882,"_5":22713,"_15335":36833,"_1612":36883},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_8073":1493,"_22563":1472,"_19084":36885,"_5":22713,"_15335":36833,"_1612":36886},[],"**Delete**",{"_8073":1494,"_22563":1472,"_19084":36888,"_5":22713,"_15335":36833,"_1612":36889},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_8073":1495,"_22563":1472,"_19084":36891,"_5":22713,"_15335":36837,"_1612":36892},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_8073":1496,"_22563":1472,"_19084":36894,"_5":22713,"_15335":36837,"_1612":33760},[],{"_8073":1497,"_22563":1472,"_19084":36896,"_5":22713,"_15335":36837,"_1612":32632},[],{"_8073":1498,"_22563":1472,"_19084":36898,"_5":22713,"_15335":36837,"_1612":36899},[],"**Include Lamassu System CA**",{"_8073":1499,"_22563":1472,"_19084":36901,"_5":22713,"_15335":36837,"_1612":36902},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_8073":1500,"_22563":1472,"_19084":36904,"_5":22713,"_15335":36837,"_1612":36905},[],"**Include Enrollment CA**",{"_8073":1501,"_22563":1472,"_19084":36907,"_5":22713,"_15335":36837,"_1612":36908},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_8073":1502,"_22563":1472,"_19084":36910,"_5":22713,"_15335":36837,"_1612":36911},[],"**Managed CAs**",{"_8073":1503,"_22563":1472,"_19084":36913,"_5":22713,"_15335":36837,"_1612":36914},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_8073":1504,"_22563":1472,"_19084":36916,"_5":22713,"_15335":36841,"_1612":36917},[],"El DMS expone un protocolo de enrolamiento a los dispositivos. En la versión actual de Lamassu, el único protocolo soportado es &#x2A;*EST (RFC 7030)**. La configuración del protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_8073":1505,"_22563":1472,"_19084":36919,"_5":22713,"_15335":36841,"_1612":36920},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_8073":1506,"_22563":1472,"_19084":36922,"_5":22713,"_15335":36841,"_1612":36252},[],{"_8073":1507,"_22563":1507,"_5":22708,"_1612":36924,"_22721":36925,"_19084":36926,"_15335":1507},"[VA] Servicio CRL",[32429,33528,33537],[],{"_8073":1508,"_22563":1507,"_19084":36928,"_5":22713,"_15335":1507,"_1612":36929},[],"Gestión y consulta de listas de revocación para validación offline",{"_8073":1509,"_22563":1507,"_5":22718,"_19084":36931,"_15335":36932,"_1612":36933},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_8073":1510,"_22563":1507,"_5":22718,"_19084":36935,"_15335":36936,"_1612":36937},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_8073":1511,"_22563":1507,"_5":22718,"_19084":36939,"_15335":36940,"_1612":36941},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_8073":1512,"_22563":1507,"_5":22718,"_19084":36943,"_15335":36944,"_1612":36945},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_8073":1513,"_22563":1507,"_5":22718,"_19084":36947,"_15335":36948,"_1612":36949},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_8073":1514,"_22563":1507,"_5":22718,"_19084":36951,"_15335":36952,"_1612":36953},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_8073":1515,"_22563":1507,"_5":22718,"_19084":36955,"_15335":36956,"_1612":36957},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_8073":1516,"_22563":1507,"_5":22718,"_19084":36959,"_15335":36960,"_1612":36961},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#referencias","Referencias",{"_8073":1517,"_22563":1507,"_19084":36963,"_5":22713,"_15335":36932,"_1612":36964},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_8073":1518,"_22563":1507,"_19084":36966,"_5":22713,"_15335":36932,"_1612":36967},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_8073":1519,"_22563":1507,"_19084":36969,"_5":22713,"_15335":36936,"_1612":36970},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_8073":1520,"_22563":1507,"_19084":36972,"_5":22713,"_15335":36936,"_1612":36973},[],"Los parámetros principales son:",{"_8073":1521,"_22563":1507,"_19084":36975,"_5":22713,"_15335":36936,"_1612":33760},[],{"_8073":1522,"_22563":1507,"_19084":36977,"_5":22713,"_15335":36936,"_1612":32629},[],{"_8073":1523,"_22563":1507,"_19084":36979,"_5":22713,"_15335":36936,"_1612":32632},[],{"_8073":1524,"_22563":1507,"_19084":36981,"_5":22713,"_15335":36936,"_1612":36982},[],"`validity`",{"_8073":1525,"_22563":1507,"_19084":36984,"_5":22713,"_15335":36936,"_1612":36985},[],"7 días",{"_8073":1526,"_22563":1507,"_19084":36987,"_5":22713,"_15335":36936,"_1612":36988},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_8073":1527,"_22563":1507,"_19084":36990,"_5":22713,"_15335":36936,"_1612":36991},[],"`refresh_interval`",{"_8073":1528,"_22563":1507,"_19084":36993,"_5":22713,"_15335":36936,"_1612":36994},[],"\\~6 días y 23 horas",{"_8073":1529,"_22563":1507,"_19084":36996,"_5":22713,"_15335":36936,"_1612":36997},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_8073":1530,"_22563":1507,"_19084":36999,"_5":22713,"_15335":36936,"_1612":37000},[],"`regenerate_on_revoke`",{"_8073":1531,"_22563":1507,"_19084":37002,"_5":22713,"_15335":36936,"_1612":37003},[],"`true`",{"_8073":1532,"_22563":1507,"_19084":37005,"_5":22713,"_15335":36936,"_1612":37006},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_8073":1533,"_22563":1507,"_19084":37008,"_5":22713,"_15335":36936,"_1612":37009},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_8073":1534,"_22563":1507,"_19084":37011,"_5":22713,"_15335":36936,"_1612":37012},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_8073":1535,"_22563":1507,"_19084":37014,"_5":22713,"_15335":36940,"_1612":37015},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_8073":1536,"_22563":1507,"_19084":37017,"_5":22713,"_15335":36940,"_1612":37018},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_8073":1537,"_22563":1507,"_19084":37020,"_5":22713,"_15335":36944,"_1612":37021},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_8073":1538,"_22563":1507,"_19084":37023,"_5":22713,"_15335":36944,"_1612":37024},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_8073":1539,"_22563":1507,"_19084":37026,"_5":22713,"_15335":36948,"_1612":37027},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_8073":1540,"_22563":1507,"_19084":37029,"_5":22713,"_15335":36948,"_1612":37030},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_8073":1541,"_22563":1507,"_19084":37032,"_5":22713,"_15335":36952,"_1612":37033},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_8073":1542,"_22563":1507,"_19084":37035,"_5":22713,"_15335":36952,"_1612":37036},[],"Método",{"_8073":1543,"_22563":1507,"_19084":37038,"_5":22713,"_15335":36952,"_1612":37039},[],"Ruta",{"_8073":1544,"_22563":1507,"_19084":37041,"_5":22713,"_15335":36952,"_1612":32632},[],{"_8073":1545,"_22563":1507,"_19084":37043,"_5":22713,"_15335":36952,"_1612":37044},[],"`GET`",{"_8073":1546,"_22563":1507,"_19084":37046,"_5":22713,"_15335":36952,"_1612":37047},[],"`/v1/roles/{ca-ski}`",{"_8073":1547,"_22563":1507,"_19084":37049,"_5":22713,"_15335":36952,"_1612":37050},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_8073":1548,"_22563":1507,"_19084":37052,"_5":22713,"_15335":36952,"_1612":37053},[],"`PUT`",{"_8073":1549,"_22563":1507,"_19084":37055,"_5":22713,"_15335":36952,"_1612":37047},[],{"_8073":1550,"_22563":1507,"_19084":37057,"_5":22713,"_15335":36952,"_1612":37058},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_8073":1551,"_22563":1507,"_19084":37060,"_5":22713,"_15335":36952,"_1612":37061},[],"Ejemplo de consulta del rol VA:",{"_8073":1552,"_22563":1507,"_19084":37063,"_5":22713,"_15335":36952,"_1612":37064},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_8073":1553,"_22563":1507,"_19084":37066,"_5":22713,"_15335":36956,"_1612":37067},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_8073":1554,"_22563":1507,"_19084":37069,"_5":22713,"_15335":36960,"_1612":37070},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_8073":1555,"_22563":1507,"_19084":37072,"_5":22713,"_15335":36960,"_1612":37073},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_8073":1556,"_22563":1507,"_19084":37075,"_5":22713,"_15335":36960,"_1612":37076},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_8073":1557,"_22563":1557,"_5":22708,"_1612":37078,"_22721":37079,"_19084":37080,"_15335":1557},"[VA] Servicio OCSP",[32429,33528,33537],[],{"_8073":1558,"_22563":1557,"_19084":37082,"_5":22713,"_15335":1557,"_1612":37083},[],"Validación online del estado de certificados mediante OCSP",{"_8073":1559,"_22563":1557,"_5":22718,"_19084":37085,"_15335":37086,"_1612":37087},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_8073":1560,"_22563":1557,"_5":22718,"_19084":37089,"_15335":37090,"_1612":37091},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_8073":1561,"_22563":1557,"_5":22718,"_19084":37093,"_15335":37094,"_1612":37095},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_8073":1562,"_22563":1557,"_5":22718,"_19084":37097,"_15335":37098,"_1612":37099},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_8073":1563,"_22563":1557,"_5":22718,"_19084":37101,"_15335":37102,"_1612":37103},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_8073":1564,"_22563":1557,"_5":22718,"_19084":37105,"_15335":37106,"_1612":36961},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#referencias",{"_8073":1565,"_22563":1557,"_19084":37108,"_5":22713,"_15335":37086,"_1612":37109},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_8073":1566,"_22563":1557,"_19084":37111,"_5":22713,"_15335":37086,"_1612":37112},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_8073":1567,"_22563":1557,"_19084":37114,"_5":22713,"_15335":37090,"_1612":37115},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_8073":1568,"_22563":1557,"_19084":37117,"_5":22713,"_15335":37090,"_1612":37118},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_8073":1569,"_22563":1557,"_19084":37120,"_5":22713,"_15335":37090,"_1612":37121},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_8073":1570,"_22563":1557,"_19084":37123,"_5":22713,"_15335":37090,"_1612":37124},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_8073":1571,"_22563":1557,"_19084":37126,"_5":22713,"_15335":37090,"_1612":37127},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_8073":1572,"_22563":1557,"_19084":37129,"_5":22713,"_15335":37090,"_1612":37130},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_8073":1573,"_22563":1557,"_19084":37132,"_5":22713,"_15335":37094,"_1612":37133},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_8073":1574,"_22563":1557,"_19084":37135,"_5":22713,"_15335":37098,"_1612":37136},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_8073":1575,"_22563":1557,"_19084":37138,"_5":22713,"_15335":37098,"_1612":37036},[],{"_8073":1576,"_22563":1557,"_19084":37140,"_5":22713,"_15335":37098,"_1612":37039},[],{"_8073":1577,"_22563":1557,"_19084":37142,"_5":22713,"_15335":37098,"_1612":32632},[],{"_8073":1578,"_22563":1557,"_19084":37144,"_5":22713,"_15335":37098,"_1612":37044},[],{"_8073":1579,"_22563":1557,"_19084":37146,"_5":22713,"_15335":37098,"_1612":37147},[],"`/ocsp/{ocsp_request}`",{"_8073":1580,"_22563":1557,"_19084":37149,"_5":22713,"_15335":37098,"_1612":37150},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_8073":1581,"_22563":1557,"_19084":37152,"_5":22713,"_15335":37098,"_1612":37153},[],"`POST`",{"_8073":1582,"_22563":1557,"_19084":37155,"_5":22713,"_15335":37098,"_1612":37156},[],"`/ocsp`",{"_8073":1583,"_22563":1557,"_19084":37158,"_5":22713,"_15335":37098,"_1612":37159},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_8073":1584,"_22563":1557,"_19084":37161,"_5":22713,"_15335":37098,"_1612":37162},[],"Ejemplo de consulta con `curl` mediante POST:",{"_8073":1585,"_22563":1557,"_19084":37164,"_5":22713,"_15335":37098,"_1612":37165},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_8073":1586,"_22563":1557,"_19084":37167,"_5":22713,"_15335":37102,"_1612":37168},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_8073":1587,"_22563":1557,"_19084":37170,"_5":22713,"_15335":37106,"_1612":37171},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_8073":1588,"_22563":1557,"_19084":37173,"_5":22713,"_15335":37106,"_1612":37174},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_8073":1589,"_22563":1557,"_19084":37176,"_5":22713,"_15335":37106,"_1612":37177},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_8073":1590,"_22563":1557,"_19084":37179,"_5":22713,"_15335":37106,"_1612":37076},[],{"_8073":1591,"_22563":1591,"_5":22708,"_1612":37181,"_22721":37182,"_19084":37183,"_15335":1591},"[VA] Validación de Certificados",[32429,33528,33537],[],{"_8073":1592,"_22563":1591,"_19084":37185,"_5":22713,"_15335":1591,"_1612":37186},[],"Servicios OCSP y CRL para validación de certificados",{"_8073":1593,"_22563":1591,"_5":22718,"_19084":37188,"_15335":37189,"_1612":37190},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_8073":1594,"_22563":1591,"_19084":37192,"_5":22713,"_15335":37189,"_1612":37193},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_8073":1595,"_22563":1591,"_19084":37195,"_5":22713,"_15335":37189,"_1612":37196},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_8073":1596,"_22563":1591,"_19084":37198,"_5":22713,"_15335":37189,"_1612":37199},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_8073":1597,"_22563":1591,"_19084":37201,"_5":22713,"_15335":37189,"_1612":37202},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_8073":1598,"_22563":1598,"_5":22708,"_1612":37204,"_19084":37205,"_15335":1598},"Test",[],{"_8073":1599,"_22563":1598,"_19084":37207,"_5":22713,"_15335":1598,"_1612":37208},[],"A document to test Fumadocs",{"_8073":1600,"_22563":1598,"_5":22718,"_19084":37210,"_15335":37211,"_1612":37212},[],"/docs/pr-preview/pr-25/test#cards","Cards",{"_8073":1601,"_22563":1598,"_5":22718,"_19084":37214,"_15335":37215,"_1612":37216},[],"/docs/pr-preview/pr-25/test#codeblock","CodeBlock",{"_8073":1602,"_22563":1598,"_5":22718,"_19084":37218,"_15335":37219,"_1612":37220},[],"/docs/pr-preview/pr-25/test#list","List",{"_8073":1603,"_22563":1598,"_19084":37222,"_5":22713,"_15335":1598,"_1612":37223},[],"Hey there!",{"_8073":1604,"_22563":1598,"_19084":37225,"_5":22713,"_15335":37211,"_1612":37226},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_8073":1605,"_22563":1598,"_19084":37228,"_5":22713,"_15335":37211,"_1612":37229},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_8073":1606,"_22563":1598,"_19084":37231,"_5":22713,"_15335":37219,"_1612":37232},[],"Hello",{"_8073":1607,"_22563":1598,"_19084":37234,"_5":22713,"_15335":37219,"_1612":37235},[],"World","sorting",{"_37238":37239,"_37240":37241,"_37242":37243,"_37244":37245,"_4582":1630,"_43647":1630},"language","english","sortableProperties",[1612,22563,5,15335],"sortablePropertiesWithTypes",{"_1612":11737,"_22563":11737,"_5":11737,"_15335":11737},"sorts",{"_1612":37246,"_22563":38847,"_5":40447,"_15335":42047},{"_8334":37247,"_37248":37249,"_5":11737},{"_11435":7650,"_4075":3031,"_13605":3174,"_6794":22287,"_13591":2616,"_20466":2737,"_13552":6872,"_13575":1811,"_19901":4122,"_22241":2041,"_22236":4362,"_22256":6905,"_22281":4162,"_22225":6898,"_22261":3191,"_24412":10200,"_24414":2974,"_24417":4158,"_22220":2210,"_22292":14708,"_24423":1867,"_24425":1680,"_22356":14975,"_13601":2335,"_22606":6062,"_22312":3357,"_24433":2736,"_22361":1731,"_22340":9129,"_22183":1699,"_24438":4146,"_24440":7652,"_24442":3324,"_24444":3325,"_24446":9958,"_24448":20454,"_24451":2120,"_24453":1795,"_24455":9644,"_19897":11369,"_24458":3662,"_24460":2594,"_24462":11357,"_19885":15059,"_24465":2718,"_24467":1820,"_24469":5924,"_24471":4617,"_24473":1769,"_20435":14923,"_24477":16834,"_20479":18754,"_24480":11358,"_24482":2374,"_24484":6383,"_13594":13979,"_24487":7090,"_24489":2862,"_24491":1658,"_24493":32419,"_24495":4455,"_24497":1660,"_24499":6868,"_20626":6527,"_22370":11814,"_24503":19392,"_24505":20457,"_24507":8007,"_24509":1845,"_24511":2068,"_24513":8040,"_22189":1851,"_24516":6950,"_24518":2583,"_24520":