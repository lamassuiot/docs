fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_8091":44,"_22651":34,"_5":22806,"_19215":32681,"_15391":32682,"_1609":32683},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-online-vs-offline","Modo online vs offline",{"_8091":45,"_22651":34,"_5":22806,"_19215":32685,"_15391":32686,"_1609":32687},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_8091":46,"_22651":34,"_5":22806,"_19215":32689,"_15391":32690,"_1609":32691},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#modo-offline","Modo offline",{"_8091":47,"_22651":34,"_5":22806,"_19215":32693,"_15391":32694,"_1609":32695},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#instalación-de-componentes","Instalación de componentes",{"_8091":48,"_22651":34,"_5":22806,"_19215":32697,"_15391":32698,"_1609":32699},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_8091":49,"_22651":34,"_5":22806,"_19215":32701,"_15391":32702,"_1609":32703},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_8091":50,"_22651":34,"_5":22806,"_19215":32705,"_15391":32706,"_1609":32707},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_8091":51,"_22651":34,"_5":22806,"_19215":32709,"_15391":32710,"_1609":32711},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_8091":52,"_22651":34,"_5":22806,"_19215":32713,"_15391":32714,"_1609":32715},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#configuración-tls","Configuración TLS",{"_8091":53,"_22651":34,"_5":22806,"_19215":32717,"_15391":32718,"_1609":32719},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#certificado-externo","Certificado externo",{"_8091":54,"_22651":34,"_5":22806,"_19215":32721,"_15391":32722,"_1609":32723},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_8091":55,"_22651":34,"_5":22806,"_19215":32725,"_15391":32726,"_1609":32727},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_8091":56,"_22651":34,"_5":22806,"_19215":32729,"_15391":32730,"_1609":32731},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#uso-en-ci","Uso en CI",{"_8091":57,"_22651":34,"_5":22806,"_19215":32733,"_15391":32734,"_1609":32735},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#ejemplo-rápido","Ejemplo rápido",{"_8091":58,"_22651":34,"_5":22806,"_19215":32737,"_15391":32738,"_1609":32739},[],"/docs/pr-preview/pr-25/despliegue/onprem/fastlane#resumen","Resumen",{"_8091":59,"_22651":34,"_19215":32741,"_5":22801,"_15391":32650,"_1609":32742},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_8091":60,"_22651":34,"_19215":32744,"_5":22801,"_15391":32650,"_1609":32745},[],"La instalación incluye:",{"_8091":61,"_22651":34,"_19215":32747,"_5":22801,"_15391":32650,"_1609":32748},[],"PostgreSQL",{"_8091":62,"_22651":34,"_19215":32750,"_5":22801,"_15391":32650,"_1609":32751},[],"Keycloak",{"_8091":63,"_22651":34,"_19215":32753,"_5":22801,"_15391":32650,"_1609":32754},[],"RabbitMQ",{"_8091":64,"_22651":34,"_19215":32756,"_5":22801,"_15391":32650,"_1609":32757},[],"Chart Helm de Lamassu",{"_8091":65,"_22651":34,"_19215":32759,"_5":22801,"_15391":32654,"_1609":32760},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_8091":66,"_22651":34,"_19215":32762,"_5":22801,"_15391":32654,"_1609":32763},[],"Flag",{"_8091":67,"_22651":34,"_19215":32765,"_5":22801,"_15391":32654,"_1609":32766},[],"Valor por defecto",{"_8091":68,"_22651":34,"_19215":32768,"_5":22801,"_15391":32654,"_1609":32769},[],"Descripción",{"_8091":69,"_22651":34,"_19215":32771,"_5":22801,"_15391":32654,"_1609":32772},[],"`-h`, `--help`",{"_8091":70,"_22651":34,"_19215":32774,"_5":22801,"_15391":32654,"_1609":3077},[],{"_8091":71,"_22651":34,"_19215":32776,"_5":22801,"_15391":32654,"_1609":32777},[],"Muestra la ayuda y finaliza",{"_8091":72,"_22651":34,"_19215":32779,"_5":22801,"_15391":32654,"_1609":32780},[],"`-n`, `--non-interactive`",{"_8091":73,"_22651":34,"_19215":32782,"_5":22801,"_15391":32654,"_1609":32783},[],"`false`",{"_8091":74,"_22651":34,"_19215":32785,"_5":22801,"_15391":32654,"_1609":32786},[],"Omite prompts y genera/usa credenciales por defecto",{"_8091":75,"_22651":34,"_19215":32788,"_5":22801,"_15391":32654,"_1609":32789},[],"`-ns`, `--namespace`",{"_8091":76,"_22651":34,"_19215":32791,"_5":22801,"_15391":32654,"_1609":32792},[],"`lamassu-dev`",{"_8091":77,"_22651":34,"_19215":32794,"_5":22801,"_15391":32654,"_1609":32795},[],"Namespace Kubernetes donde se despliegan los recursos",{"_8091":78,"_22651":34,"_19215":32797,"_5":22801,"_15391":32654,"_1609":32798},[],"`-d`, `--domain`",{"_8091":79,"_22651":34,"_19215":32800,"_5":22801,"_15391":32654,"_1609":32801},[],"`dev.lamassu.io`",{"_8091":80,"_22651":34,"_19215":32803,"_5":22801,"_15391":32654,"_1609":32804},[],"Dominio usado para endpoint y certificados TLS",{"_8091":81,"_22651":34,"_19215":32806,"_5":22801,"_15391":32654,"_1609":32807},[],"`-v`, `--version`",{"_8091":82,"_22651":34,"_19215":32809,"_5":22801,"_15391":32654,"_1609":32810},[],"`latest`",{"_8091":83,"_22651":34,"_19215":32812,"_5":22801,"_15391":32654,"_1609":32813},[],"Versión del chart Helm de Lamassu",{"_8091":84,"_22651":34,"_19215":32815,"_5":22801,"_15391":32654,"_1609":32816},[],"`--https-port`",{"_8091":85,"_22651":34,"_19215":32818,"_5":22801,"_15391":32654,"_1609":32819},[],"`443`",{"_8091":86,"_22651":34,"_19215":32821,"_5":22801,"_15391":32654,"_1609":32822},[],"Puerto HTTPS del gateway",{"_8091":87,"_22651":34,"_19215":32824,"_5":22801,"_15391":32654,"_1609":32825},[],"`--http-port`",{"_8091":88,"_22651":34,"_19215":32827,"_5":22801,"_15391":32654,"_1609":32828},[],"`80`",{"_8091":89,"_22651":34,"_19215":32830,"_5":22801,"_15391":32654,"_1609":32831},[],"Puerto HTTP del gateway",{"_8091":90,"_22651":34,"_19215":32833,"_5":22801,"_15391":32654,"_1609":32834},[],"`--offline`",{"_8091":91,"_22651":34,"_19215":32836,"_5":22801,"_15391":32654,"_1609":32783},[],{"_8091":92,"_22651":34,"_19215":32838,"_5":22801,"_15391":32654,"_1609":32839},[],"Activa modo offline",{"_8091":93,"_22651":34,"_19215":32841,"_5":22801,"_15391":32654,"_1609":32842},[],"`--tls-crt`",{"_8091":94,"_22651":34,"_19215":32844,"_5":22801,"_15391":32654,"_1609":3077},[],{"_8091":95,"_22651":34,"_19215":32846,"_5":22801,"_15391":32654,"_1609":32847},[],"Ruta al certificado TLS (PEM)",{"_8091":96,"_22651":34,"_19215":32849,"_5":22801,"_15391":32654,"_1609":32850},[],"`--tls-key`",{"_8091":97,"_22651":34,"_19215":32852,"_5":22801,"_15391":32654,"_1609":3077},[],{"_8091":98,"_22651":34,"_19215":32854,"_5":22801,"_15391":32654,"_1609":32855},[],"Ruta a la clave privada TLS (PEM)",{"_8091":99,"_22651":34,"_19215":32857,"_5":22801,"_15391":32654,"_1609":32858},[],"`--helm-chart-lamassu`",{"_8091":100,"_22651":34,"_19215":32860,"_5":22801,"_15391":32654,"_1609":3077},[],{"_8091":101,"_22651":34,"_19215":32862,"_5":22801,"_15391":32654,"_1609":32863},[],"Ruta a chart local Lamassu (`.tgz`)",{"_8091":102,"_22651":34,"_19215":32865,"_5":22801,"_15391":32654,"_1609":32866},[],"`--helm-chart-postgres`",{"_8091":103,"_22651":34,"_19215":32868,"_5":22801,"_15391":32654,"_1609":3077},[],{"_8091":104,"_22651":34,"_19215":32870,"_5":22801,"_15391":32654,"_1609":32871},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_8091":105,"_22651":34,"_19215":32873,"_5":22801,"_15391":32654,"_1609":32874},[],"`--helm-chart-keycloak`",{"_8091":106,"_22651":34,"_19215":32876,"_5":22801,"_15391":32654,"_1609":3077},[],{"_8091":107,"_22651":34,"_19215":32878,"_5":22801,"_15391":32654,"_1609":32879},[],"Ruta a chart local Keycloak (`.tgz`)",{"_8091":108,"_22651":34,"_19215":32881,"_5":22801,"_15391":32654,"_1609":32882},[],"`--helm-chart-rabbitmq`",{"_8091":109,"_22651":34,"_19215":32884,"_5":22801,"_15391":32654,"_1609":3077},[],{"_8091":110,"_22651":34,"_19215":32886,"_5":22801,"_15391":32654,"_1609":32887},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_8091":111,"_22651":34,"_19215":32889,"_5":22801,"_15391":32654,"_1609":32890},[],"`-l`, `--local-chart-path`",{"_8091":112,"_22651":34,"_19215":32892,"_5":22801,"_15391":32654,"_1609":3077},[],{"_8091":113,"_22651":34,"_19215":32894,"_5":22801,"_15391":32654,"_1609":32895},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_8091":114,"_22651":34,"_19215":32897,"_5":22801,"_15391":32658,"_1609":32898},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_8091":115,"_22651":34,"_19215":32900,"_5":22801,"_15391":32658,"_1609":32901},[],"`microk8s`",{"_8091":116,"_22651":34,"_19215":32903,"_5":22801,"_15391":32658,"_1609":32904},[],"`k3s`",{"_8091":117,"_22651":34,"_19215":32906,"_5":22801,"_15391":32658,"_1609":32907},[],"`kind`",{"_8091":118,"_22651":34,"_19215":32909,"_5":22801,"_15391":32658,"_1609":32910},[],"Kubernetes estándar",{"_8091":119,"_22651":34,"_19215":32912,"_5":22801,"_15391":32658,"_1609":32913},[],"Comportamientos específicos:",{"_8091":120,"_22651":34,"_19215":32915,"_5":22801,"_15391":32658,"_1609":32916},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_8091":121,"_22651":34,"_19215":32918,"_5":22801,"_15391":32658,"_1609":32919},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_8091":122,"_22651":34,"_19215":32921,"_5":22801,"_15391":32662,"_1609":32922},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_8091":123,"_22651":34,"_19215":32924,"_5":22801,"_15391":32662,"_1609":32925},[],"Requisitos generales:",{"_8091":124,"_22651":34,"_19215":32927,"_5":22801,"_15391":32662,"_1609":32928},[],"`yq`",{"_8091":125,"_22651":34,"_19215":32930,"_5":22801,"_15391":32662,"_1609":32931},[],"CLI de la distribución detectada",{"_8091":126,"_22651":34,"_19215":32933,"_5":22801,"_15391":32662,"_1609":32934},[],"Requisitos específicos:",{"_8091":127,"_22651":34,"_19215":32936,"_5":22801,"_15391":32662,"_1609":32937},[],"Distribución",{"_8091":128,"_22651":34,"_19215":32939,"_5":22801,"_15391":32662,"_1609":32940},[],"Herramientas requeridas",{"_8091":129,"_22651":34,"_19215":32942,"_5":22801,"_15391":32662,"_1609":32904},[],{"_8091":130,"_22651":34,"_19215":32944,"_5":22801,"_15391":32662,"_1609":32945},[],"`kubectl`, `helm`",{"_8091":131,"_22651":34,"_19215":32947,"_5":22801,"_15391":32662,"_1609":32901},[],{"_8091":132,"_22651":34,"_19215":32949,"_5":22801,"_15391":32662,"_1609":32950},[],"`microk8s kubectl`, `microk8s helm`",{"_8091":133,"_22651":34,"_19215":32952,"_5":22801,"_15391":32666,"_1609":32953},[],"Se valida que estén habilitados:",{"_8091":134,"_22651":34,"_19215":32955,"_5":22801,"_15391":32666,"_1609":32956},[],"`helm`",{"_8091":135,"_22651":34,"_19215":32958,"_5":22801,"_15391":32666,"_1609":32959},[],"`hostpath-storage`",{"_8091":136,"_22651":34,"_19215":32961,"_5":22801,"_15391":32666,"_1609":32962},[],"`dns`",{"_8091":137,"_22651":34,"_19215":32964,"_5":22801,"_15391":32666,"_1609":32965},[],"`cert-manager`",{"_8091":138,"_22651":34,"_19215":32967,"_5":22801,"_15391":32666,"_1609":32968},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_8091":139,"_22651":34,"_19215":32970,"_5":22801,"_15391":32674,"_1609":32971},[],"La función `request_config_data` solicita:",{"_8091":140,"_22651":34,"_19215":32973,"_5":22801,"_15391":32674,"_1609":32974},[],"Dominio Lamassu",{"_8091":141,"_22651":34,"_19215":32976,"_5":22801,"_15391":32674,"_1609":32977},[],"Usuario y contraseña admin PostgreSQL",{"_8091":142,"_22651":34,"_19215":32979,"_5":22801,"_15391":32674,"_1609":32980},[],"Usuario y contraseña admin RabbitMQ",{"_8091":143,"_22651":34,"_19215":32982,"_5":22801,"_15391":32674,"_1609":32983},[],"Usuario y contraseña admin Keycloak",{"_8091":144,"_22651":34,"_19215":32985,"_5":22801,"_15391":32674,"_1609":32986},[],"Namespace Kubernetes",{"_8091":145,"_22651":34,"_19215":32988,"_5":22801,"_15391":32678,"_1609":32989},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_8091":146,"_22651":34,"_19215":32991,"_5":22801,"_15391":32678,"_1609":32992},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_8091":147,"_22651":34,"_19215":32994,"_5":22801,"_15391":32682,"_1609":32995},[],"El script admite dos estrategias para obtener charts Helm.",{"_8091":148,"_22651":34,"_19215":32997,"_5":22801,"_15391":32686,"_1609":32998},[],"Los charts se descargan desde repositorios remotos.",{"_8091":149,"_22651":34,"_19215":33000,"_5":22801,"_15391":32690,"_1609":33001},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_8091":150,"_22651":34,"_19215":33003,"_5":22801,"_15391":32690,"_1609":32858},[],{"_8091":151,"_22651":34,"_19215":33005,"_5":22801,"_15391":32690,"_1609":32866},[],{"_8091":152,"_22651":34,"_19215":33007,"_5":22801,"_15391":32690,"_1609":32874},[],{"_8091":153,"_22651":34,"_19215":33009,"_5":22801,"_15391":32690,"_1609":32882},[],{"_8091":154,"_22651":34,"_19215":33011,"_5":22801,"_15391":32690,"_1609":33012},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_8091":155,"_22651":34,"_19215":33014,"_5":22801,"_15391":32690,"_1609":33015},[],"En este modo se fuerza:",{"_8091":156,"_22651":34,"_19215":33017,"_5":22801,"_15391":32698,"_1609":33018},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_8091":157,"_22651":34,"_19215":33020,"_5":22801,"_15391":32698,"_1609":33021},[],"Versión del chart: `0.19.0`",{"_8091":158,"_22651":34,"_19215":33023,"_5":22801,"_15391":32698,"_1609":33024},[],"Release: `postgres`",{"_8091":159,"_22651":34,"_19215":33026,"_5":22801,"_15391":32698,"_1609":33027},[],"`fullnameOverride: \"postgresql\"`",{"_8091":160,"_22651":34,"_19215":33029,"_5":22801,"_15391":32698,"_1609":33030},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_8091":161,"_22651":34,"_19215":33032,"_5":22801,"_15391":32698,"_1609":33033},[],"Base de datos",{"_8091":162,"_22651":34,"_19215":33035,"_5":22801,"_15391":32698,"_1609":33036},[],"Servicio",{"_8091":163,"_22651":34,"_19215":33038,"_5":22801,"_15391":32698,"_1609":33039},[],"`auth`",{"_8091":164,"_22651":34,"_19215":33041,"_5":22801,"_15391":32698,"_1609":32751},[],{"_8091":165,"_22651":34,"_19215":33043,"_5":22801,"_15391":32698,"_1609":33044},[],"`alerts`",{"_8091":166,"_22651":34,"_19215":33046,"_5":22801,"_15391":32698,"_1609":33047},[],"Alerts",{"_8091":167,"_22651":34,"_19215":33049,"_5":22801,"_15391":32698,"_1609":33050},[],"`ca`",{"_8091":168,"_22651":34,"_19215":33052,"_5":22801,"_15391":32698,"_1609":33053},[],"CA",{"_8091":169,"_22651":34,"_19215":33055,"_5":22801,"_15391":32698,"_1609":33056},[],"`va`",{"_8091":170,"_22651":34,"_19215":33058,"_5":22801,"_15391":32698,"_1609":33059},[],"VA",{"_8091":171,"_22651":34,"_19215":33061,"_5":22801,"_15391":32698,"_1609":33062},[],"`cloudproxy`",{"_8091":172,"_22651":34,"_19215":33064,"_5":22801,"_15391":32698,"_1609":33065},[],"Cloud Proxy",{"_8091":173,"_22651":34,"_19215":33067,"_5":22801,"_15391":32698,"_1609":33068},[],"`devicemanager`",{"_8091":174,"_22651":34,"_19215":33070,"_5":22801,"_15391":32698,"_1609":33071},[],"Device Manager",{"_8091":175,"_22651":34,"_19215":33073,"_5":22801,"_15391":32698,"_1609":33074},[],"`dmsmanager`",{"_8091":176,"_22651":34,"_19215":33076,"_5":22801,"_15391":32698,"_1609":33077},[],"DMS Manager",{"_8091":177,"_22651":34,"_19215":33079,"_5":22801,"_15391":32698,"_1609":33080},[],"`kms`",{"_8091":178,"_22651":34,"_19215":33082,"_5":22801,"_15391":32698,"_1609":33083},[],"KMS",{"_8091":179,"_22651":34,"_19215":33085,"_5":22801,"_15391":32702,"_1609":33086},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_8091":180,"_22651":34,"_19215":33088,"_5":22801,"_15391":32702,"_1609":33089},[],"Versión del chart: `0.20.0`",{"_8091":181,"_22651":34,"_19215":33091,"_5":22801,"_15391":32702,"_1609":33092},[],"Release: `auth`",{"_8091":182,"_22651":34,"_19215":33094,"_5":22801,"_15391":32702,"_1609":33095},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_8091":183,"_22651":34,"_19215":33097,"_5":22801,"_15391":32702,"_1609":33098},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_8091":184,"_22651":34,"_19215":33100,"_5":22801,"_15391":32702,"_1609":33101},[],"`httpRelativePath: /auth/`",{"_8091":185,"_22651":34,"_19215":33103,"_5":22801,"_15391":32702,"_1609":33104},[],"`proxyHeaders: xforwarded`",{"_8091":186,"_22651":34,"_19215":33106,"_5":22801,"_15391":32702,"_1609":33107},[],"Configuración automática del realm `lamassu`:",{"_8091":187,"_22651":34,"_19215":33109,"_5":22801,"_15391":32702,"_1609":33110},[],"Rol: `pki-admin`",{"_8091":188,"_22651":34,"_19215":33112,"_5":22801,"_15391":32702,"_1609":33113},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_8091":189,"_22651":34,"_19215":33115,"_5":22801,"_15391":32702,"_1609":33116},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_8091":190,"_22651":34,"_19215":33118,"_5":22801,"_15391":32702,"_1609":33119},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_8091":191,"_22651":34,"_19215":33121,"_5":22801,"_15391":32702,"_1609":33122},[],"`github.com/lamassuiot/keycloak-theme`",{"_8091":192,"_22651":34,"_19215":33124,"_5":22801,"_15391":32706,"_1609":33125},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_8091":193,"_22651":34,"_19215":33127,"_5":22801,"_15391":32706,"_1609":33089},[],{"_8091":194,"_22651":34,"_19215":33129,"_5":22801,"_15391":32706,"_1609":33130},[],"Release: `rabbitmq`",{"_8091":195,"_22651":34,"_19215":33132,"_5":22801,"_15391":32706,"_1609":33133},[],"`fullnameOverride: \"rabbitmq\"`",{"_8091":196,"_22651":34,"_19215":33135,"_5":22801,"_15391":32706,"_1609":33136},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_8091":197,"_22651":34,"_19215":33138,"_5":22801,"_15391":32710,"_1609":33139},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_8091":198,"_22651":34,"_19215":33141,"_5":22801,"_15391":32710,"_1609":33142},[],"Configuraciones principales:",{"_8091":199,"_22651":34,"_19215":33144,"_5":22801,"_15391":32710,"_1609":33145},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_8091":200,"_22651":34,"_19215":33147,"_5":22801,"_15391":32710,"_1609":33148},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_8091":201,"_22651":34,"_19215":33150,"_5":22801,"_15391":32710,"_1609":33151},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_8091":202,"_22651":34,"_19215":33153,"_5":22801,"_15391":32710,"_1609":33154},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_8091":203,"_22651":34,"_19215":33156,"_5":22801,"_15391":32710,"_1609":33157},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_8091":204,"_22651":34,"_19215":33159,"_5":22801,"_15391":32710,"_1609":33160},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_8091":205,"_22651":34,"_19215":33162,"_5":22801,"_15391":32710,"_1609":33163},[],"Dominios CA: valor de `--domain`",{"_8091":206,"_22651":34,"_19215":33165,"_5":22801,"_15391":32710,"_1609":33166},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_8091":207,"_22651":34,"_19215":33168,"_5":22801,"_15391":32710,"_1609":33169},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_8091":208,"_22651":34,"_19215":33171,"_5":22801,"_15391":32710,"_1609":33172},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_8091":209,"_22651":34,"_19215":33174,"_5":22801,"_15391":32718,"_1609":33175},[],"Si se proporcionan:",{"_8091":210,"_22651":34,"_19215":33177,"_5":22801,"_15391":32718,"_1609":32842},[],{"_8091":211,"_22651":34,"_19215":33179,"_5":22801,"_15391":32718,"_1609":32850},[],{"_8091":212,"_22651":34,"_19215":33181,"_5":22801,"_15391":32718,"_1609":33182},[],"Se crea un secret Kubernetes:",{"_8091":213,"_22651":34,"_19215":33184,"_5":22801,"_15391":32718,"_1609":33185},[],"`downstream-provided-crt`",{"_8091":214,"_22651":34,"_19215":33187,"_5":22801,"_15391":32718,"_1609":33188},[],"Y se configura:",{"_8091":215,"_22651":34,"_19215":33190,"_5":22801,"_15391":32722,"_1609":33191},[],"Si no se proporciona certificado:",{"_8091":216,"_22651":34,"_19215":33193,"_5":22801,"_15391":32722,"_1609":33194},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_8091":217,"_22651":34,"_19215":33196,"_5":22801,"_15391":32722,"_1609":33197},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_8091":218,"_22651":34,"_19215":33199,"_5":22801,"_15391":32726,"_1609":33200},[],"En caso de éxito, se muestra:",{"_8091":219,"_22651":34,"_19215":33202,"_5":22801,"_15391":32726,"_1609":33203},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_8091":220,"_22651":34,"_19215":33205,"_5":22801,"_15391":32726,"_1609":33206},[],"Credenciales iniciales: `lamassu / lamassu`",{"_8091":221,"_22651":34,"_19215":33208,"_5":22801,"_15391":32726,"_1609":33209},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_8091":222,"_22651":34,"_19215":33211,"_5":22801,"_15391":32726,"_1609":33212},[],"Credenciales admin de Keycloak",{"_8091":223,"_22651":34,"_19215":33214,"_5":22801,"_15391":32726,"_1609":33215},[],"El usuario `lamassu` se crea con:",{"_8091":224,"_22651":34,"_19215":33217,"_5":22801,"_15391":32726,"_1609":33218},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_8091":225,"_22651":34,"_19215":33220,"_5":22801,"_15391":32730,"_1609":33221},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_8091":226,"_22651":34,"_19215":33223,"_5":22801,"_15391":32730,"_1609":33224},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_8091":227,"_22651":34,"_19215":33226,"_5":22801,"_15391":32730,"_1609":33227},[],"Ejemplo:",{"_8091":228,"_22651":34,"_19215":33229,"_5":22801,"_15391":32730,"_1609":33230},[],"En este escenario:",{"_8091":229,"_22651":34,"_19215":33232,"_5":22801,"_15391":32730,"_1609":33233},[],"`-n`: modo no interactivo",{"_8091":230,"_22651":34,"_19215":33235,"_5":22801,"_15391":32730,"_1609":33236},[],"`-ns`: namespace específico",{"_8091":231,"_22651":34,"_19215":33238,"_5":22801,"_15391":32730,"_1609":33239},[],"`-d`: dominio de CI",{"_8091":232,"_22651":34,"_19215":33241,"_5":22801,"_15391":32730,"_1609":33242},[],"`-l`: chart local",{"_8091":233,"_22651":34,"_19215":33244,"_5":22801,"_15391":32738,"_1609":33245},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_8091":234,"_22651":34,"_19215":33247,"_5":22801,"_15391":32738,"_1609":33248},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_8091":235,"_22651":235,"_5":22796,"_1609":33250,"_22809":33251,"_19215":33252,"_15391":235},"Introducción",[32566,32567,32618],[],{"_8091":236,"_22651":235,"_19215":33254,"_5":22801,"_15391":235,"_1609":33255},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_8091":237,"_22651":235,"_5":22806,"_19215":33257,"_15391":33258,"_1609":33259},[],"/docs/pr-preview/pr-25/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_8091":238,"_22651":235,"_5":22806,"_19215":33261,"_15391":33262,"_1609":33263},[],"/docs/pr-preview/pr-25/despliegue/onprem#quickstart","Quickstart",{"_8091":239,"_22651":235,"_5":22806,"_19215":33265,"_15391":33266,"_1609":33267},[],"/docs/pr-preview/pr-25/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_8091":240,"_22651":235,"_5":22806,"_19215":33269,"_15391":33270,"_1609":33271},[],"/docs/pr-preview/pr-25/despliegue/onprem#requisitos-previos","Requisitos previos",{"_8091":241,"_22651":235,"_5":22806,"_19215":33273,"_15391":33274,"_1609":33275},[],"/docs/pr-preview/pr-25/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_8091":242,"_22651":235,"_5":22806,"_19215":33277,"_15391":33278,"_1609":33279},[],"/docs/pr-preview/pr-25/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_8091":243,"_22651":235,"_5":22806,"_19215":33281,"_15391":33282,"_1609":33283},[],"/docs/pr-preview/pr-25/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_8091":244,"_22651":235,"_5":22806,"_19215":33285,"_15391":33286,"_1609":33287},[],"/docs/pr-preview/pr-25/despliegue/onprem#arquitectura","Arquitectura",{"_8091":245,"_22651":235,"_5":22806,"_19215":33289,"_15391":33290,"_1609":33291},[],"/docs/pr-preview/pr-25/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_8091":246,"_22651":235,"_5":22806,"_19215":33293,"_15391":33294,"_1609":33295},[],"/docs/pr-preview/pr-25/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_8091":247,"_22651":235,"_5":22806,"_19215":33297,"_15391":33298,"_1609":33299},[],"/docs/pr-preview/pr-25/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_8091":248,"_22651":235,"_5":22806,"_19215":33301,"_15391":33302,"_1609":33303},[],"/docs/pr-preview/pr-25/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_8091":249,"_22651":235,"_5":22806,"_19215":33305,"_15391":33306,"_1609":33307},[],"/docs/pr-preview/pr-25/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_8091":250,"_22651":235,"_5":22806,"_19215":33309,"_15391":33310,"_1609":33311},[],"/docs/pr-preview/pr-25/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_8091":251,"_22651":235,"_5":22806,"_19215":33313,"_15391":33314,"_1609":33315},[],"/docs/pr-preview/pr-25/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_8091":252,"_22651":235,"_19215":33317,"_5":22801,"_15391":33258,"_1609":33318},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_8091":253,"_22651":235,"_19215":33320,"_5":22801,"_15391":33258,"_1609":33321},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_8091":254,"_22651":235,"_19215":33323,"_5":22801,"_15391":33258,"_1609":33324},[],"el chart principal de Lamassu",{"_8091":255,"_22651":235,"_19215":33326,"_5":22801,"_15391":33258,"_1609":33327},[],"un chart auxiliar de SoftHSM",{"_8091":256,"_22651":235,"_19215":33329,"_5":22801,"_15391":33258,"_1609":33330},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_8091":257,"_22651":235,"_19215":33332,"_5":22801,"_15391":33262,"_1609":33333},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_8091":258,"_22651":235,"_19215":33335,"_5":22801,"_15391":33262,"_1609":33336},[],"Ese flujo:",{"_8091":259,"_22651":235,"_19215":33338,"_5":22801,"_15391":33262,"_1609":33339},[],"crea o reutiliza el namespace indicado",{"_8091":260,"_22651":235,"_19215":33341,"_5":22801,"_15391":33262,"_1609":33342},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_8091":261,"_22651":235,"_19215":33344,"_5":22801,"_15391":33262,"_1609":33345},[],"despliega el chart de Lamassu",{"_8091":262,"_22651":235,"_19215":33347,"_5":22801,"_15391":33262,"_1609":33348},[],"deja la UI expuesta en `https://<dominio>`",{"_8091":263,"_22651":235,"_19215":33350,"_5":22801,"_15391":33262,"_1609":33351},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_8091":264,"_22651":235,"_19215":33353,"_5":22801,"_15391":33266,"_1609":33354},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_8091":265,"_22651":235,"_19215":33356,"_5":22801,"_15391":33266,"_1609":33357},[],"`ui`",{"_8091":266,"_22651":235,"_19215":33359,"_5":22801,"_15391":33266,"_1609":33050},[],{"_8091":267,"_22651":235,"_19215":33361,"_5":22801,"_15391":33266,"_1609":33056},[],{"_8091":268,"_22651":235,"_19215":33363,"_5":22801,"_15391":33266,"_1609":33080},[],{"_8091":269,"_22651":235,"_19215":33365,"_5":22801,"_15391":33266,"_1609":33366},[],"`device-manager`",{"_8091":270,"_22651":235,"_19215":33368,"_5":22801,"_15391":33266,"_1609":33369},[],"`dms-manager`",{"_8091":271,"_22651":235,"_19215":33371,"_5":22801,"_15391":33266,"_1609":33044},[],{"_8091":272,"_22651":235,"_19215":33373,"_5":22801,"_15391":33266,"_1609":33374},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_8091":273,"_22651":235,"_19215":33376,"_5":22801,"_15391":33266,"_1609":33377},[],"job de migraciones de base de datos",{"_8091":274,"_22651":235,"_19215":33379,"_5":22801,"_15391":33270,"_1609":33380},[],"Clúster Kubernetes `1.19+`",{"_8091":275,"_22651":235,"_19215":33382,"_5":22801,"_15391":33270,"_1609":33383},[],"`kubectl` configurado con acceso al clúster",{"_8091":276,"_22651":235,"_19215":33385,"_5":22801,"_15391":33270,"_1609":33386},[],"Helm `3.2.0+`",{"_8091":277,"_22651":235,"_19215":33388,"_5":22801,"_15391":33270,"_1609":33389},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_8091":278,"_22651":235,"_19215":33391,"_5":22801,"_15391":33270,"_1609":33392},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_8091":279,"_22651":235,"_19215":33394,"_5":22801,"_15391":33270,"_1609":33395},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_8091":280,"_22651":235,"_19215":33397,"_5":22801,"_15391":33270,"_1609":33398},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_8091":281,"_22651":235,"_19215":33400,"_5":22801,"_15391":33274,"_1609":33401},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_8091":282,"_22651":235,"_19215":33403,"_5":22801,"_15391":33278,"_1609":33404},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_8091":283,"_22651":235,"_19215":33406,"_5":22801,"_15391":33282,"_1609":33407},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_8091":284,"_22651":235,"_19215":33409,"_5":22801,"_15391":33286,"_1609":33410},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_8091":285,"_22651":235,"_19215":33412,"_5":22801,"_15391":33286,"_1609":33413},[],"Dependencias externas requeridas por el chart principal:",{"_8091":286,"_22651":235,"_19215":33415,"_5":22801,"_15391":33286,"_1609":32748},[],{"_8091":287,"_22651":235,"_19215":33417,"_5":22801,"_15391":33286,"_1609":32754},[],{"_8091":288,"_22651":235,"_19215":33419,"_5":22801,"_15391":33286,"_1609":33420},[],"proveedor OIDC, típicamente Keycloak",{"_8091":289,"_22651":235,"_19215":33422,"_5":22801,"_15391":33286,"_1609":33423},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_8091":290,"_22651":235,"_19215":33425,"_5":22801,"_15391":33290,"_1609":33426},[],"Agregar el repositorio Helm:",{"_8091":291,"_22651":235,"_19215":33428,"_5":22801,"_15391":33290,"_1609":33429},[],"O instalar desde una copia local del repositorio:",{"_8091":292,"_22651":235,"_19215":33431,"_5":22801,"_15391":33294,"_1609":33432},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_8091":293,"_22651":235,"_19215":33434,"_5":22801,"_15391":33294,"_1609":33435},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_8091":294,"_22651":235,"_19215":33437,"_5":22801,"_15391":33294,"_1609":33438},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_8091":295,"_22651":235,"_19215":33440,"_5":22801,"_15391":33294,"_1609":33441},[],"`auth.oidc.frontend.authority`",{"_8091":296,"_22651":235,"_19215":33443,"_5":22801,"_15391":33294,"_1609":33444},[],"`auth.oidc.apiGateway.jwks`",{"_8091":297,"_22651":235,"_19215":33446,"_5":22801,"_15391":33294,"_1609":33447},[],"`services.ca.domains`",{"_8091":298,"_22651":235,"_19215":33449,"_5":22801,"_15391":33294,"_1609":33450},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_8091":299,"_22651":235,"_19215":33452,"_5":22801,"_15391":33294,"_1609":33453},[],"`tls.*` según se use `certManager` o certificado externo",{"_8091":300,"_22651":235,"_19215":33455,"_5":22801,"_15391":33294,"_1609":33456},[],"Ejemplo base:",{"_8091":301,"_22651":235,"_19215":33458,"_5":22801,"_15391":33298,"_1609":33459},[],"Área",{"_8091":302,"_22651":235,"_19215":33461,"_5":22801,"_15391":33298,"_1609":33462},[],"Valores clave",{"_8091":303,"_22651":235,"_19215":33464,"_5":22801,"_15391":33298,"_1609":33465},[],"Uso",{"_8091":304,"_22651":235,"_19215":33467,"_5":22801,"_15391":33298,"_1609":33468},[],"TLS",{"_8091":305,"_22651":235,"_19215":33470,"_5":22801,"_15391":33298,"_1609":33471},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_8091":306,"_22651":235,"_19215":33473,"_5":22801,"_15391":33298,"_1609":33474},[],"Certificado downstream del Gateway",{"_8091":307,"_22651":235,"_19215":33476,"_5":22801,"_15391":33298,"_1609":33477},[],"Gateway",{"_8091":308,"_22651":235,"_19215":33479,"_5":22801,"_15391":33298,"_1609":33480},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_8091":309,"_22651":235,"_19215":33482,"_5":22801,"_15391":33298,"_1609":33483},[],"Exposición de UI y APIs vía Envoy Gateway",{"_8091":310,"_22651":235,"_19215":33485,"_5":22801,"_15391":33298,"_1609":33033},[],{"_8091":311,"_22651":235,"_19215":33487,"_5":22801,"_15391":33298,"_1609":33488},[],"`postgres.*`",{"_8091":312,"_22651":235,"_19215":33490,"_5":22801,"_15391":33298,"_1609":33491},[],"Conexión a PostgreSQL externa",{"_8091":313,"_22651":235,"_19215":33493,"_5":22801,"_15391":33298,"_1609":33494},[],"Mensajería",{"_8091":314,"_22651":235,"_19215":33496,"_5":22801,"_15391":33298,"_1609":33497},[],"`amqp.*`",{"_8091":315,"_22651":235,"_19215":33499,"_5":22801,"_15391":33298,"_1609":33500},[],"Conexión a RabbitMQ",{"_8091":316,"_22651":235,"_19215":33502,"_5":22801,"_15391":33298,"_1609":33503},[],"OIDC",{"_8091":317,"_22651":235,"_19215":33505,"_5":22801,"_15391":33298,"_1609":33506},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_8091":318,"_22651":235,"_19215":33508,"_5":22801,"_15391":33298,"_1609":33509},[],"Login de UI y validación JWT en el Gateway",{"_8091":319,"_22651":235,"_19215":33511,"_5":22801,"_15391":33298,"_1609":33053},[],{"_8091":320,"_22651":235,"_19215":33513,"_5":22801,"_15391":33298,"_1609":33447},[],{"_8091":321,"_22651":235,"_19215":33515,"_5":22801,"_15391":33298,"_1609":33516},[],"Dominios autorizados para CA y certificados",{"_8091":322,"_22651":235,"_19215":33518,"_5":22801,"_15391":33298,"_1609":33083},[],{"_8091":323,"_22651":235,"_19215":33520,"_5":22801,"_15391":33298,"_1609":33521},[],"`services.kms.cryptoEngines.*`",{"_8091":324,"_22651":235,"_19215":33523,"_5":22801,"_15391":33298,"_1609":33524},[],"Motor criptográfico y almacenamiento de claves",{"_8091":325,"_22651":235,"_19215":33526,"_5":22801,"_15391":33298,"_1609":33047},[],{"_8091":326,"_22651":235,"_19215":33528,"_5":22801,"_15391":33298,"_1609":33529},[],"`services.alerts.smtp_server.*`",{"_8091":327,"_22651":235,"_19215":33531,"_5":22801,"_15391":33298,"_1609":33532},[],"Envío de correo para alertas",{"_8091":328,"_22651":235,"_19215":33534,"_5":22801,"_15391":33302,"_1609":33535},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_8091":329,"_22651":235,"_19215":33537,"_5":22801,"_15391":33302,"_1609":33538},[],"La prueba comprueba al menos:",{"_8091":330,"_22651":235,"_19215":33540,"_5":22801,"_15391":33302,"_1609":33541},[],"salud de `ca`",{"_8091":331,"_22651":235,"_19215":33543,"_5":22801,"_15391":33302,"_1609":33544},[],"salud de `dms-manager`",{"_8091":332,"_22651":235,"_19215":33546,"_5":22801,"_15391":33302,"_1609":33547},[],"salud de `device-manager`",{"_8091":333,"_22651":235,"_19215":33549,"_5":22801,"_15391":33302,"_1609":33550},[],"salud de `va`",{"_8091":334,"_22651":235,"_19215":33552,"_5":22801,"_15391":33302,"_1609":33553},[],"respuesta HTML esperada del servicio `ui`",{"_8091":335,"_22651":235,"_19215":33555,"_5":22801,"_15391":33306,"_1609":33556},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_8091":336,"_22651":235,"_19215":33558,"_5":22801,"_15391":33306,"_1609":33559},[],"`charts/lamassu`: chart principal de Lamassu",{"_8091":337,"_22651":235,"_19215":33561,"_5":22801,"_15391":33306,"_1609":33562},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_8091":338,"_22651":235,"_19215":33564,"_5":22801,"_15391":33306,"_1609":33565},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_8091":339,"_22651":235,"_19215":33567,"_5":22801,"_15391":33310,"_1609":33568},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_8091":340,"_22651":235,"_19215":33570,"_5":22801,"_15391":33314,"_1609":33571},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_8091":341,"_22651":341,"_5":22796,"_1609":33573,"_22809":33574,"_19215":33575,"_15391":341},"SaaS · Suscripción",[32566,32567,32625],[],{"_8091":342,"_22651":341,"_19215":33577,"_5":22801,"_15391":341,"_1609":33578},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_8091":343,"_22651":341,"_5":22806,"_19215":33580,"_15391":33581,"_1609":33582},[],"/docs/pr-preview/pr-25/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_8091":344,"_22651":341,"_5":22806,"_19215":33584,"_15391":33585,"_1609":33586},[],"/docs/pr-preview/pr-25/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_8091":345,"_22651":341,"_5":22806,"_19215":33588,"_15391":33589,"_1609":33590},[],"/docs/pr-preview/pr-25/despliegue/saas#planes-disponibles","Planes disponibles",{"_8091":346,"_22651":341,"_5":22806,"_19215":33592,"_15391":33593,"_1609":33594},[],"/docs/pr-preview/pr-25/despliegue/saas#contacto","Contacto",{"_8091":347,"_22651":341,"_19215":33596,"_5":22801,"_15391":33581,"_1609":33597},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_8091":348,"_22651":341,"_19215":33599,"_5":22801,"_15391":33585,"_1609":33600},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_8091":349,"_22651":341,"_19215":33602,"_5":22801,"_15391":33585,"_1609":33603},[],"Alta disponibilidad y backups automáticos",{"_8091":350,"_22651":341,"_19215":33605,"_5":22801,"_15391":33585,"_1609":33606},[],"Actualizaciones automáticas a las últimas versiones",{"_8091":351,"_22651":341,"_19215":33608,"_5":22801,"_15391":33585,"_1609":33609},[],"Soporte técnico incluido",{"_8091":352,"_22651":341,"_19215":33611,"_5":22801,"_15391":33585,"_1609":33612},[],"SLA garantizado",{"_8091":353,"_22651":341,"_19215":33614,"_5":22801,"_15391":33589,"_1609":33615},[],"Plan",{"_8091":354,"_22651":341,"_19215":33617,"_5":22801,"_15391":33589,"_1609":33618},[],"Dispositivos",{"_8091":355,"_22651":341,"_19215":33620,"_5":22801,"_15391":33589,"_1609":33621},[],"Soporte",{"_8091":356,"_22651":341,"_19215":33623,"_5":22801,"_15391":33589,"_1609":33624},[],"SLA",{"_8091":357,"_22651":341,"_19215":33626,"_5":22801,"_15391":33589,"_1609":33627},[],"Starter",{"_8091":358,"_22651":341,"_19215":33629,"_5":22801,"_15391":33589,"_1609":33630},[],"Hasta 1.000",{"_8091":359,"_22651":341,"_19215":33632,"_5":22801,"_15391":33589,"_1609":33633},[],"Email",{"_8091":360,"_22651":341,"_19215":33635,"_5":22801,"_15391":33589,"_1609":33636},[],"99,5%",{"_8091":361,"_22651":341,"_19215":33638,"_5":22801,"_15391":33589,"_1609":33639},[],"Professional",{"_8091":362,"_22651":341,"_19215":33641,"_5":22801,"_15391":33589,"_1609":33642},[],"Hasta 10.000",{"_8091":363,"_22651":341,"_19215":33644,"_5":22801,"_15391":33589,"_1609":33645},[],"Email + Chat",{"_8091":364,"_22651":341,"_19215":33647,"_5":22801,"_15391":33589,"_1609":33648},[],"99,9%",{"_8091":365,"_22651":341,"_19215":33650,"_5":22801,"_15391":33589,"_1609":33651},[],"Enterprise",{"_8091":366,"_22651":341,"_19215":33653,"_5":22801,"_15391":33589,"_1609":33654},[],"Ilimitado",{"_8091":367,"_22651":341,"_19215":33656,"_5":22801,"_15391":33589,"_1609":33657},[],"Dedicado",{"_8091":368,"_22651":341,"_19215":33659,"_5":22801,"_15391":33589,"_1609":33660},[],"99,99%",{"_8091":369,"_22651":341,"_19215":33662,"_5":22801,"_15391":33593,"_1609":33663},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_8091":370,"_22651":370,"_5":22796,"_1609":33665,"_22809":33666,"_19215":33667,"_15391":370},"Manual de Usuario",[32566,33665],[],{"_8091":371,"_22651":370,"_19215":33669,"_5":22801,"_15391":370,"_1609":33670},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_8091":372,"_22651":370,"_5":22806,"_19215":33672,"_15391":33673,"_1609":33674},[],"/docs/pr-preview/pr-25/manual#servicios-core","Servicios Core",{"_8091":373,"_22651":370,"_5":22806,"_19215":33676,"_15391":33677,"_1609":33678},[],"/docs/pr-preview/pr-25/manual#integraciones-con-terceros","Integraciones con terceros",{"_8091":374,"_22651":370,"_19215":33680,"_5":22801,"_15391":370,"_1609":33681},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_8091":375,"_22651":370,"_19215":33683,"_5":22801,"_15391":33673,"_1609":33684},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_8091":376,"_22651":370,"_19215":33686,"_5":22801,"_15391":33673,"_1609":33687},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_8091":377,"_22651":370,"_19215":33689,"_5":22801,"_15391":33673,"_1609":33690},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_8091":378,"_22651":370,"_19215":33692,"_5":22801,"_15391":33673,"_1609":33693},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_8091":379,"_22651":370,"_19215":33695,"_5":22801,"_15391":33673,"_1609":33696},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_8091":380,"_22651":370,"_19215":33698,"_5":22801,"_15391":33673,"_1609":33699},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_8091":381,"_22651":370,"_19215":33701,"_5":22801,"_15391":33673,"_1609":33702},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_8091":382,"_22651":370,"_19215":33704,"_5":22801,"_15391":33677,"_1609":33705},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_8091":383,"_22651":383,"_5":22796,"_1609":33707,"_22809":33708,"_19215":33709,"_15391":383},"Integración con AWS IoT Core",[32566,33665,33678],[],{"_8091":384,"_22651":383,"_19215":33711,"_5":22801,"_15391":383,"_1609":33712},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_8091":385,"_22651":383,"_5":22806,"_19215":33714,"_15391":33715,"_1609":33716},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_8091":386,"_22651":383,"_5":22806,"_19215":33718,"_15391":33719,"_1609":33720},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_8091":387,"_22651":383,"_5":22806,"_19215":33722,"_15391":33723,"_1609":33724},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_8091":388,"_22651":383,"_5":22806,"_19215":33726,"_15391":33727,"_1609":33728},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_8091":389,"_22651":383,"_5":22806,"_19215":33730,"_15391":33731,"_1609":33732},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_8091":390,"_22651":383,"_5":22806,"_19215":33734,"_15391":33735,"_1609":33736},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_8091":391,"_22651":383,"_5":22806,"_19215":33738,"_15391":33739,"_1609":33740},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#primary-account","Primary Account",{"_8091":392,"_22651":383,"_5":22806,"_19215":33742,"_15391":33743,"_1609":33744},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_8091":393,"_22651":383,"_5":22806,"_19215":33746,"_15391":33747,"_1609":33748},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_8091":394,"_22651":383,"_5":22806,"_19215":33750,"_15391":33751,"_1609":33752},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-none","Modo `none`",{"_8091":395,"_22651":383,"_5":22806,"_19215":33754,"_15391":33755,"_1609":33756},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-auto","Modo `auto`",{"_8091":396,"_22651":383,"_5":22806,"_19215":33758,"_15391":33759,"_1609":33760},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_8091":397,"_22651":383,"_5":22806,"_19215":33762,"_15391":33763,"_1609":33764},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_8091":398,"_22651":383,"_5":22806,"_19215":33766,"_15391":33767,"_1609":33768},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_8091":399,"_22651":383,"_5":22806,"_19215":33770,"_15391":33771,"_1609":33772},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_8091":400,"_22651":383,"_5":22806,"_19215":33774,"_15391":33775,"_1609":33776},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_8091":401,"_22651":383,"_5":22806,"_19215":33778,"_15391":33779,"_1609":33780},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_8091":402,"_22651":383,"_5":22806,"_19215":33782,"_15391":33783,"_1609":33784},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_8091":403,"_22651":383,"_5":22806,"_19215":33786,"_15391":33787,"_1609":33788},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_8091":404,"_22651":383,"_5":22806,"_19215":33790,"_15391":33791,"_1609":33792},[],"/docs/pr-preview/pr-25/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_8091":405,"_22651":383,"_19215":33794,"_5":22801,"_15391":383,"_1609":33795},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_8091":406,"_22651":383,"_19215":33797,"_5":22801,"_15391":383,"_1609":33798},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_8091":407,"_22651":383,"_19215":33800,"_5":22801,"_15391":383,"_1609":33801},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_8091":408,"_22651":383,"_19215":33803,"_5":22801,"_15391":33715,"_1609":33804},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_8091":409,"_22651":383,"_19215":33806,"_5":22801,"_15391":33715,"_1609":33807},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_8091":410,"_22651":383,"_19215":33809,"_5":22801,"_15391":33715,"_1609":33810},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_8091":411,"_22651":383,"_19215":33812,"_5":22801,"_15391":33715,"_1609":33813},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_8091":412,"_22651":383,"_19215":33815,"_5":22801,"_15391":33719,"_1609":33816},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_8091":413,"_22651":383,"_19215":33818,"_5":22801,"_15391":33723,"_1609":33819},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_8091":414,"_22651":383,"_19215":33821,"_5":22801,"_15391":33723,"_1609":33822},[],"Acción IAM",{"_8091":415,"_22651":383,"_19215":33824,"_5":22801,"_15391":33723,"_1609":33825},[],"Propósito",{"_8091":416,"_22651":383,"_19215":33827,"_5":22801,"_15391":33723,"_1609":33828},[],"`iot:GetRegistrationCode`",{"_8091":417,"_22651":383,"_19215":33830,"_5":22801,"_15391":33723,"_1609":33831},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_8091":418,"_22651":383,"_19215":33833,"_5":22801,"_15391":33723,"_1609":33834},[],"`iot:RegisterCACertificate`",{"_8091":419,"_22651":383,"_19215":33836,"_5":22801,"_15391":33723,"_1609":33837},[],"Registrar la CA en AWS IoT",{"_8091":420,"_22651":383,"_19215":33839,"_5":22801,"_15391":33723,"_1609":33840},[],"`iot:DescribeCACertificate`",{"_8091":421,"_22651":383,"_19215":33842,"_5":22801,"_15391":33723,"_1609":33843},[],"Consultar el estado del registro de la CA",{"_8091":422,"_22651":383,"_19215":33845,"_5":22801,"_15391":33723,"_1609":33846},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_8091":423,"_22651":383,"_19215":33848,"_5":22801,"_15391":33723,"_1609":33849},[],"Crear o actualizar Things en IoT Core",{"_8091":424,"_22651":383,"_19215":33851,"_5":22801,"_15391":33723,"_1609":33852},[],"`iot:RegisterThing`",{"_8091":425,"_22651":383,"_19215":33854,"_5":22801,"_15391":33723,"_1609":33855},[],"Aprovisionar Things mediante plantilla",{"_8091":426,"_22651":383,"_19215":33857,"_5":22801,"_15391":33723,"_1609":33858},[],"`iot:RegisterCertificate`",{"_8091":427,"_22651":383,"_19215":33860,"_5":22801,"_15391":33723,"_1609":33861},[],"Registrar certificados de dispositivo",{"_8091":428,"_22651":383,"_19215":33863,"_5":22801,"_15391":33723,"_1609":33864},[],"`iot:UpdateCertificate`",{"_8091":429,"_22651":383,"_19215":33866,"_5":22801,"_15391":33723,"_1609":33867},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_8091":430,"_22651":383,"_19215":33869,"_5":22801,"_15391":33723,"_1609":33870},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_8091":431,"_22651":383,"_19215":33872,"_5":22801,"_15391":33723,"_1609":33873},[],"Crear y adjuntar políticas IoT",{"_8091":432,"_22651":383,"_19215":33875,"_5":22801,"_15391":33723,"_1609":33876},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_8091":433,"_22651":383,"_19215":33878,"_5":22801,"_15391":33723,"_1609":33879},[],"Gestionar grupos de Things",{"_8091":434,"_22651":383,"_19215":33881,"_5":22801,"_15391":33723,"_1609":33882},[],"`iot:CreateProvisioningTemplate`",{"_8091":435,"_22651":383,"_19215":33884,"_5":22801,"_15391":33723,"_1609":33885},[],"Crear plantillas JITP",{"_8091":436,"_22651":383,"_19215":33887,"_5":22801,"_15391":33723,"_1609":33888},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_8091":437,"_22651":383,"_19215":33890,"_5":22801,"_15391":33723,"_1609":33891},[],"Leer y escribir el Device Shadow",{"_8091":438,"_22651":383,"_19215":33893,"_5":22801,"_15391":33723,"_1609":33894},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_8091":439,"_22651":383,"_19215":33896,"_5":22801,"_15391":33727,"_1609":33897},[],"Parámetro",{"_8091":440,"_22651":383,"_19215":33899,"_5":22801,"_15391":33727,"_1609":33900},[],"Tipo",{"_8091":441,"_22651":383,"_19215":33902,"_5":22801,"_15391":33727,"_1609":33903},[],"Requerido",{"_8091":442,"_22651":383,"_19215":33905,"_5":22801,"_15391":33727,"_1609":32769},[],{"_8091":443,"_22651":383,"_19215":33907,"_5":22801,"_15391":33727,"_1609":33908},[],"`connector_id`",{"_8091":444,"_22651":383,"_19215":33910,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":445,"_22651":383,"_19215":33912,"_5":22801,"_15391":33727,"_1609":33913},[],"Sí",{"_8091":446,"_22651":383,"_19215":33915,"_5":22801,"_15391":33727,"_1609":33916},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_8091":447,"_22651":383,"_19215":33918,"_5":22801,"_15391":33727,"_1609":33919},[],"`aws_config.region`",{"_8091":448,"_22651":383,"_19215":33921,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":449,"_22651":383,"_19215":33923,"_5":22801,"_15391":33727,"_1609":33913},[],{"_8091":450,"_22651":383,"_19215":33925,"_5":22801,"_15391":33727,"_1609":33926},[],"Región AWS donde opera el conector.",{"_8091":451,"_22651":383,"_19215":33928,"_5":22801,"_15391":33727,"_1609":33929},[],"`aws_config.auth_method`",{"_8091":452,"_22651":383,"_19215":33931,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":453,"_22651":383,"_19215":33933,"_5":22801,"_15391":33727,"_1609":33913},[],{"_8091":454,"_22651":383,"_19215":33935,"_5":22801,"_15391":33727,"_1609":33936},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_8091":455,"_22651":383,"_19215":33938,"_5":22801,"_15391":33727,"_1609":33939},[],"`aws_config.access_key_id`",{"_8091":456,"_22651":383,"_19215":33941,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":457,"_22651":383,"_19215":33943,"_5":22801,"_15391":33727,"_1609":33944},[],"Solo con `auth_method=static`",{"_8091":458,"_22651":383,"_19215":33946,"_5":22801,"_15391":33727,"_1609":33947},[],"Clave de acceso AWS.",{"_8091":459,"_22651":383,"_19215":33949,"_5":22801,"_15391":33727,"_1609":33950},[],"`aws_config.secret_access_key`",{"_8091":460,"_22651":383,"_19215":33952,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":461,"_22651":383,"_19215":33954,"_5":22801,"_15391":33727,"_1609":33944},[],{"_8091":462,"_22651":383,"_19215":33956,"_5":22801,"_15391":33727,"_1609":33957},[],"Clave secreta AWS.",{"_8091":463,"_22651":383,"_19215":33959,"_5":22801,"_15391":33727,"_1609":33960},[],"`aws_config.session_token`",{"_8091":464,"_22651":383,"_19215":33962,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":465,"_22651":383,"_19215":33964,"_5":22801,"_15391":33727,"_1609":33965},[],"No",{"_8091":466,"_22651":383,"_19215":33967,"_5":22801,"_15391":33727,"_1609":33968},[],"Token de sesión (con `auth_method=static`).",{"_8091":467,"_22651":383,"_19215":33970,"_5":22801,"_15391":33727,"_1609":33971},[],"`aws_config.role_arn`",{"_8091":468,"_22651":383,"_19215":33973,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":469,"_22651":383,"_19215":33975,"_5":22801,"_15391":33727,"_1609":33976},[],"Solo con `auth_method=role`",{"_8091":470,"_22651":383,"_19215":33978,"_5":22801,"_15391":33727,"_1609":33979},[],"ARN del rol a asumir.",{"_8091":471,"_22651":383,"_19215":33981,"_5":22801,"_15391":33727,"_1609":33982},[],"`aws_config.endpoint_url`",{"_8091":472,"_22651":383,"_19215":33984,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":473,"_22651":383,"_19215":33986,"_5":22801,"_15391":33727,"_1609":33965},[],{"_8091":474,"_22651":383,"_19215":33988,"_5":22801,"_15391":33727,"_1609":33989},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_8091":475,"_22651":383,"_19215":33991,"_5":22801,"_15391":33727,"_1609":33992},[],"`subscriber_event_bus`",{"_8091":476,"_22651":383,"_19215":33994,"_5":22801,"_15391":33727,"_1609":19520},[],{"_8091":477,"_22651":383,"_19215":33996,"_5":22801,"_15391":33727,"_1609":33913},[],{"_8091":478,"_22651":383,"_19215":33998,"_5":22801,"_15391":33727,"_1609":33999},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_8091":479,"_22651":383,"_19215":34001,"_5":22801,"_15391":33727,"_1609":34002},[],"`dms_manager_client`",{"_8091":480,"_22651":383,"_19215":34004,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":481,"_22651":383,"_19215":34006,"_5":22801,"_15391":33727,"_1609":33913},[],{"_8091":482,"_22651":383,"_19215":34008,"_5":22801,"_15391":33727,"_1609":34009},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_8091":483,"_22651":383,"_19215":34011,"_5":22801,"_15391":33727,"_1609":34012},[],"`device_manager_client`",{"_8091":484,"_22651":383,"_19215":34014,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":485,"_22651":383,"_19215":34016,"_5":22801,"_15391":33727,"_1609":33913},[],{"_8091":486,"_22651":383,"_19215":34018,"_5":22801,"_15391":33727,"_1609":34019},[],"URL HTTP del Device Manager de Lamassu.",{"_8091":487,"_22651":383,"_19215":34021,"_5":22801,"_15391":33727,"_1609":34022},[],"`ca_client`",{"_8091":488,"_22651":383,"_19215":34024,"_5":22801,"_15391":33727,"_1609":11747},[],{"_8091":489,"_22651":383,"_19215":34026,"_5":22801,"_15391":33727,"_1609":33913},[],{"_8091":490,"_22651":383,"_19215":34028,"_5":22801,"_15391":33727,"_1609":34029},[],"URL HTTP del servicio de CA de Lamassu.",{"_8091":491,"_22651":383,"_19215":34031,"_5":22801,"_15391":33731,"_1609":34032},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_8091":492,"_22651":383,"_19215":34034,"_5":22801,"_15391":33735,"_1609":34035},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_8091":493,"_22651":383,"_19215":34037,"_5":22801,"_15391":33735,"_1609":34038},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_8091":494,"_22651":383,"_19215":34040,"_5":22801,"_15391":33739,"_1609":34041},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_8091":495,"_22651":383,"_19215":34043,"_5":22801,"_15391":33739,"_1609":34044},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_8091":496,"_22651":383,"_19215":34046,"_5":22801,"_15391":33739,"_1609":34047},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_8091":497,"_22651":383,"_19215":34049,"_5":22801,"_15391":33739,"_1609":34050},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_8091":498,"_22651":383,"_19215":34052,"_5":22801,"_15391":33739,"_1609":34053},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_8091":499,"_22651":383,"_19215":34055,"_5":22801,"_15391":33739,"_1609":34056},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_8091":500,"_22651":383,"_19215":34058,"_5":22801,"_15391":33743,"_1609":34059},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_8091":501,"_22651":383,"_19215":34061,"_5":22801,"_15391":33747,"_1609":34062},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_8091":502,"_22651":383,"_19215":34064,"_5":22801,"_15391":33747,"_1609":34065},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_8091":503,"_22651":383,"_19215":34067,"_5":22801,"_15391":33751,"_1609":34068},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_8091":504,"_22651":383,"_19215":34070,"_5":22801,"_15391":33755,"_1609":34071},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_8091":505,"_22651":383,"_19215":34073,"_5":22801,"_15391":33755,"_1609":34074},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_8091":506,"_22651":383,"_19215":34076,"_5":22801,"_15391":33755,"_1609":34077},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_8091":507,"_22651":383,"_19215":34079,"_5":22801,"_15391":33755,"_1609":34080},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_8091":508,"_22651":383,"_19215":34082,"_5":22801,"_15391":33755,"_1609":34083},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_8091":509,"_22651":383,"_19215":34085,"_5":22801,"_15391":33755,"_1609":34086},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_8091":510,"_22651":383,"_19215":34088,"_5":22801,"_15391":33759,"_1609":34089},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_8091":511,"_22651":383,"_19215":34091,"_5":22801,"_15391":33759,"_1609":34092},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_8091":512,"_22651":383,"_19215":34094,"_5":22801,"_15391":33759,"_1609":34095},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_8091":513,"_22651":383,"_19215":34097,"_5":22801,"_15391":33763,"_1609":34098},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_8091":514,"_22651":383,"_19215":34100,"_5":22801,"_15391":33763,"_1609":34101},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_8091":515,"_22651":383,"_19215":34103,"_5":22801,"_15391":33763,"_1609":34104},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_8091":516,"_22651":383,"_19215":34106,"_5":22801,"_15391":33767,"_1609":34107},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_8091":517,"_22651":383,"_19215":34109,"_5":22801,"_15391":33767,"_1609":34110},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_8091":518,"_22651":383,"_19215":34112,"_5":22801,"_15391":33767,"_1609":34113},[],"Para que el flujo JITP funcione correctamente:",{"_8091":519,"_22651":383,"_19215":34115,"_5":22801,"_15391":33767,"_1609":34116},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_8091":520,"_22651":383,"_19215":34118,"_5":22801,"_15391":33767,"_1609":34119},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_8091":521,"_22651":383,"_19215":34121,"_5":22801,"_15391":33767,"_1609":34122},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_8091":522,"_22651":383,"_19215":34124,"_5":22801,"_15391":33767,"_1609":34125},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_8091":523,"_22651":383,"_19215":34127,"_5":22801,"_15391":33771,"_1609":34128},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_8091":524,"_22651":383,"_19215":34130,"_5":22801,"_15391":33771,"_1609":34131},[],"Estado en Lamassu",{"_8091":525,"_22651":383,"_19215":34133,"_5":22801,"_15391":33771,"_1609":34134},[],"Razón de revocación",{"_8091":526,"_22651":383,"_19215":34136,"_5":22801,"_15391":33771,"_1609":34137},[],"Estado en AWS IoT Core",{"_8091":527,"_22651":383,"_19215":34139,"_5":22801,"_15391":33771,"_1609":34140},[],"`Active`",{"_8091":528,"_22651":383,"_19215":34142,"_5":22801,"_15391":33771,"_1609":34143},[],"—",{"_8091":529,"_22651":383,"_19215":34145,"_5":22801,"_15391":33771,"_1609":34146},[],"`ACTIVE`",{"_8091":530,"_22651":383,"_19215":34148,"_5":22801,"_15391":33771,"_1609":34149},[],"`Revoked`",{"_8091":531,"_22651":383,"_19215":34151,"_5":22801,"_15391":33771,"_1609":34152},[],"`certificateHold`",{"_8091":532,"_22651":383,"_19215":34154,"_5":22801,"_15391":33771,"_1609":34155},[],"`INACTIVE`",{"_8091":533,"_22651":383,"_19215":34157,"_5":22801,"_15391":33771,"_1609":34149},[],{"_8091":534,"_22651":383,"_19215":34159,"_5":22801,"_15391":33771,"_1609":34160},[],"Cualquier otra razón",{"_8091":535,"_22651":383,"_19215":34162,"_5":22801,"_15391":33771,"_1609":34163},[],"`REVOKED`",{"_8091":536,"_22651":383,"_19215":34165,"_5":22801,"_15391":33771,"_1609":34166},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_8091":537,"_22651":383,"_19215":34168,"_5":22801,"_15391":33775,"_1609":34169},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_8091":538,"_22651":383,"_19215":34171,"_5":22801,"_15391":33775,"_1609":34172},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_8091":539,"_22651":383,"_19215":34174,"_5":22801,"_15391":33775,"_1609":34175},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_8091":540,"_22651":383,"_19215":34177,"_5":22801,"_15391":33779,"_1609":34178},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_8091":541,"_22651":383,"_19215":34180,"_5":22801,"_15391":33779,"_1609":34181},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_8091":542,"_22651":383,"_19215":34183,"_5":22801,"_15391":33783,"_1609":34184},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_8091":543,"_22651":383,"_19215":34186,"_5":22801,"_15391":33783,"_1609":34187},[],"Existen dos tipos de acciones:",{"_8091":544,"_22651":383,"_19215":34189,"_5":22801,"_15391":33783,"_1609":34190},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_8091":545,"_22651":383,"_19215":34192,"_5":22801,"_15391":33783,"_1609":34193},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_8091":546,"_22651":383,"_19215":34195,"_5":22801,"_15391":33783,"_1609":34196},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_8091":547,"_22651":383,"_19215":34198,"_5":22801,"_15391":33787,"_1609":34199},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_8091":548,"_22651":383,"_19215":34201,"_5":22801,"_15391":33787,"_1609":34202},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_8091":549,"_22651":383,"_19215":34204,"_5":22801,"_15391":33787,"_1609":34205},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_8091":550,"_22651":383,"_19215":34207,"_5":22801,"_15391":33791,"_1609":34208},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_8091":551,"_22651":383,"_19215":34210,"_5":22801,"_15391":33791,"_1609":34211},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_8091":552,"_22651":383,"_19215":34213,"_5":22801,"_15391":33791,"_1609":34214},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_8091":553,"_22651":383,"_19215":34216,"_5":22801,"_15391":33791,"_1609":34217},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_8091":554,"_22651":383,"_19215":34219,"_5":22801,"_15391":33791,"_1609":34220},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_8091":555,"_22651":383,"_19215":34222,"_5":22801,"_15391":33791,"_1609":34223},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_8091":556,"_22651":383,"_19215":34225,"_5":22801,"_15391":33791,"_1609":34226},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_8091":557,"_22651":383,"_19215":34228,"_5":22801,"_15391":33791,"_1609":34229},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_8091":558,"_22651":383,"_19215":34231,"_5":22801,"_15391":33791,"_1609":34232},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_8091":559,"_22651":383,"_19215":34234,"_5":22801,"_15391":33791,"_1609":34235},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_8091":560,"_22651":383,"_19215":34237,"_5":22801,"_15391":33791,"_1609":34238},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_8091":561,"_22651":383,"_19215":34240,"_5":22801,"_15391":33791,"_1609":34241},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_8091":562,"_22651":383,"_19215":34243,"_5":22801,"_15391":33791,"_1609":34244},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_8091":563,"_22651":383,"_19215":34246,"_5":22801,"_15391":33791,"_1609":34247},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_8091":564,"_22651":383,"_19215":34249,"_5":22801,"_15391":33791,"_1609":34250},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_8091":565,"_22651":383,"_19215":34252,"_5":22801,"_15391":33791,"_1609":34253},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_8091":566,"_22651":383,"_19215":34255,"_5":22801,"_15391":33791,"_1609":34256},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_8091":567,"_22651":383,"_19215":34258,"_5":22801,"_15391":33791,"_1609":34259},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_8091":568,"_22651":383,"_19215":34261,"_5":22801,"_15391":33791,"_1609":34262},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_8091":569,"_22651":383,"_19215":34264,"_5":22801,"_15391":33791,"_1609":34265},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_8091":570,"_22651":383,"_19215":34267,"_5":22801,"_15391":33791,"_1609":34268},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_8091":571,"_22651":571,"_5":22796,"_1609":34270,"_22809":34271,"_19215":34272,"_15391":571},"[Alerts] Alertas y Suscripciones",[32566,33665,33674],[],{"_8091":572,"_22651":571,"_19215":34274,"_5":22801,"_15391":571,"_1609":34275},[],"Monitorización proactiva mediante eventos y suscripciones",{"_8091":573,"_22651":571,"_5":22806,"_19215":34277,"_15391":34278,"_1609":34279},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#alertas","Alertas",{"_8091":574,"_22651":571,"_5":22806,"_19215":34281,"_15391":34282,"_1609":34283},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_8091":575,"_22651":571,"_5":22806,"_19215":34285,"_15391":34286,"_1609":34287},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_8091":576,"_22651":571,"_5":22806,"_19215":34289,"_15391":34290,"_1609":34291},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_8091":577,"_22651":571,"_5":22806,"_19215":34293,"_15391":34294,"_1609":34295},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_8091":578,"_22651":571,"_5":22806,"_19215":34297,"_15391":34298,"_1609":34299},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_8091":579,"_22651":571,"_5":22806,"_19215":34301,"_15391":34302,"_1609":34303},[],"/docs/pr-preview/pr-25/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_8091":580,"_22651":571,"_19215":34305,"_5":22801,"_15391":34278,"_1609":34306},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_8091":581,"_22651":571,"_19215":34308,"_5":22801,"_15391":34282,"_1609":34309},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_8091":582,"_22651":571,"_19215":34311,"_5":22801,"_15391":34282,"_1609":34312},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_8091":583,"_22651":571,"_19215":34314,"_5":22801,"_15391":34282,"_1609":34315},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_8091":584,"_22651":571,"_19215":34317,"_5":22801,"_15391":34282,"_1609":34318},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_8091":585,"_22651":571,"_19215":34320,"_5":22801,"_15391":34282,"_1609":34321},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_8091":586,"_22651":571,"_19215":34323,"_5":22801,"_15391":34282,"_1609":34324},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_8091":587,"_22651":571,"_19215":34326,"_5":22801,"_15391":34286,"_1609":34327},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_8091":588,"_22651":571,"_19215":34329,"_5":22801,"_15391":34286,"_1609":34330},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_8091":589,"_22651":571,"_19215":34332,"_5":22801,"_15391":34286,"_1609":34333},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_8091":590,"_22651":571,"_19215":34335,"_5":22801,"_15391":34286,"_1609":34336},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_8091":591,"_22651":571,"_19215":34338,"_5":22801,"_15391":34286,"_1609":34339},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_8091":592,"_22651":571,"_19215":34341,"_5":22801,"_15391":34290,"_1609":34342},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_8091":593,"_22651":571,"_19215":34344,"_5":22801,"_15391":34290,"_1609":34345},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_8091":594,"_22651":571,"_19215":34347,"_5":22801,"_15391":34290,"_1609":34348},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_8091":595,"_22651":571,"_19215":34350,"_5":22801,"_15391":34290,"_1609":34351},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_8091":596,"_22651":571,"_19215":34353,"_5":22801,"_15391":34290,"_1609":34354},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_8091":597,"_22651":571,"_19215":34356,"_5":22801,"_15391":34294,"_1609":34357},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_8091":598,"_22651":571,"_19215":34359,"_5":22801,"_15391":34294,"_1609":34360},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_8091":599,"_22651":571,"_19215":34362,"_5":22801,"_15391":34298,"_1609":34363},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_8091":600,"_22651":571,"_19215":34365,"_5":22801,"_15391":34298,"_1609":34366},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_8091":601,"_22651":571,"_19215":34368,"_5":22801,"_15391":34298,"_1609":34369},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_8091":602,"_22651":571,"_19215":34371,"_5":22801,"_15391":34298,"_1609":34372},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_8091":603,"_22651":571,"_19215":34374,"_5":22801,"_15391":34302,"_1609":34375},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_8091":604,"_22651":571,"_19215":34377,"_5":22801,"_15391":34302,"_1609":34378},[],"Evento",{"_8091":605,"_22651":571,"_19215":34380,"_5":22801,"_15391":34302,"_1609":32769},[],{"_8091":606,"_22651":571,"_19215":34382,"_5":22801,"_15391":34302,"_1609":34383},[],"**ca.create**",{"_8091":607,"_22651":571,"_19215":34385,"_5":22801,"_15391":34302,"_1609":34386},[],"Creación de una CA",{"_8091":608,"_22651":571,"_19215":34388,"_5":22801,"_15391":34302,"_1609":34389},[],"**ca.import**",{"_8091":609,"_22651":571,"_19215":34391,"_5":22801,"_15391":34302,"_1609":34392},[],"Importación de una CA",{"_8091":610,"_22651":571,"_19215":34394,"_5":22801,"_15391":34302,"_1609":34395},[],"**ca.profile.update**",{"_8091":611,"_22651":571,"_19215":34397,"_5":22801,"_15391":34302,"_1609":34398},[],"Actualización de perfil de CA",{"_8091":612,"_22651":571,"_19215":34400,"_5":22801,"_15391":34302,"_1609":34401},[],"**ca.reissue**",{"_8091":613,"_22651":571,"_19215":34403,"_5":22801,"_15391":34302,"_1609":34404},[],"Reemisión de una CA",{"_8091":614,"_22651":571,"_19215":34406,"_5":22801,"_15391":34302,"_1609":34407},[],"**ca.sign.certificate**",{"_8091":615,"_22651":571,"_19215":34409,"_5":22801,"_15391":34302,"_1609":34410},[],"Firma / emisión de certificado",{"_8091":616,"_22651":571,"_19215":34412,"_5":22801,"_15391":34302,"_1609":34413},[],"**ca.signature.sign**",{"_8091":617,"_22651":571,"_19215":34415,"_5":22801,"_15391":34302,"_1609":34416},[],"Operación de firma criptográfica",{"_8091":618,"_22651":571,"_19215":34418,"_5":22801,"_15391":34302,"_1609":34419},[],"**ca.delete**",{"_8091":619,"_22651":571,"_19215":34421,"_5":22801,"_15391":34302,"_1609":34422},[],"Eliminación de una CA",{"_8091":620,"_22651":571,"_19215":34424,"_5":22801,"_15391":34302,"_1609":34425},[],"**certificate.delete**",{"_8091":621,"_22651":571,"_19215":34427,"_5":22801,"_15391":34302,"_1609":34428},[],"Eliminación de un certificado",{"_8091":622,"_22651":571,"_19215":34430,"_5":22801,"_15391":34302,"_1609":34431},[],"**profile.create**",{"_8091":623,"_22651":571,"_19215":34433,"_5":22801,"_15391":34302,"_1609":34434},[],"Creación de perfil de emisión",{"_8091":624,"_22651":571,"_19215":34436,"_5":22801,"_15391":34302,"_1609":34437},[],"**profile.update**",{"_8091":625,"_22651":571,"_19215":34439,"_5":22801,"_15391":34302,"_1609":34440},[],"Actualización de perfil de emisión",{"_8091":626,"_22651":571,"_19215":34442,"_5":22801,"_15391":34302,"_1609":34443},[],"**profile.delete**",{"_8091":627,"_22651":571,"_19215":34445,"_5":22801,"_15391":34302,"_1609":34446},[],"Eliminación de perfil de emisión",{"_8091":628,"_22651":571,"_19215":34448,"_5":22801,"_15391":34302,"_1609":34449},[],"**dms.create**",{"_8091":629,"_22651":571,"_19215":34451,"_5":22801,"_15391":34302,"_1609":34452},[],"Creación de un DMS",{"_8091":630,"_22651":571,"_19215":34454,"_5":22801,"_15391":34302,"_1609":34455},[],"**dms.update**",{"_8091":631,"_22651":571,"_19215":34457,"_5":22801,"_15391":34302,"_1609":34458},[],"Actualización de un DMS",{"_8091":632,"_22651":571,"_19215":34460,"_5":22801,"_15391":34302,"_1609":34461},[],"**dms.delete**",{"_8091":633,"_22651":571,"_19215":34463,"_5":22801,"_15391":34302,"_1609":34464},[],"Eliminación de un DMS",{"_8091":634,"_22651":571,"_19215":34466,"_5":22801,"_15391":34302,"_1609":34467},[],"**dms.enroll**",{"_8091":635,"_22651":571,"_19215":34469,"_5":22801,"_15391":34302,"_1609":34470},[],"Inscripción (enroll) de dispositivo",{"_8091":636,"_22651":571,"_19215":34472,"_5":22801,"_15391":34302,"_1609":34473},[],"**dms.reenroll**",{"_8091":637,"_22651":571,"_19215":34475,"_5":22801,"_15391":34302,"_1609":34476},[],"Re-inscripción (reenroll) de dispositivo",{"_8091":638,"_22651":571,"_19215":34478,"_5":22801,"_15391":34302,"_1609":34479},[],"**dms.bind-device-id**",{"_8091":639,"_22651":571,"_19215":34481,"_5":22801,"_15391":34302,"_1609":34482},[],"Asociación de identidad a dispositivo",{"_8091":640,"_22651":571,"_19215":34484,"_5":22801,"_15391":34302,"_1609":34485},[],"**device.create**",{"_8091":641,"_22651":571,"_19215":34487,"_5":22801,"_15391":34302,"_1609":34488},[],"Creación de dispositivo",{"_8091":642,"_22651":571,"_19215":34490,"_5":22801,"_15391":34302,"_1609":34491},[],"**device.identity.update**",{"_8091":643,"_22651":571,"_19215":34493,"_5":22801,"_15391":34302,"_1609":34494},[],"Actualización de identidad del dispositivo",{"_8091":644,"_22651":571,"_19215":34496,"_5":22801,"_15391":34302,"_1609":34497},[],"**device.status.update**",{"_8091":645,"_22651":571,"_19215":34499,"_5":22801,"_15391":34302,"_1609":34500},[],"Cambio de estado del dispositivo",{"_8091":646,"_22651":571,"_19215":34502,"_5":22801,"_15391":34302,"_1609":34503},[],"**device.metadata.update**",{"_8091":647,"_22651":571,"_19215":34505,"_5":22801,"_15391":34302,"_1609":34506},[],"Actualización de metadatos del dispositivo",{"_8091":648,"_22651":571,"_19215":34508,"_5":22801,"_15391":34302,"_1609":34509},[],"**device.delete**",{"_8091":649,"_22651":571,"_19215":34511,"_5":22801,"_15391":34302,"_1609":34512},[],"Eliminación de un dispositivo",{"_8091":650,"_22651":571,"_19215":34514,"_5":22801,"_15391":34302,"_1609":34515},[],"**va.role.crl.create**",{"_8091":651,"_22651":571,"_19215":34517,"_5":22801,"_15391":34302,"_1609":34518},[],"Cálculo/creación de CRL",{"_8091":652,"_22651":571,"_19215":34520,"_5":22801,"_15391":34302,"_1609":34521},[],"**kms.create**",{"_8091":653,"_22651":571,"_19215":34523,"_5":22801,"_15391":34302,"_1609":34524},[],"Creación de clave en KMS",{"_8091":654,"_22651":571,"_19215":34526,"_5":22801,"_15391":34302,"_1609":34527},[],"**kms.import**",{"_8091":655,"_22651":571,"_19215":34529,"_5":22801,"_15391":34302,"_1609":34530},[],"Importación de una clave KMS",{"_8091":656,"_22651":571,"_19215":34532,"_5":22801,"_15391":34302,"_1609":34533},[],"**kms.update.metadata**",{"_8091":657,"_22651":571,"_19215":34535,"_5":22801,"_15391":34302,"_1609":34536},[],"Actualización de metadatos de clave KMS",{"_8091":658,"_22651":571,"_19215":34538,"_5":22801,"_15391":34302,"_1609":34539},[],"**kms.update.aliases**",{"_8091":659,"_22651":571,"_19215":34541,"_5":22801,"_15391":34302,"_1609":34542},[],"Actualización de alias de clave KMS",{"_8091":660,"_22651":571,"_19215":34544,"_5":22801,"_15391":34302,"_1609":34545},[],"**kms.update.name**",{"_8091":661,"_22651":571,"_19215":34547,"_5":22801,"_15391":34302,"_1609":34548},[],"Cambio de nombre de una clave KMS",{"_8091":662,"_22651":571,"_19215":34550,"_5":22801,"_15391":34302,"_1609":34551},[],"**kms.update.tags**",{"_8091":663,"_22651":571,"_19215":34553,"_5":22801,"_15391":34302,"_1609":34554},[],"Actualización de etiquetas (tags) de clave KMS",{"_8091":664,"_22651":571,"_19215":34556,"_5":22801,"_15391":34302,"_1609":34557},[],"**kms.delete**",{"_8091":665,"_22651":571,"_19215":34559,"_5":22801,"_15391":34302,"_1609":34560},[],"Eliminación de una clave KMS",{"_8091":666,"_22651":571,"_19215":34562,"_5":22801,"_15391":34302,"_1609":34563},[],"**kms.sign.message**",{"_8091":667,"_22651":571,"_19215":34565,"_5":22801,"_15391":34302,"_1609":34566},[],"Firma de un mensaje con clave KMS",{"_8091":668,"_22651":571,"_19215":34568,"_5":22801,"_15391":34302,"_1609":34569},[],"**kms.verify.signature**",{"_8091":669,"_22651":571,"_19215":34571,"_5":22801,"_15391":34302,"_1609":34572},[],"Verificación de firma con clave KMS",{"_8091":670,"_22651":670,"_5":22796,"_1609":34574,"_22809":34575,"_19215":34576,"_15391":670},"[CA] Gestión de Entidades de Confianza",[32566,33665,33674],[],{"_8091":671,"_22651":670,"_19215":34578,"_5":22801,"_15391":670,"_1609":34579},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_8091":672,"_22651":670,"_5":22806,"_19215":34581,"_15391":34582,"_1609":34583},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_8091":673,"_22651":670,"_5":22806,"_19215":34585,"_15391":34586,"_1609":34587},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_8091":674,"_22651":670,"_5":22806,"_19215":34589,"_15391":34590,"_1609":34591},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_8091":675,"_22651":670,"_5":22806,"_19215":34593,"_15391":34594,"_1609":34595},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_8091":676,"_22651":670,"_5":22806,"_19215":34597,"_15391":34598,"_1609":34599},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_8091":677,"_22651":670,"_5":22806,"_19215":34601,"_15391":34602,"_1609":34603},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_8091":678,"_22651":670,"_5":22806,"_19215":34605,"_15391":34606,"_1609":34607},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_8091":679,"_22651":670,"_5":22806,"_19215":34609,"_15391":34610,"_1609":34611},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_8091":680,"_22651":670,"_5":22806,"_19215":34613,"_15391":34614,"_1609":34615},[],"/docs/pr-preview/pr-25/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_8091":681,"_22651":670,"_19215":34617,"_5":22801,"_15391":34586,"_1609":34618},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_8091":682,"_22651":670,"_19215":34620,"_5":22801,"_15391":34586,"_1609":34621},[],"Actualmente hay disponibles 3 acciones:",{"_8091":683,"_22651":670,"_19215":34623,"_5":22801,"_15391":34586,"_1609":34624},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_8091":684,"_22651":670,"_19215":34626,"_5":22801,"_15391":34586,"_1609":34627},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_8091":685,"_22651":670,"_19215":34629,"_5":22801,"_15391":34586,"_1609":34630},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_8091":686,"_22651":670,"_19215":34632,"_5":22801,"_15391":34590,"_1609":34633},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_8091":687,"_22651":670,"_19215":34635,"_5":22801,"_15391":34590,"_1609":34636},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_8091":688,"_22651":670,"_19215":34638,"_5":22801,"_15391":34590,"_1609":34639},[],"**Motor criptográfico**",{"_8091":689,"_22651":670,"_19215":34641,"_5":22801,"_15391":34590,"_1609":34642},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_8091":690,"_22651":670,"_19215":34644,"_5":22801,"_15391":34590,"_1609":34645},[],"**Ejemplo mostrado:** go1.24.3",{"_8091":691,"_22651":670,"_19215":34647,"_5":22801,"_15391":34590,"_1609":34648},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_8091":692,"_22651":670,"_19215":34650,"_5":22801,"_15391":34590,"_1609":34651},[],"**Parámetros de clave**",{"_8091":693,"_22651":670,"_19215":34653,"_5":22801,"_15391":34590,"_1609":34654},[],"**Key Type:** RSA, EC (Elliptic Curve), Ed25519 y los algoritmos post-cuánticos ML-DSA, SLH-DSA y Composite-ML-DSA",{"_8091":694,"_22651":670,"_19215":34656,"_5":22801,"_15391":34590,"_1609":34657},[],"**Key Size:**",{"_8091":695,"_22651":670,"_19215":34659,"_5":22801,"_15391":34590,"_1609":34660},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_8091":696,"_22651":670,"_19215":34662,"_5":22801,"_15391":34590,"_1609":34663},[],"EC: P-256, P-384, P-521",{"_8091":697,"_22651":670,"_19215":34665,"_5":22801,"_15391":34590,"_1609":34666},[],"Ed25519: 256 bits",{"_8091":698,"_22651":670,"_19215":34668,"_5":22801,"_15391":34590,"_1609":34669},[],"ML-DSA: niveles 44, 65 y 87",{"_8091":699,"_22651":670,"_19215":34671,"_5":22801,"_15391":34590,"_1609":34672},[],"SLH-DSA: juegos de parámetros del 1 al 12",{"_8091":700,"_22651":670,"_19215":34674,"_5":22801,"_15391":34590,"_1609":34675},[],"Composite-ML-DSA: variantes compuestas de ML-DSA con RSA, ECDSA o Ed25519",{"_8091":701,"_22651":670,"_19215":34677,"_5":22801,"_15391":34590,"_1609":34678},[],"**Recomendado:** EC P-384",{"_8091":702,"_22651":670,"_19215":34680,"_5":22801,"_15391":34590,"_1609":34681},[],"La disponibilidad de los algoritmos post-cuánticos depende del motor criptográfico seleccionado. Consulte la sección Tipos de clave y algoritmos soportados de la página del KMS para conocer la matriz soportada por cada motor.",{"_8091":703,"_22651":670,"_19215":34683,"_5":22801,"_15391":34590,"_1609":34684},[],"**Perfil de emisión del certificado de la CA**",{"_8091":704,"_22651":670,"_19215":34686,"_5":22801,"_15391":34590,"_1609":34687},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_8091":705,"_22651":670,"_19215":34689,"_5":22801,"_15391":34590,"_1609":34690},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_8091":706,"_22651":670,"_19215":34692,"_5":22801,"_15391":34590,"_1609":34693},[],"**Configuración de la CA**",{"_8091":707,"_22651":670,"_19215":34695,"_5":22801,"_15391":34590,"_1609":34696},[],"**Tipo de CA**",{"_8091":708,"_22651":670,"_19215":34698,"_5":22801,"_15391":34590,"_1609":34699},[],"**Root CA:** Autoridad raíz autofirmada",{"_8091":709,"_22651":670,"_19215":34701,"_5":22801,"_15391":34590,"_1609":34702},[],"**Intermediate CA:** Autoridad subordinada",{"_8091":710,"_22651":670,"_19215":34704,"_5":22801,"_15391":34590,"_1609":34705},[],"**Emisor**",{"_8091":711,"_22651":670,"_19215":34707,"_5":22801,"_15391":34590,"_1609":34708},[],"**Root CA:** Self-signed (auto-firmada)",{"_8091":712,"_22651":670,"_19215":34710,"_5":22801,"_15391":34590,"_1609":34711},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_8091":713,"_22651":670,"_19215":34713,"_5":22801,"_15391":34590,"_1609":34714},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_8091":714,"_22651":670,"_19215":34716,"_5":22801,"_15391":34590,"_1609":34717},[],"**Identificación**",{"_8091":715,"_22651":670,"_19215":34719,"_5":22801,"_15391":34590,"_1609":34720},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_8091":716,"_22651":670,"_19215":34722,"_5":22801,"_15391":34590,"_1609":34723},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_8091":717,"_22651":670,"_19215":34725,"_5":22801,"_15391":34590,"_1609":34726},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_8091":718,"_22651":670,"_19215":34728,"_5":22801,"_15391":34590,"_1609":34729},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_8091":719,"_22651":670,"_19215":34731,"_5":22801,"_15391":34590,"_1609":34732},[],"**Subject Distinguished Name (DN)**",{"_8091":720,"_22651":670,"_19215":34734,"_5":22801,"_15391":34590,"_1609":34735},[],"Campos opcionales:",{"_8091":721,"_22651":670,"_19215":34737,"_5":22801,"_15391":34590,"_1609":34738},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_8091":722,"_22651":670,"_19215":34740,"_5":22801,"_15391":34590,"_1609":34741},[],"Ejemplo: US, ES, DE",{"_8091":723,"_22651":670,"_19215":34743,"_5":22801,"_15391":34590,"_1609":34744},[],"**State/Province (ST):** Estado o provincia",{"_8091":724,"_22651":670,"_19215":34746,"_5":22801,"_15391":34590,"_1609":34747},[],"Ejemplo: California, Madrid",{"_8091":725,"_22651":670,"_19215":34749,"_5":22801,"_15391":34590,"_1609":34750},[],"**Locality (L):** Ciudad o localidad",{"_8091":726,"_22651":670,"_19215":34752,"_5":22801,"_15391":34590,"_1609":34753},[],"Ejemplo: San Francisco, Arrasate",{"_8091":727,"_22651":670,"_19215":34755,"_5":22801,"_15391":34590,"_1609":34756},[],"**Organization (O):** Nombre de la organización",{"_8091":728,"_22651":670,"_19215":34758,"_5":22801,"_15391":34590,"_1609":34759},[],"Ejemplo: Lamassu IoT Corp",{"_8091":729,"_22651":670,"_19215":34761,"_5":22801,"_15391":34590,"_1609":34762},[],"**Organizational Unit (OU):** Unidad organizacional",{"_8091":730,"_22651":670,"_19215":34764,"_5":22801,"_15391":34590,"_1609":34765},[],"Ejemplo: Secure Devices Division",{"_8091":731,"_22651":670,"_19215":34767,"_5":22801,"_15391":34590,"_1609":34768},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_8091":732,"_22651":670,"_19215":34770,"_5":22801,"_15391":34590,"_1609":34771},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_8091":733,"_22651":670,"_19215":34773,"_5":22801,"_15391":34590,"_1609":34774},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_8091":734,"_22651":670,"_19215":34776,"_5":22801,"_15391":34590,"_1609":34777},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_8091":735,"_22651":670,"_19215":34779,"_5":22801,"_15391":34590,"_1609":34780},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_8091":736,"_22651":670,"_19215":34782,"_5":22801,"_15391":34590,"_1609":34783},[],"**Duración:** Configurable según necesidades organizacionales",{"_8091":737,"_22651":670,"_19215":34785,"_5":22801,"_15391":34590,"_1609":34786},[],"**Valor por defecto:** 10 años (10y)",{"_8091":738,"_22651":670,"_19215":34788,"_5":22801,"_15391":34590,"_1609":34789},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_8091":739,"_22651":670,"_19215":34791,"_5":22801,"_15391":34590,"_1609":34792},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_8091":740,"_22651":670,"_19215":34794,"_5":22801,"_15391":34590,"_1609":34795},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_8091":741,"_22651":670,"_19215":34797,"_5":22801,"_15391":34590,"_1609":34798},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_8091":742,"_22651":670,"_19215":34800,"_5":22801,"_15391":34590,"_1609":34801},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_8091":743,"_22651":670,"_19215":34803,"_5":22801,"_15391":34590,"_1609":34804},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_8091":744,"_22651":670,"_19215":34806,"_5":22801,"_15391":34590,"_1609":34807},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_8091":745,"_22651":670,"_19215":34809,"_5":22801,"_15391":34590,"_1609":34810},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_8091":746,"_22651":670,"_19215":34812,"_5":22801,"_15391":34590,"_1609":34813},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_8091":747,"_22651":670,"_19215":34815,"_5":22801,"_15391":34590,"_1609":34816},[],"**Valor por defecto:** 1 año (1y)",{"_8091":748,"_22651":670,"_19215":34818,"_5":22801,"_15391":34590,"_1609":34819},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_8091":749,"_22651":670,"_19215":34821,"_5":22801,"_15391":34590,"_1609":34822},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_8091":750,"_22651":670,"_19215":34824,"_5":22801,"_15391":34594,"_1609":34825},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_8091":751,"_22651":670,"_19215":34827,"_5":22801,"_15391":34594,"_1609":34828},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_8091":752,"_22651":670,"_19215":34830,"_5":22801,"_15391":34594,"_1609":34831},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_8091":753,"_22651":670,"_19215":34833,"_5":22801,"_15391":34598,"_1609":34834},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_8091":754,"_22651":670,"_19215":34836,"_5":22801,"_15391":34598,"_1609":34837},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_8091":755,"_22651":670,"_19215":34839,"_5":22801,"_15391":34598,"_1609":34642},[],{"_8091":756,"_22651":670,"_19215":34841,"_5":22801,"_15391":34598,"_1609":34645},[],{"_8091":757,"_22651":670,"_19215":34843,"_5":22801,"_15391":34598,"_1609":34648},[],{"_8091":758,"_22651":670,"_19215":34845,"_5":22801,"_15391":34598,"_1609":34846},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_8091":759,"_22651":670,"_19215":34848,"_5":22801,"_15391":34598,"_1609":34807},[],{"_8091":760,"_22651":670,"_19215":34850,"_5":22801,"_15391":34598,"_1609":34810},[],{"_8091":761,"_22651":670,"_19215":34852,"_5":22801,"_15391":34598,"_1609":34813},[],{"_8091":762,"_22651":670,"_19215":34854,"_5":22801,"_15391":34598,"_1609":34816},[],{"_8091":763,"_22651":670,"_19215":34856,"_5":22801,"_15391":34598,"_1609":34819},[],{"_8091":764,"_22651":670,"_19215":34858,"_5":22801,"_15391":34598,"_1609":34859},[],"Se debe proporcionar de manera obligatoria:",{"_8091":765,"_22651":670,"_19215":34861,"_5":22801,"_15391":34598,"_1609":34862},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_8091":766,"_22651":670,"_19215":34864,"_5":22801,"_15391":34598,"_1609":34865},[],"Clave privada de la CA en formato PEM",{"_8091":767,"_22651":670,"_19215":34867,"_5":22801,"_15391":34598,"_1609":34868},[],"La clave privada importada puede corresponder a los algoritmos clásicos (RSA, ECDSA, Ed25519) o a los algoritmos post-cuánticos soportados por Lamassu (ML-DSA, SLH-DSA y Composite-ML-DSA), siempre que el motor seleccionado declare soporte para el algoritmo de la clave.",{"_8091":768,"_22651":670,"_19215":34870,"_5":22801,"_15391":34598,"_1609":34871},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_8091":769,"_22651":670,"_19215":34873,"_5":22801,"_15391":34606,"_1609":34874},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_8091":770,"_22651":670,"_19215":34876,"_5":22801,"_15391":34606,"_1609":34877},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_8091":771,"_22651":670,"_19215":34879,"_5":22801,"_15391":34606,"_1609":34880},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_8091":772,"_22651":670,"_19215":34882,"_5":22801,"_15391":34606,"_1609":34883},[],"Se ofrecen dos acciones:",{"_8091":773,"_22651":670,"_19215":34885,"_5":22801,"_15391":34606,"_1609":34886},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_8091":774,"_22651":670,"_19215":34888,"_5":22801,"_15391":34606,"_1609":34889},[],"la acción de revocación de la CA",{"_8091":775,"_22651":670,"_19215":34891,"_5":22801,"_15391":34606,"_1609":34892},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_8091":776,"_22651":670,"_19215":34894,"_5":22801,"_15391":34610,"_1609":34895},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_8091":777,"_22651":670,"_19215":34897,"_5":22801,"_15391":34610,"_1609":34898},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_8091":778,"_22651":670,"_19215":34900,"_5":22801,"_15391":34610,"_1609":34901},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_8091":779,"_22651":670,"_19215":34903,"_5":22801,"_15391":34610,"_1609":34904},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_8091":780,"_22651":670,"_19215":34906,"_5":22801,"_15391":34610,"_1609":34907},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_8091":781,"_22651":670,"_19215":34909,"_5":22801,"_15391":34610,"_1609":34910},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_8091":782,"_22651":670,"_19215":34912,"_5":22801,"_15391":34610,"_1609":34913},[],"Emisión a partir de un CSR generado de manera externa",{"_8091":783,"_22651":670,"_19215":34915,"_5":22801,"_15391":34610,"_1609":34916},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_8091":784,"_22651":670,"_19215":34918,"_5":22801,"_15391":34610,"_1609":34919},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_8091":785,"_22651":670,"_19215":34921,"_5":22801,"_15391":34610,"_1609":34922},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_8091":786,"_22651":670,"_19215":34924,"_5":22801,"_15391":34610,"_1609":34925},[],"**Certificate Subject (Sujeto del certificado)**",{"_8091":787,"_22651":670,"_19215":34927,"_5":22801,"_15391":34610,"_1609":34928},[],"**Common Name (CN)**",{"_8091":788,"_22651":670,"_19215":34930,"_5":22801,"_15391":34610,"_1609":34931},[],"**Campo:** Obligatorio",{"_8091":789,"_22651":670,"_19215":34933,"_5":22801,"_15391":34610,"_1609":34934},[],"**Función:** Identifica de forma única al titular del certificado",{"_8091":790,"_22651":670,"_19215":34936,"_5":22801,"_15391":34610,"_1609":34937},[],"**Ejemplos:**",{"_8091":791,"_22651":670,"_19215":34939,"_5":22801,"_15391":34610,"_1609":34940},[],"Para dispositivos: device001.company.com",{"_8091":792,"_22651":670,"_19215":34942,"_5":22801,"_15391":34610,"_1609":34943},[],"Para usuarios: john.doe\\@company.com",{"_8091":793,"_22651":670,"_19215":34945,"_5":22801,"_15391":34610,"_1609":34946},[],"Para servicios: api.service.company.com",{"_8091":794,"_22651":670,"_19215":34948,"_5":22801,"_15391":34610,"_1609":34949},[],"**Campos Organizacionales**",{"_8091":795,"_22651":670,"_19215":34951,"_5":22801,"_15391":34610,"_1609":34952},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_8091":796,"_22651":670,"_19215":34954,"_5":22801,"_15391":34610,"_1609":34955},[],"Ejemplo: IT Department, Manufacturing",{"_8091":797,"_22651":670,"_19215":34957,"_5":22801,"_15391":34610,"_1609":34756},[],{"_8091":798,"_22651":670,"_19215":34959,"_5":22801,"_15391":34610,"_1609":34960},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_8091":799,"_22651":670,"_19215":34962,"_5":22801,"_15391":34610,"_1609":34963},[],"**Información Geográfica**",{"_8091":800,"_22651":670,"_19215":34965,"_5":22801,"_15391":34610,"_1609":34966},[],"**Locality (L):** Ciudad o localidad del titular",{"_8091":801,"_22651":670,"_19215":34968,"_5":22801,"_15391":34610,"_1609":34744},[],{"_8091":802,"_22651":670,"_19215":34970,"_5":22801,"_15391":34610,"_1609":34971},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_8091":803,"_22651":670,"_19215":34973,"_5":22801,"_15391":34610,"_1609":34974},[],"Valor por defecto mostrado: US",{"_8091":804,"_22651":670,"_19215":34976,"_5":22801,"_15391":34610,"_1609":34977},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_8091":805,"_22651":670,"_19215":34979,"_5":22801,"_15391":34610,"_1609":34980},[],"**Tipos de SAN Disponibles**",{"_8091":806,"_22651":670,"_19215":34982,"_5":22801,"_15391":34610,"_1609":34983},[],"**DNS:** Nombres de dominio",{"_8091":807,"_22651":670,"_19215":34985,"_5":22801,"_15391":34610,"_1609":34986},[],"Ejemplo: example.com, \\*.example.com",{"_8091":808,"_22651":670,"_19215":34988,"_5":22801,"_15391":34610,"_1609":34989},[],"**IP Address:** Direcciones IP",{"_8091":809,"_22651":670,"_19215":34991,"_5":22801,"_15391":34610,"_1609":34992},[],"**Email:** Direcciones de correo electrónico",{"_8091":810,"_22651":670,"_19215":34994,"_5":22801,"_15391":34610,"_1609":34995},[],"**URI:** Identificadores de recursos uniformes",{"_8091":811,"_22651":670,"_19215":34997,"_5":22801,"_15391":34610,"_1609":34998},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_8091":812,"_22651":670,"_19215":35000,"_5":22801,"_15391":34610,"_1609":35001},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado.",{"_8091":813,"_22651":670,"_19215":35003,"_5":22801,"_15391":34610,"_1609":35004},[],"**Algorithm (Algoritmo)**",{"_8091":814,"_22651":670,"_19215":35006,"_5":22801,"_15391":34610,"_1609":35007},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_8091":815,"_22651":670,"_19215":35009,"_5":22801,"_15391":34610,"_1609":35010},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_8091":816,"_22651":670,"_19215":35012,"_5":22801,"_15391":34610,"_1609":35013},[],"**Certificate Configuration (Configuración del certificado)**",{"_8091":817,"_22651":670,"_19215":35015,"_5":22801,"_15391":34610,"_1609":35016},[],"**Validity Duration (Duración de validez)**",{"_8091":818,"_22651":670,"_19215":35018,"_5":22801,"_15391":34610,"_1609":35019},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_8091":819,"_22651":670,"_19215":35021,"_5":22801,"_15391":34610,"_1609":35022},[],"**Campo:** Configurable según necesidades",{"_8091":820,"_22651":670,"_19215":35024,"_5":22801,"_15391":34610,"_1609":34816},[],{"_8091":821,"_22651":670,"_19215":35026,"_5":22801,"_15391":34610,"_1609":35027},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_8091":822,"_22651":670,"_19215":35029,"_5":22801,"_15391":34610,"_1609":35030},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_8091":823,"_22651":670,"_19215":35032,"_5":22801,"_15391":34610,"_1609":35033},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_8091":824,"_22651":670,"_19215":35035,"_5":22801,"_15391":34610,"_1609":35036},[],"**Usos Básicos**",{"_8091":825,"_22651":670,"_19215":35038,"_5":22801,"_15391":34610,"_1609":35039},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_8091":826,"_22651":670,"_19215":35041,"_5":22801,"_15391":34610,"_1609":35042},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_8091":827,"_22651":670,"_19215":35044,"_5":22801,"_15391":34610,"_1609":35045},[],"**Key Encipherment:** Cifrado de claves",{"_8091":828,"_22651":670,"_19215":35047,"_5":22801,"_15391":34610,"_1609":35048},[],"**Data Encipherment:** Cifrado de datos",{"_8091":829,"_22651":670,"_19215":35050,"_5":22801,"_15391":34610,"_1609":35051},[],"**Key Agreement:** Acuerdo de claves",{"_8091":830,"_22651":670,"_19215":35053,"_5":22801,"_15391":34610,"_1609":35054},[],"**Certificate Signing:** Firma de certificados",{"_8091":831,"_22651":670,"_19215":35056,"_5":22801,"_15391":34610,"_1609":35057},[],"**CRL Signing:** Firma de listas de revocación",{"_8091":832,"_22651":670,"_19215":35059,"_5":22801,"_15391":34610,"_1609":35060},[],"**Encipher Only:** Solo cifrado",{"_8091":833,"_22651":670,"_19215":35062,"_5":22801,"_15391":34610,"_1609":35063},[],"**Decipher Only:** Solo descifrado",{"_8091":834,"_22651":670,"_19215":35065,"_5":22801,"_15391":34610,"_1609":35066},[],"**Uso Extendido de Claves**",{"_8091":835,"_22651":670,"_19215":35068,"_5":22801,"_15391":34610,"_1609":35069},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_8091":836,"_22651":670,"_19215":35071,"_5":22801,"_15391":34610,"_1609":35072},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_8091":837,"_22651":670,"_19215":35074,"_5":22801,"_15391":34610,"_1609":35075},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_8091":838,"_22651":670,"_19215":35077,"_5":22801,"_15391":34610,"_1609":35078},[],"**Code Signing:** Firma de código",{"_8091":839,"_22651":670,"_19215":35080,"_5":22801,"_15391":34610,"_1609":35081},[],"**Email Protection:** Protección de correo electrónico",{"_8091":840,"_22651":670,"_19215":35083,"_5":22801,"_15391":34610,"_1609":35084},[],"**Time Stamping:** Sellado de tiempo",{"_8091":841,"_22651":670,"_19215":35086,"_5":22801,"_15391":34610,"_1609":35087},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_8091":842,"_22651":670,"_19215":35089,"_5":22801,"_15391":34610,"_1609":35090},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_8091":843,"_22651":670,"_19215":35092,"_5":22801,"_15391":34610,"_1609":35093},[],"**Emisión a partir de un CSR generado de manera externa**",{"_8091":844,"_22651":670,"_19215":35095,"_5":22801,"_15391":34610,"_1609":35096},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_8091":845,"_22651":670,"_19215":35098,"_5":22801,"_15391":34610,"_1609":35099},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_8091":846,"_22651":670,"_19215":35101,"_5":22801,"_15391":34610,"_1609":35102},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_8091":847,"_22651":670,"_19215":35104,"_5":22801,"_15391":34614,"_1609":35105},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_8091":848,"_22651":670,"_19215":35107,"_5":22801,"_15391":34614,"_1609":35108},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_8091":849,"_22651":670,"_19215":35110,"_5":22801,"_15391":34614,"_1609":35111},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_8091":850,"_22651":670,"_19215":35113,"_5":22801,"_15391":34614,"_1609":35114},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_8091":851,"_22651":670,"_19215":35116,"_5":22801,"_15391":34614,"_1609":35117},[],"Unspecified (No especificado)",{"_8091":852,"_22651":670,"_19215":35119,"_5":22801,"_15391":34614,"_1609":35120},[],"KeyCompromise (Compromiso de clave)",{"_8091":853,"_22651":670,"_19215":35122,"_5":22801,"_15391":34614,"_1609":35123},[],"CACompromise (Compromiso de CA)",{"_8091":854,"_22651":670,"_19215":35125,"_5":22801,"_15391":34614,"_1609":35126},[],"AffiliationChanged (Afiliación cambiada)",{"_8091":855,"_22651":670,"_19215":35128,"_5":22801,"_15391":34614,"_1609":35129},[],"Superseded (Sustituida)",{"_8091":856,"_22651":670,"_19215":35131,"_5":22801,"_15391":34614,"_1609":35132},[],"CessationOfOperation (Cese de operación)",{"_8091":857,"_22651":670,"_19215":35134,"_5":22801,"_15391":34614,"_1609":35135},[],"CertificateHold (Retención de certificado)",{"_8091":858,"_22651":670,"_19215":35137,"_5":22801,"_15391":34614,"_1609":35138},[],"RemoveFromCRL (Eliminar de la CRL)",{"_8091":859,"_22651":670,"_19215":35140,"_5":22801,"_15391":34614,"_1609":35141},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_8091":860,"_22651":670,"_19215":35143,"_5":22801,"_15391":34614,"_1609":35144},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_8091":861,"_22651":670,"_19215":35146,"_5":22801,"_15391":34614,"_1609":35147},[],"Consideraciones importantes:",{"_8091":862,"_22651":670,"_19215":35149,"_5":22801,"_15391":34614,"_1609":35150},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_8091":863,"_22651":670,"_19215":35152,"_5":22801,"_15391":34614,"_1609":35153},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_8091":864,"_22651":864,"_5":22796,"_1609":35155,"_22809":35156,"_19215":35157,"_15391":864},"[Certs] Gestión de Certificados",[32566,33665,33674],[],{"_8091":865,"_22651":864,"_19215":35159,"_5":22801,"_15391":864,"_1609":35160},[],"Visualización y gestión de certificados emitidos",{"_8091":866,"_22651":864,"_5":22806,"_19215":35162,"_15391":35163,"_1609":35164},[],"/docs/pr-preview/pr-25/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_8091":867,"_22651":864,"_5":22806,"_19215":35166,"_15391":35167,"_1609":35168},[],"/docs/pr-preview/pr-25/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_8091":868,"_22651":864,"_19215":35170,"_5":22801,"_15391":35163,"_1609":35171},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_8091":869,"_22651":864,"_19215":35173,"_5":22801,"_15391":35163,"_1609":35174},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_8091":870,"_22651":864,"_19215":35176,"_5":22801,"_15391":35163,"_1609":35177},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_8091":871,"_22651":864,"_19215":35179,"_5":22801,"_15391":35167,"_1609":35180},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_8091":872,"_22651":864,"_19215":35182,"_5":22801,"_15391":35167,"_1609":35183},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_8091":873,"_22651":873,"_5":22796,"_1609":35185,"_22809":35186,"_19215":35187,"_15391":873},"[Devices] Dispositivos e Identidades",[32566,33665,33674],[],{"_8091":874,"_22651":873,"_19215":35189,"_5":22801,"_15391":873,"_1609":35190},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_8091":875,"_22651":873,"_5":22806,"_19215":35192,"_15391":35193,"_1609":35194},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_8091":876,"_22651":873,"_5":22806,"_19215":35196,"_15391":35197,"_1609":35198},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_8091":877,"_22651":873,"_5":22806,"_19215":35200,"_15391":35201,"_1609":35202},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_8091":878,"_22651":873,"_5":22806,"_19215":35204,"_15391":35205,"_1609":35206},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_8091":879,"_22651":873,"_5":22806,"_19215":35208,"_15391":35209,"_1609":35210},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_8091":880,"_22651":873,"_5":22806,"_19215":35212,"_15391":35213,"_1609":35214},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_8091":881,"_22651":873,"_5":22806,"_19215":35216,"_15391":35217,"_1609":35218},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_8091":882,"_22651":873,"_5":22806,"_19215":35220,"_15391":35221,"_1609":35222},[],"/docs/pr-preview/pr-25/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_8091":883,"_22651":873,"_19215":35224,"_5":22801,"_15391":35193,"_1609":35225},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_8091":884,"_22651":873,"_19215":35227,"_5":22801,"_15391":35197,"_1609":35228},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_8091":885,"_22651":873,"_19215":35230,"_5":22801,"_15391":35197,"_1609":35231},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_8091":886,"_22651":873,"_19215":35233,"_5":22801,"_15391":35197,"_1609":35234},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_8091":887,"_22651":873,"_19215":35236,"_5":22801,"_15391":35197,"_1609":35237},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_8091":888,"_22651":873,"_19215":35239,"_5":22801,"_15391":35197,"_1609":35240},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_8091":889,"_22651":873,"_19215":35242,"_5":22801,"_15391":35197,"_1609":35243},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_8091":890,"_22651":873,"_19215":35245,"_5":22801,"_15391":35197,"_1609":35246},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_8091":891,"_22651":873,"_19215":35248,"_5":22801,"_15391":35197,"_1609":35249},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_8091":892,"_22651":873,"_19215":35251,"_5":22801,"_15391":35197,"_1609":35252},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_8091":893,"_22651":873,"_19215":35254,"_5":22801,"_15391":35201,"_1609":35255},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_8091":894,"_22651":873,"_19215":35257,"_5":22801,"_15391":35201,"_1609":35258},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_8091":895,"_22651":873,"_19215":35260,"_5":22801,"_15391":35205,"_1609":35261},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_8091":896,"_22651":873,"_19215":35263,"_5":22801,"_15391":35205,"_1609":35264},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_8091":897,"_22651":873,"_19215":35266,"_5":22801,"_15391":35209,"_1609":35267},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_8091":898,"_22651":873,"_19215":35269,"_5":22801,"_15391":35209,"_1609":35270},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_8091":899,"_22651":873,"_19215":35272,"_5":22801,"_15391":35209,"_1609":35273},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_8091":900,"_22651":873,"_19215":35275,"_5":22801,"_15391":35209,"_1609":35276},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_8091":901,"_22651":873,"_19215":35278,"_5":22801,"_15391":35209,"_1609":35279},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_8091":902,"_22651":873,"_19215":35281,"_5":22801,"_15391":35209,"_1609":35282},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_8091":903,"_22651":873,"_19215":35284,"_5":22801,"_15391":35209,"_1609":35285},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_8091":904,"_22651":873,"_19215":35287,"_5":22801,"_15391":35209,"_1609":35288},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_8091":905,"_22651":873,"_19215":35290,"_5":22801,"_15391":35213,"_1609":35291},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_8091":906,"_22651":873,"_19215":35293,"_5":22801,"_15391":35213,"_1609":35294},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_8091":907,"_22651":873,"_19215":35296,"_5":22801,"_15391":35213,"_1609":35297},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_8091":908,"_22651":873,"_19215":35299,"_5":22801,"_15391":35213,"_1609":35300},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_8091":909,"_22651":873,"_19215":35302,"_5":22801,"_15391":35213,"_1609":35303},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_8091":910,"_22651":873,"_19215":35305,"_5":22801,"_15391":35213,"_1609":35306},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_8091":911,"_22651":873,"_19215":35308,"_5":22801,"_15391":35217,"_1609":35309},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_8091":912,"_22651":873,"_19215":35311,"_5":22801,"_15391":35217,"_1609":35312},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_8091":913,"_22651":873,"_19215":35314,"_5":22801,"_15391":35217,"_1609":35315},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_8091":914,"_22651":873,"_19215":35317,"_5":22801,"_15391":35217,"_1609":35318},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_8091":915,"_22651":873,"_19215":35320,"_5":22801,"_15391":35217,"_1609":35321},[],"**Unspecified**: Motivo de revocación no especificado.",{"_8091":916,"_22651":873,"_19215":35323,"_5":22801,"_15391":35217,"_1609":35324},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_8091":917,"_22651":873,"_19215":35326,"_5":22801,"_15391":35217,"_1609":35327},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_8091":918,"_22651":873,"_19215":35329,"_5":22801,"_15391":35217,"_1609":35330},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_8091":919,"_22651":873,"_19215":35332,"_5":22801,"_15391":35217,"_1609":35333},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_8091":920,"_22651":873,"_19215":35335,"_5":22801,"_15391":35217,"_1609":35336},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_8091":921,"_22651":873,"_19215":35338,"_5":22801,"_15391":35217,"_1609":35339},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_8091":922,"_22651":873,"_19215":35341,"_5":22801,"_15391":35217,"_1609":35342},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_8091":923,"_22651":873,"_19215":35344,"_5":22801,"_15391":35217,"_1609":35345},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_8091":924,"_22651":873,"_19215":35347,"_5":22801,"_15391":35217,"_1609":35348},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_8091":925,"_22651":873,"_19215":35350,"_5":22801,"_15391":35217,"_1609":35351},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_8091":926,"_22651":873,"_19215":35353,"_5":22801,"_15391":35217,"_1609":35354},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_8091":927,"_22651":873,"_19215":35356,"_5":22801,"_15391":35221,"_1609":35357},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_8091":928,"_22651":873,"_19215":35359,"_5":22801,"_15391":35221,"_1609":35360},[],"El proceso se realiza de la siguiente manera:",{"_8091":929,"_22651":873,"_19215":35362,"_5":22801,"_15391":35221,"_1609":35363},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_8091":930,"_22651":873,"_19215":35365,"_5":22801,"_15391":35221,"_1609":35366},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_8091":931,"_22651":873,"_19215":35368,"_5":22801,"_15391":35221,"_1609":35369},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_8091":932,"_22651":932,"_5":22796,"_1609":35371,"_22809":35372,"_19215":35373,"_15391":932},"EST: Enrollment over Secure Transport",[32566,33665,33674],[],{"_8091":933,"_22651":932,"_19215":35375,"_5":22801,"_15391":932,"_1609":35376},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_8091":934,"_22651":932,"_5":22806,"_19215":35378,"_15391":35379,"_1609":35371},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_8091":935,"_22651":932,"_5":22806,"_19215":35381,"_15391":35382,"_1609":33748},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-del-dms",{"_8091":936,"_22651":932,"_5":22806,"_19215":35384,"_15391":35385,"_1609":33271},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#requisitos-previos",{"_8091":937,"_22651":932,"_5":22806,"_19215":35387,"_15391":35388,"_1609":35389},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_8091":938,"_22651":932,"_5":22806,"_19215":35391,"_15391":35392,"_1609":35393},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_8091":939,"_22651":932,"_5":22806,"_19215":35395,"_15391":35396,"_1609":35397},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_8091":940,"_22651":932,"_5":22806,"_19215":35399,"_15391":35400,"_1609":35401},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_8091":941,"_22651":932,"_5":22806,"_19215":35403,"_15391":35404,"_1609":35405},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_8091":942,"_22651":932,"_5":22806,"_19215":35407,"_15391":35408,"_1609":35409},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_8091":943,"_22651":932,"_5":22806,"_19215":35411,"_15391":35412,"_1609":35413},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_8091":944,"_22651":932,"_5":22806,"_19215":35415,"_15391":35416,"_1609":35417},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_8091":945,"_22651":932,"_5":22806,"_19215":35419,"_15391":35420,"_1609":35421},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#antes-de-empezar","Antes de empezar",{"_8091":946,"_22651":932,"_5":22806,"_19215":35423,"_15391":35424,"_1609":35425},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_8091":947,"_22651":932,"_5":22806,"_19215":35427,"_15391":35428,"_1609":35429},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_8091":948,"_22651":932,"_5":22806,"_19215":35431,"_15391":35432,"_1609":35433},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_8091":949,"_22651":932,"_5":22806,"_19215":35435,"_15391":35436,"_1609":35437},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#cacerts","`/cacerts`",{"_8091":950,"_22651":932,"_5":22806,"_19215":35439,"_15391":35440,"_1609":35441},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_8091":951,"_22651":932,"_5":22806,"_19215":35443,"_15391":35444,"_1609":35445},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_8091":952,"_22651":932,"_5":22806,"_19215":35447,"_15391":35448,"_1609":35449},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_8091":953,"_22651":932,"_5":22806,"_19215":35451,"_15391":35452,"_1609":35453},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#flujos-completos","Flujos completos",{"_8091":954,"_22651":932,"_5":22806,"_19215":35455,"_15391":35456,"_1609":35457},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_8091":955,"_22651":932,"_5":22806,"_19215":35459,"_15391":35460,"_1609":35461},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_8091":956,"_22651":932,"_5":22806,"_19215":35463,"_15391":35464,"_1609":35465},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_8091":957,"_22651":932,"_5":22806,"_19215":35467,"_15391":35468,"_1609":35469},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_8091":958,"_22651":932,"_5":22806,"_19215":35471,"_15391":35472,"_1609":35473},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_8091":959,"_22651":932,"_5":22806,"_19215":35475,"_15391":35476,"_1609":35477},[],"/docs/pr-preview/pr-25/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_8091":960,"_22651":932,"_19215":35479,"_5":22801,"_15391":35379,"_1609":35480},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_8091":961,"_22651":932,"_19215":35482,"_5":22801,"_15391":35379,"_1609":35483},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_8091":962,"_22651":932,"_19215":35485,"_5":22801,"_15391":35379,"_1609":35486},[],"Esta guía está dividida en dos partes:",{"_8091":963,"_22651":932,"_19215":35488,"_5":22801,"_15391":35379,"_1609":35489},[],"Configuración del DMS, para el administrador PKI.",{"_8091":964,"_22651":932,"_19215":35491,"_5":22801,"_15391":35379,"_1609":35492},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_8091":965,"_22651":932,"_19215":35494,"_5":22801,"_15391":35379,"_1609":35495},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_8091":966,"_22651":932,"_19215":35497,"_5":22801,"_15391":35379,"_1609":35498},[],"Perfil",{"_8091":967,"_22651":932,"_19215":35500,"_5":22801,"_15391":35379,"_1609":35501},[],"Leer primero",{"_8091":968,"_22651":932,"_19215":35503,"_5":22801,"_15391":35379,"_1609":35504},[],"Después",{"_8091":969,"_22651":932,"_19215":35506,"_5":22801,"_15391":35379,"_1609":35507},[],"Administrador PKI",{"_8091":970,"_22651":932,"_19215":35509,"_5":22801,"_15391":35379,"_1609":33748},[],{"_8091":971,"_22651":932,"_19215":35511,"_5":22801,"_15391":35379,"_1609":35469},[],{"_8091":972,"_22651":932,"_19215":35513,"_5":22801,"_15391":35379,"_1609":35514},[],"Integrador de dispositivos",{"_8091":973,"_22651":932,"_19215":35516,"_5":22801,"_15391":35379,"_1609":35421},[],{"_8091":974,"_22651":932,"_19215":35518,"_5":22801,"_15391":35379,"_1609":35519},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_8091":975,"_22651":932,"_19215":35521,"_5":22801,"_15391":35385,"_1609":35522},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_8091":976,"_22651":932,"_19215":35524,"_5":22801,"_15391":35385,"_1609":35525},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_8091":977,"_22651":932,"_19215":35527,"_5":22801,"_15391":35385,"_1609":35528},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_8091":978,"_22651":932,"_19215":35530,"_5":22801,"_15391":35385,"_1609":35531},[],"Conviene separar cuatro bloques de configuración:",{"_8091":979,"_22651":932,"_19215":35533,"_5":22801,"_15391":35385,"_1609":35534},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_8091":980,"_22651":932,"_19215":35536,"_5":22801,"_15391":35385,"_1609":35537},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_8091":981,"_22651":932,"_19215":35539,"_5":22801,"_15391":35385,"_1609":35540},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_8091":982,"_22651":932,"_19215":35542,"_5":22801,"_15391":35385,"_1609":35543},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_8091":983,"_22651":932,"_19215":35545,"_5":22801,"_15391":35392,"_1609":35546},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_8091":984,"_22651":932,"_19215":35548,"_5":22801,"_15391":35392,"_1609":35549},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_8091":985,"_22651":932,"_19215":35551,"_5":22801,"_15391":35392,"_1609":35552},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_8091":986,"_22651":932,"_19215":35554,"_5":22801,"_15391":35392,"_1609":35555},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_8091":987,"_22651":932,"_19215":35557,"_5":22801,"_15391":35396,"_1609":35558},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_8091":988,"_22651":932,"_19215":35560,"_5":22801,"_15391":35396,"_1609":35561},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_8091":989,"_22651":932,"_19215":35563,"_5":22801,"_15391":35396,"_1609":35564},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_8091":990,"_22651":932,"_19215":35566,"_5":22801,"_15391":35396,"_1609":35567},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_8091":991,"_22651":932,"_19215":35569,"_5":22801,"_15391":35396,"_1609":35570},[],"Modo",{"_8091":992,"_22651":932,"_19215":35572,"_5":22801,"_15391":35396,"_1609":32769},[],{"_8091":993,"_22651":932,"_19215":35574,"_5":22801,"_15391":35396,"_1609":35575},[],"`CLIENT_CERTIFICATE`",{"_8091":994,"_22651":932,"_19215":35577,"_5":22801,"_15391":35396,"_1609":35578},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_8091":995,"_22651":932,"_19215":35580,"_5":22801,"_15391":35396,"_1609":35581},[],"`EXTERNAL_WEBHOOK`",{"_8091":996,"_22651":932,"_19215":35583,"_5":22801,"_15391":35396,"_1609":35584},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_8091":997,"_22651":932,"_19215":35586,"_5":22801,"_15391":35396,"_1609":35587},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_8091":998,"_22651":932,"_19215":35589,"_5":22801,"_15391":35396,"_1609":35590},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_8091":999,"_22651":932,"_19215":35592,"_5":22801,"_15391":35396,"_1609":35593},[],"`NO_AUTH`",{"_8091":1000,"_22651":932,"_19215":35595,"_5":22801,"_15391":35396,"_1609":35596},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_8091":1001,"_22651":932,"_19215":35598,"_5":22801,"_15391":35396,"_1609":35599},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_8091":1002,"_22651":932,"_19215":35601,"_5":22801,"_15391":35396,"_1609":35602},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_8091":1003,"_22651":932,"_19215":35604,"_5":22801,"_15391":35396,"_1609":35605},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_8091":1004,"_22651":932,"_19215":35607,"_5":22801,"_15391":35396,"_1609":35608},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_8091":1005,"_22651":932,"_19215":35610,"_5":22801,"_15391":35396,"_1609":35611},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_8091":1006,"_22651":932,"_19215":35613,"_5":22801,"_15391":35396,"_1609":35614},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_8091":1007,"_22651":932,"_19215":35616,"_5":22801,"_15391":35396,"_1609":35617},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_8091":1008,"_22651":932,"_19215":35619,"_5":22801,"_15391":35396,"_1609":35620},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_8091":1009,"_22651":932,"_19215":35622,"_5":22801,"_15391":35396,"_1609":35623},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_8091":1010,"_22651":932,"_19215":35625,"_5":22801,"_15391":35396,"_1609":35626},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_8091":1011,"_22651":932,"_19215":35628,"_5":22801,"_15391":35400,"_1609":35629},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_8091":1012,"_22651":932,"_19215":35631,"_5":22801,"_15391":35400,"_1609":35632},[],"Campo",{"_8091":1013,"_22651":932,"_19215":35634,"_5":22801,"_15391":35400,"_1609":33900},[],{"_8091":1014,"_22651":932,"_19215":35636,"_5":22801,"_15391":35400,"_1609":35637},[],"Efecto sobre el certificado emitido",{"_8091":1015,"_22651":932,"_19215":35639,"_5":22801,"_15391":35400,"_1609":35640},[],"`HonorSubject`",{"_8091":1016,"_22651":932,"_19215":35642,"_5":22801,"_15391":35400,"_1609":20937},[],{"_8091":1017,"_22651":932,"_19215":35644,"_5":22801,"_15391":35400,"_1609":35645},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_8091":1018,"_22651":932,"_19215":35647,"_5":22801,"_15391":35400,"_1609":35648},[],"`HonorKeyUsage`",{"_8091":1019,"_22651":932,"_19215":35650,"_5":22801,"_15391":35400,"_1609":20937},[],{"_8091":1020,"_22651":932,"_19215":35652,"_5":22801,"_15391":35400,"_1609":35653},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_8091":1021,"_22651":932,"_19215":35655,"_5":22801,"_15391":35400,"_1609":35656},[],"`HonorExtendedKeyUsages`",{"_8091":1022,"_22651":932,"_19215":35658,"_5":22801,"_15391":35400,"_1609":20937},[],{"_8091":1023,"_22651":932,"_19215":35660,"_5":22801,"_15391":35400,"_1609":35661},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_8091":1024,"_22651":932,"_19215":35663,"_5":22801,"_15391":35400,"_1609":35664},[],"`HonorExtensions`",{"_8091":1025,"_22651":932,"_19215":35666,"_5":22801,"_15391":35400,"_1609":20937},[],{"_8091":1026,"_22651":932,"_19215":35668,"_5":22801,"_15391":35400,"_1609":35669},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_8091":1027,"_22651":932,"_19215":35671,"_5":22801,"_15391":35400,"_1609":35672},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_8091":1028,"_22651":932,"_19215":35674,"_5":22801,"_15391":35404,"_1609":35675},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_8091":1029,"_22651":932,"_19215":35677,"_5":22801,"_15391":35404,"_1609":35678},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_8091":1030,"_22651":932,"_19215":35680,"_5":22801,"_15391":35404,"_1609":35681},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_8091":1031,"_22651":932,"_19215":35683,"_5":22801,"_15391":35404,"_1609":35684},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_8091":1032,"_22651":932,"_19215":35686,"_5":22801,"_15391":35404,"_1609":35687},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_8091":1033,"_22651":932,"_19215":35689,"_5":22801,"_15391":35404,"_1609":35690},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_8091":1034,"_22651":932,"_19215":35692,"_5":22801,"_15391":35404,"_1609":35693},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_8091":1035,"_22651":932,"_19215":35695,"_5":22801,"_15391":35408,"_1609":35696},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_8091":1036,"_22651":932,"_19215":35698,"_5":22801,"_15391":35408,"_1609":35699},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_8091":1037,"_22651":932,"_19215":35701,"_5":22801,"_15391":35408,"_1609":35702},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_8091":1038,"_22651":932,"_19215":35704,"_5":22801,"_15391":35408,"_1609":35705},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_8091":1039,"_22651":932,"_19215":35707,"_5":22801,"_15391":35412,"_1609":35708},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_8091":1040,"_22651":932,"_19215":35710,"_5":22801,"_15391":35412,"_1609":35711},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_8091":1041,"_22651":932,"_19215":35713,"_5":22801,"_15391":35412,"_1609":35714},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_8091":1042,"_22651":932,"_19215":35716,"_5":22801,"_15391":35412,"_1609":35717},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_8091":1043,"_22651":932,"_19215":35719,"_5":22801,"_15391":35416,"_1609":35720},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_8091":1044,"_22651":932,"_19215":35722,"_5":22801,"_15391":35416,"_1609":35723},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_8091":1045,"_22651":932,"_19215":35725,"_5":22801,"_15391":35416,"_1609":35726},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_8091":1046,"_22651":932,"_19215":35728,"_5":22801,"_15391":35420,"_1609":35729},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_8091":1047,"_22651":932,"_19215":35731,"_5":22801,"_15391":35420,"_1609":35732},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_8091":1048,"_22651":932,"_19215":35734,"_5":22801,"_15391":35420,"_1609":35735},[],"Elemento",{"_8091":1049,"_22651":932,"_19215":35737,"_5":22801,"_15391":35420,"_1609":32769},[],{"_8091":1050,"_22651":932,"_19215":35739,"_5":22801,"_15391":35420,"_1609":35740},[],"**URL del host EST**",{"_8091":1051,"_22651":932,"_19215":35742,"_5":22801,"_15391":35420,"_1609":35743},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_8091":1052,"_22651":932,"_19215":35745,"_5":22801,"_15391":35420,"_1609":35746},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_8091":1053,"_22651":932,"_19215":35748,"_5":22801,"_15391":35420,"_1609":35749},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_8091":1054,"_22651":932,"_19215":35751,"_5":22801,"_15391":35420,"_1609":35752},[],"**Certificado bootstrap + clave privada**",{"_8091":1055,"_22651":932,"_19215":35754,"_5":22801,"_15391":35420,"_1609":35755},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_8091":1056,"_22651":932,"_19215":35757,"_5":22801,"_15391":35420,"_1609":35758},[],"**ID del DMS** (`{aps}`)",{"_8091":1057,"_22651":932,"_19215":35760,"_5":22801,"_15391":35420,"_1609":35761},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_8091":1058,"_22651":932,"_19215":35763,"_5":22801,"_15391":35424,"_1609":35764},[],"Caso",{"_8091":1059,"_22651":932,"_19215":35766,"_5":22801,"_15391":35424,"_1609":35767},[],"Credencial habitual",{"_8091":1060,"_22651":932,"_19215":35769,"_5":22801,"_15391":35424,"_1609":35770},[],"Endpoint principal",{"_8091":1061,"_22651":932,"_19215":35772,"_5":22801,"_15391":35424,"_1609":35773},[],"Resultado",{"_8091":1062,"_22651":932,"_19215":35775,"_5":22801,"_15391":35424,"_1609":35776},[],"Alta inicial",{"_8091":1063,"_22651":932,"_19215":35778,"_5":22801,"_15391":35424,"_1609":35779},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_8091":1064,"_22651":932,"_19215":35781,"_5":22801,"_15391":35424,"_1609":35441},[],{"_8091":1065,"_22651":932,"_19215":35783,"_5":22801,"_15391":35424,"_1609":35784},[],"Certificado de dispositivo",{"_8091":1066,"_22651":932,"_19215":35786,"_5":22801,"_15391":35424,"_1609":35787},[],"Renovación",{"_8091":1067,"_22651":932,"_19215":35789,"_5":22801,"_15391":35424,"_1609":35790},[],"Certificado actual del dispositivo",{"_8091":1068,"_22651":932,"_19215":35792,"_5":22801,"_15391":35424,"_1609":35445},[],{"_8091":1069,"_22651":932,"_19215":35794,"_5":22801,"_15391":35424,"_1609":35795},[],"Certificado renovado",{"_8091":1070,"_22651":932,"_19215":35797,"_5":22801,"_15391":35424,"_1609":35798},[],"Descarga de confianza",{"_8091":1071,"_22651":932,"_19215":35800,"_5":22801,"_15391":35424,"_1609":35801},[],"TLS del servidor",{"_8091":1072,"_22651":932,"_19215":35803,"_5":22801,"_15391":35424,"_1609":35437},[],{"_8091":1073,"_22651":932,"_19215":35805,"_5":22801,"_15391":35424,"_1609":35806},[],"PKCS#7 o PEM con certificados",{"_8091":1074,"_22651":932,"_19215":35808,"_5":22801,"_15391":35424,"_1609":35809},[],"Clave generada en servidor",{"_8091":1075,"_22651":932,"_19215":35811,"_5":22801,"_15391":35424,"_1609":35812},[],"Igual que `/simpleenroll`",{"_8091":1076,"_22651":932,"_19215":35814,"_5":22801,"_15391":35424,"_1609":35449},[],{"_8091":1077,"_22651":932,"_19215":35816,"_5":22801,"_15391":35424,"_1609":35817},[],"Clave privada PKCS#8 + certificado",{"_8091":1078,"_22651":932,"_19215":35819,"_5":22801,"_15391":35428,"_1609":35820},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_8091":1079,"_22651":932,"_19215":35822,"_5":22801,"_15391":35428,"_1609":35823},[],"Modo (`AuthMode`)",{"_8091":1080,"_22651":932,"_19215":35825,"_5":22801,"_15391":35428,"_1609":32769},[],{"_8091":1081,"_22651":932,"_19215":35827,"_5":22801,"_15391":35428,"_1609":35828},[],"Credencial esperada",{"_8091":1082,"_22651":932,"_19215":35830,"_5":22801,"_15391":35428,"_1609":35831},[],"Aplica en enroll",{"_8091":1083,"_22651":932,"_19215":35833,"_5":22801,"_15391":35428,"_1609":35834},[],"Aplica en reenroll",{"_8091":1084,"_22651":932,"_19215":35836,"_5":22801,"_15391":35428,"_1609":35575},[],{"_8091":1085,"_22651":932,"_19215":35838,"_5":22801,"_15391":35428,"_1609":35839},[],"mTLS con certificado X.509",{"_8091":1086,"_22651":932,"_19215":35841,"_5":22801,"_15391":35428,"_1609":35842},[],"Certificado y clave privada cliente",{"_8091":1087,"_22651":932,"_19215":35844,"_5":22801,"_15391":35428,"_1609":33913},[],{"_8091":1088,"_22651":932,"_19215":35846,"_5":22801,"_15391":35428,"_1609":35847},[],"Sí (con el certificado en vigor)",{"_8091":1089,"_22651":932,"_19215":35849,"_5":22801,"_15391":35428,"_1609":35587},[],{"_8091":1090,"_22651":932,"_19215":35851,"_5":22801,"_15391":35428,"_1609":35852},[],"mTLS más validación por webhook",{"_8091":1091,"_22651":932,"_19215":35854,"_5":22801,"_15391":35428,"_1609":35855},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_8091":1092,"_22651":932,"_19215":35857,"_5":22801,"_15391":35428,"_1609":33913},[],{"_8091":1093,"_22651":932,"_19215":35859,"_5":22801,"_15391":35428,"_1609":35860},[],"No como combinación; en reenroll no mantiene ambos controles",{"_8091":1094,"_22651":932,"_19215":35862,"_5":22801,"_15391":35428,"_1609":35581},[],{"_8091":1095,"_22651":932,"_19215":35864,"_5":22801,"_15391":35428,"_1609":35865},[],"Webhook externo de autorización",{"_8091":1096,"_22651":932,"_19215":35867,"_5":22801,"_15391":35428,"_1609":35868},[],"Ninguna en el canal TLS",{"_8091":1097,"_22651":932,"_19215":35870,"_5":22801,"_15391":35428,"_1609":33913},[],{"_8091":1098,"_22651":932,"_19215":35872,"_5":22801,"_15391":35428,"_1609":35873},[],"No, degrada a `NO_AUTH`",{"_8091":1099,"_22651":932,"_19215":35875,"_5":22801,"_15391":35428,"_1609":35593},[],{"_8091":1100,"_22651":932,"_19215":35877,"_5":22801,"_15391":35428,"_1609":35878},[],"Sin autenticación",{"_8091":1101,"_22651":932,"_19215":35880,"_5":22801,"_15391":35428,"_1609":35881},[],"Ninguna",{"_8091":1102,"_22651":932,"_19215":35883,"_5":22801,"_15391":35428,"_1609":35884},[],"Sí (uso restringido)",{"_8091":1103,"_22651":932,"_19215":35886,"_5":22801,"_15391":35428,"_1609":35884},[],{"_8091":1104,"_22651":932,"_19215":35888,"_5":22801,"_15391":35428,"_1609":35889},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_8091":1105,"_22651":932,"_19215":35891,"_5":22801,"_15391":35428,"_1609":35892},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_8091":1106,"_22651":932,"_19215":35894,"_5":22801,"_15391":35428,"_1609":33897},[],{"_8091":1107,"_22651":932,"_19215":35896,"_5":22801,"_15391":35428,"_1609":33900},[],{"_8091":1108,"_22651":932,"_19215":35898,"_5":22801,"_15391":35428,"_1609":32769},[],{"_8091":1109,"_22651":932,"_19215":35900,"_5":22801,"_15391":35428,"_1609":35901},[],"`ValidationCAs`",{"_8091":1110,"_22651":932,"_19215":35903,"_5":22801,"_15391":35428,"_1609":35904},[],"lista de IDs de CA",{"_8091":1111,"_22651":932,"_19215":35906,"_5":22801,"_15391":35428,"_1609":35907},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_8091":1112,"_22651":932,"_19215":35909,"_5":22801,"_15391":35428,"_1609":35910},[],"`AllowExpired`",{"_8091":1113,"_22651":932,"_19215":35912,"_5":22801,"_15391":35428,"_1609":20937},[],{"_8091":1114,"_22651":932,"_19215":35914,"_5":22801,"_15391":35428,"_1609":35915},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_8091":1115,"_22651":932,"_19215":35917,"_5":22801,"_15391":35428,"_1609":35918},[],"`ChainLevelValidation`",{"_8091":1116,"_22651":932,"_19215":35920,"_5":22801,"_15391":35428,"_1609":4361},[],{"_8091":1117,"_22651":932,"_19215":35922,"_5":22801,"_15391":35428,"_1609":35923},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_8091":1118,"_22651":932,"_19215":35925,"_5":22801,"_15391":35428,"_1609":35926},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_8091":1119,"_22651":932,"_19215":35928,"_5":22801,"_15391":35428,"_1609":35929},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_8091":1120,"_22651":932,"_19215":35931,"_5":22801,"_15391":35428,"_1609":35932},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_8091":1121,"_22651":932,"_19215":35934,"_5":22801,"_15391":35428,"_1609":35935},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_8091":1122,"_22651":932,"_19215":35937,"_5":22801,"_15391":35432,"_1609":35938},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_8091":1123,"_22651":932,"_19215":35940,"_5":22801,"_15391":35432,"_1609":35941},[],"`/cacerts`: descarga de la cadena de confianza.",{"_8091":1124,"_22651":932,"_19215":35943,"_5":22801,"_15391":35432,"_1609":35944},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_8091":1125,"_22651":932,"_19215":35946,"_5":22801,"_15391":35432,"_1609":35947},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_8091":1126,"_22651":932,"_19215":35949,"_5":22801,"_15391":35432,"_1609":35950},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_8091":1127,"_22651":932,"_19215":35952,"_5":22801,"_15391":35436,"_1609":35953},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_8091":1128,"_22651":932,"_19215":35955,"_5":22801,"_15391":35436,"_1609":35956},[],"Campo de `CADistributionSettings`",{"_8091":1129,"_22651":932,"_19215":35958,"_5":22801,"_15391":35436,"_1609":33900},[],{"_8091":1130,"_22651":932,"_19215":35960,"_5":22801,"_15391":35436,"_1609":32769},[],{"_8091":1131,"_22651":932,"_19215":35962,"_5":22801,"_15391":35436,"_1609":35963},[],"`IncludeLamassuSystemCA`",{"_8091":1132,"_22651":932,"_19215":35965,"_5":22801,"_15391":35436,"_1609":20937},[],{"_8091":1133,"_22651":932,"_19215":35967,"_5":22801,"_15391":35436,"_1609":35968},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_8091":1134,"_22651":932,"_19215":35970,"_5":22801,"_15391":35436,"_1609":35971},[],"`IncludeEnrollmentCA`",{"_8091":1135,"_22651":932,"_19215":35973,"_5":22801,"_15391":35436,"_1609":20937},[],{"_8091":1136,"_22651":932,"_19215":35975,"_5":22801,"_15391":35436,"_1609":35976},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_8091":1137,"_22651":932,"_19215":35978,"_5":22801,"_15391":35436,"_1609":35979},[],"`ManagedCAs`",{"_8091":1138,"_22651":932,"_19215":35981,"_5":22801,"_15391":35436,"_1609":35904},[],{"_8091":1139,"_22651":932,"_19215":35983,"_5":22801,"_15391":35436,"_1609":35984},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_8091":1140,"_22651":932,"_19215":35986,"_5":22801,"_15391":35436,"_1609":35987},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_8091":1141,"_22651":932,"_19215":35989,"_5":22801,"_15391":35436,"_1609":35990},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_8091":1142,"_22651":932,"_19215":35992,"_5":22801,"_15391":35436,"_1609":35993},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_8091":1143,"_22651":932,"_19215":35995,"_5":22801,"_15391":35436,"_1609":35996},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_8091":1144,"_22651":932,"_19215":35998,"_5":22801,"_15391":35440,"_1609":35999},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_8091":1145,"_22651":932,"_19215":36001,"_5":22801,"_15391":35440,"_1609":36002},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_8091":1146,"_22651":932,"_19215":36004,"_5":22801,"_15391":35440,"_1609":36005},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_8091":1147,"_22651":932,"_19215":36007,"_5":22801,"_15391":35440,"_1609":35632},[],{"_8091":1148,"_22651":932,"_19215":36009,"_5":22801,"_15391":35440,"_1609":33900},[],{"_8091":1149,"_22651":932,"_19215":36011,"_5":22801,"_15391":35440,"_1609":36012},[],"Efecto",{"_8091":1150,"_22651":932,"_19215":36014,"_5":22801,"_15391":35440,"_1609":36015},[],"`EnrollmentSettings.RegistrationMode`",{"_8091":1151,"_22651":932,"_19215":36017,"_5":22801,"_15391":35440,"_1609":36018},[],"`JITP` / `PRE_REGISTRATION`",{"_8091":1152,"_22651":932,"_19215":36020,"_5":22801,"_15391":35440,"_1609":36021},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_8091":1153,"_22651":932,"_19215":36023,"_5":22801,"_15391":35440,"_1609":36024},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_8091":1154,"_22651":932,"_19215":36026,"_5":22801,"_15391":35440,"_1609":20937},[],{"_8091":1155,"_22651":932,"_19215":36028,"_5":22801,"_15391":35440,"_1609":36029},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_8091":1156,"_22651":932,"_19215":36031,"_5":22801,"_15391":35440,"_1609":36032},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_8091":1157,"_22651":932,"_19215":36034,"_5":22801,"_15391":35440,"_1609":20937},[],{"_8091":1158,"_22651":932,"_19215":36036,"_5":22801,"_15391":35440,"_1609":36037},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_8091":1159,"_22651":932,"_19215":36039,"_5":22801,"_15391":35440,"_1609":36040},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_8091":1160,"_22651":932,"_19215":36042,"_5":22801,"_15391":35444,"_1609":36043},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_8091":1161,"_22651":932,"_19215":36045,"_5":22801,"_15391":35444,"_1609":36046},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_8091":1162,"_22651":932,"_19215":36048,"_5":22801,"_15391":35444,"_1609":36049},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_8091":1163,"_22651":932,"_19215":36051,"_5":22801,"_15391":35444,"_1609":35632},[],{"_8091":1164,"_22651":932,"_19215":36053,"_5":22801,"_15391":35444,"_1609":33900},[],{"_8091":1165,"_22651":932,"_19215":36055,"_5":22801,"_15391":35444,"_1609":36012},[],{"_8091":1166,"_22651":932,"_19215":36057,"_5":22801,"_15391":35444,"_1609":36058},[],"`ReEnrollmentDelta`",{"_8091":1167,"_22651":932,"_19215":36060,"_5":22801,"_15391":35444,"_1609":36061},[],"duración",{"_8091":1168,"_22651":932,"_19215":36063,"_5":22801,"_15391":35444,"_1609":36064},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_8091":1169,"_22651":932,"_19215":36066,"_5":22801,"_15391":35444,"_1609":36067},[],"`EnableExpiredRenewal`",{"_8091":1170,"_22651":932,"_19215":36069,"_5":22801,"_15391":35444,"_1609":20937},[],{"_8091":1171,"_22651":932,"_19215":36071,"_5":22801,"_15391":35444,"_1609":36072},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_8091":1172,"_22651":932,"_19215":36074,"_5":22801,"_15391":35444,"_1609":36075},[],"`RevokeOnReEnrollment`",{"_8091":1173,"_22651":932,"_19215":36077,"_5":22801,"_15391":35444,"_1609":20937},[],{"_8091":1174,"_22651":932,"_19215":36079,"_5":22801,"_15391":35444,"_1609":36080},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_8091":1175,"_22651":932,"_19215":36082,"_5":22801,"_15391":35444,"_1609":36083},[],"`AdditionalValidationCAs`",{"_8091":1176,"_22651":932,"_19215":36085,"_5":22801,"_15391":35444,"_1609":35904},[],{"_8091":1177,"_22651":932,"_19215":36087,"_5":22801,"_15391":35444,"_1609":36088},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_8091":1178,"_22651":932,"_19215":36090,"_5":22801,"_15391":35444,"_1609":36091},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_8091":1179,"_22651":932,"_19215":36093,"_5":22801,"_15391":35444,"_1609":36094},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_8091":1180,"_22651":932,"_19215":36096,"_5":22801,"_15391":35448,"_1609":36097},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_8091":1181,"_22651":932,"_19215":36099,"_5":22801,"_15391":35448,"_1609":36100},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_8091":1182,"_22651":932,"_19215":36102,"_5":22801,"_15391":35448,"_1609":36103},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_8091":1183,"_22651":932,"_19215":36105,"_5":22801,"_15391":35448,"_1609":36106},[],"Tipo de clave",{"_8091":1184,"_22651":932,"_19215":36108,"_5":22801,"_15391":35448,"_1609":36109},[],"Parámetro válido",{"_8091":1185,"_22651":932,"_19215":36111,"_5":22801,"_15391":35448,"_1609":36112},[],"Curva NIST equivalente",{"_8091":1186,"_22651":932,"_19215":36114,"_5":22801,"_15391":35448,"_1609":36115},[],"Comportamiento ante valores no válidos",{"_8091":1187,"_22651":932,"_19215":36117,"_5":22801,"_15391":35448,"_1609":36118},[],"`RSA`",{"_8091":1188,"_22651":932,"_19215":36120,"_5":22801,"_15391":35448,"_1609":36121},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_8091":1189,"_22651":932,"_19215":36123,"_5":22801,"_15391":35448,"_1609":36124},[],"No aplica",{"_8091":1190,"_22651":932,"_19215":36126,"_5":22801,"_15391":35448,"_1609":36127},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_8091":1191,"_22651":932,"_19215":36129,"_5":22801,"_15391":35448,"_1609":36130},[],"`ECDSA`",{"_8091":1192,"_22651":932,"_19215":36132,"_5":22801,"_15391":35448,"_1609":36133},[],"224, 256, 384, 521",{"_8091":1193,"_22651":932,"_19215":36135,"_5":22801,"_15391":35448,"_1609":36136},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_8091":1194,"_22651":932,"_19215":36138,"_5":22801,"_15391":35448,"_1609":36139},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_8091":1195,"_22651":932,"_19215":36141,"_5":22801,"_15391":35448,"_1609":36142},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_8091":1196,"_22651":932,"_19215":36144,"_5":22801,"_15391":35448,"_1609":36145},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_8091":1197,"_22651":932,"_19215":36147,"_5":22801,"_15391":35448,"_1609":36148},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_8091":1198,"_22651":932,"_19215":36150,"_5":22801,"_15391":35448,"_1609":36151},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_8091":1199,"_22651":932,"_19215":36153,"_5":22801,"_15391":35448,"_1609":36154},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_8091":1200,"_22651":932,"_19215":36156,"_5":22801,"_15391":35448,"_1609":36157},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_8091":1201,"_22651":932,"_19215":36159,"_5":22801,"_15391":35448,"_1609":36160},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_8091":1202,"_22651":932,"_19215":36162,"_5":22801,"_15391":35452,"_1609":36163},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_8091":1203,"_22651":932,"_19215":36165,"_5":22801,"_15391":35456,"_1609":36166},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_8091":1204,"_22651":932,"_19215":36168,"_5":22801,"_15391":35460,"_1609":36169},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_8091":1205,"_22651":932,"_19215":36171,"_5":22801,"_15391":35464,"_1609":36172},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_8091":1206,"_22651":932,"_19215":36174,"_5":22801,"_15391":35464,"_1609":36175},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_8091":1207,"_22651":932,"_19215":36177,"_5":22801,"_15391":35464,"_1609":36178},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_8091":1208,"_22651":932,"_19215":36180,"_5":22801,"_15391":35464,"_1609":36181},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_8091":1209,"_22651":932,"_19215":36183,"_5":22801,"_15391":35472,"_1609":36184},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_8091":1210,"_22651":932,"_19215":36186,"_5":22801,"_15391":35472,"_1609":36187},[],"HTTP",{"_8091":1211,"_22651":932,"_19215":36189,"_5":22801,"_15391":35472,"_1609":36190},[],"Mensaje",{"_8091":1212,"_22651":932,"_19215":36192,"_5":22801,"_15391":35472,"_1609":36193},[],"Causa",{"_8091":1213,"_22651":932,"_19215":36195,"_5":22801,"_15391":35472,"_1609":36196},[],"Acción del integrador",{"_8091":1214,"_22651":932,"_19215":36198,"_5":22801,"_15391":35472,"_1609":20044},[],{"_8091":1215,"_22651":932,"_19215":36200,"_5":22801,"_15391":35472,"_1609":36201},[],"`Field validation for 'APS' failed`",{"_8091":1216,"_22651":932,"_19215":36203,"_5":22801,"_15391":35472,"_1609":36204},[],"El segmento `{aps}` falta en la URL.",{"_8091":1217,"_22651":932,"_19215":36206,"_5":22801,"_15391":35472,"_1609":36207},[],"Incluir el ID del DMS en la ruta.",{"_8091":1218,"_22651":932,"_19215":36209,"_5":22801,"_15391":35472,"_1609":20044},[],{"_8091":1219,"_22651":932,"_19215":36211,"_5":22801,"_15391":35472,"_1609":36212},[],"`content-type must be application/pkcs10`",{"_8091":1220,"_22651":932,"_19215":36214,"_5":22801,"_15391":35472,"_1609":36215},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_8091":1221,"_22651":932,"_19215":36217,"_5":22801,"_15391":35472,"_1609":36218},[],"Fijar `Content-Type: application/pkcs10`.",{"_8091":1222,"_22651":932,"_19215":36220,"_5":22801,"_15391":35472,"_1609":20044},[],{"_8091":1223,"_22651":932,"_19215":36222,"_5":22801,"_15391":35472,"_1609":36223},[],"`body payload must be base64 encoded`",{"_8091":1224,"_22651":932,"_19215":36225,"_5":22801,"_15391":35472,"_1609":36226},[],"El cuerpo no es base64 válido.",{"_8091":1225,"_22651":932,"_19215":36228,"_5":22801,"_15391":35472,"_1609":36229},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_8091":1226,"_22651":932,"_19215":36231,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1227,"_22651":932,"_19215":36233,"_5":22801,"_15391":35472,"_1609":36234},[],"`DMS not found`",{"_8091":1228,"_22651":932,"_19215":36236,"_5":22801,"_15391":35472,"_1609":36237},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_8091":1229,"_22651":932,"_19215":36239,"_5":22801,"_15391":35472,"_1609":36240},[],"Verificar el identificador con el administrador PKI.",{"_8091":1230,"_22651":932,"_19215":36242,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1231,"_22651":932,"_19215":36244,"_5":22801,"_15391":35472,"_1609":36245},[],"`invalid certificate`",{"_8091":1232,"_22651":932,"_19215":36247,"_5":22801,"_15391":35472,"_1609":36248},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_8091":1233,"_22651":932,"_19215":36250,"_5":22801,"_15391":35472,"_1609":36251},[],"Comprobar la cadena del certificado bootstrap.",{"_8091":1234,"_22651":932,"_19215":36253,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1235,"_22651":932,"_19215":36255,"_5":22801,"_15391":35472,"_1609":36256},[],"`certificate is revoked`",{"_8091":1236,"_22651":932,"_19215":36258,"_5":22801,"_15391":35472,"_1609":36259},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_8091":1237,"_22651":932,"_19215":36261,"_5":22801,"_15391":35472,"_1609":36262},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_8091":1238,"_22651":932,"_19215":36264,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1239,"_22651":932,"_19215":36266,"_5":22801,"_15391":35472,"_1609":36267},[],"`revoked certificate`",{"_8091":1240,"_22651":932,"_19215":36269,"_5":22801,"_15391":35472,"_1609":36270},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_8091":1241,"_22651":932,"_19215":36272,"_5":22801,"_15391":35472,"_1609":36273},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_8091":1242,"_22651":932,"_19215":36275,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1243,"_22651":932,"_19215":36277,"_5":22801,"_15391":35472,"_1609":36278},[],"`expired certificate`",{"_8091":1244,"_22651":932,"_19215":36280,"_5":22801,"_15391":35472,"_1609":36281},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_8091":1245,"_22651":932,"_19215":36283,"_5":22801,"_15391":35472,"_1609":36284},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_8091":1246,"_22651":932,"_19215":36286,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1247,"_22651":932,"_19215":36288,"_5":22801,"_15391":35472,"_1609":36289},[],"`forbiddenNewEnrollment`",{"_8091":1248,"_22651":932,"_19215":36291,"_5":22801,"_15391":35472,"_1609":36292},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_8091":1249,"_22651":932,"_19215":36294,"_5":22801,"_15391":35472,"_1609":36295},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_8091":1250,"_22651":932,"_19215":36297,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1251,"_22651":932,"_19215":36299,"_5":22801,"_15391":35472,"_1609":36300},[],"`device not preregistered`",{"_8091":1252,"_22651":932,"_19215":36302,"_5":22801,"_15391":35472,"_1609":36303},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_8091":1253,"_22651":932,"_19215":36305,"_5":22801,"_15391":35472,"_1609":36306},[],"Registrar el dispositivo antes de inscribirlo.",{"_8091":1254,"_22651":932,"_19215":36308,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1255,"_22651":932,"_19215":36310,"_5":22801,"_15391":35472,"_1609":36311},[],"`invalid reenroll window`",{"_8091":1256,"_22651":932,"_19215":36313,"_5":22801,"_15391":35472,"_1609":36314},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_8091":1257,"_22651":932,"_19215":36316,"_5":22801,"_15391":35472,"_1609":36317},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_8091":1258,"_22651":932,"_19215":36319,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1259,"_22651":932,"_19215":36321,"_5":22801,"_15391":35472,"_1609":36322},[],"`invalid RawSubject bytes`",{"_8091":1260,"_22651":932,"_19215":36324,"_5":22801,"_15391":35472,"_1609":36325},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_8091":1261,"_22651":932,"_19215":36327,"_5":22801,"_15391":35472,"_1609":36328},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_8091":1262,"_22651":932,"_19215":36330,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1263,"_22651":932,"_19215":36332,"_5":22801,"_15391":35472,"_1609":36333},[],"`external webhook denied enrollment`",{"_8091":1264,"_22651":932,"_19215":36335,"_5":22801,"_15391":35472,"_1609":36336},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_8091":1265,"_22651":932,"_19215":36338,"_5":22801,"_15391":35472,"_1609":36339},[],"Revisar los logs del servicio webhook.",{"_8091":1266,"_22651":932,"_19215":36341,"_5":22801,"_15391":35472,"_1609":20573},[],{"_8091":1267,"_22651":932,"_19215":36343,"_5":22801,"_15391":35472,"_1609":36344},[],"`server key generation not enabled`",{"_8091":1268,"_22651":932,"_19215":36346,"_5":22801,"_15391":35472,"_1609":36347},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_8091":1269,"_22651":932,"_19215":36349,"_5":22801,"_15391":35472,"_1609":36350},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_8091":1270,"_22651":932,"_19215":36352,"_5":22801,"_15391":35472,"_1609":36353},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_8091":1271,"_22651":932,"_19215":36355,"_5":22801,"_15391":35476,"_1609":36356},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_8091":1272,"_22651":932,"_19215":36358,"_5":22801,"_15391":35476,"_1609":36359},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_8091":1273,"_22651":932,"_19215":36361,"_5":22801,"_15391":35476,"_1609":36362},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_8091":1274,"_22651":932,"_19215":36364,"_5":22801,"_15391":35476,"_1609":36365},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_8091":1275,"_22651":932,"_19215":36367,"_5":22801,"_15391":35476,"_1609":36368},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_8091":1276,"_22651":932,"_19215":36370,"_5":22801,"_15391":35476,"_1609":36371},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_8091":1277,"_22651":932,"_19215":36373,"_5":22801,"_15391":35476,"_1609":36374},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_8091":1278,"_22651":932,"_19215":36376,"_5":22801,"_15391":35476,"_1609":36377},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_8091":1279,"_22651":932,"_19215":36379,"_5":22801,"_15391":35476,"_1609":36380},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_8091":1280,"_22651":932,"_19215":36382,"_5":22801,"_15391":35476,"_1609":36383},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_8091":1281,"_22651":1281,"_5":22796,"_1609":36385,"_22809":36386,"_19215":36387,"_15391":1281},"[KMS] Gestión de Claves Criptográficas",[32566,33665,33674],[],{"_8091":1282,"_22651":1281,"_19215":36389,"_5":22801,"_15391":1281,"_1609":36390},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_8091":1283,"_22651":1281,"_5":22806,"_19215":36392,"_15391":36393,"_1609":36394},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_8091":1284,"_22651":1281,"_5":22806,"_19215":36396,"_15391":36397,"_1609":36398},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_8091":1285,"_22651":1281,"_5":22806,"_19215":36400,"_15391":36401,"_1609":36402},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_8091":1286,"_22651":1281,"_5":22806,"_19215":36404,"_15391":36405,"_1609":36406},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#tipos-de-clave-y-algoritmos-soportados","Tipos de clave y algoritmos soportados",{"_8091":1287,"_22651":1281,"_5":22806,"_19215":36408,"_15391":36409,"_1609":36410},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#algoritmos-clásicos","Algoritmos clásicos",{"_8091":1288,"_22651":1281,"_5":22806,"_19215":36412,"_15391":36413,"_1609":36414},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#algoritmos-post-cuánticos","Algoritmos post-cuánticos",{"_8091":1289,"_22651":1281,"_5":22806,"_19215":36416,"_15391":36417,"_1609":36418},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#disponibilidad-por-motor","Disponibilidad por motor",{"_8091":1290,"_22651":1281,"_5":22806,"_19215":36420,"_15391":36421,"_1609":36422},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#importación-de-claves-post-cuánticas","Importación de claves post-cuánticas",{"_8091":1291,"_22651":1281,"_5":22806,"_19215":36424,"_15391":36425,"_1609":36426},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_8091":1292,"_22651":1281,"_5":22806,"_19215":36428,"_15391":36429,"_1609":36430},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_8091":1293,"_22651":1281,"_5":22806,"_19215":36432,"_15391":36433,"_1609":36434},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_8091":1294,"_22651":1281,"_5":22806,"_19215":36436,"_15391":36437,"_1609":36438},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_8091":1295,"_22651":1281,"_5":22806,"_19215":36440,"_15391":36441,"_1609":36442},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_8091":1296,"_22651":1281,"_5":22806,"_19215":36444,"_15391":36445,"_1609":36446},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_8091":1297,"_22651":1281,"_5":22806,"_19215":36448,"_15391":36449,"_1609":36450},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_8091":1298,"_22651":1281,"_5":22806,"_19215":36452,"_15391":36453,"_1609":36454},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#sign","Sign",{"_8091":1299,"_22651":1281,"_5":22806,"_19215":36456,"_15391":36457,"_1609":36458},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#verify","Verify",{"_8091":1300,"_22651":1281,"_5":22806,"_19215":36460,"_15391":36461,"_1609":36462},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_8091":1301,"_22651":1281,"_5":22806,"_19215":36464,"_15391":36465,"_1609":36466},[],"/docs/pr-preview/pr-25/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_8091":1302,"_22651":1281,"_19215":36468,"_5":22801,"_15391":36393,"_1609":36469},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_8091":1303,"_22651":1281,"_19215":36471,"_5":22801,"_15391":36393,"_1609":36472},[],"Lamassu IoT trabaja con claves asimétricas: además de los algoritmos clásicos (RSA, curvas elípticas y Ed25519), soporta algoritmos de criptografía post-cuántica (PQC), como ML-DSA, SLH-DSA y las claves compuestas *Composite ML-DSA*, pensadas para resistir los ataques de los ordenadores cuánticos. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_8091":1304,"_22651":1281,"_19215":36474,"_5":22801,"_15391":36397,"_1609":36475},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_8091":1305,"_22651":1281,"_19215":36477,"_5":22801,"_15391":36397,"_1609":36478},[],"En la práctica, permite:",{"_8091":1306,"_22651":1281,"_19215":36480,"_5":22801,"_15391":36397,"_1609":36481},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_8091":1307,"_22651":1281,"_19215":36483,"_5":22801,"_15391":36397,"_1609":36484},[],"Importar claves creadas externamente.",{"_8091":1308,"_22651":1281,"_19215":36486,"_5":22801,"_15391":36397,"_1609":36487},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_8091":1309,"_22651":1281,"_19215":36489,"_5":22801,"_15391":36397,"_1609":36490},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_8091":1310,"_22651":1281,"_19215":36492,"_5":22801,"_15391":36401,"_1609":36493},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_8091":1311,"_22651":1281,"_19215":36495,"_5":22801,"_15391":36401,"_1609":36496},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_8091":1312,"_22651":1281,"_19215":36498,"_5":22801,"_15391":36401,"_1609":36499},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_8091":1313,"_22651":1281,"_19215":36501,"_5":22801,"_15391":36401,"_1609":36502},[],"Crypto Engine",{"_8091":1314,"_22651":1281,"_19215":36504,"_5":22801,"_15391":36401,"_1609":36505},[],"Nivel de seguridad",{"_8091":1315,"_22651":1281,"_19215":36507,"_5":22801,"_15391":36401,"_1609":36508},[],"OnPrem / Cloud",{"_8091":1316,"_22651":1281,"_19215":36510,"_5":22801,"_15391":36401,"_1609":36511},[],"Coste adicional",{"_8091":1317,"_22651":1281,"_19215":36513,"_5":22801,"_15391":36401,"_1609":36514},[],"Generación de claves",{"_8091":1318,"_22651":1281,"_19215":36516,"_5":22801,"_15391":36401,"_1609":36517},[],"Persistencia *at-rest* segura",{"_8091":1319,"_22651":1281,"_19215":36519,"_5":22801,"_15391":36401,"_1609":36520},[],"Filtración de claves",{"_8091":1320,"_22651":1281,"_19215":36522,"_5":22801,"_15391":36401,"_1609":36523},[],"Consideraciones",{"_8091":1321,"_22651":1281,"_19215":36525,"_5":22801,"_15391":36401,"_1609":36526},[],"File System",{"_8091":1322,"_22651":1281,"_19215":36528,"_5":22801,"_15391":36401,"_1609":11435},[],{"_8091":1323,"_22651":1281,"_19215":36530,"_5":22801,"_15391":36401,"_1609":36531},[],"OnPrem y Cloud",{"_8091":1324,"_22651":1281,"_19215":36533,"_5":22801,"_15391":36401,"_1609":33965},[],{"_8091":1325,"_22651":1281,"_19215":36535,"_5":22801,"_15391":36401,"_1609":36536},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_8091":1326,"_22651":1281,"_19215":36538,"_5":22801,"_15391":36401,"_1609":36539},[],"**Insegura**. Delegada en el sistema de archivos.",{"_8091":1327,"_22651":1281,"_19215":36541,"_5":22801,"_15391":36401,"_1609":36539},[],{"_8091":1328,"_22651":1281,"_19215":36543,"_5":22801,"_15391":36401,"_1609":36544},[],"No recomendado para producción.",{"_8091":1329,"_22651":1281,"_19215":36546,"_5":22801,"_15391":36401,"_1609":36547},[],"HashiCorp Vault",{"_8091":1330,"_22651":1281,"_19215":36549,"_5":22801,"_15391":36401,"_1609":4073},[],{"_8091":1331,"_22651":1281,"_19215":36551,"_5":22801,"_15391":36401,"_1609":36531},[],{"_8091":1332,"_22651":1281,"_19215":36553,"_5":22801,"_15391":36401,"_1609":33965},[],{"_8091":1333,"_22651":1281,"_19215":36555,"_5":22801,"_15391":36401,"_1609":36556},[],"Depende de la configuración de Vault.",{"_8091":1334,"_22651":1281,"_19215":36558,"_5":22801,"_15391":36401,"_1609":36559},[],"**Segura**",{"_8091":1335,"_22651":1281,"_19215":36561,"_5":22801,"_15391":36401,"_1609":36562},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_8091":1336,"_22651":1281,"_19215":36564,"_5":22801,"_15391":36401,"_1609":36565},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_8091":1337,"_22651":1281,"_19215":36567,"_5":22801,"_15391":36401,"_1609":36568},[],"AWS Secrets Manager",{"_8091":1338,"_22651":1281,"_19215":36570,"_5":22801,"_15391":36401,"_1609":4073},[],{"_8091":1339,"_22651":1281,"_19215":36572,"_5":22801,"_15391":36401,"_1609":36573},[],"Cloud",{"_8091":1340,"_22651":1281,"_19215":36575,"_5":22801,"_15391":36401,"_1609":33913},[],{"_8091":1341,"_22651":1281,"_19215":36577,"_5":22801,"_15391":36401,"_1609":36578},[],"Depende del proceso de alta de la clave.",{"_8091":1342,"_22651":1281,"_19215":36580,"_5":22801,"_15391":36401,"_1609":36559},[],{"_8091":1343,"_22651":1281,"_19215":36582,"_5":22801,"_15391":36401,"_1609":36562},[],{"_8091":1344,"_22651":1281,"_19215":36584,"_5":22801,"_15391":36401,"_1609":36585},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_8091":1345,"_22651":1281,"_19215":36587,"_5":22801,"_15391":36401,"_1609":36588},[],"AWS KMS",{"_8091":1346,"_22651":1281,"_19215":36590,"_5":22801,"_15391":36401,"_1609":13638},[],{"_8091":1347,"_22651":1281,"_19215":36592,"_5":22801,"_15391":36401,"_1609":36573},[],{"_8091":1348,"_22651":1281,"_19215":36594,"_5":22801,"_15391":36401,"_1609":33913},[],{"_8091":1349,"_22651":1281,"_19215":36596,"_5":22801,"_15391":36401,"_1609":36597},[],"**Entropía hardware**",{"_8091":1350,"_22651":1281,"_19215":36599,"_5":22801,"_15391":36401,"_1609":36559},[],{"_8091":1351,"_22651":1281,"_19215":36601,"_5":22801,"_15391":36401,"_1609":36559},[],{"_8091":1352,"_22651":1281,"_19215":36603,"_5":22801,"_15391":36401,"_1609":36604},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_8091":1353,"_22651":1281,"_19215":36606,"_5":22801,"_15391":36401,"_1609":36607},[],"PKCS11",{"_8091":1354,"_22651":1281,"_19215":36609,"_5":22801,"_15391":36401,"_1609":36610},[],"3\\*",{"_8091":1355,"_22651":1281,"_19215":36612,"_5":22801,"_15391":36401,"_1609":36613},[],"AirGap OnPrem y Cloud",{"_8091":1356,"_22651":1281,"_19215":36615,"_5":22801,"_15391":36401,"_1609":36616},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_8091":1357,"_22651":1281,"_19215":36618,"_5":22801,"_15391":36401,"_1609":36597},[],{"_8091":1358,"_22651":1281,"_19215":36620,"_5":22801,"_15391":36401,"_1609":36621},[],"**Segura**\\*",{"_8091":1359,"_22651":1281,"_19215":36623,"_5":22801,"_15391":36401,"_1609":36624},[],"Depende del HSM",{"_8091":1360,"_22651":1281,"_19215":36626,"_5":22801,"_15391":36401,"_1609":36627},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_8091":1361,"_22651":1281,"_19215":36629,"_5":22801,"_15391":36401,"_1609":36630},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_8091":1362,"_22651":1281,"_19215":36632,"_5":22801,"_15391":36401,"_1609":36633},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar. La matriz de algoritmos declarada por el motor también determina si en él se pueden crear claves post-cuánticas: si un motor no declara soporte para un tipo de clave, Lamassu rechazará su creación o importación con el error *unsupported key type*.",{"_8091":1363,"_22651":1281,"_19215":36635,"_5":22801,"_15391":36401,"_1609":36636},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_8091":1364,"_22651":1281,"_19215":36638,"_5":22801,"_15391":36405,"_1609":36639},[],"Lamassu admite claves clásicas y claves de criptografía post-cuántica. Los algoritmos post-cuánticos se alinean con las nuevas generaciones de estándares NIST (ML-DSA, FIPS 204, y SLH-DSA, FIPS 205). También se admiten certificados compuestos (*composite*), que combinan una firma clásica y una firma post-cuántica en el mismo certificado X.509 para facilitar la transición.",{"_8091":1365,"_22651":1281,"_19215":36641,"_5":22801,"_15391":36409,"_1609":36642},[],"Algoritmo",{"_8091":1366,"_22651":1281,"_19215":36644,"_5":22801,"_15391":36409,"_1609":36645},[],"Parámetros",{"_8091":1367,"_22651":1281,"_19215":36647,"_5":22801,"_15391":36409,"_1609":36648},[],"RSA",{"_8091":1368,"_22651":1281,"_19215":36650,"_5":22801,"_15391":36409,"_1609":36651},[],"1024, 2048, 3072 y 4096 bits (los motores software admiten además 7680 y 15360)",{"_8091":1369,"_22651":1281,"_19215":36653,"_5":22801,"_15391":36409,"_1609":36654},[],"ECDSA",{"_8091":1370,"_22651":1281,"_19215":36656,"_5":22801,"_15391":36409,"_1609":36657},[],"Curvas P-224, P-256, P-384 y P-521, según el motor",{"_8091":1371,"_22651":1281,"_19215":36659,"_5":22801,"_15391":36409,"_1609":36660},[],"Ed25519",{"_8091":1372,"_22651":1281,"_19215":36662,"_5":22801,"_15391":36409,"_1609":36663},[],"256 bits",{"_8091":1373,"_22651":1281,"_19215":36665,"_5":22801,"_15391":36413,"_1609":36666},[],"Familia",{"_8091":1374,"_22651":1281,"_19215":36668,"_5":22801,"_15391":36413,"_1609":36645},[],{"_8091":1375,"_22651":1281,"_19215":36670,"_5":22801,"_15391":36413,"_1609":36671},[],"ML-DSA",{"_8091":1376,"_22651":1281,"_19215":36673,"_5":22801,"_15391":36413,"_1609":36674},[],"Niveles de seguridad 44, 65 y 87",{"_8091":1377,"_22651":1281,"_19215":36676,"_5":22801,"_15391":36413,"_1609":36677},[],"SLH-DSA",{"_8091":1378,"_22651":1281,"_19215":36679,"_5":22801,"_15391":36413,"_1609":36680},[],"Juegos de parámetros del 1 al 12 (por ejemplo, 1 = SHA2-128s y 5 = SHA2-256s)",{"_8091":1379,"_22651":1281,"_19215":36682,"_5":22801,"_15391":36413,"_1609":36683},[],"Composite-ML-DSA-RSA",{"_8091":1380,"_22651":1281,"_19215":36685,"_5":22801,"_15391":36413,"_1609":36686},[],"Variantes 1 a 8: combinación de ML-DSA con firmas RSA (por ejemplo, variante 1 = MLDSA44-RSA2048-PSS-SHA256)",{"_8091":1381,"_22651":1281,"_19215":36688,"_5":22801,"_15391":36413,"_1609":36689},[],"Composite-ML-DSA-ECDSA",{"_8091":1382,"_22651":1281,"_19215":36691,"_5":22801,"_15391":36413,"_1609":36692},[],"Variantes 9 a 13: combinación de ML-DSA con firmas ECDSA",{"_8091":1383,"_22651":1281,"_19215":36694,"_5":22801,"_15391":36413,"_1609":36695},[],"Composite-ML-DSA-Ed25519",{"_8091":1384,"_22651":1281,"_19215":36697,"_5":22801,"_15391":36413,"_1609":36698},[],"Variantes 14 y 15: combinación de ML-DSA con firmas Ed25519",{"_8091":1385,"_22651":1281,"_19215":36700,"_5":22801,"_15391":36417,"_1609":36701},[],"La disponibilidad de estos tipos de clave depende del motor criptográfico que custodie la clave:",{"_8091":1386,"_22651":1281,"_19215":36703,"_5":22801,"_15391":36417,"_1609":36704},[],"El motor software (File System) soporta la matriz completa de algoritmos, incluidos todos los post-cuánticos.",{"_8091":1387,"_22651":1281,"_19215":36706,"_5":22801,"_15391":36417,"_1609":36707},[],"Los motores externos solo exponen los algoritmos que declara su proveedor. Los algoritmos post-cuánticos aún no están disponibles en ellos, por lo que las solicitudes de creación o importación de claves de este tipo se rechazarán.",{"_8091":1388,"_22651":1281,"_19215":36709,"_5":22801,"_15391":36421,"_1609":36710},[],"Además de generarse en Lamassu, las claves post-cuánticas pueden importarse como claves privadas en formato PKCS#8/PEM de los algoritmos soportados: ML-DSA (niveles 44, 65 y 87), SLH-DSA (esquemas `SLH-DSA-*`) y claves privadas compuestas (`CompositePrivateKey`). El motor de destino debe declarar soporte para el algoritmo de la clave importada.",{"_8091":1389,"_22651":1281,"_19215":36712,"_5":22801,"_15391":36425,"_1609":36713},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_8091":1390,"_22651":1281,"_19215":36715,"_5":22801,"_15391":36425,"_1609":36716},[],"La tabla incluye los siguientes campos:",{"_8091":1391,"_22651":1281,"_19215":36718,"_5":22801,"_15391":36425,"_1609":36719},[],"**Name**: nombre descriptivo de la clave.",{"_8091":1392,"_22651":1281,"_19215":36721,"_5":22801,"_15391":36425,"_1609":36722},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048, EC P-256 o ML-DSA 65.",{"_8091":1393,"_22651":1281,"_19215":36724,"_5":22801,"_15391":36425,"_1609":36725},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_8091":1394,"_22651":1281,"_19215":36727,"_5":22801,"_15391":36425,"_1609":36728},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_8091":1395,"_22651":1281,"_19215":36730,"_5":22801,"_15391":36425,"_1609":36731},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_8091":1396,"_22651":1281,"_19215":36733,"_5":22801,"_15391":36425,"_1609":36734},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_8091":1397,"_22651":1281,"_19215":36736,"_5":22801,"_15391":36425,"_1609":36737},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_8091":1398,"_22651":1281,"_19215":36739,"_5":22801,"_15391":36425,"_1609":36740},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_8091":1399,"_22651":1281,"_19215":36742,"_5":22801,"_15391":36425,"_1609":36743},[],"Desde esta vista también se accede a las acciones más habituales:",{"_8091":1400,"_22651":1281,"_19215":36745,"_5":22801,"_15391":36425,"_1609":36746},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_8091":1401,"_22651":1281,"_19215":36748,"_5":22801,"_15391":36425,"_1609":36749},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_8091":1402,"_22651":1281,"_19215":36751,"_5":22801,"_15391":36425,"_1609":36752},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_8091":1403,"_22651":1281,"_19215":36754,"_5":22801,"_15391":36425,"_1609":36755},[],"**Delete Key** para eliminar la clave del sistema.",{"_8091":1404,"_22651":1281,"_19215":36757,"_5":22801,"_15391":36429,"_1609":36758},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_8091":1405,"_22651":1281,"_19215":36760,"_5":22801,"_15391":36433,"_1609":36761},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_8091":1406,"_22651":1281,"_19215":36763,"_5":22801,"_15391":36433,"_1609":36764},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_8091":1407,"_22651":1281,"_19215":36766,"_5":22801,"_15391":36433,"_1609":36767},[],"**Key Name**: nombre único y descriptivo.",{"_8091":1408,"_22651":1281,"_19215":36769,"_5":22801,"_15391":36433,"_1609":36770},[],"**Crypto Engine**: motor que custodiará la clave.",{"_8091":1409,"_22651":1281,"_19215":36772,"_5":22801,"_15391":36433,"_1609":36773},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva. Consulte la sección Tipos de clave y algoritmos soportados para ver las opciones disponibles y su disponibilidad por motor.",{"_8091":1410,"_22651":1281,"_19215":36775,"_5":22801,"_15391":36433,"_1609":36776},[],"**Tags**: metadatos para clasificar la clave.",{"_8091":1411,"_22651":1281,"_19215":36778,"_5":22801,"_15391":36433,"_1609":36779},[],"**Metadata**: información adicional para usos avanzados.",{"_8091":1412,"_22651":1281,"_19215":36781,"_5":22801,"_15391":36437,"_1609":36782},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_8091":1413,"_22651":1281,"_19215":36784,"_5":22801,"_15391":36437,"_1609":36785},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_8091":1414,"_22651":1281,"_19215":36787,"_5":22801,"_15391":36437,"_1609":36788},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_8091":1415,"_22651":1281,"_19215":36790,"_5":22801,"_15391":36437,"_1609":36791},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_8091":1416,"_22651":1281,"_19215":36793,"_5":22801,"_15391":36437,"_1609":36794},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_8091":1417,"_22651":1281,"_19215":36796,"_5":22801,"_15391":36437,"_1609":36797},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_8091":1418,"_22651":1281,"_19215":36799,"_5":22801,"_15391":36437,"_1609":36800},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_8091":1419,"_22651":1281,"_19215":36802,"_5":22801,"_15391":36437,"_1609":36803},[],"**Tags**: etiquetas para organización y búsqueda.",{"_8091":1420,"_22651":1281,"_19215":36805,"_5":22801,"_15391":36437,"_1609":36806},[],"**Metadata**: información adicional opcional.",{"_8091":1421,"_22651":1281,"_19215":36808,"_5":22801,"_15391":36437,"_1609":36809},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_8091":1422,"_22651":1281,"_19215":36811,"_5":22801,"_15391":36437,"_1609":36812},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_8091":1423,"_22651":1281,"_19215":36814,"_5":22801,"_15391":36441,"_1609":36815},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_8091":1424,"_22651":1281,"_19215":36817,"_5":22801,"_15391":36445,"_1609":36818},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_8091":1425,"_22651":1281,"_19215":36820,"_5":22801,"_15391":36445,"_1609":36821},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_8091":1426,"_22651":1281,"_19215":36823,"_5":22801,"_15391":36445,"_1609":36824},[],"**Key Name**: nombre descriptivo.",{"_8091":1427,"_22651":1281,"_19215":36826,"_5":22801,"_15391":36445,"_1609":36827},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_8091":1428,"_22651":1281,"_19215":36829,"_5":22801,"_15391":36445,"_1609":36830},[],"**Tags**: etiquetas asociadas.",{"_8091":1429,"_22651":1281,"_19215":36832,"_5":22801,"_15391":36445,"_1609":36833},[],"**Aliases**: nombres alternativos.",{"_8091":1430,"_22651":1281,"_19215":36835,"_5":22801,"_15391":36445,"_1609":36836},[],"**Crypto Engine**: motor en el que reside la clave.",{"_8091":1431,"_22651":1281,"_19215":36838,"_5":22801,"_15391":36445,"_1609":36839},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_8091":1432,"_22651":1281,"_19215":36841,"_5":22801,"_15391":36445,"_1609":36842},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_8091":1433,"_22651":1281,"_19215":36844,"_5":22801,"_15391":36445,"_1609":36845},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_8091":1434,"_22651":1281,"_19215":36847,"_5":22801,"_15391":36449,"_1609":36848},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_8091":1435,"_22651":1281,"_19215":36850,"_5":22801,"_15391":36449,"_1609":36851},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_8091":1436,"_22651":1281,"_19215":36853,"_5":22801,"_15391":36453,"_1609":36854},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_8091":1437,"_22651":1281,"_19215":36856,"_5":22801,"_15391":36453,"_1609":36857},[],"Campos principales:",{"_8091":1438,"_22651":1281,"_19215":36859,"_5":22801,"_15391":36453,"_1609":36860},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_8091":1439,"_22651":1281,"_19215":36862,"_5":22801,"_15391":36453,"_1609":36863},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_8091":1440,"_22651":1281,"_19215":36865,"_5":22801,"_15391":36453,"_1609":36866},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_8091":1441,"_22651":1281,"_19215":36868,"_5":22801,"_15391":36453,"_1609":36869},[],"**Message**: contenido que se va a firmar.",{"_8091":1442,"_22651":1281,"_19215":36871,"_5":22801,"_15391":36453,"_1609":36872},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_8091":1443,"_22651":1281,"_19215":36874,"_5":22801,"_15391":36453,"_1609":36875},[],"Para las claves post-cuánticas y Ed25519, los algoritmos de firma son de tipo *PURE* (`MLDSA_44_PURE`, `MLDSA_65_PURE`, `MLDSA_87_PURE`, `SLHDSA_PURE`, `Ed25519_PURE`, `COMPOSITE_MLDSA_RSA_PURE`, `COMPOSITE_MLDSA_ECDSA_PURE` y `COMPOSITE_MLDSA_ED25519_PURE`). En este modo la firma se calcula sobre el mensaje tal cual se proporciona, sin calcular ningún *digest* intermedio, por lo que el campo **Message Type** no interviene.",{"_8091":1444,"_22651":1281,"_19215":36877,"_5":22801,"_15391":36457,"_1609":36878},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_8091":1445,"_22651":1281,"_19215":36880,"_5":22801,"_15391":36457,"_1609":36857},[],{"_8091":1446,"_22651":1281,"_19215":36882,"_5":22801,"_15391":36457,"_1609":36883},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_8091":1447,"_22651":1281,"_19215":36885,"_5":22801,"_15391":36457,"_1609":36886},[],"**Message Type**: `Raw` o `Digest`.",{"_8091":1448,"_22651":1281,"_19215":36888,"_5":22801,"_15391":36457,"_1609":36889},[],"**Payload Encoding**: codificación del mensaje.",{"_8091":1449,"_22651":1281,"_19215":36891,"_5":22801,"_15391":36457,"_1609":36892},[],"**Message**: mensaje original o hash.",{"_8091":1450,"_22651":1281,"_19215":36894,"_5":22801,"_15391":36457,"_1609":36895},[],"**Signature**: firma que se desea comprobar.",{"_8091":1451,"_22651":1281,"_19215":36897,"_5":22801,"_15391":36457,"_1609":36898},[],"**Result**: indicador del resultado de la validación.",{"_8091":1452,"_22651":1281,"_19215":36900,"_5":22801,"_15391":36457,"_1609":36901},[],"Al igual que en la firma, los algoritmos *PURE* de las claves post-cuánticas y Ed25519 verifican el mensaje tal cual se proporciona, sin aplicar ningún *digest*, por lo que el campo **Message Type** no interviene.",{"_8091":1453,"_22651":1281,"_19215":36903,"_5":22801,"_15391":36461,"_1609":36904},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_8091":1454,"_22651":1281,"_19215":36906,"_5":22801,"_15391":36461,"_1609":36907},[],"Este flujo es útil para:",{"_8091":1455,"_22651":1281,"_19215":36909,"_5":22801,"_15391":36461,"_1609":36910},[],"Solicitar certificados a una CA externa.",{"_8091":1456,"_22651":1281,"_19215":36912,"_5":22801,"_15391":36461,"_1609":36913},[],"Renovar una identidad manteniendo la misma clave.",{"_8091":1457,"_22651":1281,"_19215":36915,"_5":22801,"_15391":36461,"_1609":36916},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_8091":1458,"_22651":1281,"_19215":36918,"_5":22801,"_15391":36461,"_1609":36919},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_8091":1459,"_22651":1281,"_19215":36921,"_5":22801,"_15391":36461,"_1609":36922},[],"**Organization (O)**: organización o empresa.",{"_8091":1460,"_22651":1281,"_19215":36924,"_5":22801,"_15391":36461,"_1609":36925},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_8091":1461,"_22651":1281,"_19215":36927,"_5":22801,"_15391":36461,"_1609":36928},[],"**Country (C)**: código de país de dos letras.",{"_8091":1462,"_22651":1281,"_19215":36930,"_5":22801,"_15391":36461,"_1609":36931},[],"**State / Province (ST)**: estado o provincia.",{"_8091":1463,"_22651":1281,"_19215":36933,"_5":22801,"_15391":36461,"_1609":36934},[],"**Locality (L)**: ciudad o localidad.",{"_8091":1464,"_22651":1281,"_19215":36936,"_5":22801,"_15391":36461,"_1609":36937},[],"**Email Address**: correo de contacto.",{"_8091":1465,"_22651":1281,"_19215":36939,"_5":22801,"_15391":36461,"_1609":36940},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_8091":1466,"_22651":1281,"_19215":36942,"_5":22801,"_15391":36461,"_1609":36943},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_8091":1467,"_22651":1281,"_19215":36945,"_5":22801,"_15391":36465,"_1609":36946},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_8091":1468,"_22651":1281,"_19215":36948,"_5":22801,"_15391":36465,"_1609":36949},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_8091":1469,"_22651":1469,"_5":22796,"_1609":36951,"_22809":36952,"_19215":36953,"_15391":1469},"[DMS] Device Management Service",[32566,33665,33674],[],{"_8091":1470,"_22651":1469,"_19215":36955,"_5":22801,"_15391":1469,"_1609":36956},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_8091":1471,"_22651":1469,"_5":22806,"_19215":36958,"_15391":36959,"_1609":36960},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#device-management-service","Device Management Service",{"_8091":1472,"_22651":1469,"_5":22806,"_19215":36962,"_15391":36963,"_1609":35421},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#antes-de-empezar",{"_8091":1473,"_22651":1469,"_5":22806,"_19215":36965,"_15391":36966,"_1609":36967},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_8091":1474,"_22651":1469,"_5":22806,"_19215":36969,"_15391":36970,"_1609":36971},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_8091":1475,"_22651":1469,"_5":22806,"_19215":36973,"_15391":36974,"_1609":36975},[],"/docs/pr-preview/pr-25/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_8091":1476,"_22651":1469,"_19215":36977,"_5":22801,"_15391":36959,"_1609":36978},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_8091":1477,"_22651":1469,"_19215":36980,"_5":22801,"_15391":36959,"_1609":36981},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_8091":1478,"_22651":1469,"_19215":36983,"_5":22801,"_15391":36963,"_1609":36984},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_8091":1479,"_22651":1469,"_19215":36986,"_5":22801,"_15391":36966,"_1609":36987},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_8091":1480,"_22651":1469,"_19215":36989,"_5":22801,"_15391":36966,"_1609":36990},[],"Acción",{"_8091":1481,"_22651":1469,"_19215":36992,"_5":22801,"_15391":36966,"_1609":32769},[],{"_8091":1482,"_22651":1469,"_19215":36994,"_5":22801,"_15391":36966,"_1609":36995},[],"**Edit**",{"_8091":1483,"_22651":1469,"_19215":36997,"_5":22801,"_15391":36966,"_1609":36998},[],"Modifica la configuración del DMS.",{"_8091":1484,"_22651":1469,"_19215":37000,"_5":22801,"_15391":36966,"_1609":37001},[],"**Go to DMS owned devices**",{"_8091":1485,"_22651":1469,"_19215":37003,"_5":22801,"_15391":36966,"_1609":37004},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_8091":1486,"_22651":1469,"_19215":37006,"_5":22801,"_15391":36966,"_1609":37007},[],"**Show/Edit Metadata**",{"_8091":1487,"_22651":1469,"_19215":37009,"_5":22801,"_15391":36966,"_1609":37010},[],"Accede a los metadatos del DMS para usos avanzados.",{"_8091":1488,"_22651":1469,"_19215":37012,"_5":22801,"_15391":36966,"_1609":37013},[],"**EST (RFC-7030)**",{"_8091":1489,"_22651":1469,"_19215":37015,"_5":22801,"_15391":36966,"_1609":37016},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_8091":1490,"_22651":1469,"_19215":37018,"_5":22801,"_15391":36966,"_1609":37019},[],"**Delete**",{"_8091":1491,"_22651":1469,"_19215":37021,"_5":22801,"_15391":36966,"_1609":37022},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_8091":1492,"_22651":1469,"_19215":37024,"_5":22801,"_15391":36970,"_1609":37025},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_8091":1493,"_22651":1469,"_19215":37027,"_5":22801,"_15391":36970,"_1609":33897},[],{"_8091":1494,"_22651":1469,"_19215":37029,"_5":22801,"_15391":36970,"_1609":32769},[],{"_8091":1495,"_22651":1469,"_19215":37031,"_5":22801,"_15391":36970,"_1609":37032},[],"**Include Lamassu System CA**",{"_8091":1496,"_22651":1469,"_19215":37034,"_5":22801,"_15391":36970,"_1609":37035},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_8091":1497,"_22651":1469,"_19215":37037,"_5":22801,"_15391":36970,"_1609":37038},[],"**Include Enrollment CA**",{"_8091":1498,"_22651":1469,"_19215":37040,"_5":22801,"_15391":36970,"_1609":37041},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_8091":1499,"_22651":1469,"_19215":37043,"_5":22801,"_15391":36970,"_1609":37044},[],"**Managed CAs**",{"_8091":1500,"_22651":1469,"_19215":37046,"_5":22801,"_15391":36970,"_1609":37047},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_8091":1501,"_22651":1469,"_19215":37049,"_5":22801,"_15391":36974,"_1609":37050},[],"El DMS expone un protocolo de enrolamiento a los dispositivos. En la versión actual de Lamassu, el único protocolo soportado es &#x2A;*EST (RFC 7030)**. La configuración del protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_8091":1502,"_22651":1469,"_19215":37052,"_5":22801,"_15391":36974,"_1609":37053},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_8091":1503,"_22651":1469,"_19215":37055,"_5":22801,"_15391":36974,"_1609":36383},[],{"_8091":1504,"_22651":1504,"_5":22796,"_1609":37057,"_22809":37058,"_19215":37059,"_15391":1504},"[VA] Servicio CRL",[32566,33665,33674],[],{"_8091":1505,"_22651":1504,"_19215":37061,"_5":22801,"_15391":1504,"_1609":37062},[],"Gestión y consulta de listas de revocación para validación offline",{"_8091":1506,"_22651":1504,"_5":22806,"_19215":37064,"_15391":37065,"_1609":37066},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_8091":1507,"_22651":1504,"_5":22806,"_19215":37068,"_15391":37069,"_1609":37070},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_8091":1508,"_22651":1504,"_5":22806,"_19215":37072,"_15391":37073,"_1609":37074},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_8091":1509,"_22651":1504,"_5":22806,"_19215":37076,"_15391":37077,"_1609":37078},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_8091":1510,"_22651":1504,"_5":22806,"_19215":37080,"_15391":37081,"_1609":37082},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_8091":1511,"_22651":1504,"_5":22806,"_19215":37084,"_15391":37085,"_1609":37086},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_8091":1512,"_22651":1504,"_5":22806,"_19215":37088,"_15391":37089,"_1609":37090},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_8091":1513,"_22651":1504,"_5":22806,"_19215":37092,"_15391":37093,"_1609":37094},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-crl#referencias","Referencias",{"_8091":1514,"_22651":1504,"_19215":37096,"_5":22801,"_15391":37065,"_1609":37097},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_8091":1515,"_22651":1504,"_19215":37099,"_5":22801,"_15391":37065,"_1609":37100},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_8091":1516,"_22651":1504,"_19215":37102,"_5":22801,"_15391":37069,"_1609":37103},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_8091":1517,"_22651":1504,"_19215":37105,"_5":22801,"_15391":37069,"_1609":37106},[],"Los parámetros principales son:",{"_8091":1518,"_22651":1504,"_19215":37108,"_5":22801,"_15391":37069,"_1609":33897},[],{"_8091":1519,"_22651":1504,"_19215":37110,"_5":22801,"_15391":37069,"_1609":32766},[],{"_8091":1520,"_22651":1504,"_19215":37112,"_5":22801,"_15391":37069,"_1609":32769},[],{"_8091":1521,"_22651":1504,"_19215":37114,"_5":22801,"_15391":37069,"_1609":37115},[],"`validity`",{"_8091":1522,"_22651":1504,"_19215":37117,"_5":22801,"_15391":37069,"_1609":37118},[],"7 días",{"_8091":1523,"_22651":1504,"_19215":37120,"_5":22801,"_15391":37069,"_1609":37121},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_8091":1524,"_22651":1504,"_19215":37123,"_5":22801,"_15391":37069,"_1609":37124},[],"`refresh_interval`",{"_8091":1525,"_22651":1504,"_19215":37126,"_5":22801,"_15391":37069,"_1609":37127},[],"\\~6 días y 23 horas",{"_8091":1526,"_22651":1504,"_19215":37129,"_5":22801,"_15391":37069,"_1609":37130},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_8091":1527,"_22651":1504,"_19215":37132,"_5":22801,"_15391":37069,"_1609":37133},[],"`regenerate_on_revoke`",{"_8091":1528,"_22651":1504,"_19215":37135,"_5":22801,"_15391":37069,"_1609":37136},[],"`true`",{"_8091":1529,"_22651":1504,"_19215":37138,"_5":22801,"_15391":37069,"_1609":37139},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_8091":1530,"_22651":1504,"_19215":37141,"_5":22801,"_15391":37069,"_1609":37142},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_8091":1531,"_22651":1504,"_19215":37144,"_5":22801,"_15391":37069,"_1609":37145},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_8091":1532,"_22651":1504,"_19215":37147,"_5":22801,"_15391":37073,"_1609":37148},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_8091":1533,"_22651":1504,"_19215":37150,"_5":22801,"_15391":37073,"_1609":37151},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_8091":1534,"_22651":1504,"_19215":37153,"_5":22801,"_15391":37077,"_1609":37154},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_8091":1535,"_22651":1504,"_19215":37156,"_5":22801,"_15391":37077,"_1609":37157},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_8091":1536,"_22651":1504,"_19215":37159,"_5":22801,"_15391":37081,"_1609":37160},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_8091":1537,"_22651":1504,"_19215":37162,"_5":22801,"_15391":37081,"_1609":37163},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_8091":1538,"_22651":1504,"_19215":37165,"_5":22801,"_15391":37085,"_1609":37166},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_8091":1539,"_22651":1504,"_19215":37168,"_5":22801,"_15391":37085,"_1609":37169},[],"Método",{"_8091":1540,"_22651":1504,"_19215":37171,"_5":22801,"_15391":37085,"_1609":37172},[],"Ruta",{"_8091":1541,"_22651":1504,"_19215":37174,"_5":22801,"_15391":37085,"_1609":32769},[],{"_8091":1542,"_22651":1504,"_19215":37176,"_5":22801,"_15391":37085,"_1609":37177},[],"`GET`",{"_8091":1543,"_22651":1504,"_19215":37179,"_5":22801,"_15391":37085,"_1609":37180},[],"`/v1/roles/{ca-ski}`",{"_8091":1544,"_22651":1504,"_19215":37182,"_5":22801,"_15391":37085,"_1609":37183},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_8091":1545,"_22651":1504,"_19215":37185,"_5":22801,"_15391":37085,"_1609":37186},[],"`PUT`",{"_8091":1546,"_22651":1504,"_19215":37188,"_5":22801,"_15391":37085,"_1609":37180},[],{"_8091":1547,"_22651":1504,"_19215":37190,"_5":22801,"_15391":37085,"_1609":37191},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_8091":1548,"_22651":1504,"_19215":37193,"_5":22801,"_15391":37085,"_1609":37194},[],"Ejemplo de consulta del rol VA:",{"_8091":1549,"_22651":1504,"_19215":37196,"_5":22801,"_15391":37085,"_1609":37197},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_8091":1550,"_22651":1504,"_19215":37199,"_5":22801,"_15391":37089,"_1609":37200},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_8091":1551,"_22651":1504,"_19215":37202,"_5":22801,"_15391":37093,"_1609":37203},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_8091":1552,"_22651":1504,"_19215":37205,"_5":22801,"_15391":37093,"_1609":37206},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_8091":1553,"_22651":1504,"_19215":37208,"_5":22801,"_15391":37093,"_1609":37209},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_8091":1554,"_22651":1554,"_5":22796,"_1609":37211,"_22809":37212,"_19215":37213,"_15391":1554},"[VA] Servicio OCSP",[32566,33665,33674],[],{"_8091":1555,"_22651":1554,"_19215":37215,"_5":22801,"_15391":1554,"_1609":37216},[],"Validación online del estado de certificados mediante OCSP",{"_8091":1556,"_22651":1554,"_5":22806,"_19215":37218,"_15391":37219,"_1609":37220},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_8091":1557,"_22651":1554,"_5":22806,"_19215":37222,"_15391":37223,"_1609":37224},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_8091":1558,"_22651":1554,"_5":22806,"_19215":37226,"_15391":37227,"_1609":37228},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_8091":1559,"_22651":1554,"_5":22806,"_19215":37230,"_15391":37231,"_1609":37232},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_8091":1560,"_22651":1554,"_5":22806,"_19215":37234,"_15391":37235,"_1609":37236},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_8091":1561,"_22651":1554,"_5":22806,"_19215":37238,"_15391":37239,"_1609":37094},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation-ocsp#referencias",{"_8091":1562,"_22651":1554,"_19215":37241,"_5":22801,"_15391":37219,"_1609":37242},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_8091":1563,"_22651":1554,"_19215":37244,"_5":22801,"_15391":37219,"_1609":37245},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_8091":1564,"_22651":1554,"_19215":37247,"_5":22801,"_15391":37223,"_1609":37248},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_8091":1565,"_22651":1554,"_19215":37250,"_5":22801,"_15391":37223,"_1609":37251},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_8091":1566,"_22651":1554,"_19215":37253,"_5":22801,"_15391":37223,"_1609":37254},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_8091":1567,"_22651":1554,"_19215":37256,"_5":22801,"_15391":37223,"_1609":37257},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_8091":1568,"_22651":1554,"_19215":37259,"_5":22801,"_15391":37223,"_1609":37260},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_8091":1569,"_22651":1554,"_19215":37262,"_5":22801,"_15391":37223,"_1609":37263},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_8091":1570,"_22651":1554,"_19215":37265,"_5":22801,"_15391":37227,"_1609":37266},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_8091":1571,"_22651":1554,"_19215":37268,"_5":22801,"_15391":37231,"_1609":37269},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_8091":1572,"_22651":1554,"_19215":37271,"_5":22801,"_15391":37231,"_1609":37169},[],{"_8091":1573,"_22651":1554,"_19215":37273,"_5":22801,"_15391":37231,"_1609":37172},[],{"_8091":1574,"_22651":1554,"_19215":37275,"_5":22801,"_15391":37231,"_1609":32769},[],{"_8091":1575,"_22651":1554,"_19215":37277,"_5":22801,"_15391":37231,"_1609":37177},[],{"_8091":1576,"_22651":1554,"_19215":37279,"_5":22801,"_15391":37231,"_1609":37280},[],"`/ocsp/{ocsp_request}`",{"_8091":1577,"_22651":1554,"_19215":37282,"_5":22801,"_15391":37231,"_1609":37283},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_8091":1578,"_22651":1554,"_19215":37285,"_5":22801,"_15391":37231,"_1609":37286},[],"`POST`",{"_8091":1579,"_22651":1554,"_19215":37288,"_5":22801,"_15391":37231,"_1609":37289},[],"`/ocsp`",{"_8091":1580,"_22651":1554,"_19215":37291,"_5":22801,"_15391":37231,"_1609":37292},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_8091":1581,"_22651":1554,"_19215":37294,"_5":22801,"_15391":37231,"_1609":37295},[],"Ejemplo de consulta con `curl` mediante POST:",{"_8091":1582,"_22651":1554,"_19215":37297,"_5":22801,"_15391":37231,"_1609":37298},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_8091":1583,"_22651":1554,"_19215":37300,"_5":22801,"_15391":37235,"_1609":37301},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_8091":1584,"_22651":1554,"_19215":37303,"_5":22801,"_15391":37239,"_1609":37304},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_8091":1585,"_22651":1554,"_19215":37306,"_5":22801,"_15391":37239,"_1609":37307},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_8091":1586,"_22651":1554,"_19215":37309,"_5":22801,"_15391":37239,"_1609":37310},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_8091":1587,"_22651":1554,"_19215":37312,"_5":22801,"_15391":37239,"_1609":37209},[],{"_8091":1588,"_22651":1588,"_5":22796,"_1609":37314,"_22809":37315,"_19215":37316,"_15391":1588},"[VA] Validación de Certificados",[32566,33665,33674],[],{"_8091":1589,"_22651":1588,"_19215":37318,"_5":22801,"_15391":1588,"_1609":37319},[],"Servicios OCSP y CRL para validación de certificados",{"_8091":1590,"_22651":1588,"_5":22806,"_19215":37321,"_15391":37322,"_1609":37323},[],"/docs/pr-preview/pr-25/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_8091":1591,"_22651":1588,"_19215":37325,"_5":22801,"_15391":37322,"_1609":37326},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_8091":1592,"_22651":1588,"_19215":37328,"_5":22801,"_15391":37322,"_1609":37329},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_8091":1593,"_22651":1588,"_19215":37331,"_5":22801,"_15391":37322,"_1609":37332},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_8091":1594,"_22651":1588,"_19215":37334,"_5":22801,"_15391":37322,"_1609":37335},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_8091":1595,"_22651":1595,"_5":22796,"_1609":37337,"_19215":37338,"_15391":1595},"Test",[],{"_8091":1596,"_22651":1595,"_19215":37340,"_5":22801,"_15391":1595,"_1609":37341},[],"A document to test Fumadocs",{"_8091":1597,"_22651":1595,"_5":22806,"_19215":37343,"_15391":37344,"_1609