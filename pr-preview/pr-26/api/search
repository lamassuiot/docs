ags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"500"},"1369":{"id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment-227","page_id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"`invalid RawSubject bytes`"},"1370":{"id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment-228","page_id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"El subject del CSR de renovación no coincide con el del certificado en vigor."},"1371":{"id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment-229","page_id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"Regenerar el CSR con el subject exacto del cert anterior."},"1372":{"id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment-230","page_id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"500"},"1373":{"id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment-231","page_id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"`external webhook denied enrollment`"},"1374":{"id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment-232","page_id":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"El webhook devolvió un código no `2xx` o `authorized