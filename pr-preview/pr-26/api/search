tform/pki/audit-logs","content":"Understand which audit events Lamassu generates and how to turn them into a durable trail."},"618":{"id":"/docs/pr-preview/pr-26/platform/pki/audit-logs-1","page_id":"/docs/pr-preview/pr-26/platform/pki/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/audit-logs#what-an-event-contains","content":"What an event contains"},"619":{"id":"/docs/pr-preview/pr-26/platform/pki/audit-logs-2","page_id":"/docs/pr-preview/pr-26/platform/pki/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/audit-logs#coverage","content":"Coverage"},"620":{"id":"/docs/pr-preview/pr-26/platform/pki/audit-logs-3","page_id":"/docs/pr-preview/pr-26/platform/pki/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/audit-logs#publication-and-persistence","content":"Publication and persistence"},"621":{"id":"/docs/pr-preview/pr-26/platform/pki/audit-logs-4","page_id":"/docs/pr-preview/pr-26/platform/pki/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/audit-logs#sensitive-data","content":"Sensitive data"},"622":{"id":"/docs/pr-preview/pr-26/platform/pki/audit-logs-5","page_id":"/docs/pr-preview/pr-26/platform/pki/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/audit-logs#a-reproducible-investigation","content":"A reproducible investigation"},"623":{"id":"/docs/pr-preview/pr-26/platform/pki/audit-logs-6","page_id":"/docs/pr-preview/pr-26/platform/pki/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/audit-logs#bound-the-interval","content":"Bound the interval"},"624":{"id":"/docs/pr-preview/pr-26/platform/pki/audit-logs-7","page_id":"/docs/pr-preview/pr-26/platform/pki/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/audit-logs#identify-the-operation","content":"Identify the operation"},"625":{"id":"/docs/pr-preview/pr-26/platform/pki/audit-logs-8",