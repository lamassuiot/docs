/pr-26/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-oidc","content":"Principales OIDC"},"503":{"id":"/docs/pr-preview/pr-26/es/platform/administration/access-control-8","page_id":"/docs/pr-preview/pr-26/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-x509","content":"Principales X.509"},"504":{"id":"/docs/pr-preview/pr-26/es/platform/administration/access-control-9","page_id":"/docs/pr-preview/pr-26/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/administration/access-control#cuando-coinciden-varios-principales","content":"Cuando coinciden varios principales"},"505":{"id":"/docs/pr-preview/pr-26/es/platform/administration/access-control-10","page_id":"/docs/pr-preview/pr-26/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","content":"Cómo expresan acceso las políticas"},"506":{"id":"/docs/pr-preview/pr-26/es/platform/administration/access-control-11","page_id":"/docs/pr-preview/pr-26/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-global-y-acceso-directo","content":"Acceso global y acceso directo"},"507":{"id":"/docs/pr-preview/pr-26/es/platform/administration/access-control-12","page_id":"/docs/pr-preview/pr-26/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-heredado-por-relaciones","content":"Acceso heredado por relaciones"},"508":{"id":"/docs/pr-preview/pr-26/es/platform/administration/access-control-13","page_id":"/docs/pr-preview/pr-26/es/platform/administration/a