26/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/ocsp#ocsp-service","content":"OCSP service"},"1701":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-2","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"How the responder works in Lamassu"},"1702":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-3","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/ocsp#embedding-in-issued-certificates","content":"Embedding in issued certificates"},"1703":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-4","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","content":"HTTP endpoints"},"1704":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-5","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/ocsp#check-from-the-interface","content":"Check from the interface"},"1705":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-6","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/ocsp#references","content":"References"},"1706":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-7","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#ocsp-service","content":"OCSP (Online Certificate Status Protocol) is the mechanism that lets a relying party check, in real time, whether a specific certificate is valid or has been revoked. Instead of downloading a full list of revoked certificates, the client sends a query with the certificate's serial number and receives a signed response with the current status."},"1707":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-8","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#ocsp-service","content":"Lamassu integrates its own OCSP responder that serves these queries by consulting the internal certificate database directly. No external component is required."},"1708":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-9","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"When a client requests the status of a certificate, the responder locates the certificate by its serial number and determines its status from the internal record:"},"1709":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-10","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"If the certificate is active, the response indicates `Good`."},"1710":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-11","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"If the certificate has been revoked, the response indicates `Revoked` and includes the revocation timestamp and the RFC 5280 reason code."},"1711":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-12","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"If the serial number is not found or the status is not recognizable, the response indicates `Unknown`."},"1712":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-13","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"The OCSP response is signed by the issuing CA of the queried certificate, using the cryptographic engine associated with that CA. Lamassu does not use a delegated OCSP signing certificate: the CA acts directly as the responder."},"1713":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-14","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"Each response has a validity window of 24 hours, reflected in the response's `thisUpdate` and `nextUpdate` fields. Clients that cache responses must take this window into account when determining how long a response remains valid."},"1714":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-15","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#embedding-in-issued-certificates","content":"The OCSP responder URL is automatically embedded in the AIA (*Authority Information Access*) extension of every certificate issued by Lamassu. Clients that verify certificates can read this URL directly from the certificate without additional configuration."},"1715":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-16","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","content":"The responder accepts both formats defined in RFC 6960:"},"1716":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-17","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","content":"`GET /ocsp/{ocsp_request}` includes the OCSP request Base64url-encoded within the URL itself."},"1717":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-18","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","content":"`POST /ocsp` sends the request in the body with `Content-Type: application/ocsp-request`."},"1718":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-19","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","content":"Example query with `curl` using POST:"},"1719":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-20","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","content":"The response has `Content-Type: application/ocsp-response` and contains the OCSP response in DER format."},"1720":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-21","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#check-from-the-interface","content":"From the certificates screen of Lamassu you can launch an OCSP request directly against the selected certificate with the **OCSP Check** action. This action shows the status returned by the responder without needing external tools."},"1721":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-22","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#references","content":"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*"},"1722":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-23","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#references","content":"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (revocation reasons, section 5.3.1)"},"1723":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-24","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#references","content":"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />"},"1724":{"id":"/docs/pr-preview/pr-26/platform/pki/ocsp-25","page_id":"/docs/pr-preview/pr-26/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/ocsp#references","content":"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />"},"1725":{"id":"/docs/pr-preview/pr-26/platform/pki/overview","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"page","content":"Lamassu IoT Platform","breadcrumbs":["Docs","Platform"],"tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview"},"1726":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-0","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/overview","content":"Manage PKI and digital identities for your devices from a single platform."},"1727":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-1","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#start-here","content":"Start here"},"1728":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-2","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#architecture-at-a-glance","content":"Architecture at a glance"},"1729":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-3","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#core-capabilities","content":"Core capabilities"},"1730":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-4","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#build-your-trust-hierarchy","content":"Build your trust hierarchy"},"1731":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-5","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#protect-cryptographic-keys","content":"Protect cryptographic keys"},"1732":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-6","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#issue-and-control-certificates","content":"Issue and control certificates"},"1733":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-7","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#automate-device-identities","content":"Automate device identities"},"1734":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-8","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#publish-validation-status","content":"Publish validation status"},"1735":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-9","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#react-to-events","content":"React to events"},"1736":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-10","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#choose-your-path","content":"Choose your path"},"1737":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-11","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/overview#operational-reference","content":"Operational reference"},"1738":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-12","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/overview","content":"Lamassu IoT centralizes the issuance, distribution, renewal and revocation of X.509 identities for connected devices. You can build a private PKI, protect its keys and automate the enrollment of a fleet without losing visibility into every certificate."},"1739":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-13","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/overview#start-here","content":"<Card title=\"Get started\" description=\"Create a CA, issue a certificate and register your first device.\" href=\"/docs/platform/pki/quickstarts/overview\" />"},"1740":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-14","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/overview#start-here","content":"<Card title=\"How Lamassu works\" description=\"Build the mental model of authorities, keys, identities and validation.\" href=\"/docs/platform/pki/concepts/overview\" />"},"1741":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-15","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/overview#architecture-at-a-glance","content":"Lamassu runs as a set of services on Kubernetes, backed by PostgreSQL, RabbitMQ and an OIDC provider. Hover a component to trace its connections, or see the platform architecture chapter for the low-level, per-service view."},"1742":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-16","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/overview#build-your-trust-hierarchy","content":"Create root and intermediate authorities or import an existing PKI. Define which authority can issue each identity and keep the full chain of trust."},"1743":{"id":"/docs/pr-preview/pr-26/platform/pki/overview-17","page_id":"/docs/pr-preview/pr-26/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/overview#protect-cryptographic-keys","content":"Generate and safeguard keys using software engines, PKCS#11