pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","content":"`iot:CreateThing` / `iot:UpdateThing`"},"1275":{"id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core-39","page_id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","content":"Crear o actualizar Things en IoT Core"},"1276":{"id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core-40","page_id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","content":"`iot:RegisterThing`"},"1277":{"id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core-41","page_id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","content":"Aprovisionar Things mediante plantilla"},"1278":{"id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core-42","page_id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","content":"`iot:RegisterCertificate`"},"1279":{"id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core-43","page_id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","content":"Registrar certificados de dispositivo"},"1280":{"id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core-44","page_id":"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platfo