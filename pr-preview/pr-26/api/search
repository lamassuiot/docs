ickstarts/issue-certificate-5","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","content":"Configure key and uses"},"2318":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-6","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#issue-and-download","content":"Issue and download"},"2319":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-7","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-result","content":"Verify the result"},"2320":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-8","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","content":"Inspect content and dates"},"2321":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-9","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-chain","content":"Verify the chain"},"2322":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-10","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","content":"Check that the key matches"},"2323":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-11","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#if-the-result-fails","content":"If the result fails"},"2324":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-12","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#next-step","content":"Next step"},"2325":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-13","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","content":"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`."},"2326":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-14","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin","content":"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA."},"2327":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-15","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin","content":"Its public certificate in `ca.pem`; this example uses the root created in the previous path."},"2328":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-16","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin","content":"OpenSSL 3.x and a working directory with restricted access."},"2329":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-17","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin","content":"A client identifier: here we use `device-001`."},"2330":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-18","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin","content":"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key."},"2331":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-19","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#start-the-issuance","content":"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**."},"2332":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-20","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#choose-the-method","content":"Select **Generate Key & CSR in Browser** to follow this example."},"2333":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-21","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#choose-the-method","content":"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide."},"2334":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-22","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#identify-the-certificate","content":"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client."},"2335":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-23","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#identify-the-certificate","content":"If you continue with manual registration, the `Device ID` will be exactly `device-001`."},"2336":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-24","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","content":"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate."},"2337":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-25","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","content":"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request."},"2338":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-26","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#issue-and-download","content":"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory."},"2339":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-27","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-result","content":"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below."},"2340":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-28","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","content":"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate."},"2341":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-29","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-chain","content":"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above."},"2342":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-30","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-chain","content":"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model."},"2343":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-31","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-chain","content":"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options."},"2344":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-32","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","content":"In Bash, compare the two public-key digests:"},"2345":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-33","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","content":"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it."},"2346":{"id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate-34","page_id":"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/platform/pki/q