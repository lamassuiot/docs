docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device-41","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Historial"},"1602":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device-42","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"La emisión asociada aparece con su número de serie y fechas."},"1603":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device-43","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Clave y certificado"},"1604":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device-44","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado","content":"Dispones de la pareja comprobada para instalarla en el dispositivo."},"1605":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device-45","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura."},"1606":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device-46","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device","tags":[],"ty