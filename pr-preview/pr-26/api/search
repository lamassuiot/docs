leets/enrollment/dms-49","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`EXTERNAL_WEBHOOK`"},"927":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-50","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Autorización del webhook configurado."},"928":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-51","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"929":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-52","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Validación del certificado y, después, aprobación del webhook."},"930":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-53","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`NO_AUTH`"},"931":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-54","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Sin autenticación del solicitante por el DMS."},"932":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-55","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla."},"933":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-56","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway."},"934":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-57","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores."},"935":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-58","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado."},"936":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-59","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:"},"937":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-60","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Campo de `external_webhook_settings`"},"938":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-61","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Decisión"},"939":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-62","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`url`"},"940":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-63","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones."},"941":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-64","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`method`"},"942":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-65","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`POST` o `PUT`; `POST` por defecto."},"943":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-66","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`name`"},"944":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-67","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Etiqueta usada en los logs del servicio."},"945":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-68","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.auth_mode`"},"946":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-69","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`."},"947":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-70","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.apikey_options`"},"948":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-71","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan."},"949":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-72","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.jwt_options`"},"950":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-73","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`."},"951":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-74","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.mtls_options`"},"952":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-75","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea."},"953":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-76","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.insecure_skip_verify`"},"954":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-77","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí."},"955":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-78","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.call_timeout`"},"956":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-79","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto."},"957":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-80","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Reglas de esa configuración:"},"958":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-81","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`."},"959":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-82","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan."},"960":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-83","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`."},"961":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-84","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan."},"962":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-85","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada."},"963":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-86","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia."},"964":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-87","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS."},"965":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-88","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS."},"966":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-89","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","content":"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes."},"967":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-90","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Campo de `settings.reenrollment_settings`"},"968":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-91","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Función"},"969":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-92","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`reenrollment_delta`"},"970":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-93","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"La ventana abre en `NotAfter` del certificado activo menos este delta."},"971":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-94","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`preventive_delta`"},"972":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-95","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Umbral operativo preventivo de monitorización."},"973":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-96","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`critical_delta`"},"974":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-97","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Umbral operativo crítico de monitorización."},"975":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-98","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`enable_expired_renewal`"},"976":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-99","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway."},"977":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-100","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`additional_validation_cas`"},"978":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-101","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Emisores adicionales para la credencial mTLS durante una migración."},"979":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-102","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`revoke_on_reenrollment`"},"980":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-103","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor."},"981":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-104","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales."},"982":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-105","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#serverkeygen","content":"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST."},"983":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-106","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Opción"},"984":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-107","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Qué publica"},"985":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-108","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"**Include Lamassu System CA**"},"986":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-109","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión."},"987":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-110","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"**Include Enrollment CA**"},"988":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-111","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Certificado de la CA emisora seleccionada."},"989":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-112","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"**Managed CAs**"},"990":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-113","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Certificados de las CAs elegidas explícitamente."},"991":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-114","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor."},"992":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-115","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","content":"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos."},"993":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-116","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","content":"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs."},"994":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-117","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","content":"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo."},"995":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms-118","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","content":"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos."},"996":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","type":"page","content":"Integra el cliente EST","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client"},"997":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-0","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","content":"Prepara la confianza, envía una CSR y comprueba la identidad recibida."},"998":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-1","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Antes de empezar"},"999":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-2","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","content":"Descarga e inspecciona cacerts"},"1000":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-3","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","content":"Prepara la CSR"},"1001":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-4","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","content":"Solicita la identidad"},"1002":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-5","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Comprueba e instala el resultado"},"1003":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-6","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","content":"Siguientes pasos"},"1004":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-7","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","content":"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo."},"1005":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-8","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas."},"1006":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-9","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial."},"1007":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-10","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible."},"1008":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-11","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","content":"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo."},"1009":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-12","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","content":"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen."},"1010":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-13","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","content":"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos."},"1011":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-14","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","content":"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles."},"1012":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-15","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","content":"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:"},"1013":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-16","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","content":"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión."},"1014":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-17","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Para el caso de una raíz que emite directamente:"},"1015":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-18","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI."},"1016":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-19","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso."},"1017":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client-20","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","content":"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia."},"1018":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","type":"page","content":"Referencia EST","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference"},"1019":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-0","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","content":"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu."},"1020":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-1","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Referencia de endpoints"},"1021":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-2","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#cacerts","content":"cacerts"},"1022":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-3","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"simpleenroll"},"1023":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-4","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"simplereenroll"},"1024":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-5","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"serverkeygen"},"1025":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-6","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Formato de respuesta"},"1026":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-7","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Solicitud y extracción"},"1027":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-8","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","content":"Notas de compatibilidad"},"1028":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-9","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","content":"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política."},"1029":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-10","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos."},"1030":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-11","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Operación"},"1031":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-12","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Método"},"1032":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-13","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación y condición"},"1033":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-14","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/cacerts`"},"1034":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-15","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"GET"},"1035":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-16","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose."},"1036":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-17","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/simpleenroll`"},"1037":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-18","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"POST"},"1038":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-19","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación inicial y política de registro/sustitución del DMS."},"1039":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-20","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/simplereenroll`"},"1040":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-21","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"POST"},"1041":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-22","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación de renovación, identidad existente, sujeto, revocación y ventana."},"1042":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-23","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/serverkeygen`"},"1043":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-24","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"POST"},"1044":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-25","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación y admisión iniciales; generación en servidor habilitada."},"1045":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-26","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato."},"1046":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-27","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#cacerts","content":"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes."},"1047":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-28","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#cacerts","content":"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables."},"1048":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-29","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS."},"1049":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-30","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR."},"1050":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-31","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual."},"1051":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-32","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación."},"1052":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-33","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM."},"1053":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-34","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución."},"1054":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-35","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:"},"1055":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-36","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Parte"},"1056":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-37","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Contenido tras decodificar su Base64"},"1057":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-38","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"`application/pkcs8`"},"1058":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-39","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Clave privada PKCS#8 DER sin cifrar."},"1059":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-40","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"`application/pkcs7-mime; smime-type=certs-only`"},"1060":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-41","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"PKCS#7 DER con el certificado emitido."},"1061":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-42","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras."},"1062":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-43","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor."},"1063":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-44","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:"},"1064":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-45","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Convierte y comprueba el resultado:"},"1065":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-46","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python."},"1066":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-47","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","content":"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico."},"1067":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference-48","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","content":"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico."},"1068":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","type":"page","content":"Enrolamiento con PKI","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview"},"1069":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-0","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","content":"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST."},"1070":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-1","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El recorrido"},"1071":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-2","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"Para el administrador"},"1072":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-3","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"Para el integrador"},"1073":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-4","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","content":"Versión del contrato"},"1074":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-5","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","content":"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor."},"1075":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-6","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El administrador prepara CA, perfil de emisión y DMS."},"1076":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-7","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El integrador instala confianza inicial en el servidor EST y una credencial de admisión."},"1077":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-8","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El cliente solicita una identidad para su `Device ID` mediante EST."},"1078":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-9","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado."},"1079":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-10","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación."},"1080":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-11","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS."},"1081":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-12","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />"},"1082":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-13","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1083":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-14","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />"},"1084":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-15","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />"},"1085":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-16","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1086":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-17","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"1087":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-18","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />"},"1088":{"id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview-19","page_id":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"<Card title=\"Diagnóstico\" description=\"Distingue fal