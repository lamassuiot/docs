73":113197,"_36675":113200,"_36677":113203,"_36679":113206,"_36681":113209,"_36683":113212,"_36685":113215,"_36687":113218,"_36689":113221,"_36691":113224,"_36693":113227,"_36695":113230,"_36697":113233,"_36699":113236,"_36701":113239,"_36703":113242,"_36705":113245,"_36707":113248,"_36709":113250,"_36711":113253,"_36713":113255,"_36715":113257,"_36717":113259,"_36719":113261,"_36721":113263,"_36723":113265,"_36725":113268,"_36727":113271,"_36730":113274,"_36732":113277,"_36734":113280,"_36736":113283,"_36738":113286,"_36740":113289,"_36742":113292,"_36744":113295,"_36746":113298,"_36748":113301,"_36750":113304,"_36752":113307,"_36754":113310,"_36756":113313,"_36758":113316,"_36760":113319,"_36762":113322,"_36764":113325,"_36766":113328,"_36768":113331,"_36770":113334,"_36772":113337,"_36774":113340,"_36776":113343,"_36778":113346,"_36780":113349,"_36782":113352,"_36784":113355,"_36786":113358,"_36788":113361,"_36790":113364,"_36792":113367,"_36794":113370,"_36796":113373,"_36799":113376,"_36801":113379,"_36803":113382,"_36806":113385,"_36808":113388,"_36810":113391,"_36812":113394,"_36814":113397,"_36816":113400,"_36818":113403,"_36820":113406,"_36822":113409,"_36824":113412,"_36826":113415,"_36828":113418,"_36830":113421,"_36832":113424,"_36834":113427,"_36836":113430,"_36838":113433,"_36840":113436,"_36842":113439,"_36844":113442,"_36846":113445,"_36848":113448,"_36850":113451,"_36852":113454,"_36854":113457,"_36856":113460,"_36858":113463,"_36860":113466,"_36862":113469,"_36864":113472,"_36866":113475,"_36868":113478,"_36870":113481,"_36872":113484,"_36874":113487},{"_3146":63603,"_27538":63603,"_5":13480,"_2645":105432,"_27881":105433,"_19130":105436,"_26074":63603},"Despliega desde AWS Marketplace",[44830,105434,105435],"Despliegue","Otros modelos",[],{"_3146":63604,"_27538":63603,"_19130":105438,"_5":13154,"_26074":63603,"_2645":105439},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3146":63605,"_27538":63603,"_5":27878,"_19130":105441,"_26074":105442,"_2645":105443},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3146":63606,"_27538":63603,"_5":27878,"_19130":105445,"_26074":105446,"_2645":105447},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3146":63607,"_27538":63603,"_5":27878,"_19130":105449,"_26074":105450,"_2645":105451},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3146":63608,"_27538":63603,"_5":27878,"_19130":105453,"_26074":105454,"_2645":105455},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3146":63609,"_27538":63603,"_5":27878,"_19130":105457,"_26074":105458,"_2645":105459},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3146":63610,"_27538":63603,"_5":27878,"_19130":105461,"_26074":105462,"_2645":105463},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3146":63611,"_27538":63603,"_5":27878,"_19130":105465,"_26074":105466,"_2645":105467},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3146":63612,"_27538":63603,"_19130":105469,"_5":13154,"_26074":63603,"_2645":105470},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3146":63613,"_27538":63603,"_19130":105472,"_5":13154,"_26074":105442,"_2645":105473},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3146":63614,"_27538":63603,"_19130":105475,"_5":13154,"_26074":105442,"_2645":105476},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3146":63615,"_27538":63603,"_19130":105478,"_5":13154,"_26074":105442,"_2645":105479},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3146":63616,"_27538":63603,"_19130":105481,"_5":13154,"_26074":105446,"_2645":105482},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3146":63617,"_27538":63603,"_19130":105484,"_5":13154,"_26074":105446,"_2645":105485},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3146":63618,"_27538":63603,"_19130":105487,"_5":13154,"_26074":105446,"_2645":105488},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3146":63619,"_27538":63603,"_19130":105490,"_5":13154,"_26074":105450,"_2645":105491},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3146":63620,"_27538":63603,"_19130":105493,"_5":13154,"_26074":105454,"_2645":105494},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3146":63621,"_27538":63603,"_19130":105496,"_5":13154,"_26074":105458,"_2645":105497},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3146":63622,"_27538":63603,"_19130":105499,"_5":13154,"_26074":105462,"_2645":105500},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3146":63623,"_27538":63603,"_19130":105502,"_5":13154,"_26074":105466,"_2645":105503},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3146":63624,"_27538":63624,"_5":13480,"_2645":105505,"_27881":105506,"_19130":105507,"_26074":63624},"Despliega Lamassu",[44830,105434],[],{"_3146":63625,"_27538":63624,"_19130":105509,"_5":13154,"_26074":63624,"_2645":105510},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3146":63626,"_27538":63624,"_5":27878,"_19130":105512,"_26074":105513,"_2645":105514},[],"/docs/pr-preview/pr-26/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3146":63627,"_27538":63624,"_5":27878,"_19130":105516,"_26074":105517,"_2645":105518},[],"/docs/pr-preview/pr-26/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3146":63628,"_27538":63624,"_5":27878,"_19130":105520,"_26074":105521,"_2645":105522},[],"/docs/pr-preview/pr-26/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3146":63629,"_27538":63624,"_19130":105524,"_5":13154,"_26074":63624,"_2645":105525},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3146":63630,"_27538":63624,"_19130":105527,"_5":13154,"_26074":105513,"_2645":105528},[],"Modelo",{"_3146":63631,"_27538":63624,"_19130":105530,"_5":13154,"_26074":105513,"_2645":105531},[],"Recomendado para",{"_3146":63632,"_27538":63624,"_19130":105533,"_5":13154,"_26074":105513,"_2645":105534},[],"Quién opera la infraestructura",{"_3146":63633,"_27538":63624,"_19130":105536,"_5":13154,"_26074":105513,"_2645":105537},[],"Punto de partida",{"_3146":63634,"_27538":63624,"_19130":105539,"_5":13154,"_26074":105513,"_2645":44937},[],{"_3146":63635,"_27538":63624,"_19130":105541,"_5":13154,"_26074":105513,"_2645":105542},[],"Producción, entornos regulados y despliegues personalizados",{"_3146":63636,"_27538":63624,"_19130":105544,"_5":13154,"_26074":105513,"_2645":105545},[],"Tu equipo",{"_3146":63637,"_27538":63624,"_19130":105547,"_5":13154,"_26074":105513,"_2645":105548},[],"Helm o Fastlane",{"_3146":63638,"_27538":63624,"_19130":105550,"_5":13154,"_26074":105513,"_2645":44949},[],{"_3146":63639,"_27538":63624,"_19130":105552,"_5":13154,"_26074":105513,"_2645":105553},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3146":63640,"_27538":63624,"_19130":105555,"_5":13154,"_26074":105513,"_2645":105545},[],{"_3146":63641,"_27538":63624,"_19130":105557,"_5":13154,"_26074":105513,"_2645":105558},[],"Imagen preconfigurada en EC2",{"_3146":63642,"_27538":63624,"_19130":105560,"_5":13154,"_26074":105513,"_2645":44960},[],{"_3146":63643,"_27538":63624,"_19130":105562,"_5":13154,"_26074":105513,"_2645":105563},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3146":63644,"_27538":63624,"_19130":105565,"_5":13154,"_26074":105513,"_2645":44966},[],{"_3146":63645,"_27538":63624,"_19130":105567,"_5":13154,"_26074":105513,"_2645":105568},[],"Suscripción gestionada",{"_3146":63646,"_27538":63624,"_19130":105570,"_5":13154,"_26074":105513,"_2645":105571},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3146":63647,"_27538":63624,"_19130":105573,"_5":13154,"_26074":105513,"_2645":105574},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3146":63648,"_27538":63624,"_19130":105576,"_5":13154,"_26074":105513,"_2645":105577},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3146":63649,"_27538":63624,"_19130":105579,"_5":13154,"_26074":105517,"_2645":105580},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3146":63650,"_27538":63624,"_19130":105582,"_5":13154,"_26074":105521,"_2645":105583},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3146":63651,"_27538":63651,"_5":13480,"_2645":105585,"_27881":105586,"_19130":105587,"_26074":63651},"Utiliza Lamassu como SaaS",[44830,105434,105435],[],{"_3146":63652,"_27538":63651,"_19130":105589,"_5":13154,"_26074":63651,"_2645":105590},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3146":63653,"_27538":63651,"_5":27878,"_19130":105592,"_26074":105593,"_2645":105594},[],"/docs/pr-preview/pr-26/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3146":63654,"_27538":63651,"_5":27878,"_19130":105596,"_26074":105597,"_2645":105598},[],"/docs/pr-preview/pr-26/es/deployment/saas#planes","Planes",{"_3146":63655,"_27538":63651,"_5":27878,"_19130":105600,"_26074":105601,"_2645":105602},[],"/docs/pr-preview/pr-26/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3146":63656,"_27538":63651,"_19130":105604,"_5":13154,"_26074":63651,"_2645":105605},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3146":63657,"_27538":63651,"_19130":105607,"_5":13154,"_26074":105593,"_2645":105608},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3146":63658,"_27538":63651,"_19130":105610,"_5":13154,"_26074":105593,"_2645":105611},[],"Copias de seguridad automáticas.",{"_3146":63659,"_27538":63651,"_19130":105613,"_5":13154,"_26074":105593,"_2645":105614},[],"Actualizaciones de versión.",{"_3146":63660,"_27538":63651,"_19130":105616,"_5":13154,"_26074":105593,"_2645":105617},[],"Soporte técnico y SLA según el plan contratado.",{"_3146":63661,"_27538":63651,"_19130":105619,"_5":13154,"_26074":105597,"_2645":45021},[],{"_3146":63662,"_27538":63651,"_19130":105621,"_5":13154,"_26074":105597,"_2645":105622},[],"Dispositivos",{"_3146":63663,"_27538":63651,"_19130":105624,"_5":13154,"_26074":105597,"_2645":105625},[],"Soporte",{"_3146":63664,"_27538":63651,"_19130":105627,"_5":13154,"_26074":105597,"_2645":45030},[],{"_3146":63665,"_27538":63651,"_19130":105629,"_5":13154,"_26074":105597,"_2645":45033},[],{"_3146":63666,"_27538":63651,"_19130":105631,"_5":13154,"_26074":105597,"_2645":105632},[],"Hasta 1.000",{"_3146":63667,"_27538":63651,"_19130":105634,"_5":13154,"_26074":105597,"_2645":45039},[],{"_3146":63668,"_27538":63651,"_19130":105636,"_5":13154,"_26074":105597,"_2645":105637},[],"99,5 %",{"_3146":63669,"_27538":63651,"_19130":105639,"_5":13154,"_26074":105597,"_2645":45045},[],{"_3146":63670,"_27538":63651,"_19130":105641,"_5":13154,"_26074":105597,"_2645":105642},[],"Hasta 10.000",{"_3146":63671,"_27538":63651,"_19130":105644,"_5":13154,"_26074":105597,"_2645":105645},[],"Email y chat",{"_3146":63672,"_27538":63651,"_19130":105647,"_5":13154,"_26074":105597,"_2645":105648},[],"99,9 %",{"_3146":63673,"_27538":63651,"_19130":105650,"_5":13154,"_26074":105597,"_2645":45057},[],{"_3146":63674,"_27538":63651,"_19130":105652,"_5":13154,"_26074":105597,"_2645":105653},[],"Ilimitados",{"_3146":63675,"_27538":63651,"_19130":105655,"_5":13154,"_26074":105597,"_2645":105656},[],"Dedicado",{"_3146":63676,"_27538":63651,"_19130":105658,"_5":13154,"_26074":105597,"_2645":105659},[],"99,99 %",{"_3146":63677,"_27538":63651,"_19130":105661,"_5":13154,"_26074":105601,"_2645":105662},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3146":63678,"_27538":63651,"_19130":105664,"_5":13154,"_26074":105601,"_2645":105665},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3146":63679,"_27538":63679,"_5":13480,"_2645":45074,"_27881":105667,"_19130":105669,"_26074":63679},[44830,105434,105668],"Kubernetes autogestionado",[],{"_3146":63680,"_27538":63679,"_19130":105671,"_5":13154,"_26074":63679,"_2645":105672},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3146":63681,"_27538":63679,"_5":27878,"_19130":105674,"_26074":105675,"_2645":105676},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3146":63682,"_27538":63679,"_5":27878,"_19130":105678,"_26074":105679,"_2645":105680},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3146":63683,"_27538":63679,"_5":27878,"_19130":105682,"_26074":105683,"_2645":105684},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3146":63684,"_27538":63679,"_5":27878,"_19130":105686,"_26074":105687,"_2645":105688},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3146":63685,"_27538":63679,"_5":27878,"_19130":105690,"_26074":105691,"_2645":105692},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3146":63686,"_27538":63679,"_5":27878,"_19130":105694,"_26074":105695,"_2645":105696},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3146":63687,"_27538":63679,"_5":27878,"_19130":105698,"_26074":105699,"_2645":105700},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3146":63688,"_27538":63679,"_5":27878,"_19130":105702,"_26074":105703,"_2645":105704},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3146":63689,"_27538":63679,"_5":27878,"_19130":105706,"_26074":105707,"_2645":105708},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3146":63690,"_27538":63679,"_5":27878,"_19130":105710,"_26074":105711,"_2645":105712},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3146":63691,"_27538":63679,"_5":27878,"_19130":105714,"_26074":105715,"_2645":105716},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3146":63692,"_27538":63679,"_19130":105718,"_5":13154,"_26074":105675,"_2645":105719},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3146":63693,"_27538":63679,"_19130":105721,"_5":13154,"_26074":105675,"_2645":105722},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3146":63694,"_27538":63679,"_19130":105724,"_5":13154,"_26074":105679,"_2645":105725},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3146":63695,"_27538":63679,"_19130":105727,"_5":13154,"_26074":105679,"_2645":105728},[],"Fastlane instala o configura",{"_3146":63696,"_27538":63679,"_19130":105730,"_5":13154,"_26074":105679,"_2645":105731},[],"Tú sigues proporcionando",{"_3146":63697,"_27538":63679,"_19130":105733,"_5":13154,"_26074":105679,"_2645":105734},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3146":63698,"_27538":63679,"_19130":105736,"_5":13154,"_26074":105679,"_2645":105737},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3146":63699,"_27538":63679,"_19130":105739,"_5":13154,"_26074":105679,"_2645":105740},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3146":63700,"_27538":63679,"_19130":105742,"_5":13154,"_26074":105679,"_2645":105743},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3146":63701,"_27538":63679,"_19130":105745,"_5":13154,"_26074":105679,"_2645":105746},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3146":63702,"_27538":63679,"_19130":105748,"_5":13154,"_26074":105679,"_2645":105749},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3146":63703,"_27538":63679,"_19130":105751,"_5":13154,"_26074":105679,"_2645":105752},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3146":63704,"_27538":63679,"_19130":105754,"_5":13154,"_26074":105679,"_2645":105755},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3146":63705,"_27538":63679,"_19130":105757,"_5":13154,"_26074":105679,"_2645":105758},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3146":63706,"_27538":63679,"_19130":105760,"_5":13154,"_26074":105683,"_2645":105761},[],"Necesitas:",{"_3146":63707,"_27538":63679,"_19130":105763,"_5":13154,"_26074":105683,"_2645":105764},[],"un clúster Kubernetes existente",{"_3146":63708,"_27538":63679,"_19130":105766,"_5":13154,"_26074":105683,"_2645":105767},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3146":63709,"_27538":63679,"_19130":105769,"_5":13154,"_26074":105683,"_2645":45176},[],{"_3146":63710,"_27538":63679,"_19130":105771,"_5":13154,"_26074":105683,"_2645":21661},[],{"_3146":63711,"_27538":63679,"_19130":105773,"_5":13154,"_26074":105683,"_2645":105774},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3146":63712,"_27538":63679,"_19130":105776,"_5":13154,"_26074":105683,"_2645":105777},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3146":63713,"_27538":63679,"_19130":105779,"_5":13154,"_26074":105683,"_2645":105780},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3146":63714,"_27538":63679,"_19130":105782,"_5":13154,"_26074":105683,"_2645":105783},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3146":63715,"_27538":63679,"_19130":105785,"_5":13154,"_26074":105683,"_2645":105786},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3146":63716,"_27538":63679,"_19130":105788,"_5":13154,"_26074":105687,"_2645":105789},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3146":63717,"_27538":63679,"_19130":105791,"_5":13154,"_26074":105687,"_2645":105792},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3146":63718,"_27538":63679,"_19130":105794,"_5":13154,"_26074":105691,"_2645":105795},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3146":63719,"_27538":63679,"_19130":105797,"_5":13154,"_26074":105691,"_2645":105798},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3146":63720,"_27538":63679,"_19130":105800,"_5":13154,"_26074":105691,"_2645":105801},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3146":63721,"_27538":63679,"_19130":105803,"_5":13154,"_26074":105691,"_2645":105804},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3146":63722,"_27538":63679,"_19130":105806,"_5":13154,"_26074":105695,"_2645":105807},[],"Opción",{"_3146":63723,"_27538":63679,"_19130":105809,"_5":13154,"_26074":105695,"_2645":105810},[],"Valor predeterminado",{"_3146":63724,"_27538":63679,"_19130":105812,"_5":13154,"_26074":105695,"_2645":105813},[],"Propósito",{"_3146":63725,"_27538":63679,"_19130":105815,"_5":13154,"_26074":105695,"_2645":45223},[],{"_3146":63726,"_27538":63679,"_19130":105817,"_5":13154,"_26074":105695,"_2645":45226},[],{"_3146":63727,"_27538":63679,"_19130":105819,"_5":13154,"_26074":105695,"_2645":105820},[],"Muestra la ayuda",{"_3146":63728,"_27538":63679,"_19130":105822,"_5":13154,"_26074":105695,"_2645":45232},[],{"_3146":63729,"_27538":63679,"_19130":105824,"_5":13154,"_26074":105695,"_2645":105825},[],"contexto actual",{"_3146":63730,"_27538":63679,"_19130":105827,"_5":13154,"_26074":105695,"_2645":105828},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3146":63731,"_27538":63679,"_19130":105830,"_5":13154,"_26074":105695,"_2645":45241},[],{"_3146":63732,"_27538":63679,"_19130":105832,"_5":13154,"_26074":105695,"_2645":5893},[],{"_3146":63733,"_27538":63679,"_19130":105834,"_5":13154,"_26074":105695,"_2645":105835},[],"Omite prompts y genera credenciales para las dependencias",{"_3146":63734,"_27538":63679,"_19130":105837,"_5":13154,"_26074":105695,"_2645":45249},[],{"_3146":63735,"_27538":63679,"_19130":105839,"_5":13154,"_26074":105695,"_2645":45252},[],{"_3146":63736,"_27538":63679,"_19130":105841,"_5":13154,"_26074":105695,"_2645":105842},[],"Namespace de la instalación",{"_3146":63737,"_27538":63679,"_19130":105844,"_5":13154,"_26074":105695,"_2645":45258},[],{"_3146":63738,"_27538":63679,"_19130":105846,"_5":13154,"_26074":105695,"_2645":45261},[],{"_3146":63739,"_27538":63679,"_19130":105848,"_5":13154,"_26074":105695,"_2645":105849},[],"Dominio usado por la UI, OIDC y el certificado",{"_3146":63740,"_27538":63679,"_19130":105851,"_5":13154,"_26074":105695,"_2645":45267},[],{"_3146":63741,"_27538":63679,"_19130":105853,"_5":13154,"_26074":105695,"_2645":13756},[],{"_3146":63742,"_27538":63679,"_19130":105855,"_5":13154,"_26074":105695,"_2645":105856},[],"Versión del chart de Lamassu",{"_3146":63743,"_27538":63679,"_19130":105858,"_5":13154,"_26074":105695,"_2645":45275},[],{"_3146":63744,"_27538":63679,"_19130":105860,"_5":13154,"_26074":105695,"_2645":45278},[],{"_3146":63745,"_27538":63679,"_19130":105862,"_5":13154,"_26074":105695,"_2645":105863},[],"Puerto del listener HTTPS",{"_3146":63746,"_27538":63679,"_19130":105865,"_5":13154,"_26074":105695,"_2645":45284},[],{"_3146":63747,"_27538":63679,"_19130":105867,"_5":13154,"_26074":105695,"_2645":45287},[],{"_3146":63748,"_27538":63679,"_19130":105869,"_5":13154,"_26074":105695,"_2645":105870},[],"Puerto del listener HTTP",{"_3146":63749,"_27538":63679,"_19130":105872,"_5":13154,"_26074":105695,"_2645":45293},[],{"_3146":63750,"_27538":63679,"_19130":105874,"_5":13154,"_26074":105695,"_2645":45226},[],{"_3146":63751,"_27538":63679,"_19130":105876,"_5":13154,"_26074":105695,"_2645":105877},[],"Certificado PEM para TLS downstream",{"_3146":63752,"_27538":63679,"_19130":105879,"_5":13154,"_26074":105695,"_2645":45301},[],{"_3146":63753,"_27538":63679,"_19130":105881,"_5":13154,"_26074":105695,"_2645":45226},[],{"_3146":63754,"_27538":63679,"_19130":105883,"_5":13154,"_26074":105695,"_2645":105884},[],"Clave privada PEM para TLS downstream",{"_3146":63755,"_27538":63679,"_19130":105886,"_5":13154,"_26074":105695,"_2645":45309},[],{"_3146":63756,"_27538":63679,"_19130":105888,"_5":13154,"_26074":105695,"_2645":105889},[],"chart del repositorio",{"_3146":63757,"_27538":63679,"_19130":105891,"_5":13154,"_26074":105695,"_2645":105892},[],"Usa un chart local de Lamassu sin empaquetar",{"_3146":63758,"_27538":63679,"_19130":105894,"_5":13154,"_26074":105695,"_2645":45318},[],{"_3146":63759,"_27538":63679,"_19130":105896,"_5":13154,"_26074":105695,"_2645":105897},[],"detección automática",{"_3146":63760,"_27538":63679,"_19130":105899,"_5":13154,"_26074":105695,"_2645":105900},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3146":63761,"_27538":63679,"_19130":105902,"_5":13154,"_26074":105695,"_2645":45326},[],{"_3146":63762,"_27538":63679,"_19130":105904,"_5":13154,"_26074":105695,"_2645":5893},[],{"_3146":63763,"_27538":63679,"_19130":105906,"_5":13154,"_26074":105695,"_2645":105907},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3146":63764,"_27538":63679,"_19130":105909,"_5":13154,"_26074":105695,"_2645":45334},[],{"_3146":63765,"_27538":63679,"_19130":105911,"_5":13154,"_26074":105695,"_2645":5893},[],{"_3146":63766,"_27538":63679,"_19130":105913,"_5":13154,"_26074":105695,"_2645":105914},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3146":63767,"_27538":63679,"_19130":105916,"_5":13154,"_26074":105695,"_2645":45342},[],{"_3146":63768,"_27538":63679,"_19130":105918,"_5":13154,"_26074":105695,"_2645":5893},[],{"_3146":63769,"_27538":63679,"_19130":105920,"_5":13154,"_26074":105695,"_2645":105921},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3146":63770,"_27538":63679,"_19130":105923,"_5":13154,"_26074":105695,"_2645":45350},[],{"_3146":63771,"_27538":63679,"_19130":105925,"_5":13154,"_26074":105695,"_2645":5893},[],{"_3146":63772,"_27538":63679,"_19130":105927,"_5":13154,"_26074":105695,"_2645":105928},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3146":63773,"_27538":63679,"_19130":105930,"_5":13154,"_26074":105695,"_2645":45358},[],{"_3146":63774,"_27538":63679,"_19130":105932,"_5":13154,"_26074":105695,"_2645":45361},[],{"_3146":63775,"_27538":63679,"_19130":105934,"_5":13154,"_26074":105695,"_2645":105935},[],"Usa otro chart local de SoftHSM",{"_3146":63776,"_27538":63679,"_19130":105937,"_5":13154,"_26074":105695,"_2645":105938},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3146":63777,"_27538":63679,"_19130":105940,"_5":13154,"_26074":105699,"_2645":105941},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3146":63778,"_27538":63679,"_19130":105943,"_5":13154,"_26074":105699,"_2645":105944},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3146":63779,"_27538":63679,"_19130":105946,"_5":13154,"_26074":105699,"_2645":105947},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3146":63780,"_27538":63679,"_19130":105949,"_5":13154,"_26074":105699,"_2645":105950},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3146":63781,"_27538":63679,"_19130":105952,"_5":13154,"_26074":105699,"_2645":105953},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3146":63782,"_27538":63679,"_19130":105955,"_5":13154,"_26074":105699,"_2645":105956},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3146":63783,"_27538":63679,"_19130":105958,"_5":13154,"_26074":105703,"_2645":45388},[],{"_3146":63784,"_27538":63679,"_19130":105960,"_5":13154,"_26074":105703,"_2645":105961},[],"valida las herramientas locales y el clúster seleccionado",{"_3146":63785,"_27538":63679,"_19130":105963,"_5":13154,"_26074":105703,"_2645":105964},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3146":63786,"_27538":63679,"_19130":105966,"_5":13154,"_26074":105703,"_2645":105967},[],"crea el namespace",{"_3146":63787,"_27538":63679,"_19130":105969,"_5":13154,"_26074":105703,"_2645":105970},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3146":63788,"_27538":63679,"_19130":105972,"_5":13154,"_26074":105703,"_2645":105973},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3146":63789,"_27538":63679,"_19130":105975,"_5":13154,"_26074":105703,"_2645":105976},[],"instala RabbitMQ",{"_3146":63790,"_27538":63679,"_19130":105978,"_5":13154,"_26074":105703,"_2645":105979},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3146":63791,"_27538":63679,"_19130":105981,"_5":13154,"_26074":105703,"_2645":105982},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3146":63792,"_27538":63679,"_19130":105984,"_5":13154,"_26074":105703,"_2645":105985},[],"carga datos de ejemplo opcionalmente",{"_3146":63793,"_27538":63679,"_19130":105987,"_5":13154,"_26074":105703,"_2645":105988},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3146":63794,"_27538":63679,"_19130":105990,"_5":13154,"_26074":105707,"_2645":105991},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3146":63795,"_27538":63679,"_19130":105993,"_5":13154,"_26074":105707,"_2645":105994},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3146":63796,"_27538":63679,"_19130":105996,"_5":13154,"_26074":105711,"_2645":105997},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3146":63797,"_27538":63679,"_19130":105999,"_5":13154,"_26074":105711,"_2645":106000},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3146":63798,"_27538":63679,"_19130":106002,"_5":13154,"_26074":105711,"_2645":106003},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3146":63799,"_27538":63679,"_19130":106005,"_5":13154,"_26074":105715,"_2645":106006},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3146":63800,"_27538":63800,"_5":13480,"_2645":106008,"_27881":106009,"_19130":106010,"_26074":63800},"Instala con Helm",[44830,105434,105668],[],{"_3146":63801,"_27538":63800,"_19130":106012,"_5":13154,"_26074":63800,"_2645":106013},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3146":63802,"_27538":63800,"_5":27878,"_19130":106015,"_26074":106016,"_2645":106017},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3146":63803,"_27538":63800,"_5":27878,"_19130":106019,"_26074":106020,"_2645":105684},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3146":63804,"_27538":63800,"_5":27878,"_19130":106022,"_26074":106023,"_2645":106024},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3146":63805,"_27538":63800,"_5":27878,"_19130":106026,"_26074":106027,"_2645":106028},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3146":63806,"_27538":63800,"_5":27878,"_19130":106030,"_26074":106031,"_2645":106032},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3146":63807,"_27538":63800,"_5":27878,"_19130":106034,"_26074":106035,"_2645":106036},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3146":63808,"_27538":63800,"_5":27878,"_19130":106038,"_26074":106039,"_2645":106040},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3146":63809,"_27538":63800,"_5":27878,"_19130":106042,"_26074":106043,"_2645":106044},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3146":63810,"_27538":63800,"_5":27878,"_19130":106046,"_26074":106047,"_2645":106048},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3146":63811,"_27538":63800,"_19130":106050,"_5":13154,"_26074":106016,"_2645":106051},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3146":63812,"_27538":63800,"_19130":106053,"_5":13154,"_26074":106020,"_2645":106054},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3146":63813,"_27538":63800,"_19130":106056,"_5":13154,"_26074":106020,"_2645":106057},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3146":63814,"_27538":63800,"_19130":106059,"_5":13154,"_26074":106020,"_2645":106060},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3146":63815,"_27538":63800,"_19130":106062,"_5":13154,"_26074":106020,"_2645":106063},[],"un broker RabbitMQ accesible y sus credenciales",{"_3146":63816,"_27538":63800,"_19130":106065,"_5":13154,"_26074":106020,"_2645":106066},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3146":63817,"_27538":63800,"_19130":106068,"_5":13154,"_26074":106020,"_2645":106069},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3146":63818,"_27538":63800,"_19130":106071,"_5":13154,"_26074":106020,"_2645":106072},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3146":63819,"_27538":63800,"_19130":106074,"_5":13154,"_26074":106020,"_2645":106075},[],"una StorageClass y un diseño de tráfico externo",{"_3146":63820,"_27538":63800,"_19130":106077,"_5":13154,"_26074":106020,"_2645":106078},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3146":63821,"_27538":63800,"_19130":106080,"_5":13154,"_26074":106020,"_2645":106081},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3146":63822,"_27538":63800,"_19130":106083,"_5":13154,"_26074":106020,"_2645":106084},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3146":63823,"_27538":63800,"_19130":106086,"_5":13154,"_26074":106023,"_2645":106087},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3146":63824,"_27538":63800,"_19130":106089,"_5":13154,"_26074":106023,"_2645":106090},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3146":63825,"_27538":63800,"_19130":106092,"_5":13154,"_26074":106023,"_2645":106093},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_3146":63826,"_27538":63800,"_19130":106095,"_5":13154,"_26074":106027,"_2645":106096},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3146":63827,"_27538":63800,"_19130":106098,"_5":13154,"_26074":106027,"_2645":106099},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3146":63828,"_27538":63800,"_19130":106101,"_5":13154,"_26074":106027,"_2645":106102},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3146":63829,"_27538":63800,"_19130":106104,"_5":13154,"_26074":106031,"_2645":106105},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_3146":63830,"_27538":63800,"_19130":106107,"_5":13154,"_26074":106035,"_2645":106108},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3146":63831,"_27538":63800,"_19130":106110,"_5":13154,"_26074":106035,"_2645":106111},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3146":63832,"_27538":63800,"_19130":106113,"_5":13154,"_26074":106035,"_2645":106114},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3146":63833,"_27538":63800,"_19130":106116,"_5":13154,"_26074":106035,"_2645":106117},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3146":63834,"_27538":63800,"_19130":106119,"_5":13154,"_26074":106039,"_2645":106120},[],"Para instalar un checkout local:",{"_3146":63835,"_27538":63800,"_19130":106122,"_5":13154,"_26074":106043,"_2645":106123},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3146":63836,"_27538":63800,"_19130":106125,"_5":13154,"_26074":106043,"_2645":106126},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3146":63837,"_27538":63800,"_19130":106128,"_5":13154,"_26074":106047,"_2645":106129},[],"Antes de pasar a producción, revisa:",{"_3146":63838,"_27538":63800,"_19130":106131,"_5":13154,"_26074":106047,"_2645":106132},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3146":63839,"_27538":63800,"_19130":106134,"_5":13154,"_26074":106047,"_2645":106135},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3146":63840,"_27538":63800,"_19130":106137,"_5":13154,"_26074":106047,"_2645":106138},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3146":63841,"_27538":63800,"_19130":106140,"_5":13154,"_26074":106047,"_2645":106141},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3146":63842,"_27538":63800,"_19130":106143,"_5":13154,"_26074":106047,"_2645":106144},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3146":63843,"_27538":63800,"_19130":106146,"_5":13154,"_26074":106047,"_2645":106147},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3146":63844,"_27538":63800,"_19130":106149,"_5":13154,"_26074":106047,"_2645":106150},[],"SMTP, observabilidad y entrega de alertas",{"_3146":63845,"_27538":63800,"_19130":106152,"_5":13154,"_26074":106047,"_2645":106153},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3146":63846,"_27538":63800,"_19130":106155,"_5":13154,"_26074":106047,"_2645":106156},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3146":63847,"_27538":63847,"_5":13480,"_2645":106158,"_27881":106159,"_19130":106160,"_26074":63847},"Expón el Gateway",[44830,105434,105668],[],{"_3146":63848,"_27538":63847,"_19130":106162,"_5":13154,"_26074":63847,"_2645":106163},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3146":63849,"_27538":63847,"_5":27878,"_19130":106165,"_26074":106166,"_2645":106167},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3146":63850,"_27538":63847,"_5":27878,"_19130":106169,"_26074":106170,"_2645":106171},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3146":63851,"_27538":63847,"_5":27878,"_19130":106173,"_26074":106174,"_2645":106175},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3146":63852,"_27538":63847,"_5":27878,"_19130":106177,"_26074":106178,"_2645":45609},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#k3s",{"_3146":63853,"_27538":63847,"_5":27878,"_19130":106180,"_26074":106181,"_2645":106182},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3146":63854,"_27538":63847,"_5":27878,"_19130":106184,"_26074":106185,"_2645":106186},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3146":63855,"_27538":63847,"_5":27878,"_19130":106188,"_26074":106189,"_2645":106190},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3146":63856,"_27538":63847,"_5":27878,"_19130":106192,"_26074":106193,"_2645":106194},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3146":63857,"_27538":63847,"_5":27878,"_19130":106196,"_26074":106197,"_2645":106198},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3146":63858,"_27538":63847,"_19130":106200,"_5":13154,"_26074":106166,"_2645":106201},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3146":63859,"_27538":63847,"_19130":106203,"_5":13154,"_26074":106166,"_2645":106204},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3146":63860,"_27538":63847,"_19130":106206,"_5":13154,"_26074":106170,"_2645":106207},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3146":63861,"_27538":63847,"_19130":106209,"_5":13154,"_26074":106170,"_2645":106210},[],"Defínelo únicamente cuando:",{"_3146":63862,"_27538":63847,"_19130":106212,"_5":13154,"_26074":106170,"_2645":106213},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3146":63863,"_27538":63847,"_19130":106215,"_5":13154,"_26074":106170,"_2645":106216},[],"esa dirección está asignada a este Gateway",{"_3146":63864,"_27538":63847,"_19130":106218,"_5":13154,"_26074":106170,"_2645":106219},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3146":63865,"_27538":63847,"_19130":106221,"_5":13154,"_26074":106170,"_2645":106222},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3146":63866,"_27538":63847,"_19130":106224,"_5":13154,"_26074":106170,"_2645":106225},[],"No confundas estos valores:",{"_3146":63867,"_27538":63847,"_19130":106227,"_5":13154,"_26074":106170,"_2645":106228},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3146":63868,"_27538":63847,"_19130":106230,"_5":13154,"_26074":106170,"_2645":106231},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3146":63869,"_27538":63847,"_19130":106233,"_5":13154,"_26074":106170,"_2645":106234},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3146":63870,"_27538":63847,"_19130":106236,"_5":13154,"_26074":106174,"_2645":106237},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3146":63871,"_27538":63847,"_19130":106239,"_5":13154,"_26074":106174,"_2645":106240},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3146":63872,"_27538":63847,"_19130":106242,"_5":13154,"_26074":106178,"_2645":106243},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3146":63873,"_27538":63847,"_19130":106245,"_5":13154,"_26074":106178,"_2645":106246},[],"Para el diseño recomendado:",{"_3146":63874,"_27538":63847,"_19130":106248,"_5":13154,"_26074":106178,"_2645":106249},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3146":63875,"_27538":63847,"_19130":106251,"_5":13154,"_26074":106178,"_2645":106252},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3146":63876,"_27538":63847,"_19130":106254,"_5":13154,"_26074":106178,"_2645":106255},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3146":63877,"_27538":63847,"_19130":106257,"_5":13154,"_26074":106178,"_2645":106258},[],"Apunta DNS a la dirección accesible de la VM.",{"_3146":63878,"_27538":63847,"_19130":106260,"_5":13154,"_26074":106178,"_2645":106261},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3146":63879,"_27538":63847,"_19130":106263,"_5":13154,"_26074":106181,"_2645":106264},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3146":63880,"_27538":63847,"_19130":106266,"_5":13154,"_26074":106185,"_2645":106267},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3146":63881,"_27538":63847,"_19130":106269,"_5":13154,"_26074":106185,"_2645":106270},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3146":63882,"_27538":63847,"_19130":106272,"_5":13154,"_26074":106189,"_2645":106273},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3146":63883,"_27538":63847,"_19130":106275,"_5":13154,"_26074":106189,"_2645":106276},[],"Requisito",{"_3146":63884,"_27538":63847,"_19130":106278,"_5":13154,"_26074":106189,"_2645":106279},[],"Diseño recomendado",{"_3146":63885,"_27538":63847,"_19130":106281,"_5":13154,"_26074":106189,"_2645":106282},[],"Consecuencia",{"_3146":63886,"_27538":63847,"_19130":106284,"_5":13154,"_26074":106189,"_2645":106285},[],"Varias URL o servicios de Lamassu",{"_3146":63887,"_27538":63847,"_19130":106287,"_5":13154,"_26074":106189,"_2645":106288},[],"Un Gateway con varias rutas",{"_3146":63888,"_27538":63847,"_19130":106290,"_5":13154,"_26074":106189,"_2645":106291},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3146":63889,"_27538":63847,"_19130":106293,"_5":13154,"_26074":106189,"_2645":106294},[],"Gateways independientes e IP externas distintas",{"_3146":63890,"_27538":63847,"_19130":106296,"_5":13154,"_26074":106189,"_2645":106297},[],"Una VIP por Gateway",{"_3146":63891,"_27538":63847,"_19130":106299,"_5":13154,"_26074":106189,"_2645":106300},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3146":63892,"_27538":63847,"_19130":106302,"_5":13154,"_26074":106189,"_2645":106303},[],"Gateways independientes, un nodo y una IP",{"_3146":63893,"_27538":63847,"_19130":106305,"_5":13154,"_26074":106189,"_2645":106306},[],"Puertos externos diferentes",{"_3146":63894,"_27538":63847,"_19130":106308,"_5":13154,"_26074":106189,"_2645":106309},[],"Los clientes deben indicar puertos no estándar",{"_3146":63895,"_27538":63847,"_19130":106311,"_5":13154,"_26074":106189,"_2645":106312},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3146":63896,"_27538":63847,"_19130":106314,"_5":13154,"_26074":106189,"_2645":106315},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3146":63897,"_27538":63847,"_19130":106317,"_5":13154,"_26074":106189,"_2645":106318},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3146":63898,"_27538":63847,"_19130":106320,"_5":13154,"_26074":106189,"_2645":106321},[],"Recursos Gateway separados pero proxy compartido",{"_3146":63899,"_27538":63847,"_19130":106323,"_5":13154,"_26074":106189,"_2645":106324},[],"Modo merged Gateway de Envoy",{"_3146":63900,"_27538":63847,"_19130":106326,"_5":13154,"_26074":106189,"_2645":106327},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3146":63901,"_27538":63847,"_19130":106329,"_5":13154,"_26074":106189,"_2645":106330},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3146":63902,"_27538":63847,"_19130":106332,"_5":13154,"_26074":106189,"_2645":106333},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3146":63903,"_27538":63847,"_19130":106335,"_5":13154,"_26074":106189,"_2645":106336},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3146":63904,"_27538":63847,"_19130":106338,"_5":13154,"_26074":106189,"_2645":106339},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3146":63905,"_27538":63847,"_19130":106341,"_5":13154,"_26074":106193,"_2645":106342},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3146":63906,"_27538":63847,"_19130":106344,"_5":13154,"_26074":106193,"_2645":106345},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3146":63907,"_27538":63847,"_19130":106347,"_5":13154,"_26074":106193,"_2645":106348},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3146":63908,"_27538":63847,"_19130":106350,"_5":13154,"_26074":106193,"_2645":106351},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3146":63909,"_27538":63847,"_19130":106353,"_5":13154,"_26074":106193,"_2645":106354},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3146":63910,"_27538":63847,"_19130":106356,"_5":13154,"_26074":106197,"_2645":106357},[],"Comprueba, en orden:",{"_3146":63911,"_27538":63847,"_19130":106359,"_5":13154,"_26074":106197,"_2645":106360},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3146":63912,"_27538":63847,"_19130":106362,"_5":13154,"_26074":106197,"_2645":106363},[],"Su estado contiene la dirección esperada.",{"_3146":63913,"_27538":63847,"_19130":106365,"_5":13154,"_26074":106197,"_2645":106366},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3146":63914,"_27538":63847,"_19130":106368,"_5":13154,"_26074":106197,"_2645":106369},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3146":63915,"_27538":63847,"_19130":106371,"_5":13154,"_26074":106197,"_2645":106372},[],"DNS resuelve al endpoint accesible externamente.",{"_3146":63916,"_27538":63847,"_19130":106374,"_5":13154,"_26074":106197,"_2645":106375},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3146":63917,"_27538":63847,"_19130":106377,"_5":13154,"_26074":106197,"_2645":106378},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3146":63918,"_27538":63918,"_5":13480,"_2645":44937,"_27881":106380,"_19130":106381,"_26074":63918},[44830,105434,105668],[],{"_3146":63919,"_27538":63918,"_19130":106383,"_5":13154,"_26074":63918,"_2645":106384},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3146":63920,"_27538":63918,"_5":27878,"_19130":106386,"_26074":106387,"_2645":106388},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3146":63921,"_27538":63918,"_5":27878,"_19130":106390,"_26074":106391,"_2645":106392},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3146":63922,"_27538":63918,"_5":27878,"_19130":106394,"_26074":106395,"_2645":106396},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3146":63923,"_27538":63918,"_5":27878,"_19130":106398,"_26074":106399,"_2645":106400},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3146":63924,"_27538":63918,"_5":27878,"_19130":106402,"_26074":106403,"_2645":106404},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3146":63925,"_27538":63918,"_5":27878,"_19130":106406,"_26074":106407,"_2645":106408},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3146":63926,"_27538":63918,"_19130":106410,"_5":13154,"_26074":106387,"_2645":106411},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3146":63927,"_27538":63918,"_19130":106413,"_5":13154,"_26074":106391,"_2645":106414},[],"Flujo",{"_3146":63928,"_27538":63918,"_19130":106416,"_5":13154,"_26074":106391,"_2645":106417},[],"Úsalo para",{"_3146":63929,"_27538":63918,"_19130":106419,"_5":13154,"_26074":106391,"_2645":106420},[],"Qué instala",{"_3146":63930,"_27538":63918,"_19130":106422,"_5":13154,"_26074":106391,"_2645":45854},[],{"_3146":63931,"_27538":63918,"_19130":106424,"_5":13154,"_26074":106391,"_2645":106425},[],"Producción y entornos controlados",{"_3146":63932,"_27538":63918,"_19130":106427,"_5":13154,"_26074":106391,"_2645":106428},[],"Servicios de Lamassu y recursos de Gateway API",{"_3146":63933,"_27538":63918,"_19130":106430,"_5":13154,"_26074":106391,"_2645":45074},[],{"_3146":63934,"_27538":63918,"_19130":106432,"_5":13154,"_26074":106391,"_2645":106433},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3146":63935,"_27538":63918,"_19130":106435,"_5":13154,"_26074":106391,"_2645":106436},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3146":63936,"_27538":63918,"_19130":106438,"_5":13154,"_26074":106395,"_2645":106439},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3146":63937,"_27538":63918,"_19130":106441,"_5":13154,"_26074":106395,"_2645":106442},[],"Área",{"_3146":63938,"_27538":63918,"_19130":106444,"_5":13154,"_26074":106395,"_2645":106445},[],"El chart de Lamassu proporciona",{"_3146":63939,"_27538":63918,"_19130":106447,"_5":13154,"_26074":106395,"_2645":106448},[],"Tú proporcionas",{"_3146":63940,"_27538":63918,"_19130":106450,"_5":13154,"_26074":106395,"_2645":106451},[],"Aplicaciones Lamassu",{"_3146":63941,"_27538":63918,"_19130":106453,"_5":13154,"_26074":106395,"_2645":106454},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3146":63942,"_27538":63918,"_19130":106456,"_5":13154,"_26074":106395,"_2645":106457},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3146":63943,"_27538":63918,"_19130":106459,"_5":13154,"_26074":106395,"_2645":106460},[],"Datos PostgreSQL",{"_3146":63944,"_27538":63918,"_19130":106462,"_5":13154,"_26074":106395,"_2645":106463},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3146":63945,"_27538":63918,"_19130":106465,"_5":13154,"_26074":106395,"_2645":106466},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3146":63946,"_27538":63918,"_19130":106468,"_5":13154,"_26074":106395,"_2645":106469},[],"Mensajería",{"_3146":63947,"_27538":63918,"_19130":106471,"_5":13154,"_26074":106395,"_2645":106472},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3146":63948,"_27538":63918,"_19130":106474,"_5":13154,"_26074":106395,"_2645":106475},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3146":63949,"_27538":63918,"_19130":106477,"_5":13154,"_26074":106395,"_2645":106478},[],"Identidad",{"_3146":63950,"_27538":63918,"_19130":106480,"_5":13154,"_26074":106395,"_2645":106481},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3146":63951,"_27538":63918,"_19130":106483,"_5":13154,"_26074":106395,"_2645":106484},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3146":63952,"_27538":63918,"_19130":106486,"_5":13154,"_26074":106395,"_2645":106487},[],"Enrutamiento externo",{"_3146":63953,"_27538":63918,"_19130":106489,"_5":13154,"_26074":106395,"_2645":106490},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3146":63954,"_27538":63918,"_19130":106492,"_5":13154,"_26074":106395,"_2645":106493},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3146":63955,"_27538":63918,"_19130":106495,"_5":13154,"_26074":106395,"_2645":45928},[],{"_3146":63956,"_27538":63918,"_19130":106497,"_5":13154,"_26074":106395,"_2645":106498},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_3146":63957,"_27538":63918,"_19130":106500,"_5":13154,"_26074":106395,"_2645":106501},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3146":63958,"_27538":63918,"_19130":106503,"_5":13154,"_26074":106395,"_2645":106504},[],"Datos persistentes de la aplicación",{"_3146":63959,"_27538":63918,"_19130":106506,"_5":13154,"_26074":106395,"_2645":106507},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3146":63960,"_27538":63918,"_19130":106509,"_5":13154,"_26074":106395,"_2645":106510},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3146":63961,"_27538":63918,"_19130":106512,"_5":13154,"_26074":106395,"_2645":106513},[],"Integraciones opcionales",{"_3146":63962,"_27538":63918,"_19130":106515,"_5":13154,"_26074":106395,"_2645":106516},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3146":63963,"_27538":63918,"_19130":106518,"_5":13154,"_26074":106395,"_2645":106519},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3146":63964,"_27538":63918,"_19130":106521,"_5":13154,"_26074":106395,"_2645":106522},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3146":63965,"_27538":63918,"_19130":106524,"_5":13154,"_26074":106395,"_2645":106525},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3146":63966,"_27538":63918,"_19130":106527,"_5":13154,"_26074":106399,"_2645":106528},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3146":63967,"_27538":63918,"_19130":106530,"_5":13154,"_26074":106399,"_2645":106531},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3146":63968,"_27538":63918,"_19130":106533,"_5":13154,"_26074":106403,"_2645":106534},[],"Kubernetes 1.24 o posterior",{"_3146":63969,"_27538":63918,"_19130":106536,"_5":13154,"_26074":106403,"_2645":106537},[],"Helm 3.2 o posterior",{"_3146":63970,"_27538":63918,"_19130":106539,"_5":13154,"_26074":106403,"_2645":106540},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3146":63971,"_27538":63918,"_19130":106542,"_5":13154,"_26074":106403,"_2645":106543},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_3146":63972,"_27538":63918,"_19130":106545,"_5":13154,"_26074":106403,"_2645":106546},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3146":63973,"_27538":63918,"_19130":106548,"_5":13154,"_26074":106403,"_2645":106549},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3146":63974,"_27538":63918,"_19130":106551,"_5":13154,"_26074":106403,"_2645":106552},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3146":63975,"_27538":63918,"_19130":106554,"_5":13154,"_26074":106407,"_2645":106555},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3146":63976,"_27538":63918,"_19130":106557,"_5":13154,"_26074":106407,"_2645":106558},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3146":63977,"_27538":63918,"_19130":106560,"_5":13154,"_26074":106407,"_2645":106561},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3146":63978,"_27538":63918,"_19130":106563,"_5":13154,"_26074":106407,"_2645":106564},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3146":63979,"_27538":63979,"_5":13480,"_2645":106566,"_27881":106567,"_19130":106569,"_26074":63979},"Resolución de problemas de despliegue",[44830,105434,106568],"Operación",[],{"_3146":63980,"_27538":63979,"_19130":106571,"_5":13154,"_26074":63979,"_2645":106572},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3146":63981,"_27538":63979,"_5":27878,"_19130":106574,"_26074":106575,"_2645":106576},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3146":63982,"_27538":63979,"_5":27878,"_19130":106578,"_26074":106579,"_2645":106580},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3146":63983,"_27538":63979,"_5":27878,"_19130":106582,"_26074":106583,"_2645":106584},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3146":63984,"_27538":63979,"_5":27878,"_19130":106586,"_26074":106587,"_2645":106588},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3146":63985,"_27538":63979,"_5":27878,"_19130":106590,"_26074":106591,"_2645":106592},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3146":63986,"_27538":63979,"_5":27878,"_19130":106594,"_26074":106595,"_2645":106596},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3146":63987,"_27538":63979,"_5":27878,"_19130":106598,"_26074":106599,"_2645":106600},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3146":63988,"_27538":63979,"_5":27878,"_19130":106602,"_26074":106603,"_2645":106604},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3146":63989,"_27538":63979,"_5":27878,"_19130":106606,"_26074":106607,"_2645":106608},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3146":63990,"_27538":63979,"_5":27878,"_19130":106610,"_26074":106611,"_2645":106612},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3146":63991,"_27538":63979,"_5":27878,"_19130":106614,"_26074":106615,"_2645":106616},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3146":63992,"_27538":63979,"_5":27878,"_19130":106618,"_26074":106619,"_2645":106620},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3146":63993,"_27538":63979,"_19130":106622,"_5":13154,"_26074":63979,"_2645":106623},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3146":63994,"_27538":63979,"_19130":106625,"_5":13154,"_26074":106579,"_2645":106626},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3146":63995,"_27538":63979,"_19130":106628,"_5":13154,"_26074":106583,"_2645":106629},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3146":63996,"_27538":63979,"_19130":106631,"_5":13154,"_26074":106587,"_2645":106632},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3146":63997,"_27538":63979,"_19130":106634,"_5":13154,"_26074":106591,"_2645":106635},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3146":63998,"_27538":63979,"_19130":106637,"_5":13154,"_26074":106595,"_2645":106638},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3146":63999,"_27538":63979,"_19130":106640,"_5":13154,"_26074":106599,"_2645":106641},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3146":64000,"_27538":63979,"_19130":106643,"_5":13154,"_26074":106599,"_2645":106644},[],"Ejecuta también la prueba de conectividad del chart:",{"_3146":64001,"_27538":63979,"_19130":106646,"_5":13154,"_26074":106599,"_2645":106647},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3146":64002,"_27538":63979,"_19130":106649,"_5":13154,"_26074":106599,"_2645":106650},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3146":64003,"_27538":63979,"_19130":106652,"_5":13154,"_26074":106603,"_2645":106653},[],"Si recibes un 401:",{"_3146":64004,"_27538":63979,"_19130":106655,"_5":13154,"_26074":106603,"_2645":106656},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3146":64005,"_27538":63979,"_19130":106658,"_5":13154,"_26074":106603,"_2645":106659},[],"verifica emisor, audiencia y expiración del token;",{"_3146":64006,"_27538":63979,"_19130":106661,"_5":13154,"_26074":106603,"_2645":106662},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3146":64007,"_27538":63979,"_19130":106664,"_5":13154,"_26074":106603,"_2645":106665},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3146":64008,"_27538":63979,"_19130":106667,"_5":13154,"_26074":106603,"_2645":106668},[],"Si el login termina pero las APIs devuelven 403:",{"_3146":64009,"_27538":63979,"_19130":106670,"_5":13154,"_26074":106603,"_2645":106671},[],"inspecciona los claims reales del token;",{"_3146":64010,"_27538":63979,"_19130":106673,"_5":13154,"_26074":106603,"_2645":106674},[],"confirma que coinciden con un principal activo;",{"_3146":64011,"_27538":63979,"_19130":106676,"_5":13154,"_26074":106603,"_2645":106677},[],"revisa las políticas concedidas al principal;",{"_3146":64012,"_27538":63979,"_19130":106679,"_5":13154,"_26074":106603,"_2645":106680},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3146":64013,"_27538":63979,"_19130":106682,"_5":13154,"_26074":106603,"_2645":106683},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3146":64014,"_27538":63979,"_19130":106685,"_5":13154,"_26074":106607,"_2645":106686},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3146":64015,"_27538":63979,"_19130":106688,"_5":13154,"_26074":106607,"_2645":106689},[],"Localiza el pod y Service de authz.",{"_3146":64016,"_27538":63979,"_19130":106691,"_5":13154,"_26074":106607,"_2645":106692},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3146":64017,"_27538":63979,"_19130":106694,"_5":13154,"_26074":106607,"_2645":106695},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3146":64018,"_27538":63979,"_19130":106697,"_5":13154,"_26074":106607,"_2645":106698},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3146":64019,"_27538":63979,"_19130":106700,"_5":13154,"_26074":106607,"_2645":106701},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3146":64020,"_27538":63979,"_19130":106703,"_5":13154,"_26074":106611,"_2645":106704},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3146":64021,"_27538":63979,"_19130":106706,"_5":13154,"_26074":106611,"_2645":106707},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3146":64022,"_27538":63979,"_19130":106709,"_5":13154,"_26074":106611,"_2645":106710},[],"volumen persistente sin enlazar;",{"_3146":64023,"_27538":63979,"_19130":106712,"_5":13154,"_26074":106611,"_2645":106713},[],"imagen inaccesible o política de pull incorrecta;",{"_3146":64024,"_27538":63979,"_19130":106715,"_5":13154,"_26074":106611,"_2645":106716},[],"configuración inválida del motor criptográfico;",{"_3146":64025,"_27538":63979,"_19130":106718,"_5":13154,"_26074":106611,"_2645":106719},[],"límites de CPU o memoria demasiado bajos;",{"_3146":64026,"_27538":63979,"_19130":106721,"_5":13154,"_26074":106611,"_2645":106722},[],"migración previa incompleta.",{"_3146":64027,"_27538":63979,"_19130":106724,"_5":13154,"_26074":106611,"_2645":106725},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3146":64028,"_27538":63979,"_19130":106727,"_5":13154,"_26074":106611,"_2645":106728},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3146":64029,"_27538":63979,"_19130":106730,"_5":13154,"_26074":106615,"_2645":106731},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3146":64030,"_27538":63979,"_19130":106733,"_5":13154,"_26074":106615,"_2645":106734},[],"verifica que esté habilitado en el servicio emisor;",{"_3146":64031,"_27538":63979,"_19130":106736,"_5":13154,"_26074":106615,"_2645":106737},[],"comprueba conectividad y credenciales AMQP;",{"_3146":64032,"_27538":63979,"_19130":106739,"_5":13154,"_26074":106615,"_2645":106740},[],"revisa exchange, routing key, colas y consumidores;",{"_3146":64033,"_27538":63979,"_19130":106742,"_5":13154,"_26074":106615,"_2645":106743},[],"inspecciona dead-letter queues;",{"_3146":64034,"_27538":63979,"_19130":106745,"_5":13154,"_26074":106615,"_2645":106746},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3146":64035,"_27538":63979,"_19130":106748,"_5":13154,"_26074":106615,"_2645":106749},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3146":64036,"_27538":63979,"_19130":106751,"_5":13154,"_26074":106619,"_2645":106752},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3146":64037,"_27538":63979,"_19130":106754,"_5":13154,"_26074":106619,"_2645":106755},[],"Antes de cerrar una incidencia, guarda:",{"_3146":64038,"_27538":63979,"_19130":106757,"_5":13154,"_26074":106619,"_2645":106758},[],"causa confirmada;",{"_3146":64039,"_27538":63979,"_19130":106760,"_5":13154,"_26074":106619,"_2645":106761},[],"alcance temporal y recursos afectados;",{"_3146":64040,"_27538":63979,"_19130":106763,"_5":13154,"_26074":106619,"_2645":106764},[],"comandos o consultas utilizados;",{"_3146":64041,"_27538":63979,"_19130":106766,"_5":13154,"_26074":106619,"_2645":106767},[],"cambio aplicado y forma de revertirlo;",{"_3146":64042,"_27538":63979,"_19130":106769,"_5":13154,"_26074":106619,"_2645":106770},[],"validación desde un consumidor;",{"_3146":64043,"_27538":63979,"_19130":106772,"_5":13154,"_26074":106619,"_2645":106773},[],"acción preventiva y propietario.",{"_3146":64044,"_27538":64044,"_5":13480,"_2645":106775,"_27881":106776,"_19130":106779,"_26074":64044},"Control de acceso",[44830,106777,106778],"Plataforma","Administración",[],{"_3146":64045,"_27538":64044,"_19130":106781,"_5":13154,"_26074":64044,"_2645":106782},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3146":64046,"_27538":64044,"_5":27878,"_19130":106784,"_26074":106785,"_2645":106786},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3146":64047,"_27538":64044,"_5":27878,"_19130":106788,"_26074":106789,"_2645":106790},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3146":64048,"_27538":64044,"_5":27878,"_19130":106792,"_26074":106793,"_2645":106794},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3146":64049,"_27538":64044,"_5":27878,"_19130":106796,"_26074":106797,"_2645":106798},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3146":64050,"_27538":64044,"_5":27878,"_19130":106800,"_26074":106801,"_2645":106802},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3146":64051,"_27538":64044,"_5":27878,"_19130":106804,"_26074":106805,"_2645":106806},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3146":64052,"_27538":64044,"_5":27878,"_19130":106808,"_26074":106809,"_2645":106810},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3146":64053,"_27538":64044,"_5":27878,"_19130":106812,"_26074":106813,"_2645":106814},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3146":64054,"_27538":64044,"_5":27878,"_19130":106816,"_26074":106817,"_2645":106818},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3146":64055,"_27538":64044,"_5":27878,"_19130":106820,"_26074":106821,"_2645":106822},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3146":64056,"_27538":64044,"_5":27878,"_19130":106824,"_26074":106825,"_2645":106826},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3146":64057,"_27538":64044,"_5":27878,"_19130":106828,"_26074":106829,"_2645":106830},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3146":64058,"_27538":64044,"_5":27878,"_19130":106832,"_26074":106833,"_2645":106834},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3146":64059,"_27538":64044,"_5":27878,"_19130":106836,"_26074":106837,"_2645":106838},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3146":64060,"_27538":64044,"_5":27878,"_19130":106840,"_26074":106841,"_2645":106842},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3146":64061,"_27538":64044,"_5":27878,"_19130":106844,"_26074":106845,"_2645":106036},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3146":64062,"_27538":64044,"_5":27878,"_19130":106847,"_26074":106848,"_2645":106849},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3146":64063,"_27538":64044,"_5":27878,"_19130":106851,"_26074":106852,"_2645":106853},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3146":64064,"_27538":64044,"_5":27878,"_19130":106855,"_26074":106856,"_2645":106857},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3146":64065,"_27538":64044,"_5":27878,"_19130":106859,"_26074":106860,"_2645":106861},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3146":64066,"_27538":64044,"_5":27878,"_19130":106863,"_26074":106864,"_2645":106865},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3146":64067,"_27538":64044,"_5":27878,"_19130":106867,"_26074":106868,"_2645":106869},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3146":64068,"_27538":64044,"_5":27878,"_19130":106871,"_26074":106872,"_2645":106873},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3146":64069,"_27538":64044,"_5":27878,"_19130":106875,"_26074":106876,"_2645":106877},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3146":64070,"_27538":64044,"_5":27878,"_19130":106879,"_26074":106880,"_2645":106881},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3146":64071,"_27538":64044,"_5":27878,"_19130":106883,"_26074":106884,"_2645":106885},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3146":64072,"_27538":64044,"_5":27878,"_19130":106887,"_26074":106888,"_2645":106889},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3146":64073,"_27538":64044,"_5":27878,"_19130":106891,"_26074":106892,"_2645":106893},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3146":64074,"_27538":64044,"_5":27878,"_19130":106895,"_26074":106896,"_2645":106897},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3146":64075,"_27538":64044,"_5":27878,"_19130":106899,"_26074":106900,"_2645":106901},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3146":64076,"_27538":64044,"_5":27878,"_19130":106903,"_26074":106904,"_2645":106905},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3146":64077,"_27538":64044,"_19130":106907,"_5":13154,"_26074":64044,"_2645":106908},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3146":64078,"_27538":64044,"_19130":106910,"_5":13154,"_26074":64044,"_2645":106911},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3146":64079,"_27538":64044,"_19130":106913,"_5":13154,"_26074":64044,"_2645":106914},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3146":64080,"_27538":64044,"_19130":106916,"_5":13154,"_26074":106785,"_2645":106917},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3146":64081,"_27538":64044,"_19130":106919,"_5":13154,"_26074":106785,"_2645":106920},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3146":64082,"_27538":64044,"_19130":106922,"_5":13154,"_26074":106785,"_2645":106923},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3146":64083,"_27538":64044,"_19130":106925,"_5":13154,"_26074":106785,"_2645":106926},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3146":64084,"_27538":64044,"_19130":106928,"_5":13154,"_26074":106785,"_2645":106929},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3146":64085,"_27538":64044,"_19130":106931,"_5":13154,"_26074":106785,"_2645":106932},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3146":64086,"_27538":64044,"_19130":106934,"_5":13154,"_26074":106789,"_2645":106935},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3146":64087,"_27538":64044,"_19130":106937,"_5":13154,"_26074":106789,"_2645":106938},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3146":64088,"_27538":64044,"_19130":106940,"_5":13154,"_26074":106793,"_2645":106941},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3146":64089,"_27538":64044,"_19130":106943,"_5":13154,"_26074":106793,"_2645":106944},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3146":64090,"_27538":64044,"_19130":106946,"_5":13154,"_26074":106793,"_2645":106947},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3146":64091,"_27538":64044,"_19130":106949,"_5":13154,"_26074":106793,"_2645":106950},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3146":64092,"_27538":64044,"_19130":106952,"_5":13154,"_26074":106793,"_2645":106953},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3146":64093,"_27538":64044,"_19130":106955,"_5":13154,"_26074":106793,"_2645":106956},[],"Carga por separado las políticas concedidas a cada principal.",{"_3146":64094,"_27538":64044,"_19130":106958,"_5":13154,"_26074":106793,"_2645":106959},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3146":64095,"_27538":64044,"_19130":106961,"_5":13154,"_26074":106793,"_2645":106962},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3146":64096,"_27538":64044,"_19130":106964,"_5":13154,"_26074":106793,"_2645":106965},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3146":64097,"_27538":64044,"_19130":106967,"_5":13154,"_26074":106793,"_2645":106968},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3146":64098,"_27538":64044,"_19130":106970,"_5":13154,"_26074":106793,"_2645":106971},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3146":64099,"_27538":64044,"_19130":106973,"_5":13154,"_26074":106793,"_2645":106974},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3146":64100,"_27538":64044,"_19130":106976,"_5":13154,"_26074":106797,"_2645":106977},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3146":64101,"_27538":64044,"_19130":106979,"_5":13154,"_26074":106797,"_2645":106980},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3146":64102,"_27538":64044,"_19130":106982,"_5":13154,"_26074":106797,"_2645":106983},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3146":64103,"_27538":64044,"_19130":106985,"_5":13154,"_26074":106797,"_2645":106986},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3146":64104,"_27538":64044,"_19130":106988,"_5":13154,"_26074":106797,"_2645":106989},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3146":64105,"_27538":64044,"_19130":106991,"_5":13154,"_26074":106797,"_2645":106992},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3146":64106,"_27538":64044,"_19130":106994,"_5":13154,"_26074":106797,"_2645":106995},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3146":64107,"_27538":64044,"_19130":106997,"_5":13154,"_26074":106797,"_2645":106998},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3146":64108,"_27538":64044,"_19130":107000,"_5":13154,"_26074":106801,"_2645":107001},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3146":64109,"_27538":64044,"_19130":107003,"_5":13154,"_26074":106801,"_2645":107004},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3146":64110,"_27538":64044,"_19130":107006,"_5":13154,"_26074":106801,"_2645":107007},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3146":64111,"_27538":64044,"_19130":107009,"_5":13154,"_26074":106801,"_2645":107010},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3146":64112,"_27538":64044,"_19130":107012,"_5":13154,"_26074":106801,"_2645":107013},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3146":64113,"_27538":64044,"_19130":107015,"_5":13154,"_26074":106801,"_2645":107016},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3146":64114,"_27538":64044,"_19130":107018,"_5":13154,"_26074":106801,"_2645":107019},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3146":64115,"_27538":64044,"_19130":107021,"_5":13154,"_26074":106801,"_2645":107022},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3146":64116,"_27538":64044,"_19130":107024,"_5":13154,"_26074":106801,"_2645":107025},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3146":64117,"_27538":64044,"_19130":107027,"_5":13154,"_26074":106801,"_2645":107028},[],"Las acciones se dividen en dos grupos:",{"_3146":64118,"_27538":64044,"_19130":107030,"_5":13154,"_26074":106801,"_2645":107031},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3146":64119,"_27538":64044,"_19130":107033,"_5":13154,"_26074":106801,"_2645":107034},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3146":64120,"_27538":64044,"_19130":107036,"_5":13154,"_26074":106801,"_2645":107037},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3146":64121,"_27538":64044,"_19130":107039,"_5":13154,"_26074":106805,"_2645":107040},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3146":64122,"_27538":64044,"_19130":107042,"_5":13154,"_26074":106805,"_2645":107043},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3146":64123,"_27538":64044,"_19130":107045,"_5":13154,"_26074":106805,"_2645":107046},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3146":64124,"_27538":64044,"_19130":107048,"_5":13154,"_26074":106809,"_2645":107049},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3146":64125,"_27538":64044,"_19130":107051,"_5":13154,"_26074":106809,"_2645":107052},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3146":64126,"_27538":64044,"_19130":107054,"_5":13154,"_26074":106809,"_2645":107055},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3146":64127,"_27538":64044,"_19130":107057,"_5":13154,"_26074":106809,"_2645":107058},[],"Los operadores implementados son:",{"_3146":64128,"_27538":64044,"_19130":107060,"_5":13154,"_26074":106809,"_2645":107061},[],"`equals`, para igualdad exacta;",{"_3146":64129,"_27538":64044,"_19130":107063,"_5":13154,"_26074":106809,"_2645":107064},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3146":64130,"_27538":64044,"_19130":107066,"_5":13154,"_26074":106809,"_2645":107067},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3146":64131,"_27538":64044,"_19130":107069,"_5":13154,"_26074":106809,"_2645":107070},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3146":64132,"_27538":64044,"_19130":107072,"_5":13154,"_26074":106813,"_2645":107073},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3146":64133,"_27538":64044,"_19130":107075,"_5":13154,"_26074":106813,"_2645":107076},[],"Los modos disponibles son:",{"_3146":64134,"_27538":64044,"_19130":107078,"_5":13154,"_26074":106813,"_2645":107079},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3146":64135,"_27538":64044,"_19130":107081,"_5":13154,"_26074":106813,"_2645":107082},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3146":64136,"_27538":64044,"_19130":107084,"_5":13154,"_26074":106813,"_2645":107085},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3146":64137,"_27538":64044,"_19130":107087,"_5":13154,"_26074":106813,"_2645":107088},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3146":64138,"_27538":64044,"_19130":107090,"_5":13154,"_26074":106813,"_2645":107091},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3146":64139,"_27538":64044,"_19130":107093,"_5":13154,"_26074":106813,"_2645":107094},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3146":64140,"_27538":64044,"_19130":107096,"_5":13154,"_26074":106817,"_2645":107097},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3146":64141,"_27538":64044,"_19130":107099,"_5":13154,"_26074":106817,"_2645":107100},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3146":64142,"_27538":64044,"_19130":107102,"_5":13154,"_26074":106817,"_2645":107103},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3146":64143,"_27538":64044,"_19130":107105,"_5":13154,"_26074":106817,"_2645":107106},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3146":64144,"_27538":64044,"_19130":107108,"_5":13154,"_26074":106825,"_2645":107109},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3146":64145,"_27538":64044,"_19130":107111,"_5":13154,"_26074":106825,"_2645":107112},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3146":64146,"_27538":64044,"_19130":107114,"_5":13154,"_26074":106829,"_2645":107115},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3146":64147,"_27538":64044,"_19130":107117,"_5":13154,"_26074":106829,"_2645":107118},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3146":64148,"_27538":64044,"_19130":107120,"_5":13154,"_26074":106833,"_2645":107121},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3146":64149,"_27538":64044,"_19130":107123,"_5":13154,"_26074":106833,"_2645":107124},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3146":64150,"_27538":64044,"_19130":107126,"_5":13154,"_26074":106833,"_2645":107127},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3146":64151,"_27538":64044,"_19130":107129,"_5":13154,"_26074":106837,"_2645":107130},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3146":64152,"_27538":64044,"_19130":107132,"_5":13154,"_26074":106837,"_2645":107133},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3146":64153,"_27538":64044,"_19130":107135,"_5":13154,"_26074":106837,"_2645":107136},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3146":64154,"_27538":64044,"_19130":107138,"_5":13154,"_26074":106837,"_2645":107139},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3146":64155,"_27538":64044,"_19130":107141,"_5":13154,"_26074":106837,"_2645":107142},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3146":64156,"_27538":64044,"_19130":107144,"_5":13154,"_26074":106837,"_2645":107145},[],"Ten en cuenta que:",{"_3146":64157,"_27538":64044,"_19130":107147,"_5":13154,"_26074":106837,"_2645":107148},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3146":64158,"_27538":64044,"_19130":107150,"_5":13154,"_26074":106837,"_2645":107151},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3146":64159,"_27538":64044,"_19130":107153,"_5":13154,"_26074":106837,"_2645":107154},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3146":64160,"_27538":64044,"_19130":107156,"_5":13154,"_26074":106841,"_2645":107157},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3146":64161,"_27538":64044,"_19130":107159,"_5":13154,"_26074":106841,"_2645":107160},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3146":64162,"_27538":64044,"_19130":107162,"_5":13154,"_26074":106841,"_2645":107163},[],"acceso completo y de solo lectura a KMS;",{"_3146":64163,"_27538":64044,"_19130":107165,"_5":13154,"_26074":106841,"_2645":107166},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3146":64164,"_27538":64044,"_19130":107168,"_5":13154,"_26074":106841,"_2645":107169},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3146":64165,"_27538":64044,"_19130":107171,"_5":13154,"_26074":106841,"_2645":107172},[],"acceso a la interfaz;",{"_3146":64166,"_27538":64044,"_19130":107174,"_5":13154,"_26074":106841,"_2645":107175},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3146":64167,"_27538":64044,"_19130":107177,"_5":13154,"_26074":106841,"_2645":107178},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3146":64168,"_27538":64044,"_19130":107180,"_5":13154,"_26074":106841,"_2645":107181},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3146":64169,"_27538":64044,"_19130":107183,"_5":13154,"_26074":106845,"_2645":107184},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3146":64170,"_27538":64044,"_19130":107186,"_5":13154,"_26074":106845,"_2645":107187},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3146":64171,"_27538":64044,"_19130":107189,"_5":13154,"_26074":106845,"_2645":107190},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3146":64172,"_27538":64044,"_19130":107192,"_5":13154,"_26074":106848,"_2645":107193},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3146":64173,"_27538":64044,"_19130":107195,"_5":13154,"_26074":106852,"_2645":107196},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3146":64174,"_27538":64044,"_19130":107198,"_5":13154,"_26074":106852,"_2645":107199},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3146":64175,"_27538":64044,"_19130":107201,"_5":13154,"_26074":106856,"_2645":107202},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3146":64176,"_27538":64044,"_19130":107204,"_5":13154,"_26074":106860,"_2645":107205},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3146":64177,"_27538":64044,"_19130":107207,"_5":13154,"_26074":106864,"_2645":107208},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3146":64178,"_27538":64044,"_19130":107210,"_5":13154,"_26074":106868,"_2645":107211},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3146":64179,"_27538":64044,"_19130":107213,"_5":13154,"_26074":106868,"_2645":107214},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3146":64180,"_27538":64044,"_19130":107216,"_5":13154,"_26074":106872,"_2645":107217},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3146":64181,"_27538":64044,"_19130":107219,"_5":13154,"_26074":106872,"_2645":107220},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3146":64182,"_27538":64044,"_19130":107222,"_5":13154,"_26074":106872,"_2645":107223},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3146":64183,"_27538":64044,"_19130":107225,"_5":13154,"_26074":106872,"_2645":107226},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3146":64184,"_27538":64044,"_19130":107228,"_5":13154,"_26074":106872,"_2645":107229},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3146":64185,"_27538":64044,"_19130":107231,"_5":13154,"_26074":106872,"_2645":107232},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3146":64186,"_27538":64044,"_19130":107234,"_5":13154,"_26074":106872,"_2645":107235},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3146":64187,"_27538":64044,"_19130":107237,"_5":13154,"_26074":106872,"_2645":107238},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3146":64188,"_27538":64044,"_19130":107240,"_5":13154,"_26074":106876,"_2645":107241},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3146":64189,"_27538":64044,"_19130":107243,"_5":13154,"_26074":106876,"_2645":107244},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3146":64190,"_27538":64044,"_19130":107246,"_5":13154,"_26074":106876,"_2645":107247},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3146":64191,"_27538":64044,"_19130":107249,"_5":13154,"_26074":106880,"_2645":107250},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3146":64192,"_27538":64044,"_19130":107252,"_5":13154,"_26074":106880,"_2645":107253},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3146":64193,"_27538":64044,"_19130":107255,"_5":13154,"_26074":106880,"_2645":107256},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3146":64194,"_27538":64044,"_19130":107258,"_5":13154,"_26074":106880,"_2645":107259},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3146":64195,"_27538":64044,"_19130":107261,"_5":13154,"_26074":106880,"_2645":107262},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3146":64196,"_27538":64044,"_19130":107264,"_5":13154,"_26074":106880,"_2645":107265},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3146":64197,"_27538":64044,"_19130":107267,"_5":13154,"_26074":106880,"_2645":107268},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3146":64198,"_27538":64044,"_19130":107270,"_5":13154,"_26074":106880,"_2645":107271},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3146":64199,"_27538":64044,"_19130":107273,"_5":13154,"_26074":106888,"_2645":107274},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3146":64200,"_27538":64044,"_19130":107276,"_5":13154,"_26074":106892,"_2645":107277},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3146":64201,"_27538":64044,"_19130":107279,"_5":13154,"_26074":106892,"_2645":107280},[],"que exista un principal activo del tipo correcto;",{"_3146":64202,"_27538":64044,"_19130":107282,"_5":13154,"_26074":106892,"_2645":107283},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3146":64203,"_27538":64044,"_19130":107285,"_5":13154,"_26074":106892,"_2645":107286},[],"que todas las condiciones del principal se cumplan;",{"_3146":64204,"_27538":64044,"_19130":107288,"_5":13154,"_26074":106892,"_2645":107289},[],"que el principal tenga concedida la política esperada;",{"_3146":64205,"_27538":64044,"_19130":107291,"_5":13154,"_26074":106892,"_2645":107292},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3146":64206,"_27538":64044,"_19130":107294,"_5":13154,"_26074":106892,"_2645":107295},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3146":64207,"_27538":64044,"_19130":107297,"_5":13154,"_26074":106892,"_2645":107298},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3146":64208,"_27538":64044,"_19130":107300,"_5":13154,"_26074":106896,"_2645":107301},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3146":64209,"_27538":64044,"_19130":107303,"_5":13154,"_26074":106900,"_2645":107304},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3146":64210,"_27538":64044,"_19130":107306,"_5":13154,"_26074":106904,"_2645":107307},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3146":64211,"_27538":64044,"_19130":107309,"_5":13154,"_26074":106904,"_2645":107310},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3146":64212,"_27538":64212,"_5":13480,"_2645":107312,"_27881":107313,"_19130":107314,"_26074":64212},"Alertas y suscripciones",[44830,106777,106778],[],{"_3146":64213,"_27538":64212,"_19130":107316,"_5":13154,"_26074":64212,"_2645":107317},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3146":64214,"_27538":64212,"_5":27878,"_19130":107319,"_26074":107320,"_2645":107321},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3146":64215,"_27538":64212,"_5":27878,"_19130":107323,"_26074":107324,"_2645":107325},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3146":64216,"_27538":64212,"_5":27878,"_19130":107327,"_26074":107328,"_2645":107329},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3146":64217,"_27538":64212,"_5":27878,"_19130":107331,"_26074":107332,"_2645":107333},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3146":64218,"_27538":64212,"_5":27878,"_19130":107335,"_26074":107336,"_2645":107337},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3146":64219,"_27538":64212,"_5":27878,"_19130":107339,"_26074":107340,"_2645":107341},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3146":64220,"_27538":64212,"_5":27878,"_19130":107343,"_26074":107344,"_2645":107345},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3146":64221,"_27538":64212,"_5":27878,"_19130":107347,"_26074":107348,"_2645":107349},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3146":64222,"_27538":64212,"_5":27878,"_19130":107351,"_26074":107352,"_2645":107353},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3146":64223,"_27538":64212,"_5":27878,"_19130":107355,"_26074":107356,"_2645":107357},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3146":64224,"_27538":64212,"_19130":107359,"_5":13154,"_26074":64212,"_2645":107360},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3146":64225,"_27538":64212,"_19130":107362,"_5":13154,"_26074":107320,"_2645":107363},[],"Un servicio publica un evento de dominio.",{"_3146":64226,"_27538":64212,"_19130":107365,"_5":13154,"_26074":107320,"_2645":107366},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3146":64227,"_27538":64212,"_19130":107368,"_5":13154,"_26074":107320,"_2645":107369},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3146":64228,"_27538":64212,"_19130":107371,"_5":13154,"_26074":107320,"_2645":107372},[],"Lamassu entrega el evento al canal configurado.",{"_3146":64229,"_27538":64212,"_19130":107374,"_5":13154,"_26074":107320,"_2645":107375},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3146":64230,"_27538":64212,"_19130":107377,"_5":13154,"_26074":107324,"_2645":107378},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3146":64231,"_27538":64212,"_19130":107380,"_5":13154,"_26074":107324,"_2645":107381},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3146":64232,"_27538":64212,"_19130":107383,"_5":13154,"_26074":107324,"_2645":107384},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3146":64233,"_27538":64212,"_19130":107386,"_5":13154,"_26074":107324,"_2645":107387},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3146":64234,"_27538":64212,"_19130":107389,"_5":13154,"_26074":107324,"_2645":107390},[],"`apikey_options` necesita `header` y `key`.",{"_3146":64235,"_27538":64212,"_19130":107392,"_5":13154,"_26074":107324,"_2645":107393},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3146":64236,"_27538":64212,"_19130":107395,"_5":13154,"_26074":107324,"_2645":107396},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3146":64237,"_27538":64212,"_19130":107398,"_5":13154,"_26074":107324,"_2645":107399},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3146":64238,"_27538":64212,"_19130":107401,"_5":13154,"_26074":107332,"_2645":107402},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3146":64239,"_27538":64212,"_19130":107404,"_5":13154,"_26074":107336,"_2645":107405},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3146":64240,"_27538":64212,"_19130":107407,"_5":13154,"_26074":107340,"_2645":107408},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3146":64241,"_27538":64212,"_19130":107410,"_5":13154,"_26074":107340,"_2645":107411},[],"**None** notifica todas las instancias del evento.",{"_3146":64242,"_27538":64212,"_19130":107413,"_5":13154,"_26074":107340,"_2645":107414},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3146":64243,"_27538":64212,"_19130":107416,"_5":13154,"_26074":107340,"_2645":107417},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3146":64244,"_27538":64212,"_19130":107419,"_5":13154,"_26074":107340,"_2645":107420},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3146":64245,"_27538":64212,"_19130":107422,"_5":13154,"_26074":107340,"_2645":107423},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3146":64246,"_27538":64212,"_19130":107425,"_5":13154,"_26074":107344,"_2645":107426},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3146":64247,"_27538":64212,"_19130":107428,"_5":13154,"_26074":107348,"_2645":107429},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3146":64248,"_27538":64212,"_19130":107431,"_5":13154,"_26074":107348,"_2645":107432},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3146":64249,"_27538":64212,"_19130":107434,"_5":13154,"_26074":107348,"_2645":107435},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3146":64250,"_27538":64212,"_19130":107437,"_5":13154,"_26074":107348,"_2645":107438},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3146":64251,"_27538":64212,"_19130":107440,"_5":13154,"_26074":107348,"_2645":107441},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3146":64252,"_27538":64212,"_19130":107443,"_5":13154,"_26074":107348,"_2645":107444},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3146":64253,"_27538":64212,"_19130":107446,"_5":13154,"_26074":107348,"_2645":107447},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3146":64254,"_27538":64212,"_19130":107449,"_5":13154,"_26074":107348,"_2645":107450},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3146":64255,"_27538":64212,"_19130":107452,"_5":13154,"_26074":107352,"_2645":107453},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3146":64256,"_27538":64212,"_19130":107455,"_5":13154,"_26074":107356,"_2645":107456},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3146":64257,"_27538":64212,"_19130":107458,"_5":13154,"_26074":107356,"_2645":107459},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3146":64258,"_27538":64212,"_19130":107461,"_5":13154,"_26074":107356,"_2645":107462},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3146":64259,"_27538":64212,"_19130":107464,"_5":13154,"_26074":107356,"_2645":107465},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3146":64260,"_27538":64212,"_19130":107467,"_5":13154,"_26074":107356,"_2645":107468},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3146":64261,"_27538":64212,"_19130":107470,"_5":13154,"_26074":107356,"_2645":107471},[],"**Validación:** `va.role.crl.create`.",{"_3146":64262,"_27538":64212,"_19130":107473,"_5":13154,"_26074":107356,"_2645":107474},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3146":64263,"_27538":64212,"_19130":107476,"_5":13154,"_26074":107356,"_2645":107477},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3146":64264,"_27538":64264,"_5":13480,"_2645":107479,"_27881":107480,"_19130":107481,"_26074":64264},"Registros de auditoría",[44830,106777,106778],[],{"_3146":64265,"_27538":64264,"_19130":107483,"_5":13154,"_26074":64264,"_2645":107484},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3146":64266,"_27538":64264,"_5":27878,"_19130":107486,"_26074":107487,"_2645":107488},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3146":64267,"_27538":64264,"_5":27878,"_19130":107490,"_26074":107491,"_2645":107492},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3146":64268,"_27538":64264,"_5":27878,"_19130":107494,"_26074":107495,"_2645":107496},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3146":64269,"_27538":64264,"_5":27878,"_19130":107498,"_26074":107499,"_2645":107500},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3146":64270,"_27538":64264,"_5":27878,"_19130":107502,"_26074":107503,"_2645":107504},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3146":64271,"_27538":64264,"_5":27878,"_19130":107506,"_26074":107507,"_2645":107508},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3146":64272,"_27538":64264,"_5":27878,"_19130":107510,"_26074":107511,"_2645":107512},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3146":64273,"_27538":64264,"_5":27878,"_19130":107514,"_26074":107515,"_2645":107516},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3146":64274,"_27538":64264,"_5":27878,"_19130":107518,"_26074":107519,"_2645":107520},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3146":64275,"_27538":64264,"_5":27878,"_19130":107522,"_26074":107523,"_2645":107524},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3146":64276,"_27538":64264,"_5":27878,"_19130":107526,"_26074":107527,"_2645":107528},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3146":64277,"_27538":64264,"_19130":107530,"_5":13154,"_26074":64264,"_2645":107531},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3146":64278,"_27538":64264,"_19130":107533,"_5":13154,"_26074":107487,"_2645":107534},[],"El cuerpo de auditoría incluye:",{"_3146":64279,"_27538":64264,"_19130":107536,"_5":13154,"_26074":107487,"_2645":107537},[],"input: datos recibidos por la operación;",{"_3146":64280,"_27538":64264,"_19130":107539,"_5":13154,"_26074":107487,"_2645":107540},[],"has\\_error: indica si el servicio devolvió un error;",{"_3146":64281,"_27538":64264,"_19130":107542,"_5":13154,"_26074":107487,"_2645":107543},[],"output: resultado producido o mensaje de error;",{"_3146":64282,"_27538":64264,"_19130":107545,"_5":13154,"_26074":107487,"_2645":107546},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3146":64283,"_27538":64264,"_19130":107548,"_5":13154,"_26074":107487,"_2645":107549},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3146":64284,"_27538":64264,"_19130":107551,"_5":13154,"_26074":107487,"_2645":107552},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3146":64285,"_27538":64264,"_19130":107554,"_5":13154,"_26074":107491,"_2645":107555},[],"El backend aplica auditoría a mutaciones de:",{"_3146":64286,"_27538":64264,"_19130":107557,"_5":13154,"_26074":107491,"_2645":107558},[],"autoridades, certificados y perfiles de emisión;",{"_3146":64287,"_27538":64264,"_19130":107560,"_5":13154,"_26074":107491,"_2645":107561},[],"claves y motores KMS;",{"_3146":64288,"_27538":64264,"_19130":107563,"_5":13154,"_26074":107491,"_2645":107564},[],"dispositivos e identidades;",{"_3146":64289,"_27538":64264,"_19130":107566,"_5":13154,"_26074":107491,"_2645":107567},[],"DMS y operaciones de enrolamiento;",{"_3146":64290,"_27538":64264,"_19130":107569,"_5":13154,"_26074":107491,"_2645":107570},[],"funciones de validación y CRL;",{"_3146":64291,"_27538":64264,"_19130":107572,"_5":13154,"_26074":107491,"_2645":107573},[],"principales, políticas y concesiones de autorización.",{"_3146":64292,"_27538":64264,"_19130":107575,"_5":13154,"_26074":107491,"_2645":107576},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3146":64293,"_27538":64264,"_19130":107578,"_5":13154,"_26074":107495,"_2645":107579},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3146":64294,"_27538":64264,"_19130":107581,"_5":13154,"_26074":107495,"_2645":107582},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3146":64295,"_27538":64264,"_19130":107584,"_5":13154,"_26074":107495,"_2645":107585},[],"Diseña el consumidor para:",{"_3146":64296,"_27538":64264,"_19130":107587,"_5":13154,"_26074":107495,"_2645":107588},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3146":64297,"_27538":64264,"_19130":107590,"_5":13154,"_26074":107495,"_2645":107591},[],"conservar el CloudEvent completo sin modificar;",{"_3146":64298,"_27538":64264,"_19130":107593,"_5":13154,"_26074":107495,"_2645":107594},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3146":64299,"_27538":64264,"_19130":107596,"_5":13154,"_26074":107495,"_2645":107597},[],"cifrar en tránsito y en reposo;",{"_3146":64300,"_27538":64264,"_19130":107599,"_5":13154,"_26074":107495,"_2645":107600},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3146":64301,"_27538":64264,"_19130":107602,"_5":13154,"_26074":107495,"_2645":107603},[],"aplicar una política explícita de retención y legal hold;",{"_3146":64302,"_27538":64264,"_19130":107605,"_5":13154,"_26074":107495,"_2645":107606},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3146":64303,"_27538":64264,"_19130":107608,"_5":13154,"_26074":107499,"_2645":107609},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3146":64304,"_27538":64264,"_19130":107611,"_5":13154,"_26074":107499,"_2645":107612},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3146":64305,"_27538":64264,"_19130":107614,"_5":13154,"_26074":107507,"_2645":107615},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3146":64306,"_27538":64264,"_19130":107617,"_5":13154,"_26074":107511,"_2645":107618},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3146":64307,"_27538":64264,"_19130":107620,"_5":13154,"_26074":107515,"_2645":107621},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3146":64308,"_27538":64264,"_19130":107623,"_5":13154,"_26074":107519,"_2645":107624},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3146":64309,"_27538":64264,"_19130":107626,"_5":13154,"_26074":107523,"_2645":107627},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3146":64310,"_27538":64264,"_19130":107629,"_5":13154,"_26074":107527,"_2645":107630},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3146":64311,"_27538":64264,"_19130":107632,"_5":13154,"_26074":107527,"_2645":107633},[],"aparece un evento de auditoría correcto;",{"_3146":64312,"_27538":64264,"_19130":107635,"_5":13154,"_26074":107527,"_2645":107636},[],"el principal coincide con la identidad utilizada;",{"_3146":64313,"_27538":64264,"_19130":107638,"_5":13154,"_26074":107527,"_2645":107639},[],"el consumidor lo persiste una sola vez;",{"_3146":64314,"_27538":64264,"_19130":107641,"_5":13154,"_26074":107527,"_2645":107642},[],"puede recuperarse por recurso, actor y periodo;",{"_3146":64315,"_27538":64264,"_19130":107644,"_5":13154,"_26074":107527,"_2645":107645},[],"una interrupción del consumidor produce una alerta.",{"_3146":64316,"_27538":64264,"_19130":107647,"_5":13154,"_26074":107527,"_2645":107648},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3146":64317,"_27538":64317,"_5":13480,"_2645":107650,"_27881":107651,"_19130":107652,"_26074":64317},"Arquitectura de la plataforma",[44830,106777],[],{"_3146":64318,"_27538":64317,"_19130":107654,"_5":13154,"_26074":64317,"_2645":107655},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3146":64319,"_27538":64317,"_5":27878,"_19130":107657,"_26074":107658,"_2645":107659},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3146":64320,"_27538":64317,"_5":27878,"_19130":107661,"_26074":107662,"_2645":107663},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3146":64321,"_27538":64317,"_5":27878,"_19130":107665,"_26074":107666,"_2645":107667},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3146":64322,"_27538":64317,"_5":27878,"_19130":107669,"_26074":107670,"_2645":107671},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3146":64323,"_27538":64317,"_5":27878,"_19130":107673,"_26074":107674,"_2645":107675},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3146":64324,"_27538":64317,"_19130":107677,"_5":13154,"_26074":64317,"_2645":107678},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3146":64325,"_27538":64317,"_19130":107680,"_5":13154,"_26074":64317,"_2645":107681},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3146":64326,"_27538":64317,"_19130":107683,"_5":13154,"_26074":107658,"_2645":107684},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3146":64327,"_27538":64317,"_19130":107686,"_5":13154,"_26074":107662,"_2645":107687},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3146":64328,"_27538":64317,"_19130":107689,"_5":13154,"_26074":107666,"_2645":107690},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3146":64329,"_27538":64317,"_19130":107692,"_5":13154,"_26074":107670,"_2645":107693},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3146":64330,"_27538":64317,"_19130":107695,"_5":13154,"_26074":107674,"_2645":107696},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3146":64331,"_27538":64331,"_5":13480,"_2645":107698,"_27881":107699,"_19130":107700,"_26074":64331},"Cómo funciona Lamassu",[44830,106777],[],{"_3146":64332,"_27538":64331,"_19130":107702,"_5":13154,"_26074":64331,"_2645":107703},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3146":64333,"_27538":64331,"_5":27878,"_19130":107705,"_26074":107706,"_2645":107707},[],"/docs/pr-preview/pr-26/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3146":64334,"_27538":64331,"_5":27878,"_19130":107709,"_26074":107710,"_2645":107711},[],"/docs/pr-preview/pr-26/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3146":64335,"_27538":64331,"_19130":107713,"_5":13154,"_26074":64331,"_2645":107714},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3146":64336,"_27538":64331,"_19130":107716,"_5":13154,"_26074":107706,"_2645":107717},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3146":64337,"_27538":64331,"_19130":107719,"_5":13154,"_26074":107706,"_2645":107720},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3146":64338,"_27538":64331,"_19130":107722,"_5":13154,"_26074":107706,"_2645":107723},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3146":64339,"_27538":64331,"_19130":107725,"_5":13154,"_26074":107706,"_2645":107726},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3146":64340,"_27538":64331,"_19130":107728,"_5":13154,"_26074":107706,"_2645":107729},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3146":64341,"_27538":64331,"_19130":107731,"_5":13154,"_26074":107710,"_2645":107732},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3146":64342,"_27538":64331,"_19130":107734,"_5":13154,"_26074":107710,"_2645":107735},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3146":64343,"_27538":64331,"_19130":107737,"_5":13154,"_26074":107710,"_2645":107738},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3146":64344,"_27538":64331,"_19130":107740,"_5":13154,"_26074":107710,"_2645":107741},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3146":64345,"_27538":64331,"_19130":107743,"_5":13154,"_26074":107710,"_2645":107744},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3146":64346,"_27538":64331,"_19130":107746,"_5":13154,"_26074":107710,"_2645":107747},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3146":64347,"_27538":64331,"_19130":107749,"_5":13154,"_26074":107710,"_2645":107750},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3146":64348,"_27538":64348,"_5":13480,"_2645":107752,"_27881":107753,"_19130":107754,"_26074":64348},"Dispositivos e identidades",[44830,106777,47187,107752],[],{"_3146":64349,"_27538":64348,"_19130":107756,"_5":13154,"_26074":64348,"_2645":107757},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3146":64350,"_27538":64348,"_5":27878,"_19130":107759,"_26074":107760,"_2645":107761},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3146":64351,"_27538":64348,"_5":27878,"_19130":107763,"_26074":107764,"_2645":107765},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3146":64352,"_27538":64348,"_5":27878,"_19130":107767,"_26074":107768,"_2645":107769},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3146":64353,"_27538":64348,"_5":27878,"_19130":107771,"_26074":107772,"_2645":107773},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3146":64354,"_27538":64348,"_5":27878,"_19130":107775,"_26074":107776,"_2645":107777},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3146":64355,"_27538":64348,"_5":27878,"_19130":107779,"_26074":107780,"_2645":107781},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3146":64356,"_27538":64348,"_5":27878,"_19130":107783,"_26074":107784,"_2645":107785},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3146":64357,"_27538":64348,"_5":27878,"_19130":107787,"_26074":107788,"_2645":107789},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3146":64358,"_27538":64348,"_5":27878,"_19130":107791,"_26074":107792,"_2645":107793},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3146":64359,"_27538":64348,"_5":27878,"_19130":107795,"_26074":107796,"_2645":107797},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3146":64360,"_27538":64348,"_5":27878,"_19130":107799,"_26074":107800,"_2645":107801},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3146":64361,"_27538":64348,"_19130":107803,"_5":13154,"_26074":64348,"_2645":107804},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3146":64362,"_27538":64348,"_19130":107806,"_5":13154,"_26074":64348,"_2645":107807},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3146":64363,"_27538":64348,"_19130":107809,"_5":13154,"_26074":107760,"_2645":107810},[],"Vista operativa",{"_3146":64364,"_27538":64348,"_19130":107812,"_5":13154,"_26074":107760,"_2645":107813},[],"Interpretación",{"_3146":64365,"_27538":64348,"_19130":107815,"_5":13154,"_26074":107760,"_2645":47250},[],{"_3146":64366,"_27538":64348,"_19130":107817,"_5":13154,"_26074":107760,"_2645":107818},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3146":64367,"_27538":64348,"_19130":107820,"_5":13154,"_26074":107760,"_2645":47256},[],{"_3146":64368,"_27538":64348,"_19130":107822,"_5":13154,"_26074":107760,"_2645":107823},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3146":64369,"_27538":64348,"_19130":107825,"_5":13154,"_26074":107760,"_2645":47262},[],{"_3146":64370,"_27538":64348,"_19130":107827,"_5":13154,"_26074":107760,"_2645":107828},[],"La identidad está en la ventana operativa de renovación.",{"_3146":64371,"_27538":64348,"_19130":107830,"_5":13154,"_26074":107760,"_2645":47268},[],{"_3146":64372,"_27538":64348,"_19130":107832,"_5":13154,"_26074":107760,"_2645":107833},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3146":64373,"_27538":64348,"_19130":107835,"_5":13154,"_26074":107760,"_2645":47274},[],{"_3146":64374,"_27538":64348,"_19130":107837,"_5":13154,"_26074":107760,"_2645":107838},[],"La identidad ha vencido.",{"_3146":64375,"_27538":64348,"_19130":107840,"_5":13154,"_26074":107760,"_2645":47280},[],{"_3146":64376,"_27538":64348,"_19130":107842,"_5":13154,"_26074":107760,"_2645":107843},[],"La identidad está marcada como revocada.",{"_3146":64377,"_27538":64348,"_19130":107845,"_5":13154,"_26074":107760,"_2645":47286},[],{"_3146":64378,"_27538":64348,"_19130":107847,"_5":13154,"_26074":107760,"_2645":107848},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3146":64379,"_27538":64348,"_19130":107850,"_5":13154,"_26074":107760,"_2645":107851},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3146":64380,"_27538":64348,"_19130":107853,"_5":13154,"_26074":107764,"_2645":107854},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3146":64381,"_27538":64348,"_19130":107856,"_5":13154,"_26074":107764,"_2645":107857},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3146":64382,"_27538":64348,"_19130":107859,"_5":13154,"_26074":107764,"_2645":107860},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3146":64383,"_27538":64348,"_19130":107862,"_5":13154,"_26074":107764,"_2645":107863},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3146":64384,"_27538":64348,"_19130":107865,"_5":13154,"_26074":107768,"_2645":107866},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3146":64385,"_27538":64348,"_19130":107868,"_5":13154,"_26074":107772,"_2645":107869},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3146":64386,"_27538":64348,"_19130":107871,"_5":13154,"_26074":107776,"_2645":107872},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3146":64387,"_27538":64348,"_19130":107874,"_5":13154,"_26074":107780,"_2645":107875},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3146":64388,"_27538":64348,"_19130":107877,"_5":13154,"_26074":107784,"_2645":107878},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3146":64389,"_27538":64348,"_19130":107880,"_5":13154,"_26074":107784,"_2645":107881},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3146":64390,"_27538":64348,"_19130":107883,"_5":13154,"_26074":107788,"_2645":107884},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3146":64391,"_27538":64348,"_19130":107886,"_5":13154,"_26074":107788,"_2645":107887},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3146":64392,"_27538":64348,"_19130":107889,"_5":13154,"_26074":107788,"_2645":107890},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3146":64393,"_27538":64348,"_19130":107892,"_5":13154,"_26074":107788,"_2645":107893},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3146":64394,"_27538":64348,"_19130":107895,"_5":13154,"_26074":107788,"_2645":107896},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3146":64395,"_27538":64348,"_19130":107898,"_5":13154,"_26074":107788,"_2645":107899},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3146":64396,"_27538":64348,"_19130":107901,"_5":13154,"_26074":107792,"_2645":107902},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3146":64397,"_27538":64348,"_19130":107904,"_5":13154,"_26074":107792,"_2645":107905},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3146":64398,"_27538":64348,"_19130":107907,"_5":13154,"_26074":107796,"_2645":107908},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3146":64399,"_27538":64348,"_19130":107910,"_5":13154,"_26074":107796,"_2645":107911},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3146":64400,"_27538":64348,"_19130":107913,"_5":13154,"_26074":107796,"_2645":107914},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3146":64401,"_27538":64348,"_19130":107916,"_5":13154,"_26074":107796,"_2645":107917},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3146":64402,"_27538":64348,"_19130":107919,"_5":13154,"_26074":107800,"_2645":107920},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3146":64403,"_27538":64348,"_19130":107922,"_5":13154,"_26074":107800,"_2645":107923},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3146":64404,"_27538":64404,"_5":13480,"_2645":107925,"_27881":107926,"_19130":107928,"_26074":64404},"Identidad inicial y autenticación",[44830,106777,47187,107752,107927],"Enrolamiento con PKI",[],{"_3146":64405,"_27538":64404,"_19130":107930,"_5":13154,"_26074":64404,"_2645":107931},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3146":64406,"_27538":64404,"_5":27878,"_19130":107933,"_26074":107934,"_2645":107935},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3146":64407,"_27538":64404,"_5":27878,"_19130":107937,"_26074":107938,"_2645":107939},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3146":64408,"_27538":64404,"_5":27878,"_19130":107941,"_26074":107942,"_2645":107943},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3146":64409,"_27538":64404,"_5":27878,"_19130":107945,"_26074":107946,"_2645":107947},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3146":64410,"_27538":64404,"_5":27878,"_19130":107949,"_26074":107950,"_2645":107951},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3146":64411,"_27538":64404,"_19130":107953,"_5":13154,"_26074":64404,"_2645":107954},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3146":64412,"_27538":64404,"_19130":107956,"_5":13154,"_26074":107934,"_2645":107957},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3146":64413,"_27538":64404,"_19130":107959,"_5":13154,"_26074":107934,"_2645":107960},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3146":64414,"_27538":64404,"_19130":107962,"_5":13154,"_26074":107938,"_2645":107963},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3146":64415,"_27538":64404,"_19130":107965,"_5":13154,"_26074":107938,"_2645":107966},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3146":64416,"_27538":64404,"_19130":107968,"_5":13154,"_26074":107938,"_2645":107969},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3146":64417,"_27538":64404,"_19130":107971,"_5":13154,"_26074":107942,"_2645":107972},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3146":64418,"_27538":64404,"_19130":107974,"_5":13154,"_26074":107942,"_2645":107975},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3146":64419,"_27538":64404,"_19130":107977,"_5":13154,"_26074":107946,"_2645":107978},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3146":64420,"_27538":64404,"_19130":107980,"_5":13154,"_26074":107946,"_2645":107981},[],"Ejemplo de cuerpo:",{"_3146":64421,"_27538":64404,"_19130":107983,"_5":13154,"_26074":107946,"_2645":107984},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3146":64422,"_27538":64404,"_19130":107986,"_5":13154,"_26074":107946,"_2645":107987},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3146":64423,"_27538":64404,"_19130":107989,"_5":13154,"_26074":107946,"_2645":107990},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3146":64424,"_27538":64404,"_19130":107992,"_5":13154,"_26074":107946,"_2645":107993},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3146":64425,"_27538":64404,"_19130":107995,"_5":13154,"_26074":107950,"_2645":107996},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3146":64426,"_27538":64404,"_19130":107998,"_5":13154,"_26074":107950,"_2645":107999},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3146":64427,"_27538":64427,"_5":13480,"_2645":108001,"_27881":108002,"_19130":108003,"_26074":64427},"Configura y opera el DMS",[44830,106777,47187,107752,107927],[],{"_3146":64428,"_27538":64427,"_19130":108005,"_5":13154,"_26074":64427,"_2645":108006},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3146":64429,"_27538":64427,"_5":27878,"_19130":108008,"_26074":108009,"_2645":105443},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3146":64430,"_27538":64427,"_5":27878,"_19130":108011,"_26074":108012,"_2645":108013},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3146":64431,"_27538":64427,"_5":27878,"_19130":108015,"_26074":108016,"_2645":108017},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3146":64432,"_27538":64427,"_5":27878,"_19130":108019,"_26074":108020,"_2645":108021},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3146":64433,"_27538":64427,"_5":27878,"_19130":108023,"_26074":108024,"_2645":108025},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3146":64434,"_27538":64427,"_5":27878,"_19130":108027,"_26074":108028,"_2645":108029},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3146":64435,"_27538":64427,"_5":27878,"_19130":108031,"_26074":108032,"_2645":108033},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3146":64436,"_27538":64427,"_5":27878,"_19130":108035,"_26074":108036,"_2645":108037},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3146":64437,"_27538":64427,"_5":27878,"_19130":108039,"_26074":108040,"_2645":47482},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3146":64438,"_27538":64427,"_5":27878,"_19130":108042,"_26074":108043,"_2645":47486},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3146":64439,"_27538":64427,"_5":27878,"_19130":108045,"_26074":108046,"_2645":108047},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3146":64440,"_27538":64427,"_5":27878,"_19130":108049,"_26074":108050,"_2645":108051},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3146":64441,"_27538":64427,"_5":27878,"_19130":108053,"_26074":108054,"_2645":108055},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3146":64442,"_27538":64427,"_5":27878,"_19130":108057,"_26074":108058,"_2645":108059},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3146":64443,"_27538":64427,"_5":27878,"_19130":108061,"_26074":108062,"_2645":47506},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3146":64444,"_27538":64427,"_5":27878,"_19130":108064,"_26074":108065,"_2645":108066},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3146":64445,"_27538":64427,"_5":27878,"_19130":108068,"_26074":108069,"_2645":108070},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3146":64446,"_27538":64427,"_5":27878,"_19130":108072,"_26074":108073,"_2645":108074},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3146":64447,"_27538":64427,"_19130":108076,"_5":13154,"_26074":64427,"_2645":108077},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3146":64448,"_27538":64427,"_19130":108079,"_5":13154,"_26074":108009,"_2645":108080},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3146":64449,"_27538":64427,"_19130":108082,"_5":13154,"_26074":108009,"_2645":108083},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3146":64450,"_27538":64427,"_19130":108085,"_5":13154,"_26074":108016,"_2645":108086},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3146":64451,"_27538":64427,"_19130":108088,"_5":13154,"_26074":108020,"_2645":108089},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3146":64452,"_27538":64427,"_19130":108091,"_5":13154,"_26074":108024,"_2645":108092},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3146":64453,"_27538":64427,"_19130":108094,"_5":13154,"_26074":108028,"_2645":108095},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3146":64454,"_27538":64427,"_19130":108097,"_5":13154,"_26074":108032,"_2645":108098},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3146":64455,"_27538":64427,"_19130":108100,"_5":13154,"_26074":108040,"_2645":108101},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3146":64456,"_27538":64427,"_19130":108103,"_5":13154,"_26074":108040,"_2645":108104},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3146":64457,"_27538":64427,"_19130":108106,"_5":13154,"_26074":108043,"_2645":108107},[],"Campo de `settings.enrollment_settings`",{"_3146":64458,"_27538":64427,"_19130":108109,"_5":13154,"_26074":108043,"_2645":108110},[],"Decisión",{"_3146":64459,"_27538":64427,"_19130":108112,"_5":13154,"_26074":108043,"_2645":47557},[],{"_3146":64460,"_27538":64427,"_19130":108114,"_5":13154,"_26074":108043,"_2645":108115},[],"`EST_RFC7030` para estas operaciones.",{"_3146":64461,"_27538":64427,"_19130":108117,"_5":13154,"_26074":108043,"_2645":47563},[],{"_3146":64462,"_27538":64427,"_19130":108119,"_5":13154,"_26074":108043,"_2645":108120},[],"ID de la CA que firmará.",{"_3146":64463,"_27538":64427,"_19130":108122,"_5":13154,"_26074":108043,"_2645":47569},[],{"_3146":64464,"_27538":64427,"_19130":108124,"_5":13154,"_26074":108043,"_2645":108125},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3146":64465,"_27538":64427,"_19130":108127,"_5":13154,"_26074":108043,"_2645":47575},[],{"_3146":64466,"_27538":64427,"_19130":108129,"_5":13154,"_26074":108043,"_2645":108130},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3146":64467,"_27538":64427,"_19130":108132,"_5":13154,"_26074":108043,"_2645":47581},[],{"_3146":64468,"_27538":64427,"_19130":108134,"_5":13154,"_26074":108043,"_2645":108135},[],"Uno de los cuatro modos de autenticación.",{"_3146":64469,"_27538":64427,"_19130":108137,"_5":13154,"_26074":108043,"_2645":108138},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3146":64470,"_27538":64427,"_19130":108140,"_5":13154,"_26074":108046,"_2645":108141},[],"Los bloques son independientes:",{"_3146":64471,"_27538":64427,"_19130":108143,"_5":13154,"_26074":108046,"_2645":108144},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3146":64472,"_27538":64427,"_19130":108146,"_5":13154,"_26074":108046,"_2645":108147},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3146":64473,"_27538":64427,"_19130":108149,"_5":13154,"_26074":108046,"_2645":47599},[],{"_3146":64474,"_27538":64427,"_19130":108151,"_5":13154,"_26074":108046,"_2645":108152},[],"Control aplicado en la operación configurada",{"_3146":64475,"_27538":64427,"_19130":108154,"_5":13154,"_26074":108046,"_2645":47605},[],{"_3146":64476,"_27538":64427,"_19130":108156,"_5":13154,"_26074":108046,"_2645":108157},[],"Validación del certificado presentado.",{"_3146":64477,"_27538":64427,"_19130":108159,"_5":13154,"_26074":108046,"_2645":47611},[],{"_3146":64478,"_27538":64427,"_19130":108161,"_5":13154,"_26074":108046,"_2645":108162},[],"Autorización del webhook configurado.",{"_3146":64479,"_27538":64427,"_19130":108164,"_5":13154,"_26074":108046,"_2645":47617},[],{"_3146":64480,"_27538":64427,"_19130":108166,"_5":13154,"_26074":108046,"_2645":108167},[],"Validación del certificado y, después, aprobación del webhook.",{"_3146":64481,"_27538":64427,"_19130":108169,"_5":13154,"_26074":108046,"_2645":47623},[],{"_3146":64482,"_27538":64427,"_19130":108171,"_5":13154,"_26074":108046,"_2645":108172},[],"Sin autenticación del solicitante por el DMS.",{"_3146":64483,"_27538":64427,"_19130":108174,"_5":13154,"_26074":108046,"_2645":108175},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3146":64484,"_27538":64427,"_19130":108177,"_5":13154,"_26074":108046,"_2645":108178},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3146":64485,"_27538":64427,"_19130":108180,"_5":13154,"_26074":108046,"_2645":108181},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3146":64486,"_27538":64427,"_19130":108183,"_5":13154,"_26074":108046,"_2645":108184},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3146":64487,"_27538":64427,"_19130":108186,"_5":13154,"_26074":108050,"_2645":108187},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3146":64488,"_27538":64427,"_19130":108189,"_5":13154,"_26074":108050,"_2645":108190},[],"Campo de `external_webhook_settings`",{"_3146":64489,"_27538":64427,"_19130":108192,"_5":13154,"_26074":108050,"_2645":108110},[],{"_3146":64490,"_27538":64427,"_19130":108194,"_5":13154,"_26074":108050,"_2645":47649},[],{"_3146":64491,"_27538":64427,"_19130":108196,"_5":13154,"_26074":108050,"_2645":108197},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3146":64492,"_27538":64427,"_19130":108199,"_5":13154,"_26074":108050,"_2645":47655},[],{"_3146":64493,"_27538":64427,"_19130":108201,"_5":13154,"_26074":108050,"_2645":108202},[],"`POST` o `PUT`; `POST` por defecto.",{"_3146":64494,"_27538":64427,"_19130":108204,"_5":13154,"_26074":108050,"_2645":47661},[],{"_3146":64495,"_27538":64427,"_19130":108206,"_5":13154,"_26074":108050,"_2645":108207},[],"Etiqueta usada en los logs del servicio.",{"_3146":64496,"_27538":64427,"_19130":108209,"_5":13154,"_26074":108050,"_2645":47667},[],{"_3146":64497,"_27538":64427,"_19130":108211,"_5":13154,"_26074":108050,"_2645":108212},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3146":64498,"_27538":64427,"_19130":108214,"_5":13154,"_26074":108050,"_2645":47673},[],{"_3146":64499,"_27538":64427,"_19130":108216,"_5":13154,"_26074":108050,"_2645":108217},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3146":64500,"_27538":64427,"_19130":108219,"_5":13154,"_26074":108050,"_2645":47679},[],{"_3146":64501,"_27538":64427,"_19130":108221,"_5":13154,"_26074":108050,"_2645":108222},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3146":64502,"_27538":64427,"_19130":108224,"_5":13154,"_26074":108050,"_2645":47685},[],{"_3146":64503,"_27538":64427,"_19130":108226,"_5":13154,"_26074":108050,"_2645":108227},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3146":64504,"_27538":64427,"_19130":108229,"_5":13154,"_26074":108050,"_2645":47691},[],{"_3146":64505,"_27538":64427,"_19130":108231,"_5":13154,"_26074":108050,"_2645":108232},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3146":64506,"_27538":64427,"_19130":108234,"_5":13154,"_26074":108050,"_2645":47697},[],{"_3146":64507,"_27538":64427,"_19130":108236,"_5":13154,"_26074":108050,"_2645":108237},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3146":64508,"_27538":64427,"_19130":108239,"_5":13154,"_26074":108050,"_2645":108240},[],"Reglas de esa configuración:",{"_3146":64509,"_27538":64427,"_19130":108242,"_5":13154,"_26074":108050,"_2645":108243},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3146":64510,"_27538":64427,"_19130":108245,"_5":13154,"_26074":108050,"_2645":108246},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3146":64511,"_27538":64427,"_19130":108248,"_5":13154,"_26074":108050,"_2645":108249},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3146":64512,"_27538":64427,"_19130":108251,"_5":13154,"_26074":108050,"_2645":108252},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3146":64513,"_27538":64427,"_19130":108254,"_5":13154,"_26074":108050,"_2645":108255},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3146":64514,"_27538":64427,"_19130":108257,"_5":13154,"_26074":108050,"_2645":108258},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3146":64515,"_27538":64427,"_19130":108260,"_5":13154,"_26074":108050,"_2645":108261},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3146":64516,"_27538":64427,"_19130":108263,"_5":13154,"_26074":108050,"_2645":108264},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3146":64517,"_27538":64427,"_19130":108266,"_5":13154,"_26074":108050,"_2645":108267},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3146":64518,"_27538":64427,"_19130":108269,"_5":13154,"_26074":108054,"_2645":108270},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3146":64519,"_27538":64427,"_19130":108272,"_5":13154,"_26074":108058,"_2645":108273},[],"Campo de `settings.reenrollment_settings`",{"_3146":64520,"_27538":64427,"_19130":108275,"_5":13154,"_26074":108058,"_2645":108276},[],"Función",{"_3146":64521,"_27538":64427,"_19130":108278,"_5":13154,"_26074":108058,"_2645":47741},[],{"_3146":64522,"_27538":64427,"_19130":108280,"_5":13154,"_26074":108058,"_2645":108281},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3146":64523,"_27538":64427,"_19130":108283,"_5":13154,"_26074":108058,"_2645":47747},[],{"_3146":64524,"_27538":64427,"_19130":108285,"_5":13154,"_26074":108058,"_2645":108286},[],"Umbral operativo preventivo de monitorización.",{"_3146":64525,"_27538":64427,"_19130":108288,"_5":13154,"_26074":108058,"_2645":47753},[],{"_3146":64526,"_27538":64427,"_19130":108290,"_5":13154,"_26074":108058,"_2645":108291},[],"Umbral operativo crítico de monitorización.",{"_3146":64527,"_27538":64427,"_19130":108293,"_5":13154,"_26074":108058,"_2645":47759},[],{"_3146":64528,"_27538":64427,"_19130":108295,"_5":13154,"_26074":108058,"_2645":108296},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3146":64529,"_27538":64427,"_19130":108298,"_5":13154,"_26074":108058,"_2645":47765},[],{"_3146":64530,"_27538":64427,"_19130":108300,"_5":13154,"_26074":108058,"_2645":108301},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3146":64531,"_27538":64427,"_19130":108303,"_5":13154,"_26074":108058,"_2645":47771},[],{"_3146":64532,"_27538":64427,"_19130":108305,"_5":13154,"_26074":108058,"_2645":108306},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3146":64533,"_27538":64427,"_19130":108308,"_5":13154,"_26074":108058,"_2645":108309},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3146":64534,"_27538":64427,"_19130":108311,"_5":13154,"_26074":108062,"_2645":108312},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3146":64535,"_27538":64427,"_19130":108314,"_5":13154,"_26074":108065,"_2645":105807},[],{"_3146":64536,"_27538":64427,"_19130":108316,"_5":13154,"_26074":108065,"_2645":108317},[],"Qué publica",{"_3146":64537,"_27538":64427,"_19130":108319,"_5":13154,"_26074":108065,"_2645":47788},[],{"_3146":64538,"_27538":64427,"_19130":108321,"_5":13154,"_26074":108065,"_2645":108322},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3146":64539,"_27538":64427,"_19130":108324,"_5":13154,"_26074":108065,"_2645":47794},[],{"_3146":64540,"_27538":64427,"_19130":108326,"_5":13154,"_26074":108065,"_2645":108327},[],"Certificado de la CA emisora seleccionada.",{"_3146":64541,"_27538":64427,"_19130":108329,"_5":13154,"_26074":108065,"_2645":47800},[],{"_3146":64542,"_27538":64427,"_19130":108331,"_5":13154,"_26074":108065,"_2645":108332},[],"Certificados de las CAs elegidas explícitamente.",{"_3146":64543,"_27538":64427,"_19130":108334,"_5":13154,"_26074":108065,"_2645":108335},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3146":64544,"_27538":64427,"_19130":108337,"_5":13154,"_26074":108069,"_2645":108338},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3146":64545,"_27538":64427,"_19130":108340,"_5":13154,"_26074":108069,"_2645":108341},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3146":64546,"_27538":64427,"_19130":108343,"_5":13154,"_26074":108069,"_2645":108344},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3146":64547,"_27538":64427,"_19130":108346,"_5":13154,"_26074":108073,"_2645":108347},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3146":64548,"_27538":64548,"_5":13480,"_2645":108349,"_27881":108350,"_19130":108351,"_26074":64548},"Integra el cliente EST",[44830,106777,47187,107752,107927],[],{"_3146":64549,"_27538":64548,"_19130":108353,"_5":13154,"_26074":64548,"_2645":108354},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3146":64550,"_27538":64548,"_5":27878,"_19130":108356,"_26074":108357,"_2645":105443},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3146":64551,"_27538":64548,"_5":27878,"_19130":108359,"_26074":108360,"_2645":108361},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3146":64552,"_27538":64548,"_5":27878,"_19130":108363,"_26074":108364,"_2645":108365},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3146":64553,"_27538":64548,"_5":27878,"_19130":108367,"_26074":108368,"_2645":108369},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3146":64554,"_27538":64548,"_5":27878,"_19130":108371,"_26074":108372,"_2645":108373},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3146":64555,"_27538":64548,"_5":27878,"_19130":108375,"_26074":108376,"_2645":108377},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3146":64556,"_27538":64548,"_19130":108379,"_5":13154,"_26074":64548,"_2645":108380},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3146":64557,"_27538":64548,"_19130":108382,"_5":13154,"_26074":108357,"_2645":108383},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3146":64558,"_27538":64548,"_19130":108385,"_5":13154,"_26074":108357,"_2645":108386},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3146":64559,"_27538":64548,"_19130":108388,"_5":13154,"_26074":108357,"_2645":108389},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3146":64560,"_27538":64548,"_19130":108391,"_5":13154,"_26074":108360,"_2645":108392},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3146":64561,"_27538":64548,"_19130":108394,"_5":13154,"_26074":108360,"_2645":108395},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3146":64562,"_27538":64548,"_19130":108397,"_5":13154,"_26074":108364,"_2645":108398},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3146":64563,"_27538":64548,"_19130":108400,"_5":13154,"_26074":108364,"_2645":108401},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3146":64564,"_27538":64548,"_19130":108403,"_5":13154,"_26074":108368,"_2645":108404},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3146":64565,"_27538":64548,"_19130":108406,"_5":13154,"_26074":108368,"_2645":108407},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3146":64566,"_27538":64548,"_19130":108409,"_5":13154,"_26074":108372,"_2645":108410},[],"Para el caso de una raíz que emite directamente:",{"_3146":64567,"_27538":64548,"_19130":108412,"_5":13154,"_26074":108372,"_2645":108413},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3146":64568,"_27538":64548,"_19130":108415,"_5":13154,"_26074":108372,"_2645":108416},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3146":64569,"_27538":64548,"_19130":108418,"_5":13154,"_26074":108376,"_2645":108419},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3146":64570,"_27538":64570,"_5":13480,"_2645":108421,"_27881":108422,"_19130":108423,"_26074":64570},"Referencia EST",[44830,106777,47187,107752,107927],[],{"_3146":64571,"_27538":64570,"_19130":108425,"_5":13154,"_26074":64570,"_2645":108426},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3146":64572,"_27538":64570,"_5":27878,"_19130":108428,"_26074":108429,"_2645":108430},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3146":64573,"_27538":64570,"_5":27878,"_19130":108432,"_26074":108433,"_2645":20791},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3146":64574,"_27538":64570,"_5":27878,"_19130":108435,"_26074":108436,"_2645":23836},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3146":64575,"_27538":64570,"_5":27878,"_19130":108438,"_26074":108439,"_2645":23843},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3146":64576,"_27538":64570,"_5":27878,"_19130":108441,"_26074":108442,"_2645":23189},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3146":64577,"_27538":64570,"_5":27878,"_19130":108444,"_26074":108445,"_2645":108446},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3146":64578,"_27538":64570,"_5":27878,"_19130":108448,"_26074":108449,"_2645":108450},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3146":64579,"_27538":64570,"_5":27878,"_19130":108452,"_26074":108453,"_2645":108454},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3146":64580,"_27538":64570,"_19130":108456,"_5":13154,"_26074":64570,"_2645":108457},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3146":64581,"_27538":64570,"_19130":108459,"_5":13154,"_26074":108429,"_2645":108460},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3146":64582,"_27538":64570,"_19130":108462,"_5":13154,"_26074":108429,"_2645":106568},[],{"_3146":64583,"_27538":64570,"_19130":108464,"_5":13154,"_26074":108429,"_2645":108465},[],"Método",{"_3146":64584,"_27538":64570,"_19130":108467,"_5":13154,"_26074":108429,"_2645":108468},[],"Autenticación y condición",{"_3146":64585,"_27538":64570,"_19130":108470,"_5":13154,"_26074":108429,"_2645":47943},[],{"_3146":64586,"_27538":64570,"_19130":108472,"_5":13154,"_26074":108429,"_2645":47946},[],{"_3146":64587,"_27538":64570,"_19130":108474,"_5":13154,"_26074":108429,"_2645":108475},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3146":64588,"_27538":64570,"_19130":108477,"_5":13154,"_26074":108429,"_2645":47952},[],{"_3146":64589,"_27538":64570,"_19130":108479,"_5":13154,"_26074":108429,"_2645":47955},[],{"_3146":64590,"_27538":64570,"_19130":108481,"_5":13154,"_26074":108429,"_2645":108482},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3146":64591,"_27538":64570,"_19130":108484,"_5":13154,"_26074":108429,"_2645":47961},[],{"_3146":64592,"_27538":64570,"_19130":108486,"_5":13154,"_26074":108429,"_2645":47955},[],{"_3146":64593,"_27538":64570,"_19130":108488,"_5":13154,"_26074":108429,"_2645":108489},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3146":64594,"_27538":64570,"_19130":108491,"_5":13154,"_26074":108429,"_2645":47969},[],{"_3146":64595,"_27538":64570,"_19130":108493,"_5":13154,"_26074":108429,"_2645":47955},[],{"_3146":64596,"_27538":64570,"_19130":108495,"_5":13154,"_26074":108429,"_2645":108496},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3146":64597,"_27538":64570,"_19130":108498,"_5":13154,"_26074":108429,"_2645":108499},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3146":64598,"_27538":64570,"_19130":108501,"_5":13154,"_26074":108433,"_2645":108502},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3146":64599,"_27538":64570,"_19130":108504,"_5":13154,"_26074":108433,"_2645":108505},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3146":64600,"_27538":64570,"_19130":108507,"_5":13154,"_26074":108436,"_2645":108508},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3146":64601,"_27538":64570,"_19130":108510,"_5":13154,"_26074":108436,"_2645":108511},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3146":64602,"_27538":64570,"_19130":108513,"_5":13154,"_26074":108439,"_2645":108514},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3146":64603,"_27538":64570,"_19130":108516,"_5":13154,"_26074":108439,"_2645":108517},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3146":64604,"_27538":64570,"_19130":108519,"_5":13154,"_26074":108442,"_2645":108520},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3146":64605,"_27538":64570,"_19130":108522,"_5":13154,"_26074":108442,"_2645":108523},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3146":64606,"_27538":64570,"_19130":108525,"_5":13154,"_26074":108445,"_2645":108526},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3146":64607,"_27538":64570,"_19130":108528,"_5":13154,"_26074":108445,"_2645":108529},[],"Parte",{"_3146":64608,"_27538":64570,"_19130":108531,"_5":13154,"_26074":108445,"_2645":108532},[],"Contenido tras decodificar su Base64",{"_3146":64609,"_27538":64570,"_19130":108534,"_5":13154,"_26074":108445,"_2645":48013},[],{"_3146":64610,"_27538":64570,"_19130":108536,"_5":13154,"_26074":108445,"_2645":108537},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3146":64611,"_27538":64570,"_19130":108539,"_5":13154,"_26074":108445,"_2645":48019},[],{"_3146":64612,"_27538":64570,"_19130":108541,"_5":13154,"_26074":108445,"_2645":108542},[],"PKCS#7 DER con el certificado emitido.",{"_3146":64613,"_27538":64570,"_19130":108544,"_5":13154,"_26074":108445,"_2645":108545},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3146":64614,"_27538":64570,"_19130":108547,"_5":13154,"_26074":108449,"_2645":108548},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3146":64615,"_27538":64570,"_19130":108550,"_5":13154,"_26074":108449,"_2645":108551},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3146":64616,"_27538":64570,"_19130":108553,"_5":13154,"_26074":108449,"_2645":108554},[],"Convierte y comprueba el resultado:",{"_3146":64617,"_27538":64570,"_19130":108556,"_5":13154,"_26074":108449,"_2645":108557},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3146":64618,"_27538":64570,"_19130":108559,"_5":13154,"_26074":108453,"_2645":108560},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3146":64619,"_27538":64570,"_19130":108562,"_5":13154,"_26074":108453,"_2645":108563},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3146":64620,"_27538":64620,"_5":13480,"_2645":107927,"_27881":108565,"_19130":108566,"_26074":64620},[44830,106777,47187,107752,107927],[],{"_3146":64621,"_27538":64620,"_19130":108568,"_5":13154,"_26074":64620,"_2645":108569},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3146":64622,"_27538":64620,"_5":27878,"_19130":108571,"_26074":108572,"_2645":108573},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3146":64623,"_27538":64620,"_5":27878,"_19130":108575,"_26074":108576,"_2645":108577},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3146":64624,"_27538":64620,"_5":27878,"_19130":108579,"_26074":108580,"_2645":108581},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3146":64625,"_27538":64620,"_5":27878,"_19130":108583,"_26074":108584,"_2645":108585},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3146":64626,"_27538":64620,"_19130":108587,"_5":13154,"_26074":64620,"_2645":108588},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3146":64627,"_27538":64620,"_19130":108590,"_5":13154,"_26074":108572,"_2645":108591},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3146":64628,"_27538":64620,"_19130":108593,"_5":13154,"_26074":108572,"_2645":108594},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3146":64629,"_27538":64620,"_19130":108596,"_5":13154,"_26074":108572,"_2645":108597},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3146":64630,"_27538":64620,"_19130":108599,"_5":13154,"_26074":108572,"_2645":108600},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3146":64631,"_27538":64620,"_19130":108602,"_5":13154,"_26074":108572,"_2645":108603},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3146":64632,"_27538":64620,"_19130":108605,"_5":13154,"_26074":108572,"_2645":108606},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3146":64633,"_27538":64620,"_19130":108608,"_5":13154,"_26074":108576,"_2645":108609},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3146":64634,"_27538":64620,"_19130":108611,"_5":13154,"_26074":108576,"_2645":108612},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3146":64635,"_27538":64620,"_19130":108614,"_5":13154,"_26074":108576,"_2645":108615},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3146":64636,"_27538":64620,"_19130":108617,"_5":13154,"_26074":108576,"_2645":108618},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3146":64637,"_27538":64620,"_19130":108620,"_5":13154,"_26074":108580,"_2645":108621},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3146":64638,"_27538":64620,"_19130":108623,"_5":13154,"_26074":108580,"_2645":108624},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3146":64639,"_27538":64620,"_19130":108626,"_5":13154,"_26074":108580,"_2645":108627},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3146":64640,"_27538":64620,"_19130":108629,"_5":13154,"_26074":108580,"_2645":108630},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3146":64641,"_27538":64620,"_19130":108632,"_5":13154,"_26074":108584,"_2645":108633},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3146":64642,"_27538":64620,"_19130":108635,"_5":13154,"_26074":108584,"_2645":108636},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3146":64643,"_27538":64643,"_5":13480,"_2645":108638,"_27881":108639,"_19130":108640,"_26074":64643},"Estrategias de aprovisionamiento",[44830,106777,47187,107752,107927],[],{"_3146":64644,"_27538":64643,"_19130":108642,"_5":13154,"_26074":64643,"_2645":108643},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3146":64645,"_27538":64643,"_5":27878,"_19130":108645,"_26074":108646,"_2645":108647},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3146":64646,"_27538":64643,"_5":27878,"_19130":108649,"_26074":108650,"_2645":108651},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3146":64647,"_27538":64643,"_5":27878,"_19130":108653,"_26074":108654,"_2645":108655},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3146":64648,"_27538":64643,"_5":27878,"_19130":108657,"_26074":108658,"_2645":108659},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3146":64649,"_27538":64643,"_5":27878,"_19130":108661,"_26074":108662,"_2645":108663},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3146":64650,"_27538":64643,"_19130":108665,"_5":13154,"_26074":64643,"_2645":108666},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3146":64651,"_27538":64643,"_19130":108668,"_5":13154,"_26074":108646,"_2645":108669},[],"Recorrido",{"_3146":64652,"_27538":64643,"_19130":108671,"_5":13154,"_26074":108646,"_2645":108672},[],"Cuándo existe el dispositivo",{"_3146":64653,"_27538":64643,"_19130":108674,"_5":13154,"_26074":108646,"_2645":108675},[],"Qué compruebas",{"_3146":64654,"_27538":64643,"_19130":108677,"_5":13154,"_26074":108646,"_2645":108678},[],"Asignación manual",{"_3146":64655,"_27538":64643,"_19130":108680,"_5":13154,"_26074":108646,"_2645":108681},[],"El operador lo crea antes de asociar un certificado.",{"_3146":64656,"_27538":64643,"_19130":108683,"_5":13154,"_26074":108646,"_2645":108684},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3146":64657,"_27538":64643,"_19130":108686,"_5":13154,"_26074":108646,"_2645":108687},[],"EST con `JITP`",{"_3146":64658,"_27538":64643,"_19130":108689,"_5":13154,"_26074":108646,"_2645":108690},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3146":64659,"_27538":64643,"_19130":108692,"_5":13154,"_26074":108646,"_2645":108693},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3146":64660,"_27538":64643,"_19130":108695,"_5":13154,"_26074":108646,"_2645":108696},[],"EST con `PRE_REGISTRATION`",{"_3146":64661,"_27538":64643,"_19130":108698,"_5":13154,"_26074":108646,"_2645":108699},[],"Debe existir antes de `/simpleenroll`.",{"_3146":64662,"_27538":64643,"_19130":108701,"_5":13154,"_26074":108646,"_2645":108702},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3146":64663,"_27538":64643,"_19130":108704,"_5":13154,"_26074":108646,"_2645":108705},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3146":64664,"_27538":64643,"_19130":108707,"_5":13154,"_26074":108646,"_2645":108708},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3146":64665,"_27538":64643,"_19130":108710,"_5":13154,"_26074":108650,"_2645":108711},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3146":64666,"_27538":64643,"_19130":108713,"_5":13154,"_26074":108650,"_2645":108714},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3146":64667,"_27538":64643,"_19130":108716,"_5":13154,"_26074":108650,"_2645":108717},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3146":64668,"_27538":64643,"_19130":108719,"_5":13154,"_26074":108654,"_2645":108720},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3146":64669,"_27538":64643,"_19130":108722,"_5":13154,"_26074":108654,"_2645":108723},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3146":64670,"_27538":64643,"_19130":108725,"_5":13154,"_26074":108654,"_2645":108726},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3146":64671,"_27538":64643,"_19130":108728,"_5":13154,"_26074":108654,"_2645":108729},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3146":64672,"_27538":64643,"_19130":108731,"_5":13154,"_26074":108654,"_2645":108732},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3146":64673,"_27538":64643,"_19130":108734,"_5":13154,"_26074":108654,"_2645":108735},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3146":64674,"_27538":64643,"_19130":108737,"_5":13154,"_26074":108658,"_2645":105807},[],{"_3146":64675,"_27538":64643,"_19130":108739,"_5":13154,"_26074":108658,"_2645":108740},[],"Material que atraviesa EST",{"_3146":64676,"_27538":64643,"_19130":108742,"_5":13154,"_26074":108658,"_2645":108743},[],"Clave generada por el dispositivo",{"_3146":64677,"_27538":64643,"_19130":108745,"_5":13154,"_26074":108658,"_2645":108746},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3146":64678,"_27538":64643,"_19130":108748,"_5":13154,"_26074":108658,"_2645":108749},[],"Clave ya disponible en el dispositivo",{"_3146":64679,"_27538":64643,"_19130":108751,"_5":13154,"_26074":108658,"_2645":108752},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3146":64680,"_27538":64643,"_19130":108754,"_5":13154,"_26074":108658,"_2645":47506},[],{"_3146":64681,"_27538":64643,"_19130":108756,"_5":13154,"_26074":108658,"_2645":108757},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3146":64682,"_27538":64643,"_19130":108759,"_5":13154,"_26074":108658,"_2645":108760},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3146":64683,"_27538":64643,"_19130":108762,"_5":13154,"_26074":108662,"_2645":108763},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3146":64684,"_27538":64684,"_5":13480,"_2645":108765,"_27881":108766,"_19130":108767,"_26074":64684},"Renovación y recuperación",[44830,106777,47187,107752,107927],[],{"_3146":64685,"_27538":64684,"_19130":108769,"_5":13154,"_26074":64684,"_2645":108770},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3146":64686,"_27538":64684,"_5":27878,"_19130":108772,"_26074":108773,"_2645":108774},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3146":64687,"_27538":64684,"_5":27878,"_19130":108776,"_26074":108777,"_2645":108778},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3146":64688,"_27538":64684,"_5":27878,"_19130":108780,"_26074":108781,"_2645":108782},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3146":64689,"_27538":64684,"_5":27878,"_19130":108784,"_26074":108785,"_2645":108786},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3146":64690,"_27538":64684,"_5":27878,"_19130":108788,"_26074":108789,"_2645":108790},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3146":64691,"_27538":64684,"_19130":108792,"_5":13154,"_26074":64684,"_2645":108793},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3146":64692,"_27538":64684,"_19130":108795,"_5":13154,"_26074":108773,"_2645":108796},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3146":64693,"_27538":64684,"_19130":108798,"_5":13154,"_26074":108773,"_2645":108799},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3146":64694,"_27538":64684,"_19130":108801,"_5":13154,"_26074":108773,"_2645":108802},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3146":64695,"_27538":64684,"_19130":108804,"_5":13154,"_26074":108773,"_2645":108805},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3146":64696,"_27538":64684,"_19130":108807,"_5":13154,"_26074":108777,"_2645":108808},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3146":64697,"_27538":64684,"_19130":108810,"_5":13154,"_26074":108777,"_2645":108811},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3146":64698,"_27538":64684,"_19130":108813,"_5":13154,"_26074":108781,"_2645":108814},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3146":64699,"_27538":64684,"_19130":108816,"_5":13154,"_26074":108781,"_2645":108817},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3146":64700,"_27538":64684,"_19130":108819,"_5":13154,"_26074":108781,"_2645":108820},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3146":64701,"_27538":64684,"_19130":108822,"_5":13154,"_26074":108785,"_2645":108823},[],"Situación",{"_3146":64702,"_27538":64684,"_19130":108825,"_5":13154,"_26074":108785,"_2645":108826},[],"Procedimiento",{"_3146":64703,"_27538":64684,"_19130":108828,"_5":13154,"_26074":108785,"_2645":108829},[],"Certificado vigente, fuera de ventana",{"_3146":64704,"_27538":64684,"_19130":108831,"_5":13154,"_26074":108785,"_2645":108832},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3146":64705,"_27538":64684,"_19130":108834,"_5":13154,"_26074":108785,"_2645":108835},[],"Certificado vencido, clave disponible",{"_3146":64706,"_27538":64684,"_19130":108837,"_5":13154,"_26074":108785,"_2645":108838},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3146":64707,"_27538":64684,"_19130":108840,"_5":13154,"_26074":108785,"_2645":108841},[],"Renovación por webhook o `NO_AUTH`",{"_3146":64708,"_27538":64684,"_19130":108843,"_5":13154,"_26074":108785,"_2645":108844},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3146":64709,"_27538":64684,"_19130":108846,"_5":13154,"_26074":108785,"_2645":108847},[],"Clave perdida o inaccesible",{"_3146":64710,"_27538":64684,"_19130":108849,"_5":13154,"_26074":108785,"_2645":108850},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3146":64711,"_27538":64684,"_19130":108852,"_5":13154,"_26074":108785,"_2645":108853},[],"Identidad actual revocada",{"_3146":64712,"_27538":64684,"_19130":108855,"_5":13154,"_26074":108785,"_2645":108856},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3146":64713,"_27538":64684,"_19130":108858,"_5":13154,"_26074":108785,"_2645":108859},[],"Dispositivo sin identidad",{"_3146":64714,"_27538":64684,"_19130":108861,"_5":13154,"_26074":108785,"_2645":108862},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3146":64715,"_27538":64684,"_19130":108864,"_5":13154,"_26074":108785,"_2645":108865},[],"Dispositivo retirado",{"_3146":64716,"_27538":64684,"_19130":108867,"_5":13154,"_26074":108785,"_2645":108868},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3146":64717,"_27538":64684,"_19130":108870,"_5":13154,"_26074":108785,"_2645":108871},[],"Timeout, HTTP 500 o fallo de instalación",{"_3146":64718,"_27538":64684,"_19130":108873,"_5":13154,"_26074":108785,"_2645":108874},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3146":64719,"_27538":64684,"_19130":108876,"_5":13154,"_26074":108789,"_2645":108877},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3146":64720,"_27538":64684,"_19130":108879,"_5":13154,"_26074":108789,"_2645":108880},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3146":64721,"_27538":64721,"_5":13480,"_2645":108882,"_27881":108883,"_19130":108884,"_26074":64721},"Diagnóstico de enrolamiento",[44830,106777,47187,107752,107927],[],{"_3146":64722,"_27538":64721,"_19130":108886,"_5":13154,"_26074":64721,"_2645":108887},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3146":64723,"_27538":64721,"_5":27878,"_19130":108889,"_26074":108890,"_2645":108891},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3146":64724,"_27538":64721,"_5":27878,"_19130":108893,"_26074":108894,"_2645":108895},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3146":64725,"_27538":64721,"_5":27878,"_19130":108897,"_26074":108898,"_2645":108454},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3146":64726,"_27538":64721,"_5":27878,"_19130":108900,"_26074":108901,"_2645":108902},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3146":64727,"_27538":64721,"_19130":108904,"_5":13154,"_26074":64721,"_2645":108905},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3146":64728,"_27538":64721,"_19130":108907,"_5":13154,"_26074":108894,"_2645":108908},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3146":64729,"_27538":64721,"_19130":108910,"_5":13154,"_26074":108894,"_2645":108911},[],"Síntoma o mensaje",{"_3146":64730,"_27538":64721,"_19130":108913,"_5":13154,"_26074":108894,"_2645":108914},[],"Qué revisar",{"_3146":64731,"_27538":64721,"_19130":108916,"_5":13154,"_26074":108894,"_2645":108917},[],"curl rechaza TLS, nombre o emisor",{"_3146":64732,"_27538":64721,"_19130":108919,"_5":13154,"_26074":108894,"_2645":108920},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3146":64733,"_27538":64721,"_19130":108922,"_5":13154,"_26074":108894,"_2645":108923},[],"404 o APS ausente",{"_3146":64734,"_27538":64721,"_19130":108925,"_5":13154,"_26074":108894,"_2645":108926},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3146":64735,"_27538":64721,"_19130":108928,"_5":13154,"_26074":108894,"_2645":108929},[],"400, error de CSR o formato",{"_3146":64736,"_27538":64721,"_19130":108931,"_5":13154,"_26074":108894,"_2645":108932},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3146":64737,"_27538":64721,"_19130":108934,"_5":13154,"_26074":108894,"_2645":108935},[],"Credencial ausente o certificado no válido",{"_3146":64738,"_27538":64721,"_19130":108937,"_5":13154,"_26074":108894,"_2645":108938},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3146":64739,"_27538":64721,"_19130":108940,"_5":13154,"_26074":108894,"_2645":108941},[],"Webhook deniega, expira o responde sin autorización",{"_3146":64740,"_27538":64721,"_19130":108943,"_5":13154,"_26074":108894,"_2645":108944},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3146":64741,"_27538":64721,"_19130":108946,"_5":13154,"_26074":108894,"_2645":48426},[],{"_3146":64742,"_27538":64721,"_19130":108948,"_5":13154,"_26074":108894,"_2645":108949},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3146":64743,"_27538":64721,"_19130":108951,"_5":13154,"_26074":108894,"_2645":48432},[],{"_3146":64744,"_27538":64721,"_19130":108953,"_5":13154,"_26074":108894,"_2645":108954},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3146":64745,"_27538":64721,"_19130":108956,"_5":13154,"_26074":108894,"_2645":48438},[],{"_3146":64746,"_27538":64721,"_19130":108958,"_5":13154,"_26074":108894,"_2645":108959},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3146":64747,"_27538":64721,"_19130":108961,"_5":13154,"_26074":108894,"_2645":48444},[],{"_3146":64748,"_27538":64721,"_19130":108963,"_5":13154,"_26074":108894,"_2645":108964},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3146":64749,"_27538":64721,"_19130":108966,"_5":13154,"_26074":108894,"_2645":48450},[],{"_3146":64750,"_27538":64721,"_19130":108968,"_5":13154,"_26074":108894,"_2645":108969},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3146":64751,"_27538":64721,"_19130":108971,"_5":13154,"_26074":108894,"_2645":108972},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3146":64752,"_27538":64721,"_19130":108974,"_5":13154,"_26074":108894,"_2645":108975},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3146":64753,"_27538":64721,"_19130":108977,"_5":13154,"_26074":108894,"_2645":108978},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3146":64754,"_27538":64721,"_19130":108980,"_5":13154,"_26074":108894,"_2645":108981},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3146":64755,"_27538":64721,"_19130":108983,"_5":13154,"_26074":108894,"_2645":48468},[],{"_3146":64756,"_27538":64721,"_19130":108985,"_5":13154,"_26074":108894,"_2645":108986},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3146":64757,"_27538":64721,"_19130":108988,"_5":13154,"_26074":108894,"_2645":48474},[],{"_3146":64758,"_27538":64721,"_19130":108990,"_5":13154,"_26074":108894,"_2645":108991},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3146":64759,"_27538":64721,"_19130":108993,"_5":13154,"_26074":108894,"_2645":108994},[],"DMS propietario distinto",{"_3146":64760,"_27538":64721,"_19130":108996,"_5":13154,"_26074":108894,"_2645":108997},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3146":64761,"_27538":64721,"_19130":108999,"_5":13154,"_26074":108894,"_2645":48486},[],{"_3146":64762,"_27538":64721,"_19130":109001,"_5":13154,"_26074":108894,"_2645":109002},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3146":64763,"_27538":64721,"_19130":109004,"_5":13154,"_26074":108894,"_2645":48492},[],{"_3146":64764,"_27538":64721,"_19130":109006,"_5":13154,"_26074":108894,"_2645":109007},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3146":64765,"_27538":64721,"_19130":109009,"_5":13154,"_26074":108894,"_2645":109010},[],"Certificado actual revocado",{"_3146":64766,"_27538":64721,"_19130":109012,"_5":13154,"_26074":108894,"_2645":109013},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3146":64767,"_27538":64721,"_19130":109015,"_5":13154,"_26074":108894,"_2645":109016},[],"Error de CA, perfil o firma",{"_3146":64768,"_27538":64721,"_19130":109018,"_5":13154,"_26074":108894,"_2645":109019},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3146":64769,"_27538":64721,"_19130":109021,"_5":13154,"_26074":108894,"_2645":109022},[],"HTTP 200 sin conexión del dispositivo",{"_3146":64770,"_27538":64721,"_19130":109024,"_5":13154,"_26074":108894,"_2645":109025},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3146":64771,"_27538":64721,"_19130":109027,"_5":13154,"_26074":108894,"_2645":109028},[],"Timeout o error después de emitir",{"_3146":64772,"_27538":64721,"_19130":109030,"_5":13154,"_26074":108894,"_2645":109031},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3146":64773,"_27538":64721,"_19130":109033,"_5":13154,"_26074":108898,"_2645":109034},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3146":64774,"_27538":64721,"_19130":109036,"_5":13154,"_26074":108898,"_2645":109037},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3146":64775,"_27538":64721,"_19130":109039,"_5":13154,"_26074":108901,"_2645":109040},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3146":64776,"_27538":64721,"_19130":109042,"_5":13154,"_26074":108901,"_2645":109043},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3146":64777,"_27538":64721,"_19130":109045,"_5":13154,"_26074":108901,"_2645":109046},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3146":64778,"_27538":64721,"_19130":109048,"_5":13154,"_26074":108901,"_2645":109049},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3146":64779,"_27538":64721,"_19130":109051,"_5":13154,"_26074":108901,"_2645":109052},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3146":64780,"_27538":64721,"_19130":109054,"_5":13154,"_26074":108901,"_2645":109055},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3146":64781,"_27538":64721,"_19130":109057,"_5":13154,"_26074":108901,"_2645":109058},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3146":64782,"_27538":64782,"_5":13480,"_2645":109060,"_27881":109061,"_19130":109062,"_26074":64782},"Distribución y actualización de confianza",[44830,106777,47187,107752,107927],[],{"_3146":64783,"_27538":64782,"_19130":109064,"_5":13154,"_26074":64782,"_2645":109065},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3146":64784,"_27538":64782,"_5":27878,"_19130":109067,"_26074":109068,"_2645":109069},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3146":64785,"_27538":64782,"_5":27878,"_19130":109071,"_26074":109072,"_2645":109073},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3146":64786,"_27538":64782,"_5":27878,"_19130":109075,"_26074":109076,"_2645":109077},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3146":64787,"_27538":64782,"_5":27878,"_19130":109079,"_26074":109080,"_2645":109081},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3146":64788,"_27538":64782,"_5":27878,"_19130":109083,"_26074":109084,"_2645":109085},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3146":64789,"_27538":64782,"_19130":109087,"_5":13154,"_26074":64782,"_2645":109088},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3146":64790,"_27538":64782,"_19130":109090,"_5":13154,"_26074":109068,"_2645":109091},[],"Relación",{"_3146":64791,"_27538":64782,"_19130":109093,"_5":13154,"_26074":109068,"_2645":109094},[],"Material que prepara el responsable",{"_3146":64792,"_27538":64782,"_19130":109096,"_5":13154,"_26074":109068,"_2645":109097},[],"Dispositivo → servidor EST",{"_3146":64793,"_27538":64782,"_19130":109099,"_5":13154,"_26074":109068,"_2645":109100},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3146":64794,"_27538":64782,"_19130":109102,"_5":13154,"_26074":109068,"_2645":109103},[],"DMS → solicitante",{"_3146":64795,"_27538":64782,"_19130":109105,"_5":13154,"_26074":109068,"_2645":109106},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3146":64796,"_27538":64782,"_19130":109108,"_5":13154,"_26074":109068,"_2645":109109},[],"Consumidor → dispositivo",{"_3146":64797,"_27538":64782,"_19130":109111,"_5":13154,"_26074":109068,"_2645":109112},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3146":64798,"_27538":64782,"_19130":109114,"_5":13154,"_26074":109068,"_2645":109115},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3146":64799,"_27538":64782,"_19130":109117,"_5":13154,"_26074":109072,"_2645":109118},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3146":64800,"_27538":64782,"_19130":109120,"_5":13154,"_26074":109072,"_2645":109121},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3146":64801,"_27538":64782,"_19130":109123,"_5":13154,"_26074":109076,"_2645":109124},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3146":64802,"_27538":64782,"_19130":109126,"_5":13154,"_26074":109076,"_2645":109127},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3146":64803,"_27538":64782,"_19130":109129,"_5":13154,"_26074":109076,"_2645":109130},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3146":64804,"_27538":64782,"_19130":109132,"_5":13154,"_26074":109076,"_2645":109133},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3146":64805,"_27538":64782,"_19130":109135,"_5":13154,"_26074":109076,"_2645":109136},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3146":64806,"_27538":64782,"_19130":109138,"_5":13154,"_26074":109076,"_2645":109139},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3146":64807,"_27538":64782,"_19130":109141,"_5":13154,"_26074":109080,"_2645":109142},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3146":64808,"_27538":64782,"_19130":109144,"_5":13154,"_26074":109080,"_2645":109145},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3146":64809,"_27538":64782,"_19130":109147,"_5":13154,"_26074":109080,"_2645":109148},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3146":64810,"_27538":64782,"_19130":109150,"_5":13154,"_26074":109084,"_2645":109151},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3146":64811,"_27538":64811,"_5":13480,"_2645":48641,"_27881":109153,"_19130":109155,"_26074":64811},[44830,106777,47187,107752,109154],"Integraciones",[],{"_3146":64812,"_27538":64811,"_19130":109157,"_5":13154,"_26074":64811,"_2645":109158},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3146":64813,"_27538":64811,"_5":27878,"_19130":109160,"_26074":109161,"_2645":109162},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3146":64814,"_27538":64811,"_5":27878,"_19130":109164,"_26074":109165,"_2645":109166},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3146":64815,"_27538":64811,"_5":27878,"_19130":109168,"_26074":109169,"_2645":109170},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3146":64816,"_27538":64811,"_5":27878,"_19130":109172,"_26074":109173,"_2645":109174},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3146":64817,"_27538":64811,"_5":27878,"_19130":109176,"_26074":109177,"_2645":109178},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3146":64818,"_27538":64811,"_5":27878,"_19130":109180,"_26074":109181,"_2645":109182},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3146":64819,"_27538":64811,"_5":27878,"_19130":109184,"_26074":109185,"_2645":48675},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3146":64820,"_27538":64811,"_5":27878,"_19130":109187,"_26074":109188,"_2645":48679},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3146":64821,"_27538":64811,"_5":27878,"_19130":109190,"_26074":109191,"_2645":109192},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3146":64822,"_27538":64811,"_5":27878,"_19130":109194,"_26074":109195,"_2645":109196},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3146":64823,"_27538":64811,"_5":27878,"_19130":109198,"_26074":109199,"_2645":109200},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3146":64824,"_27538":64811,"_5":27878,"_19130":109202,"_26074":109203,"_2645":109204},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3146":64825,"_27538":64811,"_5":27878,"_19130":109206,"_26074":109207,"_2645":109208},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3146":64826,"_27538":64811,"_5":27878,"_19130":109210,"_26074":109211,"_2645":109212},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3146":64827,"_27538":64811,"_5":27878,"_19130":109214,"_26074":109215,"_2645":109216},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3146":64828,"_27538":64811,"_5":27878,"_19130":109218,"_26074":109219,"_2645":109220},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3146":64829,"_27538":64811,"_5":27878,"_19130":109222,"_26074":109223,"_2645":109224},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3146":64830,"_27538":64811,"_5":27878,"_19130":109226,"_26074":109227,"_2645":109228},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3146":64831,"_27538":64811,"_5":27878,"_19130":109230,"_26074":109231,"_2645":109232},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3146":64832,"_27538":64811,"_5":27878,"_19130":109234,"_26074":109235,"_2645":109236},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3146":64833,"_27538":64811,"_19130":109238,"_5":13154,"_26074":64811,"_2645":109239},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3146":64834,"_27538":64811,"_19130":109241,"_5":13154,"_26074":64811,"_2645":109242},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3146":64835,"_27538":64811,"_19130":109244,"_5":13154,"_26074":64811,"_2645":109245},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3146":64836,"_27538":64811,"_19130":109247,"_5":13154,"_26074":109161,"_2645":109248},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3146":64837,"_27538":64811,"_19130":109250,"_5":13154,"_26074":109161,"_2645":109251},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3146":64838,"_27538":64811,"_19130":109253,"_5":13154,"_26074":109161,"_2645":109254},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3146":64839,"_27538":64811,"_19130":109256,"_5":13154,"_26074":109161,"_2645":109257},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3146":64840,"_27538":64811,"_19130":109259,"_5":13154,"_26074":109165,"_2645":109260},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3146":64841,"_27538":64811,"_19130":109262,"_5":13154,"_26074":109169,"_2645":109263},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3146":64842,"_27538":64811,"_19130":109265,"_5":13154,"_26074":109169,"_2645":109266},[],"Acción IAM",{"_3146":64843,"_27538":64811,"_19130":109268,"_5":13154,"_26074":109169,"_2645":105813},[],{"_3146":64844,"_27538":64811,"_19130":109270,"_5":13154,"_26074":109169,"_2645":48762},[],{"_3146":64845,"_27538":64811,"_19130":109272,"_5":13154,"_26074":109169,"_2645":109273},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3146":64846,"_27538":64811,"_19130":109275,"_5":13154,"_26074":109169,"_2645":48768},[],{"_3146":64847,"_27538":64811,"_19130":109277,"_5":13154,"_26074":109169,"_2645":109278},[],"Registrar la CA en AWS IoT",{"_3146":64848,"_27538":64811,"_19130":109280,"_5":13154,"_26074":109169,"_2645":48774},[],{"_3146":64849,"_27538":64811,"_19130":109282,"_5":13154,"_26074":109169,"_2645":109283},[],"Consultar el estado del registro de la CA",{"_3146":64850,"_27538":64811,"_19130":109285,"_5":13154,"_26074":109169,"_2645":48780},[],{"_3146":64851,"_27538":64811,"_19130":109287,"_5":13154,"_26074":109169,"_2645":109288},[],"Crear o actualizar Things en IoT Core",{"_3146":64852,"_27538":64811,"_19130":109290,"_5":13154,"_26074":109169,"_2645":48786},[],{"_3146":64853,"_27538":64811,"_19130":109292,"_5":13154,"_26074":109169,"_2645":109293},[],"Aprovisionar Things mediante plantilla",{"_3146":64854,"_27538":64811,"_19130":109295,"_5":13154,"_26074":109169,"_2645":48792},[],{"_3146":64855,"_27538":64811,"_19130":109297,"_5":13154,"_26074":109169,"_2645":109298},[],"Registrar certificados de dispositivo",{"_3146":64856,"_27538":64811,"_19130":109300,"_5":13154,"_26074":109169,"_2645":48798},[],{"_3146":64857,"_27538":64811,"_19130":109302,"_5":13154,"_26074":109169,"_2645":109303},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3146":64858,"_27538":64811,"_19130":109305,"_5":13154,"_26074":109169,"_2645":48804},[],{"_3146":64859,"_27538":64811,"_19130":109307,"_5":13154,"_26074":109169,"_2645":109308},[],"Crear y adjuntar políticas IoT",{"_3146":64860,"_27538":64811,"_19130":109310,"_5":13154,"_26074":109169,"_2645":48810},[],{"_3146":64861,"_27538":64811,"_19130":109312,"_5":13154,"_26074":109169,"_2645":109313},[],"Gestionar grupos de Things",{"_3146":64862,"_27538":64811,"_19130":109315,"_5":13154,"_26074":109169,"_2645":48816},[],{"_3146":64863,"_27538":64811,"_19130":109317,"_5":13154,"_26074":109169,"_2645":109318},[],"Crear plantillas JITP",{"_3146":64864,"_27538":64811,"_19130":109320,"_5":13154,"_26074":109169,"_2645":48822},[],{"_3146":64865,"_27538":64811,"_19130":109322,"_5":13154,"_26074":109169,"_2645":109323},[],"Leer y escribir el Device Shadow",{"_3146":64866,"_27538":64811,"_19130":109325,"_5":13154,"_26074":109169,"_2645":109326},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3146":64867,"_27538":64811,"_19130":109328,"_5":13154,"_26074":109173,"_2645":109329},[],"Parámetro",{"_3146":64868,"_27538":64811,"_19130":109331,"_5":13154,"_26074":109173,"_2645":109332},[],"Tipo",{"_3146":64869,"_27538":64811,"_19130":109334,"_5":13154,"_26074":109173,"_2645":109335},[],"Requerido",{"_3146":64870,"_27538":64811,"_19130":109337,"_5":13154,"_26074":109173,"_2645":109338},[],"Descripción",{"_3146":64871,"_27538":64811,"_19130":109340,"_5":13154,"_26074":109173,"_2645":48843},[],{"_3146":64872,"_27538":64811,"_19130":109342,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64873,"_27538":64811,"_19130":109344,"_5":13154,"_26074":109173,"_2645":109345},[],"Sí",{"_3146":64874,"_27538":64811,"_19130":109347,"_5":13154,"_26074":109173,"_2645":109348},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3146":64875,"_27538":64811,"_19130":109350,"_5":13154,"_26074":109173,"_2645":48854},[],{"_3146":64876,"_27538":64811,"_19130":109352,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64877,"_27538":64811,"_19130":109354,"_5":13154,"_26074":109173,"_2645":109345},[],{"_3146":64878,"_27538":64811,"_19130":109356,"_5":13154,"_26074":109173,"_2645":109357},[],"Región AWS donde opera el conector.",{"_3146":64879,"_27538":64811,"_19130":109359,"_5":13154,"_26074":109173,"_2645":48864},[],{"_3146":64880,"_27538":64811,"_19130":109361,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64881,"_27538":64811,"_19130":109363,"_5":13154,"_26074":109173,"_2645":109345},[],{"_3146":64882,"_27538":64811,"_19130":109365,"_5":13154,"_26074":109173,"_2645":109366},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3146":64883,"_27538":64811,"_19130":109368,"_5":13154,"_26074":109173,"_2645":48874},[],{"_3146":64884,"_27538":64811,"_19130":109370,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64885,"_27538":64811,"_19130":109372,"_5":13154,"_26074":109173,"_2645":109373},[],"Solo con `auth_method=static`",{"_3146":64886,"_27538":64811,"_19130":109375,"_5":13154,"_26074":109173,"_2645":109376},[],"Clave de acceso AWS.",{"_3146":64887,"_27538":64811,"_19130":109378,"_5":13154,"_26074":109173,"_2645":48885},[],{"_3146":64888,"_27538":64811,"_19130":109380,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64889,"_27538":64811,"_19130":109382,"_5":13154,"_26074":109173,"_2645":109373},[],{"_3146":64890,"_27538":64811,"_19130":109384,"_5":13154,"_26074":109173,"_2645":109385},[],"Clave secreta AWS.",{"_3146":64891,"_27538":64811,"_19130":109387,"_5":13154,"_26074":109173,"_2645":48895},[],{"_3146":64892,"_27538":64811,"_19130":109389,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64893,"_27538":64811,"_19130":109391,"_5":13154,"_26074":109173,"_2645":48900},[],{"_3146":64894,"_27538":64811,"_19130":109393,"_5":13154,"_26074":109173,"_2645":109394},[],"Token de sesión (con `auth_method=static`).",{"_3146":64895,"_27538":64811,"_19130":109396,"_5":13154,"_26074":109173,"_2645":48906},[],{"_3146":64896,"_27538":64811,"_19130":109398,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64897,"_27538":64811,"_19130":109400,"_5":13154,"_26074":109173,"_2645":109401},[],"Solo con `auth_method=role`",{"_3146":64898,"_27538":64811,"_19130":109403,"_5":13154,"_26074":109173,"_2645":109404},[],"ARN del rol a asumir.",{"_3146":64899,"_27538":64811,"_19130":109406,"_5":13154,"_26074":109173,"_2645":48917},[],{"_3146":64900,"_27538":64811,"_19130":109408,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64901,"_27538":64811,"_19130":109410,"_5":13154,"_26074":109173,"_2645":48900},[],{"_3146":64902,"_27538":64811,"_19130":109412,"_5":13154,"_26074":109173,"_2645":109413},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3146":64903,"_27538":64811,"_19130":109415,"_5":13154,"_26074":109173,"_2645":48927},[],{"_3146":64904,"_27538":64811,"_19130":109417,"_5":13154,"_26074":109173,"_2645":16128},[],{"_3146":64905,"_27538":64811,"_19130":109419,"_5":13154,"_26074":109173,"_2645":109345},[],{"_3146":64906,"_27538":64811,"_19130":109421,"_5":13154,"_26074":109173,"_2645":109422},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3146":64907,"_27538":64811,"_19130":109424,"_5":13154,"_26074":109173,"_2645":48937},[],{"_3146":64908,"_27538":64811,"_19130":109426,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64909,"_27538":64811,"_19130":109428,"_5":13154,"_26074":109173,"_2645":109345},[],{"_3146":64910,"_27538":64811,"_19130":109430,"_5":13154,"_26074":109173,"_2645":109431},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3146":64911,"_27538":64811,"_19130":109433,"_5":13154,"_26074":109173,"_2645":48947},[],{"_3146":64912,"_27538":64811,"_19130":109435,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64913,"_27538":64811,"_19130":109437,"_5":13154,"_26074":109173,"_2645":109345},[],{"_3146":64914,"_27538":64811,"_19130":109439,"_5":13154,"_26074":109173,"_2645":109440},[],"URL HTTP del Device Manager de Lamassu.",{"_3146":64915,"_27538":64811,"_19130":109442,"_5":13154,"_26074":109173,"_2645":48957},[],{"_3146":64916,"_27538":64811,"_19130":109444,"_5":13154,"_26074":109173,"_2645":22875},[],{"_3146":64917,"_27538":64811,"_19130":109446,"_5":13154,"_26074":109173,"_2645":109345},[],{"_3146":64918,"_27538":64811,"_19130":109448,"_5":13154,"_26074":109173,"_2645":109449},[],"URL HTTP del servicio de CA de Lamassu.",{"_3146":64919,"_27538":64811,"_19130":109451,"_5":13154,"_26074":109177,"_2645":109452},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3146":64920,"_27538":64811,"_19130":109454,"_5":13154,"_26074":109181,"_2645":109455},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3146":64921,"_27538":64811,"_19130":109457,"_5":13154,"_26074":109181,"_2645":109458},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3146":64922,"_27538":64811,"_19130":109460,"_5":13154,"_26074":109185,"_2645":109461},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3146":64923,"_27538":64811,"_19130":109463,"_5":13154,"_26074":109185,"_2645":109464},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3146":64924,"_27538":64811,"_19130":109466,"_5":13154,"_26074":109185,"_2645":109467},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3146":64925,"_27538":64811,"_19130":109469,"_5":13154,"_26074":109185,"_2645":109470},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3146":64926,"_27538":64811,"_19130":109472,"_5":13154,"_26074":109185,"_2645":109473},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3146":64927,"_27538":64811,"_19130":109475,"_5":13154,"_26074":109185,"_2645":109476},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3146":64928,"_27538":64811,"_19130":109478,"_5":13154,"_26074":109188,"_2645":109479},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3146":64929,"_27538":64811,"_19130":109481,"_5":13154,"_26074":109191,"_2645":109482},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3146":64930,"_27538":64811,"_19130":109484,"_5":13154,"_26074":109191,"_2645":109485},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3146":64931,"_27538":64811,"_19130":109487,"_5":13154,"_26074":109195,"_2645":109488},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3146":64932,"_27538":64811,"_19130":109490,"_5":13154,"_26074":109199,"_2645":109491},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3146":64933,"_27538":64811,"_19130":109493,"_5":13154,"_26074":109199,"_2645":109494},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3146":64934,"_27538":64811,"_19130":109496,"_5":13154,"_26074":109199,"_2645":109497},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3146":64935,"_27538":64811,"_19130":109499,"_5":13154,"_26074":109199,"_2645":109500},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3146":64936,"_27538":64811,"_19130":109502,"_5":13154,"_26074":109199,"_2645":109503},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3146":64937,"_27538":64811,"_19130":109505,"_5":13154,"_26074":109199,"_2645":109506},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3146":64938,"_27538":64811,"_19130":109508,"_5":13154,"_26074":109203,"_2645":109509},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3146":64939,"_27538":64811,"_19130":109511,"_5":13154,"_26074":109203,"_2645":109512},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3146":64940,"_27538":64811,"_19130":109514,"_5":13154,"_26074":109203,"_2645":109515},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3146":64941,"_27538":64811,"_19130":109517,"_5":13154,"_26074":109207,"_2645":109518},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3146":64942,"_27538":64811,"_19130":109520,"_5":13154,"_26074":109207,"_2645":109521},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3146":64943,"_27538":64811,"_19130":109523,"_5":13154,"_26074":109207,"_2645":109524},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3146":64944,"_27538":64811,"_19130":109526,"_5":13154,"_26074":109211,"_2645":109527},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3146":64945,"_27538":64811,"_19130":109529,"_5":13154,"_26074":109211,"_2645":109530},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3146":64946,"_27538":64811,"_19130":109532,"_5":13154,"_26074":109211,"_2645":109533},[],"Para que el flujo JITP funcione correctamente:",{"_3146":64947,"_27538":64811,"_19130":109535,"_5":13154,"_26074":109211,"_2645":109536},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3146":64948,"_27538":64811,"_19130":109538,"_5":13154,"_26074":109211,"_2645":109539},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3146":64949,"_27538":64811,"_19130":109541,"_5":13154,"_26074":109211,"_2645":109542},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3146":64950,"_27538":64811,"_19130":109544,"_5":13154,"_26074":109211,"_2645":109545},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3146":64951,"_27538":64811,"_19130":109547,"_5":13154,"_26074":109215,"_2645":109548},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3146":64952,"_27538":64811,"_19130":109550,"_5":13154,"_26074":109215,"_2645":109551},[],"Estado en Lamassu",{"_3146":64953,"_27538":64811,"_19130":109553,"_5":13154,"_26074":109215,"_2645":109554},[],"Razón de revocación",{"_3146":64954,"_27538":64811,"_19130":109556,"_5":13154,"_26074":109215,"_2645":109557},[],"Estado en AWS IoT Core",{"_3146":64955,"_27538":64811,"_19130":109559,"_5":13154,"_26074":109215,"_2645":49078},[],{"_3146":64956,"_27538":64811,"_19130":109561,"_5":13154,"_26074":109215,"_2645":109562},[],"Ninguna",{"_3146":64957,"_27538":64811,"_19130":109564,"_5":13154,"_26074":109215,"_2645":49084},[],{"_3146":64958,"_27538":64811,"_19130":109566,"_5":13154,"_26074":109215,"_2645":49087},[],{"_3146":64959,"_27538":64811,"_19130":109568,"_5":13154,"_26074":109215,"_2645":49090},[],{"_3146":64960,"_27538":64811,"_19130":109570,"_5":13154,"_26074":109215,"_2645":49093},[],{"_3146":64961,"_27538":64811,"_19130":109572,"_5":13154,"_26074":109215,"_2645":49087},[],{"_3146":64962,"_27538":64811,"_19130":109574,"_5":13154,"_26074":109215,"_2645":109575},[],"Cualquier otra razón",{"_3146":64963,"_27538":64811,"_19130":109577,"_5":13154,"_26074":109215,"_2645":49101},[],{"_3146":64964,"_27538":64811,"_19130":109579,"_5":13154,"_26074":109215,"_2645":109580},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3146":64965,"_27538":64811,"_19130":109582,"_5":13154,"_26074":109219,"_2645":109583},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3146":64966,"_27538":64811,"_19130":109585,"_5":13154,"_26074":109219,"_2645":109586},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3146":64967,"_27538":64811,"_19130":109588,"_5":13154,"_26074":109219,"_2645":109589},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3146":64968,"_27538":64811,"_19130":109591,"_5":13154,"_26074":109223,"_2645":109592},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3146":64969,"_27538":64811,"_19130":109594,"_5":13154,"_26074":109223,"_2645":109595},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3146":64970,"_27538":64811,"_19130":109597,"_5":13154,"_26074":109227,"_2645":109598},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3146":64971,"_27538":64811,"_19130":109600,"_5":13154,"_26074":109227,"_2645":109601},[],"Existen dos tipos de acciones:",{"_3146":64972,"_27538":64811,"_19130":109603,"_5":13154,"_26074":109227,"_2645":109604},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3146":64973,"_27538":64811,"_19130":109606,"_5":13154,"_26074":109227,"_2645":109607},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3146":64974,"_27538":64811,"_19130":109609,"_5":13154,"_26074":109227,"_2645":109610},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3146":64975,"_27538":64811,"_19130":109612,"_5":13154,"_26074":109231,"_2645":109613},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3146":64976,"_27538":64811,"_19130":109615,"_5":13154,"_26074":109231,"_2645":109616},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3146":64977,"_27538":64811,"_19130":109618,"_5":13154,"_26074":109231,"_2645":109619},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3146":64978,"_27538":64811,"_19130":109621,"_5":13154,"_26074":109235,"_2645":109622},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3146":64979,"_27538":64811,"_19130":109624,"_5":13154,"_26074":109235,"_2645":109625},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3146":64980,"_27538":64811,"_19130":109627,"_5":13154,"_26074":109235,"_2645":109628},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3146":64981,"_27538":64811,"_19130":109630,"_5":13154,"_26074":109235,"_2645":109631},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3146":64982,"_27538":64811,"_19130":109633,"_5":13154,"_26074":109235,"_2645":109634},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3146":64983,"_27538":64811,"_19130":109636,"_5":13154,"_26074":109235,"_2645":109637},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3146":64984,"_27538":64811,"_19130":109639,"_5":13154,"_26074":109235,"_2645":109640},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3146":64985,"_27538":64811,"_19130":109642,"_5":13154,"_26074":109235,"_2645":109643},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3146":64986,"_27538":64811,"_19130":109645,"_5":13154,"_26074":109235,"_2645":109646},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3146":64987,"_27538":64811,"_19130":109648,"_5":13154,"_26074":109235,"_2645":109649},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3146":64988,"_27538":64811,"_19130":109651,"_5":13154,"_26074":109235,"_2645":109652},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3146":64989,"_27538":64811,"_19130":109654,"_5":13154,"_26074":109235,"_2645":109655},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3146":64990,"_27538":64811,"_19130":109657,"_5":13154,"_26074":109235,"_2645":109658},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3146":64991,"_27538":64811,"_19130":109660,"_5":13154,"_26074":109235,"_2645":109661},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3146":64992,"_27538":64811,"_19130":109663,"_5":13154,"_26074":109235,"_2645":109664},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3146":64993,"_27538":64811,"_19130":109666,"_5":13154,"_26074":109235,"_2645":109667},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3146":64994,"_27538":64811,"_19130":109669,"_5":13154,"_26074":109235,"_2645":109670},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3146":64995,"_27538":64811,"_19130":109672,"_5":13154,"_26074":109235,"_2645":109673},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3146":64996,"_27538":64811,"_19130":109675,"_5":13154,"_26074":109235,"_2645":109676},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3146":64997,"_27538":64811,"_19130":109678,"_5":13154,"_26074":109235,"_2645":109679},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3146":64998,"_27538":64811,"_19130":109681,"_5":13154,"_26074":109235,"_2645":109682},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3146":64999,"_27538":64999,"_5":13480,"_2645":47187,"_27881":109684,"_19130":109685,"_26074":64999},[44830,106777,47187],[],{"_3146":65000,"_27538":64999,"_19130":109687,"_5":13154,"_26074":64999,"_2645":109688},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3146":65001,"_27538":64999,"_5":27878,"_19130":109690,"_26074":109691,"_2645":109692},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3146":65002,"_27538":64999,"_5":27878,"_19130":109694,"_26074":109695,"_2645":107752},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3146":65003,"_27538":64999,"_5":27878,"_19130":109697,"_26074":109698,"_2645":107927},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3146":65004,"_27538":64999,"_5":27878,"_19130":109700,"_26074":109701,"_2645":109154},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#integraciones",{"_3146":65005,"_27538":64999,"_5":27878,"_19130":109703,"_26074":109704,"_2645":109705},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3146":65006,"_27538":64999,"_19130":109707,"_5":13154,"_26074":64999,"_2645":109708},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3146":65007,"_27538":64999,"_19130":109710,"_5":13154,"_26074":109691,"_2645":109711},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3146":65008,"_27538":64999,"_19130":109713,"_5":13154,"_26074":109691,"_2645":109714},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3146":65009,"_27538":64999,"_19130":109716,"_5":13154,"_26074":109695,"_2645":109717},[],"Recurso",{"_3146":65010,"_27538":64999,"_19130":109719,"_5":13154,"_26074":109695,"_2645":109720},[],"Qué representa",{"_3146":65011,"_27538":64999,"_19130":109722,"_5":13154,"_26074":109695,"_2645":109723},[],"**Dispositivo**",{"_3146":65012,"_27538":64999,"_19130":109725,"_5":13154,"_26074":109695,"_2645":109726},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3146":65013,"_27538":64999,"_19130":109728,"_5":13154,"_26074":109695,"_2645":109729},[],"**Identidad**",{"_3146":65014,"_27538":64999,"_19130":109731,"_5":13154,"_26074":109695,"_2645":109732},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3146":65015,"_27538":64999,"_19130":109734,"_5":13154,"_26074":109695,"_2645":49259},[],{"_3146":65016,"_27538":64999,"_19130":109736,"_5":13154,"_26074":109695,"_2645":109737},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3146":65017,"_27538":64999,"_19130":109739,"_5":13154,"_26074":109695,"_2645":109740},[],"**Flota**",{"_3146":65018,"_27538":64999,"_19130":109742,"_5":13154,"_26074":109695,"_2645":109743},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3146":65019,"_27538":64999,"_19130":109745,"_5":13154,"_26074":109695,"_2645":109746},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3146":65020,"_27538":64999,"_19130":109748,"_5":13154,"_26074":109695,"_2645":109749},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3146":65021,"_27538":64999,"_19130":109751,"_5":13154,"_26074":109698,"_2645":109752},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3146":65022,"_27538":64999,"_19130":109754,"_5":13154,"_26074":109698,"_2645":109755},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3146":65023,"_27538":64999,"_19130":109757,"_5":13154,"_26074":109698,"_2645":109758},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3146":65024,"_27538":64999,"_19130":109760,"_5":13154,"_26074":109698,"_2645":109761},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3146":65025,"_27538":64999,"_19130":109763,"_5":13154,"_26074":109698,"_2645":109764},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3146":65026,"_27538":64999,"_19130":109766,"_5":13154,"_26074":109698,"_2645":109767},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3146":65027,"_27538":64999,"_19130":109769,"_5":13154,"_26074":109698,"_2645":109770},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3146":65028,"_27538":64999,"_19130":109772,"_5":13154,"_26074":109698,"_2645":109773},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3146":65029,"_27538":64999,"_19130":109775,"_5":13154,"_26074":109701,"_2645":109776},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3146":65030,"_27538":64999,"_19130":109778,"_5":13154,"_26074":109701,"_2645":109779},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3146":65031,"_27538":64999,"_19130":109781,"_5":13154,"_26074":109704,"_2645":109782},[],"Participante",{"_3146":65032,"_27538":64999,"_19130":109784,"_5":13154,"_26074":109704,"_2645":109785},[],"Responsabilidad",{"_3146":65033,"_27538":64999,"_19130":109787,"_5":13154,"_26074":109704,"_2645":109788},[],"Administrador PKI",{"_3146":65034,"_27538":64999,"_19130":109790,"_5":13154,"_26074":109704,"_2645":109791},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3146":65035,"_27538":64999,"_19130":109793,"_5":13154,"_26074":109704,"_2645":109794},[],"Administrador del aprovisionamiento",{"_3146":65036,"_27538":64999,"_19130":109796,"_5":13154,"_26074":109704,"_2645":109797},[],"DMS, admisión, autenticación por operación e inventario.",{"_3146":65037,"_27538":64999,"_19130":109799,"_5":13154,"_26074":109704,"_2645":109800},[],"Integrador del dispositivo",{"_3146":65038,"_27538":64999,"_19130":109802,"_5":13154,"_26074":109704,"_2645":109803},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3146":65039,"_27538":64999,"_19130":109805,"_5":13154,"_26074":109704,"_2645":109806},[],"Integrador del consumidor",{"_3146":65040,"_27538":64999,"_19130":109808,"_5":13154,"_26074":109704,"_2645":109809},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3146":65041,"_27538":64999,"_19130":109811,"_5":13154,"_26074":109704,"_2645":109812},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3146":65042,"_27538":65042,"_5":13480,"_2645":109814,"_27881":109815,"_19130":109817,"_26074":65042},"Enrola y conecta tu primer dispositivo",[44830,106777,47187,109816],"Primeros pasos",[],{"_3146":65043,"_27538":65042,"_19130":109819,"_5":13154,"_26074":65042,"_2645":109820},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3146":65044,"_27538":65042,"_5":27878,"_19130":109822,"_26074":109823,"_2645":105443},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3146":65045,"_27538":65042,"_5":27878,"_19130":109825,"_26074":109826,"_2645":109827},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3146":65046,"_27538":65042,"_5":27878,"_19130":109829,"_26074":109830,"_2645":109831},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3146":65047,"_27538":65042,"_5":27878,"_19130":109833,"_26074":109834,"_2645":109835},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3146":65048,"_27538":65042,"_5":27878,"_19130":109837,"_26074":109838,"_2645":109839},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3146":65049,"_27538":65042,"_5":27878,"_19130":109841,"_26074":109842,"_2645":109843},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3146":65050,"_27538":65042,"_5":27878,"_19130":109845,"_26074":109846,"_2645":109847},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3146":65051,"_27538":65042,"_5":27878,"_19130":109849,"_26074":109850,"_2645":109851},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3146":65052,"_27538":65042,"_19130":109853,"_5":13154,"_26074":65042,"_2645":109854},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3146":65053,"_27538":65042,"_19130":109856,"_5":13154,"_26074":109823,"_2645":109857},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3146":65054,"_27538":65042,"_19130":109859,"_5":13154,"_26074":109823,"_2645":109860},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3146":65055,"_27538":65042,"_19130":109862,"_5":13154,"_26074":109823,"_2645":109863},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3146":65056,"_27538":65042,"_19130":109865,"_5":13154,"_26074":109823,"_2645":109866},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3146":65057,"_27538":65042,"_19130":109868,"_5":13154,"_26074":109823,"_2645":109869},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3146":65058,"_27538":65042,"_19130":109871,"_5":13154,"_26074":109826,"_2645":109872},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3146":65059,"_27538":65042,"_19130":109874,"_5":13154,"_26074":109826,"_2645":109875},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3146":65060,"_27538":65042,"_19130":109877,"_5":13154,"_26074":109830,"_2645":109878},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3146":65061,"_27538":65042,"_19130":109880,"_5":13154,"_26074":109830,"_2645":109881},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3146":65062,"_27538":65042,"_19130":109883,"_5":13154,"_26074":109830,"_2645":109884},[],"Ajuste",{"_3146":65063,"_27538":65042,"_19130":109886,"_5":13154,"_26074":109830,"_2645":109887},[],"Valor de evaluación",{"_3146":65064,"_27538":65042,"_19130":109889,"_5":13154,"_26074":109830,"_2645":49415},[],{"_3146":65065,"_27538":65042,"_19130":109891,"_5":13154,"_26074":109830,"_2645":109892},[],"Raíz emisora de `device-root.pem`.",{"_3146":65066,"_27538":65042,"_19130":109894,"_5":13154,"_26074":109830,"_2645":108055},[],{"_3146":65067,"_27538":65042,"_19130":109896,"_5":13154,"_26074":109830,"_2645":109897},[],"Perfil final de 1 hora que acabas de preparar.",{"_3146":65068,"_27538":65042,"_19130":109899,"_5":13154,"_26074":109830,"_2645":49426},[],{"_3146":65069,"_27538":65042,"_19130":109901,"_5":13154,"_26074":109830,"_2645":49429},[],{"_3146":65070,"_27538":65042,"_19130":109903,"_5":13154,"_26074":109830,"_2645":49432},[],{"_3146":65071,"_27538":65042,"_19130":109905,"_5":13154,"_26074":109830,"_2645":109906},[],"Habilitado.",{"_3146":65072,"_27538":65042,"_19130":109908,"_5":13154,"_26074":109830,"_2645":49438},[],{"_3146":65073,"_27538":65042,"_19130":109910,"_5":13154,"_26074":109830,"_2645":109911},[],"Deshabilitado; el ID debe ser nuevo.",{"_3146":65074,"_27538":65042,"_19130":109913,"_5":13154,"_26074":109830,"_2645":109914},[],"Autenticación inicial",{"_3146":65075,"_27538":65042,"_19130":109916,"_5":13154,"_26074":109830,"_2645":109917},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3146":65076,"_27538":65042,"_19130":109919,"_5":13154,"_26074":109830,"_2645":109920},[],"Autenticación de renovación",{"_3146":65077,"_27538":65042,"_19130":109922,"_5":13154,"_26074":109830,"_2645":109923},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3146":65078,"_27538":65042,"_19130":109925,"_5":13154,"_26074":109830,"_2645":49456},[],{"_3146":65079,"_27538":65042,"_19130":109927,"_5":13154,"_26074":109830,"_2645":109928},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_3146":65080,"_27538":65042,"_19130":109930,"_5":13154,"_26074":109830,"_2645":49462},[],{"_3146":65081,"_27538":65042,"_19130":109932,"_5":13154,"_26074":109830,"_2645":109933},[],"1 hora.",{"_3146":65082,"_27538":65042,"_19130":109935,"_5":13154,"_26074":109830,"_2645":49468},[],{"_3146":65083,"_27538":65042,"_19130":109937,"_5":13154,"_26074":109830,"_2645":109938},[],"30 minutos / 10 minutos.",{"_3146":65084,"_27538":65042,"_19130":109940,"_5":13154,"_26074":109830,"_2645":49474},[],{"_3146":65085,"_27538":65042,"_19130":109942,"_5":13154,"_26074":109830,"_2645":109943},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3146":65086,"_27538":65042,"_19130":109945,"_5":13154,"_26074":109830,"_2645":47506},[],{"_3146":65087,"_27538":65042,"_19130":109947,"_5":13154,"_26074":109830,"_2645":109948},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3146":65088,"_27538":65042,"_19130":109950,"_5":13154,"_26074":109830,"_2645":49485},[],{"_3146":65089,"_27538":65042,"_19130":109952,"_5":13154,"_26074":109830,"_2645":109953},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3146":65090,"_27538":65042,"_19130":109955,"_5":13154,"_26074":109830,"_2645":109956},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3146":65091,"_27538":65042,"_19130":109958,"_5":13154,"_26074":109834,"_2645":109959},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3146":65092,"_27538":65042,"_19130":109961,"_5":13154,"_26074":109834,"_2645":109962},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3146":65093,"_27538":65042,"_19130":109964,"_5":13154,"_26074":109838,"_2645":109965},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3146":65094,"_27538":65042,"_19130":109967,"_5":13154,"_26074":109838,"_2645":109968},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3146":65095,"_27538":65042,"_19130":109970,"_5":13154,"_26074":109838,"_2645":109971},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3146":65096,"_27538":65042,"_19130":109973,"_5":13154,"_26074":109842,"_2645":109974},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3146":65097,"_27538":65042,"_19130":109976,"_5":13154,"_26074":109842,"_2645":109977},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3146":65098,"_27538":65042,"_19130":109979,"_5":13154,"_26074":109846,"_2645":109980},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3146":65099,"_27538":65042,"_19130":109982,"_5":13154,"_26074":109846,"_2645":109983},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3146":65100,"_27538":65042,"_19130":109985,"_5":13154,"_26074":109846,"_2645":109986},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3146":65101,"_27538":65042,"_19130":109988,"_5":13154,"_26074":109846,"_2645":109989},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3146":65102,"_27538":65042,"_19130":109991,"_5":13154,"_26074":109846,"_2645":109992},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3146":65103,"_27538":65042,"_19130":109994,"_5":13154,"_26074":109850,"_2645":109995},[],"Comprobación",{"_3146":65104,"_27538":65042,"_19130":109997,"_5":13154,"_26074":109850,"_2645":109998},[],"Resultado esperado",{"_3146":65105,"_27538":65042,"_19130":110000,"_5":13154,"_26074":109850,"_2645":110001},[],"Registro",{"_3146":65106,"_27538":65042,"_19130":110003,"_5":13154,"_26074":109850,"_2645":110004},[],"ID creado automáticamente y DMS correcto.",{"_3146":65107,"_27538":65042,"_19130":110006,"_5":13154,"_26074":109850,"_2645":110007},[],"Certificado",{"_3146":65108,"_27538":65042,"_19130":110009,"_5":13154,"_26074":109850,"_2645":110010},[],"CN, perfil, serie y clave verificados.",{"_3146":65109,"_27538":65042,"_19130":110012,"_5":13154,"_26074":109850,"_2645":110013},[],"Inventario",{"_3146":65110,"_27538":65042,"_19130":110015,"_5":13154,"_26074":109850,"_2645":110016},[],"Serie recibida visible como identidad actual y en el historial.",{"_3146":65111,"_27538":65042,"_19130":110018,"_5":13154,"_26074":109850,"_2645":110019},[],"Consumidor",{"_3146":65112,"_27538":65042,"_19130":110021,"_5":13154,"_26074":109850,"_2645":110022},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3146":65113,"_27538":65042,"_19130":110024,"_5":13154,"_26074":109850,"_2645":110025},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3146":65114,"_27538":65042,"_19130":110027,"_5":13154,"_26074":109850,"_2645":110028},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3146":65115,"_27538":65115,"_5":13480,"_2645":107769,"_27881":110030,"_19130":110031,"_26074":65115},[44830,106777,47187,109816],[],{"_3146":65116,"_27538":65115,"_19130":110033,"_5":13154,"_26074":65115,"_2645":110034},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3146":65117,"_27538":65115,"_5":27878,"_19130":110036,"_26074":110037,"_2645":105443},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3146":65118,"_27538":65115,"_5":27878,"_19130":110039,"_26074":110040,"_2645":110041},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3146":65119,"_27538":65115,"_5":27878,"_19130":110043,"_26074":110044,"_2645":110045},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3146":65120,"_27538":65115,"_5":27878,"_19130":110047,"_26074":110048,"_2645":110049},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3146":65121,"_27538":65115,"_5":27878,"_19130":110051,"_26074":110052,"_2645":110053},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3146":65122,"_27538":65115,"_5":27878,"_19130":110055,"_26074":110056,"_2645":110057},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3146":65123,"_27538":65115,"_5":27878,"_19130":110059,"_26074":110060,"_2645":109998},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3146":65124,"_27538":65115,"_5":27878,"_19130":110062,"_26074":110063,"_2645":110064},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3146":65125,"_27538":65115,"_5":27878,"_19130":110066,"_26074":110067,"_2645":110068},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3146":65126,"_27538":65115,"_19130":110070,"_5":13154,"_26074":65115,"_2645":110071},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3146":65127,"_27538":65115,"_19130":110073,"_5":13154,"_26074":65115,"_2645":110074},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3146":65128,"_27538":65115,"_19130":110076,"_5":13154,"_26074":110037,"_2645":110077},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3146":65129,"_27538":65115,"_19130":110079,"_5":13154,"_26074":110037,"_2645":110080},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3146":65130,"_27538":65115,"_19130":110082,"_5":13154,"_26074":110037,"_2645":110083},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3146":65131,"_27538":65115,"_19130":110085,"_5":13154,"_26074":110037,"_2645":110086},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3146":65132,"_27538":65115,"_19130":110088,"_5":13154,"_26074":110040,"_2645":110089},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3146":65133,"_27538":65115,"_19130":110091,"_5":13154,"_26074":110040,"_2645":110092},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3146":65134,"_27538":65115,"_19130":110094,"_5":13154,"_26074":110040,"_2645":110095},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3146":65135,"_27538":65115,"_19130":110097,"_5":13154,"_26074":110040,"_2645":110098},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3146":65136,"_27538":65115,"_19130":110100,"_5":13154,"_26074":110040,"_2645":110101},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_3146":65137,"_27538":65115,"_19130":110103,"_5":13154,"_26074":110040,"_2645":110104},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3146":65138,"_27538":65115,"_19130":110106,"_5":13154,"_26074":110040,"_2645":110107},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3146":65139,"_27538":65115,"_19130":110109,"_5":13154,"_26074":110040,"_2645":110110},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3146":65140,"_27538":65115,"_19130":110112,"_5":13154,"_26074":110044,"_2645":110113},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3146":65141,"_27538":65115,"_19130":110115,"_5":13154,"_26074":110044,"_2645":49651},[],{"_3146":65142,"_27538":65115,"_19130":110117,"_5":13154,"_26074":110044,"_2645":110118},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3146":65143,"_27538":65115,"_19130":110120,"_5":13154,"_26074":110044,"_2645":110121},[],"**Icon** y **Tags**: clasificación opcional.",{"_3146":65144,"_27538":65115,"_19130":110123,"_5":13154,"_26074":110044,"_2645":110124},[],"Confirma el registro.",{"_3146":65145,"_27538":65115,"_19130":110126,"_5":13154,"_26074":110048,"_2645":110127},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3146":65146,"_27538":65115,"_19130":110129,"_5":13154,"_26074":110048,"_2645":110130},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3146":65147,"_27538":65115,"_19130":110132,"_5":13154,"_26074":110052,"_2645":110133},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3146":65148,"_27538":65115,"_19130":110135,"_5":13154,"_26074":110052,"_2645":110136},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3146":65149,"_27538":65115,"_19130":110138,"_5":13154,"_26074":110056,"_2645":110139},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3146":65150,"_27538":65115,"_19130":110141,"_5":13154,"_26074":110056,"_2645":110142},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3146":65151,"_27538":65115,"_19130":110144,"_5":13154,"_26074":110060,"_2645":109995},[],{"_3146":65152,"_27538":65115,"_19130":110146,"_5":13154,"_26074":110060,"_2645":110147},[],"Resultado",{"_3146":65153,"_27538":65115,"_19130":110149,"_5":13154,"_26074":110060,"_2645":110150},[],"Dispositivo",{"_3146":65154,"_27538":65115,"_19130":110152,"_5":13154,"_26074":110060,"_2645":110153},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3146":65155,"_27538":65115,"_19130":110155,"_5":13154,"_26074":110060,"_2645":110156},[],"Identidad actual",{"_3146":65156,"_27538":65115,"_19130":110158,"_5":13154,"_26074":110060,"_2645":110159},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3146":65157,"_27538":65115,"_19130":110161,"_5":13154,"_26074":110060,"_2645":110162},[],"Historial",{"_3146":65158,"_27538":65115,"_19130":110164,"_5":13154,"_26074":110060,"_2645":110165},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3146":65159,"_27538":65115,"_19130":110167,"_5":13154,"_26074":110060,"_2645":110168},[],"Clave y certificado",{"_3146":65160,"_27538":65115,"_19130":110170,"_5":13154,"_26074":110060,"_2645":110171},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3146":65161,"_27538":65115,"_19130":110173,"_5":13154,"_26074":110063,"_2645":110174},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3146":65162,"_27538":65115,"_19130":110176,"_5":13154,"_26074":110063,"_2645":110177},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3146":65163,"_27538":65115,"_19130":110179,"_5":13154,"_26074":110063,"_2645":110180},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3146":65164,"_27538":65115,"_19130":110182,"_5":13154,"_26074":110063,"_2645":110183},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3146":65165,"_27538":65115,"_19130":110185,"_5":13154,"_26074":110067,"_2645":110186},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3146":65166,"_27538":65115,"_19130":110188,"_5":13154,"_26074":110067,"_2645":110189},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3146":65167,"_27538":65115,"_19130":110191,"_5":13154,"_26074":110067,"_2645":110192},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3146":65168,"_27538":65168,"_5":13480,"_2645":110194,"_27881":110195,"_19130":110196,"_26074":65168},"Plataforma Lamassu IoT",[44830,106777],[],{"_3146":65169,"_27538":65168,"_19130":110198,"_5":13154,"_26074":65168,"_2645":110199},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3146":65170,"_27538":65168,"_5":27878,"_19130":110201,"_26074":110202,"_2645":109692},[],"/docs/pr-preview/pr-26/es/platform/overview#empieza-aquí",{"_3146":65171,"_27538":65168,"_5":27878,"_19130":110204,"_26074":110205,"_2645":110206},[],"/docs/pr-preview/pr-26/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3146":65172,"_27538":65168,"_5":27878,"_19130":110208,"_26074":110209,"_2645":110210},[],"/docs/pr-preview/pr-26/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3146":65173,"_27538":65168,"_5":27878,"_19130":110212,"_26074":110213,"_2645":110214},[],"/docs/pr-preview/pr-26/es/platform/overview#capacidades-principales","Capacidades principales",{"_3146":65174,"_27538":65168,"_5":27878,"_19130":110216,"_26074":110217,"_2645":110218},[],"/docs/pr-preview/pr-26/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3146":65175,"_27538":65168,"_5":27878,"_19130":110220,"_26074":110221,"_2645":110222},[],"/docs/pr-preview/pr-26/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3146":65176,"_27538":65168,"_5":27878,"_19130":110224,"_26074":110225,"_2645":110226},[],"/docs/pr-preview/pr-26/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3146":65177,"_27538":65168,"_5":27878,"_19130":110228,"_26074":110229,"_2645":110230},[],"/docs/pr-preview/pr-26/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3146":65178,"_27538":65168,"_5":27878,"_19130":110232,"_26074":110233,"_2645":110234},[],"/docs/pr-preview/pr-26/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3146":65179,"_27538":65168,"_5":27878,"_19130":110236,"_26074":110237,"_2645":110238},[],"/docs/pr-preview/pr-26/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3146":65180,"_27538":65168,"_5":27878,"_19130":110240,"_26074":110241,"_2645":110242},[],"/docs/pr-preview/pr-26/es/platform/overview#referencia-operativa","Referencia operativa",{"_3146":65181,"_27538":65168,"_19130":110244,"_5":13154,"_26074":65168,"_2645":110245},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3146":65182,"_27538":65168,"_19130":110247,"_5":13154,"_26074":110202,"_2645":110248},[],"Elige el resultado que necesitas obtener:",{"_3146":65183,"_27538":65168,"_19130":110250,"_5":13154,"_26074":110202,"_2645":110251},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3146":65184,"_27538":65168,"_19130":110253,"_5":13154,"_26074":110202,"_2645":110254},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3146":65185,"_27538":65168,"_19130":110256,"_5":13154,"_26074":110202,"_2645":110257},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3146":65186,"_27538":65168,"_19130":110259,"_5":13154,"_26074":110205,"_2645":110260},[],"Bloque",{"_3146":65187,"_27538":65168,"_19130":110262,"_5":13154,"_26074":110205,"_2645":110263},[],"Qué gestionas",{"_3146":65188,"_27538":65168,"_19130":110265,"_5":13154,"_26074":110205,"_2645":110266},[],"Punto de entrada",{"_3146":65189,"_27538":65168,"_19130":110268,"_5":13154,"_26074":110205,"_2645":49805},[],{"_3146":65190,"_27538":65168,"_19130":110270,"_5":13154,"_26074":110205,"_2645":110271},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3146":65191,"_27538":65168,"_19130":110273,"_5":13154,"_26074":110205,"_2645":110274},[],"Visión general de PKI",{"_3146":65192,"_27538":65168,"_19130":110276,"_5":13154,"_26074":110205,"_2645":49814},[],{"_3146":65193,"_27538":65168,"_19130":110278,"_5":13154,"_26074":110205,"_2645":110279},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3146":65194,"_27538":65168,"_19130":110281,"_5":13154,"_26074":110205,"_2645":110282},[],"Visión general de IoT Fleets",{"_3146":65195,"_27538":65168,"_19130":110284,"_5":13154,"_26074":110205,"_2645":110285},[],"**Administración**",{"_3146":65196,"_27538":65168,"_19130":110287,"_5":13154,"_26074":110205,"_2645":110288},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3146":65197,"_27538":65168,"_19130":110290,"_5":13154,"_26074":110205,"_2645":106775},[],{"_3146":65198,"_27538":65168,"_19130":110292,"_5":13154,"_26074":110205,"_2645":110293},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3146":65199,"_27538":65168,"_19130":110295,"_5":13154,"_26074":110209,"_2645":110296},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3146":65200,"_27538":65168,"_19130":110298,"_5":13154,"_26074":110209,"_2645":110299},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3146":65201,"_27538":65168,"_19130":110301,"_5":13154,"_26074":110209,"_2645":110302},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3146":65202,"_27538":65168,"_19130":110304,"_5":13154,"_26074":110209,"_2645":110305},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3146":65203,"_27538":65168,"_19130":110307,"_5":13154,"_26074":110209,"_2645":110308},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3146":65204,"_27538":65168,"_19130":110310,"_5":13154,"_26074":110209,"_2645":110311},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3146":65205,"_27538":65168,"_19130":110313,"_5":13154,"_26074":110217,"_2645":110314},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3146":65206,"_27538":65168,"_19130":110316,"_5":13154,"_26074":110221,"_2645":110317},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3146":65207,"_27538":65168,"_19130":110319,"_5":13154,"_26074":110225,"_2645":110320},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3146":65208,"_27538":65168,"_19130":110322,"_5":13154,"_26074":110229,"_2645":110323},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3146":65209,"_27538":65168,"_19130":110325,"_5":13154,"_26074":110233,"_2645":110326},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3146":65210,"_27538":65168,"_19130":110328,"_5":13154,"_26074":110237,"_2645":110329},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3146":65211,"_27538":65168,"_19130":110331,"_5":13154,"_26074":110241,"_2645":109785},[],{"_3146":65212,"_27538":65168,"_19130":110333,"_5":13154,"_26074":110241,"_2645":110334},[],"Qué prepara o comprueba",{"_3146":65213,"_27538":65168,"_19130":110336,"_5":13154,"_26074":110241,"_2645":109788},[],{"_3146":65214,"_27538":65168,"_19130":110338,"_5":13154,"_26074":110241,"_2645":110339},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3146":65215,"_27538":65168,"_19130":110341,"_5":13154,"_26074":110241,"_2645":110342},[],"Administrador de la flota",{"_3146":65216,"_27538":65168,"_19130":110344,"_5":13154,"_26074":110241,"_2645":110345},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3146":65217,"_27538":65168,"_19130":110347,"_5":13154,"_26074":110241,"_2645":109800},[],{"_3146":65218,"_27538":65168,"_19130":110349,"_5":13154,"_26074":110241,"_2645":110350},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3146":65219,"_27538":65168,"_19130":110352,"_5":13154,"_26074":110241,"_2645":109806},[],{"_3146":65220,"_27538":65168,"_19130":110354,"_5":13154,"_26074":110241,"_2645":110355},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3146":65221,"_27538":65168,"_19130":110357,"_5":13154,"_26074":110241,"_2645":110358},[],"Operador de infraestructura",{"_3146":65222,"_27538":65168,"_19130":110360,"_5":13154,"_26074":110241,"_2645":110361},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3146":65223,"_27538":65168,"_19130":110363,"_5":13154,"_26074":110241,"_2645":110364},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3146":65224,"_27538":65224,"_5":13480,"_2645":110366,"_27881":110367,"_19130":110369,"_26074":65224},"Jerarquía y rotación de CAs",[44830,106777,49906,110368],"Claves, autoridades y certificados",[],{"_3146":65225,"_27538":65224,"_19130":110371,"_5":13154,"_26074":65224,"_2645":110372},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3146":65226,"_27538":65224,"_5":27878,"_19130":110374,"_26074":110375,"_2645":110376},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3146":65227,"_27538":65224,"_5":27878,"_19130":110378,"_26074":110379,"_2645":110380},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3146":65228,"_27538":65224,"_5":27878,"_19130":110382,"_26074":110383,"_2645":110384},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3146":65229,"_27538":65224,"_5":27878,"_19130":110386,"_26074":110387,"_2645":110388},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3146":65230,"_27538":65224,"_5":27878,"_19130":110390,"_26074":110391,"_2645":110392},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3146":65231,"_27538":65224,"_5":27878,"_19130":110394,"_26074":110395,"_2645":110396},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3146":65232,"_27538":65224,"_5":27878,"_19130":110398,"_26074":110399,"_2645":110400},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3146":65233,"_27538":65224,"_5":27878,"_19130":110402,"_26074":110403,"_2645":110404},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3146":65234,"_27538":65224,"_5":27878,"_19130":110406,"_26074":110407,"_2645":110408},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3146":65235,"_27538":65224,"_5":27878,"_19130":110410,"_26074":110411,"_2645":110412},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3146":65236,"_27538":65224,"_5":27878,"_19130":110414,"_26074":110415,"_2645":110416},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3146":65237,"_27538":65224,"_5":27878,"_19130":110418,"_26074":110419,"_2645":110420},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3146":65238,"_27538":65224,"_19130":110422,"_5":13154,"_26074":65224,"_2645":110423},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3146":65239,"_27538":65224,"_19130":110425,"_5":13154,"_26074":65224,"_2645":110426},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3146":65240,"_27538":65224,"_19130":110428,"_5":13154,"_26074":110375,"_2645":110429},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3146":65241,"_27538":65224,"_19130":110431,"_5":13154,"_26074":110375,"_2645":110432},[],"entorno, como producción y preproducción;",{"_3146":65242,"_27538":65224,"_19130":110434,"_5":13154,"_26074":110375,"_2645":110435},[],"propietario o equipo operador;",{"_3146":65243,"_27538":65224,"_19130":110437,"_5":13154,"_26074":110375,"_2645":110438},[],"familia de dispositivos o proceso de fabricación;",{"_3146":65244,"_27538":65224,"_19130":110440,"_5":13154,"_26074":110375,"_2645":110441},[],"región o requisito regulatorio;",{"_3146":65245,"_27538":65224,"_19130":110443,"_5":13154,"_26074":110375,"_2645":110444},[],"motor criptográfico o política de clave;",{"_3146":65246,"_27538":65224,"_19130":110446,"_5":13154,"_26074":110375,"_2645":110447},[],"ventana de mantenimiento y ritmo de renovación.",{"_3146":65247,"_27538":65224,"_19130":110449,"_5":13154,"_26074":110375,"_2645":110450},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3146":65248,"_27538":65224,"_19130":110452,"_5":13154,"_26074":110375,"_2645":110453},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3146":65249,"_27538":65224,"_19130":110455,"_5":13154,"_26074":110379,"_2645":110456},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3146":65250,"_27538":65224,"_19130":110458,"_5":13154,"_26074":110379,"_2645":110459},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3146":65251,"_27538":65224,"_19130":110461,"_5":13154,"_26074":110379,"_2645":110462},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3146":65252,"_27538":65224,"_19130":110464,"_5":13154,"_26074":110383,"_2645":110465},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3146":65253,"_27538":65224,"_19130":110467,"_5":13154,"_26074":110383,"_2645":110468},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3146":65254,"_27538":65224,"_19130":110470,"_5":13154,"_26074":110383,"_2645":110471},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3146":65255,"_27538":65224,"_19130":110473,"_5":13154,"_26074":110383,"_2645":110474},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3146":65256,"_27538":65224,"_19130":110476,"_5":13154,"_26074":110391,"_2645":110477},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3146":65257,"_27538":65224,"_19130":110479,"_5":13154,"_26074":110395,"_2645":110480},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3146":65258,"_27538":65224,"_19130":110482,"_5":13154,"_26074":110399,"_2645":110483},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3146":65259,"_27538":65224,"_19130":110485,"_5":13154,"_26074":110403,"_2645":110486},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_3146":65260,"_27538":65224,"_19130":110488,"_5":13154,"_26074":110407,"_2645":110489},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3146":65261,"_27538":65224,"_19130":110491,"_5":13154,"_26074":110411,"_2645":110492},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_3146":65262,"_27538":65224,"_19130":110494,"_5":13154,"_26074":110415,"_2645":110495},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3146":65263,"_27538":65224,"_19130":110497,"_5":13154,"_26074":110415,"_2645":110498},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3146":65264,"_27538":65224,"_19130":110500,"_5":13154,"_26074":110415,"_2645":110501},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3146":65265,"_27538":65224,"_19130":110503,"_5":13154,"_26074":110415,"_2645":110504},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3146":65266,"_27538":65224,"_19130":110506,"_5":13154,"_26074":110419,"_2645":110507},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3146":65267,"_27538":65224,"_19130":110509,"_5":13154,"_26074":110419,"_2645":110510},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3146":65268,"_27538":65224,"_19130":110512,"_5":13154,"_26074":110419,"_2645":110513},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3146":65269,"_27538":65224,"_19130":110515,"_5":13154,"_26074":110419,"_2645":110516},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3146":65270,"_27538":65224,"_19130":110518,"_5":13154,"_26074":110419,"_2645":110519},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3146":65271,"_27538":65224,"_19130":110521,"_5":13154,"_26074":110419,"_2645":110522},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3146":65272,"_27538":65224,"_19130":110524,"_5":13154,"_26074":110419,"_2645":110525},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3146":65273,"_27538":65273,"_5":13480,"_2645":110527,"_27881":110528,"_19130":110529,"_26074":65273},"Autoridades de certificación",[44830,106777,49906,110368],[],{"_3146":65274,"_27538":65273,"_19130":110531,"_5":13154,"_26074":65273,"_2645":110532},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3146":65275,"_27538":65273,"_5":27878,"_19130":110534,"_26074":110535,"_2645":110536},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3146":65276,"_27538":65273,"_5":27878,"_19130":110538,"_26074":110539,"_2645":110540},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3146":65277,"_27538":65273,"_5":27878,"_19130":110542,"_26074":110543,"_2645":105443},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3146":65278,"_27538":65273,"_5":27878,"_19130":110545,"_26074":110546,"_2645":110547},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3146":65279,"_27538":65273,"_5":27878,"_19130":110549,"_26074":110550,"_2645":110551},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3146":65280,"_27538":65273,"_5":27878,"_19130":110553,"_26074":110554,"_2645":110555},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3146":65281,"_27538":65273,"_5":27878,"_19130":110557,"_26074":110558,"_2645":110559},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3146":65282,"_27538":65273,"_5":27878,"_19130":110561,"_26074":110562,"_2645":110563},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3146":65283,"_27538":65273,"_5":27878,"_19130":110565,"_26074":110566,"_2645":110567},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3146":65284,"_27538":65273,"_5":27878,"_19130":110569,"_26074":110570,"_2645":110571},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3146":65285,"_27538":65273,"_5":27878,"_19130":110573,"_26074":110574,"_2645":110575},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3146":65286,"_27538":65273,"_5":27878,"_19130":110577,"_26074":110578,"_2645":110579},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3146":65287,"_27538":65273,"_5":27878,"_19130":110581,"_26074":110582,"_2645":110583},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3146":65288,"_27538":65273,"_5":27878,"_19130":110585,"_26074":110586,"_2645":110587},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3146":65289,"_27538":65273,"_5":27878,"_19130":110589,"_26074":110590,"_2645":110591},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3146":65290,"_27538":65273,"_5":27878,"_19130":110593,"_26074":110594,"_2645":110595},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3146":65291,"_27538":65273,"_5":27878,"_19130":110597,"_26074":110598,"_2645":110599},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3146":65292,"_27538":65273,"_5":27878,"_19130":110601,"_26074":110602,"_2645":110603},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3146":65293,"_27538":65273,"_5":27878,"_19130":110605,"_26074":110606,"_2645":110607},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3146":65294,"_27538":65273,"_5":27878,"_19130":110609,"_26074":110610,"_2645":110611},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3146":65295,"_27538":65273,"_5":27878,"_19130":110613,"_26074":110614,"_2645":110615},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3146":65296,"_27538":65273,"_5":27878,"_19130":110617,"_26074":110618,"_2645":110619},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3146":65297,"_27538":65273,"_19130":110621,"_5":13154,"_26074":65273,"_2645":110622},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3146":65298,"_27538":65273,"_19130":110624,"_5":13154,"_26074":65273,"_2645":110625},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3146":65299,"_27538":65273,"_19130":110627,"_5":13154,"_26074":65273,"_2645":110628},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3146":65300,"_27538":65273,"_19130":110630,"_5":13154,"_26074":110535,"_2645":110631},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3146":65301,"_27538":65273,"_19130":110633,"_5":13154,"_26074":110535,"_2645":110634},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3146":65302,"_27538":65273,"_19130":110636,"_5":13154,"_26074":110535,"_2645":110637},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3146":65303,"_27538":65273,"_19130":110639,"_5":13154,"_26074":110535,"_2645":110640},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3146":65304,"_27538":65273,"_19130":110642,"_5":13154,"_26074":110535,"_2645":110643},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3146":65305,"_27538":65273,"_19130":110645,"_5":13154,"_26074":110543,"_2645":110646},[],"Decide si la CA será raíz o intermedia.",{"_3146":65306,"_27538":65273,"_19130":110648,"_5":13154,"_26074":110543,"_2645":110649},[],"Elige el motor que custodiará la clave.",{"_3146":65307,"_27538":65273,"_19130":110651,"_5":13154,"_26074":110543,"_2645":110652},[],"Define una validez superior a la de los certificados que emitirá.",{"_3146":65308,"_27538":65273,"_19130":110654,"_5":13154,"_26074":110543,"_2645":110655},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3146":65309,"_27538":65273,"_19130":110657,"_5":13154,"_26074":110546,"_2645":110658},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3146":65310,"_27538":65273,"_19130":110660,"_5":13154,"_26074":110550,"_2645":110661},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3146":65311,"_27538":65273,"_19130":110663,"_5":13154,"_26074":110550,"_2645":110664},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3146":65312,"_27538":65273,"_19130":110666,"_5":13154,"_26074":110554,"_2645":110667},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3146":65313,"_27538":65273,"_19130":110669,"_5":13154,"_26074":110558,"_2645":110670},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3146":65314,"_27538":65273,"_19130":110672,"_5":13154,"_26074":110558,"_2645":110673},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3146":65315,"_27538":65273,"_19130":110675,"_5":13154,"_26074":110558,"_2645":110676},[],"`ST`: estado o provincia.",{"_3146":65316,"_27538":65273,"_19130":110678,"_5":13154,"_26074":110558,"_2645":110679},[],"`L`: localidad.",{"_3146":65317,"_27538":65273,"_19130":110681,"_5":13154,"_26074":110558,"_2645":110682},[],"`O`: organización.",{"_3146":65318,"_27538":65273,"_19130":110684,"_5":13154,"_26074":110558,"_2645":110685},[],"`OU`: unidad organizativa.",{"_3146":65319,"_27538":65273,"_19130":110687,"_5":13154,"_26074":110558,"_2645":110688},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3146":65320,"_27538":65273,"_19130":110690,"_5":13154,"_26074":110562,"_2645":110691},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3146":65321,"_27538":65273,"_19130":110693,"_5":13154,"_26074":110562,"_2645":110694},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3146":65322,"_27538":65273,"_19130":110696,"_5":13154,"_26074":110566,"_2645":110697},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3146":65323,"_27538":65273,"_19130":110699,"_5":13154,"_26074":110566,"_2645":110700},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3146":65324,"_27538":65273,"_19130":110702,"_5":13154,"_26074":110570,"_2645":110703},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3146":65325,"_27538":65273,"_19130":110705,"_5":13154,"_26074":110570,"_2645":110706},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3146":65326,"_27538":65273,"_19130":110708,"_5":13154,"_26074":110574,"_2645":110709},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3146":65327,"_27538":65273,"_19130":110711,"_5":13154,"_26074":110578,"_2645":110712},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3146":65328,"_27538":65273,"_19130":110714,"_5":13154,"_26074":110582,"_2645":110715},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3146":65329,"_27538":65273,"_19130":110717,"_5":13154,"_26074":110586,"_2645":110718},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3146":65330,"_27538":65273,"_19130":110720,"_5":13154,"_26074":110590,"_2645":110721},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3146":65331,"_27538":65273,"_19130":110723,"_5":13154,"_26074":110590,"_2645":110724},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3146":65332,"_27538":65273,"_19130":110726,"_5":13154,"_26074":110594,"_2645":110727},[],"Abre una CA desde el inventario para consultar:",{"_3146":65333,"_27538":65273,"_19130":110729,"_5":13154,"_26074":110594,"_2645":110730},[],"Estado y periodo de validez.",{"_3146":65334,"_27538":65273,"_19130":110732,"_5":13154,"_26074":110594,"_2645":110733},[],"Certificado y cadena en formato PEM.",{"_3146":65335,"_27538":65273,"_19130":110735,"_5":13154,"_26074":110594,"_2645":110736},[],"Número de certificados activos, expirados y revocados.",{"_3146":65336,"_27538":65273,"_19130":110738,"_5":13154,"_26074":110594,"_2645":110739},[],"Certificados emitidos en **Issued Certificates**.",{"_3146":65337,"_27538":65273,"_19130":110741,"_5":13154,"_26074":110594,"_2645":110742},[],"CRL vinculada a la autoridad.",{"_3146":65338,"_27538":65273,"_19130":110744,"_5":13154,"_26074":110594,"_2645":110745},[],"Metadatos y motor criptográfico asociado.",{"_3146":65339,"_27538":65273,"_19130":110747,"_5":13154,"_26074":110594,"_2645":110748},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3146":65340,"_27538":65273,"_19130":110750,"_5":13154,"_26074":110598,"_2645":110751},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3146":65341,"_27538":65273,"_19130":110753,"_5":13154,"_26074":110598,"_2645":110754},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3146":65342,"_27538":65273,"_19130":110756,"_5":13154,"_26074":110598,"_2645":110757},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3146":65343,"_27538":65273,"_19130":110759,"_5":13154,"_26074":110598,"_2645":110760},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3146":65344,"_27538":65273,"_19130":110762,"_5":13154,"_26074":110602,"_2645":110763},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3146":65345,"_27538":65273,"_19130":110765,"_5":13154,"_26074":110606,"_2645":110766},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3146":65346,"_27538":65273,"_19130":110768,"_5":13154,"_26074":110610,"_2645":110769},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3146":65347,"_27538":65273,"_19130":110771,"_5":13154,"_26074":110614,"_2645":110772},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3146":65348,"_27538":65273,"_19130":110774,"_5":13154,"_26074":110618,"_2645":110775},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3146":65349,"_27538":65273,"_19130":110777,"_5":13154,"_26074":110618,"_2645":110778},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3146":65350,"_27538":65350,"_5":13480,"_2645":110780,"_27881":110781,"_19130":110782,"_26074":65350},"Perfiles de certificado",[44830,106777,49906,110368],[],{"_3146":65351,"_27538":65350,"_19130":110784,"_5":13154,"_26074":65350,"_2645":110785},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3146":65352,"_27538":65350,"_5":27878,"_19130":110787,"_26074":110788,"_2645":110789},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3146":65353,"_27538":65350,"_5":27878,"_19130":110791,"_26074":110792,"_2645":110793},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#validez","Validez",{"_3146":65354,"_27538":65350,"_5":27878,"_19130":110795,"_26074":110796,"_2645":110797},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3146":65355,"_27538":65350,"_5":27878,"_19130":110799,"_26074":110800,"_2645":110801},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3146":65356,"_27538":65350,"_5":27878,"_19130":110803,"_26074":110804,"_2645":110805},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3146":65357,"_27538":65350,"_5":27878,"_19130":110807,"_26074":110808,"_2645":110809},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3146":65358,"_27538":65350,"_5":27878,"_19130":110811,"_26074":110812,"_2645":110813},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3146":65359,"_27538":65350,"_5":27878,"_19130":110815,"_26074":110816,"_2645":110817},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3146":65360,"_27538":65350,"_5":27878,"_19130":110819,"_26074":110820,"_2645":110821},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3146":65361,"_27538":65350,"_5":27878,"_19130":110823,"_26074":110824,"_2645":110825},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3146":65362,"_27538":65350,"_5":27878,"_19130":110827,"_26074":110828,"_2645":110829},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3146":65363,"_27538":65350,"_5":27878,"_19130":110831,"_26074":110832,"_2645":110833},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3146":65364,"_27538":65350,"_5":27878,"_19130":110835,"_26074":110836,"_2645":110837},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3146":65365,"_27538":65350,"_5":27878,"_19130":110839,"_26074":110840,"_2645":110841},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3146":65366,"_27538":65350,"_5":27878,"_19130":110843,"_26074":110844,"_2645":110845},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3146":65367,"_27538":65350,"_5":27878,"_19130":110847,"_26074":110848,"_2645":110849},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3146":65368,"_27538":65350,"_19130":110851,"_5":13154,"_26074":65350,"_2645":110852},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3146":65369,"_27538":65350,"_19130":110854,"_5":13154,"_26074":65350,"_2645":110855},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3146":65370,"_27538":65350,"_19130":110857,"_5":13154,"_26074":110792,"_2645":110858},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3146":65371,"_27538":65350,"_19130":110860,"_5":13154,"_26074":110792,"_2645":110861},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3146":65372,"_27538":65350,"_19130":110863,"_5":13154,"_26074":110796,"_2645":110864},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3146":65373,"_27538":65350,"_19130":110866,"_5":13154,"_26074":110800,"_2645":110867},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3146":65374,"_27538":65350,"_19130":110869,"_5":13154,"_26074":110800,"_2645":110870},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3146":65375,"_27538":65350,"_19130":110872,"_5":13154,"_26074":110800,"_2645":110873},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3146":65376,"_27538":65350,"_19130":110875,"_5":13154,"_26074":110804,"_2645":110876},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3146":65377,"_27538":65350,"_19130":110878,"_5":13154,"_26074":110808,"_2645":110879},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3146":65378,"_27538":65350,"_19130":110881,"_5":13154,"_26074":110808,"_2645":110882},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3146":65379,"_27538":65350,"_19130":110884,"_5":13154,"_26074":110812,"_2645":110885},[],"La aplicación criptográfica puede:",{"_3146":65380,"_27538":65350,"_19130":110887,"_5":13154,"_26074":110812,"_2645":110888},[],"permitir o bloquear claves RSA;",{"_3146":65381,"_27538":65350,"_19130":110890,"_5":13154,"_26074":110812,"_2645":110891},[],"limitar los tamaños RSA admitidos;",{"_3146":65382,"_27538":65350,"_19130":110893,"_5":13154,"_26074":110812,"_2645":110894},[],"permitir o bloquear claves ECDSA;",{"_3146":65383,"_27538":65350,"_19130":110896,"_5":13154,"_26074":110812,"_2645":110897},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3146":65384,"_27538":65350,"_19130":110899,"_5":13154,"_26074":110812,"_2645":110900},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3146":65385,"_27538":65350,"_19130":110902,"_5":13154,"_26074":110816,"_2645":110903},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3146":65386,"_27538":65350,"_19130":110905,"_5":13154,"_26074":110816,"_2645":106568},[],{"_3146":65387,"_27538":65350,"_19130":110907,"_5":13154,"_26074":110816,"_2645":110908},[],"Primera opción",{"_3146":65388,"_27538":65350,"_19130":110910,"_5":13154,"_26074":110816,"_2645":110911},[],"Segunda opción",{"_3146":65389,"_27538":65350,"_19130":110913,"_5":13154,"_26074":110816,"_2645":110914},[],"Si no hay ninguna",{"_3146":65390,"_27538":65350,"_19130":110916,"_5":13154,"_26074":110816,"_2645":110917},[],"Firma directa con una CA",{"_3146":65391,"_27538":65350,"_19130":110919,"_5":13154,"_26074":110816,"_2645":110920},[],"`issuance_profile` incluido en la solicitud",{"_3146":65392,"_27538":65350,"_19130":110922,"_5":13154,"_26074":110816,"_2645":110923},[],"`issuance_profile_id` de la solicitud",{"_3146":65393,"_27538":65350,"_19130":110925,"_5":13154,"_26074":110816,"_2645":110926},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3146":65394,"_27538":65350,"_19130":110928,"_5":13154,"_26074":110816,"_2645":110929},[],"Emisión mediante DMS",{"_3146":65395,"_27538":65350,"_19130":110931,"_5":13154,"_26074":110816,"_2645":50471},[],{"_3146":65396,"_27538":65350,"_19130":110933,"_5":13154,"_26074":110816,"_2645":110934},[],"`settings.issuance_profile` incluido en el DMS",{"_3146":65397,"_27538":65350,"_19130":110936,"_5":13154,"_26074":110816,"_2645":110937},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3146":65398,"_27538":65350,"_19130":110939,"_5":13154,"_26074":110816,"_2645":110940},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3146":65399,"_27538":65350,"_19130":110942,"_5":13154,"_26074":110816,"_2645":110943},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3146":65400,"_27538":65350,"_19130":110945,"_5":13154,"_26074":110824,"_2645":110946},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3146":65401,"_27538":65350,"_19130":110948,"_5":13154,"_26074":110828,"_2645":110949},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3146":65402,"_27538":65350,"_19130":110951,"_5":13154,"_26074":110832,"_2645":110952},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3146":65403,"_27538":65350,"_19130":110954,"_5":13154,"_26074":110836,"_2645":110955},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3146":65404,"_27538":65350,"_19130":110957,"_5":13154,"_26074":110840,"_2645":110958},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3146":65405,"_27538":65350,"_19130":110960,"_5":13154,"_26074":110840,"_2645":110961},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3146":65406,"_27538":65350,"_19130":110963,"_5":13154,"_26074":110844,"_2645":110964},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3146":65407,"_27538":65350,"_19130":110966,"_5":13154,"_26074":110844,"_2645":110967},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3146":65408,"_27538":65350,"_19130":110969,"_5":13154,"_26074":110844,"_2645":110970},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3146":65409,"_27538":65350,"_19130":110972,"_5":13154,"_26074":110844,"_2645":110973},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3146":65410,"_27538":65350,"_19130":110975,"_5":13154,"_26074":110848,"_2645":110976},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3146":65411,"_27538":65350,"_19130":110978,"_5":13154,"_26074":110848,"_2645":110979},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3146":65412,"_27538":65412,"_5":13480,"_2645":110981,"_27881":110982,"_19130":110984,"_26074":65412},"Validación de certificados",[44830,106777,49906,110983],"Validación",[],{"_3146":65413,"_27538":65412,"_19130":110986,"_5":13154,"_26074":65412,"_2645":110987},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3146":65414,"_27538":65412,"_5":27878,"_19130":110989,"_26074":110990,"_2645":110991},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3146":65415,"_27538":65412,"_5":27878,"_19130":110993,"_26074":110994,"_2645":110995},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3146":65416,"_27538":65412,"_5":27878,"_19130":110997,"_26074":110998,"_2645":110999},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3146":65417,"_27538":65412,"_19130":111001,"_5":13154,"_26074":65412,"_2645":111002},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3146":65418,"_27538":65412,"_19130":111004,"_5":13154,"_26074":110990,"_2645":111005},[],"Verifica estos criterios juntos:",{"_3146":65419,"_27538":65412,"_19130":111007,"_5":13154,"_26074":110990,"_2645":109995},[],{"_3146":65420,"_27538":65412,"_19130":111009,"_5":13154,"_26074":110990,"_2645":111010},[],"Resultado necesario",{"_3146":65421,"_27538":65412,"_19130":111012,"_5":13154,"_26074":110990,"_2645":111013},[],"Cadena y firma",{"_3146":65422,"_27538":65412,"_19130":111015,"_5":13154,"_26074":110990,"_2645":111016},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3146":65423,"_27538":65412,"_19130":111018,"_5":13154,"_26074":110990,"_2645":111019},[],"Fechas",{"_3146":65424,"_27538":65412,"_19130":111021,"_5":13154,"_26074":110990,"_2645":111022},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3146":65425,"_27538":65412,"_19130":111024,"_5":13154,"_26074":110990,"_2645":106478},[],{"_3146":65426,"_27538":65412,"_19130":111026,"_5":13154,"_26074":110990,"_2645":111027},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3146":65427,"_27538":65412,"_19130":111029,"_5":13154,"_26074":110990,"_2645":111030},[],"Uso",{"_3146":65428,"_27538":65412,"_19130":111032,"_5":13154,"_26074":110990,"_2645":111033},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3146":65429,"_27538":65412,"_19130":111035,"_5":13154,"_26074":110990,"_2645":111036},[],"Revocación",{"_3146":65430,"_27538":65412,"_19130":111038,"_5":13154,"_26074":110990,"_2645":111039},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3146":65431,"_27538":65412,"_19130":111041,"_5":13154,"_26074":110990,"_2645":111042},[],"Autorización",{"_3146":65432,"_27538":65412,"_19130":111044,"_5":13154,"_26074":110990,"_2645":111045},[],"La aplicación permite la acción a esa identidad.",{"_3146":65433,"_27538":65412,"_19130":111047,"_5":13154,"_26074":110990,"_2645":111048},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3146":65434,"_27538":65412,"_19130":111050,"_5":13154,"_26074":110994,"_2645":111051},[],"Mecanismo",{"_3146":65435,"_27538":65412,"_19130":111053,"_5":13154,"_26074":110994,"_2645":111054},[],"Cuándo utilizarlo",{"_3146":65436,"_27538":65412,"_19130":111056,"_5":13154,"_26074":110994,"_2645":111057},[],"Qué debes mantener",{"_3146":65437,"_27538":65412,"_19130":111059,"_5":13154,"_26074":110994,"_2645":50599},[],{"_3146":65438,"_27538":65412,"_19130":111061,"_5":13154,"_26074":110994,"_2645":111062},[],"Consulta del estado de un certificado concreto.",{"_3146":65439,"_27538":65412,"_19130":111064,"_5":13154,"_26074":110994,"_2645":111065},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3146":65440,"_27538":65412,"_19130":111067,"_5":13154,"_26074":110994,"_2645":50608},[],{"_3146":65441,"_27538":65412,"_19130":111069,"_5":13154,"_26074":110994,"_2645":111070},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3146":65442,"_27538":65412,"_19130":111072,"_5":13154,"_26074":110994,"_2645":111073},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3146":65443,"_27538":65412,"_19130":111075,"_5":13154,"_26074":110994,"_2645":111076},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3146":65444,"_27538":65412,"_19130":111078,"_5":13154,"_26074":110994,"_2645":111079},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3146":65445,"_27538":65412,"_19130":111081,"_5":13154,"_26074":110998,"_2645":111082},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3146":65446,"_27538":65412,"_19130":111084,"_5":13154,"_26074":110998,"_2645":111085},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3146":65447,"_27538":65412,"_19130":111087,"_5":13154,"_26074":110998,"_2645":111088},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3146":65448,"_27538":65412,"_19130":111090,"_5":13154,"_26074":110998,"_2645":111091},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3146":65449,"_27538":65412,"_19130":111093,"_5":13154,"_26074":110998,"_2645":111094},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3146":65450,"_27538":65412,"_19130":111096,"_5":13154,"_26074":110998,"_2645":111097},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3146":65451,"_27538":65412,"_19130":111099,"_5":13154,"_26074":110998,"_2645":111100},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3146":65452,"_27538":65412,"_19130":111102,"_5":13154,"_26074":110998,"_2645":111103},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3146":65453,"_27538":65412,"_19130":111105,"_5":13154,"_26074":110998,"_2645":111106},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3146":65454,"_27538":65454,"_5":13480,"_2645":111108,"_27881":111109,"_19130":111110,"_26074":65454},"Certificados",[44830,106777,49906,110368],[],{"_3146":65455,"_27538":65454,"_19130":111112,"_5":13154,"_26074":65454,"_2645":111113},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3146":65456,"_27538":65454,"_5":27878,"_19130":111115,"_26074":111116,"_2645":111117},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3146":65457,"_27538":65454,"_5":27878,"_19130":111119,"_26074":111120,"_2645":111121},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3146":65458,"_27538":65454,"_5":27878,"_19130":111123,"_26074":111124,"_2645":111125},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3146":65459,"_27538":65454,"_5":27878,"_19130":111127,"_26074":111128,"_2645":111129},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3146":65460,"_27538":65454,"_5":27878,"_19130":111131,"_26074":111132,"_2645":111133},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3146":65461,"_27538":65454,"_5":27878,"_19130":111135,"_26074":111136,"_2645":111137},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3146":65462,"_27538":65454,"_5":27878,"_19130":111139,"_26074":111140,"_2645":111141},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3146":65463,"_27538":65454,"_5":27878,"_19130":111143,"_26074":111144,"_2645":111145},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3146":65464,"_27538":65454,"_5":27878,"_19130":111147,"_26074":111148,"_2645":111149},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#continúa","Continúa",{"_3146":65465,"_27538":65454,"_19130":111151,"_5":13154,"_26074":65454,"_2645":111152},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3146":65466,"_27538":65454,"_19130":111154,"_5":13154,"_26074":111116,"_2645":111155},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3146":65467,"_27538":65454,"_19130":111157,"_5":13154,"_26074":111116,"_2645":111158},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3146":65468,"_27538":65454,"_19130":111160,"_5":13154,"_26074":111120,"_2645":111161},[],"Descarga el PEM e inspecciónalo:",{"_3146":65469,"_27538":65454,"_19130":111163,"_5":13154,"_26074":111120,"_2645":111164},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3146":65470,"_27538":65454,"_19130":111166,"_5":13154,"_26074":111124,"_2645":111167},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3146":65471,"_27538":65454,"_19130":111169,"_5":13154,"_26074":111124,"_2645":111170},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3146":65472,"_27538":65454,"_19130":111172,"_5":13154,"_26074":111124,"_2645":111173},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3146":65473,"_27538":65454,"_19130":111175,"_5":13154,"_26074":111124,"_2645":111176},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3146":65474,"_27538":65454,"_19130":111178,"_5":13154,"_26074":111124,"_2645":111179},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3146":65475,"_27538":65454,"_19130":111181,"_5":13154,"_26074":111124,"_2645":111182},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3146":65476,"_27538":65454,"_19130":111184,"_5":13154,"_26074":111124,"_2645":111185},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3146":65477,"_27538":65454,"_19130":111187,"_5":13154,"_26074":111128,"_2645":111188},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3146":65478,"_27538":65454,"_19130":111190,"_5":13154,"_26074":111132,"_2645":111191},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3146":65479,"_27538":65454,"_19130":111193,"_5":13154,"_26074":111136,"_2645":111194},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3146":65480,"_27538":65454,"_19130":111196,"_5":13154,"_26074":111140,"_2645":111197},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3146":65481,"_27538":65454,"_19130":111199,"_5":13154,"_26074":111140,"_2645":111200},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3146":65482,"_27538":65454,"_19130":111202,"_5":13154,"_26074":111140,"_2645":111203},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3146":65483,"_27538":65454,"_19130":111205,"_5":13154,"_26074":111144,"_2645":111206},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3146":65484,"_27538":65454,"_19130":111208,"_5":13154,"_26074":111144,"_2645":111209},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3146":65485,"_27538":65454,"_19130":111211,"_5":13154,"_26074":111144,"_2645":111212},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3146":65486,"_27538":65454,"_19130":111214,"_5":13154,"_26074":111148,"_2645":111215},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3146":65487,"_27538":65454,"_19130":111217,"_5":13154,"_26074":111148,"_2645":111218},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3146":65488,"_27538":65488,"_5":13480,"_2645":111220,"_27881":111221,"_19130":111223,"_26074":65488},"Ciclo de vida de un certificado",[44830,106777,49906,111222],"Conceptos",[],{"_3146":65489,"_27538":65488,"_19130":111225,"_5":13154,"_26074":65488,"_2645":111226},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3146":65490,"_27538":65488,"_5":27878,"_19130":111228,"_26074":111229,"_2645":111230},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3146":65491,"_27538":65488,"_5":27878,"_19130":111232,"_26074":111233,"_2645":111234},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3146":65492,"_27538":65488,"_5":27878,"_19130":111236,"_26074":111237,"_2645":111238},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3146":65493,"_27538":65488,"_5":27878,"_19130":111240,"_26074":111241,"_2645":111242},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3146":65494,"_27538":65488,"_5":27878,"_19130":111244,"_26074":111245,"_2645":111246},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3146":65495,"_27538":65488,"_5":27878,"_19130":111248,"_26074":111249,"_2645":111250},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3146":65496,"_27538":65488,"_5":27878,"_19130":111252,"_26074":111253,"_2645":111254},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3146":65497,"_27538":65488,"_5":27878,"_19130":111256,"_26074":111257,"_2645":111258},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3146":65498,"_27538":65488,"_5":27878,"_19130":111260,"_26074":111261,"_2645":111262},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3146":65499,"_27538":65488,"_5":27878,"_19130":111264,"_26074":111265,"_2645":111266},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3146":65500,"_27538":65488,"_19130":111268,"_5":13154,"_26074":65488,"_2645":111269},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3146":65501,"_27538":65488,"_19130":111271,"_5":13154,"_26074":111233,"_2645":111272},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3146":65502,"_27538":65488,"_19130":111274,"_5":13154,"_26074":111237,"_2645":111275},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3146":65503,"_27538":65488,"_19130":111277,"_5":13154,"_26074":111241,"_2645":111278},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3146":65504,"_27538":65488,"_19130":111280,"_5":13154,"_26074":111245,"_2645":111281},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3146":65505,"_27538":65488,"_19130":111283,"_5":13154,"_26074":111249,"_2645":111284},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3146":65506,"_27538":65488,"_19130":111286,"_5":13154,"_26074":111253,"_2645":111287},[],"Lamassu persiste cuatro estados X.509:",{"_3146":65507,"_27538":65488,"_19130":111289,"_5":13154,"_26074":111253,"_2645":111290},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3146":65508,"_27538":65488,"_19130":111292,"_5":13154,"_26074":111253,"_2645":111293},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3146":65509,"_27538":65488,"_19130":111295,"_5":13154,"_26074":111253,"_2645":111296},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3146":65510,"_27538":65488,"_19130":111298,"_5":13154,"_26074":111253,"_2645":111299},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3146":65511,"_27538":65488,"_19130":111301,"_5":13154,"_26074":111253,"_2645":111302},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3146":65512,"_27538":65488,"_19130":111304,"_5":13154,"_26074":111257,"_2645":111305},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3146":65513,"_27538":65488,"_19130":111307,"_5":13154,"_26074":111257,"_2645":111308},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3146":65514,"_27538":65488,"_19130":111310,"_5":13154,"_26074":111257,"_2645":111311},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3146":65515,"_27538":65488,"_19130":111313,"_5":13154,"_26074":111261,"_2645":111314},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3146":65516,"_27538":65488,"_19130":111316,"_5":13154,"_26074":111261,"_2645":111317},[],"Antes de confirmar:",{"_3146":65517,"_27538":65488,"_19130":111319,"_5":13154,"_26074":111261,"_2645":111320},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3146":65518,"_27538":65488,"_19130":111322,"_5":13154,"_26074":111261,"_2645":111323},[],"Distribuye la nueva cadena de confianza.",{"_3146":65519,"_27538":65488,"_19130":111325,"_5":13154,"_26074":111261,"_2645":111326},[],"Reemite las identidades necesarias.",{"_3146":65520,"_27538":65488,"_19130":111328,"_5":13154,"_26074":111261,"_2645":111329},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3146":65521,"_27538":65488,"_19130":111331,"_5":13154,"_26074":111261,"_2645":111332},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3146":65522,"_27538":65488,"_19130":111334,"_5":13154,"_26074":111261,"_2645":111335},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3146":65523,"_27538":65488,"_19130":111337,"_5":13154,"_26074":111265,"_2645":111338},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3146":65524,"_27538":65488,"_19130":111340,"_5":13154,"_26074":111265,"_2645":111341},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3146":65525,"_27538":65488,"_19130":111343,"_5":13154,"_26074":111265,"_2645":111344},[],"Cambios de estado y razones de revocación.",{"_3146":65526,"_27538":65488,"_19130":111346,"_5":13154,"_26074":111265,"_2645":111347},[],"Publicación y vigencia de OCSP y CRLs.",{"_3146":65527,"_27538":65488,"_19130":111349,"_5":13154,"_26074":111265,"_2645":111350},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3146":65528,"_27538":65488,"_19130":111352,"_5":13154,"_26074":111265,"_2645":111353},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3146":65529,"_27538":65529,"_5":13480,"_2645":111355,"_27881":111356,"_19130":111357,"_26074":65529},"Modelo de confianza",[44830,106777,49906,111222],[],{"_3146":65530,"_27538":65529,"_19130":111359,"_5":13154,"_26074":65529,"_2645":111360},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3146":65531,"_27538":65529,"_5":27878,"_19130":111362,"_26074":111363,"_2645":111364},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3146":65532,"_27538":65529,"_5":27878,"_19130":111366,"_26074":111367,"_2645":111368},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3146":65533,"_27538":65529,"_5":27878,"_19130":111370,"_26074":111371,"_2645":111372},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3146":65534,"_27538":65529,"_5":27878,"_19130":111374,"_26074":111375,"_2645":111376},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3146":65535,"_27538":65529,"_5":27878,"_19130":111378,"_26074":111379,"_2645":111380},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3146":65536,"_27538":65529,"_5":27878,"_19130":111382,"_26074":111383,"_2645":111384},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3146":65537,"_27538":65529,"_5":27878,"_19130":111386,"_26074":111387,"_2645":111388},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3146":65538,"_27538":65529,"_5":27878,"_19130":111390,"_26074":111391,"_2645":111392},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3146":65539,"_27538":65529,"_5":27878,"_19130":111394,"_26074":111395,"_2645":111396},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3146":65540,"_27538":65529,"_5":27878,"_19130":111398,"_26074":111399,"_2645":111400},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3146":65541,"_27538":65529,"_19130":111402,"_5":13154,"_26074":65529,"_2645":111403},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3146":65542,"_27538":65529,"_19130":111405,"_5":13154,"_26074":111367,"_2645":111406},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3146":65543,"_27538":65529,"_19130":111408,"_5":13154,"_26074":111371,"_2645":111409},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3146":65544,"_27538":65529,"_19130":111411,"_5":13154,"_26074":111375,"_2645":111412},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3146":65545,"_27538":65529,"_19130":111414,"_5":13154,"_26074":111379,"_2645":111415},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3146":65546,"_27538":65529,"_19130":111417,"_5":13154,"_26074":111383,"_2645":111418},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3146":65547,"_27538":65529,"_19130":111420,"_5":13154,"_26074":111383,"_2645":111421},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3146":65548,"_27538":65529,"_19130":111423,"_5":13154,"_26074":111383,"_2645":111424},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3146":65549,"_27538":65529,"_19130":111426,"_5":13154,"_26074":111383,"_2645":111427},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3146":65550,"_27538":65529,"_19130":111429,"_5":13154,"_26074":111383,"_2645":111430},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3146":65551,"_27538":65529,"_19130":111432,"_5":13154,"_26074":111383,"_2645":111433},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3146":65552,"_27538":65529,"_19130":111435,"_5":13154,"_26074":111387,"_2645":111436},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3146":65553,"_27538":65529,"_19130":111438,"_5":13154,"_26074":111387,"_2645":111439},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3146":65554,"_27538":65529,"_19130":111441,"_5":13154,"_26074":111387,"_2645":111442},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_3146":65555,"_27538":65529,"_19130":111444,"_5":13154,"_26074":111387,"_2645":111445},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3146":65556,"_27538":65529,"_19130":111447,"_5":13154,"_26074":111387,"_2645":111448},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3146":65557,"_27538":65529,"_19130":111450,"_5":13154,"_26074":111391,"_2645":111451},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3146":65558,"_27538":65529,"_19130":111453,"_5":13154,"_26074":111391,"_2645":111454},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3146":65559,"_27538":65529,"_19130":111456,"_5":13154,"_26074":111391,"_2645":111457},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3146":65560,"_27538":65529,"_19130":111459,"_5":13154,"_26074":111391,"_2645":111460},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3146":65561,"_27538":65529,"_19130":111462,"_5":13154,"_26074":111391,"_2645":111463},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3146":65562,"_27538":65529,"_19130":111465,"_5":13154,"_26074":111391,"_2645":111466},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3146":65563,"_27538":65529,"_19130":111468,"_5":13154,"_26074":111391,"_2645":111469},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3146":65564,"_27538":65529,"_19130":111471,"_5":13154,"_26074":111395,"_2645":111472},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3146":65565,"_27538":65529,"_19130":111474,"_5":13154,"_26074":111399,"_2645":111475},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3146":65566,"_27538":65529,"_19130":111477,"_5":13154,"_26074":111399,"_2645":111478},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3146":65567,"_27538":65529,"_19130":111480,"_5":13154,"_26074":111399,"_2645":111481},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3146":65568,"_27538":65529,"_19130":111483,"_5":13154,"_26074":111399,"_2645":111484},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3146":65569,"_27538":65529,"_19130":111486,"_5":13154,"_26074":111399,"_2645":111487},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3146":65570,"_27538":65529,"_19130":111489,"_5":13154,"_26074":111399,"_2645":111490},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3146":65571,"_27538":65529,"_19130":111492,"_5":13154,"_26074":111399,"_2645":111493},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3146":65572,"_27538":65572,"_5":13480,"_2645":111495,"_27881":111496,"_19130":111497,"_26074":65572},"Listas de revocación (CRL)",[44830,106777,49906,110983],[],{"_3146":65573,"_27538":65572,"_19130":111499,"_5":13154,"_26074":65572,"_2645":111500},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3146":65574,"_27538":65572,"_5":27878,"_19130":111502,"_26074":111503,"_2645":111504},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3146":65575,"_27538":65572,"_5":27878,"_19130":111506,"_26074":111507,"_2645":111508},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3146":65576,"_27538":65572,"_5":27878,"_19130":111510,"_26074":111511,"_2645":111512},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3146":65577,"_27538":65572,"_5":27878,"_19130":111514,"_26074":111515,"_2645":111516},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3146":65578,"_27538":65572,"_5":27878,"_19130":111518,"_26074":111519,"_2645":111520},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3146":65579,"_27538":65572,"_5":27878,"_19130":111522,"_26074":111523,"_2645":111524},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3146":65580,"_27538":65572,"_5":27878,"_19130":111526,"_26074":111527,"_2645":111528},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#referencias","Referencias",{"_3146":65581,"_27538":65572,"_19130":111530,"_5":13154,"_26074":65572,"_2645":111531},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3146":65582,"_27538":65572,"_19130":111533,"_5":13154,"_26074":111503,"_2645":111534},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3146":65583,"_27538":65572,"_19130":111536,"_5":13154,"_26074":111503,"_2645":111537},[],"Campo de `crl_options`",{"_3146":65584,"_27538":65572,"_19130":111539,"_5":13154,"_26074":111503,"_2645":108276},[],{"_3146":65585,"_27538":65572,"_19130":111541,"_5":13154,"_26074":111503,"_2645":111542},[],"Valor inicial del backend",{"_3146":65586,"_27538":65572,"_19130":111544,"_5":13154,"_26074":111503,"_2645":51086},[],{"_3146":65587,"_27538":65572,"_19130":111546,"_5":13154,"_26074":111503,"_2645":111547},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3146":65588,"_27538":65572,"_19130":111549,"_5":13154,"_26074":111503,"_2645":111550},[],"7 días.",{"_3146":65589,"_27538":65572,"_19130":111552,"_5":13154,"_26074":111503,"_2645":51095},[],{"_3146":65590,"_27538":65572,"_19130":111554,"_5":13154,"_26074":111503,"_2645":111555},[],"Plazo desde la publicación que activa la renovación programada.",{"_3146":65591,"_27538":65572,"_19130":111557,"_5":13154,"_26074":111503,"_2645":111558},[],"6 días y 23 horas.",{"_3146":65592,"_27538":65572,"_19130":111560,"_5":13154,"_26074":111503,"_2645":51104},[],{"_3146":65593,"_27538":65572,"_19130":111562,"_5":13154,"_26074":111503,"_2645":111563},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3146":65594,"_27538":65572,"_19130":111565,"_5":13154,"_26074":111503,"_2645":51110},[],{"_3146":65595,"_27538":65572,"_19130":111567,"_5":13154,"_26074":111503,"_2645":51113},[],{"_3146":65596,"_27538":65572,"_19130":111569,"_5":13154,"_26074":111503,"_2645":111570},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3146":65597,"_27538":65572,"_19130":111572,"_5":13154,"_26074":111503,"_2645":111573},[],"SKI de la CA.",{"_3146":65598,"_27538":65572,"_19130":111575,"_5":13154,"_26074":111503,"_2645":111576},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3146":65599,"_27538":65572,"_19130":111578,"_5":13154,"_26074":111503,"_2645":111579},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3146":65600,"_27538":65572,"_19130":111581,"_5":13154,"_26074":111507,"_2645":111582},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3146":65601,"_27538":65572,"_19130":111584,"_5":13154,"_26074":111507,"_2645":111585},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3146":65602,"_27538":65572,"_19130":111587,"_5":13154,"_26074":111507,"_2645":111588},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3146":65603,"_27538":65572,"_19130":111590,"_5":13154,"_26074":111511,"_2645":111591},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3146":65604,"_27538":65572,"_19130":111593,"_5":13154,"_26074":111511,"_2645":111594},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3146":65605,"_27538":65572,"_19130":111596,"_5":13154,"_26074":111515,"_2645":111597},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3146":65606,"_27538":65572,"_19130":111599,"_5":13154,"_26074":111515,"_2645":111600},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3146":65607,"_27538":65572,"_19130":111602,"_5":13154,"_26074":111515,"_2645":111603},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3146":65608,"_27538":65572,"_19130":111605,"_5":13154,"_26074":111515,"_2645":111606},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3146":65609,"_27538":65572,"_19130":111608,"_5":13154,"_26074":111515,"_2645":111609},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3146":65610,"_27538":65572,"_19130":111611,"_5":13154,"_26074":111519,"_2645":111612},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3146":65611,"_27538":65572,"_19130":111614,"_5":13154,"_26074":111519,"_2645":108465},[],{"_3146":65612,"_27538":65572,"_19130":111616,"_5":13154,"_26074":111519,"_2645":111617},[],"Path relativo",{"_3146":65613,"_27538":65572,"_19130":111619,"_5":13154,"_26074":111519,"_2645":106568},[],{"_3146":65614,"_27538":65572,"_19130":111621,"_5":13154,"_26074":111519,"_2645":51168},[],{"_3146":65615,"_27538":65572,"_19130":111623,"_5":13154,"_26074":111519,"_2645":51171},[],{"_3146":65616,"_27538":65572,"_19130":111625,"_5":13154,"_26074":111519,"_2645":111626},[],"Consultar `crl_options` y `latest_crl`.",{"_3146":65617,"_27538":65572,"_19130":111628,"_5":13154,"_26074":111519,"_2645":51177},[],{"_3146":65618,"_27538":65572,"_19130":111630,"_5":13154,"_26074":111519,"_2645":51171},[],{"_3146":65619,"_27538":65572,"_19130":111632,"_5":13154,"_26074":111519,"_2645":111633},[],"Sustituir la configuración de CRL.",{"_3146":65620,"_27538":65572,"_19130":111635,"_5":13154,"_26074":111519,"_2645":111636},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3146":65621,"_27538":65572,"_19130":111638,"_5":13154,"_26074":111519,"_2645":111639},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3146":65622,"_27538":65572,"_19130":111641,"_5":13154,"_26074":111523,"_2645":111642},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3146":65623,"_27538":65572,"_19130":111644,"_5":13154,"_26074":111527,"_2645":111645},[],"RFC 5280: perfil X.509 y CRL.",{"_3146":65624,"_27538":65572,"_19130":111647,"_5":13154,"_26074":111527,"_2645":51197},[],{"_3146":65625,"_27538":65572,"_19130":111649,"_5":13154,"_26074":111527,"_2645":51200},[],{"_3146":65626,"_27538":65572,"_19130":111651,"_5":13154,"_26074":111527,"_2645":111652},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3146":65627,"_27538":65572,"_19130":111654,"_5":13154,"_26074":111527,"_2645":111655},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3146":65628,"_27538":65628,"_5":13480,"_2645":111657,"_27881":111658,"_19130":111659,"_26074":65628},"Claves y motores criptográficos",[44830,106777,49906,110368],[],{"_3146":65629,"_27538":65628,"_19130":111661,"_5":13154,"_26074":65628,"_2645":111662},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3146":65630,"_27538":65628,"_5":27878,"_19130":111664,"_26074":111665,"_2645":111666},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3146":65631,"_27538":65628,"_5":27878,"_19130":111668,"_26074":111669,"_2645":111670},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3146":65632,"_27538":65628,"_5":27878,"_19130":111672,"_26074":111673,"_2645":51225},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#file-system",{"_3146":65633,"_27538":65628,"_5":27878,"_19130":111675,"_26074":111676,"_2645":51229},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#hashicorp-vault",{"_3146":65634,"_27538":65628,"_5":27878,"_19130":111678,"_26074":111679,"_2645":51233},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#aws-secrets-manager",{"_3146":65635,"_27538":65628,"_5":27878,"_19130":111681,"_26074":111682,"_2645":51237},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#aws-kms",{"_3146":65636,"_27538":65628,"_5":27878,"_19130":111684,"_26074":111685,"_2645":51241},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#pkcs11",{"_3146":65637,"_27538":65628,"_5":27878,"_19130":111687,"_26074":111688,"_2645":51245},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#azure-key-vault",{"_3146":65638,"_27538":65628,"_5":27878,"_19130":111690,"_26074":111691,"_2645":111692},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3146":65639,"_27538":65628,"_5":27878,"_19130":111694,"_26074":111695,"_2645":111696},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3146":65640,"_27538":65628,"_5":27878,"_19130":111698,"_26074":111699,"_2645":111700},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3146":65641,"_27538":65628,"_5":27878,"_19130":111702,"_26074":111703,"_2645":111704},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3146":65642,"_27538":65628,"_5":27878,"_19130":111706,"_26074":111707,"_2645":111708},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3146":65643,"_27538":65628,"_5":27878,"_19130":111710,"_26074":111711,"_2645":111712},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3146":65644,"_27538":65628,"_5":27878,"_19130":111714,"_26074":111715,"_2645":111716},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3146":65645,"_27538":65628,"_5":27878,"_19130":111718,"_26074":111719,"_2645":51277},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#sign",{"_3146":65646,"_27538":65628,"_5":27878,"_19130":111721,"_26074":111722,"_2645":51281},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#verify",{"_3146":65647,"_27538":65628,"_5":27878,"_19130":111724,"_26074":111725,"_2645":111726},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3146":65648,"_27538":65628,"_5":27878,"_19130":111728,"_26074":111729,"_2645":111730},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3146":65649,"_27538":65628,"_5":27878,"_19130":111732,"_26074":111733,"_2645":111734},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3146":65650,"_27538":65628,"_19130":111736,"_5":13154,"_26074":65628,"_2645":111737},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3146":65651,"_27538":65628,"_19130":111739,"_5":13154,"_26074":65628,"_2645":111740},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3146":65652,"_27538":65628,"_19130":111742,"_5":13154,"_26074":111665,"_2645":111743},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3146":65653,"_27538":65628,"_19130":111745,"_5":13154,"_26074":111665,"_2645":111746},[],"En la práctica, permite:",{"_3146":65654,"_27538":65628,"_19130":111748,"_5":13154,"_26074":111665,"_2645":111749},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3146":65655,"_27538":65628,"_19130":111751,"_5":13154,"_26074":111665,"_2645":111752},[],"Importar claves creadas externamente.",{"_3146":65656,"_27538":65628,"_19130":111754,"_5":13154,"_26074":111665,"_2645":111755},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3146":65657,"_27538":65628,"_19130":111757,"_5":13154,"_26074":111665,"_2645":111758},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3146":65658,"_27538":65628,"_19130":111760,"_5":13154,"_26074":111669,"_2645":111761},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3146":65659,"_27538":65628,"_19130":111763,"_5":13154,"_26074":111669,"_2645":111764},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3146":65660,"_27538":65628,"_19130":111766,"_5":13154,"_26074":111669,"_2645":111767},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3146":65661,"_27538":65628,"_19130":111769,"_5":13154,"_26074":111673,"_2645":111770},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3146":65662,"_27538":65628,"_19130":111772,"_5":13154,"_26074":111676,"_2645":111773},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3146":65663,"_27538":65628,"_19130":111775,"_5":13154,"_26074":111679,"_2645":111776},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3146":65664,"_27538":65628,"_19130":111778,"_5":13154,"_26074":111682,"_2645":111779},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3146":65665,"_27538":65628,"_19130":111781,"_5":13154,"_26074":111685,"_2645":111782},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3146":65666,"_27538":65628,"_19130":111784,"_5":13154,"_26074":111688,"_2645":111785},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3146":65667,"_27538":65628,"_19130":111787,"_5":13154,"_26074":111688,"_2645":111788},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3146":65668,"_27538":65628,"_19130":111790,"_5":13154,"_26074":111688,"_2645":111791},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3146":65669,"_27538":65628,"_19130":111793,"_5":13154,"_26074":111688,"_2645":111794},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3146":65670,"_27538":65628,"_19130":111796,"_5":13154,"_26074":111691,"_2645":111797},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3146":65671,"_27538":65628,"_19130":111799,"_5":13154,"_26074":111691,"_2645":111800},[],"La tabla incluye los siguientes campos:",{"_3146":65672,"_27538":65628,"_19130":111802,"_5":13154,"_26074":111691,"_2645":111803},[],"**Name**: nombre descriptivo de la clave.",{"_3146":65673,"_27538":65628,"_19130":111805,"_5":13154,"_26074":111691,"_2645":111806},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3146":65674,"_27538":65628,"_19130":111808,"_5":13154,"_26074":111691,"_2645":111809},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3146":65675,"_27538":65628,"_19130":111811,"_5":13154,"_26074":111691,"_2645":111812},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3146":65676,"_27538":65628,"_19130":111814,"_5":13154,"_26074":111691,"_2645":111815},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3146":65677,"_27538":65628,"_19130":111817,"_5":13154,"_26074":111691,"_2645":111818},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3146":65678,"_27538":65628,"_19130":111820,"_5":13154,"_26074":111691,"_2645":111821},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3146":65679,"_27538":65628,"_19130":111823,"_5":13154,"_26074":111691,"_2645":111824},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3146":65680,"_27538":65628,"_19130":111826,"_5":13154,"_26074":111691,"_2645":111827},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3146":65681,"_27538":65628,"_19130":111829,"_5":13154,"_26074":111691,"_2645":111830},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3146":65682,"_27538":65628,"_19130":111832,"_5":13154,"_26074":111691,"_2645":111833},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3146":65683,"_27538":65628,"_19130":111835,"_5":13154,"_26074":111691,"_2645":111836},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3146":65684,"_27538":65628,"_19130":111838,"_5":13154,"_26074":111691,"_2645":111839},[],"**Delete Key** para eliminar la clave del sistema.",{"_3146":65685,"_27538":65628,"_19130":111841,"_5":13154,"_26074":111695,"_2645":111842},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3146":65686,"_27538":65628,"_19130":111844,"_5":13154,"_26074":111699,"_2645":111845},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3146":65687,"_27538":65628,"_19130":111847,"_5":13154,"_26074":111699,"_2645":111848},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3146":65688,"_27538":65628,"_19130":111850,"_5":13154,"_26074":111699,"_2645":111851},[],"**Key Name**: nombre único y descriptivo.",{"_3146":65689,"_27538":65628,"_19130":111853,"_5":13154,"_26074":111699,"_2645":111854},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3146":65690,"_27538":65628,"_19130":111856,"_5":13154,"_26074":111699,"_2645":111857},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3146":65691,"_27538":65628,"_19130":111859,"_5":13154,"_26074":111699,"_2645":111860},[],"**Tags**: metadatos para clasificar la clave.",{"_3146":65692,"_27538":65628,"_19130":111862,"_5":13154,"_26074":111699,"_2645":111863},[],"**Metadata**: información adicional para usos avanzados.",{"_3146":65693,"_27538":65628,"_19130":111865,"_5":13154,"_26074":111703,"_2645":111866},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3146":65694,"_27538":65628,"_19130":111868,"_5":13154,"_26074":111703,"_2645":111869},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3146":65695,"_27538":65628,"_19130":111871,"_5":13154,"_26074":111703,"_2645":111872},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3146":65696,"_27538":65628,"_19130":111874,"_5":13154,"_26074":111703,"_2645":111875},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3146":65697,"_27538":65628,"_19130":111877,"_5":13154,"_26074":111703,"_2645":111878},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3146":65698,"_27538":65628,"_19130":111880,"_5":13154,"_26074":111703,"_2645":111881},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3146":65699,"_27538":65628,"_19130":111883,"_5":13154,"_26074":111703,"_2645":111884},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3146":65700,"_27538":65628,"_19130":111886,"_5":13154,"_26074":111703,"_2645":111887},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3146":65701,"_27538":65628,"_19130":111889,"_5":13154,"_26074":111703,"_2645":111890},[],"**Metadata**: información adicional opcional.",{"_3146":65702,"_27538":65628,"_19130":111892,"_5":13154,"_26074":111703,"_2645":111893},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3146":65703,"_27538":65628,"_19130":111895,"_5":13154,"_26074":111703,"_2645":111896},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3146":65704,"_27538":65628,"_19130":111898,"_5":13154,"_26074":111707,"_2645":111899},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3146":65705,"_27538":65628,"_19130":111901,"_5":13154,"_26074":111711,"_2645":111902},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3146":65706,"_27538":65628,"_19130":111904,"_5":13154,"_26074":111711,"_2645":111905},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3146":65707,"_27538":65628,"_19130":111907,"_5":13154,"_26074":111711,"_2645":111908},[],"**Key Name**: nombre descriptivo.",{"_3146":65708,"_27538":65628,"_19130":111910,"_5":13154,"_26074":111711,"_2645":111911},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3146":65709,"_27538":65628,"_19130":111913,"_5":13154,"_26074":111711,"_2645":111914},[],"**Tags**: etiquetas asociadas.",{"_3146":65710,"_27538":65628,"_19130":111916,"_5":13154,"_26074":111711,"_2645":111917},[],"**Aliases**: nombres alternativos.",{"_3146":65711,"_27538":65628,"_19130":111919,"_5":13154,"_26074":111711,"_2645":111920},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3146":65712,"_27538":65628,"_19130":111922,"_5":13154,"_26074":111711,"_2645":111923},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3146":65713,"_27538":65628,"_19130":111925,"_5":13154,"_26074":111711,"_2645":111926},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3146":65714,"_27538":65628,"_19130":111928,"_5":13154,"_26074":111711,"_2645":111929},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3146":65715,"_27538":65628,"_19130":111931,"_5":13154,"_26074":111715,"_2645":111932},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3146":65716,"_27538":65628,"_19130":111934,"_5":13154,"_26074":111715,"_2645":111935},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3146":65717,"_27538":65628,"_19130":111937,"_5":13154,"_26074":111715,"_2645":111938},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3146":65718,"_27538":65628,"_19130":111940,"_5":13154,"_26074":111719,"_2645":111941},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3146":65719,"_27538":65628,"_19130":111943,"_5":13154,"_26074":111719,"_2645":111944},[],"Campos principales:",{"_3146":65720,"_27538":65628,"_19130":111946,"_5":13154,"_26074":111719,"_2645":111947},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3146":65721,"_27538":65628,"_19130":111949,"_5":13154,"_26074":111719,"_2645":111950},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3146":65722,"_27538":65628,"_19130":111952,"_5":13154,"_26074":111719,"_2645":111953},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3146":65723,"_27538":65628,"_19130":111955,"_5":13154,"_26074":111719,"_2645":111956},[],"**Message**: contenido que se va a firmar.",{"_3146":65724,"_27538":65628,"_19130":111958,"_5":13154,"_26074":111719,"_2645":111959},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3146":65725,"_27538":65628,"_19130":111961,"_5":13154,"_26074":111722,"_2645":111962},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3146":65726,"_27538":65628,"_19130":111964,"_5":13154,"_26074":111722,"_2645":111944},[],{"_3146":65727,"_27538":65628,"_19130":111966,"_5":13154,"_26074":111722,"_2645":111967},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3146":65728,"_27538":65628,"_19130":111969,"_5":13154,"_26074":111722,"_2645":111970},[],"**Message Type**: `Raw` o `Digest`.",{"_3146":65729,"_27538":65628,"_19130":111972,"_5":13154,"_26074":111722,"_2645":111973},[],"**Payload Encoding**: codificación del mensaje.",{"_3146":65730,"_27538":65628,"_19130":111975,"_5":13154,"_26074":111722,"_2645":111976},[],"**Message**: mensaje original o hash.",{"_3146":65731,"_27538":65628,"_19130":111978,"_5":13154,"_26074":111722,"_2645":111979},[],"**Signature**: firma que se desea comprobar.",{"_3146":65732,"_27538":65628,"_19130":111981,"_5":13154,"_26074":111722,"_2645":111982},[],"**Result**: indicador del resultado de la validación.",{"_3146":65733,"_27538":65628,"_19130":111984,"_5":13154,"_26074":111725,"_2645":111985},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3146":65734,"_27538":65628,"_19130":111987,"_5":13154,"_26074":111725,"_2645":111988},[],"Este flujo es útil para:",{"_3146":65735,"_27538":65628,"_19130":111990,"_5":13154,"_26074":111725,"_2645":111991},[],"Solicitar certificados a una CA externa.",{"_3146":65736,"_27538":65628,"_19130":111993,"_5":13154,"_26074":111725,"_2645":111994},[],"Renovar una identidad manteniendo la misma clave.",{"_3146":65737,"_27538":65628,"_19130":111996,"_5":13154,"_26074":111725,"_2645":111997},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3146":65738,"_27538":65628,"_19130":111999,"_5":13154,"_26074":111725,"_2645":112000},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3146":65739,"_27538":65628,"_19130":112002,"_5":13154,"_26074":111725,"_2645":112003},[],"**Organization (O)**: organización o empresa.",{"_3146":65740,"_27538":65628,"_19130":112005,"_5":13154,"_26074":111725,"_2645":112006},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3146":65741,"_27538":65628,"_19130":112008,"_5":13154,"_26074":111725,"_2645":112009},[],"**Country (C)**: código de país de dos letras.",{"_3146":65742,"_27538":65628,"_19130":112011,"_5":13154,"_26074":111725,"_2645":112012},[],"**State / Province (ST)**: estado o provincia.",{"_3146":65743,"_27538":65628,"_19130":112014,"_5":13154,"_26074":111725,"_2645":112015},[],"**Locality (L)**: ciudad o localidad.",{"_3146":65744,"_27538":65628,"_19130":112017,"_5":13154,"_26074":111725,"_2645":112018},[],"**Email Address**: correo de contacto.",{"_3146":65745,"_27538":65628,"_19130":112020,"_5":13154,"_26074":111725,"_2645":112021},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3146":65746,"_27538":65628,"_19130":112023,"_5":13154,"_26074":111725,"_2645":112024},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3146":65747,"_27538":65628,"_19130":112026,"_5":13154,"_26074":111729,"_2645":112027},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3146":65748,"_27538":65628,"_19130":112029,"_5":13154,"_26074":111729,"_2645":51589},[],{"_3146":65749,"_27538":65628,"_19130":112031,"_5":13154,"_26074":111733,"_2645":112032},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3146":65750,"_27538":65750,"_5":13480,"_2645":112034,"_27881":112035,"_19130":112036,"_26074":65750},"Validación online con OCSP",[44830,106777,49906,110983],[],{"_3146":65751,"_27538":65750,"_19130":112038,"_5":13154,"_26074":65750,"_2645":112039},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3146":65752,"_27538":65750,"_5":27878,"_19130":112041,"_26074":112042,"_2645":112043},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3146":65753,"_27538":65750,"_5":27878,"_19130":112045,"_26074":112046,"_2645":112047},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3146":65754,"_27538":65750,"_5":27878,"_19130":112049,"_26074":112050,"_2645":112051},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3146":65755,"_27538":65750,"_5":27878,"_19130":112053,"_26074":112054,"_2645":112055},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3146":65756,"_27538":65750,"_5":27878,"_19130":112057,"_26074":112058,"_2645":112059},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3146":65757,"_27538":65750,"_5":27878,"_19130":112061,"_26074":112062,"_2645":111528},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#referencias",{"_3146":65758,"_27538":65750,"_19130":112064,"_5":13154,"_26074":65750,"_2645":112065},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3146":65759,"_27538":65750,"_19130":112067,"_5":13154,"_26074":112042,"_2645":112068},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3146":65760,"_27538":65750,"_19130":112070,"_5":13154,"_26074":112042,"_2645":112071},[],"Estado del registro",{"_3146":65761,"_27538":65750,"_19130":112073,"_5":13154,"_26074":112042,"_2645":112074},[],"Respuesta firmada",{"_3146":65762,"_27538":65750,"_19130":112076,"_5":13154,"_26074":112042,"_2645":49084},[],{"_3146":65763,"_27538":65750,"_19130":112078,"_5":13154,"_26074":112042,"_2645":51639},[],{"_3146":65764,"_27538":65750,"_19130":112080,"_5":13154,"_26074":112042,"_2645":49101},[],{"_3146":65765,"_27538":65750,"_19130":112082,"_5":13154,"_26074":112042,"_2645":112083},[],"`Revoked`, con razón y fecha de revocación.",{"_3146":65766,"_27538":65750,"_19130":112085,"_5":13154,"_26074":112042,"_2645":112086},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3146":65767,"_27538":65750,"_19130":112088,"_5":13154,"_26074":112042,"_2645":112089},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3146":65768,"_27538":65750,"_19130":112091,"_5":13154,"_26074":112042,"_2645":112092},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3146":65769,"_27538":65750,"_19130":112094,"_5":13154,"_26074":112042,"_2645":112095},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3146":65770,"_27538":65750,"_19130":112097,"_5":13154,"_26074":112042,"_2645":112098},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3146":65771,"_27538":65750,"_19130":112100,"_5":13154,"_26074":112046,"_2645":112101},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3146":65772,"_27538":65750,"_19130":112103,"_5":13154,"_26074":112046,"_2645":112104},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3146":65773,"_27538":65750,"_19130":112106,"_5":13154,"_26074":112050,"_2645":112107},[],"El servicio acepta:",{"_3146":65774,"_27538":65750,"_19130":112109,"_5":13154,"_26074":112050,"_2645":108465},[],{"_3146":65775,"_27538":65750,"_19130":112111,"_5":13154,"_26074":112050,"_2645":112112},[],"Ruta del servicio VA",{"_3146":65776,"_27538":65750,"_19130":112114,"_5":13154,"_26074":112050,"_2645":112115},[],"Formato",{"_3146":65777,"_27538":65750,"_19130":112117,"_5":13154,"_26074":112050,"_2645":51679},[],{"_3146":65778,"_27538":65750,"_19130":112119,"_5":13154,"_26074":112050,"_2645":51682},[],{"_3146":65779,"_27538":65750,"_19130":112121,"_5":13154,"_26074":112050,"_2645":112122},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3146":65780,"_27538":65750,"_19130":112124,"_5":13154,"_26074":112050,"_2645":51168},[],{"_3146":65781,"_27538":65750,"_19130":112126,"_5":13154,"_26074":112050,"_2645":51690},[],{"_3146":65782,"_27538":65750,"_19130":112128,"_5":13154,"_26074":112050,"_2645":112129},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3146":65783,"_27538":65750,"_19130":112131,"_5":13154,"_26074":112050,"_2645":112132},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3146":65784,"_27538":65750,"_19130":112134,"_5":13154,"_26074":112054,"_2645":112135},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3146":65785,"_27538":65750,"_19130":112137,"_5":13154,"_26074":112054,"_2645":112138},[],"Genera la solicitud:",{"_3146":65786,"_27538":65750,"_19130":112140,"_5":13154,"_26074":112054,"_2645":112141},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3146":65787,"_27538":65750,"_19130":112143,"_5":13154,"_26074":112054,"_2645":112144},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3146":65788,"_27538":65750,"_19130":112146,"_5":13154,"_26074":112054,"_2645":112147},[],"Verifica el DER recibido:",{"_3146":65789,"_27538":65750,"_19130":112149,"_5":13154,"_26074":112054,"_2645":112150},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3146":65790,"_27538":65750,"_19130":112152,"_5":13154,"_26074":112058,"_2645":112153},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3146":65791,"_27538":65750,"_19130":112155,"_5":13154,"_26074":112058,"_2645":112156},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3146":65792,"_27538":65750,"_19130":112158,"_5":13154,"_26074":112062,"_2645":51723},[],{"_3146":65793,"_27538":65750,"_19130":112160,"_5":13154,"_26074":112062,"_2645":51726},[],{"_3146":65794,"_27538":65750,"_19130":112162,"_5":13154,"_26074":112062,"_2645":112163},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3146":65795,"_27538":65750,"_19130":112165,"_5":13154,"_26074":112062,"_2645":111655},[],{"_3146":65796,"_27538":65796,"_5":13480,"_2645":49906,"_27881":112167,"_19130":112168,"_26074":65796},[44830,106777,49906],[],{"_3146":65797,"_27538":65796,"_19130":112170,"_5":13154,"_26074":65796,"_2645":112171},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3146":65798,"_27538":65796,"_5":27878,"_19130":112173,"_26074":112174,"_2645":109692},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#empieza-aquí",{"_3146":65799,"_27538":65796,"_5":27878,"_19130":112176,"_26074":112177,"_2645":112178},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3146":65800,"_27538":65796,"_5":27878,"_19130":112180,"_26074":112181,"_2645":110214},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#capacidades-principales",{"_3146":65801,"_27538":65796,"_5":27878,"_19130":112183,"_26074":112184,"_2645":110218},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3146":65802,"_27538":65796,"_5":27878,"_19130":112186,"_26074":112187,"_2645":110222},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3146":65803,"_27538":65796,"_5":27878,"_19130":112189,"_26074":112190,"_2645":110226},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#emite-y-controla-certificados",{"_3146":65804,"_27538":65796,"_5":27878,"_19130":112192,"_26074":112193,"_2645":110234},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#publica-el-estado-de-validación",{"_3146":65805,"_27538":65796,"_5":27878,"_19130":112195,"_26074":112196,"_2645":112197},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3146":65806,"_27538":65796,"_5":27878,"_19130":112199,"_26074":112200,"_2645":111149},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#continúa",{"_3146":65807,"_27538":65796,"_19130":112202,"_5":13154,"_26074":65796,"_2645":112203},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3146":65808,"_27538":65796,"_19130":112205,"_5":13154,"_26074":112174,"_2645":112206},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3146":65809,"_27538":65796,"_19130":112208,"_5":13154,"_26074":112174,"_2645":112209},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3146":65810,"_27538":65796,"_19130":112211,"_5":13154,"_26074":112177,"_2645":112212},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3146":65811,"_27538":65796,"_19130":112214,"_5":13154,"_26074":112177,"_2645":112215},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3146":65812,"_27538":65796,"_19130":112217,"_5":13154,"_26074":112177,"_2645":112218},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3146":65813,"_27538":65796,"_19130":112220,"_5":13154,"_26074":112177,"_2645":112221},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3146":65814,"_27538":65796,"_19130":112223,"_5":13154,"_26074":112177,"_2645":112224},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3146":65815,"_27538":65796,"_19130":112226,"_5":13154,"_26074":112184,"_2645":112227},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3146":65816,"_27538":65796,"_19130":112229,"_5":13154,"_26074":112187,"_2645":112230},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3146":65817,"_27538":65796,"_19130":112232,"_5":13154,"_26074":112190,"_2645":112233},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3146":65818,"_27538":65796,"_19130":112235,"_5":13154,"_26074":112193,"_2645":112236},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3146":65819,"_27538":65796,"_19130":112238,"_5":13154,"_26074":112196,"_2645":112239},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3146":65820,"_27538":65796,"_19130":112241,"_5":13154,"_26074":112196,"_2645":112242},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3146":65821,"_27538":65796,"_19130":112244,"_5":13154,"_26074":112196,"_2645":112245},[],"su clave pública corresponda a la clave privada del cliente;",{"_3146":65822,"_27538":65796,"_19130":112247,"_5":13154,"_26074":112196,"_2645":112248},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3146":65823,"_27538":65796,"_19130":112250,"_5":13154,"_26074":112196,"_2645":112251},[],"sus fechas y usos permitan la operación;",{"_3146":65824,"_27538":65796,"_19130":112253,"_5":13154,"_26074":112196,"_2645":112254},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3146":65825,"_27538":65796,"_19130":112256,"_5":13154,"_26074":112196,"_2645":112257},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3146":65826,"_27538":65796,"_19130":112259,"_5":13154,"_26074":112200,"_2645":112260},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3146":65827,"_27538":65796,"_19130":112262,"_5":13154,"_26074":112200,"_2645":112263},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3146":65828,"_27538":65796,"_19130":112265,"_5":13154,"_26074":112200,"_2645":112266},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3146":65829,"_27538":65829,"_5":13480,"_2645":112268,"_27881":112269,"_19130":112270,"_26074":65829},"Crea tu primera CA",[44830,106777,49906,109816],[],{"_3146":65830,"_27538":65829,"_19130":112272,"_5":13154,"_26074":65829,"_2645":112273},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3146":65831,"_27538":65829,"_5":27878,"_19130":112275,"_26074":112276,"_2645":105443},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3146":65832,"_27538":65829,"_5":27878,"_19130":112278,"_26074":112279,"_2645":112280},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3146":65833,"_27538":65829,"_5":27878,"_19130":112282,"_26074":112283,"_2645":112284},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3146":65834,"_27538":65829,"_5":27878,"_19130":112286,"_26074":112287,"_2645":112288},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3146":65835,"_27538":65829,"_5":27878,"_19130":112290,"_26074":112291,"_2645":112292},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3146":65836,"_27538":65829,"_5":27878,"_19130":112294,"_26074":112295,"_2645":112296},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3146":65837,"_27538":65829,"_5":27878,"_19130":112298,"_26074":112299,"_2645":112300},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3146":65838,"_27538":65829,"_5":27878,"_19130":112302,"_26074":112303,"_2645":110064},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3146":65839,"_27538":65829,"_5":27878,"_19130":112305,"_26074":112306,"_2645":105467},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3146":65840,"_27538":65829,"_19130":112308,"_5":13154,"_26074":65829,"_2645":112309},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3146":65841,"_27538":65829,"_19130":112311,"_5":13154,"_26074":112276,"_2645":112312},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3146":65842,"_27538":65829,"_19130":112314,"_5":13154,"_26074":112276,"_2645":112315},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3146":65843,"_27538":65829,"_19130":112317,"_5":13154,"_26074":112276,"_2645":112318},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3146":65844,"_27538":65829,"_19130":112320,"_5":13154,"_26074":112276,"_2645":112321},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3146":65845,"_27538":65829,"_19130":112323,"_5":13154,"_26074":112279,"_2645":112324},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3146":65846,"_27538":65829,"_19130":112326,"_5":13154,"_26074":112279,"_2645":112327},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3146":65847,"_27538":65829,"_19130":112329,"_5":13154,"_26074":112283,"_2645":112330},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3146":65848,"_27538":65829,"_19130":112332,"_5":13154,"_26074":112283,"_2645":112333},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3146":65849,"_27538":65829,"_19130":112335,"_5":13154,"_26074":112287,"_2645":112336},[],"Selecciona **Root CA** y completa:",{"_3146":65850,"_27538":65829,"_19130":112338,"_5":13154,"_26074":112287,"_2645":51905},[],{"_3146":65851,"_27538":65829,"_19130":112340,"_5":13154,"_26074":112287,"_2645":112341},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3146":65852,"_27538":65829,"_19130":112343,"_5":13154,"_26074":112287,"_2645":112344},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3146":65853,"_27538":65829,"_19130":112346,"_5":13154,"_26074":112287,"_2645":112347},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3146":65854,"_27538":65829,"_19130":112349,"_5":13154,"_26074":112287,"_2645":112350},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3146":65855,"_27538":65829,"_19130":112352,"_5":13154,"_26074":112291,"_2645":112353},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3146":65856,"_27538":65829,"_19130":112355,"_5":13154,"_26074":112295,"_2645":112356},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3146":65857,"_27538":65829,"_19130":112358,"_5":13154,"_26074":112295,"_2645":112359},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3146":65858,"_27538":65829,"_19130":112361,"_5":13154,"_26074":112299,"_2645":112362},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3146":65859,"_27538":65829,"_19130":112364,"_5":13154,"_26074":112299,"_2645":112365},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3146":65860,"_27538":65829,"_19130":112367,"_5":13154,"_26074":112299,"_2645":112368},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3146":65861,"_27538":65829,"_19130":112370,"_5":13154,"_26074":112303,"_2645":112371},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3146":65862,"_27538":65829,"_19130":112373,"_5":13154,"_26074":112303,"_2645":112374},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3146":65863,"_27538":65829,"_19130":112376,"_5":13154,"_26074":112303,"_2645":112377},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3146":65864,"_27538":65829,"_19130":112379,"_5":13154,"_26074":112303,"_2645":112380},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3146":65865,"_27538":65829,"_19130":112382,"_5":13154,"_26074":112306,"_2645":112383},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3146":65866,"_27538":65866,"_5":13480,"_2645":112385,"_27881":112386,"_19130":112387,"_26074":65866},"Emite y verifica un certificado",[44830,106777,49906,109816],[],{"_3146":65867,"_27538":65866,"_19130":112389,"_5":13154,"_26074":65866,"_2645":112390},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3146":65868,"_27538":65866,"_5":27878,"_19130":112392,"_26074":112393,"_2645":105443},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3146":65869,"_27538":65866,"_5":27878,"_19130":112395,"_26074":112396,"_2645":112397},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3146":65870,"_27538":65866,"_5":27878,"_19130":112399,"_26074":112400,"_2645":112401},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3146":65871,"_27538":65866,"_5":27878,"_19130":112403,"_26074":112404,"_2645":112405},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3146":65872,"_27538":65866,"_5":27878,"_19130":112407,"_26074":112408,"_2645":112409},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3146":65873,"_27538":65866,"_5":27878,"_19130":112411,"_26074":112412,"_2645":112413},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3146":65874,"_27538":65866,"_5":27878,"_19130":112415,"_26074":112416,"_2645":112296},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3146":65875,"_27538":65866,"_5":27878,"_19130":112418,"_26074":112419,"_2645":112420},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3146":65876,"_27538":65866,"_5":27878,"_19130":112422,"_26074":112423,"_2645":112424},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3146":65877,"_27538":65866,"_5":27878,"_19130":112426,"_26074":112427,"_2645":112428},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3146":65878,"_27538":65866,"_5":27878,"_19130":112430,"_26074":112431,"_2645":110064},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3146":65879,"_27538":65866,"_5":27878,"_19130":112433,"_26074":112434,"_2645":105467},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3146":65880,"_27538":65866,"_19130":112436,"_5":13154,"_26074":65866,"_2645":112437},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3146":65881,"_27538":65866,"_19130":112439,"_5":13154,"_26074":112393,"_2645":112440},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3146":65882,"_27538":65866,"_19130":112442,"_5":13154,"_26074":112393,"_2645":112443},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3146":65883,"_27538":65866,"_19130":112445,"_5":13154,"_26074":112393,"_2645":112446},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3146":65884,"_27538":65866,"_19130":112448,"_5":13154,"_26074":112393,"_2645":112449},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3146":65885,"_27538":65866,"_19130":112451,"_5":13154,"_26074":112393,"_2645":112452},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3146":65886,"_27538":65866,"_19130":112454,"_5":13154,"_26074":112396,"_2645":112455},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3146":65887,"_27538":65866,"_19130":112457,"_5":13154,"_26074":112400,"_2645":112458},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3146":65888,"_27538":65866,"_19130":112460,"_5":13154,"_26074":112400,"_2645":112461},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3146":65889,"_27538":65866,"_19130":112463,"_5":13154,"_26074":112404,"_2645":112464},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3146":65890,"_27538":65866,"_19130":112466,"_5":13154,"_26074":112404,"_2645":112467},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3146":65891,"_27538":65866,"_19130":112469,"_5":13154,"_26074":112408,"_2645":112470},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3146":65892,"_27538":65866,"_19130":112472,"_5":13154,"_26074":112408,"_2645":112473},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3146":65893,"_27538":65866,"_19130":112475,"_5":13154,"_26074":112412,"_2645":112476},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3146":65894,"_27538":65866,"_19130":112478,"_5":13154,"_26074":112416,"_2645":112479},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3146":65895,"_27538":65866,"_19130":112481,"_5":13154,"_26074":112419,"_2645":112482},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3146":65896,"_27538":65866,"_19130":112484,"_5":13154,"_26074":112423,"_2645":112485},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3146":65897,"_27538":65866,"_19130":112487,"_5":13154,"_26074":112423,"_2645":112488},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3146":65898,"_27538":65866,"_19130":112490,"_5":13154,"_26074":112423,"_2645":112491},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3146":65899,"_27538":65866,"_19130":112493,"_5":13154,"_26074":112427,"_2645":112494},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3146":65900,"_27538":65866,"_19130":112496,"_5":13154,"_26074":112427,"_2645":112497},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3146":65901,"_27538":65866,"_19130":112499,"_5":13154,"_26074":112427,"_2645":112500},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3146":65902,"_27538":65866,"_19130":112502,"_5":13154,"_26074":112431,"_2645":110147},[],{"_3146":65903,"_27538":65866,"_19130":112504,"_5":13154,"_26074":112431,"_2645":108914},[],{"_3146":65904,"_27538":65866,"_19130":112506,"_5":13154,"_26074":112431,"_2645":112507},[],"La CA rechaza la emisión",{"_3146":65905,"_27538":65866,"_19130":112509,"_5":13154,"_26074":112431,"_2645":112510},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3146":65906,"_27538":65866,"_19130":112512,"_5":13154,"_26074":112431,"_2645":112513},[],"Sujeto o usos diferentes",{"_3146":65907,"_27538":65866,"_19130":112515,"_5":13154,"_26074":112431,"_2645":112516},[],"Perfil aplicado y valores solicitados.",{"_3146":65908,"_27538":65866,"_19130":112518,"_5":13154,"_26074":112431,"_2645":112519},[],"No se encuentra el emisor",{"_3146":65909,"_27538":65866,"_19130":112521,"_5":13154,"_26074":112431,"_2645":112522},[],"CA descargada y cadena intermedia necesaria.",{"_3146":65910,"_27538":65866,"_19130":112524,"_5":13154,"_26074":112431,"_2645":112525},[],"Falla la vigencia",{"_3146":65911,"_27538":65866,"_19130":112527,"_5":13154,"_26074":112431,"_2645":112528},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3146":65912,"_27538":65866,"_19130":112530,"_5":13154,"_26074":112431,"_2645":112531},[],"Los resúmenes de clave difieren",{"_3146":65913,"_27538":65866,"_19130":112533,"_5":13154,"_26074":112431,"_2645":112534},[],"Archivos de certificado y clave de la misma emisión.",{"_3146":65914,"_27538":65866,"_19130":112536,"_5":13154,"_26074":112431,"_2645":112537},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3146":65915,"_27538":65866,"_19130":112539,"_5":13154,"_26074":112434,"_2645":112540},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3146":65916,"_27538":65866,"_19130":112542,"_5":13154,"_26074":112434,"_2645":112543},[],"Gestionar certificados para inspección, estado y revocación.",{"_3146":65917,"_27538":65866,"_19130":112545,"_5":13154,"_26074":112434,"_2645":112546},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3146":65918,"_27538":65866,"_19130":112548,"_5":13154,"_26074":112434,"_2645":112549},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3146":65919,"_27538":65866,"_19130":112551,"_5":13154,"_26074":112434,"_2645":112552},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3146":65920,"_27538":65920,"_5":13480,"_2645":112554,"_27881":112555,"_19130":112556,"_26074":65920},"Primeros pasos de PKI",[44830,106777,49906,109816],[],{"_3146":65921,"_27538":65920,"_19130":112558,"_5":13154,"_26074":65920,"_2645":112559},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3146":65922,"_27538":65920,"_5":27878,"_19130":112561,"_26074":112562,"_2645":105443},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3146":65923,"_27538":65920,"_5":27878,"_19130":112564,"_26074":112565,"_2645":112566},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3146":65924,"_27538":65920,"_5":27878,"_19130":112568,"_26074":112569,"_2645":109998},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3146":65925,"_27538":65920,"_5":27878,"_19130":112571,"_26074":112572,"_2645":112573},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3146":65926,"_27538":65920,"_19130":112575,"_5":13154,"_26074":65920,"_2645":112576},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3146":65927,"_27538":65920,"_19130":112578,"_5":13154,"_26074":112562,"_2645":112579},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3146":65928,"_27538":65920,"_19130":112581,"_5":13154,"_26074":112562,"_2645":112582},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3146":65929,"_27538":65920,"_19130":112584,"_5":13154,"_26074":112562,"_2645":112585},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3146":65930,"_27538":65920,"_19130":112587,"_5":13154,"_26074":112562,"_2645":112588},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3146":65931,"_27538":65920,"_19130":112590,"_5":13154,"_26074":112562,"_2645":112591},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3146":65932,"_27538":65920,"_19130":112593,"_5":13154,"_26074":112565,"_2645":112594},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3146":65933,"_27538":65920,"_19130":112596,"_5":13154,"_26074":112565,"_2645":112597},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3146":65934,"_27538":65920,"_19130":112599,"_5":13154,"_26074":112565,"_2645":112600},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3146":65935,"_27538":65920,"_19130":112602,"_5":13154,"_26074":112565,"_2645":112603},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3146":65936,"_27538":65920,"_19130":112605,"_5":13154,"_26074":112569,"_2645":112606},[],"Archivo o recurso",{"_3146":65937,"_27538":65920,"_19130":112608,"_5":13154,"_26074":112569,"_2645":109995},[],{"_3146":65938,"_27538":65920,"_19130":112610,"_5":13154,"_26074":112569,"_2645":112611},[],"CA raíz activa y `ca.pem`",{"_3146":65939,"_27538":65920,"_19130":112613,"_5":13154,"_26074":112569,"_2645":112614},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3146":65940,"_27538":65920,"_19130":112616,"_5":13154,"_26074":112569,"_2645":112617},[],"Certificado final y `device.crt`",{"_3146":65941,"_27538":65920,"_19130":112619,"_5":13154,"_26074":112569,"_2645":112620},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3146":65942,"_27538":65920,"_19130":112622,"_5":13154,"_26074":112569,"_2645":112623},[],"Clave privada `device.key`",{"_3146":65943,"_27538":65920,"_19130":112625,"_5":13154,"_26074":112569,"_2645":112626},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3146":65944,"_27538":65920,"_19130":112628,"_5":13154,"_26074":112569,"_2645":112629},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3146":65945,"_27538":65920,"_19130":112631,"_5":13154,"_26074":112572,"_2645":112632},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3146":65946,"_27538":65920,"_19130":112634,"_5":13154,"_26074":112572,"_2645":112635},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3146":65947,"_27538":65920,"_19130":112637,"_5":13154,"_26074":112572,"_2645":112638},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3146":65948,"_27538":65948,"_5":13480,"_2645":112640,"_27881":112641,"_19130":112643,"_26074":65948},"Resolución de problemas PKI",[44830,106777,49906,112642],"Resolución de problemas",[],{"_3146":65949,"_27538":65948,"_19130":112645,"_5":13154,"_26074":65948,"_2645":112646},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3146":65950,"_27538":65948,"_5":27878,"_19130":112648,"_26074":112649,"_2645":112650},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3146":65951,"_27538":65948,"_5":27878,"_19130":112652,"_26074":112653,"_2645":112654},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3146":65952,"_27538":65948,"_5":27878,"_19130":112656,"_26074":112657,"_2645":112658},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3146":65953,"_27538":65948,"_19130":112660,"_5":13154,"_26074":65948,"_2645":112661},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3146":65954,"_27538":65948,"_19130":112663,"_5":13154,"_26074":65948,"_2645":112664},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3146":65955,"_27538":65948,"_19130":112666,"_5":13154,"_26074":112649,"_2645":109995},[],{"_3146":65956,"_27538":65948,"_19130":112668,"_5":13154,"_26074":112649,"_2645":108914},[],{"_3146":65957,"_27538":65948,"_19130":112670,"_5":13154,"_26074":112649,"_2645":105467},[],{"_3146":65958,"_27538":65948,"_19130":112672,"_5":13154,"_26074":112649,"_2645":52241},[],{"_3146":65959,"_27538":65948,"_19130":112674,"_5":13154,"_26074":112649,"_2645":112675},[],"Existe, está activa y sus fechas son utilizables.",{"_3146":65960,"_27538":65948,"_19130":112677,"_5":13154,"_26074":112649,"_2645":112678},[],"Autoridades.",{"_3146":65961,"_27538":65948,"_19130":112680,"_5":13154,"_26074":112649,"_2645":112681},[],"Clave",{"_3146":65962,"_27538":65948,"_19130":112683,"_5":13154,"_26074":112649,"_2645":112684},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3146":65963,"_27538":65948,"_19130":112686,"_5":13154,"_26074":112649,"_2645":112687},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3146":65964,"_27538":65948,"_19130":112689,"_5":13154,"_26074":112649,"_2645":52259},[],{"_3146":65965,"_27538":65948,"_19130":112691,"_5":13154,"_26074":112649,"_2645":112692},[],"PEM correcto y firma verificable.",{"_3146":65966,"_27538":65948,"_19130":112694,"_5":13154,"_26074":112649,"_2645":52265},[],{"_3146":65967,"_27538":65948,"_19130":112696,"_5":13154,"_26074":112649,"_2645":112697},[],"Perfil",{"_3146":65968,"_27538":65948,"_19130":112699,"_5":13154,"_26074":112649,"_2645":112700},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3146":65969,"_27538":65948,"_19130":112702,"_5":13154,"_26074":112649,"_2645":112703},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3146":65970,"_27538":65948,"_19130":112705,"_5":13154,"_26074":112649,"_2645":110147},[],{"_3146":65971,"_27538":65948,"_19130":112707,"_5":13154,"_26074":112649,"_2645":112708},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3146":65972,"_27538":65948,"_19130":112710,"_5":13154,"_26074":112649,"_2645":112711},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3146":65973,"_27538":65948,"_19130":112713,"_5":13154,"_26074":112649,"_2645":112714},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3146":65974,"_27538":65948,"_19130":112716,"_5":13154,"_26074":112649,"_2645":112717},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3146":65975,"_27538":65948,"_19130":112719,"_5":13154,"_26074":112653,"_2645":112720},[],"Revisa cada frontera por separado:",{"_3146":65976,"_27538":65948,"_19130":112722,"_5":13154,"_26074":112653,"_2645":112723},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3146":65977,"_27538":65948,"_19130":112725,"_5":13154,"_26074":112653,"_2645":112726},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3146":65978,"_27538":65948,"_19130":112728,"_5":13154,"_26074":112653,"_2645":112729},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3146":65979,"_27538":65948,"_19130":112731,"_5":13154,"_26074":112653,"_2645":112732},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3146":65980,"_27538":65948,"_19130":112734,"_5":13154,"_26074":112653,"_2645":112735},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3146":65981,"_27538":65948,"_19130":112737,"_5":13154,"_26074":112653,"_2645":112738},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3146":65982,"_27538":65948,"_19130":112740,"_5":13154,"_26074":112657,"_2645":112741},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3146":65983,"_27538":65948,"_19130":112743,"_5":13154,"_26074":112657,"_2645":112744},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3146":65984,"_27538":65984,"_5":13480,"_2645":112746,"_27881":112747,"_19130":112749,"_26074":65984},"3.8.0 a 4.0.0",[44830,112748],"Actualizaciones",[],{"_3146":65985,"_27538":65984,"_19130":112751,"_5":13154,"_26074":65984,"_2645":112752},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3146":65986,"_27538":65984,"_5":27878,"_19130":112754,"_26074":112755,"_2645":112756},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3146":65987,"_27538":65984,"_5":27878,"_19130":112758,"_26074":112759,"_2645":112760},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3146":65988,"_27538":65984,"_5":27878,"_19130":112762,"_26074":112763,"_2645":112764},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3146":65989,"_27538":65984,"_5":27878,"_19130":112766,"_26074":112767,"_2645":112768},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3146":65990,"_27538":65984,"_5":27878,"_19130":112770,"_26074":112771,"_2645":112772},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3146":65991,"_27538":65984,"_5":27878,"_19130":112774,"_26074":112775,"_2645":112776},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3146":65992,"_27538":65984,"_5":27878,"_19130":112778,"_26074":112779,"_2645":52351},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3146":65993,"_27538":65984,"_5":27878,"_19130":112781,"_26074":112782,"_2645":112783},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3146":65994,"_27538":65984,"_5":27878,"_19130":112785,"_26074":112786,"_2645":112787},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3146":65995,"_27538":65984,"_5":27878,"_19130":112789,"_26074":112790,"_2645":112791},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3146":65996,"_27538":65984,"_5":27878,"_19130":112793,"_26074":112794,"_2645":112795},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3146":65997,"_27538":65984,"_5":27878,"_19130":112797,"_26074":112798,"_2645":112799},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3146":65998,"_27538":65984,"_5":27878,"_19130":112801,"_26074":112802,"_2645":112803},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3146":65999,"_27538":65984,"_5":27878,"_19130":112805,"_26074":112806,"_2645":112807},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3146":66000,"_27538":65984,"_5":27878,"_19130":112809,"_26074":112810,"_2645":112811},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3146":66001,"_27538":65984,"_5":27878,"_19130":112813,"_26074":112814,"_2645":112815},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3146":66002,"_27538":65984,"_5":27878,"_19130":112817,"_26074":112818,"_2645":112819},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3146":66003,"_27538":65984,"_5":27878,"_19130":112821,"_26074":112822,"_2645":112823},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3146":66004,"_27538":65984,"_5":27878,"_19130":112825,"_26074":112826,"_2645":112827},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3146":66005,"_27538":65984,"_5":27878,"_19130":112829,"_26074":112830,"_2645":112831},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3146":66006,"_27538":65984,"_5":27878,"_19130":112833,"_26074":112834,"_2645":112835},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3146":66007,"_27538":65984,"_5":27878,"_19130":112837,"_26074":112838,"_2645":112839},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3146":66008,"_27538":65984,"_5":27878,"_19130":112841,"_26074":112842,"_2645":112843},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3146":66009,"_27538":65984,"_5":27878,"_19130":112845,"_26074":112846,"_2645":112847},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3146":66010,"_27538":65984,"_5":27878,"_19130":112849,"_26074":112850,"_2645":112851},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3146":66011,"_27538":65984,"_5":27878,"_19130":112853,"_26074":112854,"_2645":112855},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3146":66012,"_27538":65984,"_5":27878,"_19130":112857,"_26074":112858,"_2645":112859},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3146":66013,"_27538":65984,"_5":27878,"_19130":112861,"_26074":112862,"_2645":112863},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3146":66014,"_27538":65984,"_5":27878,"_19130":112865,"_26074":112866,"_2645":112867},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3146":66015,"_27538":65984,"_5":27878,"_19130":112869,"_26074":112870,"_2645":112871},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3146":66016,"_27538":65984,"_5":27878,"_19130":112873,"_26074":112874,"_2645":112875},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3146":66017,"_27538":65984,"_5":27878,"_19130":112877,"_26074":112878,"_2645":112879},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3146":66018,"_27538":65984,"_5":27878,"_19130":112881,"_26074":112882,"_2645":112883},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3146":66019,"_27538":65984,"_5":27878,"_19130":112885,"_26074":112886,"_2645":109236},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3146":66020,"_27538":65984,"_5":27878,"_19130":112888,"_26074":112889,"_2645":112890},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3146":66021,"_27538":65984,"_5":27878,"_19130":112892,"_26074":112893,"_2645":112894},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3146":66022,"_27538":65984,"_19130":112896,"_5":13154,"_26074":65984,"_2645":112897},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3146":66023,"_27538":65984,"_19130":112899,"_5":13154,"_26074":65984,"_2645":112900},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3146":66024,"_27538":65984,"_19130":112902,"_5":13154,"_26074":65984,"_2645":112903},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3146":66025,"_27538":65984,"_19130":112905,"_5":13154,"_26074":65984,"_2645":112906},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3146":66026,"_27538":65984,"_19130":112908,"_5":13154,"_26074":65984,"_2645":112909},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3146":66027,"_27538":65984,"_19130":112911,"_5":13154,"_26074":65984,"_2645":112912},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3146":66028,"_27538":65984,"_19130":112914,"_5":13154,"_26074":65984,"_2645":112915},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3146":66029,"_27538":65984,"_19130":112917,"_5":13154,"_26074":112759,"_2645":112918},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3146":66030,"_27538":65984,"_19130":112920,"_5":13154,"_26074":112759,"_2645":112921},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3146":66031,"_27538":65984,"_19130":112923,"_5":13154,"_26074":112763,"_2645":112924},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3146":66032,"_27538":65984,"_19130":112926,"_5":13154,"_26074":112763,"_2645":112927},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3146":66033,"_27538":65984,"_19130":112929,"_5":13154,"_26074":112767,"_2645":112930},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3146":66034,"_27538":65984,"_19130":112932,"_5":13154,"_26074":112771,"_2645":112933},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3146":66035,"_27538":65984,"_19130":112935,"_5":13154,"_26074":112771,"_2645":112936},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3146":66036,"_27538":65984,"_19130":112938,"_5":13154,"_26074":112771,"_2645":112939},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3146":66037,"_27538":65984,"_19130":112941,"_5":13154,"_26074":112771,"_2645":112942},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3146":66038,"_27538":65984,"_19130":112944,"_5":13154,"_26074":112771,"_2645":112945},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3146":66039,"_27538":65984,"_19130":112947,"_5":13154,"_26074":112775,"_2645":112948},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3146":66040,"_27538":65984,"_19130":112950,"_5":13154,"_26074":112775,"_2645":112951},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3146":66041,"_27538":65984,"_19130":112953,"_5":13154,"_26074":112775,"_2645":112954},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3146":66042,"_27538":65984,"_19130":112956,"_5":13154,"_26074":112775,"_2645":112957},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3146":66043,"_27538":65984,"_19130":112959,"_5":13154,"_26074":112775,"_2645":112960},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3146":66044,"_27538":65984,"_19130":112962,"_5":13154,"_26074":112779,"_2645":112963},[],"Cambio",{"_3146":66045,"_27538":65984,"_19130":112965,"_5":13154,"_26074":112779,"_2645":112966},[],"A quién afecta",{"_3146":66046,"_27538":65984,"_19130":112968,"_5":13154,"_26074":112779,"_2645":112969},[],"Gravedad",{"_3146":66047,"_27538":65984,"_19130":112971,"_5":13154,"_26074":112779,"_2645":112972},[],"Acción",{"_3146":66048,"_27538":65984,"_19130":112974,"_5":13154,"_26074":112779,"_2645":112787},[],{"_3146":66049,"_27538":65984,"_19130":112976,"_5":13154,"_26074":112779,"_2645":112977},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3146":66050,"_27538":65984,"_19130":112979,"_5":13154,"_26074":112779,"_2645":112980},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3146":66051,"_27538":65984,"_19130":112982,"_5":13154,"_26074":112779,"_2645":112983},[],"Copiar los datos a los volúmenes nuevos",{"_3146":66052,"_27538":65984,"_19130":112985,"_5":13154,"_26074":112779,"_2645":112791},[],{"_3146":66053,"_27538":65984,"_19130":112987,"_5":13154,"_26074":112779,"_2645":112988},[],"Todas las releases de Helm",{"_3146":66054,"_27538":65984,"_19130":112990,"_5":13154,"_26074":112779,"_2645":112991},[],"Alta: `helm upgrade` falla",{"_3146":66055,"_27538":65984,"_19130":112993,"_5":13154,"_26074":112779,"_2645":112994},[],"Eliminar o renombrar las claves heredadas",{"_3146":66056,"_27538":65984,"_19130":112996,"_5":13154,"_26074":112779,"_2645":112795},[],{"_3146":66057,"_27538":65984,"_19130":112998,"_5":13154,"_26074":112779,"_2645":112999},[],"Todos los despliegues",{"_3146":66058,"_27538":65984,"_19130":113001,"_5":13154,"_26074":112779,"_2645":113002},[],"Alta: sin principal de bootstrap no hay administrador",{"_3146":66059,"_27538":65984,"_19130":113004,"_5":13154,"_26074":112779,"_2645":113005},[],"Configurar `services.authz`",{"_3146":66060,"_27538":65984,"_19130":113007,"_5":13154,"_26074":112779,"_2645":112799},[],{"_3146":66061,"_27538":65984,"_19130":113009,"_5":13154,"_26074":112779,"_2645":112988},[],{"_3146":66062,"_27538":65984,"_19130":113011,"_5":13154,"_26074":112779,"_2645":113012},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3146":66063,"_27538":65984,"_19130":113014,"_5":13154,"_26074":112779,"_2645":113015},[],"Mover JWKS y roles a `services.authz`",{"_3146":66064,"_27538":65984,"_19130":113017,"_5":13154,"_26074":112779,"_2645":112819},[],{"_3146":66065,"_27538":65984,"_19130":113019,"_5":13154,"_26074":112779,"_2645":113020},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3146":66066,"_27538":65984,"_19130":113022,"_5":13154,"_26074":112779,"_2645":113023},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3146":66067,"_27538":65984,"_19130":113025,"_5":13154,"_26074":112779,"_2645":113026},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3146":66068,"_27538":65984,"_19130":113028,"_5":13154,"_26074":112779,"_2645":112823},[],{"_3146":66069,"_27538":65984,"_19130":113030,"_5":13154,"_26074":112779,"_2645":113031},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3146":66070,"_27538":65984,"_19130":113033,"_5":13154,"_26074":112779,"_2645":113034},[],"Alta: el backend ya no arranca con ellos",{"_3146":66071,"_27538":65984,"_19130":113036,"_5":13154,"_26074":112779,"_2645":113037},[],"Pasar a PostgreSQL antes de actualizar",{"_3146":66072,"_27538":65984,"_19130":113039,"_5":13154,"_26074":112779,"_2645":113040},[],"Webhooks con referencias a archivos",{"_3146":66073,"_27538":65984,"_19130":113042,"_5":13154,"_26074":112779,"_2645":113043},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3146":66074,"_27538":65984,"_19130":113045,"_5":13154,"_26074":112779,"_2645":113046},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3146":66075,"_27538":65984,"_19130":113048,"_5":13154,"_26074":112779,"_2645":113049},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3146":66076,"_27538":65984,"_19130":113051,"_5":13154,"_26074":112779,"_2645":112803},[],{"_3146":66077,"_27538":65984,"_19130":113053,"_5":13154,"_26074":112779,"_2645":113054},[],"Releases con identidades por servicio o material de claves montado",{"_3146":66078,"_27538":65984,"_19130":113056,"_5":13154,"_26074":112779,"_2645":113057},[],"Media: los servicios no pueden leer sus archivos",{"_3146":66079,"_27538":65984,"_19130":113059,"_5":13154,"_26074":112779,"_2645":113060},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3146":66080,"_27538":65984,"_19130":113062,"_5":13154,"_26074":112779,"_2645":112807},[],{"_3146":66081,"_27538":65984,"_19130":113064,"_5":13154,"_26074":112779,"_2645":113065},[],"Releases que definen `amqp.tls`",{"_3146":66082,"_27538":65984,"_19130":113067,"_5":13154,"_26074":112779,"_2645":113068},[],"Media: los clientes se conectan al puerto equivocado",{"_3146":66083,"_27538":65984,"_19130":113070,"_5":13154,"_26074":112779,"_2645":113071},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3146":66084,"_27538":65984,"_19130":113073,"_5":13154,"_26074":112779,"_2645":112827},[],{"_3146":66085,"_27538":65984,"_19130":113075,"_5":13154,"_26074":112779,"_2645":113076},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3146":66086,"_27538":65984,"_19130":113078,"_5":13154,"_26074":112779,"_2645":113079},[],"Media: las claves de CA quedan sin gestionar",{"_3146":66087,"_27538":65984,"_19130":113081,"_5":13154,"_26074":112779,"_2645":113082},[],"Ejecutar la migración de CA a KMS",{"_3146":66088,"_27538":65984,"_19130":113084,"_5":13154,"_26074":112779,"_2645":113085},[],"Verificación del certificado del receptor",{"_3146":66089,"_27538":65984,"_19130":113087,"_5":13154,"_26074":112779,"_2645":113088},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3146":66090,"_27538":65984,"_19130":113090,"_5":13154,"_26074":112779,"_2645":113091},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3146":66091,"_27538":65984,"_19130":113093,"_5":13154,"_26074":112779,"_2645":113094},[],"Poner `insecure_skip_verify` a `false`",{"_3146":66092,"_27538":65984,"_19130":113096,"_5":13154,"_26074":112779,"_2645":112839},[],{"_3146":66093,"_27538":65984,"_19130":113098,"_5":13154,"_26074":112779,"_2645":113099},[],"Scripts y consolas que editan DMS por API",{"_3146":66094,"_27538":65984,"_19130":113101,"_5":13154,"_26074":112779,"_2645":113102},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3146":66095,"_27538":65984,"_19130":113104,"_5":13154,"_26074":112779,"_2645":113105},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3146":66096,"_27538":65984,"_19130":113107,"_5":13154,"_26074":112779,"_2645":112855},[],{"_3146":66097,"_27538":65984,"_19130":113109,"_5":13154,"_26074":112779,"_2645":113110},[],"Consumidores que leen el campo `events` del dispositivo",{"_3146":66098,"_27538":65984,"_19130":113112,"_5":13154,"_26074":112779,"_2645":113113},[],"Media: el campo desaparece",{"_3146":66099,"_27538":65984,"_19130":113115,"_5":13154,"_26074":112779,"_2645":113116},[],"Usar los nuevos endpoints de eventos",{"_3146":66100,"_27538":65984,"_19130":113118,"_5":13154,"_26074":112779,"_2645":112811},[],{"_3146":66101,"_27538":65984,"_19130":113120,"_5":13154,"_26074":112779,"_2645":113121},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3146":66102,"_27538":65984,"_19130":113123,"_5":13154,"_26074":112779,"_2645":113124},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3146":66103,"_27538":65984,"_19130":113126,"_5":13154,"_26074":112779,"_2645":113127},[],"Actualizar el archivo de values",{"_3146":66104,"_27538":65984,"_19130":113129,"_5":13154,"_26074":112779,"_2645":112847},[],{"_3146":66105,"_27538":65984,"_19130":113131,"_5":13154,"_26074":112779,"_2645":113132},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3146":66106,"_27538":65984,"_19130":113134,"_5":13154,"_26074":112779,"_2645":113135},[],"Baja: prevalece el ID de la URL",{"_3146":66107,"_27538":65984,"_19130":113137,"_5":13154,"_26074":112779,"_2645":113138},[],"Enviar el ID en la URL",{"_3146":66108,"_27538":65984,"_19130":113140,"_5":13154,"_26074":112779,"_2645":112851},[],{"_3146":66109,"_27538":65984,"_19130":113142,"_5":13154,"_26074":112779,"_2645":113143},[],"Consumidores que comparan el `type` del certificado",{"_3146":66110,"_27538":65984,"_19130":113145,"_5":13154,"_26074":112779,"_2645":113146},[],"Baja: dos valores cambian de nombre",{"_3146":66111,"_27538":65984,"_19130":113148,"_5":13154,"_26074":112779,"_2645":113149},[],"Adaptar los consumidores",{"_3146":66112,"_27538":65984,"_19130":113151,"_5":13154,"_26074":112779,"_2645":112843},[],{"_3146":66113,"_27538":65984,"_19130":113153,"_5":13154,"_26074":112779,"_2645":113154},[],"Cualquier DMS",{"_3146":66114,"_27538":65984,"_19130":113156,"_5":13154,"_26074":112779,"_2645":113157},[],"Baja: solo informativo",{"_3146":66115,"_27538":65984,"_19130":113159,"_5":13154,"_26074":112779,"_2645":113160},[],"Revisar ambos bloques antes de editar",{"_3146":66116,"_27538":65984,"_19130":113162,"_5":13154,"_26074":112786,"_2645":113163},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3146":66117,"_27538":65984,"_19130":113165,"_5":13154,"_26074":112786,"_2645":113166},[],"El paso 4 de la guía de migración copia los datos.",{"_3146":66118,"_27538":65984,"_19130":113168,"_5":13154,"_26074":112790,"_2645":113169},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3146":66119,"_27538":65984,"_19130":113171,"_5":13154,"_26074":112794,"_2645":113172},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3146":66120,"_27538":65984,"_19130":113174,"_5":13154,"_26074":112798,"_2645":113175},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3146":66121,"_27538":65984,"_19130":113177,"_5":13154,"_26074":112802,"_2645":113178},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3146":66122,"_27538":65984,"_19130":113180,"_5":13154,"_26074":112802,"_2645":113181},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3146":66123,"_27538":65984,"_19130":113183,"_5":13154,"_26074":112806,"_2645":113184},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3146":66124,"_27538":65984,"_19130":113186,"_5":13154,"_26074":112810,"_2645":113187},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3146":66125,"_27538":65984,"_19130":113189,"_5":13154,"_26074":112810,"_2645":113190},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3146":66126,"_27538":65984,"_19130":113192,"_5":13154,"_26074":112810,"_2645":113193},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3146":66127,"_27538":65984,"_19130":113195,"_5":13154,"_26074":112810,"_2645":113196},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3146":66128,"_27538":65984,"_19130":113198,"_5":13154,"_26074":112810,"_2645":113199},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3146":66129,"_27538":65984,"_19130":113201,"_5":13154,"_26074":112810,"_2645":113202},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3146":66130,"_27538":65984,"_19130":113204,"_5":13154,"_26074":112818,"_2645":113205},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3146":66131,"_27538":65984,"_19130":113207,"_5":13154,"_26074":112818,"_2645":113208},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3146":66132,"_27538":65984,"_19130":113210,"_5":13154,"_26074":112818,"_2645":113211},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3146":66133,"_27538":65984,"_19130":113213,"_5":13154,"_26074":112818,"_2645":113214},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3146":66134,"_27538":65984,"_19130":113216,"_5":13154,"_26074":112818,"_2645":113217},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3146":66135,"_27538":65984,"_19130":113219,"_5":13154,"_26074":112822,"_2645":113220},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3146":66136,"_27538":65984,"_19130":113222,"_5":13154,"_26074":112826,"_2645":113223},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3146":66137,"_27538":65984,"_19130":113225,"_5":13154,"_26074":112826,"_2645":113226},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3146":66138,"_27538":65984,"_19130":113228,"_5":13154,"_26074":112826,"_2645":113229},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3146":66139,"_27538":65984,"_19130":113231,"_5":13154,"_26074":112826,"_2645":113232},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3146":66140,"_27538":65984,"_19130":113234,"_5":13154,"_26074":112826,"_2645":113235},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3146":66141,"_27538":65984,"_19130":113237,"_5":13154,"_26074":112826,"_2645":113238},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3146":66142,"_27538":65984,"_19130":113240,"_5":13154,"_26074":112834,"_2645":113241},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3146":66143,"_27538":65984,"_19130":113243,"_5":13154,"_26074":112834,"_2645":113244},[],"Campo en 3.8.0",{"_3146":66144,"_27538":65984,"_19130":113246,"_5":13154,"_26074":112834,"_2645":113247},[],"Campo en 4.0.0",{"_3146":66145,"_27538":65984,"_19130":113249,"_5":13154,"_26074":112834,"_2645":52822},[],{"_3146":66146,"_27538":65984,"_19130":113251,"_5":13154,"_26074":112834,"_2645":113252},[],"`insecure_skip_verify` (con el valor negado)",{"_3146":66147,"_27538":65984,"_19130":113254,"_5":13154,"_26074":112834,"_2645":52828},[],{"_3146":66148,"_27538":65984,"_19130":113256,"_5":13154,"_26074":112834,"_2645":52831},[],{"_3146":66149,"_27538":65984,"_19130":113258,"_5":13154,"_26074":112834,"_2645":52834},[],{"_3146":66150,"_27538":65984,"_19130":113260,"_5":13154,"_26074":112834,"_2645":52837},[],{"_3146":66151,"_27538":65984,"_19130":113262,"_5":13154,"_26074":112834,"_2645":52840},[],{"_3146":66152,"_27538":65984,"_19130":113264,"_5":13154,"_26074":112834,"_2645":52843},[],{"_3146":66153,"_27538":65984,"_19130":113266,"_5":13154,"_26074":112834,"_2645":113267},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3146":66154,"_27538":65984,"_19130":113269,"_5":13154,"_26074":112834,"_2645":113270},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3146":66155,"_27538":65984,"_19130":113272,"_5":13154,"_26074":112834,"_2645":113273},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3146":66156,"_27538":65984,"_19130":113275,"_5":13154,"_26074":112838,"_2645":113276},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3146":66157,"_27538":65984,"_19130":113278,"_5":13154,"_26074":112838,"_2645":113279},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3146":66158,"_27538":65984,"_19130":113281,"_5":13154,"_26074":112838,"_2645":113282},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3146":66159,"_27538":65984,"_19130":113284,"_5":13154,"_26074":112842,"_2645":113285},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. Si la versión de la consola no expone los ajustes independientes, edítalos mediante la API DMS.",{"_3146":66160,"_27538":65984,"_19130":113287,"_5":13154,"_26074":112846,"_2645":113288},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3146":66161,"_27538":65984,"_19130":113290,"_5":13154,"_26074":112850,"_2645":113291},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3146":66162,"_27538":65984,"_19130":113293,"_5":13154,"_26074":112854,"_2645":113294},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3146":66163,"_27538":65984,"_19130":113296,"_5":13154,"_26074":112854,"_2645":113297},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3146":66164,"_27538":65984,"_19130":113299,"_5":13154,"_26074":112854,"_2645":113300},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3146":66165,"_27538":65984,"_19130":113302,"_5":13154,"_26074":112854,"_2645":113303},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3146":66166,"_27538":65984,"_19130":113305,"_5":13154,"_26074":112858,"_2645":113306},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3146":66167,"_27538":65984,"_19130":113308,"_5":13154,"_26074":112862,"_2645":113309},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3146":66168,"_27538":65984,"_19130":113311,"_5":13154,"_26074":112862,"_2645":113312},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3146":66169,"_27538":65984,"_19130":113314,"_5":13154,"_26074":112862,"_2645":113315},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3146":66170,"_27538":65984,"_19130":113317,"_5":13154,"_26074":112862,"_2645":113318},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3146":66171,"_27538":65984,"_19130":113320,"_5":13154,"_26074":112862,"_2645":113321},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3146":66172,"_27538":65984,"_19130":113323,"_5":13154,"_26074":112866,"_2645":113324},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3146":66173,"_27538":65984,"_19130":113326,"_5":13154,"_26074":112866,"_2645":113327},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3146":66174,"_27538":65984,"_19130":113329,"_5":13154,"_26074":112866,"_2645":113330},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3146":66175,"_27538":65984,"_19130":113332,"_5":13154,"_26074":112866,"_2645":113333},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3146":66176,"_27538":65984,"_19130":113335,"_5":13154,"_26074":112866,"_2645":113336},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3146":66177,"_27538":65984,"_19130":113338,"_5":13154,"_26074":112866,"_2645":113339},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3146":66178,"_27538":65984,"_19130":113341,"_5":13154,"_26074":112866,"_2645":113342},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3146":66179,"_27538":65984,"_19130":113344,"_5":13154,"_26074":112866,"_2645":113345},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3146":66180,"_27538":65984,"_19130":113347,"_5":13154,"_26074":112866,"_2645":113348},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3146":66181,"_27538":65984,"_19130":113350,"_5":13154,"_26074":112866,"_2645":113351},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3146":66182,"_27538":65984,"_19130":113353,"_5":13154,"_26074":112866,"_2645":113354},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3146":66183,"_27538":65984,"_19130":113356,"_5":13154,"_26074":112866,"_2645":113357},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3146":66184,"_27538":65984,"_19130":113359,"_5":13154,"_26074":112870,"_2645":113360},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar. Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4.",{"_3146":66185,"_27538":65984,"_19130":113362,"_5":13154,"_26074":112874,"_2645":113363},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3146":66186,"_27538":65984,"_19130":113365,"_5":13154,"_26074":112874,"_2645":113366},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3146":66187,"_27538":65984,"_19130":113368,"_5":13154,"_26074":112874,"_2645":113369},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3146":66188,"_27538":65984,"_19130":113371,"_5":13154,"_26074":112874,"_2645":113372},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3146":66189,"_27538":65984,"_19130":113374,"_5":13154,"_26074":112874,"_2645":113375},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3146":66190,"_27538":65984,"_19130":113377,"_5":13154,"_26074":112874,"_2645":113378},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3146":66191,"_27538":65984,"_19130":113380,"_5":13154,"_26074":112874,"_2645":113381},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3146":66192,"_27538":65984,"_19130":113383,"_5":13154,"_26074":112874,"_2645":113384},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3146":66193,"_27538":65984,"_19130":113386,"_5":13154,"_26074":112874,"_2645":113387},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3146":66194,"_27538":65984,"_19130":113389,"_5":13154,"_26074":112874,"_2645":113390},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3146":66195,"_27538":65984,"_19130":113392,"_5":13154,"_26074":112878,"_2645":113393},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3146":66196,"_27538":65984,"_19130":113395,"_5":13154,"_26074":112878,"_2645":113396},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3146":66197,"_27538":65984,"_19130":113398,"_5":13154,"_26074":112882,"_2645":113399},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3146":66198,"_27538":65984,"_19130":113401,"_5":13154,"_26074":112882,"_2645":113402},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3146":66199,"_27538":65984,"_19130":113404,"_5":13154,"_26074":112882,"_2645":113405},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3146":66200,"_27538":65984,"_19130":113407,"_5":13154,"_26074":112882,"_2645":113408},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3146":66201,"_27538":65984,"_19130":113410,"_5":13154,"_26074":112882,"_2645":113411},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3146":66202,"_27538":65984,"_19130":113413,"_5":13154,"_26074":112886,"_2645":113414},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3146":66203,"_27538":65984,"_19130":113416,"_5":13154,"_26074":112886,"_2645":113417},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3146":66204,"_27538":65984,"_19130":113419,"_5":13154,"_26074":112886,"_2645":113420},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3146":66205,"_27538":65984,"_19130":113422,"_5":13154,"_26074":112886,"_2645":113423},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3146":66206,"_27538":65984,"_19130":113425,"_5":13154,"_26074":112886,"_2645":113426},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3146":66207,"_27538":65984,"_19130":113428,"_5":13154,"_26074":112886,"_2645":113429},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3146":66208,"_27538":65984,"_19130":113431,"_5":13154,"_26074":112889,"_2645":113432},[],"Tras la actualización, comprueba en este orden:",{"_3146":66209,"_27538":65984,"_19130":113434,"_5":13154,"_26074":112889,"_2645":113435},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3146":66210,"_27538":65984,"_19130":113437,"_5":13154,"_26074":112889,"_2645":113438},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3146":66211,"_27538":65984,"_19130":113440,"_5":13154,"_26074":112889,"_2645":113441},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3146":66212,"_27538":65984,"_19130":113443,"_5":13154,"_26074":112889,"_2645":113444},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3146":66213,"_27538":65984,"_19130":113446,"_5":13154,"_26074":112889,"_2645":113447},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3146":66214,"_27538":65984,"_19130":113449,"_5":13154,"_26074":112889,"_2645":113450},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3146":66215,"_27538":65984,"_19130":113452,"_5":13154,"_26074":112889,"_2645":113453},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3146":66216,"_27538":65984,"_19130":113455,"_5":13154,"_26074":112889,"_2645":113456},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3146":66217,"_27538":65984,"_19130":113458,"_5":13154,"_26074":112889,"_2645":113459},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3146":66218,"_27538":65984,"_19130":113461,"_5":13154,"_26074":112889,"_2645":113462},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3146":66219,"_27538":65984,"_19130":113464,"_5":13154,"_26074":112889,"_2645":113465},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3146":66220,"_27538":65984,"_19130":113467,"_5":13154,"_26074":112889,"_2645":113468},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3146":66221,"_27538":65984,"_19130":113470,"_5":13154,"_26074":112889,"_2645":113471},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3146":66222,"_27538":65984,"_19130":113473,"_5":13154,"_26074":112889,"_2645":113474},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3146":66223,"_27538":65984,"_19130":113476,"_5":13154,"_26074":112893,"_2645":113477},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente:",{"_3146":66224,"_27538":65984,"_19130":113479,"_5":13154,"_26074":112893,"_2645":113480},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3146":66225,"_27538":65984,"_19130":113482,"_5":13154,"_26074":112893,"_2645":113483},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3146":66226,"_27538":65984,"_19130":113485,"_5":13154,"_26074":112893,"_2645":113486},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3146":66227,"_27538":65984,"_19130":113488,"_5":13154,"_26074":112893,"_2645":113489},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53071":113491,"_53073":113492,"_53075":113493,"_53077":113494,"_16676":2667,"_63596":2667},"spanish",[2645,27538,5,26074],{"_2645":22875,"_27538":22875,"_5":22875,"_26074":22875},{"_2645":113495,"_27538":116123,"_5":118751,"_26074":121379},{"_4210":113496,"_53081":113497,"_5":22875},{"_13209":8095,"_13579":23195,"_13586":4773,"_11855":2730,"_26200":10173,"_18164":3316,"_13230":3645,"_13237":4302,"_26627":3069,"_27014":9576,"_27035":4900,"_26645":2755,"_31645":4515,"_27046":13101,"_27075":13088,"_31652":5897,"_31655":6258,"_31658":4593,"_31661":2911,"_27397":3017,"_31666":11910,"_31668":4114,"_27427":2716,"_27387":2966,"_31672":14427,"_27596":3864,"_31676":2853,"_27064":21607,"_27392":5436,"_27451":5855,"_31681":2729,"_31683":3327,"_31685":5676,"_31687":6348,"_31689":4186,"_31691":3766,"_31693":3109,"_31695":5760,"_31697":17745,"_26698":4427,"_31700":3230,"_31702":3693,"_26692":7756,"_31705":5707,"_31707":6819,"_31709":2778,"_31712":5449,"_26733":17743,"_31716":4695,"_26618":15334,"_31719":5062,"_26650":11128,"_31722":7845,"_31724":15367,"_31727":3324,"_27422":5564,"_31730":12472,"_31732":4968,"_31735":5280,"_31737":10650,"_31739":4957,"_31741":21844,"_31743":18596,"_18167":4923,"_31746":8548,"_31748":6497,"_26672":22521,"_27058":5012,"_31752":14385,"_31754":6498,"_31756":2848,"_31758":3012,"_31760":20794,"_31762":9539,"_31764":7867,"_27518":21841,"_27091":3000,"_31768":4064,"_31770":4113,"_26661":3344,"_31773":8048,"_31775":4298,"_31777":3648,"_27456":4191,"_26753":3902,"_26138":6131,"_31782":6845,"_31784":17526,"_31786":4519,"_26790":3326,"_31790":5982,"_27052":3001,"_31794":3003,"_31796":7058,"_31798":4585,"_31800":2947,"_31802":2973,"_31804":5541,"_26779":2753,"_