":53074,"_36910":53077,"_36912":53080,"_36915":53083,"_36917":53086,"_36919":53089,"_36922":53092,"_36925":53095,"_36927":53098,"_36929":53101,"_36932":53104,"_36934":53107,"_36936":53110,"_36938":53113,"_36940":53116,"_36942":53119,"_36944":53122,"_36946":53125,"_36948":53128,"_36950":53131,"_36952":53134,"_36954":53137,"_36956":53140,"_36958":53143,"_36960":53146,"_36962":53149,"_36964":53152,"_36966":53155,"_36968":53158,"_36970":53161,"_36972":53164,"_36974":53167,"_36976":53170,"_36978":53173,"_36980":53176,"_36982":53179,"_36984":53182,"_36986":53185,"_36988":53188,"_36990":53191,"_36992":53194,"_36994":53197,"_36996":53200,"_36998":53203,"_37001":53206,"_37003":53209,"_37005":53212,"_37007":53215},{"_3150":15,"_27660":15,"_5":13521,"_2648":44968,"_28003":44969,"_19192":44973,"_26170":15},"Deploy from AWS Marketplace",[44970,44971,44972],"Docs","Deployment","Other models",[],{"_3150":16,"_27660":15,"_19192":44975,"_5":13195,"_26170":15,"_2648":44976},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3150":17,"_27660":15,"_5":28000,"_19192":44978,"_26170":44979,"_2648":44980},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3150":18,"_27660":15,"_5":28000,"_19192":44982,"_26170":44983,"_2648":44984},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3150":19,"_27660":15,"_5":28000,"_19192":44986,"_26170":44987,"_2648":44988},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3150":20,"_27660":15,"_5":28000,"_19192":44990,"_26170":44991,"_2648":44992},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3150":21,"_27660":15,"_5":28000,"_19192":44994,"_26170":44995,"_2648":44996},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3150":22,"_27660":15,"_5":28000,"_19192":44998,"_26170":44999,"_2648":45000},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3150":23,"_27660":15,"_5":28000,"_19192":45002,"_26170":45003,"_2648":45004},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#next-step","Next step",{"_3150":24,"_27660":15,"_19192":45006,"_5":13195,"_26170":15,"_2648":45007},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3150":25,"_27660":15,"_19192":45009,"_5":13195,"_26170":44979,"_2648":45010},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3150":26,"_27660":15,"_19192":45012,"_5":13195,"_26170":44979,"_2648":45013},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3150":27,"_27660":15,"_19192":45015,"_5":13195,"_26170":44979,"_2648":45016},[],"A security group allowing the necessary endpoints.",{"_3150":28,"_27660":15,"_19192":45018,"_5":13195,"_26170":44983,"_2648":45019},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3150":29,"_27660":15,"_19192":45021,"_5":13195,"_26170":44983,"_2648":45022},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3150":30,"_27660":15,"_19192":45024,"_5":13195,"_26170":44983,"_2648":45025},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3150":31,"_27660":15,"_19192":45027,"_5":13195,"_26170":44987,"_2648":45028},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3150":32,"_27660":15,"_19192":45030,"_5":13195,"_26170":44991,"_2648":45031},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3150":33,"_27660":15,"_19192":45033,"_5":13195,"_26170":44995,"_2648":45034},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3150":34,"_27660":15,"_19192":45036,"_5":13195,"_26170":44999,"_2648":45037},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3150":35,"_27660":15,"_19192":45039,"_5":13195,"_26170":45003,"_2648":45040},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3150":36,"_27660":36,"_5":13521,"_2648":45042,"_28003":45043,"_19192":45044,"_26170":36},"Deploy Lamassu",[44970,44971],[],{"_3150":37,"_27660":36,"_19192":45046,"_5":13195,"_26170":36,"_2648":45047},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3150":38,"_27660":36,"_5":28000,"_19192":45049,"_26170":45050,"_2648":45051},[],"/docs/pr-preview/pr-26/deployment/overview#choose-a-model","Choose a model",{"_3150":39,"_27660":36,"_5":28000,"_19192":45053,"_26170":45054,"_2648":45055},[],"/docs/pr-preview/pr-26/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3150":40,"_27660":36,"_5":28000,"_19192":45057,"_26170":45058,"_2648":45059},[],"/docs/pr-preview/pr-26/deployment/overview#after-deployment","After deployment",{"_3150":41,"_27660":36,"_19192":45061,"_5":13195,"_26170":36,"_2648":45062},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3150":42,"_27660":36,"_19192":45064,"_5":13195,"_26170":45050,"_2648":45065},[],"Model",{"_3150":43,"_27660":36,"_19192":45067,"_5":13195,"_26170":45050,"_2648":45068},[],"Recommended for",{"_3150":44,"_27660":36,"_19192":45070,"_5":13195,"_26170":45050,"_2648":45071},[],"Who operates the infrastructure",{"_3150":45,"_27660":36,"_19192":45073,"_5":13195,"_26170":45050,"_2648":45074},[],"Starting point",{"_3150":46,"_27660":36,"_19192":45076,"_5":13195,"_26170":45050,"_2648":45077},[],"Kubernetes self-managed",{"_3150":47,"_27660":36,"_19192":45079,"_5":13195,"_26170":45050,"_2648":45080},[],"Production, regulated environments and custom deployments",{"_3150":48,"_27660":36,"_19192":45082,"_5":13195,"_26170":45050,"_2648":45083},[],"Your team",{"_3150":49,"_27660":36,"_19192":45085,"_5":13195,"_26170":45050,"_2648":45086},[],"Helm or Fastlane",{"_3150":50,"_27660":36,"_19192":45088,"_5":13195,"_26170":45050,"_2648":45089},[],"AWS Marketplace",{"_3150":51,"_27660":36,"_19192":45091,"_5":13195,"_26170":45050,"_2648":45092},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3150":52,"_27660":36,"_19192":45094,"_5":13195,"_26170":45050,"_2648":45083},[],{"_3150":53,"_27660":36,"_19192":45096,"_5":13195,"_26170":45050,"_2648":45097},[],"Preconfigured image on EC2",{"_3150":54,"_27660":36,"_19192":45099,"_5":13195,"_26170":45050,"_2648":45100},[],"SaaS",{"_3150":55,"_27660":36,"_19192":45102,"_5":13195,"_26170":45050,"_2648":45103},[],"Teams that want to use the platform without operating it",{"_3150":56,"_27660":36,"_19192":45105,"_5":13195,"_26170":45050,"_2648":45106},[],"Lamassu",{"_3150":57,"_27660":36,"_19192":45108,"_5":13195,"_26170":45050,"_2648":45109},[],"Managed subscription",{"_3150":58,"_27660":36,"_19192":45111,"_5":13195,"_26170":45050,"_2648":45112},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3150":59,"_27660":36,"_19192":45114,"_5":13195,"_26170":45050,"_2648":45115},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3150":60,"_27660":36,"_19192":45117,"_5":13195,"_26170":45050,"_2648":45118},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3150":61,"_27660":36,"_19192":45120,"_5":13195,"_26170":45054,"_2648":45121},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3150":62,"_27660":36,"_19192":45123,"_5":13195,"_26170":45058,"_2648":45124},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3150":63,"_27660":63,"_5":13521,"_2648":45126,"_28003":45127,"_19192":45128,"_26170":63},"Use Lamassu as SaaS",[44970,44971,44972],[],{"_3150":64,"_27660":63,"_19192":45130,"_5":13195,"_26170":63,"_2648":45131},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3150":65,"_27660":63,"_5":28000,"_19192":45133,"_26170":45134,"_2648":45135},[],"/docs/pr-preview/pr-26/deployment/saas#what-the-service-manages","What the service manages",{"_3150":66,"_27660":63,"_5":28000,"_19192":45137,"_26170":45138,"_2648":45139},[],"/docs/pr-preview/pr-26/deployment/saas#plans","Plans",{"_3150":67,"_27660":63,"_5":28000,"_19192":45141,"_26170":45142,"_2648":45143},[],"/docs/pr-preview/pr-26/deployment/saas#request-access","Request access",{"_3150":68,"_27660":63,"_19192":45145,"_5":13195,"_26170":63,"_2648":45146},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3150":69,"_27660":63,"_19192":45148,"_5":13195,"_26170":45134,"_2648":45149},[],"Platform availability and maintenance.",{"_3150":70,"_27660":63,"_19192":45151,"_5":13195,"_26170":45134,"_2648":45152},[],"Automatic backups.",{"_3150":71,"_27660":63,"_19192":45154,"_5":13195,"_26170":45134,"_2648":45155},[],"Version upgrades.",{"_3150":72,"_27660":63,"_19192":45157,"_5":13195,"_26170":45134,"_2648":45158},[],"Technical support and SLA according to your plan.",{"_3150":73,"_27660":63,"_19192":45160,"_5":13195,"_26170":45138,"_2648":45161},[],"Plan",{"_3150":74,"_27660":63,"_19192":45163,"_5":13195,"_26170":45138,"_2648":45164},[],"Devices",{"_3150":75,"_27660":63,"_19192":45166,"_5":13195,"_26170":45138,"_2648":45167},[],"Support",{"_3150":76,"_27660":63,"_19192":45169,"_5":13195,"_26170":45138,"_2648":45170},[],"SLA",{"_3150":77,"_27660":63,"_19192":45172,"_5":13195,"_26170":45138,"_2648":45173},[],"Starter",{"_3150":78,"_27660":63,"_19192":45175,"_5":13195,"_26170":45138,"_2648":45176},[],"Up to 1,000",{"_3150":79,"_27660":63,"_19192":45178,"_5":13195,"_26170":45138,"_2648":45179},[],"Email",{"_3150":80,"_27660":63,"_19192":45181,"_5":13195,"_26170":45138,"_2648":45182},[],"99.5 %",{"_3150":81,"_27660":63,"_19192":45184,"_5":13195,"_26170":45138,"_2648":45185},[],"Professional",{"_3150":82,"_27660":63,"_19192":45187,"_5":13195,"_26170":45138,"_2648":45188},[],"Up to 10,000",{"_3150":83,"_27660":63,"_19192":45190,"_5":13195,"_26170":45138,"_2648":45191},[],"Email and chat",{"_3150":84,"_27660":63,"_19192":45193,"_5":13195,"_26170":45138,"_2648":45194},[],"99.9 %",{"_3150":85,"_27660":63,"_19192":45196,"_5":13195,"_26170":45138,"_2648":45197},[],"Enterprise",{"_3150":86,"_27660":63,"_19192":45199,"_5":13195,"_26170":45138,"_2648":45200},[],"Unlimited",{"_3150":87,"_27660":63,"_19192":45202,"_5":13195,"_26170":45138,"_2648":45203},[],"Dedicated",{"_3150":88,"_27660":63,"_19192":45205,"_5":13195,"_26170":45138,"_2648":45206},[],"99.99 %",{"_3150":89,"_27660":63,"_19192":45208,"_5":13195,"_26170":45142,"_2648":45209},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3150":90,"_27660":63,"_19192":45211,"_5":13195,"_26170":45142,"_2648":45212},[],"When you receive your instance's credentials, continue with Get started.",{"_3150":91,"_27660":91,"_5":13521,"_2648":45214,"_28003":45215,"_19192":45216,"_26170":91},"Fastlane",[44970,44971,45077],[],{"_3150":92,"_27660":91,"_19192":45218,"_5":13195,"_26170":91,"_2648":45219},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3150":93,"_27660":91,"_5":28000,"_19192":45221,"_26170":45222,"_2648":45223},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3150":94,"_27660":91,"_5":28000,"_19192":45225,"_26170":45226,"_2648":45227},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3150":95,"_27660":91,"_5":28000,"_19192":45229,"_26170":45230,"_2648":44980},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#before-you-begin",{"_3150":96,"_27660":91,"_5":28000,"_19192":45232,"_26170":45233,"_2648":45234},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3150":97,"_27660":91,"_5":28000,"_19192":45236,"_26170":45237,"_2648":45238},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3150":98,"_27660":91,"_5":28000,"_19192":45240,"_26170":45241,"_2648":45242},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3150":99,"_27660":91,"_5":28000,"_19192":45244,"_26170":45245,"_2648":45246},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3150":100,"_27660":91,"_5":28000,"_19192":45248,"_26170":45249,"_2648":45250},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3150":101,"_27660":91,"_5":28000,"_19192":45252,"_26170":45253,"_2648":45254},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3150":102,"_27660":91,"_5":28000,"_19192":45256,"_26170":45257,"_2648":45258},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3150":103,"_27660":91,"_5":28000,"_19192":45260,"_26170":45261,"_2648":45262},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3150":104,"_27660":91,"_19192":45264,"_5":13195,"_26170":45222,"_2648":45265},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3150":105,"_27660":91,"_19192":45267,"_5":13195,"_26170":45222,"_2648":45268},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3150":106,"_27660":91,"_19192":45270,"_5":13195,"_26170":45226,"_2648":45271},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3150":107,"_27660":91,"_19192":45273,"_5":13195,"_26170":45226,"_2648":45274},[],"Fastlane installs or configures",{"_3150":108,"_27660":91,"_19192":45276,"_5":13195,"_26170":45226,"_2648":45277},[],"You still provide",{"_3150":109,"_27660":91,"_19192":45279,"_5":13195,"_26170":45226,"_2648":45280},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3150":110,"_27660":91,"_19192":45282,"_5":13195,"_26170":45226,"_2648":45283},[],"The Kubernetes cluster, nodes and persistent storage",{"_3150":111,"_27660":91,"_19192":45285,"_5":13195,"_26170":45226,"_2648":45286},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3150":112,"_27660":91,"_19192":45288,"_5":13195,"_26170":45226,"_2648":45289},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3150":113,"_27660":91,"_19192":45291,"_5":13195,"_26170":45226,"_2648":45292},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3150":114,"_27660":91,"_19192":45294,"_5":13195,"_26170":45226,"_2648":45295},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3150":115,"_27660":91,"_19192":45297,"_5":13195,"_26170":45226,"_2648":45298},[],"Optional observability and lab HSM components",{"_3150":116,"_27660":91,"_19192":45300,"_5":13195,"_26170":45226,"_2648":45301},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3150":117,"_27660":91,"_19192":45303,"_5":13195,"_26170":45226,"_2648":45304},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3150":118,"_27660":91,"_19192":45306,"_5":13195,"_26170":45230,"_2648":45307},[],"You need:",{"_3150":119,"_27660":91,"_19192":45309,"_5":13195,"_26170":45230,"_2648":45310},[],"an existing Kubernetes cluster",{"_3150":120,"_27660":91,"_19192":45312,"_5":13195,"_26170":45230,"_2648":45313},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3150":121,"_27660":91,"_19192":45315,"_5":13195,"_26170":45230,"_2648":45316},[],"`yq`",{"_3150":122,"_27660":91,"_19192":45318,"_5":13195,"_26170":45230,"_2648":21734},[],{"_3150":123,"_27660":91,"_19192":45320,"_5":13195,"_26170":45230,"_2648":45321},[],"`jq` only when using `--sample-data` or `--development`",{"_3150":124,"_27660":91,"_19192":45323,"_5":13195,"_26170":45230,"_2648":45324},[],"`ssh-keygen` only when using `--with-hsm`",{"_3150":125,"_27660":91,"_19192":45326,"_5":13195,"_26170":45230,"_2648":45327},[],"free external ports 80 and 443 on a single-node K3s host",{"_3150":126,"_27660":91,"_19192":45329,"_5":13195,"_26170":45230,"_2648":45330},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3150":127,"_27660":91,"_19192":45332,"_5":13195,"_26170":45230,"_2648":45333},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3150":128,"_27660":91,"_19192":45335,"_5":13195,"_26170":45233,"_2648":45336},[],"Run the script from a clone of the Helm repository:",{"_3150":129,"_27660":91,"_19192":45338,"_5":13195,"_26170":45233,"_2648":45339},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3150":130,"_27660":91,"_19192":45341,"_5":13195,"_26170":45237,"_2648":45342},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3150":131,"_27660":91,"_19192":45344,"_5":13195,"_26170":45237,"_2648":45345},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3150":132,"_27660":91,"_19192":45347,"_5":13195,"_26170":45237,"_2648":45348},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3150":133,"_27660":91,"_19192":45350,"_5":13195,"_26170":45237,"_2648":45351},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3150":134,"_27660":91,"_19192":45353,"_5":13195,"_26170":45241,"_2648":45354},[],"Option",{"_3150":135,"_27660":91,"_19192":45356,"_5":13195,"_26170":45241,"_2648":45357},[],"Default",{"_3150":136,"_27660":91,"_19192":45359,"_5":13195,"_26170":45241,"_2648":45360},[],"Purpose",{"_3150":137,"_27660":91,"_19192":45362,"_5":13195,"_26170":45241,"_2648":45363},[],"`-h`, `--help`",{"_3150":138,"_27660":91,"_19192":45365,"_5":13195,"_26170":45241,"_2648":45366},[],"—",{"_3150":139,"_27660":91,"_19192":45368,"_5":13195,"_26170":45241,"_2648":45369},[],"Show help",{"_3150":140,"_27660":91,"_19192":45371,"_5":13195,"_26170":45241,"_2648":45372},[],"`-c`, `--context`",{"_3150":141,"_27660":91,"_19192":45374,"_5":13195,"_26170":45241,"_2648":45375},[],"current context",{"_3150":142,"_27660":91,"_19192":45377,"_5":13195,"_26170":45241,"_2648":45378},[],"Select the kubeconfig context for kubectl and Helm",{"_3150":143,"_27660":91,"_19192":45380,"_5":13195,"_26170":45241,"_2648":45381},[],"`-n`, `--non-interactive`",{"_3150":144,"_27660":91,"_19192":45383,"_5":13195,"_26170":45241,"_2648":5899},[],{"_3150":145,"_27660":91,"_19192":45385,"_5":13195,"_26170":45241,"_2648":45386},[],"Skip prompts and generate dependency credentials",{"_3150":146,"_27660":91,"_19192":45388,"_5":13195,"_26170":45241,"_2648":45389},[],"`-ns`, `--namespace`",{"_3150":147,"_27660":91,"_19192":45391,"_5":13195,"_26170":45241,"_2648":45392},[],"`lamassu-dev`",{"_3150":148,"_27660":91,"_19192":45394,"_5":13195,"_26170":45241,"_2648":45395},[],"Namespace for the installation",{"_3150":149,"_27660":91,"_19192":45397,"_5":13195,"_26170":45241,"_2648":45398},[],"`-d`, `--domain`",{"_3150":150,"_27660":91,"_19192":45400,"_5":13195,"_26170":45241,"_2648":45401},[],"`dev.lamassu.io`",{"_3150":151,"_27660":91,"_19192":45403,"_5":13195,"_26170":45241,"_2648":45404},[],"Domain used by the UI, OIDC and certificate",{"_3150":152,"_27660":91,"_19192":45406,"_5":13195,"_26170":45241,"_2648":45407},[],"`-v`, `--version`",{"_3150":153,"_27660":91,"_19192":45409,"_5":13195,"_26170":45241,"_2648":13797},[],{"_3150":154,"_27660":91,"_19192":45411,"_5":13195,"_26170":45241,"_2648":45412},[],"Lamassu chart version",{"_3150":155,"_27660":91,"_19192":45414,"_5":13195,"_26170":45241,"_2648":45415},[],"`--https-port`",{"_3150":156,"_27660":91,"_19192":45417,"_5":13195,"_26170":45241,"_2648":45418},[],"`443`",{"_3150":157,"_27660":91,"_19192":45420,"_5":13195,"_26170":45241,"_2648":45421},[],"Gateway HTTPS listener port",{"_3150":158,"_27660":91,"_19192":45423,"_5":13195,"_26170":45241,"_2648":45424},[],"`--http-port`",{"_3150":159,"_27660":91,"_19192":45426,"_5":13195,"_26170":45241,"_2648":45427},[],"`80`",{"_3150":160,"_27660":91,"_19192":45429,"_5":13195,"_26170":45241,"_2648":45430},[],"Gateway HTTP listener port",{"_3150":161,"_27660":91,"_19192":45432,"_5":13195,"_26170":45241,"_2648":45433},[],"`--tls-crt`",{"_3150":162,"_27660":91,"_19192":45435,"_5":13195,"_26170":45241,"_2648":45366},[],{"_3150":163,"_27660":91,"_19192":45437,"_5":13195,"_26170":45241,"_2648":45438},[],"PEM certificate for downstream TLS",{"_3150":164,"_27660":91,"_19192":45440,"_5":13195,"_26170":45241,"_2648":45441},[],"`--tls-key`",{"_3150":165,"_27660":91,"_19192":45443,"_5":13195,"_26170":45241,"_2648":45366},[],{"_3150":166,"_27660":91,"_19192":45445,"_5":13195,"_26170":45241,"_2648":45446},[],"PEM private key for downstream TLS",{"_3150":167,"_27660":91,"_19192":45448,"_5":13195,"_26170":45241,"_2648":45449},[],"`-l`, `--local-chart-path`",{"_3150":168,"_27660":91,"_19192":45451,"_5":13195,"_26170":45241,"_2648":45452},[],"repository chart",{"_3150":169,"_27660":91,"_19192":45454,"_5":13195,"_26170":45241,"_2648":45455},[],"Use an unpacked local Lamassu chart",{"_3150":170,"_27660":91,"_19192":45457,"_5":13195,"_26170":45241,"_2648":45458},[],"`-ip`, `--gateway-ip`",{"_3150":171,"_27660":91,"_19192":45460,"_5":13195,"_26170":45241,"_2648":7951},[],{"_3150":172,"_27660":91,"_19192":45462,"_5":13195,"_26170":45241,"_2648":45463},[],"Override the address written to `gateway.addresses`",{"_3150":173,"_27660":91,"_19192":45465,"_5":13195,"_26170":45241,"_2648":45466},[],"`--otel`",{"_3150":174,"_27660":91,"_19192":45468,"_5":13195,"_26170":45241,"_2648":5899},[],{"_3150":175,"_27660":91,"_19192":45470,"_5":13195,"_26170":45241,"_2648":45471},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3150":176,"_27660":91,"_19192":45473,"_5":13195,"_26170":45241,"_2648":45474},[],"`--development`",{"_3150":177,"_27660":91,"_19192":45476,"_5":13195,"_26170":45241,"_2648":5899},[],{"_3150":178,"_27660":91,"_19192":45478,"_5":13195,"_26170":45241,"_2648":45479},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3150":179,"_27660":91,"_19192":45481,"_5":13195,"_26170":45241,"_2648":45482},[],"`--sample-data`",{"_3150":180,"_27660":91,"_19192":45484,"_5":13195,"_26170":45241,"_2648":5899},[],{"_3150":181,"_27660":91,"_19192":45486,"_5":13195,"_26170":45241,"_2648":45487},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3150":182,"_27660":91,"_19192":45489,"_5":13195,"_26170":45241,"_2648":45490},[],"`--with-hsm`",{"_3150":183,"_27660":91,"_19192":45492,"_5":13195,"_26170":45241,"_2648":5899},[],{"_3150":184,"_27660":91,"_19192":45494,"_5":13195,"_26170":45241,"_2648":45495},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3150":185,"_27660":91,"_19192":45497,"_5":13195,"_26170":45241,"_2648":45498},[],"`--softhsm-chart-path`",{"_3150":186,"_27660":91,"_19192":45500,"_5":13195,"_26170":45241,"_2648":45501},[],"`./charts/softhsm`",{"_3150":187,"_27660":91,"_19192":45503,"_5":13195,"_26170":45241,"_2648":45504},[],"Use a different local SoftHSM chart",{"_3150":188,"_27660":91,"_19192":45506,"_5":13195,"_26170":45241,"_2648":45507},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3150":189,"_27660":91,"_19192":45509,"_5":13195,"_26170":45245,"_2648":45510},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3150":190,"_27660":91,"_19192":45512,"_5":13195,"_26170":45245,"_2648":45513},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3150":191,"_27660":91,"_19192":45515,"_5":13195,"_26170":45245,"_2648":45516},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3150":192,"_27660":91,"_19192":45518,"_5":13195,"_26170":45245,"_2648":45519},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3150":193,"_27660":91,"_19192":45521,"_5":13195,"_26170":45245,"_2648":45522},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3150":194,"_27660":91,"_19192":45524,"_5":13195,"_26170":45245,"_2648":45525},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3150":195,"_27660":91,"_19192":45527,"_5":13195,"_26170":45249,"_2648":45528},[],"Fastlane:",{"_3150":196,"_27660":91,"_19192":45530,"_5":13195,"_26170":45249,"_2648":45531},[],"validates local tools and the selected cluster",{"_3150":197,"_27660":91,"_19192":45533,"_5":13195,"_26170":45249,"_2648":45534},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3150":198,"_27660":91,"_19192":45536,"_5":13195,"_26170":45249,"_2648":45537},[],"creates the namespace",{"_3150":199,"_27660":91,"_19192":45539,"_5":13195,"_26170":45249,"_2648":45540},[],"installs PostgreSQL and creates the required databases",{"_3150":200,"_27660":91,"_19192":45542,"_5":13195,"_26170":45249,"_2648":45543},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3150":201,"_27660":91,"_19192":45545,"_5":13195,"_26170":45249,"_2648":45546},[],"installs RabbitMQ",{"_3150":202,"_27660":91,"_19192":45548,"_5":13195,"_26170":45249,"_2648":45549},[],"optionally installs observability and lab HSM components",{"_3150":203,"_27660":91,"_19192":45551,"_5":13195,"_26170":45249,"_2648":45552},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3150":204,"_27660":91,"_19192":45554,"_5":13195,"_26170":45249,"_2648":45555},[],"optionally loads sample data",{"_3150":205,"_27660":91,"_19192":45557,"_5":13195,"_26170":45249,"_2648":45558},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3150":206,"_27660":91,"_19192":45560,"_5":13195,"_26170":45253,"_2648":45561},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3150":207,"_27660":91,"_19192":45563,"_5":13195,"_26170":45253,"_2648":45564},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3150":208,"_27660":91,"_19192":45566,"_5":13195,"_26170":45257,"_2648":45567},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3150":209,"_27660":91,"_19192":45569,"_5":13195,"_26170":45257,"_2648":45570},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3150":210,"_27660":91,"_19192":45572,"_5":13195,"_26170":45257,"_2648":45573},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3150":211,"_27660":91,"_19192":45575,"_5":13195,"_26170":45261,"_2648":45576},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3150":212,"_27660":212,"_5":13521,"_2648":45578,"_28003":45579,"_19192":45580,"_26170":212},"Install with Helm",[44970,44971,45077],[],{"_3150":213,"_27660":212,"_19192":45582,"_5":13195,"_26170":212,"_2648":45583},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3150":214,"_27660":212,"_5":28000,"_19192":45585,"_26170":45586,"_2648":45587},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3150":215,"_27660":212,"_5":28000,"_19192":45589,"_26170":45590,"_2648":44980},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#before-you-begin",{"_3150":216,"_27660":212,"_5":28000,"_19192":45592,"_26170":45593,"_2648":45594},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3150":217,"_27660":212,"_5":28000,"_19192":45596,"_26170":45597,"_2648":45598},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3150":218,"_27660":212,"_5":28000,"_19192":45600,"_26170":45601,"_2648":45602},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3150":219,"_27660":212,"_5":28000,"_19192":45604,"_26170":45605,"_2648":45606},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3150":220,"_27660":212,"_5":28000,"_19192":45608,"_26170":45609,"_2648":45610},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3150":221,"_27660":212,"_5":28000,"_19192":45612,"_26170":45613,"_2648":45614},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3150":222,"_27660":212,"_5":28000,"_19192":45616,"_26170":45617,"_2648":45618},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3150":223,"_27660":212,"_19192":45620,"_5":13195,"_26170":45586,"_2648":45621},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3150":224,"_27660":212,"_19192":45623,"_5":13195,"_26170":45590,"_2648":45624},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3150":225,"_27660":212,"_19192":45626,"_5":13195,"_26170":45590,"_2648":45627},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3150":226,"_27660":212,"_19192":45629,"_5":13195,"_26170":45590,"_2648":45630},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3150":227,"_27660":212,"_19192":45632,"_5":13195,"_26170":45590,"_2648":45633},[],"a reachable RabbitMQ broker and credentials",{"_3150":228,"_27660":212,"_19192":45635,"_5":13195,"_26170":45590,"_2648":45636},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3150":229,"_27660":212,"_19192":45638,"_5":13195,"_26170":45590,"_2648":45639},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3150":230,"_27660":212,"_19192":45641,"_5":13195,"_26170":45590,"_2648":45642},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3150":231,"_27660":212,"_19192":45644,"_5":13195,"_26170":45590,"_2648":45645},[],"a StorageClass and an external traffic design",{"_3150":232,"_27660":212,"_19192":45647,"_5":13195,"_26170":45590,"_2648":45648},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3150":233,"_27660":212,"_19192":45650,"_5":13195,"_26170":45590,"_2648":45651},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3150":234,"_27660":212,"_19192":45653,"_5":13195,"_26170":45590,"_2648":45654},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3150":235,"_27660":212,"_19192":45656,"_5":13195,"_26170":45593,"_2648":45657},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3150":236,"_27660":212,"_19192":45659,"_5":13195,"_26170":45593,"_2648":45660},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3150":237,"_27660":212,"_19192":45662,"_5":13195,"_26170":45593,"_2648":45663},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_3150":238,"_27660":212,"_19192":45665,"_5":13195,"_26170":45597,"_2648":45666},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3150":239,"_27660":212,"_19192":45668,"_5":13195,"_26170":45597,"_2648":45669},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3150":240,"_27660":212,"_19192":45671,"_5":13195,"_26170":45597,"_2648":45672},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3150":241,"_27660":212,"_19192":45674,"_5":13195,"_26170":45601,"_2648":45675},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_3150":242,"_27660":212,"_19192":45677,"_5":13195,"_26170":45605,"_2648":45678},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3150":243,"_27660":212,"_19192":45680,"_5":13195,"_26170":45605,"_2648":45681},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3150":244,"_27660":212,"_19192":45683,"_5":13195,"_26170":45605,"_2648":45684},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3150":245,"_27660":212,"_19192":45686,"_5":13195,"_26170":45605,"_2648":45687},[],"See Access control for the principal and policy model.",{"_3150":246,"_27660":212,"_19192":45689,"_5":13195,"_26170":45609,"_2648":45690},[],"To install a local checkout instead:",{"_3150":247,"_27660":212,"_19192":45692,"_5":13195,"_26170":45613,"_2648":45693},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3150":248,"_27660":212,"_19192":45695,"_5":13195,"_26170":45613,"_2648":45696},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3150":249,"_27660":212,"_19192":45698,"_5":13195,"_26170":45617,"_2648":45699},[],"Before going live, review:",{"_3150":250,"_27660":212,"_19192":45701,"_5":13195,"_26170":45617,"_2648":45702},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3150":251,"_27660":212,"_19192":45704,"_5":13195,"_26170":45617,"_2648":45705},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3150":252,"_27660":212,"_19192":45707,"_5":13195,"_26170":45617,"_2648":45708},[],"shared VA storage before increasing VA replicas",{"_3150":253,"_27660":212,"_19192":45710,"_5":13195,"_26170":45617,"_2648":45711},[],"managed OIDC roles and removal of evaluation credentials",{"_3150":254,"_27660":212,"_19192":45713,"_5":13195,"_26170":45617,"_2648":45714},[],"a trusted TLS issuer or externally managed certificate",{"_3150":255,"_27660":212,"_19192":45716,"_5":13195,"_26170":45617,"_2648":45717},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3150":256,"_27660":212,"_19192":45719,"_5":13195,"_26170":45617,"_2648":45720},[],"SMTP, observability and alert delivery",{"_3150":257,"_27660":212,"_19192":45722,"_5":13195,"_26170":45617,"_2648":45723},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3150":258,"_27660":212,"_19192":45725,"_5":13195,"_26170":45617,"_2648":45726},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3150":259,"_27660":259,"_5":13521,"_2648":45728,"_28003":45729,"_19192":45730,"_26170":259},"Expose the Gateway",[44970,44971,45077],[],{"_3150":260,"_27660":259,"_19192":45732,"_5":13195,"_26170":259,"_2648":45733},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3150":261,"_27660":259,"_5":28000,"_19192":45735,"_26170":45736,"_2648":45737},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3150":262,"_27660":259,"_5":28000,"_19192":45739,"_26170":45740,"_2648":45741},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3150":263,"_27660":259,"_5":28000,"_19192":45743,"_26170":45744,"_2648":45745},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3150":264,"_27660":259,"_5":28000,"_19192":45747,"_26170":45748,"_2648":45749},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#k3s","K3s",{"_3150":265,"_27660":259,"_5":28000,"_19192":45751,"_26170":45752,"_2648":45753},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3150":266,"_27660":259,"_5":28000,"_19192":45755,"_26170":45756,"_2648":45757},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3150":267,"_27660":259,"_5":28000,"_19192":45759,"_26170":45760,"_2648":45761},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3150":268,"_27660":259,"_5":28000,"_19192":45763,"_26170":45764,"_2648":45765},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3150":269,"_27660":259,"_5":28000,"_19192":45767,"_26170":45768,"_2648":45769},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3150":270,"_27660":259,"_19192":45771,"_5":13195,"_26170":45736,"_2648":45772},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3150":271,"_27660":259,"_19192":45774,"_5":13195,"_26170":45736,"_2648":45775},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3150":272,"_27660":259,"_19192":45777,"_5":13195,"_26170":45740,"_2648":45778},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3150":273,"_27660":259,"_19192":45780,"_5":13195,"_26170":45740,"_2648":45781},[],"Set it only when:",{"_3150":274,"_27660":259,"_19192":45783,"_5":13195,"_26170":45740,"_2648":45784},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3150":275,"_27660":259,"_19192":45786,"_5":13195,"_26170":45740,"_2648":45787},[],"that address is allocated to this Gateway",{"_3150":276,"_27660":259,"_19192":45789,"_5":13195,"_26170":45740,"_2648":45790},[],"the surrounding network already routes traffic for it to the cluster",{"_3150":277,"_27660":259,"_19192":45792,"_5":13195,"_26170":45740,"_2648":45793},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3150":278,"_27660":259,"_19192":45795,"_5":13195,"_26170":45740,"_2648":45796},[],"Keep these two settings separate:",{"_3150":279,"_27660":259,"_19192":45798,"_5":13195,"_26170":45740,"_2648":45799},[],"`gateway.addresses` requests an address for the Gateway.",{"_3150":280,"_27660":259,"_19192":45801,"_5":13195,"_26170":45740,"_2648":45802},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3150":281,"_27660":259,"_19192":45804,"_5":13195,"_26170":45740,"_2648":45805},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3150":282,"_27660":259,"_19192":45807,"_5":13195,"_26170":45744,"_2648":45808},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3150":283,"_27660":259,"_19192":45810,"_5":13195,"_26170":45744,"_2648":45811},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3150":284,"_27660":259,"_19192":45813,"_5":13195,"_26170":45748,"_2648":45814},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3150":285,"_27660":259,"_19192":45816,"_5":13195,"_26170":45748,"_2648":45817},[],"For the recommended design:",{"_3150":286,"_27660":259,"_19192":45819,"_5":13195,"_26170":45748,"_2648":45820},[],"Use only one externally exposed Lamassu Gateway.",{"_3150":287,"_27660":259,"_19192":45822,"_5":13195,"_26170":45748,"_2648":45823},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3150":288,"_27660":259,"_19192":45825,"_5":13195,"_26170":45748,"_2648":45826},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3150":289,"_27660":259,"_19192":45828,"_5":13195,"_26170":45748,"_2648":45829},[],"Point DNS at the VM's reachable address.",{"_3150":290,"_27660":259,"_19192":45831,"_5":13195,"_26170":45748,"_2648":45832},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3150":291,"_27660":259,"_19192":45834,"_5":13195,"_26170":45752,"_2648":45835},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3150":292,"_27660":259,"_19192":45837,"_5":13195,"_26170":45756,"_2648":45838},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3150":293,"_27660":259,"_19192":45840,"_5":13195,"_26170":45756,"_2648":45841},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3150":294,"_27660":259,"_19192":45843,"_5":13195,"_26170":45760,"_2648":45844},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3150":295,"_27660":259,"_19192":45846,"_5":13195,"_26170":45760,"_2648":45847},[],"Requirement",{"_3150":296,"_27660":259,"_19192":45849,"_5":13195,"_26170":45760,"_2648":45850},[],"Recommended design",{"_3150":297,"_27660":259,"_19192":45852,"_5":13195,"_26170":45760,"_2648":45853},[],"Consequence",{"_3150":298,"_27660":259,"_19192":45855,"_5":13195,"_26170":45760,"_2648":45856},[],"Several Lamassu URLs or services",{"_3150":299,"_27660":259,"_19192":45858,"_5":13195,"_26170":45760,"_2648":45859},[],"One Gateway with multiple routes",{"_3150":300,"_27660":259,"_19192":45861,"_5":13195,"_26170":45760,"_2648":45862},[],"One IP and one proxy fleet; this is the chart default",{"_3150":301,"_27660":259,"_19192":45864,"_5":13195,"_26170":45760,"_2648":45865},[],"Independent Gateways and separate external IPs",{"_3150":302,"_27660":259,"_19192":45867,"_5":13195,"_26170":45760,"_2648":45868},[],"One VIP per Gateway",{"_3150":303,"_27660":259,"_19192":45870,"_5":13195,"_26170":45760,"_2648":45871},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3150":304,"_27660":259,"_19192":45873,"_5":13195,"_26170":45760,"_2648":45874},[],"Independent Gateways on one node and one IP",{"_3150":305,"_27660":259,"_19192":45876,"_5":13195,"_26170":45760,"_2648":45877},[],"Use different external ports",{"_3150":306,"_27660":259,"_19192":45879,"_5":13195,"_26170":45760,"_2648":45880},[],"Clients must include non-standard ports",{"_3150":307,"_27660":259,"_19192":45882,"_5":13195,"_26170":45760,"_2648":45883},[],"Separate TLS/mTLS termination behind one IP",{"_3150":308,"_27660":259,"_19192":45885,"_5":13195,"_26170":45760,"_2648":45886},[],"Front-door SNI routing to internal Gateways",{"_3150":309,"_27660":259,"_19192":45888,"_5":13195,"_26170":45760,"_2648":45889},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3150":310,"_27660":259,"_19192":45891,"_5":13195,"_26170":45760,"_2648":45892},[],"Separate Gateway resources but shared proxy infrastructure",{"_3150":311,"_27660":259,"_19192":45894,"_5":13195,"_26170":45760,"_2648":45895},[],"Envoy merged-Gateway mode",{"_3150":312,"_27660":259,"_19192":45897,"_5":13195,"_26170":45760,"_2648":45898},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3150":313,"_27660":259,"_19192":45900,"_5":13195,"_26170":45760,"_2648":45901},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3150":314,"_27660":259,"_19192":45903,"_5":13195,"_26170":45760,"_2648":45904},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3150":315,"_27660":259,"_19192":45906,"_5":13195,"_26170":45760,"_2648":45907},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3150":316,"_27660":259,"_19192":45909,"_5":13195,"_26170":45760,"_2648":45910},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3150":317,"_27660":259,"_19192":45912,"_5":13195,"_26170":45764,"_2648":45913},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3150":318,"_27660":259,"_19192":45915,"_5":13195,"_26170":45764,"_2648":45916},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3150":319,"_27660":259,"_19192":45918,"_5":13195,"_26170":45764,"_2648":45919},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3150":320,"_27660":259,"_19192":45921,"_5":13195,"_26170":45764,"_2648":45922},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3150":321,"_27660":259,"_19192":45924,"_5":13195,"_26170":45764,"_2648":45925},[],"If none of those are possible, use different external ports or change the external network design.",{"_3150":322,"_27660":259,"_19192":45927,"_5":13195,"_26170":45768,"_2648":45928},[],"Check, in order:",{"_3150":323,"_27660":259,"_19192":45930,"_5":13195,"_26170":45768,"_2648":45931},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3150":324,"_27660":259,"_19192":45933,"_5":13195,"_26170":45768,"_2648":45934},[],"Its status contains the expected address.",{"_3150":325,"_27660":259,"_19192":45936,"_5":13195,"_26170":45768,"_2648":45937},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3150":326,"_27660":259,"_19192":45939,"_5":13195,"_26170":45768,"_2648":45940},[],"Port 443 reaches that address from the client network.",{"_3150":327,"_27660":259,"_19192":45942,"_5":13195,"_26170":45768,"_2648":45943},[],"DNS resolves to the externally reachable endpoint.",{"_3150":328,"_27660":259,"_19192":45945,"_5":13195,"_26170":45768,"_2648":45946},[],"The certificate contains the DNS name or IP used by the client.",{"_3150":329,"_27660":259,"_19192":45948,"_5":13195,"_26170":45768,"_2648":45949},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3150":330,"_27660":330,"_5":13521,"_2648":45077,"_28003":45951,"_19192":45952,"_26170":330},[44970,44971,45077],[],{"_3150":331,"_27660":330,"_19192":45954,"_5":13195,"_26170":330,"_2648":45955},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3150":332,"_27660":330,"_5":28000,"_19192":45957,"_26170":45958,"_2648":45959},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3150":333,"_27660":330,"_5":28000,"_19192":45961,"_26170":45962,"_2648":45963},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3150":334,"_27660":330,"_5":28000,"_19192":45965,"_26170":45966,"_2648":45967},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3150":335,"_27660":330,"_5":28000,"_19192":45969,"_26170":45970,"_2648":45971},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3150":336,"_27660":330,"_5":28000,"_19192":45973,"_26170":45974,"_2648":45975},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3150":337,"_27660":330,"_5":28000,"_19192":45977,"_26170":45978,"_2648":45979},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3150":338,"_27660":330,"_19192":45981,"_5":13195,"_26170":45958,"_2648":45982},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3150":339,"_27660":330,"_19192":45984,"_5":13195,"_26170":45962,"_2648":45985},[],"Workflow",{"_3150":340,"_27660":330,"_19192":45987,"_5":13195,"_26170":45962,"_2648":45988},[],"Use it for",{"_3150":341,"_27660":330,"_19192":45990,"_5":13195,"_26170":45962,"_2648":45991},[],"What it installs",{"_3150":342,"_27660":330,"_19192":45993,"_5":13195,"_26170":45962,"_2648":45994},[],"Helm",{"_3150":343,"_27660":330,"_19192":45996,"_5":13195,"_26170":45962,"_2648":45997},[],"Production and controlled environments",{"_3150":344,"_27660":330,"_19192":45999,"_5":13195,"_26170":45962,"_2648":46000},[],"Lamassu services and Gateway API resources",{"_3150":345,"_27660":330,"_19192":46002,"_5":13195,"_26170":45962,"_2648":45214},[],{"_3150":346,"_27660":330,"_19192":46004,"_5":13195,"_26170":45962,"_2648":46005},[],"Evaluation, demos, CI and small lab clusters",{"_3150":347,"_27660":330,"_19192":46007,"_5":13195,"_26170":45962,"_2648":46008},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3150":348,"_27660":330,"_19192":46010,"_5":13195,"_26170":45966,"_2648":46011},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3150":349,"_27660":330,"_19192":46013,"_5":13195,"_26170":45966,"_2648":46014},[],"Area",{"_3150":350,"_27660":330,"_19192":46016,"_5":13195,"_26170":45966,"_2648":46017},[],"The Lamassu chart provides",{"_3150":351,"_27660":330,"_19192":46019,"_5":13195,"_26170":45966,"_2648":46020},[],"You provide",{"_3150":352,"_27660":330,"_19192":46022,"_5":13195,"_26170":45966,"_2648":46023},[],"Lamassu applications",{"_3150":353,"_27660":330,"_19192":46025,"_5":13195,"_26170":45966,"_2648":46026},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3150":354,"_27660":330,"_19192":46028,"_5":13195,"_26170":45966,"_2648":46029},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3150":355,"_27660":330,"_19192":46031,"_5":13195,"_26170":45966,"_2648":46032},[],"PostgreSQL data",{"_3150":356,"_27660":330,"_19192":46034,"_5":13195,"_26170":45966,"_2648":46035},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3150":357,"_27660":330,"_19192":46037,"_5":13195,"_26170":45966,"_2648":46038},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3150":358,"_27660":330,"_19192":46040,"_5":13195,"_26170":45966,"_2648":46041},[],"Messaging",{"_3150":359,"_27660":330,"_19192":46043,"_5":13195,"_26170":45966,"_2648":46044},[],"RabbitMQ connection configuration for the Lamassu services",{"_3150":360,"_27660":330,"_19192":46046,"_5":13195,"_26170":45966,"_2648":46047},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3150":361,"_27660":330,"_19192":46049,"_5":13195,"_26170":45966,"_2648":46050},[],"Identity",{"_3150":362,"_27660":330,"_19192":46052,"_5":13195,"_26170":45966,"_2648":46053},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3150":363,"_27660":330,"_19192":46055,"_5":13195,"_26170":45966,"_2648":46056},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3150":364,"_27660":330,"_19192":46058,"_5":13195,"_26170":45966,"_2648":46059},[],"External routing",{"_3150":365,"_27660":330,"_19192":46061,"_5":13195,"_26170":45966,"_2648":46062},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3150":366,"_27660":330,"_19192":46064,"_5":13195,"_26170":45966,"_2648":46065},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3150":367,"_27660":330,"_19192":46067,"_5":13195,"_26170":45966,"_2648":46068},[],"TLS",{"_3150":368,"_27660":330,"_19192":46070,"_5":13195,"_26170":45966,"_2648":46071},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_3150":369,"_27660":330,"_19192":46073,"_5":13195,"_26170":45966,"_2648":46074},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3150":370,"_27660":330,"_19192":46076,"_5":13195,"_26170":45966,"_2648":46077},[],"Persistent application data",{"_3150":371,"_27660":330,"_19192":46079,"_5":13195,"_26170":45966,"_2648":46080},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3150":372,"_27660":330,"_19192":46082,"_5":13195,"_26170":45966,"_2648":46083},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3150":373,"_27660":330,"_19192":46085,"_5":13195,"_26170":45966,"_2648":46086},[],"Optional integrations",{"_3150":374,"_27660":330,"_19192":46088,"_5":13195,"_26170":45966,"_2648":46089},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3150":375,"_27660":330,"_19192":46091,"_5":13195,"_26170":45966,"_2648":46092},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3150":376,"_27660":330,"_19192":46094,"_5":13195,"_26170":45966,"_2648":46095},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3150":377,"_27660":330,"_19192":46097,"_5":13195,"_26170":45966,"_2648":46098},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3150":378,"_27660":330,"_19192":46100,"_5":13195,"_26170":45970,"_2648":46101},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3150":379,"_27660":330,"_19192":46103,"_5":13195,"_26170":45970,"_2648":46104},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3150":380,"_27660":330,"_19192":46106,"_5":13195,"_26170":45974,"_2648":46107},[],"Kubernetes 1.24 or newer",{"_3150":381,"_27660":330,"_19192":46109,"_5":13195,"_26170":45974,"_2648":46110},[],"Helm 3.2 or newer",{"_3150":382,"_27660":330,"_19192":46112,"_5":13195,"_26170":45974,"_2648":46113},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3150":383,"_27660":330,"_19192":46115,"_5":13195,"_26170":45974,"_2648":46116},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_3150":384,"_27660":330,"_19192":46118,"_5":13195,"_26170":45974,"_2648":46119},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3150":385,"_27660":330,"_19192":46121,"_5":13195,"_26170":45974,"_2648":46122},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3150":386,"_27660":330,"_19192":46124,"_5":13195,"_26170":45974,"_2648":46125},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3150":387,"_27660":330,"_19192":46127,"_5":13195,"_26170":45978,"_2648":46128},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":388,"_27660":330,"_19192":46130,"_5":13195,"_26170":45978,"_2648":46131},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3150":389,"_27660":330,"_19192":46133,"_5":13195,"_26170":45978,"_2648":46134},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3150":390,"_27660":330,"_19192":46136,"_5":13195,"_26170":45978,"_2648":46137},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3150":391,"_27660":391,"_5":13521,"_2648":46139,"_28003":46140,"_19192":46142,"_26170":391},"Deployment troubleshooting",[44970,44971,46141],"Operations",[],{"_3150":392,"_27660":391,"_19192":46144,"_5":13195,"_26170":391,"_2648":46145},[],"Diagnose access, service health and infrastructure dependencies.",{"_3150":393,"_27660":391,"_5":28000,"_19192":46147,"_26170":46148,"_2648":46149},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3150":394,"_27660":391,"_5":28000,"_19192":46151,"_26170":46152,"_2648":46153},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3150":395,"_27660":391,"_5":28000,"_19192":46155,"_26170":46156,"_2648":46157},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3150":396,"_27660":391,"_5":28000,"_19192":46159,"_26170":46160,"_2648":46161},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3150":397,"_27660":391,"_5":28000,"_19192":46163,"_26170":46164,"_2648":46165},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3150":398,"_27660":391,"_5":28000,"_19192":46167,"_26170":46168,"_2648":46169},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3150":399,"_27660":391,"_5":28000,"_19192":46171,"_26170":46172,"_2648":46173},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3150":400,"_27660":391,"_5":28000,"_19192":46175,"_26170":46176,"_2648":46177},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3150":401,"_27660":391,"_5":28000,"_19192":46179,"_26170":46180,"_2648":46181},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3150":402,"_27660":391,"_5":28000,"_19192":46183,"_26170":46184,"_2648":46185},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3150":403,"_27660":391,"_5":28000,"_19192":46187,"_26170":46188,"_2648":46189},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3150":404,"_27660":391,"_5":28000,"_19192":46191,"_26170":46192,"_2648":46193},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#observability","Observability",{"_3150":405,"_27660":391,"_19192":46195,"_5":13195,"_26170":391,"_2648":46196},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3150":406,"_27660":391,"_19192":46198,"_5":13195,"_26170":46152,"_2648":46199},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3150":407,"_27660":391,"_19192":46201,"_5":13195,"_26170":46156,"_2648":46202},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3150":408,"_27660":391,"_19192":46204,"_5":13195,"_26170":46160,"_2648":46205},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3150":409,"_27660":391,"_19192":46207,"_5":13195,"_26170":46164,"_2648":46208},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3150":410,"_27660":391,"_19192":46210,"_5":13195,"_26170":46168,"_2648":46211},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3150":411,"_27660":391,"_19192":46213,"_5":13195,"_26170":46172,"_2648":46214},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3150":412,"_27660":391,"_19192":46216,"_5":13195,"_26170":46172,"_2648":46217},[],"Also run the chart's connectivity test:",{"_3150":413,"_27660":391,"_19192":46219,"_5":13195,"_26170":46172,"_2648":46220},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3150":414,"_27660":391,"_19192":46222,"_5":13195,"_26170":46172,"_2648":46223},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3150":415,"_27660":391,"_19192":46225,"_5":13195,"_26170":46176,"_2648":46226},[],"If you receive a 401:",{"_3150":416,"_27660":391,"_19192":46228,"_5":13195,"_26170":46176,"_2648":46229},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3150":417,"_27660":391,"_19192":46231,"_5":13195,"_26170":46176,"_2648":46232},[],"verify issuer, audience and expiration of the token;",{"_3150":418,"_27660":391,"_19192":46234,"_5":13195,"_26170":46176,"_2648":46235},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3150":419,"_27660":391,"_19192":46237,"_5":13195,"_26170":46176,"_2648":46238},[],"check that the provider's public and internal routes point to the same realm.",{"_3150":420,"_27660":391,"_19192":46240,"_5":13195,"_26170":46176,"_2648":46241},[],"If login succeeds but the APIs return 403:",{"_3150":421,"_27660":391,"_19192":46243,"_5":13195,"_26170":46176,"_2648":46244},[],"inspect the token's real claims;",{"_3150":422,"_27660":391,"_19192":46246,"_5":13195,"_26170":46176,"_2648":46247},[],"confirm they match an active principal;",{"_3150":423,"_27660":391,"_19192":46249,"_5":13195,"_26170":46176,"_2648":46250},[],"review the policies granted to that principal;",{"_3150":424,"_27660":391,"_19192":46252,"_5":13195,"_26170":46176,"_2648":46253},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3150":425,"_27660":391,"_19192":46255,"_5":13195,"_26170":46176,"_2648":46256},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3150":426,"_27660":391,"_19192":46258,"_5":13195,"_26170":46180,"_2648":46259},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3150":427,"_27660":391,"_19192":46261,"_5":13195,"_26170":46180,"_2648":46262},[],"Locate the authz pod and Service.",{"_3150":428,"_27660":391,"_19192":46264,"_5":13195,"_26170":46180,"_2648":46265},[],"Check /health, logs and its database connection.",{"_3150":429,"_27660":391,"_19192":46267,"_5":13195,"_26170":46180,"_2648":46268},[],"Verify the DNS and port configured in externalAuthorization.",{"_3150":430,"_27660":391,"_19192":46270,"_5":13195,"_26170":46180,"_2648":46271},[],"Check the check route is /v1/ext\\_authz/check.",{"_3150":431,"_27660":391,"_19192":46273,"_5":13195,"_26170":46180,"_2648":46274},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3150":432,"_27660":391,"_19192":46276,"_5":13195,"_26170":46184,"_2648":46277},[],"Review kubectl describe pod first. Common causes are:",{"_3150":433,"_27660":391,"_19192":46279,"_5":13195,"_26170":46184,"_2648":46280},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3150":434,"_27660":391,"_19192":46282,"_5":13195,"_26170":46184,"_2648":46283},[],"unbound persistent volume;",{"_3150":435,"_27660":391,"_19192":46285,"_5":13195,"_26170":46184,"_2648":46286},[],"inaccessible image or incorrect pull policy;",{"_3150":436,"_27660":391,"_19192":46288,"_5":13195,"_26170":46184,"_2648":46289},[],"invalid cryptographic engine configuration;",{"_3150":437,"_27660":391,"_19192":46291,"_5":13195,"_26170":46184,"_2648":46292},[],"CPU or memory limits set too low;",{"_3150":438,"_27660":391,"_19192":46294,"_5":13195,"_26170":46184,"_2648":46295},[],"an incomplete prior migration.",{"_3150":439,"_27660":391,"_19192":46297,"_5":13195,"_26170":46184,"_2648":46298},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3150":440,"_27660":391,"_19192":46300,"_5":13195,"_26170":46184,"_2648":46301},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3150":441,"_27660":391,"_19192":46303,"_5":13195,"_26170":46188,"_2648":46304},[],"Domain and audit events depend on the bus publisher:",{"_3150":442,"_27660":391,"_19192":46306,"_5":13195,"_26170":46188,"_2648":46307},[],"verify it is enabled in the emitting service;",{"_3150":443,"_27660":391,"_19192":46309,"_5":13195,"_26170":46188,"_2648":46310},[],"check AMQP connectivity and credentials;",{"_3150":444,"_27660":391,"_19192":46312,"_5":13195,"_26170":46188,"_2648":46313},[],"review exchange, routing key, queues and consumers;",{"_3150":445,"_27660":391,"_19192":46315,"_5":13195,"_26170":46188,"_2648":46316},[],"inspect dead-letter queues;",{"_3150":446,"_27660":391,"_19192":46318,"_5":13195,"_26170":46188,"_2648":46319},[],"alert on orphan durable queues and backlog growth.",{"_3150":447,"_27660":391,"_19192":46321,"_5":13195,"_26170":46188,"_2648":46322},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3150":448,"_27660":391,"_19192":46324,"_5":13195,"_26170":46192,"_2648":46325},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3150":449,"_27660":391,"_19192":46327,"_5":13195,"_26170":46192,"_2648":46328},[],"Before closing an incident, record:",{"_3150":450,"_27660":391,"_19192":46330,"_5":13195,"_26170":46192,"_2648":46331},[],"the confirmed cause;",{"_3150":451,"_27660":391,"_19192":46333,"_5":13195,"_26170":46192,"_2648":46334},[],"the time scope and affected resources;",{"_3150":452,"_27660":391,"_19192":46336,"_5":13195,"_26170":46192,"_2648":46337},[],"the commands or queries used;",{"_3150":453,"_27660":391,"_19192":46339,"_5":13195,"_26170":46192,"_2648":46340},[],"the applied change and how to revert it;",{"_3150":454,"_27660":391,"_19192":46342,"_5":13195,"_26170":46192,"_2648":46343},[],"validation from a consumer;",{"_3150":455,"_27660":391,"_19192":46345,"_5":13195,"_26170":46192,"_2648":46346},[],"the preventive action and its owner.",{"_3150":456,"_27660":456,"_5":13521,"_2648":46348,"_28003":46349,"_19192":46352,"_26170":456},"Access control",[44970,46350,46351],"Platform","Administration",[],{"_3150":457,"_27660":456,"_19192":46354,"_5":13195,"_26170":456,"_2648":46355},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3150":458,"_27660":456,"_5":28000,"_19192":46357,"_26170":46358,"_2648":46359},[],"/docs/pr-preview/pr-26/platform/administration/access-control#essential-concepts","Essential concepts",{"_3150":459,"_27660":456,"_5":28000,"_19192":46361,"_26170":46362,"_2648":46363},[],"/docs/pr-preview/pr-26/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3150":460,"_27660":456,"_5":28000,"_19192":46365,"_26170":46366,"_2648":46367},[],"/docs/pr-preview/pr-26/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3150":461,"_27660":456,"_5":28000,"_19192":46369,"_26170":46370,"_2648":46371},[],"/docs/pr-preview/pr-26/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3150":462,"_27660":456,"_5":28000,"_19192":46373,"_26170":46374,"_2648":46375},[],"/docs/pr-preview/pr-26/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3150":463,"_27660":456,"_5":28000,"_19192":46377,"_26170":46378,"_2648":46379},[],"/docs/pr-preview/pr-26/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3150":464,"_27660":456,"_5":28000,"_19192":46381,"_26170":46382,"_2648":46383},[],"/docs/pr-preview/pr-26/platform/administration/access-control#oidc-principals","OIDC principals",{"_3150":465,"_27660":456,"_5":28000,"_19192":46385,"_26170":46386,"_2648":46387},[],"/docs/pr-preview/pr-26/platform/administration/access-control#x509-principals","X.509 principals",{"_3150":466,"_27660":456,"_5":28000,"_19192":46389,"_26170":46390,"_2648":46391},[],"/docs/pr-preview/pr-26/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3150":467,"_27660":456,"_5":28000,"_19192":46393,"_26170":46394,"_2648":46395},[],"/docs/pr-preview/pr-26/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3150":468,"_27660":456,"_5":28000,"_19192":46397,"_26170":46398,"_2648":46399},[],"/docs/pr-preview/pr-26/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3150":469,"_27660":456,"_5":28000,"_19192":46401,"_26170":46402,"_2648":46403},[],"/docs/pr-preview/pr-26/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3150":470,"_27660":456,"_5":28000,"_19192":46405,"_26170":46406,"_2648":46407},[],"/docs/pr-preview/pr-26/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3150":471,"_27660":456,"_5":28000,"_19192":46409,"_26170":46410,"_2648":46411},[],"/docs/pr-preview/pr-26/platform/administration/access-control#http-rules","HTTP rules",{"_3150":472,"_27660":456,"_5":28000,"_19192":46413,"_26170":46414,"_2648":46415},[],"/docs/pr-preview/pr-26/platform/administration/access-control#included-policies","Included policies",{"_3150":473,"_27660":456,"_5":28000,"_19192":46417,"_26170":46418,"_2648":45606},[],"/docs/pr-preview/pr-26/platform/administration/access-control#provision-the-first-administrator",{"_3150":474,"_27660":456,"_5":28000,"_19192":46420,"_26170":46421,"_2648":46422},[],"/docs/pr-preview/pr-26/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3150":475,"_27660":456,"_5":28000,"_19192":46424,"_26170":46425,"_2648":46426},[],"/docs/pr-preview/pr-26/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3150":476,"_27660":456,"_5":28000,"_19192":46428,"_26170":46429,"_2648":46430},[],"/docs/pr-preview/pr-26/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3150":477,"_27660":456,"_5":28000,"_19192":46432,"_26170":46433,"_2648":46434},[],"/docs/pr-preview/pr-26/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3150":478,"_27660":456,"_5":28000,"_19192":46436,"_26170":46437,"_2648":46438},[],"/docs/pr-preview/pr-26/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3150":479,"_27660":456,"_5":28000,"_19192":46440,"_26170":46441,"_2648":46442},[],"/docs/pr-preview/pr-26/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3150":480,"_27660":456,"_5":28000,"_19192":46444,"_26170":46445,"_2648":46446},[],"/docs/pr-preview/pr-26/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3150":481,"_27660":456,"_5":28000,"_19192":46448,"_26170":46449,"_2648":46450},[],"/docs/pr-preview/pr-26/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3150":482,"_27660":456,"_5":28000,"_19192":46452,"_26170":46453,"_2648":46454},[],"/docs/pr-preview/pr-26/platform/administration/access-control#operational-checklist","Operational checklist",{"_3150":483,"_27660":456,"_5":28000,"_19192":46456,"_26170":46457,"_2648":46458},[],"/docs/pr-preview/pr-26/platform/administration/access-control#diagnostics","Diagnostics",{"_3150":484,"_27660":456,"_5":28000,"_19192":46460,"_26170":46461,"_2648":46462},[],"/docs/pr-preview/pr-26/platform/administration/access-control#the-response-is-401","The response is 401",{"_3150":485,"_27660":456,"_5":28000,"_19192":46464,"_26170":46465,"_2648":46466},[],"/docs/pr-preview/pr-26/platform/administration/access-control#the-response-is-403","The response is 403",{"_3150":486,"_27660":456,"_5":28000,"_19192":46468,"_26170":46469,"_2648":46470},[],"/docs/pr-preview/pr-26/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3150":487,"_27660":456,"_5":28000,"_19192":46472,"_26170":46473,"_2648":46474},[],"/docs/pr-preview/pr-26/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3150":488,"_27660":456,"_5":28000,"_19192":46476,"_26170":46477,"_2648":46478},[],"/docs/pr-preview/pr-26/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3150":489,"_27660":456,"_19192":46480,"_5":13195,"_26170":456,"_2648":46481},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3150":490,"_27660":456,"_19192":46483,"_5":13195,"_26170":456,"_2648":46484},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3150":491,"_27660":456,"_19192":46486,"_5":13195,"_26170":456,"_2648":46487},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3150":492,"_27660":456,"_19192":46489,"_5":13195,"_26170":46358,"_2648":46490},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3150":493,"_27660":456,"_19192":46492,"_5":13195,"_26170":46358,"_2648":46493},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3150":494,"_27660":456,"_19192":46495,"_5":13195,"_26170":46358,"_2648":46496},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3150":495,"_27660":456,"_19192":46498,"_5":13195,"_26170":46358,"_2648":46499},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3150":496,"_27660":456,"_19192":46501,"_5":13195,"_26170":46358,"_2648":46502},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3150":497,"_27660":456,"_19192":46504,"_5":13195,"_26170":46358,"_2648":46505},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3150":498,"_27660":456,"_19192":46507,"_5":13195,"_26170":46362,"_2648":46508},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3150":499,"_27660":456,"_19192":46510,"_5":13195,"_26170":46362,"_2648":46511},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3150":500,"_27660":456,"_19192":46513,"_5":13195,"_26170":46366,"_2648":46514},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3150":501,"_27660":456,"_19192":46516,"_5":13195,"_26170":46366,"_2648":46517},[],"The decision is made **before forwarding the request to the service**:",{"_3150":502,"_27660":456,"_19192":46519,"_5":13195,"_26170":46366,"_2648":46520},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3150":503,"_27660":456,"_19192":46522,"_5":13195,"_26170":46366,"_2648":46523},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3150":504,"_27660":456,"_19192":46525,"_5":13195,"_26170":46366,"_2648":46526},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3150":505,"_27660":456,"_19192":46528,"_5":13195,"_26170":46366,"_2648":46529},[],"It separately loads the policies granted to each principal.",{"_3150":506,"_27660":456,"_19192":46531,"_5":13195,"_26170":46366,"_2648":46532},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3150":507,"_27660":456,"_19192":46534,"_5":13195,"_26170":46366,"_2648":46535},[],"`authz` looks for an HTTP rule granting that action.",{"_3150":508,"_27660":456,"_19192":46537,"_5":13195,"_26170":46366,"_2648":46538},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3150":509,"_27660":456,"_19192":46540,"_5":13195,"_26170":46366,"_2648":46541},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3150":510,"_27660":456,"_19192":46543,"_5":13195,"_26170":46366,"_2648":46544},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3150":511,"_27660":456,"_19192":46546,"_5":13195,"_26170":46366,"_2648":46547},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3150":512,"_27660":456,"_19192":46549,"_5":13195,"_26170":46370,"_2648":46550},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3150":513,"_27660":456,"_19192":46552,"_5":13195,"_26170":46370,"_2648":46553},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3150":514,"_27660":456,"_19192":46555,"_5":13195,"_26170":46370,"_2648":46556},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3150":515,"_27660":456,"_19192":46558,"_5":13195,"_26170":46370,"_2648":46559},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3150":516,"_27660":456,"_19192":46561,"_5":13195,"_26170":46370,"_2648":46562},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3150":517,"_27660":456,"_19192":46564,"_5":13195,"_26170":46370,"_2648":46565},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3150":518,"_27660":456,"_19192":46567,"_5":13195,"_26170":46370,"_2648":46568},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3150":519,"_27660":456,"_19192":46570,"_5":13195,"_26170":46370,"_2648":46571},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3150":520,"_27660":456,"_19192":46573,"_5":13195,"_26170":46374,"_2648":46574},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3150":521,"_27660":456,"_19192":46576,"_5":13195,"_26170":46374,"_2648":46577},[],"The decision is made with the domain operation context:",{"_3150":522,"_27660":456,"_19192":46579,"_5":13195,"_26170":46374,"_2648":46580},[],"The middleware extracts the credential and resolves the matching principals.",{"_3150":523,"_27660":456,"_19192":46582,"_5":13195,"_26170":46374,"_2648":46583},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3150":524,"_27660":456,"_19192":46585,"_5":13195,"_26170":46374,"_2648":46586},[],"`authz` gathers the entity rules of the granted policies.",{"_3150":525,"_27660":456,"_19192":46588,"_5":13195,"_26170":46374,"_2648":46589},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3150":526,"_27660":456,"_19192":46591,"_5":13195,"_26170":46374,"_2648":46592},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3150":527,"_27660":456,"_19192":46594,"_5":13195,"_26170":46374,"_2648":46595},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3150":528,"_27660":456,"_19192":46597,"_5":13195,"_26170":46374,"_2648":46598},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3150":529,"_27660":456,"_19192":46600,"_5":13195,"_26170":46374,"_2648":46601},[],"Actions fall into two groups:",{"_3150":530,"_27660":456,"_19192":46603,"_5":13195,"_26170":46374,"_2648":46604},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3150":531,"_27660":456,"_19192":46606,"_5":13195,"_26170":46374,"_2648":46607},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3150":532,"_27660":456,"_19192":46609,"_5":13195,"_26170":46374,"_2648":46610},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3150":533,"_27660":456,"_19192":46612,"_5":13195,"_26170":46378,"_2648":46613},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3150":534,"_27660":456,"_19192":46615,"_5":13195,"_26170":46378,"_2648":46616},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3150":535,"_27660":456,"_19192":46618,"_5":13195,"_26170":46378,"_2648":46619},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3150":536,"_27660":456,"_19192":46621,"_5":13195,"_26170":46382,"_2648":46622},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3150":537,"_27660":456,"_19192":46624,"_5":13195,"_26170":46382,"_2648":46625},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3150":538,"_27660":456,"_19192":46627,"_5":13195,"_26170":46382,"_2648":46628},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3150":539,"_27660":456,"_19192":46630,"_5":13195,"_26170":46382,"_2648":46631},[],"The implemented operators are:",{"_3150":540,"_27660":456,"_19192":46633,"_5":13195,"_26170":46382,"_2648":46634},[],"`equals`, for exact equality;",{"_3150":541,"_27660":456,"_19192":46636,"_5":13195,"_26170":46382,"_2648":46637},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3150":542,"_27660":456,"_19192":46639,"_5":13195,"_26170":46382,"_2648":46640},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3150":543,"_27660":456,"_19192":46642,"_5":13195,"_26170":46382,"_2648":46643},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3150":544,"_27660":456,"_19192":46645,"_5":13195,"_26170":46386,"_2648":46646},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3150":545,"_27660":456,"_19192":46648,"_5":13195,"_26170":46386,"_2648":46649},[],"The available modes are:",{"_3150":546,"_27660":456,"_19192":46651,"_5":13195,"_26170":46386,"_2648":46652},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3150":547,"_27660":456,"_19192":46654,"_5":13195,"_26170":46386,"_2648":46655},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3150":548,"_27660":456,"_19192":46657,"_5":13195,"_26170":46386,"_2648":46658},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3150":549,"_27660":456,"_19192":46660,"_5":13195,"_26170":46386,"_2648":46661},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3150":550,"_27660":456,"_19192":46663,"_5":13195,"_26170":46386,"_2648":46664},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3150":551,"_27660":456,"_19192":46666,"_5":13195,"_26170":46386,"_2648":46667},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3150":552,"_27660":456,"_19192":46669,"_5":13195,"_26170":46390,"_2648":46670},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3150":553,"_27660":456,"_19192":46672,"_5":13195,"_26170":46390,"_2648":46673},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3150":554,"_27660":456,"_19192":46675,"_5":13195,"_26170":46390,"_2648":46676},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3150":555,"_27660":456,"_19192":46678,"_5":13195,"_26170":46390,"_2648":46679},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3150":556,"_27660":456,"_19192":46681,"_5":13195,"_26170":46398,"_2648":46682},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3150":557,"_27660":456,"_19192":46684,"_5":13195,"_26170":46398,"_2648":46685},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3150":558,"_27660":456,"_19192":46687,"_5":13195,"_26170":46402,"_2648":46688},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3150":559,"_27660":456,"_19192":46690,"_5":13195,"_26170":46402,"_2648":46691},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3150":560,"_27660":456,"_19192":46693,"_5":13195,"_26170":46406,"_2648":46694},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3150":561,"_27660":456,"_19192":46696,"_5":13195,"_26170":46406,"_2648":46697},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3150":562,"_27660":456,"_19192":46699,"_5":13195,"_26170":46406,"_2648":46700},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3150":563,"_27660":456,"_19192":46702,"_5":13195,"_26170":46410,"_2648":46703},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3150":564,"_27660":456,"_19192":46705,"_5":13195,"_26170":46410,"_2648":46706},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3150":565,"_27660":456,"_19192":46708,"_5":13195,"_26170":46410,"_2648":46709},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3150":566,"_27660":456,"_19192":46711,"_5":13195,"_26170":46410,"_2648":46712},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3150":567,"_27660":456,"_19192":46714,"_5":13195,"_26170":46410,"_2648":46715},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3150":568,"_27660":456,"_19192":46717,"_5":13195,"_26170":46410,"_2648":46718},[],"Note that:",{"_3150":569,"_27660":456,"_19192":46720,"_5":13195,"_26170":46410,"_2648":46721},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3150":570,"_27660":456,"_19192":46723,"_5":13195,"_26170":46410,"_2648":46724},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3150":571,"_27660":456,"_19192":46726,"_5":13195,"_26170":46410,"_2648":46727},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3150":572,"_27660":456,"_19192":46729,"_5":13195,"_26170":46414,"_2648":46730},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3150":573,"_27660":456,"_19192":46732,"_5":13195,"_26170":46414,"_2648":46733},[],"full and read-only access to certificates and authorities;",{"_3150":574,"_27660":456,"_19192":46735,"_5":13195,"_26170":46414,"_2648":46736},[],"full and read-only access to the KMS;",{"_3150":575,"_27660":456,"_19192":46738,"_5":13195,"_26170":46414,"_2648":46739},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3150":576,"_27660":456,"_19192":46741,"_5":13195,"_26170":46414,"_2648":46742},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3150":577,"_27660":456,"_19192":46744,"_5":13195,"_26170":46414,"_2648":46745},[],"console access;",{"_3150":578,"_27660":456,"_19192":46747,"_5":13195,"_26170":46414,"_2648":46748},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3150":579,"_27660":456,"_19192":46750,"_5":13195,"_26170":46414,"_2648":46751},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3150":580,"_27660":456,"_19192":46753,"_5":13195,"_26170":46414,"_2648":46754},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3150":581,"_27660":456,"_19192":46756,"_5":13195,"_26170":46418,"_2648":46757},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3150":582,"_27660":456,"_19192":46759,"_5":13195,"_26170":46418,"_2648":46760},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3150":583,"_27660":456,"_19192":46762,"_5":13195,"_26170":46418,"_2648":46763},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3150":584,"_27660":456,"_19192":46765,"_5":13195,"_26170":46421,"_2648":46766},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3150":585,"_27660":456,"_19192":46768,"_5":13195,"_26170":46425,"_2648":46769},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3150":586,"_27660":456,"_19192":46771,"_5":13195,"_26170":46425,"_2648":46772},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3150":587,"_27660":456,"_19192":46774,"_5":13195,"_26170":46429,"_2648":46775},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3150":588,"_27660":456,"_19192":46777,"_5":13195,"_26170":46433,"_2648":46778},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3150":589,"_27660":456,"_19192":46780,"_5":13195,"_26170":46437,"_2648":46781},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3150":590,"_27660":456,"_19192":46783,"_5":13195,"_26170":46441,"_2648":46784},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3150":591,"_27660":456,"_19192":46786,"_5":13195,"_26170":46441,"_2648":46787},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3150":592,"_27660":456,"_19192":46789,"_5":13195,"_26170":46445,"_2648":46790},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3150":593,"_27660":456,"_19192":46792,"_5":13195,"_26170":46445,"_2648":46793},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3150":594,"_27660":456,"_19192":46795,"_5":13195,"_26170":46445,"_2648":46796},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3150":595,"_27660":456,"_19192":46798,"_5":13195,"_26170":46445,"_2648":46799},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3150":596,"_27660":456,"_19192":46801,"_5":13195,"_26170":46445,"_2648":46802},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3150":597,"_27660":456,"_19192":46804,"_5":13195,"_26170":46445,"_2648":46805},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3150":598,"_27660":456,"_19192":46807,"_5":13195,"_26170":46445,"_2648":46808},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3150":599,"_27660":456,"_19192":46810,"_5":13195,"_26170":46445,"_2648":46811},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3150":600,"_27660":456,"_19192":46813,"_5":13195,"_26170":46449,"_2648":46814},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3150":601,"_27660":456,"_19192":46816,"_5":13195,"_26170":46449,"_2648":46817},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3150":602,"_27660":456,"_19192":46819,"_5":13195,"_26170":46449,"_2648":46820},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3150":603,"_27660":456,"_19192":46822,"_5":13195,"_26170":46453,"_2648":46823},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3150":604,"_27660":456,"_19192":46825,"_5":13195,"_26170":46453,"_2648":46826},[],"Use groups or stable roles for people and independent identities for automations.",{"_3150":605,"_27660":456,"_19192":46828,"_5":13195,"_26170":46453,"_2648":46829},[],"Keep at least two recovery administrators and test their access periodically.",{"_3150":606,"_27660":456,"_19192":46831,"_5":13195,"_26170":46453,"_2648":46832},[],"Review active principals, their matches and their grants after IdP changes.",{"_3150":607,"_27660":456,"_19192":46834,"_5":13195,"_26170":46453,"_2648":46835},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3150":608,"_27660":456,"_19192":46837,"_5":13195,"_26170":46453,"_2648":46838},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3150":609,"_27660":456,"_19192":46840,"_5":13195,"_26170":46453,"_2648":46841},[],"Always test one allowed and one denied operation for each role.",{"_3150":610,"_27660":456,"_19192":46843,"_5":13195,"_26170":46453,"_2648":46844},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3150":611,"_27660":456,"_19192":46846,"_5":13195,"_26170":46461,"_2648":46847},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3150":612,"_27660":456,"_19192":46849,"_5":13195,"_26170":46465,"_2648":46850},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3150":613,"_27660":456,"_19192":46852,"_5":13195,"_26170":46465,"_2648":46853},[],"that an active principal of the correct type exists;",{"_3150":614,"_27660":456,"_19192":46855,"_5":13195,"_26170":46465,"_2648":46856},[],"that the claim paths and values match the real token exactly;",{"_3150":615,"_27660":456,"_19192":46858,"_5":13195,"_26170":46465,"_2648":46859},[],"that all of the principal's conditions hold;",{"_3150":616,"_27660":456,"_19192":46861,"_5":13195,"_26170":46465,"_2648":46862},[],"that the principal has the expected policy granted;",{"_3150":617,"_27660":456,"_19192":46864,"_5":13195,"_26170":46465,"_2648":46865},[],"that the policy includes the action and the requested resource type or route;",{"_3150":618,"_27660":456,"_19192":46867,"_5":13195,"_26170":46465,"_2648":46868},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3150":619,"_27660":456,"_19192":46870,"_5":13195,"_26170":46465,"_2648":46871},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3150":620,"_27660":456,"_19192":46873,"_5":13195,"_26170":46469,"_2648":46874},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3150":621,"_27660":456,"_19192":46876,"_5":13195,"_26170":46473,"_2648":46877},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3150":622,"_27660":456,"_19192":46879,"_5":13195,"_26170":46477,"_2648":46880},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3150":623,"_27660":456,"_19192":46882,"_5":13195,"_26170":46477,"_2648":46883},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3150":624,"_27660":624,"_5":13521,"_2648":46885,"_28003":46886,"_19192":46887,"_26170":624},"Alerts and subscriptions",[44970,46350,46351],[],{"_3150":625,"_27660":624,"_19192":46889,"_5":13195,"_26170":624,"_2648":46890},[],"Send PKI events to people and external systems.",{"_3150":626,"_27660":624,"_5":28000,"_19192":46892,"_26170":46893,"_2648":46894},[],"/docs/pr-preview/pr-26/platform/administration/alerts#how-it-works","How it works",{"_3150":627,"_27660":624,"_5":28000,"_19192":46896,"_26170":46897,"_2648":46898},[],"/docs/pr-preview/pr-26/platform/administration/alerts#available-channels","Available channels",{"_3150":628,"_27660":624,"_5":28000,"_19192":46900,"_26170":46901,"_2648":46902},[],"/docs/pr-preview/pr-26/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3150":629,"_27660":624,"_5":28000,"_19192":46904,"_26170":46905,"_2648":46906},[],"/docs/pr-preview/pr-26/platform/administration/alerts#choose-the-event","Choose the event",{"_3150":630,"_27660":624,"_5":28000,"_19192":46908,"_26170":46909,"_2648":46910},[],"/docs/pr-preview/pr-26/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3150":631,"_27660":624,"_5":28000,"_19192":46912,"_26170":46913,"_2648":46914},[],"/docs/pr-preview/pr-26/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3150":632,"_27660":624,"_5":28000,"_19192":46916,"_26170":46917,"_2648":46918},[],"/docs/pr-preview/pr-26/platform/administration/alerts#review-and-activate","Review and activate",{"_3150":633,"_27660":624,"_5":28000,"_19192":46920,"_26170":46921,"_2648":46922},[],"/docs/pr-preview/pr-26/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3150":634,"_27660":624,"_5":28000,"_19192":46924,"_26170":46925,"_2648":46926},[],"/docs/pr-preview/pr-26/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3150":635,"_27660":624,"_5":28000,"_19192":46928,"_26170":46929,"_2648":46930},[],"/docs/pr-preview/pr-26/platform/administration/alerts#event-families","Event families",{"_3150":636,"_27660":624,"_19192":46932,"_5":13195,"_26170":624,"_2648":46933},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3150":637,"_27660":624,"_19192":46935,"_5":13195,"_26170":46893,"_2648":46936},[],"A service publishes a domain event.",{"_3150":638,"_27660":624,"_19192":46938,"_5":13195,"_26170":46893,"_2648":46939},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3150":639,"_27660":624,"_19192":46941,"_5":13195,"_26170":46893,"_2648":46942},[],"Each subscription's filter decides whether it should be notified.",{"_3150":640,"_27660":624,"_19192":46944,"_5":13195,"_26170":46893,"_2648":46945},[],"Lamassu delivers the event to the configured channel.",{"_3150":641,"_27660":624,"_19192":46947,"_5":13195,"_26170":46893,"_2648":46948},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3150":642,"_27660":624,"_19192":46950,"_5":13195,"_26170":46897,"_2648":46951},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3150":643,"_27660":624,"_19192":46953,"_5":13195,"_26170":46897,"_2648":46954},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3150":644,"_27660":624,"_19192":46956,"_5":13195,"_26170":46897,"_2648":46957},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3150":645,"_27660":624,"_19192":46959,"_5":13195,"_26170":46897,"_2648":46960},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3150":646,"_27660":624,"_19192":46962,"_5":13195,"_26170":46897,"_2648":46963},[],"`apikey_options` requires `header` and `key`.",{"_3150":647,"_27660":624,"_19192":46965,"_5":13195,"_26170":46897,"_2648":46966},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3150":648,"_27660":624,"_19192":46968,"_5":13195,"_26170":46897,"_2648":46969},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3150":649,"_27660":624,"_19192":46971,"_5":13195,"_26170":46897,"_2648":46972},[],"The alerts API reference documents the full `http_client` schema.",{"_3150":650,"_27660":624,"_19192":46974,"_5":13195,"_26170":46905,"_2648":46975},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3150":651,"_27660":624,"_19192":46977,"_5":13195,"_26170":46909,"_2648":46978},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3150":652,"_27660":624,"_19192":46980,"_5":13195,"_26170":46913,"_2648":46981},[],"Add a filter if you don't want to receive every instance of the event.",{"_3150":653,"_27660":624,"_19192":46983,"_5":13195,"_26170":46913,"_2648":46984},[],"**None** notifies all instances of the event.",{"_3150":654,"_27660":624,"_19192":46986,"_5":13195,"_26170":46913,"_2648":46987},[],"**JSON Path** evaluates one or more specific fields.",{"_3150":655,"_27660":624,"_19192":46989,"_5":13195,"_26170":46913,"_2648":46990},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3150":656,"_27660":624,"_19192":46992,"_5":13195,"_26170":46913,"_2648":46993},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3150":657,"_27660":624,"_19192":46995,"_5":13195,"_26170":46913,"_2648":46996},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3150":658,"_27660":624,"_19192":46998,"_5":13195,"_26170":46917,"_2648":46999},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3150":659,"_27660":624,"_19192":47001,"_5":13195,"_26170":46921,"_2648":47002},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3150":660,"_27660":624,"_19192":47004,"_5":13195,"_26170":46921,"_2648":47005},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3150":661,"_27660":624,"_19192":47007,"_5":13195,"_26170":46921,"_2648":47008},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3150":662,"_27660":624,"_19192":47010,"_5":13195,"_26170":46921,"_2648":47011},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3150":663,"_27660":624,"_19192":47013,"_5":13195,"_26170":46921,"_2648":47014},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3150":664,"_27660":624,"_19192":47016,"_5":13195,"_26170":46921,"_2648":47017},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3150":665,"_27660":624,"_19192":47019,"_5":13195,"_26170":46921,"_2648":47020},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3150":666,"_27660":624,"_19192":47022,"_5":13195,"_26170":46921,"_2648":47023},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3150":667,"_27660":624,"_19192":47025,"_5":13195,"_26170":46925,"_2648":47026},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3150":668,"_27660":624,"_19192":47028,"_5":13195,"_26170":46929,"_2648":47029},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3150":669,"_27660":624,"_19192":47031,"_5":13195,"_26170":46929,"_2648":47032},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3150":670,"_27660":624,"_19192":47034,"_5":13195,"_26170":46929,"_2648":47035},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3150":671,"_27660":624,"_19192":47037,"_5":13195,"_26170":46929,"_2648":47038},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3150":672,"_27660":624,"_19192":47040,"_5":13195,"_26170":46929,"_2648":47041},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3150":673,"_27660":624,"_19192":47043,"_5":13195,"_26170":46929,"_2648":47044},[],"**Validation:** `va.role.crl.create`.",{"_3150":674,"_27660":624,"_19192":47046,"_5":13195,"_26170":46929,"_2648":47047},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3150":675,"_27660":624,"_19192":47049,"_5":13195,"_26170":46929,"_2648":47050},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3150":676,"_27660":676,"_5":13521,"_2648":47052,"_28003":47053,"_19192":47054,"_26170":676},"Audit logs",[44970,46350,46351],[],{"_3150":677,"_27660":676,"_19192":47056,"_5":13195,"_26170":676,"_2648":47057},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3150":678,"_27660":676,"_5":28000,"_19192":47059,"_26170":47060,"_2648":47061},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3150":679,"_27660":676,"_5":28000,"_19192":47063,"_26170":47064,"_2648":47065},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#coverage","Coverage",{"_3150":680,"_27660":676,"_5":28000,"_19192":47067,"_26170":47068,"_2648":47069},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3150":681,"_27660":676,"_5":28000,"_19192":47071,"_26170":47072,"_2648":47073},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3150":682,"_27660":676,"_5":28000,"_19192":47075,"_26170":47076,"_2648":47077},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3150":683,"_27660":676,"_5":28000,"_19192":47079,"_26170":47080,"_2648":47081},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3150":684,"_27660":676,"_5":28000,"_19192":47083,"_26170":47084,"_2648":47085},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3150":685,"_27660":676,"_5":28000,"_19192":47087,"_26170":47088,"_2648":47089},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3150":686,"_27660":676,"_5":28000,"_19192":47091,"_26170":47092,"_2648":47093},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3150":687,"_27660":676,"_5":28000,"_19192":47095,"_26170":47096,"_2648":47097},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3150":688,"_27660":676,"_5":28000,"_19192":47099,"_26170":47100,"_2648":47101},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3150":689,"_27660":676,"_19192":47103,"_5":13195,"_26170":676,"_2648":47104},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3150":690,"_27660":676,"_19192":47106,"_5":13195,"_26170":47060,"_2648":47107},[],"The audit body includes:",{"_3150":691,"_27660":676,"_19192":47109,"_5":13195,"_26170":47060,"_2648":47110},[],"input: data received by the operation;",{"_3150":692,"_27660":676,"_19192":47112,"_5":13195,"_26170":47060,"_2648":47113},[],"has\\_error: whether the service returned an error;",{"_3150":693,"_27660":676,"_19192":47115,"_5":13195,"_26170":47060,"_2648":47116},[],"output: produced result or error message;",{"_3150":694,"_27660":676,"_19192":47118,"_5":13195,"_26170":47060,"_2648":47119},[],"principals: identifiers of the principals that matched the request.",{"_3150":695,"_27660":676,"_19192":47121,"_5":13195,"_26170":47060,"_2648":47122},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3150":696,"_27660":676,"_19192":47124,"_5":13195,"_26170":47060,"_2648":47125},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3150":697,"_27660":676,"_19192":47127,"_5":13195,"_26170":47064,"_2648":47128},[],"The backend applies auditing to mutations of:",{"_3150":698,"_27660":676,"_19192":47130,"_5":13195,"_26170":47064,"_2648":47131},[],"authorities, certificates and issuance profiles;",{"_3150":699,"_27660":676,"_19192":47133,"_5":13195,"_26170":47064,"_2648":47134},[],"keys and KMS engines;",{"_3150":700,"_27660":676,"_19192":47136,"_5":13195,"_26170":47064,"_2648":47137},[],"devices and identities;",{"_3150":701,"_27660":676,"_19192":47139,"_5":13195,"_26170":47064,"_2648":47140},[],"DMSs and enrollment operations;",{"_3150":702,"_27660":676,"_19192":47142,"_5":13195,"_26170":47064,"_2648":47143},[],"validation functions and CRL;",{"_3150":703,"_27660":676,"_19192":47145,"_5":13195,"_26170":47064,"_2648":47146},[],"principals, policies and authorization grants.",{"_3150":704,"_27660":676,"_19192":47148,"_5":13195,"_26170":47064,"_2648":47149},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3150":705,"_27660":676,"_19192":47151,"_5":13195,"_26170":47068,"_2648":47152},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3150":706,"_27660":676,"_19192":47154,"_5":13195,"_26170":47068,"_2648":47155},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3150":707,"_27660":676,"_19192":47157,"_5":13195,"_26170":47068,"_2648":47158},[],"Design the consumer to:",{"_3150":708,"_27660":676,"_19192":47160,"_5":13195,"_26170":47068,"_2648":47161},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3150":709,"_27660":676,"_19192":47163,"_5":13195,"_26170":47068,"_2648":47164},[],"keep the complete CloudEvent unmodified;",{"_3150":710,"_27660":676,"_19192":47166,"_5":13195,"_26170":47068,"_2648":47167},[],"record the ingestion time and detect duplicates by ID;",{"_3150":711,"_27660":676,"_19192":47169,"_5":13195,"_26170":47068,"_2648":47170},[],"encrypt in transit and at rest;",{"_3150":712,"_27660":676,"_19192":47172,"_5":13195,"_26170":47068,"_2648":47173},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3150":713,"_27660":676,"_19192":47175,"_5":13195,"_26170":47068,"_2648":47176},[],"apply an explicit retention and legal hold policy;",{"_3150":714,"_27660":676,"_19192":47178,"_5":13195,"_26170":47068,"_2648":47179},[],"alert if it stops consuming or the pending queue grows.",{"_3150":715,"_27660":676,"_19192":47181,"_5":13195,"_26170":47072,"_2648":47182},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3150":716,"_27660":676,"_19192":47184,"_5":13195,"_26170":47072,"_2648":47185},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3150":717,"_27660":676,"_19192":47187,"_5":13195,"_26170":47080,"_2648":47188},[],"Start from the reported time and normalize every source to UTC.",{"_3150":718,"_27660":676,"_19192":47190,"_5":13195,"_26170":47084,"_2648":47191},[],"Filter by event type, service source and resource identifier.",{"_3150":719,"_27660":676,"_19192":47193,"_5":13195,"_26170":47088,"_2648":47194},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3150":720,"_27660":676,"_19192":47196,"_5":13195,"_26170":47092,"_2648":47197},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3150":721,"_27660":676,"_19192":47199,"_5":13195,"_26170":47096,"_2648":47200},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3150":722,"_27660":676,"_19192":47202,"_5":13195,"_26170":47100,"_2648":47203},[],"Generate a controlled mutation in a test environment and check that:",{"_3150":723,"_27660":676,"_19192":47205,"_5":13195,"_26170":47100,"_2648":47206},[],"a successful audit event appears;",{"_3150":724,"_27660":676,"_19192":47208,"_5":13195,"_26170":47100,"_2648":47209},[],"the principal matches the identity used;",{"_3150":725,"_27660":676,"_19192":47211,"_5":13195,"_26170":47100,"_2648":47212},[],"the consumer persists it exactly once;",{"_3150":726,"_27660":676,"_19192":47214,"_5":13195,"_26170":47100,"_2648":47215},[],"it can be retrieved by resource, actor and period;",{"_3150":727,"_27660":676,"_19192":47217,"_5":13195,"_26170":47100,"_2648":47218},[],"a consumer outage raises an alert.",{"_3150":728,"_27660":676,"_19192":47220,"_5":13195,"_26170":47100,"_2648":47221},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3150":729,"_27660":729,"_5":13521,"_2648":47223,"_28003":47224,"_19192":47225,"_26170":729},"Platform architecture",[44970,46350],[],{"_3150":730,"_27660":729,"_19192":47227,"_5":13195,"_26170":729,"_2648":47228},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3150":731,"_27660":729,"_5":28000,"_19192":47230,"_26170":47231,"_2648":47232},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#control-plane","Control plane",{"_3150":732,"_27660":729,"_5":28000,"_19192":47234,"_26170":47235,"_2648":47236},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3150":733,"_27660":729,"_5":28000,"_19192":47238,"_26170":47239,"_2648":47240},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3150":734,"_27660":729,"_5":28000,"_19192":47242,"_26170":47243,"_2648":47244},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#status-and-validation","Status and validation",{"_3150":735,"_27660":729,"_5":28000,"_19192":47246,"_26170":47247,"_2648":47248},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3150":736,"_27660":729,"_19192":47250,"_5":13195,"_26170":729,"_2648":47251},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3150":737,"_27660":729,"_19192":47253,"_5":13195,"_26170":729,"_2648":47254},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3150":738,"_27660":729,"_19192":47256,"_5":13195,"_26170":47231,"_2648":47257},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3150":739,"_27660":729,"_19192":47259,"_5":13195,"_26170":47235,"_2648":47260},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3150":740,"_27660":729,"_19192":47262,"_5":13195,"_26170":47239,"_2648":47263},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3150":741,"_27660":729,"_19192":47265,"_5":13195,"_26170":47243,"_2648":47266},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3150":742,"_27660":729,"_19192":47268,"_5":13195,"_26170":47247,"_2648":47269},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3150":743,"_27660":743,"_5":13521,"_2648":47271,"_28003":47272,"_19192":47273,"_26170":743},"How Lamassu works",[44970,46350],[],{"_3150":744,"_27660":743,"_19192":47275,"_5":13195,"_26170":743,"_2648":47276},[],"The mental model of trust, keys, certificates and devices.",{"_3150":745,"_27660":743,"_5":28000,"_19192":47278,"_26170":47279,"_2648":47280},[],"/docs/pr-preview/pr-26/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3150":746,"_27660":743,"_5":28000,"_19192":47282,"_26170":47283,"_2648":47284},[],"/docs/pr-preview/pr-26/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3150":747,"_27660":743,"_19192":47286,"_5":13195,"_26170":743,"_2648":47287},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3150":748,"_27660":743,"_19192":47289,"_5":13195,"_26170":47279,"_2648":47290},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3150":749,"_27660":743,"_19192":47292,"_5":13195,"_26170":47279,"_2648":47293},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3150":750,"_27660":743,"_19192":47295,"_5":13195,"_26170":47279,"_2648":47296},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3150":751,"_27660":743,"_19192":47298,"_5":13195,"_26170":47279,"_2648":47299},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3150":752,"_27660":743,"_19192":47301,"_5":13195,"_26170":47279,"_2648":47302},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3150":753,"_27660":743,"_19192":47304,"_5":13195,"_26170":47283,"_2648":47305},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3150":754,"_27660":743,"_19192":47307,"_5":13195,"_26170":47283,"_2648":47308},[],"A DMS relates that CA to an enrollment policy.",{"_3150":755,"_27660":743,"_19192":47310,"_5":13195,"_26170":47283,"_2648":47311},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3150":756,"_27660":743,"_19192":47313,"_5":13195,"_26170":47283,"_2648":47314},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3150":757,"_27660":743,"_19192":47316,"_5":13195,"_26170":47283,"_2648":47317},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3150":758,"_27660":743,"_19192":47319,"_5":13195,"_26170":47283,"_2648":47320},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3150":759,"_27660":743,"_19192":47322,"_5":13195,"_26170":47283,"_2648":47323},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3150":760,"_27660":760,"_5":13521,"_2648":47325,"_28003":47326,"_19192":47328,"_26170":760},"Devices and identities",[44970,46350,47327,47325],"IoT Fleets",[],{"_3150":761,"_27660":760,"_19192":47330,"_5":13195,"_26170":760,"_2648":47331},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3150":762,"_27660":760,"_5":28000,"_19192":47333,"_26170":47334,"_2648":47335},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#device-states","Device states",{"_3150":763,"_27660":760,"_5":28000,"_19192":47337,"_26170":47338,"_2648":47339},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3150":764,"_27660":760,"_5":28000,"_19192":47341,"_26170":47342,"_2648":47343},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3150":765,"_27660":760,"_5":28000,"_19192":47345,"_26170":47346,"_2648":47347},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3150":766,"_27660":760,"_5":28000,"_19192":47349,"_26170":47350,"_2648":47351},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3150":767,"_27660":760,"_5":28000,"_19192":47353,"_26170":47354,"_2648":47355},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3150":768,"_27660":760,"_5":28000,"_19192":47357,"_26170":47358,"_2648":47359},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3150":769,"_27660":760,"_5":28000,"_19192":47361,"_26170":47362,"_2648":47363},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3150":770,"_27660":760,"_5":28000,"_19192":47365,"_26170":47366,"_2648":47367},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3150":771,"_27660":760,"_5":28000,"_19192":47369,"_26170":47370,"_2648":47371},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3150":772,"_27660":760,"_5":28000,"_19192":47373,"_26170":47374,"_2648":47375},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3150":773,"_27660":760,"_19192":47377,"_5":13195,"_26170":760,"_2648":47378},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3150":774,"_27660":760,"_19192":47380,"_5":13195,"_26170":760,"_2648":47381},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3150":775,"_27660":760,"_19192":47383,"_5":13195,"_26170":47334,"_2648":47384},[],"Operational view",{"_3150":776,"_27660":760,"_19192":47386,"_5":13195,"_26170":47334,"_2648":47387},[],"Meaning",{"_3150":777,"_27660":760,"_19192":47389,"_5":13195,"_26170":47334,"_2648":47390},[],"**No Identity**",{"_3150":778,"_27660":760,"_19192":47392,"_5":13195,"_26170":47334,"_2648":47393},[],"A record exists without an associated identity.",{"_3150":779,"_27660":760,"_19192":47395,"_5":13195,"_26170":47334,"_2648":47396},[],"**Active**",{"_3150":780,"_27660":760,"_19192":47398,"_5":13195,"_26170":47334,"_2648":47399},[],"The slot is active; also check certificate dates, status and usages.",{"_3150":781,"_27660":760,"_19192":47401,"_5":13195,"_26170":47334,"_2648":47402},[],"**Renewal Pending**",{"_3150":782,"_27660":760,"_19192":47404,"_5":13195,"_26170":47334,"_2648":47405},[],"The identity is in the operational renewal window.",{"_3150":783,"_27660":760,"_19192":47407,"_5":13195,"_26170":47334,"_2648":47408},[],"**Expiring Soon**",{"_3150":784,"_27660":760,"_19192":47410,"_5":13195,"_26170":47334,"_2648":47411},[],"Expiration is approaching according to configured thresholds.",{"_3150":785,"_27660":760,"_19192":47413,"_5":13195,"_26170":47334,"_2648":47414},[],"**Expired**",{"_3150":786,"_27660":760,"_19192":47416,"_5":13195,"_26170":47334,"_2648":47417},[],"The identity has expired.",{"_3150":787,"_27660":760,"_19192":47419,"_5":13195,"_26170":47334,"_2648":47420},[],"**Revoked**",{"_3150":788,"_27660":760,"_19192":47422,"_5":13195,"_26170":47334,"_2648":47423},[],"The identity is marked revoked.",{"_3150":789,"_27660":760,"_19192":47425,"_5":13195,"_26170":47334,"_2648":47426},[],"**Decommissioned**",{"_3150":790,"_27660":760,"_19192":47428,"_5":13195,"_26170":47334,"_2648":47429},[],"The record is retired and ordinary updates do not restore operation.",{"_3150":791,"_27660":760,"_19192":47431,"_5":13195,"_26170":47334,"_2648":47432},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3150":792,"_27660":760,"_19192":47434,"_5":13195,"_26170":47338,"_2648":47435},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3150":793,"_27660":760,"_19192":47437,"_5":13195,"_26170":47338,"_2648":47438},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3150":794,"_27660":760,"_19192":47440,"_5":13195,"_26170":47338,"_2648":47441},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3150":795,"_27660":760,"_19192":47443,"_5":13195,"_26170":47338,"_2648":47444},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3150":796,"_27660":760,"_19192":47446,"_5":13195,"_26170":47342,"_2648":47447},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3150":797,"_27660":760,"_19192":47449,"_5":13195,"_26170":47346,"_2648":47450},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3150":798,"_27660":760,"_19192":47452,"_5":13195,"_26170":47350,"_2648":47453},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3150":799,"_27660":760,"_19192":47455,"_5":13195,"_26170":47354,"_2648":47456},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3150":800,"_27660":760,"_19192":47458,"_5":13195,"_26170":47358,"_2648":47459},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3150":801,"_27660":760,"_19192":47461,"_5":13195,"_26170":47358,"_2648":47462},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3150":802,"_27660":760,"_19192":47464,"_5":13195,"_26170":47362,"_2648":47465},[],"From **No Identity**, use **Assign Identity**:",{"_3150":803,"_27660":760,"_19192":47467,"_5":13195,"_26170":47362,"_2648":47468},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3150":804,"_27660":760,"_19192":47470,"_5":13195,"_26170":47362,"_2648":47471},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3150":805,"_27660":760,"_19192":47473,"_5":13195,"_26170":47362,"_2648":47474},[],"Confirm and read the serial, active version and history again.",{"_3150":806,"_27660":760,"_19192":47476,"_5":13195,"_26170":47362,"_2648":47477},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3150":807,"_27660":760,"_19192":47479,"_5":13195,"_26170":47362,"_2648":47480},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3150":808,"_27660":760,"_19192":47482,"_5":13195,"_26170":47366,"_2648":47483},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3150":809,"_27660":760,"_19192":47485,"_5":13195,"_26170":47366,"_2648":47486},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3150":810,"_27660":760,"_19192":47488,"_5":13195,"_26170":47370,"_2648":47489},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3150":811,"_27660":760,"_19192":47491,"_5":13195,"_26170":47370,"_2648":47492},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3150":812,"_27660":760,"_19192":47494,"_5":13195,"_26170":47370,"_2648":47495},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3150":813,"_27660":760,"_19192":47497,"_5":13195,"_26170":47370,"_2648":47498},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3150":814,"_27660":760,"_19192":47500,"_5":13195,"_26170":47374,"_2648":47501},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":815,"_27660":760,"_19192":47503,"_5":13195,"_26170":47374,"_2648":47504},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":816,"_27660":816,"_5":13521,"_2648":47506,"_28003":47507,"_19192":47509,"_26170":816},"Bootstrap identity and authentication",[44970,46350,47327,47325,47508],"Enrollment with PKI",[],{"_3150":817,"_27660":816,"_19192":47511,"_5":13195,"_26170":816,"_2648":47512},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3150":818,"_27660":816,"_5":28000,"_19192":47514,"_26170":47515,"_2648":47516},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3150":819,"_27660":816,"_5":28000,"_19192":47518,"_26170":47519,"_2648":47520},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3150":820,"_27660":816,"_5":28000,"_19192":47522,"_26170":47523,"_2648":47524},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3150":821,"_27660":816,"_5":28000,"_19192":47526,"_26170":47527,"_2648":47528},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3150":822,"_27660":816,"_5":28000,"_19192":47530,"_26170":47531,"_2648":47532},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3150":823,"_27660":816,"_19192":47534,"_5":13195,"_26170":816,"_2648":47535},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3150":824,"_27660":816,"_19192":47537,"_5":13195,"_26170":47515,"_2648":47538},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3150":825,"_27660":816,"_19192":47540,"_5":13195,"_26170":47515,"_2648":47541},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3150":826,"_27660":816,"_19192":47543,"_5":13195,"_26170":47519,"_2648":47544},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3150":827,"_27660":816,"_19192":47546,"_5":13195,"_26170":47519,"_2648":47547},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3150":828,"_27660":816,"_19192":47549,"_5":13195,"_26170":47519,"_2648":47550},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3150":829,"_27660":816,"_19192":47552,"_5":13195,"_26170":47523,"_2648":47553},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3150":830,"_27660":816,"_19192":47555,"_5":13195,"_26170":47523,"_2648":47556},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3150":831,"_27660":816,"_19192":47558,"_5":13195,"_26170":47527,"_2648":47559},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3150":832,"_27660":816,"_19192":47561,"_5":13195,"_26170":47527,"_2648":47562},[],"Example body:",{"_3150":833,"_27660":816,"_19192":47564,"_5":13195,"_26170":47527,"_2648":47565},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3150":834,"_27660":816,"_19192":47567,"_5":13195,"_26170":47527,"_2648":47568},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3150":835,"_27660":816,"_19192":47570,"_5":13195,"_26170":47527,"_2648":47571},[],"Continuation requires a successful HTTP response and JSON:",{"_3150":836,"_27660":816,"_19192":47573,"_5":13195,"_26170":47527,"_2648":47574},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3150":837,"_27660":816,"_19192":47576,"_5":13195,"_26170":47531,"_2648":47577},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3150":838,"_27660":816,"_19192":47579,"_5":13195,"_26170":47531,"_2648":47580},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3150":839,"_27660":839,"_5":13521,"_2648":47582,"_28003":47583,"_19192":47584,"_26170":839},"Configure and operate the DMS",[44970,46350,47327,47325,47508],[],{"_3150":840,"_27660":839,"_19192":47586,"_5":13195,"_26170":839,"_2648":47587},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3150":841,"_27660":839,"_5":28000,"_19192":47589,"_26170":47590,"_2648":44980},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3150":842,"_27660":839,"_5":28000,"_19192":47592,"_26170":47593,"_2648":47594},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3150":843,"_27660":839,"_5":28000,"_19192":47596,"_26170":47597,"_2648":47598},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3150":844,"_27660":839,"_5":28000,"_19192":47600,"_26170":47601,"_2648":47602},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3150":845,"_27660":839,"_5":28000,"_19192":47604,"_26170":47605,"_2648":47606},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3150":846,"_27660":839,"_5":28000,"_19192":47608,"_26170":47609,"_2648":47610},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3150":847,"_27660":839,"_5":28000,"_19192":47612,"_26170":47613,"_2648":47614},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3150":848,"_27660":839,"_5":28000,"_19192":47616,"_26170":47617,"_2648":47618},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3150":849,"_27660":839,"_5":28000,"_19192":47620,"_26170":47621,"_2648":47622},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3150":850,"_27660":839,"_5":28000,"_19192":47624,"_26170":47625,"_2648":47626},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3150":851,"_27660":839,"_5":28000,"_19192":47628,"_26170":47629,"_2648":47630},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3150":852,"_27660":839,"_5":28000,"_19192":47632,"_26170":47633,"_2648":47634},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3150":853,"_27660":839,"_5":28000,"_19192":47636,"_26170":47637,"_2648":47638},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3150":854,"_27660":839,"_5":28000,"_19192":47640,"_26170":47641,"_2648":47642},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3150":855,"_27660":839,"_5":28000,"_19192":47644,"_26170":47645,"_2648":47646},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3150":856,"_27660":839,"_5":28000,"_19192":47648,"_26170":47649,"_2648":47650},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3150":857,"_27660":839,"_5":28000,"_19192":47652,"_26170":47653,"_2648":47654},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3150":858,"_27660":839,"_5":28000,"_19192":47656,"_26170":47657,"_2648":47658},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3150":859,"_27660":839,"_19192":47660,"_5":13195,"_26170":839,"_2648":47661},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3150":860,"_27660":839,"_19192":47663,"_5":13195,"_26170":47590,"_2648":47664},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3150":861,"_27660":839,"_19192":47666,"_5":13195,"_26170":47590,"_2648":47667},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3150":862,"_27660":839,"_19192":47669,"_5":13195,"_26170":47597,"_2648":47670},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3150":863,"_27660":839,"_19192":47672,"_5":13195,"_26170":47601,"_2648":47673},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3150":864,"_27660":839,"_19192":47675,"_5":13195,"_26170":47605,"_2648":47676},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3150":865,"_27660":839,"_19192":47678,"_5":13195,"_26170":47609,"_2648":47679},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3150":866,"_27660":839,"_19192":47681,"_5":13195,"_26170":47613,"_2648":47682},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3150":867,"_27660":839,"_19192":47684,"_5":13195,"_26170":47621,"_2648":47685},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3150":868,"_27660":839,"_19192":47687,"_5":13195,"_26170":47621,"_2648":47688},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3150":869,"_27660":839,"_19192":47690,"_5":13195,"_26170":47625,"_2648":47691},[],"`settings.enrollment_settings` field",{"_3150":870,"_27660":839,"_19192":47693,"_5":13195,"_26170":47625,"_2648":47694},[],"Decision",{"_3150":871,"_27660":839,"_19192":47696,"_5":13195,"_26170":47625,"_2648":47697},[],"`protocol`",{"_3150":872,"_27660":839,"_19192":47699,"_5":13195,"_26170":47625,"_2648":47700},[],"`EST_RFC7030` for these operations.",{"_3150":873,"_27660":839,"_19192":47702,"_5":13195,"_26170":47625,"_2648":47703},[],"`enrollment_ca`",{"_3150":874,"_27660":839,"_19192":47705,"_5":13195,"_26170":47625,"_2648":47706},[],"ID of the signing CA.",{"_3150":875,"_27660":839,"_19192":47708,"_5":13195,"_26170":47625,"_2648":47709},[],"`verify_csr_signature`",{"_3150":876,"_27660":839,"_19192":47711,"_5":13195,"_26170":47625,"_2648":47712},[],"Keep `true` to verify CSR key possession.",{"_3150":877,"_27660":839,"_19192":47714,"_5":13195,"_26170":47625,"_2648":47715},[],"`enable_replaceable_enrollment`",{"_3150":878,"_27660":839,"_19192":47717,"_5":13195,"_26170":47625,"_2648":47718},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3150":879,"_27660":839,"_19192":47720,"_5":13195,"_26170":47625,"_2648":47721},[],"`est_rfc7030_settings.auth_mode`",{"_3150":880,"_27660":839,"_19192":47723,"_5":13195,"_26170":47625,"_2648":47724},[],"One of the four authentication modes.",{"_3150":881,"_27660":839,"_19192":47726,"_5":13195,"_26170":47625,"_2648":47727},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3150":882,"_27660":839,"_19192":47729,"_5":13195,"_26170":47629,"_2648":47730},[],"The blocks are independent:",{"_3150":883,"_27660":839,"_19192":47732,"_5":13195,"_26170":47629,"_2648":47733},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3150":884,"_27660":839,"_19192":47735,"_5":13195,"_26170":47629,"_2648":47736},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3150":885,"_27660":839,"_19192":47738,"_5":13195,"_26170":47629,"_2648":47739},[],"`auth_mode`",{"_3150":886,"_27660":839,"_19192":47741,"_5":13195,"_26170":47629,"_2648":47742},[],"Control applied in the configured operation",{"_3150":887,"_27660":839,"_19192":47744,"_5":13195,"_26170":47629,"_2648":47745},[],"`CLIENT_CERTIFICATE`",{"_3150":888,"_27660":839,"_19192":47747,"_5":13195,"_26170":47629,"_2648":47748},[],"Presented certificate validation.",{"_3150":889,"_27660":839,"_19192":47750,"_5":13195,"_26170":47629,"_2648":47751},[],"`EXTERNAL_WEBHOOK`",{"_3150":890,"_27660":839,"_19192":47753,"_5":13195,"_26170":47629,"_2648":47754},[],"Configured webhook authorization.",{"_3150":891,"_27660":839,"_19192":47756,"_5":13195,"_26170":47629,"_2648":47757},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3150":892,"_27660":839,"_19192":47759,"_5":13195,"_26170":47629,"_2648":47760},[],"Certificate validation followed by webhook approval.",{"_3150":893,"_27660":839,"_19192":47762,"_5":13195,"_26170":47629,"_2648":47763},[],"`NO_AUTH`",{"_3150":894,"_27660":839,"_19192":47765,"_5":13195,"_26170":47629,"_2648":47766},[],"No DMS requester authentication.",{"_3150":895,"_27660":839,"_19192":47768,"_5":13195,"_26170":47629,"_2648":47769},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3150":896,"_27660":839,"_19192":47771,"_5":13195,"_26170":47629,"_2648":47772},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3150":897,"_27660":839,"_19192":47774,"_5":13195,"_26170":47629,"_2648":47775},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3150":898,"_27660":839,"_19192":47777,"_5":13195,"_26170":47629,"_2648":47778},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3150":899,"_27660":839,"_19192":47780,"_5":13195,"_26170":47633,"_2648":47781},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3150":900,"_27660":839,"_19192":47783,"_5":13195,"_26170":47633,"_2648":47784},[],"`external_webhook_settings` field",{"_3150":901,"_27660":839,"_19192":47786,"_5":13195,"_26170":47633,"_2648":47694},[],{"_3150":902,"_27660":839,"_19192":47788,"_5":13195,"_26170":47633,"_2648":47789},[],"`url`",{"_3150":903,"_27660":839,"_19192":47791,"_5":13195,"_26170":47633,"_2648":47792},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3150":904,"_27660":839,"_19192":47794,"_5":13195,"_26170":47633,"_2648":47795},[],"`method`",{"_3150":905,"_27660":839,"_19192":47797,"_5":13195,"_26170":47633,"_2648":47798},[],"`POST` or `PUT`; `POST` by default.",{"_3150":906,"_27660":839,"_19192":47800,"_5":13195,"_26170":47633,"_2648":47801},[],"`name`",{"_3150":907,"_27660":839,"_19192":47803,"_5":13195,"_26170":47633,"_2648":47804},[],"Label used in service logs.",{"_3150":908,"_27660":839,"_19192":47806,"_5":13195,"_26170":47633,"_2648":47807},[],"`config.auth_mode`",{"_3150":909,"_27660":839,"_19192":47809,"_5":13195,"_26170":47633,"_2648":47810},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3150":910,"_27660":839,"_19192":47812,"_5":13195,"_26170":47633,"_2648":47813},[],"`config.apikey_options`",{"_3150":911,"_27660":839,"_19192":47815,"_5":13195,"_26170":47633,"_2648":47816},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3150":912,"_27660":839,"_19192":47818,"_5":13195,"_26170":47633,"_2648":47819},[],"`config.jwt_options`",{"_3150":913,"_27660":839,"_19192":47821,"_5":13195,"_26170":47633,"_2648":47822},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3150":914,"_27660":839,"_19192":47824,"_5":13195,"_26170":47633,"_2648":47825},[],"`config.mtls_options`",{"_3150":915,"_27660":839,"_19192":47827,"_5":13195,"_26170":47633,"_2648":47828},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3150":916,"_27660":839,"_19192":47830,"_5":13195,"_26170":47633,"_2648":47831},[],"`config.insecure_skip_verify`",{"_3150":917,"_27660":839,"_19192":47833,"_5":13195,"_26170":47633,"_2648":47834},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3150":918,"_27660":839,"_19192":47836,"_5":13195,"_26170":47633,"_2648":47837},[],"`config.call_timeout`",{"_3150":919,"_27660":839,"_19192":47839,"_5":13195,"_26170":47633,"_2648":47840},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3150":920,"_27660":839,"_19192":47842,"_5":13195,"_26170":47633,"_2648":47843},[],"Rules for that configuration:",{"_3150":921,"_27660":839,"_19192":47845,"_5":13195,"_26170":47633,"_2648":47846},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3150":922,"_27660":839,"_19192":47848,"_5":13195,"_26170":47633,"_2648":47849},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3150":923,"_27660":839,"_19192":47851,"_5":13195,"_26170":47633,"_2648":47852},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3150":924,"_27660":839,"_19192":47854,"_5":13195,"_26170":47633,"_2648":47855},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3150":925,"_27660":839,"_19192":47857,"_5":13195,"_26170":47633,"_2648":47858},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3150":926,"_27660":839,"_19192":47860,"_5":13195,"_26170":47633,"_2648":47861},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3150":927,"_27660":839,"_19192":47863,"_5":13195,"_26170":47633,"_2648":47864},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_3150":928,"_27660":839,"_19192":47866,"_5":13195,"_26170":47633,"_2648":47867},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3150":929,"_27660":839,"_19192":47869,"_5":13195,"_26170":47633,"_2648":47870},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3150":930,"_27660":839,"_19192":47872,"_5":13195,"_26170":47637,"_2648":47873},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3150":931,"_27660":839,"_19192":47875,"_5":13195,"_26170":47641,"_2648":47876},[],"`settings.reenrollment_settings` field",{"_3150":932,"_27660":839,"_19192":47878,"_5":13195,"_26170":47641,"_2648":45360},[],{"_3150":933,"_27660":839,"_19192":47880,"_5":13195,"_26170":47641,"_2648":47881},[],"`reenrollment_delta`",{"_3150":934,"_27660":839,"_19192":47883,"_5":13195,"_26170":47641,"_2648":47884},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3150":935,"_27660":839,"_19192":47886,"_5":13195,"_26170":47641,"_2648":47887},[],"`preventive_delta`",{"_3150":936,"_27660":839,"_19192":47889,"_5":13195,"_26170":47641,"_2648":47890},[],"Preventive operational monitoring threshold.",{"_3150":937,"_27660":839,"_19192":47892,"_5":13195,"_26170":47641,"_2648":47893},[],"`critical_delta`",{"_3150":938,"_27660":839,"_19192":47895,"_5":13195,"_26170":47641,"_2648":47896},[],"Critical operational monitoring threshold.",{"_3150":939,"_27660":839,"_19192":47898,"_5":13195,"_26170":47641,"_2648":47899},[],"`enable_expired_renewal`",{"_3150":940,"_27660":839,"_19192":47901,"_5":13195,"_26170":47641,"_2648":47902},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3150":941,"_27660":839,"_19192":47904,"_5":13195,"_26170":47641,"_2648":47905},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3150":942,"_27660":839,"_19192":47907,"_5":13195,"_26170":47641,"_2648":47908},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_3150":943,"_27660":839,"_19192":47910,"_5":13195,"_26170":47641,"_2648":47911},[],"`revoke_on_reenrollment`",{"_3150":944,"_27660":839,"_19192":47913,"_5":13195,"_26170":47641,"_2648":47914},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3150":945,"_27660":839,"_19192":47916,"_5":13195,"_26170":47641,"_2648":47917},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3150":946,"_27660":839,"_19192":47919,"_5":13195,"_26170":47645,"_2648":47920},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3150":947,"_27660":839,"_19192":47922,"_5":13195,"_26170":47649,"_2648":45354},[],{"_3150":948,"_27660":839,"_19192":47924,"_5":13195,"_26170":47649,"_2648":47925},[],"Published material",{"_3150":949,"_27660":839,"_19192":47927,"_5":13195,"_26170":47649,"_2648":47928},[],"**Include Lamassu System CA**",{"_3150":950,"_27660":839,"_19192":47930,"_5":13195,"_26170":47649,"_2648":47931},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3150":951,"_27660":839,"_19192":47933,"_5":13195,"_26170":47649,"_2648":47934},[],"**Include Enrollment CA**",{"_3150":952,"_27660":839,"_19192":47936,"_5":13195,"_26170":47649,"_2648":47937},[],"Selected issuing CA certificate.",{"_3150":953,"_27660":839,"_19192":47939,"_5":13195,"_26170":47649,"_2648":47940},[],"**Managed CAs**",{"_3150":954,"_27660":839,"_19192":47942,"_5":13195,"_26170":47649,"_2648":47943},[],"Explicitly selected CA certificates.",{"_3150":955,"_27660":839,"_19192":47945,"_5":13195,"_26170":47649,"_2648":47946},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3150":956,"_27660":839,"_19192":47948,"_5":13195,"_26170":47653,"_2648":47949},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3150":957,"_27660":839,"_19192":47951,"_5":13195,"_26170":47653,"_2648":47952},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3150":958,"_27660":839,"_19192":47954,"_5":13195,"_26170":47653,"_2648":47955},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3150":959,"_27660":839,"_19192":47957,"_5":13195,"_26170":47657,"_2648":47958},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3150":960,"_27660":960,"_5":13521,"_2648":47960,"_28003":47961,"_19192":47962,"_26170":960},"Integrate the EST client",[44970,46350,47327,47325,47508],[],{"_3150":961,"_27660":960,"_19192":47964,"_5":13195,"_26170":960,"_2648":47965},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3150":962,"_27660":960,"_5":28000,"_19192":47967,"_26170":47968,"_2648":44980},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3150":963,"_27660":960,"_5":28000,"_19192":47970,"_26170":47971,"_2648":47972},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3150":964,"_27660":960,"_5":28000,"_19192":47974,"_26170":47975,"_2648":47976},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3150":965,"_27660":960,"_5":28000,"_19192":47978,"_26170":47979,"_2648":47980},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3150":966,"_27660":960,"_5":28000,"_19192":47982,"_26170":47983,"_2648":47984},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3150":967,"_27660":960,"_5":28000,"_19192":47986,"_26170":47987,"_2648":47988},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3150":968,"_27660":960,"_19192":47990,"_5":13195,"_26170":960,"_2648":47991},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3150":969,"_27660":960,"_19192":47993,"_5":13195,"_26170":47968,"_2648":47994},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3150":970,"_27660":960,"_19192":47996,"_5":13195,"_26170":47968,"_2648":47997},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3150":971,"_27660":960,"_19192":47999,"_5":13195,"_26170":47968,"_2648":48000},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3150":972,"_27660":960,"_19192":48002,"_5":13195,"_26170":47971,"_2648":48003},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3150":973,"_27660":960,"_19192":48005,"_5":13195,"_26170":47971,"_2648":48006},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3150":974,"_27660":960,"_19192":48008,"_5":13195,"_26170":47975,"_2648":48009},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3150":975,"_27660":960,"_19192":48011,"_5":13195,"_26170":47975,"_2648":48012},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3150":976,"_27660":960,"_19192":48014,"_5":13195,"_26170":47979,"_2648":48015},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3150":977,"_27660":960,"_19192":48017,"_5":13195,"_26170":47979,"_2648":48018},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3150":978,"_27660":960,"_19192":48020,"_5":13195,"_26170":47983,"_2648":48021},[],"For a root that issues directly:",{"_3150":979,"_27660":960,"_19192":48023,"_5":13195,"_26170":47983,"_2648":48024},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3150":980,"_27660":960,"_19192":48026,"_5":13195,"_26170":47983,"_2648":48027},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3150":981,"_27660":960,"_19192":48029,"_5":13195,"_26170":47987,"_2648":48030},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3150":982,"_27660":982,"_5":13521,"_2648":48032,"_28003":48033,"_19192":48034,"_26170":982},"EST reference",[44970,46350,47327,47325,47508],[],{"_3150":983,"_27660":982,"_19192":48036,"_5":13195,"_26170":982,"_2648":48037},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3150":984,"_27660":982,"_5":28000,"_19192":48039,"_26170":48040,"_2648":48041},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3150":985,"_27660":982,"_5":28000,"_19192":48043,"_26170":48044,"_2648":20858},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3150":986,"_27660":982,"_5":28000,"_19192":48046,"_26170":48047,"_2648":23913},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3150":987,"_27660":982,"_5":28000,"_19192":48049,"_26170":48050,"_2648":23920},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3150":988,"_27660":982,"_5":28000,"_19192":48052,"_26170":48053,"_2648":23266},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3150":989,"_27660":982,"_5":28000,"_19192":48055,"_26170":48056,"_2648":48057},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3150":990,"_27660":982,"_5":28000,"_19192":48059,"_26170":48060,"_2648":48061},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3150":991,"_27660":982,"_5":28000,"_19192":48063,"_26170":48064,"_2648":48065},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3150":992,"_27660":982,"_19192":48067,"_5":13195,"_26170":982,"_2648":48068},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3150":993,"_27660":982,"_19192":48070,"_5":13195,"_26170":48040,"_2648":48071},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3150":994,"_27660":982,"_19192":48073,"_5":13195,"_26170":48040,"_2648":48074},[],"Operation",{"_3150":995,"_27660":982,"_19192":48076,"_5":13195,"_26170":48040,"_2648":48077},[],"Method",{"_3150":996,"_27660":982,"_19192":48079,"_5":13195,"_26170":48040,"_2648":48080},[],"Authentication and condition",{"_3150":997,"_27660":982,"_19192":48082,"_5":13195,"_26170":48040,"_2648":48083},[],"`/cacerts`",{"_3150":998,"_27660":982,"_19192":48085,"_5":13195,"_26170":48040,"_2648":48086},[],"GET",{"_3150":999,"_27660":982,"_19192":48088,"_5":13195,"_26170":48040,"_2648":48089},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3150":1000,"_27660":982,"_19192":48091,"_5":13195,"_26170":48040,"_2648":48092},[],"`/simpleenroll`",{"_3150":1001,"_27660":982,"_19192":48094,"_5":13195,"_26170":48040,"_2648":48095},[],"POST",{"_3150":1002,"_27660":982,"_19192":48097,"_5":13195,"_26170":48040,"_2648":48098},[],"Initial authentication and DMS registration/replacement policy.",{"_3150":1003,"_27660":982,"_19192":48100,"_5":13195,"_26170":48040,"_2648":48101},[],"`/simplereenroll`",{"_3150":1004,"_27660":982,"_19192":48103,"_5":13195,"_26170":48040,"_2648":48095},[],{"_3150":1005,"_27660":982,"_19192":48105,"_5":13195,"_26170":48040,"_2648":48106},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3150":1006,"_27660":982,"_19192":48108,"_5":13195,"_26170":48040,"_2648":48109},[],"`/serverkeygen`",{"_3150":1007,"_27660":982,"_19192":48111,"_5":13195,"_26170":48040,"_2648":48095},[],{"_3150":1008,"_27660":982,"_19192":48113,"_5":13195,"_26170":48040,"_2648":48114},[],"Initial authentication and admission; server generation enabled.",{"_3150":1009,"_27660":982,"_19192":48116,"_5":13195,"_26170":48040,"_2648":48117},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3150":1010,"_27660":982,"_19192":48119,"_5":13195,"_26170":48044,"_2648":48120},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3150":1011,"_27660":982,"_19192":48122,"_5":13195,"_26170":48044,"_2648":48123},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3150":1012,"_27660":982,"_19192":48125,"_5":13195,"_26170":48047,"_2648":48126},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3150":1013,"_27660":982,"_19192":48128,"_5":13195,"_26170":48047,"_2648":48129},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3150":1014,"_27660":982,"_19192":48131,"_5":13195,"_26170":48050,"_2648":48132},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3150":1015,"_27660":982,"_19192":48134,"_5":13195,"_26170":48050,"_2648":48135},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3150":1016,"_27660":982,"_19192":48137,"_5":13195,"_26170":48053,"_2648":48138},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3150":1017,"_27660":982,"_19192":48140,"_5":13195,"_26170":48053,"_2648":48141},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3150":1018,"_27660":982,"_19192":48143,"_5":13195,"_26170":48056,"_2648":48144},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3150":1019,"_27660":982,"_19192":48146,"_5":13195,"_26170":48056,"_2648":48147},[],"Part",{"_3150":1020,"_27660":982,"_19192":48149,"_5":13195,"_26170":48056,"_2648":48150},[],"Content after decoding its Base64",{"_3150":1021,"_27660":982,"_19192":48152,"_5":13195,"_26170":48056,"_2648":48153},[],"`application/pkcs8`",{"_3150":1022,"_27660":982,"_19192":48155,"_5":13195,"_26170":48056,"_2648":48156},[],"Unencrypted DER PKCS#8 private key.",{"_3150":1023,"_27660":982,"_19192":48158,"_5":13195,"_26170":48056,"_2648":48159},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3150":1024,"_27660":982,"_19192":48161,"_5":13195,"_26170":48056,"_2648":48162},[],"DER PKCS#7 containing the issued certificate.",{"_3150":1025,"_27660":982,"_19192":48164,"_5":13195,"_26170":48056,"_2648":48165},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3150":1026,"_27660":982,"_19192":48167,"_5":13195,"_26170":48060,"_2648":48168},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3150":1027,"_27660":982,"_19192":48170,"_5":13195,"_26170":48060,"_2648":48171},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3150":1028,"_27660":982,"_19192":48173,"_5":13195,"_26170":48060,"_2648":48174},[],"Convert and check the result:",{"_3150":1029,"_27660":982,"_19192":48176,"_5":13195,"_26170":48060,"_2648":48177},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3150":1030,"_27660":982,"_19192":48179,"_5":13195,"_26170":48064,"_2648":48180},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3150":1031,"_27660":982,"_19192":48182,"_5":13195,"_26170":48064,"_2648":48183},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3150":1032,"_27660":1032,"_5":13521,"_2648":47508,"_28003":48185,"_19192":48186,"_26170":1032},[44970,46350,47327,47325,47508],[],{"_3150":1033,"_27660":1032,"_19192":48188,"_5":13195,"_26170":1032,"_2648":48189},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3150":1034,"_27660":1032,"_5":28000,"_19192":48191,"_26170":48192,"_2648":48193},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3150":1035,"_27660":1032,"_5":28000,"_19192":48195,"_26170":48196,"_2648":48197},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3150":1036,"_27660":1032,"_5":28000,"_19192":48199,"_26170":48200,"_2648":48201},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3150":1037,"_27660":1032,"_5":28000,"_19192":48203,"_26170":48204,"_2648":48205},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3150":1038,"_27660":1032,"_19192":48207,"_5":13195,"_26170":1032,"_2648":48208},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3150":1039,"_27660":1032,"_19192":48210,"_5":13195,"_26170":48192,"_2648":48211},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3150":1040,"_27660":1032,"_19192":48213,"_5":13195,"_26170":48192,"_2648":48214},[],"The integrator installs initial EST server trust and an admission credential.",{"_3150":1041,"_27660":1032,"_19192":48216,"_5":13195,"_26170":48192,"_2648":48217},[],"The client requests an identity for its `Device ID` through EST.",{"_3150":1042,"_27660":1032,"_19192":48219,"_5":13195,"_26170":48192,"_2648":48220},[],"Certificate, device binding and key/certificate installation are checked.",{"_3150":1043,"_27660":1032,"_19192":48222,"_5":13195,"_26170":48192,"_2648":48223},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3150":1044,"_27660":1032,"_19192":48225,"_5":13195,"_26170":48192,"_2648":48226},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3150":1045,"_27660":1032,"_19192":48228,"_5":13195,"_26170":48196,"_2648":48229},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3150":1046,"_27660":1032,"_19192":48231,"_5":13195,"_26170":48196,"_2648":48232},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":1047,"_27660":1032,"_19192":48234,"_5":13195,"_26170":48196,"_2648":48235},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3150":1048,"_27660":1032,"_19192":48237,"_5":13195,"_26170":48196,"_2648":48238},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3150":1049,"_27660":1032,"_19192":48240,"_5":13195,"_26170":48200,"_2648":48241},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":1050,"_27660":1032,"_19192":48243,"_5":13195,"_26170":48200,"_2648":48244},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":1051,"_27660":1032,"_19192":48246,"_5":13195,"_26170":48200,"_2648":48247},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3150":1052,"_27660":1032,"_19192":48249,"_5":13195,"_26170":48200,"_2648":48250},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3150":1053,"_27660":1032,"_19192":48252,"_5":13195,"_26170":48204,"_2648":48253},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3150":1054,"_27660":1032,"_19192":48255,"_5":13195,"_26170":48204,"_2648":48256},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3150":1055,"_27660":1055,"_5":13521,"_2648":48258,"_28003":48259,"_19192":48260,"_26170":1055},"Provisioning strategies",[44970,46350,47327,47325,47508],[],{"_3150":1056,"_27660":1055,"_19192":48262,"_5":13195,"_26170":1055,"_2648":48263},[],"Choose device registration, identity authorization and key generation.",{"_3150":1057,"_27660":1055,"_5":28000,"_19192":48265,"_26170":48266,"_2648":48267},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3150":1058,"_27660":1055,"_5":28000,"_19192":48269,"_26170":48270,"_2648":48271},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3150":1059,"_27660":1055,"_5":28000,"_19192":48273,"_26170":48274,"_2648":48275},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3150":1060,"_27660":1055,"_5":28000,"_19192":48277,"_26170":48278,"_2648":48279},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3150":1061,"_27660":1055,"_5":28000,"_19192":48281,"_26170":48282,"_2648":48283},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3150":1062,"_27660":1055,"_19192":48285,"_5":13195,"_26170":1055,"_2648":48286},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3150":1063,"_27660":1055,"_19192":48288,"_5":13195,"_26170":48266,"_2648":48289},[],"Path",{"_3150":1064,"_27660":1055,"_19192":48291,"_5":13195,"_26170":48266,"_2648":48292},[],"When the device exists",{"_3150":1065,"_27660":1055,"_19192":48294,"_5":13195,"_26170":48266,"_2648":48295},[],"What to check",{"_3150":1066,"_27660":1055,"_19192":48297,"_5":13195,"_26170":48266,"_2648":48298},[],"Manual assignment",{"_3150":1067,"_27660":1055,"_19192":48300,"_5":13195,"_26170":48266,"_2648":48301},[],"An operator creates it before associating a certificate.",{"_3150":1068,"_27660":1055,"_19192":48303,"_5":13195,"_26170":48266,"_2648":48304},[],"ID, owning DMS, certificate CN and bound serial.",{"_3150":1069,"_27660":1055,"_19192":48306,"_5":13195,"_26170":48266,"_2648":48307},[],"EST with `JITP`",{"_3150":1070,"_27660":1055,"_19192":48309,"_5":13195,"_26170":48266,"_2648":48310},[],"Created for an unknown CN during `/simpleenroll`.",{"_3150":1071,"_27660":1055,"_19192":48312,"_5":13195,"_26170":48266,"_2648":48313},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3150":1072,"_27660":1055,"_19192":48315,"_5":13195,"_26170":48266,"_2648":48316},[],"EST with `PRE_REGISTRATION`",{"_3150":1073,"_27660":1055,"_19192":48318,"_5":13195,"_26170":48266,"_2648":48319},[],"Must exist before `/simpleenroll`.",{"_3150":1074,"_27660":1055,"_19192":48321,"_5":13195,"_26170":48266,"_2648":48322},[],"Approved record, same DMS and replacement conditions for your version.",{"_3150":1075,"_27660":1055,"_19192":48324,"_5":13195,"_26170":48266,"_2648":48325},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3150":1076,"_27660":1055,"_19192":48327,"_5":13195,"_26170":48266,"_2648":48328},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3150":1077,"_27660":1055,"_19192":48330,"_5":13195,"_26170":48270,"_2648":48331},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3150":1078,"_27660":1055,"_19192":48333,"_5":13195,"_26170":48270,"_2648":48334},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3150":1079,"_27660":1055,"_19192":48336,"_5":13195,"_26170":48270,"_2648":48337},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3150":1080,"_27660":1055,"_19192":48339,"_5":13195,"_26170":48274,"_2648":48340},[],"Decide initial enrollment and re-enrollment separately:",{"_3150":1081,"_27660":1055,"_19192":48342,"_5":13195,"_26170":48274,"_2648":48343},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3150":1082,"_27660":1055,"_19192":48345,"_5":13195,"_26170":48274,"_2648":48346},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3150":1083,"_27660":1055,"_19192":48348,"_5":13195,"_26170":48274,"_2648":48349},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3150":1084,"_27660":1055,"_19192":48351,"_5":13195,"_26170":48274,"_2648":48352},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3150":1085,"_27660":1055,"_19192":48354,"_5":13195,"_26170":48274,"_2648":48355},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3150":1086,"_27660":1055,"_19192":48357,"_5":13195,"_26170":48278,"_2648":45354},[],{"_3150":1087,"_27660":1055,"_19192":48359,"_5":13195,"_26170":48278,"_2648":48360},[],"Material crossing EST",{"_3150":1088,"_27660":1055,"_19192":48362,"_5":13195,"_26170":48278,"_2648":48363},[],"Device-generated key",{"_3150":1089,"_27660":1055,"_19192":48365,"_5":13195,"_26170":48278,"_2648":48366},[],"Public CSR and certificate; the key stays on the client.",{"_3150":1090,"_27660":1055,"_19192":48368,"_5":13195,"_26170":48278,"_2648":48369},[],"Existing device key",{"_3150":1091,"_27660":1055,"_19192":48371,"_5":13195,"_26170":48278,"_2648":48372},[],"CSR signed with that key and a new certificate.",{"_3150":1092,"_27660":1055,"_19192":48374,"_5":13195,"_26170":48278,"_2648":47646},[],{"_3150":1093,"_27660":1055,"_19192":48376,"_5":13195,"_26170":48278,"_2648":48377},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3150":1094,"_27660":1055,"_19192":48379,"_5":13195,"_26170":48278,"_2648":48380},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3150":1095,"_27660":1055,"_19192":48382,"_5":13195,"_26170":48282,"_2648":48383},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3150":1096,"_27660":1096,"_5":13521,"_2648":48385,"_28003":48386,"_19192":48387,"_26170":1096},"Renewal and recovery",[44970,46350,47327,47325,47508],[],{"_3150":1097,"_27660":1096,"_19192":48389,"_5":13195,"_26170":1096,"_2648":48390},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3150":1098,"_27660":1096,"_5":28000,"_19192":48392,"_26170":48393,"_2648":48394},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3150":1099,"_27660":1096,"_5":28000,"_19192":48396,"_26170":48397,"_2648":48398},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3150":1100,"_27660":1096,"_5":28000,"_19192":48400,"_26170":48401,"_2648":48402},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3150":1101,"_27660":1096,"_5":28000,"_19192":48404,"_26170":48405,"_2648":48406},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3150":1102,"_27660":1096,"_5":28000,"_19192":48408,"_26170":48409,"_2648":48410},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3150":1103,"_27660":1096,"_19192":48412,"_5":13195,"_26170":1096,"_2648":48413},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3150":1104,"_27660":1096,"_19192":48415,"_5":13195,"_26170":48393,"_2648":48416},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3150":1105,"_27660":1096,"_19192":48418,"_5":13195,"_26170":48393,"_2648":48419},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3150":1106,"_27660":1096,"_19192":48421,"_5":13195,"_26170":48393,"_2648":48422},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3150":1107,"_27660":1096,"_19192":48424,"_5":13195,"_26170":48393,"_2648":48425},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3150":1108,"_27660":1096,"_19192":48427,"_5":13195,"_26170":48397,"_2648":48428},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3150":1109,"_27660":1096,"_19192":48430,"_5":13195,"_26170":48397,"_2648":48431},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3150":1110,"_27660":1096,"_19192":48433,"_5":13195,"_26170":48401,"_2648":48434},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3150":1111,"_27660":1096,"_19192":48436,"_5":13195,"_26170":48401,"_2648":48437},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3150":1112,"_27660":1096,"_19192":48439,"_5":13195,"_26170":48401,"_2648":48440},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3150":1113,"_27660":1096,"_19192":48442,"_5":13195,"_26170":48405,"_2648":48443},[],"Situation",{"_3150":1114,"_27660":1096,"_19192":48445,"_5":13195,"_26170":48405,"_2648":48446},[],"Procedure",{"_3150":1115,"_27660":1096,"_19192":48448,"_5":13195,"_26170":48405,"_2648":48449},[],"Valid certificate, outside the window",{"_3150":1116,"_27660":1096,"_19192":48451,"_5":13195,"_26170":48405,"_2648":48452},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3150":1117,"_27660":1096,"_19192":48454,"_5":13195,"_26170":48405,"_2648":48455},[],"Expired certificate, key available",{"_3150":1118,"_27660":1096,"_19192":48457,"_5":13195,"_26170":48405,"_2648":48458},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3150":1119,"_27660":1096,"_19192":48460,"_5":13195,"_26170":48405,"_2648":48461},[],"Renewal through webhook or `NO_AUTH`",{"_3150":1120,"_27660":1096,"_19192":48463,"_5":13195,"_26170":48405,"_2648":48464},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3150":1121,"_27660":1096,"_19192":48466,"_5":13195,"_26170":48405,"_2648":48467},[],"Lost or inaccessible key",{"_3150":1122,"_27660":1096,"_19192":48469,"_5":13195,"_26170":48405,"_2648":48470},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3150":1123,"_27660":1096,"_19192":48472,"_5":13195,"_26170":48405,"_2648":48473},[],"Current identity revoked",{"_3150":1124,"_27660":1096,"_19192":48475,"_5":13195,"_26170":48405,"_2648":48476},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3150":1125,"_27660":1096,"_19192":48478,"_5":13195,"_26170":48405,"_2648":48479},[],"Device without an identity",{"_3150":1126,"_27660":1096,"_19192":48481,"_5":13195,"_26170":48405,"_2648":48482},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3150":1127,"_27660":1096,"_19192":48484,"_5":13195,"_26170":48405,"_2648":48485},[],"Retired device",{"_3150":1128,"_27660":1096,"_19192":48487,"_5":13195,"_26170":48405,"_2648":48488},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3150":1129,"_27660":1096,"_19192":48490,"_5":13195,"_26170":48405,"_2648":48491},[],"Timeout, HTTP 500 or installation failure",{"_3150":1130,"_27660":1096,"_19192":48493,"_5":13195,"_26170":48405,"_2648":48494},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3150":1131,"_27660":1096,"_19192":48496,"_5":13195,"_26170":48409,"_2648":48497},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3150":1132,"_27660":1096,"_19192":48499,"_5":13195,"_26170":48409,"_2648":48500},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3150":1133,"_27660":1133,"_5":13521,"_2648":48502,"_28003":48503,"_19192":48504,"_26170":1133},"Enrollment troubleshooting",[44970,46350,47327,47325,47508],[],{"_3150":1134,"_27660":1133,"_19192":48506,"_5":13195,"_26170":1133,"_2648":48507},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3150":1135,"_27660":1133,"_5":28000,"_19192":48509,"_26170":48510,"_2648":48511},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3150":1136,"_27660":1133,"_5":28000,"_19192":48513,"_26170":48514,"_2648":48515},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3150":1137,"_27660":1133,"_5":28000,"_19192":48517,"_26170":48518,"_2648":48065},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3150":1138,"_27660":1133,"_5":28000,"_19192":48520,"_26170":48521,"_2648":48522},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3150":1139,"_27660":1133,"_19192":48524,"_5":13195,"_26170":1133,"_2648":48525},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3150":1140,"_27660":1133,"_19192":48527,"_5":13195,"_26170":48514,"_2648":48528},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3150":1141,"_27660":1133,"_19192":48530,"_5":13195,"_26170":48514,"_2648":48531},[],"Symptom or message",{"_3150":1142,"_27660":1133,"_19192":48533,"_5":13195,"_26170":48514,"_2648":48295},[],{"_3150":1143,"_27660":1133,"_19192":48535,"_5":13195,"_26170":48514,"_2648":48536},[],"curl rejects TLS, name or issuer",{"_3150":1144,"_27660":1133,"_19192":48538,"_5":13195,"_26170":48514,"_2648":48539},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3150":1145,"_27660":1133,"_19192":48541,"_5":13195,"_26170":48514,"_2648":48542},[],"404 or missing APS",{"_3150":1146,"_27660":1133,"_19192":48544,"_5":13195,"_26170":48514,"_2648":48545},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3150":1147,"_27660":1133,"_19192":48547,"_5":13195,"_26170":48514,"_2648":48548},[],"400, CSR or format error",{"_3150":1148,"_27660":1133,"_19192":48550,"_5":13195,"_26170":48514,"_2648":48551},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3150":1149,"_27660":1133,"_19192":48553,"_5":13195,"_26170":48514,"_2648":48554},[],"Missing credential or invalid certificate",{"_3150":1150,"_27660":1133,"_19192":48556,"_5":13195,"_26170":48514,"_2648":48557},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3150":1151,"_27660":1133,"_19192":48559,"_5":13195,"_26170":48514,"_2648":48560},[],"Webhook denies, times out or responds without authorization",{"_3150":1152,"_27660":1133,"_19192":48562,"_5":13195,"_26170":48514,"_2648":48563},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3150":1153,"_27660":1133,"_19192":48565,"_5":13195,"_26170":48514,"_2648":48566},[],"`unexpected status code: <n>: redirects are not followed`",{"_3150":1154,"_27660":1133,"_19192":48568,"_5":13195,"_26170":48514,"_2648":48569},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3150":1155,"_27660":1133,"_19192":48571,"_5":13195,"_26170":48514,"_2648":48572},[],"`webhook response exceeds 1048576 bytes`",{"_3150":1156,"_27660":1133,"_19192":48574,"_5":13195,"_26170":48514,"_2648":48575},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3150":1157,"_27660":1133,"_19192":48577,"_5":13195,"_26170":48514,"_2648":48578},[],"`webhook config must not reference files`",{"_3150":1158,"_27660":1133,"_19192":48580,"_5":13195,"_26170":48514,"_2648":48581},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3150":1159,"_27660":1133,"_19192":48583,"_5":13195,"_26170":48514,"_2648":48584},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3150":1160,"_27660":1133,"_19192":48586,"_5":13195,"_26170":48514,"_2648":48587},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3150":1161,"_27660":1133,"_19192":48589,"_5":13195,"_26170":48514,"_2648":48590},[],"`webhook mTLS certificate and key are invalid: …`",{"_3150":1162,"_27660":1133,"_19192":48592,"_5":13195,"_26170":48514,"_2648":48593},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3150":1163,"_27660":1133,"_19192":48595,"_5":13195,"_26170":48514,"_2648":48596},[],"400 `struct validation error` creating or updating a DMS",{"_3150":1164,"_27660":1133,"_19192":48598,"_5":13195,"_26170":48514,"_2648":48599},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3150":1165,"_27660":1133,"_19192":48601,"_5":13195,"_26170":48514,"_2648":48602},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3150":1166,"_27660":1133,"_19192":48604,"_5":13195,"_26170":48514,"_2648":48605},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3150":1167,"_27660":1133,"_19192":48607,"_5":13195,"_26170":48514,"_2648":48608},[],"`device not preregistered`",{"_3150":1168,"_27660":1133,"_19192":48610,"_5":13195,"_26170":48514,"_2648":48611},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3150":1169,"_27660":1133,"_19192":48613,"_5":13195,"_26170":48514,"_2648":48614},[],"`forbiddenNewEnrollment`",{"_3150":1170,"_27660":1133,"_19192":48616,"_5":13195,"_26170":48514,"_2648":48617},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3150":1171,"_27660":1133,"_19192":48619,"_5":13195,"_26170":48514,"_2648":48620},[],"Different owning DMS",{"_3150":1172,"_27660":1133,"_19192":48622,"_5":13195,"_26170":48514,"_2648":48623},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3150":1173,"_27660":1133,"_19192":48625,"_5":13195,"_26170":48514,"_2648":48626},[],"`invalid RawSubject bytes`",{"_3150":1174,"_27660":1133,"_19192":48628,"_5":13195,"_26170":48514,"_2648":48629},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3150":1175,"_27660":1133,"_19192":48631,"_5":13195,"_26170":48514,"_2648":48632},[],"`invalid reenroll window`",{"_3150":1176,"_27660":1133,"_19192":48634,"_5":13195,"_26170":48514,"_2648":48635},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3150":1177,"_27660":1133,"_19192":48637,"_5":13195,"_26170":48514,"_2648":48638},[],"Current certificate revoked",{"_3150":1178,"_27660":1133,"_19192":48640,"_5":13195,"_26170":48514,"_2648":48641},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3150":1179,"_27660":1133,"_19192":48643,"_5":13195,"_26170":48514,"_2648":48644},[],"CA, profile or signing error",{"_3150":1180,"_27660":1133,"_19192":48646,"_5":13195,"_26170":48514,"_2648":48647},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3150":1181,"_27660":1133,"_19192":48649,"_5":13195,"_26170":48514,"_2648":48650},[],"HTTP 200 without a device connection",{"_3150":1182,"_27660":1133,"_19192":48652,"_5":13195,"_26170":48514,"_2648":48653},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3150":1183,"_27660":1133,"_19192":48655,"_5":13195,"_26170":48514,"_2648":48656},[],"Timeout or error after issuance",{"_3150":1184,"_27660":1133,"_19192":48658,"_5":13195,"_26170":48514,"_2648":48659},[],"New certificates, current slot and previous identity's state before retrying.",{"_3150":1185,"_27660":1133,"_19192":48661,"_5":13195,"_26170":48518,"_2648":48662},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3150":1186,"_27660":1133,"_19192":48664,"_5":13195,"_26170":48518,"_2648":48665},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3150":1187,"_27660":1133,"_19192":48667,"_5":13195,"_26170":48521,"_2648":48668},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3150":1188,"_27660":1133,"_19192":48670,"_5":13195,"_26170":48521,"_2648":48671},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3150":1189,"_27660":1133,"_19192":48673,"_5":13195,"_26170":48521,"_2648":48674},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3150":1190,"_27660":1133,"_19192":48676,"_5":13195,"_26170":48521,"_2648":48677},[],"Make one request, save headers/body and query the device and certificates.",{"_3150":1191,"_27660":1133,"_19192":48679,"_5":13195,"_26170":48521,"_2648":48680},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3150":1192,"_27660":1133,"_19192":48682,"_5":13195,"_26170":48521,"_2648":48683},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3150":1193,"_27660":1133,"_19192":48685,"_5":13195,"_26170":48521,"_2648":48686},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3150":1194,"_27660":1194,"_5":13521,"_2648":48688,"_28003":48689,"_19192":48690,"_26170":1194},"Trust distribution and updates",[44970,46350,47327,47325,47508],[],{"_3150":1195,"_27660":1194,"_19192":48692,"_5":13195,"_26170":1194,"_2648":48693},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3150":1196,"_27660":1194,"_5":28000,"_19192":48695,"_26170":48696,"_2648":48697},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3150":1197,"_27660":1194,"_5":28000,"_19192":48699,"_26170":48700,"_2648":48701},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3150":1198,"_27660":1194,"_5":28000,"_19192":48703,"_26170":48704,"_2648":48705},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3150":1199,"_27660":1194,"_5":28000,"_19192":48707,"_26170":48708,"_2648":48709},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3150":1200,"_27660":1194,"_5":28000,"_19192":48711,"_26170":48712,"_2648":48713},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3150":1201,"_27660":1194,"_19192":48715,"_5":13195,"_26170":1194,"_2648":48716},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3150":1202,"_27660":1194,"_19192":48718,"_5":13195,"_26170":48696,"_2648":48719},[],"Relationship",{"_3150":1203,"_27660":1194,"_19192":48721,"_5":13195,"_26170":48696,"_2648":48722},[],"Material prepared by its owner",{"_3150":1204,"_27660":1194,"_19192":48724,"_5":13195,"_26170":48696,"_2648":48725},[],"Device → EST server",{"_3150":1205,"_27660":1194,"_19192":48727,"_5":13195,"_26170":48696,"_2648":48728},[],"Previously verified server root, chain or pin and TLS name.",{"_3150":1206,"_27660":1194,"_19192":48730,"_5":13195,"_26170":48696,"_2648":48731},[],"DMS → requester",{"_3150":1207,"_27660":1194,"_19192":48733,"_5":13195,"_26170":48696,"_2648":48734},[],"CAs and rules authorizing initial or renewal credentials.",{"_3150":1208,"_27660":1194,"_19192":48736,"_5":13195,"_26170":48696,"_2648":48737},[],"Consumer → device",{"_3150":1209,"_27660":1194,"_19192":48739,"_5":13195,"_26170":48696,"_2648":48740},[],"Operational identity roots, intermediates, validation and permissions.",{"_3150":1210,"_27660":1194,"_19192":48742,"_5":13195,"_26170":48696,"_2648":48743},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3150":1211,"_27660":1194,"_19192":48745,"_5":13195,"_26170":48700,"_2648":48746},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3150":1212,"_27660":1194,"_19192":48748,"_5":13195,"_26170":48700,"_2648":48749},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3150":1213,"_27660":1194,"_19192":48751,"_5":13195,"_26170":48704,"_2648":48752},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3150":1214,"_27660":1194,"_19192":48754,"_5":13195,"_26170":48704,"_2648":48755},[],"Select policy-approved roots as anchors.",{"_3150":1215,"_27660":1194,"_19192":48757,"_5":13195,"_26170":48704,"_2648":48758},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3150":1216,"_27660":1194,"_19192":48760,"_5":13195,"_26170":48704,"_2648":48761},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3150":1217,"_27660":1194,"_19192":48763,"_5":13195,"_26170":48704,"_2648":48764},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3150":1218,"_27660":1194,"_19192":48766,"_5":13195,"_26170":48704,"_2648":48767},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3150":1219,"_27660":1194,"_19192":48769,"_5":13195,"_26170":48708,"_2648":48770},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3150":1220,"_27660":1194,"_19192":48772,"_5":13195,"_26170":48708,"_2648":48773},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3150":1221,"_27660":1194,"_19192":48775,"_5":13195,"_26170":48708,"_2648":48776},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3150":1222,"_27660":1194,"_19192":48778,"_5":13195,"_26170":48712,"_2648":48779},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3150":1223,"_27660":1223,"_5":13521,"_2648":48781,"_28003":48782,"_19192":48784,"_26170":1223},"AWS IoT Core",[44970,46350,47327,47325,48783],"Integrations",[],{"_3150":1224,"_27660":1223,"_19192":48786,"_5":13195,"_26170":1223,"_2648":48787},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3150":1225,"_27660":1223,"_5":28000,"_19192":48789,"_26170":48790,"_2648":48791},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3150":1226,"_27660":1223,"_5":28000,"_19192":48793,"_26170":48794,"_2648":48795},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3150":1227,"_27660":1223,"_5":28000,"_19192":48797,"_26170":48798,"_2648":48799},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3150":1228,"_27660":1223,"_5":28000,"_19192":48801,"_26170":48802,"_2648":48803},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3150":1229,"_27660":1223,"_5":28000,"_19192":48805,"_26170":48806,"_2648":48807},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3150":1230,"_27660":1223,"_5":28000,"_19192":48809,"_26170":48810,"_2648":48811},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3150":1231,"_27660":1223,"_5":28000,"_19192":48813,"_26170":48814,"_2648":48815},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3150":1232,"_27660":1223,"_5":28000,"_19192":48817,"_26170":48818,"_2648":48819},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3150":1233,"_27660":1223,"_5":28000,"_19192":48821,"_26170":48822,"_2648":48823},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3150":1234,"_27660":1223,"_5":28000,"_19192":48825,"_26170":48826,"_2648":48827},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3150":1235,"_27660":1223,"_5":28000,"_19192":48829,"_26170":48830,"_2648":48831},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3150":1236,"_27660":1223,"_5":28000,"_19192":48833,"_26170":48834,"_2648":48835},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3150":1237,"_27660":1223,"_5":28000,"_19192":48837,"_26170":48838,"_2648":48839},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3150":1238,"_27660":1223,"_5":28000,"_19192":48841,"_26170":48842,"_2648":48843},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3150":1239,"_27660":1223,"_5":28000,"_19192":48845,"_26170":48846,"_2648":48847},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3150":1240,"_27660":1223,"_5":28000,"_19192":48849,"_26170":48850,"_2648":48851},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3150":1241,"_27660":1223,"_5":28000,"_19192":48853,"_26170":48854,"_2648":48855},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3150":1242,"_27660":1223,"_5":28000,"_19192":48857,"_26170":48858,"_2648":48859},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3150":1243,"_27660":1223,"_5":28000,"_19192":48861,"_26170":48862,"_2648":48863},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3150":1244,"_27660":1223,"_5":28000,"_19192":48865,"_26170":48866,"_2648":48867},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3150":1245,"_27660":1223,"_19192":48869,"_5":13195,"_26170":1223,"_2648":48870},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3150":1246,"_27660":1223,"_19192":48872,"_5":13195,"_26170":1223,"_2648":48873},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3150":1247,"_27660":1223,"_19192":48875,"_5":13195,"_26170":1223,"_2648":48876},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3150":1248,"_27660":1223,"_19192":48878,"_5":13195,"_26170":48790,"_2648":48879},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3150":1249,"_27660":1223,"_19192":48881,"_5":13195,"_26170":48790,"_2648":48882},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3150":1250,"_27660":1223,"_19192":48884,"_5":13195,"_26170":48790,"_2648":48885},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3150":1251,"_27660":1223,"_19192":48887,"_5":13195,"_26170":48790,"_2648":48888},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3150":1252,"_27660":1223,"_19192":48890,"_5":13195,"_26170":48794,"_2648":48891},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3150":1253,"_27660":1223,"_19192":48893,"_5":13195,"_26170":48798,"_2648":48894},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3150":1254,"_27660":1223,"_19192":48896,"_5":13195,"_26170":48798,"_2648":48897},[],"IAM action",{"_3150":1255,"_27660":1223,"_19192":48899,"_5":13195,"_26170":48798,"_2648":45360},[],{"_3150":1256,"_27660":1223,"_19192":48901,"_5":13195,"_26170":48798,"_2648":48902},[],"`iot:GetRegistrationCode`",{"_3150":1257,"_27660":1223,"_19192":48904,"_5":13195,"_26170":48798,"_2648":48905},[],"Obtain the verification code for CA registration in the Primary Account",{"_3150":1258,"_27660":1223,"_19192":48907,"_5":13195,"_26170":48798,"_2648":48908},[],"`iot:RegisterCACertificate`",{"_3150":1259,"_27660":1223,"_19192":48910,"_5":13195,"_26170":48798,"_2648":48911},[],"Register the CA in AWS IoT",{"_3150":1260,"_27660":1223,"_19192":48913,"_5":13195,"_26170":48798,"_2648":48914},[],"`iot:DescribeCACertificate`",{"_3150":1261,"_27660":1223,"_19192":48916,"_5":13195,"_26170":48798,"_2648":48917},[],"Check the CA registration status",{"_3150":1262,"_27660":1223,"_19192":48919,"_5":13195,"_26170":48798,"_2648":48920},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3150":1263,"_27660":1223,"_19192":48922,"_5":13195,"_26170":48798,"_2648":48923},[],"Create or update Things in IoT Core",{"_3150":1264,"_27660":1223,"_19192":48925,"_5":13195,"_26170":48798,"_2648":48926},[],"`iot:RegisterThing`",{"_3150":1265,"_27660":1223,"_19192":48928,"_5":13195,"_26170":48798,"_2648":48929},[],"Provision Things through a template",{"_3150":1266,"_27660":1223,"_19192":48931,"_5":13195,"_26170":48798,"_2648":48932},[],"`iot:RegisterCertificate`",{"_3150":1267,"_27660":1223,"_19192":48934,"_5":13195,"_26170":48798,"_2648":48935},[],"Register device certificates",{"_3150":1268,"_27660":1223,"_19192":48937,"_5":13195,"_26170":48798,"_2648":48938},[],"`iot:UpdateCertificate`",{"_3150":1269,"_27660":1223,"_19192":48940,"_5":13195,"_26170":48798,"_2648":48941},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3150":1270,"_27660":1223,"_19192":48943,"_5":13195,"_26170":48798,"_2648":48944},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3150":1271,"_27660":1223,"_19192":48946,"_5":13195,"_26170":48798,"_2648":48947},[],"Create and attach IoT policies",{"_3150":1272,"_27660":1223,"_19192":48949,"_5":13195,"_26170":48798,"_2648":48950},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3150":1273,"_27660":1223,"_19192":48952,"_5":13195,"_26170":48798,"_2648":48953},[],"Manage Thing groups",{"_3150":1274,"_27660":1223,"_19192":48955,"_5":13195,"_26170":48798,"_2648":48956},[],"`iot:CreateProvisioningTemplate`",{"_3150":1275,"_27660":1223,"_19192":48958,"_5":13195,"_26170":48798,"_2648":48959},[],"Create JITP templates",{"_3150":1276,"_27660":1223,"_19192":48961,"_5":13195,"_26170":48798,"_2648":48962},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3150":1277,"_27660":1223,"_19192":48964,"_5":13195,"_26170":48798,"_2648":48965},[],"Read and write the Device Shadow",{"_3150":1278,"_27660":1223,"_19192":48967,"_5":13195,"_26170":48798,"_2648":48968},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3150":1279,"_27660":1223,"_19192":48970,"_5":13195,"_26170":48802,"_2648":48971},[],"Parameter",{"_3150":1280,"_27660":1223,"_19192":48973,"_5":13195,"_26170":48802,"_2648":48974},[],"Type",{"_3150":1281,"_27660":1223,"_19192":48976,"_5":13195,"_26170":48802,"_2648":48977},[],"Required",{"_3150":1282,"_27660":1223,"_19192":48979,"_5":13195,"_26170":48802,"_2648":48980},[],"Description",{"_3150":1283,"_27660":1223,"_19192":48982,"_5":13195,"_26170":48802,"_2648":48983},[],"`connector_id`",{"_3150":1284,"_27660":1223,"_19192":48985,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1285,"_27660":1223,"_19192":48987,"_5":13195,"_26170":48802,"_2648":48988},[],"Yes",{"_3150":1286,"_27660":1223,"_19192":48990,"_5":13195,"_26170":48802,"_2648":48991},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3150":1287,"_27660":1223,"_19192":48993,"_5":13195,"_26170":48802,"_2648":48994},[],"`aws_config.region`",{"_3150":1288,"_27660":1223,"_19192":48996,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1289,"_27660":1223,"_19192":48998,"_5":13195,"_26170":48802,"_2648":48988},[],{"_3150":1290,"_27660":1223,"_19192":49000,"_5":13195,"_26170":48802,"_2648":49001},[],"AWS region where the connector operates.",{"_3150":1291,"_27660":1223,"_19192":49003,"_5":13195,"_26170":48802,"_2648":49004},[],"`aws_config.auth_method`",{"_3150":1292,"_27660":1223,"_19192":49006,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1293,"_27660":1223,"_19192":49008,"_5":13195,"_26170":48802,"_2648":48988},[],{"_3150":1294,"_27660":1223,"_19192":49010,"_5":13195,"_26170":48802,"_2648":49011},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3150":1295,"_27660":1223,"_19192":49013,"_5":13195,"_26170":48802,"_2648":49014},[],"`aws_config.access_key_id`",{"_3150":1296,"_27660":1223,"_19192":49016,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1297,"_27660":1223,"_19192":49018,"_5":13195,"_26170":48802,"_2648":49019},[],"Only with `auth_method=static`",{"_3150":1298,"_27660":1223,"_19192":49021,"_5":13195,"_26170":48802,"_2648":49022},[],"AWS access key.",{"_3150":1299,"_27660":1223,"_19192":49024,"_5":13195,"_26170":48802,"_2648":49025},[],"`aws_config.secret_access_key`",{"_3150":1300,"_27660":1223,"_19192":49027,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1301,"_27660":1223,"_19192":49029,"_5":13195,"_26170":48802,"_2648":49019},[],{"_3150":1302,"_27660":1223,"_19192":49031,"_5":13195,"_26170":48802,"_2648":49032},[],"AWS secret key.",{"_3150":1303,"_27660":1223,"_19192":49034,"_5":13195,"_26170":48802,"_2648":49035},[],"`aws_config.session_token`",{"_3150":1304,"_27660":1223,"_19192":49037,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1305,"_27660":1223,"_19192":49039,"_5":13195,"_26170":48802,"_2648":49040},[],"No",{"_3150":1306,"_27660":1223,"_19192":49042,"_5":13195,"_26170":48802,"_2648":49043},[],"Session token (with `auth_method=static`).",{"_3150":1307,"_27660":1223,"_19192":49045,"_5":13195,"_26170":48802,"_2648":49046},[],"`aws_config.role_arn`",{"_3150":1308,"_27660":1223,"_19192":49048,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1309,"_27660":1223,"_19192":49050,"_5":13195,"_26170":48802,"_2648":49051},[],"Only with `auth_method=role`",{"_3150":1310,"_27660":1223,"_19192":49053,"_5":13195,"_26170":48802,"_2648":49054},[],"ARN of the role to assume.",{"_3150":1311,"_27660":1223,"_19192":49056,"_5":13195,"_26170":48802,"_2648":49057},[],"`aws_config.endpoint_url`",{"_3150":1312,"_27660":1223,"_19192":49059,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1313,"_27660":1223,"_19192":49061,"_5":13195,"_26170":48802,"_2648":49040},[],{"_3150":1314,"_27660":1223,"_19192":49063,"_5":13195,"_26170":48802,"_2648":49064},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3150":1315,"_27660":1223,"_19192":49066,"_5":13195,"_26170":48802,"_2648":49067},[],"`subscriber_event_bus`",{"_3150":1316,"_27660":1223,"_19192":49069,"_5":13195,"_26170":48802,"_2648":16174},[],{"_3150":1317,"_27660":1223,"_19192":49071,"_5":13195,"_26170":48802,"_2648":48988},[],{"_3150":1318,"_27660":1223,"_19192":49073,"_5":13195,"_26170":48802,"_2648":49074},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3150":1319,"_27660":1223,"_19192":49076,"_5":13195,"_26170":48802,"_2648":49077},[],"`dms_manager_client`",{"_3150":1320,"_27660":1223,"_19192":49079,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1321,"_27660":1223,"_19192":49081,"_5":13195,"_26170":48802,"_2648":48988},[],{"_3150":1322,"_27660":1223,"_19192":49083,"_5":13195,"_26170":48802,"_2648":49084},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3150":1323,"_27660":1223,"_19192":49086,"_5":13195,"_26170":48802,"_2648":49087},[],"`device_manager_client`",{"_3150":1324,"_27660":1223,"_19192":49089,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1325,"_27660":1223,"_19192":49091,"_5":13195,"_26170":48802,"_2648":48988},[],{"_3150":1326,"_27660":1223,"_19192":49093,"_5":13195,"_26170":48802,"_2648":49094},[],"HTTP URL of Lamassu's Device Manager.",{"_3150":1327,"_27660":1223,"_19192":49096,"_5":13195,"_26170":48802,"_2648":49097},[],"`ca_client`",{"_3150":1328,"_27660":1223,"_19192":49099,"_5":13195,"_26170":48802,"_2648":22952},[],{"_3150":1329,"_27660":1223,"_19192":49101,"_5":13195,"_26170":48802,"_2648":48988},[],{"_3150":1330,"_27660":1223,"_19192":49103,"_5":13195,"_26170":48802,"_2648":49104},[],"HTTP URL of Lamassu's CA service.",{"_3150":1331,"_27660":1223,"_19192":49106,"_5":13195,"_26170":48806,"_2648":49107},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3150":1332,"_27660":1223,"_19192":49109,"_5":13195,"_26170":48810,"_2648":49110},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3150":1333,"_27660":1223,"_19192":49112,"_5":13195,"_26170":48810,"_2648":49113},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3150":1334,"_27660":1223,"_19192":49115,"_5":13195,"_26170":48814,"_2648":49116},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3150":1335,"_27660":1223,"_19192":49118,"_5":13195,"_26170":48814,"_2648":49119},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3150":1336,"_27660":1223,"_19192":49121,"_5":13195,"_26170":48814,"_2648":49122},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3150":1337,"_27660":1223,"_19192":49124,"_5":13195,"_26170":48814,"_2648":49125},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3150":1338,"_27660":1223,"_19192":49127,"_5":13195,"_26170":48814,"_2648":49128},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3150":1339,"_27660":1223,"_19192":49130,"_5":13195,"_26170":48814,"_2648":49131},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3150":1340,"_27660":1223,"_19192":49133,"_5":13195,"_26170":48818,"_2648":49134},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3150":1341,"_27660":1223,"_19192":49136,"_5":13195,"_26170":48822,"_2648":49137},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3150":1342,"_27660":1223,"_19192":49139,"_5":13195,"_26170":48822,"_2648":49140},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3150":1343,"_27660":1223,"_19192":49142,"_5":13195,"_26170":48826,"_2648":49143},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3150":1344,"_27660":1223,"_19192":49145,"_5":13195,"_26170":48830,"_2648":49146},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3150":1345,"_27660":1223,"_19192":49148,"_5":13195,"_26170":48830,"_2648":49149},[],"Creates or updates the IoT policies configured in the DMS.",{"_3150":1346,"_27660":1223,"_19192":49151,"_5":13195,"_26170":48830,"_2648":49152},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3150":1347,"_27660":1223,"_19192":49154,"_5":13195,"_26170":48830,"_2648":49155},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3150":1348,"_27660":1223,"_19192":49157,"_5":13195,"_26170":48830,"_2648":49158},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3150":1349,"_27660":1223,"_19192":49160,"_5":13195,"_26170":48830,"_2648":49161},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3150":1350,"_27660":1223,"_19192":49163,"_5":13195,"_26170":48830,"_2648":49164},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3150":1351,"_27660":1223,"_19192":49166,"_5":13195,"_26170":48834,"_2648":49167},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3150":1352,"_27660":1223,"_19192":49169,"_5":13195,"_26170":48834,"_2648":49170},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3150":1353,"_27660":1223,"_19192":49172,"_5":13195,"_26170":48834,"_2648":49173},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3150":1354,"_27660":1223,"_19192":49175,"_5":13195,"_26170":48838,"_2648":49176},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3150":1355,"_27660":1223,"_19192":49178,"_5":13195,"_26170":48838,"_2648":49179},[],"The full flow from the device's perspective is:",{"_3150":1356,"_27660":1223,"_19192":49181,"_5":13195,"_26170":48838,"_2648":49182},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3150":1357,"_27660":1223,"_19192":49184,"_5":13195,"_26170":48842,"_2648":49185},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3150":1358,"_27660":1223,"_19192":49187,"_5":13195,"_26170":48842,"_2648":49188},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3150":1359,"_27660":1223,"_19192":49190,"_5":13195,"_26170":48842,"_2648":49191},[],"For the JITP flow to work correctly:",{"_3150":1360,"_27660":1223,"_19192":49193,"_5":13195,"_26170":48842,"_2648":49194},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3150":1361,"_27660":1223,"_19192":49196,"_5":13195,"_26170":48842,"_2648":49197},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3150":1362,"_27660":1223,"_19192":49199,"_5":13195,"_26170":48842,"_2648":49200},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3150":1363,"_27660":1223,"_19192":49202,"_5":13195,"_26170":48842,"_2648":49203},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3150":1364,"_27660":1223,"_19192":49205,"_5":13195,"_26170":48846,"_2648":49206},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3150":1365,"_27660":1223,"_19192":49208,"_5":13195,"_26170":48846,"_2648":49209},[],"Status in Lamassu",{"_3150":1366,"_27660":1223,"_19192":49211,"_5":13195,"_26170":48846,"_2648":49212},[],"Revocation reason",{"_3150":1367,"_27660":1223,"_19192":49214,"_5":13195,"_26170":48846,"_2648":49215},[],"Status in AWS IoT Core",{"_3150":1368,"_27660":1223,"_19192":49217,"_5":13195,"_26170":48846,"_2648":49218},[],"`Active`",{"_3150":1369,"_27660":1223,"_19192":49220,"_5":13195,"_26170":48846,"_2648":49221},[],"None",{"_3150":1370,"_27660":1223,"_19192":49223,"_5":13195,"_26170":48846,"_2648":49224},[],"`ACTIVE`",{"_3150":1371,"_27660":1223,"_19192":49226,"_5":13195,"_26170":48846,"_2648":49227},[],"`Revoked`",{"_3150":1372,"_27660":1223,"_19192":49229,"_5":13195,"_26170":48846,"_2648":49230},[],"`certificateHold`",{"_3150":1373,"_27660":1223,"_19192":49232,"_5":13195,"_26170":48846,"_2648":49233},[],"`INACTIVE`",{"_3150":1374,"_27660":1223,"_19192":49235,"_5":13195,"_26170":48846,"_2648":49227},[],{"_3150":1375,"_27660":1223,"_19192":49237,"_5":13195,"_26170":48846,"_2648":49238},[],"Any other reason",{"_3150":1376,"_27660":1223,"_19192":49240,"_5":13195,"_26170":48846,"_2648":49241},[],"`REVOKED`",{"_3150":1377,"_27660":1223,"_19192":49243,"_5":13195,"_26170":48846,"_2648":49244},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3150":1378,"_27660":1223,"_19192":49246,"_5":13195,"_26170":48850,"_2648":49247},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3150":1379,"_27660":1223,"_19192":49249,"_5":13195,"_26170":48850,"_2648":49250},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3150":1380,"_27660":1223,"_19192":49252,"_5":13195,"_26170":48850,"_2648":49253},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3150":1381,"_27660":1223,"_19192":49255,"_5":13195,"_26170":48854,"_2648":49256},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3150":1382,"_27660":1223,"_19192":49258,"_5":13195,"_26170":48854,"_2648":49259},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3150":1383,"_27660":1223,"_19192":49261,"_5":13195,"_26170":48858,"_2648":49262},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3150":1384,"_27660":1223,"_19192":49264,"_5":13195,"_26170":48858,"_2648":49265},[],"There are two action types:",{"_3150":1385,"_27660":1223,"_19192":49267,"_5":13195,"_26170":48858,"_2648":49268},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3150":1386,"_27660":1223,"_19192":49270,"_5":13195,"_26170":48858,"_2648":49271},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3150":1387,"_27660":1223,"_19192":49273,"_5":13195,"_26170":48858,"_2648":49274},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3150":1388,"_27660":1223,"_19192":49276,"_5":13195,"_26170":48862,"_2648":49277},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3150":1389,"_27660":1223,"_19192":49279,"_5":13195,"_26170":48862,"_2648":49280},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3150":1390,"_27660":1223,"_19192":49282,"_5":13195,"_26170":48862,"_2648":49283},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3150":1391,"_27660":1223,"_19192":49285,"_5":13195,"_26170":48866,"_2648":49286},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3150":1392,"_27660":1223,"_19192":49288,"_5":13195,"_26170":48866,"_2648":49289},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3150":1393,"_27660":1223,"_19192":49291,"_5":13195,"_26170":48866,"_2648":49292},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3150":1394,"_27660":1223,"_19192":49294,"_5":13195,"_26170":48866,"_2648":49295},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3150":1395,"_27660":1223,"_19192":49297,"_5":13195,"_26170":48866,"_2648":49298},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3150":1396,"_27660":1223,"_19192":49300,"_5":13195,"_26170":48866,"_2648":49301},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3150":1397,"_27660":1223,"_19192":49303,"_5":13195,"_26170":48866,"_2648":49304},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3150":1398,"_27660":1223,"_19192":49306,"_5":13195,"_26170":48866,"_2648":49307},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3150":1399,"_27660":1223,"_19192":49309,"_5":13195,"_26170":48866,"_2648":49310},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3150":1400,"_27660":1223,"_19192":49312,"_5":13195,"_26170":48866,"_2648":49313},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3150":1401,"_27660":1223,"_19192":49315,"_5":13195,"_26170":48866,"_2648":49316},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3150":1402,"_27660":1223,"_19192":49318,"_5":13195,"_26170":48866,"_2648":49319},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3150":1403,"_27660":1223,"_19192":49321,"_5":13195,"_26170":48866,"_2648":49322},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3150":1404,"_27660":1223,"_19192":49324,"_5":13195,"_26170":48866,"_2648":49325},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3150":1405,"_27660":1223,"_19192":49327,"_5":13195,"_26170":48866,"_2648":49328},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3150":1406,"_27660":1223,"_19192":49330,"_5":13195,"_26170":48866,"_2648":49331},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3150":1407,"_27660":1223,"_19192":49333,"_5":13195,"_26170":48866,"_2648":49334},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3150":1408,"_27660":1223,"_19192":49336,"_5":13195,"_26170":48866,"_2648":49337},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3150":1409,"_27660":1223,"_19192":49339,"_5":13195,"_26170":48866,"_2648":49340},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":1410,"_27660":1223,"_19192":49342,"_5":13195,"_26170":48866,"_2648":49343},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3150":1411,"_27660":1223,"_19192":49345,"_5":13195,"_26170":48866,"_2648":49346},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3150":1412,"_27660":1412,"_5":13521,"_2648":47327,"_28003":49348,"_19192":49349,"_26170":1412},[44970,46350,47327],[],{"_3150":1413,"_27660":1412,"_19192":49351,"_5":13195,"_26170":1412,"_2648":49352},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3150":1414,"_27660":1412,"_5":28000,"_19192":49354,"_26170":49355,"_2648":49356},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#start-here","Start here",{"_3150":1415,"_27660":1412,"_5":28000,"_19192":49358,"_26170":49359,"_2648":47325},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#devices-and-identities",{"_3150":1416,"_27660":1412,"_5":28000,"_19192":49361,"_26170":49362,"_2648":47508},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#enrollment-with-pki",{"_3150":1417,"_27660":1412,"_5":28000,"_19192":49364,"_26170":49365,"_2648":48783},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#integrations",{"_3150":1418,"_27660":1412,"_5":28000,"_19192":49367,"_26170":49368,"_2648":49369},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3150":1419,"_27660":1412,"_19192":49371,"_5":13195,"_26170":1412,"_2648":49372},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3150":1420,"_27660":1412,"_19192":49374,"_5":13195,"_26170":49355,"_2648":49375},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3150":1421,"_27660":1412,"_19192":49377,"_5":13195,"_26170":49355,"_2648":49378},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3150":1422,"_27660":1412,"_19192":49380,"_5":13195,"_26170":49359,"_2648":49381},[],"Resource",{"_3150":1423,"_27660":1412,"_19192":49383,"_5":13195,"_26170":49359,"_2648":49384},[],"What it represents",{"_3150":1424,"_27660":1412,"_19192":49386,"_5":13195,"_26170":49359,"_2648":49387},[],"**Device**",{"_3150":1425,"_27660":1412,"_19192":49389,"_5":13195,"_26170":49359,"_2648":49390},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3150":1426,"_27660":1412,"_19192":49392,"_5":13195,"_26170":49359,"_2648":49393},[],"**Identity**",{"_3150":1427,"_27660":1412,"_19192":49395,"_5":13195,"_26170":49359,"_2648":49396},[],"The device's association with its certificates: an active version and a history.",{"_3150":1428,"_27660":1412,"_19192":49398,"_5":13195,"_26170":49359,"_2648":49399},[],"**DMS**",{"_3150":1429,"_27660":1412,"_19192":49401,"_5":13195,"_26170":49359,"_2648":49402},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3150":1430,"_27660":1412,"_19192":49404,"_5":13195,"_26170":49359,"_2648":49405},[],"**Fleet**",{"_3150":1431,"_27660":1412,"_19192":49407,"_5":13195,"_26170":49359,"_2648":49408},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3150":1432,"_27660":1412,"_19192":49410,"_5":13195,"_26170":49359,"_2648":49411},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3150":1433,"_27660":1412,"_19192":49413,"_5":13195,"_26170":49359,"_2648":49414},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3150":1434,"_27660":1412,"_19192":49416,"_5":13195,"_26170":49362,"_2648":49417},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3150":1435,"_27660":1412,"_19192":49419,"_5":13195,"_26170":49362,"_2648":49420},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3150":1436,"_27660":1412,"_19192":49422,"_5":13195,"_26170":49362,"_2648":49423},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3150":1437,"_27660":1412,"_19192":49425,"_5":13195,"_26170":49362,"_2648":49426},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3150":1438,"_27660":1412,"_19192":49428,"_5":13195,"_26170":49362,"_2648":49429},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3150":1439,"_27660":1412,"_19192":49431,"_5":13195,"_26170":49362,"_2648":49432},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3150":1440,"_27660":1412,"_19192":49434,"_5":13195,"_26170":49362,"_2648":49435},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":1441,"_27660":1412,"_19192":49437,"_5":13195,"_26170":49362,"_2648":49438},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":1442,"_27660":1412,"_19192":49440,"_5":13195,"_26170":49365,"_2648":49441},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3150":1443,"_27660":1412,"_19192":49443,"_5":13195,"_26170":49365,"_2648":49444},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3150":1444,"_27660":1412,"_19192":49446,"_5":13195,"_26170":49368,"_2648":49447},[],"Participant",{"_3150":1445,"_27660":1412,"_19192":49449,"_5":13195,"_26170":49368,"_2648":49450},[],"Responsibility",{"_3150":1446,"_27660":1412,"_19192":49452,"_5":13195,"_26170":49368,"_2648":49453},[],"PKI administrator",{"_3150":1447,"_27660":1412,"_19192":49455,"_5":13195,"_26170":49368,"_2648":49456},[],"CA, issuance profile, chain and revocation publication.",{"_3150":1448,"_27660":1412,"_19192":49458,"_5":13195,"_26170":49368,"_2648":49459},[],"Provisioning administrator",{"_3150":1449,"_27660":1412,"_19192":49461,"_5":13195,"_26170":49368,"_2648":49462},[],"DMS, admission, authentication per operation and inventory.",{"_3150":1450,"_27660":1412,"_19192":49464,"_5":13195,"_26170":49368,"_2648":49465},[],"Device integrator",{"_3150":1451,"_27660":1412,"_19192":49467,"_5":13195,"_26170":49368,"_2648":49468},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3150":1452,"_27660":1412,"_19192":49470,"_5":13195,"_26170":49368,"_2648":49471},[],"Consumer integrator",{"_3150":1453,"_27660":1412,"_19192":49473,"_5":13195,"_26170":49368,"_2648":49474},[],"Trusted issuers, validation and device permissions in the destination.",{"_3150":1454,"_27660":1412,"_19192":49476,"_5":13195,"_26170":49368,"_2648":49477},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3150":1455,"_27660":1455,"_5":13521,"_2648":49479,"_28003":49480,"_19192":49482,"_26170":1455},"Enroll and connect your first device",[44970,46350,47327,49481],"Getting started",[],{"_3150":1456,"_27660":1455,"_19192":49484,"_5":13195,"_26170":1455,"_2648":49485},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3150":1457,"_27660":1455,"_5":28000,"_19192":49487,"_26170":49488,"_2648":44980},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3150":1458,"_27660":1455,"_5":28000,"_19192":49490,"_26170":49491,"_2648":49492},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3150":1459,"_27660":1455,"_5":28000,"_19192":49494,"_26170":49495,"_2648":49496},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3150":1460,"_27660":1455,"_5":28000,"_19192":49498,"_26170":49499,"_2648":49500},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3150":1461,"_27660":1455,"_5":28000,"_19192":49502,"_26170":49503,"_2648":49504},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3150":1462,"_27660":1455,"_5":28000,"_19192":49506,"_26170":49507,"_2648":49508},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3150":1463,"_27660":1455,"_5":28000,"_19192":49510,"_26170":49511,"_2648":49512},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3150":1464,"_27660":1455,"_5":28000,"_19192":49514,"_26170":49515,"_2648":49516},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3150":1465,"_27660":1455,"_19192":49518,"_5":13195,"_26170":1455,"_2648":49519},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3150":1466,"_27660":1455,"_19192":49521,"_5":13195,"_26170":49488,"_2648":49522},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3150":1467,"_27660":1455,"_19192":49524,"_5":13195,"_26170":49488,"_2648":49525},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3150":1468,"_27660":1455,"_19192":49527,"_5":13195,"_26170":49488,"_2648":49528},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3150":1469,"_27660":1455,"_19192":49530,"_5":13195,"_26170":49488,"_2648":49531},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3150":1470,"_27660":1455,"_19192":49533,"_5":13195,"_26170":49488,"_2648":49534},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3150":1471,"_27660":1455,"_19192":49536,"_5":13195,"_26170":49491,"_2648":49537},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3150":1472,"_27660":1455,"_19192":49539,"_5":13195,"_26170":49491,"_2648":49540},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3150":1473,"_27660":1455,"_19192":49542,"_5":13195,"_26170":49495,"_2648":49543},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3150":1474,"_27660":1455,"_19192":49545,"_5":13195,"_26170":49495,"_2648":49546},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3150":1475,"_27660":1455,"_19192":49548,"_5":13195,"_26170":49495,"_2648":49549},[],"Setting",{"_3150":1476,"_27660":1455,"_19192":49551,"_5":13195,"_26170":49495,"_2648":49552},[],"Evaluation value",{"_3150":1477,"_27660":1455,"_19192":49554,"_5":13195,"_26170":49495,"_2648":49555},[],"Enrollment CA",{"_3150":1478,"_27660":1455,"_19192":49557,"_5":13195,"_26170":49495,"_2648":49558},[],"Issuing root from `device-root.pem`.",{"_3150":1479,"_27660":1455,"_19192":49560,"_5":13195,"_26170":49495,"_2648":47638},[],{"_3150":1480,"_27660":1455,"_19192":49562,"_5":13195,"_26170":49495,"_2648":49563},[],"The 1-hour leaf profile you just prepared.",{"_3150":1481,"_27660":1455,"_19192":49565,"_5":13195,"_26170":49495,"_2648":49566},[],"Protocol / Registration Mode",{"_3150":1482,"_27660":1455,"_19192":49568,"_5":13195,"_26170":49495,"_2648":49569},[],"`EST_RFC7030` / `JITP`.",{"_3150":1483,"_27660":1455,"_19192":49571,"_5":13195,"_26170":49495,"_2648":49572},[],"Verify CSR Signature",{"_3150":1484,"_27660":1455,"_19192":49574,"_5":13195,"_26170":49495,"_2648":49575},[],"Enabled.",{"_3150":1485,"_27660":1455,"_19192":49577,"_5":13195,"_26170":49495,"_2648":49578},[],"Enable Replaceable Enrollment",{"_3150":1486,"_27660":1455,"_19192":49580,"_5":13195,"_26170":49495,"_2648":49581},[],"Disabled; the ID must be new.",{"_3150":1487,"_27660":1455,"_19192":49583,"_5":13195,"_26170":49495,"_2648":49584},[],"Initial authentication",{"_3150":1488,"_27660":1455,"_19192":49586,"_5":13195,"_26170":49495,"_2648":49587},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3150":1489,"_27660":1455,"_19192":49589,"_5":13195,"_26170":49495,"_2648":49590},[],"Renewal authentication",{"_3150":1490,"_27660":1455,"_19192":49592,"_5":13195,"_26170":49495,"_2648":49593},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3150":1491,"_27660":1455,"_19192":49595,"_5":13195,"_26170":49495,"_2648":49596},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3150":1492,"_27660":1455,"_19192":49598,"_5":13195,"_26170":49495,"_2648":49599},[],"Empty list for this direct issuance / disabled.",{"_3150":1493,"_27660":1455,"_19192":49601,"_5":13195,"_26170":49495,"_2648":49602},[],"Re-enrollment Delta",{"_3150":1494,"_27660":1455,"_19192":49604,"_5":13195,"_26170":49495,"_2648":49605},[],"1 hour.",{"_3150":1495,"_27660":1455,"_19192":49607,"_5":13195,"_26170":49495,"_2648":49608},[],"Preventive / Critical Delta",{"_3150":1496,"_27660":1455,"_19192":49610,"_5":13195,"_26170":49495,"_2648":49611},[],"30 minutes / 10 minutes.",{"_3150":1497,"_27660":1455,"_19192":49613,"_5":13195,"_26170":49495,"_2648":49614},[],"Revoke on Re-enrollment",{"_3150":1498,"_27660":1455,"_19192":49616,"_5":13195,"_26170":49495,"_2648":49617},[],"Disabled to test the successor before retiring the previous identity.",{"_3150":1499,"_27660":1455,"_19192":49619,"_5":13195,"_26170":49495,"_2648":47646},[],{"_3150":1500,"_27660":1455,"_19192":49621,"_5":13195,"_26170":49495,"_2648":49622},[],"Disabled; the operational key is generated in the client.",{"_3150":1501,"_27660":1455,"_19192":49624,"_5":13195,"_26170":49495,"_2648":49625},[],"CA Distribution",{"_3150":1502,"_27660":1455,"_19192":49627,"_5":13195,"_26170":49495,"_2648":49628},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3150":1503,"_27660":1455,"_19192":49630,"_5":13195,"_26170":49495,"_2648":49631},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_3150":1504,"_27660":1455,"_19192":49633,"_5":13195,"_26170":49499,"_2648":49634},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3150":1505,"_27660":1455,"_19192":49636,"_5":13195,"_26170":49499,"_2648":49637},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3150":1506,"_27660":1455,"_19192":49639,"_5":13195,"_26170":49503,"_2648":49640},[],"Generate a new key and CSR with the selected identifier:",{"_3150":1507,"_27660":1455,"_19192":49642,"_5":13195,"_26170":49503,"_2648":49643},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3150":1508,"_27660":1455,"_19192":49645,"_5":13195,"_26170":49503,"_2648":49646},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3150":1509,"_27660":1455,"_19192":49648,"_5":13195,"_26170":49507,"_2648":49649},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3150":1510,"_27660":1455,"_19192":49651,"_5":13195,"_26170":49507,"_2648":49652},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3150":1511,"_27660":1455,"_19192":49654,"_5":13195,"_26170":49511,"_2648":49655},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3150":1512,"_27660":1455,"_19192":49657,"_5":13195,"_26170":49511,"_2648":49658},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3150":1513,"_27660":1455,"_19192":49660,"_5":13195,"_26170":49511,"_2648":49661},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3150":1514,"_27660":1455,"_19192":49663,"_5":13195,"_26170":49511,"_2648":49664},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3150":1515,"_27660":1455,"_19192":49666,"_5":13195,"_26170":49511,"_2648":49667},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3150":1516,"_27660":1455,"_19192":49669,"_5":13195,"_26170":49515,"_2648":49670},[],"Check",{"_3150":1517,"_27660":1455,"_19192":49672,"_5":13195,"_26170":49515,"_2648":49673},[],"Expected result",{"_3150":1518,"_27660":1455,"_19192":49675,"_5":13195,"_26170":49515,"_2648":49676},[],"Registration",{"_3150":1519,"_27660":1455,"_19192":49678,"_5":13195,"_26170":49515,"_2648":49679},[],"ID created automatically and correct DMS.",{"_3150":1520,"_27660":1455,"_19192":49681,"_5":13195,"_26170":49515,"_2648":49682},[],"Certificate",{"_3150":1521,"_27660":1455,"_19192":49684,"_5":13195,"_26170":49515,"_2648":49685},[],"CN, profile, serial and key verified.",{"_3150":1522,"_27660":1455,"_19192":49687,"_5":13195,"_26170":49515,"_2648":49688},[],"Inventory",{"_3150":1523,"_27660":1455,"_19192":49690,"_5":13195,"_26170":49515,"_2648":49691},[],"Received serial visible as the current identity and in history.",{"_3150":1524,"_27660":1455,"_19192":49693,"_5":13195,"_26170":49515,"_2648":49694},[],"Consumer",{"_3150":1525,"_27660":1455,"_19192":49696,"_5":13195,"_26170":49515,"_2648":49697},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3150":1526,"_27660":1455,"_19192":49699,"_5":13195,"_26170":49515,"_2648":49700},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3150":1527,"_27660":1455,"_19192":49702,"_5":13195,"_26170":49515,"_2648":49703},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3150":1528,"_27660":1528,"_5":13521,"_2648":47343,"_28003":49705,"_19192":49706,"_26170":1528},[44970,46350,47327,49481],[],{"_3150":1529,"_27660":1528,"_19192":49708,"_5":13195,"_26170":1528,"_2648":49709},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3150":1530,"_27660":1528,"_5":28000,"_19192":49711,"_26170":49712,"_2648":44980},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3150":1531,"_27660":1528,"_5":28000,"_19192":49714,"_26170":49715,"_2648":49716},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3150":1532,"_27660":1528,"_5":28000,"_19192":49718,"_26170":49719,"_2648":49720},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3150":1533,"_27660":1528,"_5":28000,"_19192":49722,"_26170":49723,"_2648":49724},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3150":1534,"_27660":1528,"_5":28000,"_19192":49726,"_26170":49727,"_2648":49728},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3150":1535,"_27660":1528,"_5":28000,"_19192":49730,"_26170":49731,"_2648":49732},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3150":1536,"_27660":1528,"_5":28000,"_19192":49734,"_26170":49735,"_2648":49673},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3150":1537,"_27660":1528,"_5":28000,"_19192":49737,"_26170":49738,"_2648":49739},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3150":1538,"_27660":1528,"_5":28000,"_19192":49741,"_26170":49742,"_2648":49743},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3150":1539,"_27660":1528,"_19192":49745,"_5":13195,"_26170":1528,"_2648":49746},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3150":1540,"_27660":1528,"_19192":49748,"_5":13195,"_26170":1528,"_2648":49749},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3150":1541,"_27660":1528,"_19192":49751,"_5":13195,"_26170":49712,"_2648":49752},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3150":1542,"_27660":1528,"_19192":49754,"_5":13195,"_26170":49712,"_2648":49755},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3150":1543,"_27660":1528,"_19192":49757,"_5":13195,"_26170":49712,"_2648":49758},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3150":1544,"_27660":1528,"_19192":49760,"_5":13195,"_26170":49712,"_2648":49761},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3150":1545,"_27660":1528,"_19192":49763,"_5":13195,"_26170":49715,"_2648":49764},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3150":1546,"_27660":1528,"_19192":49766,"_5":13195,"_26170":49715,"_2648":49767},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3150":1547,"_27660":1528,"_19192":49769,"_5":13195,"_26170":49715,"_2648":49770},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3150":1548,"_27660":1528,"_19192":49772,"_5":13195,"_26170":49715,"_2648":49773},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3150":1549,"_27660":1528,"_19192":49775,"_5":13195,"_26170":49715,"_2648":49776},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_3150":1550,"_27660":1528,"_19192":49778,"_5":13195,"_26170":49715,"_2648":49779},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3150":1551,"_27660":1528,"_19192":49781,"_5":13195,"_26170":49715,"_2648":49782},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3150":1552,"_27660":1528,"_19192":49784,"_5":13195,"_26170":49715,"_2648":49785},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3150":1553,"_27660":1528,"_19192":49787,"_5":13195,"_26170":49719,"_2648":49788},[],"Open **Managed Devices** and the registration action. Complete:",{"_3150":1554,"_27660":1528,"_19192":49790,"_5":13195,"_26170":49719,"_2648":49791},[],"**Device ID**: `device-001`.",{"_3150":1555,"_27660":1528,"_19192":49793,"_5":13195,"_26170":49719,"_2648":49794},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3150":1556,"_27660":1528,"_19192":49796,"_5":13195,"_26170":49719,"_2648":49797},[],"**Icon** and **Tags**: optional classification.",{"_3150":1557,"_27660":1528,"_19192":49799,"_5":13195,"_26170":49719,"_2648":49800},[],"Confirm registration.",{"_3150":1558,"_27660":1528,"_19192":49802,"_5":13195,"_26170":49723,"_2648":49803},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3150":1559,"_27660":1528,"_19192":49805,"_5":13195,"_26170":49723,"_2648":49806},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3150":1560,"_27660":1528,"_19192":49808,"_5":13195,"_26170":49727,"_2648":49809},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3150":1561,"_27660":1528,"_19192":49811,"_5":13195,"_26170":49727,"_2648":49812},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3150":1562,"_27660":1528,"_19192":49814,"_5":13195,"_26170":49731,"_2648":49815},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3150":1563,"_27660":1528,"_19192":49817,"_5":13195,"_26170":49731,"_2648":49818},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3150":1564,"_27660":1528,"_19192":49820,"_5":13195,"_26170":49735,"_2648":49670},[],{"_3150":1565,"_27660":1528,"_19192":49822,"_5":13195,"_26170":49735,"_2648":49823},[],"Result",{"_3150":1566,"_27660":1528,"_19192":49825,"_5":13195,"_26170":49735,"_2648":49826},[],"Device",{"_3150":1567,"_27660":1528,"_19192":49828,"_5":13195,"_26170":49735,"_2648":49829},[],"`device-001` appears in inventory with the expected DMS.",{"_3150":1568,"_27660":1528,"_19192":49831,"_5":13195,"_26170":49735,"_2648":49832},[],"Current identity",{"_3150":1569,"_27660":1528,"_19192":49834,"_5":13195,"_26170":49735,"_2648":49835},[],"The associated certificate matches the one you verified in PKI.",{"_3150":1570,"_27660":1528,"_19192":49837,"_5":13195,"_26170":49735,"_2648":49838},[],"History",{"_3150":1571,"_27660":1528,"_19192":49840,"_5":13195,"_26170":49735,"_2648":49841},[],"The associated issuance appears with its serial number and dates.",{"_3150":1572,"_27660":1528,"_19192":49843,"_5":13195,"_26170":49735,"_2648":49844},[],"Key and certificate",{"_3150":1573,"_27660":1528,"_19192":49846,"_5":13195,"_26170":49735,"_2648":49847},[],"You have the verified pair ready to install on the device.",{"_3150":1574,"_27660":1528,"_19192":49849,"_5":13195,"_26170":49738,"_2648":49850},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3150":1575,"_27660":1528,"_19192":49852,"_5":13195,"_26170":49738,"_2648":49853},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3150":1576,"_27660":1528,"_19192":49855,"_5":13195,"_26170":49738,"_2648":49856},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3150":1577,"_27660":1528,"_19192":49858,"_5":13195,"_26170":49738,"_2648":49859},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3150":1578,"_27660":1528,"_19192":49861,"_5":13195,"_26170":49742,"_2648":49862},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3150":1579,"_27660":1528,"_19192":49864,"_5":13195,"_26170":49742,"_2648":49865},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3150":1580,"_27660":1528,"_19192":49867,"_5":13195,"_26170":49742,"_2648":49868},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3150":1581,"_27660":1581,"_5":13521,"_2648":49870,"_28003":49871,"_19192":49872,"_26170":1581},"Lamassu IoT Platform",[44970,46350],[],{"_3150":1582,"_27660":1581,"_19192":49874,"_5":13195,"_26170":1581,"_2648":49875},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3150":1583,"_27660":1581,"_5":28000,"_19192":49877,"_26170":49878,"_2648":49356},[],"/docs/pr-preview/pr-26/platform/overview#start-here",{"_3150":1584,"_27660":1581,"_5":28000,"_19192":49880,"_26170":49881,"_2648":49882},[],"/docs/pr-preview/pr-26/platform/overview#choose-your-path","Choose your path",{"_3150":1585,"_27660":1581,"_5":28000,"_19192":49884,"_26170":49885,"_2648":49886},[],"/docs/pr-preview/pr-26/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3150":1586,"_27660":1581,"_5":28000,"_19192":49888,"_26170":49889,"_2648":49890},[],"/docs/pr-preview/pr-26/platform/overview#core-capabilities","Core capabilities",{"_3150":1587,"_27660":1581,"_5":28000,"_19192":49892,"_26170":49893,"_2648":49894},[],"/docs/pr-preview/pr-26/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3150":1588,"_27660":1581,"_5":28000,"_19192":49896,"_26170":49897,"_2648":49898},[],"/docs/pr-preview/pr-26/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3150":1589,"_27660":1581,"_5":28000,"_19192":49900,"_26170":49901,"_2648":49902},[],"/docs/pr-preview/pr-26/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3150":1590,"_27660":1581,"_5":28000,"_19192":49904,"_26170":49905,"_2648":49906},[],"/docs/pr-preview/pr-26/platform/overview#automate-device-identities","Automate device identities",{"_3150":1591,"_27660":1581,"_5":28000,"_19192":49908,"_26170":49909,"_2648":49910},[],"/docs/pr-preview/pr-26/platform/overview#publish-validation-status","Publish validation status",{"_3150":1592,"_27660":1581,"_5":28000,"_19192":49912,"_26170":49913,"_2648":49914},[],"/docs/pr-preview/pr-26/platform/overview#react-to-events","React to events",{"_3150":1593,"_27660":1581,"_5":28000,"_19192":49916,"_26170":49917,"_2648":49918},[],"/docs/pr-preview/pr-26/platform/overview#operational-reference","Operational reference",{"_3150":1594,"_27660":1581,"_19192":49920,"_5":13195,"_26170":1581,"_2648":49921},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3150":1595,"_27660":1581,"_19192":49923,"_5":13195,"_26170":49878,"_2648":49924},[],"Choose the result you need:",{"_3150":1596,"_27660":1581,"_19192":49926,"_5":13195,"_26170":49878,"_2648":49927},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":1597,"_27660":1581,"_19192":49929,"_5":13195,"_26170":49878,"_2648":49930},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":1598,"_27660":1581,"_19192":49932,"_5":13195,"_26170":49878,"_2648":49933},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3150":1599,"_27660":1581,"_19192":49935,"_5":13195,"_26170":49881,"_2648":49936},[],"Section",{"_3150":1600,"_27660":1581,"_19192":49938,"_5":13195,"_26170":49881,"_2648":49939},[],"What you manage",{"_3150":1601,"_27660":1581,"_19192":49941,"_5":13195,"_26170":49881,"_2648":49942},[],"Entry point",{"_3150":1602,"_27660":1581,"_19192":49944,"_5":13195,"_26170":49881,"_2648":49945},[],"**PKI**",{"_3150":1603,"_27660":1581,"_19192":49947,"_5":13195,"_26170":49881,"_2648":49948},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3150":1604,"_27660":1581,"_19192":49950,"_5":13195,"_26170":49881,"_2648":49951},[],"PKI overview",{"_3150":1605,"_27660":1581,"_19192":49953,"_5":13195,"_26170":49881,"_2648":49954},[],"**IoT Fleets**",{"_3150":1606,"_27660":1581,"_19192":49956,"_5":13195,"_26170":49881,"_2648":49957},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3150":1607,"_27660":1581,"_19192":49959,"_5":13195,"_26170":49881,"_2648":49960},[],"IoT Fleets overview",{"_3150":1608,"_27660":1581,"_19192":49962,"_5":13195,"_26170":49881,"_2648":49963},[],"**Administration**",{"_3150":1609,"_27660":1581,"_19192":49965,"_5":13195,"_26170":49881,"_2648":49966},[],"Operator permissions, audit and event subscriptions.",{"_3150":1610,"_27660":1581,"_19192":49968,"_5":13195,"_26170":49881,"_2648":46348},[],{"_3150":1611,"_27660":1581,"_19192":49970,"_5":13195,"_26170":49881,"_2648":49971},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3150":1612,"_27660":1581,"_19192":49973,"_5":13195,"_26170":49885,"_2648":49974},[],"An identity's journey connects four responsibilities:",{"_3150":1613,"_27660":1581,"_19192":49976,"_5":13195,"_26170":49885,"_2648":49977},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3150":1614,"_27660":1581,"_19192":49979,"_5":13195,"_26170":49885,"_2648":49980},[],"The provisioning administrator configures the DMS and initial trust.",{"_3150":1615,"_27660":1581,"_19192":49982,"_5":13195,"_26170":49885,"_2648":49983},[],"The device client requests a certificate and installs it with the matching key.",{"_3150":1616,"_27660":1581,"_19192":49985,"_5":13195,"_26170":49885,"_2648":49986},[],"The consumer validates the identity and applies its access permissions.",{"_3150":1617,"_27660":1581,"_19192":49988,"_5":13195,"_26170":49885,"_2648":49989},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3150":1618,"_27660":1581,"_19192":49991,"_5":13195,"_26170":49893,"_2648":49992},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3150":1619,"_27660":1581,"_19192":49994,"_5":13195,"_26170":49897,"_2648":49995},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3150":1620,"_27660":1581,"_19192":49997,"_5":13195,"_26170":49901,"_2648":49998},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3150":1621,"_27660":1581,"_19192":50000,"_5":13195,"_26170":49905,"_2648":50001},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3150":1622,"_27660":1581,"_19192":50003,"_5":13195,"_26170":49909,"_2648":50004},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3150":1623,"_27660":1581,"_19192":50006,"_5":13195,"_26170":49913,"_2648":50007},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3150":1624,"_27660":1581,"_19192":50009,"_5":13195,"_26170":49917,"_2648":49450},[],{"_3150":1625,"_27660":1581,"_19192":50011,"_5":13195,"_26170":49917,"_2648":50012},[],"What it prepares or checks",{"_3150":1626,"_27660":1581,"_19192":50014,"_5":13195,"_26170":49917,"_2648":49453},[],{"_3150":1627,"_27660":1581,"_19192":50016,"_5":13195,"_26170":49917,"_2648":50017},[],"Key custody, CA hierarchy, profiles and validation.",{"_3150":1628,"_27660":1581,"_19192":50019,"_5":13195,"_26170":49917,"_2648":50020},[],"Fleet administrator",{"_3150":1629,"_27660":1581,"_19192":50022,"_5":13195,"_26170":49917,"_2648":50023},[],"DMS, device admission, renewal policy and inventory.",{"_3150":1630,"_27660":1581,"_19192":50025,"_5":13195,"_26170":49917,"_2648":49465},[],{"_3150":1631,"_27660":1581,"_19192":50027,"_5":13195,"_26170":49917,"_2648":50028},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3150":1632,"_27660":1581,"_19192":50030,"_5":13195,"_26170":49917,"_2648":49471},[],{"_3150":1633,"_27660":1581,"_19192":50032,"_5":13195,"_26170":49917,"_2648":50033},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3150":1634,"_27660":1581,"_19192":50035,"_5":13195,"_26170":49917,"_2648":50036},[],"Infrastructure operator",{"_3150":1635,"_27660":1581,"_19192":50038,"_5":13195,"_26170":49917,"_2648":50039},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3150":1636,"_27660":1581,"_19192":50041,"_5":13195,"_26170":49917,"_2648":50042},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3150":1637,"_27660":1637,"_5":13521,"_2648":50044,"_28003":50045,"_19192":50048,"_26170":1637},"CA hierarchy and rotation",[44970,46350,50046,50047],"PKI","Keys, authorities and certificates",[],{"_3150":1638,"_27660":1637,"_19192":50050,"_5":13195,"_26170":1637,"_2648":50051},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3150":1639,"_27660":1637,"_5":28000,"_19192":50053,"_26170":50054,"_2648":50055},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3150":1640,"_27660":1637,"_5":28000,"_19192":50057,"_26170":50058,"_2648":50059},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3150":1641,"_27660":1637,"_5":28000,"_19192":50061,"_26170":50062,"_2648":50063},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3150":1642,"_27660":1637,"_5":28000,"_19192":50065,"_26170":50066,"_2648":50067},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3150":1643,"_27660":1637,"_5":28000,"_19192":50069,"_26170":50070,"_2648":50071},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3150":1644,"_27660":1637,"_5":28000,"_19192":50073,"_26170":50074,"_2648":50075},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3150":1645,"_27660":1637,"_5":28000,"_19192":50077,"_26170":50078,"_2648":50079},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3150":1646,"_27660":1637,"_5":28000,"_19192":50081,"_26170":50082,"_2648":50083},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3150":1647,"_27660":1637,"_5":28000,"_19192":50085,"_26170":50086,"_2648":50087},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3150":1648,"_27660":1637,"_5":28000,"_19192":50089,"_26170":50090,"_2648":50091},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3150":1649,"_27660":1637,"_5":28000,"_19192":50093,"_26170":50094,"_2648":50095},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3150":1650,"_27660":1637,"_5":28000,"_19192":50097,"_26170":50098,"_2648":50099},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3150":1651,"_27660":1637,"_19192":50101,"_5":13195,"_26170":1637,"_2648":50102},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3150":1652,"_27660":1637,"_19192":50104,"_5":13195,"_26170":1637,"_2648":50105},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3150":1653,"_27660":1637,"_19192":50107,"_5":13195,"_26170":50054,"_2648":50108},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3150":1654,"_27660":1637,"_19192":50110,"_5":13195,"_26170":50054,"_2648":50111},[],"environment, such as production and preproduction;",{"_3150":1655,"_27660":1637,"_19192":50113,"_5":13195,"_26170":50054,"_2648":50114},[],"owner or operating team;",{"_3150":1656,"_27660":1637,"_19192":50116,"_5":13195,"_26170":50054,"_2648":50117},[],"device family or manufacturing process;",{"_3150":1657,"_27660":1637,"_19192":50119,"_5":13195,"_26170":50054,"_2648":50120},[],"region or regulatory requirement;",{"_3150":1658,"_27660":1637,"_19192":50122,"_5":13195,"_26170":50054,"_2648":50123},[],"cryptographic engine or key policy;",{"_3150":1659,"_27660":1637,"_19192":50125,"_5":13195,"_26170":50054,"_2648":50126},[],"maintenance window and renewal cadence.",{"_3150":1660,"_27660":1637,"_19192":50128,"_5":13195,"_26170":50054,"_2648":50129},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3150":1661,"_27660":1637,"_19192":50131,"_5":13195,"_26170":50054,"_2648":50132},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3150":1662,"_27660":1637,"_19192":50134,"_5":13195,"_26170":50058,"_2648":50135},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3150":1663,"_27660":1637,"_19192":50137,"_5":13195,"_26170":50058,"_2648":50138},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3150":1664,"_27660":1637,"_19192":50140,"_5":13195,"_26170":50058,"_2648":50141},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3150":1665,"_27660":1637,"_19192":50143,"_5":13195,"_26170":50062,"_2648":50144},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3150":1666,"_27660":1637,"_19192":50146,"_5":13195,"_26170":50062,"_2648":50147},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3150":1667,"_27660":1637,"_19192":50149,"_5":13195,"_26170":50062,"_2648":50150},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3150":1668,"_27660":1637,"_19192":50152,"_5":13195,"_26170":50062,"_2648":50153},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3150":1669,"_27660":1637,"_19192":50155,"_5":13195,"_26170":50070,"_2648":50156},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3150":1670,"_27660":1637,"_19192":50158,"_5":13195,"_26170":50074,"_2648":50159},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3150":1671,"_27660":1637,"_19192":50161,"_5":13195,"_26170":50078,"_2648":50162},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3150":1672,"_27660":1637,"_19192":50164,"_5":13195,"_26170":50082,"_2648":50165},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_3150":1673,"_27660":1637,"_19192":50167,"_5":13195,"_26170":50086,"_2648":50168},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3150":1674,"_27660":1637,"_19192":50170,"_5":13195,"_26170":50090,"_2648":50171},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_3150":1675,"_27660":1637,"_19192":50173,"_5":13195,"_26170":50094,"_2648":50174},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3150":1676,"_27660":1637,"_19192":50176,"_5":13195,"_26170":50094,"_2648":50177},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3150":1677,"_27660":1637,"_19192":50179,"_5":13195,"_26170":50094,"_2648":50180},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3150":1678,"_27660":1637,"_19192":50182,"_5":13195,"_26170":50094,"_2648":50183},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3150":1679,"_27660":1637,"_19192":50185,"_5":13195,"_26170":50098,"_2648":50186},[],"The new chain ends in an anchor installed by the consumer.",{"_3150":1680,"_27660":1637,"_19192":50188,"_5":13195,"_26170":50098,"_2648":50189},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3150":1681,"_27660":1637,"_19192":50191,"_5":13195,"_26170":50098,"_2648":50192},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3150":1682,"_27660":1637,"_19192":50194,"_5":13195,"_26170":50098,"_2648":50195},[],"Re-enrollment accepts the old identity during the planned period.",{"_3150":1683,"_27660":1637,"_19192":50197,"_5":13195,"_26170":50098,"_2648":50198},[],"OCSP and CRL respond for the authorities that remain active.",{"_3150":1684,"_27660":1637,"_19192":50200,"_5":13195,"_26170":50098,"_2648":50201},[],"No DMS is left accidentally issuing from the old CA.",{"_3150":1685,"_27660":1637,"_19192":50203,"_5":13195,"_26170":50098,"_2648":50204},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3150":1686,"_27660":1686,"_5":13521,"_2648":50206,"_28003":50207,"_19192":50208,"_26170":1686},"Certification authorities",[44970,46350,50046,50047],[],{"_3150":1687,"_27660":1686,"_19192":50210,"_5":13195,"_26170":1686,"_2648":50211},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3150":1688,"_27660":1686,"_5":28000,"_19192":50213,"_26170":50214,"_2648":50215},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3150":1689,"_27660":1686,"_5":28000,"_19192":50217,"_26170":50218,"_2648":50219},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3150":1690,"_27660":1686,"_5":28000,"_19192":50221,"_26170":50222,"_2648":44980},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#before-you-begin",{"_3150":1691,"_27660":1686,"_5":28000,"_19192":50224,"_26170":50225,"_2648":50226},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3150":1692,"_27660":1686,"_5":28000,"_19192":50228,"_26170":50229,"_2648":50230},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3150":1693,"_27660":1686,"_5":28000,"_19192":50232,"_26170":50233,"_2648":50234},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3150":1694,"_27660":1686,"_5":28000,"_19192":50236,"_26170":50237,"_2648":50238},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3150":1695,"_27660":1686,"_5":28000,"_19192":50240,"_26170":50241,"_2648":50242},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3150":1696,"_27660":1686,"_5":28000,"_19192":50244,"_26170":50245,"_2648":50246},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3150":1697,"_27660":1686,"_5":28000,"_19192":50248,"_26170":50249,"_2648":50250},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3150":1698,"_27660":1686,"_5":28000,"_19192":50252,"_26170":50253,"_2648":50254},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3150":1699,"_27660":1686,"_5":28000,"_19192":50256,"_26170":50257,"_2648":50258},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3150":1700,"_27660":1686,"_5":28000,"_19192":50260,"_26170":50261,"_2648":50262},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3150":1701,"_27660":1686,"_5":28000,"_19192":50264,"_26170":50265,"_2648":50266},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3150":1702,"_27660":1686,"_5":28000,"_19192":50268,"_26170":50269,"_2648":50270},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3150":1703,"_27660":1686,"_5":28000,"_19192":50272,"_26170":50273,"_2648":50274},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3150":1704,"_27660":1686,"_5":28000,"_19192":50276,"_26170":50277,"_2648":50278},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3150":1705,"_27660":1686,"_5":28000,"_19192":50280,"_26170":50281,"_2648":50282},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3150":1706,"_27660":1686,"_5":28000,"_19192":50284,"_26170":50285,"_2648":50286},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3150":1707,"_27660":1686,"_5":28000,"_19192":50288,"_26170":50289,"_2648":50290},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3150":1708,"_27660":1686,"_5":28000,"_19192":50292,"_26170":50293,"_2648":50294},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3150":1709,"_27660":1686,"_5":28000,"_19192":50296,"_26170":50297,"_2648":50298},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3150":1710,"_27660":1686,"_19192":50300,"_5":13195,"_26170":1686,"_2648":50301},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3150":1711,"_27660":1686,"_19192":50303,"_5":13195,"_26170":1686,"_2648":50304},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3150":1712,"_27660":1686,"_19192":50306,"_5":13195,"_26170":1686,"_2648":50307},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3150":1713,"_27660":1686,"_19192":50309,"_5":13195,"_26170":50214,"_2648":50310},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3150":1714,"_27660":1686,"_19192":50312,"_5":13195,"_26170":50214,"_2648":50313},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3150":1715,"_27660":1686,"_19192":50315,"_5":13195,"_26170":50214,"_2648":50316},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3150":1716,"_27660":1686,"_19192":50318,"_5":13195,"_26170":50214,"_2648":50319},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3150":1717,"_27660":1686,"_19192":50321,"_5":13195,"_26170":50214,"_2648":50322},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3150":1718,"_27660":1686,"_19192":50324,"_5":13195,"_26170":50222,"_2648":50325},[],"Decide whether the CA will be a root or an intermediate.",{"_3150":1719,"_27660":1686,"_19192":50327,"_5":13195,"_26170":50222,"_2648":50328},[],"Choose the engine that will keep the key.",{"_3150":1720,"_27660":1686,"_19192":50330,"_5":13195,"_26170":50222,"_2648":50331},[],"Define a validity longer than that of the certificates it will issue.",{"_3150":1721,"_27660":1686,"_19192":50333,"_5":13195,"_26170":50222,"_2648":50334},[],"For an intermediate CA, make sure the parent CA is active.",{"_3150":1722,"_27660":1686,"_19192":50336,"_5":13195,"_26170":50225,"_2648":50337},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3150":1723,"_27660":1686,"_19192":50339,"_5":13195,"_26170":50229,"_2648":50340},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3150":1724,"_27660":1686,"_19192":50342,"_5":13195,"_26170":50229,"_2648":50343},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3150":1725,"_27660":1686,"_19192":50345,"_5":13195,"_26170":50233,"_2648":50346},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3150":1726,"_27660":1686,"_19192":50348,"_5":13195,"_26170":50237,"_2648":50349},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3150":1727,"_27660":1686,"_19192":50351,"_5":13195,"_26170":50237,"_2648":50352},[],"`C`: two-letter ISO 3166-1 country code.",{"_3150":1728,"_27660":1686,"_19192":50354,"_5":13195,"_26170":50237,"_2648":50355},[],"`ST`: state or province.",{"_3150":1729,"_27660":1686,"_19192":50357,"_5":13195,"_26170":50237,"_2648":50358},[],"`L`: locality.",{"_3150":1730,"_27660":1686,"_19192":50360,"_5":13195,"_26170":50237,"_2648":50361},[],"`O`: organization.",{"_3150":1731,"_27660":1686,"_19192":50363,"_5":13195,"_26170":50237,"_2648":50364},[],"`OU`: organizational unit.",{"_3150":1732,"_27660":1686,"_19192":50366,"_5":13195,"_26170":50237,"_2648":50367},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3150":1733,"_27660":1686,"_19192":50369,"_5":13195,"_26170":50241,"_2648":50370},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3150":1734,"_27660":1686,"_19192":50372,"_5":13195,"_26170":50241,"_2648":50373},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3150":1735,"_27660":1686,"_19192":50375,"_5":13195,"_26170":50245,"_2648":50376},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3150":1736,"_27660":1686,"_19192":50378,"_5":13195,"_26170":50245,"_2648":50379},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3150":1737,"_27660":1686,"_19192":50381,"_5":13195,"_26170":50249,"_2648":50382},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3150":1738,"_27660":1686,"_19192":50384,"_5":13195,"_26170":50249,"_2648":50385},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3150":1739,"_27660":1686,"_19192":50387,"_5":13195,"_26170":50253,"_2648":50388},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3150":1740,"_27660":1686,"_19192":50390,"_5":13195,"_26170":50257,"_2648":50391},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3150":1741,"_27660":1686,"_19192":50393,"_5":13195,"_26170":50261,"_2648":50394},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3150":1742,"_27660":1686,"_19192":50396,"_5":13195,"_26170":50265,"_2648":50397},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3150":1743,"_27660":1686,"_19192":50399,"_5":13195,"_26170":50269,"_2648":50400},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3150":1744,"_27660":1686,"_19192":50402,"_5":13195,"_26170":50269,"_2648":50403},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3150":1745,"_27660":1686,"_19192":50405,"_5":13195,"_26170":50273,"_2648":50406},[],"Open a CA from the inventory to review:",{"_3150":1746,"_27660":1686,"_19192":50408,"_5":13195,"_26170":50273,"_2648":50409},[],"Status and validity period.",{"_3150":1747,"_27660":1686,"_19192":50411,"_5":13195,"_26170":50273,"_2648":50412},[],"Certificate and chain in PEM format.",{"_3150":1748,"_27660":1686,"_19192":50414,"_5":13195,"_26170":50273,"_2648":50415},[],"Number of active, expired and revoked certificates.",{"_3150":1749,"_27660":1686,"_19192":50417,"_5":13195,"_26170":50273,"_2648":50418},[],"Certificates issued in **Issued Certificates**.",{"_3150":1750,"_27660":1686,"_19192":50420,"_5":13195,"_26170":50273,"_2648":50421},[],"The CRL linked to the authority.",{"_3150":1751,"_27660":1686,"_19192":50423,"_5":13195,"_26170":50273,"_2648":50424},[],"Metadata and the associated cryptographic engine.",{"_3150":1752,"_27660":1686,"_19192":50426,"_5":13195,"_26170":50273,"_2648":50427},[],"You can filter the inventory by name, status and CA type.",{"_3150":1753,"_27660":1686,"_19192":50429,"_5":13195,"_26170":50277,"_2648":50430},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3150":1754,"_27660":1686,"_19192":50432,"_5":13195,"_26170":50277,"_2648":50433},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3150":1755,"_27660":1686,"_19192":50435,"_5":13195,"_26170":50277,"_2648":50436},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3150":1756,"_27660":1686,"_19192":50438,"_5":13195,"_26170":50277,"_2648":50439},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3150":1757,"_27660":1686,"_19192":50441,"_5":13195,"_26170":50281,"_2648":50442},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3150":1758,"_27660":1686,"_19192":50444,"_5":13195,"_26170":50285,"_2648":50445},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3150":1759,"_27660":1686,"_19192":50447,"_5":13195,"_26170":50289,"_2648":50448},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3150":1760,"_27660":1686,"_19192":50450,"_5":13195,"_26170":50293,"_2648":50451},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3150":1761,"_27660":1686,"_19192":50453,"_5":13195,"_26170":50297,"_2648":50454},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3150":1762,"_27660":1686,"_19192":50456,"_5":13195,"_26170":50297,"_2648":50457},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3150":1763,"_27660":1763,"_5":13521,"_2648":50459,"_28003":50460,"_19192":50461,"_26170":1763},"Certificate profiles",[44970,46350,50046,50047],[],{"_3150":1764,"_27660":1763,"_19192":50463,"_5":13195,"_26170":1763,"_2648":50464},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3150":1765,"_27660":1763,"_5":28000,"_19192":50466,"_26170":50467,"_2648":50468},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3150":1766,"_27660":1763,"_5":28000,"_19192":50470,"_26170":50471,"_2648":50472},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#validity","Validity",{"_3150":1767,"_27660":1763,"_5":28000,"_19192":50474,"_26170":50475,"_2648":50476},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3150":1768,"_27660":1763,"_5":28000,"_19192":50478,"_26170":50479,"_2648":50480},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3150":1769,"_27660":1763,"_5":28000,"_19192":50482,"_26170":50483,"_2648":50484},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#subject","Subject",{"_3150":1770,"_27660":1763,"_5":28000,"_19192":50486,"_26170":50487,"_2648":50488},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3150":1771,"_27660":1763,"_5":28000,"_19192":50490,"_26170":50491,"_2648":50492},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3150":1772,"_27660":1763,"_5":28000,"_19192":50494,"_26170":50495,"_2648":50496},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3150":1773,"_27660":1763,"_5":28000,"_19192":50498,"_26170":50499,"_2648":50500},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3150":1774,"_27660":1763,"_5":28000,"_19192":50502,"_26170":50503,"_2648":50504},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3150":1775,"_27660":1763,"_5":28000,"_19192":50506,"_26170":50507,"_2648":50508},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3150":1776,"_27660":1763,"_5":28000,"_19192":50510,"_26170":50511,"_2648":50512},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3150":1777,"_27660":1763,"_5":28000,"_19192":50514,"_26170":50515,"_2648":50516},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3150":1778,"_27660":1763,"_5":28000,"_19192":50518,"_26170":50519,"_2648":50520},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3150":1779,"_27660":1763,"_5":28000,"_19192":50522,"_26170":50523,"_2648":50524},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#design-examples","Design examples",{"_3150":1780,"_27660":1763,"_5":28000,"_19192":50526,"_26170":50527,"_2648":50528},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3150":1781,"_27660":1763,"_19192":50530,"_5":13195,"_26170":1763,"_2648":50531},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3150":1782,"_27660":1763,"_19192":50533,"_5":13195,"_26170":1763,"_2648":50534},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3150":1783,"_27660":1763,"_19192":50536,"_5":13195,"_26170":50471,"_2648":50537},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3150":1784,"_27660":1763,"_19192":50539,"_5":13195,"_26170":50471,"_2648":50540},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3150":1785,"_27660":1763,"_19192":50542,"_5":13195,"_26170":50475,"_2648":50543},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3150":1786,"_27660":1763,"_19192":50545,"_5":13195,"_26170":50479,"_2648":50546},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3150":1787,"_27660":1763,"_19192":50548,"_5":13195,"_26170":50479,"_2648":50549},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3150":1788,"_27660":1763,"_19192":50551,"_5":13195,"_26170":50479,"_2648":50552},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3150":1789,"_27660":1763,"_19192":50554,"_5":13195,"_26170":50483,"_2648":50555},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3150":1790,"_27660":1763,"_19192":50557,"_5":13195,"_26170":50487,"_2648":50558},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3150":1791,"_27660":1763,"_19192":50560,"_5":13195,"_26170":50487,"_2648":50561},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3150":1792,"_27660":1763,"_19192":50563,"_5":13195,"_26170":50491,"_2648":50564},[],"The cryptographic enforcement can:",{"_3150":1793,"_27660":1763,"_19192":50566,"_5":13195,"_26170":50491,"_2648":50567},[],"allow or block RSA keys;",{"_3150":1794,"_27660":1763,"_19192":50569,"_5":13195,"_26170":50491,"_2648":50570},[],"limit the supported RSA sizes;",{"_3150":1795,"_27660":1763,"_19192":50572,"_5":13195,"_26170":50491,"_2648":50573},[],"allow or block ECDSA keys;",{"_3150":1796,"_27660":1763,"_19192":50575,"_5":13195,"_26170":50491,"_2648":50576},[],"limit the supported ECDSA sizes or curves.",{"_3150":1797,"_27660":1763,"_19192":50578,"_5":13195,"_26170":50491,"_2648":50579},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3150":1798,"_27660":1763,"_19192":50581,"_5":13195,"_26170":50495,"_2648":50582},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3150":1799,"_27660":1763,"_19192":50584,"_5":13195,"_26170":50495,"_2648":48074},[],{"_3150":1800,"_27660":1763,"_19192":50586,"_5":13195,"_26170":50495,"_2648":50587},[],"First choice",{"_3150":1801,"_27660":1763,"_19192":50589,"_5":13195,"_26170":50495,"_2648":50590},[],"Second choice",{"_3150":1802,"_27660":1763,"_19192":50592,"_5":13195,"_26170":50495,"_2648":50593},[],"If neither is supplied",{"_3150":1803,"_27660":1763,"_19192":50595,"_5":13195,"_26170":50495,"_2648":50596},[],"Direct signing with a CA",{"_3150":1804,"_27660":1763,"_19192":50598,"_5":13195,"_26170":50495,"_2648":50599},[],"`issuance_profile` embedded in the request",{"_3150":1805,"_27660":1763,"_19192":50601,"_5":13195,"_26170":50495,"_2648":50602},[],"Request `issuance_profile_id`",{"_3150":1806,"_27660":1763,"_19192":50604,"_5":13195,"_26170":50495,"_2648":50605},[],"CA default profile (`profile_id`).",{"_3150":1807,"_27660":1763,"_19192":50607,"_5":13195,"_26170":50495,"_2648":50608},[],"Issuance through a DMS",{"_3150":1808,"_27660":1763,"_19192":50610,"_5":13195,"_26170":50495,"_2648":50611},[],"`settings.issuance_profile_id`",{"_3150":1809,"_27660":1763,"_19192":50613,"_5":13195,"_26170":50495,"_2648":50614},[],"`settings.issuance_profile` embedded in the DMS",{"_3150":1810,"_27660":1763,"_19192":50616,"_5":13195,"_26170":50495,"_2648":50617},[],"Enrollment CA default profile.",{"_3150":1811,"_27660":1763,"_19192":50619,"_5":13195,"_26170":50495,"_2648":50620},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3150":1812,"_27660":1763,"_19192":50622,"_5":13195,"_26170":50495,"_2648":50623},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3150":1813,"_27660":1763,"_19192":50625,"_5":13195,"_26170":50503,"_2648":50626},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3150":1814,"_27660":1763,"_19192":50628,"_5":13195,"_26170":50507,"_2648":50629},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3150":1815,"_27660":1763,"_19192":50631,"_5":13195,"_26170":50511,"_2648":50632},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3150":1816,"_27660":1763,"_19192":50634,"_5":13195,"_26170":50515,"_2648":50635},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3150":1817,"_27660":1763,"_19192":50637,"_5":13195,"_26170":50519,"_2648":50638},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3150":1818,"_27660":1763,"_19192":50640,"_5":13195,"_26170":50519,"_2648":50641},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3150":1819,"_27660":1763,"_19192":50643,"_5":13195,"_26170":50523,"_2648":50644},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3150":1820,"_27660":1763,"_19192":50646,"_5":13195,"_26170":50523,"_2648":50647},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3150":1821,"_27660":1763,"_19192":50649,"_5":13195,"_26170":50523,"_2648":50650},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3150":1822,"_27660":1763,"_19192":50652,"_5":13195,"_26170":50523,"_2648":50653},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3150":1823,"_27660":1763,"_19192":50655,"_5":13195,"_26170":50527,"_2648":50656},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3150":1824,"_27660":1763,"_19192":50658,"_5":13195,"_26170":50527,"_2648":50659},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3150":1825,"_27660":1825,"_5":13521,"_2648":50661,"_28003":50662,"_19192":50664,"_26170":1825},"Certificate validation",[44970,46350,50046,50663],"Validation",[],{"_3150":1826,"_27660":1825,"_19192":50666,"_5":13195,"_26170":1825,"_2648":50667},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3150":1827,"_27660":1825,"_5":28000,"_19192":50669,"_26170":50670,"_2648":50671},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3150":1828,"_27660":1825,"_5":28000,"_19192":50673,"_26170":50674,"_2648":50675},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3150":1829,"_27660":1825,"_5":28000,"_19192":50677,"_26170":50678,"_2648":50679},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3150":1830,"_27660":1825,"_19192":50681,"_5":13195,"_26170":1825,"_2648":50682},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3150":1831,"_27660":1825,"_19192":50684,"_5":13195,"_26170":50670,"_2648":50685},[],"Verify these criteria together:",{"_3150":1832,"_27660":1825,"_19192":50687,"_5":13195,"_26170":50670,"_2648":49670},[],{"_3150":1833,"_27660":1825,"_19192":50689,"_5":13195,"_26170":50670,"_2648":50690},[],"Required result",{"_3150":1834,"_27660":1825,"_19192":50692,"_5":13195,"_26170":50670,"_2648":50693},[],"Chain and signature",{"_3150":1835,"_27660":1825,"_19192":50695,"_5":13195,"_26170":50670,"_2648":50696},[],"Valid chain to a root deliberately installed in the consumer.",{"_3150":1836,"_27660":1825,"_19192":50698,"_5":13195,"_26170":50670,"_2648":50699},[],"Dates",{"_3150":1837,"_27660":1825,"_19192":50701,"_5":13195,"_26170":50670,"_2648":50702},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3150":1838,"_27660":1825,"_19192":50704,"_5":13195,"_26170":50670,"_2648":46050},[],{"_3150":1839,"_27660":1825,"_19192":50706,"_5":13195,"_26170":50670,"_2648":50707},[],"Name, SAN or identifier matches the expected peer.",{"_3150":1840,"_27660":1825,"_19192":50709,"_5":13195,"_26170":50670,"_2648":45360},[],{"_3150":1841,"_27660":1825,"_19192":50711,"_5":13195,"_26170":50670,"_2648":50712},[],"KU, EKU and constraints permit the specific operation.",{"_3150":1842,"_27660":1825,"_19192":50714,"_5":13195,"_26170":50670,"_2648":50715},[],"Revocation",{"_3150":1843,"_27660":1825,"_19192":50717,"_5":13195,"_26170":50670,"_2648":50718},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3150":1844,"_27660":1825,"_19192":50720,"_5":13195,"_26170":50670,"_2648":50721},[],"Authorization",{"_3150":1845,"_27660":1825,"_19192":50723,"_5":13195,"_26170":50670,"_2648":50724},[],"The application permits that identity to perform the action.",{"_3150":1846,"_27660":1825,"_19192":50726,"_5":13195,"_26170":50670,"_2648":50727},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3150":1847,"_27660":1825,"_19192":50729,"_5":13195,"_26170":50674,"_2648":50730},[],"Mechanism",{"_3150":1848,"_27660":1825,"_19192":50732,"_5":13195,"_26170":50674,"_2648":50733},[],"When to use it",{"_3150":1849,"_27660":1825,"_19192":50735,"_5":13195,"_26170":50674,"_2648":50736},[],"What you must maintain",{"_3150":1850,"_27660":1825,"_19192":50738,"_5":13195,"_26170":50674,"_2648":50739},[],"OCSP",{"_3150":1851,"_27660":1825,"_19192":50741,"_5":13195,"_26170":50674,"_2648":50742},[],"Status query for a specific certificate.",{"_3150":1852,"_27660":1825,"_19192":50744,"_5":13195,"_26170":50674,"_2648":50745},[],"Responder access, signature verification and cache/freshness policy.",{"_3150":1853,"_27660":1825,"_19192":50747,"_5":13195,"_26170":50674,"_2648":50748},[],"CRL",{"_3150":1854,"_27660":1825,"_19192":50750,"_5":13195,"_26170":50674,"_2648":50751},[],"Local checks for many certificates or offline operation.",{"_3150":1855,"_27660":1825,"_19192":50753,"_5":13195,"_26170":50674,"_2648":50754},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3150":1856,"_27660":1825,"_19192":50756,"_5":13195,"_26170":50674,"_2648":50757},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3150":1857,"_27660":1825,"_19192":50759,"_5":13195,"_26170":50674,"_2648":50760},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3150":1858,"_27660":1825,"_19192":50762,"_5":13195,"_26170":50678,"_2648":50763},[],"Accept a current, authorized certificate with a known chain.",{"_3150":1859,"_27660":1825,"_19192":50765,"_5":13195,"_26170":50678,"_2648":50766},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3150":1860,"_27660":1825,"_19192":50768,"_5":13195,"_26170":50678,"_2648":50769},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3150":1861,"_27660":1825,"_19192":50771,"_5":13195,"_26170":50678,"_2648":50772},[],"Check that a new connection with that identity is rejected.",{"_3150":1862,"_27660":1825,"_19192":50774,"_5":13195,"_26170":50678,"_2648":50775},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3150":1863,"_27660":1825,"_19192":50777,"_5":13195,"_26170":50678,"_2648":50778},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3150":1864,"_27660":1825,"_19192":50780,"_5":13195,"_26170":50678,"_2648":50781},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3150":1865,"_27660":1825,"_19192":50783,"_5":13195,"_26170":50678,"_2648":50784},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":1866,"_27660":1825,"_19192":50786,"_5":13195,"_26170":50678,"_2648":50787},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3150":1867,"_27660":1867,"_5":13521,"_2648":50789,"_28003":50790,"_19192":50791,"_26170":1867},"Certificates",[44970,46350,50046,50047],[],{"_3150":1868,"_27660":1867,"_19192":50793,"_5":13195,"_26170":1867,"_2648":50794},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3150":1869,"_27660":1867,"_5":28000,"_19192":50796,"_26170":50797,"_2648":50798},[],"/docs/pr-preview/pr-26/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3150":1870,"_27660":1867,"_5":28000,"_19192":50800,"_26170":50801,"_2648":50802},[],"/docs/pr-preview/pr-26/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3150":1871,"_27660":1867,"_5":28000,"_19192":50804,"_26170":50805,"_2648":50806},[],"/docs/pr-preview/pr-26/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3150":1872,"_27660":1867,"_5":28000,"_19192":50808,"_26170":50809,"_2648":50810},[],"/docs/pr-preview/pr-26/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3150":1873,"_27660":1867,"_5":28000,"_19192":50812,"_26170":50813,"_2648":50814},[],"/docs/pr-preview/pr-26/platform/pki/certificates#open-the-action","Open the action",{"_3150":1874,"_27660":1867,"_5":28000,"_19192":50816,"_26170":50817,"_2648":50818},[],"/docs/pr-preview/pr-26/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3150":1875,"_27660":1867,"_5":28000,"_19192":50820,"_26170":50821,"_2648":50822},[],"/docs/pr-preview/pr-26/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3150":1876,"_27660":1867,"_5":28000,"_19192":50824,"_26170":50825,"_2648":50826},[],"/docs/pr-preview/pr-26/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3150":1877,"_27660":1867,"_5":28000,"_19192":50828,"_26170":50829,"_2648":50830},[],"/docs/pr-preview/pr-26/platform/pki/certificates#continue","Continue",{"_3150":1878,"_27660":1867,"_19192":50832,"_5":13195,"_26170":1867,"_2648":50833},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3150":1879,"_27660":1867,"_19192":50835,"_5":13195,"_26170":50797,"_2648":50836},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3150":1880,"_27660":1867,"_19192":50838,"_5":13195,"_26170":50797,"_2648":50839},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3150":1881,"_27660":1867,"_19192":50841,"_5":13195,"_26170":50801,"_2648":50842},[],"Download the PEM and inspect it:",{"_3150":1882,"_27660":1867,"_19192":50844,"_5":13195,"_26170":50801,"_2648":50845},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3150":1883,"_27660":1867,"_19192":50847,"_5":13195,"_26170":50805,"_2648":50848},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3150":1884,"_27660":1867,"_19192":50850,"_5":13195,"_26170":50805,"_2648":50851},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3150":1885,"_27660":1867,"_19192":50853,"_5":13195,"_26170":50805,"_2648":50854},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3150":1886,"_27660":1867,"_19192":50856,"_5":13195,"_26170":50805,"_2648":50857},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3150":1887,"_27660":1867,"_19192":50859,"_5":13195,"_26170":50805,"_2648":50860},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3150":1888,"_27660":1867,"_19192":50862,"_5":13195,"_26170":50805,"_2648":50863},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3150":1889,"_27660":1867,"_19192":50865,"_5":13195,"_26170":50805,"_2648":50866},[],"For browser key generation, follow Issue your first certificate.",{"_3150":1890,"_27660":1867,"_19192":50868,"_5":13195,"_26170":50809,"_2648":50869},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3150":1891,"_27660":1867,"_19192":50871,"_5":13195,"_26170":50813,"_2648":50872},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3150":1892,"_27660":1867,"_19192":50874,"_5":13195,"_26170":50817,"_2648":50875},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3150":1893,"_27660":1867,"_19192":50877,"_5":13195,"_26170":50821,"_2648":50878},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3150":1894,"_27660":1867,"_19192":50880,"_5":13195,"_26170":50821,"_2648":50881},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3150":1895,"_27660":1867,"_19192":50883,"_5":13195,"_26170":50821,"_2648":50884},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3150":1896,"_27660":1867,"_19192":50886,"_5":13195,"_26170":50825,"_2648":50887},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3150":1897,"_27660":1867,"_19192":50889,"_5":13195,"_26170":50825,"_2648":50890},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3150":1898,"_27660":1867,"_19192":50892,"_5":13195,"_26170":50825,"_2648":50893},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3150":1899,"_27660":1867,"_19192":50895,"_5":13195,"_26170":50829,"_2648":50896},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":1900,"_27660":1867,"_19192":50898,"_5":13195,"_26170":50829,"_2648":50899},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3150":1901,"_27660":1901,"_5":13521,"_2648":50901,"_28003":50902,"_19192":50904,"_26170":1901},"Certificate lifecycle",[44970,46350,50046,50903],"Concepts",[],{"_3150":1902,"_27660":1901,"_19192":50906,"_5":13195,"_26170":1901,"_2648":50907},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3150":1903,"_27660":1901,"_5":28000,"_19192":50909,"_26170":50910,"_2648":50911},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3150":1904,"_27660":1901,"_5":28000,"_19192":50913,"_26170":50914,"_2648":50915},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3150":1905,"_27660":1901,"_5":28000,"_19192":50917,"_26170":50918,"_2648":50919},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3150":1906,"_27660":1901,"_5":28000,"_19192":50921,"_26170":50922,"_2648":50923},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3150":1907,"_27660":1901,"_5":28000,"_19192":50925,"_26170":50926,"_2648":50927},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3150":1908,"_27660":1901,"_5":28000,"_19192":50929,"_26170":50930,"_2648":50931},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3150":1909,"_27660":1901,"_5":28000,"_19192":50933,"_26170":50934,"_2648":50935},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3150":1910,"_27660":1901,"_5":28000,"_19192":50937,"_26170":50938,"_2648":50939},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3150":1911,"_27660":1901,"_5":28000,"_19192":50941,"_26170":50942,"_2648":50943},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3150":1912,"_27660":1901,"_5":28000,"_19192":50945,"_26170":50946,"_2648":50947},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3150":1913,"_27660":1901,"_19192":50949,"_5":13195,"_26170":1901,"_2648":50950},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3150":1914,"_27660":1901,"_19192":50952,"_5":13195,"_26170":50914,"_2648":50953},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3150":1915,"_27660":1901,"_19192":50955,"_5":13195,"_26170":50918,"_2648":50956},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3150":1916,"_27660":1901,"_19192":50958,"_5":13195,"_26170":50922,"_2648":50959},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3150":1917,"_27660":1901,"_19192":50961,"_5":13195,"_26170":50926,"_2648":50962},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3150":1918,"_27660":1901,"_19192":50964,"_5":13195,"_26170":50930,"_2648":50965},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3150":1919,"_27660":1901,"_19192":50967,"_5":13195,"_26170":50934,"_2648":50968},[],"Lamassu persists four X.509 states:",{"_3150":1920,"_27660":1901,"_19192":50970,"_5":13195,"_26170":50934,"_2648":50971},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3150":1921,"_27660":1901,"_19192":50973,"_5":13195,"_26170":50934,"_2648":50974},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3150":1922,"_27660":1901,"_19192":50976,"_5":13195,"_26170":50934,"_2648":50977},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3150":1923,"_27660":1901,"_19192":50979,"_5":13195,"_26170":50934,"_2648":50980},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3150":1924,"_27660":1901,"_19192":50982,"_5":13195,"_26170":50934,"_2648":50983},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3150":1925,"_27660":1901,"_19192":50985,"_5":13195,"_26170":50938,"_2648":50986},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3150":1926,"_27660":1901,"_19192":50988,"_5":13195,"_26170":50938,"_2648":50989},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3150":1927,"_27660":1901,"_19192":50991,"_5":13195,"_26170":50938,"_2648":50992},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3150":1928,"_27660":1901,"_19192":50994,"_5":13195,"_26170":50942,"_2648":50995},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3150":1929,"_27660":1901,"_19192":50997,"_5":13195,"_26170":50942,"_2648":50998},[],"Before confirming:",{"_3150":1930,"_27660":1901,"_19192":51000,"_5":13195,"_26170":50942,"_2648":51001},[],"Identify DMSs, devices and services that trust that chain.",{"_3150":1931,"_27660":1901,"_19192":51003,"_5":13195,"_26170":50942,"_2648":51004},[],"Distribute the new chain of trust.",{"_3150":1932,"_27660":1901,"_19192":51006,"_5":13195,"_26170":50942,"_2648":51007},[],"Reissue the necessary identities.",{"_3150":1933,"_27660":1901,"_19192":51009,"_5":13195,"_26170":50942,"_2648":51010},[],"Check OCSP and CRL from a real consumer.",{"_3150":1934,"_27660":1901,"_19192":51012,"_5":13195,"_26170":50942,"_2648":51013},[],"Revoke the old CA once no legitimate traffic remains.",{"_3150":1935,"_27660":1901,"_19192":51015,"_5":13195,"_26170":50942,"_2648":51016},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3150":1936,"_27660":1901,"_19192":51018,"_5":13195,"_26170":50946,"_2648":51019},[],"Certificates entering the preventive or critical renewal window.",{"_3150":1937,"_27660":1901,"_19192":51021,"_5":13195,"_26170":50946,"_2648":51022},[],"Repeated enrollment or re-enrollment failures.",{"_3150":1938,"_27660":1901,"_19192":51024,"_5":13195,"_26170":50946,"_2648":51025},[],"Status changes and revocation reasons.",{"_3150":1939,"_27660":1901,"_19192":51027,"_5":13195,"_26170":50946,"_2648":51028},[],"OCSP and CRL publication and validity.",{"_3150":1940,"_27660":1901,"_19192":51030,"_5":13195,"_26170":50946,"_2648":51031},[],"Dependencies still presenting a replaced certificate.",{"_3150":1941,"_27660":1901,"_19192":51033,"_5":13195,"_26170":50946,"_2648":51034},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3150":1942,"_27660":1942,"_5":13521,"_2648":51036,"_28003":51037,"_19192":51038,"_26170":1942},"Trust model",[44970,46350,50046,50903],[],{"_3150":1943,"_27660":1942,"_19192":51040,"_5":13195,"_26170":1942,"_2648":51041},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3150":1944,"_27660":1942,"_5":28000,"_19192":51043,"_26170":51044,"_2648":51045},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3150":1945,"_27660":1942,"_5":28000,"_19192":51047,"_26170":51048,"_2648":51049},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3150":1946,"_27660":1942,"_5":28000,"_19192":51051,"_26170":51052,"_2648":51053},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3150":1947,"_27660":1942,"_5":28000,"_19192":51055,"_26170":51056,"_2648":51057},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3150":1948,"_27660":1942,"_5":28000,"_19192":51059,"_26170":51060,"_2648":51061},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3150":1949,"_27660":1942,"_5":28000,"_19192":51063,"_26170":51064,"_2648":51065},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3150":1950,"_27660":1942,"_5":28000,"_19192":51067,"_26170":51068,"_2648":51069},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3150":1951,"_27660":1942,"_5":28000,"_19192":51071,"_26170":51072,"_2648":51073},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3150":1952,"_27660":1942,"_5":28000,"_19192":51075,"_26170":51076,"_2648":51077},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3150":1953,"_27660":1942,"_5":28000,"_19192":51079,"_26170":51080,"_2648":51081},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3150":1954,"_27660":1942,"_19192":51083,"_5":13195,"_26170":1942,"_2648":51084},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3150":1955,"_27660":1942,"_19192":51086,"_5":13195,"_26170":51048,"_2648":51087},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3150":1956,"_27660":1942,"_19192":51089,"_5":13195,"_26170":51052,"_2648":51090},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3150":1957,"_27660":1942,"_19192":51092,"_5":13195,"_26170":51056,"_2648":51093},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3150":1958,"_27660":1942,"_19192":51095,"_5":13195,"_26170":51060,"_2648":51096},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3150":1959,"_27660":1942,"_19192":51098,"_5":13195,"_26170":51064,"_2648":51099},[],"The device proves it can enroll according to the DMS policy.",{"_3150":1960,"_27660":1942,"_19192":51101,"_5":13195,"_26170":51064,"_2648":51102},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3150":1961,"_27660":1942,"_19192":51104,"_5":13195,"_26170":51064,"_2648":51105},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3150":1962,"_27660":1942,"_19192":51107,"_5":13195,"_26170":51064,"_2648":51108},[],"The device installs the certificate and the chain it needs.",{"_3150":1963,"_27660":1942,"_19192":51110,"_5":13195,"_26170":51064,"_2648":51111},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3150":1964,"_27660":1942,"_19192":51113,"_5":13195,"_26170":51064,"_2648":51114},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3150":1965,"_27660":1942,"_19192":51116,"_5":13195,"_26170":51068,"_2648":51117},[],"A DMS relates three sets that are worth designing separately:",{"_3150":1966,"_27660":1942,"_19192":51119,"_5":13195,"_26170":51068,"_2648":51120},[],"**Enrollment CA:** signs the new identities.",{"_3150":1967,"_27660":1942,"_19192":51122,"_5":13195,"_26170":51068,"_2648":51123},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_3150":1968,"_27660":1942,"_19192":51125,"_5":13195,"_26170":51068,"_2648":51126},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3150":1969,"_27660":1942,"_19192":51128,"_5":13195,"_26170":51068,"_2648":51129},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3150":1970,"_27660":1942,"_19192":51131,"_5":13195,"_26170":51072,"_2648":51132},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3150":1971,"_27660":1942,"_19192":51134,"_5":13195,"_26170":51072,"_2648":51135},[],"that the current date is between `Not Before` and `Not After`;",{"_3150":1972,"_27660":1942,"_19192":51137,"_5":13195,"_26170":51072,"_2648":51138},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3150":1973,"_27660":1942,"_19192":51140,"_5":13195,"_26170":51072,"_2648":51141},[],"that names, SANs and subject match the expected identity;",{"_3150":1974,"_27660":1942,"_19192":51143,"_5":13195,"_26170":51072,"_2648":51144},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3150":1975,"_27660":1942,"_19192":51146,"_5":13195,"_26170":51072,"_2648":51147},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3150":1976,"_27660":1942,"_19192":51149,"_5":13195,"_26170":51072,"_2648":51150},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3150":1977,"_27660":1942,"_19192":51152,"_5":13195,"_26170":51076,"_2648":51153},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3150":1978,"_27660":1942,"_19192":51155,"_5":13195,"_26170":51080,"_2648":51156},[],"Keep the root out of daily operations, or with very restricted access.",{"_3150":1979,"_27660":1942,"_19192":51158,"_5":13195,"_26170":51080,"_2648":51159},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3150":1980,"_27660":1942,"_19192":51161,"_5":13195,"_26170":51080,"_2648":51162},[],"Assign explicit profiles to every use case.",{"_3150":1981,"_27660":1942,"_19192":51164,"_5":13195,"_26170":51080,"_2648":51165},[],"Distribute the new trust before starting a rotation.",{"_3150":1982,"_27660":1942,"_19192":51167,"_5":13195,"_26170":51080,"_2648":51168},[],"Keep enough overlap to renew a disconnected fleet.",{"_3150":1983,"_27660":1942,"_19192":51170,"_5":13195,"_26170":51080,"_2648":51171},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3150":1984,"_27660":1942,"_19192":51173,"_5":13195,"_26170":51080,"_2648":51174},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3150":1985,"_27660":1985,"_5":13521,"_2648":51176,"_28003":51177,"_19192":51178,"_26170":1985},"Revocation lists (CRL)",[44970,46350,50046,50663],[],{"_3150":1986,"_27660":1985,"_19192":51180,"_5":13195,"_26170":1985,"_2648":51181},[],"Generate and distribute signed lists to validate certificates offline.",{"_3150":1987,"_27660":1985,"_5":28000,"_19192":51183,"_26170":51184,"_2648":51185},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3150":1988,"_27660":1985,"_5":28000,"_19192":51187,"_26170":51188,"_2648":51189},[],"/docs/pr-preview/pr-26/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3150":1989,"_27660":1985,"_5":28000,"_19192":51191,"_26170":51192,"_2648":51193},[],"/docs/pr-preview/pr-26/platform/pki/crl#crl-contents","CRL contents",{"_3150":1990,"_27660":1985,"_5":28000,"_19192":51195,"_26170":51196,"_2648":51197},[],"/docs/pr-preview/pr-26/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3150":1991,"_27660":1985,"_5":28000,"_19192":51199,"_26170":51200,"_2648":51201},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-management-api","VA role management API",{"_3150":1992,"_27660":1985,"_5":28000,"_19192":51203,"_26170":51204,"_2648":51205},[],"/docs/pr-preview/pr-26/platform/pki/crl#from-the-interface","From the interface",{"_3150":1993,"_27660":1985,"_5":28000,"_19192":51207,"_26170":51208,"_2648":51209},[],"/docs/pr-preview/pr-26/platform/pki/crl#references","References",{"_3150":1994,"_27660":1985,"_19192":51211,"_5":13195,"_26170":1985,"_2648":51212},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3150":1995,"_27660":1985,"_19192":51214,"_5":13195,"_26170":51184,"_2648":51215},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3150":1996,"_27660":1985,"_19192":51217,"_5":13195,"_26170":51184,"_2648":51218},[],"`crl_options` field",{"_3150":1997,"_27660":1985,"_19192":51220,"_5":13195,"_26170":51184,"_2648":45360},[],{"_3150":1998,"_27660":1985,"_19192":51222,"_5":13195,"_26170":51184,"_2648":51223},[],"Backend initial value",{"_3150":1999,"_27660":1985,"_19192":51225,"_5":13195,"_26170":51184,"_2648":51226},[],"`validity`",{"_3150":2000,"_27660":1985,"_19192":51228,"_5":13195,"_26170":51184,"_2648":51229},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3150":2001,"_27660":1985,"_19192":51231,"_5":13195,"_26170":51184,"_2648":51232},[],"7 days.",{"_3150":2002,"_27660":1985,"_19192":51234,"_5":13195,"_26170":51184,"_2648":51235},[],"`refresh_interval`",{"_3150":2003,"_27660":1985,"_19192":51237,"_5":13195,"_26170":51184,"_2648":51238},[],"Time since publication that triggers scheduled renewal.",{"_3150":2004,"_27660":1985,"_19192":51240,"_5":13195,"_26170":51184,"_2648":51241},[],"6 days and 23 hours.",{"_3150":2005,"_27660":1985,"_19192":51243,"_5":13195,"_26170":51184,"_2648":51244},[],"`regenerate_on_revoke`",{"_3150":2006,"_27660":1985,"_19192":51246,"_5":13195,"_26170":51184,"_2648":51247},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3150":2007,"_27660":1985,"_19192":51249,"_5":13195,"_26170":51184,"_2648":51250},[],"`true`.",{"_3150":2008,"_27660":1985,"_19192":51252,"_5":13195,"_26170":51184,"_2648":51253},[],"`subject_key_id_signer`",{"_3150":2009,"_27660":1985,"_19192":51255,"_5":13195,"_26170":51184,"_2648":51256},[],"Configuration field initialized with the CA’s SKI.",{"_3150":2010,"_27660":1985,"_19192":51258,"_5":13195,"_26170":51184,"_2648":51259},[],"CA SKI.",{"_3150":2011,"_27660":1985,"_19192":51261,"_5":13195,"_26170":51184,"_2648":51262},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3150":2012,"_27660":1985,"_19192":51264,"_5":13195,"_26170":51184,"_2648":51265},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3150":2013,"_27660":1985,"_19192":51267,"_5":13195,"_26170":51188,"_2648":51268},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3150":2014,"_27660":1985,"_19192":51270,"_5":13195,"_26170":51188,"_2648":51271},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3150":2015,"_27660":1985,"_19192":51273,"_5":13195,"_26170":51188,"_2648":51274},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3150":2016,"_27660":1985,"_19192":51276,"_5":13195,"_26170":51192,"_2648":51277},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3150":2017,"_27660":1985,"_19192":51279,"_5":13195,"_26170":51192,"_2648":51280},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3150":2018,"_27660":1985,"_19192":51282,"_5":13195,"_26170":51196,"_2648":51283},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3150":2019,"_27660":1985,"_19192":51285,"_5":13195,"_26170":51196,"_2648":51286},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3150":2020,"_27660":1985,"_19192":51288,"_5":13195,"_26170":51196,"_2648":51289},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3150":2021,"_27660":1985,"_19192":51291,"_5":13195,"_26170":51196,"_2648":51292},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3150":2022,"_27660":1985,"_19192":51294,"_5":13195,"_26170":51196,"_2648":51295},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3150":2023,"_27660":1985,"_19192":51297,"_5":13195,"_26170":51200,"_2648":51298},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3150":2024,"_27660":1985,"_19192":51300,"_5":13195,"_26170":51200,"_2648":48077},[],{"_3150":2025,"_27660":1985,"_19192":51302,"_5":13195,"_26170":51200,"_2648":51303},[],"Relative path",{"_3150":2026,"_27660":1985,"_19192":51305,"_5":13195,"_26170":51200,"_2648":48074},[],{"_3150":2027,"_27660":1985,"_19192":51307,"_5":13195,"_26170":51200,"_2648":51308},[],"`GET`",{"_3150":2028,"_27660":1985,"_19192":51310,"_5":13195,"_26170":51200,"_2648":51311},[],"`/v1/roles/{ca-ski}`",{"_3150":2029,"_27660":1985,"_19192":51313,"_5":13195,"_26170":51200,"_2648":51314},[],"Read `crl_options` and `latest_crl`.",{"_3150":2030,"_27660":1985,"_19192":51316,"_5":13195,"_26170":51200,"_2648":51317},[],"`PUT`",{"_3150":2031,"_27660":1985,"_19192":51319,"_5":13195,"_26170":51200,"_2648":51311},[],{"_3150":2032,"_27660":1985,"_19192":51321,"_5":13195,"_26170":51200,"_2648":51322},[],"Replace CRL configuration.",{"_3150":2033,"_27660":1985,"_19192":51324,"_5":13195,"_26170":51200,"_2648":51325},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3150":2034,"_27660":1985,"_19192":51327,"_5":13195,"_26170":51200,"_2648":51328},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3150":2035,"_27660":1985,"_19192":51330,"_5":13195,"_26170":51204,"_2648":51331},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3150":2036,"_27660":1985,"_19192":51333,"_5":13195,"_26170":51208,"_2648":51334},[],"RFC 5280: X.509 and CRL profile.",{"_3150":2037,"_27660":1985,"_19192":51336,"_5":13195,"_26170":51208,"_2648":51337},[],"OpenSSL: openssl-crl.",{"_3150":2038,"_27660":1985,"_19192":51339,"_5":13195,"_26170":51208,"_2648":51340},[],"OpenSSL: openssl-verify.",{"_3150":2039,"_27660":1985,"_19192":51342,"_5":13195,"_26170":51208,"_2648":51343},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":2040,"_27660":1985,"_19192":51345,"_5":13195,"_26170":51208,"_2648":51346},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3150":2041,"_27660":2041,"_5":13521,"_2648":51348,"_28003":51349,"_19192":51350,"_26170":2041},"Keys and cryptographic engines",[44970,46350,50046,50047],[],{"_3150":2042,"_27660":2041,"_19192":51352,"_5":13195,"_26170":2041,"_2648":51353},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3150":2043,"_27660":2041,"_5":28000,"_19192":51355,"_26170":51356,"_2648":51357},[],"/docs/pr-preview/pr-26/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3150":2044,"_27660":2041,"_5":28000,"_19192":51359,"_26170":51360,"_2648":51361},[],"/docs/pr-preview/pr-26/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3150":2045,"_27660":2041,"_5":28000,"_19192":51363,"_26170":51364,"_2648":51365},[],"/docs/pr-preview/pr-26/platform/pki/key-management#file-system","File System",{"_3150":2046,"_27660":2041,"_5":28000,"_19192":51367,"_26170":51368,"_2648":51369},[],"/docs/pr-preview/pr-26/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3150":2047,"_27660":2041,"_5":28000,"_19192":51371,"_26170":51372,"_2648":51373},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3150":2048,"_27660":2041,"_5":28000,"_19192":51375,"_26170":51376,"_2648":51377},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-kms","AWS KMS",{"_3150":2049,"_27660":2041,"_5":28000,"_19192":51379,"_26170":51380,"_2648":51381},[],"/docs/pr-preview/pr-26/platform/pki/key-management#pkcs11","PKCS#11",{"_3150":2050,"_27660":2041,"_5":28000,"_19192":51383,"_26170":51384,"_2648":51385},[],"/docs/pr-preview/pr-26/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3150":2051,"_27660":2041,"_5":28000,"_19192":51387,"_26170":51388,"_2648":51389},[],"/docs/pr-preview/pr-26/platform/pki/key-management#key-inventory","Key inventory",{"_3150":2052,"_27660":2041,"_5":28000,"_19192":51391,"_26170":51392,"_2648":51393},[],"/docs/pr-preview/pr-26/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3150":2053,"_27660":2041,"_5":28000,"_19192":51395,"_26170":51396,"_2648":51397},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3150":2054,"_27660":2041,"_5":28000,"_19192":51399,"_26170":51400,"_2648":51401},[],"/docs/pr-preview/pr-26/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3150":2055,"_27660":2041,"_5":28000,"_19192":51403,"_26170":51404,"_2648":51405},[],"/docs/pr-preview/pr-26/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3150":2056,"_27660":2041,"_5":28000,"_19192":51407,"_26170":51408,"_2648":51409},[],"/docs/pr-preview/pr-26/platform/pki/key-management#view-details","View details",{"_3150":2057,"_27660":2041,"_5":28000,"_19192":51411,"_26170":51412,"_2648":51413},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3150":2058,"_27660":2041,"_5":28000,"_19192":51415,"_26170":51416,"_2648":51417},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign","Sign",{"_3150":2059,"_27660":2041,"_5":28000,"_19192":51419,"_26170":51420,"_2648":51421},[],"/docs/pr-preview/pr-26/platform/pki/key-management#verify","Verify",{"_3150":2060,"_27660":2041,"_5":28000,"_19192":51423,"_26170":51424,"_2648":51425},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3150":2061,"_27660":2041,"_5":28000,"_19192":51427,"_26170":51428,"_2648":51429},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3150":2062,"_27660":2041,"_5":28000,"_19192":51431,"_26170":51432,"_2648":51433},[],"/docs/pr-preview/pr-26/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3150":2063,"_27660":2041,"_19192":51435,"_5":13195,"_26170":2041,"_2648":51436},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3150":2064,"_27660":2041,"_19192":51438,"_5":13195,"_26170":2041,"_2648":51439},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3150":2065,"_27660":2041,"_19192":51441,"_5":13195,"_26170":51356,"_2648":51442},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3150":2066,"_27660":2041,"_19192":51444,"_5":13195,"_26170":51356,"_2648":51445},[],"In practice, it lets you:",{"_3150":2067,"_27660":2041,"_19192":51447,"_5":13195,"_26170":51356,"_2648":51448},[],"Generate new key pairs from Lamassu IoT.",{"_3150":2068,"_27660":2041,"_19192":51450,"_5":13195,"_26170":51356,"_2648":51451},[],"Import keys created externally.",{"_3150":2069,"_27660":2041,"_19192":51453,"_5":13195,"_26170":51356,"_2648":51454},[],"Delegate custody and cryptographic operations to external engines.",{"_3150":2070,"_27660":2041,"_19192":51456,"_5":13195,"_26170":51356,"_2648":51457},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3150":2071,"_27660":2041,"_19192":51459,"_5":13195,"_26170":51360,"_2648":51460},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3150":2072,"_27660":2041,"_19192":51462,"_5":13195,"_26170":51360,"_2648":51463},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3150":2073,"_27660":2041,"_19192":51465,"_5":13195,"_26170":51360,"_2648":51466},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3150":2074,"_27660":2041,"_19192":51468,"_5":13195,"_26170":51364,"_2648":51469},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3150":2075,"_27660":2041,"_19192":51471,"_5":13195,"_26170":51368,"_2648":51472},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3150":2076,"_27660":2041,"_19192":51474,"_5":13195,"_26170":51372,"_2648":51475},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3150":2077,"_27660":2041,"_19192":51477,"_5":13195,"_26170":51376,"_2648":51478},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3150":2078,"_27660":2041,"_19192":51480,"_5":13195,"_26170":51380,"_2648":51481},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3150":2079,"_27660":2041,"_19192":51483,"_5":13195,"_26170":51384,"_2648":51484},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3150":2080,"_27660":2041,"_19192":51486,"_5":13195,"_26170":51384,"_2648":51487},[],"Lamassu shows the enabled engines in the console.",{"_3150":2081,"_27660":2041,"_19192":51489,"_5":13195,"_26170":51384,"_2648":51490},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3150":2082,"_27660":2041,"_19192":51492,"_5":13195,"_26170":51384,"_2648":51493},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3150":2083,"_27660":2041,"_19192":51495,"_5":13195,"_26170":51388,"_2648":51496},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3150":2084,"_27660":2041,"_19192":51498,"_5":13195,"_26170":51388,"_2648":51499},[],"The table includes the following fields:",{"_3150":2085,"_27660":2041,"_19192":51501,"_5":13195,"_26170":51388,"_2648":51502},[],"**Name**: descriptive name of the key.",{"_3150":2086,"_27660":2041,"_19192":51504,"_5":13195,"_26170":51388,"_2648":51505},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3150":2087,"_27660":2041,"_19192":51507,"_5":13195,"_26170":51388,"_2648":51508},[],"**Strength**: visual indicator of cryptographic strength.",{"_3150":2088,"_27660":2041,"_19192":51510,"_5":13195,"_26170":51388,"_2648":51511},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3150":2089,"_27660":2041,"_19192":51513,"_5":13195,"_26170":51388,"_2648":51514},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3150":2090,"_27660":2041,"_19192":51516,"_5":13195,"_26170":51388,"_2648":51517},[],"**Aliases**: alternative names associated with the key.",{"_3150":2091,"_27660":2041,"_19192":51519,"_5":13195,"_26170":51388,"_2648":51520},[],"**Tags**: labels for classification and search.",{"_3150":2092,"_27660":2041,"_19192":51522,"_5":13195,"_26170":51388,"_2648":51523},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3150":2093,"_27660":2041,"_19192":51525,"_5":13195,"_26170":51388,"_2648":51526},[],"From this view you also reach the most common actions:",{"_3150":2094,"_27660":2041,"_19192":51528,"_5":13195,"_26170":51388,"_2648":51529},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3150":2095,"_27660":2041,"_19192":51531,"_5":13195,"_26170":51388,"_2648":51532},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3150":2096,"_27660":2041,"_19192":51534,"_5":13195,"_26170":51388,"_2648":51535},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3150":2097,"_27660":2041,"_19192":51537,"_5":13195,"_26170":51388,"_2648":51538},[],"**Delete Key** to remove the key from the system.",{"_3150":2098,"_27660":2041,"_19192":51540,"_5":13195,"_26170":51392,"_2648":51541},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3150":2099,"_27660":2041,"_19192":51543,"_5":13195,"_26170":51396,"_2648":51544},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3150":2100,"_27660":2041,"_19192":51546,"_5":13195,"_26170":51396,"_2648":51547},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3150":2101,"_27660":2041,"_19192":51549,"_5":13195,"_26170":51396,"_2648":51550},[],"**Key Name**: unique and descriptive name.",{"_3150":2102,"_27660":2041,"_19192":51552,"_5":13195,"_26170":51396,"_2648":51553},[],"**Crypto Engine**: engine that will keep the key.",{"_3150":2103,"_27660":2041,"_19192":51555,"_5":13195,"_26170":51396,"_2648":51556},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3150":2104,"_27660":2041,"_19192":51558,"_5":13195,"_26170":51396,"_2648":51559},[],"**Tags**: metadata to classify the key.",{"_3150":2105,"_27660":2041,"_19192":51561,"_5":13195,"_26170":51396,"_2648":51562},[],"**Metadata**: additional information for advanced uses.",{"_3150":2106,"_27660":2041,"_19192":51564,"_5":13195,"_26170":51400,"_2648":51565},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3150":2107,"_27660":2041,"_19192":51567,"_5":13195,"_26170":51400,"_2648":51568},[],"When you have an exportable private key and the destination engine supports import.",{"_3150":2108,"_27660":2041,"_19192":51570,"_5":13195,"_26170":51400,"_2648":51571},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3150":2109,"_27660":2041,"_19192":51573,"_5":13195,"_26170":51400,"_2648":51574},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3150":2110,"_27660":2041,"_19192":51576,"_5":13195,"_26170":51400,"_2648":51577},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3150":2111,"_27660":2041,"_19192":51579,"_5":13195,"_26170":51400,"_2648":51580},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3150":2112,"_27660":2041,"_19192":51582,"_5":13195,"_26170":51400,"_2648":51583},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3150":2113,"_27660":2041,"_19192":51585,"_5":13195,"_26170":51400,"_2648":51586},[],"**Tags**: labels for organization and search.",{"_3150":2114,"_27660":2041,"_19192":51588,"_5":13195,"_26170":51400,"_2648":51589},[],"**Metadata**: additional optional information.",{"_3150":2115,"_27660":2041,"_19192":51591,"_5":13195,"_26170":51400,"_2648":51592},[],"**Private Key (PEM)**: private key in PEM format.",{"_3150":2116,"_27660":2041,"_19192":51594,"_5":13195,"_26170":51400,"_2648":51595},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3150":2117,"_27660":2041,"_19192":51597,"_5":13195,"_26170":51404,"_2648":51598},[],"Each registered key has a detail view and several operational actions.",{"_3150":2118,"_27660":2041,"_19192":51600,"_5":13195,"_26170":51408,"_2648":51601},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3150":2119,"_27660":2041,"_19192":51603,"_5":13195,"_26170":51408,"_2648":51604},[],"The **Overview** tab shows, among others, these fields:",{"_3150":2120,"_27660":2041,"_19192":51606,"_5":13195,"_26170":51408,"_2648":51607},[],"**Key Name**: descriptive name.",{"_3150":2121,"_27660":2041,"_19192":51609,"_5":13195,"_26170":51408,"_2648":51610},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3150":2122,"_27660":2041,"_19192":51612,"_5":13195,"_26170":51408,"_2648":51613},[],"**Tags**: associated labels.",{"_3150":2123,"_27660":2041,"_19192":51615,"_5":13195,"_26170":51408,"_2648":51616},[],"**Aliases**: alternative names.",{"_3150":2124,"_27660":2041,"_19192":51618,"_5":13195,"_26170":51408,"_2648":51619},[],"**Crypto Engine**: engine where the key resides.",{"_3150":2125,"_27660":2041,"_19192":51621,"_5":13195,"_26170":51408,"_2648":51622},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3150":2126,"_27660":2041,"_19192":51624,"_5":13195,"_26170":51408,"_2648":51625},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3150":2127,"_27660":2041,"_19192":51627,"_5":13195,"_26170":51408,"_2648":51628},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3150":2128,"_27660":2041,"_19192":51630,"_5":13195,"_26170":51412,"_2648":51631},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3150":2129,"_27660":2041,"_19192":51633,"_5":13195,"_26170":51412,"_2648":51634},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3150":2130,"_27660":2041,"_19192":51636,"_5":13195,"_26170":51412,"_2648":51637},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3150":2131,"_27660":2041,"_19192":51639,"_5":13195,"_26170":51416,"_2648":51640},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3150":2132,"_27660":2041,"_19192":51642,"_5":13195,"_26170":51416,"_2648":51643},[],"Main fields:",{"_3150":2133,"_27660":2041,"_19192":51645,"_5":13195,"_26170":51416,"_2648":51646},[],"**Algorithm**: signing algorithm available for the key type.",{"_3150":2134,"_27660":2041,"_19192":51648,"_5":13195,"_26170":51416,"_2648":51649},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3150":2135,"_27660":2041,"_19192":51651,"_5":13195,"_26170":51416,"_2648":51652},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3150":2136,"_27660":2041,"_19192":51654,"_5":13195,"_26170":51416,"_2648":51655},[],"**Message**: content to sign.",{"_3150":2137,"_27660":2041,"_19192":51657,"_5":13195,"_26170":51416,"_2648":51658},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3150":2138,"_27660":2041,"_19192":51660,"_5":13195,"_26170":51420,"_2648":51661},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3150":2139,"_27660":2041,"_19192":51663,"_5":13195,"_26170":51420,"_2648":51643},[],{"_3150":2140,"_27660":2041,"_19192":51665,"_5":13195,"_26170":51420,"_2648":51666},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3150":2141,"_27660":2041,"_19192":51668,"_5":13195,"_26170":51420,"_2648":51669},[],"**Message Type**: `Raw` or `Digest`.",{"_3150":2142,"_27660":2041,"_19192":51671,"_5":13195,"_26170":51420,"_2648":51672},[],"**Payload Encoding**: encoding of the message.",{"_3150":2143,"_27660":2041,"_19192":51674,"_5":13195,"_26170":51420,"_2648":51675},[],"**Message**: original message or hash.",{"_3150":2144,"_27660":2041,"_19192":51677,"_5":13195,"_26170":51420,"_2648":51678},[],"**Signature**: signature to check.",{"_3150":2145,"_27660":2041,"_19192":51680,"_5":13195,"_26170":51420,"_2648":51681},[],"**Result**: indicator of the validation result.",{"_3150":2146,"_27660":2041,"_19192":51683,"_5":13195,"_26170":51424,"_2648":51684},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3150":2147,"_27660":2041,"_19192":51686,"_5":13195,"_26170":51424,"_2648":51687},[],"This flow is useful for:",{"_3150":2148,"_27660":2041,"_19192":51689,"_5":13195,"_26170":51424,"_2648":51690},[],"Requesting certificates from an external CA.",{"_3150":2149,"_27660":2041,"_19192":51692,"_5":13195,"_26170":51424,"_2648":51693},[],"Renewing an identity while keeping the same key.",{"_3150":2150,"_27660":2041,"_19192":51695,"_5":13195,"_26170":51424,"_2648":51696},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3150":2151,"_27660":2041,"_19192":51698,"_5":13195,"_26170":51424,"_2648":51699},[],"**Common Name (CN)**: main name of the identity.",{"_3150":2152,"_27660":2041,"_19192":51701,"_5":13195,"_26170":51424,"_2648":51702},[],"**Organization (O)**: organization or company.",{"_3150":2153,"_27660":2041,"_19192":51704,"_5":13195,"_26170":51424,"_2648":51705},[],"**Organizational Unit (OU)**: department or unit.",{"_3150":2154,"_27660":2041,"_19192":51707,"_5":13195,"_26170":51424,"_2648":51708},[],"**Country (C)**: two-letter country code.",{"_3150":2155,"_27660":2041,"_19192":51710,"_5":13195,"_26170":51424,"_2648":51711},[],"**State / Province (ST)**: state or province.",{"_3150":2156,"_27660":2041,"_19192":51713,"_5":13195,"_26170":51424,"_2648":51714},[],"**Locality (L)**: city or locality.",{"_3150":2157,"_27660":2041,"_19192":51716,"_5":13195,"_26170":51424,"_2648":51717},[],"**Email Address**: contact email.",{"_3150":2158,"_27660":2041,"_19192":51719,"_5":13195,"_26170":51424,"_2648":51720},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3150":2159,"_27660":2041,"_19192":51722,"_5":13195,"_26170":51424,"_2648":51723},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3150":2160,"_27660":2041,"_19192":51725,"_5":13195,"_26170":51428,"_2648":51726},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3150":2161,"_27660":2041,"_19192":51728,"_5":13195,"_26170":51428,"_2648":51729},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3150":2162,"_27660":2041,"_19192":51731,"_5":13195,"_26170":51432,"_2648":51732},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3150":2163,"_27660":2163,"_5":13521,"_2648":51734,"_28003":51735,"_19192":51736,"_26170":2163},"Online validation with OCSP",[44970,46350,50046,50663],[],{"_3150":2164,"_27660":2163,"_19192":51738,"_5":13195,"_26170":2163,"_2648":51739},[],"Query signed status and verify the responder’s response.",{"_3150":2165,"_27660":2163,"_5":28000,"_19192":51741,"_26170":51742,"_2648":51743},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3150":2166,"_27660":2163,"_5":28000,"_19192":51745,"_26170":51746,"_2648":51747},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3150":2167,"_27660":2163,"_5":28000,"_19192":51749,"_26170":51750,"_2648":51751},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3150":2168,"_27660":2163,"_5":28000,"_19192":51753,"_26170":51754,"_2648":51755},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3150":2169,"_27660":2163,"_5":28000,"_19192":51757,"_26170":51758,"_2648":51759},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3150":2170,"_27660":2163,"_5":28000,"_19192":51761,"_26170":51762,"_2648":51209},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#references",{"_3150":2171,"_27660":2163,"_19192":51764,"_5":13195,"_26170":2163,"_2648":51765},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3150":2172,"_27660":2163,"_19192":51767,"_5":13195,"_26170":51742,"_2648":51768},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3150":2173,"_27660":2163,"_19192":51770,"_5":13195,"_26170":51742,"_2648":51771},[],"Record status",{"_3150":2174,"_27660":2163,"_19192":51773,"_5":13195,"_26170":51742,"_2648":51774},[],"Signed response",{"_3150":2175,"_27660":2163,"_19192":51776,"_5":13195,"_26170":51742,"_2648":49224},[],{"_3150":2176,"_27660":2163,"_19192":51778,"_5":13195,"_26170":51742,"_2648":51779},[],"`Good`.",{"_3150":2177,"_27660":2163,"_19192":51781,"_5":13195,"_26170":51742,"_2648":49241},[],{"_3150":2178,"_27660":2163,"_19192":51783,"_5":13195,"_26170":51742,"_2648":51784},[],"`Revoked`, with revocation reason and timestamp.",{"_3150":2179,"_27660":2163,"_19192":51786,"_5":13195,"_26170":51742,"_2648":51787},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3150":2180,"_27660":2163,"_19192":51789,"_5":13195,"_26170":51742,"_2648":51790},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3150":2181,"_27660":2163,"_19192":51792,"_5":13195,"_26170":51742,"_2648":51793},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3150":2182,"_27660":2163,"_19192":51795,"_5":13195,"_26170":51742,"_2648":51796},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3150":2183,"_27660":2163,"_19192":51798,"_5":13195,"_26170":51742,"_2648":51799},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3150":2184,"_27660":2163,"_19192":51801,"_5":13195,"_26170":51746,"_2648":51802},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3150":2185,"_27660":2163,"_19192":51804,"_5":13195,"_26170":51746,"_2648":51805},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3150":2186,"_27660":2163,"_19192":51807,"_5":13195,"_26170":51750,"_2648":51808},[],"The service accepts:",{"_3150":2187,"_27660":2163,"_19192":51810,"_5":13195,"_26170":51750,"_2648":48077},[],{"_3150":2188,"_27660":2163,"_19192":51812,"_5":13195,"_26170":51750,"_2648":51813},[],"VA service path",{"_3150":2189,"_27660":2163,"_19192":51815,"_5":13195,"_26170":51750,"_2648":51816},[],"Format",{"_3150":2190,"_27660":2163,"_19192":51818,"_5":13195,"_26170":51750,"_2648":51819},[],"`POST`",{"_3150":2191,"_27660":2163,"_19192":51821,"_5":13195,"_26170":51750,"_2648":51822},[],"`/ocsp`",{"_3150":2192,"_27660":2163,"_19192":51824,"_5":13195,"_26170":51750,"_2648":51825},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3150":2193,"_27660":2163,"_19192":51827,"_5":13195,"_26170":51750,"_2648":51308},[],{"_3150":2194,"_27660":2163,"_19192":51829,"_5":13195,"_26170":51750,"_2648":51830},[],"`/ocsp/{ocsp_request}`",{"_3150":2195,"_27660":2163,"_19192":51832,"_5":13195,"_26170":51750,"_2648":51833},[],"DER request encoded using padded URL Base64.",{"_3150":2196,"_27660":2163,"_19192":51835,"_5":13195,"_26170":51750,"_2648":51836},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3150":2197,"_27660":2163,"_19192":51838,"_5":13195,"_26170":51754,"_2648":51839},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3150":2198,"_27660":2163,"_19192":51841,"_5":13195,"_26170":51754,"_2648":51842},[],"Generate the request:",{"_3150":2199,"_27660":2163,"_19192":51844,"_5":13195,"_26170":51754,"_2648":51845},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3150":2200,"_27660":2163,"_19192":51847,"_5":13195,"_26170":51754,"_2648":51848},[],"Replace the example URL with the inspected endpoint:",{"_3150":2201,"_27660":2163,"_19192":51850,"_5":13195,"_26170":51754,"_2648":51851},[],"Verify the returned DER:",{"_3150":2202,"_27660":2163,"_19192":51853,"_5":13195,"_26170":51754,"_2648":51854},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3150":2203,"_27660":2163,"_19192":51856,"_5":13195,"_26170":51758,"_2648":51857},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3150":2204,"_27660":2163,"_19192":51859,"_5":13195,"_26170":51758,"_2648":51860},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3150":2205,"_27660":2163,"_19192":51862,"_5":13195,"_26170":51762,"_2648":51863},[],"RFC 6960: OCSP.",{"_3150":2206,"_27660":2163,"_19192":51865,"_5":13195,"_26170":51762,"_2648":51866},[],"OpenSSL: openssl-ocsp.",{"_3150":2207,"_27660":2163,"_19192":51868,"_5":13195,"_26170":51762,"_2648":51869},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3150":2208,"_27660":2163,"_19192":51871,"_5":13195,"_26170":51762,"_2648":51346},[],{"_3150":2209,"_27660":2209,"_5":13521,"_2648":50046,"_28003":51873,"_19192":51874,"_26170":2209},[44970,46350,50046],[],{"_3150":2210,"_27660":2209,"_19192":51876,"_5":13195,"_26170":2209,"_2648":51877},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3150":2211,"_27660":2209,"_5":28000,"_19192":51879,"_26170":51880,"_2648":49356},[],"/docs/pr-preview/pr-26/platform/pki/overview#start-here",{"_3150":2212,"_27660":2209,"_5":28000,"_19192":51882,"_26170":51883,"_2648":51884},[],"/docs/pr-preview/pr-26/platform/pki/overview#what-you-need","What you need",{"_3150":2213,"_27660":2209,"_5":28000,"_19192":51886,"_26170":51887,"_2648":49890},[],"/docs/pr-preview/pr-26/platform/pki/overview#core-capabilities",{"_3150":2214,"_27660":2209,"_5":28000,"_19192":51889,"_26170":51890,"_2648":49894},[],"/docs/pr-preview/pr-26/platform/pki/overview#build-your-trust-hierarchy",{"_3150":2215,"_27660":2209,"_5":28000,"_19192":51892,"_26170":51893,"_2648":49898},[],"/docs/pr-preview/pr-26/platform/pki/overview#protect-cryptographic-keys",{"_3150":2216,"_27660":2209,"_5":28000,"_19192":51895,"_26170":51896,"_2648":49902},[],"/docs/pr-preview/pr-26/platform/pki/overview#issue-and-control-certificates",{"_3150":2217,"_27660":2209,"_5":28000,"_19192":51898,"_26170":51899,"_2648":49910},[],"/docs/pr-preview/pr-26/platform/pki/overview#publish-validation-status",{"_3150":2218,"_27660":2209,"_5":28000,"_19192":51901,"_26170":51902,"_2648":51903},[],"/docs/pr-preview/pr-26/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3150":2219,"_27660":2209,"_5":28000,"_19192":51905,"_26170":51906,"_2648":50830},[],"/docs/pr-preview/pr-26/platform/pki/overview#continue",{"_3150":2220,"_27660":2209,"_19192":51908,"_5":13195,"_26170":2209,"_2648":51909},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3150":2221,"_27660":2209,"_19192":51911,"_5":13195,"_26170":51880,"_2648":51912},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3150":2222,"_27660":2209,"_19192":51914,"_5":13195,"_26170":51880,"_2648":51915},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3150":2223,"_27660":2209,"_19192":51917,"_5":13195,"_26170":51883,"_2648":51918},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3150":2224,"_27660":2209,"_19192":51920,"_5":13195,"_26170":51883,"_2648":51921},[],"An available cryptographic engine to keep the authority's key.",{"_3150":2225,"_27660":2209,"_19192":51923,"_5":13195,"_26170":51883,"_2648":51924},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3150":2226,"_27660":2209,"_19192":51926,"_5":13195,"_26170":51883,"_2648":51927},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3150":2227,"_27660":2209,"_19192":51929,"_5":13195,"_26170":51883,"_2648":51930},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3150":2228,"_27660":2209,"_19192":51932,"_5":13195,"_26170":51890,"_2648":51933},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3150":2229,"_27660":2209,"_19192":51935,"_5":13195,"_26170":51893,"_2648":51936},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3150":2230,"_27660":2209,"_19192":51938,"_5":13195,"_26170":51896,"_2648":51939},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3150":2231,"_27660":2209,"_19192":51941,"_5":13195,"_26170":51899,"_2648":51942},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3150":2232,"_27660":2209,"_19192":51944,"_5":13195,"_26170":51902,"_2648":51945},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3150":2233,"_27660":2209,"_19192":51947,"_5":13195,"_26170":51902,"_2648":51948},[],"its subject and extensions identify the expected client;",{"_3150":2234,"_27660":2209,"_19192":51950,"_5":13195,"_26170":51902,"_2648":51951},[],"its public key matches the client's private key;",{"_3150":2235,"_27660":2209,"_19192":51953,"_5":13195,"_26170":51902,"_2648":51954},[],"its chain reaches a root trusted by the consumer;",{"_3150":2236,"_27660":2209,"_19192":51956,"_5":13195,"_26170":51902,"_2648":51957},[],"its dates and usages allow the operation;",{"_3150":2237,"_27660":2209,"_19192":51959,"_5":13195,"_26170":51902,"_2648":51960},[],"the consumer applies revocation checks and authorization.",{"_3150":2238,"_27660":2209,"_19192":51962,"_5":13195,"_26170":51902,"_2648":51963},[],"The issuance path includes the first independent checks.",{"_3150":2239,"_27660":2209,"_19192":51965,"_5":13195,"_26170":51906,"_2648":51966},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":2240,"_27660":2209,"_19192":51968,"_5":13195,"_26170":51906,"_2648":51969},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3150":2241,"_27660":2209,"_19192":51971,"_5":13195,"_26170":51906,"_2648":51972},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3150":2242,"_27660":2242,"_5":13521,"_2648":51974,"_28003":51975,"_19192":51976,"_26170":2242},"Create your first CA",[44970,46350,50046,49481],[],{"_3150":2243,"_27660":2242,"_19192":51978,"_5":13195,"_26170":2242,"_2648":51979},[],"Create an evaluation root and check its certificate before issuing.",{"_3150":2244,"_27660":2242,"_5":28000,"_19192":51981,"_26170":51982,"_2648":44980},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3150":2245,"_27660":2242,"_5":28000,"_19192":51984,"_26170":51985,"_2648":51986},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3150":2246,"_27660":2242,"_5":28000,"_19192":51988,"_26170":51989,"_2648":51990},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3150":2247,"_27660":2242,"_5":28000,"_19192":51992,"_26170":51993,"_2648":51994},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3150":2248,"_27660":2242,"_5":28000,"_19192":51996,"_26170":51997,"_2648":51998},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3150":2249,"_27660":2242,"_5":28000,"_19192":52000,"_26170":52001,"_2648":52002},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3150":2250,"_27660":2242,"_5":28000,"_19192":52004,"_26170":52005,"_2648":52006},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3150":2251,"_27660":2242,"_5":28000,"_19192":52008,"_26170":52009,"_2648":49739},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3150":2252,"_27660":2242,"_5":28000,"_19192":52011,"_26170":52012,"_2648":45004},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3150":2253,"_27660":2242,"_19192":52014,"_5":13195,"_26170":2242,"_2648":52015},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3150":2254,"_27660":2242,"_19192":52017,"_5":13195,"_26170":51982,"_2648":52018},[],"Console access and permission to create keys and authorities.",{"_3150":2255,"_27660":2242,"_19192":52020,"_5":13195,"_26170":51982,"_2648":52021},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3150":2256,"_27660":2242,"_19192":52023,"_5":13195,"_26170":51982,"_2648":52024},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3150":2257,"_27660":2242,"_19192":52026,"_5":13195,"_26170":51982,"_2648":52027},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3150":2258,"_27660":2242,"_19192":52029,"_5":13195,"_26170":51985,"_2648":52030},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3150":2259,"_27660":2242,"_19192":52032,"_5":13195,"_26170":51985,"_2648":52033},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3150":2260,"_27660":2242,"_19192":52035,"_5":13195,"_26170":51989,"_2648":52036},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3150":2261,"_27660":2242,"_19192":52038,"_5":13195,"_26170":51989,"_2648":52039},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3150":2262,"_27660":2242,"_19192":52041,"_5":13195,"_26170":51993,"_2648":52042},[],"Select **Root CA** and complete:",{"_3150":2263,"_27660":2242,"_19192":52044,"_5":13195,"_26170":51993,"_2648":52045},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3150":2264,"_27660":2242,"_19192":52047,"_5":13195,"_26170":51993,"_2648":52048},[],"**Subject**: organization and country details for your evaluation.",{"_3150":2265,"_27660":2242,"_19192":52050,"_5":13195,"_26170":51993,"_2648":52051},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3150":2266,"_27660":2242,"_19192":52053,"_5":13195,"_26170":51993,"_2648":52054},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3150":2267,"_27660":2242,"_19192":52056,"_5":13195,"_26170":51993,"_2648":52057},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3150":2268,"_27660":2242,"_19192":52059,"_5":13195,"_26170":51997,"_2648":52060},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3150":2269,"_27660":2242,"_19192":52062,"_5":13195,"_26170":52001,"_2648":52063},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3150":2270,"_27660":2242,"_19192":52065,"_5":13195,"_26170":52001,"_2648":52066},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3150":2271,"_27660":2242,"_19192":52068,"_5":13195,"_26170":52005,"_2648":52069},[],"Run from the directory where you saved `ca.pem`:",{"_3150":2272,"_27660":2242,"_19192":52071,"_5":13195,"_26170":52005,"_2648":52072},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3150":2273,"_27660":2242,"_19192":52074,"_5":13195,"_26170":52005,"_2648":52075},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3150":2274,"_27660":2242,"_19192":52077,"_5":13195,"_26170":52009,"_2648":52078},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3150":2275,"_27660":2242,"_19192":52080,"_5":13195,"_26170":52009,"_2648":52081},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3150":2276,"_27660":2242,"_19192":52083,"_5":13195,"_26170":52009,"_2648":52084},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3150":2277,"_27660":2242,"_19192":52086,"_5":13195,"_26170":52009,"_2648":52087},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3150":2278,"_27660":2242,"_19192":52089,"_5":13195,"_26170":52012,"_2648":52090},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3150":2279,"_27660":2279,"_5":13521,"_2648":52092,"_28003":52093,"_19192":52094,"_26170":2279},"Issue and verify a certificate",[44970,46350,50046,49481],[],{"_3150":2280,"_27660":2279,"_19192":52096,"_5":13195,"_26170":2279,"_2648":52097},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3150":2281,"_27660":2279,"_5":28000,"_19192":52099,"_26170":52100,"_2648":44980},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3150":2282,"_27660":2279,"_5":28000,"_19192":52102,"_26170":52103,"_2648":52104},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3150":2283,"_27660":2279,"_5":28000,"_19192":52106,"_26170":52107,"_2648":52108},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3150":2284,"_27660":2279,"_5":28000,"_19192":52110,"_26170":52111,"_2648":52112},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3150":2285,"_27660":2279,"_5":28000,"_19192":52114,"_26170":52115,"_2648":52116},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3150":2286,"_27660":2279,"_5":28000,"_19192":52118,"_26170":52119,"_2648":52120},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3150":2287,"_27660":2279,"_5":28000,"_19192":52122,"_26170":52123,"_2648":52002},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3150":2288,"_27660":2279,"_5":28000,"_19192":52125,"_26170":52126,"_2648":52127},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3150":2289,"_27660":2279,"_5":28000,"_19192":52129,"_26170":52130,"_2648":52131},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3150":2290,"_27660":2279,"_5":28000,"_19192":52133,"_26170":52134,"_2648":52135},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3150":2291,"_27660":2279,"_5":28000,"_19192":52137,"_26170":52138,"_2648":49739},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3150":2292,"_27660":2279,"_5":28000,"_19192":52140,"_26170":52141,"_2648":45004},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#next-step",{"_3150":2293,"_27660":2279,"_19192":52143,"_5":13195,"_26170":2279,"_2648":52144},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3150":2294,"_27660":2279,"_19192":52146,"_5":13195,"_26170":52100,"_2648":52147},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3150":2295,"_27660":2279,"_19192":52149,"_5":13195,"_26170":52100,"_2648":52150},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3150":2296,"_27660":2279,"_19192":52152,"_5":13195,"_26170":52100,"_2648":52153},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3150":2297,"_27660":2279,"_19192":52155,"_5":13195,"_26170":52100,"_2648":52156},[],"A client identifier: here we use `device-001`.",{"_3150":2298,"_27660":2279,"_19192":52158,"_5":13195,"_26170":52100,"_2648":52159},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3150":2299,"_27660":2279,"_19192":52161,"_5":13195,"_26170":52103,"_2648":52162},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3150":2300,"_27660":2279,"_19192":52164,"_5":13195,"_26170":52107,"_2648":52165},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3150":2301,"_27660":2279,"_19192":52167,"_5":13195,"_26170":52107,"_2648":52168},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3150":2302,"_27660":2279,"_19192":52170,"_5":13195,"_26170":52111,"_2648":52171},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3150":2303,"_27660":2279,"_19192":52173,"_5":13195,"_26170":52111,"_2648":52174},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3150":2304,"_27660":2279,"_19192":52176,"_5":13195,"_26170":52115,"_2648":52177},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3150":2305,"_27660":2279,"_19192":52179,"_5":13195,"_26170":52115,"_2648":52180},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3150":2306,"_27660":2279,"_19192":52182,"_5":13195,"_26170":52119,"_2648":52183},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3150":2307,"_27660":2279,"_19192":52185,"_5":13195,"_26170":52123,"_2648":52186},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3150":2308,"_27660":2279,"_19192":52188,"_5":13195,"_26170":52126,"_2648":52189},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3150":2309,"_27660":2279,"_19192":52191,"_5":13195,"_26170":52130,"_2648":52192},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3150":2310,"_27660":2279,"_19192":52194,"_5":13195,"_26170":52130,"_2648":52195},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3150":2311,"_27660":2279,"_19192":52197,"_5":13195,"_26170":52130,"_2648":52198},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3150":2312,"_27660":2279,"_19192":52200,"_5":13195,"_26170":52134,"_2648":52201},[],"In Bash, compare the two public-key digests:",{"_3150":2313,"_27660":2279,"_19192":52203,"_5":13195,"_26170":52134,"_2648":52204},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3150":2314,"_27660":2279,"_19192":52206,"_5":13195,"_26170":52134,"_2648":52207},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3150":2315,"_27660":2279,"_19192":52209,"_5":13195,"_26170":52138,"_2648":49823},[],{"_3150":2316,"_27660":2279,"_19192":52211,"_5":13195,"_26170":52138,"_2648":52212},[],"What to review",{"_3150":2317,"_27660":2279,"_19192":52214,"_5":13195,"_26170":52138,"_2648":52215},[],"The CA rejects issuance",{"_3150":2318,"_27660":2279,"_19192":52217,"_5":13195,"_26170":52138,"_2648":52218},[],"Permissions, CA state and key, algorithm and profile.",{"_3150":2319,"_27660":2279,"_19192":52220,"_5":13195,"_26170":52138,"_2648":52221},[],"Different subject or usages",{"_3150":2320,"_27660":2279,"_19192":52223,"_5":13195,"_26170":52138,"_2648":52224},[],"Applied profile and requested values.",{"_3150":2321,"_27660":2279,"_19192":52226,"_5":13195,"_26170":52138,"_2648":52227},[],"Issuer cannot be found",{"_3150":2322,"_27660":2279,"_19192":52229,"_5":13195,"_26170":52138,"_2648":52230},[],"Downloaded CA and required intermediate chain.",{"_3150":2323,"_27660":2279,"_19192":52232,"_5":13195,"_26170":52138,"_2648":52233},[],"Validity fails",{"_3150":2324,"_27660":2279,"_19192":52235,"_5":13195,"_26170":52138,"_2648":52236},[],"Certificate and CA dates, and the computer's clock.",{"_3150":2325,"_27660":2279,"_19192":52238,"_5":13195,"_26170":52138,"_2648":52239},[],"Public-key digests differ",{"_3150":2326,"_27660":2279,"_19192":52241,"_5":13195,"_26170":52138,"_2648":52242},[],"Certificate and key files from the same issuance.",{"_3150":2327,"_27660":2279,"_19192":52244,"_5":13195,"_26170":52138,"_2648":52245},[],"See PKI diagnostics to narrow an issuance failure.",{"_3150":2328,"_27660":2279,"_19192":52247,"_5":13195,"_26170":52141,"_2648":52248},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3150":2329,"_27660":2279,"_19192":52250,"_5":13195,"_26170":52141,"_2648":52251},[],"Manage certificates for inspection, status and revocation.",{"_3150":2330,"_27660":2279,"_19192":52253,"_5":13195,"_26170":52141,"_2648":52254},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3150":2331,"_27660":2279,"_19192":52256,"_5":13195,"_26170":52141,"_2648":52257},[],"Prepare EST for the device to request its next identities.",{"_3150":2332,"_27660":2279,"_19192":52259,"_5":13195,"_26170":52141,"_2648":52260},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3150":2333,"_27660":2333,"_5":13521,"_2648":52262,"_28003":52263,"_19192":52264,"_26170":2333},"PKI getting started",[44970,46350,50046,49481],[],{"_3150":2334,"_27660":2333,"_19192":52266,"_5":13195,"_26170":2333,"_2648":52267},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3150":2335,"_27660":2333,"_5":28000,"_19192":52269,"_26170":52270,"_2648":44980},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#before-you-begin",{"_3150":2336,"_27660":2333,"_5":28000,"_19192":52272,"_26170":52273,"_2648":52274},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3150":2337,"_27660":2333,"_5":28000,"_19192":52276,"_26170":52277,"_2648":49673},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#expected-result",{"_3150":2338,"_27660":2333,"_5":28000,"_19192":52279,"_26170":52280,"_2648":52281},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3150":2339,"_27660":2333,"_19192":52283,"_5":13195,"_26170":2333,"_2648":52284},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3150":2340,"_27660":2333,"_19192":52286,"_5":13195,"_26170":52270,"_2648":52287},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3150":2341,"_27660":2333,"_19192":52289,"_5":13195,"_26170":52270,"_2648":52290},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3150":2342,"_27660":2333,"_19192":52292,"_5":13195,"_26170":52270,"_2648":52293},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3150":2343,"_27660":2333,"_19192":52295,"_5":13195,"_26170":52270,"_2648":52296},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3150":2344,"_27660":2333,"_19192":52298,"_5":13195,"_26170":52270,"_2648":52299},[],"A working directory with restricted access for the downloaded key.",{"_3150":2345,"_27660":2333,"_19192":52301,"_5":13195,"_26170":52273,"_2648":52302},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3150":2346,"_27660":2333,"_19192":52304,"_5":13195,"_26170":52273,"_2648":52305},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3150":2347,"_27660":2333,"_19192":52307,"_5":13195,"_26170":52273,"_2648":52308},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3150":2348,"_27660":2333,"_19192":52310,"_5":13195,"_26170":52273,"_2648":52311},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3150":2349,"_27660":2333,"_19192":52313,"_5":13195,"_26170":52277,"_2648":52314},[],"File or resource",{"_3150":2350,"_27660":2333,"_19192":52316,"_5":13195,"_26170":52277,"_2648":49670},[],{"_3150":2351,"_27660":2333,"_19192":52318,"_5":13195,"_26170":52277,"_2648":52319},[],"Active root CA and `ca.pem`",{"_3150":2352,"_27660":2333,"_19192":52321,"_5":13195,"_26170":52277,"_2648":52322},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3150":2353,"_27660":2333,"_19192":52324,"_5":13195,"_26170":52277,"_2648":52325},[],"End-entity certificate and `device.crt`",{"_3150":2354,"_27660":2333,"_19192":52327,"_5":13195,"_26170":52277,"_2648":52328},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3150":2355,"_27660":2333,"_19192":52330,"_5":13195,"_26170":52277,"_2648":52331},[],"Private key `device.key`",{"_3150":2356,"_27660":2333,"_19192":52333,"_5":13195,"_26170":52277,"_2648":52334},[],"Its public key matches the one included in `device.crt`.",{"_3150":2357,"_27660":2333,"_19192":52336,"_5":13195,"_26170":52277,"_2648":52337},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3150":2358,"_27660":2333,"_19192":52339,"_5":13195,"_26170":52280,"_2648":52340},[],"To operate certificates, continue with Certificates and Validation.",{"_3150":2359,"_27660":2333,"_19192":52342,"_5":13195,"_26170":52280,"_2648":52343},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3150":2360,"_27660":2333,"_19192":52345,"_5":13195,"_26170":52280,"_2648":52346},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3150":2361,"_27660":2361,"_5":13521,"_2648":52348,"_28003":52349,"_19192":52350,"_26170":2361},"PKI troubleshooting",[44970,46350,50046,48867],[],{"_3150":2362,"_27660":2361,"_19192":52352,"_5":13195,"_26170":2361,"_2648":52353},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3150":2363,"_27660":2361,"_5":28000,"_19192":52355,"_26170":52356,"_2648":52357},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3150":2364,"_27660":2361,"_5":28000,"_19192":52359,"_26170":52360,"_2648":52361},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3150":2365,"_27660":2361,"_5":28000,"_19192":52363,"_26170":52364,"_2648":52365},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3150":2366,"_27660":2361,"_19192":52367,"_5":13195,"_26170":2361,"_2648":52368},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3150":2367,"_27660":2361,"_19192":52370,"_5":13195,"_26170":2361,"_2648":52371},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3150":2368,"_27660":2361,"_19192":52373,"_5":13195,"_26170":52356,"_2648":49670},[],{"_3150":2369,"_27660":2361,"_19192":52375,"_5":13195,"_26170":52356,"_2648":52376},[],"What to inspect",{"_3150":2370,"_27660":2361,"_19192":52378,"_5":13195,"_26170":52356,"_2648":45004},[],{"_3150":2371,"_27660":2361,"_19192":52380,"_5":13195,"_26170":52356,"_2648":52381},[],"CA",{"_3150":2372,"_27660":2361,"_19192":52383,"_5":13195,"_26170":52356,"_2648":52384},[],"Exists, is active and has usable dates.",{"_3150":2373,"_27660":2361,"_19192":52386,"_5":13195,"_26170":52356,"_2648":52387},[],"Authorities.",{"_3150":2374,"_27660":2361,"_19192":52389,"_5":13195,"_26170":52356,"_2648":52390},[],"Key",{"_3150":2375,"_27660":2361,"_19192":52392,"_5":13195,"_26170":52356,"_2648":52393},[],"The record has a usable private key and the engine can sign.",{"_3150":2376,"_27660":2361,"_19192":52395,"_5":13195,"_26170":52356,"_2648":52396},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3150":2377,"_27660":2361,"_19192":52398,"_5":13195,"_26170":52356,"_2648":52399},[],"CSR",{"_3150":2378,"_27660":2361,"_19192":52401,"_5":13195,"_26170":52356,"_2648":52402},[],"Correct PEM and verifiable signature.",{"_3150":2379,"_27660":2361,"_19192":52404,"_5":13195,"_26170":52356,"_2648":52405},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3150":2380,"_27660":2361,"_19192":52407,"_5":13195,"_26170":52356,"_2648":52408},[],"Profile",{"_3150":2381,"_27660":2361,"_19192":52410,"_5":13195,"_26170":52356,"_2648":52411},[],"Selected source, existing ID, allowed algorithm and size.",{"_3150":2382,"_27660":2361,"_19192":52413,"_5":13195,"_26170":52356,"_2648":52414},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3150":2383,"_27660":2361,"_19192":52416,"_5":13195,"_26170":52356,"_2648":49823},[],{"_3150":2384,"_27660":2361,"_19192":52418,"_5":13195,"_26170":52356,"_2648":52419},[],"Appropriate subject, SAN, usages and dates.",{"_3150":2385,"_27660":2361,"_19192":52421,"_5":13195,"_26170":52356,"_2648":52422},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3150":2386,"_27660":2361,"_19192":52424,"_5":13195,"_26170":52356,"_2648":52425},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3150":2387,"_27660":2361,"_19192":52427,"_5":13195,"_26170":52356,"_2648":52428},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3150":2388,"_27660":2361,"_19192":52430,"_5":13195,"_26170":52360,"_2648":52431},[],"Check each boundary independently:",{"_3150":2389,"_27660":2361,"_19192":52433,"_5":13195,"_26170":52360,"_2648":52434},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3150":2390,"_27660":2361,"_19192":52436,"_5":13195,"_26170":52360,"_2648":52437},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3150":2391,"_27660":2361,"_19192":52439,"_5":13195,"_26170":52360,"_2648":52440},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3150":2392,"_27660":2361,"_19192":52442,"_5":13195,"_26170":52360,"_2648":52443},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3150":2393,"_27660":2361,"_19192":52445,"_5":13195,"_26170":52360,"_2648":52446},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3150":2394,"_27660":2361,"_19192":52448,"_5":13195,"_26170":52360,"_2648":52449},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3150":2395,"_27660":2361,"_19192":52451,"_5":13195,"_26170":52364,"_2648":52452},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3150":2396,"_27660":2361,"_19192":52454,"_5":13195,"_26170":52364,"_2648":52455},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3150":2397,"_27660":2397,"_5":13521,"_2648":52457,"_28003":52458,"_19192":52460,"_26170":2397},"3.8.0 to 4.0.0",[44970,52459],"Upgrades",[],{"_3150":2398,"_27660":2397,"_19192":52462,"_5":13195,"_26170":2397,"_2648":52463},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3150":2399,"_27660":2397,"_5":28000,"_19192":52465,"_26170":52466,"_2648":52467},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3150":2400,"_27660":2397,"_5":28000,"_19192":52469,"_26170":52470,"_2648":52471},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3150":2401,"_27660":2397,"_5":28000,"_19192":52473,"_26170":52474,"_2648":52475},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3150":2402,"_27660":2397,"_5":28000,"_19192":52477,"_26170":52478,"_2648":52479},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3150":2403,"_27660":2397,"_5":28000,"_19192":52481,"_26170":52482,"_2648":52483},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3150":2404,"_27660":2397,"_5":28000,"_19192":52485,"_26170":52486,"_2648":52487},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3150":2405,"_27660":2397,"_5":28000,"_19192":52489,"_26170":52490,"_2648":52491},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3150":2406,"_27660":2397,"_5":28000,"_19192":52493,"_26170":52494,"_2648":52495},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3150":2407,"_27660":2397,"_5":28000,"_19192":52497,"_26170":52498,"_2648":52499},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3150":2408,"_27660":2397,"_5":28000,"_19192":52501,"_26170":52502,"_2648":52503},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3150":2409,"_27660":2397,"_5":28000,"_19192":52505,"_26170":52506,"_2648":52507},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3150":2410,"_27660":2397,"_5":28000,"_19192":52509,"_26170":52510,"_2648":52511},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3150":2411,"_27660":2397,"_5":28000,"_19192":52513,"_26170":52514,"_2648":52515},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3150":2412,"_27660":2397,"_5":28000,"_19192":52517,"_26170":52518,"_2648":52519},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3150":2413,"_27660":2397,"_5":28000,"_19192":52521,"_26170":52522,"_2648":52523},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3150":2414,"_27660":2397,"_5":28000,"_19192":52525,"_26170":52526,"_2648":52527},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3150":2415,"_27660":2397,"_5":28000,"_19192":52529,"_26170":52530,"_2648":52531},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3150":2416,"_27660":2397,"_5":28000,"_19192":52533,"_26170":52534,"_2648":52535},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3150":2417,"_27660":2397,"_5":28000,"_19192":52537,"_26170":52538,"_2648":52539},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3150":2418,"_27660":2397,"_5":28000,"_19192":52541,"_26170":52542,"_2648":52543},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3150":2419,"_27660":2397,"_5":28000,"_19192":52545,"_26170":52546,"_2648":52547},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3150":2420,"_27660":2397,"_5":28000,"_19192":52549,"_26170":52550,"_2648":52551},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3150":2421,"_27660":2397,"_5":28000,"_19192":52553,"_26170":52554,"_2648":52555},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3150":2422,"_27660":2397,"_5":28000,"_19192":52557,"_26170":52558,"_2648":52559},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3150":2423,"_27660":2397,"_5":28000,"_19192":52561,"_26170":52562,"_2648":52563},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3150":2424,"_27660":2397,"_5":28000,"_19192":52565,"_26170":52566,"_2648":52567},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3150":2425,"_27660":2397,"_5":28000,"_19192":52569,"_26170":52570,"_2648":52571},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3150":2426,"_27660":2397,"_5":28000,"_19192":52573,"_26170":52574,"_2648":52575},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3150":2427,"_27660":2397,"_5":28000,"_19192":52577,"_26170":52578,"_2648":52579},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3150":2428,"_27660":2397,"_5":28000,"_19192":52581,"_26170":52582,"_2648":52583},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3150":2429,"_27660":2397,"_5":28000,"_19192":52585,"_26170":52586,"_2648":52587},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3150":2430,"_27660":2397,"_5":28000,"_19192":52589,"_26170":52590,"_2648":52591},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3150":2431,"_27660":2397,"_5":28000,"_19192":52593,"_26170":52594,"_2648":52595},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3150":2432,"_27660":2397,"_5":28000,"_19192":52597,"_26170":52598,"_2648":48867},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3150":2433,"_27660":2397,"_5":28000,"_19192":52600,"_26170":52601,"_2648":52602},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3150":2434,"_27660":2397,"_5":28000,"_19192":52604,"_26170":52605,"_2648":52606},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3150":2435,"_27660":2397,"_19192":52608,"_5":13195,"_26170":2397,"_2648":52609},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3150":2436,"_27660":2397,"_19192":52611,"_5":13195,"_26170":2397,"_2648":52612},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3150":2437,"_27660":2397,"_19192":52614,"_5":13195,"_26170":2397,"_2648":52615},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3150":2438,"_27660":2397,"_19192":52617,"_5":13195,"_26170":2397,"_2648":52618},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3150":2439,"_27660":2397,"_19192":52620,"_5":13195,"_26170":2397,"_2648":52621},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3150":2440,"_27660":2397,"_19192":52623,"_5":13195,"_26170":2397,"_2648":52624},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3150":2441,"_27660":2397,"_19192":52626,"_5":13195,"_26170":2397,"_2648":52627},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3150":2442,"_27660":2397,"_19192":52629,"_5":13195,"_26170":52470,"_2648":52630},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3150":2443,"_27660":2397,"_19192":52632,"_5":13195,"_26170":52470,"_2648":52633},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3150":2444,"_27660":2397,"_19192":52635,"_5":13195,"_26170":52474,"_2648":52636},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3150":2445,"_27660":2397,"_19192":52638,"_5":13195,"_26170":52474,"_2648":52639},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3150":2446,"_27660":2397,"_19192":52641,"_5":13195,"_26170":52478,"_2648":52642},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3150":2447,"_27660":2397,"_19192":52644,"_5":13195,"_26170":52482,"_2648":52645},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3150":2448,"_27660":2397,"_19192":52647,"_5":13195,"_26170":52482,"_2648":52648},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3150":2449,"_27660":2397,"_19192":52650,"_5":13195,"_26170":52482,"_2648":52651},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3150":2450,"_27660":2397,"_19192":52653,"_5":13195,"_26170":52482,"_2648":52654},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3150":2451,"_27660":2397,"_19192":52656,"_5":13195,"_26170":52482,"_2648":52657},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3150":2452,"_27660":2397,"_19192":52659,"_5":13195,"_26170":52486,"_2648":52660},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3150":2453,"_27660":2397,"_19192":52662,"_5":13195,"_26170":52486,"_2648":52663},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3150":2454,"_27660":2397,"_19192":52665,"_5":13195,"_26170":52486,"_2648":52666},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3150":2455,"_27660":2397,"_19192":52668,"_5":13195,"_26170":52486,"_2648":52669},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3150":2456,"_27660":2397,"_19192":52671,"_5":13195,"_26170":52486,"_2648":52672},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3150":2457,"_27660":2397,"_19192":52674,"_5":13195,"_26170":52490,"_2648":52675},[],"Change",{"_3150":2458,"_27660":2397,"_19192":52677,"_5":13195,"_26170":52490,"_2648":52678},[],"Who is affected",{"_3150":2459,"_27660":2397,"_19192":52680,"_5":13195,"_26170":52490,"_2648":52681},[],"Severity",{"_3150":2460,"_27660":2397,"_19192":52683,"_5":13195,"_26170":52490,"_2648":52684},[],"Action",{"_3150":2461,"_27660":2397,"_19192":52686,"_5":13195,"_26170":52490,"_2648":52499},[],{"_3150":2462,"_27660":2397,"_19192":52688,"_5":13195,"_26170":52490,"_2648":52689},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3150":2463,"_27660":2397,"_19192":52691,"_5":13195,"_26170":52490,"_2648":52692},[],"High: KMS and VA start on empty volumes",{"_3150":2464,"_27660":2397,"_19192":52694,"_5":13195,"_26170":52490,"_2648":52695},[],"Copy the data into the new volumes",{"_3150":2465,"_27660":2397,"_19192":52697,"_5":13195,"_26170":52490,"_2648":52503},[],{"_3150":2466,"_27660":2397,"_19192":52699,"_5":13195,"_26170":52490,"_2648":52700},[],"Every Helm release",{"_3150":2467,"_27660":2397,"_19192":52702,"_5":13195,"_26170":52490,"_2648":52703},[],"High: `helm upgrade` fails",{"_3150":2468,"_27660":2397,"_19192":52705,"_5":13195,"_26170":52490,"_2648":52706},[],"Remove or rename legacy keys",{"_3150":2469,"_27660":2397,"_19192":52708,"_5":13195,"_26170":52490,"_2648":52507},[],{"_3150":2470,"_27660":2397,"_19192":52710,"_5":13195,"_26170":52490,"_2648":52711},[],"Every deployment",{"_3150":2471,"_27660":2397,"_19192":52713,"_5":13195,"_26170":52490,"_2648":52714},[],"High: without a bootstrap principal there is no administrator",{"_3150":2472,"_27660":2397,"_19192":52716,"_5":13195,"_26170":52490,"_2648":52717},[],"Configure `services.authz`",{"_3150":2473,"_27660":2397,"_19192":52719,"_5":13195,"_26170":52490,"_2648":52511},[],{"_3150":2474,"_27660":2397,"_19192":52721,"_5":13195,"_26170":52490,"_2648":52700},[],{"_3150":2475,"_27660":2397,"_19192":52723,"_5":13195,"_26170":52490,"_2648":52724},[],"High: `helm upgrade` fails on the old keys",{"_3150":2476,"_27660":2397,"_19192":52726,"_5":13195,"_26170":52490,"_2648":52727},[],"Move JWKS and roles into `services.authz`",{"_3150":2477,"_27660":2397,"_19192":52729,"_5":13195,"_26170":52490,"_2648":52531},[],{"_3150":2478,"_27660":2397,"_19192":52731,"_5":13195,"_26170":52490,"_2648":52732},[],"3.8.0 deployments with per-service databases",{"_3150":2479,"_27660":2397,"_19192":52734,"_5":13195,"_26170":52490,"_2648":52735},[],"High: services find no data, or a migration aborts",{"_3150":2480,"_27660":2397,"_19192":52737,"_5":13195,"_26170":52490,"_2648":52738},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3150":2481,"_27660":2397,"_19192":52740,"_5":13195,"_26170":52490,"_2648":52535},[],{"_3150":2482,"_27660":2397,"_19192":52742,"_5":13195,"_26170":52490,"_2648":52743},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3150":2483,"_27660":2397,"_19192":52745,"_5":13195,"_26170":52490,"_2648":52746},[],"High: the backend no longer starts with them",{"_3150":2484,"_27660":2397,"_19192":52748,"_5":13195,"_26170":52490,"_2648":52749},[],"Move to PostgreSQL before upgrading",{"_3150":2485,"_27660":2397,"_19192":52751,"_5":13195,"_26170":52490,"_2648":52752},[],"Webhooks with file references",{"_3150":2486,"_27660":2397,"_19192":52754,"_5":13195,"_26170":52490,"_2648":52755},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3150":2487,"_27660":2397,"_19192":52757,"_5":13195,"_26170":52490,"_2648":52758},[],"High: enrollments calling the webhook fail",{"_3150":2488,"_27660":2397,"_19192":52760,"_5":13195,"_26170":52490,"_2648":52761},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3150":2489,"_27660":2397,"_19192":52763,"_5":13195,"_26170":52490,"_2648":52515},[],{"_3150":2490,"_27660":2397,"_19192":52765,"_5":13195,"_26170":52490,"_2648":52766},[],"Releases with per-service identity overrides or mounted key material",{"_3150":2491,"_27660":2397,"_19192":52768,"_5":13195,"_26170":52490,"_2648":52769},[],"Medium: services cannot read their files",{"_3150":2492,"_27660":2397,"_19192":52771,"_5":13195,"_26170":52490,"_2648":52772},[],"Remove the overrides and fix volume ownership",{"_3150":2493,"_27660":2397,"_19192":52774,"_5":13195,"_26170":52490,"_2648":52519},[],{"_3150":2494,"_27660":2397,"_19192":52776,"_5":13195,"_26170":52490,"_2648":52777},[],"Releases that set `amqp.tls`",{"_3150":2495,"_27660":2397,"_19192":52779,"_5":13195,"_26170":52490,"_2648":52780},[],"Medium: clients connect to the wrong port",{"_3150":2496,"_27660":2397,"_19192":52782,"_5":13195,"_26170":52490,"_2648":52783},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3150":2497,"_27660":2397,"_19192":52785,"_5":13195,"_26170":52490,"_2648":52539},[],{"_3150":2498,"_27660":2397,"_19192":52787,"_5":13195,"_26170":52490,"_2648":52788},[],"Installations whose CA keys predate the KMS",{"_3150":2499,"_27660":2397,"_19192":52790,"_5":13195,"_26170":52490,"_2648":52791},[],"Medium: CA keys stay unmanaged",{"_3150":2500,"_27660":2397,"_19192":52793,"_5":13195,"_26170":52490,"_2648":52794},[],"Run the CA-to-KMS migration",{"_3150":2501,"_27660":2397,"_19192":52796,"_5":13195,"_26170":52490,"_2648":52797},[],"Receiver certificate verification",{"_3150":2502,"_27660":2397,"_19192":52799,"_5":13195,"_26170":52490,"_2648":52800},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3150":2503,"_27660":2397,"_19192":52802,"_5":13195,"_26170":52490,"_2648":52803},[],"Medium: credentials go to an unverified receiver",{"_3150":2504,"_27660":2397,"_19192":52805,"_5":13195,"_26170":52490,"_2648":52806},[],"Set `insecure_skip_verify` to `false`",{"_3150":2505,"_27660":2397,"_19192":52808,"_5":13195,"_26170":52490,"_2648":52551},[],{"_3150":2506,"_27660":2397,"_19192":52810,"_5":13195,"_26170":52490,"_2648":52811},[],"Scripts and consoles that edit DMSs through the API",{"_3150":2507,"_27660":2397,"_19192":52813,"_5":13195,"_26170":52490,"_2648":52814},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3150":2508,"_27660":2397,"_19192":52816,"_5":13195,"_26170":52490,"_2648":52817},[],"Read the DMS before editing and use the new field",{"_3150":2509,"_27660":2397,"_19192":52819,"_5":13195,"_26170":52490,"_2648":52567},[],{"_3150":2510,"_27660":2397,"_19192":52821,"_5":13195,"_26170":52490,"_2648":52822},[],"Consumers that read the device `events` field",{"_3150":2511,"_27660":2397,"_19192":52824,"_5":13195,"_26170":52490,"_2648":52825},[],"Medium: the field disappears",{"_3150":2512,"_27660":2397,"_19192":52827,"_5":13195,"_26170":52490,"_2648":52828},[],"Use the new event endpoints",{"_3150":2513,"_27660":2397,"_19192":52830,"_5":13195,"_26170":52490,"_2648":52523},[],{"_3150":2514,"_27660":2397,"_19192":52832,"_5":13195,"_26170":52490,"_2648":52833},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3150":2515,"_27660":2397,"_19192":52835,"_5":13195,"_26170":52490,"_2648":52836},[],"Low to medium: validation errors or changed defaults",{"_3150":2516,"_27660":2397,"_19192":52838,"_5":13195,"_26170":52490,"_2648":52839},[],"Update the values file",{"_3150":2517,"_27660":2397,"_19192":52841,"_5":13195,"_26170":52490,"_2648":52559},[],{"_3150":2518,"_27660":2397,"_19192":52843,"_5":13195,"_26170":52490,"_2648":52844},[],"Clients that send the DMS ID in the update body",{"_3150":2519,"_27660":2397,"_19192":52846,"_5":13195,"_26170":52490,"_2648":52847},[],"Low: the ID in the URL wins",{"_3150":2520,"_27660":2397,"_19192":52849,"_5":13195,"_26170":52490,"_2648":52850},[],"Send the ID in the URL",{"_3150":2521,"_27660":2397,"_19192":52852,"_5":13195,"_26170":52490,"_2648":52563},[],{"_3150":2522,"_27660":2397,"_19192":52854,"_5":13195,"_26170":52490,"_2648":52855},[],"Consumers that match on certificate `type`",{"_3150":2523,"_27660":2397,"_19192":52857,"_5":13195,"_26170":52490,"_2648":52858},[],"Low: two values are renamed",{"_3150":2524,"_27660":2397,"_19192":52860,"_5":13195,"_26170":52490,"_2648":52861},[],"Adapt consumers",{"_3150":2525,"_27660":2397,"_19192":52863,"_5":13195,"_26170":52490,"_2648":52555},[],{"_3150":2526,"_27660":2397,"_19192":52865,"_5":13195,"_26170":52490,"_2648":52866},[],"Any DMS",{"_3150":2527,"_27660":2397,"_19192":52868,"_5":13195,"_26170":52490,"_2648":52869},[],"Low: informational",{"_3150":2528,"_27660":2397,"_19192":52871,"_5":13195,"_26170":52490,"_2648":52872},[],"Read both blocks before editing",{"_3150":2529,"_27660":2397,"_19192":52874,"_5":13195,"_26170":52498,"_2648":52875},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3150":2530,"_27660":2397,"_19192":52877,"_5":13195,"_26170":52498,"_2648":52878},[],"Step 4 of the migration guide copies the data.",{"_3150":2531,"_27660":2397,"_19192":52880,"_5":13195,"_26170":52502,"_2648":52881},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3150":2532,"_27660":2397,"_19192":52883,"_5":13195,"_26170":52506,"_2648":52884},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3150":2533,"_27660":2397,"_19192":52886,"_5":13195,"_26170":52510,"_2648":52887},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3150":2534,"_27660":2397,"_19192":52889,"_5":13195,"_26170":52514,"_2648":52890},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3150":2535,"_27660":2397,"_19192":52892,"_5":13195,"_26170":52514,"_2648":52893},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3150":2536,"_27660":2397,"_19192":52895,"_5":13195,"_26170":52518,"_2648":52896},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3150":2537,"_27660":2397,"_19192":52898,"_5":13195,"_26170":52522,"_2648":52899},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3150":2538,"_27660":2397,"_19192":52901,"_5":13195,"_26170":52522,"_2648":52902},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3150":2539,"_27660":2397,"_19192":52904,"_5":13195,"_26170":52522,"_2648":52905},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3150":2540,"_27660":2397,"_19192":52907,"_5":13195,"_26170":52522,"_2648":52908},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3150":2541,"_27660":2397,"_19192":52910,"_5":13195,"_26170":52522,"_2648":52911},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3150":2542,"_27660":2397,"_19192":52913,"_5":13195,"_26170":52522,"_2648":52914},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3150":2543,"_27660":2397,"_19192":52916,"_5":13195,"_26170":52530,"_2648":52917},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3150":2544,"_27660":2397,"_19192":52919,"_5":13195,"_26170":52530,"_2648":52920},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3150":2545,"_27660":2397,"_19192":52922,"_5":13195,"_26170":52530,"_2648":52923},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3150":2546,"_27660":2397,"_19192":52925,"_5":13195,"_26170":52530,"_2648":52926},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3150":2547,"_27660":2397,"_19192":52928,"_5":13195,"_26170":52530,"_2648":52929},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3150":2548,"_27660":2397,"_19192":52931,"_5":13195,"_26170":52534,"_2648":52932},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3150":2549,"_27660":2397,"_19192":52934,"_5":13195,"_26170":52538,"_2648":52935},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3150":2550,"_27660":2397,"_19192":52937,"_5":13195,"_26170":52538,"_2648":52938},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3150":2551,"_27660":2397,"_19192":52940,"_5":13195,"_26170":52538,"_2648":52941},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3150":2552,"_27660":2397,"_19192":52943,"_5":13195,"_26170":52538,"_2648":52944},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3150":2553,"_27660":2397,"_19192":52946,"_5":13195,"_26170":52538,"_2648":52947},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3150":2554,"_27660":2397,"_19192":52949,"_5":13195,"_26170":52538,"_2648":52950},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3150":2555,"_27660":2397,"_19192":52952,"_5":13195,"_26170":52546,"_2648":52953},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3150":2556,"_27660":2397,"_19192":52955,"_5":13195,"_26170":52546,"_2648":52956},[],"Field in 3.8.0",{"_3150":2557,"_27660":2397,"_19192":52958,"_5":13195,"_26170":52546,"_2648":52959},[],"Field in 4.0.0",{"_3150":2558,"_27660":2397,"_19192":52961,"_5":13195,"_26170":52546,"_2648":52962},[],"`validate_server_cert`",{"_3150":2559,"_27660":2397,"_19192":52964,"_5":13195,"_26170":52546,"_2648":52965},[],"`insecure_skip_verify` (value negated)",{"_3150":2560,"_27660":2397,"_19192":52967,"_5":13195,"_26170":52546,"_2648":52968},[],"`oidc`",{"_3150":2561,"_27660":2397,"_19192":52970,"_5":13195,"_26170":52546,"_2648":52971},[],"`jwt_options`",{"_3150":2562,"_27660":2397,"_19192":52973,"_5":13195,"_26170":52546,"_2648":52974},[],"`apikey`",{"_3150":2563,"_27660":2397,"_19192":52976,"_5":13195,"_26170":52546,"_2648":52977},[],"`apikey_options`",{"_3150":2564,"_27660":2397,"_19192":52979,"_5":13195,"_26170":52546,"_2648":52980},[],"`mtls`",{"_3150":2565,"_27660":2397,"_19192":52982,"_5":13195,"_26170":52546,"_2648":52983},[],"`mtls_options`",{"_3150":2566,"_27660":2397,"_19192":52985,"_5":13195,"_26170":52546,"_2648":52986},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3150":2567,"_27660":2397,"_19192":52988,"_5":13195,"_26170":52546,"_2648":52989},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3150":2568,"_27660":2397,"_19192":52991,"_5":13195,"_26170":52546,"_2648":52992},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3150":2569,"_27660":2397,"_19192":52994,"_5":13195,"_26170":52550,"_2648":52995},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3150":2570,"_27660":2397,"_19192":52997,"_5":13195,"_26170":52550,"_2648":52998},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3150":2571,"_27660":2397,"_19192":53000,"_5":13195,"_26170":52550,"_2648":53001},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3150":2572,"_27660":2397,"_19192":53003,"_5":13195,"_26170":52554,"_2648":53004},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API.",{"_3150":2573,"_27660":2397,"_19192":53006,"_5":13195,"_26170":52558,"_2648":53007},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3150":2574,"_27660":2397,"_19192":53009,"_5":13195,"_26170":52562,"_2648":53010},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3150":2575,"_27660":2397,"_19192":53012,"_5":13195,"_26170":52566,"_2648":53013},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3150":2576,"_27660":2397,"_19192":53015,"_5":13195,"_26170":52566,"_2648":53016},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3150":2577,"_27660":2397,"_19192":53018,"_5":13195,"_26170":52566,"_2648":53019},[],"`POST /v1/devices/:id/events` creates an event.",{"_3150":2578,"_27660":2397,"_19192":53021,"_5":13195,"_26170":52566,"_2648":53022},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3150":2579,"_27660":2397,"_19192":53024,"_5":13195,"_26170":52570,"_2648":53025},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3150":2580,"_27660":2397,"_19192":53027,"_5":13195,"_26170":52574,"_2648":53028},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3150":2581,"_27660":2397,"_19192":53030,"_5":13195,"_26170":52574,"_2648":53031},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3150":2582,"_27660":2397,"_19192":53033,"_5":13195,"_26170":52574,"_2648":53034},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3150":2583,"_27660":2397,"_19192":53036,"_5":13195,"_26170":52574,"_2648":53037},[],"Record the names of your local-storage PVCs:",{"_3150":2584,"_27660":2397,"_19192":53039,"_5":13195,"_26170":52574,"_2648":53040},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3150":2585,"_27660":2397,"_19192":53042,"_5":13195,"_26170":52578,"_2648":53043},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3150":2586,"_27660":2397,"_19192":53045,"_5":13195,"_26170":52578,"_2648":53046},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3150":2587,"_27660":2397,"_19192":53048,"_5":13195,"_26170":52578,"_2648":53049},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3150":2588,"_27660":2397,"_19192":53051,"_5":13195,"_26170":52578,"_2648":53052},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3150":2589,"_27660":2397,"_19192":53054,"_5":13195,"_26170":52578,"_2648":53055},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3150":2590,"_27660":2397,"_19192":53057,"_5":13195,"_26170":52578,"_2648":53058},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3150":2591,"_27660":2397,"_19192":53060,"_5":13195,"_26170":52578,"_2648":53061},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3150":2592,"_27660":2397,"_19192":53063,"_5":13195,"_26170":52578,"_2648":53064},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3150":2593,"_27660":2397,"_19192":53066,"_5":13195,"_26170":52578,"_2648":53067},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3150":2594,"_27660":2397,"_19192":53069,"_5":13195,"_26170":52578,"_2648":53070},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3150":2595,"_27660":2397,"_19192":53072,"_5":13195,"_26170":52578,"_2648":53073},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3150":2596,"_27660":2397,"_19192":53075,"_5":13195,"_26170":52578,"_2648":53076},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3150":2597,"_27660":2397,"_19192":53078,"_5":13195,"_26170":52582,"_2648":53079},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3150":2598,"_27660":2397,"_19192":53081,"_5":13195,"_26170":52582,"_2648":53082},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3150":2599,"_27660":2397,"_19192":53084,"_5":13195,"_26170":52586,"_2648":53085},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3150":2600,"_27660":2397,"_19192":53087,"_5":13195,"_26170":52586,"_2648":53088},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3150":2601,"_27660":2397,"_19192":53090,"_5":13195,"_26170":52586,"_2648":53091},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3150":2602,"_27660":2397,"_19192":53093,"_5":13195,"_26170":52586,"_2648":53094},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3150":2603,"_27660":2397,"_19192":53096,"_5":13195,"_26170":52586,"_2648":53097},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3150":2604,"_27660":2397,"_19192":53099,"_5":13195,"_26170":52586,"_2648":53100},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3150":2605,"_27660":2397,"_19192":53102,"_5":13195,"_26170":52586,"_2648":53103},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3150":2606,"_27660":2397,"_19192":53105,"_5":13195,"_26170":52586,"_2648":53106},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3150":2607,"_27660":2397,"_19192":53108,"_5":13195,"_26170":52586,"_2648":53109},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3150":2608,"_27660":2397,"_19192":53111,"_5":13195,"_26170":52586,"_2648":53112},[],"**Remove the helper and restore the recorded replica counts:**",{"_3150":2609,"_27660":2397,"_19192":53114,"_5":13195,"_26170":52586,"_2648":53115},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3150":2610,"_27660":2397,"_19192":53117,"_5":13195,"_26170":52590,"_2648":53118},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3150":2611,"_27660":2397,"_19192":53120,"_5":13195,"_26170":52590,"_2648":53121},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3150":2612,"_27660":2397,"_19192":53123,"_5":13195,"_26170":52594,"_2648":53124},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3150":2613,"_27660":2397,"_19192":53126,"_5":13195,"_26170":52594,"_2648":53127},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3150":2614,"_27660":2397,"_19192":53129,"_5":13195,"_26170":52594,"_2648":53130},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3150":2615,"_27660":2397,"_19192":53132,"_5":13195,"_26170":52594,"_2648":53133},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3150":2616,"_27660":2397,"_19192":53135,"_5":13195,"_26170":52594,"_2648":53136},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3150":2617,"_27660":2397,"_19192":53138,"_5":13195,"_26170":52598,"_2648":53139},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3150":2618,"_27660":2397,"_19192":53141,"_5":13195,"_26170":52598,"_2648":53142},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3150":2619,"_27660":2397,"_19192":53144,"_5":13195,"_26170":52598,"_2648":53145},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3150":2620,"_27660":2397,"_19192":53147,"_5":13195,"_26170":52598,"_2648":53148},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3150":2621,"_27660":2397,"_19192":53150,"_5":13195,"_26170":52598,"_2648":53151},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3150":2622,"_27660":2397,"_19192":53153,"_5":13195,"_26170":52598,"_2648":53154},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3150":2623,"_27660":2397,"_19192":53156,"_5":13195,"_26170":52598,"_2648":53157},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3150":2624,"_27660":2397,"_19192":53159,"_5":13195,"_26170":52601,"_2648":53160},[],"After the upgrade, check in this order:",{"_3150":2625,"_27660":2397,"_19192":53162,"_5":13195,"_26170":52601,"_2648":53163},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3150":2626,"_27660":2397,"_19192":53165,"_5":13195,"_26170":52601,"_2648":53166},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3150":2627,"_27660":2397,"_19192":53168,"_5":13195,"_26170":52601,"_2648":53169},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3150":2628,"_27660":2397,"_19192":53171,"_5":13195,"_26170":52601,"_2648":53172},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3150":2629,"_27660":2397,"_19192":53174,"_5":13195,"_26170":52601,"_2648":53175},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3150":2630,"_27660":2397,"_19192":53177,"_5":13195,"_26170":52601,"_2648":53178},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3150":2631,"_27660":2397,"_19192":53180,"_5":13195,"_26170":52601,"_2648":53181},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3150":2632,"_27660":2397,"_19192":53183,"_5":13195,"_26170":52601,"_2648":53184},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3150":2633,"_27660":2397,"_19192":53186,"_5":13195,"_26170":52601,"_2648":53187},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3150":2634,"_27660":2397,"_19192":53189,"_5":13195,"_26170":52601,"_2648":53190},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3150":2635,"_27660":2397,"_19192":53192,"_5":13195,"_26170":52601,"_2648":53193},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3150":2636,"_27660":2397,"_19192":53195,"_5":13195,"_26170":52601,"_2648":53196},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3150":2637,"_27660":2397,"_19192":53198,"_5":13195,"_26170":52601,"_2648":53199},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3150":2638,"_27660":2397,"_19192":53201,"_5":13195,"_26170":52601,"_2648":53202},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3150":2639,"_27660":2397,"_19192":53204,"_5":13195,"_26170":52605,"_2648":53205},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3150":2640,"_27660":2397,"_19192":53207,"_5":13195,"_26170":52605,"_2648":53208},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3150":2641,"_27660":2397,"_19192":53210,"_5":13195,"_26170":52605,"_2648":53211},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":2642,"_27660":2397,"_19192":53213,"_5":13195,"_26170":52605,"_2648":53214},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3150":2643,"_27660":2397,"_19192":53216,"_5":13195,"_26170":52605,"_2648":53217},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53220":53221,"_53222":53223,"_53224":53225,"_53226":53227,"_16733":2670,"_63757":2670},"language","english","sortableProperties",[2648,27660,5,26170],"sortablePropertiesWithTypes",{"_2648":22952,"_27660":22952,"_5":22952,"_26170":22952},"sorts",{"_2648":53228,"_27660":55861,"_5":58493,"_26170":61125},{"_4214":53229,"_53230":53231,"_5":22952},{"_13250":4656,"_13620":6929,"_13627":5547,"_11891":3238,"_26296":6773,"_18221":3105,"_13271":4686,"_13278":3024,"_26723":5590,"_27110":6553,"_27131":6607,"_26741":5264,"_31767":3769,"_27142":7583,"_27171":3261,"_31774":5358,"_31777":7232,"_31780":5989,"_31783":2923,"_27519":5438,"_31788":4171,"_31790":3589,"_27549":4424,"_27509":2914,"_31794":5014,"_27718":5075,"_31798":4341,"_27160":12835,"_27514":15123,"_27573":11115,"_31803":11253,"_31805":3370,"_31807":7305,"_31809":2745,"_31811":19304,"_31813":5395,"_31815":5986,"_31817":3339,"_31819":3405,"_26794":11149,"_31822":5862,"_31824":10673,"_26788":3034,"_31827":4270,"_31829":3712,"_31831":2826,"_31834":11218,"_26829":3122,"_31838":2756,"_26714":5589,"_31841":3816,"_26746":3649,"_31844":6921,"_31846":3020,"_31849":4593,"_27544":5393,"_31852":4001,"_31854":5442,"_31857":5425,"_31859":3868,"_31861":2787,"_31863":2731,"_31865":5439,"_18224":8025,"_31868":2945,"_3187