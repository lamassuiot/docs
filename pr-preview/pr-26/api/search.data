0,"_34573":105863,"_34575":105866,"_34577":105869,"_34579":105872,"_34581":105875,"_34583":105878,"_34585":105881,"_34587":105884,"_34589":105887,"_34591":105890,"_34593":105893,"_34595":105896,"_34597":105899,"_34599":105902,"_34601":105905,"_34603":105909,"_34605":105912,"_34607":105915,"_34609":105919,"_34611":105922,"_34613":105926,"_34615":105929,"_34617":105932,"_34619":105935,"_34621":105938,"_34623":105941,"_34625":105944,"_34627":105947,"_34629":105950,"_34631":105953,"_34633":105956,"_34635":105959,"_34637":105961,"_34639":105964,"_34641":105967,"_34643":105970,"_34645":105973,"_34647":105976,"_34649":105979,"_34651":105982,"_34653":105985,"_34655":105988,"_34657":105991,"_34659":105995,"_34661":105998,"_34663":106002,"_34665":106006,"_34667":106010,"_34669":106013,"_34671":106016,"_34673":106018,"_34675":106020,"_34677":106022,"_34679":106024,"_34681":106027,"_34683":106030,"_34685":106033,"_34687":106036,"_34689":106039,"_34691":106041,"_34693":106044,"_34695":106046,"_34697":106049,"_34699":106052,"_34701":106055,"_34703":106057,"_34705":106060,"_34707":106063,"_34709":106066,"_34711":106069,"_34713":106072,"_34715":106075,"_34717":106078,"_34719":106081,"_34721":106084,"_34723":106087,"_34725":106090,"_34727":106093},{"_2937":59466,"_26000":59466,"_5":12545,"_2447":98633,"_26339":98634,"_18071":98637,"_24599":59466},"Despliega desde AWS Marketplace",[42089,98635,98636],"Despliegue","Otros modelos",[],{"_2937":59467,"_26000":59466,"_18071":98639,"_5":17966,"_24599":59466,"_2447":98640},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2937":59468,"_26000":59466,"_5":26336,"_18071":98642,"_24599":98643,"_2447":98644},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2937":59469,"_26000":59466,"_5":26336,"_18071":98646,"_24599":98647,"_2447":98648},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2937":59470,"_26000":59466,"_5":26336,"_18071":98650,"_24599":98651,"_2447":98652},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2937":59471,"_26000":59466,"_5":26336,"_18071":98654,"_24599":98655,"_2447":98656},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2937":59472,"_26000":59466,"_5":26336,"_18071":98658,"_24599":98659,"_2447":98660},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2937":59473,"_26000":59466,"_5":26336,"_18071":98662,"_24599":98663,"_2447":98664},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2937":59474,"_26000":59466,"_5":26336,"_18071":98666,"_24599":98667,"_2447":98668},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2937":59475,"_26000":59466,"_18071":98670,"_5":17966,"_24599":59466,"_2447":98671},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2937":59476,"_26000":59466,"_18071":98673,"_5":17966,"_24599":98643,"_2447":98674},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2937":59477,"_26000":59466,"_18071":98676,"_5":17966,"_24599":98643,"_2447":98677},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2937":59478,"_26000":59466,"_18071":98679,"_5":17966,"_24599":98643,"_2447":98680},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2937":59479,"_26000":59466,"_18071":98682,"_5":17966,"_24599":98647,"_2447":98683},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2937":59480,"_26000":59466,"_18071":98685,"_5":17966,"_24599":98647,"_2447":98686},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2937":59481,"_26000":59466,"_18071":98688,"_5":17966,"_24599":98647,"_2447":98689},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2937":59482,"_26000":59466,"_18071":98691,"_5":17966,"_24599":98651,"_2447":98692},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2937":59483,"_26000":59466,"_18071":98694,"_5":17966,"_24599":98655,"_2447":98695},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2937":59484,"_26000":59466,"_18071":98697,"_5":17966,"_24599":98659,"_2447":98698},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2937":59485,"_26000":59466,"_18071":98700,"_5":17966,"_24599":98663,"_2447":98701},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2937":59486,"_26000":59466,"_18071":98703,"_5":17966,"_24599":98667,"_2447":98704},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2937":59487,"_26000":59487,"_5":12545,"_2447":98706,"_26339":98707,"_18071":98708,"_24599":59487},"Despliega Lamassu",[42089,98635],[],{"_2937":59488,"_26000":59487,"_18071":98710,"_5":17966,"_24599":59487,"_2447":98711},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2937":59489,"_26000":59487,"_5":26336,"_18071":98713,"_24599":98714,"_2447":98715},[],"/docs/pr-preview/pr-26/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2937":59490,"_26000":59487,"_5":26336,"_18071":98717,"_24599":98718,"_2447":98719},[],"/docs/pr-preview/pr-26/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2937":59491,"_26000":59487,"_5":26336,"_18071":98721,"_24599":98722,"_2447":98723},[],"/docs/pr-preview/pr-26/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2937":59492,"_26000":59487,"_18071":98725,"_5":17966,"_24599":59487,"_2447":98726},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2937":59493,"_26000":59487,"_18071":98728,"_5":17966,"_24599":98714,"_2447":98729},[],"Modelo",{"_2937":59494,"_26000":59487,"_18071":98731,"_5":17966,"_24599":98714,"_2447":98732},[],"Recomendado para",{"_2937":59495,"_26000":59487,"_18071":98734,"_5":17966,"_24599":98714,"_2447":98735},[],"Quién opera la infraestructura",{"_2937":59496,"_26000":59487,"_18071":98737,"_5":17966,"_24599":98714,"_2447":98738},[],"Punto de partida",{"_2937":59497,"_26000":59487,"_18071":98740,"_5":17966,"_24599":98714,"_2447":42196},[],{"_2937":59498,"_26000":59487,"_18071":98742,"_5":17966,"_24599":98714,"_2447":98743},[],"Producción, entornos regulados y despliegues personalizados",{"_2937":59499,"_26000":59487,"_18071":98745,"_5":17966,"_24599":98714,"_2447":98746},[],"Tu equipo",{"_2937":59500,"_26000":59487,"_18071":98748,"_5":17966,"_24599":98714,"_2447":98749},[],"Helm o Fastlane",{"_2937":59501,"_26000":59487,"_18071":98751,"_5":17966,"_24599":98714,"_2447":42208},[],{"_2937":59502,"_26000":59487,"_18071":98753,"_5":17966,"_24599":98714,"_2447":98754},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2937":59503,"_26000":59487,"_18071":98756,"_5":17966,"_24599":98714,"_2447":98746},[],{"_2937":59504,"_26000":59487,"_18071":98758,"_5":17966,"_24599":98714,"_2447":98759},[],"Imagen preconfigurada en EC2",{"_2937":59505,"_26000":59487,"_18071":98761,"_5":17966,"_24599":98714,"_2447":42219},[],{"_2937":59506,"_26000":59487,"_18071":98763,"_5":17966,"_24599":98714,"_2447":98764},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2937":59507,"_26000":59487,"_18071":98766,"_5":17966,"_24599":98714,"_2447":42225},[],{"_2937":59508,"_26000":59487,"_18071":98768,"_5":17966,"_24599":98714,"_2447":98769},[],"Suscripción gestionada",{"_2937":59509,"_26000":59487,"_18071":98771,"_5":17966,"_24599":98714,"_2447":98772},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2937":59510,"_26000":59487,"_18071":98774,"_5":17966,"_24599":98714,"_2447":98775},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2937":59511,"_26000":59487,"_18071":98777,"_5":17966,"_24599":98714,"_2447":98778},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2937":59512,"_26000":59487,"_18071":98780,"_5":17966,"_24599":98718,"_2447":98781},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2937":59513,"_26000":59487,"_18071":98783,"_5":17966,"_24599":98722,"_2447":98784},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2937":59514,"_26000":59514,"_5":12545,"_2447":98786,"_26339":98787,"_18071":98788,"_24599":59514},"Utiliza Lamassu como SaaS",[42089,98635,98636],[],{"_2937":59515,"_26000":59514,"_18071":98790,"_5":17966,"_24599":59514,"_2447":98791},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2937":59516,"_26000":59514,"_5":26336,"_18071":98793,"_24599":98794,"_2447":98795},[],"/docs/pr-preview/pr-26/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2937":59517,"_26000":59514,"_5":26336,"_18071":98797,"_24599":98798,"_2447":98799},[],"/docs/pr-preview/pr-26/es/deployment/saas#planes","Planes",{"_2937":59518,"_26000":59514,"_5":26336,"_18071":98801,"_24599":98802,"_2447":98803},[],"/docs/pr-preview/pr-26/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2937":59519,"_26000":59514,"_18071":98805,"_5":17966,"_24599":59514,"_2447":98806},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2937":59520,"_26000":59514,"_18071":98808,"_5":17966,"_24599":98794,"_2447":98809},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2937":59521,"_26000":59514,"_18071":98811,"_5":17966,"_24599":98794,"_2447":98812},[],"Copias de seguridad automáticas.",{"_2937":59522,"_26000":59514,"_18071":98814,"_5":17966,"_24599":98794,"_2447":98815},[],"Actualizaciones de versión.",{"_2937":59523,"_26000":59514,"_18071":98817,"_5":17966,"_24599":98794,"_2447":98818},[],"Soporte técnico y SLA según el plan contratado.",{"_2937":59524,"_26000":59514,"_18071":98820,"_5":17966,"_24599":98798,"_2447":42280},[],{"_2937":59525,"_26000":59514,"_18071":98822,"_5":17966,"_24599":98798,"_2447":98823},[],"Dispositivos",{"_2937":59526,"_26000":59514,"_18071":98825,"_5":17966,"_24599":98798,"_2447":98826},[],"Soporte",{"_2937":59527,"_26000":59514,"_18071":98828,"_5":17966,"_24599":98798,"_2447":42289},[],{"_2937":59528,"_26000":59514,"_18071":98830,"_5":17966,"_24599":98798,"_2447":42292},[],{"_2937":59529,"_26000":59514,"_18071":98832,"_5":17966,"_24599":98798,"_2447":98833},[],"Hasta 1.000",{"_2937":59530,"_26000":59514,"_18071":98835,"_5":17966,"_24599":98798,"_2447":42298},[],{"_2937":59531,"_26000":59514,"_18071":98837,"_5":17966,"_24599":98798,"_2447":98838},[],"99,5 %",{"_2937":59532,"_26000":59514,"_18071":98840,"_5":17966,"_24599":98798,"_2447":42304},[],{"_2937":59533,"_26000":59514,"_18071":98842,"_5":17966,"_24599":98798,"_2447":98843},[],"Hasta 10.000",{"_2937":59534,"_26000":59514,"_18071":98845,"_5":17966,"_24599":98798,"_2447":98846},[],"Email y chat",{"_2937":59535,"_26000":59514,"_18071":98848,"_5":17966,"_24599":98798,"_2447":98849},[],"99,9 %",{"_2937":59536,"_26000":59514,"_18071":98851,"_5":17966,"_24599":98798,"_2447":42316},[],{"_2937":59537,"_26000":59514,"_18071":98853,"_5":17966,"_24599":98798,"_2447":98854},[],"Ilimitados",{"_2937":59538,"_26000":59514,"_18071":98856,"_5":17966,"_24599":98798,"_2447":98857},[],"Dedicado",{"_2937":59539,"_26000":59514,"_18071":98859,"_5":17966,"_24599":98798,"_2447":98860},[],"99,99 %",{"_2937":59540,"_26000":59514,"_18071":98862,"_5":17966,"_24599":98802,"_2447":98863},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2937":59541,"_26000":59514,"_18071":98865,"_5":17966,"_24599":98802,"_2447":98866},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2937":59542,"_26000":59542,"_5":12545,"_2447":42333,"_26339":98868,"_18071":98870,"_24599":59542},[42089,98635,98869],"Kubernetes autogestionado",[],{"_2937":59543,"_26000":59542,"_18071":98872,"_5":17966,"_24599":59542,"_2447":98873},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2937":59544,"_26000":59542,"_5":26336,"_18071":98875,"_24599":98876,"_2447":98877},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2937":59545,"_26000":59542,"_5":26336,"_18071":98879,"_24599":98880,"_2447":98881},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2937":59546,"_26000":59542,"_5":26336,"_18071":98883,"_24599":98884,"_2447":98885},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2937":59547,"_26000":59542,"_5":26336,"_18071":98887,"_24599":98888,"_2447":98889},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2937":59548,"_26000":59542,"_5":26336,"_18071":98891,"_24599":98892,"_2447":98893},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2937":59549,"_26000":59542,"_5":26336,"_18071":98895,"_24599":98896,"_2447":98897},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2937":59550,"_26000":59542,"_5":26336,"_18071":98899,"_24599":98900,"_2447":98901},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2937":59551,"_26000":59542,"_5":26336,"_18071":98903,"_24599":98904,"_2447":98905},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2937":59552,"_26000":59542,"_5":26336,"_18071":98907,"_24599":98908,"_2447":98909},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2937":59553,"_26000":59542,"_5":26336,"_18071":98911,"_24599":98912,"_2447":98913},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2937":59554,"_26000":59542,"_18071":98915,"_5":17966,"_24599":98876,"_2447":98916},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2937":59555,"_26000":59542,"_18071":98918,"_5":17966,"_24599":98876,"_2447":98919},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2937":59556,"_26000":59542,"_18071":98921,"_5":17966,"_24599":98880,"_2447":98922},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2937":59557,"_26000":59542,"_18071":98924,"_5":17966,"_24599":98880,"_2447":98925},[],"Fastlane instala o configura",{"_2937":59558,"_26000":59542,"_18071":98927,"_5":17966,"_24599":98880,"_2447":98928},[],"Tú sigues proporcionando",{"_2937":59559,"_26000":59542,"_18071":98930,"_5":17966,"_24599":98880,"_2447":98931},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2937":59560,"_26000":59542,"_18071":98933,"_5":17966,"_24599":98880,"_2447":98934},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2937":59561,"_26000":59542,"_18071":98936,"_5":17966,"_24599":98880,"_2447":98937},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2937":59562,"_26000":59542,"_18071":98939,"_5":17966,"_24599":98880,"_2447":98940},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2937":59563,"_26000":59542,"_18071":98942,"_5":17966,"_24599":98880,"_2447":98943},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2937":59564,"_26000":59542,"_18071":98945,"_5":17966,"_24599":98880,"_2447":98946},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2937":59565,"_26000":59542,"_18071":98948,"_5":17966,"_24599":98880,"_2447":98949},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2937":59566,"_26000":59542,"_18071":98951,"_5":17966,"_24599":98880,"_2447":98952},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2937":59567,"_26000":59542,"_18071":98954,"_5":17966,"_24599":98880,"_2447":98955},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2937":59568,"_26000":59542,"_18071":98957,"_5":17966,"_24599":98884,"_2447":98958},[],"Necesitas:",{"_2937":59569,"_26000":59542,"_18071":98960,"_5":17966,"_24599":98884,"_2447":98961},[],"un clúster Kubernetes existente",{"_2937":59570,"_26000":59542,"_18071":98963,"_5":17966,"_24599":98884,"_2447":98964},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2937":59571,"_26000":59542,"_18071":98966,"_5":17966,"_24599":98884,"_2447":42431},[],{"_2937":59572,"_26000":59542,"_18071":98968,"_5":17966,"_24599":98884,"_2447":20455},[],{"_2937":59573,"_26000":59542,"_18071":98970,"_5":17966,"_24599":98884,"_2447":98971},[],"`jq` solo si usas `--sample-data`",{"_2937":59574,"_26000":59542,"_18071":98973,"_5":17966,"_24599":98884,"_2447":98974},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_2937":59575,"_26000":59542,"_18071":98976,"_5":17966,"_24599":98884,"_2447":98977},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2937":59576,"_26000":59542,"_18071":98979,"_5":17966,"_24599":98884,"_2447":98980},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2937":59577,"_26000":59542,"_18071":98982,"_5":17966,"_24599":98884,"_2447":98983},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2937":59578,"_26000":59542,"_18071":98985,"_5":17966,"_24599":98888,"_2447":98986},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2937":59579,"_26000":59542,"_18071":98988,"_5":17966,"_24599":98888,"_2447":98989},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2937":59580,"_26000":59542,"_18071":98991,"_5":17966,"_24599":98892,"_2447":98992},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2937":59581,"_26000":59542,"_18071":98994,"_5":17966,"_24599":98892,"_2447":98995},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2937":59582,"_26000":59542,"_18071":98997,"_5":17966,"_24599":98892,"_2447":98998},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2937":59583,"_26000":59542,"_18071":99000,"_5":17966,"_24599":98892,"_2447":99001},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2937":59584,"_26000":59542,"_18071":99003,"_5":17966,"_24599":98896,"_2447":99004},[],"Opción",{"_2937":59585,"_26000":59542,"_18071":99006,"_5":17966,"_24599":98896,"_2447":99007},[],"Valor predeterminado",{"_2937":59586,"_26000":59542,"_18071":99009,"_5":17966,"_24599":98896,"_2447":99010},[],"Propósito",{"_2937":59587,"_26000":59542,"_18071":99012,"_5":17966,"_24599":98896,"_2447":42478},[],{"_2937":59588,"_26000":59542,"_18071":99014,"_5":17966,"_24599":98896,"_2447":42481},[],{"_2937":59589,"_26000":59542,"_18071":99016,"_5":17966,"_24599":98896,"_2447":99017},[],"Muestra la ayuda",{"_2937":59590,"_26000":59542,"_18071":99019,"_5":17966,"_24599":98896,"_2447":42487},[],{"_2937":59591,"_26000":59542,"_18071":99021,"_5":17966,"_24599":98896,"_2447":99022},[],"contexto actual",{"_2937":59592,"_26000":59542,"_18071":99024,"_5":17966,"_24599":98896,"_2447":99025},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2937":59593,"_26000":59542,"_18071":99027,"_5":17966,"_24599":98896,"_2447":42496},[],{"_2937":59594,"_26000":59542,"_18071":99029,"_5":17966,"_24599":98896,"_2447":5522},[],{"_2937":59595,"_26000":59542,"_18071":99031,"_5":17966,"_24599":98896,"_2447":99032},[],"Omite prompts y genera credenciales para las dependencias",{"_2937":59596,"_26000":59542,"_18071":99034,"_5":17966,"_24599":98896,"_2447":42504},[],{"_2937":59597,"_26000":59542,"_18071":99036,"_5":17966,"_24599":98896,"_2447":42507},[],{"_2937":59598,"_26000":59542,"_18071":99038,"_5":17966,"_24599":98896,"_2447":99039},[],"Namespace de la instalación",{"_2937":59599,"_26000":59542,"_18071":99041,"_5":17966,"_24599":98896,"_2447":42513},[],{"_2937":59600,"_26000":59542,"_18071":99043,"_5":17966,"_24599":98896,"_2447":42516},[],{"_2937":59601,"_26000":59542,"_18071":99045,"_5":17966,"_24599":98896,"_2447":99046},[],"Dominio usado por la UI, OIDC y el certificado",{"_2937":59602,"_26000":59542,"_18071":99048,"_5":17966,"_24599":98896,"_2447":42522},[],{"_2937":59603,"_26000":59542,"_18071":99050,"_5":17966,"_24599":98896,"_2447":12950},[],{"_2937":59604,"_26000":59542,"_18071":99052,"_5":17966,"_24599":98896,"_2447":99053},[],"Versión del chart de Lamassu",{"_2937":59605,"_26000":59542,"_18071":99055,"_5":17966,"_24599":98896,"_2447":42530},[],{"_2937":59606,"_26000":59542,"_18071":99057,"_5":17966,"_24599":98896,"_2447":42533},[],{"_2937":59607,"_26000":59542,"_18071":99059,"_5":17966,"_24599":98896,"_2447":99060},[],"Puerto del listener HTTPS",{"_2937":59608,"_26000":59542,"_18071":99062,"_5":17966,"_24599":98896,"_2447":42539},[],{"_2937":59609,"_26000":59542,"_18071":99064,"_5":17966,"_24599":98896,"_2447":42542},[],{"_2937":59610,"_26000":59542,"_18071":99066,"_5":17966,"_24599":98896,"_2447":99067},[],"Puerto del listener HTTP",{"_2937":59611,"_26000":59542,"_18071":99069,"_5":17966,"_24599":98896,"_2447":42548},[],{"_2937":59612,"_26000":59542,"_18071":99071,"_5":17966,"_24599":98896,"_2447":42481},[],{"_2937":59613,"_26000":59542,"_18071":99073,"_5":17966,"_24599":98896,"_2447":99074},[],"Certificado PEM para TLS downstream",{"_2937":59614,"_26000":59542,"_18071":99076,"_5":17966,"_24599":98896,"_2447":42556},[],{"_2937":59615,"_26000":59542,"_18071":99078,"_5":17966,"_24599":98896,"_2447":42481},[],{"_2937":59616,"_26000":59542,"_18071":99080,"_5":17966,"_24599":98896,"_2447":99081},[],"Clave privada PEM para TLS downstream",{"_2937":59617,"_26000":59542,"_18071":99083,"_5":17966,"_24599":98896,"_2447":42564},[],{"_2937":59618,"_26000":59542,"_18071":99085,"_5":17966,"_24599":98896,"_2447":99086},[],"chart del repositorio",{"_2937":59619,"_26000":59542,"_18071":99088,"_5":17966,"_24599":98896,"_2447":99089},[],"Usa un chart local de Lamassu sin empaquetar",{"_2937":59620,"_26000":59542,"_18071":99091,"_5":17966,"_24599":98896,"_2447":42573},[],{"_2937":59621,"_26000":59542,"_18071":99093,"_5":17966,"_24599":98896,"_2447":99094},[],"detección automática",{"_2937":59622,"_26000":59542,"_18071":99096,"_5":17966,"_24599":98896,"_2447":99097},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2937":59623,"_26000":59542,"_18071":99099,"_5":17966,"_24599":98896,"_2447":42581},[],{"_2937":59624,"_26000":59542,"_18071":99101,"_5":17966,"_24599":98896,"_2447":5522},[],{"_2937":59625,"_26000":59542,"_18071":99103,"_5":17966,"_24599":98896,"_2447":99104},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2937":59626,"_26000":59542,"_18071":99106,"_5":17966,"_24599":98896,"_2447":42589},[],{"_2937":59627,"_26000":59542,"_18071":99108,"_5":17966,"_24599":98896,"_2447":5522},[],{"_2937":59628,"_26000":59542,"_18071":99110,"_5":17966,"_24599":98896,"_2447":99111},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2937":59629,"_26000":59542,"_18071":99113,"_5":17966,"_24599":98896,"_2447":42597},[],{"_2937":59630,"_26000":59542,"_18071":99115,"_5":17966,"_24599":98896,"_2447":5522},[],{"_2937":59631,"_26000":59542,"_18071":99117,"_5":17966,"_24599":98896,"_2447":99118},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2937":59632,"_26000":59542,"_18071":99120,"_5":17966,"_24599":98896,"_2447":42605},[],{"_2937":59633,"_26000":59542,"_18071":99122,"_5":17966,"_24599":98896,"_2447":42608},[],{"_2937":59634,"_26000":59542,"_18071":99124,"_5":17966,"_24599":98896,"_2447":99125},[],"Usa otro chart local de SoftHSM",{"_2937":59635,"_26000":59542,"_18071":99127,"_5":17966,"_24599":98896,"_2447":99128},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2937":59636,"_26000":59542,"_18071":99130,"_5":17966,"_24599":98900,"_2447":42617},[],{"_2937":59637,"_26000":59542,"_18071":99132,"_5":17966,"_24599":98900,"_2447":99133},[],"valida las herramientas locales y el clúster seleccionado",{"_2937":59638,"_26000":59542,"_18071":99135,"_5":17966,"_24599":98900,"_2447":99136},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2937":59639,"_26000":59542,"_18071":99138,"_5":17966,"_24599":98900,"_2447":99139},[],"crea el namespace",{"_2937":59640,"_26000":59542,"_18071":99141,"_5":17966,"_24599":98900,"_2447":99142},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2937":59641,"_26000":59542,"_18071":99144,"_5":17966,"_24599":98900,"_2447":99145},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2937":59642,"_26000":59542,"_18071":99147,"_5":17966,"_24599":98900,"_2447":99148},[],"instala RabbitMQ",{"_2937":59643,"_26000":59542,"_18071":99150,"_5":17966,"_24599":98900,"_2447":99151},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2937":59644,"_26000":59542,"_18071":99153,"_5":17966,"_24599":98900,"_2447":99154},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2937":59645,"_26000":59542,"_18071":99156,"_5":17966,"_24599":98900,"_2447":99157},[],"carga datos de ejemplo opcionalmente",{"_2937":59646,"_26000":59542,"_18071":99159,"_5":17966,"_24599":98900,"_2447":99160},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2937":59647,"_26000":59542,"_18071":99162,"_5":17966,"_24599":98904,"_2447":99163},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2937":59648,"_26000":59542,"_18071":99165,"_5":17966,"_24599":98904,"_2447":99166},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2937":59649,"_26000":59542,"_18071":99168,"_5":17966,"_24599":98908,"_2447":99169},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2937":59650,"_26000":59542,"_18071":99171,"_5":17966,"_24599":98908,"_2447":99172},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2937":59651,"_26000":59542,"_18071":99174,"_5":17966,"_24599":98908,"_2447":99175},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2937":59652,"_26000":59542,"_18071":99177,"_5":17966,"_24599":98912,"_2447":99178},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2937":59653,"_26000":59653,"_5":12545,"_2447":99180,"_26339":99181,"_18071":99182,"_24599":59653},"Instala con Helm",[42089,98635,98869],[],{"_2937":59654,"_26000":59653,"_18071":99184,"_5":17966,"_24599":59653,"_2447":99185},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2937":59655,"_26000":59653,"_5":26336,"_18071":99187,"_24599":99188,"_2447":99189},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2937":59656,"_26000":59653,"_5":26336,"_18071":99191,"_24599":99192,"_2447":98885},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2937":59657,"_26000":59653,"_5":26336,"_18071":99194,"_24599":99195,"_2447":99196},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2937":59658,"_26000":59653,"_5":26336,"_18071":99198,"_24599":99199,"_2447":99200},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2937":59659,"_26000":59653,"_5":26336,"_18071":99202,"_24599":99203,"_2447":99204},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2937":59660,"_26000":59653,"_5":26336,"_18071":99206,"_24599":99207,"_2447":99208},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2937":59661,"_26000":59653,"_5":26336,"_18071":99210,"_24599":99211,"_2447":99212},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2937":59662,"_26000":59653,"_5":26336,"_18071":99214,"_24599":99215,"_2447":99216},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2937":59663,"_26000":59653,"_5":26336,"_18071":99218,"_24599":99219,"_2447":99220},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2937":59664,"_26000":59653,"_18071":99222,"_5":17966,"_24599":99188,"_2447":99223},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2937":59665,"_26000":59653,"_18071":99225,"_5":17966,"_24599":99192,"_2447":99226},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2937":59666,"_26000":59653,"_18071":99228,"_5":17966,"_24599":99192,"_2447":99229},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2937":59667,"_26000":59653,"_18071":99231,"_5":17966,"_24599":99192,"_2447":99232},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2937":59668,"_26000":59653,"_18071":99234,"_5":17966,"_24599":99192,"_2447":99235},[],"un broker RabbitMQ accesible y sus credenciales",{"_2937":59669,"_26000":59653,"_18071":99237,"_5":17966,"_24599":99192,"_2447":99238},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2937":59670,"_26000":59653,"_18071":99240,"_5":17966,"_24599":99192,"_2447":99241},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2937":59671,"_26000":59653,"_18071":99243,"_5":17966,"_24599":99192,"_2447":99244},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2937":59672,"_26000":59653,"_18071":99246,"_5":17966,"_24599":99192,"_2447":99247},[],"una StorageClass y un diseño de tráfico externo",{"_2937":59673,"_26000":59653,"_18071":99249,"_5":17966,"_24599":99192,"_2447":99250},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2937":59674,"_26000":59653,"_18071":99252,"_5":17966,"_24599":99192,"_2447":99253},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2937":59675,"_26000":59653,"_18071":99255,"_5":17966,"_24599":99192,"_2447":99256},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2937":59676,"_26000":59653,"_18071":99258,"_5":17966,"_24599":99195,"_2447":99259},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2937":59677,"_26000":59653,"_18071":99261,"_5":17966,"_24599":99195,"_2447":99262},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2937":59678,"_26000":59653,"_18071":99264,"_5":17966,"_24599":99195,"_2447":99265},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2937":59679,"_26000":59653,"_18071":99267,"_5":17966,"_24599":99199,"_2447":99268},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2937":59680,"_26000":59653,"_18071":99270,"_5":17966,"_24599":99199,"_2447":99271},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2937":59681,"_26000":59653,"_18071":99273,"_5":17966,"_24599":99199,"_2447":99274},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2937":59682,"_26000":59653,"_18071":99276,"_5":17966,"_24599":99203,"_2447":99277},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2937":59683,"_26000":59653,"_18071":99279,"_5":17966,"_24599":99207,"_2447":99280},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2937":59684,"_26000":59653,"_18071":99282,"_5":17966,"_24599":99207,"_2447":99283},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2937":59685,"_26000":59653,"_18071":99285,"_5":17966,"_24599":99207,"_2447":99286},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2937":59686,"_26000":59653,"_18071":99288,"_5":17966,"_24599":99207,"_2447":99289},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2937":59687,"_26000":59653,"_18071":99291,"_5":17966,"_24599":99211,"_2447":99292},[],"Para instalar un checkout local:",{"_2937":59688,"_26000":59653,"_18071":99294,"_5":17966,"_24599":99215,"_2447":99295},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2937":59689,"_26000":59653,"_18071":99297,"_5":17966,"_24599":99215,"_2447":99298},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2937":59690,"_26000":59653,"_18071":99300,"_5":17966,"_24599":99219,"_2447":99301},[],"Antes de pasar a producción, revisa:",{"_2937":59691,"_26000":59653,"_18071":99303,"_5":17966,"_24599":99219,"_2447":99304},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2937":59692,"_26000":59653,"_18071":99306,"_5":17966,"_24599":99219,"_2447":99307},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2937":59693,"_26000":59653,"_18071":99309,"_5":17966,"_24599":99219,"_2447":99310},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2937":59694,"_26000":59653,"_18071":99312,"_5":17966,"_24599":99219,"_2447":99313},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2937":59695,"_26000":59653,"_18071":99315,"_5":17966,"_24599":99219,"_2447":99316},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2937":59696,"_26000":59653,"_18071":99318,"_5":17966,"_24599":99219,"_2447":99319},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2937":59697,"_26000":59653,"_18071":99321,"_5":17966,"_24599":99219,"_2447":99322},[],"SMTP, observabilidad y entrega de alertas",{"_2937":59698,"_26000":59653,"_18071":99324,"_5":17966,"_24599":99219,"_2447":99325},[],"sigue Actualiza el chart de Helm y las notas de cada versión en `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2937":59699,"_26000":59653,"_18071":99327,"_5":17966,"_24599":99219,"_2447":99328},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2937":59700,"_26000":59700,"_5":12545,"_2447":99330,"_18071":99331,"_24599":59700},"Actualiza el chart de Helm",[],{"_2937":59701,"_26000":59700,"_18071":99333,"_5":17966,"_24599":59700,"_2447":99334},[],"Actualiza un despliegue de Lamassu gestionado con Helm, incluida la migración del chart de 3.8.0 a 4.0.0 y los pasos de datos persistentes de KMS y VA.",{"_2937":59702,"_26000":59700,"_5":26336,"_18071":99336,"_24599":99337,"_2447":99330},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#actualiza-el-chart-de-helm",{"_2937":59703,"_26000":59700,"_5":26336,"_18071":99339,"_24599":99340,"_2447":99341},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#qué-cambia-en-la-400","Qué cambia en la 4.0.0",{"_2937":59704,"_26000":59700,"_5":26336,"_18071":99343,"_24599":99344,"_2447":99345},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#qué-hace-automáticamente-el-job-de-upgrade","Qué hace automáticamente el job de upgrade",{"_2937":59705,"_26000":59700,"_5":26336,"_18071":99347,"_24599":99348,"_2447":99349},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#antes-de-actualizar","Antes de actualizar",{"_2937":59706,"_26000":59700,"_5":26336,"_18071":99351,"_24599":99352,"_2447":99353},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#actualiza-el-archivo-de-valores","Actualiza el archivo de valores",{"_2937":59707,"_26000":59700,"_5":26336,"_18071":99355,"_24599":99356,"_2447":99357},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#ejecuta-el-upgrade","Ejecuta el upgrade",{"_2937":59708,"_26000":59700,"_5":26336,"_18071":99359,"_24599":99360,"_2447":99361},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#migra-los-datos-de-kms-y-va","Migra los datos de KMS y VA",{"_2937":59709,"_26000":59700,"_5":26336,"_18071":99363,"_24599":99364,"_2447":99365},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#verifica-la-migración","Verifica la migración",{"_2937":59710,"_26000":59700,"_5":26336,"_18071":99367,"_24599":99368,"_2447":99369},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_2937":59711,"_26000":59700,"_5":26336,"_18071":99371,"_24599":99372,"_2447":99373},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#resolución-de-problemas","Resolución de problemas",{"_2937":59712,"_26000":59700,"_5":26336,"_18071":99375,"_24599":99376,"_2447":99377},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/migration#páginas-relacionadas","Páginas relacionadas",{"_2937":59713,"_26000":59700,"_18071":99379,"_5":17966,"_24599":99337,"_2447":99380},[],"Usa esta guía para actualizar un despliegue gestionado con Helm. Recorre la migración del chart de 3.8.0 a 4.0.0 por completo: los valores que debes revisar, los cambios de base de datos que el chart aplica automáticamente y los pasos manuales para las instalaciones que mantienen claves KMS o CRL de VA en volúmenes locales. Las notas específicas de otras versiones están en el directorio `charts/lamassu/CHANGELOG/` del repositorio `lamassu-helm`.",{"_2937":59714,"_26000":59700,"_18071":99382,"_5":17966,"_24599":99337,"_2447":99383},[],"Si no actualizas un release existente, ve directamente a Instala con Helm. Los pasos manuales de datos de esta página solo aplican a despliegues actualizados desde 3.8.x que usan almacenamiento local de KMS o VA.",{"_2937":59715,"_26000":59700,"_18071":99385,"_5":17966,"_24599":99340,"_2447":99386},[],"La versión 4.0.0 es un release de hardening de seguridad. Tres cambios afectan a las actualizaciones:",{"_2937":59716,"_26000":59700,"_18071":99388,"_5":17966,"_24599":99340,"_2447":99389},[],"**Nombres de recursos dependientes del release.** Todos los recursos gestionados por el chart se llaman ahora `<release>-lamassu-<componente>`, por ejemplo `lamassu-kms`, en lugar de los nombres fijos sin ámbito usados en 3.8.0 (`kms`, `va`, `ca`, ...). Con un release llamado `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`, no `prod-kms`. Los valores `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_2937":59717,"_26000":59700,"_18071":99391,"_5":17966,"_24599":99340,"_2447":99392},[],"**Contenedores sin root.** Todas las cargas de trabajo se ejecutan como el usuario numérico `65532:65532` con perfil seccomp `RuntimeDefault` y capacidades eliminadas. Los pods no montan el token del service account por defecto y el chart crea una ServiceAccount dedicada.",{"_2937":59718,"_26000":59700,"_18071":99394,"_5":17966,"_24599":99340,"_2447":99395},[],"**Validación estricta de valores.** `values.schema.json` rechaza claves de nivel superior desconocidas, por lo que los bloques heredados de 3.8.0 fallan en `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_2937":59719,"_26000":59700,"_18071":99397,"_5":17966,"_24599":99340,"_2447":99398},[],"`services.connectors` pasa además a ser un mapa indexado por el ID del conector, y el chart ya no inyecta anti-afinidad de pods ni reglas de topology spread.",{"_2937":59720,"_26000":59700,"_18071":99400,"_5":17966,"_24599":99340,"_2447":99401},[],"Kubernetes deriva el nombre del PVC del nombre del pod del StatefulSet (`<volumeClaimTemplate>-<nombre-del-pod>`). Renombrar los StatefulSets `kms` y `va` hace que `helm upgrade` enlace PVC nuevos y vacíos en lugar de los existentes. Tu material de claves de KMS y las CRL de VA no se eliminan — los PVC antiguos quedan huérfanos, no destruidos — pero los pods actualizados no los encuentran y fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que muevas los datos manualmente. Todos los demás recursos renombrados son sin estado y se recrean sin riesgo de pérdida de datos.",{"_2937":59721,"_26000":59700,"_18071":99403,"_5":17966,"_24599":99344,"_2447":99404},[],"Antes de que arranque cualquier servicio, el job de pre-install/pre-upgrade del chart prepara PostgreSQL:",{"_2937":59722,"_26000":59700,"_18071":99406,"_5":17966,"_24599":99344,"_2447":99407},[],"Crea las bases de datos `pki`, `authz` y `wfx` si no existen.",{"_2937":59723,"_26000":59700,"_18071":99409,"_5":17966,"_24599":99344,"_2447":99410},[],"Garantiza un schema por base de datos de servicio (`alerts`, `ca`, `va`, `devicemanager`, `dmsmanager`, `kms`) dentro de la base de datos compartida `pki` y consolida en ella las bases de datos separadas por servicio de 3.8.0, importando sus datos.",{"_2937":59724,"_26000":59700,"_18071":99412,"_5":17966,"_24599":99344,"_2447":99413},[],"Ejecuta las migraciones de base de datos de cada schema.",{"_2937":59725,"_26000":59700,"_18071":99415,"_5":17966,"_24599":99344,"_2447":99416},[],"Migra authz, precarga sus políticas y provisiona los principales de `services.authz.bootstrap`.",{"_2937":59726,"_26000":59700,"_18071":99418,"_5":17966,"_24599":99344,"_2447":99419},[],"El job es idempotente, por lo que un upgrade fallido puede reintentarse. Requiere un rol de PostgreSQL autorizado para crear bases de datos y schemas, como se describe en Instala con Helm.",{"_2937":59727,"_26000":59700,"_18071":99421,"_5":17966,"_24599":99348,"_2447":99422},[],"Anota los nombres de tus PVC existentes de almacenamiento local:",{"_2937":59728,"_26000":59700,"_18071":99424,"_5":17966,"_24599":99348,"_2447":99425},[],"`helm upgrade` no toca ni elimina los PVC antiguos, pero tras el upgrade nada los referencia. Necesitas sus nombres para copiar los datos y limpiar después; no los elimines hasta verificar los volúmenes nuevos.",{"_2937":59729,"_26000":59700,"_18071":99427,"_5":17966,"_24599":99348,"_2447":99428},[],"Elimina los valores que el schema estricto ahora rechaza, por ejemplo el bloque antiguo `toolbox:`. Actualiza el archivo de valores recoge cada renombrado.",{"_2937":59730,"_26000":59700,"_18071":99430,"_5":17966,"_24599":99352,"_2447":99431},[],"**Añade `services.authz` (obligatorio).** La 3.8.0 no tenía servicio de autorización: toda ruta aceptaba cualquier token válido. La 4.0.0 añade autorización fina a nivel de entidad, y un archivo de valores de 3.8.0 no tiene nada que migrar — debes añadir la configuración:",{"_2937":59731,"_26000":59700,"_18071":99433,"_5":17966,"_24599":99352,"_2447":99434},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, grants y políticas (`services.authz.database`, `authz` por defecto).",{"_2937":59732,"_26000":59700,"_18071":99436,"_5":17966,"_24599":99352,"_2447":99437},[],"`pki` es la base de datos que el motor de autorización consulta al evaluar políticas contra entidades como CA, certificados, dispositivos, DMS, claves KMS y roles de VA.",{"_2937":59733,"_26000":59700,"_18071":99439,"_5":17966,"_24599":99352,"_2447":99440},[],"De cada entrada de credentials solo se lee el campo `database`. Los parámetros de conexión siempre provienen de los valores globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_2937":59734,"_26000":59700,"_18071":99442,"_5":17966,"_24599":99352,"_2447":99443},[],"Comprueba que `services.authz.bootstrap` (presente por defecto en el chart) coincide con cómo tu proveedor OIDC asigna el rol de realm `pki-admin`. Sin un principal que coincida con la regla de bootstrap, nadie podrá administrar la PKI — no existe un superusuario implícito.",{"_2937":59735,"_26000":59700,"_18071":99445,"_5":17966,"_24599":99352,"_2447":99446},[],"**Renombra `toolbox` a `connectivityTest`.** El hook de conectividad de `helm test` usa ahora la imagen `curlimages/curl`, mantenida upstream y fijada por digest, en lugar de la imagen de toolbox propia del chart:",{"_2937":59736,"_26000":59700,"_18071":99448,"_5":17966,"_24599":99352,"_2447":99449},[],"**Elimina las sobrecargas de identidad por servicio.** `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999` ya no existen. Todos los servicios se ejecutan con el `65532:65532` global del chart, y el acceso de grupo a los volúmenes de KMS y al socket PKCS#11 se gestiona automáticamente mediante el `fsGroup: 65532` del pod.",{"_2937":59737,"_26000":59700,"_18071":99451,"_5":17966,"_24599":99352,"_2447":99452},[],"**Convierte `services.connectors` en un mapa.** Cada entrada se indexa por su ID estable de conector y declara `type` e `image`:",{"_2937":59738,"_26000":59700,"_18071":99454,"_5":17966,"_24599":99352,"_2447":99455},[],"**Revisa los valores del emisor TLS.** Con `tls.certManagerOptions.issuer` vacío (el valor por defecto), el chart crea un emisor self-signed dependiente del release — por ejemplo `lamassu-downstream-ca-selfsigned-issuer` con el release `lamassu`. El valor legado literal `downstream-ca-selfsigned-issuer` de los values de la era 3.8.0 sigue aceptándose y resuelve al mismo emisor dependiente del release; apunta `tls.certManagerOptions.clusterIssuer` a tu propio emisor para TLS corporativo.",{"_2937":59739,"_26000":59700,"_18071":99457,"_5":17966,"_24599":99352,"_2447":99458},[],"**Revisa scheduling y puertos.** El chart ya no inyecta anti-afinidad de pods ni restricciones de topology spread — configura `affinity` y `topologySpreadConstraints` explícitamente donde tu clúster las necesite. El valor por defecto de `services.ui.port` es ahora `8085`, el puerto sin privilegios global del chart que usa la imagen sin root, así que actualiza las sobrecargas que fijaban `80`. El bloque compartido `probes:` se sustituye por bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_2937":59740,"_26000":59700,"_18071":99460,"_5":17966,"_24599":99356,"_2447":99461},[],"Helm ejecuta el job de base de datos antes de aplicar cualquier carga de trabajo, por lo que ningún servicio arranca contra una base de datos sin preparar. Si la validación rechaza valores desconocidos, corrige el archivo y vuelve a ejecutarlo.",{"_2937":59741,"_26000":59700,"_18071":99463,"_5":17966,"_24599":99360,"_2447":99464},[],"Omite esta sección en instalaciones nuevas, o si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_2937":59742,"_26000":59700,"_18071":99466,"_5":17966,"_24599":99360,"_2447":99467},[],"**Identifica los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre del release y de cualquier `nameOverride`/`fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre-del-StatefulSet>-0`:",{"_2937":59743,"_26000":59700,"_18071":99469,"_5":17966,"_24599":99360,"_2447":99470},[],"Con el release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con el release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar.",{"_2937":59744,"_26000":59700,"_18071":99472,"_5":17966,"_24599":99360,"_2447":99473},[],"**Reduce a cero los nuevos StatefulSets** para que nada escriba en ninguno de los volúmenes mientras copias:",{"_2937":59745,"_26000":59700,"_18071":99475,"_5":17966,"_24599":99360,"_2447":99476},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC:",{"_2937":59746,"_26000":59700,"_18071":99478,"_5":17966,"_24599":99360,"_2447":99479},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_2937":59747,"_26000":59700,"_18071":99481,"_5":17966,"_24599":99360,"_2447":99482},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos.",{"_2937":59748,"_26000":59700,"_18071":99484,"_5":17966,"_24599":99360,"_2447":99485},[],"**Copia los datos y ajusta la propiedad**:",{"_2937":59749,"_26000":59700,"_18071":99487,"_5":17966,"_24599":99360,"_2447":99488},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan ser de un usuario sin root. La 3.8.0 no fijaba la identidad del contenedor, por lo que los archivos podían llevar cualquier UID declarado por la imagen; la 4.0.0 exige exactamente `65532:65532` y no retrocede a lo que declare la imagen.",{"_2937":59750,"_26000":59700,"_18071":99490,"_5":17966,"_24599":99360,"_2447":99491},[],"**Vuelve a escalar y elimina el auxiliar**:",{"_2937":59751,"_26000":59700,"_18071":99493,"_5":17966,"_24599":99364,"_2447":99494},[],"Los logs de KMS y VA no muestran errores `no such file or directory` ni `code=NotFound`.",{"_2937":59752,"_26000":59700,"_18071":99496,"_5":17966,"_24599":99364,"_2447":99497},[],"Una CRL emitida anteriormente vuelve a servirse: `GET /crl/<ca-ski>` sobre VA.",{"_2937":59753,"_26000":59700,"_18071":99499,"_5":17966,"_24599":99364,"_2447":99500},[],"`helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook de conectividad comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_2937":59754,"_26000":59700,"_18071":99502,"_5":17966,"_24599":99364,"_2447":99503},[],"Inicia sesión con una identidad de administrador y confirma que las operaciones están autorizadas.",{"_2937":59755,"_26000":59700,"_18071":99505,"_5":17966,"_24599":99368,"_2447":99506},[],"Solo cuando todo funcione, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento:",{"_2937":59756,"_26000":59700,"_18071":99508,"_5":17966,"_24599":99372,"_2447":99509},[],"**Los pods de KMS o VA fallan con `no such file or directory` o `code=NotFound` justo después del upgrade.** Los pods nuevos están enlazados a los PVC nuevos y vacíos y la migración de datos todavía no se ha ejecutado, o se copió en el PVC equivocado. Sigue Migra los datos de KMS y VA y comprueba que existen las cuatro PVC.",{"_2937":59757,"_26000":59700,"_18071":99511,"_5":17966,"_24599":99372,"_2447":99512},[],"**`helm upgrade` falla con un error de validación de clave desconocida.** Elimina o renombra los valores heredados — normalmente el bloque `toolbox:` — porque el schema estricto rechaza claves de nivel superior desconocidas.",{"_2937":59758,"_26000":59700,"_18071":99514,"_5":17966,"_24599":99372,"_2447":99515},[],"**El upgrade falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos ni schemas; concede los privilegios necesarios, o crea tú mismo las bases de datos `pki`, `authz` y `wfx`, y vuelve a ejecutar el upgrade.",{"_2937":59759,"_26000":59700,"_18071":99517,"_5":17966,"_24599":99372,"_2447":99518},[],"**Nadie puede iniciar sesión tras el upgrade.** Comprueba que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente (ver Control de acceso) y que el job de migración terminó correctamente.",{"_2937":59760,"_26000":59700,"_18071":99520,"_5":17966,"_24599":99376,"_2447":99521},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2937":59761,"_26000":59700,"_18071":99523,"_5":17966,"_24599":99376,"_2447":99524},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo y gestiona el direccionamiento del Gateway.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2937":59762,"_26000":59762,"_5":12545,"_2447":99526,"_26339":99527,"_18071":99528,"_24599":59762},"Expón el Gateway",[42089,98635,98869],[],{"_2937":59763,"_26000":59762,"_18071":99530,"_5":17966,"_24599":59762,"_2447":99531},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2937":59764,"_26000":59762,"_5":26336,"_18071":99533,"_24599":99534,"_2447":99535},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2937":59765,"_26000":59762,"_5":26336,"_18071":99537,"_24599":99538,"_2447":99539},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2937":59766,"_26000":59762,"_5":26336,"_18071":99541,"_24599":99542,"_2447":99543},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2937":59767,"_26000":59762,"_5":26336,"_18071":99545,"_24599":99546,"_2447":43035},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#k3s",{"_2937":59768,"_26000":59762,"_5":26336,"_18071":99548,"_24599":99549,"_2447":99550},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2937":59769,"_26000":59762,"_5":26336,"_18071":99552,"_24599":99553,"_2447":99554},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2937":59770,"_26000":59762,"_5":26336,"_18071":99556,"_24599":99557,"_2447":99558},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2937":59771,"_26000":59762,"_5":26336,"_18071":99560,"_24599":99561,"_2447":99562},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2937":59772,"_26000":59762,"_5":26336,"_18071":99564,"_24599":99565,"_2447":99566},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2937":59773,"_26000":59762,"_18071":99568,"_5":17966,"_24599":99534,"_2447":99569},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2937":59774,"_26000":59762,"_18071":99571,"_5":17966,"_24599":99534,"_2447":99572},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2937":59775,"_26000":59762,"_18071":99574,"_5":17966,"_24599":99538,"_2447":99575},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2937":59776,"_26000":59762,"_18071":99577,"_5":17966,"_24599":99538,"_2447":99578},[],"Defínelo únicamente cuando:",{"_2937":59777,"_26000":59762,"_18071":99580,"_5":17966,"_24599":99538,"_2447":99581},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2937":59778,"_26000":59762,"_18071":99583,"_5":17966,"_24599":99538,"_2447":99584},[],"esa dirección está asignada a este Gateway",{"_2937":59779,"_26000":59762,"_18071":99586,"_5":17966,"_24599":99538,"_2447":99587},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2937":59780,"_26000":59762,"_18071":99589,"_5":17966,"_24599":99538,"_2447":99590},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2937":59781,"_26000":59762,"_18071":99592,"_5":17966,"_24599":99538,"_2447":99593},[],"No confundas estos valores:",{"_2937":59782,"_26000":59762,"_18071":99595,"_5":17966,"_24599":99538,"_2447":99596},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2937":59783,"_26000":59762,"_18071":99598,"_5":17966,"_24599":99538,"_2447":99599},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2937":59784,"_26000":59762,"_18071":99601,"_5":17966,"_24599":99538,"_2447":99602},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2937":59785,"_26000":59762,"_18071":99604,"_5":17966,"_24599":99542,"_2447":99605},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2937":59786,"_26000":59762,"_18071":99607,"_5":17966,"_24599":99542,"_2447":99608},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2937":59787,"_26000":59762,"_18071":99610,"_5":17966,"_24599":99546,"_2447":99611},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2937":59788,"_26000":59762,"_18071":99613,"_5":17966,"_24599":99546,"_2447":99614},[],"Para el diseño recomendado:",{"_2937":59789,"_26000":59762,"_18071":99616,"_5":17966,"_24599":99546,"_2447":99617},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2937":59790,"_26000":59762,"_18071":99619,"_5":17966,"_24599":99546,"_2447":99620},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2937":59791,"_26000":59762,"_18071":99622,"_5":17966,"_24599":99546,"_2447":99623},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2937":59792,"_26000":59762,"_18071":99625,"_5":17966,"_24599":99546,"_2447":99626},[],"Apunta DNS a la dirección accesible de la VM.",{"_2937":59793,"_26000":59762,"_18071":99628,"_5":17966,"_24599":99546,"_2447":99629},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2937":59794,"_26000":59762,"_18071":99631,"_5":17966,"_24599":99549,"_2447":99632},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2937":59795,"_26000":59762,"_18071":99634,"_5":17966,"_24599":99553,"_2447":99635},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2937":59796,"_26000":59762,"_18071":99637,"_5":17966,"_24599":99553,"_2447":99638},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2937":59797,"_26000":59762,"_18071":99640,"_5":17966,"_24599":99557,"_2447":99641},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2937":59798,"_26000":59762,"_18071":99643,"_5":17966,"_24599":99557,"_2447":99644},[],"Requisito",{"_2937":59799,"_26000":59762,"_18071":99646,"_5":17966,"_24599":99557,"_2447":99647},[],"Diseño recomendado",{"_2937":59800,"_26000":59762,"_18071":99649,"_5":17966,"_24599":99557,"_2447":99650},[],"Consecuencia",{"_2937":59801,"_26000":59762,"_18071":99652,"_5":17966,"_24599":99557,"_2447":99653},[],"Varias URL o servicios de Lamassu",{"_2937":59802,"_26000":59762,"_18071":99655,"_5":17966,"_24599":99557,"_2447":99656},[],"Un Gateway con varias rutas",{"_2937":59803,"_26000":59762,"_18071":99658,"_5":17966,"_24599":99557,"_2447":99659},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2937":59804,"_26000":59762,"_18071":99661,"_5":17966,"_24599":99557,"_2447":99662},[],"Gateways independientes e IP externas distintas",{"_2937":59805,"_26000":59762,"_18071":99664,"_5":17966,"_24599":99557,"_2447":99665},[],"Una VIP por Gateway",{"_2937":59806,"_26000":59762,"_18071":99667,"_5":17966,"_24599":99557,"_2447":99668},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2937":59807,"_26000":59762,"_18071":99670,"_5":17966,"_24599":99557,"_2447":99671},[],"Gateways independientes, un nodo y una IP",{"_2937":59808,"_26000":59762,"_18071":99673,"_5":17966,"_24599":99557,"_2447":99674},[],"Puertos externos diferentes",{"_2937":59809,"_26000":59762,"_18071":99676,"_5":17966,"_24599":99557,"_2447":99677},[],"Los clientes deben indicar puertos no estándar",{"_2937":59810,"_26000":59762,"_18071":99679,"_5":17966,"_24599":99557,"_2447":99680},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2937":59811,"_26000":59762,"_18071":99682,"_5":17966,"_24599":99557,"_2447":99683},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2937":59812,"_26000":59762,"_18071":99685,"_5":17966,"_24599":99557,"_2447":99686},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2937":59813,"_26000":59762,"_18071":99688,"_5":17966,"_24599":99557,"_2447":99689},[],"Recursos Gateway separados pero proxy compartido",{"_2937":59814,"_26000":59762,"_18071":99691,"_5":17966,"_24599":99557,"_2447":99692},[],"Modo merged Gateway de Envoy",{"_2937":59815,"_26000":59762,"_18071":99694,"_5":17966,"_24599":99557,"_2447":99695},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2937":59816,"_26000":59762,"_18071":99697,"_5":17966,"_24599":99557,"_2447":99698},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2937":59817,"_26000":59762,"_18071":99700,"_5":17966,"_24599":99557,"_2447":99701},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2937":59818,"_26000":59762,"_18071":99703,"_5":17966,"_24599":99557,"_2447":99704},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2937":59819,"_26000":59762,"_18071":99706,"_5":17966,"_24599":99557,"_2447":99707},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2937":59820,"_26000":59762,"_18071":99709,"_5":17966,"_24599":99561,"_2447":99710},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2937":59821,"_26000":59762,"_18071":99712,"_5":17966,"_24599":99561,"_2447":99713},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2937":59822,"_26000":59762,"_18071":99715,"_5":17966,"_24599":99561,"_2447":99716},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2937":59823,"_26000":59762,"_18071":99718,"_5":17966,"_24599":99561,"_2447":99719},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2937":59824,"_26000":59762,"_18071":99721,"_5":17966,"_24599":99561,"_2447":99722},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2937":59825,"_26000":59762,"_18071":99724,"_5":17966,"_24599":99565,"_2447":99725},[],"Comprueba, en orden:",{"_2937":59826,"_26000":59762,"_18071":99727,"_5":17966,"_24599":99565,"_2447":99728},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2937":59827,"_26000":59762,"_18071":99730,"_5":17966,"_24599":99565,"_2447":99731},[],"Su estado contiene la dirección esperada.",{"_2937":59828,"_26000":59762,"_18071":99733,"_5":17966,"_24599":99565,"_2447":99734},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2937":59829,"_26000":59762,"_18071":99736,"_5":17966,"_24599":99565,"_2447":99737},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2937":59830,"_26000":59762,"_18071":99739,"_5":17966,"_24599":99565,"_2447":99740},[],"DNS resuelve al endpoint accesible externamente.",{"_2937":59831,"_26000":59762,"_18071":99742,"_5":17966,"_24599":99565,"_2447":99743},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2937":59832,"_26000":59762,"_18071":99745,"_5":17966,"_24599":99565,"_2447":99746},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2937":59833,"_26000":59833,"_5":12545,"_2447":42196,"_26339":99748,"_18071":99749,"_24599":59833},[42089,98635,98869],[],{"_2937":59834,"_26000":59833,"_18071":99751,"_5":17966,"_24599":59833,"_2447":99752},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2937":59835,"_26000":59833,"_5":26336,"_18071":99754,"_24599":99755,"_2447":99756},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2937":59836,"_26000":59833,"_5":26336,"_18071":99758,"_24599":99759,"_2447":99760},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2937":59837,"_26000":59833,"_5":26336,"_18071":99762,"_24599":99763,"_2447":99764},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2937":59838,"_26000":59833,"_5":26336,"_18071":99766,"_24599":99767,"_2447":99768},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2937":59839,"_26000":59833,"_5":26336,"_18071":99770,"_24599":99771,"_2447":99772},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2937":59840,"_26000":59833,"_5":26336,"_18071":99774,"_24599":99775,"_2447":99776},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2937":59841,"_26000":59833,"_18071":99778,"_5":17966,"_24599":99755,"_2447":99779},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2937":59842,"_26000":59833,"_18071":99781,"_5":17966,"_24599":99759,"_2447":99782},[],"Flujo",{"_2937":59843,"_26000":59833,"_18071":99784,"_5":17966,"_24599":99759,"_2447":99785},[],"Úsalo para",{"_2937":59844,"_26000":59833,"_18071":99787,"_5":17966,"_24599":99759,"_2447":99788},[],"Qué instala",{"_2937":59845,"_26000":59833,"_18071":99790,"_5":17966,"_24599":99759,"_2447":43280},[],{"_2937":59846,"_26000":59833,"_18071":99792,"_5":17966,"_24599":99759,"_2447":99793},[],"Producción y entornos controlados",{"_2937":59847,"_26000":59833,"_18071":99795,"_5":17966,"_24599":99759,"_2447":99796},[],"Servicios de Lamassu y recursos de Gateway API",{"_2937":59848,"_26000":59833,"_18071":99798,"_5":17966,"_24599":99759,"_2447":42333},[],{"_2937":59849,"_26000":59833,"_18071":99800,"_5":17966,"_24599":99759,"_2447":99801},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2937":59850,"_26000":59833,"_18071":99803,"_5":17966,"_24599":99759,"_2447":99804},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2937":59851,"_26000":59833,"_18071":99806,"_5":17966,"_24599":99763,"_2447":99807},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2937":59852,"_26000":59833,"_18071":99809,"_5":17966,"_24599":99763,"_2447":99810},[],"Área",{"_2937":59853,"_26000":59833,"_18071":99812,"_5":17966,"_24599":99763,"_2447":99813},[],"El chart de Lamassu proporciona",{"_2937":59854,"_26000":59833,"_18071":99815,"_5":17966,"_24599":99763,"_2447":99816},[],"Tú proporcionas",{"_2937":59855,"_26000":59833,"_18071":99818,"_5":17966,"_24599":99763,"_2447":99819},[],"Aplicaciones Lamassu",{"_2937":59856,"_26000":59833,"_18071":99821,"_5":17966,"_24599":99763,"_2447":99822},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2937":59857,"_26000":59833,"_18071":99824,"_5":17966,"_24599":99763,"_2447":99825},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2937":59858,"_26000":59833,"_18071":99827,"_5":17966,"_24599":99763,"_2447":99828},[],"Datos PostgreSQL",{"_2937":59859,"_26000":59833,"_18071":99830,"_5":17966,"_24599":99763,"_2447":99831},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2937":59860,"_26000":59833,"_18071":99833,"_5":17966,"_24599":99763,"_2447":99834},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2937":59861,"_26000":59833,"_18071":99836,"_5":17966,"_24599":99763,"_2447":99837},[],"Mensajería",{"_2937":59862,"_26000":59833,"_18071":99839,"_5":17966,"_24599":99763,"_2447":99840},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2937":59863,"_26000":59833,"_18071":99842,"_5":17966,"_24599":99763,"_2447":99843},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2937":59864,"_26000":59833,"_18071":99845,"_5":17966,"_24599":99763,"_2447":99846},[],"Identidad",{"_2937":59865,"_26000":59833,"_18071":99848,"_5":17966,"_24599":99763,"_2447":99849},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2937":59866,"_26000":59833,"_18071":99851,"_5":17966,"_24599":99763,"_2447":99852},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2937":59867,"_26000":59833,"_18071":99854,"_5":17966,"_24599":99763,"_2447":99855},[],"Enrutamiento externo",{"_2937":59868,"_26000":59833,"_18071":99857,"_5":17966,"_24599":99763,"_2447":99858},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2937":59869,"_26000":59833,"_18071":99860,"_5":17966,"_24599":99763,"_2447":99861},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2937":59870,"_26000":59833,"_18071":99863,"_5":17966,"_24599":99763,"_2447":43354},[],{"_2937":59871,"_26000":59833,"_18071":99865,"_5":17966,"_24599":99763,"_2447":99866},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2937":59872,"_26000":59833,"_18071":99868,"_5":17966,"_24599":99763,"_2447":99869},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2937":59873,"_26000":59833,"_18071":99871,"_5":17966,"_24599":99763,"_2447":99872},[],"Datos persistentes de la aplicación",{"_2937":59874,"_26000":59833,"_18071":99874,"_5":17966,"_24599":99763,"_2447":99875},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2937":59875,"_26000":59833,"_18071":99877,"_5":17966,"_24599":99763,"_2447":99878},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2937":59876,"_26000":59833,"_18071":99880,"_5":17966,"_24599":99763,"_2447":99881},[],"Integraciones opcionales",{"_2937":59877,"_26000":59833,"_18071":99883,"_5":17966,"_24599":99763,"_2447":99884},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2937":59878,"_26000":59833,"_18071":99886,"_5":17966,"_24599":99763,"_2447":99887},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2937":59879,"_26000":59833,"_18071":99889,"_5":17966,"_24599":99763,"_2447":99890},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2937":59880,"_26000":59833,"_18071":99892,"_5":17966,"_24599":99763,"_2447":99893},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2937":59881,"_26000":59833,"_18071":99895,"_5":17966,"_24599":99767,"_2447":99896},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2937":59882,"_26000":59833,"_18071":99898,"_5":17966,"_24599":99767,"_2447":99899},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2937":59883,"_26000":59833,"_18071":99901,"_5":17966,"_24599":99771,"_2447":99902},[],"Kubernetes 1.24 o posterior",{"_2937":59884,"_26000":59833,"_18071":99904,"_5":17966,"_24599":99771,"_2447":99905},[],"Helm 3.2 o posterior",{"_2937":59885,"_26000":59833,"_18071":99907,"_5":17966,"_24599":99771,"_2447":99908},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2937":59886,"_26000":59833,"_18071":99910,"_5":17966,"_24599":99771,"_2447":99911},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2937":59887,"_26000":59833,"_18071":99913,"_5":17966,"_24599":99771,"_2447":99914},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2937":59888,"_26000":59833,"_18071":99916,"_5":17966,"_24599":99771,"_2447":99917},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2937":59889,"_26000":59833,"_18071":99919,"_5":17966,"_24599":99771,"_2447":99920},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2937":59890,"_26000":59833,"_18071":99922,"_5":17966,"_24599":99775,"_2447":99923},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2937":59891,"_26000":59833,"_18071":99925,"_5":17966,"_24599":99775,"_2447":99926},[],"<Card title=\"Actualiza el chart\" description=\"Actualiza un release de Helm existente, incluidos los pasos de migración de 3.8.0 a 4.0.0.\" href=\"/docs/deployment/self-hosted/migration\" />",{"_2937":59892,"_26000":59833,"_18071":99928,"_5":17966,"_24599":99775,"_2447":99929},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2937":59893,"_26000":59833,"_18071":99931,"_5":17966,"_24599":99775,"_2447":99932},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2937":59894,"_26000":59894,"_5":12545,"_2447":99934,"_26339":99935,"_18071":99937,"_24599":59894},"Resolución de problemas de despliegue",[42089,98635,99936],"Operación",[],{"_2937":59895,"_26000":59894,"_18071":99939,"_5":17966,"_24599":59894,"_2447":99940},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2937":59896,"_26000":59894,"_5":26336,"_18071":99942,"_24599":99943,"_2447":99944},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2937":59897,"_26000":59894,"_5":26336,"_18071":99946,"_24599":99947,"_2447":99948},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2937":59898,"_26000":59894,"_5":26336,"_18071":99950,"_24599":99951,"_2447":99952},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2937":59899,"_26000":59894,"_5":26336,"_18071":99954,"_24599":99955,"_2447":99956},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2937":59900,"_26000":59894,"_5":26336,"_18071":99958,"_24599":99959,"_2447":99960},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2937":59901,"_26000":59894,"_5":26336,"_18071":99962,"_24599":99963,"_2447":99964},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2937":59902,"_26000":59894,"_5":26336,"_18071":99966,"_24599":99967,"_2447":99968},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2937":59903,"_26000":59894,"_5":26336,"_18071":99970,"_24599":99971,"_2447":99972},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2937":59904,"_26000":59894,"_5":26336,"_18071":99974,"_24599":99975,"_2447":99976},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2937":59905,"_26000":59894,"_5":26336,"_18071":99978,"_24599":99979,"_2447":99980},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2937":59906,"_26000":59894,"_5":26336,"_18071":99982,"_24599":99983,"_2447":99984},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2937":59907,"_26000":59894,"_5":26336,"_18071":99986,"_24599":99987,"_2447":99988},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2937":59908,"_26000":59894,"_18071":99990,"_5":17966,"_24599":59894,"_2447":99991},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2937":59909,"_26000":59894,"_18071":99993,"_5":17966,"_24599":99947,"_2447":99994},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2937":59910,"_26000":59894,"_18071":99996,"_5":17966,"_24599":99951,"_2447":99997},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2937":59911,"_26000":59894,"_18071":99999,"_5":17966,"_24599":99955,"_2447":100000},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2937":59912,"_26000":59894,"_18071":100002,"_5":17966,"_24599":99959,"_2447":100003},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2937":59913,"_26000":59894,"_18071":100005,"_5":17966,"_24599":99963,"_2447":100006},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2937":59914,"_26000":59894,"_18071":100008,"_5":17966,"_24599":99967,"_2447":100009},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2937":59915,"_26000":59894,"_18071":100011,"_5":17966,"_24599":99967,"_2447":100012},[],"Ejecuta también la prueba de conectividad del chart:",{"_2937":59916,"_26000":59894,"_18071":100014,"_5":17966,"_24599":99967,"_2447":100015},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2937":59917,"_26000":59894,"_18071":100017,"_5":17966,"_24599":99967,"_2447":100018},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2937":59918,"_26000":59894,"_18071":100020,"_5":17966,"_24599":99971,"_2447":100021},[],"Si recibes un 401:",{"_2937":59919,"_26000":59894,"_18071":100023,"_5":17966,"_24599":99971,"_2447":100024},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2937":59920,"_26000":59894,"_18071":100026,"_5":17966,"_24599":99971,"_2447":100027},[],"verifica emisor, audiencia y expiración del token;",{"_2937":59921,"_26000":59894,"_18071":100029,"_5":17966,"_24599":99971,"_2447":100030},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2937":59922,"_26000":59894,"_18071":100032,"_5":17966,"_24599":99971,"_2447":100033},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2937":59923,"_26000":59894,"_18071":100035,"_5":17966,"_24599":99971,"_2447":100036},[],"Si el login termina pero las APIs devuelven 403:",{"_2937":59924,"_26000":59894,"_18071":100038,"_5":17966,"_24599":99971,"_2447":100039},[],"inspecciona los claims reales del token;",{"_2937":59925,"_26000":59894,"_18071":100041,"_5":17966,"_24599":99971,"_2447":100042},[],"confirma que coinciden con un principal activo;",{"_2937":59926,"_26000":59894,"_18071":100044,"_5":17966,"_24599":99971,"_2447":100045},[],"revisa las políticas concedidas al principal;",{"_2937":59927,"_26000":59894,"_18071":100047,"_5":17966,"_24599":99971,"_2447":100048},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2937":59928,"_26000":59894,"_18071":100050,"_5":17966,"_24599":99971,"_2447":100051},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2937":59929,"_26000":59894,"_18071":100053,"_5":17966,"_24599":99975,"_2447":100054},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2937":59930,"_26000":59894,"_18071":100056,"_5":17966,"_24599":99975,"_2447":100057},[],"Localiza el pod y Service de authz.",{"_2937":59931,"_26000":59894,"_18071":100059,"_5":17966,"_24599":99975,"_2447":100060},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2937":59932,"_26000":59894,"_18071":100062,"_5":17966,"_24599":99975,"_2447":100063},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2937":59933,"_26000":59894,"_18071":100065,"_5":17966,"_24599":99975,"_2447":100066},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2937":59934,"_26000":59894,"_18071":100068,"_5":17966,"_24599":99975,"_2447":100069},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2937":59935,"_26000":59894,"_18071":100071,"_5":17966,"_24599":99979,"_2447":100072},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2937":59936,"_26000":59894,"_18071":100074,"_5":17966,"_24599":99979,"_2447":100075},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2937":59937,"_26000":59894,"_18071":100077,"_5":17966,"_24599":99979,"_2447":100078},[],"volumen persistente sin enlazar;",{"_2937":59938,"_26000":59894,"_18071":100080,"_5":17966,"_24599":99979,"_2447":100081},[],"imagen inaccesible o política de pull incorrecta;",{"_2937":59939,"_26000":59894,"_18071":100083,"_5":17966,"_24599":99979,"_2447":100084},[],"configuración inválida del motor criptográfico;",{"_2937":59940,"_26000":59894,"_18071":100086,"_5":17966,"_24599":99979,"_2447":100087},[],"límites de CPU o memoria demasiado bajos;",{"_2937":59941,"_26000":59894,"_18071":100089,"_5":17966,"_24599":99979,"_2447":100090},[],"migración previa incompleta.",{"_2937":59942,"_26000":59894,"_18071":100092,"_5":17966,"_24599":99979,"_2447":100093},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2937":59943,"_26000":59894,"_18071":100095,"_5":17966,"_24599":99979,"_2447":100096},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2937":59944,"_26000":59894,"_18071":100098,"_5":17966,"_24599":99983,"_2447":100099},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2937":59945,"_26000":59894,"_18071":100101,"_5":17966,"_24599":99983,"_2447":100102},[],"verifica que esté habilitado en el servicio emisor;",{"_2937":59946,"_26000":59894,"_18071":100104,"_5":17966,"_24599":99983,"_2447":100105},[],"comprueba conectividad y credenciales AMQP;",{"_2937":59947,"_26000":59894,"_18071":100107,"_5":17966,"_24599":99983,"_2447":100108},[],"revisa exchange, routing key, colas y consumidores;",{"_2937":59948,"_26000":59894,"_18071":100110,"_5":17966,"_24599":99983,"_2447":100111},[],"inspecciona dead-letter queues;",{"_2937":59949,"_26000":59894,"_18071":100113,"_5":17966,"_24599":99983,"_2447":100114},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2937":59950,"_26000":59894,"_18071":100116,"_5":17966,"_24599":99983,"_2447":100117},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2937":59951,"_26000":59894,"_18071":100119,"_5":17966,"_24599":99987,"_2447":100120},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2937":59952,"_26000":59894,"_18071":100122,"_5":17966,"_24599":99987,"_2447":100123},[],"Antes de cerrar una incidencia, guarda:",{"_2937":59953,"_26000":59894,"_18071":100125,"_5":17966,"_24599":99987,"_2447":100126},[],"causa confirmada;",{"_2937":59954,"_26000":59894,"_18071":100128,"_5":17966,"_24599":99987,"_2447":100129},[],"alcance temporal y recursos afectados;",{"_2937":59955,"_26000":59894,"_18071":100131,"_5":17966,"_24599":99987,"_2447":100132},[],"comandos o consultas utilizados;",{"_2937":59956,"_26000":59894,"_18071":100134,"_5":17966,"_24599":99987,"_2447":100135},[],"cambio aplicado y forma de revertirlo;",{"_2937":59957,"_26000":59894,"_18071":100137,"_5":17966,"_24599":99987,"_2447":100138},[],"validación desde un consumidor;",{"_2937":59958,"_26000":59894,"_18071":100140,"_5":17966,"_24599":99987,"_2447":100141},[],"acción preventiva y propietario.",{"_2937":59959,"_26000":59959,"_5":12545,"_2447":100143,"_26339":100144,"_18071":100147,"_24599":59959},"Control de acceso",[42089,100145,100146],"Plataforma","Administración",[],{"_2937":59960,"_26000":59959,"_18071":100149,"_5":17966,"_24599":59959,"_2447":100150},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2937":59961,"_26000":59959,"_5":26336,"_18071":100152,"_24599":100153,"_2447":100154},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2937":59962,"_26000":59959,"_5":26336,"_18071":100156,"_24599":100157,"_2447":100158},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2937":59963,"_26000":59959,"_5":26336,"_18071":100160,"_24599":100161,"_2447":100162},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2937":59964,"_26000":59959,"_5":26336,"_18071":100164,"_24599":100165,"_2447":100166},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2937":59965,"_26000":59959,"_5":26336,"_18071":100168,"_24599":100169,"_2447":100170},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2937":59966,"_26000":59959,"_5":26336,"_18071":100172,"_24599":100173,"_2447":100174},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2937":59967,"_26000":59959,"_5":26336,"_18071":100176,"_24599":100177,"_2447":100178},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2937":59968,"_26000":59959,"_5":26336,"_18071":100180,"_24599":100181,"_2447":100182},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2937":59969,"_26000":59959,"_5":26336,"_18071":100184,"_24599":100185,"_2447":100186},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2937":59970,"_26000":59959,"_5":26336,"_18071":100188,"_24599":100189,"_2447":100190},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2937":59971,"_26000":59959,"_5":26336,"_18071":100192,"_24599":100193,"_2447":100194},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2937":59972,"_26000":59959,"_5":26336,"_18071":100196,"_24599":100197,"_2447":100198},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2937":59973,"_26000":59959,"_5":26336,"_18071":100200,"_24599":100201,"_2447":100202},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2937":59974,"_26000":59959,"_5":26336,"_18071":100204,"_24599":100205,"_2447":100206},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2937":59975,"_26000":59959,"_5":26336,"_18071":100208,"_24599":100209,"_2447":100210},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2937":59976,"_26000":59959,"_5":26336,"_18071":100212,"_24599":100213,"_2447":99208},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2937":59977,"_26000":59959,"_5":26336,"_18071":100215,"_24599":100216,"_2447":100217},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2937":59978,"_26000":59959,"_5":26336,"_18071":100219,"_24599":100220,"_2447":100221},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2937":59979,"_26000":59959,"_5":26336,"_18071":100223,"_24599":100224,"_2447":100225},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2937":59980,"_26000":59959,"_5":26336,"_18071":100227,"_24599":100228,"_2447":100229},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2937":59981,"_26000":59959,"_5":26336,"_18071":100231,"_24599":100232,"_2447":100233},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2937":59982,"_26000":59959,"_5":26336,"_18071":100235,"_24599":100236,"_2447":100237},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2937":59983,"_26000":59959,"_5":26336,"_18071":100239,"_24599":100240,"_2447":100241},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2937":59984,"_26000":59959,"_5":26336,"_18071":100243,"_24599":100244,"_2447":100245},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2937":59985,"_26000":59959,"_5":26336,"_18071":100247,"_24599":100248,"_2447":100249},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2937":59986,"_26000":59959,"_5":26336,"_18071":100251,"_24599":100252,"_2447":100253},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2937":59987,"_26000":59959,"_5":26336,"_18071":100255,"_24599":100256,"_2447":100257},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2937":59988,"_26000":59959,"_5":26336,"_18071":100259,"_24599":100260,"_2447":100261},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2937":59989,"_26000":59959,"_5":26336,"_18071":100263,"_24599":100264,"_2447":100265},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2937":59990,"_26000":59959,"_5":26336,"_18071":100267,"_24599":100268,"_2447":100269},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2937":59991,"_26000":59959,"_5":26336,"_18071":100271,"_24599":100272,"_2447":100273},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2937":59992,"_26000":59959,"_18071":100275,"_5":17966,"_24599":59959,"_2447":100276},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2937":59993,"_26000":59959,"_18071":100278,"_5":17966,"_24599":59959,"_2447":100279},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2937":59994,"_26000":59959,"_18071":100281,"_5":17966,"_24599":59959,"_2447":100282},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2937":59995,"_26000":59959,"_18071":100284,"_5":17966,"_24599":100153,"_2447":100285},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2937":59996,"_26000":59959,"_18071":100287,"_5":17966,"_24599":100153,"_2447":100288},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2937":59997,"_26000":59959,"_18071":100290,"_5":17966,"_24599":100153,"_2447":100291},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2937":59998,"_26000":59959,"_18071":100293,"_5":17966,"_24599":100153,"_2447":100294},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2937":59999,"_26000":59959,"_18071":100296,"_5":17966,"_24599":100153,"_2447":100297},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2937":60000,"_26000":59959,"_18071":100299,"_5":17966,"_24599":100153,"_2447":100300},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2937":60001,"_26000":59959,"_18071":100302,"_5":17966,"_24599":100157,"_2447":100303},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2937":60002,"_26000":59959,"_18071":100305,"_5":17966,"_24599":100157,"_2447":100306},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2937":60003,"_26000":59959,"_18071":100308,"_5":17966,"_24599":100161,"_2447":100309},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2937":60004,"_26000":59959,"_18071":100311,"_5":17966,"_24599":100161,"_2447":100312},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2937":60005,"_26000":59959,"_18071":100314,"_5":17966,"_24599":100161,"_2447":100315},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2937":60006,"_26000":59959,"_18071":100317,"_5":17966,"_24599":100161,"_2447":100318},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2937":60007,"_26000":59959,"_18071":100320,"_5":17966,"_24599":100161,"_2447":100321},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2937":60008,"_26000":59959,"_18071":100323,"_5":17966,"_24599":100161,"_2447":100324},[],"Carga por separado las políticas concedidas a cada principal.",{"_2937":60009,"_26000":59959,"_18071":100326,"_5":17966,"_24599":100161,"_2447":100327},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2937":60010,"_26000":59959,"_18071":100329,"_5":17966,"_24599":100161,"_2447":100330},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2937":60011,"_26000":59959,"_18071":100332,"_5":17966,"_24599":100161,"_2447":100333},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2937":60012,"_26000":59959,"_18071":100335,"_5":17966,"_24599":100161,"_2447":100336},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2937":60013,"_26000":59959,"_18071":100338,"_5":17966,"_24599":100161,"_2447":100339},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2937":60014,"_26000":59959,"_18071":100341,"_5":17966,"_24599":100161,"_2447":100342},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2937":60015,"_26000":59959,"_18071":100344,"_5":17966,"_24599":100165,"_2447":100345},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2937":60016,"_26000":59959,"_18071":100347,"_5":17966,"_24599":100165,"_2447":100348},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2937":60017,"_26000":59959,"_18071":100350,"_5":17966,"_24599":100165,"_2447":100351},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2937":60018,"_26000":59959,"_18071":100353,"_5":17966,"_24599":100165,"_2447":100354},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2937":60019,"_26000":59959,"_18071":100356,"_5":17966,"_24599":100165,"_2447":100357},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2937":60020,"_26000":59959,"_18071":100359,"_5":17966,"_24599":100165,"_2447":100360},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2937":60021,"_26000":59959,"_18071":100362,"_5":17966,"_24599":100165,"_2447":100363},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2937":60022,"_26000":59959,"_18071":100365,"_5":17966,"_24599":100165,"_2447":100366},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2937":60023,"_26000":59959,"_18071":100368,"_5":17966,"_24599":100169,"_2447":100369},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2937":60024,"_26000":59959,"_18071":100371,"_5":17966,"_24599":100169,"_2447":100372},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2937":60025,"_26000":59959,"_18071":100374,"_5":17966,"_24599":100169,"_2447":100375},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2937":60026,"_26000":59959,"_18071":100377,"_5":17966,"_24599":100169,"_2447":100378},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2937":60027,"_26000":59959,"_18071":100380,"_5":17966,"_24599":100169,"_2447":100381},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2937":60028,"_26000":59959,"_18071":100383,"_5":17966,"_24599":100169,"_2447":100384},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2937":60029,"_26000":59959,"_18071":100386,"_5":17966,"_24599":100169,"_2447":100387},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2937":60030,"_26000":59959,"_18071":100389,"_5":17966,"_24599":100169,"_2447":100390},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2937":60031,"_26000":59959,"_18071":100392,"_5":17966,"_24599":100169,"_2447":100393},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2937":60032,"_26000":59959,"_18071":100395,"_5":17966,"_24599":100169,"_2447":100396},[],"Las acciones se dividen en dos grupos:",{"_2937":60033,"_26000":59959,"_18071":100398,"_5":17966,"_24599":100169,"_2447":100399},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2937":60034,"_26000":59959,"_18071":100401,"_5":17966,"_24599":100169,"_2447":100402},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2937":60035,"_26000":59959,"_18071":100404,"_5":17966,"_24599":100169,"_2447":100405},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2937":60036,"_26000":59959,"_18071":100407,"_5":17966,"_24599":100173,"_2447":100408},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2937":60037,"_26000":59959,"_18071":100410,"_5":17966,"_24599":100173,"_2447":100411},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2937":60038,"_26000":59959,"_18071":100413,"_5":17966,"_24599":100173,"_2447":100414},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2937":60039,"_26000":59959,"_18071":100416,"_5":17966,"_24599":100177,"_2447":100417},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2937":60040,"_26000":59959,"_18071":100419,"_5":17966,"_24599":100177,"_2447":100420},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2937":60041,"_26000":59959,"_18071":100422,"_5":17966,"_24599":100177,"_2447":100423},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2937":60042,"_26000":59959,"_18071":100425,"_5":17966,"_24599":100177,"_2447":100426},[],"Los operadores implementados son:",{"_2937":60043,"_26000":59959,"_18071":100428,"_5":17966,"_24599":100177,"_2447":100429},[],"`equals`, para igualdad exacta;",{"_2937":60044,"_26000":59959,"_18071":100431,"_5":17966,"_24599":100177,"_2447":100432},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2937":60045,"_26000":59959,"_18071":100434,"_5":17966,"_24599":100177,"_2447":100435},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2937":60046,"_26000":59959,"_18071":100437,"_5":17966,"_24599":100177,"_2447":100438},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2937":60047,"_26000":59959,"_18071":100440,"_5":17966,"_24599":100181,"_2447":100441},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2937":60048,"_26000":59959,"_18071":100443,"_5":17966,"_24599":100181,"_2447":100444},[],"Los modos disponibles son:",{"_2937":60049,"_26000":59959,"_18071":100446,"_5":17966,"_24599":100181,"_2447":100447},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2937":60050,"_26000":59959,"_18071":100449,"_5":17966,"_24599":100181,"_2447":100450},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2937":60051,"_26000":59959,"_18071":100452,"_5":17966,"_24599":100181,"_2447":100453},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2937":60052,"_26000":59959,"_18071":100455,"_5":17966,"_24599":100181,"_2447":100456},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2937":60053,"_26000":59959,"_18071":100458,"_5":17966,"_24599":100181,"_2447":100459},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2937":60054,"_26000":59959,"_18071":100461,"_5":17966,"_24599":100181,"_2447":100462},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2937":60055,"_26000":59959,"_18071":100464,"_5":17966,"_24599":100185,"_2447":100465},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2937":60056,"_26000":59959,"_18071":100467,"_5":17966,"_24599":100185,"_2447":100468},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2937":60057,"_26000":59959,"_18071":100470,"_5":17966,"_24599":100185,"_2447":100471},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2937":60058,"_26000":59959,"_18071":100473,"_5":17966,"_24599":100185,"_2447":100474},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2937":60059,"_26000":59959,"_18071":100476,"_5":17966,"_24599":100193,"_2447":100477},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2937":60060,"_26000":59959,"_18071":100479,"_5":17966,"_24599":100193,"_2447":100480},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2937":60061,"_26000":59959,"_18071":100482,"_5":17966,"_24599":100197,"_2447":100483},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2937":60062,"_26000":59959,"_18071":100485,"_5":17966,"_24599":100197,"_2447":100486},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2937":60063,"_26000":59959,"_18071":100488,"_5":17966,"_24599":100201,"_2447":100489},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2937":60064,"_26000":59959,"_18071":100491,"_5":17966,"_24599":100201,"_2447":100492},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2937":60065,"_26000":59959,"_18071":100494,"_5":17966,"_24599":100201,"_2447":100495},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2937":60066,"_26000":59959,"_18071":100497,"_5":17966,"_24599":100205,"_2447":100498},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2937":60067,"_26000":59959,"_18071":100500,"_5":17966,"_24599":100205,"_2447":100501},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2937":60068,"_26000":59959,"_18071":100503,"_5":17966,"_24599":100205,"_2447":100504},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2937":60069,"_26000":59959,"_18071":100506,"_5":17966,"_24599":100205,"_2447":100507},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2937":60070,"_26000":59959,"_18071":100509,"_5":17966,"_24599":100205,"_2447":100510},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2937":60071,"_26000":59959,"_18071":100512,"_5":17966,"_24599":100205,"_2447":100513},[],"Ten en cuenta que:",{"_2937":60072,"_26000":59959,"_18071":100515,"_5":17966,"_24599":100205,"_2447":100516},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2937":60073,"_26000":59959,"_18071":100518,"_5":17966,"_24599":100205,"_2447":100519},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2937":60074,"_26000":59959,"_18071":100521,"_5":17966,"_24599":100205,"_2447":100522},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2937":60075,"_26000":59959,"_18071":100524,"_5":17966,"_24599":100209,"_2447":100525},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2937":60076,"_26000":59959,"_18071":100527,"_5":17966,"_24599":100209,"_2447":100528},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2937":60077,"_26000":59959,"_18071":100530,"_5":17966,"_24599":100209,"_2447":100531},[],"acceso completo y de solo lectura a KMS;",{"_2937":60078,"_26000":59959,"_18071":100533,"_5":17966,"_24599":100209,"_2447":100534},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2937":60079,"_26000":59959,"_18071":100536,"_5":17966,"_24599":100209,"_2447":100537},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2937":60080,"_26000":59959,"_18071":100539,"_5":17966,"_24599":100209,"_2447":100540},[],"acceso a la interfaz;",{"_2937":60081,"_26000":59959,"_18071":100542,"_5":17966,"_24599":100209,"_2447":100543},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2937":60082,"_26000":59959,"_18071":100545,"_5":17966,"_24599":100209,"_2447":100546},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2937":60083,"_26000":59959,"_18071":100548,"_5":17966,"_24599":100209,"_2447":100549},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2937":60084,"_26000":59959,"_18071":100551,"_5":17966,"_24599":100213,"_2447":100552},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2937":60085,"_26000":59959,"_18071":100554,"_5":17966,"_24599":100213,"_2447":100555},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2937":60086,"_26000":59959,"_18071":100557,"_5":17966,"_24599":100213,"_2447":100558},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2937":60087,"_26000":59959,"_18071":100560,"_5":17966,"_24599":100216,"_2447":100561},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2937":60088,"_26000":59959,"_18071":100563,"_5":17966,"_24599":100220,"_2447":100564},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2937":60089,"_26000":59959,"_18071":100566,"_5":17966,"_24599":100224,"_2447":100567},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2937":60090,"_26000":59959,"_18071":100569,"_5":17966,"_24599":100228,"_2447":100570},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2937":60091,"_26000":59959,"_18071":100572,"_5":17966,"_24599":100232,"_2447":100573},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2937":60092,"_26000":59959,"_18071":100575,"_5":17966,"_24599":100236,"_2447":100576},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2937":60093,"_26000":59959,"_18071":100578,"_5":17966,"_24599":100236,"_2447":100579},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2937":60094,"_26000":59959,"_18071":100581,"_5":17966,"_24599":100240,"_2447":100582},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2937":60095,"_26000":59959,"_18071":100584,"_5":17966,"_24599":100240,"_2447":100585},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2937":60096,"_26000":59959,"_18071":100587,"_5":17966,"_24599":100240,"_2447":100588},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2937":60097,"_26000":59959,"_18071":100590,"_5":17966,"_24599":100240,"_2447":100591},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2937":60098,"_26000":59959,"_18071":100593,"_5":17966,"_24599":100240,"_2447":100594},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2937":60099,"_26000":59959,"_18071":100596,"_5":17966,"_24599":100240,"_2447":100597},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2937":60100,"_26000":59959,"_18071":100599,"_5":17966,"_24599":100240,"_2447":100600},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2937":60101,"_26000":59959,"_18071":100602,"_5":17966,"_24599":100240,"_2447":100603},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2937":60102,"_26000":59959,"_18071":100605,"_5":17966,"_24599":100244,"_2447":100606},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2937":60103,"_26000":59959,"_18071":100608,"_5":17966,"_24599":100244,"_2447":100609},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2937":60104,"_26000":59959,"_18071":100611,"_5":17966,"_24599":100244,"_2447":100612},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2937":60105,"_26000":59959,"_18071":100614,"_5":17966,"_24599":100248,"_2447":100615},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2937":60106,"_26000":59959,"_18071":100617,"_5":17966,"_24599":100248,"_2447":100618},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2937":60107,"_26000":59959,"_18071":100620,"_5":17966,"_24599":100248,"_2447":100621},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2937":60108,"_26000":59959,"_18071":100623,"_5":17966,"_24599":100248,"_2447":100624},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2937":60109,"_26000":59959,"_18071":100626,"_5":17966,"_24599":100248,"_2447":100627},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2937":60110,"_26000":59959,"_18071":100629,"_5":17966,"_24599":100248,"_2447":100630},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2937":60111,"_26000":59959,"_18071":100632,"_5":17966,"_24599":100248,"_2447":100633},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2937":60112,"_26000":59959,"_18071":100635,"_5":17966,"_24599":100248,"_2447":100636},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2937":60113,"_26000":59959,"_18071":100638,"_5":17966,"_24599":100256,"_2447":100639},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2937":60114,"_26000":59959,"_18071":100641,"_5":17966,"_24599":100260,"_2447":100642},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2937":60115,"_26000":59959,"_18071":100644,"_5":17966,"_24599":100260,"_2447":100645},[],"que exista un principal activo del tipo correcto;",{"_2937":60116,"_26000":59959,"_18071":100647,"_5":17966,"_24599":100260,"_2447":100648},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2937":60117,"_26000":59959,"_18071":100650,"_5":17966,"_24599":100260,"_2447":100651},[],"que todas las condiciones del principal se cumplan;",{"_2937":60118,"_26000":59959,"_18071":100653,"_5":17966,"_24599":100260,"_2447":100654},[],"que el principal tenga concedida la política esperada;",{"_2937":60119,"_26000":59959,"_18071":100656,"_5":17966,"_24599":100260,"_2447":100657},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2937":60120,"_26000":59959,"_18071":100659,"_5":17966,"_24599":100260,"_2447":100660},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2937":60121,"_26000":59959,"_18071":100662,"_5":17966,"_24599":100260,"_2447":100663},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2937":60122,"_26000":59959,"_18071":100665,"_5":17966,"_24599":100264,"_2447":100666},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2937":60123,"_26000":59959,"_18071":100668,"_5":17966,"_24599":100268,"_2447":100669},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2937":60124,"_26000":59959,"_18071":100671,"_5":17966,"_24599":100272,"_2447":100672},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2937":60125,"_26000":59959,"_18071":100674,"_5":17966,"_24599":100272,"_2447":100675},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2937":60126,"_26000":60126,"_5":12545,"_2447":100677,"_26339":100678,"_18071":100679,"_24599":60126},"Alertas y suscripciones",[42089,100145,100146],[],{"_2937":60127,"_26000":60126,"_18071":100681,"_5":17966,"_24599":60126,"_2447":100682},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2937":60128,"_26000":60126,"_5":26336,"_18071":100684,"_24599":100685,"_2447":100686},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2937":60129,"_26000":60126,"_5":26336,"_18071":100688,"_24599":100689,"_2447":100690},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2937":60130,"_26000":60126,"_5":26336,"_18071":100692,"_24599":100693,"_2447":100694},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2937":60131,"_26000":60126,"_5":26336,"_18071":100696,"_24599":100697,"_2447":100698},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2937":60132,"_26000":60126,"_5":26336,"_18071":100700,"_24599":100701,"_2447":100702},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2937":60133,"_26000":60126,"_5":26336,"_18071":100704,"_24599":100705,"_2447":100706},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2937":60134,"_26000":60126,"_5":26336,"_18071":100708,"_24599":100709,"_2447":100710},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2937":60135,"_26000":60126,"_5":26336,"_18071":100712,"_24599":100713,"_2447":100714},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2937":60136,"_26000":60126,"_5":26336,"_18071":100716,"_24599":100717,"_2447":100718},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2937":60137,"_26000":60126,"_5":26336,"_18071":100720,"_24599":100721,"_2447":100722},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2937":60138,"_26000":60126,"_18071":100724,"_5":17966,"_24599":60126,"_2447":100725},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2937":60139,"_26000":60126,"_18071":100727,"_5":17966,"_24599":100685,"_2447":100728},[],"Un servicio publica un evento de dominio.",{"_2937":60140,"_26000":60126,"_18071":100730,"_5":17966,"_24599":100685,"_2447":100731},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2937":60141,"_26000":60126,"_18071":100733,"_5":17966,"_24599":100685,"_2447":100734},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2937":60142,"_26000":60126,"_18071":100736,"_5":17966,"_24599":100685,"_2447":100737},[],"Lamassu entrega el evento al canal configurado.",{"_2937":60143,"_26000":60126,"_18071":100739,"_5":17966,"_24599":100685,"_2447":100740},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2937":60144,"_26000":60126,"_18071":100742,"_5":17966,"_24599":100689,"_2447":100743},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2937":60145,"_26000":60126,"_18071":100745,"_5":17966,"_24599":100689,"_2447":100746},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2937":60146,"_26000":60126,"_18071":100748,"_5":17966,"_24599":100689,"_2447":100749},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2937":60147,"_26000":60126,"_18071":100751,"_5":17966,"_24599":100689,"_2447":100752},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2937":60148,"_26000":60126,"_18071":100754,"_5":17966,"_24599":100689,"_2447":100755},[],"`apikey_options` necesita `header` y `key`.",{"_2937":60149,"_26000":60126,"_18071":100757,"_5":17966,"_24599":100689,"_2447":100758},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2937":60150,"_26000":60126,"_18071":100760,"_5":17966,"_24599":100689,"_2447":100761},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2937":60151,"_26000":60126,"_18071":100763,"_5":17966,"_24599":100689,"_2447":100764},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2937":60152,"_26000":60126,"_18071":100766,"_5":17966,"_24599":100697,"_2447":100767},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2937":60153,"_26000":60126,"_18071":100769,"_5":17966,"_24599":100701,"_2447":100770},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2937":60154,"_26000":60126,"_18071":100772,"_5":17966,"_24599":100705,"_2447":100773},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2937":60155,"_26000":60126,"_18071":100775,"_5":17966,"_24599":100705,"_2447":100776},[],"**None** notifica todas las instancias del evento.",{"_2937":60156,"_26000":60126,"_18071":100778,"_5":17966,"_24599":100705,"_2447":100779},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2937":60157,"_26000":60126,"_18071":100781,"_5":17966,"_24599":100705,"_2447":100782},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2937":60158,"_26000":60126,"_18071":100784,"_5":17966,"_24599":100705,"_2447":100785},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2937":60159,"_26000":60126,"_18071":100787,"_5":17966,"_24599":100705,"_2447":100788},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2937":60160,"_26000":60126,"_18071":100790,"_5":17966,"_24599":100709,"_2447":100791},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2937":60161,"_26000":60126,"_18071":100793,"_5":17966,"_24599":100713,"_2447":100794},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2937":60162,"_26000":60126,"_18071":100796,"_5":17966,"_24599":100713,"_2447":100797},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2937":60163,"_26000":60126,"_18071":100799,"_5":17966,"_24599":100713,"_2447":100800},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2937":60164,"_26000":60126,"_18071":100802,"_5":17966,"_24599":100713,"_2447":100803},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2937":60165,"_26000":60126,"_18071":100805,"_5":17966,"_24599":100713,"_2447":100806},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2937":60166,"_26000":60126,"_18071":100808,"_5":17966,"_24599":100713,"_2447":100809},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2937":60167,"_26000":60126,"_18071":100811,"_5":17966,"_24599":100713,"_2447":100812},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2937":60168,"_26000":60126,"_18071":100814,"_5":17966,"_24599":100713,"_2447":100815},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2937":60169,"_26000":60126,"_18071":100817,"_5":17966,"_24599":100717,"_2447":100818},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2937":60170,"_26000":60126,"_18071":100820,"_5":17966,"_24599":100721,"_2447":100821},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2937":60171,"_26000":60126,"_18071":100823,"_5":17966,"_24599":100721,"_2447":100824},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2937":60172,"_26000":60126,"_18071":100826,"_5":17966,"_24599":100721,"_2447":100827},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2937":60173,"_26000":60126,"_18071":100829,"_5":17966,"_24599":100721,"_2447":100830},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2937":60174,"_26000":60126,"_18071":100832,"_5":17966,"_24599":100721,"_2447":100833},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2937":60175,"_26000":60126,"_18071":100835,"_5":17966,"_24599":100721,"_2447":100836},[],"**Validación:** `va.role.crl.create`.",{"_2937":60176,"_26000":60126,"_18071":100838,"_5":17966,"_24599":100721,"_2447":100839},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2937":60177,"_26000":60126,"_18071":100841,"_5":17966,"_24599":100721,"_2447":100842},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2937":60178,"_26000":60178,"_5":12545,"_2447":100844,"_26339":100845,"_18071":100846,"_24599":60178},"Registros de auditoría",[42089,100145,100146],[],{"_2937":60179,"_26000":60178,"_18071":100848,"_5":17966,"_24599":60178,"_2447":100849},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2937":60180,"_26000":60178,"_5":26336,"_18071":100851,"_24599":100852,"_2447":100853},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2937":60181,"_26000":60178,"_5":26336,"_18071":100855,"_24599":100856,"_2447":100857},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2937":60182,"_26000":60178,"_5":26336,"_18071":100859,"_24599":100860,"_2447":100861},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2937":60183,"_26000":60178,"_5":26336,"_18071":100863,"_24599":100864,"_2447":100865},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2937":60184,"_26000":60178,"_5":26336,"_18071":100867,"_24599":100868,"_2447":100869},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2937":60185,"_26000":60178,"_5":26336,"_18071":100871,"_24599":100872,"_2447":100873},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2937":60186,"_26000":60178,"_5":26336,"_18071":100875,"_24599":100876,"_2447":100877},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2937":60187,"_26000":60178,"_5":26336,"_18071":100879,"_24599":100880,"_2447":100881},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2937":60188,"_26000":60178,"_5":26336,"_18071":100883,"_24599":100884,"_2447":100885},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2937":60189,"_26000":60178,"_5":26336,"_18071":100887,"_24599":100888,"_2447":100889},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2937":60190,"_26000":60178,"_5":26336,"_18071":100891,"_24599":100892,"_2447":100893},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2937":60191,"_26000":60178,"_18071":100895,"_5":17966,"_24599":60178,"_2447":100896},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2937":60192,"_26000":60178,"_18071":100898,"_5":17966,"_24599":100852,"_2447":100899},[],"El cuerpo de auditoría incluye:",{"_2937":60193,"_26000":60178,"_18071":100901,"_5":17966,"_24599":100852,"_2447":100902},[],"input: datos recibidos por la operación;",{"_2937":60194,"_26000":60178,"_18071":100904,"_5":17966,"_24599":100852,"_2447":100905},[],"has\\_error: indica si el servicio devolvió un error;",{"_2937":60195,"_26000":60178,"_18071":100907,"_5":17966,"_24599":100852,"_2447":100908},[],"output: resultado producido o mensaje de error;",{"_2937":60196,"_26000":60178,"_18071":100910,"_5":17966,"_24599":100852,"_2447":100911},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2937":60197,"_26000":60178,"_18071":100913,"_5":17966,"_24599":100852,"_2447":100914},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2937":60198,"_26000":60178,"_18071":100916,"_5":17966,"_24599":100852,"_2447":100917},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2937":60199,"_26000":60178,"_18071":100919,"_5":17966,"_24599":100856,"_2447":100920},[],"El backend aplica auditoría a mutaciones de:",{"_2937":60200,"_26000":60178,"_18071":100922,"_5":17966,"_24599":100856,"_2447":100923},[],"autoridades, certificados y perfiles de emisión;",{"_2937":60201,"_26000":60178,"_18071":100925,"_5":17966,"_24599":100856,"_2447":100926},[],"claves y motores KMS;",{"_2937":60202,"_26000":60178,"_18071":100928,"_5":17966,"_24599":100856,"_2447":100929},[],"dispositivos e identidades;",{"_2937":60203,"_26000":60178,"_18071":100931,"_5":17966,"_24599":100856,"_2447":100932},[],"DMS y operaciones de enrolamiento;",{"_2937":60204,"_26000":60178,"_18071":100934,"_5":17966,"_24599":100856,"_2447":100935},[],"funciones de validación y CRL;",{"_2937":60205,"_26000":60178,"_18071":100937,"_5":17966,"_24599":100856,"_2447":100938},[],"principales, políticas y concesiones de autorización.",{"_2937":60206,"_26000":60178,"_18071":100940,"_5":17966,"_24599":100856,"_2447":100941},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2937":60207,"_26000":60178,"_18071":100943,"_5":17966,"_24599":100860,"_2447":100944},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2937":60208,"_26000":60178,"_18071":100946,"_5":17966,"_24599":100860,"_2447":100947},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2937":60209,"_26000":60178,"_18071":100949,"_5":17966,"_24599":100860,"_2447":100950},[],"Diseña el consumidor para:",{"_2937":60210,"_26000":60178,"_18071":100952,"_5":17966,"_24599":100860,"_2447":100953},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2937":60211,"_26000":60178,"_18071":100955,"_5":17966,"_24599":100860,"_2447":100956},[],"conservar el CloudEvent completo sin modificar;",{"_2937":60212,"_26000":60178,"_18071":100958,"_5":17966,"_24599":100860,"_2447":100959},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2937":60213,"_26000":60178,"_18071":100961,"_5":17966,"_24599":100860,"_2447":100962},[],"cifrar en tránsito y en reposo;",{"_2937":60214,"_26000":60178,"_18071":100964,"_5":17966,"_24599":100860,"_2447":100965},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2937":60215,"_26000":60178,"_18071":100967,"_5":17966,"_24599":100860,"_2447":100968},[],"aplicar una política explícita de retención y legal hold;",{"_2937":60216,"_26000":60178,"_18071":100970,"_5":17966,"_24599":100860,"_2447":100971},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2937":60217,"_26000":60178,"_18071":100973,"_5":17966,"_24599":100864,"_2447":100974},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2937":60218,"_26000":60178,"_18071":100976,"_5":17966,"_24599":100864,"_2447":100977},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2937":60219,"_26000":60178,"_18071":100979,"_5":17966,"_24599":100872,"_2447":100980},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2937":60220,"_26000":60178,"_18071":100982,"_5":17966,"_24599":100876,"_2447":100983},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2937":60221,"_26000":60178,"_18071":100985,"_5":17966,"_24599":100880,"_2447":100986},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2937":60222,"_26000":60178,"_18071":100988,"_5":17966,"_24599":100884,"_2447":100989},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2937":60223,"_26000":60178,"_18071":100991,"_5":17966,"_24599":100888,"_2447":100992},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2937":60224,"_26000":60178,"_18071":100994,"_5":17966,"_24599":100892,"_2447":100995},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2937":60225,"_26000":60178,"_18071":100997,"_5":17966,"_24599":100892,"_2447":100998},[],"aparece un evento de auditoría correcto;",{"_2937":60226,"_26000":60178,"_18071":101000,"_5":17966,"_24599":100892,"_2447":101001},[],"el principal coincide con la identidad utilizada;",{"_2937":60227,"_26000":60178,"_18071":101003,"_5":17966,"_24599":100892,"_2447":101004},[],"el consumidor lo persiste una sola vez;",{"_2937":60228,"_26000":60178,"_18071":101006,"_5":17966,"_24599":100892,"_2447":101007},[],"puede recuperarse por recurso, actor y periodo;",{"_2937":60229,"_26000":60178,"_18071":101009,"_5":17966,"_24599":100892,"_2447":101010},[],"una interrupción del consumidor produce una alerta.",{"_2937":60230,"_26000":60178,"_18071":101012,"_5":17966,"_24599":100892,"_2447":101013},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2937":60231,"_26000":60231,"_5":12545,"_2447":101015,"_26339":101016,"_18071":101017,"_24599":60231},"Arquitectura de la plataforma",[42089,100145],[],{"_2937":60232,"_26000":60231,"_18071":101019,"_5":17966,"_24599":60231,"_2447":101020},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2937":60233,"_26000":60231,"_5":26336,"_18071":101022,"_24599":101023,"_2447":101024},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2937":60234,"_26000":60231,"_5":26336,"_18071":101026,"_24599":101027,"_2447":101028},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2937":60235,"_26000":60231,"_5":26336,"_18071":101030,"_24599":101031,"_2447":101032},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2937":60236,"_26000":60231,"_5":26336,"_18071":101034,"_24599":101035,"_2447":101036},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2937":60237,"_26000":60231,"_5":26336,"_18071":101038,"_24599":101039,"_2447":101040},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2937":60238,"_26000":60231,"_18071":101042,"_5":17966,"_24599":60231,"_2447":101043},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2937":60239,"_26000":60231,"_18071":101045,"_5":17966,"_24599":60231,"_2447":101046},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2937":60240,"_26000":60231,"_18071":101048,"_5":17966,"_24599":101023,"_2447":101049},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2937":60241,"_26000":60231,"_18071":101051,"_5":17966,"_24599":101027,"_2447":101052},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2937":60242,"_26000":60231,"_18071":101054,"_5":17966,"_24599":101031,"_2447":101055},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2937":60243,"_26000":60231,"_18071":101057,"_5":17966,"_24599":101035,"_2447":101058},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2937":60244,"_26000":60231,"_18071":101060,"_5":17966,"_24599":101039,"_2447":101061},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2937":60245,"_26000":60245,"_5":12545,"_2447":101063,"_26339":101064,"_18071":101065,"_24599":60245},"Cómo funciona Lamassu",[42089,100145],[],{"_2937":60246,"_26000":60245,"_18071":101067,"_5":17966,"_24599":60245,"_2447":101068},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2937":60247,"_26000":60245,"_5":26336,"_18071":101070,"_24599":101071,"_2447":101072},[],"/docs/pr-preview/pr-26/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2937":60248,"_26000":60245,"_5":26336,"_18071":101074,"_24599":101075,"_2447":101076},[],"/docs/pr-preview/pr-26/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2937":60249,"_26000":60245,"_18071":101078,"_5":17966,"_24599":60245,"_2447":101079},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2937":60250,"_26000":60245,"_18071":101081,"_5":17966,"_24599":101071,"_2447":101082},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2937":60251,"_26000":60245,"_18071":101084,"_5":17966,"_24599":101071,"_2447":101085},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2937":60252,"_26000":60245,"_18071":101087,"_5":17966,"_24599":101071,"_2447":101088},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2937":60253,"_26000":60245,"_18071":101090,"_5":17966,"_24599":101071,"_2447":101091},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2937":60254,"_26000":60245,"_18071":101093,"_5":17966,"_24599":101071,"_2447":101094},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2937":60255,"_26000":60245,"_18071":101096,"_5":17966,"_24599":101075,"_2447":101097},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2937":60256,"_26000":60245,"_18071":101099,"_5":17966,"_24599":101075,"_2447":101100},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2937":60257,"_26000":60245,"_18071":101102,"_5":17966,"_24599":101075,"_2447":101103},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2937":60258,"_26000":60245,"_18071":101105,"_5":17966,"_24599":101075,"_2447":101106},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2937":60259,"_26000":60245,"_18071":101108,"_5":17966,"_24599":101075,"_2447":101109},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2937":60260,"_26000":60245,"_18071":101111,"_5":17966,"_24599":101075,"_2447":101112},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2937":60261,"_26000":60245,"_18071":101114,"_5":17966,"_24599":101075,"_2447":101115},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2937":60262,"_26000":60262,"_5":12545,"_2447":101117,"_26339":101118,"_18071":101119,"_24599":60262},"Dispositivos e identidades",[42089,100145,44610,101117],[],{"_2937":60263,"_26000":60262,"_18071":101121,"_5":17966,"_24599":60262,"_2447":101122},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2937":60264,"_26000":60262,"_5":26336,"_18071":101124,"_24599":101125,"_2447":101126},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2937":60265,"_26000":60262,"_5":26336,"_18071":101128,"_24599":101129,"_2447":101130},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2937":60266,"_26000":60262,"_5":26336,"_18071":101132,"_24599":101133,"_2447":101134},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2937":60267,"_26000":60262,"_5":26336,"_18071":101136,"_24599":101137,"_2447":101138},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2937":60268,"_26000":60262,"_5":26336,"_18071":101140,"_24599":101141,"_2447":101142},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2937":60269,"_26000":60262,"_5":26336,"_18071":101144,"_24599":101145,"_2447":101146},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2937":60270,"_26000":60262,"_5":26336,"_18071":101148,"_24599":101149,"_2447":101150},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2937":60271,"_26000":60262,"_5":26336,"_18071":101152,"_24599":101153,"_2447":101154},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2937":60272,"_26000":60262,"_5":26336,"_18071":101156,"_24599":101157,"_2447":101158},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2937":60273,"_26000":60262,"_5":26336,"_18071":101160,"_24599":101161,"_2447":101162},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2937":60274,"_26000":60262,"_5":26336,"_18071":101164,"_24599":101165,"_2447":101166},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2937":60275,"_26000":60262,"_18071":101168,"_5":17966,"_24599":60262,"_2447":101169},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2937":60276,"_26000":60262,"_18071":101171,"_5":17966,"_24599":60262,"_2447":101172},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2937":60277,"_26000":60262,"_18071":101174,"_5":17966,"_24599":101125,"_2447":101175},[],"Vista operativa",{"_2937":60278,"_26000":60262,"_18071":101177,"_5":17966,"_24599":101125,"_2447":101178},[],"Interpretación",{"_2937":60279,"_26000":60262,"_18071":101180,"_5":17966,"_24599":101125,"_2447":44673},[],{"_2937":60280,"_26000":60262,"_18071":101182,"_5":17966,"_24599":101125,"_2447":101183},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2937":60281,"_26000":60262,"_18071":101185,"_5":17966,"_24599":101125,"_2447":44679},[],{"_2937":60282,"_26000":60262,"_18071":101187,"_5":17966,"_24599":101125,"_2447":101188},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2937":60283,"_26000":60262,"_18071":101190,"_5":17966,"_24599":101125,"_2447":44685},[],{"_2937":60284,"_26000":60262,"_18071":101192,"_5":17966,"_24599":101125,"_2447":101193},[],"La identidad está en la ventana operativa de renovación.",{"_2937":60285,"_26000":60262,"_18071":101195,"_5":17966,"_24599":101125,"_2447":44691},[],{"_2937":60286,"_26000":60262,"_18071":101197,"_5":17966,"_24599":101125,"_2447":101198},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2937":60287,"_26000":60262,"_18071":101200,"_5":17966,"_24599":101125,"_2447":44697},[],{"_2937":60288,"_26000":60262,"_18071":101202,"_5":17966,"_24599":101125,"_2447":101203},[],"La identidad ha vencido.",{"_2937":60289,"_26000":60262,"_18071":101205,"_5":17966,"_24599":101125,"_2447":44703},[],{"_2937":60290,"_26000":60262,"_18071":101207,"_5":17966,"_24599":101125,"_2447":101208},[],"La identidad está marcada como revocada.",{"_2937":60291,"_26000":60262,"_18071":101210,"_5":17966,"_24599":101125,"_2447":44709},[],{"_2937":60292,"_26000":60262,"_18071":101212,"_5":17966,"_24599":101125,"_2447":101213},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2937":60293,"_26000":60262,"_18071":101215,"_5":17966,"_24599":101125,"_2447":101216},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2937":60294,"_26000":60262,"_18071":101218,"_5":17966,"_24599":101129,"_2447":101219},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2937":60295,"_26000":60262,"_18071":101221,"_5":17966,"_24599":101129,"_2447":101222},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2937":60296,"_26000":60262,"_18071":101224,"_5":17966,"_24599":101129,"_2447":101225},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2937":60297,"_26000":60262,"_18071":101227,"_5":17966,"_24599":101129,"_2447":101228},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2937":60298,"_26000":60262,"_18071":101230,"_5":17966,"_24599":101133,"_2447":101231},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2937":60299,"_26000":60262,"_18071":101233,"_5":17966,"_24599":101137,"_2447":101234},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2937":60300,"_26000":60262,"_18071":101236,"_5":17966,"_24599":101141,"_2447":101237},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2937":60301,"_26000":60262,"_18071":101239,"_5":17966,"_24599":101145,"_2447":101240},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2937":60302,"_26000":60262,"_18071":101242,"_5":17966,"_24599":101149,"_2447":101243},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2937":60303,"_26000":60262,"_18071":101245,"_5":17966,"_24599":101149,"_2447":101246},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2937":60304,"_26000":60262,"_18071":101248,"_5":17966,"_24599":101153,"_2447":101249},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2937":60305,"_26000":60262,"_18071":101251,"_5":17966,"_24599":101153,"_2447":101252},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2937":60306,"_26000":60262,"_18071":101254,"_5":17966,"_24599":101153,"_2447":101255},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2937":60307,"_26000":60262,"_18071":101257,"_5":17966,"_24599":101153,"_2447":101258},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2937":60308,"_26000":60262,"_18071":101260,"_5":17966,"_24599":101153,"_2447":101261},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2937":60309,"_26000":60262,"_18071":101263,"_5":17966,"_24599":101153,"_2447":101264},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2937":60310,"_26000":60262,"_18071":101266,"_5":17966,"_24599":101157,"_2447":101267},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2937":60311,"_26000":60262,"_18071":101269,"_5":17966,"_24599":101157,"_2447":101270},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2937":60312,"_26000":60262,"_18071":101272,"_5":17966,"_24599":101161,"_2447":101273},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2937":60313,"_26000":60262,"_18071":101275,"_5":17966,"_24599":101161,"_2447":101276},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2937":60314,"_26000":60262,"_18071":101278,"_5":17966,"_24599":101161,"_2447":101279},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2937":60315,"_26000":60262,"_18071":101281,"_5":17966,"_24599":101161,"_2447":101282},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2937":60316,"_26000":60262,"_18071":101284,"_5":17966,"_24599":101165,"_2447":101285},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2937":60317,"_26000":60262,"_18071":101287,"_5":17966,"_24599":101165,"_2447":101288},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2937":60318,"_26000":60318,"_5":12545,"_2447":101290,"_26339":101291,"_18071":101293,"_24599":60318},"Identidad inicial y autenticación",[42089,100145,44610,101117,101292],"Enrolamiento con PKI",[],{"_2937":60319,"_26000":60318,"_18071":101295,"_5":17966,"_24599":60318,"_2447":101296},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2937":60320,"_26000":60318,"_5":26336,"_18071":101298,"_24599":101299,"_2447":101300},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2937":60321,"_26000":60318,"_5":26336,"_18071":101302,"_24599":101303,"_2447":101304},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2937":60322,"_26000":60318,"_5":26336,"_18071":101306,"_24599":101307,"_2447":101308},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2937":60323,"_26000":60318,"_5":26336,"_18071":101310,"_24599":101311,"_2447":101312},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2937":60324,"_26000":60318,"_5":26336,"_18071":101314,"_24599":101315,"_2447":101316},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2937":60325,"_26000":60318,"_18071":101318,"_5":17966,"_24599":60318,"_2447":101319},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2937":60326,"_26000":60318,"_18071":101321,"_5":17966,"_24599":101299,"_2447":101322},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2937":60327,"_26000":60318,"_18071":101324,"_5":17966,"_24599":101299,"_2447":101325},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2937":60328,"_26000":60318,"_18071":101327,"_5":17966,"_24599":101303,"_2447":101328},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2937":60329,"_26000":60318,"_18071":101330,"_5":17966,"_24599":101303,"_2447":101331},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2937":60330,"_26000":60318,"_18071":101333,"_5":17966,"_24599":101303,"_2447":101334},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2937":60331,"_26000":60318,"_18071":101336,"_5":17966,"_24599":101307,"_2447":101337},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2937":60332,"_26000":60318,"_18071":101339,"_5":17966,"_24599":101307,"_2447":101340},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2937":60333,"_26000":60318,"_18071":101342,"_5":17966,"_24599":101311,"_2447":101343},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2937":60334,"_26000":60318,"_18071":101345,"_5":17966,"_24599":101311,"_2447":101346},[],"Ejemplo de cuerpo:",{"_2937":60335,"_26000":60318,"_18071":101348,"_5":17966,"_24599":101311,"_2447":101349},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2937":60336,"_26000":60318,"_18071":101351,"_5":17966,"_24599":101311,"_2447":101352},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2937":60337,"_26000":60318,"_18071":101354,"_5":17966,"_24599":101311,"_2447":101355},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2937":60338,"_26000":60318,"_18071":101357,"_5":17966,"_24599":101311,"_2447":101358},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2937":60339,"_26000":60318,"_18071":101360,"_5":17966,"_24599":101315,"_2447":101361},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2937":60340,"_26000":60318,"_18071":101363,"_5":17966,"_24599":101315,"_2447":101364},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2937":60341,"_26000":60341,"_5":12545,"_2447":101366,"_26339":101367,"_18071":101368,"_24599":60341},"Configura y opera el DMS",[42089,100145,44610,101117,101292],[],{"_2937":60342,"_26000":60341,"_18071":101370,"_5":17966,"_24599":60341,"_2447":101371},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2937":60343,"_26000":60341,"_5":26336,"_18071":101373,"_24599":101374,"_2447":98644},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2937":60344,"_26000":60341,"_5":26336,"_18071":101376,"_24599":101377,"_2447":101378},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2937":60345,"_26000":60341,"_5":26336,"_18071":101380,"_24599":101381,"_2447":101382},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2937":60346,"_26000":60341,"_5":26336,"_18071":101384,"_24599":101385,"_2447":101386},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2937":60347,"_26000":60341,"_5":26336,"_18071":101388,"_24599":101389,"_2447":101390},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2937":60348,"_26000":60341,"_5":26336,"_18071":101392,"_24599":101393,"_2447":101394},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2937":60349,"_26000":60341,"_5":26336,"_18071":101396,"_24599":101397,"_2447":101398},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2937":60350,"_26000":60341,"_5":26336,"_18071":101400,"_24599":101401,"_2447":101402},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2937":60351,"_26000":60341,"_5":26336,"_18071":101404,"_24599":101405,"_2447":44905},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2937":60352,"_26000":60341,"_5":26336,"_18071":101407,"_24599":101408,"_2447":44909},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2937":60353,"_26000":60341,"_5":26336,"_18071":101410,"_24599":101411,"_2447":101412},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2937":60354,"_26000":60341,"_5":26336,"_18071":101414,"_24599":101415,"_2447":101416},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2937":60355,"_26000":60341,"_5":26336,"_18071":101418,"_24599":101419,"_2447":101420},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2937":60356,"_26000":60341,"_5":26336,"_18071":101422,"_24599":101423,"_2447":101424},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2937":60357,"_26000":60341,"_5":26336,"_18071":101426,"_24599":101427,"_2447":44929},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2937":60358,"_26000":60341,"_5":26336,"_18071":101429,"_24599":101430,"_2447":101431},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2937":60359,"_26000":60341,"_5":26336,"_18071":101433,"_24599":101434,"_2447":101435},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2937":60360,"_26000":60341,"_5":26336,"_18071":101437,"_24599":101438,"_2447":101439},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2937":60361,"_26000":60341,"_18071":101441,"_5":17966,"_24599":60341,"_2447":101442},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2937":60362,"_26000":60341,"_18071":101444,"_5":17966,"_24599":101374,"_2447":101445},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2937":60363,"_26000":60341,"_18071":101447,"_5":17966,"_24599":101374,"_2447":101448},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2937":60364,"_26000":60341,"_18071":101450,"_5":17966,"_24599":101381,"_2447":101451},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2937":60365,"_26000":60341,"_18071":101453,"_5":17966,"_24599":101385,"_2447":101454},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2937":60366,"_26000":60341,"_18071":101456,"_5":17966,"_24599":101389,"_2447":101457},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2937":60367,"_26000":60341,"_18071":101459,"_5":17966,"_24599":101393,"_2447":101460},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2937":60368,"_26000":60341,"_18071":101462,"_5":17966,"_24599":101397,"_2447":101463},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2937":60369,"_26000":60341,"_18071":101465,"_5":17966,"_24599":101405,"_2447":101466},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2937":60370,"_26000":60341,"_18071":101468,"_5":17966,"_24599":101405,"_2447":101469},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2937":60371,"_26000":60341,"_18071":101471,"_5":17966,"_24599":101408,"_2447":101472},[],"Campo de `settings.enrollment_settings`",{"_2937":60372,"_26000":60341,"_18071":101474,"_5":17966,"_24599":101408,"_2447":101475},[],"Decisión",{"_2937":60373,"_26000":60341,"_18071":101477,"_5":17966,"_24599":101408,"_2447":44980},[],{"_2937":60374,"_26000":60341,"_18071":101479,"_5":17966,"_24599":101408,"_2447":101480},[],"`EST_RFC7030` para estas operaciones.",{"_2937":60375,"_26000":60341,"_18071":101482,"_5":17966,"_24599":101408,"_2447":44986},[],{"_2937":60376,"_26000":60341,"_18071":101484,"_5":17966,"_24599":101408,"_2447":101485},[],"ID de la CA que firmará.",{"_2937":60377,"_26000":60341,"_18071":101487,"_5":17966,"_24599":101408,"_2447":44992},[],{"_2937":60378,"_26000":60341,"_18071":101489,"_5":17966,"_24599":101408,"_2447":101490},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2937":60379,"_26000":60341,"_18071":101492,"_5":17966,"_24599":101408,"_2447":44998},[],{"_2937":60380,"_26000":60341,"_18071":101494,"_5":17966,"_24599":101408,"_2447":101495},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2937":60381,"_26000":60341,"_18071":101497,"_5":17966,"_24599":101408,"_2447":45004},[],{"_2937":60382,"_26000":60341,"_18071":101499,"_5":17966,"_24599":101408,"_2447":101500},[],"Uno de los cuatro modos de autenticación.",{"_2937":60383,"_26000":60341,"_18071":101502,"_5":17966,"_24599":101408,"_2447":101503},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2937":60384,"_26000":60341,"_18071":101505,"_5":17966,"_24599":101411,"_2447":101506},[],"Los bloques son independientes:",{"_2937":60385,"_26000":60341,"_18071":101508,"_5":17966,"_24599":101411,"_2447":101509},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2937":60386,"_26000":60341,"_18071":101511,"_5":17966,"_24599":101411,"_2447":101512},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2937":60387,"_26000":60341,"_18071":101514,"_5":17966,"_24599":101411,"_2447":45022},[],{"_2937":60388,"_26000":60341,"_18071":101516,"_5":17966,"_24599":101411,"_2447":101517},[],"Control aplicado en la operación configurada",{"_2937":60389,"_26000":60341,"_18071":101519,"_5":17966,"_24599":101411,"_2447":45028},[],{"_2937":60390,"_26000":60341,"_18071":101521,"_5":17966,"_24599":101411,"_2447":101522},[],"Validación del certificado presentado.",{"_2937":60391,"_26000":60341,"_18071":101524,"_5":17966,"_24599":101411,"_2447":45034},[],{"_2937":60392,"_26000":60341,"_18071":101526,"_5":17966,"_24599":101411,"_2447":101527},[],"Autorización del webhook configurado.",{"_2937":60393,"_26000":60341,"_18071":101529,"_5":17966,"_24599":101411,"_2447":45040},[],{"_2937":60394,"_26000":60341,"_18071":101531,"_5":17966,"_24599":101411,"_2447":101532},[],"Validación del certificado y, después, aprobación del webhook.",{"_2937":60395,"_26000":60341,"_18071":101534,"_5":17966,"_24599":101411,"_2447":45046},[],{"_2937":60396,"_26000":60341,"_18071":101536,"_5":17966,"_24599":101411,"_2447":101537},[],"Sin autenticación del solicitante por el DMS.",{"_2937":60397,"_26000":60341,"_18071":101539,"_5":17966,"_24599":101411,"_2447":101540},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2937":60398,"_26000":60341,"_18071":101542,"_5":17966,"_24599":101411,"_2447":101543},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2937":60399,"_26000":60341,"_18071":101545,"_5":17966,"_24599":101411,"_2447":101546},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2937":60400,"_26000":60341,"_18071":101548,"_5":17966,"_24599":101411,"_2447":101549},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2937":60401,"_26000":60341,"_18071":101551,"_5":17966,"_24599":101415,"_2447":101552},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2937":60402,"_26000":60341,"_18071":101554,"_5":17966,"_24599":101415,"_2447":101555},[],"Campo de `external_webhook_settings`",{"_2937":60403,"_26000":60341,"_18071":101557,"_5":17966,"_24599":101415,"_2447":101475},[],{"_2937":60404,"_26000":60341,"_18071":101559,"_5":17966,"_24599":101415,"_2447":45072},[],{"_2937":60405,"_26000":60341,"_18071":101561,"_5":17966,"_24599":101415,"_2447":101562},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2937":60406,"_26000":60341,"_18071":101564,"_5":17966,"_24599":101415,"_2447":45078},[],{"_2937":60407,"_26000":60341,"_18071":101566,"_5":17966,"_24599":101415,"_2447":101567},[],"`POST` o `PUT`; `POST` por defecto.",{"_2937":60408,"_26000":60341,"_18071":101569,"_5":17966,"_24599":101415,"_2447":45084},[],{"_2937":60409,"_26000":60341,"_18071":101571,"_5":17966,"_24599":101415,"_2447":101572},[],"Etiqueta usada en los logs del servicio.",{"_2937":60410,"_26000":60341,"_18071":101574,"_5":17966,"_24599":101415,"_2447":45090},[],{"_2937":60411,"_26000":60341,"_18071":101576,"_5":17966,"_24599":101415,"_2447":101577},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2937":60412,"_26000":60341,"_18071":101579,"_5":17966,"_24599":101415,"_2447":45096},[],{"_2937":60413,"_26000":60341,"_18071":101581,"_5":17966,"_24599":101415,"_2447":101582},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2937":60414,"_26000":60341,"_18071":101584,"_5":17966,"_24599":101415,"_2447":45102},[],{"_2937":60415,"_26000":60341,"_18071":101586,"_5":17966,"_24599":101415,"_2447":101587},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2937":60416,"_26000":60341,"_18071":101589,"_5":17966,"_24599":101415,"_2447":45108},[],{"_2937":60417,"_26000":60341,"_18071":101591,"_5":17966,"_24599":101415,"_2447":101592},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2937":60418,"_26000":60341,"_18071":101594,"_5":17966,"_24599":101415,"_2447":45114},[],{"_2937":60419,"_26000":60341,"_18071":101596,"_5":17966,"_24599":101415,"_2447":101597},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2937":60420,"_26000":60341,"_18071":101599,"_5":17966,"_24599":101415,"_2447":45120},[],{"_2937":60421,"_26000":60341,"_18071":101601,"_5":17966,"_24599":101415,"_2447":101602},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2937":60422,"_26000":60341,"_18071":101604,"_5":17966,"_24599":101415,"_2447":101605},[],"Reglas de esa configuración:",{"_2937":60423,"_26000":60341,"_18071":101607,"_5":17966,"_24599":101415,"_2447":101608},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2937":60424,"_26000":60341,"_18071":101610,"_5":17966,"_24599":101415,"_2447":101611},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2937":60425,"_26000":60341,"_18071":101613,"_5":17966,"_24599":101415,"_2447":101614},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2937":60426,"_26000":60341,"_18071":101616,"_5":17966,"_24599":101415,"_2447":101617},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2937":60427,"_26000":60341,"_18071":101619,"_5":17966,"_24599":101415,"_2447":101620},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2937":60428,"_26000":60341,"_18071":101622,"_5":17966,"_24599":101415,"_2447":101623},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2937":60429,"_26000":60341,"_18071":101625,"_5":17966,"_24599":101415,"_2447":101626},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2937":60430,"_26000":60341,"_18071":101628,"_5":17966,"_24599":101415,"_2447":101629},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2937":60431,"_26000":60341,"_18071":101631,"_5":17966,"_24599":101419,"_2447":101632},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2937":60432,"_26000":60341,"_18071":101634,"_5":17966,"_24599":101423,"_2447":101635},[],"Campo de `settings.reenrollment_settings`",{"_2937":60433,"_26000":60341,"_18071":101637,"_5":17966,"_24599":101423,"_2447":101638},[],"Función",{"_2937":60434,"_26000":60341,"_18071":101640,"_5":17966,"_24599":101423,"_2447":45161},[],{"_2937":60435,"_26000":60341,"_18071":101642,"_5":17966,"_24599":101423,"_2447":101643},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2937":60436,"_26000":60341,"_18071":101645,"_5":17966,"_24599":101423,"_2447":45167},[],{"_2937":60437,"_26000":60341,"_18071":101647,"_5":17966,"_24599":101423,"_2447":101648},[],"Umbral operativo preventivo de monitorización.",{"_2937":60438,"_26000":60341,"_18071":101650,"_5":17966,"_24599":101423,"_2447":45173},[],{"_2937":60439,"_26000":60341,"_18071":101652,"_5":17966,"_24599":101423,"_2447":101653},[],"Umbral operativo crítico de monitorización.",{"_2937":60440,"_26000":60341,"_18071":101655,"_5":17966,"_24599":101423,"_2447":45179},[],{"_2937":60441,"_26000":60341,"_18071":101657,"_5":17966,"_24599":101423,"_2447":101658},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2937":60442,"_26000":60341,"_18071":101660,"_5":17966,"_24599":101423,"_2447":45185},[],{"_2937":60443,"_26000":60341,"_18071":101662,"_5":17966,"_24599":101423,"_2447":101663},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2937":60444,"_26000":60341,"_18071":101665,"_5":17966,"_24599":101423,"_2447":45191},[],{"_2937":60445,"_26000":60341,"_18071":101667,"_5":17966,"_24599":101423,"_2447":101668},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2937":60446,"_26000":60341,"_18071":101670,"_5":17966,"_24599":101423,"_2447":101671},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2937":60447,"_26000":60341,"_18071":101673,"_5":17966,"_24599":101427,"_2447":101674},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2937":60448,"_26000":60341,"_18071":101676,"_5":17966,"_24599":101430,"_2447":99004},[],{"_2937":60449,"_26000":60341,"_18071":101678,"_5":17966,"_24599":101430,"_2447":101679},[],"Qué publica",{"_2937":60450,"_26000":60341,"_18071":101681,"_5":17966,"_24599":101430,"_2447":45208},[],{"_2937":60451,"_26000":60341,"_18071":101683,"_5":17966,"_24599":101430,"_2447":101684},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2937":60452,"_26000":60341,"_18071":101686,"_5":17966,"_24599":101430,"_2447":45214},[],{"_2937":60453,"_26000":60341,"_18071":101688,"_5":17966,"_24599":101430,"_2447":101689},[],"Certificado de la CA emisora seleccionada.",{"_2937":60454,"_26000":60341,"_18071":101691,"_5":17966,"_24599":101430,"_2447":45220},[],{"_2937":60455,"_26000":60341,"_18071":101693,"_5":17966,"_24599":101430,"_2447":101694},[],"Certificados de las CAs elegidas explícitamente.",{"_2937":60456,"_26000":60341,"_18071":101696,"_5":17966,"_24599":101430,"_2447":101697},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2937":60457,"_26000":60341,"_18071":101699,"_5":17966,"_24599":101434,"_2447":101700},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2937":60458,"_26000":60341,"_18071":101702,"_5":17966,"_24599":101434,"_2447":101703},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2937":60459,"_26000":60341,"_18071":101705,"_5":17966,"_24599":101434,"_2447":101706},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2937":60460,"_26000":60341,"_18071":101708,"_5":17966,"_24599":101438,"_2447":101709},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2937":60461,"_26000":60461,"_5":12545,"_2447":101711,"_26339":101712,"_18071":101713,"_24599":60461},"Integra el cliente EST",[42089,100145,44610,101117,101292],[],{"_2937":60462,"_26000":60461,"_18071":101715,"_5":17966,"_24599":60461,"_2447":101716},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2937":60463,"_26000":60461,"_5":26336,"_18071":101718,"_24599":101719,"_2447":98644},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2937":60464,"_26000":60461,"_5":26336,"_18071":101721,"_24599":101722,"_2447":101723},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2937":60465,"_26000":60461,"_5":26336,"_18071":101725,"_24599":101726,"_2447":101727},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2937":60466,"_26000":60461,"_5":26336,"_18071":101729,"_24599":101730,"_2447":101731},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2937":60467,"_26000":60461,"_5":26336,"_18071":101733,"_24599":101734,"_2447":101735},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2937":60468,"_26000":60461,"_5":26336,"_18071":101737,"_24599":101738,"_2447":101739},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2937":60469,"_26000":60461,"_18071":101741,"_5":17966,"_24599":60461,"_2447":101742},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2937":60470,"_26000":60461,"_18071":101744,"_5":17966,"_24599":101719,"_2447":101745},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2937":60471,"_26000":60461,"_18071":101747,"_5":17966,"_24599":101719,"_2447":101748},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2937":60472,"_26000":60461,"_18071":101750,"_5":17966,"_24599":101719,"_2447":101751},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2937":60473,"_26000":60461,"_18071":101753,"_5":17966,"_24599":101722,"_2447":101754},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2937":60474,"_26000":60461,"_18071":101756,"_5":17966,"_24599":101722,"_2447":101757},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2937":60475,"_26000":60461,"_18071":101759,"_5":17966,"_24599":101726,"_2447":101760},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2937":60476,"_26000":60461,"_18071":101762,"_5":17966,"_24599":101726,"_2447":101763},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2937":60477,"_26000":60461,"_18071":101765,"_5":17966,"_24599":101730,"_2447":101766},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2937":60478,"_26000":60461,"_18071":101768,"_5":17966,"_24599":101730,"_2447":101769},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2937":60479,"_26000":60461,"_18071":101771,"_5":17966,"_24599":101734,"_2447":101772},[],"Para el caso de una raíz que emite directamente:",{"_2937":60480,"_26000":60461,"_18071":101774,"_5":17966,"_24599":101734,"_2447":101775},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2937":60481,"_26000":60461,"_18071":101777,"_5":17966,"_24599":101734,"_2447":101778},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2937":60482,"_26000":60461,"_18071":101780,"_5":17966,"_24599":101738,"_2447":101781},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2937":60483,"_26000":60483,"_5":12545,"_2447":101783,"_26339":101784,"_18071":101785,"_24599":60483},"Referencia EST",[42089,100145,44610,101117,101292],[],{"_2937":60484,"_26000":60483,"_18071":101787,"_5":17966,"_24599":60483,"_2447":101788},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2937":60485,"_26000":60483,"_5":26336,"_18071":101790,"_24599":101791,"_2447":101792},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2937":60486,"_26000":60483,"_5":26336,"_18071":101794,"_24599":101795,"_2447":19605},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2937":60487,"_26000":60483,"_5":26336,"_18071":101797,"_24599":101798,"_2447":22533},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2937":60488,"_26000":60483,"_5":26336,"_18071":101800,"_24599":101801,"_2447":22540},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2937":60489,"_26000":60483,"_5":26336,"_18071":101803,"_24599":101804,"_2447":21895},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2937":60490,"_26000":60483,"_5":26336,"_18071":101806,"_24599":101807,"_2447":101808},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2937":60491,"_26000":60483,"_5":26336,"_18071":101810,"_24599":101811,"_2447":101812},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2937":60492,"_26000":60483,"_5":26336,"_18071":101814,"_24599":101815,"_2447":101816},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2937":60493,"_26000":60483,"_18071":101818,"_5":17966,"_24599":60483,"_2447":101819},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2937":60494,"_26000":60483,"_18071":101821,"_5":17966,"_24599":101791,"_2447":101822},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2937":60495,"_26000":60483,"_18071":101824,"_5":17966,"_24599":101791,"_2447":99936},[],{"_2937":60496,"_26000":60483,"_18071":101826,"_5":17966,"_24599":101791,"_2447":101827},[],"Método",{"_2937":60497,"_26000":60483,"_18071":101829,"_5":17966,"_24599":101791,"_2447":101830},[],"Autenticación y condición",{"_2937":60498,"_26000":60483,"_18071":101832,"_5":17966,"_24599":101791,"_2447":45363},[],{"_2937":60499,"_26000":60483,"_18071":101834,"_5":17966,"_24599":101791,"_2447":45366},[],{"_2937":60500,"_26000":60483,"_18071":101836,"_5":17966,"_24599":101791,"_2447":101837},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2937":60501,"_26000":60483,"_18071":101839,"_5":17966,"_24599":101791,"_2447":45372},[],{"_2937":60502,"_26000":60483,"_18071":101841,"_5":17966,"_24599":101791,"_2447":45375},[],{"_2937":60503,"_26000":60483,"_18071":101843,"_5":17966,"_24599":101791,"_2447":101844},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2937":60504,"_26000":60483,"_18071":101846,"_5":17966,"_24599":101791,"_2447":45381},[],{"_2937":60505,"_26000":60483,"_18071":101848,"_5":17966,"_24599":101791,"_2447":45375},[],{"_2937":60506,"_26000":60483,"_18071":101850,"_5":17966,"_24599":101791,"_2447":101851},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2937":60507,"_26000":60483,"_18071":101853,"_5":17966,"_24599":101791,"_2447":45389},[],{"_2937":60508,"_26000":60483,"_18071":101855,"_5":17966,"_24599":101791,"_2447":45375},[],{"_2937":60509,"_26000":60483,"_18071":101857,"_5":17966,"_24599":101791,"_2447":101858},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2937":60510,"_26000":60483,"_18071":101860,"_5":17966,"_24599":101791,"_2447":101861},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2937":60511,"_26000":60483,"_18071":101863,"_5":17966,"_24599":101795,"_2447":101864},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2937":60512,"_26000":60483,"_18071":101866,"_5":17966,"_24599":101795,"_2447":101867},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2937":60513,"_26000":60483,"_18071":101869,"_5":17966,"_24599":101798,"_2447":101870},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2937":60514,"_26000":60483,"_18071":101872,"_5":17966,"_24599":101798,"_2447":101873},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2937":60515,"_26000":60483,"_18071":101875,"_5":17966,"_24599":101801,"_2447":101876},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2937":60516,"_26000":60483,"_18071":101878,"_5":17966,"_24599":101801,"_2447":101879},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2937":60517,"_26000":60483,"_18071":101881,"_5":17966,"_24599":101804,"_2447":101882},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2937":60518,"_26000":60483,"_18071":101884,"_5":17966,"_24599":101804,"_2447":101885},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2937":60519,"_26000":60483,"_18071":101887,"_5":17966,"_24599":101807,"_2447":101888},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2937":60520,"_26000":60483,"_18071":101890,"_5":17966,"_24599":101807,"_2447":101891},[],"Parte",{"_2937":60521,"_26000":60483,"_18071":101893,"_5":17966,"_24599":101807,"_2447":101894},[],"Contenido tras decodificar su Base64",{"_2937":60522,"_26000":60483,"_18071":101896,"_5":17966,"_24599":101807,"_2447":45433},[],{"_2937":60523,"_26000":60483,"_18071":101898,"_5":17966,"_24599":101807,"_2447":101899},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2937":60524,"_26000":60483,"_18071":101901,"_5":17966,"_24599":101807,"_2447":45439},[],{"_2937":60525,"_26000":60483,"_18071":101903,"_5":17966,"_24599":101807,"_2447":101904},[],"PKCS#7 DER con el certificado emitido.",{"_2937":60526,"_26000":60483,"_18071":101906,"_5":17966,"_24599":101807,"_2447":101907},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2937":60527,"_26000":60483,"_18071":101909,"_5":17966,"_24599":101811,"_2447":101910},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2937":60528,"_26000":60483,"_18071":101912,"_5":17966,"_24599":101811,"_2447":101913},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2937":60529,"_26000":60483,"_18071":101915,"_5":17966,"_24599":101811,"_2447":101916},[],"Convierte y comprueba el resultado:",{"_2937":60530,"_26000":60483,"_18071":101918,"_5":17966,"_24599":101811,"_2447":101919},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2937":60531,"_26000":60483,"_18071":101921,"_5":17966,"_24599":101815,"_2447":101922},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2937":60532,"_26000":60483,"_18071":101924,"_5":17966,"_24599":101815,"_2447":101925},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2937":60533,"_26000":60533,"_5":12545,"_2447":101292,"_26339":101927,"_18071":101928,"_24599":60533},[42089,100145,44610,101117,101292],[],{"_2937":60534,"_26000":60533,"_18071":101930,"_5":17966,"_24599":60533,"_2447":101931},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2937":60535,"_26000":60533,"_5":26336,"_18071":101933,"_24599":101934,"_2447":101935},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2937":60536,"_26000":60533,"_5":26336,"_18071":101937,"_24599":101938,"_2447":101939},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2937":60537,"_26000":60533,"_5":26336,"_18071":101941,"_24599":101942,"_2447":101943},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2937":60538,"_26000":60533,"_5":26336,"_18071":101945,"_24599":101946,"_2447":101947},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2937":60539,"_26000":60533,"_18071":101949,"_5":17966,"_24599":60533,"_2447":101950},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2937":60540,"_26000":60533,"_18071":101952,"_5":17966,"_24599":101934,"_2447":101953},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2937":60541,"_26000":60533,"_18071":101955,"_5":17966,"_24599":101934,"_2447":101956},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2937":60542,"_26000":60533,"_18071":101958,"_5":17966,"_24599":101934,"_2447":101959},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2937":60543,"_26000":60533,"_18071":101961,"_5":17966,"_24599":101934,"_2447":101962},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2937":60544,"_26000":60533,"_18071":101964,"_5":17966,"_24599":101934,"_2447":101965},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2937":60545,"_26000":60533,"_18071":101967,"_5":17966,"_24599":101934,"_2447":101968},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2937":60546,"_26000":60533,"_18071":101970,"_5":17966,"_24599":101938,"_2447":101971},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2937":60547,"_26000":60533,"_18071":101973,"_5":17966,"_24599":101938,"_2447":101974},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2937":60548,"_26000":60533,"_18071":101976,"_5":17966,"_24599":101938,"_2447":101977},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2937":60549,"_26000":60533,"_18071":101979,"_5":17966,"_24599":101938,"_2447":101980},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2937":60550,"_26000":60533,"_18071":101982,"_5":17966,"_24599":101942,"_2447":101983},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2937":60551,"_26000":60533,"_18071":101985,"_5":17966,"_24599":101942,"_2447":101986},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2937":60552,"_26000":60533,"_18071":101988,"_5":17966,"_24599":101942,"_2447":101989},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2937":60553,"_26000":60533,"_18071":101991,"_5":17966,"_24599":101942,"_2447":101992},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2937":60554,"_26000":60533,"_18071":101994,"_5":17966,"_24599":101946,"_2447":101995},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2937":60555,"_26000":60533,"_18071":101997,"_5":17966,"_24599":101946,"_2447":101998},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2937":60556,"_26000":60556,"_5":12545,"_2447":102000,"_26339":102001,"_18071":102002,"_24599":60556},"Estrategias de aprovisionamiento",[42089,100145,44610,101117,101292],[],{"_2937":60557,"_26000":60556,"_18071":102004,"_5":17966,"_24599":60556,"_2447":102005},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2937":60558,"_26000":60556,"_5":26336,"_18071":102007,"_24599":102008,"_2447":102009},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2937":60559,"_26000":60556,"_5":26336,"_18071":102011,"_24599":102012,"_2447":102013},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2937":60560,"_26000":60556,"_5":26336,"_18071":102015,"_24599":102016,"_2447":102017},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2937":60561,"_26000":60556,"_5":26336,"_18071":102019,"_24599":102020,"_2447":102021},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2937":60562,"_26000":60556,"_5":26336,"_18071":102023,"_24599":102024,"_2447":102025},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2937":60563,"_26000":60556,"_18071":102027,"_5":17966,"_24599":60556,"_2447":102028},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2937":60564,"_26000":60556,"_18071":102030,"_5":17966,"_24599":102008,"_2447":102031},[],"Recorrido",{"_2937":60565,"_26000":60556,"_18071":102033,"_5":17966,"_24599":102008,"_2447":102034},[],"Cuándo existe el dispositivo",{"_2937":60566,"_26000":60556,"_18071":102036,"_5":17966,"_24599":102008,"_2447":102037},[],"Qué compruebas",{"_2937":60567,"_26000":60556,"_18071":102039,"_5":17966,"_24599":102008,"_2447":102040},[],"Asignación manual",{"_2937":60568,"_26000":60556,"_18071":102042,"_5":17966,"_24599":102008,"_2447":102043},[],"El operador lo crea antes de asociar un certificado.",{"_2937":60569,"_26000":60556,"_18071":102045,"_5":17966,"_24599":102008,"_2447":102046},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2937":60570,"_26000":60556,"_18071":102048,"_5":17966,"_24599":102008,"_2447":102049},[],"EST con `JITP`",{"_2937":60571,"_26000":60556,"_18071":102051,"_5":17966,"_24599":102008,"_2447":102052},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2937":60572,"_26000":60556,"_18071":102054,"_5":17966,"_24599":102008,"_2447":102055},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2937":60573,"_26000":60556,"_18071":102057,"_5":17966,"_24599":102008,"_2447":102058},[],"EST con `PRE_REGISTRATION`",{"_2937":60574,"_26000":60556,"_18071":102060,"_5":17966,"_24599":102008,"_2447":102061},[],"Debe existir antes de `/simpleenroll`.",{"_2937":60575,"_26000":60556,"_18071":102063,"_5":17966,"_24599":102008,"_2447":102064},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2937":60576,"_26000":60556,"_18071":102066,"_5":17966,"_24599":102008,"_2447":102067},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2937":60577,"_26000":60556,"_18071":102069,"_5":17966,"_24599":102008,"_2447":102070},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2937":60578,"_26000":60556,"_18071":102072,"_5":17966,"_24599":102012,"_2447":102073},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2937":60579,"_26000":60556,"_18071":102075,"_5":17966,"_24599":102012,"_2447":102076},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2937":60580,"_26000":60556,"_18071":102078,"_5":17966,"_24599":102012,"_2447":102079},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2937":60581,"_26000":60556,"_18071":102081,"_5":17966,"_24599":102016,"_2447":102082},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2937":60582,"_26000":60556,"_18071":102084,"_5":17966,"_24599":102016,"_2447":102085},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2937":60583,"_26000":60556,"_18071":102087,"_5":17966,"_24599":102016,"_2447":102088},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2937":60584,"_26000":60556,"_18071":102090,"_5":17966,"_24599":102016,"_2447":102091},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2937":60585,"_26000":60556,"_18071":102093,"_5":17966,"_24599":102016,"_2447":102094},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2937":60586,"_26000":60556,"_18071":102096,"_5":17966,"_24599":102016,"_2447":102097},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2937":60587,"_26000":60556,"_18071":102099,"_5":17966,"_24599":102020,"_2447":99004},[],{"_2937":60588,"_26000":60556,"_18071":102101,"_5":17966,"_24599":102020,"_2447":102102},[],"Material que atraviesa EST",{"_2937":60589,"_26000":60556,"_18071":102104,"_5":17966,"_24599":102020,"_2447":102105},[],"Clave generada por el dispositivo",{"_2937":60590,"_26000":60556,"_18071":102107,"_5":17966,"_24599":102020,"_2447":102108},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2937":60591,"_26000":60556,"_18071":102110,"_5":17966,"_24599":102020,"_2447":102111},[],"Clave ya disponible en el dispositivo",{"_2937":60592,"_26000":60556,"_18071":102113,"_5":17966,"_24599":102020,"_2447":102114},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2937":60593,"_26000":60556,"_18071":102116,"_5":17966,"_24599":102020,"_2447":44929},[],{"_2937":60594,"_26000":60556,"_18071":102118,"_5":17966,"_24599":102020,"_2447":102119},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2937":60595,"_26000":60556,"_18071":102121,"_5":17966,"_24599":102020,"_2447":102122},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2937":60596,"_26000":60556,"_18071":102124,"_5":17966,"_24599":102024,"_2447":102125},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2937":60597,"_26000":60597,"_5":12545,"_2447":102127,"_26339":102128,"_18071":102129,"_24599":60597},"Renovación y recuperación",[42089,100145,44610,101117,101292],[],{"_2937":60598,"_26000":60597,"_18071":102131,"_5":17966,"_24599":60597,"_2447":102132},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2937":60599,"_26000":60597,"_5":26336,"_18071":102134,"_24599":102135,"_2447":102136},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2937":60600,"_26000":60597,"_5":26336,"_18071":102138,"_24599":102139,"_2447":102140},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2937":60601,"_26000":60597,"_5":26336,"_18071":102142,"_24599":102143,"_2447":102144},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2937":60602,"_26000":60597,"_5":26336,"_18071":102146,"_24599":102147,"_2447":102148},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2937":60603,"_26000":60597,"_5":26336,"_18071":102150,"_24599":102151,"_2447":102152},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2937":60604,"_26000":60597,"_18071":102154,"_5":17966,"_24599":60597,"_2447":102155},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2937":60605,"_26000":60597,"_18071":102157,"_5":17966,"_24599":102135,"_2447":102158},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2937":60606,"_26000":60597,"_18071":102160,"_5":17966,"_24599":102135,"_2447":102161},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2937":60607,"_26000":60597,"_18071":102163,"_5":17966,"_24599":102135,"_2447":102164},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2937":60608,"_26000":60597,"_18071":102166,"_5":17966,"_24599":102135,"_2447":102167},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2937":60609,"_26000":60597,"_18071":102169,"_5":17966,"_24599":102139,"_2447":102170},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2937":60610,"_26000":60597,"_18071":102172,"_5":17966,"_24599":102139,"_2447":102173},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2937":60611,"_26000":60597,"_18071":102175,"_5":17966,"_24599":102143,"_2447":102176},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2937":60612,"_26000":60597,"_18071":102178,"_5":17966,"_24599":102143,"_2447":102179},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2937":60613,"_26000":60597,"_18071":102181,"_5":17966,"_24599":102143,"_2447":102182},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2937":60614,"_26000":60597,"_18071":102184,"_5":17966,"_24599":102147,"_2447":102185},[],"Situación",{"_2937":60615,"_26000":60597,"_18071":102187,"_5":17966,"_24599":102147,"_2447":102188},[],"Procedimiento",{"_2937":60616,"_26000":60597,"_18071":102190,"_5":17966,"_24599":102147,"_2447":102191},[],"Certificado vigente, fuera de ventana",{"_2937":60617,"_26000":60597,"_18071":102193,"_5":17966,"_24599":102147,"_2447":102194},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2937":60618,"_26000":60597,"_18071":102196,"_5":17966,"_24599":102147,"_2447":102197},[],"Certificado vencido, clave disponible",{"_2937":60619,"_26000":60597,"_18071":102199,"_5":17966,"_24599":102147,"_2447":102200},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2937":60620,"_26000":60597,"_18071":102202,"_5":17966,"_24599":102147,"_2447":102203},[],"Renovación por webhook o `NO_AUTH`",{"_2937":60621,"_26000":60597,"_18071":102205,"_5":17966,"_24599":102147,"_2447":102206},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2937":60622,"_26000":60597,"_18071":102208,"_5":17966,"_24599":102147,"_2447":102209},[],"Clave perdida o inaccesible",{"_2937":60623,"_26000":60597,"_18071":102211,"_5":17966,"_24599":102147,"_2447":102212},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2937":60624,"_26000":60597,"_18071":102214,"_5":17966,"_24599":102147,"_2447":102215},[],"Identidad actual revocada",{"_2937":60625,"_26000":60597,"_18071":102217,"_5":17966,"_24599":102147,"_2447":102218},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2937":60626,"_26000":60597,"_18071":102220,"_5":17966,"_24599":102147,"_2447":102221},[],"Dispositivo sin identidad",{"_2937":60627,"_26000":60597,"_18071":102223,"_5":17966,"_24599":102147,"_2447":102224},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2937":60628,"_26000":60597,"_18071":102226,"_5":17966,"_24599":102147,"_2447":102227},[],"Dispositivo retirado",{"_2937":60629,"_26000":60597,"_18071":102229,"_5":17966,"_24599":102147,"_2447":102230},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2937":60630,"_26000":60597,"_18071":102232,"_5":17966,"_24599":102147,"_2447":102233},[],"Timeout, HTTP 500 o fallo de instalación",{"_2937":60631,"_26000":60597,"_18071":102235,"_5":17966,"_24599":102147,"_2447":102236},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2937":60632,"_26000":60597,"_18071":102238,"_5":17966,"_24599":102151,"_2447":102239},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2937":60633,"_26000":60597,"_18071":102241,"_5":17966,"_24599":102151,"_2447":102242},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2937":60634,"_26000":60634,"_5":12545,"_2447":102244,"_26339":102245,"_18071":102246,"_24599":60634},"Diagnóstico de enrolamiento",[42089,100145,44610,101117,101292],[],{"_2937":60635,"_26000":60634,"_18071":102248,"_5":17966,"_24599":60634,"_2447":102249},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2937":60636,"_26000":60634,"_5":26336,"_18071":102251,"_24599":102252,"_2447":102253},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2937":60637,"_26000":60634,"_5":26336,"_18071":102255,"_24599":102256,"_2447":102257},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2937":60638,"_26000":60634,"_5":26336,"_18071":102259,"_24599":102260,"_2447":101816},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2937":60639,"_26000":60634,"_5":26336,"_18071":102262,"_24599":102263,"_2447":102264},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2937":60640,"_26000":60634,"_18071":102266,"_5":17966,"_24599":60634,"_2447":102267},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2937":60641,"_26000":60634,"_18071":102269,"_5":17966,"_24599":102256,"_2447":102270},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2937":60642,"_26000":60634,"_18071":102272,"_5":17966,"_24599":102256,"_2447":102273},[],"Síntoma o mensaje",{"_2937":60643,"_26000":60634,"_18071":102275,"_5":17966,"_24599":102256,"_2447":102276},[],"Qué revisar",{"_2937":60644,"_26000":60634,"_18071":102278,"_5":17966,"_24599":102256,"_2447":102279},[],"curl rechaza TLS, nombre o emisor",{"_2937":60645,"_26000":60634,"_18071":102281,"_5":17966,"_24599":102256,"_2447":102282},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2937":60646,"_26000":60634,"_18071":102284,"_5":17966,"_24599":102256,"_2447":102285},[],"404 o APS ausente",{"_2937":60647,"_26000":60634,"_18071":102287,"_5":17966,"_24599":102256,"_2447":102288},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2937":60648,"_26000":60634,"_18071":102290,"_5":17966,"_24599":102256,"_2447":102291},[],"400, error de CSR o formato",{"_2937":60649,"_26000":60634,"_18071":102293,"_5":17966,"_24599":102256,"_2447":102294},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2937":60650,"_26000":60634,"_18071":102296,"_5":17966,"_24599":102256,"_2447":102297},[],"Credencial ausente o certificado no válido",{"_2937":60651,"_26000":60634,"_18071":102299,"_5":17966,"_24599":102256,"_2447":102300},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2937":60652,"_26000":60634,"_18071":102302,"_5":17966,"_24599":102256,"_2447":102303},[],"Webhook deniega, expira o responde sin autorización",{"_2937":60653,"_26000":60634,"_18071":102305,"_5":17966,"_24599":102256,"_2447":102306},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2937":60654,"_26000":60634,"_18071":102308,"_5":17966,"_24599":102256,"_2447":45846},[],{"_2937":60655,"_26000":60634,"_18071":102310,"_5":17966,"_24599":102256,"_2447":102311},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2937":60656,"_26000":60634,"_18071":102313,"_5":17966,"_24599":102256,"_2447":45852},[],{"_2937":60657,"_26000":60634,"_18071":102315,"_5":17966,"_24599":102256,"_2447":102316},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2937":60658,"_26000":60634,"_18071":102318,"_5":17966,"_24599":102256,"_2447":45858},[],{"_2937":60659,"_26000":60634,"_18071":102320,"_5":17966,"_24599":102256,"_2447":102321},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2937":60660,"_26000":60634,"_18071":102323,"_5":17966,"_24599":102256,"_2447":102324},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2937":60661,"_26000":60634,"_18071":102326,"_5":17966,"_24599":102256,"_2447":102327},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2937":60662,"_26000":60634,"_18071":102329,"_5":17966,"_24599":102256,"_2447":102330},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2937":60663,"_26000":60634,"_18071":102332,"_5":17966,"_24599":102256,"_2447":102333},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2937":60664,"_26000":60634,"_18071":102335,"_5":17966,"_24599":102256,"_2447":45876},[],{"_2937":60665,"_26000":60634,"_18071":102337,"_5":17966,"_24599":102256,"_2447":102338},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2937":60666,"_26000":60634,"_18071":102340,"_5":17966,"_24599":102256,"_2447":45882},[],{"_2937":60667,"_26000":60634,"_18071":102342,"_5":17966,"_24599":102256,"_2447":102343},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2937":60668,"_26000":60634,"_18071":102345,"_5":17966,"_24599":102256,"_2447":102346},[],"DMS propietario distinto",{"_2937":60669,"_26000":60634,"_18071":102348,"_5":17966,"_24599":102256,"_2447":102349},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2937":60670,"_26000":60634,"_18071":102351,"_5":17966,"_24599":102256,"_2447":45894},[],{"_2937":60671,"_26000":60634,"_18071":102353,"_5":17966,"_24599":102256,"_2447":102354},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2937":60672,"_26000":60634,"_18071":102356,"_5":17966,"_24599":102256,"_2447":45900},[],{"_2937":60673,"_26000":60634,"_18071":102358,"_5":17966,"_24599":102256,"_2447":102359},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2937":60674,"_26000":60634,"_18071":102361,"_5":17966,"_24599":102256,"_2447":102362},[],"Certificado actual revocado",{"_2937":60675,"_26000":60634,"_18071":102364,"_5":17966,"_24599":102256,"_2447":102365},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2937":60676,"_26000":60634,"_18071":102367,"_5":17966,"_24599":102256,"_2447":102368},[],"Error de CA, perfil o firma",{"_2937":60677,"_26000":60634,"_18071":102370,"_5":17966,"_24599":102256,"_2447":102371},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2937":60678,"_26000":60634,"_18071":102373,"_5":17966,"_24599":102256,"_2447":102374},[],"HTTP 200 sin conexión del dispositivo",{"_2937":60679,"_26000":60634,"_18071":102376,"_5":17966,"_24599":102256,"_2447":102377},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2937":60680,"_26000":60634,"_18071":102379,"_5":17966,"_24599":102256,"_2447":102380},[],"Timeout o error después de emitir",{"_2937":60681,"_26000":60634,"_18071":102382,"_5":17966,"_24599":102256,"_2447":102383},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2937":60682,"_26000":60634,"_18071":102385,"_5":17966,"_24599":102260,"_2447":102386},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2937":60683,"_26000":60634,"_18071":102388,"_5":17966,"_24599":102260,"_2447":102389},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2937":60684,"_26000":60634,"_18071":102391,"_5":17966,"_24599":102263,"_2447":102392},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2937":60685,"_26000":60634,"_18071":102394,"_5":17966,"_24599":102263,"_2447":102395},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2937":60686,"_26000":60634,"_18071":102397,"_5":17966,"_24599":102263,"_2447":102398},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2937":60687,"_26000":60634,"_18071":102400,"_5":17966,"_24599":102263,"_2447":102401},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2937":60688,"_26000":60634,"_18071":102403,"_5":17966,"_24599":102263,"_2447":102404},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2937":60689,"_26000":60634,"_18071":102406,"_5":17966,"_24599":102263,"_2447":102407},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2937":60690,"_26000":60634,"_18071":102409,"_5":17966,"_24599":102263,"_2447":102410},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2937":60691,"_26000":60691,"_5":12545,"_2447":102412,"_26339":102413,"_18071":102414,"_24599":60691},"Distribución y actualización de confianza",[42089,100145,44610,101117,101292],[],{"_2937":60692,"_26000":60691,"_18071":102416,"_5":17966,"_24599":60691,"_2447":102417},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2937":60693,"_26000":60691,"_5":26336,"_18071":102419,"_24599":102420,"_2447":102421},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2937":60694,"_26000":60691,"_5":26336,"_18071":102423,"_24599":102424,"_2447":102425},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2937":60695,"_26000":60691,"_5":26336,"_18071":102427,"_24599":102428,"_2447":102429},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2937":60696,"_26000":60691,"_5":26336,"_18071":102431,"_24599":102432,"_2447":102433},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2937":60697,"_26000":60691,"_5":26336,"_18071":102435,"_24599":102436,"_2447":102437},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2937":60698,"_26000":60691,"_18071":102439,"_5":17966,"_24599":60691,"_2447":102440},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2937":60699,"_26000":60691,"_18071":102442,"_5":17966,"_24599":102420,"_2447":102443},[],"Relación",{"_2937":60700,"_26000":60691,"_18071":102445,"_5":17966,"_24599":102420,"_2447":102446},[],"Material que prepara el responsable",{"_2937":60701,"_26000":60691,"_18071":102448,"_5":17966,"_24599":102420,"_2447":102449},[],"Dispositivo → servidor EST",{"_2937":60702,"_26000":60691,"_18071":102451,"_5":17966,"_24599":102420,"_2447":102452},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2937":60703,"_26000":60691,"_18071":102454,"_5":17966,"_24599":102420,"_2447":102455},[],"DMS → solicitante",{"_2937":60704,"_26000":60691,"_18071":102457,"_5":17966,"_24599":102420,"_2447":102458},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2937":60705,"_26000":60691,"_18071":102460,"_5":17966,"_24599":102420,"_2447":102461},[],"Consumidor → dispositivo",{"_2937":60706,"_26000":60691,"_18071":102463,"_5":17966,"_24599":102420,"_2447":102464},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2937":60707,"_26000":60691,"_18071":102466,"_5":17966,"_24599":102420,"_2447":102467},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2937":60708,"_26000":60691,"_18071":102469,"_5":17966,"_24599":102424,"_2447":102470},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2937":60709,"_26000":60691,"_18071":102472,"_5":17966,"_24599":102424,"_2447":102473},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2937":60710,"_26000":60691,"_18071":102475,"_5":17966,"_24599":102428,"_2447":102476},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2937":60711,"_26000":60691,"_18071":102478,"_5":17966,"_24599":102428,"_2447":102479},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2937":60712,"_26000":60691,"_18071":102481,"_5":17966,"_24599":102428,"_2447":102482},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2937":60713,"_26000":60691,"_18071":102484,"_5":17966,"_24599":102428,"_2447":102485},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2937":60714,"_26000":60691,"_18071":102487,"_5":17966,"_24599":102428,"_2447":102488},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2937":60715,"_26000":60691,"_18071":102490,"_5":17966,"_24599":102428,"_2447":102491},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2937":60716,"_26000":60691,"_18071":102493,"_5":17966,"_24599":102432,"_2447":102494},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2937":60717,"_26000":60691,"_18071":102496,"_5":17966,"_24599":102432,"_2447":102497},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2937":60718,"_26000":60691,"_18071":102499,"_5":17966,"_24599":102432,"_2447":102500},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2937":60719,"_26000":60691,"_18071":102502,"_5":17966,"_24599":102436,"_2447":102503},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2937":60720,"_26000":60720,"_5":12545,"_2447":46049,"_26339":102505,"_18071":102507,"_24599":60720},[42089,100145,44610,101117,102506],"Integraciones",[],{"_2937":60721,"_26000":60720,"_18071":102509,"_5":17966,"_24599":60720,"_2447":102510},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2937":60722,"_26000":60720,"_5":26336,"_18071":102512,"_24599":102513,"_2447":102514},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2937":60723,"_26000":60720,"_5":26336,"_18071":102516,"_24599":102517,"_2447":102518},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2937":60724,"_26000":60720,"_5":26336,"_18071":102520,"_24599":102521,"_2447":102522},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2937":60725,"_26000":60720,"_5":26336,"_18071":102524,"_24599":102525,"_2447":102526},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2937":60726,"_26000":60720,"_5":26336,"_18071":102528,"_24599":102529,"_2447":102530},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2937":60727,"_26000":60720,"_5":26336,"_18071":102532,"_24599":102533,"_2447":102534},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2937":60728,"_26000":60720,"_5":26336,"_18071":102536,"_24599":102537,"_2447":46083},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2937":60729,"_26000":60720,"_5":26336,"_18071":102539,"_24599":102540,"_2447":46087},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2937":60730,"_26000":60720,"_5":26336,"_18071":102542,"_24599":102543,"_2447":102544},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2937":60731,"_26000":60720,"_5":26336,"_18071":102546,"_24599":102547,"_2447":102548},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2937":60732,"_26000":60720,"_5":26336,"_18071":102550,"_24599":102551,"_2447":102552},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2937":60733,"_26000":60720,"_5":26336,"_18071":102554,"_24599":102555,"_2447":102556},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2937":60734,"_26000":60720,"_5":26336,"_18071":102558,"_24599":102559,"_2447":102560},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2937":60735,"_26000":60720,"_5":26336,"_18071":102562,"_24599":102563,"_2447":102564},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2937":60736,"_26000":60720,"_5":26336,"_18071":102566,"_24599":102567,"_2447":102568},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2937":60737,"_26000":60720,"_5":26336,"_18071":102570,"_24599":102571,"_2447":102572},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2937":60738,"_26000":60720,"_5":26336,"_18071":102574,"_24599":102575,"_2447":102576},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2937":60739,"_26000":60720,"_5":26336,"_18071":102578,"_24599":102579,"_2447":102580},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2937":60740,"_26000":60720,"_5":26336,"_18071":102582,"_24599":102583,"_2447":102584},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2937":60741,"_26000":60720,"_5":26336,"_18071":102586,"_24599":102587,"_2447":102588},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2937":60742,"_26000":60720,"_18071":102590,"_5":17966,"_24599":60720,"_2447":102591},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2937":60743,"_26000":60720,"_18071":102593,"_5":17966,"_24599":60720,"_2447":102594},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2937":60744,"_26000":60720,"_18071":102596,"_5":17966,"_24599":60720,"_2447":102597},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2937":60745,"_26000":60720,"_18071":102599,"_5":17966,"_24599":102513,"_2447":102600},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2937":60746,"_26000":60720,"_18071":102602,"_5":17966,"_24599":102513,"_2447":102603},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2937":60747,"_26000":60720,"_18071":102605,"_5":17966,"_24599":102513,"_2447":102606},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2937":60748,"_26000":60720,"_18071":102608,"_5":17966,"_24599":102513,"_2447":102609},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2937":60749,"_26000":60720,"_18071":102611,"_5":17966,"_24599":102517,"_2447":102612},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2937":60750,"_26000":60720,"_18071":102614,"_5":17966,"_24599":102521,"_2447":102615},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2937":60751,"_26000":60720,"_18071":102617,"_5":17966,"_24599":102521,"_2447":102618},[],"Acción IAM",{"_2937":60752,"_26000":60720,"_18071":102620,"_5":17966,"_24599":102521,"_2447":99010},[],{"_2937":60753,"_26000":60720,"_18071":102622,"_5":17966,"_24599":102521,"_2447":46169},[],{"_2937":60754,"_26000":60720,"_18071":102624,"_5":17966,"_24599":102521,"_2447":102625},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2937":60755,"_26000":60720,"_18071":102627,"_5":17966,"_24599":102521,"_2447":46175},[],{"_2937":60756,"_26000":60720,"_18071":102629,"_5":17966,"_24599":102521,"_2447":102630},[],"Registrar la CA en AWS IoT",{"_2937":60757,"_26000":60720,"_18071":102632,"_5":17966,"_24599":102521,"_2447":46181},[],{"_2937":60758,"_26000":60720,"_18071":102634,"_5":17966,"_24599":102521,"_2447":102635},[],"Consultar el estado del registro de la CA",{"_2937":60759,"_26000":60720,"_18071":102637,"_5":17966,"_24599":102521,"_2447":46187},[],{"_2937":60760,"_26000":60720,"_18071":102639,"_5":17966,"_24599":102521,"_2447":102640},[],"Crear o actualizar Things en IoT Core",{"_2937":60761,"_26000":60720,"_18071":102642,"_5":17966,"_24599":102521,"_2447":46193},[],{"_2937":60762,"_26000":60720,"_18071":102644,"_5":17966,"_24599":102521,"_2447":102645},[],"Aprovisionar Things mediante plantilla",{"_2937":60763,"_26000":60720,"_18071":102647,"_5":17966,"_24599":102521,"_2447":46199},[],{"_2937":60764,"_26000":60720,"_18071":102649,"_5":17966,"_24599":102521,"_2447":102650},[],"Registrar certificados de dispositivo",{"_2937":60765,"_26000":60720,"_18071":102652,"_5":17966,"_24599":102521,"_2447":46205},[],{"_2937":60766,"_26000":60720,"_18071":102654,"_5":17966,"_24599":102521,"_2447":102655},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2937":60767,"_26000":60720,"_18071":102657,"_5":17966,"_24599":102521,"_2447":46211},[],{"_2937":60768,"_26000":60720,"_18071":102659,"_5":17966,"_24599":102521,"_2447":102660},[],"Crear y adjuntar políticas IoT",{"_2937":60769,"_26000":60720,"_18071":102662,"_5":17966,"_24599":102521,"_2447":46217},[],{"_2937":60770,"_26000":60720,"_18071":102664,"_5":17966,"_24599":102521,"_2447":102665},[],"Gestionar grupos de Things",{"_2937":60771,"_26000":60720,"_18071":102667,"_5":17966,"_24599":102521,"_2447":46223},[],{"_2937":60772,"_26000":60720,"_18071":102669,"_5":17966,"_24599":102521,"_2447":102670},[],"Crear plantillas JITP",{"_2937":60773,"_26000":60720,"_18071":102672,"_5":17966,"_24599":102521,"_2447":46229},[],{"_2937":60774,"_26000":60720,"_18071":102674,"_5":17966,"_24599":102521,"_2447":102675},[],"Leer y escribir el Device Shadow",{"_2937":60775,"_26000":60720,"_18071":102677,"_5":17966,"_24599":102521,"_2447":102678},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2937":60776,"_26000":60720,"_18071":102680,"_5":17966,"_24599":102525,"_2447":102681},[],"Parámetro",{"_2937":60777,"_26000":60720,"_18071":102683,"_5":17966,"_24599":102525,"_2447":102684},[],"Tipo",{"_2937":60778,"_26000":60720,"_18071":102686,"_5":17966,"_24599":102525,"_2447":102687},[],"Requerido",{"_2937":60779,"_26000":60720,"_18071":102689,"_5":17966,"_24599":102525,"_2447":102690},[],"Descripción",{"_2937":60780,"_26000":60720,"_18071":102692,"_5":17966,"_24599":102525,"_2447":46250},[],{"_2937":60781,"_26000":60720,"_18071":102694,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60782,"_26000":60720,"_18071":102696,"_5":17966,"_24599":102525,"_2447":102697},[],"Sí",{"_2937":60783,"_26000":60720,"_18071":102699,"_5":17966,"_24599":102525,"_2447":102700},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2937":60784,"_26000":60720,"_18071":102702,"_5":17966,"_24599":102525,"_2447":46261},[],{"_2937":60785,"_26000":60720,"_18071":102704,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60786,"_26000":60720,"_18071":102706,"_5":17966,"_24599":102525,"_2447":102697},[],{"_2937":60787,"_26000":60720,"_18071":102708,"_5":17966,"_24599":102525,"_2447":102709},[],"Región AWS donde opera el conector.",{"_2937":60788,"_26000":60720,"_18071":102711,"_5":17966,"_24599":102525,"_2447":46271},[],{"_2937":60789,"_26000":60720,"_18071":102713,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60790,"_26000":60720,"_18071":102715,"_5":17966,"_24599":102525,"_2447":102697},[],{"_2937":60791,"_26000":60720,"_18071":102717,"_5":17966,"_24599":102525,"_2447":102718},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2937":60792,"_26000":60720,"_18071":102720,"_5":17966,"_24599":102525,"_2447":46281},[],{"_2937":60793,"_26000":60720,"_18071":102722,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60794,"_26000":60720,"_18071":102724,"_5":17966,"_24599":102525,"_2447":102725},[],"Solo con `auth_method=static`",{"_2937":60795,"_26000":60720,"_18071":102727,"_5":17966,"_24599":102525,"_2447":102728},[],"Clave de acceso AWS.",{"_2937":60796,"_26000":60720,"_18071":102730,"_5":17966,"_24599":102525,"_2447":46292},[],{"_2937":60797,"_26000":60720,"_18071":102732,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60798,"_26000":60720,"_18071":102734,"_5":17966,"_24599":102525,"_2447":102725},[],{"_2937":60799,"_26000":60720,"_18071":102736,"_5":17966,"_24599":102525,"_2447":102737},[],"Clave secreta AWS.",{"_2937":60800,"_26000":60720,"_18071":102739,"_5":17966,"_24599":102525,"_2447":46302},[],{"_2937":60801,"_26000":60720,"_18071":102741,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60802,"_26000":60720,"_18071":102743,"_5":17966,"_24599":102525,"_2447":46307},[],{"_2937":60803,"_26000":60720,"_18071":102745,"_5":17966,"_24599":102525,"_2447":102746},[],"Token de sesión (con `auth_method=static`).",{"_2937":60804,"_26000":60720,"_18071":102748,"_5":17966,"_24599":102525,"_2447":46313},[],{"_2937":60805,"_26000":60720,"_18071":102750,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60806,"_26000":60720,"_18071":102752,"_5":17966,"_24599":102525,"_2447":102753},[],"Solo con `auth_method=role`",{"_2937":60807,"_26000":60720,"_18071":102755,"_5":17966,"_24599":102525,"_2447":102756},[],"ARN del rol a asumir.",{"_2937":60808,"_26000":60720,"_18071":102758,"_5":17966,"_24599":102525,"_2447":46324},[],{"_2937":60809,"_26000":60720,"_18071":102760,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60810,"_26000":60720,"_18071":102762,"_5":17966,"_24599":102525,"_2447":46307},[],{"_2937":60811,"_26000":60720,"_18071":102764,"_5":17966,"_24599":102525,"_2447":102765},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2937":60812,"_26000":60720,"_18071":102767,"_5":17966,"_24599":102525,"_2447":46334},[],{"_2937":60813,"_26000":60720,"_18071":102769,"_5":17966,"_24599":102525,"_2447":15210},[],{"_2937":60814,"_26000":60720,"_18071":102771,"_5":17966,"_24599":102525,"_2447":102697},[],{"_2937":60815,"_26000":60720,"_18071":102773,"_5":17966,"_24599":102525,"_2447":102774},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2937":60816,"_26000":60720,"_18071":102776,"_5":17966,"_24599":102525,"_2447":46344},[],{"_2937":60817,"_26000":60720,"_18071":102778,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60818,"_26000":60720,"_18071":102780,"_5":17966,"_24599":102525,"_2447":102697},[],{"_2937":60819,"_26000":60720,"_18071":102782,"_5":17966,"_24599":102525,"_2447":102783},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2937":60820,"_26000":60720,"_18071":102785,"_5":17966,"_24599":102525,"_2447":46354},[],{"_2937":60821,"_26000":60720,"_18071":102787,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60822,"_26000":60720,"_18071":102789,"_5":17966,"_24599":102525,"_2447":102697},[],{"_2937":60823,"_26000":60720,"_18071":102791,"_5":17966,"_24599":102525,"_2447":102792},[],"URL HTTP del Device Manager de Lamassu.",{"_2937":60824,"_26000":60720,"_18071":102794,"_5":17966,"_24599":102525,"_2447":46364},[],{"_2937":60825,"_26000":60720,"_18071":102796,"_5":17966,"_24599":102525,"_2447":21633},[],{"_2937":60826,"_26000":60720,"_18071":102798,"_5":17966,"_24599":102525,"_2447":102697},[],{"_2937":60827,"_26000":60720,"_18071":102800,"_5":17966,"_24599":102525,"_2447":102801},[],"URL HTTP del servicio de CA de Lamassu.",{"_2937":60828,"_26000":60720,"_18071":102803,"_5":17966,"_24599":102529,"_2447":102804},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2937":60829,"_26000":60720,"_18071":102806,"_5":17966,"_24599":102533,"_2447":102807},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2937":60830,"_26000":60720,"_18071":102809,"_5":17966,"_24599":102533,"_2447":102810},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2937":60831,"_26000":60720,"_18071":102812,"_5":17966,"_24599":102537,"_2447":102813},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2937":60832,"_26000":60720,"_18071":102815,"_5":17966,"_24599":102537,"_2447":102816},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2937":60833,"_26000":60720,"_18071":102818,"_5":17966,"_24599":102537,"_2447":102819},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2937":60834,"_26000":60720,"_18071":102821,"_5":17966,"_24599":102537,"_2447":102822},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2937":60835,"_26000":60720,"_18071":102824,"_5":17966,"_24599":102537,"_2447":102825},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2937":60836,"_26000":60720,"_18071":102827,"_5":17966,"_24599":102537,"_2447":102828},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2937":60837,"_26000":60720,"_18071":102830,"_5":17966,"_24599":102540,"_2447":102831},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2937":60838,"_26000":60720,"_18071":102833,"_5":17966,"_24599":102543,"_2447":102834},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2937":60839,"_26000":60720,"_18071":102836,"_5":17966,"_24599":102543,"_2447":102837},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2937":60840,"_26000":60720,"_18071":102839,"_5":17966,"_24599":102547,"_2447":102840},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2937":60841,"_26000":60720,"_18071":102842,"_5":17966,"_24599":102551,"_2447":102843},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2937":60842,"_26000":60720,"_18071":102845,"_5":17966,"_24599":102551,"_2447":102846},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2937":60843,"_26000":60720,"_18071":102848,"_5":17966,"_24599":102551,"_2447":102849},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2937":60844,"_26000":60720,"_18071":102851,"_5":17966,"_24599":102551,"_2447":102852},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2937":60845,"_26000":60720,"_18071":102854,"_5":17966,"_24599":102551,"_2447":102855},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2937":60846,"_26000":60720,"_18071":102857,"_5":17966,"_24599":102551,"_2447":102858},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2937":60847,"_26000":60720,"_18071":102860,"_5":17966,"_24599":102555,"_2447":102861},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2937":60848,"_26000":60720,"_18071":102863,"_5":17966,"_24599":102555,"_2447":102864},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2937":60849,"_26000":60720,"_18071":102866,"_5":17966,"_24599":102555,"_2447":102867},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2937":60850,"_26000":60720,"_18071":102869,"_5":17966,"_24599":102559,"_2447":102870},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2937":60851,"_26000":60720,"_18071":102872,"_5":17966,"_24599":102559,"_2447":102873},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2937":60852,"_26000":60720,"_18071":102875,"_5":17966,"_24599":102559,"_2447":102876},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2937":60853,"_26000":60720,"_18071":102878,"_5":17966,"_24599":102563,"_2447":102879},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2937":60854,"_26000":60720,"_18071":102881,"_5":17966,"_24599":102563,"_2447":102882},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2937":60855,"_26000":60720,"_18071":102884,"_5":17966,"_24599":102563,"_2447":102885},[],"Para que el flujo JITP funcione correctamente:",{"_2937":60856,"_26000":60720,"_18071":102887,"_5":17966,"_24599":102563,"_2447":102888},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2937":60857,"_26000":60720,"_18071":102890,"_5":17966,"_24599":102563,"_2447":102891},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2937":60858,"_26000":60720,"_18071":102893,"_5":17966,"_24599":102563,"_2447":102894},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2937":60859,"_26000":60720,"_18071":102896,"_5":17966,"_24599":102563,"_2447":102897},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2937":60860,"_26000":60720,"_18071":102899,"_5":17966,"_24599":102567,"_2447":102900},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2937":60861,"_26000":60720,"_18071":102902,"_5":17966,"_24599":102567,"_2447":102903},[],"Estado en Lamassu",{"_2937":60862,"_26000":60720,"_18071":102905,"_5":17966,"_24599":102567,"_2447":102906},[],"Razón de revocación",{"_2937":60863,"_26000":60720,"_18071":102908,"_5":17966,"_24599":102567,"_2447":102909},[],"Estado en AWS IoT Core",{"_2937":60864,"_26000":60720,"_18071":102911,"_5":17966,"_24599":102567,"_2447":46485},[],{"_2937":60865,"_26000":60720,"_18071":102913,"_5":17966,"_24599":102567,"_2447":102914},[],"Ninguna",{"_2937":60866,"_26000":60720,"_18071":102916,"_5":17966,"_24599":102567,"_2447":46491},[],{"_2937":60867,"_26000":60720,"_18071":102918,"_5":17966,"_24599":102567,"_2447":46494},[],{"_2937":60868,"_26000":60720,"_18071":102920,"_5":17966,"_24599":102567,"_2447":46497},[],{"_2937":60869,"_26000":60720,"_18071":102922,"_5":17966,"_24599":102567,"_2447":46500},[],{"_2937":60870,"_26000":60720,"_18071":102924,"_5":17966,"_24599":102567,"_2447":46494},[],{"_2937":60871,"_26000":60720,"_18071":102926,"_5":17966,"_24599":102567,"_2447":102927},[],"Cualquier otra razón",{"_2937":60872,"_26000":60720,"_18071":102929,"_5":17966,"_24599":102567,"_2447":46508},[],{"_2937":60873,"_26000":60720,"_18071":102931,"_5":17966,"_24599":102567,"_2447":102932},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2937":60874,"_26000":60720,"_18071":102934,"_5":17966,"_24599":102571,"_2447":102935},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2937":60875,"_26000":60720,"_18071":102937,"_5":17966,"_24599":102571,"_2447":102938},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2937":60876,"_26000":60720,"_18071":102940,"_5":17966,"_24599":102571,"_2447":102941},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2937":60877,"_26000":60720,"_18071":102943,"_5":17966,"_24599":102575,"_2447":102944},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2937":60878,"_26000":60720,"_18071":102946,"_5":17966,"_24599":102575,"_2447":102947},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2937":60879,"_26000":60720,"_18071":102949,"_5":17966,"_24599":102579,"_2447":102950},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2937":60880,"_26000":60720,"_18071":102952,"_5":17966,"_24599":102579,"_2447":102953},[],"Existen dos tipos de acciones:",{"_2937":60881,"_26000":60720,"_18071":102955,"_5":17966,"_24599":102579,"_2447":102956},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2937":60882,"_26000":60720,"_18071":102958,"_5":17966,"_24599":102579,"_2447":102959},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2937":60883,"_26000":60720,"_18071":102961,"_5":17966,"_24599":102579,"_2447":102962},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2937":60884,"_26000":60720,"_18071":102964,"_5":17966,"_24599":102583,"_2447":102965},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2937":60885,"_26000":60720,"_18071":102967,"_5":17966,"_24599":102583,"_2447":102968},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2937":60886,"_26000":60720,"_18071":102970,"_5":17966,"_24599":102583,"_2447":102971},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2937":60887,"_26000":60720,"_18071":102973,"_5":17966,"_24599":102587,"_2447":102974},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2937":60888,"_26000":60720,"_18071":102976,"_5":17966,"_24599":102587,"_2447":102977},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2937":60889,"_26000":60720,"_18071":102979,"_5":17966,"_24599":102587,"_2447":102980},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2937":60890,"_26000":60720,"_18071":102982,"_5":17966,"_24599":102587,"_2447":102983},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2937":60891,"_26000":60720,"_18071":102985,"_5":17966,"_24599":102587,"_2447":102986},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2937":60892,"_26000":60720,"_18071":102988,"_5":17966,"_24599":102587,"_2447":102989},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2937":60893,"_26000":60720,"_18071":102991,"_5":17966,"_24599":102587,"_2447":102992},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2937":60894,"_26000":60720,"_18071":102994,"_5":17966,"_24599":102587,"_2447":102995},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2937":60895,"_26000":60720,"_18071":102997,"_5":17966,"_24599":102587,"_2447":102998},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2937":60896,"_26000":60720,"_18071":103000,"_5":17966,"_24599":102587,"_2447":103001},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2937":60897,"_26000":60720,"_18071":103003,"_5":17966,"_24599":102587,"_2447":103004},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2937":60898,"_26000":60720,"_18071":103006,"_5":17966,"_24599":102587,"_2447":103007},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2937":60899,"_26000":60720,"_18071":103009,"_5":17966,"_24599":102587,"_2447":103010},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2937":60900,"_26000":60720,"_18071":103012,"_5":17966,"_24599":102587,"_2447":103013},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2937":60901,"_26000":60720,"_18071":103015,"_5":17966,"_24599":102587,"_2447":103016},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2937":60902,"_26000":60720,"_18071":103018,"_5":17966,"_24599":102587,"_2447":103019},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2937":60903,"_26000":60720,"_18071":103021,"_5":17966,"_24599":102587,"_2447":103022},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2937":60904,"_26000":60720,"_18071":103024,"_5":17966,"_24599":102587,"_2447":103025},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2937":60905,"_26000":60720,"_18071":103027,"_5":17966,"_24599":102587,"_2447":103028},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2937":60906,"_26000":60720,"_18071":103030,"_5":17966,"_24599":102587,"_2447":103031},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2937":60907,"_26000":60720,"_18071":103033,"_5":17966,"_24599":102587,"_2447":103034},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2937":60908,"_26000":60908,"_5":12545,"_2447":44610,"_26339":103036,"_18071":103037,"_24599":60908},[42089,100145,44610],[],{"_2937":60909,"_26000":60908,"_18071":103039,"_5":17966,"_24599":60908,"_2447":103040},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2937":60910,"_26000":60908,"_5":26336,"_18071":103042,"_24599":103043,"_2447":103044},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2937":60911,"_26000":60908,"_5":26336,"_18071":103046,"_24599":103047,"_2447":101117},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2937":60912,"_26000":60908,"_5":26336,"_18071":103049,"_24599":103050,"_2447":101292},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2937":60913,"_26000":60908,"_5":26336,"_18071":103052,"_24599":103053,"_2447":102506},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#integraciones",{"_2937":60914,"_26000":60908,"_5":26336,"_18071":103055,"_24599":103056,"_2447":103057},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2937":60915,"_26000":60908,"_18071":103059,"_5":17966,"_24599":60908,"_2447":103060},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2937":60916,"_26000":60908,"_18071":103062,"_5":17966,"_24599":103043,"_2447":103063},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2937":60917,"_26000":60908,"_18071":103065,"_5":17966,"_24599":103043,"_2447":103066},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2937":60918,"_26000":60908,"_18071":103068,"_5":17966,"_24599":103047,"_2447":103069},[],"Recurso",{"_2937":60919,"_26000":60908,"_18071":103071,"_5":17966,"_24599":103047,"_2447":103072},[],"Qué representa",{"_2937":60920,"_26000":60908,"_18071":103074,"_5":17966,"_24599":103047,"_2447":103075},[],"**Dispositivo**",{"_2937":60921,"_26000":60908,"_18071":103077,"_5":17966,"_24599":103047,"_2447":103078},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2937":60922,"_26000":60908,"_18071":103080,"_5":17966,"_24599":103047,"_2447":103081},[],"**Identidad**",{"_2937":60923,"_26000":60908,"_18071":103083,"_5":17966,"_24599":103047,"_2447":103084},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2937":60924,"_26000":60908,"_18071":103086,"_5":17966,"_24599":103047,"_2447":46666},[],{"_2937":60925,"_26000":60908,"_18071":103088,"_5":17966,"_24599":103047,"_2447":103089},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2937":60926,"_26000":60908,"_18071":103091,"_5":17966,"_24599":103047,"_2447":103092},[],"**Flota**",{"_2937":60927,"_26000":60908,"_18071":103094,"_5":17966,"_24599":103047,"_2447":103095},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2937":60928,"_26000":60908,"_18071":103097,"_5":17966,"_24599":103047,"_2447":103098},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2937":60929,"_26000":60908,"_18071":103100,"_5":17966,"_24599":103047,"_2447":103101},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2937":60930,"_26000":60908,"_18071":103103,"_5":17966,"_24599":103050,"_2447":103104},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2937":60931,"_26000":60908,"_18071":103106,"_5":17966,"_24599":103050,"_2447":103107},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2937":60932,"_26000":60908,"_18071":103109,"_5":17966,"_24599":103050,"_2447":103110},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2937":60933,"_26000":60908,"_18071":103112,"_5":17966,"_24599":103050,"_2447":103113},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2937":60934,"_26000":60908,"_18071":103115,"_5":17966,"_24599":103050,"_2447":103116},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2937":60935,"_26000":60908,"_18071":103118,"_5":17966,"_24599":103050,"_2447":103119},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2937":60936,"_26000":60908,"_18071":103121,"_5":17966,"_24599":103050,"_2447":103122},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2937":60937,"_26000":60908,"_18071":103124,"_5":17966,"_24599":103050,"_2447":103125},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2937":60938,"_26000":60908,"_18071":103127,"_5":17966,"_24599":103053,"_2447":103128},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2937":60939,"_26000":60908,"_18071":103130,"_5":17966,"_24599":103053,"_2447":103131},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2937":60940,"_26000":60908,"_18071":103133,"_5":17966,"_24599":103056,"_2447":103134},[],"Participante",{"_2937":60941,"_26000":60908,"_18071":103136,"_5":17966,"_24599":103056,"_2447":103137},[],"Responsabilidad",{"_2937":60942,"_26000":60908,"_18071":103139,"_5":17966,"_24599":103056,"_2447":103140},[],"Administrador PKI",{"_2937":60943,"_26000":60908,"_18071":103142,"_5":17966,"_24599":103056,"_2447":103143},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2937":60944,"_26000":60908,"_18071":103145,"_5":17966,"_24599":103056,"_2447":103146},[],"Administrador del aprovisionamiento",{"_2937":60945,"_26000":60908,"_18071":103148,"_5":17966,"_24599":103056,"_2447":103149},[],"DMS, admisión, autenticación por operación e inventario.",{"_2937":60946,"_26000":60908,"_18071":103151,"_5":17966,"_24599":103056,"_2447":103152},[],"Integrador del dispositivo",{"_2937":60947,"_26000":60908,"_18071":103154,"_5":17966,"_24599":103056,"_2447":103155},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2937":60948,"_26000":60908,"_18071":103157,"_5":17966,"_24599":103056,"_2447":103158},[],"Integrador del consumidor",{"_2937":60949,"_26000":60908,"_18071":103160,"_5":17966,"_24599":103056,"_2447":103161},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2937":60950,"_26000":60908,"_18071":103163,"_5":17966,"_24599":103056,"_2447":103164},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2937":60951,"_26000":60951,"_5":12545,"_2447":103166,"_26339":103167,"_18071":103169,"_24599":60951},"Enrola y conecta tu primer dispositivo",[42089,100145,44610,103168],"Primeros pasos",[],{"_2937":60952,"_26000":60951,"_18071":103171,"_5":17966,"_24599":60951,"_2447":103172},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2937":60953,"_26000":60951,"_5":26336,"_18071":103174,"_24599":103175,"_2447":98644},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2937":60954,"_26000":60951,"_5":26336,"_18071":103177,"_24599":103178,"_2447":103179},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2937":60955,"_26000":60951,"_5":26336,"_18071":103181,"_24599":103182,"_2447":103183},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2937":60956,"_26000":60951,"_5":26336,"_18071":103185,"_24599":103186,"_2447":103187},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2937":60957,"_26000":60951,"_5":26336,"_18071":103189,"_24599":103190,"_2447":103191},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2937":60958,"_26000":60951,"_5":26336,"_18071":103193,"_24599":103194,"_2447":103195},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2937":60959,"_26000":60951,"_5":26336,"_18071":103197,"_24599":103198,"_2447":103199},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2937":60960,"_26000":60951,"_5":26336,"_18071":103201,"_24599":103202,"_2447":103203},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2937":60961,"_26000":60951,"_18071":103205,"_5":17966,"_24599":60951,"_2447":103206},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2937":60962,"_26000":60951,"_18071":103208,"_5":17966,"_24599":103175,"_2447":103209},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2937":60963,"_26000":60951,"_18071":103211,"_5":17966,"_24599":103175,"_2447":103212},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2937":60964,"_26000":60951,"_18071":103214,"_5":17966,"_24599":103175,"_2447":103215},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2937":60965,"_26000":60951,"_18071":103217,"_5":17966,"_24599":103175,"_2447":103218},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2937":60966,"_26000":60951,"_18071":103220,"_5":17966,"_24599":103175,"_2447":103221},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2937":60967,"_26000":60951,"_18071":103223,"_5":17966,"_24599":103178,"_2447":103224},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2937":60968,"_26000":60951,"_18071":103226,"_5":17966,"_24599":103178,"_2447":103227},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2937":60969,"_26000":60951,"_18071":103229,"_5":17966,"_24599":103182,"_2447":103230},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2937":60970,"_26000":60951,"_18071":103232,"_5":17966,"_24599":103182,"_2447":103233},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2937":60971,"_26000":60951,"_18071":103235,"_5":17966,"_24599":103182,"_2447":103236},[],"Ajuste",{"_2937":60972,"_26000":60951,"_18071":103238,"_5":17966,"_24599":103182,"_2447":103239},[],"Valor de evaluación",{"_2937":60973,"_26000":60951,"_18071":103241,"_5":17966,"_24599":103182,"_2447":46822},[],{"_2937":60974,"_26000":60951,"_18071":103243,"_5":17966,"_24599":103182,"_2447":103244},[],"Raíz emisora de `device-root.pem`.",{"_2937":60975,"_26000":60951,"_18071":103246,"_5":17966,"_24599":103182,"_2447":101420},[],{"_2937":60976,"_26000":60951,"_18071":103248,"_5":17966,"_24599":103182,"_2447":103249},[],"Perfil final de 1 hora que acabas de preparar.",{"_2937":60977,"_26000":60951,"_18071":103251,"_5":17966,"_24599":103182,"_2447":46833},[],{"_2937":60978,"_26000":60951,"_18071":103253,"_5":17966,"_24599":103182,"_2447":46836},[],{"_2937":60979,"_26000":60951,"_18071":103255,"_5":17966,"_24599":103182,"_2447":46839},[],{"_2937":60980,"_26000":60951,"_18071":103257,"_5":17966,"_24599":103182,"_2447":103258},[],"Habilitado.",{"_2937":60981,"_26000":60951,"_18071":103260,"_5":17966,"_24599":103182,"_2447":46845},[],{"_2937":60982,"_26000":60951,"_18071":103262,"_5":17966,"_24599":103182,"_2447":103263},[],"Deshabilitado; el ID debe ser nuevo.",{"_2937":60983,"_26000":60951,"_18071":103265,"_5":17966,"_24599":103182,"_2447":103266},[],"Autenticación inicial",{"_2937":60984,"_26000":60951,"_18071":103268,"_5":17966,"_24599":103182,"_2447":103269},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2937":60985,"_26000":60951,"_18071":103271,"_5":17966,"_24599":103182,"_2447":103272},[],"Autenticación de renovación",{"_2937":60986,"_26000":60951,"_18071":103274,"_5":17966,"_24599":103182,"_2447":103275},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2937":60987,"_26000":60951,"_18071":103277,"_5":17966,"_24599":103182,"_2447":46863},[],{"_2937":60988,"_26000":60951,"_18071":103279,"_5":17966,"_24599":103182,"_2447":103280},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2937":60989,"_26000":60951,"_18071":103282,"_5":17966,"_24599":103182,"_2447":46869},[],{"_2937":60990,"_26000":60951,"_18071":103284,"_5":17966,"_24599":103182,"_2447":103285},[],"1 hora.",{"_2937":60991,"_26000":60951,"_18071":103287,"_5":17966,"_24599":103182,"_2447":46875},[],{"_2937":60992,"_26000":60951,"_18071":103289,"_5":17966,"_24599":103182,"_2447":103290},[],"30 minutos / 10 minutos.",{"_2937":60993,"_26000":60951,"_18071":103292,"_5":17966,"_24599":103182,"_2447":46881},[],{"_2937":60994,"_26000":60951,"_18071":103294,"_5":17966,"_24599":103182,"_2447":103295},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2937":60995,"_26000":60951,"_18071":103297,"_5":17966,"_24599":103182,"_2447":44929},[],{"_2937":60996,"_26000":60951,"_18071":103299,"_5":17966,"_24599":103182,"_2447":103300},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2937":60997,"_26000":60951,"_18071":103302,"_5":17966,"_24599":103182,"_2447":46892},[],{"_2937":60998,"_26000":60951,"_18071":103304,"_5":17966,"_24599":103182,"_2447":103305},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2937":60999,"_26000":60951,"_18071":103307,"_5":17966,"_24599":103182,"_2447":103308},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2937":61000,"_26000":60951,"_18071":103310,"_5":17966,"_24599":103186,"_2447":103311},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2937":61001,"_26000":60951,"_18071":103313,"_5":17966,"_24599":103186,"_2447":103314},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2937":61002,"_26000":60951,"_18071":103316,"_5":17966,"_24599":103190,"_2447":103317},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2937":61003,"_26000":60951,"_18071":103319,"_5":17966,"_24599":103190,"_2447":103320},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2937":61004,"_26000":60951,"_18071":103322,"_5":17966,"_24599":103190,"_2447":103323},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2937":61005,"_26000":60951,"_18071":103325,"_5":17966,"_24599":103194,"_2447":103326},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2937":61006,"_26000":60951,"_18071":103328,"_5":17966,"_24599":103194,"_2447":103329},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2937":61007,"_26000":60951,"_18071":103331,"_5":17966,"_24599":103198,"_2447":103332},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2937":61008,"_26000":60951,"_18071":103334,"_5":17966,"_24599":103198,"_2447":103335},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2937":61009,"_26000":60951,"_18071":103337,"_5":17966,"_24599":103198,"_2447":103338},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2937":61010,"_26000":60951,"_18071":103340,"_5":17966,"_24599":103198,"_2447":103341},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2937":61011,"_26000":60951,"_18071":103343,"_5":17966,"_24599":103198,"_2447":103344},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2937":61012,"_26000":60951,"_18071":103346,"_5":17966,"_24599":103202,"_2447":103347},[],"Comprobación",{"_2937":61013,"_26000":60951,"_18071":103349,"_5":17966,"_24599":103202,"_2447":103350},[],"Resultado esperado",{"_2937":61014,"_26000":60951,"_18071":103352,"_5":17966,"_24599":103202,"_2447":103353},[],"Registro",{"_2937":61015,"_26000":60951,"_18071":103355,"_5":17966,"_24599":103202,"_2447":103356},[],"ID creado automáticamente y DMS correcto.",{"_2937":61016,"_26000":60951,"_18071":103358,"_5":17966,"_24599":103202,"_2447":103359},[],"Certificado",{"_2937":61017,"_26000":60951,"_18071":103361,"_5":17966,"_24599":103202,"_2447":103362},[],"CN, perfil, serie y clave verificados.",{"_2937":61018,"_26000":60951,"_18071":103364,"_5":17966,"_24599":103202,"_2447":103365},[],"Inventario",{"_2937":61019,"_26000":60951,"_18071":103367,"_5":17966,"_24599":103202,"_2447":103368},[],"Serie recibida visible como identidad actual y en el historial.",{"_2937":61020,"_26000":60951,"_18071":103370,"_5":17966,"_24599":103202,"_2447":103371},[],"Consumidor",{"_2937":61021,"_26000":60951,"_18071":103373,"_5":17966,"_24599":103202,"_2447":103374},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2937":61022,"_26000":60951,"_18071":103376,"_5":17966,"_24599":103202,"_2447":103377},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2937":61023,"_26000":60951,"_18071":103379,"_5":17966,"_24599":103202,"_2447":103380},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2937":61024,"_26000":61024,"_5":12545,"_2447":101134,"_26339":103382,"_18071":103383,"_24599":61024},[42089,100145,44610,103168],[],{"_2937":61025,"_26000":61024,"_18071":103385,"_5":17966,"_24599":61024,"_2447":103386},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2937":61026,"_26000":61024,"_5":26336,"_18071":103388,"_24599":103389,"_2447":98644},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2937":61027,"_26000":61024,"_5":26336,"_18071":103391,"_24599":103392,"_2447":103393},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2937":61028,"_26000":61024,"_5":26336,"_18071":103395,"_24599":103396,"_2447":103397},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2937":61029,"_26000":61024,"_5":26336,"_18071":103399,"_24599":103400,"_2447":103401},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2937":61030,"_26000":61024,"_5":26336,"_18071":103403,"_24599":103404,"_2447":103405},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2937":61031,"_26000":61024,"_5":26336,"_18071":103407,"_24599":103408,"_2447":103409},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2937":61032,"_26000":61024,"_5":26336,"_18071":103411,"_24599":103412,"_2447":103350},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2937":61033,"_26000":61024,"_5":26336,"_18071":103414,"_24599":103415,"_2447":103416},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2937":61034,"_26000":61024,"_5":26336,"_18071":103418,"_24599":103419,"_2447":103420},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2937":61035,"_26000":61024,"_18071":103422,"_5":17966,"_24599":61024,"_2447":103423},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2937":61036,"_26000":61024,"_18071":103425,"_5":17966,"_24599":61024,"_2447":103426},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2937":61037,"_26000":61024,"_18071":103428,"_5":17966,"_24599":103389,"_2447":103429},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2937":61038,"_26000":61024,"_18071":103431,"_5":17966,"_24599":103389,"_2447":103432},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2937":61039,"_26000":61024,"_18071":103434,"_5":17966,"_24599":103389,"_2447":103435},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2937":61040,"_26000":61024,"_18071":103437,"_5":17966,"_24599":103389,"_2447":103438},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2937":61041,"_26000":61024,"_18071":103440,"_5":17966,"_24599":103392,"_2447":103441},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2937":61042,"_26000":61024,"_18071":103443,"_5":17966,"_24599":103392,"_2447":103444},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2937":61043,"_26000":61024,"_18071":103446,"_5":17966,"_24599":103392,"_2447":103447},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2937":61044,"_26000":61024,"_18071":103449,"_5":17966,"_24599":103392,"_2447":103450},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2937":61045,"_26000":61024,"_18071":103452,"_5":17966,"_24599":103392,"_2447":103453},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2937":61046,"_26000":61024,"_18071":103455,"_5":17966,"_24599":103392,"_2447":103456},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2937":61047,"_26000":61024,"_18071":103458,"_5":17966,"_24599":103392,"_2447":103459},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2937":61048,"_26000":61024,"_18071":103461,"_5":17966,"_24599":103392,"_2447":103462},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2937":61049,"_26000":61024,"_18071":103464,"_5":17966,"_24599":103396,"_2447":103465},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2937":61050,"_26000":61024,"_18071":103467,"_5":17966,"_24599":103396,"_2447":47058},[],{"_2937":61051,"_26000":61024,"_18071":103469,"_5":17966,"_24599":103396,"_2447":103470},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2937":61052,"_26000":61024,"_18071":103472,"_5":17966,"_24599":103396,"_2447":103473},[],"**Icon** y **Tags**: clasificación opcional.",{"_2937":61053,"_26000":61024,"_18071":103475,"_5":17966,"_24599":103396,"_2447":103476},[],"Confirma el registro.",{"_2937":61054,"_26000":61024,"_18071":103478,"_5":17966,"_24599":103400,"_2447":103479},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2937":61055,"_26000":61024,"_18071":103481,"_5":17966,"_24599":103400,"_2447":103482},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2937":61056,"_26000":61024,"_18071":103484,"_5":17966,"_24599":103404,"_2447":103485},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2937":61057,"_26000":61024,"_18071":103487,"_5":17966,"_24599":103404,"_2447":103488},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2937":61058,"_26000":61024,"_18071":103490,"_5":17966,"_24599":103408,"_2447":103491},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2937":61059,"_26000":61024,"_18071":103493,"_5":17966,"_24599":103408,"_2447":103494},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2937":61060,"_26000":61024,"_18071":103496,"_5":17966,"_24599":103412,"_2447":103347},[],{"_2937":61061,"_26000":61024,"_18071":103498,"_5":17966,"_24599":103412,"_2447":103499},[],"Resultado",{"_2937":61062,"_26000":61024,"_18071":103501,"_5":17966,"_24599":103412,"_2447":103502},[],"Dispositivo",{"_2937":61063,"_26000":61024,"_18071":103504,"_5":17966,"_24599":103412,"_2447":103505},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2937":61064,"_26000":61024,"_18071":103507,"_5":17966,"_24599":103412,"_2447":103508},[],"Identidad actual",{"_2937":61065,"_26000":61024,"_18071":103510,"_5":17966,"_24599":103412,"_2447":103511},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2937":61066,"_26000":61024,"_18071":103513,"_5":17966,"_24599":103412,"_2447":103514},[],"Historial",{"_2937":61067,"_26000":61024,"_18071":103516,"_5":17966,"_24599":103412,"_2447":103517},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2937":61068,"_26000":61024,"_18071":103519,"_5":17966,"_24599":103412,"_2447":103520},[],"Clave y certificado",{"_2937":61069,"_26000":61024,"_18071":103522,"_5":17966,"_24599":103412,"_2447":103523},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2937":61070,"_26000":61024,"_18071":103525,"_5":17966,"_24599":103415,"_2447":103526},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2937":61071,"_26000":61024,"_18071":103528,"_5":17966,"_24599":103415,"_2447":103529},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2937":61072,"_26000":61024,"_18071":103531,"_5":17966,"_24599":103415,"_2447":103532},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2937":61073,"_26000":61024,"_18071":103534,"_5":17966,"_24599":103415,"_2447":103535},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2937":61074,"_26000":61024,"_18071":103537,"_5":17966,"_24599":103419,"_2447":103538},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2937":61075,"_26000":61024,"_18071":103540,"_5":17966,"_24599":103419,"_2447":103541},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2937":61076,"_26000":61024,"_18071":103543,"_5":17966,"_24599":103419,"_2447":103544},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2937":61077,"_26000":61077,"_5":12545,"_2447":103546,"_26339":103547,"_18071":103548,"_24599":61077},"Plataforma Lamassu IoT",[42089,100145],[],{"_2937":61078,"_26000":61077,"_18071":103550,"_5":17966,"_24599":61077,"_2447":103551},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2937":61079,"_26000":61077,"_5":26336,"_18071":103553,"_24599":103554,"_2447":103044},[],"/docs/pr-preview/pr-26/es/platform/overview#empieza-aquí",{"_2937":61080,"_26000":61077,"_5":26336,"_18071":103556,"_24599":103557,"_2447":103558},[],"/docs/pr-preview/pr-26/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2937":61081,"_26000":61077,"_5":26336,"_18071":103560,"_24599":103561,"_2447":103562},[],"/docs/pr-preview/pr-26/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2937":61082,"_26000":61077,"_5":26336,"_18071":103564,"_24599":103565,"_2447":103566},[],"/docs/pr-preview/pr-26/es/platform/overview#capacidades-principales","Capacidades principales",{"_2937":61083,"_26000":61077,"_5":26336,"_18071":103568,"_24599":103569,"_2447":103570},[],"/docs/pr-preview/pr-26/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2937":61084,"_26000":61077,"_5":26336,"_18071":103572,"_24599":103573,"_2447":103574},[],"/docs/pr-preview/pr-26/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2937":61085,"_26000":61077,"_5":26336,"_18071":103576,"_24599":103577,"_2447":103578},[],"/docs/pr-preview/pr-26/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2937":61086,"_26000":61077,"_5":26336,"_18071":103580,"_24599":103581,"_2447":103582},[],"/docs/pr-preview/pr-26/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2937":61087,"_26000":61077,"_5":26336,"_18071":103584,"_24599":103585,"_2447":103586},[],"/docs/pr-preview/pr-26/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2937":61088,"_26000":61077,"_5":26336,"_18071":103588,"_24599":103589,"_2447":103590},[],"/docs/pr-preview/pr-26/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2937":61089,"_26000":61077,"_5":26336,"_18071":103592,"_24599":103593,"_2447":103594},[],"/docs/pr-preview/pr-26/es/platform/overview#referencia-operativa","Referencia operativa",{"_2937":61090,"_26000":61077,"_18071":103596,"_5":17966,"_24599":61077,"_2447":103597},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2937":61091,"_26000":61077,"_18071":103599,"_5":17966,"_24599":103554,"_2447":103600},[],"Elige el resultado que necesitas obtener:",{"_2937":61092,"_26000":61077,"_18071":103602,"_5":17966,"_24599":103554,"_2447":103603},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2937":61093,"_26000":61077,"_18071":103605,"_5":17966,"_24599":103554,"_2447":103606},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2937":61094,"_26000":61077,"_18071":103608,"_5":17966,"_24599":103554,"_2447":103609},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2937":61095,"_26000":61077,"_18071":103611,"_5":17966,"_24599":103557,"_2447":103612},[],"Bloque",{"_2937":61096,"_26000":61077,"_18071":103614,"_5":17966,"_24599":103557,"_2447":103615},[],"Qué gestionas",{"_2937":61097,"_26000":61077,"_18071":103617,"_5":17966,"_24599":103557,"_2447":103618},[],"Punto de entrada",{"_2937":61098,"_26000":61077,"_18071":103620,"_5":17966,"_24599":103557,"_2447":47212},[],{"_2937":61099,"_26000":61077,"_18071":103622,"_5":17966,"_24599":103557,"_2447":103623},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2937":61100,"_26000":61077,"_18071":103625,"_5":17966,"_24599":103557,"_2447":103626},[],"Visión general de PKI",{"_2937":61101,"_26000":61077,"_18071":103628,"_5":17966,"_24599":103557,"_2447":47221},[],{"_2937":61102,"_26000":61077,"_18071":103630,"_5":17966,"_24599":103557,"_2447":103631},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2937":61103,"_26000":61077,"_18071":103633,"_5":17966,"_24599":103557,"_2447":103634},[],"Visión general de IoT Fleets",{"_2937":61104,"_26000":61077,"_18071":103636,"_5":17966,"_24599":103557,"_2447":103637},[],"**Administración**",{"_2937":61105,"_26000":61077,"_18071":103639,"_5":17966,"_24599":103557,"_2447":103640},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2937":61106,"_26000":61077,"_18071":103642,"_5":17966,"_24599":103557,"_2447":100143},[],{"_2937":61107,"_26000":61077,"_18071":103644,"_5":17966,"_24599":103557,"_2447":103645},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2937":61108,"_26000":61077,"_18071":103647,"_5":17966,"_24599":103561,"_2447":103648},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2937":61109,"_26000":61077,"_18071":103650,"_5":17966,"_24599":103561,"_2447":103651},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2937":61110,"_26000":61077,"_18071":103653,"_5":17966,"_24599":103561,"_2447":103654},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2937":61111,"_26000":61077,"_18071":103656,"_5":17966,"_24599":103561,"_2447":103657},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2937":61112,"_26000":61077,"_18071":103659,"_5":17966,"_24599":103561,"_2447":103660},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2937":61113,"_26000":61077,"_18071":103662,"_5":17966,"_24599":103561,"_2447":103663},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2937":61114,"_26000":61077,"_18071":103665,"_5":17966,"_24599":103569,"_2447":103666},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2937":61115,"_26000":61077,"_18071":103668,"_5":17966,"_24599":103573,"_2447":103669},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2937":61116,"_26000":61077,"_18071":103671,"_5":17966,"_24599":103577,"_2447":103672},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2937":61117,"_26000":61077,"_18071":103674,"_5":17966,"_24599":103581,"_2447":103675},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2937":61118,"_26000":61077,"_18071":103677,"_5":17966,"_24599":103585,"_2447":103678},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2937":61119,"_26000":61077,"_18071":103680,"_5":17966,"_24599":103589,"_2447":103681},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2937":61120,"_26000":61077,"_18071":103683,"_5":17966,"_24599":103593,"_2447":103137},[],{"_2937":61121,"_26000":61077,"_18071":103685,"_5":17966,"_24599":103593,"_2447":103686},[],"Qué prepara o comprueba",{"_2937":61122,"_26000":61077,"_18071":103688,"_5":17966,"_24599":103593,"_2447":103140},[],{"_2937":61123,"_26000":61077,"_18071":103690,"_5":17966,"_24599":103593,"_2447":103691},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2937":61124,"_26000":61077,"_18071":103693,"_5":17966,"_24599":103593,"_2447":103694},[],"Administrador de la flota",{"_2937":61125,"_26000":61077,"_18071":103696,"_5":17966,"_24599":103593,"_2447":103697},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2937":61126,"_26000":61077,"_18071":103699,"_5":17966,"_24599":103593,"_2447":103152},[],{"_2937":61127,"_26000":61077,"_18071":103701,"_5":17966,"_24599":103593,"_2447":103702},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2937":61128,"_26000":61077,"_18071":103704,"_5":17966,"_24599":103593,"_2447":103158},[],{"_2937":61129,"_26000":61077,"_18071":103706,"_5":17966,"_24599":103593,"_2447":103707},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2937":61130,"_26000":61077,"_18071":103709,"_5":17966,"_24599":103593,"_2447":103710},[],"Operador de infraestructura",{"_2937":61131,"_26000":61077,"_18071":103712,"_5":17966,"_24599":103593,"_2447":103713},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2937":61132,"_26000":61077,"_18071":103715,"_5":17966,"_24599":103593,"_2447":103716},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2937":61133,"_26000":61133,"_5":12545,"_2447":103718,"_26339":103719,"_18071":103721,"_24599":61133},"Jerarquía y rotación de CAs",[42089,100145,47313,103720],"Claves, autoridades y certificados",[],{"_2937":61134,"_26000":61133,"_18071":103723,"_5":17966,"_24599":61133,"_2447":103724},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2937":61135,"_26000":61133,"_5":26336,"_18071":103726,"_24599":103727,"_2447":103728},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2937":61136,"_26000":61133,"_5":26336,"_18071":103730,"_24599":103731,"_2447":103732},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2937":61137,"_26000":61133,"_5":26336,"_18071":103734,"_24599":103735,"_2447":103736},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2937":61138,"_26000":61133,"_5":26336,"_18071":103738,"_24599":103739,"_2447":103740},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2937":61139,"_26000":61133,"_5":26336,"_18071":103742,"_24599":103743,"_2447":103744},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2937":61140,"_26000":61133,"_5":26336,"_18071":103746,"_24599":103747,"_2447":103748},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2937":61141,"_26000":61133,"_5":26336,"_18071":103750,"_24599":103751,"_2447":103752},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2937":61142,"_26000":61133,"_5":26336,"_18071":103754,"_24599":103755,"_2447":103756},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2937":61143,"_26000":61133,"_5":26336,"_18071":103758,"_24599":103759,"_2447":103760},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2937":61144,"_26000":61133,"_5":26336,"_18071":103762,"_24599":103763,"_2447":103764},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2937":61145,"_26000":61133,"_5":26336,"_18071":103766,"_24599":103767,"_2447":103768},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2937":61146,"_26000":61133,"_5":26336,"_18071":103770,"_24599":103771,"_2447":103772},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2937":61147,"_26000":61133,"_18071":103774,"_5":17966,"_24599":61133,"_2447":103775},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2937":61148,"_26000":61133,"_18071":103777,"_5":17966,"_24599":61133,"_2447":103778},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2937":61149,"_26000":61133,"_18071":103780,"_5":17966,"_24599":103727,"_2447":103781},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2937":61150,"_26000":61133,"_18071":103783,"_5":17966,"_24599":103727,"_2447":103784},[],"entorno, como producción y preproducción;",{"_2937":61151,"_26000":61133,"_18071":103786,"_5":17966,"_24599":103727,"_2447":103787},[],"propietario o equipo operador;",{"_2937":61152,"_26000":61133,"_18071":103789,"_5":17966,"_24599":103727,"_2447":103790},[],"familia de dispositivos o proceso de fabricación;",{"_2937":61153,"_26000":61133,"_18071":103792,"_5":17966,"_24599":103727,"_2447":103793},[],"región o requisito regulatorio;",{"_2937":61154,"_26000":61133,"_18071":103795,"_5":17966,"_24599":103727,"_2447":103796},[],"motor criptográfico o política de clave;",{"_2937":61155,"_26000":61133,"_18071":103798,"_5":17966,"_24599":103727,"_2447":103799},[],"ventana de mantenimiento y ritmo de renovación.",{"_2937":61156,"_26000":61133,"_18071":103801,"_5":17966,"_24599":103727,"_2447":103802},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2937":61157,"_26000":61133,"_18071":103804,"_5":17966,"_24599":103727,"_2447":103805},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2937":61158,"_26000":61133,"_18071":103807,"_5":17966,"_24599":103731,"_2447":103808},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2937":61159,"_26000":61133,"_18071":103810,"_5":17966,"_24599":103731,"_2447":103811},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2937":61160,"_26000":61133,"_18071":103813,"_5":17966,"_24599":103731,"_2447":103814},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2937":61161,"_26000":61133,"_18071":103816,"_5":17966,"_24599":103735,"_2447":103817},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2937":61162,"_26000":61133,"_18071":103819,"_5":17966,"_24599":103735,"_2447":103820},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2937":61163,"_26000":61133,"_18071":103822,"_5":17966,"_24599":103735,"_2447":103823},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2937":61164,"_26000":61133,"_18071":103825,"_5":17966,"_24599":103735,"_2447":103826},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2937":61165,"_26000":61133,"_18071":103828,"_5":17966,"_24599":103743,"_2447":103829},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2937":61166,"_26000":61133,"_18071":103831,"_5":17966,"_24599":103747,"_2447":103832},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2937":61167,"_26000":61133,"_18071":103834,"_5":17966,"_24599":103751,"_2447":103835},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2937":61168,"_26000":61133,"_18071":103837,"_5":17966,"_24599":103755,"_2447":103838},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2937":61169,"_26000":61133,"_18071":103840,"_5":17966,"_24599":103759,"_2447":103841},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2937":61170,"_26000":61133,"_18071":103843,"_5":17966,"_24599":103763,"_2447":103844},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2937":61171,"_26000":61133,"_18071":103846,"_5":17966,"_24599":103767,"_2447":103847},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2937":61172,"_26000":61133,"_18071":103849,"_5":17966,"_24599":103767,"_2447":103850},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2937":61173,"_26000":61133,"_18071":103852,"_5":17966,"_24599":103767,"_2447":103853},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2937":61174,"_26000":61133,"_18071":103855,"_5":17966,"_24599":103767,"_2447":103856},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2937":61175,"_26000":61133,"_18071":103858,"_5":17966,"_24599":103771,"_2447":103859},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2937":61176,"_26000":61133,"_18071":103861,"_5":17966,"_24599":103771,"_2447":103862},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2937":61177,"_26000":61133,"_18071":103864,"_5":17966,"_24599":103771,"_2447":103865},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2937":61178,"_26000":61133,"_18071":103867,"_5":17966,"_24599":103771,"_2447":103868},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2937":61179,"_26000":61133,"_18071":103870,"_5":17966,"_24599":103771,"_2447":103871},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2937":61180,"_26000":61133,"_18071":103873,"_5":17966,"_24599":103771,"_2447":103874},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2937":61181,"_26000":61133,"_18071":103876,"_5":17966,"_24599":103771,"_2447":103877},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2937":61182,"_26000":61182,"_5":12545,"_2447":103879,"_26339":103880,"_18071":103881,"_24599":61182},"Autoridades de certificación",[42089,100145,47313,103720],[],{"_2937":61183,"_26000":61182,"_18071":103883,"_5":17966,"_24599":61182,"_2447":103884},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2937":61184,"_26000":61182,"_5":26336,"_18071":103886,"_24599":103887,"_2447":103888},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2937":61185,"_26000":61182,"_5":26336,"_18071":103890,"_24599":103891,"_2447":103892},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2937":61186,"_26000":61182,"_5":26336,"_18071":103894,"_24599":103895,"_2447":98644},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2937":61187,"_26000":61182,"_5":26336,"_18071":103897,"_24599":103898,"_2447":103899},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2937":61188,"_26000":61182,"_5":26336,"_18071":103901,"_24599":103902,"_2447":103903},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2937":61189,"_26000":61182,"_5":26336,"_18071":103905,"_24599":103906,"_2447":103907},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2937":61190,"_26000":61182,"_5":26336,"_18071":103909,"_24599":103910,"_2447":103911},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2937":61191,"_26000":61182,"_5":26336,"_18071":103913,"_24599":103914,"_2447":103915},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2937":61192,"_26000":61182,"_5":26336,"_18071":103917,"_24599":103918,"_2447":103919},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2937":61193,"_26000":61182,"_5":26336,"_18071":103921,"_24599":103922,"_2447":103923},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2937":61194,"_26000":61182,"_5":26336,"_18071":103925,"_24599":103926,"_2447":103927},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2937":61195,"_26000":61182,"_5":26336,"_18071":103929,"_24599":103930,"_2447":103931},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2937":61196,"_26000":61182,"_5":26336,"_18071":103933,"_24599":103934,"_2447":103935},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2937":61197,"_26000":61182,"_5":26336,"_18071":103937,"_24599":103938,"_2447":103939},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2937":61198,"_26000":61182,"_5":26336,"_18071":103941,"_24599":103942,"_2447":103943},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2937":61199,"_26000":61182,"_5":26336,"_18071":103945,"_24599":103946,"_2447":103947},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2937":61200,"_26000":61182,"_5":26336,"_18071":103949,"_24599":103950,"_2447":103951},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2937":61201,"_26000":61182,"_5":26336,"_18071":103953,"_24599":103954,"_2447":103955},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2937":61202,"_26000":61182,"_5":26336,"_18071":103957,"_24599":103958,"_2447":103959},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2937":61203,"_26000":61182,"_5":26336,"_18071":103961,"_24599":103962,"_2447":103963},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2937":61204,"_26000":61182,"_5":26336,"_18071":103965,"_24599":103966,"_2447":103967},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2937":61205,"_26000":61182,"_5":26336,"_18071":103969,"_24599":103970,"_2447":103971},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2937":61206,"_26000":61182,"_18071":103973,"_5":17966,"_24599":61182,"_2447":103974},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2937":61207,"_26000":61182,"_18071":103976,"_5":17966,"_24599":61182,"_2447":103977},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2937":61208,"_26000":61182,"_18071":103979,"_5":17966,"_24599":61182,"_2447":103980},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2937":61209,"_26000":61182,"_18071":103982,"_5":17966,"_24599":103887,"_2447":103983},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2937":61210,"_26000":61182,"_18071":103985,"_5":17966,"_24599":103887,"_2447":103986},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2937":61211,"_26000":61182,"_18071":103988,"_5":17966,"_24599":103887,"_2447":103989},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2937":61212,"_26000":61182,"_18071":103991,"_5":17966,"_24599":103887,"_2447":103992},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2937":61213,"_26000":61182,"_18071":103994,"_5":17966,"_24599":103887,"_2447":103995},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2937":61214,"_26000":61182,"_18071":103997,"_5":17966,"_24599":103895,"_2447":103998},[],"Decide si la CA será raíz o intermedia.",{"_2937":61215,"_26000":61182,"_18071":104000,"_5":17966,"_24599":103895,"_2447":104001},[],"Elige el motor que custodiará la clave.",{"_2937":61216,"_26000":61182,"_18071":104003,"_5":17966,"_24599":103895,"_2447":104004},[],"Define una validez superior a la de los certificados que emitirá.",{"_2937":61217,"_26000":61182,"_18071":104006,"_5":17966,"_24599":103895,"_2447":104007},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2937":61218,"_26000":61182,"_18071":104009,"_5":17966,"_24599":103898,"_2447":104010},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2937":61219,"_26000":61182,"_18071":104012,"_5":17966,"_24599":103902,"_2447":104013},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2937":61220,"_26000":61182,"_18071":104015,"_5":17966,"_24599":103902,"_2447":104016},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2937":61221,"_26000":61182,"_18071":104018,"_5":17966,"_24599":103906,"_2447":104019},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2937":61222,"_26000":61182,"_18071":104021,"_5":17966,"_24599":103910,"_2447":104022},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2937":61223,"_26000":61182,"_18071":104024,"_5":17966,"_24599":103910,"_2447":104025},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2937":61224,"_26000":61182,"_18071":104027,"_5":17966,"_24599":103910,"_2447":104028},[],"`ST`: estado o provincia.",{"_2937":61225,"_26000":61182,"_18071":104030,"_5":17966,"_24599":103910,"_2447":104031},[],"`L`: localidad.",{"_2937":61226,"_26000":61182,"_18071":104033,"_5":17966,"_24599":103910,"_2447":104034},[],"`O`: organización.",{"_2937":61227,"_26000":61182,"_18071":104036,"_5":17966,"_24599":103910,"_2447":104037},[],"`OU`: unidad organizativa.",{"_2937":61228,"_26000":61182,"_18071":104039,"_5":17966,"_24599":103910,"_2447":104040},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2937":61229,"_26000":61182,"_18071":104042,"_5":17966,"_24599":103914,"_2447":104043},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2937":61230,"_26000":61182,"_18071":104045,"_5":17966,"_24599":103914,"_2447":104046},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2937":61231,"_26000":61182,"_18071":104048,"_5":17966,"_24599":103918,"_2447":104049},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2937":61232,"_26000":61182,"_18071":104051,"_5":17966,"_24599":103918,"_2447":104052},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2937":61233,"_26000":61182,"_18071":104054,"_5":17966,"_24599":103922,"_2447":104055},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2937":61234,"_26000":61182,"_18071":104057,"_5":17966,"_24599":103922,"_2447":104058},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2937":61235,"_26000":61182,"_18071":104060,"_5":17966,"_24599":103926,"_2447":104061},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2937":61236,"_26000":61182,"_18071":104063,"_5":17966,"_24599":103930,"_2447":104064},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2937":61237,"_26000":61182,"_18071":104066,"_5":17966,"_24599":103934,"_2447":104067},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2937":61238,"_26000":61182,"_18071":104069,"_5":17966,"_24599":103938,"_2447":104070},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2937":61239,"_26000":61182,"_18071":104072,"_5":17966,"_24599":103942,"_2447":104073},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2937":61240,"_26000":61182,"_18071":104075,"_5":17966,"_24599":103942,"_2447":104076},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2937":61241,"_26000":61182,"_18071":104078,"_5":17966,"_24599":103946,"_2447":104079},[],"Abre una CA desde el inventario para consultar:",{"_2937":61242,"_26000":61182,"_18071":104081,"_5":17966,"_24599":103946,"_2447":104082},[],"Estado y periodo de validez.",{"_2937":61243,"_26000":61182,"_18071":104084,"_5":17966,"_24599":103946,"_2447":104085},[],"Certificado y cadena en formato PEM.",{"_2937":61244,"_26000":61182,"_18071":104087,"_5":17966,"_24599":103946,"_2447":104088},[],"Número de certificados activos, expirados y revocados.",{"_2937":61245,"_26000":61182,"_18071":104090,"_5":17966,"_24599":103946,"_2447":104091},[],"Certificados emitidos en **Issued Certificates**.",{"_2937":61246,"_26000":61182,"_18071":104093,"_5":17966,"_24599":103946,"_2447":104094},[],"CRL vinculada a la autoridad.",{"_2937":61247,"_26000":61182,"_18071":104096,"_5":17966,"_24599":103946,"_2447":104097},[],"Metadatos y motor criptográfico asociado.",{"_2937":61248,"_26000":61182,"_18071":104099,"_5":17966,"_24599":103946,"_2447":104100},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2937":61249,"_26000":61182,"_18071":104102,"_5":17966,"_24599":103950,"_2447":104103},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2937":61250,"_26000":61182,"_18071":104105,"_5":17966,"_24599":103950,"_2447":104106},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2937":61251,"_26000":61182,"_18071":104108,"_5":17966,"_24599":103950,"_2447":104109},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2937":61252,"_26000":61182,"_18071":104111,"_5":17966,"_24599":103950,"_2447":104112},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2937":61253,"_26000":61182,"_18071":104114,"_5":17966,"_24599":103954,"_2447":104115},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2937":61254,"_26000":61182,"_18071":104117,"_5":17966,"_24599":103958,"_2447":104118},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2937":61255,"_26000":61182,"_18071":104120,"_5":17966,"_24599":103962,"_2447":104121},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2937":61256,"_26000":61182,"_18071":104123,"_5":17966,"_24599":103966,"_2447":104124},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2937":61257,"_26000":61182,"_18071":104126,"_5":17966,"_24599":103970,"_2447":104127},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2937":61258,"_26000":61182,"_18071":104129,"_5":17966,"_24599":103970,"_2447":104130},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2937":61259,"_26000":61259,"_5":12545,"_2447":104132,"_26339":104133,"_18071":104134,"_24599":61259},"Perfiles de certificado",[42089,100145,47313,103720],[],{"_2937":61260,"_26000":61259,"_18071":104136,"_5":17966,"_24599":61259,"_2447":104137},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2937":61261,"_26000":61259,"_5":26336,"_18071":104139,"_24599":104140,"_2447":104141},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2937":61262,"_26000":61259,"_5":26336,"_18071":104143,"_24599":104144,"_2447":104145},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#validez","Validez",{"_2937":61263,"_26000":61259,"_5":26336,"_18071":104147,"_24599":104148,"_2447":104149},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2937":61264,"_26000":61259,"_5":26336,"_18071":104151,"_24599":104152,"_2447":104153},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2937":61265,"_26000":61259,"_5":26336,"_18071":104155,"_24599":104156,"_2447":104157},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2937":61266,"_26000":61259,"_5":26336,"_18071":104159,"_24599":104160,"_2447":104161},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2937":61267,"_26000":61259,"_5":26336,"_18071":104163,"_24599":104164,"_2447":104165},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2937":61268,"_26000":61259,"_5":26336,"_18071":104167,"_24599":104168,"_2447":104169},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2937":61269,"_26000":61259,"_5":26336,"_18071":104171,"_24599":104172,"_2447":104173},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2937":61270,"_26000":61259,"_5":26336,"_18071":104175,"_24599":104176,"_2447":104177},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2937":61271,"_26000":61259,"_5":26336,"_18071":104179,"_24599":104180,"_2447":104181},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2937":61272,"_26000":61259,"_5":26336,"_18071":104183,"_24599":104184,"_2447":104185},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2937":61273,"_26000":61259,"_5":26336,"_18071":104187,"_24599":104188,"_2447":104189},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2937":61274,"_26000":61259,"_5":26336,"_18071":104191,"_24599":104192,"_2447":104193},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2937":61275,"_26000":61259,"_5":26336,"_18071":104195,"_24599":104196,"_2447":104197},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2937":61276,"_26000":61259,"_5":26336,"_18071":104199,"_24599":104200,"_2447":104201},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2937":61277,"_26000":61259,"_18071":104203,"_5":17966,"_24599":61259,"_2447":104204},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2937":61278,"_26000":61259,"_18071":104206,"_5":17966,"_24599":61259,"_2447":104207},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2937":61279,"_26000":61259,"_18071":104209,"_5":17966,"_24599":104144,"_2447":104210},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2937":61280,"_26000":61259,"_18071":104212,"_5":17966,"_24599":104144,"_2447":104213},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2937":61281,"_26000":61259,"_18071":104215,"_5":17966,"_24599":104148,"_2447":104216},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2937":61282,"_26000":61259,"_18071":104218,"_5":17966,"_24599":104152,"_2447":104219},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2937":61283,"_26000":61259,"_18071":104221,"_5":17966,"_24599":104152,"_2447":104222},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2937":61284,"_26000":61259,"_18071":104224,"_5":17966,"_24599":104152,"_2447":104225},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2937":61285,"_26000":61259,"_18071":104227,"_5":17966,"_24599":104156,"_2447":104228},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2937":61286,"_26000":61259,"_18071":104230,"_5":17966,"_24599":104160,"_2447":104231},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2937":61287,"_26000":61259,"_18071":104233,"_5":17966,"_24599":104160,"_2447":104234},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2937":61288,"_26000":61259,"_18071":104236,"_5":17966,"_24599":104164,"_2447":104237},[],"La aplicación criptográfica puede:",{"_2937":61289,"_26000":61259,"_18071":104239,"_5":17966,"_24599":104164,"_2447":104240},[],"permitir o bloquear claves RSA;",{"_2937":61290,"_26000":61259,"_18071":104242,"_5":17966,"_24599":104164,"_2447":104243},[],"limitar los tamaños RSA admitidos;",{"_2937":61291,"_26000":61259,"_18071":104245,"_5":17966,"_24599":104164,"_2447":104246},[],"permitir o bloquear claves ECDSA;",{"_2937":61292,"_26000":61259,"_18071":104248,"_5":17966,"_24599":104164,"_2447":104249},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2937":61293,"_26000":61259,"_18071":104251,"_5":17966,"_24599":104164,"_2447":104252},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2937":61294,"_26000":61259,"_18071":104254,"_5":17966,"_24599":104168,"_2447":104255},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2937":61295,"_26000":61259,"_18071":104257,"_5":17966,"_24599":104168,"_2447":99936},[],{"_2937":61296,"_26000":61259,"_18071":104259,"_5":17966,"_24599":104168,"_2447":104260},[],"Primera opción",{"_2937":61297,"_26000":61259,"_18071":104262,"_5":17966,"_24599":104168,"_2447":104263},[],"Segunda opción",{"_2937":61298,"_26000":61259,"_18071":104265,"_5":17966,"_24599":104168,"_2447":104266},[],"Si no hay ninguna",{"_2937":61299,"_26000":61259,"_18071":104268,"_5":17966,"_24599":104168,"_2447":104269},[],"Firma directa con una CA",{"_2937":61300,"_26000":61259,"_18071":104271,"_5":17966,"_24599":104168,"_2447":104272},[],"`issuance_profile` incluido en la solicitud",{"_2937":61301,"_26000":61259,"_18071":104274,"_5":17966,"_24599":104168,"_2447":104275},[],"`issuance_profile_id` de la solicitud",{"_2937":61302,"_26000":61259,"_18071":104277,"_5":17966,"_24599":104168,"_2447":104278},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2937":61303,"_26000":61259,"_18071":104280,"_5":17966,"_24599":104168,"_2447":104281},[],"Emisión mediante DMS",{"_2937":61304,"_26000":61259,"_18071":104283,"_5":17966,"_24599":104168,"_2447":47878},[],{"_2937":61305,"_26000":61259,"_18071":104285,"_5":17966,"_24599":104168,"_2447":104286},[],"`settings.issuance_profile` incluido en el DMS",{"_2937":61306,"_26000":61259,"_18071":104288,"_5":17966,"_24599":104168,"_2447":104289},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2937":61307,"_26000":61259,"_18071":104291,"_5":17966,"_24599":104168,"_2447":104292},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2937":61308,"_26000":61259,"_18071":104294,"_5":17966,"_24599":104168,"_2447":104295},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2937":61309,"_26000":61259,"_18071":104297,"_5":17966,"_24599":104176,"_2447":104298},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2937":61310,"_26000":61259,"_18071":104300,"_5":17966,"_24599":104180,"_2447":104301},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2937":61311,"_26000":61259,"_18071":104303,"_5":17966,"_24599":104184,"_2447":104304},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2937":61312,"_26000":61259,"_18071":104306,"_5":17966,"_24599":104188,"_2447":104307},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2937":61313,"_26000":61259,"_18071":104309,"_5":17966,"_24599":104192,"_2447":104310},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2937":61314,"_26000":61259,"_18071":104312,"_5":17966,"_24599":104192,"_2447":104313},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2937":61315,"_26000":61259,"_18071":104315,"_5":17966,"_24599":104196,"_2447":104316},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2937":61316,"_26000":61259,"_18071":104318,"_5":17966,"_24599":104196,"_2447":104319},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2937":61317,"_26000":61259,"_18071":104321,"_5":17966,"_24599":104196,"_2447":104322},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2937":61318,"_26000":61259,"_18071":104324,"_5":17966,"_24599":104196,"_2447":104325},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2937":61319,"_26000":61259,"_18071":104327,"_5":17966,"_24599":104200,"_2447":104328},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2937":61320,"_26000":61259,"_18071":104330,"_5":17966,"_24599":104200,"_2447":104331},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2937":61321,"_26000":61321,"_5":12545,"_2447":104333,"_26339":104334,"_18071":104336,"_24599":61321},"Validación de certificados",[42089,100145,47313,104335],"Validación",[],{"_2937":61322,"_26000":61321,"_18071":104338,"_5":17966,"_24599":61321,"_2447":104339},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2937":61323,"_26000":61321,"_5":26336,"_18071":104341,"_24599":104342,"_2447":104343},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2937":61324,"_26000":61321,"_5":26336,"_18071":104345,"_24599":104346,"_2447":104347},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2937":61325,"_26000":61321,"_5":26336,"_18071":104349,"_24599":104350,"_2447":104351},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2937":61326,"_26000":61321,"_18071":104353,"_5":17966,"_24599":61321,"_2447":104354},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2937":61327,"_26000":61321,"_18071":104356,"_5":17966,"_24599":104342,"_2447":104357},[],"Verifica estos criterios juntos:",{"_2937":61328,"_26000":61321,"_18071":104359,"_5":17966,"_24599":104342,"_2447":103347},[],{"_2937":61329,"_26000":61321,"_18071":104361,"_5":17966,"_24599":104342,"_2447":104362},[],"Resultado necesario",{"_2937":61330,"_26000":61321,"_18071":104364,"_5":17966,"_24599":104342,"_2447":104365},[],"Cadena y firma",{"_2937":61331,"_26000":61321,"_18071":104367,"_5":17966,"_24599":104342,"_2447":104368},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2937":61332,"_26000":61321,"_18071":104370,"_5":17966,"_24599":104342,"_2447":104371},[],"Fechas",{"_2937":61333,"_26000":61321,"_18071":104373,"_5":17966,"_24599":104342,"_2447":104374},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2937":61334,"_26000":61321,"_18071":104376,"_5":17966,"_24599":104342,"_2447":99846},[],{"_2937":61335,"_26000":61321,"_18071":104378,"_5":17966,"_24599":104342,"_2447":104379},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2937":61336,"_26000":61321,"_18071":104381,"_5":17966,"_24599":104342,"_2447":104382},[],"Uso",{"_2937":61337,"_26000":61321,"_18071":104384,"_5":17966,"_24599":104342,"_2447":104385},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2937":61338,"_26000":61321,"_18071":104387,"_5":17966,"_24599":104342,"_2447":104388},[],"Revocación",{"_2937":61339,"_26000":61321,"_18071":104390,"_5":17966,"_24599":104342,"_2447":104391},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2937":61340,"_26000":61321,"_18071":104393,"_5":17966,"_24599":104342,"_2447":104394},[],"Autorización",{"_2937":61341,"_26000":61321,"_18071":104396,"_5":17966,"_24599":104342,"_2447":104397},[],"La aplicación permite la acción a esa identidad.",{"_2937":61342,"_26000":61321,"_18071":104399,"_5":17966,"_24599":104342,"_2447":104400},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2937":61343,"_26000":61321,"_18071":104402,"_5":17966,"_24599":104346,"_2447":104403},[],"Mecanismo",{"_2937":61344,"_26000":61321,"_18071":104405,"_5":17966,"_24599":104346,"_2447":104406},[],"Cuándo utilizarlo",{"_2937":61345,"_26000":61321,"_18071":104408,"_5":17966,"_24599":104346,"_2447":104409},[],"Qué debes mantener",{"_2937":61346,"_26000":61321,"_18071":104411,"_5":17966,"_24599":104346,"_2447":48006},[],{"_2937":61347,"_26000":61321,"_18071":104413,"_5":17966,"_24599":104346,"_2447":104414},[],"Consulta del estado de un certificado concreto.",{"_2937":61348,"_26000":61321,"_18071":104416,"_5":17966,"_24599":104346,"_2447":104417},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2937":61349,"_26000":61321,"_18071":104419,"_5":17966,"_24599":104346,"_2447":48015},[],{"_2937":61350,"_26000":61321,"_18071":104421,"_5":17966,"_24599":104346,"_2447":104422},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2937":61351,"_26000":61321,"_18071":104424,"_5":17966,"_24599":104346,"_2447":104425},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2937":61352,"_26000":61321,"_18071":104427,"_5":17966,"_24599":104346,"_2447":104428},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2937":61353,"_26000":61321,"_18071":104430,"_5":17966,"_24599":104346,"_2447":104431},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2937":61354,"_26000":61321,"_18071":104433,"_5":17966,"_24599":104350,"_2447":104434},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2937":61355,"_26000":61321,"_18071":104436,"_5":17966,"_24599":104350,"_2447":104437},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2937":61356,"_26000":61321,"_18071":104439,"_5":17966,"_24599":104350,"_2447":104440},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2937":61357,"_26000":61321,"_18071":104442,"_5":17966,"_24599":104350,"_2447":104443},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2937":61358,"_26000":61321,"_18071":104445,"_5":17966,"_24599":104350,"_2447":104446},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2937":61359,"_26000":61321,"_18071":104448,"_5":17966,"_24599":104350,"_2447":104449},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2937":61360,"_26000":61321,"_18071":104451,"_5":17966,"_24599":104350,"_2447":104452},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2937":61361,"_26000":61321,"_18071":104454,"_5":17966,"_24599":104350,"_2447":104455},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2937":61362,"_26000":61321,"_18071":104457,"_5":17966,"_24599":104350,"_2447":104458},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2937":61363,"_26000":61363,"_5":12545,"_2447":104460,"_26339":104461,"_18071":104462,"_24599":61363},"Certificados",[42089,100145,47313,103720],[],{"_2937":61364,"_26000":61363,"_18071":104464,"_5":17966,"_24599":61363,"_2447":104465},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2937":61365,"_26000":61363,"_5":26336,"_18071":104467,"_24599":104468,"_2447":104469},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2937":61366,"_26000":61363,"_5":26336,"_18071":104471,"_24599":104472,"_2447":104473},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2937":61367,"_26000":61363,"_5":26336,"_18071":104475,"_24599":104476,"_2447":104477},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2937":61368,"_26000":61363,"_5":26336,"_18071":104479,"_24599":104480,"_2447":104481},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2937":61369,"_26000":61363,"_5":26336,"_18071":104483,"_24599":104484,"_2447":104485},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2937":61370,"_26000":61363,"_5":26336,"_18071":104487,"_24599":104488,"_2447":104489},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2937":61371,"_26000":61363,"_5":26336,"_18071":104491,"_24599":104492,"_2447":104493},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2937":61372,"_26000":61363,"_5":26336,"_18071":104495,"_24599":104496,"_2447":104497},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2937":61373,"_26000":61363,"_5":26336,"_18071":104499,"_24599":104500,"_2447":104501},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#continúa","Continúa",{"_2937":61374,"_26000":61363,"_18071":104503,"_5":17966,"_24599":61363,"_2447":104504},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2937":61375,"_26000":61363,"_18071":104506,"_5":17966,"_24599":104468,"_2447":104507},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2937":61376,"_26000":61363,"_18071":104509,"_5":17966,"_24599":104468,"_2447":104510},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2937":61377,"_26000":61363,"_18071":104512,"_5":17966,"_24599":104472,"_2447":104513},[],"Descarga el PEM e inspecciónalo:",{"_2937":61378,"_26000":61363,"_18071":104515,"_5":17966,"_24599":104472,"_2447":104516},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2937":61379,"_26000":61363,"_18071":104518,"_5":17966,"_24599":104476,"_2447":104519},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2937":61380,"_26000":61363,"_18071":104521,"_5":17966,"_24599":104476,"_2447":104522},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2937":61381,"_26000":61363,"_18071":104524,"_5":17966,"_24599":104476,"_2447":104525},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2937":61382,"_26000":61363,"_18071":104527,"_5":17966,"_24599":104476,"_2447":104528},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2937":61383,"_26000":61363,"_18071":104530,"_5":17966,"_24599":104476,"_2447":104531},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2937":61384,"_26000":61363,"_18071":104533,"_5":17966,"_24599":104476,"_2447":104534},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2937":61385,"_26000":61363,"_18071":104536,"_5":17966,"_24599":104476,"_2447":104537},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2937":61386,"_26000":61363,"_18071":104539,"_5":17966,"_24599":104480,"_2447":104540},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2937":61387,"_26000":61363,"_18071":104542,"_5":17966,"_24599":104484,"_2447":104543},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2937":61388,"_26000":61363,"_18071":104545,"_5":17966,"_24599":104488,"_2447":104546},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2937":61389,"_26000":61363,"_18071":104548,"_5":17966,"_24599":104492,"_2447":104549},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2937":61390,"_26000":61363,"_18071":104551,"_5":17966,"_24599":104492,"_2447":104552},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2937":61391,"_26000":61363,"_18071":104554,"_5":17966,"_24599":104492,"_2447":104555},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2937":61392,"_26000":61363,"_18071":104557,"_5":17966,"_24599":104496,"_2447":104558},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2937":61393,"_26000":61363,"_18071":104560,"_5":17966,"_24599":104496,"_2447":104561},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2937":61394,"_26000":61363,"_18071":104563,"_5":17966,"_24599":104496,"_2447":104564},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2937":61395,"_26000":61363,"_18071":104566,"_5":17966,"_24599":104500,"_2447":104567},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2937":61396,"_26000":61363,"_18071":104569,"_5":17966,"_24599":104500,"_2447":104570},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2937":61397,"_26000":61397,"_5":12545,"_2447":104572,"_26339":104573,"_18071":104575,"_24599":61397},"Ciclo de vida de un certificado",[42089,100145,47313,104574],"Conceptos",[],{"_2937":61398,"_26000":61397,"_18071":104577,"_5":17966,"_24599":61397,"_2447":104578},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2937":61399,"_26000":61397,"_5":26336,"_18071":104580,"_24599":104581,"_2447":104582},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2937":61400,"_26000":61397,"_5":26336,"_18071":104584,"_24599":104585,"_2447":104586},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2937":61401,"_26000":61397,"_5":26336,"_18071":104588,"_24599":104589,"_2447":104590},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2937":61402,"_26000":61397,"_5":26336,"_18071":104592,"_24599":104593,"_2447":104594},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2937":61403,"_26000":61397,"_5":26336,"_18071":104596,"_24599":104597,"_2447":104598},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2937":61404,"_26000":61397,"_5":26336,"_18071":104600,"_24599":104601,"_2447":104602},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2937":61405,"_26000":61397,"_5":26336,"_18071":104604,"_24599":104605,"_2447":104606},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2937":61406,"_26000":61397,"_5":26336,"_18071":104608,"_24599":104609,"_2447":104610},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2937":61407,"_26000":61397,"_5":26336,"_18071":104612,"_24599":104613,"_2447":104614},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2937":61408,"_26000":61397,"_5":26336,"_18071":104616,"_24599":104617,"_2447":104618},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2937":61409,"_26000":61397,"_18071":104620,"_5":17966,"_24599":61397,"_2447":104621},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2937":61410,"_26000":61397,"_18071":104623,"_5":17966,"_24599":104585,"_2447":104624},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2937":61411,"_26000":61397,"_18071":104626,"_5":17966,"_24599":104589,"_2447":104627},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2937":61412,"_26000":61397,"_18071":104629,"_5":17966,"_24599":104593,"_2447":104630},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2937":61413,"_26000":61397,"_18071":104632,"_5":17966,"_24599":104597,"_2447":104633},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2937":61414,"_26000":61397,"_18071":104635,"_5":17966,"_24599":104601,"_2447":104636},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2937":61415,"_26000":61397,"_18071":104638,"_5":17966,"_24599":104605,"_2447":104639},[],"Lamassu persiste cuatro estados X.509:",{"_2937":61416,"_26000":61397,"_18071":104641,"_5":17966,"_24599":104605,"_2447":104642},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2937":61417,"_26000":61397,"_18071":104644,"_5":17966,"_24599":104605,"_2447":104645},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2937":61418,"_26000":61397,"_18071":104647,"_5":17966,"_24599":104605,"_2447":104648},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2937":61419,"_26000":61397,"_18071":104650,"_5":17966,"_24599":104605,"_2447":104651},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2937":61420,"_26000":61397,"_18071":104653,"_5":17966,"_24599":104605,"_2447":104654},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2937":61421,"_26000":61397,"_18071":104656,"_5":17966,"_24599":104609,"_2447":104657},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2937":61422,"_26000":61397,"_18071":104659,"_5":17966,"_24599":104609,"_2447":104660},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2937":61423,"_26000":61397,"_18071":104662,"_5":17966,"_24599":104609,"_2447":104663},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2937":61424,"_26000":61397,"_18071":104665,"_5":17966,"_24599":104613,"_2447":104666},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2937":61425,"_26000":61397,"_18071":104668,"_5":17966,"_24599":104613,"_2447":104669},[],"Antes de confirmar:",{"_2937":61426,"_26000":61397,"_18071":104671,"_5":17966,"_24599":104613,"_2447":104672},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2937":61427,"_26000":61397,"_18071":104674,"_5":17966,"_24599":104613,"_2447":104675},[],"Distribuye la nueva cadena de confianza.",{"_2937":61428,"_26000":61397,"_18071":104677,"_5":17966,"_24599":104613,"_2447":104678},[],"Reemite las identidades necesarias.",{"_2937":61429,"_26000":61397,"_18071":104680,"_5":17966,"_24599":104613,"_2447":104681},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2937":61430,"_26000":61397,"_18071":104683,"_5":17966,"_24599":104613,"_2447":104684},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2937":61431,"_26000":61397,"_18071":104686,"_5":17966,"_24599":104613,"_2447":104687},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2937":61432,"_26000":61397,"_18071":104689,"_5":17966,"_24599":104617,"_2447":104690},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2937":61433,"_26000":61397,"_18071":104692,"_5":17966,"_24599":104617,"_2447":104693},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2937":61434,"_26000":61397,"_18071":104695,"_5":17966,"_24599":104617,"_2447":104696},[],"Cambios de estado y razones de revocación.",{"_2937":61435,"_26000":61397,"_18071":104698,"_5":17966,"_24599":104617,"_2447":104699},[],"Publicación y vigencia de OCSP y CRLs.",{"_2937":61436,"_26000":61397,"_18071":104701,"_5":17966,"_24599":104617,"_2447":104702},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2937":61437,"_26000":61397,"_18071":104704,"_5":17966,"_24599":104617,"_2447":104705},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2937":61438,"_26000":61438,"_5":12545,"_2447":104707,"_26339":104708,"_18071":104709,"_24599":61438},"Modelo de confianza",[42089,100145,47313,104574],[],{"_2937":61439,"_26000":61438,"_18071":104711,"_5":17966,"_24599":61438,"_2447":104712},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2937":61440,"_26000":61438,"_5":26336,"_18071":104714,"_24599":104715,"_2447":104716},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2937":61441,"_26000":61438,"_5":26336,"_18071":104718,"_24599":104719,"_2447":104720},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2937":61442,"_26000":61438,"_5":26336,"_18071":104722,"_24599":104723,"_2447":104724},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2937":61443,"_26000":61438,"_5":26336,"_18071":104726,"_24599":104727,"_2447":104728},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2937":61444,"_26000":61438,"_5":26336,"_18071":104730,"_24599":104731,"_2447":104732},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2937":61445,"_26000":61438,"_5":26336,"_18071":104734,"_24599":104735,"_2447":104736},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2937":61446,"_26000":61438,"_5":26336,"_18071":104738,"_24599":104739,"_2447":104740},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2937":61447,"_26000":61438,"_5":26336,"_18071":104742,"_24599":104743,"_2447":104744},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2937":61448,"_26000":61438,"_5":26336,"_18071":104746,"_24599":104747,"_2447":104748},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2937":61449,"_26000":61438,"_5":26336,"_18071":104750,"_24599":104751,"_2447":104752},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2937":61450,"_26000":61438,"_18071":104754,"_5":17966,"_24599":61438,"_2447":104755},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2937":61451,"_26000":61438,"_18071":104757,"_5":17966,"_24599":104719,"_2447":104758},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2937":61452,"_26000":61438,"_18071":104760,"_5":17966,"_24599":104723,"_2447":104761},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2937":61453,"_26000":61438,"_18071":104763,"_5":17966,"_24599":104727,"_2447":104764},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2937":61454,"_26000":61438,"_18071":104766,"_5":17966,"_24599":104731,"_2447":104767},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2937":61455,"_26000":61438,"_18071":104769,"_5":17966,"_24599":104735,"_2447":104770},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2937":61456,"_26000":61438,"_18071":104772,"_5":17966,"_24599":104735,"_2447":104773},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2937":61457,"_26000":61438,"_18071":104775,"_5":17966,"_24599":104735,"_2447":104776},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2937":61458,"_26000":61438,"_18071":104778,"_5":17966,"_24599":104735,"_2447":104779},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2937":61459,"_26000":61438,"_18071":104781,"_5":17966,"_24599":104735,"_2447":104782},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2937":61460,"_26000":61438,"_18071":104784,"_5":17966,"_24599":104735,"_2447":104785},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2937":61461,"_26000":61438,"_18071":104787,"_5":17966,"_24599":104739,"_2447":104788},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2937":61462,"_26000":61438,"_18071":104790,"_5":17966,"_24599":104739,"_2447":104791},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2937":61463,"_26000":61438,"_18071":104793,"_5":17966,"_24599":104739,"_2447":104794},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2937":61464,"_26000":61438,"_18071":104796,"_5":17966,"_24599":104739,"_2447":104797},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2937":61465,"_26000":61438,"_18071":104799,"_5":17966,"_24599":104739,"_2447":104800},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2937":61466,"_26000":61438,"_18071":104802,"_5":17966,"_24599":104743,"_2447":104803},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2937":61467,"_26000":61438,"_18071":104805,"_5":17966,"_24599":104743,"_2447":104806},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2937":61468,"_26000":61438,"_18071":104808,"_5":17966,"_24599":104743,"_2447":104809},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2937":61469,"_26000":61438,"_18071":104811,"_5":17966,"_24599":104743,"_2447":104812},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2937":61470,"_26000":61438,"_18071":104814,"_5":17966,"_24599":104743,"_2447":104815},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2937":61471,"_26000":61438,"_18071":104817,"_5":17966,"_24599":104743,"_2447":104818},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2937":61472,"_26000":61438,"_18071":104820,"_5":17966,"_24599":104743,"_2447":104821},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2937":61473,"_26000":61438,"_18071":104823,"_5":17966,"_24599":104747,"_2447":104824},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2937":61474,"_26000":61438,"_18071":104826,"_5":17966,"_24599":104751,"_2447":104827},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2937":61475,"_26000":61438,"_18071":104829,"_5":17966,"_24599":104751,"_2447":104830},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2937":61476,"_26000":61438,"_18071":104832,"_5":17966,"_24599":104751,"_2447":104833},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2937":61477,"_26000":61438,"_18071":104835,"_5":17966,"_24599":104751,"_2447":104836},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2937":61478,"_26000":61438,"_18071":104838,"_5":17966,"_24599":104751,"_2447":104839},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2937":61479,"_26000":61438,"_18071":104841,"_5":17966,"_24599":104751,"_2447":104842},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2937":61480,"_26000":61438,"_18071":104844,"_5":17966,"_24599":104751,"_2447":104845},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2937":61481,"_26000":61481,"_5":12545,"_2447":104847,"_26339":104848,"_18071":104849,"_24599":61481},"Listas de revocación (CRL)",[42089,100145,47313,104335],[],{"_2937":61482,"_26000":61481,"_18071":104851,"_5":17966,"_24599":61481,"_2447":104852},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2937":61483,"_26000":61481,"_5":26336,"_18071":104854,"_24599":104855,"_2447":104856},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2937":61484,"_26000":61481,"_5":26336,"_18071":104858,"_24599":104859,"_2447":104860},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2937":61485,"_26000":61481,"_5":26336,"_18071":104862,"_24599":104863,"_2447":104864},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2937":61486,"_26000":61481,"_5":26336,"_18071":104866,"_24599":104867,"_2447":104868},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2937":61487,"_26000":61481,"_5":26336,"_18071":104870,"_24599":104871,"_2447":104872},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2937":61488,"_26000":61481,"_5":26336,"_18071":104874,"_24599":104875,"_2447":104876},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2937":61489,"_26000":61481,"_5":26336,"_18071":104878,"_24599":104879,"_2447":104880},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#referencias","Referencias",{"_2937":61490,"_26000":61481,"_18071":104882,"_5":17966,"_24599":61481,"_2447":104883},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2937":61491,"_26000":61481,"_18071":104885,"_5":17966,"_24599":104855,"_2447":104886},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2937":61492,"_26000":61481,"_18071":104888,"_5":17966,"_24599":104855,"_2447":104889},[],"Campo de `crl_options`",{"_2937":61493,"_26000":61481,"_18071":104891,"_5":17966,"_24599":104855,"_2447":101638},[],{"_2937":61494,"_26000":61481,"_18071":104893,"_5":17966,"_24599":104855,"_2447":104894},[],"Valor inicial del backend",{"_2937":61495,"_26000":61481,"_18071":104896,"_5":17966,"_24599":104855,"_2447":48493},[],{"_2937":61496,"_26000":61481,"_18071":104898,"_5":17966,"_24599":104855,"_2447":104899},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2937":61497,"_26000":61481,"_18071":104901,"_5":17966,"_24599":104855,"_2447":104902},[],"7 días.",{"_2937":61498,"_26000":61481,"_18071":104904,"_5":17966,"_24599":104855,"_2447":48502},[],{"_2937":61499,"_26000":61481,"_18071":104906,"_5":17966,"_24599":104855,"_2447":104907},[],"Plazo desde la publicación que activa la renovación programada.",{"_2937":61500,"_26000":61481,"_18071":104909,"_5":17966,"_24599":104855,"_2447":104910},[],"6 días y 23 horas.",{"_2937":61501,"_26000":61481,"_18071":104912,"_5":17966,"_24599":104855,"_2447":48511},[],{"_2937":61502,"_26000":61481,"_18071":104914,"_5":17966,"_24599":104855,"_2447":104915},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2937":61503,"_26000":61481,"_18071":104917,"_5":17966,"_24599":104855,"_2447":48517},[],{"_2937":61504,"_26000":61481,"_18071":104919,"_5":17966,"_24599":104855,"_2447":48520},[],{"_2937":61505,"_26000":61481,"_18071":104921,"_5":17966,"_24599":104855,"_2447":104922},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2937":61506,"_26000":61481,"_18071":104924,"_5":17966,"_24599":104855,"_2447":104925},[],"SKI de la CA.",{"_2937":61507,"_26000":61481,"_18071":104927,"_5":17966,"_24599":104855,"_2447":104928},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2937":61508,"_26000":61481,"_18071":104930,"_5":17966,"_24599":104855,"_2447":104931},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2937":61509,"_26000":61481,"_18071":104933,"_5":17966,"_24599":104859,"_2447":104934},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2937":61510,"_26000":61481,"_18071":104936,"_5":17966,"_24599":104859,"_2447":104937},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2937":61511,"_26000":61481,"_18071":104939,"_5":17966,"_24599":104859,"_2447":104940},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2937":61512,"_26000":61481,"_18071":104942,"_5":17966,"_24599":104863,"_2447":104943},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2937":61513,"_26000":61481,"_18071":104945,"_5":17966,"_24599":104863,"_2447":104946},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2937":61514,"_26000":61481,"_18071":104948,"_5":17966,"_24599":104867,"_2447":104949},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2937":61515,"_26000":61481,"_18071":104951,"_5":17966,"_24599":104867,"_2447":104952},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2937":61516,"_26000":61481,"_18071":104954,"_5":17966,"_24599":104867,"_2447":104955},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2937":61517,"_26000":61481,"_18071":104957,"_5":17966,"_24599":104867,"_2447":104958},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2937":61518,"_26000":61481,"_18071":104960,"_5":17966,"_24599":104867,"_2447":104961},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2937":61519,"_26000":61481,"_18071":104963,"_5":17966,"_24599":104871,"_2447":104964},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2937":61520,"_26000":61481,"_18071":104966,"_5":17966,"_24599":104871,"_2447":101827},[],{"_2937":61521,"_26000":61481,"_18071":104968,"_5":17966,"_24599":104871,"_2447":104969},[],"Path relativo",{"_2937":61522,"_26000":61481,"_18071":104971,"_5":17966,"_24599":104871,"_2447":99936},[],{"_2937":61523,"_26000":61481,"_18071":104973,"_5":17966,"_24599":104871,"_2447":48575},[],{"_2937":61524,"_26000":61481,"_18071":104975,"_5":17966,"_24599":104871,"_2447":48578},[],{"_2937":61525,"_26000":61481,"_18071":104977,"_5":17966,"_24599":104871,"_2447":104978},[],"Consultar `crl_options` y `latest_crl`.",{"_2937":61526,"_26000":61481,"_18071":104980,"_5":17966,"_24599":104871,"_2447":48584},[],{"_2937":61527,"_26000":61481,"_18071":104982,"_5":17966,"_24599":104871,"_2447":48578},[],{"_2937":61528,"_26000":61481,"_18071":104984,"_5":17966,"_24599":104871,"_2447":104985},[],"Sustituir la configuración de CRL.",{"_2937":61529,"_26000":61481,"_18071":104987,"_5":17966,"_24599":104871,"_2447":104988},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2937":61530,"_26000":61481,"_18071":104990,"_5":17966,"_24599":104871,"_2447":104991},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2937":61531,"_26000":61481,"_18071":104993,"_5":17966,"_24599":104875,"_2447":104994},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2937":61532,"_26000":61481,"_18071":104996,"_5":17966,"_24599":104879,"_2447":104997},[],"RFC 5280: perfil X.509 y CRL.",{"_2937":61533,"_26000":61481,"_18071":104999,"_5":17966,"_24599":104879,"_2447":48604},[],{"_2937":61534,"_26000":61481,"_18071":105001,"_5":17966,"_24599":104879,"_2447":48607},[],{"_2937":61535,"_26000":61481,"_18071":105003,"_5":17966,"_24599":104879,"_2447":105004},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2937":61536,"_26000":61481,"_18071":105006,"_5":17966,"_24599":104879,"_2447":105007},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2937":61537,"_26000":61537,"_5":12545,"_2447":105009,"_26339":105010,"_18071":105011,"_24599":61537},"Claves y motores criptográficos",[42089,100145,47313,103720],[],{"_2937":61538,"_26000":61537,"_18071":105013,"_5":17966,"_24599":61537,"_2447":105014},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2937":61539,"_26000":61537,"_5":26336,"_18071":105016,"_24599":105017,"_2447":105018},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2937":61540,"_26000":61537,"_5":26336,"_18071":105020,"_24599":105021,"_2447":105022},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2937":61541,"_26000":61537,"_5":26336,"_18071":105024,"_24599":105025,"_2447":48632},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#file-system",{"_2937":61542,"_26000":61537,"_5":26336,"_18071":105027,"_24599":105028,"_2447":48636},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#hashicorp-vault",{"_2937":61543,"_26000":61537,"_5":26336,"_18071":105030,"_24599":105031,"_2447":48640},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#aws-secrets-manager",{"_2937":61544,"_26000":61537,"_5":26336,"_18071":105033,"_24599":105034,"_2447":48644},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#aws-kms",{"_2937":61545,"_26000":61537,"_5":26336,"_18071":105036,"_24599":105037,"_2447":48648},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#pkcs11",{"_2937":61546,"_26000":61537,"_5":26336,"_18071":105039,"_24599":105040,"_2447":48652},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#azure-key-vault",{"_2937":61547,"_26000":61537,"_5":26336,"_18071":105042,"_24599":105043,"_2447":105044},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2937":61548,"_26000":61537,"_5":26336,"_18071":105046,"_24599":105047,"_2447":105048},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2937":61549,"_26000":61537,"_5":26336,"_18071":105050,"_24599":105051,"_2447":105052},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2937":61550,"_26000":61537,"_5":26336,"_18071":105054,"_24599":105055,"_2447":105056},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2937":61551,"_26000":61537,"_5":26336,"_18071":105058,"_24599":105059,"_2447":105060},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2937":61552,"_26000":61537,"_5":26336,"_18071":105062,"_24599":105063,"_2447":105064},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2937":61553,"_26000":61537,"_5":26336,"_18071":105066,"_24599":105067,"_2447":105068},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2937":61554,"_26000":61537,"_5":26336,"_18071":105070,"_24599":105071,"_2447":48684},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#sign",{"_2937":61555,"_26000":61537,"_5":26336,"_18071":105073,"_24599":105074,"_2447":48688},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#verify",{"_2937":61556,"_26000":61537,"_5":26336,"_18071":105076,"_24599":105077,"_2447":105078},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2937":61557,"_26000":61537,"_5":26336,"_18071":105080,"_24599":105081,"_2447":105082},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2937":61558,"_26000":61537,"_5":26336,"_18071":105084,"_24599":105085,"_2447":105086},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2937":61559,"_26000":61537,"_18071":105088,"_5":17966,"_24599":61537,"_2447":105089},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2937":61560,"_26000":61537,"_18071":105091,"_5":17966,"_24599":61537,"_2447":105092},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2937":61561,"_26000":61537,"_18071":105094,"_5":17966,"_24599":105017,"_2447":105095},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2937":61562,"_26000":61537,"_18071":105097,"_5":17966,"_24599":105017,"_2447":105098},[],"En la práctica, permite:",{"_2937":61563,"_26000":61537,"_18071":105100,"_5":17966,"_24599":105017,"_2447":105101},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2937":61564,"_26000":61537,"_18071":105103,"_5":17966,"_24599":105017,"_2447":105104},[],"Importar claves creadas externamente.",{"_2937":61565,"_26000":61537,"_18071":105106,"_5":17966,"_24599":105017,"_2447":105107},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2937":61566,"_26000":61537,"_18071":105109,"_5":17966,"_24599":105017,"_2447":105110},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2937":61567,"_26000":61537,"_18071":105112,"_5":17966,"_24599":105021,"_2447":105113},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2937":61568,"_26000":61537,"_18071":105115,"_5":17966,"_24599":105021,"_2447":105116},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2937":61569,"_26000":61537,"_18071":105118,"_5":17966,"_24599":105021,"_2447":105119},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2937":61570,"_26000":61537,"_18071":105121,"_5":17966,"_24599":105025,"_2447":105122},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2937":61571,"_26000":61537,"_18071":105124,"_5":17966,"_24599":105028,"_2447":105125},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2937":61572,"_26000":61537,"_18071":105127,"_5":17966,"_24599":105031,"_2447":105128},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2937":61573,"_26000":61537,"_18071":105130,"_5":17966,"_24599":105034,"_2447":105131},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2937":61574,"_26000":61537,"_18071":105133,"_5":17966,"_24599":105037,"_2447":105134},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2937":61575,"_26000":61537,"_18071":105136,"_5":17966,"_24599":105040,"_2447":105137},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2937":61576,"_26000":61537,"_18071":105139,"_5":17966,"_24599":105040,"_2447":105140},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2937":61577,"_26000":61537,"_18071":105142,"_5":17966,"_24599":105040,"_2447":105143},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2937":61578,"_26000":61537,"_18071":105145,"_5":17966,"_24599":105040,"_2447":105146},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2937":61579,"_26000":61537,"_18071":105148,"_5":17966,"_24599":105043,"_2447":105149},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2937":61580,"_26000":61537,"_18071":105151,"_5":17966,"_24599":105043,"_2447":105152},[],"La tabla incluye los siguientes campos:",{"_2937":61581,"_26000":61537,"_18071":105154,"_5":17966,"_24599":105043,"_2447":105155},[],"**Name**: nombre descriptivo de la clave.",{"_2937":61582,"_26000":61537,"_18071":105157,"_5":17966,"_24599":105043,"_2447":105158},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2937":61583,"_26000":61537,"_18071":105160,"_5":17966,"_24599":105043,"_2447":105161},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2937":61584,"_26000":61537,"_18071":105163,"_5":17966,"_24599":105043,"_2447":105164},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2937":61585,"_26000":61537,"_18071":105166,"_5":17966,"_24599":105043,"_2447":105167},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2937":61586,"_26000":61537,"_18071":105169,"_5":17966,"_24599":105043,"_2447":105170},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2937":61587,"_26000":61537,"_18071":105172,"_5":17966,"_24599":105043,"_2447":105173},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2937":61588,"_26000":61537,"_18071":105175,"_5":17966,"_24599":105043,"_2447":105176},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2937":61589,"_26000":61537,"_18071":105178,"_5":17966,"_24599":105043,"_2447":105179},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2937":61590,"_26000":61537,"_18071":105181,"_5":17966,"_24599":105043,"_2447":105182},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2937":61591,"_26000":61537,"_18071":105184,"_5":17966,"_24599":105043,"_2447":105185},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2937":61592,"_26000":61537,"_18071":105187,"_5":17966,"_24599":105043,"_2447":105188},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2937":61593,"_26000":61537,"_18071":105190,"_5":17966,"_24599":105043,"_2447":105191},[],"**Delete Key** para eliminar la clave del sistema.",{"_2937":61594,"_26000":61537,"_18071":105193,"_5":17966,"_24599":105047,"_2447":105194},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2937":61595,"_26000":61537,"_18071":105196,"_5":17966,"_24599":105051,"_2447":105197},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2937":61596,"_26000":61537,"_18071":105199,"_5":17966,"_24599":105051,"_2447":105200},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2937":61597,"_26000":61537,"_18071":105202,"_5":17966,"_24599":105051,"_2447":105203},[],"**Key Name**: nombre único y descriptivo.",{"_2937":61598,"_26000":61537,"_18071":105205,"_5":17966,"_24599":105051,"_2447":105206},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2937":61599,"_26000":61537,"_18071":105208,"_5":17966,"_24599":105051,"_2447":105209},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2937":61600,"_26000":61537,"_18071":105211,"_5":17966,"_24599":105051,"_2447":105212},[],"**Tags**: metadatos para clasificar la clave.",{"_2937":61601,"_26000":61537,"_18071":105214,"_5":17966,"_24599":105051,"_2447":105215},[],"**Metadata**: información adicional para usos avanzados.",{"_2937":61602,"_26000":61537,"_18071":105217,"_5":17966,"_24599":105055,"_2447":105218},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2937":61603,"_26000":61537,"_18071":105220,"_5":17966,"_24599":105055,"_2447":105221},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2937":61604,"_26000":61537,"_18071":105223,"_5":17966,"_24599":105055,"_2447":105224},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2937":61605,"_26000":61537,"_18071":105226,"_5":17966,"_24599":105055,"_2447":105227},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2937":61606,"_26000":61537,"_18071":105229,"_5":17966,"_24599":105055,"_2447":105230},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2937":61607,"_26000":61537,"_18071":105232,"_5":17966,"_24599":105055,"_2447":105233},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2937":61608,"_26000":61537,"_18071":105235,"_5":17966,"_24599":105055,"_2447":105236},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2937":61609,"_26000":61537,"_18071":105238,"_5":17966,"_24599":105055,"_2447":105239},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2937":61610,"_26000":61537,"_18071":105241,"_5":17966,"_24599":105055,"_2447":105242},[],"**Metadata**: información adicional opcional.",{"_2937":61611,"_26000":61537,"_18071":105244,"_5":17966,"_24599":105055,"_2447":105245},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2937":61612,"_26000":61537,"_18071":105247,"_5":17966,"_24599":105055,"_2447":105248},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2937":61613,"_26000":61537,"_18071":105250,"_5":17966,"_24599":105059,"_2447":105251},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2937":61614,"_26000":61537,"_18071":105253,"_5":17966,"_24599":105063,"_2447":105254},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2937":61615,"_26000":61537,"_18071":105256,"_5":17966,"_24599":105063,"_2447":105257},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2937":61616,"_26000":61537,"_18071":105259,"_5":17966,"_24599":105063,"_2447":105260},[],"**Key Name**: nombre descriptivo.",{"_2937":61617,"_26000":61537,"_18071":105262,"_5":17966,"_24599":105063,"_2447":105263},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2937":61618,"_26000":61537,"_18071":105265,"_5":17966,"_24599":105063,"_2447":105266},[],"**Tags**: etiquetas asociadas.",{"_2937":61619,"_26000":61537,"_18071":105268,"_5":17966,"_24599":105063,"_2447":105269},[],"**Aliases**: nombres alternativos.",{"_2937":61620,"_26000":61537,"_18071":105271,"_5":17966,"_24599":105063,"_2447":105272},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2937":61621,"_26000":61537,"_18071":105274,"_5":17966,"_24599":105063,"_2447":105275},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2937":61622,"_26000":61537,"_18071":105277,"_5":17966,"_24599":105063,"_2447":105278},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2937":61623,"_26000":61537,"_18071":105280,"_5":17966,"_24599":105063,"_2447":105281},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2937":61624,"_26000":61537,"_18071":105283,"_5":17966,"_24599":105067,"_2447":105284},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2937":61625,"_26000":61537,"_18071":105286,"_5":17966,"_24599":105067,"_2447":105287},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2937":61626,"_26000":61537,"_18071":105289,"_5":17966,"_24599":105067,"_2447":105290},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2937":61627,"_26000":61537,"_18071":105292,"_5":17966,"_24599":105071,"_2447":105293},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2937":61628,"_26000":61537,"_18071":105295,"_5":17966,"_24599":105071,"_2447":105296},[],"Campos principales:",{"_2937":61629,"_26000":61537,"_18071":105298,"_5":17966,"_24599":105071,"_2447":105299},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2937":61630,"_26000":61537,"_18071":105301,"_5":17966,"_24599":105071,"_2447":105302},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2937":61631,"_26000":61537,"_18071":105304,"_5":17966,"_24599":105071,"_2447":105305},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2937":61632,"_26000":61537,"_18071":105307,"_5":17966,"_24599":105071,"_2447":105308},[],"**Message**: contenido que se va a firmar.",{"_2937":61633,"_26000":61537,"_18071":105310,"_5":17966,"_24599":105071,"_2447":105311},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2937":61634,"_26000":61537,"_18071":105313,"_5":17966,"_24599":105074,"_2447":105314},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2937":61635,"_26000":61537,"_18071":105316,"_5":17966,"_24599":105074,"_2447":105296},[],{"_2937":61636,"_26000":61537,"_18071":105318,"_5":17966,"_24599":105074,"_2447":105319},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2937":61637,"_26000":61537,"_18071":105321,"_5":17966,"_24599":105074,"_2447":105322},[],"**Message Type**: `Raw` o `Digest`.",{"_2937":61638,"_26000":61537,"_18071":105324,"_5":17966,"_24599":105074,"_2447":105325},[],"**Payload Encoding**: codificación del mensaje.",{"_2937":61639,"_26000":61537,"_18071":105327,"_5":17966,"_24599":105074,"_2447":105328},[],"**Message**: mensaje original o hash.",{"_2937":61640,"_26000":61537,"_18071":105330,"_5":17966,"_24599":105074,"_2447":105331},[],"**Signature**: firma que se desea comprobar.",{"_2937":61641,"_26000":61537,"_18071":105333,"_5":17966,"_24599":105074,"_2447":105334},[],"**Result**: indicador del resultado de la validación.",{"_2937":61642,"_26000":61537,"_18071":105336,"_5":17966,"_24599":105077,"_2447":105337},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2937":61643,"_26000":61537,"_18071":105339,"_5":17966,"_24599":105077,"_2447":105340},[],"Este flujo es útil para:",{"_2937":61644,"_26000":61537,"_18071":105342,"_5":17966,"_24599":105077,"_2447":105343},[],"Solicitar certificados a una CA externa.",{"_2937":61645,"_26000":61537,"_18071":105345,"_5":17966,"_24599":105077,"_2447":105346},[],"Renovar una identidad manteniendo la misma clave.",{"_2937":61646,"_26000":61537,"_18071":105348,"_5":17966,"_24599":105077,"_2447":105349},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2937":61647,"_26000":61537,"_18071":105351,"_5":17966,"_24599":105077,"_2447":105352},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2937":61648,"_26000":61537,"_18071":105354,"_5":17966,"_24599":105077,"_2447":105355},[],"**Organization (O)**: organización o empresa.",{"_2937":61649,"_26000":61537,"_18071":105357,"_5":17966,"_24599":105077,"_2447":105358},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2937":61650,"_26000":61537,"_18071":105360,"_5":17966,"_24599":105077,"_2447":105361},[],"**Country (C)**: código de país de dos letras.",{"_2937":61651,"_26000":61537,"_18071":105363,"_5":17966,"_24599":105077,"_2447":105364},[],"**State / Province (ST)**: estado o provincia.",{"_2937":61652,"_26000":61537,"_18071":105366,"_5":17966,"_24599":105077,"_2447":105367},[],"**Locality (L)**: ciudad o localidad.",{"_2937":61653,"_26000":61537,"_18071":105369,"_5":17966,"_24599":105077,"_2447":105370},[],"**Email Address**: correo de contacto.",{"_2937":61654,"_26000":61537,"_18071":105372,"_5":17966,"_24599":105077,"_2447":105373},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2937":61655,"_26000":61537,"_18071":105375,"_5":17966,"_24599":105077,"_2447":105376},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2937":61656,"_26000":61537,"_18071":105378,"_5":17966,"_24599":105081,"_2447":105379},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2937":61657,"_26000":61537,"_18071":105381,"_5":17966,"_24599":105081,"_2447":48996},[],{"_2937":61658,"_26000":61537,"_18071":105383,"_5":17966,"_24599":105085,"_2447":105384},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2937":61659,"_26000":61659,"_5":12545,"_2447":105386,"_26339":105387,"_18071":105388,"_24599":61659},"Validación online con OCSP",[42089,100145,47313,104335],[],{"_2937":61660,"_26000":61659,"_18071":105390,"_5":17966,"_24599":61659,"_2447":105391},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2937":61661,"_26000":61659,"_5":26336,"_18071":105393,"_24599":105394,"_2447":105395},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2937":61662,"_26000":61659,"_5":26336,"_18071":105397,"_24599":105398,"_2447":105399},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2937":61663,"_26000":61659,"_5":26336,"_18071":105401,"_24599":105402,"_2447":105403},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2937":61664,"_26000":61659,"_5":26336,"_18071":105405,"_24599":105406,"_2447":105407},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2937":61665,"_26000":61659,"_5":26336,"_18071":105409,"_24599":105410,"_2447":105411},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2937":61666,"_26000":61659,"_5":26336,"_18071":105413,"_24599":105414,"_2447":104880},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#referencias",{"_2937":61667,"_26000":61659,"_18071":105416,"_5":17966,"_24599":61659,"_2447":105417},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2937":61668,"_26000":61659,"_18071":105419,"_5":17966,"_24599":105394,"_2447":105420},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2937":61669,"_26000":61659,"_18071":105422,"_5":17966,"_24599":105394,"_2447":105423},[],"Estado del registro",{"_2937":61670,"_26000":61659,"_18071":105425,"_5":17966,"_24599":105394,"_2447":105426},[],"Respuesta firmada",{"_2937":61671,"_26000":61659,"_18071":105428,"_5":17966,"_24599":105394,"_2447":46491},[],{"_2937":61672,"_26000":61659,"_18071":105430,"_5":17966,"_24599":105394,"_2447":49046},[],{"_2937":61673,"_26000":61659,"_18071":105432,"_5":17966,"_24599":105394,"_2447":46508},[],{"_2937":61674,"_26000":61659,"_18071":105434,"_5":17966,"_24599":105394,"_2447":105435},[],"`Revoked`, con razón y fecha de revocación.",{"_2937":61675,"_26000":61659,"_18071":105437,"_5":17966,"_24599":105394,"_2447":105438},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2937":61676,"_26000":61659,"_18071":105440,"_5":17966,"_24599":105394,"_2447":105441},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2937":61677,"_26000":61659,"_18071":105443,"_5":17966,"_24599":105394,"_2447":105444},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2937":61678,"_26000":61659,"_18071":105446,"_5":17966,"_24599":105394,"_2447":105447},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2937":61679,"_26000":61659,"_18071":105449,"_5":17966,"_24599":105394,"_2447":105450},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2937":61680,"_26000":61659,"_18071":105452,"_5":17966,"_24599":105398,"_2447":105453},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2937":61681,"_26000":61659,"_18071":105455,"_5":17966,"_24599":105398,"_2447":105456},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2937":61682,"_26000":61659,"_18071":105458,"_5":17966,"_24599":105402,"_2447":105459},[],"El servicio acepta:",{"_2937":61683,"_26000":61659,"_18071":105461,"_5":17966,"_24599":105402,"_2447":101827},[],{"_2937":61684,"_26000":61659,"_18071":105463,"_5":17966,"_24599":105402,"_2447":105464},[],"Ruta del servicio VA",{"_2937":61685,"_26000":61659,"_18071":105466,"_5":17966,"_24599":105402,"_2447":105467},[],"Formato",{"_2937":61686,"_26000":61659,"_18071":105469,"_5":17966,"_24599":105402,"_2447":49086},[],{"_2937":61687,"_26000":61659,"_18071":105471,"_5":17966,"_24599":105402,"_2447":49089},[],{"_2937":61688,"_26000":61659,"_18071":105473,"_5":17966,"_24599":105402,"_2447":105474},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2937":61689,"_26000":61659,"_18071":105476,"_5":17966,"_24599":105402,"_2447":48575},[],{"_2937":61690,"_26000":61659,"_18071":105478,"_5":17966,"_24599":105402,"_2447":49097},[],{"_2937":61691,"_26000":61659,"_18071":105480,"_5":17966,"_24599":105402,"_2447":105481},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2937":61692,"_26000":61659,"_18071":105483,"_5":17966,"_24599":105402,"_2447":105484},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2937":61693,"_26000":61659,"_18071":105486,"_5":17966,"_24599":105406,"_2447":105487},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2937":61694,"_26000":61659,"_18071":105489,"_5":17966,"_24599":105406,"_2447":105490},[],"Genera la solicitud:",{"_2937":61695,"_26000":61659,"_18071":105492,"_5":17966,"_24599":105406,"_2447":105493},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2937":61696,"_26000":61659,"_18071":105495,"_5":17966,"_24599":105406,"_2447":105496},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2937":61697,"_26000":61659,"_18071":105498,"_5":17966,"_24599":105406,"_2447":105499},[],"Verifica el DER recibido:",{"_2937":61698,"_26000":61659,"_18071":105501,"_5":17966,"_24599":105406,"_2447":105502},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2937":61699,"_26000":61659,"_18071":105504,"_5":17966,"_24599":105410,"_2447":105505},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2937":61700,"_26000":61659,"_18071":105507,"_5":17966,"_24599":105410,"_2447":105508},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2937":61701,"_26000":61659,"_18071":105510,"_5":17966,"_24599":105414,"_2447":49130},[],{"_2937":61702,"_26000":61659,"_18071":105512,"_5":17966,"_24599":105414,"_2447":49133},[],{"_2937":61703,"_26000":61659,"_18071":105514,"_5":17966,"_24599":105414,"_2447":105515},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2937":61704,"_26000":61659,"_18071":105517,"_5":17966,"_24599":105414,"_2447":105007},[],{"_2937":61705,"_26000":61705,"_5":12545,"_2447":47313,"_26339":105519,"_18071":105520,"_24599":61705},[42089,100145,47313],[],{"_2937":61706,"_26000":61705,"_18071":105522,"_5":17966,"_24599":61705,"_2447":105523},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2937":61707,"_26000":61705,"_5":26336,"_18071":105525,"_24599":105526,"_2447":103044},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#empieza-aquí",{"_2937":61708,"_26000":61705,"_5":26336,"_18071":105528,"_24599":105529,"_2447":105530},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2937":61709,"_26000":61705,"_5":26336,"_18071":105532,"_24599":105533,"_2447":103566},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#capacidades-principales",{"_2937":61710,"_26000":61705,"_5":26336,"_18071":105535,"_24599":105536,"_2447":103570},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2937":61711,"_26000":61705,"_5":26336,"_18071":105538,"_24599":105539,"_2447":103574},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2937":61712,"_26000":61705,"_5":26336,"_18071":105541,"_24599":105542,"_2447":103578},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#emite-y-controla-certificados",{"_2937":61713,"_26000":61705,"_5":26336,"_18071":105544,"_24599":105545,"_2447":103586},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#publica-el-estado-de-validación",{"_2937":61714,"_26000":61705,"_5":26336,"_18071":105547,"_24599":105548,"_2447":105549},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2937":61715,"_26000":61705,"_5":26336,"_18071":105551,"_24599":105552,"_2447":104501},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#continúa",{"_2937":61716,"_26000":61705,"_18071":105554,"_5":17966,"_24599":61705,"_2447":105555},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2937":61717,"_26000":61705,"_18071":105557,"_5":17966,"_24599":105526,"_2447":105558},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2937":61718,"_26000":61705,"_18071":105560,"_5":17966,"_24599":105526,"_2447":105561},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2937":61719,"_26000":61705,"_18071":105563,"_5":17966,"_24599":105529,"_2447":105564},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2937":61720,"_26000":61705,"_18071":105566,"_5":17966,"_24599":105529,"_2447":105567},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2937":61721,"_26000":61705,"_18071":105569,"_5":17966,"_24599":105529,"_2447":105570},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2937":61722,"_26000":61705,"_18071":105572,"_5":17966,"_24599":105529,"_2447":105573},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2937":61723,"_26000":61705,"_18071":105575,"_5":17966,"_24599":105529,"_2447":105576},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2937":61724,"_26000":61705,"_18071":105578,"_5":17966,"_24599":105536,"_2447":105579},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2937":61725,"_26000":61705,"_18071":105581,"_5":17966,"_24599":105539,"_2447":105582},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2937":61726,"_26000":61705,"_18071":105584,"_5":17966,"_24599":105542,"_2447":105585},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2937":61727,"_26000":61705,"_18071":105587,"_5":17966,"_24599":105545,"_2447":105588},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2937":61728,"_26000":61705,"_18071":105590,"_5":17966,"_24599":105548,"_2447":105591},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2937":61729,"_26000":61705,"_18071":105593,"_5":17966,"_24599":105548,"_2447":105594},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2937":61730,"_26000":61705,"_18071":105596,"_5":17966,"_24599":105548,"_2447":105597},[],"su clave pública corresponda a la clave privada del cliente;",{"_2937":61731,"_26000":61705,"_18071":105599,"_5":17966,"_24599":105548,"_2447":105600},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2937":61732,"_26000":61705,"_18071":105602,"_5":17966,"_24599":105548,"_2447":105603},[],"sus fechas y usos permitan la operación;",{"_2937":61733,"_26000":61705,"_18071":105605,"_5":17966,"_24599":105548,"_2447":105606},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2937":61734,"_26000":61705,"_18071":105608,"_5":17966,"_24599":105548,"_2447":105609},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2937":61735,"_26000":61705,"_18071":105611,"_5":17966,"_24599":105552,"_2447":105612},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2937":61736,"_26000":61705,"_18071":105614,"_5":17966,"_24599":105552,"_2447":105615},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2937":61737,"_26000":61705,"_18071":105617,"_5":17966,"_24599":105552,"_2447":105618},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2937":61738,"_26000":61738,"_5":12545,"_2447":105620,"_26339":105621,"_18071":105622,"_24599":61738},"Crea tu primera CA",[42089,100145,47313,103168],[],{"_2937":61739,"_26000":61738,"_18071":105624,"_5":17966,"_24599":61738,"_2447":105625},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2937":61740,"_26000":61738,"_5":26336,"_18071":105627,"_24599":105628,"_2447":98644},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2937":61741,"_26000":61738,"_5":26336,"_18071":105630,"_24599":105631,"_2447":105632},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2937":61742,"_26000":61738,"_5":26336,"_18071":105634,"_24599":105635,"_2447":105636},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2937":61743,"_26000":61738,"_5":26336,"_18071":105638,"_24599":105639,"_2447":105640},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2937":61744,"_26000":61738,"_5":26336,"_18071":105642,"_24599":105643,"_2447":105644},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2937":61745,"_26000":61738,"_5":26336,"_18071":105646,"_24599":105647,"_2447":105648},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2937":61746,"_26000":61738,"_5":26336,"_18071":105650,"_24599":105651,"_2447":105652},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2937":61747,"_26000":61738,"_5":26336,"_18071":105654,"_24599":105655,"_2447":103416},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2937":61748,"_26000":61738,"_5":26336,"_18071":105657,"_24599":105658,"_2447":98668},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2937":61749,"_26000":61738,"_18071":105660,"_5":17966,"_24599":61738,"_2447":105661},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2937":61750,"_26000":61738,"_18071":105663,"_5":17966,"_24599":105628,"_2447":105664},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2937":61751,"_26000":61738,"_18071":105666,"_5":17966,"_24599":105628,"_2447":105667},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2937":61752,"_26000":61738,"_18071":105669,"_5":17966,"_24599":105628,"_2447":105670},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2937":61753,"_26000":61738,"_18071":105672,"_5":17966,"_24599":105628,"_2447":105673},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2937":61754,"_26000":61738,"_18071":105675,"_5":17966,"_24599":105631,"_2447":105676},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2937":61755,"_26000":61738,"_18071":105678,"_5":17966,"_24599":105631,"_2447":105679},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2937":61756,"_26000":61738,"_18071":105681,"_5":17966,"_24599":105635,"_2447":105682},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2937":61757,"_26000":61738,"_18071":105684,"_5":17966,"_24599":105635,"_2447":105685},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2937":61758,"_26000":61738,"_18071":105687,"_5":17966,"_24599":105639,"_2447":105688},[],"Selecciona **Root CA** y completa:",{"_2937":61759,"_26000":61738,"_18071":105690,"_5":17966,"_24599":105639,"_2447":49312},[],{"_2937":61760,"_26000":61738,"_18071":105692,"_5":17966,"_24599":105639,"_2447":105693},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2937":61761,"_26000":61738,"_18071":105695,"_5":17966,"_24599":105639,"_2447":105696},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2937":61762,"_26000":61738,"_18071":105698,"_5":17966,"_24599":105639,"_2447":105699},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2937":61763,"_26000":61738,"_18071":105701,"_5":17966,"_24599":105639,"_2447":105702},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2937":61764,"_26000":61738,"_18071":105704,"_5":17966,"_24599":105643,"_2447":105705},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2937":61765,"_26000":61738,"_18071":105707,"_5":17966,"_24599":105647,"_2447":105708},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2937":61766,"_26000":61738,"_18071":105710,"_5":17966,"_24599":105647,"_2447":105711},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2937":61767,"_26000":61738,"_18071":105713,"_5":17966,"_24599":105651,"_2447":105714},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2937":61768,"_26000":61738,"_18071":105716,"_5":17966,"_24599":105651,"_2447":105717},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2937":61769,"_26000":61738,"_18071":105719,"_5":17966,"_24599":105651,"_2447":105720},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2937":61770,"_26000":61738,"_18071":105722,"_5":17966,"_24599":105655,"_2447":105723},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2937":61771,"_26000":61738,"_18071":105725,"_5":17966,"_24599":105655,"_2447":105726},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2937":61772,"_26000":61738,"_18071":105728,"_5":17966,"_24599":105655,"_2447":105729},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2937":61773,"_26000":61738,"_18071":105731,"_5":17966,"_24599":105655,"_2447":105732},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2937":61774,"_26000":61738,"_18071":105734,"_5":17966,"_24599":105658,"_2447":105735},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2937":61775,"_26000":61775,"_5":12545,"_2447":105737,"_26339":105738,"_18071":105739,"_24599":61775},"Emite y verifica un certificado",[42089,100145,47313,103168],[],{"_2937":61776,"_26000":61775,"_18071":105741,"_5":17966,"_24599":61775,"_2447":105742},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2937":61777,"_26000":61775,"_5":26336,"_18071":105744,"_24599":105745,"_2447":98644},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2937":61778,"_26000":61775,"_5":26336,"_18071":105747,"_24599":105748,"_2447":105749},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2937":61779,"_26000":61775,"_5":26336,"_18071":105751,"_24599":105752,"_2447":105753},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2937":61780,"_26000":61775,"_5":26336,"_18071":105755,"_24599":105756,"_2447":105757},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2937":61781,"_26000":61775,"_5":26336,"_18071":105759,"_24599":105760,"_2447":105761},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2937":61782,"_26000":61775,"_5":26336,"_18071":105763,"_24599":105764,"_2447":105765},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2937":61783,"_26000":61775,"_5":26336,"_18071":105767,"_24599":105768,"_2447":105648},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2937":61784,"_26000":61775,"_5":26336,"_18071":105770,"_24599":105771,"_2447":105772},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2937":61785,"_26000":61775,"_5":26336,"_18071":105774,"_24599":105775,"_2447":105776},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2937":61786,"_26000":61775,"_5":26336,"_18071":105778,"_24599":105779,"_2447":105780},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2937":61787,"_26000":61775,"_5":26336,"_18071":105782,"_24599":105783,"_2447":103416},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2937":61788,"_26000":61775,"_5":26336,"_18071":105785,"_24599":105786,"_2447":98668},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2937":61789,"_26000":61775,"_18071":105788,"_5":17966,"_24599":61775,"_2447":105789},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2937":61790,"_26000":61775,"_18071":105791,"_5":17966,"_24599":105745,"_2447":105792},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2937":61791,"_26000":61775,"_18071":105794,"_5":17966,"_24599":105745,"_2447":105795},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2937":61792,"_26000":61775,"_18071":105797,"_5":17966,"_24599":105745,"_2447":105798},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2937":61793,"_26000":61775,"_18071":105800,"_5":17966,"_24599":105745,"_2447":105801},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2937":61794,"_26000":61775,"_18071":105803,"_5":17966,"_24599":105745,"_2447":105804},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2937":61795,"_26000":61775,"_18071":105806,"_5":17966,"_24599":105748,"_2447":105807},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2937":61796,"_26000":61775,"_18071":105809,"_5":17966,"_24599":105752,"_2447":105810},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2937":61797,"_26000":61775,"_18071":105812,"_5":17966,"_24599":105752,"_2447":105813},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2937":61798,"_26000":61775,"_18071":105815,"_5":17966,"_24599":105756,"_2447":105816},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2937":61799,"_26000":61775,"_18071":105818,"_5":17966,"_24599":105756,"_2447":105819},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2937":61800,"_26000":61775,"_18071":105821,"_5":17966,"_24599":105760,"_2447":105822},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2937":61801,"_26000":61775,"_18071":105824,"_5":17966,"_24599":105760,"_2447":105825},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2937":61802,"_26000":61775,"_18071":105827,"_5":17966,"_24599":105764,"_2447":105828},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2937":61803,"_26000":61775,"_18071":105830,"_5":17966,"_24599":105768,"_2447":105831},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2937":61804,"_26000":61775,"_18071":105833,"_5":17966,"_24599":105771,"_2447":105834},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2937":61805,"_26000":61775,"_18071":105836,"_5":17966,"_24599":105775,"_2447":105837},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2937":61806,"_26000":61775,"_18071":105839,"_5":17966,"_24599":105775,"_2447":105840},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2937":61807,"_26000":61775,"_18071":105842,"_5":17966,"_24599":105775,"_2447":105843},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2937":61808,"_26000":61775,"_18071":105845,"_5":17966,"_24599":105779,"_2447":105846},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2937":61809,"_26000":61775,"_18071":105848,"_5":17966,"_24599":105779,"_2447":105849},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2937":61810,"_26000":61775,"_18071":105851,"_5":17966,"_24599":105779,"_2447":105852},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2937":61811,"_26000":61775,"_18071":105854,"_5":17966,"_24599":105783,"_2447":103499},[],{"_2937":61812,"_26000":61775,"_18071":105856,"_5":17966,"_24599":105783,"_2447":102276},[],{"_2937":61813,"_26000":61775,"_18071":105858,"_5":17966,"_24599":105783,"_2447":105859},[],"La CA rechaza la emisión",{"_2937":61814,"_26000":61775,"_18071":105861,"_5":17966,"_24599":105783,"_2447":105862},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2937":61815,"_26000":61775,"_18071":105864,"_5":17966,"_24599":105783,"_2447":105865},[],"Sujeto o usos diferentes",{"_2937":61816,"_26000":61775,"_18071":105867,"_5":17966,"_24599":105783,"_2447":105868},[],"Perfil aplicado y valores solicitados.",{"_2937":61817,"_26000":61775,"_18071":105870,"_5":17966,"_24599":105783,"_2447":105871},[],"No se encuentra el emisor",{"_2937":61818,"_26000":61775,"_18071":105873,"_5":17966,"_24599":105783,"_2447":105874},[],"CA descargada y cadena intermedia necesaria.",{"_2937":61819,"_26000":61775,"_18071":105876,"_5":17966,"_24599":105783,"_2447":105877},[],"Falla la vigencia",{"_2937":61820,"_26000":61775,"_18071":105879,"_5":17966,"_24599":105783,"_2447":105880},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2937":61821,"_26000":61775,"_18071":105882,"_5":17966,"_24599":105783,"_2447":105883},[],"Los resúmenes de clave difieren",{"_2937":61822,"_26000":61775,"_18071":105885,"_5":17966,"_24599":105783,"_2447":105886},[],"Archivos de certificado y clave de la misma emisión.",{"_2937":61823,"_26000":61775,"_18071":105888,"_5":17966,"_24599":105783,"_2447":105889},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2937":61824,"_26000":61775,"_18071":105891,"_5":17966,"_24599":105786,"_2447":105892},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2937":61825,"_26000":61775,"_18071":105894,"_5":17966,"_24599":105786,"_2447":105895},[],"Gestionar certificados para inspección, estado y revocación.",{"_2937":61826,"_26000":61775,"_18071":105897,"_5":17966,"_24599":105786,"_2447":105898},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2937":61827,"_26000":61775,"_18071":105900,"_5":17966,"_24599":105786,"_2447":105901},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2937":61828,"_26000":61775,"_18071":105903,"_5":17966,"_24599":105786,"_2447":105904},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2937":61829,"_26000":61829,"_5":12545,"_2447":105906,"_26339":105907,"_18071":105908,"_24599":61829},"Primeros pasos de PKI",[42089,100145,47313,103168],[],{"_2937":61830,"_26000":61829,"_18071":105910,"_5":17966,"_24599":61829,"_2447":105911},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2937":61831,"_26000":61829,"_5":26336,"_18071":105913,"_24599":105914,"_2447":98644},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2937":61832,"_26000":61829,"_5":26336,"_18071":105916,"_24599":105917,"_2447":105918},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2937":61833,"_26000":61829,"_5":26336,"_18071":105920,"_24599":105921,"_2447":103350},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2937":61834,"_26000":61829,"_5":26336,"_18071":105923,"_24599":105924,"_2447":105925},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2937":61835,"_26000":61829,"_18071":105927,"_5":17966,"_24599":61829,"_2447":105928},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2937":61836,"_26000":61829,"_18071":105930,"_5":17966,"_24599":105914,"_2447":105931},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2937":61837,"_26000":61829,"_18071":105933,"_5":17966,"_24599":105914,"_2447":105934},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2937":61838,"_26000":61829,"_18071":105936,"_5":17966,"_24599":105914,"_2447":105937},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2937":61839,"_26000":61829,"_18071":105939,"_5":17966,"_24599":105914,"_2447":105940},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2937":61840,"_26000":61829,"_18071":105942,"_5":17966,"_24599":105914,"_2447":105943},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2937":61841,"_26000":61829,"_18071":105945,"_5":17966,"_24599":105917,"_2447":105946},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2937":61842,"_26000":61829,"_18071":105948,"_5":17966,"_24599":105917,"_2447":105949},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2937":61843,"_26000":61829,"_18071":105951,"_5":17966,"_24599":105917,"_2447":105952},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2937":61844,"_26000":61829,"_18071":105954,"_5":17966,"_24599":105917,"_2447":105955},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2937":61845,"_26000":61829,"_18071":105957,"_5":17966,"_24599":105921,"_2447":105958},[],"Archivo o recurso",{"_2937":61846,"_26000":61829,"_18071":105960,"_5":17966,"_24599":105921,"_2447":103347},[],{"_2937":61847,"_26000":61829,"_18071":105962,"_5":17966,"_24599":105921,"_2447":105963},[],"CA raíz activa y `ca.pem`",{"_2937":61848,"_26000":61829,"_18071":105965,"_5":17966,"_24599":105921,"_2447":105966},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2937":61849,"_26000":61829,"_18071":105968,"_5":17966,"_24599":105921,"_2447":105969},[],"Certificado final y `device.crt`",{"_2937":61850,"_26000":61829,"_18071":105971,"_5":17966,"_24599":105921,"_2447":105972},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2937":61851,"_26000":61829,"_18071":105974,"_5":17966,"_24599":105921,"_2447":105975},[],"Clave privada `device.key`",{"_2937":61852,"_26000":61829,"_18071":105977,"_5":17966,"_24599":105921,"_2447":105978},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2937":61853,"_26000":61829,"_18071":105980,"_5":17966,"_24599":105921,"_2447":105981},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2937":61854,"_26000":61829,"_18071":105983,"_5":17966,"_24599":105924,"_2447":105984},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2937":61855,"_26000":61829,"_18071":105986,"_5":17966,"_24599":105924,"_2447":105987},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2937":61856,"_26000":61829,"_18071":105989,"_5":17966,"_24599":105924,"_2447":105990},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2937":61857,"_26000":61857,"_5":12545,"_2447":105992,"_26339":105993,"_18071":105994,"_24599":61857},"Resolución de problemas PKI",[42089,100145,47313,99373],[],{"_2937":61858,"_26000":61857,"_18071":105996,"_5":17966,"_24599":61857,"_2447":105997},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2937":61859,"_26000":61857,"_5":26336,"_18071":105999,"_24599":106000,"_2447":106001},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2937":61860,"_26000":61857,"_5":26336,"_18071":106003,"_24599":106004,"_2447":106005},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2937":61861,"_26000":61857,"_5":26336,"_18071":106007,"_24599":106008,"_2447":106009},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2937":61862,"_26000":61857,"_18071":106011,"_5":17966,"_24599":61857,"_2447":106012},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2937":61863,"_26000":61857,"_18071":106014,"_5":17966,"_24599":61857,"_2447":106015},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2937":61864,"_26000":61857,"_18071":106017,"_5":17966,"_24599":106000,"_2447":103347},[],{"_2937":61865,"_26000":61857,"_18071":106019,"_5":17966,"_24599":106000,"_2447":102276},[],{"_2937":61866,"_26000":61857,"_18071":106021,"_5":17966,"_24599":106000,"_2447":98668},[],{"_2937":61867,"_26000":61857,"_18071":106023,"_5":17966,"_24599":106000,"_2447":49648},[],{"_2937":61868,"_26000":61857,"_18071":106025,"_5":17966,"_24599":106000,"_2447":106026},[],"Existe, está activa y sus fechas son utilizables.",{"_2937":61869,"_26000":61857,"_18071":106028,"_5":17966,"_24599":106000,"_2447":106029},[],"Autoridades.",{"_2937":61870,"_26000":61857,"_18071":106031,"_5":17966,"_24599":106000,"_2447":106032},[],"Clave",{"_2937":61871,"_26000":61857,"_18071":106034,"_5":17966,"_24599":106000,"_2447":106035},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2937":61872,"_26000":61857,"_18071":106037,"_5":17966,"_24599":106000,"_2447":106038},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2937":61873,"_26000":61857,"_18071":106040,"_5":17966,"_24599":106000,"_2447":49666},[],{"_2937":61874,"_26000":61857,"_18071":106042,"_5":17966,"_24599":106000,"_2447":106043},[],"PEM correcto y firma verificable.",{"_2937":61875,"_26000":61857,"_18071":106045,"_5":17966,"_24599":106000,"_2447":49672},[],{"_2937":61876,"_26000":61857,"_18071":106047,"_5":17966,"_24599":106000,"_2447":106048},[],"Perfil",{"_2937":61877,"_26000":61857,"_18071":106050,"_5":17966,"_24599":106000,"_2447":106051},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2937":61878,"_26000":61857,"_18071":106053,"_5":17966,"_24599":106000,"_2447":106054},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2937":61879,"_26000":61857,"_18071":106056,"_5":17966,"_24599":106000,"_2447":103499},[],{"_2937":61880,"_26000":61857,"_18071":106058,"_5":17966,"_24599":106000,"_2447":106059},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2937":61881,"_26000":61857,"_18071":106061,"_5":17966,"_24599":106000,"_2447":106062},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2937":61882,"_26000":61857,"_18071":106064,"_5":17966,"_24599":106000,"_2447":106065},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2937":61883,"_26000":61857,"_18071":106067,"_5":17966,"_24599":106000,"_2447":106068},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2937":61884,"_26000":61857,"_18071":106070,"_5":17966,"_24599":106004,"_2447":106071},[],"Revisa cada frontera por separado:",{"_2937":61885,"_26000":61857,"_18071":106073,"_5":17966,"_24599":106004,"_2447":106074},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2937":61886,"_26000":61857,"_18071":106076,"_5":17966,"_24599":106004,"_2447":106077},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2937":61887,"_26000":61857,"_18071":106079,"_5":17966,"_24599":106004,"_2447":106080},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2937":61888,"_26000":61857,"_18071":106082,"_5":17966,"_24599":106004,"_2447":106083},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2937":61889,"_26000":61857,"_18071":106085,"_5":17966,"_24599":106004,"_2447":106086},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2937":61890,"_26000":61857,"_18071":106088,"_5":17966,"_24599":106004,"_2447":106089},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2937":61891,"_26000":61857,"_18071":106091,"_5":17966,"_24599":106008,"_2447":106092},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2937":61892,"_26000":61857,"_18071":106094,"_5":17966,"_24599":106008,"_2447":106095},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_49726":106097,"_49728":106098,"_49730":106099,"_49732":106100,"_15733":2469,"_59459":2469},"spanish",[2447,26000,5,24599],{"_2447":21633,"_26000":21633,"_5":21633,"_24599":21