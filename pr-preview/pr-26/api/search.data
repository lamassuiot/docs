4,"_19171":44949,"_26134":44950,"_2648":44951},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3150":20,"_27624":15,"_5":27964,"_19171":44953,"_26134":44954,"_2648":44955},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3150":21,"_27624":15,"_5":27964,"_19171":44957,"_26134":44958,"_2648":44959},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3150":22,"_27624":15,"_5":27964,"_19171":44961,"_26134":44962,"_2648":44963},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3150":23,"_27624":15,"_5":27964,"_19171":44965,"_26134":44966,"_2648":44967},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#next-step","Next step",{"_3150":24,"_27624":15,"_19171":44969,"_5":13189,"_26134":15,"_2648":44970},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3150":25,"_27624":15,"_19171":44972,"_5":13189,"_26134":44942,"_2648":44973},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3150":26,"_27624":15,"_19171":44975,"_5":13189,"_26134":44942,"_2648":44976},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3150":27,"_27624":15,"_19171":44978,"_5":13189,"_26134":44942,"_2648":44979},[],"A security group allowing the necessary endpoints.",{"_3150":28,"_27624":15,"_19171":44981,"_5":13189,"_26134":44946,"_2648":44982},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3150":29,"_27624":15,"_19171":44984,"_5":13189,"_26134":44946,"_2648":44985},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3150":30,"_27624":15,"_19171":44987,"_5":13189,"_26134":44946,"_2648":44988},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3150":31,"_27624":15,"_19171":44990,"_5":13189,"_26134":44950,"_2648":44991},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3150":32,"_27624":15,"_19171":44993,"_5":13189,"_26134":44954,"_2648":44994},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3150":33,"_27624":15,"_19171":44996,"_5":13189,"_26134":44958,"_2648":44997},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3150":34,"_27624":15,"_19171":44999,"_5":13189,"_26134":44962,"_2648":45000},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3150":35,"_27624":15,"_19171":45002,"_5":13189,"_26134":44966,"_2648":45003},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3150":36,"_27624":36,"_5":13515,"_2648":45005,"_27967":45006,"_19171":45007,"_26134":36},"Deploy Lamassu",[44933,44934],[],{"_3150":37,"_27624":36,"_19171":45009,"_5":13189,"_26134":36,"_2648":45010},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3150":38,"_27624":36,"_5":27964,"_19171":45012,"_26134":45013,"_2648":45014},[],"/docs/pr-preview/pr-26/deployment/overview#choose-a-model","Choose a model",{"_3150":39,"_27624":36,"_5":27964,"_19171":45016,"_26134":45017,"_2648":45018},[],"/docs/pr-preview/pr-26/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3150":40,"_27624":36,"_5":27964,"_19171":45020,"_26134":45021,"_2648":45022},[],"/docs/pr-preview/pr-26/deployment/overview#after-deployment","After deployment",{"_3150":41,"_27624":36,"_19171":45024,"_5":13189,"_26134":36,"_2648":45025},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3150":42,"_27624":36,"_19171":45027,"_5":13189,"_26134":45013,"_2648":45028},[],"Model",{"_3150":43,"_27624":36,"_19171":45030,"_5":13189,"_26134":45013,"_2648":45031},[],"Recommended for",{"_3150":44,"_27624":36,"_19171":45033,"_5":13189,"_26134":45013,"_2648":45034},[],"Who operates the infrastructure",{"_3150":45,"_27624":36,"_19171":45036,"_5":13189,"_26134":45013,"_2648":45037},[],"Starting point",{"_3150":46,"_27624":36,"_19171":45039,"_5":13189,"_26134":45013,"_2648":45040},[],"Kubernetes self-managed",{"_3150":47,"_27624":36,"_19171":45042,"_5":13189,"_26134":45013,"_2648":45043},[],"Production, regulated environments and custom deployments",{"_3150":48,"_27624":36,"_19171":45045,"_5":13189,"_26134":45013,"_2648":45046},[],"Your team",{"_3150":49,"_27624":36,"_19171":45048,"_5":13189,"_26134":45013,"_2648":45049},[],"Helm or Fastlane",{"_3150":50,"_27624":36,"_19171":45051,"_5":13189,"_26134":45013,"_2648":45052},[],"AWS Marketplace",{"_3150":51,"_27624":36,"_19171":45054,"_5":13189,"_26134":45013,"_2648":45055},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3150":52,"_27624":36,"_19171":45057,"_5":13189,"_26134":45013,"_2648":45046},[],{"_3150":53,"_27624":36,"_19171":45059,"_5":13189,"_26134":45013,"_2648":45060},[],"Preconfigured image on EC2",{"_3150":54,"_27624":36,"_19171":45062,"_5":13189,"_26134":45013,"_2648":45063},[],"SaaS",{"_3150":55,"_27624":36,"_19171":45065,"_5":13189,"_26134":45013,"_2648":45066},[],"Teams that want to use the platform without operating it",{"_3150":56,"_27624":36,"_19171":45068,"_5":13189,"_26134":45013,"_2648":45069},[],"Lamassu",{"_3150":57,"_27624":36,"_19171":45071,"_5":13189,"_26134":45013,"_2648":45072},[],"Managed subscription",{"_3150":58,"_27624":36,"_19171":45074,"_5":13189,"_26134":45013,"_2648":45075},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3150":59,"_27624":36,"_19171":45077,"_5":13189,"_26134":45013,"_2648":45078},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3150":60,"_27624":36,"_19171":45080,"_5":13189,"_26134":45013,"_2648":45081},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3150":61,"_27624":36,"_19171":45083,"_5":13189,"_26134":45017,"_2648":45084},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3150":62,"_27624":36,"_19171":45086,"_5":13189,"_26134":45021,"_2648":45087},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3150":63,"_27624":63,"_5":13515,"_2648":45089,"_27967":45090,"_19171":45091,"_26134":63},"Use Lamassu as SaaS",[44933,44934,44935],[],{"_3150":64,"_27624":63,"_19171":45093,"_5":13189,"_26134":63,"_2648":45094},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3150":65,"_27624":63,"_5":27964,"_19171":45096,"_26134":45097,"_2648":45098},[],"/docs/pr-preview/pr-26/deployment/saas#what-the-service-manages","What the service manages",{"_3150":66,"_27624":63,"_5":27964,"_19171":45100,"_26134":45101,"_2648":45102},[],"/docs/pr-preview/pr-26/deployment/saas#plans","Plans",{"_3150":67,"_27624":63,"_5":27964,"_19171":45104,"_26134":45105,"_2648":45106},[],"/docs/pr-preview/pr-26/deployment/saas#request-access","Request access",{"_3150":68,"_27624":63,"_19171":45108,"_5":13189,"_26134":63,"_2648":45109},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3150":69,"_27624":63,"_19171":45111,"_5":13189,"_26134":45097,"_2648":45112},[],"Platform availability and maintenance.",{"_3150":70,"_27624":63,"_19171":45114,"_5":13189,"_26134":45097,"_2648":45115},[],"Automatic backups.",{"_3150":71,"_27624":63,"_19171":45117,"_5":13189,"_26134":45097,"_2648":45118},[],"Version upgrades.",{"_3150":72,"_27624":63,"_19171":45120,"_5":13189,"_26134":45097,"_2648":45121},[],"Technical support and SLA according to your plan.",{"_3150":73,"_27624":63,"_19171":45123,"_5":13189,"_26134":45101,"_2648":45124},[],"Plan",{"_3150":74,"_27624":63,"_19171":45126,"_5":13189,"_26134":45101,"_2648":45127},[],"Devices",{"_3150":75,"_27624":63,"_19171":45129,"_5":13189,"_26134":45101,"_2648":45130},[],"Support",{"_3150":76,"_27624":63,"_19171":45132,"_5":13189,"_26134":45101,"_2648":45133},[],"SLA",{"_3150":77,"_27624":63,"_19171":45135,"_5":13189,"_26134":45101,"_2648":45136},[],"Starter",{"_3150":78,"_27624":63,"_19171":45138,"_5":13189,"_26134":45101,"_2648":45139},[],"Up to 1,000",{"_3150":79,"_27624":63,"_19171":45141,"_5":13189,"_26134":45101,"_2648":45142},[],"Email",{"_3150":80,"_27624":63,"_19171":45144,"_5":13189,"_26134":45101,"_2648":45145},[],"99.5 %",{"_3150":81,"_27624":63,"_19171":45147,"_5":13189,"_26134":45101,"_2648":45148},[],"Professional",{"_3150":82,"_27624":63,"_19171":45150,"_5":13189,"_26134":45101,"_2648":45151},[],"Up to 10,000",{"_3150":83,"_27624":63,"_19171":45153,"_5":13189,"_26134":45101,"_2648":45154},[],"Email and chat",{"_3150":84,"_27624":63,"_19171":45156,"_5":13189,"_26134":45101,"_2648":45157},[],"99.9 %",{"_3150":85,"_27624":63,"_19171":45159,"_5":13189,"_26134":45101,"_2648":45160},[],"Enterprise",{"_3150":86,"_27624":63,"_19171":45162,"_5":13189,"_26134":45101,"_2648":45163},[],"Unlimited",{"_3150":87,"_27624":63,"_19171":45165,"_5":13189,"_26134":45101,"_2648":45166},[],"Dedicated",{"_3150":88,"_27624":63,"_19171":45168,"_5":13189,"_26134":45101,"_2648":45169},[],"99.99 %",{"_3150":89,"_27624":63,"_19171":45171,"_5":13189,"_26134":45105,"_2648":45172},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3150":90,"_27624":63,"_19171":45174,"_5":13189,"_26134":45105,"_2648":45175},[],"When you receive your instance's credentials, continue with Get started.",{"_3150":91,"_27624":91,"_5":13515,"_2648":45177,"_27967":45178,"_19171":45179,"_26134":91},"Fastlane",[44933,44934,45040],[],{"_3150":92,"_27624":91,"_19171":45181,"_5":13189,"_26134":91,"_2648":45182},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3150":93,"_27624":91,"_5":27964,"_19171":45184,"_26134":45185,"_2648":45186},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3150":94,"_27624":91,"_5":27964,"_19171":45188,"_26134":45189,"_2648":45190},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3150":95,"_27624":91,"_5":27964,"_19171":45192,"_26134":45193,"_2648":44943},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#before-you-begin",{"_3150":96,"_27624":91,"_5":27964,"_19171":45195,"_26134":45196,"_2648":45197},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3150":97,"_27624":91,"_5":27964,"_19171":45199,"_26134":45200,"_2648":45201},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3150":98,"_27624":91,"_5":27964,"_19171":45203,"_26134":45204,"_2648":45205},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3150":99,"_27624":91,"_5":27964,"_19171":45207,"_26134":45208,"_2648":45209},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3150":100,"_27624":91,"_5":27964,"_19171":45211,"_26134":45212,"_2648":45213},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3150":101,"_27624":91,"_5":27964,"_19171":45215,"_26134":45216,"_2648":45217},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3150":102,"_27624":91,"_5":27964,"_19171":45219,"_26134":45220,"_2648":45221},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3150":103,"_27624":91,"_5":27964,"_19171":45223,"_26134":45224,"_2648":45225},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3150":104,"_27624":91,"_19171":45227,"_5":13189,"_26134":45185,"_2648":45228},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3150":105,"_27624":91,"_19171":45230,"_5":13189,"_26134":45185,"_2648":45231},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3150":106,"_27624":91,"_19171":45233,"_5":13189,"_26134":45189,"_2648":45234},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3150":107,"_27624":91,"_19171":45236,"_5":13189,"_26134":45189,"_2648":45237},[],"Fastlane installs or configures",{"_3150":108,"_27624":91,"_19171":45239,"_5":13189,"_26134":45189,"_2648":45240},[],"You still provide",{"_3150":109,"_27624":91,"_19171":45242,"_5":13189,"_26134":45189,"_2648":45243},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3150":110,"_27624":91,"_19171":45245,"_5":13189,"_26134":45189,"_2648":45246},[],"The Kubernetes cluster, nodes and persistent storage",{"_3150":111,"_27624":91,"_19171":45248,"_5":13189,"_26134":45189,"_2648":45249},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3150":112,"_27624":91,"_19171":45251,"_5":13189,"_26134":45189,"_2648":45252},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3150":113,"_27624":91,"_19171":45254,"_5":13189,"_26134":45189,"_2648":45255},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3150":114,"_27624":91,"_19171":45257,"_5":13189,"_26134":45189,"_2648":45258},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3150":115,"_27624":91,"_19171":45260,"_5":13189,"_26134":45189,"_2648":45261},[],"Optional observability and lab HSM components",{"_3150":116,"_27624":91,"_19171":45263,"_5":13189,"_26134":45189,"_2648":45264},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3150":117,"_27624":91,"_19171":45266,"_5":13189,"_26134":45189,"_2648":45267},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3150":118,"_27624":91,"_19171":45269,"_5":13189,"_26134":45193,"_2648":45270},[],"You need:",{"_3150":119,"_27624":91,"_19171":45272,"_5":13189,"_26134":45193,"_2648":45273},[],"an existing Kubernetes cluster",{"_3150":120,"_27624":91,"_19171":45275,"_5":13189,"_26134":45193,"_2648":45276},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3150":121,"_27624":91,"_19171":45278,"_5":13189,"_26134":45193,"_2648":45279},[],"`yq`",{"_3150":122,"_27624":91,"_19171":45281,"_5":13189,"_26134":45193,"_2648":21707},[],{"_3150":123,"_27624":91,"_19171":45283,"_5":13189,"_26134":45193,"_2648":45284},[],"`jq` only when using `--sample-data` or `--development`",{"_3150":124,"_27624":91,"_19171":45286,"_5":13189,"_26134":45193,"_2648":45287},[],"`ssh-keygen` only when using `--with-hsm`",{"_3150":125,"_27624":91,"_19171":45289,"_5":13189,"_26134":45193,"_2648":45290},[],"free external ports 80 and 443 on a single-node K3s host",{"_3150":126,"_27624":91,"_19171":45292,"_5":13189,"_26134":45193,"_2648":45293},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3150":127,"_27624":91,"_19171":45295,"_5":13189,"_26134":45193,"_2648":45296},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3150":128,"_27624":91,"_19171":45298,"_5":13189,"_26134":45196,"_2648":45299},[],"Run the script from a clone of the Helm repository:",{"_3150":129,"_27624":91,"_19171":45301,"_5":13189,"_26134":45196,"_2648":45302},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3150":130,"_27624":91,"_19171":45304,"_5":13189,"_26134":45200,"_2648":45305},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3150":131,"_27624":91,"_19171":45307,"_5":13189,"_26134":45200,"_2648":45308},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3150":132,"_27624":91,"_19171":45310,"_5":13189,"_26134":45200,"_2648":45311},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3150":133,"_27624":91,"_19171":45313,"_5":13189,"_26134":45200,"_2648":45314},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3150":134,"_27624":91,"_19171":45316,"_5":13189,"_26134":45204,"_2648":45317},[],"Option",{"_3150":135,"_27624":91,"_19171":45319,"_5":13189,"_26134":45204,"_2648":45320},[],"Default",{"_3150":136,"_27624":91,"_19171":45322,"_5":13189,"_26134":45204,"_2648":45323},[],"Purpose",{"_3150":137,"_27624":91,"_19171":45325,"_5":13189,"_26134":45204,"_2648":45326},[],"`-h`, `--help`",{"_3150":138,"_27624":91,"_19171":45328,"_5":13189,"_26134":45204,"_2648":45329},[],"—",{"_3150":139,"_27624":91,"_19171":45331,"_5":13189,"_26134":45204,"_2648":45332},[],"Show help",{"_3150":140,"_27624":91,"_19171":45334,"_5":13189,"_26134":45204,"_2648":45335},[],"`-c`, `--context`",{"_3150":141,"_27624":91,"_19171":45337,"_5":13189,"_26134":45204,"_2648":45338},[],"current context",{"_3150":142,"_27624":91,"_19171":45340,"_5":13189,"_26134":45204,"_2648":45341},[],"Select the kubeconfig context for kubectl and Helm",{"_3150":143,"_27624":91,"_19171":45343,"_5":13189,"_26134":45204,"_2648":45344},[],"`-n`, `--non-interactive`",{"_3150":144,"_27624":91,"_19171":45346,"_5":13189,"_26134":45204,"_2648":5899},[],{"_3150":145,"_27624":91,"_19171":45348,"_5":13189,"_26134":45204,"_2648":45349},[],"Skip prompts and generate dependency credentials",{"_3150":146,"_27624":91,"_19171":45351,"_5":13189,"_26134":45204,"_2648":45352},[],"`-ns`, `--namespace`",{"_3150":147,"_27624":91,"_19171":45354,"_5":13189,"_26134":45204,"_2648":45355},[],"`lamassu-dev`",{"_3150":148,"_27624":91,"_19171":45357,"_5":13189,"_26134":45204,"_2648":45358},[],"Namespace for the installation",{"_3150":149,"_27624":91,"_19171":45360,"_5":13189,"_26134":45204,"_2648":45361},[],"`-d`, `--domain`",{"_3150":150,"_27624":91,"_19171":45363,"_5":13189,"_26134":45204,"_2648":45364},[],"`dev.lamassu.io`",{"_3150":151,"_27624":91,"_19171":45366,"_5":13189,"_26134":45204,"_2648":45367},[],"Domain used by the UI, OIDC and certificate",{"_3150":152,"_27624":91,"_19171":45369,"_5":13189,"_26134":45204,"_2648":45370},[],"`-v`, `--version`",{"_3150":153,"_27624":91,"_19171":45372,"_5":13189,"_26134":45204,"_2648":13791},[],{"_3150":154,"_27624":91,"_19171":45374,"_5":13189,"_26134":45204,"_2648":45375},[],"Lamassu chart version",{"_3150":155,"_27624":91,"_19171":45377,"_5":13189,"_26134":45204,"_2648":45378},[],"`--https-port`",{"_3150":156,"_27624":91,"_19171":45380,"_5":13189,"_26134":45204,"_2648":45381},[],"`443`",{"_3150":157,"_27624":91,"_19171":45383,"_5":13189,"_26134":45204,"_2648":45384},[],"Gateway HTTPS listener port",{"_3150":158,"_27624":91,"_19171":45386,"_5":13189,"_26134":45204,"_2648":45387},[],"`--http-port`",{"_3150":159,"_27624":91,"_19171":45389,"_5":13189,"_26134":45204,"_2648":45390},[],"`80`",{"_3150":160,"_27624":91,"_19171":45392,"_5":13189,"_26134":45204,"_2648":45393},[],"Gateway HTTP listener port",{"_3150":161,"_27624":91,"_19171":45395,"_5":13189,"_26134":45204,"_2648":45396},[],"`--tls-crt`",{"_3150":162,"_27624":91,"_19171":45398,"_5":13189,"_26134":45204,"_2648":45329},[],{"_3150":163,"_27624":91,"_19171":45400,"_5":13189,"_26134":45204,"_2648":45401},[],"PEM certificate for downstream TLS",{"_3150":164,"_27624":91,"_19171":45403,"_5":13189,"_26134":45204,"_2648":45404},[],"`--tls-key`",{"_3150":165,"_27624":91,"_19171":45406,"_5":13189,"_26134":45204,"_2648":45329},[],{"_3150":166,"_27624":91,"_19171":45408,"_5":13189,"_26134":45204,"_2648":45409},[],"PEM private key for downstream TLS",{"_3150":167,"_27624":91,"_19171":45411,"_5":13189,"_26134":45204,"_2648":45412},[],"`-l`, `--local-chart-path`",{"_3150":168,"_27624":91,"_19171":45414,"_5":13189,"_26134":45204,"_2648":45415},[],"repository chart",{"_3150":169,"_27624":91,"_19171":45417,"_5":13189,"_26134":45204,"_2648":45418},[],"Use an unpacked local Lamassu chart",{"_3150":170,"_27624":91,"_19171":45420,"_5":13189,"_26134":45204,"_2648":45421},[],"`-ip`, `--gateway-ip`",{"_3150":171,"_27624":91,"_19171":45423,"_5":13189,"_26134":45204,"_2648":7951},[],{"_3150":172,"_27624":91,"_19171":45425,"_5":13189,"_26134":45204,"_2648":45426},[],"Override the address written to `gateway.addresses`",{"_3150":173,"_27624":91,"_19171":45428,"_5":13189,"_26134":45204,"_2648":45429},[],"`--otel`",{"_3150":174,"_27624":91,"_19171":45431,"_5":13189,"_26134":45204,"_2648":5899},[],{"_3150":175,"_27624":91,"_19171":45433,"_5":13189,"_26134":45204,"_2648":45434},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3150":176,"_27624":91,"_19171":45436,"_5":13189,"_26134":45204,"_2648":45437},[],"`--development`",{"_3150":177,"_27624":91,"_19171":45439,"_5":13189,"_26134":45204,"_2648":5899},[],{"_3150":178,"_27624":91,"_19171":45441,"_5":13189,"_26134":45204,"_2648":45442},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3150":179,"_27624":91,"_19171":45444,"_5":13189,"_26134":45204,"_2648":45445},[],"`--sample-data`",{"_3150":180,"_27624":91,"_19171":45447,"_5":13189,"_26134":45204,"_2648":5899},[],{"_3150":181,"_27624":91,"_19171":45449,"_5":13189,"_26134":45204,"_2648":45450},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3150":182,"_27624":91,"_19171":45452,"_5":13189,"_26134":45204,"_2648":45453},[],"`--with-hsm`",{"_3150":183,"_27624":91,"_19171":45455,"_5":13189,"_26134":45204,"_2648":5899},[],{"_3150":184,"_27624":91,"_19171":45457,"_5":13189,"_26134":45204,"_2648":45458},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3150":185,"_27624":91,"_19171":45460,"_5":13189,"_26134":45204,"_2648":45461},[],"`--softhsm-chart-path`",{"_3150":186,"_27624":91,"_19171":45463,"_5":13189,"_26134":45204,"_2648":45464},[],"`./charts/softhsm`",{"_3150":187,"_27624":91,"_19171":45466,"_5":13189,"_26134":45204,"_2648":45467},[],"Use a different local SoftHSM chart",{"_3150":188,"_27624":91,"_19171":45469,"_5":13189,"_26134":45204,"_2648":45470},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3150":189,"_27624":91,"_19171":45472,"_5":13189,"_26134":45208,"_2648":45473},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3150":190,"_27624":91,"_19171":45475,"_5":13189,"_26134":45208,"_2648":45476},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3150":191,"_27624":91,"_19171":45478,"_5":13189,"_26134":45208,"_2648":45479},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3150":192,"_27624":91,"_19171":45481,"_5":13189,"_26134":45208,"_2648":45482},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3150":193,"_27624":91,"_19171":45484,"_5":13189,"_26134":45208,"_2648":45485},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3150":194,"_27624":91,"_19171":45487,"_5":13189,"_26134":45208,"_2648":45488},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3150":195,"_27624":91,"_19171":45490,"_5":13189,"_26134":45212,"_2648":45491},[],"Fastlane:",{"_3150":196,"_27624":91,"_19171":45493,"_5":13189,"_26134":45212,"_2648":45494},[],"validates local tools and the selected cluster",{"_3150":197,"_27624":91,"_19171":45496,"_5":13189,"_26134":45212,"_2648":45497},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3150":198,"_27624":91,"_19171":45499,"_5":13189,"_26134":45212,"_2648":45500},[],"creates the namespace",{"_3150":199,"_27624":91,"_19171":45502,"_5":13189,"_26134":45212,"_2648":45503},[],"installs PostgreSQL and creates the required databases",{"_3150":200,"_27624":91,"_19171":45505,"_5":13189,"_26134":45212,"_2648":45506},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3150":201,"_27624":91,"_19171":45508,"_5":13189,"_26134":45212,"_2648":45509},[],"installs RabbitMQ",{"_3150":202,"_27624":91,"_19171":45511,"_5":13189,"_26134":45212,"_2648":45512},[],"optionally installs observability and lab HSM components",{"_3150":203,"_27624":91,"_19171":45514,"_5":13189,"_26134":45212,"_2648":45515},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3150":204,"_27624":91,"_19171":45517,"_5":13189,"_26134":45212,"_2648":45518},[],"optionally loads sample data",{"_3150":205,"_27624":91,"_19171":45520,"_5":13189,"_26134":45212,"_2648":45521},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3150":206,"_27624":91,"_19171":45523,"_5":13189,"_26134":45216,"_2648":45524},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3150":207,"_27624":91,"_19171":45526,"_5":13189,"_26134":45216,"_2648":45527},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3150":208,"_27624":91,"_19171":45529,"_5":13189,"_26134":45220,"_2648":45530},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3150":209,"_27624":91,"_19171":45532,"_5":13189,"_26134":45220,"_2648":45533},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3150":210,"_27624":91,"_19171":45535,"_5":13189,"_26134":45220,"_2648":45536},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3150":211,"_27624":91,"_19171":45538,"_5":13189,"_26134":45224,"_2648":45539},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3150":212,"_27624":212,"_5":13515,"_2648":45541,"_27967":45542,"_19171":45543,"_26134":212},"Install with Helm",[44933,44934,45040],[],{"_3150":213,"_27624":212,"_19171":45545,"_5":13189,"_26134":212,"_2648":45546},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3150":214,"_27624":212,"_5":27964,"_19171":45548,"_26134":45549,"_2648":45550},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3150":215,"_27624":212,"_5":27964,"_19171":45552,"_26134":45553,"_2648":44943},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#before-you-begin",{"_3150":216,"_27624":212,"_5":27964,"_19171":45555,"_26134":45556,"_2648":45557},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3150":217,"_27624":212,"_5":27964,"_19171":45559,"_26134":45560,"_2648":45561},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3150":218,"_27624":212,"_5":27964,"_19171":45563,"_26134":45564,"_2648":45565},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3150":219,"_27624":212,"_5":27964,"_19171":45567,"_26134":45568,"_2648":45569},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3150":220,"_27624":212,"_5":27964,"_19171":45571,"_26134":45572,"_2648":45573},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3150":221,"_27624":212,"_5":27964,"_19171":45575,"_26134":45576,"_2648":45577},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3150":222,"_27624":212,"_5":27964,"_19171":45579,"_26134":45580,"_2648":45581},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3150":223,"_27624":212,"_19171":45583,"_5":13189,"_26134":45549,"_2648":45584},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3150":224,"_27624":212,"_19171":45586,"_5":13189,"_26134":45553,"_2648":45587},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3150":225,"_27624":212,"_19171":45589,"_5":13189,"_26134":45553,"_2648":45590},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3150":226,"_27624":212,"_19171":45592,"_5":13189,"_26134":45553,"_2648":45593},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3150":227,"_27624":212,"_19171":45595,"_5":13189,"_26134":45553,"_2648":45596},[],"a reachable RabbitMQ broker and credentials",{"_3150":228,"_27624":212,"_19171":45598,"_5":13189,"_26134":45553,"_2648":45599},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3150":229,"_27624":212,"_19171":45601,"_5":13189,"_26134":45553,"_2648":45602},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3150":230,"_27624":212,"_19171":45604,"_5":13189,"_26134":45553,"_2648":45605},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3150":231,"_27624":212,"_19171":45607,"_5":13189,"_26134":45553,"_2648":45608},[],"a StorageClass and an external traffic design",{"_3150":232,"_27624":212,"_19171":45610,"_5":13189,"_26134":45553,"_2648":45611},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3150":233,"_27624":212,"_19171":45613,"_5":13189,"_26134":45553,"_2648":45614},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3150":234,"_27624":212,"_19171":45616,"_5":13189,"_26134":45553,"_2648":45617},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3150":235,"_27624":212,"_19171":45619,"_5":13189,"_26134":45556,"_2648":45620},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3150":236,"_27624":212,"_19171":45622,"_5":13189,"_26134":45556,"_2648":45623},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3150":237,"_27624":212,"_19171":45625,"_5":13189,"_26134":45556,"_2648":45626},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_3150":238,"_27624":212,"_19171":45628,"_5":13189,"_26134":45560,"_2648":45629},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3150":239,"_27624":212,"_19171":45631,"_5":13189,"_26134":45560,"_2648":45632},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3150":240,"_27624":212,"_19171":45634,"_5":13189,"_26134":45560,"_2648":45635},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3150":241,"_27624":212,"_19171":45637,"_5":13189,"_26134":45564,"_2648":45638},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_3150":242,"_27624":212,"_19171":45640,"_5":13189,"_26134":45568,"_2648":45641},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3150":243,"_27624":212,"_19171":45643,"_5":13189,"_26134":45568,"_2648":45644},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3150":244,"_27624":212,"_19171":45646,"_5":13189,"_26134":45568,"_2648":45647},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3150":245,"_27624":212,"_19171":45649,"_5":13189,"_26134":45568,"_2648":45650},[],"See Access control for the principal and policy model.",{"_3150":246,"_27624":212,"_19171":45652,"_5":13189,"_26134":45572,"_2648":45653},[],"To install a local checkout instead:",{"_3150":247,"_27624":212,"_19171":45655,"_5":13189,"_26134":45576,"_2648":45656},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3150":248,"_27624":212,"_19171":45658,"_5":13189,"_26134":45576,"_2648":45659},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3150":249,"_27624":212,"_19171":45661,"_5":13189,"_26134":45580,"_2648":45662},[],"Before going live, review:",{"_3150":250,"_27624":212,"_19171":45664,"_5":13189,"_26134":45580,"_2648":45665},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3150":251,"_27624":212,"_19171":45667,"_5":13189,"_26134":45580,"_2648":45668},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3150":252,"_27624":212,"_19171":45670,"_5":13189,"_26134":45580,"_2648":45671},[],"shared VA storage before increasing VA replicas",{"_3150":253,"_27624":212,"_19171":45673,"_5":13189,"_26134":45580,"_2648":45674},[],"managed OIDC roles and removal of evaluation credentials",{"_3150":254,"_27624":212,"_19171":45676,"_5":13189,"_26134":45580,"_2648":45677},[],"a trusted TLS issuer or externally managed certificate",{"_3150":255,"_27624":212,"_19171":45679,"_5":13189,"_26134":45580,"_2648":45680},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3150":256,"_27624":212,"_19171":45682,"_5":13189,"_26134":45580,"_2648":45683},[],"SMTP, observability and alert delivery",{"_3150":257,"_27624":212,"_19171":45685,"_5":13189,"_26134":45580,"_2648":45686},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3150":258,"_27624":212,"_19171":45688,"_5":13189,"_26134":45580,"_2648":45689},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3150":259,"_27624":259,"_5":13515,"_2648":45691,"_27967":45692,"_19171":45693,"_26134":259},"Expose the Gateway",[44933,44934,45040],[],{"_3150":260,"_27624":259,"_19171":45695,"_5":13189,"_26134":259,"_2648":45696},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3150":261,"_27624":259,"_5":27964,"_19171":45698,"_26134":45699,"_2648":45700},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3150":262,"_27624":259,"_5":27964,"_19171":45702,"_26134":45703,"_2648":45704},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3150":263,"_27624":259,"_5":27964,"_19171":45706,"_26134":45707,"_2648":45708},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3150":264,"_27624":259,"_5":27964,"_19171":45710,"_26134":45711,"_2648":45712},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#k3s","K3s",{"_3150":265,"_27624":259,"_5":27964,"_19171":45714,"_26134":45715,"_2648":45716},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3150":266,"_27624":259,"_5":27964,"_19171":45718,"_26134":45719,"_2648":45720},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3150":267,"_27624":259,"_5":27964,"_19171":45722,"_26134":45723,"_2648":45724},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3150":268,"_27624":259,"_5":27964,"_19171":45726,"_26134":45727,"_2648":45728},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3150":269,"_27624":259,"_5":27964,"_19171":45730,"_26134":45731,"_2648":45732},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3150":270,"_27624":259,"_19171":45734,"_5":13189,"_26134":45699,"_2648":45735},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3150":271,"_27624":259,"_19171":45737,"_5":13189,"_26134":45699,"_2648":45738},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3150":272,"_27624":259,"_19171":45740,"_5":13189,"_26134":45703,"_2648":45741},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3150":273,"_27624":259,"_19171":45743,"_5":13189,"_26134":45703,"_2648":45744},[],"Set it only when:",{"_3150":274,"_27624":259,"_19171":45746,"_5":13189,"_26134":45703,"_2648":45747},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3150":275,"_27624":259,"_19171":45749,"_5":13189,"_26134":45703,"_2648":45750},[],"that address is allocated to this Gateway",{"_3150":276,"_27624":259,"_19171":45752,"_5":13189,"_26134":45703,"_2648":45753},[],"the surrounding network already routes traffic for it to the cluster",{"_3150":277,"_27624":259,"_19171":45755,"_5":13189,"_26134":45703,"_2648":45756},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3150":278,"_27624":259,"_19171":45758,"_5":13189,"_26134":45703,"_2648":45759},[],"Keep these two settings separate:",{"_3150":279,"_27624":259,"_19171":45761,"_5":13189,"_26134":45703,"_2648":45762},[],"`gateway.addresses` requests an address for the Gateway.",{"_3150":280,"_27624":259,"_19171":45764,"_5":13189,"_26134":45703,"_2648":45765},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3150":281,"_27624":259,"_19171":45767,"_5":13189,"_26134":45703,"_2648":45768},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3150":282,"_27624":259,"_19171":45770,"_5":13189,"_26134":45707,"_2648":45771},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3150":283,"_27624":259,"_19171":45773,"_5":13189,"_26134":45707,"_2648":45774},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3150":284,"_27624":259,"_19171":45776,"_5":13189,"_26134":45711,"_2648":45777},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3150":285,"_27624":259,"_19171":45779,"_5":13189,"_26134":45711,"_2648":45780},[],"For the recommended design:",{"_3150":286,"_27624":259,"_19171":45782,"_5":13189,"_26134":45711,"_2648":45783},[],"Use only one externally exposed Lamassu Gateway.",{"_3150":287,"_27624":259,"_19171":45785,"_5":13189,"_26134":45711,"_2648":45786},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3150":288,"_27624":259,"_19171":45788,"_5":13189,"_26134":45711,"_2648":45789},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3150":289,"_27624":259,"_19171":45791,"_5":13189,"_26134":45711,"_2648":45792},[],"Point DNS at the VM's reachable address.",{"_3150":290,"_27624":259,"_19171":45794,"_5":13189,"_26134":45711,"_2648":45795},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3150":291,"_27624":259,"_19171":45797,"_5":13189,"_26134":45715,"_2648":45798},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3150":292,"_27624":259,"_19171":45800,"_5":13189,"_26134":45719,"_2648":45801},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3150":293,"_27624":259,"_19171":45803,"_5":13189,"_26134":45719,"_2648":45804},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3150":294,"_27624":259,"_19171":45806,"_5":13189,"_26134":45723,"_2648":45807},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3150":295,"_27624":259,"_19171":45809,"_5":13189,"_26134":45723,"_2648":45810},[],"Requirement",{"_3150":296,"_27624":259,"_19171":45812,"_5":13189,"_26134":45723,"_2648":45813},[],"Recommended design",{"_3150":297,"_27624":259,"_19171":45815,"_5":13189,"_26134":45723,"_2648":45816},[],"Consequence",{"_3150":298,"_27624":259,"_19171":45818,"_5":13189,"_26134":45723,"_2648":45819},[],"Several Lamassu URLs or services",{"_3150":299,"_27624":259,"_19171":45821,"_5":13189,"_26134":45723,"_2648":45822},[],"One Gateway with multiple routes",{"_3150":300,"_27624":259,"_19171":45824,"_5":13189,"_26134":45723,"_2648":45825},[],"One IP and one proxy fleet; this is the chart default",{"_3150":301,"_27624":259,"_19171":45827,"_5":13189,"_26134":45723,"_2648":45828},[],"Independent Gateways and separate external IPs",{"_3150":302,"_27624":259,"_19171":45830,"_5":13189,"_26134":45723,"_2648":45831},[],"One VIP per Gateway",{"_3150":303,"_27624":259,"_19171":45833,"_5":13189,"_26134":45723,"_2648":45834},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3150":304,"_27624":259,"_19171":45836,"_5":13189,"_26134":45723,"_2648":45837},[],"Independent Gateways on one node and one IP",{"_3150":305,"_27624":259,"_19171":45839,"_5":13189,"_26134":45723,"_2648":45840},[],"Use different external ports",{"_3150":306,"_27624":259,"_19171":45842,"_5":13189,"_26134":45723,"_2648":45843},[],"Clients must include non-standard ports",{"_3150":307,"_27624":259,"_19171":45845,"_5":13189,"_26134":45723,"_2648":45846},[],"Separate TLS/mTLS termination behind one IP",{"_3150":308,"_27624":259,"_19171":45848,"_5":13189,"_26134":45723,"_2648":45849},[],"Front-door SNI routing to internal Gateways",{"_3150":309,"_27624":259,"_19171":45851,"_5":13189,"_26134":45723,"_2648":45852},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3150":310,"_27624":259,"_19171":45854,"_5":13189,"_26134":45723,"_2648":45855},[],"Separate Gateway resources but shared proxy infrastructure",{"_3150":311,"_27624":259,"_19171":45857,"_5":13189,"_26134":45723,"_2648":45858},[],"Envoy merged-Gateway mode",{"_3150":312,"_27624":259,"_19171":45860,"_5":13189,"_26134":45723,"_2648":45861},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3150":313,"_27624":259,"_19171":45863,"_5":13189,"_26134":45723,"_2648":45864},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3150":314,"_27624":259,"_19171":45866,"_5":13189,"_26134":45723,"_2648":45867},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3150":315,"_27624":259,"_19171":45869,"_5":13189,"_26134":45723,"_2648":45870},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3150":316,"_27624":259,"_19171":45872,"_5":13189,"_26134":45723,"_2648":45873},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3150":317,"_27624":259,"_19171":45875,"_5":13189,"_26134":45727,"_2648":45876},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3150":318,"_27624":259,"_19171":45878,"_5":13189,"_26134":45727,"_2648":45879},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3150":319,"_27624":259,"_19171":45881,"_5":13189,"_26134":45727,"_2648":45882},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3150":320,"_27624":259,"_19171":45884,"_5":13189,"_26134":45727,"_2648":45885},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3150":321,"_27624":259,"_19171":45887,"_5":13189,"_26134":45727,"_2648":45888},[],"If none of those are possible, use different external ports or change the external network design.",{"_3150":322,"_27624":259,"_19171":45890,"_5":13189,"_26134":45731,"_2648":45891},[],"Check, in order:",{"_3150":323,"_27624":259,"_19171":45893,"_5":13189,"_26134":45731,"_2648":45894},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3150":324,"_27624":259,"_19171":45896,"_5":13189,"_26134":45731,"_2648":45897},[],"Its status contains the expected address.",{"_3150":325,"_27624":259,"_19171":45899,"_5":13189,"_26134":45731,"_2648":45900},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3150":326,"_27624":259,"_19171":45902,"_5":13189,"_26134":45731,"_2648":45903},[],"Port 443 reaches that address from the client network.",{"_3150":327,"_27624":259,"_19171":45905,"_5":13189,"_26134":45731,"_2648":45906},[],"DNS resolves to the externally reachable endpoint.",{"_3150":328,"_27624":259,"_19171":45908,"_5":13189,"_26134":45731,"_2648":45909},[],"The certificate contains the DNS name or IP used by the client.",{"_3150":329,"_27624":259,"_19171":45911,"_5":13189,"_26134":45731,"_2648":45912},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3150":330,"_27624":330,"_5":13515,"_2648":45040,"_27967":45914,"_19171":45915,"_26134":330},[44933,44934,45040],[],{"_3150":331,"_27624":330,"_19171":45917,"_5":13189,"_26134":330,"_2648":45918},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3150":332,"_27624":330,"_5":27964,"_19171":45920,"_26134":45921,"_2648":45922},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3150":333,"_27624":330,"_5":27964,"_19171":45924,"_26134":45925,"_2648":45926},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3150":334,"_27624":330,"_5":27964,"_19171":45928,"_26134":45929,"_2648":45930},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3150":335,"_27624":330,"_5":27964,"_19171":45932,"_26134":45933,"_2648":45934},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3150":336,"_27624":330,"_5":27964,"_19171":45936,"_26134":45937,"_2648":45938},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3150":337,"_27624":330,"_5":27964,"_19171":45940,"_26134":45941,"_2648":45942},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3150":338,"_27624":330,"_19171":45944,"_5":13189,"_26134":45921,"_2648":45945},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3150":339,"_27624":330,"_19171":45947,"_5":13189,"_26134":45925,"_2648":45948},[],"Workflow",{"_3150":340,"_27624":330,"_19171":45950,"_5":13189,"_26134":45925,"_2648":45951},[],"Use it for",{"_3150":341,"_27624":330,"_19171":45953,"_5":13189,"_26134":45925,"_2648":45954},[],"What it installs",{"_3150":342,"_27624":330,"_19171":45956,"_5":13189,"_26134":45925,"_2648":45957},[],"Helm",{"_3150":343,"_27624":330,"_19171":45959,"_5":13189,"_26134":45925,"_2648":45960},[],"Production and controlled environments",{"_3150":344,"_27624":330,"_19171":45962,"_5":13189,"_26134":45925,"_2648":45963},[],"Lamassu services and Gateway API resources",{"_3150":345,"_27624":330,"_19171":45965,"_5":13189,"_26134":45925,"_2648":45177},[],{"_3150":346,"_27624":330,"_19171":45967,"_5":13189,"_26134":45925,"_2648":45968},[],"Evaluation, demos, CI and small lab clusters",{"_3150":347,"_27624":330,"_19171":45970,"_5":13189,"_26134":45925,"_2648":45971},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3150":348,"_27624":330,"_19171":45973,"_5":13189,"_26134":45929,"_2648":45974},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3150":349,"_27624":330,"_19171":45976,"_5":13189,"_26134":45929,"_2648":45977},[],"Area",{"_3150":350,"_27624":330,"_19171":45979,"_5":13189,"_26134":45929,"_2648":45980},[],"The Lamassu chart provides",{"_3150":351,"_27624":330,"_19171":45982,"_5":13189,"_26134":45929,"_2648":45983},[],"You provide",{"_3150":352,"_27624":330,"_19171":45985,"_5":13189,"_26134":45929,"_2648":45986},[],"Lamassu applications",{"_3150":353,"_27624":330,"_19171":45988,"_5":13189,"_26134":45929,"_2648":45989},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3150":354,"_27624":330,"_19171":45991,"_5":13189,"_26134":45929,"_2648":45992},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3150":355,"_27624":330,"_19171":45994,"_5":13189,"_26134":45929,"_2648":45995},[],"PostgreSQL data",{"_3150":356,"_27624":330,"_19171":45997,"_5":13189,"_26134":45929,"_2648":45998},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3150":357,"_27624":330,"_19171":46000,"_5":13189,"_26134":45929,"_2648":46001},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3150":358,"_27624":330,"_19171":46003,"_5":13189,"_26134":45929,"_2648":46004},[],"Messaging",{"_3150":359,"_27624":330,"_19171":46006,"_5":13189,"_26134":45929,"_2648":46007},[],"RabbitMQ connection configuration for the Lamassu services",{"_3150":360,"_27624":330,"_19171":46009,"_5":13189,"_26134":45929,"_2648":46010},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3150":361,"_27624":330,"_19171":46012,"_5":13189,"_26134":45929,"_2648":46013},[],"Identity",{"_3150":362,"_27624":330,"_19171":46015,"_5":13189,"_26134":45929,"_2648":46016},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3150":363,"_27624":330,"_19171":46018,"_5":13189,"_26134":45929,"_2648":46019},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3150":364,"_27624":330,"_19171":46021,"_5":13189,"_26134":45929,"_2648":46022},[],"External routing",{"_3150":365,"_27624":330,"_19171":46024,"_5":13189,"_26134":45929,"_2648":46025},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3150":366,"_27624":330,"_19171":46027,"_5":13189,"_26134":45929,"_2648":46028},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3150":367,"_27624":330,"_19171":46030,"_5":13189,"_26134":45929,"_2648":46031},[],"TLS",{"_3150":368,"_27624":330,"_19171":46033,"_5":13189,"_26134":45929,"_2648":46034},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_3150":369,"_27624":330,"_19171":46036,"_5":13189,"_26134":45929,"_2648":46037},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3150":370,"_27624":330,"_19171":46039,"_5":13189,"_26134":45929,"_2648":46040},[],"Persistent application data",{"_3150":371,"_27624":330,"_19171":46042,"_5":13189,"_26134":45929,"_2648":46043},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3150":372,"_27624":330,"_19171":46045,"_5":13189,"_26134":45929,"_2648":46046},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3150":373,"_27624":330,"_19171":46048,"_5":13189,"_26134":45929,"_2648":46049},[],"Optional integrations",{"_3150":374,"_27624":330,"_19171":46051,"_5":13189,"_26134":45929,"_2648":46052},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3150":375,"_27624":330,"_19171":46054,"_5":13189,"_26134":45929,"_2648":46055},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3150":376,"_27624":330,"_19171":46057,"_5":13189,"_26134":45929,"_2648":46058},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3150":377,"_27624":330,"_19171":46060,"_5":13189,"_26134":45929,"_2648":46061},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3150":378,"_27624":330,"_19171":46063,"_5":13189,"_26134":45933,"_2648":46064},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3150":379,"_27624":330,"_19171":46066,"_5":13189,"_26134":45933,"_2648":46067},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3150":380,"_27624":330,"_19171":46069,"_5":13189,"_26134":45937,"_2648":46070},[],"Kubernetes 1.24 or newer",{"_3150":381,"_27624":330,"_19171":46072,"_5":13189,"_26134":45937,"_2648":46073},[],"Helm 3.2 or newer",{"_3150":382,"_27624":330,"_19171":46075,"_5":13189,"_26134":45937,"_2648":46076},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3150":383,"_27624":330,"_19171":46078,"_5":13189,"_26134":45937,"_2648":46079},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_3150":384,"_27624":330,"_19171":46081,"_5":13189,"_26134":45937,"_2648":46082},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3150":385,"_27624":330,"_19171":46084,"_5":13189,"_26134":45937,"_2648":46085},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3150":386,"_27624":330,"_19171":46087,"_5":13189,"_26134":45937,"_2648":46088},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3150":387,"_27624":330,"_19171":46090,"_5":13189,"_26134":45941,"_2648":46091},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":388,"_27624":330,"_19171":46093,"_5":13189,"_26134":45941,"_2648":46094},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3150":389,"_27624":330,"_19171":46096,"_5":13189,"_26134":45941,"_2648":46097},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3150":390,"_27624":330,"_19171":46099,"_5":13189,"_26134":45941,"_2648":46100},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3150":391,"_27624":391,"_5":13515,"_2648":46102,"_27967":46103,"_19171":46105,"_26134":391},"Deployment troubleshooting",[44933,44934,46104],"Operations",[],{"_3150":392,"_27624":391,"_19171":46107,"_5":13189,"_26134":391,"_2648":46108},[],"Diagnose access, service health and infrastructure dependencies.",{"_3150":393,"_27624":391,"_5":27964,"_19171":46110,"_26134":46111,"_2648":46112},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3150":394,"_27624":391,"_5":27964,"_19171":46114,"_26134":46115,"_2648":46116},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3150":395,"_27624":391,"_5":27964,"_19171":46118,"_26134":46119,"_2648":46120},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3150":396,"_27624":391,"_5":27964,"_19171":46122,"_26134":46123,"_2648":46124},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3150":397,"_27624":391,"_5":27964,"_19171":46126,"_26134":46127,"_2648":46128},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3150":398,"_27624":391,"_5":27964,"_19171":46130,"_26134":46131,"_2648":46132},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3150":399,"_27624":391,"_5":27964,"_19171":46134,"_26134":46135,"_2648":46136},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3150":400,"_27624":391,"_5":27964,"_19171":46138,"_26134":46139,"_2648":46140},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3150":401,"_27624":391,"_5":27964,"_19171":46142,"_26134":46143,"_2648":46144},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3150":402,"_27624":391,"_5":27964,"_19171":46146,"_26134":46147,"_2648":46148},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3150":403,"_27624":391,"_5":27964,"_19171":46150,"_26134":46151,"_2648":46152},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3150":404,"_27624":391,"_5":27964,"_19171":46154,"_26134":46155,"_2648":46156},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#observability","Observability",{"_3150":405,"_27624":391,"_19171":46158,"_5":13189,"_26134":391,"_2648":46159},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3150":406,"_27624":391,"_19171":46161,"_5":13189,"_26134":46115,"_2648":46162},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3150":407,"_27624":391,"_19171":46164,"_5":13189,"_26134":46119,"_2648":46165},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3150":408,"_27624":391,"_19171":46167,"_5":13189,"_26134":46123,"_2648":46168},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3150":409,"_27624":391,"_19171":46170,"_5":13189,"_26134":46127,"_2648":46171},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3150":410,"_27624":391,"_19171":46173,"_5":13189,"_26134":46131,"_2648":46174},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3150":411,"_27624":391,"_19171":46176,"_5":13189,"_26134":46135,"_2648":46177},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3150":412,"_27624":391,"_19171":46179,"_5":13189,"_26134":46135,"_2648":46180},[],"Also run the chart's connectivity test:",{"_3150":413,"_27624":391,"_19171":46182,"_5":13189,"_26134":46135,"_2648":46183},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3150":414,"_27624":391,"_19171":46185,"_5":13189,"_26134":46135,"_2648":46186},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3150":415,"_27624":391,"_19171":46188,"_5":13189,"_26134":46139,"_2648":46189},[],"If you receive a 401:",{"_3150":416,"_27624":391,"_19171":46191,"_5":13189,"_26134":46139,"_2648":46192},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3150":417,"_27624":391,"_19171":46194,"_5":13189,"_26134":46139,"_2648":46195},[],"verify issuer, audience and expiration of the token;",{"_3150":418,"_27624":391,"_19171":46197,"_5":13189,"_26134":46139,"_2648":46198},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3150":419,"_27624":391,"_19171":46200,"_5":13189,"_26134":46139,"_2648":46201},[],"check that the provider's public and internal routes point to the same realm.",{"_3150":420,"_27624":391,"_19171":46203,"_5":13189,"_26134":46139,"_2648":46204},[],"If login succeeds but the APIs return 403:",{"_3150":421,"_27624":391,"_19171":46206,"_5":13189,"_26134":46139,"_2648":46207},[],"inspect the token's real claims;",{"_3150":422,"_27624":391,"_19171":46209,"_5":13189,"_26134":46139,"_2648":46210},[],"confirm they match an active principal;",{"_3150":423,"_27624":391,"_19171":46212,"_5":13189,"_26134":46139,"_2648":46213},[],"review the policies granted to that principal;",{"_3150":424,"_27624":391,"_19171":46215,"_5":13189,"_26134":46139,"_2648":46216},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3150":425,"_27624":391,"_19171":46218,"_5":13189,"_26134":46139,"_2648":46219},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3150":426,"_27624":391,"_19171":46221,"_5":13189,"_26134":46143,"_2648":46222},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3150":427,"_27624":391,"_19171":46224,"_5":13189,"_26134":46143,"_2648":46225},[],"Locate the authz pod and Service.",{"_3150":428,"_27624":391,"_19171":46227,"_5":13189,"_26134":46143,"_2648":46228},[],"Check /health, logs and its database connection.",{"_3150":429,"_27624":391,"_19171":46230,"_5":13189,"_26134":46143,"_2648":46231},[],"Verify the DNS and port configured in externalAuthorization.",{"_3150":430,"_27624":391,"_19171":46233,"_5":13189,"_26134":46143,"_2648":46234},[],"Check the check route is /v1/ext\\_authz/check.",{"_3150":431,"_27624":391,"_19171":46236,"_5":13189,"_26134":46143,"_2648":46237},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3150":432,"_27624":391,"_19171":46239,"_5":13189,"_26134":46147,"_2648":46240},[],"Review kubectl describe pod first. Common causes are:",{"_3150":433,"_27624":391,"_19171":46242,"_5":13189,"_26134":46147,"_2648":46243},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3150":434,"_27624":391,"_19171":46245,"_5":13189,"_26134":46147,"_2648":46246},[],"unbound persistent volume;",{"_3150":435,"_27624":391,"_19171":46248,"_5":13189,"_26134":46147,"_2648":46249},[],"inaccessible image or incorrect pull policy;",{"_3150":436,"_27624":391,"_19171":46251,"_5":13189,"_26134":46147,"_2648":46252},[],"invalid cryptographic engine configuration;",{"_3150":437,"_27624":391,"_19171":46254,"_5":13189,"_26134":46147,"_2648":46255},[],"CPU or memory limits set too low;",{"_3150":438,"_27624":391,"_19171":46257,"_5":13189,"_26134":46147,"_2648":46258},[],"an incomplete prior migration.",{"_3150":439,"_27624":391,"_19171":46260,"_5":13189,"_26134":46147,"_2648":46261},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3150":440,"_27624":391,"_19171":46263,"_5":13189,"_26134":46147,"_2648":46264},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3150":441,"_27624":391,"_19171":46266,"_5":13189,"_26134":46151,"_2648":46267},[],"Domain and audit events depend on the bus publisher:",{"_3150":442,"_27624":391,"_19171":46269,"_5":13189,"_26134":46151,"_2648":46270},[],"verify it is enabled in the emitting service;",{"_3150":443,"_27624":391,"_19171":46272,"_5":13189,"_26134":46151,"_2648":46273},[],"check AMQP connectivity and credentials;",{"_3150":444,"_27624":391,"_19171":46275,"_5":13189,"_26134":46151,"_2648":46276},[],"review exchange, routing key, queues and consumers;",{"_3150":445,"_27624":391,"_19171":46278,"_5":13189,"_26134":46151,"_2648":46279},[],"inspect dead-letter queues;",{"_3150":446,"_27624":391,"_19171":46281,"_5":13189,"_26134":46151,"_2648":46282},[],"alert on orphan durable queues and backlog growth.",{"_3150":447,"_27624":391,"_19171":46284,"_5":13189,"_26134":46151,"_2648":46285},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3150":448,"_27624":391,"_19171":46287,"_5":13189,"_26134":46155,"_2648":46288},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3150":449,"_27624":391,"_19171":46290,"_5":13189,"_26134":46155,"_2648":46291},[],"Before closing an incident, record:",{"_3150":450,"_27624":391,"_19171":46293,"_5":13189,"_26134":46155,"_2648":46294},[],"the confirmed cause;",{"_3150":451,"_27624":391,"_19171":46296,"_5":13189,"_26134":46155,"_2648":46297},[],"the time scope and affected resources;",{"_3150":452,"_27624":391,"_19171":46299,"_5":13189,"_26134":46155,"_2648":46300},[],"the commands or queries used;",{"_3150":453,"_27624":391,"_19171":46302,"_5":13189,"_26134":46155,"_2648":46303},[],"the applied change and how to revert it;",{"_3150":454,"_27624":391,"_19171":46305,"_5":13189,"_26134":46155,"_2648":46306},[],"validation from a consumer;",{"_3150":455,"_27624":391,"_19171":46308,"_5":13189,"_26134":46155,"_2648":46309},[],"the preventive action and its owner.",{"_3150":456,"_27624":456,"_5":13515,"_2648":46311,"_27967":46312,"_19171":46315,"_26134":456},"Access control",[44933,46313,46314],"Platform","Administration",[],{"_3150":457,"_27624":456,"_19171":46317,"_5":13189,"_26134":456,"_2648":46318},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3150":458,"_27624":456,"_5":27964,"_19171":46320,"_26134":46321,"_2648":46322},[],"/docs/pr-preview/pr-26/platform/administration/access-control#essential-concepts","Essential concepts",{"_3150":459,"_27624":456,"_5":27964,"_19171":46324,"_26134":46325,"_2648":46326},[],"/docs/pr-preview/pr-26/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3150":460,"_27624":456,"_5":27964,"_19171":46328,"_26134":46329,"_2648":46330},[],"/docs/pr-preview/pr-26/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3150":461,"_27624":456,"_5":27964,"_19171":46332,"_26134":46333,"_2648":46334},[],"/docs/pr-preview/pr-26/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3150":462,"_27624":456,"_5":27964,"_19171":46336,"_26134":46337,"_2648":46338},[],"/docs/pr-preview/pr-26/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3150":463,"_27624":456,"_5":27964,"_19171":46340,"_26134":46341,"_2648":46342},[],"/docs/pr-preview/pr-26/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3150":464,"_27624":456,"_5":27964,"_19171":46344,"_26134":46345,"_2648":46346},[],"/docs/pr-preview/pr-26/platform/administration/access-control#oidc-principals","OIDC principals",{"_3150":465,"_27624":456,"_5":27964,"_19171":46348,"_26134":46349,"_2648":46350},[],"/docs/pr-preview/pr-26/platform/administration/access-control#x509-principals","X.509 principals",{"_3150":466,"_27624":456,"_5":27964,"_19171":46352,"_26134":46353,"_2648":46354},[],"/docs/pr-preview/pr-26/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3150":467,"_27624":456,"_5":27964,"_19171":46356,"_26134":46357,"_2648":46358},[],"/docs/pr-preview/pr-26/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3150":468,"_27624":456,"_5":27964,"_19171":46360,"_26134":46361,"_2648":46362},[],"/docs/pr-preview/pr-26/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3150":469,"_27624":456,"_5":27964,"_19171":46364,"_26134":46365,"_2648":46366},[],"/docs/pr-preview/pr-26/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3150":470,"_27624":456,"_5":27964,"_19171":46368,"_26134":46369,"_2648":46370},[],"/docs/pr-preview/pr-26/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3150":471,"_27624":456,"_5":27964,"_19171":46372,"_26134":46373,"_2648":46374},[],"/docs/pr-preview/pr-26/platform/administration/access-control#http-rules","HTTP rules",{"_3150":472,"_27624":456,"_5":27964,"_19171":46376,"_26134":46377,"_2648":46378},[],"/docs/pr-preview/pr-26/platform/administration/access-control#included-policies","Included policies",{"_3150":473,"_27624":456,"_5":27964,"_19171":46380,"_26134":46381,"_2648":45569},[],"/docs/pr-preview/pr-26/platform/administration/access-control#provision-the-first-administrator",{"_3150":474,"_27624":456,"_5":27964,"_19171":46383,"_26134":46384,"_2648":46385},[],"/docs/pr-preview/pr-26/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3150":475,"_27624":456,"_5":27964,"_19171":46387,"_26134":46388,"_2648":46389},[],"/docs/pr-preview/pr-26/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3150":476,"_27624":456,"_5":27964,"_19171":46391,"_26134":46392,"_2648":46393},[],"/docs/pr-preview/pr-26/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3150":477,"_27624":456,"_5":27964,"_19171":46395,"_26134":46396,"_2648":46397},[],"/docs/pr-preview/pr-26/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3150":478,"_27624":456,"_5":27964,"_19171":46399,"_26134":46400,"_2648":46401},[],"/docs/pr-preview/pr-26/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3150":479,"_27624":456,"_5":27964,"_19171":46403,"_26134":46404,"_2648":46405},[],"/docs/pr-preview/pr-26/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3150":480,"_27624":456,"_5":27964,"_19171":46407,"_26134":46408,"_2648":46409},[],"/docs/pr-preview/pr-26/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3150":481,"_27624":456,"_5":27964,"_19171":46411,"_26134":46412,"_2648":46413},[],"/docs/pr-preview/pr-26/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3150":482,"_27624":456,"_5":27964,"_19171":46415,"_26134":46416,"_2648":46417},[],"/docs/pr-preview/pr-26/platform/administration/access-control#operational-checklist","Operational checklist",{"_3150":483,"_27624":456,"_5":27964,"_19171":46419,"_26134":46420,"_2648":46421},[],"/docs/pr-preview/pr-26/platform/administration/access-control#diagnostics","Diagnostics",{"_3150":484,"_27624":456,"_5":27964,"_19171":46423,"_26134":46424,"_2648":46425},[],"/docs/pr-preview/pr-26/platform/administration/access-control#the-response-is-401","The response is 401",{"_3150":485,"_27624":456,"_5":27964,"_19171":46427,"_26134":46428,"_2648":46429},[],"/docs/pr-preview/pr-26/platform/administration/access-control#the-response-is-403","The response is 403",{"_3150":486,"_27624":456,"_5":27964,"_19171":46431,"_26134":46432,"_2648":46433},[],"/docs/pr-preview/pr-26/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3150":487,"_27624":456,"_5":27964,"_19171":46435,"_26134":46436,"_2648":46437},[],"/docs/pr-preview/pr-26/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3150":488,"_27624":456,"_5":27964,"_19171":46439,"_26134":46440,"_2648":46441},[],"/docs/pr-preview/pr-26/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3150":489,"_27624":456,"_19171":46443,"_5":13189,"_26134":456,"_2648":46444},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3150":490,"_27624":456,"_19171":46446,"_5":13189,"_26134":456,"_2648":46447},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3150":491,"_27624":456,"_19171":46449,"_5":13189,"_26134":456,"_2648":46450},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3150":492,"_27624":456,"_19171":46452,"_5":13189,"_26134":46321,"_2648":46453},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3150":493,"_27624":456,"_19171":46455,"_5":13189,"_26134":46321,"_2648":46456},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3150":494,"_27624":456,"_19171":46458,"_5":13189,"_26134":46321,"_2648":46459},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3150":495,"_27624":456,"_19171":46461,"_5":13189,"_26134":46321,"_2648":46462},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3150":496,"_27624":456,"_19171":46464,"_5":13189,"_26134":46321,"_2648":46465},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3150":497,"_27624":456,"_19171":46467,"_5":13189,"_26134":46321,"_2648":46468},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3150":498,"_27624":456,"_19171":46470,"_5":13189,"_26134":46325,"_2648":46471},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3150":499,"_27624":456,"_19171":46473,"_5":13189,"_26134":46325,"_2648":46474},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3150":500,"_27624":456,"_19171":46476,"_5":13189,"_26134":46329,"_2648":46477},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3150":501,"_27624":456,"_19171":46479,"_5":13189,"_26134":46329,"_2648":46480},[],"The decision is made **before forwarding the request to the service**:",{"_3150":502,"_27624":456,"_19171":46482,"_5":13189,"_26134":46329,"_2648":46483},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3150":503,"_27624":456,"_19171":46485,"_5":13189,"_26134":46329,"_2648":46486},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3150":504,"_27624":456,"_19171":46488,"_5":13189,"_26134":46329,"_2648":46489},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3150":505,"_27624":456,"_19171":46491,"_5":13189,"_26134":46329,"_2648":46492},[],"It separately loads the policies granted to each principal.",{"_3150":506,"_27624":456,"_19171":46494,"_5":13189,"_26134":46329,"_2648":46495},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3150":507,"_27624":456,"_19171":46497,"_5":13189,"_26134":46329,"_2648":46498},[],"`authz` looks for an HTTP rule granting that action.",{"_3150":508,"_27624":456,"_19171":46500,"_5":13189,"_26134":46329,"_2648":46501},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3150":509,"_27624":456,"_19171":46503,"_5":13189,"_26134":46329,"_2648":46504},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3150":510,"_27624":456,"_19171":46506,"_5":13189,"_26134":46329,"_2648":46507},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3150":511,"_27624":456,"_19171":46509,"_5":13189,"_26134":46329,"_2648":46510},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3150":512,"_27624":456,"_19171":46512,"_5":13189,"_26134":46333,"_2648":46513},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3150":513,"_27624":456,"_19171":46515,"_5":13189,"_26134":46333,"_2648":46516},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3150":514,"_27624":456,"_19171":46518,"_5":13189,"_26134":46333,"_2648":46519},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3150":515,"_27624":456,"_19171":46521,"_5":13189,"_26134":46333,"_2648":46522},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3150":516,"_27624":456,"_19171":46524,"_5":13189,"_26134":46333,"_2648":46525},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3150":517,"_27624":456,"_19171":46527,"_5":13189,"_26134":46333,"_2648":46528},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3150":518,"_27624":456,"_19171":46530,"_5":13189,"_26134":46333,"_2648":46531},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3150":519,"_27624":456,"_19171":46533,"_5":13189,"_26134":46333,"_2648":46534},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3150":520,"_27624":456,"_19171":46536,"_5":13189,"_26134":46337,"_2648":46537},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3150":521,"_27624":456,"_19171":46539,"_5":13189,"_26134":46337,"_2648":46540},[],"The decision is made with the domain operation context:",{"_3150":522,"_27624":456,"_19171":46542,"_5":13189,"_26134":46337,"_2648":46543},[],"The middleware extracts the credential and resolves the matching principals.",{"_3150":523,"_27624":456,"_19171":46545,"_5":13189,"_26134":46337,"_2648":46546},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3150":524,"_27624":456,"_19171":46548,"_5":13189,"_26134":46337,"_2648":46549},[],"`authz` gathers the entity rules of the granted policies.",{"_3150":525,"_27624":456,"_19171":46551,"_5":13189,"_26134":46337,"_2648":46552},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3150":526,"_27624":456,"_19171":46554,"_5":13189,"_26134":46337,"_2648":46555},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3150":527,"_27624":456,"_19171":46557,"_5":13189,"_26134":46337,"_2648":46558},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3150":528,"_27624":456,"_19171":46560,"_5":13189,"_26134":46337,"_2648":46561},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3150":529,"_27624":456,"_19171":46563,"_5":13189,"_26134":46337,"_2648":46564},[],"Actions fall into two groups:",{"_3150":530,"_27624":456,"_19171":46566,"_5":13189,"_26134":46337,"_2648":46567},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3150":531,"_27624":456,"_19171":46569,"_5":13189,"_26134":46337,"_2648":46570},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3150":532,"_27624":456,"_19171":46572,"_5":13189,"_26134":46337,"_2648":46573},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3150":533,"_27624":456,"_19171":46575,"_5":13189,"_26134":46341,"_2648":46576},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3150":534,"_27624":456,"_19171":46578,"_5":13189,"_26134":46341,"_2648":46579},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3150":535,"_27624":456,"_19171":46581,"_5":13189,"_26134":46341,"_2648":46582},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3150":536,"_27624":456,"_19171":46584,"_5":13189,"_26134":46345,"_2648":46585},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3150":537,"_27624":456,"_19171":46587,"_5":13189,"_26134":46345,"_2648":46588},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3150":538,"_27624":456,"_19171":46590,"_5":13189,"_26134":46345,"_2648":46591},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3150":539,"_27624":456,"_19171":46593,"_5":13189,"_26134":46345,"_2648":46594},[],"The implemented operators are:",{"_3150":540,"_27624":456,"_19171":46596,"_5":13189,"_26134":46345,"_2648":46597},[],"`equals`, for exact equality;",{"_3150":541,"_27624":456,"_19171":46599,"_5":13189,"_26134":46345,"_2648":46600},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3150":542,"_27624":456,"_19171":46602,"_5":13189,"_26134":46345,"_2648":46603},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3150":543,"_27624":456,"_19171":46605,"_5":13189,"_26134":46345,"_2648":46606},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3150":544,"_27624":456,"_19171":46608,"_5":13189,"_26134":46349,"_2648":46609},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3150":545,"_27624":456,"_19171":46611,"_5":13189,"_26134":46349,"_2648":46612},[],"The available modes are:",{"_3150":546,"_27624":456,"_19171":46614,"_5":13189,"_26134":46349,"_2648":46615},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3150":547,"_27624":456,"_19171":46617,"_5":13189,"_26134":46349,"_2648":46618},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3150":548,"_27624":456,"_19171":46620,"_5":13189,"_26134":46349,"_2648":46621},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3150":549,"_27624":456,"_19171":46623,"_5":13189,"_26134":46349,"_2648":46624},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3150":550,"_27624":456,"_19171":46626,"_5":13189,"_26134":46349,"_2648":46627},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3150":551,"_27624":456,"_19171":46629,"_5":13189,"_26134":46349,"_2648":46630},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3150":552,"_27624":456,"_19171":46632,"_5":13189,"_26134":46353,"_2648":46633},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3150":553,"_27624":456,"_19171":46635,"_5":13189,"_26134":46353,"_2648":46636},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3150":554,"_27624":456,"_19171":46638,"_5":13189,"_26134":46353,"_2648":46639},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3150":555,"_27624":456,"_19171":46641,"_5":13189,"_26134":46353,"_2648":46642},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3150":556,"_27624":456,"_19171":46644,"_5":13189,"_26134":46361,"_2648":46645},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3150":557,"_27624":456,"_19171":46647,"_5":13189,"_26134":46361,"_2648":46648},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3150":558,"_27624":456,"_19171":46650,"_5":13189,"_26134":46365,"_2648":46651},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3150":559,"_27624":456,"_19171":46653,"_5":13189,"_26134":46365,"_2648":46654},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3150":560,"_27624":456,"_19171":46656,"_5":13189,"_26134":46369,"_2648":46657},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3150":561,"_27624":456,"_19171":46659,"_5":13189,"_26134":46369,"_2648":46660},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3150":562,"_27624":456,"_19171":46662,"_5":13189,"_26134":46369,"_2648":46663},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3150":563,"_27624":456,"_19171":46665,"_5":13189,"_26134":46373,"_2648":46666},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3150":564,"_27624":456,"_19171":46668,"_5":13189,"_26134":46373,"_2648":46669},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3150":565,"_27624":456,"_19171":46671,"_5":13189,"_26134":46373,"_2648":46672},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3150":566,"_27624":456,"_19171":46674,"_5":13189,"_26134":46373,"_2648":46675},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3150":567,"_27624":456,"_19171":46677,"_5":13189,"_26134":46373,"_2648":46678},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3150":568,"_27624":456,"_19171":46680,"_5":13189,"_26134":46373,"_2648":46681},[],"Note that:",{"_3150":569,"_27624":456,"_19171":46683,"_5":13189,"_26134":46373,"_2648":46684},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3150":570,"_27624":456,"_19171":46686,"_5":13189,"_26134":46373,"_2648":46687},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3150":571,"_27624":456,"_19171":46689,"_5":13189,"_26134":46373,"_2648":46690},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3150":572,"_27624":456,"_19171":46692,"_5":13189,"_26134":46377,"_2648":46693},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3150":573,"_27624":456,"_19171":46695,"_5":13189,"_26134":46377,"_2648":46696},[],"full and read-only access to certificates and authorities;",{"_3150":574,"_27624":456,"_19171":46698,"_5":13189,"_26134":46377,"_2648":46699},[],"full and read-only access to the KMS;",{"_3150":575,"_27624":456,"_19171":46701,"_5":13189,"_26134":46377,"_2648":46702},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3150":576,"_27624":456,"_19171":46704,"_5":13189,"_26134":46377,"_2648":46705},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3150":577,"_27624":456,"_19171":46707,"_5":13189,"_26134":46377,"_2648":46708},[],"console access;",{"_3150":578,"_27624":456,"_19171":46710,"_5":13189,"_26134":46377,"_2648":46711},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3150":579,"_27624":456,"_19171":46713,"_5":13189,"_26134":46377,"_2648":46714},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3150":580,"_27624":456,"_19171":46716,"_5":13189,"_26134":46377,"_2648":46717},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3150":581,"_27624":456,"_19171":46719,"_5":13189,"_26134":46381,"_2648":46720},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3150":582,"_27624":456,"_19171":46722,"_5":13189,"_26134":46381,"_2648":46723},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3150":583,"_27624":456,"_19171":46725,"_5":13189,"_26134":46381,"_2648":46726},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3150":584,"_27624":456,"_19171":46728,"_5":13189,"_26134":46384,"_2648":46729},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3150":585,"_27624":456,"_19171":46731,"_5":13189,"_26134":46388,"_2648":46732},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3150":586,"_27624":456,"_19171":46734,"_5":13189,"_26134":46388,"_2648":46735},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3150":587,"_27624":456,"_19171":46737,"_5":13189,"_26134":46392,"_2648":46738},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3150":588,"_27624":456,"_19171":46740,"_5":13189,"_26134":46396,"_2648":46741},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3150":589,"_27624":456,"_19171":46743,"_5":13189,"_26134":46400,"_2648":46744},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3150":590,"_27624":456,"_19171":46746,"_5":13189,"_26134":46404,"_2648":46747},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3150":591,"_27624":456,"_19171":46749,"_5":13189,"_26134":46404,"_2648":46750},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3150":592,"_27624":456,"_19171":46752,"_5":13189,"_26134":46408,"_2648":46753},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3150":593,"_27624":456,"_19171":46755,"_5":13189,"_26134":46408,"_2648":46756},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3150":594,"_27624":456,"_19171":46758,"_5":13189,"_26134":46408,"_2648":46759},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3150":595,"_27624":456,"_19171":46761,"_5":13189,"_26134":46408,"_2648":46762},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3150":596,"_27624":456,"_19171":46764,"_5":13189,"_26134":46408,"_2648":46765},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3150":597,"_27624":456,"_19171":46767,"_5":13189,"_26134":46408,"_2648":46768},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3150":598,"_27624":456,"_19171":46770,"_5":13189,"_26134":46408,"_2648":46771},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3150":599,"_27624":456,"_19171":46773,"_5":13189,"_26134":46408,"_2648":46774},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3150":600,"_27624":456,"_19171":46776,"_5":13189,"_26134":46412,"_2648":46777},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3150":601,"_27624":456,"_19171":46779,"_5":13189,"_26134":46412,"_2648":46780},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3150":602,"_27624":456,"_19171":46782,"_5":13189,"_26134":46412,"_2648":46783},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3150":603,"_27624":456,"_19171":46785,"_5":13189,"_26134":46416,"_2648":46786},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3150":604,"_27624":456,"_19171":46788,"_5":13189,"_26134":46416,"_2648":46789},[],"Use groups or stable roles for people and independent identities for automations.",{"_3150":605,"_27624":456,"_19171":46791,"_5":13189,"_26134":46416,"_2648":46792},[],"Keep at least two recovery administrators and test their access periodically.",{"_3150":606,"_27624":456,"_19171":46794,"_5":13189,"_26134":46416,"_2648":46795},[],"Review active principals, their matches and their grants after IdP changes.",{"_3150":607,"_27624":456,"_19171":46797,"_5":13189,"_26134":46416,"_2648":46798},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3150":608,"_27624":456,"_19171":46800,"_5":13189,"_26134":46416,"_2648":46801},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3150":609,"_27624":456,"_19171":46803,"_5":13189,"_26134":46416,"_2648":46804},[],"Always test one allowed and one denied operation for each role.",{"_3150":610,"_27624":456,"_19171":46806,"_5":13189,"_26134":46416,"_2648":46807},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3150":611,"_27624":456,"_19171":46809,"_5":13189,"_26134":46424,"_2648":46810},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3150":612,"_27624":456,"_19171":46812,"_5":13189,"_26134":46428,"_2648":46813},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3150":613,"_27624":456,"_19171":46815,"_5":13189,"_26134":46428,"_2648":46816},[],"that an active principal of the correct type exists;",{"_3150":614,"_27624":456,"_19171":46818,"_5":13189,"_26134":46428,"_2648":46819},[],"that the claim paths and values match the real token exactly;",{"_3150":615,"_27624":456,"_19171":46821,"_5":13189,"_26134":46428,"_2648":46822},[],"that all of the principal's conditions hold;",{"_3150":616,"_27624":456,"_19171":46824,"_5":13189,"_26134":46428,"_2648":46825},[],"that the principal has the expected policy granted;",{"_3150":617,"_27624":456,"_19171":46827,"_5":13189,"_26134":46428,"_2648":46828},[],"that the policy includes the action and the requested resource type or route;",{"_3150":618,"_27624":456,"_19171":46830,"_5":13189,"_26134":46428,"_2648":46831},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3150":619,"_27624":456,"_19171":46833,"_5":13189,"_26134":46428,"_2648":46834},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3150":620,"_27624":456,"_19171":46836,"_5":13189,"_26134":46432,"_2648":46837},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3150":621,"_27624":456,"_19171":46839,"_5":13189,"_26134":46436,"_2648":46840},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3150":622,"_27624":456,"_19171":46842,"_5":13189,"_26134":46440,"_2648":46843},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3150":623,"_27624":456,"_19171":46845,"_5":13189,"_26134":46440,"_2648":46846},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3150":624,"_27624":624,"_5":13515,"_2648":46848,"_27967":46849,"_19171":46850,"_26134":624},"Alerts and subscriptions",[44933,46313,46314],[],{"_3150":625,"_27624":624,"_19171":46852,"_5":13189,"_26134":624,"_2648":46853},[],"Send PKI events to people and external systems.",{"_3150":626,"_27624":624,"_5":27964,"_19171":46855,"_26134":46856,"_2648":46857},[],"/docs/pr-preview/pr-26/platform/administration/alerts#how-it-works","How it works",{"_3150":627,"_27624":624,"_5":27964,"_19171":46859,"_26134":46860,"_2648":46861},[],"/docs/pr-preview/pr-26/platform/administration/alerts#available-channels","Available channels",{"_3150":628,"_27624":624,"_5":27964,"_19171":46863,"_26134":46864,"_2648":46865},[],"/docs/pr-preview/pr-26/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3150":629,"_27624":624,"_5":27964,"_19171":46867,"_26134":46868,"_2648":46869},[],"/docs/pr-preview/pr-26/platform/administration/alerts#choose-the-event","Choose the event",{"_3150":630,"_27624":624,"_5":27964,"_19171":46871,"_26134":46872,"_2648":46873},[],"/docs/pr-preview/pr-26/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3150":631,"_27624":624,"_5":27964,"_19171":46875,"_26134":46876,"_2648":46877},[],"/docs/pr-preview/pr-26/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3150":632,"_27624":624,"_5":27964,"_19171":46879,"_26134":46880,"_2648":46881},[],"/docs/pr-preview/pr-26/platform/administration/alerts#review-and-activate","Review and activate",{"_3150":633,"_27624":624,"_5":27964,"_19171":46883,"_26134":46884,"_2648":46885},[],"/docs/pr-preview/pr-26/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3150":634,"_27624":624,"_5":27964,"_19171":46887,"_26134":46888,"_2648":46889},[],"/docs/pr-preview/pr-26/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3150":635,"_27624":624,"_5":27964,"_19171":46891,"_26134":46892,"_2648":46893},[],"/docs/pr-preview/pr-26/platform/administration/alerts#event-families","Event families",{"_3150":636,"_27624":624,"_19171":46895,"_5":13189,"_26134":624,"_2648":46896},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3150":637,"_27624":624,"_19171":46898,"_5":13189,"_26134":46856,"_2648":46899},[],"A service publishes a domain event.",{"_3150":638,"_27624":624,"_19171":46901,"_5":13189,"_26134":46856,"_2648":46902},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3150":639,"_27624":624,"_19171":46904,"_5":13189,"_26134":46856,"_2648":46905},[],"Each subscription's filter decides whether it should be notified.",{"_3150":640,"_27624":624,"_19171":46907,"_5":13189,"_26134":46856,"_2648":46908},[],"Lamassu delivers the event to the configured channel.",{"_3150":641,"_27624":624,"_19171":46910,"_5":13189,"_26134":46856,"_2648":46911},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3150":642,"_27624":624,"_19171":46913,"_5":13189,"_26134":46860,"_2648":46914},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3150":643,"_27624":624,"_19171":46916,"_5":13189,"_26134":46860,"_2648":46917},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3150":644,"_27624":624,"_19171":46919,"_5":13189,"_26134":46860,"_2648":46920},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3150":645,"_27624":624,"_19171":46922,"_5":13189,"_26134":46860,"_2648":46923},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3150":646,"_27624":624,"_19171":46925,"_5":13189,"_26134":46860,"_2648":46926},[],"`apikey_options` requires `header` and `key`.",{"_3150":647,"_27624":624,"_19171":46928,"_5":13189,"_26134":46860,"_2648":46929},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3150":648,"_27624":624,"_19171":46931,"_5":13189,"_26134":46860,"_2648":46932},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3150":649,"_27624":624,"_19171":46934,"_5":13189,"_26134":46860,"_2648":46935},[],"The alerts API reference documents the full `http_client` schema.",{"_3150":650,"_27624":624,"_19171":46937,"_5":13189,"_26134":46868,"_2648":46938},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3150":651,"_27624":624,"_19171":46940,"_5":13189,"_26134":46872,"_2648":46941},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3150":652,"_27624":624,"_19171":46943,"_5":13189,"_26134":46876,"_2648":46944},[],"Add a filter if you don't want to receive every instance of the event.",{"_3150":653,"_27624":624,"_19171":46946,"_5":13189,"_26134":46876,"_2648":46947},[],"**None** notifies all instances of the event.",{"_3150":654,"_27624":624,"_19171":46949,"_5":13189,"_26134":46876,"_2648":46950},[],"**JSON Path** evaluates one or more specific fields.",{"_3150":655,"_27624":624,"_19171":46952,"_5":13189,"_26134":46876,"_2648":46953},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3150":656,"_27624":624,"_19171":46955,"_5":13189,"_26134":46876,"_2648":46956},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3150":657,"_27624":624,"_19171":46958,"_5":13189,"_26134":46876,"_2648":46959},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3150":658,"_27624":624,"_19171":46961,"_5":13189,"_26134":46880,"_2648":46962},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3150":659,"_27624":624,"_19171":46964,"_5":13189,"_26134":46884,"_2648":46965},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3150":660,"_27624":624,"_19171":46967,"_5":13189,"_26134":46884,"_2648":46968},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3150":661,"_27624":624,"_19171":46970,"_5":13189,"_26134":46884,"_2648":46971},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3150":662,"_27624":624,"_19171":46973,"_5":13189,"_26134":46884,"_2648":46974},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3150":663,"_27624":624,"_19171":46976,"_5":13189,"_26134":46884,"_2648":46977},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3150":664,"_27624":624,"_19171":46979,"_5":13189,"_26134":46884,"_2648":46980},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3150":665,"_27624":624,"_19171":46982,"_5":13189,"_26134":46884,"_2648":46983},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3150":666,"_27624":624,"_19171":46985,"_5":13189,"_26134":46884,"_2648":46986},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3150":667,"_27624":624,"_19171":46988,"_5":13189,"_26134":46888,"_2648":46989},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3150":668,"_27624":624,"_19171":46991,"_5":13189,"_26134":46892,"_2648":46992},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3150":669,"_27624":624,"_19171":46994,"_5":13189,"_26134":46892,"_2648":46995},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3150":670,"_27624":624,"_19171":46997,"_5":13189,"_26134":46892,"_2648":46998},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3150":671,"_27624":624,"_19171":47000,"_5":13189,"_26134":46892,"_2648":47001},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3150":672,"_27624":624,"_19171":47003,"_5":13189,"_26134":46892,"_2648":47004},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3150":673,"_27624":624,"_19171":47006,"_5":13189,"_26134":46892,"_2648":47007},[],"**Validation:** `va.role.crl.create`.",{"_3150":674,"_27624":624,"_19171":47009,"_5":13189,"_26134":46892,"_2648":47010},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3150":675,"_27624":624,"_19171":47012,"_5":13189,"_26134":46892,"_2648":47013},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3150":676,"_27624":676,"_5":13515,"_2648":47015,"_27967":47016,"_19171":47017,"_26134":676},"Audit logs",[44933,46313,46314],[],{"_3150":677,"_27624":676,"_19171":47019,"_5":13189,"_26134":676,"_2648":47020},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3150":678,"_27624":676,"_5":27964,"_19171":47022,"_26134":47023,"_2648":47024},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3150":679,"_27624":676,"_5":27964,"_19171":47026,"_26134":47027,"_2648":47028},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#coverage","Coverage",{"_3150":680,"_27624":676,"_5":27964,"_19171":47030,"_26134":47031,"_2648":47032},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3150":681,"_27624":676,"_5":27964,"_19171":47034,"_26134":47035,"_2648":47036},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3150":682,"_27624":676,"_5":27964,"_19171":47038,"_26134":47039,"_2648":47040},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3150":683,"_27624":676,"_5":27964,"_19171":47042,"_26134":47043,"_2648":47044},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3150":684,"_27624":676,"_5":27964,"_19171":47046,"_26134":47047,"_2648":47048},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3150":685,"_27624":676,"_5":27964,"_19171":47050,"_26134":47051,"_2648":47052},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3150":686,"_27624":676,"_5":27964,"_19171":47054,"_26134":47055,"_2648":47056},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3150":687,"_27624":676,"_5":27964,"_19171":47058,"_26134":47059,"_2648":47060},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3150":688,"_27624":676,"_5":27964,"_19171":47062,"_26134":47063,"_2648":47064},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3150":689,"_27624":676,"_19171":47066,"_5":13189,"_26134":676,"_2648":47067},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3150":690,"_27624":676,"_19171":47069,"_5":13189,"_26134":47023,"_2648":47070},[],"The audit body includes:",{"_3150":691,"_27624":676,"_19171":47072,"_5":13189,"_26134":47023,"_2648":47073},[],"input: data received by the operation;",{"_3150":692,"_27624":676,"_19171":47075,"_5":13189,"_26134":47023,"_2648":47076},[],"has\\_error: whether the service returned an error;",{"_3150":693,"_27624":676,"_19171":47078,"_5":13189,"_26134":47023,"_2648":47079},[],"output: produced result or error message;",{"_3150":694,"_27624":676,"_19171":47081,"_5":13189,"_26134":47023,"_2648":47082},[],"principals: identifiers of the principals that matched the request.",{"_3150":695,"_27624":676,"_19171":47084,"_5":13189,"_26134":47023,"_2648":47085},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3150":696,"_27624":676,"_19171":47087,"_5":13189,"_26134":47023,"_2648":47088},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3150":697,"_27624":676,"_19171":47090,"_5":13189,"_26134":47027,"_2648":47091},[],"The backend applies auditing to mutations of:",{"_3150":698,"_27624":676,"_19171":47093,"_5":13189,"_26134":47027,"_2648":47094},[],"authorities, certificates and issuance profiles;",{"_3150":699,"_27624":676,"_19171":47096,"_5":13189,"_26134":47027,"_2648":47097},[],"keys and KMS engines;",{"_3150":700,"_27624":676,"_19171":47099,"_5":13189,"_26134":47027,"_2648":47100},[],"devices and identities;",{"_3150":701,"_27624":676,"_19171":47102,"_5":13189,"_26134":47027,"_2648":47103},[],"DMSs and enrollment operations;",{"_3150":702,"_27624":676,"_19171":47105,"_5":13189,"_26134":47027,"_2648":47106},[],"validation functions and CRL;",{"_3150":703,"_27624":676,"_19171":47108,"_5":13189,"_26134":47027,"_2648":47109},[],"principals, policies and authorization grants.",{"_3150":704,"_27624":676,"_19171":47111,"_5":13189,"_26134":47027,"_2648":47112},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3150":705,"_27624":676,"_19171":47114,"_5":13189,"_26134":47031,"_2648":47115},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3150":706,"_27624":676,"_19171":47117,"_5":13189,"_26134":47031,"_2648":47118},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3150":707,"_27624":676,"_19171":47120,"_5":13189,"_26134":47031,"_2648":47121},[],"Design the consumer to:",{"_3150":708,"_27624":676,"_19171":47123,"_5":13189,"_26134":47031,"_2648":47124},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3150":709,"_27624":676,"_19171":47126,"_5":13189,"_26134":47031,"_2648":47127},[],"keep the complete CloudEvent unmodified;",{"_3150":710,"_27624":676,"_19171":47129,"_5":13189,"_26134":47031,"_2648":47130},[],"record the ingestion time and detect duplicates by ID;",{"_3150":711,"_27624":676,"_19171":47132,"_5":13189,"_26134":47031,"_2648":47133},[],"encrypt in transit and at rest;",{"_3150":712,"_27624":676,"_19171":47135,"_5":13189,"_26134":47031,"_2648":47136},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3150":713,"_27624":676,"_19171":47138,"_5":13189,"_26134":47031,"_2648":47139},[],"apply an explicit retention and legal hold policy;",{"_3150":714,"_27624":676,"_19171":47141,"_5":13189,"_26134":47031,"_2648":47142},[],"alert if it stops consuming or the pending queue grows.",{"_3150":715,"_27624":676,"_19171":47144,"_5":13189,"_26134":47035,"_2648":47145},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3150":716,"_27624":676,"_19171":47147,"_5":13189,"_26134":47035,"_2648":47148},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3150":717,"_27624":676,"_19171":47150,"_5":13189,"_26134":47043,"_2648":47151},[],"Start from the reported time and normalize every source to UTC.",{"_3150":718,"_27624":676,"_19171":47153,"_5":13189,"_26134":47047,"_2648":47154},[],"Filter by event type, service source and resource identifier.",{"_3150":719,"_27624":676,"_19171":47156,"_5":13189,"_26134":47051,"_2648":47157},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3150":720,"_27624":676,"_19171":47159,"_5":13189,"_26134":47055,"_2648":47160},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3150":721,"_27624":676,"_19171":47162,"_5":13189,"_26134":47059,"_2648":47163},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3150":722,"_27624":676,"_19171":47165,"_5":13189,"_26134":47063,"_2648":47166},[],"Generate a controlled mutation in a test environment and check that:",{"_3150":723,"_27624":676,"_19171":47168,"_5":13189,"_26134":47063,"_2648":47169},[],"a successful audit event appears;",{"_3150":724,"_27624":676,"_19171":47171,"_5":13189,"_26134":47063,"_2648":47172},[],"the principal matches the identity used;",{"_3150":725,"_27624":676,"_19171":47174,"_5":13189,"_26134":47063,"_2648":47175},[],"the consumer persists it exactly once;",{"_3150":726,"_27624":676,"_19171":47177,"_5":13189,"_26134":47063,"_2648":47178},[],"it can be retrieved by resource, actor and period;",{"_3150":727,"_27624":676,"_19171":47180,"_5":13189,"_26134":47063,"_2648":47181},[],"a consumer outage raises an alert.",{"_3150":728,"_27624":676,"_19171":47183,"_5":13189,"_26134":47063,"_2648":47184},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3150":729,"_27624":729,"_5":13515,"_2648":47186,"_27967":47187,"_19171":47188,"_26134":729},"Platform architecture",[44933,46313],[],{"_3150":730,"_27624":729,"_19171":47190,"_5":13189,"_26134":729,"_2648":47191},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3150":731,"_27624":729,"_5":27964,"_19171":47193,"_26134":47194,"_2648":47195},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#control-plane","Control plane",{"_3150":732,"_27624":729,"_5":27964,"_19171":47197,"_26134":47198,"_2648":47199},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3150":733,"_27624":729,"_5":27964,"_19171":47201,"_26134":47202,"_2648":47203},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3150":734,"_27624":729,"_5":27964,"_19171":47205,"_26134":47206,"_2648":47207},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#status-and-validation","Status and validation",{"_3150":735,"_27624":729,"_5":27964,"_19171":47209,"_26134":47210,"_2648":47211},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3150":736,"_27624":729,"_19171":47213,"_5":13189,"_26134":729,"_2648":47214},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3150":737,"_27624":729,"_19171":47216,"_5":13189,"_26134":729,"_2648":47217},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3150":738,"_27624":729,"_19171":47219,"_5":13189,"_26134":47194,"_2648":47220},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3150":739,"_27624":729,"_19171":47222,"_5":13189,"_26134":47198,"_2648":47223},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3150":740,"_27624":729,"_19171":47225,"_5":13189,"_26134":47202,"_2648":47226},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3150":741,"_27624":729,"_19171":47228,"_5":13189,"_26134":47206,"_2648":47229},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3150":742,"_27624":729,"_19171":47231,"_5":13189,"_26134":47210,"_2648":47232},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3150":743,"_27624":743,"_5":13515,"_2648":47234,"_27967":47235,"_19171":47236,"_26134":743},"How Lamassu works",[44933,46313],[],{"_3150":744,"_27624":743,"_19171":47238,"_5":13189,"_26134":743,"_2648":47239},[],"The mental model of trust, keys, certificates and devices.",{"_3150":745,"_27624":743,"_5":27964,"_19171":47241,"_26134":47242,"_2648":47243},[],"/docs/pr-preview/pr-26/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3150":746,"_27624":743,"_5":27964,"_19171":47245,"_26134":47246,"_2648":47247},[],"/docs/pr-preview/pr-26/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3150":747,"_27624":743,"_19171":47249,"_5":13189,"_26134":743,"_2648":47250},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3150":748,"_27624":743,"_19171":47252,"_5":13189,"_26134":47242,"_2648":47253},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3150":749,"_27624":743,"_19171":47255,"_5":13189,"_26134":47242,"_2648":47256},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3150":750,"_27624":743,"_19171":47258,"_5":13189,"_26134":47242,"_2648":47259},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3150":751,"_27624":743,"_19171":47261,"_5":13189,"_26134":47242,"_2648":47262},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3150":752,"_27624":743,"_19171":47264,"_5":13189,"_26134":47242,"_2648":47265},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3150":753,"_27624":743,"_19171":47267,"_5":13189,"_26134":47246,"_2648":47268},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3150":754,"_27624":743,"_19171":47270,"_5":13189,"_26134":47246,"_2648":47271},[],"A DMS relates that CA to an enrollment policy.",{"_3150":755,"_27624":743,"_19171":47273,"_5":13189,"_26134":47246,"_2648":47274},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3150":756,"_27624":743,"_19171":47276,"_5":13189,"_26134":47246,"_2648":47277},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3150":757,"_27624":743,"_19171":47279,"_5":13189,"_26134":47246,"_2648":47280},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3150":758,"_27624":743,"_19171":47282,"_5":13189,"_26134":47246,"_2648":47283},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3150":759,"_27624":743,"_19171":47285,"_5":13189,"_26134":47246,"_2648":47286},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3150":760,"_27624":760,"_5":13515,"_2648":47288,"_27967":47289,"_19171":47291,"_26134":760},"Devices and identities",[44933,46313,47290,47288],"IoT Fleets",[],{"_3150":761,"_27624":760,"_19171":47293,"_5":13189,"_26134":760,"_2648":47294},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3150":762,"_27624":760,"_5":27964,"_19171":47296,"_26134":47297,"_2648":47298},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#device-states","Device states",{"_3150":763,"_27624":760,"_5":27964,"_19171":47300,"_26134":47301,"_2648":47302},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3150":764,"_27624":760,"_5":27964,"_19171":47304,"_26134":47305,"_2648":47306},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3150":765,"_27624":760,"_5":27964,"_19171":47308,"_26134":47309,"_2648":47310},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3150":766,"_27624":760,"_5":27964,"_19171":47312,"_26134":47313,"_2648":47314},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3150":767,"_27624":760,"_5":27964,"_19171":47316,"_26134":47317,"_2648":47318},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3150":768,"_27624":760,"_5":27964,"_19171":47320,"_26134":47321,"_2648":47322},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3150":769,"_27624":760,"_5":27964,"_19171":47324,"_26134":47325,"_2648":47326},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3150":770,"_27624":760,"_5":27964,"_19171":47328,"_26134":47329,"_2648":47330},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3150":771,"_27624":760,"_5":27964,"_19171":47332,"_26134":47333,"_2648":47334},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3150":772,"_27624":760,"_5":27964,"_19171":47336,"_26134":47337,"_2648":47338},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3150":773,"_27624":760,"_19171":47340,"_5":13189,"_26134":760,"_2648":47341},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3150":774,"_27624":760,"_19171":47343,"_5":13189,"_26134":760,"_2648":47344},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3150":775,"_27624":760,"_19171":47346,"_5":13189,"_26134":47297,"_2648":47347},[],"Operational view",{"_3150":776,"_27624":760,"_19171":47349,"_5":13189,"_26134":47297,"_2648":47350},[],"Meaning",{"_3150":777,"_27624":760,"_19171":47352,"_5":13189,"_26134":47297,"_2648":47353},[],"**No Identity**",{"_3150":778,"_27624":760,"_19171":47355,"_5":13189,"_26134":47297,"_2648":47356},[],"A record exists without an associated identity.",{"_3150":779,"_27624":760,"_19171":47358,"_5":13189,"_26134":47297,"_2648":47359},[],"**Active**",{"_3150":780,"_27624":760,"_19171":47361,"_5":13189,"_26134":47297,"_2648":47362},[],"The slot is active; also check certificate dates, status and usages.",{"_3150":781,"_27624":760,"_19171":47364,"_5":13189,"_26134":47297,"_2648":47365},[],"**Renewal Pending**",{"_3150":782,"_27624":760,"_19171":47367,"_5":13189,"_26134":47297,"_2648":47368},[],"The identity is in the operational renewal window.",{"_3150":783,"_27624":760,"_19171":47370,"_5":13189,"_26134":47297,"_2648":47371},[],"**Expiring Soon**",{"_3150":784,"_27624":760,"_19171":47373,"_5":13189,"_26134":47297,"_2648":47374},[],"Expiration is approaching according to configured thresholds.",{"_3150":785,"_27624":760,"_19171":47376,"_5":13189,"_26134":47297,"_2648":47377},[],"**Expired**",{"_3150":786,"_27624":760,"_19171":47379,"_5":13189,"_26134":47297,"_2648":47380},[],"The identity has expired.",{"_3150":787,"_27624":760,"_19171":47382,"_5":13189,"_26134":47297,"_2648":47383},[],"**Revoked**",{"_3150":788,"_27624":760,"_19171":47385,"_5":13189,"_26134":47297,"_2648":47386},[],"The identity is marked revoked.",{"_3150":789,"_27624":760,"_19171":47388,"_5":13189,"_26134":47297,"_2648":47389},[],"**Decommissioned**",{"_3150":790,"_27624":760,"_19171":47391,"_5":13189,"_26134":47297,"_2648":47392},[],"The record is retired and ordinary updates do not restore operation.",{"_3150":791,"_27624":760,"_19171":47394,"_5":13189,"_26134":47297,"_2648":47395},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3150":792,"_27624":760,"_19171":47397,"_5":13189,"_26134":47301,"_2648":47398},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3150":793,"_27624":760,"_19171":47400,"_5":13189,"_26134":47301,"_2648":47401},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3150":794,"_27624":760,"_19171":47403,"_5":13189,"_26134":47301,"_2648":47404},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3150":795,"_27624":760,"_19171":47406,"_5":13189,"_26134":47301,"_2648":47407},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3150":796,"_27624":760,"_19171":47409,"_5":13189,"_26134":47305,"_2648":47410},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3150":797,"_27624":760,"_19171":47412,"_5":13189,"_26134":47309,"_2648":47413},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3150":798,"_27624":760,"_19171":47415,"_5":13189,"_26134":47313,"_2648":47416},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3150":799,"_27624":760,"_19171":47418,"_5":13189,"_26134":47317,"_2648":47419},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3150":800,"_27624":760,"_19171":47421,"_5":13189,"_26134":47321,"_2648":47422},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3150":801,"_27624":760,"_19171":47424,"_5":13189,"_26134":47321,"_2648":47425},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3150":802,"_27624":760,"_19171":47427,"_5":13189,"_26134":47325,"_2648":47428},[],"From **No Identity**, use **Assign Identity**:",{"_3150":803,"_27624":760,"_19171":47430,"_5":13189,"_26134":47325,"_2648":47431},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3150":804,"_27624":760,"_19171":47433,"_5":13189,"_26134":47325,"_2648":47434},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3150":805,"_27624":760,"_19171":47436,"_5":13189,"_26134":47325,"_2648":47437},[],"Confirm and read the serial, active version and history again.",{"_3150":806,"_27624":760,"_19171":47439,"_5":13189,"_26134":47325,"_2648":47440},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3150":807,"_27624":760,"_19171":47442,"_5":13189,"_26134":47325,"_2648":47443},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3150":808,"_27624":760,"_19171":47445,"_5":13189,"_26134":47329,"_2648":47446},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3150":809,"_27624":760,"_19171":47448,"_5":13189,"_26134":47329,"_2648":47449},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3150":810,"_27624":760,"_19171":47451,"_5":13189,"_26134":47333,"_2648":47452},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3150":811,"_27624":760,"_19171":47454,"_5":13189,"_26134":47333,"_2648":47455},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3150":812,"_27624":760,"_19171":47457,"_5":13189,"_26134":47333,"_2648":47458},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3150":813,"_27624":760,"_19171":47460,"_5":13189,"_26134":47333,"_2648":47461},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3150":814,"_27624":760,"_19171":47463,"_5":13189,"_26134":47337,"_2648":47464},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":815,"_27624":760,"_19171":47466,"_5":13189,"_26134":47337,"_2648":47467},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":816,"_27624":816,"_5":13515,"_2648":47469,"_27967":47470,"_19171":47472,"_26134":816},"Bootstrap identity and authentication",[44933,46313,47290,47288,47471],"Enrollment with PKI",[],{"_3150":817,"_27624":816,"_19171":47474,"_5":13189,"_26134":816,"_2648":47475},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3150":818,"_27624":816,"_5":27964,"_19171":47477,"_26134":47478,"_2648":47479},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3150":819,"_27624":816,"_5":27964,"_19171":47481,"_26134":47482,"_2648":47483},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3150":820,"_27624":816,"_5":27964,"_19171":47485,"_26134":47486,"_2648":47487},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3150":821,"_27624":816,"_5":27964,"_19171":47489,"_26134":47490,"_2648":47491},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3150":822,"_27624":816,"_5":27964,"_19171":47493,"_26134":47494,"_2648":47495},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3150":823,"_27624":816,"_19171":47497,"_5":13189,"_26134":816,"_2648":47498},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3150":824,"_27624":816,"_19171":47500,"_5":13189,"_26134":47478,"_2648":47501},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3150":825,"_27624":816,"_19171":47503,"_5":13189,"_26134":47478,"_2648":47504},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3150":826,"_27624":816,"_19171":47506,"_5":13189,"_26134":47482,"_2648":47507},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3150":827,"_27624":816,"_19171":47509,"_5":13189,"_26134":47482,"_2648":47510},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3150":828,"_27624":816,"_19171":47512,"_5":13189,"_26134":47482,"_2648":47513},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3150":829,"_27624":816,"_19171":47515,"_5":13189,"_26134":47486,"_2648":47516},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3150":830,"_27624":816,"_19171":47518,"_5":13189,"_26134":47486,"_2648":47519},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3150":831,"_27624":816,"_19171":47521,"_5":13189,"_26134":47490,"_2648":47522},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3150":832,"_27624":816,"_19171":47524,"_5":13189,"_26134":47490,"_2648":47525},[],"Example body:",{"_3150":833,"_27624":816,"_19171":47527,"_5":13189,"_26134":47490,"_2648":47528},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3150":834,"_27624":816,"_19171":47530,"_5":13189,"_26134":47490,"_2648":47531},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3150":835,"_27624":816,"_19171":47533,"_5":13189,"_26134":47490,"_2648":47534},[],"Continuation requires a successful HTTP response and JSON:",{"_3150":836,"_27624":816,"_19171":47536,"_5":13189,"_26134":47490,"_2648":47537},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3150":837,"_27624":816,"_19171":47539,"_5":13189,"_26134":47494,"_2648":47540},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3150":838,"_27624":816,"_19171":47542,"_5":13189,"_26134":47494,"_2648":47543},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3150":839,"_27624":839,"_5":13515,"_2648":47545,"_27967":47546,"_19171":47547,"_26134":839},"Configure and operate the DMS",[44933,46313,47290,47288,47471],[],{"_3150":840,"_27624":839,"_19171":47549,"_5":13189,"_26134":839,"_2648":47550},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3150":841,"_27624":839,"_5":27964,"_19171":47552,"_26134":47553,"_2648":44943},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3150":842,"_27624":839,"_5":27964,"_19171":47555,"_26134":47556,"_2648":47557},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3150":843,"_27624":839,"_5":27964,"_19171":47559,"_26134":47560,"_2648":47561},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3150":844,"_27624":839,"_5":27964,"_19171":47563,"_26134":47564,"_2648":47565},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3150":845,"_27624":839,"_5":27964,"_19171":47567,"_26134":47568,"_2648":47569},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3150":846,"_27624":839,"_5":27964,"_19171":47571,"_26134":47572,"_2648":47573},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3150":847,"_27624":839,"_5":27964,"_19171":47575,"_26134":47576,"_2648":47577},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3150":848,"_27624":839,"_5":27964,"_19171":47579,"_26134":47580,"_2648":47581},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3150":849,"_27624":839,"_5":27964,"_19171":47583,"_26134":47584,"_2648":47585},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3150":850,"_27624":839,"_5":27964,"_19171":47587,"_26134":47588,"_2648":47589},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3150":851,"_27624":839,"_5":27964,"_19171":47591,"_26134":47592,"_2648":47593},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3150":852,"_27624":839,"_5":27964,"_19171":47595,"_26134":47596,"_2648":47597},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3150":853,"_27624":839,"_5":27964,"_19171":47599,"_26134":47600,"_2648":47601},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3150":854,"_27624":839,"_5":27964,"_19171":47603,"_26134":47604,"_2648":47605},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3150":855,"_27624":839,"_5":27964,"_19171":47607,"_26134":47608,"_2648":47609},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3150":856,"_27624":839,"_5":27964,"_19171":47611,"_26134":47612,"_2648":47613},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3150":857,"_27624":839,"_5":27964,"_19171":47615,"_26134":47616,"_2648":47617},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3150":858,"_27624":839,"_5":27964,"_19171":47619,"_26134":47620,"_2648":47621},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3150":859,"_27624":839,"_19171":47623,"_5":13189,"_26134":839,"_2648":47624},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3150":860,"_27624":839,"_19171":47626,"_5":13189,"_26134":47553,"_2648":47627},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3150":861,"_27624":839,"_19171":47629,"_5":13189,"_26134":47553,"_2648":47630},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3150":862,"_27624":839,"_19171":47632,"_5":13189,"_26134":47560,"_2648":47633},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3150":863,"_27624":839,"_19171":47635,"_5":13189,"_26134":47564,"_2648":47636},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3150":864,"_27624":839,"_19171":47638,"_5":13189,"_26134":47568,"_2648":47639},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3150":865,"_27624":839,"_19171":47641,"_5":13189,"_26134":47572,"_2648":47642},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3150":866,"_27624":839,"_19171":47644,"_5":13189,"_26134":47576,"_2648":47645},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3150":867,"_27624":839,"_19171":47647,"_5":13189,"_26134":47584,"_2648":47648},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3150":868,"_27624":839,"_19171":47650,"_5":13189,"_26134":47584,"_2648":47651},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3150":869,"_27624":839,"_19171":47653,"_5":13189,"_26134":47588,"_2648":47654},[],"`settings.enrollment_settings` field",{"_3150":870,"_27624":839,"_19171":47656,"_5":13189,"_26134":47588,"_2648":47657},[],"Decision",{"_3150":871,"_27624":839,"_19171":47659,"_5":13189,"_26134":47588,"_2648":47660},[],"`protocol`",{"_3150":872,"_27624":839,"_19171":47662,"_5":13189,"_26134":47588,"_2648":47663},[],"`EST_RFC7030` for these operations.",{"_3150":873,"_27624":839,"_19171":47665,"_5":13189,"_26134":47588,"_2648":47666},[],"`enrollment_ca`",{"_3150":874,"_27624":839,"_19171":47668,"_5":13189,"_26134":47588,"_2648":47669},[],"ID of the signing CA.",{"_3150":875,"_27624":839,"_19171":47671,"_5":13189,"_26134":47588,"_2648":47672},[],"`verify_csr_signature`",{"_3150":876,"_27624":839,"_19171":47674,"_5":13189,"_26134":47588,"_2648":47675},[],"Keep `true` to verify CSR key possession.",{"_3150":877,"_27624":839,"_19171":47677,"_5":13189,"_26134":47588,"_2648":47678},[],"`enable_replaceable_enrollment`",{"_3150":878,"_27624":839,"_19171":47680,"_5":13189,"_26134":47588,"_2648":47681},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3150":879,"_27624":839,"_19171":47683,"_5":13189,"_26134":47588,"_2648":47684},[],"`est_rfc7030_settings.auth_mode`",{"_3150":880,"_27624":839,"_19171":47686,"_5":13189,"_26134":47588,"_2648":47687},[],"One of the four authentication modes.",{"_3150":881,"_27624":839,"_19171":47689,"_5":13189,"_26134":47588,"_2648":47690},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3150":882,"_27624":839,"_19171":47692,"_5":13189,"_26134":47592,"_2648":47693},[],"The blocks are independent:",{"_3150":883,"_27624":839,"_19171":47695,"_5":13189,"_26134":47592,"_2648":47696},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3150":884,"_27624":839,"_19171":47698,"_5":13189,"_26134":47592,"_2648":47699},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3150":885,"_27624":839,"_19171":47701,"_5":13189,"_26134":47592,"_2648":47702},[],"`auth_mode`",{"_3150":886,"_27624":839,"_19171":47704,"_5":13189,"_26134":47592,"_2648":47705},[],"Control applied in the configured operation",{"_3150":887,"_27624":839,"_19171":47707,"_5":13189,"_26134":47592,"_2648":47708},[],"`CLIENT_CERTIFICATE`",{"_3150":888,"_27624":839,"_19171":47710,"_5":13189,"_26134":47592,"_2648":47711},[],"Presented certificate validation.",{"_3150":889,"_27624":839,"_19171":47713,"_5":13189,"_26134":47592,"_2648":47714},[],"`EXTERNAL_WEBHOOK`",{"_3150":890,"_27624":839,"_19171":47716,"_5":13189,"_26134":47592,"_2648":47717},[],"Configured webhook authorization.",{"_3150":891,"_27624":839,"_19171":47719,"_5":13189,"_26134":47592,"_2648":47720},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3150":892,"_27624":839,"_19171":47722,"_5":13189,"_26134":47592,"_2648":47723},[],"Certificate validation followed by webhook approval.",{"_3150":893,"_27624":839,"_19171":47725,"_5":13189,"_26134":47592,"_2648":47726},[],"`NO_AUTH`",{"_3150":894,"_27624":839,"_19171":47728,"_5":13189,"_26134":47592,"_2648":47729},[],"No DMS requester authentication.",{"_3150":895,"_27624":839,"_19171":47731,"_5":13189,"_26134":47592,"_2648":47732},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3150":896,"_27624":839,"_19171":47734,"_5":13189,"_26134":47592,"_2648":47735},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3150":897,"_27624":839,"_19171":47737,"_5":13189,"_26134":47592,"_2648":47738},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3150":898,"_27624":839,"_19171":47740,"_5":13189,"_26134":47592,"_2648":47741},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3150":899,"_27624":839,"_19171":47743,"_5":13189,"_26134":47596,"_2648":47744},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3150":900,"_27624":839,"_19171":47746,"_5":13189,"_26134":47596,"_2648":47747},[],"`external_webhook_settings` field",{"_3150":901,"_27624":839,"_19171":47749,"_5":13189,"_26134":47596,"_2648":47657},[],{"_3150":902,"_27624":839,"_19171":47751,"_5":13189,"_26134":47596,"_2648":47752},[],"`url`",{"_3150":903,"_27624":839,"_19171":47754,"_5":13189,"_26134":47596,"_2648":47755},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3150":904,"_27624":839,"_19171":47757,"_5":13189,"_26134":47596,"_2648":47758},[],"`method`",{"_3150":905,"_27624":839,"_19171":47760,"_5":13189,"_26134":47596,"_2648":47761},[],"`POST` or `PUT`; `POST` by default.",{"_3150":906,"_27624":839,"_19171":47763,"_5":13189,"_26134":47596,"_2648":47764},[],"`name`",{"_3150":907,"_27624":839,"_19171":47766,"_5":13189,"_26134":47596,"_2648":47767},[],"Label used in service logs.",{"_3150":908,"_27624":839,"_19171":47769,"_5":13189,"_26134":47596,"_2648":47770},[],"`config.auth_mode`",{"_3150":909,"_27624":839,"_19171":47772,"_5":13189,"_26134":47596,"_2648":47773},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3150":910,"_27624":839,"_19171":47775,"_5":13189,"_26134":47596,"_2648":47776},[],"`config.apikey_options`",{"_3150":911,"_27624":839,"_19171":47778,"_5":13189,"_26134":47596,"_2648":47779},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3150":912,"_27624":839,"_19171":47781,"_5":13189,"_26134":47596,"_2648":47782},[],"`config.jwt_options`",{"_3150":913,"_27624":839,"_19171":47784,"_5":13189,"_26134":47596,"_2648":47785},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3150":914,"_27624":839,"_19171":47787,"_5":13189,"_26134":47596,"_2648":47788},[],"`config.mtls_options`",{"_3150":915,"_27624":839,"_19171":47790,"_5":13189,"_26134":47596,"_2648":47791},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3150":916,"_27624":839,"_19171":47793,"_5":13189,"_26134":47596,"_2648":47794},[],"`config.insecure_skip_verify`",{"_3150":917,"_27624":839,"_19171":47796,"_5":13189,"_26134":47596,"_2648":47797},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3150":918,"_27624":839,"_19171":47799,"_5":13189,"_26134":47596,"_2648":47800},[],"`config.call_timeout`",{"_3150":919,"_27624":839,"_19171":47802,"_5":13189,"_26134":47596,"_2648":47803},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3150":920,"_27624":839,"_19171":47805,"_5":13189,"_26134":47596,"_2648":47806},[],"Rules for that configuration:",{"_3150":921,"_27624":839,"_19171":47808,"_5":13189,"_26134":47596,"_2648":47809},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3150":922,"_27624":839,"_19171":47811,"_5":13189,"_26134":47596,"_2648":47812},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3150":923,"_27624":839,"_19171":47814,"_5":13189,"_26134":47596,"_2648":47815},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3150":924,"_27624":839,"_19171":47817,"_5":13189,"_26134":47596,"_2648":47818},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3150":925,"_27624":839,"_19171":47820,"_5":13189,"_26134":47596,"_2648":47821},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3150":926,"_27624":839,"_19171":47823,"_5":13189,"_26134":47596,"_2648":47824},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3150":927,"_27624":839,"_19171":47826,"_5":13189,"_26134":47596,"_2648":47827},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_3150":928,"_27624":839,"_19171":47829,"_5":13189,"_26134":47596,"_2648":47830},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3150":929,"_27624":839,"_19171":47832,"_5":13189,"_26134":47596,"_2648":47833},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3150":930,"_27624":839,"_19171":47835,"_5":13189,"_26134":47600,"_2648":47836},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3150":931,"_27624":839,"_19171":47838,"_5":13189,"_26134":47604,"_2648":47839},[],"`settings.reenrollment_settings` field",{"_3150":932,"_27624":839,"_19171":47841,"_5":13189,"_26134":47604,"_2648":45323},[],{"_3150":933,"_27624":839,"_19171":47843,"_5":13189,"_26134":47604,"_2648":47844},[],"`reenrollment_delta`",{"_3150":934,"_27624":839,"_19171":47846,"_5":13189,"_26134":47604,"_2648":47847},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3150":935,"_27624":839,"_19171":47849,"_5":13189,"_26134":47604,"_2648":47850},[],"`preventive_delta`",{"_3150":936,"_27624":839,"_19171":47852,"_5":13189,"_26134":47604,"_2648":47853},[],"Preventive operational monitoring threshold.",{"_3150":937,"_27624":839,"_19171":47855,"_5":13189,"_26134":47604,"_2648":47856},[],"`critical_delta`",{"_3150":938,"_27624":839,"_19171":47858,"_5":13189,"_26134":47604,"_2648":47859},[],"Critical operational monitoring threshold.",{"_3150":939,"_27624":839,"_19171":47861,"_5":13189,"_26134":47604,"_2648":47862},[],"`enable_expired_renewal`",{"_3150":940,"_27624":839,"_19171":47864,"_5":13189,"_26134":47604,"_2648":47865},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3150":941,"_27624":839,"_19171":47867,"_5":13189,"_26134":47604,"_2648":47868},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3150":942,"_27624":839,"_19171":47870,"_5":13189,"_26134":47604,"_2648":47871},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_3150":943,"_27624":839,"_19171":47873,"_5":13189,"_26134":47604,"_2648":47874},[],"`revoke_on_reenrollment`",{"_3150":944,"_27624":839,"_19171":47876,"_5":13189,"_26134":47604,"_2648":47877},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3150":945,"_27624":839,"_19171":47879,"_5":13189,"_26134":47604,"_2648":47880},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3150":946,"_27624":839,"_19171":47882,"_5":13189,"_26134":47608,"_2648":47883},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3150":947,"_27624":839,"_19171":47885,"_5":13189,"_26134":47612,"_2648":45317},[],{"_3150":948,"_27624":839,"_19171":47887,"_5":13189,"_26134":47612,"_2648":47888},[],"Published material",{"_3150":949,"_27624":839,"_19171":47890,"_5":13189,"_26134":47612,"_2648":47891},[],"**Include Lamassu System CA**",{"_3150":950,"_27624":839,"_19171":47893,"_5":13189,"_26134":47612,"_2648":47894},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3150":951,"_27624":839,"_19171":47896,"_5":13189,"_26134":47612,"_2648":47897},[],"**Include Enrollment CA**",{"_3150":952,"_27624":839,"_19171":47899,"_5":13189,"_26134":47612,"_2648":47900},[],"Selected issuing CA certificate.",{"_3150":953,"_27624":839,"_19171":47902,"_5":13189,"_26134":47612,"_2648":47903},[],"**Managed CAs**",{"_3150":954,"_27624":839,"_19171":47905,"_5":13189,"_26134":47612,"_2648":47906},[],"Explicitly selected CA certificates.",{"_3150":955,"_27624":839,"_19171":47908,"_5":13189,"_26134":47612,"_2648":47909},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3150":956,"_27624":839,"_19171":47911,"_5":13189,"_26134":47616,"_2648":47912},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3150":957,"_27624":839,"_19171":47914,"_5":13189,"_26134":47616,"_2648":47915},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3150":958,"_27624":839,"_19171":47917,"_5":13189,"_26134":47616,"_2648":47918},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3150":959,"_27624":839,"_19171":47920,"_5":13189,"_26134":47620,"_2648":47921},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3150":960,"_27624":960,"_5":13515,"_2648":47923,"_27967":47924,"_19171":47925,"_26134":960},"Integrate the EST client",[44933,46313,47290,47288,47471],[],{"_3150":961,"_27624":960,"_19171":47927,"_5":13189,"_26134":960,"_2648":47928},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3150":962,"_27624":960,"_5":27964,"_19171":47930,"_26134":47931,"_2648":44943},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3150":963,"_27624":960,"_5":27964,"_19171":47933,"_26134":47934,"_2648":47935},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3150":964,"_27624":960,"_5":27964,"_19171":47937,"_26134":47938,"_2648":47939},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3150":965,"_27624":960,"_5":27964,"_19171":47941,"_26134":47942,"_2648":47943},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3150":966,"_27624":960,"_5":27964,"_19171":47945,"_26134":47946,"_2648":47947},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3150":967,"_27624":960,"_5":27964,"_19171":47949,"_26134":47950,"_2648":47951},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3150":968,"_27624":960,"_19171":47953,"_5":13189,"_26134":960,"_2648":47954},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3150":969,"_27624":960,"_19171":47956,"_5":13189,"_26134":47931,"_2648":47957},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3150":970,"_27624":960,"_19171":47959,"_5":13189,"_26134":47931,"_2648":47960},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3150":971,"_27624":960,"_19171":47962,"_5":13189,"_26134":47931,"_2648":47963},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3150":972,"_27624":960,"_19171":47965,"_5":13189,"_26134":47934,"_2648":47966},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3150":973,"_27624":960,"_19171":47968,"_5":13189,"_26134":47934,"_2648":47969},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3150":974,"_27624":960,"_19171":47971,"_5":13189,"_26134":47938,"_2648":47972},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3150":975,"_27624":960,"_19171":47974,"_5":13189,"_26134":47938,"_2648":47975},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3150":976,"_27624":960,"_19171":47977,"_5":13189,"_26134":47942,"_2648":47978},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3150":977,"_27624":960,"_19171":47980,"_5":13189,"_26134":47942,"_2648":47981},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3150":978,"_27624":960,"_19171":47983,"_5":13189,"_26134":47946,"_2648":47984},[],"For a root that issues directly:",{"_3150":979,"_27624":960,"_19171":47986,"_5":13189,"_26134":47946,"_2648":47987},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3150":980,"_27624":960,"_19171":47989,"_5":13189,"_26134":47946,"_2648":47990},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3150":981,"_27624":960,"_19171":47992,"_5":13189,"_26134":47950,"_2648":47993},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3150":982,"_27624":982,"_5":13515,"_2648":47995,"_27967":47996,"_19171":47997,"_26134":982},"EST reference",[44933,46313,47290,47288,47471],[],{"_3150":983,"_27624":982,"_19171":47999,"_5":13189,"_26134":982,"_2648":48000},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3150":984,"_27624":982,"_5":27964,"_19171":48002,"_26134":48003,"_2648":48004},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3150":985,"_27624":982,"_5":27964,"_19171":48006,"_26134":48007,"_2648":20837},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3150":986,"_27624":982,"_5":27964,"_19171":48009,"_26134":48010,"_2648":23881},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3150":987,"_27624":982,"_5":27964,"_19171":48012,"_26134":48013,"_2648":23888},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3150":988,"_27624":982,"_5":27964,"_19171":48015,"_26134":48016,"_2648":23234},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3150":989,"_27624":982,"_5":27964,"_19171":48018,"_26134":48019,"_2648":48020},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3150":990,"_27624":982,"_5":27964,"_19171":48022,"_26134":48023,"_2648":48024},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3150":991,"_27624":982,"_5":27964,"_19171":48026,"_26134":48027,"_2648":48028},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3150":992,"_27624":982,"_19171":48030,"_5":13189,"_26134":982,"_2648":48031},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3150":993,"_27624":982,"_19171":48033,"_5":13189,"_26134":48003,"_2648":48034},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3150":994,"_27624":982,"_19171":48036,"_5":13189,"_26134":48003,"_2648":48037},[],"Operation",{"_3150":995,"_27624":982,"_19171":48039,"_5":13189,"_26134":48003,"_2648":48040},[],"Method",{"_3150":996,"_27624":982,"_19171":48042,"_5":13189,"_26134":48003,"_2648":48043},[],"Authentication and condition",{"_3150":997,"_27624":982,"_19171":48045,"_5":13189,"_26134":48003,"_2648":48046},[],"`/cacerts`",{"_3150":998,"_27624":982,"_19171":48048,"_5":13189,"_26134":48003,"_2648":48049},[],"GET",{"_3150":999,"_27624":982,"_19171":48051,"_5":13189,"_26134":48003,"_2648":48052},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3150":1000,"_27624":982,"_19171":48054,"_5":13189,"_26134":48003,"_2648":48055},[],"`/simpleenroll`",{"_3150":1001,"_27624":982,"_19171":48057,"_5":13189,"_26134":48003,"_2648":48058},[],"POST",{"_3150":1002,"_27624":982,"_19171":48060,"_5":13189,"_26134":48003,"_2648":48061},[],"Initial authentication and DMS registration/replacement policy.",{"_3150":1003,"_27624":982,"_19171":48063,"_5":13189,"_26134":48003,"_2648":48064},[],"`/simplereenroll`",{"_3150":1004,"_27624":982,"_19171":48066,"_5":13189,"_26134":48003,"_2648":48058},[],{"_3150":1005,"_27624":982,"_19171":48068,"_5":13189,"_26134":48003,"_2648":48069},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3150":1006,"_27624":982,"_19171":48071,"_5":13189,"_26134":48003,"_2648":48072},[],"`/serverkeygen`",{"_3150":1007,"_27624":982,"_19171":48074,"_5":13189,"_26134":48003,"_2648":48058},[],{"_3150":1008,"_27624":982,"_19171":48076,"_5":13189,"_26134":48003,"_2648":48077},[],"Initial authentication and admission; server generation enabled.",{"_3150":1009,"_27624":982,"_19171":48079,"_5":13189,"_26134":48003,"_2648":48080},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3150":1010,"_27624":982,"_19171":48082,"_5":13189,"_26134":48007,"_2648":48083},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3150":1011,"_27624":982,"_19171":48085,"_5":13189,"_26134":48007,"_2648":48086},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3150":1012,"_27624":982,"_19171":48088,"_5":13189,"_26134":48010,"_2648":48089},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3150":1013,"_27624":982,"_19171":48091,"_5":13189,"_26134":48010,"_2648":48092},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3150":1014,"_27624":982,"_19171":48094,"_5":13189,"_26134":48013,"_2648":48095},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3150":1015,"_27624":982,"_19171":48097,"_5":13189,"_26134":48013,"_2648":48098},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3150":1016,"_27624":982,"_19171":48100,"_5":13189,"_26134":48016,"_2648":48101},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3150":1017,"_27624":982,"_19171":48103,"_5":13189,"_26134":48016,"_2648":48104},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3150":1018,"_27624":982,"_19171":48106,"_5":13189,"_26134":48019,"_2648":48107},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3150":1019,"_27624":982,"_19171":48109,"_5":13189,"_26134":48019,"_2648":48110},[],"Part",{"_3150":1020,"_27624":982,"_19171":48112,"_5":13189,"_26134":48019,"_2648":48113},[],"Content after decoding its Base64",{"_3150":1021,"_27624":982,"_19171":48115,"_5":13189,"_26134":48019,"_2648":48116},[],"`application/pkcs8`",{"_3150":1022,"_27624":982,"_19171":48118,"_5":13189,"_26134":48019,"_2648":48119},[],"Unencrypted DER PKCS#8 private key.",{"_3150":1023,"_27624":982,"_19171":48121,"_5":13189,"_26134":48019,"_2648":48122},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3150":1024,"_27624":982,"_19171":48124,"_5":13189,"_26134":48019,"_2648":48125},[],"DER PKCS#7 containing the issued certificate.",{"_3150":1025,"_27624":982,"_19171":48127,"_5":13189,"_26134":48019,"_2648":48128},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3150":1026,"_27624":982,"_19171":48130,"_5":13189,"_26134":48023,"_2648":48131},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3150":1027,"_27624":982,"_19171":48133,"_5":13189,"_26134":48023,"_2648":48134},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3150":1028,"_27624":982,"_19171":48136,"_5":13189,"_26134":48023,"_2648":48137},[],"Convert and check the result:",{"_3150":1029,"_27624":982,"_19171":48139,"_5":13189,"_26134":48023,"_2648":48140},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3150":1030,"_27624":982,"_19171":48142,"_5":13189,"_26134":48027,"_2648":48143},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3150":1031,"_27624":982,"_19171":48145,"_5":13189,"_26134":48027,"_2648":48146},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3150":1032,"_27624":1032,"_5":13515,"_2648":47471,"_27967":48148,"_19171":48149,"_26134":1032},[44933,46313,47290,47288,47471],[],{"_3150":1033,"_27624":1032,"_19171":48151,"_5":13189,"_26134":1032,"_2648":48152},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3150":1034,"_27624":1032,"_5":27964,"_19171":48154,"_26134":48155,"_2648":48156},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3150":1035,"_27624":1032,"_5":27964,"_19171":48158,"_26134":48159,"_2648":48160},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3150":1036,"_27624":1032,"_5":27964,"_19171":48162,"_26134":48163,"_2648":48164},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3150":1037,"_27624":1032,"_5":27964,"_19171":48166,"_26134":48167,"_2648":48168},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3150":1038,"_27624":1032,"_19171":48170,"_5":13189,"_26134":1032,"_2648":48171},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3150":1039,"_27624":1032,"_19171":48173,"_5":13189,"_26134":48155,"_2648":48174},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3150":1040,"_27624":1032,"_19171":48176,"_5":13189,"_26134":48155,"_2648":48177},[],"The integrator installs initial EST server trust and an admission credential.",{"_3150":1041,"_27624":1032,"_19171":48179,"_5":13189,"_26134":48155,"_2648":48180},[],"The client requests an identity for its `Device ID` through EST.",{"_3150":1042,"_27624":1032,"_19171":48182,"_5":13189,"_26134":48155,"_2648":48183},[],"Certificate, device binding and key/certificate installation are checked.",{"_3150":1043,"_27624":1032,"_19171":48185,"_5":13189,"_26134":48155,"_2648":48186},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3150":1044,"_27624":1032,"_19171":48188,"_5":13189,"_26134":48155,"_2648":48189},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3150":1045,"_27624":1032,"_19171":48191,"_5":13189,"_26134":48159,"_2648":48192},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3150":1046,"_27624":1032,"_19171":48194,"_5":13189,"_26134":48159,"_2648":48195},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":1047,"_27624":1032,"_19171":48197,"_5":13189,"_26134":48159,"_2648":48198},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3150":1048,"_27624":1032,"_19171":48200,"_5":13189,"_26134":48159,"_2648":48201},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3150":1049,"_27624":1032,"_19171":48203,"_5":13189,"_26134":48163,"_2648":48204},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":1050,"_27624":1032,"_19171":48206,"_5":13189,"_26134":48163,"_2648":48207},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":1051,"_27624":1032,"_19171":48209,"_5":13189,"_26134":48163,"_2648":48210},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3150":1052,"_27624":1032,"_19171":48212,"_5":13189,"_26134":48163,"_2648":48213},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3150":1053,"_27624":1032,"_19171":48215,"_5":13189,"_26134":48167,"_2648":48216},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3150":1054,"_27624":1032,"_19171":48218,"_5":13189,"_26134":48167,"_2648":48219},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3150":1055,"_27624":1055,"_5":13515,"_2648":48221,"_27967":48222,"_19171":48223,"_26134":1055},"Provisioning strategies",[44933,46313,47290,47288,47471],[],{"_3150":1056,"_27624":1055,"_19171":48225,"_5":13189,"_26134":1055,"_2648":48226},[],"Choose device registration, identity authorization and key generation.",{"_3150":1057,"_27624":1055,"_5":27964,"_19171":48228,"_26134":48229,"_2648":48230},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3150":1058,"_27624":1055,"_5":27964,"_19171":48232,"_26134":48233,"_2648":48234},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3150":1059,"_27624":1055,"_5":27964,"_19171":48236,"_26134":48237,"_2648":48238},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3150":1060,"_27624":1055,"_5":27964,"_19171":48240,"_26134":48241,"_2648":48242},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3150":1061,"_27624":1055,"_5":27964,"_19171":48244,"_26134":48245,"_2648":48246},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3150":1062,"_27624":1055,"_19171":48248,"_5":13189,"_26134":1055,"_2648":48249},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3150":1063,"_27624":1055,"_19171":48251,"_5":13189,"_26134":48229,"_2648":48252},[],"Path",{"_3150":1064,"_27624":1055,"_19171":48254,"_5":13189,"_26134":48229,"_2648":48255},[],"When the device exists",{"_3150":1065,"_27624":1055,"_19171":48257,"_5":13189,"_26134":48229,"_2648":48258},[],"What to check",{"_3150":1066,"_27624":1055,"_19171":48260,"_5":13189,"_26134":48229,"_2648":48261},[],"Manual assignment",{"_3150":1067,"_27624":1055,"_19171":48263,"_5":13189,"_26134":48229,"_2648":48264},[],"An operator creates it before associating a certificate.",{"_3150":1068,"_27624":1055,"_19171":48266,"_5":13189,"_26134":48229,"_2648":48267},[],"ID, owning DMS, certificate CN and bound serial.",{"_3150":1069,"_27624":1055,"_19171":48269,"_5":13189,"_26134":48229,"_2648":48270},[],"EST with `JITP`",{"_3150":1070,"_27624":1055,"_19171":48272,"_5":13189,"_26134":48229,"_2648":48273},[],"Created for an unknown CN during `/simpleenroll`.",{"_3150":1071,"_27624":1055,"_19171":48275,"_5":13189,"_26134":48229,"_2648":48276},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3150":1072,"_27624":1055,"_19171":48278,"_5":13189,"_26134":48229,"_2648":48279},[],"EST with `PRE_REGISTRATION`",{"_3150":1073,"_27624":1055,"_19171":48281,"_5":13189,"_26134":48229,"_2648":48282},[],"Must exist before `/simpleenroll`.",{"_3150":1074,"_27624":1055,"_19171":48284,"_5":13189,"_26134":48229,"_2648":48285},[],"Approved record, same DMS and replacement conditions for your version.",{"_3150":1075,"_27624":1055,"_19171":48287,"_5":13189,"_26134":48229,"_2648":48288},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3150":1076,"_27624":1055,"_19171":48290,"_5":13189,"_26134":48229,"_2648":48291},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3150":1077,"_27624":1055,"_19171":48293,"_5":13189,"_26134":48233,"_2648":48294},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3150":1078,"_27624":1055,"_19171":48296,"_5":13189,"_26134":48233,"_2648":48297},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3150":1079,"_27624":1055,"_19171":48299,"_5":13189,"_26134":48233,"_2648":48300},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3150":1080,"_27624":1055,"_19171":48302,"_5":13189,"_26134":48237,"_2648":48303},[],"Decide initial enrollment and re-enrollment separately:",{"_3150":1081,"_27624":1055,"_19171":48305,"_5":13189,"_26134":48237,"_2648":48306},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3150":1082,"_27624":1055,"_19171":48308,"_5":13189,"_26134":48237,"_2648":48309},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3150":1083,"_27624":1055,"_19171":48311,"_5":13189,"_26134":48237,"_2648":48312},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3150":1084,"_27624":1055,"_19171":48314,"_5":13189,"_26134":48237,"_2648":48315},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3150":1085,"_27624":1055,"_19171":48317,"_5":13189,"_26134":48237,"_2648":48318},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3150":1086,"_27624":1055,"_19171":48320,"_5":13189,"_26134":48241,"_2648":45317},[],{"_3150":1087,"_27624":1055,"_19171":48322,"_5":13189,"_26134":48241,"_2648":48323},[],"Material crossing EST",{"_3150":1088,"_27624":1055,"_19171":48325,"_5":13189,"_26134":48241,"_2648":48326},[],"Device-generated key",{"_3150":1089,"_27624":1055,"_19171":48328,"_5":13189,"_26134":48241,"_2648":48329},[],"Public CSR and certificate; the key stays on the client.",{"_3150":1090,"_27624":1055,"_19171":48331,"_5":13189,"_26134":48241,"_2648":48332},[],"Existing device key",{"_3150":1091,"_27624":1055,"_19171":48334,"_5":13189,"_26134":48241,"_2648":48335},[],"CSR signed with that key and a new certificate.",{"_3150":1092,"_27624":1055,"_19171":48337,"_5":13189,"_26134":48241,"_2648":47609},[],{"_3150":1093,"_27624":1055,"_19171":48339,"_5":13189,"_26134":48241,"_2648":48340},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3150":1094,"_27624":1055,"_19171":48342,"_5":13189,"_26134":48241,"_2648":48343},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3150":1095,"_27624":1055,"_19171":48345,"_5":13189,"_26134":48245,"_2648":48346},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3150":1096,"_27624":1096,"_5":13515,"_2648":48348,"_27967":48349,"_19171":48350,"_26134":1096},"Renewal and recovery",[44933,46313,47290,47288,47471],[],{"_3150":1097,"_27624":1096,"_19171":48352,"_5":13189,"_26134":1096,"_2648":48353},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3150":1098,"_27624":1096,"_5":27964,"_19171":48355,"_26134":48356,"_2648":48357},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3150":1099,"_27624":1096,"_5":27964,"_19171":48359,"_26134":48360,"_2648":48361},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3150":1100,"_27624":1096,"_5":27964,"_19171":48363,"_26134":48364,"_2648":48365},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3150":1101,"_27624":1096,"_5":27964,"_19171":48367,"_26134":48368,"_2648":48369},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3150":1102,"_27624":1096,"_5":27964,"_19171":48371,"_26134":48372,"_2648":48373},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3150":1103,"_27624":1096,"_19171":48375,"_5":13189,"_26134":1096,"_2648":48376},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3150":1104,"_27624":1096,"_19171":48378,"_5":13189,"_26134":48356,"_2648":48379},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3150":1105,"_27624":1096,"_19171":48381,"_5":13189,"_26134":48356,"_2648":48382},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3150":1106,"_27624":1096,"_19171":48384,"_5":13189,"_26134":48356,"_2648":48385},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3150":1107,"_27624":1096,"_19171":48387,"_5":13189,"_26134":48356,"_2648":48388},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3150":1108,"_27624":1096,"_19171":48390,"_5":13189,"_26134":48360,"_2648":48391},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3150":1109,"_27624":1096,"_19171":48393,"_5":13189,"_26134":48360,"_2648":48394},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3150":1110,"_27624":1096,"_19171":48396,"_5":13189,"_26134":48364,"_2648":48397},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3150":1111,"_27624":1096,"_19171":48399,"_5":13189,"_26134":48364,"_2648":48400},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3150":1112,"_27624":1096,"_19171":48402,"_5":13189,"_26134":48364,"_2648":48403},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3150":1113,"_27624":1096,"_19171":48405,"_5":13189,"_26134":48368,"_2648":48406},[],"Situation",{"_3150":1114,"_27624":1096,"_19171":48408,"_5":13189,"_26134":48368,"_2648":48409},[],"Procedure",{"_3150":1115,"_27624":1096,"_19171":48411,"_5":13189,"_26134":48368,"_2648":48412},[],"Valid certificate, outside the window",{"_3150":1116,"_27624":1096,"_19171":48414,"_5":13189,"_26134":48368,"_2648":48415},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3150":1117,"_27624":1096,"_19171":48417,"_5":13189,"_26134":48368,"_2648":48418},[],"Expired certificate, key available",{"_3150":1118,"_27624":1096,"_19171":48420,"_5":13189,"_26134":48368,"_2648":48421},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3150":1119,"_27624":1096,"_19171":48423,"_5":13189,"_26134":48368,"_2648":48424},[],"Renewal through webhook or `NO_AUTH`",{"_3150":1120,"_27624":1096,"_19171":48426,"_5":13189,"_26134":48368,"_2648":48427},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3150":1121,"_27624":1096,"_19171":48429,"_5":13189,"_26134":48368,"_2648":48430},[],"Lost or inaccessible key",{"_3150":1122,"_27624":1096,"_19171":48432,"_5":13189,"_26134":48368,"_2648":48433},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3150":1123,"_27624":1096,"_19171":48435,"_5":13189,"_26134":48368,"_2648":48436},[],"Current identity revoked",{"_3150":1124,"_27624":1096,"_19171":48438,"_5":13189,"_26134":48368,"_2648":48439},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3150":1125,"_27624":1096,"_19171":48441,"_5":13189,"_26134":48368,"_2648":48442},[],"Device without an identity",{"_3150":1126,"_27624":1096,"_19171":48444,"_5":13189,"_26134":48368,"_2648":48445},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3150":1127,"_27624":1096,"_19171":48447,"_5":13189,"_26134":48368,"_2648":48448},[],"Retired device",{"_3150":1128,"_27624":1096,"_19171":48450,"_5":13189,"_26134":48368,"_2648":48451},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3150":1129,"_27624":1096,"_19171":48453,"_5":13189,"_26134":48368,"_2648":48454},[],"Timeout, HTTP 500 or installation failure",{"_3150":1130,"_27624":1096,"_19171":48456,"_5":13189,"_26134":48368,"_2648":48457},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3150":1131,"_27624":1096,"_19171":48459,"_5":13189,"_26134":48372,"_2648":48460},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3150":1132,"_27624":1096,"_19171":48462,"_5":13189,"_26134":48372,"_2648":48463},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3150":1133,"_27624":1133,"_5":13515,"_2648":48465,"_27967":48466,"_19171":48467,"_26134":1133},"Enrollment troubleshooting",[44933,46313,47290,47288,47471],[],{"_3150":1134,"_27624":1133,"_19171":48469,"_5":13189,"_26134":1133,"_2648":48470},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3150":1135,"_27624":1133,"_5":27964,"_19171":48472,"_26134":48473,"_2648":48474},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3150":1136,"_27624":1133,"_5":27964,"_19171":48476,"_26134":48477,"_2648":48478},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3150":1137,"_27624":1133,"_5":27964,"_19171":48480,"_26134":48481,"_2648":48028},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3150":1138,"_27624":1133,"_5":27964,"_19171":48483,"_26134":48484,"_2648":48485},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3150":1139,"_27624":1133,"_19171":48487,"_5":13189,"_26134":1133,"_2648":48488},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3150":1140,"_27624":1133,"_19171":48490,"_5":13189,"_26134":48477,"_2648":48491},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3150":1141,"_27624":1133,"_19171":48493,"_5":13189,"_26134":48477,"_2648":48494},[],"Symptom or message",{"_3150":1142,"_27624":1133,"_19171":48496,"_5":13189,"_26134":48477,"_2648":48258},[],{"_3150":1143,"_27624":1133,"_19171":48498,"_5":13189,"_26134":48477,"_2648":48499},[],"curl rejects TLS, name or issuer",{"_3150":1144,"_27624":1133,"_19171":48501,"_5":13189,"_26134":48477,"_2648":48502},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3150":1145,"_27624":1133,"_19171":48504,"_5":13189,"_26134":48477,"_2648":48505},[],"404 or missing APS",{"_3150":1146,"_27624":1133,"_19171":48507,"_5":13189,"_26134":48477,"_2648":48508},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3150":1147,"_27624":1133,"_19171":48510,"_5":13189,"_26134":48477,"_2648":48511},[],"400, CSR or format error",{"_3150":1148,"_27624":1133,"_19171":48513,"_5":13189,"_26134":48477,"_2648":48514},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3150":1149,"_27624":1133,"_19171":48516,"_5":13189,"_26134":48477,"_2648":48517},[],"Missing credential or invalid certificate",{"_3150":1150,"_27624":1133,"_19171":48519,"_5":13189,"_26134":48477,"_2648":48520},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3150":1151,"_27624":1133,"_19171":48522,"_5":13189,"_26134":48477,"_2648":48523},[],"Webhook denies, times out or responds without authorization",{"_3150":1152,"_27624":1133,"_19171":48525,"_5":13189,"_26134":48477,"_2648":48526},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3150":1153,"_27624":1133,"_19171":48528,"_5":13189,"_26134":48477,"_2648":48529},[],"`unexpected status code: <n>: redirects are not followed`",{"_3150":1154,"_27624":1133,"_19171":48531,"_5":13189,"_26134":48477,"_2648":48532},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3150":1155,"_27624":1133,"_19171":48534,"_5":13189,"_26134":48477,"_2648":48535},[],"`webhook response exceeds 1048576 bytes`",{"_3150":1156,"_27624":1133,"_19171":48537,"_5":13189,"_26134":48477,"_2648":48538},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3150":1157,"_27624":1133,"_19171":48540,"_5":13189,"_26134":48477,"_2648":48541},[],"`webhook config must not reference files`",{"_3150":1158,"_27624":1133,"_19171":48543,"_5":13189,"_26134":48477,"_2648":48544},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3150":1159,"_27624":1133,"_19171":48546,"_5":13189,"_26134":48477,"_2648":48547},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3150":1160,"_27624":1133,"_19171":48549,"_5":13189,"_26134":48477,"_2648":48550},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3150":1161,"_27624":1133,"_19171":48552,"_5":13189,"_26134":48477,"_2648":48553},[],"`webhook mTLS certificate and key are invalid: …`",{"_3150":1162,"_27624":1133,"_19171":48555,"_5":13189,"_26134":48477,"_2648":48556},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3150":1163,"_27624":1133,"_19171":48558,"_5":13189,"_26134":48477,"_2648":48559},[],"400 `struct validation error` creating or updating a DMS",{"_3150":1164,"_27624":1133,"_19171":48561,"_5":13189,"_26134":48477,"_2648":48562},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3150":1165,"_27624":1133,"_19171":48564,"_5":13189,"_26134":48477,"_2648":48565},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3150":1166,"_27624":1133,"_19171":48567,"_5":13189,"_26134":48477,"_2648":48568},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3150":1167,"_27624":1133,"_19171":48570,"_5":13189,"_26134":48477,"_2648":48571},[],"`device not preregistered`",{"_3150":1168,"_27624":1133,"_19171":48573,"_5":13189,"_26134":48477,"_2648":48574},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3150":1169,"_27624":1133,"_19171":48576,"_5":13189,"_26134":48477,"_2648":48577},[],"`forbiddenNewEnrollment`",{"_3150":1170,"_27624":1133,"_19171":48579,"_5":13189,"_26134":48477,"_2648":48580},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3150":1171,"_27624":1133,"_19171":48582,"_5":13189,"_26134":48477,"_2648":48583},[],"Different owning DMS",{"_3150":1172,"_27624":1133,"_19171":48585,"_5":13189,"_26134":48477,"_2648":48586},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3150":1173,"_27624":1133,"_19171":48588,"_5":13189,"_26134":48477,"_2648":48589},[],"`invalid RawSubject bytes`",{"_3150":1174,"_27624":1133,"_19171":48591,"_5":13189,"_26134":48477,"_2648":48592},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3150":1175,"_27624":1133,"_19171":48594,"_5":13189,"_26134":48477,"_2648":48595},[],"`invalid reenroll window`",{"_3150":1176,"_27624":1133,"_19171":48597,"_5":13189,"_26134":48477,"_2648":48598},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3150":1177,"_27624":1133,"_19171":48600,"_5":13189,"_26134":48477,"_2648":48601},[],"Current certificate revoked",{"_3150":1178,"_27624":1133,"_19171":48603,"_5":13189,"_26134":48477,"_2648":48604},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3150":1179,"_27624":1133,"_19171":48606,"_5":13189,"_26134":48477,"_2648":48607},[],"CA, profile or signing error",{"_3150":1180,"_27624":1133,"_19171":48609,"_5":13189,"_26134":48477,"_2648":48610},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3150":1181,"_27624":1133,"_19171":48612,"_5":13189,"_26134":48477,"_2648":48613},[],"HTTP 200 without a device connection",{"_3150":1182,"_27624":1133,"_19171":48615,"_5":13189,"_26134":48477,"_2648":48616},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3150":1183,"_27624":1133,"_19171":48618,"_5":13189,"_26134":48477,"_2648":48619},[],"Timeout or error after issuance",{"_3150":1184,"_27624":1133,"_19171":48621,"_5":13189,"_26134":48477,"_2648":48622},[],"New certificates, current slot and previous identity's state before retrying.",{"_3150":1185,"_27624":1133,"_19171":48624,"_5":13189,"_26134":48481,"_2648":48625},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3150":1186,"_27624":1133,"_19171":48627,"_5":13189,"_26134":48481,"_2648":48628},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3150":1187,"_27624":1133,"_19171":48630,"_5":13189,"_26134":48484,"_2648":48631},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3150":1188,"_27624":1133,"_19171":48633,"_5":13189,"_26134":48484,"_2648":48634},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3150":1189,"_27624":1133,"_19171":48636,"_5":13189,"_26134":48484,"_2648":48637},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3150":1190,"_27624":1133,"_19171":48639,"_5":13189,"_26134":48484,"_2648":48640},[],"Make one request, save headers/body and query the device and certificates.",{"_3150":1191,"_27624":1133,"_19171":48642,"_5":13189,"_26134":48484,"_2648":48643},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3150":1192,"_27624":1133,"_19171":48645,"_5":13189,"_26134":48484,"_2648":48646},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3150":1193,"_27624":1133,"_19171":48648,"_5":13189,"_26134":48484,"_2648":48649},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3150":1194,"_27624":1194,"_5":13515,"_2648":48651,"_27967":48652,"_19171":48653,"_26134":1194},"Trust distribution and updates",[44933,46313,47290,47288,47471],[],{"_3150":1195,"_27624":1194,"_19171":48655,"_5":13189,"_26134":1194,"_2648":48656},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3150":1196,"_27624":1194,"_5":27964,"_19171":48658,"_26134":48659,"_2648":48660},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3150":1197,"_27624":1194,"_5":27964,"_19171":48662,"_26134":48663,"_2648":48664},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3150":1198,"_27624":1194,"_5":27964,"_19171":48666,"_26134":48667,"_2648":48668},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3150":1199,"_27624":1194,"_5":27964,"_19171":48670,"_26134":48671,"_2648":48672},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3150":1200,"_27624":1194,"_5":27964,"_19171":48674,"_26134":48675,"_2648":48676},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3150":1201,"_27624":1194,"_19171":48678,"_5":13189,"_26134":1194,"_2648":48679},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3150":1202,"_27624":1194,"_19171":48681,"_5":13189,"_26134":48659,"_2648":48682},[],"Relationship",{"_3150":1203,"_27624":1194,"_19171":48684,"_5":13189,"_26134":48659,"_2648":48685},[],"Material prepared by its owner",{"_3150":1204,"_27624":1194,"_19171":48687,"_5":13189,"_26134":48659,"_2648":48688},[],"Device → EST server",{"_3150":1205,"_27624":1194,"_19171":48690,"_5":13189,"_26134":48659,"_2648":48691},[],"Previously verified server root, chain or pin and TLS name.",{"_3150":1206,"_27624":1194,"_19171":48693,"_5":13189,"_26134":48659,"_2648":48694},[],"DMS → requester",{"_3150":1207,"_27624":1194,"_19171":48696,"_5":13189,"_26134":48659,"_2648":48697},[],"CAs and rules authorizing initial or renewal credentials.",{"_3150":1208,"_27624":1194,"_19171":48699,"_5":13189,"_26134":48659,"_2648":48700},[],"Consumer → device",{"_3150":1209,"_27624":1194,"_19171":48702,"_5":13189,"_26134":48659,"_2648":48703},[],"Operational identity roots, intermediates, validation and permissions.",{"_3150":1210,"_27624":1194,"_19171":48705,"_5":13189,"_26134":48659,"_2648":48706},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3150":1211,"_27624":1194,"_19171":48708,"_5":13189,"_26134":48663,"_2648":48709},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3150":1212,"_27624":1194,"_19171":48711,"_5":13189,"_26134":48663,"_2648":48712},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3150":1213,"_27624":1194,"_19171":48714,"_5":13189,"_26134":48667,"_2648":48715},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3150":1214,"_27624":1194,"_19171":48717,"_5":13189,"_26134":48667,"_2648":48718},[],"Select policy-approved roots as anchors.",{"_3150":1215,"_27624":1194,"_19171":48720,"_5":13189,"_26134":48667,"_2648":48721},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3150":1216,"_27624":1194,"_19171":48723,"_5":13189,"_26134":48667,"_2648":48724},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3150":1217,"_27624":1194,"_19171":48726,"_5":13189,"_26134":48667,"_2648":48727},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3150":1218,"_27624":1194,"_19171":48729,"_5":13189,"_26134":48667,"_2648":48730},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3150":1219,"_27624":1194,"_19171":48732,"_5":13189,"_26134":48671,"_2648":48733},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3150":1220,"_27624":1194,"_19171":48735,"_5":13189,"_26134":48671,"_2648":48736},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3150":1221,"_27624":1194,"_19171":48738,"_5":13189,"_26134":48671,"_2648":48739},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3150":1222,"_27624":1194,"_19171":48741,"_5":13189,"_26134":48675,"_2648":48742},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3150":1223,"_27624":1223,"_5":13515,"_2648":48744,"_27967":48745,"_19171":48747,"_26134":1223},"AWS IoT Core",[44933,46313,47290,47288,48746],"Integrations",[],{"_3150":1224,"_27624":1223,"_19171":48749,"_5":13189,"_26134":1223,"_2648":48750},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3150":1225,"_27624":1223,"_5":27964,"_19171":48752,"_26134":48753,"_2648":48754},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3150":1226,"_27624":1223,"_5":27964,"_19171":48756,"_26134":48757,"_2648":48758},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3150":1227,"_27624":1223,"_5":27964,"_19171":48760,"_26134":48761,"_2648":48762},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3150":1228,"_27624":1223,"_5":27964,"_19171":48764,"_26134":48765,"_2648":48766},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3150":1229,"_27624":1223,"_5":27964,"_19171":48768,"_26134":48769,"_2648":48770},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3150":1230,"_27624":1223,"_5":27964,"_19171":48772,"_26134":48773,"_2648":48774},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3150":1231,"_27624":1223,"_5":27964,"_19171":48776,"_26134":48777,"_2648":48778},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3150":1232,"_27624":1223,"_5":27964,"_19171":48780,"_26134":48781,"_2648":48782},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3150":1233,"_27624":1223,"_5":27964,"_19171":48784,"_26134":48785,"_2648":48786},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3150":1234,"_27624":1223,"_5":27964,"_19171":48788,"_26134":48789,"_2648":48790},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3150":1235,"_27624":1223,"_5":27964,"_19171":48792,"_26134":48793,"_2648":48794},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3150":1236,"_27624":1223,"_5":27964,"_19171":48796,"_26134":48797,"_2648":48798},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3150":1237,"_27624":1223,"_5":27964,"_19171":48800,"_26134":48801,"_2648":48802},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3150":1238,"_27624":1223,"_5":27964,"_19171":48804,"_26134":48805,"_2648":48806},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3150":1239,"_27624":1223,"_5":27964,"_19171":48808,"_26134":48809,"_2648":48810},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3150":1240,"_27624":1223,"_5":27964,"_19171":48812,"_26134":48813,"_2648":48814},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3150":1241,"_27624":1223,"_5":27964,"_19171":48816,"_26134":48817,"_2648":48818},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3150":1242,"_27624":1223,"_5":27964,"_19171":48820,"_26134":48821,"_2648":48822},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3150":1243,"_27624":1223,"_5":27964,"_19171":48824,"_26134":48825,"_2648":48826},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3150":1244,"_27624":1223,"_5":27964,"_19171":48828,"_26134":48829,"_2648":48830},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3150":1245,"_27624":1223,"_19171":48832,"_5":13189,"_26134":1223,"_2648":48833},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3150":1246,"_27624":1223,"_19171":48835,"_5":13189,"_26134":1223,"_2648":48836},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3150":1247,"_27624":1223,"_19171":48838,"_5":13189,"_26134":1223,"_2648":48839},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3150":1248,"_27624":1223,"_19171":48841,"_5":13189,"_26134":48753,"_2648":48842},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3150":1249,"_27624":1223,"_19171":48844,"_5":13189,"_26134":48753,"_2648":48845},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3150":1250,"_27624":1223,"_19171":48847,"_5":13189,"_26134":48753,"_2648":48848},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3150":1251,"_27624":1223,"_19171":48850,"_5":13189,"_26134":48753,"_2648":48851},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3150":1252,"_27624":1223,"_19171":48853,"_5":13189,"_26134":48757,"_2648":48854},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3150":1253,"_27624":1223,"_19171":48856,"_5":13189,"_26134":48761,"_2648":48857},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3150":1254,"_27624":1223,"_19171":48859,"_5":13189,"_26134":48761,"_2648":48860},[],"IAM action",{"_3150":1255,"_27624":1223,"_19171":48862,"_5":13189,"_26134":48761,"_2648":45323},[],{"_3150":1256,"_27624":1223,"_19171":48864,"_5":13189,"_26134":48761,"_2648":48865},[],"`iot:GetRegistrationCode`",{"_3150":1257,"_27624":1223,"_19171":48867,"_5":13189,"_26134":48761,"_2648":48868},[],"Obtain the verification code for CA registration in the Primary Account",{"_3150":1258,"_27624":1223,"_19171":48870,"_5":13189,"_26134":48761,"_2648":48871},[],"`iot:RegisterCACertificate`",{"_3150":1259,"_27624":1223,"_19171":48873,"_5":13189,"_26134":48761,"_2648":48874},[],"Register the CA in AWS IoT",{"_3150":1260,"_27624":1223,"_19171":48876,"_5":13189,"_26134":48761,"_2648":48877},[],"`iot:DescribeCACertificate`",{"_3150":1261,"_27624":1223,"_19171":48879,"_5":13189,"_26134":48761,"_2648":48880},[],"Check the CA registration status",{"_3150":1262,"_27624":1223,"_19171":48882,"_5":13189,"_26134":48761,"_2648":48883},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3150":1263,"_27624":1223,"_19171":48885,"_5":13189,"_26134":48761,"_2648":48886},[],"Create or update Things in IoT Core",{"_3150":1264,"_27624":1223,"_19171":48888,"_5":13189,"_26134":48761,"_2648":48889},[],"`iot:RegisterThing`",{"_3150":1265,"_27624":1223,"_19171":48891,"_5":13189,"_26134":48761,"_2648":48892},[],"Provision Things through a template",{"_3150":1266,"_27624":1223,"_19171":48894,"_5":13189,"_26134":48761,"_2648":48895},[],"`iot:RegisterCertificate`",{"_3150":1267,"_27624":1223,"_19171":48897,"_5":13189,"_26134":48761,"_2648":48898},[],"Register device certificates",{"_3150":1268,"_27624":1223,"_19171":48900,"_5":13189,"_26134":48761,"_2648":48901},[],"`iot:UpdateCertificate`",{"_3150":1269,"_27624":1223,"_19171":48903,"_5":13189,"_26134":48761,"_2648":48904},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3150":1270,"_27624":1223,"_19171":48906,"_5":13189,"_26134":48761,"_2648":48907},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3150":1271,"_27624":1223,"_19171":48909,"_5":13189,"_26134":48761,"_2648":48910},[],"Create and attach IoT policies",{"_3150":1272,"_27624":1223,"_19171":48912,"_5":13189,"_26134":48761,"_2648":48913},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3150":1273,"_27624":1223,"_19171":48915,"_5":13189,"_26134":48761,"_2648":48916},[],"Manage Thing groups",{"_3150":1274,"_27624":1223,"_19171":48918,"_5":13189,"_26134":48761,"_2648":48919},[],"`iot:CreateProvisioningTemplate`",{"_3150":1275,"_27624":1223,"_19171":48921,"_5":13189,"_26134":48761,"_2648":48922},[],"Create JITP templates",{"_3150":1276,"_27624":1223,"_19171":48924,"_5":13189,"_26134":48761,"_2648":48925},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3150":1277,"_27624":1223,"_19171":48927,"_5":13189,"_26134":48761,"_2648":48928},[],"Read and write the Device Shadow",{"_3150":1278,"_27624":1223,"_19171":48930,"_5":13189,"_26134":48761,"_2648":48931},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3150":1279,"_27624":1223,"_19171":48933,"_5":13189,"_26134":48765,"_2648":48934},[],"Parameter",{"_3150":1280,"_27624":1223,"_19171":48936,"_5":13189,"_26134":48765,"_2648":48937},[],"Type",{"_3150":1281,"_27624":1223,"_19171":48939,"_5":13189,"_26134":48765,"_2648":48940},[],"Required",{"_3150":1282,"_27624":1223,"_19171":48942,"_5":13189,"_26134":48765,"_2648":48943},[],"Description",{"_3150":1283,"_27624":1223,"_19171":48945,"_5":13189,"_26134":48765,"_2648":48946},[],"`connector_id`",{"_3150":1284,"_27624":1223,"_19171":48948,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1285,"_27624":1223,"_19171":48950,"_5":13189,"_26134":48765,"_2648":48951},[],"Yes",{"_3150":1286,"_27624":1223,"_19171":48953,"_5":13189,"_26134":48765,"_2648":48954},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3150":1287,"_27624":1223,"_19171":48956,"_5":13189,"_26134":48765,"_2648":48957},[],"`aws_config.region`",{"_3150":1288,"_27624":1223,"_19171":48959,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1289,"_27624":1223,"_19171":48961,"_5":13189,"_26134":48765,"_2648":48951},[],{"_3150":1290,"_27624":1223,"_19171":48963,"_5":13189,"_26134":48765,"_2648":48964},[],"AWS region where the connector operates.",{"_3150":1291,"_27624":1223,"_19171":48966,"_5":13189,"_26134":48765,"_2648":48967},[],"`aws_config.auth_method`",{"_3150":1292,"_27624":1223,"_19171":48969,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1293,"_27624":1223,"_19171":48971,"_5":13189,"_26134":48765,"_2648":48951},[],{"_3150":1294,"_27624":1223,"_19171":48973,"_5":13189,"_26134":48765,"_2648":48974},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3150":1295,"_27624":1223,"_19171":48976,"_5":13189,"_26134":48765,"_2648":48977},[],"`aws_config.access_key_id`",{"_3150":1296,"_27624":1223,"_19171":48979,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1297,"_27624":1223,"_19171":48981,"_5":13189,"_26134":48765,"_2648":48982},[],"Only with `auth_method=static`",{"_3150":1298,"_27624":1223,"_19171":48984,"_5":13189,"_26134":48765,"_2648":48985},[],"AWS access key.",{"_3150":1299,"_27624":1223,"_19171":48987,"_5":13189,"_26134":48765,"_2648":48988},[],"`aws_config.secret_access_key`",{"_3150":1300,"_27624":1223,"_19171":48990,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1301,"_27624":1223,"_19171":48992,"_5":13189,"_26134":48765,"_2648":48982},[],{"_3150":1302,"_27624":1223,"_19171":48994,"_5":13189,"_26134":48765,"_2648":48995},[],"AWS secret key.",{"_3150":1303,"_27624":1223,"_19171":48997,"_5":13189,"_26134":48765,"_2648":48998},[],"`aws_config.session_token`",{"_3150":1304,"_27624":1223,"_19171":49000,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1305,"_27624":1223,"_19171":49002,"_5":13189,"_26134":48765,"_2648":49003},[],"No",{"_3150":1306,"_27624":1223,"_19171":49005,"_5":13189,"_26134":48765,"_2648":49006},[],"Session token (with `auth_method=static`).",{"_3150":1307,"_27624":1223,"_19171":49008,"_5":13189,"_26134":48765,"_2648":49009},[],"`aws_config.role_arn`",{"_3150":1308,"_27624":1223,"_19171":49011,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1309,"_27624":1223,"_19171":49013,"_5":13189,"_26134":48765,"_2648":49014},[],"Only with `auth_method=role`",{"_3150":1310,"_27624":1223,"_19171":49016,"_5":13189,"_26134":48765,"_2648":49017},[],"ARN of the role to assume.",{"_3150":1311,"_27624":1223,"_19171":49019,"_5":13189,"_26134":48765,"_2648":49020},[],"`aws_config.endpoint_url`",{"_3150":1312,"_27624":1223,"_19171":49022,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1313,"_27624":1223,"_19171":49024,"_5":13189,"_26134":48765,"_2648":49003},[],{"_3150":1314,"_27624":1223,"_19171":49026,"_5":13189,"_26134":48765,"_2648":49027},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3150":1315,"_27624":1223,"_19171":49029,"_5":13189,"_26134":48765,"_2648":49030},[],"`subscriber_event_bus`",{"_3150":1316,"_27624":1223,"_19171":49032,"_5":13189,"_26134":48765,"_2648":16158},[],{"_3150":1317,"_27624":1223,"_19171":49034,"_5":13189,"_26134":48765,"_2648":48951},[],{"_3150":1318,"_27624":1223,"_19171":49036,"_5":13189,"_26134":48765,"_2648":49037},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3150":1319,"_27624":1223,"_19171":49039,"_5":13189,"_26134":48765,"_2648":49040},[],"`dms_manager_client`",{"_3150":1320,"_27624":1223,"_19171":49042,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1321,"_27624":1223,"_19171":49044,"_5":13189,"_26134":48765,"_2648":48951},[],{"_3150":1322,"_27624":1223,"_19171":49046,"_5":13189,"_26134":48765,"_2648":49047},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3150":1323,"_27624":1223,"_19171":49049,"_5":13189,"_26134":48765,"_2648":49050},[],"`device_manager_client`",{"_3150":1324,"_27624":1223,"_19171":49052,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1325,"_27624":1223,"_19171":49054,"_5":13189,"_26134":48765,"_2648":48951},[],{"_3150":1326,"_27624":1223,"_19171":49056,"_5":13189,"_26134":48765,"_2648":49057},[],"HTTP URL of Lamassu's Device Manager.",{"_3150":1327,"_27624":1223,"_19171":49059,"_5":13189,"_26134":48765,"_2648":49060},[],"`ca_client`",{"_3150":1328,"_27624":1223,"_19171":49062,"_5":13189,"_26134":48765,"_2648":22920},[],{"_3150":1329,"_27624":1223,"_19171":49064,"_5":13189,"_26134":48765,"_2648":48951},[],{"_3150":1330,"_27624":1223,"_19171":49066,"_5":13189,"_26134":48765,"_2648":49067},[],"HTTP URL of Lamassu's CA service.",{"_3150":1331,"_27624":1223,"_19171":49069,"_5":13189,"_26134":48769,"_2648":49070},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3150":1332,"_27624":1223,"_19171":49072,"_5":13189,"_26134":48773,"_2648":49073},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3150":1333,"_27624":1223,"_19171":49075,"_5":13189,"_26134":48773,"_2648":49076},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3150":1334,"_27624":1223,"_19171":49078,"_5":13189,"_26134":48777,"_2648":49079},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3150":1335,"_27624":1223,"_19171":49081,"_5":13189,"_26134":48777,"_2648":49082},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3150":1336,"_27624":1223,"_19171":49084,"_5":13189,"_26134":48777,"_2648":49085},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3150":1337,"_27624":1223,"_19171":49087,"_5":13189,"_26134":48777,"_2648":49088},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3150":1338,"_27624":1223,"_19171":49090,"_5":13189,"_26134":48777,"_2648":49091},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3150":1339,"_27624":1223,"_19171":49093,"_5":13189,"_26134":48777,"_2648":49094},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3150":1340,"_27624":1223,"_19171":49096,"_5":13189,"_26134":48781,"_2648":49097},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3150":1341,"_27624":1223,"_19171":49099,"_5":13189,"_26134":48785,"_2648":49100},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3150":1342,"_27624":1223,"_19171":49102,"_5":13189,"_26134":48785,"_2648":49103},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3150":1343,"_27624":1223,"_19171":49105,"_5":13189,"_26134":48789,"_2648":49106},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3150":1344,"_27624":1223,"_19171":49108,"_5":13189,"_26134":48793,"_2648":49109},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3150":1345,"_27624":1223,"_19171":49111,"_5":13189,"_26134":48793,"_2648":49112},[],"Creates or updates the IoT policies configured in the DMS.",{"_3150":1346,"_27624":1223,"_19171":49114,"_5":13189,"_26134":48793,"_2648":49115},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3150":1347,"_27624":1223,"_19171":49117,"_5":13189,"_26134":48793,"_2648":49118},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3150":1348,"_27624":1223,"_19171":49120,"_5":13189,"_26134":48793,"_2648":49121},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3150":1349,"_27624":1223,"_19171":49123,"_5":13189,"_26134":48793,"_2648":49124},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3150":1350,"_27624":1223,"_19171":49126,"_5":13189,"_26134":48793,"_2648":49127},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3150":1351,"_27624":1223,"_19171":49129,"_5":13189,"_26134":48797,"_2648":49130},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3150":1352,"_27624":1223,"_19171":49132,"_5":13189,"_26134":48797,"_2648":49133},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3150":1353,"_27624":1223,"_19171":49135,"_5":13189,"_26134":48797,"_2648":49136},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3150":1354,"_27624":1223,"_19171":49138,"_5":13189,"_26134":48801,"_2648":49139},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3150":1355,"_27624":1223,"_19171":49141,"_5":13189,"_26134":48801,"_2648":49142},[],"The full flow from the device's perspective is:",{"_3150":1356,"_27624":1223,"_19171":49144,"_5":13189,"_26134":48801,"_2648":49145},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3150":1357,"_27624":1223,"_19171":49147,"_5":13189,"_26134":48805,"_2648":49148},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3150":1358,"_27624":1223,"_19171":49150,"_5":13189,"_26134":48805,"_2648":49151},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3150":1359,"_27624":1223,"_19171":49153,"_5":13189,"_26134":48805,"_2648":49154},[],"For the JITP flow to work correctly:",{"_3150":1360,"_27624":1223,"_19171":49156,"_5":13189,"_26134":48805,"_2648":49157},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3150":1361,"_27624":1223,"_19171":49159,"_5":13189,"_26134":48805,"_2648":49160},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3150":1362,"_27624":1223,"_19171":49162,"_5":13189,"_26134":48805,"_2648":49163},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3150":1363,"_27624":1223,"_19171":49165,"_5":13189,"_26134":48805,"_2648":49166},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3150":1364,"_27624":1223,"_19171":49168,"_5":13189,"_26134":48809,"_2648":49169},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3150":1365,"_27624":1223,"_19171":49171,"_5":13189,"_26134":48809,"_2648":49172},[],"Status in Lamassu",{"_3150":1366,"_27624":1223,"_19171":49174,"_5":13189,"_26134":48809,"_2648":49175},[],"Revocation reason",{"_3150":1367,"_27624":1223,"_19171":49177,"_5":13189,"_26134":48809,"_2648":49178},[],"Status in AWS IoT Core",{"_3150":1368,"_27624":1223,"_19171":49180,"_5":13189,"_26134":48809,"_2648":49181},[],"`Active`",{"_3150":1369,"_27624":1223,"_19171":49183,"_5":13189,"_26134":48809,"_2648":49184},[],"None",{"_3150":1370,"_27624":1223,"_19171":49186,"_5":13189,"_26134":48809,"_2648":49187},[],"`ACTIVE`",{"_3150":1371,"_27624":1223,"_19171":49189,"_5":13189,"_26134":48809,"_2648":49190},[],"`Revoked`",{"_3150":1372,"_27624":1223,"_19171":49192,"_5":13189,"_26134":48809,"_2648":49193},[],"`certificateHold`",{"_3150":1373,"_27624":1223,"_19171":49195,"_5":13189,"_26134":48809,"_2648":49196},[],"`INACTIVE`",{"_3150":1374,"_27624":1223,"_19171":49198,"_5":13189,"_26134":48809,"_2648":49190},[],{"_3150":1375,"_27624":1223,"_19171":49200,"_5":13189,"_26134":48809,"_2648":49201},[],"Any other reason",{"_3150":1376,"_27624":1223,"_19171":49203,"_5":13189,"_26134":48809,"_2648":49204},[],"`REVOKED`",{"_3150":1377,"_27624":1223,"_19171":49206,"_5":13189,"_26134":48809,"_2648":49207},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3150":1378,"_27624":1223,"_19171":49209,"_5":13189,"_26134":48813,"_2648":49210},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3150":1379,"_27624":1223,"_19171":49212,"_5":13189,"_26134":48813,"_2648":49213},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3150":1380,"_27624":1223,"_19171":49215,"_5":13189,"_26134":48813,"_2648":49216},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3150":1381,"_27624":1223,"_19171":49218,"_5":13189,"_26134":48817,"_2648":49219},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3150":1382,"_27624":1223,"_19171":49221,"_5":13189,"_26134":48817,"_2648":49222},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3150":1383,"_27624":1223,"_19171":49224,"_5":13189,"_26134":48821,"_2648":49225},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3150":1384,"_27624":1223,"_19171":49227,"_5":13189,"_26134":48821,"_2648":49228},[],"There are two action types:",{"_3150":1385,"_27624":1223,"_19171":49230,"_5":13189,"_26134":48821,"_2648":49231},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3150":1386,"_27624":1223,"_19171":49233,"_5":13189,"_26134":48821,"_2648":49234},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3150":1387,"_27624":1223,"_19171":49236,"_5":13189,"_26134":48821,"_2648":49237},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3150":1388,"_27624":1223,"_19171":49239,"_5":13189,"_26134":48825,"_2648":49240},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3150":1389,"_27624":1223,"_19171":49242,"_5":13189,"_26134":48825,"_2648":49243},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3150":1390,"_27624":1223,"_19171":49245,"_5":13189,"_26134":48825,"_2648":49246},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3150":1391,"_27624":1223,"_19171":49248,"_5":13189,"_26134":48829,"_2648":49249},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3150":1392,"_27624":1223,"_19171":49251,"_5":13189,"_26134":48829,"_2648":49252},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3150":1393,"_27624":1223,"_19171":49254,"_5":13189,"_26134":48829,"_2648":49255},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3150":1394,"_27624":1223,"_19171":49257,"_5":13189,"_26134":48829,"_2648":49258},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3150":1395,"_27624":1223,"_19171":49260,"_5":13189,"_26134":48829,"_2648":49261},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3150":1396,"_27624":1223,"_19171":49263,"_5":13189,"_26134":48829,"_2648":49264},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3150":1397,"_27624":1223,"_19171":49266,"_5":13189,"_26134":48829,"_2648":49267},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3150":1398,"_27624":1223,"_19171":49269,"_5":13189,"_26134":48829,"_2648":49270},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3150":1399,"_27624":1223,"_19171":49272,"_5":13189,"_26134":48829,"_2648":49273},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3150":1400,"_27624":1223,"_19171":49275,"_5":13189,"_26134":48829,"_2648":49276},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3150":1401,"_27624":1223,"_19171":49278,"_5":13189,"_26134":48829,"_2648":49279},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3150":1402,"_27624":1223,"_19171":49281,"_5":13189,"_26134":48829,"_2648":49282},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3150":1403,"_27624":1223,"_19171":49284,"_5":13189,"_26134":48829,"_2648":49285},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3150":1404,"_27624":1223,"_19171":49287,"_5":13189,"_26134":48829,"_2648":49288},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3150":1405,"_27624":1223,"_19171":49290,"_5":13189,"_26134":48829,"_2648":49291},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3150":1406,"_27624":1223,"_19171":49293,"_5":13189,"_26134":48829,"_2648":49294},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3150":1407,"_27624":1223,"_19171":49296,"_5":13189,"_26134":48829,"_2648":49297},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3150":1408,"_27624":1223,"_19171":49299,"_5":13189,"_26134":48829,"_2648":49300},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3150":1409,"_27624":1223,"_19171":49302,"_5":13189,"_26134":48829,"_2648":49303},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":1410,"_27624":1223,"_19171":49305,"_5":13189,"_26134":48829,"_2648":49306},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3150":1411,"_27624":1223,"_19171":49308,"_5":13189,"_26134":48829,"_2648":49309},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3150":1412,"_27624":1412,"_5":13515,"_2648":47290,"_27967":49311,"_19171":49312,"_26134":1412},[44933,46313,47290],[],{"_3150":1413,"_27624":1412,"_19171":49314,"_5":13189,"_26134":1412,"_2648":49315},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3150":1414,"_27624":1412,"_5":27964,"_19171":49317,"_26134":49318,"_2648":49319},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#start-here","Start here",{"_3150":1415,"_27624":1412,"_5":27964,"_19171":49321,"_26134":49322,"_2648":47288},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#devices-and-identities",{"_3150":1416,"_27624":1412,"_5":27964,"_19171":49324,"_26134":49325,"_2648":47471},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#enrollment-with-pki",{"_3150":1417,"_27624":1412,"_5":27964,"_19171":49327,"_26134":49328,"_2648":48746},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#integrations",{"_3150":1418,"_27624":1412,"_5":27964,"_19171":49330,"_26134":49331,"_2648":49332},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3150":1419,"_27624":1412,"_19171":49334,"_5":13189,"_26134":1412,"_2648":49335},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3150":1420,"_27624":1412,"_19171":49337,"_5":13189,"_26134":49318,"_2648":49338},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3150":1421,"_27624":1412,"_19171":49340,"_5":13189,"_26134":49318,"_2648":49341},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3150":1422,"_27624":1412,"_19171":49343,"_5":13189,"_26134":49322,"_2648":49344},[],"Resource",{"_3150":1423,"_27624":1412,"_19171":49346,"_5":13189,"_26134":49322,"_2648":49347},[],"What it represents",{"_3150":1424,"_27624":1412,"_19171":49349,"_5":13189,"_26134":49322,"_2648":49350},[],"**Device**",{"_3150":1425,"_27624":1412,"_19171":49352,"_5":13189,"_26134":49322,"_2648":49353},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3150":1426,"_27624":1412,"_19171":49355,"_5":13189,"_26134":49322,"_2648":49356},[],"**Identity**",{"_3150":1427,"_27624":1412,"_19171":49358,"_5":13189,"_26134":49322,"_2648":49359},[],"The device's association with its certificates: an active version and a history.",{"_3150":1428,"_27624":1412,"_19171":49361,"_5":13189,"_26134":49322,"_2648":49362},[],"**DMS**",{"_3150":1429,"_27624":1412,"_19171":49364,"_5":13189,"_26134":49322,"_2648":49365},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3150":1430,"_27624":1412,"_19171":49367,"_5":13189,"_26134":49322,"_2648":49368},[],"**Fleet**",{"_3150":1431,"_27624":1412,"_19171":49370,"_5":13189,"_26134":49322,"_2648":49371},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3150":1432,"_27624":1412,"_19171":49373,"_5":13189,"_26134":49322,"_2648":49374},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3150":1433,"_27624":1412,"_19171":49376,"_5":13189,"_26134":49322,"_2648":49377},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3150":1434,"_27624":1412,"_19171":49379,"_5":13189,"_26134":49325,"_2648":49380},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3150":1435,"_27624":1412,"_19171":49382,"_5":13189,"_26134":49325,"_2648":49383},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3150":1436,"_27624":1412,"_19171":49385,"_5":13189,"_26134":49325,"_2648":49386},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3150":1437,"_27624":1412,"_19171":49388,"_5":13189,"_26134":49325,"_2648":49389},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3150":1438,"_27624":1412,"_19171":49391,"_5":13189,"_26134":49325,"_2648":49392},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3150":1439,"_27624":1412,"_19171":49394,"_5":13189,"_26134":49325,"_2648":49395},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3150":1440,"_27624":1412,"_19171":49397,"_5":13189,"_26134":49325,"_2648":49398},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":1441,"_27624":1412,"_19171":49400,"_5":13189,"_26134":49325,"_2648":49401},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":1442,"_27624":1412,"_19171":49403,"_5":13189,"_26134":49328,"_2648":49404},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3150":1443,"_27624":1412,"_19171":49406,"_5":13189,"_26134":49328,"_2648":49407},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3150":1444,"_27624":1412,"_19171":49409,"_5":13189,"_26134":49331,"_2648":49410},[],"Participant",{"_3150":1445,"_27624":1412,"_19171":49412,"_5":13189,"_26134":49331,"_2648":49413},[],"Responsibility",{"_3150":1446,"_27624":1412,"_19171":49415,"_5":13189,"_26134":49331,"_2648":49416},[],"PKI administrator",{"_3150":1447,"_27624":1412,"_19171":49418,"_5":13189,"_26134":49331,"_2648":49419},[],"CA, issuance profile, chain and revocation publication.",{"_3150":1448,"_27624":1412,"_19171":49421,"_5":13189,"_26134":49331,"_2648":49422},[],"Provisioning administrator",{"_3150":1449,"_27624":1412,"_19171":49424,"_5":13189,"_26134":49331,"_2648":49425},[],"DMS, admission, authentication per operation and inventory.",{"_3150":1450,"_27624":1412,"_19171":49427,"_5":13189,"_26134":49331,"_2648":49428},[],"Device integrator",{"_3150":1451,"_27624":1412,"_19171":49430,"_5":13189,"_26134":49331,"_2648":49431},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3150":1452,"_27624":1412,"_19171":49433,"_5":13189,"_26134":49331,"_2648":49434},[],"Consumer integrator",{"_3150":1453,"_27624":1412,"_19171":49436,"_5":13189,"_26134":49331,"_2648":49437},[],"Trusted issuers, validation and device permissions in the destination.",{"_3150":1454,"_27624":1412,"_19171":49439,"_5":13189,"_26134":49331,"_2648":49440},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3150":1455,"_27624":1455,"_5":13515,"_2648":49442,"_27967":49443,"_19171":49445,"_26134":1455},"Enroll and connect your first device",[44933,46313,47290,49444],"Getting started",[],{"_3150":1456,"_27624":1455,"_19171":49447,"_5":13189,"_26134":1455,"_2648":49448},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3150":1457,"_27624":1455,"_5":27964,"_19171":49450,"_26134":49451,"_2648":44943},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3150":1458,"_27624":1455,"_5":27964,"_19171":49453,"_26134":49454,"_2648":49455},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3150":1459,"_27624":1455,"_5":27964,"_19171":49457,"_26134":49458,"_2648":49459},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3150":1460,"_27624":1455,"_5":27964,"_19171":49461,"_26134":49462,"_2648":49463},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3150":1461,"_27624":1455,"_5":27964,"_19171":49465,"_26134":49466,"_2648":49467},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3150":1462,"_27624":1455,"_5":27964,"_19171":49469,"_26134":49470,"_2648":49471},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3150":1463,"_27624":1455,"_5":27964,"_19171":49473,"_26134":49474,"_2648":49475},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3150":1464,"_27624":1455,"_5":27964,"_19171":49477,"_26134":49478,"_2648":49479},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3150":1465,"_27624":1455,"_19171":49481,"_5":13189,"_26134":1455,"_2648":49482},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3150":1466,"_27624":1455,"_19171":49484,"_5":13189,"_26134":49451,"_2648":49485},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3150":1467,"_27624":1455,"_19171":49487,"_5":13189,"_26134":49451,"_2648":49488},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3150":1468,"_27624":1455,"_19171":49490,"_5":13189,"_26134":49451,"_2648":49491},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3150":1469,"_27624":1455,"_19171":49493,"_5":13189,"_26134":49451,"_2648":49494},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3150":1470,"_27624":1455,"_19171":49496,"_5":13189,"_26134":49451,"_2648":49497},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3150":1471,"_27624":1455,"_19171":49499,"_5":13189,"_26134":49454,"_2648":49500},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3150":1472,"_27624":1455,"_19171":49502,"_5":13189,"_26134":49454,"_2648":49503},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3150":1473,"_27624":1455,"_19171":49505,"_5":13189,"_26134":49458,"_2648":49506},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3150":1474,"_27624":1455,"_19171":49508,"_5":13189,"_26134":49458,"_2648":49509},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3150":1475,"_27624":1455,"_19171":49511,"_5":13189,"_26134":49458,"_2648":49512},[],"Setting",{"_3150":1476,"_27624":1455,"_19171":49514,"_5":13189,"_26134":49458,"_2648":49515},[],"Evaluation value",{"_3150":1477,"_27624":1455,"_19171":49517,"_5":13189,"_26134":49458,"_2648":49518},[],"Enrollment CA",{"_3150":1478,"_27624":1455,"_19171":49520,"_5":13189,"_26134":49458,"_2648":49521},[],"Issuing root from `device-root.pem`.",{"_3150":1479,"_27624":1455,"_19171":49523,"_5":13189,"_26134":49458,"_2648":47601},[],{"_3150":1480,"_27624":1455,"_19171":49525,"_5":13189,"_26134":49458,"_2648":49526},[],"The 1-hour leaf profile you just prepared.",{"_3150":1481,"_27624":1455,"_19171":49528,"_5":13189,"_26134":49458,"_2648":49529},[],"Protocol / Registration Mode",{"_3150":1482,"_27624":1455,"_19171":49531,"_5":13189,"_26134":49458,"_2648":49532},[],"`EST_RFC7030` / `JITP`.",{"_3150":1483,"_27624":1455,"_19171":49534,"_5":13189,"_26134":49458,"_2648":49535},[],"Verify CSR Signature",{"_3150":1484,"_27624":1455,"_19171":49537,"_5":13189,"_26134":49458,"_2648":49538},[],"Enabled.",{"_3150":1485,"_27624":1455,"_19171":49540,"_5":13189,"_26134":49458,"_2648":49541},[],"Enable Replaceable Enrollment",{"_3150":1486,"_27624":1455,"_19171":49543,"_5":13189,"_26134":49458,"_2648":49544},[],"Disabled; the ID must be new.",{"_3150":1487,"_27624":1455,"_19171":49546,"_5":13189,"_26134":49458,"_2648":49547},[],"Initial authentication",{"_3150":1488,"_27624":1455,"_19171":49549,"_5":13189,"_26134":49458,"_2648":49550},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3150":1489,"_27624":1455,"_19171":49552,"_5":13189,"_26134":49458,"_2648":49553},[],"Renewal authentication",{"_3150":1490,"_27624":1455,"_19171":49555,"_5":13189,"_26134":49458,"_2648":49556},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3150":1491,"_27624":1455,"_19171":49558,"_5":13189,"_26134":49458,"_2648":49559},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3150":1492,"_27624":1455,"_19171":49561,"_5":13189,"_26134":49458,"_2648":49562},[],"Empty list for this direct issuance / disabled.",{"_3150":1493,"_27624":1455,"_19171":49564,"_5":13189,"_26134":49458,"_2648":49565},[],"Re-enrollment Delta",{"_3150":1494,"_27624":1455,"_19171":49567,"_5":13189,"_26134":49458,"_2648":49568},[],"1 hour.",{"_3150":1495,"_27624":1455,"_19171":49570,"_5":13189,"_26134":49458,"_2648":49571},[],"Preventive / Critical Delta",{"_3150":1496,"_27624":1455,"_19171":49573,"_5":13189,"_26134":49458,"_2648":49574},[],"30 minutes / 10 minutes.",{"_3150":1497,"_27624":1455,"_19171":49576,"_5":13189,"_26134":49458,"_2648":49577},[],"Revoke on Re-enrollment",{"_3150":1498,"_27624":1455,"_19171":49579,"_5":13189,"_26134":49458,"_2648":49580},[],"Disabled to test the successor before retiring the previous identity.",{"_3150":1499,"_27624":1455,"_19171":49582,"_5":13189,"_26134":49458,"_2648":47609},[],{"_3150":1500,"_27624":1455,"_19171":49584,"_5":13189,"_26134":49458,"_2648":49585},[],"Disabled; the operational key is generated in the client.",{"_3150":1501,"_27624":1455,"_19171":49587,"_5":13189,"_26134":49458,"_2648":49588},[],"CA Distribution",{"_3150":1502,"_27624":1455,"_19171":49590,"_5":13189,"_26134":49458,"_2648":49591},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3150":1503,"_27624":1455,"_19171":49593,"_5":13189,"_26134":49458,"_2648":49594},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_3150":1504,"_27624":1455,"_19171":49596,"_5":13189,"_26134":49462,"_2648":49597},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3150":1505,"_27624":1455,"_19171":49599,"_5":13189,"_26134":49462,"_2648":49600},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3150":1506,"_27624":1455,"_19171":49602,"_5":13189,"_26134":49466,"_2648":49603},[],"Generate a new key and CSR with the selected identifier:",{"_3150":1507,"_27624":1455,"_19171":49605,"_5":13189,"_26134":49466,"_2648":49606},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3150":1508,"_27624":1455,"_19171":49608,"_5":13189,"_26134":49466,"_2648":49609},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3150":1509,"_27624":1455,"_19171":49611,"_5":13189,"_26134":49470,"_2648":49612},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3150":1510,"_27624":1455,"_19171":49614,"_5":13189,"_26134":49470,"_2648":49615},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3150":1511,"_27624":1455,"_19171":49617,"_5":13189,"_26134":49474,"_2648":49618},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3150":1512,"_27624":1455,"_19171":49620,"_5":13189,"_26134":49474,"_2648":49621},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3150":1513,"_27624":1455,"_19171":49623,"_5":13189,"_26134":49474,"_2648":49624},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3150":1514,"_27624":1455,"_19171":49626,"_5":13189,"_26134":49474,"_2648":49627},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3150":1515,"_27624":1455,"_19171":49629,"_5":13189,"_26134":49474,"_2648":49630},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3150":1516,"_27624":1455,"_19171":49632,"_5":13189,"_26134":49478,"_2648":49633},[],"Check",{"_3150":1517,"_27624":1455,"_19171":49635,"_5":13189,"_26134":49478,"_2648":49636},[],"Expected result",{"_3150":1518,"_27624":1455,"_19171":49638,"_5":13189,"_26134":49478,"_2648":49639},[],"Registration",{"_3150":1519,"_27624":1455,"_19171":49641,"_5":13189,"_26134":49478,"_2648":49642},[],"ID created automatically and correct DMS.",{"_3150":1520,"_27624":1455,"_19171":49644,"_5":13189,"_26134":49478,"_2648":49645},[],"Certificate",{"_3150":1521,"_27624":1455,"_19171":49647,"_5":13189,"_26134":49478,"_2648":49648},[],"CN, profile, serial and key verified.",{"_3150":1522,"_27624":1455,"_19171":49650,"_5":13189,"_26134":49478,"_2648":49651},[],"Inventory",{"_3150":1523,"_27624":1455,"_19171":49653,"_5":13189,"_26134":49478,"_2648":49654},[],"Received serial visible as the current identity and in history.",{"_3150":1524,"_27624":1455,"_19171":49656,"_5":13189,"_26134":49478,"_2648":49657},[],"Consumer",{"_3150":1525,"_27624":1455,"_19171":49659,"_5":13189,"_26134":49478,"_2648":49660},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3150":1526,"_27624":1455,"_19171":49662,"_5":13189,"_26134":49478,"_2648":49663},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3150":1527,"_27624":1455,"_19171":49665,"_5":13189,"_26134":49478,"_2648":49666},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3150":1528,"_27624":1528,"_5":13515,"_2648":47306,"_27967":49668,"_19171":49669,"_26134":1528},[44933,46313,47290,49444],[],{"_3150":1529,"_27624":1528,"_19171":49671,"_5":13189,"_26134":1528,"_2648":49672},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3150":1530,"_27624":1528,"_5":27964,"_19171":49674,"_26134":49675,"_2648":44943},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3150":1531,"_27624":1528,"_5":27964,"_19171":49677,"_26134":49678,"_2648":49679},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3150":1532,"_27624":1528,"_5":27964,"_19171":49681,"_26134":49682,"_2648":49683},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3150":1533,"_27624":1528,"_5":27964,"_19171":49685,"_26134":49686,"_2648":49687},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3150":1534,"_27624":1528,"_5":27964,"_19171":49689,"_26134":49690,"_2648":49691},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3150":1535,"_27624":1528,"_5":27964,"_19171":49693,"_26134":49694,"_2648":49695},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3150":1536,"_27624":1528,"_5":27964,"_19171":49697,"_26134":49698,"_2648":49636},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3150":1537,"_27624":1528,"_5":27964,"_19171":49700,"_26134":49701,"_2648":49702},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3150":1538,"_27624":1528,"_5":27964,"_19171":49704,"_26134":49705,"_2648":49706},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3150":1539,"_27624":1528,"_19171":49708,"_5":13189,"_26134":1528,"_2648":49709},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3150":1540,"_27624":1528,"_19171":49711,"_5":13189,"_26134":1528,"_2648":49712},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3150":1541,"_27624":1528,"_19171":49714,"_5":13189,"_26134":49675,"_2648":49715},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3150":1542,"_27624":1528,"_19171":49717,"_5":13189,"_26134":49675,"_2648":49718},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3150":1543,"_27624":1528,"_19171":49720,"_5":13189,"_26134":49675,"_2648":49721},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3150":1544,"_27624":1528,"_19171":49723,"_5":13189,"_26134":49675,"_2648":49724},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3150":1545,"_27624":1528,"_19171":49726,"_5":13189,"_26134":49678,"_2648":49727},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3150":1546,"_27624":1528,"_19171":49729,"_5":13189,"_26134":49678,"_2648":49730},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3150":1547,"_27624":1528,"_19171":49732,"_5":13189,"_26134":49678,"_2648":49733},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3150":1548,"_27624":1528,"_19171":49735,"_5":13189,"_26134":49678,"_2648":49736},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3150":1549,"_27624":1528,"_19171":49738,"_5":13189,"_26134":49678,"_2648":49739},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_3150":1550,"_27624":1528,"_19171":49741,"_5":13189,"_26134":49678,"_2648":49742},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3150":1551,"_27624":1528,"_19171":49744,"_5":13189,"_26134":49678,"_2648":49745},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3150":1552,"_27624":1528,"_19171":49747,"_5":13189,"_26134":49678,"_2648":49748},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3150":1553,"_27624":1528,"_19171":49750,"_5":13189,"_26134":49682,"_2648":49751},[],"Open **Managed Devices** and the registration action. Complete:",{"_3150":1554,"_27624":1528,"_19171":49753,"_5":13189,"_26134":49682,"_2648":49754},[],"**Device ID**: `device-001`.",{"_3150":1555,"_27624":1528,"_19171":49756,"_5":13189,"_26134":49682,"_2648":49757},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3150":1556,"_27624":1528,"_19171":49759,"_5":13189,"_26134":49682,"_2648":49760},[],"**Icon** and **Tags**: optional classification.",{"_3150":1557,"_27624":1528,"_19171":49762,"_5":13189,"_26134":49682,"_2648":49763},[],"Confirm registration.",{"_3150":1558,"_27624":1528,"_19171":49765,"_5":13189,"_26134":49686,"_2648":49766},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3150":1559,"_27624":1528,"_19171":49768,"_5":13189,"_26134":49686,"_2648":49769},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3150":1560,"_27624":1528,"_19171":49771,"_5":13189,"_26134":49690,"_2648":49772},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3150":1561,"_27624":1528,"_19171":49774,"_5":13189,"_26134":49690,"_2648":49775},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3150":1562,"_27624":1528,"_19171":49777,"_5":13189,"_26134":49694,"_2648":49778},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3150":1563,"_27624":1528,"_19171":49780,"_5":13189,"_26134":49694,"_2648":49781},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3150":1564,"_27624":1528,"_19171":49783,"_5":13189,"_26134":49698,"_2648":49633},[],{"_3150":1565,"_27624":1528,"_19171":49785,"_5":13189,"_26134":49698,"_2648":49786},[],"Result",{"_3150":1566,"_27624":1528,"_19171":49788,"_5":13189,"_26134":49698,"_2648":49789},[],"Device",{"_3150":1567,"_27624":1528,"_19171":49791,"_5":13189,"_26134":49698,"_2648":49792},[],"`device-001` appears in inventory with the expected DMS.",{"_3150":1568,"_27624":1528,"_19171":49794,"_5":13189,"_26134":49698,"_2648":49795},[],"Current identity",{"_3150":1569,"_27624":1528,"_19171":49797,"_5":13189,"_26134":49698,"_2648":49798},[],"The associated certificate matches the one you verified in PKI.",{"_3150":1570,"_27624":1528,"_19171":49800,"_5":13189,"_26134":49698,"_2648":49801},[],"History",{"_3150":1571,"_27624":1528,"_19171":49803,"_5":13189,"_26134":49698,"_2648":49804},[],"The associated issuance appears with its serial number and dates.",{"_3150":1572,"_27624":1528,"_19171":49806,"_5":13189,"_26134":49698,"_2648":49807},[],"Key and certificate",{"_3150":1573,"_27624":1528,"_19171":49809,"_5":13189,"_26134":49698,"_2648":49810},[],"You have the verified pair ready to install on the device.",{"_3150":1574,"_27624":1528,"_19171":49812,"_5":13189,"_26134":49701,"_2648":49813},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3150":1575,"_27624":1528,"_19171":49815,"_5":13189,"_26134":49701,"_2648":49816},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3150":1576,"_27624":1528,"_19171":49818,"_5":13189,"_26134":49701,"_2648":49819},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3150":1577,"_27624":1528,"_19171":49821,"_5":13189,"_26134":49701,"_2648":49822},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3150":1578,"_27624":1528,"_19171":49824,"_5":13189,"_26134":49705,"_2648":49825},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3150":1579,"_27624":1528,"_19171":49827,"_5":13189,"_26134":49705,"_2648":49828},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3150":1580,"_27624":1528,"_19171":49830,"_5":13189,"_26134":49705,"_2648":49831},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3150":1581,"_27624":1581,"_5":13515,"_2648":49833,"_27967":49834,"_19171":49835,"_26134":1581},"Lamassu IoT Platform",[44933,46313],[],{"_3150":1582,"_27624":1581,"_19171":49837,"_5":13189,"_26134":1581,"_2648":49838},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3150":1583,"_27624":1581,"_5":27964,"_19171":49840,"_26134":49841,"_2648":49319},[],"/docs/pr-preview/pr-26/platform/overview#start-here",{"_3150":1584,"_27624":1581,"_5":27964,"_19171":49843,"_26134":49844,"_2648":49845},[],"/docs/pr-preview/pr-26/platform/overview#choose-your-path","Choose your path",{"_3150":1585,"_27624":1581,"_5":27964,"_19171":49847,"_26134":49848,"_2648":49849},[],"/docs/pr-preview/pr-26/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3150":1586,"_27624":1581,"_5":27964,"_19171":49851,"_26134":49852,"_2648":49853},[],"/docs/pr-preview/pr-26/platform/overview#core-capabilities","Core capabilities",{"_3150":1587,"_27624":1581,"_5":27964,"_19171":49855,"_26134":49856,"_2648":49857},[],"/docs/pr-preview/pr-26/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3150":1588,"_27624":1581,"_5":27964,"_19171":49859,"_26134":49860,"_2648":49861},[],"/docs/pr-preview/pr-26/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3150":1589,"_27624":1581,"_5":27964,"_19171":49863,"_26134":49864,"_2648":49865},[],"/docs/pr-preview/pr-26/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3150":1590,"_27624":1581,"_5":27964,"_19171":49867,"_26134":49868,"_2648":49869},[],"/docs/pr-preview/pr-26/platform/overview#automate-device-identities","Automate device identities",{"_3150":1591,"_27624":1581,"_5":27964,"_19171":49871,"_26134":49872,"_2648":49873},[],"/docs/pr-preview/pr-26/platform/overview#publish-validation-status","Publish validation status",{"_3150":1592,"_27624":1581,"_5":27964,"_19171":49875,"_26134":49876,"_2648":49877},[],"/docs/pr-preview/pr-26/platform/overview#react-to-events","React to events",{"_3150":1593,"_27624":1581,"_5":27964,"_19171":49879,"_26134":49880,"_2648":49881},[],"/docs/pr-preview/pr-26/platform/overview#operational-reference","Operational reference",{"_3150":1594,"_27624":1581,"_19171":49883,"_5":13189,"_26134":1581,"_2648":49884},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3150":1595,"_27624":1581,"_19171":49886,"_5":13189,"_26134":49841,"_2648":49887},[],"Choose the result you need:",{"_3150":1596,"_27624":1581,"_19171":49889,"_5":13189,"_26134":49841,"_2648":49890},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":1597,"_27624":1581,"_19171":49892,"_5":13189,"_26134":49841,"_2648":49893},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":1598,"_27624":1581,"_19171":49895,"_5":13189,"_26134":49841,"_2648":49896},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3150":1599,"_27624":1581,"_19171":49898,"_5":13189,"_26134":49844,"_2648":49899},[],"Section",{"_3150":1600,"_27624":1581,"_19171":49901,"_5":13189,"_26134":49844,"_2648":49902},[],"What you manage",{"_3150":1601,"_27624":1581,"_19171":49904,"_5":13189,"_26134":49844,"_2648":49905},[],"Entry point",{"_3150":1602,"_27624":1581,"_19171":49907,"_5":13189,"_26134":49844,"_2648":49908},[],"**PKI**",{"_3150":1603,"_27624":1581,"_19171":49910,"_5":13189,"_26134":49844,"_2648":49911},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3150":1604,"_27624":1581,"_19171":49913,"_5":13189,"_26134":49844,"_2648":49914},[],"PKI overview",{"_3150":1605,"_27624":1581,"_19171":49916,"_5":13189,"_26134":49844,"_2648":49917},[],"**IoT Fleets**",{"_3150":1606,"_27624":1581,"_19171":49919,"_5":13189,"_26134":49844,"_2648":49920},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3150":1607,"_27624":1581,"_19171":49922,"_5":13189,"_26134":49844,"_2648":49923},[],"IoT Fleets overview",{"_3150":1608,"_27624":1581,"_19171":49925,"_5":13189,"_26134":49844,"_2648":49926},[],"**Administration**",{"_3150":1609,"_27624":1581,"_19171":49928,"_5":13189,"_26134":49844,"_2648":49929},[],"Operator permissions, audit and event subscriptions.",{"_3150":1610,"_27624":1581,"_19171":49931,"_5":13189,"_26134":49844,"_2648":46311},[],{"_3150":1611,"_27624":1581,"_19171":49933,"_5":13189,"_26134":49844,"_2648":49934},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3150":1612,"_27624":1581,"_19171":49936,"_5":13189,"_26134":49848,"_2648":49937},[],"An identity's journey connects four responsibilities:",{"_3150":1613,"_27624":1581,"_19171":49939,"_5":13189,"_26134":49848,"_2648":49940},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3150":1614,"_27624":1581,"_19171":49942,"_5":13189,"_26134":49848,"_2648":49943},[],"The provisioning administrator configures the DMS and initial trust.",{"_3150":1615,"_27624":1581,"_19171":49945,"_5":13189,"_26134":49848,"_2648":49946},[],"The device client requests a certificate and installs it with the matching key.",{"_3150":1616,"_27624":1581,"_19171":49948,"_5":13189,"_26134":49848,"_2648":49949},[],"The consumer validates the identity and applies its access permissions.",{"_3150":1617,"_27624":1581,"_19171":49951,"_5":13189,"_26134":49848,"_2648":49952},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3150":1618,"_27624":1581,"_19171":49954,"_5":13189,"_26134":49856,"_2648":49955},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3150":1619,"_27624":1581,"_19171":49957,"_5":13189,"_26134":49860,"_2648":49958},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3150":1620,"_27624":1581,"_19171":49960,"_5":13189,"_26134":49864,"_2648":49961},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3150":1621,"_27624":1581,"_19171":49963,"_5":13189,"_26134":49868,"_2648":49964},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3150":1622,"_27624":1581,"_19171":49966,"_5":13189,"_26134":49872,"_2648":49967},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3150":1623,"_27624":1581,"_19171":49969,"_5":13189,"_26134":49876,"_2648":49970},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3150":1624,"_27624":1581,"_19171":49972,"_5":13189,"_26134":49880,"_2648":49413},[],{"_3150":1625,"_27624":1581,"_19171":49974,"_5":13189,"_26134":49880,"_2648":49975},[],"What it prepares or checks",{"_3150":1626,"_27624":1581,"_19171":49977,"_5":13189,"_26134":49880,"_2648":49416},[],{"_3150":1627,"_27624":1581,"_19171":49979,"_5":13189,"_26134":49880,"_2648":49980},[],"Key custody, CA hierarchy, profiles and validation.",{"_3150":1628,"_27624":1581,"_19171":49982,"_5":13189,"_26134":49880,"_2648":49983},[],"Fleet administrator",{"_3150":1629,"_27624":1581,"_19171":49985,"_5":13189,"_26134":49880,"_2648":49986},[],"DMS, device admission, renewal policy and inventory.",{"_3150":1630,"_27624":1581,"_19171":49988,"_5":13189,"_26134":49880,"_2648":49428},[],{"_3150":1631,"_27624":1581,"_19171":49990,"_5":13189,"_26134":49880,"_2648":49991},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3150":1632,"_27624":1581,"_19171":49993,"_5":13189,"_26134":49880,"_2648":49434},[],{"_3150":1633,"_27624":1581,"_19171":49995,"_5":13189,"_26134":49880,"_2648":49996},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3150":1634,"_27624":1581,"_19171":49998,"_5":13189,"_26134":49880,"_2648":49999},[],"Infrastructure operator",{"_3150":1635,"_27624":1581,"_19171":50001,"_5":13189,"_26134":49880,"_2648":50002},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3150":1636,"_27624":1581,"_19171":50004,"_5":13189,"_26134":49880,"_2648":50005},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3150":1637,"_27624":1637,"_5":13515,"_2648":50007,"_27967":50008,"_19171":50011,"_26134":1637},"CA hierarchy and rotation",[44933,46313,50009,50010],"PKI","Keys, authorities and certificates",[],{"_3150":1638,"_27624":1637,"_19171":50013,"_5":13189,"_26134":1637,"_2648":50014},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3150":1639,"_27624":1637,"_5":27964,"_19171":50016,"_26134":50017,"_2648":50018},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3150":1640,"_27624":1637,"_5":27964,"_19171":50020,"_26134":50021,"_2648":50022},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3150":1641,"_27624":1637,"_5":27964,"_19171":50024,"_26134":50025,"_2648":50026},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3150":1642,"_27624":1637,"_5":27964,"_19171":50028,"_26134":50029,"_2648":50030},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3150":1643,"_27624":1637,"_5":27964,"_19171":50032,"_26134":50033,"_2648":50034},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3150":1644,"_27624":1637,"_5":27964,"_19171":50036,"_26134":50037,"_2648":50038},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3150":1645,"_27624":1637,"_5":27964,"_19171":50040,"_26134":50041,"_2648":50042},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3150":1646,"_27624":1637,"_5":27964,"_19171":50044,"_26134":50045,"_2648":50046},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3150":1647,"_27624":1637,"_5":27964,"_19171":50048,"_26134":50049,"_2648":50050},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3150":1648,"_27624":1637,"_5":27964,"_19171":50052,"_26134":50053,"_2648":50054},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3150":1649,"_27624":1637,"_5":27964,"_19171":50056,"_26134":50057,"_2648":50058},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3150":1650,"_27624":1637,"_5":27964,"_19171":50060,"_26134":50061,"_2648":50062},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3150":1651,"_27624":1637,"_19171":50064,"_5":13189,"_26134":1637,"_2648":50065},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3150":1652,"_27624":1637,"_19171":50067,"_5":13189,"_26134":1637,"_2648":50068},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3150":1653,"_27624":1637,"_19171":50070,"_5":13189,"_26134":50017,"_2648":50071},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3150":1654,"_27624":1637,"_19171":50073,"_5":13189,"_26134":50017,"_2648":50074},[],"environment, such as production and preproduction;",{"_3150":1655,"_27624":1637,"_19171":50076,"_5":13189,"_26134":50017,"_2648":50077},[],"owner or operating team;",{"_3150":1656,"_27624":1637,"_19171":50079,"_5":13189,"_26134":50017,"_2648":50080},[],"device family or manufacturing process;",{"_3150":1657,"_27624":1637,"_19171":50082,"_5":13189,"_26134":50017,"_2648":50083},[],"region or regulatory requirement;",{"_3150":1658,"_27624":1637,"_19171":50085,"_5":13189,"_26134":50017,"_2648":50086},[],"cryptographic engine or key policy;",{"_3150":1659,"_27624":1637,"_19171":50088,"_5":13189,"_26134":50017,"_2648":50089},[],"maintenance window and renewal cadence.",{"_3150":1660,"_27624":1637,"_19171":50091,"_5":13189,"_26134":50017,"_2648":50092},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3150":1661,"_27624":1637,"_19171":50094,"_5":13189,"_26134":50017,"_2648":50095},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3150":1662,"_27624":1637,"_19171":50097,"_5":13189,"_26134":50021,"_2648":50098},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3150":1663,"_27624":1637,"_19171":50100,"_5":13189,"_26134":50021,"_2648":50101},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3150":1664,"_27624":1637,"_19171":50103,"_5":13189,"_26134":50021,"_2648":50104},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3150":1665,"_27624":1637,"_19171":50106,"_5":13189,"_26134":50025,"_2648":50107},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3150":1666,"_27624":1637,"_19171":50109,"_5":13189,"_26134":50025,"_2648":50110},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3150":1667,"_27624":1637,"_19171":50112,"_5":13189,"_26134":50025,"_2648":50113},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3150":1668,"_27624":1637,"_19171":50115,"_5":13189,"_26134":50025,"_2648":50116},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3150":1669,"_27624":1637,"_19171":50118,"_5":13189,"_26134":50033,"_2648":50119},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3150":1670,"_27624":1637,"_19171":50121,"_5":13189,"_26134":50037,"_2648":50122},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3150":1671,"_27624":1637,"_19171":50124,"_5":13189,"_26134":50041,"_2648":50125},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3150":1672,"_27624":1637,"_19171":50127,"_5":13189,"_26134":50045,"_2648":50128},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_3150":1673,"_27624":1637,"_19171":50130,"_5":13189,"_26134":50049,"_2648":50131},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3150":1674,"_27624":1637,"_19171":50133,"_5":13189,"_26134":50053,"_2648":50134},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_3150":1675,"_27624":1637,"_19171":50136,"_5":13189,"_26134":50057,"_2648":50137},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3150":1676,"_27624":1637,"_19171":50139,"_5":13189,"_26134":50057,"_2648":50140},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3150":1677,"_27624":1637,"_19171":50142,"_5":13189,"_26134":50057,"_2648":50143},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3150":1678,"_27624":1637,"_19171":50145,"_5":13189,"_26134":50057,"_2648":50146},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3150":1679,"_27624":1637,"_19171":50148,"_5":13189,"_26134":50061,"_2648":50149},[],"The new chain ends in an anchor installed by the consumer.",{"_3150":1680,"_27624":1637,"_19171":50151,"_5":13189,"_26134":50061,"_2648":50152},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3150":1681,"_27624":1637,"_19171":50154,"_5":13189,"_26134":50061,"_2648":50155},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3150":1682,"_27624":1637,"_19171":50157,"_5":13189,"_26134":50061,"_2648":50158},[],"Re-enrollment accepts the old identity during the planned period.",{"_3150":1683,"_27624":1637,"_19171":50160,"_5":13189,"_26134":50061,"_2648":50161},[],"OCSP and CRL respond for the authorities that remain active.",{"_3150":1684,"_27624":1637,"_19171":50163,"_5":13189,"_26134":50061,"_2648":50164},[],"No DMS is left accidentally issuing from the old CA.",{"_3150":1685,"_27624":1637,"_19171":50166,"_5":13189,"_26134":50061,"_2648":50167},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3150":1686,"_27624":1686,"_5":13515,"_2648":50169,"_27967":50170,"_19171":50171,"_26134":1686},"Certification authorities",[44933,46313,50009,50010],[],{"_3150":1687,"_27624":1686,"_19171":50173,"_5":13189,"_26134":1686,"_2648":50174},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3150":1688,"_27624":1686,"_5":27964,"_19171":50176,"_26134":50177,"_2648":50178},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3150":1689,"_27624":1686,"_5":27964,"_19171":50180,"_26134":50181,"_2648":50182},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3150":1690,"_27624":1686,"_5":27964,"_19171":50184,"_26134":50185,"_2648":44943},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#before-you-begin",{"_3150":1691,"_27624":1686,"_5":27964,"_19171":50187,"_26134":50188,"_2648":50189},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3150":1692,"_27624":1686,"_5":27964,"_19171":50191,"_26134":50192,"_2648":50193},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3150":1693,"_27624":1686,"_5":27964,"_19171":50195,"_26134":50196,"_2648":50197},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3150":1694,"_27624":1686,"_5":27964,"_19171":50199,"_26134":50200,"_2648":50201},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3150":1695,"_27624":1686,"_5":27964,"_19171":50203,"_26134":50204,"_2648":50205},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3150":1696,"_27624":1686,"_5":27964,"_19171":50207,"_26134":50208,"_2648":50209},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3150":1697,"_27624":1686,"_5":27964,"_19171":50211,"_26134":50212,"_2648":50213},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3150":1698,"_27624":1686,"_5":27964,"_19171":50215,"_26134":50216,"_2648":50217},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3150":1699,"_27624":1686,"_5":27964,"_19171":50219,"_26134":50220,"_2648":50221},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3150":1700,"_27624":1686,"_5":27964,"_19171":50223,"_26134":50224,"_2648":50225},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3150":1701,"_27624":1686,"_5":27964,"_19171":50227,"_26134":50228,"_2648":50229},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3150":1702,"_27624":1686,"_5":27964,"_19171":50231,"_26134":50232,"_2648":50233},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3150":1703,"_27624":1686,"_5":27964,"_19171":50235,"_26134":50236,"_2648":50237},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3150":1704,"_27624":1686,"_5":27964,"_19171":50239,"_26134":50240,"_2648":50241},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3150":1705,"_27624":1686,"_5":27964,"_19171":50243,"_26134":50244,"_2648":50245},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3150":1706,"_27624":1686,"_5":27964,"_19171":50247,"_26134":50248,"_2648":50249},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3150":1707,"_27624":1686,"_5":27964,"_19171":50251,"_26134":50252,"_2648":50253},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3150":1708,"_27624":1686,"_5":27964,"_19171":50255,"_26134":50256,"_2648":50257},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3150":1709,"_27624":1686,"_5":27964,"_19171":50259,"_26134":50260,"_2648":50261},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3150":1710,"_27624":1686,"_19171":50263,"_5":13189,"_26134":1686,"_2648":50264},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3150":1711,"_27624":1686,"_19171":50266,"_5":13189,"_26134":1686,"_2648":50267},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3150":1712,"_27624":1686,"_19171":50269,"_5":13189,"_26134":1686,"_2648":50270},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3150":1713,"_27624":1686,"_19171":50272,"_5":13189,"_26134":50177,"_2648":50273},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3150":1714,"_27624":1686,"_19171":50275,"_5":13189,"_26134":50177,"_2648":50276},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3150":1715,"_27624":1686,"_19171":50278,"_5":13189,"_26134":50177,"_2648":50279},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3150":1716,"_27624":1686,"_19171":50281,"_5":13189,"_26134":50177,"_2648":50282},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3150":1717,"_27624":1686,"_19171":50284,"_5":13189,"_26134":50177,"_2648":50285},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3150":1718,"_27624":1686,"_19171":50287,"_5":13189,"_26134":50185,"_2648":50288},[],"Decide whether the CA will be a root or an intermediate.",{"_3150":1719,"_27624":1686,"_19171":50290,"_5":13189,"_26134":50185,"_2648":50291},[],"Choose the engine that will keep the key.",{"_3150":1720,"_27624":1686,"_19171":50293,"_5":13189,"_26134":50185,"_2648":50294},[],"Define a validity longer than that of the certificates it will issue.",{"_3150":1721,"_27624":1686,"_19171":50296,"_5":13189,"_26134":50185,"_2648":50297},[],"For an intermediate CA, make sure the parent CA is active.",{"_3150":1722,"_27624":1686,"_19171":50299,"_5":13189,"_26134":50188,"_2648":50300},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3150":1723,"_27624":1686,"_19171":50302,"_5":13189,"_26134":50192,"_2648":50303},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3150":1724,"_27624":1686,"_19171":50305,"_5":13189,"_26134":50192,"_2648":50306},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3150":1725,"_27624":1686,"_19171":50308,"_5":13189,"_26134":50196,"_2648":50309},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3150":1726,"_27624":1686,"_19171":50311,"_5":13189,"_26134":50200,"_2648":50312},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3150":1727,"_27624":1686,"_19171":50314,"_5":13189,"_26134":50200,"_2648":50315},[],"`C`: two-letter ISO 3166-1 country code.",{"_3150":1728,"_27624":1686,"_19171":50317,"_5":13189,"_26134":50200,"_2648":50318},[],"`ST`: state or province.",{"_3150":1729,"_27624":1686,"_19171":50320,"_5":13189,"_26134":50200,"_2648":50321},[],"`L`: locality.",{"_3150":1730,"_27624":1686,"_19171":50323,"_5":13189,"_26134":50200,"_2648":50324},[],"`O`: organization.",{"_3150":1731,"_27624":1686,"_19171":50326,"_5":13189,"_26134":50200,"_2648":50327},[],"`OU`: organizational unit.",{"_3150":1732,"_27624":1686,"_19171":50329,"_5":13189,"_26134":50200,"_2648":50330},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3150":1733,"_27624":1686,"_19171":50332,"_5":13189,"_26134":50204,"_2648":50333},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3150":1734,"_27624":1686,"_19171":50335,"_5":13189,"_26134":50204,"_2648":50336},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3150":1735,"_27624":1686,"_19171":50338,"_5":13189,"_26134":50208,"_2648":50339},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3150":1736,"_27624":1686,"_19171":50341,"_5":13189,"_26134":50208,"_2648":50342},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3150":1737,"_27624":1686,"_19171":50344,"_5":13189,"_26134":50212,"_2648":50345},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3150":1738,"_27624":1686,"_19171":50347,"_5":13189,"_26134":50212,"_2648":50348},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3150":1739,"_27624":1686,"_19171":50350,"_5":13189,"_26134":50216,"_2648":50351},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3150":1740,"_27624":1686,"_19171":50353,"_5":13189,"_26134":50220,"_2648":50354},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3150":1741,"_27624":1686,"_19171":50356,"_5":13189,"_26134":50224,"_2648":50357},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3150":1742,"_27624":1686,"_19171":50359,"_5":13189,"_26134":50228,"_2648":50360},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3150":1743,"_27624":1686,"_19171":50362,"_5":13189,"_26134":50232,"_2648":50363},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3150":1744,"_27624":1686,"_19171":50365,"_5":13189,"_26134":50232,"_2648":50366},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3150":1745,"_27624":1686,"_19171":50368,"_5":13189,"_26134":50236,"_2648":50369},[],"Open a CA from the inventory to review:",{"_3150":1746,"_27624":1686,"_19171":50371,"_5":13189,"_26134":50236,"_2648":50372},[],"Status and validity period.",{"_3150":1747,"_27624":1686,"_19171":50374,"_5":13189,"_26134":50236,"_2648":50375},[],"Certificate and chain in PEM format.",{"_3150":1748,"_27624":1686,"_19171":50377,"_5":13189,"_26134":50236,"_2648":50378},[],"Number of active, expired and revoked certificates.",{"_3150":1749,"_27624":1686,"_19171":50380,"_5":13189,"_26134":50236,"_2648":50381},[],"Certificates issued in **Issued Certificates**.",{"_3150":1750,"_27624":1686,"_19171":50383,"_5":13189,"_26134":50236,"_2648":50384},[],"The CRL linked to the authority.",{"_3150":1751,"_27624":1686,"_19171":50386,"_5":13189,"_26134":50236,"_2648":50387},[],"Metadata and the associated cryptographic engine.",{"_3150":1752,"_27624":1686,"_19171":50389,"_5":13189,"_26134":50236,"_2648":50390},[],"You can filter the inventory by name, status and CA type.",{"_3150":1753,"_27624":1686,"_19171":50392,"_5":13189,"_26134":50240,"_2648":50393},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3150":1754,"_27624":1686,"_19171":50395,"_5":13189,"_26134":50240,"_2648":50396},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3150":1755,"_27624":1686,"_19171":50398,"_5":13189,"_26134":50240,"_2648":50399},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3150":1756,"_27624":1686,"_19171":50401,"_5":13189,"_26134":50240,"_2648":50402},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3150":1757,"_27624":1686,"_19171":50404,"_5":13189,"_26134":50244,"_2648":50405},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3150":1758,"_27624":1686,"_19171":50407,"_5":13189,"_26134":50248,"_2648":50408},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3150":1759,"_27624":1686,"_19171":50410,"_5":13189,"_26134":50252,"_2648":50411},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3150":1760,"_27624":1686,"_19171":50413,"_5":13189,"_26134":50256,"_2648":50414},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3150":1761,"_27624":1686,"_19171":50416,"_5":13189,"_26134":50260,"_2648":50417},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3150":1762,"_27624":1686,"_19171":50419,"_5":13189,"_26134":50260,"_2648":50420},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3150":1763,"_27624":1763,"_5":13515,"_2648":50422,"_27967":50423,"_19171":50424,"_26134":1763},"Certificate profiles",[44933,46313,50009,50010],[],{"_3150":1764,"_27624":1763,"_19171":50426,"_5":13189,"_26134":1763,"_2648":50427},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3150":1765,"_27624":1763,"_5":27964,"_19171":50429,"_26134":50430,"_2648":50431},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3150":1766,"_27624":1763,"_5":27964,"_19171":50433,"_26134":50434,"_2648":50435},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#validity","Validity",{"_3150":1767,"_27624":1763,"_5":27964,"_19171":50437,"_26134":50438,"_2648":50439},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3150":1768,"_27624":1763,"_5":27964,"_19171":50441,"_26134":50442,"_2648":50443},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3150":1769,"_27624":1763,"_5":27964,"_19171":50445,"_26134":50446,"_2648":50447},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#subject","Subject",{"_3150":1770,"_27624":1763,"_5":27964,"_19171":50449,"_26134":50450,"_2648":50451},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3150":1771,"_27624":1763,"_5":27964,"_19171":50453,"_26134":50454,"_2648":50455},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3150":1772,"_27624":1763,"_5":27964,"_19171":50457,"_26134":50458,"_2648":50459},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3150":1773,"_27624":1763,"_5":27964,"_19171":50461,"_26134":50462,"_2648":50463},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3150":1774,"_27624":1763,"_5":27964,"_19171":50465,"_26134":50466,"_2648":50467},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3150":1775,"_27624":1763,"_5":27964,"_19171":50469,"_26134":50470,"_2648":50471},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3150":1776,"_27624":1763,"_5":27964,"_19171":50473,"_26134":50474,"_2648":50475},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3150":1777,"_27624":1763,"_5":27964,"_19171":50477,"_26134":50478,"_2648":50479},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3150":1778,"_27624":1763,"_5":27964,"_19171":50481,"_26134":50482,"_2648":50483},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3150":1779,"_27624":1763,"_5":27964,"_19171":50485,"_26134":50486,"_2648":50487},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#design-examples","Design examples",{"_3150":1780,"_27624":1763,"_5":27964,"_19171":50489,"_26134":50490,"_2648":50491},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3150":1781,"_27624":1763,"_19171":50493,"_5":13189,"_26134":1763,"_2648":50494},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3150":1782,"_27624":1763,"_19171":50496,"_5":13189,"_26134":1763,"_2648":50497},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3150":1783,"_27624":1763,"_19171":50499,"_5":13189,"_26134":50434,"_2648":50500},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3150":1784,"_27624":1763,"_19171":50502,"_5":13189,"_26134":50434,"_2648":50503},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3150":1785,"_27624":1763,"_19171":50505,"_5":13189,"_26134":50438,"_2648":50506},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3150":1786,"_27624":1763,"_19171":50508,"_5":13189,"_26134":50442,"_2648":50509},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3150":1787,"_27624":1763,"_19171":50511,"_5":13189,"_26134":50442,"_2648":50512},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3150":1788,"_27624":1763,"_19171":50514,"_5":13189,"_26134":50442,"_2648":50515},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3150":1789,"_27624":1763,"_19171":50517,"_5":13189,"_26134":50446,"_2648":50518},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3150":1790,"_27624":1763,"_19171":50520,"_5":13189,"_26134":50450,"_2648":50521},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3150":1791,"_27624":1763,"_19171":50523,"_5":13189,"_26134":50450,"_2648":50524},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3150":1792,"_27624":1763,"_19171":50526,"_5":13189,"_26134":50454,"_2648":50527},[],"The cryptographic enforcement can:",{"_3150":1793,"_27624":1763,"_19171":50529,"_5":13189,"_26134":50454,"_2648":50530},[],"allow or block RSA keys;",{"_3150":1794,"_27624":1763,"_19171":50532,"_5":13189,"_26134":50454,"_2648":50533},[],"limit the supported RSA sizes;",{"_3150":1795,"_27624":1763,"_19171":50535,"_5":13189,"_26134":50454,"_2648":50536},[],"allow or block ECDSA keys;",{"_3150":1796,"_27624":1763,"_19171":50538,"_5":13189,"_26134":50454,"_2648":50539},[],"limit the supported ECDSA sizes or curves.",{"_3150":1797,"_27624":1763,"_19171":50541,"_5":13189,"_26134":50454,"_2648":50542},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3150":1798,"_27624":1763,"_19171":50544,"_5":13189,"_26134":50458,"_2648":50545},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3150":1799,"_27624":1763,"_19171":50547,"_5":13189,"_26134":50458,"_2648":48037},[],{"_3150":1800,"_27624":1763,"_19171":50549,"_5":13189,"_26134":50458,"_2648":50550},[],"First choice",{"_3150":1801,"_27624":1763,"_19171":50552,"_5":13189,"_26134":50458,"_2648":50553},[],"Second choice",{"_3150":1802,"_27624":1763,"_19171":50555,"_5":13189,"_26134":50458,"_2648":50556},[],"If neither is supplied",{"_3150":1803,"_27624":1763,"_19171":50558,"_5":13189,"_26134":50458,"_2648":50559},[],"Direct signing with a CA",{"_3150":1804,"_27624":1763,"_19171":50561,"_5":13189,"_26134":50458,"_2648":50562},[],"`issuance_profile` embedded in the request",{"_3150":1805,"_27624":1763,"_19171":50564,"_5":13189,"_26134":50458,"_2648":50565},[],"Request `issuance_profile_id`",{"_3150":1806,"_27624":1763,"_19171":50567,"_5":13189,"_26134":50458,"_2648":50568},[],"CA default profile (`profile_id`).",{"_3150":1807,"_27624":1763,"_19171":50570,"_5":13189,"_26134":50458,"_2648":50571},[],"Issuance through a DMS",{"_3150":1808,"_27624":1763,"_19171":50573,"_5":13189,"_26134":50458,"_2648":50574},[],"`settings.issuance_profile_id`",{"_3150":1809,"_27624":1763,"_19171":50576,"_5":13189,"_26134":50458,"_2648":50577},[],"`settings.issuance_profile` embedded in the DMS",{"_3150":1810,"_27624":1763,"_19171":50579,"_5":13189,"_26134":50458,"_2648":50580},[],"Enrollment CA default profile.",{"_3150":1811,"_27624":1763,"_19171":50582,"_5":13189,"_26134":50458,"_2648":50583},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3150":1812,"_27624":1763,"_19171":50585,"_5":13189,"_26134":50458,"_2648":50586},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3150":1813,"_27624":1763,"_19171":50588,"_5":13189,"_26134":50466,"_2648":50589},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3150":1814,"_27624":1763,"_19171":50591,"_5":13189,"_26134":50470,"_2648":50592},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3150":1815,"_27624":1763,"_19171":50594,"_5":13189,"_26134":50474,"_2648":50595},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3150":1816,"_27624":1763,"_19171":50597,"_5":13189,"_26134":50478,"_2648":50598},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3150":1817,"_27624":1763,"_19171":50600,"_5":13189,"_26134":50482,"_2648":50601},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3150":1818,"_27624":1763,"_19171":50603,"_5":13189,"_26134":50482,"_2648":50604},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3150":1819,"_27624":1763,"_19171":50606,"_5":13189,"_26134":50486,"_2648":50607},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3150":1820,"_27624":1763,"_19171":50609,"_5":13189,"_26134":50486,"_2648":50610},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3150":1821,"_27624":1763,"_19171":50612,"_5":13189,"_26134":50486,"_2648":50613},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3150":1822,"_27624":1763,"_19171":50615,"_5":13189,"_26134":50486,"_2648":50616},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3150":1823,"_27624":1763,"_19171":50618,"_5":13189,"_26134":50490,"_2648":50619},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3150":1824,"_27624":1763,"_19171":50621,"_5":13189,"_26134":50490,"_2648":50622},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3150":1825,"_27624":1825,"_5":13515,"_2648":50624,"_27967":50625,"_19171":50627,"_26134":1825},"Certificate validation",[44933,46313,50009,50626],"Validation",[],{"_3150":1826,"_27624":1825,"_19171":50629,"_5":13189,"_26134":1825,"_2648":50630},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3150":1827,"_27624":1825,"_5":27964,"_19171":50632,"_26134":50633,"_2648":50634},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3150":1828,"_27624":1825,"_5":27964,"_19171":50636,"_26134":50637,"_2648":50638},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3150":1829,"_27624":1825,"_5":27964,"_19171":50640,"_26134":50641,"_2648":50642},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3150":1830,"_27624":1825,"_19171":50644,"_5":13189,"_26134":1825,"_2648":50645},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3150":1831,"_27624":1825,"_19171":50647,"_5":13189,"_26134":50633,"_2648":50648},[],"Verify these criteria together:",{"_3150":1832,"_27624":1825,"_19171":50650,"_5":13189,"_26134":50633,"_2648":49633},[],{"_3150":1833,"_27624":1825,"_19171":50652,"_5":13189,"_26134":50633,"_2648":50653},[],"Required result",{"_3150":1834,"_27624":1825,"_19171":50655,"_5":13189,"_26134":50633,"_2648":50656},[],"Chain and signature",{"_3150":1835,"_27624":1825,"_19171":50658,"_5":13189,"_26134":50633,"_2648":50659},[],"Valid chain to a root deliberately installed in the consumer.",{"_3150":1836,"_27624":1825,"_19171":50661,"_5":13189,"_26134":50633,"_2648":50662},[],"Dates",{"_3150":1837,"_27624":1825,"_19171":50664,"_5":13189,"_26134":50633,"_2648":50665},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3150":1838,"_27624":1825,"_19171":50667,"_5":13189,"_26134":50633,"_2648":46013},[],{"_3150":1839,"_27624":1825,"_19171":50669,"_5":13189,"_26134":50633,"_2648":50670},[],"Name, SAN or identifier matches the expected peer.",{"_3150":1840,"_27624":1825,"_19171":50672,"_5":13189,"_26134":50633,"_2648":45323},[],{"_3150":1841,"_27624":1825,"_19171":50674,"_5":13189,"_26134":50633,"_2648":50675},[],"KU, EKU and constraints permit the specific operation.",{"_3150":1842,"_27624":1825,"_19171":50677,"_5":13189,"_26134":50633,"_2648":50678},[],"Revocation",{"_3150":1843,"_27624":1825,"_19171":50680,"_5":13189,"_26134":50633,"_2648":50681},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3150":1844,"_27624":1825,"_19171":50683,"_5":13189,"_26134":50633,"_2648":50684},[],"Authorization",{"_3150":1845,"_27624":1825,"_19171":50686,"_5":13189,"_26134":50633,"_2648":50687},[],"The application permits that identity to perform the action.",{"_3150":1846,"_27624":1825,"_19171":50689,"_5":13189,"_26134":50633,"_2648":50690},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3150":1847,"_27624":1825,"_19171":50692,"_5":13189,"_26134":50637,"_2648":50693},[],"Mechanism",{"_3150":1848,"_27624":1825,"_19171":50695,"_5":13189,"_26134":50637,"_2648":50696},[],"When to use it",{"_3150":1849,"_27624":1825,"_19171":50698,"_5":13189,"_26134":50637,"_2648":50699},[],"What you must maintain",{"_3150":1850,"_27624":1825,"_19171":50701,"_5":13189,"_26134":50637,"_2648":50702},[],"OCSP",{"_3150":1851,"_27624":1825,"_19171":50704,"_5":13189,"_26134":50637,"_2648":50705},[],"Status query for a specific certificate.",{"_3150":1852,"_27624":1825,"_19171":50707,"_5":13189,"_26134":50637,"_2648":50708},[],"Responder access, signature verification and cache/freshness policy.",{"_3150":1853,"_27624":1825,"_19171":50710,"_5":13189,"_26134":50637,"_2648":50711},[],"CRL",{"_3150":1854,"_27624":1825,"_19171":50713,"_5":13189,"_26134":50637,"_2648":50714},[],"Local checks for many certificates or offline operation.",{"_3150":1855,"_27624":1825,"_19171":50716,"_5":13189,"_26134":50637,"_2648":50717},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3150":1856,"_27624":1825,"_19171":50719,"_5":13189,"_26134":50637,"_2648":50720},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3150":1857,"_27624":1825,"_19171":50722,"_5":13189,"_26134":50637,"_2648":50723},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3150":1858,"_27624":1825,"_19171":50725,"_5":13189,"_26134":50641,"_2648":50726},[],"Accept a current, authorized certificate with a known chain.",{"_3150":1859,"_27624":1825,"_19171":50728,"_5":13189,"_26134":50641,"_2648":50729},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3150":1860,"_27624":1825,"_19171":50731,"_5":13189,"_26134":50641,"_2648":50732},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3150":1861,"_27624":1825,"_19171":50734,"_5":13189,"_26134":50641,"_2648":50735},[],"Check that a new connection with that identity is rejected.",{"_3150":1862,"_27624":1825,"_19171":50737,"_5":13189,"_26134":50641,"_2648":50738},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3150":1863,"_27624":1825,"_19171":50740,"_5":13189,"_26134":50641,"_2648":50741},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3150":1864,"_27624":1825,"_19171":50743,"_5":13189,"_26134":50641,"_2648":50744},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3150":1865,"_27624":1825,"_19171":50746,"_5":13189,"_26134":50641,"_2648":50747},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":1866,"_27624":1825,"_19171":50749,"_5":13189,"_26134":50641,"_2648":50750},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3150":1867,"_27624":1867,"_5":13515,"_2648":50752,"_27967":50753,"_19171":50754,"_26134":1867},"Certificates",[44933,46313,50009,50010],[],{"_3150":1868,"_27624":1867,"_19171":50756,"_5":13189,"_26134":1867,"_2648":50757},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3150":1869,"_27624":1867,"_5":27964,"_19171":50759,"_26134":50760,"_2648":50761},[],"/docs/pr-preview/pr-26/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3150":1870,"_27624":1867,"_5":27964,"_19171":50763,"_26134":50764,"_2648":50765},[],"/docs/pr-preview/pr-26/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3150":1871,"_27624":1867,"_5":27964,"_19171":50767,"_26134":50768,"_2648":50769},[],"/docs/pr-preview/pr-26/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3150":1872,"_27624":1867,"_5":27964,"_19171":50771,"_26134":50772,"_2648":50773},[],"/docs/pr-preview/pr-26/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3150":1873,"_27624":1867,"_5":27964,"_19171":50775,"_26134":50776,"_2648":50777},[],"/docs/pr-preview/pr-26/platform/pki/certificates#open-the-action","Open the action",{"_3150":1874,"_27624":1867,"_5":27964,"_19171":50779,"_26134":50780,"_2648":50781},[],"/docs/pr-preview/pr-26/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3150":1875,"_27624":1867,"_5":27964,"_19171":50783,"_26134":50784,"_2648":50785},[],"/docs/pr-preview/pr-26/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3150":1876,"_27624":1867,"_5":27964,"_19171":50787,"_26134":50788,"_2648":50789},[],"/docs/pr-preview/pr-26/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3150":1877,"_27624":1867,"_5":27964,"_19171":50791,"_26134":50792,"_2648":50793},[],"/docs/pr-preview/pr-26/platform/pki/certificates#continue","Continue",{"_3150":1878,"_27624":1867,"_19171":50795,"_5":13189,"_26134":1867,"_2648":50796},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3150":1879,"_27624":1867,"_19171":50798,"_5":13189,"_26134":50760,"_2648":50799},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3150":1880,"_27624":1867,"_19171":50801,"_5":13189,"_26134":50760,"_2648":50802},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3150":1881,"_27624":1867,"_19171":50804,"_5":13189,"_26134":50764,"_2648":50805},[],"Download the PEM and inspect it:",{"_3150":1882,"_27624":1867,"_19171":50807,"_5":13189,"_26134":50764,"_2648":50808},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3150":1883,"_27624":1867,"_19171":50810,"_5":13189,"_26134":50768,"_2648":50811},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3150":1884,"_27624":1867,"_19171":50813,"_5":13189,"_26134":50768,"_2648":50814},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3150":1885,"_27624":1867,"_19171":50816,"_5":13189,"_26134":50768,"_2648":50817},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3150":1886,"_27624":1867,"_19171":50819,"_5":13189,"_26134":50768,"_2648":50820},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3150":1887,"_27624":1867,"_19171":50822,"_5":13189,"_26134":50768,"_2648":50823},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3150":1888,"_27624":1867,"_19171":50825,"_5":13189,"_26134":50768,"_2648":50826},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3150":1889,"_27624":1867,"_19171":50828,"_5":13189,"_26134":50768,"_2648":50829},[],"For browser key generation, follow Issue your first certificate.",{"_3150":1890,"_27624":1867,"_19171":50831,"_5":13189,"_26134":50772,"_2648":50832},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3150":1891,"_27624":1867,"_19171":50834,"_5":13189,"_26134":50776,"_2648":50835},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3150":1892,"_27624":1867,"_19171":50837,"_5":13189,"_26134":50780,"_2648":50838},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3150":1893,"_27624":1867,"_19171":50840,"_5":13189,"_26134":50784,"_2648":50841},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3150":1894,"_27624":1867,"_19171":50843,"_5":13189,"_26134":50784,"_2648":50844},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3150":1895,"_27624":1867,"_19171":50846,"_5":13189,"_26134":50784,"_2648":50847},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3150":1896,"_27624":1867,"_19171":50849,"_5":13189,"_26134":50788,"_2648":50850},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3150":1897,"_27624":1867,"_19171":50852,"_5":13189,"_26134":50788,"_2648":50853},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3150":1898,"_27624":1867,"_19171":50855,"_5":13189,"_26134":50788,"_2648":50856},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3150":1899,"_27624":1867,"_19171":50858,"_5":13189,"_26134":50792,"_2648":50859},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":1900,"_27624":1867,"_19171":50861,"_5":13189,"_26134":50792,"_2648":50862},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3150":1901,"_27624":1901,"_5":13515,"_2648":50864,"_27967":50865,"_19171":50867,"_26134":1901},"Certificate lifecycle",[44933,46313,50009,50866],"Concepts",[],{"_3150":1902,"_27624":1901,"_19171":50869,"_5":13189,"_26134":1901,"_2648":50870},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3150":1903,"_27624":1901,"_5":27964,"_19171":50872,"_26134":50873,"_2648":50874},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3150":1904,"_27624":1901,"_5":27964,"_19171":50876,"_26134":50877,"_2648":50878},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3150":1905,"_27624":1901,"_5":27964,"_19171":50880,"_26134":50881,"_2648":50882},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3150":1906,"_27624":1901,"_5":27964,"_19171":50884,"_26134":50885,"_2648":50886},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3150":1907,"_27624":1901,"_5":27964,"_19171":50888,"_26134":50889,"_2648":50890},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3150":1908,"_27624":1901,"_5":27964,"_19171":50892,"_26134":50893,"_2648":50894},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3150":1909,"_27624":1901,"_5":27964,"_19171":50896,"_26134":50897,"_2648":50898},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3150":1910,"_27624":1901,"_5":27964,"_19171":50900,"_26134":50901,"_2648":50902},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3150":1911,"_27624":1901,"_5":27964,"_19171":50904,"_26134":50905,"_2648":50906},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3150":1912,"_27624":1901,"_5":27964,"_19171":50908,"_26134":50909,"_2648":50910},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3150":1913,"_27624":1901,"_19171":50912,"_5":13189,"_26134":1901,"_2648":50913},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3150":1914,"_27624":1901,"_19171":50915,"_5":13189,"_26134":50877,"_2648":50916},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3150":1915,"_27624":1901,"_19171":50918,"_5":13189,"_26134":50881,"_2648":50919},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3150":1916,"_27624":1901,"_19171":50921,"_5":13189,"_26134":50885,"_2648":50922},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3150":1917,"_27624":1901,"_19171":50924,"_5":13189,"_26134":50889,"_2648":50925},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3150":1918,"_27624":1901,"_19171":50927,"_5":13189,"_26134":50893,"_2648":50928},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3150":1919,"_27624":1901,"_19171":50930,"_5":13189,"_26134":50897,"_2648":50931},[],"Lamassu persists four X.509 states:",{"_3150":1920,"_27624":1901,"_19171":50933,"_5":13189,"_26134":50897,"_2648":50934},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3150":1921,"_27624":1901,"_19171":50936,"_5":13189,"_26134":50897,"_2648":50937},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3150":1922,"_27624":1901,"_19171":50939,"_5":13189,"_26134":50897,"_2648":50940},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3150":1923,"_27624":1901,"_19171":50942,"_5":13189,"_26134":50897,"_2648":50943},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3150":1924,"_27624":1901,"_19171":50945,"_5":13189,"_26134":50897,"_2648":50946},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3150":1925,"_27624":1901,"_19171":50948,"_5":13189,"_26134":50901,"_2648":50949},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3150":1926,"_27624":1901,"_19171":50951,"_5":13189,"_26134":50901,"_2648":50952},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3150":1927,"_27624":1901,"_19171":50954,"_5":13189,"_26134":50901,"_2648":50955},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3150":1928,"_27624":1901,"_19171":50957,"_5":13189,"_26134":50905,"_2648":50958},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3150":1929,"_27624":1901,"_19171":50960,"_5":13189,"_26134":50905,"_2648":50961},[],"Before confirming:",{"_3150":1930,"_27624":1901,"_19171":50963,"_5":13189,"_26134":50905,"_2648":50964},[],"Identify DMSs, devices and services that trust that chain.",{"_3150":1931,"_27624":1901,"_19171":50966,"_5":13189,"_26134":50905,"_2648":50967},[],"Distribute the new chain of trust.",{"_3150":1932,"_27624":1901,"_19171":50969,"_5":13189,"_26134":50905,"_2648":50970},[],"Reissue the necessary identities.",{"_3150":1933,"_27624":1901,"_19171":50972,"_5":13189,"_26134":50905,"_2648":50973},[],"Check OCSP and CRL from a real consumer.",{"_3150":1934,"_27624":1901,"_19171":50975,"_5":13189,"_26134":50905,"_2648":50976},[],"Revoke the old CA once no legitimate traffic remains.",{"_3150":1935,"_27624":1901,"_19171":50978,"_5":13189,"_26134":50905,"_2648":50979},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3150":1936,"_27624":1901,"_19171":50981,"_5":13189,"_26134":50909,"_2648":50982},[],"Certificates entering the preventive or critical renewal window.",{"_3150":1937,"_27624":1901,"_19171":50984,"_5":13189,"_26134":50909,"_2648":50985},[],"Repeated enrollment or re-enrollment failures.",{"_3150":1938,"_27624":1901,"_19171":50987,"_5":13189,"_26134":50909,"_2648":50988},[],"Status changes and revocation reasons.",{"_3150":1939,"_27624":1901,"_19171":50990,"_5":13189,"_26134":50909,"_2648":50991},[],"OCSP and CRL publication and validity.",{"_3150":1940,"_27624":1901,"_19171":50993,"_5":13189,"_26134":50909,"_2648":50994},[],"Dependencies still presenting a replaced certificate.",{"_3150":1941,"_27624":1901,"_19171":50996,"_5":13189,"_26134":50909,"_2648":50997},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3150":1942,"_27624":1942,"_5":13515,"_2648":50999,"_27967":51000,"_19171":51001,"_26134":1942},"Trust model",[44933,46313,50009,50866],[],{"_3150":1943,"_27624":1942,"_19171":51003,"_5":13189,"_26134":1942,"_2648":51004},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3150":1944,"_27624":1942,"_5":27964,"_19171":51006,"_26134":51007,"_2648":51008},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3150":1945,"_27624":1942,"_5":27964,"_19171":51010,"_26134":51011,"_2648":51012},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3150":1946,"_27624":1942,"_5":27964,"_19171":51014,"_26134":51015,"_2648":51016},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3150":1947,"_27624":1942,"_5":27964,"_19171":51018,"_26134":51019,"_2648":51020},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3150":1948,"_27624":1942,"_5":27964,"_19171":51022,"_26134":51023,"_2648":51024},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3150":1949,"_27624":1942,"_5":27964,"_19171":51026,"_26134":51027,"_2648":51028},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3150":1950,"_27624":1942,"_5":27964,"_19171":51030,"_26134":51031,"_2648":51032},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3150":1951,"_27624":1942,"_5":27964,"_19171":51034,"_26134":51035,"_2648":51036},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3150":1952,"_27624":1942,"_5":27964,"_19171":51038,"_26134":51039,"_2648":51040},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3150":1953,"_27624":1942,"_5":27964,"_19171":51042,"_26134":51043,"_2648":51044},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3150":1954,"_27624":1942,"_19171":51046,"_5":13189,"_26134":1942,"_2648":51047},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3150":1955,"_27624":1942,"_19171":51049,"_5":13189,"_26134":51011,"_2648":51050},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3150":1956,"_27624":1942,"_19171":51052,"_5":13189,"_26134":51015,"_2648":51053},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3150":1957,"_27624":1942,"_19171":51055,"_5":13189,"_26134":51019,"_2648":51056},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3150":1958,"_27624":1942,"_19171":51058,"_5":13189,"_26134":51023,"_2648":51059},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3150":1959,"_27624":1942,"_19171":51061,"_5":13189,"_26134":51027,"_2648":51062},[],"The device proves it can enroll according to the DMS policy.",{"_3150":1960,"_27624":1942,"_19171":51064,"_5":13189,"_26134":51027,"_2648":51065},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3150":1961,"_27624":1942,"_19171":51067,"_5":13189,"_26134":51027,"_2648":51068},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3150":1962,"_27624":1942,"_19171":51070,"_5":13189,"_26134":51027,"_2648":51071},[],"The device installs the certificate and the chain it needs.",{"_3150":1963,"_27624":1942,"_19171":51073,"_5":13189,"_26134":51027,"_2648":51074},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3150":1964,"_27624":1942,"_19171":51076,"_5":13189,"_26134":51027,"_2648":51077},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3150":1965,"_27624":1942,"_19171":51079,"_5":13189,"_26134":51031,"_2648":51080},[],"A DMS relates three sets that are worth designing separately:",{"_3150":1966,"_27624":1942,"_19171":51082,"_5":13189,"_26134":51031,"_2648":51083},[],"**Enrollment CA:** signs the new identities.",{"_3150":1967,"_27624":1942,"_19171":51085,"_5":13189,"_26134":51031,"_2648":51086},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_3150":1968,"_27624":1942,"_19171":51088,"_5":13189,"_26134":51031,"_2648":51089},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3150":1969,"_27624":1942,"_19171":51091,"_5":13189,"_26134":51031,"_2648":51092},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3150":1970,"_27624":1942,"_19171":51094,"_5":13189,"_26134":51035,"_2648":51095},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3150":1971,"_27624":1942,"_19171":51097,"_5":13189,"_26134":51035,"_2648":51098},[],"that the current date is between `Not Before` and `Not After`;",{"_3150":1972,"_27624":1942,"_19171":51100,"_5":13189,"_26134":51035,"_2648":51101},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3150":1973,"_27624":1942,"_19171":51103,"_5":13189,"_26134":51035,"_2648":51104},[],"that names, SANs and subject match the expected identity;",{"_3150":1974,"_27624":1942,"_19171":51106,"_5":13189,"_26134":51035,"_2648":51107},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3150":1975,"_27624":1942,"_19171":51109,"_5":13189,"_26134":51035,"_2648":51110},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3150":1976,"_27624":1942,"_19171":51112,"_5":13189,"_26134":51035,"_2648":51113},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3150":1977,"_27624":1942,"_19171":51115,"_5":13189,"_26134":51039,"_2648":51116},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3150":1978,"_27624":1942,"_19171":51118,"_5":13189,"_26134":51043,"_2648":51119},[],"Keep the root out of daily operations, or with very restricted access.",{"_3150":1979,"_27624":1942,"_19171":51121,"_5":13189,"_26134":51043,"_2648":51122},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3150":1980,"_27624":1942,"_19171":51124,"_5":13189,"_26134":51043,"_2648":51125},[],"Assign explicit profiles to every use case.",{"_3150":1981,"_27624":1942,"_19171":51127,"_5":13189,"_26134":51043,"_2648":51128},[],"Distribute the new trust before starting a rotation.",{"_3150":1982,"_27624":1942,"_19171":51130,"_5":13189,"_26134":51043,"_2648":51131},[],"Keep enough overlap to renew a disconnected fleet.",{"_3150":1983,"_27624":1942,"_19171":51133,"_5":13189,"_26134":51043,"_2648":51134},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3150":1984,"_27624":1942,"_19171":51136,"_5":13189,"_26134":51043,"_2648":51137},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3150":1985,"_27624":1985,"_5":13515,"_2648":51139,"_27967":51140,"_19171":51141,"_26134":1985},"Revocation lists (CRL)",[44933,46313,50009,50626],[],{"_3150":1986,"_27624":1985,"_19171":51143,"_5":13189,"_26134":1985,"_2648":51144},[],"Generate and distribute signed lists to validate certificates offline.",{"_3150":1987,"_27624":1985,"_5":27964,"_19171":51146,"_26134":51147,"_2648":51148},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3150":1988,"_27624":1985,"_5":27964,"_19171":51150,"_26134":51151,"_2648":51152},[],"/docs/pr-preview/pr-26/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3150":1989,"_27624":1985,"_5":27964,"_19171":51154,"_26134":51155,"_2648":51156},[],"/docs/pr-preview/pr-26/platform/pki/crl#crl-contents","CRL contents",{"_3150":1990,"_27624":1985,"_5":27964,"_19171":51158,"_26134":51159,"_2648":51160},[],"/docs/pr-preview/pr-26/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3150":1991,"_27624":1985,"_5":27964,"_19171":51162,"_26134":51163,"_2648":51164},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-management-api","VA role management API",{"_3150":1992,"_27624":1985,"_5":27964,"_19171":51166,"_26134":51167,"_2648":51168},[],"/docs/pr-preview/pr-26/platform/pki/crl#from-the-interface","From the interface",{"_3150":1993,"_27624":1985,"_5":27964,"_19171":51170,"_26134":51171,"_2648":51172},[],"/docs/pr-preview/pr-26/platform/pki/crl#references","References",{"_3150":1994,"_27624":1985,"_19171":51174,"_5":13189,"_26134":1985,"_2648":51175},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3150":1995,"_27624":1985,"_19171":51177,"_5":13189,"_26134":51147,"_2648":51178},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3150":1996,"_27624":1985,"_19171":51180,"_5":13189,"_26134":51147,"_2648":51181},[],"`crl_options` field",{"_3150":1997,"_27624":1985,"_19171":51183,"_5":13189,"_26134":51147,"_2648":45323},[],{"_3150":1998,"_27624":1985,"_19171":51185,"_5":13189,"_26134":51147,"_2648":51186},[],"Backend initial value",{"_3150":1999,"_27624":1985,"_19171":51188,"_5":13189,"_26134":51147,"_2648":51189},[],"`validity`",{"_3150":2000,"_27624":1985,"_19171":51191,"_5":13189,"_26134":51147,"_2648":51192},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3150":2001,"_27624":1985,"_19171":51194,"_5":13189,"_26134":51147,"_2648":51195},[],"7 days.",{"_3150":2002,"_27624":1985,"_19171":51197,"_5":13189,"_26134":51147,"_2648":51198},[],"`refresh_interval`",{"_3150":2003,"_27624":1985,"_19171":51200,"_5":13189,"_26134":51147,"_2648":51201},[],"Time since publication that triggers scheduled renewal.",{"_3150":2004,"_27624":1985,"_19171":51203,"_5":13189,"_26134":51147,"_2648":51204},[],"6 days and 23 hours.",{"_3150":2005,"_27624":1985,"_19171":51206,"_5":13189,"_26134":51147,"_2648":51207},[],"`regenerate_on_revoke`",{"_3150":2006,"_27624":1985,"_19171":51209,"_5":13189,"_26134":51147,"_2648":51210},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3150":2007,"_27624":1985,"_19171":51212,"_5":13189,"_26134":51147,"_2648":51213},[],"`true`.",{"_3150":2008,"_27624":1985,"_19171":51215,"_5":13189,"_26134":51147,"_2648":51216},[],"`subject_key_id_signer`",{"_3150":2009,"_27624":1985,"_19171":51218,"_5":13189,"_26134":51147,"_2648":51219},[],"Configuration field initialized with the CA’s SKI.",{"_3150":2010,"_27624":1985,"_19171":51221,"_5":13189,"_26134":51147,"_2648":51222},[],"CA SKI.",{"_3150":2011,"_27624":1985,"_19171":51224,"_5":13189,"_26134":51147,"_2648":51225},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3150":2012,"_27624":1985,"_19171":51227,"_5":13189,"_26134":51147,"_2648":51228},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3150":2013,"_27624":1985,"_19171":51230,"_5":13189,"_26134":51151,"_2648":51231},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3150":2014,"_27624":1985,"_19171":51233,"_5":13189,"_26134":51151,"_2648":51234},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3150":2015,"_27624":1985,"_19171":51236,"_5":13189,"_26134":51151,"_2648":51237},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3150":2016,"_27624":1985,"_19171":51239,"_5":13189,"_26134":51155,"_2648":51240},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3150":2017,"_27624":1985,"_19171":51242,"_5":13189,"_26134":51155,"_2648":51243},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3150":2018,"_27624":1985,"_19171":51245,"_5":13189,"_26134":51159,"_2648":51246},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3150":2019,"_27624":1985,"_19171":51248,"_5":13189,"_26134":51159,"_2648":51249},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3150":2020,"_27624":1985,"_19171":51251,"_5":13189,"_26134":51159,"_2648":51252},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3150":2021,"_27624":1985,"_19171":51254,"_5":13189,"_26134":51159,"_2648":51255},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3150":2022,"_27624":1985,"_19171":51257,"_5":13189,"_26134":51159,"_2648":51258},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3150":2023,"_27624":1985,"_19171":51260,"_5":13189,"_26134":51163,"_2648":51261},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3150":2024,"_27624":1985,"_19171":51263,"_5":13189,"_26134":51163,"_2648":48040},[],{"_3150":2025,"_27624":1985,"_19171":51265,"_5":13189,"_26134":51163,"_2648":51266},[],"Relative path",{"_3150":2026,"_27624":1985,"_19171":51268,"_5":13189,"_26134":51163,"_2648":48037},[],{"_3150":2027,"_27624":1985,"_19171":51270,"_5":13189,"_26134":51163,"_2648":51271},[],"`GET`",{"_3150":2028,"_27624":1985,"_19171":51273,"_5":13189,"_26134":51163,"_2648":51274},[],"`/v1/roles/{ca-ski}`",{"_3150":2029,"_27624":1985,"_19171":51276,"_5":13189,"_26134":51163,"_2648":51277},[],"Read `crl_options` and `latest_crl`.",{"_3150":2030,"_27624":1985,"_19171":51279,"_5":13189,"_26134":51163,"_2648":51280},[],"`PUT`",{"_3150":2031,"_27624":1985,"_19171":51282,"_5":13189,"_26134":51163,"_2648":51274},[],{"_3150":2032,"_27624":1985,"_19171":51284,"_5":13189,"_26134":51163,"_2648":51285},[],"Replace CRL configuration.",{"_3150":2033,"_27624":1985,"_19171":51287,"_5":13189,"_26134":51163,"_2648":51288},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3150":2034,"_27624":1985,"_19171":51290,"_5":13189,"_26134":51163,"_2648":51291},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3150":2035,"_27624":1985,"_19171":51293,"_5":13189,"_26134":51167,"_2648":51294},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3150":2036,"_27624":1985,"_19171":51296,"_5":13189,"_26134":51171,"_2648":51297},[],"RFC 5280: X.509 and CRL profile.",{"_3150":2037,"_27624":1985,"_19171":51299,"_5":13189,"_26134":51171,"_2648":51300},[],"OpenSSL: openssl-crl.",{"_3150":2038,"_27624":1985,"_19171":51302,"_5":13189,"_26134":51171,"_2648":51303},[],"OpenSSL: openssl-verify.",{"_3150":2039,"_27624":1985,"_19171":51305,"_5":13189,"_26134":51171,"_2648":51306},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":2040,"_27624":1985,"_19171":51308,"_5":13189,"_26134":51171,"_2648":51309},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3150":2041,"_27624":2041,"_5":13515,"_2648":51311,"_27967":51312,"_19171":51313,"_26134":2041},"Keys and cryptographic engines",[44933,46313,50009,50010],[],{"_3150":2042,"_27624":2041,"_19171":51315,"_5":13189,"_26134":2041,"_2648":51316},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3150":2043,"_27624":2041,"_5":27964,"_19171":51318,"_26134":51319,"_2648":51320},[],"/docs/pr-preview/pr-26/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3150":2044,"_27624":2041,"_5":27964,"_19171":51322,"_26134":51323,"_2648":51324},[],"/docs/pr-preview/pr-26/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3150":2045,"_27624":2041,"_5":27964,"_19171":51326,"_26134":51327,"_2648":51328},[],"/docs/pr-preview/pr-26/platform/pki/key-management#file-system","File System",{"_3150":2046,"_27624":2041,"_5":27964,"_19171":51330,"_26134":51331,"_2648":51332},[],"/docs/pr-preview/pr-26/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3150":2047,"_27624":2041,"_5":27964,"_19171":51334,"_26134":51335,"_2648":51336},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3150":2048,"_27624":2041,"_5":27964,"_19171":51338,"_26134":51339,"_2648":51340},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-kms","AWS KMS",{"_3150":2049,"_27624":2041,"_5":27964,"_19171":51342,"_26134":51343,"_2648":51344},[],"/docs/pr-preview/pr-26/platform/pki/key-management#pkcs11","PKCS#11",{"_3150":2050,"_27624":2041,"_5":27964,"_19171":51346,"_26134":51347,"_2648":51348},[],"/docs/pr-preview/pr-26/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3150":2051,"_27624":2041,"_5":27964,"_19171":51350,"_26134":51351,"_2648":51352},[],"/docs/pr-preview/pr-26/platform/pki/key-management#key-inventory","Key inventory",{"_3150":2052,"_27624":2041,"_5":27964,"_19171":51354,"_26134":51355,"_2648":51356},[],"/docs/pr-preview/pr-26/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3150":2053,"_27624":2041,"_5":27964,"_19171":51358,"_26134":51359,"_2648":51360},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3150":2054,"_27624":2041,"_5":27964,"_19171":51362,"_26134":51363,"_2648":51364},[],"/docs/pr-preview/pr-26/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3150":2055,"_27624":2041,"_5":27964,"_19171":51366,"_26134":51367,"_2648":51368},[],"/docs/pr-preview/pr-26/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3150":2056,"_27624":2041,"_5":27964,"_19171":51370,"_26134":51371,"_2648":51372},[],"/docs/pr-preview/pr-26/platform/pki/key-management#view-details","View details",{"_3150":2057,"_27624":2041,"_5":27964,"_19171":51374,"_26134":51375,"_2648":51376},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3150":2058,"_27624":2041,"_5":27964,"_19171":51378,"_26134":51379,"_2648":51380},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign","Sign",{"_3150":2059,"_27624":2041,"_5":27964,"_19171":51382,"_26134":51383,"_2648":51384},[],"/docs/pr-preview/pr-26/platform/pki/key-management#verify","Verify",{"_3150":2060,"_27624":2041,"_5":27964,"_19171":51386,"_26134":51387,"_2648":51388},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3150":2061,"_27624":2041,"_5":27964,"_19171":51390,"_26134":51391,"_2648":51392},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3150":2062,"_27624":2041,"_5":27964,"_19171":51394,"_26134":51395,"_2648":51396},[],"/docs/pr-preview/pr-26/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3150":2063,"_27624":2041,"_19171":51398,"_5":13189,"_26134":2041,"_2648":51399},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3150":2064,"_27624":2041,"_19171":51401,"_5":13189,"_26134":2041,"_2648":51402},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3150":2065,"_27624":2041,"_19171":51404,"_5":13189,"_26134":51319,"_2648":51405},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3150":2066,"_27624":2041,"_19171":51407,"_5":13189,"_26134":51319,"_2648":51408},[],"In practice, it lets you:",{"_3150":2067,"_27624":2041,"_19171":51410,"_5":13189,"_26134":51319,"_2648":51411},[],"Generate new key pairs from Lamassu IoT.",{"_3150":2068,"_27624":2041,"_19171":51413,"_5":13189,"_26134":51319,"_2648":51414},[],"Import keys created externally.",{"_3150":2069,"_27624":2041,"_19171":51416,"_5":13189,"_26134":51319,"_2648":51417},[],"Delegate custody and cryptographic operations to external engines.",{"_3150":2070,"_27624":2041,"_19171":51419,"_5":13189,"_26134":51319,"_2648":51420},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3150":2071,"_27624":2041,"_19171":51422,"_5":13189,"_26134":51323,"_2648":51423},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3150":2072,"_27624":2041,"_19171":51425,"_5":13189,"_26134":51323,"_2648":51426},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3150":2073,"_27624":2041,"_19171":51428,"_5":13189,"_26134":51323,"_2648":51429},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3150":2074,"_27624":2041,"_19171":51431,"_5":13189,"_26134":51327,"_2648":51432},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3150":2075,"_27624":2041,"_19171":51434,"_5":13189,"_26134":51331,"_2648":51435},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3150":2076,"_27624":2041,"_19171":51437,"_5":13189,"_26134":51335,"_2648":51438},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3150":2077,"_27624":2041,"_19171":51440,"_5":13189,"_26134":51339,"_2648":51441},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3150":2078,"_27624":2041,"_19171":51443,"_5":13189,"_26134":51343,"_2648":51444},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3150":2079,"_27624":2041,"_19171":51446,"_5":13189,"_26134":51347,"_2648":51447},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3150":2080,"_27624":2041,"_19171":51449,"_5":13189,"_26134":51347,"_2648":51450},[],"Lamassu shows the enabled engines in the console.",{"_3150":2081,"_27624":2041,"_19171":51452,"_5":13189,"_26134":51347,"_2648":51453},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3150":2082,"_27624":2041,"_19171":51455,"_5":13189,"_26134":51347,"_2648":51456},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3150":2083,"_27624":2041,"_19171":51458,"_5":13189,"_26134":51351,"_2648":51459},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3150":2084,"_27624":2041,"_19171":51461,"_5":13189,"_26134":51351,"_2648":51462},[],"The table includes the following fields:",{"_3150":2085,"_27624":2041,"_19171":51464,"_5":13189,"_26134":51351,"_2648":51465},[],"**Name**: descriptive name of the key.",{"_3150":2086,"_27624":2041,"_19171":51467,"_5":13189,"_26134":51351,"_2648":51468},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3150":2087,"_27624":2041,"_19171":51470,"_5":13189,"_26134":51351,"_2648":51471},[],"**Strength**: visual indicator of cryptographic strength.",{"_3150":2088,"_27624":2041,"_19171":51473,"_5":13189,"_26134":51351,"_2648":51474},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3150":2089,"_27624":2041,"_19171":51476,"_5":13189,"_26134":51351,"_2648":51477},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3150":2090,"_27624":2041,"_19171":51479,"_5":13189,"_26134":51351,"_2648":51480},[],"**Aliases**: alternative names associated with the key.",{"_3150":2091,"_27624":2041,"_19171":51482,"_5":13189,"_26134":51351,"_2648":51483},[],"**Tags**: labels for classification and search.",{"_3150":2092,"_27624":2041,"_19171":51485,"_5":13189,"_26134":51351,"_2648":51486},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3150":2093,"_27624":2041,"_19171":51488,"_5":13189,"_26134":51351,"_2648":51489},[],"From this view you also reach the most common actions:",{"_3150":2094,"_27624":2041,"_19171":51491,"_5":13189,"_26134":51351,"_2648":51492},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3150":2095,"_27624":2041,"_19171":51494,"_5":13189,"_26134":51351,"_2648":51495},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3150":2096,"_27624":2041,"_19171":51497,"_5":13189,"_26134":51351,"_2648":51498},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3150":2097,"_27624":2041,"_19171":51500,"_5":13189,"_26134":51351,"_2648":51501},[],"**Delete Key** to remove the key from the system.",{"_3150":2098,"_27624":2041,"_19171":51503,"_5":13189,"_26134":51355,"_2648":51504},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3150":2099,"_27624":2041,"_19171":51506,"_5":13189,"_26134":51359,"_2648":51507},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3150":2100,"_27624":2041,"_19171":51509,"_5":13189,"_26134":51359,"_2648":51510},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3150":2101,"_27624":2041,"_19171":51512,"_5":13189,"_26134":51359,"_2648":51513},[],"**Key Name**: unique and descriptive name.",{"_3150":2102,"_27624":2041,"_19171":51515,"_5":13189,"_26134":51359,"_2648":51516},[],"**Crypto Engine**: engine that will keep the key.",{"_3150":2103,"_27624":2041,"_19171":51518,"_5":13189,"_26134":51359,"_2648":51519},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3150":2104,"_27624":2041,"_19171":51521,"_5":13189,"_26134":51359,"_2648":51522},[],"**Tags**: metadata to classify the key.",{"_3150":2105,"_27624":2041,"_19171":51524,"_5":13189,"_26134":51359,"_2648":51525},[],"**Metadata**: additional information for advanced uses.",{"_3150":2106,"_27624":2041,"_19171":51527,"_5":13189,"_26134":51363,"_2648":51528},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3150":2107,"_27624":2041,"_19171":51530,"_5":13189,"_26134":51363,"_2648":51531},[],"When you have an exportable private key and the destination engine supports import.",{"_3150":2108,"_27624":2041,"_19171":51533,"_5":13189,"_26134":51363,"_2648":51534},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3150":2109,"_27624":2041,"_19171":51536,"_5":13189,"_26134":51363,"_2648":51537},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3150":2110,"_27624":2041,"_19171":51539,"_5":13189,"_26134":51363,"_2648":51540},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3150":2111,"_27624":2041,"_19171":51542,"_5":13189,"_26134":51363,"_2648":51543},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3150":2112,"_27624":2041,"_19171":51545,"_5":13189,"_26134":51363,"_2648":51546},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3150":2113,"_27624":2041,"_19171":51548,"_5":13189,"_26134":51363,"_2648":51549},[],"**Tags**: labels for organization and search.",{"_3150":2114,"_27624":2041,"_19171":51551,"_5":13189,"_26134":51363,"_2648":51552},[],"**Metadata**: additional optional information.",{"_3150":2115,"_27624":2041,"_19171":51554,"_5":13189,"_26134":51363,"_2648":51555},[],"**Private Key (PEM)**: private key in PEM format.",{"_3150":2116,"_27624":2041,"_19171":51557,"_5":13189,"_26134":51363,"_2648":51558},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3150":2117,"_27624":2041,"_19171":51560,"_5":13189,"_26134":51367,"_2648":51561},[],"Each registered key has a detail view and several operational actions.",{"_3150":2118,"_27624":2041,"_19171":51563,"_5":13189,"_26134":51371,"_2648":51564},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3150":2119,"_27624":2041,"_19171":51566,"_5":13189,"_26134":51371,"_2648":51567},[],"The **Overview** tab shows, among others, these fields:",{"_3150":2120,"_27624":2041,"_19171":51569,"_5":13189,"_26134":51371,"_2648":51570},[],"**Key Name**: descriptive name.",{"_3150":2121,"_27624":2041,"_19171":51572,"_5":13189,"_26134":51371,"_2648":51573},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3150":2122,"_27624":2041,"_19171":51575,"_5":13189,"_26134":51371,"_2648":51576},[],"**Tags**: associated labels.",{"_3150":2123,"_27624":2041,"_19171":51578,"_5":13189,"_26134":51371,"_2648":51579},[],"**Aliases**: alternative names.",{"_3150":2124,"_27624":2041,"_19171":51581,"_5":13189,"_26134":51371,"_2648":51582},[],"**Crypto Engine**: engine where the key resides.",{"_3150":2125,"_27624":2041,"_19171":51584,"_5":13189,"_26134":51371,"_2648":51585},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3150":2126,"_27624":2041,"_19171":51587,"_5":13189,"_26134":51371,"_2648":51588},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3150":2127,"_27624":2041,"_19171":51590,"_5":13189,"_26134":51371,"_2648":51591},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3150":2128,"_27624":2041,"_19171":51593,"_5":13189,"_26134":51375,"_2648":51594},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3150":2129,"_27624":2041,"_19171":51596,"_5":13189,"_26134":51375,"_2648":51597},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3150":2130,"_27624":2041,"_19171":51599,"_5":13189,"_26134":51375,"_2648":51600},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3150":2131,"_27624":2041,"_19171":51602,"_5":13189,"_26134":51379,"_2648":51603},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3150":2132,"_27624":2041,"_19171":51605,"_5":13189,"_26134":51379,"_2648":51606},[],"Main fields:",{"_3150":2133,"_27624":2041,"_19171":51608,"_5":13189,"_26134":51379,"_2648":51609},[],"**Algorithm**: signing algorithm available for the key type.",{"_3150":2134,"_27624":2041,"_19171":51611,"_5":13189,"_26134":51379,"_2648":51612},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3150":2135,"_27624":2041,"_19171":51614,"_5":13189,"_26134":51379,"_2648":51615},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3150":2136,"_27624":2041,"_19171":51617,"_5":13189,"_26134":51379,"_2648":51618},[],"**Message**: content to sign.",{"_3150":2137,"_27624":2041,"_19171":51620,"_5":13189,"_26134":51379,"_2648":51621},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3150":2138,"_27624":2041,"_19171":51623,"_5":13189,"_26134":51383,"_2648":51624},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3150":2139,"_27624":2041,"_19171":51626,"_5":13189,"_26134":51383,"_2648":51606},[],{"_3150":2140,"_27624":2041,"_19171":51628,"_5":13189,"_26134":51383,"_2648":51629},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3150":2141,"_27624":2041,"_19171":51631,"_5":13189,"_26134":51383,"_2648":51632},[],"**Message Type**: `Raw` or `Digest`.",{"_3150":2142,"_27624":2041,"_19171":51634,"_5":13189,"_26134":51383,"_2648":51635},[],"**Payload Encoding**: encoding of the message.",{"_3150":2143,"_27624":2041,"_19171":51637,"_5":13189,"_26134":51383,"_2648":51638},[],"**Message**: original message or hash.",{"_3150":2144,"_27624":2041,"_19171":51640,"_5":13189,"_26134":51383,"_2648":51641},[],"**Signature**: signature to check.",{"_3150":2145,"_27624":2041,"_19171":51643,"_5":13189,"_26134":51383,"_2648":51644},[],"**Result**: indicator of the validation result.",{"_3150":2146,"_27624":2041,"_19171":51646,"_5":13189,"_26134":51387,"_2648":51647},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3150":2147,"_27624":2041,"_19171":51649,"_5":13189,"_26134":51387,"_2648":51650},[],"This flow is useful for:",{"_3150":2148,"_27624":2041,"_19171":51652,"_5":13189,"_26134":51387,"_2648":51653},[],"Requesting certificates from an external CA.",{"_3150":2149,"_27624":2041,"_19171":51655,"_5":13189,"_26134":51387,"_2648":51656},[],"Renewing an identity while keeping the same key.",{"_3150":2150,"_27624":2041,"_19171":51658,"_5":13189,"_26134":51387,"_2648":51659},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3150":2151,"_27624":2041,"_19171":51661,"_5":13189,"_26134":51387,"_2648":51662},[],"**Common Name (CN)**: main name of the identity.",{"_3150":2152,"_27624":2041,"_19171":51664,"_5":13189,"_26134":51387,"_2648":51665},[],"**Organization (O)**: organization or company.",{"_3150":2153,"_27624":2041,"_19171":51667,"_5":13189,"_26134":51387,"_2648":51668},[],"**Organizational Unit (OU)**: department or unit.",{"_3150":2154,"_27624":2041,"_19171":51670,"_5":13189,"_26134":51387,"_2648":51671},[],"**Country (C)**: two-letter country code.",{"_3150":2155,"_27624":2041,"_19171":51673,"_5":13189,"_26134":51387,"_2648":51674},[],"**State / Province (ST)**: state or province.",{"_3150":2156,"_27624":2041,"_19171":51676,"_5":13189,"_26134":51387,"_2648":51677},[],"**Locality (L)**: city or locality.",{"_3150":2157,"_27624":2041,"_19171":51679,"_5":13189,"_26134":51387,"_2648":51680},[],"**Email Address**: contact email.",{"_3150":2158,"_27624":2041,"_19171":51682,"_5":13189,"_26134":51387,"_2648":51683},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3150":2159,"_27624":2041,"_19171":51685,"_5":13189,"_26134":51387,"_2648":51686},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3150":2160,"_27624":2041,"_19171":51688,"_5":13189,"_26134":51391,"_2648":51689},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3150":2161,"_27624":2041,"_19171":51691,"_5":13189,"_26134":51391,"_2648":51692},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3150":2162,"_27624":2041,"_19171":51694,"_5":13189,"_26134":51395,"_2648":51695},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3150":2163,"_27624":2163,"_5":13515,"_2648":51697,"_27967":51698,"_19171":51699,"_26134":2163},"Online validation with OCSP",[44933,46313,50009,50626],[],{"_3150":2164,"_27624":2163,"_19171":51701,"_5":13189,"_26134":2163,"_2648":51702},[],"Query signed status and verify the responder’s response.",{"_3150":2165,"_27624":2163,"_5":27964,"_19171":51704,"_26134":51705,"_2648":51706},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3150":2166,"_27624":2163,"_5":27964,"_19171":51708,"_26134":51709,"_2648":51710},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3150":2167,"_27624":2163,"_5":27964,"_19171":51712,"_26134":51713,"_2648":51714},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3150":2168,"_27624":2163,"_5":27964,"_19171":51716,"_26134":51717,"_2648":51718},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3150":2169,"_27624":2163,"_5":27964,"_19171":51720,"_26134":51721,"_2648":51722},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3150":2170,"_27624":2163,"_5":27964,"_19171":51724,"_26134":51725,"_2648":51172},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#references",{"_3150":2171,"_27624":2163,"_19171":51727,"_5":13189,"_26134":2163,"_2648":51728},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3150":2172,"_27624":2163,"_19171":51730,"_5":13189,"_26134":51705,"_2648":51731},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3150":2173,"_27624":2163,"_19171":51733,"_5":13189,"_26134":51705,"_2648":51734},[],"Record status",{"_3150":2174,"_27624":2163,"_19171":51736,"_5":13189,"_26134":51705,"_2648":51737},[],"Signed response",{"_3150":2175,"_27624":2163,"_19171":51739,"_5":13189,"_26134":51705,"_2648":49187},[],{"_3150":2176,"_27624":2163,"_19171":51741,"_5":13189,"_26134":51705,"_2648":51742},[],"`Good`.",{"_3150":2177,"_27624":2163,"_19171":51744,"_5":13189,"_26134":51705,"_2648":49204},[],{"_3150":2178,"_27624":2163,"_19171":51746,"_5":13189,"_26134":51705,"_2648":51747},[],"`Revoked`, with revocation reason and timestamp.",{"_3150":2179,"_27624":2163,"_19171":51749,"_5":13189,"_26134":51705,"_2648":51750},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3150":2180,"_27624":2163,"_19171":51752,"_5":13189,"_26134":51705,"_2648":51753},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3150":2181,"_27624":2163,"_19171":51755,"_5":13189,"_26134":51705,"_2648":51756},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3150":2182,"_27624":2163,"_19171":51758,"_5":13189,"_26134":51705,"_2648":51759},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3150":2183,"_27624":2163,"_19171":51761,"_5":13189,"_26134":51705,"_2648":51762},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3150":2184,"_27624":2163,"_19171":51764,"_5":13189,"_26134":51709,"_2648":51765},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3150":2185,"_27624":2163,"_19171":51767,"_5":13189,"_26134":51709,"_2648":51768},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3150":2186,"_27624":2163,"_19171":51770,"_5":13189,"_26134":51713,"_2648":51771},[],"The service accepts:",{"_3150":2187,"_27624":2163,"_19171":51773,"_5":13189,"_26134":51713,"_2648":48040},[],{"_3150":2188,"_27624":2163,"_19171":51775,"_5":13189,"_26134":51713,"_2648":51776},[],"VA service path",{"_3150":2189,"_27624":2163,"_19171":51778,"_5":13189,"_26134":51713,"_2648":51779},[],"Format",{"_3150":2190,"_27624":2163,"_19171":51781,"_5":13189,"_26134":51713,"_2648":51782},[],"`POST`",{"_3150":2191,"_27624":2163,"_19171":51784,"_5":13189,"_26134":51713,"_2648":51785},[],"`/ocsp`",{"_3150":2192,"_27624":2163,"_19171":51787,"_5":13189,"_26134":51713,"_2648":51788},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3150":2193,"_27624":2163,"_19171":51790,"_5":13189,"_26134":51713,"_2648":51271},[],{"_3150":2194,"_27624":2163,"_19171":51792,"_5":13189,"_26134":51713,"_2648":51793},[],"`/ocsp/{ocsp_request}`",{"_3150":2195,"_27624":2163,"_19171":51795,"_5":13189,"_26134":51713,"_2648":51796},[],"DER request encoded using padded URL Base64.",{"_3150":2196,"_27624":2163,"_19171":51798,"_5":13189,"_26134":51713,"_2648":51799},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3150":2197,"_27624":2163,"_19171":51801,"_5":13189,"_26134":51717,"_2648":51802},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3150":2198,"_27624":2163,"_19171":51804,"_5":13189,"_26134":51717,"_2648":51805},[],"Generate the request:",{"_3150":2199,"_27624":2163,"_19171":51807,"_5":13189,"_26134":51717,"_2648":51808},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3150":2200,"_27624":2163,"_19171":51810,"_5":13189,"_26134":51717,"_2648":51811},[],"Replace the example URL with the inspected endpoint:",{"_3150":2201,"_27624":2163,"_19171":51813,"_5":13189,"_26134":51717,"_2648":51814},[],"Verify the returned DER:",{"_3150":2202,"_27624":2163,"_19171":51816,"_5":13189,"_26134":51717,"_2648":51817},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3150":2203,"_27624":2163,"_19171":51819,"_5":13189,"_26134":51721,"_2648":51820},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3150":2204,"_27624":2163,"_19171":51822,"_5":13189,"_26134":51721,"_2648":51823},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3150":2205,"_27624":2163,"_19171":51825,"_5":13189,"_26134":51725,"_2648":51826},[],"RFC 6960: OCSP.",{"_3150":2206,"_27624":2163,"_19171":51828,"_5":13189,"_26134":51725,"_2648":51829},[],"OpenSSL: openssl-ocsp.",{"_3150":2207,"_27624":2163,"_19171":51831,"_5":13189,"_26134":51725,"_2648":51832},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3150":2208,"_27624":2163,"_19171":51834,"_5":13189,"_26134":51725,"_2648":51309},[],{"_3150":2209,"_27624":2209,"_5":13515,"_2648":50009,"_27967":51836,"_19171":51837,"_26134":2209},[44933,46313,50009],[],{"_3150":2210,"_27624":2209,"_19171":51839,"_5":13189,"_26134":2209,"_2648":51840},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3150":2211,"_27624":2209,"_5":27964,"_19171":51842,"_26134":51843,"_2648":49319},[],"/docs/pr-preview/pr-26/platform/pki/overview#start-here",{"_3150":2212,"_27624":2209,"_5":27964,"_19171":51845,"_26134":51846,"_2648":51847},[],"/docs/pr-preview/pr-26/platform/pki/overview#what-you-need","What you need",{"_3150":2213,"_27624":2209,"_5":27964,"_19171":51849,"_26134":51850,"_2648":49853},[],"/docs/pr-preview/pr-26/platform/pki/overview#core-capabilities",{"_3150":2214,"_27624":2209,"_5":27964,"_19171":51852,"_26134":51853,"_2648":49857},[],"/docs/pr-preview/pr-26/platform/pki/overview#build-your-trust-hierarchy",{"_3150":2215,"_27624":2209,"_5":27964,"_19171":51855,"_26134":51856,"_2648":49861},[],"/docs/pr-preview/pr-26/platform/pki/overview#protect-cryptographic-keys",{"_3150":2216,"_27624":2209,"_5":27964,"_19171":51858,"_26134":51859,"_2648":49865},[],"/docs/pr-preview/pr-26/platform/pki/overview#issue-and-control-certificates",{"_3150":2217,"_27624":2209,"_5":27964,"_19171":51861,"_26134":51862,"_2648":49873},[],"/docs/pr-preview/pr-26/platform/pki/overview#publish-validation-status",{"_3150":2218,"_27624":2209,"_5":27964,"_19171":51864,"_26134":51865,"_2648":51866},[],"/docs/pr-preview/pr-26/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3150":2219,"_27624":2209,"_5":27964,"_19171":51868,"_26134":51869,"_2648":50793},[],"/docs/pr-preview/pr-26/platform/pki/overview#continue",{"_3150":2220,"_27624":2209,"_19171":51871,"_5":13189,"_26134":2209,"_2648":51872},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3150":2221,"_27624":2209,"_19171":51874,"_5":13189,"_26134":51843,"_2648":51875},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3150":2222,"_27624":2209,"_19171":51877,"_5":13189,"_26134":51843,"_2648":51878},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3150":2223,"_27624":2209,"_19171":51880,"_5":13189,"_26134":51846,"_2648":51881},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3150":2224,"_27624":2209,"_19171":51883,"_5":13189,"_26134":51846,"_2648":51884},[],"An available cryptographic engine to keep the authority's key.",{"_3150":2225,"_27624":2209,"_19171":51886,"_5":13189,"_26134":51846,"_2648":51887},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3150":2226,"_27624":2209,"_19171":51889,"_5":13189,"_26134":51846,"_2648":51890},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3150":2227,"_27624":2209,"_19171":51892,"_5":13189,"_26134":51846,"_2648":51893},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3150":2228,"_27624":2209,"_19171":51895,"_5":13189,"_26134":51853,"_2648":51896},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3150":2229,"_27624":2209,"_19171":51898,"_5":13189,"_26134":51856,"_2648":51899},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3150":2230,"_27624":2209,"_19171":51901,"_5":13189,"_26134":51859,"_2648":51902},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3150":2231,"_27624":2209,"_19171":51904,"_5":13189,"_26134":51862,"_2648":51905},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3150":2232,"_27624":2209,"_19171":51907,"_5":13189,"_26134":51865,"_2648":51908},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3150":2233,"_27624":2209,"_19171":51910,"_5":13189,"_26134":51865,"_2648":51911},[],"its subject and extensions identify the expected client;",{"_3150":2234,"_27624":2209,"_19171":51913,"_5":13189,"_26134":51865,"_2648":51914},[],"its public key matches the client's private key;",{"_3150":2235,"_27624":2209,"_19171":51916,"_5":13189,"_26134":51865,"_2648":51917},[],"its chain reaches a root trusted by the consumer;",{"_3150":2236,"_27624":2209,"_19171":51919,"_5":13189,"_26134":51865,"_2648":51920},[],"its dates and usages allow the operation;",{"_3150":2237,"_27624":2209,"_19171":51922,"_5":13189,"_26134":51865,"_2648":51923},[],"the consumer applies revocation checks and authorization.",{"_3150":2238,"_27624":2209,"_19171":51925,"_5":13189,"_26134":51865,"_2648":51926},[],"The issuance path includes the first independent checks.",{"_3150":2239,"_27624":2209,"_19171":51928,"_5":13189,"_26134":51869,"_2648":51929},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":2240,"_27624":2209,"_19171":51931,"_5":13189,"_26134":51869,"_2648":51932},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3150":2241,"_27624":2209,"_19171":51934,"_5":13189,"_26134":51869,"_2648":51935},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3150":2242,"_27624":2242,"_5":13515,"_2648":51937,"_27967":51938,"_19171":51939,"_26134":2242},"Create your first CA",[44933,46313,50009,49444],[],{"_3150":2243,"_27624":2242,"_19171":51941,"_5":13189,"_26134":2242,"_2648":51942},[],"Create an evaluation root and check its certificate before issuing.",{"_3150":2244,"_27624":2242,"_5":27964,"_19171":51944,"_26134":51945,"_2648":44943},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3150":2245,"_27624":2242,"_5":27964,"_19171":51947,"_26134":51948,"_2648":51949},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3150":2246,"_27624":2242,"_5":27964,"_19171":51951,"_26134":51952,"_2648":51953},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3150":2247,"_27624":2242,"_5":27964,"_19171":51955,"_26134":51956,"_2648":51957},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3150":2248,"_27624":2242,"_5":27964,"_19171":51959,"_26134":51960,"_2648":51961},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3150":2249,"_27624":2242,"_5":27964,"_19171":51963,"_26134":51964,"_2648":51965},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3150":2250,"_27624":2242,"_5":27964,"_19171":51967,"_26134":51968,"_2648":51969},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3150":2251,"_27624":2242,"_5":27964,"_19171":51971,"_26134":51972,"_2648":49702},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3150":2252,"_27624":2242,"_5":27964,"_19171":51974,"_26134":51975,"_2648":44967},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3150":2253,"_27624":2242,"_19171":51977,"_5":13189,"_26134":2242,"_2648":51978},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3150":2254,"_27624":2242,"_19171":51980,"_5":13189,"_26134":51945,"_2648":51981},[],"Console access and permission to create keys and authorities.",{"_3150":2255,"_27624":2242,"_19171":51983,"_5":13189,"_26134":51945,"_2648":51984},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3150":2256,"_27624":2242,"_19171":51986,"_5":13189,"_26134":51945,"_2648":51987},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3150":2257,"_27624":2242,"_19171":51989,"_5":13189,"_26134":51945,"_2648":51990},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3150":2258,"_27624":2242,"_19171":51992,"_5":13189,"_26134":51948,"_2648":51993},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3150":2259,"_27624":2242,"_19171":51995,"_5":13189,"_26134":51948,"_2648":51996},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3150":2260,"_27624":2242,"_19171":51998,"_5":13189,"_26134":51952,"_2648":51999},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3150":2261,"_27624":2242,"_19171":52001,"_5":13189,"_26134":51952,"_2648":52002},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3150":2262,"_27624":2242,"_19171":52004,"_5":13189,"_26134":51956,"_2648":52005},[],"Select **Root CA** and complete:",{"_3150":2263,"_27624":2242,"_19171":52007,"_5":13189,"_26134":51956,"_2648":52008},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3150":2264,"_27624":2242,"_19171":52010,"_5":13189,"_26134":51956,"_2648":52011},[],"**Subject**: organization and country details for your evaluation.",{"_3150":2265,"_27624":2242,"_19171":52013,"_5":13189,"_26134":51956,"_2648":52014},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3150":2266,"_27624":2242,"_19171":52016,"_5":13189,"_26134":51956,"_2648":52017},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3150":2267,"_27624":2242,"_19171":52019,"_5":13189,"_26134":51956,"_2648":52020},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3150":2268,"_27624":2242,"_19171":52022,"_5":13189,"_26134":51960,"_2648":52023},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3150":2269,"_27624":2242,"_19171":52025,"_5":13189,"_26134":51964,"_2648":52026},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3150":2270,"_27624":2242,"_19171":52028,"_5":13189,"_26134":51964,"_2648":52029},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3150":2271,"_27624":2242,"_19171":52031,"_5":13189,"_26134":51968,"_2648":52032},[],"Run from the directory where you saved `ca.pem`:",{"_3150":2272,"_27624":2242,"_19171":52034,"_5":13189,"_26134":51968,"_2648":52035},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3150":2273,"_27624":2242,"_19171":52037,"_5":13189,"_26134":51968,"_2648":52038},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3150":2274,"_27624":2242,"_19171":52040,"_5":13189,"_26134":51972,"_2648":52041},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3150":2275,"_27624":2242,"_19171":52043,"_5":13189,"_26134":51972,"_2648":52044},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3150":2276,"_27624":2242,"_19171":52046,"_5":13189,"_26134":51972,"_2648":52047},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3150":2277,"_27624":2242,"_19171":52049,"_5":13189,"_26134":51972,"_2648":52050},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3150":2278,"_27624":2242,"_19171":52052,"_5":13189,"_26134":51975,"_2648":52053},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3150":2279,"_27624":2279,"_5":13515,"_2648":52055,"_27967":52056,"_19171":52057,"_26134":2279},"Issue and verify a certificate",[44933,46313,50009,49444],[],{"_3150":2280,"_27624":2279,"_19171":52059,"_5":13189,"_26134":2279,"_2648":52060},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3150":2281,"_27624":2279,"_5":27964,"_19171":52062,"_26134":52063,"_2648":44943},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3150":2282,"_27624":2279,"_5":27964,"_19171":52065,"_26134":52066,"_2648":52067},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3150":2283,"_27624":2279,"_5":27964,"_19171":52069,"_26134":52070,"_2648":52071},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3150":2284,"_27624":2279,"_5":27964,"_19171":52073,"_26134":52074,"_2648":52075},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3150":2285,"_27624":2279,"_5":27964,"_19171":52077,"_26134":52078,"_2648":52079},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3150":2286,"_27624":2279,"_5":27964,"_19171":52081,"_26134":52082,"_2648":52083},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3150":2287,"_27624":2279,"_5":27964,"_19171":52085,"_26134":52086,"_2648":51965},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3150":2288,"_27624":2279,"_5":27964,"_19171":52088,"_26134":52089,"_2648":52090},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3150":2289,"_27624":2279,"_5":27964,"_19171":52092,"_26134":52093,"_2648":52094},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3150":2290,"_27624":2279,"_5":27964,"_19171":52096,"_26134":52097,"_2648":52098},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3150":2291,"_27624":2279,"_5":27964,"_19171":52100,"_26134":52101,"_2648":49702},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3150":2292,"_27624":2279,"_5":27964,"_19171":52103,"_26134":52104,"_2648":44967},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#next-step",{"_3150":2293,"_27624":2279,"_19171":52106,"_5":13189,"_26134":2279,"_2648":52107},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3150":2294,"_27624":2279,"_19171":52109,"_5":13189,"_26134":52063,"_2648":52110},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3150":2295,"_27624":2279,"_19171":52112,"_5":13189,"_26134":52063,"_2648":52113},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3150":2296,"_27624":2279,"_19171":52115,"_5":13189,"_26134":52063,"_2648":52116},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3150":2297,"_27624":2279,"_19171":52118,"_5":13189,"_26134":52063,"_2648":52119},[],"A client identifier: here we use `device-001`.",{"_3150":2298,"_27624":2279,"_19171":52121,"_5":13189,"_26134":52063,"_2648":52122},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3150":2299,"_27624":2279,"_19171":52124,"_5":13189,"_26134":52066,"_2648":52125},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3150":2300,"_27624":2279,"_19171":52127,"_5":13189,"_26134":52070,"_2648":52128},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3150":2301,"_27624":2279,"_19171":52130,"_5":13189,"_26134":52070,"_2648":52131},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3150":2302,"_27624":2279,"_19171":52133,"_5":13189,"_26134":52074,"_2648":52134},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3150":2303,"_27624":2279,"_19171":52136,"_5":13189,"_26134":52074,"_2648":52137},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3150":2304,"_27624":2279,"_19171":52139,"_5":13189,"_26134":52078,"_2648":52140},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3150":2305,"_27624":2279,"_19171":52142,"_5":13189,"_26134":52078,"_2648":52143},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3150":2306,"_27624":2279,"_19171":52145,"_5":13189,"_26134":52082,"_2648":52146},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3150":2307,"_27624":2279,"_19171":52148,"_5":13189,"_26134":52086,"_2648":52149},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3150":2308,"_27624":2279,"_19171":52151,"_5":13189,"_26134":52089,"_2648":52152},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3150":2309,"_27624":2279,"_19171":52154,"_5":13189,"_26134":52093,"_2648":52155},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3150":2310,"_27624":2279,"_19171":52157,"_5":13189,"_26134":52093,"_2648":52158},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3150":2311,"_27624":2279,"_19171":52160,"_5":13189,"_26134":52093,"_2648":52161},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3150":2312,"_27624":2279,"_19171":52163,"_5":13189,"_26134":52097,"_2648":52164},[],"In Bash, compare the two public-key digests:",{"_3150":2313,"_27624":2279,"_19171":52166,"_5":13189,"_26134":52097,"_2648":52167},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3150":2314,"_27624":2279,"_19171":52169,"_5":13189,"_26134":52097,"_2648":52170},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3150":2315,"_27624":2279,"_19171":52172,"_5":13189,"_26134":52101,"_2648":49786},[],{"_3150":2316,"_27624":2279,"_19171":52174,"_5":13189,"_26134":52101,"_2648":52175},[],"What to review",{"_3150":2317,"_27624":2279,"_19171":52177,"_5":13189,"_26134":52101,"_2648":52178},[],"The CA rejects issuance",{"_3150":2318,"_27624":2279,"_19171":52180,"_5":13189,"_26134":52101,"_2648":52181},[],"Permissions, CA state and key, algorithm and profile.",{"_3150":2319,"_27624":2279,"_19171":52183,"_5":13189,"_26134":52101,"_2648":52184},[],"Different subject or usages",{"_3150":2320,"_27624":2279,"_19171":52186,"_5":13189,"_26134":52101,"_2648":52187},[],"Applied profile and requested values.",{"_3150":2321,"_27624":2279,"_19171":52189,"_5":13189,"_26134":52101,"_2648":52190},[],"Issuer cannot be found",{"_3150":2322,"_27624":2279,"_19171":52192,"_5":13189,"_26134":52101,"_2648":52193},[],"Downloaded CA and required intermediate chain.",{"_3150":2323,"_27624":2279,"_19171":52195,"_5":13189,"_26134":52101,"_2648":52196},[],"Validity fails",{"_3150":2324,"_27624":2279,"_19171":52198,"_5":13189,"_26134":52101,"_2648":52199},[],"Certificate and CA dates, and the computer's clock.",{"_3150":2325,"_27624":2279,"_19171":52201,"_5":13189,"_26134":52101,"_2648":52202},[],"Public-key digests differ",{"_3150":2326,"_27624":2279,"_19171":52204,"_5":13189,"_26134":52101,"_2648":52205},[],"Certificate and key files from the same issuance.",{"_3150":2327,"_27624":2279,"_19171":52207,"_5":13189,"_26134":52101,"_2648":52208},[],"See PKI diagnostics to narrow an issuance failure.",{"_3150":2328,"_27624":2279,"_19171":52210,"_5":13189,"_26134":52104,"_2648":52211},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3150":2329,"_27624":2279,"_19171":52213,"_5":13189,"_26134":52104,"_2648":52214},[],"Manage certificates for inspection, status and revocation.",{"_3150":2330,"_27624":2279,"_19171":52216,"_5":13189,"_26134":52104,"_2648":52217},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3150":2331,"_27624":2279,"_19171":52219,"_5":13189,"_26134":52104,"_2648":52220},[],"Prepare EST for the device to request its next identities.",{"_3150":2332,"_27624":2279,"_19171":52222,"_5":13189,"_26134":52104,"_2648":52223},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3150":2333,"_27624":2333,"_5":13515,"_2648":52225,"_27967":52226,"_19171":52227,"_26134":2333},"PKI getting started",[44933,46313,50009,49444],[],{"_3150":2334,"_27624":2333,"_19171":52229,"_5":13189,"_26134":2333,"_2648":52230},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3150":2335,"_27624":2333,"_5":27964,"_19171":52232,"_26134":52233,"_2648":44943},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#before-you-begin",{"_3150":2336,"_27624":2333,"_5":27964,"_19171":52235,"_26134":52236,"_2648":52237},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3150":2337,"_27624":2333,"_5":27964,"_19171":52239,"_26134":52240,"_2648":49636},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#expected-result",{"_3150":2338,"_27624":2333,"_5":27964,"_19171":52242,"_26134":52243,"_2648":52244},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3150":2339,"_27624":2333,"_19171":52246,"_5":13189,"_26134":2333,"_2648":52247},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3150":2340,"_27624":2333,"_19171":52249,"_5":13189,"_26134":52233,"_2648":52250},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3150":2341,"_27624":2333,"_19171":52252,"_5":13189,"_26134":52233,"_2648":52253},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3150":2342,"_27624":2333,"_19171":52255,"_5":13189,"_26134":52233,"_2648":52256},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3150":2343,"_27624":2333,"_19171":52258,"_5":13189,"_26134":52233,"_2648":52259},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3150":2344,"_27624":2333,"_19171":52261,"_5":13189,"_26134":52233,"_2648":52262},[],"A working directory with restricted access for the downloaded key.",{"_3150":2345,"_27624":2333,"_19171":52264,"_5":13189,"_26134":52236,"_2648":52265},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3150":2346,"_27624":2333,"_19171":52267,"_5":13189,"_26134":52236,"_2648":52268},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3150":2347,"_27624":2333,"_19171":52270,"_5":13189,"_26134":52236,"_2648":52271},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3150":2348,"_27624":2333,"_19171":52273,"_5":13189,"_26134":52236,"_2648":52274},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3150":2349,"_27624":2333,"_19171":52276,"_5":13189,"_26134":52240,"_2648":52277},[],"File or resource",{"_3150":2350,"_27624":2333,"_19171":52279,"_5":13189,"_26134":52240,"_2648":49633},[],{"_3150":2351,"_27624":2333,"_19171":52281,"_5":13189,"_26134":52240,"_2648":52282},[],"Active root CA and `ca.pem`",{"_3150":2352,"_27624":2333,"_19171":52284,"_5":13189,"_26134":52240,"_2648":52285},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3150":2353,"_27624":2333,"_19171":52287,"_5":13189,"_26134":52240,"_2648":52288},[],"End-entity certificate and `device.crt`",{"_3150":2354,"_27624":2333,"_19171":52290,"_5":13189,"_26134":52240,"_2648":52291},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3150":2355,"_27624":2333,"_19171":52293,"_5":13189,"_26134":52240,"_2648":52294},[],"Private key `device.key`",{"_3150":2356,"_27624":2333,"_19171":52296,"_5":13189,"_26134":52240,"_2648":52297},[],"Its public key matches the one included in `device.crt`.",{"_3150":2357,"_27624":2333,"_19171":52299,"_5":13189,"_26134":52240,"_2648":52300},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3150":2358,"_27624":2333,"_19171":52302,"_5":13189,"_26134":52243,"_2648":52303},[],"To operate certificates, continue with Certificates and Validation.",{"_3150":2359,"_27624":2333,"_19171":52305,"_5":13189,"_26134":52243,"_2648":52306},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3150":2360,"_27624":2333,"_19171":52308,"_5":13189,"_26134":52243,"_2648":52309},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3150":2361,"_27624":2361,"_5":13515,"_2648":52311,"_27967":52312,"_19171":52313,"_26134":2361},"PKI troubleshooting",[44933,46313,50009,48830],[],{"_3150":2362,"_27624":2361,"_19171":52315,"_5":13189,"_26134":2361,"_2648":52316},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3150":2363,"_27624":2361,"_5":27964,"_19171":52318,"_26134":52319,"_2648":52320},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3150":2364,"_27624":2361,"_5":27964,"_19171":52322,"_26134":52323,"_2648":52324},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3150":2365,"_27624":2361,"_5":27964,"_19171":52326,"_26134":52327,"_2648":52328},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3150":2366,"_27624":2361,"_19171":52330,"_5":13189,"_26134":2361,"_2648":52331},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3150":2367,"_27624":2361,"_19171":52333,"_5":13189,"_26134":2361,"_2648":52334},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3150":2368,"_27624":2361,"_19171":52336,"_5":13189,"_26134":52319,"_2648":49633},[],{"_3150":2369,"_27624":2361,"_19171":52338,"_5":13189,"_26134":52319,"_2648":52339},[],"What to inspect",{"_3150":2370,"_27624":2361,"_19171":52341,"_5":13189,"_26134":52319,"_2648":44967},[],{"_3150":2371,"_27624":2361,"_19171":52343,"_5":13189,"_26134":52319,"_2648":52344},[],"CA",{"_3150":2372,"_27624":2361,"_19171":52346,"_5":13189,"_26134":52319,"_2648":52347},[],"Exists, is active and has usable dates.",{"_3150":2373,"_27624":2361,"_19171":52349,"_5":13189,"_26134":52319,"_2648":52350},[],"Authorities.",{"_3150":2374,"_27624":2361,"_19171":52352,"_5":13189,"_26134":52319,"_2648":52353},[],"Key",{"_3150":2375,"_27624":2361,"_19171":52355,"_5":13189,"_26134":52319,"_2648":52356},[],"The record has a usable private key and the engine can sign.",{"_3150":2376,"_27624":2361,"_19171":52358,"_5":13189,"_26134":52319,"_2648":52359},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3150":2377,"_27624":2361,"_19171":52361,"_5":13189,"_26134":52319,"_2648":52362},[],"CSR",{"_3150":2378,"_27624":2361,"_19171":52364,"_5":13189,"_26134":52319,"_2648":52365},[],"Correct PEM and verifiable signature.",{"_3150":2379,"_27624":2361,"_19171":52367,"_5":13189,"_26134":52319,"_2648":52368},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3150":2380,"_27624":2361,"_19171":52370,"_5":13189,"_26134":52319,"_2648":52371},[],"Profile",{"_3150":2381,"_27624":2361,"_19171":52373,"_5":13189,"_26134":52319,"_2648":52374},[],"Selected source, existing ID, allowed algorithm and size.",{"_3150":2382,"_27624":2361,"_19171":52376,"_5":13189,"_26134":52319,"_2648":52377},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3150":2383,"_27624":2361,"_19171":52379,"_5":13189,"_26134":52319,"_2648":49786},[],{"_3150":2384,"_27624":2361,"_19171":52381,"_5":13189,"_26134":52319,"_2648":52382},[],"Appropriate subject, SAN, usages and dates.",{"_3150":2385,"_27624":2361,"_19171":52384,"_5":13189,"_26134":52319,"_2648":52385},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3150":2386,"_27624":2361,"_19171":52387,"_5":13189,"_26134":52319,"_2648":52388},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3150":2387,"_27624":2361,"_19171":52390,"_5":13189,"_26134":52319,"_2648":52391},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3150":2388,"_27624":2361,"_19171":52393,"_5":13189,"_26134":52323,"_2648":52394},[],"Check each boundary independently:",{"_3150":2389,"_27624":2361,"_19171":52396,"_5":13189,"_26134":52323,"_2648":52397},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3150":2390,"_27624":2361,"_19171":52399,"_5":13189,"_26134":52323,"_2648":52400},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3150":2391,"_27624":2361,"_19171":52402,"_5":13189,"_26134":52323,"_2648":52403},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3150":2392,"_27624":2361,"_19171":52405,"_5":13189,"_26134":52323,"_2648":52406},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3150":2393,"_27624":2361,"_19171":52408,"_5":13189,"_26134":52323,"_2648":52409},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3150":2394,"_27624":2361,"_19171":52411,"_5":13189,"_26134":52323,"_2648":52412},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3150":2395,"_27624":2361,"_19171":52414,"_5":13189,"_26134":52327,"_2648":52415},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3150":2396,"_27624":2361,"_19171":52417,"_5":13189,"_26134":52327,"_2648":52418},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3150":2397,"_27624":2397,"_5":13515,"_2648":52420,"_27967":52421,"_19171":52423,"_26134":2397},"3.8.0 to 4.0.0",[44933,52422],"Upgrades",[],{"_3150":2398,"_27624":2397,"_19171":52425,"_5":13189,"_26134":2397,"_2648":52426},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3150":2399,"_27624":2397,"_5":27964,"_19171":52428,"_26134":52429,"_2648":52430},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3150":2400,"_27624":2397,"_5":27964,"_19171":52432,"_26134":52433,"_2648":52434},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3150":2401,"_27624":2397,"_5":27964,"_19171":52436,"_26134":52437,"_2648":52438},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3150":2402,"_27624":2397,"_5":27964,"_19171":52440,"_26134":52441,"_2648":52442},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3150":2403,"_27624":2397,"_5":27964,"_19171":52444,"_26134":52445,"_2648":52446},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3150":2404,"_27624":2397,"_5":27964,"_19171":52448,"_26134":52449,"_2648":52450},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3150":2405,"_27624":2397,"_5":27964,"_19171":52452,"_26134":52453,"_2648":52454},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3150":2406,"_27624":2397,"_5":27964,"_19171":52456,"_26134":52457,"_2648":52458},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3150":2407,"_27624":2397,"_5":27964,"_19171":52460,"_26134":52461,"_2648":52462},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3150":2408,"_27624":2397,"_5":27964,"_19171":52464,"_26134":52465,"_2648":52466},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3150":2409,"_27624":2397,"_5":27964,"_19171":52468,"_26134":52469,"_2648":52470},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3150":2410,"_27624":2397,"_5":27964,"_19171":52472,"_26134":52473,"_2648":52474},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3150":2411,"_27624":2397,"_5":27964,"_19171":52476,"_26134":52477,"_2648":52478},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3150":2412,"_27624":2397,"_5":27964,"_19171":52480,"_26134":52481,"_2648":52482},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3150":2413,"_27624":2397,"_5":27964,"_19171":52484,"_26134":52485,"_2648":52486},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3150":2414,"_27624":2397,"_5":27964,"_19171":52488,"_26134":52489,"_2648":52490},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3150":2415,"_27624":2397,"_5":27964,"_19171":52492,"_26134":52493,"_2648":52494},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3150":2416,"_27624":2397,"_5":27964,"_19171":52496,"_26134":52497,"_2648":52498},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3150":2417,"_27624":2397,"_5":27964,"_19171":52500,"_26134":52501,"_2648":52502},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3150":2418,"_27624":2397,"_5":27964,"_19171":52504,"_26134":52505,"_2648":52506},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3150":2419,"_27624":2397,"_5":27964,"_19171":52508,"_26134":52509,"_2648":52510},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3150":2420,"_27624":2397,"_5":27964,"_19171":52512,"_26134":52513,"_2648":52514},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3150":2421,"_27624":2397,"_5":27964,"_19171":52516,"_26134":52517,"_2648":52518},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3150":2422,"_27624":2397,"_5":27964,"_19171":52520,"_26134":52521,"_2648":52522},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3150":2423,"_27624":2397,"_5":27964,"_19171":52524,"_26134":52525,"_2648":52526},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3150":2424,"_27624":2397,"_5":27964,"_19171":52528,"_26134":52529,"_2648":52530},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3150":2425,"_27624":2397,"_5":27964,"_19171":52532,"_26134":52533,"_2648":52534},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3150":2426,"_27624":2397,"_5":27964,"_19171":52536,"_26134":52537,"_2648":52538},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3150":2427,"_27624":2397,"_5":27964,"_19171":52540,"_26134":52541,"_2648":52542},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3150":2428,"_27624":2397,"_5":27964,"_19171":52544,"_26134":52545,"_2648":52546},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3150":2429,"_27624":2397,"_5":27964,"_19171":52548,"_26134":52549,"_2648":52550},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3150":2430,"_27624":2397,"_5":27964,"_19171":52552,"_26134":52553,"_2648":52554},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3150":2431,"_27624":2397,"_5":27964,"_19171":52556,"_26134":52557,"_2648":52558},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3150":2432,"_27624":2397,"_5":27964,"_19171":52560,"_26134":52561,"_2648":48830},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3150":2433,"_27624":2397,"_5":27964,"_19171":52563,"_26134":52564,"_2648":52565},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3150":2434,"_27624":2397,"_5":27964,"_19171":52567,"_26134":52568,"_2648":52569},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3150":2435,"_27624":2397,"_19171":52571,"_5":13189,"_26134":2397,"_2648":52572},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3150":2436,"_27624":2397,"_19171":52574,"_5":13189,"_26134":2397,"_2648":52575},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3150":2437,"_27624":2397,"_19171":52577,"_5":13189,"_26134":2397,"_2648":52578},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3150":2438,"_27624":2397,"_19171":52580,"_5":13189,"_26134":2397,"_2648":52581},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3150":2439,"_27624":2397,"_19171":52583,"_5":13189,"_26134":2397,"_2648":52584},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3150":2440,"_27624":2397,"_19171":52586,"_5":13189,"_26134":2397,"_2648":52587},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3150":2441,"_27624":2397,"_19171":52589,"_5":13189,"_26134":2397,"_2648":52590},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3150":2442,"_27624":2397,"_19171":52592,"_5":13189,"_26134":52433,"_2648":52593},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3150":2443,"_27624":2397,"_19171":52595,"_5":13189,"_26134":52433,"_2648":52596},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3150":2444,"_27624":2397,"_19171":52598,"_5":13189,"_26134":52437,"_2648":52599},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3150":2445,"_27624":2397,"_19171":52601,"_5":13189,"_26134":52437,"_2648":52602},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3150":2446,"_27624":2397,"_19171":52604,"_5":13189,"_26134":52441,"_2648":52605},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3150":2447,"_27624":2397,"_19171":52607,"_5":13189,"_26134":52445,"_2648":52608},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3150":2448,"_27624":2397,"_19171":52610,"_5":13189,"_26134":52445,"_2648":52611},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3150":2449,"_27624":2397,"_19171":52613,"_5":13189,"_26134":52445,"_2648":52614},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3150":2450,"_27624":2397,"_19171":52616,"_5":13189,"_26134":52445,"_2648":52617},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3150":2451,"_27624":2397,"_19171":52619,"_5":13189,"_26134":52445,"_2648":52620},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3150":2452,"_27624":2397,"_19171":52622,"_5":13189,"_26134":52449,"_2648":52623},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3150":2453,"_27624":2397,"_19171":52625,"_5":13189,"_26134":52449,"_2648":52626},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3150":2454,"_27624":2397,"_19171":52628,"_5":13189,"_26134":52449,"_2648":52629},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3150":2455,"_27624":2397,"_19171":52631,"_5":13189,"_26134":52449,"_2648":52632},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3150":2456,"_27624":2397,"_19171":52634,"_5":13189,"_26134":52449,"_2648":52635},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3150":2457,"_27624":2397,"_19171":52637,"_5":13189,"_26134":52453,"_2648":52638},[],"Change",{"_3150":2458,"_27624":2397,"_19171":52640,"_5":13189,"_26134":52453,"_2648":52641},[],"Who is affected",{"_3150":2459,"_27624":2397,"_19171":52643,"_5":13189,"_26134":52453,"_2648":52644},[],"Severity",{"_3150":2460,"_27624":2397,"_19171":52646,"_5":13189,"_26134":52453,"_2648":52647},[],"Action",{"_3150":2461,"_27624":2397,"_19171":52649,"_5":13189,"_26134":52453,"_2648":52462},[],{"_3150":2462,"_27624":2397,"_19171":52651,"_5":13189,"_26134":52453,"_2648":52652},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3150":2463,"_27624":2397,"_19171":52654,"_5":13189,"_26134":52453,"_2648":52655},[],"High: KMS and VA start on empty volumes",{"_3150":2464,"_27624":2397,"_19171":52657,"_5":13189,"_26134":52453,"_2648":52658},[],"Copy the data into the new volumes",{"_3150":2465,"_27624":2397,"_19171":52660,"_5":13189,"_26134":52453,"_2648":52466},[],{"_3150":2466,"_27624":2397,"_19171":52662,"_5":13189,"_26134":52453,"_2648":52663},[],"Every Helm release",{"_3150":2467,"_27624":2397,"_19171":52665,"_5":13189,"_26134":52453,"_2648":52666},[],"High: `helm upgrade` fails",{"_3150":2468,"_27624":2397,"_19171":52668,"_5":13189,"_26134":52453,"_2648":52669},[],"Remove or rename legacy keys",{"_3150":2469,"_27624":2397,"_19171":52671,"_5":13189,"_26134":52453,"_2648":52470},[],{"_3150":2470,"_27624":2397,"_19171":52673,"_5":13189,"_26134":52453,"_2648":52674},[],"Every deployment",{"_3150":2471,"_27624":2397,"_19171":52676,"_5":13189,"_26134":52453,"_2648":52677},[],"High: without a bootstrap principal there is no administrator",{"_3150":2472,"_27624":2397,"_19171":52679,"_5":13189,"_26134":52453,"_2648":52680},[],"Configure `services.authz`",{"_3150":2473,"_27624":2397,"_19171":52682,"_5":13189,"_26134":52453,"_2648":52474},[],{"_3150":2474,"_27624":2397,"_19171":52684,"_5":13189,"_26134":52453,"_2648":52663},[],{"_3150":2475,"_27624":2397,"_19171":52686,"_5":13189,"_26134":52453,"_2648":52687},[],"High: `helm upgrade` fails on the old keys",{"_3150":2476,"_27624":2397,"_19171":52689,"_5":13189,"_26134":52453,"_2648":52690},[],"Move JWKS and roles into `services.authz`",{"_3150":2477,"_27624":2397,"_19171":52692,"_5":13189,"_26134":52453,"_2648":52494},[],{"_3150":2478,"_27624":2397,"_19171":52694,"_5":13189,"_26134":52453,"_2648":52695},[],"3.8.0 deployments with per-service databases",{"_3150":2479,"_27624":2397,"_19171":52697,"_5":13189,"_26134":52453,"_2648":52698},[],"High: services find no data, or a migration aborts",{"_3150":2480,"_27624":2397,"_19171":52700,"_5":13189,"_26134":52453,"_2648":52701},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3150":2481,"_27624":2397,"_19171":52703,"_5":13189,"_26134":52453,"_2648":52498},[],{"_3150":2482,"_27624":2397,"_19171":52705,"_5":13189,"_26134":52453,"_2648":52706},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3150":2483,"_27624":2397,"_19171":52708,"_5":13189,"_26134":52453,"_2648":52709},[],"High: the backend no longer starts with them",{"_3150":2484,"_27624":2397,"_19171":52711,"_5":13189,"_26134":52453,"_2648":52712},[],"Move to PostgreSQL before upgrading",{"_3150":2485,"_27624":2397,"_19171":52714,"_5":13189,"_26134":52453,"_2648":52715},[],"Webhooks with file references",{"_3150":2486,"_27624":2397,"_19171":52717,"_5":13189,"_26134":52453,"_2648":52718},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3150":2487,"_27624":2397,"_19171":52720,"_5":13189,"_26134":52453,"_2648":52721},[],"High: enrollments calling the webhook fail",{"_3150":2488,"_27624":2397,"_19171":52723,"_5":13189,"_26134":52453,"_2648":52724},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3150":2489,"_27624":2397,"_19171":52726,"_5":13189,"_26134":52453,"_2648":52478},[],{"_3150":2490,"_27624":2397,"_19171":52728,"_5":13189,"_26134":52453,"_2648":52729},[],"Releases with per-service identity overrides or mounted key material",{"_3150":2491,"_27624":2397,"_19171":52731,"_5":13189,"_26134":52453,"_2648":52732},[],"Medium: services cannot read their files",{"_3150":2492,"_27624":2397,"_19171":52734,"_5":13189,"_26134":52453,"_2648":52735},[],"Remove the overrides and fix volume ownership",{"_3150":2493,"_27624":2397,"_19171":52737,"_5":13189,"_26134":52453,"_2648":52482},[],{"_3150":2494,"_27624":2397,"_19171":52739,"_5":13189,"_26134":52453,"_2648":52740},[],"Releases that set `amqp.tls`",{"_3150":2495,"_27624":2397,"_19171":52742,"_5":13189,"_26134":52453,"_2648":52743},[],"Medium: clients connect to the wrong port",{"_3150":2496,"_27624":2397,"_19171":52745,"_5":13189,"_26134":52453,"_2648":52746},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3150":2497,"_27624":2397,"_19171":52748,"_5":13189,"_26134":52453,"_2648":52502},[],{"_3150":2498,"_27624":2397,"_19171":52750,"_5":13189,"_26134":52453,"_2648":52751},[],"Installations whose CA keys predate the KMS",{"_3150":2499,"_27624":2397,"_19171":52753,"_5":13189,"_26134":52453,"_2648":52754},[],"Medium: CA keys stay unmanaged",{"_3150":2500,"_27624":2397,"_19171":52756,"_5":13189,"_26134":52453,"_2648":52757},[],"Run the CA-to-KMS migration",{"_3150":2501,"_27624":2397,"_19171":52759,"_5":13189,"_26134":52453,"_2648":52760},[],"Receiver certificate verification",{"_3150":2502,"_27624":2397,"_19171":52762,"_5":13189,"_26134":52453,"_2648":52763},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3150":2503,"_27624":2397,"_19171":52765,"_5":13189,"_26134":52453,"_2648":52766},[],"Medium: credentials go to an unverified receiver",{"_3150":2504,"_27624":2397,"_19171":52768,"_5":13189,"_26134":52453,"_2648":52769},[],"Set `insecure_skip_verify` to `false`",{"_3150":2505,"_27624":2397,"_19171":52771,"_5":13189,"_26134":52453,"_2648":52514},[],{"_3150":2506,"_27624":2397,"_19171":52773,"_5":13189,"_26134":52453,"_2648":52774},[],"Scripts and consoles that edit DMSs through the API",{"_3150":2507,"_27624":2397,"_19171":52776,"_5":13189,"_26134":52453,"_2648":52777},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3150":2508,"_27624":2397,"_19171":52779,"_5":13189,"_26134":52453,"_2648":52780},[],"Read the DMS before editing and use the new field",{"_3150":2509,"_27624":2397,"_19171":52782,"_5":13189,"_26134":52453,"_2648":52530},[],{"_3150":2510,"_27624":2397,"_19171":52784,"_5":13189,"_26134":52453,"_2648":52785},[],"Consumers that read the device `events` field",{"_3150":2511,"_27624":2397,"_19171":52787,"_5":13189,"_26134":52453,"_2648":52788},[],"Medium: the field disappears",{"_3150":2512,"_27624":2397,"_19171":52790,"_5":13189,"_26134":52453,"_2648":52791},[],"Use the new event endpoints",{"_3150":2513,"_27624":2397,"_19171":52793,"_5":13189,"_26134":52453,"_2648":52486},[],{"_3150":2514,"_27624":2397,"_19171":52795,"_5":13189,"_26134":52453,"_2648":52796},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3150":2515,"_27624":2397,"_19171":52798,"_5":13189,"_26134":52453,"_2648":52799},[],"Low to medium: validation errors or changed defaults",{"_3150":2516,"_27624":2397,"_19171":52801,"_5":13189,"_26134":52453,"_2648":52802},[],"Update the values file",{"_3150":2517,"_27624":2397,"_19171":52804,"_5":13189,"_26134":52453,"_2648":52522},[],{"_3150":2518,"_27624":2397,"_19171":52806,"_5":13189,"_26134":52453,"_2648":52807},[],"Clients that send the DMS ID in the update body",{"_3150":2519,"_27624":2397,"_19171":52809,"_5":13189,"_26134":52453,"_2648":52810},[],"Low: the ID in the URL wins",{"_3150":2520,"_27624":2397,"_19171":52812,"_5":13189,"_26134":52453,"_2648":52813},[],"Send the ID in the URL",{"_3150":2521,"_27624":2397,"_19171":52815,"_5":13189,"_26134":52453,"_2648":52526},[],{"_3150":2522,"_27624":2397,"_19171":52817,"_5":13189,"_26134":52453,"_2648":52818},[],"Consumers that match on certificate `type`",{"_3150":2523,"_27624":2397,"_19171":52820,"_5":13189,"_26134":52453,"_2648":52821},[],"Low: two values are renamed",{"_3150":2524,"_27624":2397,"_19171":52823,"_5":13189,"_26134":52453,"_2648":52824},[],"Adapt consumers",{"_3150":2525,"_27624":2397,"_19171":52826,"_5":13189,"_26134":52453,"_2648":52518},[],{"_3150":2526,"_27624":2397,"_19171":52828,"_5":13189,"_26134":52453,"_2648":52829},[],"Any DMS",{"_3150":2527,"_27624":2397,"_19171":52831,"_5":13189,"_26134":52453,"_2648":52832},[],"Low: informational",{"_3150":2528,"_27624":2397,"_19171":52834,"_5":13189,"_26134":52453,"_2648":52835},[],"Read both blocks before editing",{"_3150":2529,"_27624":2397,"_19171":52837,"_5":13189,"_26134":52461,"_2648":52838},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3150":2530,"_27624":2397,"_19171":52840,"_5":13189,"_26134":52461,"_2648":52841},[],"Step 4 of the migration guide copies the data.",{"_3150":2531,"_27624":2397,"_19171":52843,"_5":13189,"_26134":52465,"_2648":52844},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3150":2532,"_27624":2397,"_19171":52846,"_5":13189,"_26134":52469,"_2648":52847},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3150":2533,"_27624":2397,"_19171":52849,"_5":13189,"_26134":52473,"_2648":52850},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3150":2534,"_27624":2397,"_19171":52852,"_5":13189,"_26134":52477,"_2648":52853},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3150":2535,"_27624":2397,"_19171":52855,"_5":13189,"_26134":52477,"_2648":52856},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3150":2536,"_27624":2397,"_19171":52858,"_5":13189,"_26134":52481,"_2648":52859},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3150":2537,"_27624":2397,"_19171":52861,"_5":13189,"_26134":52485,"_2648":52862},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3150":2538,"_27624":2397,"_19171":52864,"_5":13189,"_26134":52485,"_2648":52865},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3150":2539,"_27624":2397,"_19171":52867,"_5":13189,"_26134":52485,"_2648":52868},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3150":2540,"_27624":2397,"_19171":52870,"_5":13189,"_26134":52485,"_2648":52871},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3150":2541,"_27624":2397,"_19171":52873,"_5":13189,"_26134":52485,"_2648":52874},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3150":2542,"_27624":2397,"_19171":52876,"_5":13189,"_26134":52485,"_2648":52877},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3150":2543,"_27624":2397,"_19171":52879,"_5":13189,"_26134":52493,"_2648":52880},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3150":2544,"_27624":2397,"_19171":52882,"_5":13189,"_26134":52493,"_2648":52883},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3150":2545,"_27624":2397,"_19171":52885,"_5":13189,"_26134":52493,"_2648":52886},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3150":2546,"_27624":2397,"_19171":52888,"_5":13189,"_26134":52493,"_2648":52889},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3150":2547,"_27624":2397,"_19171":52891,"_5":13189,"_26134":52493,"_2648":52892},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3150":2548,"_27624":2397,"_19171":52894,"_5":13189,"_26134":52497,"_2648":52895},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3150":2549,"_27624":2397,"_19171":52897,"_5":13189,"_26134":52501,"_2648":52898},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3150":2550,"_27624":2397,"_19171":52900,"_5":13189,"_26134":52501,"_2648":52901},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3150":2551,"_27624":2397,"_19171":52903,"_5":13189,"_26134":52501,"_2648":52904},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3150":2552,"_27624":2397,"_19171":52906,"_5":13189,"_26134":52501,"_2648":52907},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3150":2553,"_27624":2397,"_19171":52909,"_5":13189,"_26134":52501,"_2648":52910},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3150":2554,"_27624":2397,"_19171":52912,"_5":13189,"_26134":52501,"_2648":52913},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3150":2555,"_27624":2397,"_19171":52915,"_5":13189,"_26134":52509,"_2648":52916},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3150":2556,"_27624":2397,"_19171":52918,"_5":13189,"_26134":52509,"_2648":52919},[],"Field in 3.8.0",{"_3150":2557,"_27624":2397,"_19171":52921,"_5":13189,"_26134":52509,"_2648":52922},[],"Field in 4.0.0",{"_3150":2558,"_27624":2397,"_19171":52924,"_5":13189,"_26134":52509,"_2648":52925},[],"`validate_server_cert`",{"_3150":2559,"_27624":2397,"_19171":52927,"_5":13189,"_26134":52509,"_2648":52928},[],"`insecure_skip_verify` (value negated)",{"_3150":2560,"_27624":2397,"_19171":52930,"_5":13189,"_26134":52509,"_2648":52931},[],"`oidc`",{"_3150":2561,"_27624":2397,"_19171":52933,"_5":13189,"_26134":52509,"_2648":52934},[],"`jwt_options`",{"_3150":2562,"_27624":2397,"_19171":52936,"_5":13189,"_26134":52509,"_2648":52937},[],"`apikey`",{"_3150":2563,"_27624":2397,"_19171":52939,"_5":13189,"_26134":52509,"_2648":52940},[],"`apikey_options`",{"_3150":2564,"_27624":2397,"_19171":52942,"_5":13189,"_26134":52509,"_2648":52943},[],"`mtls`",{"_3150":2565,"_27624":2397,"_19171":52945,"_5":13189,"_26134":52509,"_2648":52946},[],"`mtls_options`",{"_3150":2566,"_27624":2397,"_19171":52948,"_5":13189,"_26134":52509,"_2648":52949},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3150":2567,"_27624":2397,"_19171":52951,"_5":13189,"_26134":52509,"_2648":52952},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3150":2568,"_27624":2397,"_19171":52954,"_5":13189,"_26134":52509,"_2648":52955},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3150":2569,"_27624":2397,"_19171":52957,"_5":13189,"_26134":52513,"_2648":52958},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3150":2570,"_27624":2397,"_19171":52960,"_5":13189,"_26134":52513,"_2648":52961},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3150":2571,"_27624":2397,"_19171":52963,"_5":13189,"_26134":52513,"_2648":52964},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3150":2572,"_27624":2397,"_19171":52966,"_5":13189,"_26134":52517,"_2648":52967},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API.",{"_3150":2573,"_27624":2397,"_19171":52969,"_5":13189,"_26134":52521,"_2648":52970},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3150":2574,"_27624":2397,"_19171":52972,"_5":13189,"_26134":52525,"_2648":52973},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3150":2575,"_27624":2397,"_19171":52975,"_5":13189,"_26134":52529,"_2648":52976},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3150":2576,"_27624":2397,"_19171":52978,"_5":13189,"_26134":52529,"_2648":52979},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3150":2577,"_27624":2397,"_19171":52981,"_5":13189,"_26134":52529,"_2648":52982},[],"`POST /v1/devices/:id/events` creates an event.",{"_3150":2578,"_27624":2397,"_19171":52984,"_5":13189,"_26134":52529,"_2648":52985},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3150":2579,"_27624":2397,"_19171":52987,"_5":13189,"_26134":52533,"_2648":52988},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3150":2580,"_27624":2397,"_19171":52990,"_5":13189,"_26134":52537,"_2648":52991},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3150":2581,"_27624":2397,"_19171":52993,"_5":13189,"_26134":52537,"_2648":52994},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3150":2582,"_27624":2397,"_19171":52996,"_5":13189,"_26134":52537,"_2648":52997},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3150":2583,"_27624":2397,"_19171":52999,"_5":13189,"_26134":52537,"_2648":53000},[],"Record the names of your local-storage PVCs:",{"_3150":2584,"_27624":2397,"_19171":53002,"_5":13189,"_26134":52537,"_2648":53003},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3150":2585,"_27624":2397,"_19171":53005,"_5":13189,"_26134":52541,"_2648":53006},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3150":2586,"_27624":2397,"_19171":53008,"_5":13189,"_26134":52541,"_2648":53009},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3150":2587,"_27624":2397,"_19171":53011,"_5":13189,"_26134":52541,"_2648":53012},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3150":2588,"_27624":2397,"_19171":53014,"_5":13189,"_26134":52541,"_2648":53015},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3150":2589,"_27624":2397,"_19171":53017,"_5":13189,"_26134":52541,"_2648":53018},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3150":2590,"_27624":2397,"_19171":53020,"_5":13189,"_26134":52541,"_2648":53021},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3150":2591,"_27624":2397,"_19171":53023,"_5":13189,"_26134":52541,"_2648":53024},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3150":2592,"_27624":2397,"_19171":53026,"_5":13189,"_26134":52541,"_2648":53027},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3150":2593,"_27624":2397,"_19171":53029,"_5":13189,"_26134":52541,"_2648":53030},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3150":2594,"_27624":2397,"_19171":53032,"_5":13189,"_26134":52541,"_2648":53033},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3150":2595,"_27624":2397,"_19171":53035,"_5":13189,"_26134":52541,"_2648":53036},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3150":2596,"_27624":2397,"_19171":53038,"_5":13189,"_26134":52541,"_2648":53039},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3150":2597,"_27624":2397,"_19171":53041,"_5":13189,"_26134":52545,"_2648":53042},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3150":2598,"_27624":2397,"_19171":53044,"_5":13189,"_26134":52545,"_2648":53045},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3150":2599,"_27624":2397,"_19171":53047,"_5":13189,"_26134":52549,"_2648":53048},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3150":2600,"_27624":2397,"_19171":53050,"_5":13189,"_26134":52549,"_2648":53051},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3150":2601,"_27624":2397,"_19171":53053,"_5":13189,"_26134":52549,"_2648":53054},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If the check prints `ABORT`, stop: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3150":2602,"_27624":2397,"_19171":53056,"_5":13189,"_26134":52549,"_2648":53057},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3150":2603,"_27624":2397,"_19171":53059,"_5":13189,"_26134":52549,"_2648":53060},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3150":2604,"_27624":2397,"_19171":53062,"_5":13189,"_26134":52549,"_2648":53063},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3150":2605,"_27624":2397,"_19171":53065,"_5":13189,"_26134":52549,"_2648":53066},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3150":2606,"_27624":2397,"_19171":53068,"_5":13189,"_26134":52549,"_2648":53069},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3150":2607,"_27624":2397,"_19171":53071,"_5":13189,"_26134":52549,"_2648":53072},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3150":2608,"_27624":2397,"_19171":53074,"_5":13189,"_26134":52549,"_2648":53075},[],"**Remove the helper and restore the recorded replica counts:**",{"_3150":2609,"_27624":2397,"_19171":53077,"_5":13189,"_26134":52549,"_2648":53078},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3150":2610,"_27624":2397,"_19171":53080,"_5":13189,"_26134":52553,"_2648":53081},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3150":2611,"_27624":2397,"_19171":53083,"_5":13189,"_26134":52553,"_2648":53084},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3150":2612,"_27624":2397,"_19171":53086,"_5":13189,"_26134":52557,"_2648":53087},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3150":2613,"_27624":2397,"_19171":53089,"_5":13189,"_26134":52557,"_2648":53090},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3150":2614,"_27624":2397,"_19171":53092,"_5":13189,"_26134":52557,"_2648":53093},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3150":2615,"_27624":2397,"_19171":53095,"_5":13189,"_26134":52557,"_2648":53096},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3150":2616,"_27624":2397,"_19171":53098,"_5":13189,"_26134":52557,"_2648":53099},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3150":2617,"_27624":2397,"_19171":53101,"_5":13189,"_26134":52561,"_2648":53102},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3150":2618,"_27624":2397,"_19171":53104,"_5":13189,"_26134":52561,"_2648":53105},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3150":2619,"_27624":2397,"_19171":53107,"_5":13189,"_26134":52561,"_2648":53108},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3150":2620,"_27624":2397,"_19171":53110,"_5":13189,"_26134":52561,"_2648":53111},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3150":2621,"_27624":2397,"_19171":53113,"_5":13189,"_26134":52561,"_2648":53114},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3150":2622,"_27624":2397,"_19171":53116,"_5":13189,"_26134":52561,"_2648":53117},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3150":2623,"_27624":2397,"_19171":53119,"_5":13189,"_26134":52561,"_2648":53120},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3150":2624,"_27624":2397,"_19171":53122,"_5":13189,"_26134":52564,"_2648":53123},[],"After the upgrade, check in this order:",{"_3150":2625,"_27624":2397,"_19171":53125,"_5":13189,"_26134":52564,"_2648":53126},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3150":2626,"_27624":2397,"_19171":53128,"_5":13189,"_26134":52564,"_2648":53129},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3150":2627,"_27624":2397,"_19171":53131,"_5":13189,"_26134":52564,"_2648":53132},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3150":2628,"_27624":2397,"_19171":53134,"_5":13189,"_26134":52564,"_2648":53135},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3150":2629,"_27624":2397,"_19171":53137,"_5":13189,"_26134":52564,"_2648":53138},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3150":2630,"_27624":2397,"_19171":53140,"_5":13189,"_26134":52564,"_2648":53141},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3150":2631,"_27624":2397,"_19171":53143,"_5":13189,"_26134":52564,"_2648":53144},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3150":2632,"_27624":2397,"_19171":53146,"_5":13189,"_26134":52564,"_2648":53147},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3150":2633,"_27624":2397,"_19171":53149,"_5":13189,"_26134":52564,"_2648":53150},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3150":2634,"_27624":2397,"_19171":53152,"_5":13189,"_26134":52564,"_2648":53153},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3150":2635,"_27624":2397,"_19171":53155,"_5":13189,"_26134":52564,"_2648":53156},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3150":2636,"_27624":2397,"_19171":53158,"_5":13189,"_26134":52564,"_2648":53159},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3150":2637,"_27624":2397,"_19171":53161,"_5":13189,"_26134":52564,"_2648":53162},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3150":2638,"_27624":2397,"_19171":53164,"_5":13189,"_26134":52564,"_2648":53165},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3150":2639,"_27624":2397,"_19171":53167,"_5":13189,"_26134":52568,"_2648":53168},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3150":2640,"_27624":2397,"_19171":53170,"_5":13189,"_26134":52568,"_2648":53171},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3150":2641,"_27624":2397,"_19171":53173,"_5":13189,"_26134":52568,"_2648":53174},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":2642,"_27624":2397,"_19171":53176,"_5":13189,"_26134":52568,"_2648":53177},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3150":2643,"_27624":2397,"_19171":53179,"_5":13189,"_26134":52568,"_2648":53180},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53183":53184,"_53185":53186,"_53187":53188,"_53189":53190,"_16717":2670,"_63720":2670},"language","english","sortableProperties",[2648,27624,5,26134],"sortablePropertiesWithTypes",{"_2648":22920,"_27624":22920,"_5":22920,"_26134":22920},"sorts",{"_2648":53191,"_27624":55824,"_5":58456,"_26134":61088},{"_4214":53192,"_53193":53194,"_5":22920},{"_13244":4656,"_13614":6929,"_13621":5547,"_11885":3238,"_26260":6773,"_18205":3105,"_13265":4686,"_13272":3024,"_26687":5590,"_27074":6553,"_27095":6607,"_26705":5264,"_31731":3769,"_27106":7583,"_27135":3261,"_31738":5358,"_31741":7232,"_31744":5989,"_31747":2923,"_27483":5438,"_31752":4171,"_31754":3589,"_27513":4424,"_27473":2914,"_31758":5014,"_27682":5075,"_31762":4341,"_27124":12829,"_27478":15117,"_27537":11115,"_31767":11247,"_31769":3370,"_31771":7305,"_31773":2745,"_31775":19283,"_31777":5395,"_31779":5986,"_31781":3339,"_31783":3405,"_26758":11149,"_31786":5862,"_31788":10673,"_2