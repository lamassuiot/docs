":52904,"_36758":52907,"_36760":52910,"_36762":52913,"_36764":52916,"_36766":52919,"_36768":52922,"_36770":52925,"_36772":52928,"_36774":52931,"_36776":52934,"_36778":52937,"_36780":52940,"_36782":52943,"_36784":52946,"_36786":52949,"_36788":52952,"_36790":52955,"_36792":52958,"_36794":52961,"_36796":52964,"_36798":52967,"_36800":52970,"_36802":52973,"_36804":52976,"_36806":52979,"_36808":52982,"_36810":52985,"_36812":52988,"_36814":52991,"_36816":52994},{"_3144":15,"_27488":15,"_5":13476,"_2643":44762,"_27831":44763,"_19100":44767,"_26023":15},"Deploy from AWS Marketplace",[44764,44765,44766],"Docs","Deployment","Other models",[],{"_3144":16,"_27488":15,"_19100":44769,"_5":13150,"_26023":15,"_2643":44770},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3144":17,"_27488":15,"_5":27828,"_19100":44772,"_26023":44773,"_2643":44774},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3144":18,"_27488":15,"_5":27828,"_19100":44776,"_26023":44777,"_2643":44778},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3144":19,"_27488":15,"_5":27828,"_19100":44780,"_26023":44781,"_2643":44782},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3144":20,"_27488":15,"_5":27828,"_19100":44784,"_26023":44785,"_2643":44786},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3144":21,"_27488":15,"_5":27828,"_19100":44788,"_26023":44789,"_2643":44790},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3144":22,"_27488":15,"_5":27828,"_19100":44792,"_26023":44793,"_2643":44794},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3144":23,"_27488":15,"_5":27828,"_19100":44796,"_26023":44797,"_2643":44798},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#next-step","Next step",{"_3144":24,"_27488":15,"_19100":44800,"_5":13150,"_26023":15,"_2643":44801},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3144":25,"_27488":15,"_19100":44803,"_5":13150,"_26023":44773,"_2643":44804},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3144":26,"_27488":15,"_19100":44806,"_5":13150,"_26023":44773,"_2643":44807},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3144":27,"_27488":15,"_19100":44809,"_5":13150,"_26023":44773,"_2643":44810},[],"A security group allowing the necessary endpoints.",{"_3144":28,"_27488":15,"_19100":44812,"_5":13150,"_26023":44777,"_2643":44813},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3144":29,"_27488":15,"_19100":44815,"_5":13150,"_26023":44777,"_2643":44816},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3144":30,"_27488":15,"_19100":44818,"_5":13150,"_26023":44777,"_2643":44819},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3144":31,"_27488":15,"_19100":44821,"_5":13150,"_26023":44781,"_2643":44822},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3144":32,"_27488":15,"_19100":44824,"_5":13150,"_26023":44785,"_2643":44825},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3144":33,"_27488":15,"_19100":44827,"_5":13150,"_26023":44789,"_2643":44828},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3144":34,"_27488":15,"_19100":44830,"_5":13150,"_26023":44793,"_2643":44831},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3144":35,"_27488":15,"_19100":44833,"_5":13150,"_26023":44797,"_2643":44834},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3144":36,"_27488":36,"_5":13476,"_2643":44836,"_27831":44837,"_19100":44838,"_26023":36},"Deploy Lamassu",[44764,44765],[],{"_3144":37,"_27488":36,"_19100":44840,"_5":13150,"_26023":36,"_2643":44841},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3144":38,"_27488":36,"_5":27828,"_19100":44843,"_26023":44844,"_2643":44845},[],"/docs/pr-preview/pr-26/deployment/overview#choose-a-model","Choose a model",{"_3144":39,"_27488":36,"_5":27828,"_19100":44847,"_26023":44848,"_2643":44849},[],"/docs/pr-preview/pr-26/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3144":40,"_27488":36,"_5":27828,"_19100":44851,"_26023":44852,"_2643":44853},[],"/docs/pr-preview/pr-26/deployment/overview#after-deployment","After deployment",{"_3144":41,"_27488":36,"_19100":44855,"_5":13150,"_26023":36,"_2643":44856},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3144":42,"_27488":36,"_19100":44858,"_5":13150,"_26023":44844,"_2643":44859},[],"Model",{"_3144":43,"_27488":36,"_19100":44861,"_5":13150,"_26023":44844,"_2643":44862},[],"Recommended for",{"_3144":44,"_27488":36,"_19100":44864,"_5":13150,"_26023":44844,"_2643":44865},[],"Who operates the infrastructure",{"_3144":45,"_27488":36,"_19100":44867,"_5":13150,"_26023":44844,"_2643":44868},[],"Starting point",{"_3144":46,"_27488":36,"_19100":44870,"_5":13150,"_26023":44844,"_2643":44871},[],"Kubernetes self-managed",{"_3144":47,"_27488":36,"_19100":44873,"_5":13150,"_26023":44844,"_2643":44874},[],"Production, regulated environments and custom deployments",{"_3144":48,"_27488":36,"_19100":44876,"_5":13150,"_26023":44844,"_2643":44877},[],"Your team",{"_3144":49,"_27488":36,"_19100":44879,"_5":13150,"_26023":44844,"_2643":44880},[],"Helm or Fastlane",{"_3144":50,"_27488":36,"_19100":44882,"_5":13150,"_26023":44844,"_2643":44883},[],"AWS Marketplace",{"_3144":51,"_27488":36,"_19100":44885,"_5":13150,"_26023":44844,"_2643":44886},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3144":52,"_27488":36,"_19100":44888,"_5":13150,"_26023":44844,"_2643":44877},[],{"_3144":53,"_27488":36,"_19100":44890,"_5":13150,"_26023":44844,"_2643":44891},[],"Preconfigured image on EC2",{"_3144":54,"_27488":36,"_19100":44893,"_5":13150,"_26023":44844,"_2643":44894},[],"SaaS",{"_3144":55,"_27488":36,"_19100":44896,"_5":13150,"_26023":44844,"_2643":44897},[],"Teams that want to use the platform without operating it",{"_3144":56,"_27488":36,"_19100":44899,"_5":13150,"_26023":44844,"_2643":44900},[],"Lamassu",{"_3144":57,"_27488":36,"_19100":44902,"_5":13150,"_26023":44844,"_2643":44903},[],"Managed subscription",{"_3144":58,"_27488":36,"_19100":44905,"_5":13150,"_26023":44844,"_2643":44906},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3144":59,"_27488":36,"_19100":44908,"_5":13150,"_26023":44844,"_2643":44909},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3144":60,"_27488":36,"_19100":44911,"_5":13150,"_26023":44844,"_2643":44912},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3144":61,"_27488":36,"_19100":44914,"_5":13150,"_26023":44848,"_2643":44915},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3144":62,"_27488":36,"_19100":44917,"_5":13150,"_26023":44852,"_2643":44918},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3144":63,"_27488":63,"_5":13476,"_2643":44920,"_27831":44921,"_19100":44922,"_26023":63},"Use Lamassu as SaaS",[44764,44765,44766],[],{"_3144":64,"_27488":63,"_19100":44924,"_5":13150,"_26023":63,"_2643":44925},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3144":65,"_27488":63,"_5":27828,"_19100":44927,"_26023":44928,"_2643":44929},[],"/docs/pr-preview/pr-26/deployment/saas#what-the-service-manages","What the service manages",{"_3144":66,"_27488":63,"_5":27828,"_19100":44931,"_26023":44932,"_2643":44933},[],"/docs/pr-preview/pr-26/deployment/saas#plans","Plans",{"_3144":67,"_27488":63,"_5":27828,"_19100":44935,"_26023":44936,"_2643":44937},[],"/docs/pr-preview/pr-26/deployment/saas#request-access","Request access",{"_3144":68,"_27488":63,"_19100":44939,"_5":13150,"_26023":63,"_2643":44940},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3144":69,"_27488":63,"_19100":44942,"_5":13150,"_26023":44928,"_2643":44943},[],"Platform availability and maintenance.",{"_3144":70,"_27488":63,"_19100":44945,"_5":13150,"_26023":44928,"_2643":44946},[],"Automatic backups.",{"_3144":71,"_27488":63,"_19100":44948,"_5":13150,"_26023":44928,"_2643":44949},[],"Version upgrades.",{"_3144":72,"_27488":63,"_19100":44951,"_5":13150,"_26023":44928,"_2643":44952},[],"Technical support and SLA according to your plan.",{"_3144":73,"_27488":63,"_19100":44954,"_5":13150,"_26023":44932,"_2643":44955},[],"Plan",{"_3144":74,"_27488":63,"_19100":44957,"_5":13150,"_26023":44932,"_2643":44958},[],"Devices",{"_3144":75,"_27488":63,"_19100":44960,"_5":13150,"_26023":44932,"_2643":44961},[],"Support",{"_3144":76,"_27488":63,"_19100":44963,"_5":13150,"_26023":44932,"_2643":44964},[],"SLA",{"_3144":77,"_27488":63,"_19100":44966,"_5":13150,"_26023":44932,"_2643":44967},[],"Starter",{"_3144":78,"_27488":63,"_19100":44969,"_5":13150,"_26023":44932,"_2643":44970},[],"Up to 1,000",{"_3144":79,"_27488":63,"_19100":44972,"_5":13150,"_26023":44932,"_2643":44973},[],"Email",{"_3144":80,"_27488":63,"_19100":44975,"_5":13150,"_26023":44932,"_2643":44976},[],"99.5 %",{"_3144":81,"_27488":63,"_19100":44978,"_5":13150,"_26023":44932,"_2643":44979},[],"Professional",{"_3144":82,"_27488":63,"_19100":44981,"_5":13150,"_26023":44932,"_2643":44982},[],"Up to 10,000",{"_3144":83,"_27488":63,"_19100":44984,"_5":13150,"_26023":44932,"_2643":44985},[],"Email and chat",{"_3144":84,"_27488":63,"_19100":44987,"_5":13150,"_26023":44932,"_2643":44988},[],"99.9 %",{"_3144":85,"_27488":63,"_19100":44990,"_5":13150,"_26023":44932,"_2643":44991},[],"Enterprise",{"_3144":86,"_27488":63,"_19100":44993,"_5":13150,"_26023":44932,"_2643":44994},[],"Unlimited",{"_3144":87,"_27488":63,"_19100":44996,"_5":13150,"_26023":44932,"_2643":44997},[],"Dedicated",{"_3144":88,"_27488":63,"_19100":44999,"_5":13150,"_26023":44932,"_2643":45000},[],"99.99 %",{"_3144":89,"_27488":63,"_19100":45002,"_5":13150,"_26023":44936,"_2643":45003},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3144":90,"_27488":63,"_19100":45005,"_5":13150,"_26023":44936,"_2643":45006},[],"When you receive your instance's credentials, continue with Get started.",{"_3144":91,"_27488":91,"_5":13476,"_2643":45008,"_27831":45009,"_19100":45010,"_26023":91},"Fastlane",[44764,44765,44871],[],{"_3144":92,"_27488":91,"_19100":45012,"_5":13150,"_26023":91,"_2643":45013},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3144":93,"_27488":91,"_5":27828,"_19100":45015,"_26023":45016,"_2643":45017},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3144":94,"_27488":91,"_5":27828,"_19100":45019,"_26023":45020,"_2643":45021},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3144":95,"_27488":91,"_5":27828,"_19100":45023,"_26023":45024,"_2643":44774},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#before-you-begin",{"_3144":96,"_27488":91,"_5":27828,"_19100":45026,"_26023":45027,"_2643":45028},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3144":97,"_27488":91,"_5":27828,"_19100":45030,"_26023":45031,"_2643":45032},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3144":98,"_27488":91,"_5":27828,"_19100":45034,"_26023":45035,"_2643":45036},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3144":99,"_27488":91,"_5":27828,"_19100":45038,"_26023":45039,"_2643":45040},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3144":100,"_27488":91,"_5":27828,"_19100":45042,"_26023":45043,"_2643":45044},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3144":101,"_27488":91,"_5":27828,"_19100":45046,"_26023":45047,"_2643":45048},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3144":102,"_27488":91,"_5":27828,"_19100":45050,"_26023":45051,"_2643":45052},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3144":103,"_27488":91,"_5":27828,"_19100":45054,"_26023":45055,"_2643":45056},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3144":104,"_27488":91,"_19100":45058,"_5":13150,"_26023":45016,"_2643":45059},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3144":105,"_27488":91,"_19100":45061,"_5":13150,"_26023":45016,"_2643":45062},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3144":106,"_27488":91,"_19100":45064,"_5":13150,"_26023":45020,"_2643":45065},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3144":107,"_27488":91,"_19100":45067,"_5":13150,"_26023":45020,"_2643":45068},[],"Fastlane installs or configures",{"_3144":108,"_27488":91,"_19100":45070,"_5":13150,"_26023":45020,"_2643":45071},[],"You still provide",{"_3144":109,"_27488":91,"_19100":45073,"_5":13150,"_26023":45020,"_2643":45074},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3144":110,"_27488":91,"_19100":45076,"_5":13150,"_26023":45020,"_2643":45077},[],"The Kubernetes cluster, nodes and persistent storage",{"_3144":111,"_27488":91,"_19100":45079,"_5":13150,"_26023":45020,"_2643":45080},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3144":112,"_27488":91,"_19100":45082,"_5":13150,"_26023":45020,"_2643":45083},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3144":113,"_27488":91,"_19100":45085,"_5":13150,"_26023":45020,"_2643":45086},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3144":114,"_27488":91,"_19100":45088,"_5":13150,"_26023":45020,"_2643":45089},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3144":115,"_27488":91,"_19100":45091,"_5":13150,"_26023":45020,"_2643":45092},[],"Optional observability and lab HSM components",{"_3144":116,"_27488":91,"_19100":45094,"_5":13150,"_26023":45020,"_2643":45095},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3144":117,"_27488":91,"_19100":45097,"_5":13150,"_26023":45020,"_2643":45098},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3144":118,"_27488":91,"_19100":45100,"_5":13150,"_26023":45024,"_2643":45101},[],"You need:",{"_3144":119,"_27488":91,"_19100":45103,"_5":13150,"_26023":45024,"_2643":45104},[],"an existing Kubernetes cluster",{"_3144":120,"_27488":91,"_19100":45106,"_5":13150,"_26023":45024,"_2643":45107},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3144":121,"_27488":91,"_19100":45109,"_5":13150,"_26023":45024,"_2643":45110},[],"`yq`",{"_3144":122,"_27488":91,"_19100":45112,"_5":13150,"_26023":45024,"_2643":21626},[],{"_3144":123,"_27488":91,"_19100":45114,"_5":13150,"_26023":45024,"_2643":45115},[],"`jq` only when using `--sample-data` or `--development`",{"_3144":124,"_27488":91,"_19100":45117,"_5":13150,"_26023":45024,"_2643":45118},[],"`ssh-keygen` only when using `--with-hsm`",{"_3144":125,"_27488":91,"_19100":45120,"_5":13150,"_26023":45024,"_2643":45121},[],"free external ports 80 and 443 on a single-node K3s host",{"_3144":126,"_27488":91,"_19100":45123,"_5":13150,"_26023":45024,"_2643":45124},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3144":127,"_27488":91,"_19100":45126,"_5":13150,"_26023":45024,"_2643":45127},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3144":128,"_27488":91,"_19100":45129,"_5":13150,"_26023":45027,"_2643":45130},[],"Run the script from a clone of the Helm repository:",{"_3144":129,"_27488":91,"_19100":45132,"_5":13150,"_26023":45027,"_2643":45133},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3144":130,"_27488":91,"_19100":45135,"_5":13150,"_26023":45031,"_2643":45136},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3144":131,"_27488":91,"_19100":45138,"_5":13150,"_26023":45031,"_2643":45139},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3144":132,"_27488":91,"_19100":45141,"_5":13150,"_26023":45031,"_2643":45142},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3144":133,"_27488":91,"_19100":45144,"_5":13150,"_26023":45031,"_2643":45145},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3144":134,"_27488":91,"_19100":45147,"_5":13150,"_26023":45035,"_2643":45148},[],"Option",{"_3144":135,"_27488":91,"_19100":45150,"_5":13150,"_26023":45035,"_2643":45151},[],"Default",{"_3144":136,"_27488":91,"_19100":45153,"_5":13150,"_26023":45035,"_2643":45154},[],"Purpose",{"_3144":137,"_27488":91,"_19100":45156,"_5":13150,"_26023":45035,"_2643":45157},[],"`-h`, `--help`",{"_3144":138,"_27488":91,"_19100":45159,"_5":13150,"_26023":45035,"_2643":45160},[],"—",{"_3144":139,"_27488":91,"_19100":45162,"_5":13150,"_26023":45035,"_2643":45163},[],"Show help",{"_3144":140,"_27488":91,"_19100":45165,"_5":13150,"_26023":45035,"_2643":45166},[],"`-c`, `--context`",{"_3144":141,"_27488":91,"_19100":45168,"_5":13150,"_26023":45035,"_2643":45169},[],"current context",{"_3144":142,"_27488":91,"_19100":45171,"_5":13150,"_26023":45035,"_2643":45172},[],"Select the kubeconfig context for kubectl and Helm",{"_3144":143,"_27488":91,"_19100":45174,"_5":13150,"_26023":45035,"_2643":45175},[],"`-n`, `--non-interactive`",{"_3144":144,"_27488":91,"_19100":45177,"_5":13150,"_26023":45035,"_2643":5889},[],{"_3144":145,"_27488":91,"_19100":45179,"_5":13150,"_26023":45035,"_2643":45180},[],"Skip prompts and generate dependency credentials",{"_3144":146,"_27488":91,"_19100":45182,"_5":13150,"_26023":45035,"_2643":45183},[],"`-ns`, `--namespace`",{"_3144":147,"_27488":91,"_19100":45185,"_5":13150,"_26023":45035,"_2643":45186},[],"`lamassu-dev`",{"_3144":148,"_27488":91,"_19100":45188,"_5":13150,"_26023":45035,"_2643":45189},[],"Namespace for the installation",{"_3144":149,"_27488":91,"_19100":45191,"_5":13150,"_26023":45035,"_2643":45192},[],"`-d`, `--domain`",{"_3144":150,"_27488":91,"_19100":45194,"_5":13150,"_26023":45035,"_2643":45195},[],"`dev.lamassu.io`",{"_3144":151,"_27488":91,"_19100":45197,"_5":13150,"_26023":45035,"_2643":45198},[],"Domain used by the UI, OIDC and certificate",{"_3144":152,"_27488":91,"_19100":45200,"_5":13150,"_26023":45035,"_2643":45201},[],"`-v`, `--version`",{"_3144":153,"_27488":91,"_19100":45203,"_5":13150,"_26023":45035,"_2643":13735},[],{"_3144":154,"_27488":91,"_19100":45205,"_5":13150,"_26023":45035,"_2643":45206},[],"Lamassu chart version",{"_3144":155,"_27488":91,"_19100":45208,"_5":13150,"_26023":45035,"_2643":45209},[],"`--https-port`",{"_3144":156,"_27488":91,"_19100":45211,"_5":13150,"_26023":45035,"_2643":45212},[],"`443`",{"_3144":157,"_27488":91,"_19100":45214,"_5":13150,"_26023":45035,"_2643":45215},[],"Gateway HTTPS listener port",{"_3144":158,"_27488":91,"_19100":45217,"_5":13150,"_26023":45035,"_2643":45218},[],"`--http-port`",{"_3144":159,"_27488":91,"_19100":45220,"_5":13150,"_26023":45035,"_2643":45221},[],"`80`",{"_3144":160,"_27488":91,"_19100":45223,"_5":13150,"_26023":45035,"_2643":45224},[],"Gateway HTTP listener port",{"_3144":161,"_27488":91,"_19100":45226,"_5":13150,"_26023":45035,"_2643":45227},[],"`--tls-crt`",{"_3144":162,"_27488":91,"_19100":45229,"_5":13150,"_26023":45035,"_2643":45160},[],{"_3144":163,"_27488":91,"_19100":45231,"_5":13150,"_26023":45035,"_2643":45232},[],"PEM certificate for downstream TLS",{"_3144":164,"_27488":91,"_19100":45234,"_5":13150,"_26023":45035,"_2643":45235},[],"`--tls-key`",{"_3144":165,"_27488":91,"_19100":45237,"_5":13150,"_26023":45035,"_2643":45160},[],{"_3144":166,"_27488":91,"_19100":45239,"_5":13150,"_26023":45035,"_2643":45240},[],"PEM private key for downstream TLS",{"_3144":167,"_27488":91,"_19100":45242,"_5":13150,"_26023":45035,"_2643":45243},[],"`-l`, `--local-chart-path`",{"_3144":168,"_27488":91,"_19100":45245,"_5":13150,"_26023":45035,"_2643":45246},[],"repository chart",{"_3144":169,"_27488":91,"_19100":45248,"_5":13150,"_26023":45035,"_2643":45249},[],"Use an unpacked local Lamassu chart",{"_3144":170,"_27488":91,"_19100":45251,"_5":13150,"_26023":45035,"_2643":45252},[],"`-ip`, `--gateway-ip`",{"_3144":171,"_27488":91,"_19100":45254,"_5":13150,"_26023":45035,"_2643":7941},[],{"_3144":172,"_27488":91,"_19100":45256,"_5":13150,"_26023":45035,"_2643":45257},[],"Override the address written to `gateway.addresses`",{"_3144":173,"_27488":91,"_19100":45259,"_5":13150,"_26023":45035,"_2643":45260},[],"`--otel`",{"_3144":174,"_27488":91,"_19100":45262,"_5":13150,"_26023":45035,"_2643":5889},[],{"_3144":175,"_27488":91,"_19100":45264,"_5":13150,"_26023":45035,"_2643":45265},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3144":176,"_27488":91,"_19100":45267,"_5":13150,"_26023":45035,"_2643":45268},[],"`--development`",{"_3144":177,"_27488":91,"_19100":45270,"_5":13150,"_26023":45035,"_2643":5889},[],{"_3144":178,"_27488":91,"_19100":45272,"_5":13150,"_26023":45035,"_2643":45273},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3144":179,"_27488":91,"_19100":45275,"_5":13150,"_26023":45035,"_2643":45276},[],"`--sample-data`",{"_3144":180,"_27488":91,"_19100":45278,"_5":13150,"_26023":45035,"_2643":5889},[],{"_3144":181,"_27488":91,"_19100":45280,"_5":13150,"_26023":45035,"_2643":45281},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3144":182,"_27488":91,"_19100":45283,"_5":13150,"_26023":45035,"_2643":45284},[],"`--with-hsm`",{"_3144":183,"_27488":91,"_19100":45286,"_5":13150,"_26023":45035,"_2643":5889},[],{"_3144":184,"_27488":91,"_19100":45288,"_5":13150,"_26023":45035,"_2643":45289},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3144":185,"_27488":91,"_19100":45291,"_5":13150,"_26023":45035,"_2643":45292},[],"`--softhsm-chart-path`",{"_3144":186,"_27488":91,"_19100":45294,"_5":13150,"_26023":45035,"_2643":45295},[],"`./charts/softhsm`",{"_3144":187,"_27488":91,"_19100":45297,"_5":13150,"_26023":45035,"_2643":45298},[],"Use a different local SoftHSM chart",{"_3144":188,"_27488":91,"_19100":45300,"_5":13150,"_26023":45035,"_2643":45301},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3144":189,"_27488":91,"_19100":45303,"_5":13150,"_26023":45039,"_2643":45304},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3144":190,"_27488":91,"_19100":45306,"_5":13150,"_26023":45039,"_2643":45307},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3144":191,"_27488":91,"_19100":45309,"_5":13150,"_26023":45039,"_2643":45310},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3144":192,"_27488":91,"_19100":45312,"_5":13150,"_26023":45039,"_2643":45313},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3144":193,"_27488":91,"_19100":45315,"_5":13150,"_26023":45039,"_2643":45316},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3144":194,"_27488":91,"_19100":45318,"_5":13150,"_26023":45039,"_2643":45319},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3144":195,"_27488":91,"_19100":45321,"_5":13150,"_26023":45043,"_2643":45322},[],"Fastlane:",{"_3144":196,"_27488":91,"_19100":45324,"_5":13150,"_26023":45043,"_2643":45325},[],"validates local tools and the selected cluster",{"_3144":197,"_27488":91,"_19100":45327,"_5":13150,"_26023":45043,"_2643":45328},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3144":198,"_27488":91,"_19100":45330,"_5":13150,"_26023":45043,"_2643":45331},[],"creates the namespace",{"_3144":199,"_27488":91,"_19100":45333,"_5":13150,"_26023":45043,"_2643":45334},[],"installs PostgreSQL and creates the required databases",{"_3144":200,"_27488":91,"_19100":45336,"_5":13150,"_26023":45043,"_2643":45337},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3144":201,"_27488":91,"_19100":45339,"_5":13150,"_26023":45043,"_2643":45340},[],"installs RabbitMQ",{"_3144":202,"_27488":91,"_19100":45342,"_5":13150,"_26023":45043,"_2643":45343},[],"optionally installs observability and lab HSM components",{"_3144":203,"_27488":91,"_19100":45345,"_5":13150,"_26023":45043,"_2643":45346},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3144":204,"_27488":91,"_19100":45348,"_5":13150,"_26023":45043,"_2643":45349},[],"optionally loads sample data",{"_3144":205,"_27488":91,"_19100":45351,"_5":13150,"_26023":45043,"_2643":45352},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3144":206,"_27488":91,"_19100":45354,"_5":13150,"_26023":45047,"_2643":45355},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3144":207,"_27488":91,"_19100":45357,"_5":13150,"_26023":45047,"_2643":45358},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3144":208,"_27488":91,"_19100":45360,"_5":13150,"_26023":45051,"_2643":45361},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3144":209,"_27488":91,"_19100":45363,"_5":13150,"_26023":45051,"_2643":45364},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3144":210,"_27488":91,"_19100":45366,"_5":13150,"_26023":45051,"_2643":45367},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3144":211,"_27488":91,"_19100":45369,"_5":13150,"_26023":45055,"_2643":45370},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3144":212,"_27488":212,"_5":13476,"_2643":45372,"_27831":45373,"_19100":45374,"_26023":212},"Install with Helm",[44764,44765,44871],[],{"_3144":213,"_27488":212,"_19100":45376,"_5":13150,"_26023":212,"_2643":45377},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3144":214,"_27488":212,"_5":27828,"_19100":45379,"_26023":45380,"_2643":45381},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3144":215,"_27488":212,"_5":27828,"_19100":45383,"_26023":45384,"_2643":44774},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#before-you-begin",{"_3144":216,"_27488":212,"_5":27828,"_19100":45386,"_26023":45387,"_2643":45388},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3144":217,"_27488":212,"_5":27828,"_19100":45390,"_26023":45391,"_2643":45392},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3144":218,"_27488":212,"_5":27828,"_19100":45394,"_26023":45395,"_2643":45396},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3144":219,"_27488":212,"_5":27828,"_19100":45398,"_26023":45399,"_2643":45400},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3144":220,"_27488":212,"_5":27828,"_19100":45402,"_26023":45403,"_2643":45404},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3144":221,"_27488":212,"_5":27828,"_19100":45406,"_26023":45407,"_2643":45408},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3144":222,"_27488":212,"_5":27828,"_19100":45410,"_26023":45411,"_2643":45412},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3144":223,"_27488":212,"_19100":45414,"_5":13150,"_26023":45380,"_2643":45415},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3144":224,"_27488":212,"_19100":45417,"_5":13150,"_26023":45384,"_2643":45418},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3144":225,"_27488":212,"_19100":45420,"_5":13150,"_26023":45384,"_2643":45421},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3144":226,"_27488":212,"_19100":45423,"_5":13150,"_26023":45384,"_2643":45424},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3144":227,"_27488":212,"_19100":45426,"_5":13150,"_26023":45384,"_2643":45427},[],"a reachable RabbitMQ broker and credentials",{"_3144":228,"_27488":212,"_19100":45429,"_5":13150,"_26023":45384,"_2643":45430},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3144":229,"_27488":212,"_19100":45432,"_5":13150,"_26023":45384,"_2643":45433},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3144":230,"_27488":212,"_19100":45435,"_5":13150,"_26023":45384,"_2643":45436},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3144":231,"_27488":212,"_19100":45438,"_5":13150,"_26023":45384,"_2643":45439},[],"a StorageClass and an external traffic design",{"_3144":232,"_27488":212,"_19100":45441,"_5":13150,"_26023":45384,"_2643":45442},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3144":233,"_27488":212,"_19100":45444,"_5":13150,"_26023":45384,"_2643":45445},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3144":234,"_27488":212,"_19100":45447,"_5":13150,"_26023":45384,"_2643":45448},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3144":235,"_27488":212,"_19100":45450,"_5":13150,"_26023":45387,"_2643":45451},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3144":236,"_27488":212,"_19100":45453,"_5":13150,"_26023":45387,"_2643":45454},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3144":237,"_27488":212,"_19100":45456,"_5":13150,"_26023":45387,"_2643":45457},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_3144":238,"_27488":212,"_19100":45459,"_5":13150,"_26023":45391,"_2643":45460},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3144":239,"_27488":212,"_19100":45462,"_5":13150,"_26023":45391,"_2643":45463},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3144":240,"_27488":212,"_19100":45465,"_5":13150,"_26023":45391,"_2643":45466},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3144":241,"_27488":212,"_19100":45468,"_5":13150,"_26023":45395,"_2643":45469},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_3144":242,"_27488":212,"_19100":45471,"_5":13150,"_26023":45399,"_2643":45472},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3144":243,"_27488":212,"_19100":45474,"_5":13150,"_26023":45399,"_2643":45475},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3144":244,"_27488":212,"_19100":45477,"_5":13150,"_26023":45399,"_2643":45478},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3144":245,"_27488":212,"_19100":45480,"_5":13150,"_26023":45399,"_2643":45481},[],"See Access control for the principal and policy model.",{"_3144":246,"_27488":212,"_19100":45483,"_5":13150,"_26023":45403,"_2643":45484},[],"To install a local checkout instead:",{"_3144":247,"_27488":212,"_19100":45486,"_5":13150,"_26023":45407,"_2643":45487},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3144":248,"_27488":212,"_19100":45489,"_5":13150,"_26023":45407,"_2643":45490},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3144":249,"_27488":212,"_19100":45492,"_5":13150,"_26023":45411,"_2643":45493},[],"Before going live, review:",{"_3144":250,"_27488":212,"_19100":45495,"_5":13150,"_26023":45411,"_2643":45496},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3144":251,"_27488":212,"_19100":45498,"_5":13150,"_26023":45411,"_2643":45499},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3144":252,"_27488":212,"_19100":45501,"_5":13150,"_26023":45411,"_2643":45502},[],"shared VA storage before increasing VA replicas",{"_3144":253,"_27488":212,"_19100":45504,"_5":13150,"_26023":45411,"_2643":45505},[],"managed OIDC roles and removal of evaluation credentials",{"_3144":254,"_27488":212,"_19100":45507,"_5":13150,"_26023":45411,"_2643":45508},[],"a trusted TLS issuer or externally managed certificate",{"_3144":255,"_27488":212,"_19100":45510,"_5":13150,"_26023":45411,"_2643":45511},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3144":256,"_27488":212,"_19100":45513,"_5":13150,"_26023":45411,"_2643":45514},[],"SMTP, observability and alert delivery",{"_3144":257,"_27488":212,"_19100":45516,"_5":13150,"_26023":45411,"_2643":45517},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3144":258,"_27488":212,"_19100":45519,"_5":13150,"_26023":45411,"_2643":45520},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3144":259,"_27488":259,"_5":13476,"_2643":45522,"_27831":45523,"_19100":45524,"_26023":259},"Expose the Gateway",[44764,44765,44871],[],{"_3144":260,"_27488":259,"_19100":45526,"_5":13150,"_26023":259,"_2643":45527},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3144":261,"_27488":259,"_5":27828,"_19100":45529,"_26023":45530,"_2643":45531},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3144":262,"_27488":259,"_5":27828,"_19100":45533,"_26023":45534,"_2643":45535},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3144":263,"_27488":259,"_5":27828,"_19100":45537,"_26023":45538,"_2643":45539},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3144":264,"_27488":259,"_5":27828,"_19100":45541,"_26023":45542,"_2643":45543},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#k3s","K3s",{"_3144":265,"_27488":259,"_5":27828,"_19100":45545,"_26023":45546,"_2643":45547},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3144":266,"_27488":259,"_5":27828,"_19100":45549,"_26023":45550,"_2643":45551},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3144":267,"_27488":259,"_5":27828,"_19100":45553,"_26023":45554,"_2643":45555},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3144":268,"_27488":259,"_5":27828,"_19100":45557,"_26023":45558,"_2643":45559},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3144":269,"_27488":259,"_5":27828,"_19100":45561,"_26023":45562,"_2643":45563},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3144":270,"_27488":259,"_19100":45565,"_5":13150,"_26023":45530,"_2643":45566},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3144":271,"_27488":259,"_19100":45568,"_5":13150,"_26023":45530,"_2643":45569},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3144":272,"_27488":259,"_19100":45571,"_5":13150,"_26023":45534,"_2643":45572},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3144":273,"_27488":259,"_19100":45574,"_5":13150,"_26023":45534,"_2643":45575},[],"Set it only when:",{"_3144":274,"_27488":259,"_19100":45577,"_5":13150,"_26023":45534,"_2643":45578},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3144":275,"_27488":259,"_19100":45580,"_5":13150,"_26023":45534,"_2643":45581},[],"that address is allocated to this Gateway",{"_3144":276,"_27488":259,"_19100":45583,"_5":13150,"_26023":45534,"_2643":45584},[],"the surrounding network already routes traffic for it to the cluster",{"_3144":277,"_27488":259,"_19100":45586,"_5":13150,"_26023":45534,"_2643":45587},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3144":278,"_27488":259,"_19100":45589,"_5":13150,"_26023":45534,"_2643":45590},[],"Keep these two settings separate:",{"_3144":279,"_27488":259,"_19100":45592,"_5":13150,"_26023":45534,"_2643":45593},[],"`gateway.addresses` requests an address for the Gateway.",{"_3144":280,"_27488":259,"_19100":45595,"_5":13150,"_26023":45534,"_2643":45596},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3144":281,"_27488":259,"_19100":45598,"_5":13150,"_26023":45534,"_2643":45599},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3144":282,"_27488":259,"_19100":45601,"_5":13150,"_26023":45538,"_2643":45602},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3144":283,"_27488":259,"_19100":45604,"_5":13150,"_26023":45538,"_2643":45605},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3144":284,"_27488":259,"_19100":45607,"_5":13150,"_26023":45542,"_2643":45608},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3144":285,"_27488":259,"_19100":45610,"_5":13150,"_26023":45542,"_2643":45611},[],"For the recommended design:",{"_3144":286,"_27488":259,"_19100":45613,"_5":13150,"_26023":45542,"_2643":45614},[],"Use only one externally exposed Lamassu Gateway.",{"_3144":287,"_27488":259,"_19100":45616,"_5":13150,"_26023":45542,"_2643":45617},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3144":288,"_27488":259,"_19100":45619,"_5":13150,"_26023":45542,"_2643":45620},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3144":289,"_27488":259,"_19100":45622,"_5":13150,"_26023":45542,"_2643":45623},[],"Point DNS at the VM's reachable address.",{"_3144":290,"_27488":259,"_19100":45625,"_5":13150,"_26023":45542,"_2643":45626},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3144":291,"_27488":259,"_19100":45628,"_5":13150,"_26023":45546,"_2643":45629},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3144":292,"_27488":259,"_19100":45631,"_5":13150,"_26023":45550,"_2643":45632},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3144":293,"_27488":259,"_19100":45634,"_5":13150,"_26023":45550,"_2643":45635},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3144":294,"_27488":259,"_19100":45637,"_5":13150,"_26023":45554,"_2643":45638},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3144":295,"_27488":259,"_19100":45640,"_5":13150,"_26023":45554,"_2643":45641},[],"Requirement",{"_3144":296,"_27488":259,"_19100":45643,"_5":13150,"_26023":45554,"_2643":45644},[],"Recommended design",{"_3144":297,"_27488":259,"_19100":45646,"_5":13150,"_26023":45554,"_2643":45647},[],"Consequence",{"_3144":298,"_27488":259,"_19100":45649,"_5":13150,"_26023":45554,"_2643":45650},[],"Several Lamassu URLs or services",{"_3144":299,"_27488":259,"_19100":45652,"_5":13150,"_26023":45554,"_2643":45653},[],"One Gateway with multiple routes",{"_3144":300,"_27488":259,"_19100":45655,"_5":13150,"_26023":45554,"_2643":45656},[],"One IP and one proxy fleet; this is the chart default",{"_3144":301,"_27488":259,"_19100":45658,"_5":13150,"_26023":45554,"_2643":45659},[],"Independent Gateways and separate external IPs",{"_3144":302,"_27488":259,"_19100":45661,"_5":13150,"_26023":45554,"_2643":45662},[],"One VIP per Gateway",{"_3144":303,"_27488":259,"_19100":45664,"_5":13150,"_26023":45554,"_2643":45665},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3144":304,"_27488":259,"_19100":45667,"_5":13150,"_26023":45554,"_2643":45668},[],"Independent Gateways on one node and one IP",{"_3144":305,"_27488":259,"_19100":45670,"_5":13150,"_26023":45554,"_2643":45671},[],"Use different external ports",{"_3144":306,"_27488":259,"_19100":45673,"_5":13150,"_26023":45554,"_2643":45674},[],"Clients must include non-standard ports",{"_3144":307,"_27488":259,"_19100":45676,"_5":13150,"_26023":45554,"_2643":45677},[],"Separate TLS/mTLS termination behind one IP",{"_3144":308,"_27488":259,"_19100":45679,"_5":13150,"_26023":45554,"_2643":45680},[],"Front-door SNI routing to internal Gateways",{"_3144":309,"_27488":259,"_19100":45682,"_5":13150,"_26023":45554,"_2643":45683},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3144":310,"_27488":259,"_19100":45685,"_5":13150,"_26023":45554,"_2643":45686},[],"Separate Gateway resources but shared proxy infrastructure",{"_3144":311,"_27488":259,"_19100":45688,"_5":13150,"_26023":45554,"_2643":45689},[],"Envoy merged-Gateway mode",{"_3144":312,"_27488":259,"_19100":45691,"_5":13150,"_26023":45554,"_2643":45692},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3144":313,"_27488":259,"_19100":45694,"_5":13150,"_26023":45554,"_2643":45695},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3144":314,"_27488":259,"_19100":45697,"_5":13150,"_26023":45554,"_2643":45698},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3144":315,"_27488":259,"_19100":45700,"_5":13150,"_26023":45554,"_2643":45701},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3144":316,"_27488":259,"_19100":45703,"_5":13150,"_26023":45554,"_2643":45704},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3144":317,"_27488":259,"_19100":45706,"_5":13150,"_26023":45558,"_2643":45707},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3144":318,"_27488":259,"_19100":45709,"_5":13150,"_26023":45558,"_2643":45710},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3144":319,"_27488":259,"_19100":45712,"_5":13150,"_26023":45558,"_2643":45713},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3144":320,"_27488":259,"_19100":45715,"_5":13150,"_26023":45558,"_2643":45716},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3144":321,"_27488":259,"_19100":45718,"_5":13150,"_26023":45558,"_2643":45719},[],"If none of those are possible, use different external ports or change the external network design.",{"_3144":322,"_27488":259,"_19100":45721,"_5":13150,"_26023":45562,"_2643":45722},[],"Check, in order:",{"_3144":323,"_27488":259,"_19100":45724,"_5":13150,"_26023":45562,"_2643":45725},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3144":324,"_27488":259,"_19100":45727,"_5":13150,"_26023":45562,"_2643":45728},[],"Its status contains the expected address.",{"_3144":325,"_27488":259,"_19100":45730,"_5":13150,"_26023":45562,"_2643":45731},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3144":326,"_27488":259,"_19100":45733,"_5":13150,"_26023":45562,"_2643":45734},[],"Port 443 reaches that address from the client network.",{"_3144":327,"_27488":259,"_19100":45736,"_5":13150,"_26023":45562,"_2643":45737},[],"DNS resolves to the externally reachable endpoint.",{"_3144":328,"_27488":259,"_19100":45739,"_5":13150,"_26023":45562,"_2643":45740},[],"The certificate contains the DNS name or IP used by the client.",{"_3144":329,"_27488":259,"_19100":45742,"_5":13150,"_26023":45562,"_2643":45743},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3144":330,"_27488":330,"_5":13476,"_2643":44871,"_27831":45745,"_19100":45746,"_26023":330},[44764,44765,44871],[],{"_3144":331,"_27488":330,"_19100":45748,"_5":13150,"_26023":330,"_2643":45749},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3144":332,"_27488":330,"_5":27828,"_19100":45751,"_26023":45752,"_2643":45753},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3144":333,"_27488":330,"_5":27828,"_19100":45755,"_26023":45756,"_2643":45757},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3144":334,"_27488":330,"_5":27828,"_19100":45759,"_26023":45760,"_2643":45761},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3144":335,"_27488":330,"_5":27828,"_19100":45763,"_26023":45764,"_2643":45765},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3144":336,"_27488":330,"_5":27828,"_19100":45767,"_26023":45768,"_2643":45769},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3144":337,"_27488":330,"_5":27828,"_19100":45771,"_26023":45772,"_2643":45773},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3144":338,"_27488":330,"_19100":45775,"_5":13150,"_26023":45752,"_2643":45776},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3144":339,"_27488":330,"_19100":45778,"_5":13150,"_26023":45756,"_2643":45779},[],"Workflow",{"_3144":340,"_27488":330,"_19100":45781,"_5":13150,"_26023":45756,"_2643":45782},[],"Use it for",{"_3144":341,"_27488":330,"_19100":45784,"_5":13150,"_26023":45756,"_2643":45785},[],"What it installs",{"_3144":342,"_27488":330,"_19100":45787,"_5":13150,"_26023":45756,"_2643":45788},[],"Helm",{"_3144":343,"_27488":330,"_19100":45790,"_5":13150,"_26023":45756,"_2643":45791},[],"Production and controlled environments",{"_3144":344,"_27488":330,"_19100":45793,"_5":13150,"_26023":45756,"_2643":45794},[],"Lamassu services and Gateway API resources",{"_3144":345,"_27488":330,"_19100":45796,"_5":13150,"_26023":45756,"_2643":45008},[],{"_3144":346,"_27488":330,"_19100":45798,"_5":13150,"_26023":45756,"_2643":45799},[],"Evaluation, demos, CI and small lab clusters",{"_3144":347,"_27488":330,"_19100":45801,"_5":13150,"_26023":45756,"_2643":45802},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3144":348,"_27488":330,"_19100":45804,"_5":13150,"_26023":45760,"_2643":45805},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3144":349,"_27488":330,"_19100":45807,"_5":13150,"_26023":45760,"_2643":45808},[],"Area",{"_3144":350,"_27488":330,"_19100":45810,"_5":13150,"_26023":45760,"_2643":45811},[],"The Lamassu chart provides",{"_3144":351,"_27488":330,"_19100":45813,"_5":13150,"_26023":45760,"_2643":45814},[],"You provide",{"_3144":352,"_27488":330,"_19100":45816,"_5":13150,"_26023":45760,"_2643":45817},[],"Lamassu applications",{"_3144":353,"_27488":330,"_19100":45819,"_5":13150,"_26023":45760,"_2643":45820},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3144":354,"_27488":330,"_19100":45822,"_5":13150,"_26023":45760,"_2643":45823},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3144":355,"_27488":330,"_19100":45825,"_5":13150,"_26023":45760,"_2643":45826},[],"PostgreSQL data",{"_3144":356,"_27488":330,"_19100":45828,"_5":13150,"_26023":45760,"_2643":45829},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3144":357,"_27488":330,"_19100":45831,"_5":13150,"_26023":45760,"_2643":45832},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3144":358,"_27488":330,"_19100":45834,"_5":13150,"_26023":45760,"_2643":45835},[],"Messaging",{"_3144":359,"_27488":330,"_19100":45837,"_5":13150,"_26023":45760,"_2643":45838},[],"RabbitMQ connection configuration for the Lamassu services",{"_3144":360,"_27488":330,"_19100":45840,"_5":13150,"_26023":45760,"_2643":45841},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3144":361,"_27488":330,"_19100":45843,"_5":13150,"_26023":45760,"_2643":45844},[],"Identity",{"_3144":362,"_27488":330,"_19100":45846,"_5":13150,"_26023":45760,"_2643":45847},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3144":363,"_27488":330,"_19100":45849,"_5":13150,"_26023":45760,"_2643":45850},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3144":364,"_27488":330,"_19100":45852,"_5":13150,"_26023":45760,"_2643":45853},[],"External routing",{"_3144":365,"_27488":330,"_19100":45855,"_5":13150,"_26023":45760,"_2643":45856},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3144":366,"_27488":330,"_19100":45858,"_5":13150,"_26023":45760,"_2643":45859},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3144":367,"_27488":330,"_19100":45861,"_5":13150,"_26023":45760,"_2643":45862},[],"TLS",{"_3144":368,"_27488":330,"_19100":45864,"_5":13150,"_26023":45760,"_2643":45865},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_3144":369,"_27488":330,"_19100":45867,"_5":13150,"_26023":45760,"_2643":45868},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3144":370,"_27488":330,"_19100":45870,"_5":13150,"_26023":45760,"_2643":45871},[],"Persistent application data",{"_3144":371,"_27488":330,"_19100":45873,"_5":13150,"_26023":45760,"_2643":45874},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3144":372,"_27488":330,"_19100":45876,"_5":13150,"_26023":45760,"_2643":45877},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3144":373,"_27488":330,"_19100":45879,"_5":13150,"_26023":45760,"_2643":45880},[],"Optional integrations",{"_3144":374,"_27488":330,"_19100":45882,"_5":13150,"_26023":45760,"_2643":45883},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3144":375,"_27488":330,"_19100":45885,"_5":13150,"_26023":45760,"_2643":45886},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3144":376,"_27488":330,"_19100":45888,"_5":13150,"_26023":45760,"_2643":45889},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3144":377,"_27488":330,"_19100":45891,"_5":13150,"_26023":45760,"_2643":45892},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3144":378,"_27488":330,"_19100":45894,"_5":13150,"_26023":45764,"_2643":45895},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3144":379,"_27488":330,"_19100":45897,"_5":13150,"_26023":45764,"_2643":45898},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3144":380,"_27488":330,"_19100":45900,"_5":13150,"_26023":45768,"_2643":45901},[],"Kubernetes 1.24 or newer",{"_3144":381,"_27488":330,"_19100":45903,"_5":13150,"_26023":45768,"_2643":45904},[],"Helm 3.2 or newer",{"_3144":382,"_27488":330,"_19100":45906,"_5":13150,"_26023":45768,"_2643":45907},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3144":383,"_27488":330,"_19100":45909,"_5":13150,"_26023":45768,"_2643":45910},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_3144":384,"_27488":330,"_19100":45912,"_5":13150,"_26023":45768,"_2643":45913},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3144":385,"_27488":330,"_19100":45915,"_5":13150,"_26023":45768,"_2643":45916},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3144":386,"_27488":330,"_19100":45918,"_5":13150,"_26023":45768,"_2643":45919},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3144":387,"_27488":330,"_19100":45921,"_5":13150,"_26023":45772,"_2643":45922},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3144":388,"_27488":330,"_19100":45924,"_5":13150,"_26023":45772,"_2643":45925},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3144":389,"_27488":330,"_19100":45927,"_5":13150,"_26023":45772,"_2643":45928},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3144":390,"_27488":330,"_19100":45930,"_5":13150,"_26023":45772,"_2643":45931},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3144":391,"_27488":391,"_5":13476,"_2643":45933,"_27831":45934,"_19100":45936,"_26023":391},"Deployment troubleshooting",[44764,44765,45935],"Operations",[],{"_3144":392,"_27488":391,"_19100":45938,"_5":13150,"_26023":391,"_2643":45939},[],"Diagnose access, service health and infrastructure dependencies.",{"_3144":393,"_27488":391,"_5":27828,"_19100":45941,"_26023":45942,"_2643":45943},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3144":394,"_27488":391,"_5":27828,"_19100":45945,"_26023":45946,"_2643":45947},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3144":395,"_27488":391,"_5":27828,"_19100":45949,"_26023":45950,"_2643":45951},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3144":396,"_27488":391,"_5":27828,"_19100":45953,"_26023":45954,"_2643":45955},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3144":397,"_27488":391,"_5":27828,"_19100":45957,"_26023":45958,"_2643":45959},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3144":398,"_27488":391,"_5":27828,"_19100":45961,"_26023":45962,"_2643":45963},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3144":399,"_27488":391,"_5":27828,"_19100":45965,"_26023":45966,"_2643":45967},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3144":400,"_27488":391,"_5":27828,"_19100":45969,"_26023":45970,"_2643":45971},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3144":401,"_27488":391,"_5":27828,"_19100":45973,"_26023":45974,"_2643":45975},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3144":402,"_27488":391,"_5":27828,"_19100":45977,"_26023":45978,"_2643":45979},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3144":403,"_27488":391,"_5":27828,"_19100":45981,"_26023":45982,"_2643":45983},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3144":404,"_27488":391,"_5":27828,"_19100":45985,"_26023":45986,"_2643":45987},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#observability","Observability",{"_3144":405,"_27488":391,"_19100":45989,"_5":13150,"_26023":391,"_2643":45990},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3144":406,"_27488":391,"_19100":45992,"_5":13150,"_26023":45946,"_2643":45993},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3144":407,"_27488":391,"_19100":45995,"_5":13150,"_26023":45950,"_2643":45996},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3144":408,"_27488":391,"_19100":45998,"_5":13150,"_26023":45954,"_2643":45999},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3144":409,"_27488":391,"_19100":46001,"_5":13150,"_26023":45958,"_2643":46002},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3144":410,"_27488":391,"_19100":46004,"_5":13150,"_26023":45962,"_2643":46005},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3144":411,"_27488":391,"_19100":46007,"_5":13150,"_26023":45966,"_2643":46008},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3144":412,"_27488":391,"_19100":46010,"_5":13150,"_26023":45966,"_2643":46011},[],"Also run the chart's connectivity test:",{"_3144":413,"_27488":391,"_19100":46013,"_5":13150,"_26023":45966,"_2643":46014},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3144":414,"_27488":391,"_19100":46016,"_5":13150,"_26023":45966,"_2643":46017},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3144":415,"_27488":391,"_19100":46019,"_5":13150,"_26023":45970,"_2643":46020},[],"If you receive a 401:",{"_3144":416,"_27488":391,"_19100":46022,"_5":13150,"_26023":45970,"_2643":46023},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3144":417,"_27488":391,"_19100":46025,"_5":13150,"_26023":45970,"_2643":46026},[],"verify issuer, audience and expiration of the token;",{"_3144":418,"_27488":391,"_19100":46028,"_5":13150,"_26023":45970,"_2643":46029},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3144":419,"_27488":391,"_19100":46031,"_5":13150,"_26023":45970,"_2643":46032},[],"check that the provider's public and internal routes point to the same realm.",{"_3144":420,"_27488":391,"_19100":46034,"_5":13150,"_26023":45970,"_2643":46035},[],"If login succeeds but the APIs return 403:",{"_3144":421,"_27488":391,"_19100":46037,"_5":13150,"_26023":45970,"_2643":46038},[],"inspect the token's real claims;",{"_3144":422,"_27488":391,"_19100":46040,"_5":13150,"_26023":45970,"_2643":46041},[],"confirm they match an active principal;",{"_3144":423,"_27488":391,"_19100":46043,"_5":13150,"_26023":45970,"_2643":46044},[],"review the policies granted to that principal;",{"_3144":424,"_27488":391,"_19100":46046,"_5":13150,"_26023":45970,"_2643":46047},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3144":425,"_27488":391,"_19100":46049,"_5":13150,"_26023":45970,"_2643":46050},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3144":426,"_27488":391,"_19100":46052,"_5":13150,"_26023":45974,"_2643":46053},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3144":427,"_27488":391,"_19100":46055,"_5":13150,"_26023":45974,"_2643":46056},[],"Locate the authz pod and Service.",{"_3144":428,"_27488":391,"_19100":46058,"_5":13150,"_26023":45974,"_2643":46059},[],"Check /health, logs and its database connection.",{"_3144":429,"_27488":391,"_19100":46061,"_5":13150,"_26023":45974,"_2643":46062},[],"Verify the DNS and port configured in externalAuthorization.",{"_3144":430,"_27488":391,"_19100":46064,"_5":13150,"_26023":45974,"_2643":46065},[],"Check the check route is /v1/ext\\_authz/check.",{"_3144":431,"_27488":391,"_19100":46067,"_5":13150,"_26023":45974,"_2643":46068},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3144":432,"_27488":391,"_19100":46070,"_5":13150,"_26023":45978,"_2643":46071},[],"Review kubectl describe pod first. Common causes are:",{"_3144":433,"_27488":391,"_19100":46073,"_5":13150,"_26023":45978,"_2643":46074},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3144":434,"_27488":391,"_19100":46076,"_5":13150,"_26023":45978,"_2643":46077},[],"unbound persistent volume;",{"_3144":435,"_27488":391,"_19100":46079,"_5":13150,"_26023":45978,"_2643":46080},[],"inaccessible image or incorrect pull policy;",{"_3144":436,"_27488":391,"_19100":46082,"_5":13150,"_26023":45978,"_2643":46083},[],"invalid cryptographic engine configuration;",{"_3144":437,"_27488":391,"_19100":46085,"_5":13150,"_26023":45978,"_2643":46086},[],"CPU or memory limits set too low;",{"_3144":438,"_27488":391,"_19100":46088,"_5":13150,"_26023":45978,"_2643":46089},[],"an incomplete prior migration.",{"_3144":439,"_27488":391,"_19100":46091,"_5":13150,"_26023":45978,"_2643":46092},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3144":440,"_27488":391,"_19100":46094,"_5":13150,"_26023":45978,"_2643":46095},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3144":441,"_27488":391,"_19100":46097,"_5":13150,"_26023":45982,"_2643":46098},[],"Domain and audit events depend on the bus publisher:",{"_3144":442,"_27488":391,"_19100":46100,"_5":13150,"_26023":45982,"_2643":46101},[],"verify it is enabled in the emitting service;",{"_3144":443,"_27488":391,"_19100":46103,"_5":13150,"_26023":45982,"_2643":46104},[],"check AMQP connectivity and credentials;",{"_3144":444,"_27488":391,"_19100":46106,"_5":13150,"_26023":45982,"_2643":46107},[],"review exchange, routing key, queues and consumers;",{"_3144":445,"_27488":391,"_19100":46109,"_5":13150,"_26023":45982,"_2643":46110},[],"inspect dead-letter queues;",{"_3144":446,"_27488":391,"_19100":46112,"_5":13150,"_26023":45982,"_2643":46113},[],"alert on orphan durable queues and backlog growth.",{"_3144":447,"_27488":391,"_19100":46115,"_5":13150,"_26023":45982,"_2643":46116},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3144":448,"_27488":391,"_19100":46118,"_5":13150,"_26023":45986,"_2643":46119},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3144":449,"_27488":391,"_19100":46121,"_5":13150,"_26023":45986,"_2643":46122},[],"Before closing an incident, record:",{"_3144":450,"_27488":391,"_19100":46124,"_5":13150,"_26023":45986,"_2643":46125},[],"the confirmed cause;",{"_3144":451,"_27488":391,"_19100":46127,"_5":13150,"_26023":45986,"_2643":46128},[],"the time scope and affected resources;",{"_3144":452,"_27488":391,"_19100":46130,"_5":13150,"_26023":45986,"_2643":46131},[],"the commands or queries used;",{"_3144":453,"_27488":391,"_19100":46133,"_5":13150,"_26023":45986,"_2643":46134},[],"the applied change and how to revert it;",{"_3144":454,"_27488":391,"_19100":46136,"_5":13150,"_26023":45986,"_2643":46137},[],"validation from a consumer;",{"_3144":455,"_27488":391,"_19100":46139,"_5":13150,"_26023":45986,"_2643":46140},[],"the preventive action and its owner.",{"_3144":456,"_27488":456,"_5":13476,"_2643":46142,"_27831":46143,"_19100":46146,"_26023":456},"Access control",[44764,46144,46145],"Platform","Administration",[],{"_3144":457,"_27488":456,"_19100":46148,"_5":13150,"_26023":456,"_2643":46149},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3144":458,"_27488":456,"_5":27828,"_19100":46151,"_26023":46152,"_2643":46153},[],"/docs/pr-preview/pr-26/platform/administration/access-control#essential-concepts","Essential concepts",{"_3144":459,"_27488":456,"_5":27828,"_19100":46155,"_26023":46156,"_2643":46157},[],"/docs/pr-preview/pr-26/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3144":460,"_27488":456,"_5":27828,"_19100":46159,"_26023":46160,"_2643":46161},[],"/docs/pr-preview/pr-26/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3144":461,"_27488":456,"_5":27828,"_19100":46163,"_26023":46164,"_2643":46165},[],"/docs/pr-preview/pr-26/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3144":462,"_27488":456,"_5":27828,"_19100":46167,"_26023":46168,"_2643":46169},[],"/docs/pr-preview/pr-26/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3144":463,"_27488":456,"_5":27828,"_19100":46171,"_26023":46172,"_2643":46173},[],"/docs/pr-preview/pr-26/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3144":464,"_27488":456,"_5":27828,"_19100":46175,"_26023":46176,"_2643":46177},[],"/docs/pr-preview/pr-26/platform/administration/access-control#oidc-principals","OIDC principals",{"_3144":465,"_27488":456,"_5":27828,"_19100":46179,"_26023":46180,"_2643":46181},[],"/docs/pr-preview/pr-26/platform/administration/access-control#x509-principals","X.509 principals",{"_3144":466,"_27488":456,"_5":27828,"_19100":46183,"_26023":46184,"_2643":46185},[],"/docs/pr-preview/pr-26/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3144":467,"_27488":456,"_5":27828,"_19100":46187,"_26023":46188,"_2643":46189},[],"/docs/pr-preview/pr-26/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3144":468,"_27488":456,"_5":27828,"_19100":46191,"_26023":46192,"_2643":46193},[],"/docs/pr-preview/pr-26/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3144":469,"_27488":456,"_5":27828,"_19100":46195,"_26023":46196,"_2643":46197},[],"/docs/pr-preview/pr-26/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3144":470,"_27488":456,"_5":27828,"_19100":46199,"_26023":46200,"_2643":46201},[],"/docs/pr-preview/pr-26/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3144":471,"_27488":456,"_5":27828,"_19100":46203,"_26023":46204,"_2643":46205},[],"/docs/pr-preview/pr-26/platform/administration/access-control#http-rules","HTTP rules",{"_3144":472,"_27488":456,"_5":27828,"_19100":46207,"_26023":46208,"_2643":46209},[],"/docs/pr-preview/pr-26/platform/administration/access-control#included-policies","Included policies",{"_3144":473,"_27488":456,"_5":27828,"_19100":46211,"_26023":46212,"_2643":45400},[],"/docs/pr-preview/pr-26/platform/administration/access-control#provision-the-first-administrator",{"_3144":474,"_27488":456,"_5":27828,"_19100":46214,"_26023":46215,"_2643":46216},[],"/docs/pr-preview/pr-26/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3144":475,"_27488":456,"_5":27828,"_19100":46218,"_26023":46219,"_2643":46220},[],"/docs/pr-preview/pr-26/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_3144":476,"_27488":456,"_5":27828,"_19100":46222,"_26023":46223,"_2643":46224},[],"/docs/pr-preview/pr-26/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3144":477,"_27488":456,"_5":27828,"_19100":46226,"_26023":46227,"_2643":46228},[],"/docs/pr-preview/pr-26/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3144":478,"_27488":456,"_5":27828,"_19100":46230,"_26023":46231,"_2643":46232},[],"/docs/pr-preview/pr-26/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3144":479,"_27488":456,"_5":27828,"_19100":46234,"_26023":46235,"_2643":46236},[],"/docs/pr-preview/pr-26/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3144":480,"_27488":456,"_5":27828,"_19100":46238,"_26023":46239,"_2643":46240},[],"/docs/pr-preview/pr-26/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3144":481,"_27488":456,"_5":27828,"_19100":46242,"_26023":46243,"_2643":46244},[],"/docs/pr-preview/pr-26/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3144":482,"_27488":456,"_5":27828,"_19100":46246,"_26023":46247,"_2643":46248},[],"/docs/pr-preview/pr-26/platform/administration/access-control#operational-checklist","Operational checklist",{"_3144":483,"_27488":456,"_5":27828,"_19100":46250,"_26023":46251,"_2643":46252},[],"/docs/pr-preview/pr-26/platform/administration/access-control#diagnostics","Diagnostics",{"_3144":484,"_27488":456,"_5":27828,"_19100":46254,"_26023":46255,"_2643":46256},[],"/docs/pr-preview/pr-26/platform/administration/access-control#the-response-is-401","The response is 401",{"_3144":485,"_27488":456,"_5":27828,"_19100":46258,"_26023":46259,"_2643":46260},[],"/docs/pr-preview/pr-26/platform/administration/access-control#the-response-is-403","The response is 403",{"_3144":486,"_27488":456,"_5":27828,"_19100":46262,"_26023":46263,"_2643":46264},[],"/docs/pr-preview/pr-26/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3144":487,"_27488":456,"_5":27828,"_19100":46266,"_26023":46267,"_2643":46268},[],"/docs/pr-preview/pr-26/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3144":488,"_27488":456,"_5":27828,"_19100":46270,"_26023":46271,"_2643":46272},[],"/docs/pr-preview/pr-26/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3144":489,"_27488":456,"_19100":46274,"_5":13150,"_26023":456,"_2643":46275},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3144":490,"_27488":456,"_19100":46277,"_5":13150,"_26023":456,"_2643":46278},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3144":491,"_27488":456,"_19100":46280,"_5":13150,"_26023":456,"_2643":46281},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3144":492,"_27488":456,"_19100":46283,"_5":13150,"_26023":46152,"_2643":46284},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3144":493,"_27488":456,"_19100":46286,"_5":13150,"_26023":46152,"_2643":46287},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3144":494,"_27488":456,"_19100":46289,"_5":13150,"_26023":46152,"_2643":46290},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3144":495,"_27488":456,"_19100":46292,"_5":13150,"_26023":46152,"_2643":46293},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3144":496,"_27488":456,"_19100":46295,"_5":13150,"_26023":46152,"_2643":46296},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3144":497,"_27488":456,"_19100":46298,"_5":13150,"_26023":46152,"_2643":46299},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3144":498,"_27488":456,"_19100":46301,"_5":13150,"_26023":46156,"_2643":46302},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3144":499,"_27488":456,"_19100":46304,"_5":13150,"_26023":46156,"_2643":46305},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3144":500,"_27488":456,"_19100":46307,"_5":13150,"_26023":46160,"_2643":46308},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3144":501,"_27488":456,"_19100":46310,"_5":13150,"_26023":46160,"_2643":46311},[],"The decision is made **before forwarding the request to the service**:",{"_3144":502,"_27488":456,"_19100":46313,"_5":13150,"_26023":46160,"_2643":46314},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3144":503,"_27488":456,"_19100":46316,"_5":13150,"_26023":46160,"_2643":46317},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3144":504,"_27488":456,"_19100":46319,"_5":13150,"_26023":46160,"_2643":46320},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3144":505,"_27488":456,"_19100":46322,"_5":13150,"_26023":46160,"_2643":46323},[],"It separately loads the policies granted to each principal.",{"_3144":506,"_27488":456,"_19100":46325,"_5":13150,"_26023":46160,"_2643":46326},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3144":507,"_27488":456,"_19100":46328,"_5":13150,"_26023":46160,"_2643":46329},[],"`authz` looks for an HTTP rule granting that action.",{"_3144":508,"_27488":456,"_19100":46331,"_5":13150,"_26023":46160,"_2643":46332},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3144":509,"_27488":456,"_19100":46334,"_5":13150,"_26023":46160,"_2643":46335},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3144":510,"_27488":456,"_19100":46337,"_5":13150,"_26023":46160,"_2643":46338},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3144":511,"_27488":456,"_19100":46340,"_5":13150,"_26023":46160,"_2643":46341},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3144":512,"_27488":456,"_19100":46343,"_5":13150,"_26023":46164,"_2643":46344},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3144":513,"_27488":456,"_19100":46346,"_5":13150,"_26023":46164,"_2643":46347},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3144":514,"_27488":456,"_19100":46349,"_5":13150,"_26023":46164,"_2643":46350},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3144":515,"_27488":456,"_19100":46352,"_5":13150,"_26023":46164,"_2643":46353},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3144":516,"_27488":456,"_19100":46355,"_5":13150,"_26023":46164,"_2643":46356},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3144":517,"_27488":456,"_19100":46358,"_5":13150,"_26023":46164,"_2643":46359},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3144":518,"_27488":456,"_19100":46361,"_5":13150,"_26023":46164,"_2643":46362},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3144":519,"_27488":456,"_19100":46364,"_5":13150,"_26023":46164,"_2643":46365},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3144":520,"_27488":456,"_19100":46367,"_5":13150,"_26023":46168,"_2643":46368},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3144":521,"_27488":456,"_19100":46370,"_5":13150,"_26023":46168,"_2643":46371},[],"The decision is made with the domain operation context:",{"_3144":522,"_27488":456,"_19100":46373,"_5":13150,"_26023":46168,"_2643":46374},[],"The middleware extracts the credential and resolves the matching principals.",{"_3144":523,"_27488":456,"_19100":46376,"_5":13150,"_26023":46168,"_2643":46377},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3144":524,"_27488":456,"_19100":46379,"_5":13150,"_26023":46168,"_2643":46380},[],"`authz` gathers the entity rules of the granted policies.",{"_3144":525,"_27488":456,"_19100":46382,"_5":13150,"_26023":46168,"_2643":46383},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3144":526,"_27488":456,"_19100":46385,"_5":13150,"_26023":46168,"_2643":46386},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3144":527,"_27488":456,"_19100":46388,"_5":13150,"_26023":46168,"_2643":46389},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3144":528,"_27488":456,"_19100":46391,"_5":13150,"_26023":46168,"_2643":46392},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3144":529,"_27488":456,"_19100":46394,"_5":13150,"_26023":46168,"_2643":46395},[],"Actions fall into two groups:",{"_3144":530,"_27488":456,"_19100":46397,"_5":13150,"_26023":46168,"_2643":46398},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3144":531,"_27488":456,"_19100":46400,"_5":13150,"_26023":46168,"_2643":46401},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3144":532,"_27488":456,"_19100":46403,"_5":13150,"_26023":46168,"_2643":46404},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3144":533,"_27488":456,"_19100":46406,"_5":13150,"_26023":46172,"_2643":46407},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3144":534,"_27488":456,"_19100":46409,"_5":13150,"_26023":46172,"_2643":46410},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3144":535,"_27488":456,"_19100":46412,"_5":13150,"_26023":46172,"_2643":46413},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3144":536,"_27488":456,"_19100":46415,"_5":13150,"_26023":46176,"_2643":46416},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3144":537,"_27488":456,"_19100":46418,"_5":13150,"_26023":46176,"_2643":46419},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3144":538,"_27488":456,"_19100":46421,"_5":13150,"_26023":46176,"_2643":46422},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3144":539,"_27488":456,"_19100":46424,"_5":13150,"_26023":46176,"_2643":46425},[],"The implemented operators are:",{"_3144":540,"_27488":456,"_19100":46427,"_5":13150,"_26023":46176,"_2643":46428},[],"`equals`, for exact equality;",{"_3144":541,"_27488":456,"_19100":46430,"_5":13150,"_26023":46176,"_2643":46431},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3144":542,"_27488":456,"_19100":46433,"_5":13150,"_26023":46176,"_2643":46434},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3144":543,"_27488":456,"_19100":46436,"_5":13150,"_26023":46176,"_2643":46437},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3144":544,"_27488":456,"_19100":46439,"_5":13150,"_26023":46180,"_2643":46440},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3144":545,"_27488":456,"_19100":46442,"_5":13150,"_26023":46180,"_2643":46443},[],"The available modes are:",{"_3144":546,"_27488":456,"_19100":46445,"_5":13150,"_26023":46180,"_2643":46446},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3144":547,"_27488":456,"_19100":46448,"_5":13150,"_26023":46180,"_2643":46449},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3144":548,"_27488":456,"_19100":46451,"_5":13150,"_26023":46180,"_2643":46452},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3144":549,"_27488":456,"_19100":46454,"_5":13150,"_26023":46180,"_2643":46455},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3144":550,"_27488":456,"_19100":46457,"_5":13150,"_26023":46180,"_2643":46458},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3144":551,"_27488":456,"_19100":46460,"_5":13150,"_26023":46180,"_2643":46461},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3144":552,"_27488":456,"_19100":46463,"_5":13150,"_26023":46184,"_2643":46464},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3144":553,"_27488":456,"_19100":46466,"_5":13150,"_26023":46184,"_2643":46467},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3144":554,"_27488":456,"_19100":46469,"_5":13150,"_26023":46184,"_2643":46470},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3144":555,"_27488":456,"_19100":46472,"_5":13150,"_26023":46184,"_2643":46473},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3144":556,"_27488":456,"_19100":46475,"_5":13150,"_26023":46192,"_2643":46476},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3144":557,"_27488":456,"_19100":46478,"_5":13150,"_26023":46192,"_2643":46479},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3144":558,"_27488":456,"_19100":46481,"_5":13150,"_26023":46196,"_2643":46482},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3144":559,"_27488":456,"_19100":46484,"_5":13150,"_26023":46196,"_2643":46485},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3144":560,"_27488":456,"_19100":46487,"_5":13150,"_26023":46200,"_2643":46488},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3144":561,"_27488":456,"_19100":46490,"_5":13150,"_26023":46200,"_2643":46491},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3144":562,"_27488":456,"_19100":46493,"_5":13150,"_26023":46200,"_2643":46494},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3144":563,"_27488":456,"_19100":46496,"_5":13150,"_26023":46204,"_2643":46497},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3144":564,"_27488":456,"_19100":46499,"_5":13150,"_26023":46204,"_2643":46500},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3144":565,"_27488":456,"_19100":46502,"_5":13150,"_26023":46204,"_2643":46503},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3144":566,"_27488":456,"_19100":46505,"_5":13150,"_26023":46204,"_2643":46506},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3144":567,"_27488":456,"_19100":46508,"_5":13150,"_26023":46204,"_2643":46509},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3144":568,"_27488":456,"_19100":46511,"_5":13150,"_26023":46204,"_2643":46512},[],"Note that:",{"_3144":569,"_27488":456,"_19100":46514,"_5":13150,"_26023":46204,"_2643":46515},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3144":570,"_27488":456,"_19100":46517,"_5":13150,"_26023":46204,"_2643":46518},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3144":571,"_27488":456,"_19100":46520,"_5":13150,"_26023":46204,"_2643":46521},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3144":572,"_27488":456,"_19100":46523,"_5":13150,"_26023":46208,"_2643":46524},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3144":573,"_27488":456,"_19100":46526,"_5":13150,"_26023":46208,"_2643":46527},[],"full and read-only access to certificates and authorities;",{"_3144":574,"_27488":456,"_19100":46529,"_5":13150,"_26023":46208,"_2643":46530},[],"full and read-only access to the KMS;",{"_3144":575,"_27488":456,"_19100":46532,"_5":13150,"_26023":46208,"_2643":46533},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3144":576,"_27488":456,"_19100":46535,"_5":13150,"_26023":46208,"_2643":46536},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3144":577,"_27488":456,"_19100":46538,"_5":13150,"_26023":46208,"_2643":46539},[],"console access;",{"_3144":578,"_27488":456,"_19100":46541,"_5":13150,"_26023":46208,"_2643":46542},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3144":579,"_27488":456,"_19100":46544,"_5":13150,"_26023":46208,"_2643":46545},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3144":580,"_27488":456,"_19100":46547,"_5":13150,"_26023":46208,"_2643":46548},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3144":581,"_27488":456,"_19100":46550,"_5":13150,"_26023":46212,"_2643":46551},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3144":582,"_27488":456,"_19100":46553,"_5":13150,"_26023":46212,"_2643":46554},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3144":583,"_27488":456,"_19100":46556,"_5":13150,"_26023":46212,"_2643":46557},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3144":584,"_27488":456,"_19100":46559,"_5":13150,"_26023":46215,"_2643":46560},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3144":585,"_27488":456,"_19100":46562,"_5":13150,"_26023":46219,"_2643":46563},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_3144":586,"_27488":456,"_19100":46565,"_5":13150,"_26023":46223,"_2643":46566},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3144":587,"_27488":456,"_19100":46568,"_5":13150,"_26023":46227,"_2643":46569},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3144":588,"_27488":456,"_19100":46571,"_5":13150,"_26023":46231,"_2643":46572},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3144":589,"_27488":456,"_19100":46574,"_5":13150,"_26023":46235,"_2643":46575},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3144":590,"_27488":456,"_19100":46577,"_5":13150,"_26023":46235,"_2643":46578},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3144":591,"_27488":456,"_19100":46580,"_5":13150,"_26023":46239,"_2643":46581},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3144":592,"_27488":456,"_19100":46583,"_5":13150,"_26023":46239,"_2643":46584},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3144":593,"_27488":456,"_19100":46586,"_5":13150,"_26023":46239,"_2643":46587},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3144":594,"_27488":456,"_19100":46589,"_5":13150,"_26023":46239,"_2643":46590},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3144":595,"_27488":456,"_19100":46592,"_5":13150,"_26023":46239,"_2643":46593},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3144":596,"_27488":456,"_19100":46595,"_5":13150,"_26023":46239,"_2643":46596},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3144":597,"_27488":456,"_19100":46598,"_5":13150,"_26023":46239,"_2643":46599},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3144":598,"_27488":456,"_19100":46601,"_5":13150,"_26023":46239,"_2643":46602},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3144":599,"_27488":456,"_19100":46604,"_5":13150,"_26023":46243,"_2643":46605},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3144":600,"_27488":456,"_19100":46607,"_5":13150,"_26023":46243,"_2643":46608},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3144":601,"_27488":456,"_19100":46610,"_5":13150,"_26023":46243,"_2643":46611},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3144":602,"_27488":456,"_19100":46613,"_5":13150,"_26023":46247,"_2643":46614},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3144":603,"_27488":456,"_19100":46616,"_5":13150,"_26023":46247,"_2643":46617},[],"Use groups or stable roles for people and independent identities for automations.",{"_3144":604,"_27488":456,"_19100":46619,"_5":13150,"_26023":46247,"_2643":46620},[],"Keep at least two recovery administrators and test their access periodically.",{"_3144":605,"_27488":456,"_19100":46622,"_5":13150,"_26023":46247,"_2643":46623},[],"Review active principals, their matches and their grants after IdP changes.",{"_3144":606,"_27488":456,"_19100":46625,"_5":13150,"_26023":46247,"_2643":46626},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3144":607,"_27488":456,"_19100":46628,"_5":13150,"_26023":46247,"_2643":46629},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3144":608,"_27488":456,"_19100":46631,"_5":13150,"_26023":46247,"_2643":46632},[],"Always test one allowed and one denied operation for each role.",{"_3144":609,"_27488":456,"_19100":46634,"_5":13150,"_26023":46247,"_2643":46635},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3144":610,"_27488":456,"_19100":46637,"_5":13150,"_26023":46255,"_2643":46638},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3144":611,"_27488":456,"_19100":46640,"_5":13150,"_26023":46259,"_2643":46641},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3144":612,"_27488":456,"_19100":46643,"_5":13150,"_26023":46259,"_2643":46644},[],"that an active principal of the correct type exists;",{"_3144":613,"_27488":456,"_19100":46646,"_5":13150,"_26023":46259,"_2643":46647},[],"that the claim paths and values match the real token exactly;",{"_3144":614,"_27488":456,"_19100":46649,"_5":13150,"_26023":46259,"_2643":46650},[],"that all of the principal's conditions hold;",{"_3144":615,"_27488":456,"_19100":46652,"_5":13150,"_26023":46259,"_2643":46653},[],"that the principal has the expected policy granted;",{"_3144":616,"_27488":456,"_19100":46655,"_5":13150,"_26023":46259,"_2643":46656},[],"that the policy includes the action and the requested resource type or route;",{"_3144":617,"_27488":456,"_19100":46658,"_5":13150,"_26023":46259,"_2643":46659},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3144":618,"_27488":456,"_19100":46661,"_5":13150,"_26023":46259,"_2643":46662},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3144":619,"_27488":456,"_19100":46664,"_5":13150,"_26023":46263,"_2643":46665},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3144":620,"_27488":456,"_19100":46667,"_5":13150,"_26023":46267,"_2643":46668},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3144":621,"_27488":456,"_19100":46670,"_5":13150,"_26023":46271,"_2643":46671},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3144":622,"_27488":456,"_19100":46673,"_5":13150,"_26023":46271,"_2643":46674},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3144":623,"_27488":623,"_5":13476,"_2643":46676,"_27831":46677,"_19100":46678,"_26023":623},"Alerts and subscriptions",[44764,46144,46145],[],{"_3144":624,"_27488":623,"_19100":46680,"_5":13150,"_26023":623,"_2643":46681},[],"Send PKI events to people and external systems.",{"_3144":625,"_27488":623,"_5":27828,"_19100":46683,"_26023":46684,"_2643":46685},[],"/docs/pr-preview/pr-26/platform/administration/alerts#how-it-works","How it works",{"_3144":626,"_27488":623,"_5":27828,"_19100":46687,"_26023":46688,"_2643":46689},[],"/docs/pr-preview/pr-26/platform/administration/alerts#available-channels","Available channels",{"_3144":627,"_27488":623,"_5":27828,"_19100":46691,"_26023":46692,"_2643":46693},[],"/docs/pr-preview/pr-26/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3144":628,"_27488":623,"_5":27828,"_19100":46695,"_26023":46696,"_2643":46697},[],"/docs/pr-preview/pr-26/platform/administration/alerts#choose-the-event","Choose the event",{"_3144":629,"_27488":623,"_5":27828,"_19100":46699,"_26023":46700,"_2643":46701},[],"/docs/pr-preview/pr-26/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3144":630,"_27488":623,"_5":27828,"_19100":46703,"_26023":46704,"_2643":46705},[],"/docs/pr-preview/pr-26/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3144":631,"_27488":623,"_5":27828,"_19100":46707,"_26023":46708,"_2643":46709},[],"/docs/pr-preview/pr-26/platform/administration/alerts#review-and-activate","Review and activate",{"_3144":632,"_27488":623,"_5":27828,"_19100":46711,"_26023":46712,"_2643":46713},[],"/docs/pr-preview/pr-26/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3144":633,"_27488":623,"_5":27828,"_19100":46715,"_26023":46716,"_2643":46717},[],"/docs/pr-preview/pr-26/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3144":634,"_27488":623,"_5":27828,"_19100":46719,"_26023":46720,"_2643":46721},[],"/docs/pr-preview/pr-26/platform/administration/alerts#event-families","Event families",{"_3144":635,"_27488":623,"_19100":46723,"_5":13150,"_26023":623,"_2643":46724},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3144":636,"_27488":623,"_19100":46726,"_5":13150,"_26023":46684,"_2643":46727},[],"A service publishes a domain event.",{"_3144":637,"_27488":623,"_19100":46729,"_5":13150,"_26023":46684,"_2643":46730},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3144":638,"_27488":623,"_19100":46732,"_5":13150,"_26023":46684,"_2643":46733},[],"Each subscription's filter decides whether it should be notified.",{"_3144":639,"_27488":623,"_19100":46735,"_5":13150,"_26023":46684,"_2643":46736},[],"Lamassu delivers the event to the configured channel.",{"_3144":640,"_27488":623,"_19100":46738,"_5":13150,"_26023":46684,"_2643":46739},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3144":641,"_27488":623,"_19100":46741,"_5":13150,"_26023":46688,"_2643":46742},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3144":642,"_27488":623,"_19100":46744,"_5":13150,"_26023":46688,"_2643":46745},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3144":643,"_27488":623,"_19100":46747,"_5":13150,"_26023":46688,"_2643":46748},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3144":644,"_27488":623,"_19100":46750,"_5":13150,"_26023":46688,"_2643":46751},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3144":645,"_27488":623,"_19100":46753,"_5":13150,"_26023":46688,"_2643":46754},[],"`apikey_options` requires `header` and `key`.",{"_3144":646,"_27488":623,"_19100":46756,"_5":13150,"_26023":46688,"_2643":46757},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3144":647,"_27488":623,"_19100":46759,"_5":13150,"_26023":46688,"_2643":46760},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3144":648,"_27488":623,"_19100":46762,"_5":13150,"_26023":46688,"_2643":46763},[],"The alerts API reference documents the full `http_client` schema.",{"_3144":649,"_27488":623,"_19100":46765,"_5":13150,"_26023":46696,"_2643":46766},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3144":650,"_27488":623,"_19100":46768,"_5":13150,"_26023":46700,"_2643":46769},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3144":651,"_27488":623,"_19100":46771,"_5":13150,"_26023":46704,"_2643":46772},[],"Add a filter if you don't want to receive every instance of the event.",{"_3144":652,"_27488":623,"_19100":46774,"_5":13150,"_26023":46704,"_2643":46775},[],"**None** notifies all instances of the event.",{"_3144":653,"_27488":623,"_19100":46777,"_5":13150,"_26023":46704,"_2643":46778},[],"**JSON Path** evaluates one or more specific fields.",{"_3144":654,"_27488":623,"_19100":46780,"_5":13150,"_26023":46704,"_2643":46781},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3144":655,"_27488":623,"_19100":46783,"_5":13150,"_26023":46704,"_2643":46784},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3144":656,"_27488":623,"_19100":46786,"_5":13150,"_26023":46704,"_2643":46787},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3144":657,"_27488":623,"_19100":46789,"_5":13150,"_26023":46708,"_2643":46790},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3144":658,"_27488":623,"_19100":46792,"_5":13150,"_26023":46712,"_2643":46793},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3144":659,"_27488":623,"_19100":46795,"_5":13150,"_26023":46712,"_2643":46796},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3144":660,"_27488":623,"_19100":46798,"_5":13150,"_26023":46712,"_2643":46799},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3144":661,"_27488":623,"_19100":46801,"_5":13150,"_26023":46712,"_2643":46802},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3144":662,"_27488":623,"_19100":46804,"_5":13150,"_26023":46712,"_2643":46805},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3144":663,"_27488":623,"_19100":46807,"_5":13150,"_26023":46712,"_2643":46808},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3144":664,"_27488":623,"_19100":46810,"_5":13150,"_26023":46712,"_2643":46811},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3144":665,"_27488":623,"_19100":46813,"_5":13150,"_26023":46712,"_2643":46814},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3144":666,"_27488":623,"_19100":46816,"_5":13150,"_26023":46716,"_2643":46817},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3144":667,"_27488":623,"_19100":46819,"_5":13150,"_26023":46720,"_2643":46820},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3144":668,"_27488":623,"_19100":46822,"_5":13150,"_26023":46720,"_2643":46823},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3144":669,"_27488":623,"_19100":46825,"_5":13150,"_26023":46720,"_2643":46826},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3144":670,"_27488":623,"_19100":46828,"_5":13150,"_26023":46720,"_2643":46829},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3144":671,"_27488":623,"_19100":46831,"_5":13150,"_26023":46720,"_2643":46832},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3144":672,"_27488":623,"_19100":46834,"_5":13150,"_26023":46720,"_2643":46835},[],"**Validation:** `va.role.crl.create`.",{"_3144":673,"_27488":623,"_19100":46837,"_5":13150,"_26023":46720,"_2643":46838},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3144":674,"_27488":623,"_19100":46840,"_5":13150,"_26023":46720,"_2643":46841},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3144":675,"_27488":675,"_5":13476,"_2643":46843,"_27831":46844,"_19100":46845,"_26023":675},"Audit logs",[44764,46144,46145],[],{"_3144":676,"_27488":675,"_19100":46847,"_5":13150,"_26023":675,"_2643":46848},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3144":677,"_27488":675,"_5":27828,"_19100":46850,"_26023":46851,"_2643":46852},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3144":678,"_27488":675,"_5":27828,"_19100":46854,"_26023":46855,"_2643":46856},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#coverage","Coverage",{"_3144":679,"_27488":675,"_5":27828,"_19100":46858,"_26023":46859,"_2643":46860},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3144":680,"_27488":675,"_5":27828,"_19100":46862,"_26023":46863,"_2643":46864},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3144":681,"_27488":675,"_5":27828,"_19100":46866,"_26023":46867,"_2643":46868},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3144":682,"_27488":675,"_5":27828,"_19100":46870,"_26023":46871,"_2643":46872},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3144":683,"_27488":675,"_5":27828,"_19100":46874,"_26023":46875,"_2643":46876},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3144":684,"_27488":675,"_5":27828,"_19100":46878,"_26023":46879,"_2643":46880},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3144":685,"_27488":675,"_5":27828,"_19100":46882,"_26023":46883,"_2643":46884},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3144":686,"_27488":675,"_5":27828,"_19100":46886,"_26023":46887,"_2643":46888},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3144":687,"_27488":675,"_5":27828,"_19100":46890,"_26023":46891,"_2643":46892},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3144":688,"_27488":675,"_19100":46894,"_5":13150,"_26023":675,"_2643":46895},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3144":689,"_27488":675,"_19100":46897,"_5":13150,"_26023":46851,"_2643":46898},[],"The audit body includes:",{"_3144":690,"_27488":675,"_19100":46900,"_5":13150,"_26023":46851,"_2643":46901},[],"input: data received by the operation;",{"_3144":691,"_27488":675,"_19100":46903,"_5":13150,"_26023":46851,"_2643":46904},[],"has\\_error: whether the service returned an error;",{"_3144":692,"_27488":675,"_19100":46906,"_5":13150,"_26023":46851,"_2643":46907},[],"output: produced result or error message;",{"_3144":693,"_27488":675,"_19100":46909,"_5":13150,"_26023":46851,"_2643":46910},[],"principals: identifiers of the principals that matched the request.",{"_3144":694,"_27488":675,"_19100":46912,"_5":13150,"_26023":46851,"_2643":46913},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3144":695,"_27488":675,"_19100":46915,"_5":13150,"_26023":46851,"_2643":46916},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3144":696,"_27488":675,"_19100":46918,"_5":13150,"_26023":46855,"_2643":46919},[],"The backend applies auditing to mutations of:",{"_3144":697,"_27488":675,"_19100":46921,"_5":13150,"_26023":46855,"_2643":46922},[],"authorities, certificates and issuance profiles;",{"_3144":698,"_27488":675,"_19100":46924,"_5":13150,"_26023":46855,"_2643":46925},[],"keys and KMS engines;",{"_3144":699,"_27488":675,"_19100":46927,"_5":13150,"_26023":46855,"_2643":46928},[],"devices and identities;",{"_3144":700,"_27488":675,"_19100":46930,"_5":13150,"_26023":46855,"_2643":46931},[],"DMSs and enrollment operations;",{"_3144":701,"_27488":675,"_19100":46933,"_5":13150,"_26023":46855,"_2643":46934},[],"validation functions and CRL;",{"_3144":702,"_27488":675,"_19100":46936,"_5":13150,"_26023":46855,"_2643":46937},[],"principals, policies and authorization grants.",{"_3144":703,"_27488":675,"_19100":46939,"_5":13150,"_26023":46855,"_2643":46940},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3144":704,"_27488":675,"_19100":46942,"_5":13150,"_26023":46859,"_2643":46943},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3144":705,"_27488":675,"_19100":46945,"_5":13150,"_26023":46859,"_2643":46946},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3144":706,"_27488":675,"_19100":46948,"_5":13150,"_26023":46859,"_2643":46949},[],"Design the consumer to:",{"_3144":707,"_27488":675,"_19100":46951,"_5":13150,"_26023":46859,"_2643":46952},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3144":708,"_27488":675,"_19100":46954,"_5":13150,"_26023":46859,"_2643":46955},[],"keep the complete CloudEvent unmodified;",{"_3144":709,"_27488":675,"_19100":46957,"_5":13150,"_26023":46859,"_2643":46958},[],"record the ingestion time and detect duplicates by ID;",{"_3144":710,"_27488":675,"_19100":46960,"_5":13150,"_26023":46859,"_2643":46961},[],"encrypt in transit and at rest;",{"_3144":711,"_27488":675,"_19100":46963,"_5":13150,"_26023":46859,"_2643":46964},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3144":712,"_27488":675,"_19100":46966,"_5":13150,"_26023":46859,"_2643":46967},[],"apply an explicit retention and legal hold policy;",{"_3144":713,"_27488":675,"_19100":46969,"_5":13150,"_26023":46859,"_2643":46970},[],"alert if it stops consuming or the pending queue grows.",{"_3144":714,"_27488":675,"_19100":46972,"_5":13150,"_26023":46863,"_2643":46973},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3144":715,"_27488":675,"_19100":46975,"_5":13150,"_26023":46863,"_2643":46976},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3144":716,"_27488":675,"_19100":46978,"_5":13150,"_26023":46871,"_2643":46979},[],"Start from the reported time and normalize every source to UTC.",{"_3144":717,"_27488":675,"_19100":46981,"_5":13150,"_26023":46875,"_2643":46982},[],"Filter by event type, service source and resource identifier.",{"_3144":718,"_27488":675,"_19100":46984,"_5":13150,"_26023":46879,"_2643":46985},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3144":719,"_27488":675,"_19100":46987,"_5":13150,"_26023":46883,"_2643":46988},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3144":720,"_27488":675,"_19100":46990,"_5":13150,"_26023":46887,"_2643":46991},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3144":721,"_27488":675,"_19100":46993,"_5":13150,"_26023":46891,"_2643":46994},[],"Generate a controlled mutation in a test environment and check that:",{"_3144":722,"_27488":675,"_19100":46996,"_5":13150,"_26023":46891,"_2643":46997},[],"a successful audit event appears;",{"_3144":723,"_27488":675,"_19100":46999,"_5":13150,"_26023":46891,"_2643":47000},[],"the principal matches the identity used;",{"_3144":724,"_27488":675,"_19100":47002,"_5":13150,"_26023":46891,"_2643":47003},[],"the consumer persists it exactly once;",{"_3144":725,"_27488":675,"_19100":47005,"_5":13150,"_26023":46891,"_2643":47006},[],"it can be retrieved by resource, actor and period;",{"_3144":726,"_27488":675,"_19100":47008,"_5":13150,"_26023":46891,"_2643":47009},[],"a consumer outage raises an alert.",{"_3144":727,"_27488":675,"_19100":47011,"_5":13150,"_26023":46891,"_2643":47012},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3144":728,"_27488":728,"_5":13476,"_2643":47014,"_27831":47015,"_19100":47016,"_26023":728},"Platform architecture",[44764,46144],[],{"_3144":729,"_27488":728,"_19100":47018,"_5":13150,"_26023":728,"_2643":47019},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3144":730,"_27488":728,"_5":27828,"_19100":47021,"_26023":47022,"_2643":47023},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#control-plane","Control plane",{"_3144":731,"_27488":728,"_5":27828,"_19100":47025,"_26023":47026,"_2643":47027},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3144":732,"_27488":728,"_5":27828,"_19100":47029,"_26023":47030,"_2643":47031},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3144":733,"_27488":728,"_5":27828,"_19100":47033,"_26023":47034,"_2643":47035},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#status-and-validation","Status and validation",{"_3144":734,"_27488":728,"_5":27828,"_19100":47037,"_26023":47038,"_2643":47039},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3144":735,"_27488":728,"_19100":47041,"_5":13150,"_26023":728,"_2643":47042},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3144":736,"_27488":728,"_19100":47044,"_5":13150,"_26023":728,"_2643":47045},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3144":737,"_27488":728,"_19100":47047,"_5":13150,"_26023":47022,"_2643":47048},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3144":738,"_27488":728,"_19100":47050,"_5":13150,"_26023":47026,"_2643":47051},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3144":739,"_27488":728,"_19100":47053,"_5":13150,"_26023":47030,"_2643":47054},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3144":740,"_27488":728,"_19100":47056,"_5":13150,"_26023":47034,"_2643":47057},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3144":741,"_27488":728,"_19100":47059,"_5":13150,"_26023":47038,"_2643":47060},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3144":742,"_27488":742,"_5":13476,"_2643":47062,"_27831":47063,"_19100":47064,"_26023":742},"How Lamassu works",[44764,46144],[],{"_3144":743,"_27488":742,"_19100":47066,"_5":13150,"_26023":742,"_2643":47067},[],"The mental model of trust, keys, certificates and devices.",{"_3144":744,"_27488":742,"_5":27828,"_19100":47069,"_26023":47070,"_2643":47071},[],"/docs/pr-preview/pr-26/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3144":745,"_27488":742,"_5":27828,"_19100":47073,"_26023":47074,"_2643":47075},[],"/docs/pr-preview/pr-26/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3144":746,"_27488":742,"_19100":47077,"_5":13150,"_26023":742,"_2643":47078},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3144":747,"_27488":742,"_19100":47080,"_5":13150,"_26023":47070,"_2643":47081},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3144":748,"_27488":742,"_19100":47083,"_5":13150,"_26023":47070,"_2643":47084},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3144":749,"_27488":742,"_19100":47086,"_5":13150,"_26023":47070,"_2643":47087},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3144":750,"_27488":742,"_19100":47089,"_5":13150,"_26023":47070,"_2643":47090},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3144":751,"_27488":742,"_19100":47092,"_5":13150,"_26023":47070,"_2643":47093},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3144":752,"_27488":742,"_19100":47095,"_5":13150,"_26023":47074,"_2643":47096},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3144":753,"_27488":742,"_19100":47098,"_5":13150,"_26023":47074,"_2643":47099},[],"A DMS relates that CA to an enrollment policy.",{"_3144":754,"_27488":742,"_19100":47101,"_5":13150,"_26023":47074,"_2643":47102},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3144":755,"_27488":742,"_19100":47104,"_5":13150,"_26023":47074,"_2643":47105},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3144":756,"_27488":742,"_19100":47107,"_5":13150,"_26023":47074,"_2643":47108},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3144":757,"_27488":742,"_19100":47110,"_5":13150,"_26023":47074,"_2643":47111},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3144":758,"_27488":742,"_19100":47113,"_5":13150,"_26023":47074,"_2643":47114},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3144":759,"_27488":759,"_5":13476,"_2643":47116,"_27831":47117,"_19100":47119,"_26023":759},"Devices and identities",[44764,46144,47118,47116],"IoT Fleets",[],{"_3144":760,"_27488":759,"_19100":47121,"_5":13150,"_26023":759,"_2643":47122},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3144":761,"_27488":759,"_5":27828,"_19100":47124,"_26023":47125,"_2643":47126},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#device-states","Device states",{"_3144":762,"_27488":759,"_5":27828,"_19100":47128,"_26023":47129,"_2643":47130},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3144":763,"_27488":759,"_5":27828,"_19100":47132,"_26023":47133,"_2643":47134},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3144":764,"_27488":759,"_5":27828,"_19100":47136,"_26023":47137,"_2643":47138},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3144":765,"_27488":759,"_5":27828,"_19100":47140,"_26023":47141,"_2643":47142},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3144":766,"_27488":759,"_5":27828,"_19100":47144,"_26023":47145,"_2643":47146},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3144":767,"_27488":759,"_5":27828,"_19100":47148,"_26023":47149,"_2643":47150},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3144":768,"_27488":759,"_5":27828,"_19100":47152,"_26023":47153,"_2643":47154},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3144":769,"_27488":759,"_5":27828,"_19100":47156,"_26023":47157,"_2643":47158},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3144":770,"_27488":759,"_5":27828,"_19100":47160,"_26023":47161,"_2643":47162},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3144":771,"_27488":759,"_5":27828,"_19100":47164,"_26023":47165,"_2643":47166},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3144":772,"_27488":759,"_19100":47168,"_5":13150,"_26023":759,"_2643":47169},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3144":773,"_27488":759,"_19100":47171,"_5":13150,"_26023":759,"_2643":47172},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3144":774,"_27488":759,"_19100":47174,"_5":13150,"_26023":47125,"_2643":47175},[],"Operational view",{"_3144":775,"_27488":759,"_19100":47177,"_5":13150,"_26023":47125,"_2643":47178},[],"Meaning",{"_3144":776,"_27488":759,"_19100":47180,"_5":13150,"_26023":47125,"_2643":47181},[],"**No Identity**",{"_3144":777,"_27488":759,"_19100":47183,"_5":13150,"_26023":47125,"_2643":47184},[],"A record exists without an associated identity.",{"_3144":778,"_27488":759,"_19100":47186,"_5":13150,"_26023":47125,"_2643":47187},[],"**Active**",{"_3144":779,"_27488":759,"_19100":47189,"_5":13150,"_26023":47125,"_2643":47190},[],"The slot is active; also check certificate dates, status and usages.",{"_3144":780,"_27488":759,"_19100":47192,"_5":13150,"_26023":47125,"_2643":47193},[],"**Renewal Pending**",{"_3144":781,"_27488":759,"_19100":47195,"_5":13150,"_26023":47125,"_2643":47196},[],"The identity is in the operational renewal window.",{"_3144":782,"_27488":759,"_19100":47198,"_5":13150,"_26023":47125,"_2643":47199},[],"**Expiring Soon**",{"_3144":783,"_27488":759,"_19100":47201,"_5":13150,"_26023":47125,"_2643":47202},[],"Expiration is approaching according to configured thresholds.",{"_3144":784,"_27488":759,"_19100":47204,"_5":13150,"_26023":47125,"_2643":47205},[],"**Expired**",{"_3144":785,"_27488":759,"_19100":47207,"_5":13150,"_26023":47125,"_2643":47208},[],"The identity has expired.",{"_3144":786,"_27488":759,"_19100":47210,"_5":13150,"_26023":47125,"_2643":47211},[],"**Revoked**",{"_3144":787,"_27488":759,"_19100":47213,"_5":13150,"_26023":47125,"_2643":47214},[],"The identity is marked revoked.",{"_3144":788,"_27488":759,"_19100":47216,"_5":13150,"_26023":47125,"_2643":47217},[],"**Decommissioned**",{"_3144":789,"_27488":759,"_19100":47219,"_5":13150,"_26023":47125,"_2643":47220},[],"The record is retired and ordinary updates do not restore operation.",{"_3144":790,"_27488":759,"_19100":47222,"_5":13150,"_26023":47125,"_2643":47223},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3144":791,"_27488":759,"_19100":47225,"_5":13150,"_26023":47129,"_2643":47226},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3144":792,"_27488":759,"_19100":47228,"_5":13150,"_26023":47129,"_2643":47229},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3144":793,"_27488":759,"_19100":47231,"_5":13150,"_26023":47129,"_2643":47232},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3144":794,"_27488":759,"_19100":47234,"_5":13150,"_26023":47129,"_2643":47235},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3144":795,"_27488":759,"_19100":47237,"_5":13150,"_26023":47133,"_2643":47238},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3144":796,"_27488":759,"_19100":47240,"_5":13150,"_26023":47137,"_2643":47241},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3144":797,"_27488":759,"_19100":47243,"_5":13150,"_26023":47141,"_2643":47244},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3144":798,"_27488":759,"_19100":47246,"_5":13150,"_26023":47145,"_2643":47247},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3144":799,"_27488":759,"_19100":47249,"_5":13150,"_26023":47149,"_2643":47250},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3144":800,"_27488":759,"_19100":47252,"_5":13150,"_26023":47149,"_2643":47253},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3144":801,"_27488":759,"_19100":47255,"_5":13150,"_26023":47153,"_2643":47256},[],"From **No Identity**, use **Assign Identity**:",{"_3144":802,"_27488":759,"_19100":47258,"_5":13150,"_26023":47153,"_2643":47259},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3144":803,"_27488":759,"_19100":47261,"_5":13150,"_26023":47153,"_2643":47262},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3144":804,"_27488":759,"_19100":47264,"_5":13150,"_26023":47153,"_2643":47265},[],"Confirm and read the serial, active version and history again.",{"_3144":805,"_27488":759,"_19100":47267,"_5":13150,"_26023":47153,"_2643":47268},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3144":806,"_27488":759,"_19100":47270,"_5":13150,"_26023":47153,"_2643":47271},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3144":807,"_27488":759,"_19100":47273,"_5":13150,"_26023":47157,"_2643":47274},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3144":808,"_27488":759,"_19100":47276,"_5":13150,"_26023":47157,"_2643":47277},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3144":809,"_27488":759,"_19100":47279,"_5":13150,"_26023":47161,"_2643":47280},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3144":810,"_27488":759,"_19100":47282,"_5":13150,"_26023":47161,"_2643":47283},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3144":811,"_27488":759,"_19100":47285,"_5":13150,"_26023":47161,"_2643":47286},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3144":812,"_27488":759,"_19100":47288,"_5":13150,"_26023":47161,"_2643":47289},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3144":813,"_27488":759,"_19100":47291,"_5":13150,"_26023":47165,"_2643":47292},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3144":814,"_27488":759,"_19100":47294,"_5":13150,"_26023":47165,"_2643":47295},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3144":815,"_27488":815,"_5":13476,"_2643":47297,"_27831":47298,"_19100":47300,"_26023":815},"Bootstrap identity and authentication",[44764,46144,47118,47116,47299],"Enrollment with PKI",[],{"_3144":816,"_27488":815,"_19100":47302,"_5":13150,"_26023":815,"_2643":47303},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3144":817,"_27488":815,"_5":27828,"_19100":47305,"_26023":47306,"_2643":47307},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3144":818,"_27488":815,"_5":27828,"_19100":47309,"_26023":47310,"_2643":47311},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3144":819,"_27488":815,"_5":27828,"_19100":47313,"_26023":47314,"_2643":47315},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3144":820,"_27488":815,"_5":27828,"_19100":47317,"_26023":47318,"_2643":47319},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3144":821,"_27488":815,"_5":27828,"_19100":47321,"_26023":47322,"_2643":47323},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3144":822,"_27488":815,"_19100":47325,"_5":13150,"_26023":815,"_2643":47326},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3144":823,"_27488":815,"_19100":47328,"_5":13150,"_26023":47306,"_2643":47329},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3144":824,"_27488":815,"_19100":47331,"_5":13150,"_26023":47306,"_2643":47332},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3144":825,"_27488":815,"_19100":47334,"_5":13150,"_26023":47310,"_2643":47335},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3144":826,"_27488":815,"_19100":47337,"_5":13150,"_26023":47310,"_2643":47338},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3144":827,"_27488":815,"_19100":47340,"_5":13150,"_26023":47310,"_2643":47341},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3144":828,"_27488":815,"_19100":47343,"_5":13150,"_26023":47314,"_2643":47344},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3144":829,"_27488":815,"_19100":47346,"_5":13150,"_26023":47314,"_2643":47347},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3144":830,"_27488":815,"_19100":47349,"_5":13150,"_26023":47318,"_2643":47350},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3144":831,"_27488":815,"_19100":47352,"_5":13150,"_26023":47318,"_2643":47353},[],"Example body:",{"_3144":832,"_27488":815,"_19100":47355,"_5":13150,"_26023":47318,"_2643":47356},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3144":833,"_27488":815,"_19100":47358,"_5":13150,"_26023":47318,"_2643":47359},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3144":834,"_27488":815,"_19100":47361,"_5":13150,"_26023":47318,"_2643":47362},[],"Continuation requires a successful HTTP response and JSON:",{"_3144":835,"_27488":815,"_19100":47364,"_5":13150,"_26023":47318,"_2643":47365},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3144":836,"_27488":815,"_19100":47367,"_5":13150,"_26023":47322,"_2643":47368},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3144":837,"_27488":815,"_19100":47370,"_5":13150,"_26023":47322,"_2643":47371},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3144":838,"_27488":838,"_5":13476,"_2643":47373,"_27831":47374,"_19100":47375,"_26023":838},"Configure and operate the DMS",[44764,46144,47118,47116,47299],[],{"_3144":839,"_27488":838,"_19100":47377,"_5":13150,"_26023":838,"_2643":47378},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3144":840,"_27488":838,"_5":27828,"_19100":47380,"_26023":47381,"_2643":44774},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3144":841,"_27488":838,"_5":27828,"_19100":47383,"_26023":47384,"_2643":47385},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3144":842,"_27488":838,"_5":27828,"_19100":47387,"_26023":47388,"_2643":47389},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3144":843,"_27488":838,"_5":27828,"_19100":47391,"_26023":47392,"_2643":47393},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3144":844,"_27488":838,"_5":27828,"_19100":47395,"_26023":47396,"_2643":47397},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3144":845,"_27488":838,"_5":27828,"_19100":47399,"_26023":47400,"_2643":47401},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3144":846,"_27488":838,"_5":27828,"_19100":47403,"_26023":47404,"_2643":47405},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3144":847,"_27488":838,"_5":27828,"_19100":47407,"_26023":47408,"_2643":47409},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3144":848,"_27488":838,"_5":27828,"_19100":47411,"_26023":47412,"_2643":47413},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3144":849,"_27488":838,"_5":27828,"_19100":47415,"_26023":47416,"_2643":47417},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3144":850,"_27488":838,"_5":27828,"_19100":47419,"_26023":47420,"_2643":47421},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3144":851,"_27488":838,"_5":27828,"_19100":47423,"_26023":47424,"_2643":47425},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3144":852,"_27488":838,"_5":27828,"_19100":47427,"_26023":47428,"_2643":47429},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3144":853,"_27488":838,"_5":27828,"_19100":47431,"_26023":47432,"_2643":47433},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3144":854,"_27488":838,"_5":27828,"_19100":47435,"_26023":47436,"_2643":47437},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3144":855,"_27488":838,"_5":27828,"_19100":47439,"_26023":47440,"_2643":47441},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3144":856,"_27488":838,"_5":27828,"_19100":47443,"_26023":47444,"_2643":47445},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3144":857,"_27488":838,"_5":27828,"_19100":47447,"_26023":47448,"_2643":47449},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3144":858,"_27488":838,"_19100":47451,"_5":13150,"_26023":838,"_2643":47452},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3144":859,"_27488":838,"_19100":47454,"_5":13150,"_26023":47381,"_2643":47455},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3144":860,"_27488":838,"_19100":47457,"_5":13150,"_26023":47381,"_2643":47458},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3144":861,"_27488":838,"_19100":47460,"_5":13150,"_26023":47388,"_2643":47461},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3144":862,"_27488":838,"_19100":47463,"_5":13150,"_26023":47392,"_2643":47464},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3144":863,"_27488":838,"_19100":47466,"_5":13150,"_26023":47396,"_2643":47467},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3144":864,"_27488":838,"_19100":47469,"_5":13150,"_26023":47400,"_2643":47470},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3144":865,"_27488":838,"_19100":47472,"_5":13150,"_26023":47404,"_2643":47473},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3144":866,"_27488":838,"_19100":47475,"_5":13150,"_26023":47412,"_2643":47476},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3144":867,"_27488":838,"_19100":47478,"_5":13150,"_26023":47412,"_2643":47479},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3144":868,"_27488":838,"_19100":47481,"_5":13150,"_26023":47416,"_2643":47482},[],"`settings.enrollment_settings` field",{"_3144":869,"_27488":838,"_19100":47484,"_5":13150,"_26023":47416,"_2643":47485},[],"Decision",{"_3144":870,"_27488":838,"_19100":47487,"_5":13150,"_26023":47416,"_2643":47488},[],"`protocol`",{"_3144":871,"_27488":838,"_19100":47490,"_5":13150,"_26023":47416,"_2643":47491},[],"`EST_RFC7030` for these operations.",{"_3144":872,"_27488":838,"_19100":47493,"_5":13150,"_26023":47416,"_2643":47494},[],"`enrollment_ca`",{"_3144":873,"_27488":838,"_19100":47496,"_5":13150,"_26023":47416,"_2643":47497},[],"ID of the signing CA.",{"_3144":874,"_27488":838,"_19100":47499,"_5":13150,"_26023":47416,"_2643":47500},[],"`verify_csr_signature`",{"_3144":875,"_27488":838,"_19100":47502,"_5":13150,"_26023":47416,"_2643":47503},[],"Keep `true` to verify CSR key possession.",{"_3144":876,"_27488":838,"_19100":47505,"_5":13150,"_26023":47416,"_2643":47506},[],"`enable_replaceable_enrollment`",{"_3144":877,"_27488":838,"_19100":47508,"_5":13150,"_26023":47416,"_2643":47509},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3144":878,"_27488":838,"_19100":47511,"_5":13150,"_26023":47416,"_2643":47512},[],"`est_rfc7030_settings.auth_mode`",{"_3144":879,"_27488":838,"_19100":47514,"_5":13150,"_26023":47416,"_2643":47515},[],"One of the four authentication modes.",{"_3144":880,"_27488":838,"_19100":47517,"_5":13150,"_26023":47416,"_2643":47518},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3144":881,"_27488":838,"_19100":47520,"_5":13150,"_26023":47420,"_2643":47521},[],"The blocks are independent:",{"_3144":882,"_27488":838,"_19100":47523,"_5":13150,"_26023":47420,"_2643":47524},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3144":883,"_27488":838,"_19100":47526,"_5":13150,"_26023":47420,"_2643":47527},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3144":884,"_27488":838,"_19100":47529,"_5":13150,"_26023":47420,"_2643":47530},[],"`auth_mode`",{"_3144":885,"_27488":838,"_19100":47532,"_5":13150,"_26023":47420,"_2643":47533},[],"Control applied in the configured operation",{"_3144":886,"_27488":838,"_19100":47535,"_5":13150,"_26023":47420,"_2643":47536},[],"`CLIENT_CERTIFICATE`",{"_3144":887,"_27488":838,"_19100":47538,"_5":13150,"_26023":47420,"_2643":47539},[],"Presented certificate validation.",{"_3144":888,"_27488":838,"_19100":47541,"_5":13150,"_26023":47420,"_2643":47542},[],"`EXTERNAL_WEBHOOK`",{"_3144":889,"_27488":838,"_19100":47544,"_5":13150,"_26023":47420,"_2643":47545},[],"Configured webhook authorization.",{"_3144":890,"_27488":838,"_19100":47547,"_5":13150,"_26023":47420,"_2643":47548},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3144":891,"_27488":838,"_19100":47550,"_5":13150,"_26023":47420,"_2643":47551},[],"Certificate validation followed by webhook approval.",{"_3144":892,"_27488":838,"_19100":47553,"_5":13150,"_26023":47420,"_2643":47554},[],"`NO_AUTH`",{"_3144":893,"_27488":838,"_19100":47556,"_5":13150,"_26023":47420,"_2643":47557},[],"No DMS requester authentication.",{"_3144":894,"_27488":838,"_19100":47559,"_5":13150,"_26023":47420,"_2643":47560},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3144":895,"_27488":838,"_19100":47562,"_5":13150,"_26023":47420,"_2643":47563},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3144":896,"_27488":838,"_19100":47565,"_5":13150,"_26023":47420,"_2643":47566},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3144":897,"_27488":838,"_19100":47568,"_5":13150,"_26023":47420,"_2643":47569},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3144":898,"_27488":838,"_19100":47571,"_5":13150,"_26023":47424,"_2643":47572},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3144":899,"_27488":838,"_19100":47574,"_5":13150,"_26023":47424,"_2643":47575},[],"`external_webhook_settings` field",{"_3144":900,"_27488":838,"_19100":47577,"_5":13150,"_26023":47424,"_2643":47485},[],{"_3144":901,"_27488":838,"_19100":47579,"_5":13150,"_26023":47424,"_2643":47580},[],"`url`",{"_3144":902,"_27488":838,"_19100":47582,"_5":13150,"_26023":47424,"_2643":47583},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3144":903,"_27488":838,"_19100":47585,"_5":13150,"_26023":47424,"_2643":47586},[],"`method`",{"_3144":904,"_27488":838,"_19100":47588,"_5":13150,"_26023":47424,"_2643":47589},[],"`POST` or `PUT`; `POST` by default.",{"_3144":905,"_27488":838,"_19100":47591,"_5":13150,"_26023":47424,"_2643":47592},[],"`name`",{"_3144":906,"_27488":838,"_19100":47594,"_5":13150,"_26023":47424,"_2643":47595},[],"Label used in service logs.",{"_3144":907,"_27488":838,"_19100":47597,"_5":13150,"_26023":47424,"_2643":47598},[],"`config.auth_mode`",{"_3144":908,"_27488":838,"_19100":47600,"_5":13150,"_26023":47424,"_2643":47601},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3144":909,"_27488":838,"_19100":47603,"_5":13150,"_26023":47424,"_2643":47604},[],"`config.apikey_options`",{"_3144":910,"_27488":838,"_19100":47606,"_5":13150,"_26023":47424,"_2643":47607},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3144":911,"_27488":838,"_19100":47609,"_5":13150,"_26023":47424,"_2643":47610},[],"`config.jwt_options`",{"_3144":912,"_27488":838,"_19100":47612,"_5":13150,"_26023":47424,"_2643":47613},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3144":913,"_27488":838,"_19100":47615,"_5":13150,"_26023":47424,"_2643":47616},[],"`config.mtls_options`",{"_3144":914,"_27488":838,"_19100":47618,"_5":13150,"_26023":47424,"_2643":47619},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3144":915,"_27488":838,"_19100":47621,"_5":13150,"_26023":47424,"_2643":47622},[],"`config.insecure_skip_verify`",{"_3144":916,"_27488":838,"_19100":47624,"_5":13150,"_26023":47424,"_2643":47625},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3144":917,"_27488":838,"_19100":47627,"_5":13150,"_26023":47424,"_2643":47628},[],"`config.call_timeout`",{"_3144":918,"_27488":838,"_19100":47630,"_5":13150,"_26023":47424,"_2643":47631},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3144":919,"_27488":838,"_19100":47633,"_5":13150,"_26023":47424,"_2643":47634},[],"Rules for that configuration:",{"_3144":920,"_27488":838,"_19100":47636,"_5":13150,"_26023":47424,"_2643":47637},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3144":921,"_27488":838,"_19100":47639,"_5":13150,"_26023":47424,"_2643":47640},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3144":922,"_27488":838,"_19100":47642,"_5":13150,"_26023":47424,"_2643":47643},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3144":923,"_27488":838,"_19100":47645,"_5":13150,"_26023":47424,"_2643":47646},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3144":924,"_27488":838,"_19100":47648,"_5":13150,"_26023":47424,"_2643":47649},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3144":925,"_27488":838,"_19100":47651,"_5":13150,"_26023":47424,"_2643":47652},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3144":926,"_27488":838,"_19100":47654,"_5":13150,"_26023":47424,"_2643":47655},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_3144":927,"_27488":838,"_19100":47657,"_5":13150,"_26023":47424,"_2643":47658},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3144":928,"_27488":838,"_19100":47660,"_5":13150,"_26023":47424,"_2643":47661},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3144":929,"_27488":838,"_19100":47663,"_5":13150,"_26023":47428,"_2643":47664},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3144":930,"_27488":838,"_19100":47666,"_5":13150,"_26023":47432,"_2643":47667},[],"`settings.reenrollment_settings` field",{"_3144":931,"_27488":838,"_19100":47669,"_5":13150,"_26023":47432,"_2643":45154},[],{"_3144":932,"_27488":838,"_19100":47671,"_5":13150,"_26023":47432,"_2643":47672},[],"`reenrollment_delta`",{"_3144":933,"_27488":838,"_19100":47674,"_5":13150,"_26023":47432,"_2643":47675},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3144":934,"_27488":838,"_19100":47677,"_5":13150,"_26023":47432,"_2643":47678},[],"`preventive_delta`",{"_3144":935,"_27488":838,"_19100":47680,"_5":13150,"_26023":47432,"_2643":47681},[],"Preventive operational monitoring threshold.",{"_3144":936,"_27488":838,"_19100":47683,"_5":13150,"_26023":47432,"_2643":47684},[],"`critical_delta`",{"_3144":937,"_27488":838,"_19100":47686,"_5":13150,"_26023":47432,"_2643":47687},[],"Critical operational monitoring threshold.",{"_3144":938,"_27488":838,"_19100":47689,"_5":13150,"_26023":47432,"_2643":47690},[],"`enable_expired_renewal`",{"_3144":939,"_27488":838,"_19100":47692,"_5":13150,"_26023":47432,"_2643":47693},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3144":940,"_27488":838,"_19100":47695,"_5":13150,"_26023":47432,"_2643":47696},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3144":941,"_27488":838,"_19100":47698,"_5":13150,"_26023":47432,"_2643":47699},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_3144":942,"_27488":838,"_19100":47701,"_5":13150,"_26023":47432,"_2643":47702},[],"`revoke_on_reenrollment`",{"_3144":943,"_27488":838,"_19100":47704,"_5":13150,"_26023":47432,"_2643":47705},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3144":944,"_27488":838,"_19100":47707,"_5":13150,"_26023":47432,"_2643":47708},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3144":945,"_27488":838,"_19100":47710,"_5":13150,"_26023":47436,"_2643":47711},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3144":946,"_27488":838,"_19100":47713,"_5":13150,"_26023":47440,"_2643":45148},[],{"_3144":947,"_27488":838,"_19100":47715,"_5":13150,"_26023":47440,"_2643":47716},[],"Published material",{"_3144":948,"_27488":838,"_19100":47718,"_5":13150,"_26023":47440,"_2643":47719},[],"**Include Lamassu System CA**",{"_3144":949,"_27488":838,"_19100":47721,"_5":13150,"_26023":47440,"_2643":47722},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3144":950,"_27488":838,"_19100":47724,"_5":13150,"_26023":47440,"_2643":47725},[],"**Include Enrollment CA**",{"_3144":951,"_27488":838,"_19100":47727,"_5":13150,"_26023":47440,"_2643":47728},[],"Selected issuing CA certificate.",{"_3144":952,"_27488":838,"_19100":47730,"_5":13150,"_26023":47440,"_2643":47731},[],"**Managed CAs**",{"_3144":953,"_27488":838,"_19100":47733,"_5":13150,"_26023":47440,"_2643":47734},[],"Explicitly selected CA certificates.",{"_3144":954,"_27488":838,"_19100":47736,"_5":13150,"_26023":47440,"_2643":47737},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3144":955,"_27488":838,"_19100":47739,"_5":13150,"_26023":47444,"_2643":47740},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3144":956,"_27488":838,"_19100":47742,"_5":13150,"_26023":47444,"_2643":47743},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3144":957,"_27488":838,"_19100":47745,"_5":13150,"_26023":47444,"_2643":47746},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3144":958,"_27488":838,"_19100":47748,"_5":13150,"_26023":47448,"_2643":47749},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3144":959,"_27488":959,"_5":13476,"_2643":47751,"_27831":47752,"_19100":47753,"_26023":959},"Integrate the EST client",[44764,46144,47118,47116,47299],[],{"_3144":960,"_27488":959,"_19100":47755,"_5":13150,"_26023":959,"_2643":47756},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3144":961,"_27488":959,"_5":27828,"_19100":47758,"_26023":47759,"_2643":44774},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3144":962,"_27488":959,"_5":27828,"_19100":47761,"_26023":47762,"_2643":47763},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3144":963,"_27488":959,"_5":27828,"_19100":47765,"_26023":47766,"_2643":47767},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3144":964,"_27488":959,"_5":27828,"_19100":47769,"_26023":47770,"_2643":47771},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3144":965,"_27488":959,"_5":27828,"_19100":47773,"_26023":47774,"_2643":47775},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3144":966,"_27488":959,"_5":27828,"_19100":47777,"_26023":47778,"_2643":47779},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3144":967,"_27488":959,"_19100":47781,"_5":13150,"_26023":959,"_2643":47782},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3144":968,"_27488":959,"_19100":47784,"_5":13150,"_26023":47759,"_2643":47785},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3144":969,"_27488":959,"_19100":47787,"_5":13150,"_26023":47759,"_2643":47788},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3144":970,"_27488":959,"_19100":47790,"_5":13150,"_26023":47759,"_2643":47791},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3144":971,"_27488":959,"_19100":47793,"_5":13150,"_26023":47762,"_2643":47794},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3144":972,"_27488":959,"_19100":47796,"_5":13150,"_26023":47762,"_2643":47797},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3144":973,"_27488":959,"_19100":47799,"_5":13150,"_26023":47766,"_2643":47800},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3144":974,"_27488":959,"_19100":47802,"_5":13150,"_26023":47766,"_2643":47803},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3144":975,"_27488":959,"_19100":47805,"_5":13150,"_26023":47770,"_2643":47806},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3144":976,"_27488":959,"_19100":47808,"_5":13150,"_26023":47770,"_2643":47809},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3144":977,"_27488":959,"_19100":47811,"_5":13150,"_26023":47774,"_2643":47812},[],"For a root that issues directly:",{"_3144":978,"_27488":959,"_19100":47814,"_5":13150,"_26023":47774,"_2643":47815},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3144":979,"_27488":959,"_19100":47817,"_5":13150,"_26023":47774,"_2643":47818},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3144":980,"_27488":959,"_19100":47820,"_5":13150,"_26023":47778,"_2643":47821},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3144":981,"_27488":981,"_5":13476,"_2643":47823,"_27831":47824,"_19100":47825,"_26023":981},"EST reference",[44764,46144,47118,47116,47299],[],{"_3144":982,"_27488":981,"_19100":47827,"_5":13150,"_26023":981,"_2643":47828},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3144":983,"_27488":981,"_5":27828,"_19100":47830,"_26023":47831,"_2643":47832},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3144":984,"_27488":981,"_5":27828,"_19100":47834,"_26023":47835,"_2643":20755},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3144":985,"_27488":981,"_5":27828,"_19100":47837,"_26023":47838,"_2643":23790},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3144":986,"_27488":981,"_5":27828,"_19100":47840,"_26023":47841,"_2643":23797},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3144":987,"_27488":981,"_5":27828,"_19100":47843,"_26023":47844,"_2643":23143},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3144":988,"_27488":981,"_5":27828,"_19100":47846,"_26023":47847,"_2643":47848},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3144":989,"_27488":981,"_5":27828,"_19100":47850,"_26023":47851,"_2643":47852},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3144":990,"_27488":981,"_5":27828,"_19100":47854,"_26023":47855,"_2643":47856},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3144":991,"_27488":981,"_19100":47858,"_5":13150,"_26023":981,"_2643":47859},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3144":992,"_27488":981,"_19100":47861,"_5":13150,"_26023":47831,"_2643":47862},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3144":993,"_27488":981,"_19100":47864,"_5":13150,"_26023":47831,"_2643":47865},[],"Operation",{"_3144":994,"_27488":981,"_19100":47867,"_5":13150,"_26023":47831,"_2643":47868},[],"Method",{"_3144":995,"_27488":981,"_19100":47870,"_5":13150,"_26023":47831,"_2643":47871},[],"Authentication and condition",{"_3144":996,"_27488":981,"_19100":47873,"_5":13150,"_26023":47831,"_2643":47874},[],"`/cacerts`",{"_3144":997,"_27488":981,"_19100":47876,"_5":13150,"_26023":47831,"_2643":47877},[],"GET",{"_3144":998,"_27488":981,"_19100":47879,"_5":13150,"_26023":47831,"_2643":47880},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3144":999,"_27488":981,"_19100":47882,"_5":13150,"_26023":47831,"_2643":47883},[],"`/simpleenroll`",{"_3144":1000,"_27488":981,"_19100":47885,"_5":13150,"_26023":47831,"_2643":47886},[],"POST",{"_3144":1001,"_27488":981,"_19100":47888,"_5":13150,"_26023":47831,"_2643":47889},[],"Initial authentication and DMS registration/replacement policy.",{"_3144":1002,"_27488":981,"_19100":47891,"_5":13150,"_26023":47831,"_2643":47892},[],"`/simplereenroll`",{"_3144":1003,"_27488":981,"_19100":47894,"_5":13150,"_26023":47831,"_2643":47886},[],{"_3144":1004,"_27488":981,"_19100":47896,"_5":13150,"_26023":47831,"_2643":47897},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3144":1005,"_27488":981,"_19100":47899,"_5":13150,"_26023":47831,"_2643":47900},[],"`/serverkeygen`",{"_3144":1006,"_27488":981,"_19100":47902,"_5":13150,"_26023":47831,"_2643":47886},[],{"_3144":1007,"_27488":981,"_19100":47904,"_5":13150,"_26023":47831,"_2643":47905},[],"Initial authentication and admission; server generation enabled.",{"_3144":1008,"_27488":981,"_19100":47907,"_5":13150,"_26023":47831,"_2643":47908},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3144":1009,"_27488":981,"_19100":47910,"_5":13150,"_26023":47835,"_2643":47911},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3144":1010,"_27488":981,"_19100":47913,"_5":13150,"_26023":47835,"_2643":47914},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3144":1011,"_27488":981,"_19100":47916,"_5":13150,"_26023":47838,"_2643":47917},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3144":1012,"_27488":981,"_19100":47919,"_5":13150,"_26023":47838,"_2643":47920},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3144":1013,"_27488":981,"_19100":47922,"_5":13150,"_26023":47841,"_2643":47923},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3144":1014,"_27488":981,"_19100":47925,"_5":13150,"_26023":47841,"_2643":47926},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3144":1015,"_27488":981,"_19100":47928,"_5":13150,"_26023":47844,"_2643":47929},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3144":1016,"_27488":981,"_19100":47931,"_5":13150,"_26023":47844,"_2643":47932},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3144":1017,"_27488":981,"_19100":47934,"_5":13150,"_26023":47847,"_2643":47935},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3144":1018,"_27488":981,"_19100":47937,"_5":13150,"_26023":47847,"_2643":47938},[],"Part",{"_3144":1019,"_27488":981,"_19100":47940,"_5":13150,"_26023":47847,"_2643":47941},[],"Content after decoding its Base64",{"_3144":1020,"_27488":981,"_19100":47943,"_5":13150,"_26023":47847,"_2643":47944},[],"`application/pkcs8`",{"_3144":1021,"_27488":981,"_19100":47946,"_5":13150,"_26023":47847,"_2643":47947},[],"Unencrypted DER PKCS#8 private key.",{"_3144":1022,"_27488":981,"_19100":47949,"_5":13150,"_26023":47847,"_2643":47950},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3144":1023,"_27488":981,"_19100":47952,"_5":13150,"_26023":47847,"_2643":47953},[],"DER PKCS#7 containing the issued certificate.",{"_3144":1024,"_27488":981,"_19100":47955,"_5":13150,"_26023":47847,"_2643":47956},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3144":1025,"_27488":981,"_19100":47958,"_5":13150,"_26023":47851,"_2643":47959},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3144":1026,"_27488":981,"_19100":47961,"_5":13150,"_26023":47851,"_2643":47962},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3144":1027,"_27488":981,"_19100":47964,"_5":13150,"_26023":47851,"_2643":47965},[],"Convert and check the result:",{"_3144":1028,"_27488":981,"_19100":47967,"_5":13150,"_26023":47851,"_2643":47968},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3144":1029,"_27488":981,"_19100":47970,"_5":13150,"_26023":47855,"_2643":47971},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3144":1030,"_27488":981,"_19100":47973,"_5":13150,"_26023":47855,"_2643":47974},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3144":1031,"_27488":1031,"_5":13476,"_2643":47299,"_27831":47976,"_19100":47977,"_26023":1031},[44764,46144,47118,47116,47299],[],{"_3144":1032,"_27488":1031,"_19100":47979,"_5":13150,"_26023":1031,"_2643":47980},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3144":1033,"_27488":1031,"_5":27828,"_19100":47982,"_26023":47983,"_2643":47984},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3144":1034,"_27488":1031,"_5":27828,"_19100":47986,"_26023":47987,"_2643":47988},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3144":1035,"_27488":1031,"_5":27828,"_19100":47990,"_26023":47991,"_2643":47992},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3144":1036,"_27488":1031,"_5":27828,"_19100":47994,"_26023":47995,"_2643":47996},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3144":1037,"_27488":1031,"_19100":47998,"_5":13150,"_26023":1031,"_2643":47999},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3144":1038,"_27488":1031,"_19100":48001,"_5":13150,"_26023":47983,"_2643":48002},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3144":1039,"_27488":1031,"_19100":48004,"_5":13150,"_26023":47983,"_2643":48005},[],"The integrator installs initial EST server trust and an admission credential.",{"_3144":1040,"_27488":1031,"_19100":48007,"_5":13150,"_26023":47983,"_2643":48008},[],"The client requests an identity for its `Device ID` through EST.",{"_3144":1041,"_27488":1031,"_19100":48010,"_5":13150,"_26023":47983,"_2643":48011},[],"Certificate, device binding and key/certificate installation are checked.",{"_3144":1042,"_27488":1031,"_19100":48013,"_5":13150,"_26023":47983,"_2643":48014},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3144":1043,"_27488":1031,"_19100":48016,"_5":13150,"_26023":47983,"_2643":48017},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3144":1044,"_27488":1031,"_19100":48019,"_5":13150,"_26023":47987,"_2643":48020},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3144":1045,"_27488":1031,"_19100":48022,"_5":13150,"_26023":47987,"_2643":48023},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3144":1046,"_27488":1031,"_19100":48025,"_5":13150,"_26023":47987,"_2643":48026},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3144":1047,"_27488":1031,"_19100":48028,"_5":13150,"_26023":47987,"_2643":48029},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3144":1048,"_27488":1031,"_19100":48031,"_5":13150,"_26023":47991,"_2643":48032},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3144":1049,"_27488":1031,"_19100":48034,"_5":13150,"_26023":47991,"_2643":48035},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3144":1050,"_27488":1031,"_19100":48037,"_5":13150,"_26023":47991,"_2643":48038},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3144":1051,"_27488":1031,"_19100":48040,"_5":13150,"_26023":47991,"_2643":48041},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3144":1052,"_27488":1031,"_19100":48043,"_5":13150,"_26023":47995,"_2643":48044},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3144":1053,"_27488":1031,"_19100":48046,"_5":13150,"_26023":47995,"_2643":48047},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3144":1054,"_27488":1054,"_5":13476,"_2643":48049,"_27831":48050,"_19100":48051,"_26023":1054},"Provisioning strategies",[44764,46144,47118,47116,47299],[],{"_3144":1055,"_27488":1054,"_19100":48053,"_5":13150,"_26023":1054,"_2643":48054},[],"Choose device registration, identity authorization and key generation.",{"_3144":1056,"_27488":1054,"_5":27828,"_19100":48056,"_26023":48057,"_2643":48058},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3144":1057,"_27488":1054,"_5":27828,"_19100":48060,"_26023":48061,"_2643":48062},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3144":1058,"_27488":1054,"_5":27828,"_19100":48064,"_26023":48065,"_2643":48066},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3144":1059,"_27488":1054,"_5":27828,"_19100":48068,"_26023":48069,"_2643":48070},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3144":1060,"_27488":1054,"_5":27828,"_19100":48072,"_26023":48073,"_2643":48074},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3144":1061,"_27488":1054,"_19100":48076,"_5":13150,"_26023":1054,"_2643":48077},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3144":1062,"_27488":1054,"_19100":48079,"_5":13150,"_26023":48057,"_2643":48080},[],"Path",{"_3144":1063,"_27488":1054,"_19100":48082,"_5":13150,"_26023":48057,"_2643":48083},[],"When the device exists",{"_3144":1064,"_27488":1054,"_19100":48085,"_5":13150,"_26023":48057,"_2643":48086},[],"What to check",{"_3144":1065,"_27488":1054,"_19100":48088,"_5":13150,"_26023":48057,"_2643":48089},[],"Manual assignment",{"_3144":1066,"_27488":1054,"_19100":48091,"_5":13150,"_26023":48057,"_2643":48092},[],"An operator creates it before associating a certificate.",{"_3144":1067,"_27488":1054,"_19100":48094,"_5":13150,"_26023":48057,"_2643":48095},[],"ID, owning DMS, certificate CN and bound serial.",{"_3144":1068,"_27488":1054,"_19100":48097,"_5":13150,"_26023":48057,"_2643":48098},[],"EST with `JITP`",{"_3144":1069,"_27488":1054,"_19100":48100,"_5":13150,"_26023":48057,"_2643":48101},[],"Created for an unknown CN during `/simpleenroll`.",{"_3144":1070,"_27488":1054,"_19100":48103,"_5":13150,"_26023":48057,"_2643":48104},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3144":1071,"_27488":1054,"_19100":48106,"_5":13150,"_26023":48057,"_2643":48107},[],"EST with `PRE_REGISTRATION`",{"_3144":1072,"_27488":1054,"_19100":48109,"_5":13150,"_26023":48057,"_2643":48110},[],"Must exist before `/simpleenroll`.",{"_3144":1073,"_27488":1054,"_19100":48112,"_5":13150,"_26023":48057,"_2643":48113},[],"Approved record, same DMS and replacement conditions for your version.",{"_3144":1074,"_27488":1054,"_19100":48115,"_5":13150,"_26023":48057,"_2643":48116},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3144":1075,"_27488":1054,"_19100":48118,"_5":13150,"_26023":48057,"_2643":48119},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3144":1076,"_27488":1054,"_19100":48121,"_5":13150,"_26023":48061,"_2643":48122},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3144":1077,"_27488":1054,"_19100":48124,"_5":13150,"_26023":48061,"_2643":48125},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3144":1078,"_27488":1054,"_19100":48127,"_5":13150,"_26023":48061,"_2643":48128},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3144":1079,"_27488":1054,"_19100":48130,"_5":13150,"_26023":48065,"_2643":48131},[],"Decide initial enrollment and re-enrollment separately:",{"_3144":1080,"_27488":1054,"_19100":48133,"_5":13150,"_26023":48065,"_2643":48134},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3144":1081,"_27488":1054,"_19100":48136,"_5":13150,"_26023":48065,"_2643":48137},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3144":1082,"_27488":1054,"_19100":48139,"_5":13150,"_26023":48065,"_2643":48140},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3144":1083,"_27488":1054,"_19100":48142,"_5":13150,"_26023":48065,"_2643":48143},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3144":1084,"_27488":1054,"_19100":48145,"_5":13150,"_26023":48065,"_2643":48146},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3144":1085,"_27488":1054,"_19100":48148,"_5":13150,"_26023":48069,"_2643":45148},[],{"_3144":1086,"_27488":1054,"_19100":48150,"_5":13150,"_26023":48069,"_2643":48151},[],"Material crossing EST",{"_3144":1087,"_27488":1054,"_19100":48153,"_5":13150,"_26023":48069,"_2643":48154},[],"Device-generated key",{"_3144":1088,"_27488":1054,"_19100":48156,"_5":13150,"_26023":48069,"_2643":48157},[],"Public CSR and certificate; the key stays on the client.",{"_3144":1089,"_27488":1054,"_19100":48159,"_5":13150,"_26023":48069,"_2643":48160},[],"Existing device key",{"_3144":1090,"_27488":1054,"_19100":48162,"_5":13150,"_26023":48069,"_2643":48163},[],"CSR signed with that key and a new certificate.",{"_3144":1091,"_27488":1054,"_19100":48165,"_5":13150,"_26023":48069,"_2643":47437},[],{"_3144":1092,"_27488":1054,"_19100":48167,"_5":13150,"_26023":48069,"_2643":48168},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3144":1093,"_27488":1054,"_19100":48170,"_5":13150,"_26023":48069,"_2643":48171},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3144":1094,"_27488":1054,"_19100":48173,"_5":13150,"_26023":48073,"_2643":48174},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3144":1095,"_27488":1095,"_5":13476,"_2643":48176,"_27831":48177,"_19100":48178,"_26023":1095},"Renewal and recovery",[44764,46144,47118,47116,47299],[],{"_3144":1096,"_27488":1095,"_19100":48180,"_5":13150,"_26023":1095,"_2643":48181},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3144":1097,"_27488":1095,"_5":27828,"_19100":48183,"_26023":48184,"_2643":48185},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3144":1098,"_27488":1095,"_5":27828,"_19100":48187,"_26023":48188,"_2643":48189},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3144":1099,"_27488":1095,"_5":27828,"_19100":48191,"_26023":48192,"_2643":48193},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3144":1100,"_27488":1095,"_5":27828,"_19100":48195,"_26023":48196,"_2643":48197},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3144":1101,"_27488":1095,"_5":27828,"_19100":48199,"_26023":48200,"_2643":48201},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3144":1102,"_27488":1095,"_19100":48203,"_5":13150,"_26023":1095,"_2643":48204},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3144":1103,"_27488":1095,"_19100":48206,"_5":13150,"_26023":48184,"_2643":48207},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3144":1104,"_27488":1095,"_19100":48209,"_5":13150,"_26023":48184,"_2643":48210},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3144":1105,"_27488":1095,"_19100":48212,"_5":13150,"_26023":48184,"_2643":48213},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3144":1106,"_27488":1095,"_19100":48215,"_5":13150,"_26023":48184,"_2643":48216},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3144":1107,"_27488":1095,"_19100":48218,"_5":13150,"_26023":48188,"_2643":48219},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3144":1108,"_27488":1095,"_19100":48221,"_5":13150,"_26023":48188,"_2643":48222},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3144":1109,"_27488":1095,"_19100":48224,"_5":13150,"_26023":48192,"_2643":48225},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3144":1110,"_27488":1095,"_19100":48227,"_5":13150,"_26023":48192,"_2643":48228},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3144":1111,"_27488":1095,"_19100":48230,"_5":13150,"_26023":48192,"_2643":48231},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3144":1112,"_27488":1095,"_19100":48233,"_5":13150,"_26023":48196,"_2643":48234},[],"Situation",{"_3144":1113,"_27488":1095,"_19100":48236,"_5":13150,"_26023":48196,"_2643":48237},[],"Procedure",{"_3144":1114,"_27488":1095,"_19100":48239,"_5":13150,"_26023":48196,"_2643":48240},[],"Valid certificate, outside the window",{"_3144":1115,"_27488":1095,"_19100":48242,"_5":13150,"_26023":48196,"_2643":48243},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3144":1116,"_27488":1095,"_19100":48245,"_5":13150,"_26023":48196,"_2643":48246},[],"Expired certificate, key available",{"_3144":1117,"_27488":1095,"_19100":48248,"_5":13150,"_26023":48196,"_2643":48249},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3144":1118,"_27488":1095,"_19100":48251,"_5":13150,"_26023":48196,"_2643":48252},[],"Renewal through webhook or `NO_AUTH`",{"_3144":1119,"_27488":1095,"_19100":48254,"_5":13150,"_26023":48196,"_2643":48255},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3144":1120,"_27488":1095,"_19100":48257,"_5":13150,"_26023":48196,"_2643":48258},[],"Lost or inaccessible key",{"_3144":1121,"_27488":1095,"_19100":48260,"_5":13150,"_26023":48196,"_2643":48261},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3144":1122,"_27488":1095,"_19100":48263,"_5":13150,"_26023":48196,"_2643":48264},[],"Current identity revoked",{"_3144":1123,"_27488":1095,"_19100":48266,"_5":13150,"_26023":48196,"_2643":48267},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3144":1124,"_27488":1095,"_19100":48269,"_5":13150,"_26023":48196,"_2643":48270},[],"Device without an identity",{"_3144":1125,"_27488":1095,"_19100":48272,"_5":13150,"_26023":48196,"_2643":48273},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3144":1126,"_27488":1095,"_19100":48275,"_5":13150,"_26023":48196,"_2643":48276},[],"Retired device",{"_3144":1127,"_27488":1095,"_19100":48278,"_5":13150,"_26023":48196,"_2643":48279},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3144":1128,"_27488":1095,"_19100":48281,"_5":13150,"_26023":48196,"_2643":48282},[],"Timeout, HTTP 500 or installation failure",{"_3144":1129,"_27488":1095,"_19100":48284,"_5":13150,"_26023":48196,"_2643":48285},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3144":1130,"_27488":1095,"_19100":48287,"_5":13150,"_26023":48200,"_2643":48288},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3144":1131,"_27488":1095,"_19100":48290,"_5":13150,"_26023":48200,"_2643":48291},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3144":1132,"_27488":1132,"_5":13476,"_2643":48293,"_27831":48294,"_19100":48295,"_26023":1132},"Enrollment troubleshooting",[44764,46144,47118,47116,47299],[],{"_3144":1133,"_27488":1132,"_19100":48297,"_5":13150,"_26023":1132,"_2643":48298},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3144":1134,"_27488":1132,"_5":27828,"_19100":48300,"_26023":48301,"_2643":48302},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3144":1135,"_27488":1132,"_5":27828,"_19100":48304,"_26023":48305,"_2643":48306},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3144":1136,"_27488":1132,"_5":27828,"_19100":48308,"_26023":48309,"_2643":47856},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3144":1137,"_27488":1132,"_5":27828,"_19100":48311,"_26023":48312,"_2643":48313},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3144":1138,"_27488":1132,"_19100":48315,"_5":13150,"_26023":1132,"_2643":48316},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3144":1139,"_27488":1132,"_19100":48318,"_5":13150,"_26023":48305,"_2643":48319},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3144":1140,"_27488":1132,"_19100":48321,"_5":13150,"_26023":48305,"_2643":48322},[],"Symptom or message",{"_3144":1141,"_27488":1132,"_19100":48324,"_5":13150,"_26023":48305,"_2643":48086},[],{"_3144":1142,"_27488":1132,"_19100":48326,"_5":13150,"_26023":48305,"_2643":48327},[],"curl rejects TLS, name or issuer",{"_3144":1143,"_27488":1132,"_19100":48329,"_5":13150,"_26023":48305,"_2643":48330},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3144":1144,"_27488":1132,"_19100":48332,"_5":13150,"_26023":48305,"_2643":48333},[],"404 or missing APS",{"_3144":1145,"_27488":1132,"_19100":48335,"_5":13150,"_26023":48305,"_2643":48336},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3144":1146,"_27488":1132,"_19100":48338,"_5":13150,"_26023":48305,"_2643":48339},[],"400, CSR or format error",{"_3144":1147,"_27488":1132,"_19100":48341,"_5":13150,"_26023":48305,"_2643":48342},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3144":1148,"_27488":1132,"_19100":48344,"_5":13150,"_26023":48305,"_2643":48345},[],"Missing credential or invalid certificate",{"_3144":1149,"_27488":1132,"_19100":48347,"_5":13150,"_26023":48305,"_2643":48348},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3144":1150,"_27488":1132,"_19100":48350,"_5":13150,"_26023":48305,"_2643":48351},[],"Webhook denies, times out or responds without authorization",{"_3144":1151,"_27488":1132,"_19100":48353,"_5":13150,"_26023":48305,"_2643":48354},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3144":1152,"_27488":1132,"_19100":48356,"_5":13150,"_26023":48305,"_2643":48357},[],"`unexpected status code: <n>: redirects are not followed`",{"_3144":1153,"_27488":1132,"_19100":48359,"_5":13150,"_26023":48305,"_2643":48360},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3144":1154,"_27488":1132,"_19100":48362,"_5":13150,"_26023":48305,"_2643":48363},[],"`webhook response exceeds 1048576 bytes`",{"_3144":1155,"_27488":1132,"_19100":48365,"_5":13150,"_26023":48305,"_2643":48366},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3144":1156,"_27488":1132,"_19100":48368,"_5":13150,"_26023":48305,"_2643":48369},[],"`webhook config must not reference files`",{"_3144":1157,"_27488":1132,"_19100":48371,"_5":13150,"_26023":48305,"_2643":48372},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3144":1158,"_27488":1132,"_19100":48374,"_5":13150,"_26023":48305,"_2643":48375},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3144":1159,"_27488":1132,"_19100":48377,"_5":13150,"_26023":48305,"_2643":48378},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3144":1160,"_27488":1132,"_19100":48380,"_5":13150,"_26023":48305,"_2643":48381},[],"`webhook mTLS certificate and key are invalid: …`",{"_3144":1161,"_27488":1132,"_19100":48383,"_5":13150,"_26023":48305,"_2643":48384},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3144":1162,"_27488":1132,"_19100":48386,"_5":13150,"_26023":48305,"_2643":48387},[],"400 `struct validation error` creating or updating a DMS",{"_3144":1163,"_27488":1132,"_19100":48389,"_5":13150,"_26023":48305,"_2643":48390},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3144":1164,"_27488":1132,"_19100":48392,"_5":13150,"_26023":48305,"_2643":48393},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3144":1165,"_27488":1132,"_19100":48395,"_5":13150,"_26023":48305,"_2643":48396},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3144":1166,"_27488":1132,"_19100":48398,"_5":13150,"_26023":48305,"_2643":48399},[],"`device not preregistered`",{"_3144":1167,"_27488":1132,"_19100":48401,"_5":13150,"_26023":48305,"_2643":48402},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3144":1168,"_27488":1132,"_19100":48404,"_5":13150,"_26023":48305,"_2643":48405},[],"`forbiddenNewEnrollment`",{"_3144":1169,"_27488":1132,"_19100":48407,"_5":13150,"_26023":48305,"_2643":48408},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3144":1170,"_27488":1132,"_19100":48410,"_5":13150,"_26023":48305,"_2643":48411},[],"Different owning DMS",{"_3144":1171,"_27488":1132,"_19100":48413,"_5":13150,"_26023":48305,"_2643":48414},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3144":1172,"_27488":1132,"_19100":48416,"_5":13150,"_26023":48305,"_2643":48417},[],"`invalid RawSubject bytes`",{"_3144":1173,"_27488":1132,"_19100":48419,"_5":13150,"_26023":48305,"_2643":48420},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3144":1174,"_27488":1132,"_19100":48422,"_5":13150,"_26023":48305,"_2643":48423},[],"`invalid reenroll window`",{"_3144":1175,"_27488":1132,"_19100":48425,"_5":13150,"_26023":48305,"_2643":48426},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3144":1176,"_27488":1132,"_19100":48428,"_5":13150,"_26023":48305,"_2643":48429},[],"Current certificate revoked",{"_3144":1177,"_27488":1132,"_19100":48431,"_5":13150,"_26023":48305,"_2643":48432},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3144":1178,"_27488":1132,"_19100":48434,"_5":13150,"_26023":48305,"_2643":48435},[],"CA, profile or signing error",{"_3144":1179,"_27488":1132,"_19100":48437,"_5":13150,"_26023":48305,"_2643":48438},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3144":1180,"_27488":1132,"_19100":48440,"_5":13150,"_26023":48305,"_2643":48441},[],"HTTP 200 without a device connection",{"_3144":1181,"_27488":1132,"_19100":48443,"_5":13150,"_26023":48305,"_2643":48444},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3144":1182,"_27488":1132,"_19100":48446,"_5":13150,"_26023":48305,"_2643":48447},[],"Timeout or error after issuance",{"_3144":1183,"_27488":1132,"_19100":48449,"_5":13150,"_26023":48305,"_2643":48450},[],"New certificates, current slot and previous identity's state before retrying.",{"_3144":1184,"_27488":1132,"_19100":48452,"_5":13150,"_26023":48309,"_2643":48453},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3144":1185,"_27488":1132,"_19100":48455,"_5":13150,"_26023":48309,"_2643":48456},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3144":1186,"_27488":1132,"_19100":48458,"_5":13150,"_26023":48312,"_2643":48459},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3144":1187,"_27488":1132,"_19100":48461,"_5":13150,"_26023":48312,"_2643":48462},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3144":1188,"_27488":1132,"_19100":48464,"_5":13150,"_26023":48312,"_2643":48465},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3144":1189,"_27488":1132,"_19100":48467,"_5":13150,"_26023":48312,"_2643":48468},[],"Make one request, save headers/body and query the device and certificates.",{"_3144":1190,"_27488":1132,"_19100":48470,"_5":13150,"_26023":48312,"_2643":48471},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3144":1191,"_27488":1132,"_19100":48473,"_5":13150,"_26023":48312,"_2643":48474},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3144":1192,"_27488":1132,"_19100":48476,"_5":13150,"_26023":48312,"_2643":48477},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3144":1193,"_27488":1193,"_5":13476,"_2643":48479,"_27831":48480,"_19100":48481,"_26023":1193},"Trust distribution and updates",[44764,46144,47118,47116,47299],[],{"_3144":1194,"_27488":1193,"_19100":48483,"_5":13150,"_26023":1193,"_2643":48484},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3144":1195,"_27488":1193,"_5":27828,"_19100":48486,"_26023":48487,"_2643":48488},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3144":1196,"_27488":1193,"_5":27828,"_19100":48490,"_26023":48491,"_2643":48492},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3144":1197,"_27488":1193,"_5":27828,"_19100":48494,"_26023":48495,"_2643":48496},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3144":1198,"_27488":1193,"_5":27828,"_19100":48498,"_26023":48499,"_2643":48500},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3144":1199,"_27488":1193,"_5":27828,"_19100":48502,"_26023":48503,"_2643":48504},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3144":1200,"_27488":1193,"_19100":48506,"_5":13150,"_26023":1193,"_2643":48507},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3144":1201,"_27488":1193,"_19100":48509,"_5":13150,"_26023":48487,"_2643":48510},[],"Relationship",{"_3144":1202,"_27488":1193,"_19100":48512,"_5":13150,"_26023":48487,"_2643":48513},[],"Material prepared by its owner",{"_3144":1203,"_27488":1193,"_19100":48515,"_5":13150,"_26023":48487,"_2643":48516},[],"Device → EST server",{"_3144":1204,"_27488":1193,"_19100":48518,"_5":13150,"_26023":48487,"_2643":48519},[],"Previously verified server root, chain or pin and TLS name.",{"_3144":1205,"_27488":1193,"_19100":48521,"_5":13150,"_26023":48487,"_2643":48522},[],"DMS → requester",{"_3144":1206,"_27488":1193,"_19100":48524,"_5":13150,"_26023":48487,"_2643":48525},[],"CAs and rules authorizing initial or renewal credentials.",{"_3144":1207,"_27488":1193,"_19100":48527,"_5":13150,"_26023":48487,"_2643":48528},[],"Consumer → device",{"_3144":1208,"_27488":1193,"_19100":48530,"_5":13150,"_26023":48487,"_2643":48531},[],"Operational identity roots, intermediates, validation and permissions.",{"_3144":1209,"_27488":1193,"_19100":48533,"_5":13150,"_26023":48487,"_2643":48534},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3144":1210,"_27488":1193,"_19100":48536,"_5":13150,"_26023":48491,"_2643":48537},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3144":1211,"_27488":1193,"_19100":48539,"_5":13150,"_26023":48491,"_2643":48540},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3144":1212,"_27488":1193,"_19100":48542,"_5":13150,"_26023":48495,"_2643":48543},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3144":1213,"_27488":1193,"_19100":48545,"_5":13150,"_26023":48495,"_2643":48546},[],"Select policy-approved roots as anchors.",{"_3144":1214,"_27488":1193,"_19100":48548,"_5":13150,"_26023":48495,"_2643":48549},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3144":1215,"_27488":1193,"_19100":48551,"_5":13150,"_26023":48495,"_2643":48552},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3144":1216,"_27488":1193,"_19100":48554,"_5":13150,"_26023":48495,"_2643":48555},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3144":1217,"_27488":1193,"_19100":48557,"_5":13150,"_26023":48495,"_2643":48558},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3144":1218,"_27488":1193,"_19100":48560,"_5":13150,"_26023":48499,"_2643":48561},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3144":1219,"_27488":1193,"_19100":48563,"_5":13150,"_26023":48499,"_2643":48564},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3144":1220,"_27488":1193,"_19100":48566,"_5":13150,"_26023":48499,"_2643":48567},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3144":1221,"_27488":1193,"_19100":48569,"_5":13150,"_26023":48503,"_2643":48570},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3144":1222,"_27488":1222,"_5":13476,"_2643":48572,"_27831":48573,"_19100":48575,"_26023":1222},"AWS IoT Core",[44764,46144,47118,47116,48574],"Integrations",[],{"_3144":1223,"_27488":1222,"_19100":48577,"_5":13150,"_26023":1222,"_2643":48578},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3144":1224,"_27488":1222,"_5":27828,"_19100":48580,"_26023":48581,"_2643":48582},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3144":1225,"_27488":1222,"_5":27828,"_19100":48584,"_26023":48585,"_2643":48586},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3144":1226,"_27488":1222,"_5":27828,"_19100":48588,"_26023":48589,"_2643":48590},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3144":1227,"_27488":1222,"_5":27828,"_19100":48592,"_26023":48593,"_2643":48594},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3144":1228,"_27488":1222,"_5":27828,"_19100":48596,"_26023":48597,"_2643":48598},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3144":1229,"_27488":1222,"_5":27828,"_19100":48600,"_26023":48601,"_2643":48602},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3144":1230,"_27488":1222,"_5":27828,"_19100":48604,"_26023":48605,"_2643":48606},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3144":1231,"_27488":1222,"_5":27828,"_19100":48608,"_26023":48609,"_2643":48610},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3144":1232,"_27488":1222,"_5":27828,"_19100":48612,"_26023":48613,"_2643":48614},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3144":1233,"_27488":1222,"_5":27828,"_19100":48616,"_26023":48617,"_2643":48618},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3144":1234,"_27488":1222,"_5":27828,"_19100":48620,"_26023":48621,"_2643":48622},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3144":1235,"_27488":1222,"_5":27828,"_19100":48624,"_26023":48625,"_2643":48626},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3144":1236,"_27488":1222,"_5":27828,"_19100":48628,"_26023":48629,"_2643":48630},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3144":1237,"_27488":1222,"_5":27828,"_19100":48632,"_26023":48633,"_2643":48634},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3144":1238,"_27488":1222,"_5":27828,"_19100":48636,"_26023":48637,"_2643":48638},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3144":1239,"_27488":1222,"_5":27828,"_19100":48640,"_26023":48641,"_2643":48642},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3144":1240,"_27488":1222,"_5":27828,"_19100":48644,"_26023":48645,"_2643":48646},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3144":1241,"_27488":1222,"_5":27828,"_19100":48648,"_26023":48649,"_2643":48650},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3144":1242,"_27488":1222,"_5":27828,"_19100":48652,"_26023":48653,"_2643":48654},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3144":1243,"_27488":1222,"_5":27828,"_19100":48656,"_26023":48657,"_2643":48658},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3144":1244,"_27488":1222,"_19100":48660,"_5":13150,"_26023":1222,"_2643":48661},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3144":1245,"_27488":1222,"_19100":48663,"_5":13150,"_26023":1222,"_2643":48664},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3144":1246,"_27488":1222,"_19100":48666,"_5":13150,"_26023":1222,"_2643":48667},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3144":1247,"_27488":1222,"_19100":48669,"_5":13150,"_26023":48581,"_2643":48670},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3144":1248,"_27488":1222,"_19100":48672,"_5":13150,"_26023":48581,"_2643":48673},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3144":1249,"_27488":1222,"_19100":48675,"_5":13150,"_26023":48581,"_2643":48676},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3144":1250,"_27488":1222,"_19100":48678,"_5":13150,"_26023":48581,"_2643":48679},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3144":1251,"_27488":1222,"_19100":48681,"_5":13150,"_26023":48585,"_2643":48682},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3144":1252,"_27488":1222,"_19100":48684,"_5":13150,"_26023":48589,"_2643":48685},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3144":1253,"_27488":1222,"_19100":48687,"_5":13150,"_26023":48589,"_2643":48688},[],"IAM action",{"_3144":1254,"_27488":1222,"_19100":48690,"_5":13150,"_26023":48589,"_2643":45154},[],{"_3144":1255,"_27488":1222,"_19100":48692,"_5":13150,"_26023":48589,"_2643":48693},[],"`iot:GetRegistrationCode`",{"_3144":1256,"_27488":1222,"_19100":48695,"_5":13150,"_26023":48589,"_2643":48696},[],"Obtain the verification code for CA registration in the Primary Account",{"_3144":1257,"_27488":1222,"_19100":48698,"_5":13150,"_26023":48589,"_2643":48699},[],"`iot:RegisterCACertificate`",{"_3144":1258,"_27488":1222,"_19100":48701,"_5":13150,"_26023":48589,"_2643":48702},[],"Register the CA in AWS IoT",{"_3144":1259,"_27488":1222,"_19100":48704,"_5":13150,"_26023":48589,"_2643":48705},[],"`iot:DescribeCACertificate`",{"_3144":1260,"_27488":1222,"_19100":48707,"_5":13150,"_26023":48589,"_2643":48708},[],"Check the CA registration status",{"_3144":1261,"_27488":1222,"_19100":48710,"_5":13150,"_26023":48589,"_2643":48711},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3144":1262,"_27488":1222,"_19100":48713,"_5":13150,"_26023":48589,"_2643":48714},[],"Create or update Things in IoT Core",{"_3144":1263,"_27488":1222,"_19100":48716,"_5":13150,"_26023":48589,"_2643":48717},[],"`iot:RegisterThing`",{"_3144":1264,"_27488":1222,"_19100":48719,"_5":13150,"_26023":48589,"_2643":48720},[],"Provision Things through a template",{"_3144":1265,"_27488":1222,"_19100":48722,"_5":13150,"_26023":48589,"_2643":48723},[],"`iot:RegisterCertificate`",{"_3144":1266,"_27488":1222,"_19100":48725,"_5":13150,"_26023":48589,"_2643":48726},[],"Register device certificates",{"_3144":1267,"_27488":1222,"_19100":48728,"_5":13150,"_26023":48589,"_2643":48729},[],"`iot:UpdateCertificate`",{"_3144":1268,"_27488":1222,"_19100":48731,"_5":13150,"_26023":48589,"_2643":48732},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3144":1269,"_27488":1222,"_19100":48734,"_5":13150,"_26023":48589,"_2643":48735},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3144":1270,"_27488":1222,"_19100":48737,"_5":13150,"_26023":48589,"_2643":48738},[],"Create and attach IoT policies",{"_3144":1271,"_27488":1222,"_19100":48740,"_5":13150,"_26023":48589,"_2643":48741},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3144":1272,"_27488":1222,"_19100":48743,"_5":13150,"_26023":48589,"_2643":48744},[],"Manage Thing groups",{"_3144":1273,"_27488":1222,"_19100":48746,"_5":13150,"_26023":48589,"_2643":48747},[],"`iot:CreateProvisioningTemplate`",{"_3144":1274,"_27488":1222,"_19100":48749,"_5":13150,"_26023":48589,"_2643":48750},[],"Create JITP templates",{"_3144":1275,"_27488":1222,"_19100":48752,"_5":13150,"_26023":48589,"_2643":48753},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3144":1276,"_27488":1222,"_19100":48755,"_5":13150,"_26023":48589,"_2643":48756},[],"Read and write the Device Shadow",{"_3144":1277,"_27488":1222,"_19100":48758,"_5":13150,"_26023":48589,"_2643":48759},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3144":1278,"_27488":1222,"_19100":48761,"_5":13150,"_26023":48593,"_2643":48762},[],"Parameter",{"_3144":1279,"_27488":1222,"_19100":48764,"_5":13150,"_26023":48593,"_2643":48765},[],"Type",{"_3144":1280,"_27488":1222,"_19100":48767,"_5":13150,"_26023":48593,"_2643":48768},[],"Required",{"_3144":1281,"_27488":1222,"_19100":48770,"_5":13150,"_26023":48593,"_2643":48771},[],"Description",{"_3144":1282,"_27488":1222,"_19100":48773,"_5":13150,"_26023":48593,"_2643":48774},[],"`connector_id`",{"_3144":1283,"_27488":1222,"_19100":48776,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1284,"_27488":1222,"_19100":48778,"_5":13150,"_26023":48593,"_2643":48779},[],"Yes",{"_3144":1285,"_27488":1222,"_19100":48781,"_5":13150,"_26023":48593,"_2643":48782},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3144":1286,"_27488":1222,"_19100":48784,"_5":13150,"_26023":48593,"_2643":48785},[],"`aws_config.region`",{"_3144":1287,"_27488":1222,"_19100":48787,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1288,"_27488":1222,"_19100":48789,"_5":13150,"_26023":48593,"_2643":48779},[],{"_3144":1289,"_27488":1222,"_19100":48791,"_5":13150,"_26023":48593,"_2643":48792},[],"AWS region where the connector operates.",{"_3144":1290,"_27488":1222,"_19100":48794,"_5":13150,"_26023":48593,"_2643":48795},[],"`aws_config.auth_method`",{"_3144":1291,"_27488":1222,"_19100":48797,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1292,"_27488":1222,"_19100":48799,"_5":13150,"_26023":48593,"_2643":48779},[],{"_3144":1293,"_27488":1222,"_19100":48801,"_5":13150,"_26023":48593,"_2643":48802},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3144":1294,"_27488":1222,"_19100":48804,"_5":13150,"_26023":48593,"_2643":48805},[],"`aws_config.access_key_id`",{"_3144":1295,"_27488":1222,"_19100":48807,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1296,"_27488":1222,"_19100":48809,"_5":13150,"_26023":48593,"_2643":48810},[],"Only with `auth_method=static`",{"_3144":1297,"_27488":1222,"_19100":48812,"_5":13150,"_26023":48593,"_2643":48813},[],"AWS access key.",{"_3144":1298,"_27488":1222,"_19100":48815,"_5":13150,"_26023":48593,"_2643":48816},[],"`aws_config.secret_access_key`",{"_3144":1299,"_27488":1222,"_19100":48818,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1300,"_27488":1222,"_19100":48820,"_5":13150,"_26023":48593,"_2643":48810},[],{"_3144":1301,"_27488":1222,"_19100":48822,"_5":13150,"_26023":48593,"_2643":48823},[],"AWS secret key.",{"_3144":1302,"_27488":1222,"_19100":48825,"_5":13150,"_26023":48593,"_2643":48826},[],"`aws_config.session_token`",{"_3144":1303,"_27488":1222,"_19100":48828,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1304,"_27488":1222,"_19100":48830,"_5":13150,"_26023":48593,"_2643":48831},[],"No",{"_3144":1305,"_27488":1222,"_19100":48833,"_5":13150,"_26023":48593,"_2643":48834},[],"Session token (with `auth_method=static`).",{"_3144":1306,"_27488":1222,"_19100":48836,"_5":13150,"_26023":48593,"_2643":48837},[],"`aws_config.role_arn`",{"_3144":1307,"_27488":1222,"_19100":48839,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1308,"_27488":1222,"_19100":48841,"_5":13150,"_26023":48593,"_2643":48842},[],"Only with `auth_method=role`",{"_3144":1309,"_27488":1222,"_19100":48844,"_5":13150,"_26023":48593,"_2643":48845},[],"ARN of the role to assume.",{"_3144":1310,"_27488":1222,"_19100":48847,"_5":13150,"_26023":48593,"_2643":48848},[],"`aws_config.endpoint_url`",{"_3144":1311,"_27488":1222,"_19100":48850,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1312,"_27488":1222,"_19100":48852,"_5":13150,"_26023":48593,"_2643":48831},[],{"_3144":1313,"_27488":1222,"_19100":48854,"_5":13150,"_26023":48593,"_2643":48855},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3144":1314,"_27488":1222,"_19100":48857,"_5":13150,"_26023":48593,"_2643":48858},[],"`subscriber_event_bus`",{"_3144":1315,"_27488":1222,"_19100":48860,"_5":13150,"_26023":48593,"_2643":16097},[],{"_3144":1316,"_27488":1222,"_19100":48862,"_5":13150,"_26023":48593,"_2643":48779},[],{"_3144":1317,"_27488":1222,"_19100":48864,"_5":13150,"_26023":48593,"_2643":48865},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3144":1318,"_27488":1222,"_19100":48867,"_5":13150,"_26023":48593,"_2643":48868},[],"`dms_manager_client`",{"_3144":1319,"_27488":1222,"_19100":48870,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1320,"_27488":1222,"_19100":48872,"_5":13150,"_26023":48593,"_2643":48779},[],{"_3144":1321,"_27488":1222,"_19100":48874,"_5":13150,"_26023":48593,"_2643":48875},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3144":1322,"_27488":1222,"_19100":48877,"_5":13150,"_26023":48593,"_2643":48878},[],"`device_manager_client`",{"_3144":1323,"_27488":1222,"_19100":48880,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1324,"_27488":1222,"_19100":48882,"_5":13150,"_26023":48593,"_2643":48779},[],{"_3144":1325,"_27488":1222,"_19100":48884,"_5":13150,"_26023":48593,"_2643":48885},[],"HTTP URL of Lamassu's Device Manager.",{"_3144":1326,"_27488":1222,"_19100":48887,"_5":13150,"_26023":48593,"_2643":48888},[],"`ca_client`",{"_3144":1327,"_27488":1222,"_19100":48890,"_5":13150,"_26023":48593,"_2643":22829},[],{"_3144":1328,"_27488":1222,"_19100":48892,"_5":13150,"_26023":48593,"_2643":48779},[],{"_3144":1329,"_27488":1222,"_19100":48894,"_5":13150,"_26023":48593,"_2643":48895},[],"HTTP URL of Lamassu's CA service.",{"_3144":1330,"_27488":1222,"_19100":48897,"_5":13150,"_26023":48597,"_2643":48898},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3144":1331,"_27488":1222,"_19100":48900,"_5":13150,"_26023":48601,"_2643":48901},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3144":1332,"_27488":1222,"_19100":48903,"_5":13150,"_26023":48601,"_2643":48904},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3144":1333,"_27488":1222,"_19100":48906,"_5":13150,"_26023":48605,"_2643":48907},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3144":1334,"_27488":1222,"_19100":48909,"_5":13150,"_26023":48605,"_2643":48910},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3144":1335,"_27488":1222,"_19100":48912,"_5":13150,"_26023":48605,"_2643":48913},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3144":1336,"_27488":1222,"_19100":48915,"_5":13150,"_26023":48605,"_2643":48916},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3144":1337,"_27488":1222,"_19100":48918,"_5":13150,"_26023":48605,"_2643":48919},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3144":1338,"_27488":1222,"_19100":48921,"_5":13150,"_26023":48605,"_2643":48922},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3144":1339,"_27488":1222,"_19100":48924,"_5":13150,"_26023":48609,"_2643":48925},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3144":1340,"_27488":1222,"_19100":48927,"_5":13150,"_26023":48613,"_2643":48928},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3144":1341,"_27488":1222,"_19100":48930,"_5":13150,"_26023":48613,"_2643":48931},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3144":1342,"_27488":1222,"_19100":48933,"_5":13150,"_26023":48617,"_2643":48934},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3144":1343,"_27488":1222,"_19100":48936,"_5":13150,"_26023":48621,"_2643":48937},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3144":1344,"_27488":1222,"_19100":48939,"_5":13150,"_26023":48621,"_2643":48940},[],"Creates or updates the IoT policies configured in the DMS.",{"_3144":1345,"_27488":1222,"_19100":48942,"_5":13150,"_26023":48621,"_2643":48943},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3144":1346,"_27488":1222,"_19100":48945,"_5":13150,"_26023":48621,"_2643":48946},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3144":1347,"_27488":1222,"_19100":48948,"_5":13150,"_26023":48621,"_2643":48949},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3144":1348,"_27488":1222,"_19100":48951,"_5":13150,"_26023":48621,"_2643":48952},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3144":1349,"_27488":1222,"_19100":48954,"_5":13150,"_26023":48621,"_2643":48955},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3144":1350,"_27488":1222,"_19100":48957,"_5":13150,"_26023":48625,"_2643":48958},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3144":1351,"_27488":1222,"_19100":48960,"_5":13150,"_26023":48625,"_2643":48961},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3144":1352,"_27488":1222,"_19100":48963,"_5":13150,"_26023":48625,"_2643":48964},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3144":1353,"_27488":1222,"_19100":48966,"_5":13150,"_26023":48629,"_2643":48967},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3144":1354,"_27488":1222,"_19100":48969,"_5":13150,"_26023":48629,"_2643":48970},[],"The full flow from the device's perspective is:",{"_3144":1355,"_27488":1222,"_19100":48972,"_5":13150,"_26023":48629,"_2643":48973},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3144":1356,"_27488":1222,"_19100":48975,"_5":13150,"_26023":48633,"_2643":48976},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3144":1357,"_27488":1222,"_19100":48978,"_5":13150,"_26023":48633,"_2643":48979},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3144":1358,"_27488":1222,"_19100":48981,"_5":13150,"_26023":48633,"_2643":48982},[],"For the JITP flow to work correctly:",{"_3144":1359,"_27488":1222,"_19100":48984,"_5":13150,"_26023":48633,"_2643":48985},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3144":1360,"_27488":1222,"_19100":48987,"_5":13150,"_26023":48633,"_2643":48988},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3144":1361,"_27488":1222,"_19100":48990,"_5":13150,"_26023":48633,"_2643":48991},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3144":1362,"_27488":1222,"_19100":48993,"_5":13150,"_26023":48633,"_2643":48994},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3144":1363,"_27488":1222,"_19100":48996,"_5":13150,"_26023":48637,"_2643":48997},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3144":1364,"_27488":1222,"_19100":48999,"_5":13150,"_26023":48637,"_2643":49000},[],"Status in Lamassu",{"_3144":1365,"_27488":1222,"_19100":49002,"_5":13150,"_26023":48637,"_2643":49003},[],"Revocation reason",{"_3144":1366,"_27488":1222,"_19100":49005,"_5":13150,"_26023":48637,"_2643":49006},[],"Status in AWS IoT Core",{"_3144":1367,"_27488":1222,"_19100":49008,"_5":13150,"_26023":48637,"_2643":49009},[],"`Active`",{"_3144":1368,"_27488":1222,"_19100":49011,"_5":13150,"_26023":48637,"_2643":49012},[],"None",{"_3144":1369,"_27488":1222,"_19100":49014,"_5":13150,"_26023":48637,"_2643":49015},[],"`ACTIVE`",{"_3144":1370,"_27488":1222,"_19100":49017,"_5":13150,"_26023":48637,"_2643":49018},[],"`Revoked`",{"_3144":1371,"_27488":1222,"_19100":49020,"_5":13150,"_26023":48637,"_2643":49021},[],"`certificateHold`",{"_3144":1372,"_27488":1222,"_19100":49023,"_5":13150,"_26023":48637,"_2643":49024},[],"`INACTIVE`",{"_3144":1373,"_27488":1222,"_19100":49026,"_5":13150,"_26023":48637,"_2643":49018},[],{"_3144":1374,"_27488":1222,"_19100":49028,"_5":13150,"_26023":48637,"_2643":49029},[],"Any other reason",{"_3144":1375,"_27488":1222,"_19100":49031,"_5":13150,"_26023":48637,"_2643":49032},[],"`REVOKED`",{"_3144":1376,"_27488":1222,"_19100":49034,"_5":13150,"_26023":48637,"_2643":49035},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3144":1377,"_27488":1222,"_19100":49037,"_5":13150,"_26023":48641,"_2643":49038},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3144":1378,"_27488":1222,"_19100":49040,"_5":13150,"_26023":48641,"_2643":49041},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3144":1379,"_27488":1222,"_19100":49043,"_5":13150,"_26023":48641,"_2643":49044},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3144":1380,"_27488":1222,"_19100":49046,"_5":13150,"_26023":48645,"_2643":49047},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3144":1381,"_27488":1222,"_19100":49049,"_5":13150,"_26023":48645,"_2643":49050},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3144":1382,"_27488":1222,"_19100":49052,"_5":13150,"_26023":48649,"_2643":49053},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3144":1383,"_27488":1222,"_19100":49055,"_5":13150,"_26023":48649,"_2643":49056},[],"There are two action types:",{"_3144":1384,"_27488":1222,"_19100":49058,"_5":13150,"_26023":48649,"_2643":49059},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3144":1385,"_27488":1222,"_19100":49061,"_5":13150,"_26023":48649,"_2643":49062},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3144":1386,"_27488":1222,"_19100":49064,"_5":13150,"_26023":48649,"_2643":49065},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3144":1387,"_27488":1222,"_19100":49067,"_5":13150,"_26023":48653,"_2643":49068},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3144":1388,"_27488":1222,"_19100":49070,"_5":13150,"_26023":48653,"_2643":49071},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3144":1389,"_27488":1222,"_19100":49073,"_5":13150,"_26023":48653,"_2643":49074},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3144":1390,"_27488":1222,"_19100":49076,"_5":13150,"_26023":48657,"_2643":49077},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3144":1391,"_27488":1222,"_19100":49079,"_5":13150,"_26023":48657,"_2643":49080},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3144":1392,"_27488":1222,"_19100":49082,"_5":13150,"_26023":48657,"_2643":49083},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3144":1393,"_27488":1222,"_19100":49085,"_5":13150,"_26023":48657,"_2643":49086},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3144":1394,"_27488":1222,"_19100":49088,"_5":13150,"_26023":48657,"_2643":49089},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3144":1395,"_27488":1222,"_19100":49091,"_5":13150,"_26023":48657,"_2643":49092},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3144":1396,"_27488":1222,"_19100":49094,"_5":13150,"_26023":48657,"_2643":49095},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3144":1397,"_27488":1222,"_19100":49097,"_5":13150,"_26023":48657,"_2643":49098},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3144":1398,"_27488":1222,"_19100":49100,"_5":13150,"_26023":48657,"_2643":49101},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3144":1399,"_27488":1222,"_19100":49103,"_5":13150,"_26023":48657,"_2643":49104},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3144":1400,"_27488":1222,"_19100":49106,"_5":13150,"_26023":48657,"_2643":49107},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3144":1401,"_27488":1222,"_19100":49109,"_5":13150,"_26023":48657,"_2643":49110},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3144":1402,"_27488":1222,"_19100":49112,"_5":13150,"_26023":48657,"_2643":49113},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3144":1403,"_27488":1222,"_19100":49115,"_5":13150,"_26023":48657,"_2643":49116},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3144":1404,"_27488":1222,"_19100":49118,"_5":13150,"_26023":48657,"_2643":49119},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3144":1405,"_27488":1222,"_19100":49121,"_5":13150,"_26023":48657,"_2643":49122},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3144":1406,"_27488":1222,"_19100":49124,"_5":13150,"_26023":48657,"_2643":49125},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3144":1407,"_27488":1222,"_19100":49127,"_5":13150,"_26023":48657,"_2643":49128},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3144":1408,"_27488":1222,"_19100":49130,"_5":13150,"_26023":48657,"_2643":49131},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3144":1409,"_27488":1222,"_19100":49133,"_5":13150,"_26023":48657,"_2643":49134},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3144":1410,"_27488":1222,"_19100":49136,"_5":13150,"_26023":48657,"_2643":49137},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3144":1411,"_27488":1411,"_5":13476,"_2643":47118,"_27831":49139,"_19100":49140,"_26023":1411},[44764,46144,47118],[],{"_3144":1412,"_27488":1411,"_19100":49142,"_5":13150,"_26023":1411,"_2643":49143},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3144":1413,"_27488":1411,"_5":27828,"_19100":49145,"_26023":49146,"_2643":49147},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#start-here","Start here",{"_3144":1414,"_27488":1411,"_5":27828,"_19100":49149,"_26023":49150,"_2643":47116},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#devices-and-identities",{"_3144":1415,"_27488":1411,"_5":27828,"_19100":49152,"_26023":49153,"_2643":47299},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#enrollment-with-pki",{"_3144":1416,"_27488":1411,"_5":27828,"_19100":49155,"_26023":49156,"_2643":48574},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#integrations",{"_3144":1417,"_27488":1411,"_5":27828,"_19100":49158,"_26023":49159,"_2643":49160},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3144":1418,"_27488":1411,"_19100":49162,"_5":13150,"_26023":1411,"_2643":49163},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3144":1419,"_27488":1411,"_19100":49165,"_5":13150,"_26023":49146,"_2643":49166},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3144":1420,"_27488":1411,"_19100":49168,"_5":13150,"_26023":49146,"_2643":49169},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3144":1421,"_27488":1411,"_19100":49171,"_5":13150,"_26023":49150,"_2643":49172},[],"Resource",{"_3144":1422,"_27488":1411,"_19100":49174,"_5":13150,"_26023":49150,"_2643":49175},[],"What it represents",{"_3144":1423,"_27488":1411,"_19100":49177,"_5":13150,"_26023":49150,"_2643":49178},[],"**Device**",{"_3144":1424,"_27488":1411,"_19100":49180,"_5":13150,"_26023":49150,"_2643":49181},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3144":1425,"_27488":1411,"_19100":49183,"_5":13150,"_26023":49150,"_2643":49184},[],"**Identity**",{"_3144":1426,"_27488":1411,"_19100":49186,"_5":13150,"_26023":49150,"_2643":49187},[],"The device's association with its certificates: an active version and a history.",{"_3144":1427,"_27488":1411,"_19100":49189,"_5":13150,"_26023":49150,"_2643":49190},[],"**DMS**",{"_3144":1428,"_27488":1411,"_19100":49192,"_5":13150,"_26023":49150,"_2643":49193},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3144":1429,"_27488":1411,"_19100":49195,"_5":13150,"_26023":49150,"_2643":49196},[],"**Fleet**",{"_3144":1430,"_27488":1411,"_19100":49198,"_5":13150,"_26023":49150,"_2643":49199},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3144":1431,"_27488":1411,"_19100":49201,"_5":13150,"_26023":49150,"_2643":49202},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3144":1432,"_27488":1411,"_19100":49204,"_5":13150,"_26023":49150,"_2643":49205},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3144":1433,"_27488":1411,"_19100":49207,"_5":13150,"_26023":49153,"_2643":49208},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3144":1434,"_27488":1411,"_19100":49210,"_5":13150,"_26023":49153,"_2643":49211},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3144":1435,"_27488":1411,"_19100":49213,"_5":13150,"_26023":49153,"_2643":49214},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3144":1436,"_27488":1411,"_19100":49216,"_5":13150,"_26023":49153,"_2643":49217},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3144":1437,"_27488":1411,"_19100":49219,"_5":13150,"_26023":49153,"_2643":49220},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3144":1438,"_27488":1411,"_19100":49222,"_5":13150,"_26023":49153,"_2643":49223},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3144":1439,"_27488":1411,"_19100":49225,"_5":13150,"_26023":49153,"_2643":49226},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3144":1440,"_27488":1411,"_19100":49228,"_5":13150,"_26023":49153,"_2643":49229},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3144":1441,"_27488":1411,"_19100":49231,"_5":13150,"_26023":49156,"_2643":49232},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3144":1442,"_27488":1411,"_19100":49234,"_5":13150,"_26023":49156,"_2643":49235},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3144":1443,"_27488":1411,"_19100":49237,"_5":13150,"_26023":49159,"_2643":49238},[],"Participant",{"_3144":1444,"_27488":1411,"_19100":49240,"_5":13150,"_26023":49159,"_2643":49241},[],"Responsibility",{"_3144":1445,"_27488":1411,"_19100":49243,"_5":13150,"_26023":49159,"_2643":49244},[],"PKI administrator",{"_3144":1446,"_27488":1411,"_19100":49246,"_5":13150,"_26023":49159,"_2643":49247},[],"CA, issuance profile, chain and revocation publication.",{"_3144":1447,"_27488":1411,"_19100":49249,"_5":13150,"_26023":49159,"_2643":49250},[],"Provisioning administrator",{"_3144":1448,"_27488":1411,"_19100":49252,"_5":13150,"_26023":49159,"_2643":49253},[],"DMS, admission, authentication per operation and inventory.",{"_3144":1449,"_27488":1411,"_19100":49255,"_5":13150,"_26023":49159,"_2643":49256},[],"Device integrator",{"_3144":1450,"_27488":1411,"_19100":49258,"_5":13150,"_26023":49159,"_2643":49259},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3144":1451,"_27488":1411,"_19100":49261,"_5":13150,"_26023":49159,"_2643":49262},[],"Consumer integrator",{"_3144":1452,"_27488":1411,"_19100":49264,"_5":13150,"_26023":49159,"_2643":49265},[],"Trusted issuers, validation and device permissions in the destination.",{"_3144":1453,"_27488":1411,"_19100":49267,"_5":13150,"_26023":49159,"_2643":49268},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3144":1454,"_27488":1454,"_5":13476,"_2643":49270,"_27831":49271,"_19100":49273,"_26023":1454},"Enroll and connect your first device",[44764,46144,47118,49272],"Getting started",[],{"_3144":1455,"_27488":1454,"_19100":49275,"_5":13150,"_26023":1454,"_2643":49276},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3144":1456,"_27488":1454,"_5":27828,"_19100":49278,"_26023":49279,"_2643":44774},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3144":1457,"_27488":1454,"_5":27828,"_19100":49281,"_26023":49282,"_2643":49283},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3144":1458,"_27488":1454,"_5":27828,"_19100":49285,"_26023":49286,"_2643":49287},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3144":1459,"_27488":1454,"_5":27828,"_19100":49289,"_26023":49290,"_2643":49291},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3144":1460,"_27488":1454,"_5":27828,"_19100":49293,"_26023":49294,"_2643":49295},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3144":1461,"_27488":1454,"_5":27828,"_19100":49297,"_26023":49298,"_2643":49299},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3144":1462,"_27488":1454,"_5":27828,"_19100":49301,"_26023":49302,"_2643":49303},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3144":1463,"_27488":1454,"_5":27828,"_19100":49305,"_26023":49306,"_2643":49307},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3144":1464,"_27488":1454,"_19100":49309,"_5":13150,"_26023":1454,"_2643":49310},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3144":1465,"_27488":1454,"_19100":49312,"_5":13150,"_26023":49279,"_2643":49313},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3144":1466,"_27488":1454,"_19100":49315,"_5":13150,"_26023":49279,"_2643":49316},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3144":1467,"_27488":1454,"_19100":49318,"_5":13150,"_26023":49279,"_2643":49319},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3144":1468,"_27488":1454,"_19100":49321,"_5":13150,"_26023":49279,"_2643":49322},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3144":1469,"_27488":1454,"_19100":49324,"_5":13150,"_26023":49279,"_2643":49325},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3144":1470,"_27488":1454,"_19100":49327,"_5":13150,"_26023":49282,"_2643":49328},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3144":1471,"_27488":1454,"_19100":49330,"_5":13150,"_26023":49282,"_2643":49331},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3144":1472,"_27488":1454,"_19100":49333,"_5":13150,"_26023":49286,"_2643":49334},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3144":1473,"_27488":1454,"_19100":49336,"_5":13150,"_26023":49286,"_2643":49337},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3144":1474,"_27488":1454,"_19100":49339,"_5":13150,"_26023":49286,"_2643":49340},[],"Setting",{"_3144":1475,"_27488":1454,"_19100":49342,"_5":13150,"_26023":49286,"_2643":49343},[],"Evaluation value",{"_3144":1476,"_27488":1454,"_19100":49345,"_5":13150,"_26023":49286,"_2643":49346},[],"Enrollment CA",{"_3144":1477,"_27488":1454,"_19100":49348,"_5":13150,"_26023":49286,"_2643":49349},[],"Issuing root from `device-root.pem`.",{"_3144":1478,"_27488":1454,"_19100":49351,"_5":13150,"_26023":49286,"_2643":47429},[],{"_3144":1479,"_27488":1454,"_19100":49353,"_5":13150,"_26023":49286,"_2643":49354},[],"The 1-hour leaf profile you just prepared.",{"_3144":1480,"_27488":1454,"_19100":49356,"_5":13150,"_26023":49286,"_2643":49357},[],"Protocol / Registration Mode",{"_3144":1481,"_27488":1454,"_19100":49359,"_5":13150,"_26023":49286,"_2643":49360},[],"`EST_RFC7030` / `JITP`.",{"_3144":1482,"_27488":1454,"_19100":49362,"_5":13150,"_26023":49286,"_2643":49363},[],"Verify CSR Signature",{"_3144":1483,"_27488":1454,"_19100":49365,"_5":13150,"_26023":49286,"_2643":49366},[],"Enabled.",{"_3144":1484,"_27488":1454,"_19100":49368,"_5":13150,"_26023":49286,"_2643":49369},[],"Enable Replaceable Enrollment",{"_3144":1485,"_27488":1454,"_19100":49371,"_5":13150,"_26023":49286,"_2643":49372},[],"Disabled; the ID must be new.",{"_3144":1486,"_27488":1454,"_19100":49374,"_5":13150,"_26023":49286,"_2643":49375},[],"Initial authentication",{"_3144":1487,"_27488":1454,"_19100":49377,"_5":13150,"_26023":49286,"_2643":49378},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3144":1488,"_27488":1454,"_19100":49380,"_5":13150,"_26023":49286,"_2643":49381},[],"Renewal authentication",{"_3144":1489,"_27488":1454,"_19100":49383,"_5":13150,"_26023":49286,"_2643":49384},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3144":1490,"_27488":1454,"_19100":49386,"_5":13150,"_26023":49286,"_2643":49387},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3144":1491,"_27488":1454,"_19100":49389,"_5":13150,"_26023":49286,"_2643":49390},[],"Empty list for this direct issuance / disabled.",{"_3144":1492,"_27488":1454,"_19100":49392,"_5":13150,"_26023":49286,"_2643":49393},[],"Re-enrollment Delta",{"_3144":1493,"_27488":1454,"_19100":49395,"_5":13150,"_26023":49286,"_2643":49396},[],"1 hour.",{"_3144":1494,"_27488":1454,"_19100":49398,"_5":13150,"_26023":49286,"_2643":49399},[],"Preventive / Critical Delta",{"_3144":1495,"_27488":1454,"_19100":49401,"_5":13150,"_26023":49286,"_2643":49402},[],"30 minutes / 10 minutes.",{"_3144":1496,"_27488":1454,"_19100":49404,"_5":13150,"_26023":49286,"_2643":49405},[],"Revoke on Re-enrollment",{"_3144":1497,"_27488":1454,"_19100":49407,"_5":13150,"_26023":49286,"_2643":49408},[],"Disabled to test the successor before retiring the previous identity.",{"_3144":1498,"_27488":1454,"_19100":49410,"_5":13150,"_26023":49286,"_2643":47437},[],{"_3144":1499,"_27488":1454,"_19100":49412,"_5":13150,"_26023":49286,"_2643":49413},[],"Disabled; the operational key is generated in the client.",{"_3144":1500,"_27488":1454,"_19100":49415,"_5":13150,"_26023":49286,"_2643":49416},[],"CA Distribution",{"_3144":1501,"_27488":1454,"_19100":49418,"_5":13150,"_26023":49286,"_2643":49419},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3144":1502,"_27488":1454,"_19100":49421,"_5":13150,"_26023":49286,"_2643":49422},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_3144":1503,"_27488":1454,"_19100":49424,"_5":13150,"_26023":49290,"_2643":49425},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3144":1504,"_27488":1454,"_19100":49427,"_5":13150,"_26023":49290,"_2643":49428},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3144":1505,"_27488":1454,"_19100":49430,"_5":13150,"_26023":49294,"_2643":49431},[],"Generate a new key and CSR with the selected identifier:",{"_3144":1506,"_27488":1454,"_19100":49433,"_5":13150,"_26023":49294,"_2643":49434},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3144":1507,"_27488":1454,"_19100":49436,"_5":13150,"_26023":49294,"_2643":49437},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3144":1508,"_27488":1454,"_19100":49439,"_5":13150,"_26023":49298,"_2643":49440},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3144":1509,"_27488":1454,"_19100":49442,"_5":13150,"_26023":49298,"_2643":49443},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3144":1510,"_27488":1454,"_19100":49445,"_5":13150,"_26023":49302,"_2643":49446},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3144":1511,"_27488":1454,"_19100":49448,"_5":13150,"_26023":49302,"_2643":49449},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3144":1512,"_27488":1454,"_19100":49451,"_5":13150,"_26023":49302,"_2643":49452},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3144":1513,"_27488":1454,"_19100":49454,"_5":13150,"_26023":49302,"_2643":49455},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3144":1514,"_27488":1454,"_19100":49457,"_5":13150,"_26023":49302,"_2643":49458},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3144":1515,"_27488":1454,"_19100":49460,"_5":13150,"_26023":49306,"_2643":49461},[],"Check",{"_3144":1516,"_27488":1454,"_19100":49463,"_5":13150,"_26023":49306,"_2643":49464},[],"Expected result",{"_3144":1517,"_27488":1454,"_19100":49466,"_5":13150,"_26023":49306,"_2643":49467},[],"Registration",{"_3144":1518,"_27488":1454,"_19100":49469,"_5":13150,"_26023":49306,"_2643":49470},[],"ID created automatically and correct DMS.",{"_3144":1519,"_27488":1454,"_19100":49472,"_5":13150,"_26023":49306,"_2643":49473},[],"Certificate",{"_3144":1520,"_27488":1454,"_19100":49475,"_5":13150,"_26023":49306,"_2643":49476},[],"CN, profile, serial and key verified.",{"_3144":1521,"_27488":1454,"_19100":49478,"_5":13150,"_26023":49306,"_2643":49479},[],"Inventory",{"_3144":1522,"_27488":1454,"_19100":49481,"_5":13150,"_26023":49306,"_2643":49482},[],"Received serial visible as the current identity and in history.",{"_3144":1523,"_27488":1454,"_19100":49484,"_5":13150,"_26023":49306,"_2643":49485},[],"Consumer",{"_3144":1524,"_27488":1454,"_19100":49487,"_5":13150,"_26023":49306,"_2643":49488},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3144":1525,"_27488":1454,"_19100":49490,"_5":13150,"_26023":49306,"_2643":49491},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3144":1526,"_27488":1454,"_19100":49493,"_5":13150,"_26023":49306,"_2643":49494},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3144":1527,"_27488":1527,"_5":13476,"_2643":47134,"_27831":49496,"_19100":49497,"_26023":1527},[44764,46144,47118,49272],[],{"_3144":1528,"_27488":1527,"_19100":49499,"_5":13150,"_26023":1527,"_2643":49500},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3144":1529,"_27488":1527,"_5":27828,"_19100":49502,"_26023":49503,"_2643":44774},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3144":1530,"_27488":1527,"_5":27828,"_19100":49505,"_26023":49506,"_2643":49507},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3144":1531,"_27488":1527,"_5":27828,"_19100":49509,"_26023":49510,"_2643":49511},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3144":1532,"_27488":1527,"_5":27828,"_19100":49513,"_26023":49514,"_2643":49515},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3144":1533,"_27488":1527,"_5":27828,"_19100":49517,"_26023":49518,"_2643":49519},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3144":1534,"_27488":1527,"_5":27828,"_19100":49521,"_26023":49522,"_2643":49523},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3144":1535,"_27488":1527,"_5":27828,"_19100":49525,"_26023":49526,"_2643":49464},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3144":1536,"_27488":1527,"_5":27828,"_19100":49528,"_26023":49529,"_2643":49530},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3144":1537,"_27488":1527,"_5":27828,"_19100":49532,"_26023":49533,"_2643":49534},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3144":1538,"_27488":1527,"_19100":49536,"_5":13150,"_26023":1527,"_2643":49537},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3144":1539,"_27488":1527,"_19100":49539,"_5":13150,"_26023":1527,"_2643":49540},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3144":1540,"_27488":1527,"_19100":49542,"_5":13150,"_26023":49503,"_2643":49543},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3144":1541,"_27488":1527,"_19100":49545,"_5":13150,"_26023":49503,"_2643":49546},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3144":1542,"_27488":1527,"_19100":49548,"_5":13150,"_26023":49503,"_2643":49549},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3144":1543,"_27488":1527,"_19100":49551,"_5":13150,"_26023":49503,"_2643":49552},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3144":1544,"_27488":1527,"_19100":49554,"_5":13150,"_26023":49506,"_2643":49555},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3144":1545,"_27488":1527,"_19100":49557,"_5":13150,"_26023":49506,"_2643":49558},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3144":1546,"_27488":1527,"_19100":49560,"_5":13150,"_26023":49506,"_2643":49561},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3144":1547,"_27488":1527,"_19100":49563,"_5":13150,"_26023":49506,"_2643":49564},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3144":1548,"_27488":1527,"_19100":49566,"_5":13150,"_26023":49506,"_2643":49567},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_3144":1549,"_27488":1527,"_19100":49569,"_5":13150,"_26023":49506,"_2643":49570},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3144":1550,"_27488":1527,"_19100":49572,"_5":13150,"_26023":49506,"_2643":49573},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3144":1551,"_27488":1527,"_19100":49575,"_5":13150,"_26023":49506,"_2643":49576},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3144":1552,"_27488":1527,"_19100":49578,"_5":13150,"_26023":49510,"_2643":49579},[],"Open **Managed Devices** and the registration action. Complete:",{"_3144":1553,"_27488":1527,"_19100":49581,"_5":13150,"_26023":49510,"_2643":49582},[],"**Device ID**: `device-001`.",{"_3144":1554,"_27488":1527,"_19100":49584,"_5":13150,"_26023":49510,"_2643":49585},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3144":1555,"_27488":1527,"_19100":49587,"_5":13150,"_26023":49510,"_2643":49588},[],"**Icon** and **Tags**: optional classification.",{"_3144":1556,"_27488":1527,"_19100":49590,"_5":13150,"_26023":49510,"_2643":49591},[],"Confirm registration.",{"_3144":1557,"_27488":1527,"_19100":49593,"_5":13150,"_26023":49514,"_2643":49594},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3144":1558,"_27488":1527,"_19100":49596,"_5":13150,"_26023":49514,"_2643":49597},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3144":1559,"_27488":1527,"_19100":49599,"_5":13150,"_26023":49518,"_2643":49600},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3144":1560,"_27488":1527,"_19100":49602,"_5":13150,"_26023":49518,"_2643":49603},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3144":1561,"_27488":1527,"_19100":49605,"_5":13150,"_26023":49522,"_2643":49606},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3144":1562,"_27488":1527,"_19100":49608,"_5":13150,"_26023":49522,"_2643":49609},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3144":1563,"_27488":1527,"_19100":49611,"_5":13150,"_26023":49526,"_2643":49461},[],{"_3144":1564,"_27488":1527,"_19100":49613,"_5":13150,"_26023":49526,"_2643":49614},[],"Result",{"_3144":1565,"_27488":1527,"_19100":49616,"_5":13150,"_26023":49526,"_2643":49617},[],"Device",{"_3144":1566,"_27488":1527,"_19100":49619,"_5":13150,"_26023":49526,"_2643":49620},[],"`device-001` appears in inventory with the expected DMS.",{"_3144":1567,"_27488":1527,"_19100":49622,"_5":13150,"_26023":49526,"_2643":49623},[],"Current identity",{"_3144":1568,"_27488":1527,"_19100":49625,"_5":13150,"_26023":49526,"_2643":49626},[],"The associated certificate matches the one you verified in PKI.",{"_3144":1569,"_27488":1527,"_19100":49628,"_5":13150,"_26023":49526,"_2643":49629},[],"History",{"_3144":1570,"_27488":1527,"_19100":49631,"_5":13150,"_26023":49526,"_2643":49632},[],"The associated issuance appears with its serial number and dates.",{"_3144":1571,"_27488":1527,"_19100":49634,"_5":13150,"_26023":49526,"_2643":49635},[],"Key and certificate",{"_3144":1572,"_27488":1527,"_19100":49637,"_5":13150,"_26023":49526,"_2643":49638},[],"You have the verified pair ready to install on the device.",{"_3144":1573,"_27488":1527,"_19100":49640,"_5":13150,"_26023":49529,"_2643":49641},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3144":1574,"_27488":1527,"_19100":49643,"_5":13150,"_26023":49529,"_2643":49644},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3144":1575,"_27488":1527,"_19100":49646,"_5":13150,"_26023":49529,"_2643":49647},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3144":1576,"_27488":1527,"_19100":49649,"_5":13150,"_26023":49529,"_2643":49650},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3144":1577,"_27488":1527,"_19100":49652,"_5":13150,"_26023":49533,"_2643":49653},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3144":1578,"_27488":1527,"_19100":49655,"_5":13150,"_26023":49533,"_2643":49656},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3144":1579,"_27488":1527,"_19100":49658,"_5":13150,"_26023":49533,"_2643":49659},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3144":1580,"_27488":1580,"_5":13476,"_2643":49661,"_27831":49662,"_19100":49663,"_26023":1580},"Lamassu IoT Platform",[44764,46144],[],{"_3144":1581,"_27488":1580,"_19100":49665,"_5":13150,"_26023":1580,"_2643":49666},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3144":1582,"_27488":1580,"_5":27828,"_19100":49668,"_26023":49669,"_2643":49147},[],"/docs/pr-preview/pr-26/platform/overview#start-here",{"_3144":1583,"_27488":1580,"_5":27828,"_19100":49671,"_26023":49672,"_2643":49673},[],"/docs/pr-preview/pr-26/platform/overview#choose-your-path","Choose your path",{"_3144":1584,"_27488":1580,"_5":27828,"_19100":49675,"_26023":49676,"_2643":49677},[],"/docs/pr-preview/pr-26/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3144":1585,"_27488":1580,"_5":27828,"_19100":49679,"_26023":49680,"_2643":49681},[],"/docs/pr-preview/pr-26/platform/overview#core-capabilities","Core capabilities",{"_3144":1586,"_27488":1580,"_5":27828,"_19100":49683,"_26023":49684,"_2643":49685},[],"/docs/pr-preview/pr-26/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3144":1587,"_27488":1580,"_5":27828,"_19100":49687,"_26023":49688,"_2643":49689},[],"/docs/pr-preview/pr-26/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3144":1588,"_27488":1580,"_5":27828,"_19100":49691,"_26023":49692,"_2643":49693},[],"/docs/pr-preview/pr-26/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3144":1589,"_27488":1580,"_5":27828,"_19100":49695,"_26023":49696,"_2643":49697},[],"/docs/pr-preview/pr-26/platform/overview#automate-device-identities","Automate device identities",{"_3144":1590,"_27488":1580,"_5":27828,"_19100":49699,"_26023":49700,"_2643":49701},[],"/docs/pr-preview/pr-26/platform/overview#publish-validation-status","Publish validation status",{"_3144":1591,"_27488":1580,"_5":27828,"_19100":49703,"_26023":49704,"_2643":49705},[],"/docs/pr-preview/pr-26/platform/overview#react-to-events","React to events",{"_3144":1592,"_27488":1580,"_5":27828,"_19100":49707,"_26023":49708,"_2643":49709},[],"/docs/pr-preview/pr-26/platform/overview#operational-reference","Operational reference",{"_3144":1593,"_27488":1580,"_19100":49711,"_5":13150,"_26023":1580,"_2643":49712},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3144":1594,"_27488":1580,"_19100":49714,"_5":13150,"_26023":49669,"_2643":49715},[],"Choose the result you need:",{"_3144":1595,"_27488":1580,"_19100":49717,"_5":13150,"_26023":49669,"_2643":49718},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3144":1596,"_27488":1580,"_19100":49720,"_5":13150,"_26023":49669,"_2643":49721},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3144":1597,"_27488":1580,"_19100":49723,"_5":13150,"_26023":49669,"_2643":49724},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3144":1598,"_27488":1580,"_19100":49726,"_5":13150,"_26023":49672,"_2643":49727},[],"Section",{"_3144":1599,"_27488":1580,"_19100":49729,"_5":13150,"_26023":49672,"_2643":49730},[],"What you manage",{"_3144":1600,"_27488":1580,"_19100":49732,"_5":13150,"_26023":49672,"_2643":49733},[],"Entry point",{"_3144":1601,"_27488":1580,"_19100":49735,"_5":13150,"_26023":49672,"_2643":49736},[],"**PKI**",{"_3144":1602,"_27488":1580,"_19100":49738,"_5":13150,"_26023":49672,"_2643":49739},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3144":1603,"_27488":1580,"_19100":49741,"_5":13150,"_26023":49672,"_2643":49742},[],"PKI overview",{"_3144":1604,"_27488":1580,"_19100":49744,"_5":13150,"_26023":49672,"_2643":49745},[],"**IoT Fleets**",{"_3144":1605,"_27488":1580,"_19100":49747,"_5":13150,"_26023":49672,"_2643":49748},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3144":1606,"_27488":1580,"_19100":49750,"_5":13150,"_26023":49672,"_2643":49751},[],"IoT Fleets overview",{"_3144":1607,"_27488":1580,"_19100":49753,"_5":13150,"_26023":49672,"_2643":49754},[],"**Administration**",{"_3144":1608,"_27488":1580,"_19100":49756,"_5":13150,"_26023":49672,"_2643":49757},[],"Operator permissions, audit and event subscriptions.",{"_3144":1609,"_27488":1580,"_19100":49759,"_5":13150,"_26023":49672,"_2643":46142},[],{"_3144":1610,"_27488":1580,"_19100":49761,"_5":13150,"_26023":49672,"_2643":49762},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3144":1611,"_27488":1580,"_19100":49764,"_5":13150,"_26023":49676,"_2643":49765},[],"An identity's journey connects four responsibilities:",{"_3144":1612,"_27488":1580,"_19100":49767,"_5":13150,"_26023":49676,"_2643":49768},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3144":1613,"_27488":1580,"_19100":49770,"_5":13150,"_26023":49676,"_2643":49771},[],"The provisioning administrator configures the DMS and initial trust.",{"_3144":1614,"_27488":1580,"_19100":49773,"_5":13150,"_26023":49676,"_2643":49774},[],"The device client requests a certificate and installs it with the matching key.",{"_3144":1615,"_27488":1580,"_19100":49776,"_5":13150,"_26023":49676,"_2643":49777},[],"The consumer validates the identity and applies its access permissions.",{"_3144":1616,"_27488":1580,"_19100":49779,"_5":13150,"_26023":49676,"_2643":49780},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3144":1617,"_27488":1580,"_19100":49782,"_5":13150,"_26023":49684,"_2643":49783},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3144":1618,"_27488":1580,"_19100":49785,"_5":13150,"_26023":49688,"_2643":49786},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3144":1619,"_27488":1580,"_19100":49788,"_5":13150,"_26023":49692,"_2643":49789},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3144":1620,"_27488":1580,"_19100":49791,"_5":13150,"_26023":49696,"_2643":49792},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3144":1621,"_27488":1580,"_19100":49794,"_5":13150,"_26023":49700,"_2643":49795},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3144":1622,"_27488":1580,"_19100":49797,"_5":13150,"_26023":49704,"_2643":49798},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3144":1623,"_27488":1580,"_19100":49800,"_5":13150,"_26023":49708,"_2643":49241},[],{"_3144":1624,"_27488":1580,"_19100":49802,"_5":13150,"_26023":49708,"_2643":49803},[],"What it prepares or checks",{"_3144":1625,"_27488":1580,"_19100":49805,"_5":13150,"_26023":49708,"_2643":49244},[],{"_3144":1626,"_27488":1580,"_19100":49807,"_5":13150,"_26023":49708,"_2643":49808},[],"Key custody, CA hierarchy, profiles and validation.",{"_3144":1627,"_27488":1580,"_19100":49810,"_5":13150,"_26023":49708,"_2643":49811},[],"Fleet administrator",{"_3144":1628,"_27488":1580,"_19100":49813,"_5":13150,"_26023":49708,"_2643":49814},[],"DMS, device admission, renewal policy and inventory.",{"_3144":1629,"_27488":1580,"_19100":49816,"_5":13150,"_26023":49708,"_2643":49256},[],{"_3144":1630,"_27488":1580,"_19100":49818,"_5":13150,"_26023":49708,"_2643":49819},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3144":1631,"_27488":1580,"_19100":49821,"_5":13150,"_26023":49708,"_2643":49262},[],{"_3144":1632,"_27488":1580,"_19100":49823,"_5":13150,"_26023":49708,"_2643":49824},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3144":1633,"_27488":1580,"_19100":49826,"_5":13150,"_26023":49708,"_2643":49827},[],"Infrastructure operator",{"_3144":1634,"_27488":1580,"_19100":49829,"_5":13150,"_26023":49708,"_2643":49830},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3144":1635,"_27488":1580,"_19100":49832,"_5":13150,"_26023":49708,"_2643":49833},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3144":1636,"_27488":1636,"_5":13476,"_2643":49835,"_27831":49836,"_19100":49839,"_26023":1636},"CA hierarchy and rotation",[44764,46144,49837,49838],"PKI","Keys, authorities and certificates",[],{"_3144":1637,"_27488":1636,"_19100":49841,"_5":13150,"_26023":1636,"_2643":49842},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3144":1638,"_27488":1636,"_5":27828,"_19100":49844,"_26023":49845,"_2643":49846},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3144":1639,"_27488":1636,"_5":27828,"_19100":49848,"_26023":49849,"_2643":49850},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3144":1640,"_27488":1636,"_5":27828,"_19100":49852,"_26023":49853,"_2643":49854},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3144":1641,"_27488":1636,"_5":27828,"_19100":49856,"_26023":49857,"_2643":49858},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3144":1642,"_27488":1636,"_5":27828,"_19100":49860,"_26023":49861,"_2643":49862},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3144":1643,"_27488":1636,"_5":27828,"_19100":49864,"_26023":49865,"_2643":49866},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3144":1644,"_27488":1636,"_5":27828,"_19100":49868,"_26023":49869,"_2643":49870},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3144":1645,"_27488":1636,"_5":27828,"_19100":49872,"_26023":49873,"_2643":49874},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3144":1646,"_27488":1636,"_5":27828,"_19100":49876,"_26023":49877,"_2643":49878},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3144":1647,"_27488":1636,"_5":27828,"_19100":49880,"_26023":49881,"_2643":49882},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3144":1648,"_27488":1636,"_5":27828,"_19100":49884,"_26023":49885,"_2643":49886},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3144":1649,"_27488":1636,"_5":27828,"_19100":49888,"_26023":49889,"_2643":49890},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3144":1650,"_27488":1636,"_19100":49892,"_5":13150,"_26023":1636,"_2643":49893},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3144":1651,"_27488":1636,"_19100":49895,"_5":13150,"_26023":1636,"_2643":49896},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3144":1652,"_27488":1636,"_19100":49898,"_5":13150,"_26023":49845,"_2643":49899},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3144":1653,"_27488":1636,"_19100":49901,"_5":13150,"_26023":49845,"_2643":49902},[],"environment, such as production and preproduction;",{"_3144":1654,"_27488":1636,"_19100":49904,"_5":13150,"_26023":49845,"_2643":49905},[],"owner or operating team;",{"_3144":1655,"_27488":1636,"_19100":49907,"_5":13150,"_26023":49845,"_2643":49908},[],"device family or manufacturing process;",{"_3144":1656,"_27488":1636,"_19100":49910,"_5":13150,"_26023":49845,"_2643":49911},[],"region or regulatory requirement;",{"_3144":1657,"_27488":1636,"_19100":49913,"_5":13150,"_26023":49845,"_2643":49914},[],"cryptographic engine or key policy;",{"_3144":1658,"_27488":1636,"_19100":49916,"_5":13150,"_26023":49845,"_2643":49917},[],"maintenance window and renewal cadence.",{"_3144":1659,"_27488":1636,"_19100":49919,"_5":13150,"_26023":49845,"_2643":49920},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3144":1660,"_27488":1636,"_19100":49922,"_5":13150,"_26023":49845,"_2643":49923},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3144":1661,"_27488":1636,"_19100":49925,"_5":13150,"_26023":49849,"_2643":49926},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3144":1662,"_27488":1636,"_19100":49928,"_5":13150,"_26023":49849,"_2643":49929},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3144":1663,"_27488":1636,"_19100":49931,"_5":13150,"_26023":49849,"_2643":49932},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3144":1664,"_27488":1636,"_19100":49934,"_5":13150,"_26023":49853,"_2643":49935},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3144":1665,"_27488":1636,"_19100":49937,"_5":13150,"_26023":49853,"_2643":49938},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3144":1666,"_27488":1636,"_19100":49940,"_5":13150,"_26023":49853,"_2643":49941},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3144":1667,"_27488":1636,"_19100":49943,"_5":13150,"_26023":49853,"_2643":49944},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3144":1668,"_27488":1636,"_19100":49946,"_5":13150,"_26023":49861,"_2643":49947},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3144":1669,"_27488":1636,"_19100":49949,"_5":13150,"_26023":49865,"_2643":49950},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3144":1670,"_27488":1636,"_19100":49952,"_5":13150,"_26023":49869,"_2643":49953},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3144":1671,"_27488":1636,"_19100":49955,"_5":13150,"_26023":49873,"_2643":49956},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_3144":1672,"_27488":1636,"_19100":49958,"_5":13150,"_26023":49877,"_2643":49959},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3144":1673,"_27488":1636,"_19100":49961,"_5":13150,"_26023":49881,"_2643":49962},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_3144":1674,"_27488":1636,"_19100":49964,"_5":13150,"_26023":49885,"_2643":49965},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3144":1675,"_27488":1636,"_19100":49967,"_5":13150,"_26023":49885,"_2643":49968},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3144":1676,"_27488":1636,"_19100":49970,"_5":13150,"_26023":49885,"_2643":49971},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3144":1677,"_27488":1636,"_19100":49973,"_5":13150,"_26023":49885,"_2643":49974},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3144":1678,"_27488":1636,"_19100":49976,"_5":13150,"_26023":49889,"_2643":49977},[],"The new chain ends in an anchor installed by the consumer.",{"_3144":1679,"_27488":1636,"_19100":49979,"_5":13150,"_26023":49889,"_2643":49980},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3144":1680,"_27488":1636,"_19100":49982,"_5":13150,"_26023":49889,"_2643":49983},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3144":1681,"_27488":1636,"_19100":49985,"_5":13150,"_26023":49889,"_2643":49986},[],"Re-enrollment accepts the old identity during the planned period.",{"_3144":1682,"_27488":1636,"_19100":49988,"_5":13150,"_26023":49889,"_2643":49989},[],"OCSP and CRL respond for the authorities that remain active.",{"_3144":1683,"_27488":1636,"_19100":49991,"_5":13150,"_26023":49889,"_2643":49992},[],"No DMS is left accidentally issuing from the old CA.",{"_3144":1684,"_27488":1636,"_19100":49994,"_5":13150,"_26023":49889,"_2643":49995},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3144":1685,"_27488":1685,"_5":13476,"_2643":49997,"_27831":49998,"_19100":49999,"_26023":1685},"Certification authorities",[44764,46144,49837,49838],[],{"_3144":1686,"_27488":1685,"_19100":50001,"_5":13150,"_26023":1685,"_2643":50002},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3144":1687,"_27488":1685,"_5":27828,"_19100":50004,"_26023":50005,"_2643":50006},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3144":1688,"_27488":1685,"_5":27828,"_19100":50008,"_26023":50009,"_2643":50010},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3144":1689,"_27488":1685,"_5":27828,"_19100":50012,"_26023":50013,"_2643":44774},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#before-you-begin",{"_3144":1690,"_27488":1685,"_5":27828,"_19100":50015,"_26023":50016,"_2643":50017},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3144":1691,"_27488":1685,"_5":27828,"_19100":50019,"_26023":50020,"_2643":50021},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3144":1692,"_27488":1685,"_5":27828,"_19100":50023,"_26023":50024,"_2643":50025},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3144":1693,"_27488":1685,"_5":27828,"_19100":50027,"_26023":50028,"_2643":50029},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3144":1694,"_27488":1685,"_5":27828,"_19100":50031,"_26023":50032,"_2643":50033},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3144":1695,"_27488":1685,"_5":27828,"_19100":50035,"_26023":50036,"_2643":50037},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3144":1696,"_27488":1685,"_5":27828,"_19100":50039,"_26023":50040,"_2643":50041},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3144":1697,"_27488":1685,"_5":27828,"_19100":50043,"_26023":50044,"_2643":50045},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3144":1698,"_27488":1685,"_5":27828,"_19100":50047,"_26023":50048,"_2643":50049},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3144":1699,"_27488":1685,"_5":27828,"_19100":50051,"_26023":50052,"_2643":50053},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3144":1700,"_27488":1685,"_5":27828,"_19100":50055,"_26023":50056,"_2643":50057},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3144":1701,"_27488":1685,"_5":27828,"_19100":50059,"_26023":50060,"_2643":50061},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3144":1702,"_27488":1685,"_5":27828,"_19100":50063,"_26023":50064,"_2643":50065},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3144":1703,"_27488":1685,"_5":27828,"_19100":50067,"_26023":50068,"_2643":50069},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3144":1704,"_27488":1685,"_5":27828,"_19100":50071,"_26023":50072,"_2643":50073},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3144":1705,"_27488":1685,"_5":27828,"_19100":50075,"_26023":50076,"_2643":50077},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3144":1706,"_27488":1685,"_5":27828,"_19100":50079,"_26023":50080,"_2643":50081},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3144":1707,"_27488":1685,"_5":27828,"_19100":50083,"_26023":50084,"_2643":50085},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3144":1708,"_27488":1685,"_5":27828,"_19100":50087,"_26023":50088,"_2643":50089},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3144":1709,"_27488":1685,"_19100":50091,"_5":13150,"_26023":1685,"_2643":50092},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3144":1710,"_27488":1685,"_19100":50094,"_5":13150,"_26023":1685,"_2643":50095},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3144":1711,"_27488":1685,"_19100":50097,"_5":13150,"_26023":1685,"_2643":50098},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3144":1712,"_27488":1685,"_19100":50100,"_5":13150,"_26023":50005,"_2643":50101},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3144":1713,"_27488":1685,"_19100":50103,"_5":13150,"_26023":50005,"_2643":50104},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3144":1714,"_27488":1685,"_19100":50106,"_5":13150,"_26023":50005,"_2643":50107},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3144":1715,"_27488":1685,"_19100":50109,"_5":13150,"_26023":50005,"_2643":50110},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3144":1716,"_27488":1685,"_19100":50112,"_5":13150,"_26023":50005,"_2643":50113},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3144":1717,"_27488":1685,"_19100":50115,"_5":13150,"_26023":50013,"_2643":50116},[],"Decide whether the CA will be a root or an intermediate.",{"_3144":1718,"_27488":1685,"_19100":50118,"_5":13150,"_26023":50013,"_2643":50119},[],"Choose the engine that will keep the key.",{"_3144":1719,"_27488":1685,"_19100":50121,"_5":13150,"_26023":50013,"_2643":50122},[],"Define a validity longer than that of the certificates it will issue.",{"_3144":1720,"_27488":1685,"_19100":50124,"_5":13150,"_26023":50013,"_2643":50125},[],"For an intermediate CA, make sure the parent CA is active.",{"_3144":1721,"_27488":1685,"_19100":50127,"_5":13150,"_26023":50016,"_2643":50128},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3144":1722,"_27488":1685,"_19100":50130,"_5":13150,"_26023":50020,"_2643":50131},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3144":1723,"_27488":1685,"_19100":50133,"_5":13150,"_26023":50020,"_2643":50134},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3144":1724,"_27488":1685,"_19100":50136,"_5":13150,"_26023":50024,"_2643":50137},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3144":1725,"_27488":1685,"_19100":50139,"_5":13150,"_26023":50028,"_2643":50140},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3144":1726,"_27488":1685,"_19100":50142,"_5":13150,"_26023":50028,"_2643":50143},[],"`C`: two-letter ISO 3166-1 country code.",{"_3144":1727,"_27488":1685,"_19100":50145,"_5":13150,"_26023":50028,"_2643":50146},[],"`ST`: state or province.",{"_3144":1728,"_27488":1685,"_19100":50148,"_5":13150,"_26023":50028,"_2643":50149},[],"`L`: locality.",{"_3144":1729,"_27488":1685,"_19100":50151,"_5":13150,"_26023":50028,"_2643":50152},[],"`O`: organization.",{"_3144":1730,"_27488":1685,"_19100":50154,"_5":13150,"_26023":50028,"_2643":50155},[],"`OU`: organizational unit.",{"_3144":1731,"_27488":1685,"_19100":50157,"_5":13150,"_26023":50028,"_2643":50158},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3144":1732,"_27488":1685,"_19100":50160,"_5":13150,"_26023":50032,"_2643":50161},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3144":1733,"_27488":1685,"_19100":50163,"_5":13150,"_26023":50032,"_2643":50164},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3144":1734,"_27488":1685,"_19100":50166,"_5":13150,"_26023":50036,"_2643":50167},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3144":1735,"_27488":1685,"_19100":50169,"_5":13150,"_26023":50036,"_2643":50170},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3144":1736,"_27488":1685,"_19100":50172,"_5":13150,"_26023":50040,"_2643":50173},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3144":1737,"_27488":1685,"_19100":50175,"_5":13150,"_26023":50040,"_2643":50176},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3144":1738,"_27488":1685,"_19100":50178,"_5":13150,"_26023":50044,"_2643":50179},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3144":1739,"_27488":1685,"_19100":50181,"_5":13150,"_26023":50048,"_2643":50182},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3144":1740,"_27488":1685,"_19100":50184,"_5":13150,"_26023":50052,"_2643":50185},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3144":1741,"_27488":1685,"_19100":50187,"_5":13150,"_26023":50056,"_2643":50188},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3144":1742,"_27488":1685,"_19100":50190,"_5":13150,"_26023":50060,"_2643":50191},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3144":1743,"_27488":1685,"_19100":50193,"_5":13150,"_26023":50060,"_2643":50194},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3144":1744,"_27488":1685,"_19100":50196,"_5":13150,"_26023":50064,"_2643":50197},[],"Open a CA from the inventory to review:",{"_3144":1745,"_27488":1685,"_19100":50199,"_5":13150,"_26023":50064,"_2643":50200},[],"Status and validity period.",{"_3144":1746,"_27488":1685,"_19100":50202,"_5":13150,"_26023":50064,"_2643":50203},[],"Certificate and chain in PEM format.",{"_3144":1747,"_27488":1685,"_19100":50205,"_5":13150,"_26023":50064,"_2643":50206},[],"Number of active, expired and revoked certificates.",{"_3144":1748,"_27488":1685,"_19100":50208,"_5":13150,"_26023":50064,"_2643":50209},[],"Certificates issued in **Issued Certificates**.",{"_3144":1749,"_27488":1685,"_19100":50211,"_5":13150,"_26023":50064,"_2643":50212},[],"The CRL linked to the authority.",{"_3144":1750,"_27488":1685,"_19100":50214,"_5":13150,"_26023":50064,"_2643":50215},[],"Metadata and the associated cryptographic engine.",{"_3144":1751,"_27488":1685,"_19100":50217,"_5":13150,"_26023":50064,"_2643":50218},[],"You can filter the inventory by name, status and CA type.",{"_3144":1752,"_27488":1685,"_19100":50220,"_5":13150,"_26023":50068,"_2643":50221},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3144":1753,"_27488":1685,"_19100":50223,"_5":13150,"_26023":50068,"_2643":50224},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3144":1754,"_27488":1685,"_19100":50226,"_5":13150,"_26023":50068,"_2643":50227},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3144":1755,"_27488":1685,"_19100":50229,"_5":13150,"_26023":50068,"_2643":50230},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3144":1756,"_27488":1685,"_19100":50232,"_5":13150,"_26023":50072,"_2643":50233},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3144":1757,"_27488":1685,"_19100":50235,"_5":13150,"_26023":50076,"_2643":50236},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3144":1758,"_27488":1685,"_19100":50238,"_5":13150,"_26023":50080,"_2643":50239},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3144":1759,"_27488":1685,"_19100":50241,"_5":13150,"_26023":50084,"_2643":50242},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3144":1760,"_27488":1685,"_19100":50244,"_5":13150,"_26023":50088,"_2643":50245},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3144":1761,"_27488":1685,"_19100":50247,"_5":13150,"_26023":50088,"_2643":50248},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3144":1762,"_27488":1762,"_5":13476,"_2643":50250,"_27831":50251,"_19100":50252,"_26023":1762},"Certificate profiles",[44764,46144,49837,49838],[],{"_3144":1763,"_27488":1762,"_19100":50254,"_5":13150,"_26023":1762,"_2643":50255},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3144":1764,"_27488":1762,"_5":27828,"_19100":50257,"_26023":50258,"_2643":50259},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3144":1765,"_27488":1762,"_5":27828,"_19100":50261,"_26023":50262,"_2643":50263},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#validity","Validity",{"_3144":1766,"_27488":1762,"_5":27828,"_19100":50265,"_26023":50266,"_2643":50267},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3144":1767,"_27488":1762,"_5":27828,"_19100":50269,"_26023":50270,"_2643":50271},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3144":1768,"_27488":1762,"_5":27828,"_19100":50273,"_26023":50274,"_2643":50275},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#subject","Subject",{"_3144":1769,"_27488":1762,"_5":27828,"_19100":50277,"_26023":50278,"_2643":50279},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3144":1770,"_27488":1762,"_5":27828,"_19100":50281,"_26023":50282,"_2643":50283},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3144":1771,"_27488":1762,"_5":27828,"_19100":50285,"_26023":50286,"_2643":50287},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3144":1772,"_27488":1762,"_5":27828,"_19100":50289,"_26023":50290,"_2643":50291},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3144":1773,"_27488":1762,"_5":27828,"_19100":50293,"_26023":50294,"_2643":50295},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3144":1774,"_27488":1762,"_5":27828,"_19100":50297,"_26023":50298,"_2643":50299},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3144":1775,"_27488":1762,"_5":27828,"_19100":50301,"_26023":50302,"_2643":50303},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3144":1776,"_27488":1762,"_5":27828,"_19100":50305,"_26023":50306,"_2643":50307},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3144":1777,"_27488":1762,"_5":27828,"_19100":50309,"_26023":50310,"_2643":50311},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3144":1778,"_27488":1762,"_5":27828,"_19100":50313,"_26023":50314,"_2643":50315},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#design-examples","Design examples",{"_3144":1779,"_27488":1762,"_5":27828,"_19100":50317,"_26023":50318,"_2643":50319},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3144":1780,"_27488":1762,"_19100":50321,"_5":13150,"_26023":1762,"_2643":50322},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3144":1781,"_27488":1762,"_19100":50324,"_5":13150,"_26023":1762,"_2643":50325},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3144":1782,"_27488":1762,"_19100":50327,"_5":13150,"_26023":50262,"_2643":50328},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3144":1783,"_27488":1762,"_19100":50330,"_5":13150,"_26023":50262,"_2643":50331},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3144":1784,"_27488":1762,"_19100":50333,"_5":13150,"_26023":50266,"_2643":50334},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3144":1785,"_27488":1762,"_19100":50336,"_5":13150,"_26023":50270,"_2643":50337},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3144":1786,"_27488":1762,"_19100":50339,"_5":13150,"_26023":50270,"_2643":50340},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3144":1787,"_27488":1762,"_19100":50342,"_5":13150,"_26023":50270,"_2643":50343},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3144":1788,"_27488":1762,"_19100":50345,"_5":13150,"_26023":50274,"_2643":50346},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3144":1789,"_27488":1762,"_19100":50348,"_5":13150,"_26023":50278,"_2643":50349},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3144":1790,"_27488":1762,"_19100":50351,"_5":13150,"_26023":50278,"_2643":50352},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3144":1791,"_27488":1762,"_19100":50354,"_5":13150,"_26023":50282,"_2643":50355},[],"The cryptographic enforcement can:",{"_3144":1792,"_27488":1762,"_19100":50357,"_5":13150,"_26023":50282,"_2643":50358},[],"allow or block RSA keys;",{"_3144":1793,"_27488":1762,"_19100":50360,"_5":13150,"_26023":50282,"_2643":50361},[],"limit the supported RSA sizes;",{"_3144":1794,"_27488":1762,"_19100":50363,"_5":13150,"_26023":50282,"_2643":50364},[],"allow or block ECDSA keys;",{"_3144":1795,"_27488":1762,"_19100":50366,"_5":13150,"_26023":50282,"_2643":50367},[],"limit the supported ECDSA sizes or curves.",{"_3144":1796,"_27488":1762,"_19100":50369,"_5":13150,"_26023":50282,"_2643":50370},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3144":1797,"_27488":1762,"_19100":50372,"_5":13150,"_26023":50286,"_2643":50373},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3144":1798,"_27488":1762,"_19100":50375,"_5":13150,"_26023":50286,"_2643":47865},[],{"_3144":1799,"_27488":1762,"_19100":50377,"_5":13150,"_26023":50286,"_2643":50378},[],"First choice",{"_3144":1800,"_27488":1762,"_19100":50380,"_5":13150,"_26023":50286,"_2643":50381},[],"Second choice",{"_3144":1801,"_27488":1762,"_19100":50383,"_5":13150,"_26023":50286,"_2643":50384},[],"If neither is supplied",{"_3144":1802,"_27488":1762,"_19100":50386,"_5":13150,"_26023":50286,"_2643":50387},[],"Direct signing with a CA",{"_3144":1803,"_27488":1762,"_19100":50389,"_5":13150,"_26023":50286,"_2643":50390},[],"`issuance_profile` embedded in the request",{"_3144":1804,"_27488":1762,"_19100":50392,"_5":13150,"_26023":50286,"_2643":50393},[],"Request `issuance_profile_id`",{"_3144":1805,"_27488":1762,"_19100":50395,"_5":13150,"_26023":50286,"_2643":50396},[],"CA default profile (`profile_id`).",{"_3144":1806,"_27488":1762,"_19100":50398,"_5":13150,"_26023":50286,"_2643":50399},[],"Issuance through a DMS",{"_3144":1807,"_27488":1762,"_19100":50401,"_5":13150,"_26023":50286,"_2643":50402},[],"`settings.issuance_profile_id`",{"_3144":1808,"_27488":1762,"_19100":50404,"_5":13150,"_26023":50286,"_2643":50405},[],"`settings.issuance_profile` embedded in the DMS",{"_3144":1809,"_27488":1762,"_19100":50407,"_5":13150,"_26023":50286,"_2643":50408},[],"Enrollment CA default profile.",{"_3144":1810,"_27488":1762,"_19100":50410,"_5":13150,"_26023":50286,"_2643":50411},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3144":1811,"_27488":1762,"_19100":50413,"_5":13150,"_26023":50286,"_2643":50414},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3144":1812,"_27488":1762,"_19100":50416,"_5":13150,"_26023":50294,"_2643":50417},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3144":1813,"_27488":1762,"_19100":50419,"_5":13150,"_26023":50298,"_2643":50420},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3144":1814,"_27488":1762,"_19100":50422,"_5":13150,"_26023":50302,"_2643":50423},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3144":1815,"_27488":1762,"_19100":50425,"_5":13150,"_26023":50306,"_2643":50426},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3144":1816,"_27488":1762,"_19100":50428,"_5":13150,"_26023":50310,"_2643":50429},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3144":1817,"_27488":1762,"_19100":50431,"_5":13150,"_26023":50310,"_2643":50432},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3144":1818,"_27488":1762,"_19100":50434,"_5":13150,"_26023":50314,"_2643":50435},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3144":1819,"_27488":1762,"_19100":50437,"_5":13150,"_26023":50314,"_2643":50438},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3144":1820,"_27488":1762,"_19100":50440,"_5":13150,"_26023":50314,"_2643":50441},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3144":1821,"_27488":1762,"_19100":50443,"_5":13150,"_26023":50314,"_2643":50444},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3144":1822,"_27488":1762,"_19100":50446,"_5":13150,"_26023":50318,"_2643":50447},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3144":1823,"_27488":1762,"_19100":50449,"_5":13150,"_26023":50318,"_2643":50450},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3144":1824,"_27488":1824,"_5":13476,"_2643":50452,"_27831":50453,"_19100":50455,"_26023":1824},"Certificate validation",[44764,46144,49837,50454],"Validation",[],{"_3144":1825,"_27488":1824,"_19100":50457,"_5":13150,"_26023":1824,"_2643":50458},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3144":1826,"_27488":1824,"_5":27828,"_19100":50460,"_26023":50461,"_2643":50462},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3144":1827,"_27488":1824,"_5":27828,"_19100":50464,"_26023":50465,"_2643":50466},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3144":1828,"_27488":1824,"_5":27828,"_19100":50468,"_26023":50469,"_2643":50470},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3144":1829,"_27488":1824,"_19100":50472,"_5":13150,"_26023":1824,"_2643":50473},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3144":1830,"_27488":1824,"_19100":50475,"_5":13150,"_26023":50461,"_2643":50476},[],"Verify these criteria together:",{"_3144":1831,"_27488":1824,"_19100":50478,"_5":13150,"_26023":50461,"_2643":49461},[],{"_3144":1832,"_27488":1824,"_19100":50480,"_5":13150,"_26023":50461,"_2643":50481},[],"Required result",{"_3144":1833,"_27488":1824,"_19100":50483,"_5":13150,"_26023":50461,"_2643":50484},[],"Chain and signature",{"_3144":1834,"_27488":1824,"_19100":50486,"_5":13150,"_26023":50461,"_2643":50487},[],"Valid chain to a root deliberately installed in the consumer.",{"_3144":1835,"_27488":1824,"_19100":50489,"_5":13150,"_26023":50461,"_2643":50490},[],"Dates",{"_3144":1836,"_27488":1824,"_19100":50492,"_5":13150,"_26023":50461,"_2643":50493},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3144":1837,"_27488":1824,"_19100":50495,"_5":13150,"_26023":50461,"_2643":45844},[],{"_3144":1838,"_27488":1824,"_19100":50497,"_5":13150,"_26023":50461,"_2643":50498},[],"Name, SAN or identifier matches the expected peer.",{"_3144":1839,"_27488":1824,"_19100":50500,"_5":13150,"_26023":50461,"_2643":45154},[],{"_3144":1840,"_27488":1824,"_19100":50502,"_5":13150,"_26023":50461,"_2643":50503},[],"KU, EKU and constraints permit the specific operation.",{"_3144":1841,"_27488":1824,"_19100":50505,"_5":13150,"_26023":50461,"_2643":50506},[],"Revocation",{"_3144":1842,"_27488":1824,"_19100":50508,"_5":13150,"_26023":50461,"_2643":50509},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3144":1843,"_27488":1824,"_19100":50511,"_5":13150,"_26023":50461,"_2643":50512},[],"Authorization",{"_3144":1844,"_27488":1824,"_19100":50514,"_5":13150,"_26023":50461,"_2643":50515},[],"The application permits that identity to perform the action.",{"_3144":1845,"_27488":1824,"_19100":50517,"_5":13150,"_26023":50461,"_2643":50518},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3144":1846,"_27488":1824,"_19100":50520,"_5":13150,"_26023":50465,"_2643":50521},[],"Mechanism",{"_3144":1847,"_27488":1824,"_19100":50523,"_5":13150,"_26023":50465,"_2643":50524},[],"When to use it",{"_3144":1848,"_27488":1824,"_19100":50526,"_5":13150,"_26023":50465,"_2643":50527},[],"What you must maintain",{"_3144":1849,"_27488":1824,"_19100":50529,"_5":13150,"_26023":50465,"_2643":50530},[],"OCSP",{"_3144":1850,"_27488":1824,"_19100":50532,"_5":13150,"_26023":50465,"_2643":50533},[],"Status query for a specific certificate.",{"_3144":1851,"_27488":1824,"_19100":50535,"_5":13150,"_26023":50465,"_2643":50536},[],"Responder access, signature verification and cache/freshness policy.",{"_3144":1852,"_27488":1824,"_19100":50538,"_5":13150,"_26023":50465,"_2643":50539},[],"CRL",{"_3144":1853,"_27488":1824,"_19100":50541,"_5":13150,"_26023":50465,"_2643":50542},[],"Local checks for many certificates or offline operation.",{"_3144":1854,"_27488":1824,"_19100":50544,"_5":13150,"_26023":50465,"_2643":50545},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3144":1855,"_27488":1824,"_19100":50547,"_5":13150,"_26023":50465,"_2643":50548},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3144":1856,"_27488":1824,"_19100":50550,"_5":13150,"_26023":50465,"_2643":50551},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3144":1857,"_27488":1824,"_19100":50553,"_5":13150,"_26023":50469,"_2643":50554},[],"Accept a current, authorized certificate with a known chain.",{"_3144":1858,"_27488":1824,"_19100":50556,"_5":13150,"_26023":50469,"_2643":50557},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3144":1859,"_27488":1824,"_19100":50559,"_5":13150,"_26023":50469,"_2643":50560},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3144":1860,"_27488":1824,"_19100":50562,"_5":13150,"_26023":50469,"_2643":50563},[],"Check that a new connection with that identity is rejected.",{"_3144":1861,"_27488":1824,"_19100":50565,"_5":13150,"_26023":50469,"_2643":50566},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3144":1862,"_27488":1824,"_19100":50568,"_5":13150,"_26023":50469,"_2643":50569},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3144":1863,"_27488":1824,"_19100":50571,"_5":13150,"_26023":50469,"_2643":50572},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3144":1864,"_27488":1824,"_19100":50574,"_5":13150,"_26023":50469,"_2643":50575},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3144":1865,"_27488":1824,"_19100":50577,"_5":13150,"_26023":50469,"_2643":50578},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3144":1866,"_27488":1866,"_5":13476,"_2643":50580,"_27831":50581,"_19100":50582,"_26023":1866},"Certificates",[44764,46144,49837,49838],[],{"_3144":1867,"_27488":1866,"_19100":50584,"_5":13150,"_26023":1866,"_2643":50585},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3144":1868,"_27488":1866,"_5":27828,"_19100":50587,"_26023":50588,"_2643":50589},[],"/docs/pr-preview/pr-26/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3144":1869,"_27488":1866,"_5":27828,"_19100":50591,"_26023":50592,"_2643":50593},[],"/docs/pr-preview/pr-26/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3144":1870,"_27488":1866,"_5":27828,"_19100":50595,"_26023":50596,"_2643":50597},[],"/docs/pr-preview/pr-26/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3144":1871,"_27488":1866,"_5":27828,"_19100":50599,"_26023":50600,"_2643":50601},[],"/docs/pr-preview/pr-26/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3144":1872,"_27488":1866,"_5":27828,"_19100":50603,"_26023":50604,"_2643":50605},[],"/docs/pr-preview/pr-26/platform/pki/certificates#open-the-action","Open the action",{"_3144":1873,"_27488":1866,"_5":27828,"_19100":50607,"_26023":50608,"_2643":50609},[],"/docs/pr-preview/pr-26/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3144":1874,"_27488":1866,"_5":27828,"_19100":50611,"_26023":50612,"_2643":50613},[],"/docs/pr-preview/pr-26/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3144":1875,"_27488":1866,"_5":27828,"_19100":50615,"_26023":50616,"_2643":50617},[],"/docs/pr-preview/pr-26/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3144":1876,"_27488":1866,"_5":27828,"_19100":50619,"_26023":50620,"_2643":50621},[],"/docs/pr-preview/pr-26/platform/pki/certificates#continue","Continue",{"_3144":1877,"_27488":1866,"_19100":50623,"_5":13150,"_26023":1866,"_2643":50624},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3144":1878,"_27488":1866,"_19100":50626,"_5":13150,"_26023":50588,"_2643":50627},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3144":1879,"_27488":1866,"_19100":50629,"_5":13150,"_26023":50588,"_2643":50630},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3144":1880,"_27488":1866,"_19100":50632,"_5":13150,"_26023":50592,"_2643":50633},[],"Download the PEM and inspect it:",{"_3144":1881,"_27488":1866,"_19100":50635,"_5":13150,"_26023":50592,"_2643":50636},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3144":1882,"_27488":1866,"_19100":50638,"_5":13150,"_26023":50596,"_2643":50639},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3144":1883,"_27488":1866,"_19100":50641,"_5":13150,"_26023":50596,"_2643":50642},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3144":1884,"_27488":1866,"_19100":50644,"_5":13150,"_26023":50596,"_2643":50645},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3144":1885,"_27488":1866,"_19100":50647,"_5":13150,"_26023":50596,"_2643":50648},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3144":1886,"_27488":1866,"_19100":50650,"_5":13150,"_26023":50596,"_2643":50651},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3144":1887,"_27488":1866,"_19100":50653,"_5":13150,"_26023":50596,"_2643":50654},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3144":1888,"_27488":1866,"_19100":50656,"_5":13150,"_26023":50596,"_2643":50657},[],"For browser key generation, follow Issue your first certificate.",{"_3144":1889,"_27488":1866,"_19100":50659,"_5":13150,"_26023":50600,"_2643":50660},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3144":1890,"_27488":1866,"_19100":50662,"_5":13150,"_26023":50604,"_2643":50663},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3144":1891,"_27488":1866,"_19100":50665,"_5":13150,"_26023":50608,"_2643":50666},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3144":1892,"_27488":1866,"_19100":50668,"_5":13150,"_26023":50612,"_2643":50669},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3144":1893,"_27488":1866,"_19100":50671,"_5":13150,"_26023":50612,"_2643":50672},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3144":1894,"_27488":1866,"_19100":50674,"_5":13150,"_26023":50612,"_2643":50675},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3144":1895,"_27488":1866,"_19100":50677,"_5":13150,"_26023":50616,"_2643":50678},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3144":1896,"_27488":1866,"_19100":50680,"_5":13150,"_26023":50616,"_2643":50681},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3144":1897,"_27488":1866,"_19100":50683,"_5":13150,"_26023":50616,"_2643":50684},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3144":1898,"_27488":1866,"_19100":50686,"_5":13150,"_26023":50620,"_2643":50687},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3144":1899,"_27488":1866,"_19100":50689,"_5":13150,"_26023":50620,"_2643":50690},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3144":1900,"_27488":1900,"_5":13476,"_2643":50692,"_27831":50693,"_19100":50695,"_26023":1900},"Certificate lifecycle",[44764,46144,49837,50694],"Concepts",[],{"_3144":1901,"_27488":1900,"_19100":50697,"_5":13150,"_26023":1900,"_2643":50698},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3144":1902,"_27488":1900,"_5":27828,"_19100":50700,"_26023":50701,"_2643":50702},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3144":1903,"_27488":1900,"_5":27828,"_19100":50704,"_26023":50705,"_2643":50706},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3144":1904,"_27488":1900,"_5":27828,"_19100":50708,"_26023":50709,"_2643":50710},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3144":1905,"_27488":1900,"_5":27828,"_19100":50712,"_26023":50713,"_2643":50714},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3144":1906,"_27488":1900,"_5":27828,"_19100":50716,"_26023":50717,"_2643":50718},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3144":1907,"_27488":1900,"_5":27828,"_19100":50720,"_26023":50721,"_2643":50722},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3144":1908,"_27488":1900,"_5":27828,"_19100":50724,"_26023":50725,"_2643":50726},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3144":1909,"_27488":1900,"_5":27828,"_19100":50728,"_26023":50729,"_2643":50730},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3144":1910,"_27488":1900,"_5":27828,"_19100":50732,"_26023":50733,"_2643":50734},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3144":1911,"_27488":1900,"_5":27828,"_19100":50736,"_26023":50737,"_2643":50738},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3144":1912,"_27488":1900,"_19100":50740,"_5":13150,"_26023":1900,"_2643":50741},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3144":1913,"_27488":1900,"_19100":50743,"_5":13150,"_26023":50705,"_2643":50744},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3144":1914,"_27488":1900,"_19100":50746,"_5":13150,"_26023":50709,"_2643":50747},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3144":1915,"_27488":1900,"_19100":50749,"_5":13150,"_26023":50713,"_2643":50750},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3144":1916,"_27488":1900,"_19100":50752,"_5":13150,"_26023":50717,"_2643":50753},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3144":1917,"_27488":1900,"_19100":50755,"_5":13150,"_26023":50721,"_2643":50756},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3144":1918,"_27488":1900,"_19100":50758,"_5":13150,"_26023":50725,"_2643":50759},[],"Lamassu persists four X.509 states:",{"_3144":1919,"_27488":1900,"_19100":50761,"_5":13150,"_26023":50725,"_2643":50762},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3144":1920,"_27488":1900,"_19100":50764,"_5":13150,"_26023":50725,"_2643":50765},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3144":1921,"_27488":1900,"_19100":50767,"_5":13150,"_26023":50725,"_2643":50768},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3144":1922,"_27488":1900,"_19100":50770,"_5":13150,"_26023":50725,"_2643":50771},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3144":1923,"_27488":1900,"_19100":50773,"_5":13150,"_26023":50725,"_2643":50774},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3144":1924,"_27488":1900,"_19100":50776,"_5":13150,"_26023":50729,"_2643":50777},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3144":1925,"_27488":1900,"_19100":50779,"_5":13150,"_26023":50729,"_2643":50780},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3144":1926,"_27488":1900,"_19100":50782,"_5":13150,"_26023":50729,"_2643":50783},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3144":1927,"_27488":1900,"_19100":50785,"_5":13150,"_26023":50733,"_2643":50786},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3144":1928,"_27488":1900,"_19100":50788,"_5":13150,"_26023":50733,"_2643":50789},[],"Before confirming:",{"_3144":1929,"_27488":1900,"_19100":50791,"_5":13150,"_26023":50733,"_2643":50792},[],"Identify DMSs, devices and services that trust that chain.",{"_3144":1930,"_27488":1900,"_19100":50794,"_5":13150,"_26023":50733,"_2643":50795},[],"Distribute the new chain of trust.",{"_3144":1931,"_27488":1900,"_19100":50797,"_5":13150,"_26023":50733,"_2643":50798},[],"Reissue the necessary identities.",{"_3144":1932,"_27488":1900,"_19100":50800,"_5":13150,"_26023":50733,"_2643":50801},[],"Check OCSP and CRL from a real consumer.",{"_3144":1933,"_27488":1900,"_19100":50803,"_5":13150,"_26023":50733,"_2643":50804},[],"Revoke the old CA once no legitimate traffic remains.",{"_3144":1934,"_27488":1900,"_19100":50806,"_5":13150,"_26023":50733,"_2643":50807},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3144":1935,"_27488":1900,"_19100":50809,"_5":13150,"_26023":50737,"_2643":50810},[],"Certificates entering the preventive or critical renewal window.",{"_3144":1936,"_27488":1900,"_19100":50812,"_5":13150,"_26023":50737,"_2643":50813},[],"Repeated enrollment or re-enrollment failures.",{"_3144":1937,"_27488":1900,"_19100":50815,"_5":13150,"_26023":50737,"_2643":50816},[],"Status changes and revocation reasons.",{"_3144":1938,"_27488":1900,"_19100":50818,"_5":13150,"_26023":50737,"_2643":50819},[],"OCSP and CRL publication and validity.",{"_3144":1939,"_27488":1900,"_19100":50821,"_5":13150,"_26023":50737,"_2643":50822},[],"Dependencies still presenting a replaced certificate.",{"_3144":1940,"_27488":1900,"_19100":50824,"_5":13150,"_26023":50737,"_2643":50825},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3144":1941,"_27488":1941,"_5":13476,"_2643":50827,"_27831":50828,"_19100":50829,"_26023":1941},"Trust model",[44764,46144,49837,50694],[],{"_3144":1942,"_27488":1941,"_19100":50831,"_5":13150,"_26023":1941,"_2643":50832},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3144":1943,"_27488":1941,"_5":27828,"_19100":50834,"_26023":50835,"_2643":50836},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3144":1944,"_27488":1941,"_5":27828,"_19100":50838,"_26023":50839,"_2643":50840},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3144":1945,"_27488":1941,"_5":27828,"_19100":50842,"_26023":50843,"_2643":50844},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3144":1946,"_27488":1941,"_5":27828,"_19100":50846,"_26023":50847,"_2643":50848},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3144":1947,"_27488":1941,"_5":27828,"_19100":50850,"_26023":50851,"_2643":50852},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3144":1948,"_27488":1941,"_5":27828,"_19100":50854,"_26023":50855,"_2643":50856},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3144":1949,"_27488":1941,"_5":27828,"_19100":50858,"_26023":50859,"_2643":50860},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3144":1950,"_27488":1941,"_5":27828,"_19100":50862,"_26023":50863,"_2643":50864},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3144":1951,"_27488":1941,"_5":27828,"_19100":50866,"_26023":50867,"_2643":50868},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3144":1952,"_27488":1941,"_5":27828,"_19100":50870,"_26023":50871,"_2643":50872},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3144":1953,"_27488":1941,"_19100":50874,"_5":13150,"_26023":1941,"_2643":50875},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3144":1954,"_27488":1941,"_19100":50877,"_5":13150,"_26023":50839,"_2643":50878},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3144":1955,"_27488":1941,"_19100":50880,"_5":13150,"_26023":50843,"_2643":50881},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3144":1956,"_27488":1941,"_19100":50883,"_5":13150,"_26023":50847,"_2643":50884},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3144":1957,"_27488":1941,"_19100":50886,"_5":13150,"_26023":50851,"_2643":50887},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3144":1958,"_27488":1941,"_19100":50889,"_5":13150,"_26023":50855,"_2643":50890},[],"The device proves it can enroll according to the DMS policy.",{"_3144":1959,"_27488":1941,"_19100":50892,"_5":13150,"_26023":50855,"_2643":50893},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3144":1960,"_27488":1941,"_19100":50895,"_5":13150,"_26023":50855,"_2643":50896},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3144":1961,"_27488":1941,"_19100":50898,"_5":13150,"_26023":50855,"_2643":50899},[],"The device installs the certificate and the chain it needs.",{"_3144":1962,"_27488":1941,"_19100":50901,"_5":13150,"_26023":50855,"_2643":50902},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3144":1963,"_27488":1941,"_19100":50904,"_5":13150,"_26023":50855,"_2643":50905},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3144":1964,"_27488":1941,"_19100":50907,"_5":13150,"_26023":50859,"_2643":50908},[],"A DMS relates three sets that are worth designing separately:",{"_3144":1965,"_27488":1941,"_19100":50910,"_5":13150,"_26023":50859,"_2643":50911},[],"**Enrollment CA:** signs the new identities.",{"_3144":1966,"_27488":1941,"_19100":50913,"_5":13150,"_26023":50859,"_2643":50914},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_3144":1967,"_27488":1941,"_19100":50916,"_5":13150,"_26023":50859,"_2643":50917},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3144":1968,"_27488":1941,"_19100":50919,"_5":13150,"_26023":50859,"_2643":50920},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3144":1969,"_27488":1941,"_19100":50922,"_5":13150,"_26023":50863,"_2643":50923},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3144":1970,"_27488":1941,"_19100":50925,"_5":13150,"_26023":50863,"_2643":50926},[],"that the current date is between `Not Before` and `Not After`;",{"_3144":1971,"_27488":1941,"_19100":50928,"_5":13150,"_26023":50863,"_2643":50929},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3144":1972,"_27488":1941,"_19100":50931,"_5":13150,"_26023":50863,"_2643":50932},[],"that names, SANs and subject match the expected identity;",{"_3144":1973,"_27488":1941,"_19100":50934,"_5":13150,"_26023":50863,"_2643":50935},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3144":1974,"_27488":1941,"_19100":50937,"_5":13150,"_26023":50863,"_2643":50938},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3144":1975,"_27488":1941,"_19100":50940,"_5":13150,"_26023":50863,"_2643":50941},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3144":1976,"_27488":1941,"_19100":50943,"_5":13150,"_26023":50867,"_2643":50944},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3144":1977,"_27488":1941,"_19100":50946,"_5":13150,"_26023":50871,"_2643":50947},[],"Keep the root out of daily operations, or with very restricted access.",{"_3144":1978,"_27488":1941,"_19100":50949,"_5":13150,"_26023":50871,"_2643":50950},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3144":1979,"_27488":1941,"_19100":50952,"_5":13150,"_26023":50871,"_2643":50953},[],"Assign explicit profiles to every use case.",{"_3144":1980,"_27488":1941,"_19100":50955,"_5":13150,"_26023":50871,"_2643":50956},[],"Distribute the new trust before starting a rotation.",{"_3144":1981,"_27488":1941,"_19100":50958,"_5":13150,"_26023":50871,"_2643":50959},[],"Keep enough overlap to renew a disconnected fleet.",{"_3144":1982,"_27488":1941,"_19100":50961,"_5":13150,"_26023":50871,"_2643":50962},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3144":1983,"_27488":1941,"_19100":50964,"_5":13150,"_26023":50871,"_2643":50965},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3144":1984,"_27488":1984,"_5":13476,"_2643":50967,"_27831":50968,"_19100":50969,"_26023":1984},"Revocation lists (CRL)",[44764,46144,49837,50454],[],{"_3144":1985,"_27488":1984,"_19100":50971,"_5":13150,"_26023":1984,"_2643":50972},[],"Generate and distribute signed lists to validate certificates offline.",{"_3144":1986,"_27488":1984,"_5":27828,"_19100":50974,"_26023":50975,"_2643":50976},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3144":1987,"_27488":1984,"_5":27828,"_19100":50978,"_26023":50979,"_2643":50980},[],"/docs/pr-preview/pr-26/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3144":1988,"_27488":1984,"_5":27828,"_19100":50982,"_26023":50983,"_2643":50984},[],"/docs/pr-preview/pr-26/platform/pki/crl#crl-contents","CRL contents",{"_3144":1989,"_27488":1984,"_5":27828,"_19100":50986,"_26023":50987,"_2643":50988},[],"/docs/pr-preview/pr-26/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3144":1990,"_27488":1984,"_5":27828,"_19100":50990,"_26023":50991,"_2643":50992},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-management-api","VA role management API",{"_3144":1991,"_27488":1984,"_5":27828,"_19100":50994,"_26023":50995,"_2643":50996},[],"/docs/pr-preview/pr-26/platform/pki/crl#from-the-interface","From the interface",{"_3144":1992,"_27488":1984,"_5":27828,"_19100":50998,"_26023":50999,"_2643":51000},[],"/docs/pr-preview/pr-26/platform/pki/crl#references","References",{"_3144":1993,"_27488":1984,"_19100":51002,"_5":13150,"_26023":1984,"_2643":51003},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3144":1994,"_27488":1984,"_19100":51005,"_5":13150,"_26023":50975,"_2643":51006},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3144":1995,"_27488":1984,"_19100":51008,"_5":13150,"_26023":50975,"_2643":51009},[],"`crl_options` field",{"_3144":1996,"_27488":1984,"_19100":51011,"_5":13150,"_26023":50975,"_2643":45154},[],{"_3144":1997,"_27488":1984,"_19100":51013,"_5":13150,"_26023":50975,"_2643":51014},[],"Backend initial value",{"_3144":1998,"_27488":1984,"_19100":51016,"_5":13150,"_26023":50975,"_2643":51017},[],"`validity`",{"_3144":1999,"_27488":1984,"_19100":51019,"_5":13150,"_26023":50975,"_2643":51020},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3144":2000,"_27488":1984,"_19100":51022,"_5":13150,"_26023":50975,"_2643":51023},[],"7 days.",{"_3144":2001,"_27488":1984,"_19100":51025,"_5":13150,"_26023":50975,"_2643":51026},[],"`refresh_interval`",{"_3144":2002,"_27488":1984,"_19100":51028,"_5":13150,"_26023":50975,"_2643":51029},[],"Time since publication that triggers scheduled renewal.",{"_3144":2003,"_27488":1984,"_19100":51031,"_5":13150,"_26023":50975,"_2643":51032},[],"6 days and 23 hours.",{"_3144":2004,"_27488":1984,"_19100":51034,"_5":13150,"_26023":50975,"_2643":51035},[],"`regenerate_on_revoke`",{"_3144":2005,"_27488":1984,"_19100":51037,"_5":13150,"_26023":50975,"_2643":51038},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3144":2006,"_27488":1984,"_19100":51040,"_5":13150,"_26023":50975,"_2643":51041},[],"`true`.",{"_3144":2007,"_27488":1984,"_19100":51043,"_5":13150,"_26023":50975,"_2643":51044},[],"`subject_key_id_signer`",{"_3144":2008,"_27488":1984,"_19100":51046,"_5":13150,"_26023":50975,"_2643":51047},[],"Configuration field initialized with the CA’s SKI.",{"_3144":2009,"_27488":1984,"_19100":51049,"_5":13150,"_26023":50975,"_2643":51050},[],"CA SKI.",{"_3144":2010,"_27488":1984,"_19100":51052,"_5":13150,"_26023":50975,"_2643":51053},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3144":2011,"_27488":1984,"_19100":51055,"_5":13150,"_26023":50975,"_2643":51056},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3144":2012,"_27488":1984,"_19100":51058,"_5":13150,"_26023":50979,"_2643":51059},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3144":2013,"_27488":1984,"_19100":51061,"_5":13150,"_26023":50979,"_2643":51062},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3144":2014,"_27488":1984,"_19100":51064,"_5":13150,"_26023":50979,"_2643":51065},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3144":2015,"_27488":1984,"_19100":51067,"_5":13150,"_26023":50983,"_2643":51068},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3144":2016,"_27488":1984,"_19100":51070,"_5":13150,"_26023":50983,"_2643":51071},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3144":2017,"_27488":1984,"_19100":51073,"_5":13150,"_26023":50987,"_2643":51074},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3144":2018,"_27488":1984,"_19100":51076,"_5":13150,"_26023":50987,"_2643":51077},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3144":2019,"_27488":1984,"_19100":51079,"_5":13150,"_26023":50987,"_2643":51080},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3144":2020,"_27488":1984,"_19100":51082,"_5":13150,"_26023":50987,"_2643":51083},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3144":2021,"_27488":1984,"_19100":51085,"_5":13150,"_26023":50987,"_2643":51086},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3144":2022,"_27488":1984,"_19100":51088,"_5":13150,"_26023":50991,"_2643":51089},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3144":2023,"_27488":1984,"_19100":51091,"_5":13150,"_26023":50991,"_2643":47868},[],{"_3144":2024,"_27488":1984,"_19100":51093,"_5":13150,"_26023":50991,"_2643":51094},[],"Relative path",{"_3144":2025,"_27488":1984,"_19100":51096,"_5":13150,"_26023":50991,"_2643":47865},[],{"_3144":2026,"_27488":1984,"_19100":51098,"_5":13150,"_26023":50991,"_2643":51099},[],"`GET`",{"_3144":2027,"_27488":1984,"_19100":51101,"_5":13150,"_26023":50991,"_2643":51102},[],"`/v1/roles/{ca-ski}`",{"_3144":2028,"_27488":1984,"_19100":51104,"_5":13150,"_26023":50991,"_2643":51105},[],"Read `crl_options` and `latest_crl`.",{"_3144":2029,"_27488":1984,"_19100":51107,"_5":13150,"_26023":50991,"_2643":51108},[],"`PUT`",{"_3144":2030,"_27488":1984,"_19100":51110,"_5":13150,"_26023":50991,"_2643":51102},[],{"_3144":2031,"_27488":1984,"_19100":51112,"_5":13150,"_26023":50991,"_2643":51113},[],"Replace CRL configuration.",{"_3144":2032,"_27488":1984,"_19100":51115,"_5":13150,"_26023":50991,"_2643":51116},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3144":2033,"_27488":1984,"_19100":51118,"_5":13150,"_26023":50991,"_2643":51119},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3144":2034,"_27488":1984,"_19100":51121,"_5":13150,"_26023":50995,"_2643":51122},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3144":2035,"_27488":1984,"_19100":51124,"_5":13150,"_26023":50999,"_2643":51125},[],"RFC 5280: X.509 and CRL profile.",{"_3144":2036,"_27488":1984,"_19100":51127,"_5":13150,"_26023":50999,"_2643":51128},[],"OpenSSL: openssl-crl.",{"_3144":2037,"_27488":1984,"_19100":51130,"_5":13150,"_26023":50999,"_2643":51131},[],"OpenSSL: openssl-verify.",{"_3144":2038,"_27488":1984,"_19100":51133,"_5":13150,"_26023":50999,"_2643":51134},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3144":2039,"_27488":1984,"_19100":51136,"_5":13150,"_26023":50999,"_2643":51137},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3144":2040,"_27488":2040,"_5":13476,"_2643":51139,"_27831":51140,"_19100":51141,"_26023":2040},"Keys and cryptographic engines",[44764,46144,49837,49838],[],{"_3144":2041,"_27488":2040,"_19100":51143,"_5":13150,"_26023":2040,"_2643":51144},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3144":2042,"_27488":2040,"_5":27828,"_19100":51146,"_26023":51147,"_2643":51148},[],"/docs/pr-preview/pr-26/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3144":2043,"_27488":2040,"_5":27828,"_19100":51150,"_26023":51151,"_2643":51152},[],"/docs/pr-preview/pr-26/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3144":2044,"_27488":2040,"_5":27828,"_19100":51154,"_26023":51155,"_2643":51156},[],"/docs/pr-preview/pr-26/platform/pki/key-management#file-system","File System",{"_3144":2045,"_27488":2040,"_5":27828,"_19100":51158,"_26023":51159,"_2643":51160},[],"/docs/pr-preview/pr-26/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3144":2046,"_27488":2040,"_5":27828,"_19100":51162,"_26023":51163,"_2643":51164},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3144":2047,"_27488":2040,"_5":27828,"_19100":51166,"_26023":51167,"_2643":51168},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-kms","AWS KMS",{"_3144":2048,"_27488":2040,"_5":27828,"_19100":51170,"_26023":51171,"_2643":51172},[],"/docs/pr-preview/pr-26/platform/pki/key-management#pkcs11","PKCS#11",{"_3144":2049,"_27488":2040,"_5":27828,"_19100":51174,"_26023":51175,"_2643":51176},[],"/docs/pr-preview/pr-26/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3144":2050,"_27488":2040,"_5":27828,"_19100":51178,"_26023":51179,"_2643":51180},[],"/docs/pr-preview/pr-26/platform/pki/key-management#key-inventory","Key inventory",{"_3144":2051,"_27488":2040,"_5":27828,"_19100":51182,"_26023":51183,"_2643":51184},[],"/docs/pr-preview/pr-26/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3144":2052,"_27488":2040,"_5":27828,"_19100":51186,"_26023":51187,"_2643":51188},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3144":2053,"_27488":2040,"_5":27828,"_19100":51190,"_26023":51191,"_2643":51192},[],"/docs/pr-preview/pr-26/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3144":2054,"_27488":2040,"_5":27828,"_19100":51194,"_26023":51195,"_2643":51196},[],"/docs/pr-preview/pr-26/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3144":2055,"_27488":2040,"_5":27828,"_19100":51198,"_26023":51199,"_2643":51200},[],"/docs/pr-preview/pr-26/platform/pki/key-management#view-details","View details",{"_3144":2056,"_27488":2040,"_5":27828,"_19100":51202,"_26023":51203,"_2643":51204},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3144":2057,"_27488":2040,"_5":27828,"_19100":51206,"_26023":51207,"_2643":51208},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign","Sign",{"_3144":2058,"_27488":2040,"_5":27828,"_19100":51210,"_26023":51211,"_2643":51212},[],"/docs/pr-preview/pr-26/platform/pki/key-management#verify","Verify",{"_3144":2059,"_27488":2040,"_5":27828,"_19100":51214,"_26023":51215,"_2643":51216},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3144":2060,"_27488":2040,"_5":27828,"_19100":51218,"_26023":51219,"_2643":51220},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3144":2061,"_27488":2040,"_5":27828,"_19100":51222,"_26023":51223,"_2643":51224},[],"/docs/pr-preview/pr-26/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3144":2062,"_27488":2040,"_19100":51226,"_5":13150,"_26023":2040,"_2643":51227},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3144":2063,"_27488":2040,"_19100":51229,"_5":13150,"_26023":2040,"_2643":51230},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3144":2064,"_27488":2040,"_19100":51232,"_5":13150,"_26023":51147,"_2643":51233},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3144":2065,"_27488":2040,"_19100":51235,"_5":13150,"_26023":51147,"_2643":51236},[],"In practice, it lets you:",{"_3144":2066,"_27488":2040,"_19100":51238,"_5":13150,"_26023":51147,"_2643":51239},[],"Generate new key pairs from Lamassu IoT.",{"_3144":2067,"_27488":2040,"_19100":51241,"_5":13150,"_26023":51147,"_2643":51242},[],"Import keys created externally.",{"_3144":2068,"_27488":2040,"_19100":51244,"_5":13150,"_26023":51147,"_2643":51245},[],"Delegate custody and cryptographic operations to external engines.",{"_3144":2069,"_27488":2040,"_19100":51247,"_5":13150,"_26023":51147,"_2643":51248},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3144":2070,"_27488":2040,"_19100":51250,"_5":13150,"_26023":51151,"_2643":51251},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3144":2071,"_27488":2040,"_19100":51253,"_5":13150,"_26023":51151,"_2643":51254},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3144":2072,"_27488":2040,"_19100":51256,"_5":13150,"_26023":51151,"_2643":51257},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3144":2073,"_27488":2040,"_19100":51259,"_5":13150,"_26023":51155,"_2643":51260},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3144":2074,"_27488":2040,"_19100":51262,"_5":13150,"_26023":51159,"_2643":51263},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3144":2075,"_27488":2040,"_19100":51265,"_5":13150,"_26023":51163,"_2643":51266},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3144":2076,"_27488":2040,"_19100":51268,"_5":13150,"_26023":51167,"_2643":51269},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3144":2077,"_27488":2040,"_19100":51271,"_5":13150,"_26023":51171,"_2643":51272},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3144":2078,"_27488":2040,"_19100":51274,"_5":13150,"_26023":51175,"_2643":51275},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3144":2079,"_27488":2040,"_19100":51277,"_5":13150,"_26023":51175,"_2643":51278},[],"Lamassu shows the enabled engines in the console.",{"_3144":2080,"_27488":2040,"_19100":51280,"_5":13150,"_26023":51175,"_2643":51281},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3144":2081,"_27488":2040,"_19100":51283,"_5":13150,"_26023":51175,"_2643":51284},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3144":2082,"_27488":2040,"_19100":51286,"_5":13150,"_26023":51179,"_2643":51287},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3144":2083,"_27488":2040,"_19100":51289,"_5":13150,"_26023":51179,"_2643":51290},[],"The table includes the following fields:",{"_3144":2084,"_27488":2040,"_19100":51292,"_5":13150,"_26023":51179,"_2643":51293},[],"**Name**: descriptive name of the key.",{"_3144":2085,"_27488":2040,"_19100":51295,"_5":13150,"_26023":51179,"_2643":51296},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3144":2086,"_27488":2040,"_19100":51298,"_5":13150,"_26023":51179,"_2643":51299},[],"**Strength**: visual indicator of cryptographic strength.",{"_3144":2087,"_27488":2040,"_19100":51301,"_5":13150,"_26023":51179,"_2643":51302},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3144":2088,"_27488":2040,"_19100":51304,"_5":13150,"_26023":51179,"_2643":51305},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3144":2089,"_27488":2040,"_19100":51307,"_5":13150,"_26023":51179,"_2643":51308},[],"**Aliases**: alternative names associated with the key.",{"_3144":2090,"_27488":2040,"_19100":51310,"_5":13150,"_26023":51179,"_2643":51311},[],"**Tags**: labels for classification and search.",{"_3144":2091,"_27488":2040,"_19100":51313,"_5":13150,"_26023":51179,"_2643":51314},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3144":2092,"_27488":2040,"_19100":51316,"_5":13150,"_26023":51179,"_2643":51317},[],"From this view you also reach the most common actions:",{"_3144":2093,"_27488":2040,"_19100":51319,"_5":13150,"_26023":51179,"_2643":51320},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3144":2094,"_27488":2040,"_19100":51322,"_5":13150,"_26023":51179,"_2643":51323},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3144":2095,"_27488":2040,"_19100":51325,"_5":13150,"_26023":51179,"_2643":51326},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3144":2096,"_27488":2040,"_19100":51328,"_5":13150,"_26023":51179,"_2643":51329},[],"**Delete Key** to remove the key from the system.",{"_3144":2097,"_27488":2040,"_19100":51331,"_5":13150,"_26023":51183,"_2643":51332},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3144":2098,"_27488":2040,"_19100":51334,"_5":13150,"_26023":51187,"_2643":51335},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3144":2099,"_27488":2040,"_19100":51337,"_5":13150,"_26023":51187,"_2643":51338},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3144":2100,"_27488":2040,"_19100":51340,"_5":13150,"_26023":51187,"_2643":51341},[],"**Key Name**: unique and descriptive name.",{"_3144":2101,"_27488":2040,"_19100":51343,"_5":13150,"_26023":51187,"_2643":51344},[],"**Crypto Engine**: engine that will keep the key.",{"_3144":2102,"_27488":2040,"_19100":51346,"_5":13150,"_26023":51187,"_2643":51347},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3144":2103,"_27488":2040,"_19100":51349,"_5":13150,"_26023":51187,"_2643":51350},[],"**Tags**: metadata to classify the key.",{"_3144":2104,"_27488":2040,"_19100":51352,"_5":13150,"_26023":51187,"_2643":51353},[],"**Metadata**: additional information for advanced uses.",{"_3144":2105,"_27488":2040,"_19100":51355,"_5":13150,"_26023":51191,"_2643":51356},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3144":2106,"_27488":2040,"_19100":51358,"_5":13150,"_26023":51191,"_2643":51359},[],"When you have an exportable private key and the destination engine supports import.",{"_3144":2107,"_27488":2040,"_19100":51361,"_5":13150,"_26023":51191,"_2643":51362},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3144":2108,"_27488":2040,"_19100":51364,"_5":13150,"_26023":51191,"_2643":51365},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3144":2109,"_27488":2040,"_19100":51367,"_5":13150,"_26023":51191,"_2643":51368},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3144":2110,"_27488":2040,"_19100":51370,"_5":13150,"_26023":51191,"_2643":51371},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3144":2111,"_27488":2040,"_19100":51373,"_5":13150,"_26023":51191,"_2643":51374},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3144":2112,"_27488":2040,"_19100":51376,"_5":13150,"_26023":51191,"_2643":51377},[],"**Tags**: labels for organization and search.",{"_3144":2113,"_27488":2040,"_19100":51379,"_5":13150,"_26023":51191,"_2643":51380},[],"**Metadata**: additional optional information.",{"_3144":2114,"_27488":2040,"_19100":51382,"_5":13150,"_26023":51191,"_2643":51383},[],"**Private Key (PEM)**: private key in PEM format.",{"_3144":2115,"_27488":2040,"_19100":51385,"_5":13150,"_26023":51191,"_2643":51386},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3144":2116,"_27488":2040,"_19100":51388,"_5":13150,"_26023":51195,"_2643":51389},[],"Each registered key has a detail view and several operational actions.",{"_3144":2117,"_27488":2040,"_19100":51391,"_5":13150,"_26023":51199,"_2643":51392},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3144":2118,"_27488":2040,"_19100":51394,"_5":13150,"_26023":51199,"_2643":51395},[],"The **Overview** tab shows, among others, these fields:",{"_3144":2119,"_27488":2040,"_19100":51397,"_5":13150,"_26023":51199,"_2643":51398},[],"**Key Name**: descriptive name.",{"_3144":2120,"_27488":2040,"_19100":51400,"_5":13150,"_26023":51199,"_2643":51401},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3144":2121,"_27488":2040,"_19100":51403,"_5":13150,"_26023":51199,"_2643":51404},[],"**Tags**: associated labels.",{"_3144":2122,"_27488":2040,"_19100":51406,"_5":13150,"_26023":51199,"_2643":51407},[],"**Aliases**: alternative names.",{"_3144":2123,"_27488":2040,"_19100":51409,"_5":13150,"_26023":51199,"_2643":51410},[],"**Crypto Engine**: engine where the key resides.",{"_3144":2124,"_27488":2040,"_19100":51412,"_5":13150,"_26023":51199,"_2643":51413},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3144":2125,"_27488":2040,"_19100":51415,"_5":13150,"_26023":51199,"_2643":51416},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3144":2126,"_27488":2040,"_19100":51418,"_5":13150,"_26023":51199,"_2643":51419},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3144":2127,"_27488":2040,"_19100":51421,"_5":13150,"_26023":51203,"_2643":51422},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3144":2128,"_27488":2040,"_19100":51424,"_5":13150,"_26023":51203,"_2643":51425},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3144":2129,"_27488":2040,"_19100":51427,"_5":13150,"_26023":51203,"_2643":51428},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3144":2130,"_27488":2040,"_19100":51430,"_5":13150,"_26023":51207,"_2643":51431},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3144":2131,"_27488":2040,"_19100":51433,"_5":13150,"_26023":51207,"_2643":51434},[],"Main fields:",{"_3144":2132,"_27488":2040,"_19100":51436,"_5":13150,"_26023":51207,"_2643":51437},[],"**Algorithm**: signing algorithm available for the key type.",{"_3144":2133,"_27488":2040,"_19100":51439,"_5":13150,"_26023":51207,"_2643":51440},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3144":2134,"_27488":2040,"_19100":51442,"_5":13150,"_26023":51207,"_2643":51443},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3144":2135,"_27488":2040,"_19100":51445,"_5":13150,"_26023":51207,"_2643":51446},[],"**Message**: content to sign.",{"_3144":2136,"_27488":2040,"_19100":51448,"_5":13150,"_26023":51207,"_2643":51449},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3144":2137,"_27488":2040,"_19100":51451,"_5":13150,"_26023":51211,"_2643":51452},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3144":2138,"_27488":2040,"_19100":51454,"_5":13150,"_26023":51211,"_2643":51434},[],{"_3144":2139,"_27488":2040,"_19100":51456,"_5":13150,"_26023":51211,"_2643":51457},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3144":2140,"_27488":2040,"_19100":51459,"_5":13150,"_26023":51211,"_2643":51460},[],"**Message Type**: `Raw` or `Digest`.",{"_3144":2141,"_27488":2040,"_19100":51462,"_5":13150,"_26023":51211,"_2643":51463},[],"**Payload Encoding**: encoding of the message.",{"_3144":2142,"_27488":2040,"_19100":51465,"_5":13150,"_26023":51211,"_2643":51466},[],"**Message**: original message or hash.",{"_3144":2143,"_27488":2040,"_19100":51468,"_5":13150,"_26023":51211,"_2643":51469},[],"**Signature**: signature to check.",{"_3144":2144,"_27488":2040,"_19100":51471,"_5":13150,"_26023":51211,"_2643":51472},[],"**Result**: indicator of the validation result.",{"_3144":2145,"_27488":2040,"_19100":51474,"_5":13150,"_26023":51215,"_2643":51475},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3144":2146,"_27488":2040,"_19100":51477,"_5":13150,"_26023":51215,"_2643":51478},[],"This flow is useful for:",{"_3144":2147,"_27488":2040,"_19100":51480,"_5":13150,"_26023":51215,"_2643":51481},[],"Requesting certificates from an external CA.",{"_3144":2148,"_27488":2040,"_19100":51483,"_5":13150,"_26023":51215,"_2643":51484},[],"Renewing an identity while keeping the same key.",{"_3144":2149,"_27488":2040,"_19100":51486,"_5":13150,"_26023":51215,"_2643":51487},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3144":2150,"_27488":2040,"_19100":51489,"_5":13150,"_26023":51215,"_2643":51490},[],"**Common Name (CN)**: main name of the identity.",{"_3144":2151,"_27488":2040,"_19100":51492,"_5":13150,"_26023":51215,"_2643":51493},[],"**Organization (O)**: organization or company.",{"_3144":2152,"_27488":2040,"_19100":51495,"_5":13150,"_26023":51215,"_2643":51496},[],"**Organizational Unit (OU)**: department or unit.",{"_3144":2153,"_27488":2040,"_19100":51498,"_5":13150,"_26023":51215,"_2643":51499},[],"**Country (C)**: two-letter country code.",{"_3144":2154,"_27488":2040,"_19100":51501,"_5":13150,"_26023":51215,"_2643":51502},[],"**State / Province (ST)**: state or province.",{"_3144":2155,"_27488":2040,"_19100":51504,"_5":13150,"_26023":51215,"_2643":51505},[],"**Locality (L)**: city or locality.",{"_3144":2156,"_27488":2040,"_19100":51507,"_5":13150,"_26023":51215,"_2643":51508},[],"**Email Address**: contact email.",{"_3144":2157,"_27488":2040,"_19100":51510,"_5":13150,"_26023":51215,"_2643":51511},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3144":2158,"_27488":2040,"_19100":51513,"_5":13150,"_26023":51215,"_2643":51514},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3144":2159,"_27488":2040,"_19100":51516,"_5":13150,"_26023":51219,"_2643":51517},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3144":2160,"_27488":2040,"_19100":51519,"_5":13150,"_26023":51219,"_2643":51520},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3144":2161,"_27488":2040,"_19100":51522,"_5":13150,"_26023":51223,"_2643":51523},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3144":2162,"_27488":2162,"_5":13476,"_2643":51525,"_27831":51526,"_19100":51527,"_26023":2162},"Online validation with OCSP",[44764,46144,49837,50454],[],{"_3144":2163,"_27488":2162,"_19100":51529,"_5":13150,"_26023":2162,"_2643":51530},[],"Query signed status and verify the responder’s response.",{"_3144":2164,"_27488":2162,"_5":27828,"_19100":51532,"_26023":51533,"_2643":51534},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3144":2165,"_27488":2162,"_5":27828,"_19100":51536,"_26023":51537,"_2643":51538},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3144":2166,"_27488":2162,"_5":27828,"_19100":51540,"_26023":51541,"_2643":51542},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3144":2167,"_27488":2162,"_5":27828,"_19100":51544,"_26023":51545,"_2643":51546},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3144":2168,"_27488":2162,"_5":27828,"_19100":51548,"_26023":51549,"_2643":51550},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3144":2169,"_27488":2162,"_5":27828,"_19100":51552,"_26023":51553,"_2643":51000},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#references",{"_3144":2170,"_27488":2162,"_19100":51555,"_5":13150,"_26023":2162,"_2643":51556},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3144":2171,"_27488":2162,"_19100":51558,"_5":13150,"_26023":51533,"_2643":51559},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3144":2172,"_27488":2162,"_19100":51561,"_5":13150,"_26023":51533,"_2643":51562},[],"Record status",{"_3144":2173,"_27488":2162,"_19100":51564,"_5":13150,"_26023":51533,"_2643":51565},[],"Signed response",{"_3144":2174,"_27488":2162,"_19100":51567,"_5":13150,"_26023":51533,"_2643":49015},[],{"_3144":2175,"_27488":2162,"_19100":51569,"_5":13150,"_26023":51533,"_2643":51570},[],"`Good`.",{"_3144":2176,"_27488":2162,"_19100":51572,"_5":13150,"_26023":51533,"_2643":49032},[],{"_3144":2177,"_27488":2162,"_19100":51574,"_5":13150,"_26023":51533,"_2643":51575},[],"`Revoked`, with revocation reason and timestamp.",{"_3144":2178,"_27488":2162,"_19100":51577,"_5":13150,"_26023":51533,"_2643":51578},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3144":2179,"_27488":2162,"_19100":51580,"_5":13150,"_26023":51533,"_2643":51581},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3144":2180,"_27488":2162,"_19100":51583,"_5":13150,"_26023":51533,"_2643":51584},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3144":2181,"_27488":2162,"_19100":51586,"_5":13150,"_26023":51533,"_2643":51587},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3144":2182,"_27488":2162,"_19100":51589,"_5":13150,"_26023":51533,"_2643":51590},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3144":2183,"_27488":2162,"_19100":51592,"_5":13150,"_26023":51537,"_2643":51593},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3144":2184,"_27488":2162,"_19100":51595,"_5":13150,"_26023":51537,"_2643":51596},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3144":2185,"_27488":2162,"_19100":51598,"_5":13150,"_26023":51541,"_2643":51599},[],"The service accepts:",{"_3144":2186,"_27488":2162,"_19100":51601,"_5":13150,"_26023":51541,"_2643":47868},[],{"_3144":2187,"_27488":2162,"_19100":51603,"_5":13150,"_26023":51541,"_2643":51604},[],"VA service path",{"_3144":2188,"_27488":2162,"_19100":51606,"_5":13150,"_26023":51541,"_2643":51607},[],"Format",{"_3144":2189,"_27488":2162,"_19100":51609,"_5":13150,"_26023":51541,"_2643":51610},[],"`POST`",{"_3144":2190,"_27488":2162,"_19100":51612,"_5":13150,"_26023":51541,"_2643":51613},[],"`/ocsp`",{"_3144":2191,"_27488":2162,"_19100":51615,"_5":13150,"_26023":51541,"_2643":51616},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3144":2192,"_27488":2162,"_19100":51618,"_5":13150,"_26023":51541,"_2643":51099},[],{"_3144":2193,"_27488":2162,"_19100":51620,"_5":13150,"_26023":51541,"_2643":51621},[],"`/ocsp/{ocsp_request}`",{"_3144":2194,"_27488":2162,"_19100":51623,"_5":13150,"_26023":51541,"_2643":51624},[],"DER request encoded using padded URL Base64.",{"_3144":2195,"_27488":2162,"_19100":51626,"_5":13150,"_26023":51541,"_2643":51627},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3144":2196,"_27488":2162,"_19100":51629,"_5":13150,"_26023":51545,"_2643":51630},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3144":2197,"_27488":2162,"_19100":51632,"_5":13150,"_26023":51545,"_2643":51633},[],"Generate the request:",{"_3144":2198,"_27488":2162,"_19100":51635,"_5":13150,"_26023":51545,"_2643":51636},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3144":2199,"_27488":2162,"_19100":51638,"_5":13150,"_26023":51545,"_2643":51639},[],"Replace the example URL with the inspected endpoint:",{"_3144":2200,"_27488":2162,"_19100":51641,"_5":13150,"_26023":51545,"_2643":51642},[],"Verify the returned DER:",{"_3144":2201,"_27488":2162,"_19100":51644,"_5":13150,"_26023":51545,"_2643":51645},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3144":2202,"_27488":2162,"_19100":51647,"_5":13150,"_26023":51549,"_2643":51648},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3144":2203,"_27488":2162,"_19100":51650,"_5":13150,"_26023":51549,"_2643":51651},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3144":2204,"_27488":2162,"_19100":51653,"_5":13150,"_26023":51553,"_2643":51654},[],"RFC 6960: OCSP.",{"_3144":2205,"_27488":2162,"_19100":51656,"_5":13150,"_26023":51553,"_2643":51657},[],"OpenSSL: openssl-ocsp.",{"_3144":2206,"_27488":2162,"_19100":51659,"_5":13150,"_26023":51553,"_2643":51660},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3144":2207,"_27488":2162,"_19100":51662,"_5":13150,"_26023":51553,"_2643":51137},[],{"_3144":2208,"_27488":2208,"_5":13476,"_2643":49837,"_27831":51664,"_19100":51665,"_26023":2208},[44764,46144,49837],[],{"_3144":2209,"_27488":2208,"_19100":51667,"_5":13150,"_26023":2208,"_2643":51668},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3144":2210,"_27488":2208,"_5":27828,"_19100":51670,"_26023":51671,"_2643":49147},[],"/docs/pr-preview/pr-26/platform/pki/overview#start-here",{"_3144":2211,"_27488":2208,"_5":27828,"_19100":51673,"_26023":51674,"_2643":51675},[],"/docs/pr-preview/pr-26/platform/pki/overview#what-you-need","What you need",{"_3144":2212,"_27488":2208,"_5":27828,"_19100":51677,"_26023":51678,"_2643":49681},[],"/docs/pr-preview/pr-26/platform/pki/overview#core-capabilities",{"_3144":2213,"_27488":2208,"_5":27828,"_19100":51680,"_26023":51681,"_2643":49685},[],"/docs/pr-preview/pr-26/platform/pki/overview#build-your-trust-hierarchy",{"_3144":2214,"_27488":2208,"_5":27828,"_19100":51683,"_26023":51684,"_2643":49689},[],"/docs/pr-preview/pr-26/platform/pki/overview#protect-cryptographic-keys",{"_3144":2215,"_27488":2208,"_5":27828,"_19100":51686,"_26023":51687,"_2643":49693},[],"/docs/pr-preview/pr-26/platform/pki/overview#issue-and-control-certificates",{"_3144":2216,"_27488":2208,"_5":27828,"_19100":51689,"_26023":51690,"_2643":49701},[],"/docs/pr-preview/pr-26/platform/pki/overview#publish-validation-status",{"_3144":2217,"_27488":2208,"_5":27828,"_19100":51692,"_26023":51693,"_2643":51694},[],"/docs/pr-preview/pr-26/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3144":2218,"_27488":2208,"_5":27828,"_19100":51696,"_26023":51697,"_2643":50621},[],"/docs/pr-preview/pr-26/platform/pki/overview#continue",{"_3144":2219,"_27488":2208,"_19100":51699,"_5":13150,"_26023":2208,"_2643":51700},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3144":2220,"_27488":2208,"_19100":51702,"_5":13150,"_26023":51671,"_2643":51703},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3144":2221,"_27488":2208,"_19100":51705,"_5":13150,"_26023":51671,"_2643":51706},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3144":2222,"_27488":2208,"_19100":51708,"_5":13150,"_26023":51674,"_2643":51709},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3144":2223,"_27488":2208,"_19100":51711,"_5":13150,"_26023":51674,"_2643":51712},[],"An available cryptographic engine to keep the authority's key.",{"_3144":2224,"_27488":2208,"_19100":51714,"_5":13150,"_26023":51674,"_2643":51715},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3144":2225,"_27488":2208,"_19100":51717,"_5":13150,"_26023":51674,"_2643":51718},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3144":2226,"_27488":2208,"_19100":51720,"_5":13150,"_26023":51674,"_2643":51721},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3144":2227,"_27488":2208,"_19100":51723,"_5":13150,"_26023":51681,"_2643":51724},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3144":2228,"_27488":2208,"_19100":51726,"_5":13150,"_26023":51684,"_2643":51727},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3144":2229,"_27488":2208,"_19100":51729,"_5":13150,"_26023":51687,"_2643":51730},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3144":2230,"_27488":2208,"_19100":51732,"_5":13150,"_26023":51690,"_2643":51733},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3144":2231,"_27488":2208,"_19100":51735,"_5":13150,"_26023":51693,"_2643":51736},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3144":2232,"_27488":2208,"_19100":51738,"_5":13150,"_26023":51693,"_2643":51739},[],"its subject and extensions identify the expected client;",{"_3144":2233,"_27488":2208,"_19100":51741,"_5":13150,"_26023":51693,"_2643":51742},[],"its public key matches the client's private key;",{"_3144":2234,"_27488":2208,"_19100":51744,"_5":13150,"_26023":51693,"_2643":51745},[],"its chain reaches a root trusted by the consumer;",{"_3144":2235,"_27488":2208,"_19100":51747,"_5":13150,"_26023":51693,"_2643":51748},[],"its dates and usages allow the operation;",{"_3144":2236,"_27488":2208,"_19100":51750,"_5":13150,"_26023":51693,"_2643":51751},[],"the consumer applies revocation checks and authorization.",{"_3144":2237,"_27488":2208,"_19100":51753,"_5":13150,"_26023":51693,"_2643":51754},[],"The issuance path includes the first independent checks.",{"_3144":2238,"_27488":2208,"_19100":51756,"_5":13150,"_26023":51697,"_2643":51757},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3144":2239,"_27488":2208,"_19100":51759,"_5":13150,"_26023":51697,"_2643":51760},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3144":2240,"_27488":2208,"_19100":51762,"_5":13150,"_26023":51697,"_2643":51763},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3144":2241,"_27488":2241,"_5":13476,"_2643":51765,"_27831":51766,"_19100":51767,"_26023":2241},"Create your first CA",[44764,46144,49837,49272],[],{"_3144":2242,"_27488":2241,"_19100":51769,"_5":13150,"_26023":2241,"_2643":51770},[],"Create an evaluation root and check its certificate before issuing.",{"_3144":2243,"_27488":2241,"_5":27828,"_19100":51772,"_26023":51773,"_2643":44774},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3144":2244,"_27488":2241,"_5":27828,"_19100":51775,"_26023":51776,"_2643":51777},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3144":2245,"_27488":2241,"_5":27828,"_19100":51779,"_26023":51780,"_2643":51781},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3144":2246,"_27488":2241,"_5":27828,"_19100":51783,"_26023":51784,"_2643":51785},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3144":2247,"_27488":2241,"_5":27828,"_19100":51787,"_26023":51788,"_2643":51789},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3144":2248,"_27488":2241,"_5":27828,"_19100":51791,"_26023":51792,"_2643":51793},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3144":2249,"_27488":2241,"_5":27828,"_19100":51795,"_26023":51796,"_2643":51797},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3144":2250,"_27488":2241,"_5":27828,"_19100":51799,"_26023":51800,"_2643":49530},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3144":2251,"_27488":2241,"_5":27828,"_19100":51802,"_26023":51803,"_2643":44798},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3144":2252,"_27488":2241,"_19100":51805,"_5":13150,"_26023":2241,"_2643":51806},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3144":2253,"_27488":2241,"_19100":51808,"_5":13150,"_26023":51773,"_2643":51809},[],"Console access and permission to create keys and authorities.",{"_3144":2254,"_27488":2241,"_19100":51811,"_5":13150,"_26023":51773,"_2643":51812},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3144":2255,"_27488":2241,"_19100":51814,"_5":13150,"_26023":51773,"_2643":51815},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3144":2256,"_27488":2241,"_19100":51817,"_5":13150,"_26023":51773,"_2643":51818},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3144":2257,"_27488":2241,"_19100":51820,"_5":13150,"_26023":51776,"_2643":51821},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3144":2258,"_27488":2241,"_19100":51823,"_5":13150,"_26023":51776,"_2643":51824},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3144":2259,"_27488":2241,"_19100":51826,"_5":13150,"_26023":51780,"_2643":51827},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3144":2260,"_27488":2241,"_19100":51829,"_5":13150,"_26023":51780,"_2643":51830},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3144":2261,"_27488":2241,"_19100":51832,"_5":13150,"_26023":51784,"_2643":51833},[],"Select **Root CA** and complete:",{"_3144":2262,"_27488":2241,"_19100":51835,"_5":13150,"_26023":51784,"_2643":51836},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3144":2263,"_27488":2241,"_19100":51838,"_5":13150,"_26023":51784,"_2643":51839},[],"**Subject**: organization and country details for your evaluation.",{"_3144":2264,"_27488":2241,"_19100":51841,"_5":13150,"_26023":51784,"_2643":51842},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3144":2265,"_27488":2241,"_19100":51844,"_5":13150,"_26023":51784,"_2643":51845},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3144":2266,"_27488":2241,"_19100":51847,"_5":13150,"_26023":51784,"_2643":51848},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3144":2267,"_27488":2241,"_19100":51850,"_5":13150,"_26023":51788,"_2643":51851},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3144":2268,"_27488":2241,"_19100":51853,"_5":13150,"_26023":51792,"_2643":51854},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3144":2269,"_27488":2241,"_19100":51856,"_5":13150,"_26023":51792,"_2643":51857},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3144":2270,"_27488":2241,"_19100":51859,"_5":13150,"_26023":51796,"_2643":51860},[],"Run from the directory where you saved `ca.pem`:",{"_3144":2271,"_27488":2241,"_19100":51862,"_5":13150,"_26023":51796,"_2643":51863},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3144":2272,"_27488":2241,"_19100":51865,"_5":13150,"_26023":51796,"_2643":51866},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3144":2273,"_27488":2241,"_19100":51868,"_5":13150,"_26023":51800,"_2643":51869},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3144":2274,"_27488":2241,"_19100":51871,"_5":13150,"_26023":51800,"_2643":51872},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3144":2275,"_27488":2241,"_19100":51874,"_5":13150,"_26023":51800,"_2643":51875},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3144":2276,"_27488":2241,"_19100":51877,"_5":13150,"_26023":51800,"_2643":51878},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3144":2277,"_27488":2241,"_19100":51880,"_5":13150,"_26023":51803,"_2643":51881},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3144":2278,"_27488":2278,"_5":13476,"_2643":51883,"_27831":51884,"_19100":51885,"_26023":2278},"Issue and verify a certificate",[44764,46144,49837,49272],[],{"_3144":2279,"_27488":2278,"_19100":51887,"_5":13150,"_26023":2278,"_2643":51888},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3144":2280,"_27488":2278,"_5":27828,"_19100":51890,"_26023":51891,"_2643":44774},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3144":2281,"_27488":2278,"_5":27828,"_19100":51893,"_26023":51894,"_2643":51895},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3144":2282,"_27488":2278,"_5":27828,"_19100":51897,"_26023":51898,"_2643":51899},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3144":2283,"_27488":2278,"_5":27828,"_19100":51901,"_26023":51902,"_2643":51903},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3144":2284,"_27488":2278,"_5":27828,"_19100":51905,"_26023":51906,"_2643":51907},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3144":2285,"_27488":2278,"_5":27828,"_19100":51909,"_26023":51910,"_2643":51911},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3144":2286,"_27488":2278,"_5":27828,"_19100":51913,"_26023":51914,"_2643":51793},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3144":2287,"_27488":2278,"_5":27828,"_19100":51916,"_26023":51917,"_2643":51918},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3144":2288,"_27488":2278,"_5":27828,"_19100":51920,"_26023":51921,"_2643":51922},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3144":2289,"_27488":2278,"_5":27828,"_19100":51924,"_26023":51925,"_2643":51926},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3144":2290,"_27488":2278,"_5":27828,"_19100":51928,"_26023":51929,"_2643":49530},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3144":2291,"_27488":2278,"_5":27828,"_19100":51931,"_26023":51932,"_2643":44798},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#next-step",{"_3144":2292,"_27488":2278,"_19100":51934,"_5":13150,"_26023":2278,"_2643":51935},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3144":2293,"_27488":2278,"_19100":51937,"_5":13150,"_26023":51891,"_2643":51938},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3144":2294,"_27488":2278,"_19100":51940,"_5":13150,"_26023":51891,"_2643":51941},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3144":2295,"_27488":2278,"_19100":51943,"_5":13150,"_26023":51891,"_2643":51944},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3144":2296,"_27488":2278,"_19100":51946,"_5":13150,"_26023":51891,"_2643":51947},[],"A client identifier: here we use `device-001`.",{"_3144":2297,"_27488":2278,"_19100":51949,"_5":13150,"_26023":51891,"_2643":51950},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3144":2298,"_27488":2278,"_19100":51952,"_5":13150,"_26023":51894,"_2643":51953},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3144":2299,"_27488":2278,"_19100":51955,"_5":13150,"_26023":51898,"_2643":51956},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3144":2300,"_27488":2278,"_19100":51958,"_5":13150,"_26023":51898,"_2643":51959},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3144":2301,"_27488":2278,"_19100":51961,"_5":13150,"_26023":51902,"_2643":51962},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3144":2302,"_27488":2278,"_19100":51964,"_5":13150,"_26023":51902,"_2643":51965},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3144":2303,"_27488":2278,"_19100":51967,"_5":13150,"_26023":51906,"_2643":51968},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3144":2304,"_27488":2278,"_19100":51970,"_5":13150,"_26023":51906,"_2643":51971},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3144":2305,"_27488":2278,"_19100":51973,"_5":13150,"_26023":51910,"_2643":51974},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3144":2306,"_27488":2278,"_19100":51976,"_5":13150,"_26023":51914,"_2643":51977},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3144":2307,"_27488":2278,"_19100":51979,"_5":13150,"_26023":51917,"_2643":51980},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3144":2308,"_27488":2278,"_19100":51982,"_5":13150,"_26023":51921,"_2643":51983},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3144":2309,"_27488":2278,"_19100":51985,"_5":13150,"_26023":51921,"_2643":51986},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3144":2310,"_27488":2278,"_19100":51988,"_5":13150,"_26023":51921,"_2643":51989},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3144":2311,"_27488":2278,"_19100":51991,"_5":13150,"_26023":51925,"_2643":51992},[],"In Bash, compare the two public-key digests:",{"_3144":2312,"_27488":2278,"_19100":51994,"_5":13150,"_26023":51925,"_2643":51995},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3144":2313,"_27488":2278,"_19100":51997,"_5":13150,"_26023":51925,"_2643":51998},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3144":2314,"_27488":2278,"_19100":52000,"_5":13150,"_26023":51929,"_2643":49614},[],{"_3144":2315,"_27488":2278,"_19100":52002,"_5":13150,"_26023":51929,"_2643":52003},[],"What to review",{"_3144":2316,"_27488":2278,"_19100":52005,"_5":13150,"_26023":51929,"_2643":52006},[],"The CA rejects issuance",{"_3144":2317,"_27488":2278,"_19100":52008,"_5":13150,"_26023":51929,"_2643":52009},[],"Permissions, CA state and key, algorithm and profile.",{"_3144":2318,"_27488":2278,"_19100":52011,"_5":13150,"_26023":51929,"_2643":52012},[],"Different subject or usages",{"_3144":2319,"_27488":2278,"_19100":52014,"_5":13150,"_26023":51929,"_2643":52015},[],"Applied profile and requested values.",{"_3144":2320,"_27488":2278,"_19100":52017,"_5":13150,"_26023":51929,"_2643":52018},[],"Issuer cannot be found",{"_3144":2321,"_27488":2278,"_19100":52020,"_5":13150,"_26023":51929,"_2643":52021},[],"Downloaded CA and required intermediate chain.",{"_3144":2322,"_27488":2278,"_19100":52023,"_5":13150,"_26023":51929,"_2643":52024},[],"Validity fails",{"_3144":2323,"_27488":2278,"_19100":52026,"_5":13150,"_26023":51929,"_2643":52027},[],"Certificate and CA dates, and the computer's clock.",{"_3144":2324,"_27488":2278,"_19100":52029,"_5":13150,"_26023":51929,"_2643":52030},[],"Public-key digests differ",{"_3144":2325,"_27488":2278,"_19100":52032,"_5":13150,"_26023":51929,"_2643":52033},[],"Certificate and key files from the same issuance.",{"_3144":2326,"_27488":2278,"_19100":52035,"_5":13150,"_26023":51929,"_2643":52036},[],"See PKI diagnostics to narrow an issuance failure.",{"_3144":2327,"_27488":2278,"_19100":52038,"_5":13150,"_26023":51932,"_2643":52039},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3144":2328,"_27488":2278,"_19100":52041,"_5":13150,"_26023":51932,"_2643":52042},[],"Manage certificates for inspection, status and revocation.",{"_3144":2329,"_27488":2278,"_19100":52044,"_5":13150,"_26023":51932,"_2643":52045},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3144":2330,"_27488":2278,"_19100":52047,"_5":13150,"_26023":51932,"_2643":52048},[],"Prepare EST for the device to request its next identities.",{"_3144":2331,"_27488":2278,"_19100":52050,"_5":13150,"_26023":51932,"_2643":52051},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3144":2332,"_27488":2332,"_5":13476,"_2643":52053,"_27831":52054,"_19100":52055,"_26023":2332},"PKI getting started",[44764,46144,49837,49272],[],{"_3144":2333,"_27488":2332,"_19100":52057,"_5":13150,"_26023":2332,"_2643":52058},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3144":2334,"_27488":2332,"_5":27828,"_19100":52060,"_26023":52061,"_2643":44774},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#before-you-begin",{"_3144":2335,"_27488":2332,"_5":27828,"_19100":52063,"_26023":52064,"_2643":52065},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3144":2336,"_27488":2332,"_5":27828,"_19100":52067,"_26023":52068,"_2643":49464},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#expected-result",{"_3144":2337,"_27488":2332,"_5":27828,"_19100":52070,"_26023":52071,"_2643":52072},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3144":2338,"_27488":2332,"_19100":52074,"_5":13150,"_26023":2332,"_2643":52075},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3144":2339,"_27488":2332,"_19100":52077,"_5":13150,"_26023":52061,"_2643":52078},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3144":2340,"_27488":2332,"_19100":52080,"_5":13150,"_26023":52061,"_2643":52081},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3144":2341,"_27488":2332,"_19100":52083,"_5":13150,"_26023":52061,"_2643":52084},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3144":2342,"_27488":2332,"_19100":52086,"_5":13150,"_26023":52061,"_2643":52087},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3144":2343,"_27488":2332,"_19100":52089,"_5":13150,"_26023":52061,"_2643":52090},[],"A working directory with restricted access for the downloaded key.",{"_3144":2344,"_27488":2332,"_19100":52092,"_5":13150,"_26023":52064,"_2643":52093},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3144":2345,"_27488":2332,"_19100":52095,"_5":13150,"_26023":52064,"_2643":52096},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3144":2346,"_27488":2332,"_19100":52098,"_5":13150,"_26023":52064,"_2643":52099},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3144":2347,"_27488":2332,"_19100":52101,"_5":13150,"_26023":52064,"_2643":52102},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3144":2348,"_27488":2332,"_19100":52104,"_5":13150,"_26023":52068,"_2643":52105},[],"File or resource",{"_3144":2349,"_27488":2332,"_19100":52107,"_5":13150,"_26023":52068,"_2643":49461},[],{"_3144":2350,"_27488":2332,"_19100":52109,"_5":13150,"_26023":52068,"_2643":52110},[],"Active root CA and `ca.pem`",{"_3144":2351,"_27488":2332,"_19100":52112,"_5":13150,"_26023":52068,"_2643":52113},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3144":2352,"_27488":2332,"_19100":52115,"_5":13150,"_26023":52068,"_2643":52116},[],"End-entity certificate and `device.crt`",{"_3144":2353,"_27488":2332,"_19100":52118,"_5":13150,"_26023":52068,"_2643":52119},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3144":2354,"_27488":2332,"_19100":52121,"_5":13150,"_26023":52068,"_2643":52122},[],"Private key `device.key`",{"_3144":2355,"_27488":2332,"_19100":52124,"_5":13150,"_26023":52068,"_2643":52125},[],"Its public key matches the one included in `device.crt`.",{"_3144":2356,"_27488":2332,"_19100":52127,"_5":13150,"_26023":52068,"_2643":52128},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3144":2357,"_27488":2332,"_19100":52130,"_5":13150,"_26023":52071,"_2643":52131},[],"To operate certificates, continue with Certificates and Validation.",{"_3144":2358,"_27488":2332,"_19100":52133,"_5":13150,"_26023":52071,"_2643":52134},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3144":2359,"_27488":2332,"_19100":52136,"_5":13150,"_26023":52071,"_2643":52137},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3144":2360,"_27488":2360,"_5":13476,"_2643":52139,"_27831":52140,"_19100":52141,"_26023":2360},"PKI troubleshooting",[44764,46144,49837,48658],[],{"_3144":2361,"_27488":2360,"_19100":52143,"_5":13150,"_26023":2360,"_2643":52144},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3144":2362,"_27488":2360,"_5":27828,"_19100":52146,"_26023":52147,"_2643":52148},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3144":2363,"_27488":2360,"_5":27828,"_19100":52150,"_26023":52151,"_2643":52152},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3144":2364,"_27488":2360,"_5":27828,"_19100":52154,"_26023":52155,"_2643":52156},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3144":2365,"_27488":2360,"_19100":52158,"_5":13150,"_26023":2360,"_2643":52159},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3144":2366,"_27488":2360,"_19100":52161,"_5":13150,"_26023":2360,"_2643":52162},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3144":2367,"_27488":2360,"_19100":52164,"_5":13150,"_26023":52147,"_2643":49461},[],{"_3144":2368,"_27488":2360,"_19100":52166,"_5":13150,"_26023":52147,"_2643":52167},[],"What to inspect",{"_3144":2369,"_27488":2360,"_19100":52169,"_5":13150,"_26023":52147,"_2643":44798},[],{"_3144":2370,"_27488":2360,"_19100":52171,"_5":13150,"_26023":52147,"_2643":52172},[],"CA",{"_3144":2371,"_27488":2360,"_19100":52174,"_5":13150,"_26023":52147,"_2643":52175},[],"Exists, is active and has usable dates.",{"_3144":2372,"_27488":2360,"_19100":52177,"_5":13150,"_26023":52147,"_2643":52178},[],"Authorities.",{"_3144":2373,"_27488":2360,"_19100":52180,"_5":13150,"_26023":52147,"_2643":52181},[],"Key",{"_3144":2374,"_27488":2360,"_19100":52183,"_5":13150,"_26023":52147,"_2643":52184},[],"The record has a usable private key and the engine can sign.",{"_3144":2375,"_27488":2360,"_19100":52186,"_5":13150,"_26023":52147,"_2643":52187},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3144":2376,"_27488":2360,"_19100":52189,"_5":13150,"_26023":52147,"_2643":52190},[],"CSR",{"_3144":2377,"_27488":2360,"_19100":52192,"_5":13150,"_26023":52147,"_2643":52193},[],"Correct PEM and verifiable signature.",{"_3144":2378,"_27488":2360,"_19100":52195,"_5":13150,"_26023":52147,"_2643":52196},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3144":2379,"_27488":2360,"_19100":52198,"_5":13150,"_26023":52147,"_2643":52199},[],"Profile",{"_3144":2380,"_27488":2360,"_19100":52201,"_5":13150,"_26023":52147,"_2643":52202},[],"Selected source, existing ID, allowed algorithm and size.",{"_3144":2381,"_27488":2360,"_19100":52204,"_5":13150,"_26023":52147,"_2643":52205},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3144":2382,"_27488":2360,"_19100":52207,"_5":13150,"_26023":52147,"_2643":49614},[],{"_3144":2383,"_27488":2360,"_19100":52209,"_5":13150,"_26023":52147,"_2643":52210},[],"Appropriate subject, SAN, usages and dates.",{"_3144":2384,"_27488":2360,"_19100":52212,"_5":13150,"_26023":52147,"_2643":52213},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3144":2385,"_27488":2360,"_19100":52215,"_5":13150,"_26023":52147,"_2643":52216},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3144":2386,"_27488":2360,"_19100":52218,"_5":13150,"_26023":52147,"_2643":52219},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3144":2387,"_27488":2360,"_19100":52221,"_5":13150,"_26023":52151,"_2643":52222},[],"Check each boundary independently:",{"_3144":2388,"_27488":2360,"_19100":52224,"_5":13150,"_26023":52151,"_2643":52225},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3144":2389,"_27488":2360,"_19100":52227,"_5":13150,"_26023":52151,"_2643":52228},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3144":2390,"_27488":2360,"_19100":52230,"_5":13150,"_26023":52151,"_2643":52231},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3144":2391,"_27488":2360,"_19100":52233,"_5":13150,"_26023":52151,"_2643":52234},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3144":2392,"_27488":2360,"_19100":52236,"_5":13150,"_26023":52151,"_2643":52237},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3144":2393,"_27488":2360,"_19100":52239,"_5":13150,"_26023":52151,"_2643":52240},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3144":2394,"_27488":2360,"_19100":52242,"_5":13150,"_26023":52155,"_2643":52243},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3144":2395,"_27488":2360,"_19100":52245,"_5":13150,"_26023":52155,"_2643":52246},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3144":2396,"_27488":2396,"_5":13476,"_2643":52248,"_27831":52249,"_19100":52251,"_26023":2396},"3.8.0 to 4.0.0",[44764,52250],"Upgrades",[],{"_3144":2397,"_27488":2396,"_19100":52253,"_5":13150,"_26023":2396,"_2643":52254},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3144":2398,"_27488":2396,"_5":27828,"_19100":52256,"_26023":52257,"_2643":52258},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3144":2399,"_27488":2396,"_5":27828,"_19100":52260,"_26023":52261,"_2643":52262},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3144":2400,"_27488":2396,"_5":27828,"_19100":52264,"_26023":52265,"_2643":52266},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3144":2401,"_27488":2396,"_5":27828,"_19100":52268,"_26023":52269,"_2643":52270},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3144":2402,"_27488":2396,"_5":27828,"_19100":52272,"_26023":52273,"_2643":52274},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3144":2403,"_27488":2396,"_5":27828,"_19100":52276,"_26023":52277,"_2643":52278},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3144":2404,"_27488":2396,"_5":27828,"_19100":52280,"_26023":52281,"_2643":52282},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3144":2405,"_27488":2396,"_5":27828,"_19100":52284,"_26023":52285,"_2643":52286},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3144":2406,"_27488":2396,"_5":27828,"_19100":52288,"_26023":52289,"_2643":52290},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3144":2407,"_27488":2396,"_5":27828,"_19100":52292,"_26023":52293,"_2643":52294},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3144":2408,"_27488":2396,"_5":27828,"_19100":52296,"_26023":52297,"_2643":52298},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3144":2409,"_27488":2396,"_5":27828,"_19100":52300,"_26023":52301,"_2643":52302},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3144":2410,"_27488":2396,"_5":27828,"_19100":52304,"_26023":52305,"_2643":52306},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3144":2411,"_27488":2396,"_5":27828,"_19100":52308,"_26023":52309,"_2643":52310},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3144":2412,"_27488":2396,"_5":27828,"_19100":52312,"_26023":52313,"_2643":52314},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3144":2413,"_27488":2396,"_5":27828,"_19100":52316,"_26023":52317,"_2643":52318},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3144":2414,"_27488":2396,"_5":27828,"_19100":52320,"_26023":52321,"_2643":52322},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3144":2415,"_27488":2396,"_5":27828,"_19100":52324,"_26023":52325,"_2643":52326},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3144":2416,"_27488":2396,"_5":27828,"_19100":52328,"_26023":52329,"_2643":52330},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3144":2417,"_27488":2396,"_5":27828,"_19100":52332,"_26023":52333,"_2643":52334},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3144":2418,"_27488":2396,"_5":27828,"_19100":52336,"_26023":52337,"_2643":52338},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3144":2419,"_27488":2396,"_5":27828,"_19100":52340,"_26023":52341,"_2643":52342},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3144":2420,"_27488":2396,"_5":27828,"_19100":52344,"_26023":52345,"_2643":52346},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3144":2421,"_27488":2396,"_5":27828,"_19100":52348,"_26023":52349,"_2643":52350},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3144":2422,"_27488":2396,"_5":27828,"_19100":52352,"_26023":52353,"_2643":52354},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3144":2423,"_27488":2396,"_5":27828,"_19100":52356,"_26023":52357,"_2643":52358},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3144":2424,"_27488":2396,"_5":27828,"_19100":52360,"_26023":52361,"_2643":52362},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3144":2425,"_27488":2396,"_5":27828,"_19100":52364,"_26023":52365,"_2643":52366},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3144":2426,"_27488":2396,"_5":27828,"_19100":52368,"_26023":52369,"_2643":52370},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3144":2427,"_27488":2396,"_5":27828,"_19100":52372,"_26023":52373,"_2643":52374},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3144":2428,"_27488":2396,"_5":27828,"_19100":52376,"_26023":52377,"_2643":52378},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3144":2429,"_27488":2396,"_5":27828,"_19100":52380,"_26023":52381,"_2643":52382},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3144":2430,"_27488":2396,"_5":27828,"_19100":52384,"_26023":52385,"_2643":52386},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3144":2431,"_27488":2396,"_5":27828,"_19100":52388,"_26023":52389,"_2643":48658},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3144":2432,"_27488":2396,"_5":27828,"_19100":52391,"_26023":52392,"_2643":52393},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3144":2433,"_27488":2396,"_5":27828,"_19100":52395,"_26023":52396,"_2643":52397},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3144":2434,"_27488":2396,"_19100":52399,"_5":13150,"_26023":2396,"_2643":52400},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3144":2435,"_27488":2396,"_19100":52402,"_5":13150,"_26023":2396,"_2643":52403},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3144":2436,"_27488":2396,"_19100":52405,"_5":13150,"_26023":2396,"_2643":52406},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3144":2437,"_27488":2396,"_19100":52408,"_5":13150,"_26023":2396,"_2643":52409},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3144":2438,"_27488":2396,"_19100":52411,"_5":13150,"_26023":2396,"_2643":52412},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3144":2439,"_27488":2396,"_19100":52414,"_5":13150,"_26023":2396,"_2643":52415},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3144":2440,"_27488":2396,"_19100":52417,"_5":13150,"_26023":2396,"_2643":52418},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3144":2441,"_27488":2396,"_19100":52420,"_5":13150,"_26023":52261,"_2643":52421},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3144":2442,"_27488":2396,"_19100":52423,"_5":13150,"_26023":52261,"_2643":52424},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3144":2443,"_27488":2396,"_19100":52426,"_5":13150,"_26023":52265,"_2643":52427},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3144":2444,"_27488":2396,"_19100":52429,"_5":13150,"_26023":52265,"_2643":52430},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3144":2445,"_27488":2396,"_19100":52432,"_5":13150,"_26023":52269,"_2643":52433},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3144":2446,"_27488":2396,"_19100":52435,"_5":13150,"_26023":52273,"_2643":52436},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3144":2447,"_27488":2396,"_19100":52438,"_5":13150,"_26023":52273,"_2643":52439},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3144":2448,"_27488":2396,"_19100":52441,"_5":13150,"_26023":52273,"_2643":52442},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3144":2449,"_27488":2396,"_19100":52444,"_5":13150,"_26023":52273,"_2643":52445},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3144":2450,"_27488":2396,"_19100":52447,"_5":13150,"_26023":52273,"_2643":52448},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3144":2451,"_27488":2396,"_19100":52450,"_5":13150,"_26023":52277,"_2643":52451},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3144":2452,"_27488":2396,"_19100":52453,"_5":13150,"_26023":52277,"_2643":52454},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3144":2453,"_27488":2396,"_19100":52456,"_5":13150,"_26023":52277,"_2643":52457},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3144":2454,"_27488":2396,"_19100":52459,"_5":13150,"_26023":52277,"_2643":52460},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3144":2455,"_27488":2396,"_19100":52462,"_5":13150,"_26023":52277,"_2643":52463},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3144":2456,"_27488":2396,"_19100":52465,"_5":13150,"_26023":52281,"_2643":52466},[],"Change",{"_3144":2457,"_27488":2396,"_19100":52468,"_5":13150,"_26023":52281,"_2643":52469},[],"Who is affected",{"_3144":2458,"_27488":2396,"_19100":52471,"_5":13150,"_26023":52281,"_2643":52472},[],"Severity",{"_3144":2459,"_27488":2396,"_19100":52474,"_5":13150,"_26023":52281,"_2643":52475},[],"Action",{"_3144":2460,"_27488":2396,"_19100":52477,"_5":13150,"_26023":52281,"_2643":52290},[],{"_3144":2461,"_27488":2396,"_19100":52479,"_5":13150,"_26023":52281,"_2643":52480},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3144":2462,"_27488":2396,"_19100":52482,"_5":13150,"_26023":52281,"_2643":52483},[],"High: KMS and VA start on empty volumes",{"_3144":2463,"_27488":2396,"_19100":52485,"_5":13150,"_26023":52281,"_2643":52486},[],"Copy the data into the new volumes",{"_3144":2464,"_27488":2396,"_19100":52488,"_5":13150,"_26023":52281,"_2643":52294},[],{"_3144":2465,"_27488":2396,"_19100":52490,"_5":13150,"_26023":52281,"_2643":52491},[],"Every Helm release",{"_3144":2466,"_27488":2396,"_19100":52493,"_5":13150,"_26023":52281,"_2643":52494},[],"High: `helm upgrade` fails",{"_3144":2467,"_27488":2396,"_19100":52496,"_5":13150,"_26023":52281,"_2643":52497},[],"Remove or rename legacy keys",{"_3144":2468,"_27488":2396,"_19100":52499,"_5":13150,"_26023":52281,"_2643":52298},[],{"_3144":2469,"_27488":2396,"_19100":52501,"_5":13150,"_26023":52281,"_2643":52502},[],"Every deployment",{"_3144":2470,"_27488":2396,"_19100":52504,"_5":13150,"_26023":52281,"_2643":52505},[],"High: without a bootstrap principal there is no administrator",{"_3144":2471,"_27488":2396,"_19100":52507,"_5":13150,"_26023":52281,"_2643":52508},[],"Configure `services.authz`",{"_3144":2472,"_27488":2396,"_19100":52510,"_5":13150,"_26023":52281,"_2643":52302},[],{"_3144":2473,"_27488":2396,"_19100":52512,"_5":13150,"_26023":52281,"_2643":52491},[],{"_3144":2474,"_27488":2396,"_19100":52514,"_5":13150,"_26023":52281,"_2643":52515},[],"High: `helm upgrade` fails on the old keys",{"_3144":2475,"_27488":2396,"_19100":52517,"_5":13150,"_26023":52281,"_2643":52518},[],"Move JWKS and roles into `services.authz`",{"_3144":2476,"_27488":2396,"_19100":52520,"_5":13150,"_26023":52281,"_2643":52322},[],{"_3144":2477,"_27488":2396,"_19100":52522,"_5":13150,"_26023":52281,"_2643":52523},[],"3.8.0 deployments with per-service databases",{"_3144":2478,"_27488":2396,"_19100":52525,"_5":13150,"_26023":52281,"_2643":52526},[],"High: services find no data, or a migration aborts",{"_3144":2479,"_27488":2396,"_19100":52528,"_5":13150,"_26023":52281,"_2643":52529},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3144":2480,"_27488":2396,"_19100":52531,"_5":13150,"_26023":52281,"_2643":52326},[],{"_3144":2481,"_27488":2396,"_19100":52533,"_5":13150,"_26023":52281,"_2643":52534},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3144":2482,"_27488":2396,"_19100":52536,"_5":13150,"_26023":52281,"_2643":52537},[],"High: the backend no longer starts with them",{"_3144":2483,"_27488":2396,"_19100":52539,"_5":13150,"_26023":52281,"_2643":52540},[],"Move to PostgreSQL before upgrading",{"_3144":2484,"_27488":2396,"_19100":52542,"_5":13150,"_26023":52281,"_2643":52543},[],"Webhooks with file references",{"_3144":2485,"_27488":2396,"_19100":52545,"_5":13150,"_26023":52281,"_2643":52546},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3144":2486,"_27488":2396,"_19100":52548,"_5":13150,"_26023":52281,"_2643":52549},[],"High: enrollments calling the webhook fail",{"_3144":2487,"_27488":2396,"_19100":52551,"_5":13150,"_26023":52281,"_2643":52552},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3144":2488,"_27488":2396,"_19100":52554,"_5":13150,"_26023":52281,"_2643":52306},[],{"_3144":2489,"_27488":2396,"_19100":52556,"_5":13150,"_26023":52281,"_2643":52557},[],"Releases with per-service identity overrides or mounted key material",{"_3144":2490,"_27488":2396,"_19100":52559,"_5":13150,"_26023":52281,"_2643":52560},[],"Medium: services cannot read their files",{"_3144":2491,"_27488":2396,"_19100":52562,"_5":13150,"_26023":52281,"_2643":52563},[],"Remove the overrides and fix volume ownership",{"_3144":2492,"_27488":2396,"_19100":52565,"_5":13150,"_26023":52281,"_2643":52310},[],{"_3144":2493,"_27488":2396,"_19100":52567,"_5":13150,"_26023":52281,"_2643":52568},[],"Releases that set `amqp.tls`",{"_3144":2494,"_27488":2396,"_19100":52570,"_5":13150,"_26023":52281,"_2643":52571},[],"Medium: clients connect to the wrong port",{"_3144":2495,"_27488":2396,"_19100":52573,"_5":13150,"_26023":52281,"_2643":52574},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3144":2496,"_27488":2396,"_19100":52576,"_5":13150,"_26023":52281,"_2643":52330},[],{"_3144":2497,"_27488":2396,"_19100":52578,"_5":13150,"_26023":52281,"_2643":52579},[],"Installations whose CA keys predate the KMS",{"_3144":2498,"_27488":2396,"_19100":52581,"_5":13150,"_26023":52281,"_2643":52582},[],"Medium: CA keys stay unmanaged",{"_3144":2499,"_27488":2396,"_19100":52584,"_5":13150,"_26023":52281,"_2643":52585},[],"Run the CA-to-KMS migration",{"_3144":2500,"_27488":2396,"_19100":52587,"_5":13150,"_26023":52281,"_2643":52588},[],"Receiver certificate verification",{"_3144":2501,"_27488":2396,"_19100":52590,"_5":13150,"_26023":52281,"_2643":52591},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3144":2502,"_27488":2396,"_19100":52593,"_5":13150,"_26023":52281,"_2643":52594},[],"Medium: credentials go to an unverified receiver",{"_3144":2503,"_27488":2396,"_19100":52596,"_5":13150,"_26023":52281,"_2643":52597},[],"Set `insecure_skip_verify` to `false`",{"_3144":2504,"_27488":2396,"_19100":52599,"_5":13150,"_26023":52281,"_2643":52342},[],{"_3144":2505,"_27488":2396,"_19100":52601,"_5":13150,"_26023":52281,"_2643":52602},[],"Scripts and consoles that edit DMSs through the API",{"_3144":2506,"_27488":2396,"_19100":52604,"_5":13150,"_26023":52281,"_2643":52605},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3144":2507,"_27488":2396,"_19100":52607,"_5":13150,"_26023":52281,"_2643":52608},[],"Read the DMS before editing and use the new field",{"_3144":2508,"_27488":2396,"_19100":52610,"_5":13150,"_26023":52281,"_2643":52358},[],{"_3144":2509,"_27488":2396,"_19100":52612,"_5":13150,"_26023":52281,"_2643":52613},[],"Consumers that read the device `events` field",{"_3144":2510,"_27488":2396,"_19100":52615,"_5":13150,"_26023":52281,"_2643":52616},[],"Medium: the field disappears",{"_3144":2511,"_27488":2396,"_19100":52618,"_5":13150,"_26023":52281,"_2643":52619},[],"Use the new event endpoints",{"_3144":2512,"_27488":2396,"_19100":52621,"_5":13150,"_26023":52281,"_2643":52314},[],{"_3144":2513,"_27488":2396,"_19100":52623,"_5":13150,"_26023":52281,"_2643":52624},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3144":2514,"_27488":2396,"_19100":52626,"_5":13150,"_26023":52281,"_2643":52627},[],"Low to medium: validation errors or changed defaults",{"_3144":2515,"_27488":2396,"_19100":52629,"_5":13150,"_26023":52281,"_2643":52630},[],"Update the values file",{"_3144":2516,"_27488":2396,"_19100":52632,"_5":13150,"_26023":52281,"_2643":52350},[],{"_3144":2517,"_27488":2396,"_19100":52634,"_5":13150,"_26023":52281,"_2643":52635},[],"Clients that send the DMS ID in the update body",{"_3144":2518,"_27488":2396,"_19100":52637,"_5":13150,"_26023":52281,"_2643":52638},[],"Low: the ID in the URL wins",{"_3144":2519,"_27488":2396,"_19100":52640,"_5":13150,"_26023":52281,"_2643":52641},[],"Send the ID in the URL",{"_3144":2520,"_27488":2396,"_19100":52643,"_5":13150,"_26023":52281,"_2643":52354},[],{"_3144":2521,"_27488":2396,"_19100":52645,"_5":13150,"_26023":52281,"_2643":52646},[],"Consumers that match on certificate `type`",{"_3144":2522,"_27488":2396,"_19100":52648,"_5":13150,"_26023":52281,"_2643":52649},[],"Low: two values are renamed",{"_3144":2523,"_27488":2396,"_19100":52651,"_5":13150,"_26023":52281,"_2643":52652},[],"Adapt consumers",{"_3144":2524,"_27488":2396,"_19100":52654,"_5":13150,"_26023":52281,"_2643":52346},[],{"_3144":2525,"_27488":2396,"_19100":52656,"_5":13150,"_26023":52281,"_2643":52657},[],"Any DMS",{"_3144":2526,"_27488":2396,"_19100":52659,"_5":13150,"_26023":52281,"_2643":52660},[],"Low: informational",{"_3144":2527,"_27488":2396,"_19100":52662,"_5":13150,"_26023":52281,"_2643":52663},[],"Read both blocks before editing",{"_3144":2528,"_27488":2396,"_19100":52665,"_5":13150,"_26023":52289,"_2643":52666},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3144":2529,"_27488":2396,"_19100":52668,"_5":13150,"_26023":52289,"_2643":52669},[],"Step 4 of the migration guide copies the data.",{"_3144":2530,"_27488":2396,"_19100":52671,"_5":13150,"_26023":52293,"_2643":52672},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3144":2531,"_27488":2396,"_19100":52674,"_5":13150,"_26023":52297,"_2643":52675},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3144":2532,"_27488":2396,"_19100":52677,"_5":13150,"_26023":52301,"_2643":52678},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3144":2533,"_27488":2396,"_19100":52680,"_5":13150,"_26023":52305,"_2643":52681},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3144":2534,"_27488":2396,"_19100":52683,"_5":13150,"_26023":52305,"_2643":52684},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3144":2535,"_27488":2396,"_19100":52686,"_5":13150,"_26023":52309,"_2643":52687},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3144":2536,"_27488":2396,"_19100":52689,"_5":13150,"_26023":52313,"_2643":52690},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3144":2537,"_27488":2396,"_19100":52692,"_5":13150,"_26023":52313,"_2643":52693},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3144":2538,"_27488":2396,"_19100":52695,"_5":13150,"_26023":52313,"_2643":52696},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3144":2539,"_27488":2396,"_19100":52698,"_5":13150,"_26023":52313,"_2643":52699},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3144":2540,"_27488":2396,"_19100":52701,"_5":13150,"_26023":52313,"_2643":52702},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3144":2541,"_27488":2396,"_19100":52704,"_5":13150,"_26023":52313,"_2643":52705},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3144":2542,"_27488":2396,"_19100":52707,"_5":13150,"_26023":52321,"_2643":52708},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3144":2543,"_27488":2396,"_19100":52710,"_5":13150,"_26023":52321,"_2643":52711},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3144":2544,"_27488":2396,"_19100":52713,"_5":13150,"_26023":52321,"_2643":52714},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3144":2545,"_27488":2396,"_19100":52716,"_5":13150,"_26023":52321,"_2643":52717},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3144":2546,"_27488":2396,"_19100":52719,"_5":13150,"_26023":52321,"_2643":52720},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3144":2547,"_27488":2396,"_19100":52722,"_5":13150,"_26023":52325,"_2643":52723},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3144":2548,"_27488":2396,"_19100":52725,"_5":13150,"_26023":52329,"_2643":52726},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3144":2549,"_27488":2396,"_19100":52728,"_5":13150,"_26023":52329,"_2643":52729},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3144":2550,"_27488":2396,"_19100":52731,"_5":13150,"_26023":52329,"_2643":52732},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3144":2551,"_27488":2396,"_19100":52734,"_5":13150,"_26023":52329,"_2643":52735},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3144":2552,"_27488":2396,"_19100":52737,"_5":13150,"_26023":52329,"_2643":52738},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3144":2553,"_27488":2396,"_19100":52740,"_5":13150,"_26023":52329,"_2643":52741},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3144":2554,"_27488":2396,"_19100":52743,"_5":13150,"_26023":52337,"_2643":52744},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3144":2555,"_27488":2396,"_19100":52746,"_5":13150,"_26023":52337,"_2643":52747},[],"Field in 3.8.0",{"_3144":2556,"_27488":2396,"_19100":52749,"_5":13150,"_26023":52337,"_2643":52750},[],"Field in 4.0.0",{"_3144":2557,"_27488":2396,"_19100":52752,"_5":13150,"_26023":52337,"_2643":52753},[],"`validate_server_cert`",{"_3144":2558,"_27488":2396,"_19100":52755,"_5":13150,"_26023":52337,"_2643":52756},[],"`insecure_skip_verify` (value negated)",{"_3144":2559,"_27488":2396,"_19100":52758,"_5":13150,"_26023":52337,"_2643":52759},[],"`oidc`",{"_3144":2560,"_27488":2396,"_19100":52761,"_5":13150,"_26023":52337,"_2643":52762},[],"`jwt_options`",{"_3144":2561,"_27488":2396,"_19100":52764,"_5":13150,"_26023":52337,"_2643":52765},[],"`apikey`",{"_3144":2562,"_27488":2396,"_19100":52767,"_5":13150,"_26023":52337,"_2643":52768},[],"`apikey_options`",{"_3144":2563,"_27488":2396,"_19100":52770,"_5":13150,"_26023":52337,"_2643":52771},[],"`mtls`",{"_3144":2564,"_27488":2396,"_19100":52773,"_5":13150,"_26023":52337,"_2643":52774},[],"`mtls_options`",{"_3144":2565,"_27488":2396,"_19100":52776,"_5":13150,"_26023":52337,"_2643":52777},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3144":2566,"_27488":2396,"_19100":52779,"_5":13150,"_26023":52337,"_2643":52780},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3144":2567,"_27488":2396,"_19100":52782,"_5":13150,"_26023":52337,"_2643":52783},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3144":2568,"_27488":2396,"_19100":52785,"_5":13150,"_26023":52341,"_2643":52786},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3144":2569,"_27488":2396,"_19100":52788,"_5":13150,"_26023":52341,"_2643":52789},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3144":2570,"_27488":2396,"_19100":52791,"_5":13150,"_26023":52341,"_2643":52792},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3144":2571,"_27488":2396,"_19100":52794,"_5":13150,"_26023":52345,"_2643":52795},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API.",{"_3144":2572,"_27488":2396,"_19100":52797,"_5":13150,"_26023":52349,"_2643":52798},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3144":2573,"_27488":2396,"_19100":52800,"_5":13150,"_26023":52353,"_2643":52801},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3144":2574,"_27488":2396,"_19100":52803,"_5":13150,"_26023":52357,"_2643":52804},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3144":2575,"_27488":2396,"_19100":52806,"_5":13150,"_26023":52357,"_2643":52807},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3144":2576,"_27488":2396,"_19100":52809,"_5":13150,"_26023":52357,"_2643":52810},[],"`POST /v1/devices/:id/events` creates an event.",{"_3144":2577,"_27488":2396,"_19100":52812,"_5":13150,"_26023":52357,"_2643":52813},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3144":2578,"_27488":2396,"_19100":52815,"_5":13150,"_26023":52361,"_2643":52816},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3144":2579,"_27488":2396,"_19100":52818,"_5":13150,"_26023":52365,"_2643":52819},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3144":2580,"_27488":2396,"_19100":52821,"_5":13150,"_26023":52365,"_2643":52822},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3144":2581,"_27488":2396,"_19100":52824,"_5":13150,"_26023":52365,"_2643":52825},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3144":2582,"_27488":2396,"_19100":52827,"_5":13150,"_26023":52365,"_2643":52828},[],"Record the names of your local-storage PVCs:",{"_3144":2583,"_27488":2396,"_19100":52830,"_5":13150,"_26023":52365,"_2643":52831},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3144":2584,"_27488":2396,"_19100":52833,"_5":13150,"_26023":52369,"_2643":52834},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3144":2585,"_27488":2396,"_19100":52836,"_5":13150,"_26023":52369,"_2643":52837},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3144":2586,"_27488":2396,"_19100":52839,"_5":13150,"_26023":52369,"_2643":52840},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3144":2587,"_27488":2396,"_19100":52842,"_5":13150,"_26023":52369,"_2643":52843},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3144":2588,"_27488":2396,"_19100":52845,"_5":13150,"_26023":52369,"_2643":52846},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3144":2589,"_27488":2396,"_19100":52848,"_5":13150,"_26023":52369,"_2643":52849},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3144":2590,"_27488":2396,"_19100":52851,"_5":13150,"_26023":52369,"_2643":52852},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3144":2591,"_27488":2396,"_19100":52854,"_5":13150,"_26023":52369,"_2643":52855},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3144":2592,"_27488":2396,"_19100":52857,"_5":13150,"_26023":52369,"_2643":52858},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3144":2593,"_27488":2396,"_19100":52860,"_5":13150,"_26023":52369,"_2643":52861},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3144":2594,"_27488":2396,"_19100":52863,"_5":13150,"_26023":52369,"_2643":52864},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3144":2595,"_27488":2396,"_19100":52866,"_5":13150,"_26023":52369,"_2643":52867},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3144":2596,"_27488":2396,"_19100":52869,"_5":13150,"_26023":52373,"_2643":52870},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run. If the deployment uses local KMS or VA storage, those pods fail until you complete step 4.",{"_3144":2597,"_27488":2396,"_19100":52872,"_5":13150,"_26023":52377,"_2643":52873},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3144":2598,"_27488":2396,"_19100":52875,"_5":13150,"_26023":52377,"_2643":52876},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3144":2599,"_27488":2396,"_19100":52878,"_5":13150,"_26023":52377,"_2643":52879},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3144":2600,"_27488":2396,"_19100":52881,"_5":13150,"_26023":52377,"_2643":52882},[],"**Record the replica counts and scale the new StatefulSets down** so nothing writes to either volume while you copy:",{"_3144":2601,"_27488":2396,"_19100":52884,"_5":13150,"_26023":52377,"_2643":52885},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3144":2602,"_27488":2396,"_19100":52887,"_5":13150,"_26023":52377,"_2643":52888},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3144":2603,"_27488":2396,"_19100":52890,"_5":13150,"_26023":52377,"_2643":52891},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3144":2604,"_27488":2396,"_19100":52893,"_5":13150,"_26023":52377,"_2643":52894},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3144":2605,"_27488":2396,"_19100":52896,"_5":13150,"_26023":52377,"_2643":52897},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3144":2606,"_27488":2396,"_19100":52899,"_5":13150,"_26023":52377,"_2643":52900},[],"**Remove the helper and restore the recorded replica counts:**",{"_3144":2607,"_27488":2396,"_19100":52902,"_5":13150,"_26023":52381,"_2643":52903},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3144":2608,"_27488":2396,"_19100":52905,"_5":13150,"_26023":52381,"_2643":52906},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3144":2609,"_27488":2396,"_19100":52908,"_5":13150,"_26023":52385,"_2643":52909},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3144":2610,"_27488":2396,"_19100":52911,"_5":13150,"_26023":52385,"_2643":52912},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3144":2611,"_27488":2396,"_19100":52914,"_5":13150,"_26023":52385,"_2643":52915},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3144":2612,"_27488":2396,"_19100":52917,"_5":13150,"_26023":52385,"_2643":52918},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas.",{"_3144":2613,"_27488":2396,"_19100":52920,"_5":13150,"_26023":52385,"_2643":52921},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3144":2614,"_27488":2396,"_19100":52923,"_5":13150,"_26023":52389,"_2643":52924},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3144":2615,"_27488":2396,"_19100":52926,"_5":13150,"_26023":52389,"_2643":52927},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3144":2616,"_27488":2396,"_19100":52929,"_5":13150,"_26023":52389,"_2643":52930},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3144":2617,"_27488":2396,"_19100":52932,"_5":13150,"_26023":52389,"_2643":52933},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3144":2618,"_27488":2396,"_19100":52935,"_5":13150,"_26023":52389,"_2643":52936},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3144":2619,"_27488":2396,"_19100":52938,"_5":13150,"_26023":52392,"_2643":52939},[],"After the upgrade, check in this order:",{"_3144":2620,"_27488":2396,"_19100":52941,"_5":13150,"_26023":52392,"_2643":52942},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3144":2621,"_27488":2396,"_19100":52944,"_5":13150,"_26023":52392,"_2643":52945},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3144":2622,"_27488":2396,"_19100":52947,"_5":13150,"_26023":52392,"_2643":52948},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3144":2623,"_27488":2396,"_19100":52950,"_5":13150,"_26023":52392,"_2643":52951},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3144":2624,"_27488":2396,"_19100":52953,"_5":13150,"_26023":52392,"_2643":52954},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3144":2625,"_27488":2396,"_19100":52956,"_5":13150,"_26023":52392,"_2643":52957},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3144":2626,"_27488":2396,"_19100":52959,"_5":13150,"_26023":52392,"_2643":52960},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3144":2627,"_27488":2396,"_19100":52962,"_5":13150,"_26023":52392,"_2643":52963},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3144":2628,"_27488":2396,"_19100":52965,"_5":13150,"_26023":52392,"_2643":52966},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3144":2629,"_27488":2396,"_19100":52968,"_5":13150,"_26023":52392,"_2643":52969},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3144":2630,"_27488":2396,"_19100":52971,"_5":13150,"_26023":52392,"_2643":52972},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3144":2631,"_27488":2396,"_19100":52974,"_5":13150,"_26023":52392,"_2643":52975},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3144":2632,"_27488":2396,"_19100":52977,"_5":13150,"_26023":52392,"_2643":52978},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3144":2633,"_27488":2396,"_19100":52980,"_5":13150,"_26023":52392,"_2643":52981},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3144":2634,"_27488":2396,"_19100":52983,"_5":13150,"_26023":52396,"_2643":52984},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy:",{"_3144":2635,"_27488":2396,"_19100":52986,"_5":13150,"_26023":52396,"_2643":52987},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3144":2636,"_27488":2396,"_19100":52989,"_5":13150,"_26023":52396,"_2643":52990},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3144":2637,"_27488":2396,"_19100":52992,"_5":13150,"_26023":52396,"_2643":52993},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3144":2638,"_27488":2396,"_19100":52995,"_5":13150,"_26023":52396,"_2643":52996},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_52999":53000,"_53001":53002,"_53003":53004,"_53005":53006,"_16656":2665,"_63516":2665},"language","english","sortableProperties",[2643,27488,5,26023],"sortablePropertiesWithTypes",{"_2643":22829,"_27488":22829,"_5":22829,"_26023":22829},"sorts",{"_2643":53007,"_27488":55635,"_5":58262,"_26023":60889},{"_4206":53008,"_53009":53010,"_5":22829},{"_13205":5483,"_13575":5275,"_13582":15421,"_11851":2988,"_26149":5963,"_18144":23146,"_13226":3018,"_13233":3205,"_26576":7112,"_26963":4323,"_26984":16442,"_26594":6689,"_31590":3795,"_26995":5607,"_27024":5299,"_31597":19586,"_31600":6288,"_31603":20499,"_31606":4639,"_27347":3714,"_31611":4641,"_31613":6848,"_27377":19482,"_27337":2907,"_31617":17500,"_27546":5373,"_31621":4332,"_27013":3032,"_27342":7806,"_27401":3647,"_31626":14972,"_31628":3189,"_31630":4302,"_31632":2740,"_31634":2965,"_31636":3916,"_31638":4826,"_31640":3333,"_31642":3390,"_26647":6919,"_31645":4321,"_31647":6294,"_26641":3025,"_31650":6449,"_31652":9761,"_31654":6820,"_31657":2735,"_26682":11039,"_31661":11187,"_26567":16670,"_31664":8553,"_26599":4298,"_31667":15221,"_31669":6