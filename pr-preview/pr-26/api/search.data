6724":113267,"_36726":113270,"_36728":113272,"_36730":113275,"_36732":113278,"_36734":113281,"_36736":113284,"_36739":113287,"_36741":113290,"_36743":113293,"_36745":113296,"_36747":113299,"_36749":113302,"_36751":113305,"_36753":113308,"_36755":113311,"_36757":113314,"_36759":113317,"_36761":113320,"_36763":113323,"_36765":113326,"_36767":113329,"_36769":113332,"_36771":113335,"_36773":113338,"_36775":113341,"_36777":113344,"_36779":113347,"_36781":113350,"_36783":113353,"_36785":113356,"_36787":113359,"_36789":113362,"_36791":113365,"_36793":113368,"_36795":113370,"_36797":113373,"_36799":113375,"_36801":113377,"_36803":113379,"_36805":113381,"_36807":113383,"_36809":113385,"_36811":113388,"_36813":113391,"_36816":113394,"_36818":113397,"_36820":113400,"_36822":113403,"_36824":113406,"_36826":113409,"_36828":113412,"_36830":113415,"_36832":113418,"_36834":113421,"_36836":113424,"_36838":113427,"_36840":113430,"_36842":113433,"_36844":113436,"_36846":113439,"_36848":113442,"_36850":113445,"_36852":113448,"_36854":113451,"_36856":113454,"_36858":113457,"_36860":113460,"_36862":113463,"_36864":113466,"_36866":113469,"_36868":113472,"_36870":113475,"_36872":113478,"_36874":113481,"_36876":113484,"_36879":113487,"_36881":113490,"_36883":113493,"_36885":113496,"_36888":113499,"_36890":113502,"_36892":113505,"_36895":113508,"_36897":113511,"_36899":113514,"_36901":113517,"_36903":113520,"_36905":113523,"_36907":113526,"_36909":113529,"_36911":113532,"_36913":113535,"_36915":113538,"_36917":113541,"_36919":113544,"_36921":113547,"_36923":113550,"_36925":113553,"_36927":113556,"_36929":113559,"_36931":113562,"_36933":113565,"_36935":113568,"_36937":113571,"_36939":113574,"_36941":113577,"_36943":113580,"_36945":113583,"_36947":113586,"_36949":113589,"_36951":113592,"_36953":113595,"_36955":113598,"_36957":113601,"_36959":113604,"_36961":113607},{"_3150":63727,"_27624":63727,"_5":13515,"_2648":105552,"_27967":105553,"_19171":105556,"_26134":63727},"Despliega desde AWS Marketplace",[44933,105554,105555],"Despliegue","Otros modelos",[],{"_3150":63728,"_27624":63727,"_19171":105558,"_5":13189,"_26134":63727,"_2648":105559},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3150":63729,"_27624":63727,"_5":27964,"_19171":105561,"_26134":105562,"_2648":105563},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3150":63730,"_27624":63727,"_5":27964,"_19171":105565,"_26134":105566,"_2648":105567},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3150":63731,"_27624":63727,"_5":27964,"_19171":105569,"_26134":105570,"_2648":105571},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3150":63732,"_27624":63727,"_5":27964,"_19171":105573,"_26134":105574,"_2648":105575},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3150":63733,"_27624":63727,"_5":27964,"_19171":105577,"_26134":105578,"_2648":105579},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3150":63734,"_27624":63727,"_5":27964,"_19171":105581,"_26134":105582,"_2648":105583},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3150":63735,"_27624":63727,"_5":27964,"_19171":105585,"_26134":105586,"_2648":105587},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3150":63736,"_27624":63727,"_19171":105589,"_5":13189,"_26134":63727,"_2648":105590},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3150":63737,"_27624":63727,"_19171":105592,"_5":13189,"_26134":105562,"_2648":105593},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3150":63738,"_27624":63727,"_19171":105595,"_5":13189,"_26134":105562,"_2648":105596},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3150":63739,"_27624":63727,"_19171":105598,"_5":13189,"_26134":105562,"_2648":105599},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3150":63740,"_27624":63727,"_19171":105601,"_5":13189,"_26134":105566,"_2648":105602},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3150":63741,"_27624":63727,"_19171":105604,"_5":13189,"_26134":105566,"_2648":105605},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3150":63742,"_27624":63727,"_19171":105607,"_5":13189,"_26134":105566,"_2648":105608},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3150":63743,"_27624":63727,"_19171":105610,"_5":13189,"_26134":105570,"_2648":105611},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3150":63744,"_27624":63727,"_19171":105613,"_5":13189,"_26134":105574,"_2648":105614},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3150":63745,"_27624":63727,"_19171":105616,"_5":13189,"_26134":105578,"_2648":105617},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3150":63746,"_27624":63727,"_19171":105619,"_5":13189,"_26134":105582,"_2648":105620},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3150":63747,"_27624":63727,"_19171":105622,"_5":13189,"_26134":105586,"_2648":105623},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3150":63748,"_27624":63748,"_5":13515,"_2648":105625,"_27967":105626,"_19171":105627,"_26134":63748},"Despliega Lamassu",[44933,105554],[],{"_3150":63749,"_27624":63748,"_19171":105629,"_5":13189,"_26134":63748,"_2648":105630},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3150":63750,"_27624":63748,"_5":27964,"_19171":105632,"_26134":105633,"_2648":105634},[],"/docs/pr-preview/pr-26/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3150":63751,"_27624":63748,"_5":27964,"_19171":105636,"_26134":105637,"_2648":105638},[],"/docs/pr-preview/pr-26/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3150":63752,"_27624":63748,"_5":27964,"_19171":105640,"_26134":105641,"_2648":105642},[],"/docs/pr-preview/pr-26/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3150":63753,"_27624":63748,"_19171":105644,"_5":13189,"_26134":63748,"_2648":105645},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3150":63754,"_27624":63748,"_19171":105647,"_5":13189,"_26134":105633,"_2648":105648},[],"Modelo",{"_3150":63755,"_27624":63748,"_19171":105650,"_5":13189,"_26134":105633,"_2648":105651},[],"Recomendado para",{"_3150":63756,"_27624":63748,"_19171":105653,"_5":13189,"_26134":105633,"_2648":105654},[],"Quién opera la infraestructura",{"_3150":63757,"_27624":63748,"_19171":105656,"_5":13189,"_26134":105633,"_2648":105657},[],"Punto de partida",{"_3150":63758,"_27624":63748,"_19171":105659,"_5":13189,"_26134":105633,"_2648":45040},[],{"_3150":63759,"_27624":63748,"_19171":105661,"_5":13189,"_26134":105633,"_2648":105662},[],"Producción, entornos regulados y despliegues personalizados",{"_3150":63760,"_27624":63748,"_19171":105664,"_5":13189,"_26134":105633,"_2648":105665},[],"Tu equipo",{"_3150":63761,"_27624":63748,"_19171":105667,"_5":13189,"_26134":105633,"_2648":105668},[],"Helm o Fastlane",{"_3150":63762,"_27624":63748,"_19171":105670,"_5":13189,"_26134":105633,"_2648":45052},[],{"_3150":63763,"_27624":63748,"_19171":105672,"_5":13189,"_26134":105633,"_2648":105673},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3150":63764,"_27624":63748,"_19171":105675,"_5":13189,"_26134":105633,"_2648":105665},[],{"_3150":63765,"_27624":63748,"_19171":105677,"_5":13189,"_26134":105633,"_2648":105678},[],"Imagen preconfigurada en EC2",{"_3150":63766,"_27624":63748,"_19171":105680,"_5":13189,"_26134":105633,"_2648":45063},[],{"_3150":63767,"_27624":63748,"_19171":105682,"_5":13189,"_26134":105633,"_2648":105683},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3150":63768,"_27624":63748,"_19171":105685,"_5":13189,"_26134":105633,"_2648":45069},[],{"_3150":63769,"_27624":63748,"_19171":105687,"_5":13189,"_26134":105633,"_2648":105688},[],"Suscripción gestionada",{"_3150":63770,"_27624":63748,"_19171":105690,"_5":13189,"_26134":105633,"_2648":105691},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3150":63771,"_27624":63748,"_19171":105693,"_5":13189,"_26134":105633,"_2648":105694},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3150":63772,"_27624":63748,"_19171":105696,"_5":13189,"_26134":105633,"_2648":105697},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3150":63773,"_27624":63748,"_19171":105699,"_5":13189,"_26134":105637,"_2648":105700},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3150":63774,"_27624":63748,"_19171":105702,"_5":13189,"_26134":105641,"_2648":105703},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3150":63775,"_27624":63775,"_5":13515,"_2648":105705,"_27967":105706,"_19171":105707,"_26134":63775},"Utiliza Lamassu como SaaS",[44933,105554,105555],[],{"_3150":63776,"_27624":63775,"_19171":105709,"_5":13189,"_26134":63775,"_2648":105710},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3150":63777,"_27624":63775,"_5":27964,"_19171":105712,"_26134":105713,"_2648":105714},[],"/docs/pr-preview/pr-26/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3150":63778,"_27624":63775,"_5":27964,"_19171":105716,"_26134":105717,"_2648":105718},[],"/docs/pr-preview/pr-26/es/deployment/saas#planes","Planes",{"_3150":63779,"_27624":63775,"_5":27964,"_19171":105720,"_26134":105721,"_2648":105722},[],"/docs/pr-preview/pr-26/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3150":63780,"_27624":63775,"_19171":105724,"_5":13189,"_26134":63775,"_2648":105725},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3150":63781,"_27624":63775,"_19171":105727,"_5":13189,"_26134":105713,"_2648":105728},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3150":63782,"_27624":63775,"_19171":105730,"_5":13189,"_26134":105713,"_2648":105731},[],"Copias de seguridad automáticas.",{"_3150":63783,"_27624":63775,"_19171":105733,"_5":13189,"_26134":105713,"_2648":105734},[],"Actualizaciones de versión.",{"_3150":63784,"_27624":63775,"_19171":105736,"_5":13189,"_26134":105713,"_2648":105737},[],"Soporte técnico y SLA según el plan contratado.",{"_3150":63785,"_27624":63775,"_19171":105739,"_5":13189,"_26134":105717,"_2648":45124},[],{"_3150":63786,"_27624":63775,"_19171":105741,"_5":13189,"_26134":105717,"_2648":105742},[],"Dispositivos",{"_3150":63787,"_27624":63775,"_19171":105744,"_5":13189,"_26134":105717,"_2648":105745},[],"Soporte",{"_3150":63788,"_27624":63775,"_19171":105747,"_5":13189,"_26134":105717,"_2648":45133},[],{"_3150":63789,"_27624":63775,"_19171":105749,"_5":13189,"_26134":105717,"_2648":45136},[],{"_3150":63790,"_27624":63775,"_19171":105751,"_5":13189,"_26134":105717,"_2648":105752},[],"Hasta 1.000",{"_3150":63791,"_27624":63775,"_19171":105754,"_5":13189,"_26134":105717,"_2648":45142},[],{"_3150":63792,"_27624":63775,"_19171":105756,"_5":13189,"_26134":105717,"_2648":105757},[],"99,5 %",{"_3150":63793,"_27624":63775,"_19171":105759,"_5":13189,"_26134":105717,"_2648":45148},[],{"_3150":63794,"_27624":63775,"_19171":105761,"_5":13189,"_26134":105717,"_2648":105762},[],"Hasta 10.000",{"_3150":63795,"_27624":63775,"_19171":105764,"_5":13189,"_26134":105717,"_2648":105765},[],"Email y chat",{"_3150":63796,"_27624":63775,"_19171":105767,"_5":13189,"_26134":105717,"_2648":105768},[],"99,9 %",{"_3150":63797,"_27624":63775,"_19171":105770,"_5":13189,"_26134":105717,"_2648":45160},[],{"_3150":63798,"_27624":63775,"_19171":105772,"_5":13189,"_26134":105717,"_2648":105773},[],"Ilimitados",{"_3150":63799,"_27624":63775,"_19171":105775,"_5":13189,"_26134":105717,"_2648":105776},[],"Dedicado",{"_3150":63800,"_27624":63775,"_19171":105778,"_5":13189,"_26134":105717,"_2648":105779},[],"99,99 %",{"_3150":63801,"_27624":63775,"_19171":105781,"_5":13189,"_26134":105721,"_2648":105782},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3150":63802,"_27624":63775,"_19171":105784,"_5":13189,"_26134":105721,"_2648":105785},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3150":63803,"_27624":63803,"_5":13515,"_2648":45177,"_27967":105787,"_19171":105789,"_26134":63803},[44933,105554,105788],"Kubernetes autogestionado",[],{"_3150":63804,"_27624":63803,"_19171":105791,"_5":13189,"_26134":63803,"_2648":105792},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3150":63805,"_27624":63803,"_5":27964,"_19171":105794,"_26134":105795,"_2648":105796},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3150":63806,"_27624":63803,"_5":27964,"_19171":105798,"_26134":105799,"_2648":105800},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3150":63807,"_27624":63803,"_5":27964,"_19171":105802,"_26134":105803,"_2648":105804},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3150":63808,"_27624":63803,"_5":27964,"_19171":105806,"_26134":105807,"_2648":105808},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3150":63809,"_27624":63803,"_5":27964,"_19171":105810,"_26134":105811,"_2648":105812},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3150":63810,"_27624":63803,"_5":27964,"_19171":105814,"_26134":105815,"_2648":105816},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3150":63811,"_27624":63803,"_5":27964,"_19171":105818,"_26134":105819,"_2648":105820},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3150":63812,"_27624":63803,"_5":27964,"_19171":105822,"_26134":105823,"_2648":105824},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3150":63813,"_27624":63803,"_5":27964,"_19171":105826,"_26134":105827,"_2648":105828},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3150":63814,"_27624":63803,"_5":27964,"_19171":105830,"_26134":105831,"_2648":105832},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3150":63815,"_27624":63803,"_5":27964,"_19171":105834,"_26134":105835,"_2648":105836},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3150":63816,"_27624":63803,"_19171":105838,"_5":13189,"_26134":105795,"_2648":105839},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3150":63817,"_27624":63803,"_19171":105841,"_5":13189,"_26134":105795,"_2648":105842},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3150":63818,"_27624":63803,"_19171":105844,"_5":13189,"_26134":105799,"_2648":105845},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3150":63819,"_27624":63803,"_19171":105847,"_5":13189,"_26134":105799,"_2648":105848},[],"Fastlane instala o configura",{"_3150":63820,"_27624":63803,"_19171":105850,"_5":13189,"_26134":105799,"_2648":105851},[],"Tú sigues proporcionando",{"_3150":63821,"_27624":63803,"_19171":105853,"_5":13189,"_26134":105799,"_2648":105854},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3150":63822,"_27624":63803,"_19171":105856,"_5":13189,"_26134":105799,"_2648":105857},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3150":63823,"_27624":63803,"_19171":105859,"_5":13189,"_26134":105799,"_2648":105860},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3150":63824,"_27624":63803,"_19171":105862,"_5":13189,"_26134":105799,"_2648":105863},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3150":63825,"_27624":63803,"_19171":105865,"_5":13189,"_26134":105799,"_2648":105866},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3150":63826,"_27624":63803,"_19171":105868,"_5":13189,"_26134":105799,"_2648":105869},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3150":63827,"_27624":63803,"_19171":105871,"_5":13189,"_26134":105799,"_2648":105872},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3150":63828,"_27624":63803,"_19171":105874,"_5":13189,"_26134":105799,"_2648":105875},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3150":63829,"_27624":63803,"_19171":105877,"_5":13189,"_26134":105799,"_2648":105878},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3150":63830,"_27624":63803,"_19171":105880,"_5":13189,"_26134":105803,"_2648":105881},[],"Necesitas:",{"_3150":63831,"_27624":63803,"_19171":105883,"_5":13189,"_26134":105803,"_2648":105884},[],"un clúster Kubernetes existente",{"_3150":63832,"_27624":63803,"_19171":105886,"_5":13189,"_26134":105803,"_2648":105887},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3150":63833,"_27624":63803,"_19171":105889,"_5":13189,"_26134":105803,"_2648":45279},[],{"_3150":63834,"_27624":63803,"_19171":105891,"_5":13189,"_26134":105803,"_2648":21707},[],{"_3150":63835,"_27624":63803,"_19171":105893,"_5":13189,"_26134":105803,"_2648":105894},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3150":63836,"_27624":63803,"_19171":105896,"_5":13189,"_26134":105803,"_2648":105897},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3150":63837,"_27624":63803,"_19171":105899,"_5":13189,"_26134":105803,"_2648":105900},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3150":63838,"_27624":63803,"_19171":105902,"_5":13189,"_26134":105803,"_2648":105903},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3150":63839,"_27624":63803,"_19171":105905,"_5":13189,"_26134":105803,"_2648":105906},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3150":63840,"_27624":63803,"_19171":105908,"_5":13189,"_26134":105807,"_2648":105909},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3150":63841,"_27624":63803,"_19171":105911,"_5":13189,"_26134":105807,"_2648":105912},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3150":63842,"_27624":63803,"_19171":105914,"_5":13189,"_26134":105811,"_2648":105915},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3150":63843,"_27624":63803,"_19171":105917,"_5":13189,"_26134":105811,"_2648":105918},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3150":63844,"_27624":63803,"_19171":105920,"_5":13189,"_26134":105811,"_2648":105921},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3150":63845,"_27624":63803,"_19171":105923,"_5":13189,"_26134":105811,"_2648":105924},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3150":63846,"_27624":63803,"_19171":105926,"_5":13189,"_26134":105815,"_2648":105927},[],"Opción",{"_3150":63847,"_27624":63803,"_19171":105929,"_5":13189,"_26134":105815,"_2648":105930},[],"Valor predeterminado",{"_3150":63848,"_27624":63803,"_19171":105932,"_5":13189,"_26134":105815,"_2648":105933},[],"Propósito",{"_3150":63849,"_27624":63803,"_19171":105935,"_5":13189,"_26134":105815,"_2648":45326},[],{"_3150":63850,"_27624":63803,"_19171":105937,"_5":13189,"_26134":105815,"_2648":45329},[],{"_3150":63851,"_27624":63803,"_19171":105939,"_5":13189,"_26134":105815,"_2648":105940},[],"Muestra la ayuda",{"_3150":63852,"_27624":63803,"_19171":105942,"_5":13189,"_26134":105815,"_2648":45335},[],{"_3150":63853,"_27624":63803,"_19171":105944,"_5":13189,"_26134":105815,"_2648":105945},[],"contexto actual",{"_3150":63854,"_27624":63803,"_19171":105947,"_5":13189,"_26134":105815,"_2648":105948},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3150":63855,"_27624":63803,"_19171":105950,"_5":13189,"_26134":105815,"_2648":45344},[],{"_3150":63856,"_27624":63803,"_19171":105952,"_5":13189,"_26134":105815,"_2648":5899},[],{"_3150":63857,"_27624":63803,"_19171":105954,"_5":13189,"_26134":105815,"_2648":105955},[],"Omite prompts y genera credenciales para las dependencias",{"_3150":63858,"_27624":63803,"_19171":105957,"_5":13189,"_26134":105815,"_2648":45352},[],{"_3150":63859,"_27624":63803,"_19171":105959,"_5":13189,"_26134":105815,"_2648":45355},[],{"_3150":63860,"_27624":63803,"_19171":105961,"_5":13189,"_26134":105815,"_2648":105962},[],"Namespace de la instalación",{"_3150":63861,"_27624":63803,"_19171":105964,"_5":13189,"_26134":105815,"_2648":45361},[],{"_3150":63862,"_27624":63803,"_19171":105966,"_5":13189,"_26134":105815,"_2648":45364},[],{"_3150":63863,"_27624":63803,"_19171":105968,"_5":13189,"_26134":105815,"_2648":105969},[],"Dominio usado por la UI, OIDC y el certificado",{"_3150":63864,"_27624":63803,"_19171":105971,"_5":13189,"_26134":105815,"_2648":45370},[],{"_3150":63865,"_27624":63803,"_19171":105973,"_5":13189,"_26134":105815,"_2648":13791},[],{"_3150":63866,"_27624":63803,"_19171":105975,"_5":13189,"_26134":105815,"_2648":105976},[],"Versión del chart de Lamassu",{"_3150":63867,"_27624":63803,"_19171":105978,"_5":13189,"_26134":105815,"_2648":45378},[],{"_3150":63868,"_27624":63803,"_19171":105980,"_5":13189,"_26134":105815,"_2648":45381},[],{"_3150":63869,"_27624":63803,"_19171":105982,"_5":13189,"_26134":105815,"_2648":105983},[],"Puerto del listener HTTPS",{"_3150":63870,"_27624":63803,"_19171":105985,"_5":13189,"_26134":105815,"_2648":45387},[],{"_3150":63871,"_27624":63803,"_19171":105987,"_5":13189,"_26134":105815,"_2648":45390},[],{"_3150":63872,"_27624":63803,"_19171":105989,"_5":13189,"_26134":105815,"_2648":105990},[],"Puerto del listener HTTP",{"_3150":63873,"_27624":63803,"_19171":105992,"_5":13189,"_26134":105815,"_2648":45396},[],{"_3150":63874,"_27624":63803,"_19171":105994,"_5":13189,"_26134":105815,"_2648":45329},[],{"_3150":63875,"_27624":63803,"_19171":105996,"_5":13189,"_26134":105815,"_2648":105997},[],"Certificado PEM para TLS downstream",{"_3150":63876,"_27624":63803,"_19171":105999,"_5":13189,"_26134":105815,"_2648":45404},[],{"_3150":63877,"_27624":63803,"_19171":106001,"_5":13189,"_26134":105815,"_2648":45329},[],{"_3150":63878,"_27624":63803,"_19171":106003,"_5":13189,"_26134":105815,"_2648":106004},[],"Clave privada PEM para TLS downstream",{"_3150":63879,"_27624":63803,"_19171":106006,"_5":13189,"_26134":105815,"_2648":45412},[],{"_3150":63880,"_27624":63803,"_19171":106008,"_5":13189,"_26134":105815,"_2648":106009},[],"chart del repositorio",{"_3150":63881,"_27624":63803,"_19171":106011,"_5":13189,"_26134":105815,"_2648":106012},[],"Usa un chart local de Lamassu sin empaquetar",{"_3150":63882,"_27624":63803,"_19171":106014,"_5":13189,"_26134":105815,"_2648":45421},[],{"_3150":63883,"_27624":63803,"_19171":106016,"_5":13189,"_26134":105815,"_2648":106017},[],"detección automática",{"_3150":63884,"_27624":63803,"_19171":106019,"_5":13189,"_26134":105815,"_2648":106020},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3150":63885,"_27624":63803,"_19171":106022,"_5":13189,"_26134":105815,"_2648":45429},[],{"_3150":63886,"_27624":63803,"_19171":106024,"_5":13189,"_26134":105815,"_2648":5899},[],{"_3150":63887,"_27624":63803,"_19171":106026,"_5":13189,"_26134":105815,"_2648":106027},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3150":63888,"_27624":63803,"_19171":106029,"_5":13189,"_26134":105815,"_2648":45437},[],{"_3150":63889,"_27624":63803,"_19171":106031,"_5":13189,"_26134":105815,"_2648":5899},[],{"_3150":63890,"_27624":63803,"_19171":106033,"_5":13189,"_26134":105815,"_2648":106034},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3150":63891,"_27624":63803,"_19171":106036,"_5":13189,"_26134":105815,"_2648":45445},[],{"_3150":63892,"_27624":63803,"_19171":106038,"_5":13189,"_26134":105815,"_2648":5899},[],{"_3150":63893,"_27624":63803,"_19171":106040,"_5":13189,"_26134":105815,"_2648":106041},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3150":63894,"_27624":63803,"_19171":106043,"_5":13189,"_26134":105815,"_2648":45453},[],{"_3150":63895,"_27624":63803,"_19171":106045,"_5":13189,"_26134":105815,"_2648":5899},[],{"_3150":63896,"_27624":63803,"_19171":106047,"_5":13189,"_26134":105815,"_2648":106048},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3150":63897,"_27624":63803,"_19171":106050,"_5":13189,"_26134":105815,"_2648":45461},[],{"_3150":63898,"_27624":63803,"_19171":106052,"_5":13189,"_26134":105815,"_2648":45464},[],{"_3150":63899,"_27624":63803,"_19171":106054,"_5":13189,"_26134":105815,"_2648":106055},[],"Usa otro chart local de SoftHSM",{"_3150":63900,"_27624":63803,"_19171":106057,"_5":13189,"_26134":105815,"_2648":106058},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3150":63901,"_27624":63803,"_19171":106060,"_5":13189,"_26134":105819,"_2648":106061},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3150":63902,"_27624":63803,"_19171":106063,"_5":13189,"_26134":105819,"_2648":106064},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3150":63903,"_27624":63803,"_19171":106066,"_5":13189,"_26134":105819,"_2648":106067},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3150":63904,"_27624":63803,"_19171":106069,"_5":13189,"_26134":105819,"_2648":106070},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3150":63905,"_27624":63803,"_19171":106072,"_5":13189,"_26134":105819,"_2648":106073},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3150":63906,"_27624":63803,"_19171":106075,"_5":13189,"_26134":105819,"_2648":106076},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3150":63907,"_27624":63803,"_19171":106078,"_5":13189,"_26134":105823,"_2648":45491},[],{"_3150":63908,"_27624":63803,"_19171":106080,"_5":13189,"_26134":105823,"_2648":106081},[],"valida las herramientas locales y el clúster seleccionado",{"_3150":63909,"_27624":63803,"_19171":106083,"_5":13189,"_26134":105823,"_2648":106084},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3150":63910,"_27624":63803,"_19171":106086,"_5":13189,"_26134":105823,"_2648":106087},[],"crea el namespace",{"_3150":63911,"_27624":63803,"_19171":106089,"_5":13189,"_26134":105823,"_2648":106090},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3150":63912,"_27624":63803,"_19171":106092,"_5":13189,"_26134":105823,"_2648":106093},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3150":63913,"_27624":63803,"_19171":106095,"_5":13189,"_26134":105823,"_2648":106096},[],"instala RabbitMQ",{"_3150":63914,"_27624":63803,"_19171":106098,"_5":13189,"_26134":105823,"_2648":106099},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3150":63915,"_27624":63803,"_19171":106101,"_5":13189,"_26134":105823,"_2648":106102},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3150":63916,"_27624":63803,"_19171":106104,"_5":13189,"_26134":105823,"_2648":106105},[],"carga datos de ejemplo opcionalmente",{"_3150":63917,"_27624":63803,"_19171":106107,"_5":13189,"_26134":105823,"_2648":106108},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3150":63918,"_27624":63803,"_19171":106110,"_5":13189,"_26134":105827,"_2648":106111},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3150":63919,"_27624":63803,"_19171":106113,"_5":13189,"_26134":105827,"_2648":106114},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3150":63920,"_27624":63803,"_19171":106116,"_5":13189,"_26134":105831,"_2648":106117},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3150":63921,"_27624":63803,"_19171":106119,"_5":13189,"_26134":105831,"_2648":106120},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3150":63922,"_27624":63803,"_19171":106122,"_5":13189,"_26134":105831,"_2648":106123},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3150":63923,"_27624":63803,"_19171":106125,"_5":13189,"_26134":105835,"_2648":106126},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3150":63924,"_27624":63924,"_5":13515,"_2648":106128,"_27967":106129,"_19171":106130,"_26134":63924},"Instala con Helm",[44933,105554,105788],[],{"_3150":63925,"_27624":63924,"_19171":106132,"_5":13189,"_26134":63924,"_2648":106133},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3150":63926,"_27624":63924,"_5":27964,"_19171":106135,"_26134":106136,"_2648":106137},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3150":63927,"_27624":63924,"_5":27964,"_19171":106139,"_26134":106140,"_2648":105804},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3150":63928,"_27624":63924,"_5":27964,"_19171":106142,"_26134":106143,"_2648":106144},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3150":63929,"_27624":63924,"_5":27964,"_19171":106146,"_26134":106147,"_2648":106148},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3150":63930,"_27624":63924,"_5":27964,"_19171":106150,"_26134":106151,"_2648":106152},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3150":63931,"_27624":63924,"_5":27964,"_19171":106154,"_26134":106155,"_2648":106156},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3150":63932,"_27624":63924,"_5":27964,"_19171":106158,"_26134":106159,"_2648":106160},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3150":63933,"_27624":63924,"_5":27964,"_19171":106162,"_26134":106163,"_2648":106164},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3150":63934,"_27624":63924,"_5":27964,"_19171":106166,"_26134":106167,"_2648":106168},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3150":63935,"_27624":63924,"_19171":106170,"_5":13189,"_26134":106136,"_2648":106171},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3150":63936,"_27624":63924,"_19171":106173,"_5":13189,"_26134":106140,"_2648":106174},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3150":63937,"_27624":63924,"_19171":106176,"_5":13189,"_26134":106140,"_2648":106177},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3150":63938,"_27624":63924,"_19171":106179,"_5":13189,"_26134":106140,"_2648":106180},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3150":63939,"_27624":63924,"_19171":106182,"_5":13189,"_26134":106140,"_2648":106183},[],"un broker RabbitMQ accesible y sus credenciales",{"_3150":63940,"_27624":63924,"_19171":106185,"_5":13189,"_26134":106140,"_2648":106186},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3150":63941,"_27624":63924,"_19171":106188,"_5":13189,"_26134":106140,"_2648":106189},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3150":63942,"_27624":63924,"_19171":106191,"_5":13189,"_26134":106140,"_2648":106192},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3150":63943,"_27624":63924,"_19171":106194,"_5":13189,"_26134":106140,"_2648":106195},[],"una StorageClass y un diseño de tráfico externo",{"_3150":63944,"_27624":63924,"_19171":106197,"_5":13189,"_26134":106140,"_2648":106198},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3150":63945,"_27624":63924,"_19171":106200,"_5":13189,"_26134":106140,"_2648":106201},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3150":63946,"_27624":63924,"_19171":106203,"_5":13189,"_26134":106140,"_2648":106204},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3150":63947,"_27624":63924,"_19171":106206,"_5":13189,"_26134":106143,"_2648":106207},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3150":63948,"_27624":63924,"_19171":106209,"_5":13189,"_26134":106143,"_2648":106210},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3150":63949,"_27624":63924,"_19171":106212,"_5":13189,"_26134":106143,"_2648":106213},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_3150":63950,"_27624":63924,"_19171":106215,"_5":13189,"_26134":106147,"_2648":106216},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3150":63951,"_27624":63924,"_19171":106218,"_5":13189,"_26134":106147,"_2648":106219},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3150":63952,"_27624":63924,"_19171":106221,"_5":13189,"_26134":106147,"_2648":106222},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3150":63953,"_27624":63924,"_19171":106224,"_5":13189,"_26134":106151,"_2648":106225},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_3150":63954,"_27624":63924,"_19171":106227,"_5":13189,"_26134":106155,"_2648":106228},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3150":63955,"_27624":63924,"_19171":106230,"_5":13189,"_26134":106155,"_2648":106231},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3150":63956,"_27624":63924,"_19171":106233,"_5":13189,"_26134":106155,"_2648":106234},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3150":63957,"_27624":63924,"_19171":106236,"_5":13189,"_26134":106155,"_2648":106237},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3150":63958,"_27624":63924,"_19171":106239,"_5":13189,"_26134":106159,"_2648":106240},[],"Para instalar un checkout local:",{"_3150":63959,"_27624":63924,"_19171":106242,"_5":13189,"_26134":106163,"_2648":106243},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3150":63960,"_27624":63924,"_19171":106245,"_5":13189,"_26134":106163,"_2648":106246},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3150":63961,"_27624":63924,"_19171":106248,"_5":13189,"_26134":106167,"_2648":106249},[],"Antes de pasar a producción, revisa:",{"_3150":63962,"_27624":63924,"_19171":106251,"_5":13189,"_26134":106167,"_2648":106252},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3150":63963,"_27624":63924,"_19171":106254,"_5":13189,"_26134":106167,"_2648":106255},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3150":63964,"_27624":63924,"_19171":106257,"_5":13189,"_26134":106167,"_2648":106258},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3150":63965,"_27624":63924,"_19171":106260,"_5":13189,"_26134":106167,"_2648":106261},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3150":63966,"_27624":63924,"_19171":106263,"_5":13189,"_26134":106167,"_2648":106264},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3150":63967,"_27624":63924,"_19171":106266,"_5":13189,"_26134":106167,"_2648":106267},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3150":63968,"_27624":63924,"_19171":106269,"_5":13189,"_26134":106167,"_2648":106270},[],"SMTP, observabilidad y entrega de alertas",{"_3150":63969,"_27624":63924,"_19171":106272,"_5":13189,"_26134":106167,"_2648":106273},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3150":63970,"_27624":63924,"_19171":106275,"_5":13189,"_26134":106167,"_2648":106276},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3150":63971,"_27624":63971,"_5":13515,"_2648":106278,"_27967":106279,"_19171":106280,"_26134":63971},"Expón el Gateway",[44933,105554,105788],[],{"_3150":63972,"_27624":63971,"_19171":106282,"_5":13189,"_26134":63971,"_2648":106283},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3150":63973,"_27624":63971,"_5":27964,"_19171":106285,"_26134":106286,"_2648":106287},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3150":63974,"_27624":63971,"_5":27964,"_19171":106289,"_26134":106290,"_2648":106291},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3150":63975,"_27624":63971,"_5":27964,"_19171":106293,"_26134":106294,"_2648":106295},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3150":63976,"_27624":63971,"_5":27964,"_19171":106297,"_26134":106298,"_2648":45712},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#k3s",{"_3150":63977,"_27624":63971,"_5":27964,"_19171":106300,"_26134":106301,"_2648":106302},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3150":63978,"_27624":63971,"_5":27964,"_19171":106304,"_26134":106305,"_2648":106306},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3150":63979,"_27624":63971,"_5":27964,"_19171":106308,"_26134":106309,"_2648":106310},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3150":63980,"_27624":63971,"_5":27964,"_19171":106312,"_26134":106313,"_2648":106314},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3150":63981,"_27624":63971,"_5":27964,"_19171":106316,"_26134":106317,"_2648":106318},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3150":63982,"_27624":63971,"_19171":106320,"_5":13189,"_26134":106286,"_2648":106321},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3150":63983,"_27624":63971,"_19171":106323,"_5":13189,"_26134":106286,"_2648":106324},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3150":63984,"_27624":63971,"_19171":106326,"_5":13189,"_26134":106290,"_2648":106327},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3150":63985,"_27624":63971,"_19171":106329,"_5":13189,"_26134":106290,"_2648":106330},[],"Defínelo únicamente cuando:",{"_3150":63986,"_27624":63971,"_19171":106332,"_5":13189,"_26134":106290,"_2648":106333},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3150":63987,"_27624":63971,"_19171":106335,"_5":13189,"_26134":106290,"_2648":106336},[],"esa dirección está asignada a este Gateway",{"_3150":63988,"_27624":63971,"_19171":106338,"_5":13189,"_26134":106290,"_2648":106339},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3150":63989,"_27624":63971,"_19171":106341,"_5":13189,"_26134":106290,"_2648":106342},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3150":63990,"_27624":63971,"_19171":106344,"_5":13189,"_26134":106290,"_2648":106345},[],"No confundas estos valores:",{"_3150":63991,"_27624":63971,"_19171":106347,"_5":13189,"_26134":106290,"_2648":106348},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3150":63992,"_27624":63971,"_19171":106350,"_5":13189,"_26134":106290,"_2648":106351},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3150":63993,"_27624":63971,"_19171":106353,"_5":13189,"_26134":106290,"_2648":106354},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3150":63994,"_27624":63971,"_19171":106356,"_5":13189,"_26134":106294,"_2648":106357},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3150":63995,"_27624":63971,"_19171":106359,"_5":13189,"_26134":106294,"_2648":106360},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3150":63996,"_27624":63971,"_19171":106362,"_5":13189,"_26134":106298,"_2648":106363},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3150":63997,"_27624":63971,"_19171":106365,"_5":13189,"_26134":106298,"_2648":106366},[],"Para el diseño recomendado:",{"_3150":63998,"_27624":63971,"_19171":106368,"_5":13189,"_26134":106298,"_2648":106369},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3150":63999,"_27624":63971,"_19171":106371,"_5":13189,"_26134":106298,"_2648":106372},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3150":64000,"_27624":63971,"_19171":106374,"_5":13189,"_26134":106298,"_2648":106375},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3150":64001,"_27624":63971,"_19171":106377,"_5":13189,"_26134":106298,"_2648":106378},[],"Apunta DNS a la dirección accesible de la VM.",{"_3150":64002,"_27624":63971,"_19171":106380,"_5":13189,"_26134":106298,"_2648":106381},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3150":64003,"_27624":63971,"_19171":106383,"_5":13189,"_26134":106301,"_2648":106384},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3150":64004,"_27624":63971,"_19171":106386,"_5":13189,"_26134":106305,"_2648":106387},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3150":64005,"_27624":63971,"_19171":106389,"_5":13189,"_26134":106305,"_2648":106390},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3150":64006,"_27624":63971,"_19171":106392,"_5":13189,"_26134":106309,"_2648":106393},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3150":64007,"_27624":63971,"_19171":106395,"_5":13189,"_26134":106309,"_2648":106396},[],"Requisito",{"_3150":64008,"_27624":63971,"_19171":106398,"_5":13189,"_26134":106309,"_2648":106399},[],"Diseño recomendado",{"_3150":64009,"_27624":63971,"_19171":106401,"_5":13189,"_26134":106309,"_2648":106402},[],"Consecuencia",{"_3150":64010,"_27624":63971,"_19171":106404,"_5":13189,"_26134":106309,"_2648":106405},[],"Varias URL o servicios de Lamassu",{"_3150":64011,"_27624":63971,"_19171":106407,"_5":13189,"_26134":106309,"_2648":106408},[],"Un Gateway con varias rutas",{"_3150":64012,"_27624":63971,"_19171":106410,"_5":13189,"_26134":106309,"_2648":106411},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3150":64013,"_27624":63971,"_19171":106413,"_5":13189,"_26134":106309,"_2648":106414},[],"Gateways independientes e IP externas distintas",{"_3150":64014,"_27624":63971,"_19171":106416,"_5":13189,"_26134":106309,"_2648":106417},[],"Una VIP por Gateway",{"_3150":64015,"_27624":63971,"_19171":106419,"_5":13189,"_26134":106309,"_2648":106420},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3150":64016,"_27624":63971,"_19171":106422,"_5":13189,"_26134":106309,"_2648":106423},[],"Gateways independientes, un nodo y una IP",{"_3150":64017,"_27624":63971,"_19171":106425,"_5":13189,"_26134":106309,"_2648":106426},[],"Puertos externos diferentes",{"_3150":64018,"_27624":63971,"_19171":106428,"_5":13189,"_26134":106309,"_2648":106429},[],"Los clientes deben indicar puertos no estándar",{"_3150":64019,"_27624":63971,"_19171":106431,"_5":13189,"_26134":106309,"_2648":106432},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3150":64020,"_27624":63971,"_19171":106434,"_5":13189,"_26134":106309,"_2648":106435},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3150":64021,"_27624":63971,"_19171":106437,"_5":13189,"_26134":106309,"_2648":106438},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3150":64022,"_27624":63971,"_19171":106440,"_5":13189,"_26134":106309,"_2648":106441},[],"Recursos Gateway separados pero proxy compartido",{"_3150":64023,"_27624":63971,"_19171":106443,"_5":13189,"_26134":106309,"_2648":106444},[],"Modo merged Gateway de Envoy",{"_3150":64024,"_27624":63971,"_19171":106446,"_5":13189,"_26134":106309,"_2648":106447},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3150":64025,"_27624":63971,"_19171":106449,"_5":13189,"_26134":106309,"_2648":106450},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3150":64026,"_27624":63971,"_19171":106452,"_5":13189,"_26134":106309,"_2648":106453},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3150":64027,"_27624":63971,"_19171":106455,"_5":13189,"_26134":106309,"_2648":106456},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3150":64028,"_27624":63971,"_19171":106458,"_5":13189,"_26134":106309,"_2648":106459},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3150":64029,"_27624":63971,"_19171":106461,"_5":13189,"_26134":106313,"_2648":106462},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3150":64030,"_27624":63971,"_19171":106464,"_5":13189,"_26134":106313,"_2648":106465},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3150":64031,"_27624":63971,"_19171":106467,"_5":13189,"_26134":106313,"_2648":106468},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3150":64032,"_27624":63971,"_19171":106470,"_5":13189,"_26134":106313,"_2648":106471},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3150":64033,"_27624":63971,"_19171":106473,"_5":13189,"_26134":106313,"_2648":106474},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3150":64034,"_27624":63971,"_19171":106476,"_5":13189,"_26134":106317,"_2648":106477},[],"Comprueba, en orden:",{"_3150":64035,"_27624":63971,"_19171":106479,"_5":13189,"_26134":106317,"_2648":106480},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3150":64036,"_27624":63971,"_19171":106482,"_5":13189,"_26134":106317,"_2648":106483},[],"Su estado contiene la dirección esperada.",{"_3150":64037,"_27624":63971,"_19171":106485,"_5":13189,"_26134":106317,"_2648":106486},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3150":64038,"_27624":63971,"_19171":106488,"_5":13189,"_26134":106317,"_2648":106489},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3150":64039,"_27624":63971,"_19171":106491,"_5":13189,"_26134":106317,"_2648":106492},[],"DNS resuelve al endpoint accesible externamente.",{"_3150":64040,"_27624":63971,"_19171":106494,"_5":13189,"_26134":106317,"_2648":106495},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3150":64041,"_27624":63971,"_19171":106497,"_5":13189,"_26134":106317,"_2648":106498},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3150":64042,"_27624":64042,"_5":13515,"_2648":45040,"_27967":106500,"_19171":106501,"_26134":64042},[44933,105554,105788],[],{"_3150":64043,"_27624":64042,"_19171":106503,"_5":13189,"_26134":64042,"_2648":106504},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3150":64044,"_27624":64042,"_5":27964,"_19171":106506,"_26134":106507,"_2648":106508},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3150":64045,"_27624":64042,"_5":27964,"_19171":106510,"_26134":106511,"_2648":106512},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3150":64046,"_27624":64042,"_5":27964,"_19171":106514,"_26134":106515,"_2648":106516},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3150":64047,"_27624":64042,"_5":27964,"_19171":106518,"_26134":106519,"_2648":106520},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3150":64048,"_27624":64042,"_5":27964,"_19171":106522,"_26134":106523,"_2648":106524},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3150":64049,"_27624":64042,"_5":27964,"_19171":106526,"_26134":106527,"_2648":106528},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3150":64050,"_27624":64042,"_19171":106530,"_5":13189,"_26134":106507,"_2648":106531},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3150":64051,"_27624":64042,"_19171":106533,"_5":13189,"_26134":106511,"_2648":106534},[],"Flujo",{"_3150":64052,"_27624":64042,"_19171":106536,"_5":13189,"_26134":106511,"_2648":106537},[],"Úsalo para",{"_3150":64053,"_27624":64042,"_19171":106539,"_5":13189,"_26134":106511,"_2648":106540},[],"Qué instala",{"_3150":64054,"_27624":64042,"_19171":106542,"_5":13189,"_26134":106511,"_2648":45957},[],{"_3150":64055,"_27624":64042,"_19171":106544,"_5":13189,"_26134":106511,"_2648":106545},[],"Producción y entornos controlados",{"_3150":64056,"_27624":64042,"_19171":106547,"_5":13189,"_26134":106511,"_2648":106548},[],"Servicios de Lamassu y recursos de Gateway API",{"_3150":64057,"_27624":64042,"_19171":106550,"_5":13189,"_26134":106511,"_2648":45177},[],{"_3150":64058,"_27624":64042,"_19171":106552,"_5":13189,"_26134":106511,"_2648":106553},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3150":64059,"_27624":64042,"_19171":106555,"_5":13189,"_26134":106511,"_2648":106556},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3150":64060,"_27624":64042,"_19171":106558,"_5":13189,"_26134":106515,"_2648":106559},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3150":64061,"_27624":64042,"_19171":106561,"_5":13189,"_26134":106515,"_2648":106562},[],"Área",{"_3150":64062,"_27624":64042,"_19171":106564,"_5":13189,"_26134":106515,"_2648":106565},[],"El chart de Lamassu proporciona",{"_3150":64063,"_27624":64042,"_19171":106567,"_5":13189,"_26134":106515,"_2648":106568},[],"Tú proporcionas",{"_3150":64064,"_27624":64042,"_19171":106570,"_5":13189,"_26134":106515,"_2648":106571},[],"Aplicaciones Lamassu",{"_3150":64065,"_27624":64042,"_19171":106573,"_5":13189,"_26134":106515,"_2648":106574},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3150":64066,"_27624":64042,"_19171":106576,"_5":13189,"_26134":106515,"_2648":106577},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3150":64067,"_27624":64042,"_19171":106579,"_5":13189,"_26134":106515,"_2648":106580},[],"Datos PostgreSQL",{"_3150":64068,"_27624":64042,"_19171":106582,"_5":13189,"_26134":106515,"_2648":106583},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3150":64069,"_27624":64042,"_19171":106585,"_5":13189,"_26134":106515,"_2648":106586},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3150":64070,"_27624":64042,"_19171":106588,"_5":13189,"_26134":106515,"_2648":106589},[],"Mensajería",{"_3150":64071,"_27624":64042,"_19171":106591,"_5":13189,"_26134":106515,"_2648":106592},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3150":64072,"_27624":64042,"_19171":106594,"_5":13189,"_26134":106515,"_2648":106595},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3150":64073,"_27624":64042,"_19171":106597,"_5":13189,"_26134":106515,"_2648":106598},[],"Identidad",{"_3150":64074,"_27624":64042,"_19171":106600,"_5":13189,"_26134":106515,"_2648":106601},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3150":64075,"_27624":64042,"_19171":106603,"_5":13189,"_26134":106515,"_2648":106604},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3150":64076,"_27624":64042,"_19171":106606,"_5":13189,"_26134":106515,"_2648":106607},[],"Enrutamiento externo",{"_3150":64077,"_27624":64042,"_19171":106609,"_5":13189,"_26134":106515,"_2648":106610},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3150":64078,"_27624":64042,"_19171":106612,"_5":13189,"_26134":106515,"_2648":106613},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3150":64079,"_27624":64042,"_19171":106615,"_5":13189,"_26134":106515,"_2648":46031},[],{"_3150":64080,"_27624":64042,"_19171":106617,"_5":13189,"_26134":106515,"_2648":106618},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_3150":64081,"_27624":64042,"_19171":106620,"_5":13189,"_26134":106515,"_2648":106621},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3150":64082,"_27624":64042,"_19171":106623,"_5":13189,"_26134":106515,"_2648":106624},[],"Datos persistentes de la aplicación",{"_3150":64083,"_27624":64042,"_19171":106626,"_5":13189,"_26134":106515,"_2648":106627},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3150":64084,"_27624":64042,"_19171":106629,"_5":13189,"_26134":106515,"_2648":106630},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3150":64085,"_27624":64042,"_19171":106632,"_5":13189,"_26134":106515,"_2648":106633},[],"Integraciones opcionales",{"_3150":64086,"_27624":64042,"_19171":106635,"_5":13189,"_26134":106515,"_2648":106636},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3150":64087,"_27624":64042,"_19171":106638,"_5":13189,"_26134":106515,"_2648":106639},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3150":64088,"_27624":64042,"_19171":106641,"_5":13189,"_26134":106515,"_2648":106642},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3150":64089,"_27624":64042,"_19171":106644,"_5":13189,"_26134":106515,"_2648":106645},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3150":64090,"_27624":64042,"_19171":106647,"_5":13189,"_26134":106519,"_2648":106648},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3150":64091,"_27624":64042,"_19171":106650,"_5":13189,"_26134":106519,"_2648":106651},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3150":64092,"_27624":64042,"_19171":106653,"_5":13189,"_26134":106523,"_2648":106654},[],"Kubernetes 1.24 o posterior",{"_3150":64093,"_27624":64042,"_19171":106656,"_5":13189,"_26134":106523,"_2648":106657},[],"Helm 3.2 o posterior",{"_3150":64094,"_27624":64042,"_19171":106659,"_5":13189,"_26134":106523,"_2648":106660},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3150":64095,"_27624":64042,"_19171":106662,"_5":13189,"_26134":106523,"_2648":106663},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_3150":64096,"_27624":64042,"_19171":106665,"_5":13189,"_26134":106523,"_2648":106666},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3150":64097,"_27624":64042,"_19171":106668,"_5":13189,"_26134":106523,"_2648":106669},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3150":64098,"_27624":64042,"_19171":106671,"_5":13189,"_26134":106523,"_2648":106672},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3150":64099,"_27624":64042,"_19171":106674,"_5":13189,"_26134":106527,"_2648":106675},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":64100,"_27624":64042,"_19171":106677,"_5":13189,"_26134":106527,"_2648":106678},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3150":64101,"_27624":64042,"_19171":106680,"_5":13189,"_26134":106527,"_2648":106681},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3150":64102,"_27624":64042,"_19171":106683,"_5":13189,"_26134":106527,"_2648":106684},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3150":64103,"_27624":64103,"_5":13515,"_2648":106686,"_27967":106687,"_19171":106689,"_26134":64103},"Resolución de problemas de despliegue",[44933,105554,106688],"Operación",[],{"_3150":64104,"_27624":64103,"_19171":106691,"_5":13189,"_26134":64103,"_2648":106692},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3150":64105,"_27624":64103,"_5":27964,"_19171":106694,"_26134":106695,"_2648":106696},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3150":64106,"_27624":64103,"_5":27964,"_19171":106698,"_26134":106699,"_2648":106700},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3150":64107,"_27624":64103,"_5":27964,"_19171":106702,"_26134":106703,"_2648":106704},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3150":64108,"_27624":64103,"_5":27964,"_19171":106706,"_26134":106707,"_2648":106708},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3150":64109,"_27624":64103,"_5":27964,"_19171":106710,"_26134":106711,"_2648":106712},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3150":64110,"_27624":64103,"_5":27964,"_19171":106714,"_26134":106715,"_2648":106716},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3150":64111,"_27624":64103,"_5":27964,"_19171":106718,"_26134":106719,"_2648":106720},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3150":64112,"_27624":64103,"_5":27964,"_19171":106722,"_26134":106723,"_2648":106724},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3150":64113,"_27624":64103,"_5":27964,"_19171":106726,"_26134":106727,"_2648":106728},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3150":64114,"_27624":64103,"_5":27964,"_19171":106730,"_26134":106731,"_2648":106732},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3150":64115,"_27624":64103,"_5":27964,"_19171":106734,"_26134":106735,"_2648":106736},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3150":64116,"_27624":64103,"_5":27964,"_19171":106738,"_26134":106739,"_2648":106740},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3150":64117,"_27624":64103,"_19171":106742,"_5":13189,"_26134":64103,"_2648":106743},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3150":64118,"_27624":64103,"_19171":106745,"_5":13189,"_26134":106699,"_2648":106746},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3150":64119,"_27624":64103,"_19171":106748,"_5":13189,"_26134":106703,"_2648":106749},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3150":64120,"_27624":64103,"_19171":106751,"_5":13189,"_26134":106707,"_2648":106752},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3150":64121,"_27624":64103,"_19171":106754,"_5":13189,"_26134":106711,"_2648":106755},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3150":64122,"_27624":64103,"_19171":106757,"_5":13189,"_26134":106715,"_2648":106758},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3150":64123,"_27624":64103,"_19171":106760,"_5":13189,"_26134":106719,"_2648":106761},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3150":64124,"_27624":64103,"_19171":106763,"_5":13189,"_26134":106719,"_2648":106764},[],"Ejecuta también la prueba de conectividad del chart:",{"_3150":64125,"_27624":64103,"_19171":106766,"_5":13189,"_26134":106719,"_2648":106767},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3150":64126,"_27624":64103,"_19171":106769,"_5":13189,"_26134":106719,"_2648":106770},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3150":64127,"_27624":64103,"_19171":106772,"_5":13189,"_26134":106723,"_2648":106773},[],"Si recibes un 401:",{"_3150":64128,"_27624":64103,"_19171":106775,"_5":13189,"_26134":106723,"_2648":106776},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3150":64129,"_27624":64103,"_19171":106778,"_5":13189,"_26134":106723,"_2648":106779},[],"verifica emisor, audiencia y expiración del token;",{"_3150":64130,"_27624":64103,"_19171":106781,"_5":13189,"_26134":106723,"_2648":106782},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3150":64131,"_27624":64103,"_19171":106784,"_5":13189,"_26134":106723,"_2648":106785},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3150":64132,"_27624":64103,"_19171":106787,"_5":13189,"_26134":106723,"_2648":106788},[],"Si el login termina pero las APIs devuelven 403:",{"_3150":64133,"_27624":64103,"_19171":106790,"_5":13189,"_26134":106723,"_2648":106791},[],"inspecciona los claims reales del token;",{"_3150":64134,"_27624":64103,"_19171":106793,"_5":13189,"_26134":106723,"_2648":106794},[],"confirma que coinciden con un principal activo;",{"_3150":64135,"_27624":64103,"_19171":106796,"_5":13189,"_26134":106723,"_2648":106797},[],"revisa las políticas concedidas al principal;",{"_3150":64136,"_27624":64103,"_19171":106799,"_5":13189,"_26134":106723,"_2648":106800},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3150":64137,"_27624":64103,"_19171":106802,"_5":13189,"_26134":106723,"_2648":106803},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3150":64138,"_27624":64103,"_19171":106805,"_5":13189,"_26134":106727,"_2648":106806},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3150":64139,"_27624":64103,"_19171":106808,"_5":13189,"_26134":106727,"_2648":106809},[],"Localiza el pod y Service de authz.",{"_3150":64140,"_27624":64103,"_19171":106811,"_5":13189,"_26134":106727,"_2648":106812},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3150":64141,"_27624":64103,"_19171":106814,"_5":13189,"_26134":106727,"_2648":106815},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3150":64142,"_27624":64103,"_19171":106817,"_5":13189,"_26134":106727,"_2648":106818},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3150":64143,"_27624":64103,"_19171":106820,"_5":13189,"_26134":106727,"_2648":106821},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3150":64144,"_27624":64103,"_19171":106823,"_5":13189,"_26134":106731,"_2648":106824},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3150":64145,"_27624":64103,"_19171":106826,"_5":13189,"_26134":106731,"_2648":106827},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3150":64146,"_27624":64103,"_19171":106829,"_5":13189,"_26134":106731,"_2648":106830},[],"volumen persistente sin enlazar;",{"_3150":64147,"_27624":64103,"_19171":106832,"_5":13189,"_26134":106731,"_2648":106833},[],"imagen inaccesible o política de pull incorrecta;",{"_3150":64148,"_27624":64103,"_19171":106835,"_5":13189,"_26134":106731,"_2648":106836},[],"configuración inválida del motor criptográfico;",{"_3150":64149,"_27624":64103,"_19171":106838,"_5":13189,"_26134":106731,"_2648":106839},[],"límites de CPU o memoria demasiado bajos;",{"_3150":64150,"_27624":64103,"_19171":106841,"_5":13189,"_26134":106731,"_2648":106842},[],"migración previa incompleta.",{"_3150":64151,"_27624":64103,"_19171":106844,"_5":13189,"_26134":106731,"_2648":106845},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3150":64152,"_27624":64103,"_19171":106847,"_5":13189,"_26134":106731,"_2648":106848},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3150":64153,"_27624":64103,"_19171":106850,"_5":13189,"_26134":106735,"_2648":106851},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3150":64154,"_27624":64103,"_19171":106853,"_5":13189,"_26134":106735,"_2648":106854},[],"verifica que esté habilitado en el servicio emisor;",{"_3150":64155,"_27624":64103,"_19171":106856,"_5":13189,"_26134":106735,"_2648":106857},[],"comprueba conectividad y credenciales AMQP;",{"_3150":64156,"_27624":64103,"_19171":106859,"_5":13189,"_26134":106735,"_2648":106860},[],"revisa exchange, routing key, colas y consumidores;",{"_3150":64157,"_27624":64103,"_19171":106862,"_5":13189,"_26134":106735,"_2648":106863},[],"inspecciona dead-letter queues;",{"_3150":64158,"_27624":64103,"_19171":106865,"_5":13189,"_26134":106735,"_2648":106866},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3150":64159,"_27624":64103,"_19171":106868,"_5":13189,"_26134":106735,"_2648":106869},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3150":64160,"_27624":64103,"_19171":106871,"_5":13189,"_26134":106739,"_2648":106872},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3150":64161,"_27624":64103,"_19171":106874,"_5":13189,"_26134":106739,"_2648":106875},[],"Antes de cerrar una incidencia, guarda:",{"_3150":64162,"_27624":64103,"_19171":106877,"_5":13189,"_26134":106739,"_2648":106878},[],"causa confirmada;",{"_3150":64163,"_27624":64103,"_19171":106880,"_5":13189,"_26134":106739,"_2648":106881},[],"alcance temporal y recursos afectados;",{"_3150":64164,"_27624":64103,"_19171":106883,"_5":13189,"_26134":106739,"_2648":106884},[],"comandos o consultas utilizados;",{"_3150":64165,"_27624":64103,"_19171":106886,"_5":13189,"_26134":106739,"_2648":106887},[],"cambio aplicado y forma de revertirlo;",{"_3150":64166,"_27624":64103,"_19171":106889,"_5":13189,"_26134":106739,"_2648":106890},[],"validación desde un consumidor;",{"_3150":64167,"_27624":64103,"_19171":106892,"_5":13189,"_26134":106739,"_2648":106893},[],"acción preventiva y propietario.",{"_3150":64168,"_27624":64168,"_5":13515,"_2648":106895,"_27967":106896,"_19171":106899,"_26134":64168},"Control de acceso",[44933,106897,106898],"Plataforma","Administración",[],{"_3150":64169,"_27624":64168,"_19171":106901,"_5":13189,"_26134":64168,"_2648":106902},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3150":64170,"_27624":64168,"_5":27964,"_19171":106904,"_26134":106905,"_2648":106906},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3150":64171,"_27624":64168,"_5":27964,"_19171":106908,"_26134":106909,"_2648":106910},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3150":64172,"_27624":64168,"_5":27964,"_19171":106912,"_26134":106913,"_2648":106914},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3150":64173,"_27624":64168,"_5":27964,"_19171":106916,"_26134":106917,"_2648":106918},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3150":64174,"_27624":64168,"_5":27964,"_19171":106920,"_26134":106921,"_2648":106922},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3150":64175,"_27624":64168,"_5":27964,"_19171":106924,"_26134":106925,"_2648":106926},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3150":64176,"_27624":64168,"_5":27964,"_19171":106928,"_26134":106929,"_2648":106930},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3150":64177,"_27624":64168,"_5":27964,"_19171":106932,"_26134":106933,"_2648":106934},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3150":64178,"_27624":64168,"_5":27964,"_19171":106936,"_26134":106937,"_2648":106938},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3150":64179,"_27624":64168,"_5":27964,"_19171":106940,"_26134":106941,"_2648":106942},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3150":64180,"_27624":64168,"_5":27964,"_19171":106944,"_26134":106945,"_2648":106946},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3150":64181,"_27624":64168,"_5":27964,"_19171":106948,"_26134":106949,"_2648":106950},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3150":64182,"_27624":64168,"_5":27964,"_19171":106952,"_26134":106953,"_2648":106954},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3150":64183,"_27624":64168,"_5":27964,"_19171":106956,"_26134":106957,"_2648":106958},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3150":64184,"_27624":64168,"_5":27964,"_19171":106960,"_26134":106961,"_2648":106962},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3150":64185,"_27624":64168,"_5":27964,"_19171":106964,"_26134":106965,"_2648":106156},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3150":64186,"_27624":64168,"_5":27964,"_19171":106967,"_26134":106968,"_2648":106969},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3150":64187,"_27624":64168,"_5":27964,"_19171":106971,"_26134":106972,"_2648":106973},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3150":64188,"_27624":64168,"_5":27964,"_19171":106975,"_26134":106976,"_2648":106977},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3150":64189,"_27624":64168,"_5":27964,"_19171":106979,"_26134":106980,"_2648":106981},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3150":64190,"_27624":64168,"_5":27964,"_19171":106983,"_26134":106984,"_2648":106985},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3150":64191,"_27624":64168,"_5":27964,"_19171":106987,"_26134":106988,"_2648":106989},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3150":64192,"_27624":64168,"_5":27964,"_19171":106991,"_26134":106992,"_2648":106993},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3150":64193,"_27624":64168,"_5":27964,"_19171":106995,"_26134":106996,"_2648":106997},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3150":64194,"_27624":64168,"_5":27964,"_19171":106999,"_26134":107000,"_2648":107001},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3150":64195,"_27624":64168,"_5":27964,"_19171":107003,"_26134":107004,"_2648":107005},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3150":64196,"_27624":64168,"_5":27964,"_19171":107007,"_26134":107008,"_2648":107009},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3150":64197,"_27624":64168,"_5":27964,"_19171":107011,"_26134":107012,"_2648":107013},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3150":64198,"_27624":64168,"_5":27964,"_19171":107015,"_26134":107016,"_2648":107017},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3150":64199,"_27624":64168,"_5":27964,"_19171":107019,"_26134":107020,"_2648":107021},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3150":64200,"_27624":64168,"_5":27964,"_19171":107023,"_26134":107024,"_2648":107025},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3150":64201,"_27624":64168,"_19171":107027,"_5":13189,"_26134":64168,"_2648":107028},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3150":64202,"_27624":64168,"_19171":107030,"_5":13189,"_26134":64168,"_2648":107031},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3150":64203,"_27624":64168,"_19171":107033,"_5":13189,"_26134":64168,"_2648":107034},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3150":64204,"_27624":64168,"_19171":107036,"_5":13189,"_26134":106905,"_2648":107037},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3150":64205,"_27624":64168,"_19171":107039,"_5":13189,"_26134":106905,"_2648":107040},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3150":64206,"_27624":64168,"_19171":107042,"_5":13189,"_26134":106905,"_2648":107043},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3150":64207,"_27624":64168,"_19171":107045,"_5":13189,"_26134":106905,"_2648":107046},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3150":64208,"_27624":64168,"_19171":107048,"_5":13189,"_26134":106905,"_2648":107049},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3150":64209,"_27624":64168,"_19171":107051,"_5":13189,"_26134":106905,"_2648":107052},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3150":64210,"_27624":64168,"_19171":107054,"_5":13189,"_26134":106909,"_2648":107055},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3150":64211,"_27624":64168,"_19171":107057,"_5":13189,"_26134":106909,"_2648":107058},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3150":64212,"_27624":64168,"_19171":107060,"_5":13189,"_26134":106913,"_2648":107061},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3150":64213,"_27624":64168,"_19171":107063,"_5":13189,"_26134":106913,"_2648":107064},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3150":64214,"_27624":64168,"_19171":107066,"_5":13189,"_26134":106913,"_2648":107067},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3150":64215,"_27624":64168,"_19171":107069,"_5":13189,"_26134":106913,"_2648":107070},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3150":64216,"_27624":64168,"_19171":107072,"_5":13189,"_26134":106913,"_2648":107073},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3150":64217,"_27624":64168,"_19171":107075,"_5":13189,"_26134":106913,"_2648":107076},[],"Carga por separado las políticas concedidas a cada principal.",{"_3150":64218,"_27624":64168,"_19171":107078,"_5":13189,"_26134":106913,"_2648":107079},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3150":64219,"_27624":64168,"_19171":107081,"_5":13189,"_26134":106913,"_2648":107082},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3150":64220,"_27624":64168,"_19171":107084,"_5":13189,"_26134":106913,"_2648":107085},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3150":64221,"_27624":64168,"_19171":107087,"_5":13189,"_26134":106913,"_2648":107088},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3150":64222,"_27624":64168,"_19171":107090,"_5":13189,"_26134":106913,"_2648":107091},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3150":64223,"_27624":64168,"_19171":107093,"_5":13189,"_26134":106913,"_2648":107094},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3150":64224,"_27624":64168,"_19171":107096,"_5":13189,"_26134":106917,"_2648":107097},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3150":64225,"_27624":64168,"_19171":107099,"_5":13189,"_26134":106917,"_2648":107100},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3150":64226,"_27624":64168,"_19171":107102,"_5":13189,"_26134":106917,"_2648":107103},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3150":64227,"_27624":64168,"_19171":107105,"_5":13189,"_26134":106917,"_2648":107106},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3150":64228,"_27624":64168,"_19171":107108,"_5":13189,"_26134":106917,"_2648":107109},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3150":64229,"_27624":64168,"_19171":107111,"_5":13189,"_26134":106917,"_2648":107112},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3150":64230,"_27624":64168,"_19171":107114,"_5":13189,"_26134":106917,"_2648":107115},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3150":64231,"_27624":64168,"_19171":107117,"_5":13189,"_26134":106917,"_2648":107118},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3150":64232,"_27624":64168,"_19171":107120,"_5":13189,"_26134":106921,"_2648":107121},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3150":64233,"_27624":64168,"_19171":107123,"_5":13189,"_26134":106921,"_2648":107124},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3150":64234,"_27624":64168,"_19171":107126,"_5":13189,"_26134":106921,"_2648":107127},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3150":64235,"_27624":64168,"_19171":107129,"_5":13189,"_26134":106921,"_2648":107130},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3150":64236,"_27624":64168,"_19171":107132,"_5":13189,"_26134":106921,"_2648":107133},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3150":64237,"_27624":64168,"_19171":107135,"_5":13189,"_26134":106921,"_2648":107136},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3150":64238,"_27624":64168,"_19171":107138,"_5":13189,"_26134":106921,"_2648":107139},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3150":64239,"_27624":64168,"_19171":107141,"_5":13189,"_26134":106921,"_2648":107142},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3150":64240,"_27624":64168,"_19171":107144,"_5":13189,"_26134":106921,"_2648":107145},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3150":64241,"_27624":64168,"_19171":107147,"_5":13189,"_26134":106921,"_2648":107148},[],"Las acciones se dividen en dos grupos:",{"_3150":64242,"_27624":64168,"_19171":107150,"_5":13189,"_26134":106921,"_2648":107151},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3150":64243,"_27624":64168,"_19171":107153,"_5":13189,"_26134":106921,"_2648":107154},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3150":64244,"_27624":64168,"_19171":107156,"_5":13189,"_26134":106921,"_2648":107157},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3150":64245,"_27624":64168,"_19171":107159,"_5":13189,"_26134":106925,"_2648":107160},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3150":64246,"_27624":64168,"_19171":107162,"_5":13189,"_26134":106925,"_2648":107163},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3150":64247,"_27624":64168,"_19171":107165,"_5":13189,"_26134":106925,"_2648":107166},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3150":64248,"_27624":64168,"_19171":107168,"_5":13189,"_26134":106929,"_2648":107169},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3150":64249,"_27624":64168,"_19171":107171,"_5":13189,"_26134":106929,"_2648":107172},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3150":64250,"_27624":64168,"_19171":107174,"_5":13189,"_26134":106929,"_2648":107175},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3150":64251,"_27624":64168,"_19171":107177,"_5":13189,"_26134":106929,"_2648":107178},[],"Los operadores implementados son:",{"_3150":64252,"_27624":64168,"_19171":107180,"_5":13189,"_26134":106929,"_2648":107181},[],"`equals`, para igualdad exacta;",{"_3150":64253,"_27624":64168,"_19171":107183,"_5":13189,"_26134":106929,"_2648":107184},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3150":64254,"_27624":64168,"_19171":107186,"_5":13189,"_26134":106929,"_2648":107187},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3150":64255,"_27624":64168,"_19171":107189,"_5":13189,"_26134":106929,"_2648":107190},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3150":64256,"_27624":64168,"_19171":107192,"_5":13189,"_26134":106933,"_2648":107193},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3150":64257,"_27624":64168,"_19171":107195,"_5":13189,"_26134":106933,"_2648":107196},[],"Los modos disponibles son:",{"_3150":64258,"_27624":64168,"_19171":107198,"_5":13189,"_26134":106933,"_2648":107199},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3150":64259,"_27624":64168,"_19171":107201,"_5":13189,"_26134":106933,"_2648":107202},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3150":64260,"_27624":64168,"_19171":107204,"_5":13189,"_26134":106933,"_2648":107205},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3150":64261,"_27624":64168,"_19171":107207,"_5":13189,"_26134":106933,"_2648":107208},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3150":64262,"_27624":64168,"_19171":107210,"_5":13189,"_26134":106933,"_2648":107211},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3150":64263,"_27624":64168,"_19171":107213,"_5":13189,"_26134":106933,"_2648":107214},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3150":64264,"_27624":64168,"_19171":107216,"_5":13189,"_26134":106937,"_2648":107217},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3150":64265,"_27624":64168,"_19171":107219,"_5":13189,"_26134":106937,"_2648":107220},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3150":64266,"_27624":64168,"_19171":107222,"_5":13189,"_26134":106937,"_2648":107223},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3150":64267,"_27624":64168,"_19171":107225,"_5":13189,"_26134":106937,"_2648":107226},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3150":64268,"_27624":64168,"_19171":107228,"_5":13189,"_26134":106945,"_2648":107229},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3150":64269,"_27624":64168,"_19171":107231,"_5":13189,"_26134":106945,"_2648":107232},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3150":64270,"_27624":64168,"_19171":107234,"_5":13189,"_26134":106949,"_2648":107235},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3150":64271,"_27624":64168,"_19171":107237,"_5":13189,"_26134":106949,"_2648":107238},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3150":64272,"_27624":64168,"_19171":107240,"_5":13189,"_26134":106953,"_2648":107241},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3150":64273,"_27624":64168,"_19171":107243,"_5":13189,"_26134":106953,"_2648":107244},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3150":64274,"_27624":64168,"_19171":107246,"_5":13189,"_26134":106953,"_2648":107247},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3150":64275,"_27624":64168,"_19171":107249,"_5":13189,"_26134":106957,"_2648":107250},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3150":64276,"_27624":64168,"_19171":107252,"_5":13189,"_26134":106957,"_2648":107253},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3150":64277,"_27624":64168,"_19171":107255,"_5":13189,"_26134":106957,"_2648":107256},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3150":64278,"_27624":64168,"_19171":107258,"_5":13189,"_26134":106957,"_2648":107259},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3150":64279,"_27624":64168,"_19171":107261,"_5":13189,"_26134":106957,"_2648":107262},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3150":64280,"_27624":64168,"_19171":107264,"_5":13189,"_26134":106957,"_2648":107265},[],"Ten en cuenta que:",{"_3150":64281,"_27624":64168,"_19171":107267,"_5":13189,"_26134":106957,"_2648":107268},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3150":64282,"_27624":64168,"_19171":107270,"_5":13189,"_26134":106957,"_2648":107271},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3150":64283,"_27624":64168,"_19171":107273,"_5":13189,"_26134":106957,"_2648":107274},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3150":64284,"_27624":64168,"_19171":107276,"_5":13189,"_26134":106961,"_2648":107277},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3150":64285,"_27624":64168,"_19171":107279,"_5":13189,"_26134":106961,"_2648":107280},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3150":64286,"_27624":64168,"_19171":107282,"_5":13189,"_26134":106961,"_2648":107283},[],"acceso completo y de solo lectura a KMS;",{"_3150":64287,"_27624":64168,"_19171":107285,"_5":13189,"_26134":106961,"_2648":107286},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3150":64288,"_27624":64168,"_19171":107288,"_5":13189,"_26134":106961,"_2648":107289},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3150":64289,"_27624":64168,"_19171":107291,"_5":13189,"_26134":106961,"_2648":107292},[],"acceso a la interfaz;",{"_3150":64290,"_27624":64168,"_19171":107294,"_5":13189,"_26134":106961,"_2648":107295},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3150":64291,"_27624":64168,"_19171":107297,"_5":13189,"_26134":106961,"_2648":107298},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3150":64292,"_27624":64168,"_19171":107300,"_5":13189,"_26134":106961,"_2648":107301},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3150":64293,"_27624":64168,"_19171":107303,"_5":13189,"_26134":106965,"_2648":107304},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3150":64294,"_27624":64168,"_19171":107306,"_5":13189,"_26134":106965,"_2648":107307},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3150":64295,"_27624":64168,"_19171":107309,"_5":13189,"_26134":106965,"_2648":107310},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3150":64296,"_27624":64168,"_19171":107312,"_5":13189,"_26134":106968,"_2648":107313},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3150":64297,"_27624":64168,"_19171":107315,"_5":13189,"_26134":106972,"_2648":107316},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3150":64298,"_27624":64168,"_19171":107318,"_5":13189,"_26134":106972,"_2648":107319},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3150":64299,"_27624":64168,"_19171":107321,"_5":13189,"_26134":106976,"_2648":107322},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3150":64300,"_27624":64168,"_19171":107324,"_5":13189,"_26134":106980,"_2648":107325},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3150":64301,"_27624":64168,"_19171":107327,"_5":13189,"_26134":106984,"_2648":107328},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3150":64302,"_27624":64168,"_19171":107330,"_5":13189,"_26134":106988,"_2648":107331},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3150":64303,"_27624":64168,"_19171":107333,"_5":13189,"_26134":106988,"_2648":107334},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3150":64304,"_27624":64168,"_19171":107336,"_5":13189,"_26134":106992,"_2648":107337},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3150":64305,"_27624":64168,"_19171":107339,"_5":13189,"_26134":106992,"_2648":107340},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3150":64306,"_27624":64168,"_19171":107342,"_5":13189,"_26134":106992,"_2648":107343},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3150":64307,"_27624":64168,"_19171":107345,"_5":13189,"_26134":106992,"_2648":107346},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3150":64308,"_27624":64168,"_19171":107348,"_5":13189,"_26134":106992,"_2648":107349},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3150":64309,"_27624":64168,"_19171":107351,"_5":13189,"_26134":106992,"_2648":107352},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3150":64310,"_27624":64168,"_19171":107354,"_5":13189,"_26134":106992,"_2648":107355},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3150":64311,"_27624":64168,"_19171":107357,"_5":13189,"_26134":106992,"_2648":107358},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3150":64312,"_27624":64168,"_19171":107360,"_5":13189,"_26134":106996,"_2648":107361},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3150":64313,"_27624":64168,"_19171":107363,"_5":13189,"_26134":106996,"_2648":107364},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3150":64314,"_27624":64168,"_19171":107366,"_5":13189,"_26134":106996,"_2648":107367},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3150":64315,"_27624":64168,"_19171":107369,"_5":13189,"_26134":107000,"_2648":107370},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3150":64316,"_27624":64168,"_19171":107372,"_5":13189,"_26134":107000,"_2648":107373},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3150":64317,"_27624":64168,"_19171":107375,"_5":13189,"_26134":107000,"_2648":107376},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3150":64318,"_27624":64168,"_19171":107378,"_5":13189,"_26134":107000,"_2648":107379},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3150":64319,"_27624":64168,"_19171":107381,"_5":13189,"_26134":107000,"_2648":107382},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3150":64320,"_27624":64168,"_19171":107384,"_5":13189,"_26134":107000,"_2648":107385},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3150":64321,"_27624":64168,"_19171":107387,"_5":13189,"_26134":107000,"_2648":107388},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3150":64322,"_27624":64168,"_19171":107390,"_5":13189,"_26134":107000,"_2648":107391},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3150":64323,"_27624":64168,"_19171":107393,"_5":13189,"_26134":107008,"_2648":107394},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3150":64324,"_27624":64168,"_19171":107396,"_5":13189,"_26134":107012,"_2648":107397},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3150":64325,"_27624":64168,"_19171":107399,"_5":13189,"_26134":107012,"_2648":107400},[],"que exista un principal activo del tipo correcto;",{"_3150":64326,"_27624":64168,"_19171":107402,"_5":13189,"_26134":107012,"_2648":107403},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3150":64327,"_27624":64168,"_19171":107405,"_5":13189,"_26134":107012,"_2648":107406},[],"que todas las condiciones del principal se cumplan;",{"_3150":64328,"_27624":64168,"_19171":107408,"_5":13189,"_26134":107012,"_2648":107409},[],"que el principal tenga concedida la política esperada;",{"_3150":64329,"_27624":64168,"_19171":107411,"_5":13189,"_26134":107012,"_2648":107412},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3150":64330,"_27624":64168,"_19171":107414,"_5":13189,"_26134":107012,"_2648":107415},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3150":64331,"_27624":64168,"_19171":107417,"_5":13189,"_26134":107012,"_2648":107418},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3150":64332,"_27624":64168,"_19171":107420,"_5":13189,"_26134":107016,"_2648":107421},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3150":64333,"_27624":64168,"_19171":107423,"_5":13189,"_26134":107020,"_2648":107424},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3150":64334,"_27624":64168,"_19171":107426,"_5":13189,"_26134":107024,"_2648":107427},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3150":64335,"_27624":64168,"_19171":107429,"_5":13189,"_26134":107024,"_2648":107430},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3150":64336,"_27624":64336,"_5":13515,"_2648":107432,"_27967":107433,"_19171":107434,"_26134":64336},"Alertas y suscripciones",[44933,106897,106898],[],{"_3150":64337,"_27624":64336,"_19171":107436,"_5":13189,"_26134":64336,"_2648":107437},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3150":64338,"_27624":64336,"_5":27964,"_19171":107439,"_26134":107440,"_2648":107441},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3150":64339,"_27624":64336,"_5":27964,"_19171":107443,"_26134":107444,"_2648":107445},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3150":64340,"_27624":64336,"_5":27964,"_19171":107447,"_26134":107448,"_2648":107449},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3150":64341,"_27624":64336,"_5":27964,"_19171":107451,"_26134":107452,"_2648":107453},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3150":64342,"_27624":64336,"_5":27964,"_19171":107455,"_26134":107456,"_2648":107457},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3150":64343,"_27624":64336,"_5":27964,"_19171":107459,"_26134":107460,"_2648":107461},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3150":64344,"_27624":64336,"_5":27964,"_19171":107463,"_26134":107464,"_2648":107465},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3150":64345,"_27624":64336,"_5":27964,"_19171":107467,"_26134":107468,"_2648":107469},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3150":64346,"_27624":64336,"_5":27964,"_19171":107471,"_26134":107472,"_2648":107473},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3150":64347,"_27624":64336,"_5":27964,"_19171":107475,"_26134":107476,"_2648":107477},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3150":64348,"_27624":64336,"_19171":107479,"_5":13189,"_26134":64336,"_2648":107480},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3150":64349,"_27624":64336,"_19171":107482,"_5":13189,"_26134":107440,"_2648":107483},[],"Un servicio publica un evento de dominio.",{"_3150":64350,"_27624":64336,"_19171":107485,"_5":13189,"_26134":107440,"_2648":107486},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3150":64351,"_27624":64336,"_19171":107488,"_5":13189,"_26134":107440,"_2648":107489},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3150":64352,"_27624":64336,"_19171":107491,"_5":13189,"_26134":107440,"_2648":107492},[],"Lamassu entrega el evento al canal configurado.",{"_3150":64353,"_27624":64336,"_19171":107494,"_5":13189,"_26134":107440,"_2648":107495},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3150":64354,"_27624":64336,"_19171":107497,"_5":13189,"_26134":107444,"_2648":107498},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3150":64355,"_27624":64336,"_19171":107500,"_5":13189,"_26134":107444,"_2648":107501},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3150":64356,"_27624":64336,"_19171":107503,"_5":13189,"_26134":107444,"_2648":107504},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3150":64357,"_27624":64336,"_19171":107506,"_5":13189,"_26134":107444,"_2648":107507},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3150":64358,"_27624":64336,"_19171":107509,"_5":13189,"_26134":107444,"_2648":107510},[],"`apikey_options` necesita `header` y `key`.",{"_3150":64359,"_27624":64336,"_19171":107512,"_5":13189,"_26134":107444,"_2648":107513},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3150":64360,"_27624":64336,"_19171":107515,"_5":13189,"_26134":107444,"_2648":107516},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3150":64361,"_27624":64336,"_19171":107518,"_5":13189,"_26134":107444,"_2648":107519},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3150":64362,"_27624":64336,"_19171":107521,"_5":13189,"_26134":107452,"_2648":107522},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3150":64363,"_27624":64336,"_19171":107524,"_5":13189,"_26134":107456,"_2648":107525},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3150":64364,"_27624":64336,"_19171":107527,"_5":13189,"_26134":107460,"_2648":107528},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3150":64365,"_27624":64336,"_19171":107530,"_5":13189,"_26134":107460,"_2648":107531},[],"**None** notifica todas las instancias del evento.",{"_3150":64366,"_27624":64336,"_19171":107533,"_5":13189,"_26134":107460,"_2648":107534},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3150":64367,"_27624":64336,"_19171":107536,"_5":13189,"_26134":107460,"_2648":107537},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3150":64368,"_27624":64336,"_19171":107539,"_5":13189,"_26134":107460,"_2648":107540},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3150":64369,"_27624":64336,"_19171":107542,"_5":13189,"_26134":107460,"_2648":107543},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3150":64370,"_27624":64336,"_19171":107545,"_5":13189,"_26134":107464,"_2648":107546},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3150":64371,"_27624":64336,"_19171":107548,"_5":13189,"_26134":107468,"_2648":107549},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3150":64372,"_27624":64336,"_19171":107551,"_5":13189,"_26134":107468,"_2648":107552},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3150":64373,"_27624":64336,"_19171":107554,"_5":13189,"_26134":107468,"_2648":107555},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3150":64374,"_27624":64336,"_19171":107557,"_5":13189,"_26134":107468,"_2648":107558},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3150":64375,"_27624":64336,"_19171":107560,"_5":13189,"_26134":107468,"_2648":107561},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3150":64376,"_27624":64336,"_19171":107563,"_5":13189,"_26134":107468,"_2648":107564},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3150":64377,"_27624":64336,"_19171":107566,"_5":13189,"_26134":107468,"_2648":107567},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3150":64378,"_27624":64336,"_19171":107569,"_5":13189,"_26134":107468,"_2648":107570},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3150":64379,"_27624":64336,"_19171":107572,"_5":13189,"_26134":107472,"_2648":107573},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3150":64380,"_27624":64336,"_19171":107575,"_5":13189,"_26134":107476,"_2648":107576},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3150":64381,"_27624":64336,"_19171":107578,"_5":13189,"_26134":107476,"_2648":107579},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3150":64382,"_27624":64336,"_19171":107581,"_5":13189,"_26134":107476,"_2648":107582},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3150":64383,"_27624":64336,"_19171":107584,"_5":13189,"_26134":107476,"_2648":107585},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3150":64384,"_27624":64336,"_19171":107587,"_5":13189,"_26134":107476,"_2648":107588},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3150":64385,"_27624":64336,"_19171":107590,"_5":13189,"_26134":107476,"_2648":107591},[],"**Validación:** `va.role.crl.create`.",{"_3150":64386,"_27624":64336,"_19171":107593,"_5":13189,"_26134":107476,"_2648":107594},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3150":64387,"_27624":64336,"_19171":107596,"_5":13189,"_26134":107476,"_2648":107597},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3150":64388,"_27624":64388,"_5":13515,"_2648":107599,"_27967":107600,"_19171":107601,"_26134":64388},"Registros de auditoría",[44933,106897,106898],[],{"_3150":64389,"_27624":64388,"_19171":107603,"_5":13189,"_26134":64388,"_2648":107604},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3150":64390,"_27624":64388,"_5":27964,"_19171":107606,"_26134":107607,"_2648":107608},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3150":64391,"_27624":64388,"_5":27964,"_19171":107610,"_26134":107611,"_2648":107612},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3150":64392,"_27624":64388,"_5":27964,"_19171":107614,"_26134":107615,"_2648":107616},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3150":64393,"_27624":64388,"_5":27964,"_19171":107618,"_26134":107619,"_2648":107620},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3150":64394,"_27624":64388,"_5":27964,"_19171":107622,"_26134":107623,"_2648":107624},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3150":64395,"_27624":64388,"_5":27964,"_19171":107626,"_26134":107627,"_2648":107628},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3150":64396,"_27624":64388,"_5":27964,"_19171":107630,"_26134":107631,"_2648":107632},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3150":64397,"_27624":64388,"_5":27964,"_19171":107634,"_26134":107635,"_2648":107636},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3150":64398,"_27624":64388,"_5":27964,"_19171":107638,"_26134":107639,"_2648":107640},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3150":64399,"_27624":64388,"_5":27964,"_19171":107642,"_26134":107643,"_2648":107644},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3150":64400,"_27624":64388,"_5":27964,"_19171":107646,"_26134":107647,"_2648":107648},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3150":64401,"_27624":64388,"_19171":107650,"_5":13189,"_26134":64388,"_2648":107651},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3150":64402,"_27624":64388,"_19171":107653,"_5":13189,"_26134":107607,"_2648":107654},[],"El cuerpo de auditoría incluye:",{"_3150":64403,"_27624":64388,"_19171":107656,"_5":13189,"_26134":107607,"_2648":107657},[],"input: datos recibidos por la operación;",{"_3150":64404,"_27624":64388,"_19171":107659,"_5":13189,"_26134":107607,"_2648":107660},[],"has\\_error: indica si el servicio devolvió un error;",{"_3150":64405,"_27624":64388,"_19171":107662,"_5":13189,"_26134":107607,"_2648":107663},[],"output: resultado producido o mensaje de error;",{"_3150":64406,"_27624":64388,"_19171":107665,"_5":13189,"_26134":107607,"_2648":107666},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3150":64407,"_27624":64388,"_19171":107668,"_5":13189,"_26134":107607,"_2648":107669},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3150":64408,"_27624":64388,"_19171":107671,"_5":13189,"_26134":107607,"_2648":107672},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3150":64409,"_27624":64388,"_19171":107674,"_5":13189,"_26134":107611,"_2648":107675},[],"El backend aplica auditoría a mutaciones de:",{"_3150":64410,"_27624":64388,"_19171":107677,"_5":13189,"_26134":107611,"_2648":107678},[],"autoridades, certificados y perfiles de emisión;",{"_3150":64411,"_27624":64388,"_19171":107680,"_5":13189,"_26134":107611,"_2648":107681},[],"claves y motores KMS;",{"_3150":64412,"_27624":64388,"_19171":107683,"_5":13189,"_26134":107611,"_2648":107684},[],"dispositivos e identidades;",{"_3150":64413,"_27624":64388,"_19171":107686,"_5":13189,"_26134":107611,"_2648":107687},[],"DMS y operaciones de enrolamiento;",{"_3150":64414,"_27624":64388,"_19171":107689,"_5":13189,"_26134":107611,"_2648":107690},[],"funciones de validación y CRL;",{"_3150":64415,"_27624":64388,"_19171":107692,"_5":13189,"_26134":107611,"_2648":107693},[],"principales, políticas y concesiones de autorización.",{"_3150":64416,"_27624":64388,"_19171":107695,"_5":13189,"_26134":107611,"_2648":107696},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3150":64417,"_27624":64388,"_19171":107698,"_5":13189,"_26134":107615,"_2648":107699},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3150":64418,"_27624":64388,"_19171":107701,"_5":13189,"_26134":107615,"_2648":107702},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3150":64419,"_27624":64388,"_19171":107704,"_5":13189,"_26134":107615,"_2648":107705},[],"Diseña el consumidor para:",{"_3150":64420,"_27624":64388,"_19171":107707,"_5":13189,"_26134":107615,"_2648":107708},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3150":64421,"_27624":64388,"_19171":107710,"_5":13189,"_26134":107615,"_2648":107711},[],"conservar el CloudEvent completo sin modificar;",{"_3150":64422,"_27624":64388,"_19171":107713,"_5":13189,"_26134":107615,"_2648":107714},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3150":64423,"_27624":64388,"_19171":107716,"_5":13189,"_26134":107615,"_2648":107717},[],"cifrar en tránsito y en reposo;",{"_3150":64424,"_27624":64388,"_19171":107719,"_5":13189,"_26134":107615,"_2648":107720},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3150":64425,"_27624":64388,"_19171":107722,"_5":13189,"_26134":107615,"_2648":107723},[],"aplicar una política explícita de retención y legal hold;",{"_3150":64426,"_27624":64388,"_19171":107725,"_5":13189,"_26134":107615,"_2648":107726},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3150":64427,"_27624":64388,"_19171":107728,"_5":13189,"_26134":107619,"_2648":107729},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3150":64428,"_27624":64388,"_19171":107731,"_5":13189,"_26134":107619,"_2648":107732},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3150":64429,"_27624":64388,"_19171":107734,"_5":13189,"_26134":107627,"_2648":107735},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3150":64430,"_27624":64388,"_19171":107737,"_5":13189,"_26134":107631,"_2648":107738},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3150":64431,"_27624":64388,"_19171":107740,"_5":13189,"_26134":107635,"_2648":107741},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3150":64432,"_27624":64388,"_19171":107743,"_5":13189,"_26134":107639,"_2648":107744},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3150":64433,"_27624":64388,"_19171":107746,"_5":13189,"_26134":107643,"_2648":107747},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3150":64434,"_27624":64388,"_19171":107749,"_5":13189,"_26134":107647,"_2648":107750},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3150":64435,"_27624":64388,"_19171":107752,"_5":13189,"_26134":107647,"_2648":107753},[],"aparece un evento de auditoría correcto;",{"_3150":64436,"_27624":64388,"_19171":107755,"_5":13189,"_26134":107647,"_2648":107756},[],"el principal coincide con la identidad utilizada;",{"_3150":64437,"_27624":64388,"_19171":107758,"_5":13189,"_26134":107647,"_2648":107759},[],"el consumidor lo persiste una sola vez;",{"_3150":64438,"_27624":64388,"_19171":107761,"_5":13189,"_26134":107647,"_2648":107762},[],"puede recuperarse por recurso, actor y periodo;",{"_3150":64439,"_27624":64388,"_19171":107764,"_5":13189,"_26134":107647,"_2648":107765},[],"una interrupción del consumidor produce una alerta.",{"_3150":64440,"_27624":64388,"_19171":107767,"_5":13189,"_26134":107647,"_2648":107768},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3150":64441,"_27624":64441,"_5":13515,"_2648":107770,"_27967":107771,"_19171":107772,"_26134":64441},"Arquitectura de la plataforma",[44933,106897],[],{"_3150":64442,"_27624":64441,"_19171":107774,"_5":13189,"_26134":64441,"_2648":107775},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3150":64443,"_27624":64441,"_5":27964,"_19171":107777,"_26134":107778,"_2648":107779},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3150":64444,"_27624":64441,"_5":27964,"_19171":107781,"_26134":107782,"_2648":107783},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3150":64445,"_27624":64441,"_5":27964,"_19171":107785,"_26134":107786,"_2648":107787},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3150":64446,"_27624":64441,"_5":27964,"_19171":107789,"_26134":107790,"_2648":107791},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3150":64447,"_27624":64441,"_5":27964,"_19171":107793,"_26134":107794,"_2648":107795},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3150":64448,"_27624":64441,"_19171":107797,"_5":13189,"_26134":64441,"_2648":107798},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3150":64449,"_27624":64441,"_19171":107800,"_5":13189,"_26134":64441,"_2648":107801},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3150":64450,"_27624":64441,"_19171":107803,"_5":13189,"_26134":107778,"_2648":107804},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3150":64451,"_27624":64441,"_19171":107806,"_5":13189,"_26134":107782,"_2648":107807},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3150":64452,"_27624":64441,"_19171":107809,"_5":13189,"_26134":107786,"_2648":107810},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3150":64453,"_27624":64441,"_19171":107812,"_5":13189,"_26134":107790,"_2648":107813},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3150":64454,"_27624":64441,"_19171":107815,"_5":13189,"_26134":107794,"_2648":107816},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3150":64455,"_27624":64455,"_5":13515,"_2648":107818,"_27967":107819,"_19171":107820,"_26134":64455},"Cómo funciona Lamassu",[44933,106897],[],{"_3150":64456,"_27624":64455,"_19171":107822,"_5":13189,"_26134":64455,"_2648":107823},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3150":64457,"_27624":64455,"_5":27964,"_19171":107825,"_26134":107826,"_2648":107827},[],"/docs/pr-preview/pr-26/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3150":64458,"_27624":64455,"_5":27964,"_19171":107829,"_26134":107830,"_2648":107831},[],"/docs/pr-preview/pr-26/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3150":64459,"_27624":64455,"_19171":107833,"_5":13189,"_26134":64455,"_2648":107834},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3150":64460,"_27624":64455,"_19171":107836,"_5":13189,"_26134":107826,"_2648":107837},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3150":64461,"_27624":64455,"_19171":107839,"_5":13189,"_26134":107826,"_2648":107840},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3150":64462,"_27624":64455,"_19171":107842,"_5":13189,"_26134":107826,"_2648":107843},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3150":64463,"_27624":64455,"_19171":107845,"_5":13189,"_26134":107826,"_2648":107846},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3150":64464,"_27624":64455,"_19171":107848,"_5":13189,"_26134":107826,"_2648":107849},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3150":64465,"_27624":64455,"_19171":107851,"_5":13189,"_26134":107830,"_2648":107852},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3150":64466,"_27624":64455,"_19171":107854,"_5":13189,"_26134":107830,"_2648":107855},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3150":64467,"_27624":64455,"_19171":107857,"_5":13189,"_26134":107830,"_2648":107858},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3150":64468,"_27624":64455,"_19171":107860,"_5":13189,"_26134":107830,"_2648":107861},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3150":64469,"_27624":64455,"_19171":107863,"_5":13189,"_26134":107830,"_2648":107864},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3150":64470,"_27624":64455,"_19171":107866,"_5":13189,"_26134":107830,"_2648":107867},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3150":64471,"_27624":64455,"_19171":107869,"_5":13189,"_26134":107830,"_2648":107870},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3150":64472,"_27624":64472,"_5":13515,"_2648":107872,"_27967":107873,"_19171":107874,"_26134":64472},"Dispositivos e identidades",[44933,106897,47290,107872],[],{"_3150":64473,"_27624":64472,"_19171":107876,"_5":13189,"_26134":64472,"_2648":107877},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3150":64474,"_27624":64472,"_5":27964,"_19171":107879,"_26134":107880,"_2648":107881},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3150":64475,"_27624":64472,"_5":27964,"_19171":107883,"_26134":107884,"_2648":107885},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3150":64476,"_27624":64472,"_5":27964,"_19171":107887,"_26134":107888,"_2648":107889},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3150":64477,"_27624":64472,"_5":27964,"_19171":107891,"_26134":107892,"_2648":107893},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3150":64478,"_27624":64472,"_5":27964,"_19171":107895,"_26134":107896,"_2648":107897},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3150":64479,"_27624":64472,"_5":27964,"_19171":107899,"_26134":107900,"_2648":107901},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3150":64480,"_27624":64472,"_5":27964,"_19171":107903,"_26134":107904,"_2648":107905},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3150":64481,"_27624":64472,"_5":27964,"_19171":107907,"_26134":107908,"_2648":107909},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3150":64482,"_27624":64472,"_5":27964,"_19171":107911,"_26134":107912,"_2648":107913},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3150":64483,"_27624":64472,"_5":27964,"_19171":107915,"_26134":107916,"_2648":107917},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3150":64484,"_27624":64472,"_5":27964,"_19171":107919,"_26134":107920,"_2648":107921},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3150":64485,"_27624":64472,"_19171":107923,"_5":13189,"_26134":64472,"_2648":107924},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3150":64486,"_27624":64472,"_19171":107926,"_5":13189,"_26134":64472,"_2648":107927},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3150":64487,"_27624":64472,"_19171":107929,"_5":13189,"_26134":107880,"_2648":107930},[],"Vista operativa",{"_3150":64488,"_27624":64472,"_19171":107932,"_5":13189,"_26134":107880,"_2648":107933},[],"Interpretación",{"_3150":64489,"_27624":64472,"_19171":107935,"_5":13189,"_26134":107880,"_2648":47353},[],{"_3150":64490,"_27624":64472,"_19171":107937,"_5":13189,"_26134":107880,"_2648":107938},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3150":64491,"_27624":64472,"_19171":107940,"_5":13189,"_26134":107880,"_2648":47359},[],{"_3150":64492,"_27624":64472,"_19171":107942,"_5":13189,"_26134":107880,"_2648":107943},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3150":64493,"_27624":64472,"_19171":107945,"_5":13189,"_26134":107880,"_2648":47365},[],{"_3150":64494,"_27624":64472,"_19171":107947,"_5":13189,"_26134":107880,"_2648":107948},[],"La identidad está en la ventana operativa de renovación.",{"_3150":64495,"_27624":64472,"_19171":107950,"_5":13189,"_26134":107880,"_2648":47371},[],{"_3150":64496,"_27624":64472,"_19171":107952,"_5":13189,"_26134":107880,"_2648":107953},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3150":64497,"_27624":64472,"_19171":107955,"_5":13189,"_26134":107880,"_2648":47377},[],{"_3150":64498,"_27624":64472,"_19171":107957,"_5":13189,"_26134":107880,"_2648":107958},[],"La identidad ha vencido.",{"_3150":64499,"_27624":64472,"_19171":107960,"_5":13189,"_26134":107880,"_2648":47383},[],{"_3150":64500,"_27624":64472,"_19171":107962,"_5":13189,"_26134":107880,"_2648":107963},[],"La identidad está marcada como revocada.",{"_3150":64501,"_27624":64472,"_19171":107965,"_5":13189,"_26134":107880,"_2648":47389},[],{"_3150":64502,"_27624":64472,"_19171":107967,"_5":13189,"_26134":107880,"_2648":107968},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3150":64503,"_27624":64472,"_19171":107970,"_5":13189,"_26134":107880,"_2648":107971},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3150":64504,"_27624":64472,"_19171":107973,"_5":13189,"_26134":107884,"_2648":107974},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3150":64505,"_27624":64472,"_19171":107976,"_5":13189,"_26134":107884,"_2648":107977},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3150":64506,"_27624":64472,"_19171":107979,"_5":13189,"_26134":107884,"_2648":107980},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3150":64507,"_27624":64472,"_19171":107982,"_5":13189,"_26134":107884,"_2648":107983},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3150":64508,"_27624":64472,"_19171":107985,"_5":13189,"_26134":107888,"_2648":107986},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3150":64509,"_27624":64472,"_19171":107988,"_5":13189,"_26134":107892,"_2648":107989},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3150":64510,"_27624":64472,"_19171":107991,"_5":13189,"_26134":107896,"_2648":107992},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3150":64511,"_27624":64472,"_19171":107994,"_5":13189,"_26134":107900,"_2648":107995},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3150":64512,"_27624":64472,"_19171":107997,"_5":13189,"_26134":107904,"_2648":107998},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3150":64513,"_27624":64472,"_19171":108000,"_5":13189,"_26134":107904,"_2648":108001},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3150":64514,"_27624":64472,"_19171":108003,"_5":13189,"_26134":107908,"_2648":108004},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3150":64515,"_27624":64472,"_19171":108006,"_5":13189,"_26134":107908,"_2648":108007},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3150":64516,"_27624":64472,"_19171":108009,"_5":13189,"_26134":107908,"_2648":108010},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3150":64517,"_27624":64472,"_19171":108012,"_5":13189,"_26134":107908,"_2648":108013},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3150":64518,"_27624":64472,"_19171":108015,"_5":13189,"_26134":107908,"_2648":108016},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3150":64519,"_27624":64472,"_19171":108018,"_5":13189,"_26134":107908,"_2648":108019},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3150":64520,"_27624":64472,"_19171":108021,"_5":13189,"_26134":107912,"_2648":108022},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3150":64521,"_27624":64472,"_19171":108024,"_5":13189,"_26134":107912,"_2648":108025},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3150":64522,"_27624":64472,"_19171":108027,"_5":13189,"_26134":107916,"_2648":108028},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3150":64523,"_27624":64472,"_19171":108030,"_5":13189,"_26134":107916,"_2648":108031},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3150":64524,"_27624":64472,"_19171":108033,"_5":13189,"_26134":107916,"_2648":108034},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3150":64525,"_27624":64472,"_19171":108036,"_5":13189,"_26134":107916,"_2648":108037},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3150":64526,"_27624":64472,"_19171":108039,"_5":13189,"_26134":107920,"_2648":108040},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":64527,"_27624":64472,"_19171":108042,"_5":13189,"_26134":107920,"_2648":108043},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":64528,"_27624":64528,"_5":13515,"_2648":108045,"_27967":108046,"_19171":108048,"_26134":64528},"Identidad inicial y autenticación",[44933,106897,47290,107872,108047],"Enrolamiento con PKI",[],{"_3150":64529,"_27624":64528,"_19171":108050,"_5":13189,"_26134":64528,"_2648":108051},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3150":64530,"_27624":64528,"_5":27964,"_19171":108053,"_26134":108054,"_2648":108055},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3150":64531,"_27624":64528,"_5":27964,"_19171":108057,"_26134":108058,"_2648":108059},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3150":64532,"_27624":64528,"_5":27964,"_19171":108061,"_26134":108062,"_2648":108063},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3150":64533,"_27624":64528,"_5":27964,"_19171":108065,"_26134":108066,"_2648":108067},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3150":64534,"_27624":64528,"_5":27964,"_19171":108069,"_26134":108070,"_2648":108071},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3150":64535,"_27624":64528,"_19171":108073,"_5":13189,"_26134":64528,"_2648":108074},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3150":64536,"_27624":64528,"_19171":108076,"_5":13189,"_26134":108054,"_2648":108077},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3150":64537,"_27624":64528,"_19171":108079,"_5":13189,"_26134":108054,"_2648":108080},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3150":64538,"_27624":64528,"_19171":108082,"_5":13189,"_26134":108058,"_2648":108083},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3150":64539,"_27624":64528,"_19171":108085,"_5":13189,"_26134":108058,"_2648":108086},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3150":64540,"_27624":64528,"_19171":108088,"_5":13189,"_26134":108058,"_2648":108089},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3150":64541,"_27624":64528,"_19171":108091,"_5":13189,"_26134":108062,"_2648":108092},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3150":64542,"_27624":64528,"_19171":108094,"_5":13189,"_26134":108062,"_2648":108095},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3150":64543,"_27624":64528,"_19171":108097,"_5":13189,"_26134":108066,"_2648":108098},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3150":64544,"_27624":64528,"_19171":108100,"_5":13189,"_26134":108066,"_2648":108101},[],"Ejemplo de cuerpo:",{"_3150":64545,"_27624":64528,"_19171":108103,"_5":13189,"_26134":108066,"_2648":108104},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3150":64546,"_27624":64528,"_19171":108106,"_5":13189,"_26134":108066,"_2648":108107},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3150":64547,"_27624":64528,"_19171":108109,"_5":13189,"_26134":108066,"_2648":108110},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3150":64548,"_27624":64528,"_19171":108112,"_5":13189,"_26134":108066,"_2648":108113},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3150":64549,"_27624":64528,"_19171":108115,"_5":13189,"_26134":108070,"_2648":108116},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3150":64550,"_27624":64528,"_19171":108118,"_5":13189,"_26134":108070,"_2648":108119},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3150":64551,"_27624":64551,"_5":13515,"_2648":108121,"_27967":108122,"_19171":108123,"_26134":64551},"Configura y opera el DMS",[44933,106897,47290,107872,108047],[],{"_3150":64552,"_27624":64551,"_19171":108125,"_5":13189,"_26134":64551,"_2648":108126},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3150":64553,"_27624":64551,"_5":27964,"_19171":108128,"_26134":108129,"_2648":105563},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3150":64554,"_27624":64551,"_5":27964,"_19171":108131,"_26134":108132,"_2648":108133},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3150":64555,"_27624":64551,"_5":27964,"_19171":108135,"_26134":108136,"_2648":108137},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3150":64556,"_27624":64551,"_5":27964,"_19171":108139,"_26134":108140,"_2648":108141},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3150":64557,"_27624":64551,"_5":27964,"_19171":108143,"_26134":108144,"_2648":108145},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3150":64558,"_27624":64551,"_5":27964,"_19171":108147,"_26134":108148,"_2648":108149},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3150":64559,"_27624":64551,"_5":27964,"_19171":108151,"_26134":108152,"_2648":108153},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3150":64560,"_27624":64551,"_5":27964,"_19171":108155,"_26134":108156,"_2648":108157},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3150":64561,"_27624":64551,"_5":27964,"_19171":108159,"_26134":108160,"_2648":47585},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3150":64562,"_27624":64551,"_5":27964,"_19171":108162,"_26134":108163,"_2648":47589},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3150":64563,"_27624":64551,"_5":27964,"_19171":108165,"_26134":108166,"_2648":108167},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3150":64564,"_27624":64551,"_5":27964,"_19171":108169,"_26134":108170,"_2648":108171},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3150":64565,"_27624":64551,"_5":27964,"_19171":108173,"_26134":108174,"_2648":108175},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3150":64566,"_27624":64551,"_5":27964,"_19171":108177,"_26134":108178,"_2648":108179},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3150":64567,"_27624":64551,"_5":27964,"_19171":108181,"_26134":108182,"_2648":47609},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3150":64568,"_27624":64551,"_5":27964,"_19171":108184,"_26134":108185,"_2648":108186},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3150":64569,"_27624":64551,"_5":27964,"_19171":108188,"_26134":108189,"_2648":108190},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3150":64570,"_27624":64551,"_5":27964,"_19171":108192,"_26134":108193,"_2648":108194},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3150":64571,"_27624":64551,"_19171":108196,"_5":13189,"_26134":64551,"_2648":108197},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3150":64572,"_27624":64551,"_19171":108199,"_5":13189,"_26134":108129,"_2648":108200},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3150":64573,"_27624":64551,"_19171":108202,"_5":13189,"_26134":108129,"_2648":108203},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3150":64574,"_27624":64551,"_19171":108205,"_5":13189,"_26134":108136,"_2648":108206},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3150":64575,"_27624":64551,"_19171":108208,"_5":13189,"_26134":108140,"_2648":108209},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3150":64576,"_27624":64551,"_19171":108211,"_5":13189,"_26134":108144,"_2648":108212},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3150":64577,"_27624":64551,"_19171":108214,"_5":13189,"_26134":108148,"_2648":108215},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3150":64578,"_27624":64551,"_19171":108217,"_5":13189,"_26134":108152,"_2648":108218},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3150":64579,"_27624":64551,"_19171":108220,"_5":13189,"_26134":108160,"_2648":108221},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3150":64580,"_27624":64551,"_19171":108223,"_5":13189,"_26134":108160,"_2648":108224},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3150":64581,"_27624":64551,"_19171":108226,"_5":13189,"_26134":108163,"_2648":108227},[],"Campo de `settings.enrollment_settings`",{"_3150":64582,"_27624":64551,"_19171":108229,"_5":13189,"_26134":108163,"_2648":108230},[],"Decisión",{"_3150":64583,"_27624":64551,"_19171":108232,"_5":13189,"_26134":108163,"_2648":47660},[],{"_3150":64584,"_27624":64551,"_19171":108234,"_5":13189,"_26134":108163,"_2648":108235},[],"`EST_RFC7030` para estas operaciones.",{"_3150":64585,"_27624":64551,"_19171":108237,"_5":13189,"_26134":108163,"_2648":47666},[],{"_3150":64586,"_27624":64551,"_19171":108239,"_5":13189,"_26134":108163,"_2648":108240},[],"ID de la CA que firmará.",{"_3150":64587,"_27624":64551,"_19171":108242,"_5":13189,"_26134":108163,"_2648":47672},[],{"_3150":64588,"_27624":64551,"_19171":108244,"_5":13189,"_26134":108163,"_2648":108245},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3150":64589,"_27624":64551,"_19171":108247,"_5":13189,"_26134":108163,"_2648":47678},[],{"_3150":64590,"_27624":64551,"_19171":108249,"_5":13189,"_26134":108163,"_2648":108250},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3150":64591,"_27624":64551,"_19171":108252,"_5":13189,"_26134":108163,"_2648":47684},[],{"_3150":64592,"_27624":64551,"_19171":108254,"_5":13189,"_26134":108163,"_2648":108255},[],"Uno de los cuatro modos de autenticación.",{"_3150":64593,"_27624":64551,"_19171":108257,"_5":13189,"_26134":108163,"_2648":108258},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3150":64594,"_27624":64551,"_19171":108260,"_5":13189,"_26134":108166,"_2648":108261},[],"Los bloques son independientes:",{"_3150":64595,"_27624":64551,"_19171":108263,"_5":13189,"_26134":108166,"_2648":108264},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3150":64596,"_27624":64551,"_19171":108266,"_5":13189,"_26134":108166,"_2648":108267},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3150":64597,"_27624":64551,"_19171":108269,"_5":13189,"_26134":108166,"_2648":47702},[],{"_3150":64598,"_27624":64551,"_19171":108271,"_5":13189,"_26134":108166,"_2648":108272},[],"Control aplicado en la operación configurada",{"_3150":64599,"_27624":64551,"_19171":108274,"_5":13189,"_26134":108166,"_2648":47708},[],{"_3150":64600,"_27624":64551,"_19171":108276,"_5":13189,"_26134":108166,"_2648":108277},[],"Validación del certificado presentado.",{"_3150":64601,"_27624":64551,"_19171":108279,"_5":13189,"_26134":108166,"_2648":47714},[],{"_3150":64602,"_27624":64551,"_19171":108281,"_5":13189,"_26134":108166,"_2648":108282},[],"Autorización del webhook configurado.",{"_3150":64603,"_27624":64551,"_19171":108284,"_5":13189,"_26134":108166,"_2648":47720},[],{"_3150":64604,"_27624":64551,"_19171":108286,"_5":13189,"_26134":108166,"_2648":108287},[],"Validación del certificado y, después, aprobación del webhook.",{"_3150":64605,"_27624":64551,"_19171":108289,"_5":13189,"_26134":108166,"_2648":47726},[],{"_3150":64606,"_27624":64551,"_19171":108291,"_5":13189,"_26134":108166,"_2648":108292},[],"Sin autenticación del solicitante por el DMS.",{"_3150":64607,"_27624":64551,"_19171":108294,"_5":13189,"_26134":108166,"_2648":108295},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3150":64608,"_27624":64551,"_19171":108297,"_5":13189,"_26134":108166,"_2648":108298},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3150":64609,"_27624":64551,"_19171":108300,"_5":13189,"_26134":108166,"_2648":108301},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3150":64610,"_27624":64551,"_19171":108303,"_5":13189,"_26134":108166,"_2648":108304},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3150":64611,"_27624":64551,"_19171":108306,"_5":13189,"_26134":108170,"_2648":108307},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3150":64612,"_27624":64551,"_19171":108309,"_5":13189,"_26134":108170,"_2648":108310},[],"Campo de `external_webhook_settings`",{"_3150":64613,"_27624":64551,"_19171":108312,"_5":13189,"_26134":108170,"_2648":108230},[],{"_3150":64614,"_27624":64551,"_19171":108314,"_5":13189,"_26134":108170,"_2648":47752},[],{"_3150":64615,"_27624":64551,"_19171":108316,"_5":13189,"_26134":108170,"_2648":108317},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3150":64616,"_27624":64551,"_19171":108319,"_5":13189,"_26134":108170,"_2648":47758},[],{"_3150":64617,"_27624":64551,"_19171":108321,"_5":13189,"_26134":108170,"_2648":108322},[],"`POST` o `PUT`; `POST` por defecto.",{"_3150":64618,"_27624":64551,"_19171":108324,"_5":13189,"_26134":108170,"_2648":47764},[],{"_3150":64619,"_27624":64551,"_19171":108326,"_5":13189,"_26134":108170,"_2648":108327},[],"Etiqueta usada en los logs del servicio.",{"_3150":64620,"_27624":64551,"_19171":108329,"_5":13189,"_26134":108170,"_2648":47770},[],{"_3150":64621,"_27624":64551,"_19171":108331,"_5":13189,"_26134":108170,"_2648":108332},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3150":64622,"_27624":64551,"_19171":108334,"_5":13189,"_26134":108170,"_2648":47776},[],{"_3150":64623,"_27624":64551,"_19171":108336,"_5":13189,"_26134":108170,"_2648":108337},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3150":64624,"_27624":64551,"_19171":108339,"_5":13189,"_26134":108170,"_2648":47782},[],{"_3150":64625,"_27624":64551,"_19171":108341,"_5":13189,"_26134":108170,"_2648":108342},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3150":64626,"_27624":64551,"_19171":108344,"_5":13189,"_26134":108170,"_2648":47788},[],{"_3150":64627,"_27624":64551,"_19171":108346,"_5":13189,"_26134":108170,"_2648":108347},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3150":64628,"_27624":64551,"_19171":108349,"_5":13189,"_26134":108170,"_2648":47794},[],{"_3150":64629,"_27624":64551,"_19171":108351,"_5":13189,"_26134":108170,"_2648":108352},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3150":64630,"_27624":64551,"_19171":108354,"_5":13189,"_26134":108170,"_2648":47800},[],{"_3150":64631,"_27624":64551,"_19171":108356,"_5":13189,"_26134":108170,"_2648":108357},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3150":64632,"_27624":64551,"_19171":108359,"_5":13189,"_26134":108170,"_2648":108360},[],"Reglas de esa configuración:",{"_3150":64633,"_27624":64551,"_19171":108362,"_5":13189,"_26134":108170,"_2648":108363},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3150":64634,"_27624":64551,"_19171":108365,"_5":13189,"_26134":108170,"_2648":108366},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3150":64635,"_27624":64551,"_19171":108368,"_5":13189,"_26134":108170,"_2648":108369},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3150":64636,"_27624":64551,"_19171":108371,"_5":13189,"_26134":108170,"_2648":108372},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3150":64637,"_27624":64551,"_19171":108374,"_5":13189,"_26134":108170,"_2648":108375},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3150":64638,"_27624":64551,"_19171":108377,"_5":13189,"_26134":108170,"_2648":108378},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3150":64639,"_27624":64551,"_19171":108380,"_5":13189,"_26134":108170,"_2648":108381},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3150":64640,"_27624":64551,"_19171":108383,"_5":13189,"_26134":108170,"_2648":108384},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3150":64641,"_27624":64551,"_19171":108386,"_5":13189,"_26134":108170,"_2648":108387},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3150":64642,"_27624":64551,"_19171":108389,"_5":13189,"_26134":108174,"_2648":108390},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3150":64643,"_27624":64551,"_19171":108392,"_5":13189,"_26134":108178,"_2648":108393},[],"Campo de `settings.reenrollment_settings`",{"_3150":64644,"_27624":64551,"_19171":108395,"_5":13189,"_26134":108178,"_2648":108396},[],"Función",{"_3150":64645,"_27624":64551,"_19171":108398,"_5":13189,"_26134":108178,"_2648":47844},[],{"_3150":64646,"_27624":64551,"_19171":108400,"_5":13189,"_26134":108178,"_2648":108401},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3150":64647,"_27624":64551,"_19171":108403,"_5":13189,"_26134":108178,"_2648":47850},[],{"_3150":64648,"_27624":64551,"_19171":108405,"_5":13189,"_26134":108178,"_2648":108406},[],"Umbral operativo preventivo de monitorización.",{"_3150":64649,"_27624":64551,"_19171":108408,"_5":13189,"_26134":108178,"_2648":47856},[],{"_3150":64650,"_27624":64551,"_19171":108410,"_5":13189,"_26134":108178,"_2648":108411},[],"Umbral operativo crítico de monitorización.",{"_3150":64651,"_27624":64551,"_19171":108413,"_5":13189,"_26134":108178,"_2648":47862},[],{"_3150":64652,"_27624":64551,"_19171":108415,"_5":13189,"_26134":108178,"_2648":108416},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3150":64653,"_27624":64551,"_19171":108418,"_5":13189,"_26134":108178,"_2648":47868},[],{"_3150":64654,"_27624":64551,"_19171":108420,"_5":13189,"_26134":108178,"_2648":108421},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3150":64655,"_27624":64551,"_19171":108423,"_5":13189,"_26134":108178,"_2648":47874},[],{"_3150":64656,"_27624":64551,"_19171":108425,"_5":13189,"_26134":108178,"_2648":108426},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3150":64657,"_27624":64551,"_19171":108428,"_5":13189,"_26134":108178,"_2648":108429},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3150":64658,"_27624":64551,"_19171":108431,"_5":13189,"_26134":108182,"_2648":108432},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3150":64659,"_27624":64551,"_19171":108434,"_5":13189,"_26134":108185,"_2648":105927},[],{"_3150":64660,"_27624":64551,"_19171":108436,"_5":13189,"_26134":108185,"_2648":108437},[],"Qué publica",{"_3150":64661,"_27624":64551,"_19171":108439,"_5":13189,"_26134":108185,"_2648":47891},[],{"_3150":64662,"_27624":64551,"_19171":108441,"_5":13189,"_26134":108185,"_2648":108442},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3150":64663,"_27624":64551,"_19171":108444,"_5":13189,"_26134":108185,"_2648":47897},[],{"_3150":64664,"_27624":64551,"_19171":108446,"_5":13189,"_26134":108185,"_2648":108447},[],"Certificado de la CA emisora seleccionada.",{"_3150":64665,"_27624":64551,"_19171":108449,"_5":13189,"_26134":108185,"_2648":47903},[],{"_3150":64666,"_27624":64551,"_19171":108451,"_5":13189,"_26134":108185,"_2648":108452},[],"Certificados de las CAs elegidas explícitamente.",{"_3150":64667,"_27624":64551,"_19171":108454,"_5":13189,"_26134":108185,"_2648":108455},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3150":64668,"_27624":64551,"_19171":108457,"_5":13189,"_26134":108189,"_2648":108458},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3150":64669,"_27624":64551,"_19171":108460,"_5":13189,"_26134":108189,"_2648":108461},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3150":64670,"_27624":64551,"_19171":108463,"_5":13189,"_26134":108189,"_2648":108464},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3150":64671,"_27624":64551,"_19171":108466,"_5":13189,"_26134":108193,"_2648":108467},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3150":64672,"_27624":64672,"_5":13515,"_2648":108469,"_27967":108470,"_19171":108471,"_26134":64672},"Integra el cliente EST",[44933,106897,47290,107872,108047],[],{"_3150":64673,"_27624":64672,"_19171":108473,"_5":13189,"_26134":64672,"_2648":108474},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3150":64674,"_27624":64672,"_5":27964,"_19171":108476,"_26134":108477,"_2648":105563},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3150":64675,"_27624":64672,"_5":27964,"_19171":108479,"_26134":108480,"_2648":108481},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3150":64676,"_27624":64672,"_5":27964,"_19171":108483,"_26134":108484,"_2648":108485},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3150":64677,"_27624":64672,"_5":27964,"_19171":108487,"_26134":108488,"_2648":108489},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3150":64678,"_27624":64672,"_5":27964,"_19171":108491,"_26134":108492,"_2648":108493},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3150":64679,"_27624":64672,"_5":27964,"_19171":108495,"_26134":108496,"_2648":108497},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3150":64680,"_27624":64672,"_19171":108499,"_5":13189,"_26134":64672,"_2648":108500},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3150":64681,"_27624":64672,"_19171":108502,"_5":13189,"_26134":108477,"_2648":108503},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3150":64682,"_27624":64672,"_19171":108505,"_5":13189,"_26134":108477,"_2648":108506},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3150":64683,"_27624":64672,"_19171":108508,"_5":13189,"_26134":108477,"_2648":108509},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3150":64684,"_27624":64672,"_19171":108511,"_5":13189,"_26134":108480,"_2648":108512},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3150":64685,"_27624":64672,"_19171":108514,"_5":13189,"_26134":108480,"_2648":108515},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3150":64686,"_27624":64672,"_19171":108517,"_5":13189,"_26134":108484,"_2648":108518},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3150":64687,"_27624":64672,"_19171":108520,"_5":13189,"_26134":108484,"_2648":108521},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3150":64688,"_27624":64672,"_19171":108523,"_5":13189,"_26134":108488,"_2648":108524},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3150":64689,"_27624":64672,"_19171":108526,"_5":13189,"_26134":108488,"_2648":108527},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3150":64690,"_27624":64672,"_19171":108529,"_5":13189,"_26134":108492,"_2648":108530},[],"Para el caso de una raíz que emite directamente:",{"_3150":64691,"_27624":64672,"_19171":108532,"_5":13189,"_26134":108492,"_2648":108533},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3150":64692,"_27624":64672,"_19171":108535,"_5":13189,"_26134":108492,"_2648":108536},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3150":64693,"_27624":64672,"_19171":108538,"_5":13189,"_26134":108496,"_2648":108539},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3150":64694,"_27624":64694,"_5":13515,"_2648":108541,"_27967":108542,"_19171":108543,"_26134":64694},"Referencia EST",[44933,106897,47290,107872,108047],[],{"_3150":64695,"_27624":64694,"_19171":108545,"_5":13189,"_26134":64694,"_2648":108546},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3150":64696,"_27624":64694,"_5":27964,"_19171":108548,"_26134":108549,"_2648":108550},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3150":64697,"_27624":64694,"_5":27964,"_19171":108552,"_26134":108553,"_2648":20837},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3150":64698,"_27624":64694,"_5":27964,"_19171":108555,"_26134":108556,"_2648":23881},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3150":64699,"_27624":64694,"_5":27964,"_19171":108558,"_26134":108559,"_2648":23888},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3150":64700,"_27624":64694,"_5":27964,"_19171":108561,"_26134":108562,"_2648":23234},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3150":64701,"_27624":64694,"_5":27964,"_19171":108564,"_26134":108565,"_2648":108566},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3150":64702,"_27624":64694,"_5":27964,"_19171":108568,"_26134":108569,"_2648":108570},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3150":64703,"_27624":64694,"_5":27964,"_19171":108572,"_26134":108573,"_2648":108574},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3150":64704,"_27624":64694,"_19171":108576,"_5":13189,"_26134":64694,"_2648":108577},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3150":64705,"_27624":64694,"_19171":108579,"_5":13189,"_26134":108549,"_2648":108580},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3150":64706,"_27624":64694,"_19171":108582,"_5":13189,"_26134":108549,"_2648":106688},[],{"_3150":64707,"_27624":64694,"_19171":108584,"_5":13189,"_26134":108549,"_2648":108585},[],"Método",{"_3150":64708,"_27624":64694,"_19171":108587,"_5":13189,"_26134":108549,"_2648":108588},[],"Autenticación y condición",{"_3150":64709,"_27624":64694,"_19171":108590,"_5":13189,"_26134":108549,"_2648":48046},[],{"_3150":64710,"_27624":64694,"_19171":108592,"_5":13189,"_26134":108549,"_2648":48049},[],{"_3150":64711,"_27624":64694,"_19171":108594,"_5":13189,"_26134":108549,"_2648":108595},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3150":64712,"_27624":64694,"_19171":108597,"_5":13189,"_26134":108549,"_2648":48055},[],{"_3150":64713,"_27624":64694,"_19171":108599,"_5":13189,"_26134":108549,"_2648":48058},[],{"_3150":64714,"_27624":64694,"_19171":108601,"_5":13189,"_26134":108549,"_2648":108602},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3150":64715,"_27624":64694,"_19171":108604,"_5":13189,"_26134":108549,"_2648":48064},[],{"_3150":64716,"_27624":64694,"_19171":108606,"_5":13189,"_26134":108549,"_2648":48058},[],{"_3150":64717,"_27624":64694,"_19171":108608,"_5":13189,"_26134":108549,"_2648":108609},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3150":64718,"_27624":64694,"_19171":108611,"_5":13189,"_26134":108549,"_2648":48072},[],{"_3150":64719,"_27624":64694,"_19171":108613,"_5":13189,"_26134":108549,"_2648":48058},[],{"_3150":64720,"_27624":64694,"_19171":108615,"_5":13189,"_26134":108549,"_2648":108616},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3150":64721,"_27624":64694,"_19171":108618,"_5":13189,"_26134":108549,"_2648":108619},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3150":64722,"_27624":64694,"_19171":108621,"_5":13189,"_26134":108553,"_2648":108622},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3150":64723,"_27624":64694,"_19171":108624,"_5":13189,"_26134":108553,"_2648":108625},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3150":64724,"_27624":64694,"_19171":108627,"_5":13189,"_26134":108556,"_2648":108628},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3150":64725,"_27624":64694,"_19171":108630,"_5":13189,"_26134":108556,"_2648":108631},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3150":64726,"_27624":64694,"_19171":108633,"_5":13189,"_26134":108559,"_2648":108634},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3150":64727,"_27624":64694,"_19171":108636,"_5":13189,"_26134":108559,"_2648":108637},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3150":64728,"_27624":64694,"_19171":108639,"_5":13189,"_26134":108562,"_2648":108640},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3150":64729,"_27624":64694,"_19171":108642,"_5":13189,"_26134":108562,"_2648":108643},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3150":64730,"_27624":64694,"_19171":108645,"_5":13189,"_26134":108565,"_2648":108646},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3150":64731,"_27624":64694,"_19171":108648,"_5":13189,"_26134":108565,"_2648":108649},[],"Parte",{"_3150":64732,"_27624":64694,"_19171":108651,"_5":13189,"_26134":108565,"_2648":108652},[],"Contenido tras decodificar su Base64",{"_3150":64733,"_27624":64694,"_19171":108654,"_5":13189,"_26134":108565,"_2648":48116},[],{"_3150":64734,"_27624":64694,"_19171":108656,"_5":13189,"_26134":108565,"_2648":108657},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3150":64735,"_27624":64694,"_19171":108659,"_5":13189,"_26134":108565,"_2648":48122},[],{"_3150":64736,"_27624":64694,"_19171":108661,"_5":13189,"_26134":108565,"_2648":108662},[],"PKCS#7 DER con el certificado emitido.",{"_3150":64737,"_27624":64694,"_19171":108664,"_5":13189,"_26134":108565,"_2648":108665},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3150":64738,"_27624":64694,"_19171":108667,"_5":13189,"_26134":108569,"_2648":108668},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3150":64739,"_27624":64694,"_19171":108670,"_5":13189,"_26134":108569,"_2648":108671},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3150":64740,"_27624":64694,"_19171":108673,"_5":13189,"_26134":108569,"_2648":108674},[],"Convierte y comprueba el resultado:",{"_3150":64741,"_27624":64694,"_19171":108676,"_5":13189,"_26134":108569,"_2648":108677},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3150":64742,"_27624":64694,"_19171":108679,"_5":13189,"_26134":108573,"_2648":108680},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3150":64743,"_27624":64694,"_19171":108682,"_5":13189,"_26134":108573,"_2648":108683},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3150":64744,"_27624":64744,"_5":13515,"_2648":108047,"_27967":108685,"_19171":108686,"_26134":64744},[44933,106897,47290,107872,108047],[],{"_3150":64745,"_27624":64744,"_19171":108688,"_5":13189,"_26134":64744,"_2648":108689},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3150":64746,"_27624":64744,"_5":27964,"_19171":108691,"_26134":108692,"_2648":108693},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3150":64747,"_27624":64744,"_5":27964,"_19171":108695,"_26134":108696,"_2648":108697},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3150":64748,"_27624":64744,"_5":27964,"_19171":108699,"_26134":108700,"_2648":108701},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3150":64749,"_27624":64744,"_5":27964,"_19171":108703,"_26134":108704,"_2648":108705},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3150":64750,"_27624":64744,"_19171":108707,"_5":13189,"_26134":64744,"_2648":108708},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3150":64751,"_27624":64744,"_19171":108710,"_5":13189,"_26134":108692,"_2648":108711},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3150":64752,"_27624":64744,"_19171":108713,"_5":13189,"_26134":108692,"_2648":108714},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3150":64753,"_27624":64744,"_19171":108716,"_5":13189,"_26134":108692,"_2648":108717},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3150":64754,"_27624":64744,"_19171":108719,"_5":13189,"_26134":108692,"_2648":108720},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3150":64755,"_27624":64744,"_19171":108722,"_5":13189,"_26134":108692,"_2648":108723},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3150":64756,"_27624":64744,"_19171":108725,"_5":13189,"_26134":108692,"_2648":108726},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3150":64757,"_27624":64744,"_19171":108728,"_5":13189,"_26134":108696,"_2648":108729},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3150":64758,"_27624":64744,"_19171":108731,"_5":13189,"_26134":108696,"_2648":108732},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":64759,"_27624":64744,"_19171":108734,"_5":13189,"_26134":108696,"_2648":108735},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3150":64760,"_27624":64744,"_19171":108737,"_5":13189,"_26134":108696,"_2648":108738},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3150":64761,"_27624":64744,"_19171":108740,"_5":13189,"_26134":108700,"_2648":108741},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":64762,"_27624":64744,"_19171":108743,"_5":13189,"_26134":108700,"_2648":108744},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":64763,"_27624":64744,"_19171":108746,"_5":13189,"_26134":108700,"_2648":108747},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3150":64764,"_27624":64744,"_19171":108749,"_5":13189,"_26134":108700,"_2648":108750},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3150":64765,"_27624":64744,"_19171":108752,"_5":13189,"_26134":108704,"_2648":108753},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3150":64766,"_27624":64744,"_19171":108755,"_5":13189,"_26134":108704,"_2648":108756},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3150":64767,"_27624":64767,"_5":13515,"_2648":108758,"_27967":108759,"_19171":108760,"_26134":64767},"Estrategias de aprovisionamiento",[44933,106897,47290,107872,108047],[],{"_3150":64768,"_27624":64767,"_19171":108762,"_5":13189,"_26134":64767,"_2648":108763},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3150":64769,"_27624":64767,"_5":27964,"_19171":108765,"_26134":108766,"_2648":108767},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3150":64770,"_27624":64767,"_5":27964,"_19171":108769,"_26134":108770,"_2648":108771},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3150":64771,"_27624":64767,"_5":27964,"_19171":108773,"_26134":108774,"_2648":108775},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3150":64772,"_27624":64767,"_5":27964,"_19171":108777,"_26134":108778,"_2648":108779},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3150":64773,"_27624":64767,"_5":27964,"_19171":108781,"_26134":108782,"_2648":108783},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3150":64774,"_27624":64767,"_19171":108785,"_5":13189,"_26134":64767,"_2648":108786},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3150":64775,"_27624":64767,"_19171":108788,"_5":13189,"_26134":108766,"_2648":108789},[],"Recorrido",{"_3150":64776,"_27624":64767,"_19171":108791,"_5":13189,"_26134":108766,"_2648":108792},[],"Cuándo existe el dispositivo",{"_3150":64777,"_27624":64767,"_19171":108794,"_5":13189,"_26134":108766,"_2648":108795},[],"Qué compruebas",{"_3150":64778,"_27624":64767,"_19171":108797,"_5":13189,"_26134":108766,"_2648":108798},[],"Asignación manual",{"_3150":64779,"_27624":64767,"_19171":108800,"_5":13189,"_26134":108766,"_2648":108801},[],"El operador lo crea antes de asociar un certificado.",{"_3150":64780,"_27624":64767,"_19171":108803,"_5":13189,"_26134":108766,"_2648":108804},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3150":64781,"_27624":64767,"_19171":108806,"_5":13189,"_26134":108766,"_2648":108807},[],"EST con `JITP`",{"_3150":64782,"_27624":64767,"_19171":108809,"_5":13189,"_26134":108766,"_2648":108810},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3150":64783,"_27624":64767,"_19171":108812,"_5":13189,"_26134":108766,"_2648":108813},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3150":64784,"_27624":64767,"_19171":108815,"_5":13189,"_26134":108766,"_2648":108816},[],"EST con `PRE_REGISTRATION`",{"_3150":64785,"_27624":64767,"_19171":108818,"_5":13189,"_26134":108766,"_2648":108819},[],"Debe existir antes de `/simpleenroll`.",{"_3150":64786,"_27624":64767,"_19171":108821,"_5":13189,"_26134":108766,"_2648":108822},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3150":64787,"_27624":64767,"_19171":108824,"_5":13189,"_26134":108766,"_2648":108825},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3150":64788,"_27624":64767,"_19171":108827,"_5":13189,"_26134":108766,"_2648":108828},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3150":64789,"_27624":64767,"_19171":108830,"_5":13189,"_26134":108770,"_2648":108831},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3150":64790,"_27624":64767,"_19171":108833,"_5":13189,"_26134":108770,"_2648":108834},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3150":64791,"_27624":64767,"_19171":108836,"_5":13189,"_26134":108770,"_2648":108837},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3150":64792,"_27624":64767,"_19171":108839,"_5":13189,"_26134":108774,"_2648":108840},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3150":64793,"_27624":64767,"_19171":108842,"_5":13189,"_26134":108774,"_2648":108843},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3150":64794,"_27624":64767,"_19171":108845,"_5":13189,"_26134":108774,"_2648":108846},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3150":64795,"_27624":64767,"_19171":108848,"_5":13189,"_26134":108774,"_2648":108849},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3150":64796,"_27624":64767,"_19171":108851,"_5":13189,"_26134":108774,"_2648":108852},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3150":64797,"_27624":64767,"_19171":108854,"_5":13189,"_26134":108774,"_2648":108855},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3150":64798,"_27624":64767,"_19171":108857,"_5":13189,"_26134":108778,"_2648":105927},[],{"_3150":64799,"_27624":64767,"_19171":108859,"_5":13189,"_26134":108778,"_2648":108860},[],"Material que atraviesa EST",{"_3150":64800,"_27624":64767,"_19171":108862,"_5":13189,"_26134":108778,"_2648":108863},[],"Clave generada por el dispositivo",{"_3150":64801,"_27624":64767,"_19171":108865,"_5":13189,"_26134":108778,"_2648":108866},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3150":64802,"_27624":64767,"_19171":108868,"_5":13189,"_26134":108778,"_2648":108869},[],"Clave ya disponible en el dispositivo",{"_3150":64803,"_27624":64767,"_19171":108871,"_5":13189,"_26134":108778,"_2648":108872},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3150":64804,"_27624":64767,"_19171":108874,"_5":13189,"_26134":108778,"_2648":47609},[],{"_3150":64805,"_27624":64767,"_19171":108876,"_5":13189,"_26134":108778,"_2648":108877},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3150":64806,"_27624":64767,"_19171":108879,"_5":13189,"_26134":108778,"_2648":108880},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3150":64807,"_27624":64767,"_19171":108882,"_5":13189,"_26134":108782,"_2648":108883},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3150":64808,"_27624":64808,"_5":13515,"_2648":108885,"_27967":108886,"_19171":108887,"_26134":64808},"Renovación y recuperación",[44933,106897,47290,107872,108047],[],{"_3150":64809,"_27624":64808,"_19171":108889,"_5":13189,"_26134":64808,"_2648":108890},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3150":64810,"_27624":64808,"_5":27964,"_19171":108892,"_26134":108893,"_2648":108894},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3150":64811,"_27624":64808,"_5":27964,"_19171":108896,"_26134":108897,"_2648":108898},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3150":64812,"_27624":64808,"_5":27964,"_19171":108900,"_26134":108901,"_2648":108902},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3150":64813,"_27624":64808,"_5":27964,"_19171":108904,"_26134":108905,"_2648":108906},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3150":64814,"_27624":64808,"_5":27964,"_19171":108908,"_26134":108909,"_2648":108910},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3150":64815,"_27624":64808,"_19171":108912,"_5":13189,"_26134":64808,"_2648":108913},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3150":64816,"_27624":64808,"_19171":108915,"_5":13189,"_26134":108893,"_2648":108916},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3150":64817,"_27624":64808,"_19171":108918,"_5":13189,"_26134":108893,"_2648":108919},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3150":64818,"_27624":64808,"_19171":108921,"_5":13189,"_26134":108893,"_2648":108922},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3150":64819,"_27624":64808,"_19171":108924,"_5":13189,"_26134":108893,"_2648":108925},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3150":64820,"_27624":64808,"_19171":108927,"_5":13189,"_26134":108897,"_2648":108928},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3150":64821,"_27624":64808,"_19171":108930,"_5":13189,"_26134":108897,"_2648":108931},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3150":64822,"_27624":64808,"_19171":108933,"_5":13189,"_26134":108901,"_2648":108934},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3150":64823,"_27624":64808,"_19171":108936,"_5":13189,"_26134":108901,"_2648":108937},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3150":64824,"_27624":64808,"_19171":108939,"_5":13189,"_26134":108901,"_2648":108940},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3150":64825,"_27624":64808,"_19171":108942,"_5":13189,"_26134":108905,"_2648":108943},[],"Situación",{"_3150":64826,"_27624":64808,"_19171":108945,"_5":13189,"_26134":108905,"_2648":108946},[],"Procedimiento",{"_3150":64827,"_27624":64808,"_19171":108948,"_5":13189,"_26134":108905,"_2648":108949},[],"Certificado vigente, fuera de ventana",{"_3150":64828,"_27624":64808,"_19171":108951,"_5":13189,"_26134":108905,"_2648":108952},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3150":64829,"_27624":64808,"_19171":108954,"_5":13189,"_26134":108905,"_2648":108955},[],"Certificado vencido, clave disponible",{"_3150":64830,"_27624":64808,"_19171":108957,"_5":13189,"_26134":108905,"_2648":108958},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3150":64831,"_27624":64808,"_19171":108960,"_5":13189,"_26134":108905,"_2648":108961},[],"Renovación por webhook o `NO_AUTH`",{"_3150":64832,"_27624":64808,"_19171":108963,"_5":13189,"_26134":108905,"_2648":108964},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3150":64833,"_27624":64808,"_19171":108966,"_5":13189,"_26134":108905,"_2648":108967},[],"Clave perdida o inaccesible",{"_3150":64834,"_27624":64808,"_19171":108969,"_5":13189,"_26134":108905,"_2648":108970},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3150":64835,"_27624":64808,"_19171":108972,"_5":13189,"_26134":108905,"_2648":108973},[],"Identidad actual revocada",{"_3150":64836,"_27624":64808,"_19171":108975,"_5":13189,"_26134":108905,"_2648":108976},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3150":64837,"_27624":64808,"_19171":108978,"_5":13189,"_26134":108905,"_2648":108979},[],"Dispositivo sin identidad",{"_3150":64838,"_27624":64808,"_19171":108981,"_5":13189,"_26134":108905,"_2648":108982},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3150":64839,"_27624":64808,"_19171":108984,"_5":13189,"_26134":108905,"_2648":108985},[],"Dispositivo retirado",{"_3150":64840,"_27624":64808,"_19171":108987,"_5":13189,"_26134":108905,"_2648":108988},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3150":64841,"_27624":64808,"_19171":108990,"_5":13189,"_26134":108905,"_2648":108991},[],"Timeout, HTTP 500 o fallo de instalación",{"_3150":64842,"_27624":64808,"_19171":108993,"_5":13189,"_26134":108905,"_2648":108994},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3150":64843,"_27624":64808,"_19171":108996,"_5":13189,"_26134":108909,"_2648":108997},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3150":64844,"_27624":64808,"_19171":108999,"_5":13189,"_26134":108909,"_2648":109000},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3150":64845,"_27624":64845,"_5":13515,"_2648":109002,"_27967":109003,"_19171":109004,"_26134":64845},"Diagnóstico de enrolamiento",[44933,106897,47290,107872,108047],[],{"_3150":64846,"_27624":64845,"_19171":109006,"_5":13189,"_26134":64845,"_2648":109007},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3150":64847,"_27624":64845,"_5":27964,"_19171":109009,"_26134":109010,"_2648":109011},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3150":64848,"_27624":64845,"_5":27964,"_19171":109013,"_26134":109014,"_2648":109015},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3150":64849,"_27624":64845,"_5":27964,"_19171":109017,"_26134":109018,"_2648":108574},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3150":64850,"_27624":64845,"_5":27964,"_19171":109020,"_26134":109021,"_2648":109022},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3150":64851,"_27624":64845,"_19171":109024,"_5":13189,"_26134":64845,"_2648":109025},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3150":64852,"_27624":64845,"_19171":109027,"_5":13189,"_26134":109014,"_2648":109028},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3150":64853,"_27624":64845,"_19171":109030,"_5":13189,"_26134":109014,"_2648":109031},[],"Síntoma o mensaje",{"_3150":64854,"_27624":64845,"_19171":109033,"_5":13189,"_26134":109014,"_2648":109034},[],"Qué revisar",{"_3150":64855,"_27624":64845,"_19171":109036,"_5":13189,"_26134":109014,"_2648":109037},[],"curl rechaza TLS, nombre o emisor",{"_3150":64856,"_27624":64845,"_19171":109039,"_5":13189,"_26134":109014,"_2648":109040},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3150":64857,"_27624":64845,"_19171":109042,"_5":13189,"_26134":109014,"_2648":109043},[],"404 o APS ausente",{"_3150":64858,"_27624":64845,"_19171":109045,"_5":13189,"_26134":109014,"_2648":109046},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3150":64859,"_27624":64845,"_19171":109048,"_5":13189,"_26134":109014,"_2648":109049},[],"400, error de CSR o formato",{"_3150":64860,"_27624":64845,"_19171":109051,"_5":13189,"_26134":109014,"_2648":109052},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3150":64861,"_27624":64845,"_19171":109054,"_5":13189,"_26134":109014,"_2648":109055},[],"Credencial ausente o certificado no válido",{"_3150":64862,"_27624":64845,"_19171":109057,"_5":13189,"_26134":109014,"_2648":109058},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3150":64863,"_27624":64845,"_19171":109060,"_5":13189,"_26134":109014,"_2648":109061},[],"Webhook deniega, expira o responde sin autorización",{"_3150":64864,"_27624":64845,"_19171":109063,"_5":13189,"_26134":109014,"_2648":109064},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3150":64865,"_27624":64845,"_19171":109066,"_5":13189,"_26134":109014,"_2648":48529},[],{"_3150":64866,"_27624":64845,"_19171":109068,"_5":13189,"_26134":109014,"_2648":109069},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3150":64867,"_27624":64845,"_19171":109071,"_5":13189,"_26134":109014,"_2648":48535},[],{"_3150":64868,"_27624":64845,"_19171":109073,"_5":13189,"_26134":109014,"_2648":109074},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3150":64869,"_27624":64845,"_19171":109076,"_5":13189,"_26134":109014,"_2648":48541},[],{"_3150":64870,"_27624":64845,"_19171":109078,"_5":13189,"_26134":109014,"_2648":109079},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3150":64871,"_27624":64845,"_19171":109081,"_5":13189,"_26134":109014,"_2648":48547},[],{"_3150":64872,"_27624":64845,"_19171":109083,"_5":13189,"_26134":109014,"_2648":109084},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3150":64873,"_27624":64845,"_19171":109086,"_5":13189,"_26134":109014,"_2648":48553},[],{"_3150":64874,"_27624":64845,"_19171":109088,"_5":13189,"_26134":109014,"_2648":109089},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3150":64875,"_27624":64845,"_19171":109091,"_5":13189,"_26134":109014,"_2648":109092},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3150":64876,"_27624":64845,"_19171":109094,"_5":13189,"_26134":109014,"_2648":109095},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3150":64877,"_27624":64845,"_19171":109097,"_5":13189,"_26134":109014,"_2648":109098},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3150":64878,"_27624":64845,"_19171":109100,"_5":13189,"_26134":109014,"_2648":109101},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3150":64879,"_27624":64845,"_19171":109103,"_5":13189,"_26134":109014,"_2648":48571},[],{"_3150":64880,"_27624":64845,"_19171":109105,"_5":13189,"_26134":109014,"_2648":109106},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3150":64881,"_27624":64845,"_19171":109108,"_5":13189,"_26134":109014,"_2648":48577},[],{"_3150":64882,"_27624":64845,"_19171":109110,"_5":13189,"_26134":109014,"_2648":109111},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3150":64883,"_27624":64845,"_19171":109113,"_5":13189,"_26134":109014,"_2648":109114},[],"DMS propietario distinto",{"_3150":64884,"_27624":64845,"_19171":109116,"_5":13189,"_26134":109014,"_2648":109117},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3150":64885,"_27624":64845,"_19171":109119,"_5":13189,"_26134":109014,"_2648":48589},[],{"_3150":64886,"_27624":64845,"_19171":109121,"_5":13189,"_26134":109014,"_2648":109122},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3150":64887,"_27624":64845,"_19171":109124,"_5":13189,"_26134":109014,"_2648":48595},[],{"_3150":64888,"_27624":64845,"_19171":109126,"_5":13189,"_26134":109014,"_2648":109127},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3150":64889,"_27624":64845,"_19171":109129,"_5":13189,"_26134":109014,"_2648":109130},[],"Certificado actual revocado",{"_3150":64890,"_27624":64845,"_19171":109132,"_5":13189,"_26134":109014,"_2648":109133},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3150":64891,"_27624":64845,"_19171":109135,"_5":13189,"_26134":109014,"_2648":109136},[],"Error de CA, perfil o firma",{"_3150":64892,"_27624":64845,"_19171":109138,"_5":13189,"_26134":109014,"_2648":109139},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3150":64893,"_27624":64845,"_19171":109141,"_5":13189,"_26134":109014,"_2648":109142},[],"HTTP 200 sin conexión del dispositivo",{"_3150":64894,"_27624":64845,"_19171":109144,"_5":13189,"_26134":109014,"_2648":109145},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3150":64895,"_27624":64845,"_19171":109147,"_5":13189,"_26134":109014,"_2648":109148},[],"Timeout o error después de emitir",{"_3150":64896,"_27624":64845,"_19171":109150,"_5":13189,"_26134":109014,"_2648":109151},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3150":64897,"_27624":64845,"_19171":109153,"_5":13189,"_26134":109018,"_2648":109154},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3150":64898,"_27624":64845,"_19171":109156,"_5":13189,"_26134":109018,"_2648":109157},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3150":64899,"_27624":64845,"_19171":109159,"_5":13189,"_26134":109021,"_2648":109160},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3150":64900,"_27624":64845,"_19171":109162,"_5":13189,"_26134":109021,"_2648":109163},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3150":64901,"_27624":64845,"_19171":109165,"_5":13189,"_26134":109021,"_2648":109166},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3150":64902,"_27624":64845,"_19171":109168,"_5":13189,"_26134":109021,"_2648":109169},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3150":64903,"_27624":64845,"_19171":109171,"_5":13189,"_26134":109021,"_2648":109172},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3150":64904,"_27624":64845,"_19171":109174,"_5":13189,"_26134":109021,"_2648":109175},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3150":64905,"_27624":64845,"_19171":109177,"_5":13189,"_26134":109021,"_2648":109178},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3150":64906,"_27624":64906,"_5":13515,"_2648":109180,"_27967":109181,"_19171":109182,"_26134":64906},"Distribución y actualización de confianza",[44933,106897,47290,107872,108047],[],{"_3150":64907,"_27624":64906,"_19171":109184,"_5":13189,"_26134":64906,"_2648":109185},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3150":64908,"_27624":64906,"_5":27964,"_19171":109187,"_26134":109188,"_2648":109189},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3150":64909,"_27624":64906,"_5":27964,"_19171":109191,"_26134":109192,"_2648":109193},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3150":64910,"_27624":64906,"_5":27964,"_19171":109195,"_26134":109196,"_2648":109197},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3150":64911,"_27624":64906,"_5":27964,"_19171":109199,"_26134":109200,"_2648":109201},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3150":64912,"_27624":64906,"_5":27964,"_19171":109203,"_26134":109204,"_2648":109205},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3150":64913,"_27624":64906,"_19171":109207,"_5":13189,"_26134":64906,"_2648":109208},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3150":64914,"_27624":64906,"_19171":109210,"_5":13189,"_26134":109188,"_2648":109211},[],"Relación",{"_3150":64915,"_27624":64906,"_19171":109213,"_5":13189,"_26134":109188,"_2648":109214},[],"Material que prepara el responsable",{"_3150":64916,"_27624":64906,"_19171":109216,"_5":13189,"_26134":109188,"_2648":109217},[],"Dispositivo → servidor EST",{"_3150":64917,"_27624":64906,"_19171":109219,"_5":13189,"_26134":109188,"_2648":109220},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3150":64918,"_27624":64906,"_19171":109222,"_5":13189,"_26134":109188,"_2648":109223},[],"DMS → solicitante",{"_3150":64919,"_27624":64906,"_19171":109225,"_5":13189,"_26134":109188,"_2648":109226},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3150":64920,"_27624":64906,"_19171":109228,"_5":13189,"_26134":109188,"_2648":109229},[],"Consumidor → dispositivo",{"_3150":64921,"_27624":64906,"_19171":109231,"_5":13189,"_26134":109188,"_2648":109232},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3150":64922,"_27624":64906,"_19171":109234,"_5":13189,"_26134":109188,"_2648":109235},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3150":64923,"_27624":64906,"_19171":109237,"_5":13189,"_26134":109192,"_2648":109238},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3150":64924,"_27624":64906,"_19171":109240,"_5":13189,"_26134":109192,"_2648":109241},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3150":64925,"_27624":64906,"_19171":109243,"_5":13189,"_26134":109196,"_2648":109244},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3150":64926,"_27624":64906,"_19171":109246,"_5":13189,"_26134":109196,"_2648":109247},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3150":64927,"_27624":64906,"_19171":109249,"_5":13189,"_26134":109196,"_2648":109250},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3150":64928,"_27624":64906,"_19171":109252,"_5":13189,"_26134":109196,"_2648":109253},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3150":64929,"_27624":64906,"_19171":109255,"_5":13189,"_26134":109196,"_2648":109256},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3150":64930,"_27624":64906,"_19171":109258,"_5":13189,"_26134":109196,"_2648":109259},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3150":64931,"_27624":64906,"_19171":109261,"_5":13189,"_26134":109200,"_2648":109262},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3150":64932,"_27624":64906,"_19171":109264,"_5":13189,"_26134":109200,"_2648":109265},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3150":64933,"_27624":64906,"_19171":109267,"_5":13189,"_26134":109200,"_2648":109268},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3150":64934,"_27624":64906,"_19171":109270,"_5":13189,"_26134":109204,"_2648":109271},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3150":64935,"_27624":64935,"_5":13515,"_2648":48744,"_27967":109273,"_19171":109275,"_26134":64935},[44933,106897,47290,107872,109274],"Integraciones",[],{"_3150":64936,"_27624":64935,"_19171":109277,"_5":13189,"_26134":64935,"_2648":109278},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3150":64937,"_27624":64935,"_5":27964,"_19171":109280,"_26134":109281,"_2648":109282},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3150":64938,"_27624":64935,"_5":27964,"_19171":109284,"_26134":109285,"_2648":109286},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3150":64939,"_27624":64935,"_5":27964,"_19171":109288,"_26134":109289,"_2648":109290},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3150":64940,"_27624":64935,"_5":27964,"_19171":109292,"_26134":109293,"_2648":109294},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3150":64941,"_27624":64935,"_5":27964,"_19171":109296,"_26134":109297,"_2648":109298},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3150":64942,"_27624":64935,"_5":27964,"_19171":109300,"_26134":109301,"_2648":109302},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3150":64943,"_27624":64935,"_5":27964,"_19171":109304,"_26134":109305,"_2648":48778},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3150":64944,"_27624":64935,"_5":27964,"_19171":109307,"_26134":109308,"_2648":48782},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3150":64945,"_27624":64935,"_5":27964,"_19171":109310,"_26134":109311,"_2648":109312},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3150":64946,"_27624":64935,"_5":27964,"_19171":109314,"_26134":109315,"_2648":109316},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3150":64947,"_27624":64935,"_5":27964,"_19171":109318,"_26134":109319,"_2648":109320},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3150":64948,"_27624":64935,"_5":27964,"_19171":109322,"_26134":109323,"_2648":109324},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3150":64949,"_27624":64935,"_5":27964,"_19171":109326,"_26134":109327,"_2648":109328},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3150":64950,"_27624":64935,"_5":27964,"_19171":109330,"_26134":109331,"_2648":109332},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3150":64951,"_27624":64935,"_5":27964,"_19171":109334,"_26134":109335,"_2648":109336},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3150":64952,"_27624":64935,"_5":27964,"_19171":109338,"_26134":109339,"_2648":109340},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3150":64953,"_27624":64935,"_5":27964,"_19171":109342,"_26134":109343,"_2648":109344},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3150":64954,"_27624":64935,"_5":27964,"_19171":109346,"_26134":109347,"_2648":109348},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3150":64955,"_27624":64935,"_5":27964,"_19171":109350,"_26134":109351,"_2648":109352},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3150":64956,"_27624":64935,"_5":27964,"_19171":109354,"_26134":109355,"_2648":109356},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3150":64957,"_27624":64935,"_19171":109358,"_5":13189,"_26134":64935,"_2648":109359},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3150":64958,"_27624":64935,"_19171":109361,"_5":13189,"_26134":64935,"_2648":109362},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3150":64959,"_27624":64935,"_19171":109364,"_5":13189,"_26134":64935,"_2648":109365},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3150":64960,"_27624":64935,"_19171":109367,"_5":13189,"_26134":109281,"_2648":109368},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3150":64961,"_27624":64935,"_19171":109370,"_5":13189,"_26134":109281,"_2648":109371},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3150":64962,"_27624":64935,"_19171":109373,"_5":13189,"_26134":109281,"_2648":109374},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3150":64963,"_27624":64935,"_19171":109376,"_5":13189,"_26134":109281,"_2648":109377},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3150":64964,"_27624":64935,"_19171":109379,"_5":13189,"_26134":109285,"_2648":109380},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3150":64965,"_27624":64935,"_19171":109382,"_5":13189,"_26134":109289,"_2648":109383},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3150":64966,"_27624":64935,"_19171":109385,"_5":13189,"_26134":109289,"_2648":109386},[],"Acción IAM",{"_3150":64967,"_27624":64935,"_19171":109388,"_5":13189,"_26134":109289,"_2648":105933},[],{"_3150":64968,"_27624":64935,"_19171":109390,"_5":13189,"_26134":109289,"_2648":48865},[],{"_3150":64969,"_27624":64935,"_19171":109392,"_5":13189,"_26134":109289,"_2648":109393},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3150":64970,"_27624":64935,"_19171":109395,"_5":13189,"_26134":109289,"_2648":48871},[],{"_3150":64971,"_27624":64935,"_19171":109397,"_5":13189,"_26134":109289,"_2648":109398},[],"Registrar la CA en AWS IoT",{"_3150":64972,"_27624":64935,"_19171":109400,"_5":13189,"_26134":109289,"_2648":48877},[],{"_3150":64973,"_27624":64935,"_19171":109402,"_5":13189,"_26134":109289,"_2648":109403},[],"Consultar el estado del registro de la CA",{"_3150":64974,"_27624":64935,"_19171":109405,"_5":13189,"_26134":109289,"_2648":48883},[],{"_3150":64975,"_27624":64935,"_19171":109407,"_5":13189,"_26134":109289,"_2648":109408},[],"Crear o actualizar Things en IoT Core",{"_3150":64976,"_27624":64935,"_19171":109410,"_5":13189,"_26134":109289,"_2648":48889},[],{"_3150":64977,"_27624":64935,"_19171":109412,"_5":13189,"_26134":109289,"_2648":109413},[],"Aprovisionar Things mediante plantilla",{"_3150":64978,"_27624":64935,"_19171":109415,"_5":13189,"_26134":109289,"_2648":48895},[],{"_3150":64979,"_27624":64935,"_19171":109417,"_5":13189,"_26134":109289,"_2648":109418},[],"Registrar certificados de dispositivo",{"_3150":64980,"_27624":64935,"_19171":109420,"_5":13189,"_26134":109289,"_2648":48901},[],{"_3150":64981,"_27624":64935,"_19171":109422,"_5":13189,"_26134":109289,"_2648":109423},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3150":64982,"_27624":64935,"_19171":109425,"_5":13189,"_26134":109289,"_2648":48907},[],{"_3150":64983,"_27624":64935,"_19171":109427,"_5":13189,"_26134":109289,"_2648":109428},[],"Crear y adjuntar políticas IoT",{"_3150":64984,"_27624":64935,"_19171":109430,"_5":13189,"_26134":109289,"_2648":48913},[],{"_3150":64985,"_27624":64935,"_19171":109432,"_5":13189,"_26134":109289,"_2648":109433},[],"Gestionar grupos de Things",{"_3150":64986,"_27624":64935,"_19171":109435,"_5":13189,"_26134":109289,"_2648":48919},[],{"_3150":64987,"_27624":64935,"_19171":109437,"_5":13189,"_26134":109289,"_2648":109438},[],"Crear plantillas JITP",{"_3150":64988,"_27624":64935,"_19171":109440,"_5":13189,"_26134":109289,"_2648":48925},[],{"_3150":64989,"_27624":64935,"_19171":109442,"_5":13189,"_26134":109289,"_2648":109443},[],"Leer y escribir el Device Shadow",{"_3150":64990,"_27624":64935,"_19171":109445,"_5":13189,"_26134":109289,"_2648":109446},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3150":64991,"_27624":64935,"_19171":109448,"_5":13189,"_26134":109293,"_2648":109449},[],"Parámetro",{"_3150":64992,"_27624":64935,"_19171":109451,"_5":13189,"_26134":109293,"_2648":109452},[],"Tipo",{"_3150":64993,"_27624":64935,"_19171":109454,"_5":13189,"_26134":109293,"_2648":109455},[],"Requerido",{"_3150":64994,"_27624":64935,"_19171":109457,"_5":13189,"_26134":109293,"_2648":109458},[],"Descripción",{"_3150":64995,"_27624":64935,"_19171":109460,"_5":13189,"_26134":109293,"_2648":48946},[],{"_3150":64996,"_27624":64935,"_19171":109462,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":64997,"_27624":64935,"_19171":109464,"_5":13189,"_26134":109293,"_2648":109465},[],"Sí",{"_3150":64998,"_27624":64935,"_19171":109467,"_5":13189,"_26134":109293,"_2648":109468},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3150":64999,"_27624":64935,"_19171":109470,"_5":13189,"_26134":109293,"_2648":48957},[],{"_3150":65000,"_27624":64935,"_19171":109472,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":65001,"_27624":64935,"_19171":109474,"_5":13189,"_26134":109293,"_2648":109465},[],{"_3150":65002,"_27624":64935,"_19171":109476,"_5":13189,"_26134":109293,"_2648":109477},[],"Región AWS donde opera el conector.",{"_3150":65003,"_27624":64935,"_19171":109479,"_5":13189,"_26134":109293,"_2648":48967},[],{"_3150":65004,"_27624":64935,"_19171":109481,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":65005,"_27624":64935,"_19171":109483,"_5":13189,"_26134":109293,"_2648":109465},[],{"_3150":65006,"_27624":64935,"_19171":109485,"_5":13189,"_26134":109293,"_2648":109486},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3150":65007,"_27624":64935,"_19171":109488,"_5":13189,"_26134":109293,"_2648":48977},[],{"_3150":65008,"_27624":64935,"_19171":109490,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":65009,"_27624":64935,"_19171":109492,"_5":13189,"_26134":109293,"_2648":109493},[],"Solo con `auth_method=static`",{"_3150":65010,"_27624":64935,"_19171":109495,"_5":13189,"_26134":109293,"_2648":109496},[],"Clave de acceso AWS.",{"_3150":65011,"_27624":64935,"_19171":109498,"_5":13189,"_26134":109293,"_2648":48988},[],{"_3150":65012,"_27624":64935,"_19171":109500,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":65013,"_27624":64935,"_19171":109502,"_5":13189,"_26134":109293,"_2648":109493},[],{"_3150":65014,"_27624":64935,"_19171":109504,"_5":13189,"_26134":109293,"_2648":109505},[],"Clave secreta AWS.",{"_3150":65015,"_27624":64935,"_19171":109507,"_5":13189,"_26134":109293,"_2648":48998},[],{"_3150":65016,"_27624":64935,"_19171":109509,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":65017,"_27624":64935,"_19171":109511,"_5":13189,"_26134":109293,"_2648":49003},[],{"_3150":65018,"_27624":64935,"_19171":109513,"_5":13189,"_26134":109293,"_2648":109514},[],"Token de sesión (con `auth_method=static`).",{"_3150":65019,"_27624":64935,"_19171":109516,"_5":13189,"_26134":109293,"_2648":49009},[],{"_3150":65020,"_27624":64935,"_19171":109518,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":65021,"_27624":64935,"_19171":109520,"_5":13189,"_26134":109293,"_2648":109521},[],"Solo con `auth_method=role`",{"_3150":65022,"_27624":64935,"_19171":109523,"_5":13189,"_26134":109293,"_2648":109524},[],"ARN del rol a asumir.",{"_3150":65023,"_27624":64935,"_19171":109526,"_5":13189,"_26134":109293,"_2648":49020},[],{"_3150":65024,"_27624":64935,"_19171":109528,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":65025,"_27624":64935,"_19171":109530,"_5":13189,"_26134":109293,"_2648":49003},[],{"_3150":65026,"_27624":64935,"_19171":109532,"_5":13189,"_26134":109293,"_2648":109533},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3150":65027,"_27624":64935,"_19171":109535,"_5":13189,"_26134":109293,"_2648":49030},[],{"_3150":65028,"_27624":64935,"_19171":109537,"_5":13189,"_26134":109293,"_2648":16169},[],{"_3150":65029,"_27624":64935,"_19171":109539,"_5":13189,"_26134":109293,"_2648":109465},[],{"_3150":65030,"_27624":64935,"_19171":109541,"_5":13189,"_26134":109293,"_2648":109542},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3150":65031,"_27624":64935,"_19171":109544,"_5":13189,"_26134":109293,"_2648":49040},[],{"_3150":65032,"_27624":64935,"_19171":109546,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":65033,"_27624":64935,"_19171":109548,"_5":13189,"_26134":109293,"_2648":109465},[],{"_3150":65034,"_27624":64935,"_19171":109550,"_5":13189,"_26134":109293,"_2648":109551},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3150":65035,"_27624":64935,"_19171":109553,"_5":13189,"_26134":109293,"_2648":49050},[],{"_3150":65036,"_27624":64935,"_19171":109555,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":65037,"_27624":64935,"_19171":109557,"_5":13189,"_26134":109293,"_2648":109465},[],{"_3150":65038,"_27624":64935,"_19171":109559,"_5":13189,"_26134":109293,"_2648":109560},[],"URL HTTP del Device Manager de Lamassu.",{"_3150":65039,"_27624":64935,"_19171":109562,"_5":13189,"_26134":109293,"_2648":49060},[],{"_3150":65040,"_27624":64935,"_19171":109564,"_5":13189,"_26134":109293,"_2648":22920},[],{"_3150":65041,"_27624":64935,"_19171":109566,"_5":13189,"_26134":109293,"_2648":109465},[],{"_3150":65042,"_27624":64935,"_19171":109568,"_5":13189,"_26134":109293,"_2648":109569},[],"URL HTTP del servicio de CA de Lamassu.",{"_3150":65043,"_27624":64935,"_19171":109571,"_5":13189,"_26134":109297,"_2648":109572},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3150":65044,"_27624":64935,"_19171":109574,"_5":13189,"_26134":109301,"_2648":109575},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3150":65045,"_27624":64935,"_19171":109577,"_5":13189,"_26134":109301,"_2648":109578},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3150":65046,"_27624":64935,"_19171":109580,"_5":13189,"_26134":109305,"_2648":109581},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3150":65047,"_27624":64935,"_19171":109583,"_5":13189,"_26134":109305,"_2648":109584},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3150":65048,"_27624":64935,"_19171":109586,"_5":13189,"_26134":109305,"_2648":109587},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3150":65049,"_27624":64935,"_19171":109589,"_5":13189,"_26134":109305,"_2648":109590},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3150":65050,"_27624":64935,"_19171":109592,"_5":13189,"_26134":109305,"_2648":109593},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3150":65051,"_27624":64935,"_19171":109595,"_5":13189,"_26134":109305,"_2648":109596},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3150":65052,"_27624":64935,"_19171":109598,"_5":13189,"_26134":109308,"_2648":109599},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3150":65053,"_27624":64935,"_19171":109601,"_5":13189,"_26134":109311,"_2648":109602},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3150":65054,"_27624":64935,"_19171":109604,"_5":13189,"_26134":109311,"_2648":109605},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3150":65055,"_27624":64935,"_19171":109607,"_5":13189,"_26134":109315,"_2648":109608},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3150":65056,"_27624":64935,"_19171":109610,"_5":13189,"_26134":109319,"_2648":109611},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3150":65057,"_27624":64935,"_19171":109613,"_5":13189,"_26134":109319,"_2648":109614},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3150":65058,"_27624":64935,"_19171":109616,"_5":13189,"_26134":109319,"_2648":109617},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3150":65059,"_27624":64935,"_19171":109619,"_5":13189,"_26134":109319,"_2648":109620},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3150":65060,"_27624":64935,"_19171":109622,"_5":13189,"_26134":109319,"_2648":109623},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3150":65061,"_27624":64935,"_19171":109625,"_5":13189,"_26134":109319,"_2648":109626},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3150":65062,"_27624":64935,"_19171":109628,"_5":13189,"_26134":109323,"_2648":109629},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3150":65063,"_27624":64935,"_19171":109631,"_5":13189,"_26134":109323,"_2648":109632},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3150":65064,"_27624":64935,"_19171":109634,"_5":13189,"_26134":109323,"_2648":109635},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3150":65065,"_27624":64935,"_19171":109637,"_5":13189,"_26134":109327,"_2648":109638},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3150":65066,"_27624":64935,"_19171":109640,"_5":13189,"_26134":109327,"_2648":109641},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3150":65067,"_27624":64935,"_19171":109643,"_5":13189,"_26134":109327,"_2648":109644},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3150":65068,"_27624":64935,"_19171":109646,"_5":13189,"_26134":109331,"_2648":109647},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3150":65069,"_27624":64935,"_19171":109649,"_5":13189,"_26134":109331,"_2648":109650},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3150":65070,"_27624":64935,"_19171":109652,"_5":13189,"_26134":109331,"_2648":109653},[],"Para que el flujo JITP funcione correctamente:",{"_3150":65071,"_27624":64935,"_19171":109655,"_5":13189,"_26134":109331,"_2648":109656},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3150":65072,"_27624":64935,"_19171":109658,"_5":13189,"_26134":109331,"_2648":109659},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3150":65073,"_27624":64935,"_19171":109661,"_5":13189,"_26134":109331,"_2648":109662},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3150":65074,"_27624":64935,"_19171":109664,"_5":13189,"_26134":109331,"_2648":109665},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3150":65075,"_27624":64935,"_19171":109667,"_5":13189,"_26134":109335,"_2648":109668},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3150":65076,"_27624":64935,"_19171":109670,"_5":13189,"_26134":109335,"_2648":109671},[],"Estado en Lamassu",{"_3150":65077,"_27624":64935,"_19171":109673,"_5":13189,"_26134":109335,"_2648":109674},[],"Razón de revocación",{"_3150":65078,"_27624":64935,"_19171":109676,"_5":13189,"_26134":109335,"_2648":109677},[],"Estado en AWS IoT Core",{"_3150":65079,"_27624":64935,"_19171":109679,"_5":13189,"_26134":109335,"_2648":49181},[],{"_3150":65080,"_27624":64935,"_19171":109681,"_5":13189,"_26134":109335,"_2648":109682},[],"Ninguna",{"_3150":65081,"_27624":64935,"_19171":109684,"_5":13189,"_26134":109335,"_2648":49187},[],{"_3150":65082,"_27624":64935,"_19171":109686,"_5":13189,"_26134":109335,"_2648":49190},[],{"_3150":65083,"_27624":64935,"_19171":109688,"_5":13189,"_26134":109335,"_2648":49193},[],{"_3150":65084,"_27624":64935,"_19171":109690,"_5":13189,"_26134":109335,"_2648":49196},[],{"_3150":65085,"_27624":64935,"_19171":109692,"_5":13189,"_26134":109335,"_2648":49190},[],{"_3150":65086,"_27624":64935,"_19171":109694,"_5":13189,"_26134":109335,"_2648":109695},[],"Cualquier otra razón",{"_3150":65087,"_27624":64935,"_19171":109697,"_5":13189,"_26134":109335,"_2648":49204},[],{"_3150":65088,"_27624":64935,"_19171":109699,"_5":13189,"_26134":109335,"_2648":109700},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3150":65089,"_27624":64935,"_19171":109702,"_5":13189,"_26134":109339,"_2648":109703},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3150":65090,"_27624":64935,"_19171":109705,"_5":13189,"_26134":109339,"_2648":109706},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3150":65091,"_27624":64935,"_19171":109708,"_5":13189,"_26134":109339,"_2648":109709},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3150":65092,"_27624":64935,"_19171":109711,"_5":13189,"_26134":109343,"_2648":109712},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3150":65093,"_27624":64935,"_19171":109714,"_5":13189,"_26134":109343,"_2648":109715},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3150":65094,"_27624":64935,"_19171":109717,"_5":13189,"_26134":109347,"_2648":109718},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3150":65095,"_27624":64935,"_19171":109720,"_5":13189,"_26134":109347,"_2648":109721},[],"Existen dos tipos de acciones:",{"_3150":65096,"_27624":64935,"_19171":109723,"_5":13189,"_26134":109347,"_2648":109724},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3150":65097,"_27624":64935,"_19171":109726,"_5":13189,"_26134":109347,"_2648":109727},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3150":65098,"_27624":64935,"_19171":109729,"_5":13189,"_26134":109347,"_2648":109730},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3150":65099,"_27624":64935,"_19171":109732,"_5":13189,"_26134":109351,"_2648":109733},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3150":65100,"_27624":64935,"_19171":109735,"_5":13189,"_26134":109351,"_2648":109736},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3150":65101,"_27624":64935,"_19171":109738,"_5":13189,"_26134":109351,"_2648":109739},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3150":65102,"_27624":64935,"_19171":109741,"_5":13189,"_26134":109355,"_2648":109742},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3150":65103,"_27624":64935,"_19171":109744,"_5":13189,"_26134":109355,"_2648":109745},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3150":65104,"_27624":64935,"_19171":109747,"_5":13189,"_26134":109355,"_2648":109748},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3150":65105,"_27624":64935,"_19171":109750,"_5":13189,"_26134":109355,"_2648":109751},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3150":65106,"_27624":64935,"_19171":109753,"_5":13189,"_26134":109355,"_2648":109754},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3150":65107,"_27624":64935,"_19171":109756,"_5":13189,"_26134":109355,"_2648":109757},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3150":65108,"_27624":64935,"_19171":109759,"_5":13189,"_26134":109355,"_2648":109760},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3150":65109,"_27624":64935,"_19171":109762,"_5":13189,"_26134":109355,"_2648":109763},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3150":65110,"_27624":64935,"_19171":109765,"_5":13189,"_26134":109355,"_2648":109766},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3150":65111,"_27624":64935,"_19171":109768,"_5":13189,"_26134":109355,"_2648":109769},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3150":65112,"_27624":64935,"_19171":109771,"_5":13189,"_26134":109355,"_2648":109772},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3150":65113,"_27624":64935,"_19171":109774,"_5":13189,"_26134":109355,"_2648":109775},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3150":65114,"_27624":64935,"_19171":109777,"_5":13189,"_26134":109355,"_2648":109778},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3150":65115,"_27624":64935,"_19171":109780,"_5":13189,"_26134":109355,"_2648":109781},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3150":65116,"_27624":64935,"_19171":109783,"_5":13189,"_26134":109355,"_2648":109784},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3150":65117,"_27624":64935,"_19171":109786,"_5":13189,"_26134":109355,"_2648":109787},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3150":65118,"_27624":64935,"_19171":109789,"_5":13189,"_26134":109355,"_2648":109790},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3150":65119,"_27624":64935,"_19171":109792,"_5":13189,"_26134":109355,"_2648":109793},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3150":65120,"_27624":64935,"_19171":109795,"_5":13189,"_26134":109355,"_2648":109796},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":65121,"_27624":64935,"_19171":109798,"_5":13189,"_26134":109355,"_2648":109799},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3150":65122,"_27624":64935,"_19171":109801,"_5":13189,"_26134":109355,"_2648":109802},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3150":65123,"_27624":65123,"_5":13515,"_2648":47290,"_27967":109804,"_19171":109805,"_26134":65123},[44933,106897,47290],[],{"_3150":65124,"_27624":65123,"_19171":109807,"_5":13189,"_26134":65123,"_2648":109808},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3150":65125,"_27624":65123,"_5":27964,"_19171":109810,"_26134":109811,"_2648":109812},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3150":65126,"_27624":65123,"_5":27964,"_19171":109814,"_26134":109815,"_2648":107872},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3150":65127,"_27624":65123,"_5":27964,"_19171":109817,"_26134":109818,"_2648":108047},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3150":65128,"_27624":65123,"_5":27964,"_19171":109820,"_26134":109821,"_2648":109274},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#integraciones",{"_3150":65129,"_27624":65123,"_5":27964,"_19171":109823,"_26134":109824,"_2648":109825},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3150":65130,"_27624":65123,"_19171":109827,"_5":13189,"_26134":65123,"_2648":109828},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3150":65131,"_27624":65123,"_19171":109830,"_5":13189,"_26134":109811,"_2648":109831},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3150":65132,"_27624":65123,"_19171":109833,"_5":13189,"_26134":109811,"_2648":109834},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3150":65133,"_27624":65123,"_19171":109836,"_5":13189,"_26134":109815,"_2648":109837},[],"Recurso",{"_3150":65134,"_27624":65123,"_19171":109839,"_5":13189,"_26134":109815,"_2648":109840},[],"Qué representa",{"_3150":65135,"_27624":65123,"_19171":109842,"_5":13189,"_26134":109815,"_2648":109843},[],"**Dispositivo**",{"_3150":65136,"_27624":65123,"_19171":109845,"_5":13189,"_26134":109815,"_2648":109846},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3150":65137,"_27624":65123,"_19171":109848,"_5":13189,"_26134":109815,"_2648":109849},[],"**Identidad**",{"_3150":65138,"_27624":65123,"_19171":109851,"_5":13189,"_26134":109815,"_2648":109852},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3150":65139,"_27624":65123,"_19171":109854,"_5":13189,"_26134":109815,"_2648":49362},[],{"_3150":65140,"_27624":65123,"_19171":109856,"_5":13189,"_26134":109815,"_2648":109857},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3150":65141,"_27624":65123,"_19171":109859,"_5":13189,"_26134":109815,"_2648":109860},[],"**Flota**",{"_3150":65142,"_27624":65123,"_19171":109862,"_5":13189,"_26134":109815,"_2648":109863},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3150":65143,"_27624":65123,"_19171":109865,"_5":13189,"_26134":109815,"_2648":109866},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3150":65144,"_27624":65123,"_19171":109868,"_5":13189,"_26134":109815,"_2648":109869},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3150":65145,"_27624":65123,"_19171":109871,"_5":13189,"_26134":109818,"_2648":109872},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3150":65146,"_27624":65123,"_19171":109874,"_5":13189,"_26134":109818,"_2648":109875},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3150":65147,"_27624":65123,"_19171":109877,"_5":13189,"_26134":109818,"_2648":109878},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3150":65148,"_27624":65123,"_19171":109880,"_5":13189,"_26134":109818,"_2648":109881},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3150":65149,"_27624":65123,"_19171":109883,"_5":13189,"_26134":109818,"_2648":109884},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3150":65150,"_27624":65123,"_19171":109886,"_5":13189,"_26134":109818,"_2648":109887},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3150":65151,"_27624":65123,"_19171":109889,"_5":13189,"_26134":109818,"_2648":109890},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":65152,"_27624":65123,"_19171":109892,"_5":13189,"_26134":109818,"_2648":109893},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":65153,"_27624":65123,"_19171":109895,"_5":13189,"_26134":109821,"_2648":109896},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3150":65154,"_27624":65123,"_19171":109898,"_5":13189,"_26134":109821,"_2648":109899},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3150":65155,"_27624":65123,"_19171":109901,"_5":13189,"_26134":109824,"_2648":109902},[],"Participante",{"_3150":65156,"_27624":65123,"_19171":109904,"_5":13189,"_26134":109824,"_2648":109905},[],"Responsabilidad",{"_3150":65157,"_27624":65123,"_19171":109907,"_5":13189,"_26134":109824,"_2648":109908},[],"Administrador PKI",{"_3150":65158,"_27624":65123,"_19171":109910,"_5":13189,"_26134":109824,"_2648":109911},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3150":65159,"_27624":65123,"_19171":109913,"_5":13189,"_26134":109824,"_2648":109914},[],"Administrador del aprovisionamiento",{"_3150":65160,"_27624":65123,"_19171":109916,"_5":13189,"_26134":109824,"_2648":109917},[],"DMS, admisión, autenticación por operación e inventario.",{"_3150":65161,"_27624":65123,"_19171":109919,"_5":13189,"_26134":109824,"_2648":109920},[],"Integrador del dispositivo",{"_3150":65162,"_27624":65123,"_19171":109922,"_5":13189,"_26134":109824,"_2648":109923},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3150":65163,"_27624":65123,"_19171":109925,"_5":13189,"_26134":109824,"_2648":109926},[],"Integrador del consumidor",{"_3150":65164,"_27624":65123,"_19171":109928,"_5":13189,"_26134":109824,"_2648":109929},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3150":65165,"_27624":65123,"_19171":109931,"_5":13189,"_26134":109824,"_2648":109932},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3150":65166,"_27624":65166,"_5":13515,"_2648":109934,"_27967":109935,"_19171":109937,"_26134":65166},"Enrola y conecta tu primer dispositivo",[44933,106897,47290,109936],"Primeros pasos",[],{"_3150":65167,"_27624":65166,"_19171":109939,"_5":13189,"_26134":65166,"_2648":109940},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3150":65168,"_27624":65166,"_5":27964,"_19171":109942,"_26134":109943,"_2648":105563},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3150":65169,"_27624":65166,"_5":27964,"_19171":109945,"_26134":109946,"_2648":109947},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3150":65170,"_27624":65166,"_5":27964,"_19171":109949,"_26134":109950,"_2648":109951},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3150":65171,"_27624":65166,"_5":27964,"_19171":109953,"_26134":109954,"_2648":109955},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3150":65172,"_27624":65166,"_5":27964,"_19171":109957,"_26134":109958,"_2648":109959},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3150":65173,"_27624":65166,"_5":27964,"_19171":109961,"_26134":109962,"_2648":109963},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3150":65174,"_27624":65166,"_5":27964,"_19171":109965,"_26134":109966,"_2648":109967},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3150":65175,"_27624":65166,"_5":27964,"_19171":109969,"_26134":109970,"_2648":109971},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3150":65176,"_27624":65166,"_19171":109973,"_5":13189,"_26134":65166,"_2648":109974},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3150":65177,"_27624":65166,"_19171":109976,"_5":13189,"_26134":109943,"_2648":109977},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3150":65178,"_27624":65166,"_19171":109979,"_5":13189,"_26134":109943,"_2648":109980},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3150":65179,"_27624":65166,"_19171":109982,"_5":13189,"_26134":109943,"_2648":109983},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3150":65180,"_27624":65166,"_19171":109985,"_5":13189,"_26134":109943,"_2648":109986},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3150":65181,"_27624":65166,"_19171":109988,"_5":13189,"_26134":109943,"_2648":109989},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3150":65182,"_27624":65166,"_19171":109991,"_5":13189,"_26134":109946,"_2648":109992},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3150":65183,"_27624":65166,"_19171":109994,"_5":13189,"_26134":109946,"_2648":109995},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3150":65184,"_27624":65166,"_19171":109997,"_5":13189,"_26134":109950,"_2648":109998},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3150":65185,"_27624":65166,"_19171":110000,"_5":13189,"_26134":109950,"_2648":110001},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3150":65186,"_27624":65166,"_19171":110003,"_5":13189,"_26134":109950,"_2648":110004},[],"Ajuste",{"_3150":65187,"_27624":65166,"_19171":110006,"_5":13189,"_26134":109950,"_2648":110007},[],"Valor de evaluación",{"_3150":65188,"_27624":65166,"_19171":110009,"_5":13189,"_26134":109950,"_2648":49518},[],{"_3150":65189,"_27624":65166,"_19171":110011,"_5":13189,"_26134":109950,"_2648":110012},[],"Raíz emisora de `device-root.pem`.",{"_3150":65190,"_27624":65166,"_19171":110014,"_5":13189,"_26134":109950,"_2648":108175},[],{"_3150":65191,"_27624":65166,"_19171":110016,"_5":13189,"_26134":109950,"_2648":110017},[],"Perfil final de 1 hora que acabas de preparar.",{"_3150":65192,"_27624":65166,"_19171":110019,"_5":13189,"_26134":109950,"_2648":49529},[],{"_3150":65193,"_27624":65166,"_19171":110021,"_5":13189,"_26134":109950,"_2648":49532},[],{"_3150":65194,"_27624":65166,"_19171":110023,"_5":13189,"_26134":109950,"_2648":49535},[],{"_3150":65195,"_27624":65166,"_19171":110025,"_5":13189,"_26134":109950,"_2648":110026},[],"Habilitado.",{"_3150":65196,"_27624":65166,"_19171":110028,"_5":13189,"_26134":109950,"_2648":49541},[],{"_3150":65197,"_27624":65166,"_19171":110030,"_5":13189,"_26134":109950,"_2648":110031},[],"Deshabilitado; el ID debe ser nuevo.",{"_3150":65198,"_27624":65166,"_19171":110033,"_5":13189,"_26134":109950,"_2648":110034},[],"Autenticación inicial",{"_3150":65199,"_27624":65166,"_19171":110036,"_5":13189,"_26134":109950,"_2648":110037},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3150":65200,"_27624":65166,"_19171":110039,"_5":13189,"_26134":109950,"_2648":110040},[],"Autenticación de renovación",{"_3150":65201,"_27624":65166,"_19171":110042,"_5":13189,"_26134":109950,"_2648":110043},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3150":65202,"_27624":65166,"_19171":110045,"_5":13189,"_26134":109950,"_2648":49559},[],{"_3150":65203,"_27624":65166,"_19171":110047,"_5":13189,"_26134":109950,"_2648":110048},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_3150":65204,"_27624":65166,"_19171":110050,"_5":13189,"_26134":109950,"_2648":49565},[],{"_3150":65205,"_27624":65166,"_19171":110052,"_5":13189,"_26134":109950,"_2648":110053},[],"1 hora.",{"_3150":65206,"_27624":65166,"_19171":110055,"_5":13189,"_26134":109950,"_2648":49571},[],{"_3150":65207,"_27624":65166,"_19171":110057,"_5":13189,"_26134":109950,"_2648":110058},[],"30 minutos / 10 minutos.",{"_3150":65208,"_27624":65166,"_19171":110060,"_5":13189,"_26134":109950,"_2648":49577},[],{"_3150":65209,"_27624":65166,"_19171":110062,"_5":13189,"_26134":109950,"_2648":110063},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3150":65210,"_27624":65166,"_19171":110065,"_5":13189,"_26134":109950,"_2648":47609},[],{"_3150":65211,"_27624":65166,"_19171":110067,"_5":13189,"_26134":109950,"_2648":110068},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3150":65212,"_27624":65166,"_19171":110070,"_5":13189,"_26134":109950,"_2648":49588},[],{"_3150":65213,"_27624":65166,"_19171":110072,"_5":13189,"_26134":109950,"_2648":110073},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3150":65214,"_27624":65166,"_19171":110075,"_5":13189,"_26134":109950,"_2648":110076},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3150":65215,"_27624":65166,"_19171":110078,"_5":13189,"_26134":109954,"_2648":110079},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3150":65216,"_27624":65166,"_19171":110081,"_5":13189,"_26134":109954,"_2648":110082},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3150":65217,"_27624":65166,"_19171":110084,"_5":13189,"_26134":109958,"_2648":110085},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3150":65218,"_27624":65166,"_19171":110087,"_5":13189,"_26134":109958,"_2648":110088},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3150":65219,"_27624":65166,"_19171":110090,"_5":13189,"_26134":109958,"_2648":110091},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3150":65220,"_27624":65166,"_19171":110093,"_5":13189,"_26134":109962,"_2648":110094},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3150":65221,"_27624":65166,"_19171":110096,"_5":13189,"_26134":109962,"_2648":110097},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3150":65222,"_27624":65166,"_19171":110099,"_5":13189,"_26134":109966,"_2648":110100},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3150":65223,"_27624":65166,"_19171":110102,"_5":13189,"_26134":109966,"_2648":110103},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3150":65224,"_27624":65166,"_19171":110105,"_5":13189,"_26134":109966,"_2648":110106},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3150":65225,"_27624":65166,"_19171":110108,"_5":13189,"_26134":109966,"_2648":110109},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3150":65226,"_27624":65166,"_19171":110111,"_5":13189,"_26134":109966,"_2648":110112},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3150":65227,"_27624":65166,"_19171":110114,"_5":13189,"_26134":109970,"_2648":110115},[],"Comprobación",{"_3150":65228,"_27624":65166,"_19171":110117,"_5":13189,"_26134":109970,"_2648":110118},[],"Resultado esperado",{"_3150":65229,"_27624":65166,"_19171":110120,"_5":13189,"_26134":109970,"_2648":110121},[],"Registro",{"_3150":65230,"_27624":65166,"_19171":110123,"_5":13189,"_26134":109970,"_2648":110124},[],"ID creado automáticamente y DMS correcto.",{"_3150":65231,"_27624":65166,"_19171":110126,"_5":13189,"_26134":109970,"_2648":110127},[],"Certificado",{"_3150":65232,"_27624":65166,"_19171":110129,"_5":13189,"_26134":109970,"_2648":110130},[],"CN, perfil, serie y clave verificados.",{"_3150":65233,"_27624":65166,"_19171":110132,"_5":13189,"_26134":109970,"_2648":110133},[],"Inventario",{"_3150":65234,"_27624":65166,"_19171":110135,"_5":13189,"_26134":109970,"_2648":110136},[],"Serie recibida visible como identidad actual y en el historial.",{"_3150":65235,"_27624":65166,"_19171":110138,"_5":13189,"_26134":109970,"_2648":110139},[],"Consumidor",{"_3150":65236,"_27624":65166,"_19171":110141,"_5":13189,"_26134":109970,"_2648":110142},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3150":65237,"_27624":65166,"_19171":110144,"_5":13189,"_26134":109970,"_2648":110145},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3150":65238,"_27624":65166,"_19171":110147,"_5":13189,"_26134":109970,"_2648":110148},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3150":65239,"_27624":65239,"_5":13515,"_2648":107889,"_27967":110150,"_19171":110151,"_26134":65239},[44933,106897,47290,109936],[],{"_3150":65240,"_27624":65239,"_19171":110153,"_5":13189,"_26134":65239,"_2648":110154},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3150":65241,"_27624":65239,"_5":27964,"_19171":110156,"_26134":110157,"_2648":105563},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3150":65242,"_27624":65239,"_5":27964,"_19171":110159,"_26134":110160,"_2648":110161},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3150":65243,"_27624":65239,"_5":27964,"_19171":110163,"_26134":110164,"_2648":110165},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3150":65244,"_27624":65239,"_5":27964,"_19171":110167,"_26134":110168,"_2648":110169},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3150":65245,"_27624":65239,"_5":27964,"_19171":110171,"_26134":110172,"_2648":110173},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3150":65246,"_27624":65239,"_5":27964,"_19171":110175,"_26134":110176,"_2648":110177},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3150":65247,"_27624":65239,"_5":27964,"_19171":110179,"_26134":110180,"_2648":110118},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3150":65248,"_27624":65239,"_5":27964,"_19171":110182,"_26134":110183,"_2648":110184},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3150":65249,"_27624":65239,"_5":27964,"_19171":110186,"_26134":110187,"_2648":110188},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3150":65250,"_27624":65239,"_19171":110190,"_5":13189,"_26134":65239,"_2648":110191},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3150":65251,"_27624":65239,"_19171":110193,"_5":13189,"_26134":65239,"_2648":110194},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3150":65252,"_27624":65239,"_19171":110196,"_5":13189,"_26134":110157,"_2648":110197},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3150":65253,"_27624":65239,"_19171":110199,"_5":13189,"_26134":110157,"_2648":110200},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3150":65254,"_27624":65239,"_19171":110202,"_5":13189,"_26134":110157,"_2648":110203},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3150":65255,"_27624":65239,"_19171":110205,"_5":13189,"_26134":110157,"_2648":110206},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3150":65256,"_27624":65239,"_19171":110208,"_5":13189,"_26134":110160,"_2648":110209},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3150":65257,"_27624":65239,"_19171":110211,"_5":13189,"_26134":110160,"_2648":110212},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3150":65258,"_27624":65239,"_19171":110214,"_5":13189,"_26134":110160,"_2648":110215},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3150":65259,"_27624":65239,"_19171":110217,"_5":13189,"_26134":110160,"_2648":110218},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3150":65260,"_27624":65239,"_19171":110220,"_5":13189,"_26134":110160,"_2648":110221},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_3150":65261,"_27624":65239,"_19171":110223,"_5":13189,"_26134":110160,"_2648":110224},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3150":65262,"_27624":65239,"_19171":110226,"_5":13189,"_26134":110160,"_2648":110227},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3150":65263,"_27624":65239,"_19171":110229,"_5":13189,"_26134":110160,"_2648":110230},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3150":65264,"_27624":65239,"_19171":110232,"_5":13189,"_26134":110164,"_2648":110233},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3150":65265,"_27624":65239,"_19171":110235,"_5":13189,"_26134":110164,"_2648":49754},[],{"_3150":65266,"_27624":65239,"_19171":110237,"_5":13189,"_26134":110164,"_2648":110238},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3150":65267,"_27624":65239,"_19171":110240,"_5":13189,"_26134":110164,"_2648":110241},[],"**Icon** y **Tags**: clasificación opcional.",{"_3150":65268,"_27624":65239,"_19171":110243,"_5":13189,"_26134":110164,"_2648":110244},[],"Confirma el registro.",{"_3150":65269,"_27624":65239,"_19171":110246,"_5":13189,"_26134":110168,"_2648":110247},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3150":65270,"_27624":65239,"_19171":110249,"_5":13189,"_26134":110168,"_2648":110250},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3150":65271,"_27624":65239,"_19171":110252,"_5":13189,"_26134":110172,"_2648":110253},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3150":65272,"_27624":65239,"_19171":110255,"_5":13189,"_26134":110172,"_2648":110256},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3150":65273,"_27624":65239,"_19171":110258,"_5":13189,"_26134":110176,"_2648":110259},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3150":65274,"_27624":65239,"_19171":110261,"_5":13189,"_26134":110176,"_2648":110262},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3150":65275,"_27624":65239,"_19171":110264,"_5":13189,"_26134":110180,"_2648":110115},[],{"_3150":65276,"_27624":65239,"_19171":110266,"_5":13189,"_26134":110180,"_2648":110267},[],"Resultado",{"_3150":65277,"_27624":65239,"_19171":110269,"_5":13189,"_26134":110180,"_2648":110270},[],"Dispositivo",{"_3150":65278,"_27624":65239,"_19171":110272,"_5":13189,"_26134":110180,"_2648":110273},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3150":65279,"_27624":65239,"_19171":110275,"_5":13189,"_26134":110180,"_2648":110276},[],"Identidad actual",{"_3150":65280,"_27624":65239,"_19171":110278,"_5":13189,"_26134":110180,"_2648":110279},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3150":65281,"_27624":65239,"_19171":110281,"_5":13189,"_26134":110180,"_2648":110282},[],"Historial",{"_3150":65282,"_27624":65239,"_19171":110284,"_5":13189,"_26134":110180,"_2648":110285},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3150":65283,"_27624":65239,"_19171":110287,"_5":13189,"_26134":110180,"_2648":110288},[],"Clave y certificado",{"_3150":65284,"_27624":65239,"_19171":110290,"_5":13189,"_26134":110180,"_2648":110291},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3150":65285,"_27624":65239,"_19171":110293,"_5":13189,"_26134":110183,"_2648":110294},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3150":65286,"_27624":65239,"_19171":110296,"_5":13189,"_26134":110183,"_2648":110297},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3150":65287,"_27624":65239,"_19171":110299,"_5":13189,"_26134":110183,"_2648":110300},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3150":65288,"_27624":65239,"_19171":110302,"_5":13189,"_26134":110183,"_2648":110303},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3150":65289,"_27624":65239,"_19171":110305,"_5":13189,"_26134":110187,"_2648":110306},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3150":65290,"_27624":65239,"_19171":110308,"_5":13189,"_26134":110187,"_2648":110309},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3150":65291,"_27624":65239,"_19171":110311,"_5":13189,"_26134":110187,"_2648":110312},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3150":65292,"_27624":65292,"_5":13515,"_2648":110314,"_27967":110315,"_19171":110316,"_26134":65292},"Plataforma Lamassu IoT",[44933,106897],[],{"_3150":65293,"_27624":65292,"_19171":110318,"_5":13189,"_26134":65292,"_2648":110319},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3150":65294,"_27624":65292,"_5":27964,"_19171":110321,"_26134":110322,"_2648":109812},[],"/docs/pr-preview/pr-26/es/platform/overview#empieza-aquí",{"_3150":65295,"_27624":65292,"_5":27964,"_19171":110324,"_26134":110325,"_2648":110326},[],"/docs/pr-preview/pr-26/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3150":65296,"_27624":65292,"_5":27964,"_19171":110328,"_26134":110329,"_2648":110330},[],"/docs/pr-preview/pr-26/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3150":65297,"_27624":65292,"_5":27964,"_19171":110332,"_26134":110333,"_2648":110334},[],"/docs/pr-preview/pr-26/es/platform/overview#capacidades-principales","Capacidades principales",{"_3150":65298,"_27624":65292,"_5":27964,"_19171":110336,"_26134":110337,"_2648":110338},[],"/docs/pr-preview/pr-26/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3150":65299,"_27624":65292,"_5":27964,"_19171":110340,"_26134":110341,"_2648":110342},[],"/docs/pr-preview/pr-26/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3150":65300,"_27624":65292,"_5":27964,"_19171":110344,"_26134":110345,"_2648":110346},[],"/docs/pr-preview/pr-26/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3150":65301,"_27624":65292,"_5":27964,"_19171":110348,"_26134":110349,"_2648":110350},[],"/docs/pr-preview/pr-26/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3150":65302,"_27624":65292,"_5":27964,"_19171":110352,"_26134":110353,"_2648":110354},[],"/docs/pr-preview/pr-26/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3150":65303,"_27624":65292,"_5":27964,"_19171":110356,"_26134":110357,"_2648":110358},[],"/docs/pr-preview/pr-26/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3150":65304,"_27624":65292,"_5":27964,"_19171":110360,"_26134":110361,"_2648":110362},[],"/docs/pr-preview/pr-26/es/platform/overview#referencia-operativa","Referencia operativa",{"_3150":65305,"_27624":65292,"_19171":110364,"_5":13189,"_26134":65292,"_2648":110365},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3150":65306,"_27624":65292,"_19171":110367,"_5":13189,"_26134":110322,"_2648":110368},[],"Elige el resultado que necesitas obtener:",{"_3150":65307,"_27624":65292,"_19171":110370,"_5":13189,"_26134":110322,"_2648":110371},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":65308,"_27624":65292,"_19171":110373,"_5":13189,"_26134":110322,"_2648":110374},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":65309,"_27624":65292,"_19171":110376,"_5":13189,"_26134":110322,"_2648":110377},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3150":65310,"_27624":65292,"_19171":110379,"_5":13189,"_26134":110325,"_2648":110380},[],"Bloque",{"_3150":65311,"_27624":65292,"_19171":110382,"_5":13189,"_26134":110325,"_2648":110383},[],"Qué gestionas",{"_3150":65312,"_27624":65292,"_19171":110385,"_5":13189,"_26134":110325,"_2648":110386},[],"Punto de entrada",{"_3150":65313,"_27624":65292,"_19171":110388,"_5":13189,"_26134":110325,"_2648":49908},[],{"_3150":65314,"_27624":65292,"_19171":110390,"_5":13189,"_26134":110325,"_2648":110391},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3150":65315,"_27624":65292,"_19171":110393,"_5":13189,"_26134":110325,"_2648":110394},[],"Visión general de PKI",{"_3150":65316,"_27624":65292,"_19171":110396,"_5":13189,"_26134":110325,"_2648":49917},[],{"_3150":65317,"_27624":65292,"_19171":110398,"_5":13189,"_26134":110325,"_2648":110399},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3150":65318,"_27624":65292,"_19171":110401,"_5":13189,"_26134":110325,"_2648":110402},[],"Visión general de IoT Fleets",{"_3150":65319,"_27624":65292,"_19171":110404,"_5":13189,"_26134":110325,"_2648":110405},[],"**Administración**",{"_3150":65320,"_27624":65292,"_19171":110407,"_5":13189,"_26134":110325,"_2648":110408},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3150":65321,"_27624":65292,"_19171":110410,"_5":13189,"_26134":110325,"_2648":106895},[],{"_3150":65322,"_27624":65292,"_19171":110412,"_5":13189,"_26134":110325,"_2648":110413},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3150":65323,"_27624":65292,"_19171":110415,"_5":13189,"_26134":110329,"_2648":110416},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3150":65324,"_27624":65292,"_19171":110418,"_5":13189,"_26134":110329,"_2648":110419},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3150":65325,"_27624":65292,"_19171":110421,"_5":13189,"_26134":110329,"_2648":110422},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3150":65326,"_27624":65292,"_19171":110424,"_5":13189,"_26134":110329,"_2648":110425},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3150":65327,"_27624":65292,"_19171":110427,"_5":13189,"_26134":110329,"_2648":110428},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3150":65328,"_27624":65292,"_19171":110430,"_5":13189,"_26134":110329,"_2648":110431},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3150":65329,"_27624":65292,"_19171":110433,"_5":13189,"_26134":110337,"_2648":110434},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3150":65330,"_27624":65292,"_19171":110436,"_5":13189,"_26134":110341,"_2648":110437},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3150":65331,"_27624":65292,"_19171":110439,"_5":13189,"_26134":110345,"_2648":110440},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3150":65332,"_27624":65292,"_19171":110442,"_5":13189,"_26134":110349,"_2648":110443},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3150":65333,"_27624":65292,"_19171":110445,"_5":13189,"_26134":110353,"_2648":110446},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3150":65334,"_27624":65292,"_19171":110448,"_5":13189,"_26134":110357,"_2648":110449},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3150":65335,"_27624":65292,"_19171":110451,"_5":13189,"_26134":110361,"_2648":109905},[],{"_3150":65336,"_27624":65292,"_19171":110453,"_5":13189,"_26134":110361,"_2648":110454},[],"Qué prepara o comprueba",{"_3150":65337,"_27624":65292,"_19171":110456,"_5":13189,"_26134":110361,"_2648":109908},[],{"_3150":65338,"_27624":65292,"_19171":110458,"_5":13189,"_26134":110361,"_2648":110459},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3150":65339,"_27624":65292,"_19171":110461,"_5":13189,"_26134":110361,"_2648":110462},[],"Administrador de la flota",{"_3150":65340,"_27624":65292,"_19171":110464,"_5":13189,"_26134":110361,"_2648":110465},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3150":65341,"_27624":65292,"_19171":110467,"_5":13189,"_26134":110361,"_2648":109920},[],{"_3150":65342,"_27624":65292,"_19171":110469,"_5":13189,"_26134":110361,"_2648":110470},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3150":65343,"_27624":65292,"_19171":110472,"_5":13189,"_26134":110361,"_2648":109926},[],{"_3150":65344,"_27624":65292,"_19171":110474,"_5":13189,"_26134":110361,"_2648":110475},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3150":65345,"_27624":65292,"_19171":110477,"_5":13189,"_26134":110361,"_2648":110478},[],"Operador de infraestructura",{"_3150":65346,"_27624":65292,"_19171":110480,"_5":13189,"_26134":110361,"_2648":110481},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3150":65347,"_27624":65292,"_19171":110483,"_5":13189,"_26134":110361,"_2648":110484},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3150":65348,"_27624":65348,"_5":13515,"_2648":110486,"_27967":110487,"_19171":110489,"_26134":65348},"Jerarquía y rotación de CAs",[44933,106897,50009,110488],"Claves, autoridades y certificados",[],{"_3150":65349,"_27624":65348,"_19171":110491,"_5":13189,"_26134":65348,"_2648":110492},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3150":65350,"_27624":65348,"_5":27964,"_19171":110494,"_26134":110495,"_2648":110496},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3150":65351,"_27624":65348,"_5":27964,"_19171":110498,"_26134":110499,"_2648":110500},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3150":65352,"_27624":65348,"_5":27964,"_19171":110502,"_26134":110503,"_2648":110504},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3150":65353,"_27624":65348,"_5":27964,"_19171":110506,"_26134":110507,"_2648":110508},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3150":65354,"_27624":65348,"_5":27964,"_19171":110510,"_26134":110511,"_2648":110512},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3150":65355,"_27624":65348,"_5":27964,"_19171":110514,"_26134":110515,"_2648":110516},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3150":65356,"_27624":65348,"_5":27964,"_19171":110518,"_26134":110519,"_2648":110520},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3150":65357,"_27624":65348,"_5":27964,"_19171":110522,"_26134":110523,"_2648":110524},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3150":65358,"_27624":65348,"_5":27964,"_19171":110526,"_26134":110527,"_2648":110528},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3150":65359,"_27624":65348,"_5":27964,"_19171":110530,"_26134":110531,"_2648":110532},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3150":65360,"_27624":65348,"_5":27964,"_19171":110534,"_26134":110535,"_2648":110536},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3150":65361,"_27624":65348,"_5":27964,"_19171":110538,"_26134":110539,"_2648":110540},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3150":65362,"_27624":65348,"_19171":110542,"_5":13189,"_26134":65348,"_2648":110543},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3150":65363,"_27624":65348,"_19171":110545,"_5":13189,"_26134":65348,"_2648":110546},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3150":65364,"_27624":65348,"_19171":110548,"_5":13189,"_26134":110495,"_2648":110549},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3150":65365,"_27624":65348,"_19171":110551,"_5":13189,"_26134":110495,"_2648":110552},[],"entorno, como producción y preproducción;",{"_3150":65366,"_27624":65348,"_19171":110554,"_5":13189,"_26134":110495,"_2648":110555},[],"propietario o equipo operador;",{"_3150":65367,"_27624":65348,"_19171":110557,"_5":13189,"_26134":110495,"_2648":110558},[],"familia de dispositivos o proceso de fabricación;",{"_3150":65368,"_27624":65348,"_19171":110560,"_5":13189,"_26134":110495,"_2648":110561},[],"región o requisito regulatorio;",{"_3150":65369,"_27624":65348,"_19171":110563,"_5":13189,"_26134":110495,"_2648":110564},[],"motor criptográfico o política de clave;",{"_3150":65370,"_27624":65348,"_19171":110566,"_5":13189,"_26134":110495,"_2648":110567},[],"ventana de mantenimiento y ritmo de renovación.",{"_3150":65371,"_27624":65348,"_19171":110569,"_5":13189,"_26134":110495,"_2648":110570},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3150":65372,"_27624":65348,"_19171":110572,"_5":13189,"_26134":110495,"_2648":110573},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3150":65373,"_27624":65348,"_19171":110575,"_5":13189,"_26134":110499,"_2648":110576},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3150":65374,"_27624":65348,"_19171":110578,"_5":13189,"_26134":110499,"_2648":110579},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3150":65375,"_27624":65348,"_19171":110581,"_5":13189,"_26134":110499,"_2648":110582},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3150":65376,"_27624":65348,"_19171":110584,"_5":13189,"_26134":110503,"_2648":110585},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3150":65377,"_27624":65348,"_19171":110587,"_5":13189,"_26134":110503,"_2648":110588},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3150":65378,"_27624":65348,"_19171":110590,"_5":13189,"_26134":110503,"_2648":110591},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3150":65379,"_27624":65348,"_19171":110593,"_5":13189,"_26134":110503,"_2648":110594},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3150":65380,"_27624":65348,"_19171":110596,"_5":13189,"_26134":110511,"_2648":110597},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3150":65381,"_27624":65348,"_19171":110599,"_5":13189,"_26134":110515,"_2648":110600},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3150":65382,"_27624":65348,"_19171":110602,"_5":13189,"_26134":110519,"_2648":110603},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3150":65383,"_27624":65348,"_19171":110605,"_5":13189,"_26134":110523,"_2648":110606},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_3150":65384,"_27624":65348,"_19171":110608,"_5":13189,"_26134":110527,"_2648":110609},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3150":65385,"_27624":65348,"_19171":110611,"_5":13189,"_26134":110531,"_2648":110612},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_3150":65386,"_27624":65348,"_19171":110614,"_5":13189,"_26134":110535,"_2648":110615},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3150":65387,"_27624":65348,"_19171":110617,"_5":13189,"_26134":110535,"_2648":110618},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3150":65388,"_27624":65348,"_19171":110620,"_5":13189,"_26134":110535,"_2648":110621},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3150":65389,"_27624":65348,"_19171":110623,"_5":13189,"_26134":110535,"_2648":110624},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3150":65390,"_27624":65348,"_19171":110626,"_5":13189,"_26134":110539,"_2648":110627},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3150":65391,"_27624":65348,"_19171":110629,"_5":13189,"_26134":110539,"_2648":110630},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3150":65392,"_27624":65348,"_19171":110632,"_5":13189,"_26134":110539,"_2648":110633},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3150":65393,"_27624":65348,"_19171":110635,"_5":13189,"_26134":110539,"_2648":110636},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3150":65394,"_27624":65348,"_19171":110638,"_5":13189,"_26134":110539,"_2648":110639},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3150":65395,"_27624":65348,"_19171":110641,"_5":13189,"_26134":110539,"_2648":110642},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3150":65396,"_27624":65348,"_19171":110644,"_5":13189,"_26134":110539,"_2648":110645},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3150":65397,"_27624":65397,"_5":13515,"_2648":110647,"_27967":110648,"_19171":110649,"_26134":65397},"Autoridades de certificación",[44933,106897,50009,110488],[],{"_3150":65398,"_27624":65397,"_19171":110651,"_5":13189,"_26134":65397,"_2648":110652},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3150":65399,"_27624":65397,"_5":27964,"_19171":110654,"_26134":110655,"_2648":110656},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3150":65400,"_27624":65397,"_5":27964,"_19171":110658,"_26134":110659,"_2648":110660},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3150":65401,"_27624":65397,"_5":27964,"_19171":110662,"_26134":110663,"_2648":105563},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3150":65402,"_27624":65397,"_5":27964,"_19171":110665,"_26134":110666,"_2648":110667},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3150":65403,"_27624":65397,"_5":27964,"_19171":110669,"_26134":110670,"_2648":110671},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3150":65404,"_27624":65397,"_5":27964,"_19171":110673,"_26134":110674,"_2648":110675},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3150":65405,"_27624":65397,"_5":27964,"_19171":110677,"_26134":110678,"_2648":110679},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3150":65406,"_27624":65397,"_5":27964,"_19171":110681,"_26134":110682,"_2648":110683},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3150":65407,"_27624":65397,"_5":27964,"_19171":110685,"_26134":110686,"_2648":110687},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3150":65408,"_27624":65397,"_5":27964,"_19171":110689,"_26134":110690,"_2648":110691},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3150":65409,"_27624":65397,"_5":27964,"_19171":110693,"_26134":110694,"_2648":110695},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3150":65410,"_27624":65397,"_5":27964,"_19171":110697,"_26134":110698,"_2648":110699},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3150":65411,"_27624":65397,"_5":27964,"_19171":110701,"_26134":110702,"_2648":110703},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3150":65412,"_27624":65397,"_5":27964,"_19171":110705,"_26134":110706,"_2648":110707},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3150":65413,"_27624":65397,"_5":27964,"_19171":110709,"_26134":110710,"_2648":110711},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3150":65414,"_27624":65397,"_5":27964,"_19171":110713,"_26134":110714,"_2648":110715},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3150":65415,"_27624":65397,"_5":27964,"_19171":110717,"_26134":110718,"_2648":110719},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3150":65416,"_27624":65397,"_5":27964,"_19171":110721,"_26134":110722,"_2648":110723},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3150":65417,"_27624":65397,"_5":27964,"_19171":110725,"_26134":110726,"_2648":110727},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3150":65418,"_27624":65397,"_5":27964,"_19171":110729,"_26134":110730,"_2648":110731},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3150":65419,"_27624":65397,"_5":27964,"_19171":110733,"_26134":110734,"_2648":110735},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3150":65420,"_27624":65397,"_5":27964,"_19171":110737,"_26134":110738,"_2648":110739},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3150":65421,"_27624":65397,"_19171":110741,"_5":13189,"_26134":65397,"_2648":110742},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3150":65422,"_27624":65397,"_19171":110744,"_5":13189,"_26134":65397,"_2648":110745},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3150":65423,"_27624":65397,"_19171":110747,"_5":13189,"_26134":65397,"_2648":110748},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3150":65424,"_27624":65397,"_19171":110750,"_5":13189,"_26134":110655,"_2648":110751},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3150":65425,"_27624":65397,"_19171":110753,"_5":13189,"_26134":110655,"_2648":110754},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3150":65426,"_27624":65397,"_19171":110756,"_5":13189,"_26134":110655,"_2648":110757},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3150":65427,"_27624":65397,"_19171":110759,"_5":13189,"_26134":110655,"_2648":110760},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3150":65428,"_27624":65397,"_19171":110762,"_5":13189,"_26134":110655,"_2648":110763},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3150":65429,"_27624":65397,"_19171":110765,"_5":13189,"_26134":110663,"_2648":110766},[],"Decide si la CA será raíz o intermedia.",{"_3150":65430,"_27624":65397,"_19171":110768,"_5":13189,"_26134":110663,"_2648":110769},[],"Elige el motor que custodiará la clave.",{"_3150":65431,"_27624":65397,"_19171":110771,"_5":13189,"_26134":110663,"_2648":110772},[],"Define una validez superior a la de los certificados que emitirá.",{"_3150":65432,"_27624":65397,"_19171":110774,"_5":13189,"_26134":110663,"_2648":110775},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3150":65433,"_27624":65397,"_19171":110777,"_5":13189,"_26134":110666,"_2648":110778},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3150":65434,"_27624":65397,"_19171":110780,"_5":13189,"_26134":110670,"_2648":110781},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3150":65435,"_27624":65397,"_19171":110783,"_5":13189,"_26134":110670,"_2648":110784},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3150":65436,"_27624":65397,"_19171":110786,"_5":13189,"_26134":110674,"_2648":110787},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3150":65437,"_27624":65397,"_19171":110789,"_5":13189,"_26134":110678,"_2648":110790},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3150":65438,"_27624":65397,"_19171":110792,"_5":13189,"_26134":110678,"_2648":110793},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3150":65439,"_27624":65397,"_19171":110795,"_5":13189,"_26134":110678,"_2648":110796},[],"`ST`: estado o provincia.",{"_3150":65440,"_27624":65397,"_19171":110798,"_5":13189,"_26134":110678,"_2648":110799},[],"`L`: localidad.",{"_3150":65441,"_27624":65397,"_19171":110801,"_5":13189,"_26134":110678,"_2648":110802},[],"`O`: organización.",{"_3150":65442,"_27624":65397,"_19171":110804,"_5":13189,"_26134":110678,"_2648":110805},[],"`OU`: unidad organizativa.",{"_3150":65443,"_27624":65397,"_19171":110807,"_5":13189,"_26134":110678,"_2648":110808},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3150":65444,"_27624":65397,"_19171":110810,"_5":13189,"_26134":110682,"_2648":110811},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3150":65445,"_27624":65397,"_19171":110813,"_5":13189,"_26134":110682,"_2648":110814},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3150":65446,"_27624":65397,"_19171":110816,"_5":13189,"_26134":110686,"_2648":110817},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3150":65447,"_27624":65397,"_19171":110819,"_5":13189,"_26134":110686,"_2648":110820},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3150":65448,"_27624":65397,"_19171":110822,"_5":13189,"_26134":110690,"_2648":110823},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3150":65449,"_27624":65397,"_19171":110825,"_5":13189,"_26134":110690,"_2648":110826},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3150":65450,"_27624":65397,"_19171":110828,"_5":13189,"_26134":110694,"_2648":110829},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3150":65451,"_27624":65397,"_19171":110831,"_5":13189,"_26134":110698,"_2648":110832},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3150":65452,"_27624":65397,"_19171":110834,"_5":13189,"_26134":110702,"_2648":110835},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3150":65453,"_27624":65397,"_19171":110837,"_5":13189,"_26134":110706,"_2648":110838},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3150":65454,"_27624":65397,"_19171":110840,"_5":13189,"_26134":110710,"_2648":110841},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3150":65455,"_27624":65397,"_19171":110843,"_5":13189,"_26134":110710,"_2648":110844},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3150":65456,"_27624":65397,"_19171":110846,"_5":13189,"_26134":110714,"_2648":110847},[],"Abre una CA desde el inventario para consultar:",{"_3150":65457,"_27624":65397,"_19171":110849,"_5":13189,"_26134":110714,"_2648":110850},[],"Estado y periodo de validez.",{"_3150":65458,"_27624":65397,"_19171":110852,"_5":13189,"_26134":110714,"_2648":110853},[],"Certificado y cadena en formato PEM.",{"_3150":65459,"_27624":65397,"_19171":110855,"_5":13189,"_26134":110714,"_2648":110856},[],"Número de certificados activos, expirados y revocados.",{"_3150":65460,"_27624":65397,"_19171":110858,"_5":13189,"_26134":110714,"_2648":110859},[],"Certificados emitidos en **Issued Certificates**.",{"_3150":65461,"_27624":65397,"_19171":110861,"_5":13189,"_26134":110714,"_2648":110862},[],"CRL vinculada a la autoridad.",{"_3150":65462,"_27624":65397,"_19171":110864,"_5":13189,"_26134":110714,"_2648":110865},[],"Metadatos y motor criptográfico asociado.",{"_3150":65463,"_27624":65397,"_19171":110867,"_5":13189,"_26134":110714,"_2648":110868},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3150":65464,"_27624":65397,"_19171":110870,"_5":13189,"_26134":110718,"_2648":110871},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3150":65465,"_27624":65397,"_19171":110873,"_5":13189,"_26134":110718,"_2648":110874},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3150":65466,"_27624":65397,"_19171":110876,"_5":13189,"_26134":110718,"_2648":110877},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3150":65467,"_27624":65397,"_19171":110879,"_5":13189,"_26134":110718,"_2648":110880},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3150":65468,"_27624":65397,"_19171":110882,"_5":13189,"_26134":110722,"_2648":110883},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3150":65469,"_27624":65397,"_19171":110885,"_5":13189,"_26134":110726,"_2648":110886},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3150":65470,"_27624":65397,"_19171":110888,"_5":13189,"_26134":110730,"_2648":110889},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3150":65471,"_27624":65397,"_19171":110891,"_5":13189,"_26134":110734,"_2648":110892},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3150":65472,"_27624":65397,"_19171":110894,"_5":13189,"_26134":110738,"_2648":110895},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3150":65473,"_27624":65397,"_19171":110897,"_5":13189,"_26134":110738,"_2648":110898},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3150":65474,"_27624":65474,"_5":13515,"_2648":110900,"_27967":110901,"_19171":110902,"_26134":65474},"Perfiles de certificado",[44933,106897,50009,110488],[],{"_3150":65475,"_27624":65474,"_19171":110904,"_5":13189,"_26134":65474,"_2648":110905},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3150":65476,"_27624":65474,"_5":27964,"_19171":110907,"_26134":110908,"_2648":110909},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3150":65477,"_27624":65474,"_5":27964,"_19171":110911,"_26134":110912,"_2648":110913},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#validez","Validez",{"_3150":65478,"_27624":65474,"_5":27964,"_19171":110915,"_26134":110916,"_2648":110917},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3150":65479,"_27624":65474,"_5":27964,"_19171":110919,"_26134":110920,"_2648":110921},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3150":65480,"_27624":65474,"_5":27964,"_19171":110923,"_26134":110924,"_2648":110925},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3150":65481,"_27624":65474,"_5":27964,"_19171":110927,"_26134":110928,"_2648":110929},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3150":65482,"_27624":65474,"_5":27964,"_19171":110931,"_26134":110932,"_2648":110933},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3150":65483,"_27624":65474,"_5":27964,"_19171":110935,"_26134":110936,"_2648":110937},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3150":65484,"_27624":65474,"_5":27964,"_19171":110939,"_26134":110940,"_2648":110941},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3150":65485,"_27624":65474,"_5":27964,"_19171":110943,"_26134":110944,"_2648":110945},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3150":65486,"_27624":65474,"_5":27964,"_19171":110947,"_26134":110948,"_2648":110949},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3150":65487,"_27624":65474,"_5":27964,"_19171":110951,"_26134":110952,"_2648":110953},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3150":65488,"_27624":65474,"_5":27964,"_19171":110955,"_26134":110956,"_2648":110957},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3150":65489,"_27624":65474,"_5":27964,"_19171":110959,"_26134":110960,"_2648":110961},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3150":65490,"_27624":65474,"_5":27964,"_19171":110963,"_26134":110964,"_2648":110965},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3150":65491,"_27624":65474,"_5":27964,"_19171":110967,"_26134":110968,"_2648":110969},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3150":65492,"_27624":65474,"_19171":110971,"_5":13189,"_26134":65474,"_2648":110972},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3150":65493,"_27624":65474,"_19171":110974,"_5":13189,"_26134":65474,"_2648":110975},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3150":65494,"_27624":65474,"_19171":110977,"_5":13189,"_26134":110912,"_2648":110978},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3150":65495,"_27624":65474,"_19171":110980,"_5":13189,"_26134":110912,"_2648":110981},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3150":65496,"_27624":65474,"_19171":110983,"_5":13189,"_26134":110916,"_2648":110984},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3150":65497,"_27624":65474,"_19171":110986,"_5":13189,"_26134":110920,"_2648":110987},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3150":65498,"_27624":65474,"_19171":110989,"_5":13189,"_26134":110920,"_2648":110990},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3150":65499,"_27624":65474,"_19171":110992,"_5":13189,"_26134":110920,"_2648":110993},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3150":65500,"_27624":65474,"_19171":110995,"_5":13189,"_26134":110924,"_2648":110996},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3150":65501,"_27624":65474,"_19171":110998,"_5":13189,"_26134":110928,"_2648":110999},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3150":65502,"_27624":65474,"_19171":111001,"_5":13189,"_26134":110928,"_2648":111002},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3150":65503,"_27624":65474,"_19171":111004,"_5":13189,"_26134":110932,"_2648":111005},[],"La aplicación criptográfica puede:",{"_3150":65504,"_27624":65474,"_19171":111007,"_5":13189,"_26134":110932,"_2648":111008},[],"permitir o bloquear claves RSA;",{"_3150":65505,"_27624":65474,"_19171":111010,"_5":13189,"_26134":110932,"_2648":111011},[],"limitar los tamaños RSA admitidos;",{"_3150":65506,"_27624":65474,"_19171":111013,"_5":13189,"_26134":110932,"_2648":111014},[],"permitir o bloquear claves ECDSA;",{"_3150":65507,"_27624":65474,"_19171":111016,"_5":13189,"_26134":110932,"_2648":111017},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3150":65508,"_27624":65474,"_19171":111019,"_5":13189,"_26134":110932,"_2648":111020},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3150":65509,"_27624":65474,"_19171":111022,"_5":13189,"_26134":110936,"_2648":111023},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3150":65510,"_27624":65474,"_19171":111025,"_5":13189,"_26134":110936,"_2648":106688},[],{"_3150":65511,"_27624":65474,"_19171":111027,"_5":13189,"_26134":110936,"_2648":111028},[],"Primera opción",{"_3150":65512,"_27624":65474,"_19171":111030,"_5":13189,"_26134":110936,"_2648":111031},[],"Segunda opción",{"_3150":65513,"_27624":65474,"_19171":111033,"_5":13189,"_26134":110936,"_2648":111034},[],"Si no hay ninguna",{"_3150":65514,"_27624":65474,"_19171":111036,"_5":13189,"_26134":110936,"_2648":111037},[],"Firma directa con una CA",{"_3150":65515,"_27624":65474,"_19171":111039,"_5":13189,"_26134":110936,"_2648":111040},[],"`issuance_profile` incluido en la solicitud",{"_3150":65516,"_27624":65474,"_19171":111042,"_5":13189,"_26134":110936,"_2648":111043},[],"`issuance_profile_id` de la solicitud",{"_3150":65517,"_27624":65474,"_19171":111045,"_5":13189,"_26134":110936,"_2648":111046},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3150":65518,"_27624":65474,"_19171":111048,"_5":13189,"_26134":110936,"_2648":111049},[],"Emisión mediante DMS",{"_3150":65519,"_27624":65474,"_19171":111051,"_5":13189,"_26134":110936,"_2648":50574},[],{"_3150":65520,"_27624":65474,"_19171":111053,"_5":13189,"_26134":110936,"_2648":111054},[],"`settings.issuance_profile` incluido en el DMS",{"_3150":65521,"_27624":65474,"_19171":111056,"_5":13189,"_26134":110936,"_2648":111057},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3150":65522,"_27624":65474,"_19171":111059,"_5":13189,"_26134":110936,"_2648":111060},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3150":65523,"_27624":65474,"_19171":111062,"_5":13189,"_26134":110936,"_2648":111063},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3150":65524,"_27624":65474,"_19171":111065,"_5":13189,"_26134":110944,"_2648":111066},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3150":65525,"_27624":65474,"_19171":111068,"_5":13189,"_26134":110948,"_2648":111069},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3150":65526,"_27624":65474,"_19171":111071,"_5":13189,"_26134":110952,"_2648":111072},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3150":65527,"_27624":65474,"_19171":111074,"_5":13189,"_26134":110956,"_2648":111075},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3150":65528,"_27624":65474,"_19171":111077,"_5":13189,"_26134":110960,"_2648":111078},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3150":65529,"_27624":65474,"_19171":111080,"_5":13189,"_26134":110960,"_2648":111081},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3150":65530,"_27624":65474,"_19171":111083,"_5":13189,"_26134":110964,"_2648":111084},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3150":65531,"_27624":65474,"_19171":111086,"_5":13189,"_26134":110964,"_2648":111087},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3150":65532,"_27624":65474,"_19171":111089,"_5":13189,"_26134":110964,"_2648":111090},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3150":65533,"_27624":65474,"_19171":111092,"_5":13189,"_26134":110964,"_2648":111093},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3150":65534,"_27624":65474,"_19171":111095,"_5":13189,"_26134":110968,"_2648":111096},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3150":65535,"_27624":65474,"_19171":111098,"_5":13189,"_26134":110968,"_2648":111099},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3150":65536,"_27624":65536,"_5":13515,"_2648":111101,"_27967":111102,"_19171":111104,"_26134":65536},"Validación de certificados",[44933,106897,50009,111103],"Validación",[],{"_3150":65537,"_27624":65536,"_19171":111106,"_5":13189,"_26134":65536,"_2648":111107},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3150":65538,"_27624":65536,"_5":27964,"_19171":111109,"_26134":111110,"_2648":111111},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3150":65539,"_27624":65536,"_5":27964,"_19171":111113,"_26134":111114,"_2648":111115},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3150":65540,"_27624":65536,"_5":27964,"_19171":111117,"_26134":111118,"_2648":111119},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3150":65541,"_27624":65536,"_19171":111121,"_5":13189,"_26134":65536,"_2648":111122},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3150":65542,"_27624":65536,"_19171":111124,"_5":13189,"_26134":111110,"_2648":111125},[],"Verifica estos criterios juntos:",{"_3150":65543,"_27624":65536,"_19171":111127,"_5":13189,"_26134":111110,"_2648":110115},[],{"_3150":65544,"_27624":65536,"_19171":111129,"_5":13189,"_26134":111110,"_2648":111130},[],"Resultado necesario",{"_3150":65545,"_27624":65536,"_19171":111132,"_5":13189,"_26134":111110,"_2648":111133},[],"Cadena y firma",{"_3150":65546,"_27624":65536,"_19171":111135,"_5":13189,"_26134":111110,"_2648":111136},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3150":65547,"_27624":65536,"_19171":111138,"_5":13189,"_26134":111110,"_2648":111139},[],"Fechas",{"_3150":65548,"_27624":65536,"_19171":111141,"_5":13189,"_26134":111110,"_2648":111142},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3150":65549,"_27624":65536,"_19171":111144,"_5":13189,"_26134":111110,"_2648":106598},[],{"_3150":65550,"_27624":65536,"_19171":111146,"_5":13189,"_26134":111110,"_2648":111147},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3150":65551,"_27624":65536,"_19171":111149,"_5":13189,"_26134":111110,"_2648":111150},[],"Uso",{"_3150":65552,"_27624":65536,"_19171":111152,"_5":13189,"_26134":111110,"_2648":111153},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3150":65553,"_27624":65536,"_19171":111155,"_5":13189,"_26134":111110,"_2648":111156},[],"Revocación",{"_3150":65554,"_27624":65536,"_19171":111158,"_5":13189,"_26134":111110,"_2648":111159},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3150":65555,"_27624":65536,"_19171":111161,"_5":13189,"_26134":111110,"_2648":111162},[],"Autorización",{"_3150":65556,"_27624":65536,"_19171":111164,"_5":13189,"_26134":111110,"_2648":111165},[],"La aplicación permite la acción a esa identidad.",{"_3150":65557,"_27624":65536,"_19171":111167,"_5":13189,"_26134":111110,"_2648":111168},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3150":65558,"_27624":65536,"_19171":111170,"_5":13189,"_26134":111114,"_2648":111171},[],"Mecanismo",{"_3150":65559,"_27624":65536,"_19171":111173,"_5":13189,"_26134":111114,"_2648":111174},[],"Cuándo utilizarlo",{"_3150":65560,"_27624":65536,"_19171":111176,"_5":13189,"_26134":111114,"_2648":111177},[],"Qué debes mantener",{"_3150":65561,"_27624":65536,"_19171":111179,"_5":13189,"_26134":111114,"_2648":50702},[],{"_3150":65562,"_27624":65536,"_19171":111181,"_5":13189,"_26134":111114,"_2648":111182},[],"Consulta del estado de un certificado concreto.",{"_3150":65563,"_27624":65536,"_19171":111184,"_5":13189,"_26134":111114,"_2648":111185},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3150":65564,"_27624":65536,"_19171":111187,"_5":13189,"_26134":111114,"_2648":50711},[],{"_3150":65565,"_27624":65536,"_19171":111189,"_5":13189,"_26134":111114,"_2648":111190},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3150":65566,"_27624":65536,"_19171":111192,"_5":13189,"_26134":111114,"_2648":111193},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3150":65567,"_27624":65536,"_19171":111195,"_5":13189,"_26134":111114,"_2648":111196},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3150":65568,"_27624":65536,"_19171":111198,"_5":13189,"_26134":111114,"_2648":111199},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3150":65569,"_27624":65536,"_19171":111201,"_5":13189,"_26134":111118,"_2648":111202},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3150":65570,"_27624":65536,"_19171":111204,"_5":13189,"_26134":111118,"_2648":111205},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3150":65571,"_27624":65536,"_19171":111207,"_5":13189,"_26134":111118,"_2648":111208},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3150":65572,"_27624":65536,"_19171":111210,"_5":13189,"_26134":111118,"_2648":111211},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3150":65573,"_27624":65536,"_19171":111213,"_5":13189,"_26134":111118,"_2648":111214},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3150":65574,"_27624":65536,"_19171":111216,"_5":13189,"_26134":111118,"_2648":111217},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3150":65575,"_27624":65536,"_19171":111219,"_5":13189,"_26134":111118,"_2648":111220},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3150":65576,"_27624":65536,"_19171":111222,"_5":13189,"_26134":111118,"_2648":111223},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":65577,"_27624":65536,"_19171":111225,"_5":13189,"_26134":111118,"_2648":111226},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3150":65578,"_27624":65578,"_5":13515,"_2648":111228,"_27967":111229,"_19171":111230,"_26134":65578},"Certificados",[44933,106897,50009,110488],[],{"_3150":65579,"_27624":65578,"_19171":111232,"_5":13189,"_26134":65578,"_2648":111233},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3150":65580,"_27624":65578,"_5":27964,"_19171":111235,"_26134":111236,"_2648":111237},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3150":65581,"_27624":65578,"_5":27964,"_19171":111239,"_26134":111240,"_2648":111241},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3150":65582,"_27624":65578,"_5":27964,"_19171":111243,"_26134":111244,"_2648":111245},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3150":65583,"_27624":65578,"_5":27964,"_19171":111247,"_26134":111248,"_2648":111249},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3150":65584,"_27624":65578,"_5":27964,"_19171":111251,"_26134":111252,"_2648":111253},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3150":65585,"_27624":65578,"_5":27964,"_19171":111255,"_26134":111256,"_2648":111257},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3150":65586,"_27624":65578,"_5":27964,"_19171":111259,"_26134":111260,"_2648":111261},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3150":65587,"_27624":65578,"_5":27964,"_19171":111263,"_26134":111264,"_2648":111265},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3150":65588,"_27624":65578,"_5":27964,"_19171":111267,"_26134":111268,"_2648":111269},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#continúa","Continúa",{"_3150":65589,"_27624":65578,"_19171":111271,"_5":13189,"_26134":65578,"_2648":111272},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3150":65590,"_27624":65578,"_19171":111274,"_5":13189,"_26134":111236,"_2648":111275},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3150":65591,"_27624":65578,"_19171":111277,"_5":13189,"_26134":111236,"_2648":111278},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3150":65592,"_27624":65578,"_19171":111280,"_5":13189,"_26134":111240,"_2648":111281},[],"Descarga el PEM e inspecciónalo:",{"_3150":65593,"_27624":65578,"_19171":111283,"_5":13189,"_26134":111240,"_2648":111284},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3150":65594,"_27624":65578,"_19171":111286,"_5":13189,"_26134":111244,"_2648":111287},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3150":65595,"_27624":65578,"_19171":111289,"_5":13189,"_26134":111244,"_2648":111290},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3150":65596,"_27624":65578,"_19171":111292,"_5":13189,"_26134":111244,"_2648":111293},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3150":65597,"_27624":65578,"_19171":111295,"_5":13189,"_26134":111244,"_2648":111296},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3150":65598,"_27624":65578,"_19171":111298,"_5":13189,"_26134":111244,"_2648":111299},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3150":65599,"_27624":65578,"_19171":111301,"_5":13189,"_26134":111244,"_2648":111302},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3150":65600,"_27624":65578,"_19171":111304,"_5":13189,"_26134":111244,"_2648":111305},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3150":65601,"_27624":65578,"_19171":111307,"_5":13189,"_26134":111248,"_2648":111308},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3150":65602,"_27624":65578,"_19171":111310,"_5":13189,"_26134":111252,"_2648":111311},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3150":65603,"_27624":65578,"_19171":111313,"_5":13189,"_26134":111256,"_2648":111314},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3150":65604,"_27624":65578,"_19171":111316,"_5":13189,"_26134":111260,"_2648":111317},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3150":65605,"_27624":65578,"_19171":111319,"_5":13189,"_26134":111260,"_2648":111320},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3150":65606,"_27624":65578,"_19171":111322,"_5":13189,"_26134":111260,"_2648":111323},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3150":65607,"_27624":65578,"_19171":111325,"_5":13189,"_26134":111264,"_2648":111326},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3150":65608,"_27624":65578,"_19171":111328,"_5":13189,"_26134":111264,"_2648":111329},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3150":65609,"_27624":65578,"_19171":111331,"_5":13189,"_26134":111264,"_2648":111332},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3150":65610,"_27624":65578,"_19171":111334,"_5":13189,"_26134":111268,"_2648":111335},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":65611,"_27624":65578,"_19171":111337,"_5":13189,"_26134":111268,"_2648":111338},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3150":65612,"_27624":65612,"_5":13515,"_2648":111340,"_27967":111341,"_19171":111343,"_26134":65612},"Ciclo de vida de un certificado",[44933,106897,50009,111342],"Conceptos",[],{"_3150":65613,"_27624":65612,"_19171":111345,"_5":13189,"_26134":65612,"_2648":111346},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3150":65614,"_27624":65612,"_5":27964,"_19171":111348,"_26134":111349,"_2648":111350},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3150":65615,"_27624":65612,"_5":27964,"_19171":111352,"_26134":111353,"_2648":111354},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3150":65616,"_27624":65612,"_5":27964,"_19171":111356,"_26134":111357,"_2648":111358},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3150":65617,"_27624":65612,"_5":27964,"_19171":111360,"_26134":111361,"_2648":111362},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3150":65618,"_27624":65612,"_5":27964,"_19171":111364,"_26134":111365,"_2648":111366},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3150":65619,"_27624":65612,"_5":27964,"_19171":111368,"_26134":111369,"_2648":111370},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3150":65620,"_27624":65612,"_5":27964,"_19171":111372,"_26134":111373,"_2648":111374},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3150":65621,"_27624":65612,"_5":27964,"_19171":111376,"_26134":111377,"_2648":111378},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3150":65622,"_27624":65612,"_5":27964,"_19171":111380,"_26134":111381,"_2648":111382},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3150":65623,"_27624":65612,"_5":27964,"_19171":111384,"_26134":111385,"_2648":111386},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3150":65624,"_27624":65612,"_19171":111388,"_5":13189,"_26134":65612,"_2648":111389},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3150":65625,"_27624":65612,"_19171":111391,"_5":13189,"_26134":111353,"_2648":111392},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3150":65626,"_27624":65612,"_19171":111394,"_5":13189,"_26134":111357,"_2648":111395},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3150":65627,"_27624":65612,"_19171":111397,"_5":13189,"_26134":111361,"_2648":111398},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3150":65628,"_27624":65612,"_19171":111400,"_5":13189,"_26134":111365,"_2648":111401},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3150":65629,"_27624":65612,"_19171":111403,"_5":13189,"_26134":111369,"_2648":111404},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3150":65630,"_27624":65612,"_19171":111406,"_5":13189,"_26134":111373,"_2648":111407},[],"Lamassu persiste cuatro estados X.509:",{"_3150":65631,"_27624":65612,"_19171":111409,"_5":13189,"_26134":111373,"_2648":111410},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3150":65632,"_27624":65612,"_19171":111412,"_5":13189,"_26134":111373,"_2648":111413},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3150":65633,"_27624":65612,"_19171":111415,"_5":13189,"_26134":111373,"_2648":111416},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3150":65634,"_27624":65612,"_19171":111418,"_5":13189,"_26134":111373,"_2648":111419},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3150":65635,"_27624":65612,"_19171":111421,"_5":13189,"_26134":111373,"_2648":111422},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3150":65636,"_27624":65612,"_19171":111424,"_5":13189,"_26134":111377,"_2648":111425},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3150":65637,"_27624":65612,"_19171":111427,"_5":13189,"_26134":111377,"_2648":111428},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3150":65638,"_27624":65612,"_19171":111430,"_5":13189,"_26134":111377,"_2648":111431},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3150":65639,"_27624":65612,"_19171":111433,"_5":13189,"_26134":111381,"_2648":111434},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3150":65640,"_27624":65612,"_19171":111436,"_5":13189,"_26134":111381,"_2648":111437},[],"Antes de confirmar:",{"_3150":65641,"_27624":65612,"_19171":111439,"_5":13189,"_26134":111381,"_2648":111440},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3150":65642,"_27624":65612,"_19171":111442,"_5":13189,"_26134":111381,"_2648":111443},[],"Distribuye la nueva cadena de confianza.",{"_3150":65643,"_27624":65612,"_19171":111445,"_5":13189,"_26134":111381,"_2648":111446},[],"Reemite las identidades necesarias.",{"_3150":65644,"_27624":65612,"_19171":111448,"_5":13189,"_26134":111381,"_2648":111449},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3150":65645,"_27624":65612,"_19171":111451,"_5":13189,"_26134":111381,"_2648":111452},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3150":65646,"_27624":65612,"_19171":111454,"_5":13189,"_26134":111381,"_2648":111455},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3150":65647,"_27624":65612,"_19171":111457,"_5":13189,"_26134":111385,"_2648":111458},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3150":65648,"_27624":65612,"_19171":111460,"_5":13189,"_26134":111385,"_2648":111461},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3150":65649,"_27624":65612,"_19171":111463,"_5":13189,"_26134":111385,"_2648":111464},[],"Cambios de estado y razones de revocación.",{"_3150":65650,"_27624":65612,"_19171":111466,"_5":13189,"_26134":111385,"_2648":111467},[],"Publicación y vigencia de OCSP y CRLs.",{"_3150":65651,"_27624":65612,"_19171":111469,"_5":13189,"_26134":111385,"_2648":111470},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3150":65652,"_27624":65612,"_19171":111472,"_5":13189,"_26134":111385,"_2648":111473},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3150":65653,"_27624":65653,"_5":13515,"_2648":111475,"_27967":111476,"_19171":111477,"_26134":65653},"Modelo de confianza",[44933,106897,50009,111342],[],{"_3150":65654,"_27624":65653,"_19171":111479,"_5":13189,"_26134":65653,"_2648":111480},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3150":65655,"_27624":65653,"_5":27964,"_19171":111482,"_26134":111483,"_2648":111484},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3150":65656,"_27624":65653,"_5":27964,"_19171":111486,"_26134":111487,"_2648":111488},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3150":65657,"_27624":65653,"_5":27964,"_19171":111490,"_26134":111491,"_2648":111492},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3150":65658,"_27624":65653,"_5":27964,"_19171":111494,"_26134":111495,"_2648":111496},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3150":65659,"_27624":65653,"_5":27964,"_19171":111498,"_26134":111499,"_2648":111500},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3150":65660,"_27624":65653,"_5":27964,"_19171":111502,"_26134":111503,"_2648":111504},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3150":65661,"_27624":65653,"_5":27964,"_19171":111506,"_26134":111507,"_2648":111508},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3150":65662,"_27624":65653,"_5":27964,"_19171":111510,"_26134":111511,"_2648":111512},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3150":65663,"_27624":65653,"_5":27964,"_19171":111514,"_26134":111515,"_2648":111516},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3150":65664,"_27624":65653,"_5":27964,"_19171":111518,"_26134":111519,"_2648":111520},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3150":65665,"_27624":65653,"_19171":111522,"_5":13189,"_26134":65653,"_2648":111523},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3150":65666,"_27624":65653,"_19171":111525,"_5":13189,"_26134":111487,"_2648":111526},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3150":65667,"_27624":65653,"_19171":111528,"_5":13189,"_26134":111491,"_2648":111529},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3150":65668,"_27624":65653,"_19171":111531,"_5":13189,"_26134":111495,"_2648":111532},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3150":65669,"_27624":65653,"_19171":111534,"_5":13189,"_26134":111499,"_2648":111535},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3150":65670,"_27624":65653,"_19171":111537,"_5":13189,"_26134":111503,"_2648":111538},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3150":65671,"_27624":65653,"_19171":111540,"_5":13189,"_26134":111503,"_2648":111541},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3150":65672,"_27624":65653,"_19171":111543,"_5":13189,"_26134":111503,"_2648":111544},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3150":65673,"_27624":65653,"_19171":111546,"_5":13189,"_26134":111503,"_2648":111547},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3150":65674,"_27624":65653,"_19171":111549,"_5":13189,"_26134":111503,"_2648":111550},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3150":65675,"_27624":65653,"_19171":111552,"_5":13189,"_26134":111503,"_2648":111553},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3150":65676,"_27624":65653,"_19171":111555,"_5":13189,"_26134":111507,"_2648":111556},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3150":65677,"_27624":65653,"_19171":111558,"_5":13189,"_26134":111507,"_2648":111559},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3150":65678,"_27624":65653,"_19171":111561,"_5":13189,"_26134":111507,"_2648":111562},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_3150":65679,"_27624":65653,"_19171":111564,"_5":13189,"_26134":111507,"_2648":111565},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3150":65680,"_27624":65653,"_19171":111567,"_5":13189,"_26134":111507,"_2648":111568},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3150":65681,"_27624":65653,"_19171":111570,"_5":13189,"_26134":111511,"_2648":111571},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3150":65682,"_27624":65653,"_19171":111573,"_5":13189,"_26134":111511,"_2648":111574},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3150":65683,"_27624":65653,"_19171":111576,"_5":13189,"_26134":111511,"_2648":111577},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3150":65684,"_27624":65653,"_19171":111579,"_5":13189,"_26134":111511,"_2648":111580},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3150":65685,"_27624":65653,"_19171":111582,"_5":13189,"_26134":111511,"_2648":111583},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3150":65686,"_27624":65653,"_19171":111585,"_5":13189,"_26134":111511,"_2648":111586},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3150":65687,"_27624":65653,"_19171":111588,"_5":13189,"_26134":111511,"_2648":111589},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3150":65688,"_27624":65653,"_19171":111591,"_5":13189,"_26134":111515,"_2648":111592},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3150":65689,"_27624":65653,"_19171":111594,"_5":13189,"_26134":111519,"_2648":111595},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3150":65690,"_27624":65653,"_19171":111597,"_5":13189,"_26134":111519,"_2648":111598},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3150":65691,"_27624":65653,"_19171":111600,"_5":13189,"_26134":111519,"_2648":111601},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3150":65692,"_27624":65653,"_19171":111603,"_5":13189,"_26134":111519,"_2648":111604},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3150":65693,"_27624":65653,"_19171":111606,"_5":13189,"_26134":111519,"_2648":111607},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3150":65694,"_27624":65653,"_19171":111609,"_5":13189,"_26134":111519,"_2648":111610},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3150":65695,"_27624":65653,"_19171":111612,"_5":13189,"_26134":111519,"_2648":111613},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3150":65696,"_27624":65696,"_5":13515,"_2648":111615,"_27967":111616,"_19171":111617,"_26134":65696},"Listas de revocación (CRL)",[44933,106897,50009,111103],[],{"_3150":65697,"_27624":65696,"_19171":111619,"_5":13189,"_26134":65696,"_2648":111620},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3150":65698,"_27624":65696,"_5":27964,"_19171":111622,"_26134":111623,"_2648":111624},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3150":65699,"_27624":65696,"_5":27964,"_19171":111626,"_26134":111627,"_2648":111628},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3150":65700,"_27624":65696,"_5":27964,"_19171":111630,"_26134":111631,"_2648":111632},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3150":65701,"_27624":65696,"_5":27964,"_19171":111634,"_26134":111635,"_2648":111636},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3150":65702,"_27624":65696,"_5":27964,"_19171":111638,"_26134":111639,"_2648":111640},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3150":65703,"_27624":65696,"_5":27964,"_19171":111642,"_26134":111643,"_2648":111644},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3150":65704,"_27624":65696,"_5":27964,"_19171":111646,"_26134":111647,"_2648":111648},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#referencias","Referencias",{"_3150":65705,"_27624":65696,"_19171":111650,"_5":13189,"_26134":65696,"_2648":111651},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3150":65706,"_27624":65696,"_19171":111653,"_5":13189,"_26134":111623,"_2648":111654},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3150":65707,"_27624":65696,"_19171":111656,"_5":13189,"_26134":111623,"_2648":111657},[],"Campo de `crl_options`",{"_3150":65708,"_27624":65696,"_19171":111659,"_5":13189,"_26134":111623,"_2648":108396},[],{"_3150":65709,"_27624":65696,"_19171":111661,"_5":13189,"_26134":111623,"_2648":111662},[],"Valor inicial del backend",{"_3150":65710,"_27624":65696,"_19171":111664,"_5":13189,"_26134":111623,"_2648":51189},[],{"_3150":65711,"_27624":65696,"_19171":111666,"_5":13189,"_26134":111623,"_2648":111667},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3150":65712,"_27624":65696,"_19171":111669,"_5":13189,"_26134":111623,"_2648":111670},[],"7 días.",{"_3150":65713,"_27624":65696,"_19171":111672,"_5":13189,"_26134":111623,"_2648":51198},[],{"_3150":65714,"_27624":65696,"_19171":111674,"_5":13189,"_26134":111623,"_2648":111675},[],"Plazo desde la publicación que activa la renovación programada.",{"_3150":65715,"_27624":65696,"_19171":111677,"_5":13189,"_26134":111623,"_2648":111678},[],"6 días y 23 horas.",{"_3150":65716,"_27624":65696,"_19171":111680,"_5":13189,"_26134":111623,"_2648":51207},[],{"_3150":65717,"_27624":65696,"_19171":111682,"_5":13189,"_26134":111623,"_2648":111683},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3150":65718,"_27624":65696,"_19171":111685,"_5":13189,"_26134":111623,"_2648":51213},[],{"_3150":65719,"_27624":65696,"_19171":111687,"_5":13189,"_26134":111623,"_2648":51216},[],{"_3150":65720,"_27624":65696,"_19171":111689,"_5":13189,"_26134":111623,"_2648":111690},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3150":65721,"_27624":65696,"_19171":111692,"_5":13189,"_26134":111623,"_2648":111693},[],"SKI de la CA.",{"_3150":65722,"_27624":65696,"_19171":111695,"_5":13189,"_26134":111623,"_2648":111696},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3150":65723,"_27624":65696,"_19171":111698,"_5":13189,"_26134":111623,"_2648":111699},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3150":65724,"_27624":65696,"_19171":111701,"_5":13189,"_26134":111627,"_2648":111702},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3150":65725,"_27624":65696,"_19171":111704,"_5":13189,"_26134":111627,"_2648":111705},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3150":65726,"_27624":65696,"_19171":111707,"_5":13189,"_26134":111627,"_2648":111708},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3150":65727,"_27624":65696,"_19171":111710,"_5":13189,"_26134":111631,"_2648":111711},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3150":65728,"_27624":65696,"_19171":111713,"_5":13189,"_26134":111631,"_2648":111714},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3150":65729,"_27624":65696,"_19171":111716,"_5":13189,"_26134":111635,"_2648":111717},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3150":65730,"_27624":65696,"_19171":111719,"_5":13189,"_26134":111635,"_2648":111720},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3150":65731,"_27624":65696,"_19171":111722,"_5":13189,"_26134":111635,"_2648":111723},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3150":65732,"_27624":65696,"_19171":111725,"_5":13189,"_26134":111635,"_2648":111726},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3150":65733,"_27624":65696,"_19171":111728,"_5":13189,"_26134":111635,"_2648":111729},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3150":65734,"_27624":65696,"_19171":111731,"_5":13189,"_26134":111639,"_2648":111732},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3150":65735,"_27624":65696,"_19171":111734,"_5":13189,"_26134":111639,"_2648":108585},[],{"_3150":65736,"_27624":65696,"_19171":111736,"_5":13189,"_26134":111639,"_2648":111737},[],"Path relativo",{"_3150":65737,"_27624":65696,"_19171":111739,"_5":13189,"_26134":111639,"_2648":106688},[],{"_3150":65738,"_27624":65696,"_19171":111741,"_5":13189,"_26134":111639,"_2648":51271},[],{"_3150":65739,"_27624":65696,"_19171":111743,"_5":13189,"_26134":111639,"_2648":51274},[],{"_3150":65740,"_27624":65696,"_19171":111745,"_5":13189,"_26134":111639,"_2648":111746},[],"Consultar `crl_options` y `latest_crl`.",{"_3150":65741,"_27624":65696,"_19171":111748,"_5":13189,"_26134":111639,"_2648":51280},[],{"_3150":65742,"_27624":65696,"_19171":111750,"_5":13189,"_26134":111639,"_2648":51274},[],{"_3150":65743,"_27624":65696,"_19171":111752,"_5":13189,"_26134":111639,"_2648":111753},[],"Sustituir la configuración de CRL.",{"_3150":65744,"_27624":65696,"_19171":111755,"_5":13189,"_26134":111639,"_2648":111756},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3150":65745,"_27624":65696,"_19171":111758,"_5":13189,"_26134":111639,"_2648":111759},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3150":65746,"_27624":65696,"_19171":111761,"_5":13189,"_26134":111643,"_2648":111762},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3150":65747,"_27624":65696,"_19171":111764,"_5":13189,"_26134":111647,"_2648":111765},[],"RFC 5280: perfil X.509 y CRL.",{"_3150":65748,"_27624":65696,"_19171":111767,"_5":13189,"_26134":111647,"_2648":51300},[],{"_3150":65749,"_27624":65696,"_19171":111769,"_5":13189,"_26134":111647,"_2648":51303},[],{"_3150":65750,"_27624":65696,"_19171":111771,"_5":13189,"_26134":111647,"_2648":111772},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":65751,"_27624":65696,"_19171":111774,"_5":13189,"_26134":111647,"_2648":111775},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3150":65752,"_27624":65752,"_5":13515,"_2648":111777,"_27967":111778,"_19171":111779,"_26134":65752},"Claves y motores criptográficos",[44933,106897,50009,110488],[],{"_3150":65753,"_27624":65752,"_19171":111781,"_5":13189,"_26134":65752,"_2648":111782},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3150":65754,"_27624":65752,"_5":27964,"_19171":111784,"_26134":111785,"_2648":111786},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3150":65755,"_27624":65752,"_5":27964,"_19171":111788,"_26134":111789,"_2648":111790},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3150":65756,"_27624":65752,"_5":27964,"_19171":111792,"_26134":111793,"_2648":51328},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#file-system",{"_3150":65757,"_27624":65752,"_5":27964,"_19171":111795,"_26134":111796,"_2648":51332},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#hashicorp-vault",{"_3150":65758,"_27624":65752,"_5":27964,"_19171":111798,"_26134":111799,"_2648":51336},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#aws-secrets-manager",{"_3150":65759,"_27624":65752,"_5":27964,"_19171":111801,"_26134":111802,"_2648":51340},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#aws-kms",{"_3150":65760,"_27624":65752,"_5":27964,"_19171":111804,"_26134":111805,"_2648":51344},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#pkcs11",{"_3150":65761,"_27624":65752,"_5":27964,"_19171":111807,"_26134":111808,"_2648":51348},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#azure-key-vault",{"_3150":65762,"_27624":65752,"_5":27964,"_19171":111810,"_26134":111811,"_2648":111812},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3150":65763,"_27624":65752,"_5":27964,"_19171":111814,"_26134":111815,"_2648":111816},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3150":65764,"_27624":65752,"_5":27964,"_19171":111818,"_26134":111819,"_2648":111820},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3150":65765,"_27624":65752,"_5":27964,"_19171":111822,"_26134":111823,"_2648":111824},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3150":65766,"_27624":65752,"_5":27964,"_19171":111826,"_26134":111827,"_2648":111828},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3150":65767,"_27624":65752,"_5":27964,"_19171":111830,"_26134":111831,"_2648":111832},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3150":65768,"_27624":65752,"_5":27964,"_19171":111834,"_26134":111835,"_2648":111836},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3150":65769,"_27624":65752,"_5":27964,"_19171":111838,"_26134":111839,"_2648":51380},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#sign",{"_3150":65770,"_27624":65752,"_5":27964,"_19171":111841,"_26134":111842,"_2648":51384},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#verify",{"_3150":65771,"_27624":65752,"_5":27964,"_19171":111844,"_26134":111845,"_2648":111846},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3150":65772,"_27624":65752,"_5":27964,"_19171":111848,"_26134":111849,"_2648":111850},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3150":65773,"_27624":65752,"_5":27964,"_19171":111852,"_26134":111853,"_2648":111854},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3150":65774,"_27624":65752,"_19171":111856,"_5":13189,"_26134":65752,"_2648":111857},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3150":65775,"_27624":65752,"_19171":111859,"_5":13189,"_26134":65752,"_2648":111860},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3150":65776,"_27624":65752,"_19171":111862,"_5":13189,"_26134":111785,"_2648":111863},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3150":65777,"_27624":65752,"_19171":111865,"_5":13189,"_26134":111785,"_2648":111866},[],"En la práctica, permite:",{"_3150":65778,"_27624":65752,"_19171":111868,"_5":13189,"_26134":111785,"_2648":111869},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3150":65779,"_27624":65752,"_19171":111871,"_5":13189,"_26134":111785,"_2648":111872},[],"Importar claves creadas externamente.",{"_3150":65780,"_27624":65752,"_19171":111874,"_5":13189,"_26134":111785,"_2648":111875},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3150":65781,"_27624":65752,"_19171":111877,"_5":13189,"_26134":111785,"_2648":111878},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3150":65782,"_27624":65752,"_19171":111880,"_5":13189,"_26134":111789,"_2648":111881},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3150":65783,"_27624":65752,"_19171":111883,"_5":13189,"_26134":111789,"_2648":111884},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3150":65784,"_27624":65752,"_19171":111886,"_5":13189,"_26134":111789,"_2648":111887},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3150":65785,"_27624":65752,"_19171":111889,"_5":13189,"_26134":111793,"_2648":111890},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3150":65786,"_27624":65752,"_19171":111892,"_5":13189,"_26134":111796,"_2648":111893},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3150":65787,"_27624":65752,"_19171":111895,"_5":13189,"_26134":111799,"_2648":111896},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3150":65788,"_27624":65752,"_19171":111898,"_5":13189,"_26134":111802,"_2648":111899},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3150":65789,"_27624":65752,"_19171":111901,"_5":13189,"_26134":111805,"_2648":111902},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3150":65790,"_27624":65752,"_19171":111904,"_5":13189,"_26134":111808,"_2648":111905},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3150":65791,"_27624":65752,"_19171":111907,"_5":13189,"_26134":111808,"_2648":111908},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3150":65792,"_27624":65752,"_19171":111910,"_5":13189,"_26134":111808,"_2648":111911},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3150":65793,"_27624":65752,"_19171":111913,"_5":13189,"_26134":111808,"_2648":111914},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3150":65794,"_27624":65752,"_19171":111916,"_5":13189,"_26134":111811,"_2648":111917},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3150":65795,"_27624":65752,"_19171":111919,"_5":13189,"_26134":111811,"_2648":111920},[],"La tabla incluye los siguientes campos:",{"_3150":65796,"_27624":65752,"_19171":111922,"_5":13189,"_26134":111811,"_2648":111923},[],"**Name**: nombre descriptivo de la clave.",{"_3150":65797,"_27624":65752,"_19171":111925,"_5":13189,"_26134":111811,"_2648":111926},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3150":65798,"_27624":65752,"_19171":111928,"_5":13189,"_26134":111811,"_2648":111929},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3150":65799,"_27624":65752,"_19171":111931,"_5":13189,"_26134":111811,"_2648":111932},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3150":65800,"_27624":65752,"_19171":111934,"_5":13189,"_26134":111811,"_2648":111935},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3150":65801,"_27624":65752,"_19171":111937,"_5":13189,"_26134":111811,"_2648":111938},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3150":65802,"_27624":65752,"_19171":111940,"_5":13189,"_26134":111811,"_2648":111941},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3150":65803,"_27624":65752,"_19171":111943,"_5":13189,"_26134":111811,"_2648":111944},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3150":65804,"_27624":65752,"_19171":111946,"_5":13189,"_26134":111811,"_2648":111947},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3150":65805,"_27624":65752,"_19171":111949,"_5":13189,"_26134":111811,"_2648":111950},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3150":65806,"_27624":65752,"_19171":111952,"_5":13189,"_26134":111811,"_2648":111953},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3150":65807,"_27624":65752,"_19171":111955,"_5":13189,"_26134":111811,"_2648":111956},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3150":65808,"_27624":65752,"_19171":111958,"_5":13189,"_26134":111811,"_2648":111959},[],"**Delete Key** para eliminar la clave del sistema.",{"_3150":65809,"_27624":65752,"_19171":111961,"_5":13189,"_26134":111815,"_2648":111962},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3150":65810,"_27624":65752,"_19171":111964,"_5":13189,"_26134":111819,"_2648":111965},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3150":65811,"_27624":65752,"_19171":111967,"_5":13189,"_26134":111819,"_2648":111968},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3150":65812,"_27624":65752,"_19171":111970,"_5":13189,"_26134":111819,"_2648":111971},[],"**Key Name**: nombre único y descriptivo.",{"_3150":65813,"_27624":65752,"_19171":111973,"_5":13189,"_26134":111819,"_2648":111974},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3150":65814,"_27624":65752,"_19171":111976,"_5":13189,"_26134":111819,"_2648":111977},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3150":65815,"_27624":65752,"_19171":111979,"_5":13189,"_26134":111819,"_2648":111980},[],"**Tags**: metadatos para clasificar la clave.",{"_3150":65816,"_27624":65752,"_19171":111982,"_5":13189,"_26134":111819,"_2648":111983},[],"**Metadata**: información adicional para usos avanzados.",{"_3150":65817,"_27624":65752,"_19171":111985,"_5":13189,"_26134":111823,"_2648":111986},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3150":65818,"_27624":65752,"_19171":111988,"_5":13189,"_26134":111823,"_2648":111989},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3150":65819,"_27624":65752,"_19171":111991,"_5":13189,"_26134":111823,"_2648":111992},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3150":65820,"_27624":65752,"_19171":111994,"_5":13189,"_26134":111823,"_2648":111995},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3150":65821,"_27624":65752,"_19171":111997,"_5":13189,"_26134":111823,"_2648":111998},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3150":65822,"_27624":65752,"_19171":112000,"_5":13189,"_26134":111823,"_2648":112001},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3150":65823,"_27624":65752,"_19171":112003,"_5":13189,"_26134":111823,"_2648":112004},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3150":65824,"_27624":65752,"_19171":112006,"_5":13189,"_26134":111823,"_2648":112007},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3150":65825,"_27624":65752,"_19171":112009,"_5":13189,"_26134":111823,"_2648":112010},[],"**Metadata**: información adicional opcional.",{"_3150":65826,"_27624":65752,"_19171":112012,"_5":13189,"_26134":111823,"_2648":112013},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3150":65827,"_27624":65752,"_19171":112015,"_5":13189,"_26134":111823,"_2648":112016},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3150":65828,"_27624":65752,"_19171":112018,"_5":13189,"_26134":111827,"_2648":112019},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3150":65829,"_27624":65752,"_19171":112021,"_5":13189,"_26134":111831,"_2648":112022},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3150":65830,"_27624":65752,"_19171":112024,"_5":13189,"_26134":111831,"_2648":112025},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3150":65831,"_27624":65752,"_19171":112027,"_5":13189,"_26134":111831,"_2648":112028},[],"**Key Name**: nombre descriptivo.",{"_3150":65832,"_27624":65752,"_19171":112030,"_5":13189,"_26134":111831,"_2648":112031},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3150":65833,"_27624":65752,"_19171":112033,"_5":13189,"_26134":111831,"_2648":112034},[],"**Tags**: etiquetas asociadas.",{"_3150":65834,"_27624":65752,"_19171":112036,"_5":13189,"_26134":111831,"_2648":112037},[],"**Aliases**: nombres alternativos.",{"_3150":65835,"_27624":65752,"_19171":112039,"_5":13189,"_26134":111831,"_2648":112040},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3150":65836,"_27624":65752,"_19171":112042,"_5":13189,"_26134":111831,"_2648":112043},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3150":65837,"_27624":65752,"_19171":112045,"_5":13189,"_26134":111831,"_2648":112046},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3150":65838,"_27624":65752,"_19171":112048,"_5":13189,"_26134":111831,"_2648":112049},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3150":65839,"_27624":65752,"_19171":112051,"_5":13189,"_26134":111835,"_2648":112052},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3150":65840,"_27624":65752,"_19171":112054,"_5":13189,"_26134":111835,"_2648":112055},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3150":65841,"_27624":65752,"_19171":112057,"_5":13189,"_26134":111835,"_2648":112058},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3150":65842,"_27624":65752,"_19171":112060,"_5":13189,"_26134":111839,"_2648":112061},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3150":65843,"_27624":65752,"_19171":112063,"_5":13189,"_26134":111839,"_2648":112064},[],"Campos principales:",{"_3150":65844,"_27624":65752,"_19171":112066,"_5":13189,"_26134":111839,"_2648":112067},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3150":65845,"_27624":65752,"_19171":112069,"_5":13189,"_26134":111839,"_2648":112070},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3150":65846,"_27624":65752,"_19171":112072,"_5":13189,"_26134":111839,"_2648":112073},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3150":65847,"_27624":65752,"_19171":112075,"_5":13189,"_26134":111839,"_2648":112076},[],"**Message**: contenido que se va a firmar.",{"_3150":65848,"_27624":65752,"_19171":112078,"_5":13189,"_26134":111839,"_2648":112079},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3150":65849,"_27624":65752,"_19171":112081,"_5":13189,"_26134":111842,"_2648":112082},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3150":65850,"_27624":65752,"_19171":112084,"_5":13189,"_26134":111842,"_2648":112064},[],{"_3150":65851,"_27624":65752,"_19171":112086,"_5":13189,"_26134":111842,"_2648":112087},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3150":65852,"_27624":65752,"_19171":112089,"_5":13189,"_26134":111842,"_2648":112090},[],"**Message Type**: `Raw` o `Digest`.",{"_3150":65853,"_27624":65752,"_19171":112092,"_5":13189,"_26134":111842,"_2648":112093},[],"**Payload Encoding**: codificación del mensaje.",{"_3150":65854,"_27624":65752,"_19171":112095,"_5":13189,"_26134":111842,"_2648":112096},[],"**Message**: mensaje original o hash.",{"_3150":65855,"_27624":65752,"_19171":112098,"_5":13189,"_26134":111842,"_2648":112099},[],"**Signature**: firma que se desea comprobar.",{"_3150":65856,"_27624":65752,"_19171":112101,"_5":13189,"_26134":111842,"_2648":112102},[],"**Result**: indicador del resultado de la validación.",{"_3150":65857,"_27624":65752,"_19171":112104,"_5":13189,"_26134":111845,"_2648":112105},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3150":65858,"_27624":65752,"_19171":112107,"_5":13189,"_26134":111845,"_2648":112108},[],"Este flujo es útil para:",{"_3150":65859,"_27624":65752,"_19171":112110,"_5":13189,"_26134":111845,"_2648":112111},[],"Solicitar certificados a una CA externa.",{"_3150":65860,"_27624":65752,"_19171":112113,"_5":13189,"_26134":111845,"_2648":112114},[],"Renovar una identidad manteniendo la misma clave.",{"_3150":65861,"_27624":65752,"_19171":112116,"_5":13189,"_26134":111845,"_2648":112117},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3150":65862,"_27624":65752,"_19171":112119,"_5":13189,"_26134":111845,"_2648":112120},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3150":65863,"_27624":65752,"_19171":112122,"_5":13189,"_26134":111845,"_2648":112123},[],"**Organization (O)**: organización o empresa.",{"_3150":65864,"_27624":65752,"_19171":112125,"_5":13189,"_26134":111845,"_2648":112126},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3150":65865,"_27624":65752,"_19171":112128,"_5":13189,"_26134":111845,"_2648":112129},[],"**Country (C)**: código de país de dos letras.",{"_3150":65866,"_27624":65752,"_19171":112131,"_5":13189,"_26134":111845,"_2648":112132},[],"**State / Province (ST)**: estado o provincia.",{"_3150":65867,"_27624":65752,"_19171":112134,"_5":13189,"_26134":111845,"_2648":112135},[],"**Locality (L)**: ciudad o localidad.",{"_3150":65868,"_27624":65752,"_19171":112137,"_5":13189,"_26134":111845,"_2648":112138},[],"**Email Address**: correo de contacto.",{"_3150":65869,"_27624":65752,"_19171":112140,"_5":13189,"_26134":111845,"_2648":112141},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3150":65870,"_27624":65752,"_19171":112143,"_5":13189,"_26134":111845,"_2648":112144},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3150":65871,"_27624":65752,"_19171":112146,"_5":13189,"_26134":111849,"_2648":112147},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3150":65872,"_27624":65752,"_19171":112149,"_5":13189,"_26134":111849,"_2648":51692},[],{"_3150":65873,"_27624":65752,"_19171":112151,"_5":13189,"_26134":111853,"_2648":112152},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3150":65874,"_27624":65874,"_5":13515,"_2648":112154,"_27967":112155,"_19171":112156,"_26134":65874},"Validación online con OCSP",[44933,106897,50009,111103],[],{"_3150":65875,"_27624":65874,"_19171":112158,"_5":13189,"_26134":65874,"_2648":112159},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3150":65876,"_27624":65874,"_5":27964,"_19171":112161,"_26134":112162,"_2648":112163},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3150":65877,"_27624":65874,"_5":27964,"_19171":112165,"_26134":112166,"_2648":112167},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3150":65878,"_27624":65874,"_5":27964,"_19171":112169,"_26134":112170,"_2648":112171},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3150":65879,"_27624":65874,"_5":27964,"_19171":112173,"_26134":112174,"_2648":112175},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3150":65880,"_27624":65874,"_5":27964,"_19171":112177,"_26134":112178,"_2648":112179},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3150":65881,"_27624":65874,"_5":27964,"_19171":112181,"_26134":112182,"_2648":111648},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#referencias",{"_3150":65882,"_27624":65874,"_19171":112184,"_5":13189,"_26134":65874,"_2648":112185},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3150":65883,"_27624":65874,"_19171":112187,"_5":13189,"_26134":112162,"_2648":112188},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3150":65884,"_27624":65874,"_19171":112190,"_5":13189,"_26134":112162,"_2648":112191},[],"Estado del registro",{"_3150":65885,"_27624":65874,"_19171":112193,"_5":13189,"_26134":112162,"_2648":112194},[],"Respuesta firmada",{"_3150":65886,"_27624":65874,"_19171":112196,"_5":13189,"_26134":112162,"_2648":49187},[],{"_3150":65887,"_27624":65874,"_19171":112198,"_5":13189,"_26134":112162,"_2648":51742},[],{"_3150":65888,"_27624":65874,"_19171":112200,"_5":13189,"_26134":112162,"_2648":49204},[],{"_3150":65889,"_27624":65874,"_19171":112202,"_5":13189,"_26134":112162,"_2648":112203},[],"`Revoked`, con razón y fecha de revocación.",{"_3150":65890,"_27624":65874,"_19171":112205,"_5":13189,"_26134":112162,"_2648":112206},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3150":65891,"_27624":65874,"_19171":112208,"_5":13189,"_26134":112162,"_2648":112209},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3150":65892,"_27624":65874,"_19171":112211,"_5":13189,"_26134":112162,"_2648":112212},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3150":65893,"_27624":65874,"_19171":112214,"_5":13189,"_26134":112162,"_2648":112215},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3150":65894,"_27624":65874,"_19171":112217,"_5":13189,"_26134":112162,"_2648":112218},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3150":65895,"_27624":65874,"_19171":112220,"_5":13189,"_26134":112166,"_2648":112221},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3150":65896,"_27624":65874,"_19171":112223,"_5":13189,"_26134":112166,"_2648":112224},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3150":65897,"_27624":65874,"_19171":112226,"_5":13189,"_26134":112170,"_2648":112227},[],"El servicio acepta:",{"_3150":65898,"_27624":65874,"_19171":112229,"_5":13189,"_26134":112170,"_2648":108585},[],{"_3150":65899,"_27624":65874,"_19171":112231,"_5":13189,"_26134":112170,"_2648":112232},[],"Ruta del servicio VA",{"_3150":65900,"_27624":65874,"_19171":112234,"_5":13189,"_26134":112170,"_2648":112235},[],"Formato",{"_3150":65901,"_27624":65874,"_19171":112237,"_5":13189,"_26134":112170,"_2648":51782},[],{"_3150":65902,"_27624":65874,"_19171":112239,"_5":13189,"_26134":112170,"_2648":51785},[],{"_3150":65903,"_27624":65874,"_19171":112241,"_5":13189,"_26134":112170,"_2648":112242},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3150":65904,"_27624":65874,"_19171":112244,"_5":13189,"_26134":112170,"_2648":51271},[],{"_3150":65905,"_27624":65874,"_19171":112246,"_5":13189,"_26134":112170,"_2648":51793},[],{"_3150":65906,"_27624":65874,"_19171":112248,"_5":13189,"_26134":112170,"_2648":112249},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3150":65907,"_27624":65874,"_19171":112251,"_5":13189,"_26134":112170,"_2648":112252},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3150":65908,"_27624":65874,"_19171":112254,"_5":13189,"_26134":112174,"_2648":112255},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3150":65909,"_27624":65874,"_19171":112257,"_5":13189,"_26134":112174,"_2648":112258},[],"Genera la solicitud:",{"_3150":65910,"_27624":65874,"_19171":112260,"_5":13189,"_26134":112174,"_2648":112261},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3150":65911,"_27624":65874,"_19171":112263,"_5":13189,"_26134":112174,"_2648":112264},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3150":65912,"_27624":65874,"_19171":112266,"_5":13189,"_26134":112174,"_2648":112267},[],"Verifica el DER recibido:",{"_3150":65913,"_27624":65874,"_19171":112269,"_5":13189,"_26134":112174,"_2648":112270},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3150":65914,"_27624":65874,"_19171":112272,"_5":13189,"_26134":112178,"_2648":112273},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3150":65915,"_27624":65874,"_19171":112275,"_5":13189,"_26134":112178,"_2648":112276},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3150":65916,"_27624":65874,"_19171":112278,"_5":13189,"_26134":112182,"_2648":51826},[],{"_3150":65917,"_27624":65874,"_19171":112280,"_5":13189,"_26134":112182,"_2648":51829},[],{"_3150":65918,"_27624":65874,"_19171":112282,"_5":13189,"_26134":112182,"_2648":112283},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3150":65919,"_27624":65874,"_19171":112285,"_5":13189,"_26134":112182,"_2648":111775},[],{"_3150":65920,"_27624":65920,"_5":13515,"_2648":50009,"_27967":112287,"_19171":112288,"_26134":65920},[44933,106897,50009],[],{"_3150":65921,"_27624":65920,"_19171":112290,"_5":13189,"_26134":65920,"_2648":112291},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3150":65922,"_27624":65920,"_5":27964,"_19171":112293,"_26134":112294,"_2648":109812},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#empieza-aquí",{"_3150":65923,"_27624":65920,"_5":27964,"_19171":112296,"_26134":112297,"_2648":112298},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3150":65924,"_27624":65920,"_5":27964,"_19171":112300,"_26134":112301,"_2648":110334},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#capacidades-principales",{"_3150":65925,"_27624":65920,"_5":27964,"_19171":112303,"_26134":112304,"_2648":110338},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3150":65926,"_27624":65920,"_5":27964,"_19171":112306,"_26134":112307,"_2648":110342},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3150":65927,"_27624":65920,"_5":27964,"_19171":112309,"_26134":112310,"_2648":110346},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#emite-y-controla-certificados",{"_3150":65928,"_27624":65920,"_5":27964,"_19171":112312,"_26134":112313,"_2648":110354},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#publica-el-estado-de-validación",{"_3150":65929,"_27624":65920,"_5":27964,"_19171":112315,"_26134":112316,"_2648":112317},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3150":65930,"_27624":65920,"_5":27964,"_19171":112319,"_26134":112320,"_2648":111269},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#continúa",{"_3150":65931,"_27624":65920,"_19171":112322,"_5":13189,"_26134":65920,"_2648":112323},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3150":65932,"_27624":65920,"_19171":112325,"_5":13189,"_26134":112294,"_2648":112326},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3150":65933,"_27624":65920,"_19171":112328,"_5":13189,"_26134":112294,"_2648":112329},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3150":65934,"_27624":65920,"_19171":112331,"_5":13189,"_26134":112297,"_2648":112332},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3150":65935,"_27624":65920,"_19171":112334,"_5":13189,"_26134":112297,"_2648":112335},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3150":65936,"_27624":65920,"_19171":112337,"_5":13189,"_26134":112297,"_2648":112338},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3150":65937,"_27624":65920,"_19171":112340,"_5":13189,"_26134":112297,"_2648":112341},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3150":65938,"_27624":65920,"_19171":112343,"_5":13189,"_26134":112297,"_2648":112344},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3150":65939,"_27624":65920,"_19171":112346,"_5":13189,"_26134":112304,"_2648":112347},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3150":65940,"_27624":65920,"_19171":112349,"_5":13189,"_26134":112307,"_2648":112350},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3150":65941,"_27624":65920,"_19171":112352,"_5":13189,"_26134":112310,"_2648":112353},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3150":65942,"_27624":65920,"_19171":112355,"_5":13189,"_26134":112313,"_2648":112356},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3150":65943,"_27624":65920,"_19171":112358,"_5":13189,"_26134":112316,"_2648":112359},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3150":65944,"_27624":65920,"_19171":112361,"_5":13189,"_26134":112316,"_2648":112362},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3150":65945,"_27624":65920,"_19171":112364,"_5":13189,"_26134":112316,"_2648":112365},[],"su clave pública corresponda a la clave privada del cliente;",{"_3150":65946,"_27624":65920,"_19171":112367,"_5":13189,"_26134":112316,"_2648":112368},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3150":65947,"_27624":65920,"_19171":112370,"_5":13189,"_26134":112316,"_2648":112371},[],"sus fechas y usos permitan la operación;",{"_3150":65948,"_27624":65920,"_19171":112373,"_5":13189,"_26134":112316,"_2648":112374},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3150":65949,"_27624":65920,"_19171":112376,"_5":13189,"_26134":112316,"_2648":112377},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3150":65950,"_27624":65920,"_19171":112379,"_5":13189,"_26134":112320,"_2648":112380},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":65951,"_27624":65920,"_19171":112382,"_5":13189,"_26134":112320,"_2648":112383},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3150":65952,"_27624":65920,"_19171":112385,"_5":13189,"_26134":112320,"_2648":112386},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3150":65953,"_27624":65953,"_5":13515,"_2648":112388,"_27967":112389,"_19171":112390,"_26134":65953},"Crea tu primera CA",[44933,106897,50009,109936],[],{"_3150":65954,"_27624":65953,"_19171":112392,"_5":13189,"_26134":65953,"_2648":112393},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3150":65955,"_27624":65953,"_5":27964,"_19171":112395,"_26134":112396,"_2648":105563},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3150":65956,"_27624":65953,"_5":27964,"_19171":112398,"_26134":112399,"_2648":112400},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3150":65957,"_27624":65953,"_5":27964,"_19171":112402,"_26134":112403,"_2648":112404},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3150":65958,"_27624":65953,"_5":27964,"_19171":112406,"_26134":112407,"_2648":112408},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3150":65959,"_27624":65953,"_5":27964,"_19171":112410,"_26134":112411,"_2648":112412},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3150":65960,"_27624":65953,"_5":27964,"_19171":112414,"_26134":112415,"_2648":112416},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3150":65961,"_27624":65953,"_5":27964,"_19171":112418,"_26134":112419,"_2648":112420},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3150":65962,"_27624":65953,"_5":27964,"_19171":112422,"_26134":112423,"_2648":110184},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3150":65963,"_27624":65953,"_5":27964,"_19171":112425,"_26134":112426,"_2648":105587},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3150":65964,"_27624":65953,"_19171":112428,"_5":13189,"_26134":65953,"_2648":112429},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3150":65965,"_27624":65953,"_19171":112431,"_5":13189,"_26134":112396,"_2648":112432},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3150":65966,"_27624":65953,"_19171":112434,"_5":13189,"_26134":112396,"_2648":112435},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3150":65967,"_27624":65953,"_19171":112437,"_5":13189,"_26134":112396,"_2648":112438},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3150":65968,"_27624":65953,"_19171":112440,"_5":13189,"_26134":112396,"_2648":112441},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3150":65969,"_27624":65953,"_19171":112443,"_5":13189,"_26134":112399,"_2648":112444},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3150":65970,"_27624":65953,"_19171":112446,"_5":13189,"_26134":112399,"_2648":112447},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3150":65971,"_27624":65953,"_19171":112449,"_5":13189,"_26134":112403,"_2648":112450},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3150":65972,"_27624":65953,"_19171":112452,"_5":13189,"_26134":112403,"_2648":112453},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3150":65973,"_27624":65953,"_19171":112455,"_5":13189,"_26134":112407,"_2648":112456},[],"Selecciona **Root CA** y completa:",{"_3150":65974,"_27624":65953,"_19171":112458,"_5":13189,"_26134":112407,"_2648":52008},[],{"_3150":65975,"_27624":65953,"_19171":112460,"_5":13189,"_26134":112407,"_2648":112461},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3150":65976,"_27624":65953,"_19171":112463,"_5":13189,"_26134":112407,"_2648":112464},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3150":65977,"_27624":65953,"_19171":112466,"_5":13189,"_26134":112407,"_2648":112467},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3150":65978,"_27624":65953,"_19171":112469,"_5":13189,"_26134":112407,"_2648":112470},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3150":65979,"_27624":65953,"_19171":112472,"_5":13189,"_26134":112411,"_2648":112473},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3150":65980,"_27624":65953,"_19171":112475,"_5":13189,"_26134":112415,"_2648":112476},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3150":65981,"_27624":65953,"_19171":112478,"_5":13189,"_26134":112415,"_2648":112479},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3150":65982,"_27624":65953,"_19171":112481,"_5":13189,"_26134":112419,"_2648":112482},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3150":65983,"_27624":65953,"_19171":112484,"_5":13189,"_26134":112419,"_2648":112485},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3150":65984,"_27624":65953,"_19171":112487,"_5":13189,"_26134":112419,"_2648":112488},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3150":65985,"_27624":65953,"_19171":112490,"_5":13189,"_26134":112423,"_2648":112491},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3150":65986,"_27624":65953,"_19171":112493,"_5":13189,"_26134":112423,"_2648":112494},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3150":65987,"_27624":65953,"_19171":112496,"_5":13189,"_26134":112423,"_2648":112497},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3150":65988,"_27624":65953,"_19171":112499,"_5":13189,"_26134":112423,"_2648":112500},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3150":65989,"_27624":65953,"_19171":112502,"_5":13189,"_26134":112426,"_2648":112503},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3150":65990,"_27624":65990,"_5":13515,"_2648":112505,"_27967":112506,"_19171":112507,"_26134":65990},"Emite y verifica un certificado",[44933,106897,50009,109936],[],{"_3150":65991,"_27624":65990,"_19171":112509,"_5":13189,"_26134":65990,"_2648":112510},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3150":65992,"_27624":65990,"_5":27964,"_19171":112512,"_26134":112513,"_2648":105563},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3150":65993,"_27624":65990,"_5":27964,"_19171":112515,"_26134":112516,"_2648":112517},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3150":65994,"_27624":65990,"_5":27964,"_19171":112519,"_26134":112520,"_2648":112521},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3150":65995,"_27624":65990,"_5":27964,"_19171":112523,"_26134":112524,"_2648":112525},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3150":65996,"_27624":65990,"_5":27964,"_19171":112527,"_26134":112528,"_2648":112529},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3150":65997,"_27624":65990,"_5":27964,"_19171":112531,"_26134":112532,"_2648":112533},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3150":65998,"_27624":65990,"_5":27964,"_19171":112535,"_26134":112536,"_2648":112416},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3150":65999,"_27624":65990,"_5":27964,"_19171":112538,"_26134":112539,"_2648":112540},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3150":66000,"_27624":65990,"_5":27964,"_19171":112542,"_26134":112543,"_2648":112544},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3150":66001,"_27624":65990,"_5":27964,"_19171":112546,"_26134":112547,"_2648":112548},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3150":66002,"_27624":65990,"_5":27964,"_19171":112550,"_26134":112551,"_2648":110184},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3150":66003,"_27624":65990,"_5":27964,"_19171":112553,"_26134":112554,"_2648":105587},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3150":66004,"_27624":65990,"_19171":112556,"_5":13189,"_26134":65990,"_2648":112557},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3150":66005,"_27624":65990,"_19171":112559,"_5":13189,"_26134":112513,"_2648":112560},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3150":66006,"_27624":65990,"_19171":112562,"_5":13189,"_26134":112513,"_2648":112563},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3150":66007,"_27624":65990,"_19171":112565,"_5":13189,"_26134":112513,"_2648":112566},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3150":66008,"_27624":65990,"_19171":112568,"_5":13189,"_26134":112513,"_2648":112569},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3150":66009,"_27624":65990,"_19171":112571,"_5":13189,"_26134":112513,"_2648":112572},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3150":66010,"_27624":65990,"_19171":112574,"_5":13189,"_26134":112516,"_2648":112575},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3150":66011,"_27624":65990,"_19171":112577,"_5":13189,"_26134":112520,"_2648":112578},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3150":66012,"_27624":65990,"_19171":112580,"_5":13189,"_26134":112520,"_2648":112581},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3150":66013,"_27624":65990,"_19171":112583,"_5":13189,"_26134":112524,"_2648":112584},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3150":66014,"_27624":65990,"_19171":112586,"_5":13189,"_26134":112524,"_2648":112587},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3150":66015,"_27624":65990,"_19171":112589,"_5":13189,"_26134":112528,"_2648":112590},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3150":66016,"_27624":65990,"_19171":112592,"_5":13189,"_26134":112528,"_2648":112593},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3150":66017,"_27624":65990,"_19171":112595,"_5":13189,"_26134":112532,"_2648":112596},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3150":66018,"_27624":65990,"_19171":112598,"_5":13189,"_26134":112536,"_2648":112599},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3150":66019,"_27624":65990,"_19171":112601,"_5":13189,"_26134":112539,"_2648":112602},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3150":66020,"_27624":65990,"_19171":112604,"_5":13189,"_26134":112543,"_2648":112605},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3150":66021,"_27624":65990,"_19171":112607,"_5":13189,"_26134":112543,"_2648":112608},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3150":66022,"_27624":65990,"_19171":112610,"_5":13189,"_26134":112543,"_2648":112611},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3150":66023,"_27624":65990,"_19171":112613,"_5":13189,"_26134":112547,"_2648":112614},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3150":66024,"_27624":65990,"_19171":112616,"_5":13189,"_26134":112547,"_2648":112617},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3150":66025,"_27624":65990,"_19171":112619,"_5":13189,"_26134":112547,"_2648":112620},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3150":66026,"_27624":65990,"_19171":112622,"_5":13189,"_26134":112551,"_2648":110267},[],{"_3150":66027,"_27624":65990,"_19171":112624,"_5":13189,"_26134":112551,"_2648":109034},[],{"_3150":66028,"_27624":65990,"_19171":112626,"_5":13189,"_26134":112551,"_2648":112627},[],"La CA rechaza la emisión",{"_3150":66029,"_27624":65990,"_19171":112629,"_5":13189,"_26134":112551,"_2648":112630},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3150":66030,"_27624":65990,"_19171":112632,"_5":13189,"_26134":112551,"_2648":112633},[],"Sujeto o usos diferentes",{"_3150":66031,"_27624":65990,"_19171":112635,"_5":13189,"_26134":112551,"_2648":112636},[],"Perfil aplicado y valores solicitados.",{"_3150":66032,"_27624":65990,"_19171":112638,"_5":13189,"_26134":112551,"_2648":112639},[],"No se encuentra el emisor",{"_3150":66033,"_27624":65990,"_19171":112641,"_5":13189,"_26134":112551,"_2648":112642},[],"CA descargada y cadena intermedia necesaria.",{"_3150":66034,"_27624":65990,"_19171":112644,"_5":13189,"_26134":112551,"_2648":112645},[],"Falla la vigencia",{"_3150":66035,"_27624":65990,"_19171":112647,"_5":13189,"_26134":112551,"_2648":112648},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3150":66036,"_27624":65990,"_19171":112650,"_5":13189,"_26134":112551,"_2648":112651},[],"Los resúmenes de clave difieren",{"_3150":66037,"_27624":65990,"_19171":112653,"_5":13189,"_26134":112551,"_2648":112654},[],"Archivos de certificado y clave de la misma emisión.",{"_3150":66038,"_27624":65990,"_19171":112656,"_5":13189,"_26134":112551,"_2648":112657},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3150":66039,"_27624":65990,"_19171":112659,"_5":13189,"_26134":112554,"_2648":112660},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3150":66040,"_27624":65990,"_19171":112662,"_5":13189,"_26134":112554,"_2648":112663},[],"Gestionar certificados para inspección, estado y revocación.",{"_3150":66041,"_27624":65990,"_19171":112665,"_5":13189,"_26134":112554,"_2648":112666},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3150":66042,"_27624":65990,"_19171":112668,"_5":13189,"_26134":112554,"_2648":112669},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3150":66043,"_27624":65990,"_19171":112671,"_5":13189,"_26134":112554,"_2648":112672},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3150":66044,"_27624":66044,"_5":13515,"_2648":112674,"_27967":112675,"_19171":112676,"_26134":66044},"Primeros pasos de PKI",[44933,106897,50009,109936],[],{"_3150":66045,"_27624":66044,"_19171":112678,"_5":13189,"_26134":66044,"_2648":112679},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3150":66046,"_27624":66044,"_5":27964,"_19171":112681,"_26134":112682,"_2648":105563},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3150":66047,"_27624":66044,"_5":27964,"_19171":112684,"_26134":112685,"_2648":112686},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3150":66048,"_27624":66044,"_5":27964,"_19171":112688,"_26134":112689,"_2648":110118},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3150":66049,"_27624":66044,"_5":27964,"_19171":112691,"_26134":112692,"_2648":112693},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3150":66050,"_27624":66044,"_19171":112695,"_5":13189,"_26134":66044,"_2648":112696},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3150":66051,"_27624":66044,"_19171":112698,"_5":13189,"_26134":112682,"_2648":112699},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3150":66052,"_27624":66044,"_19171":112701,"_5":13189,"_26134":112682,"_2648":112702},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3150":66053,"_27624":66044,"_19171":112704,"_5":13189,"_26134":112682,"_2648":112705},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3150":66054,"_27624":66044,"_19171":112707,"_5":13189,"_26134":112682,"_2648":112708},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3150":66055,"_27624":66044,"_19171":112710,"_5":13189,"_26134":112682,"_2648":112711},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3150":66056,"_27624":66044,"_19171":112713,"_5":13189,"_26134":112685,"_2648":112714},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3150":66057,"_27624":66044,"_19171":112716,"_5":13189,"_26134":112685,"_2648":112717},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3150":66058,"_27624":66044,"_19171":112719,"_5":13189,"_26134":112685,"_2648":112720},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3150":66059,"_27624":66044,"_19171":112722,"_5":13189,"_26134":112685,"_2648":112723},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3150":66060,"_27624":66044,"_19171":112725,"_5":13189,"_26134":112689,"_2648":112726},[],"Archivo o recurso",{"_3150":66061,"_27624":66044,"_19171":112728,"_5":13189,"_26134":112689,"_2648":110115},[],{"_3150":66062,"_27624":66044,"_19171":112730,"_5":13189,"_26134":112689,"_2648":112731},[],"CA raíz activa y `ca.pem`",{"_3150":66063,"_27624":66044,"_19171":112733,"_5":13189,"_26134":112689,"_2648":112734},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3150":66064,"_27624":66044,"_19171":112736,"_5":13189,"_26134":112689,"_2648":112737},[],"Certificado final y `device.crt`",{"_3150":66065,"_27624":66044,"_19171":112739,"_5":13189,"_26134":112689,"_2648":112740},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3150":66066,"_27624":66044,"_19171":112742,"_5":13189,"_26134":112689,"_2648":112743},[],"Clave privada `device.key`",{"_3150":66067,"_27624":66044,"_19171":112745,"_5":13189,"_26134":112689,"_2648":112746},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3150":66068,"_27624":66044,"_19171":112748,"_5":13189,"_26134":112689,"_2648":112749},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3150":66069,"_27624":66044,"_19171":112751,"_5":13189,"_26134":112692,"_2648":112752},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3150":66070,"_27624":66044,"_19171":112754,"_5":13189,"_26134":112692,"_2648":112755},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3150":66071,"_27624":66044,"_19171":112757,"_5":13189,"_26134":112692,"_2648":112758},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3150":66072,"_27624":66072,"_5":13515,"_2648":112760,"_27967":112761,"_19171":112763,"_26134":66072},"Resolución de problemas PKI",[44933,106897,50009,112762],"Resolución de problemas",[],{"_3150":66073,"_27624":66072,"_19171":112765,"_5":13189,"_26134":66072,"_2648":112766},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3150":66074,"_27624":66072,"_5":27964,"_19171":112768,"_26134":112769,"_2648":112770},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3150":66075,"_27624":66072,"_5":27964,"_19171":112772,"_26134":112773,"_2648":112774},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3150":66076,"_27624":66072,"_5":27964,"_19171":112776,"_26134":112777,"_2648":112778},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3150":66077,"_27624":66072,"_19171":112780,"_5":13189,"_26134":66072,"_2648":112781},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3150":66078,"_27624":66072,"_19171":112783,"_5":13189,"_26134":66072,"_2648":112784},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3150":66079,"_27624":66072,"_19171":112786,"_5":13189,"_26134":112769,"_2648":110115},[],{"_3150":66080,"_27624":66072,"_19171":112788,"_5":13189,"_26134":112769,"_2648":109034},[],{"_3150":66081,"_27624":66072,"_19171":112790,"_5":13189,"_26134":112769,"_2648":105587},[],{"_3150":66082,"_27624":66072,"_19171":112792,"_5":13189,"_26134":112769,"_2648":52344},[],{"_3150":66083,"_27624":66072,"_19171":112794,"_5":13189,"_26134":112769,"_2648":112795},[],"Existe, está activa y sus fechas son utilizables.",{"_3150":66084,"_27624":66072,"_19171":112797,"_5":13189,"_26134":112769,"_2648":112798},[],"Autoridades.",{"_3150":66085,"_27624":66072,"_19171":112800,"_5":13189,"_26134":112769,"_2648":112801},[],"Clave",{"_3150":66086,"_27624":66072,"_19171":112803,"_5":13189,"_26134":112769,"_2648":112804},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3150":66087,"_27624":66072,"_19171":112806,"_5":13189,"_26134":112769,"_2648":112807},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3150":66088,"_27624":66072,"_19171":112809,"_5":13189,"_26134":112769,"_2648":52362},[],{"_3150":66089,"_27624":66072,"_19171":112811,"_5":13189,"_26134":112769,"_2648":112812},[],"PEM correcto y firma verificable.",{"_3150":66090,"_27624":66072,"_19171":112814,"_5":13189,"_26134":112769,"_2648":52368},[],{"_3150":66091,"_27624":66072,"_19171":112816,"_5":13189,"_26134":112769,"_2648":112817},[],"Perfil",{"_3150":66092,"_27624":66072,"_19171":112819,"_5":13189,"_26134":112769,"_2648":112820},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3150":66093,"_27624":66072,"_19171":112822,"_5":13189,"_26134":112769,"_2648":112823},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3150":66094,"_27624":66072,"_19171":112825,"_5":13189,"_26134":112769,"_2648":110267},[],{"_3150":66095,"_27624":66072,"_19171":112827,"_5":13189,"_26134":112769,"_2648":112828},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3150":66096,"_27624":66072,"_19171":112830,"_5":13189,"_26134":112769,"_2648":112831},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3150":66097,"_27624":66072,"_19171":112833,"_5":13189,"_26134":112769,"_2648":112834},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3150":66098,"_27624":66072,"_19171":112836,"_5":13189,"_26134":112769,"_2648":112837},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3150":66099,"_27624":66072,"_19171":112839,"_5":13189,"_26134":112773,"_2648":112840},[],"Revisa cada frontera por separado:",{"_3150":66100,"_27624":66072,"_19171":112842,"_5":13189,"_26134":112773,"_2648":112843},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3150":66101,"_27624":66072,"_19171":112845,"_5":13189,"_26134":112773,"_2648":112846},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3150":66102,"_27624":66072,"_19171":112848,"_5":13189,"_26134":112773,"_2648":112849},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3150":66103,"_27624":66072,"_19171":112851,"_5":13189,"_26134":112773,"_2648":112852},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3150":66104,"_27624":66072,"_19171":112854,"_5":13189,"_26134":112773,"_2648":112855},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3150":66105,"_27624":66072,"_19171":112857,"_5":13189,"_26134":112773,"_2648":112858},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3150":66106,"_27624":66072,"_19171":112860,"_5":13189,"_26134":112777,"_2648":112861},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3150":66107,"_27624":66072,"_19171":112863,"_5":13189,"_26134":112777,"_2648":112864},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3150":66108,"_27624":66108,"_5":13515,"_2648":112866,"_27967":112867,"_19171":112869,"_26134":66108},"3.8.0 a 4.0.0",[44933,112868],"Actualizaciones",[],{"_3150":66109,"_27624":66108,"_19171":112871,"_5":13189,"_26134":66108,"_2648":112872},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3150":66110,"_27624":66108,"_5":27964,"_19171":112874,"_26134":112875,"_2648":112876},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3150":66111,"_27624":66108,"_5":27964,"_19171":112878,"_26134":112879,"_2648":112880},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3150":66112,"_27624":66108,"_5":27964,"_19171":112882,"_26134":112883,"_2648":112884},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3150":66113,"_27624":66108,"_5":27964,"_19171":112886,"_26134":112887,"_2648":112888},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3150":66114,"_27624":66108,"_5":27964,"_19171":112890,"_26134":112891,"_2648":112892},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3150":66115,"_27624":66108,"_5":27964,"_19171":112894,"_26134":112895,"_2648":112896},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3150":66116,"_27624":66108,"_5":27964,"_19171":112898,"_26134":112899,"_2648":52454},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3150":66117,"_27624":66108,"_5":27964,"_19171":112901,"_26134":112902,"_2648":112903},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3150":66118,"_27624":66108,"_5":27964,"_19171":112905,"_26134":112906,"_2648":112907},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3150":66119,"_27624":66108,"_5":27964,"_19171":112909,"_26134":112910,"_2648":112911},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3150":66120,"_27624":66108,"_5":27964,"_19171":112913,"_26134":112914,"_2648":112915},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3150":66121,"_27624":66108,"_5":27964,"_19171":112917,"_26134":112918,"_2648":112919},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3150":66122,"_27624":66108,"_5":27964,"_19171":112921,"_26134":112922,"_2648":112923},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3150":66123,"_27624":66108,"_5":27964,"_19171":112925,"_26134":112926,"_2648":112927},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3150":66124,"_27624":66108,"_5":27964,"_19171":112929,"_26134":112930,"_2648":112931},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3150":66125,"_27624":66108,"_5":27964,"_19171":112933,"_26134":112934,"_2648":112935},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3150":66126,"_27624":66108,"_5":27964,"_19171":112937,"_26134":112938,"_2648":112939},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3150":66127,"_27624":66108,"_5":27964,"_19171":112941,"_26134":112942,"_2648":112943},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3150":66128,"_27624":66108,"_5":27964,"_19171":112945,"_26134":112946,"_2648":112947},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3150":66129,"_27624":66108,"_5":27964,"_19171":112949,"_26134":112950,"_2648":112951},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3150":66130,"_27624":66108,"_5":27964,"_19171":112953,"_26134":112954,"_2648":112955},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3150":66131,"_27624":66108,"_5":27964,"_19171":112957,"_26134":112958,"_2648":112959},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3150":66132,"_27624":66108,"_5":27964,"_19171":112961,"_26134":112962,"_2648":112963},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3150":66133,"_27624":66108,"_5":27964,"_19171":112965,"_26134":112966,"_2648":112967},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3150":66134,"_27624":66108,"_5":27964,"_19171":112969,"_26134":112970,"_2648":112971},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3150":66135,"_27624":66108,"_5":27964,"_19171":112973,"_26134":112974,"_2648":112975},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3150":66136,"_27624":66108,"_5":27964,"_19171":112977,"_26134":112978,"_2648":112979},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3150":66137,"_27624":66108,"_5":27964,"_19171":112981,"_26134":112982,"_2648":112983},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3150":66138,"_27624":66108,"_5":27964,"_19171":112985,"_26134":112986,"_2648":112987},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3150":66139,"_27624":66108,"_5":27964,"_19171":112989,"_26134":112990,"_2648":112991},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3150":66140,"_27624":66108,"_5":27964,"_19171":112993,"_26134":112994,"_2648":112995},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3150":66141,"_27624":66108,"_5":27964,"_19171":112997,"_26134":112998,"_2648":112999},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3150":66142,"_27624":66108,"_5":27964,"_19171":113001,"_26134":113002,"_2648":113003},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3150":66143,"_27624":66108,"_5":27964,"_19171":113005,"_26134":113006,"_2648":109356},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3150":66144,"_27624":66108,"_5":27964,"_19171":113008,"_26134":113009,"_2648":113010},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3150":66145,"_27624":66108,"_5":27964,"_19171":113012,"_26134":113013,"_2648":113014},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3150":66146,"_27624":66108,"_19171":113016,"_5":13189,"_26134":66108,"_2648":113017},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3150":66147,"_27624":66108,"_19171":113019,"_5":13189,"_26134":66108,"_2648":113020},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3150":66148,"_27624":66108,"_19171":113022,"_5":13189,"_26134":66108,"_2648":113023},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3150":66149,"_27624":66108,"_19171":113025,"_5":13189,"_26134":66108,"_2648":113026},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3150":66150,"_27624":66108,"_19171":113028,"_5":13189,"_26134":66108,"_2648":113029},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3150":66151,"_27624":66108,"_19171":113031,"_5":13189,"_26134":66108,"_2648":113032},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3150":66152,"_27624":66108,"_19171":113034,"_5":13189,"_26134":66108,"_2648":113035},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3150":66153,"_27624":66108,"_19171":113037,"_5":13189,"_26134":112879,"_2648":113038},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3150":66154,"_27624":66108,"_19171":113040,"_5":13189,"_26134":112879,"_2648":113041},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3150":66155,"_27624":66108,"_19171":113043,"_5":13189,"_26134":112883,"_2648":113044},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3150":66156,"_27624":66108,"_19171":113046,"_5":13189,"_26134":112883,"_2648":113047},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3150":66157,"_27624":66108,"_19171":113049,"_5":13189,"_26134":112887,"_2648":113050},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3150":66158,"_27624":66108,"_19171":113052,"_5":13189,"_26134":112891,"_2648":113053},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3150":66159,"_27624":66108,"_19171":113055,"_5":13189,"_26134":112891,"_2648":113056},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3150":66160,"_27624":66108,"_19171":113058,"_5":13189,"_26134":112891,"_2648":113059},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3150":66161,"_27624":66108,"_19171":113061,"_5":13189,"_26134":112891,"_2648":113062},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3150":66162,"_27624":66108,"_19171":113064,"_5":13189,"_26134":112891,"_2648":113065},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3150":66163,"_27624":66108,"_19171":113067,"_5":13189,"_26134":112895,"_2648":113068},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3150":66164,"_27624":66108,"_19171":113070,"_5":13189,"_26134":112895,"_2648":113071},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3150":66165,"_27624":66108,"_19171":113073,"_5":13189,"_26134":112895,"_2648":113074},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3150":66166,"_27624":66108,"_19171":113076,"_5":13189,"_26134":112895,"_2648":113077},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3150":66167,"_27624":66108,"_19171":113079,"_5":13189,"_26134":112895,"_2648":113080},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3150":66168,"_27624":66108,"_19171":113082,"_5":13189,"_26134":112899,"_2648":113083},[],"Cambio",{"_3150":66169,"_27624":66108,"_19171":113085,"_5":13189,"_26134":112899,"_2648":113086},[],"A quién afecta",{"_3150":66170,"_27624":66108,"_19171":113088,"_5":13189,"_26134":112899,"_2648":113089},[],"Gravedad",{"_3150":66171,"_27624":66108,"_19171":113091,"_5":13189,"_26134":112899,"_2648":113092},[],"Acción",{"_3150":66172,"_27624":66108,"_19171":113094,"_5":13189,"_26134":112899,"_2648":112907},[],{"_3150":66173,"_27624":66108,"_19171":113096,"_5":13189,"_26134":112899,"_2648":113097},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3150":66174,"_27624":66108,"_19171":113099,"_5":13189,"_26134":112899,"_2648":113100},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3150":66175,"_27624":66108,"_19171":113102,"_5":13189,"_26134":112899,"_2648":113103},[],"Copiar los datos a los volúmenes nuevos",{"_3150":66176,"_27624":66108,"_19171":113105,"_5":13189,"_26134":112899,"_2648":112911},[],{"_3150":66177,"_27624":66108,"_19171":113107,"_5":13189,"_26134":112899,"_2648":113108},[],"Todas las releases de Helm",{"_3150":66178,"_27624":66108,"_19171":113110,"_5":13189,"_26134":112899,"_2648":113111},[],"Alta: `helm upgrade` falla",{"_3150":66179,"_27624":66108,"_19171":113113,"_5":13189,"_26134":112899,"_2648":113114},[],"Eliminar o renombrar las claves heredadas",{"_3150":66180,"_27624":66108,"_19171":113116,"_5":13189,"_26134":112899,"_2648":112915},[],{"_3150":66181,"_27624":66108,"_19171":113118,"_5":13189,"_26134":112899,"_2648":113119},[],"Todos los despliegues",{"_3150":66182,"_27624":66108,"_19171":113121,"_5":13189,"_26134":112899,"_2648":113122},[],"Alta: sin principal de bootstrap no hay administrador",{"_3150":66183,"_27624":66108,"_19171":113124,"_5":13189,"_26134":112899,"_2648":113125},[],"Configurar `services.authz`",{"_3150":66184,"_27624":66108,"_19171":113127,"_5":13189,"_26134":112899,"_2648":112919},[],{"_3150":66185,"_27624":66108,"_19171":113129,"_5":13189,"_26134":112899,"_2648":113108},[],{"_3150":66186,"_27624":66108,"_19171":113131,"_5":13189,"_26134":112899,"_2648":113132},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3150":66187,"_27624":66108,"_19171":113134,"_5":13189,"_26134":112899,"_2648":113135},[],"Mover JWKS y roles a `services.authz`",{"_3150":66188,"_27624":66108,"_19171":113137,"_5":13189,"_26134":112899,"_2648":112939},[],{"_3150":66189,"_27624":66108,"_19171":113139,"_5":13189,"_26134":112899,"_2648":113140},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3150":66190,"_27624":66108,"_19171":113142,"_5":13189,"_26134":112899,"_2648":113143},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3150":66191,"_27624":66108,"_19171":113145,"_5":13189,"_26134":112899,"_2648":113146},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3150":66192,"_27624":66108,"_19171":113148,"_5":13189,"_26134":112899,"_2648":112943},[],{"_3150":66193,"_27624":66108,"_19171":113150,"_5":13189,"_26134":112899,"_2648":113151},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3150":66194,"_27624":66108,"_19171":113153,"_5":13189,"_26134":112899,"_2648":113154},[],"Alta: el backend ya no arranca con ellos",{"_3150":66195,"_27624":66108,"_19171":113156,"_5":13189,"_26134":112899,"_2648":113157},[],"Pasar a PostgreSQL antes de actualizar",{"_3150":66196,"_27624":66108,"_19171":113159,"_5":13189,"_26134":112899,"_2648":113160},[],"Webhooks con referencias a archivos",{"_3150":66197,"_27624":66108,"_19171":113162,"_5":13189,"_26134":112899,"_2648":113163},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3150":66198,"_27624":66108,"_19171":113165,"_5":13189,"_26134":112899,"_2648":113166},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3150":66199,"_27624":66108,"_19171":113168,"_5":13189,"_26134":112899,"_2648":113169},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3150":66200,"_27624":66108,"_19171":113171,"_5":13189,"_26134":112899,"_2648":112923},[],{"_3150":66201,"_27624":66108,"_19171":113173,"_5":13189,"_26134":112899,"_2648":113174},[],"Releases con identidades por servicio o material de claves montado",{"_3150":66202,"_27624":66108,"_19171":113176,"_5":13189,"_26134":112899,"_2648":113177},[],"Media: los servicios no pueden leer sus archivos",{"_3150":66203,"_27624":66108,"_19171":113179,"_5":13189,"_26134":112899,"_2648":113180},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3150":66204,"_27624":66108,"_19171":113182,"_5":13189,"_26134":112899,"_2648":112927},[],{"_3150":66205,"_27624":66108,"_19171":113184,"_5":13189,"_26134":112899,"_2648":113185},[],"Releases que definen `amqp.tls`",{"_3150":66206,"_27624":66108,"_19171":113187,"_5":13189,"_26134":112899,"_2648":113188},[],"Media: los clientes se conectan al puerto equivocado",{"_3150":66207,"_27624":66108,"_19171":113190,"_5":13189,"_26134":112899,"_2648":113191},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3150":66208,"_27624":66108,"_19171":113193,"_5":13189,"_26134":112899,"_2648":112947},[],{"_3150":66209,"_27624":66108,"_19171":113195,"_5":13189,"_26134":112899,"_2648":113196},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3150":66210,"_27624":66108,"_19171":113198,"_5":13189,"_26134":112899,"_2648":113199},[],"Media: las claves de CA quedan sin gestionar",{"_3150":66211,"_27624":66108,"_19171":113201,"_5":13189,"_26134":112899,"_2648":113202},[],"Ejecutar la migración de CA a KMS",{"_3150":66212,"_27624":66108,"_19171":113204,"_5":13189,"_26134":112899,"_2648":113205},[],"Verificación del certificado del receptor",{"_3150":66213,"_27624":66108,"_19171":113207,"_5":13189,"_26134":112899,"_2648":113208},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3150":66214,"_27624":66108,"_19171":113210,"_5":13189,"_26134":112899,"_2648":113211},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3150":66215,"_27624":66108,"_19171":113213,"_5":13189,"_26134":112899,"_2648":113214},[],"Poner `insecure_skip_verify` a `false`",{"_3150":66216,"_27624":66108,"_19171":113216,"_5":13189,"_26134":112899,"_2648":112959},[],{"_3150":66217,"_27624":66108,"_19171":113218,"_5":13189,"_26134":112899,"_2648":113219},[],"Scripts y consolas que editan DMS por API",{"_3150":66218,"_27624":66108,"_19171":113221,"_5":13189,"_26134":112899,"_2648":113222},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3150":66219,"_27624":66108,"_19171":113224,"_5":13189,"_26134":112899,"_2648":113225},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3150":66220,"_27624":66108,"_19171":113227,"_5":13189,"_26134":112899,"_2648":112975},[],{"_3150":66221,"_27624":66108,"_19171":113229,"_5":13189,"_26134":112899,"_2648":113230},[],"Consumidores que leen el campo `events` del dispositivo",{"_3150":66222,"_27624":66108,"_19171":113232,"_5":13189,"_26134":112899,"_2648":113233},[],"Media: el campo desaparece",{"_3150":66223,"_27624":66108,"_19171":113235,"_5":13189,"_26134":112899,"_2648":113236},[],"Usar los nuevos endpoints de eventos",{"_3150":66224,"_27624":66108,"_19171":113238,"_5":13189,"_26134":112899,"_2648":112931},[],{"_3150":66225,"_27624":66108,"_19171":113240,"_5":13189,"_26134":112899,"_2648":113241},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3150":66226,"_27624":66108,"_19171":113243,"_5":13189,"_26134":112899,"_2648":113244},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3150":66227,"_27624":66108,"_19171":113246,"_5":13189,"_26134":112899,"_2648":113247},[],"Actualizar el archivo de values",{"_3150":66228,"_27624":66108,"_19171":113249,"_5":13189,"_26134":112899,"_2648":112967},[],{"_3150":66229,"_27624":66108,"_19171":113251,"_5":13189,"_26134":112899,"_2648":113252},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3150":66230,"_27624":66108,"_19171":113254,"_5":13189,"_26134":112899,"_2648":113255},[],"Baja: prevalece el ID de la URL",{"_3150":66231,"_27624":66108,"_19171":113257,"_5":13189,"_26134":112899,"_2648":113258},[],"Enviar el ID en la URL",{"_3150":66232,"_27624":66108,"_19171":113260,"_5":13189,"_26134":112899,"_2648":112971},[],{"_3150":66233,"_27624":66108,"_19171":113262,"_5":13189,"_26134":112899,"_2648":113263},[],"Consumidores que comparan el `type` del certificado",{"_3150":66234,"_27624":66108,"_19171":113265,"_5":13189,"_26134":112899,"_2648":113266},[],"Baja: dos valores cambian de nombre",{"_3150":66235,"_27624":66108,"_19171":113268,"_5":13189,"_26134":112899,"_2648":113269},[],"Adaptar los consumidores",{"_3150":66236,"_27624":66108,"_19171":113271,"_5":13189,"_26134":112899,"_2648":112963},[],{"_3150":66237,"_27624":66108,"_19171":113273,"_5":13189,"_26134":112899,"_2648":113274},[],"Cualquier DMS",{"_3150":66238,"_27624":66108,"_19171":113276,"_5":13189,"_26134":112899,"_2648":113277},[],"Baja: solo informativo",{"_3150":66239,"_27624":66108,"_19171":113279,"_5":13189,"_26134":112899,"_2648":113280},[],"Revisar ambos bloques antes de editar",{"_3150":66240,"_27624":66108,"_19171":113282,"_5":13189,"_26134":112906,"_2648":113283},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3150":66241,"_27624":66108,"_19171":113285,"_5":13189,"_26134":112906,"_2648":113286},[],"El paso 4 de la guía de migración copia los datos.",{"_3150":66242,"_27624":66108,"_19171":113288,"_5":13189,"_26134":112910,"_2648":113289},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3150":66243,"_27624":66108,"_19171":113291,"_5":13189,"_26134":112914,"_2648":113292},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3150":66244,"_27624":66108,"_19171":113294,"_5":13189,"_26134":112918,"_2648":113295},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3150":66245,"_27624":66108,"_19171":113297,"_5":13189,"_26134":112922,"_2648":113298},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3150":66246,"_27624":66108,"_19171":113300,"_5":13189,"_26134":112922,"_2648":113301},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3150":66247,"_27624":66108,"_19171":113303,"_5":13189,"_26134":112926,"_2648":113304},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3150":66248,"_27624":66108,"_19171":113306,"_5":13189,"_26134":112930,"_2648":113307},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3150":66249,"_27624":66108,"_19171":113309,"_5":13189,"_26134":112930,"_2648":113310},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3150":66250,"_27624":66108,"_19171":113312,"_5":13189,"_26134":112930,"_2648":113313},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3150":66251,"_27624":66108,"_19171":113315,"_5":13189,"_26134":112930,"_2648":113316},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3150":66252,"_27624":66108,"_19171":113318,"_5":13189,"_26134":112930,"_2648":113319},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3150":66253,"_27624":66108,"_19171":113321,"_5":13189,"_26134":112930,"_2648":113322},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3150":66254,"_27624":66108,"_19171":113324,"_5":13189,"_26134":112938,"_2648":113325},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3150":66255,"_27624":66108,"_19171":113327,"_5":13189,"_26134":112938,"_2648":113328},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3150":66256,"_27624":66108,"_19171":113330,"_5":13189,"_26134":112938,"_2648":113331},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3150":66257,"_27624":66108,"_19171":113333,"_5":13189,"_26134":112938,"_2648":113334},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3150":66258,"_27624":66108,"_19171":113336,"_5":13189,"_26134":112938,"_2648":113337},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3150":66259,"_27624":66108,"_19171":113339,"_5":13189,"_26134":112942,"_2648":113340},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3150":66260,"_27624":66108,"_19171":113342,"_5":13189,"_26134":112946,"_2648":113343},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3150":66261,"_27624":66108,"_19171":113345,"_5":13189,"_26134":112946,"_2648":113346},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3150":66262,"_27624":66108,"_19171":113348,"_5":13189,"_26134":112946,"_2648":113349},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3150":66263,"_27624":66108,"_19171":113351,"_5":13189,"_26134":112946,"_2648":113352},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3150":66264,"_27624":66108,"_19171":113354,"_5":13189,"_26134":112946,"_2648":113355},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3150":66265,"_27624":66108,"_19171":113357,"_5":13189,"_26134":112946,"_2648":113358},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3150":66266,"_27624":66108,"_19171":113360,"_5":13189,"_26134":112954,"_2648":113361},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3150":66267,"_27624":66108,"_19171":113363,"_5":13189,"_26134":112954,"_2648":113364},[],"Campo en 3.8.0",{"_3150":66268,"_27624":66108,"_19171":113366,"_5":13189,"_26134":112954,"_2648":113367},[],"Campo en 4.0.0",{"_3150":66269,"_27624":66108,"_19171":113369,"_5":13189,"_26134":112954,"_2648":52925},[],{"_3150":66270,"_27624":66108,"_19171":113371,"_5":13189,"_26134":112954,"_2648":113372},[],"`insecure_skip_verify` (con el valor negado)",{"_3150":66271,"_27624":66108,"_19171":113374,"_5":13189,"_26134":112954,"_2648":52931},[],{"_3150":66272,"_27624":66108,"_19171":113376,"_5":13189,"_26134":112954,"_2648":52934},[],{"_3150":66273,"_27624":66108,"_19171":113378,"_5":13189,"_26134":112954,"_2648":52937},[],{"_3150":66274,"_27624":66108,"_19171":113380,"_5":13189,"_26134":112954,"_2648":52940},[],{"_3150":66275,"_27624":66108,"_19171":113382,"_5":13189,"_26134":112954,"_2648":52943},[],{"_3150":66276,"_27624":66108,"_19171":113384,"_5":13189,"_26134":112954,"_2648":52946},[],{"_3150":66277,"_27624":66108,"_19171":113386,"_5":13189,"_26134":112954,"_2648":113387},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3150":66278,"_27624":66108,"_19171":113389,"_5":13189,"_26134":112954,"_2648":113390},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3150":66279,"_27624":66108,"_19171":113392,"_5":13189,"_26134":112954,"_2648":113393},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3150":66280,"_27624":66108,"_19171":113395,"_5":13189,"_26134":112958,"_2648":113396},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3150":66281,"_27624":66108,"_19171":113398,"_5":13189,"_26134":112958,"_2648":113399},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3150":66282,"_27624":66108,"_19171":113401,"_5":13189,"_26134":112958,"_2648":113402},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3150":66283,"_27624":66108,"_19171":113404,"_5":13189,"_26134":112962,"_2648":113405},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. Si la versión de la consola no expone los ajustes independientes, edítalos mediante la API DMS.",{"_3150":66284,"_27624":66108,"_19171":113407,"_5":13189,"_26134":112966,"_2648":113408},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3150":66285,"_27624":66108,"_19171":113410,"_5":13189,"_26134":112970,"_2648":113411},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3150":66286,"_27624":66108,"_19171":113413,"_5":13189,"_26134":112974,"_2648":113414},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3150":66287,"_27624":66108,"_19171":113416,"_5":13189,"_26134":112974,"_2648":113417},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3150":66288,"_27624":66108,"_19171":113419,"_5":13189,"_26134":112974,"_2648":113420},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3150":66289,"_27624":66108,"_19171":113422,"_5":13189,"_26134":112974,"_2648":113423},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3150":66290,"_27624":66108,"_19171":113425,"_5":13189,"_26134":112978,"_2648":113426},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3150":66291,"_27624":66108,"_19171":113428,"_5":13189,"_26134":112982,"_2648":113429},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3150":66292,"_27624":66108,"_19171":113431,"_5":13189,"_26134":112982,"_2648":113432},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3150":66293,"_27624":66108,"_19171":113434,"_5":13189,"_26134":112982,"_2648":113435},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3150":66294,"_27624":66108,"_19171":113437,"_5":13189,"_26134":112982,"_2648":113438},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3150":66295,"_27624":66108,"_19171":113440,"_5":13189,"_26134":112982,"_2648":113441},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3150":66296,"_27624":66108,"_19171":113443,"_5":13189,"_26134":112986,"_2648":113444},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3150":66297,"_27624":66108,"_19171":113446,"_5":13189,"_26134":112986,"_2648":113447},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3150":66298,"_27624":66108,"_19171":113449,"_5":13189,"_26134":112986,"_2648":113450},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3150":66299,"_27624":66108,"_19171":113452,"_5":13189,"_26134":112986,"_2648":113453},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3150":66300,"_27624":66108,"_19171":113455,"_5":13189,"_26134":112986,"_2648":113456},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3150":66301,"_27624":66108,"_19171":113458,"_5":13189,"_26134":112986,"_2648":113459},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3150":66302,"_27624":66108,"_19171":113461,"_5":13189,"_26134":112986,"_2648":113462},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3150":66303,"_27624":66108,"_19171":113464,"_5":13189,"_26134":112986,"_2648":113465},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3150":66304,"_27624":66108,"_19171":113467,"_5":13189,"_26134":112986,"_2648":113468},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3150":66305,"_27624":66108,"_19171":113470,"_5":13189,"_26134":112986,"_2648":113471},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3150":66306,"_27624":66108,"_19171":113473,"_5":13189,"_26134":112986,"_2648":113474},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3150":66307,"_27624":66108,"_19171":113476,"_5":13189,"_26134":112986,"_2648":113477},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3150":66308,"_27624":66108,"_19171":113479,"_5":13189,"_26134":112990,"_2648":113480},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar. Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4.",{"_3150":66309,"_27624":66108,"_19171":113482,"_5":13189,"_26134":112994,"_2648":113483},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3150":66310,"_27624":66108,"_19171":113485,"_5":13189,"_26134":112994,"_2648":113486},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3150":66311,"_27624":66108,"_19171":113488,"_5":13189,"_26134":112994,"_2648":113489},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3150":66312,"_27624":66108,"_19171":113491,"_5":13189,"_26134":112994,"_2648":113492},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3150":66313,"_27624":66108,"_19171":113494,"_5":13189,"_26134":112994,"_2648":113495},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3150":66314,"_27624":66108,"_19171":113497,"_5":13189,"_26134":112994,"_2648":113498},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3150":66315,"_27624":66108,"_19171":113500,"_5":13189,"_26134":112994,"_2648":113501},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3150":66316,"_27624":66108,"_19171":113503,"_5":13189,"_26134":112994,"_2648":113504},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3150":66317,"_27624":66108,"_19171":113506,"_5":13189,"_26134":112994,"_2648":113507},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3150":66318,"_27624":66108,"_19171":113509,"_5":13189,"_26134":112994,"_2648":113510},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3150":66319,"_27624":66108,"_19171":113512,"_5":13189,"_26134":112998,"_2648":113513},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3150":66320,"_27624":66108,"_19171":113515,"_5":13189,"_26134":112998,"_2648":113516},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3150":66321,"_27624":66108,"_19171":113518,"_5":13189,"_26134":113002,"_2648":113519},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3150":66322,"_27624":66108,"_19171":113521,"_5":13189,"_26134":113002,"_2648":113522},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3150":66323,"_27624":66108,"_19171":113524,"_5":13189,"_26134":113002,"_2648":113525},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3150":66324,"_27624":66108,"_19171":113527,"_5":13189,"_26134":113002,"_2648":113528},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3150":66325,"_27624":66108,"_19171":113530,"_5":13189,"_26134":113002,"_2648":113531},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3150":66326,"_27624":66108,"_19171":113533,"_5":13189,"_26134":113006,"_2648":113534},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3150":66327,"_27624":66108,"_19171":113536,"_5":13189,"_26134":113006,"_2648":113537},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3150":66328,"_27624":66108,"_19171":113539,"_5":13189,"_26134":113006,"_2648":113540},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3150":66329,"_27624":66108,"_19171":113542,"_5":13189,"_26134":113006,"_2648":113543},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3150":66330,"_27624":66108,"_19171":113545,"_5":13189,"_26134":113006,"_2648":113546},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3150":66331,"_27624":66108,"_19171":113548,"_5":13189,"_26134":113006,"_2648":113549},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3150":66332,"_27624":66108,"_19171":113551,"_5":13189,"_26134":113009,"_2648":113552},[],"Tras la actualización, comprueba en este orden:",{"_3150":66333,"_27624":66108,"_19171":113554,"_5":13189,"_26134":113009,"_2648":113555},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3150":66334,"_27624":66108,"_19171":113557,"_5":13189,"_26134":113009,"_2648":113558},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3150":66335,"_27624":66108,"_19171":113560,"_5":13189,"_26134":113009,"_2648":113561},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3150":66336,"_27624":66108,"_19171":113563,"_5":13189,"_26134":113009,"_2648":113564},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3150":66337,"_27624":66108,"_19171":113566,"_5":13189,"_26134":113009,"_2648":113567},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3150":66338,"_27624":66108,"_19171":113569,"_5":13189,"_26134":113009,"_2648":113570},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3150":66339,"_27624":66108,"_19171":113572,"_5":13189,"_26134":113009,"_2648":113573},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3150":66340,"_27624":66108,"_19171":113575,"_5":13189,"_26134":113009,"_2648":113576},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3150":66341,"_27624":66108,"_19171":113578,"_5":13189,"_26134":113009,"_2648":113579},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3150":66342,"_27624":66108,"_19171":113581,"_5":13189,"_26134":113009,"_2648":113582},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3150":66343,"_27624":66108,"_19171":113584,"_5":13189,"_26134":113009,"_2648":113585},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3150":66344,"_27624":66108,"_19171":113587,"_5":13189,"_26134":113009,"_2648":113588},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3150":66345,"_27624":66108,"_19171":113590,"_5":13189,"_26134":113009,"_2648":113591},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3150":66346,"_27624":66108,"_19171":113593,"_5":13189,"_26134":113009,"_2648":113594},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3150":66347,"_27624":66108,"_19171":113596,"_5":13189,"_26134":113013,"_2648":113597},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente:",{"_3150":66348,"_27624":66108,"_19171":113599,"_5":13189,"_26134":113013,"_2648":113600},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3150":66349,"_27624":66108,"_19171":113602,"_5":13189,"_26134":113013,"_2648":113603},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":66350,"_27624":66108,"_19171":113605,"_5":13189,"_26134":113013,"_2648":113606},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3150":66351,"_27624":66108,"_19171":113608,"_5":13189,"_26134":113013,"_2648":113609},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53183":113611,"_53185":113612,"_53187":113613,"_53189":113614,"_16717":2670,"_63720":2670},"spanish",[2648,27624,5,26134],{"_2648":22920,"_27624":22920,"_5":22920,"_26134":22920},{"_2648":113615,"_27624":116243,"_5":118871,"_26134":121499},{"_4214":113616,"_53193":113617,"_5":22920},{"_13244":8101,"_13614":23240,"_13621":4779,"_11885":2733,"_26260":10194,"_18205":3320,"_13265":3649,"_13272":4306,"_26687":3073,"_27074":9597,"_27095":4906,"_26705":2758,"_31731":4519,"_27106":13136,"_27135":13123,"_31738":5903,"_31741":6264,"_31744":4599,"_31747":2915,"_27483":3021,"_31752":11940,"_31754":4118,"_27513":2719,"_27473":2970,"_31758":14468,"_27682":3868,"_31762":2857,"_27124":21653,"_27478":5442,"_27537":5861,"_31767":2732,"_31769":3331,"_31771":5682,"_31773":6354,"_31775":4190,"_31777":3770,"_31779":3113,"_31781":5766,"_31783":17786,"_26758":4431,"_31786":3234,"_31788":3697,"_26752":7762,"_31791":5713,"_31793":6825,"_31795":2782,"_31798":5455,"_26793":17784,"_31802":4701,"_26678":15375,"_31805":5068,"_26710":11149,"_31808":7851,"_31810":15408,"_31813":3328,"_27508":5570,"_31816":12502,"_31818":4974,"_31821":5286,"_31823":10671,"_31825":4963,"_31827":21890,"_31829":18637,"_18208":4929,"_31832":8564,"_31834":6503,"_26732":22567,"_27118":5018,"_31838":14426,"_31840":6504,"_31842":2852,"_31844":3016,"_31846":20840,"_31848":9560,"_31850":7873,"_27604":21887,"_27151":3004,"_31854":4068,"_31856":4117,"_26721":