772":113251,"_36774":113254,"_36776":113257,"_36778":113260,"_36780":113263,"_36782":113266,"_36784":113269,"_36786":113272,"_36788":113275,"_36790":113278,"_36792":113281,"_36794":113284,"_36796":113287,"_36798":113290,"_36800":113293,"_36802":113296,"_36804":113299,"_36806":113302,"_36808":113305,"_36810":113308,"_36812":113311,"_36814":113314},{"_3144":63523,"_27488":63523,"_5":13476,"_2643":105265,"_27831":105266,"_19100":105269,"_26023":63523},"Despliega desde AWS Marketplace",[44764,105267,105268],"Despliegue","Otros modelos",[],{"_3144":63524,"_27488":63523,"_19100":105271,"_5":13150,"_26023":63523,"_2643":105272},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3144":63525,"_27488":63523,"_5":27828,"_19100":105274,"_26023":105275,"_2643":105276},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3144":63526,"_27488":63523,"_5":27828,"_19100":105278,"_26023":105279,"_2643":105280},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3144":63527,"_27488":63523,"_5":27828,"_19100":105282,"_26023":105283,"_2643":105284},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3144":63528,"_27488":63523,"_5":27828,"_19100":105286,"_26023":105287,"_2643":105288},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3144":63529,"_27488":63523,"_5":27828,"_19100":105290,"_26023":105291,"_2643":105292},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3144":63530,"_27488":63523,"_5":27828,"_19100":105294,"_26023":105295,"_2643":105296},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3144":63531,"_27488":63523,"_5":27828,"_19100":105298,"_26023":105299,"_2643":105300},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3144":63532,"_27488":63523,"_19100":105302,"_5":13150,"_26023":63523,"_2643":105303},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3144":63533,"_27488":63523,"_19100":105305,"_5":13150,"_26023":105275,"_2643":105306},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3144":63534,"_27488":63523,"_19100":105308,"_5":13150,"_26023":105275,"_2643":105309},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3144":63535,"_27488":63523,"_19100":105311,"_5":13150,"_26023":105275,"_2643":105312},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3144":63536,"_27488":63523,"_19100":105314,"_5":13150,"_26023":105279,"_2643":105315},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3144":63537,"_27488":63523,"_19100":105317,"_5":13150,"_26023":105279,"_2643":105318},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3144":63538,"_27488":63523,"_19100":105320,"_5":13150,"_26023":105279,"_2643":105321},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3144":63539,"_27488":63523,"_19100":105323,"_5":13150,"_26023":105283,"_2643":105324},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3144":63540,"_27488":63523,"_19100":105326,"_5":13150,"_26023":105287,"_2643":105327},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3144":63541,"_27488":63523,"_19100":105329,"_5":13150,"_26023":105291,"_2643":105330},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3144":63542,"_27488":63523,"_19100":105332,"_5":13150,"_26023":105295,"_2643":105333},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3144":63543,"_27488":63523,"_19100":105335,"_5":13150,"_26023":105299,"_2643":105336},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3144":63544,"_27488":63544,"_5":13476,"_2643":105338,"_27831":105339,"_19100":105340,"_26023":63544},"Despliega Lamassu",[44764,105267],[],{"_3144":63545,"_27488":63544,"_19100":105342,"_5":13150,"_26023":63544,"_2643":105343},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3144":63546,"_27488":63544,"_5":27828,"_19100":105345,"_26023":105346,"_2643":105347},[],"/docs/pr-preview/pr-26/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3144":63547,"_27488":63544,"_5":27828,"_19100":105349,"_26023":105350,"_2643":105351},[],"/docs/pr-preview/pr-26/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3144":63548,"_27488":63544,"_5":27828,"_19100":105353,"_26023":105354,"_2643":105355},[],"/docs/pr-preview/pr-26/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3144":63549,"_27488":63544,"_19100":105357,"_5":13150,"_26023":63544,"_2643":105358},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3144":63550,"_27488":63544,"_19100":105360,"_5":13150,"_26023":105346,"_2643":105361},[],"Modelo",{"_3144":63551,"_27488":63544,"_19100":105363,"_5":13150,"_26023":105346,"_2643":105364},[],"Recomendado para",{"_3144":63552,"_27488":63544,"_19100":105366,"_5":13150,"_26023":105346,"_2643":105367},[],"Quién opera la infraestructura",{"_3144":63553,"_27488":63544,"_19100":105369,"_5":13150,"_26023":105346,"_2643":105370},[],"Punto de partida",{"_3144":63554,"_27488":63544,"_19100":105372,"_5":13150,"_26023":105346,"_2643":44871},[],{"_3144":63555,"_27488":63544,"_19100":105374,"_5":13150,"_26023":105346,"_2643":105375},[],"Producción, entornos regulados y despliegues personalizados",{"_3144":63556,"_27488":63544,"_19100":105377,"_5":13150,"_26023":105346,"_2643":105378},[],"Tu equipo",{"_3144":63557,"_27488":63544,"_19100":105380,"_5":13150,"_26023":105346,"_2643":105381},[],"Helm o Fastlane",{"_3144":63558,"_27488":63544,"_19100":105383,"_5":13150,"_26023":105346,"_2643":44883},[],{"_3144":63559,"_27488":63544,"_19100":105385,"_5":13150,"_26023":105346,"_2643":105386},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3144":63560,"_27488":63544,"_19100":105388,"_5":13150,"_26023":105346,"_2643":105378},[],{"_3144":63561,"_27488":63544,"_19100":105390,"_5":13150,"_26023":105346,"_2643":105391},[],"Imagen preconfigurada en EC2",{"_3144":63562,"_27488":63544,"_19100":105393,"_5":13150,"_26023":105346,"_2643":44894},[],{"_3144":63563,"_27488":63544,"_19100":105395,"_5":13150,"_26023":105346,"_2643":105396},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3144":63564,"_27488":63544,"_19100":105398,"_5":13150,"_26023":105346,"_2643":44900},[],{"_3144":63565,"_27488":63544,"_19100":105400,"_5":13150,"_26023":105346,"_2643":105401},[],"Suscripción gestionada",{"_3144":63566,"_27488":63544,"_19100":105403,"_5":13150,"_26023":105346,"_2643":105404},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3144":63567,"_27488":63544,"_19100":105406,"_5":13150,"_26023":105346,"_2643":105407},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3144":63568,"_27488":63544,"_19100":105409,"_5":13150,"_26023":105346,"_2643":105410},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3144":63569,"_27488":63544,"_19100":105412,"_5":13150,"_26023":105350,"_2643":105413},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3144":63570,"_27488":63544,"_19100":105415,"_5":13150,"_26023":105354,"_2643":105416},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3144":63571,"_27488":63571,"_5":13476,"_2643":105418,"_27831":105419,"_19100":105420,"_26023":63571},"Utiliza Lamassu como SaaS",[44764,105267,105268],[],{"_3144":63572,"_27488":63571,"_19100":105422,"_5":13150,"_26023":63571,"_2643":105423},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3144":63573,"_27488":63571,"_5":27828,"_19100":105425,"_26023":105426,"_2643":105427},[],"/docs/pr-preview/pr-26/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3144":63574,"_27488":63571,"_5":27828,"_19100":105429,"_26023":105430,"_2643":105431},[],"/docs/pr-preview/pr-26/es/deployment/saas#planes","Planes",{"_3144":63575,"_27488":63571,"_5":27828,"_19100":105433,"_26023":105434,"_2643":105435},[],"/docs/pr-preview/pr-26/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3144":63576,"_27488":63571,"_19100":105437,"_5":13150,"_26023":63571,"_2643":105438},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3144":63577,"_27488":63571,"_19100":105440,"_5":13150,"_26023":105426,"_2643":105441},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3144":63578,"_27488":63571,"_19100":105443,"_5":13150,"_26023":105426,"_2643":105444},[],"Copias de seguridad automáticas.",{"_3144":63579,"_27488":63571,"_19100":105446,"_5":13150,"_26023":105426,"_2643":105447},[],"Actualizaciones de versión.",{"_3144":63580,"_27488":63571,"_19100":105449,"_5":13150,"_26023":105426,"_2643":105450},[],"Soporte técnico y SLA según el plan contratado.",{"_3144":63581,"_27488":63571,"_19100":105452,"_5":13150,"_26023":105430,"_2643":44955},[],{"_3144":63582,"_27488":63571,"_19100":105454,"_5":13150,"_26023":105430,"_2643":105455},[],"Dispositivos",{"_3144":63583,"_27488":63571,"_19100":105457,"_5":13150,"_26023":105430,"_2643":105458},[],"Soporte",{"_3144":63584,"_27488":63571,"_19100":105460,"_5":13150,"_26023":105430,"_2643":44964},[],{"_3144":63585,"_27488":63571,"_19100":105462,"_5":13150,"_26023":105430,"_2643":44967},[],{"_3144":63586,"_27488":63571,"_19100":105464,"_5":13150,"_26023":105430,"_2643":105465},[],"Hasta 1.000",{"_3144":63587,"_27488":63571,"_19100":105467,"_5":13150,"_26023":105430,"_2643":44973},[],{"_3144":63588,"_27488":63571,"_19100":105469,"_5":13150,"_26023":105430,"_2643":105470},[],"99,5 %",{"_3144":63589,"_27488":63571,"_19100":105472,"_5":13150,"_26023":105430,"_2643":44979},[],{"_3144":63590,"_27488":63571,"_19100":105474,"_5":13150,"_26023":105430,"_2643":105475},[],"Hasta 10.000",{"_3144":63591,"_27488":63571,"_19100":105477,"_5":13150,"_26023":105430,"_2643":105478},[],"Email y chat",{"_3144":63592,"_27488":63571,"_19100":105480,"_5":13150,"_26023":105430,"_2643":105481},[],"99,9 %",{"_3144":63593,"_27488":63571,"_19100":105483,"_5":13150,"_26023":105430,"_2643":44991},[],{"_3144":63594,"_27488":63571,"_19100":105485,"_5":13150,"_26023":105430,"_2643":105486},[],"Ilimitados",{"_3144":63595,"_27488":63571,"_19100":105488,"_5":13150,"_26023":105430,"_2643":105489},[],"Dedicado",{"_3144":63596,"_27488":63571,"_19100":105491,"_5":13150,"_26023":105430,"_2643":105492},[],"99,99 %",{"_3144":63597,"_27488":63571,"_19100":105494,"_5":13150,"_26023":105434,"_2643":105495},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3144":63598,"_27488":63571,"_19100":105497,"_5":13150,"_26023":105434,"_2643":105498},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3144":63599,"_27488":63599,"_5":13476,"_2643":45008,"_27831":105500,"_19100":105502,"_26023":63599},[44764,105267,105501],"Kubernetes autogestionado",[],{"_3144":63600,"_27488":63599,"_19100":105504,"_5":13150,"_26023":63599,"_2643":105505},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3144":63601,"_27488":63599,"_5":27828,"_19100":105507,"_26023":105508,"_2643":105509},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3144":63602,"_27488":63599,"_5":27828,"_19100":105511,"_26023":105512,"_2643":105513},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3144":63603,"_27488":63599,"_5":27828,"_19100":105515,"_26023":105516,"_2643":105517},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3144":63604,"_27488":63599,"_5":27828,"_19100":105519,"_26023":105520,"_2643":105521},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3144":63605,"_27488":63599,"_5":27828,"_19100":105523,"_26023":105524,"_2643":105525},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3144":63606,"_27488":63599,"_5":27828,"_19100":105527,"_26023":105528,"_2643":105529},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3144":63607,"_27488":63599,"_5":27828,"_19100":105531,"_26023":105532,"_2643":105533},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3144":63608,"_27488":63599,"_5":27828,"_19100":105535,"_26023":105536,"_2643":105537},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3144":63609,"_27488":63599,"_5":27828,"_19100":105539,"_26023":105540,"_2643":105541},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3144":63610,"_27488":63599,"_5":27828,"_19100":105543,"_26023":105544,"_2643":105545},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3144":63611,"_27488":63599,"_5":27828,"_19100":105547,"_26023":105548,"_2643":105549},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3144":63612,"_27488":63599,"_19100":105551,"_5":13150,"_26023":105508,"_2643":105552},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3144":63613,"_27488":63599,"_19100":105554,"_5":13150,"_26023":105508,"_2643":105555},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3144":63614,"_27488":63599,"_19100":105557,"_5":13150,"_26023":105512,"_2643":105558},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3144":63615,"_27488":63599,"_19100":105560,"_5":13150,"_26023":105512,"_2643":105561},[],"Fastlane instala o configura",{"_3144":63616,"_27488":63599,"_19100":105563,"_5":13150,"_26023":105512,"_2643":105564},[],"Tú sigues proporcionando",{"_3144":63617,"_27488":63599,"_19100":105566,"_5":13150,"_26023":105512,"_2643":105567},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3144":63618,"_27488":63599,"_19100":105569,"_5":13150,"_26023":105512,"_2643":105570},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3144":63619,"_27488":63599,"_19100":105572,"_5":13150,"_26023":105512,"_2643":105573},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3144":63620,"_27488":63599,"_19100":105575,"_5":13150,"_26023":105512,"_2643":105576},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3144":63621,"_27488":63599,"_19100":105578,"_5":13150,"_26023":105512,"_2643":105579},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3144":63622,"_27488":63599,"_19100":105581,"_5":13150,"_26023":105512,"_2643":105582},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3144":63623,"_27488":63599,"_19100":105584,"_5":13150,"_26023":105512,"_2643":105585},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3144":63624,"_27488":63599,"_19100":105587,"_5":13150,"_26023":105512,"_2643":105588},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3144":63625,"_27488":63599,"_19100":105590,"_5":13150,"_26023":105512,"_2643":105591},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3144":63626,"_27488":63599,"_19100":105593,"_5":13150,"_26023":105516,"_2643":105594},[],"Necesitas:",{"_3144":63627,"_27488":63599,"_19100":105596,"_5":13150,"_26023":105516,"_2643":105597},[],"un clúster Kubernetes existente",{"_3144":63628,"_27488":63599,"_19100":105599,"_5":13150,"_26023":105516,"_2643":105600},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3144":63629,"_27488":63599,"_19100":105602,"_5":13150,"_26023":105516,"_2643":45110},[],{"_3144":63630,"_27488":63599,"_19100":105604,"_5":13150,"_26023":105516,"_2643":21626},[],{"_3144":63631,"_27488":63599,"_19100":105606,"_5":13150,"_26023":105516,"_2643":105607},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3144":63632,"_27488":63599,"_19100":105609,"_5":13150,"_26023":105516,"_2643":105610},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3144":63633,"_27488":63599,"_19100":105612,"_5":13150,"_26023":105516,"_2643":105613},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3144":63634,"_27488":63599,"_19100":105615,"_5":13150,"_26023":105516,"_2643":105616},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3144":63635,"_27488":63599,"_19100":105618,"_5":13150,"_26023":105516,"_2643":105619},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3144":63636,"_27488":63599,"_19100":105621,"_5":13150,"_26023":105520,"_2643":105622},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3144":63637,"_27488":63599,"_19100":105624,"_5":13150,"_26023":105520,"_2643":105625},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3144":63638,"_27488":63599,"_19100":105627,"_5":13150,"_26023":105524,"_2643":105628},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3144":63639,"_27488":63599,"_19100":105630,"_5":13150,"_26023":105524,"_2643":105631},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3144":63640,"_27488":63599,"_19100":105633,"_5":13150,"_26023":105524,"_2643":105634},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3144":63641,"_27488":63599,"_19100":105636,"_5":13150,"_26023":105524,"_2643":105637},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3144":63642,"_27488":63599,"_19100":105639,"_5":13150,"_26023":105528,"_2643":105640},[],"Opción",{"_3144":63643,"_27488":63599,"_19100":105642,"_5":13150,"_26023":105528,"_2643":105643},[],"Valor predeterminado",{"_3144":63644,"_27488":63599,"_19100":105645,"_5":13150,"_26023":105528,"_2643":105646},[],"Propósito",{"_3144":63645,"_27488":63599,"_19100":105648,"_5":13150,"_26023":105528,"_2643":45157},[],{"_3144":63646,"_27488":63599,"_19100":105650,"_5":13150,"_26023":105528,"_2643":45160},[],{"_3144":63647,"_27488":63599,"_19100":105652,"_5":13150,"_26023":105528,"_2643":105653},[],"Muestra la ayuda",{"_3144":63648,"_27488":63599,"_19100":105655,"_5":13150,"_26023":105528,"_2643":45166},[],{"_3144":63649,"_27488":63599,"_19100":105657,"_5":13150,"_26023":105528,"_2643":105658},[],"contexto actual",{"_3144":63650,"_27488":63599,"_19100":105660,"_5":13150,"_26023":105528,"_2643":105661},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3144":63651,"_27488":63599,"_19100":105663,"_5":13150,"_26023":105528,"_2643":45175},[],{"_3144":63652,"_27488":63599,"_19100":105665,"_5":13150,"_26023":105528,"_2643":5889},[],{"_3144":63653,"_27488":63599,"_19100":105667,"_5":13150,"_26023":105528,"_2643":105668},[],"Omite prompts y genera credenciales para las dependencias",{"_3144":63654,"_27488":63599,"_19100":105670,"_5":13150,"_26023":105528,"_2643":45183},[],{"_3144":63655,"_27488":63599,"_19100":105672,"_5":13150,"_26023":105528,"_2643":45186},[],{"_3144":63656,"_27488":63599,"_19100":105674,"_5":13150,"_26023":105528,"_2643":105675},[],"Namespace de la instalación",{"_3144":63657,"_27488":63599,"_19100":105677,"_5":13150,"_26023":105528,"_2643":45192},[],{"_3144":63658,"_27488":63599,"_19100":105679,"_5":13150,"_26023":105528,"_2643":45195},[],{"_3144":63659,"_27488":63599,"_19100":105681,"_5":13150,"_26023":105528,"_2643":105682},[],"Dominio usado por la UI, OIDC y el certificado",{"_3144":63660,"_27488":63599,"_19100":105684,"_5":13150,"_26023":105528,"_2643":45201},[],{"_3144":63661,"_27488":63599,"_19100":105686,"_5":13150,"_26023":105528,"_2643":13735},[],{"_3144":63662,"_27488":63599,"_19100":105688,"_5":13150,"_26023":105528,"_2643":105689},[],"Versión del chart de Lamassu",{"_3144":63663,"_27488":63599,"_19100":105691,"_5":13150,"_26023":105528,"_2643":45209},[],{"_3144":63664,"_27488":63599,"_19100":105693,"_5":13150,"_26023":105528,"_2643":45212},[],{"_3144":63665,"_27488":63599,"_19100":105695,"_5":13150,"_26023":105528,"_2643":105696},[],"Puerto del listener HTTPS",{"_3144":63666,"_27488":63599,"_19100":105698,"_5":13150,"_26023":105528,"_2643":45218},[],{"_3144":63667,"_27488":63599,"_19100":105700,"_5":13150,"_26023":105528,"_2643":45221},[],{"_3144":63668,"_27488":63599,"_19100":105702,"_5":13150,"_26023":105528,"_2643":105703},[],"Puerto del listener HTTP",{"_3144":63669,"_27488":63599,"_19100":105705,"_5":13150,"_26023":105528,"_2643":45227},[],{"_3144":63670,"_27488":63599,"_19100":105707,"_5":13150,"_26023":105528,"_2643":45160},[],{"_3144":63671,"_27488":63599,"_19100":105709,"_5":13150,"_26023":105528,"_2643":105710},[],"Certificado PEM para TLS downstream",{"_3144":63672,"_27488":63599,"_19100":105712,"_5":13150,"_26023":105528,"_2643":45235},[],{"_3144":63673,"_27488":63599,"_19100":105714,"_5":13150,"_26023":105528,"_2643":45160},[],{"_3144":63674,"_27488":63599,"_19100":105716,"_5":13150,"_26023":105528,"_2643":105717},[],"Clave privada PEM para TLS downstream",{"_3144":63675,"_27488":63599,"_19100":105719,"_5":13150,"_26023":105528,"_2643":45243},[],{"_3144":63676,"_27488":63599,"_19100":105721,"_5":13150,"_26023":105528,"_2643":105722},[],"chart del repositorio",{"_3144":63677,"_27488":63599,"_19100":105724,"_5":13150,"_26023":105528,"_2643":105725},[],"Usa un chart local de Lamassu sin empaquetar",{"_3144":63678,"_27488":63599,"_19100":105727,"_5":13150,"_26023":105528,"_2643":45252},[],{"_3144":63679,"_27488":63599,"_19100":105729,"_5":13150,"_26023":105528,"_2643":105730},[],"detección automática",{"_3144":63680,"_27488":63599,"_19100":105732,"_5":13150,"_26023":105528,"_2643":105733},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3144":63681,"_27488":63599,"_19100":105735,"_5":13150,"_26023":105528,"_2643":45260},[],{"_3144":63682,"_27488":63599,"_19100":105737,"_5":13150,"_26023":105528,"_2643":5889},[],{"_3144":63683,"_27488":63599,"_19100":105739,"_5":13150,"_26023":105528,"_2643":105740},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3144":63684,"_27488":63599,"_19100":105742,"_5":13150,"_26023":105528,"_2643":45268},[],{"_3144":63685,"_27488":63599,"_19100":105744,"_5":13150,"_26023":105528,"_2643":5889},[],{"_3144":63686,"_27488":63599,"_19100":105746,"_5":13150,"_26023":105528,"_2643":105747},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3144":63687,"_27488":63599,"_19100":105749,"_5":13150,"_26023":105528,"_2643":45276},[],{"_3144":63688,"_27488":63599,"_19100":105751,"_5":13150,"_26023":105528,"_2643":5889},[],{"_3144":63689,"_27488":63599,"_19100":105753,"_5":13150,"_26023":105528,"_2643":105754},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3144":63690,"_27488":63599,"_19100":105756,"_5":13150,"_26023":105528,"_2643":45284},[],{"_3144":63691,"_27488":63599,"_19100":105758,"_5":13150,"_26023":105528,"_2643":5889},[],{"_3144":63692,"_27488":63599,"_19100":105760,"_5":13150,"_26023":105528,"_2643":105761},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3144":63693,"_27488":63599,"_19100":105763,"_5":13150,"_26023":105528,"_2643":45292},[],{"_3144":63694,"_27488":63599,"_19100":105765,"_5":13150,"_26023":105528,"_2643":45295},[],{"_3144":63695,"_27488":63599,"_19100":105767,"_5":13150,"_26023":105528,"_2643":105768},[],"Usa otro chart local de SoftHSM",{"_3144":63696,"_27488":63599,"_19100":105770,"_5":13150,"_26023":105528,"_2643":105771},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3144":63697,"_27488":63599,"_19100":105773,"_5":13150,"_26023":105532,"_2643":105774},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3144":63698,"_27488":63599,"_19100":105776,"_5":13150,"_26023":105532,"_2643":105777},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3144":63699,"_27488":63599,"_19100":105779,"_5":13150,"_26023":105532,"_2643":105780},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3144":63700,"_27488":63599,"_19100":105782,"_5":13150,"_26023":105532,"_2643":105783},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3144":63701,"_27488":63599,"_19100":105785,"_5":13150,"_26023":105532,"_2643":105786},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3144":63702,"_27488":63599,"_19100":105788,"_5":13150,"_26023":105532,"_2643":105789},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3144":63703,"_27488":63599,"_19100":105791,"_5":13150,"_26023":105536,"_2643":45322},[],{"_3144":63704,"_27488":63599,"_19100":105793,"_5":13150,"_26023":105536,"_2643":105794},[],"valida las herramientas locales y el clúster seleccionado",{"_3144":63705,"_27488":63599,"_19100":105796,"_5":13150,"_26023":105536,"_2643":105797},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3144":63706,"_27488":63599,"_19100":105799,"_5":13150,"_26023":105536,"_2643":105800},[],"crea el namespace",{"_3144":63707,"_27488":63599,"_19100":105802,"_5":13150,"_26023":105536,"_2643":105803},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3144":63708,"_27488":63599,"_19100":105805,"_5":13150,"_26023":105536,"_2643":105806},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3144":63709,"_27488":63599,"_19100":105808,"_5":13150,"_26023":105536,"_2643":105809},[],"instala RabbitMQ",{"_3144":63710,"_27488":63599,"_19100":105811,"_5":13150,"_26023":105536,"_2643":105812},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3144":63711,"_27488":63599,"_19100":105814,"_5":13150,"_26023":105536,"_2643":105815},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3144":63712,"_27488":63599,"_19100":105817,"_5":13150,"_26023":105536,"_2643":105818},[],"carga datos de ejemplo opcionalmente",{"_3144":63713,"_27488":63599,"_19100":105820,"_5":13150,"_26023":105536,"_2643":105821},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3144":63714,"_27488":63599,"_19100":105823,"_5":13150,"_26023":105540,"_2643":105824},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3144":63715,"_27488":63599,"_19100":105826,"_5":13150,"_26023":105540,"_2643":105827},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3144":63716,"_27488":63599,"_19100":105829,"_5":13150,"_26023":105544,"_2643":105830},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3144":63717,"_27488":63599,"_19100":105832,"_5":13150,"_26023":105544,"_2643":105833},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3144":63718,"_27488":63599,"_19100":105835,"_5":13150,"_26023":105544,"_2643":105836},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3144":63719,"_27488":63599,"_19100":105838,"_5":13150,"_26023":105548,"_2643":105839},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3144":63720,"_27488":63720,"_5":13476,"_2643":105841,"_27831":105842,"_19100":105843,"_26023":63720},"Instala con Helm",[44764,105267,105501],[],{"_3144":63721,"_27488":63720,"_19100":105845,"_5":13150,"_26023":63720,"_2643":105846},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3144":63722,"_27488":63720,"_5":27828,"_19100":105848,"_26023":105849,"_2643":105850},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3144":63723,"_27488":63720,"_5":27828,"_19100":105852,"_26023":105853,"_2643":105517},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3144":63724,"_27488":63720,"_5":27828,"_19100":105855,"_26023":105856,"_2643":105857},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3144":63725,"_27488":63720,"_5":27828,"_19100":105859,"_26023":105860,"_2643":105861},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3144":63726,"_27488":63720,"_5":27828,"_19100":105863,"_26023":105864,"_2643":105865},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3144":63727,"_27488":63720,"_5":27828,"_19100":105867,"_26023":105868,"_2643":105869},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3144":63728,"_27488":63720,"_5":27828,"_19100":105871,"_26023":105872,"_2643":105873},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3144":63729,"_27488":63720,"_5":27828,"_19100":105875,"_26023":105876,"_2643":105877},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3144":63730,"_27488":63720,"_5":27828,"_19100":105879,"_26023":105880,"_2643":105881},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3144":63731,"_27488":63720,"_19100":105883,"_5":13150,"_26023":105849,"_2643":105884},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3144":63732,"_27488":63720,"_19100":105886,"_5":13150,"_26023":105853,"_2643":105887},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3144":63733,"_27488":63720,"_19100":105889,"_5":13150,"_26023":105853,"_2643":105890},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3144":63734,"_27488":63720,"_19100":105892,"_5":13150,"_26023":105853,"_2643":105893},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3144":63735,"_27488":63720,"_19100":105895,"_5":13150,"_26023":105853,"_2643":105896},[],"un broker RabbitMQ accesible y sus credenciales",{"_3144":63736,"_27488":63720,"_19100":105898,"_5":13150,"_26023":105853,"_2643":105899},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3144":63737,"_27488":63720,"_19100":105901,"_5":13150,"_26023":105853,"_2643":105902},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3144":63738,"_27488":63720,"_19100":105904,"_5":13150,"_26023":105853,"_2643":105905},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3144":63739,"_27488":63720,"_19100":105907,"_5":13150,"_26023":105853,"_2643":105908},[],"una StorageClass y un diseño de tráfico externo",{"_3144":63740,"_27488":63720,"_19100":105910,"_5":13150,"_26023":105853,"_2643":105911},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3144":63741,"_27488":63720,"_19100":105913,"_5":13150,"_26023":105853,"_2643":105914},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3144":63742,"_27488":63720,"_19100":105916,"_5":13150,"_26023":105853,"_2643":105917},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3144":63743,"_27488":63720,"_19100":105919,"_5":13150,"_26023":105856,"_2643":105920},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3144":63744,"_27488":63720,"_19100":105922,"_5":13150,"_26023":105856,"_2643":105923},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3144":63745,"_27488":63720,"_19100":105925,"_5":13150,"_26023":105856,"_2643":105926},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_3144":63746,"_27488":63720,"_19100":105928,"_5":13150,"_26023":105860,"_2643":105929},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3144":63747,"_27488":63720,"_19100":105931,"_5":13150,"_26023":105860,"_2643":105932},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3144":63748,"_27488":63720,"_19100":105934,"_5":13150,"_26023":105860,"_2643":105935},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3144":63749,"_27488":63720,"_19100":105937,"_5":13150,"_26023":105864,"_2643":105938},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_3144":63750,"_27488":63720,"_19100":105940,"_5":13150,"_26023":105868,"_2643":105941},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3144":63751,"_27488":63720,"_19100":105943,"_5":13150,"_26023":105868,"_2643":105944},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3144":63752,"_27488":63720,"_19100":105946,"_5":13150,"_26023":105868,"_2643":105947},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3144":63753,"_27488":63720,"_19100":105949,"_5":13150,"_26023":105868,"_2643":105950},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3144":63754,"_27488":63720,"_19100":105952,"_5":13150,"_26023":105872,"_2643":105953},[],"Para instalar un checkout local:",{"_3144":63755,"_27488":63720,"_19100":105955,"_5":13150,"_26023":105876,"_2643":105956},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3144":63756,"_27488":63720,"_19100":105958,"_5":13150,"_26023":105876,"_2643":105959},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3144":63757,"_27488":63720,"_19100":105961,"_5":13150,"_26023":105880,"_2643":105962},[],"Antes de pasar a producción, revisa:",{"_3144":63758,"_27488":63720,"_19100":105964,"_5":13150,"_26023":105880,"_2643":105965},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3144":63759,"_27488":63720,"_19100":105967,"_5":13150,"_26023":105880,"_2643":105968},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3144":63760,"_27488":63720,"_19100":105970,"_5":13150,"_26023":105880,"_2643":105971},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3144":63761,"_27488":63720,"_19100":105973,"_5":13150,"_26023":105880,"_2643":105974},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3144":63762,"_27488":63720,"_19100":105976,"_5":13150,"_26023":105880,"_2643":105977},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3144":63763,"_27488":63720,"_19100":105979,"_5":13150,"_26023":105880,"_2643":105980},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3144":63764,"_27488":63720,"_19100":105982,"_5":13150,"_26023":105880,"_2643":105983},[],"SMTP, observabilidad y entrega de alertas",{"_3144":63765,"_27488":63720,"_19100":105985,"_5":13150,"_26023":105880,"_2643":105986},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3144":63766,"_27488":63720,"_19100":105988,"_5":13150,"_26023":105880,"_2643":105989},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3144":63767,"_27488":63767,"_5":13476,"_2643":105991,"_27831":105992,"_19100":105993,"_26023":63767},"Expón el Gateway",[44764,105267,105501],[],{"_3144":63768,"_27488":63767,"_19100":105995,"_5":13150,"_26023":63767,"_2643":105996},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3144":63769,"_27488":63767,"_5":27828,"_19100":105998,"_26023":105999,"_2643":106000},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3144":63770,"_27488":63767,"_5":27828,"_19100":106002,"_26023":106003,"_2643":106004},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3144":63771,"_27488":63767,"_5":27828,"_19100":106006,"_26023":106007,"_2643":106008},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3144":63772,"_27488":63767,"_5":27828,"_19100":106010,"_26023":106011,"_2643":45543},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#k3s",{"_3144":63773,"_27488":63767,"_5":27828,"_19100":106013,"_26023":106014,"_2643":106015},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3144":63774,"_27488":63767,"_5":27828,"_19100":106017,"_26023":106018,"_2643":106019},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3144":63775,"_27488":63767,"_5":27828,"_19100":106021,"_26023":106022,"_2643":106023},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3144":63776,"_27488":63767,"_5":27828,"_19100":106025,"_26023":106026,"_2643":106027},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3144":63777,"_27488":63767,"_5":27828,"_19100":106029,"_26023":106030,"_2643":106031},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3144":63778,"_27488":63767,"_19100":106033,"_5":13150,"_26023":105999,"_2643":106034},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3144":63779,"_27488":63767,"_19100":106036,"_5":13150,"_26023":105999,"_2643":106037},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3144":63780,"_27488":63767,"_19100":106039,"_5":13150,"_26023":106003,"_2643":106040},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3144":63781,"_27488":63767,"_19100":106042,"_5":13150,"_26023":106003,"_2643":106043},[],"Defínelo únicamente cuando:",{"_3144":63782,"_27488":63767,"_19100":106045,"_5":13150,"_26023":106003,"_2643":106046},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3144":63783,"_27488":63767,"_19100":106048,"_5":13150,"_26023":106003,"_2643":106049},[],"esa dirección está asignada a este Gateway",{"_3144":63784,"_27488":63767,"_19100":106051,"_5":13150,"_26023":106003,"_2643":106052},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3144":63785,"_27488":63767,"_19100":106054,"_5":13150,"_26023":106003,"_2643":106055},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3144":63786,"_27488":63767,"_19100":106057,"_5":13150,"_26023":106003,"_2643":106058},[],"No confundas estos valores:",{"_3144":63787,"_27488":63767,"_19100":106060,"_5":13150,"_26023":106003,"_2643":106061},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3144":63788,"_27488":63767,"_19100":106063,"_5":13150,"_26023":106003,"_2643":106064},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3144":63789,"_27488":63767,"_19100":106066,"_5":13150,"_26023":106003,"_2643":106067},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3144":63790,"_27488":63767,"_19100":106069,"_5":13150,"_26023":106007,"_2643":106070},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3144":63791,"_27488":63767,"_19100":106072,"_5":13150,"_26023":106007,"_2643":106073},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3144":63792,"_27488":63767,"_19100":106075,"_5":13150,"_26023":106011,"_2643":106076},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3144":63793,"_27488":63767,"_19100":106078,"_5":13150,"_26023":106011,"_2643":106079},[],"Para el diseño recomendado:",{"_3144":63794,"_27488":63767,"_19100":106081,"_5":13150,"_26023":106011,"_2643":106082},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3144":63795,"_27488":63767,"_19100":106084,"_5":13150,"_26023":106011,"_2643":106085},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3144":63796,"_27488":63767,"_19100":106087,"_5":13150,"_26023":106011,"_2643":106088},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3144":63797,"_27488":63767,"_19100":106090,"_5":13150,"_26023":106011,"_2643":106091},[],"Apunta DNS a la dirección accesible de la VM.",{"_3144":63798,"_27488":63767,"_19100":106093,"_5":13150,"_26023":106011,"_2643":106094},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3144":63799,"_27488":63767,"_19100":106096,"_5":13150,"_26023":106014,"_2643":106097},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3144":63800,"_27488":63767,"_19100":106099,"_5":13150,"_26023":106018,"_2643":106100},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3144":63801,"_27488":63767,"_19100":106102,"_5":13150,"_26023":106018,"_2643":106103},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3144":63802,"_27488":63767,"_19100":106105,"_5":13150,"_26023":106022,"_2643":106106},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3144":63803,"_27488":63767,"_19100":106108,"_5":13150,"_26023":106022,"_2643":106109},[],"Requisito",{"_3144":63804,"_27488":63767,"_19100":106111,"_5":13150,"_26023":106022,"_2643":106112},[],"Diseño recomendado",{"_3144":63805,"_27488":63767,"_19100":106114,"_5":13150,"_26023":106022,"_2643":106115},[],"Consecuencia",{"_3144":63806,"_27488":63767,"_19100":106117,"_5":13150,"_26023":106022,"_2643":106118},[],"Varias URL o servicios de Lamassu",{"_3144":63807,"_27488":63767,"_19100":106120,"_5":13150,"_26023":106022,"_2643":106121},[],"Un Gateway con varias rutas",{"_3144":63808,"_27488":63767,"_19100":106123,"_5":13150,"_26023":106022,"_2643":106124},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3144":63809,"_27488":63767,"_19100":106126,"_5":13150,"_26023":106022,"_2643":106127},[],"Gateways independientes e IP externas distintas",{"_3144":63810,"_27488":63767,"_19100":106129,"_5":13150,"_26023":106022,"_2643":106130},[],"Una VIP por Gateway",{"_3144":63811,"_27488":63767,"_19100":106132,"_5":13150,"_26023":106022,"_2643":106133},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3144":63812,"_27488":63767,"_19100":106135,"_5":13150,"_26023":106022,"_2643":106136},[],"Gateways independientes, un nodo y una IP",{"_3144":63813,"_27488":63767,"_19100":106138,"_5":13150,"_26023":106022,"_2643":106139},[],"Puertos externos diferentes",{"_3144":63814,"_27488":63767,"_19100":106141,"_5":13150,"_26023":106022,"_2643":106142},[],"Los clientes deben indicar puertos no estándar",{"_3144":63815,"_27488":63767,"_19100":106144,"_5":13150,"_26023":106022,"_2643":106145},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3144":63816,"_27488":63767,"_19100":106147,"_5":13150,"_26023":106022,"_2643":106148},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3144":63817,"_27488":63767,"_19100":106150,"_5":13150,"_26023":106022,"_2643":106151},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3144":63818,"_27488":63767,"_19100":106153,"_5":13150,"_26023":106022,"_2643":106154},[],"Recursos Gateway separados pero proxy compartido",{"_3144":63819,"_27488":63767,"_19100":106156,"_5":13150,"_26023":106022,"_2643":106157},[],"Modo merged Gateway de Envoy",{"_3144":63820,"_27488":63767,"_19100":106159,"_5":13150,"_26023":106022,"_2643":106160},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3144":63821,"_27488":63767,"_19100":106162,"_5":13150,"_26023":106022,"_2643":106163},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3144":63822,"_27488":63767,"_19100":106165,"_5":13150,"_26023":106022,"_2643":106166},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3144":63823,"_27488":63767,"_19100":106168,"_5":13150,"_26023":106022,"_2643":106169},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3144":63824,"_27488":63767,"_19100":106171,"_5":13150,"_26023":106022,"_2643":106172},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3144":63825,"_27488":63767,"_19100":106174,"_5":13150,"_26023":106026,"_2643":106175},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3144":63826,"_27488":63767,"_19100":106177,"_5":13150,"_26023":106026,"_2643":106178},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3144":63827,"_27488":63767,"_19100":106180,"_5":13150,"_26023":106026,"_2643":106181},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3144":63828,"_27488":63767,"_19100":106183,"_5":13150,"_26023":106026,"_2643":106184},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3144":63829,"_27488":63767,"_19100":106186,"_5":13150,"_26023":106026,"_2643":106187},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3144":63830,"_27488":63767,"_19100":106189,"_5":13150,"_26023":106030,"_2643":106190},[],"Comprueba, en orden:",{"_3144":63831,"_27488":63767,"_19100":106192,"_5":13150,"_26023":106030,"_2643":106193},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3144":63832,"_27488":63767,"_19100":106195,"_5":13150,"_26023":106030,"_2643":106196},[],"Su estado contiene la dirección esperada.",{"_3144":63833,"_27488":63767,"_19100":106198,"_5":13150,"_26023":106030,"_2643":106199},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3144":63834,"_27488":63767,"_19100":106201,"_5":13150,"_26023":106030,"_2643":106202},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3144":63835,"_27488":63767,"_19100":106204,"_5":13150,"_26023":106030,"_2643":106205},[],"DNS resuelve al endpoint accesible externamente.",{"_3144":63836,"_27488":63767,"_19100":106207,"_5":13150,"_26023":106030,"_2643":106208},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3144":63837,"_27488":63767,"_19100":106210,"_5":13150,"_26023":106030,"_2643":106211},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3144":63838,"_27488":63838,"_5":13476,"_2643":44871,"_27831":106213,"_19100":106214,"_26023":63838},[44764,105267,105501],[],{"_3144":63839,"_27488":63838,"_19100":106216,"_5":13150,"_26023":63838,"_2643":106217},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3144":63840,"_27488":63838,"_5":27828,"_19100":106219,"_26023":106220,"_2643":106221},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3144":63841,"_27488":63838,"_5":27828,"_19100":106223,"_26023":106224,"_2643":106225},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3144":63842,"_27488":63838,"_5":27828,"_19100":106227,"_26023":106228,"_2643":106229},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3144":63843,"_27488":63838,"_5":27828,"_19100":106231,"_26023":106232,"_2643":106233},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3144":63844,"_27488":63838,"_5":27828,"_19100":106235,"_26023":106236,"_2643":106237},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3144":63845,"_27488":63838,"_5":27828,"_19100":106239,"_26023":106240,"_2643":106241},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3144":63846,"_27488":63838,"_19100":106243,"_5":13150,"_26023":106220,"_2643":106244},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3144":63847,"_27488":63838,"_19100":106246,"_5":13150,"_26023":106224,"_2643":106247},[],"Flujo",{"_3144":63848,"_27488":63838,"_19100":106249,"_5":13150,"_26023":106224,"_2643":106250},[],"Úsalo para",{"_3144":63849,"_27488":63838,"_19100":106252,"_5":13150,"_26023":106224,"_2643":106253},[],"Qué instala",{"_3144":63850,"_27488":63838,"_19100":106255,"_5":13150,"_26023":106224,"_2643":45788},[],{"_3144":63851,"_27488":63838,"_19100":106257,"_5":13150,"_26023":106224,"_2643":106258},[],"Producción y entornos controlados",{"_3144":63852,"_27488":63838,"_19100":106260,"_5":13150,"_26023":106224,"_2643":106261},[],"Servicios de Lamassu y recursos de Gateway API",{"_3144":63853,"_27488":63838,"_19100":106263,"_5":13150,"_26023":106224,"_2643":45008},[],{"_3144":63854,"_27488":63838,"_19100":106265,"_5":13150,"_26023":106224,"_2643":106266},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3144":63855,"_27488":63838,"_19100":106268,"_5":13150,"_26023":106224,"_2643":106269},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3144":63856,"_27488":63838,"_19100":106271,"_5":13150,"_26023":106228,"_2643":106272},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3144":63857,"_27488":63838,"_19100":106274,"_5":13150,"_26023":106228,"_2643":106275},[],"Área",{"_3144":63858,"_27488":63838,"_19100":106277,"_5":13150,"_26023":106228,"_2643":106278},[],"El chart de Lamassu proporciona",{"_3144":63859,"_27488":63838,"_19100":106280,"_5":13150,"_26023":106228,"_2643":106281},[],"Tú proporcionas",{"_3144":63860,"_27488":63838,"_19100":106283,"_5":13150,"_26023":106228,"_2643":106284},[],"Aplicaciones Lamassu",{"_3144":63861,"_27488":63838,"_19100":106286,"_5":13150,"_26023":106228,"_2643":106287},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3144":63862,"_27488":63838,"_19100":106289,"_5":13150,"_26023":106228,"_2643":106290},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3144":63863,"_27488":63838,"_19100":106292,"_5":13150,"_26023":106228,"_2643":106293},[],"Datos PostgreSQL",{"_3144":63864,"_27488":63838,"_19100":106295,"_5":13150,"_26023":106228,"_2643":106296},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3144":63865,"_27488":63838,"_19100":106298,"_5":13150,"_26023":106228,"_2643":106299},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3144":63866,"_27488":63838,"_19100":106301,"_5":13150,"_26023":106228,"_2643":106302},[],"Mensajería",{"_3144":63867,"_27488":63838,"_19100":106304,"_5":13150,"_26023":106228,"_2643":106305},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3144":63868,"_27488":63838,"_19100":106307,"_5":13150,"_26023":106228,"_2643":106308},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3144":63869,"_27488":63838,"_19100":106310,"_5":13150,"_26023":106228,"_2643":106311},[],"Identidad",{"_3144":63870,"_27488":63838,"_19100":106313,"_5":13150,"_26023":106228,"_2643":106314},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3144":63871,"_27488":63838,"_19100":106316,"_5":13150,"_26023":106228,"_2643":106317},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3144":63872,"_27488":63838,"_19100":106319,"_5":13150,"_26023":106228,"_2643":106320},[],"Enrutamiento externo",{"_3144":63873,"_27488":63838,"_19100":106322,"_5":13150,"_26023":106228,"_2643":106323},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3144":63874,"_27488":63838,"_19100":106325,"_5":13150,"_26023":106228,"_2643":106326},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3144":63875,"_27488":63838,"_19100":106328,"_5":13150,"_26023":106228,"_2643":45862},[],{"_3144":63876,"_27488":63838,"_19100":106330,"_5":13150,"_26023":106228,"_2643":106331},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_3144":63877,"_27488":63838,"_19100":106333,"_5":13150,"_26023":106228,"_2643":106334},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3144":63878,"_27488":63838,"_19100":106336,"_5":13150,"_26023":106228,"_2643":106337},[],"Datos persistentes de la aplicación",{"_3144":63879,"_27488":63838,"_19100":106339,"_5":13150,"_26023":106228,"_2643":106340},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3144":63880,"_27488":63838,"_19100":106342,"_5":13150,"_26023":106228,"_2643":106343},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3144":63881,"_27488":63838,"_19100":106345,"_5":13150,"_26023":106228,"_2643":106346},[],"Integraciones opcionales",{"_3144":63882,"_27488":63838,"_19100":106348,"_5":13150,"_26023":106228,"_2643":106349},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3144":63883,"_27488":63838,"_19100":106351,"_5":13150,"_26023":106228,"_2643":106352},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3144":63884,"_27488":63838,"_19100":106354,"_5":13150,"_26023":106228,"_2643":106355},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3144":63885,"_27488":63838,"_19100":106357,"_5":13150,"_26023":106228,"_2643":106358},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3144":63886,"_27488":63838,"_19100":106360,"_5":13150,"_26023":106232,"_2643":106361},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3144":63887,"_27488":63838,"_19100":106363,"_5":13150,"_26023":106232,"_2643":106364},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3144":63888,"_27488":63838,"_19100":106366,"_5":13150,"_26023":106236,"_2643":106367},[],"Kubernetes 1.24 o posterior",{"_3144":63889,"_27488":63838,"_19100":106369,"_5":13150,"_26023":106236,"_2643":106370},[],"Helm 3.2 o posterior",{"_3144":63890,"_27488":63838,"_19100":106372,"_5":13150,"_26023":106236,"_2643":106373},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3144":63891,"_27488":63838,"_19100":106375,"_5":13150,"_26023":106236,"_2643":106376},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_3144":63892,"_27488":63838,"_19100":106378,"_5":13150,"_26023":106236,"_2643":106379},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3144":63893,"_27488":63838,"_19100":106381,"_5":13150,"_26023":106236,"_2643":106382},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3144":63894,"_27488":63838,"_19100":106384,"_5":13150,"_26023":106236,"_2643":106385},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3144":63895,"_27488":63838,"_19100":106387,"_5":13150,"_26023":106240,"_2643":106388},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3144":63896,"_27488":63838,"_19100":106390,"_5":13150,"_26023":106240,"_2643":106391},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3144":63897,"_27488":63838,"_19100":106393,"_5":13150,"_26023":106240,"_2643":106394},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3144":63898,"_27488":63838,"_19100":106396,"_5":13150,"_26023":106240,"_2643":106397},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3144":63899,"_27488":63899,"_5":13476,"_2643":106399,"_27831":106400,"_19100":106402,"_26023":63899},"Resolución de problemas de despliegue",[44764,105267,106401],"Operación",[],{"_3144":63900,"_27488":63899,"_19100":106404,"_5":13150,"_26023":63899,"_2643":106405},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3144":63901,"_27488":63899,"_5":27828,"_19100":106407,"_26023":106408,"_2643":106409},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3144":63902,"_27488":63899,"_5":27828,"_19100":106411,"_26023":106412,"_2643":106413},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3144":63903,"_27488":63899,"_5":27828,"_19100":106415,"_26023":106416,"_2643":106417},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3144":63904,"_27488":63899,"_5":27828,"_19100":106419,"_26023":106420,"_2643":106421},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3144":63905,"_27488":63899,"_5":27828,"_19100":106423,"_26023":106424,"_2643":106425},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3144":63906,"_27488":63899,"_5":27828,"_19100":106427,"_26023":106428,"_2643":106429},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3144":63907,"_27488":63899,"_5":27828,"_19100":106431,"_26023":106432,"_2643":106433},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3144":63908,"_27488":63899,"_5":27828,"_19100":106435,"_26023":106436,"_2643":106437},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3144":63909,"_27488":63899,"_5":27828,"_19100":106439,"_26023":106440,"_2643":106441},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3144":63910,"_27488":63899,"_5":27828,"_19100":106443,"_26023":106444,"_2643":106445},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3144":63911,"_27488":63899,"_5":27828,"_19100":106447,"_26023":106448,"_2643":106449},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3144":63912,"_27488":63899,"_5":27828,"_19100":106451,"_26023":106452,"_2643":106453},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3144":63913,"_27488":63899,"_19100":106455,"_5":13150,"_26023":63899,"_2643":106456},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3144":63914,"_27488":63899,"_19100":106458,"_5":13150,"_26023":106412,"_2643":106459},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3144":63915,"_27488":63899,"_19100":106461,"_5":13150,"_26023":106416,"_2643":106462},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3144":63916,"_27488":63899,"_19100":106464,"_5":13150,"_26023":106420,"_2643":106465},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3144":63917,"_27488":63899,"_19100":106467,"_5":13150,"_26023":106424,"_2643":106468},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3144":63918,"_27488":63899,"_19100":106470,"_5":13150,"_26023":106428,"_2643":106471},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3144":63919,"_27488":63899,"_19100":106473,"_5":13150,"_26023":106432,"_2643":106474},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3144":63920,"_27488":63899,"_19100":106476,"_5":13150,"_26023":106432,"_2643":106477},[],"Ejecuta también la prueba de conectividad del chart:",{"_3144":63921,"_27488":63899,"_19100":106479,"_5":13150,"_26023":106432,"_2643":106480},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3144":63922,"_27488":63899,"_19100":106482,"_5":13150,"_26023":106432,"_2643":106483},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3144":63923,"_27488":63899,"_19100":106485,"_5":13150,"_26023":106436,"_2643":106486},[],"Si recibes un 401:",{"_3144":63924,"_27488":63899,"_19100":106488,"_5":13150,"_26023":106436,"_2643":106489},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3144":63925,"_27488":63899,"_19100":106491,"_5":13150,"_26023":106436,"_2643":106492},[],"verifica emisor, audiencia y expiración del token;",{"_3144":63926,"_27488":63899,"_19100":106494,"_5":13150,"_26023":106436,"_2643":106495},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3144":63927,"_27488":63899,"_19100":106497,"_5":13150,"_26023":106436,"_2643":106498},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3144":63928,"_27488":63899,"_19100":106500,"_5":13150,"_26023":106436,"_2643":106501},[],"Si el login termina pero las APIs devuelven 403:",{"_3144":63929,"_27488":63899,"_19100":106503,"_5":13150,"_26023":106436,"_2643":106504},[],"inspecciona los claims reales del token;",{"_3144":63930,"_27488":63899,"_19100":106506,"_5":13150,"_26023":106436,"_2643":106507},[],"confirma que coinciden con un principal activo;",{"_3144":63931,"_27488":63899,"_19100":106509,"_5":13150,"_26023":106436,"_2643":106510},[],"revisa las políticas concedidas al principal;",{"_3144":63932,"_27488":63899,"_19100":106512,"_5":13150,"_26023":106436,"_2643":106513},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3144":63933,"_27488":63899,"_19100":106515,"_5":13150,"_26023":106436,"_2643":106516},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3144":63934,"_27488":63899,"_19100":106518,"_5":13150,"_26023":106440,"_2643":106519},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3144":63935,"_27488":63899,"_19100":106521,"_5":13150,"_26023":106440,"_2643":106522},[],"Localiza el pod y Service de authz.",{"_3144":63936,"_27488":63899,"_19100":106524,"_5":13150,"_26023":106440,"_2643":106525},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3144":63937,"_27488":63899,"_19100":106527,"_5":13150,"_26023":106440,"_2643":106528},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3144":63938,"_27488":63899,"_19100":106530,"_5":13150,"_26023":106440,"_2643":106531},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3144":63939,"_27488":63899,"_19100":106533,"_5":13150,"_26023":106440,"_2643":106534},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3144":63940,"_27488":63899,"_19100":106536,"_5":13150,"_26023":106444,"_2643":106537},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3144":63941,"_27488":63899,"_19100":106539,"_5":13150,"_26023":106444,"_2643":106540},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3144":63942,"_27488":63899,"_19100":106542,"_5":13150,"_26023":106444,"_2643":106543},[],"volumen persistente sin enlazar;",{"_3144":63943,"_27488":63899,"_19100":106545,"_5":13150,"_26023":106444,"_2643":106546},[],"imagen inaccesible o política de pull incorrecta;",{"_3144":63944,"_27488":63899,"_19100":106548,"_5":13150,"_26023":106444,"_2643":106549},[],"configuración inválida del motor criptográfico;",{"_3144":63945,"_27488":63899,"_19100":106551,"_5":13150,"_26023":106444,"_2643":106552},[],"límites de CPU o memoria demasiado bajos;",{"_3144":63946,"_27488":63899,"_19100":106554,"_5":13150,"_26023":106444,"_2643":106555},[],"migración previa incompleta.",{"_3144":63947,"_27488":63899,"_19100":106557,"_5":13150,"_26023":106444,"_2643":106558},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3144":63948,"_27488":63899,"_19100":106560,"_5":13150,"_26023":106444,"_2643":106561},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3144":63949,"_27488":63899,"_19100":106563,"_5":13150,"_26023":106448,"_2643":106564},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3144":63950,"_27488":63899,"_19100":106566,"_5":13150,"_26023":106448,"_2643":106567},[],"verifica que esté habilitado en el servicio emisor;",{"_3144":63951,"_27488":63899,"_19100":106569,"_5":13150,"_26023":106448,"_2643":106570},[],"comprueba conectividad y credenciales AMQP;",{"_3144":63952,"_27488":63899,"_19100":106572,"_5":13150,"_26023":106448,"_2643":106573},[],"revisa exchange, routing key, colas y consumidores;",{"_3144":63953,"_27488":63899,"_19100":106575,"_5":13150,"_26023":106448,"_2643":106576},[],"inspecciona dead-letter queues;",{"_3144":63954,"_27488":63899,"_19100":106578,"_5":13150,"_26023":106448,"_2643":106579},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3144":63955,"_27488":63899,"_19100":106581,"_5":13150,"_26023":106448,"_2643":106582},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3144":63956,"_27488":63899,"_19100":106584,"_5":13150,"_26023":106452,"_2643":106585},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3144":63957,"_27488":63899,"_19100":106587,"_5":13150,"_26023":106452,"_2643":106588},[],"Antes de cerrar una incidencia, guarda:",{"_3144":63958,"_27488":63899,"_19100":106590,"_5":13150,"_26023":106452,"_2643":106591},[],"causa confirmada;",{"_3144":63959,"_27488":63899,"_19100":106593,"_5":13150,"_26023":106452,"_2643":106594},[],"alcance temporal y recursos afectados;",{"_3144":63960,"_27488":63899,"_19100":106596,"_5":13150,"_26023":106452,"_2643":106597},[],"comandos o consultas utilizados;",{"_3144":63961,"_27488":63899,"_19100":106599,"_5":13150,"_26023":106452,"_2643":106600},[],"cambio aplicado y forma de revertirlo;",{"_3144":63962,"_27488":63899,"_19100":106602,"_5":13150,"_26023":106452,"_2643":106603},[],"validación desde un consumidor;",{"_3144":63963,"_27488":63899,"_19100":106605,"_5":13150,"_26023":106452,"_2643":106606},[],"acción preventiva y propietario.",{"_3144":63964,"_27488":63964,"_5":13476,"_2643":106608,"_27831":106609,"_19100":106612,"_26023":63964},"Control de acceso",[44764,106610,106611],"Plataforma","Administración",[],{"_3144":63965,"_27488":63964,"_19100":106614,"_5":13150,"_26023":63964,"_2643":106615},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3144":63966,"_27488":63964,"_5":27828,"_19100":106617,"_26023":106618,"_2643":106619},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3144":63967,"_27488":63964,"_5":27828,"_19100":106621,"_26023":106622,"_2643":106623},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3144":63968,"_27488":63964,"_5":27828,"_19100":106625,"_26023":106626,"_2643":106627},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3144":63969,"_27488":63964,"_5":27828,"_19100":106629,"_26023":106630,"_2643":106631},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3144":63970,"_27488":63964,"_5":27828,"_19100":106633,"_26023":106634,"_2643":106635},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3144":63971,"_27488":63964,"_5":27828,"_19100":106637,"_26023":106638,"_2643":106639},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3144":63972,"_27488":63964,"_5":27828,"_19100":106641,"_26023":106642,"_2643":106643},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3144":63973,"_27488":63964,"_5":27828,"_19100":106645,"_26023":106646,"_2643":106647},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3144":63974,"_27488":63964,"_5":27828,"_19100":106649,"_26023":106650,"_2643":106651},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3144":63975,"_27488":63964,"_5":27828,"_19100":106653,"_26023":106654,"_2643":106655},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3144":63976,"_27488":63964,"_5":27828,"_19100":106657,"_26023":106658,"_2643":106659},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3144":63977,"_27488":63964,"_5":27828,"_19100":106661,"_26023":106662,"_2643":106663},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3144":63978,"_27488":63964,"_5":27828,"_19100":106665,"_26023":106666,"_2643":106667},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3144":63979,"_27488":63964,"_5":27828,"_19100":106669,"_26023":106670,"_2643":106671},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3144":63980,"_27488":63964,"_5":27828,"_19100":106673,"_26023":106674,"_2643":106675},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3144":63981,"_27488":63964,"_5":27828,"_19100":106677,"_26023":106678,"_2643":105869},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3144":63982,"_27488":63964,"_5":27828,"_19100":106680,"_26023":106681,"_2643":106682},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3144":63983,"_27488":63964,"_5":27828,"_19100":106684,"_26023":106685,"_2643":106686},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_3144":63984,"_27488":63964,"_5":27828,"_19100":106688,"_26023":106689,"_2643":106690},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3144":63985,"_27488":63964,"_5":27828,"_19100":106692,"_26023":106693,"_2643":106694},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3144":63986,"_27488":63964,"_5":27828,"_19100":106696,"_26023":106697,"_2643":106698},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3144":63987,"_27488":63964,"_5":27828,"_19100":106700,"_26023":106701,"_2643":106702},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3144":63988,"_27488":63964,"_5":27828,"_19100":106704,"_26023":106705,"_2643":106706},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3144":63989,"_27488":63964,"_5":27828,"_19100":106708,"_26023":106709,"_2643":106710},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3144":63990,"_27488":63964,"_5":27828,"_19100":106712,"_26023":106713,"_2643":106714},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3144":63991,"_27488":63964,"_5":27828,"_19100":106716,"_26023":106717,"_2643":106718},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3144":63992,"_27488":63964,"_5":27828,"_19100":106720,"_26023":106721,"_2643":106722},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3144":63993,"_27488":63964,"_5":27828,"_19100":106724,"_26023":106725,"_2643":106726},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3144":63994,"_27488":63964,"_5":27828,"_19100":106728,"_26023":106729,"_2643":106730},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3144":63995,"_27488":63964,"_5":27828,"_19100":106732,"_26023":106733,"_2643":106734},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3144":63996,"_27488":63964,"_5":27828,"_19100":106736,"_26023":106737,"_2643":106738},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3144":63997,"_27488":63964,"_19100":106740,"_5":13150,"_26023":63964,"_2643":106741},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3144":63998,"_27488":63964,"_19100":106743,"_5":13150,"_26023":63964,"_2643":106744},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3144":63999,"_27488":63964,"_19100":106746,"_5":13150,"_26023":63964,"_2643":106747},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3144":64000,"_27488":63964,"_19100":106749,"_5":13150,"_26023":106618,"_2643":106750},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3144":64001,"_27488":63964,"_19100":106752,"_5":13150,"_26023":106618,"_2643":106753},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3144":64002,"_27488":63964,"_19100":106755,"_5":13150,"_26023":106618,"_2643":106756},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3144":64003,"_27488":63964,"_19100":106758,"_5":13150,"_26023":106618,"_2643":106759},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3144":64004,"_27488":63964,"_19100":106761,"_5":13150,"_26023":106618,"_2643":106762},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3144":64005,"_27488":63964,"_19100":106764,"_5":13150,"_26023":106618,"_2643":106765},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3144":64006,"_27488":63964,"_19100":106767,"_5":13150,"_26023":106622,"_2643":106768},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3144":64007,"_27488":63964,"_19100":106770,"_5":13150,"_26023":106622,"_2643":106771},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3144":64008,"_27488":63964,"_19100":106773,"_5":13150,"_26023":106626,"_2643":106774},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3144":64009,"_27488":63964,"_19100":106776,"_5":13150,"_26023":106626,"_2643":106777},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3144":64010,"_27488":63964,"_19100":106779,"_5":13150,"_26023":106626,"_2643":106780},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3144":64011,"_27488":63964,"_19100":106782,"_5":13150,"_26023":106626,"_2643":106783},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3144":64012,"_27488":63964,"_19100":106785,"_5":13150,"_26023":106626,"_2643":106786},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3144":64013,"_27488":63964,"_19100":106788,"_5":13150,"_26023":106626,"_2643":106789},[],"Carga por separado las políticas concedidas a cada principal.",{"_3144":64014,"_27488":63964,"_19100":106791,"_5":13150,"_26023":106626,"_2643":106792},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3144":64015,"_27488":63964,"_19100":106794,"_5":13150,"_26023":106626,"_2643":106795},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3144":64016,"_27488":63964,"_19100":106797,"_5":13150,"_26023":106626,"_2643":106798},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3144":64017,"_27488":63964,"_19100":106800,"_5":13150,"_26023":106626,"_2643":106801},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3144":64018,"_27488":63964,"_19100":106803,"_5":13150,"_26023":106626,"_2643":106804},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3144":64019,"_27488":63964,"_19100":106806,"_5":13150,"_26023":106626,"_2643":106807},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3144":64020,"_27488":63964,"_19100":106809,"_5":13150,"_26023":106630,"_2643":106810},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3144":64021,"_27488":63964,"_19100":106812,"_5":13150,"_26023":106630,"_2643":106813},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3144":64022,"_27488":63964,"_19100":106815,"_5":13150,"_26023":106630,"_2643":106816},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3144":64023,"_27488":63964,"_19100":106818,"_5":13150,"_26023":106630,"_2643":106819},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3144":64024,"_27488":63964,"_19100":106821,"_5":13150,"_26023":106630,"_2643":106822},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3144":64025,"_27488":63964,"_19100":106824,"_5":13150,"_26023":106630,"_2643":106825},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3144":64026,"_27488":63964,"_19100":106827,"_5":13150,"_26023":106630,"_2643":106828},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3144":64027,"_27488":63964,"_19100":106830,"_5":13150,"_26023":106630,"_2643":106831},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3144":64028,"_27488":63964,"_19100":106833,"_5":13150,"_26023":106634,"_2643":106834},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3144":64029,"_27488":63964,"_19100":106836,"_5":13150,"_26023":106634,"_2643":106837},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3144":64030,"_27488":63964,"_19100":106839,"_5":13150,"_26023":106634,"_2643":106840},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3144":64031,"_27488":63964,"_19100":106842,"_5":13150,"_26023":106634,"_2643":106843},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3144":64032,"_27488":63964,"_19100":106845,"_5":13150,"_26023":106634,"_2643":106846},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3144":64033,"_27488":63964,"_19100":106848,"_5":13150,"_26023":106634,"_2643":106849},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3144":64034,"_27488":63964,"_19100":106851,"_5":13150,"_26023":106634,"_2643":106852},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3144":64035,"_27488":63964,"_19100":106854,"_5":13150,"_26023":106634,"_2643":106855},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3144":64036,"_27488":63964,"_19100":106857,"_5":13150,"_26023":106634,"_2643":106858},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3144":64037,"_27488":63964,"_19100":106860,"_5":13150,"_26023":106634,"_2643":106861},[],"Las acciones se dividen en dos grupos:",{"_3144":64038,"_27488":63964,"_19100":106863,"_5":13150,"_26023":106634,"_2643":106864},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3144":64039,"_27488":63964,"_19100":106866,"_5":13150,"_26023":106634,"_2643":106867},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3144":64040,"_27488":63964,"_19100":106869,"_5":13150,"_26023":106634,"_2643":106870},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3144":64041,"_27488":63964,"_19100":106872,"_5":13150,"_26023":106638,"_2643":106873},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3144":64042,"_27488":63964,"_19100":106875,"_5":13150,"_26023":106638,"_2643":106876},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3144":64043,"_27488":63964,"_19100":106878,"_5":13150,"_26023":106638,"_2643":106879},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3144":64044,"_27488":63964,"_19100":106881,"_5":13150,"_26023":106642,"_2643":106882},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3144":64045,"_27488":63964,"_19100":106884,"_5":13150,"_26023":106642,"_2643":106885},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3144":64046,"_27488":63964,"_19100":106887,"_5":13150,"_26023":106642,"_2643":106888},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3144":64047,"_27488":63964,"_19100":106890,"_5":13150,"_26023":106642,"_2643":106891},[],"Los operadores implementados son:",{"_3144":64048,"_27488":63964,"_19100":106893,"_5":13150,"_26023":106642,"_2643":106894},[],"`equals`, para igualdad exacta;",{"_3144":64049,"_27488":63964,"_19100":106896,"_5":13150,"_26023":106642,"_2643":106897},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3144":64050,"_27488":63964,"_19100":106899,"_5":13150,"_26023":106642,"_2643":106900},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3144":64051,"_27488":63964,"_19100":106902,"_5":13150,"_26023":106642,"_2643":106903},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3144":64052,"_27488":63964,"_19100":106905,"_5":13150,"_26023":106646,"_2643":106906},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3144":64053,"_27488":63964,"_19100":106908,"_5":13150,"_26023":106646,"_2643":106909},[],"Los modos disponibles son:",{"_3144":64054,"_27488":63964,"_19100":106911,"_5":13150,"_26023":106646,"_2643":106912},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3144":64055,"_27488":63964,"_19100":106914,"_5":13150,"_26023":106646,"_2643":106915},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3144":64056,"_27488":63964,"_19100":106917,"_5":13150,"_26023":106646,"_2643":106918},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3144":64057,"_27488":63964,"_19100":106920,"_5":13150,"_26023":106646,"_2643":106921},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3144":64058,"_27488":63964,"_19100":106923,"_5":13150,"_26023":106646,"_2643":106924},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3144":64059,"_27488":63964,"_19100":106926,"_5":13150,"_26023":106646,"_2643":106927},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3144":64060,"_27488":63964,"_19100":106929,"_5":13150,"_26023":106650,"_2643":106930},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3144":64061,"_27488":63964,"_19100":106932,"_5":13150,"_26023":106650,"_2643":106933},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3144":64062,"_27488":63964,"_19100":106935,"_5":13150,"_26023":106650,"_2643":106936},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3144":64063,"_27488":63964,"_19100":106938,"_5":13150,"_26023":106650,"_2643":106939},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3144":64064,"_27488":63964,"_19100":106941,"_5":13150,"_26023":106658,"_2643":106942},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3144":64065,"_27488":63964,"_19100":106944,"_5":13150,"_26023":106658,"_2643":106945},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3144":64066,"_27488":63964,"_19100":106947,"_5":13150,"_26023":106662,"_2643":106948},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3144":64067,"_27488":63964,"_19100":106950,"_5":13150,"_26023":106662,"_2643":106951},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3144":64068,"_27488":63964,"_19100":106953,"_5":13150,"_26023":106666,"_2643":106954},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3144":64069,"_27488":63964,"_19100":106956,"_5":13150,"_26023":106666,"_2643":106957},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3144":64070,"_27488":63964,"_19100":106959,"_5":13150,"_26023":106666,"_2643":106960},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3144":64071,"_27488":63964,"_19100":106962,"_5":13150,"_26023":106670,"_2643":106963},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3144":64072,"_27488":63964,"_19100":106965,"_5":13150,"_26023":106670,"_2643":106966},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3144":64073,"_27488":63964,"_19100":106968,"_5":13150,"_26023":106670,"_2643":106969},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3144":64074,"_27488":63964,"_19100":106971,"_5":13150,"_26023":106670,"_2643":106972},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3144":64075,"_27488":63964,"_19100":106974,"_5":13150,"_26023":106670,"_2643":106975},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3144":64076,"_27488":63964,"_19100":106977,"_5":13150,"_26023":106670,"_2643":106978},[],"Ten en cuenta que:",{"_3144":64077,"_27488":63964,"_19100":106980,"_5":13150,"_26023":106670,"_2643":106981},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3144":64078,"_27488":63964,"_19100":106983,"_5":13150,"_26023":106670,"_2643":106984},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3144":64079,"_27488":63964,"_19100":106986,"_5":13150,"_26023":106670,"_2643":106987},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3144":64080,"_27488":63964,"_19100":106989,"_5":13150,"_26023":106674,"_2643":106990},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3144":64081,"_27488":63964,"_19100":106992,"_5":13150,"_26023":106674,"_2643":106993},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3144":64082,"_27488":63964,"_19100":106995,"_5":13150,"_26023":106674,"_2643":106996},[],"acceso completo y de solo lectura a KMS;",{"_3144":64083,"_27488":63964,"_19100":106998,"_5":13150,"_26023":106674,"_2643":106999},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3144":64084,"_27488":63964,"_19100":107001,"_5":13150,"_26023":106674,"_2643":107002},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3144":64085,"_27488":63964,"_19100":107004,"_5":13150,"_26023":106674,"_2643":107005},[],"acceso a la interfaz;",{"_3144":64086,"_27488":63964,"_19100":107007,"_5":13150,"_26023":106674,"_2643":107008},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3144":64087,"_27488":63964,"_19100":107010,"_5":13150,"_26023":106674,"_2643":107011},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3144":64088,"_27488":63964,"_19100":107013,"_5":13150,"_26023":106674,"_2643":107014},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3144":64089,"_27488":63964,"_19100":107016,"_5":13150,"_26023":106678,"_2643":107017},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3144":64090,"_27488":63964,"_19100":107019,"_5":13150,"_26023":106678,"_2643":107020},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3144":64091,"_27488":63964,"_19100":107022,"_5":13150,"_26023":106678,"_2643":107023},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3144":64092,"_27488":63964,"_19100":107025,"_5":13150,"_26023":106681,"_2643":107026},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3144":64093,"_27488":63964,"_19100":107028,"_5":13150,"_26023":106685,"_2643":107029},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_3144":64094,"_27488":63964,"_19100":107031,"_5":13150,"_26023":106689,"_2643":107032},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3144":64095,"_27488":63964,"_19100":107034,"_5":13150,"_26023":106693,"_2643":107035},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3144":64096,"_27488":63964,"_19100":107037,"_5":13150,"_26023":106697,"_2643":107038},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3144":64097,"_27488":63964,"_19100":107040,"_5":13150,"_26023":106701,"_2643":107041},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3144":64098,"_27488":63964,"_19100":107043,"_5":13150,"_26023":106701,"_2643":107044},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3144":64099,"_27488":63964,"_19100":107046,"_5":13150,"_26023":106705,"_2643":107047},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3144":64100,"_27488":63964,"_19100":107049,"_5":13150,"_26023":106705,"_2643":107050},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3144":64101,"_27488":63964,"_19100":107052,"_5":13150,"_26023":106705,"_2643":107053},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3144":64102,"_27488":63964,"_19100":107055,"_5":13150,"_26023":106705,"_2643":107056},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3144":64103,"_27488":63964,"_19100":107058,"_5":13150,"_26023":106705,"_2643":107059},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3144":64104,"_27488":63964,"_19100":107061,"_5":13150,"_26023":106705,"_2643":107062},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3144":64105,"_27488":63964,"_19100":107064,"_5":13150,"_26023":106705,"_2643":107065},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3144":64106,"_27488":63964,"_19100":107067,"_5":13150,"_26023":106705,"_2643":107068},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3144":64107,"_27488":63964,"_19100":107070,"_5":13150,"_26023":106709,"_2643":107071},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3144":64108,"_27488":63964,"_19100":107073,"_5":13150,"_26023":106709,"_2643":107074},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3144":64109,"_27488":63964,"_19100":107076,"_5":13150,"_26023":106709,"_2643":107077},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3144":64110,"_27488":63964,"_19100":107079,"_5":13150,"_26023":106713,"_2643":107080},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3144":64111,"_27488":63964,"_19100":107082,"_5":13150,"_26023":106713,"_2643":107083},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3144":64112,"_27488":63964,"_19100":107085,"_5":13150,"_26023":106713,"_2643":107086},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3144":64113,"_27488":63964,"_19100":107088,"_5":13150,"_26023":106713,"_2643":107089},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3144":64114,"_27488":63964,"_19100":107091,"_5":13150,"_26023":106713,"_2643":107092},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3144":64115,"_27488":63964,"_19100":107094,"_5":13150,"_26023":106713,"_2643":107095},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3144":64116,"_27488":63964,"_19100":107097,"_5":13150,"_26023":106713,"_2643":107098},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3144":64117,"_27488":63964,"_19100":107100,"_5":13150,"_26023":106713,"_2643":107101},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3144":64118,"_27488":63964,"_19100":107103,"_5":13150,"_26023":106721,"_2643":107104},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3144":64119,"_27488":63964,"_19100":107106,"_5":13150,"_26023":106725,"_2643":107107},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3144":64120,"_27488":63964,"_19100":107109,"_5":13150,"_26023":106725,"_2643":107110},[],"que exista un principal activo del tipo correcto;",{"_3144":64121,"_27488":63964,"_19100":107112,"_5":13150,"_26023":106725,"_2643":107113},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3144":64122,"_27488":63964,"_19100":107115,"_5":13150,"_26023":106725,"_2643":107116},[],"que todas las condiciones del principal se cumplan;",{"_3144":64123,"_27488":63964,"_19100":107118,"_5":13150,"_26023":106725,"_2643":107119},[],"que el principal tenga concedida la política esperada;",{"_3144":64124,"_27488":63964,"_19100":107121,"_5":13150,"_26023":106725,"_2643":107122},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3144":64125,"_27488":63964,"_19100":107124,"_5":13150,"_26023":106725,"_2643":107125},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3144":64126,"_27488":63964,"_19100":107127,"_5":13150,"_26023":106725,"_2643":107128},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3144":64127,"_27488":63964,"_19100":107130,"_5":13150,"_26023":106729,"_2643":107131},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3144":64128,"_27488":63964,"_19100":107133,"_5":13150,"_26023":106733,"_2643":107134},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3144":64129,"_27488":63964,"_19100":107136,"_5":13150,"_26023":106737,"_2643":107137},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3144":64130,"_27488":63964,"_19100":107139,"_5":13150,"_26023":106737,"_2643":107140},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3144":64131,"_27488":64131,"_5":13476,"_2643":107142,"_27831":107143,"_19100":107144,"_26023":64131},"Alertas y suscripciones",[44764,106610,106611],[],{"_3144":64132,"_27488":64131,"_19100":107146,"_5":13150,"_26023":64131,"_2643":107147},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3144":64133,"_27488":64131,"_5":27828,"_19100":107149,"_26023":107150,"_2643":107151},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3144":64134,"_27488":64131,"_5":27828,"_19100":107153,"_26023":107154,"_2643":107155},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3144":64135,"_27488":64131,"_5":27828,"_19100":107157,"_26023":107158,"_2643":107159},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3144":64136,"_27488":64131,"_5":27828,"_19100":107161,"_26023":107162,"_2643":107163},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3144":64137,"_27488":64131,"_5":27828,"_19100":107165,"_26023":107166,"_2643":107167},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3144":64138,"_27488":64131,"_5":27828,"_19100":107169,"_26023":107170,"_2643":107171},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3144":64139,"_27488":64131,"_5":27828,"_19100":107173,"_26023":107174,"_2643":107175},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3144":64140,"_27488":64131,"_5":27828,"_19100":107177,"_26023":107178,"_2643":107179},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3144":64141,"_27488":64131,"_5":27828,"_19100":107181,"_26023":107182,"_2643":107183},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3144":64142,"_27488":64131,"_5":27828,"_19100":107185,"_26023":107186,"_2643":107187},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3144":64143,"_27488":64131,"_19100":107189,"_5":13150,"_26023":64131,"_2643":107190},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3144":64144,"_27488":64131,"_19100":107192,"_5":13150,"_26023":107150,"_2643":107193},[],"Un servicio publica un evento de dominio.",{"_3144":64145,"_27488":64131,"_19100":107195,"_5":13150,"_26023":107150,"_2643":107196},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3144":64146,"_27488":64131,"_19100":107198,"_5":13150,"_26023":107150,"_2643":107199},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3144":64147,"_27488":64131,"_19100":107201,"_5":13150,"_26023":107150,"_2643":107202},[],"Lamassu entrega el evento al canal configurado.",{"_3144":64148,"_27488":64131,"_19100":107204,"_5":13150,"_26023":107150,"_2643":107205},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3144":64149,"_27488":64131,"_19100":107207,"_5":13150,"_26023":107154,"_2643":107208},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3144":64150,"_27488":64131,"_19100":107210,"_5":13150,"_26023":107154,"_2643":107211},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3144":64151,"_27488":64131,"_19100":107213,"_5":13150,"_26023":107154,"_2643":107214},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3144":64152,"_27488":64131,"_19100":107216,"_5":13150,"_26023":107154,"_2643":107217},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3144":64153,"_27488":64131,"_19100":107219,"_5":13150,"_26023":107154,"_2643":107220},[],"`apikey_options` necesita `header` y `key`.",{"_3144":64154,"_27488":64131,"_19100":107222,"_5":13150,"_26023":107154,"_2643":107223},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3144":64155,"_27488":64131,"_19100":107225,"_5":13150,"_26023":107154,"_2643":107226},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3144":64156,"_27488":64131,"_19100":107228,"_5":13150,"_26023":107154,"_2643":107229},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3144":64157,"_27488":64131,"_19100":107231,"_5":13150,"_26023":107162,"_2643":107232},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3144":64158,"_27488":64131,"_19100":107234,"_5":13150,"_26023":107166,"_2643":107235},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3144":64159,"_27488":64131,"_19100":107237,"_5":13150,"_26023":107170,"_2643":107238},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3144":64160,"_27488":64131,"_19100":107240,"_5":13150,"_26023":107170,"_2643":107241},[],"**None** notifica todas las instancias del evento.",{"_3144":64161,"_27488":64131,"_19100":107243,"_5":13150,"_26023":107170,"_2643":107244},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3144":64162,"_27488":64131,"_19100":107246,"_5":13150,"_26023":107170,"_2643":107247},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3144":64163,"_27488":64131,"_19100":107249,"_5":13150,"_26023":107170,"_2643":107250},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3144":64164,"_27488":64131,"_19100":107252,"_5":13150,"_26023":107170,"_2643":107253},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3144":64165,"_27488":64131,"_19100":107255,"_5":13150,"_26023":107174,"_2643":107256},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3144":64166,"_27488":64131,"_19100":107258,"_5":13150,"_26023":107178,"_2643":107259},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3144":64167,"_27488":64131,"_19100":107261,"_5":13150,"_26023":107178,"_2643":107262},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3144":64168,"_27488":64131,"_19100":107264,"_5":13150,"_26023":107178,"_2643":107265},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3144":64169,"_27488":64131,"_19100":107267,"_5":13150,"_26023":107178,"_2643":107268},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3144":64170,"_27488":64131,"_19100":107270,"_5":13150,"_26023":107178,"_2643":107271},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3144":64171,"_27488":64131,"_19100":107273,"_5":13150,"_26023":107178,"_2643":107274},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3144":64172,"_27488":64131,"_19100":107276,"_5":13150,"_26023":107178,"_2643":107277},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3144":64173,"_27488":64131,"_19100":107279,"_5":13150,"_26023":107178,"_2643":107280},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3144":64174,"_27488":64131,"_19100":107282,"_5":13150,"_26023":107182,"_2643":107283},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3144":64175,"_27488":64131,"_19100":107285,"_5":13150,"_26023":107186,"_2643":107286},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3144":64176,"_27488":64131,"_19100":107288,"_5":13150,"_26023":107186,"_2643":107289},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3144":64177,"_27488":64131,"_19100":107291,"_5":13150,"_26023":107186,"_2643":107292},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3144":64178,"_27488":64131,"_19100":107294,"_5":13150,"_26023":107186,"_2643":107295},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3144":64179,"_27488":64131,"_19100":107297,"_5":13150,"_26023":107186,"_2643":107298},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3144":64180,"_27488":64131,"_19100":107300,"_5":13150,"_26023":107186,"_2643":107301},[],"**Validación:** `va.role.crl.create`.",{"_3144":64181,"_27488":64131,"_19100":107303,"_5":13150,"_26023":107186,"_2643":107304},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3144":64182,"_27488":64131,"_19100":107306,"_5":13150,"_26023":107186,"_2643":107307},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3144":64183,"_27488":64183,"_5":13476,"_2643":107309,"_27831":107310,"_19100":107311,"_26023":64183},"Registros de auditoría",[44764,106610,106611],[],{"_3144":64184,"_27488":64183,"_19100":107313,"_5":13150,"_26023":64183,"_2643":107314},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3144":64185,"_27488":64183,"_5":27828,"_19100":107316,"_26023":107317,"_2643":107318},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3144":64186,"_27488":64183,"_5":27828,"_19100":107320,"_26023":107321,"_2643":107322},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3144":64187,"_27488":64183,"_5":27828,"_19100":107324,"_26023":107325,"_2643":107326},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3144":64188,"_27488":64183,"_5":27828,"_19100":107328,"_26023":107329,"_2643":107330},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3144":64189,"_27488":64183,"_5":27828,"_19100":107332,"_26023":107333,"_2643":107334},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3144":64190,"_27488":64183,"_5":27828,"_19100":107336,"_26023":107337,"_2643":107338},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3144":64191,"_27488":64183,"_5":27828,"_19100":107340,"_26023":107341,"_2643":107342},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3144":64192,"_27488":64183,"_5":27828,"_19100":107344,"_26023":107345,"_2643":107346},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3144":64193,"_27488":64183,"_5":27828,"_19100":107348,"_26023":107349,"_2643":107350},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3144":64194,"_27488":64183,"_5":27828,"_19100":107352,"_26023":107353,"_2643":107354},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3144":64195,"_27488":64183,"_5":27828,"_19100":107356,"_26023":107357,"_2643":107358},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3144":64196,"_27488":64183,"_19100":107360,"_5":13150,"_26023":64183,"_2643":107361},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3144":64197,"_27488":64183,"_19100":107363,"_5":13150,"_26023":107317,"_2643":107364},[],"El cuerpo de auditoría incluye:",{"_3144":64198,"_27488":64183,"_19100":107366,"_5":13150,"_26023":107317,"_2643":107367},[],"input: datos recibidos por la operación;",{"_3144":64199,"_27488":64183,"_19100":107369,"_5":13150,"_26023":107317,"_2643":107370},[],"has\\_error: indica si el servicio devolvió un error;",{"_3144":64200,"_27488":64183,"_19100":107372,"_5":13150,"_26023":107317,"_2643":107373},[],"output: resultado producido o mensaje de error;",{"_3144":64201,"_27488":64183,"_19100":107375,"_5":13150,"_26023":107317,"_2643":107376},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3144":64202,"_27488":64183,"_19100":107378,"_5":13150,"_26023":107317,"_2643":107379},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3144":64203,"_27488":64183,"_19100":107381,"_5":13150,"_26023":107317,"_2643":107382},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3144":64204,"_27488":64183,"_19100":107384,"_5":13150,"_26023":107321,"_2643":107385},[],"El backend aplica auditoría a mutaciones de:",{"_3144":64205,"_27488":64183,"_19100":107387,"_5":13150,"_26023":107321,"_2643":107388},[],"autoridades, certificados y perfiles de emisión;",{"_3144":64206,"_27488":64183,"_19100":107390,"_5":13150,"_26023":107321,"_2643":107391},[],"claves y motores KMS;",{"_3144":64207,"_27488":64183,"_19100":107393,"_5":13150,"_26023":107321,"_2643":107394},[],"dispositivos e identidades;",{"_3144":64208,"_27488":64183,"_19100":107396,"_5":13150,"_26023":107321,"_2643":107397},[],"DMS y operaciones de enrolamiento;",{"_3144":64209,"_27488":64183,"_19100":107399,"_5":13150,"_26023":107321,"_2643":107400},[],"funciones de validación y CRL;",{"_3144":64210,"_27488":64183,"_19100":107402,"_5":13150,"_26023":107321,"_2643":107403},[],"principales, políticas y concesiones de autorización.",{"_3144":64211,"_27488":64183,"_19100":107405,"_5":13150,"_26023":107321,"_2643":107406},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3144":64212,"_27488":64183,"_19100":107408,"_5":13150,"_26023":107325,"_2643":107409},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3144":64213,"_27488":64183,"_19100":107411,"_5":13150,"_26023":107325,"_2643":107412},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3144":64214,"_27488":64183,"_19100":107414,"_5":13150,"_26023":107325,"_2643":107415},[],"Diseña el consumidor para:",{"_3144":64215,"_27488":64183,"_19100":107417,"_5":13150,"_26023":107325,"_2643":107418},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3144":64216,"_27488":64183,"_19100":107420,"_5":13150,"_26023":107325,"_2643":107421},[],"conservar el CloudEvent completo sin modificar;",{"_3144":64217,"_27488":64183,"_19100":107423,"_5":13150,"_26023":107325,"_2643":107424},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3144":64218,"_27488":64183,"_19100":107426,"_5":13150,"_26023":107325,"_2643":107427},[],"cifrar en tránsito y en reposo;",{"_3144":64219,"_27488":64183,"_19100":107429,"_5":13150,"_26023":107325,"_2643":107430},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3144":64220,"_27488":64183,"_19100":107432,"_5":13150,"_26023":107325,"_2643":107433},[],"aplicar una política explícita de retención y legal hold;",{"_3144":64221,"_27488":64183,"_19100":107435,"_5":13150,"_26023":107325,"_2643":107436},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3144":64222,"_27488":64183,"_19100":107438,"_5":13150,"_26023":107329,"_2643":107439},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3144":64223,"_27488":64183,"_19100":107441,"_5":13150,"_26023":107329,"_2643":107442},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3144":64224,"_27488":64183,"_19100":107444,"_5":13150,"_26023":107337,"_2643":107445},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3144":64225,"_27488":64183,"_19100":107447,"_5":13150,"_26023":107341,"_2643":107448},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3144":64226,"_27488":64183,"_19100":107450,"_5":13150,"_26023":107345,"_2643":107451},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3144":64227,"_27488":64183,"_19100":107453,"_5":13150,"_26023":107349,"_2643":107454},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3144":64228,"_27488":64183,"_19100":107456,"_5":13150,"_26023":107353,"_2643":107457},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3144":64229,"_27488":64183,"_19100":107459,"_5":13150,"_26023":107357,"_2643":107460},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3144":64230,"_27488":64183,"_19100":107462,"_5":13150,"_26023":107357,"_2643":107463},[],"aparece un evento de auditoría correcto;",{"_3144":64231,"_27488":64183,"_19100":107465,"_5":13150,"_26023":107357,"_2643":107466},[],"el principal coincide con la identidad utilizada;",{"_3144":64232,"_27488":64183,"_19100":107468,"_5":13150,"_26023":107357,"_2643":107469},[],"el consumidor lo persiste una sola vez;",{"_3144":64233,"_27488":64183,"_19100":107471,"_5":13150,"_26023":107357,"_2643":107472},[],"puede recuperarse por recurso, actor y periodo;",{"_3144":64234,"_27488":64183,"_19100":107474,"_5":13150,"_26023":107357,"_2643":107475},[],"una interrupción del consumidor produce una alerta.",{"_3144":64235,"_27488":64183,"_19100":107477,"_5":13150,"_26023":107357,"_2643":107478},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3144":64236,"_27488":64236,"_5":13476,"_2643":107480,"_27831":107481,"_19100":107482,"_26023":64236},"Arquitectura de la plataforma",[44764,106610],[],{"_3144":64237,"_27488":64236,"_19100":107484,"_5":13150,"_26023":64236,"_2643":107485},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3144":64238,"_27488":64236,"_5":27828,"_19100":107487,"_26023":107488,"_2643":107489},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3144":64239,"_27488":64236,"_5":27828,"_19100":107491,"_26023":107492,"_2643":107493},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3144":64240,"_27488":64236,"_5":27828,"_19100":107495,"_26023":107496,"_2643":107497},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3144":64241,"_27488":64236,"_5":27828,"_19100":107499,"_26023":107500,"_2643":107501},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3144":64242,"_27488":64236,"_5":27828,"_19100":107503,"_26023":107504,"_2643":107505},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3144":64243,"_27488":64236,"_19100":107507,"_5":13150,"_26023":64236,"_2643":107508},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3144":64244,"_27488":64236,"_19100":107510,"_5":13150,"_26023":64236,"_2643":107511},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3144":64245,"_27488":64236,"_19100":107513,"_5":13150,"_26023":107488,"_2643":107514},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3144":64246,"_27488":64236,"_19100":107516,"_5":13150,"_26023":107492,"_2643":107517},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3144":64247,"_27488":64236,"_19100":107519,"_5":13150,"_26023":107496,"_2643":107520},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3144":64248,"_27488":64236,"_19100":107522,"_5":13150,"_26023":107500,"_2643":107523},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3144":64249,"_27488":64236,"_19100":107525,"_5":13150,"_26023":107504,"_2643":107526},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3144":64250,"_27488":64250,"_5":13476,"_2643":107528,"_27831":107529,"_19100":107530,"_26023":64250},"Cómo funciona Lamassu",[44764,106610],[],{"_3144":64251,"_27488":64250,"_19100":107532,"_5":13150,"_26023":64250,"_2643":107533},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3144":64252,"_27488":64250,"_5":27828,"_19100":107535,"_26023":107536,"_2643":107537},[],"/docs/pr-preview/pr-26/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3144":64253,"_27488":64250,"_5":27828,"_19100":107539,"_26023":107540,"_2643":107541},[],"/docs/pr-preview/pr-26/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3144":64254,"_27488":64250,"_19100":107543,"_5":13150,"_26023":64250,"_2643":107544},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3144":64255,"_27488":64250,"_19100":107546,"_5":13150,"_26023":107536,"_2643":107547},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3144":64256,"_27488":64250,"_19100":107549,"_5":13150,"_26023":107536,"_2643":107550},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3144":64257,"_27488":64250,"_19100":107552,"_5":13150,"_26023":107536,"_2643":107553},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3144":64258,"_27488":64250,"_19100":107555,"_5":13150,"_26023":107536,"_2643":107556},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3144":64259,"_27488":64250,"_19100":107558,"_5":13150,"_26023":107536,"_2643":107559},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3144":64260,"_27488":64250,"_19100":107561,"_5":13150,"_26023":107540,"_2643":107562},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3144":64261,"_27488":64250,"_19100":107564,"_5":13150,"_26023":107540,"_2643":107565},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3144":64262,"_27488":64250,"_19100":107567,"_5":13150,"_26023":107540,"_2643":107568},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3144":64263,"_27488":64250,"_19100":107570,"_5":13150,"_26023":107540,"_2643":107571},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3144":64264,"_27488":64250,"_19100":107573,"_5":13150,"_26023":107540,"_2643":107574},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3144":64265,"_27488":64250,"_19100":107576,"_5":13150,"_26023":107540,"_2643":107577},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3144":64266,"_27488":64250,"_19100":107579,"_5":13150,"_26023":107540,"_2643":107580},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3144":64267,"_27488":64267,"_5":13476,"_2643":107582,"_27831":107583,"_19100":107584,"_26023":64267},"Dispositivos e identidades",[44764,106610,47118,107582],[],{"_3144":64268,"_27488":64267,"_19100":107586,"_5":13150,"_26023":64267,"_2643":107587},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3144":64269,"_27488":64267,"_5":27828,"_19100":107589,"_26023":107590,"_2643":107591},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3144":64270,"_27488":64267,"_5":27828,"_19100":107593,"_26023":107594,"_2643":107595},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3144":64271,"_27488":64267,"_5":27828,"_19100":107597,"_26023":107598,"_2643":107599},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3144":64272,"_27488":64267,"_5":27828,"_19100":107601,"_26023":107602,"_2643":107603},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3144":64273,"_27488":64267,"_5":27828,"_19100":107605,"_26023":107606,"_2643":107607},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3144":64274,"_27488":64267,"_5":27828,"_19100":107609,"_26023":107610,"_2643":107611},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3144":64275,"_27488":64267,"_5":27828,"_19100":107613,"_26023":107614,"_2643":107615},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3144":64276,"_27488":64267,"_5":27828,"_19100":107617,"_26023":107618,"_2643":107619},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3144":64277,"_27488":64267,"_5":27828,"_19100":107621,"_26023":107622,"_2643":107623},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3144":64278,"_27488":64267,"_5":27828,"_19100":107625,"_26023":107626,"_2643":107627},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3144":64279,"_27488":64267,"_5":27828,"_19100":107629,"_26023":107630,"_2643":107631},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3144":64280,"_27488":64267,"_19100":107633,"_5":13150,"_26023":64267,"_2643":107634},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3144":64281,"_27488":64267,"_19100":107636,"_5":13150,"_26023":64267,"_2643":107637},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3144":64282,"_27488":64267,"_19100":107639,"_5":13150,"_26023":107590,"_2643":107640},[],"Vista operativa",{"_3144":64283,"_27488":64267,"_19100":107642,"_5":13150,"_26023":107590,"_2643":107643},[],"Interpretación",{"_3144":64284,"_27488":64267,"_19100":107645,"_5":13150,"_26023":107590,"_2643":47181},[],{"_3144":64285,"_27488":64267,"_19100":107647,"_5":13150,"_26023":107590,"_2643":107648},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3144":64286,"_27488":64267,"_19100":107650,"_5":13150,"_26023":107590,"_2643":47187},[],{"_3144":64287,"_27488":64267,"_19100":107652,"_5":13150,"_26023":107590,"_2643":107653},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3144":64288,"_27488":64267,"_19100":107655,"_5":13150,"_26023":107590,"_2643":47193},[],{"_3144":64289,"_27488":64267,"_19100":107657,"_5":13150,"_26023":107590,"_2643":107658},[],"La identidad está en la ventana operativa de renovación.",{"_3144":64290,"_27488":64267,"_19100":107660,"_5":13150,"_26023":107590,"_2643":47199},[],{"_3144":64291,"_27488":64267,"_19100":107662,"_5":13150,"_26023":107590,"_2643":107663},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3144":64292,"_27488":64267,"_19100":107665,"_5":13150,"_26023":107590,"_2643":47205},[],{"_3144":64293,"_27488":64267,"_19100":107667,"_5":13150,"_26023":107590,"_2643":107668},[],"La identidad ha vencido.",{"_3144":64294,"_27488":64267,"_19100":107670,"_5":13150,"_26023":107590,"_2643":47211},[],{"_3144":64295,"_27488":64267,"_19100":107672,"_5":13150,"_26023":107590,"_2643":107673},[],"La identidad está marcada como revocada.",{"_3144":64296,"_27488":64267,"_19100":107675,"_5":13150,"_26023":107590,"_2643":47217},[],{"_3144":64297,"_27488":64267,"_19100":107677,"_5":13150,"_26023":107590,"_2643":107678},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3144":64298,"_27488":64267,"_19100":107680,"_5":13150,"_26023":107590,"_2643":107681},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3144":64299,"_27488":64267,"_19100":107683,"_5":13150,"_26023":107594,"_2643":107684},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3144":64300,"_27488":64267,"_19100":107686,"_5":13150,"_26023":107594,"_2643":107687},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3144":64301,"_27488":64267,"_19100":107689,"_5":13150,"_26023":107594,"_2643":107690},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3144":64302,"_27488":64267,"_19100":107692,"_5":13150,"_26023":107594,"_2643":107693},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3144":64303,"_27488":64267,"_19100":107695,"_5":13150,"_26023":107598,"_2643":107696},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3144":64304,"_27488":64267,"_19100":107698,"_5":13150,"_26023":107602,"_2643":107699},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3144":64305,"_27488":64267,"_19100":107701,"_5":13150,"_26023":107606,"_2643":107702},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3144":64306,"_27488":64267,"_19100":107704,"_5":13150,"_26023":107610,"_2643":107705},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3144":64307,"_27488":64267,"_19100":107707,"_5":13150,"_26023":107614,"_2643":107708},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3144":64308,"_27488":64267,"_19100":107710,"_5":13150,"_26023":107614,"_2643":107711},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3144":64309,"_27488":64267,"_19100":107713,"_5":13150,"_26023":107618,"_2643":107714},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3144":64310,"_27488":64267,"_19100":107716,"_5":13150,"_26023":107618,"_2643":107717},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3144":64311,"_27488":64267,"_19100":107719,"_5":13150,"_26023":107618,"_2643":107720},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3144":64312,"_27488":64267,"_19100":107722,"_5":13150,"_26023":107618,"_2643":107723},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3144":64313,"_27488":64267,"_19100":107725,"_5":13150,"_26023":107618,"_2643":107726},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3144":64314,"_27488":64267,"_19100":107728,"_5":13150,"_26023":107618,"_2643":107729},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3144":64315,"_27488":64267,"_19100":107731,"_5":13150,"_26023":107622,"_2643":107732},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3144":64316,"_27488":64267,"_19100":107734,"_5":13150,"_26023":107622,"_2643":107735},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3144":64317,"_27488":64267,"_19100":107737,"_5":13150,"_26023":107626,"_2643":107738},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3144":64318,"_27488":64267,"_19100":107740,"_5":13150,"_26023":107626,"_2643":107741},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3144":64319,"_27488":64267,"_19100":107743,"_5":13150,"_26023":107626,"_2643":107744},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3144":64320,"_27488":64267,"_19100":107746,"_5":13150,"_26023":107626,"_2643":107747},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3144":64321,"_27488":64267,"_19100":107749,"_5":13150,"_26023":107630,"_2643":107750},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3144":64322,"_27488":64267,"_19100":107752,"_5":13150,"_26023":107630,"_2643":107753},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3144":64323,"_27488":64323,"_5":13476,"_2643":107755,"_27831":107756,"_19100":107758,"_26023":64323},"Identidad inicial y autenticación",[44764,106610,47118,107582,107757],"Enrolamiento con PKI",[],{"_3144":64324,"_27488":64323,"_19100":107760,"_5":13150,"_26023":64323,"_2643":107761},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3144":64325,"_27488":64323,"_5":27828,"_19100":107763,"_26023":107764,"_2643":107765},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3144":64326,"_27488":64323,"_5":27828,"_19100":107767,"_26023":107768,"_2643":107769},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3144":64327,"_27488":64323,"_5":27828,"_19100":107771,"_26023":107772,"_2643":107773},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3144":64328,"_27488":64323,"_5":27828,"_19100":107775,"_26023":107776,"_2643":107777},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3144":64329,"_27488":64323,"_5":27828,"_19100":107779,"_26023":107780,"_2643":107781},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3144":64330,"_27488":64323,"_19100":107783,"_5":13150,"_26023":64323,"_2643":107784},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3144":64331,"_27488":64323,"_19100":107786,"_5":13150,"_26023":107764,"_2643":107787},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3144":64332,"_27488":64323,"_19100":107789,"_5":13150,"_26023":107764,"_2643":107790},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3144":64333,"_27488":64323,"_19100":107792,"_5":13150,"_26023":107768,"_2643":107793},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3144":64334,"_27488":64323,"_19100":107795,"_5":13150,"_26023":107768,"_2643":107796},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3144":64335,"_27488":64323,"_19100":107798,"_5":13150,"_26023":107768,"_2643":107799},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3144":64336,"_27488":64323,"_19100":107801,"_5":13150,"_26023":107772,"_2643":107802},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3144":64337,"_27488":64323,"_19100":107804,"_5":13150,"_26023":107772,"_2643":107805},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3144":64338,"_27488":64323,"_19100":107807,"_5":13150,"_26023":107776,"_2643":107808},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3144":64339,"_27488":64323,"_19100":107810,"_5":13150,"_26023":107776,"_2643":107811},[],"Ejemplo de cuerpo:",{"_3144":64340,"_27488":64323,"_19100":107813,"_5":13150,"_26023":107776,"_2643":107814},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3144":64341,"_27488":64323,"_19100":107816,"_5":13150,"_26023":107776,"_2643":107817},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3144":64342,"_27488":64323,"_19100":107819,"_5":13150,"_26023":107776,"_2643":107820},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3144":64343,"_27488":64323,"_19100":107822,"_5":13150,"_26023":107776,"_2643":107823},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3144":64344,"_27488":64323,"_19100":107825,"_5":13150,"_26023":107780,"_2643":107826},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3144":64345,"_27488":64323,"_19100":107828,"_5":13150,"_26023":107780,"_2643":107829},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3144":64346,"_27488":64346,"_5":13476,"_2643":107831,"_27831":107832,"_19100":107833,"_26023":64346},"Configura y opera el DMS",[44764,106610,47118,107582,107757],[],{"_3144":64347,"_27488":64346,"_19100":107835,"_5":13150,"_26023":64346,"_2643":107836},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3144":64348,"_27488":64346,"_5":27828,"_19100":107838,"_26023":107839,"_2643":105276},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3144":64349,"_27488":64346,"_5":27828,"_19100":107841,"_26023":107842,"_2643":107843},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3144":64350,"_27488":64346,"_5":27828,"_19100":107845,"_26023":107846,"_2643":107847},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3144":64351,"_27488":64346,"_5":27828,"_19100":107849,"_26023":107850,"_2643":107851},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3144":64352,"_27488":64346,"_5":27828,"_19100":107853,"_26023":107854,"_2643":107855},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3144":64353,"_27488":64346,"_5":27828,"_19100":107857,"_26023":107858,"_2643":107859},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3144":64354,"_27488":64346,"_5":27828,"_19100":107861,"_26023":107862,"_2643":107863},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3144":64355,"_27488":64346,"_5":27828,"_19100":107865,"_26023":107866,"_2643":107867},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3144":64356,"_27488":64346,"_5":27828,"_19100":107869,"_26023":107870,"_2643":47413},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3144":64357,"_27488":64346,"_5":27828,"_19100":107872,"_26023":107873,"_2643":47417},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3144":64358,"_27488":64346,"_5":27828,"_19100":107875,"_26023":107876,"_2643":107877},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3144":64359,"_27488":64346,"_5":27828,"_19100":107879,"_26023":107880,"_2643":107881},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3144":64360,"_27488":64346,"_5":27828,"_19100":107883,"_26023":107884,"_2643":107885},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3144":64361,"_27488":64346,"_5":27828,"_19100":107887,"_26023":107888,"_2643":107889},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3144":64362,"_27488":64346,"_5":27828,"_19100":107891,"_26023":107892,"_2643":47437},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3144":64363,"_27488":64346,"_5":27828,"_19100":107894,"_26023":107895,"_2643":107896},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3144":64364,"_27488":64346,"_5":27828,"_19100":107898,"_26023":107899,"_2643":107900},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3144":64365,"_27488":64346,"_5":27828,"_19100":107902,"_26023":107903,"_2643":107904},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3144":64366,"_27488":64346,"_19100":107906,"_5":13150,"_26023":64346,"_2643":107907},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3144":64367,"_27488":64346,"_19100":107909,"_5":13150,"_26023":107839,"_2643":107910},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3144":64368,"_27488":64346,"_19100":107912,"_5":13150,"_26023":107839,"_2643":107913},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3144":64369,"_27488":64346,"_19100":107915,"_5":13150,"_26023":107846,"_2643":107916},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3144":64370,"_27488":64346,"_19100":107918,"_5":13150,"_26023":107850,"_2643":107919},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3144":64371,"_27488":64346,"_19100":107921,"_5":13150,"_26023":107854,"_2643":107922},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3144":64372,"_27488":64346,"_19100":107924,"_5":13150,"_26023":107858,"_2643":107925},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3144":64373,"_27488":64346,"_19100":107927,"_5":13150,"_26023":107862,"_2643":107928},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3144":64374,"_27488":64346,"_19100":107930,"_5":13150,"_26023":107870,"_2643":107931},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3144":64375,"_27488":64346,"_19100":107933,"_5":13150,"_26023":107870,"_2643":107934},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3144":64376,"_27488":64346,"_19100":107936,"_5":13150,"_26023":107873,"_2643":107937},[],"Campo de `settings.enrollment_settings`",{"_3144":64377,"_27488":64346,"_19100":107939,"_5":13150,"_26023":107873,"_2643":107940},[],"Decisión",{"_3144":64378,"_27488":64346,"_19100":107942,"_5":13150,"_26023":107873,"_2643":47488},[],{"_3144":64379,"_27488":64346,"_19100":107944,"_5":13150,"_26023":107873,"_2643":107945},[],"`EST_RFC7030` para estas operaciones.",{"_3144":64380,"_27488":64346,"_19100":107947,"_5":13150,"_26023":107873,"_2643":47494},[],{"_3144":64381,"_27488":64346,"_19100":107949,"_5":13150,"_26023":107873,"_2643":107950},[],"ID de la CA que firmará.",{"_3144":64382,"_27488":64346,"_19100":107952,"_5":13150,"_26023":107873,"_2643":47500},[],{"_3144":64383,"_27488":64346,"_19100":107954,"_5":13150,"_26023":107873,"_2643":107955},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3144":64384,"_27488":64346,"_19100":107957,"_5":13150,"_26023":107873,"_2643":47506},[],{"_3144":64385,"_27488":64346,"_19100":107959,"_5":13150,"_26023":107873,"_2643":107960},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3144":64386,"_27488":64346,"_19100":107962,"_5":13150,"_26023":107873,"_2643":47512},[],{"_3144":64387,"_27488":64346,"_19100":107964,"_5":13150,"_26023":107873,"_2643":107965},[],"Uno de los cuatro modos de autenticación.",{"_3144":64388,"_27488":64346,"_19100":107967,"_5":13150,"_26023":107873,"_2643":107968},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3144":64389,"_27488":64346,"_19100":107970,"_5":13150,"_26023":107876,"_2643":107971},[],"Los bloques son independientes:",{"_3144":64390,"_27488":64346,"_19100":107973,"_5":13150,"_26023":107876,"_2643":107974},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3144":64391,"_27488":64346,"_19100":107976,"_5":13150,"_26023":107876,"_2643":107977},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3144":64392,"_27488":64346,"_19100":107979,"_5":13150,"_26023":107876,"_2643":47530},[],{"_3144":64393,"_27488":64346,"_19100":107981,"_5":13150,"_26023":107876,"_2643":107982},[],"Control aplicado en la operación configurada",{"_3144":64394,"_27488":64346,"_19100":107984,"_5":13150,"_26023":107876,"_2643":47536},[],{"_3144":64395,"_27488":64346,"_19100":107986,"_5":13150,"_26023":107876,"_2643":107987},[],"Validación del certificado presentado.",{"_3144":64396,"_27488":64346,"_19100":107989,"_5":13150,"_26023":107876,"_2643":47542},[],{"_3144":64397,"_27488":64346,"_19100":107991,"_5":13150,"_26023":107876,"_2643":107992},[],"Autorización del webhook configurado.",{"_3144":64398,"_27488":64346,"_19100":107994,"_5":13150,"_26023":107876,"_2643":47548},[],{"_3144":64399,"_27488":64346,"_19100":107996,"_5":13150,"_26023":107876,"_2643":107997},[],"Validación del certificado y, después, aprobación del webhook.",{"_3144":64400,"_27488":64346,"_19100":107999,"_5":13150,"_26023":107876,"_2643":47554},[],{"_3144":64401,"_27488":64346,"_19100":108001,"_5":13150,"_26023":107876,"_2643":108002},[],"Sin autenticación del solicitante por el DMS.",{"_3144":64402,"_27488":64346,"_19100":108004,"_5":13150,"_26023":107876,"_2643":108005},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3144":64403,"_27488":64346,"_19100":108007,"_5":13150,"_26023":107876,"_2643":108008},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3144":64404,"_27488":64346,"_19100":108010,"_5":13150,"_26023":107876,"_2643":108011},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3144":64405,"_27488":64346,"_19100":108013,"_5":13150,"_26023":107876,"_2643":108014},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3144":64406,"_27488":64346,"_19100":108016,"_5":13150,"_26023":107880,"_2643":108017},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3144":64407,"_27488":64346,"_19100":108019,"_5":13150,"_26023":107880,"_2643":108020},[],"Campo de `external_webhook_settings`",{"_3144":64408,"_27488":64346,"_19100":108022,"_5":13150,"_26023":107880,"_2643":107940},[],{"_3144":64409,"_27488":64346,"_19100":108024,"_5":13150,"_26023":107880,"_2643":47580},[],{"_3144":64410,"_27488":64346,"_19100":108026,"_5":13150,"_26023":107880,"_2643":108027},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3144":64411,"_27488":64346,"_19100":108029,"_5":13150,"_26023":107880,"_2643":47586},[],{"_3144":64412,"_27488":64346,"_19100":108031,"_5":13150,"_26023":107880,"_2643":108032},[],"`POST` o `PUT`; `POST` por defecto.",{"_3144":64413,"_27488":64346,"_19100":108034,"_5":13150,"_26023":107880,"_2643":47592},[],{"_3144":64414,"_27488":64346,"_19100":108036,"_5":13150,"_26023":107880,"_2643":108037},[],"Etiqueta usada en los logs del servicio.",{"_3144":64415,"_27488":64346,"_19100":108039,"_5":13150,"_26023":107880,"_2643":47598},[],{"_3144":64416,"_27488":64346,"_19100":108041,"_5":13150,"_26023":107880,"_2643":108042},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3144":64417,"_27488":64346,"_19100":108044,"_5":13150,"_26023":107880,"_2643":47604},[],{"_3144":64418,"_27488":64346,"_19100":108046,"_5":13150,"_26023":107880,"_2643":108047},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3144":64419,"_27488":64346,"_19100":108049,"_5":13150,"_26023":107880,"_2643":47610},[],{"_3144":64420,"_27488":64346,"_19100":108051,"_5":13150,"_26023":107880,"_2643":108052},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3144":64421,"_27488":64346,"_19100":108054,"_5":13150,"_26023":107880,"_2643":47616},[],{"_3144":64422,"_27488":64346,"_19100":108056,"_5":13150,"_26023":107880,"_2643":108057},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3144":64423,"_27488":64346,"_19100":108059,"_5":13150,"_26023":107880,"_2643":47622},[],{"_3144":64424,"_27488":64346,"_19100":108061,"_5":13150,"_26023":107880,"_2643":108062},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3144":64425,"_27488":64346,"_19100":108064,"_5":13150,"_26023":107880,"_2643":47628},[],{"_3144":64426,"_27488":64346,"_19100":108066,"_5":13150,"_26023":107880,"_2643":108067},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3144":64427,"_27488":64346,"_19100":108069,"_5":13150,"_26023":107880,"_2643":108070},[],"Reglas de esa configuración:",{"_3144":64428,"_27488":64346,"_19100":108072,"_5":13150,"_26023":107880,"_2643":108073},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3144":64429,"_27488":64346,"_19100":108075,"_5":13150,"_26023":107880,"_2643":108076},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3144":64430,"_27488":64346,"_19100":108078,"_5":13150,"_26023":107880,"_2643":108079},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3144":64431,"_27488":64346,"_19100":108081,"_5":13150,"_26023":107880,"_2643":108082},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3144":64432,"_27488":64346,"_19100":108084,"_5":13150,"_26023":107880,"_2643":108085},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3144":64433,"_27488":64346,"_19100":108087,"_5":13150,"_26023":107880,"_2643":108088},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3144":64434,"_27488":64346,"_19100":108090,"_5":13150,"_26023":107880,"_2643":108091},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3144":64435,"_27488":64346,"_19100":108093,"_5":13150,"_26023":107880,"_2643":108094},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3144":64436,"_27488":64346,"_19100":108096,"_5":13150,"_26023":107880,"_2643":108097},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3144":64437,"_27488":64346,"_19100":108099,"_5":13150,"_26023":107884,"_2643":108100},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3144":64438,"_27488":64346,"_19100":108102,"_5":13150,"_26023":107888,"_2643":108103},[],"Campo de `settings.reenrollment_settings`",{"_3144":64439,"_27488":64346,"_19100":108105,"_5":13150,"_26023":107888,"_2643":108106},[],"Función",{"_3144":64440,"_27488":64346,"_19100":108108,"_5":13150,"_26023":107888,"_2643":47672},[],{"_3144":64441,"_27488":64346,"_19100":108110,"_5":13150,"_26023":107888,"_2643":108111},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3144":64442,"_27488":64346,"_19100":108113,"_5":13150,"_26023":107888,"_2643":47678},[],{"_3144":64443,"_27488":64346,"_19100":108115,"_5":13150,"_26023":107888,"_2643":108116},[],"Umbral operativo preventivo de monitorización.",{"_3144":64444,"_27488":64346,"_19100":108118,"_5":13150,"_26023":107888,"_2643":47684},[],{"_3144":64445,"_27488":64346,"_19100":108120,"_5":13150,"_26023":107888,"_2643":108121},[],"Umbral operativo crítico de monitorización.",{"_3144":64446,"_27488":64346,"_19100":108123,"_5":13150,"_26023":107888,"_2643":47690},[],{"_3144":64447,"_27488":64346,"_19100":108125,"_5":13150,"_26023":107888,"_2643":108126},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3144":64448,"_27488":64346,"_19100":108128,"_5":13150,"_26023":107888,"_2643":47696},[],{"_3144":64449,"_27488":64346,"_19100":108130,"_5":13150,"_26023":107888,"_2643":108131},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3144":64450,"_27488":64346,"_19100":108133,"_5":13150,"_26023":107888,"_2643":47702},[],{"_3144":64451,"_27488":64346,"_19100":108135,"_5":13150,"_26023":107888,"_2643":108136},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3144":64452,"_27488":64346,"_19100":108138,"_5":13150,"_26023":107888,"_2643":108139},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3144":64453,"_27488":64346,"_19100":108141,"_5":13150,"_26023":107892,"_2643":108142},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3144":64454,"_27488":64346,"_19100":108144,"_5":13150,"_26023":107895,"_2643":105640},[],{"_3144":64455,"_27488":64346,"_19100":108146,"_5":13150,"_26023":107895,"_2643":108147},[],"Qué publica",{"_3144":64456,"_27488":64346,"_19100":108149,"_5":13150,"_26023":107895,"_2643":47719},[],{"_3144":64457,"_27488":64346,"_19100":108151,"_5":13150,"_26023":107895,"_2643":108152},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3144":64458,"_27488":64346,"_19100":108154,"_5":13150,"_26023":107895,"_2643":47725},[],{"_3144":64459,"_27488":64346,"_19100":108156,"_5":13150,"_26023":107895,"_2643":108157},[],"Certificado de la CA emisora seleccionada.",{"_3144":64460,"_27488":64346,"_19100":108159,"_5":13150,"_26023":107895,"_2643":47731},[],{"_3144":64461,"_27488":64346,"_19100":108161,"_5":13150,"_26023":107895,"_2643":108162},[],"Certificados de las CAs elegidas explícitamente.",{"_3144":64462,"_27488":64346,"_19100":108164,"_5":13150,"_26023":107895,"_2643":108165},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3144":64463,"_27488":64346,"_19100":108167,"_5":13150,"_26023":107899,"_2643":108168},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3144":64464,"_27488":64346,"_19100":108170,"_5":13150,"_26023":107899,"_2643":108171},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3144":64465,"_27488":64346,"_19100":108173,"_5":13150,"_26023":107899,"_2643":108174},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3144":64466,"_27488":64346,"_19100":108176,"_5":13150,"_26023":107903,"_2643":108177},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3144":64467,"_27488":64467,"_5":13476,"_2643":108179,"_27831":108180,"_19100":108181,"_26023":64467},"Integra el cliente EST",[44764,106610,47118,107582,107757],[],{"_3144":64468,"_27488":64467,"_19100":108183,"_5":13150,"_26023":64467,"_2643":108184},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3144":64469,"_27488":64467,"_5":27828,"_19100":108186,"_26023":108187,"_2643":105276},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3144":64470,"_27488":64467,"_5":27828,"_19100":108189,"_26023":108190,"_2643":108191},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3144":64471,"_27488":64467,"_5":27828,"_19100":108193,"_26023":108194,"_2643":108195},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3144":64472,"_27488":64467,"_5":27828,"_19100":108197,"_26023":108198,"_2643":108199},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3144":64473,"_27488":64467,"_5":27828,"_19100":108201,"_26023":108202,"_2643":108203},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3144":64474,"_27488":64467,"_5":27828,"_19100":108205,"_26023":108206,"_2643":108207},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3144":64475,"_27488":64467,"_19100":108209,"_5":13150,"_26023":64467,"_2643":108210},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3144":64476,"_27488":64467,"_19100":108212,"_5":13150,"_26023":108187,"_2643":108213},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3144":64477,"_27488":64467,"_19100":108215,"_5":13150,"_26023":108187,"_2643":108216},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3144":64478,"_27488":64467,"_19100":108218,"_5":13150,"_26023":108187,"_2643":108219},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3144":64479,"_27488":64467,"_19100":108221,"_5":13150,"_26023":108190,"_2643":108222},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3144":64480,"_27488":64467,"_19100":108224,"_5":13150,"_26023":108190,"_2643":108225},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3144":64481,"_27488":64467,"_19100":108227,"_5":13150,"_26023":108194,"_2643":108228},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3144":64482,"_27488":64467,"_19100":108230,"_5":13150,"_26023":108194,"_2643":108231},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3144":64483,"_27488":64467,"_19100":108233,"_5":13150,"_26023":108198,"_2643":108234},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3144":64484,"_27488":64467,"_19100":108236,"_5":13150,"_26023":108198,"_2643":108237},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3144":64485,"_27488":64467,"_19100":108239,"_5":13150,"_26023":108202,"_2643":108240},[],"Para el caso de una raíz que emite directamente:",{"_3144":64486,"_27488":64467,"_19100":108242,"_5":13150,"_26023":108202,"_2643":108243},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3144":64487,"_27488":64467,"_19100":108245,"_5":13150,"_26023":108202,"_2643":108246},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3144":64488,"_27488":64467,"_19100":108248,"_5":13150,"_26023":108206,"_2643":108249},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3144":64489,"_27488":64489,"_5":13476,"_2643":108251,"_27831":108252,"_19100":108253,"_26023":64489},"Referencia EST",[44764,106610,47118,107582,107757],[],{"_3144":64490,"_27488":64489,"_19100":108255,"_5":13150,"_26023":64489,"_2643":108256},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3144":64491,"_27488":64489,"_5":27828,"_19100":108258,"_26023":108259,"_2643":108260},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3144":64492,"_27488":64489,"_5":27828,"_19100":108262,"_26023":108263,"_2643":20755},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3144":64493,"_27488":64489,"_5":27828,"_19100":108265,"_26023":108266,"_2643":23790},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3144":64494,"_27488":64489,"_5":27828,"_19100":108268,"_26023":108269,"_2643":23797},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3144":64495,"_27488":64489,"_5":27828,"_19100":108271,"_26023":108272,"_2643":23143},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3144":64496,"_27488":64489,"_5":27828,"_19100":108274,"_26023":108275,"_2643":108276},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3144":64497,"_27488":64489,"_5":27828,"_19100":108278,"_26023":108279,"_2643":108280},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3144":64498,"_27488":64489,"_5":27828,"_19100":108282,"_26023":108283,"_2643":108284},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3144":64499,"_27488":64489,"_19100":108286,"_5":13150,"_26023":64489,"_2643":108287},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3144":64500,"_27488":64489,"_19100":108289,"_5":13150,"_26023":108259,"_2643":108290},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3144":64501,"_27488":64489,"_19100":108292,"_5":13150,"_26023":108259,"_2643":106401},[],{"_3144":64502,"_27488":64489,"_19100":108294,"_5":13150,"_26023":108259,"_2643":108295},[],"Método",{"_3144":64503,"_27488":64489,"_19100":108297,"_5":13150,"_26023":108259,"_2643":108298},[],"Autenticación y condición",{"_3144":64504,"_27488":64489,"_19100":108300,"_5":13150,"_26023":108259,"_2643":47874},[],{"_3144":64505,"_27488":64489,"_19100":108302,"_5":13150,"_26023":108259,"_2643":47877},[],{"_3144":64506,"_27488":64489,"_19100":108304,"_5":13150,"_26023":108259,"_2643":108305},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3144":64507,"_27488":64489,"_19100":108307,"_5":13150,"_26023":108259,"_2643":47883},[],{"_3144":64508,"_27488":64489,"_19100":108309,"_5":13150,"_26023":108259,"_2643":47886},[],{"_3144":64509,"_27488":64489,"_19100":108311,"_5":13150,"_26023":108259,"_2643":108312},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3144":64510,"_27488":64489,"_19100":108314,"_5":13150,"_26023":108259,"_2643":47892},[],{"_3144":64511,"_27488":64489,"_19100":108316,"_5":13150,"_26023":108259,"_2643":47886},[],{"_3144":64512,"_27488":64489,"_19100":108318,"_5":13150,"_26023":108259,"_2643":108319},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3144":64513,"_27488":64489,"_19100":108321,"_5":13150,"_26023":108259,"_2643":47900},[],{"_3144":64514,"_27488":64489,"_19100":108323,"_5":13150,"_26023":108259,"_2643":47886},[],{"_3144":64515,"_27488":64489,"_19100":108325,"_5":13150,"_26023":108259,"_2643":108326},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3144":64516,"_27488":64489,"_19100":108328,"_5":13150,"_26023":108259,"_2643":108329},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3144":64517,"_27488":64489,"_19100":108331,"_5":13150,"_26023":108263,"_2643":108332},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3144":64518,"_27488":64489,"_19100":108334,"_5":13150,"_26023":108263,"_2643":108335},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3144":64519,"_27488":64489,"_19100":108337,"_5":13150,"_26023":108266,"_2643":108338},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3144":64520,"_27488":64489,"_19100":108340,"_5":13150,"_26023":108266,"_2643":108341},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3144":64521,"_27488":64489,"_19100":108343,"_5":13150,"_26023":108269,"_2643":108344},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3144":64522,"_27488":64489,"_19100":108346,"_5":13150,"_26023":108269,"_2643":108347},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3144":64523,"_27488":64489,"_19100":108349,"_5":13150,"_26023":108272,"_2643":108350},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3144":64524,"_27488":64489,"_19100":108352,"_5":13150,"_26023":108272,"_2643":108353},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3144":64525,"_27488":64489,"_19100":108355,"_5":13150,"_26023":108275,"_2643":108356},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3144":64526,"_27488":64489,"_19100":108358,"_5":13150,"_26023":108275,"_2643":108359},[],"Parte",{"_3144":64527,"_27488":64489,"_19100":108361,"_5":13150,"_26023":108275,"_2643":108362},[],"Contenido tras decodificar su Base64",{"_3144":64528,"_27488":64489,"_19100":108364,"_5":13150,"_26023":108275,"_2643":47944},[],{"_3144":64529,"_27488":64489,"_19100":108366,"_5":13150,"_26023":108275,"_2643":108367},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3144":64530,"_27488":64489,"_19100":108369,"_5":13150,"_26023":108275,"_2643":47950},[],{"_3144":64531,"_27488":64489,"_19100":108371,"_5":13150,"_26023":108275,"_2643":108372},[],"PKCS#7 DER con el certificado emitido.",{"_3144":64532,"_27488":64489,"_19100":108374,"_5":13150,"_26023":108275,"_2643":108375},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3144":64533,"_27488":64489,"_19100":108377,"_5":13150,"_26023":108279,"_2643":108378},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3144":64534,"_27488":64489,"_19100":108380,"_5":13150,"_26023":108279,"_2643":108381},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3144":64535,"_27488":64489,"_19100":108383,"_5":13150,"_26023":108279,"_2643":108384},[],"Convierte y comprueba el resultado:",{"_3144":64536,"_27488":64489,"_19100":108386,"_5":13150,"_26023":108279,"_2643":108387},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3144":64537,"_27488":64489,"_19100":108389,"_5":13150,"_26023":108283,"_2643":108390},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3144":64538,"_27488":64489,"_19100":108392,"_5":13150,"_26023":108283,"_2643":108393},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3144":64539,"_27488":64539,"_5":13476,"_2643":107757,"_27831":108395,"_19100":108396,"_26023":64539},[44764,106610,47118,107582,107757],[],{"_3144":64540,"_27488":64539,"_19100":108398,"_5":13150,"_26023":64539,"_2643":108399},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3144":64541,"_27488":64539,"_5":27828,"_19100":108401,"_26023":108402,"_2643":108403},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3144":64542,"_27488":64539,"_5":27828,"_19100":108405,"_26023":108406,"_2643":108407},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3144":64543,"_27488":64539,"_5":27828,"_19100":108409,"_26023":108410,"_2643":108411},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3144":64544,"_27488":64539,"_5":27828,"_19100":108413,"_26023":108414,"_2643":108415},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3144":64545,"_27488":64539,"_19100":108417,"_5":13150,"_26023":64539,"_2643":108418},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3144":64546,"_27488":64539,"_19100":108420,"_5":13150,"_26023":108402,"_2643":108421},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3144":64547,"_27488":64539,"_19100":108423,"_5":13150,"_26023":108402,"_2643":108424},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3144":64548,"_27488":64539,"_19100":108426,"_5":13150,"_26023":108402,"_2643":108427},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3144":64549,"_27488":64539,"_19100":108429,"_5":13150,"_26023":108402,"_2643":108430},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3144":64550,"_27488":64539,"_19100":108432,"_5":13150,"_26023":108402,"_2643":108433},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3144":64551,"_27488":64539,"_19100":108435,"_5":13150,"_26023":108402,"_2643":108436},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3144":64552,"_27488":64539,"_19100":108438,"_5":13150,"_26023":108406,"_2643":108439},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3144":64553,"_27488":64539,"_19100":108441,"_5":13150,"_26023":108406,"_2643":108442},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3144":64554,"_27488":64539,"_19100":108444,"_5":13150,"_26023":108406,"_2643":108445},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3144":64555,"_27488":64539,"_19100":108447,"_5":13150,"_26023":108406,"_2643":108448},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3144":64556,"_27488":64539,"_19100":108450,"_5":13150,"_26023":108410,"_2643":108451},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3144":64557,"_27488":64539,"_19100":108453,"_5":13150,"_26023":108410,"_2643":108454},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3144":64558,"_27488":64539,"_19100":108456,"_5":13150,"_26023":108410,"_2643":108457},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3144":64559,"_27488":64539,"_19100":108459,"_5":13150,"_26023":108410,"_2643":108460},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3144":64560,"_27488":64539,"_19100":108462,"_5":13150,"_26023":108414,"_2643":108463},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3144":64561,"_27488":64539,"_19100":108465,"_5":13150,"_26023":108414,"_2643":108466},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3144":64562,"_27488":64562,"_5":13476,"_2643":108468,"_27831":108469,"_19100":108470,"_26023":64562},"Estrategias de aprovisionamiento",[44764,106610,47118,107582,107757],[],{"_3144":64563,"_27488":64562,"_19100":108472,"_5":13150,"_26023":64562,"_2643":108473},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3144":64564,"_27488":64562,"_5":27828,"_19100":108475,"_26023":108476,"_2643":108477},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3144":64565,"_27488":64562,"_5":27828,"_19100":108479,"_26023":108480,"_2643":108481},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3144":64566,"_27488":64562,"_5":27828,"_19100":108483,"_26023":108484,"_2643":108485},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3144":64567,"_27488":64562,"_5":27828,"_19100":108487,"_26023":108488,"_2643":108489},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3144":64568,"_27488":64562,"_5":27828,"_19100":108491,"_26023":108492,"_2643":108493},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3144":64569,"_27488":64562,"_19100":108495,"_5":13150,"_26023":64562,"_2643":108496},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3144":64570,"_27488":64562,"_19100":108498,"_5":13150,"_26023":108476,"_2643":108499},[],"Recorrido",{"_3144":64571,"_27488":64562,"_19100":108501,"_5":13150,"_26023":108476,"_2643":108502},[],"Cuándo existe el dispositivo",{"_3144":64572,"_27488":64562,"_19100":108504,"_5":13150,"_26023":108476,"_2643":108505},[],"Qué compruebas",{"_3144":64573,"_27488":64562,"_19100":108507,"_5":13150,"_26023":108476,"_2643":108508},[],"Asignación manual",{"_3144":64574,"_27488":64562,"_19100":108510,"_5":13150,"_26023":108476,"_2643":108511},[],"El operador lo crea antes de asociar un certificado.",{"_3144":64575,"_27488":64562,"_19100":108513,"_5":13150,"_26023":108476,"_2643":108514},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3144":64576,"_27488":64562,"_19100":108516,"_5":13150,"_26023":108476,"_2643":108517},[],"EST con `JITP`",{"_3144":64577,"_27488":64562,"_19100":108519,"_5":13150,"_26023":108476,"_2643":108520},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3144":64578,"_27488":64562,"_19100":108522,"_5":13150,"_26023":108476,"_2643":108523},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3144":64579,"_27488":64562,"_19100":108525,"_5":13150,"_26023":108476,"_2643":108526},[],"EST con `PRE_REGISTRATION`",{"_3144":64580,"_27488":64562,"_19100":108528,"_5":13150,"_26023":108476,"_2643":108529},[],"Debe existir antes de `/simpleenroll`.",{"_3144":64581,"_27488":64562,"_19100":108531,"_5":13150,"_26023":108476,"_2643":108532},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3144":64582,"_27488":64562,"_19100":108534,"_5":13150,"_26023":108476,"_2643":108535},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3144":64583,"_27488":64562,"_19100":108537,"_5":13150,"_26023":108476,"_2643":108538},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3144":64584,"_27488":64562,"_19100":108540,"_5":13150,"_26023":108480,"_2643":108541},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3144":64585,"_27488":64562,"_19100":108543,"_5":13150,"_26023":108480,"_2643":108544},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3144":64586,"_27488":64562,"_19100":108546,"_5":13150,"_26023":108480,"_2643":108547},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3144":64587,"_27488":64562,"_19100":108549,"_5":13150,"_26023":108484,"_2643":108550},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3144":64588,"_27488":64562,"_19100":108552,"_5":13150,"_26023":108484,"_2643":108553},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3144":64589,"_27488":64562,"_19100":108555,"_5":13150,"_26023":108484,"_2643":108556},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3144":64590,"_27488":64562,"_19100":108558,"_5":13150,"_26023":108484,"_2643":108559},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3144":64591,"_27488":64562,"_19100":108561,"_5":13150,"_26023":108484,"_2643":108562},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3144":64592,"_27488":64562,"_19100":108564,"_5":13150,"_26023":108484,"_2643":108565},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3144":64593,"_27488":64562,"_19100":108567,"_5":13150,"_26023":108488,"_2643":105640},[],{"_3144":64594,"_27488":64562,"_19100":108569,"_5":13150,"_26023":108488,"_2643":108570},[],"Material que atraviesa EST",{"_3144":64595,"_27488":64562,"_19100":108572,"_5":13150,"_26023":108488,"_2643":108573},[],"Clave generada por el dispositivo",{"_3144":64596,"_27488":64562,"_19100":108575,"_5":13150,"_26023":108488,"_2643":108576},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3144":64597,"_27488":64562,"_19100":108578,"_5":13150,"_26023":108488,"_2643":108579},[],"Clave ya disponible en el dispositivo",{"_3144":64598,"_27488":64562,"_19100":108581,"_5":13150,"_26023":108488,"_2643":108582},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3144":64599,"_27488":64562,"_19100":108584,"_5":13150,"_26023":108488,"_2643":47437},[],{"_3144":64600,"_27488":64562,"_19100":108586,"_5":13150,"_26023":108488,"_2643":108587},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3144":64601,"_27488":64562,"_19100":108589,"_5":13150,"_26023":108488,"_2643":108590},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3144":64602,"_27488":64562,"_19100":108592,"_5":13150,"_26023":108492,"_2643":108593},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3144":64603,"_27488":64603,"_5":13476,"_2643":108595,"_27831":108596,"_19100":108597,"_26023":64603},"Renovación y recuperación",[44764,106610,47118,107582,107757],[],{"_3144":64604,"_27488":64603,"_19100":108599,"_5":13150,"_26023":64603,"_2643":108600},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3144":64605,"_27488":64603,"_5":27828,"_19100":108602,"_26023":108603,"_2643":108604},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3144":64606,"_27488":64603,"_5":27828,"_19100":108606,"_26023":108607,"_2643":108608},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3144":64607,"_27488":64603,"_5":27828,"_19100":108610,"_26023":108611,"_2643":108612},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3144":64608,"_27488":64603,"_5":27828,"_19100":108614,"_26023":108615,"_2643":108616},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3144":64609,"_27488":64603,"_5":27828,"_19100":108618,"_26023":108619,"_2643":108620},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3144":64610,"_27488":64603,"_19100":108622,"_5":13150,"_26023":64603,"_2643":108623},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3144":64611,"_27488":64603,"_19100":108625,"_5":13150,"_26023":108603,"_2643":108626},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3144":64612,"_27488":64603,"_19100":108628,"_5":13150,"_26023":108603,"_2643":108629},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3144":64613,"_27488":64603,"_19100":108631,"_5":13150,"_26023":108603,"_2643":108632},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3144":64614,"_27488":64603,"_19100":108634,"_5":13150,"_26023":108603,"_2643":108635},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3144":64615,"_27488":64603,"_19100":108637,"_5":13150,"_26023":108607,"_2643":108638},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3144":64616,"_27488":64603,"_19100":108640,"_5":13150,"_26023":108607,"_2643":108641},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3144":64617,"_27488":64603,"_19100":108643,"_5":13150,"_26023":108611,"_2643":108644},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3144":64618,"_27488":64603,"_19100":108646,"_5":13150,"_26023":108611,"_2643":108647},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3144":64619,"_27488":64603,"_19100":108649,"_5":13150,"_26023":108611,"_2643":108650},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3144":64620,"_27488":64603,"_19100":108652,"_5":13150,"_26023":108615,"_2643":108653},[],"Situación",{"_3144":64621,"_27488":64603,"_19100":108655,"_5":13150,"_26023":108615,"_2643":108656},[],"Procedimiento",{"_3144":64622,"_27488":64603,"_19100":108658,"_5":13150,"_26023":108615,"_2643":108659},[],"Certificado vigente, fuera de ventana",{"_3144":64623,"_27488":64603,"_19100":108661,"_5":13150,"_26023":108615,"_2643":108662},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3144":64624,"_27488":64603,"_19100":108664,"_5":13150,"_26023":108615,"_2643":108665},[],"Certificado vencido, clave disponible",{"_3144":64625,"_27488":64603,"_19100":108667,"_5":13150,"_26023":108615,"_2643":108668},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3144":64626,"_27488":64603,"_19100":108670,"_5":13150,"_26023":108615,"_2643":108671},[],"Renovación por webhook o `NO_AUTH`",{"_3144":64627,"_27488":64603,"_19100":108673,"_5":13150,"_26023":108615,"_2643":108674},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3144":64628,"_27488":64603,"_19100":108676,"_5":13150,"_26023":108615,"_2643":108677},[],"Clave perdida o inaccesible",{"_3144":64629,"_27488":64603,"_19100":108679,"_5":13150,"_26023":108615,"_2643":108680},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3144":64630,"_27488":64603,"_19100":108682,"_5":13150,"_26023":108615,"_2643":108683},[],"Identidad actual revocada",{"_3144":64631,"_27488":64603,"_19100":108685,"_5":13150,"_26023":108615,"_2643":108686},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3144":64632,"_27488":64603,"_19100":108688,"_5":13150,"_26023":108615,"_2643":108689},[],"Dispositivo sin identidad",{"_3144":64633,"_27488":64603,"_19100":108691,"_5":13150,"_26023":108615,"_2643":108692},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3144":64634,"_27488":64603,"_19100":108694,"_5":13150,"_26023":108615,"_2643":108695},[],"Dispositivo retirado",{"_3144":64635,"_27488":64603,"_19100":108697,"_5":13150,"_26023":108615,"_2643":108698},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3144":64636,"_27488":64603,"_19100":108700,"_5":13150,"_26023":108615,"_2643":108701},[],"Timeout, HTTP 500 o fallo de instalación",{"_3144":64637,"_27488":64603,"_19100":108703,"_5":13150,"_26023":108615,"_2643":108704},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3144":64638,"_27488":64603,"_19100":108706,"_5":13150,"_26023":108619,"_2643":108707},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3144":64639,"_27488":64603,"_19100":108709,"_5":13150,"_26023":108619,"_2643":108710},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3144":64640,"_27488":64640,"_5":13476,"_2643":108712,"_27831":108713,"_19100":108714,"_26023":64640},"Diagnóstico de enrolamiento",[44764,106610,47118,107582,107757],[],{"_3144":64641,"_27488":64640,"_19100":108716,"_5":13150,"_26023":64640,"_2643":108717},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3144":64642,"_27488":64640,"_5":27828,"_19100":108719,"_26023":108720,"_2643":108721},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3144":64643,"_27488":64640,"_5":27828,"_19100":108723,"_26023":108724,"_2643":108725},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3144":64644,"_27488":64640,"_5":27828,"_19100":108727,"_26023":108728,"_2643":108284},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3144":64645,"_27488":64640,"_5":27828,"_19100":108730,"_26023":108731,"_2643":108732},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3144":64646,"_27488":64640,"_19100":108734,"_5":13150,"_26023":64640,"_2643":108735},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3144":64647,"_27488":64640,"_19100":108737,"_5":13150,"_26023":108724,"_2643":108738},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3144":64648,"_27488":64640,"_19100":108740,"_5":13150,"_26023":108724,"_2643":108741},[],"Síntoma o mensaje",{"_3144":64649,"_27488":64640,"_19100":108743,"_5":13150,"_26023":108724,"_2643":108744},[],"Qué revisar",{"_3144":64650,"_27488":64640,"_19100":108746,"_5":13150,"_26023":108724,"_2643":108747},[],"curl rechaza TLS, nombre o emisor",{"_3144":64651,"_27488":64640,"_19100":108749,"_5":13150,"_26023":108724,"_2643":108750},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3144":64652,"_27488":64640,"_19100":108752,"_5":13150,"_26023":108724,"_2643":108753},[],"404 o APS ausente",{"_3144":64653,"_27488":64640,"_19100":108755,"_5":13150,"_26023":108724,"_2643":108756},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3144":64654,"_27488":64640,"_19100":108758,"_5":13150,"_26023":108724,"_2643":108759},[],"400, error de CSR o formato",{"_3144":64655,"_27488":64640,"_19100":108761,"_5":13150,"_26023":108724,"_2643":108762},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3144":64656,"_27488":64640,"_19100":108764,"_5":13150,"_26023":108724,"_2643":108765},[],"Credencial ausente o certificado no válido",{"_3144":64657,"_27488":64640,"_19100":108767,"_5":13150,"_26023":108724,"_2643":108768},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3144":64658,"_27488":64640,"_19100":108770,"_5":13150,"_26023":108724,"_2643":108771},[],"Webhook deniega, expira o responde sin autorización",{"_3144":64659,"_27488":64640,"_19100":108773,"_5":13150,"_26023":108724,"_2643":108774},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3144":64660,"_27488":64640,"_19100":108776,"_5":13150,"_26023":108724,"_2643":48357},[],{"_3144":64661,"_27488":64640,"_19100":108778,"_5":13150,"_26023":108724,"_2643":108779},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3144":64662,"_27488":64640,"_19100":108781,"_5":13150,"_26023":108724,"_2643":48363},[],{"_3144":64663,"_27488":64640,"_19100":108783,"_5":13150,"_26023":108724,"_2643":108784},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3144":64664,"_27488":64640,"_19100":108786,"_5":13150,"_26023":108724,"_2643":48369},[],{"_3144":64665,"_27488":64640,"_19100":108788,"_5":13150,"_26023":108724,"_2643":108789},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3144":64666,"_27488":64640,"_19100":108791,"_5":13150,"_26023":108724,"_2643":48375},[],{"_3144":64667,"_27488":64640,"_19100":108793,"_5":13150,"_26023":108724,"_2643":108794},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3144":64668,"_27488":64640,"_19100":108796,"_5":13150,"_26023":108724,"_2643":48381},[],{"_3144":64669,"_27488":64640,"_19100":108798,"_5":13150,"_26023":108724,"_2643":108799},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3144":64670,"_27488":64640,"_19100":108801,"_5":13150,"_26023":108724,"_2643":108802},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3144":64671,"_27488":64640,"_19100":108804,"_5":13150,"_26023":108724,"_2643":108805},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3144":64672,"_27488":64640,"_19100":108807,"_5":13150,"_26023":108724,"_2643":108808},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3144":64673,"_27488":64640,"_19100":108810,"_5":13150,"_26023":108724,"_2643":108811},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3144":64674,"_27488":64640,"_19100":108813,"_5":13150,"_26023":108724,"_2643":48399},[],{"_3144":64675,"_27488":64640,"_19100":108815,"_5":13150,"_26023":108724,"_2643":108816},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3144":64676,"_27488":64640,"_19100":108818,"_5":13150,"_26023":108724,"_2643":48405},[],{"_3144":64677,"_27488":64640,"_19100":108820,"_5":13150,"_26023":108724,"_2643":108821},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3144":64678,"_27488":64640,"_19100":108823,"_5":13150,"_26023":108724,"_2643":108824},[],"DMS propietario distinto",{"_3144":64679,"_27488":64640,"_19100":108826,"_5":13150,"_26023":108724,"_2643":108827},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3144":64680,"_27488":64640,"_19100":108829,"_5":13150,"_26023":108724,"_2643":48417},[],{"_3144":64681,"_27488":64640,"_19100":108831,"_5":13150,"_26023":108724,"_2643":108832},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3144":64682,"_27488":64640,"_19100":108834,"_5":13150,"_26023":108724,"_2643":48423},[],{"_3144":64683,"_27488":64640,"_19100":108836,"_5":13150,"_26023":108724,"_2643":108837},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3144":64684,"_27488":64640,"_19100":108839,"_5":13150,"_26023":108724,"_2643":108840},[],"Certificado actual revocado",{"_3144":64685,"_27488":64640,"_19100":108842,"_5":13150,"_26023":108724,"_2643":108843},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3144":64686,"_27488":64640,"_19100":108845,"_5":13150,"_26023":108724,"_2643":108846},[],"Error de CA, perfil o firma",{"_3144":64687,"_27488":64640,"_19100":108848,"_5":13150,"_26023":108724,"_2643":108849},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3144":64688,"_27488":64640,"_19100":108851,"_5":13150,"_26023":108724,"_2643":108852},[],"HTTP 200 sin conexión del dispositivo",{"_3144":64689,"_27488":64640,"_19100":108854,"_5":13150,"_26023":108724,"_2643":108855},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3144":64690,"_27488":64640,"_19100":108857,"_5":13150,"_26023":108724,"_2643":108858},[],"Timeout o error después de emitir",{"_3144":64691,"_27488":64640,"_19100":108860,"_5":13150,"_26023":108724,"_2643":108861},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3144":64692,"_27488":64640,"_19100":108863,"_5":13150,"_26023":108728,"_2643":108864},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3144":64693,"_27488":64640,"_19100":108866,"_5":13150,"_26023":108728,"_2643":108867},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3144":64694,"_27488":64640,"_19100":108869,"_5":13150,"_26023":108731,"_2643":108870},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3144":64695,"_27488":64640,"_19100":108872,"_5":13150,"_26023":108731,"_2643":108873},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3144":64696,"_27488":64640,"_19100":108875,"_5":13150,"_26023":108731,"_2643":108876},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3144":64697,"_27488":64640,"_19100":108878,"_5":13150,"_26023":108731,"_2643":108879},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3144":64698,"_27488":64640,"_19100":108881,"_5":13150,"_26023":108731,"_2643":108882},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3144":64699,"_27488":64640,"_19100":108884,"_5":13150,"_26023":108731,"_2643":108885},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3144":64700,"_27488":64640,"_19100":108887,"_5":13150,"_26023":108731,"_2643":108888},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3144":64701,"_27488":64701,"_5":13476,"_2643":108890,"_27831":108891,"_19100":108892,"_26023":64701},"Distribución y actualización de confianza",[44764,106610,47118,107582,107757],[],{"_3144":64702,"_27488":64701,"_19100":108894,"_5":13150,"_26023":64701,"_2643":108895},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3144":64703,"_27488":64701,"_5":27828,"_19100":108897,"_26023":108898,"_2643":108899},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3144":64704,"_27488":64701,"_5":27828,"_19100":108901,"_26023":108902,"_2643":108903},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3144":64705,"_27488":64701,"_5":27828,"_19100":108905,"_26023":108906,"_2643":108907},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3144":64706,"_27488":64701,"_5":27828,"_19100":108909,"_26023":108910,"_2643":108911},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3144":64707,"_27488":64701,"_5":27828,"_19100":108913,"_26023":108914,"_2643":108915},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3144":64708,"_27488":64701,"_19100":108917,"_5":13150,"_26023":64701,"_2643":108918},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3144":64709,"_27488":64701,"_19100":108920,"_5":13150,"_26023":108898,"_2643":108921},[],"Relación",{"_3144":64710,"_27488":64701,"_19100":108923,"_5":13150,"_26023":108898,"_2643":108924},[],"Material que prepara el responsable",{"_3144":64711,"_27488":64701,"_19100":108926,"_5":13150,"_26023":108898,"_2643":108927},[],"Dispositivo → servidor EST",{"_3144":64712,"_27488":64701,"_19100":108929,"_5":13150,"_26023":108898,"_2643":108930},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3144":64713,"_27488":64701,"_19100":108932,"_5":13150,"_26023":108898,"_2643":108933},[],"DMS → solicitante",{"_3144":64714,"_27488":64701,"_19100":108935,"_5":13150,"_26023":108898,"_2643":108936},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3144":64715,"_27488":64701,"_19100":108938,"_5":13150,"_26023":108898,"_2643":108939},[],"Consumidor → dispositivo",{"_3144":64716,"_27488":64701,"_19100":108941,"_5":13150,"_26023":108898,"_2643":108942},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3144":64717,"_27488":64701,"_19100":108944,"_5":13150,"_26023":108898,"_2643":108945},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3144":64718,"_27488":64701,"_19100":108947,"_5":13150,"_26023":108902,"_2643":108948},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3144":64719,"_27488":64701,"_19100":108950,"_5":13150,"_26023":108902,"_2643":108951},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3144":64720,"_27488":64701,"_19100":108953,"_5":13150,"_26023":108906,"_2643":108954},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3144":64721,"_27488":64701,"_19100":108956,"_5":13150,"_26023":108906,"_2643":108957},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3144":64722,"_27488":64701,"_19100":108959,"_5":13150,"_26023":108906,"_2643":108960},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3144":64723,"_27488":64701,"_19100":108962,"_5":13150,"_26023":108906,"_2643":108963},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3144":64724,"_27488":64701,"_19100":108965,"_5":13150,"_26023":108906,"_2643":108966},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3144":64725,"_27488":64701,"_19100":108968,"_5":13150,"_26023":108906,"_2643":108969},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3144":64726,"_27488":64701,"_19100":108971,"_5":13150,"_26023":108910,"_2643":108972},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3144":64727,"_27488":64701,"_19100":108974,"_5":13150,"_26023":108910,"_2643":108975},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3144":64728,"_27488":64701,"_19100":108977,"_5":13150,"_26023":108910,"_2643":108978},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3144":64729,"_27488":64701,"_19100":108980,"_5":13150,"_26023":108914,"_2643":108981},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3144":64730,"_27488":64730,"_5":13476,"_2643":48572,"_27831":108983,"_19100":108985,"_26023":64730},[44764,106610,47118,107582,108984],"Integraciones",[],{"_3144":64731,"_27488":64730,"_19100":108987,"_5":13150,"_26023":64730,"_2643":108988},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3144":64732,"_27488":64730,"_5":27828,"_19100":108990,"_26023":108991,"_2643":108992},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3144":64733,"_27488":64730,"_5":27828,"_19100":108994,"_26023":108995,"_2643":108996},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3144":64734,"_27488":64730,"_5":27828,"_19100":108998,"_26023":108999,"_2643":109000},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3144":64735,"_27488":64730,"_5":27828,"_19100":109002,"_26023":109003,"_2643":109004},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3144":64736,"_27488":64730,"_5":27828,"_19100":109006,"_26023":109007,"_2643":109008},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3144":64737,"_27488":64730,"_5":27828,"_19100":109010,"_26023":109011,"_2643":109012},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3144":64738,"_27488":64730,"_5":27828,"_19100":109014,"_26023":109015,"_2643":48606},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3144":64739,"_27488":64730,"_5":27828,"_19100":109017,"_26023":109018,"_2643":48610},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3144":64740,"_27488":64730,"_5":27828,"_19100":109020,"_26023":109021,"_2643":109022},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3144":64741,"_27488":64730,"_5":27828,"_19100":109024,"_26023":109025,"_2643":109026},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3144":64742,"_27488":64730,"_5":27828,"_19100":109028,"_26023":109029,"_2643":109030},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3144":64743,"_27488":64730,"_5":27828,"_19100":109032,"_26023":109033,"_2643":109034},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3144":64744,"_27488":64730,"_5":27828,"_19100":109036,"_26023":109037,"_2643":109038},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3144":64745,"_27488":64730,"_5":27828,"_19100":109040,"_26023":109041,"_2643":109042},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3144":64746,"_27488":64730,"_5":27828,"_19100":109044,"_26023":109045,"_2643":109046},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3144":64747,"_27488":64730,"_5":27828,"_19100":109048,"_26023":109049,"_2643":109050},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3144":64748,"_27488":64730,"_5":27828,"_19100":109052,"_26023":109053,"_2643":109054},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3144":64749,"_27488":64730,"_5":27828,"_19100":109056,"_26023":109057,"_2643":109058},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3144":64750,"_27488":64730,"_5":27828,"_19100":109060,"_26023":109061,"_2643":109062},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3144":64751,"_27488":64730,"_5":27828,"_19100":109064,"_26023":109065,"_2643":109066},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3144":64752,"_27488":64730,"_19100":109068,"_5":13150,"_26023":64730,"_2643":109069},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3144":64753,"_27488":64730,"_19100":109071,"_5":13150,"_26023":64730,"_2643":109072},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3144":64754,"_27488":64730,"_19100":109074,"_5":13150,"_26023":64730,"_2643":109075},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3144":64755,"_27488":64730,"_19100":109077,"_5":13150,"_26023":108991,"_2643":109078},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3144":64756,"_27488":64730,"_19100":109080,"_5":13150,"_26023":108991,"_2643":109081},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3144":64757,"_27488":64730,"_19100":109083,"_5":13150,"_26023":108991,"_2643":109084},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3144":64758,"_27488":64730,"_19100":109086,"_5":13150,"_26023":108991,"_2643":109087},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3144":64759,"_27488":64730,"_19100":109089,"_5":13150,"_26023":108995,"_2643":109090},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3144":64760,"_27488":64730,"_19100":109092,"_5":13150,"_26023":108999,"_2643":109093},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3144":64761,"_27488":64730,"_19100":109095,"_5":13150,"_26023":108999,"_2643":109096},[],"Acción IAM",{"_3144":64762,"_27488":64730,"_19100":109098,"_5":13150,"_26023":108999,"_2643":105646},[],{"_3144":64763,"_27488":64730,"_19100":109100,"_5":13150,"_26023":108999,"_2643":48693},[],{"_3144":64764,"_27488":64730,"_19100":109102,"_5":13150,"_26023":108999,"_2643":109103},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3144":64765,"_27488":64730,"_19100":109105,"_5":13150,"_26023":108999,"_2643":48699},[],{"_3144":64766,"_27488":64730,"_19100":109107,"_5":13150,"_26023":108999,"_2643":109108},[],"Registrar la CA en AWS IoT",{"_3144":64767,"_27488":64730,"_19100":109110,"_5":13150,"_26023":108999,"_2643":48705},[],{"_3144":64768,"_27488":64730,"_19100":109112,"_5":13150,"_26023":108999,"_2643":109113},[],"Consultar el estado del registro de la CA",{"_3144":64769,"_27488":64730,"_19100":109115,"_5":13150,"_26023":108999,"_2643":48711},[],{"_3144":64770,"_27488":64730,"_19100":109117,"_5":13150,"_26023":108999,"_2643":109118},[],"Crear o actualizar Things en IoT Core",{"_3144":64771,"_27488":64730,"_19100":109120,"_5":13150,"_26023":108999,"_2643":48717},[],{"_3144":64772,"_27488":64730,"_19100":109122,"_5":13150,"_26023":108999,"_2643":109123},[],"Aprovisionar Things mediante plantilla",{"_3144":64773,"_27488":64730,"_19100":109125,"_5":13150,"_26023":108999,"_2643":48723},[],{"_3144":64774,"_27488":64730,"_19100":109127,"_5":13150,"_26023":108999,"_2643":109128},[],"Registrar certificados de dispositivo",{"_3144":64775,"_27488":64730,"_19100":109130,"_5":13150,"_26023":108999,"_2643":48729},[],{"_3144":64776,"_27488":64730,"_19100":109132,"_5":13150,"_26023":108999,"_2643":109133},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3144":64777,"_27488":64730,"_19100":109135,"_5":13150,"_26023":108999,"_2643":48735},[],{"_3144":64778,"_27488":64730,"_19100":109137,"_5":13150,"_26023":108999,"_2643":109138},[],"Crear y adjuntar políticas IoT",{"_3144":64779,"_27488":64730,"_19100":109140,"_5":13150,"_26023":108999,"_2643":48741},[],{"_3144":64780,"_27488":64730,"_19100":109142,"_5":13150,"_26023":108999,"_2643":109143},[],"Gestionar grupos de Things",{"_3144":64781,"_27488":64730,"_19100":109145,"_5":13150,"_26023":108999,"_2643":48747},[],{"_3144":64782,"_27488":64730,"_19100":109147,"_5":13150,"_26023":108999,"_2643":109148},[],"Crear plantillas JITP",{"_3144":64783,"_27488":64730,"_19100":109150,"_5":13150,"_26023":108999,"_2643":48753},[],{"_3144":64784,"_27488":64730,"_19100":109152,"_5":13150,"_26023":108999,"_2643":109153},[],"Leer y escribir el Device Shadow",{"_3144":64785,"_27488":64730,"_19100":109155,"_5":13150,"_26023":108999,"_2643":109156},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3144":64786,"_27488":64730,"_19100":109158,"_5":13150,"_26023":109003,"_2643":109159},[],"Parámetro",{"_3144":64787,"_27488":64730,"_19100":109161,"_5":13150,"_26023":109003,"_2643":109162},[],"Tipo",{"_3144":64788,"_27488":64730,"_19100":109164,"_5":13150,"_26023":109003,"_2643":109165},[],"Requerido",{"_3144":64789,"_27488":64730,"_19100":109167,"_5":13150,"_26023":109003,"_2643":109168},[],"Descripción",{"_3144":64790,"_27488":64730,"_19100":109170,"_5":13150,"_26023":109003,"_2643":48774},[],{"_3144":64791,"_27488":64730,"_19100":109172,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64792,"_27488":64730,"_19100":109174,"_5":13150,"_26023":109003,"_2643":109175},[],"Sí",{"_3144":64793,"_27488":64730,"_19100":109177,"_5":13150,"_26023":109003,"_2643":109178},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3144":64794,"_27488":64730,"_19100":109180,"_5":13150,"_26023":109003,"_2643":48785},[],{"_3144":64795,"_27488":64730,"_19100":109182,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64796,"_27488":64730,"_19100":109184,"_5":13150,"_26023":109003,"_2643":109175},[],{"_3144":64797,"_27488":64730,"_19100":109186,"_5":13150,"_26023":109003,"_2643":109187},[],"Región AWS donde opera el conector.",{"_3144":64798,"_27488":64730,"_19100":109189,"_5":13150,"_26023":109003,"_2643":48795},[],{"_3144":64799,"_27488":64730,"_19100":109191,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64800,"_27488":64730,"_19100":109193,"_5":13150,"_26023":109003,"_2643":109175},[],{"_3144":64801,"_27488":64730,"_19100":109195,"_5":13150,"_26023":109003,"_2643":109196},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3144":64802,"_27488":64730,"_19100":109198,"_5":13150,"_26023":109003,"_2643":48805},[],{"_3144":64803,"_27488":64730,"_19100":109200,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64804,"_27488":64730,"_19100":109202,"_5":13150,"_26023":109003,"_2643":109203},[],"Solo con `auth_method=static`",{"_3144":64805,"_27488":64730,"_19100":109205,"_5":13150,"_26023":109003,"_2643":109206},[],"Clave de acceso AWS.",{"_3144":64806,"_27488":64730,"_19100":109208,"_5":13150,"_26023":109003,"_2643":48816},[],{"_3144":64807,"_27488":64730,"_19100":109210,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64808,"_27488":64730,"_19100":109212,"_5":13150,"_26023":109003,"_2643":109203},[],{"_3144":64809,"_27488":64730,"_19100":109214,"_5":13150,"_26023":109003,"_2643":109215},[],"Clave secreta AWS.",{"_3144":64810,"_27488":64730,"_19100":109217,"_5":13150,"_26023":109003,"_2643":48826},[],{"_3144":64811,"_27488":64730,"_19100":109219,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64812,"_27488":64730,"_19100":109221,"_5":13150,"_26023":109003,"_2643":48831},[],{"_3144":64813,"_27488":64730,"_19100":109223,"_5":13150,"_26023":109003,"_2643":109224},[],"Token de sesión (con `auth_method=static`).",{"_3144":64814,"_27488":64730,"_19100":109226,"_5":13150,"_26023":109003,"_2643":48837},[],{"_3144":64815,"_27488":64730,"_19100":109228,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64816,"_27488":64730,"_19100":109230,"_5":13150,"_26023":109003,"_2643":109231},[],"Solo con `auth_method=role`",{"_3144":64817,"_27488":64730,"_19100":109233,"_5":13150,"_26023":109003,"_2643":109234},[],"ARN del rol a asumir.",{"_3144":64818,"_27488":64730,"_19100":109236,"_5":13150,"_26023":109003,"_2643":48848},[],{"_3144":64819,"_27488":64730,"_19100":109238,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64820,"_27488":64730,"_19100":109240,"_5":13150,"_26023":109003,"_2643":48831},[],{"_3144":64821,"_27488":64730,"_19100":109242,"_5":13150,"_26023":109003,"_2643":109243},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3144":64822,"_27488":64730,"_19100":109245,"_5":13150,"_26023":109003,"_2643":48858},[],{"_3144":64823,"_27488":64730,"_19100":109247,"_5":13150,"_26023":109003,"_2643":16108},[],{"_3144":64824,"_27488":64730,"_19100":109249,"_5":13150,"_26023":109003,"_2643":109175},[],{"_3144":64825,"_27488":64730,"_19100":109251,"_5":13150,"_26023":109003,"_2643":109252},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3144":64826,"_27488":64730,"_19100":109254,"_5":13150,"_26023":109003,"_2643":48868},[],{"_3144":64827,"_27488":64730,"_19100":109256,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64828,"_27488":64730,"_19100":109258,"_5":13150,"_26023":109003,"_2643":109175},[],{"_3144":64829,"_27488":64730,"_19100":109260,"_5":13150,"_26023":109003,"_2643":109261},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3144":64830,"_27488":64730,"_19100":109263,"_5":13150,"_26023":109003,"_2643":48878},[],{"_3144":64831,"_27488":64730,"_19100":109265,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64832,"_27488":64730,"_19100":109267,"_5":13150,"_26023":109003,"_2643":109175},[],{"_3144":64833,"_27488":64730,"_19100":109269,"_5":13150,"_26023":109003,"_2643":109270},[],"URL HTTP del Device Manager de Lamassu.",{"_3144":64834,"_27488":64730,"_19100":109272,"_5":13150,"_26023":109003,"_2643":48888},[],{"_3144":64835,"_27488":64730,"_19100":109274,"_5":13150,"_26023":109003,"_2643":22829},[],{"_3144":64836,"_27488":64730,"_19100":109276,"_5":13150,"_26023":109003,"_2643":109175},[],{"_3144":64837,"_27488":64730,"_19100":109278,"_5":13150,"_26023":109003,"_2643":109279},[],"URL HTTP del servicio de CA de Lamassu.",{"_3144":64838,"_27488":64730,"_19100":109281,"_5":13150,"_26023":109007,"_2643":109282},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3144":64839,"_27488":64730,"_19100":109284,"_5":13150,"_26023":109011,"_2643":109285},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3144":64840,"_27488":64730,"_19100":109287,"_5":13150,"_26023":109011,"_2643":109288},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3144":64841,"_27488":64730,"_19100":109290,"_5":13150,"_26023":109015,"_2643":109291},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3144":64842,"_27488":64730,"_19100":109293,"_5":13150,"_26023":109015,"_2643":109294},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3144":64843,"_27488":64730,"_19100":109296,"_5":13150,"_26023":109015,"_2643":109297},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3144":64844,"_27488":64730,"_19100":109299,"_5":13150,"_26023":109015,"_2643":109300},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3144":64845,"_27488":64730,"_19100":109302,"_5":13150,"_26023":109015,"_2643":109303},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3144":64846,"_27488":64730,"_19100":109305,"_5":13150,"_26023":109015,"_2643":109306},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3144":64847,"_27488":64730,"_19100":109308,"_5":13150,"_26023":109018,"_2643":109309},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3144":64848,"_27488":64730,"_19100":109311,"_5":13150,"_26023":109021,"_2643":109312},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3144":64849,"_27488":64730,"_19100":109314,"_5":13150,"_26023":109021,"_2643":109315},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3144":64850,"_27488":64730,"_19100":109317,"_5":13150,"_26023":109025,"_2643":109318},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3144":64851,"_27488":64730,"_19100":109320,"_5":13150,"_26023":109029,"_2643":109321},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3144":64852,"_27488":64730,"_19100":109323,"_5":13150,"_26023":109029,"_2643":109324},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3144":64853,"_27488":64730,"_19100":109326,"_5":13150,"_26023":109029,"_2643":109327},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3144":64854,"_27488":64730,"_19100":109329,"_5":13150,"_26023":109029,"_2643":109330},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3144":64855,"_27488":64730,"_19100":109332,"_5":13150,"_26023":109029,"_2643":109333},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3144":64856,"_27488":64730,"_19100":109335,"_5":13150,"_26023":109029,"_2643":109336},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3144":64857,"_27488":64730,"_19100":109338,"_5":13150,"_26023":109033,"_2643":109339},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3144":64858,"_27488":64730,"_19100":109341,"_5":13150,"_26023":109033,"_2643":109342},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3144":64859,"_27488":64730,"_19100":109344,"_5":13150,"_26023":109033,"_2643":109345},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3144":64860,"_27488":64730,"_19100":109347,"_5":13150,"_26023":109037,"_2643":109348},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3144":64861,"_27488":64730,"_19100":109350,"_5":13150,"_26023":109037,"_2643":109351},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3144":64862,"_27488":64730,"_19100":109353,"_5":13150,"_26023":109037,"_2643":109354},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3144":64863,"_27488":64730,"_19100":109356,"_5":13150,"_26023":109041,"_2643":109357},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3144":64864,"_27488":64730,"_19100":109359,"_5":13150,"_26023":109041,"_2643":109360},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3144":64865,"_27488":64730,"_19100":109362,"_5":13150,"_26023":109041,"_2643":109363},[],"Para que el flujo JITP funcione correctamente:",{"_3144":64866,"_27488":64730,"_19100":109365,"_5":13150,"_26023":109041,"_2643":109366},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3144":64867,"_27488":64730,"_19100":109368,"_5":13150,"_26023":109041,"_2643":109369},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3144":64868,"_27488":64730,"_19100":109371,"_5":13150,"_26023":109041,"_2643":109372},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3144":64869,"_27488":64730,"_19100":109374,"_5":13150,"_26023":109041,"_2643":109375},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3144":64870,"_27488":64730,"_19100":109377,"_5":13150,"_26023":109045,"_2643":109378},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3144":64871,"_27488":64730,"_19100":109380,"_5":13150,"_26023":109045,"_2643":109381},[],"Estado en Lamassu",{"_3144":64872,"_27488":64730,"_19100":109383,"_5":13150,"_26023":109045,"_2643":109384},[],"Razón de revocación",{"_3144":64873,"_27488":64730,"_19100":109386,"_5":13150,"_26023":109045,"_2643":109387},[],"Estado en AWS IoT Core",{"_3144":64874,"_27488":64730,"_19100":109389,"_5":13150,"_26023":109045,"_2643":49009},[],{"_3144":64875,"_27488":64730,"_19100":109391,"_5":13150,"_26023":109045,"_2643":109392},[],"Ninguna",{"_3144":64876,"_27488":64730,"_19100":109394,"_5":13150,"_26023":109045,"_2643":49015},[],{"_3144":64877,"_27488":64730,"_19100":109396,"_5":13150,"_26023":109045,"_2643":49018},[],{"_3144":64878,"_27488":64730,"_19100":109398,"_5":13150,"_26023":109045,"_2643":49021},[],{"_3144":64879,"_27488":64730,"_19100":109400,"_5":13150,"_26023":109045,"_2643":49024},[],{"_3144":64880,"_27488":64730,"_19100":109402,"_5":13150,"_26023":109045,"_2643":49018},[],{"_3144":64881,"_27488":64730,"_19100":109404,"_5":13150,"_26023":109045,"_2643":109405},[],"Cualquier otra razón",{"_3144":64882,"_27488":64730,"_19100":109407,"_5":13150,"_26023":109045,"_2643":49032},[],{"_3144":64883,"_27488":64730,"_19100":109409,"_5":13150,"_26023":109045,"_2643":109410},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3144":64884,"_27488":64730,"_19100":109412,"_5":13150,"_26023":109049,"_2643":109413},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3144":64885,"_27488":64730,"_19100":109415,"_5":13150,"_26023":109049,"_2643":109416},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3144":64886,"_27488":64730,"_19100":109418,"_5":13150,"_26023":109049,"_2643":109419},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3144":64887,"_27488":64730,"_19100":109421,"_5":13150,"_26023":109053,"_2643":109422},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3144":64888,"_27488":64730,"_19100":109424,"_5":13150,"_26023":109053,"_2643":109425},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3144":64889,"_27488":64730,"_19100":109427,"_5":13150,"_26023":109057,"_2643":109428},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3144":64890,"_27488":64730,"_19100":109430,"_5":13150,"_26023":109057,"_2643":109431},[],"Existen dos tipos de acciones:",{"_3144":64891,"_27488":64730,"_19100":109433,"_5":13150,"_26023":109057,"_2643":109434},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3144":64892,"_27488":64730,"_19100":109436,"_5":13150,"_26023":109057,"_2643":109437},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3144":64893,"_27488":64730,"_19100":109439,"_5":13150,"_26023":109057,"_2643":109440},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3144":64894,"_27488":64730,"_19100":109442,"_5":13150,"_26023":109061,"_2643":109443},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3144":64895,"_27488":64730,"_19100":109445,"_5":13150,"_26023":109061,"_2643":109446},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3144":64896,"_27488":64730,"_19100":109448,"_5":13150,"_26023":109061,"_2643":109449},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3144":64897,"_27488":64730,"_19100":109451,"_5":13150,"_26023":109065,"_2643":109452},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3144":64898,"_27488":64730,"_19100":109454,"_5":13150,"_26023":109065,"_2643":109455},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3144":64899,"_27488":64730,"_19100":109457,"_5":13150,"_26023":109065,"_2643":109458},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3144":64900,"_27488":64730,"_19100":109460,"_5":13150,"_26023":109065,"_2643":109461},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3144":64901,"_27488":64730,"_19100":109463,"_5":13150,"_26023":109065,"_2643":109464},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3144":64902,"_27488":64730,"_19100":109466,"_5":13150,"_26023":109065,"_2643":109467},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3144":64903,"_27488":64730,"_19100":109469,"_5":13150,"_26023":109065,"_2643":109470},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3144":64904,"_27488":64730,"_19100":109472,"_5":13150,"_26023":109065,"_2643":109473},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3144":64905,"_27488":64730,"_19100":109475,"_5":13150,"_26023":109065,"_2643":109476},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3144":64906,"_27488":64730,"_19100":109478,"_5":13150,"_26023":109065,"_2643":109479},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3144":64907,"_27488":64730,"_19100":109481,"_5":13150,"_26023":109065,"_2643":109482},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3144":64908,"_27488":64730,"_19100":109484,"_5":13150,"_26023":109065,"_2643":109485},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3144":64909,"_27488":64730,"_19100":109487,"_5":13150,"_26023":109065,"_2643":109488},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3144":64910,"_27488":64730,"_19100":109490,"_5":13150,"_26023":109065,"_2643":109491},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3144":64911,"_27488":64730,"_19100":109493,"_5":13150,"_26023":109065,"_2643":109494},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3144":64912,"_27488":64730,"_19100":109496,"_5":13150,"_26023":109065,"_2643":109497},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3144":64913,"_27488":64730,"_19100":109499,"_5":13150,"_26023":109065,"_2643":109500},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3144":64914,"_27488":64730,"_19100":109502,"_5":13150,"_26023":109065,"_2643":109503},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3144":64915,"_27488":64730,"_19100":109505,"_5":13150,"_26023":109065,"_2643":109506},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3144":64916,"_27488":64730,"_19100":109508,"_5":13150,"_26023":109065,"_2643":109509},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3144":64917,"_27488":64730,"_19100":109511,"_5":13150,"_26023":109065,"_2643":109512},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3144":64918,"_27488":64918,"_5":13476,"_2643":47118,"_27831":109514,"_19100":109515,"_26023":64918},[44764,106610,47118],[],{"_3144":64919,"_27488":64918,"_19100":109517,"_5":13150,"_26023":64918,"_2643":109518},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3144":64920,"_27488":64918,"_5":27828,"_19100":109520,"_26023":109521,"_2643":109522},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3144":64921,"_27488":64918,"_5":27828,"_19100":109524,"_26023":109525,"_2643":107582},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3144":64922,"_27488":64918,"_5":27828,"_19100":109527,"_26023":109528,"_2643":107757},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3144":64923,"_27488":64918,"_5":27828,"_19100":109530,"_26023":109531,"_2643":108984},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#integraciones",{"_3144":64924,"_27488":64918,"_5":27828,"_19100":109533,"_26023":109534,"_2643":109535},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3144":64925,"_27488":64918,"_19100":109537,"_5":13150,"_26023":64918,"_2643":109538},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3144":64926,"_27488":64918,"_19100":109540,"_5":13150,"_26023":109521,"_2643":109541},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3144":64927,"_27488":64918,"_19100":109543,"_5":13150,"_26023":109521,"_2643":109544},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3144":64928,"_27488":64918,"_19100":109546,"_5":13150,"_26023":109525,"_2643":109547},[],"Recurso",{"_3144":64929,"_27488":64918,"_19100":109549,"_5":13150,"_26023":109525,"_2643":109550},[],"Qué representa",{"_3144":64930,"_27488":64918,"_19100":109552,"_5":13150,"_26023":109525,"_2643":109553},[],"**Dispositivo**",{"_3144":64931,"_27488":64918,"_19100":109555,"_5":13150,"_26023":109525,"_2643":109556},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3144":64932,"_27488":64918,"_19100":109558,"_5":13150,"_26023":109525,"_2643":109559},[],"**Identidad**",{"_3144":64933,"_27488":64918,"_19100":109561,"_5":13150,"_26023":109525,"_2643":109562},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3144":64934,"_27488":64918,"_19100":109564,"_5":13150,"_26023":109525,"_2643":49190},[],{"_3144":64935,"_27488":64918,"_19100":109566,"_5":13150,"_26023":109525,"_2643":109567},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3144":64936,"_27488":64918,"_19100":109569,"_5":13150,"_26023":109525,"_2643":109570},[],"**Flota**",{"_3144":64937,"_27488":64918,"_19100":109572,"_5":13150,"_26023":109525,"_2643":109573},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3144":64938,"_27488":64918,"_19100":109575,"_5":13150,"_26023":109525,"_2643":109576},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3144":64939,"_27488":64918,"_19100":109578,"_5":13150,"_26023":109525,"_2643":109579},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3144":64940,"_27488":64918,"_19100":109581,"_5":13150,"_26023":109528,"_2643":109582},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3144":64941,"_27488":64918,"_19100":109584,"_5":13150,"_26023":109528,"_2643":109585},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3144":64942,"_27488":64918,"_19100":109587,"_5":13150,"_26023":109528,"_2643":109588},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3144":64943,"_27488":64918,"_19100":109590,"_5":13150,"_26023":109528,"_2643":109591},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3144":64944,"_27488":64918,"_19100":109593,"_5":13150,"_26023":109528,"_2643":109594},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3144":64945,"_27488":64918,"_19100":109596,"_5":13150,"_26023":109528,"_2643":109597},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3144":64946,"_27488":64918,"_19100":109599,"_5":13150,"_26023":109528,"_2643":109600},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3144":64947,"_27488":64918,"_19100":109602,"_5":13150,"_26023":109528,"_2643":109603},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3144":64948,"_27488":64918,"_19100":109605,"_5":13150,"_26023":109531,"_2643":109606},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3144":64949,"_27488":64918,"_19100":109608,"_5":13150,"_26023":109531,"_2643":109609},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3144":64950,"_27488":64918,"_19100":109611,"_5":13150,"_26023":109534,"_2643":109612},[],"Participante",{"_3144":64951,"_27488":64918,"_19100":109614,"_5":13150,"_26023":109534,"_2643":109615},[],"Responsabilidad",{"_3144":64952,"_27488":64918,"_19100":109617,"_5":13150,"_26023":109534,"_2643":109618},[],"Administrador PKI",{"_3144":64953,"_27488":64918,"_19100":109620,"_5":13150,"_26023":109534,"_2643":109621},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3144":64954,"_27488":64918,"_19100":109623,"_5":13150,"_26023":109534,"_2643":109624},[],"Administrador del aprovisionamiento",{"_3144":64955,"_27488":64918,"_19100":109626,"_5":13150,"_26023":109534,"_2643":109627},[],"DMS, admisión, autenticación por operación e inventario.",{"_3144":64956,"_27488":64918,"_19100":109629,"_5":13150,"_26023":109534,"_2643":109630},[],"Integrador del dispositivo",{"_3144":64957,"_27488":64918,"_19100":109632,"_5":13150,"_26023":109534,"_2643":109633},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3144":64958,"_27488":64918,"_19100":109635,"_5":13150,"_26023":109534,"_2643":109636},[],"Integrador del consumidor",{"_3144":64959,"_27488":64918,"_19100":109638,"_5":13150,"_26023":109534,"_2643":109639},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3144":64960,"_27488":64918,"_19100":109641,"_5":13150,"_26023":109534,"_2643":109642},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3144":64961,"_27488":64961,"_5":13476,"_2643":109644,"_27831":109645,"_19100":109647,"_26023":64961},"Enrola y conecta tu primer dispositivo",[44764,106610,47118,109646],"Primeros pasos",[],{"_3144":64962,"_27488":64961,"_19100":109649,"_5":13150,"_26023":64961,"_2643":109650},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3144":64963,"_27488":64961,"_5":27828,"_19100":109652,"_26023":109653,"_2643":105276},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3144":64964,"_27488":64961,"_5":27828,"_19100":109655,"_26023":109656,"_2643":109657},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3144":64965,"_27488":64961,"_5":27828,"_19100":109659,"_26023":109660,"_2643":109661},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3144":64966,"_27488":64961,"_5":27828,"_19100":109663,"_26023":109664,"_2643":109665},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3144":64967,"_27488":64961,"_5":27828,"_19100":109667,"_26023":109668,"_2643":109669},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3144":64968,"_27488":64961,"_5":27828,"_19100":109671,"_26023":109672,"_2643":109673},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3144":64969,"_27488":64961,"_5":27828,"_19100":109675,"_26023":109676,"_2643":109677},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3144":64970,"_27488":64961,"_5":27828,"_19100":109679,"_26023":109680,"_2643":109681},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3144":64971,"_27488":64961,"_19100":109683,"_5":13150,"_26023":64961,"_2643":109684},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3144":64972,"_27488":64961,"_19100":109686,"_5":13150,"_26023":109653,"_2643":109687},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3144":64973,"_27488":64961,"_19100":109689,"_5":13150,"_26023":109653,"_2643":109690},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3144":64974,"_27488":64961,"_19100":109692,"_5":13150,"_26023":109653,"_2643":109693},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3144":64975,"_27488":64961,"_19100":109695,"_5":13150,"_26023":109653,"_2643":109696},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3144":64976,"_27488":64961,"_19100":109698,"_5":13150,"_26023":109653,"_2643":109699},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3144":64977,"_27488":64961,"_19100":109701,"_5":13150,"_26023":109656,"_2643":109702},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3144":64978,"_27488":64961,"_19100":109704,"_5":13150,"_26023":109656,"_2643":109705},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3144":64979,"_27488":64961,"_19100":109707,"_5":13150,"_26023":109660,"_2643":109708},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3144":64980,"_27488":64961,"_19100":109710,"_5":13150,"_26023":109660,"_2643":109711},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3144":64981,"_27488":64961,"_19100":109713,"_5":13150,"_26023":109660,"_2643":109714},[],"Ajuste",{"_3144":64982,"_27488":64961,"_19100":109716,"_5":13150,"_26023":109660,"_2643":109717},[],"Valor de evaluación",{"_3144":64983,"_27488":64961,"_19100":109719,"_5":13150,"_26023":109660,"_2643":49346},[],{"_3144":64984,"_27488":64961,"_19100":109721,"_5":13150,"_26023":109660,"_2643":109722},[],"Raíz emisora de `device-root.pem`.",{"_3144":64985,"_27488":64961,"_19100":109724,"_5":13150,"_26023":109660,"_2643":107885},[],{"_3144":64986,"_27488":64961,"_19100":109726,"_5":13150,"_26023":109660,"_2643":109727},[],"Perfil final de 1 hora que acabas de preparar.",{"_3144":64987,"_27488":64961,"_19100":109729,"_5":13150,"_26023":109660,"_2643":49357},[],{"_3144":64988,"_27488":64961,"_19100":109731,"_5":13150,"_26023":109660,"_2643":49360},[],{"_3144":64989,"_27488":64961,"_19100":109733,"_5":13150,"_26023":109660,"_2643":49363},[],{"_3144":64990,"_27488":64961,"_19100":109735,"_5":13150,"_26023":109660,"_2643":109736},[],"Habilitado.",{"_3144":64991,"_27488":64961,"_19100":109738,"_5":13150,"_26023":109660,"_2643":49369},[],{"_3144":64992,"_27488":64961,"_19100":109740,"_5":13150,"_26023":109660,"_2643":109741},[],"Deshabilitado; el ID debe ser nuevo.",{"_3144":64993,"_27488":64961,"_19100":109743,"_5":13150,"_26023":109660,"_2643":109744},[],"Autenticación inicial",{"_3144":64994,"_27488":64961,"_19100":109746,"_5":13150,"_26023":109660,"_2643":109747},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3144":64995,"_27488":64961,"_19100":109749,"_5":13150,"_26023":109660,"_2643":109750},[],"Autenticación de renovación",{"_3144":64996,"_27488":64961,"_19100":109752,"_5":13150,"_26023":109660,"_2643":109753},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3144":64997,"_27488":64961,"_19100":109755,"_5":13150,"_26023":109660,"_2643":49387},[],{"_3144":64998,"_27488":64961,"_19100":109757,"_5":13150,"_26023":109660,"_2643":109758},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_3144":64999,"_27488":64961,"_19100":109760,"_5":13150,"_26023":109660,"_2643":49393},[],{"_3144":65000,"_27488":64961,"_19100":109762,"_5":13150,"_26023":109660,"_2643":109763},[],"1 hora.",{"_3144":65001,"_27488":64961,"_19100":109765,"_5":13150,"_26023":109660,"_2643":49399},[],{"_3144":65002,"_27488":64961,"_19100":109767,"_5":13150,"_26023":109660,"_2643":109768},[],"30 minutos / 10 minutos.",{"_3144":65003,"_27488":64961,"_19100":109770,"_5":13150,"_26023":109660,"_2643":49405},[],{"_3144":65004,"_27488":64961,"_19100":109772,"_5":13150,"_26023":109660,"_2643":109773},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3144":65005,"_27488":64961,"_19100":109775,"_5":13150,"_26023":109660,"_2643":47437},[],{"_3144":65006,"_27488":64961,"_19100":109777,"_5":13150,"_26023":109660,"_2643":109778},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3144":65007,"_27488":64961,"_19100":109780,"_5":13150,"_26023":109660,"_2643":49416},[],{"_3144":65008,"_27488":64961,"_19100":109782,"_5":13150,"_26023":109660,"_2643":109783},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3144":65009,"_27488":64961,"_19100":109785,"_5":13150,"_26023":109660,"_2643":109786},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3144":65010,"_27488":64961,"_19100":109788,"_5":13150,"_26023":109664,"_2643":109789},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3144":65011,"_27488":64961,"_19100":109791,"_5":13150,"_26023":109664,"_2643":109792},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3144":65012,"_27488":64961,"_19100":109794,"_5":13150,"_26023":109668,"_2643":109795},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3144":65013,"_27488":64961,"_19100":109797,"_5":13150,"_26023":109668,"_2643":109798},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3144":65014,"_27488":64961,"_19100":109800,"_5":13150,"_26023":109668,"_2643":109801},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3144":65015,"_27488":64961,"_19100":109803,"_5":13150,"_26023":109672,"_2643":109804},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3144":65016,"_27488":64961,"_19100":109806,"_5":13150,"_26023":109672,"_2643":109807},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3144":65017,"_27488":64961,"_19100":109809,"_5":13150,"_26023":109676,"_2643":109810},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3144":65018,"_27488":64961,"_19100":109812,"_5":13150,"_26023":109676,"_2643":109813},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3144":65019,"_27488":64961,"_19100":109815,"_5":13150,"_26023":109676,"_2643":109816},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3144":65020,"_27488":64961,"_19100":109818,"_5":13150,"_26023":109676,"_2643":109819},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3144":65021,"_27488":64961,"_19100":109821,"_5":13150,"_26023":109676,"_2643":109822},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3144":65022,"_27488":64961,"_19100":109824,"_5":13150,"_26023":109680,"_2643":109825},[],"Comprobación",{"_3144":65023,"_27488":64961,"_19100":109827,"_5":13150,"_26023":109680,"_2643":109828},[],"Resultado esperado",{"_3144":65024,"_27488":64961,"_19100":109830,"_5":13150,"_26023":109680,"_2643":109831},[],"Registro",{"_3144":65025,"_27488":64961,"_19100":109833,"_5":13150,"_26023":109680,"_2643":109834},[],"ID creado automáticamente y DMS correcto.",{"_3144":65026,"_27488":64961,"_19100":109836,"_5":13150,"_26023":109680,"_2643":109837},[],"Certificado",{"_3144":65027,"_27488":64961,"_19100":109839,"_5":13150,"_26023":109680,"_2643":109840},[],"CN, perfil, serie y clave verificados.",{"_3144":65028,"_27488":64961,"_19100":109842,"_5":13150,"_26023":109680,"_2643":109843},[],"Inventario",{"_3144":65029,"_27488":64961,"_19100":109845,"_5":13150,"_26023":109680,"_2643":109846},[],"Serie recibida visible como identidad actual y en el historial.",{"_3144":65030,"_27488":64961,"_19100":109848,"_5":13150,"_26023":109680,"_2643":109849},[],"Consumidor",{"_3144":65031,"_27488":64961,"_19100":109851,"_5":13150,"_26023":109680,"_2643":109852},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3144":65032,"_27488":64961,"_19100":109854,"_5":13150,"_26023":109680,"_2643":109855},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3144":65033,"_27488":64961,"_19100":109857,"_5":13150,"_26023":109680,"_2643":109858},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3144":65034,"_27488":65034,"_5":13476,"_2643":107599,"_27831":109860,"_19100":109861,"_26023":65034},[44764,106610,47118,109646],[],{"_3144":65035,"_27488":65034,"_19100":109863,"_5":13150,"_26023":65034,"_2643":109864},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3144":65036,"_27488":65034,"_5":27828,"_19100":109866,"_26023":109867,"_2643":105276},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3144":65037,"_27488":65034,"_5":27828,"_19100":109869,"_26023":109870,"_2643":109871},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3144":65038,"_27488":65034,"_5":27828,"_19100":109873,"_26023":109874,"_2643":109875},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3144":65039,"_27488":65034,"_5":27828,"_19100":109877,"_26023":109878,"_2643":109879},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3144":65040,"_27488":65034,"_5":27828,"_19100":109881,"_26023":109882,"_2643":109883},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3144":65041,"_27488":65034,"_5":27828,"_19100":109885,"_26023":109886,"_2643":109887},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3144":65042,"_27488":65034,"_5":27828,"_19100":109889,"_26023":109890,"_2643":109828},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3144":65043,"_27488":65034,"_5":27828,"_19100":109892,"_26023":109893,"_2643":109894},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3144":65044,"_27488":65034,"_5":27828,"_19100":109896,"_26023":109897,"_2643":109898},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3144":65045,"_27488":65034,"_19100":109900,"_5":13150,"_26023":65034,"_2643":109901},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3144":65046,"_27488":65034,"_19100":109903,"_5":13150,"_26023":65034,"_2643":109904},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3144":65047,"_27488":65034,"_19100":109906,"_5":13150,"_26023":109867,"_2643":109907},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3144":65048,"_27488":65034,"_19100":109909,"_5":13150,"_26023":109867,"_2643":109910},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3144":65049,"_27488":65034,"_19100":109912,"_5":13150,"_26023":109867,"_2643":109913},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3144":65050,"_27488":65034,"_19100":109915,"_5":13150,"_26023":109867,"_2643":109916},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3144":65051,"_27488":65034,"_19100":109918,"_5":13150,"_26023":109870,"_2643":109919},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3144":65052,"_27488":65034,"_19100":109921,"_5":13150,"_26023":109870,"_2643":109922},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3144":65053,"_27488":65034,"_19100":109924,"_5":13150,"_26023":109870,"_2643":109925},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3144":65054,"_27488":65034,"_19100":109927,"_5":13150,"_26023":109870,"_2643":109928},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3144":65055,"_27488":65034,"_19100":109930,"_5":13150,"_26023":109870,"_2643":109931},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_3144":65056,"_27488":65034,"_19100":109933,"_5":13150,"_26023":109870,"_2643":109934},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3144":65057,"_27488":65034,"_19100":109936,"_5":13150,"_26023":109870,"_2643":109937},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3144":65058,"_27488":65034,"_19100":109939,"_5":13150,"_26023":109870,"_2643":109940},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3144":65059,"_27488":65034,"_19100":109942,"_5":13150,"_26023":109874,"_2643":109943},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3144":65060,"_27488":65034,"_19100":109945,"_5":13150,"_26023":109874,"_2643":49582},[],{"_3144":65061,"_27488":65034,"_19100":109947,"_5":13150,"_26023":109874,"_2643":109948},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3144":65062,"_27488":65034,"_19100":109950,"_5":13150,"_26023":109874,"_2643":109951},[],"**Icon** y **Tags**: clasificación opcional.",{"_3144":65063,"_27488":65034,"_19100":109953,"_5":13150,"_26023":109874,"_2643":109954},[],"Confirma el registro.",{"_3144":65064,"_27488":65034,"_19100":109956,"_5":13150,"_26023":109878,"_2643":109957},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3144":65065,"_27488":65034,"_19100":109959,"_5":13150,"_26023":109878,"_2643":109960},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3144":65066,"_27488":65034,"_19100":109962,"_5":13150,"_26023":109882,"_2643":109963},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3144":65067,"_27488":65034,"_19100":109965,"_5":13150,"_26023":109882,"_2643":109966},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3144":65068,"_27488":65034,"_19100":109968,"_5":13150,"_26023":109886,"_2643":109969},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3144":65069,"_27488":65034,"_19100":109971,"_5":13150,"_26023":109886,"_2643":109972},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3144":65070,"_27488":65034,"_19100":109974,"_5":13150,"_26023":109890,"_2643":109825},[],{"_3144":65071,"_27488":65034,"_19100":109976,"_5":13150,"_26023":109890,"_2643":109977},[],"Resultado",{"_3144":65072,"_27488":65034,"_19100":109979,"_5":13150,"_26023":109890,"_2643":109980},[],"Dispositivo",{"_3144":65073,"_27488":65034,"_19100":109982,"_5":13150,"_26023":109890,"_2643":109983},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3144":65074,"_27488":65034,"_19100":109985,"_5":13150,"_26023":109890,"_2643":109986},[],"Identidad actual",{"_3144":65075,"_27488":65034,"_19100":109988,"_5":13150,"_26023":109890,"_2643":109989},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3144":65076,"_27488":65034,"_19100":109991,"_5":13150,"_26023":109890,"_2643":109992},[],"Historial",{"_3144":65077,"_27488":65034,"_19100":109994,"_5":13150,"_26023":109890,"_2643":109995},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3144":65078,"_27488":65034,"_19100":109997,"_5":13150,"_26023":109890,"_2643":109998},[],"Clave y certificado",{"_3144":65079,"_27488":65034,"_19100":110000,"_5":13150,"_26023":109890,"_2643":110001},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3144":65080,"_27488":65034,"_19100":110003,"_5":13150,"_26023":109893,"_2643":110004},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3144":65081,"_27488":65034,"_19100":110006,"_5":13150,"_26023":109893,"_2643":110007},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3144":65082,"_27488":65034,"_19100":110009,"_5":13150,"_26023":109893,"_2643":110010},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3144":65083,"_27488":65034,"_19100":110012,"_5":13150,"_26023":109893,"_2643":110013},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3144":65084,"_27488":65034,"_19100":110015,"_5":13150,"_26023":109897,"_2643":110016},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3144":65085,"_27488":65034,"_19100":110018,"_5":13150,"_26023":109897,"_2643":110019},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3144":65086,"_27488":65034,"_19100":110021,"_5":13150,"_26023":109897,"_2643":110022},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3144":65087,"_27488":65087,"_5":13476,"_2643":110024,"_27831":110025,"_19100":110026,"_26023":65087},"Plataforma Lamassu IoT",[44764,106610],[],{"_3144":65088,"_27488":65087,"_19100":110028,"_5":13150,"_26023":65087,"_2643":110029},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3144":65089,"_27488":65087,"_5":27828,"_19100":110031,"_26023":110032,"_2643":109522},[],"/docs/pr-preview/pr-26/es/platform/overview#empieza-aquí",{"_3144":65090,"_27488":65087,"_5":27828,"_19100":110034,"_26023":110035,"_2643":110036},[],"/docs/pr-preview/pr-26/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3144":65091,"_27488":65087,"_5":27828,"_19100":110038,"_26023":110039,"_2643":110040},[],"/docs/pr-preview/pr-26/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3144":65092,"_27488":65087,"_5":27828,"_19100":110042,"_26023":110043,"_2643":110044},[],"/docs/pr-preview/pr-26/es/platform/overview#capacidades-principales","Capacidades principales",{"_3144":65093,"_27488":65087,"_5":27828,"_19100":110046,"_26023":110047,"_2643":110048},[],"/docs/pr-preview/pr-26/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3144":65094,"_27488":65087,"_5":27828,"_19100":110050,"_26023":110051,"_2643":110052},[],"/docs/pr-preview/pr-26/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3144":65095,"_27488":65087,"_5":27828,"_19100":110054,"_26023":110055,"_2643":110056},[],"/docs/pr-preview/pr-26/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3144":65096,"_27488":65087,"_5":27828,"_19100":110058,"_26023":110059,"_2643":110060},[],"/docs/pr-preview/pr-26/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3144":65097,"_27488":65087,"_5":27828,"_19100":110062,"_26023":110063,"_2643":110064},[],"/docs/pr-preview/pr-26/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3144":65098,"_27488":65087,"_5":27828,"_19100":110066,"_26023":110067,"_2643":110068},[],"/docs/pr-preview/pr-26/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3144":65099,"_27488":65087,"_5":27828,"_19100":110070,"_26023":110071,"_2643":110072},[],"/docs/pr-preview/pr-26/es/platform/overview#referencia-operativa","Referencia operativa",{"_3144":65100,"_27488":65087,"_19100":110074,"_5":13150,"_26023":65087,"_2643":110075},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3144":65101,"_27488":65087,"_19100":110077,"_5":13150,"_26023":110032,"_2643":110078},[],"Elige el resultado que necesitas obtener:",{"_3144":65102,"_27488":65087,"_19100":110080,"_5":13150,"_26023":110032,"_2643":110081},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3144":65103,"_27488":65087,"_19100":110083,"_5":13150,"_26023":110032,"_2643":110084},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3144":65104,"_27488":65087,"_19100":110086,"_5":13150,"_26023":110032,"_2643":110087},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3144":65105,"_27488":65087,"_19100":110089,"_5":13150,"_26023":110035,"_2643":110090},[],"Bloque",{"_3144":65106,"_27488":65087,"_19100":110092,"_5":13150,"_26023":110035,"_2643":110093},[],"Qué gestionas",{"_3144":65107,"_27488":65087,"_19100":110095,"_5":13150,"_26023":110035,"_2643":110096},[],"Punto de entrada",{"_3144":65108,"_27488":65087,"_19100":110098,"_5":13150,"_26023":110035,"_2643":49736},[],{"_3144":65109,"_27488":65087,"_19100":110100,"_5":13150,"_26023":110035,"_2643":110101},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3144":65110,"_27488":65087,"_19100":110103,"_5":13150,"_26023":110035,"_2643":110104},[],"Visión general de PKI",{"_3144":65111,"_27488":65087,"_19100":110106,"_5":13150,"_26023":110035,"_2643":49745},[],{"_3144":65112,"_27488":65087,"_19100":110108,"_5":13150,"_26023":110035,"_2643":110109},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3144":65113,"_27488":65087,"_19100":110111,"_5":13150,"_26023":110035,"_2643":110112},[],"Visión general de IoT Fleets",{"_3144":65114,"_27488":65087,"_19100":110114,"_5":13150,"_26023":110035,"_2643":110115},[],"**Administración**",{"_3144":65115,"_27488":65087,"_19100":110117,"_5":13150,"_26023":110035,"_2643":110118},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3144":65116,"_27488":65087,"_19100":110120,"_5":13150,"_26023":110035,"_2643":106608},[],{"_3144":65117,"_27488":65087,"_19100":110122,"_5":13150,"_26023":110035,"_2643":110123},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3144":65118,"_27488":65087,"_19100":110125,"_5":13150,"_26023":110039,"_2643":110126},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3144":65119,"_27488":65087,"_19100":110128,"_5":13150,"_26023":110039,"_2643":110129},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3144":65120,"_27488":65087,"_19100":110131,"_5":13150,"_26023":110039,"_2643":110132},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3144":65121,"_27488":65087,"_19100":110134,"_5":13150,"_26023":110039,"_2643":110135},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3144":65122,"_27488":65087,"_19100":110137,"_5":13150,"_26023":110039,"_2643":110138},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3144":65123,"_27488":65087,"_19100":110140,"_5":13150,"_26023":110039,"_2643":110141},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3144":65124,"_27488":65087,"_19100":110143,"_5":13150,"_26023":110047,"_2643":110144},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3144":65125,"_27488":65087,"_19100":110146,"_5":13150,"_26023":110051,"_2643":110147},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3144":65126,"_27488":65087,"_19100":110149,"_5":13150,"_26023":110055,"_2643":110150},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3144":65127,"_27488":65087,"_19100":110152,"_5":13150,"_26023":110059,"_2643":110153},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3144":65128,"_27488":65087,"_19100":110155,"_5":13150,"_26023":110063,"_2643":110156},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3144":65129,"_27488":65087,"_19100":110158,"_5":13150,"_26023":110067,"_2643":110159},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3144":65130,"_27488":65087,"_19100":110161,"_5":13150,"_26023":110071,"_2643":109615},[],{"_3144":65131,"_27488":65087,"_19100":110163,"_5":13150,"_26023":110071,"_2643":110164},[],"Qué prepara o comprueba",{"_3144":65132,"_27488":65087,"_19100":110166,"_5":13150,"_26023":110071,"_2643":109618},[],{"_3144":65133,"_27488":65087,"_19100":110168,"_5":13150,"_26023":110071,"_2643":110169},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3144":65134,"_27488":65087,"_19100":110171,"_5":13150,"_26023":110071,"_2643":110172},[],"Administrador de la flota",{"_3144":65135,"_27488":65087,"_19100":110174,"_5":13150,"_26023":110071,"_2643":110175},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3144":65136,"_27488":65087,"_19100":110177,"_5":13150,"_26023":110071,"_2643":109630},[],{"_3144":65137,"_27488":65087,"_19100":110179,"_5":13150,"_26023":110071,"_2643":110180},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3144":65138,"_27488":65087,"_19100":110182,"_5":13150,"_26023":110071,"_2643":109636},[],{"_3144":65139,"_27488":65087,"_19100":110184,"_5":13150,"_26023":110071,"_2643":110185},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3144":65140,"_27488":65087,"_19100":110187,"_5":13150,"_26023":110071,"_2643":110188},[],"Operador de infraestructura",{"_3144":65141,"_27488":65087,"_19100":110190,"_5":13150,"_26023":110071,"_2643":110191},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3144":65142,"_27488":65087,"_19100":110193,"_5":13150,"_26023":110071,"_2643":110194},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3144":65143,"_27488":65143,"_5":13476,"_2643":110196,"_27831":110197,"_19100":110199,"_26023":65143},"Jerarquía y rotación de CAs",[44764,106610,49837,110198],"Claves, autoridades y certificados",[],{"_3144":65144,"_27488":65143,"_19100":110201,"_5":13150,"_26023":65143,"_2643":110202},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3144":65145,"_27488":65143,"_5":27828,"_19100":110204,"_26023":110205,"_2643":110206},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3144":65146,"_27488":65143,"_5":27828,"_19100":110208,"_26023":110209,"_2643":110210},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3144":65147,"_27488":65143,"_5":27828,"_19100":110212,"_26023":110213,"_2643":110214},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3144":65148,"_27488":65143,"_5":27828,"_19100":110216,"_26023":110217,"_2643":110218},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3144":65149,"_27488":65143,"_5":27828,"_19100":110220,"_26023":110221,"_2643":110222},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3144":65150,"_27488":65143,"_5":27828,"_19100":110224,"_26023":110225,"_2643":110226},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3144":65151,"_27488":65143,"_5":27828,"_19100":110228,"_26023":110229,"_2643":110230},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3144":65152,"_27488":65143,"_5":27828,"_19100":110232,"_26023":110233,"_2643":110234},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3144":65153,"_27488":65143,"_5":27828,"_19100":110236,"_26023":110237,"_2643":110238},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3144":65154,"_27488":65143,"_5":27828,"_19100":110240,"_26023":110241,"_2643":110242},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3144":65155,"_27488":65143,"_5":27828,"_19100":110244,"_26023":110245,"_2643":110246},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3144":65156,"_27488":65143,"_5":27828,"_19100":110248,"_26023":110249,"_2643":110250},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3144":65157,"_27488":65143,"_19100":110252,"_5":13150,"_26023":65143,"_2643":110253},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3144":65158,"_27488":65143,"_19100":110255,"_5":13150,"_26023":65143,"_2643":110256},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3144":65159,"_27488":65143,"_19100":110258,"_5":13150,"_26023":110205,"_2643":110259},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3144":65160,"_27488":65143,"_19100":110261,"_5":13150,"_26023":110205,"_2643":110262},[],"entorno, como producción y preproducción;",{"_3144":65161,"_27488":65143,"_19100":110264,"_5":13150,"_26023":110205,"_2643":110265},[],"propietario o equipo operador;",{"_3144":65162,"_27488":65143,"_19100":110267,"_5":13150,"_26023":110205,"_2643":110268},[],"familia de dispositivos o proceso de fabricación;",{"_3144":65163,"_27488":65143,"_19100":110270,"_5":13150,"_26023":110205,"_2643":110271},[],"región o requisito regulatorio;",{"_3144":65164,"_27488":65143,"_19100":110273,"_5":13150,"_26023":110205,"_2643":110274},[],"motor criptográfico o política de clave;",{"_3144":65165,"_27488":65143,"_19100":110276,"_5":13150,"_26023":110205,"_2643":110277},[],"ventana de mantenimiento y ritmo de renovación.",{"_3144":65166,"_27488":65143,"_19100":110279,"_5":13150,"_26023":110205,"_2643":110280},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3144":65167,"_27488":65143,"_19100":110282,"_5":13150,"_26023":110205,"_2643":110283},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3144":65168,"_27488":65143,"_19100":110285,"_5":13150,"_26023":110209,"_2643":110286},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3144":65169,"_27488":65143,"_19100":110288,"_5":13150,"_26023":110209,"_2643":110289},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3144":65170,"_27488":65143,"_19100":110291,"_5":13150,"_26023":110209,"_2643":110292},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3144":65171,"_27488":65143,"_19100":110294,"_5":13150,"_26023":110213,"_2643":110295},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3144":65172,"_27488":65143,"_19100":110297,"_5":13150,"_26023":110213,"_2643":110298},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3144":65173,"_27488":65143,"_19100":110300,"_5":13150,"_26023":110213,"_2643":110301},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3144":65174,"_27488":65143,"_19100":110303,"_5":13150,"_26023":110213,"_2643":110304},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3144":65175,"_27488":65143,"_19100":110306,"_5":13150,"_26023":110221,"_2643":110307},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3144":65176,"_27488":65143,"_19100":110309,"_5":13150,"_26023":110225,"_2643":110310},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3144":65177,"_27488":65143,"_19100":110312,"_5":13150,"_26023":110229,"_2643":110313},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3144":65178,"_27488":65143,"_19100":110315,"_5":13150,"_26023":110233,"_2643":110316},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_3144":65179,"_27488":65143,"_19100":110318,"_5":13150,"_26023":110237,"_2643":110319},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3144":65180,"_27488":65143,"_19100":110321,"_5":13150,"_26023":110241,"_2643":110322},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_3144":65181,"_27488":65143,"_19100":110324,"_5":13150,"_26023":110245,"_2643":110325},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3144":65182,"_27488":65143,"_19100":110327,"_5":13150,"_26023":110245,"_2643":110328},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3144":65183,"_27488":65143,"_19100":110330,"_5":13150,"_26023":110245,"_2643":110331},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3144":65184,"_27488":65143,"_19100":110333,"_5":13150,"_26023":110245,"_2643":110334},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3144":65185,"_27488":65143,"_19100":110336,"_5":13150,"_26023":110249,"_2643":110337},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3144":65186,"_27488":65143,"_19100":110339,"_5":13150,"_26023":110249,"_2643":110340},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3144":65187,"_27488":65143,"_19100":110342,"_5":13150,"_26023":110249,"_2643":110343},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3144":65188,"_27488":65143,"_19100":110345,"_5":13150,"_26023":110249,"_2643":110346},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3144":65189,"_27488":65143,"_19100":110348,"_5":13150,"_26023":110249,"_2643":110349},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3144":65190,"_27488":65143,"_19100":110351,"_5":13150,"_26023":110249,"_2643":110352},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3144":65191,"_27488":65143,"_19100":110354,"_5":13150,"_26023":110249,"_2643":110355},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3144":65192,"_27488":65192,"_5":13476,"_2643":110357,"_27831":110358,"_19100":110359,"_26023":65192},"Autoridades de certificación",[44764,106610,49837,110198],[],{"_3144":65193,"_27488":65192,"_19100":110361,"_5":13150,"_26023":65192,"_2643":110362},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3144":65194,"_27488":65192,"_5":27828,"_19100":110364,"_26023":110365,"_2643":110366},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3144":65195,"_27488":65192,"_5":27828,"_19100":110368,"_26023":110369,"_2643":110370},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3144":65196,"_27488":65192,"_5":27828,"_19100":110372,"_26023":110373,"_2643":105276},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3144":65197,"_27488":65192,"_5":27828,"_19100":110375,"_26023":110376,"_2643":110377},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3144":65198,"_27488":65192,"_5":27828,"_19100":110379,"_26023":110380,"_2643":110381},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3144":65199,"_27488":65192,"_5":27828,"_19100":110383,"_26023":110384,"_2643":110385},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3144":65200,"_27488":65192,"_5":27828,"_19100":110387,"_26023":110388,"_2643":110389},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3144":65201,"_27488":65192,"_5":27828,"_19100":110391,"_26023":110392,"_2643":110393},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3144":65202,"_27488":65192,"_5":27828,"_19100":110395,"_26023":110396,"_2643":110397},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3144":65203,"_27488":65192,"_5":27828,"_19100":110399,"_26023":110400,"_2643":110401},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3144":65204,"_27488":65192,"_5":27828,"_19100":110403,"_26023":110404,"_2643":110405},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3144":65205,"_27488":65192,"_5":27828,"_19100":110407,"_26023":110408,"_2643":110409},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3144":65206,"_27488":65192,"_5":27828,"_19100":110411,"_26023":110412,"_2643":110413},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3144":65207,"_27488":65192,"_5":27828,"_19100":110415,"_26023":110416,"_2643":110417},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3144":65208,"_27488":65192,"_5":27828,"_19100":110419,"_26023":110420,"_2643":110421},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3144":65209,"_27488":65192,"_5":27828,"_19100":110423,"_26023":110424,"_2643":110425},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3144":65210,"_27488":65192,"_5":27828,"_19100":110427,"_26023":110428,"_2643":110429},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3144":65211,"_27488":65192,"_5":27828,"_19100":110431,"_26023":110432,"_2643":110433},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3144":65212,"_27488":65192,"_5":27828,"_19100":110435,"_26023":110436,"_2643":110437},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3144":65213,"_27488":65192,"_5":27828,"_19100":110439,"_26023":110440,"_2643":110441},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3144":65214,"_27488":65192,"_5":27828,"_19100":110443,"_26023":110444,"_2643":110445},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3144":65215,"_27488":65192,"_5":27828,"_19100":110447,"_26023":110448,"_2643":110449},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3144":65216,"_27488":65192,"_19100":110451,"_5":13150,"_26023":65192,"_2643":110452},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3144":65217,"_27488":65192,"_19100":110454,"_5":13150,"_26023":65192,"_2643":110455},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3144":65218,"_27488":65192,"_19100":110457,"_5":13150,"_26023":65192,"_2643":110458},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3144":65219,"_27488":65192,"_19100":110460,"_5":13150,"_26023":110365,"_2643":110461},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3144":65220,"_27488":65192,"_19100":110463,"_5":13150,"_26023":110365,"_2643":110464},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3144":65221,"_27488":65192,"_19100":110466,"_5":13150,"_26023":110365,"_2643":110467},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3144":65222,"_27488":65192,"_19100":110469,"_5":13150,"_26023":110365,"_2643":110470},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3144":65223,"_27488":65192,"_19100":110472,"_5":13150,"_26023":110365,"_2643":110473},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3144":65224,"_27488":65192,"_19100":110475,"_5":13150,"_26023":110373,"_2643":110476},[],"Decide si la CA será raíz o intermedia.",{"_3144":65225,"_27488":65192,"_19100":110478,"_5":13150,"_26023":110373,"_2643":110479},[],"Elige el motor que custodiará la clave.",{"_3144":65226,"_27488":65192,"_19100":110481,"_5":13150,"_26023":110373,"_2643":110482},[],"Define una validez superior a la de los certificados que emitirá.",{"_3144":65227,"_27488":65192,"_19100":110484,"_5":13150,"_26023":110373,"_2643":110485},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3144":65228,"_27488":65192,"_19100":110487,"_5":13150,"_26023":110376,"_2643":110488},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3144":65229,"_27488":65192,"_19100":110490,"_5":13150,"_26023":110380,"_2643":110491},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3144":65230,"_27488":65192,"_19100":110493,"_5":13150,"_26023":110380,"_2643":110494},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3144":65231,"_27488":65192,"_19100":110496,"_5":13150,"_26023":110384,"_2643":110497},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3144":65232,"_27488":65192,"_19100":110499,"_5":13150,"_26023":110388,"_2643":110500},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3144":65233,"_27488":65192,"_19100":110502,"_5":13150,"_26023":110388,"_2643":110503},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3144":65234,"_27488":65192,"_19100":110505,"_5":13150,"_26023":110388,"_2643":110506},[],"`ST`: estado o provincia.",{"_3144":65235,"_27488":65192,"_19100":110508,"_5":13150,"_26023":110388,"_2643":110509},[],"`L`: localidad.",{"_3144":65236,"_27488":65192,"_19100":110511,"_5":13150,"_26023":110388,"_2643":110512},[],"`O`: organización.",{"_3144":65237,"_27488":65192,"_19100":110514,"_5":13150,"_26023":110388,"_2643":110515},[],"`OU`: unidad organizativa.",{"_3144":65238,"_27488":65192,"_19100":110517,"_5":13150,"_26023":110388,"_2643":110518},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3144":65239,"_27488":65192,"_19100":110520,"_5":13150,"_26023":110392,"_2643":110521},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3144":65240,"_27488":65192,"_19100":110523,"_5":13150,"_26023":110392,"_2643":110524},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3144":65241,"_27488":65192,"_19100":110526,"_5":13150,"_26023":110396,"_2643":110527},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3144":65242,"_27488":65192,"_19100":110529,"_5":13150,"_26023":110396,"_2643":110530},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3144":65243,"_27488":65192,"_19100":110532,"_5":13150,"_26023":110400,"_2643":110533},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3144":65244,"_27488":65192,"_19100":110535,"_5":13150,"_26023":110400,"_2643":110536},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3144":65245,"_27488":65192,"_19100":110538,"_5":13150,"_26023":110404,"_2643":110539},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3144":65246,"_27488":65192,"_19100":110541,"_5":13150,"_26023":110408,"_2643":110542},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3144":65247,"_27488":65192,"_19100":110544,"_5":13150,"_26023":110412,"_2643":110545},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3144":65248,"_27488":65192,"_19100":110547,"_5":13150,"_26023":110416,"_2643":110548},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3144":65249,"_27488":65192,"_19100":110550,"_5":13150,"_26023":110420,"_2643":110551},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3144":65250,"_27488":65192,"_19100":110553,"_5":13150,"_26023":110420,"_2643":110554},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3144":65251,"_27488":65192,"_19100":110556,"_5":13150,"_26023":110424,"_2643":110557},[],"Abre una CA desde el inventario para consultar:",{"_3144":65252,"_27488":65192,"_19100":110559,"_5":13150,"_26023":110424,"_2643":110560},[],"Estado y periodo de validez.",{"_3144":65253,"_27488":65192,"_19100":110562,"_5":13150,"_26023":110424,"_2643":110563},[],"Certificado y cadena en formato PEM.",{"_3144":65254,"_27488":65192,"_19100":110565,"_5":13150,"_26023":110424,"_2643":110566},[],"Número de certificados activos, expirados y revocados.",{"_3144":65255,"_27488":65192,"_19100":110568,"_5":13150,"_26023":110424,"_2643":110569},[],"Certificados emitidos en **Issued Certificates**.",{"_3144":65256,"_27488":65192,"_19100":110571,"_5":13150,"_26023":110424,"_2643":110572},[],"CRL vinculada a la autoridad.",{"_3144":65257,"_27488":65192,"_19100":110574,"_5":13150,"_26023":110424,"_2643":110575},[],"Metadatos y motor criptográfico asociado.",{"_3144":65258,"_27488":65192,"_19100":110577,"_5":13150,"_26023":110424,"_2643":110578},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3144":65259,"_27488":65192,"_19100":110580,"_5":13150,"_26023":110428,"_2643":110581},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3144":65260,"_27488":65192,"_19100":110583,"_5":13150,"_26023":110428,"_2643":110584},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3144":65261,"_27488":65192,"_19100":110586,"_5":13150,"_26023":110428,"_2643":110587},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3144":65262,"_27488":65192,"_19100":110589,"_5":13150,"_26023":110428,"_2643":110590},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3144":65263,"_27488":65192,"_19100":110592,"_5":13150,"_26023":110432,"_2643":110593},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3144":65264,"_27488":65192,"_19100":110595,"_5":13150,"_26023":110436,"_2643":110596},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3144":65265,"_27488":65192,"_19100":110598,"_5":13150,"_26023":110440,"_2643":110599},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3144":65266,"_27488":65192,"_19100":110601,"_5":13150,"_26023":110444,"_2643":110602},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3144":65267,"_27488":65192,"_19100":110604,"_5":13150,"_26023":110448,"_2643":110605},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3144":65268,"_27488":65192,"_19100":110607,"_5":13150,"_26023":110448,"_2643":110608},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3144":65269,"_27488":65269,"_5":13476,"_2643":110610,"_27831":110611,"_19100":110612,"_26023":65269},"Perfiles de certificado",[44764,106610,49837,110198],[],{"_3144":65270,"_27488":65269,"_19100":110614,"_5":13150,"_26023":65269,"_2643":110615},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3144":65271,"_27488":65269,"_5":27828,"_19100":110617,"_26023":110618,"_2643":110619},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3144":65272,"_27488":65269,"_5":27828,"_19100":110621,"_26023":110622,"_2643":110623},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#validez","Validez",{"_3144":65273,"_27488":65269,"_5":27828,"_19100":110625,"_26023":110626,"_2643":110627},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3144":65274,"_27488":65269,"_5":27828,"_19100":110629,"_26023":110630,"_2643":110631},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3144":65275,"_27488":65269,"_5":27828,"_19100":110633,"_26023":110634,"_2643":110635},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3144":65276,"_27488":65269,"_5":27828,"_19100":110637,"_26023":110638,"_2643":110639},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3144":65277,"_27488":65269,"_5":27828,"_19100":110641,"_26023":110642,"_2643":110643},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3144":65278,"_27488":65269,"_5":27828,"_19100":110645,"_26023":110646,"_2643":110647},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3144":65279,"_27488":65269,"_5":27828,"_19100":110649,"_26023":110650,"_2643":110651},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3144":65280,"_27488":65269,"_5":27828,"_19100":110653,"_26023":110654,"_2643":110655},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3144":65281,"_27488":65269,"_5":27828,"_19100":110657,"_26023":110658,"_2643":110659},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3144":65282,"_27488":65269,"_5":27828,"_19100":110661,"_26023":110662,"_2643":110663},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3144":65283,"_27488":65269,"_5":27828,"_19100":110665,"_26023":110666,"_2643":110667},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3144":65284,"_27488":65269,"_5":27828,"_19100":110669,"_26023":110670,"_2643":110671},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3144":65285,"_27488":65269,"_5":27828,"_19100":110673,"_26023":110674,"_2643":110675},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3144":65286,"_27488":65269,"_5":27828,"_19100":110677,"_26023":110678,"_2643":110679},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3144":65287,"_27488":65269,"_19100":110681,"_5":13150,"_26023":65269,"_2643":110682},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3144":65288,"_27488":65269,"_19100":110684,"_5":13150,"_26023":65269,"_2643":110685},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3144":65289,"_27488":65269,"_19100":110687,"_5":13150,"_26023":110622,"_2643":110688},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3144":65290,"_27488":65269,"_19100":110690,"_5":13150,"_26023":110622,"_2643":110691},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3144":65291,"_27488":65269,"_19100":110693,"_5":13150,"_26023":110626,"_2643":110694},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3144":65292,"_27488":65269,"_19100":110696,"_5":13150,"_26023":110630,"_2643":110697},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3144":65293,"_27488":65269,"_19100":110699,"_5":13150,"_26023":110630,"_2643":110700},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3144":65294,"_27488":65269,"_19100":110702,"_5":13150,"_26023":110630,"_2643":110703},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3144":65295,"_27488":65269,"_19100":110705,"_5":13150,"_26023":110634,"_2643":110706},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3144":65296,"_27488":65269,"_19100":110708,"_5":13150,"_26023":110638,"_2643":110709},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3144":65297,"_27488":65269,"_19100":110711,"_5":13150,"_26023":110638,"_2643":110712},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3144":65298,"_27488":65269,"_19100":110714,"_5":13150,"_26023":110642,"_2643":110715},[],"La aplicación criptográfica puede:",{"_3144":65299,"_27488":65269,"_19100":110717,"_5":13150,"_26023":110642,"_2643":110718},[],"permitir o bloquear claves RSA;",{"_3144":65300,"_27488":65269,"_19100":110720,"_5":13150,"_26023":110642,"_2643":110721},[],"limitar los tamaños RSA admitidos;",{"_3144":65301,"_27488":65269,"_19100":110723,"_5":13150,"_26023":110642,"_2643":110724},[],"permitir o bloquear claves ECDSA;",{"_3144":65302,"_27488":65269,"_19100":110726,"_5":13150,"_26023":110642,"_2643":110727},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3144":65303,"_27488":65269,"_19100":110729,"_5":13150,"_26023":110642,"_2643":110730},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3144":65304,"_27488":65269,"_19100":110732,"_5":13150,"_26023":110646,"_2643":110733},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3144":65305,"_27488":65269,"_19100":110735,"_5":13150,"_26023":110646,"_2643":106401},[],{"_3144":65306,"_27488":65269,"_19100":110737,"_5":13150,"_26023":110646,"_2643":110738},[],"Primera opción",{"_3144":65307,"_27488":65269,"_19100":110740,"_5":13150,"_26023":110646,"_2643":110741},[],"Segunda opción",{"_3144":65308,"_27488":65269,"_19100":110743,"_5":13150,"_26023":110646,"_2643":110744},[],"Si no hay ninguna",{"_3144":65309,"_27488":65269,"_19100":110746,"_5":13150,"_26023":110646,"_2643":110747},[],"Firma directa con una CA",{"_3144":65310,"_27488":65269,"_19100":110749,"_5":13150,"_26023":110646,"_2643":110750},[],"`issuance_profile` incluido en la solicitud",{"_3144":65311,"_27488":65269,"_19100":110752,"_5":13150,"_26023":110646,"_2643":110753},[],"`issuance_profile_id` de la solicitud",{"_3144":65312,"_27488":65269,"_19100":110755,"_5":13150,"_26023":110646,"_2643":110756},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3144":65313,"_27488":65269,"_19100":110758,"_5":13150,"_26023":110646,"_2643":110759},[],"Emisión mediante DMS",{"_3144":65314,"_27488":65269,"_19100":110761,"_5":13150,"_26023":110646,"_2643":50402},[],{"_3144":65315,"_27488":65269,"_19100":110763,"_5":13150,"_26023":110646,"_2643":110764},[],"`settings.issuance_profile` incluido en el DMS",{"_3144":65316,"_27488":65269,"_19100":110766,"_5":13150,"_26023":110646,"_2643":110767},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3144":65317,"_27488":65269,"_19100":110769,"_5":13150,"_26023":110646,"_2643":110770},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3144":65318,"_27488":65269,"_19100":110772,"_5":13150,"_26023":110646,"_2643":110773},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3144":65319,"_27488":65269,"_19100":110775,"_5":13150,"_26023":110654,"_2643":110776},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3144":65320,"_27488":65269,"_19100":110778,"_5":13150,"_26023":110658,"_2643":110779},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3144":65321,"_27488":65269,"_19100":110781,"_5":13150,"_26023":110662,"_2643":110782},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3144":65322,"_27488":65269,"_19100":110784,"_5":13150,"_26023":110666,"_2643":110785},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3144":65323,"_27488":65269,"_19100":110787,"_5":13150,"_26023":110670,"_2643":110788},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3144":65324,"_27488":65269,"_19100":110790,"_5":13150,"_26023":110670,"_2643":110791},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3144":65325,"_27488":65269,"_19100":110793,"_5":13150,"_26023":110674,"_2643":110794},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3144":65326,"_27488":65269,"_19100":110796,"_5":13150,"_26023":110674,"_2643":110797},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3144":65327,"_27488":65269,"_19100":110799,"_5":13150,"_26023":110674,"_2643":110800},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3144":65328,"_27488":65269,"_19100":110802,"_5":13150,"_26023":110674,"_2643":110803},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3144":65329,"_27488":65269,"_19100":110805,"_5":13150,"_26023":110678,"_2643":110806},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3144":65330,"_27488":65269,"_19100":110808,"_5":13150,"_26023":110678,"_2643":110809},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3144":65331,"_27488":65331,"_5":13476,"_2643":110811,"_27831":110812,"_19100":110814,"_26023":65331},"Validación de certificados",[44764,106610,49837,110813],"Validación",[],{"_3144":65332,"_27488":65331,"_19100":110816,"_5":13150,"_26023":65331,"_2643":110817},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3144":65333,"_27488":65331,"_5":27828,"_19100":110819,"_26023":110820,"_2643":110821},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3144":65334,"_27488":65331,"_5":27828,"_19100":110823,"_26023":110824,"_2643":110825},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3144":65335,"_27488":65331,"_5":27828,"_19100":110827,"_26023":110828,"_2643":110829},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3144":65336,"_27488":65331,"_19100":110831,"_5":13150,"_26023":65331,"_2643":110832},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3144":65337,"_27488":65331,"_19100":110834,"_5":13150,"_26023":110820,"_2643":110835},[],"Verifica estos criterios juntos:",{"_3144":65338,"_27488":65331,"_19100":110837,"_5":13150,"_26023":110820,"_2643":109825},[],{"_3144":65339,"_27488":65331,"_19100":110839,"_5":13150,"_26023":110820,"_2643":110840},[],"Resultado necesario",{"_3144":65340,"_27488":65331,"_19100":110842,"_5":13150,"_26023":110820,"_2643":110843},[],"Cadena y firma",{"_3144":65341,"_27488":65331,"_19100":110845,"_5":13150,"_26023":110820,"_2643":110846},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3144":65342,"_27488":65331,"_19100":110848,"_5":13150,"_26023":110820,"_2643":110849},[],"Fechas",{"_3144":65343,"_27488":65331,"_19100":110851,"_5":13150,"_26023":110820,"_2643":110852},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3144":65344,"_27488":65331,"_19100":110854,"_5":13150,"_26023":110820,"_2643":106311},[],{"_3144":65345,"_27488":65331,"_19100":110856,"_5":13150,"_26023":110820,"_2643":110857},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3144":65346,"_27488":65331,"_19100":110859,"_5":13150,"_26023":110820,"_2643":110860},[],"Uso",{"_3144":65347,"_27488":65331,"_19100":110862,"_5":13150,"_26023":110820,"_2643":110863},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3144":65348,"_27488":65331,"_19100":110865,"_5":13150,"_26023":110820,"_2643":110866},[],"Revocación",{"_3144":65349,"_27488":65331,"_19100":110868,"_5":13150,"_26023":110820,"_2643":110869},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3144":65350,"_27488":65331,"_19100":110871,"_5":13150,"_26023":110820,"_2643":110872},[],"Autorización",{"_3144":65351,"_27488":65331,"_19100":110874,"_5":13150,"_26023":110820,"_2643":110875},[],"La aplicación permite la acción a esa identidad.",{"_3144":65352,"_27488":65331,"_19100":110877,"_5":13150,"_26023":110820,"_2643":110878},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3144":65353,"_27488":65331,"_19100":110880,"_5":13150,"_26023":110824,"_2643":110881},[],"Mecanismo",{"_3144":65354,"_27488":65331,"_19100":110883,"_5":13150,"_26023":110824,"_2643":110884},[],"Cuándo utilizarlo",{"_3144":65355,"_27488":65331,"_19100":110886,"_5":13150,"_26023":110824,"_2643":110887},[],"Qué debes mantener",{"_3144":65356,"_27488":65331,"_19100":110889,"_5":13150,"_26023":110824,"_2643":50530},[],{"_3144":65357,"_27488":65331,"_19100":110891,"_5":13150,"_26023":110824,"_2643":110892},[],"Consulta del estado de un certificado concreto.",{"_3144":65358,"_27488":65331,"_19100":110894,"_5":13150,"_26023":110824,"_2643":110895},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3144":65359,"_27488":65331,"_19100":110897,"_5":13150,"_26023":110824,"_2643":50539},[],{"_3144":65360,"_27488":65331,"_19100":110899,"_5":13150,"_26023":110824,"_2643":110900},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3144":65361,"_27488":65331,"_19100":110902,"_5":13150,"_26023":110824,"_2643":110903},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3144":65362,"_27488":65331,"_19100":110905,"_5":13150,"_26023":110824,"_2643":110906},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3144":65363,"_27488":65331,"_19100":110908,"_5":13150,"_26023":110824,"_2643":110909},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3144":65364,"_27488":65331,"_19100":110911,"_5":13150,"_26023":110828,"_2643":110912},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3144":65365,"_27488":65331,"_19100":110914,"_5":13150,"_26023":110828,"_2643":110915},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3144":65366,"_27488":65331,"_19100":110917,"_5":13150,"_26023":110828,"_2643":110918},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3144":65367,"_27488":65331,"_19100":110920,"_5":13150,"_26023":110828,"_2643":110921},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3144":65368,"_27488":65331,"_19100":110923,"_5":13150,"_26023":110828,"_2643":110924},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3144":65369,"_27488":65331,"_19100":110926,"_5":13150,"_26023":110828,"_2643":110927},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3144":65370,"_27488":65331,"_19100":110929,"_5":13150,"_26023":110828,"_2643":110930},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3144":65371,"_27488":65331,"_19100":110932,"_5":13150,"_26023":110828,"_2643":110933},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3144":65372,"_27488":65331,"_19100":110935,"_5":13150,"_26023":110828,"_2643":110936},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3144":65373,"_27488":65373,"_5":13476,"_2643":110938,"_27831":110939,"_19100":110940,"_26023":65373},"Certificados",[44764,106610,49837,110198],[],{"_3144":65374,"_27488":65373,"_19100":110942,"_5":13150,"_26023":65373,"_2643":110943},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3144":65375,"_27488":65373,"_5":27828,"_19100":110945,"_26023":110946,"_2643":110947},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3144":65376,"_27488":65373,"_5":27828,"_19100":110949,"_26023":110950,"_2643":110951},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3144":65377,"_27488":65373,"_5":27828,"_19100":110953,"_26023":110954,"_2643":110955},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3144":65378,"_27488":65373,"_5":27828,"_19100":110957,"_26023":110958,"_2643":110959},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3144":65379,"_27488":65373,"_5":27828,"_19100":110961,"_26023":110962,"_2643":110963},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3144":65380,"_27488":65373,"_5":27828,"_19100":110965,"_26023":110966,"_2643":110967},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3144":65381,"_27488":65373,"_5":27828,"_19100":110969,"_26023":110970,"_2643":110971},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3144":65382,"_27488":65373,"_5":27828,"_19100":110973,"_26023":110974,"_2643":110975},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3144":65383,"_27488":65373,"_5":27828,"_19100":110977,"_26023":110978,"_2643":110979},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#continúa","Continúa",{"_3144":65384,"_27488":65373,"_19100":110981,"_5":13150,"_26023":65373,"_2643":110982},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3144":65385,"_27488":65373,"_19100":110984,"_5":13150,"_26023":110946,"_2643":110985},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3144":65386,"_27488":65373,"_19100":110987,"_5":13150,"_26023":110946,"_2643":110988},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3144":65387,"_27488":65373,"_19100":110990,"_5":13150,"_26023":110950,"_2643":110991},[],"Descarga el PEM e inspecciónalo:",{"_3144":65388,"_27488":65373,"_19100":110993,"_5":13150,"_26023":110950,"_2643":110994},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3144":65389,"_27488":65373,"_19100":110996,"_5":13150,"_26023":110954,"_2643":110997},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3144":65390,"_27488":65373,"_19100":110999,"_5":13150,"_26023":110954,"_2643":111000},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3144":65391,"_27488":65373,"_19100":111002,"_5":13150,"_26023":110954,"_2643":111003},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3144":65392,"_27488":65373,"_19100":111005,"_5":13150,"_26023":110954,"_2643":111006},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3144":65393,"_27488":65373,"_19100":111008,"_5":13150,"_26023":110954,"_2643":111009},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3144":65394,"_27488":65373,"_19100":111011,"_5":13150,"_26023":110954,"_2643":111012},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3144":65395,"_27488":65373,"_19100":111014,"_5":13150,"_26023":110954,"_2643":111015},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3144":65396,"_27488":65373,"_19100":111017,"_5":13150,"_26023":110958,"_2643":111018},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3144":65397,"_27488":65373,"_19100":111020,"_5":13150,"_26023":110962,"_2643":111021},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3144":65398,"_27488":65373,"_19100":111023,"_5":13150,"_26023":110966,"_2643":111024},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3144":65399,"_27488":65373,"_19100":111026,"_5":13150,"_26023":110970,"_2643":111027},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3144":65400,"_27488":65373,"_19100":111029,"_5":13150,"_26023":110970,"_2643":111030},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3144":65401,"_27488":65373,"_19100":111032,"_5":13150,"_26023":110970,"_2643":111033},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3144":65402,"_27488":65373,"_19100":111035,"_5":13150,"_26023":110974,"_2643":111036},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3144":65403,"_27488":65373,"_19100":111038,"_5":13150,"_26023":110974,"_2643":111039},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3144":65404,"_27488":65373,"_19100":111041,"_5":13150,"_26023":110974,"_2643":111042},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3144":65405,"_27488":65373,"_19100":111044,"_5":13150,"_26023":110978,"_2643":111045},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3144":65406,"_27488":65373,"_19100":111047,"_5":13150,"_26023":110978,"_2643":111048},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3144":65407,"_27488":65407,"_5":13476,"_2643":111050,"_27831":111051,"_19100":111053,"_26023":65407},"Ciclo de vida de un certificado",[44764,106610,49837,111052],"Conceptos",[],{"_3144":65408,"_27488":65407,"_19100":111055,"_5":13150,"_26023":65407,"_2643":111056},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3144":65409,"_27488":65407,"_5":27828,"_19100":111058,"_26023":111059,"_2643":111060},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3144":65410,"_27488":65407,"_5":27828,"_19100":111062,"_26023":111063,"_2643":111064},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3144":65411,"_27488":65407,"_5":27828,"_19100":111066,"_26023":111067,"_2643":111068},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3144":65412,"_27488":65407,"_5":27828,"_19100":111070,"_26023":111071,"_2643":111072},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3144":65413,"_27488":65407,"_5":27828,"_19100":111074,"_26023":111075,"_2643":111076},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3144":65414,"_27488":65407,"_5":27828,"_19100":111078,"_26023":111079,"_2643":111080},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3144":65415,"_27488":65407,"_5":27828,"_19100":111082,"_26023":111083,"_2643":111084},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3144":65416,"_27488":65407,"_5":27828,"_19100":111086,"_26023":111087,"_2643":111088},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3144":65417,"_27488":65407,"_5":27828,"_19100":111090,"_26023":111091,"_2643":111092},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3144":65418,"_27488":65407,"_5":27828,"_19100":111094,"_26023":111095,"_2643":111096},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3144":65419,"_27488":65407,"_19100":111098,"_5":13150,"_26023":65407,"_2643":111099},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3144":65420,"_27488":65407,"_19100":111101,"_5":13150,"_26023":111063,"_2643":111102},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3144":65421,"_27488":65407,"_19100":111104,"_5":13150,"_26023":111067,"_2643":111105},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3144":65422,"_27488":65407,"_19100":111107,"_5":13150,"_26023":111071,"_2643":111108},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3144":65423,"_27488":65407,"_19100":111110,"_5":13150,"_26023":111075,"_2643":111111},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3144":65424,"_27488":65407,"_19100":111113,"_5":13150,"_26023":111079,"_2643":111114},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3144":65425,"_27488":65407,"_19100":111116,"_5":13150,"_26023":111083,"_2643":111117},[],"Lamassu persiste cuatro estados X.509:",{"_3144":65426,"_27488":65407,"_19100":111119,"_5":13150,"_26023":111083,"_2643":111120},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3144":65427,"_27488":65407,"_19100":111122,"_5":13150,"_26023":111083,"_2643":111123},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3144":65428,"_27488":65407,"_19100":111125,"_5":13150,"_26023":111083,"_2643":111126},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3144":65429,"_27488":65407,"_19100":111128,"_5":13150,"_26023":111083,"_2643":111129},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3144":65430,"_27488":65407,"_19100":111131,"_5":13150,"_26023":111083,"_2643":111132},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3144":65431,"_27488":65407,"_19100":111134,"_5":13150,"_26023":111087,"_2643":111135},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3144":65432,"_27488":65407,"_19100":111137,"_5":13150,"_26023":111087,"_2643":111138},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3144":65433,"_27488":65407,"_19100":111140,"_5":13150,"_26023":111087,"_2643":111141},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3144":65434,"_27488":65407,"_19100":111143,"_5":13150,"_26023":111091,"_2643":111144},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3144":65435,"_27488":65407,"_19100":111146,"_5":13150,"_26023":111091,"_2643":111147},[],"Antes de confirmar:",{"_3144":65436,"_27488":65407,"_19100":111149,"_5":13150,"_26023":111091,"_2643":111150},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3144":65437,"_27488":65407,"_19100":111152,"_5":13150,"_26023":111091,"_2643":111153},[],"Distribuye la nueva cadena de confianza.",{"_3144":65438,"_27488":65407,"_19100":111155,"_5":13150,"_26023":111091,"_2643":111156},[],"Reemite las identidades necesarias.",{"_3144":65439,"_27488":65407,"_19100":111158,"_5":13150,"_26023":111091,"_2643":111159},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3144":65440,"_27488":65407,"_19100":111161,"_5":13150,"_26023":111091,"_2643":111162},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3144":65441,"_27488":65407,"_19100":111164,"_5":13150,"_26023":111091,"_2643":111165},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3144":65442,"_27488":65407,"_19100":111167,"_5":13150,"_26023":111095,"_2643":111168},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3144":65443,"_27488":65407,"_19100":111170,"_5":13150,"_26023":111095,"_2643":111171},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3144":65444,"_27488":65407,"_19100":111173,"_5":13150,"_26023":111095,"_2643":111174},[],"Cambios de estado y razones de revocación.",{"_3144":65445,"_27488":65407,"_19100":111176,"_5":13150,"_26023":111095,"_2643":111177},[],"Publicación y vigencia de OCSP y CRLs.",{"_3144":65446,"_27488":65407,"_19100":111179,"_5":13150,"_26023":111095,"_2643":111180},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3144":65447,"_27488":65407,"_19100":111182,"_5":13150,"_26023":111095,"_2643":111183},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3144":65448,"_27488":65448,"_5":13476,"_2643":111185,"_27831":111186,"_19100":111187,"_26023":65448},"Modelo de confianza",[44764,106610,49837,111052],[],{"_3144":65449,"_27488":65448,"_19100":111189,"_5":13150,"_26023":65448,"_2643":111190},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3144":65450,"_27488":65448,"_5":27828,"_19100":111192,"_26023":111193,"_2643":111194},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3144":65451,"_27488":65448,"_5":27828,"_19100":111196,"_26023":111197,"_2643":111198},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3144":65452,"_27488":65448,"_5":27828,"_19100":111200,"_26023":111201,"_2643":111202},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3144":65453,"_27488":65448,"_5":27828,"_19100":111204,"_26023":111205,"_2643":111206},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3144":65454,"_27488":65448,"_5":27828,"_19100":111208,"_26023":111209,"_2643":111210},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3144":65455,"_27488":65448,"_5":27828,"_19100":111212,"_26023":111213,"_2643":111214},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3144":65456,"_27488":65448,"_5":27828,"_19100":111216,"_26023":111217,"_2643":111218},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3144":65457,"_27488":65448,"_5":27828,"_19100":111220,"_26023":111221,"_2643":111222},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3144":65458,"_27488":65448,"_5":27828,"_19100":111224,"_26023":111225,"_2643":111226},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3144":65459,"_27488":65448,"_5":27828,"_19100":111228,"_26023":111229,"_2643":111230},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3144":65460,"_27488":65448,"_19100":111232,"_5":13150,"_26023":65448,"_2643":111233},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3144":65461,"_27488":65448,"_19100":111235,"_5":13150,"_26023":111197,"_2643":111236},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3144":65462,"_27488":65448,"_19100":111238,"_5":13150,"_26023":111201,"_2643":111239},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3144":65463,"_27488":65448,"_19100":111241,"_5":13150,"_26023":111205,"_2643":111242},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3144":65464,"_27488":65448,"_19100":111244,"_5":13150,"_26023":111209,"_2643":111245},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3144":65465,"_27488":65448,"_19100":111247,"_5":13150,"_26023":111213,"_2643":111248},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3144":65466,"_27488":65448,"_19100":111250,"_5":13150,"_26023":111213,"_2643":111251},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3144":65467,"_27488":65448,"_19100":111253,"_5":13150,"_26023":111213,"_2643":111254},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3144":65468,"_27488":65448,"_19100":111256,"_5":13150,"_26023":111213,"_2643":111257},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3144":65469,"_27488":65448,"_19100":111259,"_5":13150,"_26023":111213,"_2643":111260},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3144":65470,"_27488":65448,"_19100":111262,"_5":13150,"_26023":111213,"_2643":111263},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3144":65471,"_27488":65448,"_19100":111265,"_5":13150,"_26023":111217,"_2643":111266},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3144":65472,"_27488":65448,"_19100":111268,"_5":13150,"_26023":111217,"_2643":111269},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3144":65473,"_27488":65448,"_19100":111271,"_5":13150,"_26023":111217,"_2643":111272},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_3144":65474,"_27488":65448,"_19100":111274,"_5":13150,"_26023":111217,"_2643":111275},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3144":65475,"_27488":65448,"_19100":111277,"_5":13150,"_26023":111217,"_2643":111278},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3144":65476,"_27488":65448,"_19100":111280,"_5":13150,"_26023":111221,"_2643":111281},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3144":65477,"_27488":65448,"_19100":111283,"_5":13150,"_26023":111221,"_2643":111284},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3144":65478,"_27488":65448,"_19100":111286,"_5":13150,"_26023":111221,"_2643":111287},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3144":65479,"_27488":65448,"_19100":111289,"_5":13150,"_26023":111221,"_2643":111290},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3144":65480,"_27488":65448,"_19100":111292,"_5":13150,"_26023":111221,"_2643":111293},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3144":65481,"_27488":65448,"_19100":111295,"_5":13150,"_26023":111221,"_2643":111296},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3144":65482,"_27488":65448,"_19100":111298,"_5":13150,"_26023":111221,"_2643":111299},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3144":65483,"_27488":65448,"_19100":111301,"_5":13150,"_26023":111225,"_2643":111302},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3144":65484,"_27488":65448,"_19100":111304,"_5":13150,"_26023":111229,"_2643":111305},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3144":65485,"_27488":65448,"_19100":111307,"_5":13150,"_26023":111229,"_2643":111308},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3144":65486,"_27488":65448,"_19100":111310,"_5":13150,"_26023":111229,"_2643":111311},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3144":65487,"_27488":65448,"_19100":111313,"_5":13150,"_26023":111229,"_2643":111314},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3144":65488,"_27488":65448,"_19100":111316,"_5":13150,"_26023":111229,"_2643":111317},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3144":65489,"_27488":65448,"_19100":111319,"_5":13150,"_26023":111229,"_2643":111320},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3144":65490,"_27488":65448,"_19100":111322,"_5":13150,"_26023":111229,"_2643":111323},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3144":65491,"_27488":65491,"_5":13476,"_2643":111325,"_27831":111326,"_19100":111327,"_26023":65491},"Listas de revocación (CRL)",[44764,106610,49837,110813],[],{"_3144":65492,"_27488":65491,"_19100":111329,"_5":13150,"_26023":65491,"_2643":111330},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3144":65493,"_27488":65491,"_5":27828,"_19100":111332,"_26023":111333,"_2643":111334},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3144":65494,"_27488":65491,"_5":27828,"_19100":111336,"_26023":111337,"_2643":111338},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3144":65495,"_27488":65491,"_5":27828,"_19100":111340,"_26023":111341,"_2643":111342},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3144":65496,"_27488":65491,"_5":27828,"_19100":111344,"_26023":111345,"_2643":111346},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3144":65497,"_27488":65491,"_5":27828,"_19100":111348,"_26023":111349,"_2643":111350},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3144":65498,"_27488":65491,"_5":27828,"_19100":111352,"_26023":111353,"_2643":111354},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3144":65499,"_27488":65491,"_5":27828,"_19100":111356,"_26023":111357,"_2643":111358},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#referencias","Referencias",{"_3144":65500,"_27488":65491,"_19100":111360,"_5":13150,"_26023":65491,"_2643":111361},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3144":65501,"_27488":65491,"_19100":111363,"_5":13150,"_26023":111333,"_2643":111364},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3144":65502,"_27488":65491,"_19100":111366,"_5":13150,"_26023":111333,"_2643":111367},[],"Campo de `crl_options`",{"_3144":65503,"_27488":65491,"_19100":111369,"_5":13150,"_26023":111333,"_2643":108106},[],{"_3144":65504,"_27488":65491,"_19100":111371,"_5":13150,"_26023":111333,"_2643":111372},[],"Valor inicial del backend",{"_3144":65505,"_27488":65491,"_19100":111374,"_5":13150,"_26023":111333,"_2643":51017},[],{"_3144":65506,"_27488":65491,"_19100":111376,"_5":13150,"_26023":111333,"_2643":111377},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3144":65507,"_27488":65491,"_19100":111379,"_5":13150,"_26023":111333,"_2643":111380},[],"7 días.",{"_3144":65508,"_27488":65491,"_19100":111382,"_5":13150,"_26023":111333,"_2643":51026},[],{"_3144":65509,"_27488":65491,"_19100":111384,"_5":13150,"_26023":111333,"_2643":111385},[],"Plazo desde la publicación que activa la renovación programada.",{"_3144":65510,"_27488":65491,"_19100":111387,"_5":13150,"_26023":111333,"_2643":111388},[],"6 días y 23 horas.",{"_3144":65511,"_27488":65491,"_19100":111390,"_5":13150,"_26023":111333,"_2643":51035},[],{"_3144":65512,"_27488":65491,"_19100":111392,"_5":13150,"_26023":111333,"_2643":111393},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3144":65513,"_27488":65491,"_19100":111395,"_5":13150,"_26023":111333,"_2643":51041},[],{"_3144":65514,"_27488":65491,"_19100":111397,"_5":13150,"_26023":111333,"_2643":51044},[],{"_3144":65515,"_27488":65491,"_19100":111399,"_5":13150,"_26023":111333,"_2643":111400},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3144":65516,"_27488":65491,"_19100":111402,"_5":13150,"_26023":111333,"_2643":111403},[],"SKI de la CA.",{"_3144":65517,"_27488":65491,"_19100":111405,"_5":13150,"_26023":111333,"_2643":111406},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3144":65518,"_27488":65491,"_19100":111408,"_5":13150,"_26023":111333,"_2643":111409},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3144":65519,"_27488":65491,"_19100":111411,"_5":13150,"_26023":111337,"_2643":111412},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3144":65520,"_27488":65491,"_19100":111414,"_5":13150,"_26023":111337,"_2643":111415},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3144":65521,"_27488":65491,"_19100":111417,"_5":13150,"_26023":111337,"_2643":111418},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3144":65522,"_27488":65491,"_19100":111420,"_5":13150,"_26023":111341,"_2643":111421},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3144":65523,"_27488":65491,"_19100":111423,"_5":13150,"_26023":111341,"_2643":111424},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3144":65524,"_27488":65491,"_19100":111426,"_5":13150,"_26023":111345,"_2643":111427},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3144":65525,"_27488":65491,"_19100":111429,"_5":13150,"_26023":111345,"_2643":111430},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3144":65526,"_27488":65491,"_19100":111432,"_5":13150,"_26023":111345,"_2643":111433},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3144":65527,"_27488":65491,"_19100":111435,"_5":13150,"_26023":111345,"_2643":111436},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3144":65528,"_27488":65491,"_19100":111438,"_5":13150,"_26023":111345,"_2643":111439},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3144":65529,"_27488":65491,"_19100":111441,"_5":13150,"_26023":111349,"_2643":111442},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3144":65530,"_27488":65491,"_19100":111444,"_5":13150,"_26023":111349,"_2643":108295},[],{"_3144":65531,"_27488":65491,"_19100":111446,"_5":13150,"_26023":111349,"_2643":111447},[],"Path relativo",{"_3144":65532,"_27488":65491,"_19100":111449,"_5":13150,"_26023":111349,"_2643":106401},[],{"_3144":65533,"_27488":65491,"_19100":111451,"_5":13150,"_26023":111349,"_2643":51099},[],{"_3144":65534,"_27488":65491,"_19100":111453,"_5":13150,"_26023":111349,"_2643":51102},[],{"_3144":65535,"_27488":65491,"_19100":111455,"_5":13150,"_26023":111349,"_2643":111456},[],"Consultar `crl_options` y `latest_crl`.",{"_3144":65536,"_27488":65491,"_19100":111458,"_5":13150,"_26023":111349,"_2643":51108},[],{"_3144":65537,"_27488":65491,"_19100":111460,"_5":13150,"_26023":111349,"_2643":51102},[],{"_3144":65538,"_27488":65491,"_19100":111462,"_5":13150,"_26023":111349,"_2643":111463},[],"Sustituir la configuración de CRL.",{"_3144":65539,"_27488":65491,"_19100":111465,"_5":13150,"_26023":111349,"_2643":111466},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3144":65540,"_27488":65491,"_19100":111468,"_5":13150,"_26023":111349,"_2643":111469},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3144":65541,"_27488":65491,"_19100":111471,"_5":13150,"_26023":111353,"_2643":111472},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3144":65542,"_27488":65491,"_19100":111474,"_5":13150,"_26023":111357,"_2643":111475},[],"RFC 5280: perfil X.509 y CRL.",{"_3144":65543,"_27488":65491,"_19100":111477,"_5":13150,"_26023":111357,"_2643":51128},[],{"_3144":65544,"_27488":65491,"_19100":111479,"_5":13150,"_26023":111357,"_2643":51131},[],{"_3144":65545,"_27488":65491,"_19100":111481,"_5":13150,"_26023":111357,"_2643":111482},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3144":65546,"_27488":65491,"_19100":111484,"_5":13150,"_26023":111357,"_2643":111485},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3144":65547,"_27488":65547,"_5":13476,"_2643":111487,"_27831":111488,"_19100":111489,"_26023":65547},"Claves y motores criptográficos",[44764,106610,49837,110198],[],{"_3144":65548,"_27488":65547,"_19100":111491,"_5":13150,"_26023":65547,"_2643":111492},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3144":65549,"_27488":65547,"_5":27828,"_19100":111494,"_26023":111495,"_2643":111496},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3144":65550,"_27488":65547,"_5":27828,"_19100":111498,"_26023":111499,"_2643":111500},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3144":65551,"_27488":65547,"_5":27828,"_19100":111502,"_26023":111503,"_2643":51156},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#file-system",{"_3144":65552,"_27488":65547,"_5":27828,"_19100":111505,"_26023":111506,"_2643":51160},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#hashicorp-vault",{"_3144":65553,"_27488":65547,"_5":27828,"_19100":111508,"_26023":111509,"_2643":51164},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#aws-secrets-manager",{"_3144":65554,"_27488":65547,"_5":27828,"_19100":111511,"_26023":111512,"_2643":51168},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#aws-kms",{"_3144":65555,"_27488":65547,"_5":27828,"_19100":111514,"_26023":111515,"_2643":51172},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#pkcs11",{"_3144":65556,"_27488":65547,"_5":27828,"_19100":111517,"_26023":111518,"_2643":51176},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#azure-key-vault",{"_3144":65557,"_27488":65547,"_5":27828,"_19100":111520,"_26023":111521,"_2643":111522},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3144":65558,"_27488":65547,"_5":27828,"_19100":111524,"_26023":111525,"_2643":111526},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3144":65559,"_27488":65547,"_5":27828,"_19100":111528,"_26023":111529,"_2643":111530},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3144":65560,"_27488":65547,"_5":27828,"_19100":111532,"_26023":111533,"_2643":111534},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3144":65561,"_27488":65547,"_5":27828,"_19100":111536,"_26023":111537,"_2643":111538},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3144":65562,"_27488":65547,"_5":27828,"_19100":111540,"_26023":111541,"_2643":111542},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3144":65563,"_27488":65547,"_5":27828,"_19100":111544,"_26023":111545,"_2643":111546},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3144":65564,"_27488":65547,"_5":27828,"_19100":111548,"_26023":111549,"_2643":51208},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#sign",{"_3144":65565,"_27488":65547,"_5":27828,"_19100":111551,"_26023":111552,"_2643":51212},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#verify",{"_3144":65566,"_27488":65547,"_5":27828,"_19100":111554,"_26023":111555,"_2643":111556},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3144":65567,"_27488":65547,"_5":27828,"_19100":111558,"_26023":111559,"_2643":111560},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3144":65568,"_27488":65547,"_5":27828,"_19100":111562,"_26023":111563,"_2643":111564},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3144":65569,"_27488":65547,"_19100":111566,"_5":13150,"_26023":65547,"_2643":111567},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3144":65570,"_27488":65547,"_19100":111569,"_5":13150,"_26023":65547,"_2643":111570},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3144":65571,"_27488":65547,"_19100":111572,"_5":13150,"_26023":111495,"_2643":111573},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3144":65572,"_27488":65547,"_19100":111575,"_5":13150,"_26023":111495,"_2643":111576},[],"En la práctica, permite:",{"_3144":65573,"_27488":65547,"_19100":111578,"_5":13150,"_26023":111495,"_2643":111579},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3144":65574,"_27488":65547,"_19100":111581,"_5":13150,"_26023":111495,"_2643":111582},[],"Importar claves creadas externamente.",{"_3144":65575,"_27488":65547,"_19100":111584,"_5":13150,"_26023":111495,"_2643":111585},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3144":65576,"_27488":65547,"_19100":111587,"_5":13150,"_26023":111495,"_2643":111588},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3144":65577,"_27488":65547,"_19100":111590,"_5":13150,"_26023":111499,"_2643":111591},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3144":65578,"_27488":65547,"_19100":111593,"_5":13150,"_26023":111499,"_2643":111594},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3144":65579,"_27488":65547,"_19100":111596,"_5":13150,"_26023":111499,"_2643":111597},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3144":65580,"_27488":65547,"_19100":111599,"_5":13150,"_26023":111503,"_2643":111600},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3144":65581,"_27488":65547,"_19100":111602,"_5":13150,"_26023":111506,"_2643":111603},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3144":65582,"_27488":65547,"_19100":111605,"_5":13150,"_26023":111509,"_2643":111606},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3144":65583,"_27488":65547,"_19100":111608,"_5":13150,"_26023":111512,"_2643":111609},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3144":65584,"_27488":65547,"_19100":111611,"_5":13150,"_26023":111515,"_2643":111612},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3144":65585,"_27488":65547,"_19100":111614,"_5":13150,"_26023":111518,"_2643":111615},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3144":65586,"_27488":65547,"_19100":111617,"_5":13150,"_26023":111518,"_2643":111618},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3144":65587,"_27488":65547,"_19100":111620,"_5":13150,"_26023":111518,"_2643":111621},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3144":65588,"_27488":65547,"_19100":111623,"_5":13150,"_26023":111518,"_2643":111624},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3144":65589,"_27488":65547,"_19100":111626,"_5":13150,"_26023":111521,"_2643":111627},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3144":65590,"_27488":65547,"_19100":111629,"_5":13150,"_26023":111521,"_2643":111630},[],"La tabla incluye los siguientes campos:",{"_3144":65591,"_27488":65547,"_19100":111632,"_5":13150,"_26023":111521,"_2643":111633},[],"**Name**: nombre descriptivo de la clave.",{"_3144":65592,"_27488":65547,"_19100":111635,"_5":13150,"_26023":111521,"_2643":111636},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3144":65593,"_27488":65547,"_19100":111638,"_5":13150,"_26023":111521,"_2643":111639},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3144":65594,"_27488":65547,"_19100":111641,"_5":13150,"_26023":111521,"_2643":111642},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3144":65595,"_27488":65547,"_19100":111644,"_5":13150,"_26023":111521,"_2643":111645},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3144":65596,"_27488":65547,"_19100":111647,"_5":13150,"_26023":111521,"_2643":111648},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3144":65597,"_27488":65547,"_19100":111650,"_5":13150,"_26023":111521,"_2643":111651},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3144":65598,"_27488":65547,"_19100":111653,"_5":13150,"_26023":111521,"_2643":111654},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3144":65599,"_27488":65547,"_19100":111656,"_5":13150,"_26023":111521,"_2643":111657},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3144":65600,"_27488":65547,"_19100":111659,"_5":13150,"_26023":111521,"_2643":111660},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3144":65601,"_27488":65547,"_19100":111662,"_5":13150,"_26023":111521,"_2643":111663},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3144":65602,"_27488":65547,"_19100":111665,"_5":13150,"_26023":111521,"_2643":111666},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3144":65603,"_27488":65547,"_19100":111668,"_5":13150,"_26023":111521,"_2643":111669},[],"**Delete Key** para eliminar la clave del sistema.",{"_3144":65604,"_27488":65547,"_19100":111671,"_5":13150,"_26023":111525,"_2643":111672},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3144":65605,"_27488":65547,"_19100":111674,"_5":13150,"_26023":111529,"_2643":111675},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3144":65606,"_27488":65547,"_19100":111677,"_5":13150,"_26023":111529,"_2643":111678},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3144":65607,"_27488":65547,"_19100":111680,"_5":13150,"_26023":111529,"_2643":111681},[],"**Key Name**: nombre único y descriptivo.",{"_3144":65608,"_27488":65547,"_19100":111683,"_5":13150,"_26023":111529,"_2643":111684},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3144":65609,"_27488":65547,"_19100":111686,"_5":13150,"_26023":111529,"_2643":111687},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3144":65610,"_27488":65547,"_19100":111689,"_5":13150,"_26023":111529,"_2643":111690},[],"**Tags**: metadatos para clasificar la clave.",{"_3144":65611,"_27488":65547,"_19100":111692,"_5":13150,"_26023":111529,"_2643":111693},[],"**Metadata**: información adicional para usos avanzados.",{"_3144":65612,"_27488":65547,"_19100":111695,"_5":13150,"_26023":111533,"_2643":111696},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3144":65613,"_27488":65547,"_19100":111698,"_5":13150,"_26023":111533,"_2643":111699},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3144":65614,"_27488":65547,"_19100":111701,"_5":13150,"_26023":111533,"_2643":111702},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3144":65615,"_27488":65547,"_19100":111704,"_5":13150,"_26023":111533,"_2643":111705},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3144":65616,"_27488":65547,"_19100":111707,"_5":13150,"_26023":111533,"_2643":111708},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3144":65617,"_27488":65547,"_19100":111710,"_5":13150,"_26023":111533,"_2643":111711},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3144":65618,"_27488":65547,"_19100":111713,"_5":13150,"_26023":111533,"_2643":111714},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3144":65619,"_27488":65547,"_19100":111716,"_5":13150,"_26023":111533,"_2643":111717},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3144":65620,"_27488":65547,"_19100":111719,"_5":13150,"_26023":111533,"_2643":111720},[],"**Metadata**: información adicional opcional.",{"_3144":65621,"_27488":65547,"_19100":111722,"_5":13150,"_26023":111533,"_2643":111723},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3144":65622,"_27488":65547,"_19100":111725,"_5":13150,"_26023":111533,"_2643":111726},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3144":65623,"_27488":65547,"_19100":111728,"_5":13150,"_26023":111537,"_2643":111729},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3144":65624,"_27488":65547,"_19100":111731,"_5":13150,"_26023":111541,"_2643":111732},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3144":65625,"_27488":65547,"_19100":111734,"_5":13150,"_26023":111541,"_2643":111735},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3144":65626,"_27488":65547,"_19100":111737,"_5":13150,"_26023":111541,"_2643":111738},[],"**Key Name**: nombre descriptivo.",{"_3144":65627,"_27488":65547,"_19100":111740,"_5":13150,"_26023":111541,"_2643":111741},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3144":65628,"_27488":65547,"_19100":111743,"_5":13150,"_26023":111541,"_2643":111744},[],"**Tags**: etiquetas asociadas.",{"_3144":65629,"_27488":65547,"_19100":111746,"_5":13150,"_26023":111541,"_2643":111747},[],"**Aliases**: nombres alternativos.",{"_3144":65630,"_27488":65547,"_19100":111749,"_5":13150,"_26023":111541,"_2643":111750},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3144":65631,"_27488":65547,"_19100":111752,"_5":13150,"_26023":111541,"_2643":111753},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3144":65632,"_27488":65547,"_19100":111755,"_5":13150,"_26023":111541,"_2643":111756},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3144":65633,"_27488":65547,"_19100":111758,"_5":13150,"_26023":111541,"_2643":111759},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3144":65634,"_27488":65547,"_19100":111761,"_5":13150,"_26023":111545,"_2643":111762},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3144":65635,"_27488":65547,"_19100":111764,"_5":13150,"_26023":111545,"_2643":111765},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3144":65636,"_27488":65547,"_19100":111767,"_5":13150,"_26023":111545,"_2643":111768},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3144":65637,"_27488":65547,"_19100":111770,"_5":13150,"_26023":111549,"_2643":111771},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3144":65638,"_27488":65547,"_19100":111773,"_5":13150,"_26023":111549,"_2643":111774},[],"Campos principales:",{"_3144":65639,"_27488":65547,"_19100":111776,"_5":13150,"_26023":111549,"_2643":111777},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3144":65640,"_27488":65547,"_19100":111779,"_5":13150,"_26023":111549,"_2643":111780},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3144":65641,"_27488":65547,"_19100":111782,"_5":13150,"_26023":111549,"_2643":111783},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3144":65642,"_27488":65547,"_19100":111785,"_5":13150,"_26023":111549,"_2643":111786},[],"**Message**: contenido que se va a firmar.",{"_3144":65643,"_27488":65547,"_19100":111788,"_5":13150,"_26023":111549,"_2643":111789},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3144":65644,"_27488":65547,"_19100":111791,"_5":13150,"_26023":111552,"_2643":111792},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3144":65645,"_27488":65547,"_19100":111794,"_5":13150,"_26023":111552,"_2643":111774},[],{"_3144":65646,"_27488":65547,"_19100":111796,"_5":13150,"_26023":111552,"_2643":111797},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3144":65647,"_27488":65547,"_19100":111799,"_5":13150,"_26023":111552,"_2643":111800},[],"**Message Type**: `Raw` o `Digest`.",{"_3144":65648,"_27488":65547,"_19100":111802,"_5":13150,"_26023":111552,"_2643":111803},[],"**Payload Encoding**: codificación del mensaje.",{"_3144":65649,"_27488":65547,"_19100":111805,"_5":13150,"_26023":111552,"_2643":111806},[],"**Message**: mensaje original o hash.",{"_3144":65650,"_27488":65547,"_19100":111808,"_5":13150,"_26023":111552,"_2643":111809},[],"**Signature**: firma que se desea comprobar.",{"_3144":65651,"_27488":65547,"_19100":111811,"_5":13150,"_26023":111552,"_2643":111812},[],"**Result**: indicador del resultado de la validación.",{"_3144":65652,"_27488":65547,"_19100":111814,"_5":13150,"_26023":111555,"_2643":111815},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3144":65653,"_27488":65547,"_19100":111817,"_5":13150,"_26023":111555,"_2643":111818},[],"Este flujo es útil para:",{"_3144":65654,"_27488":65547,"_19100":111820,"_5":13150,"_26023":111555,"_2643":111821},[],"Solicitar certificados a una CA externa.",{"_3144":65655,"_27488":65547,"_19100":111823,"_5":13150,"_26023":111555,"_2643":111824},[],"Renovar una identidad manteniendo la misma clave.",{"_3144":65656,"_27488":65547,"_19100":111826,"_5":13150,"_26023":111555,"_2643":111827},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3144":65657,"_27488":65547,"_19100":111829,"_5":13150,"_26023":111555,"_2643":111830},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3144":65658,"_27488":65547,"_19100":111832,"_5":13150,"_26023":111555,"_2643":111833},[],"**Organization (O)**: organización o empresa.",{"_3144":65659,"_27488":65547,"_19100":111835,"_5":13150,"_26023":111555,"_2643":111836},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3144":65660,"_27488":65547,"_19100":111838,"_5":13150,"_26023":111555,"_2643":111839},[],"**Country (C)**: código de país de dos letras.",{"_3144":65661,"_27488":65547,"_19100":111841,"_5":13150,"_26023":111555,"_2643":111842},[],"**State / Province (ST)**: estado o provincia.",{"_3144":65662,"_27488":65547,"_19100":111844,"_5":13150,"_26023":111555,"_2643":111845},[],"**Locality (L)**: ciudad o localidad.",{"_3144":65663,"_27488":65547,"_19100":111847,"_5":13150,"_26023":111555,"_2643":111848},[],"**Email Address**: correo de contacto.",{"_3144":65664,"_27488":65547,"_19100":111850,"_5":13150,"_26023":111555,"_2643":111851},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3144":65665,"_27488":65547,"_19100":111853,"_5":13150,"_26023":111555,"_2643":111854},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3144":65666,"_27488":65547,"_19100":111856,"_5":13150,"_26023":111559,"_2643":111857},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3144":65667,"_27488":65547,"_19100":111859,"_5":13150,"_26023":111559,"_2643":51520},[],{"_3144":65668,"_27488":65547,"_19100":111861,"_5":13150,"_26023":111563,"_2643":111862},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3144":65669,"_27488":65669,"_5":13476,"_2643":111864,"_27831":111865,"_19100":111866,"_26023":65669},"Validación online con OCSP",[44764,106610,49837,110813],[],{"_3144":65670,"_27488":65669,"_19100":111868,"_5":13150,"_26023":65669,"_2643":111869},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3144":65671,"_27488":65669,"_5":27828,"_19100":111871,"_26023":111872,"_2643":111873},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3144":65672,"_27488":65669,"_5":27828,"_19100":111875,"_26023":111876,"_2643":111877},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3144":65673,"_27488":65669,"_5":27828,"_19100":111879,"_26023":111880,"_2643":111881},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3144":65674,"_27488":65669,"_5":27828,"_19100":111883,"_26023":111884,"_2643":111885},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3144":65675,"_27488":65669,"_5":27828,"_19100":111887,"_26023":111888,"_2643":111889},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3144":65676,"_27488":65669,"_5":27828,"_19100":111891,"_26023":111892,"_2643":111358},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#referencias",{"_3144":65677,"_27488":65669,"_19100":111894,"_5":13150,"_26023":65669,"_2643":111895},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3144":65678,"_27488":65669,"_19100":111897,"_5":13150,"_26023":111872,"_2643":111898},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3144":65679,"_27488":65669,"_19100":111900,"_5":13150,"_26023":111872,"_2643":111901},[],"Estado del registro",{"_3144":65680,"_27488":65669,"_19100":111903,"_5":13150,"_26023":111872,"_2643":111904},[],"Respuesta firmada",{"_3144":65681,"_27488":65669,"_19100":111906,"_5":13150,"_26023":111872,"_2643":49015},[],{"_3144":65682,"_27488":65669,"_19100":111908,"_5":13150,"_26023":111872,"_2643":51570},[],{"_3144":65683,"_27488":65669,"_19100":111910,"_5":13150,"_26023":111872,"_2643":49032},[],{"_3144":65684,"_27488":65669,"_19100":111912,"_5":13150,"_26023":111872,"_2643":111913},[],"`Revoked`, con razón y fecha de revocación.",{"_3144":65685,"_27488":65669,"_19100":111915,"_5":13150,"_26023":111872,"_2643":111916},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3144":65686,"_27488":65669,"_19100":111918,"_5":13150,"_26023":111872,"_2643":111919},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3144":65687,"_27488":65669,"_19100":111921,"_5":13150,"_26023":111872,"_2643":111922},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3144":65688,"_27488":65669,"_19100":111924,"_5":13150,"_26023":111872,"_2643":111925},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3144":65689,"_27488":65669,"_19100":111927,"_5":13150,"_26023":111872,"_2643":111928},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3144":65690,"_27488":65669,"_19100":111930,"_5":13150,"_26023":111876,"_2643":111931},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3144":65691,"_27488":65669,"_19100":111933,"_5":13150,"_26023":111876,"_2643":111934},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3144":65692,"_27488":65669,"_19100":111936,"_5":13150,"_26023":111880,"_2643":111937},[],"El servicio acepta:",{"_3144":65693,"_27488":65669,"_19100":111939,"_5":13150,"_26023":111880,"_2643":108295},[],{"_3144":65694,"_27488":65669,"_19100":111941,"_5":13150,"_26023":111880,"_2643":111942},[],"Ruta del servicio VA",{"_3144":65695,"_27488":65669,"_19100":111944,"_5":13150,"_26023":111880,"_2643":111945},[],"Formato",{"_3144":65696,"_27488":65669,"_19100":111947,"_5":13150,"_26023":111880,"_2643":51610},[],{"_3144":65697,"_27488":65669,"_19100":111949,"_5":13150,"_26023":111880,"_2643":51613},[],{"_3144":65698,"_27488":65669,"_19100":111951,"_5":13150,"_26023":111880,"_2643":111952},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3144":65699,"_27488":65669,"_19100":111954,"_5":13150,"_26023":111880,"_2643":51099},[],{"_3144":65700,"_27488":65669,"_19100":111956,"_5":13150,"_26023":111880,"_2643":51621},[],{"_3144":65701,"_27488":65669,"_19100":111958,"_5":13150,"_26023":111880,"_2643":111959},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3144":65702,"_27488":65669,"_19100":111961,"_5":13150,"_26023":111880,"_2643":111962},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3144":65703,"_27488":65669,"_19100":111964,"_5":13150,"_26023":111884,"_2643":111965},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3144":65704,"_27488":65669,"_19100":111967,"_5":13150,"_26023":111884,"_2643":111968},[],"Genera la solicitud:",{"_3144":65705,"_27488":65669,"_19100":111970,"_5":13150,"_26023":111884,"_2643":111971},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3144":65706,"_27488":65669,"_19100":111973,"_5":13150,"_26023":111884,"_2643":111974},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3144":65707,"_27488":65669,"_19100":111976,"_5":13150,"_26023":111884,"_2643":111977},[],"Verifica el DER recibido:",{"_3144":65708,"_27488":65669,"_19100":111979,"_5":13150,"_26023":111884,"_2643":111980},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3144":65709,"_27488":65669,"_19100":111982,"_5":13150,"_26023":111888,"_2643":111983},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3144":65710,"_27488":65669,"_19100":111985,"_5":13150,"_26023":111888,"_2643":111986},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3144":65711,"_27488":65669,"_19100":111988,"_5":13150,"_26023":111892,"_2643":51654},[],{"_3144":65712,"_27488":65669,"_19100":111990,"_5":13150,"_26023":111892,"_2643":51657},[],{"_3144":65713,"_27488":65669,"_19100":111992,"_5":13150,"_26023":111892,"_2643":111993},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3144":65714,"_27488":65669,"_19100":111995,"_5":13150,"_26023":111892,"_2643":111485},[],{"_3144":65715,"_27488":65715,"_5":13476,"_2643":49837,"_27831":111997,"_19100":111998,"_26023":65715},[44764,106610,49837],[],{"_3144":65716,"_27488":65715,"_19100":112000,"_5":13150,"_26023":65715,"_2643":112001},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3144":65717,"_27488":65715,"_5":27828,"_19100":112003,"_26023":112004,"_2643":109522},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#empieza-aquí",{"_3144":65718,"_27488":65715,"_5":27828,"_19100":112006,"_26023":112007,"_2643":112008},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3144":65719,"_27488":65715,"_5":27828,"_19100":112010,"_26023":112011,"_2643":110044},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#capacidades-principales",{"_3144":65720,"_27488":65715,"_5":27828,"_19100":112013,"_26023":112014,"_2643":110048},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3144":65721,"_27488":65715,"_5":27828,"_19100":112016,"_26023":112017,"_2643":110052},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3144":65722,"_27488":65715,"_5":27828,"_19100":112019,"_26023":112020,"_2643":110056},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#emite-y-controla-certificados",{"_3144":65723,"_27488":65715,"_5":27828,"_19100":112022,"_26023":112023,"_2643":110064},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#publica-el-estado-de-validación",{"_3144":65724,"_27488":65715,"_5":27828,"_19100":112025,"_26023":112026,"_2643":112027},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3144":65725,"_27488":65715,"_5":27828,"_19100":112029,"_26023":112030,"_2643":110979},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#continúa",{"_3144":65726,"_27488":65715,"_19100":112032,"_5":13150,"_26023":65715,"_2643":112033},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3144":65727,"_27488":65715,"_19100":112035,"_5":13150,"_26023":112004,"_2643":112036},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3144":65728,"_27488":65715,"_19100":112038,"_5":13150,"_26023":112004,"_2643":112039},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3144":65729,"_27488":65715,"_19100":112041,"_5":13150,"_26023":112007,"_2643":112042},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3144":65730,"_27488":65715,"_19100":112044,"_5":13150,"_26023":112007,"_2643":112045},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3144":65731,"_27488":65715,"_19100":112047,"_5":13150,"_26023":112007,"_2643":112048},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3144":65732,"_27488":65715,"_19100":112050,"_5":13150,"_26023":112007,"_2643":112051},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3144":65733,"_27488":65715,"_19100":112053,"_5":13150,"_26023":112007,"_2643":112054},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3144":65734,"_27488":65715,"_19100":112056,"_5":13150,"_26023":112014,"_2643":112057},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3144":65735,"_27488":65715,"_19100":112059,"_5":13150,"_26023":112017,"_2643":112060},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3144":65736,"_27488":65715,"_19100":112062,"_5":13150,"_26023":112020,"_2643":112063},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3144":65737,"_27488":65715,"_19100":112065,"_5":13150,"_26023":112023,"_2643":112066},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3144":65738,"_27488":65715,"_19100":112068,"_5":13150,"_26023":112026,"_2643":112069},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3144":65739,"_27488":65715,"_19100":112071,"_5":13150,"_26023":112026,"_2643":112072},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3144":65740,"_27488":65715,"_19100":112074,"_5":13150,"_26023":112026,"_2643":112075},[],"su clave pública corresponda a la clave privada del cliente;",{"_3144":65741,"_27488":65715,"_19100":112077,"_5":13150,"_26023":112026,"_2643":112078},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3144":65742,"_27488":65715,"_19100":112080,"_5":13150,"_26023":112026,"_2643":112081},[],"sus fechas y usos permitan la operación;",{"_3144":65743,"_27488":65715,"_19100":112083,"_5":13150,"_26023":112026,"_2643":112084},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3144":65744,"_27488":65715,"_19100":112086,"_5":13150,"_26023":112026,"_2643":112087},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3144":65745,"_27488":65715,"_19100":112089,"_5":13150,"_26023":112030,"_2643":112090},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3144":65746,"_27488":65715,"_19100":112092,"_5":13150,"_26023":112030,"_2643":112093},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3144":65747,"_27488":65715,"_19100":112095,"_5":13150,"_26023":112030,"_2643":112096},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3144":65748,"_27488":65748,"_5":13476,"_2643":112098,"_27831":112099,"_19100":112100,"_26023":65748},"Crea tu primera CA",[44764,106610,49837,109646],[],{"_3144":65749,"_27488":65748,"_19100":112102,"_5":13150,"_26023":65748,"_2643":112103},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3144":65750,"_27488":65748,"_5":27828,"_19100":112105,"_26023":112106,"_2643":105276},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3144":65751,"_27488":65748,"_5":27828,"_19100":112108,"_26023":112109,"_2643":112110},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3144":65752,"_27488":65748,"_5":27828,"_19100":112112,"_26023":112113,"_2643":112114},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3144":65753,"_27488":65748,"_5":27828,"_19100":112116,"_26023":112117,"_2643":112118},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3144":65754,"_27488":65748,"_5":27828,"_19100":112120,"_26023":112121,"_2643":112122},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3144":65755,"_27488":65748,"_5":27828,"_19100":112124,"_26023":112125,"_2643":112126},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3144":65756,"_27488":65748,"_5":27828,"_19100":112128,"_26023":112129,"_2643":112130},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3144":65757,"_27488":65748,"_5":27828,"_19100":112132,"_26023":112133,"_2643":109894},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3144":65758,"_27488":65748,"_5":27828,"_19100":112135,"_26023":112136,"_2643":105300},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3144":65759,"_27488":65748,"_19100":112138,"_5":13150,"_26023":65748,"_2643":112139},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3144":65760,"_27488":65748,"_19100":112141,"_5":13150,"_26023":112106,"_2643":112142},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3144":65761,"_27488":65748,"_19100":112144,"_5":13150,"_26023":112106,"_2643":112145},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3144":65762,"_27488":65748,"_19100":112147,"_5":13150,"_26023":112106,"_2643":112148},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3144":65763,"_27488":65748,"_19100":112150,"_5":13150,"_26023":112106,"_2643":112151},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3144":65764,"_27488":65748,"_19100":112153,"_5":13150,"_26023":112109,"_2643":112154},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3144":65765,"_27488":65748,"_19100":112156,"_5":13150,"_26023":112109,"_2643":112157},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3144":65766,"_27488":65748,"_19100":112159,"_5":13150,"_26023":112113,"_2643":112160},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3144":65767,"_27488":65748,"_19100":112162,"_5":13150,"_26023":112113,"_2643":112163},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3144":65768,"_27488":65748,"_19100":112165,"_5":13150,"_26023":112117,"_2643":112166},[],"Selecciona **Root CA** y completa:",{"_3144":65769,"_27488":65748,"_19100":112168,"_5":13150,"_26023":112117,"_2643":51836},[],{"_3144":65770,"_27488":65748,"_19100":112170,"_5":13150,"_26023":112117,"_2643":112171},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3144":65771,"_27488":65748,"_19100":112173,"_5":13150,"_26023":112117,"_2643":112174},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3144":65772,"_27488":65748,"_19100":112176,"_5":13150,"_26023":112117,"_2643":112177},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3144":65773,"_27488":65748,"_19100":112179,"_5":13150,"_26023":112117,"_2643":112180},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3144":65774,"_27488":65748,"_19100":112182,"_5":13150,"_26023":112121,"_2643":112183},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3144":65775,"_27488":65748,"_19100":112185,"_5":13150,"_26023":112125,"_2643":112186},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3144":65776,"_27488":65748,"_19100":112188,"_5":13150,"_26023":112125,"_2643":112189},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3144":65777,"_27488":65748,"_19100":112191,"_5":13150,"_26023":112129,"_2643":112192},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3144":65778,"_27488":65748,"_19100":112194,"_5":13150,"_26023":112129,"_2643":112195},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3144":65779,"_27488":65748,"_19100":112197,"_5":13150,"_26023":112129,"_2643":112198},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3144":65780,"_27488":65748,"_19100":112200,"_5":13150,"_26023":112133,"_2643":112201},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3144":65781,"_27488":65748,"_19100":112203,"_5":13150,"_26023":112133,"_2643":112204},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3144":65782,"_27488":65748,"_19100":112206,"_5":13150,"_26023":112133,"_2643":112207},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3144":65783,"_27488":65748,"_19100":112209,"_5":13150,"_26023":112133,"_2643":112210},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3144":65784,"_27488":65748,"_19100":112212,"_5":13150,"_26023":112136,"_2643":112213},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3144":65785,"_27488":65785,"_5":13476,"_2643":112215,"_27831":112216,"_19100":112217,"_26023":65785},"Emite y verifica un certificado",[44764,106610,49837,109646],[],{"_3144":65786,"_27488":65785,"_19100":112219,"_5":13150,"_26023":65785,"_2643":112220},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3144":65787,"_27488":65785,"_5":27828,"_19100":112222,"_26023":112223,"_2643":105276},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3144":65788,"_27488":65785,"_5":27828,"_19100":112225,"_26023":112226,"_2643":112227},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3144":65789,"_27488":65785,"_5":27828,"_19100":112229,"_26023":112230,"_2643":112231},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3144":65790,"_27488":65785,"_5":27828,"_19100":112233,"_26023":112234,"_2643":112235},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3144":65791,"_27488":65785,"_5":27828,"_19100":112237,"_26023":112238,"_2643":112239},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3144":65792,"_27488":65785,"_5":27828,"_19100":112241,"_26023":112242,"_2643":112243},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3144":65793,"_27488":65785,"_5":27828,"_19100":112245,"_26023":112246,"_2643":112126},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3144":65794,"_27488":65785,"_5":27828,"_19100":112248,"_26023":112249,"_2643":112250},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3144":65795,"_27488":65785,"_5":27828,"_19100":112252,"_26023":112253,"_2643":112254},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3144":65796,"_27488":65785,"_5":27828,"_19100":112256,"_26023":112257,"_2643":112258},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3144":65797,"_27488":65785,"_5":27828,"_19100":112260,"_26023":112261,"_2643":109894},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3144":65798,"_27488":65785,"_5":27828,"_19100":112263,"_26023":112264,"_2643":105300},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3144":65799,"_27488":65785,"_19100":112266,"_5":13150,"_26023":65785,"_2643":112267},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3144":65800,"_27488":65785,"_19100":112269,"_5":13150,"_26023":112223,"_2643":112270},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3144":65801,"_27488":65785,"_19100":112272,"_5":13150,"_26023":112223,"_2643":112273},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3144":65802,"_27488":65785,"_19100":112275,"_5":13150,"_26023":112223,"_2643":112276},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3144":65803,"_27488":65785,"_19100":112278,"_5":13150,"_26023":112223,"_2643":112279},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3144":65804,"_27488":65785,"_19100":112281,"_5":13150,"_26023":112223,"_2643":112282},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3144":65805,"_27488":65785,"_19100":112284,"_5":13150,"_26023":112226,"_2643":112285},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3144":65806,"_27488":65785,"_19100":112287,"_5":13150,"_26023":112230,"_2643":112288},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3144":65807,"_27488":65785,"_19100":112290,"_5":13150,"_26023":112230,"_2643":112291},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3144":65808,"_27488":65785,"_19100":112293,"_5":13150,"_26023":112234,"_2643":112294},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3144":65809,"_27488":65785,"_19100":112296,"_5":13150,"_26023":112234,"_2643":112297},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3144":65810,"_27488":65785,"_19100":112299,"_5":13150,"_26023":112238,"_2643":112300},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3144":65811,"_27488":65785,"_19100":112302,"_5":13150,"_26023":112238,"_2643":112303},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3144":65812,"_27488":65785,"_19100":112305,"_5":13150,"_26023":112242,"_2643":112306},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3144":65813,"_27488":65785,"_19100":112308,"_5":13150,"_26023":112246,"_2643":112309},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3144":65814,"_27488":65785,"_19100":112311,"_5":13150,"_26023":112249,"_2643":112312},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3144":65815,"_27488":65785,"_19100":112314,"_5":13150,"_26023":112253,"_2643":112315},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3144":65816,"_27488":65785,"_19100":112317,"_5":13150,"_26023":112253,"_2643":112318},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3144":65817,"_27488":65785,"_19100":112320,"_5":13150,"_26023":112253,"_2643":112321},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3144":65818,"_27488":65785,"_19100":112323,"_5":13150,"_26023":112257,"_2643":112324},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3144":65819,"_27488":65785,"_19100":112326,"_5":13150,"_26023":112257,"_2643":112327},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3144":65820,"_27488":65785,"_19100":112329,"_5":13150,"_26023":112257,"_2643":112330},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3144":65821,"_27488":65785,"_19100":112332,"_5":13150,"_26023":112261,"_2643":109977},[],{"_3144":65822,"_27488":65785,"_19100":112334,"_5":13150,"_26023":112261,"_2643":108744},[],{"_3144":65823,"_27488":65785,"_19100":112336,"_5":13150,"_26023":112261,"_2643":112337},[],"La CA rechaza la emisión",{"_3144":65824,"_27488":65785,"_19100":112339,"_5":13150,"_26023":112261,"_2643":112340},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3144":65825,"_27488":65785,"_19100":112342,"_5":13150,"_26023":112261,"_2643":112343},[],"Sujeto o usos diferentes",{"_3144":65826,"_27488":65785,"_19100":112345,"_5":13150,"_26023":112261,"_2643":112346},[],"Perfil aplicado y valores solicitados.",{"_3144":65827,"_27488":65785,"_19100":112348,"_5":13150,"_26023":112261,"_2643":112349},[],"No se encuentra el emisor",{"_3144":65828,"_27488":65785,"_19100":112351,"_5":13150,"_26023":112261,"_2643":112352},[],"CA descargada y cadena intermedia necesaria.",{"_3144":65829,"_27488":65785,"_19100":112354,"_5":13150,"_26023":112261,"_2643":112355},[],"Falla la vigencia",{"_3144":65830,"_27488":65785,"_19100":112357,"_5":13150,"_26023":112261,"_2643":112358},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3144":65831,"_27488":65785,"_19100":112360,"_5":13150,"_26023":112261,"_2643":112361},[],"Los resúmenes de clave difieren",{"_3144":65832,"_27488":65785,"_19100":112363,"_5":13150,"_26023":112261,"_2643":112364},[],"Archivos de certificado y clave de la misma emisión.",{"_3144":65833,"_27488":65785,"_19100":112366,"_5":13150,"_26023":112261,"_2643":112367},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3144":65834,"_27488":65785,"_19100":112369,"_5":13150,"_26023":112264,"_2643":112370},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3144":65835,"_27488":65785,"_19100":112372,"_5":13150,"_26023":112264,"_2643":112373},[],"Gestionar certificados para inspección, estado y revocación.",{"_3144":65836,"_27488":65785,"_19100":112375,"_5":13150,"_26023":112264,"_2643":112376},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3144":65837,"_27488":65785,"_19100":112378,"_5":13150,"_26023":112264,"_2643":112379},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3144":65838,"_27488":65785,"_19100":112381,"_5":13150,"_26023":112264,"_2643":112382},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3144":65839,"_27488":65839,"_5":13476,"_2643":112384,"_27831":112385,"_19100":112386,"_26023":65839},"Primeros pasos de PKI",[44764,106610,49837,109646],[],{"_3144":65840,"_27488":65839,"_19100":112388,"_5":13150,"_26023":65839,"_2643":112389},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3144":65841,"_27488":65839,"_5":27828,"_19100":112391,"_26023":112392,"_2643":105276},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3144":65842,"_27488":65839,"_5":27828,"_19100":112394,"_26023":112395,"_2643":112396},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3144":65843,"_27488":65839,"_5":27828,"_19100":112398,"_26023":112399,"_2643":109828},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3144":65844,"_27488":65839,"_5":27828,"_19100":112401,"_26023":112402,"_2643":112403},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3144":65845,"_27488":65839,"_19100":112405,"_5":13150,"_26023":65839,"_2643":112406},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3144":65846,"_27488":65839,"_19100":112408,"_5":13150,"_26023":112392,"_2643":112409},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3144":65847,"_27488":65839,"_19100":112411,"_5":13150,"_26023":112392,"_2643":112412},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3144":65848,"_27488":65839,"_19100":112414,"_5":13150,"_26023":112392,"_2643":112415},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3144":65849,"_27488":65839,"_19100":112417,"_5":13150,"_26023":112392,"_2643":112418},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3144":65850,"_27488":65839,"_19100":112420,"_5":13150,"_26023":112392,"_2643":112421},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3144":65851,"_27488":65839,"_19100":112423,"_5":13150,"_26023":112395,"_2643":112424},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3144":65852,"_27488":65839,"_19100":112426,"_5":13150,"_26023":112395,"_2643":112427},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3144":65853,"_27488":65839,"_19100":112429,"_5":13150,"_26023":112395,"_2643":112430},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3144":65854,"_27488":65839,"_19100":112432,"_5":13150,"_26023":112395,"_2643":112433},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3144":65855,"_27488":65839,"_19100":112435,"_5":13150,"_26023":112399,"_2643":112436},[],"Archivo o recurso",{"_3144":65856,"_27488":65839,"_19100":112438,"_5":13150,"_26023":112399,"_2643":109825},[],{"_3144":65857,"_27488":65839,"_19100":112440,"_5":13150,"_26023":112399,"_2643":112441},[],"CA raíz activa y `ca.pem`",{"_3144":65858,"_27488":65839,"_19100":112443,"_5":13150,"_26023":112399,"_2643":112444},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3144":65859,"_27488":65839,"_19100":112446,"_5":13150,"_26023":112399,"_2643":112447},[],"Certificado final y `device.crt`",{"_3144":65860,"_27488":65839,"_19100":112449,"_5":13150,"_26023":112399,"_2643":112450},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3144":65861,"_27488":65839,"_19100":112452,"_5":13150,"_26023":112399,"_2643":112453},[],"Clave privada `device.key`",{"_3144":65862,"_27488":65839,"_19100":112455,"_5":13150,"_26023":112399,"_2643":112456},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3144":65863,"_27488":65839,"_19100":112458,"_5":13150,"_26023":112399,"_2643":112459},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3144":65864,"_27488":65839,"_19100":112461,"_5":13150,"_26023":112402,"_2643":112462},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3144":65865,"_27488":65839,"_19100":112464,"_5":13150,"_26023":112402,"_2643":112465},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3144":65866,"_27488":65839,"_19100":112467,"_5":13150,"_26023":112402,"_2643":112468},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3144":65867,"_27488":65867,"_5":13476,"_2643":112470,"_27831":112471,"_19100":112473,"_26023":65867},"Resolución de problemas PKI",[44764,106610,49837,112472],"Resolución de problemas",[],{"_3144":65868,"_27488":65867,"_19100":112475,"_5":13150,"_26023":65867,"_2643":112476},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3144":65869,"_27488":65867,"_5":27828,"_19100":112478,"_26023":112479,"_2643":112480},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3144":65870,"_27488":65867,"_5":27828,"_19100":112482,"_26023":112483,"_2643":112484},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3144":65871,"_27488":65867,"_5":27828,"_19100":112486,"_26023":112487,"_2643":112488},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3144":65872,"_27488":65867,"_19100":112490,"_5":13150,"_26023":65867,"_2643":112491},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3144":65873,"_27488":65867,"_19100":112493,"_5":13150,"_26023":65867,"_2643":112494},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3144":65874,"_27488":65867,"_19100":112496,"_5":13150,"_26023":112479,"_2643":109825},[],{"_3144":65875,"_27488":65867,"_19100":112498,"_5":13150,"_26023":112479,"_2643":108744},[],{"_3144":65876,"_27488":65867,"_19100":112500,"_5":13150,"_26023":112479,"_2643":105300},[],{"_3144":65877,"_27488":65867,"_19100":112502,"_5":13150,"_26023":112479,"_2643":52172},[],{"_3144":65878,"_27488":65867,"_19100":112504,"_5":13150,"_26023":112479,"_2643":112505},[],"Existe, está activa y sus fechas son utilizables.",{"_3144":65879,"_27488":65867,"_19100":112507,"_5":13150,"_26023":112479,"_2643":112508},[],"Autoridades.",{"_3144":65880,"_27488":65867,"_19100":112510,"_5":13150,"_26023":112479,"_2643":112511},[],"Clave",{"_3144":65881,"_27488":65867,"_19100":112513,"_5":13150,"_26023":112479,"_2643":112514},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3144":65882,"_27488":65867,"_19100":112516,"_5":13150,"_26023":112479,"_2643":112517},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3144":65883,"_27488":65867,"_19100":112519,"_5":13150,"_26023":112479,"_2643":52190},[],{"_3144":65884,"_27488":65867,"_19100":112521,"_5":13150,"_26023":112479,"_2643":112522},[],"PEM correcto y firma verificable.",{"_3144":65885,"_27488":65867,"_19100":112524,"_5":13150,"_26023":112479,"_2643":52196},[],{"_3144":65886,"_27488":65867,"_19100":112526,"_5":13150,"_26023":112479,"_2643":112527},[],"Perfil",{"_3144":65887,"_27488":65867,"_19100":112529,"_5":13150,"_26023":112479,"_2643":112530},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3144":65888,"_27488":65867,"_19100":112532,"_5":13150,"_26023":112479,"_2643":112533},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3144":65889,"_27488":65867,"_19100":112535,"_5":13150,"_26023":112479,"_2643":109977},[],{"_3144":65890,"_27488":65867,"_19100":112537,"_5":13150,"_26023":112479,"_2643":112538},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3144":65891,"_27488":65867,"_19100":112540,"_5":13150,"_26023":112479,"_2643":112541},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3144":65892,"_27488":65867,"_19100":112543,"_5":13150,"_26023":112479,"_2643":112544},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3144":65893,"_27488":65867,"_19100":112546,"_5":13150,"_26023":112479,"_2643":112547},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3144":65894,"_27488":65867,"_19100":112549,"_5":13150,"_26023":112483,"_2643":112550},[],"Revisa cada frontera por separado:",{"_3144":65895,"_27488":65867,"_19100":112552,"_5":13150,"_26023":112483,"_2643":112553},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3144":65896,"_27488":65867,"_19100":112555,"_5":13150,"_26023":112483,"_2643":112556},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3144":65897,"_27488":65867,"_19100":112558,"_5":13150,"_26023":112483,"_2643":112559},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3144":65898,"_27488":65867,"_19100":112561,"_5":13150,"_26023":112483,"_2643":112562},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3144":65899,"_27488":65867,"_19100":112564,"_5":13150,"_26023":112483,"_2643":112565},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3144":65900,"_27488":65867,"_19100":112567,"_5":13150,"_26023":112483,"_2643":112568},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3144":65901,"_27488":65867,"_19100":112570,"_5":13150,"_26023":112487,"_2643":112571},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3144":65902,"_27488":65867,"_19100":112573,"_5":13150,"_26023":112487,"_2643":112574},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3144":65903,"_27488":65903,"_5":13476,"_2643":112576,"_27831":112577,"_19100":112579,"_26023":65903},"3.8.0 a 4.0.0",[44764,112578],"Actualizaciones",[],{"_3144":65904,"_27488":65903,"_19100":112581,"_5":13150,"_26023":65903,"_2643":112582},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3144":65905,"_27488":65903,"_5":27828,"_19100":112584,"_26023":112585,"_2643":112586},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3144":65906,"_27488":65903,"_5":27828,"_19100":112588,"_26023":112589,"_2643":112590},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3144":65907,"_27488":65903,"_5":27828,"_19100":112592,"_26023":112593,"_2643":112594},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3144":65908,"_27488":65903,"_5":27828,"_19100":112596,"_26023":112597,"_2643":112598},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3144":65909,"_27488":65903,"_5":27828,"_19100":112600,"_26023":112601,"_2643":112602},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3144":65910,"_27488":65903,"_5":27828,"_19100":112604,"_26023":112605,"_2643":112606},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3144":65911,"_27488":65903,"_5":27828,"_19100":112608,"_26023":112609,"_2643":52282},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3144":65912,"_27488":65903,"_5":27828,"_19100":112611,"_26023":112612,"_2643":112613},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3144":65913,"_27488":65903,"_5":27828,"_19100":112615,"_26023":112616,"_2643":112617},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3144":65914,"_27488":65903,"_5":27828,"_19100":112619,"_26023":112620,"_2643":112621},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3144":65915,"_27488":65903,"_5":27828,"_19100":112623,"_26023":112624,"_2643":112625},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3144":65916,"_27488":65903,"_5":27828,"_19100":112627,"_26023":112628,"_2643":112629},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3144":65917,"_27488":65903,"_5":27828,"_19100":112631,"_26023":112632,"_2643":112633},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3144":65918,"_27488":65903,"_5":27828,"_19100":112635,"_26023":112636,"_2643":112637},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3144":65919,"_27488":65903,"_5":27828,"_19100":112639,"_26023":112640,"_2643":112641},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3144":65920,"_27488":65903,"_5":27828,"_19100":112643,"_26023":112644,"_2643":112645},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3144":65921,"_27488":65903,"_5":27828,"_19100":112647,"_26023":112648,"_2643":112649},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3144":65922,"_27488":65903,"_5":27828,"_19100":112651,"_26023":112652,"_2643":112653},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3144":65923,"_27488":65903,"_5":27828,"_19100":112655,"_26023":112656,"_2643":112657},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3144":65924,"_27488":65903,"_5":27828,"_19100":112659,"_26023":112660,"_2643":112661},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3144":65925,"_27488":65903,"_5":27828,"_19100":112663,"_26023":112664,"_2643":112665},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3144":65926,"_27488":65903,"_5":27828,"_19100":112667,"_26023":112668,"_2643":112669},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3144":65927,"_27488":65903,"_5":27828,"_19100":112671,"_26023":112672,"_2643":112673},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3144":65928,"_27488":65903,"_5":27828,"_19100":112675,"_26023":112676,"_2643":112677},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3144":65929,"_27488":65903,"_5":27828,"_19100":112679,"_26023":112680,"_2643":112681},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3144":65930,"_27488":65903,"_5":27828,"_19100":112683,"_26023":112684,"_2643":112685},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3144":65931,"_27488":65903,"_5":27828,"_19100":112687,"_26023":112688,"_2643":112689},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3144":65932,"_27488":65903,"_5":27828,"_19100":112691,"_26023":112692,"_2643":112693},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3144":65933,"_27488":65903,"_5":27828,"_19100":112695,"_26023":112696,"_2643":112697},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3144":65934,"_27488":65903,"_5":27828,"_19100":112699,"_26023":112700,"_2643":112701},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3144":65935,"_27488":65903,"_5":27828,"_19100":112703,"_26023":112704,"_2643":112705},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3144":65936,"_27488":65903,"_5":27828,"_19100":112707,"_26023":112708,"_2643":112709},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3144":65937,"_27488":65903,"_5":27828,"_19100":112711,"_26023":112712,"_2643":112713},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3144":65938,"_27488":65903,"_5":27828,"_19100":112715,"_26023":112716,"_2643":109066},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3144":65939,"_27488":65903,"_5":27828,"_19100":112718,"_26023":112719,"_2643":112720},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3144":65940,"_27488":65903,"_5":27828,"_19100":112722,"_26023":112723,"_2643":112724},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3144":65941,"_27488":65903,"_19100":112726,"_5":13150,"_26023":65903,"_2643":112727},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3144":65942,"_27488":65903,"_19100":112729,"_5":13150,"_26023":65903,"_2643":112730},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3144":65943,"_27488":65903,"_19100":112732,"_5":13150,"_26023":65903,"_2643":112733},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3144":65944,"_27488":65903,"_19100":112735,"_5":13150,"_26023":65903,"_2643":112736},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3144":65945,"_27488":65903,"_19100":112738,"_5":13150,"_26023":65903,"_2643":112739},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3144":65946,"_27488":65903,"_19100":112741,"_5":13150,"_26023":65903,"_2643":112742},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3144":65947,"_27488":65903,"_19100":112744,"_5":13150,"_26023":65903,"_2643":112745},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3144":65948,"_27488":65903,"_19100":112747,"_5":13150,"_26023":112589,"_2643":112748},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3144":65949,"_27488":65903,"_19100":112750,"_5":13150,"_26023":112589,"_2643":112751},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3144":65950,"_27488":65903,"_19100":112753,"_5":13150,"_26023":112593,"_2643":112754},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3144":65951,"_27488":65903,"_19100":112756,"_5":13150,"_26023":112593,"_2643":112757},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3144":65952,"_27488":65903,"_19100":112759,"_5":13150,"_26023":112597,"_2643":112760},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3144":65953,"_27488":65903,"_19100":112762,"_5":13150,"_26023":112601,"_2643":112763},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3144":65954,"_27488":65903,"_19100":112765,"_5":13150,"_26023":112601,"_2643":112766},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3144":65955,"_27488":65903,"_19100":112768,"_5":13150,"_26023":112601,"_2643":112769},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3144":65956,"_27488":65903,"_19100":112771,"_5":13150,"_26023":112601,"_2643":112772},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3144":65957,"_27488":65903,"_19100":112774,"_5":13150,"_26023":112601,"_2643":112775},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3144":65958,"_27488":65903,"_19100":112777,"_5":13150,"_26023":112605,"_2643":112778},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3144":65959,"_27488":65903,"_19100":112780,"_5":13150,"_26023":112605,"_2643":112781},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3144":65960,"_27488":65903,"_19100":112783,"_5":13150,"_26023":112605,"_2643":112784},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3144":65961,"_27488":65903,"_19100":112786,"_5":13150,"_26023":112605,"_2643":112787},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3144":65962,"_27488":65903,"_19100":112789,"_5":13150,"_26023":112605,"_2643":112790},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3144":65963,"_27488":65903,"_19100":112792,"_5":13150,"_26023":112609,"_2643":112793},[],"Cambio",{"_3144":65964,"_27488":65903,"_19100":112795,"_5":13150,"_26023":112609,"_2643":112796},[],"A quién afecta",{"_3144":65965,"_27488":65903,"_19100":112798,"_5":13150,"_26023":112609,"_2643":112799},[],"Gravedad",{"_3144":65966,"_27488":65903,"_19100":112801,"_5":13150,"_26023":112609,"_2643":112802},[],"Acción",{"_3144":65967,"_27488":65903,"_19100":112804,"_5":13150,"_26023":112609,"_2643":112617},[],{"_3144":65968,"_27488":65903,"_19100":112806,"_5":13150,"_26023":112609,"_2643":112807},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3144":65969,"_27488":65903,"_19100":112809,"_5":13150,"_26023":112609,"_2643":112810},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3144":65970,"_27488":65903,"_19100":112812,"_5":13150,"_26023":112609,"_2643":112813},[],"Copiar los datos a los volúmenes nuevos",{"_3144":65971,"_27488":65903,"_19100":112815,"_5":13150,"_26023":112609,"_2643":112621},[],{"_3144":65972,"_27488":65903,"_19100":112817,"_5":13150,"_26023":112609,"_2643":112818},[],"Todas las releases de Helm",{"_3144":65973,"_27488":65903,"_19100":112820,"_5":13150,"_26023":112609,"_2643":112821},[],"Alta: `helm upgrade` falla",{"_3144":65974,"_27488":65903,"_19100":112823,"_5":13150,"_26023":112609,"_2643":112824},[],"Eliminar o renombrar las claves heredadas",{"_3144":65975,"_27488":65903,"_19100":112826,"_5":13150,"_26023":112609,"_2643":112625},[],{"_3144":65976,"_27488":65903,"_19100":112828,"_5":13150,"_26023":112609,"_2643":112829},[],"Todos los despliegues",{"_3144":65977,"_27488":65903,"_19100":112831,"_5":13150,"_26023":112609,"_2643":112832},[],"Alta: sin principal de bootstrap no hay administrador",{"_3144":65978,"_27488":65903,"_19100":112834,"_5":13150,"_26023":112609,"_2643":112835},[],"Configurar `services.authz`",{"_3144":65979,"_27488":65903,"_19100":112837,"_5":13150,"_26023":112609,"_2643":112629},[],{"_3144":65980,"_27488":65903,"_19100":112839,"_5":13150,"_26023":112609,"_2643":112818},[],{"_3144":65981,"_27488":65903,"_19100":112841,"_5":13150,"_26023":112609,"_2643":112842},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3144":65982,"_27488":65903,"_19100":112844,"_5":13150,"_26023":112609,"_2643":112845},[],"Mover JWKS y roles a `services.authz`",{"_3144":65983,"_27488":65903,"_19100":112847,"_5":13150,"_26023":112609,"_2643":112649},[],{"_3144":65984,"_27488":65903,"_19100":112849,"_5":13150,"_26023":112609,"_2643":112850},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3144":65985,"_27488":65903,"_19100":112852,"_5":13150,"_26023":112609,"_2643":112853},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3144":65986,"_27488":65903,"_19100":112855,"_5":13150,"_26023":112609,"_2643":112856},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3144":65987,"_27488":65903,"_19100":112858,"_5":13150,"_26023":112609,"_2643":112653},[],{"_3144":65988,"_27488":65903,"_19100":112860,"_5":13150,"_26023":112609,"_2643":112861},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3144":65989,"_27488":65903,"_19100":112863,"_5":13150,"_26023":112609,"_2643":112864},[],"Alta: el backend ya no arranca con ellos",{"_3144":65990,"_27488":65903,"_19100":112866,"_5":13150,"_26023":112609,"_2643":112867},[],"Pasar a PostgreSQL antes de actualizar",{"_3144":65991,"_27488":65903,"_19100":112869,"_5":13150,"_26023":112609,"_2643":112870},[],"Webhooks con referencias a archivos",{"_3144":65992,"_27488":65903,"_19100":112872,"_5":13150,"_26023":112609,"_2643":112873},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3144":65993,"_27488":65903,"_19100":112875,"_5":13150,"_26023":112609,"_2643":112876},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3144":65994,"_27488":65903,"_19100":112878,"_5":13150,"_26023":112609,"_2643":112879},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3144":65995,"_27488":65903,"_19100":112881,"_5":13150,"_26023":112609,"_2643":112633},[],{"_3144":65996,"_27488":65903,"_19100":112883,"_5":13150,"_26023":112609,"_2643":112884},[],"Releases con identidades por servicio o material de claves montado",{"_3144":65997,"_27488":65903,"_19100":112886,"_5":13150,"_26023":112609,"_2643":112887},[],"Media: los servicios no pueden leer sus archivos",{"_3144":65998,"_27488":65903,"_19100":112889,"_5":13150,"_26023":112609,"_2643":112890},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3144":65999,"_27488":65903,"_19100":112892,"_5":13150,"_26023":112609,"_2643":112637},[],{"_3144":66000,"_27488":65903,"_19100":112894,"_5":13150,"_26023":112609,"_2643":112895},[],"Releases que definen `amqp.tls`",{"_3144":66001,"_27488":65903,"_19100":112897,"_5":13150,"_26023":112609,"_2643":112898},[],"Media: los clientes se conectan al puerto equivocado",{"_3144":66002,"_27488":65903,"_19100":112900,"_5":13150,"_26023":112609,"_2643":112901},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3144":66003,"_27488":65903,"_19100":112903,"_5":13150,"_26023":112609,"_2643":112657},[],{"_3144":66004,"_27488":65903,"_19100":112905,"_5":13150,"_26023":112609,"_2643":112906},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3144":66005,"_27488":65903,"_19100":112908,"_5":13150,"_26023":112609,"_2643":112909},[],"Media: las claves de CA quedan sin gestionar",{"_3144":66006,"_27488":65903,"_19100":112911,"_5":13150,"_26023":112609,"_2643":112912},[],"Ejecutar la migración de CA a KMS",{"_3144":66007,"_27488":65903,"_19100":112914,"_5":13150,"_26023":112609,"_2643":112915},[],"Verificación del certificado del receptor",{"_3144":66008,"_27488":65903,"_19100":112917,"_5":13150,"_26023":112609,"_2643":112918},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3144":66009,"_27488":65903,"_19100":112920,"_5":13150,"_26023":112609,"_2643":112921},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3144":66010,"_27488":65903,"_19100":112923,"_5":13150,"_26023":112609,"_2643":112924},[],"Poner `insecure_skip_verify` a `false`",{"_3144":66011,"_27488":65903,"_19100":112926,"_5":13150,"_26023":112609,"_2643":112669},[],{"_3144":66012,"_27488":65903,"_19100":112928,"_5":13150,"_26023":112609,"_2643":112929},[],"Scripts y consolas que editan DMS por API",{"_3144":66013,"_27488":65903,"_19100":112931,"_5":13150,"_26023":112609,"_2643":112932},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3144":66014,"_27488":65903,"_19100":112934,"_5":13150,"_26023":112609,"_2643":112935},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3144":66015,"_27488":65903,"_19100":112937,"_5":13150,"_26023":112609,"_2643":112685},[],{"_3144":66016,"_27488":65903,"_19100":112939,"_5":13150,"_26023":112609,"_2643":112940},[],"Consumidores que leen el campo `events` del dispositivo",{"_3144":66017,"_27488":65903,"_19100":112942,"_5":13150,"_26023":112609,"_2643":112943},[],"Media: el campo desaparece",{"_3144":66018,"_27488":65903,"_19100":112945,"_5":13150,"_26023":112609,"_2643":112946},[],"Usar los nuevos endpoints de eventos",{"_3144":66019,"_27488":65903,"_19100":112948,"_5":13150,"_26023":112609,"_2643":112641},[],{"_3144":66020,"_27488":65903,"_19100":112950,"_5":13150,"_26023":112609,"_2643":112951},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3144":66021,"_27488":65903,"_19100":112953,"_5":13150,"_26023":112609,"_2643":112954},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3144":66022,"_27488":65903,"_19100":112956,"_5":13150,"_26023":112609,"_2643":112957},[],"Actualizar el archivo de values",{"_3144":66023,"_27488":65903,"_19100":112959,"_5":13150,"_26023":112609,"_2643":112677},[],{"_3144":66024,"_27488":65903,"_19100":112961,"_5":13150,"_26023":112609,"_2643":112962},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3144":66025,"_27488":65903,"_19100":112964,"_5":13150,"_26023":112609,"_2643":112965},[],"Baja: prevalece el ID de la URL",{"_3144":66026,"_27488":65903,"_19100":112967,"_5":13150,"_26023":112609,"_2643":112968},[],"Enviar el ID en la URL",{"_3144":66027,"_27488":65903,"_19100":112970,"_5":13150,"_26023":112609,"_2643":112681},[],{"_3144":66028,"_27488":65903,"_19100":112972,"_5":13150,"_26023":112609,"_2643":112973},[],"Consumidores que comparan el `type` del certificado",{"_3144":66029,"_27488":65903,"_19100":112975,"_5":13150,"_26023":112609,"_2643":112976},[],"Baja: dos valores cambian de nombre",{"_3144":66030,"_27488":65903,"_19100":112978,"_5":13150,"_26023":112609,"_2643":112979},[],"Adaptar los consumidores",{"_3144":66031,"_27488":65903,"_19100":112981,"_5":13150,"_26023":112609,"_2643":112673},[],{"_3144":66032,"_27488":65903,"_19100":112983,"_5":13150,"_26023":112609,"_2643":112984},[],"Cualquier DMS",{"_3144":66033,"_27488":65903,"_19100":112986,"_5":13150,"_26023":112609,"_2643":112987},[],"Baja: solo informativo",{"_3144":66034,"_27488":65903,"_19100":112989,"_5":13150,"_26023":112609,"_2643":112990},[],"Revisar ambos bloques antes de editar",{"_3144":66035,"_27488":65903,"_19100":112992,"_5":13150,"_26023":112616,"_2643":112993},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3144":66036,"_27488":65903,"_19100":112995,"_5":13150,"_26023":112616,"_2643":112996},[],"El paso 4 de la guía de migración copia los datos.",{"_3144":66037,"_27488":65903,"_19100":112998,"_5":13150,"_26023":112620,"_2643":112999},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3144":66038,"_27488":65903,"_19100":113001,"_5":13150,"_26023":112624,"_2643":113002},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3144":66039,"_27488":65903,"_19100":113004,"_5":13150,"_26023":112628,"_2643":113005},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3144":66040,"_27488":65903,"_19100":113007,"_5":13150,"_26023":112632,"_2643":113008},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3144":66041,"_27488":65903,"_19100":113010,"_5":13150,"_26023":112632,"_2643":113011},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3144":66042,"_27488":65903,"_19100":113013,"_5":13150,"_26023":112636,"_2643":113014},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3144":66043,"_27488":65903,"_19100":113016,"_5":13150,"_26023":112640,"_2643":113017},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3144":66044,"_27488":65903,"_19100":113019,"_5":13150,"_26023":112640,"_2643":113020},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3144":66045,"_27488":65903,"_19100":113022,"_5":13150,"_26023":112640,"_2643":113023},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3144":66046,"_27488":65903,"_19100":113025,"_5":13150,"_26023":112640,"_2643":113026},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3144":66047,"_27488":65903,"_19100":113028,"_5":13150,"_26023":112640,"_2643":113029},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3144":66048,"_27488":65903,"_19100":113031,"_5":13150,"_26023":112640,"_2643":113032},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3144":66049,"_27488":65903,"_19100":113034,"_5":13150,"_26023":112648,"_2643":113035},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3144":66050,"_27488":65903,"_19100":113037,"_5":13150,"_26023":112648,"_2643":113038},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3144":66051,"_27488":65903,"_19100":113040,"_5":13150,"_26023":112648,"_2643":113041},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3144":66052,"_27488":65903,"_19100":113043,"_5":13150,"_26023":112648,"_2643":113044},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3144":66053,"_27488":65903,"_19100":113046,"_5":13150,"_26023":112648,"_2643":113047},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3144":66054,"_27488":65903,"_19100":113049,"_5":13150,"_26023":112652,"_2643":113050},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3144":66055,"_27488":65903,"_19100":113052,"_5":13150,"_26023":112656,"_2643":113053},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3144":66056,"_27488":65903,"_19100":113055,"_5":13150,"_26023":112656,"_2643":113056},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3144":66057,"_27488":65903,"_19100":113058,"_5":13150,"_26023":112656,"_2643":113059},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3144":66058,"_27488":65903,"_19100":113061,"_5":13150,"_26023":112656,"_2643":113062},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3144":66059,"_27488":65903,"_19100":113064,"_5":13150,"_26023":112656,"_2643":113065},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3144":66060,"_27488":65903,"_19100":113067,"_5":13150,"_26023":112656,"_2643":113068},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3144":66061,"_27488":65903,"_19100":113070,"_5":13150,"_26023":112664,"_2643":113071},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3144":66062,"_27488":65903,"_19100":113073,"_5":13150,"_26023":112664,"_2643":113074},[],"Campo en 3.8.0",{"_3144":66063,"_27488":65903,"_19100":113076,"_5":13150,"_26023":112664,"_2643":113077},[],"Campo en 4.0.0",{"_3144":66064,"_27488":65903,"_19100":113079,"_5":13150,"_26023":112664,"_2643":52753},[],{"_3144":66065,"_27488":65903,"_19100":113081,"_5":13150,"_26023":112664,"_2643":113082},[],"`insecure_skip_verify` (con el valor negado)",{"_3144":66066,"_27488":65903,"_19100":113084,"_5":13150,"_26023":112664,"_2643":52759},[],{"_3144":66067,"_27488":65903,"_19100":113086,"_5":13150,"_26023":112664,"_2643":52762},[],{"_3144":66068,"_27488":65903,"_19100":113088,"_5":13150,"_26023":112664,"_2643":52765},[],{"_3144":66069,"_27488":65903,"_19100":113090,"_5":13150,"_26023":112664,"_2643":52768},[],{"_3144":66070,"_27488":65903,"_19100":113092,"_5":13150,"_26023":112664,"_2643":52771},[],{"_3144":66071,"_27488":65903,"_19100":113094,"_5":13150,"_26023":112664,"_2643":52774},[],{"_3144":66072,"_27488":65903,"_19100":113096,"_5":13150,"_26023":112664,"_2643":113097},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3144":66073,"_27488":65903,"_19100":113099,"_5":13150,"_26023":112664,"_2643":113100},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3144":66074,"_27488":65903,"_19100":113102,"_5":13150,"_26023":112664,"_2643":113103},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3144":66075,"_27488":65903,"_19100":113105,"_5":13150,"_26023":112668,"_2643":113106},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3144":66076,"_27488":65903,"_19100":113108,"_5":13150,"_26023":112668,"_2643":113109},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3144":66077,"_27488":65903,"_19100":113111,"_5":13150,"_26023":112668,"_2643":113112},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3144":66078,"_27488":65903,"_19100":113114,"_5":13150,"_26023":112672,"_2643":113115},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. Si la versión de la consola no expone los ajustes independientes, edítalos mediante la API DMS.",{"_3144":66079,"_27488":65903,"_19100":113117,"_5":13150,"_26023":112676,"_2643":113118},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3144":66080,"_27488":65903,"_19100":113120,"_5":13150,"_26023":112680,"_2643":113121},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3144":66081,"_27488":65903,"_19100":113123,"_5":13150,"_26023":112684,"_2643":113124},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3144":66082,"_27488":65903,"_19100":113126,"_5":13150,"_26023":112684,"_2643":113127},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3144":66083,"_27488":65903,"_19100":113129,"_5":13150,"_26023":112684,"_2643":113130},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3144":66084,"_27488":65903,"_19100":113132,"_5":13150,"_26023":112684,"_2643":113133},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3144":66085,"_27488":65903,"_19100":113135,"_5":13150,"_26023":112688,"_2643":113136},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3144":66086,"_27488":65903,"_19100":113138,"_5":13150,"_26023":112692,"_2643":113139},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3144":66087,"_27488":65903,"_19100":113141,"_5":13150,"_26023":112692,"_2643":113142},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3144":66088,"_27488":65903,"_19100":113144,"_5":13150,"_26023":112692,"_2643":113145},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3144":66089,"_27488":65903,"_19100":113147,"_5":13150,"_26023":112692,"_2643":113148},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3144":66090,"_27488":65903,"_19100":113150,"_5":13150,"_26023":112692,"_2643":113151},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3144":66091,"_27488":65903,"_19100":113153,"_5":13150,"_26023":112696,"_2643":113154},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3144":66092,"_27488":65903,"_19100":113156,"_5":13150,"_26023":112696,"_2643":113157},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3144":66093,"_27488":65903,"_19100":113159,"_5":13150,"_26023":112696,"_2643":113160},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3144":66094,"_27488":65903,"_19100":113162,"_5":13150,"_26023":112696,"_2643":113163},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3144":66095,"_27488":65903,"_19100":113165,"_5":13150,"_26023":112696,"_2643":113166},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3144":66096,"_27488":65903,"_19100":113168,"_5":13150,"_26023":112696,"_2643":113169},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3144":66097,"_27488":65903,"_19100":113171,"_5":13150,"_26023":112696,"_2643":113172},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3144":66098,"_27488":65903,"_19100":113174,"_5":13150,"_26023":112696,"_2643":113175},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3144":66099,"_27488":65903,"_19100":113177,"_5":13150,"_26023":112696,"_2643":113178},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3144":66100,"_27488":65903,"_19100":113180,"_5":13150,"_26023":112696,"_2643":113181},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3144":66101,"_27488":65903,"_19100":113183,"_5":13150,"_26023":112696,"_2643":113184},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3144":66102,"_27488":65903,"_19100":113186,"_5":13150,"_26023":112696,"_2643":113187},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3144":66103,"_27488":65903,"_19100":113189,"_5":13150,"_26023":112700,"_2643":113190},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar. Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4.",{"_3144":66104,"_27488":65903,"_19100":113192,"_5":13150,"_26023":112704,"_2643":113193},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3144":66105,"_27488":65903,"_19100":113195,"_5":13150,"_26023":112704,"_2643":113196},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3144":66106,"_27488":65903,"_19100":113198,"_5":13150,"_26023":112704,"_2643":113199},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3144":66107,"_27488":65903,"_19100":113201,"_5":13150,"_26023":112704,"_2643":113202},[],"**Anota el número de réplicas y reduce a cero los nuevos StatefulSets** para que nada escriba en ninguno de los volúmenes mientras copias:",{"_3144":66108,"_27488":65903,"_19100":113204,"_5":13150,"_26023":112704,"_2643":113205},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3144":66109,"_27488":65903,"_19100":113207,"_5":13150,"_26023":112704,"_2643":113208},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3144":66110,"_27488":65903,"_19100":113210,"_5":13150,"_26023":112704,"_2643":113211},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3144":66111,"_27488":65903,"_19100":113213,"_5":13150,"_26023":112704,"_2643":113214},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3144":66112,"_27488":65903,"_19100":113216,"_5":13150,"_26023":112704,"_2643":113217},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3144":66113,"_27488":65903,"_19100":113219,"_5":13150,"_26023":112704,"_2643":113220},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3144":66114,"_27488":65903,"_19100":113222,"_5":13150,"_26023":112708,"_2643":113223},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3144":66115,"_27488":65903,"_19100":113225,"_5":13150,"_26023":112708,"_2643":113226},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3144":66116,"_27488":65903,"_19100":113228,"_5":13150,"_26023":112712,"_2643":113229},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3144":66117,"_27488":65903,"_19100":113231,"_5":13150,"_26023":112712,"_2643":113232},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3144":66118,"_27488":65903,"_19100":113234,"_5":13150,"_26023":112712,"_2643":113235},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3144":66119,"_27488":65903,"_19100":113237,"_5":13150,"_26023":112712,"_2643":113238},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`.",{"_3144":66120,"_27488":65903,"_19100":113240,"_5":13150,"_26023":112712,"_2643":113241},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3144":66121,"_27488":65903,"_19100":113243,"_5":13150,"_26023":112716,"_2643":113244},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3144":66122,"_27488":65903,"_19100":113246,"_5":13150,"_26023":112716,"_2643":113247},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3144":66123,"_27488":65903,"_19100":113249,"_5":13150,"_26023":112716,"_2643":113250},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3144":66124,"_27488":65903,"_19100":113252,"_5":13150,"_26023":112716,"_2643":113253},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3144":66125,"_27488":65903,"_19100":113255,"_5":13150,"_26023":112716,"_2643":113256},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3144":66126,"_27488":65903,"_19100":113258,"_5":13150,"_26023":112719,"_2643":113259},[],"Tras la actualización, comprueba en este orden:",{"_3144":66127,"_27488":65903,"_19100":113261,"_5":13150,"_26023":112719,"_2643":113262},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3144":66128,"_27488":65903,"_19100":113264,"_5":13150,"_26023":112719,"_2643":113265},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3144":66129,"_27488":65903,"_19100":113267,"_5":13150,"_26023":112719,"_2643":113268},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3144":66130,"_27488":65903,"_19100":113270,"_5":13150,"_26023":112719,"_2643":113271},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3144":66131,"_27488":65903,"_19100":113273,"_5":13150,"_26023":112719,"_2643":113274},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3144":66132,"_27488":65903,"_19100":113276,"_5":13150,"_26023":112719,"_2643":113277},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3144":66133,"_27488":65903,"_19100":113279,"_5":13150,"_26023":112719,"_2643":113280},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3144":66134,"_27488":65903,"_19100":113282,"_5":13150,"_26023":112719,"_2643":113283},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3144":66135,"_27488":65903,"_19100":113285,"_5":13150,"_26023":112719,"_2643":113286},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3144":66136,"_27488":65903,"_19100":113288,"_5":13150,"_26023":112719,"_2643":113289},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3144":66137,"_27488":65903,"_19100":113291,"_5":13150,"_26023":112719,"_2643":113292},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3144":66138,"_27488":65903,"_19100":113294,"_5":13150,"_26023":112719,"_2643":113295},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3144":66139,"_27488":65903,"_19100":113297,"_5":13150,"_26023":112719,"_2643":113298},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3144":66140,"_27488":65903,"_19100":113300,"_5":13150,"_26023":112719,"_2643":113301},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3144":66141,"_27488":65903,"_19100":113303,"_5":13150,"_26023":112723,"_2643":113304},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente:",{"_3144":66142,"_27488":65903,"_19100":113306,"_5":13150,"_26023":112723,"_2643":113307},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3144":66143,"_27488":65903,"_19100":113309,"_5":13150,"_26023":112723,"_2643":113310},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3144":66144,"_27488":65903,"_19100":113312,"_5":13150,"_26023":112723,"_2643":113313},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3144":66145,"_27488":65903,"_19100":113315,"_5":13150,"_26023":112723,"_2643":113316},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_52999":113318,"_53001":113319,"_53003":113320,"_53005":113321,"_16656":2665,"_63516":2665},"spanish",[2643,27488,5,26023],{"_2643":22829,"_27488":22829,"_5":22829,"_26023":22829},{"_2643":113322,"_27488":115948,"_5":118574,"_26023":121200},{"_4206":113323,"_53009":113324,"_5":22829},{"_13205":4109,"_13575":6285,"_13582":5996,"_11851":4352,"_26149":15716,"_18144":2910,"_13226":4582,"_13233":4297,"_26576