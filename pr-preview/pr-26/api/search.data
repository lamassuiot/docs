5,"_32857":43828,"_32859":43831,"_32861":43834,"_32863":43837,"_32865":43840,"_32867":43843,"_32869":43846,"_32871":43849,"_32873":43852,"_32875":43855,"_32877":43858,"_32879":43861,"_32881":43864,"_32883":43867,"_32885":43870,"_32887":43873,"_32889":43876,"_32891":43879,"_32893":43882,"_32895":43885,"_32897":43888,"_32899":43891,"_32901":43894,"_32903":43897,"_32905":43900,"_32907":43903,"_32909":43906,"_32911":43909,"_32913":43912,"_32915":43915,"_32917":43918,"_32919":43921,"_32921":43924,"_32923":43927,"_32925":43930,"_32927":43934,"_32929":43938,"_32931":43942,"_32933":43945,"_32935":43948,"_32937":43951,"_32939":43954},{"_4673":11,"_26077":11,"_5":26333,"_1794":38336,"_26346":38337,"_22045":38341,"_10236":11},"Despliega desde AWS Marketplace",[38338,38339,38340],"Docs","Despliegue","Otros modelos",[],{"_4673":12,"_26077":11,"_22045":38343,"_5":26338,"_10236":11,"_1794":38344},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_4673":13,"_26077":11,"_5":26343,"_22045":38346,"_10236":38347,"_1794":38348},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_4673":14,"_26077":11,"_5":26343,"_22045":38350,"_10236":38351,"_1794":38352},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_4673":15,"_26077":11,"_5":26343,"_22045":38354,"_10236":38355,"_1794":38356},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_4673":16,"_26077":11,"_5":26343,"_22045":38358,"_10236":38359,"_1794":38360},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_4673":17,"_26077":11,"_5":26343,"_22045":38362,"_10236":38363,"_1794":38364},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_4673":18,"_26077":11,"_5":26343,"_22045":38366,"_10236":38367,"_1794":38368},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_4673":19,"_26077":11,"_5":26343,"_22045":38370,"_10236":38371,"_1794":38372},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_4673":20,"_26077":11,"_22045":38374,"_5":26338,"_10236":11,"_1794":38375},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_4673":21,"_26077":11,"_22045":38377,"_5":26338,"_10236":38347,"_1794":38378},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_4673":22,"_26077":11,"_22045":38380,"_5":26338,"_10236":38347,"_1794":38381},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_4673":23,"_26077":11,"_22045":38383,"_5":26338,"_10236":38347,"_1794":38384},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_4673":24,"_26077":11,"_22045":38386,"_5":26338,"_10236":38351,"_1794":38387},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_4673":25,"_26077":11,"_22045":38389,"_5":26338,"_10236":38351,"_1794":38390},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_4673":26,"_26077":11,"_22045":38392,"_5":26338,"_10236":38351,"_1794":38393},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_4673":27,"_26077":11,"_22045":38395,"_5":26338,"_10236":38355,"_1794":38396},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_4673":28,"_26077":11,"_22045":38398,"_5":26338,"_10236":38359,"_1794":38399},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_4673":29,"_26077":11,"_22045":38401,"_5":26338,"_10236":38363,"_1794":38402},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_4673":30,"_26077":11,"_22045":38404,"_5":26338,"_10236":38367,"_1794":38405},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_4673":31,"_26077":11,"_22045":38407,"_5":26338,"_10236":38371,"_1794":38408},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_4673":32,"_26077":32,"_5":26333,"_1794":38410,"_26346":38411,"_22045":38412,"_10236":32},"Despliega Lamassu",[38338,38339],[],{"_4673":33,"_26077":32,"_22045":38414,"_5":26338,"_10236":32,"_1794":38415},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_4673":34,"_26077":32,"_5":26343,"_22045":38417,"_10236":38418,"_1794":38419},[],"/docs/pr-preview/pr-26/deployment/overview#elige-un-modelo","Elige un modelo",{"_4673":35,"_26077":32,"_5":26343,"_22045":38421,"_10236":38422,"_1794":38423},[],"/docs/pr-preview/pr-26/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_4673":36,"_26077":32,"_5":26343,"_22045":38425,"_10236":38426,"_1794":38427},[],"/docs/pr-preview/pr-26/deployment/overview#después-del-despliegue","Después del despliegue",{"_4673":37,"_26077":32,"_22045":38429,"_5":26338,"_10236":32,"_1794":38430},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_4673":38,"_26077":32,"_22045":38432,"_5":26338,"_10236":38418,"_1794":38433},[],"Modelo",{"_4673":39,"_26077":32,"_22045":38435,"_5":26338,"_10236":38418,"_1794":38436},[],"Recomendado para",{"_4673":40,"_26077":32,"_22045":38438,"_5":26338,"_10236":38418,"_1794":38439},[],"Quién opera la infraestructura",{"_4673":41,"_26077":32,"_22045":38441,"_5":26338,"_10236":38418,"_1794":38442},[],"Punto de partida",{"_4673":42,"_26077":32,"_22045":38444,"_5":26338,"_10236":38418,"_1794":38445},[],"Kubernetes self-managed",{"_4673":43,"_26077":32,"_22045":38447,"_5":26338,"_10236":38418,"_1794":38448},[],"Producción, entornos regulados y despliegues personalizados",{"_4673":44,"_26077":32,"_22045":38450,"_5":26338,"_10236":38418,"_1794":38451},[],"Tu equipo",{"_4673":45,"_26077":32,"_22045":38453,"_5":26338,"_10236":38418,"_1794":38454},[],"Helm o Fastlane",{"_4673":46,"_26077":32,"_22045":38456,"_5":26338,"_10236":38418,"_1794":38457},[],"AWS Marketplace",{"_4673":47,"_26077":32,"_22045":38459,"_5":26338,"_10236":38418,"_1794":38460},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_4673":48,"_26077":32,"_22045":38462,"_5":26338,"_10236":38418,"_1794":38451},[],{"_4673":49,"_26077":32,"_22045":38464,"_5":26338,"_10236":38418,"_1794":38465},[],"Imagen preconfigurada en EC2",{"_4673":50,"_26077":32,"_22045":38467,"_5":26338,"_10236":38418,"_1794":38468},[],"SaaS",{"_4673":51,"_26077":32,"_22045":38470,"_5":26338,"_10236":38418,"_1794":38471},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_4673":52,"_26077":32,"_22045":38473,"_5":26338,"_10236":38418,"_1794":38474},[],"Lamassu",{"_4673":53,"_26077":32,"_22045":38476,"_5":26338,"_10236":38418,"_1794":38477},[],"Suscripción gestionada",{"_4673":54,"_26077":32,"_22045":38479,"_5":26338,"_10236":38418,"_1794":38480},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_4673":55,"_26077":32,"_22045":38482,"_5":26338,"_10236":38418,"_1794":38483},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_4673":56,"_26077":32,"_22045":38485,"_5":26338,"_10236":38418,"_1794":38486},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_4673":57,"_26077":32,"_22045":38488,"_5":26338,"_10236":38422,"_1794":38489},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_4673":58,"_26077":32,"_22045":38491,"_5":26338,"_10236":38426,"_1794":38492},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_4673":59,"_26077":59,"_5":26333,"_1794":38494,"_26346":38495,"_22045":38496,"_10236":59},"Utiliza Lamassu como SaaS",[38338,38339,38340],[],{"_4673":60,"_26077":59,"_22045":38498,"_5":26338,"_10236":59,"_1794":38499},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_4673":61,"_26077":59,"_5":26343,"_22045":38501,"_10236":38502,"_1794":38503},[],"/docs/pr-preview/pr-26/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_4673":62,"_26077":59,"_5":26343,"_22045":38505,"_10236":38506,"_1794":38507},[],"/docs/pr-preview/pr-26/deployment/saas#planes","Planes",{"_4673":63,"_26077":59,"_5":26343,"_22045":38509,"_10236":38510,"_1794":38511},[],"/docs/pr-preview/pr-26/deployment/saas#solicita-acceso","Solicita acceso",{"_4673":64,"_26077":59,"_22045":38513,"_5":26338,"_10236":59,"_1794":38514},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_4673":65,"_26077":59,"_22045":38516,"_5":26338,"_10236":38502,"_1794":38517},[],"Disponibilidad y mantenimiento de la plataforma.",{"_4673":66,"_26077":59,"_22045":38519,"_5":26338,"_10236":38502,"_1794":38520},[],"Copias de seguridad automáticas.",{"_4673":67,"_26077":59,"_22045":38522,"_5":26338,"_10236":38502,"_1794":38523},[],"Actualizaciones de versión.",{"_4673":68,"_26077":59,"_22045":38525,"_5":26338,"_10236":38502,"_1794":38526},[],"Soporte técnico y SLA según el plan contratado.",{"_4673":69,"_26077":59,"_22045":38528,"_5":26338,"_10236":38506,"_1794":38529},[],"Plan",{"_4673":70,"_26077":59,"_22045":38531,"_5":26338,"_10236":38506,"_1794":38532},[],"Dispositivos",{"_4673":71,"_26077":59,"_22045":38534,"_5":26338,"_10236":38506,"_1794":38535},[],"Soporte",{"_4673":72,"_26077":59,"_22045":38537,"_5":26338,"_10236":38506,"_1794":38538},[],"SLA",{"_4673":73,"_26077":59,"_22045":38540,"_5":26338,"_10236":38506,"_1794":38541},[],"Starter",{"_4673":74,"_26077":59,"_22045":38543,"_5":26338,"_10236":38506,"_1794":38544},[],"Hasta 1.000",{"_4673":75,"_26077":59,"_22045":38546,"_5":26338,"_10236":38506,"_1794":38547},[],"Email",{"_4673":76,"_26077":59,"_22045":38549,"_5":26338,"_10236":38506,"_1794":38550},[],"99,5 %",{"_4673":77,"_26077":59,"_22045":38552,"_5":26338,"_10236":38506,"_1794":38553},[],"Professional",{"_4673":78,"_26077":59,"_22045":38555,"_5":26338,"_10236":38506,"_1794":38556},[],"Hasta 10.000",{"_4673":79,"_26077":59,"_22045":38558,"_5":26338,"_10236":38506,"_1794":38559},[],"Email y chat",{"_4673":80,"_26077":59,"_22045":38561,"_5":26338,"_10236":38506,"_1794":38562},[],"99,9 %",{"_4673":81,"_26077":59,"_22045":38564,"_5":26338,"_10236":38506,"_1794":38565},[],"Enterprise",{"_4673":82,"_26077":59,"_22045":38567,"_5":26338,"_10236":38506,"_1794":38568},[],"Ilimitados",{"_4673":83,"_26077":59,"_22045":38570,"_5":26338,"_10236":38506,"_1794":38571},[],"Dedicado",{"_4673":84,"_26077":59,"_22045":38573,"_5":26338,"_10236":38506,"_1794":38574},[],"99,99 %",{"_4673":85,"_26077":59,"_22045":38576,"_5":26338,"_10236":38510,"_1794":38577},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_4673":86,"_26077":59,"_22045":38579,"_5":26338,"_10236":38510,"_1794":38580},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_4673":87,"_26077":87,"_5":26333,"_1794":38582,"_26346":38583,"_22045":38584,"_10236":87},"Fastlane",[38338,38339,38445],[],{"_4673":88,"_26077":87,"_22045":38586,"_5":26338,"_10236":87,"_1794":38587},[],"Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes",{"_4673":89,"_26077":87,"_5":26343,"_22045":38589,"_10236":38590,"_1794":38591},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#fastlane---despliegue-automatizado-en-kubernetes","Fastlane - Despliegue automatizado en Kubernetes",{"_4673":90,"_26077":87,"_5":26343,"_22045":38593,"_10236":38594,"_1794":38595},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#flags-de-línea-de-comandos","Flags de línea de comandos",{"_4673":91,"_26077":87,"_5":26343,"_22045":38597,"_10236":38598,"_1794":38599},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#detección-de-distribución-kubernetes","Detección de distribución Kubernetes",{"_4673":92,"_26077":87,"_5":26343,"_22045":38601,"_10236":38602,"_1794":38603},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#verificación-de-dependencias","Verificación de dependencias",{"_4673":93,"_26077":87,"_5":26343,"_22045":38605,"_10236":38606,"_1794":38607},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#addons-obligatorios-en-microk8s","Addons obligatorios en MicroK8s",{"_4673":94,"_26077":87,"_5":26343,"_22045":38609,"_10236":38610,"_1794":38611},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#gateway-api-y-envoy-gateway","Gateway API y Envoy Gateway",{"_4673":95,"_26077":87,"_5":26343,"_22045":38613,"_10236":38614,"_1794":38615},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#modo-interactivo-vs-no-interactivo","Modo interactivo vs no interactivo",{"_4673":96,"_26077":87,"_5":26343,"_22045":38617,"_10236":38618,"_1794":38619},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#modo-interactivo-por-defecto","Modo interactivo (por defecto)",{"_4673":97,"_26077":87,"_5":26343,"_22045":38621,"_10236":38622,"_1794":38623},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_4673":98,"_26077":87,"_5":26343,"_22045":38625,"_10236":38626,"_1794":38627},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#obtención-de-charts","Obtención de charts",{"_4673":99,"_26077":87,"_5":26343,"_22045":38629,"_10236":38630,"_1794":38631},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#instalación-de-componentes","Instalación de componentes",{"_4673":100,"_26077":87,"_5":26343,"_22045":38633,"_10236":38634,"_1794":38635},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_4673":101,"_26077":87,"_5":26343,"_22045":38637,"_10236":38638,"_1794":38639},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_4673":102,"_26077":87,"_5":26343,"_22045":38641,"_10236":38642,"_1794":38643},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_4673":103,"_26077":87,"_5":26343,"_22045":38645,"_10236":38646,"_1794":38647},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#observabilidad---otel","Observabilidad (`--otel`)",{"_4673":104,"_26077":87,"_5":26343,"_22045":38649,"_10236":38650,"_1794":38651},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#softhsm-y-nethsm---with-hsm","SoftHSM y NetHSM (`--with-hsm`)",{"_4673":105,"_26077":87,"_5":26343,"_22045":38653,"_10236":38654,"_1794":38655},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_4673":106,"_26077":87,"_5":26343,"_22045":38657,"_10236":38658,"_1794":38659},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#configuración-tls","Configuración TLS",{"_4673":107,"_26077":87,"_5":26343,"_22045":38661,"_10236":38662,"_1794":38663},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#certificado-externo","Certificado externo",{"_4673":108,"_26077":87,"_5":26343,"_22045":38665,"_10236":38666,"_1794":38667},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_4673":109,"_26077":87,"_5":26343,"_22045":38669,"_10236":38670,"_1794":38671},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_4673":110,"_26077":87,"_5":26343,"_22045":38673,"_10236":38674,"_1794":38675},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#uso-en-ci","Uso en CI",{"_4673":111,"_26077":87,"_5":26343,"_22045":38677,"_10236":38678,"_1794":38679},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#ejemplo-rápido","Ejemplo rápido",{"_4673":112,"_26077":87,"_5":26343,"_22045":38681,"_10236":38682,"_1794":38683},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#resumen","Resumen",{"_4673":113,"_26077":87,"_22045":38685,"_5":26338,"_10236":38590,"_1794":38686},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_4673":114,"_26077":87,"_22045":38688,"_5":26338,"_10236":38590,"_1794":38689},[],"La instalación incluye:",{"_4673":115,"_26077":87,"_22045":38691,"_5":26338,"_10236":38590,"_1794":38692},[],"PostgreSQL",{"_4673":116,"_26077":87,"_22045":38694,"_5":26338,"_10236":38590,"_1794":38695},[],"Keycloak",{"_4673":117,"_26077":87,"_22045":38697,"_5":26338,"_10236":38590,"_1794":38698},[],"RabbitMQ",{"_4673":118,"_26077":87,"_22045":38700,"_5":26338,"_10236":38590,"_1794":38701},[],"Chart Helm de Lamassu",{"_4673":119,"_26077":87,"_22045":38703,"_5":26338,"_10236":38590,"_1794":38704},[],"De forma opcional, también puede desplegar un backend HSM con soporte PKCS#11 (`--with-hsm`) y una pila de observabilidad con OpenTelemetry (`--otel`). El orden de ejecución es: PostgreSQL → Keycloak → RabbitMQ → observabilidad (opcional) → SoftHSM/NetHSM (opcional) → Lamassu → datos de ejemplo (opcional).",{"_4673":120,"_26077":87,"_22045":38706,"_5":26338,"_10236":38594,"_1794":38707},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_4673":121,"_26077":87,"_22045":38709,"_5":26338,"_10236":38594,"_1794":38710},[],"Flag",{"_4673":122,"_26077":87,"_22045":38712,"_5":26338,"_10236":38594,"_1794":38713},[],"Valor por defecto",{"_4673":123,"_26077":87,"_22045":38715,"_5":26338,"_10236":38594,"_1794":38716},[],"Descripción",{"_4673":124,"_26077":87,"_22045":38718,"_5":26338,"_10236":38594,"_1794":38719},[],"`-h`, `--help`",{"_4673":125,"_26077":87,"_22045":38721,"_5":26338,"_10236":38594,"_1794":3710},[],{"_4673":126,"_26077":87,"_22045":38723,"_5":26338,"_10236":38594,"_1794":38724},[],"Muestra la ayuda y finaliza",{"_4673":127,"_26077":87,"_22045":38726,"_5":26338,"_10236":38594,"_1794":38727},[],"`-c`, `--context`",{"_4673":128,"_26077":87,"_22045":38729,"_5":26338,"_10236":38594,"_1794":3710},[],{"_4673":129,"_26077":87,"_22045":38731,"_5":26338,"_10236":38594,"_1794":38732},[],"Contexto Kubernetes a usar por `kubectl` y `helm`; debe existir en `kubectl config get-contexts`",{"_4673":130,"_26077":87,"_22045":38734,"_5":26338,"_10236":38594,"_1794":38735},[],"`-n`, `--non-interactive`",{"_4673":131,"_26077":87,"_22045":38737,"_5":26338,"_10236":38594,"_1794":38738},[],"`false`",{"_4673":132,"_26077":87,"_22045":38740,"_5":26338,"_10236":38594,"_1794":38741},[],"Omite prompts y genera credenciales aleatorias para Keycloak, PostgreSQL y RabbitMQ",{"_4673":133,"_26077":87,"_22045":38743,"_5":26338,"_10236":38594,"_1794":38744},[],"`-ns`, `--namespace`",{"_4673":134,"_26077":87,"_22045":38746,"_5":26338,"_10236":38594,"_1794":38747},[],"`lamassu-dev`",{"_4673":135,"_26077":87,"_22045":38749,"_5":26338,"_10236":38594,"_1794":38750},[],"Namespace Kubernetes donde se despliegan los recursos",{"_4673":136,"_26077":87,"_22045":38752,"_5":26338,"_10236":38594,"_1794":38753},[],"`-d`, `--domain`",{"_4673":137,"_26077":87,"_22045":38755,"_5":26338,"_10236":38594,"_1794":38756},[],"`dev.lamassu.io`",{"_4673":138,"_26077":87,"_22045":38758,"_5":26338,"_10236":38594,"_1794":38759},[],"Dominio usado para endpoint y certificados TLS",{"_4673":139,"_26077":87,"_22045":38761,"_5":26338,"_10236":38594,"_1794":38762},[],"`-v`, `--version`",{"_4673":140,"_26077":87,"_22045":38764,"_5":26338,"_10236":38594,"_1794":38765},[],"`latest`",{"_4673":141,"_26077":87,"_22045":38767,"_5":26338,"_10236":38594,"_1794":38768},[],"Versión del chart Helm de Lamassu",{"_4673":142,"_26077":87,"_22045":38770,"_5":26338,"_10236":38594,"_1794":38771},[],"`--https-port`",{"_4673":143,"_26077":87,"_22045":38773,"_5":26338,"_10236":38594,"_1794":38774},[],"`443`",{"_4673":144,"_26077":87,"_22045":38776,"_5":26338,"_10236":38594,"_1794":38777},[],"Puerto HTTPS del gateway",{"_4673":145,"_26077":87,"_22045":38779,"_5":26338,"_10236":38594,"_1794":38780},[],"`--http-port`",{"_4673":146,"_26077":87,"_22045":38782,"_5":26338,"_10236":38594,"_1794":38783},[],"`80`",{"_4673":147,"_26077":87,"_22045":38785,"_5":26338,"_10236":38594,"_1794":38786},[],"Puerto HTTP del gateway",{"_4673":148,"_26077":87,"_22045":38788,"_5":26338,"_10236":38594,"_1794":38789},[],"`--tls-crt`",{"_4673":149,"_26077":87,"_22045":38791,"_5":26338,"_10236":38594,"_1794":3710},[],{"_4673":150,"_26077":87,"_22045":38793,"_5":26338,"_10236":38594,"_1794":38794},[],"Ruta al certificado TLS (PEM) para comunicaciones downstream",{"_4673":151,"_26077":87,"_22045":38796,"_5":26338,"_10236":38594,"_1794":38797},[],"`--tls-key`",{"_4673":152,"_26077":87,"_22045":38799,"_5":26338,"_10236":38594,"_1794":3710},[],{"_4673":153,"_26077":87,"_22045":38801,"_5":26338,"_10236":38594,"_1794":38802},[],"Ruta a la clave privada TLS (PEM) para comunicaciones downstream",{"_4673":154,"_26077":87,"_22045":38804,"_5":26338,"_10236":38594,"_1794":38805},[],"`-l`, `--local-chart-path`",{"_4673":155,"_26077":87,"_22045":38807,"_5":26338,"_10236":38594,"_1794":3710},[],{"_4673":156,"_26077":87,"_22045":38809,"_5":26338,"_10236":38594,"_1794":38810},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_4673":157,"_26077":87,"_22045":38812,"_5":26338,"_10236":38594,"_1794":38813},[],"`-ip`, `--gateway-ip`",{"_4673":158,"_26077":87,"_22045":38815,"_5":26338,"_10236":38594,"_1794":3710},[],{"_4673":159,"_26077":87,"_22045":38817,"_5":26338,"_10236":38594,"_1794":38818},[],"Dirección IP que se fija como dirección del Envoy Gateway (sobrescribe las IPs detectadas del host)",{"_4673":160,"_26077":87,"_22045":38820,"_5":26338,"_10236":38594,"_1794":38821},[],"`--otel`",{"_4673":161,"_26077":87,"_22045":38823,"_5":26338,"_10236":38594,"_1794":38738},[],{"_4673":162,"_26077":87,"_22045":38825,"_5":26338,"_10236":38594,"_1794":38826},[],"Despliega VictoriaLogs, VictoriaTraces, Jaeger y un collector OTel, y configura OpenTelemetry en todos los servicios de Lamassu",{"_4673":163,"_26077":87,"_22045":38828,"_5":26338,"_10236":38594,"_1794":38829},[],"`--sample-data`",{"_4673":164,"_26077":87,"_22045":38831,"_5":26338,"_10236":38594,"_1794":38738},[],{"_4673":165,"_26077":87,"_22045":38833,"_5":26338,"_10236":38594,"_1794":38834},[],"Puebla Lamassu con datos de ejemplo (CAs, perfiles, certificados, DMS y dispositivos) tras la instalación",{"_4673":166,"_26077":87,"_22045":38836,"_5":26338,"_10236":38594,"_1794":38837},[],"`--softhsm-chart-path`",{"_4673":167,"_26077":87,"_22045":38839,"_5":26338,"_10236":38594,"_1794":38840},[],"`./charts/softhsm`",{"_4673":168,"_26077":87,"_22045":38842,"_5":26338,"_10236":38594,"_1794":38843},[],"Ruta al chart local de SoftHSM",{"_4673":169,"_26077":87,"_22045":38845,"_5":26338,"_10236":38594,"_1794":38846},[],"`--with-hsm`",{"_4673":170,"_26077":87,"_22045":38848,"_5":26338,"_10236":38594,"_1794":38738},[],{"_4673":171,"_26077":87,"_22045":38850,"_5":26338,"_10236":38594,"_1794":38851},[],"Instala SoftHSM y NetHSM, y configura el KMS de Lamassu para usar PKCS#11 (NetHSM se omite en clústeres ARM: imagen solo amd64)",{"_4673":172,"_26077":87,"_22045":38853,"_5":26338,"_10236":38594,"_1794":38854},[],"Cuando se indica `-c/--context`, tiene precedencia sobre la detección de MicroK8s y todas las llamadas a `kubectl` y `helm` se ejecutan con ese contexto.",{"_4673":173,"_26077":87,"_22045":38856,"_5":26338,"_10236":38598,"_1794":38857},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_4673":174,"_26077":87,"_22045":38859,"_5":26338,"_10236":38598,"_1794":38860},[],"`microk8s`",{"_4673":175,"_26077":87,"_22045":38862,"_5":26338,"_10236":38598,"_1794":38863},[],"`k3s`",{"_4673":176,"_26077":87,"_22045":38865,"_5":26338,"_10236":38598,"_1794":38866},[],"`kind`",{"_4673":177,"_26077":87,"_22045":38868,"_5":26338,"_10236":38598,"_1794":38869},[],"Kubernetes estándar",{"_4673":178,"_26077":87,"_22045":38871,"_5":26338,"_10236":38598,"_1794":38872},[],"Comportamientos específicos:",{"_4673":179,"_26077":87,"_22045":38874,"_5":26338,"_10236":38598,"_1794":38875},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_4673":180,"_26077":87,"_22045":38877,"_5":26338,"_10236":38598,"_1794":38878},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_4673":181,"_26077":87,"_22045":38880,"_5":26338,"_10236":38602,"_1794":38881},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada:",{"_4673":182,"_26077":87,"_22045":38883,"_5":26338,"_10236":38602,"_1794":38884},[],"`yq` (siempre)",{"_4673":183,"_26077":87,"_22045":38886,"_5":26338,"_10236":38602,"_1794":38887},[],"`jq` (solo con `--sample-data`)",{"_4673":184,"_26077":87,"_22045":38889,"_5":26338,"_10236":38602,"_1794":38890},[],"`ssh-keygen` (solo con `--with-hsm`)",{"_4673":185,"_26077":87,"_22045":38892,"_5":26338,"_10236":38602,"_1794":38893},[],"`kubectl` y `helm` en `k3s`, `kind` y Kubernetes estándar; `microk8s kubectl` y `microk8s helm` en MicroK8s",{"_4673":186,"_26077":87,"_22045":38895,"_5":26338,"_10236":38602,"_1794":38896},[],"Si se indica `-c/--context` fuera de MicroK8s, el script comprueba que el contexto exista en `kubectl config get-contexts` y finaliza con error en caso contrario.",{"_4673":187,"_26077":87,"_22045":38898,"_5":26338,"_10236":38606,"_1794":38899},[],"Se valida que estén habilitados:",{"_4673":188,"_26077":87,"_22045":38901,"_5":26338,"_10236":38606,"_1794":38902},[],"`helm`",{"_4673":189,"_26077":87,"_22045":38904,"_5":26338,"_10236":38606,"_1794":38905},[],"`hostpath-storage`",{"_4673":190,"_26077":87,"_22045":38907,"_5":26338,"_10236":38606,"_1794":38908},[],"`dns`",{"_4673":191,"_26077":87,"_22045":38910,"_5":26338,"_10236":38606,"_1794":38911},[],"`cert-manager`",{"_4673":192,"_26077":87,"_22045":38913,"_5":26338,"_10236":38610,"_1794":38914},[],"En todas las distribuciones, el script garantiza el soporte de Gateway API:",{"_4673":193,"_26077":87,"_22045":38916,"_5":26338,"_10236":38610,"_1794":38917},[],"Aplica los CRD de Envoy Gateway y de Gateway API (canal `experimental`) con el chart `oci://docker.io/envoyproxy/gateway-crds-helm`, versión `v1.8.0`, mediante `kubectl apply --server-side --force-conflicts`.",{"_4673":194,"_26077":87,"_22045":38919,"_5":26338,"_10236":38610,"_1794":38920},[],"Si ya existe el release `eg` en el namespace `envoy-gateway-system`, lo actualiza; si no existe, lo instala (`oci://docker.io/envoyproxy/gateway-helm`, versión `v1.8.0`).",{"_4673":195,"_26077":87,"_22045":38922,"_5":26338,"_10236":38610,"_1794":38923},[],"Crea el `GatewayClass` `eg` si no existe.",{"_4673":196,"_26077":87,"_22045":38925,"_5":26338,"_10236":38610,"_1794":38926},[],"La versión de referencia es Envoy Gateway `v1.8.0`, requisito de la autorización externa que configura el chart (ver Requisitos previos).",{"_4673":197,"_26077":87,"_22045":38928,"_5":26338,"_10236":38618,"_1794":38929},[],"La función `request_config_data` solicita:",{"_4673":198,"_26077":87,"_22045":38931,"_5":26338,"_10236":38618,"_1794":38932},[],"Dominio Lamassu",{"_4673":199,"_26077":87,"_22045":38934,"_5":26338,"_10236":38618,"_1794":38935},[],"Usuario y contraseña admin PostgreSQL",{"_4673":200,"_26077":87,"_22045":38937,"_5":26338,"_10236":38618,"_1794":38938},[],"Usuario y contraseña admin RabbitMQ",{"_4673":201,"_26077":87,"_22045":38940,"_5":26338,"_10236":38618,"_1794":38941},[],"Usuario y contraseña admin Keycloak",{"_4673":202,"_26077":87,"_22045":38943,"_5":26338,"_10236":38618,"_1794":38944},[],"Namespace Kubernetes",{"_4673":203,"_26077":87,"_22045":38946,"_5":26338,"_10236":38622,"_1794":38947},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_4673":204,"_26077":87,"_22045":38949,"_5":26338,"_10236":38622,"_1794":38950},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_4673":205,"_26077":87,"_22045":38952,"_5":26338,"_10236":38626,"_1794":38953},[],"El script siempre descarga los charts desde repositorios remotos: los charts de PostgreSQL, Keycloak y RabbitMQ desde registros OCI públicos, y el chart de Lamassu desde el repositorio `http://www.lamassu.io/lamassu-helm/` (o desde la ruta local indicada con `-l/--local-chart-path`). No existe modo offline; si el clúster no tiene acceso de red a estos orígenes, usa un despliegue manual del chart con `values.yaml` propio.",{"_4673":206,"_26077":87,"_22045":38955,"_5":26338,"_10236":38634,"_1794":38956},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`, versión `0.19.5` (imagen PostgreSQL `18.4`)",{"_4673":207,"_26077":87,"_22045":38958,"_5":26338,"_10236":38634,"_1794":38959},[],"Release: `postgres`",{"_4673":208,"_26077":87,"_22045":38961,"_5":26338,"_10236":38634,"_1794":38962},[],"`fullnameOverride: \"postgresql\"`",{"_4673":209,"_26077":87,"_22045":38964,"_5":26338,"_10236":38634,"_1794":38965},[],"El script SQL de inicialización crea las bases de datos `auth` (Keycloak), `pki` (servicios de Lamassu), `authz` (autorización) y `wfx` (workflow), y dentro de la base de datos `pki` crea los esquemas `alerts`, `ca`, `va`, `devicemanager`, `dmsmanager` y `kms`.",{"_4673":210,"_26077":87,"_22045":38967,"_5":26338,"_10236":38638,"_1794":38968},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`, versión `0.21.9` (imagen `keycloak/keycloak:26.6.2`)",{"_4673":211,"_26077":87,"_22045":38970,"_5":26338,"_10236":38638,"_1794":38971},[],"Release: `auth`, con `service.httpPort: 80`",{"_4673":212,"_26077":87,"_22045":38973,"_5":26338,"_10236":38638,"_1794":38974},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_4673":213,"_26077":87,"_22045":38976,"_5":26338,"_10236":38638,"_1794":38977},[],"`httpRelativePath: /auth`",{"_4673":214,"_26077":87,"_22045":38979,"_5":26338,"_10236":38638,"_1794":38980},[],"`proxyHeaders: xforwarded`",{"_4673":215,"_26077":87,"_22045":38982,"_5":26338,"_10236":38638,"_1794":38983},[],"Variables adicionales: `KC_HOSTNAME_STRICT=false`, `KC_HEALTH_ENABLED=true`, proveedor de lookup de certificados X.509 `envoy` y access log HTTP activado",{"_4673":216,"_26077":87,"_22045":38985,"_5":26338,"_10236":38638,"_1794":38986},[],"Configuración automática del realm `lamassu`:",{"_4673":217,"_26077":87,"_22045":38988,"_5":26338,"_10236":38638,"_1794":38989},[],"Tema de inicio de sesión: `lamassu-theme-v3` (JAR `lamassu-theme` 3.0.0 descargado por un init container desde `github.com/lamassuiot/keycloak-theme`)",{"_4673":218,"_26077":87,"_22045":38991,"_5":26338,"_10236":38638,"_1794":38992},[],"Rol: `pki-admin`",{"_4673":219,"_26077":87,"_22045":38994,"_5":26338,"_10236":38638,"_1794":38995},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio en el primer acceso)",{"_4673":220,"_26077":87,"_22045":38997,"_5":26338,"_10236":38638,"_1794":38998},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_4673":221,"_26077":87,"_22045":39000,"_5":26338,"_10236":38638,"_1794":39001},[],"Con `--sample-data`, el realm incorpora además la cuenta de servicio `service-account-sample-data` (cliente confidencial `sample-data` con su secret) con el rol `pki-admin`.",{"_4673":222,"_26077":87,"_22045":39003,"_5":26338,"_10236":38642,"_1794":39004},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`, versión `0.21.4` (imagen RabbitMQ `4.3.0`)",{"_4673":223,"_26077":87,"_22045":39006,"_5":26338,"_10236":38642,"_1794":39007},[],"Release: `rabbitmq`",{"_4673":224,"_26077":87,"_22045":39009,"_5":26338,"_10236":38642,"_1794":39010},[],"`fullnameOverride: \"rabbitmq\"`",{"_4673":225,"_26077":87,"_22045":39012,"_5":26338,"_10236":38642,"_1794":39013},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_4673":226,"_26077":87,"_22045":39015,"_5":26338,"_10236":38646,"_1794":39016},[],"Con `--otel`, antes de Lamassu se despliega una pila de trazas y logs en el mismo namespace:",{"_4673":227,"_26077":87,"_22045":39018,"_5":26338,"_10236":38646,"_1794":39019},[],"**VictoriaLogs** (`vm/victoria-logs-single`, release `victoria-logs`) y **VictoriaTraces** (`vm/victoria-traces-single`, release `victoria-traces`), sin volumen persistente.",{"_4673":228,"_26077":87,"_22045":39021,"_5":26338,"_10236":38646,"_1794":39022},[],"**Jaeger** (`jaegertracing/jaeger`, release `jaeger`) con receptor OTLP y UI en `/infra/jaeger`.",{"_4673":229,"_26077":87,"_22045":39024,"_5":26338,"_10236":38646,"_1794":39025},[],"**Collector OTel** (`open-telemetry/opentelemetry-collector`, release `otel-collector`) que recibe OTLP de los servicios de Lamassu y envía trazas a Jaeger y a VictoriaTraces.",{"_4673":230,"_26077":87,"_22045":39027,"_5":26338,"_10236":38646,"_1794":39028},[],"Además, se activa `observability.enabled: true` en el `values` de Lamassu. Las UIs quedan expuestas a través del gateway en las rutas `/infra/logs`, `/infra/traces` y `/infra/jaeger` (ver `observability.routes` en `values.yaml`).",{"_4673":231,"_26077":87,"_22045":39030,"_5":26338,"_10236":38650,"_1794":39031},[],"La opción `--with-hsm` configura el KMS de Lamassu para usar PKCS#11. El flujo tiene tres pasos:",{"_4673":232,"_26077":87,"_22045":39033,"_5":26338,"_10236":38650,"_1794":39034},[],"**Preparación de credenciales SSH**: el script genera un par de claves SSH ed25519 con `ssh-keygen` y lo usa para el reenvío del socket PKCS#11.",{"_4673":233,"_26077":87,"_22045":39036,"_5":26338,"_10236":38650,"_1794":39037},[],"**Instalación del chart de SoftHSM**: se despliega el release `hsm` desde la ruta indicada en `--softhsm-chart-path` (por defecto `./charts/softhsm`), con los PIN, slot y token preconfigurados y la clave pública SSH autorizada.",{"_4673":234,"_26077":87,"_22045":39039,"_5":26338,"_10236":38650,"_1794":39040},[],"**Configuración de Lamassu**: se crea el secret `kms-pkcs11-sidecar-ssh-key` con la clave privada y se fusionan en el `values` de Lamassu tres bloques: `kms.pkcs11Sidecar` (sidecar `p11-kit-ssh-sidecar` que expone el socket PKCS#11 en un volumen compartido), `kms.pkcs11Modules` (init containers que preparan los módulos PKCS#11 en volúmenes compartidos: `p11-kit-client` siempre y `nethsm` solo cuando se despliega NetHSM) y `kms.cryptoEngines` (motor `pkcs11-softhsm` como motor por defecto, `pkcs11-nethsm` si NetHSM está habilitado y `filesystem-1`).",{"_4673":235,"_26077":87,"_22045":39042,"_5":26338,"_10236":38650,"_1794":39043},[],"NetHSM solo se despliega si todos los nodos del clúster admiten la arquitectura `amd64` (su imagen no existe para ARM). Antes de instalar, `detect_nethsm_support` consulta la arquitectura de cada nodo con `kubectl get nodes`:",{"_4673":236,"_26077":87,"_22045":39045,"_5":26338,"_10236":38650,"_1794":39046},[],"Clúster solo ARM (o sin ningún nodo `amd64`): se omite NetHSM y se despliega solo SoftHSM/PKCS#11.",{"_4673":237,"_26077":87,"_22045":39048,"_5":26338,"_10236":38650,"_1794":39049},[],"Clúster mixto amd64 + ARM: NetHSM se restringe a los nodos amd64.",{"_4673":238,"_26077":87,"_22045":39051,"_5":26338,"_10236":38650,"_1794":39052},[],"Arquitectura desconocida o no soportada: el script aborta sin desplegar NetHSM.",{"_4673":239,"_26077":87,"_22045":39054,"_5":26338,"_10236":38650,"_1794":39055},[],"Para detalles del sidecar PKCS#11 y sus requisitos de Kubernetes, ver SoftHSM como complemento opcional.",{"_4673":240,"_26077":87,"_22045":39057,"_5":26338,"_10236":38654,"_1794":39058},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_4673":241,"_26077":87,"_22045":39060,"_5":26338,"_10236":38654,"_1794":39061},[],"Configuraciones principales:",{"_4673":242,"_26077":87,"_22045":39063,"_5":26338,"_10236":38654,"_1794":39064},[],"PostgreSQL: host `postgresql`, puerto `5432`; las mismas credenciales se reutilizan en `services.authz.credentials` para las bases de datos `pki` y `authz`",{"_4673":243,"_26077":87,"_22045":39066,"_5":26338,"_10236":38654,"_1794":39067},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_4673":244,"_26077":87,"_22045":39069,"_5":26338,"_10236":38654,"_1794":39070},[],"CA: motor criptográfico `fs-1` de tipo `filesystem` (`/crypto/fs`); `--with-hsm` no lo modifica, reconfigura el KMS (`services.kms.cryptoEngines`), que pasa a usar PKCS#11 con `pkcs11-softhsm` como motor por defecto (y `pkcs11-nethsm` si se despliega NetHSM), conservando `filesystem-1`",{"_4673":245,"_26077":87,"_22045":39072,"_5":26338,"_10236":38654,"_1794":39073},[],"Autorización: principales bootstrap `oidc:lamassu` con la política `SUPER ADMIN` (claim `preferred_username=lamassu`); con `--sample-data` se añade `oidc:service-account-sample-data`",{"_4673":246,"_26077":87,"_22045":39075,"_5":26338,"_10236":38654,"_1794":39076},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>.svc.cluster.local/auth/realms/lamassu/protocol/openid-connect/certs`",{"_4673":247,"_26077":87,"_22045":39078,"_5":26338,"_10236":38654,"_1794":39079},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:80`",{"_4673":248,"_26077":87,"_22045":39081,"_5":26338,"_10236":38654,"_1794":39082},[],"Direcciones de gateway: la IP indicada con `-ip/--gateway-ip` o, en su defecto, las IP(s) detectadas con `hostname -I`",{"_4673":249,"_26077":87,"_22045":39084,"_5":26338,"_10236":38654,"_1794":39085},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_4673":250,"_26077":87,"_22045":39087,"_5":26338,"_10236":38654,"_1794":39088},[],"Dominios CA: valor de `--domain`",{"_4673":251,"_26077":87,"_22045":39090,"_5":26338,"_10236":38654,"_1794":39091},[],"Observabilidad: con `--otel`, `observability.enabled: true`",{"_4673":252,"_26077":87,"_22045":39093,"_5":26338,"_10236":38654,"_1794":39094},[],"Si no se usa `-l/--local-chart-path`, el script añade el repositorio Helm:",{"_4673":253,"_26077":87,"_22045":39096,"_5":26338,"_10236":38654,"_1794":39097},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_4673":254,"_26077":87,"_22045":39099,"_5":26338,"_10236":38654,"_1794":39100},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_4673":255,"_26077":87,"_22045":39102,"_5":26338,"_10236":38662,"_1794":39103},[],"Si se proporcionan:",{"_4673":256,"_26077":87,"_22045":39105,"_5":26338,"_10236":38662,"_1794":38789},[],{"_4673":257,"_26077":87,"_22045":39107,"_5":26338,"_10236":38662,"_1794":38797},[],{"_4673":258,"_26077":87,"_22045":39109,"_5":26338,"_10236":38662,"_1794":39110},[],"Se crea un secret Kubernetes:",{"_4673":259,"_26077":87,"_22045":39112,"_5":26338,"_10236":38662,"_1794":39113},[],"`downstream-provided-crt`",{"_4673":260,"_26077":87,"_22045":39115,"_5":26338,"_10236":38662,"_1794":39116},[],"Y se configura:",{"_4673":261,"_26077":87,"_22045":39118,"_5":26338,"_10236":38666,"_1794":39119},[],"Si no se proporciona certificado:",{"_4673":262,"_26077":87,"_22045":39121,"_5":26338,"_10236":38666,"_1794":39122},[],"Con `issuer: \"\"`, el chart deja que el despliegue cree un `Issuer` self-signed con nombre dependiente del release (`lamassu-downstream-ca-selfsigned-issuer` con el release por defecto `lamassu`). El script también configura el `Certificate` con el common name y las direcciones IP del gateway.",{"_4673":263,"_26077":87,"_22045":39124,"_5":26338,"_10236":38666,"_1794":39125},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_4673":264,"_26077":87,"_22045":39127,"_5":26338,"_10236":38670,"_1794":39128},[],"En caso de éxito, se muestra:",{"_4673":265,"_26077":87,"_22045":39130,"_5":26338,"_10236":38670,"_1794":39131},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_4673":266,"_26077":87,"_22045":39133,"_5":26338,"_10236":38670,"_1794":39134},[],"Credenciales iniciales: `lamassu / lamassu`",{"_4673":267,"_26077":87,"_22045":39136,"_5":26338,"_10236":38670,"_1794":39137},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_4673":268,"_26077":87,"_22045":39139,"_5":26338,"_10236":38670,"_1794":39140},[],"Credenciales admin de Keycloak",{"_4673":269,"_26077":87,"_22045":39142,"_5":26338,"_10236":38670,"_1794":39143},[],"El usuario `lamassu` se crea con:",{"_4673":270,"_26077":87,"_22045":39145,"_5":26338,"_10236":38670,"_1794":39146},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_4673":271,"_26077":87,"_22045":39148,"_5":26338,"_10236":38670,"_1794":39149},[],"Con `--sample-data`, tras instalar Lamassu el script ejecuta `sample-data.sh` contra `https://<DOMAIN>` usando el cliente confidencial `sample-data` y su secret, y puebla el sistema con CAs, perfiles, certificados, DMS y dispositivos de ejemplo.",{"_4673":272,"_26077":87,"_22045":39151,"_5":26338,"_10236":38670,"_1794":39152},[],"Fastlane también provisiona un principal de autorización `oidc:lamassu` que coincide con el claim `preferred_username=lamassu` y le concede la política `SUPER ADMIN`. Si activas los datos de ejemplo, crea además el principal independiente `oidc:service-account-sample-data` para la cuenta de servicio.",{"_4673":273,"_26077":87,"_22045":39154,"_5":26338,"_10236":38670,"_1794":39155},[],"Este bootstrap está pensado para laboratorio, demos y CI. En producción, sustituye el principal por un rol o grupo administrado en tu proveedor OIDC y sigue Control de acceso.",{"_4673":274,"_26077":87,"_22045":39157,"_5":26338,"_10236":38674,"_1794":39158},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_4673":275,"_26077":87,"_22045":39160,"_5":26338,"_10236":38674,"_1794":39161},[],"El chart incluye una prueba de conectividad con el hook `helm test` (`<release>-connectivity-test`), que verifica los endpoints `/health` de `ca`, `dms-manager`, `device-manager` y `va`, y comprueba que la UI responde con el título `LamassuIoT Certificate Manager`.",{"_4673":276,"_26077":87,"_22045":39163,"_5":26338,"_10236":38674,"_1794":39164},[],"Ejemplo:",{"_4673":277,"_26077":87,"_22045":39166,"_5":26338,"_10236":38674,"_1794":39167},[],"En este escenario:",{"_4673":278,"_26077":87,"_22045":39169,"_5":26338,"_10236":38674,"_1794":39170},[],"`-n`: modo no interactivo",{"_4673":279,"_26077":87,"_22045":39172,"_5":26338,"_10236":38674,"_1794":39173},[],"`-ns`: namespace específico",{"_4673":280,"_26077":87,"_22045":39175,"_5":26338,"_10236":38674,"_1794":39176},[],"`-d`: dominio de CI",{"_4673":281,"_26077":87,"_22045":39178,"_5":26338,"_10236":38674,"_1794":39179},[],"`-l`: chart local",{"_4673":282,"_26077":87,"_22045":39181,"_5":26338,"_10236":38682,"_1794":39182},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_4673":283,"_26077":87,"_22045":39184,"_5":26338,"_10236":38682,"_1794":39185},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos y pipelines de CI; para despliegues productivos con requisitos propios (TLS corporativo, HSM, OIDC gestionado), usa un despliegue manual del chart con un `values.yaml` específico.",{"_4673":284,"_26077":284,"_5":26333,"_1794":38445,"_26346":39187,"_22045":39188,"_10236":284},[38338,38339,38445],[],{"_4673":285,"_26077":284,"_22045":39190,"_5":26338,"_10236":284,"_1794":39191},[],"Despliega Lamassu en tu propio clúster Kubernetes con Helm o Fastlane.",{"_4673":286,"_26077":284,"_5":26343,"_22045":39193,"_10236":39194,"_1794":39195},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_4673":287,"_26077":284,"_5":26343,"_22045":39197,"_10236":39198,"_1794":39199},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#quickstart","Quickstart",{"_4673":288,"_26077":284,"_5":26343,"_22045":39201,"_10236":39202,"_1794":39203},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#qué-se-despliega","Qué se despliega",{"_4673":289,"_26077":284,"_5":26343,"_22045":39205,"_10236":39206,"_1794":39207},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#requisitos-previos","Requisitos previos",{"_4673":290,"_26077":284,"_5":26343,"_22045":39209,"_10236":39210,"_1794":39211},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#opciones-de-despliegue","Opciones de despliegue",{"_4673":291,"_26077":284,"_5":26343,"_22045":39213,"_10236":39214,"_1794":39215},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_4673":292,"_26077":284,"_5":26343,"_22045":39217,"_10236":39218,"_1794":39219},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_4673":293,"_26077":284,"_5":26343,"_22045":39221,"_10236":39222,"_1794":39223},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#arquitectura","Arquitectura",{"_4673":294,"_26077":284,"_5":26343,"_22045":39225,"_10236":39226,"_1794":39227},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#instalación-manual-con-helm","Instalación manual con Helm",{"_4673":295,"_26077":284,"_5":26343,"_22045":39229,"_10236":39230,"_1794":39231},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_4673":296,"_26077":284,"_5":26343,"_22045":39233,"_10236":39234,"_1794":39235},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_4673":297,"_26077":284,"_5":26343,"_22045":39237,"_10236":39238,"_1794":39239},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_4673":298,"_26077":284,"_5":26343,"_22045":39241,"_10236":39242,"_1794":39243},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#verificación-del-despliegue","Verificación del despliegue",{"_4673":299,"_26077":284,"_5":26343,"_22045":39245,"_10236":39246,"_1794":39247},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#repositorio-helm","Repositorio Helm",{"_4673":300,"_26077":284,"_5":26343,"_22045":39249,"_10236":39250,"_1794":39251},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_4673":301,"_26077":284,"_5":26343,"_22045":39253,"_10236":39254,"_1794":39255},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#actualizar-desde-38x","Actualizar desde 3.8.x",{"_4673":302,"_26077":284,"_5":26343,"_22045":39257,"_10236":39258,"_1794":39259},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#versionado-y-migraciones","Versionado y migraciones",{"_4673":303,"_26077":284,"_22045":39261,"_5":26338,"_10236":39194,"_1794":39262},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_4673":304,"_26077":284,"_22045":39264,"_5":26338,"_10236":39194,"_1794":39265},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_4673":305,"_26077":284,"_22045":39267,"_5":26338,"_10236":39194,"_1794":39268},[],"el chart principal de Lamassu",{"_4673":306,"_26077":284,"_22045":39270,"_5":26338,"_10236":39194,"_1794":39271},[],"un chart auxiliar de SoftHSM",{"_4673":307,"_26077":284,"_22045":39273,"_5":26338,"_10236":39194,"_1794":39274},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_4673":308,"_26077":284,"_22045":39276,"_5":26338,"_10236":39198,"_1794":39277},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_4673":309,"_26077":284,"_22045":39279,"_5":26338,"_10236":39198,"_1794":39280},[],"Ese flujo:",{"_4673":310,"_26077":284,"_22045":39282,"_5":26338,"_10236":39198,"_1794":39283},[],"crea o reutiliza el namespace indicado",{"_4673":311,"_26077":284,"_22045":39285,"_5":26338,"_10236":39198,"_1794":39286},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_4673":312,"_26077":284,"_22045":39288,"_5":26338,"_10236":39198,"_1794":39289},[],"despliega el chart de Lamassu",{"_4673":313,"_26077":284,"_22045":39291,"_5":26338,"_10236":39198,"_1794":39292},[],"deja la UI expuesta en `https://<dominio>`",{"_4673":314,"_26077":284,"_22045":39294,"_5":26338,"_10236":39198,"_1794":39295},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_4673":315,"_26077":284,"_22045":39297,"_5":26338,"_10236":39202,"_1794":39298},[],"El chart principal `charts/lamassu`, actualmente en la versión `4.0.0`, despliega estos componentes:",{"_4673":316,"_26077":284,"_22045":39300,"_5":26338,"_10236":39202,"_1794":39301},[],"`ui`",{"_4673":317,"_26077":284,"_22045":39303,"_5":26338,"_10236":39202,"_1794":39304},[],"`ca`",{"_4673":318,"_26077":284,"_22045":39306,"_5":26338,"_10236":39202,"_1794":39307},[],"`va`",{"_4673":319,"_26077":284,"_22045":39309,"_5":26338,"_10236":39202,"_1794":39310},[],"`kms`",{"_4673":320,"_26077":284,"_22045":39312,"_5":26338,"_10236":39202,"_1794":39313},[],"`device-manager`",{"_4673":321,"_26077":284,"_22045":39315,"_5":26338,"_10236":39202,"_1794":39316},[],"`dms-manager`",{"_4673":322,"_26077":284,"_22045":39318,"_5":26338,"_10236":39202,"_1794":39319},[],"`alerts`",{"_4673":323,"_26077":284,"_22045":39321,"_5":26338,"_10236":39202,"_1794":39322},[],"`authz`, el servicio de autorización que decide qué peticiones del Gateway están permitidas",{"_4673":324,"_26077":284,"_22045":39324,"_5":26338,"_10236":39202,"_1794":39325},[],"`wfx`, el servicio de flujos de trabajo Siemens WFX, expuesto bajo `/api/wfx/`",{"_4673":325,"_26077":284,"_22045":39327,"_5":26338,"_10236":39202,"_1794":39328},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_4673":326,"_26077":284,"_22045":39330,"_5":26338,"_10236":39202,"_1794":39331},[],"job de migraciones de base de datos",{"_4673":327,"_26077":284,"_22045":39333,"_5":26338,"_10236":39206,"_1794":39334},[],"Clúster Kubernetes `1.24+`. El chart declara `kubeVersion: \">=1.24.0-0\"`, por lo que Helm rechaza la instalación en versiones anteriores. La integración con HSM mediante `services.kms.pkcs11Sidecar` requiere además Kubernetes `1.29+`, por su dependencia de los sidecars nativos de init container.",{"_4673":328,"_26077":284,"_22045":39336,"_5":26338,"_10236":39206,"_1794":39337},[],"`kubectl` configurado con acceso al clúster",{"_4673":329,"_26077":284,"_22045":39339,"_5":26338,"_10236":39206,"_1794":39340},[],"Helm `3.2.0+`",{"_4673":330,"_26077":284,"_22045":39342,"_5":26338,"_10236":39206,"_1794":39343},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_4673":331,"_26077":284,"_22045":39345,"_5":26338,"_10236":39206,"_1794":39346},[],"`Envoy Gateway v1.8.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress. La autorización externa (`auth.externalAuthorization.path`) exige esta versión.",{"_4673":332,"_26077":284,"_22045":39348,"_5":26338,"_10236":39206,"_1794":39349},[],"Acceso al registro de contenedores de Lamassu, o a un registro espejo propio, desde los nodos del clúster",{"_4673":333,"_26077":284,"_22045":39351,"_5":26338,"_10236":39206,"_1794":39352},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_4673":334,"_26077":284,"_22045":39354,"_5":26338,"_10236":39210,"_1794":39355},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_4673":335,"_26077":284,"_22045":39357,"_5":26338,"_10236":39214,"_1794":39358},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_4673":336,"_26077":284,"_22045":39360,"_5":26338,"_10236":39218,"_1794":39361},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_4673":337,"_26077":284,"_22045":39363,"_5":26338,"_10236":39222,"_1794":39364},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_4673":338,"_26077":284,"_22045":39366,"_5":26338,"_10236":39222,"_1794":39367},[],"Dependencias externas requeridas por el chart principal:",{"_4673":339,"_26077":284,"_22045":39369,"_5":26338,"_10236":39222,"_1794":38692},[],{"_4673":340,"_26077":284,"_22045":39371,"_5":26338,"_10236":39222,"_1794":38698},[],{"_4673":341,"_26077":284,"_22045":39373,"_5":26338,"_10236":39222,"_1794":39374},[],"proveedor OIDC, típicamente Keycloak",{"_4673":342,"_26077":284,"_22045":39376,"_5":26338,"_10236":39222,"_1794":39377},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_4673":343,"_26077":284,"_22045":39379,"_5":26338,"_10236":39226,"_1794":39380},[],"Agregar el repositorio Helm:",{"_4673":344,"_26077":284,"_22045":39382,"_5":26338,"_10236":39226,"_1794":39383},[],"O instalar desde una copia local del repositorio:",{"_4673":345,"_26077":284,"_22045":39385,"_5":26338,"_10236":39230,"_1794":39386},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_4673":346,"_26077":284,"_22045":39388,"_5":26338,"_10236":39230,"_1794":39389},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_4673":347,"_26077":284,"_22045":39391,"_5":26338,"_10236":39230,"_1794":39392},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_4673":348,"_26077":284,"_22045":39394,"_5":26338,"_10236":39230,"_1794":39395},[],"`auth.oidc.frontend.authority`",{"_4673":349,"_26077":284,"_22045":39397,"_5":26338,"_10236":39230,"_1794":39398},[],"`auth.oidc.apiGateway.jwks`",{"_4673":350,"_26077":284,"_22045":39400,"_5":26338,"_10236":39230,"_1794":39401},[],"`services.authz.jwkUrl` y un principal de bootstrap que coincida con un administrador real",{"_4673":351,"_26077":284,"_22045":39403,"_5":26338,"_10236":39230,"_1794":39404},[],"`services.ca.domains`",{"_4673":352,"_26077":284,"_22045":39406,"_5":26338,"_10236":39230,"_1794":39407},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_4673":353,"_26077":284,"_22045":39409,"_5":26338,"_10236":39230,"_1794":39410},[],"`tls.*` según se use `certManager` o certificado externo",{"_4673":354,"_26077":284,"_22045":39412,"_5":26338,"_10236":39230,"_1794":39413},[],"Ejemplo base:",{"_4673":355,"_26077":284,"_22045":39415,"_5":26338,"_10236":39230,"_1794":39416},[],"Con `tls.certManagerOptions.issuer` vacío, el chart `4.0.0` crea un `Issuer` self-signed con nombre dependiente del release (por ejemplo, `lamassu-downstream-ca-selfsigned-issuer` con `helm install lamassu`). El valor legado `downstream-ca-selfsigned-issuer` sigue resolviendo al mismo emisor, pero se recomienda dejarlo vacío o apuntar a tu propio `Issuer`/`ClusterIssuer` mediante `tls.certManagerOptions.clusterIssuer`.",{"_4673":356,"_26077":284,"_22045":39418,"_5":26338,"_10236":39234,"_1794":39419},[],"No hay un superusuario implícito. Antes de instalar, crea el rol `pki-admin` en el proveedor OIDC y asígnalo al grupo que administrará Lamassu. El principal del ejemplo concede la política `SUPER ADMIN` a cualquier token que contenga ese rol.",{"_4673":357,"_26077":284,"_22045":39421,"_5":26338,"_10236":39234,"_1794":39422},[],"El Job `pre-install` y `pre-upgrade` prepara las bases de datos, ejecuta las migraciones de authz, precarga las políticas y aplica `services.authz.bootstrap` antes de que arranquen los Deployments. El bootstrap es idempotente: conserva los principales existentes y añade únicamente los grants que falten.",{"_4673":358,"_26077":284,"_22045":39424,"_5":26338,"_10236":39234,"_1794":39425},[],"Si ningún token coincide con un principal activo, nadie podrá administrar la PKI. Prueba una identidad autorizada y otra denegada, y conserva un procedimiento de recuperación.",{"_4673":359,"_26077":284,"_22045":39427,"_5":26338,"_10236":39234,"_1794":39428},[],"Consulta Control de acceso para diseñar principales y políticas.",{"_4673":360,"_26077":284,"_22045":39430,"_5":26338,"_10236":39238,"_1794":39431},[],"**TLS:** `tls.type`, `tls.certManagerOptions.*` y `tls.externalOptions.secretName` controlan el certificado *downstream* del Gateway.",{"_4673":361,"_26077":284,"_22045":39433,"_5":26338,"_10236":39238,"_1794":39434},[],"**Gateway:** `gateway.addresses`, `gateway.ports.*`, `gateway.className` y `gateway.extraRouting` publican la UI y las APIs mediante Envoy Gateway. `gateway.responseOverride` reescribe las respuestas `401`/`403` con cuerpos JSON propios (habilitado por defecto).",{"_4673":362,"_26077":284,"_22045":39436,"_5":26338,"_10236":39238,"_1794":39437},[],"**Persistencia:** `postgres.*` define la conexión a PostgreSQL.",{"_4673":363,"_26077":284,"_22045":39439,"_5":26338,"_10236":39238,"_1794":39440},[],"**Mensajería:** `amqp.*` configura la conexión a RabbitMQ.",{"_4673":364,"_26077":284,"_22045":39442,"_5":26338,"_10236":39238,"_1794":39443},[],"**Identidad y autorización:** `auth.oidc.*`, `auth.externalAuthorization.*`, `services.authz.jwkUrl` y `services.authz.bootstrap` configuran login, validación JWT, el control de acceso en el Gateway y los permisos iniciales.",{"_4673":365,"_26077":284,"_22045":39445,"_5":26338,"_10236":39238,"_1794":39446},[],"**Autoridades:** `services.ca.domains` establece los dominios autorizados para CA y certificados.",{"_4673":366,"_26077":284,"_22045":39448,"_5":26338,"_10236":39238,"_1794":39449},[],"**Claves:** `services.kms.cryptoEngines.*` configura los motores criptográficos y su almacenamiento.",{"_4673":367,"_26077":284,"_22045":39451,"_5":26338,"_10236":39238,"_1794":39452},[],"**Alertas:** `services.alerts.smtp_server.*` prepara el envío de correo.",{"_4673":368,"_26077":284,"_22045":39454,"_5":26338,"_10236":39238,"_1794":39455},[],"**Observabilidad:** `observability.*` habilita la instrumentación OpenTelemetry (trazas y logs) en todos los servicios.",{"_4673":369,"_26077":284,"_22045":39457,"_5":26338,"_10236":39242,"_1794":39458},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_4673":370,"_26077":284,"_22045":39460,"_5":26338,"_10236":39242,"_1794":39461},[],"La prueba lanza un pod efímero llamado `<release>-connectivity-test` (imagen configurable con `connectivityTest.image`) que comprueba el endpoint `/health` de `ca`, `dms-manager`, `device-manager` y `va`, y que la respuesta del servicio `ui` contiene el título `LamassuIoT Certificate Manager`.",{"_4673":371,"_26077":284,"_22045":39463,"_5":26338,"_10236":39246,"_1794":39464},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_4673":372,"_26077":284,"_22045":39466,"_5":26338,"_10236":39246,"_1794":39467},[],"`charts/lamassu`: chart principal de Lamassu",{"_4673":373,"_26077":284,"_22045":39469,"_5":26338,"_10236":39246,"_1794":39470},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_4673":374,"_26077":284,"_22045":39472,"_5":26338,"_10236":39246,"_1794":39473},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_4673":375,"_26077":284,"_22045":39475,"_5":26338,"_10236":39250,"_1794":39476},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye a un HSM real en producción; sirve como soporte para pruebas o integraciones concretas.",{"_4673":376,"_26077":284,"_22045":39478,"_5":26338,"_10236":39250,"_1794":39479},[],"En la versión `4.0.0` del chart, el servicio KMS puede consumir ese token PKCS#11 mediante el sidecar `services.kms.pkcs11Sidecar`, que expone el socket PKCS#11 en un volumen compartido del pod (requiere Kubernetes `1.29+`). El script Fastlane automatiza la integración completa con `--with-hsm` (ver Fastlane).",{"_4673":377,"_26077":284,"_22045":39481,"_5":26338,"_10236":39254,"_1794":39482},[],"La versión `4.0.0` del chart introduce cambios que rompen la compatibilidad con los despliegues `3.8.x`. La guía completa está en `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` del repositorio `lamassu-helm`. Los puntos que más afectan a un despliegue manual:",{"_4673":378,"_26077":284,"_22045":39484,"_5":26338,"_10236":39254,"_1794":39485},[],"**Nombres dependientes del release:** los recursos del chart pasan a llamarse `<release>-<componente>` (por ejemplo, `lamassu-kms`) en lugar de usar nombres fijos. Los PVC de KMS y VA cambian de nombre; si usas motores KMS con almacenamiento en sistema de ficheros o el `fileStore` local de VA, los datos requieren una migración manual descrita en la guía del CHANGELOG: tras `helm upgrade`, los StatefulSets nuevos arrancan con PVC vacíos y hay que copiar el contenido con un pod de ayuda (`alpine:3.20`) ajustando la propiedad a `65532:65532`. Si es una instalación nueva o no usas esos backends, no hay nada que migrar.",{"_4673":379,"_26077":284,"_22045":39487,"_5":26338,"_10236":39254,"_1794":39488},[],"**`services.authz` es obligatorio:** el nuevo servicio de autorización no existía en `3.8.0`. El Job de migraciones crea sus esquemas y precarga políticas, pero no crea la base de datos `pki`; provisiona esa base de datos y concede acceso al usuario de Lamassu antes de actualizar.",{"_4673":380,"_26077":284,"_22045":39490,"_5":26338,"_10236":39254,"_1794":39491},[],"**Validación estricta de valores:** el chart incorpora `values.schema.json` y rechaza claves de nivel superior desconocidas. Elimina bloques obsoletos (por ejemplo, `toolbox`) antes de ejecutar `helm upgrade`.",{"_4673":381,"_26077":284,"_22045":39493,"_5":26338,"_10236":39254,"_1794":39494},[],"**`services.connectors` ahora es un mapa:** cada entrada se indexa por el identificador del conector y debe definir `type` e `image`.",{"_4673":382,"_26077":284,"_22045":39496,"_5":26338,"_10236":39254,"_1794":39497},[],"**Por defecto más seguros:** los pods pasan a ejecutarse como usuario no root `65532:65532`, sin montaje del token del service account, con seccomp `RuntimeDefault` y capacidades eliminadas. Las sobrecargas por servicio de `runAsUser`/`runAsGroup` se han eliminado.",{"_4673":383,"_26077":284,"_22045":39499,"_5":26338,"_10236":39254,"_1794":39500},[],"**`toolbox` pasa a `connectivityTest`:** el contenedor auxiliar de verificación de conectividad se configura en `connectivityTest.image`.",{"_4673":384,"_26077":284,"_22045":39502,"_5":26338,"_10236":39258,"_1794":39503},[],"La versión actual del chart en el repositorio es `4.0.0`. Para upgrades entre versiones, consulta las guías de `charts/lamassu/CHANGELOG/` y revisa especialmente las migraciones de base de datos y el bootstrap de authz.",{"_4673":385,"_26077":385,"_5":26333,"_1794":39505,"_26346":39506,"_22045":39509,"_10236":385},"Control de acceso",[38338,39507,39508],"Plataforma","Administrar Lamassu",[],{"_4673":386,"_26077":385,"_22045":39511,"_5":26338,"_10236":385,"_1794":39512},[],"Conecta una identidad OIDC o X.509 con principales, políticas y permisos de Lamassu.",{"_4673":387,"_26077":385,"_5":26343,"_22045":39514,"_10236":39515,"_1794":39516},[],"/docs/pr-preview/pr-26/platform/pki/access-control#cómo-se-toma-una-decisión","Cómo se toma una decisión",{"_4673":388,"_26077":385,"_5":26343,"_22045":39518,"_10236":39519,"_1794":39520},[],"/docs/pr-preview/pr-26/platform/pki/access-control#principales","Principales",{"_4673":389,"_26077":385,"_5":26343,"_22045":39522,"_10236":39523,"_1794":39524},[],"/docs/pr-preview/pr-26/platform/pki/access-control#políticas","Políticas",{"_4673":390,"_26077":385,"_5":26343,"_22045":39526,"_10236":39527,"_1794":39235},[],"/docs/pr-preview/pr-26/platform/pki/access-control#provisiona-el-primer-administrador",{"_4673":391,"_26077":385,"_5":26343,"_22045":39529,"_10236":39530,"_1794":39531},[],"/docs/pr-preview/pr-26/platform/pki/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_4673":392,"_26077":385,"_5":26343,"_22045":39533,"_10236":39534,"_1794":39535},[],"/docs/pr-preview/pr-26/platform/pki/access-control#operación-segura","Operación segura",{"_4673":393,"_26077":385,"_5":26343,"_22045":39537,"_10236":39538,"_1794":39539},[],"/docs/pr-preview/pr-26/platform/pki/access-control#diagnóstico-rápido","Diagnóstico rápido",{"_4673":394,"_26077":385,"_22045":39541,"_5":26338,"_10236":385,"_1794":39542},[],"Lamassu separa autenticación y autorización. El proveedor OIDC o el certificado cliente demuestra quién realiza la petición; el servicio authz relaciona esa identidad con uno o varios principales y decide qué acciones están permitidas.",{"_4673":395,"_26077":385,"_22045":39544,"_5":26338,"_10236":39515,"_1794":39545},[],"El Gateway valida la autenticación configurada, normalmente un JWT mediante JWKS.",{"_4673":396,"_26077":385,"_22045":39547,"_5":26338,"_10236":39515,"_1794":39548},[],"Envoy envía la petición al endpoint de autorización externa /v1/ext\\_authz/check.",{"_4673":397,"_26077":385,"_22045":39550,"_5":26338,"_10236":39515,"_1794":39551},[],"authz compara las credenciales con principales activos.",{"_4673":398,"_26077":385,"_22045":39553,"_5":26338,"_10236":39515,"_1794":39554},[],"Reúne las políticas concedidas a los principales coincidentes.",{"_4673":399,"_26077":385,"_22045":39556,"_5":26338,"_10236":39515,"_1794":39557},[],"Evalúa la acción HTTP o el recurso solicitado y permite o deniega.",{"_4673":400,"_26077":385,"_22045":39559,"_5":26338,"_10236":39515,"_1794":39560},[],"Por defecto, auth.externalAuthorization.failOpen es false. Si authz no responde, el Gateway bloquea la petición protegida.",{"_4673":401,"_26077":385,"_22045":39562,"_5":26338,"_10236":39519,"_1794":39563},[],"Un principal representa una identidad autorizable, no necesariamente una persona individual. Tiene un identificador estable, nombre, tipo, configuración de coincidencia, estado activo y políticas concedidas.",{"_4673":402,"_26077":385,"_22045":39565,"_5":26338,"_10236":39519,"_1794":39566},[],"Lamassu admite dos tipos:",{"_4673":403,"_26077":385,"_22045":39568,"_5":26338,"_10236":39519,"_1794":39569},[],"**oidc**: coincide con claims de un token, por ejemplo un rol, grupo o preferred\\_username.",{"_4673":404,"_26077":385,"_22045":39571,"_5":26338,"_10236":39519,"_1794":39572},[],"**x509**: coincide con una identidad autenticada mediante certificado y su configuración de confianza.",{"_4673":405,"_26077":385,"_22045":39574,"_5":26338,"_10236":39519,"_1794":39575},[],"Diseña los principales alrededor de identidades estables del proveedor. Para administración humana suele ser preferible un grupo o rol gestionado centralmente; para automatización, usa una identidad técnica independiente.",{"_4673":406,"_26077":385,"_22045":39577,"_5":26338,"_10236":39523,"_1794":39578},[],"Una política agrupa reglas reutilizables. Las reglas pueden:",{"_4673":407,"_26077":385,"_22045":39580,"_5":26338,"_10236":39523,"_1794":39581},[],"permitir acciones sobre un tipo de entidad;",{"_4673":408,"_26077":385,"_22045":39583,"_5":26338,"_10236":39523,"_1794":39584},[],"limitar el acceso a identificadores concretos;",{"_4673":409,"_26077":385,"_22045":39586,"_5":26338,"_10236":39523,"_1794":39587},[],"seguir relaciones entre entidades;",{"_4673":410,"_26077":385,"_22045":39589,"_5":26338,"_10236":39523,"_1794":39590},[],"aplicar filtros por atributos;",{"_4673":411,"_26077":385,"_22045":39592,"_5":26338,"_10236":39523,"_1794":39593},[],"conceder acciones HTTP lógicas definidas por el esquema de una API.",{"_4673":412,"_26077":385,"_22045":39595,"_5":26338,"_10236":39523,"_1794":39596},[],"La acción \\* en una regla HTTP concede todas las acciones definidas por ese esquema. Resérvala para roles administrativos controlados.",{"_4673":413,"_26077":385,"_22045":39598,"_5":26338,"_10236":39527,"_1794":39599},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la PKI. Define el bootstrap y configura el IdP antes de exponer la plataforma.",{"_4673":414,"_26077":385,"_22045":39601,"_5":26338,"_10236":39527,"_1794":39602},[],"El chart crea por defecto un principal que busca el rol OIDC pki-admin en realm\\_access.roles y le concede las políticas de administración incluidas. El Job Helm de preinstalación y preactualización ejecuta las migraciones de authz, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios.",{"_4673":415,"_26077":385,"_22045":39604,"_5":26338,"_10236":39527,"_1794":39605},[],"Antes de instalar:",{"_4673":416,"_26077":385,"_22045":39607,"_5":26338,"_10236":39527,"_1794":39608},[],"Crea el rol pki-admin en tu proveedor OIDC.",{"_4673":417,"_26077":385,"_22045":39610,"_5":26338,"_10236":39527,"_1794":39611},[],"Asígnalo a un grupo administrativo pequeño y verificable.",{"_4673":418,"_26077":385,"_22045":39613,"_5":26338,"_10236":39527,"_1794":39614},[],"Configura la URL JWKS interna que alcanzará authz.",{"_4673":419,"_26077":385,"_22045":39616,"_5":26338,"_10236":39527,"_1794":39617},[],"Mantén al menos dos identidades humanas de recuperación.",{"_4673":420,"_26077":385,"_22045":39619,"_5":26338,"_10236":39527,"_1794":39620},[],"Prueba acceso permitido y denegado con usuarios distintos.",{"_4673":421,"_26077":385,"_22045":39622,"_5":26338,"_10236":39527,"_1794":39623},[],"El bootstrap es idempotente: si el principal ya existe, no lo reemplaza; solo añade las políticas configuradas que todavía falten. Por eso puedes mantenerlo en values.yaml durante las actualizaciones.",{"_4673":422,"_26077":385,"_22045":39625,"_5":26338,"_10236":39530,"_1794":39626},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario lamassu con contraseña temporal lamassu, rol pki-admin y acción obligatoria de cambio de contraseña. Su principal de bootstrap coincide por preferred\\_username=lamassu.",{"_4673":423,"_26077":385,"_22045":39628,"_5":26338,"_10236":39530,"_1794":39629},[],"Cambia la contraseña en el primer acceso. No reutilices este usuario ni el IdP de ejemplo como diseño de producción.",{"_4673":424,"_26077":385,"_22045":39631,"_5":26338,"_10236":39534,"_1794":39632},[],"Concede políticas a grupos o identidades técnicas, no a claims ambiguos.",{"_4673":425,"_26077":385,"_22045":39634,"_5":26338,"_10236":39534,"_1794":39635},[],"Desactiva un principal cuando deba perder acceso de inmediato.",{"_4673":426,"_26077":385,"_22045":39637,"_5":26338,"_10236":39534,"_1794":39638},[],"Separa administración de PKI, operación de dispositivos y automatizaciones.",{"_4673":427,"_26077":385,"_22045":39640,"_5":26338,"_10236":39534,"_1794":39641},[],"Revisa los grants tras cambios en el proveedor OIDC.",{"_4673":428,"_26077":385,"_22045":39643,"_5":26338,"_10236":39534,"_1794":39644},[],"Mantén failOpen: false salvo una decisión de riesgo explícita.",{"_4673":429,"_26077":385,"_22045":39646,"_5":26338,"_10236":39534,"_1794":39647},[],"Conserva un procedimiento probado para recuperar acceso sin desactivar autorización.",{"_4673":430,"_26077":385,"_22045":39649,"_5":26338,"_10236":39538,"_1794":39650},[],"Un 401 suele indicar que el Gateway no pudo validar la autenticación. Revisa emisor, audiencia, expiración y JWKS.",{"_4673":431,"_26077":385,"_22045":39652,"_5":26338,"_10236":39538,"_1794":39653},[],"Un 403 indica normalmente que la identidad se autenticó, pero ningún principal activo y sus políticas autorizaron la acción. Comprueba claims reales del token, regla de coincidencia, grants y acción solicitada.",{"_4673":432,"_26077":385,"_22045":39655,"_5":26338,"_10236":39538,"_1794":39656},[],"Si todas las rutas protegidas fallan, verifica la salud y conectividad de authz, su acceso a PostgreSQL y la URL JWKS. Continúa con Resolución de problemas.",{"_4673":433,"_26077":433,"_5":26333,"_1794":39658,"_26346":39659,"_22045":39661,"_10236":433},"Alertas y suscripciones",[38338,39507,39660],"Operar Lamassu",[],{"_4673":434,"_26077":433,"_22045":39663,"_5":26338,"_10236":433,"_1794":39664},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_4673":435,"_26077":433,"_5":26343,"_22045":39666,"_10236":39667,"_1794":39668},[],"/docs/pr-preview/pr-26/platform/pki/alerts#cómo-funciona","Cómo funciona",{"_4673":436,"_26077":433,"_5":26343,"_22045":39670,"_10236":39671,"_1794":39672},[],"/docs/pr-preview/pr-26/platform/pki/alerts#canales-disponibles","Canales disponibles",{"_4673":437,"_26077":433,"_5":26343,"_22045":39674,"_10236":39675,"_1794":39676},[],"/docs/pr-preview/pr-26/platform/pki/alerts#crea-una-suscripción","Crea una suscripción",{"_4673":438,"_26077":433,"_5":26343,"_22045":39678,"_10236":39679,"_1794":39680},[],"/docs/pr-preview/pr-26/platform/pki/alerts#elige-el-evento","Elige el evento",{"_4673":439,"_26077":433,"_5":26343,"_22045":39682,"_10236":39683,"_1794":39684},[],"/docs/pr-preview/pr-26/platform/pki/alerts#configura-el-destino","Configura el destino",{"_4673":440,"_26077":433,"_5":26343,"_22045":39686,"_10236":39687,"_1794":39688},[],"/docs/pr-preview/pr-26/platform/pki/alerts#limita-las-notificaciones","Limita las notificaciones",{"_4673":441,"_26077":433,"_5":26343,"_22045":39690,"_10236":39691,"_1794":39692},[],"/docs/pr-preview/pr-26/platform/pki/alerts#revisa-y-activa","Revisa y activa",{"_4673":442,"_26077":433,"_5":26343,"_22045":39694,"_10236":39695,"_1794":39696},[],"/docs/pr-preview/pr-26/platform/pki/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_4673":443,"_26077":433,"_5":26343,"_22045":39698,"_10236":39699,"_1794":39700},[],"/docs/pr-preview/pr-26/platform/pki/alerts#familias-de-eventos","Familias de eventos",{"_4673":444,"_26077":433,"_22045":39702,"_5":26338,"_10236":433,"_1794":39703},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_4673":445,"_26077":433,"_22045":39705,"_5":26338,"_10236":39667,"_1794":39706},[],"Un servicio publica un evento de dominio.",{"_4673":446,"_26077":433,"_22045":39708,"_5":26338,"_10236":39667,"_1794":39709},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_4673":447,"_26077":433,"_22045":39711,"_5":26338,"_10236":39667,"_1794":39712},[],"El filtro de cada suscripción decide si debe notificarse.",{"_4673":448,"_26077":433,"_22045":39714,"_5":26338,"_10236":39667,"_1794":39715},[],"Lamassu entrega el evento al canal configurado.",{"_4673":449,"_26077":433,"_22045":39717,"_5":26338,"_10236":39667,"_1794":39718},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_4673":450,"_26077":433,"_22045":39720,"_5":26338,"_10236":39671,"_1794":39721},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_4673":451,"_26077":433,"_22045":39723,"_5":26338,"_10236":39671,"_1794":39724},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_4673":452,"_26077":433,"_22045":39726,"_5":26338,"_10236":39671,"_1794":39727},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_4673":453,"_26077":433,"_22045":39729,"_5":26338,"_10236":39679,"_1794":39730},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_4673":454,"_26077":433,"_22045":39732,"_5":26338,"_10236":39683,"_1794":39733},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_4673":455,"_26077":433,"_22045":39735,"_5":26338,"_10236":39687,"_1794":39736},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_4673":456,"_26077":433,"_22045":39738,"_5":26338,"_10236":39687,"_1794":39739},[],"**None** notifica todas las instancias del evento.",{"_4673":457,"_26077":433,"_22045":39741,"_5":26338,"_10236":39687,"_1794":39742},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_4673":458,"_26077":433,"_22045":39744,"_5":26338,"_10236":39687,"_1794":39745},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_4673":459,"_26077":433,"_22045":39747,"_5":26338,"_10236":39687,"_1794":39748},[],"**JavaScript** permite expresar lógica personalizada.",{"_4673":460,"_26077":433,"_22045":39750,"_5":26338,"_10236":39687,"_1794":39751},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_4673":461,"_26077":433,"_22045":39753,"_5":26338,"_10236":39691,"_1794":39754},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_4673":462,"_26077":433,"_22045":39756,"_5":26338,"_10236":39695,"_1794":39757},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_4673":463,"_26077":433,"_22045":39759,"_5":26338,"_10236":39699,"_1794":39760},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_4673":464,"_26077":433,"_22045":39762,"_5":26338,"_10236":39699,"_1794":39763},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_4673":465,"_26077":433,"_22045":39765,"_5":26338,"_10236":39699,"_1794":39766},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_4673":466,"_26077":433,"_22045":39768,"_5":26338,"_10236":39699,"_1794":39769},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_4673":467,"_26077":433,"_22045":39771,"_5":26338,"_10236":39699,"_1794":39772},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_4673":468,"_26077":433,"_22045":39774,"_5":26338,"_10236":39699,"_1794":39775},[],"**Validación:** `va.role.crl.create`.",{"_4673":469,"_26077":433,"_22045":39777,"_5":26338,"_10236":39699,"_1794":39778},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_4673":470,"_26077":433,"_22045":39780,"_5":26338,"_10236":39699,"_1794":39781},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_4673":471,"_26077":471,"_5":26333,"_1794":39783,"_26346":39784,"_22045":39785,"_10236":471},"Registros de auditoría",[38338,39507,39508],[],{"_4673":472,"_26077":471,"_22045":39787,"_5":26338,"_10236":471,"_1794":39788},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_4673":473,"_26077":471,"_5":26343,"_22045":39790,"_10236":39791,"_1794":39792},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_4673":474,"_26077":471,"_5":26343,"_22045":39794,"_10236":39795,"_1794":39796},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#cobertura","Cobertura",{"_4673":475,"_26077":471,"_5":26343,"_22045":39798,"_10236":39799,"_1794":39800},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_4673":476,"_26077":471,"_5":26343,"_22045":39802,"_10236":39803,"_1794":39804},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#datos-sensibles","Datos sensibles",{"_4673":477,"_26077":471,"_5":26343,"_22045":39806,"_10236":39807,"_1794":39808},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_4673":478,"_26077":471,"_5":26343,"_22045":39810,"_10236":39811,"_1794":39812},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#acota-el-intervalo","Acota el intervalo",{"_4673":479,"_26077":471,"_5":26343,"_22045":39814,"_10236":39815,"_1794":39816},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#identifica-la-operación","Identifica la operación",{"_4673":480,"_26077":471,"_5":26343,"_22045":39818,"_10236":39819,"_1794":39820},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#atribuye-el-principal","Atribuye el principal",{"_4673":481,"_26077":471,"_5":26343,"_22045":39822,"_10236":39823,"_1794":39824},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_4673":482,"_26077":471,"_5":26343,"_22045":39826,"_10236":39827,"_1794":39828},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#sigue-el-efecto","Sigue el efecto",{"_4673":483,"_26077":471,"_5":26343,"_22045":39830,"_10236":39831,"_1794":39832},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#verificación-periódica","Verificación periódica",{"_4673":484,"_26077":471,"_22045":39834,"_5":26338,"_10236":471,"_1794":39835},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_4673":485,"_26077":471,"_22045":39837,"_5":26338,"_10236":39791,"_1794":39838},[],"El cuerpo de auditoría incluye:",{"_4673":486,"_26077":471,"_22045":39840,"_5":26338,"_10236":39791,"_1794":39841},[],"input: datos recibidos por la operación;",{"_4673":487,"_26077":471,"_22045":39843,"_5":26338,"_10236":39791,"_1794":39844},[],"has\\_error: indica si el servicio devolvió un error;",{"_4673":488,"_26077":471,"_22045":39846,"_5":26338,"_10236":39791,"_1794":39847},[],"output: resultado producido o mensaje de error;",{"_4673":489,"_26077":471,"_22045":39849,"_5":26338,"_10236":39791,"_1794":39850},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_4673":490,"_26077":471,"_22045":39852,"_5":26338,"_10236":39791,"_1794":39853},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_4673":491,"_26077":471,"_22045":39855,"_5":26338,"_10236":39791,"_1794":39856},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_4673":492,"_26077":471,"_22045":39858,"_5":26338,"_10236":39795,"_1794":39859},[],"El backend aplica auditoría a mutaciones de:",{"_4673":493,"_26077":471,"_22045":39861,"_5":26338,"_10236":39795,"_1794":39862},[],"autoridades, certificados y perfiles de emisión;",{"_4673":494,"_26077":471,"_22045":39864,"_5":26338,"_10236":39795,"_1794":39865},[],"claves y motores KMS;",{"_4673":495,"_26077":471,"_22045":39867,"_5":26338,"_10236":39795,"_1794":39868},[],"dispositivos e identidades;",{"_4673":496,"_26077":471,"_22045":39870,"_5":26338,"_10236":39795,"_1794":39871},[],"DMS y operaciones de enrolamiento;",{"_4673":497,"_26077":471,"_22045":39873,"_5":26338,"_10236":39795,"_1794":39874},[],"funciones de validación y CRL;",{"_4673":498,"_26077":471,"_22045":39876,"_5":26338,"_10236":39795,"_1794":39877},[],"principales, políticas y concesiones de autorización.",{"_4673":499,"_26077":471,"_22045":39879,"_5":26338,"_10236":39795,"_1794":39880},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_4673":500,"_26077":471,"_22045":39882,"_5":26338,"_10236":39799,"_1794":39883},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_4673":501,"_26077":471,"_22045":39885,"_5":26338,"_10236":39799,"_1794":39886},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_4673":502,"_26077":471,"_22045":39888,"_5":26338,"_10236":39799,"_1794":39889},[],"Diseña el consumidor para:",{"_4673":503,"_26077":471,"_22045":39891,"_5":26338,"_10236":39799,"_1794":39892},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_4673":504,"_26077":471,"_22045":39894,"_5":26338,"_10236":39799,"_1794":39895},[],"conservar el CloudEvent completo sin modificar;",{"_4673":505,"_26077":471,"_22045":39897,"_5":26338,"_10236":39799,"_1794":39898},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_4673":506,"_26077":471,"_22045":39900,"_5":26338,"_10236":39799,"_1794":39901},[],"cifrar en tránsito y en reposo;",{"_4673":507,"_26077":471,"_22045":39903,"_5":26338,"_10236":39799,"_1794":39904},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_4673":508,"_26077":471,"_22045":39906,"_5":26338,"_10236":39799,"_1794":39907},[],"aplicar una política explícita de retención y legal hold;",{"_4673":509,"_26077":471,"_22045":39909,"_5":26338,"_10236":39799,"_1794":39910},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_4673":510,"_26077":471,"_22045":39912,"_5":26338,"_10236":39803,"_1794":39913},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_4673":511,"_26077":471,"_22045":39915,"_5":26338,"_10236":39803,"_1794":39916},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_4673":512,"_26077":471,"_22045":39918,"_5":26338,"_10236":39811,"_1794":39919},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_4673":513,"_26077":471,"_22045":39921,"_5":26338,"_10236":39815,"_1794":39922},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_4673":514,"_26077":471,"_22045":39924,"_5":26338,"_10236":39819,"_1794":39925},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_4673":515,"_26077":471,"_22045":39927,"_5":26338,"_10236":39823,"_1794":39928},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_4673":516,"_26077":471,"_22045":39930,"_5":26338,"_10236":39827,"_1794":39931},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_4673":517,"_26077":471,"_22045":39933,"_5":26338,"_10236":39831,"_1794":39934},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_4673":518,"_26077":471,"_22045":39936,"_5":26338,"_10236":39831,"_1794":39937},[],"aparece un evento de auditoría correcto;",{"_4673":519,"_26077":471,"_22045":39939,"_5":26338,"_10236":39831,"_1794":39940},[],"el principal coincide con la identidad utilizada;",{"_4673":520,"_26077":471,"_22045":39942,"_5":26338,"_10236":39831,"_1794":39943},[],"el consumidor lo persiste una sola vez;",{"_4673":521,"_26077":471,"_22045":39945,"_5":26338,"_10236":39831,"_1794":39946},[],"puede recuperarse por recurso, actor y periodo;",{"_4673":522,"_26077":471,"_22045":39948,"_5":26338,"_10236":39831,"_1794":39949},[],"una interrupción del consumidor produce una alerta.",{"_4673":523,"_26077":471,"_22045":39951,"_5":26338,"_10236":39831,"_1794":39952},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_4673":524,"_26077":524,"_5":26333,"_1794":39954,"_26346":39955,"_22045":39956,"_10236":524},"Jerarquía y rotación de CAs",[38338,39507,39660],[],{"_4673":525,"_26077":524,"_22045":39958,"_5":26338,"_10236":524,"_1794":39959},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_4673":526,"_26077":524,"_5":26343,"_22045":39961,"_10236":39962,"_1794":39963},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_4673":527,"_26077":524,"_5":26343,"_22045":39965,"_10236":39966,"_1794":39967},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_4673":528,"_26077":524,"_5":26343,"_22045":39969,"_10236":39970,"_1794":39971},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_4673":529,"_26077":524,"_5":26343,"_22045":39973,"_10236":39974,"_1794":39975},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_4673":530,"_26077":524,"_5":26343,"_22045":39977,"_10236":39978,"_1794":39979},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_4673":531,"_26077":524,"_5":26343,"_22045":39981,"_10236":39982,"_1794":39983},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_4673":532,"_26077":524,"_5":26343,"_22045":39985,"_10236":39986,"_1794":39987},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_4673":533,"_26077":524,"_5":26343,"_22045":39989,"_10236":39990,"_1794":39991},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_4673":534,"_26077":524,"_5":26343,"_22045":39993,"_10236":39994,"_1794":39995},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_4673":535,"_26077":524,"_5":26343,"_22045":39997,"_10236":39998,"_1794":39999},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_4673":536,"_26077":524,"_5":26343,"_22045":40001,"_10236":40002,"_1794":40003},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_4673":537,"_26077":524,"_5":26343,"_22045":40005,"_10236":40006,"_1794":40007},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_4673":538,"_26077":524,"_22045":40009,"_5":26338,"_10236":524,"_1794":40010},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_4673":539,"_26077":524,"_22045":40012,"_5":26338,"_10236":39962,"_1794":40013},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_4673":540,"_26077":524,"_22045":40015,"_5":26338,"_10236":39962,"_1794":40016},[],"entorno, como producción y preproducción;",{"_4673":541,"_26077":524,"_22045":40018,"_5":26338,"_10236":39962,"_1794":40019},[],"propietario o equipo operador;",{"_4673":542,"_26077":524,"_22045":40021,"_5":26338,"_10236":39962,"_1794":40022},[],"familia de dispositivos o proceso de fabricación;",{"_4673":543,"_26077":524,"_22045":40024,"_5":26338,"_10236":39962,"_1794":40025},[],"región o requisito regulatorio;",{"_4673":544,"_26077":524,"_22045":40027,"_5":26338,"_10236":39962,"_1794":40028},[],"motor criptográfico o política de clave;",{"_4673":545,"_26077":524,"_22045":40030,"_5":26338,"_10236":39962,"_1794":40031},[],"ventana de mantenimiento y ritmo de renovación.",{"_4673":546,"_26077":524,"_22045":40033,"_5":26338,"_10236":39962,"_1794":40034},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_4673":547,"_26077":524,"_22045":40036,"_5":26338,"_10236":39962,"_1794":40037},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_4673":548,"_26077":524,"_22045":40039,"_5":26338,"_10236":39966,"_1794":40040},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_4673":549,"_26077":524,"_22045":40042,"_5":26338,"_10236":39966,"_1794":40043},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_4673":550,"_26077":524,"_22045":40045,"_5":26338,"_10236":39966,"_1794":40046},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_4673":551,"_26077":524,"_22045":40048,"_5":26338,"_10236":39970,"_1794":40049},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_4673":552,"_26077":524,"_22045":40051,"_5":26338,"_10236":39970,"_1794":40052},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_4673":553,"_26077":524,"_22045":40054,"_5":26338,"_10236":39970,"_1794":40055},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_4673":554,"_26077":524,"_22045":40057,"_5":26338,"_10236":39970,"_1794":40058},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_4673":555,"_26077":524,"_22045":40060,"_5":26338,"_10236":39978,"_1794":40061},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_4673":556,"_26077":524,"_22045":40063,"_5":26338,"_10236":39982,"_1794":40064},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_4673":557,"_26077":524,"_22045":40066,"_5":26338,"_10236":39986,"_1794":40067},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. En un DMS, utiliza las CAs gestionadas de `/cacerts` para mantener temporalmente las cadenas antigua y nueva.",{"_4673":558,"_26077":524,"_22045":40069,"_5":26338,"_10236":39990,"_1794":40070},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_4673":559,"_26077":524,"_22045":40072,"_5":26338,"_10236":39994,"_1794":40073},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_4673":560,"_26077":524,"_22045":40075,"_5":26338,"_10236":39998,"_1794":40076},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_4673":561,"_26077":524,"_22045":40078,"_5":26338,"_10236":40002,"_1794":40079},[],"Al revocar una CA, Lamassu actualiza también sus CAs hijas y certificados emitidos a `REVOKED` con razón `CessationOfOperation`. Las revocaciones de las hijas propagan el efecto a sus propias ramas.",{"_4673":562,"_26077":524,"_22045":40081,"_5":26338,"_10236":40002,"_1794":40082},[],"Esto protege la coherencia de la jerarquía, pero convierte la revocación en una acción de gran impacto. No la utilices como mecanismo ordinario para dejar de emitir: primero completa la migración y elimina la CA de los flujos operativos.",{"_4673":563,"_26077":524,"_22045":40084,"_5":26338,"_10236":40006,"_1794":40085},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_4673":564,"_26077":524,"_22045":40087,"_5":26338,"_10236":40006,"_1794":40088},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_4673":565,"_26077":524,"_22045":40090,"_5":26338,"_10236":40006,"_1794":40091},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_4673":566,"_26077":524,"_22045":40093,"_5":26338,"_10236":40006,"_1794":40094},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_4673":567,"_26077":524,"_22045":40096,"_5":26338,"_10236":40006,"_1794":40097},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_4673":568,"_26077":524,"_22045":40099,"_5":26338,"_10236":40006,"_1794":40100},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_4673":569,"_26077":524,"_22045":40102,"_5":26338,"_10236":40006,"_1794":40103},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_4673":570,"_26077":570,"_5":26333,"_1794":40105,"_26346":40106,"_22045":40107,"_10236":570},"Autoridades de certificación",[38338,39507,39660],[],{"_4673":571,"_26077":570,"_22045":40109,"_5":26338,"_10236":570,"_1794":40110},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_4673":572,"_26077":570,"_5":26343,"_22045":40112,"_10236":40113,"_1794":40114},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_4673":573,"_26077":570,"_5":26343,"_22045":40116,"_10236":40117,"_1794":40118},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_4673":574,"_26077":570,"_5":26343,"_22045":40120,"_10236":40121,"_1794":38348},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#antes-de-empezar",{"_4673":575,"_26077":570,"_5":26343,"_22045":40123,"_10236":40124,"_1794":40125},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_4673":576,"_26077":570,"_5":26343,"_22045":40127,"_10236":40128,"_1794":40129},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_4673":577,"_26077":570,"_5":26343,"_22045":40131,"_10236":40132,"_1794":40133},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_4673":578,"_26077":570,"_5":26343,"_22045":40135,"_10236":40136,"_1794":40137},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_4673":579,"_26077":570,"_5":26343,"_22045":40139,"_10236":40140,"_1794":40141},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_4673":580,"_26077":570,"_5":26343,"_22045":40143,"_10236":40144,"_1794":40145},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_4673":581,"_26077":570,"_5":26343,"_22045":40147,"_10236":40148,"_1794":40149},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_4673":582,"_26077":570,"_5":26343,"_22045":40151,"_10236":40152,"_1794":40153},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_4673":583,"_26077":570,"_5":26343,"_22045":40155,"_10236":40156,"_1794":40157},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_4673":584,"_26077":570,"_5":26343,"_22045":40159,"_10236":40160,"_1794":40161},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_4673":585,"_26077":570,"_5":26343,"_22045":40163,"_10236":40164,"_1794":40165},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_4673":586,"_26077":570,"_5":26343,"_22045":40167,"_10236":40168,"_1794":40169},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_4673":587,"_26077":570,"_5":26343,"_22045":40171,"_10236":40172,"_1794":40173},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_4673":588,"_26077":570,"_5":26343,"_22045":40175,"_10236":40176,"_1794":40177},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_4673":589,"_26077":570,"_5":26343,"_22045":40179,"_10236":40180,"_1794":40181},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_4673":590,"_26077":570,"_5":26343,"_22045":40183,"_10236":40184,"_1794":40185},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_4673":591,"_26077":570,"_5":26343,"_22045":40187,"_10236":40188,"_1794":40189},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_4673":592,"_26077":570,"_5":26343,"_22045":40191,"_10236":40192,"_1794":40193},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_4673":593,"_26077":570,"_5":26343,"_22045":40195,"_10236":40196,"_1794":40197},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_4673":594,"_26077":570,"_22045":40199,"_5":26338,"_10236":570,"_1794":40200},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_4673":595,"_26077":570,"_22045":40202,"_5":26338,"_10236":570,"_1794":40203},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_4673":596,"_26077":570,"_22045":40205,"_5":26338,"_10236":40113,"_1794":40206},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_4673":597,"_26077":570,"_22045":40208,"_5":26338,"_10236":40113,"_1794":40209},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_4673":598,"_26077":570,"_22045":40211,"_5":26338,"_10236":40113,"_1794":40212},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_4673":599,"_26077":570,"_22045":40214,"_5":26338,"_10236":40113,"_1794":40215},[],"**Importar solo el certificado:** añade una autoridad para construir cadenas y validar, pero no para emitir.",{"_4673":600,"_26077":570,"_22045":40217,"_5":26338,"_10236":40113,"_1794":40218},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_4673":601,"_26077":570,"_22045":40220,"_5":26338,"_10236":40121,"_1794":40221},[],"Decide si la CA será raíz o intermedia.",{"_4673":602,"_26077":570,"_22045":40223,"_5":26338,"_10236":40121,"_1794":40224},[],"Elige el motor que custodiará la clave.",{"_4673":603,"_26077":570,"_22045":40226,"_5":26338,"_10236":40121,"_1794":40227},[],"Define una validez superior a la de los certificados que emitirá.",{"_4673":604,"_26077":570,"_22045":40229,"_5":26338,"_10236":40121,"_1794":40230},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_4673":605,"_26077":570,"_22045":40232,"_5":26338,"_10236":40124,"_1794":40233},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_4673":606,"_26077":570,"_22045":40235,"_5":26338,"_10236":40128,"_1794":40236},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_4673":607,"_26077":570,"_22045":40238,"_5":26338,"_10236":40128,"_1794":40239},[],"Para RSA puedes elegir 1024, 2048, 3072 o 4096 bits. Para EC están disponibles las curvas P-256, P-384 y P-521.",{"_4673":608,"_26077":570,"_22045":40241,"_5":26338,"_10236":40132,"_1794":40242},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_4673":609,"_26077":570,"_22045":40244,"_5":26338,"_10236":40136,"_1794":40245},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_4673":610,"_26077":570,"_22045":40247,"_5":26338,"_10236":40136,"_1794":40248},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_4673":611,"_26077":570,"_22045":40250,"_5":26338,"_10236":40136,"_1794":40251},[],"`ST`: estado o provincia.",{"_4673":612,"_26077":570,"_22045":40253,"_5":26338,"_10236":40136,"_1794":40254},[],"`L`: localidad.",{"_4673":613,"_26077":570,"_22045":40256,"_5":26338,"_10236":40136,"_1794":40257},[],"`O`: organización.",{"_4673":614,"_26077":570,"_22045":40259,"_5":26338,"_10236":40136,"_1794":40260},[],"`OU`: unidad organizativa.",{"_4673":615,"_26077":570,"_22045":40262,"_5":26338,"_10236":40136,"_1794":40263},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_4673":616,"_26077":570,"_22045":40265,"_5":26338,"_10236":40140,"_1794":40266},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_4673":617,"_26077":570,"_22045":40268,"_5":26338,"_10236":40140,"_1794":40269},[],"Selecciona un perfil de emisión existente o configura los `Key Usage` y `Extended Key Usage` en el formulario. Si no eliges un perfil, Lamassu aplica los usos básicos predeterminados.",{"_4673":618,"_26077":570,"_22045":40271,"_5":26338,"_10236":40144,"_1794":40272},[],"Confirma el formulario. La CA debe aparecer en el inventario con su certificado PEM, estado, fecha de expiración y relación de certificados emitidos.",{"_4673":619,"_26077":570,"_22045":40274,"_5":26338,"_10236":40144,"_1794":40275},[],"Una CA no puede emitir certificados que superen su propia fecha de expiración. Deja margen suficiente para renovar o sustituir la autoridad sin interrumpir a los consumidores.",{"_4673":620,"_26077":570,"_22045":40277,"_5":26338,"_10236":40148,"_1794":40278},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_4673":621,"_26077":570,"_22045":40280,"_5":26338,"_10236":40148,"_1794":40281},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_4673":622,"_26077":570,"_22045":40283,"_5":26338,"_10236":40152,"_1794":40284},[],"La importación conserva una autoridad creada fuera de Lamassu.",{"_4673":623,"_26077":570,"_22045":40286,"_5":26338,"_10236":40156,"_1794":40287},[],"Elige el motor que custodiará la clave importada.",{"_4673":624,"_26077":570,"_22045":40289,"_5":26338,"_10236":40160,"_1794":40290},[],"Proporciona el certificado de CA y la clave privada en formato PEM. Para una CA subordinada, añade opcionalmente la cadena de validación.",{"_4673":625,"_26077":570,"_22045":40292,"_5":26338,"_10236":40164,"_1794":40293},[],"Configura la validez que recibirán los certificados finales cuando una solicitud no indique otra duración.",{"_4673":626,"_26077":570,"_22045":40295,"_5":26338,"_10236":40168,"_1794":40296},[],"Lamassu comprueba que el certificado pertenece a una CA y que el material es coherente antes de registrarlo.",{"_4673":627,"_26077":570,"_22045":40298,"_5":26338,"_10236":40168,"_1794":40299},[],"Si no dispones de la clave privada, importa únicamente el certificado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu.",{"_4673":628,"_26077":570,"_22045":40301,"_5":26338,"_10236":40172,"_1794":40302},[],"Abre una CA desde el inventario para consultar:",{"_4673":629,"_26077":570,"_22045":40304,"_5":26338,"_10236":40172,"_1794":40305},[],"Estado y periodo de validez.",{"_4673":630,"_26077":570,"_22045":40307,"_5":26338,"_10236":40172,"_1794":40308},[],"Certificado y cadena en formato PEM.",{"_4673":631,"_26077":570,"_22045":40310,"_5":26338,"_10236":40172,"_1794":40311},[],"Número de certificados activos, expirados y revocados.",{"_4673":632,"_26077":570,"_22045":40313,"_5":26338,"_10236":40172,"_1794":40314},[],"Certificados emitidos en **Issued Certificates**.",{"_4673":633,"_26077":570,"_22045":40316,"_5":26338,"_10236":40172,"_1794":40317},[],"CRL vinculada a la autoridad.",{"_4673":634,"_26077":570,"_22045":40319,"_5":26338,"_10236":40172,"_1794":40320},[],"Metadatos y motor criptográfico asociado.",{"_4673":635,"_26077":570,"_22045":40322,"_5":26338,"_10236":40172,"_1794":40323},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_4673":636,"_26077":570,"_22045":40325,"_5":26338,"_10236":40176,"_1794":40326},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_4673":637,"_26077":570,"_22045":40328,"_5":26338,"_10236":40176,"_1794":40329},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_4673":638,"_26077":570,"_22045":40331,"_5":26338,"_10236":40176,"_1794":40332},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_4673":639,"_26077":570,"_22045":40334,"_5":26338,"_10236":40176,"_1794":40335},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_4673":640,"_26077":570,"_22045":40337,"_5":26338,"_10236":40180,"_1794":40338},[],"Revocar una CA invalida la confianza en los certificados que ha emitido y puede interrumpir dispositivos y servicios. La acción es irreversible.",{"_4673":641,"_26077":570,"_22045":40340,"_5":26338,"_10236":40184,"_1794":40341},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_4673":642,"_26077":570,"_22045":40343,"_5":26338,"_10236":40188,"_1794":40344},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_4673":643,"_26077":570,"_22045":40346,"_5":26338,"_10236":40192,"_1794":40347},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_4673":644,"_26077":570,"_22045":40349,"_5":26338,"_10236":40196,"_1794":40350},[],"El estado debe cambiar a **REVOKED** y la CRL debe reflejar la nueva información. La CA deja de poder emitir certificados.",{"_4673":645,"_26077":570,"_22045":40352,"_5":26338,"_10236":40196,"_1794":40353},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_4673":646,"_26077":646,"_5":26333,"_1794":40355,"_26346":40356,"_22045":40357,"_10236":646},"Perfiles de certificado",[38338,39507,39660],[],{"_4673":647,"_26077":646,"_22045":40359,"_5":26338,"_10236":646,"_1794":40360},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_4673":648,"_26077":646,"_5":26343,"_22045":40362,"_10236":40363,"_1794":40364},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_4673":649,"_26077":646,"_5":26343,"_22045":40366,"_10236":40367,"_1794":40368},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#validez","Validez",{"_4673":650,"_26077":646,"_5":26343,"_22045":40370,"_10236":40371,"_1794":40372},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_4673":651,"_26077":646,"_5":26343,"_22045":40374,"_10236":40375,"_1794":40376},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_4673":652,"_26077":646,"_5":26343,"_22045":40378,"_10236":40379,"_1794":40380},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#sujeto","Sujeto",{"_4673":653,"_26077":646,"_5":26343,"_22045":40382,"_10236":40383,"_1794":40384},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_4673":654,"_26077":646,"_5":26343,"_22045":40386,"_10236":40387,"_1794":40388},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_4673":655,"_26077":646,"_5":26343,"_22045":40390,"_10236":40391,"_1794":40392},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_4673":656,"_26077":646,"_5":26343,"_22045":40394,"_10236":40395,"_1794":40396},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_4673":657,"_26077":646,"_5":26343,"_22045":40398,"_10236":40399,"_1794":40400},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_4673":658,"_26077":646,"_5":26343,"_22045":40402,"_10236":40403,"_1794":40404},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_4673":659,"_26077":646,"_5":26343,"_22045":40406,"_10236":40407,"_1794":40408},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_4673":660,"_26077":646,"_5":26343,"_22045":40410,"_10236":40411,"_1794":40412},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_4673":661,"_26077":646,"_5":26343,"_22045":40414,"_10236":40415,"_1794":40416},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_4673":662,"_26077":646,"_5":26343,"_22045":40418,"_10236":40419,"_1794":40420},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_4673":663,"_26077":646,"_5":26343,"_22045":40422,"_10236":40423,"_1794":40424},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_4673":664,"_26077":646,"_22045":40426,"_5":26338,"_10236":646,"_1794":40427},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_4673":665,"_26077":646,"_22045":40429,"_5":26338,"_10236":40367,"_1794":40430},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_4673":666,"_26077":646,"_22045":40432,"_5":26338,"_10236":40367,"_1794":40433},[],"La fecha final nunca debe superar la de la CA emisora.",{"_4673":667,"_26077":646,"_22045":40435,"_5":26338,"_10236":40371,"_1794":40436},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_4673":668,"_26077":646,"_22045":40438,"_5":26338,"_10236":40375,"_1794":40439},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_4673":669,"_26077":646,"_22045":40441,"_5":26338,"_10236":40375,"_1794":40442},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_4673":670,"_26077":646,"_22045":40444,"_5":26338,"_10236":40375,"_1794":40445},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_4673":671,"_26077":646,"_22045":40447,"_5":26338,"_10236":40379,"_1794":40448},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_4673":672,"_26077":646,"_22045":40450,"_5":26338,"_10236":40383,"_1794":40451},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_4673":673,"_26077":646,"_22045":40453,"_5":26338,"_10236":40383,"_1794":40454},[],"Este comportamiento permite aceptar DNS, IP, correo o URI como identidades alternativas sin aceptar extensiones arbitrarias.",{"_4673":674,"_26077":646,"_22045":40456,"_5":26338,"_10236":40387,"_1794":40457},[],"La aplicación criptográfica puede:",{"_4673":675,"_26077":646,"_22045":40459,"_5":26338,"_10236":40387,"_1794":40460},[],"permitir o bloquear claves RSA;",{"_4673":676,"_26077":646,"_22045":40462,"_5":26338,"_10236":40387,"_1794":40463},[],"limitar los tamaños RSA admitidos;",{"_4673":677,"_26077":646,"_22045":40465,"_5":26338,"_10236":40387,"_1794":40466},[],"permitir o bloquear claves ECDSA;",{"_4673":678,"_26077":646,"_22045":40468,"_5":26338,"_10236":40387,"_1794":40469},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_4673":679,"_26077":646,"_22045":40471,"_5":26338,"_10236":40387,"_1794":40472},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_4673":680,"_26077":646,"_22045":40474,"_5":26338,"_10236":40391,"_1794":40475},[],"En operaciones que admiten varias fuentes, Lamassu resuelve el perfil en este orden:",{"_4673":681,"_26077":646,"_22045":40477,"_5":26338,"_10236":40391,"_1794":40478},[],"Perfil enviado dentro de la operación.",{"_4673":682,"_26077":646,"_22045":40480,"_5":26338,"_10236":40391,"_1794":40481},[],"Identificador de perfil enviado en la operación.",{"_4673":683,"_26077":646,"_22045":40483,"_5":26338,"_10236":40391,"_1794":40484},[],"Perfil predeterminado asociado a la CA.",{"_4673":684,"_26077":646,"_22045":40486,"_5":26338,"_10236":40391,"_1794":40487},[],"Un DMS también puede referenciar su propio perfil de emisión. De este modo, varias flotas pueden usar la misma CA con políticas distintas.",{"_4673":685,"_26077":646,"_22045":40489,"_5":26338,"_10236":40399,"_1794":40490},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_4673":686,"_26077":646,"_22045":40492,"_5":26338,"_10236":40403,"_1794":40493},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_4673":687,"_26077":646,"_22045":40495,"_5":26338,"_10236":40407,"_1794":40496},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_4673":688,"_26077":646,"_22045":40498,"_5":26338,"_10236":40411,"_1794":40499},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_4673":689,"_26077":646,"_22045":40501,"_5":26338,"_10236":40415,"_1794":40502},[],"Asocia el perfil a una CA o DMS. Emite un certificado de prueba y comprueba sujeto, SAN, KU, EKU, restricciones básicas y fechas con una herramienta X.509 independiente.",{"_4673":690,"_26077":646,"_22045":40504,"_5":26338,"_10236":40419,"_1794":40505},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_4673":691,"_26077":646,"_22045":40507,"_5":26338,"_10236":40419,"_1794":40508},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_4673":692,"_26077":646,"_22045":40510,"_5":26338,"_10236":40419,"_1794":40511},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_4673":693,"_26077":646,"_22045":40513,"_5":26338,"_10236":40419,"_1794":40514},[],"Son patrones de partida, no una política universal. Verifica siempre los requisitos del protocolo, del consumidor y del marco regulatorio aplicable.",{"_4673":694,"_26077":646,"_22045":40516,"_5":26338,"_10236":40423,"_1794":40517},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_4673":695,"_26077":646,"_22045":40519,"_5":26338,"_10236":40423,"_1794":40520},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_4673":696,"_26077":696,"_5":26333,"_1794":40522,"_26346":40523,"_22045":40524,"_10236":696},"Validación de certificados",[38338,39507,39660],[],{"_4673":697,"_26077":696,"_22045":40526,"_5":26338,"_10236":696,"_1794":40527},[],"Publica el estado de las identidades mediante OCSP y CRL.",{"_4673":698,"_26077":696,"_5":26343,"_22045":40529,"_10236":40530,"_1794":40531},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_4673":699,"_26077":696,"_22045":40533,"_5":26338,"_10236":696,"_1794":40534},[],"La emisión demuestra quién firmó un certificado; la validación permite saber si todavía debe aceptarse. Lamassu publica el estado mediante dos mecanismos complementarios.",{"_4673":700,"_26077":696,"_22045":40536,"_5":26338,"_10236":40530,"_1794":40537},[],"Usa **OCSP** cuando el consumidor esté conectado y necesite consultar el estado más reciente de un certificado concreto.",{"_4673":701,"_26077":696,"_22045":40539,"_5":26338,"_10236":40530,"_1794":40540},[],"Usa una **CRL** cuando la validación deba realizarse localmente, sin conexión o sobre un volumen elevado de certificados. El consumidor descarga periódicamente una lista firmada y la conserva hasta la siguiente actualización.",{"_4673":702,"_26077":696,"_22045":40542,"_5":26338,"_10236":40530,"_1794":40543},[],"Muchos entornos utilizan ambos: OCSP como comprobación primaria y CRL como mecanismo local o de respaldo.",{"_4673":703,"_26077":696,"_22045":40545,"_5":26338,"_10236":40530,"_1794":40546},[],"<Card title=\"Validación online con OCSP\" description=\"Consulta estados Good, Revoked y Unknown en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_4673":704,"_26077":696,"_22045":40548,"_5":26338,"_10236":40530,"_1794":40549},[],"<Card title=\"Listas de revocación\" description=\"Genera, publica y distribuye CRLs por autoridad.\" href=\"/docs/platform/pki/crl\" />",{"_4673":705,"_26077":705,"_5":26333,"_1794":40551,"_26346":40552,"_22045":40553,"_10236":705},"Certificados",[38338,39507,39660],[],{"_4673":706,"_26077":705,"_22045":40555,"_5":26338,"_10236":705,"_1794":40556},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_4673":707,"_26077":705,"_5":26343,"_22045":40558,"_10236":40559,"_1794":40560},[],"/docs/pr-preview/pr-26/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_4673":708,"_26077":705,"_5":26343,"_22045":40562,"_10236":40563,"_1794":40564},[],"/docs/pr-preview/pr-26/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_4673":709,"_26077":705,"_5":26343,"_22045":40566,"_10236":40567,"_1794":40568},[],"/docs/pr-preview/pr-26/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_4673":710,"_26077":705,"_5":26343,"_22045":40570,"_10236":40571,"_1794":40572},[],"/docs/pr-preview/pr-26/platform/pki/certificates#abre-la-acción","Abre la acción",{"_4673":711,"_26077":705,"_5":26343,"_22045":40574,"_10236":40575,"_1794":40576},[],"/docs/pr-preview/pr-26/platform/pki/certificates#elige-una-razón","Elige una razón",{"_4673":712,"_26077":705,"_5":26343,"_22045":40578,"_10236":40579,"_1794":40580},[],"/docs/pr-preview/pr-26/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_4673":713,"_26077":705,"_5":26343,"_22045":40582,"_10236":40583,"_1794":40584},[],"/docs/pr-preview/pr-26/platform/pki/certificates#continúa","Continúa",{"_4673":714,"_26077":705,"_22045":40586,"_5":26338,"_10236":705,"_1794":40587},[],"El inventario de certificados ofrece una vista global de las identidades emitidas por todas las autoridades. También puedes abrir **Issued Certificates** dentro de una CA para limitar la vista a ese emisor.",{"_4673":715,"_26077":705,"_22045":40589,"_5":26338,"_10236":40559,"_1794":40590},[],"Abre **Certificates** y filtra por:",{"_4673":716,"_26077":705,"_22045":40592,"_5":26338,"_10236":40559,"_1794":40593},[],"`Common Name` del sujeto.",{"_4673":717,"_26077":705,"_22045":40595,"_5":26338,"_10236":40559,"_1794":40596},[],"Número de serie.",{"_4673":718,"_26077":705,"_22045":40598,"_5":26338,"_10236":40559,"_1794":40599},[],"Estado.",{"_4673":719,"_26077":705,"_22045":40601,"_5":26338,"_10236":40559,"_1794":40602},[],"Autoridad emisora.",{"_4673":720,"_26077":705,"_22045":40604,"_5":26338,"_10236":40559,"_1794":40605},[],"Utiliza **Quick Inspect** para una comprobación rápida o **View Details** para ver el sujeto, SANs, usos, cadena, periodo de validez y metadatos completos.",{"_4673":721,"_26077":705,"_22045":40607,"_5":26338,"_10236":40563,"_1794":40608},[],"La acción de descarga entrega el certificado en formato PEM. Si el certificado se emitió mediante un CSR externo, la clave privada permanece en el sistema que generó ese CSR. Si se generó en el navegador, la clave solo estuvo disponible al finalizar la emisión.",{"_4673":722,"_26077":705,"_22045":40610,"_5":26338,"_10236":40567,"_1794":40611},[],"Revoca una identidad cuando la clave se haya comprometido, el sujeto ya no esté autorizado o el certificado deba dejar de aceptarse antes de expirar.",{"_4673":723,"_26077":705,"_22045":40613,"_5":26338,"_10236":40571,"_1794":40614},[],"En el inventario o la vista de detalle, selecciona **Revoke Certificate**.",{"_4673":724,"_26077":705,"_22045":40616,"_5":26338,"_10236":40575,"_1794":40617},[],"Selecciona la razón que represente el incidente. Esta información se publica en OCSP y en la CRL.",{"_4673":725,"_26077":705,"_22045":40619,"_5":26338,"_10236":40579,"_1794":40620},[],"Confirma la operación y comprueba que el estado sea **Revoked**. Si la CA regenera la CRL al revocar, verifica también que exista una versión nueva.",{"_4673":726,"_26077":705,"_22045":40622,"_5":26338,"_10236":40579,"_1794":40623},[],"Una revocación con la razón `CertificateHold` puede reactivarse. Las demás razones producen una revocación definitiva.",{"_4673":727,"_26077":705,"_22045":40625,"_5":26338,"_10236":40583,"_1794":40626},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado de un certificado en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_4673":728,"_26077":705,"_22045":40628,"_5":26338,"_10236":40583,"_1794":40629},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación offline.\" href=\"/docs/platform/pki/crl\" />",{"_4673":729,"_26077":729,"_5":26333,"_1794":40631,"_26346":40632,"_22045":40634,"_10236":729},"Arquitectura de la plataforma",[38338,39507,40633],"Conceptos",[],{"_4673":730,"_26077":729,"_22045":40636,"_5":26338,"_10236":729,"_1794":40637},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_4673":731,"_26077":729,"_5":26343,"_22045":40639,"_10236":40640,"_1794":40641},[],"/docs/pr-preview/pr-26/platform/pki/concepts/architecture#plano-de-control","Plano de control",{"_4673":732,"_26077":729,"_5":26343,"_22045":40643,"_10236":40644,"_1794":40645},[],"/docs/pr-preview/pr-26/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_4673":733,"_26077":729,"_5":26343,"_22045":40647,"_10236":40648,"_1794":40649},[],"/docs/pr-preview/pr-26/platform/pki/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_4673":734,"_26077":729,"_5":26343,"_22045":40651,"_10236":40652,"_1794":40653},[],"/docs/pr-preview/pr-26/platform/pki/concepts/architecture#estado-y-validación","Estado y validación",{"_4673":735,"_26077":729,"_5":26343,"_22045":40655,"_10236":40656,"_1794":40657},[],"/docs/pr-preview/pr-26/platform/pki/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_4673":736,"_26077":729,"_22045":40659,"_5":26338,"_10236":729,"_1794":40660},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_4673":737,"_26077":729,"_22045":40662,"_5":26338,"_10236":40640,"_1794":40663},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_4673":738,"_26077":729,"_22045":40665,"_5":26338,"_10236":40644,"_1794":40666},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_4673":739,"_26077":729,"_22045":40668,"_5":26338,"_10236":40648,"_1794":40669},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_4673":740,"_26077":729,"_22045":40671,"_5":26338,"_10236":40652,"_1794":40672},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_4673":741,"_26077":729,"_22045":40674,"_5":26338,"_10236":40656,"_1794":40675},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_4673":742,"_26077":742,"_5":26333,"_1794":40677,"_26346":40678,"_22045":40679,"_10236":742},"Ciclo de vida de un certificado",[38338,39507,40633],[],{"_4673":743,"_26077":742,"_22045":40681,"_5":26338,"_10236":742,"_1794":40682},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_4673":744,"_26077":742,"_5":26343,"_22045":40684,"_10236":40685,"_1794":40686},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_4673":745,"_26077":742,"_5":26343,"_22045":40688,"_10236":40689,"_1794":40690},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_4673":746,"_26077":742,"_5":26343,"_22045":40692,"_10236":40693,"_1794":40694},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_4673":747,"_26077":742,"_5":26343,"_22045":40696,"_10236":40697,"_1794":40698},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_4673":748,"_26077":742,"_5":26343,"_22045":40700,"_10236":40701,"_1794":40702},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_4673":749,"_26077":742,"_5":26343,"_22045":40704,"_10236":40705,"_1794":40706},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_4673":750,"_26077":742,"_5":26343,"_22045":40708,"_10236":40709,"_1794":40710},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_4673":751,"_26077":742,"_5":26343,"_22045":40712,"_10236":40713,"_1794":40714},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_4673":752,"_26077":742,"_5":26343,"_22045":40716,"_10236":40717,"_1794":40718},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_4673":753,"_26077":742,"_5":26343,"_22045":40720,"_10236":40721,"_1794":40722},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_4673":754,"_26077":742,"_22045":40724,"_5":26338,"_10236":742,"_1794":40725},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_4673":755,"_26077":742,"_22045":40727,"_5":26338,"_10236":40689,"_1794":40728},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_4673":756,"_26077":742,"_22045":40730,"_5":26338,"_10236":40693,"_1794":40731},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_4673":757,"_26077":742,"_22045":40733,"_5":26338,"_10236":40697,"_1794":40734},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_4673":758,"_26077":742,"_22045":40736,"_5":26338,"_10236":40701,"_1794":40737},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_4673":759,"_26077":742,"_22045":40739,"_5":26338,"_10236":40705,"_1794":40740},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_4673":760,"_26077":742,"_22045":40742,"_5":26338,"_10236":40709,"_1794":40743},[],"Lamassu persiste cuatro estados X.509:",{"_4673":761,"_26077":742,"_22045":40745,"_5":26338,"_10236":40709,"_1794":40746},[],"**`ACTIVE`**: el certificado está habilitado y dentro de su periodo de validez.",{"_4673":762,"_26077":742,"_22045":40748,"_5":26338,"_10236":40709,"_1794":40749},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_4673":763,"_26077":742,"_22045":40751,"_5":26338,"_10236":40709,"_1794":40752},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_4673":764,"_26077":742,"_22045":40754,"_5":26338,"_10236":40709,"_1794":40755},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_4673":765,"_26077":742,"_22045":40757,"_5":26338,"_10236":40709,"_1794":40758},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_4673":766,"_26077":742,"_22045":40760,"_5":26338,"_10236":40713,"_1794":40761},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_4673":767,"_26077":742,"_22045":40763,"_5":26338,"_10236":40713,"_1794":40764},[],"Solo una revocación con razón `CertificateHold` puede revertirse. Una revocación con cualquier otra razón es definitiva en Lamassu.",{"_4673":768,"_26077":742,"_22045":40766,"_5":26338,"_10236":40713,"_1794":40767},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_4673":769,"_26077":742,"_22045":40769,"_5":26338,"_10236":40717,"_1794":40770},[],"Revocar una CA es una operación en cascada. Lamassu revoca sus CAs hijas y los certificados que ha emitido con la razón `CessationOfOperation`. La propagación continúa por la jerarquía.",{"_4673":770,"_26077":742,"_22045":40772,"_5":26338,"_10236":40717,"_1794":40773},[],"Antes de confirmar:",{"_4673":771,"_26077":742,"_22045":40775,"_5":26338,"_10236":40717,"_1794":40776},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_4673":772,"_26077":742,"_22045":40778,"_5":26338,"_10236":40717,"_1794":40779},[],"Distribuye la nueva cadena de confianza.",{"_4673":773,"_26077":742,"_22045":40781,"_5":26338,"_10236":40717,"_1794":40782},[],"Reemite las identidades necesarias.",{"_4673":774,"_26077":742,"_22045":40784,"_5":26338,"_10236":40717,"_1794":40785},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_4673":775,"_26077":742,"_22045":40787,"_5":26338,"_10236":40717,"_1794":40788},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_4673":776,"_26077":742,"_22045":40790,"_5":26338,"_10236":40717,"_1794":40791},[],"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente.",{"_4673":777,"_26077":742,"_22045":40793,"_5":26338,"_10236":40721,"_1794":40794},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_4673":778,"_26077":742,"_22045":40796,"_5":26338,"_10236":40721,"_1794":40797},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_4673":779,"_26077":742,"_22045":40799,"_5":26338,"_10236":40721,"_1794":40800},[],"Cambios de estado y razones de revocación.",{"_4673":780,"_26077":742,"_22045":40802,"_5":26338,"_10236":40721,"_1794":40803},[],"Publicación y vigencia de OCSP y CRLs.",{"_4673":781,"_26077":742,"_22045":40805,"_5":26338,"_10236":40721,"_1794":40806},[],"Dependencias que todavía presentan un certificado sustituido.",{"_4673":782,"_26077":742,"_22045":40808,"_5":26338,"_10236":40721,"_1794":40809},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_4673":783,"_26077":783,"_5":26333,"_1794":40811,"_26346":40812,"_22045":40813,"_10236":783},"Glosario",[38338,39507,40633],[],{"_4673":784,"_26077":783,"_22045":40815,"_5":26338,"_10236":783,"_1794":40816},[],"Términos de PKI, certificados y gestión de identidades usados en Lamassu.",{"_4673":785,"_26077":783,"_5":26343,"_22045":40818,"_10236":40819,"_1794":40820},[],"/docs/pr-preview/pr-26/platform/pki/concepts/glossary#ac","A–C",{"_4673":786,"_26077":783,"_5":26343,"_22045":40822,"_10236":40823,"_1794":40824},[],"/docs/pr-preview/pr-26/platform/pki/concepts/glossary#dk","D–K",{"_4673":787,"_26077":783,"_5":26343,"_22045":40826,"_10236":40827,"_1794":40828},[],"/docs/pr-preview/pr-26/platform/pki/concepts/glossary#mr","M–R",{"_4673":788,"_26077":783,"_5":26343,"_22045":40830,"_10236":40831,"_1794":40832},[],"/docs/pr-preview/pr-26/platform/pki/concepts/glossary#sz","S–Z",{"_4673":789,"_26077":783,"_22045":40834,"_5":26338,"_10236":40819,"_1794":40835},[],"**AKI (Authority Key Identifier)**\\\nIdentificador de la clave pública de la autoridad que firmó un certificado. Ayuda a construir la cadena hacia el emisor correcto.",{"_4673":790,"_26077":783,"_22045":40837,"_5":26338,"_10236":40819,"_1794":40838},[],"**Ancla de confianza**\\\nCertificado, normalmente de una CA raíz, que un consumidor acepta de forma explícita como punto final de una cadena.",{"_4673":791,"_26077":783,"_22045":40840,"_5":26338,"_10236":40819,"_1794":40841},[],"**CA (Certification Authority)**\\\nAutoridad que firma certificados y vincula una identidad con una clave pública.",{"_4673":792,"_26077":783,"_22045":40843,"_5":26338,"_10236":40819,"_1794":40844},[],"**CA intermedia**\\\nCA firmada por otra autoridad. Se utiliza para emitir sin exponer la raíz a la operación diaria.",{"_4673":793,"_26077":783,"_22045":40846,"_5":26338,"_10236":40819,"_1794":40847},[],"**CA raíz**\\\nCA autofirmada que inicia una jerarquía de confianza.",{"_4673":794,"_26077":783,"_22045":40849,"_5":26338,"_10236":40819,"_1794":40850},[],"**Certificado X.509**\\\nDocumento firmado que contiene una clave pública, un sujeto, un emisor, un periodo de validez y extensiones que delimitan su uso.",{"_4673":795,"_26077":783,"_22045":40852,"_5":26338,"_10236":40819,"_1794":40853},[],"**CRL (Certificate Revocation List)**\\\nLista firmada de certificados revocados publicada por una CA.",{"_4673":796,"_26077":783,"_22045":40855,"_5":26338,"_10236":40819,"_1794":40856},[],"**CSR (Certificate Signing Request)**\\\nSolicitud PKCS#10 que contiene una clave pública y atributos solicitados. La firma de la CSR demuestra posesión de la clave privada correspondiente.",{"_4673":797,"_26077":783,"_22045":40858,"_5":26338,"_10236":40823,"_1794":40859},[],"**DMS (Device Management Service)**\\\nConfiguración que agrupa reglas de registro, enrolamiento, re-enrolamiento, emisión y distribución de CAs para una flota.",{"_4673":798,"_26077":783,"_22045":40861,"_5":26338,"_10236":40823,"_1794":40862},[],"**Distinguished Name (DN)**\\\nConjunto de atributos del sujeto o emisor, como `CN`, `O`, `OU`, `C`, `ST` y `L`.",{"_4673":799,"_26077":783,"_22045":40864,"_5":26338,"_10236":40823,"_1794":40865},[],"**EST (Enrollment over Secure Transport)**\\\nProtocolo definido en RFC 7030 para obtener CAs, enrolar y re-enrolar certificados sobre HTTPS.",{"_4673":800,"_26077":783,"_22045":40867,"_5":26338,"_10236":40823,"_1794":40868},[],"**Extended Key Usage (EKU)**\\\nExtensión que acota finalidades como autenticación de cliente, autenticación de servidor, firma de código u OCSP.",{"_4673":801,"_26077":783,"_22045":40870,"_5":26338,"_10236":40823,"_1794":40871},[],"**Identidad de dispositivo**\\\nRelación entre un dispositivo y uno de sus certificados. Un dispositivo puede conservar un historial de identidades.",{"_4673":802,"_26077":783,"_22045":40873,"_5":26338,"_10236":40823,"_1794":40874},[],"**Identity slot**\\\nPosición lógica en un dispositivo donde Lamassu vincula una identidad activa o histórica.",{"_4673":803,"_26077":783,"_22045":40876,"_5":26338,"_10236":40823,"_1794":40877},[],"**JITP (Just-in-Time Provisioning)**\\\nRegistro automático de un dispositivo cuando completa correctamente su primer enrolamiento.",{"_4673":804,"_26077":783,"_22045":40879,"_5":26338,"_10236":40823,"_1794":40880},[],"**KMS (Key Management Service)**\\\nServicio de Lamassu que normaliza generación, importación y uso de claves sobre distintos motores criptográficos.",{"_4673":805,"_26077":783,"_22045":40882,"_5":26338,"_10236":40823,"_1794":40883},[],"**Key Usage**\\\nExtensión X.509 que permite operaciones básicas como firma digital, cifrado de clave o firma de certificados.",{"_4673":806,"_26077":783,"_22045":40885,"_5":26338,"_10236":40827,"_1794":40886},[],"**mTLS (Mutual TLS)**\\\nTLS donde cliente y servidor presentan certificados. Un DMS puede usar el certificado cliente como método de autenticación.",{"_4673":807,"_26077":783,"_22045":40888,"_5":26338,"_10236":40827,"_1794":40889},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocolo para consultar en línea si un certificado está vigente, revocado o es desconocido.",{"_4673":808,"_26077":783,"_22045":40891,"_5":26338,"_10236":40827,"_1794":40892},[],"**Perfil de emisión**\\\nPolítica reutilizable que define cómo Lamassu construye un certificado y qué claves acepta.",{"_4673":809,"_26077":783,"_22045":40894,"_5":26338,"_10236":40827,"_1794":40895},[],"**Principal**\\\nIdentidad de operador o cliente de API reconocida por el servicio de autorización. Lamassu admite principales OIDC y X.509.",{"_4673":810,"_26077":783,"_22045":40897,"_5":26338,"_10236":40827,"_1794":40898},[],"**Política**\\\nConjunto de permisos asignable a uno o varios principales.",{"_4673":811,"_26077":783,"_22045":40900,"_5":26338,"_10236":40827,"_1794":40901},[],"**RA (Registration Authority)**\\\nComponente que verifica al solicitante antes de pedir a una CA que emita. El DMS cumple este papel en los flujos de enrolamiento de dispositivos.",{"_4673":812,"_26077":783,"_22045":40903,"_5":26338,"_10236":40827,"_1794":40904},[],"**Relying party**\\\nSistema consumidor que decide si acepta un certificado presentado.",{"_4673":813,"_26077":783,"_22045":40906,"_5":26338,"_10236":40827,"_1794":40907},[],"**Revocación**\\\nInvalidación de un certificado antes de su fecha de expiración.",{"_4673":814,"_26077":783,"_22045":40909,"_5":26338,"_10236":40831,"_1794":40910},[],"**SAN (Subject Alternative Name)**\\\nExtensión que añade identidades como nombres DNS, direcciones IP, correos o URIs.",{"_4673":815,"_26077":783,"_22045":40912,"_5":26338,"_10236":40831,"_1794":40913},[],"**SKI (Subject Key Identifier)**\\\nIdentificador derivado de la clave pública del propio certificado.",{"_4673":816,"_26077":783,"_22045":40915,"_5":26338,"_10236":40831,"_1794":40916},[],"**VA (Validation Authority)**\\\nServicio de Lamassu responsable de las respuestas OCSP y la generación o publicación de CRLs.",{"_4673":817,"_26077":783,"_22045":40918,"_5":26338,"_10236":40831,"_1794":40919},[],"**Ventana de renovación**\\\nPeriodo anterior a la expiración durante el que un dispositivo puede o debe solicitar otra identidad.",{"_4673":818,"_26077":783,"_22045":40921,"_5":26338,"_10236":40831,"_1794":40922},[],"¿Falta un término operativo? Consulta primero Cómo funciona Lamassu y el Modelo de confianza, donde estos conceptos aparecen conectados.",{"_4673":819,"_26077":819,"_5":26333,"_1794":40924,"_26346":40925,"_22045":40926,"_10236":819},"Cómo funciona Lamassu",[38338,39507,40633],[],{"_4673":820,"_26077":819,"_22045":40928,"_5":26338,"_10236":819,"_1794":40929},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_4673":821,"_26077":819,"_5":26343,"_22045":40931,"_10236":40932,"_1794":40933},[],"/docs/pr-preview/pr-26/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_4673":822,"_26077":819,"_5":26343,"_22045":40935,"_10236":40936,"_1794":40937},[],"/docs/pr-preview/pr-26/platform/pki/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_4673":823,"_26077":819,"_22045":40939,"_5":26338,"_10236":819,"_1794":40940},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_4673":824,"_26077":819,"_22045":40942,"_5":26338,"_10236":40932,"_1794":40943},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_4673":825,"_26077":819,"_22045":40945,"_5":26338,"_10236":40932,"_1794":40946},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_4673":826,"_26077":819,"_22045":40948,"_5":26338,"_10236":40932,"_1794":40949},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_4673":827,"_26077":819,"_22045":40951,"_5":26338,"_10236":40932,"_1794":40952},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_4673":828,"_26077":819,"_22045":40954,"_5":26338,"_10236":40932,"_1794":40955},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_4673":829,"_26077":819,"_22045":40957,"_5":26338,"_10236":40936,"_1794":40958},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_4673":830,"_26077":819,"_22045":40960,"_5":26338,"_10236":40936,"_1794":40961},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_4673":831,"_26077":819,"_22045":40963,"_5":26338,"_10236":40936,"_1794":40964},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_4673":832,"_26077":819,"_22045":40966,"_5":26338,"_10236":40936,"_1794":40967},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_4673":833,"_26077":819,"_22045":40969,"_5":26338,"_10236":40936,"_1794":40970},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_4673":834,"_26077":819,"_22045":40972,"_5":26338,"_10236":40936,"_1794":40973},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_4673":835,"_26077":819,"_22045":40975,"_5":26338,"_10236":40936,"_1794":40976},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_4673":836,"_26077":836,"_5":26333,"_1794":40978,"_26346":40979,"_22045":40980,"_10236":836},"Modelo de confianza",[38338,39507,40633],[],{"_4673":837,"_26077":836,"_22045":40982,"_5":26338,"_10236":836,"_1794":40983},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_4673":838,"_26077":836,"_5":26343,"_22045":40985,"_10236":40986,"_1794":40987},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_4673":839,"_26077":836,"_5":26343,"_22045":40989,"_10236":40990,"_1794":40991},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_4673":840,"_26077":836,"_5":26343,"_22045":40993,"_10236":40994,"_1794":40995},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_4673":841,"_26077":836,"_5":26343,"_22045":40997,"_10236":40998,"_1794":40999},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_4673":842,"_26077":836,"_5":26343,"_22045":41001,"_10236":41002,"_1794":41003},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_4673":843,"_26077":836,"_5":26343,"_22045":41005,"_10236":41006,"_1794":41007},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_4673":844,"_26077":836,"_5":26343,"_22045":41009,"_10236":41010,"_1794":41011},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_4673":845,"_26077":836,"_5":26343,"_22045":41013,"_10236":41014,"_1794":41015},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_4673":846,"_26077":836,"_5":26343,"_22045":41017,"_10236":41018,"_1794":41019},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_4673":847,"_26077":836,"_5":26343,"_22045":41021,"_10236":41022,"_1794":41023},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_4673":848,"_26077":836,"_22045":41025,"_5":26338,"_10236":836,"_1794":41026},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_4673":849,"_26077":836,"_22045":41028,"_5":26338,"_10236":40990,"_1794":41029},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_4673":850,"_26077":836,"_22045":41031,"_5":26338,"_10236":40994,"_1794":41032},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_4673":851,"_26077":836,"_22045":41034,"_5":26338,"_10236":40998,"_1794":41035},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_4673":852,"_26077":836,"_22045":41037,"_5":26338,"_10236":41002,"_1794":41038},[],"El servicio o dispositivo consumidor mantiene su propio almacén de confianza. Lamassu puede distribuir la CA del sistema, la CA de enrolamiento y otras CAs gestionadas mediante `/cacerts`, pero el consumidor decide cuáles instala y cómo aplica la validación.",{"_4673":853,"_26077":836,"_22045":41040,"_5":26338,"_10236":41006,"_1794":41041},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_4673":854,"_26077":836,"_22045":41043,"_5":26338,"_10236":41006,"_1794":41044},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_4673":855,"_26077":836,"_22045":41046,"_5":26338,"_10236":41006,"_1794":41047},[],"La CA aplica el perfil y firma sin recibir la clave privada del dispositivo.",{"_4673":856,"_26077":836,"_22045":41049,"_5":26338,"_10236":41006,"_1794":41050},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_4673":857,"_26077":836,"_22045":41052,"_5":26338,"_10236":41006,"_1794":41053},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_4673":858,"_26077":836,"_22045":41055,"_5":26338,"_10236":41006,"_1794":41056},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_4673":859,"_26077":836,"_22045":41058,"_5":26338,"_10236":41010,"_1794":41059},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_4673":860,"_26077":836,"_22045":41061,"_5":26338,"_10236":41010,"_1794":41062},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_4673":861,"_26077":836,"_22045":41064,"_5":26338,"_10236":41010,"_1794":41065},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_4673":862,"_26077":836,"_22045":41067,"_5":26338,"_10236":41010,"_1794":41068},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir la CA del sistema, la CA de enrolamiento y una lista de CAs gestionadas.",{"_4673":863,"_26077":836,"_22045":41070,"_5":26338,"_10236":41010,"_1794":41071},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_4673":864,"_26077":836,"_22045":41073,"_5":26338,"_10236":41014,"_1794":41074},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_4673":865,"_26077":836,"_22045":41076,"_5":26338,"_10236":41014,"_1794":41077},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_4673":866,"_26077":836,"_22045":41079,"_5":26338,"_10236":41014,"_1794":41080},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_4673":867,"_26077":836,"_22045":41082,"_5":26338,"_10236":41014,"_1794":41083},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_4673":868,"_26077":836,"_22045":41085,"_5":26338,"_10236":41014,"_1794":41086},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_4673":869,"_26077":836,"_22045":41088,"_5":26338,"_10236":41014,"_1794":41089},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_4673":870,"_26077":836,"_22045":41091,"_5":26338,"_10236":41018,"_1794":41092},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_4673":871,"_26077":836,"_22045":41094,"_5":26338,"_10236":41022,"_1794":41095},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_4673":872,"_26077":836,"_22045":41097,"_5":26338,"_10236":41022,"_1794":41098},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_4673":873,"_26077":836,"_22045":41100,"_5":26338,"_10236":41022,"_1794":41101},[],"Asigna perfiles explícitos a cada caso de uso.",{"_4673":874,"_26077":836,"_22045":41103,"_5":26338,"_10236":41022,"_1794":41104},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_4673":875,"_26077":836,"_22045":41106,"_5":26338,"_10236":41022,"_1794":41107},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_4673":876,"_26077":836,"_22045":41109,"_5":26338,"_10236":41022,"_1794":41110},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_4673":877,"_26077":836,"_22045":41112,"_5":26338,"_10236":41022,"_1794":41113},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_4673":878,"_26077":878,"_5":26333,"_1794":41115,"_26346":41116,"_22045":41117,"_10236":878},"Listas de revocación (CRL)",[38338,39507,39660],[],{"_4673":879,"_26077":878,"_22045":41119,"_5":26338,"_10236":878,"_1794":41120},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_4673":880,"_26077":878,"_5":26343,"_22045":41122,"_10236":41123,"_1794":41124},[],"/docs/pr-preview/pr-26/platform/pki/crl#servicio-crl","Servicio CRL",{"_4673":881,"_26077":878,"_5":26343,"_22045":41126,"_10236":41127,"_1794":41128},[],"/docs/pr-preview/pr-26/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_4673":882,"_26077":878,"_5":26343,"_22045":41130,"_10236":41131,"_1794":41132},[],"/docs/pr-preview/pr-26/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_4673":883,"_26077":878,"_5":26343,"_22045":41134,"_10236":41135,"_1794":41136},[],"/docs/pr-preview/pr-26/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_4673":884,"_26077":878,"_5":26343,"_22045":41138,"_10236":41139,"_1794":41140},[],"/docs/pr-preview/pr-26/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_4673":885,"_26077":878,"_5":26343,"_22045":41142,"_10236":41143,"_1794":41144},[],"/docs/pr-preview/pr-26/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_4673":886,"_26077":878,"_5":26343,"_22045":41146,"_10236":41147,"_1794":41148},[],"/docs/pr-preview/pr-26/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_4673":887,"_26077":878,"_5":26343,"_22045":41150,"_10236":41151,"_1794":41152},[],"/docs/pr-preview/pr-26/platform/pki/crl#referencias","Referencias",{"_4673":888,"_26077":878,"_22045":41154,"_5":26338,"_10236":41123,"_1794":41155},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_4673":889,"_26077":878,"_22045":41157,"_5":26338,"_10236":41123,"_1794":41158},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_4673":890,"_26077":878,"_22045":41160,"_5":26338,"_10236":41127,"_1794":41161},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_4673":891,"_26077":878,"_22045":41163,"_5":26338,"_10236":41127,"_1794":41164},[],"Los parámetros principales son:",{"_4673":892,"_26077":878,"_22045":41166,"_5":26338,"_10236":41127,"_1794":41167},[],"**`validity`** define el periodo de validez reflejado en `nextUpdate`. Su valor predeterminado es 7 días.",{"_4673":893,"_26077":878,"_22045":41169,"_5":26338,"_10236":41127,"_1794":41170},[],"**`refresh_interval`** establece el intervalo mínimo entre regeneraciones programadas. Por defecto es aproximadamente 6 días y 23 horas.",{"_4673":894,"_26077":878,"_22045":41172,"_5":26338,"_10236":41127,"_1794":41173},[],"**`regenerate_on_revoke`** ordena publicar una versión nueva inmediatamente después de una revocación. Está activo por defecto.",{"_4673":895,"_26077":878,"_22045":41175,"_5":26338,"_10236":41127,"_1794":41176},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_4673":896,"_26077":878,"_22045":41178,"_5":26338,"_10236":41127,"_1794":41179},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_4673":897,"_26077":878,"_22045":41181,"_5":26338,"_10236":41131,"_1794":41182},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_4673":898,"_26077":878,"_22045":41184,"_5":26338,"_10236":41131,"_1794":41185},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_4673":899,"_26077":878,"_22045":41187,"_5":26338,"_10236":41135,"_1794":41188},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_4673":900,"_26077":878,"_22045":41190,"_5":26338,"_10236":41135,"_1794":41191},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_4673":901,"_26077":878,"_22045":41193,"_5":26338,"_10236":41139,"_1794":41194},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_4673":902,"_26077":878,"_22045":41196,"_5":26338,"_10236":41139,"_1794":41197},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_4673":903,"_26077":878,"_22045":41199,"_5":26338,"_10236":41143,"_1794":41200},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_4673":904,"_26077":878,"_22045":41202,"_5":26338,"_10236":41143,"_1794":41203},[],"Método",{"_4673":905,"_26077":878,"_22045":41205,"_5":26338,"_10236":41143,"_1794":41206},[],"Ruta",{"_4673":906,"_26077":878,"_22045":41208,"_5":26338,"_10236":41143,"_1794":38716},[],{"_4673":907,"_26077":878,"_22045":41210,"_5":26338,"_10236":41143,"_1794":41211},[],"`GET`",{"_4673":908,"_26077":878,"_22045":41213,"_5":26338,"_10236":41143,"_1794":41214},[],"`/v1/roles/{ca-ski}`",{"_4673":909,"_26077":878,"_22045":41216,"_5":26338,"_10236":41143,"_1794":41217},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_4673":910,"_26077":878,"_22045":41219,"_5":26338,"_10236":41143,"_1794":41220},[],"`PUT`",{"_4673":911,"_26077":878,"_22045":41222,"_5":26338,"_10236":41143,"_1794":41214},[],{"_4673":912,"_26077":878,"_22045":41224,"_5":26338,"_10236":41143,"_1794":41225},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_4673":913,"_26077":878,"_22045":41227,"_5":26338,"_10236":41143,"_1794":41228},[],"Ejemplo de consulta del rol VA:",{"_4673":914,"_26077":878,"_22045":41230,"_5":26338,"_10236":41143,"_1794":41231},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_4673":915,"_26077":878,"_22045":41233,"_5":26338,"_10236":41147,"_1794":41234},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_4673":916,"_26077":878,"_22045":41236,"_5":26338,"_10236":41151,"_1794":41237},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_4673":917,"_26077":878,"_22045":41239,"_5":26338,"_10236":41151,"_1794":41240},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_4673":918,"_26077":878,"_22045":41242,"_5":26338,"_10236":41151,"_1794":41243},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_4673":919,"_26077":919,"_5":26333,"_1794":41245,"_26346":41246,"_22045":41247,"_10236":919},"Device Management Service",[38338,39507,39660],[],{"_4673":920,"_26077":919,"_22045":41249,"_5":26338,"_10236":919,"_1794":41250},[],"Define cómo una flota recibe, renueva y utiliza sus identidades.",{"_4673":921,"_26077":919,"_5":26343,"_22045":41252,"_10236":41253,"_1794":38348},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#antes-de-empezar",{"_4673":922,"_26077":919,"_5":26343,"_22045":41255,"_10236":41256,"_1794":41257},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#configura-un-dms","Configura un DMS",{"_4673":923,"_26077":919,"_5":26343,"_22045":41259,"_10236":41260,"_1794":41261},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#identifica-la-flota","Identifica la flota",{"_4673":924,"_26077":919,"_5":26343,"_22045":41263,"_10236":41264,"_1794":41265},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_4673":925,"_26077":919,"_5":26343,"_22045":41267,"_10236":41268,"_1794":41269},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#configura-est","Configura EST",{"_4673":926,"_26077":919,"_5":26343,"_22045":41271,"_10236":41272,"_1794":41273},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#distribuye-la-confianza","Distribuye la confianza",{"_4673":927,"_26077":919,"_5":26343,"_22045":41275,"_10236":41276,"_1794":41277},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#verifica-los-endpoints","Verifica los endpoints",{"_4673":928,"_26077":919,"_5":26343,"_22045":41279,"_10236":41280,"_1794":41281},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#distribución-de-confianza","Distribución de confianza",{"_4673":929,"_26077":919,"_5":26343,"_22045":41283,"_10236":41284,"_1794":41285},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_4673":930,"_26077":919,"_5":26343,"_22045":41287,"_10236":41288,"_1794":41289},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#integra-los-dispositivos","Integra los dispositivos",{"_4673":931,"_26077":919,"_22045":41291,"_5":26338,"_10236":919,"_1794":41292},[],"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada.",{"_4673":932,"_26077":919,"_22045":41294,"_5":26338,"_10236":919,"_1794":41295},[],"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación.",{"_4673":933,"_26077":919,"_22045":41297,"_5":26338,"_10236":41253,"_1794":41298},[],"Crea o importa al menos una CA activa.",{"_4673":934,"_26077":919,"_22045":41300,"_5":26338,"_10236":41253,"_1794":41301},[],"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento.",{"_4673":935,"_26077":919,"_22045":41303,"_5":26338,"_10236":41253,"_1794":41304},[],"Define qué autoridades debe recibir el dispositivo como anclas de confianza.",{"_4673":936,"_26077":919,"_22045":41306,"_5":26338,"_10236":41253,"_1794":41307},[],"Asegúrate de tener permisos para administrar DMS.",{"_4673":937,"_26077":919,"_22045":41309,"_5":26338,"_10236":41260,"_1794":41310},[],"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno.",{"_4673":938,"_26077":919,"_22045":41312,"_5":26338,"_10236":41264,"_1794":41313},[],"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota.",{"_4673":939,"_26077":919,"_22045":41315,"_5":26338,"_10236":41268,"_1794":41316},[],"Define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, `serverkeygen`.",{"_4673":940,"_26077":919,"_22045":41318,"_5":26338,"_10236":41272,"_1794":41319},[],"Configura **CA Distribution** para controlar la respuesta del endpoint `cacerts`.",{"_4673":941,"_26077":919,"_22045":41321,"_5":26338,"_10236":41276,"_1794":41322},[],"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware.",{"_4673":942,"_26077":919,"_22045":41324,"_5":26338,"_10236":41280,"_1794":41325},[],"**Include Lamassu System CA** distribuye el certificado TLS del servidor Lamassu, útil para *pinning*. No representa una CA de emisión.",{"_4673":943,"_26077":919,"_22045":41327,"_5":26338,"_10236":41280,"_1794":41328},[],"**Include Enrollment CA** añade la autoridad configurada para emitir las identidades del DMS.",{"_4673":944,"_26077":919,"_22045":41330,"_5":26338,"_10236":41280,"_1794":41331},[],"**Managed CAs** permite incluir autoridades adicionales que el dispositivo debe considerar de confianza.",{"_4673":945,"_26077":919,"_22045":41333,"_5":26338,"_10236":41284,"_1794":41334},[],"**Edit** modifica la política del DMS.",{"_4673":946,"_26077":919,"_22045":41336,"_5":26338,"_10236":41284,"_1794":41337},[],"**Go to DMS owned devices** abre únicamente los dispositivos de esa flota.",{"_4673":947,"_26077":919,"_22045":41339,"_5":26338,"_10236":41284,"_1794":41340},[],"**Show/Edit Metadata** permite gestionar configuración avanzada y datos de integraciones.",{"_4673":948,"_26077":919,"_22045":41342,"_5":26338,"_10236":41284,"_1794":41343},[],"**EST (RFC-7030)** muestra los endpoints y ejemplos específicos del DMS.",{"_4673":949,"_26077":919,"_22045":41345,"_5":26338,"_10236":41284,"_1794":41346},[],"**Delete** elimina el DMS y su configuración. La acción es irreversible.",{"_4673":950,"_26077":919,"_22045":41348,"_5":26338,"_10236":41288,"_1794":41349},[],"<Card title=\"Enrolamiento EST\" description=\"Configura autenticación, endpoints y flujos para firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_4673":951,"_26077":919,"_22045":41351,"_5":26338,"_10236":41288,"_1794":41352},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta estados, historial y acciones operativas.\" href=\"/docs/platform/pki/device-management\" />",{"_4673":952,"_26077":952,"_5":26333,"_1794":41354,"_26346":41355,"_22045":41356,"_10236":952},"Dispositivos e identidades",[38338,39507,39660],[],{"_4673":953,"_26077":952,"_22045":41358,"_5":26338,"_10236":952,"_1794":41359},[],"Registra dispositivos y controla sus identidades durante todo el ciclo de vida.",{"_4673":954,"_26077":952,"_5":26343,"_22045":41361,"_10236":41362,"_1794":41363},[],"/docs/pr-preview/pr-26/platform/pki/device-management#estados-del-dispositivo","Estados del dispositivo",{"_4673":955,"_26077":952,"_5":26343,"_22045":41365,"_10236":41366,"_1794":41367},[],"/docs/pr-preview/pr-26/platform/pki/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_4673":956,"_26077":952,"_5":26343,"_22045":41369,"_10236":41370,"_1794":41371},[],"/docs/pr-preview/pr-26/platform/pki/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_4673":957,"_26077":952,"_5":26343,"_22045":41373,"_10236":41374,"_1794":41375},[],"/docs/pr-preview/pr-26/platform/pki/device-management#crea-el-dispositivo","Crea el dispositivo",{"_4673":958,"_26077":952,"_5":26343,"_22045":41377,"_10236":41378,"_1794":41379},[],"/docs/pr-preview/pr-26/platform/pki/device-management#define-su-pertenencia","Define su pertenencia",{"_4673":959,"_26077":952,"_5":26343,"_22045":41381,"_10236":41382,"_1794":41383},[],"/docs/pr-preview/pr-26/platform/pki/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_4673":960,"_26077":952,"_5":26343,"_22045":41385,"_10236":41386,"_1794":41387},[],"/docs/pr-preview/pr-26/platform/pki/device-management#verifica-el-alta","Verifica el alta",{"_4673":961,"_26077":952,"_5":26343,"_22045":41389,"_10236":41390,"_1794":41391},[],"/docs/pr-preview/pr-26/platform/pki/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_4673":962,"_26077":952,"_5":26343,"_22045":41393,"_10236":41394,"_1794":41395},[],"/docs/pr-preview/pr-26/platform/pki/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_4673":963,"_26077":952,"_5":26343,"_22045":41397,"_10236":41398,"_1794":41399},[],"/docs/pr-preview/pr-26/platform/pki/device-management#retira-un-dispositivo","Retira un dispositivo",{"_4673":964,"_26077":952,"_5":26343,"_22045":41401,"_10236":41402,"_1794":41403},[],"/docs/pr-preview/pr-26/platform/pki/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_4673":965,"_26077":952,"_22045":41405,"_5":26338,"_10236":952,"_1794":41406},[],"Un dispositivo gestionado representa una entidad de tu flota y conserva el historial de los certificados que ha utilizado. Lamassu separa el dispositivo de su identidad actual para que puedas renovar o sustituir certificados sin perder trazabilidad.",{"_4673":966,"_26077":952,"_22045":41408,"_5":26338,"_10236":41362,"_1794":41409},[],"**Active** indica que el dispositivo tiene una identidad válida.",{"_4673":967,"_26077":952,"_22045":41411,"_5":26338,"_10236":41362,"_1794":41412},[],"**No Identity** aparece cuando está registrado, pero todavía no tiene un certificado asociado.",{"_4673":968,"_26077":952,"_22045":41414,"_5":26338,"_10236":41362,"_1794":41415},[],"**Renewal Pending** señala que ha entrado en la ventana de renovación.",{"_4673":969,"_26077":952,"_22045":41417,"_5":26338,"_10236":41362,"_1794":41418},[],"**Expiring Soon** advierte que el certificado está próximo a expirar.",{"_4673":970,"_26077":952,"_22045":41420,"_5":26338,"_10236":41362,"_1794":41421},[],"**Expired** indica que la identidad ha superado su fecha de validez.",{"_4673":971,"_26077":952,"_22045":41423,"_5":26338,"_10236":41362,"_1794":41424},[],"**Revoked** identifica un certificado invalidado antes de su expiración.",{"_4673":972,"_26077":952,"_22045":41426,"_5":26338,"_10236":41362,"_1794":41427},[],"**Decommissioned** corresponde a un dispositivo retirado de forma permanente.",{"_4673":973,"_26077":952,"_22045":41429,"_5":26338,"_10236":41362,"_1794":41430},[],"El inventario permite filtrar por `Device ID`, etiquetas y estado.",{"_4673":974,"_26077":952,"_22045":41432,"_5":26338,"_10236":41366,"_1794":41433},[],"La vista de detalle separa dos perspectivas:",{"_4673":975,"_26077":952,"_22045":41435,"_5":26338,"_10236":41366,"_1794":41436},[],"**Certificate History** conserva todos los certificados asociados, con su número de serie, emisor, estado y periodo de validez.",{"_4673":976,"_26077":952,"_22045":41438,"_5":26338,"_10236":41366,"_1794":41439},[],"**Device Event Timeline** ordena cronológicamente registros, enrolamientos, renovaciones y cambios de estado.",{"_4673":977,"_26077":952,"_22045":41441,"_5":26338,"_10236":41366,"_1794":41442},[],"Utiliza el historial para auditoría y la línea de tiempo para reconstruir un incidente o diagnosticar una transición inesperada.",{"_4673":978,"_26077":952,"_22045":41444,"_5":26338,"_10236":41370,"_1794":41445},[],"El registro previo es útil cuando la política exige que el dispositivo exista antes de solicitar su primer certificado.",{"_4673":979,"_26077":952,"_22045":41447,"_5":26338,"_10236":41374,"_1794":41448},[],"Desde **Managed Devices**, abre el formulario de registro.",{"_4673":980,"_26077":952,"_22045":41450,"_5":26338,"_10236":41378,"_1794":41451},[],"Introduce un **Device ID** único y selecciona el DMS que aplicará las políticas de enrolamiento y renovación.",{"_4673":981,"_26077":952,"_22045":41453,"_5":26338,"_10236":41382,"_1794":41454},[],"Añade un icono y etiquetas si necesitas agruparlo por modelo, ubicación, entorno u otro criterio operativo.",{"_4673":982,"_26077":952,"_22045":41456,"_5":26338,"_10236":41386,"_1794":41457},[],"El dispositivo debe aparecer con estado **No Identity** hasta que complete el enrolamiento o reciba una identidad manual.",{"_4673":983,"_26077":952,"_22045":41459,"_5":26338,"_10236":41390,"_1794":41460},[],"La acción **Assign Identity** está disponible mientras el dispositivo permanece en **No Identity**.",{"_4673":984,"_26077":952,"_22045":41462,"_5":26338,"_10236":41390,"_1794":41463},[],"Abre el dispositivo y selecciona **Assign Identity**.",{"_4673":985,"_26077":952,"_22045":41465,"_5":26338,"_10236":41390,"_1794":41466},[],"Elige un certificado activo cuyo `Common Name` coincida con el `Device ID`.",{"_4673":986,"_26077":952,"_22045":41468,"_5":26338,"_10236":41390,"_1794":41469},[],"Si no existe, selecciona **Issue New Instead** y elige una CA vinculada al DMS.",{"_4673":987,"_26077":952,"_22045":41471,"_5":26338,"_10236":41390,"_1794":41472},[],"Confirma la asignación.",{"_4673":988,"_26077":952,"_22045":41474,"_5":26338,"_10236":41390,"_1794":41475},[],"El dispositivo debe cambiar a **Active** y el certificado debe aparecer en su historial.",{"_4673":989,"_26077":952,"_22045":41477,"_5":26338,"_10236":41394,"_1794":41478},[],"En **Device Event Timeline**, localiza el último certificado activo y selecciona **Revoke**. Elige una razón conforme a tu política y confirma la operación.",{"_4673":990,"_26077":952,"_22045":41480,"_5":26338,"_10236":41394,"_1794":41481},[],"La revocación invalida el certificado, pero no elimina el dispositivo. Puedes restaurar su operación asignándole una identidad nueva. `CertificateHold` permite reactivar el certificado retenido; el resto de razones son definitivas.",{"_4673":991,"_26077":952,"_22045":41483,"_5":26338,"_10236":41398,"_1794":41484},[],"Esta acción revoca todos los certificados del dispositivo e impide que vuelva a obtener una identidad.",{"_4673":992,"_26077":952,"_22045":41486,"_5":26338,"_10236":41398,"_1794":41487},[],"Usa **Decommission** únicamente cuando el dispositivo haya dejado de operar o ya no sea fiable. Tras confirmar, Lamassu revoca la identidad activa con `CessationOfOperation` y cambia el estado a **Decommissioned**.",{"_4673":993,"_26077":952,"_22045":41489,"_5":26338,"_10236":41402,"_1794":41490},[],"<Card title=\"Configura un DMS\" description=\"Define la CA, confianza y políticas de la flota.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_4673":994,"_26077":952,"_22045":41492,"_5":26338,"_10236":41402,"_1794":41493},[],"<Card title=\"Integra EST\" description=\"Permite que el dispositivo solicite y renueve su identidad.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_4673":995,"_26077":995,"_5":26333,"_1794":41495,"_26346":41496,"_22045":41497,"_10236":995},"Enrolamiento de dispositivos con EST",[38338,39507,39660],[],{"_4673":996,"_26077":995,"_22045":41499,"_5":26338,"_10236":995,"_1794":41500},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_4673":997,"_26077":995,"_5":26343,"_22045":41502,"_10236":41503,"_1794":41504},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_4673":998,"_26077":995,"_5":26343,"_22045":41506,"_10236":41507,"_1794":41508},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#configuración-del-dms","Configuración del DMS",{"_4673":999,"_26077":995,"_5":26343,"_22045":41510,"_10236":41511,"_1794":39207},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#requisitos-previos",{"_4673":1000,"_26077":995,"_5":26343,"_22045":41513,"_10236":41514,"_1794":41515},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#configuración-de-enrollment","Configuración de enrollment",{"_4673":1001,"_26077":995,"_5":26343,"_22045":41517,"_10236":41518,"_1794":41519},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_4673":1002,"_26077":995,"_5":26343,"_22045":41521,"_10236":41522,"_1794":41523},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_4673":1003,"_26077":995,"_5":26343,"_22045":41525,"_10236":41526,"_1794":41527},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#perfil-de-emisión","Perfil de emisión",{"_4673":1004,"_26077":995,"_5":26343,"_22045":41529,"_10236":41530,"_1794":41531},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#configuración-de-re-enrollment","Configuración de re-enrollment",{"_4673":1005,"_26077":995,"_5":26343,"_22045":41533,"_10236":41534,"_1794":41535},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_4673":1006,"_26077":995,"_5":26343,"_22045":41537,"_10236":41538,"_1794":41539},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#verificar-la-configuración","Verificar la configuración",{"_4673":1007,"_26077":995,"_5":26343,"_22045":41541,"_10236":41542,"_1794":41543},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#integración-de-dispositivos","Integración de dispositivos",{"_4673":1008,"_26077":995,"_5":26343,"_22045":41545,"_10236":41546,"_1794":38348},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#antes-de-empezar",{"_4673":1009,"_26077":995,"_5":26343,"_22045":41548,"_10236":41549,"_1794":41550},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#resumen-del-flujo","Resumen del flujo",{"_4673":1010,"_26077":995,"_5":26343,"_22045":41552,"_10236":41553,"_1794":41554},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_4673":1011,"_26077":995,"_5":26343,"_22045":41556,"_10236":41557,"_1794":41558},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#referencia-de-endpoints","Referencia de endpoints",{"_4673":1012,"_26077":995,"_5":26343,"_22045":41560,"_10236":41561,"_1794":41562},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_4673":1013,"_26077":995,"_5":26343,"_22045":41564,"_10236":41565,"_1794":41566},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_4673":1014,"_26077":995,"_5":26343,"_22045":41568,"_10236":41569,"_1794":41570},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_4673":1015,"_26077":995,"_5":26343,"_22045":41572,"_10236":41573,"_1794":41574},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_4673":1016,"_26077":995,"_5":26343,"_22045":41576,"_10236":41577,"_1794":41578},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#flujos-completos","Flujos completos",{"_4673":1017,"_26077":995,"_5":26343,"_22045":41580,"_10236":41581,"_1794":41582},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_4673":1018,"_26077":995,"_5":26343,"_22045":41584,"_10236":41585,"_1794":41586},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_4673":1019,"_26077":995,"_5":26343,"_22045":41588,"_10236":41589,"_1794":41590},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_4673":1020,"_26077":995,"_5":26343,"_22045":41592,"_10236":41593,"_1794":41594},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_4673":1021,"_26077":995,"_5":26343,"_22045":41596,"_10236":41597,"_1794":41598},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_4673":1022,"_26077":995,"_5":26343,"_22045":41600,"_10236":41601,"_1794":41602},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#notas-de-compatibilidad","Notas de compatibilidad",{"_4673":1023,"_26077":995,"_22045":41604,"_5":26338,"_10236":41503,"_1794":41605},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación. Así, actúa como autoridad de registro (RA) frente al cliente.",{"_4673":1024,"_26077":995,"_22045":41607,"_5":26338,"_10236":41503,"_1794":41608},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_4673":1025,"_26077":995,"_22045":41610,"_5":26338,"_10236":41503,"_1794":41611},[],"Esta guía está dividida en dos partes:",{"_4673":1026,"_26077":995,"_22045":41613,"_5":26338,"_10236":41503,"_1794":41614},[],"Configuración del DMS, para el administrador PKI.",{"_4673":1027,"_26077":995,"_22045":41616,"_5":26338,"_10236":41503,"_1794":41617},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_4673":1028,"_26077":995,"_22045":41619,"_5":26338,"_10236":41503,"_1794":41620},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_4673":1029,"_26077":995,"_22045":41622,"_5":26338,"_10236":41503,"_1794":41623},[],"**Administrador PKI:** empiece por Configuración del DMS y termine con Diagnóstico y compatibilidad.",{"_4673":1030,"_26077":995,"_22045":41625,"_5":26338,"_10236":41503,"_1794":41626},[],"**Integrador de dispositivos:** empiece por Antes de empezar y continúe con `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo que vaya a implementar.",{"_4673":1031,"_26077":995,"_22045":41628,"_5":26338,"_10236":41511,"_1794":41629},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_4673":1032,"_26077":995,"_22045":41631,"_5":26338,"_10236":41511,"_1794":41632},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_4673":1033,"_26077":995,"_22045":41634,"_5":26338,"_10236":41511,"_1794":41635},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_4673":1034,"_26077":995,"_22045":41637,"_5":26338,"_10236":41511,"_1794":41638},[],"Conviene separar cuatro bloques de configuración:",{"_4673":1035,"_26077":995,"_22045":41640,"_5":26338,"_10236":41511,"_1794":41641},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_4673":1036,"_26077":995,"_22045":41643,"_5":26338,"_10236":41511,"_1794":41644},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_4673":1037,"_26077":995,"_22045":41646,"_5":26338,"_10236":41511,"_1794":41647},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_4673":1038,"_26077":995,"_22045":41649,"_5":26338,"_10236":41511,"_1794":41650},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_4673":1039,"_26077":995,"_22045":41652,"_5":26338,"_10236":41518,"_1794":41653},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_4673":1040,"_26077":995,"_22045":41655,"_5":26338,"_10236":41518,"_1794":41656},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_4673":1041,"_26077":995,"_22045":41658,"_5":26338,"_10236":41518,"_1794":41659},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_4673":1042,"_26077":995,"_22045":41661,"_5":26338,"_10236":41518,"_1794":41662},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_4673":1043,"_26077":995,"_22045":41664,"_5":26338,"_10236":41522,"_1794":41665},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_4673":1044,"_26077":995,"_22045":41667,"_5":26338,"_10236":41522,"_1794":41668},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_4673":1045,"_26077":995,"_22045":41670,"_5":26338,"_10236":41522,"_1794":41671},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_4673":1046,"_26077":995,"_22045":41673,"_5":26338,"_10236":41522,"_1794":41674},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Puede exigir un certificado mTLS (`CLIENT_CERTIFICATE`), delegar la autorización en un webhook (`EXTERNAL_WEBHOOK`), combinar ambos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) o aceptar solicitudes sin autenticación (`NO_AUTH`). Este último modo debe limitarse a laboratorios o redes de aprovisionamiento aisladas.",{"_4673":1047,"_26077":995,"_22045":41676,"_5":26338,"_10236":41522,"_1794":41677},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_4673":1048,"_26077":995,"_22045":41679,"_5":26338,"_10236":41522,"_1794":41680},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_4673":1049,"_26077":995,"_22045":41682,"_5":26338,"_10236":41522,"_1794":41683},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_4673":1050,"_26077":995,"_22045":41685,"_5":26338,"_10236":41522,"_1794":41686},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_4673":1051,"_26077":995,"_22045":41688,"_5":26338,"_10236":41522,"_1794":41689},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_4673":1052,"_26077":995,"_22045":41691,"_5":26338,"_10236":41522,"_1794":41692},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_4673":1053,"_26077":995,"_22045":41694,"_5":26338,"_10236":41522,"_1794":41695},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_4673":1054,"_26077":995,"_22045":41697,"_5":26338,"_10236":41522,"_1794":41698},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_4673":1055,"_26077":995,"_22045":41700,"_5":26338,"_10236":41522,"_1794":41701},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_4673":1056,"_26077":995,"_22045":41703,"_5":26338,"_10236":41522,"_1794":41704},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_4673":1057,"_26077":995,"_22045":41706,"_5":26338,"_10236":41526,"_1794":41707},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_4673":1058,"_26077":995,"_22045":41709,"_5":26338,"_10236":41526,"_1794":41710},[],"**`HonorSubject`** controla si el subject del CSR se traslada literalmente al certificado. Si está desactivado, la CA aplica la plantilla del perfil e ignora el subject recibido.",{"_4673":1059,"_26077":995,"_22045":41712,"_5":26338,"_10236":41526,"_1794":41713},[],"**`HonorKeyUsage`** decide si se respeta el `KeyUsage` del CSR o se sustituye por el definido en la plantilla.",{"_4673":1060,"_26077":995,"_22045":41715,"_5":26338,"_10236":41526,"_1794":41716},[],"**`HonorExtendedKeyUsages`** aplica la misma regla a `ExtKeyUsage`.",{"_4673":1061,"_26077":995,"_22045":41718,"_5":26338,"_10236":41526,"_1794":41719},[],"**`HonorExtensions`** controla si el resto de extensiones del CSR, como SAN o CDP, se incluyen en el certificado.",{"_4673":1062,"_26077":995,"_22045":41721,"_5":26338,"_10236":41526,"_1794":41722},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_4673":1063,"_26077":995,"_22045":41724,"_5":26338,"_10236":41530,"_1794":41725},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_4673":1064,"_26077":995,"_22045":41727,"_5":26338,"_10236":41530,"_1794":41728},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_4673":1065,"_26077":995,"_22045":41730,"_5":26338,"_10236":41530,"_1794":41731},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_4673":1066,"_26077":995,"_22045":41733,"_5":26338,"_10236":41530,"_1794":41734},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_4673":1067,"_26077":995,"_22045":41736,"_5":26338,"_10236":41530,"_1794":41737},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_4673":1068,"_26077":995,"_22045":41739,"_5":26338,"_10236":41530,"_1794":41740},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_4673":1069,"_26077":995,"_22045":41742,"_5":26338,"_10236":41530,"_1794":41743},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_4673":1070,"_26077":995,"_22045":41745,"_5":26338,"_10236":41534,"_1794":41746},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_4673":1071,"_26077":995,"_22045":41748,"_5":26338,"_10236":41534,"_1794":41749},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_4673":1072,"_26077":995,"_22045":41751,"_5":26338,"_10236":41534,"_1794":41752},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_4673":1073,"_26077":995,"_22045":41754,"_5":26338,"_10236":41534,"_1794":41755},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_4673":1074,"_26077":995,"_22045":41757,"_5":26338,"_10236":41538,"_1794":41758},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_4673":1075,"_26077":995,"_22045":41760,"_5":26338,"_10236":41538,"_1794":41761},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_4673":1076,"_26077":995,"_22045":41763,"_5":26338,"_10236":41538,"_1794":41764},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_4673":1077,"_26077":995,"_22045":41766,"_5":26338,"_10236":41538,"_1794":41767},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_4673":1078,"_26077":995,"_22045":41769,"_5":26338,"_10236":41542,"_1794":41770},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_4673":1079,"_26077":995,"_22045":41772,"_5":26338,"_10236":41542,"_1794":41773},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_4673":1080,"_26077":995,"_22045":41775,"_5":26338,"_10236":41542,"_1794":41776},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_4673":1081,"_26077":995,"_22045":41778,"_5":26338,"_10236":41546,"_1794":41779},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_4673":1082,"_26077":995,"_22045":41781,"_5":26338,"_10236":41546,"_1794":41782},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_4673":1083,"_26077":995,"_22045":41784,"_5":26338,"_10236":41546,"_1794":41785},[],"**La URL del host EST**, por ejemplo `https://est.lamassu.example`, proporcionada por el administrador PKI.",{"_4673":1084,"_26077":995,"_22045":41787,"_5":26338,"_10236":41546,"_1794":41788},[],"**El ancla de confianza del servidor** (`lamassu-trust.pem`), raíz o intermedia, con la que el cliente validará el TLS de Lamassu.",{"_4673":1085,"_26077":995,"_22045":41790,"_5":26338,"_10236":41546,"_1794":41791},[],"**El certificado bootstrap y su clave privada** si el DMS usa `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Esta identidad debe proceder de una de las `ValidationCAs` configuradas, normalmente una CA de aprovisionamiento distinta de la CA de enrolamiento.",{"_4673":1086,"_26077":995,"_22045":41793,"_5":26338,"_10236":41546,"_1794":41794},[],"**El ID del DMS** (`{aps}`), que debe aparecer en todas las rutas EST.",{"_4673":1087,"_26077":995,"_22045":41796,"_5":26338,"_10236":41549,"_1794":41797},[],"**Descargue la confianza con `/cacerts`:** el cliente valida el TLS del servidor y recibe los certificados en PKCS#7 o PEM.",{"_4673":1088,"_26077":995,"_22045":41799,"_5":26338,"_10236":41549,"_1794":41800},[],"**Realice el alta inicial con `/simpleenroll`:** presente el certificado bootstrap o la credencial definida por `AuthMode` para obtener el certificado del dispositivo.",{"_4673":1089,"_26077":995,"_22045":41802,"_5":26338,"_10236":41549,"_1794":41803},[],"**Renueve con `/simplereenroll`:** autentíquese con el certificado actual del dispositivo para obtener uno nuevo.",{"_4673":1090,"_26077":995,"_22045":41805,"_5":26338,"_10236":41549,"_1794":41806},[],"**Use `/serverkeygen` solo si necesita generación de claves en servidor:** aplica la misma autenticación que `/simpleenroll` y devuelve la clave privada PKCS#8 junto con el certificado.",{"_4673":1091,"_26077":995,"_22045":41808,"_5":26338,"_10236":41553,"_1794":41809},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_4673":1092,"_26077":995,"_22045":41811,"_5":26338,"_10236":41553,"_1794":41812},[],"Modo (`AuthMode`)",{"_4673":1093,"_26077":995,"_22045":41814,"_5":26338,"_10236":41553,"_1794":38716},[],{"_4673":1094,"_26077":995,"_22045":41816,"_5":26338,"_10236":41553,"_1794":41817},[],"Credencial esperada",{"_4673":1095,"_26077":995,"_22045":41819,"_5":26338,"_10236":41553,"_1794":41820},[],"Aplica en enroll",{"_4673":1096,"_26077":995,"_22045":41822,"_5":26338,"_10236":41553,"_1794":41823},[],"Aplica en reenroll",{"_4673":1097,"_26077":995,"_22045":41825,"_5":26338,"_10236":41553,"_1794":41826},[],"`CLIENT_CERTIFICATE`",{"_4673":1098,"_26077":995,"_22045":41828,"_5":26338,"_10236":41553,"_1794":41829},[],"mTLS con certificado X.509",{"_4673":1099,"_26077":995,"_22045":41831,"_5":26338,"_10236":41553,"_1794":41832},[],"Certificado y clave privada cliente",{"_4673":1100,"_26077":995,"_22045":41834,"_5":26338,"_10236":41553,"_1794":41835},[],"Sí",{"_4673":1101,"_26077":995,"_22045":41837,"_5":26338,"_10236":41553,"_1794":41838},[],"Sí (con el certificado en vigor)",{"_4673":1102,"_26077":995,"_22045":41840,"_5":26338,"_10236":41553,"_1794":41841},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_4673":1103,"_26077":995,"_22045":41843,"_5":26338,"_10236":41553,"_1794":41844},[],"mTLS más validación por webhook",{"_4673":1104,"_26077":995,"_22045":41846,"_5":26338,"_10236":41553,"_1794":41847},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_4673":1105,"_26077":995,"_22045":41849,"_5":26338,"_10236":41553,"_1794":41835},[],{"_4673":1106,"_26077":995,"_22045":41851,"_5":26338,"_10236":41553,"_1794":41852},[],"No como combinación; en reenroll no mantiene ambos controles",{"_4673":1107,"_26077":995,"_22045":41854,"_5":26338,"_10236":41553,"_1794":41855},[],"`EXTERNAL_WEBHOOK`",{"_4673":1108,"_26077":995,"_22045":41857,"_5":26338,"_10236":41553,"_1794":41858},[],"Webhook externo de autorización",{"_4673":1109,"_26077":995,"_22045":41860,"_5":26338,"_10236":41553,"_1794":41861},[],"Ninguna en el canal TLS",{"_4673":1110,"_26077":995,"_22045":41863,"_5":26338,"_10236":41553,"_1794":41835},[],{"_4673":1111,"_26077":995,"_22045":41865,"_5":26338,"_10236":41553,"_1794":41866},[],"No, degrada a `NO_AUTH`",{"_4673":1112,"_26077":995,"_22045":41868,"_5":26338,"_10236":41553,"_1794":41869},[],"`NO_AUTH`",{"_4673":1113,"_26077":995,"_22045":41871,"_5":26338,"_10236":41553,"_1794":41872},[],"Sin autenticación",{"_4673":1114,"_26077":995,"_22045":41874,"_5":26338,"_10236":41553,"_1794":41875},[],"Ninguna",{"_4673":1115,"_26077":995,"_22045":41877,"_5":26338,"_10236":41553,"_1794":41878},[],"Sí (uso restringido)",{"_4673":1116,"_26077":995,"_22045":41880,"_5":26338,"_10236":41553,"_1794":41878},[],{"_4673":1117,"_26077":995,"_22045":41882,"_5":26338,"_10236":41553,"_1794":41883},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_4673":1118,"_26077":995,"_22045":41885,"_5":26338,"_10236":41553,"_1794":41886},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_4673":1119,"_26077":995,"_22045":41888,"_5":26338,"_10236":41553,"_1794":41889},[],"Sus parámetros principales son `ValidationCAs`, la lista de CAs que pueden validar el certificado bootstrap o el certificado en vigor; `AllowExpired`, que permite aceptar certificados cliente caducados; y `ChainLevelValidation`, que limita la profundidad de la cadena cuando su valor es mayor que cero.",{"_4673":1120,"_26077":995,"_22045":41891,"_5":26338,"_10236":41553,"_1794":41892},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_4673":1121,"_26077":995,"_22045":41894,"_5":26338,"_10236":41553,"_1794":41895},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_4673":1122,"_26077":995,"_22045":41897,"_5":26338,"_10236":41553,"_1794":41898},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll`. El cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_4673":1123,"_26077":995,"_22045":41900,"_5":26338,"_10236":41553,"_1794":41901},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_4673":1124,"_26077":995,"_22045":41903,"_5":26338,"_10236":41557,"_1794":41904},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_4673":1125,"_26077":995,"_22045":41906,"_5":26338,"_10236":41557,"_1794":41907},[],"`/cacerts`: descarga de la cadena de confianza.",{"_4673":1126,"_26077":995,"_22045":41909,"_5":26338,"_10236":41557,"_1794":41910},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_4673":1127,"_26077":995,"_22045":41912,"_5":26338,"_10236":41557,"_1794":41913},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_4673":1128,"_26077":995,"_22045":41915,"_5":26338,"_10236":41557,"_1794":41916},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_4673":1129,"_26077":995,"_22045":41918,"_5":26338,"_10236":41561,"_1794":41919},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_4673":1130,"_26077":995,"_22045":41921,"_5":26338,"_10236":41561,"_1794":41922},[],"`CADistributionSettings` permite decidir qué se publica:",{"_4673":1131,"_26077":995,"_22045":41924,"_5":26338,"_10236":41561,"_1794":41925},[],"**`IncludeLamassuSystemCA`** añade el certificado *downstream* del servidor Lamassu. Es la hoja TLS que el cliente puede usar para anclar la conexión, no una CA.",{"_4673":1132,"_26077":995,"_22045":41927,"_5":26338,"_10236":41561,"_1794":41928},[],"**`IncludeEnrollmentCA`** añade la CA emisora del DMS, responsable de firmar los certificados de dispositivo.",{"_4673":1133,"_26077":995,"_22045":41930,"_5":26338,"_10236":41561,"_1794":41931},[],"**`ManagedCAs`** publica CAs adicionales como anclas de confianza.",{"_4673":1134,"_26077":995,"_22045":41933,"_5":26338,"_10236":41561,"_1794":41934},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_4673":1135,"_26077":995,"_22045":41936,"_5":26338,"_10236":41561,"_1794":41937},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_4673":1136,"_26077":995,"_22045":41939,"_5":26338,"_10236":41561,"_1794":41940},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_4673":1137,"_26077":995,"_22045":41942,"_5":26338,"_10236":41561,"_1794":41943},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_4673":1138,"_26077":995,"_22045":41945,"_5":26338,"_10236":41565,"_1794":41946},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_4673":1139,"_26077":995,"_22045":41948,"_5":26338,"_10236":41565,"_1794":41949},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_4673":1140,"_26077":995,"_22045":41951,"_5":26338,"_10236":41565,"_1794":41952},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos:",{"_4673":1141,"_26077":995,"_22045":41954,"_5":26338,"_10236":41565,"_1794":41955},[],"**`EnrollmentSettings.RegistrationMode`** decide si el dispositivo se crea durante la primera inscripción (`JITP`) o debe existir previamente (`PRE_REGISTRATION`).",{"_4673":1142,"_26077":995,"_22045":41957,"_5":26338,"_10236":41565,"_1794":41958},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** permite repetir `/simpleenroll` para un dispositivo ya enrolado. Al hacerlo, revoca el certificado anterior como `superseded`; si está desactivado, el servidor responde con `forbiddenNewEnrollment`.",{"_4673":1143,"_26077":995,"_22045":41960,"_5":26338,"_10236":41565,"_1794":41961},[],"**`EnrollmentSettings.VerifyCSRSignature`** valida que quien envía el CSR controla la clave privada declarada. Para flotas IoT en redes abiertas debe estar activo.",{"_4673":1144,"_26077":995,"_22045":41963,"_5":26338,"_10236":41565,"_1794":41964},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_4673":1145,"_26077":995,"_22045":41966,"_5":26338,"_10236":41569,"_1794":41967},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_4673":1146,"_26077":995,"_22045":41969,"_5":26338,"_10236":41569,"_1794":41970},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_4673":1147,"_26077":995,"_22045":41972,"_5":26338,"_10236":41569,"_1794":41973},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_4673":1148,"_26077":995,"_22045":41975,"_5":26338,"_10236":41569,"_1794":41976},[],"**`ReEnrollmentDelta`** abre la ventana de renovación en `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_4673":1149,"_26077":995,"_22045":41978,"_5":26338,"_10236":41569,"_1794":41979},[],"**`EnableExpiredRenewal`** permite usar un certificado ya caducado como prueba de identidad; si está desactivado, el servidor responde con `expired certificate`.",{"_4673":1150,"_26077":995,"_22045":41981,"_5":26338,"_10236":41569,"_1794":41982},[],"**`RevokeOnReEnrollment`** revoca el certificado anterior como `superseded` después de emitir el nuevo.",{"_4673":1151,"_26077":995,"_22045":41984,"_5":26338,"_10236":41569,"_1794":41985},[],"**`AdditionalValidationCAs`** añade emisores válidos para el certificado actual, además de la CA de enrolamiento del DMS.",{"_4673":1152,"_26077":995,"_22045":41987,"_5":26338,"_10236":41569,"_1794":41988},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_4673":1153,"_26077":995,"_22045":41990,"_5":26338,"_10236":41569,"_1794":41991},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_4673":1154,"_26077":995,"_22045":41993,"_5":26338,"_10236":41573,"_1794":41994},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_4673":1155,"_26077":995,"_22045":41996,"_5":26338,"_10236":41573,"_1794":41997},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_4673":1156,"_26077":995,"_22045":41999,"_5":26338,"_10236":41573,"_1794":42000},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_4673":1157,"_26077":995,"_22045":42002,"_5":26338,"_10236":41573,"_1794":42003},[],"**RSA** admite cualquier tamaño aceptado por `crypto/rsa`; los valores habituales son 2048, 3072 y 4096 bits. Un valor no válido hace fallar la generación con un error `500`.",{"_4673":1158,"_26077":995,"_22045":42005,"_5":26338,"_10236":41573,"_1794":42006},[],"**ECDSA** admite 224, 256, 384 y 521 bits, equivalentes a P-224, P-256 (`prime256v1`), P-384 y P-521. Cualquier otro valor degrada **silenciosamente** a P-256 y solo deja un aviso en el log: el cliente no recibe un error y puede obtener una curva distinta de la esperada.",{"_4673":1159,"_26077":995,"_22045":42008,"_5":26338,"_10236":41573,"_1794":42009},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_4673":1160,"_26077":995,"_22045":42011,"_5":26338,"_10236":41573,"_1794":42012},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_4673":1161,"_26077":995,"_22045":42014,"_5":26338,"_10236":41573,"_1794":42015},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_4673":1162,"_26077":995,"_22045":42017,"_5":26338,"_10236":41573,"_1794":42018},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_4673":1163,"_26077":995,"_22045":42020,"_5":26338,"_10236":41573,"_1794":42021},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_4673":1164,"_26077":995,"_22045":42023,"_5":26338,"_10236":41573,"_1794":42024},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_4673":1165,"_26077":995,"_22045":42026,"_5":26338,"_10236":41573,"_1794":42027},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_4673":1166,"_26077":995,"_22045":42029,"_5":26338,"_10236":41577,"_1794":42030},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_4673":1167,"_26077":995,"_22045":42032,"_5":26338,"_10236":41581,"_1794":42033},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_4673":1168,"_26077":995,"_22045":42035,"_5":26338,"_10236":41585,"_1794":42036},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_4673":1169,"_26077":995,"_22045":42038,"_5":26338,"_10236":41589,"_1794":42039},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_4673":1170,"_26077":995,"_22045":42041,"_5":26338,"_10236":41589,"_1794":42042},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_4673":1171,"_26077":995,"_22045":42044,"_5":26338,"_10236":41589,"_1794":42045},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_4673":1172,"_26077":995,"_22045":42047,"_5":26338,"_10236":41589,"_1794":42048},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_4673":1173,"_26077":995,"_22045":42050,"_5":26338,"_10236":41597,"_1794":42051},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_4673":1174,"_26077":995,"_22045":42053,"_5":26338,"_10236":41597,"_1794":42054},[],"HTTP",{"_4673":1175,"_26077":995,"_22045":42056,"_5":26338,"_10236":41597,"_1794":42057},[],"Mensaje",{"_4673":1176,"_26077":995,"_22045":42059,"_5":26338,"_10236":41597,"_1794":42060},[],"Causa",{"_4673":1177,"_26077":995,"_22045":42062,"_5":26338,"_10236":41597,"_1794":42063},[],"Acción del integrador",{"_4673":1178,"_26077":995,"_22045":42065,"_5":26338,"_10236":41597,"_1794":24268},[],{"_4673":1179,"_26077":995,"_22045":42067,"_5":26338,"_10236":41597,"_1794":42068},[],"`Field validation for 'APS' failed`",{"_4673":1180,"_26077":995,"_22045":42070,"_5":26338,"_10236":41597,"_1794":42071},[],"El segmento `{aps}` falta en la URL.",{"_4673":1181,"_26077":995,"_22045":42073,"_5":26338,"_10236":41597,"_1794":42074},[],"Incluir el ID del DMS en la ruta.",{"_4673":1182,"_26077":995,"_22045":42076,"_5":26338,"_10236":41597,"_1794":24268},[],{"_4673":1183,"_26077":995,"_22045":42078,"_5":26338,"_10236":41597,"_1794":42079},[],"`content-type must be application/pkcs10`",{"_4673":1184,"_26077":995,"_22045":42081,"_5":26338,"_10236":41597,"_1794":42082},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_4673":1185,"_26077":995,"_22045":42084,"_5":26338,"_10236":41597,"_1794":42085},[],"Fijar `Content-Type: application/pkcs10`.",{"_4673":1186,"_26077":995,"_22045":42087,"_5":26338,"_10236":41597,"_1794":24268},[],{"_4673":1187,"_26077":995,"_22045":42089,"_5":26338,"_10236":41597,"_1794":42090},[],"`body payload must be base64 encoded`",{"_4673":1188,"_26077":995,"_22045":42092,"_5":26338,"_10236":41597,"_1794":42093},[],"El cuerpo no es base64 válido.",{"_4673":1189,"_26077":995,"_22045":42095,"_5":26338,"_10236":41597,"_1794":42096},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_4673":1190,"_26077":995,"_22045":42098,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1191,"_26077":995,"_22045":42100,"_5":26338,"_10236":41597,"_1794":42101},[],"`DMS not found`",{"_4673":1192,"_26077":995,"_22045":42103,"_5":26338,"_10236":41597,"_1794":42104},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_4673":1193,"_26077":995,"_22045":42106,"_5":26338,"_10236":41597,"_1794":42107},[],"Verificar el identificador con el administrador PKI.",{"_4673":1194,"_26077":995,"_22045":42109,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1195,"_26077":995,"_22045":42111,"_5":26338,"_10236":41597,"_1794":42112},[],"`invalid certificate`",{"_4673":1196,"_26077":995,"_22045":42114,"_5":26338,"_10236":41597,"_1794":42115},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_4673":1197,"_26077":995,"_22045":42117,"_5":26338,"_10236":41597,"_1794":42118},[],"Comprobar la cadena del certificado bootstrap.",{"_4673":1198,"_26077":995,"_22045":42120,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1199,"_26077":995,"_22045":42122,"_5":26338,"_10236":41597,"_1794":42123},[],"`certificate is revoked`",{"_4673":1200,"_26077":995,"_22045":42125,"_5":26338,"_10236":41597,"_1794":42126},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_4673":1201,"_26077":995,"_22045":42128,"_5":26338,"_10236":41597,"_1794":42129},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_4673":1202,"_26077":995,"_22045":42131,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1203,"_26077":995,"_22045":42133,"_5":26338,"_10236":41597,"_1794":42134},[],"`revoked certificate`",{"_4673":1204,"_26077":995,"_22045":42136,"_5":26338,"_10236":41597,"_1794":42137},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_4673":1205,"_26077":995,"_22045":42139,"_5":26338,"_10236":41597,"_1794":42140},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_4673":1206,"_26077":995,"_22045":42142,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1207,"_26077":995,"_22045":42144,"_5":26338,"_10236":41597,"_1794":42145},[],"`expired certificate`",{"_4673":1208,"_26077":995,"_22045":42147,"_5":26338,"_10236":41597,"_1794":42148},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_4673":1209,"_26077":995,"_22045":42150,"_5":26338,"_10236":41597,"_1794":42151},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_4673":1210,"_26077":995,"_22045":42153,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1211,"_26077":995,"_22045":42155,"_5":26338,"_10236":41597,"_1794":42156},[],"`forbiddenNewEnrollment`",{"_4673":1212,"_26077":995,"_22045":42158,"_5":26338,"_10236":41597,"_1794":42159},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_4673":1213,"_26077":995,"_22045":42161,"_5":26338,"_10236":41597,"_1794":42162},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_4673":1214,"_26077":995,"_22045":42164,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1215,"_26077":995,"_22045":42166,"_5":26338,"_10236":41597,"_1794":42167},[],"`device not preregistered`",{"_4673":1216,"_26077":995,"_22045":42169,"_5":26338,"_10236":41597,"_1794":42170},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_4673":1217,"_26077":995,"_22045":42172,"_5":26338,"_10236":41597,"_1794":42173},[],"Registrar el dispositivo antes de inscribirlo.",{"_4673":1218,"_26077":995,"_22045":42175,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1219,"_26077":995,"_22045":42177,"_5":26338,"_10236":41597,"_1794":42178},[],"`invalid reenroll window`",{"_4673":1220,"_26077":995,"_22045":42180,"_5":26338,"_10236":41597,"_1794":42181},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_4673":1221,"_26077":995,"_22045":42183,"_5":26338,"_10236":41597,"_1794":42184},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_4673":1222,"_26077":995,"_22045":42186,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1223,"_26077":995,"_22045":42188,"_5":26338,"_10236":41597,"_1794":42189},[],"`invalid RawSubject bytes`",{"_4673":1224,"_26077":995,"_22045":42191,"_5":26338,"_10236":41597,"_1794":42192},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_4673":1225,"_26077":995,"_22045":42194,"_5":26338,"_10236":41597,"_1794":42195},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_4673":1226,"_26077":995,"_22045":42197,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1227,"_26077":995,"_22045":42199,"_5":26338,"_10236":41597,"_1794":42200},[],"`external webhook denied enrollment`",{"_4673":1228,"_26077":995,"_22045":42202,"_5":26338,"_10236":41597,"_1794":42203},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_4673":1229,"_26077":995,"_22045":42205,"_5":26338,"_10236":41597,"_1794":42206},[],"Revisar los logs del servicio webhook.",{"_4673":1230,"_26077":995,"_22045":42208,"_5":26338,"_10236":41597,"_1794":23730},[],{"_4673":1231,"_26077":995,"_22045":42210,"_5":26338,"_10236":41597,"_1794":42211},[],"`server key generation not enabled`",{"_4673":1232,"_26077":995,"_22045":42213,"_5":26338,"_10236":41597,"_1794":42214},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_4673":1233,"_26077":995,"_22045":42216,"_5":26338,"_10236":41597,"_1794":42217},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_4673":1234,"_26077":995,"_22045":42219,"_5":26338,"_10236":41597,"_1794":42220},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_4673":1235,"_26077":995,"_22045":42222,"_5":26338,"_10236":41601,"_1794":42223},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_4673":1236,"_26077":995,"_22045":42225,"_5":26338,"_10236":41601,"_1794":42226},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_4673":1237,"_26077":995,"_22045":42228,"_5":26338,"_10236":41601,"_1794":42229},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_4673":1238,"_26077":995,"_22045":42231,"_5":26338,"_10236":41601,"_1794":42232},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_4673":1239,"_26077":995,"_22045":42234,"_5":26338,"_10236":41601,"_1794":42235},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_4673":1240,"_26077":995,"_22045":42237,"_5":26338,"_10236":41601,"_1794":42238},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_4673":1241,"_26077":995,"_22045":42240,"_5":26338,"_10236":41601,"_1794":42241},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_4673":1242,"_26077":995,"_22045":42243,"_5":26338,"_10236":41601,"_1794":42244},[],"<Card title=\"Visión general del DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_4673":1243,"_26077":995,"_22045":42246,"_5":26338,"_10236":41601,"_1794":42247},[],"<Card title=\"Validación OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_4673":1244,"_26077":995,"_22045":42249,"_5":26338,"_10236":41601,"_1794":42250},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/platform/pki/device-management\" />",{"_4673":1245,"_26077":1245,"_5":26333,"_1794":42252,"_26346":42253,"_22045":42255,"_10236":1245},"AWS IoT Core",[38338,39507,42254],"Integraciones",[],{"_4673":1246,"_26077":1245,"_22045":42257,"_5":26338,"_10236":1245,"_1794":42258},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_4673":1247,"_26077":1245,"_5":26343,"_22045":42260,"_10236":42261,"_1794":42262},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_4673":1248,"_26077":1245,"_5":26343,"_22045":42264,"_10236":42265,"_1794":42266},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_4673":1249,"_26077":1245,"_5":26343,"_22045":42268,"_10236":42269,"_1794":42270},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_4673":1250,"_26077":1245,"_5":26343,"_22045":42272,"_10236":42273,"_1794":42274},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_4673":1251,"_26077":1245,"_5":26343,"_22045":42276,"_10236":42277,"_1794":42278},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_4673":1252,"_26077":1245,"_5":26343,"_22045":42280,"_10236":42281,"_1794":42282},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_4673":1253,"_26077":1245,"_5":26343,"_22045":42284,"_10236":42285,"_1794":42286},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_4673":1254,"_26077":1245,"_5":26343,"_22045":42288,"_10236":42289,"_1794":42290},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_4673":1255,"_26077":1245,"_5":26343,"_22045":42292,"_10236":42293,"_1794":41508},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#configuración-del-dms",{"_4673":1256,"_26077":1245,"_5":26343,"_22045":42295,"_10236":42296,"_1794":42297},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#modo-none","Modo `none`",{"_4673":1257,"_26077":1245,"_5":26343,"_22045":42299,"_10236":42300,"_1794":42301},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_4673":1258,"_26077":1245,"_5":26343,"_22045":42303,"_10236":42304,"_1794":42305},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_4673":1259,"_26077":1245,"_5":26343,"_22045":42307,"_10236":42308,"_1794":42309},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_4673":1260,"_26077":1245,"_5":26343,"_22045":42311,"_10236":42312,"_1794":42313},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_4673":1261,"_26077":1245,"_5":26343,"_22045":42315,"_10236":42316,"_1794":42317},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_4673":1262,"_26077":1245,"_5":26343,"_22045":42319,"_10236":42320,"_1794":42321},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_4673":1263,"_26077":1245,"_5":26343,"_22045":42323,"_10236":42324,"_1794":42325},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_4673":1264,"_26077":1245,"_5":26343,"_22045":42327,"_10236":42328,"_1794":42329},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_4673":1265,"_26077":1245,"_5":26343,"_22045":42331,"_10236":42332,"_1794":42333},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_4673":1266,"_26077":1245,"_5":26343,"_22045":42335,"_10236":42336,"_1794":42337},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_4673":1267,"_26077":1245,"_22045":42339,"_5":26338,"_10236":1245,"_1794":42340},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_4673":1268,"_26077":1245,"_22045":42342,"_5":26338,"_10236":1245,"_1794":42343},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_4673":1269,"_26077":1245,"_22045":42345,"_5":26338,"_10236":1245,"_1794":42346},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_4673":1270,"_26077":1245,"_22045":42348,"_5":26338,"_10236":42261,"_1794":42349},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_4673":1271,"_26077":1245,"_22045":42351,"_5":26338,"_10236":42261,"_1794":42352},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_4673":1272,"_26077":1245,"_22045":42354,"_5":26338,"_10236":42261,"_1794":42355},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_4673":1273,"_26077":1245,"_22045":42357,"_5":26338,"_10236":42261,"_1794":42358},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_4673":1274,"_26077":1245,"_22045":42360,"_5":26338,"_10236":42265,"_1794":42361},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_4673":1275,"_26077":1245,"_22045":42363,"_5":26338,"_10236":42269,"_1794":42364},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_4673":1276,"_26077":1245,"_22045":42366,"_5":26338,"_10236":42269,"_1794":42367},[],"Acción IAM",{"_4673":1277,"_26077":1245,"_22045":42369,"_5":26338,"_10236":42269,"_1794":42370},[],"Propósito",{"_4673":1278,"_26077":1245,"_22045":42372,"_5":26338,"_10236":42269,"_1794":42373},[],"`iot:GetRegistrationCode`",{"_4673":1279,"_26077":1245,"_22045":42375,"_5":26338,"_10236":42269,"_1794":42376},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_4673":1280,"_26077":1245,"_22045":42378,"_5":26338,"_10236":42269,"_1794":42379},[],"`iot:RegisterCACertificate`",{"_4673":1281,"_26077":1245,"_22045":42381,"_5":26338,"_10236":42269,"_1794":42382},[],"Registrar la CA en AWS IoT",{"_4673":1282,"_26077":1245,"_22045":42384,"_5":26338,"_10236":42269,"_1794":42385},[],"`iot:DescribeCACertificate`",{"_4673":1283,"_26077":1245,"_22045":42387,"_5":26338,"_10236":42269,"_1794":42388},[],"Consultar el estado del registro de la CA",{"_4673":1284,"_26077":1245,"_22045":42390,"_5":26338,"_10236":42269,"_1794":42391},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_4673":1285,"_26077":1245,"_22045":42393,"_5":26338,"_10236":42269,"_1794":42394},[],"Crear o actualizar Things en IoT Core",{"_4673":1286,"_26077":1245,"_22045":42396,"_5":26338,"_10236":42269,"_1794":42397},[],"`iot:RegisterThing`",{"_4673":1287,"_26077":1245,"_22045":42399,"_5":26338,"_10236":42269,"_1794":42400},[],"Aprovisionar Things mediante plantilla",{"_4673":1288,"_26077":1245,"_22045":42402,"_5":26338,"_10236":42269,"_1794":42403},[],"`iot:RegisterCertificate`",{"_4673":1289,"_26077":1245,"_22045":42405,"_5":26338,"_10236":42269,"_1794":42406},[],"Registrar certificados de dispositivo",{"_4673":1290,"_26077":1245,"_22045":42408,"_5":26338,"_10236":42269,"_1794":42409},[],"`iot:UpdateCertificate`",{"_4673":1291,"_26077":1245,"_22045":42411,"_5":26338,"_10236":42269,"_1794":42412},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_4673":1292,"_26077":1245,"_22045":42414,"_5":26338,"_10236":42269,"_1794":42415},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_4673":1293,"_26077":1245,"_22045":42417,"_5":26338,"_10236":42269,"_1794":42418},[],"Crear y adjuntar políticas IoT",{"_4673":1294,"_26077":1245,"_22045":42420,"_5":26338,"_10236":42269,"_1794":42421},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_4673":1295,"_26077":1245,"_22045":42423,"_5":26338,"_10236":42269,"_1794":42424},[],"Gestionar grupos de Things",{"_4673":1296,"_26077":1245,"_22045":42426,"_5":26338,"_10236":42269,"_1794":42427},[],"`iot:CreateProvisioningTemplate`",{"_4673":1297,"_26077":1245,"_22045":42429,"_5":26338,"_10236":42269,"_1794":42430},[],"Crear plantillas JITP",{"_4673":1298,"_26077":1245,"_22045":42432,"_5":26338,"_10236":42269,"_1794":42433},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_4673":1299,"_26077":1245,"_22045":42435,"_5":26338,"_10236":42269,"_1794":42436},[],"Leer y escribir el Device Shadow",{"_4673":1300,"_26077":1245,"_22045":42438,"_5":26338,"_10236":42269,"_1794":42439},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_4673":1301,"_26077":1245,"_22045":42441,"_5":26338,"_10236":42273,"_1794":42442},[],"Parámetro",{"_4673":1302,"_26077":1245,"_22045":42444,"_5":26338,"_10236":42273,"_1794":42445},[],"Tipo",{"_4673":1303,"_26077":1245,"_22045":42447,"_5":26338,"_10236":42273,"_1794":42448},[],"Requerido",{"_4673":1304,"_26077":1245,"_22045":42450,"_5":26338,"_10236":42273,"_1794":38716},[],{"_4673":1305,"_26077":1245,"_22045":42452,"_5":26338,"_10236":42273,"_1794":42453},[],"`connector_id`",{"_4673":1306,"_26077":1245,"_22045":42455,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1307,"_26077":1245,"_22045":42457,"_5":26338,"_10236":42273,"_1794":41835},[],{"_4673":1308,"_26077":1245,"_22045":42459,"_5":26338,"_10236":42273,"_1794":42460},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_4673":1309,"_26077":1245,"_22045":42462,"_5":26338,"_10236":42273,"_1794":42463},[],"`aws_config.region`",{"_4673":1310,"_26077":1245,"_22045":42465,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1311,"_26077":1245,"_22045":42467,"_5":26338,"_10236":42273,"_1794":41835},[],{"_4673":1312,"_26077":1245,"_22045":42469,"_5":26338,"_10236":42273,"_1794":42470},[],"Región AWS donde opera el conector.",{"_4673":1313,"_26077":1245,"_22045":42472,"_5":26338,"_10236":42273,"_1794":42473},[],"`aws_config.auth_method`",{"_4673":1314,"_26077":1245,"_22045":42475,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1315,"_26077":1245,"_22045":42477,"_5":26338,"_10236":42273,"_1794":41835},[],{"_4673":1316,"_26077":1245,"_22045":42479,"_5":26338,"_10236":42273,"_1794":42480},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_4673":1317,"_26077":1245,"_22045":42482,"_5":26338,"_10236":42273,"_1794":42483},[],"`aws_config.access_key_id`",{"_4673":1318,"_26077":1245,"_22045":42485,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1319,"_26077":1245,"_22045":42487,"_5":26338,"_10236":42273,"_1794":42488},[],"Solo con `auth_method=static`",{"_4673":1320,"_26077":1245,"_22045":42490,"_5":26338,"_10236":42273,"_1794":42491},[],"Clave de acceso AWS.",{"_4673":1321,"_26077":1245,"_22045":42493,"_5":26338,"_10236":42273,"_1794":42494},[],"`aws_config.secret_access_key`",{"_4673":1322,"_26077":1245,"_22045":42496,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1323,"_26077":1245,"_22045":42498,"_5":26338,"_10236":42273,"_1794":42488},[],{"_4673":1324,"_26077":1245,"_22045":42500,"_5":26338,"_10236":42273,"_1794":42501},[],"Clave secreta AWS.",{"_4673":1325,"_26077":1245,"_22045":42503,"_5":26338,"_10236":42273,"_1794":42504},[],"`aws_config.session_token`",{"_4673":1326,"_26077":1245,"_22045":42506,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1327,"_26077":1245,"_22045":42508,"_5":26338,"_10236":42273,"_1794":42509},[],"No",{"_4673":1328,"_26077":1245,"_22045":42511,"_5":26338,"_10236":42273,"_1794":42512},[],"Token de sesión (con `auth_method=static`).",{"_4673":1329,"_26077":1245,"_22045":42514,"_5":26338,"_10236":42273,"_1794":42515},[],"`aws_config.role_arn`",{"_4673":1330,"_26077":1245,"_22045":42517,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1331,"_26077":1245,"_22045":42519,"_5":26338,"_10236":42273,"_1794":42520},[],"Solo con `auth_method=role`",{"_4673":1332,"_26077":1245,"_22045":42522,"_5":26338,"_10236":42273,"_1794":42523},[],"ARN del rol a asumir.",{"_4673":1333,"_26077":1245,"_22045":42525,"_5":26338,"_10236":42273,"_1794":42526},[],"`aws_config.endpoint_url`",{"_4673":1334,"_26077":1245,"_22045":42528,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1335,"_26077":1245,"_22045":42530,"_5":26338,"_10236":42273,"_1794":42509},[],{"_4673":1336,"_26077":1245,"_22045":42532,"_5":26338,"_10236":42273,"_1794":42533},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_4673":1337,"_26077":1245,"_22045":42535,"_5":26338,"_10236":42273,"_1794":42536},[],"`subscriber_event_bus`",{"_4673":1338,"_26077":1245,"_22045":42538,"_5":26338,"_10236":42273,"_1794":16887},[],{"_4673":1339,"_26077":1245,"_22045":42540,"_5":26338,"_10236":42273,"_1794":41835},[],{"_4673":1340,"_26077":1245,"_22045":42542,"_5":26338,"_10236":42273,"_1794":42543},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_4673":1341,"_26077":1245,"_22045":42545,"_5":26338,"_10236":42273,"_1794":42546},[],"`dms_manager_client`",{"_4673":1342,"_26077":1245,"_22045":42548,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1343,"_26077":1245,"_22045":42550,"_5":26338,"_10236":42273,"_1794":41835},[],{"_4673":1344,"_26077":1245,"_22045":42552,"_5":26338,"_10236":42273,"_1794":42553},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_4673":1345,"_26077":1245,"_22045":42555,"_5":26338,"_10236":42273,"_1794":42556},[],"`device_manager_client`",{"_4673":1346,"_26077":1245,"_22045":42558,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1347,"_26077":1245,"_22045":42560,"_5":26338,"_10236":42273,"_1794":41835},[],{"_4673":1348,"_26077":1245,"_22045":42562,"_5":26338,"_10236":42273,"_1794":42563},[],"URL HTTP del Device Manager de Lamassu.",{"_4673":1349,"_26077":1245,"_22045":42565,"_5":26338,"_10236":42273,"_1794":42566},[],"`ca_client`",{"_4673":1350,"_26077":1245,"_22045":42568,"_5":26338,"_10236":42273,"_1794":21699},[],{"_4673":1351,"_26077":1245,"_22045":42570,"_5":26338,"_10236":42273,"_1794":41835},[],{"_4673":1352,"_26077":1245,"_22045":42572,"_5":26338,"_10236":42273,"_1794":42573},[],"URL HTTP del servicio de CA de Lamassu.",{"_4673":1353,"_26077":1245,"_22045":42575,"_5":26338,"_10236":42277,"_1794":42576},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_4673":1354,"_26077":1245,"_22045":42578,"_5":26338,"_10236":42281,"_1794":42579},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_4673":1355,"_26077":1245,"_22045":42581,"_5":26338,"_10236":42281,"_1794":42582},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_4673":1356,"_26077":1245,"_22045":42584,"_5":26338,"_10236":42285,"_1794":42585},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_4673":1357,"_26077":1245,"_22045":42587,"_5":26338,"_10236":42285,"_1794":42588},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_4673":1358,"_26077":1245,"_22045":42590,"_5":26338,"_10236":42285,"_1794":42591},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_4673":1359,"_26077":1245,"_22045":42593,"_5":26338,"_10236":42285,"_1794":42594},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_4673":1360,"_26077":1245,"_22045":42596,"_5":26338,"_10236":42285,"_1794":42597},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_4673":1361,"_26077":1245,"_22045":42599,"_5":26338,"_10236":42285,"_1794":42600},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_4673":1362,"_26077":1245,"_22045":42602,"_5":26338,"_10236":42289,"_1794":42603},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_4673":1363,"_26077":1245,"_22045":42605,"_5":26338,"_10236":42293,"_1794":42606},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_4673":1364,"_26077":1245,"_22045":42608,"_5":26338,"_10236":42293,"_1794":42609},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_4673":1365,"_26077":1245,"_22045":42611,"_5":26338,"_10236":42296,"_1794":42612},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_4673":1366,"_26077":1245,"_22045":42614,"_5":26338,"_10236":42300,"_1794":42615},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_4673":1367,"_26077":1245,"_22045":42617,"_5":26338,"_10236":42300,"_1794":42618},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_4673":1368,"_26077":1245,"_22045":42620,"_5":26338,"_10236":42300,"_1794":42621},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_4673":1369,"_26077":1245,"_22045":42623,"_5":26338,"_10236":42300,"_1794":42624},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_4673":1370,"_26077":1245,"_22045":42626,"_5":26338,"_10236":42300,"_1794":42627},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_4673":1371,"_26077":1245,"_22045":42629,"_5":26338,"_10236":42300,"_1794":42630},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_4673":1372,"_26077":1245,"_22045":42632,"_5":26338,"_10236":42304,"_1794":42633},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_4673":1373,"_26077":1245,"_22045":42635,"_5":26338,"_10236":42304,"_1794":42636},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_4673":1374,"_26077":1245,"_22045":42638,"_5":26338,"_10236":42304,"_1794":42639},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_4673":1375,"_26077":1245,"_22045":42641,"_5":26338,"_10236":42308,"_1794":42642},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_4673":1376,"_26077":1245,"_22045":42644,"_5":26338,"_10236":42308,"_1794":42645},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_4673":1377,"_26077":1245,"_22045":42647,"_5":26338,"_10236":42308,"_1794":42648},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_4673":1378,"_26077":1245,"_22045":42650,"_5":26338,"_10236":42312,"_1794":42651},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_4673":1379,"_26077":1245,"_22045":42653,"_5":26338,"_10236":42312,"_1794":42654},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_4673":1380,"_26077":1245,"_22045":42656,"_5":26338,"_10236":42312,"_1794":42657},[],"Para que el flujo JITP funcione correctamente:",{"_4673":1381,"_26077":1245,"_22045":42659,"_5":26338,"_10236":42312,"_1794":42660},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_4673":1382,"_26077":1245,"_22045":42662,"_5":26338,"_10236":42312,"_1794":42663},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_4673":1383,"_26077":1245,"_22045":42665,"_5":26338,"_10236":42312,"_1794":42666},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_4673":1384,"_26077":1245,"_22045":42668,"_5":26338,"_10236":42312,"_1794":42669},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_4673":1385,"_26077":1245,"_22045":42671,"_5":26338,"_10236":42316,"_1794":42672},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_4673":1386,"_26077":1245,"_22045":42674,"_5":26338,"_10236":42316,"_1794":42675},[],"Estado en Lamassu",{"_4673":1387,"_26077":1245,"_22045":42677,"_5":26338,"_10236":42316,"_1794":42678},[],"Razón de revocación",{"_4673":1388,"_26077":1245,"_22045":42680,"_5":26338,"_10236":42316,"_1794":42681},[],"Estado en AWS IoT Core",{"_4673":1389,"_26077":1245,"_22045":42683,"_5":26338,"_10236":42316,"_1794":42684},[],"`Active`",{"_4673":1390,"_26077":1245,"_22045":42686,"_5":26338,"_10236":42316,"_1794":41875},[],{"_4673":1391,"_26077":1245,"_22045":42688,"_5":26338,"_10236":42316,"_1794":42689},[],"`ACTIVE`",{"_4673":1392,"_26077":1245,"_22045":42691,"_5":26338,"_10236":42316,"_1794":42692},[],"`Revoked`",{"_4673":1393,"_26077":1245,"_22045":42694,"_5":26338,"_10236":42316,"_1794":42695},[],"`certificateHold`",{"_4673":1394,"_26077":1245,"_22045":42697,"_5":26338,"_10236":42316,"_1794":42698},[],"`INACTIVE`",{"_4673":1395,"_26077":1245,"_22045":42700,"_5":26338,"_10236":42316,"_1794":42692},[],{"_4673":1396,"_26077":1245,"_22045":42702,"_5":26338,"_10236":42316,"_1794":42703},[],"Cualquier otra razón",{"_4673":1397,"_26077":1245,"_22045":42705,"_5":26338,"_10236":42316,"_1794":42706},[],"`REVOKED`",{"_4673":1398,"_26077":1245,"_22045":42708,"_5":26338,"_10236":42316,"_1794":42709},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_4673":1399,"_26077":1245,"_22045":42711,"_5":26338,"_10236":42320,"_1794":42712},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_4673":1400,"_26077":1245,"_22045":42714,"_5":26338,"_10236":42320,"_1794":42715},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_4673":1401,"_26077":1245,"_22045":42717,"_5":26338,"_10236":42320,"_1794":42718},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_4673":1402,"_26077":1245,"_22045":42720,"_5":26338,"_10236":42324,"_1794":42721},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_4673":1403,"_26077":1245,"_22045":42723,"_5":26338,"_10236":42324,"_1794":42724},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_4673":1404,"_26077":1245,"_22045":42726,"_5":26338,"_10236":42328,"_1794":42727},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_4673":1405,"_26077":1245,"_22045":42729,"_5":26338,"_10236":42328,"_1794":42730},[],"Existen dos tipos de acciones:",{"_4673":1406,"_26077":1245,"_22045":42732,"_5":26338,"_10236":42328,"_1794":42733},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_4673":1407,"_26077":1245,"_22045":42735,"_5":26338,"_10236":42328,"_1794":42736},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_4673":1408,"_26077":1245,"_22045":42738,"_5":26338,"_10236":42328,"_1794":42739},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_4673":1409,"_26077":1245,"_22045":42741,"_5":26338,"_10236":42332,"_1794":42742},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_4673":1410,"_26077":1245,"_22045":42744,"_5":26338,"_10236":42332,"_1794":42745},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_4673":1411,"_26077":1245,"_22045":42747,"_5":26338,"_10236":42332,"_1794":42748},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_4673":1412,"_26077":1245,"_22045":42750,"_5":26338,"_10236":42336,"_1794":42751},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_4673":1413,"_26077":1245,"_22045":42753,"_5":26338,"_10236":42336,"_1794":42754},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_4673":1414,"_26077":1245,"_22045":42756,"_5":26338,"_10236":42336,"_1794":42757},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_4673":1415,"_26077":1245,"_22045":42759,"_5":26338,"_10236":42336,"_1794":42760},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_4673":1416,"_26077":1245,"_22045":42762,"_5":26338,"_10236":42336,"_1794":42763},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_4673":1417,"_26077":1245,"_22045":42765,"_5":26338,"_10236":42336,"_1794":42766},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_4673":1418,"_26077":1245,"_22045":42768,"_5":26338,"_10236":42336,"_1794":42769},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_4673":1419,"_26077":1245,"_22045":42771,"_5":26338,"_10236":42336,"_1794":42772},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_4673":1420,"_26077":1245,"_22045":42774,"_5":26338,"_10236":42336,"_1794":42775},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_4673":1421,"_26077":1245,"_22045":42777,"_5":26338,"_10236":42336,"_1794":42778},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_4673":1422,"_26077":1245,"_22045":42780,"_5":26338,"_10236":42336,"_1794":42781},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_4673":1423,"_26077":1245,"_22045":42783,"_5":26338,"_10236":42336,"_1794":42784},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_4673":1424,"_26077":1245,"_22045":42786,"_5":26338,"_10236":42336,"_1794":42787},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_4673":1425,"_26077":1245,"_22045":42789,"_5":26338,"_10236":42336,"_1794":42790},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_4673":1426,"_26077":1245,"_22045":42792,"_5":26338,"_10236":42336,"_1794":42793},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_4673":1427,"_26077":1245,"_22045":42795,"_5":26338,"_10236":42336,"_1794":42796},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_4673":1428,"_26077":1245,"_22045":42798,"_5":26338,"_10236":42336,"_1794":42799},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_4673":1429,"_26077":1245,"_22045":42801,"_5":26338,"_10236":42336,"_1794":42802},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_4673":1430,"_26077":1245,"_22045":42804,"_5":26338,"_10236":42336,"_1794":42805},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_4673":1431,"_26077":1245,"_22045":42807,"_5":26338,"_10236":42336,"_1794":42808},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_4673":1432,"_26077":1245,"_22045":42810,"_5":26338,"_10236":42336,"_1794":42811},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_4673":1433,"_26077":1433,"_5":26333,"_1794":42813,"_26346":42814,"_22045":42815,"_10236":1433},"Claves y motores criptográficos",[38338,39507,39660],[],{"_4673":1434,"_26077":1433,"_22045":42817,"_5":26338,"_10236":1433,"_1794":42818},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_4673":1435,"_26077":1433,"_5":26343,"_22045":42820,"_10236":42821,"_1794":42822},[],"/docs/pr-preview/pr-26/platform/pki/key-management#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_4673":1436,"_26077":1433,"_5":26343,"_22045":42824,"_10236":42825,"_1794":42826},[],"/docs/pr-preview/pr-26/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_4673":1437,"_26077":1433,"_5":26343,"_22045":42828,"_10236":42829,"_1794":42830},[],"/docs/pr-preview/pr-26/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_4673":1438,"_26077":1433,"_5":26343,"_22045":42832,"_10236":42833,"_1794":42834},[],"/docs/pr-preview/pr-26/platform/pki/key-management#file-system","File System",{"_4673":1439,"_26077":1433,"_5":26343,"_22045":42836,"_10236":42837,"_1794":42838},[],"/docs/pr-preview/pr-26/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_4673":1440,"_26077":1433,"_5":26343,"_22045":42840,"_10236":42841,"_1794":42842},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_4673":1441,"_26077":1433,"_5":26343,"_22045":42844,"_10236":42845,"_1794":42846},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-kms","AWS KMS",{"_4673":1442,"_26077":1433,"_5":26343,"_22045":42848,"_10236":42849,"_1794":42850},[],"/docs/pr-preview/pr-26/platform/pki/key-management#pkcs11","PKCS#11",{"_4673":1443,"_26077":1433,"_5":26343,"_22045":42852,"_10236":42853,"_1794":42854},[],"/docs/pr-preview/pr-26/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_4673":1444,"_26077":1433,"_5":26343,"_22045":42856,"_10236":42857,"_1794":42858},[],"/docs/pr-preview/pr-26/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_4673":1445,"_26077":1433,"_5":26343,"_22045":42860,"_10236":42861,"_1794":42862},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_4673":1446,"_26077":1433,"_5":26343,"_22045":42864,"_10236":42865,"_1794":42866},[],"/docs/pr-preview/pr-26/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_4673":1447,"_26077":1433,"_5":26343,"_22045":42868,"_10236":42869,"_1794":42870},[],"/docs/pr-preview/pr-26/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_4673":1448,"_26077":1433,"_5":26343,"_22045":42872,"_10236":42873,"_1794":42874},[],"/docs/pr-preview/pr-26/platform/pki/key-management#ver-detalles","Ver detalles",{"_4673":1449,"_26077":1433,"_5":26343,"_22045":42876,"_10236":42877,"_1794":42878},[],"/docs/pr-preview/pr-26/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_4673":1450,"_26077":1433,"_5":26343,"_22045":42880,"_10236":42881,"_1794":42882},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign","Sign",{"_4673":1451,"_26077":1433,"_5":26343,"_22045":42884,"_10236":42885,"_1794":42886},[],"/docs/pr-preview/pr-26/platform/pki/key-management#verify","Verify",{"_4673":1452,"_26077":1433,"_5":26343,"_22045":42888,"_10236":42889,"_1794":42890},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_4673":1453,"_26077":1433,"_5":26343,"_22045":42892,"_10236":42893,"_1794":42894},[],"/docs/pr-preview/pr-26/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_4673":1454,"_26077":1433,"_22045":42896,"_5":26338,"_10236":42821,"_1794":42897},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_4673":1455,"_26077":1433,"_22045":42899,"_5":26338,"_10236":42821,"_1794":42900},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_4673":1456,"_26077":1433,"_22045":42902,"_5":26338,"_10236":42825,"_1794":42903},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_4673":1457,"_26077":1433,"_22045":42905,"_5":26338,"_10236":42825,"_1794":42906},[],"En la práctica, permite:",{"_4673":1458,"_26077":1433,"_22045":42908,"_5":26338,"_10236":42825,"_1794":42909},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_4673":1459,"_26077":1433,"_22045":42911,"_5":26338,"_10236":42825,"_1794":42912},[],"Importar claves creadas externamente.",{"_4673":1460,"_26077":1433,"_22045":42914,"_5":26338,"_10236":42825,"_1794":42915},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_4673":1461,"_26077":1433,"_22045":42917,"_5":26338,"_10236":42825,"_1794":42918},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_4673":1462,"_26077":1433,"_22045":42920,"_5":26338,"_10236":42829,"_1794":42921},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_4673":1463,"_26077":1433,"_22045":42923,"_5":26338,"_10236":42829,"_1794":42924},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_4673":1464,"_26077":1433,"_22045":42926,"_5":26338,"_10236":42829,"_1794":42927},[],"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado.",{"_4673":1465,"_26077":1433,"_22045":42929,"_5":26338,"_10236":42833,"_1794":42930},[],"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción.",{"_4673":1466,"_26077":1433,"_22045":42932,"_5":26338,"_10236":42837,"_1794":42933},[],"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*.",{"_4673":1467,"_26077":1433,"_22045":42935,"_5":26338,"_10236":42841,"_1794":42936},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_4673":1468,"_26077":1433,"_22045":42938,"_5":26338,"_10236":42845,"_1794":42939},[],"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica.",{"_4673":1469,"_26077":1433,"_22045":42941,"_5":26338,"_10236":42849,"_1794":42942},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_4673":1470,"_26077":1433,"_22045":42944,"_5":26338,"_10236":42849,"_1794":42945},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_4673":1471,"_26077":1433,"_22045":42947,"_5":26338,"_10236":42849,"_1794":42948},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_4673":1472,"_26077":1433,"_22045":42950,"_5":26338,"_10236":42849,"_1794":42951},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_4673":1473,"_26077":1433,"_22045":42953,"_5":26338,"_10236":42853,"_1794":42954},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_4673":1474,"_26077":1433,"_22045":42956,"_5":26338,"_10236":42853,"_1794":42957},[],"La tabla incluye los siguientes campos:",{"_4673":1475,"_26077":1433,"_22045":42959,"_5":26338,"_10236":42853,"_1794":42960},[],"**Name**: nombre descriptivo de la clave.",{"_4673":1476,"_26077":1433,"_22045":42962,"_5":26338,"_10236":42853,"_1794":42963},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_4673":1477,"_26077":1433,"_22045":42965,"_5":26338,"_10236":42853,"_1794":42966},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_4673":1478,"_26077":1433,"_22045":42968,"_5":26338,"_10236":42853,"_1794":42969},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_4673":1479,"_26077":1433,"_22045":42971,"_5":26338,"_10236":42853,"_1794":42972},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_4673":1480,"_26077":1433,"_22045":42974,"_5":26338,"_10236":42853,"_1794":42975},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_4673":1481,"_26077":1433,"_22045":42977,"_5":26338,"_10236":42853,"_1794":42978},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_4673":1482,"_26077":1433,"_22045":42980,"_5":26338,"_10236":42853,"_1794":42981},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_4673":1483,"_26077":1433,"_22045":42983,"_5":26338,"_10236":42853,"_1794":42984},[],"Desde esta vista también se accede a las acciones más habituales:",{"_4673":1484,"_26077":1433,"_22045":42986,"_5":26338,"_10236":42853,"_1794":42987},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_4673":1485,"_26077":1433,"_22045":42989,"_5":26338,"_10236":42853,"_1794":42990},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_4673":1486,"_26077":1433,"_22045":42992,"_5":26338,"_10236":42853,"_1794":42993},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_4673":1487,"_26077":1433,"_22045":42995,"_5":26338,"_10236":42853,"_1794":42996},[],"**Delete Key** para eliminar la clave del sistema.",{"_4673":1488,"_26077":1433,"_22045":42998,"_5":26338,"_10236":42857,"_1794":42999},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_4673":1489,"_26077":1433,"_22045":43001,"_5":26338,"_10236":42861,"_1794":43002},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_4673":1490,"_26077":1433,"_22045":43004,"_5":26338,"_10236":42861,"_1794":43005},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_4673":1491,"_26077":1433,"_22045":43007,"_5":26338,"_10236":42861,"_1794":43008},[],"**Key Name**: nombre único y descriptivo.",{"_4673":1492,"_26077":1433,"_22045":43010,"_5":26338,"_10236":42861,"_1794":43011},[],"**Crypto Engine**: motor que custodiará la clave.",{"_4673":1493,"_26077":1433,"_22045":43013,"_5":26338,"_10236":42861,"_1794":43014},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_4673":1494,"_26077":1433,"_22045":43016,"_5":26338,"_10236":42861,"_1794":43017},[],"**Tags**: metadatos para clasificar la clave.",{"_4673":1495,"_26077":1433,"_22045":43019,"_5":26338,"_10236":42861,"_1794":43020},[],"**Metadata**: información adicional para usos avanzados.",{"_4673":1496,"_26077":1433,"_22045":43022,"_5":26338,"_10236":42865,"_1794":43023},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_4673":1497,"_26077":1433,"_22045":43025,"_5":26338,"_10236":42865,"_1794":43026},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_4673":1498,"_26077":1433,"_22045":43028,"_5":26338,"_10236":42865,"_1794":43029},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_4673":1499,"_26077":1433,"_22045":43031,"_5":26338,"_10236":42865,"_1794":43032},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_4673":1500,"_26077":1433,"_22045":43034,"_5":26338,"_10236":42865,"_1794":43035},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_4673":1501,"_26077":1433,"_22045":43037,"_5":26338,"_10236":42865,"_1794":43038},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_4673":1502,"_26077":1433,"_22045":43040,"_5":26338,"_10236":42865,"_1794":43041},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_4673":1503,"_26077":1433,"_22045":43043,"_5":26338,"_10236":42865,"_1794":43044},[],"**Tags**: etiquetas para organización y búsqueda.",{"_4673":1504,"_26077":1433,"_22045":43046,"_5":26338,"_10236":42865,"_1794":43047},[],"**Metadata**: información adicional opcional.",{"_4673":1505,"_26077":1433,"_22045":43049,"_5":26338,"_10236":42865,"_1794":43050},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_4673":1506,"_26077":1433,"_22045":43052,"_5":26338,"_10236":42865,"_1794":43053},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_4673":1507,"_26077":1433,"_22045":43055,"_5":26338,"_10236":42869,"_1794":43056},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_4673":1508,"_26077":1433,"_22045":43058,"_5":26338,"_10236":42873,"_1794":43059},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_4673":1509,"_26077":1433,"_22045":43061,"_5":26338,"_10236":42873,"_1794":43062},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_4673":1510,"_26077":1433,"_22045":43064,"_5":26338,"_10236":42873,"_1794":43065},[],"**Key Name**: nombre descriptivo.",{"_4673":1511,"_26077":1433,"_22045":43067,"_5":26338,"_10236":42873,"_1794":43068},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_4673":1512,"_26077":1433,"_22045":43070,"_5":26338,"_10236":42873,"_1794":43071},[],"**Tags**: etiquetas asociadas.",{"_4673":1513,"_26077":1433,"_22045":43073,"_5":26338,"_10236":42873,"_1794":43074},[],"**Aliases**: nombres alternativos.",{"_4673":1514,"_26077":1433,"_22045":43076,"_5":26338,"_10236":42873,"_1794":43077},[],"**Crypto Engine**: motor en el que reside la clave.",{"_4673":1515,"_26077":1433,"_22045":43079,"_5":26338,"_10236":42873,"_1794":43080},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_4673":1516,"_26077":1433,"_22045":43082,"_5":26338,"_10236":42873,"_1794":43083},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_4673":1517,"_26077":1433,"_22045":43085,"_5":26338,"_10236":42873,"_1794":43086},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_4673":1518,"_26077":1433,"_22045":43088,"_5":26338,"_10236":42877,"_1794":43089},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_4673":1519,"_26077":1433,"_22045":43091,"_5":26338,"_10236":42877,"_1794":43092},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_4673":1520,"_26077":1433,"_22045":43094,"_5":26338,"_10236":42881,"_1794":43095},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_4673":1521,"_26077":1433,"_22045":43097,"_5":26338,"_10236":42881,"_1794":43098},[],"Campos principales:",{"_4673":1522,"_26077":1433,"_22045":43100,"_5":26338,"_10236":42881,"_1794":43101},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_4673":1523,"_26077":1433,"_22045":43103,"_5":26338,"_10236":42881,"_1794":43104},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_4673":1524,"_26077":1433,"_22045":43106,"_5":26338,"_10236":42881,"_1794":43107},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_4673":1525,"_26077":1433,"_22045":43109,"_5":26338,"_10236":42881,"_1794":43110},[],"**Message**: contenido que se va a firmar.",{"_4673":1526,"_26077":1433,"_22045":43112,"_5":26338,"_10236":42881,"_1794":43113},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_4673":1527,"_26077":1433,"_22045":43115,"_5":26338,"_10236":42885,"_1794":43116},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_4673":1528,"_26077":1433,"_22045":43118,"_5":26338,"_10236":42885,"_1794":43098},[],{"_4673":1529,"_26077":1433,"_22045":43120,"_5":26338,"_10236":42885,"_1794":43121},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_4673":1530,"_26077":1433,"_22045":43123,"_5":26338,"_10236":42885,"_1794":43124},[],"**Message Type**: `Raw` o `Digest`.",{"_4673":1531,"_26077":1433,"_22045":43126,"_5":26338,"_10236":42885,"_1794":43127},[],"**Payload Encoding**: codificación del mensaje.",{"_4673":1532,"_26077":1433,"_22045":43129,"_5":26338,"_10236":42885,"_1794":43130},[],"**Message**: mensaje original o hash.",{"_4673":1533,"_26077":1433,"_22045":43132,"_5":26338,"_10236":42885,"_1794":43133},[],"**Signature**: firma que se desea comprobar.",{"_4673":1534,"_26077":1433,"_22045":43135,"_5":26338,"_10236":42885,"_1794":43136},[],"**Result**: indicador del resultado de la validación.",{"_4673":1535,"_26077":1433,"_22045":43138,"_5":26338,"_10236":42889,"_1794":43139},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_4673":1536,"_26077":1433,"_22045":43141,"_5":26338,"_10236":42889,"_1794":43142},[],"Este flujo es útil para:",{"_4673":1537,"_26077":1433,"_22045":43144,"_5":26338,"_10236":42889,"_1794":43145},[],"Solicitar certificados a una CA externa.",{"_4673":1538,"_26077":1433,"_22045":43147,"_5":26338,"_10236":42889,"_1794":43148},[],"Renovar una identidad manteniendo la misma clave.",{"_4673":1539,"_26077":1433,"_22045":43150,"_5":26338,"_10236":42889,"_1794":43151},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_4673":1540,"_26077":1433,"_22045":43153,"_5":26338,"_10236":42889,"_1794":43154},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_4673":1541,"_26077":1433,"_22045":43156,"_5":26338,"_10236":42889,"_1794":43157},[],"**Organization (O)**: organización o empresa.",{"_4673":1542,"_26077":1433,"_22045":43159,"_5":26338,"_10236":42889,"_1794":43160},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_4673":1543,"_26077":1433,"_22045":43162,"_5":26338,"_10236":42889,"_1794":43163},[],"**Country (C)**: código de país de dos letras.",{"_4673":1544,"_26077":1433,"_22045":43165,"_5":26338,"_10236":42889,"_1794":43166},[],"**State / Province (ST)**: estado o provincia.",{"_4673":1545,"_26077":1433,"_22045":43168,"_5":26338,"_10236":42889,"_1794":43169},[],"**Locality (L)**: ciudad o localidad.",{"_4673":1546,"_26077":1433,"_22045":43171,"_5":26338,"_10236":42889,"_1794":43172},[],"**Email Address**: correo de contacto.",{"_4673":1547,"_26077":1433,"_22045":43174,"_5":26338,"_10236":42889,"_1794":43175},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_4673":1548,"_26077":1433,"_22045":43177,"_5":26338,"_10236":42889,"_1794":43178},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_4673":1549,"_26077":1433,"_22045":43180,"_5":26338,"_10236":42893,"_1794":43181},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_4673":1550,"_26077":1433,"_22045":43183,"_5":26338,"_10236":42893,"_1794":43184},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_4673":1551,"_26077":1551,"_5":26333,"_1794":43186,"_26346":43187,"_22045":43188,"_10236":1551},"Validación online con OCSP",[38338,39507,39660],[],{"_4673":1552,"_26077":1551,"_22045":43190,"_5":26338,"_10236":1551,"_1794":43191},[],"Consulta en tiempo real si un certificado sigue vigente o se ha revocado.",{"_4673":1553,"_26077":1551,"_5":26343,"_22045":43193,"_10236":43194,"_1794":43195},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#servicio-ocsp","Servicio OCSP",{"_4673":1554,"_26077":1551,"_5":26343,"_22045":43197,"_10236":43198,"_1794":43199},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_4673":1555,"_26077":1551,"_5":26343,"_22045":43201,"_10236":43202,"_1794":43203},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_4673":1556,"_26077":1551,"_5":26343,"_22045":43205,"_10236":43206,"_1794":43207},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_4673":1557,"_26077":1551,"_5":26343,"_22045":43209,"_10236":43210,"_1794":43211},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_4673":1558,"_26077":1551,"_5":26343,"_22045":43213,"_10236":43214,"_1794":41152},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#referencias",{"_4673":1559,"_26077":1551,"_22045":43216,"_5":26338,"_10236":43194,"_1794":43217},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_4673":1560,"_26077":1551,"_22045":43219,"_5":26338,"_10236":43194,"_1794":43220},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_4673":1561,"_26077":1551,"_22045":43222,"_5":26338,"_10236":43198,"_1794":43223},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_4673":1562,"_26077":1551,"_22045":43225,"_5":26338,"_10236":43198,"_1794":43226},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_4673":1563,"_26077":1551,"_22045":43228,"_5":26338,"_10236":43198,"_1794":43229},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_4673":1564,"_26077":1551,"_22045":43231,"_5":26338,"_10236":43198,"_1794":43232},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_4673":1565,"_26077":1551,"_22045":43234,"_5":26338,"_10236":43198,"_1794":43235},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_4673":1566,"_26077":1551,"_22045":43237,"_5":26338,"_10236":43198,"_1794":43238},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_4673":1567,"_26077":1551,"_22045":43240,"_5":26338,"_10236":43202,"_1794":43241},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_4673":1568,"_26077":1551,"_22045":43243,"_5":26338,"_10236":43206,"_1794":43244},[],"El respondedor acepta los dos formatos definidos en RFC 6960:",{"_4673":1569,"_26077":1551,"_22045":43246,"_5":26338,"_10236":43206,"_1794":43247},[],"`GET /ocsp/{ocsp_request}` incluye la petición OCSP codificada en Base64url dentro de la propia URL.",{"_4673":1570,"_26077":1551,"_22045":43249,"_5":26338,"_10236":43206,"_1794":43250},[],"`POST /ocsp` envía la petición en el cuerpo con `Content-Type: application/ocsp-request`.",{"_4673":1571,"_26077":1551,"_22045":43252,"_5":26338,"_10236":43206,"_1794":43253},[],"Ejemplo de consulta con `curl` mediante POST:",{"_4673":1572,"_26077":1551,"_22045":43255,"_5":26338,"_10236":43206,"_1794":43256},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_4673":1573,"_26077":1551,"_22045":43258,"_5":26338,"_10236":43210,"_1794":43259},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_4673":1574,"_26077":1551,"_22045":43261,"_5":26338,"_10236":43214,"_1794":43262},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_4673":1575,"_26077":1551,"_22045":43264,"_5":26338,"_10236":43214,"_1794":43265},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_4673":1576,"_26077":1551,"_22045":43267,"_5":26338,"_10236":43214,"_1794":43268},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_4673":1577,"_26077":1551,"_22045":43270,"_5":26338,"_10236":43214,"_1794":41243},[],{"_4673":1578,"_26077":1578,"_5":26333,"_1794":43272,"_26346":43273,"_22045":43274,"_10236":1578},"Plataforma Lamassu IoT",[38338,39507],[],{"_4673":1579,"_26077":1578,"_22045":43276,"_5":26338,"_10236":1578,"_1794":43277},[],"Gestiona la PKI y las identidades digitales de tus dispositivos desde una única plataforma.",{"_4673":1580,"_26077":1578,"_5":26343,"_22045":43279,"_10236":43280,"_1794":43281},[],"/docs/pr-preview/pr-26/platform/pki/overview#empieza-aquí","Empieza aquí",{"_4673":1581,"_26077":1578,"_5":26343,"_22045":43283,"_10236":43284,"_1794":43285},[],"/docs/pr-preview/pr-26/platform/pki/overview#capacidades-principales","Capacidades principales",{"_4673":1582,"_26077":1578,"_5":26343,"_22045":43287,"_10236":43288,"_1794":43289},[],"/docs/pr-preview/pr-26/platform/pki/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_4673":1583,"_26077":1578,"_5":26343,"_22045":43291,"_10236":43292,"_1794":43293},[],"/docs/pr-preview/pr-26/platform/pki/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_4673":1584,"_26077":1578,"_5":26343,"_22045":43295,"_10236":43296,"_1794":43297},[],"/docs/pr-preview/pr-26/platform/pki/overview#emite-y-controla-certificados","Emite y controla certificados",{"_4673":1585,"_26077":1578,"_5":26343,"_22045":43299,"_10236":43300,"_1794":43301},[],"/docs/pr-preview/pr-26/platform/pki/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_4673":1586,"_26077":1578,"_5":26343,"_22045":43303,"_10236":43304,"_1794":43305},[],"/docs/pr-preview/pr-26/platform/pki/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_4673":1587,"_26077":1578,"_5":26343,"_22045":43307,"_10236":43308,"_1794":43309},[],"/docs/pr-preview/pr-26/platform/pki/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_4673":1588,"_26077":1578,"_5":26343,"_22045":43311,"_10236":43312,"_1794":43313},[],"/docs/pr-preview/pr-26/platform/pki/overview#elige-tu-recorrido","Elige tu recorrido",{"_4673":1589,"_26077":1578,"_5":26343,"_22045":43315,"_10236":43316,"_1794":43317},[],"/docs/pr-preview/pr-26/platform/pki/overview#referencia-operativa","Referencia operativa",{"_4673":1590,"_26077":1578,"_22045":43319,"_5":26338,"_10236":1578,"_1794":43320},[],"Lamassu IoT centraliza la emisión, distribución, renovación y revocación de identidades X.509 para dispositivos conectados. Puedes construir una PKI privada, proteger sus claves y automatizar el enrolamiento de una flota sin perder visibilidad sobre cada certificado.",{"_4673":1591,"_26077":1578,"_22045":43322,"_5":26338,"_10236":43280,"_1794":43323},[],"<Card title=\"Primeros pasos\" description=\"Crea una CA, emite un certificado y registra tu primer dispositivo.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4673":1592,"_26077":1578,"_22045":43325,"_5":26338,"_10236":43280,"_1794":43326},[],"<Card title=\"Cómo funciona Lamassu\" description=\"Construye el modelo mental de autoridades, claves, identidades y validación.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_4673":1593,"_26077":1578,"_22045":43328,"_5":26338,"_10236":43288,"_1794":43329},[],"Crea autoridades raíz e intermedias o importa una PKI existente. Define qué autoridad puede emitir cada identidad y conserva la cadena de confianza completa.",{"_4673":1594,"_26077":1578,"_22045":43331,"_5":26338,"_10236":43292,"_1794":43332},[],"Genera y custodia claves mediante motores software, HSMs PKCS#11 o servicios cloud. Lamassu desacopla las operaciones de la ubicación física de la clave.",{"_4673":1595,"_26077":1578,"_22045":43334,"_5":26338,"_10236":43296,"_1794":43335},[],"Emite certificados desde la consola o a partir de un CSR, consulta su estado y revócalos cuando dejan de ser fiables.",{"_4673":1596,"_26077":1578,"_22045":43337,"_5":26338,"_10236":43300,"_1794":43338},[],"Define políticas de enrolamiento mediante un Device Management Service (DMS) y deja que los dispositivos soliciten o renueven su identidad a través de EST.",{"_4673":1597,"_26077":1578,"_22045":43340,"_5":26338,"_10236":43304,"_1794":43341},[],"Ofrece validación online mediante OCSP y distribuye CRLs para consumidores que necesitan comprobar certificados sin conexión.",{"_4673":1598,"_26077":1578,"_22045":43343,"_5":26338,"_10236":43308,"_1794":43344},[],"Suscríbete a cambios del ciclo de vida y envía notificaciones por correo, Microsoft Teams o webhooks.",{"_4673":1599,"_26077":1578,"_22045":43346,"_5":26338,"_10236":43312,"_1794":43347},[],"<Card title=\"Administro la PKI\" description=\"Configura motores, autoridades, emisión y validación.\" href=\"/docs/platform/pki/key-management\" />",{"_4673":1600,"_26077":1578,"_22045":43349,"_5":26338,"_10236":43312,"_1794":43350},[],"<Card title=\"Integro un dispositivo\" description=\"Configura el DMS y usa EST para obtener una identidad.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_4673":1601,"_26077":1578,"_22045":43352,"_5":26338,"_10236":43312,"_1794":43353},[],"<Card title=\"Opero la plataforma\" description=\"Despliega Lamassu y prepara sus dependencias.\" href=\"/docs/deployment/overview\" />",{"_4673":1602,"_26077":1578,"_22045":43355,"_5":26338,"_10236":43312,"_1794":43356},[],"<Card title=\"Integro otro sistema\" description=\"Conecta Lamassu con AWS IoT Core y otros destinos.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_4673":1603,"_26077":1578,"_22045":43358,"_5":26338,"_10236":43316,"_1794":43359},[],"<Card title=\"Perfiles de certificado\" description=\"Convierte la política de emisión en restricciones reutilizables.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_4673":1604,"_26077":1578,"_22045":43361,"_5":26338,"_10236":43316,"_1794":43362},[],"<Card title=\"Jerarquía y rotación\" description=\"Sustituye certificados o claves de CA sin romper la confianza.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_4673":1605,"_26077":1578,"_22045":43364,"_5":26338,"_10236":43316,"_1794":43365},[],"<Card title=\"Control de acceso\" description=\"Configura principales, políticas y el primer administrador.\" href=\"/docs/platform/pki/access-control\" />",{"_4673":1606,"_26077":1578,"_22045":43367,"_5":26338,"_10236":43316,"_1794":43368},[],"<Card title=\"Resolución de problemas\" description=\"Diagnostica Gateway, servicios, emisión y enrolamiento.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_4673":1607,"_26077":1607,"_5":26333,"_1794":43370,"_26346":43371,"_22045":43373,"_10236":1607},"Crea tu primera CA",[38338,39507,43372],"Primeros pasos",[],{"_4673":1608,"_26077":1607,"_22045":43375,"_5":26338,"_10236":1607,"_1794":43376},[],"Crea una autoridad raíz y comprueba que está preparada para emitir certificados.",{"_4673":1609,"_26077":1607,"_5":26343,"_22045":43378,"_10236":43379,"_1794":38348},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_4673":1610,"_26077":1607,"_5":26343,"_22045":43381,"_10236":43382,"_1794":43383},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_4673":1611,"_26077":1607,"_5":26343,"_22045":43385,"_10236":43386,"_1794":43387},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_4673":1612,"_26077":1607,"_5":26343,"_22045":43389,"_10236":43390,"_1794":43391},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_4673":1613,"_26077":1607,"_5":26343,"_22045":43393,"_10236":43394,"_1794":43395},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_4673":1614,"_26077":1607,"_5":26343,"_22045":43397,"_10236":43398,"_1794":43399},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_4673":1615,"_26077":1607,"_5":26343,"_22045":43401,"_10236":43402,"_1794":38372},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_4673":1616,"_26077":1607,"_22045":43404,"_5":26338,"_10236":1607,"_1794":43405},[],"En este quickstart crearás una autoridad de certificación raíz con un nuevo par de claves. Al terminar tendrás una CA activa que podrás usar en el siguiente quickstart.",{"_4673":1617,"_26077":1607,"_22045":43407,"_5":26338,"_10236":43379,"_1794":43408},[],"Acceso a la consola con permisos para gestionar autoridades.",{"_4673":1618,"_26077":1607,"_22045":43410,"_5":26338,"_10236":43379,"_1794":43411},[],"Al menos un motor criptográfico disponible.",{"_4673":1619,"_26077":1607,"_22045":43413,"_5":26338,"_10236":43379,"_1794":43414},[],"Un nombre que identifique el propósito de la CA, por ejemplo `Acme Device Root CA`.",{"_4673":1620,"_26077":1607,"_22045":43416,"_5":26338,"_10236":43379,"_1794":43417},[],"Una CA raíz se autofirma y actúa como ancla de confianza. Para producción suele ser preferible mantener la raíz más protegida y emitir desde una CA intermedia.",{"_4673":1621,"_26077":1607,"_22045":43419,"_5":26338,"_10236":43382,"_1794":43420},[],"En el menú lateral, abre **Certification Authorities** y selecciona **Create New CA**.",{"_4673":1622,"_26077":1607,"_22045":43422,"_5":26338,"_10236":43382,"_1794":43423},[],"Elige crear una CA con un par de claves nuevo. Si ya tienes la clave en el KMS, usa &#x2A;*Create New CA (Existing Key)**.",{"_4673":1623,"_26077":1607,"_22045":43425,"_5":26338,"_10236":43386,"_1794":43426},[],"Elige el motor criptográfico que custodiará la clave y configura el algoritmo. Para una primera CA puedes usar **EC P-384**, siempre que sea compatible con tus consumidores.",{"_4673":1624,"_26077":1607,"_22045":43428,"_5":26338,"_10236":43386,"_1794":43429},[],"La clave privada permanecerá bajo el control del motor seleccionado.",{"_4673":1625,"_26077":1607,"_22045":43431,"_5":26338,"_10236":43390,"_1794":43432},[],"Selecciona **Root CA** y completa:",{"_4673":1626,"_26077":1607,"_22045":43434,"_5":26338,"_10236":43390,"_1794":43435},[],"**CA Name**: un nombre único y reconocible.",{"_4673":1627,"_26077":1607,"_22045":43437,"_5":26338,"_10236":43390,"_1794":43438},[],"**Subject**: al menos la organización y el país que identificarán a la autoridad.",{"_4673":1628,"_26077":1607,"_22045":43440,"_5":26338,"_10236":43390,"_1794":43441},[],"**CA Certificate Expiration**: una validez mayor que la de los certificados que emitirá.",{"_4673":1629,"_26077":1607,"_22045":43443,"_5":26338,"_10236":43390,"_1794":43444},[],"**Default End-Entity Certificate Issuance Expiration**: la validez predeterminada de los certificados finales.",{"_4673":1630,"_26077":1607,"_22045":43446,"_5":26338,"_10236":43390,"_1794":43447},[],"El nombre de la CA se utilizará como `Common Name` del certificado.",{"_4673":1631,"_26077":1607,"_22045":43449,"_5":26338,"_10236":43394,"_1794":43450},[],"Comprueba el algoritmo, el sujeto y las fechas antes de confirmar. Estos valores definen el ancla de confianza y no deberían elegirse como simples datos de prueba en un entorno productivo.",{"_4673":1632,"_26077":1607,"_22045":43452,"_5":26338,"_10236":43398,"_1794":43453},[],"Abre la nueva CA desde el listado. Debe aparecer activa y mostrar su certificado PEM, la fecha de expiración y la pestaña **Issued Certificates**.",{"_4673":1633,"_26077":1607,"_22045":43455,"_5":26338,"_10236":43402,"_1794":43456},[],"Usa la autoridad para emitir tu primer certificado, o consulta la guía completa de autoridades para crear una CA intermedia, importar una CA o definir perfiles avanzados.",{"_4673":1634,"_26077":1634,"_5":26333,"_1794":43458,"_26346":43459,"_22045":43460,"_10236":1634},"Emite tu primer certificado",[38338,39507,43372],[],{"_4673":1635,"_26077":1634,"_22045":43462,"_5":26338,"_10236":1634,"_1794":43463},[],"Emite una identidad X.509 desde la consola y verifica el resultado.",{"_4673":1636,"_26077":1634,"_5":26343,"_22045":43465,"_10236":43466,"_1794":38348},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_4673":1637,"_26077":1634,"_5":26343,"_22045":43468,"_10236":43469,"_1794":43470},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_4673":1638,"_26077":1634,"_5":26343,"_22045":43472,"_10236":43473,"_1794":43474},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_4673":1639,"_26077":1634,"_5":26343,"_22045":43476,"_10236":43477,"_1794":43478},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_4673":1640,"_26077":1634,"_5":26343,"_22045":43480,"_10236":43481,"_1794":43482},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_4673":1641,"_26077":1634,"_5":26343,"_22045":43484,"_10236":43485,"_1794":43486},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_4673":1642,"_26077":1634,"_5":26343,"_22045":43488,"_10236":43489,"_1794":43399},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_4673":1643,"_26077":1634,"_5":26343,"_22045":43491,"_10236":43492,"_1794":38372},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_4673":1644,"_26077":1634,"_22045":43494,"_5":26338,"_10236":1634,"_1794":43495},[],"En este quickstart Lamassu generará la clave y el CSR en el navegador, y la CA emitirá el certificado. Al terminar descargarás el certificado y su clave privada.",{"_4673":1645,"_26077":1634,"_22045":43497,"_5":26338,"_10236":43466,"_1794":43498},[],"Una CA activa con permiso para emitir certificados.",{"_4673":1646,"_26077":1634,"_22045":43500,"_5":26338,"_10236":43466,"_1794":43501},[],"Un nombre para la identidad, por ejemplo `device-001.example.internal`.",{"_4673":1647,"_26077":1634,"_22045":43503,"_5":26338,"_10236":43466,"_1794":43504},[],"Un lugar seguro en el que custodiar la clave privada descargada.",{"_4673":1648,"_26077":1634,"_22045":43506,"_5":26338,"_10236":43466,"_1794":43507},[],"En este flujo la clave se genera en el navegador y Lamassu no la almacena. Descárgala y protégela antes de cerrar el resultado de la operación.",{"_4673":1649,"_26077":1634,"_22045":43509,"_5":26338,"_10236":43469,"_1794":43510},[],"Abre la CA creada en el quickstart anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_4673":1650,"_26077":1634,"_22045":43512,"_5":26338,"_10236":43473,"_1794":43513},[],"Selecciona **Generate Key & CSR in Browser**. Usa **Upload Existing CSR** cuando la clave privada deba generarse y permanecer en el sistema de destino.",{"_4673":1651,"_26077":1634,"_22045":43515,"_5":26338,"_10236":43477,"_1794":43516},[],"Introduce el `Common Name` y, si corresponde, la organización, unidad organizativa y ubicación. Añade SANs para cada nombre DNS, dirección IP, correo o URI con el que se vaya a validar la identidad.",{"_4673":1652,"_26077":1634,"_22045":43518,"_5":26338,"_10236":43481,"_1794":43519},[],"Elige RSA o ECDSA, define la validez y selecciona los usos de clave. Para una identidad de dispositivo que usa mTLS, habilita **Digital Signature** y **Client Authentication**.",{"_4673":1653,"_26077":1634,"_22045":43521,"_5":26338,"_10236":43481,"_1794":43522},[],"La validez no puede superar la fecha de expiración de la CA emisora.",{"_4673":1654,"_26077":1634,"_22045":43524,"_5":26338,"_10236":43485,"_1794":43525},[],"Confirma la emisión y descarga inmediatamente el certificado y la clave privada en formato PEM.",{"_4673":1655,"_26077":1634,"_22045":43527,"_5":26338,"_10236":43489,"_1794":43528},[],"El certificado debe aparecer en **Issued Certificates** con estado activo. Comprueba su sujeto, SANs, emisor, usos y periodo de validez.",{"_4673":1656,"_26077":1634,"_22045":43530,"_5":26338,"_10236":43492,"_1794":43531},[],"Registra tu primer dispositivo para asociar la identidad a una entidad gestionada, o consulta la gestión de certificados.",{"_4673":1657,"_26077":1657,"_5":26333,"_1794":43372,"_26346":43533,"_22045":43534,"_10236":1657},[38338,39507,43372],[],{"_4673":1658,"_26077":1657,"_22045":43536,"_5":26338,"_10236":1657,"_1794":43537},[],"Obtén un primer resultado con Lamassu y continúa desde una base funcional.",{"_4673":1659,"_26077":1657,"_5":26343,"_22045":43539,"_10236":43540,"_1794":43541},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_4673":1660,"_26077":1657,"_5":26343,"_22045":43543,"_10236":43544,"_1794":38348},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#antes-de-empezar",{"_4673":1661,"_26077":1657,"_22045":43546,"_5":26338,"_10236":1657,"_1794":43547},[],"Los quickstarts te llevan desde una instancia preparada hasta una identidad de dispositivo activa. Cada guía produce un resultado verificable y enlaza la explicación detallada cuando necesitas ir más allá.",{"_4673":1662,"_26077":1657,"_22045":43549,"_5":26338,"_10236":43540,"_1794":43550},[],"<Card title=\"1. Crea tu primera CA\" description=\"Establece una raíz de confianza capaz de emitir certificados.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_4673":1663,"_26077":1657,"_22045":43552,"_5":26338,"_10236":43540,"_1794":43553},[],"<Card title=\"2. Emite un certificado\" description=\"Crea una identidad X.509 y verifica su contenido.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_4673":1664,"_26077":1657,"_22045":43555,"_5":26338,"_10236":43540,"_1794":43556},[],"<Card title=\"3. Registra un dispositivo\" description=\"Añade un dispositivo y asígnale su primera identidad.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_4673":1665,"_26077":1657,"_22045":43558,"_5":26338,"_10236":43544,"_1794":43559},[],"Necesitas acceso a la consola de Lamassu IoT y permisos para administrar claves, autoridades y dispositivos. La instancia debe tener al menos un motor criptográfico configurado.",{"_4673":1666,"_26077":1657,"_22045":43561,"_5":26338,"_10236":43544,"_1794":43562},[],"Si todavía no tienes una instancia, elige primero un modelo de despliegue.",{"_4673":1667,"_26077":1667,"_5":26333,"_1794":43564,"_26346":43565,"_22045":43566,"_10236":1667},"Registra tu primer dispositivo",[38338,39507,43372],[],{"_4673":1668,"_26077":1667,"_22045":43568,"_5":26338,"_10236":1667,"_1794":43569},[],"Añade un dispositivo a Lamassu y asígnale una identidad activa.",{"_4673":1669,"_26077":1667,"_5":26343,"_22045":43571,"_10236":43572,"_1794":38348},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#antes-de-empezar",{"_4673":1670,"_26077":1667,"_5":26343,"_22045":43574,"_10236":43575,"_1794":43576},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_4673":1671,"_26077":1667,"_5":26343,"_22045":43578,"_10236":43579,"_1794":43580},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_4673":1672,"_26077":1667,"_5":26343,"_22045":43582,"_10236":43583,"_1794":43584},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_4673":1673,"_26077":1667,"_5":26343,"_22045":43586,"_10236":43587,"_1794":43588},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_4673":1674,"_26077":1667,"_5":26343,"_22045":43590,"_10236":43591,"_1794":43592},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_4673":1675,"_26077":1667,"_22045":43594,"_5":26338,"_10236":1667,"_1794":43595},[],"En este quickstart registrarás manualmente un dispositivo y le asignarás su primer certificado. Es el recorrido más corto para entender cómo Lamassu relaciona una entidad física con su historial de identidades.",{"_4673":1676,"_26077":1667,"_22045":43597,"_5":26338,"_10236":43572,"_1794":43598},[],"Un DMS configurado.",{"_4673":1677,"_26077":1667,"_22045":43600,"_5":26338,"_10236":43572,"_1794":43601},[],"Una CA asociada al DMS.",{"_4673":1678,"_26077":1667,"_22045":43603,"_5":26338,"_10236":43572,"_1794":43604},[],"Un identificador único para el dispositivo.",{"_4673":1679,"_26077":1667,"_22045":43606,"_5":26338,"_10236":43575,"_1794":43607},[],"Abre **Managed Devices**, selecciona la acción para registrar un dispositivo y completa:",{"_4673":1680,"_26077":1667,"_22045":43609,"_5":26338,"_10236":43575,"_1794":43610},[],"**Device ID**: identificador único del dispositivo.",{"_4673":1681,"_26077":1667,"_22045":43612,"_5":26338,"_10236":43575,"_1794":43613},[],"**Registration Authority**: DMS que aplicará las políticas de enrolamiento.",{"_4673":1682,"_26077":1667,"_22045":43615,"_5":26338,"_10236":43575,"_1794":43616},[],"**Icon** y **Tags**: clasificación opcional para localizarlo después.",{"_4673":1683,"_26077":1667,"_22045":43618,"_5":26338,"_10236":43579,"_1794":43619},[],"Abre el dispositivo recién creado. Debe aparecer con estado **No Identity**: existe en el inventario, pero todavía no tiene un certificado asociado.",{"_4673":1684,"_26077":1667,"_22045":43621,"_5":26338,"_10236":43583,"_1794":43622},[],"Selecciona **Assign Identity**. Lamassu buscará certificados activos cuyo `Common Name` coincida con el `Device ID`.",{"_4673":1685,"_26077":1667,"_22045":43624,"_5":26338,"_10236":43583,"_1794":43625},[],"Selecciona un certificado existente o usa **Issue New Instead** para emitir uno desde una CA vinculada al DMS.",{"_4673":1686,"_26077":1667,"_22045":43627,"_5":26338,"_10236":43587,"_1794":43628},[],"Tras confirmar, el estado debe cambiar a **Active**. Revisa **Certificate History** para comprobar la identidad asociada y **Device Event Timeline** para ver el evento de asignación.",{"_4673":1687,"_26077":1667,"_22045":43630,"_5":26338,"_10236":43591,"_1794":43631},[],"El registro manual ayuda a entender el modelo, pero una flota debe usar enrolamiento automatizado. Continúa con Device Management Service y la integración EST.",{"_4673":1688,"_26077":1688,"_5":26333,"_1794":43633,"_26346":43634,"_22045":43635,"_10236":1688},"Resolución de problemas",[38338,39507,39508],[],{"_4673":1689,"_26077":1688,"_22045":43637,"_5":26338,"_10236":1688,"_1794":43638},[],"Diagnostica acceso, salud, emisión, enrolamiento y dependencias en un despliegue de Lamassu.",{"_4673":1690,"_26077":1688,"_5":26343,"_22045":43640,"_10236":43641,"_1794":43642},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_4673":1691,"_26077":1688,"_5":26343,"_22045":43644,"_10236":43645,"_1794":43646},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_4673":1692,"_26077":1688,"_5":26343,"_22045":43648,"_10236":43649,"_1794":43650},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_4673":1693,"_26077":1688,"_5":26343,"_22045":43652,"_10236":43653,"_1794":43654},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_4673":1694,"_26077":1688,"_5":26343,"_22045":43656,"_10236":43657,"_1794":43658},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_4673":1695,"_26077":1688,"_5":26343,"_22045":43660,"_10236":43661,"_1794":43662},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_4673":1696,"_26077":1688,"_5":26343,"_22045":43664,"_10236":43665,"_1794":43666},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_4673":1697,"_26077":1688,"_5":26343,"_22045":43668,"_10236":43669,"_1794":43670},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_4673":1698,"_26077":1688,"_5":26343,"_22045":43672,"_10236":43673,"_1794":43674},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_4673":1699,"_26077":1688,"_5":26343,"_22045":43676,"_10236":43677,"_1794":43678},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_4673":1700,"_26077":1688,"_5":26343,"_22045":43680,"_10236":43681,"_1794":43682},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_4673":1701,"_26077":1688,"_5":26343,"_22045":43684,"_10236":43685,"_1794":43686},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_4673":1702,"_26077":1688,"_5":26343,"_22045":43688,"_10236":43689,"_1794":43690},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_4673":1703,"_26077":1688,"_5":26343,"_22045":43692,"_10236":43693,"_1794":43694},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_4673":1704,"_26077":1688,"_5":26343,"_22045":43696,"_10236":43697,"_1794":43698},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#observabilidad","Observabilidad",{"_4673":1705,"_26077":1688,"_22045":43700,"_5":26338,"_10236":1688,"_1794":43701},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway, un pod no preparado y una emisión rechazada pueden parecer el mismo problema desde la consola, pero requieren evidencias distintas.",{"_4673":1706,"_26077":1688,"_22045":43703,"_5":26338,"_10236":43645,"_1794":43704},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_4673":1707,"_26077":1688,"_22045":43706,"_5":26338,"_10236":43649,"_1794":43707},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_4673":1708,"_26077":1688,"_22045":43709,"_5":26338,"_10236":43653,"_1794":43710},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_4673":1709,"_26077":1688,"_22045":43712,"_5":26338,"_10236":43657,"_1794":43713},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_4673":1710,"_26077":1688,"_22045":43715,"_5":26338,"_10236":43661,"_1794":43716},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_4673":1711,"_26077":1688,"_22045":43718,"_5":26338,"_10236":43665,"_1794":43719},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_4673":1712,"_26077":1688,"_22045":43721,"_5":26338,"_10236":43665,"_1794":43722},[],"Ejecuta también la prueba de conectividad del chart:",{"_4673":1713,"_26077":1688,"_22045":43724,"_5":26338,"_10236":43665,"_1794":43725},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_4673":1714,"_26077":1688,"_22045":43727,"_5":26338,"_10236":43665,"_1794":43728},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_4673":1715,"_26077":1688,"_22045":43730,"_5":26338,"_10236":43669,"_1794":43731},[],"Si recibes un 401:",{"_4673":1716,"_26077":1688,"_22045":43733,"_5":26338,"_10236":43669,"_1794":43734},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_4673":1717,"_26077":1688,"_22045":43736,"_5":26338,"_10236":43669,"_1794":43737},[],"verifica emisor, audiencia y expiración del token;",{"_4673":1718,"_26077":1688,"_22045":43739,"_5":26338,"_10236":43669,"_1794":43740},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_4673":1719,"_26077":1688,"_22045":43742,"_5":26338,"_10236":43669,"_1794":43743},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_4673":1720,"_26077":1688,"_22045":43745,"_5":26338,"_10236":43669,"_1794":43746},[],"Si el login termina pero las APIs devuelven 403:",{"_4673":1721,"_26077":1688,"_22045":43748,"_5":26338,"_10236":43669,"_1794":43749},[],"inspecciona los claims reales del token;",{"_4673":1722,"_26077":1688,"_22045":43751,"_5":26338,"_10236":43669,"_1794":43752},[],"confirma que coinciden con un principal activo;",{"_4673":1723,"_26077":1688,"_22045":43754,"_5":26338,"_10236":43669,"_1794":43755},[],"revisa las políticas concedidas al principal;",{"_4673":1724,"_26077":1688,"_22045":43757,"_5":26338,"_10236":43669,"_1794":43758},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_4673":1725,"_26077":1688,"_22045":43760,"_5":26338,"_10236":43669,"_1794":43761},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_4673":1726,"_26077":1688,"_22045":43763,"_5":26338,"_10236":43673,"_1794":43764},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_4673":1727,"_26077":1688,"_22045":43766,"_5":26338,"_10236":43673,"_1794":43767},[],"Localiza el pod y Service de authz.",{"_4673":1728,"_26077":1688,"_22045":43769,"_5":26338,"_10236":43673,"_1794":43770},[],"Comprueba /health, logs y conexión a su base de datos.",{"_4673":1729,"_26077":1688,"_22045":43772,"_5":26338,"_10236":43673,"_1794":43773},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_4673":1730,"_26077":1688,"_22045":43775,"_5":26338,"_10236":43673,"_1794":43776},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_4673":1731,"_26077":1688,"_22045":43778,"_5":26338,"_10236":43673,"_1794":43779},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_4673":1732,"_26077":1688,"_22045":43781,"_5":26338,"_10236":43677,"_1794":43782},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_4673":1733,"_26077":1688,"_22045":43784,"_5":26338,"_10236":43677,"_1794":43785},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_4673":1734,"_26077":1688,"_22045":43787,"_5":26338,"_10236":43677,"_1794":43788},[],"volumen persistente sin enlazar;",{"_4673":1735,"_26077":1688,"_22045":43790,"_5":26338,"_10236":43677,"_1794":43791},[],"imagen inaccesible o política de pull incorrecta;",{"_4673":1736,"_26077":1688,"_22045":43793,"_5":26338,"_10236":43677,"_1794":43794},[],"configuración inválida del motor criptográfico;",{"_4673":1737,"_26077":1688,"_22045":43796,"_5":26338,"_10236":43677,"_1794":43797},[],"límites de CPU o memoria demasiado bajos;",{"_4673":1738,"_26077":1688,"_22045":43799,"_5":26338,"_10236":43677,"_1794":43800},[],"migración previa incompleta.",{"_4673":1739,"_26077":1688,"_22045":43802,"_5":26338,"_10236":43677,"_1794":43803},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_4673":1740,"_26077":1688,"_22045":43805,"_5":26338,"_10236":43677,"_1794":43806},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_4673":1741,"_26077":1688,"_22045":43808,"_5":26338,"_10236":43681,"_1794":43809},[],"Acota el error siguiendo este orden:",{"_4673":1742,"_26077":1688,"_22045":43811,"_5":26338,"_10236":43681,"_1794":43812},[],"La CA existe, está activa y no ha expirado.",{"_4673":1743,"_26077":1688,"_22045":43814,"_5":26338,"_10236":43681,"_1794":43815},[],"La CA tiene una clave privada utilizable y el motor está disponible.",{"_4673":1744,"_26077":1688,"_22045":43817,"_5":26338,"_10236":43681,"_1794":43818},[],"La CSR tiene una firma válida.",{"_4673":1745,"_26077":1688,"_22045":43820,"_5":26338,"_10236":43681,"_1794":43821},[],"El perfil permite el tipo y tamaño de clave.",{"_4673":1746,"_26077":1688,"_22045":43823,"_5":26338,"_10236":43681,"_1794":43824},[],"La validez solicitada cabe dentro de la vigencia de la CA.",{"_4673":1747,"_26077":1688,"_22045":43826,"_5":26338,"_10236":43681,"_1794":43827},[],"KU, EKU, sujeto y extensiones cumplen el perfil.",{"_4673":1748,"_26077":1688,"_22045":43829,"_5":26338,"_10236":43681,"_1794":43830},[],"Si la reemisión de una CA falla, recuerda que no se admite para una CA revocada o ya expirada. Para cambiar su clave, sigue Jerarquía y rotación de CAs.",{"_4673":1749,"_26077":1688,"_22045":43832,"_5":26338,"_10236":43685,"_1794":43833},[],"Comprueba:",{"_4673":1750,"_26077":1688,"_22045":43835,"_5":26338,"_10236":43685,"_1794":43836},[],"el identificador del DMS en el path EST;",{"_4673":1751,"_26077":1688,"_22045":43838,"_5":26338,"_10236":43685,"_1794":43839},[],"el método de autenticación configurado;",{"_4673":1752,"_26077":1688,"_22045":43841,"_5":26338,"_10236":43685,"_1794":43842},[],"la cadena presentada por el cliente;",{"_4673":1753,"_26077":1688,"_22045":43844,"_5":26338,"_10236":43685,"_1794":43845},[],"las CAs de validación y el límite de niveles;",{"_4673":1754,"_26077":1688,"_22045":43847,"_5":26338,"_10236":43685,"_1794":43848},[],"el estado de revocación del certificado cliente;",{"_4673":1755,"_26077":1688,"_22045":43850,"_5":26338,"_10236":43685,"_1794":43851},[],"la firma de la CSR;",{"_4673":1756,"_26077":1688,"_22045":43853,"_5":26338,"_10236":43685,"_1794":43854},[],"la CA y el perfil usados para emitir;",{"_4673":1757,"_26077":1688,"_22045":43856,"_5":26338,"_10236":43685,"_1794":43857},[],"la ventana de re-enrolamiento.",{"_4673":1758,"_26077":1688,"_22045":43859,"_5":26338,"_10236":43685,"_1794":43860},[],"En re-enrolamiento, Lamassu intenta validar primero con la CA de enrolamiento y después con las CAs adicionales. Durante una migración, conserva la CA anterior en ese segundo conjunto hasta terminar el solapamiento.",{"_4673":1759,"_26077":1688,"_22045":43862,"_5":26338,"_10236":43689,"_1794":43863},[],"Confirma que la revocación quedó persistida y tiene razón y timestamp.",{"_4673":1760,"_26077":1688,"_22045":43865,"_5":26338,"_10236":43689,"_1794":43866},[],"Revisa la configuración y logs de VA.",{"_4673":1761,"_26077":1688,"_22045":43868,"_5":26338,"_10236":43689,"_1794":43869},[],"Comprueba la periodicidad y próxima actualización de la CRL.",{"_4673":1762,"_26077":1688,"_22045":43871,"_5":26338,"_10236":43689,"_1794":43872},[],"Descarta cachés intermedias en proxy y cliente.",{"_4673":1763,"_26077":1688,"_22045":43874,"_5":26338,"_10236":43689,"_1794":43875},[],"Verifica que el certificado apunta al endpoint que estás consultando.",{"_4673":1764,"_26077":1688,"_22045":43877,"_5":26338,"_10236":43689,"_1794":43878},[],"Consulta por número de serie y emisor correctos.",{"_4673":1765,"_26077":1688,"_22045":43880,"_5":26338,"_10236":43693,"_1794":43881},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_4673":1766,"_26077":1688,"_22045":43883,"_5":26338,"_10236":43693,"_1794":43884},[],"verifica que esté habilitado en el servicio emisor;",{"_4673":1767,"_26077":1688,"_22045":43886,"_5":26338,"_10236":43693,"_1794":43887},[],"comprueba conectividad y credenciales AMQP;",{"_4673":1768,"_26077":1688,"_22045":43889,"_5":26338,"_10236":43693,"_1794":43890},[],"revisa exchange, routing key, colas y consumidores;",{"_4673":1769,"_26077":1688,"_22045":43892,"_5":26338,"_10236":43693,"_1794":43893},[],"inspecciona dead-letter queues;",{"_4673":1770,"_26077":1688,"_22045":43895,"_5":26338,"_10236":43693,"_1794":43896},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_4673":1771,"_26077":1688,"_22045":43898,"_5":26338,"_10236":43693,"_1794":43899},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_4673":1772,"_26077":1688,"_22045":43901,"_5":26338,"_10236":43697,"_1794":43902},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_4673":1773,"_26077":1688,"_22045":43904,"_5":26338,"_10236":43697,"_1794":43905},[],"Antes de cerrar una incidencia, guarda:",{"_4673":1774,"_26077":1688,"_22045":43907,"_5":26338,"_10236":43697,"_1794":43908},[],"causa confirmada;",{"_4673":1775,"_26077":1688,"_22045":43910,"_5":26338,"_10236":43697,"_1794":43911},[],"alcance temporal y recursos afectados;",{"_4673":1776,"_26077":1688,"_22045":43913,"_5":26338,"_10236":43697,"_1794":43914},[],"comandos o consultas utilizados;",{"_4673":1777,"_26077":1688,"_22045":43916,"_5":26338,"_10236":43697,"_1794":43917},[],"cambio aplicado y forma de revertirlo;",{"_4673":1778,"_26077":1688,"_22045":43919,"_5":26338,"_10236":43697,"_1794":43920},[],"validación desde un consumidor;",{"_4673":1779,"_26077":1688,"_22045":43922,"_5":26338,"_10236":43697,"_1794":43923},[],"acción preventiva y propietario.",{"_4673":1780,"_26077":1780,"_5":26333,"_1794":43925,"_22045":43926,"_10236":1780},"Test",[],{"_4673":1781,"_26077":1780,"_22045":43928,"_5":26338,"_10236":1780,"_1794":43929},[],"A document to test Fumadocs",{"_4673":1782,"_26077":1780,"_5":26343,"_22045":43931,"_10236":43932,"_1794":43933},[],"/docs/pr-preview/pr-26/test#cards","Cards",{"_4673":1783,"_26077":1780,"_5":26343,"_22045":43935,"_10236":43936,"_1794":43937},[],"/docs/pr-preview/pr-26/test#codeblock","CodeBlock",{"_4673":1784,"_26077":1780,"_5":26343,"_22045":43939,"_10236":43940,"_1794":43941},[],"/docs/pr-preview/pr-26/test#list","List",{"_4673":1785,"_26077":1780,"_22045":43943,"_5":26338,"_10236":1780,"_1794":43944},[],"Hey there!",{"_4673":1786,"_26077":1780,"_22045":43946,"_5":26338,"_10236":43932,"_1794":43947},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_4673":1787,"_26077":1780,"_22045":43949,"_5":26338,"_10236":43932,"_1794":43950},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_4673":1788,"_26077":1780,"_22045":43952,"_5":26338,"_10236":43940,"_1794":43953},[],"Hello",{"_4673":1789,"_26077":1780,"_22045":43955,"_5":26338,"_10236":43940,"_1794":43956},[],"World","count","sorting",{"_43960":43961,"_43962":43963,"_43964":43965,"_43966":43967,"_8310":1811,"_51098":1811},"language","english","sortableProperties",[1794,26077,5,10236],"sortablePropertiesWithTypes",{"_1794"