625,"_36878":113628,"_36880":113631,"_36882":113634,"_36884":113637,"_36886":113640,"_36888":113643,"_36890":113646,"_36892":113649,"_36894":113652,"_36896":113655,"_36898":113658,"_36900":113661,"_36902":113664,"_36904":113667,"_36906":113670,"_36908":113673,"_36910":113676,"_36912":113679,"_36915":113682,"_36917":113685,"_36919":113688,"_36922":113691,"_36925":113694,"_36927":113697,"_36929":113700,"_36932":113703,"_36934":113706,"_36936":113709,"_36938":113712,"_36940":113715,"_36942":113718,"_36944":113721,"_36946":113724,"_36948":113727,"_36950":113730,"_36952":113733,"_36954":113736,"_36956":113739,"_36958":113742,"_36960":113745,"_36962":113748,"_36964":113751,"_36966":113754,"_36968":113757,"_36970":113760,"_36972":113763,"_36974":113766,"_36976":113769,"_36978":113772,"_36980":113775,"_36982":113778,"_36984":113781,"_36986":113784,"_36988":113787,"_36990":113790,"_36992":113793,"_36994":113796,"_36996":113799,"_36998":113802,"_37001":113805,"_37003":113808,"_37005":113811},{"_3150":63764,"_27660":63764,"_5":13521,"_2648":105747,"_28003":105748,"_19192":105751,"_26170":63764},"Despliega desde AWS Marketplace",[44970,105749,105750],"Despliegue","Otros modelos",[],{"_3150":63765,"_27660":63764,"_19192":105753,"_5":13195,"_26170":63764,"_2648":105754},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3150":63766,"_27660":63764,"_5":28000,"_19192":105756,"_26170":105757,"_2648":105758},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3150":63767,"_27660":63764,"_5":28000,"_19192":105760,"_26170":105761,"_2648":105762},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3150":63768,"_27660":63764,"_5":28000,"_19192":105764,"_26170":105765,"_2648":105766},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3150":63769,"_27660":63764,"_5":28000,"_19192":105768,"_26170":105769,"_2648":105770},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3150":63770,"_27660":63764,"_5":28000,"_19192":105772,"_26170":105773,"_2648":105774},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3150":63771,"_27660":63764,"_5":28000,"_19192":105776,"_26170":105777,"_2648":105778},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3150":63772,"_27660":63764,"_5":28000,"_19192":105780,"_26170":105781,"_2648":105782},[],"/docs/pr-preview/pr-26/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3150":63773,"_27660":63764,"_19192":105784,"_5":13195,"_26170":63764,"_2648":105785},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3150":63774,"_27660":63764,"_19192":105787,"_5":13195,"_26170":105757,"_2648":105788},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3150":63775,"_27660":63764,"_19192":105790,"_5":13195,"_26170":105757,"_2648":105791},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3150":63776,"_27660":63764,"_19192":105793,"_5":13195,"_26170":105757,"_2648":105794},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3150":63777,"_27660":63764,"_19192":105796,"_5":13195,"_26170":105761,"_2648":105797},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3150":63778,"_27660":63764,"_19192":105799,"_5":13195,"_26170":105761,"_2648":105800},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3150":63779,"_27660":63764,"_19192":105802,"_5":13195,"_26170":105761,"_2648":105803},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3150":63780,"_27660":63764,"_19192":105805,"_5":13195,"_26170":105765,"_2648":105806},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3150":63781,"_27660":63764,"_19192":105808,"_5":13195,"_26170":105769,"_2648":105809},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3150":63782,"_27660":63764,"_19192":105811,"_5":13195,"_26170":105773,"_2648":105812},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3150":63783,"_27660":63764,"_19192":105814,"_5":13195,"_26170":105777,"_2648":105815},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3150":63784,"_27660":63764,"_19192":105817,"_5":13195,"_26170":105781,"_2648":105818},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3150":63785,"_27660":63785,"_5":13521,"_2648":105820,"_28003":105821,"_19192":105822,"_26170":63785},"Despliega Lamassu",[44970,105749],[],{"_3150":63786,"_27660":63785,"_19192":105824,"_5":13195,"_26170":63785,"_2648":105825},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3150":63787,"_27660":63785,"_5":28000,"_19192":105827,"_26170":105828,"_2648":105829},[],"/docs/pr-preview/pr-26/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3150":63788,"_27660":63785,"_5":28000,"_19192":105831,"_26170":105832,"_2648":105833},[],"/docs/pr-preview/pr-26/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3150":63789,"_27660":63785,"_5":28000,"_19192":105835,"_26170":105836,"_2648":105837},[],"/docs/pr-preview/pr-26/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3150":63790,"_27660":63785,"_19192":105839,"_5":13195,"_26170":63785,"_2648":105840},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3150":63791,"_27660":63785,"_19192":105842,"_5":13195,"_26170":105828,"_2648":105843},[],"Modelo",{"_3150":63792,"_27660":63785,"_19192":105845,"_5":13195,"_26170":105828,"_2648":105846},[],"Recomendado para",{"_3150":63793,"_27660":63785,"_19192":105848,"_5":13195,"_26170":105828,"_2648":105849},[],"Quién opera la infraestructura",{"_3150":63794,"_27660":63785,"_19192":105851,"_5":13195,"_26170":105828,"_2648":105852},[],"Punto de partida",{"_3150":63795,"_27660":63785,"_19192":105854,"_5":13195,"_26170":105828,"_2648":45077},[],{"_3150":63796,"_27660":63785,"_19192":105856,"_5":13195,"_26170":105828,"_2648":105857},[],"Producción, entornos regulados y despliegues personalizados",{"_3150":63797,"_27660":63785,"_19192":105859,"_5":13195,"_26170":105828,"_2648":105860},[],"Tu equipo",{"_3150":63798,"_27660":63785,"_19192":105862,"_5":13195,"_26170":105828,"_2648":105863},[],"Helm o Fastlane",{"_3150":63799,"_27660":63785,"_19192":105865,"_5":13195,"_26170":105828,"_2648":45089},[],{"_3150":63800,"_27660":63785,"_19192":105867,"_5":13195,"_26170":105828,"_2648":105868},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3150":63801,"_27660":63785,"_19192":105870,"_5":13195,"_26170":105828,"_2648":105860},[],{"_3150":63802,"_27660":63785,"_19192":105872,"_5":13195,"_26170":105828,"_2648":105873},[],"Imagen preconfigurada en EC2",{"_3150":63803,"_27660":63785,"_19192":105875,"_5":13195,"_26170":105828,"_2648":45100},[],{"_3150":63804,"_27660":63785,"_19192":105877,"_5":13195,"_26170":105828,"_2648":105878},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3150":63805,"_27660":63785,"_19192":105880,"_5":13195,"_26170":105828,"_2648":45106},[],{"_3150":63806,"_27660":63785,"_19192":105882,"_5":13195,"_26170":105828,"_2648":105883},[],"Suscripción gestionada",{"_3150":63807,"_27660":63785,"_19192":105885,"_5":13195,"_26170":105828,"_2648":105886},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3150":63808,"_27660":63785,"_19192":105888,"_5":13195,"_26170":105828,"_2648":105889},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3150":63809,"_27660":63785,"_19192":105891,"_5":13195,"_26170":105828,"_2648":105892},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3150":63810,"_27660":63785,"_19192":105894,"_5":13195,"_26170":105832,"_2648":105895},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3150":63811,"_27660":63785,"_19192":105897,"_5":13195,"_26170":105836,"_2648":105898},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3150":63812,"_27660":63812,"_5":13521,"_2648":105900,"_28003":105901,"_19192":105902,"_26170":63812},"Utiliza Lamassu como SaaS",[44970,105749,105750],[],{"_3150":63813,"_27660":63812,"_19192":105904,"_5":13195,"_26170":63812,"_2648":105905},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3150":63814,"_27660":63812,"_5":28000,"_19192":105907,"_26170":105908,"_2648":105909},[],"/docs/pr-preview/pr-26/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3150":63815,"_27660":63812,"_5":28000,"_19192":105911,"_26170":105912,"_2648":105913},[],"/docs/pr-preview/pr-26/es/deployment/saas#planes","Planes",{"_3150":63816,"_27660":63812,"_5":28000,"_19192":105915,"_26170":105916,"_2648":105917},[],"/docs/pr-preview/pr-26/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3150":63817,"_27660":63812,"_19192":105919,"_5":13195,"_26170":63812,"_2648":105920},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3150":63818,"_27660":63812,"_19192":105922,"_5":13195,"_26170":105908,"_2648":105923},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3150":63819,"_27660":63812,"_19192":105925,"_5":13195,"_26170":105908,"_2648":105926},[],"Copias de seguridad automáticas.",{"_3150":63820,"_27660":63812,"_19192":105928,"_5":13195,"_26170":105908,"_2648":105929},[],"Actualizaciones de versión.",{"_3150":63821,"_27660":63812,"_19192":105931,"_5":13195,"_26170":105908,"_2648":105932},[],"Soporte técnico y SLA según el plan contratado.",{"_3150":63822,"_27660":63812,"_19192":105934,"_5":13195,"_26170":105912,"_2648":45161},[],{"_3150":63823,"_27660":63812,"_19192":105936,"_5":13195,"_26170":105912,"_2648":105937},[],"Dispositivos",{"_3150":63824,"_27660":63812,"_19192":105939,"_5":13195,"_26170":105912,"_2648":105940},[],"Soporte",{"_3150":63825,"_27660":63812,"_19192":105942,"_5":13195,"_26170":105912,"_2648":45170},[],{"_3150":63826,"_27660":63812,"_19192":105944,"_5":13195,"_26170":105912,"_2648":45173},[],{"_3150":63827,"_27660":63812,"_19192":105946,"_5":13195,"_26170":105912,"_2648":105947},[],"Hasta 1.000",{"_3150":63828,"_27660":63812,"_19192":105949,"_5":13195,"_26170":105912,"_2648":45179},[],{"_3150":63829,"_27660":63812,"_19192":105951,"_5":13195,"_26170":105912,"_2648":105952},[],"99,5 %",{"_3150":63830,"_27660":63812,"_19192":105954,"_5":13195,"_26170":105912,"_2648":45185},[],{"_3150":63831,"_27660":63812,"_19192":105956,"_5":13195,"_26170":105912,"_2648":105957},[],"Hasta 10.000",{"_3150":63832,"_27660":63812,"_19192":105959,"_5":13195,"_26170":105912,"_2648":105960},[],"Email y chat",{"_3150":63833,"_27660":63812,"_19192":105962,"_5":13195,"_26170":105912,"_2648":105963},[],"99,9 %",{"_3150":63834,"_27660":63812,"_19192":105965,"_5":13195,"_26170":105912,"_2648":45197},[],{"_3150":63835,"_27660":63812,"_19192":105967,"_5":13195,"_26170":105912,"_2648":105968},[],"Ilimitados",{"_3150":63836,"_27660":63812,"_19192":105970,"_5":13195,"_26170":105912,"_2648":105971},[],"Dedicado",{"_3150":63837,"_27660":63812,"_19192":105973,"_5":13195,"_26170":105912,"_2648":105974},[],"99,99 %",{"_3150":63838,"_27660":63812,"_19192":105976,"_5":13195,"_26170":105916,"_2648":105977},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3150":63839,"_27660":63812,"_19192":105979,"_5":13195,"_26170":105916,"_2648":105980},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3150":63840,"_27660":63840,"_5":13521,"_2648":45214,"_28003":105982,"_19192":105984,"_26170":63840},[44970,105749,105983],"Kubernetes autogestionado",[],{"_3150":63841,"_27660":63840,"_19192":105986,"_5":13195,"_26170":63840,"_2648":105987},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3150":63842,"_27660":63840,"_5":28000,"_19192":105989,"_26170":105990,"_2648":105991},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3150":63843,"_27660":63840,"_5":28000,"_19192":105993,"_26170":105994,"_2648":105995},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3150":63844,"_27660":63840,"_5":28000,"_19192":105997,"_26170":105998,"_2648":105999},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3150":63845,"_27660":63840,"_5":28000,"_19192":106001,"_26170":106002,"_2648":106003},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3150":63846,"_27660":63840,"_5":28000,"_19192":106005,"_26170":106006,"_2648":106007},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3150":63847,"_27660":63840,"_5":28000,"_19192":106009,"_26170":106010,"_2648":106011},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3150":63848,"_27660":63840,"_5":28000,"_19192":106013,"_26170":106014,"_2648":106015},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3150":63849,"_27660":63840,"_5":28000,"_19192":106017,"_26170":106018,"_2648":106019},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3150":63850,"_27660":63840,"_5":28000,"_19192":106021,"_26170":106022,"_2648":106023},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3150":63851,"_27660":63840,"_5":28000,"_19192":106025,"_26170":106026,"_2648":106027},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3150":63852,"_27660":63840,"_5":28000,"_19192":106029,"_26170":106030,"_2648":106031},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3150":63853,"_27660":63840,"_19192":106033,"_5":13195,"_26170":105990,"_2648":106034},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3150":63854,"_27660":63840,"_19192":106036,"_5":13195,"_26170":105990,"_2648":106037},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3150":63855,"_27660":63840,"_19192":106039,"_5":13195,"_26170":105994,"_2648":106040},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3150":63856,"_27660":63840,"_19192":106042,"_5":13195,"_26170":105994,"_2648":106043},[],"Fastlane instala o configura",{"_3150":63857,"_27660":63840,"_19192":106045,"_5":13195,"_26170":105994,"_2648":106046},[],"Tú sigues proporcionando",{"_3150":63858,"_27660":63840,"_19192":106048,"_5":13195,"_26170":105994,"_2648":106049},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3150":63859,"_27660":63840,"_19192":106051,"_5":13195,"_26170":105994,"_2648":106052},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3150":63860,"_27660":63840,"_19192":106054,"_5":13195,"_26170":105994,"_2648":106055},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3150":63861,"_27660":63840,"_19192":106057,"_5":13195,"_26170":105994,"_2648":106058},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3150":63862,"_27660":63840,"_19192":106060,"_5":13195,"_26170":105994,"_2648":106061},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3150":63863,"_27660":63840,"_19192":106063,"_5":13195,"_26170":105994,"_2648":106064},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3150":63864,"_27660":63840,"_19192":106066,"_5":13195,"_26170":105994,"_2648":106067},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3150":63865,"_27660":63840,"_19192":106069,"_5":13195,"_26170":105994,"_2648":106070},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3150":63866,"_27660":63840,"_19192":106072,"_5":13195,"_26170":105994,"_2648":106073},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3150":63867,"_27660":63840,"_19192":106075,"_5":13195,"_26170":105998,"_2648":106076},[],"Necesitas:",{"_3150":63868,"_27660":63840,"_19192":106078,"_5":13195,"_26170":105998,"_2648":106079},[],"un clúster Kubernetes existente",{"_3150":63869,"_27660":63840,"_19192":106081,"_5":13195,"_26170":105998,"_2648":106082},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3150":63870,"_27660":63840,"_19192":106084,"_5":13195,"_26170":105998,"_2648":45316},[],{"_3150":63871,"_27660":63840,"_19192":106086,"_5":13195,"_26170":105998,"_2648":21734},[],{"_3150":63872,"_27660":63840,"_19192":106088,"_5":13195,"_26170":105998,"_2648":106089},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3150":63873,"_27660":63840,"_19192":106091,"_5":13195,"_26170":105998,"_2648":106092},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3150":63874,"_27660":63840,"_19192":106094,"_5":13195,"_26170":105998,"_2648":106095},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3150":63875,"_27660":63840,"_19192":106097,"_5":13195,"_26170":105998,"_2648":106098},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3150":63876,"_27660":63840,"_19192":106100,"_5":13195,"_26170":105998,"_2648":106101},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3150":63877,"_27660":63840,"_19192":106103,"_5":13195,"_26170":106002,"_2648":106104},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3150":63878,"_27660":63840,"_19192":106106,"_5":13195,"_26170":106002,"_2648":106107},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3150":63879,"_27660":63840,"_19192":106109,"_5":13195,"_26170":106006,"_2648":106110},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3150":63880,"_27660":63840,"_19192":106112,"_5":13195,"_26170":106006,"_2648":106113},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3150":63881,"_27660":63840,"_19192":106115,"_5":13195,"_26170":106006,"_2648":106116},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3150":63882,"_27660":63840,"_19192":106118,"_5":13195,"_26170":106006,"_2648":106119},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3150":63883,"_27660":63840,"_19192":106121,"_5":13195,"_26170":106010,"_2648":106122},[],"Opción",{"_3150":63884,"_27660":63840,"_19192":106124,"_5":13195,"_26170":106010,"_2648":106125},[],"Valor predeterminado",{"_3150":63885,"_27660":63840,"_19192":106127,"_5":13195,"_26170":106010,"_2648":106128},[],"Propósito",{"_3150":63886,"_27660":63840,"_19192":106130,"_5":13195,"_26170":106010,"_2648":45363},[],{"_3150":63887,"_27660":63840,"_19192":106132,"_5":13195,"_26170":106010,"_2648":45366},[],{"_3150":63888,"_27660":63840,"_19192":106134,"_5":13195,"_26170":106010,"_2648":106135},[],"Muestra la ayuda",{"_3150":63889,"_27660":63840,"_19192":106137,"_5":13195,"_26170":106010,"_2648":45372},[],{"_3150":63890,"_27660":63840,"_19192":106139,"_5":13195,"_26170":106010,"_2648":106140},[],"contexto actual",{"_3150":63891,"_27660":63840,"_19192":106142,"_5":13195,"_26170":106010,"_2648":106143},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3150":63892,"_27660":63840,"_19192":106145,"_5":13195,"_26170":106010,"_2648":45381},[],{"_3150":63893,"_27660":63840,"_19192":106147,"_5":13195,"_26170":106010,"_2648":5899},[],{"_3150":63894,"_27660":63840,"_19192":106149,"_5":13195,"_26170":106010,"_2648":106150},[],"Omite prompts y genera credenciales para las dependencias",{"_3150":63895,"_27660":63840,"_19192":106152,"_5":13195,"_26170":106010,"_2648":45389},[],{"_3150":63896,"_27660":63840,"_19192":106154,"_5":13195,"_26170":106010,"_2648":45392},[],{"_3150":63897,"_27660":63840,"_19192":106156,"_5":13195,"_26170":106010,"_2648":106157},[],"Namespace de la instalación",{"_3150":63898,"_27660":63840,"_19192":106159,"_5":13195,"_26170":106010,"_2648":45398},[],{"_3150":63899,"_27660":63840,"_19192":106161,"_5":13195,"_26170":106010,"_2648":45401},[],{"_3150":63900,"_27660":63840,"_19192":106163,"_5":13195,"_26170":106010,"_2648":106164},[],"Dominio usado por la UI, OIDC y el certificado",{"_3150":63901,"_27660":63840,"_19192":106166,"_5":13195,"_26170":106010,"_2648":45407},[],{"_3150":63902,"_27660":63840,"_19192":106168,"_5":13195,"_26170":106010,"_2648":13797},[],{"_3150":63903,"_27660":63840,"_19192":106170,"_5":13195,"_26170":106010,"_2648":106171},[],"Versión del chart de Lamassu",{"_3150":63904,"_27660":63840,"_19192":106173,"_5":13195,"_26170":106010,"_2648":45415},[],{"_3150":63905,"_27660":63840,"_19192":106175,"_5":13195,"_26170":106010,"_2648":45418},[],{"_3150":63906,"_27660":63840,"_19192":106177,"_5":13195,"_26170":106010,"_2648":106178},[],"Puerto del listener HTTPS",{"_3150":63907,"_27660":63840,"_19192":106180,"_5":13195,"_26170":106010,"_2648":45424},[],{"_3150":63908,"_27660":63840,"_19192":106182,"_5":13195,"_26170":106010,"_2648":45427},[],{"_3150":63909,"_27660":63840,"_19192":106184,"_5":13195,"_26170":106010,"_2648":106185},[],"Puerto del listener HTTP",{"_3150":63910,"_27660":63840,"_19192":106187,"_5":13195,"_26170":106010,"_2648":45433},[],{"_3150":63911,"_27660":63840,"_19192":106189,"_5":13195,"_26170":106010,"_2648":45366},[],{"_3150":63912,"_27660":63840,"_19192":106191,"_5":13195,"_26170":106010,"_2648":106192},[],"Certificado PEM para TLS downstream",{"_3150":63913,"_27660":63840,"_19192":106194,"_5":13195,"_26170":106010,"_2648":45441},[],{"_3150":63914,"_27660":63840,"_19192":106196,"_5":13195,"_26170":106010,"_2648":45366},[],{"_3150":63915,"_27660":63840,"_19192":106198,"_5":13195,"_26170":106010,"_2648":106199},[],"Clave privada PEM para TLS downstream",{"_3150":63916,"_27660":63840,"_19192":106201,"_5":13195,"_26170":106010,"_2648":45449},[],{"_3150":63917,"_27660":63840,"_19192":106203,"_5":13195,"_26170":106010,"_2648":106204},[],"chart del repositorio",{"_3150":63918,"_27660":63840,"_19192":106206,"_5":13195,"_26170":106010,"_2648":106207},[],"Usa un chart local de Lamassu sin empaquetar",{"_3150":63919,"_27660":63840,"_19192":106209,"_5":13195,"_26170":106010,"_2648":45458},[],{"_3150":63920,"_27660":63840,"_19192":106211,"_5":13195,"_26170":106010,"_2648":106212},[],"detección automática",{"_3150":63921,"_27660":63840,"_19192":106214,"_5":13195,"_26170":106010,"_2648":106215},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3150":63922,"_27660":63840,"_19192":106217,"_5":13195,"_26170":106010,"_2648":45466},[],{"_3150":63923,"_27660":63840,"_19192":106219,"_5":13195,"_26170":106010,"_2648":5899},[],{"_3150":63924,"_27660":63840,"_19192":106221,"_5":13195,"_26170":106010,"_2648":106222},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3150":63925,"_27660":63840,"_19192":106224,"_5":13195,"_26170":106010,"_2648":45474},[],{"_3150":63926,"_27660":63840,"_19192":106226,"_5":13195,"_26170":106010,"_2648":5899},[],{"_3150":63927,"_27660":63840,"_19192":106228,"_5":13195,"_26170":106010,"_2648":106229},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3150":63928,"_27660":63840,"_19192":106231,"_5":13195,"_26170":106010,"_2648":45482},[],{"_3150":63929,"_27660":63840,"_19192":106233,"_5":13195,"_26170":106010,"_2648":5899},[],{"_3150":63930,"_27660":63840,"_19192":106235,"_5":13195,"_26170":106010,"_2648":106236},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3150":63931,"_27660":63840,"_19192":106238,"_5":13195,"_26170":106010,"_2648":45490},[],{"_3150":63932,"_27660":63840,"_19192":106240,"_5":13195,"_26170":106010,"_2648":5899},[],{"_3150":63933,"_27660":63840,"_19192":106242,"_5":13195,"_26170":106010,"_2648":106243},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3150":63934,"_27660":63840,"_19192":106245,"_5":13195,"_26170":106010,"_2648":45498},[],{"_3150":63935,"_27660":63840,"_19192":106247,"_5":13195,"_26170":106010,"_2648":45501},[],{"_3150":63936,"_27660":63840,"_19192":106249,"_5":13195,"_26170":106010,"_2648":106250},[],"Usa otro chart local de SoftHSM",{"_3150":63937,"_27660":63840,"_19192":106252,"_5":13195,"_26170":106010,"_2648":106253},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3150":63938,"_27660":63840,"_19192":106255,"_5":13195,"_26170":106014,"_2648":106256},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3150":63939,"_27660":63840,"_19192":106258,"_5":13195,"_26170":106014,"_2648":106259},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3150":63940,"_27660":63840,"_19192":106261,"_5":13195,"_26170":106014,"_2648":106262},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3150":63941,"_27660":63840,"_19192":106264,"_5":13195,"_26170":106014,"_2648":106265},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3150":63942,"_27660":63840,"_19192":106267,"_5":13195,"_26170":106014,"_2648":106268},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3150":63943,"_27660":63840,"_19192":106270,"_5":13195,"_26170":106014,"_2648":106271},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3150":63944,"_27660":63840,"_19192":106273,"_5":13195,"_26170":106018,"_2648":45528},[],{"_3150":63945,"_27660":63840,"_19192":106275,"_5":13195,"_26170":106018,"_2648":106276},[],"valida las herramientas locales y el clúster seleccionado",{"_3150":63946,"_27660":63840,"_19192":106278,"_5":13195,"_26170":106018,"_2648":106279},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3150":63947,"_27660":63840,"_19192":106281,"_5":13195,"_26170":106018,"_2648":106282},[],"crea el namespace",{"_3150":63948,"_27660":63840,"_19192":106284,"_5":13195,"_26170":106018,"_2648":106285},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3150":63949,"_27660":63840,"_19192":106287,"_5":13195,"_26170":106018,"_2648":106288},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3150":63950,"_27660":63840,"_19192":106290,"_5":13195,"_26170":106018,"_2648":106291},[],"instala RabbitMQ",{"_3150":63951,"_27660":63840,"_19192":106293,"_5":13195,"_26170":106018,"_2648":106294},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3150":63952,"_27660":63840,"_19192":106296,"_5":13195,"_26170":106018,"_2648":106297},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3150":63953,"_27660":63840,"_19192":106299,"_5":13195,"_26170":106018,"_2648":106300},[],"carga datos de ejemplo opcionalmente",{"_3150":63954,"_27660":63840,"_19192":106302,"_5":13195,"_26170":106018,"_2648":106303},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3150":63955,"_27660":63840,"_19192":106305,"_5":13195,"_26170":106022,"_2648":106306},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3150":63956,"_27660":63840,"_19192":106308,"_5":13195,"_26170":106022,"_2648":106309},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3150":63957,"_27660":63840,"_19192":106311,"_5":13195,"_26170":106026,"_2648":106312},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3150":63958,"_27660":63840,"_19192":106314,"_5":13195,"_26170":106026,"_2648":106315},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3150":63959,"_27660":63840,"_19192":106317,"_5":13195,"_26170":106026,"_2648":106318},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3150":63960,"_27660":63840,"_19192":106320,"_5":13195,"_26170":106030,"_2648":106321},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3150":63961,"_27660":63961,"_5":13521,"_2648":106323,"_28003":106324,"_19192":106325,"_26170":63961},"Instala con Helm",[44970,105749,105983],[],{"_3150":63962,"_27660":63961,"_19192":106327,"_5":13195,"_26170":63961,"_2648":106328},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3150":63963,"_27660":63961,"_5":28000,"_19192":106330,"_26170":106331,"_2648":106332},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3150":63964,"_27660":63961,"_5":28000,"_19192":106334,"_26170":106335,"_2648":105999},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3150":63965,"_27660":63961,"_5":28000,"_19192":106337,"_26170":106338,"_2648":106339},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3150":63966,"_27660":63961,"_5":28000,"_19192":106341,"_26170":106342,"_2648":106343},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3150":63967,"_27660":63961,"_5":28000,"_19192":106345,"_26170":106346,"_2648":106347},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3150":63968,"_27660":63961,"_5":28000,"_19192":106349,"_26170":106350,"_2648":106351},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3150":63969,"_27660":63961,"_5":28000,"_19192":106353,"_26170":106354,"_2648":106355},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3150":63970,"_27660":63961,"_5":28000,"_19192":106357,"_26170":106358,"_2648":106359},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3150":63971,"_27660":63961,"_5":28000,"_19192":106361,"_26170":106362,"_2648":106363},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3150":63972,"_27660":63961,"_19192":106365,"_5":13195,"_26170":106331,"_2648":106366},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3150":63973,"_27660":63961,"_19192":106368,"_5":13195,"_26170":106335,"_2648":106369},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3150":63974,"_27660":63961,"_19192":106371,"_5":13195,"_26170":106335,"_2648":106372},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3150":63975,"_27660":63961,"_19192":106374,"_5":13195,"_26170":106335,"_2648":106375},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3150":63976,"_27660":63961,"_19192":106377,"_5":13195,"_26170":106335,"_2648":106378},[],"un broker RabbitMQ accesible y sus credenciales",{"_3150":63977,"_27660":63961,"_19192":106380,"_5":13195,"_26170":106335,"_2648":106381},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3150":63978,"_27660":63961,"_19192":106383,"_5":13195,"_26170":106335,"_2648":106384},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3150":63979,"_27660":63961,"_19192":106386,"_5":13195,"_26170":106335,"_2648":106387},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3150":63980,"_27660":63961,"_19192":106389,"_5":13195,"_26170":106335,"_2648":106390},[],"una StorageClass y un diseño de tráfico externo",{"_3150":63981,"_27660":63961,"_19192":106392,"_5":13195,"_26170":106335,"_2648":106393},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3150":63982,"_27660":63961,"_19192":106395,"_5":13195,"_26170":106335,"_2648":106396},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3150":63983,"_27660":63961,"_19192":106398,"_5":13195,"_26170":106335,"_2648":106399},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3150":63984,"_27660":63961,"_19192":106401,"_5":13195,"_26170":106338,"_2648":106402},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3150":63985,"_27660":63961,"_19192":106404,"_5":13195,"_26170":106338,"_2648":106405},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3150":63986,"_27660":63961,"_19192":106407,"_5":13195,"_26170":106338,"_2648":106408},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_3150":63987,"_27660":63961,"_19192":106410,"_5":13195,"_26170":106342,"_2648":106411},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3150":63988,"_27660":63961,"_19192":106413,"_5":13195,"_26170":106342,"_2648":106414},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3150":63989,"_27660":63961,"_19192":106416,"_5":13195,"_26170":106342,"_2648":106417},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3150":63990,"_27660":63961,"_19192":106419,"_5":13195,"_26170":106346,"_2648":106420},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_3150":63991,"_27660":63961,"_19192":106422,"_5":13195,"_26170":106350,"_2648":106423},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3150":63992,"_27660":63961,"_19192":106425,"_5":13195,"_26170":106350,"_2648":106426},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3150":63993,"_27660":63961,"_19192":106428,"_5":13195,"_26170":106350,"_2648":106429},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3150":63994,"_27660":63961,"_19192":106431,"_5":13195,"_26170":106350,"_2648":106432},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3150":63995,"_27660":63961,"_19192":106434,"_5":13195,"_26170":106354,"_2648":106435},[],"Para instalar un checkout local:",{"_3150":63996,"_27660":63961,"_19192":106437,"_5":13195,"_26170":106358,"_2648":106438},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3150":63997,"_27660":63961,"_19192":106440,"_5":13195,"_26170":106358,"_2648":106441},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3150":63998,"_27660":63961,"_19192":106443,"_5":13195,"_26170":106362,"_2648":106444},[],"Antes de pasar a producción, revisa:",{"_3150":63999,"_27660":63961,"_19192":106446,"_5":13195,"_26170":106362,"_2648":106447},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3150":64000,"_27660":63961,"_19192":106449,"_5":13195,"_26170":106362,"_2648":106450},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3150":64001,"_27660":63961,"_19192":106452,"_5":13195,"_26170":106362,"_2648":106453},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3150":64002,"_27660":63961,"_19192":106455,"_5":13195,"_26170":106362,"_2648":106456},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3150":64003,"_27660":63961,"_19192":106458,"_5":13195,"_26170":106362,"_2648":106459},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3150":64004,"_27660":63961,"_19192":106461,"_5":13195,"_26170":106362,"_2648":106462},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3150":64005,"_27660":63961,"_19192":106464,"_5":13195,"_26170":106362,"_2648":106465},[],"SMTP, observabilidad y entrega de alertas",{"_3150":64006,"_27660":63961,"_19192":106467,"_5":13195,"_26170":106362,"_2648":106468},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3150":64007,"_27660":63961,"_19192":106470,"_5":13195,"_26170":106362,"_2648":106471},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3150":64008,"_27660":64008,"_5":13521,"_2648":106473,"_28003":106474,"_19192":106475,"_26170":64008},"Expón el Gateway",[44970,105749,105983],[],{"_3150":64009,"_27660":64008,"_19192":106477,"_5":13195,"_26170":64008,"_2648":106478},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3150":64010,"_27660":64008,"_5":28000,"_19192":106480,"_26170":106481,"_2648":106482},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3150":64011,"_27660":64008,"_5":28000,"_19192":106484,"_26170":106485,"_2648":106486},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3150":64012,"_27660":64008,"_5":28000,"_19192":106488,"_26170":106489,"_2648":106490},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3150":64013,"_27660":64008,"_5":28000,"_19192":106492,"_26170":106493,"_2648":45749},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#k3s",{"_3150":64014,"_27660":64008,"_5":28000,"_19192":106495,"_26170":106496,"_2648":106497},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3150":64015,"_27660":64008,"_5":28000,"_19192":106499,"_26170":106500,"_2648":106501},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3150":64016,"_27660":64008,"_5":28000,"_19192":106503,"_26170":106504,"_2648":106505},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3150":64017,"_27660":64008,"_5":28000,"_19192":106507,"_26170":106508,"_2648":106509},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3150":64018,"_27660":64008,"_5":28000,"_19192":106511,"_26170":106512,"_2648":106513},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3150":64019,"_27660":64008,"_19192":106515,"_5":13195,"_26170":106481,"_2648":106516},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3150":64020,"_27660":64008,"_19192":106518,"_5":13195,"_26170":106481,"_2648":106519},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3150":64021,"_27660":64008,"_19192":106521,"_5":13195,"_26170":106485,"_2648":106522},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3150":64022,"_27660":64008,"_19192":106524,"_5":13195,"_26170":106485,"_2648":106525},[],"Defínelo únicamente cuando:",{"_3150":64023,"_27660":64008,"_19192":106527,"_5":13195,"_26170":106485,"_2648":106528},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3150":64024,"_27660":64008,"_19192":106530,"_5":13195,"_26170":106485,"_2648":106531},[],"esa dirección está asignada a este Gateway",{"_3150":64025,"_27660":64008,"_19192":106533,"_5":13195,"_26170":106485,"_2648":106534},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3150":64026,"_27660":64008,"_19192":106536,"_5":13195,"_26170":106485,"_2648":106537},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3150":64027,"_27660":64008,"_19192":106539,"_5":13195,"_26170":106485,"_2648":106540},[],"No confundas estos valores:",{"_3150":64028,"_27660":64008,"_19192":106542,"_5":13195,"_26170":106485,"_2648":106543},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3150":64029,"_27660":64008,"_19192":106545,"_5":13195,"_26170":106485,"_2648":106546},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3150":64030,"_27660":64008,"_19192":106548,"_5":13195,"_26170":106485,"_2648":106549},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3150":64031,"_27660":64008,"_19192":106551,"_5":13195,"_26170":106489,"_2648":106552},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3150":64032,"_27660":64008,"_19192":106554,"_5":13195,"_26170":106489,"_2648":106555},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3150":64033,"_27660":64008,"_19192":106557,"_5":13195,"_26170":106493,"_2648":106558},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3150":64034,"_27660":64008,"_19192":106560,"_5":13195,"_26170":106493,"_2648":106561},[],"Para el diseño recomendado:",{"_3150":64035,"_27660":64008,"_19192":106563,"_5":13195,"_26170":106493,"_2648":106564},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3150":64036,"_27660":64008,"_19192":106566,"_5":13195,"_26170":106493,"_2648":106567},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3150":64037,"_27660":64008,"_19192":106569,"_5":13195,"_26170":106493,"_2648":106570},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3150":64038,"_27660":64008,"_19192":106572,"_5":13195,"_26170":106493,"_2648":106573},[],"Apunta DNS a la dirección accesible de la VM.",{"_3150":64039,"_27660":64008,"_19192":106575,"_5":13195,"_26170":106493,"_2648":106576},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3150":64040,"_27660":64008,"_19192":106578,"_5":13195,"_26170":106496,"_2648":106579},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3150":64041,"_27660":64008,"_19192":106581,"_5":13195,"_26170":106500,"_2648":106582},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3150":64042,"_27660":64008,"_19192":106584,"_5":13195,"_26170":106500,"_2648":106585},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3150":64043,"_27660":64008,"_19192":106587,"_5":13195,"_26170":106504,"_2648":106588},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3150":64044,"_27660":64008,"_19192":106590,"_5":13195,"_26170":106504,"_2648":106591},[],"Requisito",{"_3150":64045,"_27660":64008,"_19192":106593,"_5":13195,"_26170":106504,"_2648":106594},[],"Diseño recomendado",{"_3150":64046,"_27660":64008,"_19192":106596,"_5":13195,"_26170":106504,"_2648":106597},[],"Consecuencia",{"_3150":64047,"_27660":64008,"_19192":106599,"_5":13195,"_26170":106504,"_2648":106600},[],"Varias URL o servicios de Lamassu",{"_3150":64048,"_27660":64008,"_19192":106602,"_5":13195,"_26170":106504,"_2648":106603},[],"Un Gateway con varias rutas",{"_3150":64049,"_27660":64008,"_19192":106605,"_5":13195,"_26170":106504,"_2648":106606},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3150":64050,"_27660":64008,"_19192":106608,"_5":13195,"_26170":106504,"_2648":106609},[],"Gateways independientes e IP externas distintas",{"_3150":64051,"_27660":64008,"_19192":106611,"_5":13195,"_26170":106504,"_2648":106612},[],"Una VIP por Gateway",{"_3150":64052,"_27660":64008,"_19192":106614,"_5":13195,"_26170":106504,"_2648":106615},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3150":64053,"_27660":64008,"_19192":106617,"_5":13195,"_26170":106504,"_2648":106618},[],"Gateways independientes, un nodo y una IP",{"_3150":64054,"_27660":64008,"_19192":106620,"_5":13195,"_26170":106504,"_2648":106621},[],"Puertos externos diferentes",{"_3150":64055,"_27660":64008,"_19192":106623,"_5":13195,"_26170":106504,"_2648":106624},[],"Los clientes deben indicar puertos no estándar",{"_3150":64056,"_27660":64008,"_19192":106626,"_5":13195,"_26170":106504,"_2648":106627},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3150":64057,"_27660":64008,"_19192":106629,"_5":13195,"_26170":106504,"_2648":106630},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3150":64058,"_27660":64008,"_19192":106632,"_5":13195,"_26170":106504,"_2648":106633},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3150":64059,"_27660":64008,"_19192":106635,"_5":13195,"_26170":106504,"_2648":106636},[],"Recursos Gateway separados pero proxy compartido",{"_3150":64060,"_27660":64008,"_19192":106638,"_5":13195,"_26170":106504,"_2648":106639},[],"Modo merged Gateway de Envoy",{"_3150":64061,"_27660":64008,"_19192":106641,"_5":13195,"_26170":106504,"_2648":106642},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3150":64062,"_27660":64008,"_19192":106644,"_5":13195,"_26170":106504,"_2648":106645},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3150":64063,"_27660":64008,"_19192":106647,"_5":13195,"_26170":106504,"_2648":106648},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3150":64064,"_27660":64008,"_19192":106650,"_5":13195,"_26170":106504,"_2648":106651},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3150":64065,"_27660":64008,"_19192":106653,"_5":13195,"_26170":106504,"_2648":106654},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3150":64066,"_27660":64008,"_19192":106656,"_5":13195,"_26170":106508,"_2648":106657},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3150":64067,"_27660":64008,"_19192":106659,"_5":13195,"_26170":106508,"_2648":106660},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3150":64068,"_27660":64008,"_19192":106662,"_5":13195,"_26170":106508,"_2648":106663},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3150":64069,"_27660":64008,"_19192":106665,"_5":13195,"_26170":106508,"_2648":106666},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3150":64070,"_27660":64008,"_19192":106668,"_5":13195,"_26170":106508,"_2648":106669},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3150":64071,"_27660":64008,"_19192":106671,"_5":13195,"_26170":106512,"_2648":106672},[],"Comprueba, en orden:",{"_3150":64072,"_27660":64008,"_19192":106674,"_5":13195,"_26170":106512,"_2648":106675},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3150":64073,"_27660":64008,"_19192":106677,"_5":13195,"_26170":106512,"_2648":106678},[],"Su estado contiene la dirección esperada.",{"_3150":64074,"_27660":64008,"_19192":106680,"_5":13195,"_26170":106512,"_2648":106681},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3150":64075,"_27660":64008,"_19192":106683,"_5":13195,"_26170":106512,"_2648":106684},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3150":64076,"_27660":64008,"_19192":106686,"_5":13195,"_26170":106512,"_2648":106687},[],"DNS resuelve al endpoint accesible externamente.",{"_3150":64077,"_27660":64008,"_19192":106689,"_5":13195,"_26170":106512,"_2648":106690},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3150":64078,"_27660":64008,"_19192":106692,"_5":13195,"_26170":106512,"_2648":106693},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3150":64079,"_27660":64079,"_5":13521,"_2648":45077,"_28003":106695,"_19192":106696,"_26170":64079},[44970,105749,105983],[],{"_3150":64080,"_27660":64079,"_19192":106698,"_5":13195,"_26170":64079,"_2648":106699},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3150":64081,"_27660":64079,"_5":28000,"_19192":106701,"_26170":106702,"_2648":106703},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3150":64082,"_27660":64079,"_5":28000,"_19192":106705,"_26170":106706,"_2648":106707},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3150":64083,"_27660":64079,"_5":28000,"_19192":106709,"_26170":106710,"_2648":106711},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3150":64084,"_27660":64079,"_5":28000,"_19192":106713,"_26170":106714,"_2648":106715},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3150":64085,"_27660":64079,"_5":28000,"_19192":106717,"_26170":106718,"_2648":106719},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3150":64086,"_27660":64079,"_5":28000,"_19192":106721,"_26170":106722,"_2648":106723},[],"/docs/pr-preview/pr-26/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3150":64087,"_27660":64079,"_19192":106725,"_5":13195,"_26170":106702,"_2648":106726},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3150":64088,"_27660":64079,"_19192":106728,"_5":13195,"_26170":106706,"_2648":106729},[],"Flujo",{"_3150":64089,"_27660":64079,"_19192":106731,"_5":13195,"_26170":106706,"_2648":106732},[],"Úsalo para",{"_3150":64090,"_27660":64079,"_19192":106734,"_5":13195,"_26170":106706,"_2648":106735},[],"Qué instala",{"_3150":64091,"_27660":64079,"_19192":106737,"_5":13195,"_26170":106706,"_2648":45994},[],{"_3150":64092,"_27660":64079,"_19192":106739,"_5":13195,"_26170":106706,"_2648":106740},[],"Producción y entornos controlados",{"_3150":64093,"_27660":64079,"_19192":106742,"_5":13195,"_26170":106706,"_2648":106743},[],"Servicios de Lamassu y recursos de Gateway API",{"_3150":64094,"_27660":64079,"_19192":106745,"_5":13195,"_26170":106706,"_2648":45214},[],{"_3150":64095,"_27660":64079,"_19192":106747,"_5":13195,"_26170":106706,"_2648":106748},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3150":64096,"_27660":64079,"_19192":106750,"_5":13195,"_26170":106706,"_2648":106751},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3150":64097,"_27660":64079,"_19192":106753,"_5":13195,"_26170":106710,"_2648":106754},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3150":64098,"_27660":64079,"_19192":106756,"_5":13195,"_26170":106710,"_2648":106757},[],"Área",{"_3150":64099,"_27660":64079,"_19192":106759,"_5":13195,"_26170":106710,"_2648":106760},[],"El chart de Lamassu proporciona",{"_3150":64100,"_27660":64079,"_19192":106762,"_5":13195,"_26170":106710,"_2648":106763},[],"Tú proporcionas",{"_3150":64101,"_27660":64079,"_19192":106765,"_5":13195,"_26170":106710,"_2648":106766},[],"Aplicaciones Lamassu",{"_3150":64102,"_27660":64079,"_19192":106768,"_5":13195,"_26170":106710,"_2648":106769},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3150":64103,"_27660":64079,"_19192":106771,"_5":13195,"_26170":106710,"_2648":106772},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3150":64104,"_27660":64079,"_19192":106774,"_5":13195,"_26170":106710,"_2648":106775},[],"Datos PostgreSQL",{"_3150":64105,"_27660":64079,"_19192":106777,"_5":13195,"_26170":106710,"_2648":106778},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3150":64106,"_27660":64079,"_19192":106780,"_5":13195,"_26170":106710,"_2648":106781},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3150":64107,"_27660":64079,"_19192":106783,"_5":13195,"_26170":106710,"_2648":106784},[],"Mensajería",{"_3150":64108,"_27660":64079,"_19192":106786,"_5":13195,"_26170":106710,"_2648":106787},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3150":64109,"_27660":64079,"_19192":106789,"_5":13195,"_26170":106710,"_2648":106790},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3150":64110,"_27660":64079,"_19192":106792,"_5":13195,"_26170":106710,"_2648":106793},[],"Identidad",{"_3150":64111,"_27660":64079,"_19192":106795,"_5":13195,"_26170":106710,"_2648":106796},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3150":64112,"_27660":64079,"_19192":106798,"_5":13195,"_26170":106710,"_2648":106799},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3150":64113,"_27660":64079,"_19192":106801,"_5":13195,"_26170":106710,"_2648":106802},[],"Enrutamiento externo",{"_3150":64114,"_27660":64079,"_19192":106804,"_5":13195,"_26170":106710,"_2648":106805},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3150":64115,"_27660":64079,"_19192":106807,"_5":13195,"_26170":106710,"_2648":106808},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3150":64116,"_27660":64079,"_19192":106810,"_5":13195,"_26170":106710,"_2648":46068},[],{"_3150":64117,"_27660":64079,"_19192":106812,"_5":13195,"_26170":106710,"_2648":106813},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_3150":64118,"_27660":64079,"_19192":106815,"_5":13195,"_26170":106710,"_2648":106816},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3150":64119,"_27660":64079,"_19192":106818,"_5":13195,"_26170":106710,"_2648":106819},[],"Datos persistentes de la aplicación",{"_3150":64120,"_27660":64079,"_19192":106821,"_5":13195,"_26170":106710,"_2648":106822},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3150":64121,"_27660":64079,"_19192":106824,"_5":13195,"_26170":106710,"_2648":106825},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3150":64122,"_27660":64079,"_19192":106827,"_5":13195,"_26170":106710,"_2648":106828},[],"Integraciones opcionales",{"_3150":64123,"_27660":64079,"_19192":106830,"_5":13195,"_26170":106710,"_2648":106831},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3150":64124,"_27660":64079,"_19192":106833,"_5":13195,"_26170":106710,"_2648":106834},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3150":64125,"_27660":64079,"_19192":106836,"_5":13195,"_26170":106710,"_2648":106837},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3150":64126,"_27660":64079,"_19192":106839,"_5":13195,"_26170":106710,"_2648":106840},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3150":64127,"_27660":64079,"_19192":106842,"_5":13195,"_26170":106714,"_2648":106843},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3150":64128,"_27660":64079,"_19192":106845,"_5":13195,"_26170":106714,"_2648":106846},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3150":64129,"_27660":64079,"_19192":106848,"_5":13195,"_26170":106718,"_2648":106849},[],"Kubernetes 1.24 o posterior",{"_3150":64130,"_27660":64079,"_19192":106851,"_5":13195,"_26170":106718,"_2648":106852},[],"Helm 3.2 o posterior",{"_3150":64131,"_27660":64079,"_19192":106854,"_5":13195,"_26170":106718,"_2648":106855},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3150":64132,"_27660":64079,"_19192":106857,"_5":13195,"_26170":106718,"_2648":106858},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_3150":64133,"_27660":64079,"_19192":106860,"_5":13195,"_26170":106718,"_2648":106861},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3150":64134,"_27660":64079,"_19192":106863,"_5":13195,"_26170":106718,"_2648":106864},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3150":64135,"_27660":64079,"_19192":106866,"_5":13195,"_26170":106718,"_2648":106867},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3150":64136,"_27660":64079,"_19192":106869,"_5":13195,"_26170":106722,"_2648":106870},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":64137,"_27660":64079,"_19192":106872,"_5":13195,"_26170":106722,"_2648":106873},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3150":64138,"_27660":64079,"_19192":106875,"_5":13195,"_26170":106722,"_2648":106876},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3150":64139,"_27660":64079,"_19192":106878,"_5":13195,"_26170":106722,"_2648":106879},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3150":64140,"_27660":64140,"_5":13521,"_2648":106881,"_28003":106882,"_19192":106884,"_26170":64140},"Resolución de problemas de despliegue",[44970,105749,106883],"Operación",[],{"_3150":64141,"_27660":64140,"_19192":106886,"_5":13195,"_26170":64140,"_2648":106887},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3150":64142,"_27660":64140,"_5":28000,"_19192":106889,"_26170":106890,"_2648":106891},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3150":64143,"_27660":64140,"_5":28000,"_19192":106893,"_26170":106894,"_2648":106895},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3150":64144,"_27660":64140,"_5":28000,"_19192":106897,"_26170":106898,"_2648":106899},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3150":64145,"_27660":64140,"_5":28000,"_19192":106901,"_26170":106902,"_2648":106903},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3150":64146,"_27660":64140,"_5":28000,"_19192":106905,"_26170":106906,"_2648":106907},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3150":64147,"_27660":64140,"_5":28000,"_19192":106909,"_26170":106910,"_2648":106911},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3150":64148,"_27660":64140,"_5":28000,"_19192":106913,"_26170":106914,"_2648":106915},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3150":64149,"_27660":64140,"_5":28000,"_19192":106917,"_26170":106918,"_2648":106919},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3150":64150,"_27660":64140,"_5":28000,"_19192":106921,"_26170":106922,"_2648":106923},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3150":64151,"_27660":64140,"_5":28000,"_19192":106925,"_26170":106926,"_2648":106927},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3150":64152,"_27660":64140,"_5":28000,"_19192":106929,"_26170":106930,"_2648":106931},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3150":64153,"_27660":64140,"_5":28000,"_19192":106933,"_26170":106934,"_2648":106935},[],"/docs/pr-preview/pr-26/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3150":64154,"_27660":64140,"_19192":106937,"_5":13195,"_26170":64140,"_2648":106938},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3150":64155,"_27660":64140,"_19192":106940,"_5":13195,"_26170":106894,"_2648":106941},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3150":64156,"_27660":64140,"_19192":106943,"_5":13195,"_26170":106898,"_2648":106944},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3150":64157,"_27660":64140,"_19192":106946,"_5":13195,"_26170":106902,"_2648":106947},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3150":64158,"_27660":64140,"_19192":106949,"_5":13195,"_26170":106906,"_2648":106950},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3150":64159,"_27660":64140,"_19192":106952,"_5":13195,"_26170":106910,"_2648":106953},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3150":64160,"_27660":64140,"_19192":106955,"_5":13195,"_26170":106914,"_2648":106956},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3150":64161,"_27660":64140,"_19192":106958,"_5":13195,"_26170":106914,"_2648":106959},[],"Ejecuta también la prueba de conectividad del chart:",{"_3150":64162,"_27660":64140,"_19192":106961,"_5":13195,"_26170":106914,"_2648":106962},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3150":64163,"_27660":64140,"_19192":106964,"_5":13195,"_26170":106914,"_2648":106965},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3150":64164,"_27660":64140,"_19192":106967,"_5":13195,"_26170":106918,"_2648":106968},[],"Si recibes un 401:",{"_3150":64165,"_27660":64140,"_19192":106970,"_5":13195,"_26170":106918,"_2648":106971},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3150":64166,"_27660":64140,"_19192":106973,"_5":13195,"_26170":106918,"_2648":106974},[],"verifica emisor, audiencia y expiración del token;",{"_3150":64167,"_27660":64140,"_19192":106976,"_5":13195,"_26170":106918,"_2648":106977},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3150":64168,"_27660":64140,"_19192":106979,"_5":13195,"_26170":106918,"_2648":106980},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3150":64169,"_27660":64140,"_19192":106982,"_5":13195,"_26170":106918,"_2648":106983},[],"Si el login termina pero las APIs devuelven 403:",{"_3150":64170,"_27660":64140,"_19192":106985,"_5":13195,"_26170":106918,"_2648":106986},[],"inspecciona los claims reales del token;",{"_3150":64171,"_27660":64140,"_19192":106988,"_5":13195,"_26170":106918,"_2648":106989},[],"confirma que coinciden con un principal activo;",{"_3150":64172,"_27660":64140,"_19192":106991,"_5":13195,"_26170":106918,"_2648":106992},[],"revisa las políticas concedidas al principal;",{"_3150":64173,"_27660":64140,"_19192":106994,"_5":13195,"_26170":106918,"_2648":106995},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3150":64174,"_27660":64140,"_19192":106997,"_5":13195,"_26170":106918,"_2648":106998},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3150":64175,"_27660":64140,"_19192":107000,"_5":13195,"_26170":106922,"_2648":107001},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3150":64176,"_27660":64140,"_19192":107003,"_5":13195,"_26170":106922,"_2648":107004},[],"Localiza el pod y Service de authz.",{"_3150":64177,"_27660":64140,"_19192":107006,"_5":13195,"_26170":106922,"_2648":107007},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3150":64178,"_27660":64140,"_19192":107009,"_5":13195,"_26170":106922,"_2648":107010},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3150":64179,"_27660":64140,"_19192":107012,"_5":13195,"_26170":106922,"_2648":107013},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3150":64180,"_27660":64140,"_19192":107015,"_5":13195,"_26170":106922,"_2648":107016},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3150":64181,"_27660":64140,"_19192":107018,"_5":13195,"_26170":106926,"_2648":107019},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3150":64182,"_27660":64140,"_19192":107021,"_5":13195,"_26170":106926,"_2648":107022},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3150":64183,"_27660":64140,"_19192":107024,"_5":13195,"_26170":106926,"_2648":107025},[],"volumen persistente sin enlazar;",{"_3150":64184,"_27660":64140,"_19192":107027,"_5":13195,"_26170":106926,"_2648":107028},[],"imagen inaccesible o política de pull incorrecta;",{"_3150":64185,"_27660":64140,"_19192":107030,"_5":13195,"_26170":106926,"_2648":107031},[],"configuración inválida del motor criptográfico;",{"_3150":64186,"_27660":64140,"_19192":107033,"_5":13195,"_26170":106926,"_2648":107034},[],"límites de CPU o memoria demasiado bajos;",{"_3150":64187,"_27660":64140,"_19192":107036,"_5":13195,"_26170":106926,"_2648":107037},[],"migración previa incompleta.",{"_3150":64188,"_27660":64140,"_19192":107039,"_5":13195,"_26170":106926,"_2648":107040},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3150":64189,"_27660":64140,"_19192":107042,"_5":13195,"_26170":106926,"_2648":107043},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3150":64190,"_27660":64140,"_19192":107045,"_5":13195,"_26170":106930,"_2648":107046},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3150":64191,"_27660":64140,"_19192":107048,"_5":13195,"_26170":106930,"_2648":107049},[],"verifica que esté habilitado en el servicio emisor;",{"_3150":64192,"_27660":64140,"_19192":107051,"_5":13195,"_26170":106930,"_2648":107052},[],"comprueba conectividad y credenciales AMQP;",{"_3150":64193,"_27660":64140,"_19192":107054,"_5":13195,"_26170":106930,"_2648":107055},[],"revisa exchange, routing key, colas y consumidores;",{"_3150":64194,"_27660":64140,"_19192":107057,"_5":13195,"_26170":106930,"_2648":107058},[],"inspecciona dead-letter queues;",{"_3150":64195,"_27660":64140,"_19192":107060,"_5":13195,"_26170":106930,"_2648":107061},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3150":64196,"_27660":64140,"_19192":107063,"_5":13195,"_26170":106930,"_2648":107064},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3150":64197,"_27660":64140,"_19192":107066,"_5":13195,"_26170":106934,"_2648":107067},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3150":64198,"_27660":64140,"_19192":107069,"_5":13195,"_26170":106934,"_2648":107070},[],"Antes de cerrar una incidencia, guarda:",{"_3150":64199,"_27660":64140,"_19192":107072,"_5":13195,"_26170":106934,"_2648":107073},[],"causa confirmada;",{"_3150":64200,"_27660":64140,"_19192":107075,"_5":13195,"_26170":106934,"_2648":107076},[],"alcance temporal y recursos afectados;",{"_3150":64201,"_27660":64140,"_19192":107078,"_5":13195,"_26170":106934,"_2648":107079},[],"comandos o consultas utilizados;",{"_3150":64202,"_27660":64140,"_19192":107081,"_5":13195,"_26170":106934,"_2648":107082},[],"cambio aplicado y forma de revertirlo;",{"_3150":64203,"_27660":64140,"_19192":107084,"_5":13195,"_26170":106934,"_2648":107085},[],"validación desde un consumidor;",{"_3150":64204,"_27660":64140,"_19192":107087,"_5":13195,"_26170":106934,"_2648":107088},[],"acción preventiva y propietario.",{"_3150":64205,"_27660":64205,"_5":13521,"_2648":107090,"_28003":107091,"_19192":107094,"_26170":64205},"Control de acceso",[44970,107092,107093],"Plataforma","Administración",[],{"_3150":64206,"_27660":64205,"_19192":107096,"_5":13195,"_26170":64205,"_2648":107097},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3150":64207,"_27660":64205,"_5":28000,"_19192":107099,"_26170":107100,"_2648":107101},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3150":64208,"_27660":64205,"_5":28000,"_19192":107103,"_26170":107104,"_2648":107105},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3150":64209,"_27660":64205,"_5":28000,"_19192":107107,"_26170":107108,"_2648":107109},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3150":64210,"_27660":64205,"_5":28000,"_19192":107111,"_26170":107112,"_2648":107113},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3150":64211,"_27660":64205,"_5":28000,"_19192":107115,"_26170":107116,"_2648":107117},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3150":64212,"_27660":64205,"_5":28000,"_19192":107119,"_26170":107120,"_2648":107121},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3150":64213,"_27660":64205,"_5":28000,"_19192":107123,"_26170":107124,"_2648":107125},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3150":64214,"_27660":64205,"_5":28000,"_19192":107127,"_26170":107128,"_2648":107129},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3150":64215,"_27660":64205,"_5":28000,"_19192":107131,"_26170":107132,"_2648":107133},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3150":64216,"_27660":64205,"_5":28000,"_19192":107135,"_26170":107136,"_2648":107137},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3150":64217,"_27660":64205,"_5":28000,"_19192":107139,"_26170":107140,"_2648":107141},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3150":64218,"_27660":64205,"_5":28000,"_19192":107143,"_26170":107144,"_2648":107145},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3150":64219,"_27660":64205,"_5":28000,"_19192":107147,"_26170":107148,"_2648":107149},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3150":64220,"_27660":64205,"_5":28000,"_19192":107151,"_26170":107152,"_2648":107153},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3150":64221,"_27660":64205,"_5":28000,"_19192":107155,"_26170":107156,"_2648":107157},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3150":64222,"_27660":64205,"_5":28000,"_19192":107159,"_26170":107160,"_2648":106351},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3150":64223,"_27660":64205,"_5":28000,"_19192":107162,"_26170":107163,"_2648":107164},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3150":64224,"_27660":64205,"_5":28000,"_19192":107166,"_26170":107167,"_2648":107168},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3150":64225,"_27660":64205,"_5":28000,"_19192":107170,"_26170":107171,"_2648":107172},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3150":64226,"_27660":64205,"_5":28000,"_19192":107174,"_26170":107175,"_2648":107176},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3150":64227,"_27660":64205,"_5":28000,"_19192":107178,"_26170":107179,"_2648":107180},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3150":64228,"_27660":64205,"_5":28000,"_19192":107182,"_26170":107183,"_2648":107184},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3150":64229,"_27660":64205,"_5":28000,"_19192":107186,"_26170":107187,"_2648":107188},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3150":64230,"_27660":64205,"_5":28000,"_19192":107190,"_26170":107191,"_2648":107192},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3150":64231,"_27660":64205,"_5":28000,"_19192":107194,"_26170":107195,"_2648":107196},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3150":64232,"_27660":64205,"_5":28000,"_19192":107198,"_26170":107199,"_2648":107200},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3150":64233,"_27660":64205,"_5":28000,"_19192":107202,"_26170":107203,"_2648":107204},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3150":64234,"_27660":64205,"_5":28000,"_19192":107206,"_26170":107207,"_2648":107208},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3150":64235,"_27660":64205,"_5":28000,"_19192":107210,"_26170":107211,"_2648":107212},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3150":64236,"_27660":64205,"_5":28000,"_19192":107214,"_26170":107215,"_2648":107216},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3150":64237,"_27660":64205,"_5":28000,"_19192":107218,"_26170":107219,"_2648":107220},[],"/docs/pr-preview/pr-26/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3150":64238,"_27660":64205,"_19192":107222,"_5":13195,"_26170":64205,"_2648":107223},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3150":64239,"_27660":64205,"_19192":107225,"_5":13195,"_26170":64205,"_2648":107226},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3150":64240,"_27660":64205,"_19192":107228,"_5":13195,"_26170":64205,"_2648":107229},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3150":64241,"_27660":64205,"_19192":107231,"_5":13195,"_26170":107100,"_2648":107232},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3150":64242,"_27660":64205,"_19192":107234,"_5":13195,"_26170":107100,"_2648":107235},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3150":64243,"_27660":64205,"_19192":107237,"_5":13195,"_26170":107100,"_2648":107238},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3150":64244,"_27660":64205,"_19192":107240,"_5":13195,"_26170":107100,"_2648":107241},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3150":64245,"_27660":64205,"_19192":107243,"_5":13195,"_26170":107100,"_2648":107244},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3150":64246,"_27660":64205,"_19192":107246,"_5":13195,"_26170":107100,"_2648":107247},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3150":64247,"_27660":64205,"_19192":107249,"_5":13195,"_26170":107104,"_2648":107250},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3150":64248,"_27660":64205,"_19192":107252,"_5":13195,"_26170":107104,"_2648":107253},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3150":64249,"_27660":64205,"_19192":107255,"_5":13195,"_26170":107108,"_2648":107256},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3150":64250,"_27660":64205,"_19192":107258,"_5":13195,"_26170":107108,"_2648":107259},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3150":64251,"_27660":64205,"_19192":107261,"_5":13195,"_26170":107108,"_2648":107262},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3150":64252,"_27660":64205,"_19192":107264,"_5":13195,"_26170":107108,"_2648":107265},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3150":64253,"_27660":64205,"_19192":107267,"_5":13195,"_26170":107108,"_2648":107268},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3150":64254,"_27660":64205,"_19192":107270,"_5":13195,"_26170":107108,"_2648":107271},[],"Carga por separado las políticas concedidas a cada principal.",{"_3150":64255,"_27660":64205,"_19192":107273,"_5":13195,"_26170":107108,"_2648":107274},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3150":64256,"_27660":64205,"_19192":107276,"_5":13195,"_26170":107108,"_2648":107277},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3150":64257,"_27660":64205,"_19192":107279,"_5":13195,"_26170":107108,"_2648":107280},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3150":64258,"_27660":64205,"_19192":107282,"_5":13195,"_26170":107108,"_2648":107283},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3150":64259,"_27660":64205,"_19192":107285,"_5":13195,"_26170":107108,"_2648":107286},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3150":64260,"_27660":64205,"_19192":107288,"_5":13195,"_26170":107108,"_2648":107289},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3150":64261,"_27660":64205,"_19192":107291,"_5":13195,"_26170":107112,"_2648":107292},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3150":64262,"_27660":64205,"_19192":107294,"_5":13195,"_26170":107112,"_2648":107295},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3150":64263,"_27660":64205,"_19192":107297,"_5":13195,"_26170":107112,"_2648":107298},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3150":64264,"_27660":64205,"_19192":107300,"_5":13195,"_26170":107112,"_2648":107301},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3150":64265,"_27660":64205,"_19192":107303,"_5":13195,"_26170":107112,"_2648":107304},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3150":64266,"_27660":64205,"_19192":107306,"_5":13195,"_26170":107112,"_2648":107307},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3150":64267,"_27660":64205,"_19192":107309,"_5":13195,"_26170":107112,"_2648":107310},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3150":64268,"_27660":64205,"_19192":107312,"_5":13195,"_26170":107112,"_2648":107313},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3150":64269,"_27660":64205,"_19192":107315,"_5":13195,"_26170":107116,"_2648":107316},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3150":64270,"_27660":64205,"_19192":107318,"_5":13195,"_26170":107116,"_2648":107319},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3150":64271,"_27660":64205,"_19192":107321,"_5":13195,"_26170":107116,"_2648":107322},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3150":64272,"_27660":64205,"_19192":107324,"_5":13195,"_26170":107116,"_2648":107325},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3150":64273,"_27660":64205,"_19192":107327,"_5":13195,"_26170":107116,"_2648":107328},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3150":64274,"_27660":64205,"_19192":107330,"_5":13195,"_26170":107116,"_2648":107331},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3150":64275,"_27660":64205,"_19192":107333,"_5":13195,"_26170":107116,"_2648":107334},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3150":64276,"_27660":64205,"_19192":107336,"_5":13195,"_26170":107116,"_2648":107337},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3150":64277,"_27660":64205,"_19192":107339,"_5":13195,"_26170":107116,"_2648":107340},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3150":64278,"_27660":64205,"_19192":107342,"_5":13195,"_26170":107116,"_2648":107343},[],"Las acciones se dividen en dos grupos:",{"_3150":64279,"_27660":64205,"_19192":107345,"_5":13195,"_26170":107116,"_2648":107346},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3150":64280,"_27660":64205,"_19192":107348,"_5":13195,"_26170":107116,"_2648":107349},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3150":64281,"_27660":64205,"_19192":107351,"_5":13195,"_26170":107116,"_2648":107352},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3150":64282,"_27660":64205,"_19192":107354,"_5":13195,"_26170":107120,"_2648":107355},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3150":64283,"_27660":64205,"_19192":107357,"_5":13195,"_26170":107120,"_2648":107358},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3150":64284,"_27660":64205,"_19192":107360,"_5":13195,"_26170":107120,"_2648":107361},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3150":64285,"_27660":64205,"_19192":107363,"_5":13195,"_26170":107124,"_2648":107364},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3150":64286,"_27660":64205,"_19192":107366,"_5":13195,"_26170":107124,"_2648":107367},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3150":64287,"_27660":64205,"_19192":107369,"_5":13195,"_26170":107124,"_2648":107370},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3150":64288,"_27660":64205,"_19192":107372,"_5":13195,"_26170":107124,"_2648":107373},[],"Los operadores implementados son:",{"_3150":64289,"_27660":64205,"_19192":107375,"_5":13195,"_26170":107124,"_2648":107376},[],"`equals`, para igualdad exacta;",{"_3150":64290,"_27660":64205,"_19192":107378,"_5":13195,"_26170":107124,"_2648":107379},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3150":64291,"_27660":64205,"_19192":107381,"_5":13195,"_26170":107124,"_2648":107382},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3150":64292,"_27660":64205,"_19192":107384,"_5":13195,"_26170":107124,"_2648":107385},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3150":64293,"_27660":64205,"_19192":107387,"_5":13195,"_26170":107128,"_2648":107388},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3150":64294,"_27660":64205,"_19192":107390,"_5":13195,"_26170":107128,"_2648":107391},[],"Los modos disponibles son:",{"_3150":64295,"_27660":64205,"_19192":107393,"_5":13195,"_26170":107128,"_2648":107394},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3150":64296,"_27660":64205,"_19192":107396,"_5":13195,"_26170":107128,"_2648":107397},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3150":64297,"_27660":64205,"_19192":107399,"_5":13195,"_26170":107128,"_2648":107400},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3150":64298,"_27660":64205,"_19192":107402,"_5":13195,"_26170":107128,"_2648":107403},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3150":64299,"_27660":64205,"_19192":107405,"_5":13195,"_26170":107128,"_2648":107406},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3150":64300,"_27660":64205,"_19192":107408,"_5":13195,"_26170":107128,"_2648":107409},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3150":64301,"_27660":64205,"_19192":107411,"_5":13195,"_26170":107132,"_2648":107412},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3150":64302,"_27660":64205,"_19192":107414,"_5":13195,"_26170":107132,"_2648":107415},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3150":64303,"_27660":64205,"_19192":107417,"_5":13195,"_26170":107132,"_2648":107418},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3150":64304,"_27660":64205,"_19192":107420,"_5":13195,"_26170":107132,"_2648":107421},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3150":64305,"_27660":64205,"_19192":107423,"_5":13195,"_26170":107140,"_2648":107424},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3150":64306,"_27660":64205,"_19192":107426,"_5":13195,"_26170":107140,"_2648":107427},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3150":64307,"_27660":64205,"_19192":107429,"_5":13195,"_26170":107144,"_2648":107430},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3150":64308,"_27660":64205,"_19192":107432,"_5":13195,"_26170":107144,"_2648":107433},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3150":64309,"_27660":64205,"_19192":107435,"_5":13195,"_26170":107148,"_2648":107436},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3150":64310,"_27660":64205,"_19192":107438,"_5":13195,"_26170":107148,"_2648":107439},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3150":64311,"_27660":64205,"_19192":107441,"_5":13195,"_26170":107148,"_2648":107442},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3150":64312,"_27660":64205,"_19192":107444,"_5":13195,"_26170":107152,"_2648":107445},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3150":64313,"_27660":64205,"_19192":107447,"_5":13195,"_26170":107152,"_2648":107448},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3150":64314,"_27660":64205,"_19192":107450,"_5":13195,"_26170":107152,"_2648":107451},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3150":64315,"_27660":64205,"_19192":107453,"_5":13195,"_26170":107152,"_2648":107454},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3150":64316,"_27660":64205,"_19192":107456,"_5":13195,"_26170":107152,"_2648":107457},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3150":64317,"_27660":64205,"_19192":107459,"_5":13195,"_26170":107152,"_2648":107460},[],"Ten en cuenta que:",{"_3150":64318,"_27660":64205,"_19192":107462,"_5":13195,"_26170":107152,"_2648":107463},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3150":64319,"_27660":64205,"_19192":107465,"_5":13195,"_26170":107152,"_2648":107466},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3150":64320,"_27660":64205,"_19192":107468,"_5":13195,"_26170":107152,"_2648":107469},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3150":64321,"_27660":64205,"_19192":107471,"_5":13195,"_26170":107156,"_2648":107472},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3150":64322,"_27660":64205,"_19192":107474,"_5":13195,"_26170":107156,"_2648":107475},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3150":64323,"_27660":64205,"_19192":107477,"_5":13195,"_26170":107156,"_2648":107478},[],"acceso completo y de solo lectura a KMS;",{"_3150":64324,"_27660":64205,"_19192":107480,"_5":13195,"_26170":107156,"_2648":107481},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3150":64325,"_27660":64205,"_19192":107483,"_5":13195,"_26170":107156,"_2648":107484},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3150":64326,"_27660":64205,"_19192":107486,"_5":13195,"_26170":107156,"_2648":107487},[],"acceso a la interfaz;",{"_3150":64327,"_27660":64205,"_19192":107489,"_5":13195,"_26170":107156,"_2648":107490},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3150":64328,"_27660":64205,"_19192":107492,"_5":13195,"_26170":107156,"_2648":107493},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3150":64329,"_27660":64205,"_19192":107495,"_5":13195,"_26170":107156,"_2648":107496},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3150":64330,"_27660":64205,"_19192":107498,"_5":13195,"_26170":107160,"_2648":107499},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3150":64331,"_27660":64205,"_19192":107501,"_5":13195,"_26170":107160,"_2648":107502},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3150":64332,"_27660":64205,"_19192":107504,"_5":13195,"_26170":107160,"_2648":107505},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3150":64333,"_27660":64205,"_19192":107507,"_5":13195,"_26170":107163,"_2648":107508},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3150":64334,"_27660":64205,"_19192":107510,"_5":13195,"_26170":107167,"_2648":107511},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3150":64335,"_27660":64205,"_19192":107513,"_5":13195,"_26170":107167,"_2648":107514},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3150":64336,"_27660":64205,"_19192":107516,"_5":13195,"_26170":107171,"_2648":107517},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3150":64337,"_27660":64205,"_19192":107519,"_5":13195,"_26170":107175,"_2648":107520},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3150":64338,"_27660":64205,"_19192":107522,"_5":13195,"_26170":107179,"_2648":107523},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3150":64339,"_27660":64205,"_19192":107525,"_5":13195,"_26170":107183,"_2648":107526},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3150":64340,"_27660":64205,"_19192":107528,"_5":13195,"_26170":107183,"_2648":107529},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3150":64341,"_27660":64205,"_19192":107531,"_5":13195,"_26170":107187,"_2648":107532},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3150":64342,"_27660":64205,"_19192":107534,"_5":13195,"_26170":107187,"_2648":107535},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3150":64343,"_27660":64205,"_19192":107537,"_5":13195,"_26170":107187,"_2648":107538},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3150":64344,"_27660":64205,"_19192":107540,"_5":13195,"_26170":107187,"_2648":107541},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3150":64345,"_27660":64205,"_19192":107543,"_5":13195,"_26170":107187,"_2648":107544},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3150":64346,"_27660":64205,"_19192":107546,"_5":13195,"_26170":107187,"_2648":107547},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3150":64347,"_27660":64205,"_19192":107549,"_5":13195,"_26170":107187,"_2648":107550},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3150":64348,"_27660":64205,"_19192":107552,"_5":13195,"_26170":107187,"_2648":107553},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3150":64349,"_27660":64205,"_19192":107555,"_5":13195,"_26170":107191,"_2648":107556},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3150":64350,"_27660":64205,"_19192":107558,"_5":13195,"_26170":107191,"_2648":107559},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3150":64351,"_27660":64205,"_19192":107561,"_5":13195,"_26170":107191,"_2648":107562},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3150":64352,"_27660":64205,"_19192":107564,"_5":13195,"_26170":107195,"_2648":107565},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3150":64353,"_27660":64205,"_19192":107567,"_5":13195,"_26170":107195,"_2648":107568},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3150":64354,"_27660":64205,"_19192":107570,"_5":13195,"_26170":107195,"_2648":107571},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3150":64355,"_27660":64205,"_19192":107573,"_5":13195,"_26170":107195,"_2648":107574},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3150":64356,"_27660":64205,"_19192":107576,"_5":13195,"_26170":107195,"_2648":107577},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3150":64357,"_27660":64205,"_19192":107579,"_5":13195,"_26170":107195,"_2648":107580},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3150":64358,"_27660":64205,"_19192":107582,"_5":13195,"_26170":107195,"_2648":107583},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3150":64359,"_27660":64205,"_19192":107585,"_5":13195,"_26170":107195,"_2648":107586},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3150":64360,"_27660":64205,"_19192":107588,"_5":13195,"_26170":107203,"_2648":107589},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3150":64361,"_27660":64205,"_19192":107591,"_5":13195,"_26170":107207,"_2648":107592},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3150":64362,"_27660":64205,"_19192":107594,"_5":13195,"_26170":107207,"_2648":107595},[],"que exista un principal activo del tipo correcto;",{"_3150":64363,"_27660":64205,"_19192":107597,"_5":13195,"_26170":107207,"_2648":107598},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3150":64364,"_27660":64205,"_19192":107600,"_5":13195,"_26170":107207,"_2648":107601},[],"que todas las condiciones del principal se cumplan;",{"_3150":64365,"_27660":64205,"_19192":107603,"_5":13195,"_26170":107207,"_2648":107604},[],"que el principal tenga concedida la política esperada;",{"_3150":64366,"_27660":64205,"_19192":107606,"_5":13195,"_26170":107207,"_2648":107607},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3150":64367,"_27660":64205,"_19192":107609,"_5":13195,"_26170":107207,"_2648":107610},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3150":64368,"_27660":64205,"_19192":107612,"_5":13195,"_26170":107207,"_2648":107613},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3150":64369,"_27660":64205,"_19192":107615,"_5":13195,"_26170":107211,"_2648":107616},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3150":64370,"_27660":64205,"_19192":107618,"_5":13195,"_26170":107215,"_2648":107619},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3150":64371,"_27660":64205,"_19192":107621,"_5":13195,"_26170":107219,"_2648":107622},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3150":64372,"_27660":64205,"_19192":107624,"_5":13195,"_26170":107219,"_2648":107625},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3150":64373,"_27660":64373,"_5":13521,"_2648":107627,"_28003":107628,"_19192":107629,"_26170":64373},"Alertas y suscripciones",[44970,107092,107093],[],{"_3150":64374,"_27660":64373,"_19192":107631,"_5":13195,"_26170":64373,"_2648":107632},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3150":64375,"_27660":64373,"_5":28000,"_19192":107634,"_26170":107635,"_2648":107636},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3150":64376,"_27660":64373,"_5":28000,"_19192":107638,"_26170":107639,"_2648":107640},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3150":64377,"_27660":64373,"_5":28000,"_19192":107642,"_26170":107643,"_2648":107644},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3150":64378,"_27660":64373,"_5":28000,"_19192":107646,"_26170":107647,"_2648":107648},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3150":64379,"_27660":64373,"_5":28000,"_19192":107650,"_26170":107651,"_2648":107652},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3150":64380,"_27660":64373,"_5":28000,"_19192":107654,"_26170":107655,"_2648":107656},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3150":64381,"_27660":64373,"_5":28000,"_19192":107658,"_26170":107659,"_2648":107660},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3150":64382,"_27660":64373,"_5":28000,"_19192":107662,"_26170":107663,"_2648":107664},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3150":64383,"_27660":64373,"_5":28000,"_19192":107666,"_26170":107667,"_2648":107668},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3150":64384,"_27660":64373,"_5":28000,"_19192":107670,"_26170":107671,"_2648":107672},[],"/docs/pr-preview/pr-26/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3150":64385,"_27660":64373,"_19192":107674,"_5":13195,"_26170":64373,"_2648":107675},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3150":64386,"_27660":64373,"_19192":107677,"_5":13195,"_26170":107635,"_2648":107678},[],"Un servicio publica un evento de dominio.",{"_3150":64387,"_27660":64373,"_19192":107680,"_5":13195,"_26170":107635,"_2648":107681},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3150":64388,"_27660":64373,"_19192":107683,"_5":13195,"_26170":107635,"_2648":107684},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3150":64389,"_27660":64373,"_19192":107686,"_5":13195,"_26170":107635,"_2648":107687},[],"Lamassu entrega el evento al canal configurado.",{"_3150":64390,"_27660":64373,"_19192":107689,"_5":13195,"_26170":107635,"_2648":107690},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3150":64391,"_27660":64373,"_19192":107692,"_5":13195,"_26170":107639,"_2648":107693},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3150":64392,"_27660":64373,"_19192":107695,"_5":13195,"_26170":107639,"_2648":107696},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3150":64393,"_27660":64373,"_19192":107698,"_5":13195,"_26170":107639,"_2648":107699},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3150":64394,"_27660":64373,"_19192":107701,"_5":13195,"_26170":107639,"_2648":107702},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3150":64395,"_27660":64373,"_19192":107704,"_5":13195,"_26170":107639,"_2648":107705},[],"`apikey_options` necesita `header` y `key`.",{"_3150":64396,"_27660":64373,"_19192":107707,"_5":13195,"_26170":107639,"_2648":107708},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3150":64397,"_27660":64373,"_19192":107710,"_5":13195,"_26170":107639,"_2648":107711},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3150":64398,"_27660":64373,"_19192":107713,"_5":13195,"_26170":107639,"_2648":107714},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3150":64399,"_27660":64373,"_19192":107716,"_5":13195,"_26170":107647,"_2648":107717},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3150":64400,"_27660":64373,"_19192":107719,"_5":13195,"_26170":107651,"_2648":107720},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3150":64401,"_27660":64373,"_19192":107722,"_5":13195,"_26170":107655,"_2648":107723},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3150":64402,"_27660":64373,"_19192":107725,"_5":13195,"_26170":107655,"_2648":107726},[],"**None** notifica todas las instancias del evento.",{"_3150":64403,"_27660":64373,"_19192":107728,"_5":13195,"_26170":107655,"_2648":107729},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3150":64404,"_27660":64373,"_19192":107731,"_5":13195,"_26170":107655,"_2648":107732},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3150":64405,"_27660":64373,"_19192":107734,"_5":13195,"_26170":107655,"_2648":107735},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3150":64406,"_27660":64373,"_19192":107737,"_5":13195,"_26170":107655,"_2648":107738},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3150":64407,"_27660":64373,"_19192":107740,"_5":13195,"_26170":107659,"_2648":107741},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3150":64408,"_27660":64373,"_19192":107743,"_5":13195,"_26170":107663,"_2648":107744},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3150":64409,"_27660":64373,"_19192":107746,"_5":13195,"_26170":107663,"_2648":107747},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3150":64410,"_27660":64373,"_19192":107749,"_5":13195,"_26170":107663,"_2648":107750},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3150":64411,"_27660":64373,"_19192":107752,"_5":13195,"_26170":107663,"_2648":107753},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3150":64412,"_27660":64373,"_19192":107755,"_5":13195,"_26170":107663,"_2648":107756},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3150":64413,"_27660":64373,"_19192":107758,"_5":13195,"_26170":107663,"_2648":107759},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3150":64414,"_27660":64373,"_19192":107761,"_5":13195,"_26170":107663,"_2648":107762},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3150":64415,"_27660":64373,"_19192":107764,"_5":13195,"_26170":107663,"_2648":107765},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3150":64416,"_27660":64373,"_19192":107767,"_5":13195,"_26170":107667,"_2648":107768},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3150":64417,"_27660":64373,"_19192":107770,"_5":13195,"_26170":107671,"_2648":107771},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3150":64418,"_27660":64373,"_19192":107773,"_5":13195,"_26170":107671,"_2648":107774},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3150":64419,"_27660":64373,"_19192":107776,"_5":13195,"_26170":107671,"_2648":107777},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3150":64420,"_27660":64373,"_19192":107779,"_5":13195,"_26170":107671,"_2648":107780},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3150":64421,"_27660":64373,"_19192":107782,"_5":13195,"_26170":107671,"_2648":107783},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3150":64422,"_27660":64373,"_19192":107785,"_5":13195,"_26170":107671,"_2648":107786},[],"**Validación:** `va.role.crl.create`.",{"_3150":64423,"_27660":64373,"_19192":107788,"_5":13195,"_26170":107671,"_2648":107789},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3150":64424,"_27660":64373,"_19192":107791,"_5":13195,"_26170":107671,"_2648":107792},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3150":64425,"_27660":64425,"_5":13521,"_2648":107794,"_28003":107795,"_19192":107796,"_26170":64425},"Registros de auditoría",[44970,107092,107093],[],{"_3150":64426,"_27660":64425,"_19192":107798,"_5":13195,"_26170":64425,"_2648":107799},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3150":64427,"_27660":64425,"_5":28000,"_19192":107801,"_26170":107802,"_2648":107803},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3150":64428,"_27660":64425,"_5":28000,"_19192":107805,"_26170":107806,"_2648":107807},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3150":64429,"_27660":64425,"_5":28000,"_19192":107809,"_26170":107810,"_2648":107811},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3150":64430,"_27660":64425,"_5":28000,"_19192":107813,"_26170":107814,"_2648":107815},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3150":64431,"_27660":64425,"_5":28000,"_19192":107817,"_26170":107818,"_2648":107819},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3150":64432,"_27660":64425,"_5":28000,"_19192":107821,"_26170":107822,"_2648":107823},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3150":64433,"_27660":64425,"_5":28000,"_19192":107825,"_26170":107826,"_2648":107827},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3150":64434,"_27660":64425,"_5":28000,"_19192":107829,"_26170":107830,"_2648":107831},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3150":64435,"_27660":64425,"_5":28000,"_19192":107833,"_26170":107834,"_2648":107835},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3150":64436,"_27660":64425,"_5":28000,"_19192":107837,"_26170":107838,"_2648":107839},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3150":64437,"_27660":64425,"_5":28000,"_19192":107841,"_26170":107842,"_2648":107843},[],"/docs/pr-preview/pr-26/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3150":64438,"_27660":64425,"_19192":107845,"_5":13195,"_26170":64425,"_2648":107846},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3150":64439,"_27660":64425,"_19192":107848,"_5":13195,"_26170":107802,"_2648":107849},[],"El cuerpo de auditoría incluye:",{"_3150":64440,"_27660":64425,"_19192":107851,"_5":13195,"_26170":107802,"_2648":107852},[],"input: datos recibidos por la operación;",{"_3150":64441,"_27660":64425,"_19192":107854,"_5":13195,"_26170":107802,"_2648":107855},[],"has\\_error: indica si el servicio devolvió un error;",{"_3150":64442,"_27660":64425,"_19192":107857,"_5":13195,"_26170":107802,"_2648":107858},[],"output: resultado producido o mensaje de error;",{"_3150":64443,"_27660":64425,"_19192":107860,"_5":13195,"_26170":107802,"_2648":107861},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3150":64444,"_27660":64425,"_19192":107863,"_5":13195,"_26170":107802,"_2648":107864},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3150":64445,"_27660":64425,"_19192":107866,"_5":13195,"_26170":107802,"_2648":107867},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3150":64446,"_27660":64425,"_19192":107869,"_5":13195,"_26170":107806,"_2648":107870},[],"El backend aplica auditoría a mutaciones de:",{"_3150":64447,"_27660":64425,"_19192":107872,"_5":13195,"_26170":107806,"_2648":107873},[],"autoridades, certificados y perfiles de emisión;",{"_3150":64448,"_27660":64425,"_19192":107875,"_5":13195,"_26170":107806,"_2648":107876},[],"claves y motores KMS;",{"_3150":64449,"_27660":64425,"_19192":107878,"_5":13195,"_26170":107806,"_2648":107879},[],"dispositivos e identidades;",{"_3150":64450,"_27660":64425,"_19192":107881,"_5":13195,"_26170":107806,"_2648":107882},[],"DMS y operaciones de enrolamiento;",{"_3150":64451,"_27660":64425,"_19192":107884,"_5":13195,"_26170":107806,"_2648":107885},[],"funciones de validación y CRL;",{"_3150":64452,"_27660":64425,"_19192":107887,"_5":13195,"_26170":107806,"_2648":107888},[],"principales, políticas y concesiones de autorización.",{"_3150":64453,"_27660":64425,"_19192":107890,"_5":13195,"_26170":107806,"_2648":107891},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3150":64454,"_27660":64425,"_19192":107893,"_5":13195,"_26170":107810,"_2648":107894},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3150":64455,"_27660":64425,"_19192":107896,"_5":13195,"_26170":107810,"_2648":107897},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3150":64456,"_27660":64425,"_19192":107899,"_5":13195,"_26170":107810,"_2648":107900},[],"Diseña el consumidor para:",{"_3150":64457,"_27660":64425,"_19192":107902,"_5":13195,"_26170":107810,"_2648":107903},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3150":64458,"_27660":64425,"_19192":107905,"_5":13195,"_26170":107810,"_2648":107906},[],"conservar el CloudEvent completo sin modificar;",{"_3150":64459,"_27660":64425,"_19192":107908,"_5":13195,"_26170":107810,"_2648":107909},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3150":64460,"_27660":64425,"_19192":107911,"_5":13195,"_26170":107810,"_2648":107912},[],"cifrar en tránsito y en reposo;",{"_3150":64461,"_27660":64425,"_19192":107914,"_5":13195,"_26170":107810,"_2648":107915},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3150":64462,"_27660":64425,"_19192":107917,"_5":13195,"_26170":107810,"_2648":107918},[],"aplicar una política explícita de retención y legal hold;",{"_3150":64463,"_27660":64425,"_19192":107920,"_5":13195,"_26170":107810,"_2648":107921},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3150":64464,"_27660":64425,"_19192":107923,"_5":13195,"_26170":107814,"_2648":107924},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3150":64465,"_27660":64425,"_19192":107926,"_5":13195,"_26170":107814,"_2648":107927},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3150":64466,"_27660":64425,"_19192":107929,"_5":13195,"_26170":107822,"_2648":107930},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3150":64467,"_27660":64425,"_19192":107932,"_5":13195,"_26170":107826,"_2648":107933},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3150":64468,"_27660":64425,"_19192":107935,"_5":13195,"_26170":107830,"_2648":107936},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3150":64469,"_27660":64425,"_19192":107938,"_5":13195,"_26170":107834,"_2648":107939},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3150":64470,"_27660":64425,"_19192":107941,"_5":13195,"_26170":107838,"_2648":107942},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3150":64471,"_27660":64425,"_19192":107944,"_5":13195,"_26170":107842,"_2648":107945},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3150":64472,"_27660":64425,"_19192":107947,"_5":13195,"_26170":107842,"_2648":107948},[],"aparece un evento de auditoría correcto;",{"_3150":64473,"_27660":64425,"_19192":107950,"_5":13195,"_26170":107842,"_2648":107951},[],"el principal coincide con la identidad utilizada;",{"_3150":64474,"_27660":64425,"_19192":107953,"_5":13195,"_26170":107842,"_2648":107954},[],"el consumidor lo persiste una sola vez;",{"_3150":64475,"_27660":64425,"_19192":107956,"_5":13195,"_26170":107842,"_2648":107957},[],"puede recuperarse por recurso, actor y periodo;",{"_3150":64476,"_27660":64425,"_19192":107959,"_5":13195,"_26170":107842,"_2648":107960},[],"una interrupción del consumidor produce una alerta.",{"_3150":64477,"_27660":64425,"_19192":107962,"_5":13195,"_26170":107842,"_2648":107963},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3150":64478,"_27660":64478,"_5":13521,"_2648":107965,"_28003":107966,"_19192":107967,"_26170":64478},"Arquitectura de la plataforma",[44970,107092],[],{"_3150":64479,"_27660":64478,"_19192":107969,"_5":13195,"_26170":64478,"_2648":107970},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3150":64480,"_27660":64478,"_5":28000,"_19192":107972,"_26170":107973,"_2648":107974},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3150":64481,"_27660":64478,"_5":28000,"_19192":107976,"_26170":107977,"_2648":107978},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3150":64482,"_27660":64478,"_5":28000,"_19192":107980,"_26170":107981,"_2648":107982},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3150":64483,"_27660":64478,"_5":28000,"_19192":107984,"_26170":107985,"_2648":107986},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3150":64484,"_27660":64478,"_5":28000,"_19192":107988,"_26170":107989,"_2648":107990},[],"/docs/pr-preview/pr-26/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3150":64485,"_27660":64478,"_19192":107992,"_5":13195,"_26170":64478,"_2648":107993},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3150":64486,"_27660":64478,"_19192":107995,"_5":13195,"_26170":64478,"_2648":107996},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3150":64487,"_27660":64478,"_19192":107998,"_5":13195,"_26170":107973,"_2648":107999},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3150":64488,"_27660":64478,"_19192":108001,"_5":13195,"_26170":107977,"_2648":108002},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3150":64489,"_27660":64478,"_19192":108004,"_5":13195,"_26170":107981,"_2648":108005},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3150":64490,"_27660":64478,"_19192":108007,"_5":13195,"_26170":107985,"_2648":108008},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3150":64491,"_27660":64478,"_19192":108010,"_5":13195,"_26170":107989,"_2648":108011},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3150":64492,"_27660":64492,"_5":13521,"_2648":108013,"_28003":108014,"_19192":108015,"_26170":64492},"Cómo funciona Lamassu",[44970,107092],[],{"_3150":64493,"_27660":64492,"_19192":108017,"_5":13195,"_26170":64492,"_2648":108018},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3150":64494,"_27660":64492,"_5":28000,"_19192":108020,"_26170":108021,"_2648":108022},[],"/docs/pr-preview/pr-26/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3150":64495,"_27660":64492,"_5":28000,"_19192":108024,"_26170":108025,"_2648":108026},[],"/docs/pr-preview/pr-26/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3150":64496,"_27660":64492,"_19192":108028,"_5":13195,"_26170":64492,"_2648":108029},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3150":64497,"_27660":64492,"_19192":108031,"_5":13195,"_26170":108021,"_2648":108032},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3150":64498,"_27660":64492,"_19192":108034,"_5":13195,"_26170":108021,"_2648":108035},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3150":64499,"_27660":64492,"_19192":108037,"_5":13195,"_26170":108021,"_2648":108038},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3150":64500,"_27660":64492,"_19192":108040,"_5":13195,"_26170":108021,"_2648":108041},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3150":64501,"_27660":64492,"_19192":108043,"_5":13195,"_26170":108021,"_2648":108044},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3150":64502,"_27660":64492,"_19192":108046,"_5":13195,"_26170":108025,"_2648":108047},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3150":64503,"_27660":64492,"_19192":108049,"_5":13195,"_26170":108025,"_2648":108050},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3150":64504,"_27660":64492,"_19192":108052,"_5":13195,"_26170":108025,"_2648":108053},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3150":64505,"_27660":64492,"_19192":108055,"_5":13195,"_26170":108025,"_2648":108056},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3150":64506,"_27660":64492,"_19192":108058,"_5":13195,"_26170":108025,"_2648":108059},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3150":64507,"_27660":64492,"_19192":108061,"_5":13195,"_26170":108025,"_2648":108062},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3150":64508,"_27660":64492,"_19192":108064,"_5":13195,"_26170":108025,"_2648":108065},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3150":64509,"_27660":64509,"_5":13521,"_2648":108067,"_28003":108068,"_19192":108069,"_26170":64509},"Dispositivos e identidades",[44970,107092,47327,108067],[],{"_3150":64510,"_27660":64509,"_19192":108071,"_5":13195,"_26170":64509,"_2648":108072},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3150":64511,"_27660":64509,"_5":28000,"_19192":108074,"_26170":108075,"_2648":108076},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3150":64512,"_27660":64509,"_5":28000,"_19192":108078,"_26170":108079,"_2648":108080},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3150":64513,"_27660":64509,"_5":28000,"_19192":108082,"_26170":108083,"_2648":108084},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3150":64514,"_27660":64509,"_5":28000,"_19192":108086,"_26170":108087,"_2648":108088},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3150":64515,"_27660":64509,"_5":28000,"_19192":108090,"_26170":108091,"_2648":108092},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3150":64516,"_27660":64509,"_5":28000,"_19192":108094,"_26170":108095,"_2648":108096},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3150":64517,"_27660":64509,"_5":28000,"_19192":108098,"_26170":108099,"_2648":108100},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3150":64518,"_27660":64509,"_5":28000,"_19192":108102,"_26170":108103,"_2648":108104},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3150":64519,"_27660":64509,"_5":28000,"_19192":108106,"_26170":108107,"_2648":108108},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3150":64520,"_27660":64509,"_5":28000,"_19192":108110,"_26170":108111,"_2648":108112},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3150":64521,"_27660":64509,"_5":28000,"_19192":108114,"_26170":108115,"_2648":108116},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3150":64522,"_27660":64509,"_19192":108118,"_5":13195,"_26170":64509,"_2648":108119},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3150":64523,"_27660":64509,"_19192":108121,"_5":13195,"_26170":64509,"_2648":108122},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3150":64524,"_27660":64509,"_19192":108124,"_5":13195,"_26170":108075,"_2648":108125},[],"Vista operativa",{"_3150":64525,"_27660":64509,"_19192":108127,"_5":13195,"_26170":108075,"_2648":108128},[],"Interpretación",{"_3150":64526,"_27660":64509,"_19192":108130,"_5":13195,"_26170":108075,"_2648":47390},[],{"_3150":64527,"_27660":64509,"_19192":108132,"_5":13195,"_26170":108075,"_2648":108133},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3150":64528,"_27660":64509,"_19192":108135,"_5":13195,"_26170":108075,"_2648":47396},[],{"_3150":64529,"_27660":64509,"_19192":108137,"_5":13195,"_26170":108075,"_2648":108138},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3150":64530,"_27660":64509,"_19192":108140,"_5":13195,"_26170":108075,"_2648":47402},[],{"_3150":64531,"_27660":64509,"_19192":108142,"_5":13195,"_26170":108075,"_2648":108143},[],"La identidad está en la ventana operativa de renovación.",{"_3150":64532,"_27660":64509,"_19192":108145,"_5":13195,"_26170":108075,"_2648":47408},[],{"_3150":64533,"_27660":64509,"_19192":108147,"_5":13195,"_26170":108075,"_2648":108148},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3150":64534,"_27660":64509,"_19192":108150,"_5":13195,"_26170":108075,"_2648":47414},[],{"_3150":64535,"_27660":64509,"_19192":108152,"_5":13195,"_26170":108075,"_2648":108153},[],"La identidad ha vencido.",{"_3150":64536,"_27660":64509,"_19192":108155,"_5":13195,"_26170":108075,"_2648":47420},[],{"_3150":64537,"_27660":64509,"_19192":108157,"_5":13195,"_26170":108075,"_2648":108158},[],"La identidad está marcada como revocada.",{"_3150":64538,"_27660":64509,"_19192":108160,"_5":13195,"_26170":108075,"_2648":47426},[],{"_3150":64539,"_27660":64509,"_19192":108162,"_5":13195,"_26170":108075,"_2648":108163},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3150":64540,"_27660":64509,"_19192":108165,"_5":13195,"_26170":108075,"_2648":108166},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3150":64541,"_27660":64509,"_19192":108168,"_5":13195,"_26170":108079,"_2648":108169},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3150":64542,"_27660":64509,"_19192":108171,"_5":13195,"_26170":108079,"_2648":108172},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3150":64543,"_27660":64509,"_19192":108174,"_5":13195,"_26170":108079,"_2648":108175},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3150":64544,"_27660":64509,"_19192":108177,"_5":13195,"_26170":108079,"_2648":108178},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3150":64545,"_27660":64509,"_19192":108180,"_5":13195,"_26170":108083,"_2648":108181},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3150":64546,"_27660":64509,"_19192":108183,"_5":13195,"_26170":108087,"_2648":108184},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3150":64547,"_27660":64509,"_19192":108186,"_5":13195,"_26170":108091,"_2648":108187},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3150":64548,"_27660":64509,"_19192":108189,"_5":13195,"_26170":108095,"_2648":108190},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3150":64549,"_27660":64509,"_19192":108192,"_5":13195,"_26170":108099,"_2648":108193},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3150":64550,"_27660":64509,"_19192":108195,"_5":13195,"_26170":108099,"_2648":108196},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3150":64551,"_27660":64509,"_19192":108198,"_5":13195,"_26170":108103,"_2648":108199},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3150":64552,"_27660":64509,"_19192":108201,"_5":13195,"_26170":108103,"_2648":108202},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3150":64553,"_27660":64509,"_19192":108204,"_5":13195,"_26170":108103,"_2648":108205},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3150":64554,"_27660":64509,"_19192":108207,"_5":13195,"_26170":108103,"_2648":108208},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3150":64555,"_27660":64509,"_19192":108210,"_5":13195,"_26170":108103,"_2648":108211},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3150":64556,"_27660":64509,"_19192":108213,"_5":13195,"_26170":108103,"_2648":108214},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3150":64557,"_27660":64509,"_19192":108216,"_5":13195,"_26170":108107,"_2648":108217},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3150":64558,"_27660":64509,"_19192":108219,"_5":13195,"_26170":108107,"_2648":108220},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3150":64559,"_27660":64509,"_19192":108222,"_5":13195,"_26170":108111,"_2648":108223},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3150":64560,"_27660":64509,"_19192":108225,"_5":13195,"_26170":108111,"_2648":108226},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3150":64561,"_27660":64509,"_19192":108228,"_5":13195,"_26170":108111,"_2648":108229},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3150":64562,"_27660":64509,"_19192":108231,"_5":13195,"_26170":108111,"_2648":108232},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3150":64563,"_27660":64509,"_19192":108234,"_5":13195,"_26170":108115,"_2648":108235},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":64564,"_27660":64509,"_19192":108237,"_5":13195,"_26170":108115,"_2648":108238},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":64565,"_27660":64565,"_5":13521,"_2648":108240,"_28003":108241,"_19192":108243,"_26170":64565},"Identidad inicial y autenticación",[44970,107092,47327,108067,108242],"Enrolamiento con PKI",[],{"_3150":64566,"_27660":64565,"_19192":108245,"_5":13195,"_26170":64565,"_2648":108246},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3150":64567,"_27660":64565,"_5":28000,"_19192":108248,"_26170":108249,"_2648":108250},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3150":64568,"_27660":64565,"_5":28000,"_19192":108252,"_26170":108253,"_2648":108254},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3150":64569,"_27660":64565,"_5":28000,"_19192":108256,"_26170":108257,"_2648":108258},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3150":64570,"_27660":64565,"_5":28000,"_19192":108260,"_26170":108261,"_2648":108262},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3150":64571,"_27660":64565,"_5":28000,"_19192":108264,"_26170":108265,"_2648":108266},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3150":64572,"_27660":64565,"_19192":108268,"_5":13195,"_26170":64565,"_2648":108269},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3150":64573,"_27660":64565,"_19192":108271,"_5":13195,"_26170":108249,"_2648":108272},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3150":64574,"_27660":64565,"_19192":108274,"_5":13195,"_26170":108249,"_2648":108275},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3150":64575,"_27660":64565,"_19192":108277,"_5":13195,"_26170":108253,"_2648":108278},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3150":64576,"_27660":64565,"_19192":108280,"_5":13195,"_26170":108253,"_2648":108281},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3150":64577,"_27660":64565,"_19192":108283,"_5":13195,"_26170":108253,"_2648":108284},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3150":64578,"_27660":64565,"_19192":108286,"_5":13195,"_26170":108257,"_2648":108287},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3150":64579,"_27660":64565,"_19192":108289,"_5":13195,"_26170":108257,"_2648":108290},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3150":64580,"_27660":64565,"_19192":108292,"_5":13195,"_26170":108261,"_2648":108293},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3150":64581,"_27660":64565,"_19192":108295,"_5":13195,"_26170":108261,"_2648":108296},[],"Ejemplo de cuerpo:",{"_3150":64582,"_27660":64565,"_19192":108298,"_5":13195,"_26170":108261,"_2648":108299},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3150":64583,"_27660":64565,"_19192":108301,"_5":13195,"_26170":108261,"_2648":108302},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3150":64584,"_27660":64565,"_19192":108304,"_5":13195,"_26170":108261,"_2648":108305},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3150":64585,"_27660":64565,"_19192":108307,"_5":13195,"_26170":108261,"_2648":108308},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3150":64586,"_27660":64565,"_19192":108310,"_5":13195,"_26170":108265,"_2648":108311},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3150":64587,"_27660":64565,"_19192":108313,"_5":13195,"_26170":108265,"_2648":108314},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3150":64588,"_27660":64588,"_5":13521,"_2648":108316,"_28003":108317,"_19192":108318,"_26170":64588},"Configura y opera el DMS",[44970,107092,47327,108067,108242],[],{"_3150":64589,"_27660":64588,"_19192":108320,"_5":13195,"_26170":64588,"_2648":108321},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3150":64590,"_27660":64588,"_5":28000,"_19192":108323,"_26170":108324,"_2648":105758},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3150":64591,"_27660":64588,"_5":28000,"_19192":108326,"_26170":108327,"_2648":108328},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3150":64592,"_27660":64588,"_5":28000,"_19192":108330,"_26170":108331,"_2648":108332},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3150":64593,"_27660":64588,"_5":28000,"_19192":108334,"_26170":108335,"_2648":108336},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3150":64594,"_27660":64588,"_5":28000,"_19192":108338,"_26170":108339,"_2648":108340},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3150":64595,"_27660":64588,"_5":28000,"_19192":108342,"_26170":108343,"_2648":108344},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3150":64596,"_27660":64588,"_5":28000,"_19192":108346,"_26170":108347,"_2648":108348},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3150":64597,"_27660":64588,"_5":28000,"_19192":108350,"_26170":108351,"_2648":108352},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3150":64598,"_27660":64588,"_5":28000,"_19192":108354,"_26170":108355,"_2648":47622},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3150":64599,"_27660":64588,"_5":28000,"_19192":108357,"_26170":108358,"_2648":47626},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3150":64600,"_27660":64588,"_5":28000,"_19192":108360,"_26170":108361,"_2648":108362},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3150":64601,"_27660":64588,"_5":28000,"_19192":108364,"_26170":108365,"_2648":108366},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3150":64602,"_27660":64588,"_5":28000,"_19192":108368,"_26170":108369,"_2648":108370},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3150":64603,"_27660":64588,"_5":28000,"_19192":108372,"_26170":108373,"_2648":108374},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3150":64604,"_27660":64588,"_5":28000,"_19192":108376,"_26170":108377,"_2648":47646},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3150":64605,"_27660":64588,"_5":28000,"_19192":108379,"_26170":108380,"_2648":108381},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3150":64606,"_27660":64588,"_5":28000,"_19192":108383,"_26170":108384,"_2648":108385},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3150":64607,"_27660":64588,"_5":28000,"_19192":108387,"_26170":108388,"_2648":108389},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3150":64608,"_27660":64588,"_19192":108391,"_5":13195,"_26170":64588,"_2648":108392},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3150":64609,"_27660":64588,"_19192":108394,"_5":13195,"_26170":108324,"_2648":108395},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3150":64610,"_27660":64588,"_19192":108397,"_5":13195,"_26170":108324,"_2648":108398},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3150":64611,"_27660":64588,"_19192":108400,"_5":13195,"_26170":108331,"_2648":108401},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3150":64612,"_27660":64588,"_19192":108403,"_5":13195,"_26170":108335,"_2648":108404},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3150":64613,"_27660":64588,"_19192":108406,"_5":13195,"_26170":108339,"_2648":108407},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3150":64614,"_27660":64588,"_19192":108409,"_5":13195,"_26170":108343,"_2648":108410},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3150":64615,"_27660":64588,"_19192":108412,"_5":13195,"_26170":108347,"_2648":108413},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3150":64616,"_27660":64588,"_19192":108415,"_5":13195,"_26170":108355,"_2648":108416},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3150":64617,"_27660":64588,"_19192":108418,"_5":13195,"_26170":108355,"_2648":108419},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3150":64618,"_27660":64588,"_19192":108421,"_5":13195,"_26170":108358,"_2648":108422},[],"Campo de `settings.enrollment_settings`",{"_3150":64619,"_27660":64588,"_19192":108424,"_5":13195,"_26170":108358,"_2648":108425},[],"Decisión",{"_3150":64620,"_27660":64588,"_19192":108427,"_5":13195,"_26170":108358,"_2648":47697},[],{"_3150":64621,"_27660":64588,"_19192":108429,"_5":13195,"_26170":108358,"_2648":108430},[],"`EST_RFC7030` para estas operaciones.",{"_3150":64622,"_27660":64588,"_19192":108432,"_5":13195,"_26170":108358,"_2648":47703},[],{"_3150":64623,"_27660":64588,"_19192":108434,"_5":13195,"_26170":108358,"_2648":108435},[],"ID de la CA que firmará.",{"_3150":64624,"_27660":64588,"_19192":108437,"_5":13195,"_26170":108358,"_2648":47709},[],{"_3150":64625,"_27660":64588,"_19192":108439,"_5":13195,"_26170":108358,"_2648":108440},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3150":64626,"_27660":64588,"_19192":108442,"_5":13195,"_26170":108358,"_2648":47715},[],{"_3150":64627,"_27660":64588,"_19192":108444,"_5":13195,"_26170":108358,"_2648":108445},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3150":64628,"_27660":64588,"_19192":108447,"_5":13195,"_26170":108358,"_2648":47721},[],{"_3150":64629,"_27660":64588,"_19192":108449,"_5":13195,"_26170":108358,"_2648":108450},[],"Uno de los cuatro modos de autenticación.",{"_3150":64630,"_27660":64588,"_19192":108452,"_5":13195,"_26170":108358,"_2648":108453},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3150":64631,"_27660":64588,"_19192":108455,"_5":13195,"_26170":108361,"_2648":108456},[],"Los bloques son independientes:",{"_3150":64632,"_27660":64588,"_19192":108458,"_5":13195,"_26170":108361,"_2648":108459},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3150":64633,"_27660":64588,"_19192":108461,"_5":13195,"_26170":108361,"_2648":108462},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3150":64634,"_27660":64588,"_19192":108464,"_5":13195,"_26170":108361,"_2648":47739},[],{"_3150":64635,"_27660":64588,"_19192":108466,"_5":13195,"_26170":108361,"_2648":108467},[],"Control aplicado en la operación configurada",{"_3150":64636,"_27660":64588,"_19192":108469,"_5":13195,"_26170":108361,"_2648":47745},[],{"_3150":64637,"_27660":64588,"_19192":108471,"_5":13195,"_26170":108361,"_2648":108472},[],"Validación del certificado presentado.",{"_3150":64638,"_27660":64588,"_19192":108474,"_5":13195,"_26170":108361,"_2648":47751},[],{"_3150":64639,"_27660":64588,"_19192":108476,"_5":13195,"_26170":108361,"_2648":108477},[],"Autorización del webhook configurado.",{"_3150":64640,"_27660":64588,"_19192":108479,"_5":13195,"_26170":108361,"_2648":47757},[],{"_3150":64641,"_27660":64588,"_19192":108481,"_5":13195,"_26170":108361,"_2648":108482},[],"Validación del certificado y, después, aprobación del webhook.",{"_3150":64642,"_27660":64588,"_19192":108484,"_5":13195,"_26170":108361,"_2648":47763},[],{"_3150":64643,"_27660":64588,"_19192":108486,"_5":13195,"_26170":108361,"_2648":108487},[],"Sin autenticación del solicitante por el DMS.",{"_3150":64644,"_27660":64588,"_19192":108489,"_5":13195,"_26170":108361,"_2648":108490},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3150":64645,"_27660":64588,"_19192":108492,"_5":13195,"_26170":108361,"_2648":108493},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3150":64646,"_27660":64588,"_19192":108495,"_5":13195,"_26170":108361,"_2648":108496},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3150":64647,"_27660":64588,"_19192":108498,"_5":13195,"_26170":108361,"_2648":108499},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3150":64648,"_27660":64588,"_19192":108501,"_5":13195,"_26170":108365,"_2648":108502},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3150":64649,"_27660":64588,"_19192":108504,"_5":13195,"_26170":108365,"_2648":108505},[],"Campo de `external_webhook_settings`",{"_3150":64650,"_27660":64588,"_19192":108507,"_5":13195,"_26170":108365,"_2648":108425},[],{"_3150":64651,"_27660":64588,"_19192":108509,"_5":13195,"_26170":108365,"_2648":47789},[],{"_3150":64652,"_27660":64588,"_19192":108511,"_5":13195,"_26170":108365,"_2648":108512},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3150":64653,"_27660":64588,"_19192":108514,"_5":13195,"_26170":108365,"_2648":47795},[],{"_3150":64654,"_27660":64588,"_19192":108516,"_5":13195,"_26170":108365,"_2648":108517},[],"`POST` o `PUT`; `POST` por defecto.",{"_3150":64655,"_27660":64588,"_19192":108519,"_5":13195,"_26170":108365,"_2648":47801},[],{"_3150":64656,"_27660":64588,"_19192":108521,"_5":13195,"_26170":108365,"_2648":108522},[],"Etiqueta usada en los logs del servicio.",{"_3150":64657,"_27660":64588,"_19192":108524,"_5":13195,"_26170":108365,"_2648":47807},[],{"_3150":64658,"_27660":64588,"_19192":108526,"_5":13195,"_26170":108365,"_2648":108527},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3150":64659,"_27660":64588,"_19192":108529,"_5":13195,"_26170":108365,"_2648":47813},[],{"_3150":64660,"_27660":64588,"_19192":108531,"_5":13195,"_26170":108365,"_2648":108532},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3150":64661,"_27660":64588,"_19192":108534,"_5":13195,"_26170":108365,"_2648":47819},[],{"_3150":64662,"_27660":64588,"_19192":108536,"_5":13195,"_26170":108365,"_2648":108537},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3150":64663,"_27660":64588,"_19192":108539,"_5":13195,"_26170":108365,"_2648":47825},[],{"_3150":64664,"_27660":64588,"_19192":108541,"_5":13195,"_26170":108365,"_2648":108542},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3150":64665,"_27660":64588,"_19192":108544,"_5":13195,"_26170":108365,"_2648":47831},[],{"_3150":64666,"_27660":64588,"_19192":108546,"_5":13195,"_26170":108365,"_2648":108547},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3150":64667,"_27660":64588,"_19192":108549,"_5":13195,"_26170":108365,"_2648":47837},[],{"_3150":64668,"_27660":64588,"_19192":108551,"_5":13195,"_26170":108365,"_2648":108552},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3150":64669,"_27660":64588,"_19192":108554,"_5":13195,"_26170":108365,"_2648":108555},[],"Reglas de esa configuración:",{"_3150":64670,"_27660":64588,"_19192":108557,"_5":13195,"_26170":108365,"_2648":108558},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3150":64671,"_27660":64588,"_19192":108560,"_5":13195,"_26170":108365,"_2648":108561},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3150":64672,"_27660":64588,"_19192":108563,"_5":13195,"_26170":108365,"_2648":108564},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3150":64673,"_27660":64588,"_19192":108566,"_5":13195,"_26170":108365,"_2648":108567},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3150":64674,"_27660":64588,"_19192":108569,"_5":13195,"_26170":108365,"_2648":108570},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3150":64675,"_27660":64588,"_19192":108572,"_5":13195,"_26170":108365,"_2648":108573},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3150":64676,"_27660":64588,"_19192":108575,"_5":13195,"_26170":108365,"_2648":108576},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3150":64677,"_27660":64588,"_19192":108578,"_5":13195,"_26170":108365,"_2648":108579},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3150":64678,"_27660":64588,"_19192":108581,"_5":13195,"_26170":108365,"_2648":108582},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3150":64679,"_27660":64588,"_19192":108584,"_5":13195,"_26170":108369,"_2648":108585},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3150":64680,"_27660":64588,"_19192":108587,"_5":13195,"_26170":108373,"_2648":108588},[],"Campo de `settings.reenrollment_settings`",{"_3150":64681,"_27660":64588,"_19192":108590,"_5":13195,"_26170":108373,"_2648":108591},[],"Función",{"_3150":64682,"_27660":64588,"_19192":108593,"_5":13195,"_26170":108373,"_2648":47881},[],{"_3150":64683,"_27660":64588,"_19192":108595,"_5":13195,"_26170":108373,"_2648":108596},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3150":64684,"_27660":64588,"_19192":108598,"_5":13195,"_26170":108373,"_2648":47887},[],{"_3150":64685,"_27660":64588,"_19192":108600,"_5":13195,"_26170":108373,"_2648":108601},[],"Umbral operativo preventivo de monitorización.",{"_3150":64686,"_27660":64588,"_19192":108603,"_5":13195,"_26170":108373,"_2648":47893},[],{"_3150":64687,"_27660":64588,"_19192":108605,"_5":13195,"_26170":108373,"_2648":108606},[],"Umbral operativo crítico de monitorización.",{"_3150":64688,"_27660":64588,"_19192":108608,"_5":13195,"_26170":108373,"_2648":47899},[],{"_3150":64689,"_27660":64588,"_19192":108610,"_5":13195,"_26170":108373,"_2648":108611},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3150":64690,"_27660":64588,"_19192":108613,"_5":13195,"_26170":108373,"_2648":47905},[],{"_3150":64691,"_27660":64588,"_19192":108615,"_5":13195,"_26170":108373,"_2648":108616},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3150":64692,"_27660":64588,"_19192":108618,"_5":13195,"_26170":108373,"_2648":47911},[],{"_3150":64693,"_27660":64588,"_19192":108620,"_5":13195,"_26170":108373,"_2648":108621},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3150":64694,"_27660":64588,"_19192":108623,"_5":13195,"_26170":108373,"_2648":108624},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3150":64695,"_27660":64588,"_19192":108626,"_5":13195,"_26170":108377,"_2648":108627},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3150":64696,"_27660":64588,"_19192":108629,"_5":13195,"_26170":108380,"_2648":106122},[],{"_3150":64697,"_27660":64588,"_19192":108631,"_5":13195,"_26170":108380,"_2648":108632},[],"Qué publica",{"_3150":64698,"_27660":64588,"_19192":108634,"_5":13195,"_26170":108380,"_2648":47928},[],{"_3150":64699,"_27660":64588,"_19192":108636,"_5":13195,"_26170":108380,"_2648":108637},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3150":64700,"_27660":64588,"_19192":108639,"_5":13195,"_26170":108380,"_2648":47934},[],{"_3150":64701,"_27660":64588,"_19192":108641,"_5":13195,"_26170":108380,"_2648":108642},[],"Certificado de la CA emisora seleccionada.",{"_3150":64702,"_27660":64588,"_19192":108644,"_5":13195,"_26170":108380,"_2648":47940},[],{"_3150":64703,"_27660":64588,"_19192":108646,"_5":13195,"_26170":108380,"_2648":108647},[],"Certificados de las CAs elegidas explícitamente.",{"_3150":64704,"_27660":64588,"_19192":108649,"_5":13195,"_26170":108380,"_2648":108650},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3150":64705,"_27660":64588,"_19192":108652,"_5":13195,"_26170":108384,"_2648":108653},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3150":64706,"_27660":64588,"_19192":108655,"_5":13195,"_26170":108384,"_2648":108656},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3150":64707,"_27660":64588,"_19192":108658,"_5":13195,"_26170":108384,"_2648":108659},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3150":64708,"_27660":64588,"_19192":108661,"_5":13195,"_26170":108388,"_2648":108662},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3150":64709,"_27660":64709,"_5":13521,"_2648":108664,"_28003":108665,"_19192":108666,"_26170":64709},"Integra el cliente EST",[44970,107092,47327,108067,108242],[],{"_3150":64710,"_27660":64709,"_19192":108668,"_5":13195,"_26170":64709,"_2648":108669},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3150":64711,"_27660":64709,"_5":28000,"_19192":108671,"_26170":108672,"_2648":105758},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3150":64712,"_27660":64709,"_5":28000,"_19192":108674,"_26170":108675,"_2648":108676},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3150":64713,"_27660":64709,"_5":28000,"_19192":108678,"_26170":108679,"_2648":108680},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3150":64714,"_27660":64709,"_5":28000,"_19192":108682,"_26170":108683,"_2648":108684},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3150":64715,"_27660":64709,"_5":28000,"_19192":108686,"_26170":108687,"_2648":108688},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3150":64716,"_27660":64709,"_5":28000,"_19192":108690,"_26170":108691,"_2648":108692},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3150":64717,"_27660":64709,"_19192":108694,"_5":13195,"_26170":64709,"_2648":108695},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3150":64718,"_27660":64709,"_19192":108697,"_5":13195,"_26170":108672,"_2648":108698},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3150":64719,"_27660":64709,"_19192":108700,"_5":13195,"_26170":108672,"_2648":108701},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3150":64720,"_27660":64709,"_19192":108703,"_5":13195,"_26170":108672,"_2648":108704},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3150":64721,"_27660":64709,"_19192":108706,"_5":13195,"_26170":108675,"_2648":108707},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3150":64722,"_27660":64709,"_19192":108709,"_5":13195,"_26170":108675,"_2648":108710},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3150":64723,"_27660":64709,"_19192":108712,"_5":13195,"_26170":108679,"_2648":108713},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3150":64724,"_27660":64709,"_19192":108715,"_5":13195,"_26170":108679,"_2648":108716},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3150":64725,"_27660":64709,"_19192":108718,"_5":13195,"_26170":108683,"_2648":108719},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3150":64726,"_27660":64709,"_19192":108721,"_5":13195,"_26170":108683,"_2648":108722},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3150":64727,"_27660":64709,"_19192":108724,"_5":13195,"_26170":108687,"_2648":108725},[],"Para el caso de una raíz que emite directamente:",{"_3150":64728,"_27660":64709,"_19192":108727,"_5":13195,"_26170":108687,"_2648":108728},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3150":64729,"_27660":64709,"_19192":108730,"_5":13195,"_26170":108687,"_2648":108731},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3150":64730,"_27660":64709,"_19192":108733,"_5":13195,"_26170":108691,"_2648":108734},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3150":64731,"_27660":64731,"_5":13521,"_2648":108736,"_28003":108737,"_19192":108738,"_26170":64731},"Referencia EST",[44970,107092,47327,108067,108242],[],{"_3150":64732,"_27660":64731,"_19192":108740,"_5":13195,"_26170":64731,"_2648":108741},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3150":64733,"_27660":64731,"_5":28000,"_19192":108743,"_26170":108744,"_2648":108745},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3150":64734,"_27660":64731,"_5":28000,"_19192":108747,"_26170":108748,"_2648":20858},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3150":64735,"_27660":64731,"_5":28000,"_19192":108750,"_26170":108751,"_2648":23913},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3150":64736,"_27660":64731,"_5":28000,"_19192":108753,"_26170":108754,"_2648":23920},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3150":64737,"_27660":64731,"_5":28000,"_19192":108756,"_26170":108757,"_2648":23266},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3150":64738,"_27660":64731,"_5":28000,"_19192":108759,"_26170":108760,"_2648":108761},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3150":64739,"_27660":64731,"_5":28000,"_19192":108763,"_26170":108764,"_2648":108765},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3150":64740,"_27660":64731,"_5":28000,"_19192":108767,"_26170":108768,"_2648":108769},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3150":64741,"_27660":64731,"_19192":108771,"_5":13195,"_26170":64731,"_2648":108772},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3150":64742,"_27660":64731,"_19192":108774,"_5":13195,"_26170":108744,"_2648":108775},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3150":64743,"_27660":64731,"_19192":108777,"_5":13195,"_26170":108744,"_2648":106883},[],{"_3150":64744,"_27660":64731,"_19192":108779,"_5":13195,"_26170":108744,"_2648":108780},[],"Método",{"_3150":64745,"_27660":64731,"_19192":108782,"_5":13195,"_26170":108744,"_2648":108783},[],"Autenticación y condición",{"_3150":64746,"_27660":64731,"_19192":108785,"_5":13195,"_26170":108744,"_2648":48083},[],{"_3150":64747,"_27660":64731,"_19192":108787,"_5":13195,"_26170":108744,"_2648":48086},[],{"_3150":64748,"_27660":64731,"_19192":108789,"_5":13195,"_26170":108744,"_2648":108790},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3150":64749,"_27660":64731,"_19192":108792,"_5":13195,"_26170":108744,"_2648":48092},[],{"_3150":64750,"_27660":64731,"_19192":108794,"_5":13195,"_26170":108744,"_2648":48095},[],{"_3150":64751,"_27660":64731,"_19192":108796,"_5":13195,"_26170":108744,"_2648":108797},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3150":64752,"_27660":64731,"_19192":108799,"_5":13195,"_26170":108744,"_2648":48101},[],{"_3150":64753,"_27660":64731,"_19192":108801,"_5":13195,"_26170":108744,"_2648":48095},[],{"_3150":64754,"_27660":64731,"_19192":108803,"_5":13195,"_26170":108744,"_2648":108804},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3150":64755,"_27660":64731,"_19192":108806,"_5":13195,"_26170":108744,"_2648":48109},[],{"_3150":64756,"_27660":64731,"_19192":108808,"_5":13195,"_26170":108744,"_2648":48095},[],{"_3150":64757,"_27660":64731,"_19192":108810,"_5":13195,"_26170":108744,"_2648":108811},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3150":64758,"_27660":64731,"_19192":108813,"_5":13195,"_26170":108744,"_2648":108814},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3150":64759,"_27660":64731,"_19192":108816,"_5":13195,"_26170":108748,"_2648":108817},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3150":64760,"_27660":64731,"_19192":108819,"_5":13195,"_26170":108748,"_2648":108820},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3150":64761,"_27660":64731,"_19192":108822,"_5":13195,"_26170":108751,"_2648":108823},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3150":64762,"_27660":64731,"_19192":108825,"_5":13195,"_26170":108751,"_2648":108826},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3150":64763,"_27660":64731,"_19192":108828,"_5":13195,"_26170":108754,"_2648":108829},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3150":64764,"_27660":64731,"_19192":108831,"_5":13195,"_26170":108754,"_2648":108832},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3150":64765,"_27660":64731,"_19192":108834,"_5":13195,"_26170":108757,"_2648":108835},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3150":64766,"_27660":64731,"_19192":108837,"_5":13195,"_26170":108757,"_2648":108838},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3150":64767,"_27660":64731,"_19192":108840,"_5":13195,"_26170":108760,"_2648":108841},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3150":64768,"_27660":64731,"_19192":108843,"_5":13195,"_26170":108760,"_2648":108844},[],"Parte",{"_3150":64769,"_27660":64731,"_19192":108846,"_5":13195,"_26170":108760,"_2648":108847},[],"Contenido tras decodificar su Base64",{"_3150":64770,"_27660":64731,"_19192":108849,"_5":13195,"_26170":108760,"_2648":48153},[],{"_3150":64771,"_27660":64731,"_19192":108851,"_5":13195,"_26170":108760,"_2648":108852},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3150":64772,"_27660":64731,"_19192":108854,"_5":13195,"_26170":108760,"_2648":48159},[],{"_3150":64773,"_27660":64731,"_19192":108856,"_5":13195,"_26170":108760,"_2648":108857},[],"PKCS#7 DER con el certificado emitido.",{"_3150":64774,"_27660":64731,"_19192":108859,"_5":13195,"_26170":108760,"_2648":108860},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3150":64775,"_27660":64731,"_19192":108862,"_5":13195,"_26170":108764,"_2648":108863},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3150":64776,"_27660":64731,"_19192":108865,"_5":13195,"_26170":108764,"_2648":108866},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3150":64777,"_27660":64731,"_19192":108868,"_5":13195,"_26170":108764,"_2648":108869},[],"Convierte y comprueba el resultado:",{"_3150":64778,"_27660":64731,"_19192":108871,"_5":13195,"_26170":108764,"_2648":108872},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3150":64779,"_27660":64731,"_19192":108874,"_5":13195,"_26170":108768,"_2648":108875},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3150":64780,"_27660":64731,"_19192":108877,"_5":13195,"_26170":108768,"_2648":108878},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3150":64781,"_27660":64781,"_5":13521,"_2648":108242,"_28003":108880,"_19192":108881,"_26170":64781},[44970,107092,47327,108067,108242],[],{"_3150":64782,"_27660":64781,"_19192":108883,"_5":13195,"_26170":64781,"_2648":108884},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3150":64783,"_27660":64781,"_5":28000,"_19192":108886,"_26170":108887,"_2648":108888},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3150":64784,"_27660":64781,"_5":28000,"_19192":108890,"_26170":108891,"_2648":108892},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3150":64785,"_27660":64781,"_5":28000,"_19192":108894,"_26170":108895,"_2648":108896},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3150":64786,"_27660":64781,"_5":28000,"_19192":108898,"_26170":108899,"_2648":108900},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3150":64787,"_27660":64781,"_19192":108902,"_5":13195,"_26170":64781,"_2648":108903},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3150":64788,"_27660":64781,"_19192":108905,"_5":13195,"_26170":108887,"_2648":108906},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3150":64789,"_27660":64781,"_19192":108908,"_5":13195,"_26170":108887,"_2648":108909},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3150":64790,"_27660":64781,"_19192":108911,"_5":13195,"_26170":108887,"_2648":108912},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3150":64791,"_27660":64781,"_19192":108914,"_5":13195,"_26170":108887,"_2648":108915},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3150":64792,"_27660":64781,"_19192":108917,"_5":13195,"_26170":108887,"_2648":108918},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3150":64793,"_27660":64781,"_19192":108920,"_5":13195,"_26170":108887,"_2648":108921},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3150":64794,"_27660":64781,"_19192":108923,"_5":13195,"_26170":108891,"_2648":108924},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3150":64795,"_27660":64781,"_19192":108926,"_5":13195,"_26170":108891,"_2648":108927},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":64796,"_27660":64781,"_19192":108929,"_5":13195,"_26170":108891,"_2648":108930},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3150":64797,"_27660":64781,"_19192":108932,"_5":13195,"_26170":108891,"_2648":108933},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3150":64798,"_27660":64781,"_19192":108935,"_5":13195,"_26170":108895,"_2648":108936},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":64799,"_27660":64781,"_19192":108938,"_5":13195,"_26170":108895,"_2648":108939},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":64800,"_27660":64781,"_19192":108941,"_5":13195,"_26170":108895,"_2648":108942},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3150":64801,"_27660":64781,"_19192":108944,"_5":13195,"_26170":108895,"_2648":108945},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3150":64802,"_27660":64781,"_19192":108947,"_5":13195,"_26170":108899,"_2648":108948},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3150":64803,"_27660":64781,"_19192":108950,"_5":13195,"_26170":108899,"_2648":108951},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3150":64804,"_27660":64804,"_5":13521,"_2648":108953,"_28003":108954,"_19192":108955,"_26170":64804},"Estrategias de aprovisionamiento",[44970,107092,47327,108067,108242],[],{"_3150":64805,"_27660":64804,"_19192":108957,"_5":13195,"_26170":64804,"_2648":108958},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3150":64806,"_27660":64804,"_5":28000,"_19192":108960,"_26170":108961,"_2648":108962},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3150":64807,"_27660":64804,"_5":28000,"_19192":108964,"_26170":108965,"_2648":108966},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3150":64808,"_27660":64804,"_5":28000,"_19192":108968,"_26170":108969,"_2648":108970},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3150":64809,"_27660":64804,"_5":28000,"_19192":108972,"_26170":108973,"_2648":108974},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3150":64810,"_27660":64804,"_5":28000,"_19192":108976,"_26170":108977,"_2648":108978},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3150":64811,"_27660":64804,"_19192":108980,"_5":13195,"_26170":64804,"_2648":108981},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3150":64812,"_27660":64804,"_19192":108983,"_5":13195,"_26170":108961,"_2648":108984},[],"Recorrido",{"_3150":64813,"_27660":64804,"_19192":108986,"_5":13195,"_26170":108961,"_2648":108987},[],"Cuándo existe el dispositivo",{"_3150":64814,"_27660":64804,"_19192":108989,"_5":13195,"_26170":108961,"_2648":108990},[],"Qué compruebas",{"_3150":64815,"_27660":64804,"_19192":108992,"_5":13195,"_26170":108961,"_2648":108993},[],"Asignación manual",{"_3150":64816,"_27660":64804,"_19192":108995,"_5":13195,"_26170":108961,"_2648":108996},[],"El operador lo crea antes de asociar un certificado.",{"_3150":64817,"_27660":64804,"_19192":108998,"_5":13195,"_26170":108961,"_2648":108999},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3150":64818,"_27660":64804,"_19192":109001,"_5":13195,"_26170":108961,"_2648":109002},[],"EST con `JITP`",{"_3150":64819,"_27660":64804,"_19192":109004,"_5":13195,"_26170":108961,"_2648":109005},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3150":64820,"_27660":64804,"_19192":109007,"_5":13195,"_26170":108961,"_2648":109008},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3150":64821,"_27660":64804,"_19192":109010,"_5":13195,"_26170":108961,"_2648":109011},[],"EST con `PRE_REGISTRATION`",{"_3150":64822,"_27660":64804,"_19192":109013,"_5":13195,"_26170":108961,"_2648":109014},[],"Debe existir antes de `/simpleenroll`.",{"_3150":64823,"_27660":64804,"_19192":109016,"_5":13195,"_26170":108961,"_2648":109017},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3150":64824,"_27660":64804,"_19192":109019,"_5":13195,"_26170":108961,"_2648":109020},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3150":64825,"_27660":64804,"_19192":109022,"_5":13195,"_26170":108961,"_2648":109023},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3150":64826,"_27660":64804,"_19192":109025,"_5":13195,"_26170":108965,"_2648":109026},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3150":64827,"_27660":64804,"_19192":109028,"_5":13195,"_26170":108965,"_2648":109029},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3150":64828,"_27660":64804,"_19192":109031,"_5":13195,"_26170":108965,"_2648":109032},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3150":64829,"_27660":64804,"_19192":109034,"_5":13195,"_26170":108969,"_2648":109035},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3150":64830,"_27660":64804,"_19192":109037,"_5":13195,"_26170":108969,"_2648":109038},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3150":64831,"_27660":64804,"_19192":109040,"_5":13195,"_26170":108969,"_2648":109041},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3150":64832,"_27660":64804,"_19192":109043,"_5":13195,"_26170":108969,"_2648":109044},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3150":64833,"_27660":64804,"_19192":109046,"_5":13195,"_26170":108969,"_2648":109047},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3150":64834,"_27660":64804,"_19192":109049,"_5":13195,"_26170":108969,"_2648":109050},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3150":64835,"_27660":64804,"_19192":109052,"_5":13195,"_26170":108973,"_2648":106122},[],{"_3150":64836,"_27660":64804,"_19192":109054,"_5":13195,"_26170":108973,"_2648":109055},[],"Material que atraviesa EST",{"_3150":64837,"_27660":64804,"_19192":109057,"_5":13195,"_26170":108973,"_2648":109058},[],"Clave generada por el dispositivo",{"_3150":64838,"_27660":64804,"_19192":109060,"_5":13195,"_26170":108973,"_2648":109061},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3150":64839,"_27660":64804,"_19192":109063,"_5":13195,"_26170":108973,"_2648":109064},[],"Clave ya disponible en el dispositivo",{"_3150":64840,"_27660":64804,"_19192":109066,"_5":13195,"_26170":108973,"_2648":109067},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3150":64841,"_27660":64804,"_19192":109069,"_5":13195,"_26170":108973,"_2648":47646},[],{"_3150":64842,"_27660":64804,"_19192":109071,"_5":13195,"_26170":108973,"_2648":109072},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3150":64843,"_27660":64804,"_19192":109074,"_5":13195,"_26170":108973,"_2648":109075},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3150":64844,"_27660":64804,"_19192":109077,"_5":13195,"_26170":108977,"_2648":109078},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3150":64845,"_27660":64845,"_5":13521,"_2648":109080,"_28003":109081,"_19192":109082,"_26170":64845},"Renovación y recuperación",[44970,107092,47327,108067,108242],[],{"_3150":64846,"_27660":64845,"_19192":109084,"_5":13195,"_26170":64845,"_2648":109085},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3150":64847,"_27660":64845,"_5":28000,"_19192":109087,"_26170":109088,"_2648":109089},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3150":64848,"_27660":64845,"_5":28000,"_19192":109091,"_26170":109092,"_2648":109093},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3150":64849,"_27660":64845,"_5":28000,"_19192":109095,"_26170":109096,"_2648":109097},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3150":64850,"_27660":64845,"_5":28000,"_19192":109099,"_26170":109100,"_2648":109101},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3150":64851,"_27660":64845,"_5":28000,"_19192":109103,"_26170":109104,"_2648":109105},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3150":64852,"_27660":64845,"_19192":109107,"_5":13195,"_26170":64845,"_2648":109108},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3150":64853,"_27660":64845,"_19192":109110,"_5":13195,"_26170":109088,"_2648":109111},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3150":64854,"_27660":64845,"_19192":109113,"_5":13195,"_26170":109088,"_2648":109114},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3150":64855,"_27660":64845,"_19192":109116,"_5":13195,"_26170":109088,"_2648":109117},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3150":64856,"_27660":64845,"_19192":109119,"_5":13195,"_26170":109088,"_2648":109120},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3150":64857,"_27660":64845,"_19192":109122,"_5":13195,"_26170":109092,"_2648":109123},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3150":64858,"_27660":64845,"_19192":109125,"_5":13195,"_26170":109092,"_2648":109126},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3150":64859,"_27660":64845,"_19192":109128,"_5":13195,"_26170":109096,"_2648":109129},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3150":64860,"_27660":64845,"_19192":109131,"_5":13195,"_26170":109096,"_2648":109132},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3150":64861,"_27660":64845,"_19192":109134,"_5":13195,"_26170":109096,"_2648":109135},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3150":64862,"_27660":64845,"_19192":109137,"_5":13195,"_26170":109100,"_2648":109138},[],"Situación",{"_3150":64863,"_27660":64845,"_19192":109140,"_5":13195,"_26170":109100,"_2648":109141},[],"Procedimiento",{"_3150":64864,"_27660":64845,"_19192":109143,"_5":13195,"_26170":109100,"_2648":109144},[],"Certificado vigente, fuera de ventana",{"_3150":64865,"_27660":64845,"_19192":109146,"_5":13195,"_26170":109100,"_2648":109147},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3150":64866,"_27660":64845,"_19192":109149,"_5":13195,"_26170":109100,"_2648":109150},[],"Certificado vencido, clave disponible",{"_3150":64867,"_27660":64845,"_19192":109152,"_5":13195,"_26170":109100,"_2648":109153},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3150":64868,"_27660":64845,"_19192":109155,"_5":13195,"_26170":109100,"_2648":109156},[],"Renovación por webhook o `NO_AUTH`",{"_3150":64869,"_27660":64845,"_19192":109158,"_5":13195,"_26170":109100,"_2648":109159},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3150":64870,"_27660":64845,"_19192":109161,"_5":13195,"_26170":109100,"_2648":109162},[],"Clave perdida o inaccesible",{"_3150":64871,"_27660":64845,"_19192":109164,"_5":13195,"_26170":109100,"_2648":109165},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3150":64872,"_27660":64845,"_19192":109167,"_5":13195,"_26170":109100,"_2648":109168},[],"Identidad actual revocada",{"_3150":64873,"_27660":64845,"_19192":109170,"_5":13195,"_26170":109100,"_2648":109171},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3150":64874,"_27660":64845,"_19192":109173,"_5":13195,"_26170":109100,"_2648":109174},[],"Dispositivo sin identidad",{"_3150":64875,"_27660":64845,"_19192":109176,"_5":13195,"_26170":109100,"_2648":109177},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3150":64876,"_27660":64845,"_19192":109179,"_5":13195,"_26170":109100,"_2648":109180},[],"Dispositivo retirado",{"_3150":64877,"_27660":64845,"_19192":109182,"_5":13195,"_26170":109100,"_2648":109183},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3150":64878,"_27660":64845,"_19192":109185,"_5":13195,"_26170":109100,"_2648":109186},[],"Timeout, HTTP 500 o fallo de instalación",{"_3150":64879,"_27660":64845,"_19192":109188,"_5":13195,"_26170":109100,"_2648":109189},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3150":64880,"_27660":64845,"_19192":109191,"_5":13195,"_26170":109104,"_2648":109192},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3150":64881,"_27660":64845,"_19192":109194,"_5":13195,"_26170":109104,"_2648":109195},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3150":64882,"_27660":64882,"_5":13521,"_2648":109197,"_28003":109198,"_19192":109199,"_26170":64882},"Diagnóstico de enrolamiento",[44970,107092,47327,108067,108242],[],{"_3150":64883,"_27660":64882,"_19192":109201,"_5":13195,"_26170":64882,"_2648":109202},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3150":64884,"_27660":64882,"_5":28000,"_19192":109204,"_26170":109205,"_2648":109206},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3150":64885,"_27660":64882,"_5":28000,"_19192":109208,"_26170":109209,"_2648":109210},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3150":64886,"_27660":64882,"_5":28000,"_19192":109212,"_26170":109213,"_2648":108769},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3150":64887,"_27660":64882,"_5":28000,"_19192":109215,"_26170":109216,"_2648":109217},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3150":64888,"_27660":64882,"_19192":109219,"_5":13195,"_26170":64882,"_2648":109220},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3150":64889,"_27660":64882,"_19192":109222,"_5":13195,"_26170":109209,"_2648":109223},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3150":64890,"_27660":64882,"_19192":109225,"_5":13195,"_26170":109209,"_2648":109226},[],"Síntoma o mensaje",{"_3150":64891,"_27660":64882,"_19192":109228,"_5":13195,"_26170":109209,"_2648":109229},[],"Qué revisar",{"_3150":64892,"_27660":64882,"_19192":109231,"_5":13195,"_26170":109209,"_2648":109232},[],"curl rechaza TLS, nombre o emisor",{"_3150":64893,"_27660":64882,"_19192":109234,"_5":13195,"_26170":109209,"_2648":109235},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3150":64894,"_27660":64882,"_19192":109237,"_5":13195,"_26170":109209,"_2648":109238},[],"404 o APS ausente",{"_3150":64895,"_27660":64882,"_19192":109240,"_5":13195,"_26170":109209,"_2648":109241},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3150":64896,"_27660":64882,"_19192":109243,"_5":13195,"_26170":109209,"_2648":109244},[],"400, error de CSR o formato",{"_3150":64897,"_27660":64882,"_19192":109246,"_5":13195,"_26170":109209,"_2648":109247},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3150":64898,"_27660":64882,"_19192":109249,"_5":13195,"_26170":109209,"_2648":109250},[],"Credencial ausente o certificado no válido",{"_3150":64899,"_27660":64882,"_19192":109252,"_5":13195,"_26170":109209,"_2648":109253},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3150":64900,"_27660":64882,"_19192":109255,"_5":13195,"_26170":109209,"_2648":109256},[],"Webhook deniega, expira o responde sin autorización",{"_3150":64901,"_27660":64882,"_19192":109258,"_5":13195,"_26170":109209,"_2648":109259},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3150":64902,"_27660":64882,"_19192":109261,"_5":13195,"_26170":109209,"_2648":48566},[],{"_3150":64903,"_27660":64882,"_19192":109263,"_5":13195,"_26170":109209,"_2648":109264},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3150":64904,"_27660":64882,"_19192":109266,"_5":13195,"_26170":109209,"_2648":48572},[],{"_3150":64905,"_27660":64882,"_19192":109268,"_5":13195,"_26170":109209,"_2648":109269},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3150":64906,"_27660":64882,"_19192":109271,"_5":13195,"_26170":109209,"_2648":48578},[],{"_3150":64907,"_27660":64882,"_19192":109273,"_5":13195,"_26170":109209,"_2648":109274},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3150":64908,"_27660":64882,"_19192":109276,"_5":13195,"_26170":109209,"_2648":48584},[],{"_3150":64909,"_27660":64882,"_19192":109278,"_5":13195,"_26170":109209,"_2648":109279},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3150":64910,"_27660":64882,"_19192":109281,"_5":13195,"_26170":109209,"_2648":48590},[],{"_3150":64911,"_27660":64882,"_19192":109283,"_5":13195,"_26170":109209,"_2648":109284},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3150":64912,"_27660":64882,"_19192":109286,"_5":13195,"_26170":109209,"_2648":109287},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3150":64913,"_27660":64882,"_19192":109289,"_5":13195,"_26170":109209,"_2648":109290},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3150":64914,"_27660":64882,"_19192":109292,"_5":13195,"_26170":109209,"_2648":109293},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3150":64915,"_27660":64882,"_19192":109295,"_5":13195,"_26170":109209,"_2648":109296},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3150":64916,"_27660":64882,"_19192":109298,"_5":13195,"_26170":109209,"_2648":48608},[],{"_3150":64917,"_27660":64882,"_19192":109300,"_5":13195,"_26170":109209,"_2648":109301},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3150":64918,"_27660":64882,"_19192":109303,"_5":13195,"_26170":109209,"_2648":48614},[],{"_3150":64919,"_27660":64882,"_19192":109305,"_5":13195,"_26170":109209,"_2648":109306},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3150":64920,"_27660":64882,"_19192":109308,"_5":13195,"_26170":109209,"_2648":109309},[],"DMS propietario distinto",{"_3150":64921,"_27660":64882,"_19192":109311,"_5":13195,"_26170":109209,"_2648":109312},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3150":64922,"_27660":64882,"_19192":109314,"_5":13195,"_26170":109209,"_2648":48626},[],{"_3150":64923,"_27660":64882,"_19192":109316,"_5":13195,"_26170":109209,"_2648":109317},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3150":64924,"_27660":64882,"_19192":109319,"_5":13195,"_26170":109209,"_2648":48632},[],{"_3150":64925,"_27660":64882,"_19192":109321,"_5":13195,"_26170":109209,"_2648":109322},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3150":64926,"_27660":64882,"_19192":109324,"_5":13195,"_26170":109209,"_2648":109325},[],"Certificado actual revocado",{"_3150":64927,"_27660":64882,"_19192":109327,"_5":13195,"_26170":109209,"_2648":109328},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3150":64928,"_27660":64882,"_19192":109330,"_5":13195,"_26170":109209,"_2648":109331},[],"Error de CA, perfil o firma",{"_3150":64929,"_27660":64882,"_19192":109333,"_5":13195,"_26170":109209,"_2648":109334},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3150":64930,"_27660":64882,"_19192":109336,"_5":13195,"_26170":109209,"_2648":109337},[],"HTTP 200 sin conexión del dispositivo",{"_3150":64931,"_27660":64882,"_19192":109339,"_5":13195,"_26170":109209,"_2648":109340},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3150":64932,"_27660":64882,"_19192":109342,"_5":13195,"_26170":109209,"_2648":109343},[],"Timeout o error después de emitir",{"_3150":64933,"_27660":64882,"_19192":109345,"_5":13195,"_26170":109209,"_2648":109346},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3150":64934,"_27660":64882,"_19192":109348,"_5":13195,"_26170":109213,"_2648":109349},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3150":64935,"_27660":64882,"_19192":109351,"_5":13195,"_26170":109213,"_2648":109352},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3150":64936,"_27660":64882,"_19192":109354,"_5":13195,"_26170":109216,"_2648":109355},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3150":64937,"_27660":64882,"_19192":109357,"_5":13195,"_26170":109216,"_2648":109358},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3150":64938,"_27660":64882,"_19192":109360,"_5":13195,"_26170":109216,"_2648":109361},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3150":64939,"_27660":64882,"_19192":109363,"_5":13195,"_26170":109216,"_2648":109364},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3150":64940,"_27660":64882,"_19192":109366,"_5":13195,"_26170":109216,"_2648":109367},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3150":64941,"_27660":64882,"_19192":109369,"_5":13195,"_26170":109216,"_2648":109370},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3150":64942,"_27660":64882,"_19192":109372,"_5":13195,"_26170":109216,"_2648":109373},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3150":64943,"_27660":64943,"_5":13521,"_2648":109375,"_28003":109376,"_19192":109377,"_26170":64943},"Distribución y actualización de confianza",[44970,107092,47327,108067,108242],[],{"_3150":64944,"_27660":64943,"_19192":109379,"_5":13195,"_26170":64943,"_2648":109380},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3150":64945,"_27660":64943,"_5":28000,"_19192":109382,"_26170":109383,"_2648":109384},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3150":64946,"_27660":64943,"_5":28000,"_19192":109386,"_26170":109387,"_2648":109388},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3150":64947,"_27660":64943,"_5":28000,"_19192":109390,"_26170":109391,"_2648":109392},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3150":64948,"_27660":64943,"_5":28000,"_19192":109394,"_26170":109395,"_2648":109396},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3150":64949,"_27660":64943,"_5":28000,"_19192":109398,"_26170":109399,"_2648":109400},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3150":64950,"_27660":64943,"_19192":109402,"_5":13195,"_26170":64943,"_2648":109403},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3150":64951,"_27660":64943,"_19192":109405,"_5":13195,"_26170":109383,"_2648":109406},[],"Relación",{"_3150":64952,"_27660":64943,"_19192":109408,"_5":13195,"_26170":109383,"_2648":109409},[],"Material que prepara el responsable",{"_3150":64953,"_27660":64943,"_19192":109411,"_5":13195,"_26170":109383,"_2648":109412},[],"Dispositivo → servidor EST",{"_3150":64954,"_27660":64943,"_19192":109414,"_5":13195,"_26170":109383,"_2648":109415},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3150":64955,"_27660":64943,"_19192":109417,"_5":13195,"_26170":109383,"_2648":109418},[],"DMS → solicitante",{"_3150":64956,"_27660":64943,"_19192":109420,"_5":13195,"_26170":109383,"_2648":109421},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3150":64957,"_27660":64943,"_19192":109423,"_5":13195,"_26170":109383,"_2648":109424},[],"Consumidor → dispositivo",{"_3150":64958,"_27660":64943,"_19192":109426,"_5":13195,"_26170":109383,"_2648":109427},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3150":64959,"_27660":64943,"_19192":109429,"_5":13195,"_26170":109383,"_2648":109430},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3150":64960,"_27660":64943,"_19192":109432,"_5":13195,"_26170":109387,"_2648":109433},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3150":64961,"_27660":64943,"_19192":109435,"_5":13195,"_26170":109387,"_2648":109436},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3150":64962,"_27660":64943,"_19192":109438,"_5":13195,"_26170":109391,"_2648":109439},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3150":64963,"_27660":64943,"_19192":109441,"_5":13195,"_26170":109391,"_2648":109442},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3150":64964,"_27660":64943,"_19192":109444,"_5":13195,"_26170":109391,"_2648":109445},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3150":64965,"_27660":64943,"_19192":109447,"_5":13195,"_26170":109391,"_2648":109448},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3150":64966,"_27660":64943,"_19192":109450,"_5":13195,"_26170":109391,"_2648":109451},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3150":64967,"_27660":64943,"_19192":109453,"_5":13195,"_26170":109391,"_2648":109454},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3150":64968,"_27660":64943,"_19192":109456,"_5":13195,"_26170":109395,"_2648":109457},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3150":64969,"_27660":64943,"_19192":109459,"_5":13195,"_26170":109395,"_2648":109460},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3150":64970,"_27660":64943,"_19192":109462,"_5":13195,"_26170":109395,"_2648":109463},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3150":64971,"_27660":64943,"_19192":109465,"_5":13195,"_26170":109399,"_2648":109466},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3150":64972,"_27660":64972,"_5":13521,"_2648":48781,"_28003":109468,"_19192":109470,"_26170":64972},[44970,107092,47327,108067,109469],"Integraciones",[],{"_3150":64973,"_27660":64972,"_19192":109472,"_5":13195,"_26170":64972,"_2648":109473},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3150":64974,"_27660":64972,"_5":28000,"_19192":109475,"_26170":109476,"_2648":109477},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3150":64975,"_27660":64972,"_5":28000,"_19192":109479,"_26170":109480,"_2648":109481},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3150":64976,"_27660":64972,"_5":28000,"_19192":109483,"_26170":109484,"_2648":109485},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3150":64977,"_27660":64972,"_5":28000,"_19192":109487,"_26170":109488,"_2648":109489},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3150":64978,"_27660":64972,"_5":28000,"_19192":109491,"_26170":109492,"_2648":109493},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3150":64979,"_27660":64972,"_5":28000,"_19192":109495,"_26170":109496,"_2648":109497},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3150":64980,"_27660":64972,"_5":28000,"_19192":109499,"_26170":109500,"_2648":48815},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3150":64981,"_27660":64972,"_5":28000,"_19192":109502,"_26170":109503,"_2648":48819},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3150":64982,"_27660":64972,"_5":28000,"_19192":109505,"_26170":109506,"_2648":109507},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3150":64983,"_27660":64972,"_5":28000,"_19192":109509,"_26170":109510,"_2648":109511},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3150":64984,"_27660":64972,"_5":28000,"_19192":109513,"_26170":109514,"_2648":109515},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3150":64985,"_27660":64972,"_5":28000,"_19192":109517,"_26170":109518,"_2648":109519},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3150":64986,"_27660":64972,"_5":28000,"_19192":109521,"_26170":109522,"_2648":109523},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3150":64987,"_27660":64972,"_5":28000,"_19192":109525,"_26170":109526,"_2648":109527},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3150":64988,"_27660":64972,"_5":28000,"_19192":109529,"_26170":109530,"_2648":109531},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3150":64989,"_27660":64972,"_5":28000,"_19192":109533,"_26170":109534,"_2648":109535},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3150":64990,"_27660":64972,"_5":28000,"_19192":109537,"_26170":109538,"_2648":109539},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3150":64991,"_27660":64972,"_5":28000,"_19192":109541,"_26170":109542,"_2648":109543},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3150":64992,"_27660":64972,"_5":28000,"_19192":109545,"_26170":109546,"_2648":109547},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3150":64993,"_27660":64972,"_5":28000,"_19192":109549,"_26170":109550,"_2648":109551},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3150":64994,"_27660":64972,"_19192":109553,"_5":13195,"_26170":64972,"_2648":109554},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3150":64995,"_27660":64972,"_19192":109556,"_5":13195,"_26170":64972,"_2648":109557},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3150":64996,"_27660":64972,"_19192":109559,"_5":13195,"_26170":64972,"_2648":109560},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3150":64997,"_27660":64972,"_19192":109562,"_5":13195,"_26170":109476,"_2648":109563},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3150":64998,"_27660":64972,"_19192":109565,"_5":13195,"_26170":109476,"_2648":109566},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3150":64999,"_27660":64972,"_19192":109568,"_5":13195,"_26170":109476,"_2648":109569},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3150":65000,"_27660":64972,"_19192":109571,"_5":13195,"_26170":109476,"_2648":109572},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3150":65001,"_27660":64972,"_19192":109574,"_5":13195,"_26170":109480,"_2648":109575},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3150":65002,"_27660":64972,"_19192":109577,"_5":13195,"_26170":109484,"_2648":109578},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3150":65003,"_27660":64972,"_19192":109580,"_5":13195,"_26170":109484,"_2648":109581},[],"Acción IAM",{"_3150":65004,"_27660":64972,"_19192":109583,"_5":13195,"_26170":109484,"_2648":106128},[],{"_3150":65005,"_27660":64972,"_19192":109585,"_5":13195,"_26170":109484,"_2648":48902},[],{"_3150":65006,"_27660":64972,"_19192":109587,"_5":13195,"_26170":109484,"_2648":109588},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3150":65007,"_27660":64972,"_19192":109590,"_5":13195,"_26170":109484,"_2648":48908},[],{"_3150":65008,"_27660":64972,"_19192":109592,"_5":13195,"_26170":109484,"_2648":109593},[],"Registrar la CA en AWS IoT",{"_3150":65009,"_27660":64972,"_19192":109595,"_5":13195,"_26170":109484,"_2648":48914},[],{"_3150":65010,"_27660":64972,"_19192":109597,"_5":13195,"_26170":109484,"_2648":109598},[],"Consultar el estado del registro de la CA",{"_3150":65011,"_27660":64972,"_19192":109600,"_5":13195,"_26170":109484,"_2648":48920},[],{"_3150":65012,"_27660":64972,"_19192":109602,"_5":13195,"_26170":109484,"_2648":109603},[],"Crear o actualizar Things en IoT Core",{"_3150":65013,"_27660":64972,"_19192":109605,"_5":13195,"_26170":109484,"_2648":48926},[],{"_3150":65014,"_27660":64972,"_19192":109607,"_5":13195,"_26170":109484,"_2648":109608},[],"Aprovisionar Things mediante plantilla",{"_3150":65015,"_27660":64972,"_19192":109610,"_5":13195,"_26170":109484,"_2648":48932},[],{"_3150":65016,"_27660":64972,"_19192":109612,"_5":13195,"_26170":109484,"_2648":109613},[],"Registrar certificados de dispositivo",{"_3150":65017,"_27660":64972,"_19192":109615,"_5":13195,"_26170":109484,"_2648":48938},[],{"_3150":65018,"_27660":64972,"_19192":109617,"_5":13195,"_26170":109484,"_2648":109618},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3150":65019,"_27660":64972,"_19192":109620,"_5":13195,"_26170":109484,"_2648":48944},[],{"_3150":65020,"_27660":64972,"_19192":109622,"_5":13195,"_26170":109484,"_2648":109623},[],"Crear y adjuntar políticas IoT",{"_3150":65021,"_27660":64972,"_19192":109625,"_5":13195,"_26170":109484,"_2648":48950},[],{"_3150":65022,"_27660":64972,"_19192":109627,"_5":13195,"_26170":109484,"_2648":109628},[],"Gestionar grupos de Things",{"_3150":65023,"_27660":64972,"_19192":109630,"_5":13195,"_26170":109484,"_2648":48956},[],{"_3150":65024,"_27660":64972,"_19192":109632,"_5":13195,"_26170":109484,"_2648":109633},[],"Crear plantillas JITP",{"_3150":65025,"_27660":64972,"_19192":109635,"_5":13195,"_26170":109484,"_2648":48962},[],{"_3150":65026,"_27660":64972,"_19192":109637,"_5":13195,"_26170":109484,"_2648":109638},[],"Leer y escribir el Device Shadow",{"_3150":65027,"_27660":64972,"_19192":109640,"_5":13195,"_26170":109484,"_2648":109641},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3150":65028,"_27660":64972,"_19192":109643,"_5":13195,"_26170":109488,"_2648":109644},[],"Parámetro",{"_3150":65029,"_27660":64972,"_19192":109646,"_5":13195,"_26170":109488,"_2648":109647},[],"Tipo",{"_3150":65030,"_27660":64972,"_19192":109649,"_5":13195,"_26170":109488,"_2648":109650},[],"Requerido",{"_3150":65031,"_27660":64972,"_19192":109652,"_5":13195,"_26170":109488,"_2648":109653},[],"Descripción",{"_3150":65032,"_27660":64972,"_19192":109655,"_5":13195,"_26170":109488,"_2648":48983},[],{"_3150":65033,"_27660":64972,"_19192":109657,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65034,"_27660":64972,"_19192":109659,"_5":13195,"_26170":109488,"_2648":109660},[],"Sí",{"_3150":65035,"_27660":64972,"_19192":109662,"_5":13195,"_26170":109488,"_2648":109663},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3150":65036,"_27660":64972,"_19192":109665,"_5":13195,"_26170":109488,"_2648":48994},[],{"_3150":65037,"_27660":64972,"_19192":109667,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65038,"_27660":64972,"_19192":109669,"_5":13195,"_26170":109488,"_2648":109660},[],{"_3150":65039,"_27660":64972,"_19192":109671,"_5":13195,"_26170":109488,"_2648":109672},[],"Región AWS donde opera el conector.",{"_3150":65040,"_27660":64972,"_19192":109674,"_5":13195,"_26170":109488,"_2648":49004},[],{"_3150":65041,"_27660":64972,"_19192":109676,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65042,"_27660":64972,"_19192":109678,"_5":13195,"_26170":109488,"_2648":109660},[],{"_3150":65043,"_27660":64972,"_19192":109680,"_5":13195,"_26170":109488,"_2648":109681},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3150":65044,"_27660":64972,"_19192":109683,"_5":13195,"_26170":109488,"_2648":49014},[],{"_3150":65045,"_27660":64972,"_19192":109685,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65046,"_27660":64972,"_19192":109687,"_5":13195,"_26170":109488,"_2648":109688},[],"Solo con `auth_method=static`",{"_3150":65047,"_27660":64972,"_19192":109690,"_5":13195,"_26170":109488,"_2648":109691},[],"Clave de acceso AWS.",{"_3150":65048,"_27660":64972,"_19192":109693,"_5":13195,"_26170":109488,"_2648":49025},[],{"_3150":65049,"_27660":64972,"_19192":109695,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65050,"_27660":64972,"_19192":109697,"_5":13195,"_26170":109488,"_2648":109688},[],{"_3150":65051,"_27660":64972,"_19192":109699,"_5":13195,"_26170":109488,"_2648":109700},[],"Clave secreta AWS.",{"_3150":65052,"_27660":64972,"_19192":109702,"_5":13195,"_26170":109488,"_2648":49035},[],{"_3150":65053,"_27660":64972,"_19192":109704,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65054,"_27660":64972,"_19192":109706,"_5":13195,"_26170":109488,"_2648":49040},[],{"_3150":65055,"_27660":64972,"_19192":109708,"_5":13195,"_26170":109488,"_2648":109709},[],"Token de sesión (con `auth_method=static`).",{"_3150":65056,"_27660":64972,"_19192":109711,"_5":13195,"_26170":109488,"_2648":49046},[],{"_3150":65057,"_27660":64972,"_19192":109713,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65058,"_27660":64972,"_19192":109715,"_5":13195,"_26170":109488,"_2648":109716},[],"Solo con `auth_method=role`",{"_3150":65059,"_27660":64972,"_19192":109718,"_5":13195,"_26170":109488,"_2648":109719},[],"ARN del rol a asumir.",{"_3150":65060,"_27660":64972,"_19192":109721,"_5":13195,"_26170":109488,"_2648":49057},[],{"_3150":65061,"_27660":64972,"_19192":109723,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65062,"_27660":64972,"_19192":109725,"_5":13195,"_26170":109488,"_2648":49040},[],{"_3150":65063,"_27660":64972,"_19192":109727,"_5":13195,"_26170":109488,"_2648":109728},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3150":65064,"_27660":64972,"_19192":109730,"_5":13195,"_26170":109488,"_2648":49067},[],{"_3150":65065,"_27660":64972,"_19192":109732,"_5":13195,"_26170":109488,"_2648":16185},[],{"_3150":65066,"_27660":64972,"_19192":109734,"_5":13195,"_26170":109488,"_2648":109660},[],{"_3150":65067,"_27660":64972,"_19192":109736,"_5":13195,"_26170":109488,"_2648":109737},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3150":65068,"_27660":64972,"_19192":109739,"_5":13195,"_26170":109488,"_2648":49077},[],{"_3150":65069,"_27660":64972,"_19192":109741,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65070,"_27660":64972,"_19192":109743,"_5":13195,"_26170":109488,"_2648":109660},[],{"_3150":65071,"_27660":64972,"_19192":109745,"_5":13195,"_26170":109488,"_2648":109746},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3150":65072,"_27660":64972,"_19192":109748,"_5":13195,"_26170":109488,"_2648":49087},[],{"_3150":65073,"_27660":64972,"_19192":109750,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65074,"_27660":64972,"_19192":109752,"_5":13195,"_26170":109488,"_2648":109660},[],{"_3150":65075,"_27660":64972,"_19192":109754,"_5":13195,"_26170":109488,"_2648":109755},[],"URL HTTP del Device Manager de Lamassu.",{"_3150":65076,"_27660":64972,"_19192":109757,"_5":13195,"_26170":109488,"_2648":49097},[],{"_3150":65077,"_27660":64972,"_19192":109759,"_5":13195,"_26170":109488,"_2648":22952},[],{"_3150":65078,"_27660":64972,"_19192":109761,"_5":13195,"_26170":109488,"_2648":109660},[],{"_3150":65079,"_27660":64972,"_19192":109763,"_5":13195,"_26170":109488,"_2648":109764},[],"URL HTTP del servicio de CA de Lamassu.",{"_3150":65080,"_27660":64972,"_19192":109766,"_5":13195,"_26170":109492,"_2648":109767},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3150":65081,"_27660":64972,"_19192":109769,"_5":13195,"_26170":109496,"_2648":109770},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3150":65082,"_27660":64972,"_19192":109772,"_5":13195,"_26170":109496,"_2648":109773},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3150":65083,"_27660":64972,"_19192":109775,"_5":13195,"_26170":109500,"_2648":109776},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3150":65084,"_27660":64972,"_19192":109778,"_5":13195,"_26170":109500,"_2648":109779},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3150":65085,"_27660":64972,"_19192":109781,"_5":13195,"_26170":109500,"_2648":109782},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3150":65086,"_27660":64972,"_19192":109784,"_5":13195,"_26170":109500,"_2648":109785},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3150":65087,"_27660":64972,"_19192":109787,"_5":13195,"_26170":109500,"_2648":109788},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3150":65088,"_27660":64972,"_19192":109790,"_5":13195,"_26170":109500,"_2648":109791},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3150":65089,"_27660":64972,"_19192":109793,"_5":13195,"_26170":109503,"_2648":109794},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3150":65090,"_27660":64972,"_19192":109796,"_5":13195,"_26170":109506,"_2648":109797},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3150":65091,"_27660":64972,"_19192":109799,"_5":13195,"_26170":109506,"_2648":109800},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3150":65092,"_27660":64972,"_19192":109802,"_5":13195,"_26170":109510,"_2648":109803},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3150":65093,"_27660":64972,"_19192":109805,"_5":13195,"_26170":109514,"_2648":109806},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3150":65094,"_27660":64972,"_19192":109808,"_5":13195,"_26170":109514,"_2648":109809},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3150":65095,"_27660":64972,"_19192":109811,"_5":13195,"_26170":109514,"_2648":109812},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3150":65096,"_27660":64972,"_19192":109814,"_5":13195,"_26170":109514,"_2648":109815},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3150":65097,"_27660":64972,"_19192":109817,"_5":13195,"_26170":109514,"_2648":109818},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3150":65098,"_27660":64972,"_19192":109820,"_5":13195,"_26170":109514,"_2648":109821},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3150":65099,"_27660":64972,"_19192":109823,"_5":13195,"_26170":109518,"_2648":109824},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3150":65100,"_27660":64972,"_19192":109826,"_5":13195,"_26170":109518,"_2648":109827},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3150":65101,"_27660":64972,"_19192":109829,"_5":13195,"_26170":109518,"_2648":109830},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3150":65102,"_27660":64972,"_19192":109832,"_5":13195,"_26170":109522,"_2648":109833},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3150":65103,"_27660":64972,"_19192":109835,"_5":13195,"_26170":109522,"_2648":109836},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3150":65104,"_27660":64972,"_19192":109838,"_5":13195,"_26170":109522,"_2648":109839},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3150":65105,"_27660":64972,"_19192":109841,"_5":13195,"_26170":109526,"_2648":109842},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3150":65106,"_27660":64972,"_19192":109844,"_5":13195,"_26170":109526,"_2648":109845},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3150":65107,"_27660":64972,"_19192":109847,"_5":13195,"_26170":109526,"_2648":109848},[],"Para que el flujo JITP funcione correctamente:",{"_3150":65108,"_27660":64972,"_19192":109850,"_5":13195,"_26170":109526,"_2648":109851},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3150":65109,"_27660":64972,"_19192":109853,"_5":13195,"_26170":109526,"_2648":109854},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3150":65110,"_27660":64972,"_19192":109856,"_5":13195,"_26170":109526,"_2648":109857},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3150":65111,"_27660":64972,"_19192":109859,"_5":13195,"_26170":109526,"_2648":109860},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3150":65112,"_27660":64972,"_19192":109862,"_5":13195,"_26170":109530,"_2648":109863},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3150":65113,"_27660":64972,"_19192":109865,"_5":13195,"_26170":109530,"_2648":109866},[],"Estado en Lamassu",{"_3150":65114,"_27660":64972,"_19192":109868,"_5":13195,"_26170":109530,"_2648":109869},[],"Razón de revocación",{"_3150":65115,"_27660":64972,"_19192":109871,"_5":13195,"_26170":109530,"_2648":109872},[],"Estado en AWS IoT Core",{"_3150":65116,"_27660":64972,"_19192":109874,"_5":13195,"_26170":109530,"_2648":49218},[],{"_3150":65117,"_27660":64972,"_19192":109876,"_5":13195,"_26170":109530,"_2648":109877},[],"Ninguna",{"_3150":65118,"_27660":64972,"_19192":109879,"_5":13195,"_26170":109530,"_2648":49224},[],{"_3150":65119,"_27660":64972,"_19192":109881,"_5":13195,"_26170":109530,"_2648":49227},[],{"_3150":65120,"_27660":64972,"_19192":109883,"_5":13195,"_26170":109530,"_2648":49230},[],{"_3150":65121,"_27660":64972,"_19192":109885,"_5":13195,"_26170":109530,"_2648":49233},[],{"_3150":65122,"_27660":64972,"_19192":109887,"_5":13195,"_26170":109530,"_2648":49227},[],{"_3150":65123,"_27660":64972,"_19192":109889,"_5":13195,"_26170":109530,"_2648":109890},[],"Cualquier otra razón",{"_3150":65124,"_27660":64972,"_19192":109892,"_5":13195,"_26170":109530,"_2648":49241},[],{"_3150":65125,"_27660":64972,"_19192":109894,"_5":13195,"_26170":109530,"_2648":109895},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3150":65126,"_27660":64972,"_19192":109897,"_5":13195,"_26170":109534,"_2648":109898},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3150":65127,"_27660":64972,"_19192":109900,"_5":13195,"_26170":109534,"_2648":109901},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3150":65128,"_27660":64972,"_19192":109903,"_5":13195,"_26170":109534,"_2648":109904},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3150":65129,"_27660":64972,"_19192":109906,"_5":13195,"_26170":109538,"_2648":109907},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3150":65130,"_27660":64972,"_19192":109909,"_5":13195,"_26170":109538,"_2648":109910},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3150":65131,"_27660":64972,"_19192":109912,"_5":13195,"_26170":109542,"_2648":109913},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3150":65132,"_27660":64972,"_19192":109915,"_5":13195,"_26170":109542,"_2648":109916},[],"Existen dos tipos de acciones:",{"_3150":65133,"_27660":64972,"_19192":109918,"_5":13195,"_26170":109542,"_2648":109919},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3150":65134,"_27660":64972,"_19192":109921,"_5":13195,"_26170":109542,"_2648":109922},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3150":65135,"_27660":64972,"_19192":109924,"_5":13195,"_26170":109542,"_2648":109925},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3150":65136,"_27660":64972,"_19192":109927,"_5":13195,"_26170":109546,"_2648":109928},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3150":65137,"_27660":64972,"_19192":109930,"_5":13195,"_26170":109546,"_2648":109931},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3150":65138,"_27660":64972,"_19192":109933,"_5":13195,"_26170":109546,"_2648":109934},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3150":65139,"_27660":64972,"_19192":109936,"_5":13195,"_26170":109550,"_2648":109937},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3150":65140,"_27660":64972,"_19192":109939,"_5":13195,"_26170":109550,"_2648":109940},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3150":65141,"_27660":64972,"_19192":109942,"_5":13195,"_26170":109550,"_2648":109943},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3150":65142,"_27660":64972,"_19192":109945,"_5":13195,"_26170":109550,"_2648":109946},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3150":65143,"_27660":64972,"_19192":109948,"_5":13195,"_26170":109550,"_2648":109949},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3150":65144,"_27660":64972,"_19192":109951,"_5":13195,"_26170":109550,"_2648":109952},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3150":65145,"_27660":64972,"_19192":109954,"_5":13195,"_26170":109550,"_2648":109955},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3150":65146,"_27660":64972,"_19192":109957,"_5":13195,"_26170":109550,"_2648":109958},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3150":65147,"_27660":64972,"_19192":109960,"_5":13195,"_26170":109550,"_2648":109961},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3150":65148,"_27660":64972,"_19192":109963,"_5":13195,"_26170":109550,"_2648":109964},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3150":65149,"_27660":64972,"_19192":109966,"_5":13195,"_26170":109550,"_2648":109967},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3150":65150,"_27660":64972,"_19192":109969,"_5":13195,"_26170":109550,"_2648":109970},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3150":65151,"_27660":64972,"_19192":109972,"_5":13195,"_26170":109550,"_2648":109973},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3150":65152,"_27660":64972,"_19192":109975,"_5":13195,"_26170":109550,"_2648":109976},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3150":65153,"_27660":64972,"_19192":109978,"_5":13195,"_26170":109550,"_2648":109979},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3150":65154,"_27660":64972,"_19192":109981,"_5":13195,"_26170":109550,"_2648":109982},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3150":65155,"_27660":64972,"_19192":109984,"_5":13195,"_26170":109550,"_2648":109985},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3150":65156,"_27660":64972,"_19192":109987,"_5":13195,"_26170":109550,"_2648":109988},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3150":65157,"_27660":64972,"_19192":109990,"_5":13195,"_26170":109550,"_2648":109991},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":65158,"_27660":64972,"_19192":109993,"_5":13195,"_26170":109550,"_2648":109994},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3150":65159,"_27660":64972,"_19192":109996,"_5":13195,"_26170":109550,"_2648":109997},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3150":65160,"_27660":65160,"_5":13521,"_2648":47327,"_28003":109999,"_19192":110000,"_26170":65160},[44970,107092,47327],[],{"_3150":65161,"_27660":65160,"_19192":110002,"_5":13195,"_26170":65160,"_2648":110003},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3150":65162,"_27660":65160,"_5":28000,"_19192":110005,"_26170":110006,"_2648":110007},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3150":65163,"_27660":65160,"_5":28000,"_19192":110009,"_26170":110010,"_2648":108067},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3150":65164,"_27660":65160,"_5":28000,"_19192":110012,"_26170":110013,"_2648":108242},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3150":65165,"_27660":65160,"_5":28000,"_19192":110015,"_26170":110016,"_2648":109469},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#integraciones",{"_3150":65166,"_27660":65160,"_5":28000,"_19192":110018,"_26170":110019,"_2648":110020},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3150":65167,"_27660":65160,"_19192":110022,"_5":13195,"_26170":65160,"_2648":110023},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3150":65168,"_27660":65160,"_19192":110025,"_5":13195,"_26170":110006,"_2648":110026},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3150":65169,"_27660":65160,"_19192":110028,"_5":13195,"_26170":110006,"_2648":110029},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3150":65170,"_27660":65160,"_19192":110031,"_5":13195,"_26170":110010,"_2648":110032},[],"Recurso",{"_3150":65171,"_27660":65160,"_19192":110034,"_5":13195,"_26170":110010,"_2648":110035},[],"Qué representa",{"_3150":65172,"_27660":65160,"_19192":110037,"_5":13195,"_26170":110010,"_2648":110038},[],"**Dispositivo**",{"_3150":65173,"_27660":65160,"_19192":110040,"_5":13195,"_26170":110010,"_2648":110041},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3150":65174,"_27660":65160,"_19192":110043,"_5":13195,"_26170":110010,"_2648":110044},[],"**Identidad**",{"_3150":65175,"_27660":65160,"_19192":110046,"_5":13195,"_26170":110010,"_2648":110047},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3150":65176,"_27660":65160,"_19192":110049,"_5":13195,"_26170":110010,"_2648":49399},[],{"_3150":65177,"_27660":65160,"_19192":110051,"_5":13195,"_26170":110010,"_2648":110052},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3150":65178,"_27660":65160,"_19192":110054,"_5":13195,"_26170":110010,"_2648":110055},[],"**Flota**",{"_3150":65179,"_27660":65160,"_19192":110057,"_5":13195,"_26170":110010,"_2648":110058},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3150":65180,"_27660":65160,"_19192":110060,"_5":13195,"_26170":110010,"_2648":110061},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3150":65181,"_27660":65160,"_19192":110063,"_5":13195,"_26170":110010,"_2648":110064},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3150":65182,"_27660":65160,"_19192":110066,"_5":13195,"_26170":110013,"_2648":110067},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3150":65183,"_27660":65160,"_19192":110069,"_5":13195,"_26170":110013,"_2648":110070},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3150":65184,"_27660":65160,"_19192":110072,"_5":13195,"_26170":110013,"_2648":110073},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3150":65185,"_27660":65160,"_19192":110075,"_5":13195,"_26170":110013,"_2648":110076},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3150":65186,"_27660":65160,"_19192":110078,"_5":13195,"_26170":110013,"_2648":110079},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3150":65187,"_27660":65160,"_19192":110081,"_5":13195,"_26170":110013,"_2648":110082},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3150":65188,"_27660":65160,"_19192":110084,"_5":13195,"_26170":110013,"_2648":110085},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":65189,"_27660":65160,"_19192":110087,"_5":13195,"_26170":110013,"_2648":110088},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":65190,"_27660":65160,"_19192":110090,"_5":13195,"_26170":110016,"_2648":110091},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3150":65191,"_27660":65160,"_19192":110093,"_5":13195,"_26170":110016,"_2648":110094},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3150":65192,"_27660":65160,"_19192":110096,"_5":13195,"_26170":110019,"_2648":110097},[],"Participante",{"_3150":65193,"_27660":65160,"_19192":110099,"_5":13195,"_26170":110019,"_2648":110100},[],"Responsabilidad",{"_3150":65194,"_27660":65160,"_19192":110102,"_5":13195,"_26170":110019,"_2648":110103},[],"Administrador PKI",{"_3150":65195,"_27660":65160,"_19192":110105,"_5":13195,"_26170":110019,"_2648":110106},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3150":65196,"_27660":65160,"_19192":110108,"_5":13195,"_26170":110019,"_2648":110109},[],"Administrador del aprovisionamiento",{"_3150":65197,"_27660":65160,"_19192":110111,"_5":13195,"_26170":110019,"_2648":110112},[],"DMS, admisión, autenticación por operación e inventario.",{"_3150":65198,"_27660":65160,"_19192":110114,"_5":13195,"_26170":110019,"_2648":110115},[],"Integrador del dispositivo",{"_3150":65199,"_27660":65160,"_19192":110117,"_5":13195,"_26170":110019,"_2648":110118},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3150":65200,"_27660":65160,"_19192":110120,"_5":13195,"_26170":110019,"_2648":110121},[],"Integrador del consumidor",{"_3150":65201,"_27660":65160,"_19192":110123,"_5":13195,"_26170":110019,"_2648":110124},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3150":65202,"_27660":65160,"_19192":110126,"_5":13195,"_26170":110019,"_2648":110127},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3150":65203,"_27660":65203,"_5":13521,"_2648":110129,"_28003":110130,"_19192":110132,"_26170":65203},"Enrola y conecta tu primer dispositivo",[44970,107092,47327,110131],"Primeros pasos",[],{"_3150":65204,"_27660":65203,"_19192":110134,"_5":13195,"_26170":65203,"_2648":110135},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3150":65205,"_27660":65203,"_5":28000,"_19192":110137,"_26170":110138,"_2648":105758},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3150":65206,"_27660":65203,"_5":28000,"_19192":110140,"_26170":110141,"_2648":110142},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3150":65207,"_27660":65203,"_5":28000,"_19192":110144,"_26170":110145,"_2648":110146},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3150":65208,"_27660":65203,"_5":28000,"_19192":110148,"_26170":110149,"_2648":110150},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3150":65209,"_27660":65203,"_5":28000,"_19192":110152,"_26170":110153,"_2648":110154},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3150":65210,"_27660":65203,"_5":28000,"_19192":110156,"_26170":110157,"_2648":110158},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3150":65211,"_27660":65203,"_5":28000,"_19192":110160,"_26170":110161,"_2648":110162},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3150":65212,"_27660":65203,"_5":28000,"_19192":110164,"_26170":110165,"_2648":110166},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3150":65213,"_27660":65203,"_19192":110168,"_5":13195,"_26170":65203,"_2648":110169},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3150":65214,"_27660":65203,"_19192":110171,"_5":13195,"_26170":110138,"_2648":110172},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3150":65215,"_27660":65203,"_19192":110174,"_5":13195,"_26170":110138,"_2648":110175},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3150":65216,"_27660":65203,"_19192":110177,"_5":13195,"_26170":110138,"_2648":110178},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3150":65217,"_27660":65203,"_19192":110180,"_5":13195,"_26170":110138,"_2648":110181},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3150":65218,"_27660":65203,"_19192":110183,"_5":13195,"_26170":110138,"_2648":110184},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3150":65219,"_27660":65203,"_19192":110186,"_5":13195,"_26170":110141,"_2648":110187},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3150":65220,"_27660":65203,"_19192":110189,"_5":13195,"_26170":110141,"_2648":110190},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3150":65221,"_27660":65203,"_19192":110192,"_5":13195,"_26170":110145,"_2648":110193},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3150":65222,"_27660":65203,"_19192":110195,"_5":13195,"_26170":110145,"_2648":110196},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3150":65223,"_27660":65203,"_19192":110198,"_5":13195,"_26170":110145,"_2648":110199},[],"Ajuste",{"_3150":65224,"_27660":65203,"_19192":110201,"_5":13195,"_26170":110145,"_2648":110202},[],"Valor de evaluación",{"_3150":65225,"_27660":65203,"_19192":110204,"_5":13195,"_26170":110145,"_2648":49555},[],{"_3150":65226,"_27660":65203,"_19192":110206,"_5":13195,"_26170":110145,"_2648":110207},[],"Raíz emisora de `device-root.pem`.",{"_3150":65227,"_27660":65203,"_19192":110209,"_5":13195,"_26170":110145,"_2648":108370},[],{"_3150":65228,"_27660":65203,"_19192":110211,"_5":13195,"_26170":110145,"_2648":110212},[],"Perfil final de 1 hora que acabas de preparar.",{"_3150":65229,"_27660":65203,"_19192":110214,"_5":13195,"_26170":110145,"_2648":49566},[],{"_3150":65230,"_27660":65203,"_19192":110216,"_5":13195,"_26170":110145,"_2648":49569},[],{"_3150":65231,"_27660":65203,"_19192":110218,"_5":13195,"_26170":110145,"_2648":49572},[],{"_3150":65232,"_27660":65203,"_19192":110220,"_5":13195,"_26170":110145,"_2648":110221},[],"Habilitado.",{"_3150":65233,"_27660":65203,"_19192":110223,"_5":13195,"_26170":110145,"_2648":49578},[],{"_3150":65234,"_27660":65203,"_19192":110225,"_5":13195,"_26170":110145,"_2648":110226},[],"Deshabilitado; el ID debe ser nuevo.",{"_3150":65235,"_27660":65203,"_19192":110228,"_5":13195,"_26170":110145,"_2648":110229},[],"Autenticación inicial",{"_3150":65236,"_27660":65203,"_19192":110231,"_5":13195,"_26170":110145,"_2648":110232},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3150":65237,"_27660":65203,"_19192":110234,"_5":13195,"_26170":110145,"_2648":110235},[],"Autenticación de renovación",{"_3150":65238,"_27660":65203,"_19192":110237,"_5":13195,"_26170":110145,"_2648":110238},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3150":65239,"_27660":65203,"_19192":110240,"_5":13195,"_26170":110145,"_2648":49596},[],{"_3150":65240,"_27660":65203,"_19192":110242,"_5":13195,"_26170":110145,"_2648":110243},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_3150":65241,"_27660":65203,"_19192":110245,"_5":13195,"_26170":110145,"_2648":49602},[],{"_3150":65242,"_27660":65203,"_19192":110247,"_5":13195,"_26170":110145,"_2648":110248},[],"1 hora.",{"_3150":65243,"_27660":65203,"_19192":110250,"_5":13195,"_26170":110145,"_2648":49608},[],{"_3150":65244,"_27660":65203,"_19192":110252,"_5":13195,"_26170":110145,"_2648":110253},[],"30 minutos / 10 minutos.",{"_3150":65245,"_27660":65203,"_19192":110255,"_5":13195,"_26170":110145,"_2648":49614},[],{"_3150":65246,"_27660":65203,"_19192":110257,"_5":13195,"_26170":110145,"_2648":110258},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3150":65247,"_27660":65203,"_19192":110260,"_5":13195,"_26170":110145,"_2648":47646},[],{"_3150":65248,"_27660":65203,"_19192":110262,"_5":13195,"_26170":110145,"_2648":110263},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3150":65249,"_27660":65203,"_19192":110265,"_5":13195,"_26170":110145,"_2648":49625},[],{"_3150":65250,"_27660":65203,"_19192":110267,"_5":13195,"_26170":110145,"_2648":110268},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3150":65251,"_27660":65203,"_19192":110270,"_5":13195,"_26170":110145,"_2648":110271},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3150":65252,"_27660":65203,"_19192":110273,"_5":13195,"_26170":110149,"_2648":110274},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3150":65253,"_27660":65203,"_19192":110276,"_5":13195,"_26170":110149,"_2648":110277},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3150":65254,"_27660":65203,"_19192":110279,"_5":13195,"_26170":110153,"_2648":110280},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3150":65255,"_27660":65203,"_19192":110282,"_5":13195,"_26170":110153,"_2648":110283},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3150":65256,"_27660":65203,"_19192":110285,"_5":13195,"_26170":110153,"_2648":110286},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3150":65257,"_27660":65203,"_19192":110288,"_5":13195,"_26170":110157,"_2648":110289},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3150":65258,"_27660":65203,"_19192":110291,"_5":13195,"_26170":110157,"_2648":110292},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3150":65259,"_27660":65203,"_19192":110294,"_5":13195,"_26170":110161,"_2648":110295},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3150":65260,"_27660":65203,"_19192":110297,"_5":13195,"_26170":110161,"_2648":110298},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3150":65261,"_27660":65203,"_19192":110300,"_5":13195,"_26170":110161,"_2648":110301},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3150":65262,"_27660":65203,"_19192":110303,"_5":13195,"_26170":110161,"_2648":110304},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3150":65263,"_27660":65203,"_19192":110306,"_5":13195,"_26170":110161,"_2648":110307},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3150":65264,"_27660":65203,"_19192":110309,"_5":13195,"_26170":110165,"_2648":110310},[],"Comprobación",{"_3150":65265,"_27660":65203,"_19192":110312,"_5":13195,"_26170":110165,"_2648":110313},[],"Resultado esperado",{"_3150":65266,"_27660":65203,"_19192":110315,"_5":13195,"_26170":110165,"_2648":110316},[],"Registro",{"_3150":65267,"_27660":65203,"_19192":110318,"_5":13195,"_26170":110165,"_2648":110319},[],"ID creado automáticamente y DMS correcto.",{"_3150":65268,"_27660":65203,"_19192":110321,"_5":13195,"_26170":110165,"_2648":110322},[],"Certificado",{"_3150":65269,"_27660":65203,"_19192":110324,"_5":13195,"_26170":110165,"_2648":110325},[],"CN, perfil, serie y clave verificados.",{"_3150":65270,"_27660":65203,"_19192":110327,"_5":13195,"_26170":110165,"_2648":110328},[],"Inventario",{"_3150":65271,"_27660":65203,"_19192":110330,"_5":13195,"_26170":110165,"_2648":110331},[],"Serie recibida visible como identidad actual y en el historial.",{"_3150":65272,"_27660":65203,"_19192":110333,"_5":13195,"_26170":110165,"_2648":110334},[],"Consumidor",{"_3150":65273,"_27660":65203,"_19192":110336,"_5":13195,"_26170":110165,"_2648":110337},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3150":65274,"_27660":65203,"_19192":110339,"_5":13195,"_26170":110165,"_2648":110340},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3150":65275,"_27660":65203,"_19192":110342,"_5":13195,"_26170":110165,"_2648":110343},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3150":65276,"_27660":65276,"_5":13521,"_2648":108084,"_28003":110345,"_19192":110346,"_26170":65276},[44970,107092,47327,110131],[],{"_3150":65277,"_27660":65276,"_19192":110348,"_5":13195,"_26170":65276,"_2648":110349},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3150":65278,"_27660":65276,"_5":28000,"_19192":110351,"_26170":110352,"_2648":105758},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3150":65279,"_27660":65276,"_5":28000,"_19192":110354,"_26170":110355,"_2648":110356},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3150":65280,"_27660":65276,"_5":28000,"_19192":110358,"_26170":110359,"_2648":110360},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3150":65281,"_27660":65276,"_5":28000,"_19192":110362,"_26170":110363,"_2648":110364},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3150":65282,"_27660":65276,"_5":28000,"_19192":110366,"_26170":110367,"_2648":110368},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3150":65283,"_27660":65276,"_5":28000,"_19192":110370,"_26170":110371,"_2648":110372},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3150":65284,"_27660":65276,"_5":28000,"_19192":110374,"_26170":110375,"_2648":110313},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3150":65285,"_27660":65276,"_5":28000,"_19192":110377,"_26170":110378,"_2648":110379},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3150":65286,"_27660":65276,"_5":28000,"_19192":110381,"_26170":110382,"_2648":110383},[],"/docs/pr-preview/pr-26/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3150":65287,"_27660":65276,"_19192":110385,"_5":13195,"_26170":65276,"_2648":110386},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3150":65288,"_27660":65276,"_19192":110388,"_5":13195,"_26170":65276,"_2648":110389},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3150":65289,"_27660":65276,"_19192":110391,"_5":13195,"_26170":110352,"_2648":110392},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3150":65290,"_27660":65276,"_19192":110394,"_5":13195,"_26170":110352,"_2648":110395},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3150":65291,"_27660":65276,"_19192":110397,"_5":13195,"_26170":110352,"_2648":110398},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3150":65292,"_27660":65276,"_19192":110400,"_5":13195,"_26170":110352,"_2648":110401},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3150":65293,"_27660":65276,"_19192":110403,"_5":13195,"_26170":110355,"_2648":110404},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3150":65294,"_27660":65276,"_19192":110406,"_5":13195,"_26170":110355,"_2648":110407},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3150":65295,"_27660":65276,"_19192":110409,"_5":13195,"_26170":110355,"_2648":110410},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3150":65296,"_27660":65276,"_19192":110412,"_5":13195,"_26170":110355,"_2648":110413},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3150":65297,"_27660":65276,"_19192":110415,"_5":13195,"_26170":110355,"_2648":110416},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_3150":65298,"_27660":65276,"_19192":110418,"_5":13195,"_26170":110355,"_2648":110419},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3150":65299,"_27660":65276,"_19192":110421,"_5":13195,"_26170":110355,"_2648":110422},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3150":65300,"_27660":65276,"_19192":110424,"_5":13195,"_26170":110355,"_2648":110425},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3150":65301,"_27660":65276,"_19192":110427,"_5":13195,"_26170":110359,"_2648":110428},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3150":65302,"_27660":65276,"_19192":110430,"_5":13195,"_26170":110359,"_2648":49791},[],{"_3150":65303,"_27660":65276,"_19192":110432,"_5":13195,"_26170":110359,"_2648":110433},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3150":65304,"_27660":65276,"_19192":110435,"_5":13195,"_26170":110359,"_2648":110436},[],"**Icon** y **Tags**: clasificación opcional.",{"_3150":65305,"_27660":65276,"_19192":110438,"_5":13195,"_26170":110359,"_2648":110439},[],"Confirma el registro.",{"_3150":65306,"_27660":65276,"_19192":110441,"_5":13195,"_26170":110363,"_2648":110442},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3150":65307,"_27660":65276,"_19192":110444,"_5":13195,"_26170":110363,"_2648":110445},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3150":65308,"_27660":65276,"_19192":110447,"_5":13195,"_26170":110367,"_2648":110448},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3150":65309,"_27660":65276,"_19192":110450,"_5":13195,"_26170":110367,"_2648":110451},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3150":65310,"_27660":65276,"_19192":110453,"_5":13195,"_26170":110371,"_2648":110454},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3150":65311,"_27660":65276,"_19192":110456,"_5":13195,"_26170":110371,"_2648":110457},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3150":65312,"_27660":65276,"_19192":110459,"_5":13195,"_26170":110375,"_2648":110310},[],{"_3150":65313,"_27660":65276,"_19192":110461,"_5":13195,"_26170":110375,"_2648":110462},[],"Resultado",{"_3150":65314,"_27660":65276,"_19192":110464,"_5":13195,"_26170":110375,"_2648":110465},[],"Dispositivo",{"_3150":65315,"_27660":65276,"_19192":110467,"_5":13195,"_26170":110375,"_2648":110468},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3150":65316,"_27660":65276,"_19192":110470,"_5":13195,"_26170":110375,"_2648":110471},[],"Identidad actual",{"_3150":65317,"_27660":65276,"_19192":110473,"_5":13195,"_26170":110375,"_2648":110474},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3150":65318,"_27660":65276,"_19192":110476,"_5":13195,"_26170":110375,"_2648":110477},[],"Historial",{"_3150":65319,"_27660":65276,"_19192":110479,"_5":13195,"_26170":110375,"_2648":110480},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3150":65320,"_27660":65276,"_19192":110482,"_5":13195,"_26170":110375,"_2648":110483},[],"Clave y certificado",{"_3150":65321,"_27660":65276,"_19192":110485,"_5":13195,"_26170":110375,"_2648":110486},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3150":65322,"_27660":65276,"_19192":110488,"_5":13195,"_26170":110378,"_2648":110489},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3150":65323,"_27660":65276,"_19192":110491,"_5":13195,"_26170":110378,"_2648":110492},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3150":65324,"_27660":65276,"_19192":110494,"_5":13195,"_26170":110378,"_2648":110495},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3150":65325,"_27660":65276,"_19192":110497,"_5":13195,"_26170":110378,"_2648":110498},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3150":65326,"_27660":65276,"_19192":110500,"_5":13195,"_26170":110382,"_2648":110501},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3150":65327,"_27660":65276,"_19192":110503,"_5":13195,"_26170":110382,"_2648":110504},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3150":65328,"_27660":65276,"_19192":110506,"_5":13195,"_26170":110382,"_2648":110507},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3150":65329,"_27660":65329,"_5":13521,"_2648":110509,"_28003":110510,"_19192":110511,"_26170":65329},"Plataforma Lamassu IoT",[44970,107092],[],{"_3150":65330,"_27660":65329,"_19192":110513,"_5":13195,"_26170":65329,"_2648":110514},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3150":65331,"_27660":65329,"_5":28000,"_19192":110516,"_26170":110517,"_2648":110007},[],"/docs/pr-preview/pr-26/es/platform/overview#empieza-aquí",{"_3150":65332,"_27660":65329,"_5":28000,"_19192":110519,"_26170":110520,"_2648":110521},[],"/docs/pr-preview/pr-26/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3150":65333,"_27660":65329,"_5":28000,"_19192":110523,"_26170":110524,"_2648":110525},[],"/docs/pr-preview/pr-26/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3150":65334,"_27660":65329,"_5":28000,"_19192":110527,"_26170":110528,"_2648":110529},[],"/docs/pr-preview/pr-26/es/platform/overview#capacidades-principales","Capacidades principales",{"_3150":65335,"_27660":65329,"_5":28000,"_19192":110531,"_26170":110532,"_2648":110533},[],"/docs/pr-preview/pr-26/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3150":65336,"_27660":65329,"_5":28000,"_19192":110535,"_26170":110536,"_2648":110537},[],"/docs/pr-preview/pr-26/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3150":65337,"_27660":65329,"_5":28000,"_19192":110539,"_26170":110540,"_2648":110541},[],"/docs/pr-preview/pr-26/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3150":65338,"_27660":65329,"_5":28000,"_19192":110543,"_26170":110544,"_2648":110545},[],"/docs/pr-preview/pr-26/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3150":65339,"_27660":65329,"_5":28000,"_19192":110547,"_26170":110548,"_2648":110549},[],"/docs/pr-preview/pr-26/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3150":65340,"_27660":65329,"_5":28000,"_19192":110551,"_26170":110552,"_2648":110553},[],"/docs/pr-preview/pr-26/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3150":65341,"_27660":65329,"_5":28000,"_19192":110555,"_26170":110556,"_2648":110557},[],"/docs/pr-preview/pr-26/es/platform/overview#referencia-operativa","Referencia operativa",{"_3150":65342,"_27660":65329,"_19192":110559,"_5":13195,"_26170":65329,"_2648":110560},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3150":65343,"_27660":65329,"_19192":110562,"_5":13195,"_26170":110517,"_2648":110563},[],"Elige el resultado que necesitas obtener:",{"_3150":65344,"_27660":65329,"_19192":110565,"_5":13195,"_26170":110517,"_2648":110566},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":65345,"_27660":65329,"_19192":110568,"_5":13195,"_26170":110517,"_2648":110569},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":65346,"_27660":65329,"_19192":110571,"_5":13195,"_26170":110517,"_2648":110572},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3150":65347,"_27660":65329,"_19192":110574,"_5":13195,"_26170":110520,"_2648":110575},[],"Bloque",{"_3150":65348,"_27660":65329,"_19192":110577,"_5":13195,"_26170":110520,"_2648":110578},[],"Qué gestionas",{"_3150":65349,"_27660":65329,"_19192":110580,"_5":13195,"_26170":110520,"_2648":110581},[],"Punto de entrada",{"_3150":65350,"_27660":65329,"_19192":110583,"_5":13195,"_26170":110520,"_2648":49945},[],{"_3150":65351,"_27660":65329,"_19192":110585,"_5":13195,"_26170":110520,"_2648":110586},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3150":65352,"_27660":65329,"_19192":110588,"_5":13195,"_26170":110520,"_2648":110589},[],"Visión general de PKI",{"_3150":65353,"_27660":65329,"_19192":110591,"_5":13195,"_26170":110520,"_2648":49954},[],{"_3150":65354,"_27660":65329,"_19192":110593,"_5":13195,"_26170":110520,"_2648":110594},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3150":65355,"_27660":65329,"_19192":110596,"_5":13195,"_26170":110520,"_2648":110597},[],"Visión general de IoT Fleets",{"_3150":65356,"_27660":65329,"_19192":110599,"_5":13195,"_26170":110520,"_2648":110600},[],"**Administración**",{"_3150":65357,"_27660":65329,"_19192":110602,"_5":13195,"_26170":110520,"_2648":110603},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3150":65358,"_27660":65329,"_19192":110605,"_5":13195,"_26170":110520,"_2648":107090},[],{"_3150":65359,"_27660":65329,"_19192":110607,"_5":13195,"_26170":110520,"_2648":110608},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3150":65360,"_27660":65329,"_19192":110610,"_5":13195,"_26170":110524,"_2648":110611},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3150":65361,"_27660":65329,"_19192":110613,"_5":13195,"_26170":110524,"_2648":110614},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3150":65362,"_27660":65329,"_19192":110616,"_5":13195,"_26170":110524,"_2648":110617},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3150":65363,"_27660":65329,"_19192":110619,"_5":13195,"_26170":110524,"_2648":110620},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3150":65364,"_27660":65329,"_19192":110622,"_5":13195,"_26170":110524,"_2648":110623},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3150":65365,"_27660":65329,"_19192":110625,"_5":13195,"_26170":110524,"_2648":110626},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3150":65366,"_27660":65329,"_19192":110628,"_5":13195,"_26170":110532,"_2648":110629},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3150":65367,"_27660":65329,"_19192":110631,"_5":13195,"_26170":110536,"_2648":110632},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3150":65368,"_27660":65329,"_19192":110634,"_5":13195,"_26170":110540,"_2648":110635},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3150":65369,"_27660":65329,"_19192":110637,"_5":13195,"_26170":110544,"_2648":110638},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3150":65370,"_27660":65329,"_19192":110640,"_5":13195,"_26170":110548,"_2648":110641},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3150":65371,"_27660":65329,"_19192":110643,"_5":13195,"_26170":110552,"_2648":110644},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3150":65372,"_27660":65329,"_19192":110646,"_5":13195,"_26170":110556,"_2648":110100},[],{"_3150":65373,"_27660":65329,"_19192":110648,"_5":13195,"_26170":110556,"_2648":110649},[],"Qué prepara o comprueba",{"_3150":65374,"_27660":65329,"_19192":110651,"_5":13195,"_26170":110556,"_2648":110103},[],{"_3150":65375,"_27660":65329,"_19192":110653,"_5":13195,"_26170":110556,"_2648":110654},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3150":65376,"_27660":65329,"_19192":110656,"_5":13195,"_26170":110556,"_2648":110657},[],"Administrador de la flota",{"_3150":65377,"_27660":65329,"_19192":110659,"_5":13195,"_26170":110556,"_2648":110660},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3150":65378,"_27660":65329,"_19192":110662,"_5":13195,"_26170":110556,"_2648":110115},[],{"_3150":65379,"_27660":65329,"_19192":110664,"_5":13195,"_26170":110556,"_2648":110665},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3150":65380,"_27660":65329,"_19192":110667,"_5":13195,"_26170":110556,"_2648":110121},[],{"_3150":65381,"_27660":65329,"_19192":110669,"_5":13195,"_26170":110556,"_2648":110670},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3150":65382,"_27660":65329,"_19192":110672,"_5":13195,"_26170":110556,"_2648":110673},[],"Operador de infraestructura",{"_3150":65383,"_27660":65329,"_19192":110675,"_5":13195,"_26170":110556,"_2648":110676},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3150":65384,"_27660":65329,"_19192":110678,"_5":13195,"_26170":110556,"_2648":110679},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3150":65385,"_27660":65385,"_5":13521,"_2648":110681,"_28003":110682,"_19192":110684,"_26170":65385},"Jerarquía y rotación de CAs",[44970,107092,50046,110683],"Claves, autoridades y certificados",[],{"_3150":65386,"_27660":65385,"_19192":110686,"_5":13195,"_26170":65385,"_2648":110687},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3150":65387,"_27660":65385,"_5":28000,"_19192":110689,"_26170":110690,"_2648":110691},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3150":65388,"_27660":65385,"_5":28000,"_19192":110693,"_26170":110694,"_2648":110695},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3150":65389,"_27660":65385,"_5":28000,"_19192":110697,"_26170":110698,"_2648":110699},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3150":65390,"_27660":65385,"_5":28000,"_19192":110701,"_26170":110702,"_2648":110703},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3150":65391,"_27660":65385,"_5":28000,"_19192":110705,"_26170":110706,"_2648":110707},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3150":65392,"_27660":65385,"_5":28000,"_19192":110709,"_26170":110710,"_2648":110711},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3150":65393,"_27660":65385,"_5":28000,"_19192":110713,"_26170":110714,"_2648":110715},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3150":65394,"_27660":65385,"_5":28000,"_19192":110717,"_26170":110718,"_2648":110719},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3150":65395,"_27660":65385,"_5":28000,"_19192":110721,"_26170":110722,"_2648":110723},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3150":65396,"_27660":65385,"_5":28000,"_19192":110725,"_26170":110726,"_2648":110727},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3150":65397,"_27660":65385,"_5":28000,"_19192":110729,"_26170":110730,"_2648":110731},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3150":65398,"_27660":65385,"_5":28000,"_19192":110733,"_26170":110734,"_2648":110735},[],"/docs/pr-preview/pr-26/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3150":65399,"_27660":65385,"_19192":110737,"_5":13195,"_26170":65385,"_2648":110738},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3150":65400,"_27660":65385,"_19192":110740,"_5":13195,"_26170":65385,"_2648":110741},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3150":65401,"_27660":65385,"_19192":110743,"_5":13195,"_26170":110690,"_2648":110744},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3150":65402,"_27660":65385,"_19192":110746,"_5":13195,"_26170":110690,"_2648":110747},[],"entorno, como producción y preproducción;",{"_3150":65403,"_27660":65385,"_19192":110749,"_5":13195,"_26170":110690,"_2648":110750},[],"propietario o equipo operador;",{"_3150":65404,"_27660":65385,"_19192":110752,"_5":13195,"_26170":110690,"_2648":110753},[],"familia de dispositivos o proceso de fabricación;",{"_3150":65405,"_27660":65385,"_19192":110755,"_5":13195,"_26170":110690,"_2648":110756},[],"región o requisito regulatorio;",{"_3150":65406,"_27660":65385,"_19192":110758,"_5":13195,"_26170":110690,"_2648":110759},[],"motor criptográfico o política de clave;",{"_3150":65407,"_27660":65385,"_19192":110761,"_5":13195,"_26170":110690,"_2648":110762},[],"ventana de mantenimiento y ritmo de renovación.",{"_3150":65408,"_27660":65385,"_19192":110764,"_5":13195,"_26170":110690,"_2648":110765},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3150":65409,"_27660":65385,"_19192":110767,"_5":13195,"_26170":110690,"_2648":110768},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3150":65410,"_27660":65385,"_19192":110770,"_5":13195,"_26170":110694,"_2648":110771},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3150":65411,"_27660":65385,"_19192":110773,"_5":13195,"_26170":110694,"_2648":110774},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3150":65412,"_27660":65385,"_19192":110776,"_5":13195,"_26170":110694,"_2648":110777},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3150":65413,"_27660":65385,"_19192":110779,"_5":13195,"_26170":110698,"_2648":110780},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3150":65414,"_27660":65385,"_19192":110782,"_5":13195,"_26170":110698,"_2648":110783},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3150":65415,"_27660":65385,"_19192":110785,"_5":13195,"_26170":110698,"_2648":110786},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3150":65416,"_27660":65385,"_19192":110788,"_5":13195,"_26170":110698,"_2648":110789},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3150":65417,"_27660":65385,"_19192":110791,"_5":13195,"_26170":110706,"_2648":110792},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3150":65418,"_27660":65385,"_19192":110794,"_5":13195,"_26170":110710,"_2648":110795},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3150":65419,"_27660":65385,"_19192":110797,"_5":13195,"_26170":110714,"_2648":110798},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3150":65420,"_27660":65385,"_19192":110800,"_5":13195,"_26170":110718,"_2648":110801},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_3150":65421,"_27660":65385,"_19192":110803,"_5":13195,"_26170":110722,"_2648":110804},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3150":65422,"_27660":65385,"_19192":110806,"_5":13195,"_26170":110726,"_2648":110807},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_3150":65423,"_27660":65385,"_19192":110809,"_5":13195,"_26170":110730,"_2648":110810},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3150":65424,"_27660":65385,"_19192":110812,"_5":13195,"_26170":110730,"_2648":110813},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3150":65425,"_27660":65385,"_19192":110815,"_5":13195,"_26170":110730,"_2648":110816},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3150":65426,"_27660":65385,"_19192":110818,"_5":13195,"_26170":110730,"_2648":110819},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3150":65427,"_27660":65385,"_19192":110821,"_5":13195,"_26170":110734,"_2648":110822},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3150":65428,"_27660":65385,"_19192":110824,"_5":13195,"_26170":110734,"_2648":110825},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3150":65429,"_27660":65385,"_19192":110827,"_5":13195,"_26170":110734,"_2648":110828},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3150":65430,"_27660":65385,"_19192":110830,"_5":13195,"_26170":110734,"_2648":110831},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3150":65431,"_27660":65385,"_19192":110833,"_5":13195,"_26170":110734,"_2648":110834},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3150":65432,"_27660":65385,"_19192":110836,"_5":13195,"_26170":110734,"_2648":110837},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3150":65433,"_27660":65385,"_19192":110839,"_5":13195,"_26170":110734,"_2648":110840},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3150":65434,"_27660":65434,"_5":13521,"_2648":110842,"_28003":110843,"_19192":110844,"_26170":65434},"Autoridades de certificación",[44970,107092,50046,110683],[],{"_3150":65435,"_27660":65434,"_19192":110846,"_5":13195,"_26170":65434,"_2648":110847},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3150":65436,"_27660":65434,"_5":28000,"_19192":110849,"_26170":110850,"_2648":110851},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3150":65437,"_27660":65434,"_5":28000,"_19192":110853,"_26170":110854,"_2648":110855},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3150":65438,"_27660":65434,"_5":28000,"_19192":110857,"_26170":110858,"_2648":105758},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3150":65439,"_27660":65434,"_5":28000,"_19192":110860,"_26170":110861,"_2648":110862},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3150":65440,"_27660":65434,"_5":28000,"_19192":110864,"_26170":110865,"_2648":110866},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3150":65441,"_27660":65434,"_5":28000,"_19192":110868,"_26170":110869,"_2648":110870},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3150":65442,"_27660":65434,"_5":28000,"_19192":110872,"_26170":110873,"_2648":110874},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3150":65443,"_27660":65434,"_5":28000,"_19192":110876,"_26170":110877,"_2648":110878},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3150":65444,"_27660":65434,"_5":28000,"_19192":110880,"_26170":110881,"_2648":110882},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3150":65445,"_27660":65434,"_5":28000,"_19192":110884,"_26170":110885,"_2648":110886},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3150":65446,"_27660":65434,"_5":28000,"_19192":110888,"_26170":110889,"_2648":110890},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3150":65447,"_27660":65434,"_5":28000,"_19192":110892,"_26170":110893,"_2648":110894},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3150":65448,"_27660":65434,"_5":28000,"_19192":110896,"_26170":110897,"_2648":110898},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3150":65449,"_27660":65434,"_5":28000,"_19192":110900,"_26170":110901,"_2648":110902},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3150":65450,"_27660":65434,"_5":28000,"_19192":110904,"_26170":110905,"_2648":110906},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3150":65451,"_27660":65434,"_5":28000,"_19192":110908,"_26170":110909,"_2648":110910},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3150":65452,"_27660":65434,"_5":28000,"_19192":110912,"_26170":110913,"_2648":110914},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3150":65453,"_27660":65434,"_5":28000,"_19192":110916,"_26170":110917,"_2648":110918},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3150":65454,"_27660":65434,"_5":28000,"_19192":110920,"_26170":110921,"_2648":110922},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3150":65455,"_27660":65434,"_5":28000,"_19192":110924,"_26170":110925,"_2648":110926},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3150":65456,"_27660":65434,"_5":28000,"_19192":110928,"_26170":110929,"_2648":110930},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3150":65457,"_27660":65434,"_5":28000,"_19192":110932,"_26170":110933,"_2648":110934},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3150":65458,"_27660":65434,"_19192":110936,"_5":13195,"_26170":65434,"_2648":110937},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3150":65459,"_27660":65434,"_19192":110939,"_5":13195,"_26170":65434,"_2648":110940},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3150":65460,"_27660":65434,"_19192":110942,"_5":13195,"_26170":65434,"_2648":110943},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3150":65461,"_27660":65434,"_19192":110945,"_5":13195,"_26170":110850,"_2648":110946},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3150":65462,"_27660":65434,"_19192":110948,"_5":13195,"_26170":110850,"_2648":110949},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3150":65463,"_27660":65434,"_19192":110951,"_5":13195,"_26170":110850,"_2648":110952},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3150":65464,"_27660":65434,"_19192":110954,"_5":13195,"_26170":110850,"_2648":110955},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3150":65465,"_27660":65434,"_19192":110957,"_5":13195,"_26170":110850,"_2648":110958},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3150":65466,"_27660":65434,"_19192":110960,"_5":13195,"_26170":110858,"_2648":110961},[],"Decide si la CA será raíz o intermedia.",{"_3150":65467,"_27660":65434,"_19192":110963,"_5":13195,"_26170":110858,"_2648":110964},[],"Elige el motor que custodiará la clave.",{"_3150":65468,"_27660":65434,"_19192":110966,"_5":13195,"_26170":110858,"_2648":110967},[],"Define una validez superior a la de los certificados que emitirá.",{"_3150":65469,"_27660":65434,"_19192":110969,"_5":13195,"_26170":110858,"_2648":110970},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3150":65470,"_27660":65434,"_19192":110972,"_5":13195,"_26170":110861,"_2648":110973},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3150":65471,"_27660":65434,"_19192":110975,"_5":13195,"_26170":110865,"_2648":110976},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3150":65472,"_27660":65434,"_19192":110978,"_5":13195,"_26170":110865,"_2648":110979},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3150":65473,"_27660":65434,"_19192":110981,"_5":13195,"_26170":110869,"_2648":110982},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3150":65474,"_27660":65434,"_19192":110984,"_5":13195,"_26170":110873,"_2648":110985},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3150":65475,"_27660":65434,"_19192":110987,"_5":13195,"_26170":110873,"_2648":110988},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3150":65476,"_27660":65434,"_19192":110990,"_5":13195,"_26170":110873,"_2648":110991},[],"`ST`: estado o provincia.",{"_3150":65477,"_27660":65434,"_19192":110993,"_5":13195,"_26170":110873,"_2648":110994},[],"`L`: localidad.",{"_3150":65478,"_27660":65434,"_19192":110996,"_5":13195,"_26170":110873,"_2648":110997},[],"`O`: organización.",{"_3150":65479,"_27660":65434,"_19192":110999,"_5":13195,"_26170":110873,"_2648":111000},[],"`OU`: unidad organizativa.",{"_3150":65480,"_27660":65434,"_19192":111002,"_5":13195,"_26170":110873,"_2648":111003},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3150":65481,"_27660":65434,"_19192":111005,"_5":13195,"_26170":110877,"_2648":111006},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3150":65482,"_27660":65434,"_19192":111008,"_5":13195,"_26170":110877,"_2648":111009},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3150":65483,"_27660":65434,"_19192":111011,"_5":13195,"_26170":110881,"_2648":111012},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3150":65484,"_27660":65434,"_19192":111014,"_5":13195,"_26170":110881,"_2648":111015},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3150":65485,"_27660":65434,"_19192":111017,"_5":13195,"_26170":110885,"_2648":111018},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3150":65486,"_27660":65434,"_19192":111020,"_5":13195,"_26170":110885,"_2648":111021},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3150":65487,"_27660":65434,"_19192":111023,"_5":13195,"_26170":110889,"_2648":111024},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3150":65488,"_27660":65434,"_19192":111026,"_5":13195,"_26170":110893,"_2648":111027},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3150":65489,"_27660":65434,"_19192":111029,"_5":13195,"_26170":110897,"_2648":111030},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3150":65490,"_27660":65434,"_19192":111032,"_5":13195,"_26170":110901,"_2648":111033},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3150":65491,"_27660":65434,"_19192":111035,"_5":13195,"_26170":110905,"_2648":111036},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3150":65492,"_27660":65434,"_19192":111038,"_5":13195,"_26170":110905,"_2648":111039},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3150":65493,"_27660":65434,"_19192":111041,"_5":13195,"_26170":110909,"_2648":111042},[],"Abre una CA desde el inventario para consultar:",{"_3150":65494,"_27660":65434,"_19192":111044,"_5":13195,"_26170":110909,"_2648":111045},[],"Estado y periodo de validez.",{"_3150":65495,"_27660":65434,"_19192":111047,"_5":13195,"_26170":110909,"_2648":111048},[],"Certificado y cadena en formato PEM.",{"_3150":65496,"_27660":65434,"_19192":111050,"_5":13195,"_26170":110909,"_2648":111051},[],"Número de certificados activos, expirados y revocados.",{"_3150":65497,"_27660":65434,"_19192":111053,"_5":13195,"_26170":110909,"_2648":111054},[],"Certificados emitidos en **Issued Certificates**.",{"_3150":65498,"_27660":65434,"_19192":111056,"_5":13195,"_26170":110909,"_2648":111057},[],"CRL vinculada a la autoridad.",{"_3150":65499,"_27660":65434,"_19192":111059,"_5":13195,"_26170":110909,"_2648":111060},[],"Metadatos y motor criptográfico asociado.",{"_3150":65500,"_27660":65434,"_19192":111062,"_5":13195,"_26170":110909,"_2648":111063},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3150":65501,"_27660":65434,"_19192":111065,"_5":13195,"_26170":110913,"_2648":111066},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3150":65502,"_27660":65434,"_19192":111068,"_5":13195,"_26170":110913,"_2648":111069},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3150":65503,"_27660":65434,"_19192":111071,"_5":13195,"_26170":110913,"_2648":111072},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3150":65504,"_27660":65434,"_19192":111074,"_5":13195,"_26170":110913,"_2648":111075},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3150":65505,"_27660":65434,"_19192":111077,"_5":13195,"_26170":110917,"_2648":111078},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3150":65506,"_27660":65434,"_19192":111080,"_5":13195,"_26170":110921,"_2648":111081},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3150":65507,"_27660":65434,"_19192":111083,"_5":13195,"_26170":110925,"_2648":111084},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3150":65508,"_27660":65434,"_19192":111086,"_5":13195,"_26170":110929,"_2648":111087},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3150":65509,"_27660":65434,"_19192":111089,"_5":13195,"_26170":110933,"_2648":111090},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3150":65510,"_27660":65434,"_19192":111092,"_5":13195,"_26170":110933,"_2648":111093},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3150":65511,"_27660":65511,"_5":13521,"_2648":111095,"_28003":111096,"_19192":111097,"_26170":65511},"Perfiles de certificado",[44970,107092,50046,110683],[],{"_3150":65512,"_27660":65511,"_19192":111099,"_5":13195,"_26170":65511,"_2648":111100},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3150":65513,"_27660":65511,"_5":28000,"_19192":111102,"_26170":111103,"_2648":111104},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3150":65514,"_27660":65511,"_5":28000,"_19192":111106,"_26170":111107,"_2648":111108},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#validez","Validez",{"_3150":65515,"_27660":65511,"_5":28000,"_19192":111110,"_26170":111111,"_2648":111112},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3150":65516,"_27660":65511,"_5":28000,"_19192":111114,"_26170":111115,"_2648":111116},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3150":65517,"_27660":65511,"_5":28000,"_19192":111118,"_26170":111119,"_2648":111120},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3150":65518,"_27660":65511,"_5":28000,"_19192":111122,"_26170":111123,"_2648":111124},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3150":65519,"_27660":65511,"_5":28000,"_19192":111126,"_26170":111127,"_2648":111128},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3150":65520,"_27660":65511,"_5":28000,"_19192":111130,"_26170":111131,"_2648":111132},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3150":65521,"_27660":65511,"_5":28000,"_19192":111134,"_26170":111135,"_2648":111136},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3150":65522,"_27660":65511,"_5":28000,"_19192":111138,"_26170":111139,"_2648":111140},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3150":65523,"_27660":65511,"_5":28000,"_19192":111142,"_26170":111143,"_2648":111144},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3150":65524,"_27660":65511,"_5":28000,"_19192":111146,"_26170":111147,"_2648":111148},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3150":65525,"_27660":65511,"_5":28000,"_19192":111150,"_26170":111151,"_2648":111152},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3150":65526,"_27660":65511,"_5":28000,"_19192":111154,"_26170":111155,"_2648":111156},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3150":65527,"_27660":65511,"_5":28000,"_19192":111158,"_26170":111159,"_2648":111160},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3150":65528,"_27660":65511,"_5":28000,"_19192":111162,"_26170":111163,"_2648":111164},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3150":65529,"_27660":65511,"_19192":111166,"_5":13195,"_26170":65511,"_2648":111167},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3150":65530,"_27660":65511,"_19192":111169,"_5":13195,"_26170":65511,"_2648":111170},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3150":65531,"_27660":65511,"_19192":111172,"_5":13195,"_26170":111107,"_2648":111173},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3150":65532,"_27660":65511,"_19192":111175,"_5":13195,"_26170":111107,"_2648":111176},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3150":65533,"_27660":65511,"_19192":111178,"_5":13195,"_26170":111111,"_2648":111179},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3150":65534,"_27660":65511,"_19192":111181,"_5":13195,"_26170":111115,"_2648":111182},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3150":65535,"_27660":65511,"_19192":111184,"_5":13195,"_26170":111115,"_2648":111185},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3150":65536,"_27660":65511,"_19192":111187,"_5":13195,"_26170":111115,"_2648":111188},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3150":65537,"_27660":65511,"_19192":111190,"_5":13195,"_26170":111119,"_2648":111191},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3150":65538,"_27660":65511,"_19192":111193,"_5":13195,"_26170":111123,"_2648":111194},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3150":65539,"_27660":65511,"_19192":111196,"_5":13195,"_26170":111123,"_2648":111197},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3150":65540,"_27660":65511,"_19192":111199,"_5":13195,"_26170":111127,"_2648":111200},[],"La aplicación criptográfica puede:",{"_3150":65541,"_27660":65511,"_19192":111202,"_5":13195,"_26170":111127,"_2648":111203},[],"permitir o bloquear claves RSA;",{"_3150":65542,"_27660":65511,"_19192":111205,"_5":13195,"_26170":111127,"_2648":111206},[],"limitar los tamaños RSA admitidos;",{"_3150":65543,"_27660":65511,"_19192":111208,"_5":13195,"_26170":111127,"_2648":111209},[],"permitir o bloquear claves ECDSA;",{"_3150":65544,"_27660":65511,"_19192":111211,"_5":13195,"_26170":111127,"_2648":111212},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3150":65545,"_27660":65511,"_19192":111214,"_5":13195,"_26170":111127,"_2648":111215},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3150":65546,"_27660":65511,"_19192":111217,"_5":13195,"_26170":111131,"_2648":111218},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3150":65547,"_27660":65511,"_19192":111220,"_5":13195,"_26170":111131,"_2648":106883},[],{"_3150":65548,"_27660":65511,"_19192":111222,"_5":13195,"_26170":111131,"_2648":111223},[],"Primera opción",{"_3150":65549,"_27660":65511,"_19192":111225,"_5":13195,"_26170":111131,"_2648":111226},[],"Segunda opción",{"_3150":65550,"_27660":65511,"_19192":111228,"_5":13195,"_26170":111131,"_2648":111229},[],"Si no hay ninguna",{"_3150":65551,"_27660":65511,"_19192":111231,"_5":13195,"_26170":111131,"_2648":111232},[],"Firma directa con una CA",{"_3150":65552,"_27660":65511,"_19192":111234,"_5":13195,"_26170":111131,"_2648":111235},[],"`issuance_profile` incluido en la solicitud",{"_3150":65553,"_27660":65511,"_19192":111237,"_5":13195,"_26170":111131,"_2648":111238},[],"`issuance_profile_id` de la solicitud",{"_3150":65554,"_27660":65511,"_19192":111240,"_5":13195,"_26170":111131,"_2648":111241},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3150":65555,"_27660":65511,"_19192":111243,"_5":13195,"_26170":111131,"_2648":111244},[],"Emisión mediante DMS",{"_3150":65556,"_27660":65511,"_19192":111246,"_5":13195,"_26170":111131,"_2648":50611},[],{"_3150":65557,"_27660":65511,"_19192":111248,"_5":13195,"_26170":111131,"_2648":111249},[],"`settings.issuance_profile` incluido en el DMS",{"_3150":65558,"_27660":65511,"_19192":111251,"_5":13195,"_26170":111131,"_2648":111252},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3150":65559,"_27660":65511,"_19192":111254,"_5":13195,"_26170":111131,"_2648":111255},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3150":65560,"_27660":65511,"_19192":111257,"_5":13195,"_26170":111131,"_2648":111258},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3150":65561,"_27660":65511,"_19192":111260,"_5":13195,"_26170":111139,"_2648":111261},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3150":65562,"_27660":65511,"_19192":111263,"_5":13195,"_26170":111143,"_2648":111264},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3150":65563,"_27660":65511,"_19192":111266,"_5":13195,"_26170":111147,"_2648":111267},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3150":65564,"_27660":65511,"_19192":111269,"_5":13195,"_26170":111151,"_2648":111270},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3150":65565,"_27660":65511,"_19192":111272,"_5":13195,"_26170":111155,"_2648":111273},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3150":65566,"_27660":65511,"_19192":111275,"_5":13195,"_26170":111155,"_2648":111276},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3150":65567,"_27660":65511,"_19192":111278,"_5":13195,"_26170":111159,"_2648":111279},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3150":65568,"_27660":65511,"_19192":111281,"_5":13195,"_26170":111159,"_2648":111282},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3150":65569,"_27660":65511,"_19192":111284,"_5":13195,"_26170":111159,"_2648":111285},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3150":65570,"_27660":65511,"_19192":111287,"_5":13195,"_26170":111159,"_2648":111288},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3150":65571,"_27660":65511,"_19192":111290,"_5":13195,"_26170":111163,"_2648":111291},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3150":65572,"_27660":65511,"_19192":111293,"_5":13195,"_26170":111163,"_2648":111294},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3150":65573,"_27660":65573,"_5":13521,"_2648":111296,"_28003":111297,"_19192":111299,"_26170":65573},"Validación de certificados",[44970,107092,50046,111298],"Validación",[],{"_3150":65574,"_27660":65573,"_19192":111301,"_5":13195,"_26170":65573,"_2648":111302},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3150":65575,"_27660":65573,"_5":28000,"_19192":111304,"_26170":111305,"_2648":111306},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3150":65576,"_27660":65573,"_5":28000,"_19192":111308,"_26170":111309,"_2648":111310},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3150":65577,"_27660":65573,"_5":28000,"_19192":111312,"_26170":111313,"_2648":111314},[],"/docs/pr-preview/pr-26/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3150":65578,"_27660":65573,"_19192":111316,"_5":13195,"_26170":65573,"_2648":111317},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3150":65579,"_27660":65573,"_19192":111319,"_5":13195,"_26170":111305,"_2648":111320},[],"Verifica estos criterios juntos:",{"_3150":65580,"_27660":65573,"_19192":111322,"_5":13195,"_26170":111305,"_2648":110310},[],{"_3150":65581,"_27660":65573,"_19192":111324,"_5":13195,"_26170":111305,"_2648":111325},[],"Resultado necesario",{"_3150":65582,"_27660":65573,"_19192":111327,"_5":13195,"_26170":111305,"_2648":111328},[],"Cadena y firma",{"_3150":65583,"_27660":65573,"_19192":111330,"_5":13195,"_26170":111305,"_2648":111331},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3150":65584,"_27660":65573,"_19192":111333,"_5":13195,"_26170":111305,"_2648":111334},[],"Fechas",{"_3150":65585,"_27660":65573,"_19192":111336,"_5":13195,"_26170":111305,"_2648":111337},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3150":65586,"_27660":65573,"_19192":111339,"_5":13195,"_26170":111305,"_2648":106793},[],{"_3150":65587,"_27660":65573,"_19192":111341,"_5":13195,"_26170":111305,"_2648":111342},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3150":65588,"_27660":65573,"_19192":111344,"_5":13195,"_26170":111305,"_2648":111345},[],"Uso",{"_3150":65589,"_27660":65573,"_19192":111347,"_5":13195,"_26170":111305,"_2648":111348},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3150":65590,"_27660":65573,"_19192":111350,"_5":13195,"_26170":111305,"_2648":111351},[],"Revocación",{"_3150":65591,"_27660":65573,"_19192":111353,"_5":13195,"_26170":111305,"_2648":111354},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3150":65592,"_27660":65573,"_19192":111356,"_5":13195,"_26170":111305,"_2648":111357},[],"Autorización",{"_3150":65593,"_27660":65573,"_19192":111359,"_5":13195,"_26170":111305,"_2648":111360},[],"La aplicación permite la acción a esa identidad.",{"_3150":65594,"_27660":65573,"_19192":111362,"_5":13195,"_26170":111305,"_2648":111363},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3150":65595,"_27660":65573,"_19192":111365,"_5":13195,"_26170":111309,"_2648":111366},[],"Mecanismo",{"_3150":65596,"_27660":65573,"_19192":111368,"_5":13195,"_26170":111309,"_2648":111369},[],"Cuándo utilizarlo",{"_3150":65597,"_27660":65573,"_19192":111371,"_5":13195,"_26170":111309,"_2648":111372},[],"Qué debes mantener",{"_3150":65598,"_27660":65573,"_19192":111374,"_5":13195,"_26170":111309,"_2648":50739},[],{"_3150":65599,"_27660":65573,"_19192":111376,"_5":13195,"_26170":111309,"_2648":111377},[],"Consulta del estado de un certificado concreto.",{"_3150":65600,"_27660":65573,"_19192":111379,"_5":13195,"_26170":111309,"_2648":111380},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3150":65601,"_27660":65573,"_19192":111382,"_5":13195,"_26170":111309,"_2648":50748},[],{"_3150":65602,"_27660":65573,"_19192":111384,"_5":13195,"_26170":111309,"_2648":111385},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3150":65603,"_27660":65573,"_19192":111387,"_5":13195,"_26170":111309,"_2648":111388},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3150":65604,"_27660":65573,"_19192":111390,"_5":13195,"_26170":111309,"_2648":111391},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3150":65605,"_27660":65573,"_19192":111393,"_5":13195,"_26170":111309,"_2648":111394},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3150":65606,"_27660":65573,"_19192":111396,"_5":13195,"_26170":111313,"_2648":111397},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3150":65607,"_27660":65573,"_19192":111399,"_5":13195,"_26170":111313,"_2648":111400},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3150":65608,"_27660":65573,"_19192":111402,"_5":13195,"_26170":111313,"_2648":111403},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3150":65609,"_27660":65573,"_19192":111405,"_5":13195,"_26170":111313,"_2648":111406},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3150":65610,"_27660":65573,"_19192":111408,"_5":13195,"_26170":111313,"_2648":111409},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3150":65611,"_27660":65573,"_19192":111411,"_5":13195,"_26170":111313,"_2648":111412},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3150":65612,"_27660":65573,"_19192":111414,"_5":13195,"_26170":111313,"_2648":111415},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3150":65613,"_27660":65573,"_19192":111417,"_5":13195,"_26170":111313,"_2648":111418},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":65614,"_27660":65573,"_19192":111420,"_5":13195,"_26170":111313,"_2648":111421},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3150":65615,"_27660":65615,"_5":13521,"_2648":111423,"_28003":111424,"_19192":111425,"_26170":65615},"Certificados",[44970,107092,50046,110683],[],{"_3150":65616,"_27660":65615,"_19192":111427,"_5":13195,"_26170":65615,"_2648":111428},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3150":65617,"_27660":65615,"_5":28000,"_19192":111430,"_26170":111431,"_2648":111432},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3150":65618,"_27660":65615,"_5":28000,"_19192":111434,"_26170":111435,"_2648":111436},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3150":65619,"_27660":65615,"_5":28000,"_19192":111438,"_26170":111439,"_2648":111440},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3150":65620,"_27660":65615,"_5":28000,"_19192":111442,"_26170":111443,"_2648":111444},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3150":65621,"_27660":65615,"_5":28000,"_19192":111446,"_26170":111447,"_2648":111448},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3150":65622,"_27660":65615,"_5":28000,"_19192":111450,"_26170":111451,"_2648":111452},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3150":65623,"_27660":65615,"_5":28000,"_19192":111454,"_26170":111455,"_2648":111456},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3150":65624,"_27660":65615,"_5":28000,"_19192":111458,"_26170":111459,"_2648":111460},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3150":65625,"_27660":65615,"_5":28000,"_19192":111462,"_26170":111463,"_2648":111464},[],"/docs/pr-preview/pr-26/es/platform/pki/certificates#continúa","Continúa",{"_3150":65626,"_27660":65615,"_19192":111466,"_5":13195,"_26170":65615,"_2648":111467},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3150":65627,"_27660":65615,"_19192":111469,"_5":13195,"_26170":111431,"_2648":111470},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3150":65628,"_27660":65615,"_19192":111472,"_5":13195,"_26170":111431,"_2648":111473},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3150":65629,"_27660":65615,"_19192":111475,"_5":13195,"_26170":111435,"_2648":111476},[],"Descarga el PEM e inspecciónalo:",{"_3150":65630,"_27660":65615,"_19192":111478,"_5":13195,"_26170":111435,"_2648":111479},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3150":65631,"_27660":65615,"_19192":111481,"_5":13195,"_26170":111439,"_2648":111482},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3150":65632,"_27660":65615,"_19192":111484,"_5":13195,"_26170":111439,"_2648":111485},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3150":65633,"_27660":65615,"_19192":111487,"_5":13195,"_26170":111439,"_2648":111488},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3150":65634,"_27660":65615,"_19192":111490,"_5":13195,"_26170":111439,"_2648":111491},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3150":65635,"_27660":65615,"_19192":111493,"_5":13195,"_26170":111439,"_2648":111494},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3150":65636,"_27660":65615,"_19192":111496,"_5":13195,"_26170":111439,"_2648":111497},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3150":65637,"_27660":65615,"_19192":111499,"_5":13195,"_26170":111439,"_2648":111500},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3150":65638,"_27660":65615,"_19192":111502,"_5":13195,"_26170":111443,"_2648":111503},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3150":65639,"_27660":65615,"_19192":111505,"_5":13195,"_26170":111447,"_2648":111506},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3150":65640,"_27660":65615,"_19192":111508,"_5":13195,"_26170":111451,"_2648":111509},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3150":65641,"_27660":65615,"_19192":111511,"_5":13195,"_26170":111455,"_2648":111512},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3150":65642,"_27660":65615,"_19192":111514,"_5":13195,"_26170":111455,"_2648":111515},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3150":65643,"_27660":65615,"_19192":111517,"_5":13195,"_26170":111455,"_2648":111518},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3150":65644,"_27660":65615,"_19192":111520,"_5":13195,"_26170":111459,"_2648":111521},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3150":65645,"_27660":65615,"_19192":111523,"_5":13195,"_26170":111459,"_2648":111524},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3150":65646,"_27660":65615,"_19192":111526,"_5":13195,"_26170":111459,"_2648":111527},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3150":65647,"_27660":65615,"_19192":111529,"_5":13195,"_26170":111463,"_2648":111530},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":65648,"_27660":65615,"_19192":111532,"_5":13195,"_26170":111463,"_2648":111533},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3150":65649,"_27660":65649,"_5":13521,"_2648":111535,"_28003":111536,"_19192":111538,"_26170":65649},"Ciclo de vida de un certificado",[44970,107092,50046,111537],"Conceptos",[],{"_3150":65650,"_27660":65649,"_19192":111540,"_5":13195,"_26170":65649,"_2648":111541},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3150":65651,"_27660":65649,"_5":28000,"_19192":111543,"_26170":111544,"_2648":111545},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3150":65652,"_27660":65649,"_5":28000,"_19192":111547,"_26170":111548,"_2648":111549},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3150":65653,"_27660":65649,"_5":28000,"_19192":111551,"_26170":111552,"_2648":111553},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3150":65654,"_27660":65649,"_5":28000,"_19192":111555,"_26170":111556,"_2648":111557},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3150":65655,"_27660":65649,"_5":28000,"_19192":111559,"_26170":111560,"_2648":111561},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3150":65656,"_27660":65649,"_5":28000,"_19192":111563,"_26170":111564,"_2648":111565},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3150":65657,"_27660":65649,"_5":28000,"_19192":111567,"_26170":111568,"_2648":111569},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3150":65658,"_27660":65649,"_5":28000,"_19192":111571,"_26170":111572,"_2648":111573},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3150":65659,"_27660":65649,"_5":28000,"_19192":111575,"_26170":111576,"_2648":111577},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3150":65660,"_27660":65649,"_5":28000,"_19192":111579,"_26170":111580,"_2648":111581},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3150":65661,"_27660":65649,"_19192":111583,"_5":13195,"_26170":65649,"_2648":111584},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3150":65662,"_27660":65649,"_19192":111586,"_5":13195,"_26170":111548,"_2648":111587},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3150":65663,"_27660":65649,"_19192":111589,"_5":13195,"_26170":111552,"_2648":111590},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3150":65664,"_27660":65649,"_19192":111592,"_5":13195,"_26170":111556,"_2648":111593},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3150":65665,"_27660":65649,"_19192":111595,"_5":13195,"_26170":111560,"_2648":111596},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3150":65666,"_27660":65649,"_19192":111598,"_5":13195,"_26170":111564,"_2648":111599},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3150":65667,"_27660":65649,"_19192":111601,"_5":13195,"_26170":111568,"_2648":111602},[],"Lamassu persiste cuatro estados X.509:",{"_3150":65668,"_27660":65649,"_19192":111604,"_5":13195,"_26170":111568,"_2648":111605},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3150":65669,"_27660":65649,"_19192":111607,"_5":13195,"_26170":111568,"_2648":111608},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3150":65670,"_27660":65649,"_19192":111610,"_5":13195,"_26170":111568,"_2648":111611},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3150":65671,"_27660":65649,"_19192":111613,"_5":13195,"_26170":111568,"_2648":111614},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3150":65672,"_27660":65649,"_19192":111616,"_5":13195,"_26170":111568,"_2648":111617},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3150":65673,"_27660":65649,"_19192":111619,"_5":13195,"_26170":111572,"_2648":111620},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3150":65674,"_27660":65649,"_19192":111622,"_5":13195,"_26170":111572,"_2648":111623},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3150":65675,"_27660":65649,"_19192":111625,"_5":13195,"_26170":111572,"_2648":111626},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3150":65676,"_27660":65649,"_19192":111628,"_5":13195,"_26170":111576,"_2648":111629},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3150":65677,"_27660":65649,"_19192":111631,"_5":13195,"_26170":111576,"_2648":111632},[],"Antes de confirmar:",{"_3150":65678,"_27660":65649,"_19192":111634,"_5":13195,"_26170":111576,"_2648":111635},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3150":65679,"_27660":65649,"_19192":111637,"_5":13195,"_26170":111576,"_2648":111638},[],"Distribuye la nueva cadena de confianza.",{"_3150":65680,"_27660":65649,"_19192":111640,"_5":13195,"_26170":111576,"_2648":111641},[],"Reemite las identidades necesarias.",{"_3150":65681,"_27660":65649,"_19192":111643,"_5":13195,"_26170":111576,"_2648":111644},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3150":65682,"_27660":65649,"_19192":111646,"_5":13195,"_26170":111576,"_2648":111647},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3150":65683,"_27660":65649,"_19192":111649,"_5":13195,"_26170":111576,"_2648":111650},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3150":65684,"_27660":65649,"_19192":111652,"_5":13195,"_26170":111580,"_2648":111653},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3150":65685,"_27660":65649,"_19192":111655,"_5":13195,"_26170":111580,"_2648":111656},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3150":65686,"_27660":65649,"_19192":111658,"_5":13195,"_26170":111580,"_2648":111659},[],"Cambios de estado y razones de revocación.",{"_3150":65687,"_27660":65649,"_19192":111661,"_5":13195,"_26170":111580,"_2648":111662},[],"Publicación y vigencia de OCSP y CRLs.",{"_3150":65688,"_27660":65649,"_19192":111664,"_5":13195,"_26170":111580,"_2648":111665},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3150":65689,"_27660":65649,"_19192":111667,"_5":13195,"_26170":111580,"_2648":111668},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3150":65690,"_27660":65690,"_5":13521,"_2648":111670,"_28003":111671,"_19192":111672,"_26170":65690},"Modelo de confianza",[44970,107092,50046,111537],[],{"_3150":65691,"_27660":65690,"_19192":111674,"_5":13195,"_26170":65690,"_2648":111675},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3150":65692,"_27660":65690,"_5":28000,"_19192":111677,"_26170":111678,"_2648":111679},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3150":65693,"_27660":65690,"_5":28000,"_19192":111681,"_26170":111682,"_2648":111683},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3150":65694,"_27660":65690,"_5":28000,"_19192":111685,"_26170":111686,"_2648":111687},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3150":65695,"_27660":65690,"_5":28000,"_19192":111689,"_26170":111690,"_2648":111691},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3150":65696,"_27660":65690,"_5":28000,"_19192":111693,"_26170":111694,"_2648":111695},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3150":65697,"_27660":65690,"_5":28000,"_19192":111697,"_26170":111698,"_2648":111699},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3150":65698,"_27660":65690,"_5":28000,"_19192":111701,"_26170":111702,"_2648":111703},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3150":65699,"_27660":65690,"_5":28000,"_19192":111705,"_26170":111706,"_2648":111707},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3150":65700,"_27660":65690,"_5":28000,"_19192":111709,"_26170":111710,"_2648":111711},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3150":65701,"_27660":65690,"_5":28000,"_19192":111713,"_26170":111714,"_2648":111715},[],"/docs/pr-preview/pr-26/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3150":65702,"_27660":65690,"_19192":111717,"_5":13195,"_26170":65690,"_2648":111718},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3150":65703,"_27660":65690,"_19192":111720,"_5":13195,"_26170":111682,"_2648":111721},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3150":65704,"_27660":65690,"_19192":111723,"_5":13195,"_26170":111686,"_2648":111724},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3150":65705,"_27660":65690,"_19192":111726,"_5":13195,"_26170":111690,"_2648":111727},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3150":65706,"_27660":65690,"_19192":111729,"_5":13195,"_26170":111694,"_2648":111730},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3150":65707,"_27660":65690,"_19192":111732,"_5":13195,"_26170":111698,"_2648":111733},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3150":65708,"_27660":65690,"_19192":111735,"_5":13195,"_26170":111698,"_2648":111736},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3150":65709,"_27660":65690,"_19192":111738,"_5":13195,"_26170":111698,"_2648":111739},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3150":65710,"_27660":65690,"_19192":111741,"_5":13195,"_26170":111698,"_2648":111742},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3150":65711,"_27660":65690,"_19192":111744,"_5":13195,"_26170":111698,"_2648":111745},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3150":65712,"_27660":65690,"_19192":111747,"_5":13195,"_26170":111698,"_2648":111748},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3150":65713,"_27660":65690,"_19192":111750,"_5":13195,"_26170":111702,"_2648":111751},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3150":65714,"_27660":65690,"_19192":111753,"_5":13195,"_26170":111702,"_2648":111754},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3150":65715,"_27660":65690,"_19192":111756,"_5":13195,"_26170":111702,"_2648":111757},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_3150":65716,"_27660":65690,"_19192":111759,"_5":13195,"_26170":111702,"_2648":111760},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3150":65717,"_27660":65690,"_19192":111762,"_5":13195,"_26170":111702,"_2648":111763},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3150":65718,"_27660":65690,"_19192":111765,"_5":13195,"_26170":111706,"_2648":111766},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3150":65719,"_27660":65690,"_19192":111768,"_5":13195,"_26170":111706,"_2648":111769},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3150":65720,"_27660":65690,"_19192":111771,"_5":13195,"_26170":111706,"_2648":111772},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3150":65721,"_27660":65690,"_19192":111774,"_5":13195,"_26170":111706,"_2648":111775},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3150":65722,"_27660":65690,"_19192":111777,"_5":13195,"_26170":111706,"_2648":111778},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3150":65723,"_27660":65690,"_19192":111780,"_5":13195,"_26170":111706,"_2648":111781},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3150":65724,"_27660":65690,"_19192":111783,"_5":13195,"_26170":111706,"_2648":111784},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3150":65725,"_27660":65690,"_19192":111786,"_5":13195,"_26170":111710,"_2648":111787},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3150":65726,"_27660":65690,"_19192":111789,"_5":13195,"_26170":111714,"_2648":111790},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3150":65727,"_27660":65690,"_19192":111792,"_5":13195,"_26170":111714,"_2648":111793},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3150":65728,"_27660":65690,"_19192":111795,"_5":13195,"_26170":111714,"_2648":111796},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3150":65729,"_27660":65690,"_19192":111798,"_5":13195,"_26170":111714,"_2648":111799},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3150":65730,"_27660":65690,"_19192":111801,"_5":13195,"_26170":111714,"_2648":111802},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3150":65731,"_27660":65690,"_19192":111804,"_5":13195,"_26170":111714,"_2648":111805},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3150":65732,"_27660":65690,"_19192":111807,"_5":13195,"_26170":111714,"_2648":111808},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3150":65733,"_27660":65733,"_5":13521,"_2648":111810,"_28003":111811,"_19192":111812,"_26170":65733},"Listas de revocación (CRL)",[44970,107092,50046,111298],[],{"_3150":65734,"_27660":65733,"_19192":111814,"_5":13195,"_26170":65733,"_2648":111815},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3150":65735,"_27660":65733,"_5":28000,"_19192":111817,"_26170":111818,"_2648":111819},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3150":65736,"_27660":65733,"_5":28000,"_19192":111821,"_26170":111822,"_2648":111823},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3150":65737,"_27660":65733,"_5":28000,"_19192":111825,"_26170":111826,"_2648":111827},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3150":65738,"_27660":65733,"_5":28000,"_19192":111829,"_26170":111830,"_2648":111831},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3150":65739,"_27660":65733,"_5":28000,"_19192":111833,"_26170":111834,"_2648":111835},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3150":65740,"_27660":65733,"_5":28000,"_19192":111837,"_26170":111838,"_2648":111839},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3150":65741,"_27660":65733,"_5":28000,"_19192":111841,"_26170":111842,"_2648":111843},[],"/docs/pr-preview/pr-26/es/platform/pki/crl#referencias","Referencias",{"_3150":65742,"_27660":65733,"_19192":111845,"_5":13195,"_26170":65733,"_2648":111846},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3150":65743,"_27660":65733,"_19192":111848,"_5":13195,"_26170":111818,"_2648":111849},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3150":65744,"_27660":65733,"_19192":111851,"_5":13195,"_26170":111818,"_2648":111852},[],"Campo de `crl_options`",{"_3150":65745,"_27660":65733,"_19192":111854,"_5":13195,"_26170":111818,"_2648":108591},[],{"_3150":65746,"_27660":65733,"_19192":111856,"_5":13195,"_26170":111818,"_2648":111857},[],"Valor inicial del backend",{"_3150":65747,"_27660":65733,"_19192":111859,"_5":13195,"_26170":111818,"_2648":51226},[],{"_3150":65748,"_27660":65733,"_19192":111861,"_5":13195,"_26170":111818,"_2648":111862},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3150":65749,"_27660":65733,"_19192":111864,"_5":13195,"_26170":111818,"_2648":111865},[],"7 días.",{"_3150":65750,"_27660":65733,"_19192":111867,"_5":13195,"_26170":111818,"_2648":51235},[],{"_3150":65751,"_27660":65733,"_19192":111869,"_5":13195,"_26170":111818,"_2648":111870},[],"Plazo desde la publicación que activa la renovación programada.",{"_3150":65752,"_27660":65733,"_19192":111872,"_5":13195,"_26170":111818,"_2648":111873},[],"6 días y 23 horas.",{"_3150":65753,"_27660":65733,"_19192":111875,"_5":13195,"_26170":111818,"_2648":51244},[],{"_3150":65754,"_27660":65733,"_19192":111877,"_5":13195,"_26170":111818,"_2648":111878},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3150":65755,"_27660":65733,"_19192":111880,"_5":13195,"_26170":111818,"_2648":51250},[],{"_3150":65756,"_27660":65733,"_19192":111882,"_5":13195,"_26170":111818,"_2648":51253},[],{"_3150":65757,"_27660":65733,"_19192":111884,"_5":13195,"_26170":111818,"_2648":111885},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3150":65758,"_27660":65733,"_19192":111887,"_5":13195,"_26170":111818,"_2648":111888},[],"SKI de la CA.",{"_3150":65759,"_27660":65733,"_19192":111890,"_5":13195,"_26170":111818,"_2648":111891},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3150":65760,"_27660":65733,"_19192":111893,"_5":13195,"_26170":111818,"_2648":111894},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3150":65761,"_27660":65733,"_19192":111896,"_5":13195,"_26170":111822,"_2648":111897},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3150":65762,"_27660":65733,"_19192":111899,"_5":13195,"_26170":111822,"_2648":111900},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3150":65763,"_27660":65733,"_19192":111902,"_5":13195,"_26170":111822,"_2648":111903},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3150":65764,"_27660":65733,"_19192":111905,"_5":13195,"_26170":111826,"_2648":111906},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3150":65765,"_27660":65733,"_19192":111908,"_5":13195,"_26170":111826,"_2648":111909},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3150":65766,"_27660":65733,"_19192":111911,"_5":13195,"_26170":111830,"_2648":111912},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3150":65767,"_27660":65733,"_19192":111914,"_5":13195,"_26170":111830,"_2648":111915},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3150":65768,"_27660":65733,"_19192":111917,"_5":13195,"_26170":111830,"_2648":111918},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3150":65769,"_27660":65733,"_19192":111920,"_5":13195,"_26170":111830,"_2648":111921},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3150":65770,"_27660":65733,"_19192":111923,"_5":13195,"_26170":111830,"_2648":111924},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3150":65771,"_27660":65733,"_19192":111926,"_5":13195,"_26170":111834,"_2648":111927},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3150":65772,"_27660":65733,"_19192":111929,"_5":13195,"_26170":111834,"_2648":108780},[],{"_3150":65773,"_27660":65733,"_19192":111931,"_5":13195,"_26170":111834,"_2648":111932},[],"Path relativo",{"_3150":65774,"_27660":65733,"_19192":111934,"_5":13195,"_26170":111834,"_2648":106883},[],{"_3150":65775,"_27660":65733,"_19192":111936,"_5":13195,"_26170":111834,"_2648":51308},[],{"_3150":65776,"_27660":65733,"_19192":111938,"_5":13195,"_26170":111834,"_2648":51311},[],{"_3150":65777,"_27660":65733,"_19192":111940,"_5":13195,"_26170":111834,"_2648":111941},[],"Consultar `crl_options` y `latest_crl`.",{"_3150":65778,"_27660":65733,"_19192":111943,"_5":13195,"_26170":111834,"_2648":51317},[],{"_3150":65779,"_27660":65733,"_19192":111945,"_5":13195,"_26170":111834,"_2648":51311},[],{"_3150":65780,"_27660":65733,"_19192":111947,"_5":13195,"_26170":111834,"_2648":111948},[],"Sustituir la configuración de CRL.",{"_3150":65781,"_27660":65733,"_19192":111950,"_5":13195,"_26170":111834,"_2648":111951},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3150":65782,"_27660":65733,"_19192":111953,"_5":13195,"_26170":111834,"_2648":111954},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3150":65783,"_27660":65733,"_19192":111956,"_5":13195,"_26170":111838,"_2648":111957},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3150":65784,"_27660":65733,"_19192":111959,"_5":13195,"_26170":111842,"_2648":111960},[],"RFC 5280: perfil X.509 y CRL.",{"_3150":65785,"_27660":65733,"_19192":111962,"_5":13195,"_26170":111842,"_2648":51337},[],{"_3150":65786,"_27660":65733,"_19192":111964,"_5":13195,"_26170":111842,"_2648":51340},[],{"_3150":65787,"_27660":65733,"_19192":111966,"_5":13195,"_26170":111842,"_2648":111967},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":65788,"_27660":65733,"_19192":111969,"_5":13195,"_26170":111842,"_2648":111970},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3150":65789,"_27660":65789,"_5":13521,"_2648":111972,"_28003":111973,"_19192":111974,"_26170":65789},"Claves y motores criptográficos",[44970,107092,50046,110683],[],{"_3150":65790,"_27660":65789,"_19192":111976,"_5":13195,"_26170":65789,"_2648":111977},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3150":65791,"_27660":65789,"_5":28000,"_19192":111979,"_26170":111980,"_2648":111981},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3150":65792,"_27660":65789,"_5":28000,"_19192":111983,"_26170":111984,"_2648":111985},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3150":65793,"_27660":65789,"_5":28000,"_19192":111987,"_26170":111988,"_2648":51365},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#file-system",{"_3150":65794,"_27660":65789,"_5":28000,"_19192":111990,"_26170":111991,"_2648":51369},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#hashicorp-vault",{"_3150":65795,"_27660":65789,"_5":28000,"_19192":111993,"_26170":111994,"_2648":51373},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#aws-secrets-manager",{"_3150":65796,"_27660":65789,"_5":28000,"_19192":111996,"_26170":111997,"_2648":51377},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#aws-kms",{"_3150":65797,"_27660":65789,"_5":28000,"_19192":111999,"_26170":112000,"_2648":51381},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#pkcs11",{"_3150":65798,"_27660":65789,"_5":28000,"_19192":112002,"_26170":112003,"_2648":51385},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#azure-key-vault",{"_3150":65799,"_27660":65789,"_5":28000,"_19192":112005,"_26170":112006,"_2648":112007},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3150":65800,"_27660":65789,"_5":28000,"_19192":112009,"_26170":112010,"_2648":112011},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3150":65801,"_27660":65789,"_5":28000,"_19192":112013,"_26170":112014,"_2648":112015},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3150":65802,"_27660":65789,"_5":28000,"_19192":112017,"_26170":112018,"_2648":112019},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3150":65803,"_27660":65789,"_5":28000,"_19192":112021,"_26170":112022,"_2648":112023},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3150":65804,"_27660":65789,"_5":28000,"_19192":112025,"_26170":112026,"_2648":112027},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3150":65805,"_27660":65789,"_5":28000,"_19192":112029,"_26170":112030,"_2648":112031},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3150":65806,"_27660":65789,"_5":28000,"_19192":112033,"_26170":112034,"_2648":51417},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#sign",{"_3150":65807,"_27660":65789,"_5":28000,"_19192":112036,"_26170":112037,"_2648":51421},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#verify",{"_3150":65808,"_27660":65789,"_5":28000,"_19192":112039,"_26170":112040,"_2648":112041},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3150":65809,"_27660":65789,"_5":28000,"_19192":112043,"_26170":112044,"_2648":112045},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3150":65810,"_27660":65789,"_5":28000,"_19192":112047,"_26170":112048,"_2648":112049},[],"/docs/pr-preview/pr-26/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3150":65811,"_27660":65789,"_19192":112051,"_5":13195,"_26170":65789,"_2648":112052},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3150":65812,"_27660":65789,"_19192":112054,"_5":13195,"_26170":65789,"_2648":112055},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3150":65813,"_27660":65789,"_19192":112057,"_5":13195,"_26170":111980,"_2648":112058},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3150":65814,"_27660":65789,"_19192":112060,"_5":13195,"_26170":111980,"_2648":112061},[],"En la práctica, permite:",{"_3150":65815,"_27660":65789,"_19192":112063,"_5":13195,"_26170":111980,"_2648":112064},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3150":65816,"_27660":65789,"_19192":112066,"_5":13195,"_26170":111980,"_2648":112067},[],"Importar claves creadas externamente.",{"_3150":65817,"_27660":65789,"_19192":112069,"_5":13195,"_26170":111980,"_2648":112070},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3150":65818,"_27660":65789,"_19192":112072,"_5":13195,"_26170":111980,"_2648":112073},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3150":65819,"_27660":65789,"_19192":112075,"_5":13195,"_26170":111984,"_2648":112076},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3150":65820,"_27660":65789,"_19192":112078,"_5":13195,"_26170":111984,"_2648":112079},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3150":65821,"_27660":65789,"_19192":112081,"_5":13195,"_26170":111984,"_2648":112082},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3150":65822,"_27660":65789,"_19192":112084,"_5":13195,"_26170":111988,"_2648":112085},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3150":65823,"_27660":65789,"_19192":112087,"_5":13195,"_26170":111991,"_2648":112088},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3150":65824,"_27660":65789,"_19192":112090,"_5":13195,"_26170":111994,"_2648":112091},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3150":65825,"_27660":65789,"_19192":112093,"_5":13195,"_26170":111997,"_2648":112094},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3150":65826,"_27660":65789,"_19192":112096,"_5":13195,"_26170":112000,"_2648":112097},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3150":65827,"_27660":65789,"_19192":112099,"_5":13195,"_26170":112003,"_2648":112100},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3150":65828,"_27660":65789,"_19192":112102,"_5":13195,"_26170":112003,"_2648":112103},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3150":65829,"_27660":65789,"_19192":112105,"_5":13195,"_26170":112003,"_2648":112106},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3150":65830,"_27660":65789,"_19192":112108,"_5":13195,"_26170":112003,"_2648":112109},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3150":65831,"_27660":65789,"_19192":112111,"_5":13195,"_26170":112006,"_2648":112112},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3150":65832,"_27660":65789,"_19192":112114,"_5":13195,"_26170":112006,"_2648":112115},[],"La tabla incluye los siguientes campos:",{"_3150":65833,"_27660":65789,"_19192":112117,"_5":13195,"_26170":112006,"_2648":112118},[],"**Name**: nombre descriptivo de la clave.",{"_3150":65834,"_27660":65789,"_19192":112120,"_5":13195,"_26170":112006,"_2648":112121},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3150":65835,"_27660":65789,"_19192":112123,"_5":13195,"_26170":112006,"_2648":112124},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3150":65836,"_27660":65789,"_19192":112126,"_5":13195,"_26170":112006,"_2648":112127},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3150":65837,"_27660":65789,"_19192":112129,"_5":13195,"_26170":112006,"_2648":112130},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3150":65838,"_27660":65789,"_19192":112132,"_5":13195,"_26170":112006,"_2648":112133},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3150":65839,"_27660":65789,"_19192":112135,"_5":13195,"_26170":112006,"_2648":112136},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3150":65840,"_27660":65789,"_19192":112138,"_5":13195,"_26170":112006,"_2648":112139},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3150":65841,"_27660":65789,"_19192":112141,"_5":13195,"_26170":112006,"_2648":112142},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3150":65842,"_27660":65789,"_19192":112144,"_5":13195,"_26170":112006,"_2648":112145},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3150":65843,"_27660":65789,"_19192":112147,"_5":13195,"_26170":112006,"_2648":112148},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3150":65844,"_27660":65789,"_19192":112150,"_5":13195,"_26170":112006,"_2648":112151},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3150":65845,"_27660":65789,"_19192":112153,"_5":13195,"_26170":112006,"_2648":112154},[],"**Delete Key** para eliminar la clave del sistema.",{"_3150":65846,"_27660":65789,"_19192":112156,"_5":13195,"_26170":112010,"_2648":112157},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3150":65847,"_27660":65789,"_19192":112159,"_5":13195,"_26170":112014,"_2648":112160},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3150":65848,"_27660":65789,"_19192":112162,"_5":13195,"_26170":112014,"_2648":112163},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3150":65849,"_27660":65789,"_19192":112165,"_5":13195,"_26170":112014,"_2648":112166},[],"**Key Name**: nombre único y descriptivo.",{"_3150":65850,"_27660":65789,"_19192":112168,"_5":13195,"_26170":112014,"_2648":112169},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3150":65851,"_27660":65789,"_19192":112171,"_5":13195,"_26170":112014,"_2648":112172},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3150":65852,"_27660":65789,"_19192":112174,"_5":13195,"_26170":112014,"_2648":112175},[],"**Tags**: metadatos para clasificar la clave.",{"_3150":65853,"_27660":65789,"_19192":112177,"_5":13195,"_26170":112014,"_2648":112178},[],"**Metadata**: información adicional para usos avanzados.",{"_3150":65854,"_27660":65789,"_19192":112180,"_5":13195,"_26170":112018,"_2648":112181},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3150":65855,"_27660":65789,"_19192":112183,"_5":13195,"_26170":112018,"_2648":112184},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3150":65856,"_27660":65789,"_19192":112186,"_5":13195,"_26170":112018,"_2648":112187},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3150":65857,"_27660":65789,"_19192":112189,"_5":13195,"_26170":112018,"_2648":112190},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3150":65858,"_27660":65789,"_19192":112192,"_5":13195,"_26170":112018,"_2648":112193},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3150":65859,"_27660":65789,"_19192":112195,"_5":13195,"_26170":112018,"_2648":112196},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3150":65860,"_27660":65789,"_19192":112198,"_5":13195,"_26170":112018,"_2648":112199},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3150":65861,"_27660":65789,"_19192":112201,"_5":13195,"_26170":112018,"_2648":112202},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3150":65862,"_27660":65789,"_19192":112204,"_5":13195,"_26170":112018,"_2648":112205},[],"**Metadata**: información adicional opcional.",{"_3150":65863,"_27660":65789,"_19192":112207,"_5":13195,"_26170":112018,"_2648":112208},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3150":65864,"_27660":65789,"_19192":112210,"_5":13195,"_26170":112018,"_2648":112211},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3150":65865,"_27660":65789,"_19192":112213,"_5":13195,"_26170":112022,"_2648":112214},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3150":65866,"_27660":65789,"_19192":112216,"_5":13195,"_26170":112026,"_2648":112217},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3150":65867,"_27660":65789,"_19192":112219,"_5":13195,"_26170":112026,"_2648":112220},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3150":65868,"_27660":65789,"_19192":112222,"_5":13195,"_26170":112026,"_2648":112223},[],"**Key Name**: nombre descriptivo.",{"_3150":65869,"_27660":65789,"_19192":112225,"_5":13195,"_26170":112026,"_2648":112226},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3150":65870,"_27660":65789,"_19192":112228,"_5":13195,"_26170":112026,"_2648":112229},[],"**Tags**: etiquetas asociadas.",{"_3150":65871,"_27660":65789,"_19192":112231,"_5":13195,"_26170":112026,"_2648":112232},[],"**Aliases**: nombres alternativos.",{"_3150":65872,"_27660":65789,"_19192":112234,"_5":13195,"_26170":112026,"_2648":112235},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3150":65873,"_27660":65789,"_19192":112237,"_5":13195,"_26170":112026,"_2648":112238},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3150":65874,"_27660":65789,"_19192":112240,"_5":13195,"_26170":112026,"_2648":112241},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3150":65875,"_27660":65789,"_19192":112243,"_5":13195,"_26170":112026,"_2648":112244},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3150":65876,"_27660":65789,"_19192":112246,"_5":13195,"_26170":112030,"_2648":112247},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3150":65877,"_27660":65789,"_19192":112249,"_5":13195,"_26170":112030,"_2648":112250},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3150":65878,"_27660":65789,"_19192":112252,"_5":13195,"_26170":112030,"_2648":112253},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3150":65879,"_27660":65789,"_19192":112255,"_5":13195,"_26170":112034,"_2648":112256},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3150":65880,"_27660":65789,"_19192":112258,"_5":13195,"_26170":112034,"_2648":112259},[],"Campos principales:",{"_3150":65881,"_27660":65789,"_19192":112261,"_5":13195,"_26170":112034,"_2648":112262},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3150":65882,"_27660":65789,"_19192":112264,"_5":13195,"_26170":112034,"_2648":112265},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3150":65883,"_27660":65789,"_19192":112267,"_5":13195,"_26170":112034,"_2648":112268},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3150":65884,"_27660":65789,"_19192":112270,"_5":13195,"_26170":112034,"_2648":112271},[],"**Message**: contenido que se va a firmar.",{"_3150":65885,"_27660":65789,"_19192":112273,"_5":13195,"_26170":112034,"_2648":112274},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3150":65886,"_27660":65789,"_19192":112276,"_5":13195,"_26170":112037,"_2648":112277},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3150":65887,"_27660":65789,"_19192":112279,"_5":13195,"_26170":112037,"_2648":112259},[],{"_3150":65888,"_27660":65789,"_19192":112281,"_5":13195,"_26170":112037,"_2648":112282},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3150":65889,"_27660":65789,"_19192":112284,"_5":13195,"_26170":112037,"_2648":112285},[],"**Message Type**: `Raw` o `Digest`.",{"_3150":65890,"_27660":65789,"_19192":112287,"_5":13195,"_26170":112037,"_2648":112288},[],"**Payload Encoding**: codificación del mensaje.",{"_3150":65891,"_27660":65789,"_19192":112290,"_5":13195,"_26170":112037,"_2648":112291},[],"**Message**: mensaje original o hash.",{"_3150":65892,"_27660":65789,"_19192":112293,"_5":13195,"_26170":112037,"_2648":112294},[],"**Signature**: firma que se desea comprobar.",{"_3150":65893,"_27660":65789,"_19192":112296,"_5":13195,"_26170":112037,"_2648":112297},[],"**Result**: indicador del resultado de la validación.",{"_3150":65894,"_27660":65789,"_19192":112299,"_5":13195,"_26170":112040,"_2648":112300},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3150":65895,"_27660":65789,"_19192":112302,"_5":13195,"_26170":112040,"_2648":112303},[],"Este flujo es útil para:",{"_3150":65896,"_27660":65789,"_19192":112305,"_5":13195,"_26170":112040,"_2648":112306},[],"Solicitar certificados a una CA externa.",{"_3150":65897,"_27660":65789,"_19192":112308,"_5":13195,"_26170":112040,"_2648":112309},[],"Renovar una identidad manteniendo la misma clave.",{"_3150":65898,"_27660":65789,"_19192":112311,"_5":13195,"_26170":112040,"_2648":112312},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3150":65899,"_27660":65789,"_19192":112314,"_5":13195,"_26170":112040,"_2648":112315},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3150":65900,"_27660":65789,"_19192":112317,"_5":13195,"_26170":112040,"_2648":112318},[],"**Organization (O)**: organización o empresa.",{"_3150":65901,"_27660":65789,"_19192":112320,"_5":13195,"_26170":112040,"_2648":112321},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3150":65902,"_27660":65789,"_19192":112323,"_5":13195,"_26170":112040,"_2648":112324},[],"**Country (C)**: código de país de dos letras.",{"_3150":65903,"_27660":65789,"_19192":112326,"_5":13195,"_26170":112040,"_2648":112327},[],"**State / Province (ST)**: estado o provincia.",{"_3150":65904,"_27660":65789,"_19192":112329,"_5":13195,"_26170":112040,"_2648":112330},[],"**Locality (L)**: ciudad o localidad.",{"_3150":65905,"_27660":65789,"_19192":112332,"_5":13195,"_26170":112040,"_2648":112333},[],"**Email Address**: correo de contacto.",{"_3150":65906,"_27660":65789,"_19192":112335,"_5":13195,"_26170":112040,"_2648":112336},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3150":65907,"_27660":65789,"_19192":112338,"_5":13195,"_26170":112040,"_2648":112339},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3150":65908,"_27660":65789,"_19192":112341,"_5":13195,"_26170":112044,"_2648":112342},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3150":65909,"_27660":65789,"_19192":112344,"_5":13195,"_26170":112044,"_2648":51729},[],{"_3150":65910,"_27660":65789,"_19192":112346,"_5":13195,"_26170":112048,"_2648":112347},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3150":65911,"_27660":65911,"_5":13521,"_2648":112349,"_28003":112350,"_19192":112351,"_26170":65911},"Validación online con OCSP",[44970,107092,50046,111298],[],{"_3150":65912,"_27660":65911,"_19192":112353,"_5":13195,"_26170":65911,"_2648":112354},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3150":65913,"_27660":65911,"_5":28000,"_19192":112356,"_26170":112357,"_2648":112358},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3150":65914,"_27660":65911,"_5":28000,"_19192":112360,"_26170":112361,"_2648":112362},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3150":65915,"_27660":65911,"_5":28000,"_19192":112364,"_26170":112365,"_2648":112366},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3150":65916,"_27660":65911,"_5":28000,"_19192":112368,"_26170":112369,"_2648":112370},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3150":65917,"_27660":65911,"_5":28000,"_19192":112372,"_26170":112373,"_2648":112374},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3150":65918,"_27660":65911,"_5":28000,"_19192":112376,"_26170":112377,"_2648":111843},[],"/docs/pr-preview/pr-26/es/platform/pki/ocsp#referencias",{"_3150":65919,"_27660":65911,"_19192":112379,"_5":13195,"_26170":65911,"_2648":112380},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3150":65920,"_27660":65911,"_19192":112382,"_5":13195,"_26170":112357,"_2648":112383},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3150":65921,"_27660":65911,"_19192":112385,"_5":13195,"_26170":112357,"_2648":112386},[],"Estado del registro",{"_3150":65922,"_27660":65911,"_19192":112388,"_5":13195,"_26170":112357,"_2648":112389},[],"Respuesta firmada",{"_3150":65923,"_27660":65911,"_19192":112391,"_5":13195,"_26170":112357,"_2648":49224},[],{"_3150":65924,"_27660":65911,"_19192":112393,"_5":13195,"_26170":112357,"_2648":51779},[],{"_3150":65925,"_27660":65911,"_19192":112395,"_5":13195,"_26170":112357,"_2648":49241},[],{"_3150":65926,"_27660":65911,"_19192":112397,"_5":13195,"_26170":112357,"_2648":112398},[],"`Revoked`, con razón y fecha de revocación.",{"_3150":65927,"_27660":65911,"_19192":112400,"_5":13195,"_26170":112357,"_2648":112401},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3150":65928,"_27660":65911,"_19192":112403,"_5":13195,"_26170":112357,"_2648":112404},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3150":65929,"_27660":65911,"_19192":112406,"_5":13195,"_26170":112357,"_2648":112407},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3150":65930,"_27660":65911,"_19192":112409,"_5":13195,"_26170":112357,"_2648":112410},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3150":65931,"_27660":65911,"_19192":112412,"_5":13195,"_26170":112357,"_2648":112413},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3150":65932,"_27660":65911,"_19192":112415,"_5":13195,"_26170":112361,"_2648":112416},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3150":65933,"_27660":65911,"_19192":112418,"_5":13195,"_26170":112361,"_2648":112419},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3150":65934,"_27660":65911,"_19192":112421,"_5":13195,"_26170":112365,"_2648":112422},[],"El servicio acepta:",{"_3150":65935,"_27660":65911,"_19192":112424,"_5":13195,"_26170":112365,"_2648":108780},[],{"_3150":65936,"_27660":65911,"_19192":112426,"_5":13195,"_26170":112365,"_2648":112427},[],"Ruta del servicio VA",{"_3150":65937,"_27660":65911,"_19192":112429,"_5":13195,"_26170":112365,"_2648":112430},[],"Formato",{"_3150":65938,"_27660":65911,"_19192":112432,"_5":13195,"_26170":112365,"_2648":51819},[],{"_3150":65939,"_27660":65911,"_19192":112434,"_5":13195,"_26170":112365,"_2648":51822},[],{"_3150":65940,"_27660":65911,"_19192":112436,"_5":13195,"_26170":112365,"_2648":112437},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3150":65941,"_27660":65911,"_19192":112439,"_5":13195,"_26170":112365,"_2648":51308},[],{"_3150":65942,"_27660":65911,"_19192":112441,"_5":13195,"_26170":112365,"_2648":51830},[],{"_3150":65943,"_27660":65911,"_19192":112443,"_5":13195,"_26170":112365,"_2648":112444},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3150":65944,"_27660":65911,"_19192":112446,"_5":13195,"_26170":112365,"_2648":112447},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3150":65945,"_27660":65911,"_19192":112449,"_5":13195,"_26170":112369,"_2648":112450},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3150":65946,"_27660":65911,"_19192":112452,"_5":13195,"_26170":112369,"_2648":112453},[],"Genera la solicitud:",{"_3150":65947,"_27660":65911,"_19192":112455,"_5":13195,"_26170":112369,"_2648":112456},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3150":65948,"_27660":65911,"_19192":112458,"_5":13195,"_26170":112369,"_2648":112459},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3150":65949,"_27660":65911,"_19192":112461,"_5":13195,"_26170":112369,"_2648":112462},[],"Verifica el DER recibido:",{"_3150":65950,"_27660":65911,"_19192":112464,"_5":13195,"_26170":112369,"_2648":112465},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3150":65951,"_27660":65911,"_19192":112467,"_5":13195,"_26170":112373,"_2648":112468},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3150":65952,"_27660":65911,"_19192":112470,"_5":13195,"_26170":112373,"_2648":112471},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3150":65953,"_27660":65911,"_19192":112473,"_5":13195,"_26170":112377,"_2648":51863},[],{"_3150":65954,"_27660":65911,"_19192":112475,"_5":13195,"_26170":112377,"_2648":51866},[],{"_3150":65955,"_27660":65911,"_19192":112477,"_5":13195,"_26170":112377,"_2648":112478},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3150":65956,"_27660":65911,"_19192":112480,"_5":13195,"_26170":112377,"_2648":111970},[],{"_3150":65957,"_27660":65957,"_5":13521,"_2648":50046,"_28003":112482,"_19192":112483,"_26170":65957},[44970,107092,50046],[],{"_3150":65958,"_27660":65957,"_19192":112485,"_5":13195,"_26170":65957,"_2648":112486},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3150":65959,"_27660":65957,"_5":28000,"_19192":112488,"_26170":112489,"_2648":110007},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#empieza-aquí",{"_3150":65960,"_27660":65957,"_5":28000,"_19192":112491,"_26170":112492,"_2648":112493},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3150":65961,"_27660":65957,"_5":28000,"_19192":112495,"_26170":112496,"_2648":110529},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#capacidades-principales",{"_3150":65962,"_27660":65957,"_5":28000,"_19192":112498,"_26170":112499,"_2648":110533},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3150":65963,"_27660":65957,"_5":28000,"_19192":112501,"_26170":112502,"_2648":110537},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3150":65964,"_27660":65957,"_5":28000,"_19192":112504,"_26170":112505,"_2648":110541},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#emite-y-controla-certificados",{"_3150":65965,"_27660":65957,"_5":28000,"_19192":112507,"_26170":112508,"_2648":110549},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#publica-el-estado-de-validación",{"_3150":65966,"_27660":65957,"_5":28000,"_19192":112510,"_26170":112511,"_2648":112512},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3150":65967,"_27660":65957,"_5":28000,"_19192":112514,"_26170":112515,"_2648":111464},[],"/docs/pr-preview/pr-26/es/platform/pki/overview#continúa",{"_3150":65968,"_27660":65957,"_19192":112517,"_5":13195,"_26170":65957,"_2648":112518},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3150":65969,"_27660":65957,"_19192":112520,"_5":13195,"_26170":112489,"_2648":112521},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3150":65970,"_27660":65957,"_19192":112523,"_5":13195,"_26170":112489,"_2648":112524},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3150":65971,"_27660":65957,"_19192":112526,"_5":13195,"_26170":112492,"_2648":112527},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3150":65972,"_27660":65957,"_19192":112529,"_5":13195,"_26170":112492,"_2648":112530},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3150":65973,"_27660":65957,"_19192":112532,"_5":13195,"_26170":112492,"_2648":112533},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3150":65974,"_27660":65957,"_19192":112535,"_5":13195,"_26170":112492,"_2648":112536},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3150":65975,"_27660":65957,"_19192":112538,"_5":13195,"_26170":112492,"_2648":112539},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3150":65976,"_27660":65957,"_19192":112541,"_5":13195,"_26170":112499,"_2648":112542},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3150":65977,"_27660":65957,"_19192":112544,"_5":13195,"_26170":112502,"_2648":112545},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3150":65978,"_27660":65957,"_19192":112547,"_5":13195,"_26170":112505,"_2648":112548},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3150":65979,"_27660":65957,"_19192":112550,"_5":13195,"_26170":112508,"_2648":112551},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3150":65980,"_27660":65957,"_19192":112553,"_5":13195,"_26170":112511,"_2648":112554},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3150":65981,"_27660":65957,"_19192":112556,"_5":13195,"_26170":112511,"_2648":112557},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3150":65982,"_27660":65957,"_19192":112559,"_5":13195,"_26170":112511,"_2648":112560},[],"su clave pública corresponda a la clave privada del cliente;",{"_3150":65983,"_27660":65957,"_19192":112562,"_5":13195,"_26170":112511,"_2648":112563},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3150":65984,"_27660":65957,"_19192":112565,"_5":13195,"_26170":112511,"_2648":112566},[],"sus fechas y usos permitan la operación;",{"_3150":65985,"_27660":65957,"_19192":112568,"_5":13195,"_26170":112511,"_2648":112569},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3150":65986,"_27660":65957,"_19192":112571,"_5":13195,"_26170":112511,"_2648":112572},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3150":65987,"_27660":65957,"_19192":112574,"_5":13195,"_26170":112515,"_2648":112575},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":65988,"_27660":65957,"_19192":112577,"_5":13195,"_26170":112515,"_2648":112578},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3150":65989,"_27660":65957,"_19192":112580,"_5":13195,"_26170":112515,"_2648":112581},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3150":65990,"_27660":65990,"_5":13521,"_2648":112583,"_28003":112584,"_19192":112585,"_26170":65990},"Crea tu primera CA",[44970,107092,50046,110131],[],{"_3150":65991,"_27660":65990,"_19192":112587,"_5":13195,"_26170":65990,"_2648":112588},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3150":65992,"_27660":65990,"_5":28000,"_19192":112590,"_26170":112591,"_2648":105758},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3150":65993,"_27660":65990,"_5":28000,"_19192":112593,"_26170":112594,"_2648":112595},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3150":65994,"_27660":65990,"_5":28000,"_19192":112597,"_26170":112598,"_2648":112599},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3150":65995,"_27660":65990,"_5":28000,"_19192":112601,"_26170":112602,"_2648":112603},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3150":65996,"_27660":65990,"_5":28000,"_19192":112605,"_26170":112606,"_2648":112607},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3150":65997,"_27660":65990,"_5":28000,"_19192":112609,"_26170":112610,"_2648":112611},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3150":65998,"_27660":65990,"_5":28000,"_19192":112613,"_26170":112614,"_2648":112615},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3150":65999,"_27660":65990,"_5":28000,"_19192":112617,"_26170":112618,"_2648":110379},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3150":66000,"_27660":65990,"_5":28000,"_19192":112620,"_26170":112621,"_2648":105782},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3150":66001,"_27660":65990,"_19192":112623,"_5":13195,"_26170":65990,"_2648":112624},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3150":66002,"_27660":65990,"_19192":112626,"_5":13195,"_26170":112591,"_2648":112627},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3150":66003,"_27660":65990,"_19192":112629,"_5":13195,"_26170":112591,"_2648":112630},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3150":66004,"_27660":65990,"_19192":112632,"_5":13195,"_26170":112591,"_2648":112633},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3150":66005,"_27660":65990,"_19192":112635,"_5":13195,"_26170":112591,"_2648":112636},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3150":66006,"_27660":65990,"_19192":112638,"_5":13195,"_26170":112594,"_2648":112639},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3150":66007,"_27660":65990,"_19192":112641,"_5":13195,"_26170":112594,"_2648":112642},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3150":66008,"_27660":65990,"_19192":112644,"_5":13195,"_26170":112598,"_2648":112645},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3150":66009,"_27660":65990,"_19192":112647,"_5":13195,"_26170":112598,"_2648":112648},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3150":66010,"_27660":65990,"_19192":112650,"_5":13195,"_26170":112602,"_2648":112651},[],"Selecciona **Root CA** y completa:",{"_3150":66011,"_27660":65990,"_19192":112653,"_5":13195,"_26170":112602,"_2648":52045},[],{"_3150":66012,"_27660":65990,"_19192":112655,"_5":13195,"_26170":112602,"_2648":112656},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3150":66013,"_27660":65990,"_19192":112658,"_5":13195,"_26170":112602,"_2648":112659},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3150":66014,"_27660":65990,"_19192":112661,"_5":13195,"_26170":112602,"_2648":112662},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3150":66015,"_27660":65990,"_19192":112664,"_5":13195,"_26170":112602,"_2648":112665},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3150":66016,"_27660":65990,"_19192":112667,"_5":13195,"_26170":112606,"_2648":112668},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3150":66017,"_27660":65990,"_19192":112670,"_5":13195,"_26170":112610,"_2648":112671},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3150":66018,"_27660":65990,"_19192":112673,"_5":13195,"_26170":112610,"_2648":112674},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3150":66019,"_27660":65990,"_19192":112676,"_5":13195,"_26170":112614,"_2648":112677},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3150":66020,"_27660":65990,"_19192":112679,"_5":13195,"_26170":112614,"_2648":112680},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3150":66021,"_27660":65990,"_19192":112682,"_5":13195,"_26170":112614,"_2648":112683},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3150":66022,"_27660":65990,"_19192":112685,"_5":13195,"_26170":112618,"_2648":112686},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3150":66023,"_27660":65990,"_19192":112688,"_5":13195,"_26170":112618,"_2648":112689},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3150":66024,"_27660":65990,"_19192":112691,"_5":13195,"_26170":112618,"_2648":112692},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3150":66025,"_27660":65990,"_19192":112694,"_5":13195,"_26170":112618,"_2648":112695},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3150":66026,"_27660":65990,"_19192":112697,"_5":13195,"_26170":112621,"_2648":112698},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3150":66027,"_27660":66027,"_5":13521,"_2648":112700,"_28003":112701,"_19192":112702,"_26170":66027},"Emite y verifica un certificado",[44970,107092,50046,110131],[],{"_3150":66028,"_27660":66027,"_19192":112704,"_5":13195,"_26170":66027,"_2648":112705},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3150":66029,"_27660":66027,"_5":28000,"_19192":112707,"_26170":112708,"_2648":105758},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3150":66030,"_27660":66027,"_5":28000,"_19192":112710,"_26170":112711,"_2648":112712},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3150":66031,"_27660":66027,"_5":28000,"_19192":112714,"_26170":112715,"_2648":112716},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3150":66032,"_27660":66027,"_5":28000,"_19192":112718,"_26170":112719,"_2648":112720},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3150":66033,"_27660":66027,"_5":28000,"_19192":112722,"_26170":112723,"_2648":112724},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3150":66034,"_27660":66027,"_5":28000,"_19192":112726,"_26170":112727,"_2648":112728},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3150":66035,"_27660":66027,"_5":28000,"_19192":112730,"_26170":112731,"_2648":112611},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3150":66036,"_27660":66027,"_5":28000,"_19192":112733,"_26170":112734,"_2648":112735},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3150":66037,"_27660":66027,"_5":28000,"_19192":112737,"_26170":112738,"_2648":112739},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3150":66038,"_27660":66027,"_5":28000,"_19192":112741,"_26170":112742,"_2648":112743},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3150":66039,"_27660":66027,"_5":28000,"_19192":112745,"_26170":112746,"_2648":110379},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3150":66040,"_27660":66027,"_5":28000,"_19192":112748,"_26170":112749,"_2648":105782},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3150":66041,"_27660":66027,"_19192":112751,"_5":13195,"_26170":66027,"_2648":112752},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3150":66042,"_27660":66027,"_19192":112754,"_5":13195,"_26170":112708,"_2648":112755},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3150":66043,"_27660":66027,"_19192":112757,"_5":13195,"_26170":112708,"_2648":112758},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3150":66044,"_27660":66027,"_19192":112760,"_5":13195,"_26170":112708,"_2648":112761},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3150":66045,"_27660":66027,"_19192":112763,"_5":13195,"_26170":112708,"_2648":112764},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3150":66046,"_27660":66027,"_19192":112766,"_5":13195,"_26170":112708,"_2648":112767},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3150":66047,"_27660":66027,"_19192":112769,"_5":13195,"_26170":112711,"_2648":112770},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3150":66048,"_27660":66027,"_19192":112772,"_5":13195,"_26170":112715,"_2648":112773},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3150":66049,"_27660":66027,"_19192":112775,"_5":13195,"_26170":112715,"_2648":112776},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3150":66050,"_27660":66027,"_19192":112778,"_5":13195,"_26170":112719,"_2648":112779},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3150":66051,"_27660":66027,"_19192":112781,"_5":13195,"_26170":112719,"_2648":112782},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3150":66052,"_27660":66027,"_19192":112784,"_5":13195,"_26170":112723,"_2648":112785},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3150":66053,"_27660":66027,"_19192":112787,"_5":13195,"_26170":112723,"_2648":112788},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3150":66054,"_27660":66027,"_19192":112790,"_5":13195,"_26170":112727,"_2648":112791},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3150":66055,"_27660":66027,"_19192":112793,"_5":13195,"_26170":112731,"_2648":112794},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3150":66056,"_27660":66027,"_19192":112796,"_5":13195,"_26170":112734,"_2648":112797},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3150":66057,"_27660":66027,"_19192":112799,"_5":13195,"_26170":112738,"_2648":112800},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3150":66058,"_27660":66027,"_19192":112802,"_5":13195,"_26170":112738,"_2648":112803},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3150":66059,"_27660":66027,"_19192":112805,"_5":13195,"_26170":112738,"_2648":112806},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3150":66060,"_27660":66027,"_19192":112808,"_5":13195,"_26170":112742,"_2648":112809},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3150":66061,"_27660":66027,"_19192":112811,"_5":13195,"_26170":112742,"_2648":112812},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3150":66062,"_27660":66027,"_19192":112814,"_5":13195,"_26170":112742,"_2648":112815},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3150":66063,"_27660":66027,"_19192":112817,"_5":13195,"_26170":112746,"_2648":110462},[],{"_3150":66064,"_27660":66027,"_19192":112819,"_5":13195,"_26170":112746,"_2648":109229},[],{"_3150":66065,"_27660":66027,"_19192":112821,"_5":13195,"_26170":112746,"_2648":112822},[],"La CA rechaza la emisión",{"_3150":66066,"_27660":66027,"_19192":112824,"_5":13195,"_26170":112746,"_2648":112825},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3150":66067,"_27660":66027,"_19192":112827,"_5":13195,"_26170":112746,"_2648":112828},[],"Sujeto o usos diferentes",{"_3150":66068,"_27660":66027,"_19192":112830,"_5":13195,"_26170":112746,"_2648":112831},[],"Perfil aplicado y valores solicitados.",{"_3150":66069,"_27660":66027,"_19192":112833,"_5":13195,"_26170":112746,"_2648":112834},[],"No se encuentra el emisor",{"_3150":66070,"_27660":66027,"_19192":112836,"_5":13195,"_26170":112746,"_2648":112837},[],"CA descargada y cadena intermedia necesaria.",{"_3150":66071,"_27660":66027,"_19192":112839,"_5":13195,"_26170":112746,"_2648":112840},[],"Falla la vigencia",{"_3150":66072,"_27660":66027,"_19192":112842,"_5":13195,"_26170":112746,"_2648":112843},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3150":66073,"_27660":66027,"_19192":112845,"_5":13195,"_26170":112746,"_2648":112846},[],"Los resúmenes de clave difieren",{"_3150":66074,"_27660":66027,"_19192":112848,"_5":13195,"_26170":112746,"_2648":112849},[],"Archivos de certificado y clave de la misma emisión.",{"_3150":66075,"_27660":66027,"_19192":112851,"_5":13195,"_26170":112746,"_2648":112852},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3150":66076,"_27660":66027,"_19192":112854,"_5":13195,"_26170":112749,"_2648":112855},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3150":66077,"_27660":66027,"_19192":112857,"_5":13195,"_26170":112749,"_2648":112858},[],"Gestionar certificados para inspección, estado y revocación.",{"_3150":66078,"_27660":66027,"_19192":112860,"_5":13195,"_26170":112749,"_2648":112861},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3150":66079,"_27660":66027,"_19192":112863,"_5":13195,"_26170":112749,"_2648":112864},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3150":66080,"_27660":66027,"_19192":112866,"_5":13195,"_26170":112749,"_2648":112867},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3150":66081,"_27660":66081,"_5":13521,"_2648":112869,"_28003":112870,"_19192":112871,"_26170":66081},"Primeros pasos de PKI",[44970,107092,50046,110131],[],{"_3150":66082,"_27660":66081,"_19192":112873,"_5":13195,"_26170":66081,"_2648":112874},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3150":66083,"_27660":66081,"_5":28000,"_19192":112876,"_26170":112877,"_2648":105758},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3150":66084,"_27660":66081,"_5":28000,"_19192":112879,"_26170":112880,"_2648":112881},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3150":66085,"_27660":66081,"_5":28000,"_19192":112883,"_26170":112884,"_2648":110313},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3150":66086,"_27660":66081,"_5":28000,"_19192":112886,"_26170":112887,"_2648":112888},[],"/docs/pr-preview/pr-26/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3150":66087,"_27660":66081,"_19192":112890,"_5":13195,"_26170":66081,"_2648":112891},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3150":66088,"_27660":66081,"_19192":112893,"_5":13195,"_26170":112877,"_2648":112894},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3150":66089,"_27660":66081,"_19192":112896,"_5":13195,"_26170":112877,"_2648":112897},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3150":66090,"_27660":66081,"_19192":112899,"_5":13195,"_26170":112877,"_2648":112900},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3150":66091,"_27660":66081,"_19192":112902,"_5":13195,"_26170":112877,"_2648":112903},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3150":66092,"_27660":66081,"_19192":112905,"_5":13195,"_26170":112877,"_2648":112906},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3150":66093,"_27660":66081,"_19192":112908,"_5":13195,"_26170":112880,"_2648":112909},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3150":66094,"_27660":66081,"_19192":112911,"_5":13195,"_26170":112880,"_2648":112912},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3150":66095,"_27660":66081,"_19192":112914,"_5":13195,"_26170":112880,"_2648":112915},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3150":66096,"_27660":66081,"_19192":112917,"_5":13195,"_26170":112880,"_2648":112918},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3150":66097,"_27660":66081,"_19192":112920,"_5":13195,"_26170":112884,"_2648":112921},[],"Archivo o recurso",{"_3150":66098,"_27660":66081,"_19192":112923,"_5":13195,"_26170":112884,"_2648":110310},[],{"_3150":66099,"_27660":66081,"_19192":112925,"_5":13195,"_26170":112884,"_2648":112926},[],"CA raíz activa y `ca.pem`",{"_3150":66100,"_27660":66081,"_19192":112928,"_5":13195,"_26170":112884,"_2648":112929},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3150":66101,"_27660":66081,"_19192":112931,"_5":13195,"_26170":112884,"_2648":112932},[],"Certificado final y `device.crt`",{"_3150":66102,"_27660":66081,"_19192":112934,"_5":13195,"_26170":112884,"_2648":112935},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3150":66103,"_27660":66081,"_19192":112937,"_5":13195,"_26170":112884,"_2648":112938},[],"Clave privada `device.key`",{"_3150":66104,"_27660":66081,"_19192":112940,"_5":13195,"_26170":112884,"_2648":112941},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3150":66105,"_27660":66081,"_19192":112943,"_5":13195,"_26170":112884,"_2648":112944},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3150":66106,"_27660":66081,"_19192":112946,"_5":13195,"_26170":112887,"_2648":112947},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3150":66107,"_27660":66081,"_19192":112949,"_5":13195,"_26170":112887,"_2648":112950},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3150":66108,"_27660":66081,"_19192":112952,"_5":13195,"_26170":112887,"_2648":112953},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3150":66109,"_27660":66109,"_5":13521,"_2648":112955,"_28003":112956,"_19192":112958,"_26170":66109},"Resolución de problemas PKI",[44970,107092,50046,112957],"Resolución de problemas",[],{"_3150":66110,"_27660":66109,"_19192":112960,"_5":13195,"_26170":66109,"_2648":112961},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3150":66111,"_27660":66109,"_5":28000,"_19192":112963,"_26170":112964,"_2648":112965},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3150":66112,"_27660":66109,"_5":28000,"_19192":112967,"_26170":112968,"_2648":112969},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3150":66113,"_27660":66109,"_5":28000,"_19192":112971,"_26170":112972,"_2648":112973},[],"/docs/pr-preview/pr-26/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3150":66114,"_27660":66109,"_19192":112975,"_5":13195,"_26170":66109,"_2648":112976},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3150":66115,"_27660":66109,"_19192":112978,"_5":13195,"_26170":66109,"_2648":112979},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3150":66116,"_27660":66109,"_19192":112981,"_5":13195,"_26170":112964,"_2648":110310},[],{"_3150":66117,"_27660":66109,"_19192":112983,"_5":13195,"_26170":112964,"_2648":109229},[],{"_3150":66118,"_27660":66109,"_19192":112985,"_5":13195,"_26170":112964,"_2648":105782},[],{"_3150":66119,"_27660":66109,"_19192":112987,"_5":13195,"_26170":112964,"_2648":52381},[],{"_3150":66120,"_27660":66109,"_19192":112989,"_5":13195,"_26170":112964,"_2648":112990},[],"Existe, está activa y sus fechas son utilizables.",{"_3150":66121,"_27660":66109,"_19192":112992,"_5":13195,"_26170":112964,"_2648":112993},[],"Autoridades.",{"_3150":66122,"_27660":66109,"_19192":112995,"_5":13195,"_26170":112964,"_2648":112996},[],"Clave",{"_3150":66123,"_27660":66109,"_19192":112998,"_5":13195,"_26170":112964,"_2648":112999},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3150":66124,"_27660":66109,"_19192":113001,"_5":13195,"_26170":112964,"_2648":113002},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3150":66125,"_27660":66109,"_19192":113004,"_5":13195,"_26170":112964,"_2648":52399},[],{"_3150":66126,"_27660":66109,"_19192":113006,"_5":13195,"_26170":112964,"_2648":113007},[],"PEM correcto y firma verificable.",{"_3150":66127,"_27660":66109,"_19192":113009,"_5":13195,"_26170":112964,"_2648":52405},[],{"_3150":66128,"_27660":66109,"_19192":113011,"_5":13195,"_26170":112964,"_2648":113012},[],"Perfil",{"_3150":66129,"_27660":66109,"_19192":113014,"_5":13195,"_26170":112964,"_2648":113015},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3150":66130,"_27660":66109,"_19192":113017,"_5":13195,"_26170":112964,"_2648":113018},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3150":66131,"_27660":66109,"_19192":113020,"_5":13195,"_26170":112964,"_2648":110462},[],{"_3150":66132,"_27660":66109,"_19192":113022,"_5":13195,"_26170":112964,"_2648":113023},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3150":66133,"_27660":66109,"_19192":113025,"_5":13195,"_26170":112964,"_2648":113026},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3150":66134,"_27660":66109,"_19192":113028,"_5":13195,"_26170":112964,"_2648":113029},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3150":66135,"_27660":66109,"_19192":113031,"_5":13195,"_26170":112964,"_2648":113032},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3150":66136,"_27660":66109,"_19192":113034,"_5":13195,"_26170":112968,"_2648":113035},[],"Revisa cada frontera por separado:",{"_3150":66137,"_27660":66109,"_19192":113037,"_5":13195,"_26170":112968,"_2648":113038},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3150":66138,"_27660":66109,"_19192":113040,"_5":13195,"_26170":112968,"_2648":113041},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3150":66139,"_27660":66109,"_19192":113043,"_5":13195,"_26170":112968,"_2648":113044},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3150":66140,"_27660":66109,"_19192":113046,"_5":13195,"_26170":112968,"_2648":113047},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3150":66141,"_27660":66109,"_19192":113049,"_5":13195,"_26170":112968,"_2648":113050},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3150":66142,"_27660":66109,"_19192":113052,"_5":13195,"_26170":112968,"_2648":113053},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3150":66143,"_27660":66109,"_19192":113055,"_5":13195,"_26170":112972,"_2648":113056},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3150":66144,"_27660":66109,"_19192":113058,"_5":13195,"_26170":112972,"_2648":113059},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3150":66145,"_27660":66145,"_5":13521,"_2648":113061,"_28003":113062,"_19192":113064,"_26170":66145},"3.8.0 a 4.0.0",[44970,113063],"Actualizaciones",[],{"_3150":66146,"_27660":66145,"_19192":113066,"_5":13195,"_26170":66145,"_2648":113067},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3150":66147,"_27660":66145,"_5":28000,"_19192":113069,"_26170":113070,"_2648":113071},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3150":66148,"_27660":66145,"_5":28000,"_19192":113073,"_26170":113074,"_2648":113075},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3150":66149,"_27660":66145,"_5":28000,"_19192":113077,"_26170":113078,"_2648":113079},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3150":66150,"_27660":66145,"_5":28000,"_19192":113081,"_26170":113082,"_2648":113083},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3150":66151,"_27660":66145,"_5":28000,"_19192":113085,"_26170":113086,"_2648":113087},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3150":66152,"_27660":66145,"_5":28000,"_19192":113089,"_26170":113090,"_2648":113091},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3150":66153,"_27660":66145,"_5":28000,"_19192":113093,"_26170":113094,"_2648":52491},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3150":66154,"_27660":66145,"_5":28000,"_19192":113096,"_26170":113097,"_2648":113098},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3150":66155,"_27660":66145,"_5":28000,"_19192":113100,"_26170":113101,"_2648":113102},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3150":66156,"_27660":66145,"_5":28000,"_19192":113104,"_26170":113105,"_2648":113106},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3150":66157,"_27660":66145,"_5":28000,"_19192":113108,"_26170":113109,"_2648":113110},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3150":66158,"_27660":66145,"_5":28000,"_19192":113112,"_26170":113113,"_2648":113114},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3150":66159,"_27660":66145,"_5":28000,"_19192":113116,"_26170":113117,"_2648":113118},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3150":66160,"_27660":66145,"_5":28000,"_19192":113120,"_26170":113121,"_2648":113122},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3150":66161,"_27660":66145,"_5":28000,"_19192":113124,"_26170":113125,"_2648":113126},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3150":66162,"_27660":66145,"_5":28000,"_19192":113128,"_26170":113129,"_2648":113130},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3150":66163,"_27660":66145,"_5":28000,"_19192":113132,"_26170":113133,"_2648":113134},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3150":66164,"_27660":66145,"_5":28000,"_19192":113136,"_26170":113137,"_2648":113138},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3150":66165,"_27660":66145,"_5":28000,"_19192":113140,"_26170":113141,"_2648":113142},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3150":66166,"_27660":66145,"_5":28000,"_19192":113144,"_26170":113145,"_2648":113146},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3150":66167,"_27660":66145,"_5":28000,"_19192":113148,"_26170":113149,"_2648":113150},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3150":66168,"_27660":66145,"_5":28000,"_19192":113152,"_26170":113153,"_2648":113154},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3150":66169,"_27660":66145,"_5":28000,"_19192":113156,"_26170":113157,"_2648":113158},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3150":66170,"_27660":66145,"_5":28000,"_19192":113160,"_26170":113161,"_2648":113162},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3150":66171,"_27660":66145,"_5":28000,"_19192":113164,"_26170":113165,"_2648":113166},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3150":66172,"_27660":66145,"_5":28000,"_19192":113168,"_26170":113169,"_2648":113170},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3150":66173,"_27660":66145,"_5":28000,"_19192":113172,"_26170":113173,"_2648":113174},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3150":66174,"_27660":66145,"_5":28000,"_19192":113176,"_26170":113177,"_2648":113178},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3150":66175,"_27660":66145,"_5":28000,"_19192":113180,"_26170":113181,"_2648":113182},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3150":66176,"_27660":66145,"_5":28000,"_19192":113184,"_26170":113185,"_2648":113186},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3150":66177,"_27660":66145,"_5":28000,"_19192":113188,"_26170":113189,"_2648":113190},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3150":66178,"_27660":66145,"_5":28000,"_19192":113192,"_26170":113193,"_2648":113194},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3150":66179,"_27660":66145,"_5":28000,"_19192":113196,"_26170":113197,"_2648":113198},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3150":66180,"_27660":66145,"_5":28000,"_19192":113200,"_26170":113201,"_2648":109551},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3150":66181,"_27660":66145,"_5":28000,"_19192":113203,"_26170":113204,"_2648":113205},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3150":66182,"_27660":66145,"_5":28000,"_19192":113207,"_26170":113208,"_2648":113209},[],"/docs/pr-preview/pr-26/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3150":66183,"_27660":66145,"_19192":113211,"_5":13195,"_26170":66145,"_2648":113212},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3150":66184,"_27660":66145,"_19192":113214,"_5":13195,"_26170":66145,"_2648":113215},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3150":66185,"_27660":66145,"_19192":113217,"_5":13195,"_26170":66145,"_2648":113218},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3150":66186,"_27660":66145,"_19192":113220,"_5":13195,"_26170":66145,"_2648":113221},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3150":66187,"_27660":66145,"_19192":113223,"_5":13195,"_26170":66145,"_2648":113224},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3150":66188,"_27660":66145,"_19192":113226,"_5":13195,"_26170":66145,"_2648":113227},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3150":66189,"_27660":66145,"_19192":113229,"_5":13195,"_26170":66145,"_2648":113230},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3150":66190,"_27660":66145,"_19192":113232,"_5":13195,"_26170":113074,"_2648":113233},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3150":66191,"_27660":66145,"_19192":113235,"_5":13195,"_26170":113074,"_2648":113236},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3150":66192,"_27660":66145,"_19192":113238,"_5":13195,"_26170":113078,"_2648":113239},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3150":66193,"_27660":66145,"_19192":113241,"_5":13195,"_26170":113078,"_2648":113242},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3150":66194,"_27660":66145,"_19192":113244,"_5":13195,"_26170":113082,"_2648":113245},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3150":66195,"_27660":66145,"_19192":113247,"_5":13195,"_26170":113086,"_2648":113248},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3150":66196,"_27660":66145,"_19192":113250,"_5":13195,"_26170":113086,"_2648":113251},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3150":66197,"_27660":66145,"_19192":113253,"_5":13195,"_26170":113086,"_2648":113254},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3150":66198,"_27660":66145,"_19192":113256,"_5":13195,"_26170":113086,"_2648":113257},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3150":66199,"_27660":66145,"_19192":113259,"_5":13195,"_26170":113086,"_2648":113260},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3150":66200,"_27660":66145,"_19192":113262,"_5":13195,"_26170":113090,"_2648":113263},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3150":66201,"_27660":66145,"_19192":113265,"_5":13195,"_26170":113090,"_2648":113266},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3150":66202,"_27660":66145,"_19192":113268,"_5":13195,"_26170":113090,"_2648":113269},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3150":66203,"_27660":66145,"_19192":113271,"_5":13195,"_26170":113090,"_2648":113272},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3150":66204,"_27660":66145,"_19192":113274,"_5":13195,"_26170":113090,"_2648":113275},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3150":66205,"_27660":66145,"_19192":113277,"_5":13195,"_26170":113094,"_2648":113278},[],"Cambio",{"_3150":66206,"_27660":66145,"_19192":113280,"_5":13195,"_26170":113094,"_2648":113281},[],"A quién afecta",{"_3150":66207,"_27660":66145,"_19192":113283,"_5":13195,"_26170":113094,"_2648":113284},[],"Gravedad",{"_3150":66208,"_27660":66145,"_19192":113286,"_5":13195,"_26170":113094,"_2648":113287},[],"Acción",{"_3150":66209,"_27660":66145,"_19192":113289,"_5":13195,"_26170":113094,"_2648":113102},[],{"_3150":66210,"_27660":66145,"_19192":113291,"_5":13195,"_26170":113094,"_2648":113292},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3150":66211,"_27660":66145,"_19192":113294,"_5":13195,"_26170":113094,"_2648":113295},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3150":66212,"_27660":66145,"_19192":113297,"_5":13195,"_26170":113094,"_2648":113298},[],"Copiar los datos a los volúmenes nuevos",{"_3150":66213,"_27660":66145,"_19192":113300,"_5":13195,"_26170":113094,"_2648":113106},[],{"_3150":66214,"_27660":66145,"_19192":113302,"_5":13195,"_26170":113094,"_2648":113303},[],"Todas las releases de Helm",{"_3150":66215,"_27660":66145,"_19192":113305,"_5":13195,"_26170":113094,"_2648":113306},[],"Alta: `helm upgrade` falla",{"_3150":66216,"_27660":66145,"_19192":113308,"_5":13195,"_26170":113094,"_2648":113309},[],"Eliminar o renombrar las claves heredadas",{"_3150":66217,"_27660":66145,"_19192":113311,"_5":13195,"_26170":113094,"_2648":113110},[],{"_3150":66218,"_27660":66145,"_19192":113313,"_5":13195,"_26170":113094,"_2648":113314},[],"Todos los despliegues",{"_3150":66219,"_27660":66145,"_19192":113316,"_5":13195,"_26170":113094,"_2648":113317},[],"Alta: sin principal de bootstrap no hay administrador",{"_3150":66220,"_27660":66145,"_19192":113319,"_5":13195,"_26170":113094,"_2648":113320},[],"Configurar `services.authz`",{"_3150":66221,"_27660":66145,"_19192":113322,"_5":13195,"_26170":113094,"_2648":113114},[],{"_3150":66222,"_27660":66145,"_19192":113324,"_5":13195,"_26170":113094,"_2648":113303},[],{"_3150":66223,"_27660":66145,"_19192":113326,"_5":13195,"_26170":113094,"_2648":113327},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3150":66224,"_27660":66145,"_19192":113329,"_5":13195,"_26170":113094,"_2648":113330},[],"Mover JWKS y roles a `services.authz`",{"_3150":66225,"_27660":66145,"_19192":113332,"_5":13195,"_26170":113094,"_2648":113134},[],{"_3150":66226,"_27660":66145,"_19192":113334,"_5":13195,"_26170":113094,"_2648":113335},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3150":66227,"_27660":66145,"_19192":113337,"_5":13195,"_26170":113094,"_2648":113338},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3150":66228,"_27660":66145,"_19192":113340,"_5":13195,"_26170":113094,"_2648":113341},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3150":66229,"_27660":66145,"_19192":113343,"_5":13195,"_26170":113094,"_2648":113138},[],{"_3150":66230,"_27660":66145,"_19192":113345,"_5":13195,"_26170":113094,"_2648":113346},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3150":66231,"_27660":66145,"_19192":113348,"_5":13195,"_26170":113094,"_2648":113349},[],"Alta: el backend ya no arranca con ellos",{"_3150":66232,"_27660":66145,"_19192":113351,"_5":13195,"_26170":113094,"_2648":113352},[],"Pasar a PostgreSQL antes de actualizar",{"_3150":66233,"_27660":66145,"_19192":113354,"_5":13195,"_26170":113094,"_2648":113355},[],"Webhooks con referencias a archivos",{"_3150":66234,"_27660":66145,"_19192":113357,"_5":13195,"_26170":113094,"_2648":113358},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3150":66235,"_27660":66145,"_19192":113360,"_5":13195,"_26170":113094,"_2648":113361},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3150":66236,"_27660":66145,"_19192":113363,"_5":13195,"_26170":113094,"_2648":113364},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3150":66237,"_27660":66145,"_19192":113366,"_5":13195,"_26170":113094,"_2648":113118},[],{"_3150":66238,"_27660":66145,"_19192":113368,"_5":13195,"_26170":113094,"_2648":113369},[],"Releases con identidades por servicio o material de claves montado",{"_3150":66239,"_27660":66145,"_19192":113371,"_5":13195,"_26170":113094,"_2648":113372},[],"Media: los servicios no pueden leer sus archivos",{"_3150":66240,"_27660":66145,"_19192":113374,"_5":13195,"_26170":113094,"_2648":113375},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3150":66241,"_27660":66145,"_19192":113377,"_5":13195,"_26170":113094,"_2648":113122},[],{"_3150":66242,"_27660":66145,"_19192":113379,"_5":13195,"_26170":113094,"_2648":113380},[],"Releases que definen `amqp.tls`",{"_3150":66243,"_27660":66145,"_19192":113382,"_5":13195,"_26170":113094,"_2648":113383},[],"Media: los clientes se conectan al puerto equivocado",{"_3150":66244,"_27660":66145,"_19192":113385,"_5":13195,"_26170":113094,"_2648":113386},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3150":66245,"_27660":66145,"_19192":113388,"_5":13195,"_26170":113094,"_2648":113142},[],{"_3150":66246,"_27660":66145,"_19192":113390,"_5":13195,"_26170":113094,"_2648":113391},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3150":66247,"_27660":66145,"_19192":113393,"_5":13195,"_26170":113094,"_2648":113394},[],"Media: las claves de CA quedan sin gestionar",{"_3150":66248,"_27660":66145,"_19192":113396,"_5":13195,"_26170":113094,"_2648":113397},[],"Ejecutar la migración de CA a KMS",{"_3150":66249,"_27660":66145,"_19192":113399,"_5":13195,"_26170":113094,"_2648":113400},[],"Verificación del certificado del receptor",{"_3150":66250,"_27660":66145,"_19192":113402,"_5":13195,"_26170":113094,"_2648":113403},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3150":66251,"_27660":66145,"_19192":113405,"_5":13195,"_26170":113094,"_2648":113406},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3150":66252,"_27660":66145,"_19192":113408,"_5":13195,"_26170":113094,"_2648":113409},[],"Poner `insecure_skip_verify` a `false`",{"_3150":66253,"_27660":66145,"_19192":113411,"_5":13195,"_26170":113094,"_2648":113154},[],{"_3150":66254,"_27660":66145,"_19192":113413,"_5":13195,"_26170":113094,"_2648":113414},[],"Scripts y consolas que editan DMS por API",{"_3150":66255,"_27660":66145,"_19192":113416,"_5":13195,"_26170":113094,"_2648":113417},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3150":66256,"_27660":66145,"_19192":113419,"_5":13195,"_26170":113094,"_2648":113420},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3150":66257,"_27660":66145,"_19192":113422,"_5":13195,"_26170":113094,"_2648":113170},[],{"_3150":66258,"_27660":66145,"_19192":113424,"_5":13195,"_26170":113094,"_2648":113425},[],"Consumidores que leen el campo `events` del dispositivo",{"_3150":66259,"_27660":66145,"_19192":113427,"_5":13195,"_26170":113094,"_2648":113428},[],"Media: el campo desaparece",{"_3150":66260,"_27660":66145,"_19192":113430,"_5":13195,"_26170":113094,"_2648":113431},[],"Usar los nuevos endpoints de eventos",{"_3150":66261,"_27660":66145,"_19192":113433,"_5":13195,"_26170":113094,"_2648":113126},[],{"_3150":66262,"_27660":66145,"_19192":113435,"_5":13195,"_26170":113094,"_2648":113436},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3150":66263,"_27660":66145,"_19192":113438,"_5":13195,"_26170":113094,"_2648":113439},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3150":66264,"_27660":66145,"_19192":113441,"_5":13195,"_26170":113094,"_2648":113442},[],"Actualizar el archivo de values",{"_3150":66265,"_27660":66145,"_19192":113444,"_5":13195,"_26170":113094,"_2648":113162},[],{"_3150":66266,"_27660":66145,"_19192":113446,"_5":13195,"_26170":113094,"_2648":113447},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3150":66267,"_27660":66145,"_19192":113449,"_5":13195,"_26170":113094,"_2648":113450},[],"Baja: prevalece el ID de la URL",{"_3150":66268,"_27660":66145,"_19192":113452,"_5":13195,"_26170":113094,"_2648":113453},[],"Enviar el ID en la URL",{"_3150":66269,"_27660":66145,"_19192":113455,"_5":13195,"_26170":113094,"_2648":113166},[],{"_3150":66270,"_27660":66145,"_19192":113457,"_5":13195,"_26170":113094,"_2648":113458},[],"Consumidores que comparan el `type` del certificado",{"_3150":66271,"_27660":66145,"_19192":113460,"_5":13195,"_26170":113094,"_2648":113461},[],"Baja: dos valores cambian de nombre",{"_3150":66272,"_27660":66145,"_19192":113463,"_5":13195,"_26170":113094,"_2648":113464},[],"Adaptar los consumidores",{"_3150":66273,"_27660":66145,"_19192":113466,"_5":13195,"_26170":113094,"_2648":113158},[],{"_3150":66274,"_27660":66145,"_19192":113468,"_5":13195,"_26170":113094,"_2648":113469},[],"Cualquier DMS",{"_3150":66275,"_27660":66145,"_19192":113471,"_5":13195,"_26170":113094,"_2648":113472},[],"Baja: solo informativo",{"_3150":66276,"_27660":66145,"_19192":113474,"_5":13195,"_26170":113094,"_2648":113475},[],"Revisar ambos bloques antes de editar",{"_3150":66277,"_27660":66145,"_19192":113477,"_5":13195,"_26170":113101,"_2648":113478},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3150":66278,"_27660":66145,"_19192":113480,"_5":13195,"_26170":113101,"_2648":113481},[],"El paso 4 de la guía de migración copia los datos.",{"_3150":66279,"_27660":66145,"_19192":113483,"_5":13195,"_26170":113105,"_2648":113484},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3150":66280,"_27660":66145,"_19192":113486,"_5":13195,"_26170":113109,"_2648":113487},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3150":66281,"_27660":66145,"_19192":113489,"_5":13195,"_26170":113113,"_2648":113490},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3150":66282,"_27660":66145,"_19192":113492,"_5":13195,"_26170":113117,"_2648":113493},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3150":66283,"_27660":66145,"_19192":113495,"_5":13195,"_26170":113117,"_2648":113496},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3150":66284,"_27660":66145,"_19192":113498,"_5":13195,"_26170":113121,"_2648":113499},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3150":66285,"_27660":66145,"_19192":113501,"_5":13195,"_26170":113125,"_2648":113502},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3150":66286,"_27660":66145,"_19192":113504,"_5":13195,"_26170":113125,"_2648":113505},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3150":66287,"_27660":66145,"_19192":113507,"_5":13195,"_26170":113125,"_2648":113508},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3150":66288,"_27660":66145,"_19192":113510,"_5":13195,"_26170":113125,"_2648":113511},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3150":66289,"_27660":66145,"_19192":113513,"_5":13195,"_26170":113125,"_2648":113514},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3150":66290,"_27660":66145,"_19192":113516,"_5":13195,"_26170":113125,"_2648":113517},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3150":66291,"_27660":66145,"_19192":113519,"_5":13195,"_26170":113133,"_2648":113520},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3150":66292,"_27660":66145,"_19192":113522,"_5":13195,"_26170":113133,"_2648":113523},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3150":66293,"_27660":66145,"_19192":113525,"_5":13195,"_26170":113133,"_2648":113526},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3150":66294,"_27660":66145,"_19192":113528,"_5":13195,"_26170":113133,"_2648":113529},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3150":66295,"_27660":66145,"_19192":113531,"_5":13195,"_26170":113133,"_2648":113532},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3150":66296,"_27660":66145,"_19192":113534,"_5":13195,"_26170":113137,"_2648":113535},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3150":66297,"_27660":66145,"_19192":113537,"_5":13195,"_26170":113141,"_2648":113538},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3150":66298,"_27660":66145,"_19192":113540,"_5":13195,"_26170":113141,"_2648":113541},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3150":66299,"_27660":66145,"_19192":113543,"_5":13195,"_26170":113141,"_2648":113544},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3150":66300,"_27660":66145,"_19192":113546,"_5":13195,"_26170":113141,"_2648":113547},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3150":66301,"_27660":66145,"_19192":113549,"_5":13195,"_26170":113141,"_2648":113550},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3150":66302,"_27660":66145,"_19192":113552,"_5":13195,"_26170":113141,"_2648":113553},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3150":66303,"_27660":66145,"_19192":113555,"_5":13195,"_26170":113149,"_2648":113556},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3150":66304,"_27660":66145,"_19192":113558,"_5":13195,"_26170":113149,"_2648":113559},[],"Campo en 3.8.0",{"_3150":66305,"_27660":66145,"_19192":113561,"_5":13195,"_26170":113149,"_2648":113562},[],"Campo en 4.0.0",{"_3150":66306,"_27660":66145,"_19192":113564,"_5":13195,"_26170":113149,"_2648":52962},[],{"_3150":66307,"_27660":66145,"_19192":113566,"_5":13195,"_26170":113149,"_2648":113567},[],"`insecure_skip_verify` (con el valor negado)",{"_3150":66308,"_27660":66145,"_19192":113569,"_5":13195,"_26170":113149,"_2648":52968},[],{"_3150":66309,"_27660":66145,"_19192":113571,"_5":13195,"_26170":113149,"_2648":52971},[],{"_3150":66310,"_27660":66145,"_19192":113573,"_5":13195,"_26170":113149,"_2648":52974},[],{"_3150":66311,"_27660":66145,"_19192":113575,"_5":13195,"_26170":113149,"_2648":52977},[],{"_3150":66312,"_27660":66145,"_19192":113577,"_5":13195,"_26170":113149,"_2648":52980},[],{"_3150":66313,"_27660":66145,"_19192":113579,"_5":13195,"_26170":113149,"_2648":52983},[],{"_3150":66314,"_27660":66145,"_19192":113581,"_5":13195,"_26170":113149,"_2648":113582},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3150":66315,"_27660":66145,"_19192":113584,"_5":13195,"_26170":113149,"_2648":113585},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3150":66316,"_27660":66145,"_19192":113587,"_5":13195,"_26170":113149,"_2648":113588},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3150":66317,"_27660":66145,"_19192":113590,"_5":13195,"_26170":113153,"_2648":113591},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3150":66318,"_27660":66145,"_19192":113593,"_5":13195,"_26170":113153,"_2648":113594},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3150":66319,"_27660":66145,"_19192":113596,"_5":13195,"_26170":113153,"_2648":113597},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3150":66320,"_27660":66145,"_19192":113599,"_5":13195,"_26170":113157,"_2648":113600},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. Si la versión de la consola no expone los ajustes independientes, edítalos mediante la API DMS.",{"_3150":66321,"_27660":66145,"_19192":113602,"_5":13195,"_26170":113161,"_2648":113603},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3150":66322,"_27660":66145,"_19192":113605,"_5":13195,"_26170":113165,"_2648":113606},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3150":66323,"_27660":66145,"_19192":113608,"_5":13195,"_26170":113169,"_2648":113609},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3150":66324,"_27660":66145,"_19192":113611,"_5":13195,"_26170":113169,"_2648":113612},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3150":66325,"_27660":66145,"_19192":113614,"_5":13195,"_26170":113169,"_2648":113615},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3150":66326,"_27660":66145,"_19192":113617,"_5":13195,"_26170":113169,"_2648":113618},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3150":66327,"_27660":66145,"_19192":113620,"_5":13195,"_26170":113173,"_2648":113621},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3150":66328,"_27660":66145,"_19192":113623,"_5":13195,"_26170":113177,"_2648":113624},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3150":66329,"_27660":66145,"_19192":113626,"_5":13195,"_26170":113177,"_2648":113627},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3150":66330,"_27660":66145,"_19192":113629,"_5":13195,"_26170":113177,"_2648":113630},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3150":66331,"_27660":66145,"_19192":113632,"_5":13195,"_26170":113177,"_2648":113633},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3150":66332,"_27660":66145,"_19192":113635,"_5":13195,"_26170":113177,"_2648":113636},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3150":66333,"_27660":66145,"_19192":113638,"_5":13195,"_26170":113181,"_2648":113639},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3150":66334,"_27660":66145,"_19192":113641,"_5":13195,"_26170":113181,"_2648":113642},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3150":66335,"_27660":66145,"_19192":113644,"_5":13195,"_26170":113181,"_2648":113645},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3150":66336,"_27660":66145,"_19192":113647,"_5":13195,"_26170":113181,"_2648":113648},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3150":66337,"_27660":66145,"_19192":113650,"_5":13195,"_26170":113181,"_2648":113651},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3150":66338,"_27660":66145,"_19192":113653,"_5":13195,"_26170":113181,"_2648":113654},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3150":66339,"_27660":66145,"_19192":113656,"_5":13195,"_26170":113181,"_2648":113657},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3150":66340,"_27660":66145,"_19192":113659,"_5":13195,"_26170":113181,"_2648":113660},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3150":66341,"_27660":66145,"_19192":113662,"_5":13195,"_26170":113181,"_2648":113663},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3150":66342,"_27660":66145,"_19192":113665,"_5":13195,"_26170":113181,"_2648":113666},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3150":66343,"_27660":66145,"_19192":113668,"_5":13195,"_26170":113181,"_2648":113669},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3150":66344,"_27660":66145,"_19192":113671,"_5":13195,"_26170":113181,"_2648":113672},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3150":66345,"_27660":66145,"_19192":113674,"_5":13195,"_26170":113185,"_2648":113675},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3150":66346,"_27660":66145,"_19192":113677,"_5":13195,"_26170":113185,"_2648":113678},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3150":66347,"_27660":66145,"_19192":113680,"_5":13195,"_26170":113189,"_2648":113681},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3150":66348,"_27660":66145,"_19192":113683,"_5":13195,"_26170":113189,"_2648":113684},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3150":66349,"_27660":66145,"_19192":113686,"_5":13195,"_26170":113189,"_2648":113687},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3150":66350,"_27660":66145,"_19192":113689,"_5":13195,"_26170":113189,"_2648":113690},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3150":66351,"_27660":66145,"_19192":113692,"_5":13195,"_26170":113189,"_2648":113693},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3150":66352,"_27660":66145,"_19192":113695,"_5":13195,"_26170":113189,"_2648":113696},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3150":66353,"_27660":66145,"_19192":113698,"_5":13195,"_26170":113189,"_2648":113699},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3150":66354,"_27660":66145,"_19192":113701,"_5":13195,"_26170":113189,"_2648":113702},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3150":66355,"_27660":66145,"_19192":113704,"_5":13195,"_26170":113189,"_2648":113705},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3150":66356,"_27660":66145,"_19192":113707,"_5":13195,"_26170":113189,"_2648":113708},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3150":66357,"_27660":66145,"_19192":113710,"_5":13195,"_26170":113189,"_2648":113711},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3150":66358,"_27660":66145,"_19192":113713,"_5":13195,"_26170":113193,"_2648":113714},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3150":66359,"_27660":66145,"_19192":113716,"_5":13195,"_26170":113193,"_2648":113717},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3150":66360,"_27660":66145,"_19192":113719,"_5":13195,"_26170":113197,"_2648":113720},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3150":66361,"_27660":66145,"_19192":113722,"_5":13195,"_26170":113197,"_2648":113723},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3150":66362,"_27660":66145,"_19192":113725,"_5":13195,"_26170":113197,"_2648":113726},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3150":66363,"_27660":66145,"_19192":113728,"_5":13195,"_26170":113197,"_2648":113729},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3150":66364,"_27660":66145,"_19192":113731,"_5":13195,"_26170":113197,"_2648":113732},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3150":66365,"_27660":66145,"_19192":113734,"_5":13195,"_26170":113201,"_2648":113735},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3150":66366,"_27660":66145,"_19192":113737,"_5":13195,"_26170":113201,"_2648":113738},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3150":66367,"_27660":66145,"_19192":113740,"_5":13195,"_26170":113201,"_2648":113741},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3150":66368,"_27660":66145,"_19192":113743,"_5":13195,"_26170":113201,"_2648":113744},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3150":66369,"_27660":66145,"_19192":113746,"_5":13195,"_26170":113201,"_2648":113747},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3150":66370,"_27660":66145,"_19192":113749,"_5":13195,"_26170":113201,"_2648":113750},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3150":66371,"_27660":66145,"_19192":113752,"_5":13195,"_26170":113201,"_2648":113753},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3150":66372,"_27660":66145,"_19192":113755,"_5":13195,"_26170":113204,"_2648":113756},[],"Tras la actualización, comprueba en este orden:",{"_3150":66373,"_27660":66145,"_19192":113758,"_5":13195,"_26170":113204,"_2648":113759},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3150":66374,"_27660":66145,"_19192":113761,"_5":13195,"_26170":113204,"_2648":113762},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3150":66375,"_27660":66145,"_19192":113764,"_5":13195,"_26170":113204,"_2648":113765},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3150":66376,"_27660":66145,"_19192":113767,"_5":13195,"_26170":113204,"_2648":113768},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3150":66377,"_27660":66145,"_19192":113770,"_5":13195,"_26170":113204,"_2648":113771},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3150":66378,"_27660":66145,"_19192":113773,"_5":13195,"_26170":113204,"_2648":113774},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3150":66379,"_27660":66145,"_19192":113776,"_5":13195,"_26170":113204,"_2648":113777},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3150":66380,"_27660":66145,"_19192":113779,"_5":13195,"_26170":113204,"_2648":113780},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3150":66381,"_27660":66145,"_19192":113782,"_5":13195,"_26170":113204,"_2648":113783},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3150":66382,"_27660":66145,"_19192":113785,"_5":13195,"_26170":113204,"_2648":113786},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3150":66383,"_27660":66145,"_19192":113788,"_5":13195,"_26170":113204,"_2648":113789},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3150":66384,"_27660":66145,"_19192":113791,"_5":13195,"_26170":113204,"_2648":113792},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3150":66385,"_27660":66145,"_19192":113794,"_5":13195,"_26170":113204,"_2648":113795},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3150":66386,"_27660":66145,"_19192":113797,"_5":13195,"_26170":113204,"_2648":113798},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3150":66387,"_27660":66145,"_19192":113800,"_5":13195,"_26170":113208,"_2648":113801},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3150":66388,"_27660":66145,"_19192":113803,"_5":13195,"_26170":113208,"_2648":113804},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3150":66389,"_27660":66145,"_19192":113806,"_5":13195,"_26170":113208,"_2648":113807},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":66390,"_27660":66145,"_19192":113809,"_5":13195,"_26170":113208,"_2648":113810},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3150":66391,"_27660":66145,"_19192":113812,"_5":13195,"_26170":113208,"_2648":113813},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53220":113815,"_53222":113816,"_53224":113817,"_53226":113818,"_16733":2670,"_63757":2670},"spanish",[2648,27660,5,26170],{"_2648":22952,"_27660":22952,"_5":22952,"_26170":22952},{"_2648":113819,"_27660":116450,"_5":119081,"_26170":121712},{"_4214":113820,"_53230":113821,"_5":22952},{"_13250":3855,"_13620":2946,"_13627":5383,"_11891":9326,"_26296":9920,"_18221":5396,"_13271":4593,"_13278":5278,"_26723":6953,"_27110":6901,"_27131":5285,"_26741":5628,"_31767":14235,"_27142":3092,"_27171":2697,"_31774":6749,"_31777":3802,"_31780":5954,"_31783":2916,"_27519":3117,"_31788":7814,"_31790":5272,"_27549":5275,"_27509":6298,"_31794":14474,"_27718":13212,"_31798":4329,"_27160":17804,"_27514":7585,"_27573":5505,"_31803":5562,"_31805":2723,"_31807":6385,"_31809":5934,"_31811":4681,"_31813":3679,"_31815":14849,"_31817":7064,"_31819":3018,"_26794":6343,"_31822":2981,"_31824":6905,"_26788":3078,"_31827":14450,"_31829":6826,"_31831":6459,"_31834":5851,"_26829":11804,"_31838":6965,"_26714":12895,"_31841":3349,"_26746":4198,"_31844":6954,"_31846":6311,"_31849":2716,"_27544":3635,"_31852":5376,"_31854":8292,"_31857":5435,"_31859":7759,"_31861":2738,"_31863":7851,"_31865":4535,"_18224":4300,"_31868":19121,"_31870":9560,"_26768":6386,"_27154":5051,"_31874":14444,"_31876":12949,"_31878":2973,"_31880":17802,"_31882":23922,"_31884":5621,"_31886":4170,"_27640":4654,"_27187":3005,"_31890":5389,"_31892":4118,"_26757":15039,"_31895":6269,"_31897":3212,"_31899":4598,"_27578":4319,"_26849":20969,"_26234":7425,"_31904":2897,"_31906":10418,"_31908":4524,"_26886":3007,"_31912":6924,"_27148":3330,"_31916":13440,"_31918":3080,"_31920":3030,"_31922":5980,"_31924":3643,"_31926":3380,"_26875":10813,"_27115":5948,"_31930":6852,"_31932":11718,"_31934":6882,"_31937":5428,"_31939":6357,"_31941":12207,"_31943":2886,"_31945":6841,"_31947":3537,"_31949":6823,"_31952":11731,"_31954":3006,"_31956":7099,"_31958":6