":52775,"_36681":52778,"_36683":52781,"_36685":52784,"_36687":52787,"_36689":52790,"_36691":52793,"_36693":52796,"_36695":52799,"_36697":52802,"_36699":52805,"_36701":52808,"_36703":52811,"_36705":52814,"_36707":52817,"_36709":52820,"_36711":52823,"_36713":52826,"_36715":52829,"_36717":52832,"_36719":52835,"_36721":52838,"_36723":52841,"_36725":52844,"_36727":52847,"_36730":52850,"_36732":52853,"_36734":52856,"_36736":52859,"_36738":52862,"_36740":52865,"_36742":52868,"_36744":52871,"_36746":52874,"_36748":52877,"_36750":52880,"_36752":52883,"_36754":52886,"_36756":52889,"_36758":52892,"_36760":52895,"_36762":52898,"_36764":52901,"_36766":52904,"_36768":52907,"_36770":52910,"_36772":52913,"_36774":52916,"_36776":52919,"_36778":52922,"_36780":52925,"_36782":52928,"_36784":52931,"_36786":52934,"_36788":52937,"_36790":52940,"_36792":52943,"_36794":52946,"_36796":52949,"_36799":52952,"_36801":52955,"_36803":52958,"_36806":52961,"_36808":52964,"_36810":52967,"_36812":52970,"_36814":52973,"_36816":52976,"_36818":52979,"_36820":52982,"_36822":52985,"_36824":52988,"_36826":52991,"_36828":52994,"_36830":52997,"_36832":53000,"_36834":53003,"_36836":53006,"_36838":53009,"_36840":53012,"_36842":53015,"_36844":53018,"_36846":53021,"_36848":53024,"_36850":53027,"_36852":53030,"_36854":53033,"_36856":53036,"_36858":53039,"_36860":53042,"_36862":53045,"_36864":53048,"_36866":53051,"_36868":53054,"_36870":53057,"_36872":53060,"_36874":53063,"_36876":53066},{"_3146":15,"_27538":15,"_5":13480,"_2645":44828,"_27881":44829,"_19130":44833,"_26074":15},"Deploy from AWS Marketplace",[44830,44831,44832],"Docs","Deployment","Other models",[],{"_3146":16,"_27538":15,"_19130":44835,"_5":13154,"_26074":15,"_2645":44836},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3146":17,"_27538":15,"_5":27878,"_19130":44838,"_26074":44839,"_2645":44840},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3146":18,"_27538":15,"_5":27878,"_19130":44842,"_26074":44843,"_2645":44844},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3146":19,"_27538":15,"_5":27878,"_19130":44846,"_26074":44847,"_2645":44848},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3146":20,"_27538":15,"_5":27878,"_19130":44850,"_26074":44851,"_2645":44852},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3146":21,"_27538":15,"_5":27878,"_19130":44854,"_26074":44855,"_2645":44856},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3146":22,"_27538":15,"_5":27878,"_19130":44858,"_26074":44859,"_2645":44860},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3146":23,"_27538":15,"_5":27878,"_19130":44862,"_26074":44863,"_2645":44864},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#next-step","Next step",{"_3146":24,"_27538":15,"_19130":44866,"_5":13154,"_26074":15,"_2645":44867},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3146":25,"_27538":15,"_19130":44869,"_5":13154,"_26074":44839,"_2645":44870},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3146":26,"_27538":15,"_19130":44872,"_5":13154,"_26074":44839,"_2645":44873},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3146":27,"_27538":15,"_19130":44875,"_5":13154,"_26074":44839,"_2645":44876},[],"A security group allowing the necessary endpoints.",{"_3146":28,"_27538":15,"_19130":44878,"_5":13154,"_26074":44843,"_2645":44879},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3146":29,"_27538":15,"_19130":44881,"_5":13154,"_26074":44843,"_2645":44882},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3146":30,"_27538":15,"_19130":44884,"_5":13154,"_26074":44843,"_2645":44885},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3146":31,"_27538":15,"_19130":44887,"_5":13154,"_26074":44847,"_2645":44888},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3146":32,"_27538":15,"_19130":44890,"_5":13154,"_26074":44851,"_2645":44891},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3146":33,"_27538":15,"_19130":44893,"_5":13154,"_26074":44855,"_2645":44894},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3146":34,"_27538":15,"_19130":44896,"_5":13154,"_26074":44859,"_2645":44897},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3146":35,"_27538":15,"_19130":44899,"_5":13154,"_26074":44863,"_2645":44900},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3146":36,"_27538":36,"_5":13480,"_2645":44902,"_27881":44903,"_19130":44904,"_26074":36},"Deploy Lamassu",[44830,44831],[],{"_3146":37,"_27538":36,"_19130":44906,"_5":13154,"_26074":36,"_2645":44907},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3146":38,"_27538":36,"_5":27878,"_19130":44909,"_26074":44910,"_2645":44911},[],"/docs/pr-preview/pr-26/deployment/overview#choose-a-model","Choose a model",{"_3146":39,"_27538":36,"_5":27878,"_19130":44913,"_26074":44914,"_2645":44915},[],"/docs/pr-preview/pr-26/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3146":40,"_27538":36,"_5":27878,"_19130":44917,"_26074":44918,"_2645":44919},[],"/docs/pr-preview/pr-26/deployment/overview#after-deployment","After deployment",{"_3146":41,"_27538":36,"_19130":44921,"_5":13154,"_26074":36,"_2645":44922},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3146":42,"_27538":36,"_19130":44924,"_5":13154,"_26074":44910,"_2645":44925},[],"Model",{"_3146":43,"_27538":36,"_19130":44927,"_5":13154,"_26074":44910,"_2645":44928},[],"Recommended for",{"_3146":44,"_27538":36,"_19130":44930,"_5":13154,"_26074":44910,"_2645":44931},[],"Who operates the infrastructure",{"_3146":45,"_27538":36,"_19130":44933,"_5":13154,"_26074":44910,"_2645":44934},[],"Starting point",{"_3146":46,"_27538":36,"_19130":44936,"_5":13154,"_26074":44910,"_2645":44937},[],"Kubernetes self-managed",{"_3146":47,"_27538":36,"_19130":44939,"_5":13154,"_26074":44910,"_2645":44940},[],"Production, regulated environments and custom deployments",{"_3146":48,"_27538":36,"_19130":44942,"_5":13154,"_26074":44910,"_2645":44943},[],"Your team",{"_3146":49,"_27538":36,"_19130":44945,"_5":13154,"_26074":44910,"_2645":44946},[],"Helm or Fastlane",{"_3146":50,"_27538":36,"_19130":44948,"_5":13154,"_26074":44910,"_2645":44949},[],"AWS Marketplace",{"_3146":51,"_27538":36,"_19130":44951,"_5":13154,"_26074":44910,"_2645":44952},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3146":52,"_27538":36,"_19130":44954,"_5":13154,"_26074":44910,"_2645":44943},[],{"_3146":53,"_27538":36,"_19130":44956,"_5":13154,"_26074":44910,"_2645":44957},[],"Preconfigured image on EC2",{"_3146":54,"_27538":36,"_19130":44959,"_5":13154,"_26074":44910,"_2645":44960},[],"SaaS",{"_3146":55,"_27538":36,"_19130":44962,"_5":13154,"_26074":44910,"_2645":44963},[],"Teams that want to use the platform without operating it",{"_3146":56,"_27538":36,"_19130":44965,"_5":13154,"_26074":44910,"_2645":44966},[],"Lamassu",{"_3146":57,"_27538":36,"_19130":44968,"_5":13154,"_26074":44910,"_2645":44969},[],"Managed subscription",{"_3146":58,"_27538":36,"_19130":44971,"_5":13154,"_26074":44910,"_2645":44972},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3146":59,"_27538":36,"_19130":44974,"_5":13154,"_26074":44910,"_2645":44975},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3146":60,"_27538":36,"_19130":44977,"_5":13154,"_26074":44910,"_2645":44978},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3146":61,"_27538":36,"_19130":44980,"_5":13154,"_26074":44914,"_2645":44981},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3146":62,"_27538":36,"_19130":44983,"_5":13154,"_26074":44918,"_2645":44984},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3146":63,"_27538":63,"_5":13480,"_2645":44986,"_27881":44987,"_19130":44988,"_26074":63},"Use Lamassu as SaaS",[44830,44831,44832],[],{"_3146":64,"_27538":63,"_19130":44990,"_5":13154,"_26074":63,"_2645":44991},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3146":65,"_27538":63,"_5":27878,"_19130":44993,"_26074":44994,"_2645":44995},[],"/docs/pr-preview/pr-26/deployment/saas#what-the-service-manages","What the service manages",{"_3146":66,"_27538":63,"_5":27878,"_19130":44997,"_26074":44998,"_2645":44999},[],"/docs/pr-preview/pr-26/deployment/saas#plans","Plans",{"_3146":67,"_27538":63,"_5":27878,"_19130":45001,"_26074":45002,"_2645":45003},[],"/docs/pr-preview/pr-26/deployment/saas#request-access","Request access",{"_3146":68,"_27538":63,"_19130":45005,"_5":13154,"_26074":63,"_2645":45006},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3146":69,"_27538":63,"_19130":45008,"_5":13154,"_26074":44994,"_2645":45009},[],"Platform availability and maintenance.",{"_3146":70,"_27538":63,"_19130":45011,"_5":13154,"_26074":44994,"_2645":45012},[],"Automatic backups.",{"_3146":71,"_27538":63,"_19130":45014,"_5":13154,"_26074":44994,"_2645":45015},[],"Version upgrades.",{"_3146":72,"_27538":63,"_19130":45017,"_5":13154,"_26074":44994,"_2645":45018},[],"Technical support and SLA according to your plan.",{"_3146":73,"_27538":63,"_19130":45020,"_5":13154,"_26074":44998,"_2645":45021},[],"Plan",{"_3146":74,"_27538":63,"_19130":45023,"_5":13154,"_26074":44998,"_2645":45024},[],"Devices",{"_3146":75,"_27538":63,"_19130":45026,"_5":13154,"_26074":44998,"_2645":45027},[],"Support",{"_3146":76,"_27538":63,"_19130":45029,"_5":13154,"_26074":44998,"_2645":45030},[],"SLA",{"_3146":77,"_27538":63,"_19130":45032,"_5":13154,"_26074":44998,"_2645":45033},[],"Starter",{"_3146":78,"_27538":63,"_19130":45035,"_5":13154,"_26074":44998,"_2645":45036},[],"Up to 1,000",{"_3146":79,"_27538":63,"_19130":45038,"_5":13154,"_26074":44998,"_2645":45039},[],"Email",{"_3146":80,"_27538":63,"_19130":45041,"_5":13154,"_26074":44998,"_2645":45042},[],"99.5 %",{"_3146":81,"_27538":63,"_19130":45044,"_5":13154,"_26074":44998,"_2645":45045},[],"Professional",{"_3146":82,"_27538":63,"_19130":45047,"_5":13154,"_26074":44998,"_2645":45048},[],"Up to 10,000",{"_3146":83,"_27538":63,"_19130":45050,"_5":13154,"_26074":44998,"_2645":45051},[],"Email and chat",{"_3146":84,"_27538":63,"_19130":45053,"_5":13154,"_26074":44998,"_2645":45054},[],"99.9 %",{"_3146":85,"_27538":63,"_19130":45056,"_5":13154,"_26074":44998,"_2645":45057},[],"Enterprise",{"_3146":86,"_27538":63,"_19130":45059,"_5":13154,"_26074":44998,"_2645":45060},[],"Unlimited",{"_3146":87,"_27538":63,"_19130":45062,"_5":13154,"_26074":44998,"_2645":45063},[],"Dedicated",{"_3146":88,"_27538":63,"_19130":45065,"_5":13154,"_26074":44998,"_2645":45066},[],"99.99 %",{"_3146":89,"_27538":63,"_19130":45068,"_5":13154,"_26074":45002,"_2645":45069},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3146":90,"_27538":63,"_19130":45071,"_5":13154,"_26074":45002,"_2645":45072},[],"When you receive your instance's credentials, continue with Get started.",{"_3146":91,"_27538":91,"_5":13480,"_2645":45074,"_27881":45075,"_19130":45076,"_26074":91},"Fastlane",[44830,44831,44937],[],{"_3146":92,"_27538":91,"_19130":45078,"_5":13154,"_26074":91,"_2645":45079},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3146":93,"_27538":91,"_5":27878,"_19130":45081,"_26074":45082,"_2645":45083},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3146":94,"_27538":91,"_5":27878,"_19130":45085,"_26074":45086,"_2645":45087},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3146":95,"_27538":91,"_5":27878,"_19130":45089,"_26074":45090,"_2645":44840},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#before-you-begin",{"_3146":96,"_27538":91,"_5":27878,"_19130":45092,"_26074":45093,"_2645":45094},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3146":97,"_27538":91,"_5":27878,"_19130":45096,"_26074":45097,"_2645":45098},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3146":98,"_27538":91,"_5":27878,"_19130":45100,"_26074":45101,"_2645":45102},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3146":99,"_27538":91,"_5":27878,"_19130":45104,"_26074":45105,"_2645":45106},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3146":100,"_27538":91,"_5":27878,"_19130":45108,"_26074":45109,"_2645":45110},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3146":101,"_27538":91,"_5":27878,"_19130":45112,"_26074":45113,"_2645":45114},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3146":102,"_27538":91,"_5":27878,"_19130":45116,"_26074":45117,"_2645":45118},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3146":103,"_27538":91,"_5":27878,"_19130":45120,"_26074":45121,"_2645":45122},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3146":104,"_27538":91,"_19130":45124,"_5":13154,"_26074":45082,"_2645":45125},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3146":105,"_27538":91,"_19130":45127,"_5":13154,"_26074":45082,"_2645":45128},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3146":106,"_27538":91,"_19130":45130,"_5":13154,"_26074":45086,"_2645":45131},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3146":107,"_27538":91,"_19130":45133,"_5":13154,"_26074":45086,"_2645":45134},[],"Fastlane installs or configures",{"_3146":108,"_27538":91,"_19130":45136,"_5":13154,"_26074":45086,"_2645":45137},[],"You still provide",{"_3146":109,"_27538":91,"_19130":45139,"_5":13154,"_26074":45086,"_2645":45140},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3146":110,"_27538":91,"_19130":45142,"_5":13154,"_26074":45086,"_2645":45143},[],"The Kubernetes cluster, nodes and persistent storage",{"_3146":111,"_27538":91,"_19130":45145,"_5":13154,"_26074":45086,"_2645":45146},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3146":112,"_27538":91,"_19130":45148,"_5":13154,"_26074":45086,"_2645":45149},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3146":113,"_27538":91,"_19130":45151,"_5":13154,"_26074":45086,"_2645":45152},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3146":114,"_27538":91,"_19130":45154,"_5":13154,"_26074":45086,"_2645":45155},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3146":115,"_27538":91,"_19130":45157,"_5":13154,"_26074":45086,"_2645":45158},[],"Optional observability and lab HSM components",{"_3146":116,"_27538":91,"_19130":45160,"_5":13154,"_26074":45086,"_2645":45161},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3146":117,"_27538":91,"_19130":45163,"_5":13154,"_26074":45086,"_2645":45164},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3146":118,"_27538":91,"_19130":45166,"_5":13154,"_26074":45090,"_2645":45167},[],"You need:",{"_3146":119,"_27538":91,"_19130":45169,"_5":13154,"_26074":45090,"_2645":45170},[],"an existing Kubernetes cluster",{"_3146":120,"_27538":91,"_19130":45172,"_5":13154,"_26074":45090,"_2645":45173},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3146":121,"_27538":91,"_19130":45175,"_5":13154,"_26074":45090,"_2645":45176},[],"`yq`",{"_3146":122,"_27538":91,"_19130":45178,"_5":13154,"_26074":45090,"_2645":21661},[],{"_3146":123,"_27538":91,"_19130":45180,"_5":13154,"_26074":45090,"_2645":45181},[],"`jq` only when using `--sample-data` or `--development`",{"_3146":124,"_27538":91,"_19130":45183,"_5":13154,"_26074":45090,"_2645":45184},[],"`ssh-keygen` only when using `--with-hsm`",{"_3146":125,"_27538":91,"_19130":45186,"_5":13154,"_26074":45090,"_2645":45187},[],"free external ports 80 and 443 on a single-node K3s host",{"_3146":126,"_27538":91,"_19130":45189,"_5":13154,"_26074":45090,"_2645":45190},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3146":127,"_27538":91,"_19130":45192,"_5":13154,"_26074":45090,"_2645":45193},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3146":128,"_27538":91,"_19130":45195,"_5":13154,"_26074":45093,"_2645":45196},[],"Run the script from a clone of the Helm repository:",{"_3146":129,"_27538":91,"_19130":45198,"_5":13154,"_26074":45093,"_2645":45199},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3146":130,"_27538":91,"_19130":45201,"_5":13154,"_26074":45097,"_2645":45202},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3146":131,"_27538":91,"_19130":45204,"_5":13154,"_26074":45097,"_2645":45205},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3146":132,"_27538":91,"_19130":45207,"_5":13154,"_26074":45097,"_2645":45208},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3146":133,"_27538":91,"_19130":45210,"_5":13154,"_26074":45097,"_2645":45211},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3146":134,"_27538":91,"_19130":45213,"_5":13154,"_26074":45101,"_2645":45214},[],"Option",{"_3146":135,"_27538":91,"_19130":45216,"_5":13154,"_26074":45101,"_2645":45217},[],"Default",{"_3146":136,"_27538":91,"_19130":45219,"_5":13154,"_26074":45101,"_2645":45220},[],"Purpose",{"_3146":137,"_27538":91,"_19130":45222,"_5":13154,"_26074":45101,"_2645":45223},[],"`-h`, `--help`",{"_3146":138,"_27538":91,"_19130":45225,"_5":13154,"_26074":45101,"_2645":45226},[],"—",{"_3146":139,"_27538":91,"_19130":45228,"_5":13154,"_26074":45101,"_2645":45229},[],"Show help",{"_3146":140,"_27538":91,"_19130":45231,"_5":13154,"_26074":45101,"_2645":45232},[],"`-c`, `--context`",{"_3146":141,"_27538":91,"_19130":45234,"_5":13154,"_26074":45101,"_2645":45235},[],"current context",{"_3146":142,"_27538":91,"_19130":45237,"_5":13154,"_26074":45101,"_2645":45238},[],"Select the kubeconfig context for kubectl and Helm",{"_3146":143,"_27538":91,"_19130":45240,"_5":13154,"_26074":45101,"_2645":45241},[],"`-n`, `--non-interactive`",{"_3146":144,"_27538":91,"_19130":45243,"_5":13154,"_26074":45101,"_2645":5893},[],{"_3146":145,"_27538":91,"_19130":45245,"_5":13154,"_26074":45101,"_2645":45246},[],"Skip prompts and generate dependency credentials",{"_3146":146,"_27538":91,"_19130":45248,"_5":13154,"_26074":45101,"_2645":45249},[],"`-ns`, `--namespace`",{"_3146":147,"_27538":91,"_19130":45251,"_5":13154,"_26074":45101,"_2645":45252},[],"`lamassu-dev`",{"_3146":148,"_27538":91,"_19130":45254,"_5":13154,"_26074":45101,"_2645":45255},[],"Namespace for the installation",{"_3146":149,"_27538":91,"_19130":45257,"_5":13154,"_26074":45101,"_2645":45258},[],"`-d`, `--domain`",{"_3146":150,"_27538":91,"_19130":45260,"_5":13154,"_26074":45101,"_2645":45261},[],"`dev.lamassu.io`",{"_3146":151,"_27538":91,"_19130":45263,"_5":13154,"_26074":45101,"_2645":45264},[],"Domain used by the UI, OIDC and certificate",{"_3146":152,"_27538":91,"_19130":45266,"_5":13154,"_26074":45101,"_2645":45267},[],"`-v`, `--version`",{"_3146":153,"_27538":91,"_19130":45269,"_5":13154,"_26074":45101,"_2645":13756},[],{"_3146":154,"_27538":91,"_19130":45271,"_5":13154,"_26074":45101,"_2645":45272},[],"Lamassu chart version",{"_3146":155,"_27538":91,"_19130":45274,"_5":13154,"_26074":45101,"_2645":45275},[],"`--https-port`",{"_3146":156,"_27538":91,"_19130":45277,"_5":13154,"_26074":45101,"_2645":45278},[],"`443`",{"_3146":157,"_27538":91,"_19130":45280,"_5":13154,"_26074":45101,"_2645":45281},[],"Gateway HTTPS listener port",{"_3146":158,"_27538":91,"_19130":45283,"_5":13154,"_26074":45101,"_2645":45284},[],"`--http-port`",{"_3146":159,"_27538":91,"_19130":45286,"_5":13154,"_26074":45101,"_2645":45287},[],"`80`",{"_3146":160,"_27538":91,"_19130":45289,"_5":13154,"_26074":45101,"_2645":45290},[],"Gateway HTTP listener port",{"_3146":161,"_27538":91,"_19130":45292,"_5":13154,"_26074":45101,"_2645":45293},[],"`--tls-crt`",{"_3146":162,"_27538":91,"_19130":45295,"_5":13154,"_26074":45101,"_2645":45226},[],{"_3146":163,"_27538":91,"_19130":45297,"_5":13154,"_26074":45101,"_2645":45298},[],"PEM certificate for downstream TLS",{"_3146":164,"_27538":91,"_19130":45300,"_5":13154,"_26074":45101,"_2645":45301},[],"`--tls-key`",{"_3146":165,"_27538":91,"_19130":45303,"_5":13154,"_26074":45101,"_2645":45226},[],{"_3146":166,"_27538":91,"_19130":45305,"_5":13154,"_26074":45101,"_2645":45306},[],"PEM private key for downstream TLS",{"_3146":167,"_27538":91,"_19130":45308,"_5":13154,"_26074":45101,"_2645":45309},[],"`-l`, `--local-chart-path`",{"_3146":168,"_27538":91,"_19130":45311,"_5":13154,"_26074":45101,"_2645":45312},[],"repository chart",{"_3146":169,"_27538":91,"_19130":45314,"_5":13154,"_26074":45101,"_2645":45315},[],"Use an unpacked local Lamassu chart",{"_3146":170,"_27538":91,"_19130":45317,"_5":13154,"_26074":45101,"_2645":45318},[],"`-ip`, `--gateway-ip`",{"_3146":171,"_27538":91,"_19130":45320,"_5":13154,"_26074":45101,"_2645":7945},[],{"_3146":172,"_27538":91,"_19130":45322,"_5":13154,"_26074":45101,"_2645":45323},[],"Override the address written to `gateway.addresses`",{"_3146":173,"_27538":91,"_19130":45325,"_5":13154,"_26074":45101,"_2645":45326},[],"`--otel`",{"_3146":174,"_27538":91,"_19130":45328,"_5":13154,"_26074":45101,"_2645":5893},[],{"_3146":175,"_27538":91,"_19130":45330,"_5":13154,"_26074":45101,"_2645":45331},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3146":176,"_27538":91,"_19130":45333,"_5":13154,"_26074":45101,"_2645":45334},[],"`--development`",{"_3146":177,"_27538":91,"_19130":45336,"_5":13154,"_26074":45101,"_2645":5893},[],{"_3146":178,"_27538":91,"_19130":45338,"_5":13154,"_26074":45101,"_2645":45339},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3146":179,"_27538":91,"_19130":45341,"_5":13154,"_26074":45101,"_2645":45342},[],"`--sample-data`",{"_3146":180,"_27538":91,"_19130":45344,"_5":13154,"_26074":45101,"_2645":5893},[],{"_3146":181,"_27538":91,"_19130":45346,"_5":13154,"_26074":45101,"_2645":45347},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3146":182,"_27538":91,"_19130":45349,"_5":13154,"_26074":45101,"_2645":45350},[],"`--with-hsm`",{"_3146":183,"_27538":91,"_19130":45352,"_5":13154,"_26074":45101,"_2645":5893},[],{"_3146":184,"_27538":91,"_19130":45354,"_5":13154,"_26074":45101,"_2645":45355},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3146":185,"_27538":91,"_19130":45357,"_5":13154,"_26074":45101,"_2645":45358},[],"`--softhsm-chart-path`",{"_3146":186,"_27538":91,"_19130":45360,"_5":13154,"_26074":45101,"_2645":45361},[],"`./charts/softhsm`",{"_3146":187,"_27538":91,"_19130":45363,"_5":13154,"_26074":45101,"_2645":45364},[],"Use a different local SoftHSM chart",{"_3146":188,"_27538":91,"_19130":45366,"_5":13154,"_26074":45101,"_2645":45367},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3146":189,"_27538":91,"_19130":45369,"_5":13154,"_26074":45105,"_2645":45370},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3146":190,"_27538":91,"_19130":45372,"_5":13154,"_26074":45105,"_2645":45373},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3146":191,"_27538":91,"_19130":45375,"_5":13154,"_26074":45105,"_2645":45376},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3146":192,"_27538":91,"_19130":45378,"_5":13154,"_26074":45105,"_2645":45379},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3146":193,"_27538":91,"_19130":45381,"_5":13154,"_26074":45105,"_2645":45382},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3146":194,"_27538":91,"_19130":45384,"_5":13154,"_26074":45105,"_2645":45385},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3146":195,"_27538":91,"_19130":45387,"_5":13154,"_26074":45109,"_2645":45388},[],"Fastlane:",{"_3146":196,"_27538":91,"_19130":45390,"_5":13154,"_26074":45109,"_2645":45391},[],"validates local tools and the selected cluster",{"_3146":197,"_27538":91,"_19130":45393,"_5":13154,"_26074":45109,"_2645":45394},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3146":198,"_27538":91,"_19130":45396,"_5":13154,"_26074":45109,"_2645":45397},[],"creates the namespace",{"_3146":199,"_27538":91,"_19130":45399,"_5":13154,"_26074":45109,"_2645":45400},[],"installs PostgreSQL and creates the required databases",{"_3146":200,"_27538":91,"_19130":45402,"_5":13154,"_26074":45109,"_2645":45403},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3146":201,"_27538":91,"_19130":45405,"_5":13154,"_26074":45109,"_2645":45406},[],"installs RabbitMQ",{"_3146":202,"_27538":91,"_19130":45408,"_5":13154,"_26074":45109,"_2645":45409},[],"optionally installs observability and lab HSM components",{"_3146":203,"_27538":91,"_19130":45411,"_5":13154,"_26074":45109,"_2645":45412},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3146":204,"_27538":91,"_19130":45414,"_5":13154,"_26074":45109,"_2645":45415},[],"optionally loads sample data",{"_3146":205,"_27538":91,"_19130":45417,"_5":13154,"_26074":45109,"_2645":45418},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3146":206,"_27538":91,"_19130":45420,"_5":13154,"_26074":45113,"_2645":45421},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3146":207,"_27538":91,"_19130":45423,"_5":13154,"_26074":45113,"_2645":45424},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3146":208,"_27538":91,"_19130":45426,"_5":13154,"_26074":45117,"_2645":45427},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3146":209,"_27538":91,"_19130":45429,"_5":13154,"_26074":45117,"_2645":45430},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3146":210,"_27538":91,"_19130":45432,"_5":13154,"_26074":45117,"_2645":45433},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3146":211,"_27538":91,"_19130":45435,"_5":13154,"_26074":45121,"_2645":45436},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3146":212,"_27538":212,"_5":13480,"_2645":45438,"_27881":45439,"_19130":45440,"_26074":212},"Install with Helm",[44830,44831,44937],[],{"_3146":213,"_27538":212,"_19130":45442,"_5":13154,"_26074":212,"_2645":45443},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3146":214,"_27538":212,"_5":27878,"_19130":45445,"_26074":45446,"_2645":45447},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3146":215,"_27538":212,"_5":27878,"_19130":45449,"_26074":45450,"_2645":44840},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#before-you-begin",{"_3146":216,"_27538":212,"_5":27878,"_19130":45452,"_26074":45453,"_2645":45454},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3146":217,"_27538":212,"_5":27878,"_19130":45456,"_26074":45457,"_2645":45458},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3146":218,"_27538":212,"_5":27878,"_19130":45460,"_26074":45461,"_2645":45462},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3146":219,"_27538":212,"_5":27878,"_19130":45464,"_26074":45465,"_2645":45466},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3146":220,"_27538":212,"_5":27878,"_19130":45468,"_26074":45469,"_2645":45470},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3146":221,"_27538":212,"_5":27878,"_19130":45472,"_26074":45473,"_2645":45474},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3146":222,"_27538":212,"_5":27878,"_19130":45476,"_26074":45477,"_2645":45478},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3146":223,"_27538":212,"_19130":45480,"_5":13154,"_26074":45446,"_2645":45481},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3146":224,"_27538":212,"_19130":45483,"_5":13154,"_26074":45450,"_2645":45484},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3146":225,"_27538":212,"_19130":45486,"_5":13154,"_26074":45450,"_2645":45487},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3146":226,"_27538":212,"_19130":45489,"_5":13154,"_26074":45450,"_2645":45490},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3146":227,"_27538":212,"_19130":45492,"_5":13154,"_26074":45450,"_2645":45493},[],"a reachable RabbitMQ broker and credentials",{"_3146":228,"_27538":212,"_19130":45495,"_5":13154,"_26074":45450,"_2645":45496},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3146":229,"_27538":212,"_19130":45498,"_5":13154,"_26074":45450,"_2645":45499},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3146":230,"_27538":212,"_19130":45501,"_5":13154,"_26074":45450,"_2645":45502},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3146":231,"_27538":212,"_19130":45504,"_5":13154,"_26074":45450,"_2645":45505},[],"a StorageClass and an external traffic design",{"_3146":232,"_27538":212,"_19130":45507,"_5":13154,"_26074":45450,"_2645":45508},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3146":233,"_27538":212,"_19130":45510,"_5":13154,"_26074":45450,"_2645":45511},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3146":234,"_27538":212,"_19130":45513,"_5":13154,"_26074":45450,"_2645":45514},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3146":235,"_27538":212,"_19130":45516,"_5":13154,"_26074":45453,"_2645":45517},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3146":236,"_27538":212,"_19130":45519,"_5":13154,"_26074":45453,"_2645":45520},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3146":237,"_27538":212,"_19130":45522,"_5":13154,"_26074":45453,"_2645":45523},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_3146":238,"_27538":212,"_19130":45525,"_5":13154,"_26074":45457,"_2645":45526},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3146":239,"_27538":212,"_19130":45528,"_5":13154,"_26074":45457,"_2645":45529},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3146":240,"_27538":212,"_19130":45531,"_5":13154,"_26074":45457,"_2645":45532},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3146":241,"_27538":212,"_19130":45534,"_5":13154,"_26074":45461,"_2645":45535},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_3146":242,"_27538":212,"_19130":45537,"_5":13154,"_26074":45465,"_2645":45538},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3146":243,"_27538":212,"_19130":45540,"_5":13154,"_26074":45465,"_2645":45541},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3146":244,"_27538":212,"_19130":45543,"_5":13154,"_26074":45465,"_2645":45544},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3146":245,"_27538":212,"_19130":45546,"_5":13154,"_26074":45465,"_2645":45547},[],"See Access control for the principal and policy model.",{"_3146":246,"_27538":212,"_19130":45549,"_5":13154,"_26074":45469,"_2645":45550},[],"To install a local checkout instead:",{"_3146":247,"_27538":212,"_19130":45552,"_5":13154,"_26074":45473,"_2645":45553},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3146":248,"_27538":212,"_19130":45555,"_5":13154,"_26074":45473,"_2645":45556},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3146":249,"_27538":212,"_19130":45558,"_5":13154,"_26074":45477,"_2645":45559},[],"Before going live, review:",{"_3146":250,"_27538":212,"_19130":45561,"_5":13154,"_26074":45477,"_2645":45562},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3146":251,"_27538":212,"_19130":45564,"_5":13154,"_26074":45477,"_2645":45565},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3146":252,"_27538":212,"_19130":45567,"_5":13154,"_26074":45477,"_2645":45568},[],"shared VA storage before increasing VA replicas",{"_3146":253,"_27538":212,"_19130":45570,"_5":13154,"_26074":45477,"_2645":45571},[],"managed OIDC roles and removal of evaluation credentials",{"_3146":254,"_27538":212,"_19130":45573,"_5":13154,"_26074":45477,"_2645":45574},[],"a trusted TLS issuer or externally managed certificate",{"_3146":255,"_27538":212,"_19130":45576,"_5":13154,"_26074":45477,"_2645":45577},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3146":256,"_27538":212,"_19130":45579,"_5":13154,"_26074":45477,"_2645":45580},[],"SMTP, observability and alert delivery",{"_3146":257,"_27538":212,"_19130":45582,"_5":13154,"_26074":45477,"_2645":45583},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3146":258,"_27538":212,"_19130":45585,"_5":13154,"_26074":45477,"_2645":45586},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3146":259,"_27538":259,"_5":13480,"_2645":45588,"_27881":45589,"_19130":45590,"_26074":259},"Expose the Gateway",[44830,44831,44937],[],{"_3146":260,"_27538":259,"_19130":45592,"_5":13154,"_26074":259,"_2645":45593},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3146":261,"_27538":259,"_5":27878,"_19130":45595,"_26074":45596,"_2645":45597},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3146":262,"_27538":259,"_5":27878,"_19130":45599,"_26074":45600,"_2645":45601},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3146":263,"_27538":259,"_5":27878,"_19130":45603,"_26074":45604,"_2645":45605},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3146":264,"_27538":259,"_5":27878,"_19130":45607,"_26074":45608,"_2645":45609},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#k3s","K3s",{"_3146":265,"_27538":259,"_5":27878,"_19130":45611,"_26074":45612,"_2645":45613},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3146":266,"_27538":259,"_5":27878,"_19130":45615,"_26074":45616,"_2645":45617},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3146":267,"_27538":259,"_5":27878,"_19130":45619,"_26074":45620,"_2645":45621},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3146":268,"_27538":259,"_5":27878,"_19130":45623,"_26074":45624,"_2645":45625},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3146":269,"_27538":259,"_5":27878,"_19130":45627,"_26074":45628,"_2645":45629},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3146":270,"_27538":259,"_19130":45631,"_5":13154,"_26074":45596,"_2645":45632},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3146":271,"_27538":259,"_19130":45634,"_5":13154,"_26074":45596,"_2645":45635},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3146":272,"_27538":259,"_19130":45637,"_5":13154,"_26074":45600,"_2645":45638},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3146":273,"_27538":259,"_19130":45640,"_5":13154,"_26074":45600,"_2645":45641},[],"Set it only when:",{"_3146":274,"_27538":259,"_19130":45643,"_5":13154,"_26074":45600,"_2645":45644},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3146":275,"_27538":259,"_19130":45646,"_5":13154,"_26074":45600,"_2645":45647},[],"that address is allocated to this Gateway",{"_3146":276,"_27538":259,"_19130":45649,"_5":13154,"_26074":45600,"_2645":45650},[],"the surrounding network already routes traffic for it to the cluster",{"_3146":277,"_27538":259,"_19130":45652,"_5":13154,"_26074":45600,"_2645":45653},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3146":278,"_27538":259,"_19130":45655,"_5":13154,"_26074":45600,"_2645":45656},[],"Keep these two settings separate:",{"_3146":279,"_27538":259,"_19130":45658,"_5":13154,"_26074":45600,"_2645":45659},[],"`gateway.addresses` requests an address for the Gateway.",{"_3146":280,"_27538":259,"_19130":45661,"_5":13154,"_26074":45600,"_2645":45662},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3146":281,"_27538":259,"_19130":45664,"_5":13154,"_26074":45600,"_2645":45665},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3146":282,"_27538":259,"_19130":45667,"_5":13154,"_26074":45604,"_2645":45668},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3146":283,"_27538":259,"_19130":45670,"_5":13154,"_26074":45604,"_2645":45671},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3146":284,"_27538":259,"_19130":45673,"_5":13154,"_26074":45608,"_2645":45674},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3146":285,"_27538":259,"_19130":45676,"_5":13154,"_26074":45608,"_2645":45677},[],"For the recommended design:",{"_3146":286,"_27538":259,"_19130":45679,"_5":13154,"_26074":45608,"_2645":45680},[],"Use only one externally exposed Lamassu Gateway.",{"_3146":287,"_27538":259,"_19130":45682,"_5":13154,"_26074":45608,"_2645":45683},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3146":288,"_27538":259,"_19130":45685,"_5":13154,"_26074":45608,"_2645":45686},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3146":289,"_27538":259,"_19130":45688,"_5":13154,"_26074":45608,"_2645":45689},[],"Point DNS at the VM's reachable address.",{"_3146":290,"_27538":259,"_19130":45691,"_5":13154,"_26074":45608,"_2645":45692},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3146":291,"_27538":259,"_19130":45694,"_5":13154,"_26074":45612,"_2645":45695},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3146":292,"_27538":259,"_19130":45697,"_5":13154,"_26074":45616,"_2645":45698},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3146":293,"_27538":259,"_19130":45700,"_5":13154,"_26074":45616,"_2645":45701},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3146":294,"_27538":259,"_19130":45703,"_5":13154,"_26074":45620,"_2645":45704},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3146":295,"_27538":259,"_19130":45706,"_5":13154,"_26074":45620,"_2645":45707},[],"Requirement",{"_3146":296,"_27538":259,"_19130":45709,"_5":13154,"_26074":45620,"_2645":45710},[],"Recommended design",{"_3146":297,"_27538":259,"_19130":45712,"_5":13154,"_26074":45620,"_2645":45713},[],"Consequence",{"_3146":298,"_27538":259,"_19130":45715,"_5":13154,"_26074":45620,"_2645":45716},[],"Several Lamassu URLs or services",{"_3146":299,"_27538":259,"_19130":45718,"_5":13154,"_26074":45620,"_2645":45719},[],"One Gateway with multiple routes",{"_3146":300,"_27538":259,"_19130":45721,"_5":13154,"_26074":45620,"_2645":45722},[],"One IP and one proxy fleet; this is the chart default",{"_3146":301,"_27538":259,"_19130":45724,"_5":13154,"_26074":45620,"_2645":45725},[],"Independent Gateways and separate external IPs",{"_3146":302,"_27538":259,"_19130":45727,"_5":13154,"_26074":45620,"_2645":45728},[],"One VIP per Gateway",{"_3146":303,"_27538":259,"_19130":45730,"_5":13154,"_26074":45620,"_2645":45731},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3146":304,"_27538":259,"_19130":45733,"_5":13154,"_26074":45620,"_2645":45734},[],"Independent Gateways on one node and one IP",{"_3146":305,"_27538":259,"_19130":45736,"_5":13154,"_26074":45620,"_2645":45737},[],"Use different external ports",{"_3146":306,"_27538":259,"_19130":45739,"_5":13154,"_26074":45620,"_2645":45740},[],"Clients must include non-standard ports",{"_3146":307,"_27538":259,"_19130":45742,"_5":13154,"_26074":45620,"_2645":45743},[],"Separate TLS/mTLS termination behind one IP",{"_3146":308,"_27538":259,"_19130":45745,"_5":13154,"_26074":45620,"_2645":45746},[],"Front-door SNI routing to internal Gateways",{"_3146":309,"_27538":259,"_19130":45748,"_5":13154,"_26074":45620,"_2645":45749},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3146":310,"_27538":259,"_19130":45751,"_5":13154,"_26074":45620,"_2645":45752},[],"Separate Gateway resources but shared proxy infrastructure",{"_3146":311,"_27538":259,"_19130":45754,"_5":13154,"_26074":45620,"_2645":45755},[],"Envoy merged-Gateway mode",{"_3146":312,"_27538":259,"_19130":45757,"_5":13154,"_26074":45620,"_2645":45758},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3146":313,"_27538":259,"_19130":45760,"_5":13154,"_26074":45620,"_2645":45761},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3146":314,"_27538":259,"_19130":45763,"_5":13154,"_26074":45620,"_2645":45764},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3146":315,"_27538":259,"_19130":45766,"_5":13154,"_26074":45620,"_2645":45767},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3146":316,"_27538":259,"_19130":45769,"_5":13154,"_26074":45620,"_2645":45770},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3146":317,"_27538":259,"_19130":45772,"_5":13154,"_26074":45624,"_2645":45773},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3146":318,"_27538":259,"_19130":45775,"_5":13154,"_26074":45624,"_2645":45776},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3146":319,"_27538":259,"_19130":45778,"_5":13154,"_26074":45624,"_2645":45779},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3146":320,"_27538":259,"_19130":45781,"_5":13154,"_26074":45624,"_2645":45782},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3146":321,"_27538":259,"_19130":45784,"_5":13154,"_26074":45624,"_2645":45785},[],"If none of those are possible, use different external ports or change the external network design.",{"_3146":322,"_27538":259,"_19130":45787,"_5":13154,"_26074":45628,"_2645":45788},[],"Check, in order:",{"_3146":323,"_27538":259,"_19130":45790,"_5":13154,"_26074":45628,"_2645":45791},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3146":324,"_27538":259,"_19130":45793,"_5":13154,"_26074":45628,"_2645":45794},[],"Its status contains the expected address.",{"_3146":325,"_27538":259,"_19130":45796,"_5":13154,"_26074":45628,"_2645":45797},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3146":326,"_27538":259,"_19130":45799,"_5":13154,"_26074":45628,"_2645":45800},[],"Port 443 reaches that address from the client network.",{"_3146":327,"_27538":259,"_19130":45802,"_5":13154,"_26074":45628,"_2645":45803},[],"DNS resolves to the externally reachable endpoint.",{"_3146":328,"_27538":259,"_19130":45805,"_5":13154,"_26074":45628,"_2645":45806},[],"The certificate contains the DNS name or IP used by the client.",{"_3146":329,"_27538":259,"_19130":45808,"_5":13154,"_26074":45628,"_2645":45809},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3146":330,"_27538":330,"_5":13480,"_2645":44937,"_27881":45811,"_19130":45812,"_26074":330},[44830,44831,44937],[],{"_3146":331,"_27538":330,"_19130":45814,"_5":13154,"_26074":330,"_2645":45815},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3146":332,"_27538":330,"_5":27878,"_19130":45817,"_26074":45818,"_2645":45819},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3146":333,"_27538":330,"_5":27878,"_19130":45821,"_26074":45822,"_2645":45823},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3146":334,"_27538":330,"_5":27878,"_19130":45825,"_26074":45826,"_2645":45827},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3146":335,"_27538":330,"_5":27878,"_19130":45829,"_26074":45830,"_2645":45831},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3146":336,"_27538":330,"_5":27878,"_19130":45833,"_26074":45834,"_2645":45835},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3146":337,"_27538":330,"_5":27878,"_19130":45837,"_26074":45838,"_2645":45839},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3146":338,"_27538":330,"_19130":45841,"_5":13154,"_26074":45818,"_2645":45842},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3146":339,"_27538":330,"_19130":45844,"_5":13154,"_26074":45822,"_2645":45845},[],"Workflow",{"_3146":340,"_27538":330,"_19130":45847,"_5":13154,"_26074":45822,"_2645":45848},[],"Use it for",{"_3146":341,"_27538":330,"_19130":45850,"_5":13154,"_26074":45822,"_2645":45851},[],"What it installs",{"_3146":342,"_27538":330,"_19130":45853,"_5":13154,"_26074":45822,"_2645":45854},[],"Helm",{"_3146":343,"_27538":330,"_19130":45856,"_5":13154,"_26074":45822,"_2645":45857},[],"Production and controlled environments",{"_3146":344,"_27538":330,"_19130":45859,"_5":13154,"_26074":45822,"_2645":45860},[],"Lamassu services and Gateway API resources",{"_3146":345,"_27538":330,"_19130":45862,"_5":13154,"_26074":45822,"_2645":45074},[],{"_3146":346,"_27538":330,"_19130":45864,"_5":13154,"_26074":45822,"_2645":45865},[],"Evaluation, demos, CI and small lab clusters",{"_3146":347,"_27538":330,"_19130":45867,"_5":13154,"_26074":45822,"_2645":45868},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3146":348,"_27538":330,"_19130":45870,"_5":13154,"_26074":45826,"_2645":45871},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3146":349,"_27538":330,"_19130":45873,"_5":13154,"_26074":45826,"_2645":45874},[],"Area",{"_3146":350,"_27538":330,"_19130":45876,"_5":13154,"_26074":45826,"_2645":45877},[],"The Lamassu chart provides",{"_3146":351,"_27538":330,"_19130":45879,"_5":13154,"_26074":45826,"_2645":45880},[],"You provide",{"_3146":352,"_27538":330,"_19130":45882,"_5":13154,"_26074":45826,"_2645":45883},[],"Lamassu applications",{"_3146":353,"_27538":330,"_19130":45885,"_5":13154,"_26074":45826,"_2645":45886},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3146":354,"_27538":330,"_19130":45888,"_5":13154,"_26074":45826,"_2645":45889},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3146":355,"_27538":330,"_19130":45891,"_5":13154,"_26074":45826,"_2645":45892},[],"PostgreSQL data",{"_3146":356,"_27538":330,"_19130":45894,"_5":13154,"_26074":45826,"_2645":45895},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3146":357,"_27538":330,"_19130":45897,"_5":13154,"_26074":45826,"_2645":45898},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3146":358,"_27538":330,"_19130":45900,"_5":13154,"_26074":45826,"_2645":45901},[],"Messaging",{"_3146":359,"_27538":330,"_19130":45903,"_5":13154,"_26074":45826,"_2645":45904},[],"RabbitMQ connection configuration for the Lamassu services",{"_3146":360,"_27538":330,"_19130":45906,"_5":13154,"_26074":45826,"_2645":45907},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3146":361,"_27538":330,"_19130":45909,"_5":13154,"_26074":45826,"_2645":45910},[],"Identity",{"_3146":362,"_27538":330,"_19130":45912,"_5":13154,"_26074":45826,"_2645":45913},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3146":363,"_27538":330,"_19130":45915,"_5":13154,"_26074":45826,"_2645":45916},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3146":364,"_27538":330,"_19130":45918,"_5":13154,"_26074":45826,"_2645":45919},[],"External routing",{"_3146":365,"_27538":330,"_19130":45921,"_5":13154,"_26074":45826,"_2645":45922},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3146":366,"_27538":330,"_19130":45924,"_5":13154,"_26074":45826,"_2645":45925},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3146":367,"_27538":330,"_19130":45927,"_5":13154,"_26074":45826,"_2645":45928},[],"TLS",{"_3146":368,"_27538":330,"_19130":45930,"_5":13154,"_26074":45826,"_2645":45931},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_3146":369,"_27538":330,"_19130":45933,"_5":13154,"_26074":45826,"_2645":45934},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3146":370,"_27538":330,"_19130":45936,"_5":13154,"_26074":45826,"_2645":45937},[],"Persistent application data",{"_3146":371,"_27538":330,"_19130":45939,"_5":13154,"_26074":45826,"_2645":45940},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3146":372,"_27538":330,"_19130":45942,"_5":13154,"_26074":45826,"_2645":45943},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3146":373,"_27538":330,"_19130":45945,"_5":13154,"_26074":45826,"_2645":45946},[],"Optional integrations",{"_3146":374,"_27538":330,"_19130":45948,"_5":13154,"_26074":45826,"_2645":45949},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3146":375,"_27538":330,"_19130":45951,"_5":13154,"_26074":45826,"_2645":45952},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3146":376,"_27538":330,"_19130":45954,"_5":13154,"_26074":45826,"_2645":45955},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3146":377,"_27538":330,"_19130":45957,"_5":13154,"_26074":45826,"_2645":45958},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3146":378,"_27538":330,"_19130":45960,"_5":13154,"_26074":45830,"_2645":45961},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3146":379,"_27538":330,"_19130":45963,"_5":13154,"_26074":45830,"_2645":45964},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3146":380,"_27538":330,"_19130":45966,"_5":13154,"_26074":45834,"_2645":45967},[],"Kubernetes 1.24 or newer",{"_3146":381,"_27538":330,"_19130":45969,"_5":13154,"_26074":45834,"_2645":45970},[],"Helm 3.2 or newer",{"_3146":382,"_27538":330,"_19130":45972,"_5":13154,"_26074":45834,"_2645":45973},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3146":383,"_27538":330,"_19130":45975,"_5":13154,"_26074":45834,"_2645":45976},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_3146":384,"_27538":330,"_19130":45978,"_5":13154,"_26074":45834,"_2645":45979},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3146":385,"_27538":330,"_19130":45981,"_5":13154,"_26074":45834,"_2645":45982},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3146":386,"_27538":330,"_19130":45984,"_5":13154,"_26074":45834,"_2645":45985},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3146":387,"_27538":330,"_19130":45987,"_5":13154,"_26074":45838,"_2645":45988},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3146":388,"_27538":330,"_19130":45990,"_5":13154,"_26074":45838,"_2645":45991},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3146":389,"_27538":330,"_19130":45993,"_5":13154,"_26074":45838,"_2645":45994},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3146":390,"_27538":330,"_19130":45996,"_5":13154,"_26074":45838,"_2645":45997},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3146":391,"_27538":391,"_5":13480,"_2645":45999,"_27881":46000,"_19130":46002,"_26074":391},"Deployment troubleshooting",[44830,44831,46001],"Operations",[],{"_3146":392,"_27538":391,"_19130":46004,"_5":13154,"_26074":391,"_2645":46005},[],"Diagnose access, service health and infrastructure dependencies.",{"_3146":393,"_27538":391,"_5":27878,"_19130":46007,"_26074":46008,"_2645":46009},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3146":394,"_27538":391,"_5":27878,"_19130":46011,"_26074":46012,"_2645":46013},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3146":395,"_27538":391,"_5":27878,"_19130":46015,"_26074":46016,"_2645":46017},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3146":396,"_27538":391,"_5":27878,"_19130":46019,"_26074":46020,"_2645":46021},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3146":397,"_27538":391,"_5":27878,"_19130":46023,"_26074":46024,"_2645":46025},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3146":398,"_27538":391,"_5":27878,"_19130":46027,"_26074":46028,"_2645":46029},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3146":399,"_27538":391,"_5":27878,"_19130":46031,"_26074":46032,"_2645":46033},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3146":400,"_27538":391,"_5":27878,"_19130":46035,"_26074":46036,"_2645":46037},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3146":401,"_27538":391,"_5":27878,"_19130":46039,"_26074":46040,"_2645":46041},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3146":402,"_27538":391,"_5":27878,"_19130":46043,"_26074":46044,"_2645":46045},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3146":403,"_27538":391,"_5":27878,"_19130":46047,"_26074":46048,"_2645":46049},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3146":404,"_27538":391,"_5":27878,"_19130":46051,"_26074":46052,"_2645":46053},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#observability","Observability",{"_3146":405,"_27538":391,"_19130":46055,"_5":13154,"_26074":391,"_2645":46056},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3146":406,"_27538":391,"_19130":46058,"_5":13154,"_26074":46012,"_2645":46059},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3146":407,"_27538":391,"_19130":46061,"_5":13154,"_26074":46016,"_2645":46062},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3146":408,"_27538":391,"_19130":46064,"_5":13154,"_26074":46020,"_2645":46065},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3146":409,"_27538":391,"_19130":46067,"_5":13154,"_26074":46024,"_2645":46068},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3146":410,"_27538":391,"_19130":46070,"_5":13154,"_26074":46028,"_2645":46071},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3146":411,"_27538":391,"_19130":46073,"_5":13154,"_26074":46032,"_2645":46074},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3146":412,"_27538":391,"_19130":46076,"_5":13154,"_26074":46032,"_2645":46077},[],"Also run the chart's connectivity test:",{"_3146":413,"_27538":391,"_19130":46079,"_5":13154,"_26074":46032,"_2645":46080},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3146":414,"_27538":391,"_19130":46082,"_5":13154,"_26074":46032,"_2645":46083},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3146":415,"_27538":391,"_19130":46085,"_5":13154,"_26074":46036,"_2645":46086},[],"If you receive a 401:",{"_3146":416,"_27538":391,"_19130":46088,"_5":13154,"_26074":46036,"_2645":46089},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3146":417,"_27538":391,"_19130":46091,"_5":13154,"_26074":46036,"_2645":46092},[],"verify issuer, audience and expiration of the token;",{"_3146":418,"_27538":391,"_19130":46094,"_5":13154,"_26074":46036,"_2645":46095},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3146":419,"_27538":391,"_19130":46097,"_5":13154,"_26074":46036,"_2645":46098},[],"check that the provider's public and internal routes point to the same realm.",{"_3146":420,"_27538":391,"_19130":46100,"_5":13154,"_26074":46036,"_2645":46101},[],"If login succeeds but the APIs return 403:",{"_3146":421,"_27538":391,"_19130":46103,"_5":13154,"_26074":46036,"_2645":46104},[],"inspect the token's real claims;",{"_3146":422,"_27538":391,"_19130":46106,"_5":13154,"_26074":46036,"_2645":46107},[],"confirm they match an active principal;",{"_3146":423,"_27538":391,"_19130":46109,"_5":13154,"_26074":46036,"_2645":46110},[],"review the policies granted to that principal;",{"_3146":424,"_27538":391,"_19130":46112,"_5":13154,"_26074":46036,"_2645":46113},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3146":425,"_27538":391,"_19130":46115,"_5":13154,"_26074":46036,"_2645":46116},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3146":426,"_27538":391,"_19130":46118,"_5":13154,"_26074":46040,"_2645":46119},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3146":427,"_27538":391,"_19130":46121,"_5":13154,"_26074":46040,"_2645":46122},[],"Locate the authz pod and Service.",{"_3146":428,"_27538":391,"_19130":46124,"_5":13154,"_26074":46040,"_2645":46125},[],"Check /health, logs and its database connection.",{"_3146":429,"_27538":391,"_19130":46127,"_5":13154,"_26074":46040,"_2645":46128},[],"Verify the DNS and port configured in externalAuthorization.",{"_3146":430,"_27538":391,"_19130":46130,"_5":13154,"_26074":46040,"_2645":46131},[],"Check the check route is /v1/ext\\_authz/check.",{"_3146":431,"_27538":391,"_19130":46133,"_5":13154,"_26074":46040,"_2645":46134},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3146":432,"_27538":391,"_19130":46136,"_5":13154,"_26074":46044,"_2645":46137},[],"Review kubectl describe pod first. Common causes are:",{"_3146":433,"_27538":391,"_19130":46139,"_5":13154,"_26074":46044,"_2645":46140},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3146":434,"_27538":391,"_19130":46142,"_5":13154,"_26074":46044,"_2645":46143},[],"unbound persistent volume;",{"_3146":435,"_27538":391,"_19130":46145,"_5":13154,"_26074":46044,"_2645":46146},[],"inaccessible image or incorrect pull policy;",{"_3146":436,"_27538":391,"_19130":46148,"_5":13154,"_26074":46044,"_2645":46149},[],"invalid cryptographic engine configuration;",{"_3146":437,"_27538":391,"_19130":46151,"_5":13154,"_26074":46044,"_2645":46152},[],"CPU or memory limits set too low;",{"_3146":438,"_27538":391,"_19130":46154,"_5":13154,"_26074":46044,"_2645":46155},[],"an incomplete prior migration.",{"_3146":439,"_27538":391,"_19130":46157,"_5":13154,"_26074":46044,"_2645":46158},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3146":440,"_27538":391,"_19130":46160,"_5":13154,"_26074":46044,"_2645":46161},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3146":441,"_27538":391,"_19130":46163,"_5":13154,"_26074":46048,"_2645":46164},[],"Domain and audit events depend on the bus publisher:",{"_3146":442,"_27538":391,"_19130":46166,"_5":13154,"_26074":46048,"_2645":46167},[],"verify it is enabled in the emitting service;",{"_3146":443,"_27538":391,"_19130":46169,"_5":13154,"_26074":46048,"_2645":46170},[],"check AMQP connectivity and credentials;",{"_3146":444,"_27538":391,"_19130":46172,"_5":13154,"_26074":46048,"_2645":46173},[],"review exchange, routing key, queues and consumers;",{"_3146":445,"_27538":391,"_19130":46175,"_5":13154,"_26074":46048,"_2645":46176},[],"inspect dead-letter queues;",{"_3146":446,"_27538":391,"_19130":46178,"_5":13154,"_26074":46048,"_2645":46179},[],"alert on orphan durable queues and backlog growth.",{"_3146":447,"_27538":391,"_19130":46181,"_5":13154,"_26074":46048,"_2645":46182},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3146":448,"_27538":391,"_19130":46184,"_5":13154,"_26074":46052,"_2645":46185},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3146":449,"_27538":391,"_19130":46187,"_5":13154,"_26074":46052,"_2645":46188},[],"Before closing an incident, record:",{"_3146":450,"_27538":391,"_19130":46190,"_5":13154,"_26074":46052,"_2645":46191},[],"the confirmed cause;",{"_3146":451,"_27538":391,"_19130":46193,"_5":13154,"_26074":46052,"_2645":46194},[],"the time scope and affected resources;",{"_3146":452,"_27538":391,"_19130":46196,"_5":13154,"_26074":46052,"_2645":46197},[],"the commands or queries used;",{"_3146":453,"_27538":391,"_19130":46199,"_5":13154,"_26074":46052,"_2645":46200},[],"the applied change and how to revert it;",{"_3146":454,"_27538":391,"_19130":46202,"_5":13154,"_26074":46052,"_2645":46203},[],"validation from a consumer;",{"_3146":455,"_27538":391,"_19130":46205,"_5":13154,"_26074":46052,"_2645":46206},[],"the preventive action and its owner.",{"_3146":456,"_27538":456,"_5":13480,"_2645":46208,"_27881":46209,"_19130":46212,"_26074":456},"Access control",[44830,46210,46211],"Platform","Administration",[],{"_3146":457,"_27538":456,"_19130":46214,"_5":13154,"_26074":456,"_2645":46215},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3146":458,"_27538":456,"_5":27878,"_19130":46217,"_26074":46218,"_2645":46219},[],"/docs/pr-preview/pr-26/platform/administration/access-control#essential-concepts","Essential concepts",{"_3146":459,"_27538":456,"_5":27878,"_19130":46221,"_26074":46222,"_2645":46223},[],"/docs/pr-preview/pr-26/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3146":460,"_27538":456,"_5":27878,"_19130":46225,"_26074":46226,"_2645":46227},[],"/docs/pr-preview/pr-26/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3146":461,"_27538":456,"_5":27878,"_19130":46229,"_26074":46230,"_2645":46231},[],"/docs/pr-preview/pr-26/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3146":462,"_27538":456,"_5":27878,"_19130":46233,"_26074":46234,"_2645":46235},[],"/docs/pr-preview/pr-26/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3146":463,"_27538":456,"_5":27878,"_19130":46237,"_26074":46238,"_2645":46239},[],"/docs/pr-preview/pr-26/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3146":464,"_27538":456,"_5":27878,"_19130":46241,"_26074":46242,"_2645":46243},[],"/docs/pr-preview/pr-26/platform/administration/access-control#oidc-principals","OIDC principals",{"_3146":465,"_27538":456,"_5":27878,"_19130":46245,"_26074":46246,"_2645":46247},[],"/docs/pr-preview/pr-26/platform/administration/access-control#x509-principals","X.509 principals",{"_3146":466,"_27538":456,"_5":27878,"_19130":46249,"_26074":46250,"_2645":46251},[],"/docs/pr-preview/pr-26/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3146":467,"_27538":456,"_5":27878,"_19130":46253,"_26074":46254,"_2645":46255},[],"/docs/pr-preview/pr-26/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3146":468,"_27538":456,"_5":27878,"_19130":46257,"_26074":46258,"_2645":46259},[],"/docs/pr-preview/pr-26/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3146":469,"_27538":456,"_5":27878,"_19130":46261,"_26074":46262,"_2645":46263},[],"/docs/pr-preview/pr-26/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3146":470,"_27538":456,"_5":27878,"_19130":46265,"_26074":46266,"_2645":46267},[],"/docs/pr-preview/pr-26/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3146":471,"_27538":456,"_5":27878,"_19130":46269,"_26074":46270,"_2645":46271},[],"/docs/pr-preview/pr-26/platform/administration/access-control#http-rules","HTTP rules",{"_3146":472,"_27538":456,"_5":27878,"_19130":46273,"_26074":46274,"_2645":46275},[],"/docs/pr-preview/pr-26/platform/administration/access-control#included-policies","Included policies",{"_3146":473,"_27538":456,"_5":27878,"_19130":46277,"_26074":46278,"_2645":45466},[],"/docs/pr-preview/pr-26/platform/administration/access-control#provision-the-first-administrator",{"_3146":474,"_27538":456,"_5":27878,"_19130":46280,"_26074":46281,"_2645":46282},[],"/docs/pr-preview/pr-26/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3146":475,"_27538":456,"_5":27878,"_19130":46284,"_26074":46285,"_2645":46286},[],"/docs/pr-preview/pr-26/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3146":476,"_27538":456,"_5":27878,"_19130":46288,"_26074":46289,"_2645":46290},[],"/docs/pr-preview/pr-26/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3146":477,"_27538":456,"_5":27878,"_19130":46292,"_26074":46293,"_2645":46294},[],"/docs/pr-preview/pr-26/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3146":478,"_27538":456,"_5":27878,"_19130":46296,"_26074":46297,"_2645":46298},[],"/docs/pr-preview/pr-26/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3146":479,"_27538":456,"_5":27878,"_19130":46300,"_26074":46301,"_2645":46302},[],"/docs/pr-preview/pr-26/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3146":480,"_27538":456,"_5":27878,"_19130":46304,"_26074":46305,"_2645":46306},[],"/docs/pr-preview/pr-26/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3146":481,"_27538":456,"_5":27878,"_19130":46308,"_26074":46309,"_2645":46310},[],"/docs/pr-preview/pr-26/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3146":482,"_27538":456,"_5":27878,"_19130":46312,"_26074":46313,"_2645":46314},[],"/docs/pr-preview/pr-26/platform/administration/access-control#operational-checklist","Operational checklist",{"_3146":483,"_27538":456,"_5":27878,"_19130":46316,"_26074":46317,"_2645":46318},[],"/docs/pr-preview/pr-26/platform/administration/access-control#diagnostics","Diagnostics",{"_3146":484,"_27538":456,"_5":27878,"_19130":46320,"_26074":46321,"_2645":46322},[],"/docs/pr-preview/pr-26/platform/administration/access-control#the-response-is-401","The response is 401",{"_3146":485,"_27538":456,"_5":27878,"_19130":46324,"_26074":46325,"_2645":46326},[],"/docs/pr-preview/pr-26/platform/administration/access-control#the-response-is-403","The response is 403",{"_3146":486,"_27538":456,"_5":27878,"_19130":46328,"_26074":46329,"_2645":46330},[],"/docs/pr-preview/pr-26/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3146":487,"_27538":456,"_5":27878,"_19130":46332,"_26074":46333,"_2645":46334},[],"/docs/pr-preview/pr-26/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3146":488,"_27538":456,"_5":27878,"_19130":46336,"_26074":46337,"_2645":46338},[],"/docs/pr-preview/pr-26/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3146":489,"_27538":456,"_19130":46340,"_5":13154,"_26074":456,"_2645":46341},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3146":490,"_27538":456,"_19130":46343,"_5":13154,"_26074":456,"_2645":46344},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3146":491,"_27538":456,"_19130":46346,"_5":13154,"_26074":456,"_2645":46347},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3146":492,"_27538":456,"_19130":46349,"_5":13154,"_26074":46218,"_2645":46350},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3146":493,"_27538":456,"_19130":46352,"_5":13154,"_26074":46218,"_2645":46353},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3146":494,"_27538":456,"_19130":46355,"_5":13154,"_26074":46218,"_2645":46356},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3146":495,"_27538":456,"_19130":46358,"_5":13154,"_26074":46218,"_2645":46359},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3146":496,"_27538":456,"_19130":46361,"_5":13154,"_26074":46218,"_2645":46362},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3146":497,"_27538":456,"_19130":46364,"_5":13154,"_26074":46218,"_2645":46365},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3146":498,"_27538":456,"_19130":46367,"_5":13154,"_26074":46222,"_2645":46368},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3146":499,"_27538":456,"_19130":46370,"_5":13154,"_26074":46222,"_2645":46371},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3146":500,"_27538":456,"_19130":46373,"_5":13154,"_26074":46226,"_2645":46374},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3146":501,"_27538":456,"_19130":46376,"_5":13154,"_26074":46226,"_2645":46377},[],"The decision is made **before forwarding the request to the service**:",{"_3146":502,"_27538":456,"_19130":46379,"_5":13154,"_26074":46226,"_2645":46380},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3146":503,"_27538":456,"_19130":46382,"_5":13154,"_26074":46226,"_2645":46383},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3146":504,"_27538":456,"_19130":46385,"_5":13154,"_26074":46226,"_2645":46386},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3146":505,"_27538":456,"_19130":46388,"_5":13154,"_26074":46226,"_2645":46389},[],"It separately loads the policies granted to each principal.",{"_3146":506,"_27538":456,"_19130":46391,"_5":13154,"_26074":46226,"_2645":46392},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3146":507,"_27538":456,"_19130":46394,"_5":13154,"_26074":46226,"_2645":46395},[],"`authz` looks for an HTTP rule granting that action.",{"_3146":508,"_27538":456,"_19130":46397,"_5":13154,"_26074":46226,"_2645":46398},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3146":509,"_27538":456,"_19130":46400,"_5":13154,"_26074":46226,"_2645":46401},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3146":510,"_27538":456,"_19130":46403,"_5":13154,"_26074":46226,"_2645":46404},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3146":511,"_27538":456,"_19130":46406,"_5":13154,"_26074":46226,"_2645":46407},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3146":512,"_27538":456,"_19130":46409,"_5":13154,"_26074":46230,"_2645":46410},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3146":513,"_27538":456,"_19130":46412,"_5":13154,"_26074":46230,"_2645":46413},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3146":514,"_27538":456,"_19130":46415,"_5":13154,"_26074":46230,"_2645":46416},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3146":515,"_27538":456,"_19130":46418,"_5":13154,"_26074":46230,"_2645":46419},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3146":516,"_27538":456,"_19130":46421,"_5":13154,"_26074":46230,"_2645":46422},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3146":517,"_27538":456,"_19130":46424,"_5":13154,"_26074":46230,"_2645":46425},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3146":518,"_27538":456,"_19130":46427,"_5":13154,"_26074":46230,"_2645":46428},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3146":519,"_27538":456,"_19130":46430,"_5":13154,"_26074":46230,"_2645":46431},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3146":520,"_27538":456,"_19130":46433,"_5":13154,"_26074":46234,"_2645":46434},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3146":521,"_27538":456,"_19130":46436,"_5":13154,"_26074":46234,"_2645":46437},[],"The decision is made with the domain operation context:",{"_3146":522,"_27538":456,"_19130":46439,"_5":13154,"_26074":46234,"_2645":46440},[],"The middleware extracts the credential and resolves the matching principals.",{"_3146":523,"_27538":456,"_19130":46442,"_5":13154,"_26074":46234,"_2645":46443},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3146":524,"_27538":456,"_19130":46445,"_5":13154,"_26074":46234,"_2645":46446},[],"`authz` gathers the entity rules of the granted policies.",{"_3146":525,"_27538":456,"_19130":46448,"_5":13154,"_26074":46234,"_2645":46449},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3146":526,"_27538":456,"_19130":46451,"_5":13154,"_26074":46234,"_2645":46452},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3146":527,"_27538":456,"_19130":46454,"_5":13154,"_26074":46234,"_2645":46455},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3146":528,"_27538":456,"_19130":46457,"_5":13154,"_26074":46234,"_2645":46458},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3146":529,"_27538":456,"_19130":46460,"_5":13154,"_26074":46234,"_2645":46461},[],"Actions fall into two groups:",{"_3146":530,"_27538":456,"_19130":46463,"_5":13154,"_26074":46234,"_2645":46464},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3146":531,"_27538":456,"_19130":46466,"_5":13154,"_26074":46234,"_2645":46467},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3146":532,"_27538":456,"_19130":46469,"_5":13154,"_26074":46234,"_2645":46470},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3146":533,"_27538":456,"_19130":46472,"_5":13154,"_26074":46238,"_2645":46473},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3146":534,"_27538":456,"_19130":46475,"_5":13154,"_26074":46238,"_2645":46476},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3146":535,"_27538":456,"_19130":46478,"_5":13154,"_26074":46238,"_2645":46479},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3146":536,"_27538":456,"_19130":46481,"_5":13154,"_26074":46242,"_2645":46482},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3146":537,"_27538":456,"_19130":46484,"_5":13154,"_26074":46242,"_2645":46485},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3146":538,"_27538":456,"_19130":46487,"_5":13154,"_26074":46242,"_2645":46488},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3146":539,"_27538":456,"_19130":46490,"_5":13154,"_26074":46242,"_2645":46491},[],"The implemented operators are:",{"_3146":540,"_27538":456,"_19130":46493,"_5":13154,"_26074":46242,"_2645":46494},[],"`equals`, for exact equality;",{"_3146":541,"_27538":456,"_19130":46496,"_5":13154,"_26074":46242,"_2645":46497},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3146":542,"_27538":456,"_19130":46499,"_5":13154,"_26074":46242,"_2645":46500},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3146":543,"_27538":456,"_19130":46502,"_5":13154,"_26074":46242,"_2645":46503},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3146":544,"_27538":456,"_19130":46505,"_5":13154,"_26074":46246,"_2645":46506},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3146":545,"_27538":456,"_19130":46508,"_5":13154,"_26074":46246,"_2645":46509},[],"The available modes are:",{"_3146":546,"_27538":456,"_19130":46511,"_5":13154,"_26074":46246,"_2645":46512},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3146":547,"_27538":456,"_19130":46514,"_5":13154,"_26074":46246,"_2645":46515},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3146":548,"_27538":456,"_19130":46517,"_5":13154,"_26074":46246,"_2645":46518},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3146":549,"_27538":456,"_19130":46520,"_5":13154,"_26074":46246,"_2645":46521},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3146":550,"_27538":456,"_19130":46523,"_5":13154,"_26074":46246,"_2645":46524},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3146":551,"_27538":456,"_19130":46526,"_5":13154,"_26074":46246,"_2645":46527},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3146":552,"_27538":456,"_19130":46529,"_5":13154,"_26074":46250,"_2645":46530},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3146":553,"_27538":456,"_19130":46532,"_5":13154,"_26074":46250,"_2645":46533},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3146":554,"_27538":456,"_19130":46535,"_5":13154,"_26074":46250,"_2645":46536},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3146":555,"_27538":456,"_19130":46538,"_5":13154,"_26074":46250,"_2645":46539},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3146":556,"_27538":456,"_19130":46541,"_5":13154,"_26074":46258,"_2645":46542},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3146":557,"_27538":456,"_19130":46544,"_5":13154,"_26074":46258,"_2645":46545},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3146":558,"_27538":456,"_19130":46547,"_5":13154,"_26074":46262,"_2645":46548},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3146":559,"_27538":456,"_19130":46550,"_5":13154,"_26074":46262,"_2645":46551},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3146":560,"_27538":456,"_19130":46553,"_5":13154,"_26074":46266,"_2645":46554},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3146":561,"_27538":456,"_19130":46556,"_5":13154,"_26074":46266,"_2645":46557},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3146":562,"_27538":456,"_19130":46559,"_5":13154,"_26074":46266,"_2645":46560},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3146":563,"_27538":456,"_19130":46562,"_5":13154,"_26074":46270,"_2645":46563},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3146":564,"_27538":456,"_19130":46565,"_5":13154,"_26074":46270,"_2645":46566},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3146":565,"_27538":456,"_19130":46568,"_5":13154,"_26074":46270,"_2645":46569},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3146":566,"_27538":456,"_19130":46571,"_5":13154,"_26074":46270,"_2645":46572},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3146":567,"_27538":456,"_19130":46574,"_5":13154,"_26074":46270,"_2645":46575},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3146":568,"_27538":456,"_19130":46577,"_5":13154,"_26074":46270,"_2645":46578},[],"Note that:",{"_3146":569,"_27538":456,"_19130":46580,"_5":13154,"_26074":46270,"_2645":46581},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3146":570,"_27538":456,"_19130":46583,"_5":13154,"_26074":46270,"_2645":46584},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3146":571,"_27538":456,"_19130":46586,"_5":13154,"_26074":46270,"_2645":46587},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3146":572,"_27538":456,"_19130":46589,"_5":13154,"_26074":46274,"_2645":46590},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3146":573,"_27538":456,"_19130":46592,"_5":13154,"_26074":46274,"_2645":46593},[],"full and read-only access to certificates and authorities;",{"_3146":574,"_27538":456,"_19130":46595,"_5":13154,"_26074":46274,"_2645":46596},[],"full and read-only access to the KMS;",{"_3146":575,"_27538":456,"_19130":46598,"_5":13154,"_26074":46274,"_2645":46599},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3146":576,"_27538":456,"_19130":46601,"_5":13154,"_26074":46274,"_2645":46602},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3146":577,"_27538":456,"_19130":46604,"_5":13154,"_26074":46274,"_2645":46605},[],"console access;",{"_3146":578,"_27538":456,"_19130":46607,"_5":13154,"_26074":46274,"_2645":46608},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3146":579,"_27538":456,"_19130":46610,"_5":13154,"_26074":46274,"_2645":46611},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3146":580,"_27538":456,"_19130":46613,"_5":13154,"_26074":46274,"_2645":46614},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3146":581,"_27538":456,"_19130":46616,"_5":13154,"_26074":46278,"_2645":46617},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3146":582,"_27538":456,"_19130":46619,"_5":13154,"_26074":46278,"_2645":46620},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3146":583,"_27538":456,"_19130":46622,"_5":13154,"_26074":46278,"_2645":46623},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3146":584,"_27538":456,"_19130":46625,"_5":13154,"_26074":46281,"_2645":46626},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3146":585,"_27538":456,"_19130":46628,"_5":13154,"_26074":46285,"_2645":46629},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3146":586,"_27538":456,"_19130":46631,"_5":13154,"_26074":46285,"_2645":46632},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3146":587,"_27538":456,"_19130":46634,"_5":13154,"_26074":46289,"_2645":46635},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3146":588,"_27538":456,"_19130":46637,"_5":13154,"_26074":46293,"_2645":46638},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3146":589,"_27538":456,"_19130":46640,"_5":13154,"_26074":46297,"_2645":46641},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3146":590,"_27538":456,"_19130":46643,"_5":13154,"_26074":46301,"_2645":46644},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3146":591,"_27538":456,"_19130":46646,"_5":13154,"_26074":46301,"_2645":46647},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3146":592,"_27538":456,"_19130":46649,"_5":13154,"_26074":46305,"_2645":46650},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3146":593,"_27538":456,"_19130":46652,"_5":13154,"_26074":46305,"_2645":46653},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3146":594,"_27538":456,"_19130":46655,"_5":13154,"_26074":46305,"_2645":46656},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3146":595,"_27538":456,"_19130":46658,"_5":13154,"_26074":46305,"_2645":46659},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3146":596,"_27538":456,"_19130":46661,"_5":13154,"_26074":46305,"_2645":46662},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3146":597,"_27538":456,"_19130":46664,"_5":13154,"_26074":46305,"_2645":46665},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3146":598,"_27538":456,"_19130":46667,"_5":13154,"_26074":46305,"_2645":46668},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3146":599,"_27538":456,"_19130":46670,"_5":13154,"_26074":46305,"_2645":46671},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3146":600,"_27538":456,"_19130":46673,"_5":13154,"_26074":46309,"_2645":46674},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3146":601,"_27538":456,"_19130":46676,"_5":13154,"_26074":46309,"_2645":46677},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3146":602,"_27538":456,"_19130":46679,"_5":13154,"_26074":46309,"_2645":46680},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3146":603,"_27538":456,"_19130":46682,"_5":13154,"_26074":46313,"_2645":46683},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3146":604,"_27538":456,"_19130":46685,"_5":13154,"_26074":46313,"_2645":46686},[],"Use groups or stable roles for people and independent identities for automations.",{"_3146":605,"_27538":456,"_19130":46688,"_5":13154,"_26074":46313,"_2645":46689},[],"Keep at least two recovery administrators and test their access periodically.",{"_3146":606,"_27538":456,"_19130":46691,"_5":13154,"_26074":46313,"_2645":46692},[],"Review active principals, their matches and their grants after IdP changes.",{"_3146":607,"_27538":456,"_19130":46694,"_5":13154,"_26074":46313,"_2645":46695},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3146":608,"_27538":456,"_19130":46697,"_5":13154,"_26074":46313,"_2645":46698},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3146":609,"_27538":456,"_19130":46700,"_5":13154,"_26074":46313,"_2645":46701},[],"Always test one allowed and one denied operation for each role.",{"_3146":610,"_27538":456,"_19130":46703,"_5":13154,"_26074":46313,"_2645":46704},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3146":611,"_27538":456,"_19130":46706,"_5":13154,"_26074":46321,"_2645":46707},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3146":612,"_27538":456,"_19130":46709,"_5":13154,"_26074":46325,"_2645":46710},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3146":613,"_27538":456,"_19130":46712,"_5":13154,"_26074":46325,"_2645":46713},[],"that an active principal of the correct type exists;",{"_3146":614,"_27538":456,"_19130":46715,"_5":13154,"_26074":46325,"_2645":46716},[],"that the claim paths and values match the real token exactly;",{"_3146":615,"_27538":456,"_19130":46718,"_5":13154,"_26074":46325,"_2645":46719},[],"that all of the principal's conditions hold;",{"_3146":616,"_27538":456,"_19130":46721,"_5":13154,"_26074":46325,"_2645":46722},[],"that the principal has the expected policy granted;",{"_3146":617,"_27538":456,"_19130":46724,"_5":13154,"_26074":46325,"_2645":46725},[],"that the policy includes the action and the requested resource type or route;",{"_3146":618,"_27538":456,"_19130":46727,"_5":13154,"_26074":46325,"_2645":46728},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3146":619,"_27538":456,"_19130":46730,"_5":13154,"_26074":46325,"_2645":46731},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3146":620,"_27538":456,"_19130":46733,"_5":13154,"_26074":46329,"_2645":46734},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3146":621,"_27538":456,"_19130":46736,"_5":13154,"_26074":46333,"_2645":46737},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3146":622,"_27538":456,"_19130":46739,"_5":13154,"_26074":46337,"_2645":46740},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3146":623,"_27538":456,"_19130":46742,"_5":13154,"_26074":46337,"_2645":46743},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3146":624,"_27538":624,"_5":13480,"_2645":46745,"_27881":46746,"_19130":46747,"_26074":624},"Alerts and subscriptions",[44830,46210,46211],[],{"_3146":625,"_27538":624,"_19130":46749,"_5":13154,"_26074":624,"_2645":46750},[],"Send PKI events to people and external systems.",{"_3146":626,"_27538":624,"_5":27878,"_19130":46752,"_26074":46753,"_2645":46754},[],"/docs/pr-preview/pr-26/platform/administration/alerts#how-it-works","How it works",{"_3146":627,"_27538":624,"_5":27878,"_19130":46756,"_26074":46757,"_2645":46758},[],"/docs/pr-preview/pr-26/platform/administration/alerts#available-channels","Available channels",{"_3146":628,"_27538":624,"_5":27878,"_19130":46760,"_26074":46761,"_2645":46762},[],"/docs/pr-preview/pr-26/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3146":629,"_27538":624,"_5":27878,"_19130":46764,"_26074":46765,"_2645":46766},[],"/docs/pr-preview/pr-26/platform/administration/alerts#choose-the-event","Choose the event",{"_3146":630,"_27538":624,"_5":27878,"_19130":46768,"_26074":46769,"_2645":46770},[],"/docs/pr-preview/pr-26/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3146":631,"_27538":624,"_5":27878,"_19130":46772,"_26074":46773,"_2645":46774},[],"/docs/pr-preview/pr-26/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3146":632,"_27538":624,"_5":27878,"_19130":46776,"_26074":46777,"_2645":46778},[],"/docs/pr-preview/pr-26/platform/administration/alerts#review-and-activate","Review and activate",{"_3146":633,"_27538":624,"_5":27878,"_19130":46780,"_26074":46781,"_2645":46782},[],"/docs/pr-preview/pr-26/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3146":634,"_27538":624,"_5":27878,"_19130":46784,"_26074":46785,"_2645":46786},[],"/docs/pr-preview/pr-26/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3146":635,"_27538":624,"_5":27878,"_19130":46788,"_26074":46789,"_2645":46790},[],"/docs/pr-preview/pr-26/platform/administration/alerts#event-families","Event families",{"_3146":636,"_27538":624,"_19130":46792,"_5":13154,"_26074":624,"_2645":46793},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3146":637,"_27538":624,"_19130":46795,"_5":13154,"_26074":46753,"_2645":46796},[],"A service publishes a domain event.",{"_3146":638,"_27538":624,"_19130":46798,"_5":13154,"_26074":46753,"_2645":46799},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3146":639,"_27538":624,"_19130":46801,"_5":13154,"_26074":46753,"_2645":46802},[],"Each subscription's filter decides whether it should be notified.",{"_3146":640,"_27538":624,"_19130":46804,"_5":13154,"_26074":46753,"_2645":46805},[],"Lamassu delivers the event to the configured channel.",{"_3146":641,"_27538":624,"_19130":46807,"_5":13154,"_26074":46753,"_2645":46808},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3146":642,"_27538":624,"_19130":46810,"_5":13154,"_26074":46757,"_2645":46811},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3146":643,"_27538":624,"_19130":46813,"_5":13154,"_26074":46757,"_2645":46814},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3146":644,"_27538":624,"_19130":46816,"_5":13154,"_26074":46757,"_2645":46817},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3146":645,"_27538":624,"_19130":46819,"_5":13154,"_26074":46757,"_2645":46820},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3146":646,"_27538":624,"_19130":46822,"_5":13154,"_26074":46757,"_2645":46823},[],"`apikey_options` requires `header` and `key`.",{"_3146":647,"_27538":624,"_19130":46825,"_5":13154,"_26074":46757,"_2645":46826},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3146":648,"_27538":624,"_19130":46828,"_5":13154,"_26074":46757,"_2645":46829},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3146":649,"_27538":624,"_19130":46831,"_5":13154,"_26074":46757,"_2645":46832},[],"The alerts API reference documents the full `http_client` schema.",{"_3146":650,"_27538":624,"_19130":46834,"_5":13154,"_26074":46765,"_2645":46835},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3146":651,"_27538":624,"_19130":46837,"_5":13154,"_26074":46769,"_2645":46838},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3146":652,"_27538":624,"_19130":46840,"_5":13154,"_26074":46773,"_2645":46841},[],"Add a filter if you don't want to receive every instance of the event.",{"_3146":653,"_27538":624,"_19130":46843,"_5":13154,"_26074":46773,"_2645":46844},[],"**None** notifies all instances of the event.",{"_3146":654,"_27538":624,"_19130":46846,"_5":13154,"_26074":46773,"_2645":46847},[],"**JSON Path** evaluates one or more specific fields.",{"_3146":655,"_27538":624,"_19130":46849,"_5":13154,"_26074":46773,"_2645":46850},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3146":656,"_27538":624,"_19130":46852,"_5":13154,"_26074":46773,"_2645":46853},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3146":657,"_27538":624,"_19130":46855,"_5":13154,"_26074":46773,"_2645":46856},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3146":658,"_27538":624,"_19130":46858,"_5":13154,"_26074":46777,"_2645":46859},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3146":659,"_27538":624,"_19130":46861,"_5":13154,"_26074":46781,"_2645":46862},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3146":660,"_27538":624,"_19130":46864,"_5":13154,"_26074":46781,"_2645":46865},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3146":661,"_27538":624,"_19130":46867,"_5":13154,"_26074":46781,"_2645":46868},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3146":662,"_27538":624,"_19130":46870,"_5":13154,"_26074":46781,"_2645":46871},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3146":663,"_27538":624,"_19130":46873,"_5":13154,"_26074":46781,"_2645":46874},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3146":664,"_27538":624,"_19130":46876,"_5":13154,"_26074":46781,"_2645":46877},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3146":665,"_27538":624,"_19130":46879,"_5":13154,"_26074":46781,"_2645":46880},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3146":666,"_27538":624,"_19130":46882,"_5":13154,"_26074":46781,"_2645":46883},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3146":667,"_27538":624,"_19130":46885,"_5":13154,"_26074":46785,"_2645":46886},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3146":668,"_27538":624,"_19130":46888,"_5":13154,"_26074":46789,"_2645":46889},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3146":669,"_27538":624,"_19130":46891,"_5":13154,"_26074":46789,"_2645":46892},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3146":670,"_27538":624,"_19130":46894,"_5":13154,"_26074":46789,"_2645":46895},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3146":671,"_27538":624,"_19130":46897,"_5":13154,"_26074":46789,"_2645":46898},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3146":672,"_27538":624,"_19130":46900,"_5":13154,"_26074":46789,"_2645":46901},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3146":673,"_27538":624,"_19130":46903,"_5":13154,"_26074":46789,"_2645":46904},[],"**Validation:** `va.role.crl.create`.",{"_3146":674,"_27538":624,"_19130":46906,"_5":13154,"_26074":46789,"_2645":46907},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3146":675,"_27538":624,"_19130":46909,"_5":13154,"_26074":46789,"_2645":46910},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3146":676,"_27538":676,"_5":13480,"_2645":46912,"_27881":46913,"_19130":46914,"_26074":676},"Audit logs",[44830,46210,46211],[],{"_3146":677,"_27538":676,"_19130":46916,"_5":13154,"_26074":676,"_2645":46917},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3146":678,"_27538":676,"_5":27878,"_19130":46919,"_26074":46920,"_2645":46921},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3146":679,"_27538":676,"_5":27878,"_19130":46923,"_26074":46924,"_2645":46925},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#coverage","Coverage",{"_3146":680,"_27538":676,"_5":27878,"_19130":46927,"_26074":46928,"_2645":46929},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3146":681,"_27538":676,"_5":27878,"_19130":46931,"_26074":46932,"_2645":46933},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3146":682,"_27538":676,"_5":27878,"_19130":46935,"_26074":46936,"_2645":46937},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3146":683,"_27538":676,"_5":27878,"_19130":46939,"_26074":46940,"_2645":46941},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3146":684,"_27538":676,"_5":27878,"_19130":46943,"_26074":46944,"_2645":46945},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3146":685,"_27538":676,"_5":27878,"_19130":46947,"_26074":46948,"_2645":46949},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3146":686,"_27538":676,"_5":27878,"_19130":46951,"_26074":46952,"_2645":46953},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3146":687,"_27538":676,"_5":27878,"_19130":46955,"_26074":46956,"_2645":46957},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3146":688,"_27538":676,"_5":27878,"_19130":46959,"_26074":46960,"_2645":46961},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3146":689,"_27538":676,"_19130":46963,"_5":13154,"_26074":676,"_2645":46964},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3146":690,"_27538":676,"_19130":46966,"_5":13154,"_26074":46920,"_2645":46967},[],"The audit body includes:",{"_3146":691,"_27538":676,"_19130":46969,"_5":13154,"_26074":46920,"_2645":46970},[],"input: data received by the operation;",{"_3146":692,"_27538":676,"_19130":46972,"_5":13154,"_26074":46920,"_2645":46973},[],"has\\_error: whether the service returned an error;",{"_3146":693,"_27538":676,"_19130":46975,"_5":13154,"_26074":46920,"_2645":46976},[],"output: produced result or error message;",{"_3146":694,"_27538":676,"_19130":46978,"_5":13154,"_26074":46920,"_2645":46979},[],"principals: identifiers of the principals that matched the request.",{"_3146":695,"_27538":676,"_19130":46981,"_5":13154,"_26074":46920,"_2645":46982},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3146":696,"_27538":676,"_19130":46984,"_5":13154,"_26074":46920,"_2645":46985},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3146":697,"_27538":676,"_19130":46987,"_5":13154,"_26074":46924,"_2645":46988},[],"The backend applies auditing to mutations of:",{"_3146":698,"_27538":676,"_19130":46990,"_5":13154,"_26074":46924,"_2645":46991},[],"authorities, certificates and issuance profiles;",{"_3146":699,"_27538":676,"_19130":46993,"_5":13154,"_26074":46924,"_2645":46994},[],"keys and KMS engines;",{"_3146":700,"_27538":676,"_19130":46996,"_5":13154,"_26074":46924,"_2645":46997},[],"devices and identities;",{"_3146":701,"_27538":676,"_19130":46999,"_5":13154,"_26074":46924,"_2645":47000},[],"DMSs and enrollment operations;",{"_3146":702,"_27538":676,"_19130":47002,"_5":13154,"_26074":46924,"_2645":47003},[],"validation functions and CRL;",{"_3146":703,"_27538":676,"_19130":47005,"_5":13154,"_26074":46924,"_2645":47006},[],"principals, policies and authorization grants.",{"_3146":704,"_27538":676,"_19130":47008,"_5":13154,"_26074":46924,"_2645":47009},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3146":705,"_27538":676,"_19130":47011,"_5":13154,"_26074":46928,"_2645":47012},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3146":706,"_27538":676,"_19130":47014,"_5":13154,"_26074":46928,"_2645":47015},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3146":707,"_27538":676,"_19130":47017,"_5":13154,"_26074":46928,"_2645":47018},[],"Design the consumer to:",{"_3146":708,"_27538":676,"_19130":47020,"_5":13154,"_26074":46928,"_2645":47021},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3146":709,"_27538":676,"_19130":47023,"_5":13154,"_26074":46928,"_2645":47024},[],"keep the complete CloudEvent unmodified;",{"_3146":710,"_27538":676,"_19130":47026,"_5":13154,"_26074":46928,"_2645":47027},[],"record the ingestion time and detect duplicates by ID;",{"_3146":711,"_27538":676,"_19130":47029,"_5":13154,"_26074":46928,"_2645":47030},[],"encrypt in transit and at rest;",{"_3146":712,"_27538":676,"_19130":47032,"_5":13154,"_26074":46928,"_2645":47033},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3146":713,"_27538":676,"_19130":47035,"_5":13154,"_26074":46928,"_2645":47036},[],"apply an explicit retention and legal hold policy;",{"_3146":714,"_27538":676,"_19130":47038,"_5":13154,"_26074":46928,"_2645":47039},[],"alert if it stops consuming or the pending queue grows.",{"_3146":715,"_27538":676,"_19130":47041,"_5":13154,"_26074":46932,"_2645":47042},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3146":716,"_27538":676,"_19130":47044,"_5":13154,"_26074":46932,"_2645":47045},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3146":717,"_27538":676,"_19130":47047,"_5":13154,"_26074":46940,"_2645":47048},[],"Start from the reported time and normalize every source to UTC.",{"_3146":718,"_27538":676,"_19130":47050,"_5":13154,"_26074":46944,"_2645":47051},[],"Filter by event type, service source and resource identifier.",{"_3146":719,"_27538":676,"_19130":47053,"_5":13154,"_26074":46948,"_2645":47054},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3146":720,"_27538":676,"_19130":47056,"_5":13154,"_26074":46952,"_2645":47057},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3146":721,"_27538":676,"_19130":47059,"_5":13154,"_26074":46956,"_2645":47060},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3146":722,"_27538":676,"_19130":47062,"_5":13154,"_26074":46960,"_2645":47063},[],"Generate a controlled mutation in a test environment and check that:",{"_3146":723,"_27538":676,"_19130":47065,"_5":13154,"_26074":46960,"_2645":47066},[],"a successful audit event appears;",{"_3146":724,"_27538":676,"_19130":47068,"_5":13154,"_26074":46960,"_2645":47069},[],"the principal matches the identity used;",{"_3146":725,"_27538":676,"_19130":47071,"_5":13154,"_26074":46960,"_2645":47072},[],"the consumer persists it exactly once;",{"_3146":726,"_27538":676,"_19130":47074,"_5":13154,"_26074":46960,"_2645":47075},[],"it can be retrieved by resource, actor and period;",{"_3146":727,"_27538":676,"_19130":47077,"_5":13154,"_26074":46960,"_2645":47078},[],"a consumer outage raises an alert.",{"_3146":728,"_27538":676,"_19130":47080,"_5":13154,"_26074":46960,"_2645":47081},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3146":729,"_27538":729,"_5":13480,"_2645":47083,"_27881":47084,"_19130":47085,"_26074":729},"Platform architecture",[44830,46210],[],{"_3146":730,"_27538":729,"_19130":47087,"_5":13154,"_26074":729,"_2645":47088},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3146":731,"_27538":729,"_5":27878,"_19130":47090,"_26074":47091,"_2645":47092},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#control-plane","Control plane",{"_3146":732,"_27538":729,"_5":27878,"_19130":47094,"_26074":47095,"_2645":47096},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3146":733,"_27538":729,"_5":27878,"_19130":47098,"_26074":47099,"_2645":47100},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3146":734,"_27538":729,"_5":27878,"_19130":47102,"_26074":47103,"_2645":47104},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#status-and-validation","Status and validation",{"_3146":735,"_27538":729,"_5":27878,"_19130":47106,"_26074":47107,"_2645":47108},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3146":736,"_27538":729,"_19130":47110,"_5":13154,"_26074":729,"_2645":47111},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3146":737,"_27538":729,"_19130":47113,"_5":13154,"_26074":729,"_2645":47114},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3146":738,"_27538":729,"_19130":47116,"_5":13154,"_26074":47091,"_2645":47117},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3146":739,"_27538":729,"_19130":47119,"_5":13154,"_26074":47095,"_2645":47120},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3146":740,"_27538":729,"_19130":47122,"_5":13154,"_26074":47099,"_2645":47123},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3146":741,"_27538":729,"_19130":47125,"_5":13154,"_26074":47103,"_2645":47126},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3146":742,"_27538":729,"_19130":47128,"_5":13154,"_26074":47107,"_2645":47129},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3146":743,"_27538":743,"_5":13480,"_2645":47131,"_27881":47132,"_19130":47133,"_26074":743},"How Lamassu works",[44830,46210],[],{"_3146":744,"_27538":743,"_19130":47135,"_5":13154,"_26074":743,"_2645":47136},[],"The mental model of trust, keys, certificates and devices.",{"_3146":745,"_27538":743,"_5":27878,"_19130":47138,"_26074":47139,"_2645":47140},[],"/docs/pr-preview/pr-26/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3146":746,"_27538":743,"_5":27878,"_19130":47142,"_26074":47143,"_2645":47144},[],"/docs/pr-preview/pr-26/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3146":747,"_27538":743,"_19130":47146,"_5":13154,"_26074":743,"_2645":47147},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3146":748,"_27538":743,"_19130":47149,"_5":13154,"_26074":47139,"_2645":47150},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3146":749,"_27538":743,"_19130":47152,"_5":13154,"_26074":47139,"_2645":47153},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3146":750,"_27538":743,"_19130":47155,"_5":13154,"_26074":47139,"_2645":47156},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3146":751,"_27538":743,"_19130":47158,"_5":13154,"_26074":47139,"_2645":47159},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3146":752,"_27538":743,"_19130":47161,"_5":13154,"_26074":47139,"_2645":47162},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3146":753,"_27538":743,"_19130":47164,"_5":13154,"_26074":47143,"_2645":47165},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3146":754,"_27538":743,"_19130":47167,"_5":13154,"_26074":47143,"_2645":47168},[],"A DMS relates that CA to an enrollment policy.",{"_3146":755,"_27538":743,"_19130":47170,"_5":13154,"_26074":47143,"_2645":47171},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3146":756,"_27538":743,"_19130":47173,"_5":13154,"_26074":47143,"_2645":47174},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3146":757,"_27538":743,"_19130":47176,"_5":13154,"_26074":47143,"_2645":47177},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3146":758,"_27538":743,"_19130":47179,"_5":13154,"_26074":47143,"_2645":47180},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3146":759,"_27538":743,"_19130":47182,"_5":13154,"_26074":47143,"_2645":47183},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3146":760,"_27538":760,"_5":13480,"_2645":47185,"_27881":47186,"_19130":47188,"_26074":760},"Devices and identities",[44830,46210,47187,47185],"IoT Fleets",[],{"_3146":761,"_27538":760,"_19130":47190,"_5":13154,"_26074":760,"_2645":47191},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3146":762,"_27538":760,"_5":27878,"_19130":47193,"_26074":47194,"_2645":47195},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#device-states","Device states",{"_3146":763,"_27538":760,"_5":27878,"_19130":47197,"_26074":47198,"_2645":47199},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3146":764,"_27538":760,"_5":27878,"_19130":47201,"_26074":47202,"_2645":47203},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3146":765,"_27538":760,"_5":27878,"_19130":47205,"_26074":47206,"_2645":47207},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3146":766,"_27538":760,"_5":27878,"_19130":47209,"_26074":47210,"_2645":47211},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3146":767,"_27538":760,"_5":27878,"_19130":47213,"_26074":47214,"_2645":47215},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3146":768,"_27538":760,"_5":27878,"_19130":47217,"_26074":47218,"_2645":47219},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3146":769,"_27538":760,"_5":27878,"_19130":47221,"_26074":47222,"_2645":47223},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3146":770,"_27538":760,"_5":27878,"_19130":47225,"_26074":47226,"_2645":47227},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3146":771,"_27538":760,"_5":27878,"_19130":47229,"_26074":47230,"_2645":47231},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3146":772,"_27538":760,"_5":27878,"_19130":47233,"_26074":47234,"_2645":47235},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3146":773,"_27538":760,"_19130":47237,"_5":13154,"_26074":760,"_2645":47238},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3146":774,"_27538":760,"_19130":47240,"_5":13154,"_26074":760,"_2645":47241},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3146":775,"_27538":760,"_19130":47243,"_5":13154,"_26074":47194,"_2645":47244},[],"Operational view",{"_3146":776,"_27538":760,"_19130":47246,"_5":13154,"_26074":47194,"_2645":47247},[],"Meaning",{"_3146":777,"_27538":760,"_19130":47249,"_5":13154,"_26074":47194,"_2645":47250},[],"**No Identity**",{"_3146":778,"_27538":760,"_19130":47252,"_5":13154,"_26074":47194,"_2645":47253},[],"A record exists without an associated identity.",{"_3146":779,"_27538":760,"_19130":47255,"_5":13154,"_26074":47194,"_2645":47256},[],"**Active**",{"_3146":780,"_27538":760,"_19130":47258,"_5":13154,"_26074":47194,"_2645":47259},[],"The slot is active; also check certificate dates, status and usages.",{"_3146":781,"_27538":760,"_19130":47261,"_5":13154,"_26074":47194,"_2645":47262},[],"**Renewal Pending**",{"_3146":782,"_27538":760,"_19130":47264,"_5":13154,"_26074":47194,"_2645":47265},[],"The identity is in the operational renewal window.",{"_3146":783,"_27538":760,"_19130":47267,"_5":13154,"_26074":47194,"_2645":47268},[],"**Expiring Soon**",{"_3146":784,"_27538":760,"_19130":47270,"_5":13154,"_26074":47194,"_2645":47271},[],"Expiration is approaching according to configured thresholds.",{"_3146":785,"_27538":760,"_19130":47273,"_5":13154,"_26074":47194,"_2645":47274},[],"**Expired**",{"_3146":786,"_27538":760,"_19130":47276,"_5":13154,"_26074":47194,"_2645":47277},[],"The identity has expired.",{"_3146":787,"_27538":760,"_19130":47279,"_5":13154,"_26074":47194,"_2645":47280},[],"**Revoked**",{"_3146":788,"_27538":760,"_19130":47282,"_5":13154,"_26074":47194,"_2645":47283},[],"The identity is marked revoked.",{"_3146":789,"_27538":760,"_19130":47285,"_5":13154,"_26074":47194,"_2645":47286},[],"**Decommissioned**",{"_3146":790,"_27538":760,"_19130":47288,"_5":13154,"_26074":47194,"_2645":47289},[],"The record is retired and ordinary updates do not restore operation.",{"_3146":791,"_27538":760,"_19130":47291,"_5":13154,"_26074":47194,"_2645":47292},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3146":792,"_27538":760,"_19130":47294,"_5":13154,"_26074":47198,"_2645":47295},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3146":793,"_27538":760,"_19130":47297,"_5":13154,"_26074":47198,"_2645":47298},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3146":794,"_27538":760,"_19130":47300,"_5":13154,"_26074":47198,"_2645":47301},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3146":795,"_27538":760,"_19130":47303,"_5":13154,"_26074":47198,"_2645":47304},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3146":796,"_27538":760,"_19130":47306,"_5":13154,"_26074":47202,"_2645":47307},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3146":797,"_27538":760,"_19130":47309,"_5":13154,"_26074":47206,"_2645":47310},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3146":798,"_27538":760,"_19130":47312,"_5":13154,"_26074":47210,"_2645":47313},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3146":799,"_27538":760,"_19130":47315,"_5":13154,"_26074":47214,"_2645":47316},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3146":800,"_27538":760,"_19130":47318,"_5":13154,"_26074":47218,"_2645":47319},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3146":801,"_27538":760,"_19130":47321,"_5":13154,"_26074":47218,"_2645":47322},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3146":802,"_27538":760,"_19130":47324,"_5":13154,"_26074":47222,"_2645":47325},[],"From **No Identity**, use **Assign Identity**:",{"_3146":803,"_27538":760,"_19130":47327,"_5":13154,"_26074":47222,"_2645":47328},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3146":804,"_27538":760,"_19130":47330,"_5":13154,"_26074":47222,"_2645":47331},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3146":805,"_27538":760,"_19130":47333,"_5":13154,"_26074":47222,"_2645":47334},[],"Confirm and read the serial, active version and history again.",{"_3146":806,"_27538":760,"_19130":47336,"_5":13154,"_26074":47222,"_2645":47337},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3146":807,"_27538":760,"_19130":47339,"_5":13154,"_26074":47222,"_2645":47340},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3146":808,"_27538":760,"_19130":47342,"_5":13154,"_26074":47226,"_2645":47343},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3146":809,"_27538":760,"_19130":47345,"_5":13154,"_26074":47226,"_2645":47346},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3146":810,"_27538":760,"_19130":47348,"_5":13154,"_26074":47230,"_2645":47349},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3146":811,"_27538":760,"_19130":47351,"_5":13154,"_26074":47230,"_2645":47352},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3146":812,"_27538":760,"_19130":47354,"_5":13154,"_26074":47230,"_2645":47355},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3146":813,"_27538":760,"_19130":47357,"_5":13154,"_26074":47230,"_2645":47358},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3146":814,"_27538":760,"_19130":47360,"_5":13154,"_26074":47234,"_2645":47361},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3146":815,"_27538":760,"_19130":47363,"_5":13154,"_26074":47234,"_2645":47364},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3146":816,"_27538":816,"_5":13480,"_2645":47366,"_27881":47367,"_19130":47369,"_26074":816},"Bootstrap identity and authentication",[44830,46210,47187,47185,47368],"Enrollment with PKI",[],{"_3146":817,"_27538":816,"_19130":47371,"_5":13154,"_26074":816,"_2645":47372},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3146":818,"_27538":816,"_5":27878,"_19130":47374,"_26074":47375,"_2645":47376},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3146":819,"_27538":816,"_5":27878,"_19130":47378,"_26074":47379,"_2645":47380},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3146":820,"_27538":816,"_5":27878,"_19130":47382,"_26074":47383,"_2645":47384},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3146":821,"_27538":816,"_5":27878,"_19130":47386,"_26074":47387,"_2645":47388},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3146":822,"_27538":816,"_5":27878,"_19130":47390,"_26074":47391,"_2645":47392},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3146":823,"_27538":816,"_19130":47394,"_5":13154,"_26074":816,"_2645":47395},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3146":824,"_27538":816,"_19130":47397,"_5":13154,"_26074":47375,"_2645":47398},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3146":825,"_27538":816,"_19130":47400,"_5":13154,"_26074":47375,"_2645":47401},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3146":826,"_27538":816,"_19130":47403,"_5":13154,"_26074":47379,"_2645":47404},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3146":827,"_27538":816,"_19130":47406,"_5":13154,"_26074":47379,"_2645":47407},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3146":828,"_27538":816,"_19130":47409,"_5":13154,"_26074":47379,"_2645":47410},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3146":829,"_27538":816,"_19130":47412,"_5":13154,"_26074":47383,"_2645":47413},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3146":830,"_27538":816,"_19130":47415,"_5":13154,"_26074":47383,"_2645":47416},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3146":831,"_27538":816,"_19130":47418,"_5":13154,"_26074":47387,"_2645":47419},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3146":832,"_27538":816,"_19130":47421,"_5":13154,"_26074":47387,"_2645":47422},[],"Example body:",{"_3146":833,"_27538":816,"_19130":47424,"_5":13154,"_26074":47387,"_2645":47425},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3146":834,"_27538":816,"_19130":47427,"_5":13154,"_26074":47387,"_2645":47428},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3146":835,"_27538":816,"_19130":47430,"_5":13154,"_26074":47387,"_2645":47431},[],"Continuation requires a successful HTTP response and JSON:",{"_3146":836,"_27538":816,"_19130":47433,"_5":13154,"_26074":47387,"_2645":47434},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3146":837,"_27538":816,"_19130":47436,"_5":13154,"_26074":47391,"_2645":47437},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3146":838,"_27538":816,"_19130":47439,"_5":13154,"_26074":47391,"_2645":47440},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3146":839,"_27538":839,"_5":13480,"_2645":47442,"_27881":47443,"_19130":47444,"_26074":839},"Configure and operate the DMS",[44830,46210,47187,47185,47368],[],{"_3146":840,"_27538":839,"_19130":47446,"_5":13154,"_26074":839,"_2645":47447},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3146":841,"_27538":839,"_5":27878,"_19130":47449,"_26074":47450,"_2645":44840},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3146":842,"_27538":839,"_5":27878,"_19130":47452,"_26074":47453,"_2645":47454},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3146":843,"_27538":839,"_5":27878,"_19130":47456,"_26074":47457,"_2645":47458},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3146":844,"_27538":839,"_5":27878,"_19130":47460,"_26074":47461,"_2645":47462},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3146":845,"_27538":839,"_5":27878,"_19130":47464,"_26074":47465,"_2645":47466},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3146":846,"_27538":839,"_5":27878,"_19130":47468,"_26074":47469,"_2645":47470},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3146":847,"_27538":839,"_5":27878,"_19130":47472,"_26074":47473,"_2645":47474},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3146":848,"_27538":839,"_5":27878,"_19130":47476,"_26074":47477,"_2645":47478},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3146":849,"_27538":839,"_5":27878,"_19130":47480,"_26074":47481,"_2645":47482},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3146":850,"_27538":839,"_5":27878,"_19130":47484,"_26074":47485,"_2645":47486},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3146":851,"_27538":839,"_5":27878,"_19130":47488,"_26074":47489,"_2645":47490},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3146":852,"_27538":839,"_5":27878,"_19130":47492,"_26074":47493,"_2645":47494},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3146":853,"_27538":839,"_5":27878,"_19130":47496,"_26074":47497,"_2645":47498},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3146":854,"_27538":839,"_5":27878,"_19130":47500,"_26074":47501,"_2645":47502},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3146":855,"_27538":839,"_5":27878,"_19130":47504,"_26074":47505,"_2645":47506},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3146":856,"_27538":839,"_5":27878,"_19130":47508,"_26074":47509,"_2645":47510},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3146":857,"_27538":839,"_5":27878,"_19130":47512,"_26074":47513,"_2645":47514},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3146":858,"_27538":839,"_5":27878,"_19130":47516,"_26074":47517,"_2645":47518},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3146":859,"_27538":839,"_19130":47520,"_5":13154,"_26074":839,"_2645":47521},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3146":860,"_27538":839,"_19130":47523,"_5":13154,"_26074":47450,"_2645":47524},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3146":861,"_27538":839,"_19130":47526,"_5":13154,"_26074":47450,"_2645":47527},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3146":862,"_27538":839,"_19130":47529,"_5":13154,"_26074":47457,"_2645":47530},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3146":863,"_27538":839,"_19130":47532,"_5":13154,"_26074":47461,"_2645":47533},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3146":864,"_27538":839,"_19130":47535,"_5":13154,"_26074":47465,"_2645":47536},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3146":865,"_27538":839,"_19130":47538,"_5":13154,"_26074":47469,"_2645":47539},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3146":866,"_27538":839,"_19130":47541,"_5":13154,"_26074":47473,"_2645":47542},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3146":867,"_27538":839,"_19130":47544,"_5":13154,"_26074":47481,"_2645":47545},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3146":868,"_27538":839,"_19130":47547,"_5":13154,"_26074":47481,"_2645":47548},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3146":869,"_27538":839,"_19130":47550,"_5":13154,"_26074":47485,"_2645":47551},[],"`settings.enrollment_settings` field",{"_3146":870,"_27538":839,"_19130":47553,"_5":13154,"_26074":47485,"_2645":47554},[],"Decision",{"_3146":871,"_27538":839,"_19130":47556,"_5":13154,"_26074":47485,"_2645":47557},[],"`protocol`",{"_3146":872,"_27538":839,"_19130":47559,"_5":13154,"_26074":47485,"_2645":47560},[],"`EST_RFC7030` for these operations.",{"_3146":873,"_27538":839,"_19130":47562,"_5":13154,"_26074":47485,"_2645":47563},[],"`enrollment_ca`",{"_3146":874,"_27538":839,"_19130":47565,"_5":13154,"_26074":47485,"_2645":47566},[],"ID of the signing CA.",{"_3146":875,"_27538":839,"_19130":47568,"_5":13154,"_26074":47485,"_2645":47569},[],"`verify_csr_signature`",{"_3146":876,"_27538":839,"_19130":47571,"_5":13154,"_26074":47485,"_2645":47572},[],"Keep `true` to verify CSR key possession.",{"_3146":877,"_27538":839,"_19130":47574,"_5":13154,"_26074":47485,"_2645":47575},[],"`enable_replaceable_enrollment`",{"_3146":878,"_27538":839,"_19130":47577,"_5":13154,"_26074":47485,"_2645":47578},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3146":879,"_27538":839,"_19130":47580,"_5":13154,"_26074":47485,"_2645":47581},[],"`est_rfc7030_settings.auth_mode`",{"_3146":880,"_27538":839,"_19130":47583,"_5":13154,"_26074":47485,"_2645":47584},[],"One of the four authentication modes.",{"_3146":881,"_27538":839,"_19130":47586,"_5":13154,"_26074":47485,"_2645":47587},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3146":882,"_27538":839,"_19130":47589,"_5":13154,"_26074":47489,"_2645":47590},[],"The blocks are independent:",{"_3146":883,"_27538":839,"_19130":47592,"_5":13154,"_26074":47489,"_2645":47593},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3146":884,"_27538":839,"_19130":47595,"_5":13154,"_26074":47489,"_2645":47596},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3146":885,"_27538":839,"_19130":47598,"_5":13154,"_26074":47489,"_2645":47599},[],"`auth_mode`",{"_3146":886,"_27538":839,"_19130":47601,"_5":13154,"_26074":47489,"_2645":47602},[],"Control applied in the configured operation",{"_3146":887,"_27538":839,"_19130":47604,"_5":13154,"_26074":47489,"_2645":47605},[],"`CLIENT_CERTIFICATE`",{"_3146":888,"_27538":839,"_19130":47607,"_5":13154,"_26074":47489,"_2645":47608},[],"Presented certificate validation.",{"_3146":889,"_27538":839,"_19130":47610,"_5":13154,"_26074":47489,"_2645":47611},[],"`EXTERNAL_WEBHOOK`",{"_3146":890,"_27538":839,"_19130":47613,"_5":13154,"_26074":47489,"_2645":47614},[],"Configured webhook authorization.",{"_3146":891,"_27538":839,"_19130":47616,"_5":13154,"_26074":47489,"_2645":47617},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3146":892,"_27538":839,"_19130":47619,"_5":13154,"_26074":47489,"_2645":47620},[],"Certificate validation followed by webhook approval.",{"_3146":893,"_27538":839,"_19130":47622,"_5":13154,"_26074":47489,"_2645":47623},[],"`NO_AUTH`",{"_3146":894,"_27538":839,"_19130":47625,"_5":13154,"_26074":47489,"_2645":47626},[],"No DMS requester authentication.",{"_3146":895,"_27538":839,"_19130":47628,"_5":13154,"_26074":47489,"_2645":47629},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3146":896,"_27538":839,"_19130":47631,"_5":13154,"_26074":47489,"_2645":47632},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3146":897,"_27538":839,"_19130":47634,"_5":13154,"_26074":47489,"_2645":47635},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3146":898,"_27538":839,"_19130":47637,"_5":13154,"_26074":47489,"_2645":47638},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3146":899,"_27538":839,"_19130":47640,"_5":13154,"_26074":47493,"_2645":47641},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3146":900,"_27538":839,"_19130":47643,"_5":13154,"_26074":47493,"_2645":47644},[],"`external_webhook_settings` field",{"_3146":901,"_27538":839,"_19130":47646,"_5":13154,"_26074":47493,"_2645":47554},[],{"_3146":902,"_27538":839,"_19130":47648,"_5":13154,"_26074":47493,"_2645":47649},[],"`url`",{"_3146":903,"_27538":839,"_19130":47651,"_5":13154,"_26074":47493,"_2645":47652},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3146":904,"_27538":839,"_19130":47654,"_5":13154,"_26074":47493,"_2645":47655},[],"`method`",{"_3146":905,"_27538":839,"_19130":47657,"_5":13154,"_26074":47493,"_2645":47658},[],"`POST` or `PUT`; `POST` by default.",{"_3146":906,"_27538":839,"_19130":47660,"_5":13154,"_26074":47493,"_2645":47661},[],"`name`",{"_3146":907,"_27538":839,"_19130":47663,"_5":13154,"_26074":47493,"_2645":47664},[],"Label used in service logs.",{"_3146":908,"_27538":839,"_19130":47666,"_5":13154,"_26074":47493,"_2645":47667},[],"`config.auth_mode`",{"_3146":909,"_27538":839,"_19130":47669,"_5":13154,"_26074":47493,"_2645":47670},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3146":910,"_27538":839,"_19130":47672,"_5":13154,"_26074":47493,"_2645":47673},[],"`config.apikey_options`",{"_3146":911,"_27538":839,"_19130":47675,"_5":13154,"_26074":47493,"_2645":47676},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3146":912,"_27538":839,"_19130":47678,"_5":13154,"_26074":47493,"_2645":47679},[],"`config.jwt_options`",{"_3146":913,"_27538":839,"_19130":47681,"_5":13154,"_26074":47493,"_2645":47682},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3146":914,"_27538":839,"_19130":47684,"_5":13154,"_26074":47493,"_2645":47685},[],"`config.mtls_options`",{"_3146":915,"_27538":839,"_19130":47687,"_5":13154,"_26074":47493,"_2645":47688},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3146":916,"_27538":839,"_19130":47690,"_5":13154,"_26074":47493,"_2645":47691},[],"`config.insecure_skip_verify`",{"_3146":917,"_27538":839,"_19130":47693,"_5":13154,"_26074":47493,"_2645":47694},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3146":918,"_27538":839,"_19130":47696,"_5":13154,"_26074":47493,"_2645":47697},[],"`config.call_timeout`",{"_3146":919,"_27538":839,"_19130":47699,"_5":13154,"_26074":47493,"_2645":47700},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3146":920,"_27538":839,"_19130":47702,"_5":13154,"_26074":47493,"_2645":47703},[],"Rules for that configuration:",{"_3146":921,"_27538":839,"_19130":47705,"_5":13154,"_26074":47493,"_2645":47706},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3146":922,"_27538":839,"_19130":47708,"_5":13154,"_26074":47493,"_2645":47709},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3146":923,"_27538":839,"_19130":47711,"_5":13154,"_26074":47493,"_2645":47712},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3146":924,"_27538":839,"_19130":47714,"_5":13154,"_26074":47493,"_2645":47715},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3146":925,"_27538":839,"_19130":47717,"_5":13154,"_26074":47493,"_2645":47718},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3146":926,"_27538":839,"_19130":47720,"_5":13154,"_26074":47493,"_2645":47721},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3146":927,"_27538":839,"_19130":47723,"_5":13154,"_26074":47493,"_2645":47724},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_3146":928,"_27538":839,"_19130":47726,"_5":13154,"_26074":47493,"_2645":47727},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3146":929,"_27538":839,"_19130":47729,"_5":13154,"_26074":47493,"_2645":47730},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3146":930,"_27538":839,"_19130":47732,"_5":13154,"_26074":47497,"_2645":47733},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3146":931,"_27538":839,"_19130":47735,"_5":13154,"_26074":47501,"_2645":47736},[],"`settings.reenrollment_settings` field",{"_3146":932,"_27538":839,"_19130":47738,"_5":13154,"_26074":47501,"_2645":45220},[],{"_3146":933,"_27538":839,"_19130":47740,"_5":13154,"_26074":47501,"_2645":47741},[],"`reenrollment_delta`",{"_3146":934,"_27538":839,"_19130":47743,"_5":13154,"_26074":47501,"_2645":47744},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3146":935,"_27538":839,"_19130":47746,"_5":13154,"_26074":47501,"_2645":47747},[],"`preventive_delta`",{"_3146":936,"_27538":839,"_19130":47749,"_5":13154,"_26074":47501,"_2645":47750},[],"Preventive operational monitoring threshold.",{"_3146":937,"_27538":839,"_19130":47752,"_5":13154,"_26074":47501,"_2645":47753},[],"`critical_delta`",{"_3146":938,"_27538":839,"_19130":47755,"_5":13154,"_26074":47501,"_2645":47756},[],"Critical operational monitoring threshold.",{"_3146":939,"_27538":839,"_19130":47758,"_5":13154,"_26074":47501,"_2645":47759},[],"`enable_expired_renewal`",{"_3146":940,"_27538":839,"_19130":47761,"_5":13154,"_26074":47501,"_2645":47762},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3146":941,"_27538":839,"_19130":47764,"_5":13154,"_26074":47501,"_2645":47765},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3146":942,"_27538":839,"_19130":47767,"_5":13154,"_26074":47501,"_2645":47768},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_3146":943,"_27538":839,"_19130":47770,"_5":13154,"_26074":47501,"_2645":47771},[],"`revoke_on_reenrollment`",{"_3146":944,"_27538":839,"_19130":47773,"_5":13154,"_26074":47501,"_2645":47774},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3146":945,"_27538":839,"_19130":47776,"_5":13154,"_26074":47501,"_2645":47777},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3146":946,"_27538":839,"_19130":47779,"_5":13154,"_26074":47505,"_2645":47780},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3146":947,"_27538":839,"_19130":47782,"_5":13154,"_26074":47509,"_2645":45214},[],{"_3146":948,"_27538":839,"_19130":47784,"_5":13154,"_26074":47509,"_2645":47785},[],"Published material",{"_3146":949,"_27538":839,"_19130":47787,"_5":13154,"_26074":47509,"_2645":47788},[],"**Include Lamassu System CA**",{"_3146":950,"_27538":839,"_19130":47790,"_5":13154,"_26074":47509,"_2645":47791},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3146":951,"_27538":839,"_19130":47793,"_5":13154,"_26074":47509,"_2645":47794},[],"**Include Enrollment CA**",{"_3146":952,"_27538":839,"_19130":47796,"_5":13154,"_26074":47509,"_2645":47797},[],"Selected issuing CA certificate.",{"_3146":953,"_27538":839,"_19130":47799,"_5":13154,"_26074":47509,"_2645":47800},[],"**Managed CAs**",{"_3146":954,"_27538":839,"_19130":47802,"_5":13154,"_26074":47509,"_2645":47803},[],"Explicitly selected CA certificates.",{"_3146":955,"_27538":839,"_19130":47805,"_5":13154,"_26074":47509,"_2645":47806},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3146":956,"_27538":839,"_19130":47808,"_5":13154,"_26074":47513,"_2645":47809},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3146":957,"_27538":839,"_19130":47811,"_5":13154,"_26074":47513,"_2645":47812},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3146":958,"_27538":839,"_19130":47814,"_5":13154,"_26074":47513,"_2645":47815},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3146":959,"_27538":839,"_19130":47817,"_5":13154,"_26074":47517,"_2645":47818},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3146":960,"_27538":960,"_5":13480,"_2645":47820,"_27881":47821,"_19130":47822,"_26074":960},"Integrate the EST client",[44830,46210,47187,47185,47368],[],{"_3146":961,"_27538":960,"_19130":47824,"_5":13154,"_26074":960,"_2645":47825},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3146":962,"_27538":960,"_5":27878,"_19130":47827,"_26074":47828,"_2645":44840},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3146":963,"_27538":960,"_5":27878,"_19130":47830,"_26074":47831,"_2645":47832},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3146":964,"_27538":960,"_5":27878,"_19130":47834,"_26074":47835,"_2645":47836},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3146":965,"_27538":960,"_5":27878,"_19130":47838,"_26074":47839,"_2645":47840},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3146":966,"_27538":960,"_5":27878,"_19130":47842,"_26074":47843,"_2645":47844},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3146":967,"_27538":960,"_5":27878,"_19130":47846,"_26074":47847,"_2645":47848},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3146":968,"_27538":960,"_19130":47850,"_5":13154,"_26074":960,"_2645":47851},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3146":969,"_27538":960,"_19130":47853,"_5":13154,"_26074":47828,"_2645":47854},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3146":970,"_27538":960,"_19130":47856,"_5":13154,"_26074":47828,"_2645":47857},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3146":971,"_27538":960,"_19130":47859,"_5":13154,"_26074":47828,"_2645":47860},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3146":972,"_27538":960,"_19130":47862,"_5":13154,"_26074":47831,"_2645":47863},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3146":973,"_27538":960,"_19130":47865,"_5":13154,"_26074":47831,"_2645":47866},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3146":974,"_27538":960,"_19130":47868,"_5":13154,"_26074":47835,"_2645":47869},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3146":975,"_27538":960,"_19130":47871,"_5":13154,"_26074":47835,"_2645":47872},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3146":976,"_27538":960,"_19130":47874,"_5":13154,"_26074":47839,"_2645":47875},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3146":977,"_27538":960,"_19130":47877,"_5":13154,"_26074":47839,"_2645":47878},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3146":978,"_27538":960,"_19130":47880,"_5":13154,"_26074":47843,"_2645":47881},[],"For a root that issues directly:",{"_3146":979,"_27538":960,"_19130":47883,"_5":13154,"_26074":47843,"_2645":47884},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3146":980,"_27538":960,"_19130":47886,"_5":13154,"_26074":47843,"_2645":47887},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3146":981,"_27538":960,"_19130":47889,"_5":13154,"_26074":47847,"_2645":47890},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3146":982,"_27538":982,"_5":13480,"_2645":47892,"_27881":47893,"_19130":47894,"_26074":982},"EST reference",[44830,46210,47187,47185,47368],[],{"_3146":983,"_27538":982,"_19130":47896,"_5":13154,"_26074":982,"_2645":47897},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3146":984,"_27538":982,"_5":27878,"_19130":47899,"_26074":47900,"_2645":47901},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3146":985,"_27538":982,"_5":27878,"_19130":47903,"_26074":47904,"_2645":20791},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3146":986,"_27538":982,"_5":27878,"_19130":47906,"_26074":47907,"_2645":23836},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3146":987,"_27538":982,"_5":27878,"_19130":47909,"_26074":47910,"_2645":23843},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3146":988,"_27538":982,"_5":27878,"_19130":47912,"_26074":47913,"_2645":23189},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3146":989,"_27538":982,"_5":27878,"_19130":47915,"_26074":47916,"_2645":47917},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3146":990,"_27538":982,"_5":27878,"_19130":47919,"_26074":47920,"_2645":47921},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3146":991,"_27538":982,"_5":27878,"_19130":47923,"_26074":47924,"_2645":47925},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3146":992,"_27538":982,"_19130":47927,"_5":13154,"_26074":982,"_2645":47928},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3146":993,"_27538":982,"_19130":47930,"_5":13154,"_26074":47900,"_2645":47931},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3146":994,"_27538":982,"_19130":47933,"_5":13154,"_26074":47900,"_2645":47934},[],"Operation",{"_3146":995,"_27538":982,"_19130":47936,"_5":13154,"_26074":47900,"_2645":47937},[],"Method",{"_3146":996,"_27538":982,"_19130":47939,"_5":13154,"_26074":47900,"_2645":47940},[],"Authentication and condition",{"_3146":997,"_27538":982,"_19130":47942,"_5":13154,"_26074":47900,"_2645":47943},[],"`/cacerts`",{"_3146":998,"_27538":982,"_19130":47945,"_5":13154,"_26074":47900,"_2645":47946},[],"GET",{"_3146":999,"_27538":982,"_19130":47948,"_5":13154,"_26074":47900,"_2645":47949},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3146":1000,"_27538":982,"_19130":47951,"_5":13154,"_26074":47900,"_2645":47952},[],"`/simpleenroll`",{"_3146":1001,"_27538":982,"_19130":47954,"_5":13154,"_26074":47900,"_2645":47955},[],"POST",{"_3146":1002,"_27538":982,"_19130":47957,"_5":13154,"_26074":47900,"_2645":47958},[],"Initial authentication and DMS registration/replacement policy.",{"_3146":1003,"_27538":982,"_19130":47960,"_5":13154,"_26074":47900,"_2645":47961},[],"`/simplereenroll`",{"_3146":1004,"_27538":982,"_19130":47963,"_5":13154,"_26074":47900,"_2645":47955},[],{"_3146":1005,"_27538":982,"_19130":47965,"_5":13154,"_26074":47900,"_2645":47966},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3146":1006,"_27538":982,"_19130":47968,"_5":13154,"_26074":47900,"_2645":47969},[],"`/serverkeygen`",{"_3146":1007,"_27538":982,"_19130":47971,"_5":13154,"_26074":47900,"_2645":47955},[],{"_3146":1008,"_27538":982,"_19130":47973,"_5":13154,"_26074":47900,"_2645":47974},[],"Initial authentication and admission; server generation enabled.",{"_3146":1009,"_27538":982,"_19130":47976,"_5":13154,"_26074":47900,"_2645":47977},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3146":1010,"_27538":982,"_19130":47979,"_5":13154,"_26074":47904,"_2645":47980},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3146":1011,"_27538":982,"_19130":47982,"_5":13154,"_26074":47904,"_2645":47983},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3146":1012,"_27538":982,"_19130":47985,"_5":13154,"_26074":47907,"_2645":47986},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3146":1013,"_27538":982,"_19130":47988,"_5":13154,"_26074":47907,"_2645":47989},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3146":1014,"_27538":982,"_19130":47991,"_5":13154,"_26074":47910,"_2645":47992},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3146":1015,"_27538":982,"_19130":47994,"_5":13154,"_26074":47910,"_2645":47995},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3146":1016,"_27538":982,"_19130":47997,"_5":13154,"_26074":47913,"_2645":47998},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3146":1017,"_27538":982,"_19130":48000,"_5":13154,"_26074":47913,"_2645":48001},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3146":1018,"_27538":982,"_19130":48003,"_5":13154,"_26074":47916,"_2645":48004},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3146":1019,"_27538":982,"_19130":48006,"_5":13154,"_26074":47916,"_2645":48007},[],"Part",{"_3146":1020,"_27538":982,"_19130":48009,"_5":13154,"_26074":47916,"_2645":48010},[],"Content after decoding its Base64",{"_3146":1021,"_27538":982,"_19130":48012,"_5":13154,"_26074":47916,"_2645":48013},[],"`application/pkcs8`",{"_3146":1022,"_27538":982,"_19130":48015,"_5":13154,"_26074":47916,"_2645":48016},[],"Unencrypted DER PKCS#8 private key.",{"_3146":1023,"_27538":982,"_19130":48018,"_5":13154,"_26074":47916,"_2645":48019},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3146":1024,"_27538":982,"_19130":48021,"_5":13154,"_26074":47916,"_2645":48022},[],"DER PKCS#7 containing the issued certificate.",{"_3146":1025,"_27538":982,"_19130":48024,"_5":13154,"_26074":47916,"_2645":48025},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3146":1026,"_27538":982,"_19130":48027,"_5":13154,"_26074":47920,"_2645":48028},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3146":1027,"_27538":982,"_19130":48030,"_5":13154,"_26074":47920,"_2645":48031},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3146":1028,"_27538":982,"_19130":48033,"_5":13154,"_26074":47920,"_2645":48034},[],"Convert and check the result:",{"_3146":1029,"_27538":982,"_19130":48036,"_5":13154,"_26074":47920,"_2645":48037},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3146":1030,"_27538":982,"_19130":48039,"_5":13154,"_26074":47924,"_2645":48040},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3146":1031,"_27538":982,"_19130":48042,"_5":13154,"_26074":47924,"_2645":48043},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3146":1032,"_27538":1032,"_5":13480,"_2645":47368,"_27881":48045,"_19130":48046,"_26074":1032},[44830,46210,47187,47185,47368],[],{"_3146":1033,"_27538":1032,"_19130":48048,"_5":13154,"_26074":1032,"_2645":48049},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3146":1034,"_27538":1032,"_5":27878,"_19130":48051,"_26074":48052,"_2645":48053},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3146":1035,"_27538":1032,"_5":27878,"_19130":48055,"_26074":48056,"_2645":48057},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3146":1036,"_27538":1032,"_5":27878,"_19130":48059,"_26074":48060,"_2645":48061},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3146":1037,"_27538":1032,"_5":27878,"_19130":48063,"_26074":48064,"_2645":48065},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3146":1038,"_27538":1032,"_19130":48067,"_5":13154,"_26074":1032,"_2645":48068},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3146":1039,"_27538":1032,"_19130":48070,"_5":13154,"_26074":48052,"_2645":48071},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3146":1040,"_27538":1032,"_19130":48073,"_5":13154,"_26074":48052,"_2645":48074},[],"The integrator installs initial EST server trust and an admission credential.",{"_3146":1041,"_27538":1032,"_19130":48076,"_5":13154,"_26074":48052,"_2645":48077},[],"The client requests an identity for its `Device ID` through EST.",{"_3146":1042,"_27538":1032,"_19130":48079,"_5":13154,"_26074":48052,"_2645":48080},[],"Certificate, device binding and key/certificate installation are checked.",{"_3146":1043,"_27538":1032,"_19130":48082,"_5":13154,"_26074":48052,"_2645":48083},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3146":1044,"_27538":1032,"_19130":48085,"_5":13154,"_26074":48052,"_2645":48086},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3146":1045,"_27538":1032,"_19130":48088,"_5":13154,"_26074":48056,"_2645":48089},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3146":1046,"_27538":1032,"_19130":48091,"_5":13154,"_26074":48056,"_2645":48092},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3146":1047,"_27538":1032,"_19130":48094,"_5":13154,"_26074":48056,"_2645":48095},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3146":1048,"_27538":1032,"_19130":48097,"_5":13154,"_26074":48056,"_2645":48098},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3146":1049,"_27538":1032,"_19130":48100,"_5":13154,"_26074":48060,"_2645":48101},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3146":1050,"_27538":1032,"_19130":48103,"_5":13154,"_26074":48060,"_2645":48104},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3146":1051,"_27538":1032,"_19130":48106,"_5":13154,"_26074":48060,"_2645":48107},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3146":1052,"_27538":1032,"_19130":48109,"_5":13154,"_26074":48060,"_2645":48110},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3146":1053,"_27538":1032,"_19130":48112,"_5":13154,"_26074":48064,"_2645":48113},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3146":1054,"_27538":1032,"_19130":48115,"_5":13154,"_26074":48064,"_2645":48116},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3146":1055,"_27538":1055,"_5":13480,"_2645":48118,"_27881":48119,"_19130":48120,"_26074":1055},"Provisioning strategies",[44830,46210,47187,47185,47368],[],{"_3146":1056,"_27538":1055,"_19130":48122,"_5":13154,"_26074":1055,"_2645":48123},[],"Choose device registration, identity authorization and key generation.",{"_3146":1057,"_27538":1055,"_5":27878,"_19130":48125,"_26074":48126,"_2645":48127},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3146":1058,"_27538":1055,"_5":27878,"_19130":48129,"_26074":48130,"_2645":48131},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3146":1059,"_27538":1055,"_5":27878,"_19130":48133,"_26074":48134,"_2645":48135},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3146":1060,"_27538":1055,"_5":27878,"_19130":48137,"_26074":48138,"_2645":48139},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3146":1061,"_27538":1055,"_5":27878,"_19130":48141,"_26074":48142,"_2645":48143},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3146":1062,"_27538":1055,"_19130":48145,"_5":13154,"_26074":1055,"_2645":48146},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3146":1063,"_27538":1055,"_19130":48148,"_5":13154,"_26074":48126,"_2645":48149},[],"Path",{"_3146":1064,"_27538":1055,"_19130":48151,"_5":13154,"_26074":48126,"_2645":48152},[],"When the device exists",{"_3146":1065,"_27538":1055,"_19130":48154,"_5":13154,"_26074":48126,"_2645":48155},[],"What to check",{"_3146":1066,"_27538":1055,"_19130":48157,"_5":13154,"_26074":48126,"_2645":48158},[],"Manual assignment",{"_3146":1067,"_27538":1055,"_19130":48160,"_5":13154,"_26074":48126,"_2645":48161},[],"An operator creates it before associating a certificate.",{"_3146":1068,"_27538":1055,"_19130":48163,"_5":13154,"_26074":48126,"_2645":48164},[],"ID, owning DMS, certificate CN and bound serial.",{"_3146":1069,"_27538":1055,"_19130":48166,"_5":13154,"_26074":48126,"_2645":48167},[],"EST with `JITP`",{"_3146":1070,"_27538":1055,"_19130":48169,"_5":13154,"_26074":48126,"_2645":48170},[],"Created for an unknown CN during `/simpleenroll`.",{"_3146":1071,"_27538":1055,"_19130":48172,"_5":13154,"_26074":48126,"_2645":48173},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3146":1072,"_27538":1055,"_19130":48175,"_5":13154,"_26074":48126,"_2645":48176},[],"EST with `PRE_REGISTRATION`",{"_3146":1073,"_27538":1055,"_19130":48178,"_5":13154,"_26074":48126,"_2645":48179},[],"Must exist before `/simpleenroll`.",{"_3146":1074,"_27538":1055,"_19130":48181,"_5":13154,"_26074":48126,"_2645":48182},[],"Approved record, same DMS and replacement conditions for your version.",{"_3146":1075,"_27538":1055,"_19130":48184,"_5":13154,"_26074":48126,"_2645":48185},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3146":1076,"_27538":1055,"_19130":48187,"_5":13154,"_26074":48126,"_2645":48188},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3146":1077,"_27538":1055,"_19130":48190,"_5":13154,"_26074":48130,"_2645":48191},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3146":1078,"_27538":1055,"_19130":48193,"_5":13154,"_26074":48130,"_2645":48194},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3146":1079,"_27538":1055,"_19130":48196,"_5":13154,"_26074":48130,"_2645":48197},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3146":1080,"_27538":1055,"_19130":48199,"_5":13154,"_26074":48134,"_2645":48200},[],"Decide initial enrollment and re-enrollment separately:",{"_3146":1081,"_27538":1055,"_19130":48202,"_5":13154,"_26074":48134,"_2645":48203},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3146":1082,"_27538":1055,"_19130":48205,"_5":13154,"_26074":48134,"_2645":48206},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3146":1083,"_27538":1055,"_19130":48208,"_5":13154,"_26074":48134,"_2645":48209},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3146":1084,"_27538":1055,"_19130":48211,"_5":13154,"_26074":48134,"_2645":48212},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3146":1085,"_27538":1055,"_19130":48214,"_5":13154,"_26074":48134,"_2645":48215},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3146":1086,"_27538":1055,"_19130":48217,"_5":13154,"_26074":48138,"_2645":45214},[],{"_3146":1087,"_27538":1055,"_19130":48219,"_5":13154,"_26074":48138,"_2645":48220},[],"Material crossing EST",{"_3146":1088,"_27538":1055,"_19130":48222,"_5":13154,"_26074":48138,"_2645":48223},[],"Device-generated key",{"_3146":1089,"_27538":1055,"_19130":48225,"_5":13154,"_26074":48138,"_2645":48226},[],"Public CSR and certificate; the key stays on the client.",{"_3146":1090,"_27538":1055,"_19130":48228,"_5":13154,"_26074":48138,"_2645":48229},[],"Existing device key",{"_3146":1091,"_27538":1055,"_19130":48231,"_5":13154,"_26074":48138,"_2645":48232},[],"CSR signed with that key and a new certificate.",{"_3146":1092,"_27538":1055,"_19130":48234,"_5":13154,"_26074":48138,"_2645":47506},[],{"_3146":1093,"_27538":1055,"_19130":48236,"_5":13154,"_26074":48138,"_2645":48237},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3146":1094,"_27538":1055,"_19130":48239,"_5":13154,"_26074":48138,"_2645":48240},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3146":1095,"_27538":1055,"_19130":48242,"_5":13154,"_26074":48142,"_2645":48243},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3146":1096,"_27538":1096,"_5":13480,"_2645":48245,"_27881":48246,"_19130":48247,"_26074":1096},"Renewal and recovery",[44830,46210,47187,47185,47368],[],{"_3146":1097,"_27538":1096,"_19130":48249,"_5":13154,"_26074":1096,"_2645":48250},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3146":1098,"_27538":1096,"_5":27878,"_19130":48252,"_26074":48253,"_2645":48254},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3146":1099,"_27538":1096,"_5":27878,"_19130":48256,"_26074":48257,"_2645":48258},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3146":1100,"_27538":1096,"_5":27878,"_19130":48260,"_26074":48261,"_2645":48262},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3146":1101,"_27538":1096,"_5":27878,"_19130":48264,"_26074":48265,"_2645":48266},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3146":1102,"_27538":1096,"_5":27878,"_19130":48268,"_26074":48269,"_2645":48270},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3146":1103,"_27538":1096,"_19130":48272,"_5":13154,"_26074":1096,"_2645":48273},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3146":1104,"_27538":1096,"_19130":48275,"_5":13154,"_26074":48253,"_2645":48276},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3146":1105,"_27538":1096,"_19130":48278,"_5":13154,"_26074":48253,"_2645":48279},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3146":1106,"_27538":1096,"_19130":48281,"_5":13154,"_26074":48253,"_2645":48282},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3146":1107,"_27538":1096,"_19130":48284,"_5":13154,"_26074":48253,"_2645":48285},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3146":1108,"_27538":1096,"_19130":48287,"_5":13154,"_26074":48257,"_2645":48288},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3146":1109,"_27538":1096,"_19130":48290,"_5":13154,"_26074":48257,"_2645":48291},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3146":1110,"_27538":1096,"_19130":48293,"_5":13154,"_26074":48261,"_2645":48294},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3146":1111,"_27538":1096,"_19130":48296,"_5":13154,"_26074":48261,"_2645":48297},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3146":1112,"_27538":1096,"_19130":48299,"_5":13154,"_26074":48261,"_2645":48300},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3146":1113,"_27538":1096,"_19130":48302,"_5":13154,"_26074":48265,"_2645":48303},[],"Situation",{"_3146":1114,"_27538":1096,"_19130":48305,"_5":13154,"_26074":48265,"_2645":48306},[],"Procedure",{"_3146":1115,"_27538":1096,"_19130":48308,"_5":13154,"_26074":48265,"_2645":48309},[],"Valid certificate, outside the window",{"_3146":1116,"_27538":1096,"_19130":48311,"_5":13154,"_26074":48265,"_2645":48312},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3146":1117,"_27538":1096,"_19130":48314,"_5":13154,"_26074":48265,"_2645":48315},[],"Expired certificate, key available",{"_3146":1118,"_27538":1096,"_19130":48317,"_5":13154,"_26074":48265,"_2645":48318},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3146":1119,"_27538":1096,"_19130":48320,"_5":13154,"_26074":48265,"_2645":48321},[],"Renewal through webhook or `NO_AUTH`",{"_3146":1120,"_27538":1096,"_19130":48323,"_5":13154,"_26074":48265,"_2645":48324},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3146":1121,"_27538":1096,"_19130":48326,"_5":13154,"_26074":48265,"_2645":48327},[],"Lost or inaccessible key",{"_3146":1122,"_27538":1096,"_19130":48329,"_5":13154,"_26074":48265,"_2645":48330},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3146":1123,"_27538":1096,"_19130":48332,"_5":13154,"_26074":48265,"_2645":48333},[],"Current identity revoked",{"_3146":1124,"_27538":1096,"_19130":48335,"_5":13154,"_26074":48265,"_2645":48336},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3146":1125,"_27538":1096,"_19130":48338,"_5":13154,"_26074":48265,"_2645":48339},[],"Device without an identity",{"_3146":1126,"_27538":1096,"_19130":48341,"_5":13154,"_26074":48265,"_2645":48342},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3146":1127,"_27538":1096,"_19130":48344,"_5":13154,"_26074":48265,"_2645":48345},[],"Retired device",{"_3146":1128,"_27538":1096,"_19130":48347,"_5":13154,"_26074":48265,"_2645":48348},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3146":1129,"_27538":1096,"_19130":48350,"_5":13154,"_26074":48265,"_2645":48351},[],"Timeout, HTTP 500 or installation failure",{"_3146":1130,"_27538":1096,"_19130":48353,"_5":13154,"_26074":48265,"_2645":48354},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3146":1131,"_27538":1096,"_19130":48356,"_5":13154,"_26074":48269,"_2645":48357},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3146":1132,"_27538":1096,"_19130":48359,"_5":13154,"_26074":48269,"_2645":48360},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3146":1133,"_27538":1133,"_5":13480,"_2645":48362,"_27881":48363,"_19130":48364,"_26074":1133},"Enrollment troubleshooting",[44830,46210,47187,47185,47368],[],{"_3146":1134,"_27538":1133,"_19130":48366,"_5":13154,"_26074":1133,"_2645":48367},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3146":1135,"_27538":1133,"_5":27878,"_19130":48369,"_26074":48370,"_2645":48371},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3146":1136,"_27538":1133,"_5":27878,"_19130":48373,"_26074":48374,"_2645":48375},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3146":1137,"_27538":1133,"_5":27878,"_19130":48377,"_26074":48378,"_2645":47925},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3146":1138,"_27538":1133,"_5":27878,"_19130":48380,"_26074":48381,"_2645":48382},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3146":1139,"_27538":1133,"_19130":48384,"_5":13154,"_26074":1133,"_2645":48385},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3146":1140,"_27538":1133,"_19130":48387,"_5":13154,"_26074":48374,"_2645":48388},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3146":1141,"_27538":1133,"_19130":48390,"_5":13154,"_26074":48374,"_2645":48391},[],"Symptom or message",{"_3146":1142,"_27538":1133,"_19130":48393,"_5":13154,"_26074":48374,"_2645":48155},[],{"_3146":1143,"_27538":1133,"_19130":48395,"_5":13154,"_26074":48374,"_2645":48396},[],"curl rejects TLS, name or issuer",{"_3146":1144,"_27538":1133,"_19130":48398,"_5":13154,"_26074":48374,"_2645":48399},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3146":1145,"_27538":1133,"_19130":48401,"_5":13154,"_26074":48374,"_2645":48402},[],"404 or missing APS",{"_3146":1146,"_27538":1133,"_19130":48404,"_5":13154,"_26074":48374,"_2645":48405},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3146":1147,"_27538":1133,"_19130":48407,"_5":13154,"_26074":48374,"_2645":48408},[],"400, CSR or format error",{"_3146":1148,"_27538":1133,"_19130":48410,"_5":13154,"_26074":48374,"_2645":48411},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3146":1149,"_27538":1133,"_19130":48413,"_5":13154,"_26074":48374,"_2645":48414},[],"Missing credential or invalid certificate",{"_3146":1150,"_27538":1133,"_19130":48416,"_5":13154,"_26074":48374,"_2645":48417},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3146":1151,"_27538":1133,"_19130":48419,"_5":13154,"_26074":48374,"_2645":48420},[],"Webhook denies, times out or responds without authorization",{"_3146":1152,"_27538":1133,"_19130":48422,"_5":13154,"_26074":48374,"_2645":48423},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3146":1153,"_27538":1133,"_19130":48425,"_5":13154,"_26074":48374,"_2645":48426},[],"`unexpected status code: <n>: redirects are not followed`",{"_3146":1154,"_27538":1133,"_19130":48428,"_5":13154,"_26074":48374,"_2645":48429},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3146":1155,"_27538":1133,"_19130":48431,"_5":13154,"_26074":48374,"_2645":48432},[],"`webhook response exceeds 1048576 bytes`",{"_3146":1156,"_27538":1133,"_19130":48434,"_5":13154,"_26074":48374,"_2645":48435},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3146":1157,"_27538":1133,"_19130":48437,"_5":13154,"_26074":48374,"_2645":48438},[],"`webhook config must not reference files`",{"_3146":1158,"_27538":1133,"_19130":48440,"_5":13154,"_26074":48374,"_2645":48441},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3146":1159,"_27538":1133,"_19130":48443,"_5":13154,"_26074":48374,"_2645":48444},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3146":1160,"_27538":1133,"_19130":48446,"_5":13154,"_26074":48374,"_2645":48447},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3146":1161,"_27538":1133,"_19130":48449,"_5":13154,"_26074":48374,"_2645":48450},[],"`webhook mTLS certificate and key are invalid: …`",{"_3146":1162,"_27538":1133,"_19130":48452,"_5":13154,"_26074":48374,"_2645":48453},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3146":1163,"_27538":1133,"_19130":48455,"_5":13154,"_26074":48374,"_2645":48456},[],"400 `struct validation error` creating or updating a DMS",{"_3146":1164,"_27538":1133,"_19130":48458,"_5":13154,"_26074":48374,"_2645":48459},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3146":1165,"_27538":1133,"_19130":48461,"_5":13154,"_26074":48374,"_2645":48462},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3146":1166,"_27538":1133,"_19130":48464,"_5":13154,"_26074":48374,"_2645":48465},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3146":1167,"_27538":1133,"_19130":48467,"_5":13154,"_26074":48374,"_2645":48468},[],"`device not preregistered`",{"_3146":1168,"_27538":1133,"_19130":48470,"_5":13154,"_26074":48374,"_2645":48471},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3146":1169,"_27538":1133,"_19130":48473,"_5":13154,"_26074":48374,"_2645":48474},[],"`forbiddenNewEnrollment`",{"_3146":1170,"_27538":1133,"_19130":48476,"_5":13154,"_26074":48374,"_2645":48477},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3146":1171,"_27538":1133,"_19130":48479,"_5":13154,"_26074":48374,"_2645":48480},[],"Different owning DMS",{"_3146":1172,"_27538":1133,"_19130":48482,"_5":13154,"_26074":48374,"_2645":48483},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3146":1173,"_27538":1133,"_19130":48485,"_5":13154,"_26074":48374,"_2645":48486},[],"`invalid RawSubject bytes`",{"_3146":1174,"_27538":1133,"_19130":48488,"_5":13154,"_26074":48374,"_2645":48489},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3146":1175,"_27538":1133,"_19130":48491,"_5":13154,"_26074":48374,"_2645":48492},[],"`invalid reenroll window`",{"_3146":1176,"_27538":1133,"_19130":48494,"_5":13154,"_26074":48374,"_2645":48495},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3146":1177,"_27538":1133,"_19130":48497,"_5":13154,"_26074":48374,"_2645":48498},[],"Current certificate revoked",{"_3146":1178,"_27538":1133,"_19130":48500,"_5":13154,"_26074":48374,"_2645":48501},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3146":1179,"_27538":1133,"_19130":48503,"_5":13154,"_26074":48374,"_2645":48504},[],"CA, profile or signing error",{"_3146":1180,"_27538":1133,"_19130":48506,"_5":13154,"_26074":48374,"_2645":48507},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3146":1181,"_27538":1133,"_19130":48509,"_5":13154,"_26074":48374,"_2645":48510},[],"HTTP 200 without a device connection",{"_3146":1182,"_27538":1133,"_19130":48512,"_5":13154,"_26074":48374,"_2645":48513},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3146":1183,"_27538":1133,"_19130":48515,"_5":13154,"_26074":48374,"_2645":48516},[],"Timeout or error after issuance",{"_3146":1184,"_27538":1133,"_19130":48518,"_5":13154,"_26074":48374,"_2645":48519},[],"New certificates, current slot and previous identity's state before retrying.",{"_3146":1185,"_27538":1133,"_19130":48521,"_5":13154,"_26074":48378,"_2645":48522},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3146":1186,"_27538":1133,"_19130":48524,"_5":13154,"_26074":48378,"_2645":48525},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3146":1187,"_27538":1133,"_19130":48527,"_5":13154,"_26074":48381,"_2645":48528},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3146":1188,"_27538":1133,"_19130":48530,"_5":13154,"_26074":48381,"_2645":48531},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3146":1189,"_27538":1133,"_19130":48533,"_5":13154,"_26074":48381,"_2645":48534},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3146":1190,"_27538":1133,"_19130":48536,"_5":13154,"_26074":48381,"_2645":48537},[],"Make one request, save headers/body and query the device and certificates.",{"_3146":1191,"_27538":1133,"_19130":48539,"_5":13154,"_26074":48381,"_2645":48540},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3146":1192,"_27538":1133,"_19130":48542,"_5":13154,"_26074":48381,"_2645":48543},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3146":1193,"_27538":1133,"_19130":48545,"_5":13154,"_26074":48381,"_2645":48546},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3146":1194,"_27538":1194,"_5":13480,"_2645":48548,"_27881":48549,"_19130":48550,"_26074":1194},"Trust distribution and updates",[44830,46210,47187,47185,47368],[],{"_3146":1195,"_27538":1194,"_19130":48552,"_5":13154,"_26074":1194,"_2645":48553},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3146":1196,"_27538":1194,"_5":27878,"_19130":48555,"_26074":48556,"_2645":48557},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3146":1197,"_27538":1194,"_5":27878,"_19130":48559,"_26074":48560,"_2645":48561},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3146":1198,"_27538":1194,"_5":27878,"_19130":48563,"_26074":48564,"_2645":48565},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3146":1199,"_27538":1194,"_5":27878,"_19130":48567,"_26074":48568,"_2645":48569},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3146":1200,"_27538":1194,"_5":27878,"_19130":48571,"_26074":48572,"_2645":48573},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3146":1201,"_27538":1194,"_19130":48575,"_5":13154,"_26074":1194,"_2645":48576},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3146":1202,"_27538":1194,"_19130":48578,"_5":13154,"_26074":48556,"_2645":48579},[],"Relationship",{"_3146":1203,"_27538":1194,"_19130":48581,"_5":13154,"_26074":48556,"_2645":48582},[],"Material prepared by its owner",{"_3146":1204,"_27538":1194,"_19130":48584,"_5":13154,"_26074":48556,"_2645":48585},[],"Device → EST server",{"_3146":1205,"_27538":1194,"_19130":48587,"_5":13154,"_26074":48556,"_2645":48588},[],"Previously verified server root, chain or pin and TLS name.",{"_3146":1206,"_27538":1194,"_19130":48590,"_5":13154,"_26074":48556,"_2645":48591},[],"DMS → requester",{"_3146":1207,"_27538":1194,"_19130":48593,"_5":13154,"_26074":48556,"_2645":48594},[],"CAs and rules authorizing initial or renewal credentials.",{"_3146":1208,"_27538":1194,"_19130":48596,"_5":13154,"_26074":48556,"_2645":48597},[],"Consumer → device",{"_3146":1209,"_27538":1194,"_19130":48599,"_5":13154,"_26074":48556,"_2645":48600},[],"Operational identity roots, intermediates, validation and permissions.",{"_3146":1210,"_27538":1194,"_19130":48602,"_5":13154,"_26074":48556,"_2645":48603},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3146":1211,"_27538":1194,"_19130":48605,"_5":13154,"_26074":48560,"_2645":48606},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3146":1212,"_27538":1194,"_19130":48608,"_5":13154,"_26074":48560,"_2645":48609},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3146":1213,"_27538":1194,"_19130":48611,"_5":13154,"_26074":48564,"_2645":48612},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3146":1214,"_27538":1194,"_19130":48614,"_5":13154,"_26074":48564,"_2645":48615},[],"Select policy-approved roots as anchors.",{"_3146":1215,"_27538":1194,"_19130":48617,"_5":13154,"_26074":48564,"_2645":48618},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3146":1216,"_27538":1194,"_19130":48620,"_5":13154,"_26074":48564,"_2645":48621},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3146":1217,"_27538":1194,"_19130":48623,"_5":13154,"_26074":48564,"_2645":48624},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3146":1218,"_27538":1194,"_19130":48626,"_5":13154,"_26074":48564,"_2645":48627},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3146":1219,"_27538":1194,"_19130":48629,"_5":13154,"_26074":48568,"_2645":48630},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3146":1220,"_27538":1194,"_19130":48632,"_5":13154,"_26074":48568,"_2645":48633},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3146":1221,"_27538":1194,"_19130":48635,"_5":13154,"_26074":48568,"_2645":48636},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3146":1222,"_27538":1194,"_19130":48638,"_5":13154,"_26074":48572,"_2645":48639},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3146":1223,"_27538":1223,"_5":13480,"_2645":48641,"_27881":48642,"_19130":48644,"_26074":1223},"AWS IoT Core",[44830,46210,47187,47185,48643],"Integrations",[],{"_3146":1224,"_27538":1223,"_19130":48646,"_5":13154,"_26074":1223,"_2645":48647},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3146":1225,"_27538":1223,"_5":27878,"_19130":48649,"_26074":48650,"_2645":48651},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3146":1226,"_27538":1223,"_5":27878,"_19130":48653,"_26074":48654,"_2645":48655},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3146":1227,"_27538":1223,"_5":27878,"_19130":48657,"_26074":48658,"_2645":48659},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3146":1228,"_27538":1223,"_5":27878,"_19130":48661,"_26074":48662,"_2645":48663},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3146":1229,"_27538":1223,"_5":27878,"_19130":48665,"_26074":48666,"_2645":48667},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3146":1230,"_27538":1223,"_5":27878,"_19130":48669,"_26074":48670,"_2645":48671},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3146":1231,"_27538":1223,"_5":27878,"_19130":48673,"_26074":48674,"_2645":48675},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3146":1232,"_27538":1223,"_5":27878,"_19130":48677,"_26074":48678,"_2645":48679},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3146":1233,"_27538":1223,"_5":27878,"_19130":48681,"_26074":48682,"_2645":48683},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3146":1234,"_27538":1223,"_5":27878,"_19130":48685,"_26074":48686,"_2645":48687},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3146":1235,"_27538":1223,"_5":27878,"_19130":48689,"_26074":48690,"_2645":48691},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3146":1236,"_27538":1223,"_5":27878,"_19130":48693,"_26074":48694,"_2645":48695},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3146":1237,"_27538":1223,"_5":27878,"_19130":48697,"_26074":48698,"_2645":48699},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3146":1238,"_27538":1223,"_5":27878,"_19130":48701,"_26074":48702,"_2645":48703},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3146":1239,"_27538":1223,"_5":27878,"_19130":48705,"_26074":48706,"_2645":48707},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3146":1240,"_27538":1223,"_5":27878,"_19130":48709,"_26074":48710,"_2645":48711},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3146":1241,"_27538":1223,"_5":27878,"_19130":48713,"_26074":48714,"_2645":48715},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3146":1242,"_27538":1223,"_5":27878,"_19130":48717,"_26074":48718,"_2645":48719},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3146":1243,"_27538":1223,"_5":27878,"_19130":48721,"_26074":48722,"_2645":48723},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3146":1244,"_27538":1223,"_5":27878,"_19130":48725,"_26074":48726,"_2645":48727},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3146":1245,"_27538":1223,"_19130":48729,"_5":13154,"_26074":1223,"_2645":48730},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3146":1246,"_27538":1223,"_19130":48732,"_5":13154,"_26074":1223,"_2645":48733},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3146":1247,"_27538":1223,"_19130":48735,"_5":13154,"_26074":1223,"_2645":48736},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3146":1248,"_27538":1223,"_19130":48738,"_5":13154,"_26074":48650,"_2645":48739},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3146":1249,"_27538":1223,"_19130":48741,"_5":13154,"_26074":48650,"_2645":48742},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3146":1250,"_27538":1223,"_19130":48744,"_5":13154,"_26074":48650,"_2645":48745},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3146":1251,"_27538":1223,"_19130":48747,"_5":13154,"_26074":48650,"_2645":48748},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3146":1252,"_27538":1223,"_19130":48750,"_5":13154,"_26074":48654,"_2645":48751},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3146":1253,"_27538":1223,"_19130":48753,"_5":13154,"_26074":48658,"_2645":48754},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3146":1254,"_27538":1223,"_19130":48756,"_5":13154,"_26074":48658,"_2645":48757},[],"IAM action",{"_3146":1255,"_27538":1223,"_19130":48759,"_5":13154,"_26074":48658,"_2645":45220},[],{"_3146":1256,"_27538":1223,"_19130":48761,"_5":13154,"_26074":48658,"_2645":48762},[],"`iot:GetRegistrationCode`",{"_3146":1257,"_27538":1223,"_19130":48764,"_5":13154,"_26074":48658,"_2645":48765},[],"Obtain the verification code for CA registration in the Primary Account",{"_3146":1258,"_27538":1223,"_19130":48767,"_5":13154,"_26074":48658,"_2645":48768},[],"`iot:RegisterCACertificate`",{"_3146":1259,"_27538":1223,"_19130":48770,"_5":13154,"_26074":48658,"_2645":48771},[],"Register the CA in AWS IoT",{"_3146":1260,"_27538":1223,"_19130":48773,"_5":13154,"_26074":48658,"_2645":48774},[],"`iot:DescribeCACertificate`",{"_3146":1261,"_27538":1223,"_19130":48776,"_5":13154,"_26074":48658,"_2645":48777},[],"Check the CA registration status",{"_3146":1262,"_27538":1223,"_19130":48779,"_5":13154,"_26074":48658,"_2645":48780},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3146":1263,"_27538":1223,"_19130":48782,"_5":13154,"_26074":48658,"_2645":48783},[],"Create or update Things in IoT Core",{"_3146":1264,"_27538":1223,"_19130":48785,"_5":13154,"_26074":48658,"_2645":48786},[],"`iot:RegisterThing`",{"_3146":1265,"_27538":1223,"_19130":48788,"_5":13154,"_26074":48658,"_2645":48789},[],"Provision Things through a template",{"_3146":1266,"_27538":1223,"_19130":48791,"_5":13154,"_26074":48658,"_2645":48792},[],"`iot:RegisterCertificate`",{"_3146":1267,"_27538":1223,"_19130":48794,"_5":13154,"_26074":48658,"_2645":48795},[],"Register device certificates",{"_3146":1268,"_27538":1223,"_19130":48797,"_5":13154,"_26074":48658,"_2645":48798},[],"`iot:UpdateCertificate`",{"_3146":1269,"_27538":1223,"_19130":48800,"_5":13154,"_26074":48658,"_2645":48801},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3146":1270,"_27538":1223,"_19130":48803,"_5":13154,"_26074":48658,"_2645":48804},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3146":1271,"_27538":1223,"_19130":48806,"_5":13154,"_26074":48658,"_2645":48807},[],"Create and attach IoT policies",{"_3146":1272,"_27538":1223,"_19130":48809,"_5":13154,"_26074":48658,"_2645":48810},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3146":1273,"_27538":1223,"_19130":48812,"_5":13154,"_26074":48658,"_2645":48813},[],"Manage Thing groups",{"_3146":1274,"_27538":1223,"_19130":48815,"_5":13154,"_26074":48658,"_2645":48816},[],"`iot:CreateProvisioningTemplate`",{"_3146":1275,"_27538":1223,"_19130":48818,"_5":13154,"_26074":48658,"_2645":48819},[],"Create JITP templates",{"_3146":1276,"_27538":1223,"_19130":48821,"_5":13154,"_26074":48658,"_2645":48822},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3146":1277,"_27538":1223,"_19130":48824,"_5":13154,"_26074":48658,"_2645":48825},[],"Read and write the Device Shadow",{"_3146":1278,"_27538":1223,"_19130":48827,"_5":13154,"_26074":48658,"_2645":48828},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3146":1279,"_27538":1223,"_19130":48830,"_5":13154,"_26074":48662,"_2645":48831},[],"Parameter",{"_3146":1280,"_27538":1223,"_19130":48833,"_5":13154,"_26074":48662,"_2645":48834},[],"Type",{"_3146":1281,"_27538":1223,"_19130":48836,"_5":13154,"_26074":48662,"_2645":48837},[],"Required",{"_3146":1282,"_27538":1223,"_19130":48839,"_5":13154,"_26074":48662,"_2645":48840},[],"Description",{"_3146":1283,"_27538":1223,"_19130":48842,"_5":13154,"_26074":48662,"_2645":48843},[],"`connector_id`",{"_3146":1284,"_27538":1223,"_19130":48845,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1285,"_27538":1223,"_19130":48847,"_5":13154,"_26074":48662,"_2645":48848},[],"Yes",{"_3146":1286,"_27538":1223,"_19130":48850,"_5":13154,"_26074":48662,"_2645":48851},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3146":1287,"_27538":1223,"_19130":48853,"_5":13154,"_26074":48662,"_2645":48854},[],"`aws_config.region`",{"_3146":1288,"_27538":1223,"_19130":48856,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1289,"_27538":1223,"_19130":48858,"_5":13154,"_26074":48662,"_2645":48848},[],{"_3146":1290,"_27538":1223,"_19130":48860,"_5":13154,"_26074":48662,"_2645":48861},[],"AWS region where the connector operates.",{"_3146":1291,"_27538":1223,"_19130":48863,"_5":13154,"_26074":48662,"_2645":48864},[],"`aws_config.auth_method`",{"_3146":1292,"_27538":1223,"_19130":48866,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1293,"_27538":1223,"_19130":48868,"_5":13154,"_26074":48662,"_2645":48848},[],{"_3146":1294,"_27538":1223,"_19130":48870,"_5":13154,"_26074":48662,"_2645":48871},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3146":1295,"_27538":1223,"_19130":48873,"_5":13154,"_26074":48662,"_2645":48874},[],"`aws_config.access_key_id`",{"_3146":1296,"_27538":1223,"_19130":48876,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1297,"_27538":1223,"_19130":48878,"_5":13154,"_26074":48662,"_2645":48879},[],"Only with `auth_method=static`",{"_3146":1298,"_27538":1223,"_19130":48881,"_5":13154,"_26074":48662,"_2645":48882},[],"AWS access key.",{"_3146":1299,"_27538":1223,"_19130":48884,"_5":13154,"_26074":48662,"_2645":48885},[],"`aws_config.secret_access_key`",{"_3146":1300,"_27538":1223,"_19130":48887,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1301,"_27538":1223,"_19130":48889,"_5":13154,"_26074":48662,"_2645":48879},[],{"_3146":1302,"_27538":1223,"_19130":48891,"_5":13154,"_26074":48662,"_2645":48892},[],"AWS secret key.",{"_3146":1303,"_27538":1223,"_19130":48894,"_5":13154,"_26074":48662,"_2645":48895},[],"`aws_config.session_token`",{"_3146":1304,"_27538":1223,"_19130":48897,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1305,"_27538":1223,"_19130":48899,"_5":13154,"_26074":48662,"_2645":48900},[],"No",{"_3146":1306,"_27538":1223,"_19130":48902,"_5":13154,"_26074":48662,"_2645":48903},[],"Session token (with `auth_method=static`).",{"_3146":1307,"_27538":1223,"_19130":48905,"_5":13154,"_26074":48662,"_2645":48906},[],"`aws_config.role_arn`",{"_3146":1308,"_27538":1223,"_19130":48908,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1309,"_27538":1223,"_19130":48910,"_5":13154,"_26074":48662,"_2645":48911},[],"Only with `auth_method=role`",{"_3146":1310,"_27538":1223,"_19130":48913,"_5":13154,"_26074":48662,"_2645":48914},[],"ARN of the role to assume.",{"_3146":1311,"_27538":1223,"_19130":48916,"_5":13154,"_26074":48662,"_2645":48917},[],"`aws_config.endpoint_url`",{"_3146":1312,"_27538":1223,"_19130":48919,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1313,"_27538":1223,"_19130":48921,"_5":13154,"_26074":48662,"_2645":48900},[],{"_3146":1314,"_27538":1223,"_19130":48923,"_5":13154,"_26074":48662,"_2645":48924},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3146":1315,"_27538":1223,"_19130":48926,"_5":13154,"_26074":48662,"_2645":48927},[],"`subscriber_event_bus`",{"_3146":1316,"_27538":1223,"_19130":48929,"_5":13154,"_26074":48662,"_2645":16117},[],{"_3146":1317,"_27538":1223,"_19130":48931,"_5":13154,"_26074":48662,"_2645":48848},[],{"_3146":1318,"_27538":1223,"_19130":48933,"_5":13154,"_26074":48662,"_2645":48934},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3146":1319,"_27538":1223,"_19130":48936,"_5":13154,"_26074":48662,"_2645":48937},[],"`dms_manager_client`",{"_3146":1320,"_27538":1223,"_19130":48939,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1321,"_27538":1223,"_19130":48941,"_5":13154,"_26074":48662,"_2645":48848},[],{"_3146":1322,"_27538":1223,"_19130":48943,"_5":13154,"_26074":48662,"_2645":48944},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3146":1323,"_27538":1223,"_19130":48946,"_5":13154,"_26074":48662,"_2645":48947},[],"`device_manager_client`",{"_3146":1324,"_27538":1223,"_19130":48949,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1325,"_27538":1223,"_19130":48951,"_5":13154,"_26074":48662,"_2645":48848},[],{"_3146":1326,"_27538":1223,"_19130":48953,"_5":13154,"_26074":48662,"_2645":48954},[],"HTTP URL of Lamassu's Device Manager.",{"_3146":1327,"_27538":1223,"_19130":48956,"_5":13154,"_26074":48662,"_2645":48957},[],"`ca_client`",{"_3146":1328,"_27538":1223,"_19130":48959,"_5":13154,"_26074":48662,"_2645":22875},[],{"_3146":1329,"_27538":1223,"_19130":48961,"_5":13154,"_26074":48662,"_2645":48848},[],{"_3146":1330,"_27538":1223,"_19130":48963,"_5":13154,"_26074":48662,"_2645":48964},[],"HTTP URL of Lamassu's CA service.",{"_3146":1331,"_27538":1223,"_19130":48966,"_5":13154,"_26074":48666,"_2645":48967},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3146":1332,"_27538":1223,"_19130":48969,"_5":13154,"_26074":48670,"_2645":48970},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3146":1333,"_27538":1223,"_19130":48972,"_5":13154,"_26074":48670,"_2645":48973},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3146":1334,"_27538":1223,"_19130":48975,"_5":13154,"_26074":48674,"_2645":48976},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3146":1335,"_27538":1223,"_19130":48978,"_5":13154,"_26074":48674,"_2645":48979},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3146":1336,"_27538":1223,"_19130":48981,"_5":13154,"_26074":48674,"_2645":48982},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3146":1337,"_27538":1223,"_19130":48984,"_5":13154,"_26074":48674,"_2645":48985},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3146":1338,"_27538":1223,"_19130":48987,"_5":13154,"_26074":48674,"_2645":48988},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3146":1339,"_27538":1223,"_19130":48990,"_5":13154,"_26074":48674,"_2645":48991},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3146":1340,"_27538":1223,"_19130":48993,"_5":13154,"_26074":48678,"_2645":48994},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3146":1341,"_27538":1223,"_19130":48996,"_5":13154,"_26074":48682,"_2645":48997},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3146":1342,"_27538":1223,"_19130":48999,"_5":13154,"_26074":48682,"_2645":49000},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3146":1343,"_27538":1223,"_19130":49002,"_5":13154,"_26074":48686,"_2645":49003},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3146":1344,"_27538":1223,"_19130":49005,"_5":13154,"_26074":48690,"_2645":49006},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3146":1345,"_27538":1223,"_19130":49008,"_5":13154,"_26074":48690,"_2645":49009},[],"Creates or updates the IoT policies configured in the DMS.",{"_3146":1346,"_27538":1223,"_19130":49011,"_5":13154,"_26074":48690,"_2645":49012},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3146":1347,"_27538":1223,"_19130":49014,"_5":13154,"_26074":48690,"_2645":49015},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3146":1348,"_27538":1223,"_19130":49017,"_5":13154,"_26074":48690,"_2645":49018},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3146":1349,"_27538":1223,"_19130":49020,"_5":13154,"_26074":48690,"_2645":49021},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3146":1350,"_27538":1223,"_19130":49023,"_5":13154,"_26074":48690,"_2645":49024},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3146":1351,"_27538":1223,"_19130":49026,"_5":13154,"_26074":48694,"_2645":49027},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3146":1352,"_27538":1223,"_19130":49029,"_5":13154,"_26074":48694,"_2645":49030},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3146":1353,"_27538":1223,"_19130":49032,"_5":13154,"_26074":48694,"_2645":49033},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3146":1354,"_27538":1223,"_19130":49035,"_5":13154,"_26074":48698,"_2645":49036},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3146":1355,"_27538":1223,"_19130":49038,"_5":13154,"_26074":48698,"_2645":49039},[],"The full flow from the device's perspective is:",{"_3146":1356,"_27538":1223,"_19130":49041,"_5":13154,"_26074":48698,"_2645":49042},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3146":1357,"_27538":1223,"_19130":49044,"_5":13154,"_26074":48702,"_2645":49045},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3146":1358,"_27538":1223,"_19130":49047,"_5":13154,"_26074":48702,"_2645":49048},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3146":1359,"_27538":1223,"_19130":49050,"_5":13154,"_26074":48702,"_2645":49051},[],"For the JITP flow to work correctly:",{"_3146":1360,"_27538":1223,"_19130":49053,"_5":13154,"_26074":48702,"_2645":49054},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3146":1361,"_27538":1223,"_19130":49056,"_5":13154,"_26074":48702,"_2645":49057},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3146":1362,"_27538":1223,"_19130":49059,"_5":13154,"_26074":48702,"_2645":49060},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3146":1363,"_27538":1223,"_19130":49062,"_5":13154,"_26074":48702,"_2645":49063},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3146":1364,"_27538":1223,"_19130":49065,"_5":13154,"_26074":48706,"_2645":49066},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3146":1365,"_27538":1223,"_19130":49068,"_5":13154,"_26074":48706,"_2645":49069},[],"Status in Lamassu",{"_3146":1366,"_27538":1223,"_19130":49071,"_5":13154,"_26074":48706,"_2645":49072},[],"Revocation reason",{"_3146":1367,"_27538":1223,"_19130":49074,"_5":13154,"_26074":48706,"_2645":49075},[],"Status in AWS IoT Core",{"_3146":1368,"_27538":1223,"_19130":49077,"_5":13154,"_26074":48706,"_2645":49078},[],"`Active`",{"_3146":1369,"_27538":1223,"_19130":49080,"_5":13154,"_26074":48706,"_2645":49081},[],"None",{"_3146":1370,"_27538":1223,"_19130":49083,"_5":13154,"_26074":48706,"_2645":49084},[],"`ACTIVE`",{"_3146":1371,"_27538":1223,"_19130":49086,"_5":13154,"_26074":48706,"_2645":49087},[],"`Revoked`",{"_3146":1372,"_27538":1223,"_19130":49089,"_5":13154,"_26074":48706,"_2645":49090},[],"`certificateHold`",{"_3146":1373,"_27538":1223,"_19130":49092,"_5":13154,"_26074":48706,"_2645":49093},[],"`INACTIVE`",{"_3146":1374,"_27538":1223,"_19130":49095,"_5":13154,"_26074":48706,"_2645":49087},[],{"_3146":1375,"_27538":1223,"_19130":49097,"_5":13154,"_26074":48706,"_2645":49098},[],"Any other reason",{"_3146":1376,"_27538":1223,"_19130":49100,"_5":13154,"_26074":48706,"_2645":49101},[],"`REVOKED`",{"_3146":1377,"_27538":1223,"_19130":49103,"_5":13154,"_26074":48706,"_2645":49104},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3146":1378,"_27538":1223,"_19130":49106,"_5":13154,"_26074":48710,"_2645":49107},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3146":1379,"_27538":1223,"_19130":49109,"_5":13154,"_26074":48710,"_2645":49110},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3146":1380,"_27538":1223,"_19130":49112,"_5":13154,"_26074":48710,"_2645":49113},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3146":1381,"_27538":1223,"_19130":49115,"_5":13154,"_26074":48714,"_2645":49116},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3146":1382,"_27538":1223,"_19130":49118,"_5":13154,"_26074":48714,"_2645":49119},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3146":1383,"_27538":1223,"_19130":49121,"_5":13154,"_26074":48718,"_2645":49122},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3146":1384,"_27538":1223,"_19130":49124,"_5":13154,"_26074":48718,"_2645":49125},[],"There are two action types:",{"_3146":1385,"_27538":1223,"_19130":49127,"_5":13154,"_26074":48718,"_2645":49128},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3146":1386,"_27538":1223,"_19130":49130,"_5":13154,"_26074":48718,"_2645":49131},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3146":1387,"_27538":1223,"_19130":49133,"_5":13154,"_26074":48718,"_2645":49134},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3146":1388,"_27538":1223,"_19130":49136,"_5":13154,"_26074":48722,"_2645":49137},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3146":1389,"_27538":1223,"_19130":49139,"_5":13154,"_26074":48722,"_2645":49140},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3146":1390,"_27538":1223,"_19130":49142,"_5":13154,"_26074":48722,"_2645":49143},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3146":1391,"_27538":1223,"_19130":49145,"_5":13154,"_26074":48726,"_2645":49146},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3146":1392,"_27538":1223,"_19130":49148,"_5":13154,"_26074":48726,"_2645":49149},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3146":1393,"_27538":1223,"_19130":49151,"_5":13154,"_26074":48726,"_2645":49152},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3146":1394,"_27538":1223,"_19130":49154,"_5":13154,"_26074":48726,"_2645":49155},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3146":1395,"_27538":1223,"_19130":49157,"_5":13154,"_26074":48726,"_2645":49158},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3146":1396,"_27538":1223,"_19130":49160,"_5":13154,"_26074":48726,"_2645":49161},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3146":1397,"_27538":1223,"_19130":49163,"_5":13154,"_26074":48726,"_2645":49164},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3146":1398,"_27538":1223,"_19130":49166,"_5":13154,"_26074":48726,"_2645":49167},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3146":1399,"_27538":1223,"_19130":49169,"_5":13154,"_26074":48726,"_2645":49170},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3146":1400,"_27538":1223,"_19130":49172,"_5":13154,"_26074":48726,"_2645":49173},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3146":1401,"_27538":1223,"_19130":49175,"_5":13154,"_26074":48726,"_2645":49176},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3146":1402,"_27538":1223,"_19130":49178,"_5":13154,"_26074":48726,"_2645":49179},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3146":1403,"_27538":1223,"_19130":49181,"_5":13154,"_26074":48726,"_2645":49182},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3146":1404,"_27538":1223,"_19130":49184,"_5":13154,"_26074":48726,"_2645":49185},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3146":1405,"_27538":1223,"_19130":49187,"_5":13154,"_26074":48726,"_2645":49188},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3146":1406,"_27538":1223,"_19130":49190,"_5":13154,"_26074":48726,"_2645":49191},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3146":1407,"_27538":1223,"_19130":49193,"_5":13154,"_26074":48726,"_2645":49194},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3146":1408,"_27538":1223,"_19130":49196,"_5":13154,"_26074":48726,"_2645":49197},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3146":1409,"_27538":1223,"_19130":49199,"_5":13154,"_26074":48726,"_2645":49200},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3146":1410,"_27538":1223,"_19130":49202,"_5":13154,"_26074":48726,"_2645":49203},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3146":1411,"_27538":1223,"_19130":49205,"_5":13154,"_26074":48726,"_2645":49206},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3146":1412,"_27538":1412,"_5":13480,"_2645":47187,"_27881":49208,"_19130":49209,"_26074":1412},[44830,46210,47187],[],{"_3146":1413,"_27538":1412,"_19130":49211,"_5":13154,"_26074":1412,"_2645":49212},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3146":1414,"_27538":1412,"_5":27878,"_19130":49214,"_26074":49215,"_2645":49216},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#start-here","Start here",{"_3146":1415,"_27538":1412,"_5":27878,"_19130":49218,"_26074":49219,"_2645":47185},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#devices-and-identities",{"_3146":1416,"_27538":1412,"_5":27878,"_19130":49221,"_26074":49222,"_2645":47368},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#enrollment-with-pki",{"_3146":1417,"_27538":1412,"_5":27878,"_19130":49224,"_26074":49225,"_2645":48643},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#integrations",{"_3146":1418,"_27538":1412,"_5":27878,"_19130":49227,"_26074":49228,"_2645":49229},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3146":1419,"_27538":1412,"_19130":49231,"_5":13154,"_26074":1412,"_2645":49232},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3146":1420,"_27538":1412,"_19130":49234,"_5":13154,"_26074":49215,"_2645":49235},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3146":1421,"_27538":1412,"_19130":49237,"_5":13154,"_26074":49215,"_2645":49238},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3146":1422,"_27538":1412,"_19130":49240,"_5":13154,"_26074":49219,"_2645":49241},[],"Resource",{"_3146":1423,"_27538":1412,"_19130":49243,"_5":13154,"_26074":49219,"_2645":49244},[],"What it represents",{"_3146":1424,"_27538":1412,"_19130":49246,"_5":13154,"_26074":49219,"_2645":49247},[],"**Device**",{"_3146":1425,"_27538":1412,"_19130":49249,"_5":13154,"_26074":49219,"_2645":49250},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3146":1426,"_27538":1412,"_19130":49252,"_5":13154,"_26074":49219,"_2645":49253},[],"**Identity**",{"_3146":1427,"_27538":1412,"_19130":49255,"_5":13154,"_26074":49219,"_2645":49256},[],"The device's association with its certificates: an active version and a history.",{"_3146":1428,"_27538":1412,"_19130":49258,"_5":13154,"_26074":49219,"_2645":49259},[],"**DMS**",{"_3146":1429,"_27538":1412,"_19130":49261,"_5":13154,"_26074":49219,"_2645":49262},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3146":1430,"_27538":1412,"_19130":49264,"_5":13154,"_26074":49219,"_2645":49265},[],"**Fleet**",{"_3146":1431,"_27538":1412,"_19130":49267,"_5":13154,"_26074":49219,"_2645":49268},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3146":1432,"_27538":1412,"_19130":49270,"_5":13154,"_26074":49219,"_2645":49271},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3146":1433,"_27538":1412,"_19130":49273,"_5":13154,"_26074":49219,"_2645":49274},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3146":1434,"_27538":1412,"_19130":49276,"_5":13154,"_26074":49222,"_2645":49277},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3146":1435,"_27538":1412,"_19130":49279,"_5":13154,"_26074":49222,"_2645":49280},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3146":1436,"_27538":1412,"_19130":49282,"_5":13154,"_26074":49222,"_2645":49283},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3146":1437,"_27538":1412,"_19130":49285,"_5":13154,"_26074":49222,"_2645":49286},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3146":1438,"_27538":1412,"_19130":49288,"_5":13154,"_26074":49222,"_2645":49289},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3146":1439,"_27538":1412,"_19130":49291,"_5":13154,"_26074":49222,"_2645":49292},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3146":1440,"_27538":1412,"_19130":49294,"_5":13154,"_26074":49222,"_2645":49295},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3146":1441,"_27538":1412,"_19130":49297,"_5":13154,"_26074":49222,"_2645":49298},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3146":1442,"_27538":1412,"_19130":49300,"_5":13154,"_26074":49225,"_2645":49301},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3146":1443,"_27538":1412,"_19130":49303,"_5":13154,"_26074":49225,"_2645":49304},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3146":1444,"_27538":1412,"_19130":49306,"_5":13154,"_26074":49228,"_2645":49307},[],"Participant",{"_3146":1445,"_27538":1412,"_19130":49309,"_5":13154,"_26074":49228,"_2645":49310},[],"Responsibility",{"_3146":1446,"_27538":1412,"_19130":49312,"_5":13154,"_26074":49228,"_2645":49313},[],"PKI administrator",{"_3146":1447,"_27538":1412,"_19130":49315,"_5":13154,"_26074":49228,"_2645":49316},[],"CA, issuance profile, chain and revocation publication.",{"_3146":1448,"_27538":1412,"_19130":49318,"_5":13154,"_26074":49228,"_2645":49319},[],"Provisioning administrator",{"_3146":1449,"_27538":1412,"_19130":49321,"_5":13154,"_26074":49228,"_2645":49322},[],"DMS, admission, authentication per operation and inventory.",{"_3146":1450,"_27538":1412,"_19130":49324,"_5":13154,"_26074":49228,"_2645":49325},[],"Device integrator",{"_3146":1451,"_27538":1412,"_19130":49327,"_5":13154,"_26074":49228,"_2645":49328},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3146":1452,"_27538":1412,"_19130":49330,"_5":13154,"_26074":49228,"_2645":49331},[],"Consumer integrator",{"_3146":1453,"_27538":1412,"_19130":49333,"_5":13154,"_26074":49228,"_2645":49334},[],"Trusted issuers, validation and device permissions in the destination.",{"_3146":1454,"_27538":1412,"_19130":49336,"_5":13154,"_26074":49228,"_2645":49337},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3146":1455,"_27538":1455,"_5":13480,"_2645":49339,"_27881":49340,"_19130":49342,"_26074":1455},"Enroll and connect your first device",[44830,46210,47187,49341],"Getting started",[],{"_3146":1456,"_27538":1455,"_19130":49344,"_5":13154,"_26074":1455,"_2645":49345},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3146":1457,"_27538":1455,"_5":27878,"_19130":49347,"_26074":49348,"_2645":44840},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3146":1458,"_27538":1455,"_5":27878,"_19130":49350,"_26074":49351,"_2645":49352},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3146":1459,"_27538":1455,"_5":27878,"_19130":49354,"_26074":49355,"_2645":49356},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3146":1460,"_27538":1455,"_5":27878,"_19130":49358,"_26074":49359,"_2645":49360},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3146":1461,"_27538":1455,"_5":27878,"_19130":49362,"_26074":49363,"_2645":49364},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3146":1462,"_27538":1455,"_5":27878,"_19130":49366,"_26074":49367,"_2645":49368},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3146":1463,"_27538":1455,"_5":27878,"_19130":49370,"_26074":49371,"_2645":49372},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3146":1464,"_27538":1455,"_5":27878,"_19130":49374,"_26074":49375,"_2645":49376},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3146":1465,"_27538":1455,"_19130":49378,"_5":13154,"_26074":1455,"_2645":49379},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3146":1466,"_27538":1455,"_19130":49381,"_5":13154,"_26074":49348,"_2645":49382},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3146":1467,"_27538":1455,"_19130":49384,"_5":13154,"_26074":49348,"_2645":49385},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3146":1468,"_27538":1455,"_19130":49387,"_5":13154,"_26074":49348,"_2645":49388},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3146":1469,"_27538":1455,"_19130":49390,"_5":13154,"_26074":49348,"_2645":49391},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3146":1470,"_27538":1455,"_19130":49393,"_5":13154,"_26074":49348,"_2645":49394},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3146":1471,"_27538":1455,"_19130":49396,"_5":13154,"_26074":49351,"_2645":49397},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3146":1472,"_27538":1455,"_19130":49399,"_5":13154,"_26074":49351,"_2645":49400},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3146":1473,"_27538":1455,"_19130":49402,"_5":13154,"_26074":49355,"_2645":49403},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3146":1474,"_27538":1455,"_19130":49405,"_5":13154,"_26074":49355,"_2645":49406},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3146":1475,"_27538":1455,"_19130":49408,"_5":13154,"_26074":49355,"_2645":49409},[],"Setting",{"_3146":1476,"_27538":1455,"_19130":49411,"_5":13154,"_26074":49355,"_2645":49412},[],"Evaluation value",{"_3146":1477,"_27538":1455,"_19130":49414,"_5":13154,"_26074":49355,"_2645":49415},[],"Enrollment CA",{"_3146":1478,"_27538":1455,"_19130":49417,"_5":13154,"_26074":49355,"_2645":49418},[],"Issuing root from `device-root.pem`.",{"_3146":1479,"_27538":1455,"_19130":49420,"_5":13154,"_26074":49355,"_2645":47498},[],{"_3146":1480,"_27538":1455,"_19130":49422,"_5":13154,"_26074":49355,"_2645":49423},[],"The 1-hour leaf profile you just prepared.",{"_3146":1481,"_27538":1455,"_19130":49425,"_5":13154,"_26074":49355,"_2645":49426},[],"Protocol / Registration Mode",{"_3146":1482,"_27538":1455,"_19130":49428,"_5":13154,"_26074":49355,"_2645":49429},[],"`EST_RFC7030` / `JITP`.",{"_3146":1483,"_27538":1455,"_19130":49431,"_5":13154,"_26074":49355,"_2645":49432},[],"Verify CSR Signature",{"_3146":1484,"_27538":1455,"_19130":49434,"_5":13154,"_26074":49355,"_2645":49435},[],"Enabled.",{"_3146":1485,"_27538":1455,"_19130":49437,"_5":13154,"_26074":49355,"_2645":49438},[],"Enable Replaceable Enrollment",{"_3146":1486,"_27538":1455,"_19130":49440,"_5":13154,"_26074":49355,"_2645":49441},[],"Disabled; the ID must be new.",{"_3146":1487,"_27538":1455,"_19130":49443,"_5":13154,"_26074":49355,"_2645":49444},[],"Initial authentication",{"_3146":1488,"_27538":1455,"_19130":49446,"_5":13154,"_26074":49355,"_2645":49447},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3146":1489,"_27538":1455,"_19130":49449,"_5":13154,"_26074":49355,"_2645":49450},[],"Renewal authentication",{"_3146":1490,"_27538":1455,"_19130":49452,"_5":13154,"_26074":49355,"_2645":49453},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3146":1491,"_27538":1455,"_19130":49455,"_5":13154,"_26074":49355,"_2645":49456},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3146":1492,"_27538":1455,"_19130":49458,"_5":13154,"_26074":49355,"_2645":49459},[],"Empty list for this direct issuance / disabled.",{"_3146":1493,"_27538":1455,"_19130":49461,"_5":13154,"_26074":49355,"_2645":49462},[],"Re-enrollment Delta",{"_3146":1494,"_27538":1455,"_19130":49464,"_5":13154,"_26074":49355,"_2645":49465},[],"1 hour.",{"_3146":1495,"_27538":1455,"_19130":49467,"_5":13154,"_26074":49355,"_2645":49468},[],"Preventive / Critical Delta",{"_3146":1496,"_27538":1455,"_19130":49470,"_5":13154,"_26074":49355,"_2645":49471},[],"30 minutes / 10 minutes.",{"_3146":1497,"_27538":1455,"_19130":49473,"_5":13154,"_26074":49355,"_2645":49474},[],"Revoke on Re-enrollment",{"_3146":1498,"_27538":1455,"_19130":49476,"_5":13154,"_26074":49355,"_2645":49477},[],"Disabled to test the successor before retiring the previous identity.",{"_3146":1499,"_27538":1455,"_19130":49479,"_5":13154,"_26074":49355,"_2645":47506},[],{"_3146":1500,"_27538":1455,"_19130":49481,"_5":13154,"_26074":49355,"_2645":49482},[],"Disabled; the operational key is generated in the client.",{"_3146":1501,"_27538":1455,"_19130":49484,"_5":13154,"_26074":49355,"_2645":49485},[],"CA Distribution",{"_3146":1502,"_27538":1455,"_19130":49487,"_5":13154,"_26074":49355,"_2645":49488},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3146":1503,"_27538":1455,"_19130":49490,"_5":13154,"_26074":49355,"_2645":49491},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_3146":1504,"_27538":1455,"_19130":49493,"_5":13154,"_26074":49359,"_2645":49494},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3146":1505,"_27538":1455,"_19130":49496,"_5":13154,"_26074":49359,"_2645":49497},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3146":1506,"_27538":1455,"_19130":49499,"_5":13154,"_26074":49363,"_2645":49500},[],"Generate a new key and CSR with the selected identifier:",{"_3146":1507,"_27538":1455,"_19130":49502,"_5":13154,"_26074":49363,"_2645":49503},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3146":1508,"_27538":1455,"_19130":49505,"_5":13154,"_26074":49363,"_2645":49506},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3146":1509,"_27538":1455,"_19130":49508,"_5":13154,"_26074":49367,"_2645":49509},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3146":1510,"_27538":1455,"_19130":49511,"_5":13154,"_26074":49367,"_2645":49512},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3146":1511,"_27538":1455,"_19130":49514,"_5":13154,"_26074":49371,"_2645":49515},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3146":1512,"_27538":1455,"_19130":49517,"_5":13154,"_26074":49371,"_2645":49518},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3146":1513,"_27538":1455,"_19130":49520,"_5":13154,"_26074":49371,"_2645":49521},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3146":1514,"_27538":1455,"_19130":49523,"_5":13154,"_26074":49371,"_2645":49524},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3146":1515,"_27538":1455,"_19130":49526,"_5":13154,"_26074":49371,"_2645":49527},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3146":1516,"_27538":1455,"_19130":49529,"_5":13154,"_26074":49375,"_2645":49530},[],"Check",{"_3146":1517,"_27538":1455,"_19130":49532,"_5":13154,"_26074":49375,"_2645":49533},[],"Expected result",{"_3146":1518,"_27538":1455,"_19130":49535,"_5":13154,"_26074":49375,"_2645":49536},[],"Registration",{"_3146":1519,"_27538":1455,"_19130":49538,"_5":13154,"_26074":49375,"_2645":49539},[],"ID created automatically and correct DMS.",{"_3146":1520,"_27538":1455,"_19130":49541,"_5":13154,"_26074":49375,"_2645":49542},[],"Certificate",{"_3146":1521,"_27538":1455,"_19130":49544,"_5":13154,"_26074":49375,"_2645":49545},[],"CN, profile, serial and key verified.",{"_3146":1522,"_27538":1455,"_19130":49547,"_5":13154,"_26074":49375,"_2645":49548},[],"Inventory",{"_3146":1523,"_27538":1455,"_19130":49550,"_5":13154,"_26074":49375,"_2645":49551},[],"Received serial visible as the current identity and in history.",{"_3146":1524,"_27538":1455,"_19130":49553,"_5":13154,"_26074":49375,"_2645":49554},[],"Consumer",{"_3146":1525,"_27538":1455,"_19130":49556,"_5":13154,"_26074":49375,"_2645":49557},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3146":1526,"_27538":1455,"_19130":49559,"_5":13154,"_26074":49375,"_2645":49560},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3146":1527,"_27538":1455,"_19130":49562,"_5":13154,"_26074":49375,"_2645":49563},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3146":1528,"_27538":1528,"_5":13480,"_2645":47203,"_27881":49565,"_19130":49566,"_26074":1528},[44830,46210,47187,49341],[],{"_3146":1529,"_27538":1528,"_19130":49568,"_5":13154,"_26074":1528,"_2645":49569},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3146":1530,"_27538":1528,"_5":27878,"_19130":49571,"_26074":49572,"_2645":44840},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3146":1531,"_27538":1528,"_5":27878,"_19130":49574,"_26074":49575,"_2645":49576},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3146":1532,"_27538":1528,"_5":27878,"_19130":49578,"_26074":49579,"_2645":49580},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3146":1533,"_27538":1528,"_5":27878,"_19130":49582,"_26074":49583,"_2645":49584},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3146":1534,"_27538":1528,"_5":27878,"_19130":49586,"_26074":49587,"_2645":49588},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3146":1535,"_27538":1528,"_5":27878,"_19130":49590,"_26074":49591,"_2645":49592},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3146":1536,"_27538":1528,"_5":27878,"_19130":49594,"_26074":49595,"_2645":49533},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3146":1537,"_27538":1528,"_5":27878,"_19130":49597,"_26074":49598,"_2645":49599},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3146":1538,"_27538":1528,"_5":27878,"_19130":49601,"_26074":49602,"_2645":49603},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3146":1539,"_27538":1528,"_19130":49605,"_5":13154,"_26074":1528,"_2645":49606},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3146":1540,"_27538":1528,"_19130":49608,"_5":13154,"_26074":1528,"_2645":49609},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3146":1541,"_27538":1528,"_19130":49611,"_5":13154,"_26074":49572,"_2645":49612},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3146":1542,"_27538":1528,"_19130":49614,"_5":13154,"_26074":49572,"_2645":49615},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3146":1543,"_27538":1528,"_19130":49617,"_5":13154,"_26074":49572,"_2645":49618},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3146":1544,"_27538":1528,"_19130":49620,"_5":13154,"_26074":49572,"_2645":49621},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3146":1545,"_27538":1528,"_19130":49623,"_5":13154,"_26074":49575,"_2645":49624},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3146":1546,"_27538":1528,"_19130":49626,"_5":13154,"_26074":49575,"_2645":49627},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3146":1547,"_27538":1528,"_19130":49629,"_5":13154,"_26074":49575,"_2645":49630},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3146":1548,"_27538":1528,"_19130":49632,"_5":13154,"_26074":49575,"_2645":49633},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3146":1549,"_27538":1528,"_19130":49635,"_5":13154,"_26074":49575,"_2645":49636},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_3146":1550,"_27538":1528,"_19130":49638,"_5":13154,"_26074":49575,"_2645":49639},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3146":1551,"_27538":1528,"_19130":49641,"_5":13154,"_26074":49575,"_2645":49642},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3146":1552,"_27538":1528,"_19130":49644,"_5":13154,"_26074":49575,"_2645":49645},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3146":1553,"_27538":1528,"_19130":49647,"_5":13154,"_26074":49579,"_2645":49648},[],"Open **Managed Devices** and the registration action. Complete:",{"_3146":1554,"_27538":1528,"_19130":49650,"_5":13154,"_26074":49579,"_2645":49651},[],"**Device ID**: `device-001`.",{"_3146":1555,"_27538":1528,"_19130":49653,"_5":13154,"_26074":49579,"_2645":49654},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3146":1556,"_27538":1528,"_19130":49656,"_5":13154,"_26074":49579,"_2645":49657},[],"**Icon** and **Tags**: optional classification.",{"_3146":1557,"_27538":1528,"_19130":49659,"_5":13154,"_26074":49579,"_2645":49660},[],"Confirm registration.",{"_3146":1558,"_27538":1528,"_19130":49662,"_5":13154,"_26074":49583,"_2645":49663},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3146":1559,"_27538":1528,"_19130":49665,"_5":13154,"_26074":49583,"_2645":49666},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3146":1560,"_27538":1528,"_19130":49668,"_5":13154,"_26074":49587,"_2645":49669},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3146":1561,"_27538":1528,"_19130":49671,"_5":13154,"_26074":49587,"_2645":49672},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3146":1562,"_27538":1528,"_19130":49674,"_5":13154,"_26074":49591,"_2645":49675},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3146":1563,"_27538":1528,"_19130":49677,"_5":13154,"_26074":49591,"_2645":49678},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3146":1564,"_27538":1528,"_19130":49680,"_5":13154,"_26074":49595,"_2645":49530},[],{"_3146":1565,"_27538":1528,"_19130":49682,"_5":13154,"_26074":49595,"_2645":49683},[],"Result",{"_3146":1566,"_27538":1528,"_19130":49685,"_5":13154,"_26074":49595,"_2645":49686},[],"Device",{"_3146":1567,"_27538":1528,"_19130":49688,"_5":13154,"_26074":49595,"_2645":49689},[],"`device-001` appears in inventory with the expected DMS.",{"_3146":1568,"_27538":1528,"_19130":49691,"_5":13154,"_26074":49595,"_2645":49692},[],"Current identity",{"_3146":1569,"_27538":1528,"_19130":49694,"_5":13154,"_26074":49595,"_2645":49695},[],"The associated certificate matches the one you verified in PKI.",{"_3146":1570,"_27538":1528,"_19130":49697,"_5":13154,"_26074":49595,"_2645":49698},[],"History",{"_3146":1571,"_27538":1528,"_19130":49700,"_5":13154,"_26074":49595,"_2645":49701},[],"The associated issuance appears with its serial number and dates.",{"_3146":1572,"_27538":1528,"_19130":49703,"_5":13154,"_26074":49595,"_2645":49704},[],"Key and certificate",{"_3146":1573,"_27538":1528,"_19130":49706,"_5":13154,"_26074":49595,"_2645":49707},[],"You have the verified pair ready to install on the device.",{"_3146":1574,"_27538":1528,"_19130":49709,"_5":13154,"_26074":49598,"_2645":49710},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3146":1575,"_27538":1528,"_19130":49712,"_5":13154,"_26074":49598,"_2645":49713},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3146":1576,"_27538":1528,"_19130":49715,"_5":13154,"_26074":49598,"_2645":49716},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3146":1577,"_27538":1528,"_19130":49718,"_5":13154,"_26074":49598,"_2645":49719},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3146":1578,"_27538":1528,"_19130":49721,"_5":13154,"_26074":49602,"_2645":49722},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3146":1579,"_27538":1528,"_19130":49724,"_5":13154,"_26074":49602,"_2645":49725},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3146":1580,"_27538":1528,"_19130":49727,"_5":13154,"_26074":49602,"_2645":49728},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3146":1581,"_27538":1581,"_5":13480,"_2645":49730,"_27881":49731,"_19130":49732,"_26074":1581},"Lamassu IoT Platform",[44830,46210],[],{"_3146":1582,"_27538":1581,"_19130":49734,"_5":13154,"_26074":1581,"_2645":49735},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3146":1583,"_27538":1581,"_5":27878,"_19130":49737,"_26074":49738,"_2645":49216},[],"/docs/pr-preview/pr-26/platform/overview#start-here",{"_3146":1584,"_27538":1581,"_5":27878,"_19130":49740,"_26074":49741,"_2645":49742},[],"/docs/pr-preview/pr-26/platform/overview#choose-your-path","Choose your path",{"_3146":1585,"_27538":1581,"_5":27878,"_19130":49744,"_26074":49745,"_2645":49746},[],"/docs/pr-preview/pr-26/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3146":1586,"_27538":1581,"_5":27878,"_19130":49748,"_26074":49749,"_2645":49750},[],"/docs/pr-preview/pr-26/platform/overview#core-capabilities","Core capabilities",{"_3146":1587,"_27538":1581,"_5":27878,"_19130":49752,"_26074":49753,"_2645":49754},[],"/docs/pr-preview/pr-26/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3146":1588,"_27538":1581,"_5":27878,"_19130":49756,"_26074":49757,"_2645":49758},[],"/docs/pr-preview/pr-26/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3146":1589,"_27538":1581,"_5":27878,"_19130":49760,"_26074":49761,"_2645":49762},[],"/docs/pr-preview/pr-26/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3146":1590,"_27538":1581,"_5":27878,"_19130":49764,"_26074":49765,"_2645":49766},[],"/docs/pr-preview/pr-26/platform/overview#automate-device-identities","Automate device identities",{"_3146":1591,"_27538":1581,"_5":27878,"_19130":49768,"_26074":49769,"_2645":49770},[],"/docs/pr-preview/pr-26/platform/overview#publish-validation-status","Publish validation status",{"_3146":1592,"_27538":1581,"_5":27878,"_19130":49772,"_26074":49773,"_2645":49774},[],"/docs/pr-preview/pr-26/platform/overview#react-to-events","React to events",{"_3146":1593,"_27538":1581,"_5":27878,"_19130":49776,"_26074":49777,"_2645":49778},[],"/docs/pr-preview/pr-26/platform/overview#operational-reference","Operational reference",{"_3146":1594,"_27538":1581,"_19130":49780,"_5":13154,"_26074":1581,"_2645":49781},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3146":1595,"_27538":1581,"_19130":49783,"_5":13154,"_26074":49738,"_2645":49784},[],"Choose the result you need:",{"_3146":1596,"_27538":1581,"_19130":49786,"_5":13154,"_26074":49738,"_2645":49787},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3146":1597,"_27538":1581,"_19130":49789,"_5":13154,"_26074":49738,"_2645":49790},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3146":1598,"_27538":1581,"_19130":49792,"_5":13154,"_26074":49738,"_2645":49793},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3146":1599,"_27538":1581,"_19130":49795,"_5":13154,"_26074":49741,"_2645":49796},[],"Section",{"_3146":1600,"_27538":1581,"_19130":49798,"_5":13154,"_26074":49741,"_2645":49799},[],"What you manage",{"_3146":1601,"_27538":1581,"_19130":49801,"_5":13154,"_26074":49741,"_2645":49802},[],"Entry point",{"_3146":1602,"_27538":1581,"_19130":49804,"_5":13154,"_26074":49741,"_2645":49805},[],"**PKI**",{"_3146":1603,"_27538":1581,"_19130":49807,"_5":13154,"_26074":49741,"_2645":49808},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3146":1604,"_27538":1581,"_19130":49810,"_5":13154,"_26074":49741,"_2645":49811},[],"PKI overview",{"_3146":1605,"_27538":1581,"_19130":49813,"_5":13154,"_26074":49741,"_2645":49814},[],"**IoT Fleets**",{"_3146":1606,"_27538":1581,"_19130":49816,"_5":13154,"_26074":49741,"_2645":49817},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3146":1607,"_27538":1581,"_19130":49819,"_5":13154,"_26074":49741,"_2645":49820},[],"IoT Fleets overview",{"_3146":1608,"_27538":1581,"_19130":49822,"_5":13154,"_26074":49741,"_2645":49823},[],"**Administration**",{"_3146":1609,"_27538":1581,"_19130":49825,"_5":13154,"_26074":49741,"_2645":49826},[],"Operator permissions, audit and event subscriptions.",{"_3146":1610,"_27538":1581,"_19130":49828,"_5":13154,"_26074":49741,"_2645":46208},[],{"_3146":1611,"_27538":1581,"_19130":49830,"_5":13154,"_26074":49741,"_2645":49831},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3146":1612,"_27538":1581,"_19130":49833,"_5":13154,"_26074":49745,"_2645":49834},[],"An identity's journey connects four responsibilities:",{"_3146":1613,"_27538":1581,"_19130":49836,"_5":13154,"_26074":49745,"_2645":49837},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3146":1614,"_27538":1581,"_19130":49839,"_5":13154,"_26074":49745,"_2645":49840},[],"The provisioning administrator configures the DMS and initial trust.",{"_3146":1615,"_27538":1581,"_19130":49842,"_5":13154,"_26074":49745,"_2645":49843},[],"The device client requests a certificate and installs it with the matching key.",{"_3146":1616,"_27538":1581,"_19130":49845,"_5":13154,"_26074":49745,"_2645":49846},[],"The consumer validates the identity and applies its access permissions.",{"_3146":1617,"_27538":1581,"_19130":49848,"_5":13154,"_26074":49745,"_2645":49849},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3146":1618,"_27538":1581,"_19130":49851,"_5":13154,"_26074":49753,"_2645":49852},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3146":1619,"_27538":1581,"_19130":49854,"_5":13154,"_26074":49757,"_2645":49855},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3146":1620,"_27538":1581,"_19130":49857,"_5":13154,"_26074":49761,"_2645":49858},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3146":1621,"_27538":1581,"_19130":49860,"_5":13154,"_26074":49765,"_2645":49861},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3146":1622,"_27538":1581,"_19130":49863,"_5":13154,"_26074":49769,"_2645":49864},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3146":1623,"_27538":1581,"_19130":49866,"_5":13154,"_26074":49773,"_2645":49867},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3146":1624,"_27538":1581,"_19130":49869,"_5":13154,"_26074":49777,"_2645":49310},[],{"_3146":1625,"_27538":1581,"_19130":49871,"_5":13154,"_26074":49777,"_2645":49872},[],"What it prepares or checks",{"_3146":1626,"_27538":1581,"_19130":49874,"_5":13154,"_26074":49777,"_2645":49313},[],{"_3146":1627,"_27538":1581,"_19130":49876,"_5":13154,"_26074":49777,"_2645":49877},[],"Key custody, CA hierarchy, profiles and validation.",{"_3146":1628,"_27538":1581,"_19130":49879,"_5":13154,"_26074":49777,"_2645":49880},[],"Fleet administrator",{"_3146":1629,"_27538":1581,"_19130":49882,"_5":13154,"_26074":49777,"_2645":49883},[],"DMS, device admission, renewal policy and inventory.",{"_3146":1630,"_27538":1581,"_19130":49885,"_5":13154,"_26074":49777,"_2645":49325},[],{"_3146":1631,"_27538":1581,"_19130":49887,"_5":13154,"_26074":49777,"_2645":49888},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3146":1632,"_27538":1581,"_19130":49890,"_5":13154,"_26074":49777,"_2645":49331},[],{"_3146":1633,"_27538":1581,"_19130":49892,"_5":13154,"_26074":49777,"_2645":49893},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3146":1634,"_27538":1581,"_19130":49895,"_5":13154,"_26074":49777,"_2645":49896},[],"Infrastructure operator",{"_3146":1635,"_27538":1581,"_19130":49898,"_5":13154,"_26074":49777,"_2645":49899},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3146":1636,"_27538":1581,"_19130":49901,"_5":13154,"_26074":49777,"_2645":49902},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3146":1637,"_27538":1637,"_5":13480,"_2645":49904,"_27881":49905,"_19130":49908,"_26074":1637},"CA hierarchy and rotation",[44830,46210,49906,49907],"PKI","Keys, authorities and certificates",[],{"_3146":1638,"_27538":1637,"_19130":49910,"_5":13154,"_26074":1637,"_2645":49911},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3146":1639,"_27538":1637,"_5":27878,"_19130":49913,"_26074":49914,"_2645":49915},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3146":1640,"_27538":1637,"_5":27878,"_19130":49917,"_26074":49918,"_2645":49919},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3146":1641,"_27538":1637,"_5":27878,"_19130":49921,"_26074":49922,"_2645":49923},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3146":1642,"_27538":1637,"_5":27878,"_19130":49925,"_26074":49926,"_2645":49927},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3146":1643,"_27538":1637,"_5":27878,"_19130":49929,"_26074":49930,"_2645":49931},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3146":1644,"_27538":1637,"_5":27878,"_19130":49933,"_26074":49934,"_2645":49935},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3146":1645,"_27538":1637,"_5":27878,"_19130":49937,"_26074":49938,"_2645":49939},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3146":1646,"_27538":1637,"_5":27878,"_19130":49941,"_26074":49942,"_2645":49943},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3146":1647,"_27538":1637,"_5":27878,"_19130":49945,"_26074":49946,"_2645":49947},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3146":1648,"_27538":1637,"_5":27878,"_19130":49949,"_26074":49950,"_2645":49951},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3146":1649,"_27538":1637,"_5":27878,"_19130":49953,"_26074":49954,"_2645":49955},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3146":1650,"_27538":1637,"_5":27878,"_19130":49957,"_26074":49958,"_2645":49959},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3146":1651,"_27538":1637,"_19130":49961,"_5":13154,"_26074":1637,"_2645":49962},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3146":1652,"_27538":1637,"_19130":49964,"_5":13154,"_26074":1637,"_2645":49965},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3146":1653,"_27538":1637,"_19130":49967,"_5":13154,"_26074":49914,"_2645":49968},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3146":1654,"_27538":1637,"_19130":49970,"_5":13154,"_26074":49914,"_2645":49971},[],"environment, such as production and preproduction;",{"_3146":1655,"_27538":1637,"_19130":49973,"_5":13154,"_26074":49914,"_2645":49974},[],"owner or operating team;",{"_3146":1656,"_27538":1637,"_19130":49976,"_5":13154,"_26074":49914,"_2645":49977},[],"device family or manufacturing process;",{"_3146":1657,"_27538":1637,"_19130":49979,"_5":13154,"_26074":49914,"_2645":49980},[],"region or regulatory requirement;",{"_3146":1658,"_27538":1637,"_19130":49982,"_5":13154,"_26074":49914,"_2645":49983},[],"cryptographic engine or key policy;",{"_3146":1659,"_27538":1637,"_19130":49985,"_5":13154,"_26074":49914,"_2645":49986},[],"maintenance window and renewal cadence.",{"_3146":1660,"_27538":1637,"_19130":49988,"_5":13154,"_26074":49914,"_2645":49989},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3146":1661,"_27538":1637,"_19130":49991,"_5":13154,"_26074":49914,"_2645":49992},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3146":1662,"_27538":1637,"_19130":49994,"_5":13154,"_26074":49918,"_2645":49995},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3146":1663,"_27538":1637,"_19130":49997,"_5":13154,"_26074":49918,"_2645":49998},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3146":1664,"_27538":1637,"_19130":50000,"_5":13154,"_26074":49918,"_2645":50001},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3146":1665,"_27538":1637,"_19130":50003,"_5":13154,"_26074":49922,"_2645":50004},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3146":1666,"_27538":1637,"_19130":50006,"_5":13154,"_26074":49922,"_2645":50007},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3146":1667,"_27538":1637,"_19130":50009,"_5":13154,"_26074":49922,"_2645":50010},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3146":1668,"_27538":1637,"_19130":50012,"_5":13154,"_26074":49922,"_2645":50013},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3146":1669,"_27538":1637,"_19130":50015,"_5":13154,"_26074":49930,"_2645":50016},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3146":1670,"_27538":1637,"_19130":50018,"_5":13154,"_26074":49934,"_2645":50019},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3146":1671,"_27538":1637,"_19130":50021,"_5":13154,"_26074":49938,"_2645":50022},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3146":1672,"_27538":1637,"_19130":50024,"_5":13154,"_26074":49942,"_2645":50025},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_3146":1673,"_27538":1637,"_19130":50027,"_5":13154,"_26074":49946,"_2645":50028},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3146":1674,"_27538":1637,"_19130":50030,"_5":13154,"_26074":49950,"_2645":50031},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_3146":1675,"_27538":1637,"_19130":50033,"_5":13154,"_26074":49954,"_2645":50034},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3146":1676,"_27538":1637,"_19130":50036,"_5":13154,"_26074":49954,"_2645":50037},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3146":1677,"_27538":1637,"_19130":50039,"_5":13154,"_26074":49954,"_2645":50040},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3146":1678,"_27538":1637,"_19130":50042,"_5":13154,"_26074":49954,"_2645":50043},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3146":1679,"_27538":1637,"_19130":50045,"_5":13154,"_26074":49958,"_2645":50046},[],"The new chain ends in an anchor installed by the consumer.",{"_3146":1680,"_27538":1637,"_19130":50048,"_5":13154,"_26074":49958,"_2645":50049},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3146":1681,"_27538":1637,"_19130":50051,"_5":13154,"_26074":49958,"_2645":50052},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3146":1682,"_27538":1637,"_19130":50054,"_5":13154,"_26074":49958,"_2645":50055},[],"Re-enrollment accepts the old identity during the planned period.",{"_3146":1683,"_27538":1637,"_19130":50057,"_5":13154,"_26074":49958,"_2645":50058},[],"OCSP and CRL respond for the authorities that remain active.",{"_3146":1684,"_27538":1637,"_19130":50060,"_5":13154,"_26074":49958,"_2645":50061},[],"No DMS is left accidentally issuing from the old CA.",{"_3146":1685,"_27538":1637,"_19130":50063,"_5":13154,"_26074":49958,"_2645":50064},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3146":1686,"_27538":1686,"_5":13480,"_2645":50066,"_27881":50067,"_19130":50068,"_26074":1686},"Certification authorities",[44830,46210,49906,49907],[],{"_3146":1687,"_27538":1686,"_19130":50070,"_5":13154,"_26074":1686,"_2645":50071},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3146":1688,"_27538":1686,"_5":27878,"_19130":50073,"_26074":50074,"_2645":50075},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3146":1689,"_27538":1686,"_5":27878,"_19130":50077,"_26074":50078,"_2645":50079},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3146":1690,"_27538":1686,"_5":27878,"_19130":50081,"_26074":50082,"_2645":44840},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#before-you-begin",{"_3146":1691,"_27538":1686,"_5":27878,"_19130":50084,"_26074":50085,"_2645":50086},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3146":1692,"_27538":1686,"_5":27878,"_19130":50088,"_26074":50089,"_2645":50090},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3146":1693,"_27538":1686,"_5":27878,"_19130":50092,"_26074":50093,"_2645":50094},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3146":1694,"_27538":1686,"_5":27878,"_19130":50096,"_26074":50097,"_2645":50098},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3146":1695,"_27538":1686,"_5":27878,"_19130":50100,"_26074":50101,"_2645":50102},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3146":1696,"_27538":1686,"_5":27878,"_19130":50104,"_26074":50105,"_2645":50106},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3146":1697,"_27538":1686,"_5":27878,"_19130":50108,"_26074":50109,"_2645":50110},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3146":1698,"_27538":1686,"_5":27878,"_19130":50112,"_26074":50113,"_2645":50114},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3146":1699,"_27538":1686,"_5":27878,"_19130":50116,"_26074":50117,"_2645":50118},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3146":1700,"_27538":1686,"_5":27878,"_19130":50120,"_26074":50121,"_2645":50122},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3146":1701,"_27538":1686,"_5":27878,"_19130":50124,"_26074":50125,"_2645":50126},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3146":1702,"_27538":1686,"_5":27878,"_19130":50128,"_26074":50129,"_2645":50130},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3146":1703,"_27538":1686,"_5":27878,"_19130":50132,"_26074":50133,"_2645":50134},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3146":1704,"_27538":1686,"_5":27878,"_19130":50136,"_26074":50137,"_2645":50138},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3146":1705,"_27538":1686,"_5":27878,"_19130":50140,"_26074":50141,"_2645":50142},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3146":1706,"_27538":1686,"_5":27878,"_19130":50144,"_26074":50145,"_2645":50146},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3146":1707,"_27538":1686,"_5":27878,"_19130":50148,"_26074":50149,"_2645":50150},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3146":1708,"_27538":1686,"_5":27878,"_19130":50152,"_26074":50153,"_2645":50154},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3146":1709,"_27538":1686,"_5":27878,"_19130":50156,"_26074":50157,"_2645":50158},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3146":1710,"_27538":1686,"_19130":50160,"_5":13154,"_26074":1686,"_2645":50161},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3146":1711,"_27538":1686,"_19130":50163,"_5":13154,"_26074":1686,"_2645":50164},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3146":1712,"_27538":1686,"_19130":50166,"_5":13154,"_26074":1686,"_2645":50167},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3146":1713,"_27538":1686,"_19130":50169,"_5":13154,"_26074":50074,"_2645":50170},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3146":1714,"_27538":1686,"_19130":50172,"_5":13154,"_26074":50074,"_2645":50173},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3146":1715,"_27538":1686,"_19130":50175,"_5":13154,"_26074":50074,"_2645":50176},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3146":1716,"_27538":1686,"_19130":50178,"_5":13154,"_26074":50074,"_2645":50179},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3146":1717,"_27538":1686,"_19130":50181,"_5":13154,"_26074":50074,"_2645":50182},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3146":1718,"_27538":1686,"_19130":50184,"_5":13154,"_26074":50082,"_2645":50185},[],"Decide whether the CA will be a root or an intermediate.",{"_3146":1719,"_27538":1686,"_19130":50187,"_5":13154,"_26074":50082,"_2645":50188},[],"Choose the engine that will keep the key.",{"_3146":1720,"_27538":1686,"_19130":50190,"_5":13154,"_26074":50082,"_2645":50191},[],"Define a validity longer than that of the certificates it will issue.",{"_3146":1721,"_27538":1686,"_19130":50193,"_5":13154,"_26074":50082,"_2645":50194},[],"For an intermediate CA, make sure the parent CA is active.",{"_3146":1722,"_27538":1686,"_19130":50196,"_5":13154,"_26074":50085,"_2645":50197},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3146":1723,"_27538":1686,"_19130":50199,"_5":13154,"_26074":50089,"_2645":50200},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3146":1724,"_27538":1686,"_19130":50202,"_5":13154,"_26074":50089,"_2645":50203},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3146":1725,"_27538":1686,"_19130":50205,"_5":13154,"_26074":50093,"_2645":50206},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3146":1726,"_27538":1686,"_19130":50208,"_5":13154,"_26074":50097,"_2645":50209},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3146":1727,"_27538":1686,"_19130":50211,"_5":13154,"_26074":50097,"_2645":50212},[],"`C`: two-letter ISO 3166-1 country code.",{"_3146":1728,"_27538":1686,"_19130":50214,"_5":13154,"_26074":50097,"_2645":50215},[],"`ST`: state or province.",{"_3146":1729,"_27538":1686,"_19130":50217,"_5":13154,"_26074":50097,"_2645":50218},[],"`L`: locality.",{"_3146":1730,"_27538":1686,"_19130":50220,"_5":13154,"_26074":50097,"_2645":50221},[],"`O`: organization.",{"_3146":1731,"_27538":1686,"_19130":50223,"_5":13154,"_26074":50097,"_2645":50224},[],"`OU`: organizational unit.",{"_3146":1732,"_27538":1686,"_19130":50226,"_5":13154,"_26074":50097,"_2645":50227},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3146":1733,"_27538":1686,"_19130":50229,"_5":13154,"_26074":50101,"_2645":50230},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3146":1734,"_27538":1686,"_19130":50232,"_5":13154,"_26074":50101,"_2645":50233},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3146":1735,"_27538":1686,"_19130":50235,"_5":13154,"_26074":50105,"_2645":50236},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3146":1736,"_27538":1686,"_19130":50238,"_5":13154,"_26074":50105,"_2645":50239},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3146":1737,"_27538":1686,"_19130":50241,"_5":13154,"_26074":50109,"_2645":50242},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3146":1738,"_27538":1686,"_19130":50244,"_5":13154,"_26074":50109,"_2645":50245},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3146":1739,"_27538":1686,"_19130":50247,"_5":13154,"_26074":50113,"_2645":50248},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3146":1740,"_27538":1686,"_19130":50250,"_5":13154,"_26074":50117,"_2645":50251},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3146":1741,"_27538":1686,"_19130":50253,"_5":13154,"_26074":50121,"_2645":50254},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3146":1742,"_27538":1686,"_19130":50256,"_5":13154,"_26074":50125,"_2645":50257},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3146":1743,"_27538":1686,"_19130":50259,"_5":13154,"_26074":50129,"_2645":50260},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3146":1744,"_27538":1686,"_19130":50262,"_5":13154,"_26074":50129,"_2645":50263},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3146":1745,"_27538":1686,"_19130":50265,"_5":13154,"_26074":50133,"_2645":50266},[],"Open a CA from the inventory to review:",{"_3146":1746,"_27538":1686,"_19130":50268,"_5":13154,"_26074":50133,"_2645":50269},[],"Status and validity period.",{"_3146":1747,"_27538":1686,"_19130":50271,"_5":13154,"_26074":50133,"_2645":50272},[],"Certificate and chain in PEM format.",{"_3146":1748,"_27538":1686,"_19130":50274,"_5":13154,"_26074":50133,"_2645":50275},[],"Number of active, expired and revoked certificates.",{"_3146":1749,"_27538":1686,"_19130":50277,"_5":13154,"_26074":50133,"_2645":50278},[],"Certificates issued in **Issued Certificates**.",{"_3146":1750,"_27538":1686,"_19130":50280,"_5":13154,"_26074":50133,"_2645":50281},[],"The CRL linked to the authority.",{"_3146":1751,"_27538":1686,"_19130":50283,"_5":13154,"_26074":50133,"_2645":50284},[],"Metadata and the associated cryptographic engine.",{"_3146":1752,"_27538":1686,"_19130":50286,"_5":13154,"_26074":50133,"_2645":50287},[],"You can filter the inventory by name, status and CA type.",{"_3146":1753,"_27538":1686,"_19130":50289,"_5":13154,"_26074":50137,"_2645":50290},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3146":1754,"_27538":1686,"_19130":50292,"_5":13154,"_26074":50137,"_2645":50293},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3146":1755,"_27538":1686,"_19130":50295,"_5":13154,"_26074":50137,"_2645":50296},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3146":1756,"_27538":1686,"_19130":50298,"_5":13154,"_26074":50137,"_2645":50299},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3146":1757,"_27538":1686,"_19130":50301,"_5":13154,"_26074":50141,"_2645":50302},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3146":1758,"_27538":1686,"_19130":50304,"_5":13154,"_26074":50145,"_2645":50305},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3146":1759,"_27538":1686,"_19130":50307,"_5":13154,"_26074":50149,"_2645":50308},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3146":1760,"_27538":1686,"_19130":50310,"_5":13154,"_26074":50153,"_2645":50311},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3146":1761,"_27538":1686,"_19130":50313,"_5":13154,"_26074":50157,"_2645":50314},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3146":1762,"_27538":1686,"_19130":50316,"_5":13154,"_26074":50157,"_2645":50317},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3146":1763,"_27538":1763,"_5":13480,"_2645":50319,"_27881":50320,"_19130":50321,"_26074":1763},"Certificate profiles",[44830,46210,49906,49907],[],{"_3146":1764,"_27538":1763,"_19130":50323,"_5":13154,"_26074":1763,"_2645":50324},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3146":1765,"_27538":1763,"_5":27878,"_19130":50326,"_26074":50327,"_2645":50328},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3146":1766,"_27538":1763,"_5":27878,"_19130":50330,"_26074":50331,"_2645":50332},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#validity","Validity",{"_3146":1767,"_27538":1763,"_5":27878,"_19130":50334,"_26074":50335,"_2645":50336},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3146":1768,"_27538":1763,"_5":27878,"_19130":50338,"_26074":50339,"_2645":50340},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3146":1769,"_27538":1763,"_5":27878,"_19130":50342,"_26074":50343,"_2645":50344},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#subject","Subject",{"_3146":1770,"_27538":1763,"_5":27878,"_19130":50346,"_26074":50347,"_2645":50348},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3146":1771,"_27538":1763,"_5":27878,"_19130":50350,"_26074":50351,"_2645":50352},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3146":1772,"_27538":1763,"_5":27878,"_19130":50354,"_26074":50355,"_2645":50356},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3146":1773,"_27538":1763,"_5":27878,"_19130":50358,"_26074":50359,"_2645":50360},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3146":1774,"_27538":1763,"_5":27878,"_19130":50362,"_26074":50363,"_2645":50364},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3146":1775,"_27538":1763,"_5":27878,"_19130":50366,"_26074":50367,"_2645":50368},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3146":1776,"_27538":1763,"_5":27878,"_19130":50370,"_26074":50371,"_2645":50372},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3146":1777,"_27538":1763,"_5":27878,"_19130":50374,"_26074":50375,"_2645":50376},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3146":1778,"_27538":1763,"_5":27878,"_19130":50378,"_26074":50379,"_2645":50380},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3146":1779,"_27538":1763,"_5":27878,"_19130":50382,"_26074":50383,"_2645":50384},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#design-examples","Design examples",{"_3146":1780,"_27538":1763,"_5":27878,"_19130":50386,"_26074":50387,"_2645":50388},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3146":1781,"_27538":1763,"_19130":50390,"_5":13154,"_26074":1763,"_2645":50391},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3146":1782,"_27538":1763,"_19130":50393,"_5":13154,"_26074":1763,"_2645":50394},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3146":1783,"_27538":1763,"_19130":50396,"_5":13154,"_26074":50331,"_2645":50397},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3146":1784,"_27538":1763,"_19130":50399,"_5":13154,"_26074":50331,"_2645":50400},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3146":1785,"_27538":1763,"_19130":50402,"_5":13154,"_26074":50335,"_2645":50403},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3146":1786,"_27538":1763,"_19130":50405,"_5":13154,"_26074":50339,"_2645":50406},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3146":1787,"_27538":1763,"_19130":50408,"_5":13154,"_26074":50339,"_2645":50409},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3146":1788,"_27538":1763,"_19130":50411,"_5":13154,"_26074":50339,"_2645":50412},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3146":1789,"_27538":1763,"_19130":50414,"_5":13154,"_26074":50343,"_2645":50415},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3146":1790,"_27538":1763,"_19130":50417,"_5":13154,"_26074":50347,"_2645":50418},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3146":1791,"_27538":1763,"_19130":50420,"_5":13154,"_26074":50347,"_2645":50421},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3146":1792,"_27538":1763,"_19130":50423,"_5":13154,"_26074":50351,"_2645":50424},[],"The cryptographic enforcement can:",{"_3146":1793,"_27538":1763,"_19130":50426,"_5":13154,"_26074":50351,"_2645":50427},[],"allow or block RSA keys;",{"_3146":1794,"_27538":1763,"_19130":50429,"_5":13154,"_26074":50351,"_2645":50430},[],"limit the supported RSA sizes;",{"_3146":1795,"_27538":1763,"_19130":50432,"_5":13154,"_26074":50351,"_2645":50433},[],"allow or block ECDSA keys;",{"_3146":1796,"_27538":1763,"_19130":50435,"_5":13154,"_26074":50351,"_2645":50436},[],"limit the supported ECDSA sizes or curves.",{"_3146":1797,"_27538":1763,"_19130":50438,"_5":13154,"_26074":50351,"_2645":50439},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3146":1798,"_27538":1763,"_19130":50441,"_5":13154,"_26074":50355,"_2645":50442},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3146":1799,"_27538":1763,"_19130":50444,"_5":13154,"_26074":50355,"_2645":47934},[],{"_3146":1800,"_27538":1763,"_19130":50446,"_5":13154,"_26074":50355,"_2645":50447},[],"First choice",{"_3146":1801,"_27538":1763,"_19130":50449,"_5":13154,"_26074":50355,"_2645":50450},[],"Second choice",{"_3146":1802,"_27538":1763,"_19130":50452,"_5":13154,"_26074":50355,"_2645":50453},[],"If neither is supplied",{"_3146":1803,"_27538":1763,"_19130":50455,"_5":13154,"_26074":50355,"_2645":50456},[],"Direct signing with a CA",{"_3146":1804,"_27538":1763,"_19130":50458,"_5":13154,"_26074":50355,"_2645":50459},[],"`issuance_profile` embedded in the request",{"_3146":1805,"_27538":1763,"_19130":50461,"_5":13154,"_26074":50355,"_2645":50462},[],"Request `issuance_profile_id`",{"_3146":1806,"_27538":1763,"_19130":50464,"_5":13154,"_26074":50355,"_2645":50465},[],"CA default profile (`profile_id`).",{"_3146":1807,"_27538":1763,"_19130":50467,"_5":13154,"_26074":50355,"_2645":50468},[],"Issuance through a DMS",{"_3146":1808,"_27538":1763,"_19130":50470,"_5":13154,"_26074":50355,"_2645":50471},[],"`settings.issuance_profile_id`",{"_3146":1809,"_27538":1763,"_19130":50473,"_5":13154,"_26074":50355,"_2645":50474},[],"`settings.issuance_profile` embedded in the DMS",{"_3146":1810,"_27538":1763,"_19130":50476,"_5":13154,"_26074":50355,"_2645":50477},[],"Enrollment CA default profile.",{"_3146":1811,"_27538":1763,"_19130":50479,"_5":13154,"_26074":50355,"_2645":50480},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3146":1812,"_27538":1763,"_19130":50482,"_5":13154,"_26074":50355,"_2645":50483},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3146":1813,"_27538":1763,"_19130":50485,"_5":13154,"_26074":50363,"_2645":50486},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3146":1814,"_27538":1763,"_19130":50488,"_5":13154,"_26074":50367,"_2645":50489},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3146":1815,"_27538":1763,"_19130":50491,"_5":13154,"_26074":50371,"_2645":50492},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3146":1816,"_27538":1763,"_19130":50494,"_5":13154,"_26074":50375,"_2645":50495},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3146":1817,"_27538":1763,"_19130":50497,"_5":13154,"_26074":50379,"_2645":50498},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3146":1818,"_27538":1763,"_19130":50500,"_5":13154,"_26074":50379,"_2645":50501},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3146":1819,"_27538":1763,"_19130":50503,"_5":13154,"_26074":50383,"_2645":50504},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3146":1820,"_27538":1763,"_19130":50506,"_5":13154,"_26074":50383,"_2645":50507},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3146":1821,"_27538":1763,"_19130":50509,"_5":13154,"_26074":50383,"_2645":50510},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3146":1822,"_27538":1763,"_19130":50512,"_5":13154,"_26074":50383,"_2645":50513},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3146":1823,"_27538":1763,"_19130":50515,"_5":13154,"_26074":50387,"_2645":50516},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3146":1824,"_27538":1763,"_19130":50518,"_5":13154,"_26074":50387,"_2645":50519},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3146":1825,"_27538":1825,"_5":13480,"_2645":50521,"_27881":50522,"_19130":50524,"_26074":1825},"Certificate validation",[44830,46210,49906,50523],"Validation",[],{"_3146":1826,"_27538":1825,"_19130":50526,"_5":13154,"_26074":1825,"_2645":50527},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3146":1827,"_27538":1825,"_5":27878,"_19130":50529,"_26074":50530,"_2645":50531},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3146":1828,"_27538":1825,"_5":27878,"_19130":50533,"_26074":50534,"_2645":50535},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3146":1829,"_27538":1825,"_5":27878,"_19130":50537,"_26074":50538,"_2645":50539},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3146":1830,"_27538":1825,"_19130":50541,"_5":13154,"_26074":1825,"_2645":50542},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3146":1831,"_27538":1825,"_19130":50544,"_5":13154,"_26074":50530,"_2645":50545},[],"Verify these criteria together:",{"_3146":1832,"_27538":1825,"_19130":50547,"_5":13154,"_26074":50530,"_2645":49530},[],{"_3146":1833,"_27538":1825,"_19130":50549,"_5":13154,"_26074":50530,"_2645":50550},[],"Required result",{"_3146":1834,"_27538":1825,"_19130":50552,"_5":13154,"_26074":50530,"_2645":50553},[],"Chain and signature",{"_3146":1835,"_27538":1825,"_19130":50555,"_5":13154,"_26074":50530,"_2645":50556},[],"Valid chain to a root deliberately installed in the consumer.",{"_3146":1836,"_27538":1825,"_19130":50558,"_5":13154,"_26074":50530,"_2645":50559},[],"Dates",{"_3146":1837,"_27538":1825,"_19130":50561,"_5":13154,"_26074":50530,"_2645":50562},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3146":1838,"_27538":1825,"_19130":50564,"_5":13154,"_26074":50530,"_2645":45910},[],{"_3146":1839,"_27538":1825,"_19130":50566,"_5":13154,"_26074":50530,"_2645":50567},[],"Name, SAN or identifier matches the expected peer.",{"_3146":1840,"_27538":1825,"_19130":50569,"_5":13154,"_26074":50530,"_2645":45220},[],{"_3146":1841,"_27538":1825,"_19130":50571,"_5":13154,"_26074":50530,"_2645":50572},[],"KU, EKU and constraints permit the specific operation.",{"_3146":1842,"_27538":1825,"_19130":50574,"_5":13154,"_26074":50530,"_2645":50575},[],"Revocation",{"_3146":1843,"_27538":1825,"_19130":50577,"_5":13154,"_26074":50530,"_2645":50578},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3146":1844,"_27538":1825,"_19130":50580,"_5":13154,"_26074":50530,"_2645":50581},[],"Authorization",{"_3146":1845,"_27538":1825,"_19130":50583,"_5":13154,"_26074":50530,"_2645":50584},[],"The application permits that identity to perform the action.",{"_3146":1846,"_27538":1825,"_19130":50586,"_5":13154,"_26074":50530,"_2645":50587},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3146":1847,"_27538":1825,"_19130":50589,"_5":13154,"_26074":50534,"_2645":50590},[],"Mechanism",{"_3146":1848,"_27538":1825,"_19130":50592,"_5":13154,"_26074":50534,"_2645":50593},[],"When to use it",{"_3146":1849,"_27538":1825,"_19130":50595,"_5":13154,"_26074":50534,"_2645":50596},[],"What you must maintain",{"_3146":1850,"_27538":1825,"_19130":50598,"_5":13154,"_26074":50534,"_2645":50599},[],"OCSP",{"_3146":1851,"_27538":1825,"_19130":50601,"_5":13154,"_26074":50534,"_2645":50602},[],"Status query for a specific certificate.",{"_3146":1852,"_27538":1825,"_19130":50604,"_5":13154,"_26074":50534,"_2645":50605},[],"Responder access, signature verification and cache/freshness policy.",{"_3146":1853,"_27538":1825,"_19130":50607,"_5":13154,"_26074":50534,"_2645":50608},[],"CRL",{"_3146":1854,"_27538":1825,"_19130":50610,"_5":13154,"_26074":50534,"_2645":50611},[],"Local checks for many certificates or offline operation.",{"_3146":1855,"_27538":1825,"_19130":50613,"_5":13154,"_26074":50534,"_2645":50614},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3146":1856,"_27538":1825,"_19130":50616,"_5":13154,"_26074":50534,"_2645":50617},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3146":1857,"_27538":1825,"_19130":50619,"_5":13154,"_26074":50534,"_2645":50620},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3146":1858,"_27538":1825,"_19130":50622,"_5":13154,"_26074":50538,"_2645":50623},[],"Accept a current, authorized certificate with a known chain.",{"_3146":1859,"_27538":1825,"_19130":50625,"_5":13154,"_26074":50538,"_2645":50626},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3146":1860,"_27538":1825,"_19130":50628,"_5":13154,"_26074":50538,"_2645":50629},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3146":1861,"_27538":1825,"_19130":50631,"_5":13154,"_26074":50538,"_2645":50632},[],"Check that a new connection with that identity is rejected.",{"_3146":1862,"_27538":1825,"_19130":50634,"_5":13154,"_26074":50538,"_2645":50635},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3146":1863,"_27538":1825,"_19130":50637,"_5":13154,"_26074":50538,"_2645":50638},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3146":1864,"_27538":1825,"_19130":50640,"_5":13154,"_26074":50538,"_2645":50641},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3146":1865,"_27538":1825,"_19130":50643,"_5":13154,"_26074":50538,"_2645":50644},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3146":1866,"_27538":1825,"_19130":50646,"_5":13154,"_26074":50538,"_2645":50647},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3146":1867,"_27538":1867,"_5":13480,"_2645":50649,"_27881":50650,"_19130":50651,"_26074":1867},"Certificates",[44830,46210,49906,49907],[],{"_3146":1868,"_27538":1867,"_19130":50653,"_5":13154,"_26074":1867,"_2645":50654},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3146":1869,"_27538":1867,"_5":27878,"_19130":50656,"_26074":50657,"_2645":50658},[],"/docs/pr-preview/pr-26/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3146":1870,"_27538":1867,"_5":27878,"_19130":50660,"_26074":50661,"_2645":50662},[],"/docs/pr-preview/pr-26/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3146":1871,"_27538":1867,"_5":27878,"_19130":50664,"_26074":50665,"_2645":50666},[],"/docs/pr-preview/pr-26/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3146":1872,"_27538":1867,"_5":27878,"_19130":50668,"_26074":50669,"_2645":50670},[],"/docs/pr-preview/pr-26/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3146":1873,"_27538":1867,"_5":27878,"_19130":50672,"_26074":50673,"_2645":50674},[],"/docs/pr-preview/pr-26/platform/pki/certificates#open-the-action","Open the action",{"_3146":1874,"_27538":1867,"_5":27878,"_19130":50676,"_26074":50677,"_2645":50678},[],"/docs/pr-preview/pr-26/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3146":1875,"_27538":1867,"_5":27878,"_19130":50680,"_26074":50681,"_2645":50682},[],"/docs/pr-preview/pr-26/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3146":1876,"_27538":1867,"_5":27878,"_19130":50684,"_26074":50685,"_2645":50686},[],"/docs/pr-preview/pr-26/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3146":1877,"_27538":1867,"_5":27878,"_19130":50688,"_26074":50689,"_2645":50690},[],"/docs/pr-preview/pr-26/platform/pki/certificates#continue","Continue",{"_3146":1878,"_27538":1867,"_19130":50692,"_5":13154,"_26074":1867,"_2645":50693},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3146":1879,"_27538":1867,"_19130":50695,"_5":13154,"_26074":50657,"_2645":50696},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3146":1880,"_27538":1867,"_19130":50698,"_5":13154,"_26074":50657,"_2645":50699},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3146":1881,"_27538":1867,"_19130":50701,"_5":13154,"_26074":50661,"_2645":50702},[],"Download the PEM and inspect it:",{"_3146":1882,"_27538":1867,"_19130":50704,"_5":13154,"_26074":50661,"_2645":50705},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3146":1883,"_27538":1867,"_19130":50707,"_5":13154,"_26074":50665,"_2645":50708},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3146":1884,"_27538":1867,"_19130":50710,"_5":13154,"_26074":50665,"_2645":50711},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3146":1885,"_27538":1867,"_19130":50713,"_5":13154,"_26074":50665,"_2645":50714},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3146":1886,"_27538":1867,"_19130":50716,"_5":13154,"_26074":50665,"_2645":50717},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3146":1887,"_27538":1867,"_19130":50719,"_5":13154,"_26074":50665,"_2645":50720},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3146":1888,"_27538":1867,"_19130":50722,"_5":13154,"_26074":50665,"_2645":50723},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3146":1889,"_27538":1867,"_19130":50725,"_5":13154,"_26074":50665,"_2645":50726},[],"For browser key generation, follow Issue your first certificate.",{"_3146":1890,"_27538":1867,"_19130":50728,"_5":13154,"_26074":50669,"_2645":50729},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3146":1891,"_27538":1867,"_19130":50731,"_5":13154,"_26074":50673,"_2645":50732},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3146":1892,"_27538":1867,"_19130":50734,"_5":13154,"_26074":50677,"_2645":50735},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3146":1893,"_27538":1867,"_19130":50737,"_5":13154,"_26074":50681,"_2645":50738},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3146":1894,"_27538":1867,"_19130":50740,"_5":13154,"_26074":50681,"_2645":50741},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3146":1895,"_27538":1867,"_19130":50743,"_5":13154,"_26074":50681,"_2645":50744},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3146":1896,"_27538":1867,"_19130":50746,"_5":13154,"_26074":50685,"_2645":50747},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3146":1897,"_27538":1867,"_19130":50749,"_5":13154,"_26074":50685,"_2645":50750},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3146":1898,"_27538":1867,"_19130":50752,"_5":13154,"_26074":50685,"_2645":50753},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3146":1899,"_27538":1867,"_19130":50755,"_5":13154,"_26074":50689,"_2645":50756},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3146":1900,"_27538":1867,"_19130":50758,"_5":13154,"_26074":50689,"_2645":50759},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3146":1901,"_27538":1901,"_5":13480,"_2645":50761,"_27881":50762,"_19130":50764,"_26074":1901},"Certificate lifecycle",[44830,46210,49906,50763],"Concepts",[],{"_3146":1902,"_27538":1901,"_19130":50766,"_5":13154,"_26074":1901,"_2645":50767},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3146":1903,"_27538":1901,"_5":27878,"_19130":50769,"_26074":50770,"_2645":50771},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3146":1904,"_27538":1901,"_5":27878,"_19130":50773,"_26074":50774,"_2645":50775},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3146":1905,"_27538":1901,"_5":27878,"_19130":50777,"_26074":50778,"_2645":50779},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3146":1906,"_27538":1901,"_5":27878,"_19130":50781,"_26074":50782,"_2645":50783},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3146":1907,"_27538":1901,"_5":27878,"_19130":50785,"_26074":50786,"_2645":50787},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3146":1908,"_27538":1901,"_5":27878,"_19130":50789,"_26074":50790,"_2645":50791},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3146":1909,"_27538":1901,"_5":27878,"_19130":50793,"_26074":50794,"_2645":50795},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3146":1910,"_27538":1901,"_5":27878,"_19130":50797,"_26074":50798,"_2645":50799},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3146":1911,"_27538":1901,"_5":27878,"_19130":50801,"_26074":50802,"_2645":50803},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3146":1912,"_27538":1901,"_5":27878,"_19130":50805,"_26074":50806,"_2645":50807},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3146":1913,"_27538":1901,"_19130":50809,"_5":13154,"_26074":1901,"_2645":50810},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3146":1914,"_27538":1901,"_19130":50812,"_5":13154,"_26074":50774,"_2645":50813},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3146":1915,"_27538":1901,"_19130":50815,"_5":13154,"_26074":50778,"_2645":50816},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3146":1916,"_27538":1901,"_19130":50818,"_5":13154,"_26074":50782,"_2645":50819},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3146":1917,"_27538":1901,"_19130":50821,"_5":13154,"_26074":50786,"_2645":50822},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3146":1918,"_27538":1901,"_19130":50824,"_5":13154,"_26074":50790,"_2645":50825},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3146":1919,"_27538":1901,"_19130":50827,"_5":13154,"_26074":50794,"_2645":50828},[],"Lamassu persists four X.509 states:",{"_3146":1920,"_27538":1901,"_19130":50830,"_5":13154,"_26074":50794,"_2645":50831},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3146":1921,"_27538":1901,"_19130":50833,"_5":13154,"_26074":50794,"_2645":50834},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3146":1922,"_27538":1901,"_19130":50836,"_5":13154,"_26074":50794,"_2645":50837},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3146":1923,"_27538":1901,"_19130":50839,"_5":13154,"_26074":50794,"_2645":50840},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3146":1924,"_27538":1901,"_19130":50842,"_5":13154,"_26074":50794,"_2645":50843},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3146":1925,"_27538":1901,"_19130":50845,"_5":13154,"_26074":50798,"_2645":50846},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3146":1926,"_27538":1901,"_19130":50848,"_5":13154,"_26074":50798,"_2645":50849},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3146":1927,"_27538":1901,"_19130":50851,"_5":13154,"_26074":50798,"_2645":50852},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3146":1928,"_27538":1901,"_19130":50854,"_5":13154,"_26074":50802,"_2645":50855},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3146":1929,"_27538":1901,"_19130":50857,"_5":13154,"_26074":50802,"_2645":50858},[],"Before confirming:",{"_3146":1930,"_27538":1901,"_19130":50860,"_5":13154,"_26074":50802,"_2645":50861},[],"Identify DMSs, devices and services that trust that chain.",{"_3146":1931,"_27538":1901,"_19130":50863,"_5":13154,"_26074":50802,"_2645":50864},[],"Distribute the new chain of trust.",{"_3146":1932,"_27538":1901,"_19130":50866,"_5":13154,"_26074":50802,"_2645":50867},[],"Reissue the necessary identities.",{"_3146":1933,"_27538":1901,"_19130":50869,"_5":13154,"_26074":50802,"_2645":50870},[],"Check OCSP and CRL from a real consumer.",{"_3146":1934,"_27538":1901,"_19130":50872,"_5":13154,"_26074":50802,"_2645":50873},[],"Revoke the old CA once no legitimate traffic remains.",{"_3146":1935,"_27538":1901,"_19130":50875,"_5":13154,"_26074":50802,"_2645":50876},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3146":1936,"_27538":1901,"_19130":50878,"_5":13154,"_26074":50806,"_2645":50879},[],"Certificates entering the preventive or critical renewal window.",{"_3146":1937,"_27538":1901,"_19130":50881,"_5":13154,"_26074":50806,"_2645":50882},[],"Repeated enrollment or re-enrollment failures.",{"_3146":1938,"_27538":1901,"_19130":50884,"_5":13154,"_26074":50806,"_2645":50885},[],"Status changes and revocation reasons.",{"_3146":1939,"_27538":1901,"_19130":50887,"_5":13154,"_26074":50806,"_2645":50888},[],"OCSP and CRL publication and validity.",{"_3146":1940,"_27538":1901,"_19130":50890,"_5":13154,"_26074":50806,"_2645":50891},[],"Dependencies still presenting a replaced certificate.",{"_3146":1941,"_27538":1901,"_19130":50893,"_5":13154,"_26074":50806,"_2645":50894},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3146":1942,"_27538":1942,"_5":13480,"_2645":50896,"_27881":50897,"_19130":50898,"_26074":1942},"Trust model",[44830,46210,49906,50763],[],{"_3146":1943,"_27538":1942,"_19130":50900,"_5":13154,"_26074":1942,"_2645":50901},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3146":1944,"_27538":1942,"_5":27878,"_19130":50903,"_26074":50904,"_2645":50905},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3146":1945,"_27538":1942,"_5":27878,"_19130":50907,"_26074":50908,"_2645":50909},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3146":1946,"_27538":1942,"_5":27878,"_19130":50911,"_26074":50912,"_2645":50913},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3146":1947,"_27538":1942,"_5":27878,"_19130":50915,"_26074":50916,"_2645":50917},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3146":1948,"_27538":1942,"_5":27878,"_19130":50919,"_26074":50920,"_2645":50921},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3146":1949,"_27538":1942,"_5":27878,"_19130":50923,"_26074":50924,"_2645":50925},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3146":1950,"_27538":1942,"_5":27878,"_19130":50927,"_26074":50928,"_2645":50929},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3146":1951,"_27538":1942,"_5":27878,"_19130":50931,"_26074":50932,"_2645":50933},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3146":1952,"_27538":1942,"_5":27878,"_19130":50935,"_26074":50936,"_2645":50937},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3146":1953,"_27538":1942,"_5":27878,"_19130":50939,"_26074":50940,"_2645":50941},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3146":1954,"_27538":1942,"_19130":50943,"_5":13154,"_26074":1942,"_2645":50944},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3146":1955,"_27538":1942,"_19130":50946,"_5":13154,"_26074":50908,"_2645":50947},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3146":1956,"_27538":1942,"_19130":50949,"_5":13154,"_26074":50912,"_2645":50950},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3146":1957,"_27538":1942,"_19130":50952,"_5":13154,"_26074":50916,"_2645":50953},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3146":1958,"_27538":1942,"_19130":50955,"_5":13154,"_26074":50920,"_2645":50956},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3146":1959,"_27538":1942,"_19130":50958,"_5":13154,"_26074":50924,"_2645":50959},[],"The device proves it can enroll according to the DMS policy.",{"_3146":1960,"_27538":1942,"_19130":50961,"_5":13154,"_26074":50924,"_2645":50962},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3146":1961,"_27538":1942,"_19130":50964,"_5":13154,"_26074":50924,"_2645":50965},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3146":1962,"_27538":1942,"_19130":50967,"_5":13154,"_26074":50924,"_2645":50968},[],"The device installs the certificate and the chain it needs.",{"_3146":1963,"_27538":1942,"_19130":50970,"_5":13154,"_26074":50924,"_2645":50971},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3146":1964,"_27538":1942,"_19130":50973,"_5":13154,"_26074":50924,"_2645":50974},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3146":1965,"_27538":1942,"_19130":50976,"_5":13154,"_26074":50928,"_2645":50977},[],"A DMS relates three sets that are worth designing separately:",{"_3146":1966,"_27538":1942,"_19130":50979,"_5":13154,"_26074":50928,"_2645":50980},[],"**Enrollment CA:** signs the new identities.",{"_3146":1967,"_27538":1942,"_19130":50982,"_5":13154,"_26074":50928,"_2645":50983},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_3146":1968,"_27538":1942,"_19130":50985,"_5":13154,"_26074":50928,"_2645":50986},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3146":1969,"_27538":1942,"_19130":50988,"_5":13154,"_26074":50928,"_2645":50989},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3146":1970,"_27538":1942,"_19130":50991,"_5":13154,"_26074":50932,"_2645":50992},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3146":1971,"_27538":1942,"_19130":50994,"_5":13154,"_26074":50932,"_2645":50995},[],"that the current date is between `Not Before` and `Not After`;",{"_3146":1972,"_27538":1942,"_19130":50997,"_5":13154,"_26074":50932,"_2645":50998},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3146":1973,"_27538":1942,"_19130":51000,"_5":13154,"_26074":50932,"_2645":51001},[],"that names, SANs and subject match the expected identity;",{"_3146":1974,"_27538":1942,"_19130":51003,"_5":13154,"_26074":50932,"_2645":51004},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3146":1975,"_27538":1942,"_19130":51006,"_5":13154,"_26074":50932,"_2645":51007},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3146":1976,"_27538":1942,"_19130":51009,"_5":13154,"_26074":50932,"_2645":51010},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3146":1977,"_27538":1942,"_19130":51012,"_5":13154,"_26074":50936,"_2645":51013},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3146":1978,"_27538":1942,"_19130":51015,"_5":13154,"_26074":50940,"_2645":51016},[],"Keep the root out of daily operations, or with very restricted access.",{"_3146":1979,"_27538":1942,"_19130":51018,"_5":13154,"_26074":50940,"_2645":51019},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3146":1980,"_27538":1942,"_19130":51021,"_5":13154,"_26074":50940,"_2645":51022},[],"Assign explicit profiles to every use case.",{"_3146":1981,"_27538":1942,"_19130":51024,"_5":13154,"_26074":50940,"_2645":51025},[],"Distribute the new trust before starting a rotation.",{"_3146":1982,"_27538":1942,"_19130":51027,"_5":13154,"_26074":50940,"_2645":51028},[],"Keep enough overlap to renew a disconnected fleet.",{"_3146":1983,"_27538":1942,"_19130":51030,"_5":13154,"_26074":50940,"_2645":51031},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3146":1984,"_27538":1942,"_19130":51033,"_5":13154,"_26074":50940,"_2645":51034},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3146":1985,"_27538":1985,"_5":13480,"_2645":51036,"_27881":51037,"_19130":51038,"_26074":1985},"Revocation lists (CRL)",[44830,46210,49906,50523],[],{"_3146":1986,"_27538":1985,"_19130":51040,"_5":13154,"_26074":1985,"_2645":51041},[],"Generate and distribute signed lists to validate certificates offline.",{"_3146":1987,"_27538":1985,"_5":27878,"_19130":51043,"_26074":51044,"_2645":51045},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3146":1988,"_27538":1985,"_5":27878,"_19130":51047,"_26074":51048,"_2645":51049},[],"/docs/pr-preview/pr-26/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3146":1989,"_27538":1985,"_5":27878,"_19130":51051,"_26074":51052,"_2645":51053},[],"/docs/pr-preview/pr-26/platform/pki/crl#crl-contents","CRL contents",{"_3146":1990,"_27538":1985,"_5":27878,"_19130":51055,"_26074":51056,"_2645":51057},[],"/docs/pr-preview/pr-26/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3146":1991,"_27538":1985,"_5":27878,"_19130":51059,"_26074":51060,"_2645":51061},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-management-api","VA role management API",{"_3146":1992,"_27538":1985,"_5":27878,"_19130":51063,"_26074":51064,"_2645":51065},[],"/docs/pr-preview/pr-26/platform/pki/crl#from-the-interface","From the interface",{"_3146":1993,"_27538":1985,"_5":27878,"_19130":51067,"_26074":51068,"_2645":51069},[],"/docs/pr-preview/pr-26/platform/pki/crl#references","References",{"_3146":1994,"_27538":1985,"_19130":51071,"_5":13154,"_26074":1985,"_2645":51072},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3146":1995,"_27538":1985,"_19130":51074,"_5":13154,"_26074":51044,"_2645":51075},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3146":1996,"_27538":1985,"_19130":51077,"_5":13154,"_26074":51044,"_2645":51078},[],"`crl_options` field",{"_3146":1997,"_27538":1985,"_19130":51080,"_5":13154,"_26074":51044,"_2645":45220},[],{"_3146":1998,"_27538":1985,"_19130":51082,"_5":13154,"_26074":51044,"_2645":51083},[],"Backend initial value",{"_3146":1999,"_27538":1985,"_19130":51085,"_5":13154,"_26074":51044,"_2645":51086},[],"`validity`",{"_3146":2000,"_27538":1985,"_19130":51088,"_5":13154,"_26074":51044,"_2645":51089},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3146":2001,"_27538":1985,"_19130":51091,"_5":13154,"_26074":51044,"_2645":51092},[],"7 days.",{"_3146":2002,"_27538":1985,"_19130":51094,"_5":13154,"_26074":51044,"_2645":51095},[],"`refresh_interval`",{"_3146":2003,"_27538":1985,"_19130":51097,"_5":13154,"_26074":51044,"_2645":51098},[],"Time since publication that triggers scheduled renewal.",{"_3146":2004,"_27538":1985,"_19130":51100,"_5":13154,"_26074":51044,"_2645":51101},[],"6 days and 23 hours.",{"_3146":2005,"_27538":1985,"_19130":51103,"_5":13154,"_26074":51044,"_2645":51104},[],"`regenerate_on_revoke`",{"_3146":2006,"_27538":1985,"_19130":51106,"_5":13154,"_26074":51044,"_2645":51107},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3146":2007,"_27538":1985,"_19130":51109,"_5":13154,"_26074":51044,"_2645":51110},[],"`true`.",{"_3146":2008,"_27538":1985,"_19130":51112,"_5":13154,"_26074":51044,"_2645":51113},[],"`subject_key_id_signer`",{"_3146":2009,"_27538":1985,"_19130":51115,"_5":13154,"_26074":51044,"_2645":51116},[],"Configuration field initialized with the CA’s SKI.",{"_3146":2010,"_27538":1985,"_19130":51118,"_5":13154,"_26074":51044,"_2645":51119},[],"CA SKI.",{"_3146":2011,"_27538":1985,"_19130":51121,"_5":13154,"_26074":51044,"_2645":51122},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3146":2012,"_27538":1985,"_19130":51124,"_5":13154,"_26074":51044,"_2645":51125},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3146":2013,"_27538":1985,"_19130":51127,"_5":13154,"_26074":51048,"_2645":51128},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3146":2014,"_27538":1985,"_19130":51130,"_5":13154,"_26074":51048,"_2645":51131},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3146":2015,"_27538":1985,"_19130":51133,"_5":13154,"_26074":51048,"_2645":51134},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3146":2016,"_27538":1985,"_19130":51136,"_5":13154,"_26074":51052,"_2645":51137},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3146":2017,"_27538":1985,"_19130":51139,"_5":13154,"_26074":51052,"_2645":51140},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3146":2018,"_27538":1985,"_19130":51142,"_5":13154,"_26074":51056,"_2645":51143},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3146":2019,"_27538":1985,"_19130":51145,"_5":13154,"_26074":51056,"_2645":51146},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3146":2020,"_27538":1985,"_19130":51148,"_5":13154,"_26074":51056,"_2645":51149},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3146":2021,"_27538":1985,"_19130":51151,"_5":13154,"_26074":51056,"_2645":51152},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3146":2022,"_27538":1985,"_19130":51154,"_5":13154,"_26074":51056,"_2645":51155},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3146":2023,"_27538":1985,"_19130":51157,"_5":13154,"_26074":51060,"_2645":51158},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3146":2024,"_27538":1985,"_19130":51160,"_5":13154,"_26074":51060,"_2645":47937},[],{"_3146":2025,"_27538":1985,"_19130":51162,"_5":13154,"_26074":51060,"_2645":51163},[],"Relative path",{"_3146":2026,"_27538":1985,"_19130":51165,"_5":13154,"_26074":51060,"_2645":47934},[],{"_3146":2027,"_27538":1985,"_19130":51167,"_5":13154,"_26074":51060,"_2645":51168},[],"`GET`",{"_3146":2028,"_27538":1985,"_19130":51170,"_5":13154,"_26074":51060,"_2645":51171},[],"`/v1/roles/{ca-ski}`",{"_3146":2029,"_27538":1985,"_19130":51173,"_5":13154,"_26074":51060,"_2645":51174},[],"Read `crl_options` and `latest_crl`.",{"_3146":2030,"_27538":1985,"_19130":51176,"_5":13154,"_26074":51060,"_2645":51177},[],"`PUT`",{"_3146":2031,"_27538":1985,"_19130":51179,"_5":13154,"_26074":51060,"_2645":51171},[],{"_3146":2032,"_27538":1985,"_19130":51181,"_5":13154,"_26074":51060,"_2645":51182},[],"Replace CRL configuration.",{"_3146":2033,"_27538":1985,"_19130":51184,"_5":13154,"_26074":51060,"_2645":51185},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3146":2034,"_27538":1985,"_19130":51187,"_5":13154,"_26074":51060,"_2645":51188},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3146":2035,"_27538":1985,"_19130":51190,"_5":13154,"_26074":51064,"_2645":51191},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3146":2036,"_27538":1985,"_19130":51193,"_5":13154,"_26074":51068,"_2645":51194},[],"RFC 5280: X.509 and CRL profile.",{"_3146":2037,"_27538":1985,"_19130":51196,"_5":13154,"_26074":51068,"_2645":51197},[],"OpenSSL: openssl-crl.",{"_3146":2038,"_27538":1985,"_19130":51199,"_5":13154,"_26074":51068,"_2645":51200},[],"OpenSSL: openssl-verify.",{"_3146":2039,"_27538":1985,"_19130":51202,"_5":13154,"_26074":51068,"_2645":51203},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3146":2040,"_27538":1985,"_19130":51205,"_5":13154,"_26074":51068,"_2645":51206},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3146":2041,"_27538":2041,"_5":13480,"_2645":51208,"_27881":51209,"_19130":51210,"_26074":2041},"Keys and cryptographic engines",[44830,46210,49906,49907],[],{"_3146":2042,"_27538":2041,"_19130":51212,"_5":13154,"_26074":2041,"_2645":51213},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3146":2043,"_27538":2041,"_5":27878,"_19130":51215,"_26074":51216,"_2645":51217},[],"/docs/pr-preview/pr-26/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3146":2044,"_27538":2041,"_5":27878,"_19130":51219,"_26074":51220,"_2645":51221},[],"/docs/pr-preview/pr-26/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3146":2045,"_27538":2041,"_5":27878,"_19130":51223,"_26074":51224,"_2645":51225},[],"/docs/pr-preview/pr-26/platform/pki/key-management#file-system","File System",{"_3146":2046,"_27538":2041,"_5":27878,"_19130":51227,"_26074":51228,"_2645":51229},[],"/docs/pr-preview/pr-26/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3146":2047,"_27538":2041,"_5":27878,"_19130":51231,"_26074":51232,"_2645":51233},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3146":2048,"_27538":2041,"_5":27878,"_19130":51235,"_26074":51236,"_2645":51237},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-kms","AWS KMS",{"_3146":2049,"_27538":2041,"_5":27878,"_19130":51239,"_26074":51240,"_2645":51241},[],"/docs/pr-preview/pr-26/platform/pki/key-management#pkcs11","PKCS#11",{"_3146":2050,"_27538":2041,"_5":27878,"_19130":51243,"_26074":51244,"_2645":51245},[],"/docs/pr-preview/pr-26/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3146":2051,"_27538":2041,"_5":27878,"_19130":51247,"_26074":51248,"_2645":51249},[],"/docs/pr-preview/pr-26/platform/pki/key-management#key-inventory","Key inventory",{"_3146":2052,"_27538":2041,"_5":27878,"_19130":51251,"_26074":51252,"_2645":51253},[],"/docs/pr-preview/pr-26/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3146":2053,"_27538":2041,"_5":27878,"_19130":51255,"_26074":51256,"_2645":51257},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3146":2054,"_27538":2041,"_5":27878,"_19130":51259,"_26074":51260,"_2645":51261},[],"/docs/pr-preview/pr-26/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3146":2055,"_27538":2041,"_5":27878,"_19130":51263,"_26074":51264,"_2645":51265},[],"/docs/pr-preview/pr-26/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3146":2056,"_27538":2041,"_5":27878,"_19130":51267,"_26074":51268,"_2645":51269},[],"/docs/pr-preview/pr-26/platform/pki/key-management#view-details","View details",{"_3146":2057,"_27538":2041,"_5":27878,"_19130":51271,"_26074":51272,"_2645":51273},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3146":2058,"_27538":2041,"_5":27878,"_19130":51275,"_26074":51276,"_2645":51277},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign","Sign",{"_3146":2059,"_27538":2041,"_5":27878,"_19130":51279,"_26074":51280,"_2645":51281},[],"/docs/pr-preview/pr-26/platform/pki/key-management#verify","Verify",{"_3146":2060,"_27538":2041,"_5":27878,"_19130":51283,"_26074":51284,"_2645":51285},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3146":2061,"_27538":2041,"_5":27878,"_19130":51287,"_26074":51288,"_2645":51289},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3146":2062,"_27538":2041,"_5":27878,"_19130":51291,"_26074":51292,"_2645":51293},[],"/docs/pr-preview/pr-26/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3146":2063,"_27538":2041,"_19130":51295,"_5":13154,"_26074":2041,"_2645":51296},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3146":2064,"_27538":2041,"_19130":51298,"_5":13154,"_26074":2041,"_2645":51299},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3146":2065,"_27538":2041,"_19130":51301,"_5":13154,"_26074":51216,"_2645":51302},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3146":2066,"_27538":2041,"_19130":51304,"_5":13154,"_26074":51216,"_2645":51305},[],"In practice, it lets you:",{"_3146":2067,"_27538":2041,"_19130":51307,"_5":13154,"_26074":51216,"_2645":51308},[],"Generate new key pairs from Lamassu IoT.",{"_3146":2068,"_27538":2041,"_19130":51310,"_5":13154,"_26074":51216,"_2645":51311},[],"Import keys created externally.",{"_3146":2069,"_27538":2041,"_19130":51313,"_5":13154,"_26074":51216,"_2645":51314},[],"Delegate custody and cryptographic operations to external engines.",{"_3146":2070,"_27538":2041,"_19130":51316,"_5":13154,"_26074":51216,"_2645":51317},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3146":2071,"_27538":2041,"_19130":51319,"_5":13154,"_26074":51220,"_2645":51320},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3146":2072,"_27538":2041,"_19130":51322,"_5":13154,"_26074":51220,"_2645":51323},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3146":2073,"_27538":2041,"_19130":51325,"_5":13154,"_26074":51220,"_2645":51326},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3146":2074,"_27538":2041,"_19130":51328,"_5":13154,"_26074":51224,"_2645":51329},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3146":2075,"_27538":2041,"_19130":51331,"_5":13154,"_26074":51228,"_2645":51332},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3146":2076,"_27538":2041,"_19130":51334,"_5":13154,"_26074":51232,"_2645":51335},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3146":2077,"_27538":2041,"_19130":51337,"_5":13154,"_26074":51236,"_2645":51338},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3146":2078,"_27538":2041,"_19130":51340,"_5":13154,"_26074":51240,"_2645":51341},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3146":2079,"_27538":2041,"_19130":51343,"_5":13154,"_26074":51244,"_2645":51344},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3146":2080,"_27538":2041,"_19130":51346,"_5":13154,"_26074":51244,"_2645":51347},[],"Lamassu shows the enabled engines in the console.",{"_3146":2081,"_27538":2041,"_19130":51349,"_5":13154,"_26074":51244,"_2645":51350},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3146":2082,"_27538":2041,"_19130":51352,"_5":13154,"_26074":51244,"_2645":51353},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3146":2083,"_27538":2041,"_19130":51355,"_5":13154,"_26074":51248,"_2645":51356},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3146":2084,"_27538":2041,"_19130":51358,"_5":13154,"_26074":51248,"_2645":51359},[],"The table includes the following fields:",{"_3146":2085,"_27538":2041,"_19130":51361,"_5":13154,"_26074":51248,"_2645":51362},[],"**Name**: descriptive name of the key.",{"_3146":2086,"_27538":2041,"_19130":51364,"_5":13154,"_26074":51248,"_2645":51365},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3146":2087,"_27538":2041,"_19130":51367,"_5":13154,"_26074":51248,"_2645":51368},[],"**Strength**: visual indicator of cryptographic strength.",{"_3146":2088,"_27538":2041,"_19130":51370,"_5":13154,"_26074":51248,"_2645":51371},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3146":2089,"_27538":2041,"_19130":51373,"_5":13154,"_26074":51248,"_2645":51374},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3146":2090,"_27538":2041,"_19130":51376,"_5":13154,"_26074":51248,"_2645":51377},[],"**Aliases**: alternative names associated with the key.",{"_3146":2091,"_27538":2041,"_19130":51379,"_5":13154,"_26074":51248,"_2645":51380},[],"**Tags**: labels for classification and search.",{"_3146":2092,"_27538":2041,"_19130":51382,"_5":13154,"_26074":51248,"_2645":51383},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3146":2093,"_27538":2041,"_19130":51385,"_5":13154,"_26074":51248,"_2645":51386},[],"From this view you also reach the most common actions:",{"_3146":2094,"_27538":2041,"_19130":51388,"_5":13154,"_26074":51248,"_2645":51389},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3146":2095,"_27538":2041,"_19130":51391,"_5":13154,"_26074":51248,"_2645":51392},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3146":2096,"_27538":2041,"_19130":51394,"_5":13154,"_26074":51248,"_2645":51395},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3146":2097,"_27538":2041,"_19130":51397,"_5":13154,"_26074":51248,"_2645":51398},[],"**Delete Key** to remove the key from the system.",{"_3146":2098,"_27538":2041,"_19130":51400,"_5":13154,"_26074":51252,"_2645":51401},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3146":2099,"_27538":2041,"_19130":51403,"_5":13154,"_26074":51256,"_2645":51404},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3146":2100,"_27538":2041,"_19130":51406,"_5":13154,"_26074":51256,"_2645":51407},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3146":2101,"_27538":2041,"_19130":51409,"_5":13154,"_26074":51256,"_2645":51410},[],"**Key Name**: unique and descriptive name.",{"_3146":2102,"_27538":2041,"_19130":51412,"_5":13154,"_26074":51256,"_2645":51413},[],"**Crypto Engine**: engine that will keep the key.",{"_3146":2103,"_27538":2041,"_19130":51415,"_5":13154,"_26074":51256,"_2645":51416},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3146":2104,"_27538":2041,"_19130":51418,"_5":13154,"_26074":51256,"_2645":51419},[],"**Tags**: metadata to classify the key.",{"_3146":2105,"_27538":2041,"_19130":51421,"_5":13154,"_26074":51256,"_2645":51422},[],"**Metadata**: additional information for advanced uses.",{"_3146":2106,"_27538":2041,"_19130":51424,"_5":13154,"_26074":51260,"_2645":51425},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3146":2107,"_27538":2041,"_19130":51427,"_5":13154,"_26074":51260,"_2645":51428},[],"When you have an exportable private key and the destination engine supports import.",{"_3146":2108,"_27538":2041,"_19130":51430,"_5":13154,"_26074":51260,"_2645":51431},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3146":2109,"_27538":2041,"_19130":51433,"_5":13154,"_26074":51260,"_2645":51434},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3146":2110,"_27538":2041,"_19130":51436,"_5":13154,"_26074":51260,"_2645":51437},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3146":2111,"_27538":2041,"_19130":51439,"_5":13154,"_26074":51260,"_2645":51440},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3146":2112,"_27538":2041,"_19130":51442,"_5":13154,"_26074":51260,"_2645":51443},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3146":2113,"_27538":2041,"_19130":51445,"_5":13154,"_26074":51260,"_2645":51446},[],"**Tags**: labels for organization and search.",{"_3146":2114,"_27538":2041,"_19130":51448,"_5":13154,"_26074":51260,"_2645":51449},[],"**Metadata**: additional optional information.",{"_3146":2115,"_27538":2041,"_19130":51451,"_5":13154,"_26074":51260,"_2645":51452},[],"**Private Key (PEM)**: private key in PEM format.",{"_3146":2116,"_27538":2041,"_19130":51454,"_5":13154,"_26074":51260,"_2645":51455},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3146":2117,"_27538":2041,"_19130":51457,"_5":13154,"_26074":51264,"_2645":51458},[],"Each registered key has a detail view and several operational actions.",{"_3146":2118,"_27538":2041,"_19130":51460,"_5":13154,"_26074":51268,"_2645":51461},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3146":2119,"_27538":2041,"_19130":51463,"_5":13154,"_26074":51268,"_2645":51464},[],"The **Overview** tab shows, among others, these fields:",{"_3146":2120,"_27538":2041,"_19130":51466,"_5":13154,"_26074":51268,"_2645":51467},[],"**Key Name**: descriptive name.",{"_3146":2121,"_27538":2041,"_19130":51469,"_5":13154,"_26074":51268,"_2645":51470},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3146":2122,"_27538":2041,"_19130":51472,"_5":13154,"_26074":51268,"_2645":51473},[],"**Tags**: associated labels.",{"_3146":2123,"_27538":2041,"_19130":51475,"_5":13154,"_26074":51268,"_2645":51476},[],"**Aliases**: alternative names.",{"_3146":2124,"_27538":2041,"_19130":51478,"_5":13154,"_26074":51268,"_2645":51479},[],"**Crypto Engine**: engine where the key resides.",{"_3146":2125,"_27538":2041,"_19130":51481,"_5":13154,"_26074":51268,"_2645":51482},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3146":2126,"_27538":2041,"_19130":51484,"_5":13154,"_26074":51268,"_2645":51485},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3146":2127,"_27538":2041,"_19130":51487,"_5":13154,"_26074":51268,"_2645":51488},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3146":2128,"_27538":2041,"_19130":51490,"_5":13154,"_26074":51272,"_2645":51491},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3146":2129,"_27538":2041,"_19130":51493,"_5":13154,"_26074":51272,"_2645":51494},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3146":2130,"_27538":2041,"_19130":51496,"_5":13154,"_26074":51272,"_2645":51497},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3146":2131,"_27538":2041,"_19130":51499,"_5":13154,"_26074":51276,"_2645":51500},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3146":2132,"_27538":2041,"_19130":51502,"_5":13154,"_26074":51276,"_2645":51503},[],"Main fields:",{"_3146":2133,"_27538":2041,"_19130":51505,"_5":13154,"_26074":51276,"_2645":51506},[],"**Algorithm**: signing algorithm available for the key type.",{"_3146":2134,"_27538":2041,"_19130":51508,"_5":13154,"_26074":51276,"_2645":51509},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3146":2135,"_27538":2041,"_19130":51511,"_5":13154,"_26074":51276,"_2645":51512},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3146":2136,"_27538":2041,"_19130":51514,"_5":13154,"_26074":51276,"_2645":51515},[],"**Message**: content to sign.",{"_3146":2137,"_27538":2041,"_19130":51517,"_5":13154,"_26074":51276,"_2645":51518},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3146":2138,"_27538":2041,"_19130":51520,"_5":13154,"_26074":51280,"_2645":51521},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3146":2139,"_27538":2041,"_19130":51523,"_5":13154,"_26074":51280,"_2645":51503},[],{"_3146":2140,"_27538":2041,"_19130":51525,"_5":13154,"_26074":51280,"_2645":51526},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3146":2141,"_27538":2041,"_19130":51528,"_5":13154,"_26074":51280,"_2645":51529},[],"**Message Type**: `Raw` or `Digest`.",{"_3146":2142,"_27538":2041,"_19130":51531,"_5":13154,"_26074":51280,"_2645":51532},[],"**Payload Encoding**: encoding of the message.",{"_3146":2143,"_27538":2041,"_19130":51534,"_5":13154,"_26074":51280,"_2645":51535},[],"**Message**: original message or hash.",{"_3146":2144,"_27538":2041,"_19130":51537,"_5":13154,"_26074":51280,"_2645":51538},[],"**Signature**: signature to check.",{"_3146":2145,"_27538":2041,"_19130":51540,"_5":13154,"_26074":51280,"_2645":51541},[],"**Result**: indicator of the validation result.",{"_3146":2146,"_27538":2041,"_19130":51543,"_5":13154,"_26074":51284,"_2645":51544},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3146":2147,"_27538":2041,"_19130":51546,"_5":13154,"_26074":51284,"_2645":51547},[],"This flow is useful for:",{"_3146":2148,"_27538":2041,"_19130":51549,"_5":13154,"_26074":51284,"_2645":51550},[],"Requesting certificates from an external CA.",{"_3146":2149,"_27538":2041,"_19130":51552,"_5":13154,"_26074":51284,"_2645":51553},[],"Renewing an identity while keeping the same key.",{"_3146":2150,"_27538":2041,"_19130":51555,"_5":13154,"_26074":51284,"_2645":51556},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3146":2151,"_27538":2041,"_19130":51558,"_5":13154,"_26074":51284,"_2645":51559},[],"**Common Name (CN)**: main name of the identity.",{"_3146":2152,"_27538":2041,"_19130":51561,"_5":13154,"_26074":51284,"_2645":51562},[],"**Organization (O)**: organization or company.",{"_3146":2153,"_27538":2041,"_19130":51564,"_5":13154,"_26074":51284,"_2645":51565},[],"**Organizational Unit (OU)**: department or unit.",{"_3146":2154,"_27538":2041,"_19130":51567,"_5":13154,"_26074":51284,"_2645":51568},[],"**Country (C)**: two-letter country code.",{"_3146":2155,"_27538":2041,"_19130":51570,"_5":13154,"_26074":51284,"_2645":51571},[],"**State / Province (ST)**: state or province.",{"_3146":2156,"_27538":2041,"_19130":51573,"_5":13154,"_26074":51284,"_2645":51574},[],"**Locality (L)**: city or locality.",{"_3146":2157,"_27538":2041,"_19130":51576,"_5":13154,"_26074":51284,"_2645":51577},[],"**Email Address**: contact email.",{"_3146":2158,"_27538":2041,"_19130":51579,"_5":13154,"_26074":51284,"_2645":51580},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3146":2159,"_27538":2041,"_19130":51582,"_5":13154,"_26074":51284,"_2645":51583},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3146":2160,"_27538":2041,"_19130":51585,"_5":13154,"_26074":51288,"_2645":51586},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3146":2161,"_27538":2041,"_19130":51588,"_5":13154,"_26074":51288,"_2645":51589},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3146":2162,"_27538":2041,"_19130":51591,"_5":13154,"_26074":51292,"_2645":51592},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3146":2163,"_27538":2163,"_5":13480,"_2645":51594,"_27881":51595,"_19130":51596,"_26074":2163},"Online validation with OCSP",[44830,46210,49906,50523],[],{"_3146":2164,"_27538":2163,"_19130":51598,"_5":13154,"_26074":2163,"_2645":51599},[],"Query signed status and verify the responder’s response.",{"_3146":2165,"_27538":2163,"_5":27878,"_19130":51601,"_26074":51602,"_2645":51603},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3146":2166,"_27538":2163,"_5":27878,"_19130":51605,"_26074":51606,"_2645":51607},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3146":2167,"_27538":2163,"_5":27878,"_19130":51609,"_26074":51610,"_2645":51611},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3146":2168,"_27538":2163,"_5":27878,"_19130":51613,"_26074":51614,"_2645":51615},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3146":2169,"_27538":2163,"_5":27878,"_19130":51617,"_26074":51618,"_2645":51619},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3146":2170,"_27538":2163,"_5":27878,"_19130":51621,"_26074":51622,"_2645":51069},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#references",{"_3146":2171,"_27538":2163,"_19130":51624,"_5":13154,"_26074":2163,"_2645":51625},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3146":2172,"_27538":2163,"_19130":51627,"_5":13154,"_26074":51602,"_2645":51628},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3146":2173,"_27538":2163,"_19130":51630,"_5":13154,"_26074":51602,"_2645":51631},[],"Record status",{"_3146":2174,"_27538":2163,"_19130":51633,"_5":13154,"_26074":51602,"_2645":51634},[],"Signed response",{"_3146":2175,"_27538":2163,"_19130":51636,"_5":13154,"_26074":51602,"_2645":49084},[],{"_3146":2176,"_27538":2163,"_19130":51638,"_5":13154,"_26074":51602,"_2645":51639},[],"`Good`.",{"_3146":2177,"_27538":2163,"_19130":51641,"_5":13154,"_26074":51602,"_2645":49101},[],{"_3146":2178,"_27538":2163,"_19130":51643,"_5":13154,"_26074":51602,"_2645":51644},[],"`Revoked`, with revocation reason and timestamp.",{"_3146":2179,"_27538":2163,"_19130":51646,"_5":13154,"_26074":51602,"_2645":51647},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3146":2180,"_27538":2163,"_19130":51649,"_5":13154,"_26074":51602,"_2645":51650},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3146":2181,"_27538":2163,"_19130":51652,"_5":13154,"_26074":51602,"_2645":51653},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3146":2182,"_27538":2163,"_19130":51655,"_5":13154,"_26074":51602,"_2645":51656},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3146":2183,"_27538":2163,"_19130":51658,"_5":13154,"_26074":51602,"_2645":51659},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3146":2184,"_27538":2163,"_19130":51661,"_5":13154,"_26074":51606,"_2645":51662},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3146":2185,"_27538":2163,"_19130":51664,"_5":13154,"_26074":51606,"_2645":51665},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3146":2186,"_27538":2163,"_19130":51667,"_5":13154,"_26074":51610,"_2645":51668},[],"The service accepts:",{"_3146":2187,"_27538":2163,"_19130":51670,"_5":13154,"_26074":51610,"_2645":47937},[],{"_3146":2188,"_27538":2163,"_19130":51672,"_5":13154,"_26074":51610,"_2645":51673},[],"VA service path",{"_3146":2189,"_27538":2163,"_19130":51675,"_5":13154,"_26074":51610,"_2645":51676},[],"Format",{"_3146":2190,"_27538":2163,"_19130":51678,"_5":13154,"_26074":51610,"_2645":51679},[],"`POST`",{"_3146":2191,"_27538":2163,"_19130":51681,"_5":13154,"_26074":51610,"_2645":51682},[],"`/ocsp`",{"_3146":2192,"_27538":2163,"_19130":51684,"_5":13154,"_26074":51610,"_2645":51685},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3146":2193,"_27538":2163,"_19130":51687,"_5":13154,"_26074":51610,"_2645":51168},[],{"_3146":2194,"_27538":2163,"_19130":51689,"_5":13154,"_26074":51610,"_2645":51690},[],"`/ocsp/{ocsp_request}`",{"_3146":2195,"_27538":2163,"_19130":51692,"_5":13154,"_26074":51610,"_2645":51693},[],"DER request encoded using padded URL Base64.",{"_3146":2196,"_27538":2163,"_19130":51695,"_5":13154,"_26074":51610,"_2645":51696},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3146":2197,"_27538":2163,"_19130":51698,"_5":13154,"_26074":51614,"_2645":51699},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3146":2198,"_27538":2163,"_19130":51701,"_5":13154,"_26074":51614,"_2645":51702},[],"Generate the request:",{"_3146":2199,"_27538":2163,"_19130":51704,"_5":13154,"_26074":51614,"_2645":51705},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3146":2200,"_27538":2163,"_19130":51707,"_5":13154,"_26074":51614,"_2645":51708},[],"Replace the example URL with the inspected endpoint:",{"_3146":2201,"_27538":2163,"_19130":51710,"_5":13154,"_26074":51614,"_2645":51711},[],"Verify the returned DER:",{"_3146":2202,"_27538":2163,"_19130":51713,"_5":13154,"_26074":51614,"_2645":51714},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3146":2203,"_27538":2163,"_19130":51716,"_5":13154,"_26074":51618,"_2645":51717},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3146":2204,"_27538":2163,"_19130":51719,"_5":13154,"_26074":51618,"_2645":51720},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3146":2205,"_27538":2163,"_19130":51722,"_5":13154,"_26074":51622,"_2645":51723},[],"RFC 6960: OCSP.",{"_3146":2206,"_27538":2163,"_19130":51725,"_5":13154,"_26074":51622,"_2645":51726},[],"OpenSSL: openssl-ocsp.",{"_3146":2207,"_27538":2163,"_19130":51728,"_5":13154,"_26074":51622,"_2645":51729},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3146":2208,"_27538":2163,"_19130":51731,"_5":13154,"_26074":51622,"_2645":51206},[],{"_3146":2209,"_27538":2209,"_5":13480,"_2645":49906,"_27881":51733,"_19130":51734,"_26074":2209},[44830,46210,49906],[],{"_3146":2210,"_27538":2209,"_19130":51736,"_5":13154,"_26074":2209,"_2645":51737},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3146":2211,"_27538":2209,"_5":27878,"_19130":51739,"_26074":51740,"_2645":49216},[],"/docs/pr-preview/pr-26/platform/pki/overview#start-here",{"_3146":2212,"_27538":2209,"_5":27878,"_19130":51742,"_26074":51743,"_2645":51744},[],"/docs/pr-preview/pr-26/platform/pki/overview#what-you-need","What you need",{"_3146":2213,"_27538":2209,"_5":27878,"_19130":51746,"_26074":51747,"_2645":49750},[],"/docs/pr-preview/pr-26/platform/pki/overview#core-capabilities",{"_3146":2214,"_27538":2209,"_5":27878,"_19130":51749,"_26074":51750,"_2645":49754},[],"/docs/pr-preview/pr-26/platform/pki/overview#build-your-trust-hierarchy",{"_3146":2215,"_27538":2209,"_5":27878,"_19130":51752,"_26074":51753,"_2645":49758},[],"/docs/pr-preview/pr-26/platform/pki/overview#protect-cryptographic-keys",{"_3146":2216,"_27538":2209,"_5":27878,"_19130":51755,"_26074":51756,"_2645":49762},[],"/docs/pr-preview/pr-26/platform/pki/overview#issue-and-control-certificates",{"_3146":2217,"_27538":2209,"_5":27878,"_19130":51758,"_26074":51759,"_2645":49770},[],"/docs/pr-preview/pr-26/platform/pki/overview#publish-validation-status",{"_3146":2218,"_27538":2209,"_5":27878,"_19130":51761,"_26074":51762,"_2645":51763},[],"/docs/pr-preview/pr-26/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3146":2219,"_27538":2209,"_5":27878,"_19130":51765,"_26074":51766,"_2645":50690},[],"/docs/pr-preview/pr-26/platform/pki/overview#continue",{"_3146":2220,"_27538":2209,"_19130":51768,"_5":13154,"_26074":2209,"_2645":51769},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3146":2221,"_27538":2209,"_19130":51771,"_5":13154,"_26074":51740,"_2645":51772},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3146":2222,"_27538":2209,"_19130":51774,"_5":13154,"_26074":51740,"_2645":51775},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3146":2223,"_27538":2209,"_19130":51777,"_5":13154,"_26074":51743,"_2645":51778},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3146":2224,"_27538":2209,"_19130":51780,"_5":13154,"_26074":51743,"_2645":51781},[],"An available cryptographic engine to keep the authority's key.",{"_3146":2225,"_27538":2209,"_19130":51783,"_5":13154,"_26074":51743,"_2645":51784},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3146":2226,"_27538":2209,"_19130":51786,"_5":13154,"_26074":51743,"_2645":51787},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3146":2227,"_27538":2209,"_19130":51789,"_5":13154,"_26074":51743,"_2645":51790},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3146":2228,"_27538":2209,"_19130":51792,"_5":13154,"_26074":51750,"_2645":51793},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3146":2229,"_27538":2209,"_19130":51795,"_5":13154,"_26074":51753,"_2645":51796},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3146":2230,"_27538":2209,"_19130":51798,"_5":13154,"_26074":51756,"_2645":51799},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3146":2231,"_27538":2209,"_19130":51801,"_5":13154,"_26074":51759,"_2645":51802},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3146":2232,"_27538":2209,"_19130":51804,"_5":13154,"_26074":51762,"_2645":51805},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3146":2233,"_27538":2209,"_19130":51807,"_5":13154,"_26074":51762,"_2645":51808},[],"its subject and extensions identify the expected client;",{"_3146":2234,"_27538":2209,"_19130":51810,"_5":13154,"_26074":51762,"_2645":51811},[],"its public key matches the client's private key;",{"_3146":2235,"_27538":2209,"_19130":51813,"_5":13154,"_26074":51762,"_2645":51814},[],"its chain reaches a root trusted by the consumer;",{"_3146":2236,"_27538":2209,"_19130":51816,"_5":13154,"_26074":51762,"_2645":51817},[],"its dates and usages allow the operation;",{"_3146":2237,"_27538":2209,"_19130":51819,"_5":13154,"_26074":51762,"_2645":51820},[],"the consumer applies revocation checks and authorization.",{"_3146":2238,"_27538":2209,"_19130":51822,"_5":13154,"_26074":51762,"_2645":51823},[],"The issuance path includes the first independent checks.",{"_3146":2239,"_27538":2209,"_19130":51825,"_5":13154,"_26074":51766,"_2645":51826},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3146":2240,"_27538":2209,"_19130":51828,"_5":13154,"_26074":51766,"_2645":51829},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3146":2241,"_27538":2209,"_19130":51831,"_5":13154,"_26074":51766,"_2645":51832},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3146":2242,"_27538":2242,"_5":13480,"_2645":51834,"_27881":51835,"_19130":51836,"_26074":2242},"Create your first CA",[44830,46210,49906,49341],[],{"_3146":2243,"_27538":2242,"_19130":51838,"_5":13154,"_26074":2242,"_2645":51839},[],"Create an evaluation root and check its certificate before issuing.",{"_3146":2244,"_27538":2242,"_5":27878,"_19130":51841,"_26074":51842,"_2645":44840},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3146":2245,"_27538":2242,"_5":27878,"_19130":51844,"_26074":51845,"_2645":51846},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3146":2246,"_27538":2242,"_5":27878,"_19130":51848,"_26074":51849,"_2645":51850},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3146":2247,"_27538":2242,"_5":27878,"_19130":51852,"_26074":51853,"_2645":51854},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3146":2248,"_27538":2242,"_5":27878,"_19130":51856,"_26074":51857,"_2645":51858},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3146":2249,"_27538":2242,"_5":27878,"_19130":51860,"_26074":51861,"_2645":51862},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3146":2250,"_27538":2242,"_5":27878,"_19130":51864,"_26074":51865,"_2645":51866},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3146":2251,"_27538":2242,"_5":27878,"_19130":51868,"_26074":51869,"_2645":49599},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3146":2252,"_27538":2242,"_5":27878,"_19130":51871,"_26074":51872,"_2645":44864},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3146":2253,"_27538":2242,"_19130":51874,"_5":13154,"_26074":2242,"_2645":51875},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3146":2254,"_27538":2242,"_19130":51877,"_5":13154,"_26074":51842,"_2645":51878},[],"Console access and permission to create keys and authorities.",{"_3146":2255,"_27538":2242,"_19130":51880,"_5":13154,"_26074":51842,"_2645":51881},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3146":2256,"_27538":2242,"_19130":51883,"_5":13154,"_26074":51842,"_2645":51884},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3146":2257,"_27538":2242,"_19130":51886,"_5":13154,"_26074":51842,"_2645":51887},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3146":2258,"_27538":2242,"_19130":51889,"_5":13154,"_26074":51845,"_2645":51890},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3146":2259,"_27538":2242,"_19130":51892,"_5":13154,"_26074":51845,"_2645":51893},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3146":2260,"_27538":2242,"_19130":51895,"_5":13154,"_26074":51849,"_2645":51896},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3146":2261,"_27538":2242,"_19130":51898,"_5":13154,"_26074":51849,"_2645":51899},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3146":2262,"_27538":2242,"_19130":51901,"_5":13154,"_26074":51853,"_2645":51902},[],"Select **Root CA** and complete:",{"_3146":2263,"_27538":2242,"_19130":51904,"_5":13154,"_26074":51853,"_2645":51905},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3146":2264,"_27538":2242,"_19130":51907,"_5":13154,"_26074":51853,"_2645":51908},[],"**Subject**: organization and country details for your evaluation.",{"_3146":2265,"_27538":2242,"_19130":51910,"_5":13154,"_26074":51853,"_2645":51911},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3146":2266,"_27538":2242,"_19130":51913,"_5":13154,"_26074":51853,"_2645":51914},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3146":2267,"_27538":2242,"_19130":51916,"_5":13154,"_26074":51853,"_2645":51917},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3146":2268,"_27538":2242,"_19130":51919,"_5":13154,"_26074":51857,"_2645":51920},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3146":2269,"_27538":2242,"_19130":51922,"_5":13154,"_26074":51861,"_2645":51923},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3146":2270,"_27538":2242,"_19130":51925,"_5":13154,"_26074":51861,"_2645":51926},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3146":2271,"_27538":2242,"_19130":51928,"_5":13154,"_26074":51865,"_2645":51929},[],"Run from the directory where you saved `ca.pem`:",{"_3146":2272,"_27538":2242,"_19130":51931,"_5":13154,"_26074":51865,"_2645":51932},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3146":2273,"_27538":2242,"_19130":51934,"_5":13154,"_26074":51865,"_2645":51935},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3146":2274,"_27538":2242,"_19130":51937,"_5":13154,"_26074":51869,"_2645":51938},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3146":2275,"_27538":2242,"_19130":51940,"_5":13154,"_26074":51869,"_2645":51941},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3146":2276,"_27538":2242,"_19130":51943,"_5":13154,"_26074":51869,"_2645":51944},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3146":2277,"_27538":2242,"_19130":51946,"_5":13154,"_26074":51869,"_2645":51947},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3146":2278,"_27538":2242,"_19130":51949,"_5":13154,"_26074":51872,"_2645":51950},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3146":2279,"_27538":2279,"_5":13480,"_2645":51952,"_27881":51953,"_19130":51954,"_26074":2279},"Issue and verify a certificate",[44830,46210,49906,49341],[],{"_3146":2280,"_27538":2279,"_19130":51956,"_5":13154,"_26074":2279,"_2645":51957},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3146":2281,"_27538":2279,"_5":27878,"_19130":51959,"_26074":51960,"_2645":44840},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3146":2282,"_27538":2279,"_5":27878,"_19130":51962,"_26074":51963,"_2645":51964},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3146":2283,"_27538":2279,"_5":27878,"_19130":51966,"_26074":51967,"_2645":51968},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3146":2284,"_27538":2279,"_5":27878,"_19130":51970,"_26074":51971,"_2645":51972},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3146":2285,"_27538":2279,"_5":27878,"_19130":51974,"_26074":51975,"_2645":51976},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3146":2286,"_27538":2279,"_5":27878,"_19130":51978,"_26074":51979,"_2645":51980},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3146":2287,"_27538":2279,"_5":27878,"_19130":51982,"_26074":51983,"_2645":51862},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3146":2288,"_27538":2279,"_5":27878,"_19130":51985,"_26074":51986,"_2645":51987},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3146":2289,"_27538":2279,"_5":27878,"_19130":51989,"_26074":51990,"_2645":51991},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3146":2290,"_27538":2279,"_5":27878,"_19130":51993,"_26074":51994,"_2645":51995},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3146":2291,"_27538":2279,"_5":27878,"_19130":51997,"_26074":51998,"_2645":49599},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3146":2292,"_27538":2279,"_5":27878,"_19130":52000,"_26074":52001,"_2645":44864},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#next-step",{"_3146":2293,"_27538":2279,"_19130":52003,"_5":13154,"_26074":2279,"_2645":52004},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3146":2294,"_27538":2279,"_19130":52006,"_5":13154,"_26074":51960,"_2645":52007},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3146":2295,"_27538":2279,"_19130":52009,"_5":13154,"_26074":51960,"_2645":52010},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3146":2296,"_27538":2279,"_19130":52012,"_5":13154,"_26074":51960,"_2645":52013},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3146":2297,"_27538":2279,"_19130":52015,"_5":13154,"_26074":51960,"_2645":52016},[],"A client identifier: here we use `device-001`.",{"_3146":2298,"_27538":2279,"_19130":52018,"_5":13154,"_26074":51960,"_2645":52019},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3146":2299,"_27538":2279,"_19130":52021,"_5":13154,"_26074":51963,"_2645":52022},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3146":2300,"_27538":2279,"_19130":52024,"_5":13154,"_26074":51967,"_2645":52025},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3146":2301,"_27538":2279,"_19130":52027,"_5":13154,"_26074":51967,"_2645":52028},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3146":2302,"_27538":2279,"_19130":52030,"_5":13154,"_26074":51971,"_2645":52031},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3146":2303,"_27538":2279,"_19130":52033,"_5":13154,"_26074":51971,"_2645":52034},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3146":2304,"_27538":2279,"_19130":52036,"_5":13154,"_26074":51975,"_2645":52037},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3146":2305,"_27538":2279,"_19130":52039,"_5":13154,"_26074":51975,"_2645":52040},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3146":2306,"_27538":2279,"_19130":52042,"_5":13154,"_26074":51979,"_2645":52043},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3146":2307,"_27538":2279,"_19130":52045,"_5":13154,"_26074":51983,"_2645":52046},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3146":2308,"_27538":2279,"_19130":52048,"_5":13154,"_26074":51986,"_2645":52049},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3146":2309,"_27538":2279,"_19130":52051,"_5":13154,"_26074":51990,"_2645":52052},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3146":2310,"_27538":2279,"_19130":52054,"_5":13154,"_26074":51990,"_2645":52055},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3146":2311,"_27538":2279,"_19130":52057,"_5":13154,"_26074":51990,"_2645":52058},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3146":2312,"_27538":2279,"_19130":52060,"_5":13154,"_26074":51994,"_2645":52061},[],"In Bash, compare the two public-key digests:",{"_3146":2313,"_27538":2279,"_19130":52063,"_5":13154,"_26074":51994,"_2645":52064},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3146":2314,"_27538":2279,"_19130":52066,"_5":13154,"_26074":51994,"_2645":52067},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3146":2315,"_27538":2279,"_19130":52069,"_5":13154,"_26074":51998,"_2645":49683},[],{"_3146":2316,"_27538":2279,"_19130":52071,"_5":13154,"_26074":51998,"_2645":52072},[],"What to review",{"_3146":2317,"_27538":2279,"_19130":52074,"_5":13154,"_26074":51998,"_2645":52075},[],"The CA rejects issuance",{"_3146":2318,"_27538":2279,"_19130":52077,"_5":13154,"_26074":51998,"_2645":52078},[],"Permissions, CA state and key, algorithm and profile.",{"_3146":2319,"_27538":2279,"_19130":52080,"_5":13154,"_26074":51998,"_2645":52081},[],"Different subject or usages",{"_3146":2320,"_27538":2279,"_19130":52083,"_5":13154,"_26074":51998,"_2645":52084},[],"Applied profile and requested values.",{"_3146":2321,"_27538":2279,"_19130":52086,"_5":13154,"_26074":51998,"_2645":52087},[],"Issuer cannot be found",{"_3146":2322,"_27538":2279,"_19130":52089,"_5":13154,"_26074":51998,"_2645":52090},[],"Downloaded CA and required intermediate chain.",{"_3146":2323,"_27538":2279,"_19130":52092,"_5":13154,"_26074":51998,"_2645":52093},[],"Validity fails",{"_3146":2324,"_27538":2279,"_19130":52095,"_5":13154,"_26074":51998,"_2645":52096},[],"Certificate and CA dates, and the computer's clock.",{"_3146":2325,"_27538":2279,"_19130":52098,"_5":13154,"_26074":51998,"_2645":52099},[],"Public-key digests differ",{"_3146":2326,"_27538":2279,"_19130":52101,"_5":13154,"_26074":51998,"_2645":52102},[],"Certificate and key files from the same issuance.",{"_3146":2327,"_27538":2279,"_19130":52104,"_5":13154,"_26074":51998,"_2645":52105},[],"See PKI diagnostics to narrow an issuance failure.",{"_3146":2328,"_27538":2279,"_19130":52107,"_5":13154,"_26074":52001,"_2645":52108},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3146":2329,"_27538":2279,"_19130":52110,"_5":13154,"_26074":52001,"_2645":52111},[],"Manage certificates for inspection, status and revocation.",{"_3146":2330,"_27538":2279,"_19130":52113,"_5":13154,"_26074":52001,"_2645":52114},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3146":2331,"_27538":2279,"_19130":52116,"_5":13154,"_26074":52001,"_2645":52117},[],"Prepare EST for the device to request its next identities.",{"_3146":2332,"_27538":2279,"_19130":52119,"_5":13154,"_26074":52001,"_2645":52120},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3146":2333,"_27538":2333,"_5":13480,"_2645":52122,"_27881":52123,"_19130":52124,"_26074":2333},"PKI getting started",[44830,46210,49906,49341],[],{"_3146":2334,"_27538":2333,"_19130":52126,"_5":13154,"_26074":2333,"_2645":52127},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3146":2335,"_27538":2333,"_5":27878,"_19130":52129,"_26074":52130,"_2645":44840},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#before-you-begin",{"_3146":2336,"_27538":2333,"_5":27878,"_19130":52132,"_26074":52133,"_2645":52134},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3146":2337,"_27538":2333,"_5":27878,"_19130":52136,"_26074":52137,"_2645":49533},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#expected-result",{"_3146":2338,"_27538":2333,"_5":27878,"_19130":52139,"_26074":52140,"_2645":52141},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3146":2339,"_27538":2333,"_19130":52143,"_5":13154,"_26074":2333,"_2645":52144},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3146":2340,"_27538":2333,"_19130":52146,"_5":13154,"_26074":52130,"_2645":52147},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3146":2341,"_27538":2333,"_19130":52149,"_5":13154,"_26074":52130,"_2645":52150},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3146":2342,"_27538":2333,"_19130":52152,"_5":13154,"_26074":52130,"_2645":52153},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3146":2343,"_27538":2333,"_19130":52155,"_5":13154,"_26074":52130,"_2645":52156},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3146":2344,"_27538":2333,"_19130":52158,"_5":13154,"_26074":52130,"_2645":52159},[],"A working directory with restricted access for the downloaded key.",{"_3146":2345,"_27538":2333,"_19130":52161,"_5":13154,"_26074":52133,"_2645":52162},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3146":2346,"_27538":2333,"_19130":52164,"_5":13154,"_26074":52133,"_2645":52165},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3146":2347,"_27538":2333,"_19130":52167,"_5":13154,"_26074":52133,"_2645":52168},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3146":2348,"_27538":2333,"_19130":52170,"_5":13154,"_26074":52133,"_2645":52171},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3146":2349,"_27538":2333,"_19130":52173,"_5":13154,"_26074":52137,"_2645":52174},[],"File or resource",{"_3146":2350,"_27538":2333,"_19130":52176,"_5":13154,"_26074":52137,"_2645":49530},[],{"_3146":2351,"_27538":2333,"_19130":52178,"_5":13154,"_26074":52137,"_2645":52179},[],"Active root CA and `ca.pem`",{"_3146":2352,"_27538":2333,"_19130":52181,"_5":13154,"_26074":52137,"_2645":52182},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3146":2353,"_27538":2333,"_19130":52184,"_5":13154,"_26074":52137,"_2645":52185},[],"End-entity certificate and `device.crt`",{"_3146":2354,"_27538":2333,"_19130":52187,"_5":13154,"_26074":52137,"_2645":52188},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3146":2355,"_27538":2333,"_19130":52190,"_5":13154,"_26074":52137,"_2645":52191},[],"Private key `device.key`",{"_3146":2356,"_27538":2333,"_19130":52193,"_5":13154,"_26074":52137,"_2645":52194},[],"Its public key matches the one included in `device.crt`.",{"_3146":2357,"_27538":2333,"_19130":52196,"_5":13154,"_26074":52137,"_2645":52197},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3146":2358,"_27538":2333,"_19130":52199,"_5":13154,"_26074":52140,"_2645":52200},[],"To operate certificates, continue with Certificates and Validation.",{"_3146":2359,"_27538":2333,"_19130":52202,"_5":13154,"_26074":52140,"_2645":52203},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3146":2360,"_27538":2333,"_19130":52205,"_5":13154,"_26074":52140,"_2645":52206},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3146":2361,"_27538":2361,"_5":13480,"_2645":52208,"_27881":52209,"_19130":52210,"_26074":2361},"PKI troubleshooting",[44830,46210,49906,48727],[],{"_3146":2362,"_27538":2361,"_19130":52212,"_5":13154,"_26074":2361,"_2645":52213},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3146":2363,"_27538":2361,"_5":27878,"_19130":52215,"_26074":52216,"_2645":52217},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3146":2364,"_27538":2361,"_5":27878,"_19130":52219,"_26074":52220,"_2645":52221},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3146":2365,"_27538":2361,"_5":27878,"_19130":52223,"_26074":52224,"_2645":52225},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3146":2366,"_27538":2361,"_19130":52227,"_5":13154,"_26074":2361,"_2645":52228},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3146":2367,"_27538":2361,"_19130":52230,"_5":13154,"_26074":2361,"_2645":52231},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3146":2368,"_27538":2361,"_19130":52233,"_5":13154,"_26074":52216,"_2645":49530},[],{"_3146":2369,"_27538":2361,"_19130":52235,"_5":13154,"_26074":52216,"_2645":52236},[],"What to inspect",{"_3146":2370,"_27538":2361,"_19130":52238,"_5":13154,"_26074":52216,"_2645":44864},[],{"_3146":2371,"_27538":2361,"_19130":52240,"_5":13154,"_26074":52216,"_2645":52241},[],"CA",{"_3146":2372,"_27538":2361,"_19130":52243,"_5":13154,"_26074":52216,"_2645":52244},[],"Exists, is active and has usable dates.",{"_3146":2373,"_27538":2361,"_19130":52246,"_5":13154,"_26074":52216,"_2645":52247},[],"Authorities.",{"_3146":2374,"_27538":2361,"_19130":52249,"_5":13154,"_26074":52216,"_2645":52250},[],"Key",{"_3146":2375,"_27538":2361,"_19130":52252,"_5":13154,"_26074":52216,"_2645":52253},[],"The record has a usable private key and the engine can sign.",{"_3146":2376,"_27538":2361,"_19130":52255,"_5":13154,"_26074":52216,"_2645":52256},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3146":2377,"_27538":2361,"_19130":52258,"_5":13154,"_26074":52216,"_2645":52259},[],"CSR",{"_3146":2378,"_27538":2361,"_19130":52261,"_5":13154,"_26074":52216,"_2645":52262},[],"Correct PEM and verifiable signature.",{"_3146":2379,"_27538":2361,"_19130":52264,"_5":13154,"_26074":52216,"_2645":52265},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3146":2380,"_27538":2361,"_19130":52267,"_5":13154,"_26074":52216,"_2645":52268},[],"Profile",{"_3146":2381,"_27538":2361,"_19130":52270,"_5":13154,"_26074":52216,"_2645":52271},[],"Selected source, existing ID, allowed algorithm and size.",{"_3146":2382,"_27538":2361,"_19130":52273,"_5":13154,"_26074":52216,"_2645":52274},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3146":2383,"_27538":2361,"_19130":52276,"_5":13154,"_26074":52216,"_2645":49683},[],{"_3146":2384,"_27538":2361,"_19130":52278,"_5":13154,"_26074":52216,"_2645":52279},[],"Appropriate subject, SAN, usages and dates.",{"_3146":2385,"_27538":2361,"_19130":52281,"_5":13154,"_26074":52216,"_2645":52282},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3146":2386,"_27538":2361,"_19130":52284,"_5":13154,"_26074":52216,"_2645":52285},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3146":2387,"_27538":2361,"_19130":52287,"_5":13154,"_26074":52216,"_2645":52288},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3146":2388,"_27538":2361,"_19130":52290,"_5":13154,"_26074":52220,"_2645":52291},[],"Check each boundary independently:",{"_3146":2389,"_27538":2361,"_19130":52293,"_5":13154,"_26074":52220,"_2645":52294},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3146":2390,"_27538":2361,"_19130":52296,"_5":13154,"_26074":52220,"_2645":52297},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3146":2391,"_27538":2361,"_19130":52299,"_5":13154,"_26074":52220,"_2645":52300},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3146":2392,"_27538":2361,"_19130":52302,"_5":13154,"_26074":52220,"_2645":52303},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3146":2393,"_27538":2361,"_19130":52305,"_5":13154,"_26074":52220,"_2645":52306},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3146":2394,"_27538":2361,"_19130":52308,"_5":13154,"_26074":52220,"_2645":52309},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3146":2395,"_27538":2361,"_19130":52311,"_5":13154,"_26074":52224,"_2645":52312},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3146":2396,"_27538":2361,"_19130":52314,"_5":13154,"_26074":52224,"_2645":52315},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3146":2397,"_27538":2397,"_5":13480,"_2645":52317,"_27881":52318,"_19130":52320,"_26074":2397},"3.8.0 to 4.0.0",[44830,52319],"Upgrades",[],{"_3146":2398,"_27538":2397,"_19130":52322,"_5":13154,"_26074":2397,"_2645":52323},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3146":2399,"_27538":2397,"_5":27878,"_19130":52325,"_26074":52326,"_2645":52327},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3146":2400,"_27538":2397,"_5":27878,"_19130":52329,"_26074":52330,"_2645":52331},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3146":2401,"_27538":2397,"_5":27878,"_19130":52333,"_26074":52334,"_2645":52335},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3146":2402,"_27538":2397,"_5":27878,"_19130":52337,"_26074":52338,"_2645":52339},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3146":2403,"_27538":2397,"_5":27878,"_19130":52341,"_26074":52342,"_2645":52343},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3146":2404,"_27538":2397,"_5":27878,"_19130":52345,"_26074":52346,"_2645":52347},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3146":2405,"_27538":2397,"_5":27878,"_19130":52349,"_26074":52350,"_2645":52351},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3146":2406,"_27538":2397,"_5":27878,"_19130":52353,"_26074":52354,"_2645":52355},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3146":2407,"_27538":2397,"_5":27878,"_19130":52357,"_26074":52358,"_2645":52359},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3146":2408,"_27538":2397,"_5":27878,"_19130":52361,"_26074":52362,"_2645":52363},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3146":2409,"_27538":2397,"_5":27878,"_19130":52365,"_26074":52366,"_2645":52367},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3146":2410,"_27538":2397,"_5":27878,"_19130":52369,"_26074":52370,"_2645":52371},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3146":2411,"_27538":2397,"_5":27878,"_19130":52373,"_26074":52374,"_2645":52375},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3146":2412,"_27538":2397,"_5":27878,"_19130":52377,"_26074":52378,"_2645":52379},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3146":2413,"_27538":2397,"_5":27878,"_19130":52381,"_26074":52382,"_2645":52383},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3146":2414,"_27538":2397,"_5":27878,"_19130":52385,"_26074":52386,"_2645":52387},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3146":2415,"_27538":2397,"_5":27878,"_19130":52389,"_26074":52390,"_2645":52391},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3146":2416,"_27538":2397,"_5":27878,"_19130":52393,"_26074":52394,"_2645":52395},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3146":2417,"_27538":2397,"_5":27878,"_19130":52397,"_26074":52398,"_2645":52399},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3146":2418,"_27538":2397,"_5":27878,"_19130":52401,"_26074":52402,"_2645":52403},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3146":2419,"_27538":2397,"_5":27878,"_19130":52405,"_26074":52406,"_2645":52407},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3146":2420,"_27538":2397,"_5":27878,"_19130":52409,"_26074":52410,"_2645":52411},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3146":2421,"_27538":2397,"_5":27878,"_19130":52413,"_26074":52414,"_2645":52415},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3146":2422,"_27538":2397,"_5":27878,"_19130":52417,"_26074":52418,"_2645":52419},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3146":2423,"_27538":2397,"_5":27878,"_19130":52421,"_26074":52422,"_2645":52423},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3146":2424,"_27538":2397,"_5":27878,"_19130":52425,"_26074":52426,"_2645":52427},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3146":2425,"_27538":2397,"_5":27878,"_19130":52429,"_26074":52430,"_2645":52431},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3146":2426,"_27538":2397,"_5":27878,"_19130":52433,"_26074":52434,"_2645":52435},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3146":2427,"_27538":2397,"_5":27878,"_19130":52437,"_26074":52438,"_2645":52439},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3146":2428,"_27538":2397,"_5":27878,"_19130":52441,"_26074":52442,"_2645":52443},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3146":2429,"_27538":2397,"_5":27878,"_19130":52445,"_26074":52446,"_2645":52447},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3146":2430,"_27538":2397,"_5":27878,"_19130":52449,"_26074":52450,"_2645":52451},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3146":2431,"_27538":2397,"_5":27878,"_19130":52453,"_26074":52454,"_2645":52455},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3146":2432,"_27538":2397,"_5":27878,"_19130":52457,"_26074":52458,"_2645":48727},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3146":2433,"_27538":2397,"_5":27878,"_19130":52460,"_26074":52461,"_2645":52462},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3146":2434,"_27538":2397,"_5":27878,"_19130":52464,"_26074":52465,"_2645":52466},[],"/docs/pr-preview/pr-26/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3146":2435,"_27538":2397,"_19130":52468,"_5":13154,"_26074":2397,"_2645":52469},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3146":2436,"_27538":2397,"_19130":52471,"_5":13154,"_26074":2397,"_2645":52472},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3146":2437,"_27538":2397,"_19130":52474,"_5":13154,"_26074":2397,"_2645":52475},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3146":2438,"_27538":2397,"_19130":52477,"_5":13154,"_26074":2397,"_2645":52478},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3146":2439,"_27538":2397,"_19130":52480,"_5":13154,"_26074":2397,"_2645":52481},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3146":2440,"_27538":2397,"_19130":52483,"_5":13154,"_26074":2397,"_2645":52484},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3146":2441,"_27538":2397,"_19130":52486,"_5":13154,"_26074":2397,"_2645":52487},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3146":2442,"_27538":2397,"_19130":52489,"_5":13154,"_26074":52330,"_2645":52490},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3146":2443,"_27538":2397,"_19130":52492,"_5":13154,"_26074":52330,"_2645":52493},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3146":2444,"_27538":2397,"_19130":52495,"_5":13154,"_26074":52334,"_2645":52496},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3146":2445,"_27538":2397,"_19130":52498,"_5":13154,"_26074":52334,"_2645":52499},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3146":2446,"_27538":2397,"_19130":52501,"_5":13154,"_26074":52338,"_2645":52502},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3146":2447,"_27538":2397,"_19130":52504,"_5":13154,"_26074":52342,"_2645":52505},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3146":2448,"_27538":2397,"_19130":52507,"_5":13154,"_26074":52342,"_2645":52508},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3146":2449,"_27538":2397,"_19130":52510,"_5":13154,"_26074":52342,"_2645":52511},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3146":2450,"_27538":2397,"_19130":52513,"_5":13154,"_26074":52342,"_2645":52514},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3146":2451,"_27538":2397,"_19130":52516,"_5":13154,"_26074":52342,"_2645":52517},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3146":2452,"_27538":2397,"_19130":52519,"_5":13154,"_26074":52346,"_2645":52520},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3146":2453,"_27538":2397,"_19130":52522,"_5":13154,"_26074":52346,"_2645":52523},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3146":2454,"_27538":2397,"_19130":52525,"_5":13154,"_26074":52346,"_2645":52526},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3146":2455,"_27538":2397,"_19130":52528,"_5":13154,"_26074":52346,"_2645":52529},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3146":2456,"_27538":2397,"_19130":52531,"_5":13154,"_26074":52346,"_2645":52532},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3146":2457,"_27538":2397,"_19130":52534,"_5":13154,"_26074":52350,"_2645":52535},[],"Change",{"_3146":2458,"_27538":2397,"_19130":52537,"_5":13154,"_26074":52350,"_2645":52538},[],"Who is affected",{"_3146":2459,"_27538":2397,"_19130":52540,"_5":13154,"_26074":52350,"_2645":52541},[],"Severity",{"_3146":2460,"_27538":2397,"_19130":52543,"_5":13154,"_26074":52350,"_2645":52544},[],"Action",{"_3146":2461,"_27538":2397,"_19130":52546,"_5":13154,"_26074":52350,"_2645":52359},[],{"_3146":2462,"_27538":2397,"_19130":52548,"_5":13154,"_26074":52350,"_2645":52549},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3146":2463,"_27538":2397,"_19130":52551,"_5":13154,"_26074":52350,"_2645":52552},[],"High: KMS and VA start on empty volumes",{"_3146":2464,"_27538":2397,"_19130":52554,"_5":13154,"_26074":52350,"_2645":52555},[],"Copy the data into the new volumes",{"_3146":2465,"_27538":2397,"_19130":52557,"_5":13154,"_26074":52350,"_2645":52363},[],{"_3146":2466,"_27538":2397,"_19130":52559,"_5":13154,"_26074":52350,"_2645":52560},[],"Every Helm release",{"_3146":2467,"_27538":2397,"_19130":52562,"_5":13154,"_26074":52350,"_2645":52563},[],"High: `helm upgrade` fails",{"_3146":2468,"_27538":2397,"_19130":52565,"_5":13154,"_26074":52350,"_2645":52566},[],"Remove or rename legacy keys",{"_3146":2469,"_27538":2397,"_19130":52568,"_5":13154,"_26074":52350,"_2645":52367},[],{"_3146":2470,"_27538":2397,"_19130":52570,"_5":13154,"_26074":52350,"_2645":52571},[],"Every deployment",{"_3146":2471,"_27538":2397,"_19130":52573,"_5":13154,"_26074":52350,"_2645":52574},[],"High: without a bootstrap principal there is no administrator",{"_3146":2472,"_27538":2397,"_19130":52576,"_5":13154,"_26074":52350,"_2645":52577},[],"Configure `services.authz`",{"_3146":2473,"_27538":2397,"_19130":52579,"_5":13154,"_26074":52350,"_2645":52371},[],{"_3146":2474,"_27538":2397,"_19130":52581,"_5":13154,"_26074":52350,"_2645":52560},[],{"_3146":2475,"_27538":2397,"_19130":52583,"_5":13154,"_26074":52350,"_2645":52584},[],"High: `helm upgrade` fails on the old keys",{"_3146":2476,"_27538":2397,"_19130":52586,"_5":13154,"_26074":52350,"_2645":52587},[],"Move JWKS and roles into `services.authz`",{"_3146":2477,"_27538":2397,"_19130":52589,"_5":13154,"_26074":52350,"_2645":52391},[],{"_3146":2478,"_27538":2397,"_19130":52591,"_5":13154,"_26074":52350,"_2645":52592},[],"3.8.0 deployments with per-service databases",{"_3146":2479,"_27538":2397,"_19130":52594,"_5":13154,"_26074":52350,"_2645":52595},[],"High: services find no data, or a migration aborts",{"_3146":2480,"_27538":2397,"_19130":52597,"_5":13154,"_26074":52350,"_2645":52598},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3146":2481,"_27538":2397,"_19130":52600,"_5":13154,"_26074":52350,"_2645":52395},[],{"_3146":2482,"_27538":2397,"_19130":52602,"_5":13154,"_26074":52350,"_2645":52603},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3146":2483,"_27538":2397,"_19130":52605,"_5":13154,"_26074":52350,"_2645":52606},[],"High: the backend no longer starts with them",{"_3146":2484,"_27538":2397,"_19130":52608,"_5":13154,"_26074":52350,"_2645":52609},[],"Move to PostgreSQL before upgrading",{"_3146":2485,"_27538":2397,"_19130":52611,"_5":13154,"_26074":52350,"_2645":52612},[],"Webhooks with file references",{"_3146":2486,"_27538":2397,"_19130":52614,"_5":13154,"_26074":52350,"_2645":52615},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3146":2487,"_27538":2397,"_19130":52617,"_5":13154,"_26074":52350,"_2645":52618},[],"High: enrollments calling the webhook fail",{"_3146":2488,"_27538":2397,"_19130":52620,"_5":13154,"_26074":52350,"_2645":52621},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3146":2489,"_27538":2397,"_19130":52623,"_5":13154,"_26074":52350,"_2645":52375},[],{"_3146":2490,"_27538":2397,"_19130":52625,"_5":13154,"_26074":52350,"_2645":52626},[],"Releases with per-service identity overrides or mounted key material",{"_3146":2491,"_27538":2397,"_19130":52628,"_5":13154,"_26074":52350,"_2645":52629},[],"Medium: services cannot read their files",{"_3146":2492,"_27538":2397,"_19130":52631,"_5":13154,"_26074":52350,"_2645":52632},[],"Remove the overrides and fix volume ownership",{"_3146":2493,"_27538":2397,"_19130":52634,"_5":13154,"_26074":52350,"_2645":52379},[],{"_3146":2494,"_27538":2397,"_19130":52636,"_5":13154,"_26074":52350,"_2645":52637},[],"Releases that set `amqp.tls`",{"_3146":2495,"_27538":2397,"_19130":52639,"_5":13154,"_26074":52350,"_2645":52640},[],"Medium: clients connect to the wrong port",{"_3146":2496,"_27538":2397,"_19130":52642,"_5":13154,"_26074":52350,"_2645":52643},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3146":2497,"_27538":2397,"_19130":52645,"_5":13154,"_26074":52350,"_2645":52399},[],{"_3146":2498,"_27538":2397,"_19130":52647,"_5":13154,"_26074":52350,"_2645":52648},[],"Installations whose CA keys predate the KMS",{"_3146":2499,"_27538":2397,"_19130":52650,"_5":13154,"_26074":52350,"_2645":52651},[],"Medium: CA keys stay unmanaged",{"_3146":2500,"_27538":2397,"_19130":52653,"_5":13154,"_26074":52350,"_2645":52654},[],"Run the CA-to-KMS migration",{"_3146":2501,"_27538":2397,"_19130":52656,"_5":13154,"_26074":52350,"_2645":52657},[],"Receiver certificate verification",{"_3146":2502,"_27538":2397,"_19130":52659,"_5":13154,"_26074":52350,"_2645":52660},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3146":2503,"_27538":2397,"_19130":52662,"_5":13154,"_26074":52350,"_2645":52663},[],"Medium: credentials go to an unverified receiver",{"_3146":2504,"_27538":2397,"_19130":52665,"_5":13154,"_26074":52350,"_2645":52666},[],"Set `insecure_skip_verify` to `false`",{"_3146":2505,"_27538":2397,"_19130":52668,"_5":13154,"_26074":52350,"_2645":52411},[],{"_3146":2506,"_27538":2397,"_19130":52670,"_5":13154,"_26074":52350,"_2645":52671},[],"Scripts and consoles that edit DMSs through the API",{"_3146":2507,"_27538":2397,"_19130":52673,"_5":13154,"_26074":52350,"_2645":52674},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3146":2508,"_27538":2397,"_19130":52676,"_5":13154,"_26074":52350,"_2645":52677},[],"Read the DMS before editing and use the new field",{"_3146":2509,"_27538":2397,"_19130":52679,"_5":13154,"_26074":52350,"_2645":52427},[],{"_3146":2510,"_27538":2397,"_19130":52681,"_5":13154,"_26074":52350,"_2645":52682},[],"Consumers that read the device `events` field",{"_3146":2511,"_27538":2397,"_19130":52684,"_5":13154,"_26074":52350,"_2645":52685},[],"Medium: the field disappears",{"_3146":2512,"_27538":2397,"_19130":52687,"_5":13154,"_26074":52350,"_2645":52688},[],"Use the new event endpoints",{"_3146":2513,"_27538":2397,"_19130":52690,"_5":13154,"_26074":52350,"_2645":52383},[],{"_3146":2514,"_27538":2397,"_19130":52692,"_5":13154,"_26074":52350,"_2645":52693},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3146":2515,"_27538":2397,"_19130":52695,"_5":13154,"_26074":52350,"_2645":52696},[],"Low to medium: validation errors or changed defaults",{"_3146":2516,"_27538":2397,"_19130":52698,"_5":13154,"_26074":52350,"_2645":52699},[],"Update the values file",{"_3146":2517,"_27538":2397,"_19130":52701,"_5":13154,"_26074":52350,"_2645":52419},[],{"_3146":2518,"_27538":2397,"_19130":52703,"_5":13154,"_26074":52350,"_2645":52704},[],"Clients that send the DMS ID in the update body",{"_3146":2519,"_27538":2397,"_19130":52706,"_5":13154,"_26074":52350,"_2645":52707},[],"Low: the ID in the URL wins",{"_3146":2520,"_27538":2397,"_19130":52709,"_5":13154,"_26074":52350,"_2645":52710},[],"Send the ID in the URL",{"_3146":2521,"_27538":2397,"_19130":52712,"_5":13154,"_26074":52350,"_2645":52423},[],{"_3146":2522,"_27538":2397,"_19130":52714,"_5":13154,"_26074":52350,"_2645":52715},[],"Consumers that match on certificate `type`",{"_3146":2523,"_27538":2397,"_19130":52717,"_5":13154,"_26074":52350,"_2645":52718},[],"Low: two values are renamed",{"_3146":2524,"_27538":2397,"_19130":52720,"_5":13154,"_26074":52350,"_2645":52721},[],"Adapt consumers",{"_3146":2525,"_27538":2397,"_19130":52723,"_5":13154,"_26074":52350,"_2645":52415},[],{"_3146":2526,"_27538":2397,"_19130":52725,"_5":13154,"_26074":52350,"_2645":52726},[],"Any DMS",{"_3146":2527,"_27538":2397,"_19130":52728,"_5":13154,"_26074":52350,"_2645":52729},[],"Low: informational",{"_3146":2528,"_27538":2397,"_19130":52731,"_5":13154,"_26074":52350,"_2645":52732},[],"Read both blocks before editing",{"_3146":2529,"_27538":2397,"_19130":52734,"_5":13154,"_26074":52358,"_2645":52735},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3146":2530,"_27538":2397,"_19130":52737,"_5":13154,"_26074":52358,"_2645":52738},[],"Step 4 of the migration guide copies the data.",{"_3146":2531,"_27538":2397,"_19130":52740,"_5":13154,"_26074":52362,"_2645":52741},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3146":2532,"_27538":2397,"_19130":52743,"_5":13154,"_26074":52366,"_2645":52744},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3146":2533,"_27538":2397,"_19130":52746,"_5":13154,"_26074":52370,"_2645":52747},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3146":2534,"_27538":2397,"_19130":52749,"_5":13154,"_26074":52374,"_2645":52750},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3146":2535,"_27538":2397,"_19130":52752,"_5":13154,"_26074":52374,"_2645":52753},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3146":2536,"_27538":2397,"_19130":52755,"_5":13154,"_26074":52378,"_2645":52756},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3146":2537,"_27538":2397,"_19130":52758,"_5":13154,"_26074":52382,"_2645":52759},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3146":2538,"_27538":2397,"_19130":52761,"_5":13154,"_26074":52382,"_2645":52762},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3146":2539,"_27538":2397,"_19130":52764,"_5":13154,"_26074":52382,"_2645":52765},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3146":2540,"_27538":2397,"_19130":52767,"_5":13154,"_26074":52382,"_2645":52768},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3146":2541,"_27538":2397,"_19130":52770,"_5":13154,"_26074":52382,"_2645":52771},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3146":2542,"_27538":2397,"_19130":52773,"_5":13154,"_26074":52382,"_2645":52774},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3146":2543,"_27538":2397,"_19130":52776,"_5":13154,"_26074":52390,"_2645":52777},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3146":2544,"_27538":2397,"_19130":52779,"_5":13154,"_26074":52390,"_2645":52780},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3146":2545,"_27538":2397,"_19130":52782,"_5":13154,"_26074":52390,"_2645":52783},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3146":2546,"_27538":2397,"_19130":52785,"_5":13154,"_26074":52390,"_2645":52786},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3146":2547,"_27538":2397,"_19130":52788,"_5":13154,"_26074":52390,"_2645":52789},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3146":2548,"_27538":2397,"_19130":52791,"_5":13154,"_26074":52394,"_2645":52792},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3146":2549,"_27538":2397,"_19130":52794,"_5":13154,"_26074":52398,"_2645":52795},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3146":2550,"_27538":2397,"_19130":52797,"_5":13154,"_26074":52398,"_2645":52798},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3146":2551,"_27538":2397,"_19130":52800,"_5":13154,"_26074":52398,"_2645":52801},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3146":2552,"_27538":2397,"_19130":52803,"_5":13154,"_26074":52398,"_2645":52804},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3146":2553,"_27538":2397,"_19130":52806,"_5":13154,"_26074":52398,"_2645":52807},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3146":2554,"_27538":2397,"_19130":52809,"_5":13154,"_26074":52398,"_2645":52810},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3146":2555,"_27538":2397,"_19130":52812,"_5":13154,"_26074":52406,"_2645":52813},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3146":2556,"_27538":2397,"_19130":52815,"_5":13154,"_26074":52406,"_2645":52816},[],"Field in 3.8.0",{"_3146":2557,"_27538":2397,"_19130":52818,"_5":13154,"_26074":52406,"_2645":52819},[],"Field in 4.0.0",{"_3146":2558,"_27538":2397,"_19130":52821,"_5":13154,"_26074":52406,"_2645":52822},[],"`validate_server_cert`",{"_3146":2559,"_27538":2397,"_19130":52824,"_5":13154,"_26074":52406,"_2645":52825},[],"`insecure_skip_verify` (value negated)",{"_3146":2560,"_27538":2397,"_19130":52827,"_5":13154,"_26074":52406,"_2645":52828},[],"`oidc`",{"_3146":2561,"_27538":2397,"_19130":52830,"_5":13154,"_26074":52406,"_2645":52831},[],"`jwt_options`",{"_3146":2562,"_27538":2397,"_19130":52833,"_5":13154,"_26074":52406,"_2645":52834},[],"`apikey`",{"_3146":2563,"_27538":2397,"_19130":52836,"_5":13154,"_26074":52406,"_2645":52837},[],"`apikey_options`",{"_3146":2564,"_27538":2397,"_19130":52839,"_5":13154,"_26074":52406,"_2645":52840},[],"`mtls`",{"_3146":2565,"_27538":2397,"_19130":52842,"_5":13154,"_26074":52406,"_2645":52843},[],"`mtls_options`",{"_3146":2566,"_27538":2397,"_19130":52845,"_5":13154,"_26074":52406,"_2645":52846},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3146":2567,"_27538":2397,"_19130":52848,"_5":13154,"_26074":52406,"_2645":52849},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3146":2568,"_27538":2397,"_19130":52851,"_5":13154,"_26074":52406,"_2645":52852},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3146":2569,"_27538":2397,"_19130":52854,"_5":13154,"_26074":52410,"_2645":52855},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3146":2570,"_27538":2397,"_19130":52857,"_5":13154,"_26074":52410,"_2645":52858},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3146":2571,"_27538":2397,"_19130":52860,"_5":13154,"_26074":52410,"_2645":52861},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3146":2572,"_27538":2397,"_19130":52863,"_5":13154,"_26074":52414,"_2645":52864},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API.",{"_3146":2573,"_27538":2397,"_19130":52866,"_5":13154,"_26074":52418,"_2645":52867},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3146":2574,"_27538":2397,"_19130":52869,"_5":13154,"_26074":52422,"_2645":52870},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3146":2575,"_27538":2397,"_19130":52872,"_5":13154,"_26074":52426,"_2645":52873},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3146":2576,"_27538":2397,"_19130":52875,"_5":13154,"_26074":52426,"_2645":52876},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3146":2577,"_27538":2397,"_19130":52878,"_5":13154,"_26074":52426,"_2645":52879},[],"`POST /v1/devices/:id/events` creates an event.",{"_3146":2578,"_27538":2397,"_19130":52881,"_5":13154,"_26074":52426,"_2645":52882},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3146":2579,"_27538":2397,"_19130":52884,"_5":13154,"_26074":52430,"_2645":52885},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3146":2580,"_27538":2397,"_19130":52887,"_5":13154,"_26074":52434,"_2645":52888},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3146":2581,"_27538":2397,"_19130":52890,"_5":13154,"_26074":52434,"_2645":52891},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3146":2582,"_27538":2397,"_19130":52893,"_5":13154,"_26074":52434,"_2645":52894},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3146":2583,"_27538":2397,"_19130":52896,"_5":13154,"_26074":52434,"_2645":52897},[],"Record the names of your local-storage PVCs:",{"_3146":2584,"_27538":2397,"_19130":52899,"_5":13154,"_26074":52434,"_2645":52900},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3146":2585,"_27538":2397,"_19130":52902,"_5":13154,"_26074":52438,"_2645":52903},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3146":2586,"_27538":2397,"_19130":52905,"_5":13154,"_26074":52438,"_2645":52906},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3146":2587,"_27538":2397,"_19130":52908,"_5":13154,"_26074":52438,"_2645":52909},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3146":2588,"_27538":2397,"_19130":52911,"_5":13154,"_26074":52438,"_2645":52912},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3146":2589,"_27538":2397,"_19130":52914,"_5":13154,"_26074":52438,"_2645":52915},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3146":2590,"_27538":2397,"_19130":52917,"_5":13154,"_26074":52438,"_2645":52918},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3146":2591,"_27538":2397,"_19130":52920,"_5":13154,"_26074":52438,"_2645":52921},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3146":2592,"_27538":2397,"_19130":52923,"_5":13154,"_26074":52438,"_2645":52924},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3146":2593,"_27538":2397,"_19130":52926,"_5":13154,"_26074":52438,"_2645":52927},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3146":2594,"_27538":2397,"_19130":52929,"_5":13154,"_26074":52438,"_2645":52930},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3146":2595,"_27538":2397,"_19130":52932,"_5":13154,"_26074":52438,"_2645":52933},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3146":2596,"_27538":2397,"_19130":52935,"_5":13154,"_26074":52438,"_2645":52936},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3146":2597,"_27538":2397,"_19130":52938,"_5":13154,"_26074":52442,"_2645":52939},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run. If the deployment uses local KMS or VA storage, those pods fail until you complete step 4.",{"_3146":2598,"_27538":2397,"_19130":52941,"_5":13154,"_26074":52446,"_2645":52942},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3146":2599,"_27538":2397,"_19130":52944,"_5":13154,"_26074":52446,"_2645":52945},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3146":2600,"_27538":2397,"_19130":52947,"_5":13154,"_26074":52446,"_2645":52948},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3146":2601,"_27538":2397,"_19130":52950,"_5":13154,"_26074":52446,"_2645":52951},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3146":2602,"_27538":2397,"_19130":52953,"_5":13154,"_26074":52446,"_2645":52954},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3146":2603,"_27538":2397,"_19130":52956,"_5":13154,"_26074":52446,"_2645":52957},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3146":2604,"_27538":2397,"_19130":52959,"_5":13154,"_26074":52446,"_2645":52960},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3146":2605,"_27538":2397,"_19130":52962,"_5":13154,"_26074":52446,"_2645":52963},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3146":2606,"_27538":2397,"_19130":52965,"_5":13154,"_26074":52446,"_2645":52966},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3146":2607,"_27538":2397,"_19130":52968,"_5":13154,"_26074":52446,"_2645":52969},[],"**Remove the helper and restore the recorded replica counts:**",{"_3146":2608,"_27538":2397,"_19130":52971,"_5":13154,"_26074":52450,"_2645":52972},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3146":2609,"_27538":2397,"_19130":52974,"_5":13154,"_26074":52450,"_2645":52975},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3146":2610,"_27538":2397,"_19130":52977,"_5":13154,"_26074":52454,"_2645":52978},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3146":2611,"_27538":2397,"_19130":52980,"_5":13154,"_26074":52454,"_2645":52981},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3146":2612,"_27538":2397,"_19130":52983,"_5":13154,"_26074":52454,"_2645":52984},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3146":2613,"_27538":2397,"_19130":52986,"_5":13154,"_26074":52454,"_2645":52987},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3146":2614,"_27538":2397,"_19130":52989,"_5":13154,"_26074":52454,"_2645":52990},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3146":2615,"_27538":2397,"_19130":52992,"_5":13154,"_26074":52458,"_2645":52993},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3146":2616,"_27538":2397,"_19130":52995,"_5":13154,"_26074":52458,"_2645":52996},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3146":2617,"_27538":2397,"_19130":52998,"_5":13154,"_26074":52458,"_2645":52999},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3146":2618,"_27538":2397,"_19130":53001,"_5":13154,"_26074":52458,"_2645":53002},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3146":2619,"_27538":2397,"_19130":53004,"_5":13154,"_26074":52458,"_2645":53005},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3146":2620,"_27538":2397,"_19130":53007,"_5":13154,"_26074":52458,"_2645":53008},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3146":2621,"_27538":2397,"_19130":53010,"_5":13154,"_26074":52461,"_2645":53011},[],"After the upgrade, check in this order:",{"_3146":2622,"_27538":2397,"_19130":53013,"_5":13154,"_26074":52461,"_2645":53014},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3146":2623,"_27538":2397,"_19130":53016,"_5":13154,"_26074":52461,"_2645":53017},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3146":2624,"_27538":2397,"_19130":53019,"_5":13154,"_26074":52461,"_2645":53020},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3146":2625,"_27538":2397,"_19130":53022,"_5":13154,"_26074":52461,"_2645":53023},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3146":2626,"_27538":2397,"_19130":53025,"_5":13154,"_26074":52461,"_2645":53026},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3146":2627,"_27538":2397,"_19130":53028,"_5":13154,"_26074":52461,"_2645":53029},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3146":2628,"_27538":2397,"_19130":53031,"_5":13154,"_26074":52461,"_2645":53032},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3146":2629,"_27538":2397,"_19130":53034,"_5":13154,"_26074":52461,"_2645":53035},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3146":2630,"_27538":2397,"_19130":53037,"_5":13154,"_26074":52461,"_2645":53038},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3146":2631,"_27538":2397,"_19130":53040,"_5":13154,"_26074":52461,"_2645":53041},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3146":2632,"_27538":2397,"_19130":53043,"_5":13154,"_26074":52461,"_2645":53044},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3146":2633,"_27538":2397,"_19130":53046,"_5":13154,"_26074":52461,"_2645":53047},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3146":2634,"_27538":2397,"_19130":53049,"_5":13154,"_26074":52461,"_2645":53050},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3146":2635,"_27538":2397,"_19130":53052,"_5":13154,"_26074":52461,"_2645":53053},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3146":2636,"_27538":2397,"_19130":53055,"_5":13154,"_26074":52465,"_2645":53056},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy:",{"_3146":2637,"_27538":2397,"_19130":53058,"_5":13154,"_26074":52465,"_2645":53059},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3146":2638,"_27538":2397,"_19130":53061,"_5":13154,"_26074":52465,"_2645":53062},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3146":2639,"_27538":2397,"_19130":53064,"_5":13154,"_26074":52465,"_2645":53065},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3146":2640,"_27538":2397,"_19130":53067,"_5":13154,"_26074":52465,"_2645":53068},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53071":53072,"_53073":53074,"_53075":53076,"_53077":53078,"_16676":2667,"_63596":2667},"language","english","sortableProperties",[2645,27538,5,26074],"sortablePropertiesWithTypes",{"_2645":22875,"_27538":22875,"_5":22875,"_26074":22875},"sorts",{"_2645":53079,"_27538":55709,"_5":58338,"_26074":60967},{"_4210":53080,"_53081":53082,"_5":22875},{"_13209":6852,"_13579":10361,"_13586":7527,"_11855":4294,"_26200":5414,"_18164":4918,"_13230":5412,"_13237":3208,"_26627":6886,"_27014":3827,"_27035":3694,"_26645":4160,"_31645":3673,"_27046":5611,"_27075":5303,"_31652":19622,"_31655":7495,"_31658":4116,"_31661":3101,"_27397":5431,"_31666":4142,"_31668":20089,"_27427":6850,"_27387":5616,"_31672":21750,"_27596":5378,"_31676":4337,"_27064":2720,"_27392":6697,"_