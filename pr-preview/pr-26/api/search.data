545,"_2447":42087,"_26339":42088,"_18071":42092,"_24599":15},"Deploy from AWS Marketplace",[42089,42090,42091],"Docs","Deployment","Other models",[],{"_2937":16,"_26000":15,"_18071":42094,"_5":17966,"_24599":15,"_2447":42095},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2937":17,"_26000":15,"_5":26336,"_18071":42097,"_24599":42098,"_2447":42099},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2937":18,"_26000":15,"_5":26336,"_18071":42101,"_24599":42102,"_2447":42103},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2937":19,"_26000":15,"_5":26336,"_18071":42105,"_24599":42106,"_2447":42107},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2937":20,"_26000":15,"_5":26336,"_18071":42109,"_24599":42110,"_2447":42111},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2937":21,"_26000":15,"_5":26336,"_18071":42113,"_24599":42114,"_2447":42115},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2937":22,"_26000":15,"_5":26336,"_18071":42117,"_24599":42118,"_2447":42119},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2937":23,"_26000":15,"_5":26336,"_18071":42121,"_24599":42122,"_2447":42123},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#next-step","Next step",{"_2937":24,"_26000":15,"_18071":42125,"_5":17966,"_24599":15,"_2447":42126},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2937":25,"_26000":15,"_18071":42128,"_5":17966,"_24599":42098,"_2447":42129},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2937":26,"_26000":15,"_18071":42131,"_5":17966,"_24599":42098,"_2447":42132},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2937":27,"_26000":15,"_18071":42134,"_5":17966,"_24599":42098,"_2447":42135},[],"A security group allowing the necessary endpoints.",{"_2937":28,"_26000":15,"_18071":42137,"_5":17966,"_24599":42102,"_2447":42138},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2937":29,"_26000":15,"_18071":42140,"_5":17966,"_24599":42102,"_2447":42141},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2937":30,"_26000":15,"_18071":42143,"_5":17966,"_24599":42102,"_2447":42144},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2937":31,"_26000":15,"_18071":42146,"_5":17966,"_24599":42106,"_2447":42147},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2937":32,"_26000":15,"_18071":42149,"_5":17966,"_24599":42110,"_2447":42150},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2937":33,"_26000":15,"_18071":42152,"_5":17966,"_24599":42114,"_2447":42153},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2937":34,"_26000":15,"_18071":42155,"_5":17966,"_24599":42118,"_2447":42156},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2937":35,"_26000":15,"_18071":42158,"_5":17966,"_24599":42122,"_2447":42159},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2937":36,"_26000":36,"_5":12545,"_2447":42161,"_26339":42162,"_18071":42163,"_24599":36},"Deploy Lamassu",[42089,42090],[],{"_2937":37,"_26000":36,"_18071":42165,"_5":17966,"_24599":36,"_2447":42166},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2937":38,"_26000":36,"_5":26336,"_18071":42168,"_24599":42169,"_2447":42170},[],"/docs/pr-preview/pr-26/deployment/overview#choose-a-model","Choose a model",{"_2937":39,"_26000":36,"_5":26336,"_18071":42172,"_24599":42173,"_2447":42174},[],"/docs/pr-preview/pr-26/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2937":40,"_26000":36,"_5":26336,"_18071":42176,"_24599":42177,"_2447":42178},[],"/docs/pr-preview/pr-26/deployment/overview#after-deployment","After deployment",{"_2937":41,"_26000":36,"_18071":42180,"_5":17966,"_24599":36,"_2447":42181},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2937":42,"_26000":36,"_18071":42183,"_5":17966,"_24599":42169,"_2447":42184},[],"Model",{"_2937":43,"_26000":36,"_18071":42186,"_5":17966,"_24599":42169,"_2447":42187},[],"Recommended for",{"_2937":44,"_26000":36,"_18071":42189,"_5":17966,"_24599":42169,"_2447":42190},[],"Who operates the infrastructure",{"_2937":45,"_26000":36,"_18071":42192,"_5":17966,"_24599":42169,"_2447":42193},[],"Starting point",{"_2937":46,"_26000":36,"_18071":42195,"_5":17966,"_24599":42169,"_2447":42196},[],"Kubernetes self-managed",{"_2937":47,"_26000":36,"_18071":42198,"_5":17966,"_24599":42169,"_2447":42199},[],"Production, regulated environments and custom deployments",{"_2937":48,"_26000":36,"_18071":42201,"_5":17966,"_24599":42169,"_2447":42202},[],"Your team",{"_2937":49,"_26000":36,"_18071":42204,"_5":17966,"_24599":42169,"_2447":42205},[],"Helm or Fastlane",{"_2937":50,"_26000":36,"_18071":42207,"_5":17966,"_24599":42169,"_2447":42208},[],"AWS Marketplace",{"_2937":51,"_26000":36,"_18071":42210,"_5":17966,"_24599":42169,"_2447":42211},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2937":52,"_26000":36,"_18071":42213,"_5":17966,"_24599":42169,"_2447":42202},[],{"_2937":53,"_26000":36,"_18071":42215,"_5":17966,"_24599":42169,"_2447":42216},[],"Preconfigured image on EC2",{"_2937":54,"_26000":36,"_18071":42218,"_5":17966,"_24599":42169,"_2447":42219},[],"SaaS",{"_2937":55,"_26000":36,"_18071":42221,"_5":17966,"_24599":42169,"_2447":42222},[],"Teams that want to use the platform without operating it",{"_2937":56,"_26000":36,"_18071":42224,"_5":17966,"_24599":42169,"_2447":42225},[],"Lamassu",{"_2937":57,"_26000":36,"_18071":42227,"_5":17966,"_24599":42169,"_2447":42228},[],"Managed subscription",{"_2937":58,"_26000":36,"_18071":42230,"_5":17966,"_24599":42169,"_2447":42231},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2937":59,"_26000":36,"_18071":42233,"_5":17966,"_24599":42169,"_2447":42234},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2937":60,"_26000":36,"_18071":42236,"_5":17966,"_24599":42169,"_2447":42237},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2937":61,"_26000":36,"_18071":42239,"_5":17966,"_24599":42173,"_2447":42240},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2937":62,"_26000":36,"_18071":42242,"_5":17966,"_24599":42177,"_2447":42243},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2937":63,"_26000":63,"_5":12545,"_2447":42245,"_26339":42246,"_18071":42247,"_24599":63},"Use Lamassu as SaaS",[42089,42090,42091],[],{"_2937":64,"_26000":63,"_18071":42249,"_5":17966,"_24599":63,"_2447":42250},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2937":65,"_26000":63,"_5":26336,"_18071":42252,"_24599":42253,"_2447":42254},[],"/docs/pr-preview/pr-26/deployment/saas#what-the-service-manages","What the service manages",{"_2937":66,"_26000":63,"_5":26336,"_18071":42256,"_24599":42257,"_2447":42258},[],"/docs/pr-preview/pr-26/deployment/saas#plans","Plans",{"_2937":67,"_26000":63,"_5":26336,"_18071":42260,"_24599":42261,"_2447":42262},[],"/docs/pr-preview/pr-26/deployment/saas#request-access","Request access",{"_2937":68,"_26000":63,"_18071":42264,"_5":17966,"_24599":63,"_2447":42265},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2937":69,"_26000":63,"_18071":42267,"_5":17966,"_24599":42253,"_2447":42268},[],"Platform availability and maintenance.",{"_2937":70,"_26000":63,"_18071":42270,"_5":17966,"_24599":42253,"_2447":42271},[],"Automatic backups.",{"_2937":71,"_26000":63,"_18071":42273,"_5":17966,"_24599":42253,"_2447":42274},[],"Version upgrades.",{"_2937":72,"_26000":63,"_18071":42276,"_5":17966,"_24599":42253,"_2447":42277},[],"Technical support and SLA according to your plan.",{"_2937":73,"_26000":63,"_18071":42279,"_5":17966,"_24599":42257,"_2447":42280},[],"Plan",{"_2937":74,"_26000":63,"_18071":42282,"_5":17966,"_24599":42257,"_2447":42283},[],"Devices",{"_2937":75,"_26000":63,"_18071":42285,"_5":17966,"_24599":42257,"_2447":42286},[],"Support",{"_2937":76,"_26000":63,"_18071":42288,"_5":17966,"_24599":42257,"_2447":42289},[],"SLA",{"_2937":77,"_26000":63,"_18071":42291,"_5":17966,"_24599":42257,"_2447":42292},[],"Starter",{"_2937":78,"_26000":63,"_18071":42294,"_5":17966,"_24599":42257,"_2447":42295},[],"Up to 1,000",{"_2937":79,"_26000":63,"_18071":42297,"_5":17966,"_24599":42257,"_2447":42298},[],"Email",{"_2937":80,"_26000":63,"_18071":42300,"_5":17966,"_24599":42257,"_2447":42301},[],"99.5 %",{"_2937":81,"_26000":63,"_18071":42303,"_5":17966,"_24599":42257,"_2447":42304},[],"Professional",{"_2937":82,"_26000":63,"_18071":42306,"_5":17966,"_24599":42257,"_2447":42307},[],"Up to 10,000",{"_2937":83,"_26000":63,"_18071":42309,"_5":17966,"_24599":42257,"_2447":42310},[],"Email and chat",{"_2937":84,"_26000":63,"_18071":42312,"_5":17966,"_24599":42257,"_2447":42313},[],"99.9 %",{"_2937":85,"_26000":63,"_18071":42315,"_5":17966,"_24599":42257,"_2447":42316},[],"Enterprise",{"_2937":86,"_26000":63,"_18071":42318,"_5":17966,"_24599":42257,"_2447":42319},[],"Unlimited",{"_2937":87,"_26000":63,"_18071":42321,"_5":17966,"_24599":42257,"_2447":42322},[],"Dedicated",{"_2937":88,"_26000":63,"_18071":42324,"_5":17966,"_24599":42257,"_2447":42325},[],"99.99 %",{"_2937":89,"_26000":63,"_18071":42327,"_5":17966,"_24599":42261,"_2447":42328},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2937":90,"_26000":63,"_18071":42330,"_5":17966,"_24599":42261,"_2447":42331},[],"When you receive your instance's credentials, continue with Get started.",{"_2937":91,"_26000":91,"_5":12545,"_2447":42333,"_26339":42334,"_18071":42335,"_24599":91},"Fastlane",[42089,42090,42196],[],{"_2937":92,"_26000":91,"_18071":42337,"_5":17966,"_24599":91,"_2447":42338},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2937":93,"_26000":91,"_5":26336,"_18071":42340,"_24599":42341,"_2447":42342},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2937":94,"_26000":91,"_5":26336,"_18071":42344,"_24599":42345,"_2447":42346},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2937":95,"_26000":91,"_5":26336,"_18071":42348,"_24599":42349,"_2447":42099},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#before-you-begin",{"_2937":96,"_26000":91,"_5":26336,"_18071":42351,"_24599":42352,"_2447":42353},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2937":97,"_26000":91,"_5":26336,"_18071":42355,"_24599":42356,"_2447":42357},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2937":98,"_26000":91,"_5":26336,"_18071":42359,"_24599":42360,"_2447":42361},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2937":99,"_26000":91,"_5":26336,"_18071":42363,"_24599":42364,"_2447":42365},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2937":100,"_26000":91,"_5":26336,"_18071":42367,"_24599":42368,"_2447":42369},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2937":101,"_26000":91,"_5":26336,"_18071":42371,"_24599":42372,"_2447":42373},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2937":102,"_26000":91,"_5":26336,"_18071":42375,"_24599":42376,"_2447":42377},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2937":103,"_26000":91,"_18071":42379,"_5":17966,"_24599":42341,"_2447":42380},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2937":104,"_26000":91,"_18071":42382,"_5":17966,"_24599":42341,"_2447":42383},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2937":105,"_26000":91,"_18071":42385,"_5":17966,"_24599":42345,"_2447":42386},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2937":106,"_26000":91,"_18071":42388,"_5":17966,"_24599":42345,"_2447":42389},[],"Fastlane installs or configures",{"_2937":107,"_26000":91,"_18071":42391,"_5":17966,"_24599":42345,"_2447":42392},[],"You still provide",{"_2937":108,"_26000":91,"_18071":42394,"_5":17966,"_24599":42345,"_2447":42395},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2937":109,"_26000":91,"_18071":42397,"_5":17966,"_24599":42345,"_2447":42398},[],"The Kubernetes cluster, nodes and persistent storage",{"_2937":110,"_26000":91,"_18071":42400,"_5":17966,"_24599":42345,"_2447":42401},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2937":111,"_26000":91,"_18071":42403,"_5":17966,"_24599":42345,"_2447":42404},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2937":112,"_26000":91,"_18071":42406,"_5":17966,"_24599":42345,"_2447":42407},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2937":113,"_26000":91,"_18071":42409,"_5":17966,"_24599":42345,"_2447":42410},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2937":114,"_26000":91,"_18071":42412,"_5":17966,"_24599":42345,"_2447":42413},[],"Optional observability and lab HSM components",{"_2937":115,"_26000":91,"_18071":42415,"_5":17966,"_24599":42345,"_2447":42416},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2937":116,"_26000":91,"_18071":42418,"_5":17966,"_24599":42345,"_2447":42419},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2937":117,"_26000":91,"_18071":42421,"_5":17966,"_24599":42349,"_2447":42422},[],"You need:",{"_2937":118,"_26000":91,"_18071":42424,"_5":17966,"_24599":42349,"_2447":42425},[],"an existing Kubernetes cluster",{"_2937":119,"_26000":91,"_18071":42427,"_5":17966,"_24599":42349,"_2447":42428},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2937":120,"_26000":91,"_18071":42430,"_5":17966,"_24599":42349,"_2447":42431},[],"`yq`",{"_2937":121,"_26000":91,"_18071":42433,"_5":17966,"_24599":42349,"_2447":20455},[],{"_2937":122,"_26000":91,"_18071":42435,"_5":17966,"_24599":42349,"_2447":42436},[],"`jq` only when using `--sample-data`",{"_2937":123,"_26000":91,"_18071":42438,"_5":17966,"_24599":42349,"_2447":42439},[],"`ssh-keygen` only when using `--with-hsm`",{"_2937":124,"_26000":91,"_18071":42441,"_5":17966,"_24599":42349,"_2447":42442},[],"free external ports 80 and 443 on a single-node K3s host",{"_2937":125,"_26000":91,"_18071":42444,"_5":17966,"_24599":42349,"_2447":42445},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2937":126,"_26000":91,"_18071":42447,"_5":17966,"_24599":42349,"_2447":42448},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2937":127,"_26000":91,"_18071":42450,"_5":17966,"_24599":42352,"_2447":42451},[],"Run the script from a clone of the Helm repository:",{"_2937":128,"_26000":91,"_18071":42453,"_5":17966,"_24599":42352,"_2447":42454},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2937":129,"_26000":91,"_18071":42456,"_5":17966,"_24599":42356,"_2447":42457},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2937":130,"_26000":91,"_18071":42459,"_5":17966,"_24599":42356,"_2447":42460},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2937":131,"_26000":91,"_18071":42462,"_5":17966,"_24599":42356,"_2447":42463},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2937":132,"_26000":91,"_18071":42465,"_5":17966,"_24599":42356,"_2447":42466},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2937":133,"_26000":91,"_18071":42468,"_5":17966,"_24599":42360,"_2447":42469},[],"Option",{"_2937":134,"_26000":91,"_18071":42471,"_5":17966,"_24599":42360,"_2447":42472},[],"Default",{"_2937":135,"_26000":91,"_18071":42474,"_5":17966,"_24599":42360,"_2447":42475},[],"Purpose",{"_2937":136,"_26000":91,"_18071":42477,"_5":17966,"_24599":42360,"_2447":42478},[],"`-h`, `--help`",{"_2937":137,"_26000":91,"_18071":42480,"_5":17966,"_24599":42360,"_2447":42481},[],"—",{"_2937":138,"_26000":91,"_18071":42483,"_5":17966,"_24599":42360,"_2447":42484},[],"Show help",{"_2937":139,"_26000":91,"_18071":42486,"_5":17966,"_24599":42360,"_2447":42487},[],"`-c`, `--context`",{"_2937":140,"_26000":91,"_18071":42489,"_5":17966,"_24599":42360,"_2447":42490},[],"current context",{"_2937":141,"_26000":91,"_18071":42492,"_5":17966,"_24599":42360,"_2447":42493},[],"Select the kubeconfig context for kubectl and Helm",{"_2937":142,"_26000":91,"_18071":42495,"_5":17966,"_24599":42360,"_2447":42496},[],"`-n`, `--non-interactive`",{"_2937":143,"_26000":91,"_18071":42498,"_5":17966,"_24599":42360,"_2447":5522},[],{"_2937":144,"_26000":91,"_18071":42500,"_5":17966,"_24599":42360,"_2447":42501},[],"Skip prompts and generate dependency credentials",{"_2937":145,"_26000":91,"_18071":42503,"_5":17966,"_24599":42360,"_2447":42504},[],"`-ns`, `--namespace`",{"_2937":146,"_26000":91,"_18071":42506,"_5":17966,"_24599":42360,"_2447":42507},[],"`lamassu-dev`",{"_2937":147,"_26000":91,"_18071":42509,"_5":17966,"_24599":42360,"_2447":42510},[],"Namespace for the installation",{"_2937":148,"_26000":91,"_18071":42512,"_5":17966,"_24599":42360,"_2447":42513},[],"`-d`, `--domain`",{"_2937":149,"_26000":91,"_18071":42515,"_5":17966,"_24599":42360,"_2447":42516},[],"`dev.lamassu.io`",{"_2937":150,"_26000":91,"_18071":42518,"_5":17966,"_24599":42360,"_2447":42519},[],"Domain used by the UI, OIDC and certificate",{"_2937":151,"_26000":91,"_18071":42521,"_5":17966,"_24599":42360,"_2447":42522},[],"`-v`, `--version`",{"_2937":152,"_26000":91,"_18071":42524,"_5":17966,"_24599":42360,"_2447":12950},[],{"_2937":153,"_26000":91,"_18071":42526,"_5":17966,"_24599":42360,"_2447":42527},[],"Lamassu chart version",{"_2937":154,"_26000":91,"_18071":42529,"_5":17966,"_24599":42360,"_2447":42530},[],"`--https-port`",{"_2937":155,"_26000":91,"_18071":42532,"_5":17966,"_24599":42360,"_2447":42533},[],"`443`",{"_2937":156,"_26000":91,"_18071":42535,"_5":17966,"_24599":42360,"_2447":42536},[],"Gateway HTTPS listener port",{"_2937":157,"_26000":91,"_18071":42538,"_5":17966,"_24599":42360,"_2447":42539},[],"`--http-port`",{"_2937":158,"_26000":91,"_18071":42541,"_5":17966,"_24599":42360,"_2447":42542},[],"`80`",{"_2937":159,"_26000":91,"_18071":42544,"_5":17966,"_24599":42360,"_2447":42545},[],"Gateway HTTP listener port",{"_2937":160,"_26000":91,"_18071":42547,"_5":17966,"_24599":42360,"_2447":42548},[],"`--tls-crt`",{"_2937":161,"_26000":91,"_18071":42550,"_5":17966,"_24599":42360,"_2447":42481},[],{"_2937":162,"_26000":91,"_18071":42552,"_5":17966,"_24599":42360,"_2447":42553},[],"PEM certificate for downstream TLS",{"_2937":163,"_26000":91,"_18071":42555,"_5":17966,"_24599":42360,"_2447":42556},[],"`--tls-key`",{"_2937":164,"_26000":91,"_18071":42558,"_5":17966,"_24599":42360,"_2447":42481},[],{"_2937":165,"_26000":91,"_18071":42560,"_5":17966,"_24599":42360,"_2447":42561},[],"PEM private key for downstream TLS",{"_2937":166,"_26000":91,"_18071":42563,"_5":17966,"_24599":42360,"_2447":42564},[],"`-l`, `--local-chart-path`",{"_2937":167,"_26000":91,"_18071":42566,"_5":17966,"_24599":42360,"_2447":42567},[],"repository chart",{"_2937":168,"_26000":91,"_18071":42569,"_5":17966,"_24599":42360,"_2447":42570},[],"Use an unpacked local Lamassu chart",{"_2937":169,"_26000":91,"_18071":42572,"_5":17966,"_24599":42360,"_2447":42573},[],"`-ip`, `--gateway-ip`",{"_2937":170,"_26000":91,"_18071":42575,"_5":17966,"_24599":42360,"_2447":7471},[],{"_2937":171,"_26000":91,"_18071":42577,"_5":17966,"_24599":42360,"_2447":42578},[],"Override the address written to `gateway.addresses`",{"_2937":172,"_26000":91,"_18071":42580,"_5":17966,"_24599":42360,"_2447":42581},[],"`--otel`",{"_2937":173,"_26000":91,"_18071":42583,"_5":17966,"_24599":42360,"_2447":5522},[],{"_2937":174,"_26000":91,"_18071":42585,"_5":17966,"_24599":42360,"_2447":42586},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2937":175,"_26000":91,"_18071":42588,"_5":17966,"_24599":42360,"_2447":42589},[],"`--sample-data`",{"_2937":176,"_26000":91,"_18071":42591,"_5":17966,"_24599":42360,"_2447":5522},[],{"_2937":177,"_26000":91,"_18071":42593,"_5":17966,"_24599":42360,"_2447":42594},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2937":178,"_26000":91,"_18071":42596,"_5":17966,"_24599":42360,"_2447":42597},[],"`--with-hsm`",{"_2937":179,"_26000":91,"_18071":42599,"_5":17966,"_24599":42360,"_2447":5522},[],{"_2937":180,"_26000":91,"_18071":42601,"_5":17966,"_24599":42360,"_2447":42602},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2937":181,"_26000":91,"_18071":42604,"_5":17966,"_24599":42360,"_2447":42605},[],"`--softhsm-chart-path`",{"_2937":182,"_26000":91,"_18071":42607,"_5":17966,"_24599":42360,"_2447":42608},[],"`./charts/softhsm`",{"_2937":183,"_26000":91,"_18071":42610,"_5":17966,"_24599":42360,"_2447":42611},[],"Use a different local SoftHSM chart",{"_2937":184,"_26000":91,"_18071":42613,"_5":17966,"_24599":42360,"_2447":42614},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2937":185,"_26000":91,"_18071":42616,"_5":17966,"_24599":42364,"_2447":42617},[],"Fastlane:",{"_2937":186,"_26000":91,"_18071":42619,"_5":17966,"_24599":42364,"_2447":42620},[],"validates local tools and the selected cluster",{"_2937":187,"_26000":91,"_18071":42622,"_5":17966,"_24599":42364,"_2447":42623},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2937":188,"_26000":91,"_18071":42625,"_5":17966,"_24599":42364,"_2447":42626},[],"creates the namespace",{"_2937":189,"_26000":91,"_18071":42628,"_5":17966,"_24599":42364,"_2447":42629},[],"installs PostgreSQL and creates the required databases",{"_2937":190,"_26000":91,"_18071":42631,"_5":17966,"_24599":42364,"_2447":42632},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2937":191,"_26000":91,"_18071":42634,"_5":17966,"_24599":42364,"_2447":42635},[],"installs RabbitMQ",{"_2937":192,"_26000":91,"_18071":42637,"_5":17966,"_24599":42364,"_2447":42638},[],"optionally installs observability and lab HSM components",{"_2937":193,"_26000":91,"_18071":42640,"_5":17966,"_24599":42364,"_2447":42641},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2937":194,"_26000":91,"_18071":42643,"_5":17966,"_24599":42364,"_2447":42644},[],"optionally loads sample data",{"_2937":195,"_26000":91,"_18071":42646,"_5":17966,"_24599":42364,"_2447":42647},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2937":196,"_26000":91,"_18071":42649,"_5":17966,"_24599":42368,"_2447":42650},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2937":197,"_26000":91,"_18071":42652,"_5":17966,"_24599":42368,"_2447":42653},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2937":198,"_26000":91,"_18071":42655,"_5":17966,"_24599":42372,"_2447":42656},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2937":199,"_26000":91,"_18071":42658,"_5":17966,"_24599":42372,"_2447":42659},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2937":200,"_26000":91,"_18071":42661,"_5":17966,"_24599":42372,"_2447":42662},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2937":201,"_26000":91,"_18071":42664,"_5":17966,"_24599":42376,"_2447":42665},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2937":202,"_26000":202,"_5":12545,"_2447":42667,"_26339":42668,"_18071":42669,"_24599":202},"Install with Helm",[42089,42090,42196],[],{"_2937":203,"_26000":202,"_18071":42671,"_5":17966,"_24599":202,"_2447":42672},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2937":204,"_26000":202,"_5":26336,"_18071":42674,"_24599":42675,"_2447":42676},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2937":205,"_26000":202,"_5":26336,"_18071":42678,"_24599":42679,"_2447":42099},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#before-you-begin",{"_2937":206,"_26000":202,"_5":26336,"_18071":42681,"_24599":42682,"_2447":42683},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2937":207,"_26000":202,"_5":26336,"_18071":42685,"_24599":42686,"_2447":42687},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2937":208,"_26000":202,"_5":26336,"_18071":42689,"_24599":42690,"_2447":42691},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2937":209,"_26000":202,"_5":26336,"_18071":42693,"_24599":42694,"_2447":42695},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2937":210,"_26000":202,"_5":26336,"_18071":42697,"_24599":42698,"_2447":42699},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2937":211,"_26000":202,"_5":26336,"_18071":42701,"_24599":42702,"_2447":42703},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2937":212,"_26000":202,"_5":26336,"_18071":42705,"_24599":42706,"_2447":42707},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2937":213,"_26000":202,"_18071":42709,"_5":17966,"_24599":42675,"_2447":42710},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2937":214,"_26000":202,"_18071":42712,"_5":17966,"_24599":42679,"_2447":42713},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2937":215,"_26000":202,"_18071":42715,"_5":17966,"_24599":42679,"_2447":42716},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2937":216,"_26000":202,"_18071":42718,"_5":17966,"_24599":42679,"_2447":42719},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2937":217,"_26000":202,"_18071":42721,"_5":17966,"_24599":42679,"_2447":42722},[],"a reachable RabbitMQ broker and credentials",{"_2937":218,"_26000":202,"_18071":42724,"_5":17966,"_24599":42679,"_2447":42725},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2937":219,"_26000":202,"_18071":42727,"_5":17966,"_24599":42679,"_2447":42728},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2937":220,"_26000":202,"_18071":42730,"_5":17966,"_24599":42679,"_2447":42731},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2937":221,"_26000":202,"_18071":42733,"_5":17966,"_24599":42679,"_2447":42734},[],"a StorageClass and an external traffic design",{"_2937":222,"_26000":202,"_18071":42736,"_5":17966,"_24599":42679,"_2447":42737},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2937":223,"_26000":202,"_18071":42739,"_5":17966,"_24599":42679,"_2447":42740},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2937":224,"_26000":202,"_18071":42742,"_5":17966,"_24599":42679,"_2447":42743},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2937":225,"_26000":202,"_18071":42745,"_5":17966,"_24599":42682,"_2447":42746},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2937":226,"_26000":202,"_18071":42748,"_5":17966,"_24599":42682,"_2447":42749},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2937":227,"_26000":202,"_18071":42751,"_5":17966,"_24599":42682,"_2447":42752},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2937":228,"_26000":202,"_18071":42754,"_5":17966,"_24599":42686,"_2447":42755},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2937":229,"_26000":202,"_18071":42757,"_5":17966,"_24599":42686,"_2447":42758},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2937":230,"_26000":202,"_18071":42760,"_5":17966,"_24599":42686,"_2447":42761},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2937":231,"_26000":202,"_18071":42763,"_5":17966,"_24599":42690,"_2447":42764},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2937":232,"_26000":202,"_18071":42766,"_5":17966,"_24599":42694,"_2447":42767},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2937":233,"_26000":202,"_18071":42769,"_5":17966,"_24599":42694,"_2447":42770},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2937":234,"_26000":202,"_18071":42772,"_5":17966,"_24599":42694,"_2447":42773},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2937":235,"_26000":202,"_18071":42775,"_5":17966,"_24599":42694,"_2447":42776},[],"See Access control for the principal and policy model.",{"_2937":236,"_26000":202,"_18071":42778,"_5":17966,"_24599":42698,"_2447":42779},[],"To install a local checkout instead:",{"_2937":237,"_26000":202,"_18071":42781,"_5":17966,"_24599":42702,"_2447":42782},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2937":238,"_26000":202,"_18071":42784,"_5":17966,"_24599":42702,"_2447":42785},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2937":239,"_26000":202,"_18071":42787,"_5":17966,"_24599":42706,"_2447":42788},[],"Before going live, review:",{"_2937":240,"_26000":202,"_18071":42790,"_5":17966,"_24599":42706,"_2447":42791},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2937":241,"_26000":202,"_18071":42793,"_5":17966,"_24599":42706,"_2447":42794},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2937":242,"_26000":202,"_18071":42796,"_5":17966,"_24599":42706,"_2447":42797},[],"shared VA storage before increasing VA replicas",{"_2937":243,"_26000":202,"_18071":42799,"_5":17966,"_24599":42706,"_2447":42800},[],"managed OIDC roles and removal of evaluation credentials",{"_2937":244,"_26000":202,"_18071":42802,"_5":17966,"_24599":42706,"_2447":42803},[],"a trusted TLS issuer or externally managed certificate",{"_2937":245,"_26000":202,"_18071":42805,"_5":17966,"_24599":42706,"_2447":42806},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2937":246,"_26000":202,"_18071":42808,"_5":17966,"_24599":42706,"_2447":42809},[],"SMTP, observability and alert delivery",{"_2937":247,"_26000":202,"_18071":42811,"_5":17966,"_24599":42706,"_2447":42812},[],"follow Upgrade the Helm chart and the version notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2937":248,"_26000":202,"_18071":42814,"_5":17966,"_24599":42706,"_2447":42815},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2937":249,"_26000":249,"_5":12545,"_2447":42817,"_26339":42818,"_18071":42819,"_24599":249},"Upgrade the Helm chart",[42089,42090,42196],[],{"_2937":250,"_26000":249,"_18071":42821,"_5":17966,"_24599":249,"_2447":42822},[],"Upgrade a Helm-managed Lamassu deployment, including the 3.8.0 to 4.0.0 chart migration and the KMS and VA persistent-data steps.",{"_2937":251,"_26000":249,"_5":26336,"_18071":42824,"_24599":42825,"_2447":42817},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#upgrade-the-helm-chart",{"_2937":252,"_26000":249,"_5":26336,"_18071":42827,"_24599":42828,"_2447":42829},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#what-changes-in-400","What changes in 4.0.0",{"_2937":253,"_26000":249,"_5":26336,"_18071":42831,"_24599":42832,"_2447":42833},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#what-the-upgrade-job-does-automatically","What the upgrade job does automatically",{"_2937":254,"_26000":249,"_5":26336,"_18071":42835,"_24599":42836,"_2447":42837},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#before-you-upgrade","Before you upgrade",{"_2937":255,"_26000":249,"_5":26336,"_18071":42839,"_24599":42840,"_2447":42841},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#update-your-values-file","Update your values file",{"_2937":256,"_26000":249,"_5":26336,"_18071":42843,"_24599":42844,"_2447":42845},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#run-the-upgrade","Run the upgrade",{"_2937":257,"_26000":249,"_5":26336,"_18071":42847,"_24599":42848,"_2447":42849},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#migrate-the-kms-and-va-data","Migrate the KMS and VA data",{"_2937":258,"_26000":249,"_5":26336,"_18071":42851,"_24599":42852,"_2447":42853},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#verify-the-migration","Verify the migration",{"_2937":259,"_26000":249,"_5":26336,"_18071":42855,"_24599":42856,"_2447":42857},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#delete-the-old-volumes","Delete the old volumes",{"_2937":260,"_26000":249,"_5":26336,"_18071":42859,"_24599":42860,"_2447":42861},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#troubleshooting","Troubleshooting",{"_2937":261,"_26000":249,"_5":26336,"_18071":42863,"_24599":42864,"_2447":42865},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#related-pages","Related pages",{"_2937":262,"_26000":249,"_18071":42867,"_5":17966,"_24599":42825,"_2447":42868},[],"Use this guide to upgrade a Helm-managed deployment. It walks through the 3.8.0 to 4.0.0 chart migration in full: the values to review, the database changes the chart applies automatically and the manual steps for installations that keep KMS keys or VA CRLs on local volumes. Version-specific notes for other upgrades live in the `charts/lamassu/CHANGELOG/` directory of the `lamassu-helm` repository.",{"_2937":263,"_26000":249,"_18071":42870,"_5":17966,"_24599":42825,"_2447":42871},[],"If you are not upgrading an existing release, go straight to Install with Helm. The manual data steps on this page only apply to deployments upgraded from 3.8.x that use local KMS or VA storage.",{"_2937":264,"_26000":249,"_18071":42873,"_5":17966,"_24599":42828,"_2447":42874},[],"Version 4.0.0 is a security-hardening release. Three changes affect upgrades:",{"_2937":265,"_26000":249,"_18071":42876,"_5":17966,"_24599":42828,"_2447":42877},[],"**Release-scoped resource names.** Every chart-managed resource is now named `<release>-lamassu-<component>`, for example `lamassu-kms`, instead of the fixed, unscoped names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`, not `prod-kms`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_2937":266,"_26000":249,"_18071":42879,"_5":17966,"_24599":42828,"_2447":42880},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_2937":267,"_26000":249,"_18071":42882,"_5":17966,"_24599":42828,"_2447":42883},[],"**Strict values validation.** `values.schema.json` rejects unknown top-level keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` outright instead of being silently ignored.",{"_2937":268,"_26000":249,"_18071":42885,"_5":17966,"_24599":42828,"_2447":42886},[],"`services.connectors` also becomes a map keyed by connector ID, and the chart no longer injects pod anti-affinity or topology spread rules.",{"_2937":269,"_26000":249,"_18071":42888,"_5":17966,"_24599":42828,"_2447":42889},[],"Kubernetes derives the PVC name from the StatefulSet pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. Your KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail to find them with `no such file or directory` (KMS) or `code=NotFound` (VA) until you move the data across yourself. All other renamed resources are stateless and are recreated without data-loss risk.",{"_2937":270,"_26000":249,"_18071":42891,"_5":17966,"_24599":42832,"_2447":42892},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL:",{"_2937":271,"_26000":249,"_18071":42894,"_5":17966,"_24599":42832,"_2447":42895},[],"Creates the `pki`, `authz` and `wfx` databases when they do not exist.",{"_2937":272,"_26000":249,"_18071":42897,"_5":17966,"_24599":42832,"_2447":42898},[],"Ensures one schema per service database (`alerts`, `ca`, `va`, `devicemanager`, `dmsmanager`, `kms`) inside the shared `pki` database, and folds 3.8.0's separate per-service databases into it, importing their data.",{"_2937":273,"_26000":249,"_18071":42900,"_5":17966,"_24599":42832,"_2447":42901},[],"Runs the database migrations for every schema.",{"_2937":274,"_26000":249,"_18071":42903,"_5":17966,"_24599":42832,"_2447":42904},[],"Migrates authz, preloads its policies and seeds the `services.authz.bootstrap` principals.",{"_2937":275,"_26000":249,"_18071":42906,"_5":17966,"_24599":42832,"_2447":42907},[],"The job is idempotent, so a failed upgrade can be retried. It requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_2937":276,"_26000":249,"_18071":42909,"_5":17966,"_24599":42836,"_2447":42910},[],"Record the names of your existing local-storage PVCs:",{"_2937":277,"_26000":249,"_18071":42912,"_5":17966,"_24599":42836,"_2447":42913},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy data and to clean up later; do not delete them until the new volumes are verified.",{"_2937":278,"_26000":249,"_18071":42915,"_5":17966,"_24599":42836,"_2447":42916},[],"Remove values the strict schema now rejects, for example the old `toolbox:` block. Update your values file lists every rename.",{"_2937":279,"_26000":249,"_18071":42918,"_5":17966,"_24599":42840,"_2447":42919},[],"**Add `services.authz` (required).** 3.8.0 had no authorization service: every route accepted any valid token. 4.0.0 adds fine-grained, entity-level authorization, and a 3.8.0 values file has nothing to migrate *from* — you must add the configuration:",{"_2937":280,"_26000":249,"_18071":42921,"_5":17966,"_24599":42840,"_2447":42922},[],"`authz` is the authorization service's own storage for principals, grants and policies (`services.authz.database`, `authz` by default).",{"_2937":281,"_26000":249,"_18071":42924,"_5":17966,"_24599":42840,"_2447":42925},[],"`pki` is the database the authorization engine queries when it evaluates policies against entities such as CAs, certificates, devices, DMSs, KMS keys and VA roles.",{"_2937":282,"_26000":249,"_18071":42927,"_5":17966,"_24599":42840,"_2447":42928},[],"Only the `database` field of each credentials entry is read. Connection settings always come from the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_2937":283,"_26000":249,"_18071":42930,"_5":17966,"_24599":42840,"_2447":42931},[],"Confirm `services.authz.bootstrap` (present by default in the chart) matches how your OIDC provider assigns the `pki-admin` realm role. Without a principal that matches the bootstrap rule, nobody can administer the PKI — there is no implicit superuser.",{"_2937":284,"_26000":249,"_18071":42933,"_5":17966,"_24599":42840,"_2447":42934},[],"**Rename `toolbox` to `connectivityTest`.** The `helm test` connectivity hook now uses the upstream-maintained `curlimages/curl` image pinned by digest instead of the chart-owned toolbox image:",{"_2937":285,"_26000":249,"_18071":42936,"_5":17966,"_24599":42840,"_2447":42937},[],"**Remove per-service identity overrides.** `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` no longer exist. Every service runs under the chart-wide `65532:65532`, and KMS volume and PKCS#11 socket group access is handled automatically by the pod-level `fsGroup: 65532`.",{"_2937":286,"_26000":249,"_18071":42939,"_5":17966,"_24599":42840,"_2447":42940},[],"**Convert `services.connectors` to a map.** Each entry is keyed by its stable connector ID and declares `type` and `image`:",{"_2937":287,"_26000":249,"_18071":42942,"_5":17966,"_24599":42840,"_2447":42943},[],"**Check the TLS issuer values.** With `tls.certManagerOptions.issuer` empty (the default), the chart creates a self-signed, release-scoped issuer — for example `lamassu-downstream-ca-selfsigned-issuer` with release `lamassu`. The legacy literal `downstream-ca-selfsigned-issuer` from 3.8.0-era values is still accepted and resolves to the same release-scoped issuer; point `tls.certManagerOptions.clusterIssuer` at your own issuer for corporate TLS.",{"_2937":288,"_26000":249,"_18071":42945,"_5":17966,"_24599":42840,"_2447":42946},[],"**Review scheduling and ports.** The chart no longer injects pod anti-affinity or topology spread constraints — configure `affinity` and `topologySpreadConstraints` explicitly where your cluster needs them. The `services.ui.port` default is now `8085`, the unprivileged chart-wide port of the rootless image, so update overrides that pinned `80`. The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_2937":289,"_26000":249,"_18071":42948,"_5":17966,"_24599":42844,"_2447":42949},[],"Helm runs the database job before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_2937":290,"_26000":249,"_18071":42951,"_5":17966,"_24599":42848,"_2447":42952},[],"Skip this section on fresh installs, or when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_2937":291,"_26000":249,"_18071":42954,"_5":17966,"_24599":42848,"_2447":42955},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride`/`fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_2937":292,"_26000":249,"_18071":42957,"_5":17966,"_24599":42848,"_2447":42958},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing.",{"_2937":293,"_26000":249,"_18071":42960,"_5":17966,"_24599":42848,"_2447":42961},[],"**Scale the new StatefulSets down** so nothing writes to either volume while you copy:",{"_2937":294,"_26000":249,"_18071":42963,"_5":17966,"_24599":42848,"_2447":42964},[],"**Run a short-lived helper pod** that mounts all four claims:",{"_2937":295,"_26000":249,"_18071":42966,"_5":17966,"_24599":42848,"_2447":42967},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_2937":296,"_26000":249,"_18071":42969,"_5":17966,"_24599":42848,"_2447":42970},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing.",{"_2937":297,"_26000":249,"_18071":42972,"_5":17966,"_24599":42848,"_2447":42973},[],"**Copy the data and align ownership**:",{"_2937":298,"_26000":249,"_18071":42975,"_5":17966,"_24599":42848,"_2447":42976},[],"The `chown` is required even if the old files already look non-root-owned. 3.8.0 did not pin a container identity, so files could carry any image-declared UID; 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_2937":299,"_26000":249,"_18071":42978,"_5":17966,"_24599":42848,"_2447":42979},[],"**Scale back up and remove the helper**:",{"_2937":300,"_26000":249,"_18071":42981,"_5":17966,"_24599":42852,"_2447":42982},[],"KMS and VA logs show no `no such file or directory` or `code=NotFound` errors.",{"_2937":301,"_26000":249,"_18071":42984,"_5":17966,"_24599":42852,"_2447":42985},[],"A previously issued CRL is servable again: `GET /crl/<ca-ski>` on VA.",{"_2937":302,"_26000":249,"_18071":42987,"_5":17966,"_24599":42852,"_2447":42988},[],"`helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the connectivity hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_2937":303,"_26000":249,"_18071":42990,"_5":17966,"_24599":42852,"_2447":42991},[],"Sign in with an administrator identity and confirm operations are authorized.",{"_2937":304,"_26000":249,"_18071":42993,"_5":17966,"_24599":42856,"_2447":42994},[],"Only once everything works, delete the orphaned 3.8.0 volumes to reclaim storage:",{"_2937":305,"_26000":249,"_18071":42996,"_5":17966,"_24599":42860,"_2447":42997},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The new pods are bound to the new empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow Migrate the KMS and VA data and check that all four claims exist.",{"_2937":306,"_26000":249,"_18071":42999,"_5":17966,"_24599":42860,"_2447":43000},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically the `toolbox:` block — because the strict schema rejects top-level keys it does not know.",{"_2937":307,"_26000":249,"_18071":43002,"_5":17966,"_24599":42860,"_2447":43003},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas; grant the required privileges, or create the `pki`, `authz` and `wfx` databases yourself, then re-run the upgrade.",{"_2937":308,"_26000":249,"_18071":43005,"_5":17966,"_24599":42860,"_2447":43006},[],"**Nobody can log in after the upgrade.** Check that `services.authz.bootstrap` matches a role your OIDC provider actually assigns (see Access control) and that the migration Job completed successfully.",{"_2937":309,"_26000":249,"_18071":43008,"_5":17966,"_24599":42864,"_2447":43009},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2937":310,"_26000":249,"_18071":43011,"_5":17966,"_24599":42864,"_2447":43012},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design and handle Gateway addressing.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2937":311,"_26000":311,"_5":12545,"_2447":43014,"_26339":43015,"_18071":43016,"_24599":311},"Expose the Gateway",[42089,42090,42196],[],{"_2937":312,"_26000":311,"_18071":43018,"_5":17966,"_24599":311,"_2447":43019},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2937":313,"_26000":311,"_5":26336,"_18071":43021,"_24599":43022,"_2447":43023},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2937":314,"_26000":311,"_5":26336,"_18071":43025,"_24599":43026,"_2447":43027},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2937":315,"_26000":311,"_5":26336,"_18071":43029,"_24599":43030,"_2447":43031},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2937":316,"_26000":311,"_5":26336,"_18071":43033,"_24599":43034,"_2447":43035},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#k3s","K3s",{"_2937":317,"_26000":311,"_5":26336,"_18071":43037,"_24599":43038,"_2447":43039},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2937":318,"_26000":311,"_5":26336,"_18071":43041,"_24599":43042,"_2447":43043},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2937":319,"_26000":311,"_5":26336,"_18071":43045,"_24599":43046,"_2447":43047},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2937":320,"_26000":311,"_5":26336,"_18071":43049,"_24599":43050,"_2447":43051},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2937":321,"_26000":311,"_5":26336,"_18071":43053,"_24599":43054,"_2447":43055},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2937":322,"_26000":311,"_18071":43057,"_5":17966,"_24599":43022,"_2447":43058},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2937":323,"_26000":311,"_18071":43060,"_5":17966,"_24599":43022,"_2447":43061},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2937":324,"_26000":311,"_18071":43063,"_5":17966,"_24599":43026,"_2447":43064},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2937":325,"_26000":311,"_18071":43066,"_5":17966,"_24599":43026,"_2447":43067},[],"Set it only when:",{"_2937":326,"_26000":311,"_18071":43069,"_5":17966,"_24599":43026,"_2447":43070},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2937":327,"_26000":311,"_18071":43072,"_5":17966,"_24599":43026,"_2447":43073},[],"that address is allocated to this Gateway",{"_2937":328,"_26000":311,"_18071":43075,"_5":17966,"_24599":43026,"_2447":43076},[],"the surrounding network already routes traffic for it to the cluster",{"_2937":329,"_26000":311,"_18071":43078,"_5":17966,"_24599":43026,"_2447":43079},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2937":330,"_26000":311,"_18071":43081,"_5":17966,"_24599":43026,"_2447":43082},[],"Keep these two settings separate:",{"_2937":331,"_26000":311,"_18071":43084,"_5":17966,"_24599":43026,"_2447":43085},[],"`gateway.addresses` requests an address for the Gateway.",{"_2937":332,"_26000":311,"_18071":43087,"_5":17966,"_24599":43026,"_2447":43088},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2937":333,"_26000":311,"_18071":43090,"_5":17966,"_24599":43026,"_2447":43091},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2937":334,"_26000":311,"_18071":43093,"_5":17966,"_24599":43030,"_2447":43094},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2937":335,"_26000":311,"_18071":43096,"_5":17966,"_24599":43030,"_2447":43097},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2937":336,"_26000":311,"_18071":43099,"_5":17966,"_24599":43034,"_2447":43100},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2937":337,"_26000":311,"_18071":43102,"_5":17966,"_24599":43034,"_2447":43103},[],"For the recommended design:",{"_2937":338,"_26000":311,"_18071":43105,"_5":17966,"_24599":43034,"_2447":43106},[],"Use only one externally exposed Lamassu Gateway.",{"_2937":339,"_26000":311,"_18071":43108,"_5":17966,"_24599":43034,"_2447":43109},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2937":340,"_26000":311,"_18071":43111,"_5":17966,"_24599":43034,"_2447":43112},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2937":341,"_26000":311,"_18071":43114,"_5":17966,"_24599":43034,"_2447":43115},[],"Point DNS at the VM's reachable address.",{"_2937":342,"_26000":311,"_18071":43117,"_5":17966,"_24599":43034,"_2447":43118},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2937":343,"_26000":311,"_18071":43120,"_5":17966,"_24599":43038,"_2447":43121},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2937":344,"_26000":311,"_18071":43123,"_5":17966,"_24599":43042,"_2447":43124},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2937":345,"_26000":311,"_18071":43126,"_5":17966,"_24599":43042,"_2447":43127},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2937":346,"_26000":311,"_18071":43129,"_5":17966,"_24599":43046,"_2447":43130},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2937":347,"_26000":311,"_18071":43132,"_5":17966,"_24599":43046,"_2447":43133},[],"Requirement",{"_2937":348,"_26000":311,"_18071":43135,"_5":17966,"_24599":43046,"_2447":43136},[],"Recommended design",{"_2937":349,"_26000":311,"_18071":43138,"_5":17966,"_24599":43046,"_2447":43139},[],"Consequence",{"_2937":350,"_26000":311,"_18071":43141,"_5":17966,"_24599":43046,"_2447":43142},[],"Several Lamassu URLs or services",{"_2937":351,"_26000":311,"_18071":43144,"_5":17966,"_24599":43046,"_2447":43145},[],"One Gateway with multiple routes",{"_2937":352,"_26000":311,"_18071":43147,"_5":17966,"_24599":43046,"_2447":43148},[],"One IP and one proxy fleet; this is the chart default",{"_2937":353,"_26000":311,"_18071":43150,"_5":17966,"_24599":43046,"_2447":43151},[],"Independent Gateways and separate external IPs",{"_2937":354,"_26000":311,"_18071":43153,"_5":17966,"_24599":43046,"_2447":43154},[],"One VIP per Gateway",{"_2937":355,"_26000":311,"_18071":43156,"_5":17966,"_24599":43046,"_2447":43157},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2937":356,"_26000":311,"_18071":43159,"_5":17966,"_24599":43046,"_2447":43160},[],"Independent Gateways on one node and one IP",{"_2937":357,"_26000":311,"_18071":43162,"_5":17966,"_24599":43046,"_2447":43163},[],"Use different external ports",{"_2937":358,"_26000":311,"_18071":43165,"_5":17966,"_24599":43046,"_2447":43166},[],"Clients must include non-standard ports",{"_2937":359,"_26000":311,"_18071":43168,"_5":17966,"_24599":43046,"_2447":43169},[],"Separate TLS/mTLS termination behind one IP",{"_2937":360,"_26000":311,"_18071":43171,"_5":17966,"_24599":43046,"_2447":43172},[],"Front-door SNI routing to internal Gateways",{"_2937":361,"_26000":311,"_18071":43174,"_5":17966,"_24599":43046,"_2447":43175},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2937":362,"_26000":311,"_18071":43177,"_5":17966,"_24599":43046,"_2447":43178},[],"Separate Gateway resources but shared proxy infrastructure",{"_2937":363,"_26000":311,"_18071":43180,"_5":17966,"_24599":43046,"_2447":43181},[],"Envoy merged-Gateway mode",{"_2937":364,"_26000":311,"_18071":43183,"_5":17966,"_24599":43046,"_2447":43184},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2937":365,"_26000":311,"_18071":43186,"_5":17966,"_24599":43046,"_2447":43187},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2937":366,"_26000":311,"_18071":43189,"_5":17966,"_24599":43046,"_2447":43190},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2937":367,"_26000":311,"_18071":43192,"_5":17966,"_24599":43046,"_2447":43193},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2937":368,"_26000":311,"_18071":43195,"_5":17966,"_24599":43046,"_2447":43196},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2937":369,"_26000":311,"_18071":43198,"_5":17966,"_24599":43050,"_2447":43199},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2937":370,"_26000":311,"_18071":43201,"_5":17966,"_24599":43050,"_2447":43202},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2937":371,"_26000":311,"_18071":43204,"_5":17966,"_24599":43050,"_2447":43205},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2937":372,"_26000":311,"_18071":43207,"_5":17966,"_24599":43050,"_2447":43208},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2937":373,"_26000":311,"_18071":43210,"_5":17966,"_24599":43050,"_2447":43211},[],"If none of those are possible, use different external ports or change the external network design.",{"_2937":374,"_26000":311,"_18071":43213,"_5":17966,"_24599":43054,"_2447":43214},[],"Check, in order:",{"_2937":375,"_26000":311,"_18071":43216,"_5":17966,"_24599":43054,"_2447":43217},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2937":376,"_26000":311,"_18071":43219,"_5":17966,"_24599":43054,"_2447":43220},[],"Its status contains the expected address.",{"_2937":377,"_26000":311,"_18071":43222,"_5":17966,"_24599":43054,"_2447":43223},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2937":378,"_26000":311,"_18071":43225,"_5":17966,"_24599":43054,"_2447":43226},[],"Port 443 reaches that address from the client network.",{"_2937":379,"_26000":311,"_18071":43228,"_5":17966,"_24599":43054,"_2447":43229},[],"DNS resolves to the externally reachable endpoint.",{"_2937":380,"_26000":311,"_18071":43231,"_5":17966,"_24599":43054,"_2447":43232},[],"The certificate contains the DNS name or IP used by the client.",{"_2937":381,"_26000":311,"_18071":43234,"_5":17966,"_24599":43054,"_2447":43235},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2937":382,"_26000":382,"_5":12545,"_2447":42196,"_26339":43237,"_18071":43238,"_24599":382},[42089,42090,42196],[],{"_2937":383,"_26000":382,"_18071":43240,"_5":17966,"_24599":382,"_2447":43241},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2937":384,"_26000":382,"_5":26336,"_18071":43243,"_24599":43244,"_2447":43245},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2937":385,"_26000":382,"_5":26336,"_18071":43247,"_24599":43248,"_2447":43249},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2937":386,"_26000":382,"_5":26336,"_18071":43251,"_24599":43252,"_2447":43253},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2937":387,"_26000":382,"_5":26336,"_18071":43255,"_24599":43256,"_2447":43257},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2937":388,"_26000":382,"_5":26336,"_18071":43259,"_24599":43260,"_2447":43261},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2937":389,"_26000":382,"_5":26336,"_18071":43263,"_24599":43264,"_2447":43265},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2937":390,"_26000":382,"_18071":43267,"_5":17966,"_24599":43244,"_2447":43268},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2937":391,"_26000":382,"_18071":43270,"_5":17966,"_24599":43248,"_2447":43271},[],"Workflow",{"_2937":392,"_26000":382,"_18071":43273,"_5":17966,"_24599":43248,"_2447":43274},[],"Use it for",{"_2937":393,"_26000":382,"_18071":43276,"_5":17966,"_24599":43248,"_2447":43277},[],"What it installs",{"_2937":394,"_26000":382,"_18071":43279,"_5":17966,"_24599":43248,"_2447":43280},[],"Helm",{"_2937":395,"_26000":382,"_18071":43282,"_5":17966,"_24599":43248,"_2447":43283},[],"Production and controlled environments",{"_2937":396,"_26000":382,"_18071":43285,"_5":17966,"_24599":43248,"_2447":43286},[],"Lamassu services and Gateway API resources",{"_2937":397,"_26000":382,"_18071":43288,"_5":17966,"_24599":43248,"_2447":42333},[],{"_2937":398,"_26000":382,"_18071":43290,"_5":17966,"_24599":43248,"_2447":43291},[],"Evaluation, demos, CI and small lab clusters",{"_2937":399,"_26000":382,"_18071":43293,"_5":17966,"_24599":43248,"_2447":43294},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2937":400,"_26000":382,"_18071":43296,"_5":17966,"_24599":43252,"_2447":43297},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2937":401,"_26000":382,"_18071":43299,"_5":17966,"_24599":43252,"_2447":43300},[],"Area",{"_2937":402,"_26000":382,"_18071":43302,"_5":17966,"_24599":43252,"_2447":43303},[],"The Lamassu chart provides",{"_2937":403,"_26000":382,"_18071":43305,"_5":17966,"_24599":43252,"_2447":43306},[],"You provide",{"_2937":404,"_26000":382,"_18071":43308,"_5":17966,"_24599":43252,"_2447":43309},[],"Lamassu applications",{"_2937":405,"_26000":382,"_18071":43311,"_5":17966,"_24599":43252,"_2447":43312},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2937":406,"_26000":382,"_18071":43314,"_5":17966,"_24599":43252,"_2447":43315},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2937":407,"_26000":382,"_18071":43317,"_5":17966,"_24599":43252,"_2447":43318},[],"PostgreSQL data",{"_2937":408,"_26000":382,"_18071":43320,"_5":17966,"_24599":43252,"_2447":43321},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2937":409,"_26000":382,"_18071":43323,"_5":17966,"_24599":43252,"_2447":43324},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2937":410,"_26000":382,"_18071":43326,"_5":17966,"_24599":43252,"_2447":43327},[],"Messaging",{"_2937":411,"_26000":382,"_18071":43329,"_5":17966,"_24599":43252,"_2447":43330},[],"RabbitMQ connection configuration for the Lamassu services",{"_2937":412,"_26000":382,"_18071":43332,"_5":17966,"_24599":43252,"_2447":43333},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2937":413,"_26000":382,"_18071":43335,"_5":17966,"_24599":43252,"_2447":43336},[],"Identity",{"_2937":414,"_26000":382,"_18071":43338,"_5":17966,"_24599":43252,"_2447":43339},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2937":415,"_26000":382,"_18071":43341,"_5":17966,"_24599":43252,"_2447":43342},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2937":416,"_26000":382,"_18071":43344,"_5":17966,"_24599":43252,"_2447":43345},[],"External routing",{"_2937":417,"_26000":382,"_18071":43347,"_5":17966,"_24599":43252,"_2447":43348},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2937":418,"_26000":382,"_18071":43350,"_5":17966,"_24599":43252,"_2447":43351},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2937":419,"_26000":382,"_18071":43353,"_5":17966,"_24599":43252,"_2447":43354},[],"TLS",{"_2937":420,"_26000":382,"_18071":43356,"_5":17966,"_24599":43252,"_2447":43357},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2937":421,"_26000":382,"_18071":43359,"_5":17966,"_24599":43252,"_2447":43360},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2937":422,"_26000":382,"_18071":43362,"_5":17966,"_24599":43252,"_2447":43363},[],"Persistent application data",{"_2937":423,"_26000":382,"_18071":43365,"_5":17966,"_24599":43252,"_2447":43366},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2937":424,"_26000":382,"_18071":43368,"_5":17966,"_24599":43252,"_2447":43369},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2937":425,"_26000":382,"_18071":43371,"_5":17966,"_24599":43252,"_2447":43372},[],"Optional integrations",{"_2937":426,"_26000":382,"_18071":43374,"_5":17966,"_24599":43252,"_2447":43375},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2937":427,"_26000":382,"_18071":43377,"_5":17966,"_24599":43252,"_2447":43378},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2937":428,"_26000":382,"_18071":43380,"_5":17966,"_24599":43252,"_2447":43381},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2937":429,"_26000":382,"_18071":43383,"_5":17966,"_24599":43252,"_2447":43384},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2937":430,"_26000":382,"_18071":43386,"_5":17966,"_24599":43256,"_2447":43387},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2937":431,"_26000":382,"_18071":43389,"_5":17966,"_24599":43256,"_2447":43390},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2937":432,"_26000":382,"_18071":43392,"_5":17966,"_24599":43260,"_2447":43393},[],"Kubernetes 1.24 or newer",{"_2937":433,"_26000":382,"_18071":43395,"_5":17966,"_24599":43260,"_2447":43396},[],"Helm 3.2 or newer",{"_2937":434,"_26000":382,"_18071":43398,"_5":17966,"_24599":43260,"_2447":43399},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2937":435,"_26000":382,"_18071":43401,"_5":17966,"_24599":43260,"_2447":43402},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2937":436,"_26000":382,"_18071":43404,"_5":17966,"_24599":43260,"_2447":43405},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2937":437,"_26000":382,"_18071":43407,"_5":17966,"_24599":43260,"_2447":43408},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2937":438,"_26000":382,"_18071":43410,"_5":17966,"_24599":43260,"_2447":43411},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2937":439,"_26000":382,"_18071":43413,"_5":17966,"_24599":43264,"_2447":43414},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2937":440,"_26000":382,"_18071":43416,"_5":17966,"_24599":43264,"_2447":43417},[],"<Card title=\"Upgrade the chart\" description=\"Upgrade an existing Helm release, including the 3.8.0 to 4.0.0 migration steps.\" href=\"/docs/deployment/self-hosted/migration\" />",{"_2937":441,"_26000":382,"_18071":43419,"_5":17966,"_24599":43264,"_2447":43420},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2937":442,"_26000":382,"_18071":43422,"_5":17966,"_24599":43264,"_2447":43423},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2937":443,"_26000":443,"_5":12545,"_2447":43425,"_26339":43426,"_18071":43428,"_24599":443},"Deployment troubleshooting",[42089,42090,43427],"Operations",[],{"_2937":444,"_26000":443,"_18071":43430,"_5":17966,"_24599":443,"_2447":43431},[],"Diagnose access, service health and infrastructure dependencies.",{"_2937":445,"_26000":443,"_5":26336,"_18071":43433,"_24599":43434,"_2447":43435},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2937":446,"_26000":443,"_5":26336,"_18071":43437,"_24599":43438,"_2447":43439},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2937":447,"_26000":443,"_5":26336,"_18071":43441,"_24599":43442,"_2447":43443},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2937":448,"_26000":443,"_5":26336,"_18071":43445,"_24599":43446,"_2447":43447},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2937":449,"_26000":443,"_5":26336,"_18071":43449,"_24599":43450,"_2447":43451},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2937":450,"_26000":443,"_5":26336,"_18071":43453,"_24599":43454,"_2447":43455},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2937":451,"_26000":443,"_5":26336,"_18071":43457,"_24599":43458,"_2447":43459},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2937":452,"_26000":443,"_5":26336,"_18071":43461,"_24599":43462,"_2447":43463},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2937":453,"_26000":443,"_5":26336,"_18071":43465,"_24599":43466,"_2447":43467},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2937":454,"_26000":443,"_5":26336,"_18071":43469,"_24599":43470,"_2447":43471},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2937":455,"_26000":443,"_5":26336,"_18071":43473,"_24599":43474,"_2447":43475},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2937":456,"_26000":443,"_5":26336,"_18071":43477,"_24599":43478,"_2447":43479},[],"/docs/pr-preview/pr-26/deployment/troubleshooting#observability","Observability",{"_2937":457,"_26000":443,"_18071":43481,"_5":17966,"_24599":443,"_2447":43482},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2937":458,"_26000":443,"_18071":43484,"_5":17966,"_24599":43438,"_2447":43485},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2937":459,"_26000":443,"_18071":43487,"_5":17966,"_24599":43442,"_2447":43488},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2937":460,"_26000":443,"_18071":43490,"_5":17966,"_24599":43446,"_2447":43491},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2937":461,"_26000":443,"_18071":43493,"_5":17966,"_24599":43450,"_2447":43494},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2937":462,"_26000":443,"_18071":43496,"_5":17966,"_24599":43454,"_2447":43497},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2937":463,"_26000":443,"_18071":43499,"_5":17966,"_24599":43458,"_2447":43500},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2937":464,"_26000":443,"_18071":43502,"_5":17966,"_24599":43458,"_2447":43503},[],"Also run the chart's connectivity test:",{"_2937":465,"_26000":443,"_18071":43505,"_5":17966,"_24599":43458,"_2447":43506},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2937":466,"_26000":443,"_18071":43508,"_5":17966,"_24599":43458,"_2447":43509},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2937":467,"_26000":443,"_18071":43511,"_5":17966,"_24599":43462,"_2447":43512},[],"If you receive a 401:",{"_2937":468,"_26000":443,"_18071":43514,"_5":17966,"_24599":43462,"_2447":43515},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2937":469,"_26000":443,"_18071":43517,"_5":17966,"_24599":43462,"_2447":43518},[],"verify issuer, audience and expiration of the token;",{"_2937":470,"_26000":443,"_18071":43520,"_5":17966,"_24599":43462,"_2447":43521},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2937":471,"_26000":443,"_18071":43523,"_5":17966,"_24599":43462,"_2447":43524},[],"check that the provider's public and internal routes point to the same realm.",{"_2937":472,"_26000":443,"_18071":43526,"_5":17966,"_24599":43462,"_2447":43527},[],"If login succeeds but the APIs return 403:",{"_2937":473,"_26000":443,"_18071":43529,"_5":17966,"_24599":43462,"_2447":43530},[],"inspect the token's real claims;",{"_2937":474,"_26000":443,"_18071":43532,"_5":17966,"_24599":43462,"_2447":43533},[],"confirm they match an active principal;",{"_2937":475,"_26000":443,"_18071":43535,"_5":17966,"_24599":43462,"_2447":43536},[],"review the policies granted to that principal;",{"_2937":476,"_26000":443,"_18071":43538,"_5":17966,"_24599":43462,"_2447":43539},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2937":477,"_26000":443,"_18071":43541,"_5":17966,"_24599":43462,"_2447":43542},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2937":478,"_26000":443,"_18071":43544,"_5":17966,"_24599":43466,"_2447":43545},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2937":479,"_26000":443,"_18071":43547,"_5":17966,"_24599":43466,"_2447":43548},[],"Locate the authz pod and Service.",{"_2937":480,"_26000":443,"_18071":43550,"_5":17966,"_24599":43466,"_2447":43551},[],"Check /health, logs and its database connection.",{"_2937":481,"_26000":443,"_18071":43553,"_5":17966,"_24599":43466,"_2447":43554},[],"Verify the DNS and port configured in externalAuthorization.",{"_2937":482,"_26000":443,"_18071":43556,"_5":17966,"_24599":43466,"_2447":43557},[],"Check the check route is /v1/ext\\_authz/check.",{"_2937":483,"_26000":443,"_18071":43559,"_5":17966,"_24599":43466,"_2447":43560},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2937":484,"_26000":443,"_18071":43562,"_5":17966,"_24599":43470,"_2447":43563},[],"Review kubectl describe pod first. Common causes are:",{"_2937":485,"_26000":443,"_18071":43565,"_5":17966,"_24599":43470,"_2447":43566},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2937":486,"_26000":443,"_18071":43568,"_5":17966,"_24599":43470,"_2447":43569},[],"unbound persistent volume;",{"_2937":487,"_26000":443,"_18071":43571,"_5":17966,"_24599":43470,"_2447":43572},[],"inaccessible image or incorrect pull policy;",{"_2937":488,"_26000":443,"_18071":43574,"_5":17966,"_24599":43470,"_2447":43575},[],"invalid cryptographic engine configuration;",{"_2937":489,"_26000":443,"_18071":43577,"_5":17966,"_24599":43470,"_2447":43578},[],"CPU or memory limits set too low;",{"_2937":490,"_26000":443,"_18071":43580,"_5":17966,"_24599":43470,"_2447":43581},[],"an incomplete prior migration.",{"_2937":491,"_26000":443,"_18071":43583,"_5":17966,"_24599":43470,"_2447":43584},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2937":492,"_26000":443,"_18071":43586,"_5":17966,"_24599":43470,"_2447":43587},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2937":493,"_26000":443,"_18071":43589,"_5":17966,"_24599":43474,"_2447":43590},[],"Domain and audit events depend on the bus publisher:",{"_2937":494,"_26000":443,"_18071":43592,"_5":17966,"_24599":43474,"_2447":43593},[],"verify it is enabled in the emitting service;",{"_2937":495,"_26000":443,"_18071":43595,"_5":17966,"_24599":43474,"_2447":43596},[],"check AMQP connectivity and credentials;",{"_2937":496,"_26000":443,"_18071":43598,"_5":17966,"_24599":43474,"_2447":43599},[],"review exchange, routing key, queues and consumers;",{"_2937":497,"_26000":443,"_18071":43601,"_5":17966,"_24599":43474,"_2447":43602},[],"inspect dead-letter queues;",{"_2937":498,"_26000":443,"_18071":43604,"_5":17966,"_24599":43474,"_2447":43605},[],"alert on orphan durable queues and backlog growth.",{"_2937":499,"_26000":443,"_18071":43607,"_5":17966,"_24599":43474,"_2447":43608},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2937":500,"_26000":443,"_18071":43610,"_5":17966,"_24599":43478,"_2447":43611},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2937":501,"_26000":443,"_18071":43613,"_5":17966,"_24599":43478,"_2447":43614},[],"Before closing an incident, record:",{"_2937":502,"_26000":443,"_18071":43616,"_5":17966,"_24599":43478,"_2447":43617},[],"the confirmed cause;",{"_2937":503,"_26000":443,"_18071":43619,"_5":17966,"_24599":43478,"_2447":43620},[],"the time scope and affected resources;",{"_2937":504,"_26000":443,"_18071":43622,"_5":17966,"_24599":43478,"_2447":43623},[],"the commands or queries used;",{"_2937":505,"_26000":443,"_18071":43625,"_5":17966,"_24599":43478,"_2447":43626},[],"the applied change and how to revert it;",{"_2937":506,"_26000":443,"_18071":43628,"_5":17966,"_24599":43478,"_2447":43629},[],"validation from a consumer;",{"_2937":507,"_26000":443,"_18071":43631,"_5":17966,"_24599":43478,"_2447":43632},[],"the preventive action and its owner.",{"_2937":508,"_26000":508,"_5":12545,"_2447":43634,"_26339":43635,"_18071":43638,"_24599":508},"Access control",[42089,43636,43637],"Platform","Administration",[],{"_2937":509,"_26000":508,"_18071":43640,"_5":17966,"_24599":508,"_2447":43641},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2937":510,"_26000":508,"_5":26336,"_18071":43643,"_24599":43644,"_2447":43645},[],"/docs/pr-preview/pr-26/platform/administration/access-control#essential-concepts","Essential concepts",{"_2937":511,"_26000":508,"_5":26336,"_18071":43647,"_24599":43648,"_2447":43649},[],"/docs/pr-preview/pr-26/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2937":512,"_26000":508,"_5":26336,"_18071":43651,"_24599":43652,"_2447":43653},[],"/docs/pr-preview/pr-26/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2937":513,"_26000":508,"_5":26336,"_18071":43655,"_24599":43656,"_2447":43657},[],"/docs/pr-preview/pr-26/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2937":514,"_26000":508,"_5":26336,"_18071":43659,"_24599":43660,"_2447":43661},[],"/docs/pr-preview/pr-26/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2937":515,"_26000":508,"_5":26336,"_18071":43663,"_24599":43664,"_2447":43665},[],"/docs/pr-preview/pr-26/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2937":516,"_26000":508,"_5":26336,"_18071":43667,"_24599":43668,"_2447":43669},[],"/docs/pr-preview/pr-26/platform/administration/access-control#oidc-principals","OIDC principals",{"_2937":517,"_26000":508,"_5":26336,"_18071":43671,"_24599":43672,"_2447":43673},[],"/docs/pr-preview/pr-26/platform/administration/access-control#x509-principals","X.509 principals",{"_2937":518,"_26000":508,"_5":26336,"_18071":43675,"_24599":43676,"_2447":43677},[],"/docs/pr-preview/pr-26/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2937":519,"_26000":508,"_5":26336,"_18071":43679,"_24599":43680,"_2447":43681},[],"/docs/pr-preview/pr-26/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2937":520,"_26000":508,"_5":26336,"_18071":43683,"_24599":43684,"_2447":43685},[],"/docs/pr-preview/pr-26/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2937":521,"_26000":508,"_5":26336,"_18071":43687,"_24599":43688,"_2447":43689},[],"/docs/pr-preview/pr-26/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2937":522,"_26000":508,"_5":26336,"_18071":43691,"_24599":43692,"_2447":43693},[],"/docs/pr-preview/pr-26/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2937":523,"_26000":508,"_5":26336,"_18071":43695,"_24599":43696,"_2447":43697},[],"/docs/pr-preview/pr-26/platform/administration/access-control#http-rules","HTTP rules",{"_2937":524,"_26000":508,"_5":26336,"_18071":43699,"_24599":43700,"_2447":43701},[],"/docs/pr-preview/pr-26/platform/administration/access-control#included-policies","Included policies",{"_2937":525,"_26000":508,"_5":26336,"_18071":43703,"_24599":43704,"_2447":42695},[],"/docs/pr-preview/pr-26/platform/administration/access-control#provision-the-first-administrator",{"_2937":526,"_26000":508,"_5":26336,"_18071":43706,"_24599":43707,"_2447":43708},[],"/docs/pr-preview/pr-26/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2937":527,"_26000":508,"_5":26336,"_18071":43710,"_24599":43711,"_2447":43712},[],"/docs/pr-preview/pr-26/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2937":528,"_26000":508,"_5":26336,"_18071":43714,"_24599":43715,"_2447":43716},[],"/docs/pr-preview/pr-26/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2937":529,"_26000":508,"_5":26336,"_18071":43718,"_24599":43719,"_2447":43720},[],"/docs/pr-preview/pr-26/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2937":530,"_26000":508,"_5":26336,"_18071":43722,"_24599":43723,"_2447":43724},[],"/docs/pr-preview/pr-26/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2937":531,"_26000":508,"_5":26336,"_18071":43726,"_24599":43727,"_2447":43728},[],"/docs/pr-preview/pr-26/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2937":532,"_26000":508,"_5":26336,"_18071":43730,"_24599":43731,"_2447":43732},[],"/docs/pr-preview/pr-26/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2937":533,"_26000":508,"_5":26336,"_18071":43734,"_24599":43735,"_2447":43736},[],"/docs/pr-preview/pr-26/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2937":534,"_26000":508,"_5":26336,"_18071":43738,"_24599":43739,"_2447":43740},[],"/docs/pr-preview/pr-26/platform/administration/access-control#operational-checklist","Operational checklist",{"_2937":535,"_26000":508,"_5":26336,"_18071":43742,"_24599":43743,"_2447":43744},[],"/docs/pr-preview/pr-26/platform/administration/access-control#diagnostics","Diagnostics",{"_2937":536,"_26000":508,"_5":26336,"_18071":43746,"_24599":43747,"_2447":43748},[],"/docs/pr-preview/pr-26/platform/administration/access-control#the-response-is-401","The response is 401",{"_2937":537,"_26000":508,"_5":26336,"_18071":43750,"_24599":43751,"_2447":43752},[],"/docs/pr-preview/pr-26/platform/administration/access-control#the-response-is-403","The response is 403",{"_2937":538,"_26000":508,"_5":26336,"_18071":43754,"_24599":43755,"_2447":43756},[],"/docs/pr-preview/pr-26/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2937":539,"_26000":508,"_5":26336,"_18071":43758,"_24599":43759,"_2447":43760},[],"/docs/pr-preview/pr-26/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2937":540,"_26000":508,"_5":26336,"_18071":43762,"_24599":43763,"_2447":43764},[],"/docs/pr-preview/pr-26/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2937":541,"_26000":508,"_18071":43766,"_5":17966,"_24599":508,"_2447":43767},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2937":542,"_26000":508,"_18071":43769,"_5":17966,"_24599":508,"_2447":43770},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2937":543,"_26000":508,"_18071":43772,"_5":17966,"_24599":508,"_2447":43773},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2937":544,"_26000":508,"_18071":43775,"_5":17966,"_24599":43644,"_2447":43776},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2937":545,"_26000":508,"_18071":43778,"_5":17966,"_24599":43644,"_2447":43779},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2937":546,"_26000":508,"_18071":43781,"_5":17966,"_24599":43644,"_2447":43782},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2937":547,"_26000":508,"_18071":43784,"_5":17966,"_24599":43644,"_2447":43785},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2937":548,"_26000":508,"_18071":43787,"_5":17966,"_24599":43644,"_2447":43788},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2937":549,"_26000":508,"_18071":43790,"_5":17966,"_24599":43644,"_2447":43791},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2937":550,"_26000":508,"_18071":43793,"_5":17966,"_24599":43648,"_2447":43794},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2937":551,"_26000":508,"_18071":43796,"_5":17966,"_24599":43648,"_2447":43797},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2937":552,"_26000":508,"_18071":43799,"_5":17966,"_24599":43652,"_2447":43800},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2937":553,"_26000":508,"_18071":43802,"_5":17966,"_24599":43652,"_2447":43803},[],"The decision is made **before forwarding the request to the service**:",{"_2937":554,"_26000":508,"_18071":43805,"_5":17966,"_24599":43652,"_2447":43806},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2937":555,"_26000":508,"_18071":43808,"_5":17966,"_24599":43652,"_2447":43809},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2937":556,"_26000":508,"_18071":43811,"_5":17966,"_24599":43652,"_2447":43812},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2937":557,"_26000":508,"_18071":43814,"_5":17966,"_24599":43652,"_2447":43815},[],"It separately loads the policies granted to each principal.",{"_2937":558,"_26000":508,"_18071":43817,"_5":17966,"_24599":43652,"_2447":43818},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2937":559,"_26000":508,"_18071":43820,"_5":17966,"_24599":43652,"_2447":43821},[],"`authz` looks for an HTTP rule granting that action.",{"_2937":560,"_26000":508,"_18071":43823,"_5":17966,"_24599":43652,"_2447":43824},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2937":561,"_26000":508,"_18071":43826,"_5":17966,"_24599":43652,"_2447":43827},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2937":562,"_26000":508,"_18071":43829,"_5":17966,"_24599":43652,"_2447":43830},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2937":563,"_26000":508,"_18071":43832,"_5":17966,"_24599":43652,"_2447":43833},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2937":564,"_26000":508,"_18071":43835,"_5":17966,"_24599":43656,"_2447":43836},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2937":565,"_26000":508,"_18071":43838,"_5":17966,"_24599":43656,"_2447":43839},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2937":566,"_26000":508,"_18071":43841,"_5":17966,"_24599":43656,"_2447":43842},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2937":567,"_26000":508,"_18071":43844,"_5":17966,"_24599":43656,"_2447":43845},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2937":568,"_26000":508,"_18071":43847,"_5":17966,"_24599":43656,"_2447":43848},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2937":569,"_26000":508,"_18071":43850,"_5":17966,"_24599":43656,"_2447":43851},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2937":570,"_26000":508,"_18071":43853,"_5":17966,"_24599":43656,"_2447":43854},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2937":571,"_26000":508,"_18071":43856,"_5":17966,"_24599":43656,"_2447":43857},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2937":572,"_26000":508,"_18071":43859,"_5":17966,"_24599":43660,"_2447":43860},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2937":573,"_26000":508,"_18071":43862,"_5":17966,"_24599":43660,"_2447":43863},[],"The decision is made with the domain operation context:",{"_2937":574,"_26000":508,"_18071":43865,"_5":17966,"_24599":43660,"_2447":43866},[],"The middleware extracts the credential and resolves the matching principals.",{"_2937":575,"_26000":508,"_18071":43868,"_5":17966,"_24599":43660,"_2447":43869},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2937":576,"_26000":508,"_18071":43871,"_5":17966,"_24599":43660,"_2447":43872},[],"`authz` gathers the entity rules of the granted policies.",{"_2937":577,"_26000":508,"_18071":43874,"_5":17966,"_24599":43660,"_2447":43875},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2937":578,"_26000":508,"_18071":43877,"_5":17966,"_24599":43660,"_2447":43878},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2937":579,"_26000":508,"_18071":43880,"_5":17966,"_24599":43660,"_2447":43881},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2937":580,"_26000":508,"_18071":43883,"_5":17966,"_24599":43660,"_2447":43884},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2937":581,"_26000":508,"_18071":43886,"_5":17966,"_24599":43660,"_2447":43887},[],"Actions fall into two groups:",{"_2937":582,"_26000":508,"_18071":43889,"_5":17966,"_24599":43660,"_2447":43890},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2937":583,"_26000":508,"_18071":43892,"_5":17966,"_24599":43660,"_2447":43893},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2937":584,"_26000":508,"_18071":43895,"_5":17966,"_24599":43660,"_2447":43896},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2937":585,"_26000":508,"_18071":43898,"_5":17966,"_24599":43664,"_2447":43899},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2937":586,"_26000":508,"_18071":43901,"_5":17966,"_24599":43664,"_2447":43902},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2937":587,"_26000":508,"_18071":43904,"_5":17966,"_24599":43664,"_2447":43905},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2937":588,"_26000":508,"_18071":43907,"_5":17966,"_24599":43668,"_2447":43908},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2937":589,"_26000":508,"_18071":43910,"_5":17966,"_24599":43668,"_2447":43911},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2937":590,"_26000":508,"_18071":43913,"_5":17966,"_24599":43668,"_2447":43914},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2937":591,"_26000":508,"_18071":43916,"_5":17966,"_24599":43668,"_2447":43917},[],"The implemented operators are:",{"_2937":592,"_26000":508,"_18071":43919,"_5":17966,"_24599":43668,"_2447":43920},[],"`equals`, for exact equality;",{"_2937":593,"_26000":508,"_18071":43922,"_5":17966,"_24599":43668,"_2447":43923},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2937":594,"_26000":508,"_18071":43925,"_5":17966,"_24599":43668,"_2447":43926},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2937":595,"_26000":508,"_18071":43928,"_5":17966,"_24599":43668,"_2447":43929},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2937":596,"_26000":508,"_18071":43931,"_5":17966,"_24599":43672,"_2447":43932},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2937":597,"_26000":508,"_18071":43934,"_5":17966,"_24599":43672,"_2447":43935},[],"The available modes are:",{"_2937":598,"_26000":508,"_18071":43937,"_5":17966,"_24599":43672,"_2447":43938},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2937":599,"_26000":508,"_18071":43940,"_5":17966,"_24599":43672,"_2447":43941},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2937":600,"_26000":508,"_18071":43943,"_5":17966,"_24599":43672,"_2447":43944},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2937":601,"_26000":508,"_18071":43946,"_5":17966,"_24599":43672,"_2447":43947},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2937":602,"_26000":508,"_18071":43949,"_5":17966,"_24599":43672,"_2447":43950},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2937":603,"_26000":508,"_18071":43952,"_5":17966,"_24599":43672,"_2447":43953},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2937":604,"_26000":508,"_18071":43955,"_5":17966,"_24599":43676,"_2447":43956},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2937":605,"_26000":508,"_18071":43958,"_5":17966,"_24599":43676,"_2447":43959},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2937":606,"_26000":508,"_18071":43961,"_5":17966,"_24599":43676,"_2447":43962},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2937":607,"_26000":508,"_18071":43964,"_5":17966,"_24599":43676,"_2447":43965},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2937":608,"_26000":508,"_18071":43967,"_5":17966,"_24599":43684,"_2447":43968},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2937":609,"_26000":508,"_18071":43970,"_5":17966,"_24599":43684,"_2447":43971},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2937":610,"_26000":508,"_18071":43973,"_5":17966,"_24599":43688,"_2447":43974},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2937":611,"_26000":508,"_18071":43976,"_5":17966,"_24599":43688,"_2447":43977},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2937":612,"_26000":508,"_18071":43979,"_5":17966,"_24599":43692,"_2447":43980},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2937":613,"_26000":508,"_18071":43982,"_5":17966,"_24599":43692,"_2447":43983},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2937":614,"_26000":508,"_18071":43985,"_5":17966,"_24599":43692,"_2447":43986},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2937":615,"_26000":508,"_18071":43988,"_5":17966,"_24599":43696,"_2447":43989},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2937":616,"_26000":508,"_18071":43991,"_5":17966,"_24599":43696,"_2447":43992},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2937":617,"_26000":508,"_18071":43994,"_5":17966,"_24599":43696,"_2447":43995},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2937":618,"_26000":508,"_18071":43997,"_5":17966,"_24599":43696,"_2447":43998},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2937":619,"_26000":508,"_18071":44000,"_5":17966,"_24599":43696,"_2447":44001},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2937":620,"_26000":508,"_18071":44003,"_5":17966,"_24599":43696,"_2447":44004},[],"Note that:",{"_2937":621,"_26000":508,"_18071":44006,"_5":17966,"_24599":43696,"_2447":44007},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2937":622,"_26000":508,"_18071":44009,"_5":17966,"_24599":43696,"_2447":44010},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2937":623,"_26000":508,"_18071":44012,"_5":17966,"_24599":43696,"_2447":44013},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2937":624,"_26000":508,"_18071":44015,"_5":17966,"_24599":43700,"_2447":44016},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2937":625,"_26000":508,"_18071":44018,"_5":17966,"_24599":43700,"_2447":44019},[],"full and read-only access to certificates and authorities;",{"_2937":626,"_26000":508,"_18071":44021,"_5":17966,"_24599":43700,"_2447":44022},[],"full and read-only access to the KMS;",{"_2937":627,"_26000":508,"_18071":44024,"_5":17966,"_24599":43700,"_2447":44025},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2937":628,"_26000":508,"_18071":44027,"_5":17966,"_24599":43700,"_2447":44028},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2937":629,"_26000":508,"_18071":44030,"_5":17966,"_24599":43700,"_2447":44031},[],"console access;",{"_2937":630,"_26000":508,"_18071":44033,"_5":17966,"_24599":43700,"_2447":44034},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2937":631,"_26000":508,"_18071":44036,"_5":17966,"_24599":43700,"_2447":44037},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2937":632,"_26000":508,"_18071":44039,"_5":17966,"_24599":43700,"_2447":44040},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2937":633,"_26000":508,"_18071":44042,"_5":17966,"_24599":43704,"_2447":44043},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2937":634,"_26000":508,"_18071":44045,"_5":17966,"_24599":43704,"_2447":44046},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2937":635,"_26000":508,"_18071":44048,"_5":17966,"_24599":43704,"_2447":44049},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2937":636,"_26000":508,"_18071":44051,"_5":17966,"_24599":43707,"_2447":44052},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2937":637,"_26000":508,"_18071":44054,"_5":17966,"_24599":43711,"_2447":44055},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2937":638,"_26000":508,"_18071":44057,"_5":17966,"_24599":43715,"_2447":44058},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2937":639,"_26000":508,"_18071":44060,"_5":17966,"_24599":43719,"_2447":44061},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2937":640,"_26000":508,"_18071":44063,"_5":17966,"_24599":43723,"_2447":44064},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2937":641,"_26000":508,"_18071":44066,"_5":17966,"_24599":43727,"_2447":44067},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2937":642,"_26000":508,"_18071":44069,"_5":17966,"_24599":43727,"_2447":44070},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2937":643,"_26000":508,"_18071":44072,"_5":17966,"_24599":43731,"_2447":44073},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2937":644,"_26000":508,"_18071":44075,"_5":17966,"_24599":43731,"_2447":44076},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2937":645,"_26000":508,"_18071":44078,"_5":17966,"_24599":43731,"_2447":44079},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2937":646,"_26000":508,"_18071":44081,"_5":17966,"_24599":43731,"_2447":44082},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2937":647,"_26000":508,"_18071":44084,"_5":17966,"_24599":43731,"_2447":44085},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2937":648,"_26000":508,"_18071":44087,"_5":17966,"_24599":43731,"_2447":44088},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2937":649,"_26000":508,"_18071":44090,"_5":17966,"_24599":43731,"_2447":44091},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2937":650,"_26000":508,"_18071":44093,"_5":17966,"_24599":43731,"_2447":44094},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2937":651,"_26000":508,"_18071":44096,"_5":17966,"_24599":43735,"_2447":44097},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2937":652,"_26000":508,"_18071":44099,"_5":17966,"_24599":43735,"_2447":44100},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2937":653,"_26000":508,"_18071":44102,"_5":17966,"_24599":43735,"_2447":44103},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2937":654,"_26000":508,"_18071":44105,"_5":17966,"_24599":43739,"_2447":44106},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2937":655,"_26000":508,"_18071":44108,"_5":17966,"_24599":43739,"_2447":44109},[],"Use groups or stable roles for people and independent identities for automations.",{"_2937":656,"_26000":508,"_18071":44111,"_5":17966,"_24599":43739,"_2447":44112},[],"Keep at least two recovery administrators and test their access periodically.",{"_2937":657,"_26000":508,"_18071":44114,"_5":17966,"_24599":43739,"_2447":44115},[],"Review active principals, their matches and their grants after IdP changes.",{"_2937":658,"_26000":508,"_18071":44117,"_5":17966,"_24599":43739,"_2447":44118},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2937":659,"_26000":508,"_18071":44120,"_5":17966,"_24599":43739,"_2447":44121},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2937":660,"_26000":508,"_18071":44123,"_5":17966,"_24599":43739,"_2447":44124},[],"Always test one allowed and one denied operation for each role.",{"_2937":661,"_26000":508,"_18071":44126,"_5":17966,"_24599":43739,"_2447":44127},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2937":662,"_26000":508,"_18071":44129,"_5":17966,"_24599":43747,"_2447":44130},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2937":663,"_26000":508,"_18071":44132,"_5":17966,"_24599":43751,"_2447":44133},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2937":664,"_26000":508,"_18071":44135,"_5":17966,"_24599":43751,"_2447":44136},[],"that an active principal of the correct type exists;",{"_2937":665,"_26000":508,"_18071":44138,"_5":17966,"_24599":43751,"_2447":44139},[],"that the claim paths and values match the real token exactly;",{"_2937":666,"_26000":508,"_18071":44141,"_5":17966,"_24599":43751,"_2447":44142},[],"that all of the principal's conditions hold;",{"_2937":667,"_26000":508,"_18071":44144,"_5":17966,"_24599":43751,"_2447":44145},[],"that the principal has the expected policy granted;",{"_2937":668,"_26000":508,"_18071":44147,"_5":17966,"_24599":43751,"_2447":44148},[],"that the policy includes the action and the requested resource type or route;",{"_2937":669,"_26000":508,"_18071":44150,"_5":17966,"_24599":43751,"_2447":44151},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2937":670,"_26000":508,"_18071":44153,"_5":17966,"_24599":43751,"_2447":44154},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2937":671,"_26000":508,"_18071":44156,"_5":17966,"_24599":43755,"_2447":44157},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2937":672,"_26000":508,"_18071":44159,"_5":17966,"_24599":43759,"_2447":44160},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2937":673,"_26000":508,"_18071":44162,"_5":17966,"_24599":43763,"_2447":44163},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2937":674,"_26000":508,"_18071":44165,"_5":17966,"_24599":43763,"_2447":44166},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2937":675,"_26000":675,"_5":12545,"_2447":44168,"_26339":44169,"_18071":44170,"_24599":675},"Alerts and subscriptions",[42089,43636,43637],[],{"_2937":676,"_26000":675,"_18071":44172,"_5":17966,"_24599":675,"_2447":44173},[],"Send PKI events to people and external systems.",{"_2937":677,"_26000":675,"_5":26336,"_18071":44175,"_24599":44176,"_2447":44177},[],"/docs/pr-preview/pr-26/platform/administration/alerts#how-it-works","How it works",{"_2937":678,"_26000":675,"_5":26336,"_18071":44179,"_24599":44180,"_2447":44181},[],"/docs/pr-preview/pr-26/platform/administration/alerts#available-channels","Available channels",{"_2937":679,"_26000":675,"_5":26336,"_18071":44183,"_24599":44184,"_2447":44185},[],"/docs/pr-preview/pr-26/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2937":680,"_26000":675,"_5":26336,"_18071":44187,"_24599":44188,"_2447":44189},[],"/docs/pr-preview/pr-26/platform/administration/alerts#choose-the-event","Choose the event",{"_2937":681,"_26000":675,"_5":26336,"_18071":44191,"_24599":44192,"_2447":44193},[],"/docs/pr-preview/pr-26/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2937":682,"_26000":675,"_5":26336,"_18071":44195,"_24599":44196,"_2447":44197},[],"/docs/pr-preview/pr-26/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2937":683,"_26000":675,"_5":26336,"_18071":44199,"_24599":44200,"_2447":44201},[],"/docs/pr-preview/pr-26/platform/administration/alerts#review-and-activate","Review and activate",{"_2937":684,"_26000":675,"_5":26336,"_18071":44203,"_24599":44204,"_2447":44205},[],"/docs/pr-preview/pr-26/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2937":685,"_26000":675,"_5":26336,"_18071":44207,"_24599":44208,"_2447":44209},[],"/docs/pr-preview/pr-26/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2937":686,"_26000":675,"_5":26336,"_18071":44211,"_24599":44212,"_2447":44213},[],"/docs/pr-preview/pr-26/platform/administration/alerts#event-families","Event families",{"_2937":687,"_26000":675,"_18071":44215,"_5":17966,"_24599":675,"_2447":44216},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2937":688,"_26000":675,"_18071":44218,"_5":17966,"_24599":44176,"_2447":44219},[],"A service publishes a domain event.",{"_2937":689,"_26000":675,"_18071":44221,"_5":17966,"_24599":44176,"_2447":44222},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2937":690,"_26000":675,"_18071":44224,"_5":17966,"_24599":44176,"_2447":44225},[],"Each subscription's filter decides whether it should be notified.",{"_2937":691,"_26000":675,"_18071":44227,"_5":17966,"_24599":44176,"_2447":44228},[],"Lamassu delivers the event to the configured channel.",{"_2937":692,"_26000":675,"_18071":44230,"_5":17966,"_24599":44176,"_2447":44231},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2937":693,"_26000":675,"_18071":44233,"_5":17966,"_24599":44180,"_2447":44234},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2937":694,"_26000":675,"_18071":44236,"_5":17966,"_24599":44180,"_2447":44237},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2937":695,"_26000":675,"_18071":44239,"_5":17966,"_24599":44180,"_2447":44240},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2937":696,"_26000":675,"_18071":44242,"_5":17966,"_24599":44180,"_2447":44243},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2937":697,"_26000":675,"_18071":44245,"_5":17966,"_24599":44180,"_2447":44246},[],"`apikey_options` requires `header` and `key`.",{"_2937":698,"_26000":675,"_18071":44248,"_5":17966,"_24599":44180,"_2447":44249},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2937":699,"_26000":675,"_18071":44251,"_5":17966,"_24599":44180,"_2447":44252},[],"`mtls_options` requires the inline PEM `cert_content` and `key_content`; values that reference files on the server are rejected.",{"_2937":700,"_26000":675,"_18071":44254,"_5":17966,"_24599":44180,"_2447":44255},[],"The alerts API reference documents the full `http_client` schema.",{"_2937":701,"_26000":675,"_18071":44257,"_5":17966,"_24599":44188,"_2447":44258},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2937":702,"_26000":675,"_18071":44260,"_5":17966,"_24599":44192,"_2447":44261},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2937":703,"_26000":675,"_18071":44263,"_5":17966,"_24599":44196,"_2447":44264},[],"Add a filter if you don't want to receive every instance of the event.",{"_2937":704,"_26000":675,"_18071":44266,"_5":17966,"_24599":44196,"_2447":44267},[],"**None** notifies all instances of the event.",{"_2937":705,"_26000":675,"_18071":44269,"_5":17966,"_24599":44196,"_2447":44270},[],"**JSON Path** evaluates one or more specific fields.",{"_2937":706,"_26000":675,"_18071":44272,"_5":17966,"_24599":44196,"_2447":44273},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2937":707,"_26000":675,"_18071":44275,"_5":17966,"_24599":44196,"_2447":44276},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2937":708,"_26000":675,"_18071":44278,"_5":17966,"_24599":44196,"_2447":44279},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2937":709,"_26000":675,"_18071":44281,"_5":17966,"_24599":44200,"_2447":44282},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2937":710,"_26000":675,"_18071":44284,"_5":17966,"_24599":44204,"_2447":44285},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2937":711,"_26000":675,"_18071":44287,"_5":17966,"_24599":44204,"_2447":44288},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2937":712,"_26000":675,"_18071":44290,"_5":17966,"_24599":44204,"_2447":44291},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2937":713,"_26000":675,"_18071":44293,"_5":17966,"_24599":44204,"_2447":44294},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2937":714,"_26000":675,"_18071":44296,"_5":17966,"_24599":44204,"_2447":44297},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2937":715,"_26000":675,"_18071":44299,"_5":17966,"_24599":44204,"_2447":44300},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2937":716,"_26000":675,"_18071":44302,"_5":17966,"_24599":44204,"_2447":44303},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2937":717,"_26000":675,"_18071":44305,"_5":17966,"_24599":44204,"_2447":44306},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2937":718,"_26000":675,"_18071":44308,"_5":17966,"_24599":44208,"_2447":44309},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2937":719,"_26000":675,"_18071":44311,"_5":17966,"_24599":44212,"_2447":44312},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2937":720,"_26000":675,"_18071":44314,"_5":17966,"_24599":44212,"_2447":44315},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2937":721,"_26000":675,"_18071":44317,"_5":17966,"_24599":44212,"_2447":44318},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2937":722,"_26000":675,"_18071":44320,"_5":17966,"_24599":44212,"_2447":44321},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2937":723,"_26000":675,"_18071":44323,"_5":17966,"_24599":44212,"_2447":44324},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2937":724,"_26000":675,"_18071":44326,"_5":17966,"_24599":44212,"_2447":44327},[],"**Validation:** `va.role.crl.create`.",{"_2937":725,"_26000":675,"_18071":44329,"_5":17966,"_24599":44212,"_2447":44330},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2937":726,"_26000":675,"_18071":44332,"_5":17966,"_24599":44212,"_2447":44333},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2937":727,"_26000":727,"_5":12545,"_2447":44335,"_26339":44336,"_18071":44337,"_24599":727},"Audit logs",[42089,43636,43637],[],{"_2937":728,"_26000":727,"_18071":44339,"_5":17966,"_24599":727,"_2447":44340},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2937":729,"_26000":727,"_5":26336,"_18071":44342,"_24599":44343,"_2447":44344},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2937":730,"_26000":727,"_5":26336,"_18071":44346,"_24599":44347,"_2447":44348},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#coverage","Coverage",{"_2937":731,"_26000":727,"_5":26336,"_18071":44350,"_24599":44351,"_2447":44352},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2937":732,"_26000":727,"_5":26336,"_18071":44354,"_24599":44355,"_2447":44356},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2937":733,"_26000":727,"_5":26336,"_18071":44358,"_24599":44359,"_2447":44360},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2937":734,"_26000":727,"_5":26336,"_18071":44362,"_24599":44363,"_2447":44364},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2937":735,"_26000":727,"_5":26336,"_18071":44366,"_24599":44367,"_2447":44368},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2937":736,"_26000":727,"_5":26336,"_18071":44370,"_24599":44371,"_2447":44372},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2937":737,"_26000":727,"_5":26336,"_18071":44374,"_24599":44375,"_2447":44376},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2937":738,"_26000":727,"_5":26336,"_18071":44378,"_24599":44379,"_2447":44380},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2937":739,"_26000":727,"_5":26336,"_18071":44382,"_24599":44383,"_2447":44384},[],"/docs/pr-preview/pr-26/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2937":740,"_26000":727,"_18071":44386,"_5":17966,"_24599":727,"_2447":44387},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2937":741,"_26000":727,"_18071":44389,"_5":17966,"_24599":44343,"_2447":44390},[],"The audit body includes:",{"_2937":742,"_26000":727,"_18071":44392,"_5":17966,"_24599":44343,"_2447":44393},[],"input: data received by the operation;",{"_2937":743,"_26000":727,"_18071":44395,"_5":17966,"_24599":44343,"_2447":44396},[],"has\\_error: whether the service returned an error;",{"_2937":744,"_26000":727,"_18071":44398,"_5":17966,"_24599":44343,"_2447":44399},[],"output: produced result or error message;",{"_2937":745,"_26000":727,"_18071":44401,"_5":17966,"_24599":44343,"_2447":44402},[],"principals: identifiers of the principals that matched the request.",{"_2937":746,"_26000":727,"_18071":44404,"_5":17966,"_24599":44343,"_2447":44405},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2937":747,"_26000":727,"_18071":44407,"_5":17966,"_24599":44343,"_2447":44408},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2937":748,"_26000":727,"_18071":44410,"_5":17966,"_24599":44347,"_2447":44411},[],"The backend applies auditing to mutations of:",{"_2937":749,"_26000":727,"_18071":44413,"_5":17966,"_24599":44347,"_2447":44414},[],"authorities, certificates and issuance profiles;",{"_2937":750,"_26000":727,"_18071":44416,"_5":17966,"_24599":44347,"_2447":44417},[],"keys and KMS engines;",{"_2937":751,"_26000":727,"_18071":44419,"_5":17966,"_24599":44347,"_2447":44420},[],"devices and identities;",{"_2937":752,"_26000":727,"_18071":44422,"_5":17966,"_24599":44347,"_2447":44423},[],"DMSs and enrollment operations;",{"_2937":753,"_26000":727,"_18071":44425,"_5":17966,"_24599":44347,"_2447":44426},[],"validation functions and CRL;",{"_2937":754,"_26000":727,"_18071":44428,"_5":17966,"_24599":44347,"_2447":44429},[],"principals, policies and authorization grants.",{"_2937":755,"_26000":727,"_18071":44431,"_5":17966,"_24599":44347,"_2447":44432},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2937":756,"_26000":727,"_18071":44434,"_5":17966,"_24599":44351,"_2447":44435},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2937":757,"_26000":727,"_18071":44437,"_5":17966,"_24599":44351,"_2447":44438},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2937":758,"_26000":727,"_18071":44440,"_5":17966,"_24599":44351,"_2447":44441},[],"Design the consumer to:",{"_2937":759,"_26000":727,"_18071":44443,"_5":17966,"_24599":44351,"_2447":44444},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2937":760,"_26000":727,"_18071":44446,"_5":17966,"_24599":44351,"_2447":44447},[],"keep the complete CloudEvent unmodified;",{"_2937":761,"_26000":727,"_18071":44449,"_5":17966,"_24599":44351,"_2447":44450},[],"record the ingestion time and detect duplicates by ID;",{"_2937":762,"_26000":727,"_18071":44452,"_5":17966,"_24599":44351,"_2447":44453},[],"encrypt in transit and at rest;",{"_2937":763,"_26000":727,"_18071":44455,"_5":17966,"_24599":44351,"_2447":44456},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2937":764,"_26000":727,"_18071":44458,"_5":17966,"_24599":44351,"_2447":44459},[],"apply an explicit retention and legal hold policy;",{"_2937":765,"_26000":727,"_18071":44461,"_5":17966,"_24599":44351,"_2447":44462},[],"alert if it stops consuming or the pending queue grows.",{"_2937":766,"_26000":727,"_18071":44464,"_5":17966,"_24599":44355,"_2447":44465},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2937":767,"_26000":727,"_18071":44467,"_5":17966,"_24599":44355,"_2447":44468},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2937":768,"_26000":727,"_18071":44470,"_5":17966,"_24599":44363,"_2447":44471},[],"Start from the reported time and normalize every source to UTC.",{"_2937":769,"_26000":727,"_18071":44473,"_5":17966,"_24599":44367,"_2447":44474},[],"Filter by event type, service source and resource identifier.",{"_2937":770,"_26000":727,"_18071":44476,"_5":17966,"_24599":44371,"_2447":44477},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2937":771,"_26000":727,"_18071":44479,"_5":17966,"_24599":44375,"_2447":44480},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2937":772,"_26000":727,"_18071":44482,"_5":17966,"_24599":44379,"_2447":44483},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2937":773,"_26000":727,"_18071":44485,"_5":17966,"_24599":44383,"_2447":44486},[],"Generate a controlled mutation in a test environment and check that:",{"_2937":774,"_26000":727,"_18071":44488,"_5":17966,"_24599":44383,"_2447":44489},[],"a successful audit event appears;",{"_2937":775,"_26000":727,"_18071":44491,"_5":17966,"_24599":44383,"_2447":44492},[],"the principal matches the identity used;",{"_2937":776,"_26000":727,"_18071":44494,"_5":17966,"_24599":44383,"_2447":44495},[],"the consumer persists it exactly once;",{"_2937":777,"_26000":727,"_18071":44497,"_5":17966,"_24599":44383,"_2447":44498},[],"it can be retrieved by resource, actor and period;",{"_2937":778,"_26000":727,"_18071":44500,"_5":17966,"_24599":44383,"_2447":44501},[],"a consumer outage raises an alert.",{"_2937":779,"_26000":727,"_18071":44503,"_5":17966,"_24599":44383,"_2447":44504},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2937":780,"_26000":780,"_5":12545,"_2447":44506,"_26339":44507,"_18071":44508,"_24599":780},"Platform architecture",[42089,43636],[],{"_2937":781,"_26000":780,"_18071":44510,"_5":17966,"_24599":780,"_2447":44511},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2937":782,"_26000":780,"_5":26336,"_18071":44513,"_24599":44514,"_2447":44515},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#control-plane","Control plane",{"_2937":783,"_26000":780,"_5":26336,"_18071":44517,"_24599":44518,"_2447":44519},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2937":784,"_26000":780,"_5":26336,"_18071":44521,"_24599":44522,"_2447":44523},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2937":785,"_26000":780,"_5":26336,"_18071":44525,"_24599":44526,"_2447":44527},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#status-and-validation","Status and validation",{"_2937":786,"_26000":780,"_5":26336,"_18071":44529,"_24599":44530,"_2447":44531},[],"/docs/pr-preview/pr-26/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2937":787,"_26000":780,"_18071":44533,"_5":17966,"_24599":780,"_2447":44534},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2937":788,"_26000":780,"_18071":44536,"_5":17966,"_24599":780,"_2447":44537},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2937":789,"_26000":780,"_18071":44539,"_5":17966,"_24599":44514,"_2447":44540},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2937":790,"_26000":780,"_18071":44542,"_5":17966,"_24599":44518,"_2447":44543},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2937":791,"_26000":780,"_18071":44545,"_5":17966,"_24599":44522,"_2447":44546},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2937":792,"_26000":780,"_18071":44548,"_5":17966,"_24599":44526,"_2447":44549},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2937":793,"_26000":780,"_18071":44551,"_5":17966,"_24599":44530,"_2447":44552},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2937":794,"_26000":794,"_5":12545,"_2447":44554,"_26339":44555,"_18071":44556,"_24599":794},"How Lamassu works",[42089,43636],[],{"_2937":795,"_26000":794,"_18071":44558,"_5":17966,"_24599":794,"_2447":44559},[],"The mental model of trust, keys, certificates and devices.",{"_2937":796,"_26000":794,"_5":26336,"_18071":44561,"_24599":44562,"_2447":44563},[],"/docs/pr-preview/pr-26/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2937":797,"_26000":794,"_5":26336,"_18071":44565,"_24599":44566,"_2447":44567},[],"/docs/pr-preview/pr-26/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2937":798,"_26000":794,"_18071":44569,"_5":17966,"_24599":794,"_2447":44570},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2937":799,"_26000":794,"_18071":44572,"_5":17966,"_24599":44562,"_2447":44573},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2937":800,"_26000":794,"_18071":44575,"_5":17966,"_24599":44562,"_2447":44576},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2937":801,"_26000":794,"_18071":44578,"_5":17966,"_24599":44562,"_2447":44579},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2937":802,"_26000":794,"_18071":44581,"_5":17966,"_24599":44562,"_2447":44582},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2937":803,"_26000":794,"_18071":44584,"_5":17966,"_24599":44562,"_2447":44585},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2937":804,"_26000":794,"_18071":44587,"_5":17966,"_24599":44566,"_2447":44588},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2937":805,"_26000":794,"_18071":44590,"_5":17966,"_24599":44566,"_2447":44591},[],"A DMS relates that CA to an enrollment policy.",{"_2937":806,"_26000":794,"_18071":44593,"_5":17966,"_24599":44566,"_2447":44594},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2937":807,"_26000":794,"_18071":44596,"_5":17966,"_24599":44566,"_2447":44597},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2937":808,"_26000":794,"_18071":44599,"_5":17966,"_24599":44566,"_2447":44600},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2937":809,"_26000":794,"_18071":44602,"_5":17966,"_24599":44566,"_2447":44603},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2937":810,"_26000":794,"_18071":44605,"_5":17966,"_24599":44566,"_2447":44606},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2937":811,"_26000":811,"_5":12545,"_2447":44608,"_26339":44609,"_18071":44611,"_24599":811},"Devices and identities",[42089,43636,44610,44608],"IoT Fleets",[],{"_2937":812,"_26000":811,"_18071":44613,"_5":17966,"_24599":811,"_2447":44614},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2937":813,"_26000":811,"_5":26336,"_18071":44616,"_24599":44617,"_2447":44618},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#device-states","Device states",{"_2937":814,"_26000":811,"_5":26336,"_18071":44620,"_24599":44621,"_2447":44622},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2937":815,"_26000":811,"_5":26336,"_18071":44624,"_24599":44625,"_2447":44626},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2937":816,"_26000":811,"_5":26336,"_18071":44628,"_24599":44629,"_2447":44630},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2937":817,"_26000":811,"_5":26336,"_18071":44632,"_24599":44633,"_2447":44634},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2937":818,"_26000":811,"_5":26336,"_18071":44636,"_24599":44637,"_2447":44638},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2937":819,"_26000":811,"_5":26336,"_18071":44640,"_24599":44641,"_2447":44642},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2937":820,"_26000":811,"_5":26336,"_18071":44644,"_24599":44645,"_2447":44646},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2937":821,"_26000":811,"_5":26336,"_18071":44648,"_24599":44649,"_2447":44650},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2937":822,"_26000":811,"_5":26336,"_18071":44652,"_24599":44653,"_2447":44654},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2937":823,"_26000":811,"_5":26336,"_18071":44656,"_24599":44657,"_2447":44658},[],"/docs/pr-preview/pr-26/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2937":824,"_26000":811,"_18071":44660,"_5":17966,"_24599":811,"_2447":44661},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2937":825,"_26000":811,"_18071":44663,"_5":17966,"_24599":811,"_2447":44664},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2937":826,"_26000":811,"_18071":44666,"_5":17966,"_24599":44617,"_2447":44667},[],"Operational view",{"_2937":827,"_26000":811,"_18071":44669,"_5":17966,"_24599":44617,"_2447":44670},[],"Meaning",{"_2937":828,"_26000":811,"_18071":44672,"_5":17966,"_24599":44617,"_2447":44673},[],"**No Identity**",{"_2937":829,"_26000":811,"_18071":44675,"_5":17966,"_24599":44617,"_2447":44676},[],"A record exists without an associated identity.",{"_2937":830,"_26000":811,"_18071":44678,"_5":17966,"_24599":44617,"_2447":44679},[],"**Active**",{"_2937":831,"_26000":811,"_18071":44681,"_5":17966,"_24599":44617,"_2447":44682},[],"The slot is active; also check certificate dates, status and usages.",{"_2937":832,"_26000":811,"_18071":44684,"_5":17966,"_24599":44617,"_2447":44685},[],"**Renewal Pending**",{"_2937":833,"_26000":811,"_18071":44687,"_5":17966,"_24599":44617,"_2447":44688},[],"The identity is in the operational renewal window.",{"_2937":834,"_26000":811,"_18071":44690,"_5":17966,"_24599":44617,"_2447":44691},[],"**Expiring Soon**",{"_2937":835,"_26000":811,"_18071":44693,"_5":17966,"_24599":44617,"_2447":44694},[],"Expiration is approaching according to configured thresholds.",{"_2937":836,"_26000":811,"_18071":44696,"_5":17966,"_24599":44617,"_2447":44697},[],"**Expired**",{"_2937":837,"_26000":811,"_18071":44699,"_5":17966,"_24599":44617,"_2447":44700},[],"The identity has expired.",{"_2937":838,"_26000":811,"_18071":44702,"_5":17966,"_24599":44617,"_2447":44703},[],"**Revoked**",{"_2937":839,"_26000":811,"_18071":44705,"_5":17966,"_24599":44617,"_2447":44706},[],"The identity is marked revoked.",{"_2937":840,"_26000":811,"_18071":44708,"_5":17966,"_24599":44617,"_2447":44709},[],"**Decommissioned**",{"_2937":841,"_26000":811,"_18071":44711,"_5":17966,"_24599":44617,"_2447":44712},[],"The record is retired and ordinary updates do not restore operation.",{"_2937":842,"_26000":811,"_18071":44714,"_5":17966,"_24599":44617,"_2447":44715},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2937":843,"_26000":811,"_18071":44717,"_5":17966,"_24599":44621,"_2447":44718},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2937":844,"_26000":811,"_18071":44720,"_5":17966,"_24599":44621,"_2447":44721},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2937":845,"_26000":811,"_18071":44723,"_5":17966,"_24599":44621,"_2447":44724},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2937":846,"_26000":811,"_18071":44726,"_5":17966,"_24599":44621,"_2447":44727},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2937":847,"_26000":811,"_18071":44729,"_5":17966,"_24599":44625,"_2447":44730},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2937":848,"_26000":811,"_18071":44732,"_5":17966,"_24599":44629,"_2447":44733},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2937":849,"_26000":811,"_18071":44735,"_5":17966,"_24599":44633,"_2447":44736},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2937":850,"_26000":811,"_18071":44738,"_5":17966,"_24599":44637,"_2447":44739},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2937":851,"_26000":811,"_18071":44741,"_5":17966,"_24599":44641,"_2447":44742},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2937":852,"_26000":811,"_18071":44744,"_5":17966,"_24599":44641,"_2447":44745},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2937":853,"_26000":811,"_18071":44747,"_5":17966,"_24599":44645,"_2447":44748},[],"From **No Identity**, use **Assign Identity**:",{"_2937":854,"_26000":811,"_18071":44750,"_5":17966,"_24599":44645,"_2447":44751},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2937":855,"_26000":811,"_18071":44753,"_5":17966,"_24599":44645,"_2447":44754},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2937":856,"_26000":811,"_18071":44756,"_5":17966,"_24599":44645,"_2447":44757},[],"Confirm and read the serial, active version and history again.",{"_2937":857,"_26000":811,"_18071":44759,"_5":17966,"_24599":44645,"_2447":44760},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2937":858,"_26000":811,"_18071":44762,"_5":17966,"_24599":44645,"_2447":44763},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2937":859,"_26000":811,"_18071":44765,"_5":17966,"_24599":44649,"_2447":44766},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2937":860,"_26000":811,"_18071":44768,"_5":17966,"_24599":44649,"_2447":44769},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2937":861,"_26000":811,"_18071":44771,"_5":17966,"_24599":44653,"_2447":44772},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2937":862,"_26000":811,"_18071":44774,"_5":17966,"_24599":44653,"_2447":44775},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2937":863,"_26000":811,"_18071":44777,"_5":17966,"_24599":44653,"_2447":44778},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2937":864,"_26000":811,"_18071":44780,"_5":17966,"_24599":44653,"_2447":44781},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2937":865,"_26000":811,"_18071":44783,"_5":17966,"_24599":44657,"_2447":44784},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2937":866,"_26000":811,"_18071":44786,"_5":17966,"_24599":44657,"_2447":44787},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2937":867,"_26000":867,"_5":12545,"_2447":44789,"_26339":44790,"_18071":44792,"_24599":867},"Bootstrap identity and authentication",[42089,43636,44610,44608,44791],"Enrollment with PKI",[],{"_2937":868,"_26000":867,"_18071":44794,"_5":17966,"_24599":867,"_2447":44795},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2937":869,"_26000":867,"_5":26336,"_18071":44797,"_24599":44798,"_2447":44799},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2937":870,"_26000":867,"_5":26336,"_18071":44801,"_24599":44802,"_2447":44803},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2937":871,"_26000":867,"_5":26336,"_18071":44805,"_24599":44806,"_2447":44807},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2937":872,"_26000":867,"_5":26336,"_18071":44809,"_24599":44810,"_2447":44811},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2937":873,"_26000":867,"_5":26336,"_18071":44813,"_24599":44814,"_2447":44815},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2937":874,"_26000":867,"_18071":44817,"_5":17966,"_24599":867,"_2447":44818},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2937":875,"_26000":867,"_18071":44820,"_5":17966,"_24599":44798,"_2447":44821},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2937":876,"_26000":867,"_18071":44823,"_5":17966,"_24599":44798,"_2447":44824},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2937":877,"_26000":867,"_18071":44826,"_5":17966,"_24599":44802,"_2447":44827},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2937":878,"_26000":867,"_18071":44829,"_5":17966,"_24599":44802,"_2447":44830},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2937":879,"_26000":867,"_18071":44832,"_5":17966,"_24599":44802,"_2447":44833},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2937":880,"_26000":867,"_18071":44835,"_5":17966,"_24599":44806,"_2447":44836},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2937":881,"_26000":867,"_18071":44838,"_5":17966,"_24599":44806,"_2447":44839},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2937":882,"_26000":867,"_18071":44841,"_5":17966,"_24599":44810,"_2447":44842},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2937":883,"_26000":867,"_18071":44844,"_5":17966,"_24599":44810,"_2447":44845},[],"Example body:",{"_2937":884,"_26000":867,"_18071":44847,"_5":17966,"_24599":44810,"_2447":44848},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2937":885,"_26000":867,"_18071":44850,"_5":17966,"_24599":44810,"_2447":44851},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2937":886,"_26000":867,"_18071":44853,"_5":17966,"_24599":44810,"_2447":44854},[],"Continuation requires a successful HTTP response and JSON:",{"_2937":887,"_26000":867,"_18071":44856,"_5":17966,"_24599":44810,"_2447":44857},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2937":888,"_26000":867,"_18071":44859,"_5":17966,"_24599":44814,"_2447":44860},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2937":889,"_26000":867,"_18071":44862,"_5":17966,"_24599":44814,"_2447":44863},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2937":890,"_26000":890,"_5":12545,"_2447":44865,"_26339":44866,"_18071":44867,"_24599":890},"Configure and operate the DMS",[42089,43636,44610,44608,44791],[],{"_2937":891,"_26000":890,"_18071":44869,"_5":17966,"_24599":890,"_2447":44870},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2937":892,"_26000":890,"_5":26336,"_18071":44872,"_24599":44873,"_2447":42099},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2937":893,"_26000":890,"_5":26336,"_18071":44875,"_24599":44876,"_2447":44877},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2937":894,"_26000":890,"_5":26336,"_18071":44879,"_24599":44880,"_2447":44881},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2937":895,"_26000":890,"_5":26336,"_18071":44883,"_24599":44884,"_2447":44885},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2937":896,"_26000":890,"_5":26336,"_18071":44887,"_24599":44888,"_2447":44889},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2937":897,"_26000":890,"_5":26336,"_18071":44891,"_24599":44892,"_2447":44893},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2937":898,"_26000":890,"_5":26336,"_18071":44895,"_24599":44896,"_2447":44897},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2937":899,"_26000":890,"_5":26336,"_18071":44899,"_24599":44900,"_2447":44901},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2937":900,"_26000":890,"_5":26336,"_18071":44903,"_24599":44904,"_2447":44905},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2937":901,"_26000":890,"_5":26336,"_18071":44907,"_24599":44908,"_2447":44909},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2937":902,"_26000":890,"_5":26336,"_18071":44911,"_24599":44912,"_2447":44913},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2937":903,"_26000":890,"_5":26336,"_18071":44915,"_24599":44916,"_2447":44917},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2937":904,"_26000":890,"_5":26336,"_18071":44919,"_24599":44920,"_2447":44921},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2937":905,"_26000":890,"_5":26336,"_18071":44923,"_24599":44924,"_2447":44925},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2937":906,"_26000":890,"_5":26336,"_18071":44927,"_24599":44928,"_2447":44929},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2937":907,"_26000":890,"_5":26336,"_18071":44931,"_24599":44932,"_2447":44933},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2937":908,"_26000":890,"_5":26336,"_18071":44935,"_24599":44936,"_2447":44937},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2937":909,"_26000":890,"_5":26336,"_18071":44939,"_24599":44940,"_2447":44941},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2937":910,"_26000":890,"_18071":44943,"_5":17966,"_24599":890,"_2447":44944},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2937":911,"_26000":890,"_18071":44946,"_5":17966,"_24599":44873,"_2447":44947},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2937":912,"_26000":890,"_18071":44949,"_5":17966,"_24599":44873,"_2447":44950},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2937":913,"_26000":890,"_18071":44952,"_5":17966,"_24599":44880,"_2447":44953},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2937":914,"_26000":890,"_18071":44955,"_5":17966,"_24599":44884,"_2447":44956},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2937":915,"_26000":890,"_18071":44958,"_5":17966,"_24599":44888,"_2447":44959},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2937":916,"_26000":890,"_18071":44961,"_5":17966,"_24599":44892,"_2447":44962},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2937":917,"_26000":890,"_18071":44964,"_5":17966,"_24599":44896,"_2447":44965},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2937":918,"_26000":890,"_18071":44967,"_5":17966,"_24599":44904,"_2447":44968},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2937":919,"_26000":890,"_18071":44970,"_5":17966,"_24599":44904,"_2447":44971},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2937":920,"_26000":890,"_18071":44973,"_5":17966,"_24599":44908,"_2447":44974},[],"`settings.enrollment_settings` field",{"_2937":921,"_26000":890,"_18071":44976,"_5":17966,"_24599":44908,"_2447":44977},[],"Decision",{"_2937":922,"_26000":890,"_18071":44979,"_5":17966,"_24599":44908,"_2447":44980},[],"`protocol`",{"_2937":923,"_26000":890,"_18071":44982,"_5":17966,"_24599":44908,"_2447":44983},[],"`EST_RFC7030` for these operations.",{"_2937":924,"_26000":890,"_18071":44985,"_5":17966,"_24599":44908,"_2447":44986},[],"`enrollment_ca`",{"_2937":925,"_26000":890,"_18071":44988,"_5":17966,"_24599":44908,"_2447":44989},[],"ID of the signing CA.",{"_2937":926,"_26000":890,"_18071":44991,"_5":17966,"_24599":44908,"_2447":44992},[],"`verify_csr_signature`",{"_2937":927,"_26000":890,"_18071":44994,"_5":17966,"_24599":44908,"_2447":44995},[],"Keep `true` to verify CSR key possession.",{"_2937":928,"_26000":890,"_18071":44997,"_5":17966,"_24599":44908,"_2447":44998},[],"`enable_replaceable_enrollment`",{"_2937":929,"_26000":890,"_18071":45000,"_5":17966,"_24599":44908,"_2447":45001},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2937":930,"_26000":890,"_18071":45003,"_5":17966,"_24599":44908,"_2447":45004},[],"`est_rfc7030_settings.auth_mode`",{"_2937":931,"_26000":890,"_18071":45006,"_5":17966,"_24599":44908,"_2447":45007},[],"One of the four authentication modes.",{"_2937":932,"_26000":890,"_18071":45009,"_5":17966,"_24599":44908,"_2447":45010},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2937":933,"_26000":890,"_18071":45012,"_5":17966,"_24599":44912,"_2447":45013},[],"The blocks are independent:",{"_2937":934,"_26000":890,"_18071":45015,"_5":17966,"_24599":44912,"_2447":45016},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2937":935,"_26000":890,"_18071":45018,"_5":17966,"_24599":44912,"_2447":45019},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2937":936,"_26000":890,"_18071":45021,"_5":17966,"_24599":44912,"_2447":45022},[],"`auth_mode`",{"_2937":937,"_26000":890,"_18071":45024,"_5":17966,"_24599":44912,"_2447":45025},[],"Control applied in the configured operation",{"_2937":938,"_26000":890,"_18071":45027,"_5":17966,"_24599":44912,"_2447":45028},[],"`CLIENT_CERTIFICATE`",{"_2937":939,"_26000":890,"_18071":45030,"_5":17966,"_24599":44912,"_2447":45031},[],"Presented certificate validation.",{"_2937":940,"_26000":890,"_18071":45033,"_5":17966,"_24599":44912,"_2447":45034},[],"`EXTERNAL_WEBHOOK`",{"_2937":941,"_26000":890,"_18071":45036,"_5":17966,"_24599":44912,"_2447":45037},[],"Configured webhook authorization.",{"_2937":942,"_26000":890,"_18071":45039,"_5":17966,"_24599":44912,"_2447":45040},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2937":943,"_26000":890,"_18071":45042,"_5":17966,"_24599":44912,"_2447":45043},[],"Certificate validation followed by webhook approval.",{"_2937":944,"_26000":890,"_18071":45045,"_5":17966,"_24599":44912,"_2447":45046},[],"`NO_AUTH`",{"_2937":945,"_26000":890,"_18071":45048,"_5":17966,"_24599":44912,"_2447":45049},[],"No DMS requester authentication.",{"_2937":946,"_26000":890,"_18071":45051,"_5":17966,"_24599":44912,"_2447":45052},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2937":947,"_26000":890,"_18071":45054,"_5":17966,"_24599":44912,"_2447":45055},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2937":948,"_26000":890,"_18071":45057,"_5":17966,"_24599":44912,"_2447":45058},[],"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers.",{"_2937":949,"_26000":890,"_18071":45060,"_5":17966,"_24599":44912,"_2447":45061},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2937":950,"_26000":890,"_18071":45063,"_5":17966,"_24599":44916,"_2447":45064},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2937":951,"_26000":890,"_18071":45066,"_5":17966,"_24599":44916,"_2447":45067},[],"`external_webhook_settings` field",{"_2937":952,"_26000":890,"_18071":45069,"_5":17966,"_24599":44916,"_2447":44977},[],{"_2937":953,"_26000":890,"_18071":45071,"_5":17966,"_24599":44916,"_2447":45072},[],"`url`",{"_2937":954,"_26000":890,"_18071":45074,"_5":17966,"_24599":44916,"_2447":45075},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2937":955,"_26000":890,"_18071":45077,"_5":17966,"_24599":44916,"_2447":45078},[],"`method`",{"_2937":956,"_26000":890,"_18071":45080,"_5":17966,"_24599":44916,"_2447":45081},[],"`POST` or `PUT`; `POST` by default.",{"_2937":957,"_26000":890,"_18071":45083,"_5":17966,"_24599":44916,"_2447":45084},[],"`name`",{"_2937":958,"_26000":890,"_18071":45086,"_5":17966,"_24599":44916,"_2447":45087},[],"Label used in service logs.",{"_2937":959,"_26000":890,"_18071":45089,"_5":17966,"_24599":44916,"_2447":45090},[],"`config.auth_mode`",{"_2937":960,"_26000":890,"_18071":45092,"_5":17966,"_24599":44916,"_2447":45093},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2937":961,"_26000":890,"_18071":45095,"_5":17966,"_24599":44916,"_2447":45096},[],"`config.apikey_options`",{"_2937":962,"_26000":890,"_18071":45098,"_5":17966,"_24599":44916,"_2447":45099},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2937":963,"_26000":890,"_18071":45101,"_5":17966,"_24599":44916,"_2447":45102},[],"`config.jwt_options`",{"_2937":964,"_26000":890,"_18071":45104,"_5":17966,"_24599":44916,"_2447":45105},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2937":965,"_26000":890,"_18071":45107,"_5":17966,"_24599":44916,"_2447":45108},[],"`config.mtls_options`",{"_2937":966,"_26000":890,"_18071":45110,"_5":17966,"_24599":44916,"_2447":45111},[],"Required for `mtls`: `cert_content` and `key_content` as inline PEM.",{"_2937":967,"_26000":890,"_18071":45113,"_5":17966,"_24599":44916,"_2447":45114},[],"`config.insecure_skip_verify`",{"_2937":968,"_26000":890,"_18071":45116,"_5":17966,"_24599":44916,"_2447":45117},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2937":969,"_26000":890,"_18071":45119,"_5":17966,"_24599":44916,"_2447":45120},[],"`config.call_timeout`",{"_2937":970,"_26000":890,"_18071":45122,"_5":17966,"_24599":44916,"_2447":45123},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2937":971,"_26000":890,"_18071":45125,"_5":17966,"_24599":44916,"_2447":45126},[],"Rules for that configuration:",{"_2937":972,"_26000":890,"_18071":45128,"_5":17966,"_24599":44916,"_2447":45129},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`.",{"_2937":973,"_26000":890,"_18071":45131,"_5":17966,"_24599":44916,"_2447":45132},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2937":974,"_26000":890,"_18071":45134,"_5":17966,"_24599":44916,"_2447":45135},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2937":975,"_26000":890,"_18071":45137,"_5":17966,"_24599":44916,"_2447":45138},[],"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped.",{"_2937":976,"_26000":890,"_18071":45140,"_5":17966,"_24599":44916,"_2447":45141},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2937":977,"_26000":890,"_18071":45143,"_5":17966,"_24599":44916,"_2447":45144},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2937":978,"_26000":890,"_18071":45146,"_5":17966,"_24599":44916,"_2447":45147},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2937":979,"_26000":890,"_18071":45149,"_5":17966,"_24599":44916,"_2447":45150},[],"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API.",{"_2937":980,"_26000":890,"_18071":45152,"_5":17966,"_24599":44920,"_2447":45153},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2937":981,"_26000":890,"_18071":45155,"_5":17966,"_24599":44924,"_2447":45156},[],"`settings.reenrollment_settings` field",{"_2937":982,"_26000":890,"_18071":45158,"_5":17966,"_24599":44924,"_2447":42475},[],{"_2937":983,"_26000":890,"_18071":45160,"_5":17966,"_24599":44924,"_2447":45161},[],"`reenrollment_delta`",{"_2937":984,"_26000":890,"_18071":45163,"_5":17966,"_24599":44924,"_2447":45164},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2937":985,"_26000":890,"_18071":45166,"_5":17966,"_24599":44924,"_2447":45167},[],"`preventive_delta`",{"_2937":986,"_26000":890,"_18071":45169,"_5":17966,"_24599":44924,"_2447":45170},[],"Preventive operational monitoring threshold.",{"_2937":987,"_26000":890,"_18071":45172,"_5":17966,"_24599":44924,"_2447":45173},[],"`critical_delta`",{"_2937":988,"_26000":890,"_18071":45175,"_5":17966,"_24599":44924,"_2447":45176},[],"Critical operational monitoring threshold.",{"_2937":989,"_26000":890,"_18071":45178,"_5":17966,"_24599":44924,"_2447":45179},[],"`enable_expired_renewal`",{"_2937":990,"_26000":890,"_18071":45181,"_5":17966,"_24599":44924,"_2447":45182},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2937":991,"_26000":890,"_18071":45184,"_5":17966,"_24599":44924,"_2447":45185},[],"`additional_validation_cas`",{"_2937":992,"_26000":890,"_18071":45187,"_5":17966,"_24599":44924,"_2447":45188},[],"Additional mTLS credential issuers during migration.",{"_2937":993,"_26000":890,"_18071":45190,"_5":17966,"_24599":44924,"_2447":45191},[],"`revoke_on_reenrollment`",{"_2937":994,"_26000":890,"_18071":45193,"_5":17966,"_24599":44924,"_2447":45194},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2937":995,"_26000":890,"_18071":45196,"_5":17966,"_24599":44924,"_2447":45197},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2937":996,"_26000":890,"_18071":45199,"_5":17966,"_24599":44928,"_2447":45200},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2937":997,"_26000":890,"_18071":45202,"_5":17966,"_24599":44932,"_2447":42469},[],{"_2937":998,"_26000":890,"_18071":45204,"_5":17966,"_24599":44932,"_2447":45205},[],"Published material",{"_2937":999,"_26000":890,"_18071":45207,"_5":17966,"_24599":44932,"_2447":45208},[],"**Include Lamassu System CA**",{"_2937":1000,"_26000":890,"_18071":45210,"_5":17966,"_24599":44932,"_2447":45211},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2937":1001,"_26000":890,"_18071":45213,"_5":17966,"_24599":44932,"_2447":45214},[],"**Include Enrollment CA**",{"_2937":1002,"_26000":890,"_18071":45216,"_5":17966,"_24599":44932,"_2447":45217},[],"Selected issuing CA certificate.",{"_2937":1003,"_26000":890,"_18071":45219,"_5":17966,"_24599":44932,"_2447":45220},[],"**Managed CAs**",{"_2937":1004,"_26000":890,"_18071":45222,"_5":17966,"_24599":44932,"_2447":45223},[],"Explicitly selected CA certificates.",{"_2937":1005,"_26000":890,"_18071":45225,"_5":17966,"_24599":44932,"_2447":45226},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2937":1006,"_26000":890,"_18071":45228,"_5":17966,"_24599":44936,"_2447":45229},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2937":1007,"_26000":890,"_18071":45231,"_5":17966,"_24599":44936,"_2447":45232},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2937":1008,"_26000":890,"_18071":45234,"_5":17966,"_24599":44936,"_2447":45235},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2937":1009,"_26000":890,"_18071":45237,"_5":17966,"_24599":44940,"_2447":45238},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2937":1010,"_26000":1010,"_5":12545,"_2447":45240,"_26339":45241,"_18071":45242,"_24599":1010},"Integrate the EST client",[42089,43636,44610,44608,44791],[],{"_2937":1011,"_26000":1010,"_18071":45244,"_5":17966,"_24599":1010,"_2447":45245},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2937":1012,"_26000":1010,"_5":26336,"_18071":45247,"_24599":45248,"_2447":42099},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2937":1013,"_26000":1010,"_5":26336,"_18071":45250,"_24599":45251,"_2447":45252},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2937":1014,"_26000":1010,"_5":26336,"_18071":45254,"_24599":45255,"_2447":45256},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2937":1015,"_26000":1010,"_5":26336,"_18071":45258,"_24599":45259,"_2447":45260},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2937":1016,"_26000":1010,"_5":26336,"_18071":45262,"_24599":45263,"_2447":45264},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2937":1017,"_26000":1010,"_5":26336,"_18071":45266,"_24599":45267,"_2447":45268},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2937":1018,"_26000":1010,"_18071":45270,"_5":17966,"_24599":1010,"_2447":45271},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2937":1019,"_26000":1010,"_18071":45273,"_5":17966,"_24599":45248,"_2447":45274},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2937":1020,"_26000":1010,"_18071":45276,"_5":17966,"_24599":45248,"_2447":45277},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2937":1021,"_26000":1010,"_18071":45279,"_5":17966,"_24599":45248,"_2447":45280},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2937":1022,"_26000":1010,"_18071":45282,"_5":17966,"_24599":45251,"_2447":45283},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2937":1023,"_26000":1010,"_18071":45285,"_5":17966,"_24599":45251,"_2447":45286},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2937":1024,"_26000":1010,"_18071":45288,"_5":17966,"_24599":45255,"_2447":45289},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2937":1025,"_26000":1010,"_18071":45291,"_5":17966,"_24599":45255,"_2447":45292},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2937":1026,"_26000":1010,"_18071":45294,"_5":17966,"_24599":45259,"_2447":45295},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2937":1027,"_26000":1010,"_18071":45297,"_5":17966,"_24599":45259,"_2447":45298},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2937":1028,"_26000":1010,"_18071":45300,"_5":17966,"_24599":45263,"_2447":45301},[],"For a root that issues directly:",{"_2937":1029,"_26000":1010,"_18071":45303,"_5":17966,"_24599":45263,"_2447":45304},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2937":1030,"_26000":1010,"_18071":45306,"_5":17966,"_24599":45263,"_2447":45307},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2937":1031,"_26000":1010,"_18071":45309,"_5":17966,"_24599":45267,"_2447":45310},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2937":1032,"_26000":1032,"_5":12545,"_2447":45312,"_26339":45313,"_18071":45314,"_24599":1032},"EST reference",[42089,43636,44610,44608,44791],[],{"_2937":1033,"_26000":1032,"_18071":45316,"_5":17966,"_24599":1032,"_2447":45317},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2937":1034,"_26000":1032,"_5":26336,"_18071":45319,"_24599":45320,"_2447":45321},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2937":1035,"_26000":1032,"_5":26336,"_18071":45323,"_24599":45324,"_2447":19605},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2937":1036,"_26000":1032,"_5":26336,"_18071":45326,"_24599":45327,"_2447":22533},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2937":1037,"_26000":1032,"_5":26336,"_18071":45329,"_24599":45330,"_2447":22540},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2937":1038,"_26000":1032,"_5":26336,"_18071":45332,"_24599":45333,"_2447":21895},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2937":1039,"_26000":1032,"_5":26336,"_18071":45335,"_24599":45336,"_2447":45337},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2937":1040,"_26000":1032,"_5":26336,"_18071":45339,"_24599":45340,"_2447":45341},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2937":1041,"_26000":1032,"_5":26336,"_18071":45343,"_24599":45344,"_2447":45345},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2937":1042,"_26000":1032,"_18071":45347,"_5":17966,"_24599":1032,"_2447":45348},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2937":1043,"_26000":1032,"_18071":45350,"_5":17966,"_24599":45320,"_2447":45351},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2937":1044,"_26000":1032,"_18071":45353,"_5":17966,"_24599":45320,"_2447":45354},[],"Operation",{"_2937":1045,"_26000":1032,"_18071":45356,"_5":17966,"_24599":45320,"_2447":45357},[],"Method",{"_2937":1046,"_26000":1032,"_18071":45359,"_5":17966,"_24599":45320,"_2447":45360},[],"Authentication and condition",{"_2937":1047,"_26000":1032,"_18071":45362,"_5":17966,"_24599":45320,"_2447":45363},[],"`/cacerts`",{"_2937":1048,"_26000":1032,"_18071":45365,"_5":17966,"_24599":45320,"_2447":45366},[],"GET",{"_2937":1049,"_26000":1032,"_18071":45368,"_5":17966,"_24599":45320,"_2447":45369},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2937":1050,"_26000":1032,"_18071":45371,"_5":17966,"_24599":45320,"_2447":45372},[],"`/simpleenroll`",{"_2937":1051,"_26000":1032,"_18071":45374,"_5":17966,"_24599":45320,"_2447":45375},[],"POST",{"_2937":1052,"_26000":1032,"_18071":45377,"_5":17966,"_24599":45320,"_2447":45378},[],"Initial authentication and DMS registration/replacement policy.",{"_2937":1053,"_26000":1032,"_18071":45380,"_5":17966,"_24599":45320,"_2447":45381},[],"`/simplereenroll`",{"_2937":1054,"_26000":1032,"_18071":45383,"_5":17966,"_24599":45320,"_2447":45375},[],{"_2937":1055,"_26000":1032,"_18071":45385,"_5":17966,"_24599":45320,"_2447":45386},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2937":1056,"_26000":1032,"_18071":45388,"_5":17966,"_24599":45320,"_2447":45389},[],"`/serverkeygen`",{"_2937":1057,"_26000":1032,"_18071":45391,"_5":17966,"_24599":45320,"_2447":45375},[],{"_2937":1058,"_26000":1032,"_18071":45393,"_5":17966,"_24599":45320,"_2447":45394},[],"Initial authentication and admission; server generation enabled.",{"_2937":1059,"_26000":1032,"_18071":45396,"_5":17966,"_24599":45320,"_2447":45397},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2937":1060,"_26000":1032,"_18071":45399,"_5":17966,"_24599":45324,"_2447":45400},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2937":1061,"_26000":1032,"_18071":45402,"_5":17966,"_24599":45324,"_2447":45403},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2937":1062,"_26000":1032,"_18071":45405,"_5":17966,"_24599":45327,"_2447":45406},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2937":1063,"_26000":1032,"_18071":45408,"_5":17966,"_24599":45327,"_2447":45409},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2937":1064,"_26000":1032,"_18071":45411,"_5":17966,"_24599":45330,"_2447":45412},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2937":1065,"_26000":1032,"_18071":45414,"_5":17966,"_24599":45330,"_2447":45415},[],"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2937":1066,"_26000":1032,"_18071":45417,"_5":17966,"_24599":45333,"_2447":45418},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2937":1067,"_26000":1032,"_18071":45420,"_5":17966,"_24599":45333,"_2447":45421},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2937":1068,"_26000":1032,"_18071":45423,"_5":17966,"_24599":45336,"_2447":45424},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2937":1069,"_26000":1032,"_18071":45426,"_5":17966,"_24599":45336,"_2447":45427},[],"Part",{"_2937":1070,"_26000":1032,"_18071":45429,"_5":17966,"_24599":45336,"_2447":45430},[],"Content after decoding its Base64",{"_2937":1071,"_26000":1032,"_18071":45432,"_5":17966,"_24599":45336,"_2447":45433},[],"`application/pkcs8`",{"_2937":1072,"_26000":1032,"_18071":45435,"_5":17966,"_24599":45336,"_2447":45436},[],"Unencrypted DER PKCS#8 private key.",{"_2937":1073,"_26000":1032,"_18071":45438,"_5":17966,"_24599":45336,"_2447":45439},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2937":1074,"_26000":1032,"_18071":45441,"_5":17966,"_24599":45336,"_2447":45442},[],"DER PKCS#7 containing the issued certificate.",{"_2937":1075,"_26000":1032,"_18071":45444,"_5":17966,"_24599":45336,"_2447":45445},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2937":1076,"_26000":1032,"_18071":45447,"_5":17966,"_24599":45340,"_2447":45448},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2937":1077,"_26000":1032,"_18071":45450,"_5":17966,"_24599":45340,"_2447":45451},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2937":1078,"_26000":1032,"_18071":45453,"_5":17966,"_24599":45340,"_2447":45454},[],"Convert and check the result:",{"_2937":1079,"_26000":1032,"_18071":45456,"_5":17966,"_24599":45340,"_2447":45457},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2937":1080,"_26000":1032,"_18071":45459,"_5":17966,"_24599":45344,"_2447":45460},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2937":1081,"_26000":1032,"_18071":45462,"_5":17966,"_24599":45344,"_2447":45463},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2937":1082,"_26000":1082,"_5":12545,"_2447":44791,"_26339":45465,"_18071":45466,"_24599":1082},[42089,43636,44610,44608,44791],[],{"_2937":1083,"_26000":1082,"_18071":45468,"_5":17966,"_24599":1082,"_2447":45469},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2937":1084,"_26000":1082,"_5":26336,"_18071":45471,"_24599":45472,"_2447":45473},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2937":1085,"_26000":1082,"_5":26336,"_18071":45475,"_24599":45476,"_2447":45477},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2937":1086,"_26000":1082,"_5":26336,"_18071":45479,"_24599":45480,"_2447":45481},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2937":1087,"_26000":1082,"_5":26336,"_18071":45483,"_24599":45484,"_2447":45485},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2937":1088,"_26000":1082,"_18071":45487,"_5":17966,"_24599":1082,"_2447":45488},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2937":1089,"_26000":1082,"_18071":45490,"_5":17966,"_24599":45472,"_2447":45491},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2937":1090,"_26000":1082,"_18071":45493,"_5":17966,"_24599":45472,"_2447":45494},[],"The integrator installs initial EST server trust and an admission credential.",{"_2937":1091,"_26000":1082,"_18071":45496,"_5":17966,"_24599":45472,"_2447":45497},[],"The client requests an identity for its `Device ID` through EST.",{"_2937":1092,"_26000":1082,"_18071":45499,"_5":17966,"_24599":45472,"_2447":45500},[],"Certificate, device binding and key/certificate installation are checked.",{"_2937":1093,"_26000":1082,"_18071":45502,"_5":17966,"_24599":45472,"_2447":45503},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2937":1094,"_26000":1082,"_18071":45505,"_5":17966,"_24599":45472,"_2447":45506},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2937":1095,"_26000":1082,"_18071":45508,"_5":17966,"_24599":45476,"_2447":45509},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2937":1096,"_26000":1082,"_18071":45511,"_5":17966,"_24599":45476,"_2447":45512},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2937":1097,"_26000":1082,"_18071":45514,"_5":17966,"_24599":45476,"_2447":45515},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2937":1098,"_26000":1082,"_18071":45517,"_5":17966,"_24599":45476,"_2447":45518},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2937":1099,"_26000":1082,"_18071":45520,"_5":17966,"_24599":45480,"_2447":45521},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2937":1100,"_26000":1082,"_18071":45523,"_5":17966,"_24599":45480,"_2447":45524},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2937":1101,"_26000":1082,"_18071":45526,"_5":17966,"_24599":45480,"_2447":45527},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2937":1102,"_26000":1082,"_18071":45529,"_5":17966,"_24599":45480,"_2447":45530},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2937":1103,"_26000":1082,"_18071":45532,"_5":17966,"_24599":45484,"_2447":45533},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2937":1104,"_26000":1082,"_18071":45535,"_5":17966,"_24599":45484,"_2447":45536},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2937":1105,"_26000":1105,"_5":12545,"_2447":45538,"_26339":45539,"_18071":45540,"_24599":1105},"Provisioning strategies",[42089,43636,44610,44608,44791],[],{"_2937":1106,"_26000":1105,"_18071":45542,"_5":17966,"_24599":1105,"_2447":45543},[],"Choose device registration, identity authorization and key generation.",{"_2937":1107,"_26000":1105,"_5":26336,"_18071":45545,"_24599":45546,"_2447":45547},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2937":1108,"_26000":1105,"_5":26336,"_18071":45549,"_24599":45550,"_2447":45551},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2937":1109,"_26000":1105,"_5":26336,"_18071":45553,"_24599":45554,"_2447":45555},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2937":1110,"_26000":1105,"_5":26336,"_18071":45557,"_24599":45558,"_2447":45559},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2937":1111,"_26000":1105,"_5":26336,"_18071":45561,"_24599":45562,"_2447":45563},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2937":1112,"_26000":1105,"_18071":45565,"_5":17966,"_24599":1105,"_2447":45566},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2937":1113,"_26000":1105,"_18071":45568,"_5":17966,"_24599":45546,"_2447":45569},[],"Path",{"_2937":1114,"_26000":1105,"_18071":45571,"_5":17966,"_24599":45546,"_2447":45572},[],"When the device exists",{"_2937":1115,"_26000":1105,"_18071":45574,"_5":17966,"_24599":45546,"_2447":45575},[],"What to check",{"_2937":1116,"_26000":1105,"_18071":45577,"_5":17966,"_24599":45546,"_2447":45578},[],"Manual assignment",{"_2937":1117,"_26000":1105,"_18071":45580,"_5":17966,"_24599":45546,"_2447":45581},[],"An operator creates it before associating a certificate.",{"_2937":1118,"_26000":1105,"_18071":45583,"_5":17966,"_24599":45546,"_2447":45584},[],"ID, owning DMS, certificate CN and bound serial.",{"_2937":1119,"_26000":1105,"_18071":45586,"_5":17966,"_24599":45546,"_2447":45587},[],"EST with `JITP`",{"_2937":1120,"_26000":1105,"_18071":45589,"_5":17966,"_24599":45546,"_2447":45590},[],"Created for an unknown CN during `/simpleenroll`.",{"_2937":1121,"_26000":1105,"_18071":45592,"_5":17966,"_24599":45546,"_2447":45593},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2937":1122,"_26000":1105,"_18071":45595,"_5":17966,"_24599":45546,"_2447":45596},[],"EST with `PRE_REGISTRATION`",{"_2937":1123,"_26000":1105,"_18071":45598,"_5":17966,"_24599":45546,"_2447":45599},[],"Must exist before `/simpleenroll`.",{"_2937":1124,"_26000":1105,"_18071":45601,"_5":17966,"_24599":45546,"_2447":45602},[],"Approved record, same DMS and replacement conditions for your version.",{"_2937":1125,"_26000":1105,"_18071":45604,"_5":17966,"_24599":45546,"_2447":45605},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2937":1126,"_26000":1105,"_18071":45607,"_5":17966,"_24599":45546,"_2447":45608},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2937":1127,"_26000":1105,"_18071":45610,"_5":17966,"_24599":45550,"_2447":45611},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2937":1128,"_26000":1105,"_18071":45613,"_5":17966,"_24599":45550,"_2447":45614},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2937":1129,"_26000":1105,"_18071":45616,"_5":17966,"_24599":45550,"_2447":45617},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2937":1130,"_26000":1105,"_18071":45619,"_5":17966,"_24599":45554,"_2447":45620},[],"Decide initial enrollment and re-enrollment separately:",{"_2937":1131,"_26000":1105,"_18071":45622,"_5":17966,"_24599":45554,"_2447":45623},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2937":1132,"_26000":1105,"_18071":45625,"_5":17966,"_24599":45554,"_2447":45626},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2937":1133,"_26000":1105,"_18071":45628,"_5":17966,"_24599":45554,"_2447":45629},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2937":1134,"_26000":1105,"_18071":45631,"_5":17966,"_24599":45554,"_2447":45632},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2937":1135,"_26000":1105,"_18071":45634,"_5":17966,"_24599":45554,"_2447":45635},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2937":1136,"_26000":1105,"_18071":45637,"_5":17966,"_24599":45558,"_2447":42469},[],{"_2937":1137,"_26000":1105,"_18071":45639,"_5":17966,"_24599":45558,"_2447":45640},[],"Material crossing EST",{"_2937":1138,"_26000":1105,"_18071":45642,"_5":17966,"_24599":45558,"_2447":45643},[],"Device-generated key",{"_2937":1139,"_26000":1105,"_18071":45645,"_5":17966,"_24599":45558,"_2447":45646},[],"Public CSR and certificate; the key stays on the client.",{"_2937":1140,"_26000":1105,"_18071":45648,"_5":17966,"_24599":45558,"_2447":45649},[],"Existing device key",{"_2937":1141,"_26000":1105,"_18071":45651,"_5":17966,"_24599":45558,"_2447":45652},[],"CSR signed with that key and a new certificate.",{"_2937":1142,"_26000":1105,"_18071":45654,"_5":17966,"_24599":45558,"_2447":44929},[],{"_2937":1143,"_26000":1105,"_18071":45656,"_5":17966,"_24599":45558,"_2447":45657},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2937":1144,"_26000":1105,"_18071":45659,"_5":17966,"_24599":45558,"_2447":45660},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2937":1145,"_26000":1105,"_18071":45662,"_5":17966,"_24599":45562,"_2447":45663},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2937":1146,"_26000":1146,"_5":12545,"_2447":45665,"_26339":45666,"_18071":45667,"_24599":1146},"Renewal and recovery",[42089,43636,44610,44608,44791],[],{"_2937":1147,"_26000":1146,"_18071":45669,"_5":17966,"_24599":1146,"_2447":45670},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2937":1148,"_26000":1146,"_5":26336,"_18071":45672,"_24599":45673,"_2447":45674},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2937":1149,"_26000":1146,"_5":26336,"_18071":45676,"_24599":45677,"_2447":45678},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2937":1150,"_26000":1146,"_5":26336,"_18071":45680,"_24599":45681,"_2447":45682},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2937":1151,"_26000":1146,"_5":26336,"_18071":45684,"_24599":45685,"_2447":45686},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2937":1152,"_26000":1146,"_5":26336,"_18071":45688,"_24599":45689,"_2447":45690},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2937":1153,"_26000":1146,"_18071":45692,"_5":17966,"_24599":1146,"_2447":45693},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2937":1154,"_26000":1146,"_18071":45695,"_5":17966,"_24599":45673,"_2447":45696},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2937":1155,"_26000":1146,"_18071":45698,"_5":17966,"_24599":45673,"_2447":45699},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2937":1156,"_26000":1146,"_18071":45701,"_5":17966,"_24599":45673,"_2447":45702},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2937":1157,"_26000":1146,"_18071":45704,"_5":17966,"_24599":45673,"_2447":45705},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2937":1158,"_26000":1146,"_18071":45707,"_5":17966,"_24599":45677,"_2447":45708},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2937":1159,"_26000":1146,"_18071":45710,"_5":17966,"_24599":45677,"_2447":45711},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2937":1160,"_26000":1146,"_18071":45713,"_5":17966,"_24599":45681,"_2447":45714},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2937":1161,"_26000":1146,"_18071":45716,"_5":17966,"_24599":45681,"_2447":45717},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2937":1162,"_26000":1146,"_18071":45719,"_5":17966,"_24599":45681,"_2447":45720},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2937":1163,"_26000":1146,"_18071":45722,"_5":17966,"_24599":45685,"_2447":45723},[],"Situation",{"_2937":1164,"_26000":1146,"_18071":45725,"_5":17966,"_24599":45685,"_2447":45726},[],"Procedure",{"_2937":1165,"_26000":1146,"_18071":45728,"_5":17966,"_24599":45685,"_2447":45729},[],"Valid certificate, outside the window",{"_2937":1166,"_26000":1146,"_18071":45731,"_5":17966,"_24599":45685,"_2447":45732},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2937":1167,"_26000":1146,"_18071":45734,"_5":17966,"_24599":45685,"_2447":45735},[],"Expired certificate, key available",{"_2937":1168,"_26000":1146,"_18071":45737,"_5":17966,"_24599":45685,"_2447":45738},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2937":1169,"_26000":1146,"_18071":45740,"_5":17966,"_24599":45685,"_2447":45741},[],"Renewal through webhook or `NO_AUTH`",{"_2937":1170,"_26000":1146,"_18071":45743,"_5":17966,"_24599":45685,"_2447":45744},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2937":1171,"_26000":1146,"_18071":45746,"_5":17966,"_24599":45685,"_2447":45747},[],"Lost or inaccessible key",{"_2937":1172,"_26000":1146,"_18071":45749,"_5":17966,"_24599":45685,"_2447":45750},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2937":1173,"_26000":1146,"_18071":45752,"_5":17966,"_24599":45685,"_2447":45753},[],"Current identity revoked",{"_2937":1174,"_26000":1146,"_18071":45755,"_5":17966,"_24599":45685,"_2447":45756},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2937":1175,"_26000":1146,"_18071":45758,"_5":17966,"_24599":45685,"_2447":45759},[],"Device without an identity",{"_2937":1176,"_26000":1146,"_18071":45761,"_5":17966,"_24599":45685,"_2447":45762},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2937":1177,"_26000":1146,"_18071":45764,"_5":17966,"_24599":45685,"_2447":45765},[],"Retired device",{"_2937":1178,"_26000":1146,"_18071":45767,"_5":17966,"_24599":45685,"_2447":45768},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2937":1179,"_26000":1146,"_18071":45770,"_5":17966,"_24599":45685,"_2447":45771},[],"Timeout, HTTP 500 or installation failure",{"_2937":1180,"_26000":1146,"_18071":45773,"_5":17966,"_24599":45685,"_2447":45774},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2937":1181,"_26000":1146,"_18071":45776,"_5":17966,"_24599":45689,"_2447":45777},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2937":1182,"_26000":1146,"_18071":45779,"_5":17966,"_24599":45689,"_2447":45780},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2937":1183,"_26000":1183,"_5":12545,"_2447":45782,"_26339":45783,"_18071":45784,"_24599":1183},"Enrollment troubleshooting",[42089,43636,44610,44608,44791],[],{"_2937":1184,"_26000":1183,"_18071":45786,"_5":17966,"_24599":1183,"_2447":45787},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2937":1185,"_26000":1183,"_5":26336,"_18071":45789,"_24599":45790,"_2447":45791},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2937":1186,"_26000":1183,"_5":26336,"_18071":45793,"_24599":45794,"_2447":45795},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2937":1187,"_26000":1183,"_5":26336,"_18071":45797,"_24599":45798,"_2447":45345},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2937":1188,"_26000":1183,"_5":26336,"_18071":45800,"_24599":45801,"_2447":45802},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2937":1189,"_26000":1183,"_18071":45804,"_5":17966,"_24599":1183,"_2447":45805},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2937":1190,"_26000":1183,"_18071":45807,"_5":17966,"_24599":45794,"_2447":45808},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2937":1191,"_26000":1183,"_18071":45810,"_5":17966,"_24599":45794,"_2447":45811},[],"Symptom or message",{"_2937":1192,"_26000":1183,"_18071":45813,"_5":17966,"_24599":45794,"_2447":45575},[],{"_2937":1193,"_26000":1183,"_18071":45815,"_5":17966,"_24599":45794,"_2447":45816},[],"curl rejects TLS, name or issuer",{"_2937":1194,"_26000":1183,"_18071":45818,"_5":17966,"_24599":45794,"_2447":45819},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2937":1195,"_26000":1183,"_18071":45821,"_5":17966,"_24599":45794,"_2447":45822},[],"404 or missing APS",{"_2937":1196,"_26000":1183,"_18071":45824,"_5":17966,"_24599":45794,"_2447":45825},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2937":1197,"_26000":1183,"_18071":45827,"_5":17966,"_24599":45794,"_2447":45828},[],"400, CSR or format error",{"_2937":1198,"_26000":1183,"_18071":45830,"_5":17966,"_24599":45794,"_2447":45831},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2937":1199,"_26000":1183,"_18071":45833,"_5":17966,"_24599":45794,"_2447":45834},[],"Missing credential or invalid certificate",{"_2937":1200,"_26000":1183,"_18071":45836,"_5":17966,"_24599":45794,"_2447":45837},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2937":1201,"_26000":1183,"_18071":45839,"_5":17966,"_24599":45794,"_2447":45840},[],"Webhook denies, times out or responds without authorization",{"_2937":1202,"_26000":1183,"_18071":45842,"_5":17966,"_24599":45794,"_2447":45843},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2937":1203,"_26000":1183,"_18071":45845,"_5":17966,"_24599":45794,"_2447":45846},[],"`unexpected status code: <n>: redirects are not followed`",{"_2937":1204,"_26000":1183,"_18071":45848,"_5":17966,"_24599":45794,"_2447":45849},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2937":1205,"_26000":1183,"_18071":45851,"_5":17966,"_24599":45794,"_2447":45852},[],"`webhook response exceeds 1048576 bytes`",{"_2937":1206,"_26000":1183,"_18071":45854,"_5":17966,"_24599":45794,"_2447":45855},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2937":1207,"_26000":1183,"_18071":45857,"_5":17966,"_24599":45794,"_2447":45858},[],"`webhook config must not reference files`",{"_2937":1208,"_26000":1183,"_18071":45860,"_5":17966,"_24599":45794,"_2447":45861},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS.",{"_2937":1209,"_26000":1183,"_18071":45863,"_5":17966,"_24599":45794,"_2447":45864},[],"400 `struct validation error` creating or updating a DMS",{"_2937":1210,"_26000":1183,"_18071":45866,"_5":17966,"_24599":45794,"_2447":45867},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2937":1211,"_26000":1183,"_18071":45869,"_5":17966,"_24599":45794,"_2447":45870},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2937":1212,"_26000":1183,"_18071":45872,"_5":17966,"_24599":45794,"_2447":45873},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2937":1213,"_26000":1183,"_18071":45875,"_5":17966,"_24599":45794,"_2447":45876},[],"`device not preregistered`",{"_2937":1214,"_26000":1183,"_18071":45878,"_5":17966,"_24599":45794,"_2447":45879},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2937":1215,"_26000":1183,"_18071":45881,"_5":17966,"_24599":45794,"_2447":45882},[],"`forbiddenNewEnrollment`",{"_2937":1216,"_26000":1183,"_18071":45884,"_5":17966,"_24599":45794,"_2447":45885},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2937":1217,"_26000":1183,"_18071":45887,"_5":17966,"_24599":45794,"_2447":45888},[],"Different owning DMS",{"_2937":1218,"_26000":1183,"_18071":45890,"_5":17966,"_24599":45794,"_2447":45891},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2937":1219,"_26000":1183,"_18071":45893,"_5":17966,"_24599":45794,"_2447":45894},[],"`invalid RawSubject bytes`",{"_2937":1220,"_26000":1183,"_18071":45896,"_5":17966,"_24599":45794,"_2447":45897},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2937":1221,"_26000":1183,"_18071":45899,"_5":17966,"_24599":45794,"_2447":45900},[],"`invalid reenroll window`",{"_2937":1222,"_26000":1183,"_18071":45902,"_5":17966,"_24599":45794,"_2447":45903},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2937":1223,"_26000":1183,"_18071":45905,"_5":17966,"_24599":45794,"_2447":45906},[],"Current certificate revoked",{"_2937":1224,"_26000":1183,"_18071":45908,"_5":17966,"_24599":45794,"_2447":45909},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2937":1225,"_26000":1183,"_18071":45911,"_5":17966,"_24599":45794,"_2447":45912},[],"CA, profile or signing error",{"_2937":1226,"_26000":1183,"_18071":45914,"_5":17966,"_24599":45794,"_2447":45915},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2937":1227,"_26000":1183,"_18071":45917,"_5":17966,"_24599":45794,"_2447":45918},[],"HTTP 200 without a device connection",{"_2937":1228,"_26000":1183,"_18071":45920,"_5":17966,"_24599":45794,"_2447":45921},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2937":1229,"_26000":1183,"_18071":45923,"_5":17966,"_24599":45794,"_2447":45924},[],"Timeout or error after issuance",{"_2937":1230,"_26000":1183,"_18071":45926,"_5":17966,"_24599":45794,"_2447":45927},[],"New certificates, current slot and previous identity's state before retrying.",{"_2937":1231,"_26000":1183,"_18071":45929,"_5":17966,"_24599":45798,"_2447":45930},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2937":1232,"_26000":1183,"_18071":45932,"_5":17966,"_24599":45798,"_2447":45933},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2937":1233,"_26000":1183,"_18071":45935,"_5":17966,"_24599":45801,"_2447":45936},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2937":1234,"_26000":1183,"_18071":45938,"_5":17966,"_24599":45801,"_2447":45939},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2937":1235,"_26000":1183,"_18071":45941,"_5":17966,"_24599":45801,"_2447":45942},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2937":1236,"_26000":1183,"_18071":45944,"_5":17966,"_24599":45801,"_2447":45945},[],"Make one request, save headers/body and query the device and certificates.",{"_2937":1237,"_26000":1183,"_18071":45947,"_5":17966,"_24599":45801,"_2447":45948},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2937":1238,"_26000":1183,"_18071":45950,"_5":17966,"_24599":45801,"_2447":45951},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2937":1239,"_26000":1183,"_18071":45953,"_5":17966,"_24599":45801,"_2447":45954},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2937":1240,"_26000":1240,"_5":12545,"_2447":45956,"_26339":45957,"_18071":45958,"_24599":1240},"Trust distribution and updates",[42089,43636,44610,44608,44791],[],{"_2937":1241,"_26000":1240,"_18071":45960,"_5":17966,"_24599":1240,"_2447":45961},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2937":1242,"_26000":1240,"_5":26336,"_18071":45963,"_24599":45964,"_2447":45965},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2937":1243,"_26000":1240,"_5":26336,"_18071":45967,"_24599":45968,"_2447":45969},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2937":1244,"_26000":1240,"_5":26336,"_18071":45971,"_24599":45972,"_2447":45973},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2937":1245,"_26000":1240,"_5":26336,"_18071":45975,"_24599":45976,"_2447":45977},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2937":1246,"_26000":1240,"_5":26336,"_18071":45979,"_24599":45980,"_2447":45981},[],"/docs/pr-preview/pr-26/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2937":1247,"_26000":1240,"_18071":45983,"_5":17966,"_24599":1240,"_2447":45984},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2937":1248,"_26000":1240,"_18071":45986,"_5":17966,"_24599":45964,"_2447":45987},[],"Relationship",{"_2937":1249,"_26000":1240,"_18071":45989,"_5":17966,"_24599":45964,"_2447":45990},[],"Material prepared by its owner",{"_2937":1250,"_26000":1240,"_18071":45992,"_5":17966,"_24599":45964,"_2447":45993},[],"Device → EST server",{"_2937":1251,"_26000":1240,"_18071":45995,"_5":17966,"_24599":45964,"_2447":45996},[],"Previously verified server root, chain or pin and TLS name.",{"_2937":1252,"_26000":1240,"_18071":45998,"_5":17966,"_24599":45964,"_2447":45999},[],"DMS → requester",{"_2937":1253,"_26000":1240,"_18071":46001,"_5":17966,"_24599":45964,"_2447":46002},[],"CAs and rules authorizing initial or renewal credentials.",{"_2937":1254,"_26000":1240,"_18071":46004,"_5":17966,"_24599":45964,"_2447":46005},[],"Consumer → device",{"_2937":1255,"_26000":1240,"_18071":46007,"_5":17966,"_24599":45964,"_2447":46008},[],"Operational identity roots, intermediates, validation and permissions.",{"_2937":1256,"_26000":1240,"_18071":46010,"_5":17966,"_24599":45964,"_2447":46011},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2937":1257,"_26000":1240,"_18071":46013,"_5":17966,"_24599":45968,"_2447":46014},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2937":1258,"_26000":1240,"_18071":46016,"_5":17966,"_24599":45968,"_2447":46017},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2937":1259,"_26000":1240,"_18071":46019,"_5":17966,"_24599":45972,"_2447":46020},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2937":1260,"_26000":1240,"_18071":46022,"_5":17966,"_24599":45972,"_2447":46023},[],"Select policy-approved roots as anchors.",{"_2937":1261,"_26000":1240,"_18071":46025,"_5":17966,"_24599":45972,"_2447":46026},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2937":1262,"_26000":1240,"_18071":46028,"_5":17966,"_24599":45972,"_2447":46029},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2937":1263,"_26000":1240,"_18071":46031,"_5":17966,"_24599":45972,"_2447":46032},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2937":1264,"_26000":1240,"_18071":46034,"_5":17966,"_24599":45972,"_2447":46035},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2937":1265,"_26000":1240,"_18071":46037,"_5":17966,"_24599":45976,"_2447":46038},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2937":1266,"_26000":1240,"_18071":46040,"_5":17966,"_24599":45976,"_2447":46041},[],"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2937":1267,"_26000":1240,"_18071":46043,"_5":17966,"_24599":45976,"_2447":46044},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2937":1268,"_26000":1240,"_18071":46046,"_5":17966,"_24599":45980,"_2447":46047},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2937":1269,"_26000":1269,"_5":12545,"_2447":46049,"_26339":46050,"_18071":46052,"_24599":1269},"AWS IoT Core",[42089,43636,44610,44608,46051],"Integrations",[],{"_2937":1270,"_26000":1269,"_18071":46054,"_5":17966,"_24599":1269,"_2447":46055},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2937":1271,"_26000":1269,"_5":26336,"_18071":46057,"_24599":46058,"_2447":46059},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2937":1272,"_26000":1269,"_5":26336,"_18071":46061,"_24599":46062,"_2447":46063},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2937":1273,"_26000":1269,"_5":26336,"_18071":46065,"_24599":46066,"_2447":46067},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2937":1274,"_26000":1269,"_5":26336,"_18071":46069,"_24599":46070,"_2447":46071},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2937":1275,"_26000":1269,"_5":26336,"_18071":46073,"_24599":46074,"_2447":46075},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2937":1276,"_26000":1269,"_5":26336,"_18071":46077,"_24599":46078,"_2447":46079},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2937":1277,"_26000":1269,"_5":26336,"_18071":46081,"_24599":46082,"_2447":46083},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2937":1278,"_26000":1269,"_5":26336,"_18071":46085,"_24599":46086,"_2447":46087},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2937":1279,"_26000":1269,"_5":26336,"_18071":46089,"_24599":46090,"_2447":46091},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2937":1280,"_26000":1269,"_5":26336,"_18071":46093,"_24599":46094,"_2447":46095},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2937":1281,"_26000":1269,"_5":26336,"_18071":46097,"_24599":46098,"_2447":46099},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2937":1282,"_26000":1269,"_5":26336,"_18071":46101,"_24599":46102,"_2447":46103},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2937":1283,"_26000":1269,"_5":26336,"_18071":46105,"_24599":46106,"_2447":46107},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2937":1284,"_26000":1269,"_5":26336,"_18071":46109,"_24599":46110,"_2447":46111},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2937":1285,"_26000":1269,"_5":26336,"_18071":46113,"_24599":46114,"_2447":46115},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2937":1286,"_26000":1269,"_5":26336,"_18071":46117,"_24599":46118,"_2447":46119},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2937":1287,"_26000":1269,"_5":26336,"_18071":46121,"_24599":46122,"_2447":46123},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2937":1288,"_26000":1269,"_5":26336,"_18071":46125,"_24599":46126,"_2447":46127},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2937":1289,"_26000":1269,"_5":26336,"_18071":46129,"_24599":46130,"_2447":46131},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2937":1290,"_26000":1269,"_5":26336,"_18071":46133,"_24599":46134,"_2447":42861},[],"/docs/pr-preview/pr-26/platform/iot-fleets/integrations/aws-iot-core#troubleshooting",{"_2937":1291,"_26000":1269,"_18071":46136,"_5":17966,"_24599":1269,"_2447":46137},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2937":1292,"_26000":1269,"_18071":46139,"_5":17966,"_24599":1269,"_2447":46140},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2937":1293,"_26000":1269,"_18071":46142,"_5":17966,"_24599":1269,"_2447":46143},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2937":1294,"_26000":1269,"_18071":46145,"_5":17966,"_24599":46058,"_2447":46146},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2937":1295,"_26000":1269,"_18071":46148,"_5":17966,"_24599":46058,"_2447":46149},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2937":1296,"_26000":1269,"_18071":46151,"_5":17966,"_24599":46058,"_2447":46152},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2937":1297,"_26000":1269,"_18071":46154,"_5":17966,"_24599":46058,"_2447":46155},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2937":1298,"_26000":1269,"_18071":46157,"_5":17966,"_24599":46062,"_2447":46158},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2937":1299,"_26000":1269,"_18071":46160,"_5":17966,"_24599":46066,"_2447":46161},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2937":1300,"_26000":1269,"_18071":46163,"_5":17966,"_24599":46066,"_2447":46164},[],"IAM action",{"_2937":1301,"_26000":1269,"_18071":46166,"_5":17966,"_24599":46066,"_2447":42475},[],{"_2937":1302,"_26000":1269,"_18071":46168,"_5":17966,"_24599":46066,"_2447":46169},[],"`iot:GetRegistrationCode`",{"_2937":1303,"_26000":1269,"_18071":46171,"_5":17966,"_24599":46066,"_2447":46172},[],"Obtain the verification code for CA registration in the Primary Account",{"_2937":1304,"_26000":1269,"_18071":46174,"_5":17966,"_24599":46066,"_2447":46175},[],"`iot:RegisterCACertificate`",{"_2937":1305,"_26000":1269,"_18071":46177,"_5":17966,"_24599":46066,"_2447":46178},[],"Register the CA in AWS IoT",{"_2937":1306,"_26000":1269,"_18071":46180,"_5":17966,"_24599":46066,"_2447":46181},[],"`iot:DescribeCACertificate`",{"_2937":1307,"_26000":1269,"_18071":46183,"_5":17966,"_24599":46066,"_2447":46184},[],"Check the CA registration status",{"_2937":1308,"_26000":1269,"_18071":46186,"_5":17966,"_24599":46066,"_2447":46187},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2937":1309,"_26000":1269,"_18071":46189,"_5":17966,"_24599":46066,"_2447":46190},[],"Create or update Things in IoT Core",{"_2937":1310,"_26000":1269,"_18071":46192,"_5":17966,"_24599":46066,"_2447":46193},[],"`iot:RegisterThing`",{"_2937":1311,"_26000":1269,"_18071":46195,"_5":17966,"_24599":46066,"_2447":46196},[],"Provision Things through a template",{"_2937":1312,"_26000":1269,"_18071":46198,"_5":17966,"_24599":46066,"_2447":46199},[],"`iot:RegisterCertificate`",{"_2937":1313,"_26000":1269,"_18071":46201,"_5":17966,"_24599":46066,"_2447":46202},[],"Register device certificates",{"_2937":1314,"_26000":1269,"_18071":46204,"_5":17966,"_24599":46066,"_2447":46205},[],"`iot:UpdateCertificate`",{"_2937":1315,"_26000":1269,"_18071":46207,"_5":17966,"_24599":46066,"_2447":46208},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2937":1316,"_26000":1269,"_18071":46210,"_5":17966,"_24599":46066,"_2447":46211},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2937":1317,"_26000":1269,"_18071":46213,"_5":17966,"_24599":46066,"_2447":46214},[],"Create and attach IoT policies",{"_2937":1318,"_26000":1269,"_18071":46216,"_5":17966,"_24599":46066,"_2447":46217},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2937":1319,"_26000":1269,"_18071":46219,"_5":17966,"_24599":46066,"_2447":46220},[],"Manage Thing groups",{"_2937":1320,"_26000":1269,"_18071":46222,"_5":17966,"_24599":46066,"_2447":46223},[],"`iot:CreateProvisioningTemplate`",{"_2937":1321,"_26000":1269,"_18071":46225,"_5":17966,"_24599":46066,"_2447":46226},[],"Create JITP templates",{"_2937":1322,"_26000":1269,"_18071":46228,"_5":17966,"_24599":46066,"_2447":46229},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2937":1323,"_26000":1269,"_18071":46231,"_5":17966,"_24599":46066,"_2447":46232},[],"Read and write the Device Shadow",{"_2937":1324,"_26000":1269,"_18071":46234,"_5":17966,"_24599":46066,"_2447":46235},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2937":1325,"_26000":1269,"_18071":46237,"_5":17966,"_24599":46070,"_2447":46238},[],"Parameter",{"_2937":1326,"_26000":1269,"_18071":46240,"_5":17966,"_24599":46070,"_2447":46241},[],"Type",{"_2937":1327,"_26000":1269,"_18071":46243,"_5":17966,"_24599":46070,"_2447":46244},[],"Required",{"_2937":1328,"_26000":1269,"_18071":46246,"_5":17966,"_24599":46070,"_2447":46247},[],"Description",{"_2937":1329,"_26000":1269,"_18071":46249,"_5":17966,"_24599":46070,"_2447":46250},[],"`connector_id`",{"_2937":1330,"_26000":1269,"_18071":46252,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1331,"_26000":1269,"_18071":46254,"_5":17966,"_24599":46070,"_2447":46255},[],"Yes",{"_2937":1332,"_26000":1269,"_18071":46257,"_5":17966,"_24599":46070,"_2447":46258},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2937":1333,"_26000":1269,"_18071":46260,"_5":17966,"_24599":46070,"_2447":46261},[],"`aws_config.region`",{"_2937":1334,"_26000":1269,"_18071":46263,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1335,"_26000":1269,"_18071":46265,"_5":17966,"_24599":46070,"_2447":46255},[],{"_2937":1336,"_26000":1269,"_18071":46267,"_5":17966,"_24599":46070,"_2447":46268},[],"AWS region where the connector operates.",{"_2937":1337,"_26000":1269,"_18071":46270,"_5":17966,"_24599":46070,"_2447":46271},[],"`aws_config.auth_method`",{"_2937":1338,"_26000":1269,"_18071":46273,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1339,"_26000":1269,"_18071":46275,"_5":17966,"_24599":46070,"_2447":46255},[],{"_2937":1340,"_26000":1269,"_18071":46277,"_5":17966,"_24599":46070,"_2447":46278},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2937":1341,"_26000":1269,"_18071":46280,"_5":17966,"_24599":46070,"_2447":46281},[],"`aws_config.access_key_id`",{"_2937":1342,"_26000":1269,"_18071":46283,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1343,"_26000":1269,"_18071":46285,"_5":17966,"_24599":46070,"_2447":46286},[],"Only with `auth_method=static`",{"_2937":1344,"_26000":1269,"_18071":46288,"_5":17966,"_24599":46070,"_2447":46289},[],"AWS access key.",{"_2937":1345,"_26000":1269,"_18071":46291,"_5":17966,"_24599":46070,"_2447":46292},[],"`aws_config.secret_access_key`",{"_2937":1346,"_26000":1269,"_18071":46294,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1347,"_26000":1269,"_18071":46296,"_5":17966,"_24599":46070,"_2447":46286},[],{"_2937":1348,"_26000":1269,"_18071":46298,"_5":17966,"_24599":46070,"_2447":46299},[],"AWS secret key.",{"_2937":1349,"_26000":1269,"_18071":46301,"_5":17966,"_24599":46070,"_2447":46302},[],"`aws_config.session_token`",{"_2937":1350,"_26000":1269,"_18071":46304,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1351,"_26000":1269,"_18071":46306,"_5":17966,"_24599":46070,"_2447":46307},[],"No",{"_2937":1352,"_26000":1269,"_18071":46309,"_5":17966,"_24599":46070,"_2447":46310},[],"Session token (with `auth_method=static`).",{"_2937":1353,"_26000":1269,"_18071":46312,"_5":17966,"_24599":46070,"_2447":46313},[],"`aws_config.role_arn`",{"_2937":1354,"_26000":1269,"_18071":46315,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1355,"_26000":1269,"_18071":46317,"_5":17966,"_24599":46070,"_2447":46318},[],"Only with `auth_method=role`",{"_2937":1356,"_26000":1269,"_18071":46320,"_5":17966,"_24599":46070,"_2447":46321},[],"ARN of the role to assume.",{"_2937":1357,"_26000":1269,"_18071":46323,"_5":17966,"_24599":46070,"_2447":46324},[],"`aws_config.endpoint_url`",{"_2937":1358,"_26000":1269,"_18071":46326,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1359,"_26000":1269,"_18071":46328,"_5":17966,"_24599":46070,"_2447":46307},[],{"_2937":1360,"_26000":1269,"_18071":46330,"_5":17966,"_24599":46070,"_2447":46331},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2937":1361,"_26000":1269,"_18071":46333,"_5":17966,"_24599":46070,"_2447":46334},[],"`subscriber_event_bus`",{"_2937":1362,"_26000":1269,"_18071":46336,"_5":17966,"_24599":46070,"_2447":15199},[],{"_2937":1363,"_26000":1269,"_18071":46338,"_5":17966,"_24599":46070,"_2447":46255},[],{"_2937":1364,"_26000":1269,"_18071":46340,"_5":17966,"_24599":46070,"_2447":46341},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2937":1365,"_26000":1269,"_18071":46343,"_5":17966,"_24599":46070,"_2447":46344},[],"`dms_manager_client`",{"_2937":1366,"_26000":1269,"_18071":46346,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1367,"_26000":1269,"_18071":46348,"_5":17966,"_24599":46070,"_2447":46255},[],{"_2937":1368,"_26000":1269,"_18071":46350,"_5":17966,"_24599":46070,"_2447":46351},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2937":1369,"_26000":1269,"_18071":46353,"_5":17966,"_24599":46070,"_2447":46354},[],"`device_manager_client`",{"_2937":1370,"_26000":1269,"_18071":46356,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1371,"_26000":1269,"_18071":46358,"_5":17966,"_24599":46070,"_2447":46255},[],{"_2937":1372,"_26000":1269,"_18071":46360,"_5":17966,"_24599":46070,"_2447":46361},[],"HTTP URL of Lamassu's Device Manager.",{"_2937":1373,"_26000":1269,"_18071":46363,"_5":17966,"_24599":46070,"_2447":46364},[],"`ca_client`",{"_2937":1374,"_26000":1269,"_18071":46366,"_5":17966,"_24599":46070,"_2447":21633},[],{"_2937":1375,"_26000":1269,"_18071":46368,"_5":17966,"_24599":46070,"_2447":46255},[],{"_2937":1376,"_26000":1269,"_18071":46370,"_5":17966,"_24599":46070,"_2447":46371},[],"HTTP URL of Lamassu's CA service.",{"_2937":1377,"_26000":1269,"_18071":46373,"_5":17966,"_24599":46074,"_2447":46374},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2937":1378,"_26000":1269,"_18071":46376,"_5":17966,"_24599":46078,"_2447":46377},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2937":1379,"_26000":1269,"_18071":46379,"_5":17966,"_24599":46078,"_2447":46380},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2937":1380,"_26000":1269,"_18071":46382,"_5":17966,"_24599":46082,"_2447":46383},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2937":1381,"_26000":1269,"_18071":46385,"_5":17966,"_24599":46082,"_2447":46386},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2937":1382,"_26000":1269,"_18071":46388,"_5":17966,"_24599":46082,"_2447":46389},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2937":1383,"_26000":1269,"_18071":46391,"_5":17966,"_24599":46082,"_2447":46392},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2937":1384,"_26000":1269,"_18071":46394,"_5":17966,"_24599":46082,"_2447":46395},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2937":1385,"_26000":1269,"_18071":46397,"_5":17966,"_24599":46082,"_2447":46398},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2937":1386,"_26000":1269,"_18071":46400,"_5":17966,"_24599":46086,"_2447":46401},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2937":1387,"_26000":1269,"_18071":46403,"_5":17966,"_24599":46090,"_2447":46404},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2937":1388,"_26000":1269,"_18071":46406,"_5":17966,"_24599":46090,"_2447":46407},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2937":1389,"_26000":1269,"_18071":46409,"_5":17966,"_24599":46094,"_2447":46410},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2937":1390,"_26000":1269,"_18071":46412,"_5":17966,"_24599":46098,"_2447":46413},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2937":1391,"_26000":1269,"_18071":46415,"_5":17966,"_24599":46098,"_2447":46416},[],"Creates or updates the IoT policies configured in the DMS.",{"_2937":1392,"_26000":1269,"_18071":46418,"_5":17966,"_24599":46098,"_2447":46419},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2937":1393,"_26000":1269,"_18071":46421,"_5":17966,"_24599":46098,"_2447":46422},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2937":1394,"_26000":1269,"_18071":46424,"_5":17966,"_24599":46098,"_2447":46425},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2937":1395,"_26000":1269,"_18071":46427,"_5":17966,"_24599":46098,"_2447":46428},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2937":1396,"_26000":1269,"_18071":46430,"_5":17966,"_24599":46098,"_2447":46431},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2937":1397,"_26000":1269,"_18071":46433,"_5":17966,"_24599":46102,"_2447":46434},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2937":1398,"_26000":1269,"_18071":46436,"_5":17966,"_24599":46102,"_2447":46437},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2937":1399,"_26000":1269,"_18071":46439,"_5":17966,"_24599":46102,"_2447":46440},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2937":1400,"_26000":1269,"_18071":46442,"_5":17966,"_24599":46106,"_2447":46443},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2937":1401,"_26000":1269,"_18071":46445,"_5":17966,"_24599":46106,"_2447":46446},[],"The full flow from the device's perspective is:",{"_2937":1402,"_26000":1269,"_18071":46448,"_5":17966,"_24599":46106,"_2447":46449},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2937":1403,"_26000":1269,"_18071":46451,"_5":17966,"_24599":46110,"_2447":46452},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2937":1404,"_26000":1269,"_18071":46454,"_5":17966,"_24599":46110,"_2447":46455},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2937":1405,"_26000":1269,"_18071":46457,"_5":17966,"_24599":46110,"_2447":46458},[],"For the JITP flow to work correctly:",{"_2937":1406,"_26000":1269,"_18071":46460,"_5":17966,"_24599":46110,"_2447":46461},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2937":1407,"_26000":1269,"_18071":46463,"_5":17966,"_24599":46110,"_2447":46464},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2937":1408,"_26000":1269,"_18071":46466,"_5":17966,"_24599":46110,"_2447":46467},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2937":1409,"_26000":1269,"_18071":46469,"_5":17966,"_24599":46110,"_2447":46470},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2937":1410,"_26000":1269,"_18071":46472,"_5":17966,"_24599":46114,"_2447":46473},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2937":1411,"_26000":1269,"_18071":46475,"_5":17966,"_24599":46114,"_2447":46476},[],"Status in Lamassu",{"_2937":1412,"_26000":1269,"_18071":46478,"_5":17966,"_24599":46114,"_2447":46479},[],"Revocation reason",{"_2937":1413,"_26000":1269,"_18071":46481,"_5":17966,"_24599":46114,"_2447":46482},[],"Status in AWS IoT Core",{"_2937":1414,"_26000":1269,"_18071":46484,"_5":17966,"_24599":46114,"_2447":46485},[],"`Active`",{"_2937":1415,"_26000":1269,"_18071":46487,"_5":17966,"_24599":46114,"_2447":46488},[],"None",{"_2937":1416,"_26000":1269,"_18071":46490,"_5":17966,"_24599":46114,"_2447":46491},[],"`ACTIVE`",{"_2937":1417,"_26000":1269,"_18071":46493,"_5":17966,"_24599":46114,"_2447":46494},[],"`Revoked`",{"_2937":1418,"_26000":1269,"_18071":46496,"_5":17966,"_24599":46114,"_2447":46497},[],"`certificateHold`",{"_2937":1419,"_26000":1269,"_18071":46499,"_5":17966,"_24599":46114,"_2447":46500},[],"`INACTIVE`",{"_2937":1420,"_26000":1269,"_18071":46502,"_5":17966,"_24599":46114,"_2447":46494},[],{"_2937":1421,"_26000":1269,"_18071":46504,"_5":17966,"_24599":46114,"_2447":46505},[],"Any other reason",{"_2937":1422,"_26000":1269,"_18071":46507,"_5":17966,"_24599":46114,"_2447":46508},[],"`REVOKED`",{"_2937":1423,"_26000":1269,"_18071":46510,"_5":17966,"_24599":46114,"_2447":46511},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2937":1424,"_26000":1269,"_18071":46513,"_5":17966,"_24599":46118,"_2447":46514},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2937":1425,"_26000":1269,"_18071":46516,"_5":17966,"_24599":46118,"_2447":46517},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2937":1426,"_26000":1269,"_18071":46519,"_5":17966,"_24599":46118,"_2447":46520},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2937":1427,"_26000":1269,"_18071":46522,"_5":17966,"_24599":46122,"_2447":46523},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2937":1428,"_26000":1269,"_18071":46525,"_5":17966,"_24599":46122,"_2447":46526},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2937":1429,"_26000":1269,"_18071":46528,"_5":17966,"_24599":46126,"_2447":46529},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2937":1430,"_26000":1269,"_18071":46531,"_5":17966,"_24599":46126,"_2447":46532},[],"There are two action types:",{"_2937":1431,"_26000":1269,"_18071":46534,"_5":17966,"_24599":46126,"_2447":46535},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2937":1432,"_26000":1269,"_18071":46537,"_5":17966,"_24599":46126,"_2447":46538},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2937":1433,"_26000":1269,"_18071":46540,"_5":17966,"_24599":46126,"_2447":46541},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2937":1434,"_26000":1269,"_18071":46543,"_5":17966,"_24599":46130,"_2447":46544},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2937":1435,"_26000":1269,"_18071":46546,"_5":17966,"_24599":46130,"_2447":46547},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2937":1436,"_26000":1269,"_18071":46549,"_5":17966,"_24599":46130,"_2447":46550},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2937":1437,"_26000":1269,"_18071":46552,"_5":17966,"_24599":46134,"_2447":46553},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2937":1438,"_26000":1269,"_18071":46555,"_5":17966,"_24599":46134,"_2447":46556},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2937":1439,"_26000":1269,"_18071":46558,"_5":17966,"_24599":46134,"_2447":46559},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2937":1440,"_26000":1269,"_18071":46561,"_5":17966,"_24599":46134,"_2447":46562},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2937":1441,"_26000":1269,"_18071":46564,"_5":17966,"_24599":46134,"_2447":46565},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2937":1442,"_26000":1269,"_18071":46567,"_5":17966,"_24599":46134,"_2447":46568},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2937":1443,"_26000":1269,"_18071":46570,"_5":17966,"_24599":46134,"_2447":46571},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2937":1444,"_26000":1269,"_18071":46573,"_5":17966,"_24599":46134,"_2447":46574},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2937":1445,"_26000":1269,"_18071":46576,"_5":17966,"_24599":46134,"_2447":46577},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2937":1446,"_26000":1269,"_18071":46579,"_5":17966,"_24599":46134,"_2447":46580},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2937":1447,"_26000":1269,"_18071":46582,"_5":17966,"_24599":46134,"_2447":46583},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2937":1448,"_26000":1269,"_18071":46585,"_5":17966,"_24599":46134,"_2447":46586},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2937":1449,"_26000":1269,"_18071":46588,"_5":17966,"_24599":46134,"_2447":46589},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2937":1450,"_26000":1269,"_18071":46591,"_5":17966,"_24599":46134,"_2447":46592},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2937":1451,"_26000":1269,"_18071":46594,"_5":17966,"_24599":46134,"_2447":46595},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2937":1452,"_26000":1269,"_18071":46597,"_5":17966,"_24599":46134,"_2447":46598},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2937":1453,"_26000":1269,"_18071":46600,"_5":17966,"_24599":46134,"_2447":46601},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2937":1454,"_26000":1269,"_18071":46603,"_5":17966,"_24599":46134,"_2447":46604},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2937":1455,"_26000":1269,"_18071":46606,"_5":17966,"_24599":46134,"_2447":46607},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2937":1456,"_26000":1269,"_18071":46609,"_5":17966,"_24599":46134,"_2447":46610},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2937":1457,"_26000":1269,"_18071":46612,"_5":17966,"_24599":46134,"_2447":46613},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2937":1458,"_26000":1458,"_5":12545,"_2447":44610,"_26339":46615,"_18071":46616,"_24599":1458},[42089,43636,44610],[],{"_2937":1459,"_26000":1458,"_18071":46618,"_5":17966,"_24599":1458,"_2447":46619},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2937":1460,"_26000":1458,"_5":26336,"_18071":46621,"_24599":46622,"_2447":46623},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#start-here","Start here",{"_2937":1461,"_26000":1458,"_5":26336,"_18071":46625,"_24599":46626,"_2447":44608},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#devices-and-identities",{"_2937":1462,"_26000":1458,"_5":26336,"_18071":46628,"_24599":46629,"_2447":44791},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#enrollment-with-pki",{"_2937":1463,"_26000":1458,"_5":26336,"_18071":46631,"_24599":46632,"_2447":46051},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#integrations",{"_2937":1464,"_26000":1458,"_5":26336,"_18071":46634,"_24599":46635,"_2447":46636},[],"/docs/pr-preview/pr-26/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2937":1465,"_26000":1458,"_18071":46638,"_5":17966,"_24599":1458,"_2447":46639},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2937":1466,"_26000":1458,"_18071":46641,"_5":17966,"_24599":46622,"_2447":46642},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2937":1467,"_26000":1458,"_18071":46644,"_5":17966,"_24599":46622,"_2447":46645},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2937":1468,"_26000":1458,"_18071":46647,"_5":17966,"_24599":46626,"_2447":46648},[],"Resource",{"_2937":1469,"_26000":1458,"_18071":46650,"_5":17966,"_24599":46626,"_2447":46651},[],"What it represents",{"_2937":1470,"_26000":1458,"_18071":46653,"_5":17966,"_24599":46626,"_2447":46654},[],"**Device**",{"_2937":1471,"_26000":1458,"_18071":46656,"_5":17966,"_24599":46626,"_2447":46657},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2937":1472,"_26000":1458,"_18071":46659,"_5":17966,"_24599":46626,"_2447":46660},[],"**Identity**",{"_2937":1473,"_26000":1458,"_18071":46662,"_5":17966,"_24599":46626,"_2447":46663},[],"The device's association with its certificates: an active version and a history.",{"_2937":1474,"_26000":1458,"_18071":46665,"_5":17966,"_24599":46626,"_2447":46666},[],"**DMS**",{"_2937":1475,"_26000":1458,"_18071":46668,"_5":17966,"_24599":46626,"_2447":46669},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2937":1476,"_26000":1458,"_18071":46671,"_5":17966,"_24599":46626,"_2447":46672},[],"**Fleet**",{"_2937":1477,"_26000":1458,"_18071":46674,"_5":17966,"_24599":46626,"_2447":46675},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2937":1478,"_26000":1458,"_18071":46677,"_5":17966,"_24599":46626,"_2447":46678},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2937":1479,"_26000":1458,"_18071":46680,"_5":17966,"_24599":46626,"_2447":46681},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2937":1480,"_26000":1458,"_18071":46683,"_5":17966,"_24599":46629,"_2447":46684},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2937":1481,"_26000":1458,"_18071":46686,"_5":17966,"_24599":46629,"_2447":46687},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2937":1482,"_26000":1458,"_18071":46689,"_5":17966,"_24599":46629,"_2447":46690},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2937":1483,"_26000":1458,"_18071":46692,"_5":17966,"_24599":46629,"_2447":46693},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2937":1484,"_26000":1458,"_18071":46695,"_5":17966,"_24599":46629,"_2447":46696},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2937":1485,"_26000":1458,"_18071":46698,"_5":17966,"_24599":46629,"_2447":46699},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2937":1486,"_26000":1458,"_18071":46701,"_5":17966,"_24599":46629,"_2447":46702},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2937":1487,"_26000":1458,"_18071":46704,"_5":17966,"_24599":46629,"_2447":46705},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2937":1488,"_26000":1458,"_18071":46707,"_5":17966,"_24599":46632,"_2447":46708},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2937":1489,"_26000":1458,"_18071":46710,"_5":17966,"_24599":46632,"_2447":46711},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2937":1490,"_26000":1458,"_18071":46713,"_5":17966,"_24599":46635,"_2447":46714},[],"Participant",{"_2937":1491,"_26000":1458,"_18071":46716,"_5":17966,"_24599":46635,"_2447":46717},[],"Responsibility",{"_2937":1492,"_26000":1458,"_18071":46719,"_5":17966,"_24599":46635,"_2447":46720},[],"PKI administrator",{"_2937":1493,"_26000":1458,"_18071":46722,"_5":17966,"_24599":46635,"_2447":46723},[],"CA, issuance profile, chain and revocation publication.",{"_2937":1494,"_26000":1458,"_18071":46725,"_5":17966,"_24599":46635,"_2447":46726},[],"Provisioning administrator",{"_2937":1495,"_26000":1458,"_18071":46728,"_5":17966,"_24599":46635,"_2447":46729},[],"DMS, admission, authentication per operation and inventory.",{"_2937":1496,"_26000":1458,"_18071":46731,"_5":17966,"_24599":46635,"_2447":46732},[],"Device integrator",{"_2937":1497,"_26000":1458,"_18071":46734,"_5":17966,"_24599":46635,"_2447":46735},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2937":1498,"_26000":1458,"_18071":46737,"_5":17966,"_24599":46635,"_2447":46738},[],"Consumer integrator",{"_2937":1499,"_26000":1458,"_18071":46740,"_5":17966,"_24599":46635,"_2447":46741},[],"Trusted issuers, validation and device permissions in the destination.",{"_2937":1500,"_26000":1458,"_18071":46743,"_5":17966,"_24599":46635,"_2447":46744},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2937":1501,"_26000":1501,"_5":12545,"_2447":46746,"_26339":46747,"_18071":46749,"_24599":1501},"Enroll and connect your first device",[42089,43636,44610,46748],"Getting started",[],{"_2937":1502,"_26000":1501,"_18071":46751,"_5":17966,"_24599":1501,"_2447":46752},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2937":1503,"_26000":1501,"_5":26336,"_18071":46754,"_24599":46755,"_2447":42099},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2937":1504,"_26000":1501,"_5":26336,"_18071":46757,"_24599":46758,"_2447":46759},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2937":1505,"_26000":1501,"_5":26336,"_18071":46761,"_24599":46762,"_2447":46763},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2937":1506,"_26000":1501,"_5":26336,"_18071":46765,"_24599":46766,"_2447":46767},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2937":1507,"_26000":1501,"_5":26336,"_18071":46769,"_24599":46770,"_2447":46771},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2937":1508,"_26000":1501,"_5":26336,"_18071":46773,"_24599":46774,"_2447":46775},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2937":1509,"_26000":1501,"_5":26336,"_18071":46777,"_24599":46778,"_2447":46779},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2937":1510,"_26000":1501,"_5":26336,"_18071":46781,"_24599":46782,"_2447":46783},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2937":1511,"_26000":1501,"_18071":46785,"_5":17966,"_24599":1501,"_2447":46786},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2937":1512,"_26000":1501,"_18071":46788,"_5":17966,"_24599":46755,"_2447":46789},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2937":1513,"_26000":1501,"_18071":46791,"_5":17966,"_24599":46755,"_2447":46792},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2937":1514,"_26000":1501,"_18071":46794,"_5":17966,"_24599":46755,"_2447":46795},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2937":1515,"_26000":1501,"_18071":46797,"_5":17966,"_24599":46755,"_2447":46798},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2937":1516,"_26000":1501,"_18071":46800,"_5":17966,"_24599":46755,"_2447":46801},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2937":1517,"_26000":1501,"_18071":46803,"_5":17966,"_24599":46758,"_2447":46804},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2937":1518,"_26000":1501,"_18071":46806,"_5":17966,"_24599":46758,"_2447":46807},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2937":1519,"_26000":1501,"_18071":46809,"_5":17966,"_24599":46762,"_2447":46810},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2937":1520,"_26000":1501,"_18071":46812,"_5":17966,"_24599":46762,"_2447":46813},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2937":1521,"_26000":1501,"_18071":46815,"_5":17966,"_24599":46762,"_2447":46816},[],"Setting",{"_2937":1522,"_26000":1501,"_18071":46818,"_5":17966,"_24599":46762,"_2447":46819},[],"Evaluation value",{"_2937":1523,"_26000":1501,"_18071":46821,"_5":17966,"_24599":46762,"_2447":46822},[],"Enrollment CA",{"_2937":1524,"_26000":1501,"_18071":46824,"_5":17966,"_24599":46762,"_2447":46825},[],"Issuing root from `device-root.pem`.",{"_2937":1525,"_26000":1501,"_18071":46827,"_5":17966,"_24599":46762,"_2447":44921},[],{"_2937":1526,"_26000":1501,"_18071":46829,"_5":17966,"_24599":46762,"_2447":46830},[],"The 1-hour leaf profile you just prepared.",{"_2937":1527,"_26000":1501,"_18071":46832,"_5":17966,"_24599":46762,"_2447":46833},[],"Protocol / Registration Mode",{"_2937":1528,"_26000":1501,"_18071":46835,"_5":17966,"_24599":46762,"_2447":46836},[],"`EST_RFC7030` / `JITP`.",{"_2937":1529,"_26000":1501,"_18071":46838,"_5":17966,"_24599":46762,"_2447":46839},[],"Verify CSR Signature",{"_2937":1530,"_26000":1501,"_18071":46841,"_5":17966,"_24599":46762,"_2447":46842},[],"Enabled.",{"_2937":1531,"_26000":1501,"_18071":46844,"_5":17966,"_24599":46762,"_2447":46845},[],"Enable Replaceable Enrollment",{"_2937":1532,"_26000":1501,"_18071":46847,"_5":17966,"_24599":46762,"_2447":46848},[],"Disabled; the ID must be new.",{"_2937":1533,"_26000":1501,"_18071":46850,"_5":17966,"_24599":46762,"_2447":46851},[],"Initial authentication",{"_2937":1534,"_26000":1501,"_18071":46853,"_5":17966,"_24599":46762,"_2447":46854},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2937":1535,"_26000":1501,"_18071":46856,"_5":17966,"_24599":46762,"_2447":46857},[],"Renewal authentication",{"_2937":1536,"_26000":1501,"_18071":46859,"_5":17966,"_24599":46762,"_2447":46860},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2937":1537,"_26000":1501,"_18071":46862,"_5":17966,"_24599":46762,"_2447":46863},[],"Additional Validation CAs / Enable Expired Renewal",{"_2937":1538,"_26000":1501,"_18071":46865,"_5":17966,"_24599":46762,"_2447":46866},[],"Empty list for this direct issuance / disabled.",{"_2937":1539,"_26000":1501,"_18071":46868,"_5":17966,"_24599":46762,"_2447":46869},[],"Re-enrollment Delta",{"_2937":1540,"_26000":1501,"_18071":46871,"_5":17966,"_24599":46762,"_2447":46872},[],"1 hour.",{"_2937":1541,"_26000":1501,"_18071":46874,"_5":17966,"_24599":46762,"_2447":46875},[],"Preventive / Critical Delta",{"_2937":1542,"_26000":1501,"_18071":46877,"_5":17966,"_24599":46762,"_2447":46878},[],"30 minutes / 10 minutes.",{"_2937":1543,"_26000":1501,"_18071":46880,"_5":17966,"_24599":46762,"_2447":46881},[],"Revoke on Re-enrollment",{"_2937":1544,"_26000":1501,"_18071":46883,"_5":17966,"_24599":46762,"_2447":46884},[],"Disabled to test the successor before retiring the previous identity.",{"_2937":1545,"_26000":1501,"_18071":46886,"_5":17966,"_24599":46762,"_2447":44929},[],{"_2937":1546,"_26000":1501,"_18071":46888,"_5":17966,"_24599":46762,"_2447":46889},[],"Disabled; the operational key is generated in the client.",{"_2937":1547,"_26000":1501,"_18071":46891,"_5":17966,"_24599":46762,"_2447":46892},[],"CA Distribution",{"_2937":1548,"_26000":1501,"_18071":46894,"_5":17966,"_24599":46762,"_2447":46895},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2937":1549,"_26000":1501,"_18071":46897,"_5":17966,"_24599":46762,"_2447":46898},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2937":1550,"_26000":1501,"_18071":46900,"_5":17966,"_24599":46766,"_2447":46901},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2937":1551,"_26000":1501,"_18071":46903,"_5":17966,"_24599":46766,"_2447":46904},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2937":1552,"_26000":1501,"_18071":46906,"_5":17966,"_24599":46770,"_2447":46907},[],"Generate a new key and CSR with the selected identifier:",{"_2937":1553,"_26000":1501,"_18071":46909,"_5":17966,"_24599":46770,"_2447":46910},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2937":1554,"_26000":1501,"_18071":46912,"_5":17966,"_24599":46770,"_2447":46913},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2937":1555,"_26000":1501,"_18071":46915,"_5":17966,"_24599":46774,"_2447":46916},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2937":1556,"_26000":1501,"_18071":46918,"_5":17966,"_24599":46774,"_2447":46919},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2937":1557,"_26000":1501,"_18071":46921,"_5":17966,"_24599":46778,"_2447":46922},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2937":1558,"_26000":1501,"_18071":46924,"_5":17966,"_24599":46778,"_2447":46925},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2937":1559,"_26000":1501,"_18071":46927,"_5":17966,"_24599":46778,"_2447":46928},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2937":1560,"_26000":1501,"_18071":46930,"_5":17966,"_24599":46778,"_2447":46931},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2937":1561,"_26000":1501,"_18071":46933,"_5":17966,"_24599":46778,"_2447":46934},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2937":1562,"_26000":1501,"_18071":46936,"_5":17966,"_24599":46782,"_2447":46937},[],"Check",{"_2937":1563,"_26000":1501,"_18071":46939,"_5":17966,"_24599":46782,"_2447":46940},[],"Expected result",{"_2937":1564,"_26000":1501,"_18071":46942,"_5":17966,"_24599":46782,"_2447":46943},[],"Registration",{"_2937":1565,"_26000":1501,"_18071":46945,"_5":17966,"_24599":46782,"_2447":46946},[],"ID created automatically and correct DMS.",{"_2937":1566,"_26000":1501,"_18071":46948,"_5":17966,"_24599":46782,"_2447":46949},[],"Certificate",{"_2937":1567,"_26000":1501,"_18071":46951,"_5":17966,"_24599":46782,"_2447":46952},[],"CN, profile, serial and key verified.",{"_2937":1568,"_26000":1501,"_18071":46954,"_5":17966,"_24599":46782,"_2447":46955},[],"Inventory",{"_2937":1569,"_26000":1501,"_18071":46957,"_5":17966,"_24599":46782,"_2447":46958},[],"Received serial visible as the current identity and in history.",{"_2937":1570,"_26000":1501,"_18071":46960,"_5":17966,"_24599":46782,"_2447":46961},[],"Consumer",{"_2937":1571,"_26000":1501,"_18071":46963,"_5":17966,"_24599":46782,"_2447":46964},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2937":1572,"_26000":1501,"_18071":46966,"_5":17966,"_24599":46782,"_2447":46967},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2937":1573,"_26000":1501,"_18071":46969,"_5":17966,"_24599":46782,"_2447":46970},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2937":1574,"_26000":1574,"_5":12545,"_2447":44626,"_26339":46972,"_18071":46973,"_24599":1574},[42089,43636,44610,46748],[],{"_2937":1575,"_26000":1574,"_18071":46975,"_5":17966,"_24599":1574,"_2447":46976},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2937":1576,"_26000":1574,"_5":26336,"_18071":46978,"_24599":46979,"_2447":42099},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2937":1577,"_26000":1574,"_5":26336,"_18071":46981,"_24599":46982,"_2447":46983},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2937":1578,"_26000":1574,"_5":26336,"_18071":46985,"_24599":46986,"_2447":46987},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2937":1579,"_26000":1574,"_5":26336,"_18071":46989,"_24599":46990,"_2447":46991},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2937":1580,"_26000":1574,"_5":26336,"_18071":46993,"_24599":46994,"_2447":46995},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2937":1581,"_26000":1574,"_5":26336,"_18071":46997,"_24599":46998,"_2447":46999},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2937":1582,"_26000":1574,"_5":26336,"_18071":47001,"_24599":47002,"_2447":46940},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2937":1583,"_26000":1574,"_5":26336,"_18071":47004,"_24599":47005,"_2447":47006},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2937":1584,"_26000":1574,"_5":26336,"_18071":47008,"_24599":47009,"_2447":47010},[],"/docs/pr-preview/pr-26/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2937":1585,"_26000":1574,"_18071":47012,"_5":17966,"_24599":1574,"_2447":47013},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2937":1586,"_26000":1574,"_18071":47015,"_5":17966,"_24599":1574,"_2447":47016},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2937":1587,"_26000":1574,"_18071":47018,"_5":17966,"_24599":46979,"_2447":47019},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2937":1588,"_26000":1574,"_18071":47021,"_5":17966,"_24599":46979,"_2447":47022},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2937":1589,"_26000":1574,"_18071":47024,"_5":17966,"_24599":46979,"_2447":47025},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2937":1590,"_26000":1574,"_18071":47027,"_5":17966,"_24599":46979,"_2447":47028},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2937":1591,"_26000":1574,"_18071":47030,"_5":17966,"_24599":46982,"_2447":47031},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2937":1592,"_26000":1574,"_18071":47033,"_5":17966,"_24599":46982,"_2447":47034},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2937":1593,"_26000":1574,"_18071":47036,"_5":17966,"_24599":46982,"_2447":47037},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2937":1594,"_26000":1574,"_18071":47039,"_5":17966,"_24599":46982,"_2447":47040},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2937":1595,"_26000":1574,"_18071":47042,"_5":17966,"_24599":46982,"_2447":47043},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2937":1596,"_26000":1574,"_18071":47045,"_5":17966,"_24599":46982,"_2447":47046},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2937":1597,"_26000":1574,"_18071":47048,"_5":17966,"_24599":46982,"_2447":47049},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2937":1598,"_26000":1574,"_18071":47051,"_5":17966,"_24599":46982,"_2447":47052},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2937":1599,"_26000":1574,"_18071":47054,"_5":17966,"_24599":46986,"_2447":47055},[],"Open **Managed Devices** and the registration action. Complete:",{"_2937":1600,"_26000":1574,"_18071":47057,"_5":17966,"_24599":46986,"_2447":47058},[],"**Device ID**: `device-001`.",{"_2937":1601,"_26000":1574,"_18071":47060,"_5":17966,"_24599":46986,"_2447":47061},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2937":1602,"_26000":1574,"_18071":47063,"_5":17966,"_24599":46986,"_2447":47064},[],"**Icon** and **Tags**: optional classification.",{"_2937":1603,"_26000":1574,"_18071":47066,"_5":17966,"_24599":46986,"_2447":47067},[],"Confirm registration.",{"_2937":1604,"_26000":1574,"_18071":47069,"_5":17966,"_24599":46990,"_2447":47070},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2937":1605,"_26000":1574,"_18071":47072,"_5":17966,"_24599":46990,"_2447":47073},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2937":1606,"_26000":1574,"_18071":47075,"_5":17966,"_24599":46994,"_2447":47076},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2937":1607,"_26000":1574,"_18071":47078,"_5":17966,"_24599":46994,"_2447":47079},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2937":1608,"_26000":1574,"_18071":47081,"_5":17966,"_24599":46998,"_2447":47082},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2937":1609,"_26000":1574,"_18071":47084,"_5":17966,"_24599":46998,"_2447":47085},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2937":1610,"_26000":1574,"_18071":47087,"_5":17966,"_24599":47002,"_2447":46937},[],{"_2937":1611,"_26000":1574,"_18071":47089,"_5":17966,"_24599":47002,"_2447":47090},[],"Result",{"_2937":1612,"_26000":1574,"_18071":47092,"_5":17966,"_24599":47002,"_2447":47093},[],"Device",{"_2937":1613,"_26000":1574,"_18071":47095,"_5":17966,"_24599":47002,"_2447":47096},[],"`device-001` appears in inventory with the expected DMS.",{"_2937":1614,"_26000":1574,"_18071":47098,"_5":17966,"_24599":47002,"_2447":47099},[],"Current identity",{"_2937":1615,"_26000":1574,"_18071":47101,"_5":17966,"_24599":47002,"_2447":47102},[],"The associated certificate matches the one you verified in PKI.",{"_2937":1616,"_26000":1574,"_18071":47104,"_5":17966,"_24599":47002,"_2447":47105},[],"History",{"_2937":1617,"_26000":1574,"_18071":47107,"_5":17966,"_24599":47002,"_2447":47108},[],"The associated issuance appears with its serial number and dates.",{"_2937":1618,"_26000":1574,"_18071":47110,"_5":17966,"_24599":47002,"_2447":47111},[],"Key and certificate",{"_2937":1619,"_26000":1574,"_18071":47113,"_5":17966,"_24599":47002,"_2447":47114},[],"You have the verified pair ready to install on the device.",{"_2937":1620,"_26000":1574,"_18071":47116,"_5":17966,"_24599":47005,"_2447":47117},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2937":1621,"_26000":1574,"_18071":47119,"_5":17966,"_24599":47005,"_2447":47120},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2937":1622,"_26000":1574,"_18071":47122,"_5":17966,"_24599":47005,"_2447":47123},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2937":1623,"_26000":1574,"_18071":47125,"_5":17966,"_24599":47005,"_2447":47126},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2937":1624,"_26000":1574,"_18071":47128,"_5":17966,"_24599":47009,"_2447":47129},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2937":1625,"_26000":1574,"_18071":47131,"_5":17966,"_24599":47009,"_2447":47132},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2937":1626,"_26000":1574,"_18071":47134,"_5":17966,"_24599":47009,"_2447":47135},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2937":1627,"_26000":1627,"_5":12545,"_2447":47137,"_26339":47138,"_18071":47139,"_24599":1627},"Lamassu IoT Platform",[42089,43636],[],{"_2937":1628,"_26000":1627,"_18071":47141,"_5":17966,"_24599":1627,"_2447":47142},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2937":1629,"_26000":1627,"_5":26336,"_18071":47144,"_24599":47145,"_2447":46623},[],"/docs/pr-preview/pr-26/platform/overview#start-here",{"_2937":1630,"_26000":1627,"_5":26336,"_18071":47147,"_24599":47148,"_2447":47149},[],"/docs/pr-preview/pr-26/platform/overview#choose-your-path","Choose your path",{"_2937":1631,"_26000":1627,"_5":26336,"_18071":47151,"_24599":47152,"_2447":47153},[],"/docs/pr-preview/pr-26/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2937":1632,"_26000":1627,"_5":26336,"_18071":47155,"_24599":47156,"_2447":47157},[],"/docs/pr-preview/pr-26/platform/overview#core-capabilities","Core capabilities",{"_2937":1633,"_26000":1627,"_5":26336,"_18071":47159,"_24599":47160,"_2447":47161},[],"/docs/pr-preview/pr-26/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2937":1634,"_26000":1627,"_5":26336,"_18071":47163,"_24599":47164,"_2447":47165},[],"/docs/pr-preview/pr-26/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2937":1635,"_26000":1627,"_5":26336,"_18071":47167,"_24599":47168,"_2447":47169},[],"/docs/pr-preview/pr-26/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2937":1636,"_26000":1627,"_5":26336,"_18071":47171,"_24599":47172,"_2447":47173},[],"/docs/pr-preview/pr-26/platform/overview#automate-device-identities","Automate device identities",{"_2937":1637,"_26000":1627,"_5":26336,"_18071":47175,"_24599":47176,"_2447":47177},[],"/docs/pr-preview/pr-26/platform/overview#publish-validation-status","Publish validation status",{"_2937":1638,"_26000":1627,"_5":26336,"_18071":47179,"_24599":47180,"_2447":47181},[],"/docs/pr-preview/pr-26/platform/overview#react-to-events","React to events",{"_2937":1639,"_26000":1627,"_5":26336,"_18071":47183,"_24599":47184,"_2447":47185},[],"/docs/pr-preview/pr-26/platform/overview#operational-reference","Operational reference",{"_2937":1640,"_26000":1627,"_18071":47187,"_5":17966,"_24599":1627,"_2447":47188},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2937":1641,"_26000":1627,"_18071":47190,"_5":17966,"_24599":47145,"_2447":47191},[],"Choose the result you need:",{"_2937":1642,"_26000":1627,"_18071":47193,"_5":17966,"_24599":47145,"_2447":47194},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2937":1643,"_26000":1627,"_18071":47196,"_5":17966,"_24599":47145,"_2447":47197},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2937":1644,"_26000":1627,"_18071":47199,"_5":17966,"_24599":47145,"_2447":47200},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2937":1645,"_26000":1627,"_18071":47202,"_5":17966,"_24599":47148,"_2447":47203},[],"Section",{"_2937":1646,"_26000":1627,"_18071":47205,"_5":17966,"_24599":47148,"_2447":47206},[],"What you manage",{"_2937":1647,"_26000":1627,"_18071":47208,"_5":17966,"_24599":47148,"_2447":47209},[],"Entry point",{"_2937":1648,"_26000":1627,"_18071":47211,"_5":17966,"_24599":47148,"_2447":47212},[],"**PKI**",{"_2937":1649,"_26000":1627,"_18071":47214,"_5":17966,"_24599":47148,"_2447":47215},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2937":1650,"_26000":1627,"_18071":47217,"_5":17966,"_24599":47148,"_2447":47218},[],"PKI overview",{"_2937":1651,"_26000":1627,"_18071":47220,"_5":17966,"_24599":47148,"_2447":47221},[],"**IoT Fleets**",{"_2937":1652,"_26000":1627,"_18071":47223,"_5":17966,"_24599":47148,"_2447":47224},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2937":1653,"_26000":1627,"_18071":47226,"_5":17966,"_24599":47148,"_2447":47227},[],"IoT Fleets overview",{"_2937":1654,"_26000":1627,"_18071":47229,"_5":17966,"_24599":47148,"_2447":47230},[],"**Administration**",{"_2937":1655,"_26000":1627,"_18071":47232,"_5":17966,"_24599":47148,"_2447":47233},[],"Operator permissions, audit and event subscriptions.",{"_2937":1656,"_26000":1627,"_18071":47235,"_5":17966,"_24599":47148,"_2447":43634},[],{"_2937":1657,"_26000":1627,"_18071":47237,"_5":17966,"_24599":47148,"_2447":47238},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2937":1658,"_26000":1627,"_18071":47240,"_5":17966,"_24599":47152,"_2447":47241},[],"An identity's journey connects four responsibilities:",{"_2937":1659,"_26000":1627,"_18071":47243,"_5":17966,"_24599":47152,"_2447":47244},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2937":1660,"_26000":1627,"_18071":47246,"_5":17966,"_24599":47152,"_2447":47247},[],"The provisioning administrator configures the DMS and initial trust.",{"_2937":1661,"_26000":1627,"_18071":47249,"_5":17966,"_24599":47152,"_2447":47250},[],"The device client requests a certificate and installs it with the matching key.",{"_2937":1662,"_26000":1627,"_18071":47252,"_5":17966,"_24599":47152,"_2447":47253},[],"The consumer validates the identity and applies its access permissions.",{"_2937":1663,"_26000":1627,"_18071":47255,"_5":17966,"_24599":47152,"_2447":47256},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2937":1664,"_26000":1627,"_18071":47258,"_5":17966,"_24599":47160,"_2447":47259},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2937":1665,"_26000":1627,"_18071":47261,"_5":17966,"_24599":47164,"_2447":47262},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2937":1666,"_26000":1627,"_18071":47264,"_5":17966,"_24599":47168,"_2447":47265},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2937":1667,"_26000":1627,"_18071":47267,"_5":17966,"_24599":47172,"_2447":47268},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2937":1668,"_26000":1627,"_18071":47270,"_5":17966,"_24599":47176,"_2447":47271},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2937":1669,"_26000":1627,"_18071":47273,"_5":17966,"_24599":47180,"_2447":47274},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2937":1670,"_26000":1627,"_18071":47276,"_5":17966,"_24599":47184,"_2447":46717},[],{"_2937":1671,"_26000":1627,"_18071":47278,"_5":17966,"_24599":47184,"_2447":47279},[],"What it prepares or checks",{"_2937":1672,"_26000":1627,"_18071":47281,"_5":17966,"_24599":47184,"_2447":46720},[],{"_2937":1673,"_26000":1627,"_18071":47283,"_5":17966,"_24599":47184,"_2447":47284},[],"Key custody, CA hierarchy, profiles and validation.",{"_2937":1674,"_26000":1627,"_18071":47286,"_5":17966,"_24599":47184,"_2447":47287},[],"Fleet administrator",{"_2937":1675,"_26000":1627,"_18071":47289,"_5":17966,"_24599":47184,"_2447":47290},[],"DMS, device admission, renewal policy and inventory.",{"_2937":1676,"_26000":1627,"_18071":47292,"_5":17966,"_24599":47184,"_2447":46732},[],{"_2937":1677,"_26000":1627,"_18071":47294,"_5":17966,"_24599":47184,"_2447":47295},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2937":1678,"_26000":1627,"_18071":47297,"_5":17966,"_24599":47184,"_2447":46738},[],{"_2937":1679,"_26000":1627,"_18071":47299,"_5":17966,"_24599":47184,"_2447":47300},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2937":1680,"_26000":1627,"_18071":47302,"_5":17966,"_24599":47184,"_2447":47303},[],"Infrastructure operator",{"_2937":1681,"_26000":1627,"_18071":47305,"_5":17966,"_24599":47184,"_2447":47306},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2937":1682,"_26000":1627,"_18071":47308,"_5":17966,"_24599":47184,"_2447":47309},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2937":1683,"_26000":1683,"_5":12545,"_2447":47311,"_26339":47312,"_18071":47315,"_24599":1683},"CA hierarchy and rotation",[42089,43636,47313,47314],"PKI","Keys, authorities and certificates",[],{"_2937":1684,"_26000":1683,"_18071":47317,"_5":17966,"_24599":1683,"_2447":47318},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2937":1685,"_26000":1683,"_5":26336,"_18071":47320,"_24599":47321,"_2447":47322},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2937":1686,"_26000":1683,"_5":26336,"_18071":47324,"_24599":47325,"_2447":47326},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2937":1687,"_26000":1683,"_5":26336,"_18071":47328,"_24599":47329,"_2447":47330},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2937":1688,"_26000":1683,"_5":26336,"_18071":47332,"_24599":47333,"_2447":47334},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2937":1689,"_26000":1683,"_5":26336,"_18071":47336,"_24599":47337,"_2447":47338},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2937":1690,"_26000":1683,"_5":26336,"_18071":47340,"_24599":47341,"_2447":47342},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2937":1691,"_26000":1683,"_5":26336,"_18071":47344,"_24599":47345,"_2447":47346},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2937":1692,"_26000":1683,"_5":26336,"_18071":47348,"_24599":47349,"_2447":47350},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2937":1693,"_26000":1683,"_5":26336,"_18071":47352,"_24599":47353,"_2447":47354},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2937":1694,"_26000":1683,"_5":26336,"_18071":47356,"_24599":47357,"_2447":47358},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2937":1695,"_26000":1683,"_5":26336,"_18071":47360,"_24599":47361,"_2447":47362},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2937":1696,"_26000":1683,"_5":26336,"_18071":47364,"_24599":47365,"_2447":47366},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2937":1697,"_26000":1683,"_18071":47368,"_5":17966,"_24599":1683,"_2447":47369},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2937":1698,"_26000":1683,"_18071":47371,"_5":17966,"_24599":1683,"_2447":47372},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2937":1699,"_26000":1683,"_18071":47374,"_5":17966,"_24599":47321,"_2447":47375},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2937":1700,"_26000":1683,"_18071":47377,"_5":17966,"_24599":47321,"_2447":47378},[],"environment, such as production and preproduction;",{"_2937":1701,"_26000":1683,"_18071":47380,"_5":17966,"_24599":47321,"_2447":47381},[],"owner or operating team;",{"_2937":1702,"_26000":1683,"_18071":47383,"_5":17966,"_24599":47321,"_2447":47384},[],"device family or manufacturing process;",{"_2937":1703,"_26000":1683,"_18071":47386,"_5":17966,"_24599":47321,"_2447":47387},[],"region or regulatory requirement;",{"_2937":1704,"_26000":1683,"_18071":47389,"_5":17966,"_24599":47321,"_2447":47390},[],"cryptographic engine or key policy;",{"_2937":1705,"_26000":1683,"_18071":47392,"_5":17966,"_24599":47321,"_2447":47393},[],"maintenance window and renewal cadence.",{"_2937":1706,"_26000":1683,"_18071":47395,"_5":17966,"_24599":47321,"_2447":47396},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2937":1707,"_26000":1683,"_18071":47398,"_5":17966,"_24599":47321,"_2447":47399},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2937":1708,"_26000":1683,"_18071":47401,"_5":17966,"_24599":47325,"_2447":47402},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2937":1709,"_26000":1683,"_18071":47404,"_5":17966,"_24599":47325,"_2447":47405},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2937":1710,"_26000":1683,"_18071":47407,"_5":17966,"_24599":47325,"_2447":47408},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2937":1711,"_26000":1683,"_18071":47410,"_5":17966,"_24599":47329,"_2447":47411},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2937":1712,"_26000":1683,"_18071":47413,"_5":17966,"_24599":47329,"_2447":47414},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2937":1713,"_26000":1683,"_18071":47416,"_5":17966,"_24599":47329,"_2447":47417},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2937":1714,"_26000":1683,"_18071":47419,"_5":17966,"_24599":47329,"_2447":47420},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2937":1715,"_26000":1683,"_18071":47422,"_5":17966,"_24599":47337,"_2447":47423},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2937":1716,"_26000":1683,"_18071":47425,"_5":17966,"_24599":47341,"_2447":47426},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2937":1717,"_26000":1683,"_18071":47428,"_5":17966,"_24599":47345,"_2447":47429},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2937":1718,"_26000":1683,"_18071":47431,"_5":17966,"_24599":47349,"_2447":47432},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2937":1719,"_26000":1683,"_18071":47434,"_5":17966,"_24599":47353,"_2447":47435},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2937":1720,"_26000":1683,"_18071":47437,"_5":17966,"_24599":47357,"_2447":47438},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2937":1721,"_26000":1683,"_18071":47440,"_5":17966,"_24599":47361,"_2447":47441},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2937":1722,"_26000":1683,"_18071":47443,"_5":17966,"_24599":47361,"_2447":47444},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2937":1723,"_26000":1683,"_18071":47446,"_5":17966,"_24599":47361,"_2447":47447},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2937":1724,"_26000":1683,"_18071":47449,"_5":17966,"_24599":47361,"_2447":47450},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2937":1725,"_26000":1683,"_18071":47452,"_5":17966,"_24599":47365,"_2447":47453},[],"The new chain ends in an anchor installed by the consumer.",{"_2937":1726,"_26000":1683,"_18071":47455,"_5":17966,"_24599":47365,"_2447":47456},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2937":1727,"_26000":1683,"_18071":47458,"_5":17966,"_24599":47365,"_2447":47459},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2937":1728,"_26000":1683,"_18071":47461,"_5":17966,"_24599":47365,"_2447":47462},[],"Re-enrollment accepts the old identity during the planned period.",{"_2937":1729,"_26000":1683,"_18071":47464,"_5":17966,"_24599":47365,"_2447":47465},[],"OCSP and CRL respond for the authorities that remain active.",{"_2937":1730,"_26000":1683,"_18071":47467,"_5":17966,"_24599":47365,"_2447":47468},[],"No DMS is left accidentally issuing from the old CA.",{"_2937":1731,"_26000":1683,"_18071":47470,"_5":17966,"_24599":47365,"_2447":47471},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2937":1732,"_26000":1732,"_5":12545,"_2447":47473,"_26339":47474,"_18071":47475,"_24599":1732},"Certification authorities",[42089,43636,47313,47314],[],{"_2937":1733,"_26000":1732,"_18071":47477,"_5":17966,"_24599":1732,"_2447":47478},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2937":1734,"_26000":1732,"_5":26336,"_18071":47480,"_24599":47481,"_2447":47482},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2937":1735,"_26000":1732,"_5":26336,"_18071":47484,"_24599":47485,"_2447":47486},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2937":1736,"_26000":1732,"_5":26336,"_18071":47488,"_24599":47489,"_2447":42099},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#before-you-begin",{"_2937":1737,"_26000":1732,"_5":26336,"_18071":47491,"_24599":47492,"_2447":47493},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2937":1738,"_26000":1732,"_5":26336,"_18071":47495,"_24599":47496,"_2447":47497},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2937":1739,"_26000":1732,"_5":26336,"_18071":47499,"_24599":47500,"_2447":47501},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2937":1740,"_26000":1732,"_5":26336,"_18071":47503,"_24599":47504,"_2447":47505},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2937":1741,"_26000":1732,"_5":26336,"_18071":47507,"_24599":47508,"_2447":47509},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2937":1742,"_26000":1732,"_5":26336,"_18071":47511,"_24599":47512,"_2447":47513},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2937":1743,"_26000":1732,"_5":26336,"_18071":47515,"_24599":47516,"_2447":47517},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2937":1744,"_26000":1732,"_5":26336,"_18071":47519,"_24599":47520,"_2447":47521},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2937":1745,"_26000":1732,"_5":26336,"_18071":47523,"_24599":47524,"_2447":47525},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2937":1746,"_26000":1732,"_5":26336,"_18071":47527,"_24599":47528,"_2447":47529},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2937":1747,"_26000":1732,"_5":26336,"_18071":47531,"_24599":47532,"_2447":47533},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2937":1748,"_26000":1732,"_5":26336,"_18071":47535,"_24599":47536,"_2447":47537},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2937":1749,"_26000":1732,"_5":26336,"_18071":47539,"_24599":47540,"_2447":47541},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2937":1750,"_26000":1732,"_5":26336,"_18071":47543,"_24599":47544,"_2447":47545},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2937":1751,"_26000":1732,"_5":26336,"_18071":47547,"_24599":47548,"_2447":47549},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2937":1752,"_26000":1732,"_5":26336,"_18071":47551,"_24599":47552,"_2447":47553},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2937":1753,"_26000":1732,"_5":26336,"_18071":47555,"_24599":47556,"_2447":47557},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2937":1754,"_26000":1732,"_5":26336,"_18071":47559,"_24599":47560,"_2447":47561},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2937":1755,"_26000":1732,"_5":26336,"_18071":47563,"_24599":47564,"_2447":47565},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2937":1756,"_26000":1732,"_18071":47567,"_5":17966,"_24599":1732,"_2447":47568},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2937":1757,"_26000":1732,"_18071":47570,"_5":17966,"_24599":1732,"_2447":47571},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2937":1758,"_26000":1732,"_18071":47573,"_5":17966,"_24599":1732,"_2447":47574},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2937":1759,"_26000":1732,"_18071":47576,"_5":17966,"_24599":47481,"_2447":47577},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2937":1760,"_26000":1732,"_18071":47579,"_5":17966,"_24599":47481,"_2447":47580},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2937":1761,"_26000":1732,"_18071":47582,"_5":17966,"_24599":47481,"_2447":47583},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2937":1762,"_26000":1732,"_18071":47585,"_5":17966,"_24599":47481,"_2447":47586},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2937":1763,"_26000":1732,"_18071":47588,"_5":17966,"_24599":47481,"_2447":47589},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2937":1764,"_26000":1732,"_18071":47591,"_5":17966,"_24599":47489,"_2447":47592},[],"Decide whether the CA will be a root or an intermediate.",{"_2937":1765,"_26000":1732,"_18071":47594,"_5":17966,"_24599":47489,"_2447":47595},[],"Choose the engine that will keep the key.",{"_2937":1766,"_26000":1732,"_18071":47597,"_5":17966,"_24599":47489,"_2447":47598},[],"Define a validity longer than that of the certificates it will issue.",{"_2937":1767,"_26000":1732,"_18071":47600,"_5":17966,"_24599":47489,"_2447":47601},[],"For an intermediate CA, make sure the parent CA is active.",{"_2937":1768,"_26000":1732,"_18071":47603,"_5":17966,"_24599":47492,"_2447":47604},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2937":1769,"_26000":1732,"_18071":47606,"_5":17966,"_24599":47496,"_2447":47607},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2937":1770,"_26000":1732,"_18071":47609,"_5":17966,"_24599":47496,"_2447":47610},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2937":1771,"_26000":1732,"_18071":47612,"_5":17966,"_24599":47500,"_2447":47613},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2937":1772,"_26000":1732,"_18071":47615,"_5":17966,"_24599":47504,"_2447":47616},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2937":1773,"_26000":1732,"_18071":47618,"_5":17966,"_24599":47504,"_2447":47619},[],"`C`: two-letter ISO 3166-1 country code.",{"_2937":1774,"_26000":1732,"_18071":47621,"_5":17966,"_24599":47504,"_2447":47622},[],"`ST`: state or province.",{"_2937":1775,"_26000":1732,"_18071":47624,"_5":17966,"_24599":47504,"_2447":47625},[],"`L`: locality.",{"_2937":1776,"_26000":1732,"_18071":47627,"_5":17966,"_24599":47504,"_2447":47628},[],"`O`: organization.",{"_2937":1777,"_26000":1732,"_18071":47630,"_5":17966,"_24599":47504,"_2447":47631},[],"`OU`: organizational unit.",{"_2937":1778,"_26000":1732,"_18071":47633,"_5":17966,"_24599":47504,"_2447":47634},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2937":1779,"_26000":1732,"_18071":47636,"_5":17966,"_24599":47508,"_2447":47637},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2937":1780,"_26000":1732,"_18071":47639,"_5":17966,"_24599":47508,"_2447":47640},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2937":1781,"_26000":1732,"_18071":47642,"_5":17966,"_24599":47512,"_2447":47643},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2937":1782,"_26000":1732,"_18071":47645,"_5":17966,"_24599":47512,"_2447":47646},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2937":1783,"_26000":1732,"_18071":47648,"_5":17966,"_24599":47516,"_2447":47649},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2937":1784,"_26000":1732,"_18071":47651,"_5":17966,"_24599":47516,"_2447":47652},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2937":1785,"_26000":1732,"_18071":47654,"_5":17966,"_24599":47520,"_2447":47655},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2937":1786,"_26000":1732,"_18071":47657,"_5":17966,"_24599":47524,"_2447":47658},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2937":1787,"_26000":1732,"_18071":47660,"_5":17966,"_24599":47528,"_2447":47661},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2937":1788,"_26000":1732,"_18071":47663,"_5":17966,"_24599":47532,"_2447":47664},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2937":1789,"_26000":1732,"_18071":47666,"_5":17966,"_24599":47536,"_2447":47667},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2937":1790,"_26000":1732,"_18071":47669,"_5":17966,"_24599":47536,"_2447":47670},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2937":1791,"_26000":1732,"_18071":47672,"_5":17966,"_24599":47540,"_2447":47673},[],"Open a CA from the inventory to review:",{"_2937":1792,"_26000":1732,"_18071":47675,"_5":17966,"_24599":47540,"_2447":47676},[],"Status and validity period.",{"_2937":1793,"_26000":1732,"_18071":47678,"_5":17966,"_24599":47540,"_2447":47679},[],"Certificate and chain in PEM format.",{"_2937":1794,"_26000":1732,"_18071":47681,"_5":17966,"_24599":47540,"_2447":47682},[],"Number of active, expired and revoked certificates.",{"_2937":1795,"_26000":1732,"_18071":47684,"_5":17966,"_24599":47540,"_2447":47685},[],"Certificates issued in **Issued Certificates**.",{"_2937":1796,"_26000":1732,"_18071":47687,"_5":17966,"_24599":47540,"_2447":47688},[],"The CRL linked to the authority.",{"_2937":1797,"_26000":1732,"_18071":47690,"_5":17966,"_24599":47540,"_2447":47691},[],"Metadata and the associated cryptographic engine.",{"_2937":1798,"_26000":1732,"_18071":47693,"_5":17966,"_24599":47540,"_2447":47694},[],"You can filter the inventory by name, status and CA type.",{"_2937":1799,"_26000":1732,"_18071":47696,"_5":17966,"_24599":47544,"_2447":47697},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2937":1800,"_26000":1732,"_18071":47699,"_5":17966,"_24599":47544,"_2447":47700},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2937":1801,"_26000":1732,"_18071":47702,"_5":17966,"_24599":47544,"_2447":47703},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2937":1802,"_26000":1732,"_18071":47705,"_5":17966,"_24599":47544,"_2447":47706},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2937":1803,"_26000":1732,"_18071":47708,"_5":17966,"_24599":47548,"_2447":47709},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2937":1804,"_26000":1732,"_18071":47711,"_5":17966,"_24599":47552,"_2447":47712},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2937":1805,"_26000":1732,"_18071":47714,"_5":17966,"_24599":47556,"_2447":47715},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2937":1806,"_26000":1732,"_18071":47717,"_5":17966,"_24599":47560,"_2447":47718},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2937":1807,"_26000":1732,"_18071":47720,"_5":17966,"_24599":47564,"_2447":47721},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2937":1808,"_26000":1732,"_18071":47723,"_5":17966,"_24599":47564,"_2447":47724},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2937":1809,"_26000":1809,"_5":12545,"_2447":47726,"_26339":47727,"_18071":47728,"_24599":1809},"Certificate profiles",[42089,43636,47313,47314],[],{"_2937":1810,"_26000":1809,"_18071":47730,"_5":17966,"_24599":1809,"_2447":47731},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2937":1811,"_26000":1809,"_5":26336,"_18071":47733,"_24599":47734,"_2447":47735},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2937":1812,"_26000":1809,"_5":26336,"_18071":47737,"_24599":47738,"_2447":47739},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#validity","Validity",{"_2937":1813,"_26000":1809,"_5":26336,"_18071":47741,"_24599":47742,"_2447":47743},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2937":1814,"_26000":1809,"_5":26336,"_18071":47745,"_24599":47746,"_2447":47747},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2937":1815,"_26000":1809,"_5":26336,"_18071":47749,"_24599":47750,"_2447":47751},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#subject","Subject",{"_2937":1816,"_26000":1809,"_5":26336,"_18071":47753,"_24599":47754,"_2447":47755},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2937":1817,"_26000":1809,"_5":26336,"_18071":47757,"_24599":47758,"_2447":47759},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2937":1818,"_26000":1809,"_5":26336,"_18071":47761,"_24599":47762,"_2447":47763},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2937":1819,"_26000":1809,"_5":26336,"_18071":47765,"_24599":47766,"_2447":47767},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2937":1820,"_26000":1809,"_5":26336,"_18071":47769,"_24599":47770,"_2447":47771},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2937":1821,"_26000":1809,"_5":26336,"_18071":47773,"_24599":47774,"_2447":47775},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2937":1822,"_26000":1809,"_5":26336,"_18071":47777,"_24599":47778,"_2447":47779},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2937":1823,"_26000":1809,"_5":26336,"_18071":47781,"_24599":47782,"_2447":47783},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2937":1824,"_26000":1809,"_5":26336,"_18071":47785,"_24599":47786,"_2447":47787},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2937":1825,"_26000":1809,"_5":26336,"_18071":47789,"_24599":47790,"_2447":47791},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#design-examples","Design examples",{"_2937":1826,"_26000":1809,"_5":26336,"_18071":47793,"_24599":47794,"_2447":47795},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2937":1827,"_26000":1809,"_18071":47797,"_5":17966,"_24599":1809,"_2447":47798},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2937":1828,"_26000":1809,"_18071":47800,"_5":17966,"_24599":1809,"_2447":47801},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2937":1829,"_26000":1809,"_18071":47803,"_5":17966,"_24599":47738,"_2447":47804},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2937":1830,"_26000":1809,"_18071":47806,"_5":17966,"_24599":47738,"_2447":47807},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2937":1831,"_26000":1809,"_18071":47809,"_5":17966,"_24599":47742,"_2447":47810},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2937":1832,"_26000":1809,"_18071":47812,"_5":17966,"_24599":47746,"_2447":47813},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2937":1833,"_26000":1809,"_18071":47815,"_5":17966,"_24599":47746,"_2447":47816},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2937":1834,"_26000":1809,"_18071":47818,"_5":17966,"_24599":47746,"_2447":47819},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2937":1835,"_26000":1809,"_18071":47821,"_5":17966,"_24599":47750,"_2447":47822},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2937":1836,"_26000":1809,"_18071":47824,"_5":17966,"_24599":47754,"_2447":47825},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2937":1837,"_26000":1809,"_18071":47827,"_5":17966,"_24599":47754,"_2447":47828},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2937":1838,"_26000":1809,"_18071":47830,"_5":17966,"_24599":47758,"_2447":47831},[],"The cryptographic enforcement can:",{"_2937":1839,"_26000":1809,"_18071":47833,"_5":17966,"_24599":47758,"_2447":47834},[],"allow or block RSA keys;",{"_2937":1840,"_26000":1809,"_18071":47836,"_5":17966,"_24599":47758,"_2447":47837},[],"limit the supported RSA sizes;",{"_2937":1841,"_26000":1809,"_18071":47839,"_5":17966,"_24599":47758,"_2447":47840},[],"allow or block ECDSA keys;",{"_2937":1842,"_26000":1809,"_18071":47842,"_5":17966,"_24599":47758,"_2447":47843},[],"limit the supported ECDSA sizes or curves.",{"_2937":1843,"_26000":1809,"_18071":47845,"_5":17966,"_24599":47758,"_2447":47846},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2937":1844,"_26000":1809,"_18071":47848,"_5":17966,"_24599":47762,"_2447":47849},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2937":1845,"_26000":1809,"_18071":47851,"_5":17966,"_24599":47762,"_2447":45354},[],{"_2937":1846,"_26000":1809,"_18071":47853,"_5":17966,"_24599":47762,"_2447":47854},[],"First choice",{"_2937":1847,"_26000":1809,"_18071":47856,"_5":17966,"_24599":47762,"_2447":47857},[],"Second choice",{"_2937":1848,"_26000":1809,"_18071":47859,"_5":17966,"_24599":47762,"_2447":47860},[],"If neither is supplied",{"_2937":1849,"_26000":1809,"_18071":47862,"_5":17966,"_24599":47762,"_2447":47863},[],"Direct signing with a CA",{"_2937":1850,"_26000":1809,"_18071":47865,"_5":17966,"_24599":47762,"_2447":47866},[],"`issuance_profile` embedded in the request",{"_2937":1851,"_26000":1809,"_18071":47868,"_5":17966,"_24599":47762,"_2447":47869},[],"Request `issuance_profile_id`",{"_2937":1852,"_26000":1809,"_18071":47871,"_5":17966,"_24599":47762,"_2447":47872},[],"CA default profile (`profile_id`).",{"_2937":1853,"_26000":1809,"_18071":47874,"_5":17966,"_24599":47762,"_2447":47875},[],"Issuance through a DMS",{"_2937":1854,"_26000":1809,"_18071":47877,"_5":17966,"_24599":47762,"_2447":47878},[],"`settings.issuance_profile_id`",{"_2937":1855,"_26000":1809,"_18071":47880,"_5":17966,"_24599":47762,"_2447":47881},[],"`settings.issuance_profile` embedded in the DMS",{"_2937":1856,"_26000":1809,"_18071":47883,"_5":17966,"_24599":47762,"_2447":47884},[],"Enrollment CA default profile.",{"_2937":1857,"_26000":1809,"_18071":47886,"_5":17966,"_24599":47762,"_2447":47887},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2937":1858,"_26000":1809,"_18071":47889,"_5":17966,"_24599":47762,"_2447":47890},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2937":1859,"_26000":1809,"_18071":47892,"_5":17966,"_24599":47770,"_2447":47893},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2937":1860,"_26000":1809,"_18071":47895,"_5":17966,"_24599":47774,"_2447":47896},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2937":1861,"_26000":1809,"_18071":47898,"_5":17966,"_24599":47778,"_2447":47899},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2937":1862,"_26000":1809,"_18071":47901,"_5":17966,"_24599":47782,"_2447":47902},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2937":1863,"_26000":1809,"_18071":47904,"_5":17966,"_24599":47786,"_2447":47905},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2937":1864,"_26000":1809,"_18071":47907,"_5":17966,"_24599":47786,"_2447":47908},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2937":1865,"_26000":1809,"_18071":47910,"_5":17966,"_24599":47790,"_2447":47911},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2937":1866,"_26000":1809,"_18071":47913,"_5":17966,"_24599":47790,"_2447":47914},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2937":1867,"_26000":1809,"_18071":47916,"_5":17966,"_24599":47790,"_2447":47917},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2937":1868,"_26000":1809,"_18071":47919,"_5":17966,"_24599":47790,"_2447":47920},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2937":1869,"_26000":1809,"_18071":47922,"_5":17966,"_24599":47794,"_2447":47923},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2937":1870,"_26000":1809,"_18071":47925,"_5":17966,"_24599":47794,"_2447":47926},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2937":1871,"_26000":1871,"_5":12545,"_2447":47928,"_26339":47929,"_18071":47931,"_24599":1871},"Certificate validation",[42089,43636,47313,47930],"Validation",[],{"_2937":1872,"_26000":1871,"_18071":47933,"_5":17966,"_24599":1871,"_2447":47934},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2937":1873,"_26000":1871,"_5":26336,"_18071":47936,"_24599":47937,"_2447":47938},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2937":1874,"_26000":1871,"_5":26336,"_18071":47940,"_24599":47941,"_2447":47942},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2937":1875,"_26000":1871,"_5":26336,"_18071":47944,"_24599":47945,"_2447":47946},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2937":1876,"_26000":1871,"_18071":47948,"_5":17966,"_24599":1871,"_2447":47949},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2937":1877,"_26000":1871,"_18071":47951,"_5":17966,"_24599":47937,"_2447":47952},[],"Verify these criteria together:",{"_2937":1878,"_26000":1871,"_18071":47954,"_5":17966,"_24599":47937,"_2447":46937},[],{"_2937":1879,"_26000":1871,"_18071":47956,"_5":17966,"_24599":47937,"_2447":47957},[],"Required result",{"_2937":1880,"_26000":1871,"_18071":47959,"_5":17966,"_24599":47937,"_2447":47960},[],"Chain and signature",{"_2937":1881,"_26000":1871,"_18071":47962,"_5":17966,"_24599":47937,"_2447":47963},[],"Valid chain to a root deliberately installed in the consumer.",{"_2937":1882,"_26000":1871,"_18071":47965,"_5":17966,"_24599":47937,"_2447":47966},[],"Dates",{"_2937":1883,"_26000":1871,"_18071":47968,"_5":17966,"_24599":47937,"_2447":47969},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2937":1884,"_26000":1871,"_18071":47971,"_5":17966,"_24599":47937,"_2447":43336},[],{"_2937":1885,"_26000":1871,"_18071":47973,"_5":17966,"_24599":47937,"_2447":47974},[],"Name, SAN or identifier matches the expected peer.",{"_2937":1886,"_26000":1871,"_18071":47976,"_5":17966,"_24599":47937,"_2447":42475},[],{"_2937":1887,"_26000":1871,"_18071":47978,"_5":17966,"_24599":47937,"_2447":47979},[],"KU, EKU and constraints permit the specific operation.",{"_2937":1888,"_26000":1871,"_18071":47981,"_5":17966,"_24599":47937,"_2447":47982},[],"Revocation",{"_2937":1889,"_26000":1871,"_18071":47984,"_5":17966,"_24599":47937,"_2447":47985},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2937":1890,"_26000":1871,"_18071":47987,"_5":17966,"_24599":47937,"_2447":47988},[],"Authorization",{"_2937":1891,"_26000":1871,"_18071":47990,"_5":17966,"_24599":47937,"_2447":47991},[],"The application permits that identity to perform the action.",{"_2937":1892,"_26000":1871,"_18071":47993,"_5":17966,"_24599":47937,"_2447":47994},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2937":1893,"_26000":1871,"_18071":47996,"_5":17966,"_24599":47941,"_2447":47997},[],"Mechanism",{"_2937":1894,"_26000":1871,"_18071":47999,"_5":17966,"_24599":47941,"_2447":48000},[],"When to use it",{"_2937":1895,"_26000":1871,"_18071":48002,"_5":17966,"_24599":47941,"_2447":48003},[],"What you must maintain",{"_2937":1896,"_26000":1871,"_18071":48005,"_5":17966,"_24599":47941,"_2447":48006},[],"OCSP",{"_2937":1897,"_26000":1871,"_18071":48008,"_5":17966,"_24599":47941,"_2447":48009},[],"Status query for a specific certificate.",{"_2937":1898,"_26000":1871,"_18071":48011,"_5":17966,"_24599":47941,"_2447":48012},[],"Responder access, signature verification and cache/freshness policy.",{"_2937":1899,"_26000":1871,"_18071":48014,"_5":17966,"_24599":47941,"_2447":48015},[],"CRL",{"_2937":1900,"_26000":1871,"_18071":48017,"_5":17966,"_24599":47941,"_2447":48018},[],"Local checks for many certificates or offline operation.",{"_2937":1901,"_26000":1871,"_18071":48020,"_5":17966,"_24599":47941,"_2447":48021},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2937":1902,"_26000":1871,"_18071":48023,"_5":17966,"_24599":47941,"_2447":48024},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2937":1903,"_26000":1871,"_18071":48026,"_5":17966,"_24599":47941,"_2447":48027},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2937":1904,"_26000":1871,"_18071":48029,"_5":17966,"_24599":47945,"_2447":48030},[],"Accept a current, authorized certificate with a known chain.",{"_2937":1905,"_26000":1871,"_18071":48032,"_5":17966,"_24599":47945,"_2447":48033},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2937":1906,"_26000":1871,"_18071":48035,"_5":17966,"_24599":47945,"_2447":48036},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2937":1907,"_26000":1871,"_18071":48038,"_5":17966,"_24599":47945,"_2447":48039},[],"Check that a new connection with that identity is rejected.",{"_2937":1908,"_26000":1871,"_18071":48041,"_5":17966,"_24599":47945,"_2447":48042},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2937":1909,"_26000":1871,"_18071":48044,"_5":17966,"_24599":47945,"_2447":48045},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2937":1910,"_26000":1871,"_18071":48047,"_5":17966,"_24599":47945,"_2447":48048},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2937":1911,"_26000":1871,"_18071":48050,"_5":17966,"_24599":47945,"_2447":48051},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2937":1912,"_26000":1871,"_18071":48053,"_5":17966,"_24599":47945,"_2447":48054},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2937":1913,"_26000":1913,"_5":12545,"_2447":48056,"_26339":48057,"_18071":48058,"_24599":1913},"Certificates",[42089,43636,47313,47314],[],{"_2937":1914,"_26000":1913,"_18071":48060,"_5":17966,"_24599":1913,"_2447":48061},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2937":1915,"_26000":1913,"_5":26336,"_18071":48063,"_24599":48064,"_2447":48065},[],"/docs/pr-preview/pr-26/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2937":1916,"_26000":1913,"_5":26336,"_18071":48067,"_24599":48068,"_2447":48069},[],"/docs/pr-preview/pr-26/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2937":1917,"_26000":1913,"_5":26336,"_18071":48071,"_24599":48072,"_2447":48073},[],"/docs/pr-preview/pr-26/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2937":1918,"_26000":1913,"_5":26336,"_18071":48075,"_24599":48076,"_2447":48077},[],"/docs/pr-preview/pr-26/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2937":1919,"_26000":1913,"_5":26336,"_18071":48079,"_24599":48080,"_2447":48081},[],"/docs/pr-preview/pr-26/platform/pki/certificates#open-the-action","Open the action",{"_2937":1920,"_26000":1913,"_5":26336,"_18071":48083,"_24599":48084,"_2447":48085},[],"/docs/pr-preview/pr-26/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2937":1921,"_26000":1913,"_5":26336,"_18071":48087,"_24599":48088,"_2447":48089},[],"/docs/pr-preview/pr-26/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2937":1922,"_26000":1913,"_5":26336,"_18071":48091,"_24599":48092,"_2447":48093},[],"/docs/pr-preview/pr-26/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2937":1923,"_26000":1913,"_5":26336,"_18071":48095,"_24599":48096,"_2447":48097},[],"/docs/pr-preview/pr-26/platform/pki/certificates#continue","Continue",{"_2937":1924,"_26000":1913,"_18071":48099,"_5":17966,"_24599":1913,"_2447":48100},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2937":1925,"_26000":1913,"_18071":48102,"_5":17966,"_24599":48064,"_2447":48103},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2937":1926,"_26000":1913,"_18071":48105,"_5":17966,"_24599":48064,"_2447":48106},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2937":1927,"_26000":1913,"_18071":48108,"_5":17966,"_24599":48068,"_2447":48109},[],"Download the PEM and inspect it:",{"_2937":1928,"_26000":1913,"_18071":48111,"_5":17966,"_24599":48068,"_2447":48112},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2937":1929,"_26000":1913,"_18071":48114,"_5":17966,"_24599":48072,"_2447":48115},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2937":1930,"_26000":1913,"_18071":48117,"_5":17966,"_24599":48072,"_2447":48118},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2937":1931,"_26000":1913,"_18071":48120,"_5":17966,"_24599":48072,"_2447":48121},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2937":1932,"_26000":1913,"_18071":48123,"_5":17966,"_24599":48072,"_2447":48124},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2937":1933,"_26000":1913,"_18071":48126,"_5":17966,"_24599":48072,"_2447":48127},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2937":1934,"_26000":1913,"_18071":48129,"_5":17966,"_24599":48072,"_2447":48130},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2937":1935,"_26000":1913,"_18071":48132,"_5":17966,"_24599":48072,"_2447":48133},[],"For browser key generation, follow Issue your first certificate.",{"_2937":1936,"_26000":1913,"_18071":48135,"_5":17966,"_24599":48076,"_2447":48136},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2937":1937,"_26000":1913,"_18071":48138,"_5":17966,"_24599":48080,"_2447":48139},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2937":1938,"_26000":1913,"_18071":48141,"_5":17966,"_24599":48084,"_2447":48142},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2937":1939,"_26000":1913,"_18071":48144,"_5":17966,"_24599":48088,"_2447":48145},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2937":1940,"_26000":1913,"_18071":48147,"_5":17966,"_24599":48088,"_2447":48148},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2937":1941,"_26000":1913,"_18071":48150,"_5":17966,"_24599":48088,"_2447":48151},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2937":1942,"_26000":1913,"_18071":48153,"_5":17966,"_24599":48092,"_2447":48154},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2937":1943,"_26000":1913,"_18071":48156,"_5":17966,"_24599":48092,"_2447":48157},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2937":1944,"_26000":1913,"_18071":48159,"_5":17966,"_24599":48092,"_2447":48160},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2937":1945,"_26000":1913,"_18071":48162,"_5":17966,"_24599":48096,"_2447":48163},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2937":1946,"_26000":1913,"_18071":48165,"_5":17966,"_24599":48096,"_2447":48166},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2937":1947,"_26000":1947,"_5":12545,"_2447":48168,"_26339":48169,"_18071":48171,"_24599":1947},"Certificate lifecycle",[42089,43636,47313,48170],"Concepts",[],{"_2937":1948,"_26000":1947,"_18071":48173,"_5":17966,"_24599":1947,"_2447":48174},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2937":1949,"_26000":1947,"_5":26336,"_18071":48176,"_24599":48177,"_2447":48178},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2937":1950,"_26000":1947,"_5":26336,"_18071":48180,"_24599":48181,"_2447":48182},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2937":1951,"_26000":1947,"_5":26336,"_18071":48184,"_24599":48185,"_2447":48186},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2937":1952,"_26000":1947,"_5":26336,"_18071":48188,"_24599":48189,"_2447":48190},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2937":1953,"_26000":1947,"_5":26336,"_18071":48192,"_24599":48193,"_2447":48194},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2937":1954,"_26000":1947,"_5":26336,"_18071":48196,"_24599":48197,"_2447":48198},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2937":1955,"_26000":1947,"_5":26336,"_18071":48200,"_24599":48201,"_2447":48202},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2937":1956,"_26000":1947,"_5":26336,"_18071":48204,"_24599":48205,"_2447":48206},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2937":1957,"_26000":1947,"_5":26336,"_18071":48208,"_24599":48209,"_2447":48210},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2937":1958,"_26000":1947,"_5":26336,"_18071":48212,"_24599":48213,"_2447":48214},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2937":1959,"_26000":1947,"_18071":48216,"_5":17966,"_24599":1947,"_2447":48217},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2937":1960,"_26000":1947,"_18071":48219,"_5":17966,"_24599":48181,"_2447":48220},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2937":1961,"_26000":1947,"_18071":48222,"_5":17966,"_24599":48185,"_2447":48223},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2937":1962,"_26000":1947,"_18071":48225,"_5":17966,"_24599":48189,"_2447":48226},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2937":1963,"_26000":1947,"_18071":48228,"_5":17966,"_24599":48193,"_2447":48229},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2937":1964,"_26000":1947,"_18071":48231,"_5":17966,"_24599":48197,"_2447":48232},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2937":1965,"_26000":1947,"_18071":48234,"_5":17966,"_24599":48201,"_2447":48235},[],"Lamassu persists four X.509 states:",{"_2937":1966,"_26000":1947,"_18071":48237,"_5":17966,"_24599":48201,"_2447":48238},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2937":1967,"_26000":1947,"_18071":48240,"_5":17966,"_24599":48201,"_2447":48241},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2937":1968,"_26000":1947,"_18071":48243,"_5":17966,"_24599":48201,"_2447":48244},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2937":1969,"_26000":1947,"_18071":48246,"_5":17966,"_24599":48201,"_2447":48247},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2937":1970,"_26000":1947,"_18071":48249,"_5":17966,"_24599":48201,"_2447":48250},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2937":1971,"_26000":1947,"_18071":48252,"_5":17966,"_24599":48205,"_2447":48253},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2937":1972,"_26000":1947,"_18071":48255,"_5":17966,"_24599":48205,"_2447":48256},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2937":1973,"_26000":1947,"_18071":48258,"_5":17966,"_24599":48205,"_2447":48259},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2937":1974,"_26000":1947,"_18071":48261,"_5":17966,"_24599":48209,"_2447":48262},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2937":1975,"_26000":1947,"_18071":48264,"_5":17966,"_24599":48209,"_2447":48265},[],"Before confirming:",{"_2937":1976,"_26000":1947,"_18071":48267,"_5":17966,"_24599":48209,"_2447":48268},[],"Identify DMSs, devices and services that trust that chain.",{"_2937":1977,"_26000":1947,"_18071":48270,"_5":17966,"_24599":48209,"_2447":48271},[],"Distribute the new chain of trust.",{"_2937":1978,"_26000":1947,"_18071":48273,"_5":17966,"_24599":48209,"_2447":48274},[],"Reissue the necessary identities.",{"_2937":1979,"_26000":1947,"_18071":48276,"_5":17966,"_24599":48209,"_2447":48277},[],"Check OCSP and CRL from a real consumer.",{"_2937":1980,"_26000":1947,"_18071":48279,"_5":17966,"_24599":48209,"_2447":48280},[],"Revoke the old CA once no legitimate traffic remains.",{"_2937":1981,"_26000":1947,"_18071":48282,"_5":17966,"_24599":48209,"_2447":48283},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2937":1982,"_26000":1947,"_18071":48285,"_5":17966,"_24599":48213,"_2447":48286},[],"Certificates entering the preventive or critical renewal window.",{"_2937":1983,"_26000":1947,"_18071":48288,"_5":17966,"_24599":48213,"_2447":48289},[],"Repeated enrollment or re-enrollment failures.",{"_2937":1984,"_26000":1947,"_18071":48291,"_5":17966,"_24599":48213,"_2447":48292},[],"Status changes and revocation reasons.",{"_2937":1985,"_26000":1947,"_18071":48294,"_5":17966,"_24599":48213,"_2447":48295},[],"OCSP and CRL publication and validity.",{"_2937":1986,"_26000":1947,"_18071":48297,"_5":17966,"_24599":48213,"_2447":48298},[],"Dependencies still presenting a replaced certificate.",{"_2937":1987,"_26000":1947,"_18071":48300,"_5":17966,"_24599":48213,"_2447":48301},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2937":1988,"_26000":1988,"_5":12545,"_2447":48303,"_26339":48304,"_18071":48305,"_24599":1988},"Trust model",[42089,43636,47313,48170],[],{"_2937":1989,"_26000":1988,"_18071":48307,"_5":17966,"_24599":1988,"_2447":48308},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2937":1990,"_26000":1988,"_5":26336,"_18071":48310,"_24599":48311,"_2447":48312},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2937":1991,"_26000":1988,"_5":26336,"_18071":48314,"_24599":48315,"_2447":48316},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2937":1992,"_26000":1988,"_5":26336,"_18071":48318,"_24599":48319,"_2447":48320},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2937":1993,"_26000":1988,"_5":26336,"_18071":48322,"_24599":48323,"_2447":48324},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2937":1994,"_26000":1988,"_5":26336,"_18071":48326,"_24599":48327,"_2447":48328},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2937":1995,"_26000":1988,"_5":26336,"_18071":48330,"_24599":48331,"_2447":48332},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2937":1996,"_26000":1988,"_5":26336,"_18071":48334,"_24599":48335,"_2447":48336},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2937":1997,"_26000":1988,"_5":26336,"_18071":48338,"_24599":48339,"_2447":48340},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2937":1998,"_26000":1988,"_5":26336,"_18071":48342,"_24599":48343,"_2447":48344},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2937":1999,"_26000":1988,"_5":26336,"_18071":48346,"_24599":48347,"_2447":48348},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2937":2000,"_26000":1988,"_18071":48350,"_5":17966,"_24599":1988,"_2447":48351},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2937":2001,"_26000":1988,"_18071":48353,"_5":17966,"_24599":48315,"_2447":48354},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2937":2002,"_26000":1988,"_18071":48356,"_5":17966,"_24599":48319,"_2447":48357},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2937":2003,"_26000":1988,"_18071":48359,"_5":17966,"_24599":48323,"_2447":48360},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2937":2004,"_26000":1988,"_18071":48362,"_5":17966,"_24599":48327,"_2447":48363},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2937":2005,"_26000":1988,"_18071":48365,"_5":17966,"_24599":48331,"_2447":48366},[],"The device proves it can enroll according to the DMS policy.",{"_2937":2006,"_26000":1988,"_18071":48368,"_5":17966,"_24599":48331,"_2447":48369},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2937":2007,"_26000":1988,"_18071":48371,"_5":17966,"_24599":48331,"_2447":48372},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2937":2008,"_26000":1988,"_18071":48374,"_5":17966,"_24599":48331,"_2447":48375},[],"The device installs the certificate and the chain it needs.",{"_2937":2009,"_26000":1988,"_18071":48377,"_5":17966,"_24599":48331,"_2447":48378},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2937":2010,"_26000":1988,"_18071":48380,"_5":17966,"_24599":48331,"_2447":48381},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2937":2011,"_26000":1988,"_18071":48383,"_5":17966,"_24599":48335,"_2447":48384},[],"A DMS relates three sets that are worth designing separately:",{"_2937":2012,"_26000":1988,"_18071":48386,"_5":17966,"_24599":48335,"_2447":48387},[],"**Enrollment CA:** signs the new identities.",{"_2937":2013,"_26000":1988,"_18071":48389,"_5":17966,"_24599":48335,"_2447":48390},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2937":2014,"_26000":1988,"_18071":48392,"_5":17966,"_24599":48335,"_2447":48393},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2937":2015,"_26000":1988,"_18071":48395,"_5":17966,"_24599":48335,"_2447":48396},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2937":2016,"_26000":1988,"_18071":48398,"_5":17966,"_24599":48339,"_2447":48399},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2937":2017,"_26000":1988,"_18071":48401,"_5":17966,"_24599":48339,"_2447":48402},[],"that the current date is between `Not Before` and `Not After`;",{"_2937":2018,"_26000":1988,"_18071":48404,"_5":17966,"_24599":48339,"_2447":48405},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2937":2019,"_26000":1988,"_18071":48407,"_5":17966,"_24599":48339,"_2447":48408},[],"that names, SANs and subject match the expected identity;",{"_2937":2020,"_26000":1988,"_18071":48410,"_5":17966,"_24599":48339,"_2447":48411},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2937":2021,"_26000":1988,"_18071":48413,"_5":17966,"_24599":48339,"_2447":48414},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2937":2022,"_26000":1988,"_18071":48416,"_5":17966,"_24599":48339,"_2447":48417},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2937":2023,"_26000":1988,"_18071":48419,"_5":17966,"_24599":48343,"_2447":48420},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2937":2024,"_26000":1988,"_18071":48422,"_5":17966,"_24599":48347,"_2447":48423},[],"Keep the root out of daily operations, or with very restricted access.",{"_2937":2025,"_26000":1988,"_18071":48425,"_5":17966,"_24599":48347,"_2447":48426},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2937":2026,"_26000":1988,"_18071":48428,"_5":17966,"_24599":48347,"_2447":48429},[],"Assign explicit profiles to every use case.",{"_2937":2027,"_26000":1988,"_18071":48431,"_5":17966,"_24599":48347,"_2447":48432},[],"Distribute the new trust before starting a rotation.",{"_2937":2028,"_26000":1988,"_18071":48434,"_5":17966,"_24599":48347,"_2447":48435},[],"Keep enough overlap to renew a disconnected fleet.",{"_2937":2029,"_26000":1988,"_18071":48437,"_5":17966,"_24599":48347,"_2447":48438},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2937":2030,"_26000":1988,"_18071":48440,"_5":17966,"_24599":48347,"_2447":48441},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2937":2031,"_26000":2031,"_5":12545,"_2447":48443,"_26339":48444,"_18071":48445,"_24599":2031},"Revocation lists (CRL)",[42089,43636,47313,47930],[],{"_2937":2032,"_26000":2031,"_18071":48447,"_5":17966,"_24599":2031,"_2447":48448},[],"Generate and distribute signed lists to validate certificates offline.",{"_2937":2033,"_26000":2031,"_5":26336,"_18071":48450,"_24599":48451,"_2447":48452},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2937":2034,"_26000":2031,"_5":26336,"_18071":48454,"_24599":48455,"_2447":48456},[],"/docs/pr-preview/pr-26/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2937":2035,"_26000":2031,"_5":26336,"_18071":48458,"_24599":48459,"_2447":48460},[],"/docs/pr-preview/pr-26/platform/pki/crl#crl-contents","CRL contents",{"_2937":2036,"_26000":2031,"_5":26336,"_18071":48462,"_24599":48463,"_2447":48464},[],"/docs/pr-preview/pr-26/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2937":2037,"_26000":2031,"_5":26336,"_18071":48466,"_24599":48467,"_2447":48468},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-management-api","VA role management API",{"_2937":2038,"_26000":2031,"_5":26336,"_18071":48470,"_24599":48471,"_2447":48472},[],"/docs/pr-preview/pr-26/platform/pki/crl#from-the-interface","From the interface",{"_2937":2039,"_26000":2031,"_5":26336,"_18071":48474,"_24599":48475,"_2447":48476},[],"/docs/pr-preview/pr-26/platform/pki/crl#references","References",{"_2937":2040,"_26000":2031,"_18071":48478,"_5":17966,"_24599":2031,"_2447":48479},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2937":2041,"_26000":2031,"_18071":48481,"_5":17966,"_24599":48451,"_2447":48482},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2937":2042,"_26000":2031,"_18071":48484,"_5":17966,"_24599":48451,"_2447":48485},[],"`crl_options` field",{"_2937":2043,"_26000":2031,"_18071":48487,"_5":17966,"_24599":48451,"_2447":42475},[],{"_2937":2044,"_26000":2031,"_18071":48489,"_5":17966,"_24599":48451,"_2447":48490},[],"Backend initial value",{"_2937":2045,"_26000":2031,"_18071":48492,"_5":17966,"_24599":48451,"_2447":48493},[],"`validity`",{"_2937":2046,"_26000":2031,"_18071":48495,"_5":17966,"_24599":48451,"_2447":48496},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2937":2047,"_26000":2031,"_18071":48498,"_5":17966,"_24599":48451,"_2447":48499},[],"7 days.",{"_2937":2048,"_26000":2031,"_18071":48501,"_5":17966,"_24599":48451,"_2447":48502},[],"`refresh_interval`",{"_2937":2049,"_26000":2031,"_18071":48504,"_5":17966,"_24599":48451,"_2447":48505},[],"Time since publication that triggers scheduled renewal.",{"_2937":2050,"_26000":2031,"_18071":48507,"_5":17966,"_24599":48451,"_2447":48508},[],"6 days and 23 hours.",{"_2937":2051,"_26000":2031,"_18071":48510,"_5":17966,"_24599":48451,"_2447":48511},[],"`regenerate_on_revoke`",{"_2937":2052,"_26000":2031,"_18071":48513,"_5":17966,"_24599":48451,"_2447":48514},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2937":2053,"_26000":2031,"_18071":48516,"_5":17966,"_24599":48451,"_2447":48517},[],"`true`.",{"_2937":2054,"_26000":2031,"_18071":48519,"_5":17966,"_24599":48451,"_2447":48520},[],"`subject_key_id_signer`",{"_2937":2055,"_26000":2031,"_18071":48522,"_5":17966,"_24599":48451,"_2447":48523},[],"Configuration field initialized with the CA’s SKI.",{"_2937":2056,"_26000":2031,"_18071":48525,"_5":17966,"_24599":48451,"_2447":48526},[],"CA SKI.",{"_2937":2057,"_26000":2031,"_18071":48528,"_5":17966,"_24599":48451,"_2447":48529},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2937":2058,"_26000":2031,"_18071":48531,"_5":17966,"_24599":48451,"_2447":48532},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2937":2059,"_26000":2031,"_18071":48534,"_5":17966,"_24599":48455,"_2447":48535},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2937":2060,"_26000":2031,"_18071":48537,"_5":17966,"_24599":48455,"_2447":48538},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2937":2061,"_26000":2031,"_18071":48540,"_5":17966,"_24599":48455,"_2447":48541},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2937":2062,"_26000":2031,"_18071":48543,"_5":17966,"_24599":48459,"_2447":48544},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2937":2063,"_26000":2031,"_18071":48546,"_5":17966,"_24599":48459,"_2447":48547},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2937":2064,"_26000":2031,"_18071":48549,"_5":17966,"_24599":48463,"_2447":48550},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2937":2065,"_26000":2031,"_18071":48552,"_5":17966,"_24599":48463,"_2447":48553},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2937":2066,"_26000":2031,"_18071":48555,"_5":17966,"_24599":48463,"_2447":48556},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2937":2067,"_26000":2031,"_18071":48558,"_5":17966,"_24599":48463,"_2447":48559},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2937":2068,"_26000":2031,"_18071":48561,"_5":17966,"_24599":48463,"_2447":48562},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2937":2069,"_26000":2031,"_18071":48564,"_5":17966,"_24599":48467,"_2447":48565},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2937":2070,"_26000":2031,"_18071":48567,"_5":17966,"_24599":48467,"_2447":45357},[],{"_2937":2071,"_26000":2031,"_18071":48569,"_5":17966,"_24599":48467,"_2447":48570},[],"Relative path",{"_2937":2072,"_26000":2031,"_18071":48572,"_5":17966,"_24599":48467,"_2447":45354},[],{"_2937":2073,"_26000":2031,"_18071":48574,"_5":17966,"_24599":48467,"_2447":48575},[],"`GET`",{"_2937":2074,"_26000":2031,"_18071":48577,"_5":17966,"_24599":48467,"_2447":48578},[],"`/v1/roles/{ca-ski}`",{"_2937":2075,"_26000":2031,"_18071":48580,"_5":17966,"_24599":48467,"_2447":48581},[],"Read `crl_options` and `latest_crl`.",{"_2937":2076,"_26000":2031,"_18071":48583,"_5":17966,"_24599":48467,"_2447":48584},[],"`PUT`",{"_2937":2077,"_26000":2031,"_18071":48586,"_5":17966,"_24599":48467,"_2447":48578},[],{"_2937":2078,"_26000":2031,"_18071":48588,"_5":17966,"_24599":48467,"_2447":48589},[],"Replace CRL configuration.",{"_2937":2079,"_26000":2031,"_18071":48591,"_5":17966,"_24599":48467,"_2447":48592},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2937":2080,"_26000":2031,"_18071":48594,"_5":17966,"_24599":48467,"_2447":48595},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2937":2081,"_26000":2031,"_18071":48597,"_5":17966,"_24599":48471,"_2447":48598},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2937":2082,"_26000":2031,"_18071":48600,"_5":17966,"_24599":48475,"_2447":48601},[],"RFC 5280: X.509 and CRL profile.",{"_2937":2083,"_26000":2031,"_18071":48603,"_5":17966,"_24599":48475,"_2447":48604},[],"OpenSSL: openssl-crl.",{"_2937":2084,"_26000":2031,"_18071":48606,"_5":17966,"_24599":48475,"_2447":48607},[],"OpenSSL: openssl-verify.",{"_2937":2085,"_26000":2031,"_18071":48609,"_5":17966,"_24599":48475,"_2447":48610},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2937":2086,"_26000":2031,"_18071":48612,"_5":17966,"_24599":48475,"_2447":48613},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2937":2087,"_26000":2087,"_5":12545,"_2447":48615,"_26339":48616,"_18071":48617,"_24599":2087},"Keys and cryptographic engines",[42089,43636,47313,47314],[],{"_2937":2088,"_26000":2087,"_18071":48619,"_5":17966,"_24599":2087,"_2447":48620},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2937":2089,"_26000":2087,"_5":26336,"_18071":48622,"_24599":48623,"_2447":48624},[],"/docs/pr-preview/pr-26/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2937":2090,"_26000":2087,"_5":26336,"_18071":48626,"_24599":48627,"_2447":48628},[],"/docs/pr-preview/pr-26/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2937":2091,"_26000":2087,"_5":26336,"_18071":48630,"_24599":48631,"_2447":48632},[],"/docs/pr-preview/pr-26/platform/pki/key-management#file-system","File System",{"_2937":2092,"_26000":2087,"_5":26336,"_18071":48634,"_24599":48635,"_2447":48636},[],"/docs/pr-preview/pr-26/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2937":2093,"_26000":2087,"_5":26336,"_18071":48638,"_24599":48639,"_2447":48640},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2937":2094,"_26000":2087,"_5":26336,"_18071":48642,"_24599":48643,"_2447":48644},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-kms","AWS KMS",{"_2937":2095,"_26000":2087,"_5":26336,"_18071":48646,"_24599":48647,"_2447":48648},[],"/docs/pr-preview/pr-26/platform/pki/key-management#pkcs11","PKCS#11",{"_2937":2096,"_26000":2087,"_5":26336,"_18071":48650,"_24599":48651,"_2447":48652},[],"/docs/pr-preview/pr-26/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2937":2097,"_26000":2087,"_5":26336,"_18071":48654,"_24599":48655,"_2447":48656},[],"/docs/pr-preview/pr-26/platform/pki/key-management#key-inventory","Key inventory",{"_2937":2098,"_26000":2087,"_5":26336,"_18071":48658,"_24599":48659,"_2447":48660},[],"/docs/pr-preview/pr-26/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2937":2099,"_26000":2087,"_5":26336,"_18071":48662,"_24599":48663,"_2447":48664},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2937":2100,"_26000":2087,"_5":26336,"_18071":48666,"_24599":48667,"_2447":48668},[],"/docs/pr-preview/pr-26/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2937":2101,"_26000":2087,"_5":26336,"_18071":48670,"_24599":48671,"_2447":48672},[],"/docs/pr-preview/pr-26/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2937":2102,"_26000":2087,"_5":26336,"_18071":48674,"_24599":48675,"_2447":48676},[],"/docs/pr-preview/pr-26/platform/pki/key-management#view-details","View details",{"_2937":2103,"_26000":2087,"_5":26336,"_18071":48678,"_24599":48679,"_2447":48680},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2937":2104,"_26000":2087,"_5":26336,"_18071":48682,"_24599":48683,"_2447":48684},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign","Sign",{"_2937":2105,"_26000":2087,"_5":26336,"_18071":48686,"_24599":48687,"_2447":48688},[],"/docs/pr-preview/pr-26/platform/pki/key-management#verify","Verify",{"_2937":2106,"_26000":2087,"_5":26336,"_18071":48690,"_24599":48691,"_2447":48692},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2937":2107,"_26000":2087,"_5":26336,"_18071":48694,"_24599":48695,"_2447":48696},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2937":2108,"_26000":2087,"_5":26336,"_18071":48698,"_24599":48699,"_2447":48700},[],"/docs/pr-preview/pr-26/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2937":2109,"_26000":2087,"_18071":48702,"_5":17966,"_24599":2087,"_2447":48703},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2937":2110,"_26000":2087,"_18071":48705,"_5":17966,"_24599":2087,"_2447":48706},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2937":2111,"_26000":2087,"_18071":48708,"_5":17966,"_24599":48623,"_2447":48709},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2937":2112,"_26000":2087,"_18071":48711,"_5":17966,"_24599":48623,"_2447":48712},[],"In practice, it lets you:",{"_2937":2113,"_26000":2087,"_18071":48714,"_5":17966,"_24599":48623,"_2447":48715},[],"Generate new key pairs from Lamassu IoT.",{"_2937":2114,"_26000":2087,"_18071":48717,"_5":17966,"_24599":48623,"_2447":48718},[],"Import keys created externally.",{"_2937":2115,"_26000":2087,"_18071":48720,"_5":17966,"_24599":48623,"_2447":48721},[],"Delegate custody and cryptographic operations to external engines.",{"_2937":2116,"_26000":2087,"_18071":48723,"_5":17966,"_24599":48623,"_2447":48724},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2937":2117,"_26000":2087,"_18071":48726,"_5":17966,"_24599":48627,"_2447":48727},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2937":2118,"_26000":2087,"_18071":48729,"_5":17966,"_24599":48627,"_2447":48730},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2937":2119,"_26000":2087,"_18071":48732,"_5":17966,"_24599":48627,"_2447":48733},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2937":2120,"_26000":2087,"_18071":48735,"_5":17966,"_24599":48631,"_2447":48736},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2937":2121,"_26000":2087,"_18071":48738,"_5":17966,"_24599":48635,"_2447":48739},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2937":2122,"_26000":2087,"_18071":48741,"_5":17966,"_24599":48639,"_2447":48742},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2937":2123,"_26000":2087,"_18071":48744,"_5":17966,"_24599":48643,"_2447":48745},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2937":2124,"_26000":2087,"_18071":48747,"_5":17966,"_24599":48647,"_2447":48748},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2937":2125,"_26000":2087,"_18071":48750,"_5":17966,"_24599":48651,"_2447":48751},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2937":2126,"_26000":2087,"_18071":48753,"_5":17966,"_24599":48651,"_2447":48754},[],"Lamassu shows the enabled engines in the console.",{"_2937":2127,"_26000":2087,"_18071":48756,"_5":17966,"_24599":48651,"_2447":48757},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2937":2128,"_26000":2087,"_18071":48759,"_5":17966,"_24599":48651,"_2447":48760},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2937":2129,"_26000":2087,"_18071":48762,"_5":17966,"_24599":48655,"_2447":48763},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2937":2130,"_26000":2087,"_18071":48765,"_5":17966,"_24599":48655,"_2447":48766},[],"The table includes the following fields:",{"_2937":2131,"_26000":2087,"_18071":48768,"_5":17966,"_24599":48655,"_2447":48769},[],"**Name**: descriptive name of the key.",{"_2937":2132,"_26000":2087,"_18071":48771,"_5":17966,"_24599":48655,"_2447":48772},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2937":2133,"_26000":2087,"_18071":48774,"_5":17966,"_24599":48655,"_2447":48775},[],"**Strength**: visual indicator of cryptographic strength.",{"_2937":2134,"_26000":2087,"_18071":48777,"_5":17966,"_24599":48655,"_2447":48778},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2937":2135,"_26000":2087,"_18071":48780,"_5":17966,"_24599":48655,"_2447":48781},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2937":2136,"_26000":2087,"_18071":48783,"_5":17966,"_24599":48655,"_2447":48784},[],"**Aliases**: alternative names associated with the key.",{"_2937":2137,"_26000":2087,"_18071":48786,"_5":17966,"_24599":48655,"_2447":48787},[],"**Tags**: labels for classification and search.",{"_2937":2138,"_26000":2087,"_18071":48789,"_5":17966,"_24599":48655,"_2447":48790},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2937":2139,"_26000":2087,"_18071":48792,"_5":17966,"_24599":48655,"_2447":48793},[],"From this view you also reach the most common actions:",{"_2937":2140,"_26000":2087,"_18071":48795,"_5":17966,"_24599":48655,"_2447":48796},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2937":2141,"_26000":2087,"_18071":48798,"_5":17966,"_24599":48655,"_2447":48799},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2937":2142,"_26000":2087,"_18071":48801,"_5":17966,"_24599":48655,"_2447":48802},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2937":2143,"_26000":2087,"_18071":48804,"_5":17966,"_24599":48655,"_2447":48805},[],"**Delete Key** to remove the key from the system.",{"_2937":2144,"_26000":2087,"_18071":48807,"_5":17966,"_24599":48659,"_2447":48808},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2937":2145,"_26000":2087,"_18071":48810,"_5":17966,"_24599":48663,"_2447":48811},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2937":2146,"_26000":2087,"_18071":48813,"_5":17966,"_24599":48663,"_2447":48814},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2937":2147,"_26000":2087,"_18071":48816,"_5":17966,"_24599":48663,"_2447":48817},[],"**Key Name**: unique and descriptive name.",{"_2937":2148,"_26000":2087,"_18071":48819,"_5":17966,"_24599":48663,"_2447":48820},[],"**Crypto Engine**: engine that will keep the key.",{"_2937":2149,"_26000":2087,"_18071":48822,"_5":17966,"_24599":48663,"_2447":48823},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2937":2150,"_26000":2087,"_18071":48825,"_5":17966,"_24599":48663,"_2447":48826},[],"**Tags**: metadata to classify the key.",{"_2937":2151,"_26000":2087,"_18071":48828,"_5":17966,"_24599":48663,"_2447":48829},[],"**Metadata**: additional information for advanced uses.",{"_2937":2152,"_26000":2087,"_18071":48831,"_5":17966,"_24599":48667,"_2447":48832},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2937":2153,"_26000":2087,"_18071":48834,"_5":17966,"_24599":48667,"_2447":48835},[],"When you have an exportable private key and the destination engine supports import.",{"_2937":2154,"_26000":2087,"_18071":48837,"_5":17966,"_24599":48667,"_2447":48838},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2937":2155,"_26000":2087,"_18071":48840,"_5":17966,"_24599":48667,"_2447":48841},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2937":2156,"_26000":2087,"_18071":48843,"_5":17966,"_24599":48667,"_2447":48844},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2937":2157,"_26000":2087,"_18071":48846,"_5":17966,"_24599":48667,"_2447":48847},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2937":2158,"_26000":2087,"_18071":48849,"_5":17966,"_24599":48667,"_2447":48850},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2937":2159,"_26000":2087,"_18071":48852,"_5":17966,"_24599":48667,"_2447":48853},[],"**Tags**: labels for organization and search.",{"_2937":2160,"_26000":2087,"_18071":48855,"_5":17966,"_24599":48667,"_2447":48856},[],"**Metadata**: additional optional information.",{"_2937":2161,"_26000":2087,"_18071":48858,"_5":17966,"_24599":48667,"_2447":48859},[],"**Private Key (PEM)**: private key in PEM format.",{"_2937":2162,"_26000":2087,"_18071":48861,"_5":17966,"_24599":48667,"_2447":48862},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2937":2163,"_26000":2087,"_18071":48864,"_5":17966,"_24599":48671,"_2447":48865},[],"Each registered key has a detail view and several operational actions.",{"_2937":2164,"_26000":2087,"_18071":48867,"_5":17966,"_24599":48675,"_2447":48868},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2937":2165,"_26000":2087,"_18071":48870,"_5":17966,"_24599":48675,"_2447":48871},[],"The **Overview** tab shows, among others, these fields:",{"_2937":2166,"_26000":2087,"_18071":48873,"_5":17966,"_24599":48675,"_2447":48874},[],"**Key Name**: descriptive name.",{"_2937":2167,"_26000":2087,"_18071":48876,"_5":17966,"_24599":48675,"_2447":48877},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2937":2168,"_26000":2087,"_18071":48879,"_5":17966,"_24599":48675,"_2447":48880},[],"**Tags**: associated labels.",{"_2937":2169,"_26000":2087,"_18071":48882,"_5":17966,"_24599":48675,"_2447":48883},[],"**Aliases**: alternative names.",{"_2937":2170,"_26000":2087,"_18071":48885,"_5":17966,"_24599":48675,"_2447":48886},[],"**Crypto Engine**: engine where the key resides.",{"_2937":2171,"_26000":2087,"_18071":48888,"_5":17966,"_24599":48675,"_2447":48889},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2937":2172,"_26000":2087,"_18071":48891,"_5":17966,"_24599":48675,"_2447":48892},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2937":2173,"_26000":2087,"_18071":48894,"_5":17966,"_24599":48675,"_2447":48895},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2937":2174,"_26000":2087,"_18071":48897,"_5":17966,"_24599":48679,"_2447":48898},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2937":2175,"_26000":2087,"_18071":48900,"_5":17966,"_24599":48679,"_2447":48901},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2937":2176,"_26000":2087,"_18071":48903,"_5":17966,"_24599":48679,"_2447":48904},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2937":2177,"_26000":2087,"_18071":48906,"_5":17966,"_24599":48683,"_2447":48907},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2937":2178,"_26000":2087,"_18071":48909,"_5":17966,"_24599":48683,"_2447":48910},[],"Main fields:",{"_2937":2179,"_26000":2087,"_18071":48912,"_5":17966,"_24599":48683,"_2447":48913},[],"**Algorithm**: signing algorithm available for the key type.",{"_2937":2180,"_26000":2087,"_18071":48915,"_5":17966,"_24599":48683,"_2447":48916},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2937":2181,"_26000":2087,"_18071":48918,"_5":17966,"_24599":48683,"_2447":48919},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2937":2182,"_26000":2087,"_18071":48921,"_5":17966,"_24599":48683,"_2447":48922},[],"**Message**: content to sign.",{"_2937":2183,"_26000":2087,"_18071":48924,"_5":17966,"_24599":48683,"_2447":48925},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2937":2184,"_26000":2087,"_18071":48927,"_5":17966,"_24599":48687,"_2447":48928},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2937":2185,"_26000":2087,"_18071":48930,"_5":17966,"_24599":48687,"_2447":48910},[],{"_2937":2186,"_26000":2087,"_18071":48932,"_5":17966,"_24599":48687,"_2447":48933},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2937":2187,"_26000":2087,"_18071":48935,"_5":17966,"_24599":48687,"_2447":48936},[],"**Message Type**: `Raw` or `Digest`.",{"_2937":2188,"_26000":2087,"_18071":48938,"_5":17966,"_24599":48687,"_2447":48939},[],"**Payload Encoding**: encoding of the message.",{"_2937":2189,"_26000":2087,"_18071":48941,"_5":17966,"_24599":48687,"_2447":48942},[],"**Message**: original message or hash.",{"_2937":2190,"_26000":2087,"_18071":48944,"_5":17966,"_24599":48687,"_2447":48945},[],"**Signature**: signature to check.",{"_2937":2191,"_26000":2087,"_18071":48947,"_5":17966,"_24599":48687,"_2447":48948},[],"**Result**: indicator of the validation result.",{"_2937":2192,"_26000":2087,"_18071":48950,"_5":17966,"_24599":48691,"_2447":48951},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2937":2193,"_26000":2087,"_18071":48953,"_5":17966,"_24599":48691,"_2447":48954},[],"This flow is useful for:",{"_2937":2194,"_26000":2087,"_18071":48956,"_5":17966,"_24599":48691,"_2447":48957},[],"Requesting certificates from an external CA.",{"_2937":2195,"_26000":2087,"_18071":48959,"_5":17966,"_24599":48691,"_2447":48960},[],"Renewing an identity while keeping the same key.",{"_2937":2196,"_26000":2087,"_18071":48962,"_5":17966,"_24599":48691,"_2447":48963},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2937":2197,"_26000":2087,"_18071":48965,"_5":17966,"_24599":48691,"_2447":48966},[],"**Common Name (CN)**: main name of the identity.",{"_2937":2198,"_26000":2087,"_18071":48968,"_5":17966,"_24599":48691,"_2447":48969},[],"**Organization (O)**: organization or company.",{"_2937":2199,"_26000":2087,"_18071":48971,"_5":17966,"_24599":48691,"_2447":48972},[],"**Organizational Unit (OU)**: department or unit.",{"_2937":2200,"_26000":2087,"_18071":48974,"_5":17966,"_24599":48691,"_2447":48975},[],"**Country (C)**: two-letter country code.",{"_2937":2201,"_26000":2087,"_18071":48977,"_5":17966,"_24599":48691,"_2447":48978},[],"**State / Province (ST)**: state or province.",{"_2937":2202,"_26000":2087,"_18071":48980,"_5":17966,"_24599":48691,"_2447":48981},[],"**Locality (L)**: city or locality.",{"_2937":2203,"_26000":2087,"_18071":48983,"_5":17966,"_24599":48691,"_2447":48984},[],"**Email Address**: contact email.",{"_2937":2204,"_26000":2087,"_18071":48986,"_5":17966,"_24599":48691,"_2447":48987},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2937":2205,"_26000":2087,"_18071":48989,"_5":17966,"_24599":48691,"_2447":48990},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2937":2206,"_26000":2087,"_18071":48992,"_5":17966,"_24599":48695,"_2447":48993},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2937":2207,"_26000":2087,"_18071":48995,"_5":17966,"_24599":48695,"_2447":48996},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2937":2208,"_26000":2087,"_18071":48998,"_5":17966,"_24599":48699,"_2447":48999},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2937":2209,"_26000":2209,"_5":12545,"_2447":49001,"_26339":49002,"_18071":49003,"_24599":2209},"Online validation with OCSP",[42089,43636,47313,47930],[],{"_2937":2210,"_26000":2209,"_18071":49005,"_5":17966,"_24599":2209,"_2447":49006},[],"Query signed status and verify the responder’s response.",{"_2937":2211,"_26000":2209,"_5":26336,"_18071":49008,"_24599":49009,"_2447":49010},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2937":2212,"_26000":2209,"_5":26336,"_18071":49012,"_24599":49013,"_2447":49014},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2937":2213,"_26000":2209,"_5":26336,"_18071":49016,"_24599":49017,"_2447":49018},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2937":2214,"_26000":2209,"_5":26336,"_18071":49020,"_24599":49021,"_2447":49022},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2937":2215,"_26000":2209,"_5":26336,"_18071":49024,"_24599":49025,"_2447":49026},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2937":2216,"_26000":2209,"_5":26336,"_18071":49028,"_24599":49029,"_2447":48476},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#references",{"_2937":2217,"_26000":2209,"_18071":49031,"_5":17966,"_24599":2209,"_2447":49032},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2937":2218,"_26000":2209,"_18071":49034,"_5":17966,"_24599":49009,"_2447":49035},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2937":2219,"_26000":2209,"_18071":49037,"_5":17966,"_24599":49009,"_2447":49038},[],"Record status",{"_2937":2220,"_26000":2209,"_18071":49040,"_5":17966,"_24599":49009,"_2447":49041},[],"Signed response",{"_2937":2221,"_26000":2209,"_18071":49043,"_5":17966,"_24599":49009,"_2447":46491},[],{"_2937":2222,"_26000":2209,"_18071":49045,"_5":17966,"_24599":49009,"_2447":49046},[],"`Good`.",{"_2937":2223,"_26000":2209,"_18071":49048,"_5":17966,"_24599":49009,"_2447":46508},[],{"_2937":2224,"_26000":2209,"_18071":49050,"_5":17966,"_24599":49009,"_2447":49051},[],"`Revoked`, with revocation reason and timestamp.",{"_2937":2225,"_26000":2209,"_18071":49053,"_5":17966,"_24599":49009,"_2447":49054},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2937":2226,"_26000":2209,"_18071":49056,"_5":17966,"_24599":49009,"_2447":49057},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2937":2227,"_26000":2209,"_18071":49059,"_5":17966,"_24599":49009,"_2447":49060},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2937":2228,"_26000":2209,"_18071":49062,"_5":17966,"_24599":49009,"_2447":49063},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2937":2229,"_26000":2209,"_18071":49065,"_5":17966,"_24599":49009,"_2447":49066},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2937":2230,"_26000":2209,"_18071":49068,"_5":17966,"_24599":49013,"_2447":49069},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2937":2231,"_26000":2209,"_18071":49071,"_5":17966,"_24599":49013,"_2447":49072},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2937":2232,"_26000":2209,"_18071":49074,"_5":17966,"_24599":49017,"_2447":49075},[],"The service accepts:",{"_2937":2233,"_26000":2209,"_18071":49077,"_5":17966,"_24599":49017,"_2447":45357},[],{"_2937":2234,"_26000":2209,"_18071":49079,"_5":17966,"_24599":49017,"_2447":49080},[],"VA service path",{"_2937":2235,"_26000":2209,"_18071":49082,"_5":17966,"_24599":49017,"_2447":49083},[],"Format",{"_2937":2236,"_26000":2209,"_18071":49085,"_5":17966,"_24599":49017,"_2447":49086},[],"`POST`",{"_2937":2237,"_26000":2209,"_18071":49088,"_5":17966,"_24599":49017,"_2447":49089},[],"`/ocsp`",{"_2937":2238,"_26000":2209,"_18071":49091,"_5":17966,"_24599":49017,"_2447":49092},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2937":2239,"_26000":2209,"_18071":49094,"_5":17966,"_24599":49017,"_2447":48575},[],{"_2937":2240,"_26000":2209,"_18071":49096,"_5":17966,"_24599":49017,"_2447":49097},[],"`/ocsp/{ocsp_request}`",{"_2937":2241,"_26000":2209,"_18071":49099,"_5":17966,"_24599":49017,"_2447":49100},[],"DER request encoded using padded URL Base64.",{"_2937":2242,"_26000":2209,"_18071":49102,"_5":17966,"_24599":49017,"_2447":49103},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2937":2243,"_26000":2209,"_18071":49105,"_5":17966,"_24599":49021,"_2447":49106},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2937":2244,"_26000":2209,"_18071":49108,"_5":17966,"_24599":49021,"_2447":49109},[],"Generate the request:",{"_2937":2245,"_26000":2209,"_18071":49111,"_5":17966,"_24599":49021,"_2447":49112},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2937":2246,"_26000":2209,"_18071":49114,"_5":17966,"_24599":49021,"_2447":49115},[],"Replace the example URL with the inspected endpoint:",{"_2937":2247,"_26000":2209,"_18071":49117,"_5":17966,"_24599":49021,"_2447":49118},[],"Verify the returned DER:",{"_2937":2248,"_26000":2209,"_18071":49120,"_5":17966,"_24599":49021,"_2447":49121},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2937":2249,"_26000":2209,"_18071":49123,"_5":17966,"_24599":49025,"_2447":49124},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2937":2250,"_26000":2209,"_18071":49126,"_5":17966,"_24599":49025,"_2447":49127},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2937":2251,"_26000":2209,"_18071":49129,"_5":17966,"_24599":49029,"_2447":49130},[],"RFC 6960: OCSP.",{"_2937":2252,"_26000":2209,"_18071":49132,"_5":17966,"_24599":49029,"_2447":49133},[],"OpenSSL: openssl-ocsp.",{"_2937":2253,"_26000":2209,"_18071":49135,"_5":17966,"_24599":49029,"_2447":49136},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2937":2254,"_26000":2209,"_18071":49138,"_5":17966,"_24599":49029,"_2447":48613},[],{"_2937":2255,"_26000":2255,"_5":12545,"_2447":47313,"_26339":49140,"_18071":49141,"_24599":2255},[42089,43636,47313],[],{"_2937":2256,"_26000":2255,"_18071":49143,"_5":17966,"_24599":2255,"_2447":49144},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2937":2257,"_26000":2255,"_5":26336,"_18071":49146,"_24599":49147,"_2447":46623},[],"/docs/pr-preview/pr-26/platform/pki/overview#start-here",{"_2937":2258,"_26000":2255,"_5":26336,"_18071":49149,"_24599":49150,"_2447":49151},[],"/docs/pr-preview/pr-26/platform/pki/overview#what-you-need","What you need",{"_2937":2259,"_26000":2255,"_5":26336,"_18071":49153,"_24599":49154,"_2447":47157},[],"/docs/pr-preview/pr-26/platform/pki/overview#core-capabilities",{"_2937":2260,"_26000":2255,"_5":26336,"_18071":49156,"_24599":49157,"_2447":47161},[],"/docs/pr-preview/pr-26/platform/pki/overview#build-your-trust-hierarchy",{"_2937":2261,"_26000":2255,"_5":26336,"_18071":49159,"_24599":49160,"_2447":47165},[],"/docs/pr-preview/pr-26/platform/pki/overview#protect-cryptographic-keys",{"_2937":2262,"_26000":2255,"_5":26336,"_18071":49162,"_24599":49163,"_2447":47169},[],"/docs/pr-preview/pr-26/platform/pki/overview#issue-and-control-certificates",{"_2937":2263,"_26000":2255,"_5":26336,"_18071":49165,"_24599":49166,"_2447":47177},[],"/docs/pr-preview/pr-26/platform/pki/overview#publish-validation-status",{"_2937":2264,"_26000":2255,"_5":26336,"_18071":49168,"_24599":49169,"_2447":49170},[],"/docs/pr-preview/pr-26/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2937":2265,"_26000":2255,"_5":26336,"_18071":49172,"_24599":49173,"_2447":48097},[],"/docs/pr-preview/pr-26/platform/pki/overview#continue",{"_2937":2266,"_26000":2255,"_18071":49175,"_5":17966,"_24599":2255,"_2447":49176},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2937":2267,"_26000":2255,"_18071":49178,"_5":17966,"_24599":49147,"_2447":49179},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2937":2268,"_26000":2255,"_18071":49181,"_5":17966,"_24599":49147,"_2447":49182},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2937":2269,"_26000":2255,"_18071":49184,"_5":17966,"_24599":49150,"_2447":49185},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2937":2270,"_26000":2255,"_18071":49187,"_5":17966,"_24599":49150,"_2447":49188},[],"An available cryptographic engine to keep the authority's key.",{"_2937":2271,"_26000":2255,"_18071":49190,"_5":17966,"_24599":49150,"_2447":49191},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2937":2272,"_26000":2255,"_18071":49193,"_5":17966,"_24599":49150,"_2447":49194},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2937":2273,"_26000":2255,"_18071":49196,"_5":17966,"_24599":49150,"_2447":49197},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2937":2274,"_26000":2255,"_18071":49199,"_5":17966,"_24599":49157,"_2447":49200},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2937":2275,"_26000":2255,"_18071":49202,"_5":17966,"_24599":49160,"_2447":49203},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2937":2276,"_26000":2255,"_18071":49205,"_5":17966,"_24599":49163,"_2447":49206},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2937":2277,"_26000":2255,"_18071":49208,"_5":17966,"_24599":49166,"_2447":49209},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2937":2278,"_26000":2255,"_18071":49211,"_5":17966,"_24599":49169,"_2447":49212},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2937":2279,"_26000":2255,"_18071":49214,"_5":17966,"_24599":49169,"_2447":49215},[],"its subject and extensions identify the expected client;",{"_2937":2280,"_26000":2255,"_18071":49217,"_5":17966,"_24599":49169,"_2447":49218},[],"its public key matches the client's private key;",{"_2937":2281,"_26000":2255,"_18071":49220,"_5":17966,"_24599":49169,"_2447":49221},[],"its chain reaches a root trusted by the consumer;",{"_2937":2282,"_26000":2255,"_18071":49223,"_5":17966,"_24599":49169,"_2447":49224},[],"its dates and usages allow the operation;",{"_2937":2283,"_26000":2255,"_18071":49226,"_5":17966,"_24599":49169,"_2447":49227},[],"the consumer applies revocation checks and authorization.",{"_2937":2284,"_26000":2255,"_18071":49229,"_5":17966,"_24599":49169,"_2447":49230},[],"The issuance path includes the first independent checks.",{"_2937":2285,"_26000":2255,"_18071":49232,"_5":17966,"_24599":49173,"_2447":49233},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2937":2286,"_26000":2255,"_18071":49235,"_5":17966,"_24599":49173,"_2447":49236},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2937":2287,"_26000":2255,"_18071":49238,"_5":17966,"_24599":49173,"_2447":49239},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2937":2288,"_26000":2288,"_5":12545,"_2447":49241,"_26339":49242,"_18071":49243,"_24599":2288},"Create your first CA",[42089,43636,47313,46748],[],{"_2937":2289,"_26000":2288,"_18071":49245,"_5":17966,"_24599":2288,"_2447":49246},[],"Create an evaluation root and check its certificate before issuing.",{"_2937":2290,"_26000":2288,"_5":26336,"_18071":49248,"_24599":49249,"_2447":42099},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2937":2291,"_26000":2288,"_5":26336,"_18071":49251,"_24599":49252,"_2447":49253},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2937":2292,"_26000":2288,"_5":26336,"_18071":49255,"_24599":49256,"_2447":49257},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2937":2293,"_26000":2288,"_5":26336,"_18071":49259,"_24599":49260,"_2447":49261},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2937":2294,"_26000":2288,"_5":26336,"_18071":49263,"_24599":49264,"_2447":49265},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2937":2295,"_26000":2288,"_5":26336,"_18071":49267,"_24599":49268,"_2447":49269},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2937":2296,"_26000":2288,"_5":26336,"_18071":49271,"_24599":49272,"_2447":49273},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2937":2297,"_26000":2288,"_5":26336,"_18071":49275,"_24599":49276,"_2447":47006},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2937":2298,"_26000":2288,"_5":26336,"_18071":49278,"_24599":49279,"_2447":42123},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2937":2299,"_26000":2288,"_18071":49281,"_5":17966,"_24599":2288,"_2447":49282},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2937":2300,"_26000":2288,"_18071":49284,"_5":17966,"_24599":49249,"_2447":49285},[],"Console access and permission to create keys and authorities.",{"_2937":2301,"_26000":2288,"_18071":49287,"_5":17966,"_24599":49249,"_2447":49288},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2937":2302,"_26000":2288,"_18071":49290,"_5":17966,"_24599":49249,"_2447":49291},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2937":2303,"_26000":2288,"_18071":49293,"_5":17966,"_24599":49249,"_2447":49294},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2937":2304,"_26000":2288,"_18071":49296,"_5":17966,"_24599":49252,"_2447":49297},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2937":2305,"_26000":2288,"_18071":49299,"_5":17966,"_24599":49252,"_2447":49300},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2937":2306,"_26000":2288,"_18071":49302,"_5":17966,"_24599":49256,"_2447":49303},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2937":2307,"_26000":2288,"_18071":49305,"_5":17966,"_24599":49256,"_2447":49306},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2937":2308,"_26000":2288,"_18071":49308,"_5":17966,"_24599":49260,"_2447":49309},[],"Select **Root CA** and complete:",{"_2937":2309,"_26000":2288,"_18071":49311,"_5":17966,"_24599":49260,"_2447":49312},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2937":2310,"_26000":2288,"_18071":49314,"_5":17966,"_24599":49260,"_2447":49315},[],"**Subject**: organization and country details for your evaluation.",{"_2937":2311,"_26000":2288,"_18071":49317,"_5":17966,"_24599":49260,"_2447":49318},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2937":2312,"_26000":2288,"_18071":49320,"_5":17966,"_24599":49260,"_2447":49321},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2937":2313,"_26000":2288,"_18071":49323,"_5":17966,"_24599":49260,"_2447":49324},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2937":2314,"_26000":2288,"_18071":49326,"_5":17966,"_24599":49264,"_2447":49327},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2937":2315,"_26000":2288,"_18071":49329,"_5":17966,"_24599":49268,"_2447":49330},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2937":2316,"_26000":2288,"_18071":49332,"_5":17966,"_24599":49268,"_2447":49333},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2937":2317,"_26000":2288,"_18071":49335,"_5":17966,"_24599":49272,"_2447":49336},[],"Run from the directory where you saved `ca.pem`:",{"_2937":2318,"_26000":2288,"_18071":49338,"_5":17966,"_24599":49272,"_2447":49339},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2937":2319,"_26000":2288,"_18071":49341,"_5":17966,"_24599":49272,"_2447":49342},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2937":2320,"_26000":2288,"_18071":49344,"_5":17966,"_24599":49276,"_2447":49345},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2937":2321,"_26000":2288,"_18071":49347,"_5":17966,"_24599":49276,"_2447":49348},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2937":2322,"_26000":2288,"_18071":49350,"_5":17966,"_24599":49276,"_2447":49351},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2937":2323,"_26000":2288,"_18071":49353,"_5":17966,"_24599":49276,"_2447":49354},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2937":2324,"_26000":2288,"_18071":49356,"_5":17966,"_24599":49279,"_2447":49357},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2937":2325,"_26000":2325,"_5":12545,"_2447":49359,"_26339":49360,"_18071":49361,"_24599":2325},"Issue and verify a certificate",[42089,43636,47313,46748],[],{"_2937":2326,"_26000":2325,"_18071":49363,"_5":17966,"_24599":2325,"_2447":49364},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2937":2327,"_26000":2325,"_5":26336,"_18071":49366,"_24599":49367,"_2447":42099},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2937":2328,"_26000":2325,"_5":26336,"_18071":49369,"_24599":49370,"_2447":49371},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2937":2329,"_26000":2325,"_5":26336,"_18071":49373,"_24599":49374,"_2447":49375},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2937":2330,"_26000":2325,"_5":26336,"_18071":49377,"_24599":49378,"_2447":49379},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2937":2331,"_26000":2325,"_5":26336,"_18071":49381,"_24599":49382,"_2447":49383},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2937":2332,"_26000":2325,"_5":26336,"_18071":49385,"_24599":49386,"_2447":49387},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2937":2333,"_26000":2325,"_5":26336,"_18071":49389,"_24599":49390,"_2447":49269},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2937":2334,"_26000":2325,"_5":26336,"_18071":49392,"_24599":49393,"_2447":49394},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2937":2335,"_26000":2325,"_5":26336,"_18071":49396,"_24599":49397,"_2447":49398},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2937":2336,"_26000":2325,"_5":26336,"_18071":49400,"_24599":49401,"_2447":49402},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2937":2337,"_26000":2325,"_5":26336,"_18071":49404,"_24599":49405,"_2447":47006},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2937":2338,"_26000":2325,"_5":26336,"_18071":49407,"_24599":49408,"_2447":42123},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#next-step",{"_2937":2339,"_26000":2325,"_18071":49410,"_5":17966,"_24599":2325,"_2447":49411},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2937":2340,"_26000":2325,"_18071":49413,"_5":17966,"_24599":49367,"_2447":49414},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2937":2341,"_26000":2325,"_18071":49416,"_5":17966,"_24599":49367,"_2447":49417},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2937":2342,"_26000":2325,"_18071":49419,"_5":17966,"_24599":49367,"_2447":49420},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2937":2343,"_26000":2325,"_18071":49422,"_5":17966,"_24599":49367,"_2447":49423},[],"A client identifier: here we use `device-001`.",{"_2937":2344,"_26000":2325,"_18071":49425,"_5":17966,"_24599":49367,"_2447":49426},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2937":2345,"_26000":2325,"_18071":49428,"_5":17966,"_24599":49370,"_2447":49429},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2937":2346,"_26000":2325,"_18071":49431,"_5":17966,"_24599":49374,"_2447":49432},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2937":2347,"_26000":2325,"_18071":49434,"_5":17966,"_24599":49374,"_2447":49435},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2937":2348,"_26000":2325,"_18071":49437,"_5":17966,"_24599":49378,"_2447":49438},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2937":2349,"_26000":2325,"_18071":49440,"_5":17966,"_24599":49378,"_2447":49441},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2937":2350,"_26000":2325,"_18071":49443,"_5":17966,"_24599":49382,"_2447":49444},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2937":2351,"_26000":2325,"_18071":49446,"_5":17966,"_24599":49382,"_2447":49447},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2937":2352,"_26000":2325,"_18071":49449,"_5":17966,"_24599":49386,"_2447":49450},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2937":2353,"_26000":2325,"_18071":49452,"_5":17966,"_24599":49390,"_2447":49453},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2937":2354,"_26000":2325,"_18071":49455,"_5":17966,"_24599":49393,"_2447":49456},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2937":2355,"_26000":2325,"_18071":49458,"_5":17966,"_24599":49397,"_2447":49459},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2937":2356,"_26000":2325,"_18071":49461,"_5":17966,"_24599":49397,"_2447":49462},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2937":2357,"_26000":2325,"_18071":49464,"_5":17966,"_24599":49397,"_2447":49465},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2937":2358,"_26000":2325,"_18071":49467,"_5":17966,"_24599":49401,"_2447":49468},[],"In Bash, compare the two public-key digests:",{"_2937":2359,"_26000":2325,"_18071":49470,"_5":17966,"_24599":49401,"_2447":49471},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2937":2360,"_26000":2325,"_18071":49473,"_5":17966,"_24599":49401,"_2447":49474},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2937":2361,"_26000":2325,"_18071":49476,"_5":17966,"_24599":49405,"_2447":47090},[],{"_2937":2362,"_26000":2325,"_18071":49478,"_5":17966,"_24599":49405,"_2447":49479},[],"What to review",{"_2937":2363,"_26000":2325,"_18071":49481,"_5":17966,"_24599":49405,"_2447":49482},[],"The CA rejects issuance",{"_2937":2364,"_26000":2325,"_18071":49484,"_5":17966,"_24599":49405,"_2447":49485},[],"Permissions, CA state and key, algorithm and profile.",{"_2937":2365,"_26000":2325,"_18071":49487,"_5":17966,"_24599":49405,"_2447":49488},[],"Different subject or usages",{"_2937":2366,"_26000":2325,"_18071":49490,"_5":17966,"_24599":49405,"_2447":49491},[],"Applied profile and requested values.",{"_2937":2367,"_26000":2325,"_18071":49493,"_5":17966,"_24599":49405,"_2447":49494},[],"Issuer cannot be found",{"_2937":2368,"_26000":2325,"_18071":49496,"_5":17966,"_24599":49405,"_2447":49497},[],"Downloaded CA and required intermediate chain.",{"_2937":2369,"_26000":2325,"_18071":49499,"_5":17966,"_24599":49405,"_2447":49500},[],"Validity fails",{"_2937":2370,"_26000":2325,"_18071":49502,"_5":17966,"_24599":49405,"_2447":49503},[],"Certificate and CA dates, and the computer's clock.",{"_2937":2371,"_26000":2325,"_18071":49505,"_5":17966,"_24599":49405,"_2447":49506},[],"Public-key digests differ",{"_2937":2372,"_26000":2325,"_18071":49508,"_5":17966,"_24599":49405,"_2447":49509},[],"Certificate and key files from the same issuance.",{"_2937":2373,"_26000":2325,"_18071":49511,"_5":17966,"_24599":49405,"_2447":49512},[],"See PKI diagnostics to narrow an issuance failure.",{"_2937":2374,"_26000":2325,"_18071":49514,"_5":17966,"_24599":49408,"_2447":49515},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2937":2375,"_26000":2325,"_18071":49517,"_5":17966,"_24599":49408,"_2447":49518},[],"Manage certificates for inspection, status and revocation.",{"_2937":2376,"_26000":2325,"_18071":49520,"_5":17966,"_24599":49408,"_2447":49521},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2937":2377,"_26000":2325,"_18071":49523,"_5":17966,"_24599":49408,"_2447":49524},[],"Prepare EST for the device to request its next identities.",{"_2937":2378,"_26000":2325,"_18071":49526,"_5":17966,"_24599":49408,"_2447":49527},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2937":2379,"_26000":2379,"_5":12545,"_2447":49529,"_26339":49530,"_18071":49531,"_24599":2379},"PKI getting started",[42089,43636,47313,46748],[],{"_2937":2380,"_26000":2379,"_18071":49533,"_5":17966,"_24599":2379,"_2447":49534},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2937":2381,"_26000":2379,"_5":26336,"_18071":49536,"_24599":49537,"_2447":42099},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#before-you-begin",{"_2937":2382,"_26000":2379,"_5":26336,"_18071":49539,"_24599":49540,"_2447":49541},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2937":2383,"_26000":2379,"_5":26336,"_18071":49543,"_24599":49544,"_2447":46940},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#expected-result",{"_2937":2384,"_26000":2379,"_5":26336,"_18071":49546,"_24599":49547,"_2447":49548},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2937":2385,"_26000":2379,"_18071":49550,"_5":17966,"_24599":2379,"_2447":49551},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2937":2386,"_26000":2379,"_18071":49553,"_5":17966,"_24599":49537,"_2447":49554},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2937":2387,"_26000":2379,"_18071":49556,"_5":17966,"_24599":49537,"_2447":49557},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2937":2388,"_26000":2379,"_18071":49559,"_5":17966,"_24599":49537,"_2447":49560},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2937":2389,"_26000":2379,"_18071":49562,"_5":17966,"_24599":49537,"_2447":49563},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2937":2390,"_26000":2379,"_18071":49565,"_5":17966,"_24599":49537,"_2447":49566},[],"A working directory with restricted access for the downloaded key.",{"_2937":2391,"_26000":2379,"_18071":49568,"_5":17966,"_24599":49540,"_2447":49569},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2937":2392,"_26000":2379,"_18071":49571,"_5":17966,"_24599":49540,"_2447":49572},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2937":2393,"_26000":2379,"_18071":49574,"_5":17966,"_24599":49540,"_2447":49575},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2937":2394,"_26000":2379,"_18071":49577,"_5":17966,"_24599":49540,"_2447":49578},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2937":2395,"_26000":2379,"_18071":49580,"_5":17966,"_24599":49544,"_2447":49581},[],"File or resource",{"_2937":2396,"_26000":2379,"_18071":49583,"_5":17966,"_24599":49544,"_2447":46937},[],{"_2937":2397,"_26000":2379,"_18071":49585,"_5":17966,"_24599":49544,"_2447":49586},[],"Active root CA and `ca.pem`",{"_2937":2398,"_26000":2379,"_18071":49588,"_5":17966,"_24599":49544,"_2447":49589},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2937":2399,"_26000":2379,"_18071":49591,"_5":17966,"_24599":49544,"_2447":49592},[],"End-entity certificate and `device.crt`",{"_2937":2400,"_26000":2379,"_18071":49594,"_5":17966,"_24599":49544,"_2447":49595},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2937":2401,"_26000":2379,"_18071":49597,"_5":17966,"_24599":49544,"_2447":49598},[],"Private key `device.key`",{"_2937":2402,"_26000":2379,"_18071":49600,"_5":17966,"_24599":49544,"_2447":49601},[],"Its public key matches the one included in `device.crt`.",{"_2937":2403,"_26000":2379,"_18071":49603,"_5":17966,"_24599":49544,"_2447":49604},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2937":2404,"_26000":2379,"_18071":49606,"_5":17966,"_24599":49547,"_2447":49607},[],"To operate certificates, continue with Certificates and Validation.",{"_2937":2405,"_26000":2379,"_18071":49609,"_5":17966,"_24599":49547,"_2447":49610},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2937":2406,"_26000":2379,"_18071":49612,"_5":17966,"_24599":49547,"_2447":49613},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2937":2407,"_26000":2407,"_5":12545,"_2447":49615,"_26339":49616,"_18071":49617,"_24599":2407},"PKI troubleshooting",[42089,43636,47313,42861],[],{"_2937":2408,"_26000":2407,"_18071":49619,"_5":17966,"_24599":2407,"_2447":49620},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2937":2409,"_26000":2407,"_5":26336,"_18071":49622,"_24599":49623,"_2447":49624},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2937":2410,"_26000":2407,"_5":26336,"_18071":49626,"_24599":49627,"_2447":49628},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2937":2411,"_26000":2407,"_5":26336,"_18071":49630,"_24599":49631,"_2447":49632},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2937":2412,"_26000":2407,"_18071":49634,"_5":17966,"_24599":2407,"_2447":49635},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2937":2413,"_26000":2407,"_18071":49637,"_5":17966,"_24599":2407,"_2447":49638},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2937":2414,"_26000":2407,"_18071":49640,"_5":17966,"_24599":49623,"_2447":46937},[],{"_2937":2415,"_26000":2407,"_18071":49642,"_5":17966,"_24599":49623,"_2447":49643},[],"What to inspect",{"_2937":2416,"_26000":2407,"_18071":49645,"_5":17966,"_24599":49623,"_2447":42123},[],{"_2937":2417,"_26000":2407,"_18071":49647,"_5":17966,"_24599":49623,"_2447":49648},[],"CA",{"_2937":2418,"_26000":2407,"_18071":49650,"_5":17966,"_24599":49623,"_2447":49651},[],"Exists, is active and has usable dates.",{"_2937":2419,"_26000":2407,"_18071":49653,"_5":17966,"_24599":49623,"_2447":49654},[],"Authorities.",{"_2937":2420,"_26000":2407,"_18071":49656,"_5":17966,"_24599":49623,"_2447":49657},[],"Key",{"_2937":2421,"_26000":2407,"_18071":49659,"_5":17966,"_24599":49623,"_2447":49660},[],"The record has a usable private key and the engine can sign.",{"_2937":2422,"_26000":2407,"_18071":49662,"_5":17966,"_24599":49623,"_2447":49663},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2937":2423,"_26000":2407,"_18071":49665,"_5":17966,"_24599":49623,"_2447":49666},[],"CSR",{"_2937":2424,"_26000":2407,"_18071":49668,"_5":17966,"_24599":49623,"_2447":49669},[],"Correct PEM and verifiable signature.",{"_2937":2425,"_26000":2407,"_18071":49671,"_5":17966,"_24599":49623,"_2447":49672},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2937":2426,"_26000":2407,"_18071":49674,"_5":17966,"_24599":49623,"_2447":49675},[],"Profile",{"_2937":2427,"_26000":2407,"_18071":49677,"_5":17966,"_24599":49623,"_2447":49678},[],"Selected source, existing ID, allowed algorithm and size.",{"_2937":2428,"_26000":2407,"_18071":49680,"_5":17966,"_24599":49623,"_2447":49681},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2937":2429,"_26000":2407,"_18071":49683,"_5":17966,"_24599":49623,"_2447":47090},[],{"_2937":2430,"_26000":2407,"_18071":49685,"_5":17966,"_24599":49623,"_2447":49686},[],"Appropriate subject, SAN, usages and dates.",{"_2937":2431,"_26000":2407,"_18071":49688,"_5":17966,"_24599":49623,"_2447":49689},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2937":2432,"_26000":2407,"_18071":49691,"_5":17966,"_24599":49623,"_2447":49692},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2937":2433,"_26000":2407,"_18071":49694,"_5":17966,"_24599":49623,"_2447":49695},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2937":2434,"_26000":2407,"_18071":49697,"_5":17966,"_24599":49627,"_2447":49698},[],"Check each boundary independently:",{"_2937":2435,"_26000":2407,"_18071":49700,"_5":17966,"_24599":49627,"_2447":49701},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2937":2436,"_26000":2407,"_18071":49703,"_5":17966,"_24599":49627,"_2447":49704},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2937":2437,"_26000":2407,"_18071":49706,"_5":17966,"_24599":49627,"_2447":49707},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2937":2438,"_26000":2407,"_18071":49709,"_5":17966,"_24599":49627,"_2447":49710},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2937":2439,"_26000":2407,"_18071":49712,"_5":17966,"_24599":49627,"_2447":49713},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2937":2440,"_26000":2407,"_18071":49715,"_5":17966,"_24599":49627,"_2447":49716},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2937":2441,"_26000":2407,"_18071":49718,"_5":17966,"_24599":49631,"_2447":49719},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2937":2442,"_26000":2407,"_18071":49721,"_5":17966,"_24599":49631,"_2447":49722},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_49726":49727,"_49728":49729,"_49730":49731,"_49732":49733,"_15733":2469,"_59459":2469},"language","english","sortableProperties",[2447,26000,5,24599],"sortablePropertiesWithTypes",{"_2447":21633,"_26000":21633,"_5":21633,"_24599":21633},"sorts",{"_2447":49734,"_26000":52166,"_5":54597,"_24599":57028},{"_3933":49735,"_49736":49737,"_5":21633},{"_12417":5471,"_12791":6852,"_12798":5736,"_25163":2760,"_24712":4376,"_17139":2600,"_12438":5902,"_12445":2783,"_25125":9593,"_25486":14483,"_25507":2816,"_25138":10881,"_29894":6395,"_25518":2499,"_29899":5527,"_29902":3366,"_29905":4512,"_29908":4765,"_29911":3750,"_25852":4918,"_29916":14843,"_29918":3514,"_25900":5881,"_25842":11948,"_29922":17364,"_25868":4898,"_29926":7378,"_25536":2795,"_25847":6531,"_25918":3000,"_29931":5066