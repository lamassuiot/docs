6702,"_22319":15},"Deploy from AWS Marketplace",[36699,36700,36701],"Docs","Deployment","Other models",[],{"_2384":16,"_23648":15,"_16085":36704,"_5":15974,"_22319":15,"_1957":36705},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2384":17,"_23648":15,"_5":23925,"_16085":36707,"_22319":36708,"_1957":36709},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2384":18,"_23648":15,"_5":23925,"_16085":36711,"_22319":36712,"_1957":36713},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2384":19,"_23648":15,"_5":23925,"_16085":36715,"_22319":36716,"_1957":36717},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2384":20,"_23648":15,"_5":23925,"_16085":36719,"_22319":36720,"_1957":36721},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2384":21,"_23648":15,"_5":23925,"_16085":36723,"_22319":36724,"_1957":36725},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2384":22,"_23648":15,"_5":23925,"_16085":36727,"_22319":36728,"_1957":36729},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2384":23,"_23648":15,"_5":23925,"_16085":36731,"_22319":36732,"_1957":36733},[],"/docs/pr-preview/pr-26/deployment/aws-marketplace#next-step","Next step",{"_2384":24,"_23648":15,"_16085":36735,"_5":15974,"_22319":15,"_1957":36736},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2384":25,"_23648":15,"_16085":36738,"_5":15974,"_22319":36708,"_1957":36739},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2384":26,"_23648":15,"_16085":36741,"_5":15974,"_22319":36708,"_1957":36742},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2384":27,"_23648":15,"_16085":36744,"_5":15974,"_22319":36708,"_1957":36745},[],"A security group allowing the necessary endpoints.",{"_2384":28,"_23648":15,"_16085":36747,"_5":15974,"_22319":36712,"_1957":36748},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2384":29,"_23648":15,"_16085":36750,"_5":15974,"_22319":36712,"_1957":36751},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2384":30,"_23648":15,"_16085":36753,"_5":15974,"_22319":36712,"_1957":36754},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2384":31,"_23648":15,"_16085":36756,"_5":15974,"_22319":36716,"_1957":36757},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2384":32,"_23648":15,"_16085":36759,"_5":15974,"_22319":36720,"_1957":36760},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2384":33,"_23648":15,"_16085":36762,"_5":15974,"_22319":36724,"_1957":36763},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2384":34,"_23648":15,"_16085":36765,"_5":15974,"_22319":36728,"_1957":36766},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2384":35,"_23648":15,"_16085":36768,"_5":15974,"_22319":36732,"_1957":36769},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2384":36,"_23648":36,"_5":10988,"_1957":36771,"_23928":36772,"_16085":36773,"_22319":36},"Deploy Lamassu",[36699,36700],[],{"_2384":37,"_23648":36,"_16085":36775,"_5":15974,"_22319":36,"_1957":36776},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2384":38,"_23648":36,"_5":23925,"_16085":36778,"_22319":36779,"_1957":36780},[],"/docs/pr-preview/pr-26/deployment/overview#choose-a-model","Choose a model",{"_2384":39,"_23648":36,"_5":23925,"_16085":36782,"_22319":36783,"_1957":36784},[],"/docs/pr-preview/pr-26/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2384":40,"_23648":36,"_5":23925,"_16085":36786,"_22319":36787,"_1957":36788},[],"/docs/pr-preview/pr-26/deployment/overview#after-deployment","After deployment",{"_2384":41,"_23648":36,"_16085":36790,"_5":15974,"_22319":36,"_1957":36791},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2384":42,"_23648":36,"_16085":36793,"_5":15974,"_22319":36779,"_1957":36794},[],"Model",{"_2384":43,"_23648":36,"_16085":36796,"_5":15974,"_22319":36779,"_1957":36797},[],"Recommended for",{"_2384":44,"_23648":36,"_16085":36799,"_5":15974,"_22319":36779,"_1957":36800},[],"Who operates the infrastructure",{"_2384":45,"_23648":36,"_16085":36802,"_5":15974,"_22319":36779,"_1957":36803},[],"Starting point",{"_2384":46,"_23648":36,"_16085":36805,"_5":15974,"_22319":36779,"_1957":36806},[],"Kubernetes self-managed",{"_2384":47,"_23648":36,"_16085":36808,"_5":15974,"_22319":36779,"_1957":36809},[],"Production, regulated environments and custom deployments",{"_2384":48,"_23648":36,"_16085":36811,"_5":15974,"_22319":36779,"_1957":36812},[],"Your team",{"_2384":49,"_23648":36,"_16085":36814,"_5":15974,"_22319":36779,"_1957":36815},[],"Helm or Fastlane",{"_2384":50,"_23648":36,"_16085":36817,"_5":15974,"_22319":36779,"_1957":36818},[],"AWS Marketplace",{"_2384":51,"_23648":36,"_16085":36820,"_5":15974,"_22319":36779,"_1957":36821},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2384":52,"_23648":36,"_16085":36823,"_5":15974,"_22319":36779,"_1957":36812},[],{"_2384":53,"_23648":36,"_16085":36825,"_5":15974,"_22319":36779,"_1957":36826},[],"Preconfigured image on EC2",{"_2384":54,"_23648":36,"_16085":36828,"_5":15974,"_22319":36779,"_1957":36829},[],"SaaS",{"_2384":55,"_23648":36,"_16085":36831,"_5":15974,"_22319":36779,"_1957":36832},[],"Teams that want to use the platform without operating it",{"_2384":56,"_23648":36,"_16085":36834,"_5":15974,"_22319":36779,"_1957":36835},[],"Lamassu",{"_2384":57,"_23648":36,"_16085":36837,"_5":15974,"_22319":36779,"_1957":36838},[],"Managed subscription",{"_2384":58,"_23648":36,"_16085":36840,"_5":15974,"_22319":36779,"_1957":36841},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2384":59,"_23648":36,"_16085":36843,"_5":15974,"_22319":36779,"_1957":36844},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2384":60,"_23648":36,"_16085":36846,"_5":15974,"_22319":36779,"_1957":36847},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2384":61,"_23648":36,"_16085":36849,"_5":15974,"_22319":36783,"_1957":36850},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2384":62,"_23648":36,"_16085":36852,"_5":15974,"_22319":36787,"_1957":36853},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2384":63,"_23648":63,"_5":10988,"_1957":36855,"_23928":36856,"_16085":36857,"_22319":63},"Use Lamassu as SaaS",[36699,36700,36701],[],{"_2384":64,"_23648":63,"_16085":36859,"_5":15974,"_22319":63,"_1957":36860},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2384":65,"_23648":63,"_5":23925,"_16085":36862,"_22319":36863,"_1957":36864},[],"/docs/pr-preview/pr-26/deployment/saas#what-the-service-manages","What the service manages",{"_2384":66,"_23648":63,"_5":23925,"_16085":36866,"_22319":36867,"_1957":36868},[],"/docs/pr-preview/pr-26/deployment/saas#plans","Plans",{"_2384":67,"_23648":63,"_5":23925,"_16085":36870,"_22319":36871,"_1957":36872},[],"/docs/pr-preview/pr-26/deployment/saas#request-access","Request access",{"_2384":68,"_23648":63,"_16085":36874,"_5":15974,"_22319":63,"_1957":36875},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2384":69,"_23648":63,"_16085":36877,"_5":15974,"_22319":36863,"_1957":36878},[],"Platform availability and maintenance.",{"_2384":70,"_23648":63,"_16085":36880,"_5":15974,"_22319":36863,"_1957":36881},[],"Automatic backups.",{"_2384":71,"_23648":63,"_16085":36883,"_5":15974,"_22319":36863,"_1957":36884},[],"Version upgrades.",{"_2384":72,"_23648":63,"_16085":36886,"_5":15974,"_22319":36863,"_1957":36887},[],"Technical support and SLA according to your plan.",{"_2384":73,"_23648":63,"_16085":36889,"_5":15974,"_22319":36867,"_1957":36890},[],"Plan",{"_2384":74,"_23648":63,"_16085":36892,"_5":15974,"_22319":36867,"_1957":36893},[],"Devices",{"_2384":75,"_23648":63,"_16085":36895,"_5":15974,"_22319":36867,"_1957":36896},[],"Support",{"_2384":76,"_23648":63,"_16085":36898,"_5":15974,"_22319":36867,"_1957":36899},[],"SLA",{"_2384":77,"_23648":63,"_16085":36901,"_5":15974,"_22319":36867,"_1957":36902},[],"Starter",{"_2384":78,"_23648":63,"_16085":36904,"_5":15974,"_22319":36867,"_1957":36905},[],"Up to 1,000",{"_2384":79,"_23648":63,"_16085":36907,"_5":15974,"_22319":36867,"_1957":36908},[],"Email",{"_2384":80,"_23648":63,"_16085":36910,"_5":15974,"_22319":36867,"_1957":36911},[],"99.5 %",{"_2384":81,"_23648":63,"_16085":36913,"_5":15974,"_22319":36867,"_1957":36914},[],"Professional",{"_2384":82,"_23648":63,"_16085":36916,"_5":15974,"_22319":36867,"_1957":36917},[],"Up to 10,000",{"_2384":83,"_23648":63,"_16085":36919,"_5":15974,"_22319":36867,"_1957":36920},[],"Email and chat",{"_2384":84,"_23648":63,"_16085":36922,"_5":15974,"_22319":36867,"_1957":36923},[],"99.9 %",{"_2384":85,"_23648":63,"_16085":36925,"_5":15974,"_22319":36867,"_1957":36926},[],"Enterprise",{"_2384":86,"_23648":63,"_16085":36928,"_5":15974,"_22319":36867,"_1957":36929},[],"Unlimited",{"_2384":87,"_23648":63,"_16085":36931,"_5":15974,"_22319":36867,"_1957":36932},[],"Dedicated",{"_2384":88,"_23648":63,"_16085":36934,"_5":15974,"_22319":36867,"_1957":36935},[],"99.99 %",{"_2384":89,"_23648":63,"_16085":36937,"_5":15974,"_22319":36871,"_1957":36938},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2384":90,"_23648":63,"_16085":36940,"_5":15974,"_22319":36871,"_1957":36941},[],"When you receive your instance's credentials, continue with Get started.",{"_2384":91,"_23648":91,"_5":10988,"_1957":36943,"_23928":36944,"_16085":36945,"_22319":91},"Fastlane",[36699,36700,36806],[],{"_2384":92,"_23648":91,"_16085":36947,"_5":15974,"_22319":91,"_1957":36948},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2384":93,"_23648":91,"_5":23925,"_16085":36950,"_22319":36951,"_1957":36952},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2384":94,"_23648":91,"_5":23925,"_16085":36954,"_22319":36955,"_1957":36956},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2384":95,"_23648":91,"_5":23925,"_16085":36958,"_22319":36959,"_1957":36709},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#before-you-begin",{"_2384":96,"_23648":91,"_5":23925,"_16085":36961,"_22319":36962,"_1957":36963},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2384":97,"_23648":91,"_5":23925,"_16085":36965,"_22319":36966,"_1957":36967},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2384":98,"_23648":91,"_5":23925,"_16085":36969,"_22319":36970,"_1957":36971},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2384":99,"_23648":91,"_5":23925,"_16085":36973,"_22319":36974,"_1957":36975},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2384":100,"_23648":91,"_5":23925,"_16085":36977,"_22319":36978,"_1957":36979},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2384":101,"_23648":91,"_5":23925,"_16085":36981,"_22319":36982,"_1957":36983},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2384":102,"_23648":91,"_5":23925,"_16085":36985,"_22319":36986,"_1957":36987},[],"/docs/pr-preview/pr-26/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2384":103,"_23648":91,"_16085":36989,"_5":15974,"_22319":36951,"_1957":36990},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2384":104,"_23648":91,"_16085":36992,"_5":15974,"_22319":36951,"_1957":36993},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2384":105,"_23648":91,"_16085":36995,"_5":15974,"_22319":36955,"_1957":36996},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2384":106,"_23648":91,"_16085":36998,"_5":15974,"_22319":36955,"_1957":36999},[],"Fastlane installs or configures",{"_2384":107,"_23648":91,"_16085":37001,"_5":15974,"_22319":36955,"_1957":37002},[],"You still provide",{"_2384":108,"_23648":91,"_16085":37004,"_5":15974,"_22319":36955,"_1957":37005},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2384":109,"_23648":91,"_16085":37007,"_5":15974,"_22319":36955,"_1957":37008},[],"The Kubernetes cluster, nodes and persistent storage",{"_2384":110,"_23648":91,"_16085":37010,"_5":15974,"_22319":36955,"_1957":37011},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2384":111,"_23648":91,"_16085":37013,"_5":15974,"_22319":36955,"_1957":37014},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2384":112,"_23648":91,"_16085":37016,"_5":15974,"_22319":36955,"_1957":37017},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2384":113,"_23648":91,"_16085":37019,"_5":15974,"_22319":36955,"_1957":37020},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2384":114,"_23648":91,"_16085":37022,"_5":15974,"_22319":36955,"_1957":37023},[],"Optional observability and lab HSM components",{"_2384":115,"_23648":91,"_16085":37025,"_5":15974,"_22319":36955,"_1957":37026},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2384":116,"_23648":91,"_16085":37028,"_5":15974,"_22319":36955,"_1957":37029},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2384":117,"_23648":91,"_16085":37031,"_5":15974,"_22319":36959,"_1957":37032},[],"You need:",{"_2384":118,"_23648":91,"_16085":37034,"_5":15974,"_22319":36959,"_1957":37035},[],"an existing Kubernetes cluster",{"_2384":119,"_23648":91,"_16085":37037,"_5":15974,"_22319":36959,"_1957":37038},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2384":120,"_23648":91,"_16085":37040,"_5":15974,"_22319":36959,"_1957":37041},[],"`yq`",{"_2384":121,"_23648":91,"_16085":37043,"_5":15974,"_22319":36959,"_1957":18289},[],{"_2384":122,"_23648":91,"_16085":37045,"_5":15974,"_22319":36959,"_1957":37046},[],"`jq` only when using `--sample-data`",{"_2384":123,"_23648":91,"_16085":37048,"_5":15974,"_22319":36959,"_1957":37049},[],"`ssh-keygen` only when using `--with-hsm`",{"_2384":124,"_23648":91,"_16085":37051,"_5":15974,"_22319":36959,"_1957":37052},[],"free external ports 80 and 443 on a single-node K3s host",{"_2384":125,"_23648":91,"_16085":37054,"_5":15974,"_22319":36959,"_1957":37055},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2384":126,"_23648":91,"_16085":37057,"_5":15974,"_22319":36959,"_1957":37058},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2384":127,"_23648":91,"_16085":37060,"_5":15974,"_22319":36962,"_1957":37061},[],"Run the script from a clone of the Helm repository:",{"_2384":128,"_23648":91,"_16085":37063,"_5":15974,"_22319":36962,"_1957":37064},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2384":129,"_23648":91,"_16085":37066,"_5":15974,"_22319":36966,"_1957":37067},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2384":130,"_23648":91,"_16085":37069,"_5":15974,"_22319":36966,"_1957":37070},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2384":131,"_23648":91,"_16085":37072,"_5":15974,"_22319":36966,"_1957":37073},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2384":132,"_23648":91,"_16085":37075,"_5":15974,"_22319":36966,"_1957":37076},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2384":133,"_23648":91,"_16085":37078,"_5":15974,"_22319":36970,"_1957":37079},[],"Option",{"_2384":134,"_23648":91,"_16085":37081,"_5":15974,"_22319":36970,"_1957":37082},[],"Default",{"_2384":135,"_23648":91,"_16085":37084,"_5":15974,"_22319":36970,"_1957":37085},[],"Purpose",{"_2384":136,"_23648":91,"_16085":37087,"_5":15974,"_22319":36970,"_1957":37088},[],"`-h`, `--help`",{"_2384":137,"_23648":91,"_16085":37090,"_5":15974,"_22319":36970,"_1957":37091},[],"—",{"_2384":138,"_23648":91,"_16085":37093,"_5":15974,"_22319":36970,"_1957":37094},[],"Show help",{"_2384":139,"_23648":91,"_16085":37096,"_5":15974,"_22319":36970,"_1957":37097},[],"`-c`, `--context`",{"_2384":140,"_23648":91,"_16085":37099,"_5":15974,"_22319":36970,"_1957":37100},[],"current context",{"_2384":141,"_23648":91,"_16085":37102,"_5":15974,"_22319":36970,"_1957":37103},[],"Select the kubeconfig context for kubectl and Helm",{"_2384":142,"_23648":91,"_16085":37105,"_5":15974,"_22319":36970,"_1957":37106},[],"`-n`, `--non-interactive`",{"_2384":143,"_23648":91,"_16085":37108,"_5":15974,"_22319":36970,"_1957":4581},[],{"_2384":144,"_23648":91,"_16085":37110,"_5":15974,"_22319":36970,"_1957":37111},[],"Skip prompts and generate dependency credentials",{"_2384":145,"_23648":91,"_16085":37113,"_5":15974,"_22319":36970,"_1957":37114},[],"`-ns`, `--namespace`",{"_2384":146,"_23648":91,"_16085":37116,"_5":15974,"_22319":36970,"_1957":37117},[],"`lamassu-dev`",{"_2384":147,"_23648":91,"_16085":37119,"_5":15974,"_22319":36970,"_1957":37120},[],"Namespace for the installation",{"_2384":148,"_23648":91,"_16085":37122,"_5":15974,"_22319":36970,"_1957":37123},[],"`-d`, `--domain`",{"_2384":149,"_23648":91,"_16085":37125,"_5":15974,"_22319":36970,"_1957":37126},[],"`dev.lamassu.io`",{"_2384":150,"_23648":91,"_16085":37128,"_5":15974,"_22319":36970,"_1957":37129},[],"Domain used by the UI, OIDC and certificate",{"_2384":151,"_23648":91,"_16085":37131,"_5":15974,"_22319":36970,"_1957":37132},[],"`-v`, `--version`",{"_2384":152,"_23648":91,"_16085":37134,"_5":15974,"_22319":36970,"_1957":11329},[],{"_2384":153,"_23648":91,"_16085":37136,"_5":15974,"_22319":36970,"_1957":37137},[],"Lamassu chart version",{"_2384":154,"_23648":91,"_16085":37139,"_5":15974,"_22319":36970,"_1957":37140},[],"`--https-port`",{"_2384":155,"_23648":91,"_16085":37142,"_5":15974,"_22319":36970,"_1957":37143},[],"`443`",{"_2384":156,"_23648":91,"_16085":37145,"_5":15974,"_22319":36970,"_1957":37146},[],"Gateway HTTPS listener port",{"_2384":157,"_23648":91,"_16085":37148,"_5":15974,"_22319":36970,"_1957":37149},[],"`--http-port`",{"_2384":158,"_23648":91,"_16085":37151,"_5":15974,"_22319":36970,"_1957":37152},[],"`80`",{"_2384":159,"_23648":91,"_16085":37154,"_5":15974,"_22319":36970,"_1957":37155},[],"Gateway HTTP listener port",{"_2384":160,"_23648":91,"_16085":37157,"_5":15974,"_22319":36970,"_1957":37158},[],"`--tls-crt`",{"_2384":161,"_23648":91,"_16085":37160,"_5":15974,"_22319":36970,"_1957":37091},[],{"_2384":162,"_23648":91,"_16085":37162,"_5":15974,"_22319":36970,"_1957":37163},[],"PEM certificate for downstream TLS",{"_2384":163,"_23648":91,"_16085":37165,"_5":15974,"_22319":36970,"_1957":37166},[],"`--tls-key`",{"_2384":164,"_23648":91,"_16085":37168,"_5":15974,"_22319":36970,"_1957":37091},[],{"_2384":165,"_23648":91,"_16085":37170,"_5":15974,"_22319":36970,"_1957":37171},[],"PEM private key for downstream TLS",{"_2384":166,"_23648":91,"_16085":37173,"_5":15974,"_22319":36970,"_1957":37174},[],"`-l`, `--local-chart-path`",{"_2384":167,"_23648":91,"_16085":37176,"_5":15974,"_22319":36970,"_1957":37177},[],"repository chart",{"_2384":168,"_23648":91,"_16085":37179,"_5":15974,"_22319":36970,"_1957":37180},[],"Use an unpacked local Lamassu chart",{"_2384":169,"_23648":91,"_16085":37182,"_5":15974,"_22319":36970,"_1957":37183},[],"`-ip`, `--gateway-ip`",{"_2384":170,"_23648":91,"_16085":37185,"_5":15974,"_22319":36970,"_1957":6432},[],{"_2384":171,"_23648":91,"_16085":37187,"_5":15974,"_22319":36970,"_1957":37188},[],"Override the address written to `gateway.addresses`",{"_2384":172,"_23648":91,"_16085":37190,"_5":15974,"_22319":36970,"_1957":37191},[],"`--otel`",{"_2384":173,"_23648":91,"_16085":37193,"_5":15974,"_22319":36970,"_1957":4581},[],{"_2384":174,"_23648":91,"_16085":37195,"_5":15974,"_22319":36970,"_1957":37196},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2384":175,"_23648":91,"_16085":37198,"_5":15974,"_22319":36970,"_1957":37199},[],"`--sample-data`",{"_2384":176,"_23648":91,"_16085":37201,"_5":15974,"_22319":36970,"_1957":4581},[],{"_2384":177,"_23648":91,"_16085":37203,"_5":15974,"_22319":36970,"_1957":37204},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2384":178,"_23648":91,"_16085":37206,"_5":15974,"_22319":36970,"_1957":37207},[],"`--with-hsm`",{"_2384":179,"_23648":91,"_16085":37209,"_5":15974,"_22319":36970,"_1957":4581},[],{"_2384":180,"_23648":91,"_16085":37211,"_5":15974,"_22319":36970,"_1957":37212},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2384":181,"_23648":91,"_16085":37214,"_5":15974,"_22319":36970,"_1957":37215},[],"`--softhsm-chart-path`",{"_2384":182,"_23648":91,"_16085":37217,"_5":15974,"_22319":36970,"_1957":37218},[],"`./charts/softhsm`",{"_2384":183,"_23648":91,"_16085":37220,"_5":15974,"_22319":36970,"_1957":37221},[],"Use a different local SoftHSM chart",{"_2384":184,"_23648":91,"_16085":37223,"_5":15974,"_22319":36970,"_1957":37224},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2384":185,"_23648":91,"_16085":37226,"_5":15974,"_22319":36974,"_1957":37227},[],"Fastlane:",{"_2384":186,"_23648":91,"_16085":37229,"_5":15974,"_22319":36974,"_1957":37230},[],"validates local tools and the selected cluster",{"_2384":187,"_23648":91,"_16085":37232,"_5":15974,"_22319":36974,"_1957":37233},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2384":188,"_23648":91,"_16085":37235,"_5":15974,"_22319":36974,"_1957":37236},[],"creates the namespace",{"_2384":189,"_23648":91,"_16085":37238,"_5":15974,"_22319":36974,"_1957":37239},[],"installs PostgreSQL and creates the required databases",{"_2384":190,"_23648":91,"_16085":37241,"_5":15974,"_22319":36974,"_1957":37242},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2384":191,"_23648":91,"_16085":37244,"_5":15974,"_22319":36974,"_1957":37245},[],"installs RabbitMQ",{"_2384":192,"_23648":91,"_16085":37247,"_5":15974,"_22319":36974,"_1957":37248},[],"optionally installs observability and lab HSM components",{"_2384":193,"_23648":91,"_16085":37250,"_5":15974,"_22319":36974,"_1957":37251},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2384":194,"_23648":91,"_16085":37253,"_5":15974,"_22319":36974,"_1957":37254},[],"optionally loads sample data",{"_2384":195,"_23648":91,"_16085":37256,"_5":15974,"_22319":36974,"_1957":37257},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2384":196,"_23648":91,"_16085":37259,"_5":15974,"_22319":36978,"_1957":37260},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2384":197,"_23648":91,"_16085":37262,"_5":15974,"_22319":36978,"_1957":37263},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2384":198,"_23648":91,"_16085":37265,"_5":15974,"_22319":36982,"_1957":37266},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2384":199,"_23648":91,"_16085":37268,"_5":15974,"_22319":36982,"_1957":37269},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2384":200,"_23648":91,"_16085":37271,"_5":15974,"_22319":36982,"_1957":37272},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2384":201,"_23648":91,"_16085":37274,"_5":15974,"_22319":36986,"_1957":37275},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2384":202,"_23648":202,"_5":10988,"_1957":37277,"_23928":37278,"_16085":37279,"_22319":202},"Install with Helm",[36699,36700,36806],[],{"_2384":203,"_23648":202,"_16085":37281,"_5":15974,"_22319":202,"_1957":37282},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2384":204,"_23648":202,"_5":23925,"_16085":37284,"_22319":37285,"_1957":37286},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2384":205,"_23648":202,"_5":23925,"_16085":37288,"_22319":37289,"_1957":36709},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#before-you-begin",{"_2384":206,"_23648":202,"_5":23925,"_16085":37291,"_22319":37292,"_1957":37293},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2384":207,"_23648":202,"_5":23925,"_16085":37295,"_22319":37296,"_1957":37297},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2384":208,"_23648":202,"_5":23925,"_16085":37299,"_22319":37300,"_1957":37301},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2384":209,"_23648":202,"_5":23925,"_16085":37303,"_22319":37304,"_1957":37305},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2384":210,"_23648":202,"_5":23925,"_16085":37307,"_22319":37308,"_1957":37309},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2384":211,"_23648":202,"_5":23925,"_16085":37311,"_22319":37312,"_1957":37313},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2384":212,"_23648":202,"_5":23925,"_16085":37315,"_22319":37316,"_1957":37317},[],"/docs/pr-preview/pr-26/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2384":213,"_23648":202,"_16085":37319,"_5":15974,"_22319":37285,"_1957":37320},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2384":214,"_23648":202,"_16085":37322,"_5":15974,"_22319":37289,"_1957":37323},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2384":215,"_23648":202,"_16085":37325,"_5":15974,"_22319":37289,"_1957":37326},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2384":216,"_23648":202,"_16085":37328,"_5":15974,"_22319":37289,"_1957":37329},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2384":217,"_23648":202,"_16085":37331,"_5":15974,"_22319":37289,"_1957":37332},[],"a reachable RabbitMQ broker and credentials",{"_2384":218,"_23648":202,"_16085":37334,"_5":15974,"_22319":37289,"_1957":37335},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2384":219,"_23648":202,"_16085":37337,"_5":15974,"_22319":37289,"_1957":37338},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2384":220,"_23648":202,"_16085":37340,"_5":15974,"_22319":37289,"_1957":37341},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2384":221,"_23648":202,"_16085":37343,"_5":15974,"_22319":37289,"_1957":37344},[],"a StorageClass and an external traffic design",{"_2384":222,"_23648":202,"_16085":37346,"_5":15974,"_22319":37289,"_1957":37347},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2384":223,"_23648":202,"_16085":37349,"_5":15974,"_22319":37289,"_1957":37350},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2384":224,"_23648":202,"_16085":37352,"_5":15974,"_22319":37289,"_1957":37353},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2384":225,"_23648":202,"_16085":37355,"_5":15974,"_22319":37292,"_1957":37356},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2384":226,"_23648":202,"_16085":37358,"_5":15974,"_22319":37292,"_1957":37359},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2384":227,"_23648":202,"_16085":37361,"_5":15974,"_22319":37292,"_1957":37362},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2384":228,"_23648":202,"_16085":37364,"_5":15974,"_22319":37296,"_1957":37365},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2384":229,"_23648":202,"_16085":37367,"_5":15974,"_22319":37296,"_1957":37368},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2384":230,"_23648":202,"_16085":37370,"_5":15974,"_22319":37296,"_1957":37371},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2384":231,"_23648":202,"_16085":37373,"_5":15974,"_22319":37300,"_1957":37374},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2384":232,"_23648":202,"_16085":37376,"_5":15974,"_22319":37304,"_1957":37377},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2384":233,"_23648":202,"_16085":37379,"_5":15974,"_22319":37304,"_1957":37380},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2384":234,"_23648":202,"_16085":37382,"_5":15974,"_22319":37304,"_1957":37383},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2384":235,"_23648":202,"_16085":37385,"_5":15974,"_22319":37304,"_1957":37386},[],"See Access control for the principal and policy model.",{"_2384":236,"_23648":202,"_16085":37388,"_5":15974,"_22319":37308,"_1957":37389},[],"To install a local checkout instead:",{"_2384":237,"_23648":202,"_16085":37391,"_5":15974,"_22319":37312,"_1957":37392},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2384":238,"_23648":202,"_16085":37394,"_5":15974,"_22319":37312,"_1957":37395},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2384":239,"_23648":202,"_16085":37397,"_5":15974,"_22319":37316,"_1957":37398},[],"Before going live, review:",{"_2384":240,"_23648":202,"_16085":37400,"_5":15974,"_22319":37316,"_1957":37401},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2384":241,"_23648":202,"_16085":37403,"_5":15974,"_22319":37316,"_1957":37404},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2384":242,"_23648":202,"_16085":37406,"_5":15974,"_22319":37316,"_1957":37407},[],"shared VA storage before increasing VA replicas",{"_2384":243,"_23648":202,"_16085":37409,"_5":15974,"_22319":37316,"_1957":37410},[],"managed OIDC roles and removal of evaluation credentials",{"_2384":244,"_23648":202,"_16085":37412,"_5":15974,"_22319":37316,"_1957":37413},[],"a trusted TLS issuer or externally managed certificate",{"_2384":245,"_23648":202,"_16085":37415,"_5":15974,"_22319":37316,"_1957":37416},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2384":246,"_23648":202,"_16085":37418,"_5":15974,"_22319":37316,"_1957":37419},[],"SMTP, observability and alert delivery",{"_2384":247,"_23648":202,"_16085":37421,"_5":15974,"_22319":37316,"_1957":37422},[],"follow Upgrade the Helm chart and the version notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2384":248,"_23648":202,"_16085":37424,"_5":15974,"_22319":37316,"_1957":37425},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2384":249,"_23648":249,"_5":10988,"_1957":37427,"_23928":37428,"_16085":37429,"_22319":249},"Upgrade the Helm chart",[36699,36700,36806],[],{"_2384":250,"_23648":249,"_16085":37431,"_5":15974,"_22319":249,"_1957":37432},[],"Upgrade a Helm-managed Lamassu deployment, including the 3.8.0 to 4.0.0 chart migration and the KMS and VA persistent-data steps.",{"_2384":251,"_23648":249,"_5":23925,"_16085":37434,"_22319":37435,"_1957":37427},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#upgrade-the-helm-chart",{"_2384":252,"_23648":249,"_5":23925,"_16085":37437,"_22319":37438,"_1957":37439},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#what-changes-in-400","What changes in 4.0.0",{"_2384":253,"_23648":249,"_5":23925,"_16085":37441,"_22319":37442,"_1957":37443},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#what-the-upgrade-job-does-automatically","What the upgrade job does automatically",{"_2384":254,"_23648":249,"_5":23925,"_16085":37445,"_22319":37446,"_1957":37447},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#before-you-upgrade","Before you upgrade",{"_2384":255,"_23648":249,"_5":23925,"_16085":37449,"_22319":37450,"_1957":37451},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#update-your-values-file","Update your values file",{"_2384":256,"_23648":249,"_5":23925,"_16085":37453,"_22319":37454,"_1957":37455},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#run-the-upgrade","Run the upgrade",{"_2384":257,"_23648":249,"_5":23925,"_16085":37457,"_22319":37458,"_1957":37459},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#migrate-the-kms-and-va-data","Migrate the KMS and VA data",{"_2384":258,"_23648":249,"_5":23925,"_16085":37461,"_22319":37462,"_1957":37463},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#verify-the-migration","Verify the migration",{"_2384":259,"_23648":249,"_5":23925,"_16085":37465,"_22319":37466,"_1957":37467},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#delete-the-old-volumes","Delete the old volumes",{"_2384":260,"_23648":249,"_5":23925,"_16085":37469,"_22319":37470,"_1957":37471},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#troubleshooting","Troubleshooting",{"_2384":261,"_23648":249,"_5":23925,"_16085":37473,"_22319":37474,"_1957":37475},[],"/docs/pr-preview/pr-26/deployment/self-hosted/migration#related-pages","Related pages",{"_2384":262,"_23648":249,"_16085":37477,"_5":15974,"_22319":37435,"_1957":37478},[],"Use this guide to upgrade a Helm-managed deployment. It walks through the 3.8.0 to 4.0.0 chart migration in full: the values to review, the database changes the chart applies automatically and the manual steps for installations that keep KMS keys or VA CRLs on local volumes. Version-specific notes for other upgrades live in the `charts/lamassu/CHANGELOG/` directory of the `lamassu-helm` repository.",{"_2384":263,"_23648":249,"_16085":37480,"_5":15974,"_22319":37435,"_1957":37481},[],"If you are not upgrading an existing release, go straight to Install with Helm. The manual data steps on this page only apply to deployments upgraded from 3.8.x that use local KMS or VA storage.",{"_2384":264,"_23648":249,"_16085":37483,"_5":15974,"_22319":37438,"_1957":37484},[],"Version 4.0.0 is a security-hardening release. Three changes affect upgrades:",{"_2384":265,"_23648":249,"_16085":37486,"_5":15974,"_22319":37438,"_1957":37487},[],"**Release-scoped resource names.** Every chart-managed resource is now named `<release>-lamassu-<component>`, for example `lamassu-kms`, instead of the fixed, unscoped names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`, not `prod-kms`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_2384":266,"_23648":249,"_16085":37489,"_5":15974,"_22319":37438,"_1957":37490},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_2384":267,"_23648":249,"_16085":37492,"_5":15974,"_22319":37438,"_1957":37493},[],"**Strict values validation.** `values.schema.json` rejects unknown top-level keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` outright instead of being silently ignored.",{"_2384":268,"_23648":249,"_16085":37495,"_5":15974,"_22319":37438,"_1957":37496},[],"`services.connectors` also becomes a map keyed by connector ID, and the chart no longer injects pod anti-affinity or topology spread rules.",{"_2384":269,"_23648":249,"_16085":37498,"_5":15974,"_22319":37438,"_1957":37499},[],"Kubernetes derives the PVC name from the StatefulSet pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. Your KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail to find them with `no such file or directory` (KMS) or `code=NotFound` (VA) until you move the data across yourself. All other renamed resources are stateless and are recreated without data-loss risk.",{"_2384":270,"_23648":249,"_16085":37501,"_5":15974,"_22319":37442,"_1957":37502},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL:",{"_2384":271,"_23648":249,"_16085":37504,"_5":15974,"_22319":37442,"_1957":37505},[],"Creates the `pki`, `authz` and `wfx` databases when they do not exist.",{"_2384":272,"_23648":249,"_16085":37507,"_5":15974,"_22319":37442,"_1957":37508},[],"Ensures one schema per service database (`alerts`, `ca`, `va`, `devicemanager`, `dmsmanager`, `kms`) inside the shared `pki` database, and folds 3.8.0's separate per-service databases into it, importing their data.",{"_2384":273,"_23648":249,"_16085":37510,"_5":15974,"_22319":37442,"_1957":37511},[],"Runs the database migrations for every schema.",{"_2384":274,"_23648":249,"_16085":37513,"_5":15974,"_22319":37442,"_1957":37514},[],"Migrates authz, preloads its policies and seeds the `services.authz.bootstrap` principals.",{"_2384":275,"_23648":249,"_16085":37516,"_5":15974,"_22319":37442,"_1957":37517},[],"The job is idempotent, so a failed upgrade can be retried. It requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_2384":276,"_23648":249,"_16085":37519,"_5":15974,"_22319":37446,"_1957":37520},[],"Record the names of your existing local-storage PVCs:",{"_2384":277,"_23648":249,"_16085":37522,"_5":15974,"_22319":37446,"_1957":37523},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy data and to clean up later; do not delete them until the new volumes are verified.",{"_2384":278,"_23648":249,"_16085":37525,"_5":15974,"_22319":37446,"_1957":37526},[],"Remove values the strict schema now rejects, for example the old `toolbox:` block. Update your values file lists every rename.",{"_2384":279,"_23648":249,"_16085":37528,"_5":15974,"_22319":37450,"_1957":37529},[],"**Add `services.authz` (required).** 3.8.0 had no authorization service: every route accepted any valid token. 4.0.0 adds fine-grained, entity-level authorization, and a 3.8.0 values file has nothing to migrate *from* — you must add the configuration:",{"_2384":280,"_23648":249,"_16085":37531,"_5":15974,"_22319":37450,"_1957":37532},[],"`authz` is the authorization service's own storage for principals, grants and policies (`services.authz.database`, `authz` by default).",{"_2384":281,"_23648":249,"_16085":37534,"_5":15974,"_22319":37450,"_1957":37535},[],"`pki` is the database the authorization engine queries when it evaluates policies against entities such as CAs, certificates, devices, DMSs, KMS keys and VA roles.",{"_2384":282,"_23648":249,"_16085":37537,"_5":15974,"_22319":37450,"_1957":37538},[],"Only the `database` field of each credentials entry is read. Connection settings always come from the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_2384":283,"_23648":249,"_16085":37540,"_5":15974,"_22319":37450,"_1957":37541},[],"Confirm `services.authz.bootstrap` (present by default in the chart) matches how your OIDC provider assigns the `pki-admin` realm role. Without a principal that matches the bootstrap rule, nobody can administer the PKI — there is no implicit superuser.",{"_2384":284,"_23648":249,"_16085":37543,"_5":15974,"_22319":37450,"_1957":37544},[],"**Rename `toolbox` to `connectivityTest`.** The `helm test` connectivity hook now uses the upstream-maintained `curlimages/curl` image pinned by digest instead of the chart-owned toolbox image:",{"_2384":285,"_23648":249,"_16085":37546,"_5":15974,"_22319":37450,"_1957":37547},[],"**Remove per-service identity overrides.** `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` no longer exist. Every service runs under the chart-wide `65532:65532`, and KMS volume and PKCS#11 socket group access is handled automatically by the pod-level `fsGroup: 65532`.",{"_2384":286,"_23648":249,"_16085":37549,"_5":15974,"_22319":37450,"_1957":37550},[],"**Convert `services.connectors` to a map.** Each entry is keyed by its stable connector ID and declares `type` and `image`:",{"_2384":287,"_23648":249,"_16085":37552,"_5":15974,"_22319":37450,"_1957":37553},[],"**Check the TLS issuer values.** With `tls.certManagerOptions.issuer` empty (the default), the chart creates a self-signed, release-scoped issuer — for example `lamassu-downstream-ca-selfsigned-issuer` with release `lamassu`. The legacy literal `downstream-ca-selfsigned-issuer` from 3.8.0-era values is still accepted and resolves to the same release-scoped issuer; point `tls.certManagerOptions.clusterIssuer` at your own issuer for corporate TLS.",{"_2384":288,"_23648":249,"_16085":37555,"_5":15974,"_22319":37450,"_1957":37556},[],"**Review scheduling and ports.** The chart no longer injects pod anti-affinity or topology spread constraints — configure `affinity` and `topologySpreadConstraints` explicitly where your cluster needs them. The `services.ui.port` default is now `8085`, the unprivileged chart-wide port of the rootless image, so update overrides that pinned `80`. The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_2384":289,"_23648":249,"_16085":37558,"_5":15974,"_22319":37454,"_1957":37559},[],"Helm runs the database job before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_2384":290,"_23648":249,"_16085":37561,"_5":15974,"_22319":37458,"_1957":37562},[],"Skip this section on fresh installs, or when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_2384":291,"_23648":249,"_16085":37564,"_5":15974,"_22319":37458,"_1957":37565},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride`/`fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_2384":292,"_23648":249,"_16085":37567,"_5":15974,"_22319":37458,"_1957":37568},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing.",{"_2384":293,"_23648":249,"_16085":37570,"_5":15974,"_22319":37458,"_1957":37571},[],"**Scale the new StatefulSets down** so nothing writes to either volume while you copy:",{"_2384":294,"_23648":249,"_16085":37573,"_5":15974,"_22319":37458,"_1957":37574},[],"**Run a short-lived helper pod** that mounts all four claims:",{"_2384":295,"_23648":249,"_16085":37576,"_5":15974,"_22319":37458,"_1957":37577},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_2384":296,"_23648":249,"_16085":37579,"_5":15974,"_22319":37458,"_1957":37580},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing.",{"_2384":297,"_23648":249,"_16085":37582,"_5":15974,"_22319":37458,"_1957":37583},[],"**Copy the data and align ownership**:",{"_2384":298,"_23648":249,"_16085":37585,"_5":15974,"_22319":37458,"_1957":37586},[],"The `chown` is required even if the old files already look non-root-owned. 3.8.0 did not pin a container identity, so files could carry any image-declared UID; 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_2384":299,"_23648":249,"_16085":37588,"_5":15974,"_22319":37458,"_1957":37589},[],"**Scale back up and remove the helper**:",{"_2384":300,"_23648":249,"_16085":37591,"_5":15974,"_22319":37462,"_1957":37592},[],"KMS and VA logs show no `no such file or directory` or `code=NotFound` errors.",{"_2384":301,"_23648":249,"_16085":37594,"_5":15974,"_22319":37462,"_1957":37595},[],"A previously issued CRL is servable again: `GET /crl/<ca-ski>` on VA.",{"_2384":302,"_23648":249,"_16085":37597,"_5":15974,"_22319":37462,"_1957":37598},[],"`helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the connectivity hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_2384":303,"_23648":249,"_16085":37600,"_5":15974,"_22319":37462,"_1957":37601},[],"Sign in with an administrator identity and confirm operations are authorized.",{"_2384":304,"_23648":249,"_16085":37603,"_5":15974,"_22319":37466,"_1957":37604},[],"Only once everything works, delete the orphaned 3.8.0 volumes to reclaim storage:",{"_2384":305,"_23648":249,"_16085":37606,"_5":15974,"_22319":37470,"_1957":37607},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The new pods are bound to the new empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow Migrate the KMS and VA data and check that all four claims exist.",{"_2384":306,"_23648":249,"_16085":37609,"_5":15974,"_22319":37470,"_1957":37610},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically the `toolbox:` block — because the strict schema rejects top-level keys it does not know.",{"_2384":307,"_23648":249,"_16085":37612,"_5":15974,"_22319":37470,"_1957":37613},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas; grant the required privileges, or create the `pki`, `authz` and `wfx` databases yourself, then re-run the upgrade.",{"_2384":308,"_23648":249,"_16085":37615,"_5":15974,"_22319":37470,"_1957":37616},[],"**Nobody can log in after the upgrade.** Check that `services.authz.bootstrap` matches a role your OIDC provider actually assigns (see Access control) and that the migration Job completed successfully.",{"_2384":309,"_23648":249,"_16085":37618,"_5":15974,"_22319":37474,"_1957":37619},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2384":310,"_23648":249,"_16085":37621,"_5":15974,"_22319":37474,"_1957":37622},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design and handle Gateway addressing.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2384":311,"_23648":311,"_5":10988,"_1957":37624,"_23928":37625,"_16085":37626,"_22319":311},"Expose the Gateway",[36699,36700,36806],[],{"_2384":312,"_23648":311,"_16085":37628,"_5":15974,"_22319":311,"_1957":37629},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2384":313,"_23648":311,"_5":23925,"_16085":37631,"_22319":37632,"_1957":37633},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2384":314,"_23648":311,"_5":23925,"_16085":37635,"_22319":37636,"_1957":37637},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2384":315,"_23648":311,"_5":23925,"_16085":37639,"_22319":37640,"_1957":37641},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2384":316,"_23648":311,"_5":23925,"_16085":37643,"_22319":37644,"_1957":37645},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#k3s","K3s",{"_2384":317,"_23648":311,"_5":23925,"_16085":37647,"_22319":37648,"_1957":37649},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2384":318,"_23648":311,"_5":23925,"_16085":37651,"_22319":37652,"_1957":37653},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2384":319,"_23648":311,"_5":23925,"_16085":37655,"_22319":37656,"_1957":37657},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2384":320,"_23648":311,"_5":23925,"_16085":37659,"_22319":37660,"_1957":37661},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2384":321,"_23648":311,"_5":23925,"_16085":37663,"_22319":37664,"_1957":37665},[],"/docs/pr-preview/pr-26/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2384":322,"_23648":311,"_16085":37667,"_5":15974,"_22319":37632,"_1957":37668},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2384":323,"_23648":311,"_16085":37670,"_5":15974,"_22319":37632,"_1957":37671},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2384":324,"_23648":311,"_16085":37673,"_5":15974,"_22319":37636,"_1957":37674},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2384":325,"_23648":311,"_16085":37676,"_5":15974,"_22319":37636,"_1957":37677},[],"Set it only when:",{"_2384":326,"_23648":311,"_16085":37679,"_5":15974,"_22319":37636,"_1957":37680},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2384":327,"_23648":311,"_16085":37682,"_5":15974,"_22319":37636,"_1957":37683},[],"that address is allocated to this Gateway",{"_2384":328,"_23648":311,"_16085":37685,"_5":15974,"_22319":37636,"_1957":37686},[],"the surrounding network already routes traffic for it to the cluster",{"_2384":329,"_23648":311,"_16085":37688,"_5":15974,"_22319":37636,"_1957":37689},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2384":330,"_23648":311,"_16085":37691,"_5":15974,"_22319":37636,"_1957":37692},[],"Keep these two settings separate:",{"_2384":331,"_23648":311,"_16085":37694,"_5":15974,"_22319":37636,"_1957":37695},[],"`gateway.addresses` requests an address for the Gateway.",{"_2384":332,"_23648":311,"_16085":37697,"_5":15974,"_22319":37636,"_1957":37698},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2384":333,"_23648":311,"_16085":37700,"_5":15974,"_22319":37636,"_1957":37701},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2384":334,"_23648":311,"_16085":37703,"_5":15974,"_22319":37640,"_1957":37704},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2384":335,"_23648":311,"_16085":37706,"_5":15974,"_22319":37640,"_1957":37707},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2384":336,"_23648":311,"_16085":37709,"_5":15974,"_22319":37644,"_1957":37710},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2384":337,"_23648":311,"_16085":37712,"_5":15974,"_22319":37644,"_1957":37713},[],"For the recommended design:",{"_2384":338,"_23648":311,"_16085":37715,"_5":15974,"_22319":37644,"_1957":37716},[],"Use only one externally exposed Lamassu Gateway.",{"_2384":339,"_23648":311,"_16085":37718,"_5":15974,"_22319":37644,"_1957":37719},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2384":340,"_23648":311,"_16085":37721,"_5":15974,"_22319":37644,"_1957":37722},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2384":341,"_23648":311,"_16085":37724,"_5":15974,"_22319":37644,"_1957":37725},[],"Point DNS at the VM's reachable address.",{"_2384":342,"_23648":311,"_16085":37727,"_5":15974,"_22319":37644,"_1957":37728},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2384":343,"_23648":311,"_16085":37730,"_5":15974,"_22319":37648,"_1957":37731},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2384":344,"_23648":311,"_16085":37733,"_5":15974,"_22319":37652,"_1957":37734},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2384":345,"_23648":311,"_16085":37736,"_5":15974,"_22319":37652,"_1957":37737},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2384":346,"_23648":311,"_16085":37739,"_5":15974,"_22319":37656,"_1957":37740},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2384":347,"_23648":311,"_16085":37742,"_5":15974,"_22319":37656,"_1957":37743},[],"Requirement",{"_2384":348,"_23648":311,"_16085":37745,"_5":15974,"_22319":37656,"_1957":37746},[],"Recommended design",{"_2384":349,"_23648":311,"_16085":37748,"_5":15974,"_22319":37656,"_1957":37749},[],"Consequence",{"_2384":350,"_23648":311,"_16085":37751,"_5":15974,"_22319":37656,"_1957":37752},[],"Several Lamassu URLs or services",{"_2384":351,"_23648":311,"_16085":37754,"_5":15974,"_22319":37656,"_1957":37755},[],"One Gateway with multiple routes",{"_2384":352,"_23648":311,"_16085":37757,"_5":15974,"_22319":37656,"_1957":37758},[],"One IP and one proxy fleet; this is the chart default",{"_2384":353,"_23648":311,"_16085":37760,"_5":15974,"_22319":37656,"_1957":37761},[],"Independent Gateways and separate external IPs",{"_2384":354,"_23648":311,"_16085":37763,"_5":15974,"_22319":37656,"_1957":37764},[],"One VIP per Gateway",{"_2384":355,"_23648":311,"_16085":37766,"_5":15974,"_22319":37656,"_1957":37767},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2384":356,"_23648":311,"_16085":37769,"_5":15974,"_22319":37656,"_1957":37770},[],"Independent Gateways on one node and one IP",{"_2384":357,"_23648":311,"_16085":37772,"_5":15974,"_22319":37656,"_1957":37773},[],"Use different external ports",{"_2384":358,"_23648":311,"_16085":37775,"_5":15974,"_22319":37656,"_1957":37776},[],"Clients must include non-standard ports",{"_2384":359,"_23648":311,"_16085":37778,"_5":15974,"_22319":37656,"_1957":37779},[],"Separate TLS/mTLS termination behind one IP",{"_2384":360,"_23648":311,"_16085":37781,"_5":15974,"_22319":37656,"_1957":37782},[],"Front-door SNI routing to internal Gateways",{"_2384":361,"_23648":311,"_16085":37784,"_5":15974,"_22319":37656,"_1957":37785},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2384":362,"_23648":311,"_16085":37787,"_5":15974,"_22319":37656,"_1957":37788},[],"Separate Gateway resources but shared proxy infrastructure",{"_2384":363,"_23648":311,"_16085":37790,"_5":15974,"_22319":37656,"_1957":37791},[],"Envoy merged-Gateway mode",{"_2384":364,"_23648":311,"_16085":37793,"_5":15974,"_22319":37656,"_1957":37794},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2384":365,"_23648":311,"_16085":37796,"_5":15974,"_22319":37656,"_1957":37797},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2384":366,"_23648":311,"_16085":37799,"_5":15974,"_22319":37656,"_1957":37800},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2384":367,"_23648":311,"_16085":37802,"_5":15974,"_22319":37656,"_1957":37803},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2384":368,"_23648":311,"_16085":37805,"_5":15974,"_22319":37656,"_1957":37806},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2384":369,"_23648":311,"_16085":37808,"_5":15974,"_22319":37660,"_1957":37809},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2384":370,"_23648":311,"_16085":37811,"_5":15974,"_22319":37660,"_1957":37812},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2384":371,"_23648":311,"_16085":37814,"_5":15974,"_22319":37660,"_1957":37815},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2384":372,"_23648":311,"_16085":37817,"_5":15974,"_22319":37660,"_1957":37818},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2384":373,"_23648":311,"_16085":37820,"_5":15974,"_22319":37660,"_1957":37821},[],"If none of those are possible, use different external ports or change the external network design.",{"_2384":374,"_23648":311,"_16085":37823,"_5":15974,"_22319":37664,"_1957":37824},[],"Check, in order:",{"_2384":375,"_23648":311,"_16085":37826,"_5":15974,"_22319":37664,"_1957":37827},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2384":376,"_23648":311,"_16085":37829,"_5":15974,"_22319":37664,"_1957":37830},[],"Its status contains the expected address.",{"_2384":377,"_23648":311,"_16085":37832,"_5":15974,"_22319":37664,"_1957":37833},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2384":378,"_23648":311,"_16085":37835,"_5":15974,"_22319":37664,"_1957":37836},[],"Port 443 reaches that address from the client network.",{"_2384":379,"_23648":311,"_16085":37838,"_5":15974,"_22319":37664,"_1957":37839},[],"DNS resolves to the externally reachable endpoint.",{"_2384":380,"_23648":311,"_16085":37841,"_5":15974,"_22319":37664,"_1957":37842},[],"The certificate contains the DNS name or IP used by the client.",{"_2384":381,"_23648":311,"_16085":37844,"_5":15974,"_22319":37664,"_1957":37845},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2384":382,"_23648":382,"_5":10988,"_1957":36806,"_23928":37847,"_16085":37848,"_22319":382},[36699,36700,36806],[],{"_2384":383,"_23648":382,"_16085":37850,"_5":15974,"_22319":382,"_1957":37851},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2384":384,"_23648":382,"_5":23925,"_16085":37853,"_22319":37854,"_1957":37855},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2384":385,"_23648":382,"_5":23925,"_16085":37857,"_22319":37858,"_1957":37859},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2384":386,"_23648":382,"_5":23925,"_16085":37861,"_22319":37862,"_1957":37863},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2384":387,"_23648":382,"_5":23925,"_16085":37865,"_22319":37866,"_1957":37867},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2384":388,"_23648":382,"_5":23925,"_16085":37869,"_22319":37870,"_1957":37871},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2384":389,"_23648":382,"_5":23925,"_16085":37873,"_22319":37874,"_1957":37875},[],"/docs/pr-preview/pr-26/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2384":390,"_23648":382,"_16085":37877,"_5":15974,"_22319":37854,"_1957":37878},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2384":391,"_23648":382,"_16085":37880,"_5":15974,"_22319":37858,"_1957":37881},[],"Workflow",{"_2384":392,"_23648":382,"_16085":37883,"_5":15974,"_22319":37858,"_1957":37884},[],"Use it for",{"_2384":393,"_23648":382,"_16085":37886,"_5":15974,"_22319":37858,"_1957":37887},[],"What it installs",{"_2384":394,"_23648":382,"_16085":37889,"_5":15974,"_22319":37858,"_1957":37890},[],"Helm",{"_2384":395,"_23648":382,"_16085":37892,"_5":15974,"_22319":37858,"_1957":37893},[],"Production and controlled environments",{"_2384":396,"_23648":382,"_16085":37895,"_5":15974,"_22319":37858,"_1957":37896},[],"Lamassu services and Gateway API resources",{"_2384":397,"_23648":382,"_16085":37898,"_5":15974,"_22319":37858,"_1957":36943},[],{"_2384":398,"_23648":382,"_16085":37900,"_5":15974,"_22319":37858,"_1957":37901},[],"Evaluation, demos, CI and small lab clusters",{"_2384":399,"_23648":382,"_16085":37903,"_5":15974,"_22319":37858,"_1957":37904},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2384":400,"_23648":382,"_16085":37906,"_5":15974,"_22319":37862,"_1957":37907},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2384":401,"_23648":382,"_16085":37909,"_5":15974,"_22319":37862,"_1957":37910},[],"Area",{"_2384":402,"_23648":382,"_16085":37912,"_5":15974,"_22319":37862,"_1957":37913},[],"The Lamassu chart provides",{"_2384":403,"_23648":382,"_16085":37915,"_5":15974,"_22319":37862,"_1957":37916},[],"You provide",{"_2384":404,"_23648":382,"_16085":37918,"_5":15974,"_22319":37862,"_1957":37919},[],"Lamassu applications",{"_2384":405,"_23648":382,"_16085":37921,"_5":15974,"_22319":37862,"_1957":37922},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2384":406,"_23648":382,"_16085":37924,"_5":15974,"_22319":37862,"_1957":37925},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2384":407,"_23648":382,"_16085":37927,"_5":15974,"_22319":37862,"_1957":37928},[],"PostgreSQL data",{"_2384":408,"_23648":382,"_16085":37930,"_5":15974,"_22319":37862,"_1957":37931},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2384":409,"_23648":382,"_16085":37933,"_5":15974,"_22319":37862,"_1957":37934},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2384":410,"_23648":382,"_16085":37936,"_5":15974,"_22319":37862,"_1957":37937},[],"Messaging",{"_2384":411,"_23648":382,"_16085":37939,"_5":15974,"_22319":37862,"_1957":37940},[],"RabbitMQ connection configuration for the Lamassu services",{"_2384":412,"_23648":382,"_16085":37942,"_5":15974,"_22319":37862,"_1957":37943},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2384":413,"_23648":382,"_16085":37945,"_5":15974,"_22319":37862,"_1957":37946},[],"Identity",{"_2384":414,"_23648":382,"_16085":37948,"_5":15974,"_22319":37862,"_1957":37949},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2384":415,"_23648":382,"_16085":37951,"_5":15974,"_22319":37862,"_1957":37952},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2384":416,"_23648":382,"_16085":37954,"_5":15974,"_22319":37862,"_1957":37955},[],"External routing",{"_2384":417,"_23648":382,"_16085":37957,"_5":15974,"_22319":37862,"_1957":37958},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2384":418,"_23648":382,"_16085":37960,"_5":15974,"_22319":37862,"_1957":37961},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2384":419,"_23648":382,"_16085":37963,"_5":15974,"_22319":37862,"_1957":37964},[],"TLS",{"_2384":420,"_23648":382,"_16085":37966,"_5":15974,"_22319":37862,"_1957":37967},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2384":421,"_23648":382,"_16085":37969,"_5":15974,"_22319":37862,"_1957":37970},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2384":422,"_23648":382,"_16085":37972,"_5":15974,"_22319":37862,"_1957":37973},[],"Persistent application data",{"_2384":423,"_23648":382,"_16085":37975,"_5":15974,"_22319":37862,"_1957":37976},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2384":424,"_23648":382,"_16085":37978,"_5":15974,"_22319":37862,"_1957":37979},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2384":425,"_23648":382,"_16085":37981,"_5":15974,"_22319":37862,"_1957":37982},[],"Optional integrations",{"_2384":426,"_23648":382,"_16085":37984,"_5":15974,"_22319":37862,"_1957":37985},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2384":427,"_23648":382,"_16085":37987,"_5":15974,"_22319":37862,"_1957":37988},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2384":428,"_23648":382,"_16085":37990,"_5":15974,"_22319":37862,"_1957":37991},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2384":429,"_23648":382,"_16085":37993,"_5":15974,"_22319":37862,"_1957":37994},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2384":430,"_23648":382,"_16085":37996,"_5":15974,"_22319":37866,"_1957":37997},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2384":431,"_23648":382,"_16085":37999,"_5":15974,"_22319":37866,"_1957":38000},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2384":432,"_23648":382,"_16085":38002,"_5":15974,"_22319":37870,"_1957":38003},[],"Kubernetes 1.24 or newer",{"_2384":433,"_23648":382,"_16085":38005,"_5":15974,"_22319":37870,"_1957":38006},[],"Helm 3.2 or newer",{"_2384":434,"_23648":382,"_16085":38008,"_5":15974,"_22319":37870,"_1957":38009},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2384":435,"_23648":382,"_16085":38011,"_5":15974,"_22319":37870,"_1957":38012},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2384":436,"_23648":382,"_16085":38014,"_5":15974,"_22319":37870,"_1957":38015},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2384":437,"_23648":382,"_16085":38017,"_5":15974,"_22319":37870,"_1957":38018},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2384":438,"_23648":382,"_16085":38020,"_5":15974,"_22319":37870,"_1957":38021},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2384":439,"_23648":382,"_16085":38023,"_5":15974,"_22319":37874,"_1957":38024},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2384":440,"_23648":382,"_16085":38026,"_5":15974,"_22319":37874,"_1957":38027},[],"<Card title=\"Upgrade the chart\" description=\"Upgrade an existing Helm release, including the 3.8.0 to 4.0.0 migration steps.\" href=\"/docs/deployment/self-hosted/migration\" />",{"_2384":441,"_23648":382,"_16085":38029,"_5":15974,"_22319":37874,"_1957":38030},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2384":442,"_23648":382,"_16085":38032,"_5":15974,"_22319":37874,"_1957":38033},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2384":443,"_23648":443,"_5":10988,"_1957":38035,"_23928":38036,"_16085":38039,"_22319":443},"Access control",[36699,38037,38038],"Platform","Administer Lamassu",[],{"_2384":444,"_23648":443,"_16085":38041,"_5":15974,"_22319":443,"_1957":38042},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2384":445,"_23648":443,"_5":23925,"_16085":38044,"_22319":38045,"_1957":38046},[],"/docs/pr-preview/pr-26/platform/pki/access-control#essential-concepts","Essential concepts",{"_2384":446,"_23648":443,"_5":23925,"_16085":38048,"_22319":38049,"_1957":38050},[],"/docs/pr-preview/pr-26/platform/pki/access-control#two-decision-systems","Two decision systems",{"_2384":447,"_23648":443,"_5":23925,"_16085":38052,"_22319":38053,"_1957":38054},[],"/docs/pr-preview/pr-26/platform/pki/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2384":448,"_23648":443,"_5":23925,"_16085":38056,"_22319":38057,"_1957":38058},[],"/docs/pr-preview/pr-26/platform/pki/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2384":449,"_23648":443,"_5":23925,"_16085":38060,"_22319":38061,"_1957":38062},[],"/docs/pr-preview/pr-26/platform/pki/access-control#how-the-two-paths-relate","How the two paths relate",{"_2384":450,"_23648":443,"_5":23925,"_16085":38064,"_22319":38065,"_1957":38066},[],"/docs/pr-preview/pr-26/platform/pki/access-control#oidc-principals","OIDC principals",{"_2384":451,"_23648":443,"_5":23925,"_16085":38068,"_22319":38069,"_1957":38070},[],"/docs/pr-preview/pr-26/platform/pki/access-control#x509-principals","X.509 principals",{"_2384":452,"_23648":443,"_5":23925,"_16085":38072,"_22319":38073,"_1957":38074},[],"/docs/pr-preview/pr-26/platform/pki/access-control#when-several-principals-match","When several principals match",{"_2384":453,"_23648":443,"_5":23925,"_16085":38076,"_22319":38077,"_1957":38078},[],"/docs/pr-preview/pr-26/platform/pki/access-control#how-policies-express-access","How policies express access",{"_2384":454,"_23648":443,"_5":23925,"_16085":38080,"_22319":38081,"_1957":38082},[],"/docs/pr-preview/pr-26/platform/pki/access-control#global-and-direct-access","Global and direct access",{"_2384":455,"_23648":443,"_5":23925,"_16085":38084,"_22319":38085,"_1957":38086},[],"/docs/pr-preview/pr-26/platform/pki/access-control#access-inherited-through-relations","Access inherited through relations",{"_2384":456,"_23648":443,"_5":23925,"_16085":38088,"_22319":38089,"_1957":38090},[],"/docs/pr-preview/pr-26/platform/pki/access-control#attribute-filtered-access","Attribute-filtered access",{"_2384":457,"_23648":443,"_5":23925,"_16085":38092,"_22319":38093,"_1957":38094},[],"/docs/pr-preview/pr-26/platform/pki/access-control#http-rules","HTTP rules",{"_2384":458,"_23648":443,"_5":23925,"_16085":38096,"_22319":38097,"_1957":38098},[],"/docs/pr-preview/pr-26/platform/pki/access-control#included-policies","Included policies",{"_2384":459,"_23648":443,"_5":23925,"_16085":38100,"_22319":38101,"_1957":37305},[],"/docs/pr-preview/pr-26/platform/pki/access-control#provision-the-first-administrator",{"_2384":460,"_23648":443,"_5":23925,"_16085":38103,"_22319":38104,"_1957":38105},[],"/docs/pr-preview/pr-26/platform/pki/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2384":461,"_23648":443,"_5":23925,"_16085":38107,"_22319":38108,"_1957":38109},[],"/docs/pr-preview/pr-26/platform/pki/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2384":462,"_23648":443,"_5":23925,"_16085":38111,"_22319":38112,"_1957":38113},[],"/docs/pr-preview/pr-26/platform/pki/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2384":463,"_23648":443,"_5":23925,"_16085":38115,"_22319":38116,"_1957":38117},[],"/docs/pr-preview/pr-26/platform/pki/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2384":464,"_23648":443,"_5":23925,"_16085":38119,"_22319":38120,"_1957":38121},[],"/docs/pr-preview/pr-26/platform/pki/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2384":465,"_23648":443,"_5":23925,"_16085":38123,"_22319":38124,"_1957":38125},[],"/docs/pr-preview/pr-26/platform/pki/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2384":466,"_23648":443,"_5":23925,"_16085":38127,"_22319":38128,"_1957":38129},[],"/docs/pr-preview/pr-26/platform/pki/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2384":467,"_23648":443,"_5":23925,"_16085":38131,"_22319":38132,"_1957":38133},[],"/docs/pr-preview/pr-26/platform/pki/access-control#changes-and-access-revocation","Changes and access revocation",{"_2384":468,"_23648":443,"_5":23925,"_16085":38135,"_22319":38136,"_1957":38137},[],"/docs/pr-preview/pr-26/platform/pki/access-control#operational-checklist","Operational checklist",{"_2384":469,"_23648":443,"_5":23925,"_16085":38139,"_22319":38140,"_1957":38141},[],"/docs/pr-preview/pr-26/platform/pki/access-control#diagnostics","Diagnostics",{"_2384":470,"_23648":443,"_5":23925,"_16085":38143,"_22319":38144,"_1957":38145},[],"/docs/pr-preview/pr-26/platform/pki/access-control#the-response-is-401","The response is 401",{"_2384":471,"_23648":443,"_5":23925,"_16085":38147,"_22319":38148,"_1957":38149},[],"/docs/pr-preview/pr-26/platform/pki/access-control#the-response-is-403","The response is 403",{"_2384":472,"_23648":443,"_5":23925,"_16085":38151,"_22319":38152,"_1957":38153},[],"/docs/pr-preview/pr-26/platform/pki/access-control#everything-returns-403","Everything returns 403",{"_2384":473,"_23648":443,"_5":23925,"_16085":38155,"_22319":38156,"_1957":38157},[],"/docs/pr-preview/pr-26/platform/pki/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2384":474,"_23648":443,"_16085":38159,"_5":15974,"_22319":443,"_1957":38160},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2384":475,"_23648":443,"_16085":38162,"_5":15974,"_22319":443,"_1957":38163},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2384":476,"_23648":443,"_16085":38165,"_5":15974,"_22319":443,"_1957":38166},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2384":477,"_23648":443,"_16085":38168,"_5":15974,"_22319":38045,"_1957":38169},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2384":478,"_23648":443,"_16085":38171,"_5":15974,"_22319":38045,"_1957":38172},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2384":479,"_23648":443,"_16085":38174,"_5":15974,"_22319":38045,"_1957":38175},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2384":480,"_23648":443,"_16085":38177,"_5":15974,"_22319":38045,"_1957":38178},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2384":481,"_23648":443,"_16085":38180,"_5":15974,"_22319":38045,"_1957":38181},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2384":482,"_23648":443,"_16085":38183,"_5":15974,"_22319":38045,"_1957":38184},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and one of its policies must allow the requested operation.",{"_2384":483,"_23648":443,"_16085":38186,"_5":15974,"_22319":38049,"_1957":38187},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2384":484,"_23648":443,"_16085":38189,"_5":15974,"_22319":38049,"_1957":38190},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2384":485,"_23648":443,"_16085":38192,"_5":15974,"_22319":38053,"_1957":38193},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2384":486,"_23648":443,"_16085":38195,"_5":15974,"_22319":38053,"_1957":38196},[],"The decision is made **before forwarding the request to the service**:",{"_2384":487,"_23648":443,"_16085":38198,"_5":15974,"_22319":38053,"_1957":38199},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2384":488,"_23648":443,"_16085":38201,"_5":15974,"_22319":38053,"_1957":38202},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2384":489,"_23648":443,"_16085":38204,"_5":15974,"_22319":38053,"_1957":38205},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2384":490,"_23648":443,"_16085":38207,"_5":15974,"_22319":38053,"_1957":38208},[],"It separately loads the policies granted to each principal.",{"_2384":491,"_23648":443,"_16085":38210,"_5":15974,"_22319":38053,"_1957":38211},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2384":492,"_23648":443,"_16085":38213,"_5":15974,"_22319":38053,"_1957":38214},[],"`authz` looks for an HTTP rule granting that action.",{"_2384":493,"_23648":443,"_16085":38216,"_5":15974,"_22319":38053,"_1957":38217},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy.",{"_2384":494,"_23648":443,"_16085":38219,"_5":15974,"_22319":38053,"_1957":38220},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2384":495,"_23648":443,"_16085":38222,"_5":15974,"_22319":38053,"_1957":38223},[],"When it allows access, `authz` returns the selected principal in `x-current-user`. The Gateway can propagate that header to the service to preserve the identity context.",{"_2384":496,"_23648":443,"_16085":38225,"_5":15974,"_22319":38053,"_1957":38226},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, the schema must declare a constraint relating a request value to a normalized attribute of the principal.",{"_2384":497,"_23648":443,"_16085":38228,"_5":15974,"_22319":38057,"_1957":38229},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2384":498,"_23648":443,"_16085":38231,"_5":15974,"_22319":38057,"_1957":38232},[],"The decision is made with the domain operation context:",{"_2384":499,"_23648":443,"_16085":38234,"_5":15974,"_22319":38057,"_1957":38235},[],"The middleware extracts the credential and resolves the matching principals.",{"_2384":500,"_23648":443,"_16085":38237,"_5":15974,"_22319":38057,"_1957":38238},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2384":501,"_23648":443,"_16085":38240,"_5":15974,"_22319":38057,"_1957":38241},[],"`authz` gathers the entity rules of the granted policies.",{"_2384":502,"_23648":443,"_16085":38243,"_5":15974,"_22319":38057,"_1957":38244},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2384":503,"_23648":443,"_16085":38246,"_5":15974,"_22319":38057,"_1957":38247},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2384":504,"_23648":443,"_16085":38249,"_5":15974,"_22319":38057,"_1957":38250},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2384":505,"_23648":443,"_16085":38252,"_5":15974,"_22319":38057,"_1957":38253},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2384":506,"_23648":443,"_16085":38255,"_5":15974,"_22319":38057,"_1957":38256},[],"Actions fall into two groups:",{"_2384":507,"_23648":443,"_16085":38258,"_5":15974,"_22319":38057,"_1957":38259},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2384":508,"_23648":443,"_16085":38261,"_5":15974,"_22319":38057,"_1957":38262},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2384":509,"_23648":443,"_16085":38264,"_5":15974,"_22319":38057,"_1957":38265},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2384":510,"_23648":443,"_16085":38267,"_5":15974,"_22319":38061,"_1957":38268},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2384":511,"_23648":443,"_16085":38270,"_5":15974,"_22319":38061,"_1957":38271},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2384":512,"_23648":443,"_16085":38273,"_5":15974,"_22319":38061,"_1957":38274},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it. Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2384":513,"_23648":443,"_16085":38276,"_5":15974,"_22319":38065,"_1957":38277},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2384":514,"_23648":443,"_16085":38279,"_5":15974,"_22319":38065,"_1957":38280},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2384":515,"_23648":443,"_16085":38282,"_5":15974,"_22319":38065,"_1957":38283},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2384":516,"_23648":443,"_16085":38285,"_5":15974,"_22319":38065,"_1957":38286},[],"The implemented operators are:",{"_2384":517,"_23648":443,"_16085":38288,"_5":15974,"_22319":38065,"_1957":38289},[],"`equals`, for exact equality;",{"_2384":518,"_23648":443,"_16085":38291,"_5":15974,"_22319":38065,"_1957":38292},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2384":519,"_23648":443,"_16085":38294,"_5":15974,"_22319":38065,"_1957":38295},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2384":520,"_23648":443,"_16085":38297,"_5":15974,"_22319":38065,"_1957":38298},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2384":521,"_23648":443,"_16085":38300,"_5":15974,"_22319":38069,"_1957":38301},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2384":522,"_23648":443,"_16085":38303,"_5":15974,"_22319":38069,"_1957":38304},[],"The available modes are:",{"_2384":523,"_23648":443,"_16085":38306,"_5":15974,"_22319":38069,"_1957":38307},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2384":524,"_23648":443,"_16085":38309,"_5":15974,"_22319":38069,"_1957":38310},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2384":525,"_23648":443,"_16085":38312,"_5":15974,"_22319":38069,"_1957":38313},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2384":526,"_23648":443,"_16085":38315,"_5":15974,"_22319":38069,"_1957":38316},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2384":527,"_23648":443,"_16085":38318,"_5":15974,"_22319":38069,"_1957":38319},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2384":528,"_23648":443,"_16085":38321,"_5":15974,"_22319":38069,"_1957":38322},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2384":529,"_23648":443,"_16085":38324,"_5":15974,"_22319":38073,"_1957":38325},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2384":530,"_23648":443,"_16085":38327,"_5":15974,"_22319":38073,"_1957":38328},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2384":531,"_23648":443,"_16085":38330,"_5":15974,"_22319":38073,"_1957":38331},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2384":532,"_23648":443,"_16085":38333,"_5":15974,"_22319":38073,"_1957":38334},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2384":533,"_23648":443,"_16085":38336,"_5":15974,"_22319":38081,"_1957":38337},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2384":534,"_23648":443,"_16085":38339,"_5":15974,"_22319":38081,"_1957":38340},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2384":535,"_23648":443,"_16085":38342,"_5":15974,"_22319":38085,"_1957":38343},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2384":536,"_23648":443,"_16085":38345,"_5":15974,"_22319":38085,"_1957":38346},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2384":537,"_23648":443,"_16085":38348,"_5":15974,"_22319":38089,"_1957":38349},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2384":538,"_23648":443,"_16085":38351,"_5":15974,"_22319":38089,"_1957":38352},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2384":539,"_23648":443,"_16085":38354,"_5":15974,"_22319":38089,"_1957":38355},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2384":540,"_23648":443,"_16085":38357,"_5":15974,"_22319":38093,"_1957":38358},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2384":541,"_23648":443,"_16085":38360,"_5":15974,"_22319":38093,"_1957":38361},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2384":542,"_23648":443,"_16085":38363,"_5":15974,"_22319":38093,"_1957":38364},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2384":543,"_23648":443,"_16085":38366,"_5":15974,"_22319":38097,"_1957":38367},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2384":544,"_23648":443,"_16085":38369,"_5":15974,"_22319":38097,"_1957":38370},[],"full and read-only access to certificates and authorities;",{"_2384":545,"_23648":443,"_16085":38372,"_5":15974,"_22319":38097,"_1957":38373},[],"full and read-only access to the KMS;",{"_2384":546,"_23648":443,"_16085":38375,"_5":15974,"_22319":38097,"_1957":38376},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2384":547,"_23648":443,"_16085":38378,"_5":15974,"_22319":38097,"_1957":38379},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2384":548,"_23648":443,"_16085":38381,"_5":15974,"_22319":38097,"_1957":38382},[],"console access;",{"_2384":549,"_23648":443,"_16085":38384,"_5":15974,"_22319":38097,"_1957":38385},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2384":550,"_23648":443,"_16085":38387,"_5":15974,"_22319":38097,"_1957":38388},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2384":551,"_23648":443,"_16085":38390,"_5":15974,"_22319":38097,"_1957":38391},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2384":552,"_23648":443,"_16085":38393,"_5":15974,"_22319":38101,"_1957":38394},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2384":553,"_23648":443,"_16085":38396,"_5":15974,"_22319":38101,"_1957":38397},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2384":554,"_23648":443,"_16085":38399,"_5":15974,"_22319":38101,"_1957":38400},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2384":555,"_23648":443,"_16085":38402,"_5":15974,"_22319":38104,"_1957":38403},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2384":556,"_23648":443,"_16085":38405,"_5":15974,"_22319":38108,"_1957":38406},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2384":557,"_23648":443,"_16085":38408,"_5":15974,"_22319":38112,"_1957":38409},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2384":558,"_23648":443,"_16085":38411,"_5":15974,"_22319":38116,"_1957":38412},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2384":559,"_23648":443,"_16085":38414,"_5":15974,"_22319":38120,"_1957":38415},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2384":560,"_23648":443,"_16085":38417,"_5":15974,"_22319":38124,"_1957":38418},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2384":561,"_23648":443,"_16085":38420,"_5":15974,"_22319":38124,"_1957":38421},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2384":562,"_23648":443,"_16085":38423,"_5":15974,"_22319":38128,"_1957":38424},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2384":563,"_23648":443,"_16085":38426,"_5":15974,"_22319":38128,"_1957":38427},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2384":564,"_23648":443,"_16085":38429,"_5":15974,"_22319":38128,"_1957":38430},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2384":565,"_23648":443,"_16085":38432,"_5":15974,"_22319":38128,"_1957":38433},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2384":566,"_23648":443,"_16085":38435,"_5":15974,"_22319":38128,"_1957":38436},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2384":567,"_23648":443,"_16085":38438,"_5":15974,"_22319":38128,"_1957":38439},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2384":568,"_23648":443,"_16085":38441,"_5":15974,"_22319":38128,"_1957":38442},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2384":569,"_23648":443,"_16085":38444,"_5":15974,"_22319":38128,"_1957":38445},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2384":570,"_23648":443,"_16085":38447,"_5":15974,"_22319":38132,"_1957":38448},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2384":571,"_23648":443,"_16085":38450,"_5":15974,"_22319":38132,"_1957":38451},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2384":572,"_23648":443,"_16085":38453,"_5":15974,"_22319":38132,"_1957":38454},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2384":573,"_23648":443,"_16085":38456,"_5":15974,"_22319":38136,"_1957":38457},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2384":574,"_23648":443,"_16085":38459,"_5":15974,"_22319":38136,"_1957":38460},[],"Use groups or stable roles for people and independent identities for automations.",{"_2384":575,"_23648":443,"_16085":38462,"_5":15974,"_22319":38136,"_1957":38463},[],"Keep at least two recovery administrators and test their access periodically.",{"_2384":576,"_23648":443,"_16085":38465,"_5":15974,"_22319":38136,"_1957":38466},[],"Review active principals, their matches and their grants after IdP changes.",{"_2384":577,"_23648":443,"_16085":38468,"_5":15974,"_22319":38136,"_1957":38469},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2384":578,"_23648":443,"_16085":38471,"_5":15974,"_22319":38136,"_1957":38472},[],"Always test one allowed and one denied operation for each role.",{"_2384":579,"_23648":443,"_16085":38474,"_5":15974,"_22319":38136,"_1957":38475},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2384":580,"_23648":443,"_16085":38477,"_5":15974,"_22319":38144,"_1957":38478},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2384":581,"_23648":443,"_16085":38480,"_5":15974,"_22319":38148,"_1957":38481},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2384":582,"_23648":443,"_16085":38483,"_5":15974,"_22319":38148,"_1957":38484},[],"that an active principal of the correct type exists;",{"_2384":583,"_23648":443,"_16085":38486,"_5":15974,"_22319":38148,"_1957":38487},[],"that the claim paths and values match the real token exactly;",{"_2384":584,"_23648":443,"_16085":38489,"_5":15974,"_22319":38148,"_1957":38490},[],"that all of the principal's conditions hold;",{"_2384":585,"_23648":443,"_16085":38492,"_5":15974,"_22319":38148,"_1957":38493},[],"that the principal has the expected policy granted;",{"_2384":586,"_23648":443,"_16085":38495,"_5":15974,"_22319":38148,"_1957":38496},[],"that the policy includes the action and the requested resource type or route;",{"_2384":587,"_23648":443,"_16085":38498,"_5":15974,"_22319":38148,"_1957":38499},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2384":588,"_23648":443,"_16085":38501,"_5":15974,"_22319":38148,"_1957":38502},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure.",{"_2384":589,"_23648":443,"_16085":38504,"_5":15974,"_22319":38152,"_1957":38505},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2384":590,"_23648":443,"_16085":38507,"_5":15974,"_22319":38156,"_1957":38508},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2384":591,"_23648":443,"_16085":38510,"_5":15974,"_22319":38156,"_1957":38511},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2384":592,"_23648":592,"_5":10988,"_1957":38513,"_23928":38514,"_16085":38516,"_22319":592},"Alerts and subscriptions",[36699,38037,38515],"Operate Lamassu",[],{"_2384":593,"_23648":592,"_16085":38518,"_5":15974,"_22319":592,"_1957":38519},[],"Send PKI events to people and external systems.",{"_2384":594,"_23648":592,"_5":23925,"_16085":38521,"_22319":38522,"_1957":38523},[],"/docs/pr-preview/pr-26/platform/pki/alerts#how-it-works","How it works",{"_2384":595,"_23648":592,"_5":23925,"_16085":38525,"_22319":38526,"_1957":38527},[],"/docs/pr-preview/pr-26/platform/pki/alerts#available-channels","Available channels",{"_2384":596,"_23648":592,"_5":23925,"_16085":38529,"_22319":38530,"_1957":38531},[],"/docs/pr-preview/pr-26/platform/pki/alerts#create-a-subscription","Create a subscription",{"_2384":597,"_23648":592,"_5":23925,"_16085":38533,"_22319":38534,"_1957":38535},[],"/docs/pr-preview/pr-26/platform/pki/alerts#choose-the-event","Choose the event",{"_2384":598,"_23648":592,"_5":23925,"_16085":38537,"_22319":38538,"_1957":38539},[],"/docs/pr-preview/pr-26/platform/pki/alerts#configure-the-destination","Configure the destination",{"_2384":599,"_23648":592,"_5":23925,"_16085":38541,"_22319":38542,"_1957":38543},[],"/docs/pr-preview/pr-26/platform/pki/alerts#limit-the-notifications","Limit the notifications",{"_2384":600,"_23648":592,"_5":23925,"_16085":38545,"_22319":38546,"_1957":38547},[],"/docs/pr-preview/pr-26/platform/pki/alerts#review-and-activate","Review and activate",{"_2384":601,"_23648":592,"_5":23925,"_16085":38549,"_22319":38550,"_1957":38551},[],"/docs/pr-preview/pr-26/platform/pki/alerts#manage-a-subscription","Manage a subscription",{"_2384":602,"_23648":592,"_5":23925,"_16085":38553,"_22319":38554,"_1957":38555},[],"/docs/pr-preview/pr-26/platform/pki/alerts#event-families","Event families",{"_2384":603,"_23648":592,"_16085":38557,"_5":15974,"_22319":592,"_1957":38558},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2384":604,"_23648":592,"_16085":38560,"_5":15974,"_22319":38522,"_1957":38561},[],"A service publishes a domain event.",{"_2384":605,"_23648":592,"_16085":38563,"_5":15974,"_22319":38522,"_1957":38564},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2384":606,"_23648":592,"_16085":38566,"_5":15974,"_22319":38522,"_1957":38567},[],"Each subscription's filter decides whether it should be notified.",{"_2384":607,"_23648":592,"_16085":38569,"_5":15974,"_22319":38522,"_1957":38570},[],"Lamassu delivers the event to the configured channel.",{"_2384":608,"_23648":592,"_16085":38572,"_5":15974,"_22319":38522,"_1957":38573},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2384":609,"_23648":592,"_16085":38575,"_5":15974,"_22319":38526,"_1957":38576},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address.",{"_2384":610,"_23648":592,"_16085":38578,"_5":15974,"_22319":38526,"_1957":38579},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2384":611,"_23648":592,"_16085":38581,"_5":15974,"_22319":38526,"_1957":38582},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2384":612,"_23648":592,"_16085":38584,"_5":15974,"_22319":38534,"_1957":38585},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2384":613,"_23648":592,"_16085":38587,"_5":15974,"_22319":38538,"_1957":38588},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2384":614,"_23648":592,"_16085":38590,"_5":15974,"_22319":38542,"_1957":38591},[],"Add a filter if you don't want to receive every instance of the event.",{"_2384":615,"_23648":592,"_16085":38593,"_5":15974,"_22319":38542,"_1957":38594},[],"**None** notifies all instances of the event.",{"_2384":616,"_23648":592,"_16085":38596,"_5":15974,"_22319":38542,"_1957":38597},[],"**JSON Path** evaluates one or more specific fields.",{"_2384":617,"_23648":592,"_16085":38599,"_5":15974,"_22319":38542,"_1957":38600},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2384":618,"_23648":592,"_16085":38602,"_5":15974,"_22319":38542,"_1957":38603},[],"**JavaScript** lets you express custom logic.",{"_2384":619,"_23648":592,"_16085":38605,"_5":15974,"_22319":38542,"_1957":38606},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2384":620,"_23648":592,"_16085":38608,"_5":15974,"_22319":38546,"_1957":38609},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2384":621,"_23648":592,"_16085":38611,"_5":15974,"_22319":38550,"_1957":38612},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2384":622,"_23648":592,"_16085":38614,"_5":15974,"_22319":38554,"_1957":38615},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2384":623,"_23648":592,"_16085":38617,"_5":15974,"_22319":38554,"_1957":38618},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2384":624,"_23648":592,"_16085":38620,"_5":15974,"_22319":38554,"_1957":38621},[],"**Profiles:** `profile.create`, `profile.update` and `profile.delete`.",{"_2384":625,"_23648":592,"_16085":38623,"_5":15974,"_22319":38554,"_1957":38624},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2384":626,"_23648":592,"_16085":38626,"_5":15974,"_22319":38554,"_1957":38627},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2384":627,"_23648":592,"_16085":38629,"_5":15974,"_22319":38554,"_1957":38630},[],"**Validation:** `va.role.crl.create`.",{"_2384":628,"_23648":592,"_16085":38632,"_5":15974,"_22319":38554,"_1957":38633},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign.message` and `kms.delete`.",{"_2384":629,"_23648":592,"_16085":38635,"_5":15974,"_22319":38554,"_1957":38636},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2384":630,"_23648":630,"_5":10988,"_1957":38638,"_23928":38639,"_16085":38640,"_22319":630},"Audit logs",[36699,38037,38038],[],{"_2384":631,"_23648":630,"_16085":38642,"_5":15974,"_22319":630,"_1957":38643},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2384":632,"_23648":630,"_5":23925,"_16085":38645,"_22319":38646,"_1957":38647},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#what-an-event-contains","What an event contains",{"_2384":633,"_23648":630,"_5":23925,"_16085":38649,"_22319":38650,"_1957":38651},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#coverage","Coverage",{"_2384":634,"_23648":630,"_5":23925,"_16085":38653,"_22319":38654,"_1957":38655},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#publication-and-persistence","Publication and persistence",{"_2384":635,"_23648":630,"_5":23925,"_16085":38657,"_22319":38658,"_1957":38659},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#sensitive-data","Sensitive data",{"_2384":636,"_23648":630,"_5":23925,"_16085":38661,"_22319":38662,"_1957":38663},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2384":637,"_23648":630,"_5":23925,"_16085":38665,"_22319":38666,"_1957":38667},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#bound-the-interval","Bound the interval",{"_2384":638,"_23648":630,"_5":23925,"_16085":38669,"_22319":38670,"_1957":38671},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#identify-the-operation","Identify the operation",{"_2384":639,"_23648":630,"_5":23925,"_16085":38673,"_22319":38674,"_1957":38675},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#attribute-the-principal","Attribute the principal",{"_2384":640,"_23648":630,"_5":23925,"_16085":38677,"_22319":38678,"_1957":38679},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#compare-intent-and-result","Compare intent and result",{"_2384":641,"_23648":630,"_5":23925,"_16085":38681,"_22319":38682,"_1957":38683},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#follow-the-effect","Follow the effect",{"_2384":642,"_23648":630,"_5":23925,"_16085":38685,"_22319":38686,"_1957":38687},[],"/docs/pr-preview/pr-26/platform/pki/audit-logs#periodic-verification","Periodic verification",{"_2384":643,"_23648":630,"_16085":38689,"_5":15974,"_22319":630,"_1957":38690},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2384":644,"_23648":630,"_16085":38692,"_5":15974,"_22319":38646,"_1957":38693},[],"The audit body includes:",{"_2384":645,"_23648":630,"_16085":38695,"_5":15974,"_22319":38646,"_1957":38696},[],"input: data received by the operation;",{"_2384":646,"_23648":630,"_16085":38698,"_5":15974,"_22319":38646,"_1957":38699},[],"has\\_error: whether the service returned an error;",{"_2384":647,"_23648":630,"_16085":38701,"_5":15974,"_22319":38646,"_1957":38702},[],"output: produced result or error message;",{"_2384":648,"_23648":630,"_16085":38704,"_5":15974,"_22319":38646,"_1957":38705},[],"principals: identifiers of the principals that matched the request.",{"_2384":649,"_23648":630,"_16085":38707,"_5":15974,"_22319":38646,"_1957":38708},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2384":650,"_23648":630,"_16085":38710,"_5":15974,"_22319":38646,"_1957":38711},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2384":651,"_23648":630,"_16085":38713,"_5":15974,"_22319":38650,"_1957":38714},[],"The backend applies auditing to mutations of:",{"_2384":652,"_23648":630,"_16085":38716,"_5":15974,"_22319":38650,"_1957":38717},[],"authorities, certificates and issuance profiles;",{"_2384":653,"_23648":630,"_16085":38719,"_5":15974,"_22319":38650,"_1957":38720},[],"keys and KMS engines;",{"_2384":654,"_23648":630,"_16085":38722,"_5":15974,"_22319":38650,"_1957":38723},[],"devices and identities;",{"_2384":655,"_23648":630,"_16085":38725,"_5":15974,"_22319":38650,"_1957":38726},[],"DMSs and enrollment operations;",{"_2384":656,"_23648":630,"_16085":38728,"_5":15974,"_22319":38650,"_1957":38729},[],"validation functions and CRL;",{"_2384":657,"_23648":630,"_16085":38731,"_5":15974,"_22319":38650,"_1957":38732},[],"principals, policies and authorization grants.",{"_2384":658,"_23648":630,"_16085":38734,"_5":15974,"_22319":38650,"_1957":38735},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2384":659,"_23648":630,"_16085":38737,"_5":15974,"_22319":38654,"_1957":38738},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2384":660,"_23648":630,"_16085":38740,"_5":15974,"_22319":38654,"_1957":38741},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2384":661,"_23648":630,"_16085":38743,"_5":15974,"_22319":38654,"_1957":38744},[],"Design the consumer to:",{"_2384":662,"_23648":630,"_16085":38746,"_5":15974,"_22319":38654,"_1957":38747},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2384":663,"_23648":630,"_16085":38749,"_5":15974,"_22319":38654,"_1957":38750},[],"keep the complete CloudEvent unmodified;",{"_2384":664,"_23648":630,"_16085":38752,"_5":15974,"_22319":38654,"_1957":38753},[],"record the ingestion time and detect duplicates by ID;",{"_2384":665,"_23648":630,"_16085":38755,"_5":15974,"_22319":38654,"_1957":38756},[],"encrypt in transit and at rest;",{"_2384":666,"_23648":630,"_16085":38758,"_5":15974,"_22319":38654,"_1957":38759},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2384":667,"_23648":630,"_16085":38761,"_5":15974,"_22319":38654,"_1957":38762},[],"apply an explicit retention and legal hold policy;",{"_2384":668,"_23648":630,"_16085":38764,"_5":15974,"_22319":38654,"_1957":38765},[],"alert if it stops consuming or the pending queue grows.",{"_2384":669,"_23648":630,"_16085":38767,"_5":15974,"_22319":38658,"_1957":38768},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2384":670,"_23648":630,"_16085":38770,"_5":15974,"_22319":38658,"_1957":38771},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2384":671,"_23648":630,"_16085":38773,"_5":15974,"_22319":38666,"_1957":38774},[],"Start from the reported time and normalize every source to UTC.",{"_2384":672,"_23648":630,"_16085":38776,"_5":15974,"_22319":38670,"_1957":38777},[],"Filter by event type, service source and resource identifier.",{"_2384":673,"_23648":630,"_16085":38779,"_5":15974,"_22319":38674,"_1957":38780},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2384":674,"_23648":630,"_16085":38782,"_5":15974,"_22319":38678,"_1957":38783},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2384":675,"_23648":630,"_16085":38785,"_5":15974,"_22319":38682,"_1957":38786},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2384":676,"_23648":630,"_16085":38788,"_5":15974,"_22319":38686,"_1957":38789},[],"Generate a controlled mutation in a test environment and check that:",{"_2384":677,"_23648":630,"_16085":38791,"_5":15974,"_22319":38686,"_1957":38792},[],"a successful audit event appears;",{"_2384":678,"_23648":630,"_16085":38794,"_5":15974,"_22319":38686,"_1957":38795},[],"the principal matches the identity used;",{"_2384":679,"_23648":630,"_16085":38797,"_5":15974,"_22319":38686,"_1957":38798},[],"the consumer persists it exactly once;",{"_2384":680,"_23648":630,"_16085":38800,"_5":15974,"_22319":38686,"_1957":38801},[],"it can be retrieved by resource, actor and period;",{"_2384":681,"_23648":630,"_16085":38803,"_5":15974,"_22319":38686,"_1957":38804},[],"a consumer outage raises an alert.",{"_2384":682,"_23648":630,"_16085":38806,"_5":15974,"_22319":38686,"_1957":38807},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2384":683,"_23648":683,"_5":10988,"_1957":38809,"_23928":38810,"_16085":38811,"_22319":683},"CA hierarchy and rotation",[36699,38037,38515],[],{"_2384":684,"_23648":683,"_16085":38813,"_5":15974,"_22319":683,"_1957":38814},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2384":685,"_23648":683,"_5":23925,"_16085":38816,"_22319":38817,"_1957":38818},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2384":686,"_23648":683,"_5":23925,"_16085":38820,"_22319":38821,"_1957":38822},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2384":687,"_23648":683,"_5":23925,"_16085":38824,"_22319":38825,"_1957":38826},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2384":688,"_23648":683,"_5":23925,"_16085":38828,"_22319":38829,"_1957":38830},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2384":689,"_23648":683,"_5":23925,"_16085":38832,"_22319":38833,"_1957":38834},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2384":690,"_23648":683,"_5":23925,"_16085":38836,"_22319":38837,"_1957":38838},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2384":691,"_23648":683,"_5":23925,"_16085":38840,"_22319":38841,"_1957":38842},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2384":692,"_23648":683,"_5":23925,"_16085":38844,"_22319":38845,"_1957":38846},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2384":693,"_23648":683,"_5":23925,"_16085":38848,"_22319":38849,"_1957":38850},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2384":694,"_23648":683,"_5":23925,"_16085":38852,"_22319":38853,"_1957":38854},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2384":695,"_23648":683,"_5":23925,"_16085":38856,"_22319":38857,"_1957":38858},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2384":696,"_23648":683,"_5":23925,"_16085":38860,"_22319":38861,"_1957":38862},[],"/docs/pr-preview/pr-26/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2384":697,"_23648":683,"_16085":38864,"_5":15974,"_22319":683,"_1957":38865},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2384":698,"_23648":683,"_16085":38867,"_5":15974,"_22319":38817,"_1957":38868},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2384":699,"_23648":683,"_16085":38870,"_5":15974,"_22319":38817,"_1957":38871},[],"environment, such as production and preproduction;",{"_2384":700,"_23648":683,"_16085":38873,"_5":15974,"_22319":38817,"_1957":38874},[],"owner or operating team;",{"_2384":701,"_23648":683,"_16085":38876,"_5":15974,"_22319":38817,"_1957":38877},[],"device family or manufacturing process;",{"_2384":702,"_23648":683,"_16085":38879,"_5":15974,"_22319":38817,"_1957":38880},[],"region or regulatory requirement;",{"_2384":703,"_23648":683,"_16085":38882,"_5":15974,"_22319":38817,"_1957":38883},[],"cryptographic engine or key policy;",{"_2384":704,"_23648":683,"_16085":38885,"_5":15974,"_22319":38817,"_1957":38886},[],"maintenance window and renewal cadence.",{"_2384":705,"_23648":683,"_16085":38888,"_5":15974,"_22319":38817,"_1957":38889},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2384":706,"_23648":683,"_16085":38891,"_5":15974,"_22319":38817,"_1957":38892},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2384":707,"_23648":683,"_16085":38894,"_5":15974,"_22319":38821,"_1957":38895},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2384":708,"_23648":683,"_16085":38897,"_5":15974,"_22319":38821,"_1957":38898},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2384":709,"_23648":683,"_16085":38900,"_5":15974,"_22319":38821,"_1957":38901},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2384":710,"_23648":683,"_16085":38903,"_5":15974,"_22319":38825,"_1957":38904},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2384":711,"_23648":683,"_16085":38906,"_5":15974,"_22319":38825,"_1957":38907},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2384":712,"_23648":683,"_16085":38909,"_5":15974,"_22319":38825,"_1957":38910},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2384":713,"_23648":683,"_16085":38912,"_5":15974,"_22319":38825,"_1957":38913},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2384":714,"_23648":683,"_16085":38915,"_5":15974,"_22319":38833,"_1957":38916},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2384":715,"_23648":683,"_16085":38918,"_5":15974,"_22319":38837,"_1957":38919},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2384":716,"_23648":683,"_16085":38921,"_5":15974,"_22319":38841,"_1957":38922},[],"Add the new root or chain to consumers before issuing with it. In a DMS, use the managed CAs of `/cacerts` to temporarily keep both the old and new chains.",{"_2384":717,"_23648":683,"_16085":38924,"_5":15974,"_22319":38845,"_1957":38925},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2384":718,"_23648":683,"_16085":38927,"_5":15974,"_22319":38849,"_1957":38928},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2384":719,"_23648":683,"_16085":38930,"_5":15974,"_22319":38853,"_1957":38931},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2384":720,"_23648":683,"_16085":38933,"_5":15974,"_22319":38857,"_1957":38934},[],"When you revoke a CA, Lamassu also updates its child CAs and issued certificates to `REVOKED` with the reason `CessationOfOperation`. The children's revocations propagate the effect to their own branches.",{"_2384":721,"_23648":683,"_16085":38936,"_5":15974,"_22319":38857,"_1957":38937},[],"This protects the coherence of the hierarchy, but it makes revocation a high-impact action. Do not use it as the ordinary mechanism to stop issuing: first complete the migration and remove the CA from operational flows.",{"_2384":722,"_23648":683,"_16085":38939,"_5":15974,"_22319":38861,"_1957":38940},[],"The new chain ends in an anchor installed by the consumer.",{"_2384":723,"_23648":683,"_16085":38942,"_5":15974,"_22319":38861,"_1957":38943},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2384":724,"_23648":683,"_16085":38945,"_5":15974,"_22319":38861,"_1957":38946},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2384":725,"_23648":683,"_16085":38948,"_5":15974,"_22319":38861,"_1957":38949},[],"Re-enrollment accepts the old identity during the planned period.",{"_2384":726,"_23648":683,"_16085":38951,"_5":15974,"_22319":38861,"_1957":38952},[],"OCSP and CRL respond for the authorities that remain active.",{"_2384":727,"_23648":683,"_16085":38954,"_5":15974,"_22319":38861,"_1957":38955},[],"No DMS is left accidentally issuing from the old CA.",{"_2384":728,"_23648":683,"_16085":38957,"_5":15974,"_22319":38861,"_1957":38958},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2384":729,"_23648":729,"_5":10988,"_1957":38960,"_23928":38961,"_16085":38962,"_22319":729},"Certification authorities",[36699,38037,38515],[],{"_2384":730,"_23648":729,"_16085":38964,"_5":15974,"_22319":729,"_1957":38965},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2384":731,"_23648":729,"_5":23925,"_16085":38967,"_22319":38968,"_1957":38969},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2384":732,"_23648":729,"_5":23925,"_16085":38971,"_22319":38972,"_1957":38973},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2384":733,"_23648":729,"_5":23925,"_16085":38975,"_22319":38976,"_1957":36709},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#before-you-begin",{"_2384":734,"_23648":729,"_5":23925,"_16085":38978,"_22319":38979,"_1957":38980},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2384":735,"_23648":729,"_5":23925,"_16085":38982,"_22319":38983,"_1957":38984},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2384":736,"_23648":729,"_5":23925,"_16085":38986,"_22319":38987,"_1957":38988},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2384":737,"_23648":729,"_5":23925,"_16085":38990,"_22319":38991,"_1957":38992},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2384":738,"_23648":729,"_5":23925,"_16085":38994,"_22319":38995,"_1957":38996},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2384":739,"_23648":729,"_5":23925,"_16085":38998,"_22319":38999,"_1957":39000},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2384":740,"_23648":729,"_5":23925,"_16085":39002,"_22319":39003,"_1957":39004},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2384":741,"_23648":729,"_5":23925,"_16085":39006,"_22319":39007,"_1957":39008},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2384":742,"_23648":729,"_5":23925,"_16085":39010,"_22319":39011,"_1957":39012},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2384":743,"_23648":729,"_5":23925,"_16085":39014,"_22319":39015,"_1957":39016},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2384":744,"_23648":729,"_5":23925,"_16085":39018,"_22319":39019,"_1957":39020},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2384":745,"_23648":729,"_5":23925,"_16085":39022,"_22319":39023,"_1957":39024},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2384":746,"_23648":729,"_5":23925,"_16085":39026,"_22319":39027,"_1957":39028},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2384":747,"_23648":729,"_5":23925,"_16085":39030,"_22319":39031,"_1957":39032},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2384":748,"_23648":729,"_5":23925,"_16085":39034,"_22319":39035,"_1957":39036},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2384":749,"_23648":729,"_5":23925,"_16085":39038,"_22319":39039,"_1957":39040},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2384":750,"_23648":729,"_5":23925,"_16085":39042,"_22319":39043,"_1957":39044},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2384":751,"_23648":729,"_5":23925,"_16085":39046,"_22319":39047,"_1957":39048},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2384":752,"_23648":729,"_5":23925,"_16085":39050,"_22319":39051,"_1957":39052},[],"/docs/pr-preview/pr-26/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2384":753,"_23648":729,"_16085":39054,"_5":15974,"_22319":729,"_1957":39055},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2384":754,"_23648":729,"_16085":39057,"_5":15974,"_22319":729,"_1957":39058},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2384":755,"_23648":729,"_16085":39060,"_5":15974,"_22319":38968,"_1957":39061},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2384":756,"_23648":729,"_16085":39063,"_5":15974,"_22319":38968,"_1957":39064},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2384":757,"_23648":729,"_16085":39066,"_5":15974,"_22319":38968,"_1957":39067},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2384":758,"_23648":729,"_16085":39069,"_5":15974,"_22319":38968,"_1957":39070},[],"**Import only the certificate:** add an authority for building chains and validating, but not for issuing.",{"_2384":759,"_23648":729,"_16085":39072,"_5":15974,"_22319":38968,"_1957":39073},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2384":760,"_23648":729,"_16085":39075,"_5":15974,"_22319":38976,"_1957":39076},[],"Decide whether the CA will be a root or an intermediate.",{"_2384":761,"_23648":729,"_16085":39078,"_5":15974,"_22319":38976,"_1957":39079},[],"Choose the engine that will keep the key.",{"_2384":762,"_23648":729,"_16085":39081,"_5":15974,"_22319":38976,"_1957":39082},[],"Define a validity longer than that of the certificates it will issue.",{"_2384":763,"_23648":729,"_16085":39084,"_5":15974,"_22319":38976,"_1957":39085},[],"For an intermediate CA, make sure the parent CA is active.",{"_2384":764,"_23648":729,"_16085":39087,"_5":15974,"_22319":38979,"_1957":39088},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2384":765,"_23648":729,"_16085":39090,"_5":15974,"_22319":38983,"_1957":39091},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2384":766,"_23648":729,"_16085":39093,"_5":15974,"_22319":38983,"_1957":39094},[],"For RSA you can choose 1024, 2048, 3072 or 4096 bits. For EC, the P-256, P-384 and P-521 curves are available.",{"_2384":767,"_23648":729,"_16085":39096,"_5":15974,"_22319":38987,"_1957":39097},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2384":768,"_23648":729,"_16085":39099,"_5":15974,"_22319":38991,"_1957":39100},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2384":769,"_23648":729,"_16085":39102,"_5":15974,"_22319":38991,"_1957":39103},[],"`C`: two-letter ISO 3166-1 country code.",{"_2384":770,"_23648":729,"_16085":39105,"_5":15974,"_22319":38991,"_1957":39106},[],"`ST`: state or province.",{"_2384":771,"_23648":729,"_16085":39108,"_5":15974,"_22319":38991,"_1957":39109},[],"`L`: locality.",{"_2384":772,"_23648":729,"_16085":39111,"_5":15974,"_22319":38991,"_1957":39112},[],"`O`: organization.",{"_2384":773,"_23648":729,"_16085":39114,"_5":15974,"_22319":38991,"_1957":39115},[],"`OU`: organizational unit.",{"_2384":774,"_23648":729,"_16085":39117,"_5":15974,"_22319":38991,"_1957":39118},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2384":775,"_23648":729,"_16085":39120,"_5":15974,"_22319":38995,"_1957":39121},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2384":776,"_23648":729,"_16085":39123,"_5":15974,"_22319":38995,"_1957":39124},[],"Select an existing issuance profile or configure the `Key Usage` and `Extended Key Usage` in the form. If you don't choose a profile, Lamassu applies the default basic usages.",{"_2384":777,"_23648":729,"_16085":39126,"_5":15974,"_22319":38999,"_1957":39127},[],"Confirm the form. The CA should appear in the inventory with its PEM certificate, status, expiration date and list of issued certificates.",{"_2384":778,"_23648":729,"_16085":39129,"_5":15974,"_22319":38999,"_1957":39130},[],"A CA cannot issue certificates that outlive its own expiration date. Leave enough margin to renew or replace the authority without interrupting consumers.",{"_2384":779,"_23648":729,"_16085":39132,"_5":15974,"_22319":39003,"_1957":39133},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2384":780,"_23648":729,"_16085":39135,"_5":15974,"_22319":39003,"_1957":39136},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2384":781,"_23648":729,"_16085":39138,"_5":15974,"_22319":39007,"_1957":39139},[],"Importing preserves an authority created outside Lamassu.",{"_2384":782,"_23648":729,"_16085":39141,"_5":15974,"_22319":39011,"_1957":39142},[],"Choose the engine that will keep the imported key.",{"_2384":783,"_23648":729,"_16085":39144,"_5":15974,"_22319":39015,"_1957":39145},[],"Provide the CA certificate and the private key in PEM format. For a subordinate CA, optionally add the validation chain.",{"_2384":784,"_23648":729,"_16085":39147,"_5":15974,"_22319":39019,"_1957":39148},[],"Configure the validity that end-entity certificates will receive when a request does not specify another duration.",{"_2384":785,"_23648":729,"_16085":39150,"_5":15974,"_22319":39023,"_1957":39151},[],"Lamassu checks that the certificate belongs to a CA and that the material is coherent before registering it.",{"_2384":786,"_23648":729,"_16085":39153,"_5":15974,"_22319":39023,"_1957":39154},[],"If you don't have the private key, import only the certificate. The authority can take part in chains of trust and validation processes, but it cannot issue certificates from Lamassu.",{"_2384":787,"_23648":729,"_16085":39156,"_5":15974,"_22319":39027,"_1957":39157},[],"Open a CA from the inventory to review:",{"_2384":788,"_23648":729,"_16085":39159,"_5":15974,"_22319":39027,"_1957":39160},[],"Status and validity period.",{"_2384":789,"_23648":729,"_16085":39162,"_5":15974,"_22319":39027,"_1957":39163},[],"Certificate and chain in PEM format.",{"_2384":790,"_23648":729,"_16085":39165,"_5":15974,"_22319":39027,"_1957":39166},[],"Number of active, expired and revoked certificates.",{"_2384":791,"_23648":729,"_16085":39168,"_5":15974,"_22319":39027,"_1957":39169},[],"Certificates issued in **Issued Certificates**.",{"_2384":792,"_23648":729,"_16085":39171,"_5":15974,"_22319":39027,"_1957":39172},[],"The CRL linked to the authority.",{"_2384":793,"_23648":729,"_16085":39174,"_5":15974,"_22319":39027,"_1957":39175},[],"Metadata and the associated cryptographic engine.",{"_2384":794,"_23648":729,"_16085":39177,"_5":15974,"_22319":39027,"_1957":39178},[],"You can filter the inventory by name, status and CA type.",{"_2384":795,"_23648":729,"_16085":39180,"_5":15974,"_22319":39031,"_1957":39181},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2384":796,"_23648":729,"_16085":39183,"_5":15974,"_22319":39031,"_1957":39184},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2384":797,"_23648":729,"_16085":39186,"_5":15974,"_22319":39031,"_1957":39187},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2384":798,"_23648":729,"_16085":39189,"_5":15974,"_22319":39031,"_1957":39190},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2384":799,"_23648":729,"_16085":39192,"_5":15974,"_22319":39035,"_1957":39193},[],"Revoking a CA invalidates trust in the certificates it issued and can interrupt devices and services. The action is irreversible.",{"_2384":800,"_23648":729,"_16085":39195,"_5":15974,"_22319":39039,"_1957":39196},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2384":801,"_23648":729,"_16085":39198,"_5":15974,"_22319":39043,"_1957":39199},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2384":802,"_23648":729,"_16085":39201,"_5":15974,"_22319":39047,"_1957":39202},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2384":803,"_23648":729,"_16085":39204,"_5":15974,"_22319":39051,"_1957":39205},[],"The status should change to **REVOKED** and the CRL should reflect the new information. The CA can no longer issue certificates.",{"_2384":804,"_23648":729,"_16085":39207,"_5":15974,"_22319":39051,"_1957":39208},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2384":805,"_23648":805,"_5":10988,"_1957":39210,"_23928":39211,"_16085":39212,"_22319":805},"Certificate profiles",[36699,38037,38515],[],{"_2384":806,"_23648":805,"_16085":39214,"_5":15974,"_22319":805,"_1957":39215},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2384":807,"_23648":805,"_5":23925,"_16085":39217,"_22319":39218,"_1957":39219},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2384":808,"_23648":805,"_5":23925,"_16085":39221,"_22319":39222,"_1957":39223},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#validity","Validity",{"_2384":809,"_23648":805,"_5":23925,"_16085":39225,"_22319":39226,"_1957":39227},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2384":810,"_23648":805,"_5":23925,"_16085":39229,"_22319":39230,"_1957":39231},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2384":811,"_23648":805,"_5":23925,"_16085":39233,"_22319":39234,"_1957":39235},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#subject","Subject",{"_2384":812,"_23648":805,"_5":23925,"_16085":39237,"_22319":39238,"_1957":39239},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2384":813,"_23648":805,"_5":23925,"_16085":39241,"_22319":39242,"_1957":39243},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2384":814,"_23648":805,"_5":23925,"_16085":39245,"_22319":39246,"_1957":39247},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2384":815,"_23648":805,"_5":23925,"_16085":39249,"_22319":39250,"_1957":39251},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2384":816,"_23648":805,"_5":23925,"_16085":39253,"_22319":39254,"_1957":39255},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2384":817,"_23648":805,"_5":23925,"_16085":39257,"_22319":39258,"_1957":39259},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2384":818,"_23648":805,"_5":23925,"_16085":39261,"_22319":39262,"_1957":39263},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2384":819,"_23648":805,"_5":23925,"_16085":39265,"_22319":39266,"_1957":39267},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2384":820,"_23648":805,"_5":23925,"_16085":39269,"_22319":39270,"_1957":39271},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2384":821,"_23648":805,"_5":23925,"_16085":39273,"_22319":39274,"_1957":39275},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#design-examples","Design examples",{"_2384":822,"_23648":805,"_5":23925,"_16085":39277,"_22319":39278,"_1957":39279},[],"/docs/pr-preview/pr-26/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2384":823,"_23648":805,"_16085":39281,"_5":15974,"_22319":805,"_1957":39282},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2384":824,"_23648":805,"_16085":39284,"_5":15974,"_22319":39222,"_1957":39285},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2384":825,"_23648":805,"_16085":39287,"_5":15974,"_22319":39222,"_1957":39288},[],"The end date must never outlive the issuing CA.",{"_2384":826,"_23648":805,"_16085":39290,"_5":15974,"_22319":39226,"_1957":39291},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2384":827,"_23648":805,"_16085":39293,"_5":15974,"_22319":39230,"_1957":39294},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2384":828,"_23648":805,"_16085":39296,"_5":15974,"_22319":39230,"_1957":39297},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2384":829,"_23648":805,"_16085":39299,"_5":15974,"_22319":39230,"_1957":39300},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2384":830,"_23648":805,"_16085":39302,"_5":15974,"_22319":39234,"_1957":39303},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2384":831,"_23648":805,"_16085":39305,"_5":15974,"_22319":39238,"_1957":39306},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2384":832,"_23648":805,"_16085":39308,"_5":15974,"_22319":39238,"_1957":39309},[],"This behavior allows accepting DNS, IP, email or URI as alternative identities without accepting arbitrary extensions.",{"_2384":833,"_23648":805,"_16085":39311,"_5":15974,"_22319":39242,"_1957":39312},[],"The cryptographic enforcement can:",{"_2384":834,"_23648":805,"_16085":39314,"_5":15974,"_22319":39242,"_1957":39315},[],"allow or block RSA keys;",{"_2384":835,"_23648":805,"_16085":39317,"_5":15974,"_22319":39242,"_1957":39318},[],"limit the supported RSA sizes;",{"_2384":836,"_23648":805,"_16085":39320,"_5":15974,"_22319":39242,"_1957":39321},[],"allow or block ECDSA keys;",{"_2384":837,"_23648":805,"_16085":39323,"_5":15974,"_22319":39242,"_1957":39324},[],"limit the supported ECDSA sizes or curves.",{"_2384":838,"_23648":805,"_16085":39326,"_5":15974,"_22319":39242,"_1957":39327},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2384":839,"_23648":805,"_16085":39329,"_5":15974,"_22319":39246,"_1957":39330},[],"In operations that accept multiple sources, Lamassu resolves the profile in this order:",{"_2384":840,"_23648":805,"_16085":39332,"_5":15974,"_22319":39246,"_1957":39333},[],"The profile sent within the operation.",{"_2384":841,"_23648":805,"_16085":39335,"_5":15974,"_22319":39246,"_1957":39336},[],"The profile identifier sent in the operation.",{"_2384":842,"_23648":805,"_16085":39338,"_5":15974,"_22319":39246,"_1957":39339},[],"The default profile associated with the CA.",{"_2384":843,"_23648":805,"_16085":39341,"_5":15974,"_22319":39246,"_1957":39342},[],"A DMS can also reference its own issuance profile. This way, several fleets can use the same CA with different policies.",{"_2384":844,"_23648":805,"_16085":39344,"_5":15974,"_22319":39254,"_1957":39345},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2384":845,"_23648":805,"_16085":39347,"_5":15974,"_22319":39258,"_1957":39348},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2384":846,"_23648":805,"_16085":39350,"_5":15974,"_22319":39262,"_1957":39351},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2384":847,"_23648":805,"_16085":39353,"_5":15974,"_22319":39266,"_1957":39354},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2384":848,"_23648":805,"_16085":39356,"_5":15974,"_22319":39270,"_1957":39357},[],"Attach the profile to a CA or DMS. Issue a test certificate and check subject, SAN, KU, EKU, basic constraints and dates with an independent X.509 tool.",{"_2384":849,"_23648":805,"_16085":39359,"_5":15974,"_22319":39274,"_1957":39360},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2384":850,"_23648":805,"_16085":39362,"_5":15974,"_22319":39274,"_1957":39363},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2384":851,"_23648":805,"_16085":39365,"_5":15974,"_22319":39274,"_1957":39366},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2384":852,"_23648":805,"_16085":39368,"_5":15974,"_22319":39274,"_1957":39369},[],"These are starting patterns, not a universal policy. Always verify the requirements of the protocol, the consumer and the applicable regulatory framework.",{"_2384":853,"_23648":805,"_16085":39371,"_5":15974,"_22319":39278,"_1957":39372},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2384":854,"_23648":805,"_16085":39374,"_5":15974,"_22319":39278,"_1957":39375},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2384":855,"_23648":855,"_5":10988,"_1957":39377,"_23928":39378,"_16085":39379,"_22319":855},"Certificate validation",[36699,38037,38515],[],{"_2384":856,"_23648":855,"_16085":39381,"_5":15974,"_22319":855,"_1957":39382},[],"Publish the status of identities through OCSP and CRL.",{"_2384":857,"_23648":855,"_5":23925,"_16085":39384,"_22319":39385,"_1957":39386},[],"/docs/pr-preview/pr-26/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2384":858,"_23648":855,"_16085":39388,"_5":15974,"_22319":855,"_1957":39389},[],"Issuance proves who signed a certificate; validation tells you whether it should still be accepted. Lamassu publishes status through two complementary mechanisms.",{"_2384":859,"_23648":855,"_16085":39391,"_5":15974,"_22319":39385,"_1957":39392},[],"Use **OCSP** when the consumer is online and needs to check the latest status of a specific certificate.",{"_2384":860,"_23648":855,"_16085":39394,"_5":15974,"_22319":39385,"_1957":39395},[],"Use a **CRL** when validation must happen locally, offline or over a high volume of certificates. The consumer periodically downloads a signed list and keeps it until the next update.",{"_2384":861,"_23648":855,"_16085":39397,"_5":15974,"_22319":39385,"_1957":39398},[],"Many environments use both: OCSP as the primary check and a CRL as the local or fallback mechanism.",{"_2384":862,"_23648":855,"_16085":39400,"_5":15974,"_22319":39385,"_1957":39401},[],"<Card title=\"Online validation with OCSP\" description=\"Query Good, Revoked and Unknown statuses in real time.\" href=\"/docs/platform/pki/ocsp\" />",{"_2384":863,"_23648":855,"_16085":39403,"_5":15974,"_22319":39385,"_1957":39404},[],"<Card title=\"Revocation lists\" description=\"Generate, publish and distribute CRLs per authority.\" href=\"/docs/platform/pki/crl\" />",{"_2384":864,"_23648":864,"_5":10988,"_1957":39406,"_23928":39407,"_16085":39408,"_22319":864},"Certificates",[36699,38037,38515],[],{"_2384":865,"_23648":864,"_16085":39410,"_5":15974,"_22319":864,"_1957":39411},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2384":866,"_23648":864,"_5":23925,"_16085":39413,"_22319":39414,"_1957":39415},[],"/docs/pr-preview/pr-26/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2384":867,"_23648":864,"_5":23925,"_16085":39417,"_22319":39418,"_1957":39419},[],"/docs/pr-preview/pr-26/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2384":868,"_23648":864,"_5":23925,"_16085":39421,"_22319":39422,"_1957":39423},[],"/docs/pr-preview/pr-26/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2384":869,"_23648":864,"_5":23925,"_16085":39425,"_22319":39426,"_1957":39427},[],"/docs/pr-preview/pr-26/platform/pki/certificates#open-the-action","Open the action",{"_2384":870,"_23648":864,"_5":23925,"_16085":39429,"_22319":39430,"_1957":39431},[],"/docs/pr-preview/pr-26/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2384":871,"_23648":864,"_5":23925,"_16085":39433,"_22319":39434,"_1957":39435},[],"/docs/pr-preview/pr-26/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2384":872,"_23648":864,"_5":23925,"_16085":39437,"_22319":39438,"_1957":39439},[],"/docs/pr-preview/pr-26/platform/pki/certificates#continue","Continue",{"_2384":873,"_23648":864,"_16085":39441,"_5":15974,"_22319":864,"_1957":39442},[],"The certificate inventory offers a global view of the identities issued by all authorities. You can also open **Issued Certificates** inside a CA to limit the view to that issuer.",{"_2384":874,"_23648":864,"_16085":39444,"_5":15974,"_22319":39414,"_1957":39445},[],"Open **Certificates** and filter by:",{"_2384":875,"_23648":864,"_16085":39447,"_5":15974,"_22319":39414,"_1957":39448},[],"Subject's `Common Name`.",{"_2384":876,"_23648":864,"_16085":39450,"_5":15974,"_22319":39414,"_1957":39451},[],"Serial number.",{"_2384":877,"_23648":864,"_16085":39453,"_5":15974,"_22319":39414,"_1957":39454},[],"Status.",{"_2384":878,"_23648":864,"_16085":39456,"_5":15974,"_22319":39414,"_1957":39457},[],"Issuing authority.",{"_2384":879,"_23648":864,"_16085":39459,"_5":15974,"_22319":39414,"_1957":39460},[],"Use **Quick Inspect** for a quick check or **View Details** to see the subject, SANs, usages, chain, validity period and full metadata.",{"_2384":880,"_23648":864,"_16085":39462,"_5":15974,"_22319":39418,"_1957":39463},[],"The download action delivers the certificate in PEM format. If the certificate was issued from an external CSR, the private key stays on the system that generated that CSR. If it was generated in the browser, the key was only available when the issuance finished.",{"_2384":881,"_23648":864,"_16085":39465,"_5":15974,"_22319":39422,"_1957":39466},[],"Revoke an identity when the key has been compromised, the subject is no longer authorized or the certificate must stop being accepted before it expires.",{"_2384":882,"_23648":864,"_16085":39468,"_5":15974,"_22319":39426,"_1957":39469},[],"In the inventory or detail view, select **Revoke Certificate**.",{"_2384":883,"_23648":864,"_16085":39471,"_5":15974,"_22319":39430,"_1957":39472},[],"Select the reason that represents the incident. This information is published in OCSP and in the CRL.",{"_2384":884,"_23648":864,"_16085":39474,"_5":15974,"_22319":39434,"_1957":39475},[],"Confirm the operation and check that the status is **Revoked**. If the CA regenerates the CRL upon revocation, also verify that a new version exists.",{"_2384":885,"_23648":864,"_16085":39477,"_5":15974,"_22319":39434,"_1957":39478},[],"A revocation with the reason `CertificateHold` can be reactivated. All other reasons produce a final revocation.",{"_2384":886,"_23648":864,"_16085":39480,"_5":15974,"_22319":39438,"_1957":39481},[],"<Card title=\"Validate with OCSP\" description=\"Query the status of a certificate in real time.\" href=\"/docs/platform/pki/ocsp\" />",{"_2384":887,"_23648":864,"_16085":39483,"_5":15974,"_22319":39438,"_1957":39484},[],"<Card title=\"Distribute a CRL\" description=\"Publish the status for offline validation.\" href=\"/docs/platform/pki/crl\" />",{"_2384":888,"_23648":888,"_5":10988,"_1957":39486,"_23928":39487,"_16085":39489,"_22319":888},"Platform architecture",[36699,38037,39488],"Concepts",[],{"_2384":889,"_23648":888,"_16085":39491,"_5":15974,"_22319":888,"_1957":39492},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2384":890,"_23648":888,"_5":23925,"_16085":39494,"_22319":39495,"_1957":39496},[],"/docs/pr-preview/pr-26/platform/pki/concepts/architecture#control-plane","Control plane",{"_2384":891,"_23648":888,"_5":23925,"_16085":39498,"_22319":39499,"_1957":39500},[],"/docs/pr-preview/pr-26/platform/pki/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2384":892,"_23648":888,"_5":23925,"_16085":39502,"_22319":39503,"_1957":39504},[],"/docs/pr-preview/pr-26/platform/pki/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2384":893,"_23648":888,"_5":23925,"_16085":39506,"_22319":39507,"_1957":39508},[],"/docs/pr-preview/pr-26/platform/pki/concepts/architecture#status-and-validation","Status and validation",{"_2384":894,"_23648":888,"_5":23925,"_16085":39510,"_22319":39511,"_1957":39512},[],"/docs/pr-preview/pr-26/platform/pki/concepts/architecture#platform-dependencies","Platform dependencies",{"_2384":895,"_23648":888,"_16085":39514,"_5":15974,"_22319":888,"_1957":39515},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2384":896,"_23648":888,"_16085":39517,"_5":15974,"_22319":888,"_1957":39518},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2384":897,"_23648":888,"_16085":39520,"_5":15974,"_22319":39495,"_1957":39521},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2384":898,"_23648":888,"_16085":39523,"_5":15974,"_22319":39499,"_1957":39524},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2384":899,"_23648":888,"_16085":39526,"_5":15974,"_22319":39503,"_1957":39527},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2384":900,"_23648":888,"_16085":39529,"_5":15974,"_22319":39507,"_1957":39530},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2384":901,"_23648":888,"_16085":39532,"_5":15974,"_22319":39511,"_1957":39533},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2384":902,"_23648":902,"_5":10988,"_1957":39535,"_23928":39536,"_16085":39537,"_22319":902},"Certificate lifecycle",[36699,38037,39488],[],{"_2384":903,"_23648":902,"_16085":39539,"_5":15974,"_22319":902,"_1957":39540},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2384":904,"_23648":902,"_5":23925,"_16085":39542,"_22319":39543,"_1957":39544},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2384":905,"_23648":902,"_5":23925,"_16085":39546,"_22319":39547,"_1957":39548},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2384":906,"_23648":902,"_5":23925,"_16085":39550,"_22319":39551,"_1957":39552},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2384":907,"_23648":902,"_5":23925,"_16085":39554,"_22319":39555,"_1957":39556},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2384":908,"_23648":902,"_5":23925,"_16085":39558,"_22319":39559,"_1957":39560},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2384":909,"_23648":902,"_5":23925,"_16085":39562,"_22319":39563,"_1957":39564},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2384":910,"_23648":902,"_5":23925,"_16085":39566,"_22319":39567,"_1957":39568},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2384":911,"_23648":902,"_5":23925,"_16085":39570,"_22319":39571,"_1957":39572},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2384":912,"_23648":902,"_5":23925,"_16085":39574,"_22319":39575,"_1957":39576},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2384":913,"_23648":902,"_5":23925,"_16085":39578,"_22319":39579,"_1957":39580},[],"/docs/pr-preview/pr-26/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2384":914,"_23648":902,"_16085":39582,"_5":15974,"_22319":902,"_1957":39583},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2384":915,"_23648":902,"_16085":39585,"_5":15974,"_22319":39547,"_1957":39586},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2384":916,"_23648":902,"_16085":39588,"_5":15974,"_22319":39551,"_1957":39589},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2384":917,"_23648":902,"_16085":39591,"_5":15974,"_22319":39555,"_1957":39592},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2384":918,"_23648":902,"_16085":39594,"_5":15974,"_22319":39559,"_1957":39595},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2384":919,"_23648":902,"_16085":39597,"_5":15974,"_22319":39563,"_1957":39598},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2384":920,"_23648":902,"_16085":39600,"_5":15974,"_22319":39567,"_1957":39601},[],"Lamassu persists four X.509 states:",{"_2384":921,"_23648":902,"_16085":39603,"_5":15974,"_22319":39567,"_1957":39604},[],"**`ACTIVE`**: the certificate is enabled and within its validity period.",{"_2384":922,"_23648":902,"_16085":39606,"_5":15974,"_22319":39567,"_1957":39607},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2384":923,"_23648":902,"_16085":39609,"_5":15974,"_22319":39567,"_1957":39610},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2384":924,"_23648":902,"_16085":39612,"_5":15974,"_22319":39567,"_1957":39613},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2384":925,"_23648":902,"_16085":39615,"_5":15974,"_22319":39567,"_1957":39616},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2384":926,"_23648":902,"_16085":39618,"_5":15974,"_22319":39571,"_1957":39619},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2384":927,"_23648":902,"_16085":39621,"_5":15974,"_22319":39571,"_1957":39622},[],"Only a revocation with the reason `CertificateHold` can be undone. A revocation with any other reason is final in Lamassu.",{"_2384":928,"_23648":902,"_16085":39624,"_5":15974,"_22319":39571,"_1957":39625},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2384":929,"_23648":902,"_16085":39627,"_5":15974,"_22319":39575,"_1957":39628},[],"Revoking a CA is a cascading operation. Lamassu revokes its child CAs and the certificates it issued, with the reason `CessationOfOperation`. The propagation continues down the hierarchy.",{"_2384":930,"_23648":902,"_16085":39630,"_5":15974,"_22319":39575,"_1957":39631},[],"Before confirming:",{"_2384":931,"_23648":902,"_16085":39633,"_5":15974,"_22319":39575,"_1957":39634},[],"Identify DMSs, devices and services that trust that chain.",{"_2384":932,"_23648":902,"_16085":39636,"_5":15974,"_22319":39575,"_1957":39637},[],"Distribute the new chain of trust.",{"_2384":933,"_23648":902,"_16085":39639,"_5":15974,"_22319":39575,"_1957":39640},[],"Reissue the necessary identities.",{"_2384":934,"_23648":902,"_16085":39642,"_5":15974,"_22319":39575,"_1957":39643},[],"Check OCSP and CRL from a real consumer.",{"_2384":935,"_23648":902,"_16085":39645,"_5":15974,"_22319":39575,"_1957":39646},[],"Revoke the old CA once no legitimate traffic remains.",{"_2384":936,"_23648":902,"_16085":39648,"_5":15974,"_22319":39575,"_1957":39649},[],"Decommissioning a device revokes its certificates and prevents it from obtaining new identities. Use this action only when the device is being retired permanently.",{"_2384":937,"_23648":902,"_16085":39651,"_5":15974,"_22319":39579,"_1957":39652},[],"Certificates entering the preventive or critical renewal window.",{"_2384":938,"_23648":902,"_16085":39654,"_5":15974,"_22319":39579,"_1957":39655},[],"Repeated enrollment or re-enrollment failures.",{"_2384":939,"_23648":902,"_16085":39657,"_5":15974,"_22319":39579,"_1957":39658},[],"Status changes and revocation reasons.",{"_2384":940,"_23648":902,"_16085":39660,"_5":15974,"_22319":39579,"_1957":39661},[],"OCSP and CRL publication and validity.",{"_2384":941,"_23648":902,"_16085":39663,"_5":15974,"_22319":39579,"_1957":39664},[],"Dependencies still presenting a replaced certificate.",{"_2384":942,"_23648":902,"_16085":39666,"_5":15974,"_22319":39579,"_1957":39667},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2384":943,"_23648":943,"_5":10988,"_1957":39669,"_23928":39670,"_16085":39671,"_22319":943},"Glossary",[36699,38037,39488],[],{"_2384":944,"_23648":943,"_16085":39673,"_5":15974,"_22319":943,"_1957":39674},[],"PKI, certificate and identity management terms used in Lamassu.",{"_2384":945,"_23648":943,"_5":23925,"_16085":39676,"_22319":39677,"_1957":39678},[],"/docs/pr-preview/pr-26/platform/pki/concepts/glossary#ac","A–C",{"_2384":946,"_23648":943,"_5":23925,"_16085":39680,"_22319":39681,"_1957":39682},[],"/docs/pr-preview/pr-26/platform/pki/concepts/glossary#dk","D–K",{"_2384":947,"_23648":943,"_5":23925,"_16085":39684,"_22319":39685,"_1957":39686},[],"/docs/pr-preview/pr-26/platform/pki/concepts/glossary#mr","M–R",{"_2384":948,"_23648":943,"_5":23925,"_16085":39688,"_22319":39689,"_1957":39690},[],"/docs/pr-preview/pr-26/platform/pki/concepts/glossary#sz","S–Z",{"_2384":949,"_23648":943,"_16085":39692,"_5":15974,"_22319":39677,"_1957":39693},[],"**AKI (Authority Key Identifier)**\\\nIdentifier of the public key of the authority that signed a certificate. It helps build the chain toward the correct issuer.",{"_2384":950,"_23648":943,"_16085":39695,"_5":15974,"_22319":39677,"_1957":39696},[],"**Anchor of trust**\\\nA certificate, usually from a root CA, that a consumer explicitly accepts as the endpoint of a chain.",{"_2384":951,"_23648":943,"_16085":39698,"_5":15974,"_22319":39677,"_1957":39699},[],"**CA (Certification Authority)**\\\nAuthority that signs certificates and binds an identity to a public key.",{"_2384":952,"_23648":943,"_16085":39701,"_5":15974,"_22319":39677,"_1957":39702},[],"**Intermediate CA**\\\nA CA signed by another authority. Used to issue without exposing the root to daily operation.",{"_2384":953,"_23648":943,"_16085":39704,"_5":15974,"_22319":39677,"_1957":39705},[],"**Root CA**\\\nA self-signed CA that starts a hierarchy of trust.",{"_2384":954,"_23648":943,"_16085":39707,"_5":15974,"_22319":39677,"_1957":39708},[],"**X.509 certificate**\\\nA signed document containing a public key, a subject, an issuer, a validity period and extensions that constrain its use.",{"_2384":955,"_23648":943,"_16085":39710,"_5":15974,"_22319":39677,"_1957":39711},[],"**CRL (Certificate Revocation List)**\\\nSigned list of revoked certificates published by a CA.",{"_2384":956,"_23648":943,"_16085":39713,"_5":15974,"_22319":39677,"_1957":39714},[],"**CSR (Certificate Signing Request)**\\\nPKCS#10 request containing a public key and requested attributes. Signing the CSR proves possession of the corresponding private key.",{"_2384":957,"_23648":943,"_16085":39716,"_5":15974,"_22319":39681,"_1957":39717},[],"**DMS (Device Management Service)**\\\nConfiguration that groups registration, enrollment, re-enrollment, issuance and CA distribution rules for a fleet.",{"_2384":958,"_23648":943,"_16085":39719,"_5":15974,"_22319":39681,"_1957":39720},[],"**Distinguished Name (DN)**\\\nSet of subject or issuer attributes, such as `CN`, `O`, `OU`, `C`, `ST` and `L`.",{"_2384":959,"_23648":943,"_16085":39722,"_5":15974,"_22319":39681,"_1957":39723},[],"**EST (Enrollment over Secure Transport)**\\\nProtocol defined in RFC 7030 to obtain CAs, enroll and re-enroll certificates over HTTPS.",{"_2384":960,"_23648":943,"_16085":39725,"_5":15974,"_22319":39681,"_1957":39726},[],"**Extended Key Usage (EKU)**\\\nExtension that constrains purposes such as client authentication, server authentication, code signing or OCSP.",{"_2384":961,"_23648":943,"_16085":39728,"_5":15974,"_22319":39681,"_1957":39729},[],"**Device identity**\\\nRelationship between a device and one of its certificates. A device can keep a history of identities.",{"_2384":962,"_23648":943,"_16085":39731,"_5":15974,"_22319":39681,"_1957":39732},[],"**Identity slot**\\\nLogical position on a device where Lamassu binds an active or historical identity.",{"_2384":963,"_23648":943,"_16085":39734,"_5":15974,"_22319":39681,"_1957":39735},[],"**JITP (Just-in-Time Provisioning)**\\\nAutomatic registration of a device when it successfully completes its first enrollment.",{"_2384":964,"_23648":943,"_16085":39737,"_5":15974,"_22319":39681,"_1957":39738},[],"**KMS (Key Management Service)**\\\nLamassu service that normalizes key generation, import and use across different cryptographic engines.",{"_2384":965,"_23648":943,"_16085":39740,"_5":15974,"_22319":39681,"_1957":39741},[],"**Key Usage**\\\nX.509 extension that allows basic operations such as digital signature, key encryption or certificate signing.",{"_2384":966,"_23648":943,"_16085":39743,"_5":15974,"_22319":39685,"_1957":39744},[],"**mTLS (Mutual TLS)**\\\nTLS where both client and server present certificates. A DMS can use the client certificate as an authentication method.",{"_2384":967,"_23648":943,"_16085":39746,"_5":15974,"_22319":39685,"_1957":39747},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocol for querying online whether a certificate is valid, revoked or unknown.",{"_2384":968,"_23648":943,"_16085":39749,"_5":15974,"_22319":39685,"_1957":39750},[],"**Issuance profile**\\\nReusable policy that defines how Lamassu builds a certificate and which keys it accepts.",{"_2384":969,"_23648":943,"_16085":39752,"_5":15974,"_22319":39685,"_1957":39753},[],"**Principal**\\\nOperator or API client identity recognized by the authorization service. Lamassu supports OIDC and X.509 principals.",{"_2384":970,"_23648":943,"_16085":39755,"_5":15974,"_22319":39685,"_1957":39756},[],"**Policy**\\\nSet of permissions assignable to one or more principals.",{"_2384":971,"_23648":943,"_16085":39758,"_5":15974,"_22319":39685,"_1957":39759},[],"**RA (Registration Authority)**\\\nComponent that verifies the requester before asking a CA to issue. The DMS plays this role in device enrollment flows.",{"_2384":972,"_23648":943,"_16085":39761,"_5":15974,"_22319":39685,"_1957":39762},[],"**Relying party**\\\nConsuming system that decides whether to accept a presented certificate.",{"_2384":973,"_23648":943,"_16085":39764,"_5":15974,"_22319":39685,"_1957":39765},[],"**Revocation**\\\nInvalidation of a certificate before its expiration date.",{"_2384":974,"_23648":943,"_16085":39767,"_5":15974,"_22319":39689,"_1957":39768},[],"**SAN (Subject Alternative Name)**\\\nExtension that adds identities such as DNS names, IP addresses, emails or URIs.",{"_2384":975,"_23648":943,"_16085":39770,"_5":15974,"_22319":39689,"_1957":39771},[],"**SKI (Subject Key Identifier)**\\\nIdentifier derived from the public key of the certificate itself.",{"_2384":976,"_23648":943,"_16085":39773,"_5":15974,"_22319":39689,"_1957":39774},[],"**VA (Validation Authority)**\\\nLamassu service responsible for OCSP responses and the generation or publication of CRLs.",{"_2384":977,"_23648":943,"_16085":39776,"_5":15974,"_22319":39689,"_1957":39777},[],"**Renewal window**\\\nPeriod before expiration during which a device may or must request another identity.",{"_2384":978,"_23648":943,"_16085":39779,"_5":15974,"_22319":39689,"_1957":39780},[],"Missing an operational term? Check How Lamassu works and the Trust model first, where these concepts appear connected.",{"_2384":979,"_23648":979,"_5":10988,"_1957":39782,"_23928":39783,"_16085":39784,"_22319":979},"How Lamassu works",[36699,38037,39488],[],{"_2384":980,"_23648":979,"_16085":39786,"_5":15974,"_22319":979,"_1957":39787},[],"The mental model of trust, keys, certificates and devices.",{"_2384":981,"_23648":979,"_5":23925,"_16085":39789,"_22319":39790,"_1957":39791},[],"/docs/pr-preview/pr-26/platform/pki/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2384":982,"_23648":979,"_5":23925,"_16085":39793,"_22319":39794,"_1957":39795},[],"/docs/pr-preview/pr-26/platform/pki/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2384":983,"_23648":979,"_16085":39797,"_5":15974,"_22319":979,"_1957":39798},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2384":984,"_23648":979,"_16085":39800,"_5":15974,"_22319":39790,"_1957":39801},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2384":985,"_23648":979,"_16085":39803,"_5":15974,"_22319":39790,"_1957":39804},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2384":986,"_23648":979,"_16085":39806,"_5":15974,"_22319":39790,"_1957":39807},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2384":987,"_23648":979,"_16085":39809,"_5":15974,"_22319":39790,"_1957":39810},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2384":988,"_23648":979,"_16085":39812,"_5":15974,"_22319":39790,"_1957":39813},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2384":989,"_23648":979,"_16085":39815,"_5":15974,"_22319":39794,"_1957":39816},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2384":990,"_23648":979,"_16085":39818,"_5":15974,"_22319":39794,"_1957":39819},[],"A DMS relates that CA to an enrollment policy.",{"_2384":991,"_23648":979,"_16085":39821,"_5":15974,"_22319":39794,"_1957":39822},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2384":992,"_23648":979,"_16085":39824,"_5":15974,"_22319":39794,"_1957":39825},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2384":993,"_23648":979,"_16085":39827,"_5":15974,"_22319":39794,"_1957":39828},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2384":994,"_23648":979,"_16085":39830,"_5":15974,"_22319":39794,"_1957":39831},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_2384":995,"_23648":979,"_16085":39833,"_5":15974,"_22319":39794,"_1957":39834},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2384":996,"_23648":996,"_5":10988,"_1957":39836,"_23928":39837,"_16085":39838,"_22319":996},"Trust model",[36699,38037,39488],[],{"_2384":997,"_23648":996,"_16085":39840,"_5":15974,"_22319":996,"_1957":39841},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2384":998,"_23648":996,"_5":23925,"_16085":39843,"_22319":39844,"_1957":39845},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2384":999,"_23648":996,"_5":23925,"_16085":39847,"_22319":39848,"_1957":39849},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2384":1000,"_23648":996,"_5":23925,"_16085":39851,"_22319":39852,"_1957":39853},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2384":1001,"_23648":996,"_5":23925,"_16085":39855,"_22319":39856,"_1957":39857},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2384":1002,"_23648":996,"_5":23925,"_16085":39859,"_22319":39860,"_1957":39861},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2384":1003,"_23648":996,"_5":23925,"_16085":39863,"_22319":39864,"_1957":39865},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2384":1004,"_23648":996,"_5":23925,"_16085":39867,"_22319":39868,"_1957":39869},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2384":1005,"_23648":996,"_5":23925,"_16085":39871,"_22319":39872,"_1957":39873},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2384":1006,"_23648":996,"_5":23925,"_16085":39875,"_22319":39876,"_1957":39877},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2384":1007,"_23648":996,"_5":23925,"_16085":39879,"_22319":39880,"_1957":39881},[],"/docs/pr-preview/pr-26/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2384":1008,"_23648":996,"_16085":39883,"_5":15974,"_22319":996,"_1957":39884},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2384":1009,"_23648":996,"_16085":39886,"_5":15974,"_22319":39848,"_1957":39887},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2384":1010,"_23648":996,"_16085":39889,"_5":15974,"_22319":39852,"_1957":39890},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2384":1011,"_23648":996,"_16085":39892,"_5":15974,"_22319":39856,"_1957":39893},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2384":1012,"_23648":996,"_16085":39895,"_5":15974,"_22319":39860,"_1957":39896},[],"The consuming service or device keeps its own trust store. Lamassu can distribute the system CA, the enrollment CA and other managed CAs through `/cacerts`, but the consumer decides which ones it installs and how it applies validation.",{"_2384":1013,"_23648":996,"_16085":39898,"_5":15974,"_22319":39864,"_1957":39899},[],"The device proves it can enroll according to the DMS policy.",{"_2384":1014,"_23648":996,"_16085":39901,"_5":15974,"_22319":39864,"_1957":39902},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2384":1015,"_23648":996,"_16085":39904,"_5":15974,"_22319":39864,"_1957":39905},[],"The CA applies the profile and signs without ever receiving the device's private key.",{"_2384":1016,"_23648":996,"_16085":39907,"_5":15974,"_22319":39864,"_1957":39908},[],"The device installs the certificate and the chain it needs.",{"_2384":1017,"_23648":996,"_16085":39910,"_5":15974,"_22319":39864,"_1957":39911},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2384":1018,"_23648":996,"_16085":39913,"_5":15974,"_22319":39864,"_1957":39914},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2384":1019,"_23648":996,"_16085":39916,"_5":15974,"_22319":39868,"_1957":39917},[],"A DMS relates three sets that are worth designing separately:",{"_2384":1020,"_23648":996,"_16085":39919,"_5":15974,"_22319":39868,"_1957":39920},[],"**Enrollment CA:** signs the new identities.",{"_2384":1021,"_23648":996,"_16085":39922,"_5":15974,"_22319":39868,"_1957":39923},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2384":1022,"_23648":996,"_16085":39925,"_5":15974,"_22319":39868,"_1957":39926},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the system CA, the enrollment CA and a list of managed CAs.",{"_2384":1023,"_23648":996,"_16085":39928,"_5":15974,"_22319":39868,"_1957":39929},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2384":1024,"_23648":996,"_16085":39931,"_5":15974,"_22319":39872,"_1957":39932},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2384":1025,"_23648":996,"_16085":39934,"_5":15974,"_22319":39872,"_1957":39935},[],"that the current date is between `Not Before` and `Not After`;",{"_2384":1026,"_23648":996,"_16085":39937,"_5":15974,"_22319":39872,"_1957":39938},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2384":1027,"_23648":996,"_16085":39940,"_5":15974,"_22319":39872,"_1957":39941},[],"that names, SANs and subject match the expected identity;",{"_2384":1028,"_23648":996,"_16085":39943,"_5":15974,"_22319":39872,"_1957":39944},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2384":1029,"_23648":996,"_16085":39946,"_5":15974,"_22319":39872,"_1957":39947},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2384":1030,"_23648":996,"_16085":39949,"_5":15974,"_22319":39876,"_1957":39950},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2384":1031,"_23648":996,"_16085":39952,"_5":15974,"_22319":39880,"_1957":39953},[],"Keep the root out of daily operations, or with very restricted access.",{"_2384":1032,"_23648":996,"_16085":39955,"_5":15974,"_22319":39880,"_1957":39956},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2384":1033,"_23648":996,"_16085":39958,"_5":15974,"_22319":39880,"_1957":39959},[],"Assign explicit profiles to every use case.",{"_2384":1034,"_23648":996,"_16085":39961,"_5":15974,"_22319":39880,"_1957":39962},[],"Distribute the new trust before starting a rotation.",{"_2384":1035,"_23648":996,"_16085":39964,"_5":15974,"_22319":39880,"_1957":39965},[],"Keep enough overlap to renew a disconnected fleet.",{"_2384":1036,"_23648":996,"_16085":39967,"_5":15974,"_22319":39880,"_1957":39968},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2384":1037,"_23648":996,"_16085":39970,"_5":15974,"_22319":39880,"_1957":39971},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2384":1038,"_23648":1038,"_5":10988,"_1957":39973,"_23928":39974,"_16085":39975,"_22319":1038},"Revocation lists (CRL)",[36699,38037,38515],[],{"_2384":1039,"_23648":1038,"_16085":39977,"_5":15974,"_22319":1038,"_1957":39978},[],"Generate and distribute signed lists to validate certificates offline.",{"_2384":1040,"_23648":1038,"_5":23925,"_16085":39980,"_22319":39981,"_1957":39982},[],"/docs/pr-preview/pr-26/platform/pki/crl#crl-service","CRL service",{"_2384":1041,"_23648":1038,"_5":23925,"_16085":39984,"_22319":39985,"_1957":39986},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2384":1042,"_23648":1038,"_5":23925,"_16085":39988,"_22319":39989,"_1957":39990},[],"/docs/pr-preview/pr-26/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2384":1043,"_23648":1038,"_5":23925,"_16085":39992,"_22319":39993,"_1957":39994},[],"/docs/pr-preview/pr-26/platform/pki/crl#crl-contents","CRL contents",{"_2384":1044,"_23648":1038,"_5":23925,"_16085":39996,"_22319":39997,"_1957":39998},[],"/docs/pr-preview/pr-26/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2384":1045,"_23648":1038,"_5":23925,"_16085":40000,"_22319":40001,"_1957":40002},[],"/docs/pr-preview/pr-26/platform/pki/crl#va-role-management-api","VA role management API",{"_2384":1046,"_23648":1038,"_5":23925,"_16085":40004,"_22319":40005,"_1957":40006},[],"/docs/pr-preview/pr-26/platform/pki/crl#from-the-interface","From the interface",{"_2384":1047,"_23648":1038,"_5":23925,"_16085":40008,"_22319":40009,"_1957":40010},[],"/docs/pr-preview/pr-26/platform/pki/crl#references","References",{"_2384":1048,"_23648":1038,"_16085":40012,"_5":15974,"_22319":39981,"_1957":40013},[],"A CRL (*Certificate Revocation List*) is a signed list containing the serial numbers of certificates revoked before their expiration date. Unlike OCSP, it does not require a real-time query: the relying party downloads the list periodically and consults it locally.",{"_2384":1049,"_23648":1038,"_16085":40015,"_5":15974,"_22319":39981,"_1957":40016},[],"Lamassu generates and maintains one CRL per CA it manages. Each CRL is signed with the private key of the issuing CA itself and is stored in the object storage configured on the platform.",{"_2384":1050,"_23648":1038,"_16085":40018,"_5":15974,"_22319":39985,"_1957":40019},[],"The publication of each CA's CRL is controlled by a *VA role*. This object defines how it is generated, when it is regenerated and which key signs it.",{"_2384":1051,"_23648":1038,"_16085":40021,"_5":15974,"_22319":39985,"_1957":40022},[],"The main parameters are:",{"_2384":1052,"_23648":1038,"_16085":40024,"_5":15974,"_22319":39985,"_1957":40025},[],"**`validity`** defines the validity period reflected in `nextUpdate`. Its default value is 7 days.",{"_2384":1053,"_23648":1038,"_16085":40027,"_5":15974,"_22319":39985,"_1957":40028},[],"**`refresh_interval`** sets the minimum interval between scheduled regenerations. By default it is approximately 6 days and 23 hours.",{"_2384":1054,"_23648":1038,"_16085":40030,"_5":15974,"_22319":39985,"_1957":40031},[],"**`regenerate_on_revoke`** orders publishing a new version immediately after a revocation. It is enabled by default.",{"_2384":1055,"_23648":1038,"_16085":40033,"_5":15974,"_22319":39985,"_1957":40034},[],"The `subject_key_id_signer` field identifies the CA whose private key signs the CRL. By default, each CA signs its own CRL.",{"_2384":1056,"_23648":1038,"_16085":40036,"_5":15974,"_22319":39985,"_1957":40037},[],"Each CRL carries an incremental version number. Lamassu stores all versions under the path `pki/va/crl/{subject_key_id}/{version}.crl` in object storage.",{"_2384":1057,"_23648":1038,"_16085":40039,"_5":15974,"_22319":39989,"_1957":40040},[],"A background process monitors active VA roles. When the remaining validity of the current CRL falls below the configured watch period (*blind period*), the system requests the generation of a new CRL. This prevents the published CRL from expiring without a valid version available.",{"_2384":1058,"_23648":1038,"_16085":40042,"_5":15974,"_22319":39989,"_1957":40043},[],"Additionally, when `regenerate_on_revoke` is enabled, which is the default behavior, any certificate revocation immediately triggers the generation of a new CRL for the affected CA. This minimizes the time between revocation and its publication.",{"_2384":1059,"_23648":1038,"_16085":40045,"_5":15974,"_22319":39993,"_1957":40046},[],"Each entry of the CRL includes the serial number of the revoked certificate, the revocation date and the RFC 5280 reason code.",{"_2384":1060,"_23648":1038,"_16085":40048,"_5":15974,"_22319":39993,"_1957":40049},[],"The CRL also includes the *Issuing Distribution Point* (IDP, OID 2.5.29.28) extension, marked as critical, which indicates the public URL from which it can be downloaded. That URL points to the `/crl/{subject_key_id}` endpoint of each configured VA domain.",{"_2384":1061,"_23648":1038,"_16085":40051,"_5":15974,"_22319":39997,"_1957":40052},[],"The latest CRL of a CA can be obtained directly without authentication:",{"_2384":1062,"_23648":1038,"_16085":40054,"_5":15974,"_22319":39997,"_1957":40055},[],"The response has `Content-Type: application/pkix-crl` and contains the CRL in DER format.",{"_2384":1063,"_23648":1038,"_16085":40057,"_5":15974,"_22319":40001,"_1957":40058},[],"The VA role of a CA can be queried and updated through the API:",{"_2384":1064,"_23648":1038,"_16085":40060,"_5":15974,"_22319":40001,"_1957":40061},[],"Method",{"_2384":1065,"_23648":1038,"_16085":40063,"_5":15974,"_22319":40001,"_1957":40064},[],"Path",{"_2384":1066,"_23648":1038,"_16085":40066,"_5":15974,"_22319":40001,"_1957":40067},[],"Description",{"_2384":1067,"_23648":1038,"_16085":40069,"_5":15974,"_22319":40001,"_1957":40070},[],"`GET`",{"_2384":1068,"_23648":1038,"_16085":40072,"_5":15974,"_22319":40001,"_1957":40073},[],"`/v1/roles/{ca-ski}`",{"_2384":1069,"_23648":1038,"_16085":40075,"_5":15974,"_22319":40001,"_1957":40076},[],"Returns the VA role configuration and the metadata of the last issued CRL.",{"_2384":1070,"_23648":1038,"_16085":40078,"_5":15974,"_22319":40001,"_1957":40079},[],"`PUT`",{"_2384":1071,"_23648":1038,"_16085":40081,"_5":15974,"_22319":40001,"_1957":40073},[],{"_2384":1072,"_23648":1038,"_16085":40083,"_5":15974,"_22319":40001,"_1957":40084},[],"Updates the VA role configuration parameters (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_2384":1073,"_23648":1038,"_16085":40086,"_5":15974,"_22319":40001,"_1957":40087},[],"Example of querying the VA role:",{"_2384":1074,"_23648":1038,"_16085":40089,"_5":15974,"_22319":40001,"_1957":40090},[],"The response includes the `latest_crl` field with the version, the start of validity and the expiration date of the currently published CRL.",{"_2384":1075,"_23648":1038,"_16085":40092,"_5":15974,"_22319":40005,"_1957":40093},[],"From a CA's detail panel you can preview the content of the active CRL and download it directly for offline use or for importing into applications that perform local validation.",{"_2384":1076,"_23648":1038,"_16085":40095,"_5":15974,"_22319":40009,"_1957":40096},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_2384":1077,"_23648":1038,"_16085":40098,"_5":15974,"_22319":40009,"_1957":40099},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2384":1078,"_23648":1038,"_16085":40101,"_5":15974,"_22319":40009,"_1957":40102},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2384":1079,"_23648":1079,"_5":10988,"_1957":40104,"_23928":40105,"_16085":40106,"_22319":1079},"Device Management Service",[36699,38037,38515],[],{"_2384":1080,"_23648":1079,"_16085":40108,"_5":15974,"_22319":1079,"_1957":40109},[],"Define how a fleet receives, renews and uses its identities.",{"_2384":1081,"_23648":1079,"_5":23925,"_16085":40111,"_22319":40112,"_1957":36709},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#before-you-begin",{"_2384":1082,"_23648":1079,"_5":23925,"_16085":40114,"_22319":40115,"_1957":40116},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#configure-a-dms","Configure a DMS",{"_2384":1083,"_23648":1079,"_5":23925,"_16085":40118,"_22319":40119,"_1957":40120},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#identify-the-fleet","Identify the fleet",{"_2384":1084,"_23648":1079,"_5":23925,"_16085":40122,"_22319":40123,"_1957":40124},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#select-the-enrollment-ca","Select the enrollment CA",{"_2384":1085,"_23648":1079,"_5":23925,"_16085":40126,"_22319":40127,"_1957":40128},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#configure-est","Configure EST",{"_2384":1086,"_23648":1079,"_5":23925,"_16085":40130,"_22319":40131,"_1957":40132},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#distribute-trust","Distribute trust",{"_2384":1087,"_23648":1079,"_5":23925,"_16085":40134,"_22319":40135,"_1957":40136},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#verify-the-endpoints","Verify the endpoints",{"_2384":1088,"_23648":1079,"_5":23925,"_16085":40138,"_22319":40139,"_1957":40140},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#trust-distribution","Trust distribution",{"_2384":1089,"_23648":1079,"_5":23925,"_16085":40142,"_22319":40143,"_1957":40144},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#operate-the-dms-inventory","Operate the DMS inventory",{"_2384":1090,"_23648":1079,"_5":23925,"_16085":40146,"_22319":40147,"_1957":40148},[],"/docs/pr-preview/pr-26/platform/pki/device-enrollment#integrate-the-devices","Integrate the devices",{"_2384":1091,"_23648":1079,"_16085":40150,"_5":15974,"_22319":1079,"_1957":40151},[],"A &#x2A;*Device Management Service (DMS)** acts as the registration authority facing a fleet. It receives requests, applies the authentication policy and delegates issuance to the configured CA.",{"_2384":1092,"_23648":1079,"_16085":40153,"_5":15974,"_22319":1079,"_1957":40154},[],"Each DMS is an independent operational boundary: it can represent a product line, an environment or a device type with its own CA, authentication rules, distributed trust and renewal window.",{"_2384":1093,"_23648":1079,"_16085":40156,"_5":15974,"_22319":40112,"_1957":40157},[],"Create or import at least one active CA.",{"_2384":1094,"_23648":1079,"_16085":40159,"_5":15974,"_22319":40112,"_1957":40160},[],"Decide how devices will authenticate during initial enrollment.",{"_2384":1095,"_23648":1079,"_16085":40162,"_5":15974,"_22319":40112,"_1957":40163},[],"Define which authorities the device should receive as anchors of trust.",{"_2384":1096,"_23648":1079,"_16085":40165,"_5":15974,"_22319":40112,"_1957":40166},[],"Make sure you have permissions to administer DMSs.",{"_2384":1097,"_23648":1079,"_16085":40168,"_5":15974,"_22319":40119,"_1957":40169},[],"Give the DMS a name that describes its scope, for example a device family or an environment.",{"_2384":1098,"_23648":1079,"_16085":40171,"_5":15974,"_22319":40123,"_1957":40172},[],"Choose the authority that will issue the identities. Its policy and validity period constrain the certificates the fleet can obtain.",{"_2384":1099,"_23648":1079,"_16085":40174,"_5":15974,"_22319":40127,"_1957":40175},[],"Define the authentication of `enroll`, the `reenroll` policy, the renewal window and, if needed, `serverkeygen`.",{"_2384":1100,"_23648":1079,"_16085":40177,"_5":15974,"_22319":40131,"_1957":40178},[],"Configure **CA Distribution** to control the response of the `cacerts` endpoint.",{"_2384":1101,"_23648":1079,"_16085":40180,"_5":15974,"_22319":40135,"_1957":40181},[],"From the DMS menu, open &#x2A;*EST (RFC-7030)** and check the base URL and the invocation examples before integrating the firmware.",{"_2384":1102,"_23648":1079,"_16085":40183,"_5":15974,"_22319":40139,"_1957":40184},[],"**Include Lamassu System CA** distributes the TLS certificate of the Lamassu server, useful for *pinning*. It does not represent an issuing CA.",{"_2384":1103,"_23648":1079,"_16085":40186,"_5":15974,"_22319":40139,"_1957":40187},[],"**Include Enrollment CA** adds the authority configured to issue the DMS's identities.",{"_2384":1104,"_23648":1079,"_16085":40189,"_5":15974,"_22319":40139,"_1957":40190},[],"**Managed CAs** lets you include additional authorities the device must consider trusted.",{"_2384":1105,"_23648":1079,"_16085":40192,"_5":15974,"_22319":40143,"_1957":40193},[],"**Edit** modifies the DMS policy.",{"_2384":1106,"_23648":1079,"_16085":40195,"_5":15974,"_22319":40143,"_1957":40196},[],"**Go to DMS owned devices** opens only the devices of that fleet.",{"_2384":1107,"_23648":1079,"_16085":40198,"_5":15974,"_22319":40143,"_1957":40199},[],"**Show/Edit Metadata** manages advanced configuration and integration data.",{"_2384":1108,"_23648":1079,"_16085":40201,"_5":15974,"_22319":40143,"_1957":40202},[],"**EST (RFC-7030)** shows the endpoints and examples specific to the DMS.",{"_2384":1109,"_23648":1079,"_16085":40204,"_5":15974,"_22319":40143,"_1957":40205},[],"**Delete** removes the DMS and its configuration. The action is irreversible.",{"_2384":1110,"_23648":1079,"_16085":40207,"_5":15974,"_22319":40147,"_1957":40208},[],"<Card title=\"EST enrollment\" description=\"Configure authentication, endpoints and flows for firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2384":1111,"_23648":1079,"_16085":40210,"_5":15974,"_22319":40147,"_1957":40211},[],"<Card title=\"Devices and identities\" description=\"Review statuses, history and operational actions.\" href=\"/docs/platform/pki/device-management\" />",{"_2384":1112,"_23648":1112,"_5":10988,"_1957":40213,"_23928":40214,"_16085":40215,"_22319":1112},"Devices and identities",[36699,38037,38515],[],{"_2384":1113,"_23648":1112,"_16085":40217,"_5":15974,"_22319":1112,"_1957":40218},[],"Register devices and control their identities throughout the lifecycle.",{"_2384":1114,"_23648":1112,"_5":23925,"_16085":40220,"_22319":40221,"_1957":40222},[],"/docs/pr-preview/pr-26/platform/pki/device-management#device-states","Device states",{"_2384":1115,"_23648":1112,"_5":23925,"_16085":40224,"_22319":40225,"_1957":40226},[],"/docs/pr-preview/pr-26/platform/pki/device-management#inspect-a-device","Inspect a device",{"_2384":1116,"_23648":1112,"_5":23925,"_16085":40228,"_22319":40229,"_1957":40230},[],"/docs/pr-preview/pr-26/platform/pki/device-management#register-a-device-manually","Register a device manually",{"_2384":1117,"_23648":1112,"_5":23925,"_16085":40232,"_22319":40233,"_1957":40234},[],"/docs/pr-preview/pr-26/platform/pki/device-management#create-the-device","Create the device",{"_2384":1118,"_23648":1112,"_5":23925,"_16085":40236,"_22319":40237,"_1957":40238},[],"/docs/pr-preview/pr-26/platform/pki/device-management#define-its-membership","Define its membership",{"_2384":1119,"_23648":1112,"_5":23925,"_16085":40240,"_22319":40241,"_1957":40242},[],"/docs/pr-preview/pr-26/platform/pki/device-management#classify-the-device","Classify the device",{"_2384":1120,"_23648":1112,"_5":23925,"_16085":40244,"_22319":40245,"_1957":40246},[],"/docs/pr-preview/pr-26/platform/pki/device-management#verify-the-registration","Verify the registration",{"_2384":1121,"_23648":1112,"_5":23925,"_16085":40248,"_22319":40249,"_1957":40250},[],"/docs/pr-preview/pr-26/platform/pki/device-management#assign-an-identity-manually","Assign an identity manually",{"_2384":1122,"_23648":1112,"_5":23925,"_16085":40252,"_22319":40253,"_1957":40254},[],"/docs/pr-preview/pr-26/platform/pki/device-management#revoke-the-current-identity","Revoke the current identity",{"_2384":1123,"_23648":1112,"_5":23925,"_16085":40256,"_22319":40257,"_1957":40258},[],"/docs/pr-preview/pr-26/platform/pki/device-management#decommission-a-device","Decommission a device",{"_2384":1124,"_23648":1112,"_5":23925,"_16085":40260,"_22319":40261,"_1957":40262},[],"/docs/pr-preview/pr-26/platform/pki/device-management#automate-enrollment","Automate enrollment",{"_2384":1125,"_23648":1112,"_16085":40264,"_5":15974,"_22319":1112,"_1957":40265},[],"A managed device represents an entity in your fleet and keeps the history of the certificates it has used. Lamassu separates the device from its current identity so you can renew or replace certificates without losing traceability.",{"_2384":1126,"_23648":1112,"_16085":40267,"_5":15974,"_22319":40221,"_1957":40268},[],"**Active** indicates the device has a valid identity.",{"_2384":1127,"_23648":1112,"_16085":40270,"_5":15974,"_22319":40221,"_1957":40271},[],"**No Identity** appears when it is registered but does not yet have an associated certificate.",{"_2384":1128,"_23648":1112,"_16085":40273,"_5":15974,"_22319":40221,"_1957":40274},[],"**Renewal Pending** signals that it has entered the renewal window.",{"_2384":1129,"_23648":1112,"_16085":40276,"_5":15974,"_22319":40221,"_1957":40277},[],"**Expiring Soon** warns that the certificate is close to expiring.",{"_2384":1130,"_23648":1112,"_16085":40279,"_5":15974,"_22319":40221,"_1957":40280},[],"**Expired** indicates the identity has passed its validity date.",{"_2384":1131,"_23648":1112,"_16085":40282,"_5":15974,"_22319":40221,"_1957":40283},[],"**Revoked** identifies a certificate invalidated before its expiration.",{"_2384":1132,"_23648":1112,"_16085":40285,"_5":15974,"_22319":40221,"_1957":40286},[],"**Decommissioned** corresponds to a device permanently retired.",{"_2384":1133,"_23648":1112,"_16085":40288,"_5":15974,"_22319":40221,"_1957":40289},[],"The inventory lets you filter by `Device ID`, tags and status.",{"_2384":1134,"_23648":1112,"_16085":40291,"_5":15974,"_22319":40225,"_1957":40292},[],"The detail view separates two perspectives:",{"_2384":1135,"_23648":1112,"_16085":40294,"_5":15974,"_22319":40225,"_1957":40295},[],"**Certificate History** keeps every certificate associated with the device, with its serial number, issuer, status and validity period.",{"_2384":1136,"_23648":1112,"_16085":40297,"_5":15974,"_22319":40225,"_1957":40298},[],"**Device Event Timeline** orders registrations, enrollments, renewals and status changes chronologically.",{"_2384":1137,"_23648":1112,"_16085":40300,"_5":15974,"_22319":40225,"_1957":40301},[],"Use the history for audit and the timeline to reconstruct an incident or diagnose an unexpected transition.",{"_2384":1138,"_23648":1112,"_16085":40303,"_5":15974,"_22319":40229,"_1957":40304},[],"Pre-registration is useful when policy requires the device to exist before requesting its first certificate.",{"_2384":1139,"_23648":1112,"_16085":40306,"_5":15974,"_22319":40233,"_1957":40307},[],"From **Managed Devices**, open the registration form.",{"_2384":1140,"_23648":1112,"_16085":40309,"_5":15974,"_22319":40237,"_1957":40310},[],"Enter a unique **Device ID** and select the DMS that will apply the enrollment and renewal policies.",{"_2384":1141,"_23648":1112,"_16085":40312,"_5":15974,"_22319":40241,"_1957":40313},[],"Add an icon and tags if you need to group devices by model, location, environment or another operational criterion.",{"_2384":1142,"_23648":1112,"_16085":40315,"_5":15974,"_22319":40245,"_1957":40316},[],"The device should appear with status **No Identity** until it completes enrollment or receives a manually assigned identity.",{"_2384":1143,"_23648":1112,"_16085":40318,"_5":15974,"_22319":40249,"_1957":40319},[],"The **Assign Identity** action is available while the device remains in **No Identity**.",{"_2384":1144,"_23648":1112,"_16085":40321,"_5":15974,"_22319":40249,"_1957":40322},[],"Open the device and select **Assign Identity**.",{"_2384":1145,"_23648":1112,"_16085":40324,"_5":15974,"_22319":40249,"_1957":40325},[],"Choose an active certificate whose `Common Name` matches the `Device ID`.",{"_2384":1146,"_23648":1112,"_16085":40327,"_5":15974,"_22319":40249,"_1957":40328},[],"If none exists, select **Issue New Instead** and choose a CA linked to the DMS.",{"_2384":1147,"_23648":1112,"_16085":40330,"_5":15974,"_22319":40249,"_1957":40331},[],"Confirm the assignment.",{"_2384":1148,"_23648":1112,"_16085":40333,"_5":15974,"_22319":40249,"_1957":40334},[],"The device should change to **Active** and the certificate should appear in its history.",{"_2384":1149,"_23648":1112,"_16085":40336,"_5":15974,"_22319":40253,"_1957":40337},[],"In **Device Event Timeline**, locate the latest active certificate and select **Revoke**. Choose a reason consistent with your policy and confirm the operation.",{"_2384":1150,"_23648":1112,"_16085":40339,"_5":15974,"_22319":40253,"_1957":40340},[],"Revocation invalidates the certificate but does not delete the device. You can restore its operation by assigning it a new identity. `CertificateHold` allows reactivating the retained certificate; all other reasons are final.",{"_2384":1151,"_23648":1112,"_16085":40342,"_5":15974,"_22319":40257,"_1957":40343},[],"This action revokes all the device's certificates and prevents it from obtaining an identity again.",{"_2384":1152,"_23648":1112,"_16085":40345,"_5":15974,"_22319":40257,"_1957":40346},[],"Use **Decommission** only when the device has stopped operating or is no longer trustworthy. After confirming, Lamassu revokes the active identity with `CessationOfOperation` and changes the status to **Decommissioned**.",{"_2384":1153,"_23648":1112,"_16085":40348,"_5":15974,"_22319":40261,"_1957":40349},[],"<Card title=\"Configure a DMS\" description=\"Define the CA, trust and policies of the fleet.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2384":1154,"_23648":1112,"_16085":40351,"_5":15974,"_22319":40261,"_1957":40352},[],"<Card title=\"Integrate EST\" description=\"Let the device request and renew its identity.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2384":1155,"_23648":1155,"_5":10988,"_1957":40354,"_23928":40355,"_16085":40356,"_22319":1155},"Device enrollment with EST",[36699,38037,38515],[],{"_2384":1156,"_23648":1155,"_16085":40358,"_5":15974,"_22319":1155,"_1957":40359},[],"EST protocol guide for Lamassu IoT, with DMS configuration for the PKI administrator and the endpoint reference for device integrators.",{"_2384":1157,"_23648":1155,"_5":23925,"_16085":40361,"_22319":40362,"_1957":40363},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_2384":1158,"_23648":1155,"_5":23925,"_16085":40365,"_22319":40366,"_1957":40367},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#dms-configuration","DMS configuration",{"_2384":1159,"_23648":1155,"_5":23925,"_16085":40369,"_22319":40370,"_1957":40371},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#prerequisites","Prerequisites",{"_2384":1160,"_23648":1155,"_5":23925,"_16085":40373,"_22319":40374,"_1957":40375},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#enrollment-configuration","Enrollment configuration",{"_2384":1161,"_23648":1155,"_5":23925,"_16085":40377,"_22319":40378,"_1957":40379},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_2384":1162,"_23648":1155,"_5":23925,"_16085":40381,"_22319":40382,"_1957":40383},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_2384":1163,"_23648":1155,"_5":23925,"_16085":40385,"_22319":40386,"_1957":40387},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#issuance-profile","Issuance profile",{"_2384":1164,"_23648":1155,"_5":23925,"_16085":40389,"_22319":40390,"_1957":40391},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#re-enrollment-configuration","Re-enrollment configuration",{"_2384":1165,"_23648":1155,"_5":23925,"_16085":40393,"_22319":40394,"_1957":40395},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#serverkeygen-configuration","ServerKeyGen configuration",{"_2384":1166,"_23648":1155,"_5":23925,"_16085":40397,"_22319":40398,"_1957":40399},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#verify-the-configuration","Verify the configuration",{"_2384":1167,"_23648":1155,"_5":23925,"_16085":40401,"_22319":40402,"_1957":40403},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#device-integration","Device integration",{"_2384":1168,"_23648":1155,"_5":23925,"_16085":40405,"_22319":40406,"_1957":36709},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#before-you-begin",{"_2384":1169,"_23648":1155,"_5":23925,"_16085":40408,"_22319":40409,"_1957":40410},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#flow-overview","Flow overview",{"_2384":1170,"_23648":1155,"_5":23925,"_16085":40412,"_22319":40413,"_1957":40414},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#client-authentication-model","Client authentication model",{"_2384":1171,"_23648":1155,"_5":23925,"_16085":40416,"_22319":40417,"_1957":40418},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#endpoint-reference","Endpoint reference",{"_2384":1172,"_23648":1155,"_5":23925,"_16085":40420,"_22319":40421,"_1957":40422},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_2384":1173,"_23648":1155,"_5":23925,"_16085":40424,"_22319":40425,"_1957":40426},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_2384":1174,"_23648":1155,"_5":23925,"_16085":40428,"_22319":40429,"_1957":40430},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_2384":1175,"_23648":1155,"_5":23925,"_16085":40432,"_22319":40433,"_1957":40434},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_2384":1176,"_23648":1155,"_5":23925,"_16085":40436,"_22319":40437,"_1957":40438},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#full-flows","Full flows",{"_2384":1177,"_23648":1155,"_5":23925,"_16085":40440,"_22319":40441,"_1957":40442},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#end-to-end-example-enroll","End-to-end example: enroll",{"_2384":1178,"_23648":1155,"_5":23925,"_16085":40444,"_22319":40445,"_1957":40446},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#end-to-end-example-reenroll","End-to-end example: reenroll",{"_2384":1179,"_23648":1155,"_5":23925,"_16085":40448,"_22319":40449,"_1957":40450},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#next-steps-after-enrollment","Next steps after enrollment",{"_2384":1180,"_23648":1155,"_5":23925,"_16085":40452,"_22319":40453,"_1957":40454},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2384":1181,"_23648":1155,"_5":23925,"_16085":40456,"_22319":40457,"_1957":40458},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#error-codes-and-diagnostics","Error codes and diagnostics",{"_2384":1182,"_23648":1155,"_5":23925,"_16085":40460,"_22319":40461,"_1957":40462},[],"/docs/pr-preview/pr-26/platform/pki/est-enrollment#compatibility-notes","Compatibility notes",{"_2384":1183,"_23648":1155,"_16085":40464,"_5":15974,"_22319":40362,"_1957":40465},[],"Lamassu IoT implements the &#x2A;*EST (Enrollment over Secure Transport)** protocol described in RFC 7030 as its only certificate enrollment mechanism for devices. Each DMS exposes the EST endpoints, validates the device and applies its own authentication, registration and renewal policies. In doing so, it acts as the Registration Authority (RA) facing the client.",{"_2384":1184,"_23648":1155,"_16085":40467,"_5":15974,"_22319":40362,"_1957":40468},[],"The entity that issues and cryptographically signs the certificate is always the **CA associated with the DMS**, not the DMS. The DMS coordinates the process: it receives the CSR, authenticates the device and applies the issuance policy. This distinction matters for the PKI administrator when selecting the `EnrollmentCA` and for the integrator when interpreting the chain of trust received from `/cacerts`.",{"_2384":1185,"_23648":1155,"_16085":40470,"_5":15974,"_22319":40362,"_1957":40471},[],"This guide is split in two parts:",{"_2384":1186,"_23648":1155,"_16085":40473,"_5":15974,"_22319":40362,"_1957":40474},[],"DMS configuration, for the PKI administrator.",{"_2384":1187,"_23648":1155,"_16085":40476,"_5":15974,"_22319":40362,"_1957":40477},[],"Device integration, for anyone consuming the EST endpoints from firmware, scripts or provisioning services.",{"_2384":1188,"_23648":1155,"_16085":40479,"_5":15974,"_22319":40362,"_1957":40480},[],"If you only need a quick orientation, this is the recommended route:",{"_2384":1189,"_23648":1155,"_16085":40482,"_5":15974,"_22319":40362,"_1957":40483},[],"**PKI administrator:** start with DMS configuration and finish with Diagnostics and compatibility.",{"_2384":1190,"_23648":1155,"_16085":40485,"_5":15974,"_22319":40362,"_1957":40486},[],"**Device integrator:** start with Before you begin and continue with `/cacerts`, `/simpleenroll`, `/simplereenroll` or `/serverkeygen`, depending on the flow you will implement.",{"_2384":1191,"_23648":1155,"_16085":40488,"_5":15974,"_22319":40370,"_1957":40489},[],"Before configuring a DMS for EST, the following resources must exist on the platform:",{"_2384":1192,"_23648":1155,"_16085":40491,"_5":15974,"_22319":40370,"_1957":40492},[],"**An available CA**: the CA acting as `EnrollmentCA` must be created and active in Lamassu. If the authentication mode is `CLIENT_CERTIFICATE`, the validation CAs for the bootstrap certificate must also have been created.",{"_2384":1193,"_23648":1155,"_16085":40494,"_5":15974,"_22319":40370,"_1957":40495},[],"**A created DMS**: the DMS this configuration applies to must already exist. The EST configuration is applied over an existing DMS, it does not create one.",{"_2384":1194,"_23648":1155,"_16085":40497,"_5":15974,"_22319":40370,"_1957":40498},[],"It is worth separating four configuration blocks:",{"_2384":1195,"_23648":1155,"_16085":40500,"_5":15974,"_22319":40370,"_1957":40501},[],"How the initial enrollment will be performed, including the registration mode and client authentication.",{"_2384":1196,"_23648":1155,"_16085":40503,"_5":15974,"_22319":40370,"_1957":40504},[],"How the re-enrollment of already-issued certificates will be handled.",{"_2384":1197,"_23648":1155,"_16085":40506,"_5":15974,"_22319":40370,"_1957":40507},[],"How the cacerts endpoint will be configured to distribute the CAs devices use as trust anchors.",{"_2384":1198,"_23648":1155,"_16085":40509,"_5":15974,"_22319":40370,"_1957":40510},[],"Whether server-side key generation through `ServerKeyGen` will be enabled.",{"_2384":1199,"_23648":1155,"_16085":40512,"_5":15974,"_22319":40378,"_1957":40513},[],"This section defines how new devices are registered and with which credentials they authenticate.",{"_2384":1200,"_23648":1155,"_16085":40515,"_5":15974,"_22319":40378,"_1957":40516},[],"**Registration Mode**: determines the behavior when receiving an initial enrollment. In `JITP` (*Just-In-Time Provisioning*) mode, the device is created automatically the first time it presents itself, applying the tags, metadata and icon defined in the provisioning profile. In `PRE_REGISTRATION` mode, the device must already exist on the platform; if it does not, the request is rejected with `device not preregistered`. JITP mode suits large fleets where the inventory is built during deployment; `PRE_REGISTRATION` fits high-security environments where each device is explicitly approved before receiving a certificate.",{"_2384":1201,"_23648":1155,"_16085":40518,"_5":15974,"_22319":40378,"_1957":40519},[],"**Tags**: applied to each device automatically created by this DMS. They are optional and only take effect in JITP mode. Tags improve device search.",{"_2384":1202,"_23648":1155,"_16085":40521,"_5":15974,"_22319":40378,"_1957":40522},[],"**Icon**: applied to each device automatically created by this DMS. It is optional and only takes effect in JITP mode. Purely visual.",{"_2384":1203,"_23648":1155,"_16085":40524,"_5":15974,"_22319":40382,"_1957":40525},[],"**Enrollment CA**: identifies the CA that will sign the identity certificates issued through this DMS. Its choice determines the chain of trust the device will receive and the root against which backend systems will validate fleet certificates.",{"_2384":1204,"_23648":1155,"_16085":40527,"_5":15974,"_22319":40382,"_1957":40528},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): allows an already-enrolled device to enroll again through `/simpleenroll`. When active, the previous certificate is revoked with the reason `superseded` and the identity slot is updated. When inactive, a second `simpleenroll` attempt is rejected with `forbiddenNewEnrollment`. This option must be enabled with care in production environments, since it lets you replace a device's identity without going through the re-enrollment flow.",{"_2384":1205,"_23648":1155,"_16085":40530,"_5":15974,"_22319":40382,"_1957":40531},[],"**Verify CSR Signature** (`verify_csr_signature`): controls whether the server validates the CSR signature against the public key declared in it (PKCS#10 proof of possession). When inactive, a requester could submit a CSR with a public key it does not control and obtain a certificate bound to it. For IoT fleets on open networks it must be enabled.",{"_2384":1206,"_23648":1155,"_16085":40533,"_5":15974,"_22319":40382,"_1957":40534},[],"**Authentication Mode**: defines how the DMS validates the device identity during enrollment. It can require an mTLS certificate (`CLIENT_CERTIFICATE`), delegate authorization to a webhook (`EXTERNAL_WEBHOOK`), combine both controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) or accept unauthenticated requests (`NO_AUTH`). The latter must be limited to isolated labs or provisioning networks.",{"_2384":1207,"_23648":1155,"_16085":40536,"_5":15974,"_22319":40382,"_1957":40537},[],"When the mode is `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, these parameters are also configured:",{"_2384":1208,"_23648":1155,"_16085":40539,"_5":15974,"_22319":40382,"_1957":40540},[],"**Validation CAs**: list of trusted CAs to validate the bootstrap certificate presented by the device.",{"_2384":1209,"_23648":1155,"_16085":40542,"_5":15974,"_22319":40382,"_1957":40543},[],"**Chain Validation Level**: maximum depth of the validation chain. The value `-1` validates the full chain up to the root CA.",{"_2384":1210,"_23648":1155,"_16085":40545,"_5":15974,"_22319":40382,"_1957":40546},[],"**Allow Authenticating Expired Certificates**: if active, accepts expired client certificates. Useful in recovery scenarios where the device could not renew its certificate in time.",{"_2384":1211,"_23648":1155,"_16085":40548,"_5":15974,"_22319":40382,"_1957":40549},[],"When the mode includes `EXTERNAL_WEBHOOK`, these parameters are also configured:",{"_2384":1212,"_23648":1155,"_16085":40551,"_5":15974,"_22319":40382,"_1957":40552},[],"**Webhook URL**: address of the external service that will decide authorization.",{"_2384":1213,"_23648":1155,"_16085":40554,"_5":15974,"_22319":40382,"_1957":40555},[],"**HTTP Method**: HTTP method used to invoke the webhook. Supports `POST` (default) or `PUT`; both are equivalent for the webhook, only the verb Lamassu uses changes.",{"_2384":1214,"_23648":1155,"_16085":40557,"_5":15974,"_22319":40382,"_1957":40558},[],"**Timeout**: maximum wait time for the webhook call. If not specified, the default is **10 seconds**; after that without a response, Lamassu denies the operation.",{"_2384":1215,"_23648":1155,"_16085":40560,"_5":15974,"_22319":40382,"_1957":40561},[],"**Webhook Authentication Mode**: authentication mode of the webhook toward the external service, for example `ApiKey`, `OIDC` or `mTLS`.",{"_2384":1216,"_23648":1155,"_16085":40563,"_5":15974,"_22319":40382,"_1957":40564},[],"The exact contract the webhook service must implement (request and response schema, examples) is published as an OpenAPI specification: authorization webhook reference.",{"_2384":1217,"_23648":1155,"_16085":40566,"_5":15974,"_22319":40386,"_1957":40567},[],"The behavior of the issued certificate is not determined solely by the device's CSR, but by the **issuance profile** (`IssuanceProfile`) associated with the DMS. The integrator does not configure this profile, but its rules affect the content of the final certificate:",{"_2384":1218,"_23648":1155,"_16085":40569,"_5":15974,"_22319":40386,"_1957":40570},[],"**`HonorSubject`** controls whether the CSR's subject is copied verbatim into the certificate. If disabled, the CA applies the profile's template and ignores the received subject.",{"_2384":1219,"_23648":1155,"_16085":40572,"_5":15974,"_22319":40386,"_1957":40573},[],"**`HonorKeyUsage`** decides whether the CSR's `KeyUsage` is respected or replaced by the one defined in the template.",{"_2384":1220,"_23648":1155,"_16085":40575,"_5":15974,"_22319":40386,"_1957":40576},[],"**`HonorExtendedKeyUsages`** applies the same rule to `ExtKeyUsage`.",{"_2384":1221,"_23648":1155,"_16085":40578,"_5":15974,"_22319":40386,"_1957":40579},[],"**`HonorExtensions`** controls whether the rest of the CSR's extensions, such as SAN or CDP, are included in the certificate.",{"_2384":1222,"_23648":1155,"_16085":40581,"_5":15974,"_22319":40386,"_1957":40582},[],"This matters for the integrator: the `KeyUsage`, `ExtKeyUsage` and SANs declared in the CSR may not appear as-is in the final certificate if the profile decides otherwise. Check with the PKI administrator if the issued certificate does not contain the expected extensions.",{"_2384":1223,"_23648":1155,"_16085":40584,"_5":15974,"_22319":40390,"_1957":40585},[],"The **Re-Enrollment Settings** section controls the certificate renewal process. Re-enrollment can only be performed while the certificate is within the configured window, and optionally also when the certificate has already expired.",{"_2384":1224,"_23648":1155,"_16085":40587,"_5":15974,"_22319":40390,"_1957":40588},[],"**Revoke On Re-Enroll**: if active, the previous certificate is automatically revoked with the reason `superseded` once the new one is issued.",{"_2384":1225,"_23648":1155,"_16085":40590,"_5":15974,"_22319":40390,"_1957":40591},[],"**Allow Expired Renewal**: allows renewing an already-expired certificate. Useful when a device has been offline and could not renew within the window.",{"_2384":1226,"_23648":1155,"_16085":40593,"_5":15974,"_22319":40390,"_1957":40594},[],"**Allowed Renewal Delta**: time window before expiration during which re-enrollment is allowed. Before this window opens, the request is rejected with `invalid reenroll window`.",{"_2384":1227,"_23648":1155,"_16085":40596,"_5":15974,"_22319":40390,"_1957":40597},[],"**Preventive Renewal Delta**: time before expiration from which preventive renewal alerts are raised.",{"_2384":1228,"_23648":1155,"_16085":40599,"_5":15974,"_22319":40390,"_1957":40600},[],"**Critical Renewal Delta**: threshold closest to expiration that triggers critical status alerts.",{"_2384":1229,"_23648":1155,"_16085":40602,"_5":15974,"_22319":40390,"_1957":40603},[],"**Additional Validation CAs**: additional CAs accepted as issuers of the active certificate during re-enrollment. It allows migrating to a new enrollment CA without interrupting the renewal of devices already enrolled with the previous CA.",{"_2384":1230,"_23648":1155,"_16085":40605,"_5":15974,"_22319":40394,"_1957":40606},[],"The **Server Key Generation** section lets Lamassu generate the device's key pair on the server and return it together with the issued certificate. It is useful for devices with limited cryptographic capability.",{"_2384":1231,"_23648":1155,"_16085":40608,"_5":15974,"_22319":40394,"_1957":40609},[],"The **Enable Server-Side Key Generation** option activates the `/serverkeygen` endpoint. When inactive, any call to that endpoint is rejected with `server key generation not enabled`.",{"_2384":1232,"_23648":1155,"_16085":40611,"_5":15974,"_22319":40394,"_1957":40612},[],"**Key Type** selects the algorithm: `RSA` or `ECDSA`. The &#x2A;*Key Size (bits)** field determines the key size. For ECDSA, the size in bits also determines the curve: 256 corresponds to P-256, 384 to P-384 and 521 to P-521.",{"_2384":1233,"_23648":1155,"_16085":40614,"_5":15974,"_22319":40394,"_1957":40615},[],"The key is generated in the server's software engine, not in a hardware Crypto Engine such as AWS KMS or PKCS#11. The only protection of the key in transit is the TLS channel; no additional encryption (CMS EnvelopedData) is applied to the key before sending it to the device. See the `/serverkeygen` section of the integrator reference for the exact response format and security considerations.",{"_2384":1234,"_23648":1155,"_16085":40617,"_5":15974,"_22319":40398,"_1957":40618},[],"Once the enrollment, re-enrollment and ServerKeyGen settings are applied, you can confirm the DMS is operational as follows:",{"_2384":1235,"_23648":1155,"_16085":40620,"_5":15974,"_22319":40398,"_1957":40621},[],"**From the console**: open the DMS detail and check that the EST section shows the assigned enrollment CA and the configured authentication mode.",{"_2384":1236,"_23648":1155,"_16085":40623,"_5":15974,"_22319":40398,"_1957":40624},[],"**With a test request**: invoke the DMS's `/cacerts` endpoint from a `curl` client with server trust. A `200 OK` response with base64 content confirms the DMS is active and the enrollment CA is reachable.",{"_2384":1237,"_23648":1155,"_16085":40626,"_5":15974,"_22319":40398,"_1957":40627},[],"If the DMS does not exist or the CA is not available, the server responds with `DMS not found` or another error message. See the Diagnostics and compatibility section to interpret error messages.",{"_2384":1238,"_23648":1155,"_16085":40629,"_5":15974,"_22319":40402,"_1957":40630},[],"*This section is aimed at device integrators.*",{"_2384":1239,"_23648":1155,"_16085":40632,"_5":15974,"_22319":40402,"_1957":40633},[],"Lamassu's EST endpoints are published under the `/.well-known/est` prefix and always require the presence of the `{aps}` path segment, interpreted as the identifier of the DMS the operation targets. The association is direct: the `{aps}` value received in the URL is used as the DMS ID when querying the internal store. Variants registered without `{aps}` (for example `/.well-known/est/cacerts`) are routed in the code, but their handler requires the `APS` field and returns `400 Bad Request` with the message `Field validation for 'APS' failed` when the segment is not provided.",{"_2384":1240,"_23648":1155,"_16085":40635,"_5":15974,"_22319":40402,"_1957":40636},[],"This part follows the integrator's usual working order: first the prerequisites and the authentication model, then the reference for each endpoint and, finally, complete examples and diagnostic material.",{"_2384":1241,"_23648":1155,"_16085":40638,"_5":15974,"_22319":40406,"_1957":40639},[],"The PKI administrator must have configured a DMS with the `EST_RFC7030` protocol, an assigned enrollment CA and at least one authentication mode. Without that prior configuration, Lamassu rejects any enrollment request. The details of that configuration are in the DMS configuration section of this same page.",{"_2384":1242,"_23648":1155,"_16085":40641,"_5":15974,"_22319":40406,"_1957":40642},[],"Before making the first call, make sure you have:",{"_2384":1243,"_23648":1155,"_16085":40644,"_5":15974,"_22319":40406,"_1957":40645},[],"**The EST host URL**, for example `https://est.lamassu.example`, provided by the PKI administrator.",{"_2384":1244,"_23648":1155,"_16085":40647,"_5":15974,"_22319":40406,"_1957":40648},[],"**The server trust anchor** (`lamassu-trust.pem`), root or intermediate, with which the client will validate Lamassu's TLS.",{"_2384":1245,"_23648":1155,"_16085":40650,"_5":15974,"_22319":40406,"_1957":40651},[],"**The bootstrap certificate and its private key** if the DMS uses `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. This identity must come from one of the configured `ValidationCAs`, usually a provisioning CA different from the enrollment CA.",{"_2384":1246,"_23648":1155,"_16085":40653,"_5":15974,"_22319":40406,"_1957":40654},[],"**The DMS ID** (`{aps}`), which must appear in every EST route.",{"_2384":1247,"_23648":1155,"_16085":40656,"_5":15974,"_22319":40409,"_1957":40657},[],"**Download trust with `/cacerts`:** the client validates the server's TLS and receives the certificates in PKCS#7 or PEM.",{"_2384":1248,"_23648":1155,"_16085":40659,"_5":15974,"_22319":40409,"_1957":40660},[],"**Perform initial enrollment with `/simpleenroll`:** present the bootstrap certificate or the credential defined by `AuthMode` to obtain the device certificate.",{"_2384":1249,"_23648":1155,"_16085":40662,"_5":15974,"_22319":40409,"_1957":40663},[],"**Renew with `/simplereenroll`:** authenticate with the device's current certificate to obtain a new one.",{"_2384":1250,"_23648":1155,"_16085":40665,"_5":15974,"_22319":40409,"_1957":40666},[],"**Use `/serverkeygen` only if you need server-side key generation:** it applies the same authentication as `/simpleenroll` and returns the PKCS#8 private key together with the certificate.",{"_2384":1251,"_23648":1155,"_16085":40668,"_5":15974,"_22319":40413,"_1957":40669},[],"Lamassu's implementation recognizes four authentication configurations for `/simpleenroll`, expressed through the DMS's `EnrollmentOptionsESTRFC7030.AuthMode` field. Three are simple modes (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) and one combines two controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). The client must present itself in the mode the DMS expects; any other combination fails the enrollment.",{"_2384":1252,"_23648":1155,"_16085":40671,"_5":15974,"_22319":40413,"_1957":40672},[],"Mode (`AuthMode`)",{"_2384":1253,"_23648":1155,"_16085":40674,"_5":15974,"_22319":40413,"_1957":40067},[],{"_2384":1254,"_23648":1155,"_16085":40676,"_5":15974,"_22319":40413,"_1957":40677},[],"Expected credential",{"_2384":1255,"_23648":1155,"_16085":40679,"_5":15974,"_22319":40413,"_1957":40680},[],"Applies in enroll",{"_2384":1256,"_23648":1155,"_16085":40682,"_5":15974,"_22319":40413,"_1957":40683},[],"Applies in reenroll",{"_2384":1257,"_23648":1155,"_16085":40685,"_5":15974,"_22319":40413,"_1957":40686},[],"`CLIENT_CERTIFICATE`",{"_2384":1258,"_23648":1155,"_16085":40688,"_5":15974,"_22319":40413,"_1957":40689},[],"mTLS with X.509 certificate",{"_2384":1259,"_23648":1155,"_16085":40691,"_5":15974,"_22319":40413,"_1957":40692},[],"Client certificate and private key",{"_2384":1260,"_23648":1155,"_16085":40694,"_5":15974,"_22319":40413,"_1957":40695},[],"Yes",{"_2384":1261,"_23648":1155,"_16085":40697,"_5":15974,"_22319":40413,"_1957":40698},[],"Yes (with the active certificate)",{"_2384":1262,"_23648":1155,"_16085":40700,"_5":15974,"_22319":40413,"_1957":40701},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2384":1263,"_23648":1155,"_16085":40703,"_5":15974,"_22319":40413,"_1957":40704},[],"mTLS plus webhook validation",{"_2384":1264,"_23648":1155,"_16085":40706,"_5":15974,"_22319":40413,"_1957":40707},[],"Client certificate and private key, plus webhook approval",{"_2384":1265,"_23648":1155,"_16085":40709,"_5":15974,"_22319":40413,"_1957":40695},[],{"_2384":1266,"_23648":1155,"_16085":40711,"_5":15974,"_22319":40413,"_1957":40712},[],"Not as a combination; in reenroll both controls are not kept",{"_2384":1267,"_23648":1155,"_16085":40714,"_5":15974,"_22319":40413,"_1957":40715},[],"`EXTERNAL_WEBHOOK`",{"_2384":1268,"_23648":1155,"_16085":40717,"_5":15974,"_22319":40413,"_1957":40718},[],"External authorization webhook",{"_2384":1269,"_23648":1155,"_16085":40720,"_5":15974,"_22319":40413,"_1957":40721},[],"None on the TLS channel",{"_2384":1270,"_23648":1155,"_16085":40723,"_5":15974,"_22319":40413,"_1957":40695},[],{"_2384":1271,"_23648":1155,"_16085":40725,"_5":15974,"_22319":40413,"_1957":40726},[],"No, degrades to `NO_AUTH`",{"_2384":1272,"_23648":1155,"_16085":40728,"_5":15974,"_22319":40413,"_1957":40729},[],"`NO_AUTH`",{"_2384":1273,"_23648":1155,"_16085":40731,"_5":15974,"_22319":40413,"_1957":40732},[],"No authentication",{"_2384":1274,"_23648":1155,"_16085":40734,"_5":15974,"_22319":40413,"_1957":40735},[],"None",{"_2384":1275,"_23648":1155,"_16085":40737,"_5":15974,"_22319":40413,"_1957":40738},[],"Yes (restricted use)",{"_2384":1276,"_23648":1155,"_16085":40740,"_5":15974,"_22319":40413,"_1957":40738},[],{"_2384":1277,"_23648":1155,"_16085":40742,"_5":15974,"_22319":40413,"_1957":40743},[],"JWT **is not a valid authentication mode in EST**. The JWT identity extractor exists in the code but is only evaluated in Lamassu's administration API. Any *Bearer token* sent to `/.well-known/est/...` is silently ignored. When the DMS is configured with `AuthMode: CLIENT_CERTIFICATE`, a request carrying only a JWT is rejected for lack of a client certificate. When the DMS is in `AuthMode: NO_AUTH`, the request is processed as such and the JWT neither adds nor removes authorization.",{"_2384":1278,"_23648":1155,"_16085":40745,"_5":15974,"_22319":40413,"_1957":40746},[],"**`CLIENT_CERTIFICATE`**: the client presents an X.509 certificate issued by one of the CAs declared in `AuthOptionsMTLS.ValidationCAs`. The process validates the certificate chain against those CAs through the `ValidationCAs`, `AllowExpired` and `ChainLevelValidation` parameters. In addition, the service checks the revocation status in three steps: first it looks up the cert in Lamassu's local database; if not found, it queries the OCSP responders listed in the AIA extension; if OCSP fails, it tries the CRL Distribution Points (CDP). A revoked certificate interrupts the enrollment with `certificate is revoked`.",{"_2384":1279,"_23648":1155,"_16085":40748,"_5":15974,"_22319":40413,"_1957":40749},[],"Its main parameters are `ValidationCAs`, the list of CAs that can validate the bootstrap certificate or the active certificate; `AllowExpired`, which allows accepting expired client certificates; and `ChainLevelValidation`, which limits the chain depth when its value is greater than zero.",{"_2384":1280,"_23648":1155,"_16085":40751,"_5":15974,"_22319":40413,"_1957":40752},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delegates the authorization decision to an external HTTP service. The EST server builds a `POST` request to the configured webhook with a JSON body reproducing the enrollment context.",{"_2384":1281,"_23648":1155,"_16085":40754,"_5":15974,"_22319":40413,"_1957":40755},[],"The value of the `csr` field is the **base64 encoding of the CSR's PEM** (not the DER, and not the plain PEM). The webhook must respond with `2xx` and a JSON body `{\"authorized\": true}` to continue; any other response aborts the enrollment with `external webhook denied enrollment`. A `204 No Content` **is not a valid response** even though it is a `2xx` code: Lamassu requires a JSON body with the `authorized` field, so a webhook responding without a body denies the operation just like an error.",{"_2384":1282,"_23648":1155,"_16085":40757,"_5":15974,"_22319":40413,"_1957":40758},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combines the two previous modes during `/simpleenroll`. The client must present a valid mTLS certificate and the webhook must return `authorized: true`. In `/simplereenroll` the combination is not preserved: the joint mTLS + webhook check is not maintained, so the integrator must not assume the same guarantees of the initial enrollment apply in reenroll.",{"_2384":1283,"_23648":1155,"_16085":40760,"_5":15974,"_22319":40413,"_1957":40761},[],"**`NO_AUTH`**: the DMS accepts any CSR without validating the client's identity. Lamassu logs a warning (`DMS is configured with NoAuth, allowing enrollment`) and proceeds with the registration. It must be restricted to controlled environments (an isolated provisioning network); any network exposed to the internet with a DMS in `NO_AUTH` is open to certificate issuance by unauthorized third parties.",{"_2384":1284,"_23648":1155,"_16085":40763,"_5":15974,"_22319":40417,"_1957":40764},[],"The following sections describe the endpoints in the usual order of use within the device lifecycle:",{"_2384":1285,"_23648":1155,"_16085":40766,"_5":15974,"_22319":40417,"_1957":40767},[],"`/cacerts`: download of the trust chain.",{"_2384":1286,"_23648":1155,"_16085":40769,"_5":15974,"_22319":40417,"_1957":40770},[],"`/simpleenroll`: initial certificate enrollment.",{"_2384":1287,"_23648":1155,"_16085":40772,"_5":15974,"_22319":40417,"_1957":40773},[],"`/simplereenroll`: renewal of an already-issued certificate.",{"_2384":1288,"_23648":1155,"_16085":40775,"_5":15974,"_22319":40417,"_1957":40776},[],"`/serverkeygen`: enrollment with server-side key generation.",{"_2384":1289,"_23648":1155,"_16085":40778,"_5":15974,"_22319":40421,"_1957":40779},[],"The endpoint `GET /.well-known/est/{aps}/cacerts` distributes the certificates the device needs to validate the EST server and the rest of the CAs managed by the DMS. Lamassu inserts the certificates in this order: first the **downstream** certificate of the Lamassu server, which is the server's TLS leaf and not a CA, useful for pinning if `IncludeLamassuSystemCA` is enabled; then the `ManagedCAs` list declared in the DMS; and last the enrollment CA, if `IncludeEnrollmentCA` is enabled.",{"_2384":1290,"_23648":1155,"_16085":40781,"_5":15974,"_22319":40421,"_1957":40782},[],"`CADistributionSettings` lets you decide what is published:",{"_2384":1291,"_23648":1155,"_16085":40784,"_5":15974,"_22319":40421,"_1957":40785},[],"**`IncludeLamassuSystemCA`** adds the *downstream* certificate of the Lamassu server. It is the TLS leaf the client can use to pin the connection, not a CA.",{"_2384":1292,"_23648":1155,"_16085":40787,"_5":15974,"_22319":40421,"_1957":40788},[],"**`IncludeEnrollmentCA`** adds the DMS's issuing CA, responsible for signing device certificates.",{"_2384":1293,"_23648":1155,"_16085":40790,"_5":15974,"_22319":40421,"_1957":40791},[],"**`ManagedCAs`** publishes additional CAs as trust anchors.",{"_2384":1294,"_23648":1155,"_16085":40793,"_5":15974,"_22319":40421,"_1957":40794},[],"The default format is *degenerate* PKCS#7 (certificates only) base64-encoded. The response declares `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The base64 is wrapped in lines of **76 characters** terminated with CRLF, a width compliant with S/MIME (RFC 5751), not the 64 that some RFC 7030 guides suggest. This wrapping applies only to `/cacerts` and `/simpleenroll`; the internal parts of `/serverkeygen` carry no wrap, as explained below.",{"_2384":1295,"_23648":1155,"_16085":40796,"_5":15974,"_22319":40421,"_1957":40797},[],"*Degenerate* PKCS#7 is a **set** of certificates with no defined semantic order. Although Lamassu inserts them in the order stated, the integrator must not assume that order when validating chains: the chain must be built by `Subject`/`Issuer` matching (or by AKI/SKI), not by position in the response.",{"_2384":1296,"_23648":1155,"_16085":40799,"_5":15974,"_22319":40421,"_1957":40800},[],"The `-i` flag (ignore garbage) helps tolerate the CRLF Lamassu adds and is necessary on some `base64` implementations (BusyBox, BSD); on GNU coreutils it is ignored.",{"_2384":1297,"_23648":1155,"_16085":40802,"_5":15974,"_22319":40421,"_1957":40803},[],"Lamassu additionally adds an extension over the RFC: if the client sends the `Accept: application/x-pem-file` header, the server responds with the PEM concatenation of the same certificates, without the PKCS#7 wrapper. This makes consumption from scripts easier. The extension also works on `/simpleenroll` and `/simplereenroll`.",{"_2384":1298,"_23648":1155,"_16085":40805,"_5":15974,"_22319":40425,"_1957":40806},[],"The endpoint `POST /.well-known/est/{aps}/simpleenroll` receives a CSR and returns the issued certificate. The request body must be the **PKCS#10 (CSR) in DER, base64-encoded** without line breaks. The base64 wraps the DER directly, not a PEM. The `Content-Type` header must be `application/pkcs10`. If the `Content-Type` is different, the server responds `400` with `content-type must be application/pkcs10`; if the body is not valid base64, it responds `400` with `body payload must be base64 encoded`.",{"_2384":1299,"_23648":1155,"_16085":40808,"_5":15974,"_22319":40425,"_1957":40809},[],"The response follows the same wrapper as `/cacerts`: *degenerate* PKCS#7 in base64, with `Content-Type: application/pkcs7-mime; smime-type=certs-only`. The PKCS#7 contains **only the newly issued leaf certificate**; it does not include the issuing CA or intermediates. This complies with RFC 7030 §4.2.3 (where the chain is optional) but implies the integrator must combine this certificate with the chain obtained from `/cacerts` before presenting it to any relying party that validates the full chain (for example, an MQTT broker with strict mTLS).",{"_2384":1300,"_23648":1155,"_16085":40811,"_5":15974,"_22319":40425,"_1957":40812},[],"Several DMS fields govern the behavior of `/simpleenroll`. The integrator does not configure them, but it helps to know them to interpret rejections:",{"_2384":1301,"_23648":1155,"_16085":40814,"_5":15974,"_22319":40425,"_1957":40815},[],"**`EnrollmentSettings.RegistrationMode`** decides whether the device is created during the first enrollment (`JITP`) or must exist beforehand (`PRE_REGISTRATION`).",{"_2384":1302,"_23648":1155,"_16085":40817,"_5":15974,"_22319":40425,"_1957":40818},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** allows repeating `/simpleenroll` for an already-enrolled device. When doing so, it revokes the previous certificate as `superseded`; if disabled, the server responds with `forbiddenNewEnrollment`.",{"_2384":1303,"_23648":1155,"_16085":40820,"_5":15974,"_22319":40425,"_1957":40821},[],"**`EnrollmentSettings.VerifyCSRSignature`** validates that whoever submits the CSR controls the declared private key. For IoT fleets on open networks it must be enabled.",{"_2384":1304,"_23648":1155,"_16085":40823,"_5":15974,"_22319":40425,"_1957":40824},[],"In `JITP` mode, the first `simpleenroll` with a `CommonName` that does not yet exist in Lamassu creates the device automatically. In `PRE_REGISTRATION` mode, the device must exist beforehand; an unknown `CommonName` is rejected with `device not preregistered`. See Enrollment configuration for more details on both modes and the behavior of the issuance profile.",{"_2384":1305,"_23648":1155,"_16085":40826,"_5":15974,"_22319":40429,"_1957":40827},[],"The endpoint `POST /.well-known/est/{aps}/simplereenroll` renews the certificate of an already-enrolled device. The body format is identical to `/simpleenroll` (DER base64 without line breaks, `Content-Type: application/pkcs10`). The difference lies in authentication: the client must present **the device's active certificate** (not the bootstrap) as the mTLS credential.",{"_2384":1306,"_23648":1155,"_16085":40829,"_5":15974,"_22319":40429,"_1957":40830},[],"If the DMS is configured with `AuthMode: EXTERNAL_WEBHOOK`, the webhook is **not invoked** during `/simplereenroll`. The renewal flow silently degrades to `NO_AUTH`: any client that knows a valid `CommonName` can request reenroll for that device without authentication (`allowing reenroll: using NO AUTH mode` in the log). A DMS with `EXTERNAL_WEBHOOK` must not be used in production for reenroll flows unless access to the endpoint is network-controlled.",{"_2384":1307,"_23648":1155,"_16085":40832,"_5":15974,"_22319":40429,"_1957":40833},[],"The behavior of reenroll is governed by several `ReEnrollmentSettings` fields:",{"_2384":1308,"_23648":1155,"_16085":40835,"_5":15974,"_22319":40429,"_1957":40836},[],"**`ReEnrollmentDelta`** opens the renewal window at `NotAfter - ReEnrollmentDelta`. Before that instant, the server responds with `invalid reenroll window`.",{"_2384":1309,"_23648":1155,"_16085":40838,"_5":15974,"_22319":40429,"_1957":40839},[],"**`EnableExpiredRenewal`** allows using an already-expired certificate as proof of identity; if disabled, the server responds with `expired certificate`.",{"_2384":1310,"_23648":1155,"_16085":40841,"_5":15974,"_22319":40429,"_1957":40842},[],"**`RevokeOnReEnrollment`** revokes the previous certificate as `superseded` after issuing the new one.",{"_2384":1311,"_23648":1155,"_16085":40844,"_5":15974,"_22319":40429,"_1957":40845},[],"**`AdditionalValidationCAs`** adds valid issuers for the current certificate, in addition to the DMS's enrollment CA.",{"_2384":1312,"_23648":1155,"_16085":40847,"_5":15974,"_22319":40429,"_1957":40848},[],"**Subject immutability**: the renewal CSR must have exactly the same subject as the active certificate. Lamassu compares, byte by byte, the `RawSubject` of the CSR with the certificate's (`slices.Compare`). If the bytes differ, the server falls back to a semantic comparison over the `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` and `Country` attributes. If all those attributes match, the reenroll continues despite the byte difference (rescuing cases where only the encoding changes, `PrintableString` versus `UTF8String`). If any attribute differs, the reenroll aborts with `invalid RawSubject bytes`. The integrator must regenerate the CSR with exactly the same subject as in the initial enrollment to avoid depending on fallback behavior.",{"_2384":1313,"_23648":1155,"_16085":40850,"_5":15974,"_22319":40429,"_1957":40851},[],"**Validation of the presented certificate's chain**: validation is first attempted against the DMS's enrollment CA; if it fails, it walks the `AdditionalValidationCAs`. Validation is \"shallow\": each CA is tested as an anchor, no multi-level chain is composed. The client must present the complete chain in the mTLS handshake. A revoked certificate aborts the reenroll with `certificate is revoked`.",{"_2384":1314,"_23648":1155,"_16085":40853,"_5":15974,"_22319":40433,"_1957":40854},[],"The endpoint `POST /.well-known/est/{aps}/serverkeygen` lets Lamassu generate the device's key pair on the server and return, in the same response, the private key and the issued certificate. It is useful for devices with limited cryptographic capability or flows where the key is provisioned during manufacturing.",{"_2384":1315,"_23648":1155,"_16085":40856,"_5":15974,"_22319":40433,"_1957":40857},[],"This endpoint requires `ServerKeyGen.Enabled` to be `true` in the DMS. If it is not enabled, the server responds with `server key generation not enabled`. Authentication applies the same way as in `/simpleenroll`: the integrator presents the credential matching the DMS's `AuthMode`.",{"_2384":1316,"_23648":1155,"_16085":40859,"_5":15974,"_22319":40433,"_1957":40860},[],"The algorithm and size of the generated key are decided by the DMS, not by the client.",{"_2384":1317,"_23648":1155,"_16085":40862,"_5":15974,"_22319":40433,"_1957":40863},[],"**RSA** supports any size accepted by `crypto/rsa`; common values are 2048, 3072 and 4096 bits. An invalid value fails generation with a `500` error.",{"_2384":1318,"_23648":1155,"_16085":40865,"_5":15974,"_22319":40433,"_1957":40866},[],"**ECDSA** supports 224, 256, 384 and 521 bits, equivalent to P-224, P-256 (`prime256v1`), P-384 and P-521. Any other value **silently** degrades to P-256 and only leaves a warning in the log: the client receives no error and may obtain a curve different from the expected one.",{"_2384":1319,"_23648":1155,"_16085":40868,"_5":15974,"_22319":40433,"_1957":40869},[],"The CSR sent by the client serves only to carry the subject and extensions; the PKCS#10 proof of possession does not apply here because the client is not the one who generated the key. Lamassu discards the original CSR's public key, generates a new key pair with its internal entropy, in a software engine and not in a hardware Crypto Engine such as AWS KMS or PKCS#11, builds a new CSR with that key and proceeds with an internal enrollment equivalent to `/simpleenroll`.",{"_2384":1320,"_23648":1155,"_16085":40871,"_5":15974,"_22319":40433,"_1957":40872},[],"The response is a `multipart/mixed` with the literal boundary `estServerLamassuBoundary`. It contains two parts:",{"_2384":1321,"_23648":1155,"_16085":40874,"_5":15974,"_22319":40433,"_1957":40875},[],"The private key in **unencrypted PKCS#8** format, base64-encoded inside a part with `Content-Type: application/pkcs8`.",{"_2384":1322,"_23648":1155,"_16085":40877,"_5":15974,"_22319":40433,"_1957":40878},[],"The issued certificate in *degenerate* PKCS#7 base64, inside a part with `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_2384":1323,"_23648":1155,"_16085":40880,"_5":15974,"_22319":40433,"_1957":40881},[],"Unlike `/cacerts` and `/simpleenroll`, where the base64 is wrapped in 76-character lines, each part of `/serverkeygen` travels as **a single base64 line without breaks**. Any reverse proxy that rewrites the body (for example, normalizing line endings) can break the parsing.",{"_2384":1324,"_23648":1155,"_16085":40883,"_5":15974,"_22319":40433,"_1957":40884},[],"This endpoint reverses the PKI principle whereby the subscriber controls its own private key. The key is serialized as unencrypted PKCS#8 (`PrivateKeyInfo`, without `EncryptedPrivateKeyInfo`). The CMS `EnvelopedData` wrapper contemplated in RFC 7030 §4.4.2 is not applied; no AES key wrap or password-based symmetric encryption is used. The only protection is the channel's TLS. The integrator must guarantee that: (a) no reverse proxy terminates TLS and logs the response body; (b) the key is encrypted at rest immediately after receipt; (c) the audit account on the Lamassu server remains the single point of origin of the key.",{"_2384":1325,"_23648":1155,"_16085":40886,"_5":15974,"_22319":40433,"_1957":40887},[],"To separate the two parts, the following snippet uses `awk` with the literal boundary. It works with Lamassu's exact structure (each part = headers + blank line + a single base64 line); any intermediate proxy rewriting the body will break it.",{"_2384":1326,"_23648":1155,"_16085":40889,"_5":15974,"_22319":40437,"_1957":40890},[],"Once the endpoints have been reviewed individually, these examples show how to chain them in two common scenarios: the initial enrollment of a device and the renewal of an already-issued certificate.",{"_2384":1327,"_23648":1155,"_16085":40892,"_5":15974,"_22319":40441,"_1957":40893},[],"The following script illustrates the complete process of enrolling a device with a locally generated EC P-256 key and mTLS authentication against a bootstrap certificate.",{"_2384":1328,"_23648":1155,"_16085":40895,"_5":15974,"_22319":40445,"_1957":40896},[],"The following script reproduces a renewal process: it detects the expiration of the current certificate, regenerates the CSR with the **same subject** and authenticates with the active certificate.",{"_2384":1329,"_23648":1155,"_16085":40898,"_5":15974,"_22319":40449,"_1957":40899},[],"Once the device has obtained its identity certificate, the usual steps are:",{"_2384":1330,"_23648":1155,"_16085":40901,"_5":15974,"_22319":40449,"_1957":40902},[],"**Install the trust chain** (`cacerts.pem`) into the device's trust store. The MQTT broker, the HTTPS server or any relying party validating mTLS will need this chain.",{"_2384":1331,"_23648":1155,"_16085":40904,"_5":15974,"_22319":40449,"_1957":40905},[],"**Combine the leaf certificate with the chain** before presenting it in mTLS connections. The `/simpleenroll` response contains only the leaf certificate; the relying party may reject the connection if it does not receive the full chain.",{"_2384":1332,"_23648":1155,"_16085":40907,"_5":15974,"_22319":40449,"_1957":40908},[],"**Plan renewal**: configure a timer on the device that invokes `/simplereenroll` within the `ReEnrollmentDelta` window before the certificate expires. Do not wait for expiry unless `EnableExpiredRenewal` is enabled.",{"_2384":1333,"_23648":1155,"_16085":40910,"_5":15974,"_22319":40457,"_1957":40911},[],"Lamassu maps almost every business error to `500 Internal Server Error`, not to `4xx`. The HTTP status code is not enough to distinguish a network error from a policy error. The integrator must inspect the `err` field of the JSON body (`{\"err\": \"<message>\"}`) to determine the exact cause of the failure.",{"_2384":1334,"_23648":1155,"_16085":40913,"_5":15974,"_22319":40457,"_1957":40914},[],"HTTP",{"_2384":1335,"_23648":1155,"_16085":40916,"_5":15974,"_22319":40457,"_1957":40917},[],"Message",{"_2384":1336,"_23648":1155,"_16085":40919,"_5":15974,"_22319":40457,"_1957":40920},[],"Cause",{"_2384":1337,"_23648":1155,"_16085":40922,"_5":15974,"_22319":40457,"_1957":40923},[],"Integrator action",{"_2384":1338,"_23648":1155,"_16085":40925,"_5":15974,"_22319":40457,"_1957":22934},[],{"_2384":1339,"_23648":1155,"_16085":40927,"_5":15974,"_22319":40457,"_1957":40928},[],"`Field validation for 'APS' failed`",{"_2384":1340,"_23648":1155,"_16085":40930,"_5":15974,"_22319":40457,"_1957":40931},[],"The `{aps}` segment is missing from the URL.",{"_2384":1341,"_23648":1155,"_16085":40933,"_5":15974,"_22319":40457,"_1957":40934},[],"Include the DMS ID in the path.",{"_2384":1342,"_23648":1155,"_16085":40936,"_5":15974,"_22319":40457,"_1957":22934},[],{"_2384":1343,"_23648":1155,"_16085":40938,"_5":15974,"_22319":40457,"_1957":40939},[],"`content-type must be application/pkcs10`",{"_2384":1344,"_23648":1155,"_16085":40941,"_5":15974,"_22319":40457,"_1957":40942},[],"`Content-Type` header missing or incorrect.",{"_2384":1345,"_23648":1155,"_16085":40944,"_5":15974,"_22319":40457,"_1957":40945},[],"Set `Content-Type: application/pkcs10`.",{"_2384":1346,"_23648":1155,"_16085":40947,"_5":15974,"_22319":40457,"_1957":22934},[],{"_2384":1347,"_23648":1155,"_16085":40949,"_5":15974,"_22319":40457,"_1957":40950},[],"`body payload must be base64 encoded`",{"_2384":1348,"_23648":1155,"_16085":40952,"_5":15974,"_22319":40457,"_1957":40953},[],"The body is not valid base64.",{"_2384":1349,"_23648":1155,"_16085":40955,"_5":15974,"_22319":40457,"_1957":40956},[],"Use `base64 -w 0` to avoid line breaks.",{"_2384":1350,"_23648":1155,"_16085":40958,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1351,"_23648":1155,"_16085":40960,"_5":15974,"_22319":40457,"_1957":40961},[],"`DMS not found`",{"_2384":1352,"_23648":1155,"_16085":40963,"_5":15974,"_22319":40457,"_1957":40964},[],"The `{aps}` value does not match any DMS.",{"_2384":1353,"_23648":1155,"_16085":40966,"_5":15974,"_22319":40457,"_1957":40967},[],"Verify the identifier with the PKI administrator.",{"_2384":1354,"_23648":1155,"_16085":40969,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1355,"_23648":1155,"_16085":40971,"_5":15974,"_22319":40457,"_1957":40972},[],"`invalid certificate`",{"_2384":1356,"_23648":1155,"_16085":40974,"_5":15974,"_22319":40457,"_1957":40975},[],"The client certificate is not valid against `ValidationCAs`.",{"_2384":1357,"_23648":1155,"_16085":40977,"_5":15974,"_22319":40457,"_1957":40978},[],"Check the bootstrap certificate chain.",{"_2384":1358,"_23648":1155,"_16085":40980,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1359,"_23648":1155,"_16085":40982,"_5":15974,"_22319":40457,"_1957":40983},[],"`certificate is revoked`",{"_2384":1360,"_23648":1155,"_16085":40985,"_5":15974,"_22319":40457,"_1957":40986},[],"The certificate **presented as the mTLS credential** is revoked in Lamassu or via external OCSP/CRL.",{"_2384":1361,"_23648":1155,"_16085":40988,"_5":15974,"_22319":40457,"_1957":40989},[],"Request a new bootstrap certificate or investigate the revocation.",{"_2384":1362,"_23648":1155,"_16085":40991,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1363,"_23648":1155,"_16085":40993,"_5":15974,"_22319":40457,"_1957":40994},[],"`revoked certificate`",{"_2384":1364,"_23648":1155,"_16085":40996,"_5":15974,"_22319":40457,"_1957":40997},[],"In reenroll, the device's **active certificate in the database** is listed as revoked.",{"_2384":1365,"_23648":1155,"_16085":40999,"_5":15974,"_22319":40457,"_1957":41000},[],"Review the identity slot status; if the revocation was intentional, issue a new enroll instead of reenroll.",{"_2384":1366,"_23648":1155,"_16085":41002,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1367,"_23648":1155,"_16085":41004,"_5":15974,"_22319":40457,"_1957":41005},[],"`expired certificate`",{"_2384":1368,"_23648":1155,"_16085":41007,"_5":15974,"_22319":40457,"_1957":41008},[],"The presented certificate has expired and the DMS does not allow `AllowExpired`/`EnableExpiredRenewal`.",{"_2384":1369,"_23648":1155,"_16085":41010,"_5":15974,"_22319":40457,"_1957":41011},[],"Renew before expiration or request `EnableExpiredRenewal` to be enabled.",{"_2384":1370,"_23648":1155,"_16085":41013,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1371,"_23648":1155,"_16085":41015,"_5":15974,"_22319":40457,"_1957":41016},[],"`forbiddenNewEnrollment`",{"_2384":1372,"_23648":1155,"_16085":41018,"_5":15974,"_22319":40457,"_1957":41019},[],"The device is already enrolled and `EnableReplaceableEnrollment` is `false`.",{"_2384":1373,"_23648":1155,"_16085":41021,"_5":15974,"_22319":40457,"_1957":41022},[],"Use `/simplereenroll` or ask the administrator to enable the flag.",{"_2384":1374,"_23648":1155,"_16085":41024,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1375,"_23648":1155,"_16085":41026,"_5":15974,"_22319":40457,"_1957":41027},[],"`device not preregistered`",{"_2384":1376,"_23648":1155,"_16085":41029,"_5":15974,"_22319":40457,"_1957":41030},[],"The DMS is in `PRE_REGISTRATION` and the device does not exist.",{"_2384":1377,"_23648":1155,"_16085":41032,"_5":15974,"_22319":40457,"_1957":41033},[],"Register the device before enrolling it.",{"_2384":1378,"_23648":1155,"_16085":41035,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1379,"_23648":1155,"_16085":41037,"_5":15974,"_22319":40457,"_1957":41038},[],"`invalid reenroll window`",{"_2384":1380,"_23648":1155,"_16085":41040,"_5":15974,"_22319":40457,"_1957":41041},[],"Renewal attempted before `NotAfter - ReEnrollmentDelta`.",{"_2384":1381,"_23648":1155,"_16085":41043,"_5":15974,"_22319":40457,"_1957":41044},[],"Wait for the window to open or request a larger `ReEnrollmentDelta`.",{"_2384":1382,"_23648":1155,"_16085":41046,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1383,"_23648":1155,"_16085":41048,"_5":15974,"_22319":40457,"_1957":41049},[],"`invalid RawSubject bytes`",{"_2384":1384,"_23648":1155,"_16085":41051,"_5":15974,"_22319":40457,"_1957":41052},[],"The renewal CSR's subject does not match the active certificate's.",{"_2384":1385,"_23648":1155,"_16085":41054,"_5":15974,"_22319":40457,"_1957":41055},[],"Regenerate the CSR with the exact subject of the previous cert.",{"_2384":1386,"_23648":1155,"_16085":41057,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1387,"_23648":1155,"_16085":41059,"_5":15974,"_22319":40457,"_1957":41060},[],"`external webhook denied enrollment`",{"_2384":1388,"_23648":1155,"_16085":41062,"_5":15974,"_22319":40457,"_1957":41063},[],"The webhook returned a non-`2xx` code or `authorized != true`.",{"_2384":1389,"_23648":1155,"_16085":41065,"_5":15974,"_22319":40457,"_1957":41066},[],"Review the webhook service logs.",{"_2384":1390,"_23648":1155,"_16085":41068,"_5":15974,"_22319":40457,"_1957":22847},[],{"_2384":1391,"_23648":1155,"_16085":41070,"_5":15974,"_22319":40457,"_1957":41071},[],"`server key generation not enabled`",{"_2384":1392,"_23648":1155,"_16085":41073,"_5":15974,"_22319":40457,"_1957":41074},[],"`/serverkeygen` is disabled on the DMS.",{"_2384":1393,"_23648":1155,"_16085":41076,"_5":15974,"_22319":40457,"_1957":41077},[],"Ask the administrator to enable `ServerKeyGen.Enabled`.",{"_2384":1394,"_23648":1155,"_16085":41079,"_5":15974,"_22319":40457,"_1957":41080},[],"For messages not listed in this table, the Lamassu server logs (with the fields `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) are the first place to look for the cause.",{"_2384":1395,"_23648":1155,"_16085":41082,"_5":15974,"_22319":40461,"_1957":41083},[],"Lamassu's implementation follows RFC 7030 in its essentials but introduces several quirks that can affect strict EST clients or third-party libraries:",{"_2384":1396,"_23648":1155,"_16085":41085,"_5":15974,"_22319":40461,"_1957":41086},[],"The `/csrattrs` and `/fullcmc` endpoints of RFC 7030 are **not implemented** in Lamassu. A client invoking `/.well-known/est/<DMS_ID>/csrattrs` receives `404 Not Found` instead of the `204 No Content` the RFC suggests for \"no attributes\". Strict EST libraries must be configured not to attempt `csrattrs`.",{"_2384":1397,"_23648":1155,"_16085":41088,"_5":15974,"_22319":40461,"_1957":41089},[],"The base64 of the `/cacerts` and `/simpleenroll` responses is wrapped in lines of **76 characters** terminated with CRLF (S/MIME compliant, RFC 5751). The parts of `/serverkeygen` apply no wrap.",{"_2384":1398,"_23648":1155,"_16085":41091,"_5":15974,"_22319":40461,"_1957":41092},[],"The `multipart/mixed` boundary in `/serverkeygen` is fixed and cannot be negotiated.",{"_2384":1399,"_23648":1155,"_16085":41094,"_5":15974,"_22319":40461,"_1957":41095},[],"The `{aps}` segment is **mandatory** in all EST routes. Routes registered without `{aps}` are in the code but respond `400`.",{"_2384":1400,"_23648":1155,"_16085":41097,"_5":15974,"_22319":40461,"_1957":41098},[],"The body of `/cacerts`, `/simpleenroll` and `/simplereenroll` can be returned as concatenated PEM if the client sends `Accept: application/x-pem-file`. This is a Lamassu-specific extension and does not appear in the RFC.",{"_2384":1401,"_23648":1155,"_16085":41100,"_5":15974,"_22319":40461,"_1957":41101},[],"The server does not explicitly reject CSRs signed with SHA-1 or MD5; the integrator must generate the CSR with SHA-256 or higher.",{"_2384":1402,"_23648":1155,"_16085":41103,"_5":15974,"_22319":40461,"_1957":41104},[],"<Card title=\"DMS overview\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2384":1403,"_23648":1155,"_16085":41106,"_5":15974,"_22319":40461,"_1957":41107},[],"<Card title=\"OCSP validation\" href=\"/docs/platform/pki/ocsp\" />",{"_2384":1404,"_23648":1155,"_16085":41109,"_5":15974,"_22319":40461,"_1957":41110},[],"<Card title=\"Manage devices\" href=\"/docs/platform/pki/device-management\" />",{"_2384":1405,"_23648":1405,"_5":10988,"_1957":41112,"_23928":41113,"_16085":41115,"_22319":1405},"AWS IoT Core",[36699,38037,41114],"Integrations",[],{"_2384":1406,"_23648":1405,"_16085":41117,"_5":15974,"_22319":1405,"_1957":41118},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2384":1407,"_23648":1405,"_5":23925,"_16085":41120,"_22319":41121,"_1957":41122},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2384":1408,"_23648":1405,"_5":23925,"_16085":41124,"_22319":41125,"_1957":40371},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#prerequisites",{"_2384":1409,"_23648":1405,"_5":23925,"_16085":41127,"_22319":41128,"_1957":41129},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2384":1410,"_23648":1405,"_5":23925,"_16085":41131,"_22319":41132,"_1957":41133},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2384":1411,"_23648":1405,"_5":23925,"_16085":41135,"_22319":41136,"_1957":41137},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2384":1412,"_23648":1405,"_5":23925,"_16085":41139,"_22319":41140,"_1957":41141},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2384":1413,"_23648":1405,"_5":23925,"_16085":41143,"_22319":41144,"_1957":41145},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_2384":1414,"_23648":1405,"_5":23925,"_16085":41147,"_22319":41148,"_1957":41149},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2384":1415,"_23648":1405,"_5":23925,"_16085":41151,"_22319":41152,"_1957":40367},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#dms-configuration",{"_2384":1416,"_23648":1405,"_5":23925,"_16085":41154,"_22319":41155,"_1957":41156},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#none-mode","`none` mode",{"_2384":1417,"_23648":1405,"_5":23925,"_16085":41158,"_22319":41159,"_1957":41160},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2384":1418,"_23648":1405,"_5":23925,"_16085":41162,"_22319":41163,"_1957":41164},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2384":1419,"_23648":1405,"_5":23925,"_16085":41166,"_22319":41167,"_1957":41168},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2384":1420,"_23648":1405,"_5":23925,"_16085":41170,"_22319":41171,"_1957":41172},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2384":1421,"_23648":1405,"_5":23925,"_16085":41174,"_22319":41175,"_1957":41176},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2384":1422,"_23648":1405,"_5":23925,"_16085":41178,"_22319":41179,"_1957":41180},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2384":1423,"_23648":1405,"_5":23925,"_16085":41182,"_22319":41183,"_1957":41184},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2384":1424,"_23648":1405,"_5":23925,"_16085":41186,"_22319":41187,"_1957":41188},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2384":1425,"_23648":1405,"_5":23925,"_16085":41190,"_22319":41191,"_1957":41192},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2384":1426,"_23648":1405,"_5":23925,"_16085":41194,"_22319":41195,"_1957":37471},[],"/docs/pr-preview/pr-26/platform/pki/integrations/aws-iot-core#troubleshooting",{"_2384":1427,"_23648":1405,"_16085":41197,"_5":15974,"_22319":1405,"_1957":41198},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2384":1428,"_23648":1405,"_16085":41200,"_5":15974,"_22319":1405,"_1957":41201},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2384":1429,"_23648":1405,"_16085":41203,"_5":15974,"_22319":1405,"_1957":41204},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2384":1430,"_23648":1405,"_16085":41206,"_5":15974,"_22319":41121,"_1957":41207},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2384":1431,"_23648":1405,"_16085":41209,"_5":15974,"_22319":41121,"_1957":41210},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2384":1432,"_23648":1405,"_16085":41212,"_5":15974,"_22319":41121,"_1957":41213},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2384":1433,"_23648":1405,"_16085":41215,"_5":15974,"_22319":41121,"_1957":41216},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2384":1434,"_23648":1405,"_16085":41218,"_5":15974,"_22319":41125,"_1957":41219},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2384":1435,"_23648":1405,"_16085":41221,"_5":15974,"_22319":41128,"_1957":41222},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2384":1436,"_23648":1405,"_16085":41224,"_5":15974,"_22319":41128,"_1957":41225},[],"IAM action",{"_2384":1437,"_23648":1405,"_16085":41227,"_5":15974,"_22319":41128,"_1957":37085},[],{"_2384":1438,"_23648":1405,"_16085":41229,"_5":15974,"_22319":41128,"_1957":41230},[],"`iot:GetRegistrationCode`",{"_2384":1439,"_23648":1405,"_16085":41232,"_5":15974,"_22319":41128,"_1957":41233},[],"Obtain the verification code for CA registration in the Primary Account",{"_2384":1440,"_23648":1405,"_16085":41235,"_5":15974,"_22319":41128,"_1957":41236},[],"`iot:RegisterCACertificate`",{"_2384":1441,"_23648":1405,"_16085":41238,"_5":15974,"_22319":41128,"_1957":41239},[],"Register the CA in AWS IoT",{"_2384":1442,"_23648":1405,"_16085":41241,"_5":15974,"_22319":41128,"_1957":41242},[],"`iot:DescribeCACertificate`",{"_2384":1443,"_23648":1405,"_16085":41244,"_5":15974,"_22319":41128,"_1957":41245},[],"Check the CA registration status",{"_2384":1444,"_23648":1405,"_16085":41247,"_5":15974,"_22319":41128,"_1957":41248},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2384":1445,"_23648":1405,"_16085":41250,"_5":15974,"_22319":41128,"_1957":41251},[],"Create or update Things in IoT Core",{"_2384":1446,"_23648":1405,"_16085":41253,"_5":15974,"_22319":41128,"_1957":41254},[],"`iot:RegisterThing`",{"_2384":1447,"_23648":1405,"_16085":41256,"_5":15974,"_22319":41128,"_1957":41257},[],"Provision Things through a template",{"_2384":1448,"_23648":1405,"_16085":41259,"_5":15974,"_22319":41128,"_1957":41260},[],"`iot:RegisterCertificate`",{"_2384":1449,"_23648":1405,"_16085":41262,"_5":15974,"_22319":41128,"_1957":41263},[],"Register device certificates",{"_2384":1450,"_23648":1405,"_16085":41265,"_5":15974,"_22319":41128,"_1957":41266},[],"`iot:UpdateCertificate`",{"_2384":1451,"_23648":1405,"_16085":41268,"_5":15974,"_22319":41128,"_1957":41269},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2384":1452,"_23648":1405,"_16085":41271,"_5":15974,"_22319":41128,"_1957":41272},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2384":1453,"_23648":1405,"_16085":41274,"_5":15974,"_22319":41128,"_1957":41275},[],"Create and attach IoT policies",{"_2384":1454,"_23648":1405,"_16085":41277,"_5":15974,"_22319":41128,"_1957":41278},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2384":1455,"_23648":1405,"_16085":41280,"_5":15974,"_22319":41128,"_1957":41281},[],"Manage Thing groups",{"_2384":1456,"_23648":1405,"_16085":41283,"_5":15974,"_22319":41128,"_1957":41284},[],"`iot:CreateProvisioningTemplate`",{"_2384":1457,"_23648":1405,"_16085":41286,"_5":15974,"_22319":41128,"_1957":41287},[],"Create JITP templates",{"_2384":1458,"_23648":1405,"_16085":41289,"_5":15974,"_22319":41128,"_1957":41290},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2384":1459,"_23648":1405,"_16085":41292,"_5":15974,"_22319":41128,"_1957":41293},[],"Read and write the Device Shadow",{"_2384":1460,"_23648":1405,"_16085":41295,"_5":15974,"_22319":41128,"_1957":41296},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2384":1461,"_23648":1405,"_16085":41298,"_5":15974,"_22319":41132,"_1957":41299},[],"Parameter",{"_2384":1462,"_23648":1405,"_16085":41301,"_5":15974,"_22319":41132,"_1957":41302},[],"Type",{"_2384":1463,"_23648":1405,"_16085":41304,"_5":15974,"_22319":41132,"_1957":41305},[],"Required",{"_2384":1464,"_23648":1405,"_16085":41307,"_5":15974,"_22319":41132,"_1957":40067},[],{"_2384":1465,"_23648":1405,"_16085":41309,"_5":15974,"_22319":41132,"_1957":41310},[],"`connector_id`",{"_2384":1466,"_23648":1405,"_16085":41312,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1467,"_23648":1405,"_16085":41314,"_5":15974,"_22319":41132,"_1957":40695},[],{"_2384":1468,"_23648":1405,"_16085":41316,"_5":15974,"_22319":41132,"_1957":41317},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2384":1469,"_23648":1405,"_16085":41319,"_5":15974,"_22319":41132,"_1957":41320},[],"`aws_config.region`",{"_2384":1470,"_23648":1405,"_16085":41322,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1471,"_23648":1405,"_16085":41324,"_5":15974,"_22319":41132,"_1957":40695},[],{"_2384":1472,"_23648":1405,"_16085":41326,"_5":15974,"_22319":41132,"_1957":41327},[],"AWS region where the connector operates.",{"_2384":1473,"_23648":1405,"_16085":41329,"_5":15974,"_22319":41132,"_1957":41330},[],"`aws_config.auth_method`",{"_2384":1474,"_23648":1405,"_16085":41332,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1475,"_23648":1405,"_16085":41334,"_5":15974,"_22319":41132,"_1957":40695},[],{"_2384":1476,"_23648":1405,"_16085":41336,"_5":15974,"_22319":41132,"_1957":41337},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2384":1477,"_23648":1405,"_16085":41339,"_5":15974,"_22319":41132,"_1957":41340},[],"`aws_config.access_key_id`",{"_2384":1478,"_23648":1405,"_16085":41342,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1479,"_23648":1405,"_16085":41344,"_5":15974,"_22319":41132,"_1957":41345},[],"Only with `auth_method=static`",{"_2384":1480,"_23648":1405,"_16085":41347,"_5":15974,"_22319":41132,"_1957":41348},[],"AWS access key.",{"_2384":1481,"_23648":1405,"_16085":41350,"_5":15974,"_22319":41132,"_1957":41351},[],"`aws_config.secret_access_key`",{"_2384":1482,"_23648":1405,"_16085":41353,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1483,"_23648":1405,"_16085":41355,"_5":15974,"_22319":41132,"_1957":41345},[],{"_2384":1484,"_23648":1405,"_16085":41357,"_5":15974,"_22319":41132,"_1957":41358},[],"AWS secret key.",{"_2384":1485,"_23648":1405,"_16085":41360,"_5":15974,"_22319":41132,"_1957":41361},[],"`aws_config.session_token`",{"_2384":1486,"_23648":1405,"_16085":41363,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1487,"_23648":1405,"_16085":41365,"_5":15974,"_22319":41132,"_1957":41366},[],"No",{"_2384":1488,"_23648":1405,"_16085":41368,"_5":15974,"_22319":41132,"_1957":41369},[],"Session token (with `auth_method=static`).",{"_2384":1489,"_23648":1405,"_16085":41371,"_5":15974,"_22319":41132,"_1957":41372},[],"`aws_config.role_arn`",{"_2384":1490,"_23648":1405,"_16085":41374,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1491,"_23648":1405,"_16085":41376,"_5":15974,"_22319":41132,"_1957":41377},[],"Only with `auth_method=role`",{"_2384":1492,"_23648":1405,"_16085":41379,"_5":15974,"_22319":41132,"_1957":41380},[],"ARN of the role to assume.",{"_2384":1493,"_23648":1405,"_16085":41382,"_5":15974,"_22319":41132,"_1957":41383},[],"`aws_config.endpoint_url`",{"_2384":1494,"_23648":1405,"_16085":41385,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1495,"_23648":1405,"_16085":41387,"_5":15974,"_22319":41132,"_1957":41366},[],{"_2384":1496,"_23648":1405,"_16085":41389,"_5":15974,"_22319":41132,"_1957":41390},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2384":1497,"_23648":1405,"_16085":41392,"_5":15974,"_22319":41132,"_1957":41393},[],"`subscriber_event_bus`",{"_2384":1498,"_23648":1405,"_16085":41395,"_5":15974,"_22319":41132,"_1957":13454},[],{"_2384":1499,"_23648":1405,"_16085":41397,"_5":15974,"_22319":41132,"_1957":40695},[],{"_2384":1500,"_23648":1405,"_16085":41399,"_5":15974,"_22319":41132,"_1957":41400},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2384":1501,"_23648":1405,"_16085":41402,"_5":15974,"_22319":41132,"_1957":41403},[],"`dms_manager_client`",{"_2384":1502,"_23648":1405,"_16085":41405,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1503,"_23648":1405,"_16085":41407,"_5":15974,"_22319":41132,"_1957":40695},[],{"_2384":1504,"_23648":1405,"_16085":41409,"_5":15974,"_22319":41132,"_1957":41410},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2384":1505,"_23648":1405,"_16085":41412,"_5":15974,"_22319":41132,"_1957":41413},[],"`device_manager_client`",{"_2384":1506,"_23648":1405,"_16085":41415,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1507,"_23648":1405,"_16085":41417,"_5":15974,"_22319":41132,"_1957":40695},[],{"_2384":1508,"_23648":1405,"_16085":41419,"_5":15974,"_22319":41132,"_1957":41420},[],"HTTP URL of Lamassu's Device Manager.",{"_2384":1509,"_23648":1405,"_16085":41422,"_5":15974,"_22319":41132,"_1957":41423},[],"`ca_client`",{"_2384":1510,"_23648":1405,"_16085":41425,"_5":15974,"_22319":41132,"_1957":19440},[],{"_2384":1511,"_23648":1405,"_16085":41427,"_5":15974,"_22319":41132,"_1957":40695},[],{"_2384":1512,"_23648":1405,"_16085":41429,"_5":15974,"_22319":41132,"_1957":41430},[],"HTTP URL of Lamassu's CA service.",{"_2384":1513,"_23648":1405,"_16085":41432,"_5":15974,"_22319":41136,"_1957":41433},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2384":1514,"_23648":1405,"_16085":41435,"_5":15974,"_22319":41140,"_1957":41436},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2384":1515,"_23648":1405,"_16085":41438,"_5":15974,"_22319":41140,"_1957":41439},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2384":1516,"_23648":1405,"_16085":41441,"_5":15974,"_22319":41144,"_1957":41442},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2384":1517,"_23648":1405,"_16085":41444,"_5":15974,"_22319":41144,"_1957":41445},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2384":1518,"_23648":1405,"_16085":41447,"_5":15974,"_22319":41144,"_1957":41448},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2384":1519,"_23648":1405,"_16085":41450,"_5":15974,"_22319":41144,"_1957":41451},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2384":1520,"_23648":1405,"_16085":41453,"_5":15974,"_22319":41144,"_1957":41454},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2384":1521,"_23648":1405,"_16085":41456,"_5":15974,"_22319":41144,"_1957":41457},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2384":1522,"_23648":1405,"_16085":41459,"_5":15974,"_22319":41148,"_1957":41460},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2384":1523,"_23648":1405,"_16085":41462,"_5":15974,"_22319":41152,"_1957":41463},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2384":1524,"_23648":1405,"_16085":41465,"_5":15974,"_22319":41152,"_1957":41466},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2384":1525,"_23648":1405,"_16085":41468,"_5":15974,"_22319":41155,"_1957":41469},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2384":1526,"_23648":1405,"_16085":41471,"_5":15974,"_22319":41159,"_1957":41472},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2384":1527,"_23648":1405,"_16085":41474,"_5":15974,"_22319":41159,"_1957":41475},[],"Creates or updates the IoT policies configured in the DMS.",{"_2384":1528,"_23648":1405,"_16085":41477,"_5":15974,"_22319":41159,"_1957":41478},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2384":1529,"_23648":1405,"_16085":41480,"_5":15974,"_22319":41159,"_1957":41481},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2384":1530,"_23648":1405,"_16085":41483,"_5":15974,"_22319":41159,"_1957":41484},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2384":1531,"_23648":1405,"_16085":41486,"_5":15974,"_22319":41159,"_1957":41487},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2384":1532,"_23648":1405,"_16085":41489,"_5":15974,"_22319":41159,"_1957":41490},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2384":1533,"_23648":1405,"_16085":41492,"_5":15974,"_22319":41163,"_1957":41493},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2384":1534,"_23648":1405,"_16085":41495,"_5":15974,"_22319":41163,"_1957":41496},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2384":1535,"_23648":1405,"_16085":41498,"_5":15974,"_22319":41163,"_1957":41499},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2384":1536,"_23648":1405,"_16085":41501,"_5":15974,"_22319":41167,"_1957":41502},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2384":1537,"_23648":1405,"_16085":41504,"_5":15974,"_22319":41167,"_1957":41505},[],"The full flow from the device's perspective is:",{"_2384":1538,"_23648":1405,"_16085":41507,"_5":15974,"_22319":41167,"_1957":41508},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2384":1539,"_23648":1405,"_16085":41510,"_5":15974,"_22319":41171,"_1957":41511},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2384":1540,"_23648":1405,"_16085":41513,"_5":15974,"_22319":41171,"_1957":41514},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2384":1541,"_23648":1405,"_16085":41516,"_5":15974,"_22319":41171,"_1957":41517},[],"For the JITP flow to work correctly:",{"_2384":1542,"_23648":1405,"_16085":41519,"_5":15974,"_22319":41171,"_1957":41520},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2384":1543,"_23648":1405,"_16085":41522,"_5":15974,"_22319":41171,"_1957":41523},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2384":1544,"_23648":1405,"_16085":41525,"_5":15974,"_22319":41171,"_1957":41526},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2384":1545,"_23648":1405,"_16085":41528,"_5":15974,"_22319":41171,"_1957":41529},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2384":1546,"_23648":1405,"_16085":41531,"_5":15974,"_22319":41175,"_1957":41532},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2384":1547,"_23648":1405,"_16085":41534,"_5":15974,"_22319":41175,"_1957":41535},[],"Status in Lamassu",{"_2384":1548,"_23648":1405,"_16085":41537,"_5":15974,"_22319":41175,"_1957":41538},[],"Revocation reason",{"_2384":1549,"_23648":1405,"_16085":41540,"_5":15974,"_22319":41175,"_1957":41541},[],"Status in AWS IoT Core",{"_2384":1550,"_23648":1405,"_16085":41543,"_5":15974,"_22319":41175,"_1957":41544},[],"`Active`",{"_2384":1551,"_23648":1405,"_16085":41546,"_5":15974,"_22319":41175,"_1957":40735},[],{"_2384":1552,"_23648":1405,"_16085":41548,"_5":15974,"_22319":41175,"_1957":41549},[],"`ACTIVE`",{"_2384":1553,"_23648":1405,"_16085":41551,"_5":15974,"_22319":41175,"_1957":41552},[],"`Revoked`",{"_2384":1554,"_23648":1405,"_16085":41554,"_5":15974,"_22319":41175,"_1957":41555},[],"`certificateHold`",{"_2384":1555,"_23648":1405,"_16085":41557,"_5":15974,"_22319":41175,"_1957":41558},[],"`INACTIVE`",{"_2384":1556,"_23648":1405,"_16085":41560,"_5":15974,"_22319":41175,"_1957":41552},[],{"_2384":1557,"_23648":1405,"_16085":41562,"_5":15974,"_22319":41175,"_1957":41563},[],"Any other reason",{"_2384":1558,"_23648":1405,"_16085":41565,"_5":15974,"_22319":41175,"_1957":41566},[],"`REVOKED`",{"_2384":1559,"_23648":1405,"_16085":41568,"_5":15974,"_22319":41175,"_1957":41569},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2384":1560,"_23648":1405,"_16085":41571,"_5":15974,"_22319":41179,"_1957":41572},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2384":1561,"_23648":1405,"_16085":41574,"_5":15974,"_22319":41179,"_1957":41575},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2384":1562,"_23648":1405,"_16085":41577,"_5":15974,"_22319":41179,"_1957":41578},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2384":1563,"_23648":1405,"_16085":41580,"_5":15974,"_22319":41183,"_1957":41581},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2384":1564,"_23648":1405,"_16085":41583,"_5":15974,"_22319":41183,"_1957":41584},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2384":1565,"_23648":1405,"_16085":41586,"_5":15974,"_22319":41187,"_1957":41587},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2384":1566,"_23648":1405,"_16085":41589,"_5":15974,"_22319":41187,"_1957":41590},[],"There are two action types:",{"_2384":1567,"_23648":1405,"_16085":41592,"_5":15974,"_22319":41187,"_1957":41593},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2384":1568,"_23648":1405,"_16085":41595,"_5":15974,"_22319":41187,"_1957":41596},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2384":1569,"_23648":1405,"_16085":41598,"_5":15974,"_22319":41187,"_1957":41599},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2384":1570,"_23648":1405,"_16085":41601,"_5":15974,"_22319":41191,"_1957":41602},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2384":1571,"_23648":1405,"_16085":41604,"_5":15974,"_22319":41191,"_1957":41605},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2384":1572,"_23648":1405,"_16085":41607,"_5":15974,"_22319":41191,"_1957":41608},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2384":1573,"_23648":1405,"_16085":41610,"_5":15974,"_22319":41195,"_1957":41611},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2384":1574,"_23648":1405,"_16085":41613,"_5":15974,"_22319":41195,"_1957":41614},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2384":1575,"_23648":1405,"_16085":41616,"_5":15974,"_22319":41195,"_1957":41617},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2384":1576,"_23648":1405,"_16085":41619,"_5":15974,"_22319":41195,"_1957":41620},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2384":1577,"_23648":1405,"_16085":41622,"_5":15974,"_22319":41195,"_1957":41623},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2384":1578,"_23648":1405,"_16085":41625,"_5":15974,"_22319":41195,"_1957":41626},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2384":1579,"_23648":1405,"_16085":41628,"_5":15974,"_22319":41195,"_1957":41629},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2384":1580,"_23648":1405,"_16085":41631,"_5":15974,"_22319":41195,"_1957":41632},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2384":1581,"_23648":1405,"_16085":41634,"_5":15974,"_22319":41195,"_1957":41635},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2384":1582,"_23648":1405,"_16085":41637,"_5":15974,"_22319":41195,"_1957":41638},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2384":1583,"_23648":1405,"_16085":41640,"_5":15974,"_22319":41195,"_1957":41641},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2384":1584,"_23648":1405,"_16085":41643,"_5":15974,"_22319":41195,"_1957":41644},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2384":1585,"_23648":1405,"_16085":41646,"_5":15974,"_22319":41195,"_1957":41647},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2384":1586,"_23648":1405,"_16085":41649,"_5":15974,"_22319":41195,"_1957":41650},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2384":1587,"_23648":1405,"_16085":41652,"_5":15974,"_22319":41195,"_1957":41653},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2384":1588,"_23648":1405,"_16085":41655,"_5":15974,"_22319":41195,"_1957":41656},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2384":1589,"_23648":1405,"_16085":41658,"_5":15974,"_22319":41195,"_1957":41659},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2384":1590,"_23648":1405,"_16085":41661,"_5":15974,"_22319":41195,"_1957":41662},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2384":1591,"_23648":1405,"_16085":41664,"_5":15974,"_22319":41195,"_1957":41665},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2384":1592,"_23648":1405,"_16085":41667,"_5":15974,"_22319":41195,"_1957":41668},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2384":1593,"_23648":1405,"_16085":41670,"_5":15974,"_22319":41195,"_1957":41671},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2384":1594,"_23648":1594,"_5":10988,"_1957":41673,"_23928":41674,"_16085":41675,"_22319":1594},"Keys and cryptographic engines",[36699,38037,38515],[],{"_2384":1595,"_23648":1594,"_16085":41677,"_5":15974,"_22319":1594,"_1957":41678},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2384":1596,"_23648":1594,"_5":23925,"_16085":41680,"_22319":41681,"_1957":41682},[],"/docs/pr-preview/pr-26/platform/pki/key-management#cryptographic-key-management","Cryptographic key management",{"_2384":1597,"_23648":1594,"_5":23925,"_16085":41684,"_22319":41685,"_1957":41686},[],"/docs/pr-preview/pr-26/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2384":1598,"_23648":1594,"_5":23925,"_16085":41688,"_22319":41689,"_1957":41690},[],"/docs/pr-preview/pr-26/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2384":1599,"_23648":1594,"_5":23925,"_16085":41692,"_22319":41693,"_1957":41694},[],"/docs/pr-preview/pr-26/platform/pki/key-management#file-system","File System",{"_2384":1600,"_23648":1594,"_5":23925,"_16085":41696,"_22319":41697,"_1957":41698},[],"/docs/pr-preview/pr-26/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2384":1601,"_23648":1594,"_5":23925,"_16085":41700,"_22319":41701,"_1957":41702},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2384":1602,"_23648":1594,"_5":23925,"_16085":41704,"_22319":41705,"_1957":41706},[],"/docs/pr-preview/pr-26/platform/pki/key-management#aws-kms","AWS KMS",{"_2384":1603,"_23648":1594,"_5":23925,"_16085":41708,"_22319":41709,"_1957":41710},[],"/docs/pr-preview/pr-26/platform/pki/key-management#pkcs11","PKCS#11",{"_2384":1604,"_23648":1594,"_5":23925,"_16085":41712,"_22319":41713,"_1957":41714},[],"/docs/pr-preview/pr-26/platform/pki/key-management#key-inventory","Key inventory",{"_2384":1605,"_23648":1594,"_5":23925,"_16085":41716,"_22319":41717,"_1957":41718},[],"/docs/pr-preview/pr-26/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2384":1606,"_23648":1594,"_5":23925,"_16085":41720,"_22319":41721,"_1957":41722},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2384":1607,"_23648":1594,"_5":23925,"_16085":41724,"_22319":41725,"_1957":41726},[],"/docs/pr-preview/pr-26/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2384":1608,"_23648":1594,"_5":23925,"_16085":41728,"_22319":41729,"_1957":41730},[],"/docs/pr-preview/pr-26/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2384":1609,"_23648":1594,"_5":23925,"_16085":41732,"_22319":41733,"_1957":41734},[],"/docs/pr-preview/pr-26/platform/pki/key-management#view-details","View details",{"_2384":1610,"_23648":1594,"_5":23925,"_16085":41736,"_22319":41737,"_1957":41738},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2384":1611,"_23648":1594,"_5":23925,"_16085":41740,"_22319":41741,"_1957":41742},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign","Sign",{"_2384":1612,"_23648":1594,"_5":23925,"_16085":41744,"_22319":41745,"_1957":41746},[],"/docs/pr-preview/pr-26/platform/pki/key-management#verify","Verify",{"_2384":1613,"_23648":1594,"_5":23925,"_16085":41748,"_22319":41749,"_1957":41750},[],"/docs/pr-preview/pr-26/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2384":1614,"_23648":1594,"_5":23925,"_16085":41752,"_22319":41753,"_1957":41754},[],"/docs/pr-preview/pr-26/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2384":1615,"_23648":1594,"_16085":41756,"_5":15974,"_22319":41681,"_1957":41757},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2384":1616,"_23648":1594,"_16085":41759,"_5":15974,"_22319":41681,"_1957":41760},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2384":1617,"_23648":1594,"_16085":41762,"_5":15974,"_22319":41685,"_1957":41763},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2384":1618,"_23648":1594,"_16085":41765,"_5":15974,"_22319":41685,"_1957":41766},[],"In practice, it lets you:",{"_2384":1619,"_23648":1594,"_16085":41768,"_5":15974,"_22319":41685,"_1957":41769},[],"Generate new key pairs from Lamassu IoT.",{"_2384":1620,"_23648":1594,"_16085":41771,"_5":15974,"_22319":41685,"_1957":41772},[],"Import keys created externally.",{"_2384":1621,"_23648":1594,"_16085":41774,"_5":15974,"_22319":41685,"_1957":41775},[],"Delegate custody and cryptographic operations to external engines.",{"_2384":1622,"_23648":1594,"_16085":41777,"_5":15974,"_22319":41685,"_1957":41778},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2384":1623,"_23648":1594,"_16085":41780,"_5":15974,"_22319":41689,"_1957":41781},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2384":1624,"_23648":1594,"_16085":41783,"_5":15974,"_22319":41689,"_1957":41784},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2384":1625,"_23648":1594,"_16085":41786,"_5":15974,"_22319":41689,"_1957":41787},[],"Currently, Lamassu supports five engine types. Choose according to the isolation level you need and who should be able to access private material.",{"_2384":1626,"_23648":1594,"_16085":41789,"_5":15974,"_22319":41693,"_1957":41790},[],"Generates keys with Go's cryptographic libraries and delegates their protection to the file system. It works both on-premise and in the cloud, but it does not prevent key extraction and is not recommended for production.",{"_2384":1627,"_23648":1594,"_16085":41792,"_5":15974,"_22319":41697,"_1957":41793},[],"Protects keys at rest and can run on-premise or in the cloud. An administrator with sufficient permissions can still view private material, so it is wise to limit administrative access and safeguard the *unseal* keys.",{"_2384":1628,"_23648":1594,"_16085":41795,"_5":15974,"_22319":41701,"_1957":41796},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2384":1629,"_23648":1594,"_16085":41798,"_5":15974,"_22319":41705,"_1957":41799},[],"Generates keys with hardware entropy and never exposes the private key. Operations run inside the service. Even so, an identity with sufficient permissions could use the key to sign, so IAM policy remains critical.",{"_2384":1630,"_23648":1594,"_16085":41801,"_5":15974,"_22319":41709,"_1957":41802},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2384":1631,"_23648":1594,"_16085":41804,"_5":15974,"_22319":41709,"_1957":41805},[],"Lamassu shows the full list of enabled engines in the console.",{"_2384":1632,"_23648":1594,"_16085":41807,"_5":15974,"_22319":41709,"_1957":41808},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2384":1633,"_23648":1594,"_16085":41810,"_5":15974,"_22319":41709,"_1957":41811},[],"During deployment it is mandatory to define a default engine. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2384":1634,"_23648":1594,"_16085":41813,"_5":15974,"_22319":41713,"_1957":41814},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2384":1635,"_23648":1594,"_16085":41816,"_5":15974,"_22319":41713,"_1957":41817},[],"The table includes the following fields:",{"_2384":1636,"_23648":1594,"_16085":41819,"_5":15974,"_22319":41713,"_1957":41820},[],"**Name**: descriptive name of the key.",{"_2384":1637,"_23648":1594,"_16085":41822,"_5":15974,"_22319":41713,"_1957":41823},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2384":1638,"_23648":1594,"_16085":41825,"_5":15974,"_22319":41713,"_1957":41826},[],"**Strength**: visual indicator of cryptographic strength.",{"_2384":1639,"_23648":1594,"_16085":41828,"_5":15974,"_22319":41713,"_1957":41829},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2384":1640,"_23648":1594,"_16085":41831,"_5":15974,"_22319":41713,"_1957":41832},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2384":1641,"_23648":1594,"_16085":41834,"_5":15974,"_22319":41713,"_1957":41835},[],"**Aliases**: alternative names associated with the key.",{"_2384":1642,"_23648":1594,"_16085":41837,"_5":15974,"_22319":41713,"_1957":41838},[],"**Tags**: labels for classification and search.",{"_2384":1643,"_23648":1594,"_16085":41840,"_5":15974,"_22319":41713,"_1957":41841},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2384":1644,"_23648":1594,"_16085":41843,"_5":15974,"_22319":41713,"_1957":41844},[],"From this view you also reach the most common actions:",{"_2384":1645,"_23648":1594,"_16085":41846,"_5":15974,"_22319":41713,"_1957":41847},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2384":1646,"_23648":1594,"_16085":41849,"_5":15974,"_22319":41713,"_1957":41850},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2384":1647,"_23648":1594,"_16085":41852,"_5":15974,"_22319":41713,"_1957":41853},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2384":1648,"_23648":1594,"_16085":41855,"_5":15974,"_22319":41713,"_1957":41856},[],"**Delete Key** to remove the key from the system.",{"_2384":1649,"_23648":1594,"_16085":41858,"_5":15974,"_22319":41717,"_1957":41859},[],"Keys are registered from the wizard opened with **Create New Key**.",{"_2384":1650,"_23648":1594,"_16085":41861,"_5":15974,"_22319":41721,"_1957":41862},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2384":1651,"_23648":1594,"_16085":41864,"_5":15974,"_22319":41721,"_1957":41865},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2384":1652,"_23648":1594,"_16085":41867,"_5":15974,"_22319":41721,"_1957":41868},[],"**Key Name**: unique and descriptive name.",{"_2384":1653,"_23648":1594,"_16085":41870,"_5":15974,"_22319":41721,"_1957":41871},[],"**Crypto Engine**: engine that will keep the key.",{"_2384":1654,"_23648":1594,"_16085":41873,"_5":15974,"_22319":41721,"_1957":41874},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2384":1655,"_23648":1594,"_16085":41876,"_5":15974,"_22319":41721,"_1957":41877},[],"**Tags**: metadata to classify the key.",{"_2384":1656,"_23648":1594,"_16085":41879,"_5":15974,"_22319":41721,"_1957":41880},[],"**Metadata**: additional information for advanced uses.",{"_2384":1657,"_23648":1594,"_16085":41882,"_5":15974,"_22319":41725,"_1957":41883},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2384":1658,"_23648":1594,"_16085":41885,"_5":15974,"_22319":41725,"_1957":41886},[],"When the key was generated in an isolated environment or an external HSM.",{"_2384":1659,"_23648":1594,"_16085":41888,"_5":15974,"_22319":41725,"_1957":41889},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2384":1660,"_23648":1594,"_16085":41891,"_5":15974,"_22319":41725,"_1957":41892},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2384":1661,"_23648":1594,"_16085":41894,"_5":15974,"_22319":41725,"_1957":41895},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2384":1662,"_23648":1594,"_16085":41897,"_5":15974,"_22319":41725,"_1957":41898},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2384":1663,"_23648":1594,"_16085":41900,"_5":15974,"_22319":41725,"_1957":41901},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2384":1664,"_23648":1594,"_16085":41903,"_5":15974,"_22319":41725,"_1957":41904},[],"**Tags**: labels for organization and search.",{"_2384":1665,"_23648":1594,"_16085":41906,"_5":15974,"_22319":41725,"_1957":41907},[],"**Metadata**: additional optional information.",{"_2384":1666,"_23648":1594,"_16085":41909,"_5":15974,"_22319":41725,"_1957":41910},[],"**Private Key (PEM)**: private key in PEM format.",{"_2384":1667,"_23648":1594,"_16085":41912,"_5":15974,"_22319":41725,"_1957":41913},[],"Once the wizard is complete, the key is stored in the selected engine and can be used for signing, CSR generation and the rest of the operations supported by the KMS.",{"_2384":1668,"_23648":1594,"_16085":41915,"_5":15974,"_22319":41729,"_1957":41916},[],"Each registered key has a detail view and several operational actions.",{"_2384":1669,"_23648":1594,"_16085":41918,"_5":15974,"_22319":41733,"_1957":41919},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2384":1670,"_23648":1594,"_16085":41921,"_5":15974,"_22319":41733,"_1957":41922},[],"The **Overview** tab shows, among others, these fields:",{"_2384":1671,"_23648":1594,"_16085":41924,"_5":15974,"_22319":41733,"_1957":41925},[],"**Key Name**: descriptive name.",{"_2384":1672,"_23648":1594,"_16085":41927,"_5":15974,"_22319":41733,"_1957":41928},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2384":1673,"_23648":1594,"_16085":41930,"_5":15974,"_22319":41733,"_1957":41931},[],"**Tags**: associated labels.",{"_2384":1674,"_23648":1594,"_16085":41933,"_5":15974,"_22319":41733,"_1957":41934},[],"**Aliases**: alternative names.",{"_2384":1675,"_23648":1594,"_16085":41936,"_5":15974,"_22319":41733,"_1957":41937},[],"**Crypto Engine**: engine where the key resides.",{"_2384":1676,"_23648":1594,"_16085":41939,"_5":15974,"_22319":41733,"_1957":41940},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2384":1677,"_23648":1594,"_16085":41942,"_5":15974,"_22319":41733,"_1957":41943},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2384":1678,"_23648":1594,"_16085":41945,"_5":15974,"_22319":41733,"_1957":41946},[],"The **Public Key** tab presents the public key in PEM format, ready to consult or copy.",{"_2384":1679,"_23648":1594,"_16085":41948,"_5":15974,"_22319":41737,"_1957":41949},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2384":1680,"_23648":1594,"_16085":41951,"_5":15974,"_22319":41737,"_1957":41952},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2384":1681,"_23648":1594,"_16085":41954,"_5":15974,"_22319":41741,"_1957":41955},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2384":1682,"_23648":1594,"_16085":41957,"_5":15974,"_22319":41741,"_1957":41958},[],"Main fields:",{"_2384":1683,"_23648":1594,"_16085":41960,"_5":15974,"_22319":41741,"_1957":41961},[],"**Algorithm**: signing algorithm available for the key type.",{"_2384":1684,"_23648":1594,"_16085":41963,"_5":15974,"_22319":41741,"_1957":41964},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2384":1685,"_23648":1594,"_16085":41966,"_5":15974,"_22319":41741,"_1957":41967},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2384":1686,"_23648":1594,"_16085":41969,"_5":15974,"_22319":41741,"_1957":41970},[],"**Message**: content to sign.",{"_2384":1687,"_23648":1594,"_16085":41972,"_5":15974,"_22319":41741,"_1957":41973},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2384":1688,"_23648":1594,"_16085":41975,"_5":15974,"_22319":41745,"_1957":41976},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2384":1689,"_23648":1594,"_16085":41978,"_5":15974,"_22319":41745,"_1957":41958},[],{"_2384":1690,"_23648":1594,"_16085":41980,"_5":15974,"_22319":41745,"_1957":41981},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2384":1691,"_23648":1594,"_16085":41983,"_5":15974,"_22319":41745,"_1957":41984},[],"**Message Type**: `Raw` or `Digest`.",{"_2384":1692,"_23648":1594,"_16085":41986,"_5":15974,"_22319":41745,"_1957":41987},[],"**Payload Encoding**: encoding of the message.",{"_2384":1693,"_23648":1594,"_16085":41989,"_5":15974,"_22319":41745,"_1957":41990},[],"**Message**: original message or hash.",{"_2384":1694,"_23648":1594,"_16085":41992,"_5":15974,"_22319":41745,"_1957":41993},[],"**Signature**: signature to check.",{"_2384":1695,"_23648":1594,"_16085":41995,"_5":15974,"_22319":41745,"_1957":41996},[],"**Result**: indicator of the validation result.",{"_2384":1696,"_23648":1594,"_16085":41998,"_5":15974,"_22319":41749,"_1957":41999},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2384":1697,"_23648":1594,"_16085":42001,"_5":15974,"_22319":41749,"_1957":42002},[],"This flow is useful for:",{"_2384":1698,"_23648":1594,"_16085":42004,"_5":15974,"_22319":41749,"_1957":42005},[],"Requesting certificates from an external CA.",{"_2384":1699,"_23648":1594,"_16085":42007,"_5":15974,"_22319":41749,"_1957":42008},[],"Renewing an identity while keeping the same key.",{"_2384":1700,"_23648":1594,"_16085":42010,"_5":15974,"_22319":41749,"_1957":42011},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2384":1701,"_23648":1594,"_16085":42013,"_5":15974,"_22319":41749,"_1957":42014},[],"**Common Name (CN)**: main name of the identity.",{"_2384":1702,"_23648":1594,"_16085":42016,"_5":15974,"_22319":41749,"_1957":42017},[],"**Organization (O)**: organization or company.",{"_2384":1703,"_23648":1594,"_16085":42019,"_5":15974,"_22319":41749,"_1957":42020},[],"**Organizational Unit (OU)**: department or unit.",{"_2384":1704,"_23648":1594,"_16085":42022,"_5":15974,"_22319":41749,"_1957":42023},[],"**Country (C)**: two-letter country code.",{"_2384":1705,"_23648":1594,"_16085":42025,"_5":15974,"_22319":41749,"_1957":42026},[],"**State / Province (ST)**: state or province.",{"_2384":1706,"_23648":1594,"_16085":42028,"_5":15974,"_22319":41749,"_1957":42029},[],"**Locality (L)**: city or locality.",{"_2384":1707,"_23648":1594,"_16085":42031,"_5":15974,"_22319":41749,"_1957":42032},[],"**Email Address**: contact email.",{"_2384":1708,"_23648":1594,"_16085":42034,"_5":15974,"_22319":41749,"_1957":42035},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2384":1709,"_23648":1594,"_16085":42037,"_5":15974,"_22319":41749,"_1957":42038},[],"Once the form is complete, Lamassu generates the CSR and presents it for download or copy.",{"_2384":1710,"_23648":1594,"_16085":42040,"_5":15974,"_22319":41753,"_1957":42041},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2384":1711,"_23648":1594,"_16085":42043,"_5":15974,"_22319":41753,"_1957":42044},[],"This option shows the steps needed to configure the local environment, load the PKCS#11 module and perform signatures with tools like OpenSSL without extracting the private key from the secured environment.",{"_2384":1712,"_23648":1712,"_5":10988,"_1957":42046,"_23928":42047,"_16085":42048,"_22319":1712},"Online validation with OCSP",[36699,38037,38515],[],{"_2384":1713,"_23648":1712,"_16085":42050,"_5":15974,"_22319":1712,"_1957":42051},[],"Check in real time whether a certificate is still valid or has been revoked.",{"_2384":1714,"_23648":1712,"_5":23925,"_16085":42053,"_22319":42054,"_1957":42055},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#ocsp-service","OCSP service",{"_2384":1715,"_23648":1712,"_5":23925,"_16085":42057,"_22319":42058,"_1957":42059},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2384":1716,"_23648":1712,"_5":23925,"_16085":42061,"_22319":42062,"_1957":42063},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2384":1717,"_23648":1712,"_5":23925,"_16085":42065,"_22319":42066,"_1957":42067},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2384":1718,"_23648":1712,"_5":23925,"_16085":42069,"_22319":42070,"_1957":42071},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2384":1719,"_23648":1712,"_5":23925,"_16085":42073,"_22319":42074,"_1957":40010},[],"/docs/pr-preview/pr-26/platform/pki/ocsp#references",{"_2384":1720,"_23648":1712,"_16085":42076,"_5":15974,"_22319":42054,"_1957":42077},[],"OCSP (Online Certificate Status Protocol) is the mechanism that lets a relying party check, in real time, whether a specific certificate is valid or has been revoked. Instead of downloading a full list of revoked certificates, the client sends a query with the certificate's serial number and receives a signed response with the current status.",{"_2384":1721,"_23648":1712,"_16085":42079,"_5":15974,"_22319":42054,"_1957":42080},[],"Lamassu integrates its own OCSP responder that serves these queries by consulting the internal certificate database directly. No external component is required.",{"_2384":1722,"_23648":1712,"_16085":42082,"_5":15974,"_22319":42058,"_1957":42083},[],"When a client requests the status of a certificate, the responder locates the certificate by its serial number and determines its status from the internal record:",{"_2384":1723,"_23648":1712,"_16085":42085,"_5":15974,"_22319":42058,"_1957":42086},[],"If the certificate is active, the response indicates `Good`.",{"_2384":1724,"_23648":1712,"_16085":42088,"_5":15974,"_22319":42058,"_1957":42089},[],"If the certificate has been revoked, the response indicates `Revoked` and includes the revocation timestamp and the RFC 5280 reason code.",{"_2384":1725,"_23648":1712,"_16085":42091,"_5":15974,"_22319":42058,"_1957":42092},[],"If the serial number is not found or the status is not recognizable, the response indicates `Unknown`.",{"_2384":1726,"_23648":1712,"_16085":42094,"_5":15974,"_22319":42058,"_1957":42095},[],"The OCSP response is signed by the issuing CA of the queried certificate, using the cryptographic engine associated with that CA. Lamassu does not use a delegated OCSP signing certificate: the CA acts directly as the responder.",{"_2384":1727,"_23648":1712,"_16085":42097,"_5":15974,"_22319":42058,"_1957":42098},[],"Each response has a validity window of 24 hours, reflected in the response's `thisUpdate` and `nextUpdate` fields. Clients that cache responses must take this window into account when determining how long a response remains valid.",{"_2384":1728,"_23648":1712,"_16085":42100,"_5":15974,"_22319":42062,"_1957":42101},[],"The OCSP responder URL is automatically embedded in the AIA (*Authority Information Access*) extension of every certificate issued by Lamassu. Clients that verify certificates can read this URL directly from the certificate without additional configuration.",{"_2384":1729,"_23648":1712,"_16085":42103,"_5":15974,"_22319":42066,"_1957":42104},[],"The responder accepts both formats defined in RFC 6960:",{"_2384":1730,"_23648":1712,"_16085":42106,"_5":15974,"_22319":42066,"_1957":42107},[],"`GET /ocsp/{ocsp_request}` includes the OCSP request Base64url-encoded within the URL itself.",{"_2384":1731,"_23648":1712,"_16085":42109,"_5":15974,"_22319":42066,"_1957":42110},[],"`POST /ocsp` sends the request in the body with `Content-Type: application/ocsp-request`.",{"_2384":1732,"_23648":1712,"_16085":42112,"_5":15974,"_22319":42066,"_1957":42113},[],"Example query with `curl` using POST:",{"_2384":1733,"_23648":1712,"_16085":42115,"_5":15974,"_22319":42066,"_1957":42116},[],"The response has `Content-Type: application/ocsp-response` and contains the OCSP response in DER format.",{"_2384":1734,"_23648":1712,"_16085":42118,"_5":15974,"_22319":42070,"_1957":42119},[],"From the certificates screen of Lamassu you can launch an OCSP request directly against the selected certificate with the **OCSP Check** action. This action shows the status returned by the responder without needing external tools.",{"_2384":1735,"_23648":1712,"_16085":42121,"_5":15974,"_22319":42074,"_1957":42122},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_2384":1736,"_23648":1712,"_16085":42124,"_5":15974,"_22319":42074,"_1957":42125},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (revocation reasons, section 5.3.1)",{"_2384":1737,"_23648":1712,"_16085":42127,"_5":15974,"_22319":42074,"_1957":42128},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2384":1738,"_23648":1712,"_16085":42130,"_5":15974,"_22319":42074,"_1957":40102},[],{"_2384":1739,"_23648":1739,"_5":10988,"_1957":42132,"_23928":42133,"_16085":42134,"_22319":1739},"Lamassu IoT Platform",[36699,38037],[],{"_2384":1740,"_23648":1739,"_16085":42136,"_5":15974,"_22319":1739,"_1957":42137},[],"Manage PKI and digital identities for your devices from a single platform.",{"_2384":1741,"_23648":1739,"_5":23925,"_16085":42139,"_22319":42140,"_1957":42141},[],"/docs/pr-preview/pr-26/platform/pki/overview#start-here","Start here",{"_2384":1742,"_23648":1739,"_5":23925,"_16085":42143,"_22319":42144,"_1957":42145},[],"/docs/pr-preview/pr-26/platform/pki/overview#architecture-at-a-glance","Architecture at a glance",{"_2384":1743,"_23648":1739,"_5":23925,"_16085":42147,"_22319":42148,"_1957":42149},[],"/docs/pr-preview/pr-26/platform/pki/overview#core-capabilities","Core capabilities",{"_2384":1744,"_23648":1739,"_5":23925,"_16085":42151,"_22319":42152,"_1957":42153},[],"/docs/pr-preview/pr-26/platform/pki/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2384":1745,"_23648":1739,"_5":23925,"_16085":42155,"_22319":42156,"_1957":42157},[],"/docs/pr-preview/pr-26/platform/pki/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2384":1746,"_23648":1739,"_5":23925,"_16085":42159,"_22319":42160,"_1957":42161},[],"/docs/pr-preview/pr-26/platform/pki/overview#issue-and-control-certificates","Issue and control certificates",{"_2384":1747,"_23648":1739,"_5":23925,"_16085":42163,"_22319":42164,"_1957":42165},[],"/docs/pr-preview/pr-26/platform/pki/overview#automate-device-identities","Automate device identities",{"_2384":1748,"_23648":1739,"_5":23925,"_16085":42167,"_22319":42168,"_1957":42169},[],"/docs/pr-preview/pr-26/platform/pki/overview#publish-validation-status","Publish validation status",{"_2384":1749,"_23648":1739,"_5":23925,"_16085":42171,"_22319":42172,"_1957":42173},[],"/docs/pr-preview/pr-26/platform/pki/overview#react-to-events","React to events",{"_2384":1750,"_23648":1739,"_5":23925,"_16085":42175,"_22319":42176,"_1957":42177},[],"/docs/pr-preview/pr-26/platform/pki/overview#choose-your-path","Choose your path",{"_2384":1751,"_23648":1739,"_5":23925,"_16085":42179,"_22319":42180,"_1957":42181},[],"/docs/pr-preview/pr-26/platform/pki/overview#operational-reference","Operational reference",{"_2384":1752,"_23648":1739,"_16085":42183,"_5":15974,"_22319":1739,"_1957":42184},[],"Lamassu IoT centralizes the issuance, distribution, renewal and revocation of X.509 identities for connected devices. You can build a private PKI, protect its keys and automate the enrollment of a fleet without losing visibility into every certificate.",{"_2384":1753,"_23648":1739,"_16085":42186,"_5":15974,"_22319":42140,"_1957":42187},[],"<Card title=\"Get started\" description=\"Create a CA, issue a certificate and register your first device.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2384":1754,"_23648":1739,"_16085":42189,"_5":15974,"_22319":42140,"_1957":42190},[],"<Card title=\"How Lamassu works\" description=\"Build the mental model of authorities, keys, identities and validation.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_2384":1755,"_23648":1739,"_16085":42192,"_5":15974,"_22319":42144,"_1957":42193},[],"Lamassu runs as a set of services on Kubernetes, backed by PostgreSQL, RabbitMQ and an OIDC provider. Hover a component to trace its connections, or see the platform architecture chapter for the low-level, per-service view.",{"_2384":1756,"_23648":1739,"_16085":42195,"_5":15974,"_22319":42152,"_1957":42196},[],"Create root and intermediate authorities or import an existing PKI. Define which authority can issue each identity and keep the full chain of trust.",{"_2384":1757,"_23648":1739,"_16085":42198,"_5":15974,"_22319":42156,"_1957":42199},[],"Generate and safeguard keys using software engines, PKCS#11 HSMs or cloud services. Lamassu decouples operations from the physical location of the key.",{"_2384":1758,"_23648":1739,"_16085":42201,"_5":15974,"_22319":42160,"_1957":42202},[],"Issue certificates from the console or from a CSR, check their status and revoke them when they stop being trustworthy.",{"_2384":1759,"_23648":1739,"_16085":42204,"_5":15974,"_22319":42164,"_1957":42205},[],"Define enrollment policies with a Device Management Service (DMS) and let devices request or renew their identity through EST.",{"_2384":1760,"_23648":1739,"_16085":42207,"_5":15974,"_22319":42168,"_1957":42208},[],"Offer online validation through OCSP and distribute CRLs for consumers that need to check certificates offline.",{"_2384":1761,"_23648":1739,"_16085":42210,"_5":15974,"_22319":42172,"_1957":42211},[],"Subscribe to lifecycle changes and send notifications by email, Microsoft Teams or webhooks.",{"_2384":1762,"_23648":1739,"_16085":42213,"_5":15974,"_22319":42176,"_1957":42214},[],"<Card title=\"I administer the PKI\" description=\"Configure engines, authorities, issuance and validation.\" href=\"/docs/platform/pki/key-management\" />",{"_2384":1763,"_23648":1739,"_16085":42216,"_5":15974,"_22319":42176,"_1957":42217},[],"<Card title=\"I integrate a device\" description=\"Configure the DMS and use EST to obtain an identity.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2384":1764,"_23648":1739,"_16085":42219,"_5":15974,"_22319":42176,"_1957":42220},[],"<Card title=\"I operate the platform\" description=\"Deploy Lamassu and prepare its dependencies.\" href=\"/docs/deployment/overview\" />",{"_2384":1765,"_23648":1739,"_16085":42222,"_5":15974,"_22319":42176,"_1957":42223},[],"<Card title=\"I integrate another system\" description=\"Connect Lamassu with AWS IoT Core and other destinations.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_2384":1766,"_23648":1739,"_16085":42225,"_5":15974,"_22319":42180,"_1957":42226},[],"<Card title=\"Certificate profiles\" description=\"Turn issuance policy into reusable constraints.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_2384":1767,"_23648":1739,"_16085":42228,"_5":15974,"_22319":42180,"_1957":42229},[],"<Card title=\"Hierarchy and rotation\" description=\"Replace CA certificates or keys without breaking trust.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_2384":1768,"_23648":1739,"_16085":42231,"_5":15974,"_22319":42180,"_1957":42232},[],"<Card title=\"Access control\" description=\"Configure principals, policies and the first administrator.\" href=\"/docs/platform/pki/access-control\" />",{"_2384":1769,"_23648":1739,"_16085":42234,"_5":15974,"_22319":42180,"_1957":42235},[],"<Card title=\"Troubleshooting\" description=\"Diagnose the Gateway, services, issuance and enrollment.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2384":1770,"_23648":1770,"_5":10988,"_1957":42237,"_23928":42238,"_16085":42240,"_22319":1770},"Create your first CA",[36699,38037,42239],"Getting started",[],{"_2384":1771,"_23648":1770,"_16085":42242,"_5":15974,"_22319":1770,"_1957":42243},[],"Create a root authority and check that it is ready to issue certificates.",{"_2384":1772,"_23648":1770,"_5":23925,"_16085":42245,"_22319":42246,"_1957":36709},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2384":1773,"_23648":1770,"_5":23925,"_16085":42248,"_22319":42249,"_1957":42250},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2384":1774,"_23648":1770,"_5":23925,"_16085":42252,"_22319":42253,"_1957":42254},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2384":1775,"_23648":1770,"_5":23925,"_16085":42256,"_22319":42257,"_1957":42258},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2384":1776,"_23648":1770,"_5":23925,"_16085":42260,"_22319":42261,"_1957":42262},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2384":1777,"_23648":1770,"_5":23925,"_16085":42264,"_22319":42265,"_1957":42266},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2384":1778,"_23648":1770,"_5":23925,"_16085":42268,"_22319":42269,"_1957":36733},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2384":1779,"_23648":1770,"_16085":42271,"_5":15974,"_22319":1770,"_1957":42272},[],"In this quickstart you will create a root certification authority with a new key pair. When you finish you will have an active CA that you can use in the next quickstart.",{"_2384":1780,"_23648":1770,"_16085":42274,"_5":15974,"_22319":42246,"_1957":42275},[],"Console access with permissions to manage authorities.",{"_2384":1781,"_23648":1770,"_16085":42277,"_5":15974,"_22319":42246,"_1957":42278},[],"At least one cryptographic engine available.",{"_2384":1782,"_23648":1770,"_16085":42280,"_5":15974,"_22319":42246,"_1957":42281},[],"A name that identifies the purpose of the CA, for example `Acme Device Root CA`.",{"_2384":1783,"_23648":1770,"_16085":42283,"_5":15974,"_22319":42246,"_1957":42284},[],"A root CA is self-signed and acts as the anchor of trust. For production it is usually preferable to keep the root more protected and issue from an intermediate CA.",{"_2384":1784,"_23648":1770,"_16085":42286,"_5":15974,"_22319":42249,"_1957":42287},[],"In the side menu, open **Certification Authorities** and select **Create New CA**.",{"_2384":1785,"_23648":1770,"_16085":42289,"_5":15974,"_22319":42249,"_1957":42290},[],"Choose to create a CA with a new key pair. If you already have the key in the KMS, use &#x2A;*Create New CA (Existing Key)**.",{"_2384":1786,"_23648":1770,"_16085":42292,"_5":15974,"_22319":42253,"_1957":42293},[],"Choose the cryptographic engine that will keep the key and configure the algorithm. For a first CA you can use **EC P-384**, as long as it is compatible with your consumers.",{"_2384":1787,"_23648":1770,"_16085":42295,"_5":15974,"_22319":42253,"_1957":42296},[],"The private key will remain under the control of the selected engine.",{"_2384":1788,"_23648":1770,"_16085":42298,"_5":15974,"_22319":42257,"_1957":42299},[],"Select **Root CA** and complete:",{"_2384":1789,"_23648":1770,"_16085":42301,"_5":15974,"_22319":42257,"_1957":42302},[],"**CA Name**: a unique, recognizable name.",{"_2384":1790,"_23648":1770,"_16085":42304,"_5":15974,"_22319":42257,"_1957":42305},[],"**Subject**: at least the organization and country that will identify the authority.",{"_2384":1791,"_23648":1770,"_16085":42307,"_5":15974,"_22319":42257,"_1957":42308},[],"**CA Certificate Expiration**: a validity longer than that of the certificates it will issue.",{"_2384":1792,"_23648":1770,"_16085":42310,"_5":15974,"_22319":42257,"_1957":42311},[],"**Default End-Entity Certificate Issuance Expiration**: the default validity of end-entity certificates.",{"_2384":1793,"_23648":1770,"_16085":42313,"_5":15974,"_22319":42257,"_1957":42314},[],"The CA name will be used as the certificate's `Common Name`.",{"_2384":1794,"_23648":1770,"_16085":42316,"_5":15974,"_22319":42261,"_1957":42317},[],"Check the algorithm, subject and dates before confirming. These values define the anchor of trust and should not be chosen as throwaway test data in a production environment.",{"_2384":1795,"_23648":1770,"_16085":42319,"_5":15974,"_22319":42265,"_1957":42320},[],"Open the new CA from the list. It should appear active and show its PEM certificate, the expiration date and the **Issued Certificates** tab.",{"_2384":1796,"_23648":1770,"_16085":42322,"_5":15974,"_22319":42269,"_1957":42323},[],"Use the authority to issue your first certificate, or see the full authorities guide to create an intermediate CA, import a CA or define advanced profiles.",{"_2384":1797,"_23648":1797,"_5":10988,"_1957":42325,"_23928":42326,"_16085":42327,"_22319":1797},"Issue your first certificate",[36699,38037,42239],[],{"_2384":1798,"_23648":1797,"_16085":42329,"_5":15974,"_22319":1797,"_1957":42330},[],"Issue an X.509 identity from the console and verify the result.",{"_2384":1799,"_23648":1797,"_5":23925,"_16085":42332,"_22319":42333,"_1957":36709},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2384":1800,"_23648":1797,"_5":23925,"_16085":42335,"_22319":42336,"_1957":42337},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2384":1801,"_23648":1797,"_5":23925,"_16085":42339,"_22319":42340,"_1957":42341},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2384":1802,"_23648":1797,"_5":23925,"_16085":42343,"_22319":42344,"_1957":42345},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2384":1803,"_23648":1797,"_5":23925,"_16085":42347,"_22319":42348,"_1957":42349},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2384":1804,"_23648":1797,"_5":23925,"_16085":42351,"_22319":42352,"_1957":42353},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2384":1805,"_23648":1797,"_5":23925,"_16085":42355,"_22319":42356,"_1957":42266},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2384":1806,"_23648":1797,"_5":23925,"_16085":42358,"_22319":42359,"_1957":36733},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/issue-certificate#next-step",{"_2384":1807,"_23648":1797,"_16085":42361,"_5":15974,"_22319":1797,"_1957":42362},[],"In this quickstart Lamassu will generate the key and the CSR in the browser, and the CA will issue the certificate. When you finish you will download the certificate and its private key.",{"_2384":1808,"_23648":1797,"_16085":42364,"_5":15974,"_22319":42333,"_1957":42365},[],"An active CA with permission to issue certificates.",{"_2384":1809,"_23648":1797,"_16085":42367,"_5":15974,"_22319":42333,"_1957":42368},[],"A name for the identity, for example `device-001.example.internal`.",{"_2384":1810,"_23648":1797,"_16085":42370,"_5":15974,"_22319":42333,"_1957":42371},[],"A safe place to keep the downloaded private key.",{"_2384":1811,"_23648":1797,"_16085":42373,"_5":15974,"_22319":42333,"_1957":42374},[],"In this flow the key is generated in the browser and Lamassu does not store it. Download it and protect it before closing the operation result.",{"_2384":1812,"_23648":1797,"_16085":42376,"_5":15974,"_22319":42336,"_1957":42377},[],"Open the CA created in the previous quickstart, go to **Issued Certificates** and select **Issue New**.",{"_2384":1813,"_23648":1797,"_16085":42379,"_5":15974,"_22319":42340,"_1957":42380},[],"Select **Generate Key & CSR in Browser**. Use **Upload Existing CSR** when the private key must be generated and kept on the target system.",{"_2384":1814,"_23648":1797,"_16085":42382,"_5":15974,"_22319":42344,"_1957":42383},[],"Enter the `Common Name` and, if applicable, the organization, organizational unit and location. Add SANs for each DNS name, IP address, email or URI the identity will be validated with.",{"_2384":1815,"_23648":1797,"_16085":42385,"_5":15974,"_22319":42348,"_1957":42386},[],"Choose RSA or ECDSA, define the validity and select the key usages. For a device identity that uses mTLS, enable **Digital Signature** and **Client Authentication**.",{"_2384":1816,"_23648":1797,"_16085":42388,"_5":15974,"_22319":42348,"_1957":42389},[],"The validity cannot exceed the expiration date of the issuing CA.",{"_2384":1817,"_23648":1797,"_16085":42391,"_5":15974,"_22319":42352,"_1957":42392},[],"Confirm the issuance and immediately download the certificate and the private key in PEM format.",{"_2384":1818,"_23648":1797,"_16085":42394,"_5":15974,"_22319":42356,"_1957":42395},[],"The certificate should appear in **Issued Certificates** with an active status. Check its subject, SANs, issuer, usages and validity period.",{"_2384":1819,"_23648":1797,"_16085":42397,"_5":15974,"_22319":42359,"_1957":42398},[],"Register your first device to associate the identity with a managed entity, or see certificate management.",{"_2384":1820,"_23648":1820,"_5":10988,"_1957":42400,"_23928":42401,"_16085":42402,"_22319":1820},"Get started",[36699,38037,42239],[],{"_2384":1821,"_23648":1820,"_16085":42404,"_5":15974,"_22319":1820,"_1957":42405},[],"Get a first result with Lamassu and continue from a working base.",{"_2384":1822,"_23648":1820,"_5":23925,"_16085":42407,"_22319":42408,"_1957":42409},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2384":1823,"_23648":1820,"_5":23925,"_16085":42411,"_22319":42412,"_1957":36709},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/overview#before-you-begin",{"_2384":1824,"_23648":1820,"_16085":42414,"_5":15974,"_22319":1820,"_1957":42415},[],"The quickstarts take you from a prepared instance to an active device identity. Each guide produces a verifiable result and links the detailed explanation when you need to go deeper.",{"_2384":1825,"_23648":1820,"_16085":42417,"_5":15974,"_22319":42408,"_1957":42418},[],"<Card title=\"1. Create your first CA\" description=\"Establish a root of trust capable of issuing certificates.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2384":1826,"_23648":1820,"_16085":42420,"_5":15974,"_22319":42408,"_1957":42421},[],"<Card title=\"2. Issue a certificate\" description=\"Create an X.509 identity and verify its contents.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2384":1827,"_23648":1820,"_16085":42423,"_5":15974,"_22319":42408,"_1957":42424},[],"<Card title=\"3. Register a device\" description=\"Add a device and assign it its first identity.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_2384":1828,"_23648":1820,"_16085":42426,"_5":15974,"_22319":42412,"_1957":42427},[],"You need access to the Lamassu IoT console and permissions to administer keys, authorities and devices. The instance must have at least one cryptographic engine configured.",{"_2384":1829,"_23648":1820,"_16085":42429,"_5":15974,"_22319":42412,"_1957":42430},[],"If you don't have an instance yet, first choose a deployment model.",{"_2384":1830,"_23648":1830,"_5":10988,"_1957":42432,"_23928":42433,"_16085":42434,"_22319":1830},"Register your first device",[36699,38037,42239],[],{"_2384":1831,"_23648":1830,"_16085":42436,"_5":15974,"_22319":1830,"_1957":42437},[],"Add a device to Lamassu and assign it an active identity.",{"_2384":1832,"_23648":1830,"_5":23925,"_16085":42439,"_22319":42440,"_1957":36709},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#before-you-begin",{"_2384":1833,"_23648":1830,"_5":23925,"_16085":42442,"_22319":42443,"_1957":42444},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#register-the-device","Register the device",{"_2384":1834,"_23648":1830,"_5":23925,"_16085":42446,"_22319":42447,"_1957":42448},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2384":1835,"_23648":1830,"_5":23925,"_16085":42450,"_22319":42451,"_1957":42452},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2384":1836,"_23648":1830,"_5":23925,"_16085":42454,"_22319":42455,"_1957":42456},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#verify-the-device","Verify the device",{"_2384":1837,"_23648":1830,"_5":23925,"_16085":42458,"_22319":42459,"_1957":42460},[],"/docs/pr-preview/pr-26/platform/pki/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2384":1838,"_23648":1830,"_16085":42462,"_5":15974,"_22319":1830,"_1957":42463},[],"In this quickstart you will manually register a device and assign it its first certificate. It is the shortest path to understanding how Lamassu relates a physical entity to its identity history.",{"_2384":1839,"_23648":1830,"_16085":42465,"_5":15974,"_22319":42440,"_1957":42466},[],"A configured DMS.",{"_2384":1840,"_23648":1830,"_16085":42468,"_5":15974,"_22319":42440,"_1957":42469},[],"A CA associated with the DMS.",{"_2384":1841,"_23648":1830,"_16085":42471,"_5":15974,"_22319":42440,"_1957":42472},[],"A unique identifier for the device.",{"_2384":1842,"_23648":1830,"_16085":42474,"_5":15974,"_22319":42443,"_1957":42475},[],"Open **Managed Devices**, select the action to register a device and complete:",{"_2384":1843,"_23648":1830,"_16085":42477,"_5":15974,"_22319":42443,"_1957":42478},[],"**Device ID**: unique identifier of the device.",{"_2384":1844,"_23648":1830,"_16085":42480,"_5":15974,"_22319":42443,"_1957":42481},[],"**Registration Authority**: the DMS that will apply the enrollment policies.",{"_2384":1845,"_23648":1830,"_16085":42483,"_5":15974,"_22319":42443,"_1957":42484},[],"**Icon** and **Tags**: optional classification to locate it later.",{"_2384":1846,"_23648":1830,"_16085":42486,"_5":15974,"_22319":42447,"_1957":42487},[],"Open the newly created device. It should appear with status **No Identity**: it exists in the inventory but does not yet have an associated certificate.",{"_2384":1847,"_23648":1830,"_16085":42489,"_5":15974,"_22319":42451,"_1957":42490},[],"Select **Assign Identity**. Lamassu will search for active certificates whose `Common Name` matches the `Device ID`.",{"_2384":1848,"_23648":1830,"_16085":42492,"_5":15974,"_22319":42451,"_1957":42493},[],"Select an existing certificate or use **Issue New Instead** to issue one from a CA linked to the DMS.",{"_2384":1849,"_23648":1830,"_16085":42495,"_5":15974,"_22319":42455,"_1957":42496},[],"After confirming, the status should change to **Active**. Review **Certificate History** to check the associated identity and **Device Event Timeline** to see the assignment event.",{"_2384":1850,"_23648":1830,"_16085":42498,"_5":15974,"_22319":42459,"_1957":42499},[],"Manual registration helps you understand the model, but a fleet should use automated enrollment. Continue with Device Management Service and the EST integration.",{"_2384":1851,"_23648":1851,"_5":10988,"_1957":37471,"_23928":42501,"_16085":42502,"_22319":1851},[36699,38037,38038],[],{"_2384":1852,"_23648":1851,"_16085":42504,"_5":15974,"_22319":1851,"_1957":42505},[],"Diagnose access, health, issuance, enrollment and dependencies in a Lamassu deployment.",{"_2384":1853,"_23648":1851,"_5":23925,"_16085":42507,"_22319":42508,"_1957":42509},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2384":1854,"_23648":1851,"_5":23925,"_16085":42511,"_22319":42512,"_1957":42513},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2384":1855,"_23648":1851,"_5":23925,"_16085":42515,"_22319":42516,"_1957":42517},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2384":1856,"_23648":1851,"_5":23925,"_16085":42519,"_22319":42520,"_1957":42521},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2384":1857,"_23648":1851,"_5":23925,"_16085":42523,"_22319":42524,"_1957":42525},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#query-the-affected-service","Query the affected service",{"_2384":1858,"_23648":1851,"_5":23925,"_16085":42527,"_22319":42528,"_1957":42529},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2384":1859,"_23648":1851,"_5":23925,"_16085":42531,"_22319":42532,"_1957":42533},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2384":1860,"_23648":1851,"_5":23925,"_16085":42535,"_22319":42536,"_1957":42537},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2384":1861,"_23648":1851,"_5":23925,"_16085":42539,"_22319":42540,"_1957":42541},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2384":1862,"_23648":1851,"_5":23925,"_16085":42543,"_22319":42544,"_1957":42545},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2384":1863,"_23648":1851,"_5":23925,"_16085":42547,"_22319":42548,"_1957":42549},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2384":1864,"_23648":1851,"_5":23925,"_16085":42551,"_22319":42552,"_1957":42553},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2384":1865,"_23648":1851,"_5":23925,"_16085":42555,"_22319":42556,"_1957":42557},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2384":1866,"_23648":1851,"_5":23925,"_16085":42559,"_22319":42560,"_1957":42561},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2384":1867,"_23648":1851,"_5":23925,"_16085":42563,"_22319":42564,"_1957":42565},[],"/docs/pr-preview/pr-26/platform/pki/troubleshooting#observability","Observability",{"_2384":1868,"_23648":1851,"_16085":42567,"_5":15974,"_22319":1851,"_1957":42568},[],"Start by locating the failing layer. A Gateway response, an unready pod and a rejected issuance can look like the same problem from the console, but they require different evidence.",{"_2384":1869,"_23648":1851,"_16085":42570,"_5":15974,"_22319":42512,"_1957":42571},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2384":1870,"_23648":1851,"_16085":42573,"_5":15974,"_22319":42516,"_1957":42574},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2384":1871,"_23648":1851,"_16085":42576,"_5":15974,"_22319":42520,"_1957":42577},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2384":1872,"_23648":1851,"_16085":42579,"_5":15974,"_22319":42524,"_1957":42580},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2384":1873,"_23648":1851,"_16085":42582,"_5":15974,"_22319":42528,"_1957":42583},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2384":1874,"_23648":1851,"_16085":42585,"_5":15974,"_22319":42532,"_1957":42586},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2384":1875,"_23648":1851,"_16085":42588,"_5":15974,"_22319":42532,"_1957":42589},[],"Also run the chart's connectivity test:",{"_2384":1876,"_23648":1851,"_16085":42591,"_5":15974,"_22319":42532,"_1957":42592},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2384":1877,"_23648":1851,"_16085":42594,"_5":15974,"_22319":42532,"_1957":42595},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2384":1878,"_23648":1851,"_16085":42597,"_5":15974,"_22319":42536,"_1957":42598},[],"If you receive a 401:",{"_2384":1879,"_23648":1851,"_16085":42600,"_5":15974,"_22319":42536,"_1957":42601},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2384":1880,"_23648":1851,"_16085":42603,"_5":15974,"_22319":42536,"_1957":42604},[],"verify issuer, audience and expiration of the token;",{"_2384":1881,"_23648":1851,"_16085":42606,"_5":15974,"_22319":42536,"_1957":42607},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2384":1882,"_23648":1851,"_16085":42609,"_5":15974,"_22319":42536,"_1957":42610},[],"check that the provider's public and internal routes point to the same realm.",{"_2384":1883,"_23648":1851,"_16085":42612,"_5":15974,"_22319":42536,"_1957":42613},[],"If login succeeds but the APIs return 403:",{"_2384":1884,"_23648":1851,"_16085":42615,"_5":15974,"_22319":42536,"_1957":42616},[],"inspect the token's real claims;",{"_2384":1885,"_23648":1851,"_16085":42618,"_5":15974,"_22319":42536,"_1957":42619},[],"confirm they match an active principal;",{"_2384":1886,"_23648":1851,"_16085":42621,"_5":15974,"_22319":42536,"_1957":42622},[],"review the policies granted to that principal;",{"_2384":1887,"_23648":1851,"_16085":42624,"_5":15974,"_22319":42536,"_1957":42625},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2384":1888,"_23648":1851,"_16085":42627,"_5":15974,"_22319":42536,"_1957":42628},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2384":1889,"_23648":1851,"_16085":42630,"_5":15974,"_22319":42540,"_1957":42631},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2384":1890,"_23648":1851,"_16085":42633,"_5":15974,"_22319":42540,"_1957":42634},[],"Locate the authz pod and Service.",{"_2384":1891,"_23648":1851,"_16085":42636,"_5":15974,"_22319":42540,"_1957":42637},[],"Check /health, logs and its database connection.",{"_2384":1892,"_23648":1851,"_16085":42639,"_5":15974,"_22319":42540,"_1957":42640},[],"Verify the DNS and port configured in externalAuthorization.",{"_2384":1893,"_23648":1851,"_16085":42642,"_5":15974,"_22319":42540,"_1957":42643},[],"Check the check route is /v1/ext\\_authz/check.",{"_2384":1894,"_23648":1851,"_16085":42645,"_5":15974,"_22319":42540,"_1957":42646},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2384":1895,"_23648":1851,"_16085":42648,"_5":15974,"_22319":42544,"_1957":42649},[],"Review kubectl describe pod first. Common causes are:",{"_2384":1896,"_23648":1851,"_16085":42651,"_5":15974,"_22319":42544,"_1957":42652},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2384":1897,"_23648":1851,"_16085":42654,"_5":15974,"_22319":42544,"_1957":42655},[],"unbound persistent volume;",{"_2384":1898,"_23648":1851,"_16085":42657,"_5":15974,"_22319":42544,"_1957":42658},[],"inaccessible image or incorrect pull policy;",{"_2384":1899,"_23648":1851,"_16085":42660,"_5":15974,"_22319":42544,"_1957":42661},[],"invalid cryptographic engine configuration;",{"_2384":1900,"_23648":1851,"_16085":42663,"_5":15974,"_22319":42544,"_1957":42664},[],"CPU or memory limits set too low;",{"_2384":1901,"_23648":1851,"_16085":42666,"_5":15974,"_22319":42544,"_1957":42667},[],"an incomplete prior migration.",{"_2384":1902,"_23648":1851,"_16085":42669,"_5":15974,"_22319":42544,"_1957":42670},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2384":1903,"_23648":1851,"_16085":42672,"_5":15974,"_22319":42544,"_1957":42673},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2384":1904,"_23648":1851,"_16085":42675,"_5":15974,"_22319":42548,"_1957":42676},[],"Narrow the error following this order:",{"_2384":1905,"_23648":1851,"_16085":42678,"_5":15974,"_22319":42548,"_1957":42679},[],"The CA exists, is active and has not expired.",{"_2384":1906,"_23648":1851,"_16085":42681,"_5":15974,"_22319":42548,"_1957":42682},[],"The CA has a usable private key and the engine is available.",{"_2384":1907,"_23648":1851,"_16085":42684,"_5":15974,"_22319":42548,"_1957":42685},[],"The CSR has a valid signature.",{"_2384":1908,"_23648":1851,"_16085":42687,"_5":15974,"_22319":42548,"_1957":42688},[],"The profile allows the key type and size.",{"_2384":1909,"_23648":1851,"_16085":42690,"_5":15974,"_22319":42548,"_1957":42691},[],"The requested validity fits within the CA's lifetime.",{"_2384":1910,"_23648":1851,"_16085":42693,"_5":15974,"_22319":42548,"_1957":42694},[],"KU, EKU, subject and extensions comply with the profile.",{"_2384":1911,"_23648":1851,"_16085":42696,"_5":15974,"_22319":42548,"_1957":42697},[],"If the reissuance of a CA fails, remember it is not supported for a revoked or already-expired CA. To change its key, follow CA hierarchy and rotation.",{"_2384":1912,"_23648":1851,"_16085":42699,"_5":15974,"_22319":42552,"_1957":42700},[],"Check:",{"_2384":1913,"_23648":1851,"_16085":42702,"_5":15974,"_22319":42552,"_1957":42703},[],"the DMS identifier in the EST path;",{"_2384":1914,"_23648":1851,"_16085":42705,"_5":15974,"_22319":42552,"_1957":42706},[],"the configured authentication method;",{"_2384":1915,"_23648":1851,"_16085":42708,"_5":15974,"_22319":42552,"_1957":42709},[],"the chain presented by the client;",{"_2384":1916,"_23648":1851,"_16085":42711,"_5":15974,"_22319":42552,"_1957":42712},[],"the validation CAs and the level limit;",{"_2384":1917,"_23648":1851,"_16085":42714,"_5":15974,"_22319":42552,"_1957":42715},[],"the revocation status of the client certificate;",{"_2384":1918,"_23648":1851,"_16085":42717,"_5":15974,"_22319":42552,"_1957":42718},[],"the CSR signature;",{"_2384":1919,"_23648":1851,"_16085":42720,"_5":15974,"_22319":42552,"_1957":42721},[],"the CA and profile used for issuance;",{"_2384":1920,"_23648":1851,"_16085":42723,"_5":15974,"_22319":42552,"_1957":42724},[],"the re-enrollment window.",{"_2384":1921,"_23648":1851,"_16085":42726,"_5":15974,"_22319":42552,"_1957":42727},[],"During re-enrollment, Lamassu first tries to validate with the enrollment CA and then with the additional CAs. During a migration, keep the old CA in that second set until the overlap ends.",{"_2384":1922,"_23648":1851,"_16085":42729,"_5":15974,"_22319":42556,"_1957":42730},[],"Confirm the revocation was persisted and has reason and timestamp.",{"_2384":1923,"_23648":1851,"_16085":42732,"_5":15974,"_22319":42556,"_1957":42733},[],"Review VA configuration and logs.",{"_2384":1924,"_23648":1851,"_16085":42735,"_5":15974,"_22319":42556,"_1957":42736},[],"Check the CRL's periodicity and next update.",{"_2384":1925,"_23648":1851,"_16085":42738,"_5":15974,"_22319":42556,"_1957":42739},[],"Rule out intermediate caches in proxy and client.",{"_2384":1926,"_23648":1851,"_16085":42741,"_5":15974,"_22319":42556,"_1957":42742},[],"Verify the certificate points to the endpoint you are querying.",{"_2384":1927,"_23648":1851,"_16085":42744,"_5":15974,"_22319":42556,"_1957":42745},[],"Query by the correct serial number and issuer.",{"_2384":1928,"_23648":1851,"_16085":42747,"_5":15974,"_22319":42560,"_1957":42748},[],"Domain and audit events depend on the bus publisher:",{"_2384":1929,"_23648":1851,"_16085":42750,"_5":15974,"_22319":42560,"_1957":42751},[],"verify it is enabled in the emitting service;",{"_2384":1930,"_23648":1851,"_16085":42753,"_5":15974,"_22319":42560,"_1957":42754},[],"check AMQP connectivity and credentials;",{"_2384":1931,"_23648":1851,"_16085":42756,"_5":15974,"_22319":42560,"_1957":42757},[],"review exchange, routing key, queues and consumers;",{"_2384":1932,"_23648":1851,"_16085":42759,"_5":15974,"_22319":42560,"_1957":42760},[],"inspect dead-letter queues;",{"_2384":1933,"_23648":1851,"_16085":42762,"_5":15974,"_22319":42560,"_1957":42763},[],"alert on orphan durable queues and backlog growth.",{"_2384":1934,"_23648":1851,"_16085":42765,"_5":15974,"_22319":42560,"_1957":42766},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2384":1935,"_23648":1851,"_16085":42768,"_5":15974,"_22319":42564,"_1957":42769},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2384":1936,"_23648":1851,"_16085":42771,"_5":15974,"_22319":42564,"_1957":42772},[],"Before closing an incident, record:",{"_2384":1937,"_23648":1851,"_16085":42774,"_5":15974,"_22319":42564,"_1957":42775},[],"the confirmed cause;",{"_2384":1938,"_23648":1851,"_16085":42777,"_5":15974,"_22319":42564,"_1957":42778},[],"the time scope and affected resources;",{"_2384":1939,"_23648":1851,"_16085":42780,"_5":15974,"_22319":42564,"_1957":42781},[],"the commands or queries used;",{"_2384":1940,"_23648":1851,"_16085":42783,"_5":15974,"_22319":42564,"_1957":42784},[],"the applied change and how to revert it;",{"_2384":1941,"_23648":1851,"_16085":42786,"_5":15974,"_22319":42564,"_1957":42787},[],"validation from a consumer;",{"_2384":1942,"_23648":1851,"_16085":42789,"_5":15974,"_22319":42564,"_1957":42790},[],"the preventive action and its owner.",{"_2384":1943,"_23648":1943,"_5":10988,"_1957":42792,"_16085":42793,"_22319":1943},"Test",[],{"_2384":1944,"_23648":1943,"_16085":42795,"_5":15974,"_22319":1943,"_1957":42796},[],"A document to test Fumadocs",{"_2384":1945,"_23648":1943,"_5":23925,"_16085":42798,"_22319":42799,"_1957":42800},[],"/docs/pr-preview/pr-26/test#cards","Cards",{"_2384":1946,"_23648":1943,"_5":23925,"_16085":42802,"_22319":42803,"_1957":42804},[],"/docs/pr-preview/pr-26/test#codeblock","CodeBlock",{"_2384":1947,"_23648":1943,"_5":23925,"_16085":42806,"_22319":42807,"_1957":42808},[],"/docs/pr-preview/pr-26/test#list","List",{"_2384":1948,"_23648":1943,"_16085":42810,"_5":15974,"_22319":1943,"_1957":42811},[],"Hey there!",{"_2384":1949,"_23648":1943,"_16085":42813,"_5":15974,"_22319":42799,"_1957":42814},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_2384":1950,"_23648":1943,"_16085":42816,"_5":15974,"_22319":42799,"_1957":42817},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_2384":1951,"_23648":1943,"_16085":42819,"_5":15974,"_22319":42807,"_1957":42820},[],"Hello",{"_2384":1952,"_23648":1943,"_16085":42822,"_5":15974,"_22319":42807,"_1957":42823},[],"World","count","sorting",{"_42827":42828,"_42829":42830,"_42831":42832,"_42833":42834,"_13870":1974,"_50600":1974},"language","english","sortableProperties",[1957,23648,5,22319],"sortablePropertiesWithTypes",{"_1957":19440,"_23648":19440,"_5":19440,"_22319":19440},"sorts",{"_1957":42835,"_23648":44777,"_5":46718,"_22319":48659},{"_3235":42836,"_42837":42838,"_5":19440},{"_10879":2340,"_11172":6895,"_11190":2623,"_22900":3599,"_7658":2944,"_15168":5442,"_10872":5843,"_10900":5480,"_22841":2736,"_23221":3624,"_23236":4958,"_22896":4593,"_26959":4222,"_23241":5401,"_26964":3280,"_26967":5360,"_26970":4952,"_26973":5057,"_26976":2113,"_23516":3445,"_26981":4713,"_26983":2067,"_23536":5335,"_11186":5437,"_26987":2735,"_23705":3290,"_26991":5314,"_23259":2357,"_