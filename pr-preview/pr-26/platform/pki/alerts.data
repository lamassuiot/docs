w.mdx","Despliega Lamassu en tu propio clúster Kubernetes con Helm o Fastlane.",{"_59":280},{"_34":284,"_41":52,"_36":21,"_46":285,"_55":-7,"_12":19,"_57":286},"deployment/self-hosted/fastlane.mdx","Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes",{"_59":284},{"_34":288,"_41":62,"_55":-7,"_36":289},"_6","Otros modelos",{"_34":291,"_41":52,"_36":292,"_46":293,"_55":-7,"_12":294,"_57":295},"deployment/aws-marketplace.mdx","Despliega desde AWS Marketplace","Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.","/docs/pr-preview/pr-26/deployment/aws-marketplace",{"_59":291},{"_34":297,"_41":52,"_36":298,"_46":299,"_55":-7,"_12":300,"_57":301},"deployment/saas.mdx","Utiliza Lamassu como SaaS","Consume Lamassu como servicio gestionado sin operar infraestructura propia.","/docs/pr-preview/pr-26/deployment/saas",{"_59":297},"deployment",{"_264":304},"deployment/meta.json","<link rel=\"preload\" as=\"image\" href=\"/docs/pr-preview/pr-26/images/kubernetes.svg\"/><img src=\"/docs/pr-preview/pr-26/images/kubernetes.svg\" width=\"20\" height=\"20\" style=\"width:1.25rem;height:1.25rem;vertical-align:middle;flex-shrink:0;object-fit:contain\"/>","fallback",{"_34":308,"_36":37,"_38":309,"_306":-7},"fallback:root",[310],{"_34":311,"_41":52,"_36":312,"_46":313,"_55":-7,"_12":314,"_57":315},"fallback:test.mdx","Test","A document to test Fumadocs","/docs/pr-preview/pr-26/test",{"_59":316},"test.mdx"]
