s-iot-core#parámetros-de-configuración","content":"No"},"1401":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-90","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas)."},"1402":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-91","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`subscriber_event_bus`"},"1403":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-92","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"objeto"},"1404":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-93","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1405":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-94","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS)."},"1406":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-95","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`dms_manager_client`"},"1407":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-96","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"1408":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-97","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1409":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-98","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"URL HTTP del servicio DMS Manager de Lamassu."},"1410":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-99","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`device_manager_client`"},"1411":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-100","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"1412":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-101","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1413":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-102","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"URL HTTP del Device Manager de Lamassu."},"1414":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-103","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"`ca_client`"},"1415":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-104","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"1416":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-105","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1417":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-106","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","content":"URL HTTP del servicio de CA de Lamassu."},"1418":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-107","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","content":"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA."},"1419":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-108","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","content":"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API."},"1420":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-109","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","content":"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya."},"1421":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-110","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#primary-account","content":"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:"},"1422":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-111","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#primary-account","content":"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS."},"1423":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-112","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#primary-account","content":"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS."},"1424":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-113","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#primary-account","content":"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`."},"1425":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-114","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#primary-account","content":"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente."},"1426":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-115","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#primary-account","content":"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`."},"1427":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-116","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","content":"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente."},"1428":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-117","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#configuración-del-dms","content":"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS."},"1429":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-118","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#configuración-del-dms","content":"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota."},"1430":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-119","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-none","content":"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado."},"1431":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-120","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-auto","content":"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:"},"1432":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-121","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-auto","content":"Crea o actualiza las políticas IoT configuradas en el DMS."},"1433":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-122","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-auto","content":"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente."},"1434":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-123","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-auto","content":"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse."},"1435":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-124","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-auto","content":"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager."},"1436":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-125","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-auto","content":"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core."},"1437":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-126","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-jitp","content":"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa."},"1438":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-127","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-jitp","content":"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`."},"1439":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-128","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#modo-jitp","content":"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP."},"1440":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-129","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional."},"1441":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-130","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"El flujo completo desde el punto de vista del dispositivo es el siguiente:"},"1442":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-131","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado."},"1443":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-132","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez."},"1444":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-133","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión."},"1445":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-134","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Para que el flujo JITP funcione correctamente:"},"1446":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-135","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP)."},"1447":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-136","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS."},"1448":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-137","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core."},"1449":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-138","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección."},"1450":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-139","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:"},"1451":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-140","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Estado en Lamassu"},"1452":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-141","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Razón de revocación"},"1453":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-142","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Estado en AWS IoT Core"},"1454":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-143","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Active`"},"1455":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-144","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Ninguna"},"1456":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-145","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`ACTIVE`"},"1457":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-146","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Revoked`"},"1458":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-147","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`certificateHold`"},"1459":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-148","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`INACTIVE`"},"1460":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-149","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Revoked`"},"1461":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-150","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Cualquier otra razón"},"1462":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-151","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`REVOKED`"},"1463":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-152","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`."},"1464":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-153","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento."},"1465":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-154","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`."},"1466":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-155","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector."},"1467":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-156","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","content":"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`."},"1468":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-157","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","content":"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing)."},"1469":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-158","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia."},"1470":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-159","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"Existen dos tipos de acciones:"},"1471":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-160","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire."},"1472":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-161","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza."},"1473":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-162","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia."},"1474":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-163","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","content":"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:"},"1475":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-164","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","content":"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN."},"1476":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-165","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","content":"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector)."},"1477":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-166","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`."},"1478":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-167","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto."},"1479":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-168","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA."},"1480":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-169","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación."},"1481":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-170","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado."},"1482":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-171","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento."},"1483":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-172","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación."},"1484":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-173","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión."},"1485":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-174","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core."},"1486":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-175","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core."},"1487":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-176","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu."},"1488":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-177","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT."},"1489":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-178","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera."},"1490":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-179","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo."},"1491":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-180","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas."},"1492":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-181","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El Device Shadow no se actualiza cuando debería."},"1493":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-182","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado."},"1494":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-183","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`."},"1495":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-184","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />"},"1496":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-185","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />"},"1497":{"id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core-186","page_id":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />"},"1498":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"page","content":"Claves y motores criptográficos","breadcrumbs":["Docs","Plataforma","Operar Lamassu"],"tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management"},"1499":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-0","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management","content":"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto."},"1500":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-1","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#gestión-de-claves-criptográficas","content":"Gestión de claves criptográficas"},"1501":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-2","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#qué-resuelve-el-kms","content":"Qué resuelve el KMS"},"1502":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-3","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#motores-criptográficos","content":"Motores criptográficos"},"1503":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-4","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#file-system","content":"File System"},"1504":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-5","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#hashicorp-vault","content":"HashiCorp Vault"},"1505":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-6","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#aws-secrets-manager","content":"AWS Secrets Manager"},"1506":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-7","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#aws-kms","content":"AWS KMS"},"1507":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-8","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#pkcs11","content":"PKCS#11"},"1508":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-9","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"Inventario de claves"},"1509":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-10","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#crear-o-importar-claves","content":"Crear o importar claves"},"1510":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-11","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"Generar un nuevo par de claves"},"1511":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-12","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"Importar un par existente"},"1512":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-13","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#operaciones-sobre-una-clave","content":"Operaciones sobre una clave"},"1513":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-14","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#ver-detalles","content":"Ver detalles"},"1514":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-15","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#firmar-y-verificar","content":"Firmar y verificar"},"1515":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-16","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#sign","content":"Sign"},"1516":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-17","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#verify","content":"Verify"},"1517":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-18","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-csr","content":"Generar un CSR"},"1518":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-19","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/key-management#firma-local-con-pkcs11","content":"Firma local con PKCS#11"},"1519":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-20","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#gestión-de-claves-criptográficas","content":"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI."},"1520":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-21","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#gestión-de-claves-criptográficas","content":"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema."},"1521":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-22","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#qué-resuelve-el-kms","content":"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto."},"1522":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-23","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#qué-resuelve-el-kms","content":"En la práctica, permite:"},"1523":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-24","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#qué-resuelve-el-kms","content":"Generar nuevos pares de claves desde Lamassu IoT."},"1524":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-25","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#qué-resuelve-el-kms","content":"Importar claves creadas externamente."},"1525":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-26","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#qué-resuelve-el-kms","content":"Delegar la custodia y las operaciones criptográficas en motores externos."},"1526":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-27","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#qué-resuelve-el-kms","content":"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación."},"1527":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-28","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#motores-criptográficos","content":"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada."},"1528":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-29","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#motores-criptográficos","content":"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios."},"1529":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-30","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#motores-criptográficos","content":"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado."},"1530":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-31","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#file-system","content":"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción."},"1531":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-32","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#hashicorp-vault","content":"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*."},"1532":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-33","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#aws-secrets-manager","content":"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM."},"1533":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-34","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#aws-kms","content":"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica."},"1534":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-35","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#pkcs11","content":"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware."},"1535":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-36","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#pkcs11","content":"Lamassu muestra en la consola el listado completo de motores habilitados."},"1536":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-37","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#pkcs11","content":"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar."},"1537":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-38","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#pkcs11","content":"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA."},"1538":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-39","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas."},"1539":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-40","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"La tabla incluye los siguientes campos:"},"1540":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-41","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Name**: nombre descriptivo de la clave."},"1541":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-42","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256."},"1542":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-43","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Strength**: indicador visual de fortaleza criptográfica."},"1543":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-44","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública."},"1544":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-45","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Crypto Engine**: motor criptográfico que custodia la clave."},"1545":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-46","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Aliases**: nombres alternativos asociados a la clave."},"1546":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-47","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Tags**: etiquetas para clasificación y búsqueda."},"1547":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-48","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Related Entities**: certificados u otras entidades vinculadas a esa clave."},"1548":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-49","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"Desde esta vista también se accede a las acciones más habituales:"},"1549":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-50","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**View Details** para consultar metadatos, identificadores y relaciones."},"1550":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-51","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada."},"1551":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-52","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Sign / Verify** para probar operaciones criptográficas sobre la clave."},"1552":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-53","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#inventario-de-claves","content":"**Delete Key** para eliminar la clave del sistema."},"1553":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-54","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#crear-o-importar-claves","content":"El alta de claves se realiza desde el asistente que se abre con **Create New Key**."},"1554":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-55","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados."},"1555":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-56","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:"},"1556":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-57","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Key Name**: nombre único y descriptivo."},"1557":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-58","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Crypto Engine**: motor que custodiará la clave."},"1558":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-59","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Key Type** y **Key Size**: algoritmo y tamaño o curva."},"1559":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-60","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Tags**: metadatos para clasificar la clave."},"1560":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-61","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Metadata**: información adicional para usos avanzados."},"1561":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-62","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción."},"1562":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-63","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"Cuando la clave se ha generado en un entorno aislado o en un HSM externo."},"1563":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-64","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"Cuando se necesita migrar una PKI existente sin reemitir certificados."},"1564":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-65","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero."},"1565":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-66","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:"},"1566":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-67","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"**Key Name**: nombre descriptivo dentro de Lamassu IoT."},"1567":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-68","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"**Crypto Engine**: motor que custodiará la clave importada."},"1568":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-69","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"**Tags**: etiquetas para organización y búsqueda."},"1569":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-70","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"**Metadata**: información adicional opcional."},"1570":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-71","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"**Private Key (PEM)**: clave privada en formato PEM."},"1571":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-72","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#importar-un-par-existente","content":"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS."},"1572":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-73","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#operaciones-sobre-una-clave","content":"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas."},"1573":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-74","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#ver-detalles","content":"La pantalla **View Details** concentra la información técnica y administrativa de la clave."},"1574":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-75","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#ver-detalles","content":"En la pestaña **Overview** se muestran, entre otros, estos campos:"},"1575":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-76","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#ver-detalles","content":"**Key Name**: nombre descriptivo."},"1576":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-77","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-management#ver-detalles","content":"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11."},"1577":{"id":"/docs/pr-preview/pr-27/platform/pki/key-management-78","page_id":"/docs/pr-preview/pr-27/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/key-manage