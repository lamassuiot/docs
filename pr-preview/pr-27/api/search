rollment-20","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#flujos-completos","content":"Flujos completos"},"1082":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-21","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","content":"Ejemplo end-to-end: enroll"},"1083":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-22","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","content":"Ejemplo end-to-end: reenroll"},"1084":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-23","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","content":"Próximos pasos tras el enrolamiento"},"1085":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-24","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#diagnóstico-y-compatibilidad","content":"Diagnóstico y compatibilidad"},"1086":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-25","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"Códigos de error y diagnóstico"},"1087":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-26","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","type":"heading","tags":[],"url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#notas-de-compatibilidad","content":"Notas de compatibilidad"},"1088":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-27","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación. Así, actúa como autoridad de registro (RA) frente al cliente."},"1089":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-28","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`."},"1090":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-29","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"Esta guía está dividida en dos partes:"},"1091":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-30","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"Configuración del DMS, para el administrador PKI."},"1092":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-31","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento."},"1093":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-32","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"Si solo necesita una orientación rápida, este es el recorrido recomendado:"},"1094":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-33","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"**Administrador PKI:** empiece por Configuración del DMS y termine con Diagnóstico y compatibilidad."},"1095":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-34","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#est-enrollment-over-secure-transport","content":"**Integrador de dispositivos:** empiece por Antes de empezar y continúe con `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo que vaya a implementar."},"1096":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-35","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#requisitos-previos","content":"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:"},"1097":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-36","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#requisitos-previos","content":"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap."},"1098":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-37","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#requisitos-previos","content":"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea."},"1099":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-38","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#requisitos-previos","content":"Conviene separar cuatro bloques de configuración:"},"1100":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-39","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#requisitos-previos","content":"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente."},"1101":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-40","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#requisitos-previos","content":"Cómo se gestionará el re-enrollment de certificados ya emitidos."},"1102":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-41","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#requisitos-previos","content":"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos."},"1103":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-42","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#requisitos-previos","content":"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`."},"1104":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-43","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-device-registration","content":"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican."},"1105":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-44","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-device-registration","content":"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado."},"1106":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-45","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-device-registration","content":"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos."},"1107":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-46","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-device-registration","content":"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual."},"1108":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-47","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota."},"1109":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-48","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment."},"1110":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-49","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa."},"1111":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-50","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Puede exigir un certificado mTLS (`CLIENT_CERTIFICATE`), delegar la autorización en un webhook (`EXTERNAL_WEBHOOK`), combinar ambos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) o aceptar solicitudes sin autenticación (`NO_AUTH`). Este último modo debe limitarse a laboratorios o redes de aprovisionamiento aisladas."},"1112":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-51","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:"},"1113":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-52","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo."},"1114":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-53","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz."},"1115":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-54","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo."},"1116":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-55","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:"},"1117":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-56","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**Webhook URL**: dirección del servicio externo que decidirá la autorización."},"1118":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-57","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada."},"1119":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-58","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación."},"1120":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-59","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`."},"1121":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-60","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#enrollment-settings","content":"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización."},"1122":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-61","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#perfil-de-emisión","content":"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:"},"1123":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-62","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#perfil-de-emisión","content":"**`HonorSubject`** controla si el subject del CSR se traslada literalmente al certificado. Si está desactivado, la CA aplica la plantilla del perfil e ignora el subject recibido."},"1124":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-63","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#perfil-de-emisión","content":"**`HonorKeyUsage`** decide si se respeta el `KeyUsage` del CSR o se sustituye por el definido en la plantilla."},"1125":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-64","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#perfil-de-emisión","content":"**`HonorExtendedKeyUsages`** aplica la misma regla a `ExtKeyUsage`."},"1126":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-65","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#perfil-de-emisión","content":"**`HonorExtensions`** controla si el resto de extensiones del CSR, como SAN o CDP, se incluyen en el certificado."},"1127":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-66","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#perfil-de-emisión","content":"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas."},"1128":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-67","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-re-enrollment","content":"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado."},"1129":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-68","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-re-enrollment","content":"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo."},"1130":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-69","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-re-enrollment","content":"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana."},"1131":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-70","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-re-enrollment","content":"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`."},"1132":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-71","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-re-enrollment","content":"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva."},"1133":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-72","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-re-enrollment","content":"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico."},"1134":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-73","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-re-enrollment","content":"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior."},"1135":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-74","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-serverkeygen","content":"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada."},"1136":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-75","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-serverkeygen","content":"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`."},"1137":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-76","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-serverkeygen","content":"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521."},"1138":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-77","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#configuración-de-serverkeygen","content":"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad."},"1139":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-78","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#verificar-la-configuración","content":"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:"},"1140":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-79","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#verificar-la-configuración","content":"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado."},"1141":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-80","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#verificar-la-configuración","content":"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible."},"1142":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-81","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#verificar-la-configuración","content":"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error."},"1143":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-82","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#integración-de-dispositivos","content":"*Esta sección está dirigida al integrador de dispositivos.*"},"1144":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-83","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#integración-de-dispositivos","content":"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona."},"1145":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-84","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#integración-de-dispositivos","content":"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico."},"1146":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-85","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#antes-de-empezar","content":"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página."},"1147":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-86","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#antes-de-empezar","content":"Antes de realizar la primera llamada, asegúrese de tener:"},"1148":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-87","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#antes-de-empezar","content":"**La URL del host EST**, por ejemplo `https://est.lamassu.example`, proporcionada por el administrador PKI."},"1149":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-88","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#antes-de-empezar","content":"**El ancla de confianza del servidor** (`lamassu-trust.pem`), raíz o intermedia, con la que el cliente validará el TLS de Lamassu."},"1150":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-89","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#antes-de-empezar","content":"**El certificado bootstrap y su clave privada** si el DMS usa `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Esta identidad debe proceder de una de las `ValidationCAs` configuradas, normalmente una CA de aprovisionamiento distinta de la CA de enrolamiento."},"1151":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-90","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#antes-de-empezar","content":"**El ID del DMS** (`{aps}`), que debe aparecer en todas las rutas EST."},"1152":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-91","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#resumen-del-flujo","content":"**Descargue la confianza con `/cacerts`:** el cliente valida el TLS del servidor y recibe los certificados en PKCS#7 o PEM."},"1153":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-92","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#resumen-del-flujo","content":"**Realice el alta inicial con `/simpleenroll`:** presente el certificado bootstrap o la credencial definida por `AuthMode` para obtener el certificado del dispositivo."},"1154":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-93","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#resumen-del-flujo","content":"**Renueve con `/simplereenroll`:** autentíquese con el certificado actual del dispositivo para obtener uno nuevo."},"1155":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-94","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#resumen-del-flujo","content":"**Use `/serverkeygen` solo si necesita generación de claves en servidor:** aplica la misma autenticación que `/simpleenroll` y devuelve la clave privada PKCS#8 junto con el certificado."},"1156":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-95","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción."},"1157":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-96","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Modo (`AuthMode`)"},"1158":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-97","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Descripción"},"1159":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-98","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Credencial esperada"},"1160":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-99","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Aplica en enroll"},"1161":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-100","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Aplica en reenroll"},"1162":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-101","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"`CLIENT_CERTIFICATE`"},"1163":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-102","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"mTLS con certificado X.509"},"1164":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-103","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Certificado y clave privada cliente"},"1165":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-104","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Sí"},"1166":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-105","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Sí (con el certificado en vigor)"},"1167":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-106","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"1168":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-107","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"mTLS más validación por webhook"},"1169":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-108","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Certificado y clave privada cliente, más aprobación del webhook"},"1170":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-109","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Sí"},"1171":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-110","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"No como combinación; en reenroll no mantiene ambos controles"},"1172":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-111","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"`EXTERNAL_WEBHOOK`"},"1173":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-112","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Webhook externo de autorización"},"1174":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-113","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Ninguna en el canal TLS"},"1175":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-114","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Sí"},"1176":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-115","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"No, degrada a `NO_AUTH`"},"1177":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-116","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"`NO_AUTH`"},"1178":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-117","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Sin autenticación"},"1179":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-118","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Ninguna"},"1180":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-119","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Sí (uso restringido)"},"1181":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-120","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Sí (uso restringido)"},"1182":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-121","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización."},"1183":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-122","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`."},"1184":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-123","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"Sus parámetros principales son `ValidationCAs`, la lista de CAs que pueden validar el certificado bootstrap o el certificado en vigor; `AllowExpired`, que permite aceptar certificados cliente caducados; y `ChainLevelValidation`, que limita la profundidad de la cadena cuando su valor es mayor que cero."},"1185":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-124","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción."},"1186":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-125","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error."},"1187":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-126","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll`. El cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll."},"1188":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-127","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","content":"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados."},"1189":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-128","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#referencia-de-endpoints","content":"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:"},"1190":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-129","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#referencia-de-endpoints","content":"`/cacerts`: descarga de la cadena de confianza."},"1191":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-130","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#referencia-de-endpoints","content":"`/simpleenroll`: inscripción inicial del certificado."},"1192":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-131","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#referencia-de-endpoints","content":"`/simplereenroll`: renovación de un certificado ya emitido."},"1193":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-132","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#referencia-de-endpoints","content":"`/serverkeygen`: inscripción con generación de clave en servidor."},"1194":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-133","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#cacerts","content":"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado."},"1195":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-134","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#cacerts","content":"`CADistributionSettings` permite decidir qué se publica:"},"1196":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-135","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#cacerts","content":"**`IncludeLamassuSystemCA`** añade el certificado *downstream* del servidor Lamassu. Es la hoja TLS que el cliente puede usar para anclar la conexión, no una CA."},"1197":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-136","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#cacerts","content":"**`IncludeEnrollmentCA`** añade la CA emisora del DMS, responsable de firmar los certificados de dispositivo."},"1198":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-137","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#cacerts","content":"**`ManagedCAs`** publica CAs adicionales como anclas de confianza."},"1199":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-138","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#cacerts","content":"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo."},"1200":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-139","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#cacerts","content":"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta."},"1201":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-140","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#cacerts","content":"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora."},"1202":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-141","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#cacerts","content":"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`."},"1203":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-142","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simpleenroll","content":"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`."},"1204":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-143","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simpleenroll","content":"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta)."},"1205":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-144","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simpleenroll","content":"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos:"},"1206":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-145","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simpleenroll","content":"**`EnrollmentSettings.RegistrationMode`** decide si el dispositivo se crea durante la primera inscripción (`JITP`) o debe existir previamente (`PRE_REGISTRATION`)."},"1207":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-146","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simpleenroll","content":"**`EnrollmentSettings.EnableReplaceableEnrollment`** permite repetir `/simpleenroll` para un dispositivo ya enrolado. Al hacerlo, revoca el certificado anterior como `superseded`; si está desactivado, el servidor responde con `forbiddenNewEnrollment`."},"1208":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-147","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simpleenroll","content":"**`EnrollmentSettings.VerifyCSRSignature`** valida que quien envía el CSR controla la clave privada declarada. Para flotas IoT en redes abiertas debe estar activo."},"1209":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-148","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simpleenroll","content":"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión."},"1210":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-149","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simplereenroll","content":"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS."},"1211":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-150","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simplereenroll","content":"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint."},"1212":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-151","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simplereenroll","content":"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:"},"1213":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-152","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simplereenroll","content":"**`ReEnrollmentDelta`** abre la ventana de renovación en `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`."},"1214":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-153","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simplereenroll","content":"**`EnableExpiredRenewal`** permite usar un certificado ya caducado como prueba de identidad; si está desactivado, el servidor responde con `expired certificate`."},"1215":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-154","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simplereenroll","content":"**`RevokeOnReEnrollment`** revoca el certificado anterior como `superseded` después de emitir el nuevo."},"1216":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-155","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simplereenroll","content":"**`AdditionalValidationCAs`** añade emisores válidos para el certificado actual, además de la CA de enrolamiento del DMS."},"1217":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-156","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simplereenroll","content":"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback."},"1218":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-157","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#simplereenroll","content":"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`."},"1219":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-158","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación."},"1220":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-159","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS."},"1221":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-160","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente."},"1222":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-161","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"**RSA** admite cualquier tamaño aceptado por `crypto/rsa`; los valores habituales son 2048, 3072 y 4096 bits. Un valor no válido hace fallar la generación con un error `500`."},"1223":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-162","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"**ECDSA** admite 224, 256, 384 y 521 bits, equivalentes a P-224, P-256 (`prime256v1`), P-384 y P-521. Cualquier otro valor degrada **silenciosamente** a P-256 y solo deja un aviso en el log: el cliente no recibe un error y puede obtener una curva distinta de la esperada."},"1224":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-163","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`."},"1225":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-164","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:"},"1226":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-165","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`."},"1227":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-166","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`."},"1228":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-167","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo."},"1229":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-168","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave."},"1230":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-169","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#serverkeygen","content":"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá."},"1231":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-170","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#flujos-completos","content":"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido."},"1232":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-171","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","content":"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap."},"1233":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-172","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","content":"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor."},"1234":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-173","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","content":"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:"},"1235":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-174","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","content":"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena."},"1236":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-175","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","content":"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa."},"1237":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-176","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","content":"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo."},"1238":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-177","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo."},"1239":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-178","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"HTTP"},"1240":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-179","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"Mensaje"},"1241":{"id