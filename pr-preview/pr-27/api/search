i/est-enrollment-187","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"`content-type must be application/pkcs10`"},"1249":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-188","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"Cabecera `Content-Type` ausente o incorrecta."},"1250":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-189","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"Fijar `Content-Type: application/pkcs10`."},"1251":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-190","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"400"},"1252":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-191","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"`body payload must be base64 encoded`"},"1253":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-192","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"El cuerpo no es base64 válido."},"1254":{"id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment-193","page_id":"/docs/pr-preview/pr-27/platform/pki/est-enrollment","tags":[],"type":"text","url":"/docs/pr-preview/pr-27/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","content":"Usar `base64 -w 0` para evi