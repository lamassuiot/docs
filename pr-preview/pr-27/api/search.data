,"_32166":46211,"_32168":46215,"_32170":46218,"_32172":46222,"_32174":46226,"_32176":46230,"_32178":46233,"_32180":46236,"_32182":46239,"_32184":46242,"_32186":46245,"_32188":46248,"_32190":46251,"_32192":46254,"_32194":46257,"_32196":46260,"_32198":46263,"_32200":46266,"_32202":46269,"_32204":46272,"_32206":46275,"_32208":46278,"_32210":46281,"_32212":46284,"_32214":46287,"_32216":46290,"_32218":46293,"_32220":46296,"_32222":46299,"_32224":46302,"_32226":46304,"_32228":46307,"_32230":46310,"_32232":46313,"_32234":46316,"_32236":46319,"_32238":46322,"_32240":46325,"_32242":46328,"_32244":46331,"_32246":46334,"_32248":46337,"_32250":46340,"_32252":46343,"_32254":46346,"_32256":46349,"_32258":46352,"_32260":46355,"_32262":46359,"_32264":46362,"_32266":46365,"_32268":46369,"_32270":46372,"_32272":46376,"_32274":46379,"_32276":46382,"_32278":46385,"_32280":46388,"_32282":46391,"_32284":46394,"_32286":46397,"_32288":46400,"_32290":46403,"_32292":46406,"_32294":46409,"_32296":46411,"_32298":46414,"_32300":46417,"_32302":46420,"_32304":46423,"_32306":46426,"_32308":46429,"_32310":46432,"_32312":46435,"_32314":46438,"_32316":46441,"_32318":46445,"_32320":46448,"_32322":46452,"_32324":46456,"_32326":46460,"_32328":46463,"_32330":46466,"_32332":46468,"_32334":46471,"_32336":46473,"_32338":46476,"_32340":46479,"_32342":46482,"_32344":46485,"_32346":46488,"_32348":46491,"_32350":46494,"_32352":46497,"_32354":46500,"_32356":46503,"_32358":46506,"_32360":46509,"_32362":46511,"_32364":46514,"_32366":46517,"_32368":46520,"_32370":46523,"_32372":46526,"_32374":46529,"_32376":46532,"_32378":46535,"_32380":46538,"_32382":46541,"_32384":46544,"_32386":46547},{"_2783":15,"_24069":15,"_5":11891,"_2311":39335,"_24405":39336,"_16893":39340,"_22829":15},"Deploy from AWS Marketplace",[39337,39338,39339],"Docs","Deployment","Other models",[],{"_2783":16,"_24069":15,"_16893":39342,"_5":16788,"_22829":15,"_2311":39343},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2783":17,"_24069":15,"_5":24402,"_16893":39345,"_22829":39346,"_2311":39347},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2783":18,"_24069":15,"_5":24402,"_16893":39349,"_22829":39350,"_2311":39351},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2783":19,"_24069":15,"_5":24402,"_16893":39353,"_22829":39354,"_2311":39355},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2783":20,"_24069":15,"_5":24402,"_16893":39357,"_22829":39358,"_2311":39359},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2783":21,"_24069":15,"_5":24402,"_16893":39361,"_22829":39362,"_2311":39363},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2783":22,"_24069":15,"_5":24402,"_16893":39365,"_22829":39366,"_2311":39367},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2783":23,"_24069":15,"_5":24402,"_16893":39369,"_22829":39370,"_2311":39371},[],"/docs/pr-preview/pr-27/deployment/aws-marketplace#next-step","Next step",{"_2783":24,"_24069":15,"_16893":39373,"_5":16788,"_22829":15,"_2311":39374},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2783":25,"_24069":15,"_16893":39376,"_5":16788,"_22829":39346,"_2311":39377},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2783":26,"_24069":15,"_16893":39379,"_5":16788,"_22829":39346,"_2311":39380},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2783":27,"_24069":15,"_16893":39382,"_5":16788,"_22829":39346,"_2311":39383},[],"A security group allowing the necessary endpoints.",{"_2783":28,"_24069":15,"_16893":39385,"_5":16788,"_22829":39350,"_2311":39386},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2783":29,"_24069":15,"_16893":39388,"_5":16788,"_22829":39350,"_2311":39389},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2783":30,"_24069":15,"_16893":39391,"_5":16788,"_22829":39350,"_2311":39392},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2783":31,"_24069":15,"_16893":39394,"_5":16788,"_22829":39354,"_2311":39395},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2783":32,"_24069":15,"_16893":39397,"_5":16788,"_22829":39358,"_2311":39398},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2783":33,"_24069":15,"_16893":39400,"_5":16788,"_22829":39362,"_2311":39401},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2783":34,"_24069":15,"_16893":39403,"_5":16788,"_22829":39366,"_2311":39404},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2783":35,"_24069":15,"_16893":39406,"_5":16788,"_22829":39370,"_2311":39407},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2783":36,"_24069":36,"_5":11891,"_2311":39409,"_24405":39410,"_16893":39411,"_22829":36},"Deploy Lamassu",[39337,39338],[],{"_2783":37,"_24069":36,"_16893":39413,"_5":16788,"_22829":36,"_2311":39414},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2783":38,"_24069":36,"_5":24402,"_16893":39416,"_22829":39417,"_2311":39418},[],"/docs/pr-preview/pr-27/deployment/overview#choose-a-model","Choose a model",{"_2783":39,"_24069":36,"_5":24402,"_16893":39420,"_22829":39421,"_2311":39422},[],"/docs/pr-preview/pr-27/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2783":40,"_24069":36,"_5":24402,"_16893":39424,"_22829":39425,"_2311":39426},[],"/docs/pr-preview/pr-27/deployment/overview#after-deployment","After deployment",{"_2783":41,"_24069":36,"_16893":39428,"_5":16788,"_22829":36,"_2311":39429},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2783":42,"_24069":36,"_16893":39431,"_5":16788,"_22829":39417,"_2311":39432},[],"Model",{"_2783":43,"_24069":36,"_16893":39434,"_5":16788,"_22829":39417,"_2311":39435},[],"Recommended for",{"_2783":44,"_24069":36,"_16893":39437,"_5":16788,"_22829":39417,"_2311":39438},[],"Who operates the infrastructure",{"_2783":45,"_24069":36,"_16893":39440,"_5":16788,"_22829":39417,"_2311":39441},[],"Starting point",{"_2783":46,"_24069":36,"_16893":39443,"_5":16788,"_22829":39417,"_2311":39444},[],"Kubernetes self-managed",{"_2783":47,"_24069":36,"_16893":39446,"_5":16788,"_22829":39417,"_2311":39447},[],"Production, regulated environments and custom deployments",{"_2783":48,"_24069":36,"_16893":39449,"_5":16788,"_22829":39417,"_2311":39450},[],"Your team",{"_2783":49,"_24069":36,"_16893":39452,"_5":16788,"_22829":39417,"_2311":39453},[],"Helm or Fastlane",{"_2783":50,"_24069":36,"_16893":39455,"_5":16788,"_22829":39417,"_2311":39456},[],"AWS Marketplace",{"_2783":51,"_24069":36,"_16893":39458,"_5":16788,"_22829":39417,"_2311":39459},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2783":52,"_24069":36,"_16893":39461,"_5":16788,"_22829":39417,"_2311":39450},[],{"_2783":53,"_24069":36,"_16893":39463,"_5":16788,"_22829":39417,"_2311":39464},[],"Preconfigured image on EC2",{"_2783":54,"_24069":36,"_16893":39466,"_5":16788,"_22829":39417,"_2311":39467},[],"SaaS",{"_2783":55,"_24069":36,"_16893":39469,"_5":16788,"_22829":39417,"_2311":39470},[],"Teams that want to use the platform without operating it",{"_2783":56,"_24069":36,"_16893":39472,"_5":16788,"_22829":39417,"_2311":39473},[],"Lamassu",{"_2783":57,"_24069":36,"_16893":39475,"_5":16788,"_22829":39417,"_2311":39476},[],"Managed subscription",{"_2783":58,"_24069":36,"_16893":39478,"_5":16788,"_22829":39417,"_2311":39479},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2783":59,"_24069":36,"_16893":39481,"_5":16788,"_22829":39417,"_2311":39482},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2783":60,"_24069":36,"_16893":39484,"_5":16788,"_22829":39417,"_2311":39485},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2783":61,"_24069":36,"_16893":39487,"_5":16788,"_22829":39421,"_2311":39488},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2783":62,"_24069":36,"_16893":39490,"_5":16788,"_22829":39425,"_2311":39491},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2783":63,"_24069":63,"_5":11891,"_2311":39493,"_24405":39494,"_16893":39495,"_22829":63},"Use Lamassu as SaaS",[39337,39338,39339],[],{"_2783":64,"_24069":63,"_16893":39497,"_5":16788,"_22829":63,"_2311":39498},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2783":65,"_24069":63,"_5":24402,"_16893":39500,"_22829":39501,"_2311":39502},[],"/docs/pr-preview/pr-27/deployment/saas#what-the-service-manages","What the service manages",{"_2783":66,"_24069":63,"_5":24402,"_16893":39504,"_22829":39505,"_2311":39506},[],"/docs/pr-preview/pr-27/deployment/saas#plans","Plans",{"_2783":67,"_24069":63,"_5":24402,"_16893":39508,"_22829":39509,"_2311":39510},[],"/docs/pr-preview/pr-27/deployment/saas#request-access","Request access",{"_2783":68,"_24069":63,"_16893":39512,"_5":16788,"_22829":63,"_2311":39513},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2783":69,"_24069":63,"_16893":39515,"_5":16788,"_22829":39501,"_2311":39516},[],"Platform availability and maintenance.",{"_2783":70,"_24069":63,"_16893":39518,"_5":16788,"_22829":39501,"_2311":39519},[],"Automatic backups.",{"_2783":71,"_24069":63,"_16893":39521,"_5":16788,"_22829":39501,"_2311":39522},[],"Version upgrades.",{"_2783":72,"_24069":63,"_16893":39524,"_5":16788,"_22829":39501,"_2311":39525},[],"Technical support and SLA according to your plan.",{"_2783":73,"_24069":63,"_16893":39527,"_5":16788,"_22829":39505,"_2311":39528},[],"Plan",{"_2783":74,"_24069":63,"_16893":39530,"_5":16788,"_22829":39505,"_2311":39531},[],"Devices",{"_2783":75,"_24069":63,"_16893":39533,"_5":16788,"_22829":39505,"_2311":39534},[],"Support",{"_2783":76,"_24069":63,"_16893":39536,"_5":16788,"_22829":39505,"_2311":39537},[],"SLA",{"_2783":77,"_24069":63,"_16893":39539,"_5":16788,"_22829":39505,"_2311":39540},[],"Starter",{"_2783":78,"_24069":63,"_16893":39542,"_5":16788,"_22829":39505,"_2311":39543},[],"Up to 1,000",{"_2783":79,"_24069":63,"_16893":39545,"_5":16788,"_22829":39505,"_2311":39546},[],"Email",{"_2783":80,"_24069":63,"_16893":39548,"_5":16788,"_22829":39505,"_2311":39549},[],"99.5 %",{"_2783":81,"_24069":63,"_16893":39551,"_5":16788,"_22829":39505,"_2311":39552},[],"Professional",{"_2783":82,"_24069":63,"_16893":39554,"_5":16788,"_22829":39505,"_2311":39555},[],"Up to 10,000",{"_2783":83,"_24069":63,"_16893":39557,"_5":16788,"_22829":39505,"_2311":39558},[],"Email and chat",{"_2783":84,"_24069":63,"_16893":39560,"_5":16788,"_22829":39505,"_2311":39561},[],"99.9 %",{"_2783":85,"_24069":63,"_16893":39563,"_5":16788,"_22829":39505,"_2311":39564},[],"Enterprise",{"_2783":86,"_24069":63,"_16893":39566,"_5":16788,"_22829":39505,"_2311":39567},[],"Unlimited",{"_2783":87,"_24069":63,"_16893":39569,"_5":16788,"_22829":39505,"_2311":39570},[],"Dedicated",{"_2783":88,"_24069":63,"_16893":39572,"_5":16788,"_22829":39505,"_2311":39573},[],"99.99 %",{"_2783":89,"_24069":63,"_16893":39575,"_5":16788,"_22829":39509,"_2311":39576},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2783":90,"_24069":63,"_16893":39578,"_5":16788,"_22829":39509,"_2311":39579},[],"When you receive your instance's credentials, continue with Get started.",{"_2783":91,"_24069":91,"_5":11891,"_2311":39581,"_24405":39582,"_16893":39583,"_22829":91},"Fastlane",[39337,39338,39444],[],{"_2783":92,"_24069":91,"_16893":39585,"_5":16788,"_22829":91,"_2311":39586},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2783":93,"_24069":91,"_5":24402,"_16893":39588,"_22829":39589,"_2311":39590},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2783":94,"_24069":91,"_5":24402,"_16893":39592,"_22829":39593,"_2311":39594},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2783":95,"_24069":91,"_5":24402,"_16893":39596,"_22829":39597,"_2311":39347},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#before-you-begin",{"_2783":96,"_24069":91,"_5":24402,"_16893":39599,"_22829":39600,"_2311":39601},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2783":97,"_24069":91,"_5":24402,"_16893":39603,"_22829":39604,"_2311":39605},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2783":98,"_24069":91,"_5":24402,"_16893":39607,"_22829":39608,"_2311":39609},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2783":99,"_24069":91,"_5":24402,"_16893":39611,"_22829":39612,"_2311":39613},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2783":100,"_24069":91,"_5":24402,"_16893":39615,"_22829":39616,"_2311":39617},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2783":101,"_24069":91,"_5":24402,"_16893":39619,"_22829":39620,"_2311":39621},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2783":102,"_24069":91,"_5":24402,"_16893":39623,"_22829":39624,"_2311":39625},[],"/docs/pr-preview/pr-27/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2783":103,"_24069":91,"_16893":39627,"_5":16788,"_22829":39589,"_2311":39628},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2783":104,"_24069":91,"_16893":39630,"_5":16788,"_22829":39589,"_2311":39631},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2783":105,"_24069":91,"_16893":39633,"_5":16788,"_22829":39593,"_2311":39634},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2783":106,"_24069":91,"_16893":39636,"_5":16788,"_22829":39593,"_2311":39637},[],"Fastlane installs or configures",{"_2783":107,"_24069":91,"_16893":39639,"_5":16788,"_22829":39593,"_2311":39640},[],"You still provide",{"_2783":108,"_24069":91,"_16893":39642,"_5":16788,"_22829":39593,"_2311":39643},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2783":109,"_24069":91,"_16893":39645,"_5":16788,"_22829":39593,"_2311":39646},[],"The Kubernetes cluster, nodes and persistent storage",{"_2783":110,"_24069":91,"_16893":39648,"_5":16788,"_22829":39593,"_2311":39649},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2783":111,"_24069":91,"_16893":39651,"_5":16788,"_22829":39593,"_2311":39652},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2783":112,"_24069":91,"_16893":39654,"_5":16788,"_22829":39593,"_2311":39655},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2783":113,"_24069":91,"_16893":39657,"_5":16788,"_22829":39593,"_2311":39658},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2783":114,"_24069":91,"_16893":39660,"_5":16788,"_22829":39593,"_2311":39661},[],"Optional observability and lab HSM components",{"_2783":115,"_24069":91,"_16893":39663,"_5":16788,"_22829":39593,"_2311":39664},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2783":116,"_24069":91,"_16893":39666,"_5":16788,"_22829":39593,"_2311":39667},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2783":117,"_24069":91,"_16893":39669,"_5":16788,"_22829":39597,"_2311":39670},[],"You need:",{"_2783":118,"_24069":91,"_16893":39672,"_5":16788,"_22829":39597,"_2311":39673},[],"an existing Kubernetes cluster",{"_2783":119,"_24069":91,"_16893":39675,"_5":16788,"_22829":39597,"_2311":39676},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2783":120,"_24069":91,"_16893":39678,"_5":16788,"_22829":39597,"_2311":39679},[],"`yq`",{"_2783":121,"_24069":91,"_16893":39681,"_5":16788,"_22829":39597,"_2311":19088},[],{"_2783":122,"_24069":91,"_16893":39683,"_5":16788,"_22829":39597,"_2311":39684},[],"`jq` only when using `--sample-data`",{"_2783":123,"_24069":91,"_16893":39686,"_5":16788,"_22829":39597,"_2311":39687},[],"free external ports 80 and 443 on a single-node K3s host",{"_2783":124,"_24069":91,"_16893":39689,"_5":16788,"_22829":39597,"_2311":39690},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2783":125,"_24069":91,"_16893":39692,"_5":16788,"_22829":39597,"_2311":39693},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2783":126,"_24069":91,"_16893":39695,"_5":16788,"_22829":39600,"_2311":39696},[],"Run the script from a clone of the Helm repository:",{"_2783":127,"_24069":91,"_16893":39698,"_5":16788,"_22829":39600,"_2311":39699},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2783":128,"_24069":91,"_16893":39701,"_5":16788,"_22829":39604,"_2311":39702},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2783":129,"_24069":91,"_16893":39704,"_5":16788,"_22829":39604,"_2311":39705},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2783":130,"_24069":91,"_16893":39707,"_5":16788,"_22829":39604,"_2311":39708},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2783":131,"_24069":91,"_16893":39710,"_5":16788,"_22829":39604,"_2311":39711},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2783":132,"_24069":91,"_16893":39713,"_5":16788,"_22829":39608,"_2311":39714},[],"Option",{"_2783":133,"_24069":91,"_16893":39716,"_5":16788,"_22829":39608,"_2311":39717},[],"Default",{"_2783":134,"_24069":91,"_16893":39719,"_5":16788,"_22829":39608,"_2311":39720},[],"Purpose",{"_2783":135,"_24069":91,"_16893":39722,"_5":16788,"_22829":39608,"_2311":39723},[],"`-h`, `--help`",{"_2783":136,"_24069":91,"_16893":39725,"_5":16788,"_22829":39608,"_2311":39726},[],"—",{"_2783":137,"_24069":91,"_16893":39728,"_5":16788,"_22829":39608,"_2311":39729},[],"Show help",{"_2783":138,"_24069":91,"_16893":39731,"_5":16788,"_22829":39608,"_2311":39732},[],"`-c`, `--context`",{"_2783":139,"_24069":91,"_16893":39734,"_5":16788,"_22829":39608,"_2311":39735},[],"current context",{"_2783":140,"_24069":91,"_16893":39737,"_5":16788,"_22829":39608,"_2311":39738},[],"Select the kubeconfig context for kubectl and Helm",{"_2783":141,"_24069":91,"_16893":39740,"_5":16788,"_22829":39608,"_2311":39741},[],"`-n`, `--non-interactive`",{"_2783":142,"_24069":91,"_16893":39743,"_5":16788,"_22829":39608,"_2311":5183},[],{"_2783":143,"_24069":91,"_16893":39745,"_5":16788,"_22829":39608,"_2311":39746},[],"Skip prompts and generate dependency credentials",{"_2783":144,"_24069":91,"_16893":39748,"_5":16788,"_22829":39608,"_2311":39749},[],"`-ns`, `--namespace`",{"_2783":145,"_24069":91,"_16893":39751,"_5":16788,"_22829":39608,"_2311":39752},[],"`lamassu-dev`",{"_2783":146,"_24069":91,"_16893":39754,"_5":16788,"_22829":39608,"_2311":39755},[],"Namespace for the installation",{"_2783":147,"_24069":91,"_16893":39757,"_5":16788,"_22829":39608,"_2311":39758},[],"`-d`, `--domain`",{"_2783":148,"_24069":91,"_16893":39760,"_5":16788,"_22829":39608,"_2311":39761},[],"`dev.lamassu.io`",{"_2783":149,"_24069":91,"_16893":39763,"_5":16788,"_22829":39608,"_2311":39764},[],"Domain used by the UI, OIDC and certificate",{"_2783":150,"_24069":91,"_16893":39766,"_5":16788,"_22829":39608,"_2311":39767},[],"`-v`, `--version`",{"_2783":151,"_24069":91,"_16893":39769,"_5":16788,"_22829":39608,"_2311":12106},[],{"_2783":152,"_24069":91,"_16893":39771,"_5":16788,"_22829":39608,"_2311":39772},[],"Lamassu chart version",{"_2783":153,"_24069":91,"_16893":39774,"_5":16788,"_22829":39608,"_2311":39775},[],"`--https-port`",{"_2783":154,"_24069":91,"_16893":39777,"_5":16788,"_22829":39608,"_2311":39778},[],"`443`",{"_2783":155,"_24069":91,"_16893":39780,"_5":16788,"_22829":39608,"_2311":39781},[],"Gateway HTTPS listener port",{"_2783":156,"_24069":91,"_16893":39783,"_5":16788,"_22829":39608,"_2311":39784},[],"`--http-port`",{"_2783":157,"_24069":91,"_16893":39786,"_5":16788,"_22829":39608,"_2311":39787},[],"`80`",{"_2783":158,"_24069":91,"_16893":39789,"_5":16788,"_22829":39608,"_2311":39790},[],"Gateway HTTP listener port",{"_2783":159,"_24069":91,"_16893":39792,"_5":16788,"_22829":39608,"_2311":39793},[],"`--tls-crt`",{"_2783":160,"_24069":91,"_16893":39795,"_5":16788,"_22829":39608,"_2311":39726},[],{"_2783":161,"_24069":91,"_16893":39797,"_5":16788,"_22829":39608,"_2311":39798},[],"PEM certificate for downstream TLS",{"_2783":162,"_24069":91,"_16893":39800,"_5":16788,"_22829":39608,"_2311":39801},[],"`--tls-key`",{"_2783":163,"_24069":91,"_16893":39803,"_5":16788,"_22829":39608,"_2311":39726},[],{"_2783":164,"_24069":91,"_16893":39805,"_5":16788,"_22829":39608,"_2311":39806},[],"PEM private key for downstream TLS",{"_2783":165,"_24069":91,"_16893":39808,"_5":16788,"_22829":39608,"_2311":39809},[],"`-l`, `--local-chart-path`",{"_2783":166,"_24069":91,"_16893":39811,"_5":16788,"_22829":39608,"_2311":39812},[],"repository chart",{"_2783":167,"_24069":91,"_16893":39814,"_5":16788,"_22829":39608,"_2311":39815},[],"Use an unpacked local Lamassu chart",{"_2783":168,"_24069":91,"_16893":39817,"_5":16788,"_22829":39608,"_2311":39818},[],"`-ip`, `--gateway-ip`",{"_2783":169,"_24069":91,"_16893":39820,"_5":16788,"_22829":39608,"_2311":7050},[],{"_2783":170,"_24069":91,"_16893":39822,"_5":16788,"_22829":39608,"_2311":39823},[],"Override the address written to `gateway.addresses`",{"_2783":171,"_24069":91,"_16893":39825,"_5":16788,"_22829":39608,"_2311":39826},[],"`--otel`",{"_2783":172,"_24069":91,"_16893":39828,"_5":16788,"_22829":39608,"_2311":5183},[],{"_2783":173,"_24069":91,"_16893":39830,"_5":16788,"_22829":39608,"_2311":39831},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2783":174,"_24069":91,"_16893":39833,"_5":16788,"_22829":39608,"_2311":39834},[],"`--sample-data`",{"_2783":175,"_24069":91,"_16893":39836,"_5":16788,"_22829":39608,"_2311":5183},[],{"_2783":176,"_24069":91,"_16893":39838,"_5":16788,"_22829":39608,"_2311":39839},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2783":177,"_24069":91,"_16893":39841,"_5":16788,"_22829":39608,"_2311":39842},[],"`--with-hsm`",{"_2783":178,"_24069":91,"_16893":39844,"_5":16788,"_22829":39608,"_2311":5183},[],{"_2783":179,"_24069":91,"_16893":39846,"_5":16788,"_22829":39608,"_2311":39847},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2783":180,"_24069":91,"_16893":39849,"_5":16788,"_22829":39608,"_2311":39850},[],"`--softhsm-chart-path`",{"_2783":181,"_24069":91,"_16893":39852,"_5":16788,"_22829":39608,"_2311":39853},[],"`./charts/softhsm`",{"_2783":182,"_24069":91,"_16893":39855,"_5":16788,"_22829":39608,"_2311":39856},[],"Use a different local SoftHSM chart",{"_2783":183,"_24069":91,"_16893":39858,"_5":16788,"_22829":39608,"_2311":39859},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2783":184,"_24069":91,"_16893":39861,"_5":16788,"_22829":39612,"_2311":39862},[],"Fastlane:",{"_2783":185,"_24069":91,"_16893":39864,"_5":16788,"_22829":39612,"_2311":39865},[],"validates local tools and the selected cluster",{"_2783":186,"_24069":91,"_16893":39867,"_5":16788,"_22829":39612,"_2311":39868},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2783":187,"_24069":91,"_16893":39870,"_5":16788,"_22829":39612,"_2311":39871},[],"creates the namespace",{"_2783":188,"_24069":91,"_16893":39873,"_5":16788,"_22829":39612,"_2311":39874},[],"installs PostgreSQL and creates the required databases",{"_2783":189,"_24069":91,"_16893":39876,"_5":16788,"_22829":39612,"_2311":39877},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2783":190,"_24069":91,"_16893":39879,"_5":16788,"_22829":39612,"_2311":39880},[],"installs RabbitMQ",{"_2783":191,"_24069":91,"_16893":39882,"_5":16788,"_22829":39612,"_2311":39883},[],"optionally installs observability and lab HSM components",{"_2783":192,"_24069":91,"_16893":39885,"_5":16788,"_22829":39612,"_2311":39886},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2783":193,"_24069":91,"_16893":39888,"_5":16788,"_22829":39612,"_2311":39889},[],"optionally loads sample data",{"_2783":194,"_24069":91,"_16893":39891,"_5":16788,"_22829":39612,"_2311":39892},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2783":195,"_24069":91,"_16893":39894,"_5":16788,"_22829":39616,"_2311":39895},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2783":196,"_24069":91,"_16893":39897,"_5":16788,"_22829":39616,"_2311":39898},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2783":197,"_24069":91,"_16893":39900,"_5":16788,"_22829":39620,"_2311":39901},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2783":198,"_24069":91,"_16893":39903,"_5":16788,"_22829":39620,"_2311":39904},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2783":199,"_24069":91,"_16893":39906,"_5":16788,"_22829":39620,"_2311":39907},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2783":200,"_24069":91,"_16893":39909,"_5":16788,"_22829":39624,"_2311":39910},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2783":201,"_24069":201,"_5":11891,"_2311":39912,"_24405":39913,"_16893":39914,"_22829":201},"Install with Helm",[39337,39338,39444],[],{"_2783":202,"_24069":201,"_16893":39916,"_5":16788,"_22829":201,"_2311":39917},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2783":203,"_24069":201,"_5":24402,"_16893":39919,"_22829":39920,"_2311":39921},[],"/docs/pr-preview/pr-27/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2783":204,"_24069":201,"_5":24402,"_16893":39923,"_22829":39924,"_2311":39347},[],"/docs/pr-preview/pr-27/deployment/self-hosted/helm#before-you-begin",{"_2783":205,"_24069":201,"_5":24402,"_16893":39926,"_22829":39927,"_2311":39928},[],"/docs/pr-preview/pr-27/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2783":206,"_24069":201,"_5":24402,"_16893":39930,"_22829":39931,"_2311":39932},[],"/docs/pr-preview/pr-27/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2783":207,"_24069":201,"_5":24402,"_16893":39934,"_22829":39935,"_2311":39936},[],"/docs/pr-preview/pr-27/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2783":208,"_24069":201,"_5":24402,"_16893":39938,"_22829":39939,"_2311":39940},[],"/docs/pr-preview/pr-27/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2783":209,"_24069":201,"_5":24402,"_16893":39942,"_22829":39943,"_2311":39944},[],"/docs/pr-preview/pr-27/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2783":210,"_24069":201,"_5":24402,"_16893":39946,"_22829":39947,"_2311":39948},[],"/docs/pr-preview/pr-27/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2783":211,"_24069":201,"_5":24402,"_16893":39950,"_22829":39951,"_2311":39952},[],"/docs/pr-preview/pr-27/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2783":212,"_24069":201,"_16893":39954,"_5":16788,"_22829":39920,"_2311":39955},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2783":213,"_24069":201,"_16893":39957,"_5":16788,"_22829":39924,"_2311":39958},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2783":214,"_24069":201,"_16893":39960,"_5":16788,"_22829":39924,"_2311":39961},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2783":215,"_24069":201,"_16893":39963,"_5":16788,"_22829":39924,"_2311":39964},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2783":216,"_24069":201,"_16893":39966,"_5":16788,"_22829":39924,"_2311":39967},[],"a reachable RabbitMQ broker and credentials",{"_2783":217,"_24069":201,"_16893":39969,"_5":16788,"_22829":39924,"_2311":39970},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2783":218,"_24069":201,"_16893":39972,"_5":16788,"_22829":39924,"_2311":39973},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2783":219,"_24069":201,"_16893":39975,"_5":16788,"_22829":39924,"_2311":39976},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2783":220,"_24069":201,"_16893":39978,"_5":16788,"_22829":39924,"_2311":39979},[],"a StorageClass and an external traffic design",{"_2783":221,"_24069":201,"_16893":39981,"_5":16788,"_22829":39924,"_2311":39982},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2783":222,"_24069":201,"_16893":39984,"_5":16788,"_22829":39924,"_2311":39985},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2783":223,"_24069":201,"_16893":39987,"_5":16788,"_22829":39924,"_2311":39988},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2783":224,"_24069":201,"_16893":39990,"_5":16788,"_22829":39927,"_2311":39991},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2783":225,"_24069":201,"_16893":39993,"_5":16788,"_22829":39927,"_2311":39994},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2783":226,"_24069":201,"_16893":39996,"_5":16788,"_22829":39927,"_2311":39997},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2783":227,"_24069":201,"_16893":39999,"_5":16788,"_22829":39931,"_2311":40000},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2783":228,"_24069":201,"_16893":40002,"_5":16788,"_22829":39931,"_2311":40003},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2783":229,"_24069":201,"_16893":40005,"_5":16788,"_22829":39931,"_2311":40006},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2783":230,"_24069":201,"_16893":40008,"_5":16788,"_22829":39935,"_2311":40009},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2783":231,"_24069":201,"_16893":40011,"_5":16788,"_22829":39939,"_2311":40012},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2783":232,"_24069":201,"_16893":40014,"_5":16788,"_22829":39939,"_2311":40015},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2783":233,"_24069":201,"_16893":40017,"_5":16788,"_22829":39939,"_2311":40018},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2783":234,"_24069":201,"_16893":40020,"_5":16788,"_22829":39939,"_2311":40021},[],"See Access control for the principal and policy model.",{"_2783":235,"_24069":201,"_16893":40023,"_5":16788,"_22829":39943,"_2311":40024},[],"To install a local checkout instead:",{"_2783":236,"_24069":201,"_16893":40026,"_5":16788,"_22829":39947,"_2311":40027},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2783":237,"_24069":201,"_16893":40029,"_5":16788,"_22829":39947,"_2311":40030},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2783":238,"_24069":201,"_16893":40032,"_5":16788,"_22829":39951,"_2311":40033},[],"Before going live, review:",{"_2783":239,"_24069":201,"_16893":40035,"_5":16788,"_22829":39951,"_2311":40036},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2783":240,"_24069":201,"_16893":40038,"_5":16788,"_22829":39951,"_2311":40039},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2783":241,"_24069":201,"_16893":40041,"_5":16788,"_22829":39951,"_2311":40042},[],"shared VA storage before increasing VA replicas",{"_2783":242,"_24069":201,"_16893":40044,"_5":16788,"_22829":39951,"_2311":40045},[],"managed OIDC roles and removal of evaluation credentials",{"_2783":243,"_24069":201,"_16893":40047,"_5":16788,"_22829":39951,"_2311":40048},[],"a trusted TLS issuer or externally managed certificate",{"_2783":244,"_24069":201,"_16893":40050,"_5":16788,"_22829":39951,"_2311":40051},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2783":245,"_24069":201,"_16893":40053,"_5":16788,"_22829":39951,"_2311":40054},[],"SMTP, observability and alert delivery",{"_2783":246,"_24069":201,"_16893":40056,"_5":16788,"_22829":39951,"_2311":40057},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2783":247,"_24069":201,"_16893":40059,"_5":16788,"_22829":39951,"_2311":40060},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2783":248,"_24069":248,"_5":11891,"_2311":40062,"_24405":40063,"_16893":40064,"_22829":248},"Expose the Gateway",[39337,39338,39444],[],{"_2783":249,"_24069":248,"_16893":40066,"_5":16788,"_22829":248,"_2311":40067},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2783":250,"_24069":248,"_5":24402,"_16893":40069,"_22829":40070,"_2311":40071},[],"/docs/pr-preview/pr-27/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2783":251,"_24069":248,"_5":24402,"_16893":40073,"_22829":40074,"_2311":40075},[],"/docs/pr-preview/pr-27/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2783":252,"_24069":248,"_5":24402,"_16893":40077,"_22829":40078,"_2311":40079},[],"/docs/pr-preview/pr-27/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2783":253,"_24069":248,"_5":24402,"_16893":40081,"_22829":40082,"_2311":40083},[],"/docs/pr-preview/pr-27/deployment/self-hosted/networking#k3s","K3s",{"_2783":254,"_24069":248,"_5":24402,"_16893":40085,"_22829":40086,"_2311":40087},[],"/docs/pr-preview/pr-27/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2783":255,"_24069":248,"_5":24402,"_16893":40089,"_22829":40090,"_2311":40091},[],"/docs/pr-preview/pr-27/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2783":256,"_24069":248,"_5":24402,"_16893":40093,"_22829":40094,"_2311":40095},[],"/docs/pr-preview/pr-27/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2783":257,"_24069":248,"_5":24402,"_16893":40097,"_22829":40098,"_2311":40099},[],"/docs/pr-preview/pr-27/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2783":258,"_24069":248,"_5":24402,"_16893":40101,"_22829":40102,"_2311":40103},[],"/docs/pr-preview/pr-27/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2783":259,"_24069":248,"_16893":40105,"_5":16788,"_22829":40070,"_2311":40106},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2783":260,"_24069":248,"_16893":40108,"_5":16788,"_22829":40070,"_2311":40109},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2783":261,"_24069":248,"_16893":40111,"_5":16788,"_22829":40074,"_2311":40112},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2783":262,"_24069":248,"_16893":40114,"_5":16788,"_22829":40074,"_2311":40115},[],"Set it only when:",{"_2783":263,"_24069":248,"_16893":40117,"_5":16788,"_22829":40074,"_2311":40118},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2783":264,"_24069":248,"_16893":40120,"_5":16788,"_22829":40074,"_2311":40121},[],"that address is allocated to this Gateway",{"_2783":265,"_24069":248,"_16893":40123,"_5":16788,"_22829":40074,"_2311":40124},[],"the surrounding network already routes traffic for it to the cluster",{"_2783":266,"_24069":248,"_16893":40126,"_5":16788,"_22829":40074,"_2311":40127},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2783":267,"_24069":248,"_16893":40129,"_5":16788,"_22829":40074,"_2311":40130},[],"Keep these two settings separate:",{"_2783":268,"_24069":248,"_16893":40132,"_5":16788,"_22829":40074,"_2311":40133},[],"`gateway.addresses` requests an address for the Gateway.",{"_2783":269,"_24069":248,"_16893":40135,"_5":16788,"_22829":40074,"_2311":40136},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2783":270,"_24069":248,"_16893":40138,"_5":16788,"_22829":40074,"_2311":40139},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2783":271,"_24069":248,"_16893":40141,"_5":16788,"_22829":40078,"_2311":40142},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2783":272,"_24069":248,"_16893":40144,"_5":16788,"_22829":40078,"_2311":40145},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2783":273,"_24069":248,"_16893":40147,"_5":16788,"_22829":40082,"_2311":40148},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2783":274,"_24069":248,"_16893":40150,"_5":16788,"_22829":40082,"_2311":40151},[],"For the recommended design:",{"_2783":275,"_24069":248,"_16893":40153,"_5":16788,"_22829":40082,"_2311":40154},[],"Use only one externally exposed Lamassu Gateway.",{"_2783":276,"_24069":248,"_16893":40156,"_5":16788,"_22829":40082,"_2311":40157},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2783":277,"_24069":248,"_16893":40159,"_5":16788,"_22829":40082,"_2311":40160},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2783":278,"_24069":248,"_16893":40162,"_5":16788,"_22829":40082,"_2311":40163},[],"Point DNS at the VM's reachable address.",{"_2783":279,"_24069":248,"_16893":40165,"_5":16788,"_22829":40082,"_2311":40166},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2783":280,"_24069":248,"_16893":40168,"_5":16788,"_22829":40086,"_2311":40169},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2783":281,"_24069":248,"_16893":40171,"_5":16788,"_22829":40090,"_2311":40172},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2783":282,"_24069":248,"_16893":40174,"_5":16788,"_22829":40090,"_2311":40175},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2783":283,"_24069":248,"_16893":40177,"_5":16788,"_22829":40094,"_2311":40178},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2783":284,"_24069":248,"_16893":40180,"_5":16788,"_22829":40094,"_2311":40181},[],"Requirement",{"_2783":285,"_24069":248,"_16893":40183,"_5":16788,"_22829":40094,"_2311":40184},[],"Recommended design",{"_2783":286,"_24069":248,"_16893":40186,"_5":16788,"_22829":40094,"_2311":40187},[],"Consequence",{"_2783":287,"_24069":248,"_16893":40189,"_5":16788,"_22829":40094,"_2311":40190},[],"Several Lamassu URLs or services",{"_2783":288,"_24069":248,"_16893":40192,"_5":16788,"_22829":40094,"_2311":40193},[],"One Gateway with multiple routes",{"_2783":289,"_24069":248,"_16893":40195,"_5":16788,"_22829":40094,"_2311":40196},[],"One IP and one proxy fleet; this is the chart default",{"_2783":290,"_24069":248,"_16893":40198,"_5":16788,"_22829":40094,"_2311":40199},[],"Independent Gateways and separate external IPs",{"_2783":291,"_24069":248,"_16893":40201,"_5":16788,"_22829":40094,"_2311":40202},[],"One VIP per Gateway",{"_2783":292,"_24069":248,"_16893":40204,"_5":16788,"_22829":40094,"_2311":40205},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2783":293,"_24069":248,"_16893":40207,"_5":16788,"_22829":40094,"_2311":40208},[],"Independent Gateways on one node and one IP",{"_2783":294,"_24069":248,"_16893":40210,"_5":16788,"_22829":40094,"_2311":40211},[],"Use different external ports",{"_2783":295,"_24069":248,"_16893":40213,"_5":16788,"_22829":40094,"_2311":40214},[],"Clients must include non-standard ports",{"_2783":296,"_24069":248,"_16893":40216,"_5":16788,"_22829":40094,"_2311":40217},[],"Separate TLS/mTLS termination behind one IP",{"_2783":297,"_24069":248,"_16893":40219,"_5":16788,"_22829":40094,"_2311":40220},[],"Front-door SNI routing to internal Gateways",{"_2783":298,"_24069":248,"_16893":40222,"_5":16788,"_22829":40094,"_2311":40223},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2783":299,"_24069":248,"_16893":40225,"_5":16788,"_22829":40094,"_2311":40226},[],"Separate Gateway resources but shared proxy infrastructure",{"_2783":300,"_24069":248,"_16893":40228,"_5":16788,"_22829":40094,"_2311":40229},[],"Envoy merged-Gateway mode",{"_2783":301,"_24069":248,"_16893":40231,"_5":16788,"_22829":40094,"_2311":40232},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2783":302,"_24069":248,"_16893":40234,"_5":16788,"_22829":40094,"_2311":40235},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2783":303,"_24069":248,"_16893":40237,"_5":16788,"_22829":40094,"_2311":40238},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2783":304,"_24069":248,"_16893":40240,"_5":16788,"_22829":40094,"_2311":40241},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2783":305,"_24069":248,"_16893":40243,"_5":16788,"_22829":40094,"_2311":40244},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2783":306,"_24069":248,"_16893":40246,"_5":16788,"_22829":40098,"_2311":40247},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2783":307,"_24069":248,"_16893":40249,"_5":16788,"_22829":40098,"_2311":40250},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2783":308,"_24069":248,"_16893":40252,"_5":16788,"_22829":40098,"_2311":40253},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2783":309,"_24069":248,"_16893":40255,"_5":16788,"_22829":40098,"_2311":40256},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2783":310,"_24069":248,"_16893":40258,"_5":16788,"_22829":40098,"_2311":40259},[],"If none of those are possible, use different external ports or change the external network design.",{"_2783":311,"_24069":248,"_16893":40261,"_5":16788,"_22829":40102,"_2311":40262},[],"Check, in order:",{"_2783":312,"_24069":248,"_16893":40264,"_5":16788,"_22829":40102,"_2311":40265},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2783":313,"_24069":248,"_16893":40267,"_5":16788,"_22829":40102,"_2311":40268},[],"Its status contains the expected address.",{"_2783":314,"_24069":248,"_16893":40270,"_5":16788,"_22829":40102,"_2311":40271},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2783":315,"_24069":248,"_16893":40273,"_5":16788,"_22829":40102,"_2311":40274},[],"Port 443 reaches that address from the client network.",{"_2783":316,"_24069":248,"_16893":40276,"_5":16788,"_22829":40102,"_2311":40277},[],"DNS resolves to the externally reachable endpoint.",{"_2783":317,"_24069":248,"_16893":40279,"_5":16788,"_22829":40102,"_2311":40280},[],"The certificate contains the DNS name or IP used by the client.",{"_2783":318,"_24069":248,"_16893":40282,"_5":16788,"_22829":40102,"_2311":40283},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2783":319,"_24069":319,"_5":11891,"_2311":39444,"_24405":40285,"_16893":40286,"_22829":319},[39337,39338,39444],[],{"_2783":320,"_24069":319,"_16893":40288,"_5":16788,"_22829":319,"_2311":40289},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2783":321,"_24069":319,"_5":24402,"_16893":40291,"_22829":40292,"_2311":40293},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2783":322,"_24069":319,"_5":24402,"_16893":40295,"_22829":40296,"_2311":40297},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2783":323,"_24069":319,"_5":24402,"_16893":40299,"_22829":40300,"_2311":40301},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2783":324,"_24069":319,"_5":24402,"_16893":40303,"_22829":40304,"_2311":40305},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2783":325,"_24069":319,"_5":24402,"_16893":40307,"_22829":40308,"_2311":40309},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2783":326,"_24069":319,"_5":24402,"_16893":40311,"_22829":40312,"_2311":40313},[],"/docs/pr-preview/pr-27/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2783":327,"_24069":319,"_16893":40315,"_5":16788,"_22829":40292,"_2311":40316},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2783":328,"_24069":319,"_16893":40318,"_5":16788,"_22829":40296,"_2311":40319},[],"Workflow",{"_2783":329,"_24069":319,"_16893":40321,"_5":16788,"_22829":40296,"_2311":40322},[],"Use it for",{"_2783":330,"_24069":319,"_16893":40324,"_5":16788,"_22829":40296,"_2311":40325},[],"What it installs",{"_2783":331,"_24069":319,"_16893":40327,"_5":16788,"_22829":40296,"_2311":40328},[],"Helm",{"_2783":332,"_24069":319,"_16893":40330,"_5":16788,"_22829":40296,"_2311":40331},[],"Production and controlled environments",{"_2783":333,"_24069":319,"_16893":40333,"_5":16788,"_22829":40296,"_2311":40334},[],"Lamassu services and Gateway API resources",{"_2783":334,"_24069":319,"_16893":40336,"_5":16788,"_22829":40296,"_2311":39581},[],{"_2783":335,"_24069":319,"_16893":40338,"_5":16788,"_22829":40296,"_2311":40339},[],"Evaluation, demos, CI and small lab clusters",{"_2783":336,"_24069":319,"_16893":40341,"_5":16788,"_22829":40296,"_2311":40342},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2783":337,"_24069":319,"_16893":40344,"_5":16788,"_22829":40300,"_2311":40345},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2783":338,"_24069":319,"_16893":40347,"_5":16788,"_22829":40300,"_2311":40348},[],"Area",{"_2783":339,"_24069":319,"_16893":40350,"_5":16788,"_22829":40300,"_2311":40351},[],"The Lamassu chart provides",{"_2783":340,"_24069":319,"_16893":40353,"_5":16788,"_22829":40300,"_2311":40354},[],"You provide",{"_2783":341,"_24069":319,"_16893":40356,"_5":16788,"_22829":40300,"_2311":40357},[],"Lamassu applications",{"_2783":342,"_24069":319,"_16893":40359,"_5":16788,"_22829":40300,"_2311":40360},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2783":343,"_24069":319,"_16893":40362,"_5":16788,"_22829":40300,"_2311":40363},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2783":344,"_24069":319,"_16893":40365,"_5":16788,"_22829":40300,"_2311":40366},[],"PostgreSQL data",{"_2783":345,"_24069":319,"_16893":40368,"_5":16788,"_22829":40300,"_2311":40369},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2783":346,"_24069":319,"_16893":40371,"_5":16788,"_22829":40300,"_2311":40372},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2783":347,"_24069":319,"_16893":40374,"_5":16788,"_22829":40300,"_2311":40375},[],"Messaging",{"_2783":348,"_24069":319,"_16893":40377,"_5":16788,"_22829":40300,"_2311":40378},[],"RabbitMQ connection configuration for the Lamassu services",{"_2783":349,"_24069":319,"_16893":40380,"_5":16788,"_22829":40300,"_2311":40381},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2783":350,"_24069":319,"_16893":40383,"_5":16788,"_22829":40300,"_2311":40384},[],"Identity",{"_2783":351,"_24069":319,"_16893":40386,"_5":16788,"_22829":40300,"_2311":40387},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2783":352,"_24069":319,"_16893":40389,"_5":16788,"_22829":40300,"_2311":40390},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2783":353,"_24069":319,"_16893":40392,"_5":16788,"_22829":40300,"_2311":40393},[],"External routing",{"_2783":354,"_24069":319,"_16893":40395,"_5":16788,"_22829":40300,"_2311":40396},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2783":355,"_24069":319,"_16893":40398,"_5":16788,"_22829":40300,"_2311":40399},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2783":356,"_24069":319,"_16893":40401,"_5":16788,"_22829":40300,"_2311":40402},[],"TLS",{"_2783":357,"_24069":319,"_16893":40404,"_5":16788,"_22829":40300,"_2311":40405},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2783":358,"_24069":319,"_16893":40407,"_5":16788,"_22829":40300,"_2311":40408},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2783":359,"_24069":319,"_16893":40410,"_5":16788,"_22829":40300,"_2311":40411},[],"Persistent application data",{"_2783":360,"_24069":319,"_16893":40413,"_5":16788,"_22829":40300,"_2311":40414},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2783":361,"_24069":319,"_16893":40416,"_5":16788,"_22829":40300,"_2311":40417},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2783":362,"_24069":319,"_16893":40419,"_5":16788,"_22829":40300,"_2311":40420},[],"Optional integrations",{"_2783":363,"_24069":319,"_16893":40422,"_5":16788,"_22829":40300,"_2311":40423},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2783":364,"_24069":319,"_16893":40425,"_5":16788,"_22829":40300,"_2311":40426},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2783":365,"_24069":319,"_16893":40428,"_5":16788,"_22829":40300,"_2311":40429},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2783":366,"_24069":319,"_16893":40431,"_5":16788,"_22829":40300,"_2311":40432},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2783":367,"_24069":319,"_16893":40434,"_5":16788,"_22829":40304,"_2311":40435},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2783":368,"_24069":319,"_16893":40437,"_5":16788,"_22829":40304,"_2311":40438},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2783":369,"_24069":319,"_16893":40440,"_5":16788,"_22829":40308,"_2311":40441},[],"Kubernetes 1.24 or newer",{"_2783":370,"_24069":319,"_16893":40443,"_5":16788,"_22829":40308,"_2311":40444},[],"Helm 3.2 or newer",{"_2783":371,"_24069":319,"_16893":40446,"_5":16788,"_22829":40308,"_2311":40447},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2783":372,"_24069":319,"_16893":40449,"_5":16788,"_22829":40308,"_2311":40450},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2783":373,"_24069":319,"_16893":40452,"_5":16788,"_22829":40308,"_2311":40453},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2783":374,"_24069":319,"_16893":40455,"_5":16788,"_22829":40308,"_2311":40456},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2783":375,"_24069":319,"_16893":40458,"_5":16788,"_22829":40308,"_2311":40459},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2783":376,"_24069":319,"_16893":40461,"_5":16788,"_22829":40312,"_2311":40462},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2783":377,"_24069":319,"_16893":40464,"_5":16788,"_22829":40312,"_2311":40465},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2783":378,"_24069":319,"_16893":40467,"_5":16788,"_22829":40312,"_2311":40468},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2783":379,"_24069":379,"_5":11891,"_2311":40470,"_24405":40471,"_16893":40473,"_22829":379},"Deployment troubleshooting",[39337,39338,40472],"Operations",[],{"_2783":380,"_24069":379,"_16893":40475,"_5":16788,"_22829":379,"_2311":40476},[],"Diagnose access, service health and infrastructure dependencies.",{"_2783":381,"_24069":379,"_5":24402,"_16893":40478,"_22829":40479,"_2311":40480},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2783":382,"_24069":379,"_5":24402,"_16893":40482,"_22829":40483,"_2311":40484},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2783":383,"_24069":379,"_5":24402,"_16893":40486,"_22829":40487,"_2311":40488},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2783":384,"_24069":379,"_5":24402,"_16893":40490,"_22829":40491,"_2311":40492},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2783":385,"_24069":379,"_5":24402,"_16893":40494,"_22829":40495,"_2311":40496},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2783":386,"_24069":379,"_5":24402,"_16893":40498,"_22829":40499,"_2311":40500},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2783":387,"_24069":379,"_5":24402,"_16893":40502,"_22829":40503,"_2311":40504},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2783":388,"_24069":379,"_5":24402,"_16893":40506,"_22829":40507,"_2311":40508},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2783":389,"_24069":379,"_5":24402,"_16893":40510,"_22829":40511,"_2311":40512},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2783":390,"_24069":379,"_5":24402,"_16893":40514,"_22829":40515,"_2311":40516},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2783":391,"_24069":379,"_5":24402,"_16893":40518,"_22829":40519,"_2311":40520},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2783":392,"_24069":379,"_5":24402,"_16893":40522,"_22829":40523,"_2311":40524},[],"/docs/pr-preview/pr-27/deployment/troubleshooting#observability","Observability",{"_2783":393,"_24069":379,"_16893":40526,"_5":16788,"_22829":379,"_2311":40527},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2783":394,"_24069":379,"_16893":40529,"_5":16788,"_22829":40483,"_2311":40530},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2783":395,"_24069":379,"_16893":40532,"_5":16788,"_22829":40487,"_2311":40533},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2783":396,"_24069":379,"_16893":40535,"_5":16788,"_22829":40491,"_2311":40536},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2783":397,"_24069":379,"_16893":40538,"_5":16788,"_22829":40495,"_2311":40539},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2783":398,"_24069":379,"_16893":40541,"_5":16788,"_22829":40499,"_2311":40542},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2783":399,"_24069":379,"_16893":40544,"_5":16788,"_22829":40503,"_2311":40545},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2783":400,"_24069":379,"_16893":40547,"_5":16788,"_22829":40503,"_2311":40548},[],"Also run the chart's connectivity test:",{"_2783":401,"_24069":379,"_16893":40550,"_5":16788,"_22829":40503,"_2311":40551},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2783":402,"_24069":379,"_16893":40553,"_5":16788,"_22829":40503,"_2311":40554},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2783":403,"_24069":379,"_16893":40556,"_5":16788,"_22829":40507,"_2311":40557},[],"If you receive a 401:",{"_2783":404,"_24069":379,"_16893":40559,"_5":16788,"_22829":40507,"_2311":40560},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2783":405,"_24069":379,"_16893":40562,"_5":16788,"_22829":40507,"_2311":40563},[],"verify issuer, audience and expiration of the token;",{"_2783":406,"_24069":379,"_16893":40565,"_5":16788,"_22829":40507,"_2311":40566},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2783":407,"_24069":379,"_16893":40568,"_5":16788,"_22829":40507,"_2311":40569},[],"check that the provider's public and internal routes point to the same realm.",{"_2783":408,"_24069":379,"_16893":40571,"_5":16788,"_22829":40507,"_2311":40572},[],"If login succeeds but the APIs return 403:",{"_2783":409,"_24069":379,"_16893":40574,"_5":16788,"_22829":40507,"_2311":40575},[],"inspect the token's real claims;",{"_2783":410,"_24069":379,"_16893":40577,"_5":16788,"_22829":40507,"_2311":40578},[],"confirm they match an active principal;",{"_2783":411,"_24069":379,"_16893":40580,"_5":16788,"_22829":40507,"_2311":40581},[],"review the policies granted to that principal;",{"_2783":412,"_24069":379,"_16893":40583,"_5":16788,"_22829":40507,"_2311":40584},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2783":413,"_24069":379,"_16893":40586,"_5":16788,"_22829":40507,"_2311":40587},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2783":414,"_24069":379,"_16893":40589,"_5":16788,"_22829":40511,"_2311":40590},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2783":415,"_24069":379,"_16893":40592,"_5":16788,"_22829":40511,"_2311":40593},[],"Locate the authz pod and Service.",{"_2783":416,"_24069":379,"_16893":40595,"_5":16788,"_22829":40511,"_2311":40596},[],"Check /health, logs and its database connection.",{"_2783":417,"_24069":379,"_16893":40598,"_5":16788,"_22829":40511,"_2311":40599},[],"Verify the DNS and port configured in externalAuthorization.",{"_2783":418,"_24069":379,"_16893":40601,"_5":16788,"_22829":40511,"_2311":40602},[],"Check the check route is /v1/ext\\_authz/check.",{"_2783":419,"_24069":379,"_16893":40604,"_5":16788,"_22829":40511,"_2311":40605},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2783":420,"_24069":379,"_16893":40607,"_5":16788,"_22829":40515,"_2311":40608},[],"Review kubectl describe pod first. Common causes are:",{"_2783":421,"_24069":379,"_16893":40610,"_5":16788,"_22829":40515,"_2311":40611},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2783":422,"_24069":379,"_16893":40613,"_5":16788,"_22829":40515,"_2311":40614},[],"unbound persistent volume;",{"_2783":423,"_24069":379,"_16893":40616,"_5":16788,"_22829":40515,"_2311":40617},[],"inaccessible image or incorrect pull policy;",{"_2783":424,"_24069":379,"_16893":40619,"_5":16788,"_22829":40515,"_2311":40620},[],"invalid cryptographic engine configuration;",{"_2783":425,"_24069":379,"_16893":40622,"_5":16788,"_22829":40515,"_2311":40623},[],"CPU or memory limits set too low;",{"_2783":426,"_24069":379,"_16893":40625,"_5":16788,"_22829":40515,"_2311":40626},[],"an incomplete prior migration.",{"_2783":427,"_24069":379,"_16893":40628,"_5":16788,"_22829":40515,"_2311":40629},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2783":428,"_24069":379,"_16893":40631,"_5":16788,"_22829":40515,"_2311":40632},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2783":429,"_24069":379,"_16893":40634,"_5":16788,"_22829":40519,"_2311":40635},[],"Domain and audit events depend on the bus publisher:",{"_2783":430,"_24069":379,"_16893":40637,"_5":16788,"_22829":40519,"_2311":40638},[],"verify it is enabled in the emitting service;",{"_2783":431,"_24069":379,"_16893":40640,"_5":16788,"_22829":40519,"_2311":40641},[],"check AMQP connectivity and credentials;",{"_2783":432,"_24069":379,"_16893":40643,"_5":16788,"_22829":40519,"_2311":40644},[],"review exchange, routing key, queues and consumers;",{"_2783":433,"_24069":379,"_16893":40646,"_5":16788,"_22829":40519,"_2311":40647},[],"inspect dead-letter queues;",{"_2783":434,"_24069":379,"_16893":40649,"_5":16788,"_22829":40519,"_2311":40650},[],"alert on orphan durable queues and backlog growth.",{"_2783":435,"_24069":379,"_16893":40652,"_5":16788,"_22829":40519,"_2311":40653},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2783":436,"_24069":379,"_16893":40655,"_5":16788,"_22829":40523,"_2311":40656},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2783":437,"_24069":379,"_16893":40658,"_5":16788,"_22829":40523,"_2311":40659},[],"Before closing an incident, record:",{"_2783":438,"_24069":379,"_16893":40661,"_5":16788,"_22829":40523,"_2311":40662},[],"the confirmed cause;",{"_2783":439,"_24069":379,"_16893":40664,"_5":16788,"_22829":40523,"_2311":40665},[],"the time scope and affected resources;",{"_2783":440,"_24069":379,"_16893":40667,"_5":16788,"_22829":40523,"_2311":40668},[],"the commands or queries used;",{"_2783":441,"_24069":379,"_16893":40670,"_5":16788,"_22829":40523,"_2311":40671},[],"the applied change and how to revert it;",{"_2783":442,"_24069":379,"_16893":40673,"_5":16788,"_22829":40523,"_2311":40674},[],"validation from a consumer;",{"_2783":443,"_24069":379,"_16893":40676,"_5":16788,"_22829":40523,"_2311":40677},[],"the preventive action and its owner.",{"_2783":444,"_24069":444,"_5":11891,"_2311":40679,"_24405":40680,"_16893":40683,"_22829":444},"Access control",[39337,40681,40682],"Platform","Administration",[],{"_2783":445,"_24069":444,"_16893":40685,"_5":16788,"_22829":444,"_2311":40686},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2783":446,"_24069":444,"_5":24402,"_16893":40688,"_22829":40689,"_2311":40690},[],"/docs/pr-preview/pr-27/platform/administration/access-control#essential-concepts","Essential concepts",{"_2783":447,"_24069":444,"_5":24402,"_16893":40692,"_22829":40693,"_2311":40694},[],"/docs/pr-preview/pr-27/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2783":448,"_24069":444,"_5":24402,"_16893":40696,"_22829":40697,"_2311":40698},[],"/docs/pr-preview/pr-27/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2783":449,"_24069":444,"_5":24402,"_16893":40700,"_22829":40701,"_2311":40702},[],"/docs/pr-preview/pr-27/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2783":450,"_24069":444,"_5":24402,"_16893":40704,"_22829":40705,"_2311":40706},[],"/docs/pr-preview/pr-27/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2783":451,"_24069":444,"_5":24402,"_16893":40708,"_22829":40709,"_2311":40710},[],"/docs/pr-preview/pr-27/platform/administration/access-control#oidc-principals","OIDC principals",{"_2783":452,"_24069":444,"_5":24402,"_16893":40712,"_22829":40713,"_2311":40714},[],"/docs/pr-preview/pr-27/platform/administration/access-control#x509-principals","X.509 principals",{"_2783":453,"_24069":444,"_5":24402,"_16893":40716,"_22829":40717,"_2311":40718},[],"/docs/pr-preview/pr-27/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2783":454,"_24069":444,"_5":24402,"_16893":40720,"_22829":40721,"_2311":40722},[],"/docs/pr-preview/pr-27/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2783":455,"_24069":444,"_5":24402,"_16893":40724,"_22829":40725,"_2311":40726},[],"/docs/pr-preview/pr-27/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2783":456,"_24069":444,"_5":24402,"_16893":40728,"_22829":40729,"_2311":40730},[],"/docs/pr-preview/pr-27/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2783":457,"_24069":444,"_5":24402,"_16893":40732,"_22829":40733,"_2311":40734},[],"/docs/pr-preview/pr-27/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2783":458,"_24069":444,"_5":24402,"_16893":40736,"_22829":40737,"_2311":40738},[],"/docs/pr-preview/pr-27/platform/administration/access-control#http-rules","HTTP rules",{"_2783":459,"_24069":444,"_5":24402,"_16893":40740,"_22829":40741,"_2311":40742},[],"/docs/pr-preview/pr-27/platform/administration/access-control#included-policies","Included policies",{"_2783":460,"_24069":444,"_5":24402,"_16893":40744,"_22829":40745,"_2311":39940},[],"/docs/pr-preview/pr-27/platform/administration/access-control#provision-the-first-administrator",{"_2783":461,"_24069":444,"_5":24402,"_16893":40747,"_22829":40748,"_2311":40749},[],"/docs/pr-preview/pr-27/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2783":462,"_24069":444,"_5":24402,"_16893":40751,"_22829":40752,"_2311":40753},[],"/docs/pr-preview/pr-27/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2783":463,"_24069":444,"_5":24402,"_16893":40755,"_22829":40756,"_2311":40757},[],"/docs/pr-preview/pr-27/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2783":464,"_24069":444,"_5":24402,"_16893":40759,"_22829":40760,"_2311":40761},[],"/docs/pr-preview/pr-27/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2783":465,"_24069":444,"_5":24402,"_16893":40763,"_22829":40764,"_2311":40765},[],"/docs/pr-preview/pr-27/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2783":466,"_24069":444,"_5":24402,"_16893":40767,"_22829":40768,"_2311":40769},[],"/docs/pr-preview/pr-27/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2783":467,"_24069":444,"_5":24402,"_16893":40771,"_22829":40772,"_2311":40773},[],"/docs/pr-preview/pr-27/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2783":468,"_24069":444,"_5":24402,"_16893":40775,"_22829":40776,"_2311":40777},[],"/docs/pr-preview/pr-27/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2783":469,"_24069":444,"_5":24402,"_16893":40779,"_22829":40780,"_2311":40781},[],"/docs/pr-preview/pr-27/platform/administration/access-control#operational-checklist","Operational checklist",{"_2783":470,"_24069":444,"_5":24402,"_16893":40783,"_22829":40784,"_2311":40785},[],"/docs/pr-preview/pr-27/platform/administration/access-control#diagnostics","Diagnostics",{"_2783":471,"_24069":444,"_5":24402,"_16893":40787,"_22829":40788,"_2311":40789},[],"/docs/pr-preview/pr-27/platform/administration/access-control#the-response-is-401","The response is 401",{"_2783":472,"_24069":444,"_5":24402,"_16893":40791,"_22829":40792,"_2311":40793},[],"/docs/pr-preview/pr-27/platform/administration/access-control#the-response-is-403","The response is 403",{"_2783":473,"_24069":444,"_5":24402,"_16893":40795,"_22829":40796,"_2311":40797},[],"/docs/pr-preview/pr-27/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2783":474,"_24069":444,"_5":24402,"_16893":40799,"_22829":40800,"_2311":40801},[],"/docs/pr-preview/pr-27/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2783":475,"_24069":444,"_16893":40803,"_5":16788,"_22829":444,"_2311":40804},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2783":476,"_24069":444,"_16893":40806,"_5":16788,"_22829":444,"_2311":40807},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2783":477,"_24069":444,"_16893":40809,"_5":16788,"_22829":444,"_2311":40810},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2783":478,"_24069":444,"_16893":40812,"_5":16788,"_22829":40689,"_2311":40813},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2783":479,"_24069":444,"_16893":40815,"_5":16788,"_22829":40689,"_2311":40816},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2783":480,"_24069":444,"_16893":40818,"_5":16788,"_22829":40689,"_2311":40819},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2783":481,"_24069":444,"_16893":40821,"_5":16788,"_22829":40689,"_2311":40822},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2783":482,"_24069":444,"_16893":40824,"_5":16788,"_22829":40689,"_2311":40825},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2783":483,"_24069":444,"_16893":40827,"_5":16788,"_22829":40689,"_2311":40828},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and one of its policies must allow the requested operation.",{"_2783":484,"_24069":444,"_16893":40830,"_5":16788,"_22829":40693,"_2311":40831},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2783":485,"_24069":444,"_16893":40833,"_5":16788,"_22829":40693,"_2311":40834},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2783":486,"_24069":444,"_16893":40836,"_5":16788,"_22829":40697,"_2311":40837},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2783":487,"_24069":444,"_16893":40839,"_5":16788,"_22829":40697,"_2311":40840},[],"The decision is made **before forwarding the request to the service**:",{"_2783":488,"_24069":444,"_16893":40842,"_5":16788,"_22829":40697,"_2311":40843},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2783":489,"_24069":444,"_16893":40845,"_5":16788,"_22829":40697,"_2311":40846},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2783":490,"_24069":444,"_16893":40848,"_5":16788,"_22829":40697,"_2311":40849},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2783":491,"_24069":444,"_16893":40851,"_5":16788,"_22829":40697,"_2311":40852},[],"It separately loads the policies granted to each principal.",{"_2783":492,"_24069":444,"_16893":40854,"_5":16788,"_22829":40697,"_2311":40855},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2783":493,"_24069":444,"_16893":40857,"_5":16788,"_22829":40697,"_2311":40858},[],"`authz` looks for an HTTP rule granting that action.",{"_2783":494,"_24069":444,"_16893":40860,"_5":16788,"_22829":40697,"_2311":40861},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy.",{"_2783":495,"_24069":444,"_16893":40863,"_5":16788,"_22829":40697,"_2311":40864},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2783":496,"_24069":444,"_16893":40866,"_5":16788,"_22829":40697,"_2311":40867},[],"When it allows access, `authz` returns the selected principal in `x-current-user`. The Gateway can propagate that header to the service to preserve the identity context.",{"_2783":497,"_24069":444,"_16893":40869,"_5":16788,"_22829":40697,"_2311":40870},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, the schema must declare a constraint relating a request value to a normalized attribute of the principal.",{"_2783":498,"_24069":444,"_16893":40872,"_5":16788,"_22829":40701,"_2311":40873},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2783":499,"_24069":444,"_16893":40875,"_5":16788,"_22829":40701,"_2311":40876},[],"The decision is made with the domain operation context:",{"_2783":500,"_24069":444,"_16893":40878,"_5":16788,"_22829":40701,"_2311":40879},[],"The middleware extracts the credential and resolves the matching principals.",{"_2783":501,"_24069":444,"_16893":40881,"_5":16788,"_22829":40701,"_2311":40882},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2783":502,"_24069":444,"_16893":40884,"_5":16788,"_22829":40701,"_2311":40885},[],"`authz` gathers the entity rules of the granted policies.",{"_2783":503,"_24069":444,"_16893":40887,"_5":16788,"_22829":40701,"_2311":40888},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2783":504,"_24069":444,"_16893":40890,"_5":16788,"_22829":40701,"_2311":40891},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2783":505,"_24069":444,"_16893":40893,"_5":16788,"_22829":40701,"_2311":40894},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2783":506,"_24069":444,"_16893":40896,"_5":16788,"_22829":40701,"_2311":40897},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2783":507,"_24069":444,"_16893":40899,"_5":16788,"_22829":40701,"_2311":40900},[],"Actions fall into two groups:",{"_2783":508,"_24069":444,"_16893":40902,"_5":16788,"_22829":40701,"_2311":40903},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2783":509,"_24069":444,"_16893":40905,"_5":16788,"_22829":40701,"_2311":40906},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2783":510,"_24069":444,"_16893":40908,"_5":16788,"_22829":40701,"_2311":40909},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2783":511,"_24069":444,"_16893":40911,"_5":16788,"_22829":40705,"_2311":40912},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2783":512,"_24069":444,"_16893":40914,"_5":16788,"_22829":40705,"_2311":40915},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2783":513,"_24069":444,"_16893":40917,"_5":16788,"_22829":40705,"_2311":40918},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it. Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2783":514,"_24069":444,"_16893":40920,"_5":16788,"_22829":40709,"_2311":40921},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2783":515,"_24069":444,"_16893":40923,"_5":16788,"_22829":40709,"_2311":40924},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2783":516,"_24069":444,"_16893":40926,"_5":16788,"_22829":40709,"_2311":40927},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2783":517,"_24069":444,"_16893":40929,"_5":16788,"_22829":40709,"_2311":40930},[],"The implemented operators are:",{"_2783":518,"_24069":444,"_16893":40932,"_5":16788,"_22829":40709,"_2311":40933},[],"`equals`, for exact equality;",{"_2783":519,"_24069":444,"_16893":40935,"_5":16788,"_22829":40709,"_2311":40936},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2783":520,"_24069":444,"_16893":40938,"_5":16788,"_22829":40709,"_2311":40939},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2783":521,"_24069":444,"_16893":40941,"_5":16788,"_22829":40709,"_2311":40942},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2783":522,"_24069":444,"_16893":40944,"_5":16788,"_22829":40713,"_2311":40945},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2783":523,"_24069":444,"_16893":40947,"_5":16788,"_22829":40713,"_2311":40948},[],"The available modes are:",{"_2783":524,"_24069":444,"_16893":40950,"_5":16788,"_22829":40713,"_2311":40951},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2783":525,"_24069":444,"_16893":40953,"_5":16788,"_22829":40713,"_2311":40954},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2783":526,"_24069":444,"_16893":40956,"_5":16788,"_22829":40713,"_2311":40957},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2783":527,"_24069":444,"_16893":40959,"_5":16788,"_22829":40713,"_2311":40960},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2783":528,"_24069":444,"_16893":40962,"_5":16788,"_22829":40713,"_2311":40963},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2783":529,"_24069":444,"_16893":40965,"_5":16788,"_22829":40713,"_2311":40966},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2783":530,"_24069":444,"_16893":40968,"_5":16788,"_22829":40717,"_2311":40969},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2783":531,"_24069":444,"_16893":40971,"_5":16788,"_22829":40717,"_2311":40972},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2783":532,"_24069":444,"_16893":40974,"_5":16788,"_22829":40717,"_2311":40975},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2783":533,"_24069":444,"_16893":40977,"_5":16788,"_22829":40717,"_2311":40978},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2783":534,"_24069":444,"_16893":40980,"_5":16788,"_22829":40725,"_2311":40981},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2783":535,"_24069":444,"_16893":40983,"_5":16788,"_22829":40725,"_2311":40984},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2783":536,"_24069":444,"_16893":40986,"_5":16788,"_22829":40729,"_2311":40987},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2783":537,"_24069":444,"_16893":40989,"_5":16788,"_22829":40729,"_2311":40990},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2783":538,"_24069":444,"_16893":40992,"_5":16788,"_22829":40733,"_2311":40993},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2783":539,"_24069":444,"_16893":40995,"_5":16788,"_22829":40733,"_2311":40996},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2783":540,"_24069":444,"_16893":40998,"_5":16788,"_22829":40733,"_2311":40999},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2783":541,"_24069":444,"_16893":41001,"_5":16788,"_22829":40737,"_2311":41002},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2783":542,"_24069":444,"_16893":41004,"_5":16788,"_22829":40737,"_2311":41005},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2783":543,"_24069":444,"_16893":41007,"_5":16788,"_22829":40737,"_2311":41008},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2783":544,"_24069":444,"_16893":41010,"_5":16788,"_22829":40741,"_2311":41011},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2783":545,"_24069":444,"_16893":41013,"_5":16788,"_22829":40741,"_2311":41014},[],"full and read-only access to certificates and authorities;",{"_2783":546,"_24069":444,"_16893":41016,"_5":16788,"_22829":40741,"_2311":41017},[],"full and read-only access to the KMS;",{"_2783":547,"_24069":444,"_16893":41019,"_5":16788,"_22829":40741,"_2311":41020},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2783":548,"_24069":444,"_16893":41022,"_5":16788,"_22829":40741,"_2311":41023},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2783":549,"_24069":444,"_16893":41025,"_5":16788,"_22829":40741,"_2311":41026},[],"console access;",{"_2783":550,"_24069":444,"_16893":41028,"_5":16788,"_22829":40741,"_2311":41029},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2783":551,"_24069":444,"_16893":41031,"_5":16788,"_22829":40741,"_2311":41032},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2783":552,"_24069":444,"_16893":41034,"_5":16788,"_22829":40741,"_2311":41035},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2783":553,"_24069":444,"_16893":41037,"_5":16788,"_22829":40745,"_2311":41038},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2783":554,"_24069":444,"_16893":41040,"_5":16788,"_22829":40745,"_2311":41041},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2783":555,"_24069":444,"_16893":41043,"_5":16788,"_22829":40745,"_2311":41044},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2783":556,"_24069":444,"_16893":41046,"_5":16788,"_22829":40748,"_2311":41047},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2783":557,"_24069":444,"_16893":41049,"_5":16788,"_22829":40752,"_2311":41050},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2783":558,"_24069":444,"_16893":41052,"_5":16788,"_22829":40756,"_2311":41053},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2783":559,"_24069":444,"_16893":41055,"_5":16788,"_22829":40760,"_2311":41056},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2783":560,"_24069":444,"_16893":41058,"_5":16788,"_22829":40764,"_2311":41059},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2783":561,"_24069":444,"_16893":41061,"_5":16788,"_22829":40768,"_2311":41062},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2783":562,"_24069":444,"_16893":41064,"_5":16788,"_22829":40768,"_2311":41065},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2783":563,"_24069":444,"_16893":41067,"_5":16788,"_22829":40772,"_2311":41068},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2783":564,"_24069":444,"_16893":41070,"_5":16788,"_22829":40772,"_2311":41071},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2783":565,"_24069":444,"_16893":41073,"_5":16788,"_22829":40772,"_2311":41074},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2783":566,"_24069":444,"_16893":41076,"_5":16788,"_22829":40772,"_2311":41077},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2783":567,"_24069":444,"_16893":41079,"_5":16788,"_22829":40772,"_2311":41080},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2783":568,"_24069":444,"_16893":41082,"_5":16788,"_22829":40772,"_2311":41083},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2783":569,"_24069":444,"_16893":41085,"_5":16788,"_22829":40772,"_2311":41086},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2783":570,"_24069":444,"_16893":41088,"_5":16788,"_22829":40772,"_2311":41089},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2783":571,"_24069":444,"_16893":41091,"_5":16788,"_22829":40776,"_2311":41092},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2783":572,"_24069":444,"_16893":41094,"_5":16788,"_22829":40776,"_2311":41095},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2783":573,"_24069":444,"_16893":41097,"_5":16788,"_22829":40776,"_2311":41098},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2783":574,"_24069":444,"_16893":41100,"_5":16788,"_22829":40780,"_2311":41101},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2783":575,"_24069":444,"_16893":41103,"_5":16788,"_22829":40780,"_2311":41104},[],"Use groups or stable roles for people and independent identities for automations.",{"_2783":576,"_24069":444,"_16893":41106,"_5":16788,"_22829":40780,"_2311":41107},[],"Keep at least two recovery administrators and test their access periodically.",{"_2783":577,"_24069":444,"_16893":41109,"_5":16788,"_22829":40780,"_2311":41110},[],"Review active principals, their matches and their grants after IdP changes.",{"_2783":578,"_24069":444,"_16893":41112,"_5":16788,"_22829":40780,"_2311":41113},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2783":579,"_24069":444,"_16893":41115,"_5":16788,"_22829":40780,"_2311":41116},[],"Always test one allowed and one denied operation for each role.",{"_2783":580,"_24069":444,"_16893":41118,"_5":16788,"_22829":40780,"_2311":41119},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2783":581,"_24069":444,"_16893":41121,"_5":16788,"_22829":40788,"_2311":41122},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2783":582,"_24069":444,"_16893":41124,"_5":16788,"_22829":40792,"_2311":41125},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2783":583,"_24069":444,"_16893":41127,"_5":16788,"_22829":40792,"_2311":41128},[],"that an active principal of the correct type exists;",{"_2783":584,"_24069":444,"_16893":41130,"_5":16788,"_22829":40792,"_2311":41131},[],"that the claim paths and values match the real token exactly;",{"_2783":585,"_24069":444,"_16893":41133,"_5":16788,"_22829":40792,"_2311":41134},[],"that all of the principal's conditions hold;",{"_2783":586,"_24069":444,"_16893":41136,"_5":16788,"_22829":40792,"_2311":41137},[],"that the principal has the expected policy granted;",{"_2783":587,"_24069":444,"_16893":41139,"_5":16788,"_22829":40792,"_2311":41140},[],"that the policy includes the action and the requested resource type or route;",{"_2783":588,"_24069":444,"_16893":41142,"_5":16788,"_22829":40792,"_2311":41143},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2783":589,"_24069":444,"_16893":41145,"_5":16788,"_22829":40792,"_2311":41146},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure.",{"_2783":590,"_24069":444,"_16893":41148,"_5":16788,"_22829":40796,"_2311":41149},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2783":591,"_24069":444,"_16893":41151,"_5":16788,"_22829":40800,"_2311":41152},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2783":592,"_24069":444,"_16893":41154,"_5":16788,"_22829":40800,"_2311":41155},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2783":593,"_24069":593,"_5":11891,"_2311":41157,"_24405":41158,"_16893":41159,"_22829":593},"Alerts and subscriptions",[39337,40681,40682],[],{"_2783":594,"_24069":593,"_16893":41161,"_5":16788,"_22829":593,"_2311":41162},[],"Send PKI events to people and external systems.",{"_2783":595,"_24069":593,"_5":24402,"_16893":41164,"_22829":41165,"_2311":41166},[],"/docs/pr-preview/pr-27/platform/administration/alerts#how-it-works","How it works",{"_2783":596,"_24069":593,"_5":24402,"_16893":41168,"_22829":41169,"_2311":41170},[],"/docs/pr-preview/pr-27/platform/administration/alerts#available-channels","Available channels",{"_2783":597,"_24069":593,"_5":24402,"_16893":41172,"_22829":41173,"_2311":41174},[],"/docs/pr-preview/pr-27/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2783":598,"_24069":593,"_5":24402,"_16893":41176,"_22829":41177,"_2311":41178},[],"/docs/pr-preview/pr-27/platform/administration/alerts#choose-the-event","Choose the event",{"_2783":599,"_24069":593,"_5":24402,"_16893":41180,"_22829":41181,"_2311":41182},[],"/docs/pr-preview/pr-27/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2783":600,"_24069":593,"_5":24402,"_16893":41184,"_22829":41185,"_2311":41186},[],"/docs/pr-preview/pr-27/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2783":601,"_24069":593,"_5":24402,"_16893":41188,"_22829":41189,"_2311":41190},[],"/docs/pr-preview/pr-27/platform/administration/alerts#review-and-activate","Review and activate",{"_2783":602,"_24069":593,"_5":24402,"_16893":41192,"_22829":41193,"_2311":41194},[],"/docs/pr-preview/pr-27/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2783":603,"_24069":593,"_5":24402,"_16893":41196,"_22829":41197,"_2311":41198},[],"/docs/pr-preview/pr-27/platform/administration/alerts#event-families","Event families",{"_2783":604,"_24069":593,"_16893":41200,"_5":16788,"_22829":593,"_2311":41201},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2783":605,"_24069":593,"_16893":41203,"_5":16788,"_22829":41165,"_2311":41204},[],"A service publishes a domain event.",{"_2783":606,"_24069":593,"_16893":41206,"_5":16788,"_22829":41165,"_2311":41207},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2783":607,"_24069":593,"_16893":41209,"_5":16788,"_22829":41165,"_2311":41210},[],"Each subscription's filter decides whether it should be notified.",{"_2783":608,"_24069":593,"_16893":41212,"_5":16788,"_22829":41165,"_2311":41213},[],"Lamassu delivers the event to the configured channel.",{"_2783":609,"_24069":593,"_16893":41215,"_5":16788,"_22829":41165,"_2311":41216},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2783":610,"_24069":593,"_16893":41218,"_5":16788,"_22829":41169,"_2311":41219},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address.",{"_2783":611,"_24069":593,"_16893":41221,"_5":16788,"_22829":41169,"_2311":41222},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2783":612,"_24069":593,"_16893":41224,"_5":16788,"_22829":41169,"_2311":41225},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2783":613,"_24069":593,"_16893":41227,"_5":16788,"_22829":41177,"_2311":41228},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2783":614,"_24069":593,"_16893":41230,"_5":16788,"_22829":41181,"_2311":41231},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2783":615,"_24069":593,"_16893":41233,"_5":16788,"_22829":41185,"_2311":41234},[],"Add a filter if you don't want to receive every instance of the event.",{"_2783":616,"_24069":593,"_16893":41236,"_5":16788,"_22829":41185,"_2311":41237},[],"**None** notifies all instances of the event.",{"_2783":617,"_24069":593,"_16893":41239,"_5":16788,"_22829":41185,"_2311":41240},[],"**JSON Path** evaluates one or more specific fields.",{"_2783":618,"_24069":593,"_16893":41242,"_5":16788,"_22829":41185,"_2311":41243},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2783":619,"_24069":593,"_16893":41245,"_5":16788,"_22829":41185,"_2311":41246},[],"**JavaScript** lets you express custom logic.",{"_2783":620,"_24069":593,"_16893":41248,"_5":16788,"_22829":41185,"_2311":41249},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2783":621,"_24069":593,"_16893":41251,"_5":16788,"_22829":41189,"_2311":41252},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2783":622,"_24069":593,"_16893":41254,"_5":16788,"_22829":41193,"_2311":41255},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2783":623,"_24069":593,"_16893":41257,"_5":16788,"_22829":41197,"_2311":41258},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2783":624,"_24069":593,"_16893":41260,"_5":16788,"_22829":41197,"_2311":41261},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2783":625,"_24069":593,"_16893":41263,"_5":16788,"_22829":41197,"_2311":41264},[],"**Profiles:** `profile.create`, `profile.update` and `profile.delete`.",{"_2783":626,"_24069":593,"_16893":41266,"_5":16788,"_22829":41197,"_2311":41267},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2783":627,"_24069":593,"_16893":41269,"_5":16788,"_22829":41197,"_2311":41270},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2783":628,"_24069":593,"_16893":41272,"_5":16788,"_22829":41197,"_2311":41273},[],"**Validation:** `va.role.crl.create`.",{"_2783":629,"_24069":593,"_16893":41275,"_5":16788,"_22829":41197,"_2311":41276},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign.message` and `kms.delete`.",{"_2783":630,"_24069":593,"_16893":41278,"_5":16788,"_22829":41197,"_2311":41279},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2783":631,"_24069":631,"_5":11891,"_2311":41281,"_24405":41282,"_16893":41283,"_22829":631},"Audit logs",[39337,40681,40682],[],{"_2783":632,"_24069":631,"_16893":41285,"_5":16788,"_22829":631,"_2311":41286},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2783":633,"_24069":631,"_5":24402,"_16893":41288,"_22829":41289,"_2311":41290},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2783":634,"_24069":631,"_5":24402,"_16893":41292,"_22829":41293,"_2311":41294},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#coverage","Coverage",{"_2783":635,"_24069":631,"_5":24402,"_16893":41296,"_22829":41297,"_2311":41298},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2783":636,"_24069":631,"_5":24402,"_16893":41300,"_22829":41301,"_2311":41302},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2783":637,"_24069":631,"_5":24402,"_16893":41304,"_22829":41305,"_2311":41306},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2783":638,"_24069":631,"_5":24402,"_16893":41308,"_22829":41309,"_2311":41310},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2783":639,"_24069":631,"_5":24402,"_16893":41312,"_22829":41313,"_2311":41314},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2783":640,"_24069":631,"_5":24402,"_16893":41316,"_22829":41317,"_2311":41318},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2783":641,"_24069":631,"_5":24402,"_16893":41320,"_22829":41321,"_2311":41322},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2783":642,"_24069":631,"_5":24402,"_16893":41324,"_22829":41325,"_2311":41326},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2783":643,"_24069":631,"_5":24402,"_16893":41328,"_22829":41329,"_2311":41330},[],"/docs/pr-preview/pr-27/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2783":644,"_24069":631,"_16893":41332,"_5":16788,"_22829":631,"_2311":41333},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2783":645,"_24069":631,"_16893":41335,"_5":16788,"_22829":41289,"_2311":41336},[],"The audit body includes:",{"_2783":646,"_24069":631,"_16893":41338,"_5":16788,"_22829":41289,"_2311":41339},[],"input: data received by the operation;",{"_2783":647,"_24069":631,"_16893":41341,"_5":16788,"_22829":41289,"_2311":41342},[],"has\\_error: whether the service returned an error;",{"_2783":648,"_24069":631,"_16893":41344,"_5":16788,"_22829":41289,"_2311":41345},[],"output: produced result or error message;",{"_2783":649,"_24069":631,"_16893":41347,"_5":16788,"_22829":41289,"_2311":41348},[],"principals: identifiers of the principals that matched the request.",{"_2783":650,"_24069":631,"_16893":41350,"_5":16788,"_22829":41289,"_2311":41351},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2783":651,"_24069":631,"_16893":41353,"_5":16788,"_22829":41289,"_2311":41354},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2783":652,"_24069":631,"_16893":41356,"_5":16788,"_22829":41293,"_2311":41357},[],"The backend applies auditing to mutations of:",{"_2783":653,"_24069":631,"_16893":41359,"_5":16788,"_22829":41293,"_2311":41360},[],"authorities, certificates and issuance profiles;",{"_2783":654,"_24069":631,"_16893":41362,"_5":16788,"_22829":41293,"_2311":41363},[],"keys and KMS engines;",{"_2783":655,"_24069":631,"_16893":41365,"_5":16788,"_22829":41293,"_2311":41366},[],"devices and identities;",{"_2783":656,"_24069":631,"_16893":41368,"_5":16788,"_22829":41293,"_2311":41369},[],"DMSs and enrollment operations;",{"_2783":657,"_24069":631,"_16893":41371,"_5":16788,"_22829":41293,"_2311":41372},[],"validation functions and CRL;",{"_2783":658,"_24069":631,"_16893":41374,"_5":16788,"_22829":41293,"_2311":41375},[],"principals, policies and authorization grants.",{"_2783":659,"_24069":631,"_16893":41377,"_5":16788,"_22829":41293,"_2311":41378},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2783":660,"_24069":631,"_16893":41380,"_5":16788,"_22829":41297,"_2311":41381},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2783":661,"_24069":631,"_16893":41383,"_5":16788,"_22829":41297,"_2311":41384},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2783":662,"_24069":631,"_16893":41386,"_5":16788,"_22829":41297,"_2311":41387},[],"Design the consumer to:",{"_2783":663,"_24069":631,"_16893":41389,"_5":16788,"_22829":41297,"_2311":41390},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2783":664,"_24069":631,"_16893":41392,"_5":16788,"_22829":41297,"_2311":41393},[],"keep the complete CloudEvent unmodified;",{"_2783":665,"_24069":631,"_16893":41395,"_5":16788,"_22829":41297,"_2311":41396},[],"record the ingestion time and detect duplicates by ID;",{"_2783":666,"_24069":631,"_16893":41398,"_5":16788,"_22829":41297,"_2311":41399},[],"encrypt in transit and at rest;",{"_2783":667,"_24069":631,"_16893":41401,"_5":16788,"_22829":41297,"_2311":41402},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2783":668,"_24069":631,"_16893":41404,"_5":16788,"_22829":41297,"_2311":41405},[],"apply an explicit retention and legal hold policy;",{"_2783":669,"_24069":631,"_16893":41407,"_5":16788,"_22829":41297,"_2311":41408},[],"alert if it stops consuming or the pending queue grows.",{"_2783":670,"_24069":631,"_16893":41410,"_5":16788,"_22829":41301,"_2311":41411},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2783":671,"_24069":631,"_16893":41413,"_5":16788,"_22829":41301,"_2311":41414},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2783":672,"_24069":631,"_16893":41416,"_5":16788,"_22829":41309,"_2311":41417},[],"Start from the reported time and normalize every source to UTC.",{"_2783":673,"_24069":631,"_16893":41419,"_5":16788,"_22829":41313,"_2311":41420},[],"Filter by event type, service source and resource identifier.",{"_2783":674,"_24069":631,"_16893":41422,"_5":16788,"_22829":41317,"_2311":41423},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2783":675,"_24069":631,"_16893":41425,"_5":16788,"_22829":41321,"_2311":41426},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2783":676,"_24069":631,"_16893":41428,"_5":16788,"_22829":41325,"_2311":41429},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2783":677,"_24069":631,"_16893":41431,"_5":16788,"_22829":41329,"_2311":41432},[],"Generate a controlled mutation in a test environment and check that:",{"_2783":678,"_24069":631,"_16893":41434,"_5":16788,"_22829":41329,"_2311":41435},[],"a successful audit event appears;",{"_2783":679,"_24069":631,"_16893":41437,"_5":16788,"_22829":41329,"_2311":41438},[],"the principal matches the identity used;",{"_2783":680,"_24069":631,"_16893":41440,"_5":16788,"_22829":41329,"_2311":41441},[],"the consumer persists it exactly once;",{"_2783":681,"_24069":631,"_16893":41443,"_5":16788,"_22829":41329,"_2311":41444},[],"it can be retrieved by resource, actor and period;",{"_2783":682,"_24069":631,"_16893":41446,"_5":16788,"_22829":41329,"_2311":41447},[],"a consumer outage raises an alert.",{"_2783":683,"_24069":631,"_16893":41449,"_5":16788,"_22829":41329,"_2311":41450},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2783":684,"_24069":684,"_5":11891,"_2311":41452,"_24405":41453,"_16893":41454,"_22829":684},"Platform architecture",[39337,40681],[],{"_2783":685,"_24069":684,"_16893":41456,"_5":16788,"_22829":684,"_2311":41457},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2783":686,"_24069":684,"_5":24402,"_16893":41459,"_22829":41460,"_2311":41461},[],"/docs/pr-preview/pr-27/platform/concepts/architecture#control-plane","Control plane",{"_2783":687,"_24069":684,"_5":24402,"_16893":41463,"_22829":41464,"_2311":41465},[],"/docs/pr-preview/pr-27/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2783":688,"_24069":684,"_5":24402,"_16893":41467,"_22829":41468,"_2311":41469},[],"/docs/pr-preview/pr-27/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2783":689,"_24069":684,"_5":24402,"_16893":41471,"_22829":41472,"_2311":41473},[],"/docs/pr-preview/pr-27/platform/concepts/architecture#status-and-validation","Status and validation",{"_2783":690,"_24069":684,"_5":24402,"_16893":41475,"_22829":41476,"_2311":41477},[],"/docs/pr-preview/pr-27/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2783":691,"_24069":684,"_16893":41479,"_5":16788,"_22829":684,"_2311":41480},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2783":692,"_24069":684,"_16893":41482,"_5":16788,"_22829":684,"_2311":41483},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2783":693,"_24069":684,"_16893":41485,"_5":16788,"_22829":41460,"_2311":41486},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2783":694,"_24069":684,"_16893":41488,"_5":16788,"_22829":41464,"_2311":41489},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2783":695,"_24069":684,"_16893":41491,"_5":16788,"_22829":41468,"_2311":41492},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2783":696,"_24069":684,"_16893":41494,"_5":16788,"_22829":41472,"_2311":41495},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2783":697,"_24069":684,"_16893":41497,"_5":16788,"_22829":41476,"_2311":41498},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2783":698,"_24069":698,"_5":11891,"_2311":41500,"_24405":41501,"_16893":41502,"_22829":698},"How Lamassu works",[39337,40681],[],{"_2783":699,"_24069":698,"_16893":41504,"_5":16788,"_22829":698,"_2311":41505},[],"The mental model of trust, keys, certificates and devices.",{"_2783":700,"_24069":698,"_5":24402,"_16893":41507,"_22829":41508,"_2311":41509},[],"/docs/pr-preview/pr-27/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2783":701,"_24069":698,"_5":24402,"_16893":41511,"_22829":41512,"_2311":41513},[],"/docs/pr-preview/pr-27/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2783":702,"_24069":698,"_16893":41515,"_5":16788,"_22829":698,"_2311":41516},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2783":703,"_24069":698,"_16893":41518,"_5":16788,"_22829":41508,"_2311":41519},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2783":704,"_24069":698,"_16893":41521,"_5":16788,"_22829":41508,"_2311":41522},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2783":705,"_24069":698,"_16893":41524,"_5":16788,"_22829":41508,"_2311":41525},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2783":706,"_24069":698,"_16893":41527,"_5":16788,"_22829":41508,"_2311":41528},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2783":707,"_24069":698,"_16893":41530,"_5":16788,"_22829":41508,"_2311":41531},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2783":708,"_24069":698,"_16893":41533,"_5":16788,"_22829":41512,"_2311":41534},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2783":709,"_24069":698,"_16893":41536,"_5":16788,"_22829":41512,"_2311":41537},[],"A DMS relates that CA to an enrollment policy.",{"_2783":710,"_24069":698,"_16893":41539,"_5":16788,"_22829":41512,"_2311":41540},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2783":711,"_24069":698,"_16893":41542,"_5":16788,"_22829":41512,"_2311":41543},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2783":712,"_24069":698,"_16893":41545,"_5":16788,"_22829":41512,"_2311":41546},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2783":713,"_24069":698,"_16893":41548,"_5":16788,"_22829":41512,"_2311":41549},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2783":714,"_24069":698,"_16893":41551,"_5":16788,"_22829":41512,"_2311":41552},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2783":715,"_24069":715,"_5":11891,"_2311":41554,"_24405":41555,"_16893":41557,"_22829":715},"Devices and identities",[39337,40681,41556,41554],"IoT Fleets",[],{"_2783":716,"_24069":715,"_16893":41559,"_5":16788,"_22829":715,"_2311":41560},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2783":717,"_24069":715,"_5":24402,"_16893":41562,"_22829":41563,"_2311":41564},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#device-states","Device states",{"_2783":718,"_24069":715,"_5":24402,"_16893":41566,"_22829":41567,"_2311":41568},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2783":719,"_24069":715,"_5":24402,"_16893":41570,"_22829":41571,"_2311":41572},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2783":720,"_24069":715,"_5":24402,"_16893":41574,"_22829":41575,"_2311":41576},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2783":721,"_24069":715,"_5":24402,"_16893":41578,"_22829":41579,"_2311":41580},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2783":722,"_24069":715,"_5":24402,"_16893":41582,"_22829":41583,"_2311":41584},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2783":723,"_24069":715,"_5":24402,"_16893":41586,"_22829":41587,"_2311":41588},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2783":724,"_24069":715,"_5":24402,"_16893":41590,"_22829":41591,"_2311":41592},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2783":725,"_24069":715,"_5":24402,"_16893":41594,"_22829":41595,"_2311":41596},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2783":726,"_24069":715,"_5":24402,"_16893":41598,"_22829":41599,"_2311":41600},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2783":727,"_24069":715,"_5":24402,"_16893":41602,"_22829":41603,"_2311":41604},[],"/docs/pr-preview/pr-27/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2783":728,"_24069":715,"_16893":41606,"_5":16788,"_22829":715,"_2311":41607},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2783":729,"_24069":715,"_16893":41609,"_5":16788,"_22829":715,"_2311":41610},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2783":730,"_24069":715,"_16893":41612,"_5":16788,"_22829":41563,"_2311":41613},[],"Operational view",{"_2783":731,"_24069":715,"_16893":41615,"_5":16788,"_22829":41563,"_2311":41616},[],"Meaning",{"_2783":732,"_24069":715,"_16893":41618,"_5":16788,"_22829":41563,"_2311":41619},[],"**No Identity**",{"_2783":733,"_24069":715,"_16893":41621,"_5":16788,"_22829":41563,"_2311":41622},[],"A record exists without an associated identity.",{"_2783":734,"_24069":715,"_16893":41624,"_5":16788,"_22829":41563,"_2311":41625},[],"**Active**",{"_2783":735,"_24069":715,"_16893":41627,"_5":16788,"_22829":41563,"_2311":41628},[],"The slot is active; also check certificate dates, status and usages.",{"_2783":736,"_24069":715,"_16893":41630,"_5":16788,"_22829":41563,"_2311":41631},[],"**Renewal Pending**",{"_2783":737,"_24069":715,"_16893":41633,"_5":16788,"_22829":41563,"_2311":41634},[],"The identity is in the operational renewal window.",{"_2783":738,"_24069":715,"_16893":41636,"_5":16788,"_22829":41563,"_2311":41637},[],"**Expiring Soon**",{"_2783":739,"_24069":715,"_16893":41639,"_5":16788,"_22829":41563,"_2311":41640},[],"Expiration is approaching according to configured thresholds.",{"_2783":740,"_24069":715,"_16893":41642,"_5":16788,"_22829":41563,"_2311":41643},[],"**Expired**",{"_2783":741,"_24069":715,"_16893":41645,"_5":16788,"_22829":41563,"_2311":41646},[],"The identity has expired.",{"_2783":742,"_24069":715,"_16893":41648,"_5":16788,"_22829":41563,"_2311":41649},[],"**Revoked**",{"_2783":743,"_24069":715,"_16893":41651,"_5":16788,"_22829":41563,"_2311":41652},[],"The identity is marked revoked.",{"_2783":744,"_24069":715,"_16893":41654,"_5":16788,"_22829":41563,"_2311":41655},[],"**Decommissioned**",{"_2783":745,"_24069":715,"_16893":41657,"_5":16788,"_22829":41563,"_2311":41658},[],"The record is retired and ordinary updates do not restore operation.",{"_2783":746,"_24069":715,"_16893":41660,"_5":16788,"_22829":41563,"_2311":41661},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2783":747,"_24069":715,"_16893":41663,"_5":16788,"_22829":41567,"_2311":41664},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2783":748,"_24069":715,"_16893":41666,"_5":16788,"_22829":41567,"_2311":41667},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2783":749,"_24069":715,"_16893":41669,"_5":16788,"_22829":41567,"_2311":41670},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2783":750,"_24069":715,"_16893":41672,"_5":16788,"_22829":41567,"_2311":41673},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2783":751,"_24069":715,"_16893":41675,"_5":16788,"_22829":41571,"_2311":41676},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2783":752,"_24069":715,"_16893":41678,"_5":16788,"_22829":41575,"_2311":41679},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2783":753,"_24069":715,"_16893":41681,"_5":16788,"_22829":41579,"_2311":41682},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2783":754,"_24069":715,"_16893":41684,"_5":16788,"_22829":41583,"_2311":41685},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2783":755,"_24069":715,"_16893":41687,"_5":16788,"_22829":41587,"_2311":41688},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2783":756,"_24069":715,"_16893":41690,"_5":16788,"_22829":41587,"_2311":41691},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2783":757,"_24069":715,"_16893":41693,"_5":16788,"_22829":41591,"_2311":41694},[],"From **No Identity**, use **Assign Identity**:",{"_2783":758,"_24069":715,"_16893":41696,"_5":16788,"_22829":41591,"_2311":41697},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2783":759,"_24069":715,"_16893":41699,"_5":16788,"_22829":41591,"_2311":41700},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2783":760,"_24069":715,"_16893":41702,"_5":16788,"_22829":41591,"_2311":41703},[],"Confirm and read the serial, active version and history again.",{"_2783":761,"_24069":715,"_16893":41705,"_5":16788,"_22829":41591,"_2311":41706},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2783":762,"_24069":715,"_16893":41708,"_5":16788,"_22829":41591,"_2311":41709},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2783":763,"_24069":715,"_16893":41711,"_5":16788,"_22829":41595,"_2311":41712},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2783":764,"_24069":715,"_16893":41714,"_5":16788,"_22829":41595,"_2311":41715},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2783":765,"_24069":715,"_16893":41717,"_5":16788,"_22829":41599,"_2311":41718},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2783":766,"_24069":715,"_16893":41720,"_5":16788,"_22829":41599,"_2311":41721},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2783":767,"_24069":715,"_16893":41723,"_5":16788,"_22829":41599,"_2311":41724},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2783":768,"_24069":715,"_16893":41726,"_5":16788,"_22829":41599,"_2311":41727},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2783":769,"_24069":715,"_16893":41729,"_5":16788,"_22829":41603,"_2311":41730},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2783":770,"_24069":715,"_16893":41732,"_5":16788,"_22829":41603,"_2311":41733},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2783":771,"_24069":771,"_5":11891,"_2311":41735,"_24405":41736,"_16893":41738,"_22829":771},"Bootstrap identity and authentication",[39337,40681,41556,41554,41737],"Enrollment with PKI",[],{"_2783":772,"_24069":771,"_16893":41740,"_5":16788,"_22829":771,"_2311":41741},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2783":773,"_24069":771,"_5":24402,"_16893":41743,"_22829":41744,"_2311":41745},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2783":774,"_24069":771,"_5":24402,"_16893":41747,"_22829":41748,"_2311":41749},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2783":775,"_24069":771,"_5":24402,"_16893":41751,"_22829":41752,"_2311":41753},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2783":776,"_24069":771,"_5":24402,"_16893":41755,"_22829":41756,"_2311":41757},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2783":777,"_24069":771,"_5":24402,"_16893":41759,"_22829":41760,"_2311":41761},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2783":778,"_24069":771,"_16893":41763,"_5":16788,"_22829":771,"_2311":41764},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2783":779,"_24069":771,"_16893":41766,"_5":16788,"_22829":41744,"_2311":41767},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2783":780,"_24069":771,"_16893":41769,"_5":16788,"_22829":41744,"_2311":41770},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2783":781,"_24069":771,"_16893":41772,"_5":16788,"_22829":41748,"_2311":41773},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2783":782,"_24069":771,"_16893":41775,"_5":16788,"_22829":41748,"_2311":41776},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2783":783,"_24069":771,"_16893":41778,"_5":16788,"_22829":41748,"_2311":41779},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2783":784,"_24069":771,"_16893":41781,"_5":16788,"_22829":41752,"_2311":41782},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2783":785,"_24069":771,"_16893":41784,"_5":16788,"_22829":41752,"_2311":41785},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2783":786,"_24069":771,"_16893":41787,"_5":16788,"_22829":41756,"_2311":41788},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout.",{"_2783":787,"_24069":771,"_16893":41790,"_5":16788,"_22829":41756,"_2311":41791},[],"Example body:",{"_2783":788,"_24069":771,"_16893":41793,"_5":16788,"_22829":41756,"_2311":41794},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2783":789,"_24069":771,"_16893":41796,"_5":16788,"_22829":41756,"_2311":41797},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2783":790,"_24069":771,"_16893":41799,"_5":16788,"_22829":41756,"_2311":41800},[],"Continuation requires a successful HTTP response and JSON:",{"_2783":791,"_24069":771,"_16893":41802,"_5":16788,"_22829":41756,"_2311":41803},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2783":792,"_24069":771,"_16893":41805,"_5":16788,"_22829":41760,"_2311":41806},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2783":793,"_24069":771,"_16893":41808,"_5":16788,"_22829":41760,"_2311":41809},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2783":794,"_24069":794,"_5":11891,"_2311":41811,"_24405":41812,"_16893":41813,"_22829":794},"Configure and operate the DMS",[39337,40681,41556,41554,41737],[],{"_2783":795,"_24069":794,"_16893":41815,"_5":16788,"_22829":794,"_2311":41816},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2783":796,"_24069":794,"_5":24402,"_16893":41818,"_22829":41819,"_2311":39347},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2783":797,"_24069":794,"_5":24402,"_16893":41821,"_22829":41822,"_2311":41823},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2783":798,"_24069":794,"_5":24402,"_16893":41825,"_22829":41826,"_2311":41827},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2783":799,"_24069":794,"_5":24402,"_16893":41829,"_22829":41830,"_2311":41831},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2783":800,"_24069":794,"_5":24402,"_16893":41833,"_22829":41834,"_2311":41835},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2783":801,"_24069":794,"_5":24402,"_16893":41837,"_22829":41838,"_2311":41839},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2783":802,"_24069":794,"_5":24402,"_16893":41841,"_22829":41842,"_2311":41843},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2783":803,"_24069":794,"_5":24402,"_16893":41845,"_22829":41846,"_2311":41847},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2783":804,"_24069":794,"_5":24402,"_16893":41849,"_22829":41850,"_2311":41851},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2783":805,"_24069":794,"_5":24402,"_16893":41853,"_22829":41854,"_2311":41855},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2783":806,"_24069":794,"_5":24402,"_16893":41857,"_22829":41858,"_2311":41859},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2783":807,"_24069":794,"_5":24402,"_16893":41861,"_22829":41862,"_2311":41863},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2783":808,"_24069":794,"_5":24402,"_16893":41865,"_22829":41866,"_2311":41867},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2783":809,"_24069":794,"_5":24402,"_16893":41869,"_22829":41870,"_2311":41871},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2783":810,"_24069":794,"_5":24402,"_16893":41873,"_22829":41874,"_2311":41875},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2783":811,"_24069":794,"_5":24402,"_16893":41877,"_22829":41878,"_2311":41879},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2783":812,"_24069":794,"_5":24402,"_16893":41881,"_22829":41882,"_2311":41883},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2783":813,"_24069":794,"_16893":41885,"_5":16788,"_22829":794,"_2311":41886},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2783":814,"_24069":794,"_16893":41888,"_5":16788,"_22829":41819,"_2311":41889},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2783":815,"_24069":794,"_16893":41891,"_5":16788,"_22829":41819,"_2311":41892},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2783":816,"_24069":794,"_16893":41894,"_5":16788,"_22829":41826,"_2311":41895},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2783":817,"_24069":794,"_16893":41897,"_5":16788,"_22829":41830,"_2311":41898},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2783":818,"_24069":794,"_16893":41900,"_5":16788,"_22829":41834,"_2311":41901},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2783":819,"_24069":794,"_16893":41903,"_5":16788,"_22829":41838,"_2311":41904},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2783":820,"_24069":794,"_16893":41906,"_5":16788,"_22829":41842,"_2311":41907},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2783":821,"_24069":794,"_16893":41909,"_5":16788,"_22829":41850,"_2311":41910},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2783":822,"_24069":794,"_16893":41912,"_5":16788,"_22829":41850,"_2311":41913},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2783":823,"_24069":794,"_16893":41915,"_5":16788,"_22829":41854,"_2311":41916},[],"`settings.enrollment_settings` field",{"_2783":824,"_24069":794,"_16893":41918,"_5":16788,"_22829":41854,"_2311":41919},[],"Decision",{"_2783":825,"_24069":794,"_16893":41921,"_5":16788,"_22829":41854,"_2311":41922},[],"`protocol`",{"_2783":826,"_24069":794,"_16893":41924,"_5":16788,"_22829":41854,"_2311":41925},[],"`EST_RFC7030` for these operations.",{"_2783":827,"_24069":794,"_16893":41927,"_5":16788,"_22829":41854,"_2311":41928},[],"`enrollment_ca`",{"_2783":828,"_24069":794,"_16893":41930,"_5":16788,"_22829":41854,"_2311":41931},[],"ID of the signing CA.",{"_2783":829,"_24069":794,"_16893":41933,"_5":16788,"_22829":41854,"_2311":41934},[],"`verify_csr_signature`",{"_2783":830,"_24069":794,"_16893":41936,"_5":16788,"_22829":41854,"_2311":41937},[],"Keep `true` to verify CSR key possession.",{"_2783":831,"_24069":794,"_16893":41939,"_5":16788,"_22829":41854,"_2311":41940},[],"`enable_replaceable_enrollment`",{"_2783":832,"_24069":794,"_16893":41942,"_5":16788,"_22829":41854,"_2311":41943},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2783":833,"_24069":794,"_16893":41945,"_5":16788,"_22829":41854,"_2311":41946},[],"`est_rfc7030_settings.auth_mode`",{"_2783":834,"_24069":794,"_16893":41948,"_5":16788,"_22829":41854,"_2311":41949},[],"One of the four authentication modes.",{"_2783":835,"_24069":794,"_16893":41951,"_5":16788,"_22829":41854,"_2311":41952},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2783":836,"_24069":794,"_16893":41954,"_5":16788,"_22829":41858,"_2311":41955},[],"The blocks are independent:",{"_2783":837,"_24069":794,"_16893":41957,"_5":16788,"_22829":41858,"_2311":41958},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2783":838,"_24069":794,"_16893":41960,"_5":16788,"_22829":41858,"_2311":41961},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2783":839,"_24069":794,"_16893":41963,"_5":16788,"_22829":41858,"_2311":41964},[],"`auth_mode`",{"_2783":840,"_24069":794,"_16893":41966,"_5":16788,"_22829":41858,"_2311":41967},[],"Control applied in the configured operation",{"_2783":841,"_24069":794,"_16893":41969,"_5":16788,"_22829":41858,"_2311":41970},[],"`CLIENT_CERTIFICATE`",{"_2783":842,"_24069":794,"_16893":41972,"_5":16788,"_22829":41858,"_2311":41973},[],"Presented certificate validation.",{"_2783":843,"_24069":794,"_16893":41975,"_5":16788,"_22829":41858,"_2311":41976},[],"`EXTERNAL_WEBHOOK`",{"_2783":844,"_24069":794,"_16893":41978,"_5":16788,"_22829":41858,"_2311":41979},[],"Configured webhook authorization.",{"_2783":845,"_24069":794,"_16893":41981,"_5":16788,"_22829":41858,"_2311":41982},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2783":846,"_24069":794,"_16893":41984,"_5":16788,"_22829":41858,"_2311":41985},[],"Certificate validation followed by webhook approval.",{"_2783":847,"_24069":794,"_16893":41987,"_5":16788,"_22829":41858,"_2311":41988},[],"`NO_AUTH`",{"_2783":848,"_24069":794,"_16893":41990,"_5":16788,"_22829":41858,"_2311":41991},[],"No DMS requester authentication.",{"_2783":849,"_24069":794,"_16893":41993,"_5":16788,"_22829":41858,"_2311":41994},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2783":850,"_24069":794,"_16893":41996,"_5":16788,"_22829":41858,"_2311":41997},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2783":851,"_24069":794,"_16893":41999,"_5":16788,"_22829":41858,"_2311":42000},[],"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers.",{"_2783":852,"_24069":794,"_16893":42002,"_5":16788,"_22829":41858,"_2311":42003},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2783":853,"_24069":794,"_16893":42005,"_5":16788,"_22829":41858,"_2311":42006},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2783":854,"_24069":794,"_16893":42008,"_5":16788,"_22829":41862,"_2311":42009},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2783":855,"_24069":794,"_16893":42011,"_5":16788,"_22829":41866,"_2311":42012},[],"`settings.reenrollment_settings` field",{"_2783":856,"_24069":794,"_16893":42014,"_5":16788,"_22829":41866,"_2311":39720},[],{"_2783":857,"_24069":794,"_16893":42016,"_5":16788,"_22829":41866,"_2311":42017},[],"`reenrollment_delta`",{"_2783":858,"_24069":794,"_16893":42019,"_5":16788,"_22829":41866,"_2311":42020},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2783":859,"_24069":794,"_16893":42022,"_5":16788,"_22829":41866,"_2311":42023},[],"`preventive_delta`",{"_2783":860,"_24069":794,"_16893":42025,"_5":16788,"_22829":41866,"_2311":42026},[],"Preventive operational monitoring threshold.",{"_2783":861,"_24069":794,"_16893":42028,"_5":16788,"_22829":41866,"_2311":42029},[],"`critical_delta`",{"_2783":862,"_24069":794,"_16893":42031,"_5":16788,"_22829":41866,"_2311":42032},[],"Critical operational monitoring threshold.",{"_2783":863,"_24069":794,"_16893":42034,"_5":16788,"_22829":41866,"_2311":42035},[],"`enable_expired_renewal`",{"_2783":864,"_24069":794,"_16893":42037,"_5":16788,"_22829":41866,"_2311":42038},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2783":865,"_24069":794,"_16893":42040,"_5":16788,"_22829":41866,"_2311":42041},[],"`additional_validation_cas`",{"_2783":866,"_24069":794,"_16893":42043,"_5":16788,"_22829":41866,"_2311":42044},[],"Additional mTLS credential issuers during migration.",{"_2783":867,"_24069":794,"_16893":42046,"_5":16788,"_22829":41866,"_2311":42047},[],"`revoke_on_reenrollment`",{"_2783":868,"_24069":794,"_16893":42049,"_5":16788,"_22829":41866,"_2311":42050},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2783":869,"_24069":794,"_16893":42052,"_5":16788,"_22829":41866,"_2311":42053},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2783":870,"_24069":794,"_16893":42055,"_5":16788,"_22829":41870,"_2311":42056},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2783":871,"_24069":794,"_16893":42058,"_5":16788,"_22829":41874,"_2311":39714},[],{"_2783":872,"_24069":794,"_16893":42060,"_5":16788,"_22829":41874,"_2311":42061},[],"Published material",{"_2783":873,"_24069":794,"_16893":42063,"_5":16788,"_22829":41874,"_2311":42064},[],"**Include Lamassu System CA**",{"_2783":874,"_24069":794,"_16893":42066,"_5":16788,"_22829":41874,"_2311":42067},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2783":875,"_24069":794,"_16893":42069,"_5":16788,"_22829":41874,"_2311":42070},[],"**Include Enrollment CA**",{"_2783":876,"_24069":794,"_16893":42072,"_5":16788,"_22829":41874,"_2311":42073},[],"Selected issuing CA certificate.",{"_2783":877,"_24069":794,"_16893":42075,"_5":16788,"_22829":41874,"_2311":42076},[],"**Managed CAs**",{"_2783":878,"_24069":794,"_16893":42078,"_5":16788,"_22829":41874,"_2311":42079},[],"Explicitly selected CA certificates.",{"_2783":879,"_24069":794,"_16893":42081,"_5":16788,"_22829":41874,"_2311":42082},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2783":880,"_24069":794,"_16893":42084,"_5":16788,"_22829":41878,"_2311":42085},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2783":881,"_24069":794,"_16893":42087,"_5":16788,"_22829":41878,"_2311":42088},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2783":882,"_24069":794,"_16893":42090,"_5":16788,"_22829":41878,"_2311":42091},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2783":883,"_24069":794,"_16893":42093,"_5":16788,"_22829":41882,"_2311":42094},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2783":884,"_24069":884,"_5":11891,"_2311":42096,"_24405":42097,"_16893":42098,"_22829":884},"Integrate the EST client",[39337,40681,41556,41554,41737],[],{"_2783":885,"_24069":884,"_16893":42100,"_5":16788,"_22829":884,"_2311":42101},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2783":886,"_24069":884,"_5":24402,"_16893":42103,"_22829":42104,"_2311":39347},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2783":887,"_24069":884,"_5":24402,"_16893":42106,"_22829":42107,"_2311":42108},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2783":888,"_24069":884,"_5":24402,"_16893":42110,"_22829":42111,"_2311":42112},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2783":889,"_24069":884,"_5":24402,"_16893":42114,"_22829":42115,"_2311":42116},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2783":890,"_24069":884,"_5":24402,"_16893":42118,"_22829":42119,"_2311":42120},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2783":891,"_24069":884,"_5":24402,"_16893":42122,"_22829":42123,"_2311":42124},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2783":892,"_24069":884,"_16893":42126,"_5":16788,"_22829":884,"_2311":42127},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2783":893,"_24069":884,"_16893":42129,"_5":16788,"_22829":42104,"_2311":42130},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2783":894,"_24069":884,"_16893":42132,"_5":16788,"_22829":42104,"_2311":42133},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2783":895,"_24069":884,"_16893":42135,"_5":16788,"_22829":42104,"_2311":42136},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2783":896,"_24069":884,"_16893":42138,"_5":16788,"_22829":42107,"_2311":42139},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2783":897,"_24069":884,"_16893":42141,"_5":16788,"_22829":42107,"_2311":42142},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2783":898,"_24069":884,"_16893":42144,"_5":16788,"_22829":42111,"_2311":42145},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2783":899,"_24069":884,"_16893":42147,"_5":16788,"_22829":42111,"_2311":42148},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2783":900,"_24069":884,"_16893":42150,"_5":16788,"_22829":42115,"_2311":42151},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2783":901,"_24069":884,"_16893":42153,"_5":16788,"_22829":42115,"_2311":42154},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2783":902,"_24069":884,"_16893":42156,"_5":16788,"_22829":42119,"_2311":42157},[],"For a root that issues directly:",{"_2783":903,"_24069":884,"_16893":42159,"_5":16788,"_22829":42119,"_2311":42160},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2783":904,"_24069":884,"_16893":42162,"_5":16788,"_22829":42119,"_2311":42163},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2783":905,"_24069":884,"_16893":42165,"_5":16788,"_22829":42123,"_2311":42166},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2783":906,"_24069":906,"_5":11891,"_2311":42168,"_24405":42169,"_16893":42170,"_22829":906},"EST reference",[39337,40681,41556,41554,41737],[],{"_2783":907,"_24069":906,"_16893":42172,"_5":16788,"_22829":906,"_2311":42173},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2783":908,"_24069":906,"_5":24402,"_16893":42175,"_22829":42176,"_2311":42177},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2783":909,"_24069":906,"_5":24402,"_16893":42179,"_22829":42180,"_2311":18303},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2783":910,"_24069":906,"_5":24402,"_16893":42182,"_22829":42183,"_2311":20997},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2783":911,"_24069":906,"_5":24402,"_16893":42185,"_22829":42186,"_2311":21004},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2783":912,"_24069":906,"_5":24402,"_16893":42188,"_22829":42189,"_2311":20373},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2783":913,"_24069":906,"_5":24402,"_16893":42191,"_22829":42192,"_2311":42193},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2783":914,"_24069":906,"_5":24402,"_16893":42195,"_22829":42196,"_2311":42197},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2783":915,"_24069":906,"_5":24402,"_16893":42199,"_22829":42200,"_2311":42201},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2783":916,"_24069":906,"_16893":42203,"_5":16788,"_22829":906,"_2311":42204},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2783":917,"_24069":906,"_16893":42206,"_5":16788,"_22829":42176,"_2311":42207},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2783":918,"_24069":906,"_16893":42209,"_5":16788,"_22829":42176,"_2311":42210},[],"Operation",{"_2783":919,"_24069":906,"_16893":42212,"_5":16788,"_22829":42176,"_2311":42213},[],"Method",{"_2783":920,"_24069":906,"_16893":42215,"_5":16788,"_22829":42176,"_2311":42216},[],"Authentication and condition",{"_2783":921,"_24069":906,"_16893":42218,"_5":16788,"_22829":42176,"_2311":42219},[],"`/cacerts`",{"_2783":922,"_24069":906,"_16893":42221,"_5":16788,"_22829":42176,"_2311":42222},[],"GET",{"_2783":923,"_24069":906,"_16893":42224,"_5":16788,"_22829":42176,"_2311":42225},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2783":924,"_24069":906,"_16893":42227,"_5":16788,"_22829":42176,"_2311":42228},[],"`/simpleenroll`",{"_2783":925,"_24069":906,"_16893":42230,"_5":16788,"_22829":42176,"_2311":42231},[],"POST",{"_2783":926,"_24069":906,"_16893":42233,"_5":16788,"_22829":42176,"_2311":42234},[],"Initial authentication and DMS registration/replacement policy.",{"_2783":927,"_24069":906,"_16893":42236,"_5":16788,"_22829":42176,"_2311":42237},[],"`/simplereenroll`",{"_2783":928,"_24069":906,"_16893":42239,"_5":16788,"_22829":42176,"_2311":42231},[],{"_2783":929,"_24069":906,"_16893":42241,"_5":16788,"_22829":42176,"_2311":42242},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2783":930,"_24069":906,"_16893":42244,"_5":16788,"_22829":42176,"_2311":42245},[],"`/serverkeygen`",{"_2783":931,"_24069":906,"_16893":42247,"_5":16788,"_22829":42176,"_2311":42231},[],{"_2783":932,"_24069":906,"_16893":42249,"_5":16788,"_22829":42176,"_2311":42250},[],"Initial authentication and admission; server generation enabled.",{"_2783":933,"_24069":906,"_16893":42252,"_5":16788,"_22829":42176,"_2311":42253},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2783":934,"_24069":906,"_16893":42255,"_5":16788,"_22829":42180,"_2311":42256},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2783":935,"_24069":906,"_16893":42258,"_5":16788,"_22829":42180,"_2311":42259},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2783":936,"_24069":906,"_16893":42261,"_5":16788,"_22829":42183,"_2311":42262},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2783":937,"_24069":906,"_16893":42264,"_5":16788,"_22829":42183,"_2311":42265},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2783":938,"_24069":906,"_16893":42267,"_5":16788,"_22829":42186,"_2311":42268},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2783":939,"_24069":906,"_16893":42270,"_5":16788,"_22829":42186,"_2311":42271},[],"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2783":940,"_24069":906,"_16893":42273,"_5":16788,"_22829":42189,"_2311":42274},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2783":941,"_24069":906,"_16893":42276,"_5":16788,"_22829":42189,"_2311":42277},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2783":942,"_24069":906,"_16893":42279,"_5":16788,"_22829":42192,"_2311":42280},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2783":943,"_24069":906,"_16893":42282,"_5":16788,"_22829":42192,"_2311":42283},[],"Part",{"_2783":944,"_24069":906,"_16893":42285,"_5":16788,"_22829":42192,"_2311":42286},[],"Content after decoding its Base64",{"_2783":945,"_24069":906,"_16893":42288,"_5":16788,"_22829":42192,"_2311":42289},[],"`application/pkcs8`",{"_2783":946,"_24069":906,"_16893":42291,"_5":16788,"_22829":42192,"_2311":42292},[],"Unencrypted DER PKCS#8 private key.",{"_2783":947,"_24069":906,"_16893":42294,"_5":16788,"_22829":42192,"_2311":42295},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2783":948,"_24069":906,"_16893":42297,"_5":16788,"_22829":42192,"_2311":42298},[],"DER PKCS#7 containing the issued certificate.",{"_2783":949,"_24069":906,"_16893":42300,"_5":16788,"_22829":42192,"_2311":42301},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2783":950,"_24069":906,"_16893":42303,"_5":16788,"_22829":42196,"_2311":42304},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2783":951,"_24069":906,"_16893":42306,"_5":16788,"_22829":42196,"_2311":42307},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2783":952,"_24069":906,"_16893":42309,"_5":16788,"_22829":42196,"_2311":42310},[],"Convert and check the result:",{"_2783":953,"_24069":906,"_16893":42312,"_5":16788,"_22829":42196,"_2311":42313},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2783":954,"_24069":906,"_16893":42315,"_5":16788,"_22829":42200,"_2311":42316},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2783":955,"_24069":906,"_16893":42318,"_5":16788,"_22829":42200,"_2311":42319},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2783":956,"_24069":956,"_5":11891,"_2311":41737,"_24405":42321,"_16893":42322,"_22829":956},[39337,40681,41556,41554,41737],[],{"_2783":957,"_24069":956,"_16893":42324,"_5":16788,"_22829":956,"_2311":42325},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2783":958,"_24069":956,"_5":24402,"_16893":42327,"_22829":42328,"_2311":42329},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2783":959,"_24069":956,"_5":24402,"_16893":42331,"_22829":42332,"_2311":42333},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2783":960,"_24069":956,"_5":24402,"_16893":42335,"_22829":42336,"_2311":42337},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2783":961,"_24069":956,"_5":24402,"_16893":42339,"_22829":42340,"_2311":42341},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2783":962,"_24069":956,"_16893":42343,"_5":16788,"_22829":956,"_2311":42344},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2783":963,"_24069":956,"_16893":42346,"_5":16788,"_22829":42328,"_2311":42347},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2783":964,"_24069":956,"_16893":42349,"_5":16788,"_22829":42328,"_2311":42350},[],"The integrator installs initial EST server trust and an admission credential.",{"_2783":965,"_24069":956,"_16893":42352,"_5":16788,"_22829":42328,"_2311":42353},[],"The client requests an identity for its `Device ID` through EST.",{"_2783":966,"_24069":956,"_16893":42355,"_5":16788,"_22829":42328,"_2311":42356},[],"Certificate, device binding and key/certificate installation are checked.",{"_2783":967,"_24069":956,"_16893":42358,"_5":16788,"_22829":42328,"_2311":42359},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2783":968,"_24069":956,"_16893":42361,"_5":16788,"_22829":42328,"_2311":42362},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2783":969,"_24069":956,"_16893":42364,"_5":16788,"_22829":42332,"_2311":42365},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2783":970,"_24069":956,"_16893":42367,"_5":16788,"_22829":42332,"_2311":42368},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":971,"_24069":956,"_16893":42370,"_5":16788,"_22829":42332,"_2311":42371},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2783":972,"_24069":956,"_16893":42373,"_5":16788,"_22829":42332,"_2311":42374},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2783":973,"_24069":956,"_16893":42376,"_5":16788,"_22829":42336,"_2311":42377},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2783":974,"_24069":956,"_16893":42379,"_5":16788,"_22829":42336,"_2311":42380},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2783":975,"_24069":956,"_16893":42382,"_5":16788,"_22829":42336,"_2311":42383},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2783":976,"_24069":956,"_16893":42385,"_5":16788,"_22829":42336,"_2311":42386},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2783":977,"_24069":956,"_16893":42388,"_5":16788,"_22829":42340,"_2311":42389},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2783":978,"_24069":956,"_16893":42391,"_5":16788,"_22829":42340,"_2311":42392},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2783":979,"_24069":979,"_5":11891,"_2311":42394,"_24405":42395,"_16893":42396,"_22829":979},"Provisioning strategies",[39337,40681,41556,41554,41737],[],{"_2783":980,"_24069":979,"_16893":42398,"_5":16788,"_22829":979,"_2311":42399},[],"Choose device registration, identity authorization and key generation.",{"_2783":981,"_24069":979,"_5":24402,"_16893":42401,"_22829":42402,"_2311":42403},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2783":982,"_24069":979,"_5":24402,"_16893":42405,"_22829":42406,"_2311":42407},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2783":983,"_24069":979,"_5":24402,"_16893":42409,"_22829":42410,"_2311":42411},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2783":984,"_24069":979,"_5":24402,"_16893":42413,"_22829":42414,"_2311":42415},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2783":985,"_24069":979,"_5":24402,"_16893":42417,"_22829":42418,"_2311":42419},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2783":986,"_24069":979,"_16893":42421,"_5":16788,"_22829":979,"_2311":42422},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2783":987,"_24069":979,"_16893":42424,"_5":16788,"_22829":42402,"_2311":42425},[],"Path",{"_2783":988,"_24069":979,"_16893":42427,"_5":16788,"_22829":42402,"_2311":42428},[],"When the device exists",{"_2783":989,"_24069":979,"_16893":42430,"_5":16788,"_22829":42402,"_2311":42431},[],"What to check",{"_2783":990,"_24069":979,"_16893":42433,"_5":16788,"_22829":42402,"_2311":42434},[],"Manual assignment",{"_2783":991,"_24069":979,"_16893":42436,"_5":16788,"_22829":42402,"_2311":42437},[],"An operator creates it before associating a certificate.",{"_2783":992,"_24069":979,"_16893":42439,"_5":16788,"_22829":42402,"_2311":42440},[],"ID, owning DMS, certificate CN and bound serial.",{"_2783":993,"_24069":979,"_16893":42442,"_5":16788,"_22829":42402,"_2311":42443},[],"EST with `JITP`",{"_2783":994,"_24069":979,"_16893":42445,"_5":16788,"_22829":42402,"_2311":42446},[],"Created for an unknown CN during `/simpleenroll`.",{"_2783":995,"_24069":979,"_16893":42448,"_5":16788,"_22829":42402,"_2311":42449},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2783":996,"_24069":979,"_16893":42451,"_5":16788,"_22829":42402,"_2311":42452},[],"EST with `PRE_REGISTRATION`",{"_2783":997,"_24069":979,"_16893":42454,"_5":16788,"_22829":42402,"_2311":42455},[],"Must exist before `/simpleenroll`.",{"_2783":998,"_24069":979,"_16893":42457,"_5":16788,"_22829":42402,"_2311":42458},[],"Approved record, same DMS and replacement conditions for your version.",{"_2783":999,"_24069":979,"_16893":42460,"_5":16788,"_22829":42402,"_2311":42461},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2783":1000,"_24069":979,"_16893":42463,"_5":16788,"_22829":42402,"_2311":42464},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2783":1001,"_24069":979,"_16893":42466,"_5":16788,"_22829":42406,"_2311":42467},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2783":1002,"_24069":979,"_16893":42469,"_5":16788,"_22829":42406,"_2311":42470},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2783":1003,"_24069":979,"_16893":42472,"_5":16788,"_22829":42406,"_2311":42473},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2783":1004,"_24069":979,"_16893":42475,"_5":16788,"_22829":42410,"_2311":42476},[],"Decide initial enrollment and re-enrollment separately:",{"_2783":1005,"_24069":979,"_16893":42478,"_5":16788,"_22829":42410,"_2311":42479},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2783":1006,"_24069":979,"_16893":42481,"_5":16788,"_22829":42410,"_2311":42482},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2783":1007,"_24069":979,"_16893":42484,"_5":16788,"_22829":42410,"_2311":42485},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2783":1008,"_24069":979,"_16893":42487,"_5":16788,"_22829":42410,"_2311":42488},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2783":1009,"_24069":979,"_16893":42490,"_5":16788,"_22829":42410,"_2311":42491},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2783":1010,"_24069":979,"_16893":42493,"_5":16788,"_22829":42414,"_2311":39714},[],{"_2783":1011,"_24069":979,"_16893":42495,"_5":16788,"_22829":42414,"_2311":42496},[],"Material crossing EST",{"_2783":1012,"_24069":979,"_16893":42498,"_5":16788,"_22829":42414,"_2311":42499},[],"Device-generated key",{"_2783":1013,"_24069":979,"_16893":42501,"_5":16788,"_22829":42414,"_2311":42502},[],"Public CSR and certificate; the key stays on the client.",{"_2783":1014,"_24069":979,"_16893":42504,"_5":16788,"_22829":42414,"_2311":42505},[],"Existing device key",{"_2783":1015,"_24069":979,"_16893":42507,"_5":16788,"_22829":42414,"_2311":42508},[],"CSR signed with that key and a new certificate.",{"_2783":1016,"_24069":979,"_16893":42510,"_5":16788,"_22829":42414,"_2311":41871},[],{"_2783":1017,"_24069":979,"_16893":42512,"_5":16788,"_22829":42414,"_2311":42513},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2783":1018,"_24069":979,"_16893":42515,"_5":16788,"_22829":42414,"_2311":42516},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2783":1019,"_24069":979,"_16893":42518,"_5":16788,"_22829":42418,"_2311":42519},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2783":1020,"_24069":1020,"_5":11891,"_2311":42521,"_24405":42522,"_16893":42523,"_22829":1020},"Renewal and recovery",[39337,40681,41556,41554,41737],[],{"_2783":1021,"_24069":1020,"_16893":42525,"_5":16788,"_22829":1020,"_2311":42526},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2783":1022,"_24069":1020,"_5":24402,"_16893":42528,"_22829":42529,"_2311":42530},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2783":1023,"_24069":1020,"_5":24402,"_16893":42532,"_22829":42533,"_2311":42534},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2783":1024,"_24069":1020,"_5":24402,"_16893":42536,"_22829":42537,"_2311":42538},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2783":1025,"_24069":1020,"_5":24402,"_16893":42540,"_22829":42541,"_2311":42542},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2783":1026,"_24069":1020,"_5":24402,"_16893":42544,"_22829":42545,"_2311":42546},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2783":1027,"_24069":1020,"_16893":42548,"_5":16788,"_22829":1020,"_2311":42549},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2783":1028,"_24069":1020,"_16893":42551,"_5":16788,"_22829":42529,"_2311":42552},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2783":1029,"_24069":1020,"_16893":42554,"_5":16788,"_22829":42529,"_2311":42555},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2783":1030,"_24069":1020,"_16893":42557,"_5":16788,"_22829":42529,"_2311":42558},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2783":1031,"_24069":1020,"_16893":42560,"_5":16788,"_22829":42529,"_2311":42561},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2783":1032,"_24069":1020,"_16893":42563,"_5":16788,"_22829":42533,"_2311":42564},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2783":1033,"_24069":1020,"_16893":42566,"_5":16788,"_22829":42533,"_2311":42567},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2783":1034,"_24069":1020,"_16893":42569,"_5":16788,"_22829":42537,"_2311":42570},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2783":1035,"_24069":1020,"_16893":42572,"_5":16788,"_22829":42537,"_2311":42573},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2783":1036,"_24069":1020,"_16893":42575,"_5":16788,"_22829":42537,"_2311":42576},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2783":1037,"_24069":1020,"_16893":42578,"_5":16788,"_22829":42541,"_2311":42579},[],"Situation",{"_2783":1038,"_24069":1020,"_16893":42581,"_5":16788,"_22829":42541,"_2311":42582},[],"Procedure",{"_2783":1039,"_24069":1020,"_16893":42584,"_5":16788,"_22829":42541,"_2311":42585},[],"Valid certificate, outside the window",{"_2783":1040,"_24069":1020,"_16893":42587,"_5":16788,"_22829":42541,"_2311":42588},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2783":1041,"_24069":1020,"_16893":42590,"_5":16788,"_22829":42541,"_2311":42591},[],"Expired certificate, key available",{"_2783":1042,"_24069":1020,"_16893":42593,"_5":16788,"_22829":42541,"_2311":42594},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2783":1043,"_24069":1020,"_16893":42596,"_5":16788,"_22829":42541,"_2311":42597},[],"Renewal through webhook or `NO_AUTH`",{"_2783":1044,"_24069":1020,"_16893":42599,"_5":16788,"_22829":42541,"_2311":42600},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2783":1045,"_24069":1020,"_16893":42602,"_5":16788,"_22829":42541,"_2311":42603},[],"Lost or inaccessible key",{"_2783":1046,"_24069":1020,"_16893":42605,"_5":16788,"_22829":42541,"_2311":42606},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2783":1047,"_24069":1020,"_16893":42608,"_5":16788,"_22829":42541,"_2311":42609},[],"Current identity revoked",{"_2783":1048,"_24069":1020,"_16893":42611,"_5":16788,"_22829":42541,"_2311":42612},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2783":1049,"_24069":1020,"_16893":42614,"_5":16788,"_22829":42541,"_2311":42615},[],"Device without an identity",{"_2783":1050,"_24069":1020,"_16893":42617,"_5":16788,"_22829":42541,"_2311":42618},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2783":1051,"_24069":1020,"_16893":42620,"_5":16788,"_22829":42541,"_2311":42621},[],"Retired device",{"_2783":1052,"_24069":1020,"_16893":42623,"_5":16788,"_22829":42541,"_2311":42624},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2783":1053,"_24069":1020,"_16893":42626,"_5":16788,"_22829":42541,"_2311":42627},[],"Timeout, HTTP 500 or installation failure",{"_2783":1054,"_24069":1020,"_16893":42629,"_5":16788,"_22829":42541,"_2311":42630},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2783":1055,"_24069":1020,"_16893":42632,"_5":16788,"_22829":42545,"_2311":42633},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2783":1056,"_24069":1020,"_16893":42635,"_5":16788,"_22829":42545,"_2311":42636},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2783":1057,"_24069":1057,"_5":11891,"_2311":42638,"_24405":42639,"_16893":42640,"_22829":1057},"Enrollment troubleshooting",[39337,40681,41556,41554,41737],[],{"_2783":1058,"_24069":1057,"_16893":42642,"_5":16788,"_22829":1057,"_2311":42643},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2783":1059,"_24069":1057,"_5":24402,"_16893":42645,"_22829":42646,"_2311":42647},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2783":1060,"_24069":1057,"_5":24402,"_16893":42649,"_22829":42650,"_2311":42651},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2783":1061,"_24069":1057,"_5":24402,"_16893":42653,"_22829":42654,"_2311":42201},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2783":1062,"_24069":1057,"_5":24402,"_16893":42656,"_22829":42657,"_2311":42658},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2783":1063,"_24069":1057,"_16893":42660,"_5":16788,"_22829":1057,"_2311":42661},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2783":1064,"_24069":1057,"_16893":42663,"_5":16788,"_22829":42650,"_2311":42664},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2783":1065,"_24069":1057,"_16893":42666,"_5":16788,"_22829":42650,"_2311":42667},[],"Symptom or message",{"_2783":1066,"_24069":1057,"_16893":42669,"_5":16788,"_22829":42650,"_2311":42431},[],{"_2783":1067,"_24069":1057,"_16893":42671,"_5":16788,"_22829":42650,"_2311":42672},[],"curl rejects TLS, name or issuer",{"_2783":1068,"_24069":1057,"_16893":42674,"_5":16788,"_22829":42650,"_2311":42675},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2783":1069,"_24069":1057,"_16893":42677,"_5":16788,"_22829":42650,"_2311":42678},[],"404 or missing APS",{"_2783":1070,"_24069":1057,"_16893":42680,"_5":16788,"_22829":42650,"_2311":42681},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2783":1071,"_24069":1057,"_16893":42683,"_5":16788,"_22829":42650,"_2311":42684},[],"400, CSR or format error",{"_2783":1072,"_24069":1057,"_16893":42686,"_5":16788,"_22829":42650,"_2311":42687},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2783":1073,"_24069":1057,"_16893":42689,"_5":16788,"_22829":42650,"_2311":42690},[],"Missing credential or invalid certificate",{"_2783":1074,"_24069":1057,"_16893":42692,"_5":16788,"_22829":42650,"_2311":42693},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2783":1075,"_24069":1057,"_16893":42695,"_5":16788,"_22829":42650,"_2311":42696},[],"Webhook denies, times out or responds without authorization",{"_2783":1076,"_24069":1057,"_16893":42698,"_5":16788,"_22829":42650,"_2311":42699},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2783":1077,"_24069":1057,"_16893":42701,"_5":16788,"_22829":42650,"_2311":42702},[],"`device not preregistered`",{"_2783":1078,"_24069":1057,"_16893":42704,"_5":16788,"_22829":42650,"_2311":42705},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2783":1079,"_24069":1057,"_16893":42707,"_5":16788,"_22829":42650,"_2311":42708},[],"`forbiddenNewEnrollment`",{"_2783":1080,"_24069":1057,"_16893":42710,"_5":16788,"_22829":42650,"_2311":42711},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2783":1081,"_24069":1057,"_16893":42713,"_5":16788,"_22829":42650,"_2311":42714},[],"Different owning DMS",{"_2783":1082,"_24069":1057,"_16893":42716,"_5":16788,"_22829":42650,"_2311":42717},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2783":1083,"_24069":1057,"_16893":42719,"_5":16788,"_22829":42650,"_2311":42720},[],"`invalid RawSubject bytes`",{"_2783":1084,"_24069":1057,"_16893":42722,"_5":16788,"_22829":42650,"_2311":42723},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2783":1085,"_24069":1057,"_16893":42725,"_5":16788,"_22829":42650,"_2311":42726},[],"`invalid reenroll window`",{"_2783":1086,"_24069":1057,"_16893":42728,"_5":16788,"_22829":42650,"_2311":42729},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2783":1087,"_24069":1057,"_16893":42731,"_5":16788,"_22829":42650,"_2311":42732},[],"Current certificate revoked",{"_2783":1088,"_24069":1057,"_16893":42734,"_5":16788,"_22829":42650,"_2311":42735},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2783":1089,"_24069":1057,"_16893":42737,"_5":16788,"_22829":42650,"_2311":42738},[],"CA, profile or signing error",{"_2783":1090,"_24069":1057,"_16893":42740,"_5":16788,"_22829":42650,"_2311":42741},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2783":1091,"_24069":1057,"_16893":42743,"_5":16788,"_22829":42650,"_2311":42744},[],"HTTP 200 without a device connection",{"_2783":1092,"_24069":1057,"_16893":42746,"_5":16788,"_22829":42650,"_2311":42747},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2783":1093,"_24069":1057,"_16893":42749,"_5":16788,"_22829":42650,"_2311":42750},[],"Timeout or error after issuance",{"_2783":1094,"_24069":1057,"_16893":42752,"_5":16788,"_22829":42650,"_2311":42753},[],"New certificates, current slot and previous identity's state before retrying.",{"_2783":1095,"_24069":1057,"_16893":42755,"_5":16788,"_22829":42654,"_2311":42756},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2783":1096,"_24069":1057,"_16893":42758,"_5":16788,"_22829":42654,"_2311":42759},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2783":1097,"_24069":1057,"_16893":42761,"_5":16788,"_22829":42657,"_2311":42762},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2783":1098,"_24069":1057,"_16893":42764,"_5":16788,"_22829":42657,"_2311":42765},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2783":1099,"_24069":1057,"_16893":42767,"_5":16788,"_22829":42657,"_2311":42768},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2783":1100,"_24069":1057,"_16893":42770,"_5":16788,"_22829":42657,"_2311":42771},[],"Make one request, save headers/body and query the device and certificates.",{"_2783":1101,"_24069":1057,"_16893":42773,"_5":16788,"_22829":42657,"_2311":42774},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2783":1102,"_24069":1057,"_16893":42776,"_5":16788,"_22829":42657,"_2311":42777},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2783":1103,"_24069":1057,"_16893":42779,"_5":16788,"_22829":42657,"_2311":42780},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2783":1104,"_24069":1104,"_5":11891,"_2311":42782,"_24405":42783,"_16893":42784,"_22829":1104},"Trust distribution and updates",[39337,40681,41556,41554,41737],[],{"_2783":1105,"_24069":1104,"_16893":42786,"_5":16788,"_22829":1104,"_2311":42787},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2783":1106,"_24069":1104,"_5":24402,"_16893":42789,"_22829":42790,"_2311":42791},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2783":1107,"_24069":1104,"_5":24402,"_16893":42793,"_22829":42794,"_2311":42795},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2783":1108,"_24069":1104,"_5":24402,"_16893":42797,"_22829":42798,"_2311":42799},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2783":1109,"_24069":1104,"_5":24402,"_16893":42801,"_22829":42802,"_2311":42803},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2783":1110,"_24069":1104,"_5":24402,"_16893":42805,"_22829":42806,"_2311":42807},[],"/docs/pr-preview/pr-27/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2783":1111,"_24069":1104,"_16893":42809,"_5":16788,"_22829":1104,"_2311":42810},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2783":1112,"_24069":1104,"_16893":42812,"_5":16788,"_22829":42790,"_2311":42813},[],"Relationship",{"_2783":1113,"_24069":1104,"_16893":42815,"_5":16788,"_22829":42790,"_2311":42816},[],"Material prepared by its owner",{"_2783":1114,"_24069":1104,"_16893":42818,"_5":16788,"_22829":42790,"_2311":42819},[],"Device → EST server",{"_2783":1115,"_24069":1104,"_16893":42821,"_5":16788,"_22829":42790,"_2311":42822},[],"Previously verified server root, chain or pin and TLS name.",{"_2783":1116,"_24069":1104,"_16893":42824,"_5":16788,"_22829":42790,"_2311":42825},[],"DMS → requester",{"_2783":1117,"_24069":1104,"_16893":42827,"_5":16788,"_22829":42790,"_2311":42828},[],"CAs and rules authorizing initial or renewal credentials.",{"_2783":1118,"_24069":1104,"_16893":42830,"_5":16788,"_22829":42790,"_2311":42831},[],"Consumer → device",{"_2783":1119,"_24069":1104,"_16893":42833,"_5":16788,"_22829":42790,"_2311":42834},[],"Operational identity roots, intermediates, validation and permissions.",{"_2783":1120,"_24069":1104,"_16893":42836,"_5":16788,"_22829":42790,"_2311":42837},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2783":1121,"_24069":1104,"_16893":42839,"_5":16788,"_22829":42794,"_2311":42840},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2783":1122,"_24069":1104,"_16893":42842,"_5":16788,"_22829":42794,"_2311":42843},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2783":1123,"_24069":1104,"_16893":42845,"_5":16788,"_22829":42798,"_2311":42846},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2783":1124,"_24069":1104,"_16893":42848,"_5":16788,"_22829":42798,"_2311":42849},[],"Select policy-approved roots as anchors.",{"_2783":1125,"_24069":1104,"_16893":42851,"_5":16788,"_22829":42798,"_2311":42852},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2783":1126,"_24069":1104,"_16893":42854,"_5":16788,"_22829":42798,"_2311":42855},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2783":1127,"_24069":1104,"_16893":42857,"_5":16788,"_22829":42798,"_2311":42858},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2783":1128,"_24069":1104,"_16893":42860,"_5":16788,"_22829":42798,"_2311":42861},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2783":1129,"_24069":1104,"_16893":42863,"_5":16788,"_22829":42802,"_2311":42864},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2783":1130,"_24069":1104,"_16893":42866,"_5":16788,"_22829":42802,"_2311":42867},[],"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2783":1131,"_24069":1104,"_16893":42869,"_5":16788,"_22829":42802,"_2311":42870},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2783":1132,"_24069":1104,"_16893":42872,"_5":16788,"_22829":42806,"_2311":42873},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2783":1133,"_24069":1133,"_5":11891,"_2311":42875,"_24405":42876,"_16893":42878,"_22829":1133},"AWS IoT Core",[39337,40681,41556,41554,42877],"Integrations",[],{"_2783":1134,"_24069":1133,"_16893":42880,"_5":16788,"_22829":1133,"_2311":42881},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2783":1135,"_24069":1133,"_5":24402,"_16893":42883,"_22829":42884,"_2311":42885},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2783":1136,"_24069":1133,"_5":24402,"_16893":42887,"_22829":42888,"_2311":42889},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2783":1137,"_24069":1133,"_5":24402,"_16893":42891,"_22829":42892,"_2311":42893},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2783":1138,"_24069":1133,"_5":24402,"_16893":42895,"_22829":42896,"_2311":42897},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2783":1139,"_24069":1133,"_5":24402,"_16893":42899,"_22829":42900,"_2311":42901},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2783":1140,"_24069":1133,"_5":24402,"_16893":42903,"_22829":42904,"_2311":42905},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2783":1141,"_24069":1133,"_5":24402,"_16893":42907,"_22829":42908,"_2311":42909},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2783":1142,"_24069":1133,"_5":24402,"_16893":42911,"_22829":42912,"_2311":42913},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2783":1143,"_24069":1133,"_5":24402,"_16893":42915,"_22829":42916,"_2311":42917},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2783":1144,"_24069":1133,"_5":24402,"_16893":42919,"_22829":42920,"_2311":42921},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2783":1145,"_24069":1133,"_5":24402,"_16893":42923,"_22829":42924,"_2311":42925},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2783":1146,"_24069":1133,"_5":24402,"_16893":42927,"_22829":42928,"_2311":42929},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2783":1147,"_24069":1133,"_5":24402,"_16893":42931,"_22829":42932,"_2311":42933},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2783":1148,"_24069":1133,"_5":24402,"_16893":42935,"_22829":42936,"_2311":42937},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2783":1149,"_24069":1133,"_5":24402,"_16893":42939,"_22829":42940,"_2311":42941},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2783":1150,"_24069":1133,"_5":24402,"_16893":42943,"_22829":42944,"_2311":42945},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2783":1151,"_24069":1133,"_5":24402,"_16893":42947,"_22829":42948,"_2311":42949},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2783":1152,"_24069":1133,"_5":24402,"_16893":42951,"_22829":42952,"_2311":42953},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2783":1153,"_24069":1133,"_5":24402,"_16893":42955,"_22829":42956,"_2311":42957},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2783":1154,"_24069":1133,"_5":24402,"_16893":42959,"_22829":42960,"_2311":42961},[],"/docs/pr-preview/pr-27/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2783":1155,"_24069":1133,"_16893":42963,"_5":16788,"_22829":1133,"_2311":42964},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2783":1156,"_24069":1133,"_16893":42966,"_5":16788,"_22829":1133,"_2311":42967},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2783":1157,"_24069":1133,"_16893":42969,"_5":16788,"_22829":1133,"_2311":42970},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2783":1158,"_24069":1133,"_16893":42972,"_5":16788,"_22829":42884,"_2311":42973},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2783":1159,"_24069":1133,"_16893":42975,"_5":16788,"_22829":42884,"_2311":42976},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2783":1160,"_24069":1133,"_16893":42978,"_5":16788,"_22829":42884,"_2311":42979},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2783":1161,"_24069":1133,"_16893":42981,"_5":16788,"_22829":42884,"_2311":42982},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2783":1162,"_24069":1133,"_16893":42984,"_5":16788,"_22829":42888,"_2311":42985},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2783":1163,"_24069":1133,"_16893":42987,"_5":16788,"_22829":42892,"_2311":42988},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2783":1164,"_24069":1133,"_16893":42990,"_5":16788,"_22829":42892,"_2311":42991},[],"IAM action",{"_2783":1165,"_24069":1133,"_16893":42993,"_5":16788,"_22829":42892,"_2311":39720},[],{"_2783":1166,"_24069":1133,"_16893":42995,"_5":16788,"_22829":42892,"_2311":42996},[],"`iot:GetRegistrationCode`",{"_2783":1167,"_24069":1133,"_16893":42998,"_5":16788,"_22829":42892,"_2311":42999},[],"Obtain the verification code for CA registration in the Primary Account",{"_2783":1168,"_24069":1133,"_16893":43001,"_5":16788,"_22829":42892,"_2311":43002},[],"`iot:RegisterCACertificate`",{"_2783":1169,"_24069":1133,"_16893":43004,"_5":16788,"_22829":42892,"_2311":43005},[],"Register the CA in AWS IoT",{"_2783":1170,"_24069":1133,"_16893":43007,"_5":16788,"_22829":42892,"_2311":43008},[],"`iot:DescribeCACertificate`",{"_2783":1171,"_24069":1133,"_16893":43010,"_5":16788,"_22829":42892,"_2311":43011},[],"Check the CA registration status",{"_2783":1172,"_24069":1133,"_16893":43013,"_5":16788,"_22829":42892,"_2311":43014},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2783":1173,"_24069":1133,"_16893":43016,"_5":16788,"_22829":42892,"_2311":43017},[],"Create or update Things in IoT Core",{"_2783":1174,"_24069":1133,"_16893":43019,"_5":16788,"_22829":42892,"_2311":43020},[],"`iot:RegisterThing`",{"_2783":1175,"_24069":1133,"_16893":43022,"_5":16788,"_22829":42892,"_2311":43023},[],"Provision Things through a template",{"_2783":1176,"_24069":1133,"_16893":43025,"_5":16788,"_22829":42892,"_2311":43026},[],"`iot:RegisterCertificate`",{"_2783":1177,"_24069":1133,"_16893":43028,"_5":16788,"_22829":42892,"_2311":43029},[],"Register device certificates",{"_2783":1178,"_24069":1133,"_16893":43031,"_5":16788,"_22829":42892,"_2311":43032},[],"`iot:UpdateCertificate`",{"_2783":1179,"_24069":1133,"_16893":43034,"_5":16788,"_22829":42892,"_2311":43035},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2783":1180,"_24069":1133,"_16893":43037,"_5":16788,"_22829":42892,"_2311":43038},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2783":1181,"_24069":1133,"_16893":43040,"_5":16788,"_22829":42892,"_2311":43041},[],"Create and attach IoT policies",{"_2783":1182,"_24069":1133,"_16893":43043,"_5":16788,"_22829":42892,"_2311":43044},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2783":1183,"_24069":1133,"_16893":43046,"_5":16788,"_22829":42892,"_2311":43047},[],"Manage Thing groups",{"_2783":1184,"_24069":1133,"_16893":43049,"_5":16788,"_22829":42892,"_2311":43050},[],"`iot:CreateProvisioningTemplate`",{"_2783":1185,"_24069":1133,"_16893":43052,"_5":16788,"_22829":42892,"_2311":43053},[],"Create JITP templates",{"_2783":1186,"_24069":1133,"_16893":43055,"_5":16788,"_22829":42892,"_2311":43056},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2783":1187,"_24069":1133,"_16893":43058,"_5":16788,"_22829":42892,"_2311":43059},[],"Read and write the Device Shadow",{"_2783":1188,"_24069":1133,"_16893":43061,"_5":16788,"_22829":42892,"_2311":43062},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2783":1189,"_24069":1133,"_16893":43064,"_5":16788,"_22829":42896,"_2311":43065},[],"Parameter",{"_2783":1190,"_24069":1133,"_16893":43067,"_5":16788,"_22829":42896,"_2311":43068},[],"Type",{"_2783":1191,"_24069":1133,"_16893":43070,"_5":16788,"_22829":42896,"_2311":43071},[],"Required",{"_2783":1192,"_24069":1133,"_16893":43073,"_5":16788,"_22829":42896,"_2311":43074},[],"Description",{"_2783":1193,"_24069":1133,"_16893":43076,"_5":16788,"_22829":42896,"_2311":43077},[],"`connector_id`",{"_2783":1194,"_24069":1133,"_16893":43079,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1195,"_24069":1133,"_16893":43081,"_5":16788,"_22829":42896,"_2311":43082},[],"Yes",{"_2783":1196,"_24069":1133,"_16893":43084,"_5":16788,"_22829":42896,"_2311":43085},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2783":1197,"_24069":1133,"_16893":43087,"_5":16788,"_22829":42896,"_2311":43088},[],"`aws_config.region`",{"_2783":1198,"_24069":1133,"_16893":43090,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1199,"_24069":1133,"_16893":43092,"_5":16788,"_22829":42896,"_2311":43082},[],{"_2783":1200,"_24069":1133,"_16893":43094,"_5":16788,"_22829":42896,"_2311":43095},[],"AWS region where the connector operates.",{"_2783":1201,"_24069":1133,"_16893":43097,"_5":16788,"_22829":42896,"_2311":43098},[],"`aws_config.auth_method`",{"_2783":1202,"_24069":1133,"_16893":43100,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1203,"_24069":1133,"_16893":43102,"_5":16788,"_22829":42896,"_2311":43082},[],{"_2783":1204,"_24069":1133,"_16893":43104,"_5":16788,"_22829":42896,"_2311":43105},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2783":1205,"_24069":1133,"_16893":43107,"_5":16788,"_22829":42896,"_2311":43108},[],"`aws_config.access_key_id`",{"_2783":1206,"_24069":1133,"_16893":43110,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1207,"_24069":1133,"_16893":43112,"_5":16788,"_22829":42896,"_2311":43113},[],"Only with `auth_method=static`",{"_2783":1208,"_24069":1133,"_16893":43115,"_5":16788,"_22829":42896,"_2311":43116},[],"AWS access key.",{"_2783":1209,"_24069":1133,"_16893":43118,"_5":16788,"_22829":42896,"_2311":43119},[],"`aws_config.secret_access_key`",{"_2783":1210,"_24069":1133,"_16893":43121,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1211,"_24069":1133,"_16893":43123,"_5":16788,"_22829":42896,"_2311":43113},[],{"_2783":1212,"_24069":1133,"_16893":43125,"_5":16788,"_22829":42896,"_2311":43126},[],"AWS secret key.",{"_2783":1213,"_24069":1133,"_16893":43128,"_5":16788,"_22829":42896,"_2311":43129},[],"`aws_config.session_token`",{"_2783":1214,"_24069":1133,"_16893":43131,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1215,"_24069":1133,"_16893":43133,"_5":16788,"_22829":42896,"_2311":43134},[],"No",{"_2783":1216,"_24069":1133,"_16893":43136,"_5":16788,"_22829":42896,"_2311":43137},[],"Session token (with `auth_method=static`).",{"_2783":1217,"_24069":1133,"_16893":43139,"_5":16788,"_22829":42896,"_2311":43140},[],"`aws_config.role_arn`",{"_2783":1218,"_24069":1133,"_16893":43142,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1219,"_24069":1133,"_16893":43144,"_5":16788,"_22829":42896,"_2311":43145},[],"Only with `auth_method=role`",{"_2783":1220,"_24069":1133,"_16893":43147,"_5":16788,"_22829":42896,"_2311":43148},[],"ARN of the role to assume.",{"_2783":1221,"_24069":1133,"_16893":43150,"_5":16788,"_22829":42896,"_2311":43151},[],"`aws_config.endpoint_url`",{"_2783":1222,"_24069":1133,"_16893":43153,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1223,"_24069":1133,"_16893":43155,"_5":16788,"_22829":42896,"_2311":43134},[],{"_2783":1224,"_24069":1133,"_16893":43157,"_5":16788,"_22829":42896,"_2311":43158},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2783":1225,"_24069":1133,"_16893":43160,"_5":16788,"_22829":42896,"_2311":43161},[],"`subscriber_event_bus`",{"_2783":1226,"_24069":1133,"_16893":43163,"_5":16788,"_22829":42896,"_2311":14201},[],{"_2783":1227,"_24069":1133,"_16893":43165,"_5":16788,"_22829":42896,"_2311":43082},[],{"_2783":1228,"_24069":1133,"_16893":43167,"_5":16788,"_22829":42896,"_2311":43168},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2783":1229,"_24069":1133,"_16893":43170,"_5":16788,"_22829":42896,"_2311":43171},[],"`dms_manager_client`",{"_2783":1230,"_24069":1133,"_16893":43173,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1231,"_24069":1133,"_16893":43175,"_5":16788,"_22829":42896,"_2311":43082},[],{"_2783":1232,"_24069":1133,"_16893":43177,"_5":16788,"_22829":42896,"_2311":43178},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2783":1233,"_24069":1133,"_16893":43180,"_5":16788,"_22829":42896,"_2311":43181},[],"`device_manager_client`",{"_2783":1234,"_24069":1133,"_16893":43183,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1235,"_24069":1133,"_16893":43185,"_5":16788,"_22829":42896,"_2311":43082},[],{"_2783":1236,"_24069":1133,"_16893":43187,"_5":16788,"_22829":42896,"_2311":43188},[],"HTTP URL of Lamassu's Device Manager.",{"_2783":1237,"_24069":1133,"_16893":43190,"_5":16788,"_22829":42896,"_2311":43191},[],"`ca_client`",{"_2783":1238,"_24069":1133,"_16893":43193,"_5":16788,"_22829":42896,"_2311":20125},[],{"_2783":1239,"_24069":1133,"_16893":43195,"_5":16788,"_22829":42896,"_2311":43082},[],{"_2783":1240,"_24069":1133,"_16893":43197,"_5":16788,"_22829":42896,"_2311":43198},[],"HTTP URL of Lamassu's CA service.",{"_2783":1241,"_24069":1133,"_16893":43200,"_5":16788,"_22829":42900,"_2311":43201},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2783":1242,"_24069":1133,"_16893":43203,"_5":16788,"_22829":42904,"_2311":43204},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2783":1243,"_24069":1133,"_16893":43206,"_5":16788,"_22829":42904,"_2311":43207},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2783":1244,"_24069":1133,"_16893":43209,"_5":16788,"_22829":42908,"_2311":43210},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2783":1245,"_24069":1133,"_16893":43212,"_5":16788,"_22829":42908,"_2311":43213},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2783":1246,"_24069":1133,"_16893":43215,"_5":16788,"_22829":42908,"_2311":43216},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2783":1247,"_24069":1133,"_16893":43218,"_5":16788,"_22829":42908,"_2311":43219},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2783":1248,"_24069":1133,"_16893":43221,"_5":16788,"_22829":42908,"_2311":43222},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2783":1249,"_24069":1133,"_16893":43224,"_5":16788,"_22829":42908,"_2311":43225},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2783":1250,"_24069":1133,"_16893":43227,"_5":16788,"_22829":42912,"_2311":43228},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2783":1251,"_24069":1133,"_16893":43230,"_5":16788,"_22829":42916,"_2311":43231},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2783":1252,"_24069":1133,"_16893":43233,"_5":16788,"_22829":42916,"_2311":43234},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2783":1253,"_24069":1133,"_16893":43236,"_5":16788,"_22829":42920,"_2311":43237},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2783":1254,"_24069":1133,"_16893":43239,"_5":16788,"_22829":42924,"_2311":43240},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2783":1255,"_24069":1133,"_16893":43242,"_5":16788,"_22829":42924,"_2311":43243},[],"Creates or updates the IoT policies configured in the DMS.",{"_2783":1256,"_24069":1133,"_16893":43245,"_5":16788,"_22829":42924,"_2311":43246},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2783":1257,"_24069":1133,"_16893":43248,"_5":16788,"_22829":42924,"_2311":43249},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2783":1258,"_24069":1133,"_16893":43251,"_5":16788,"_22829":42924,"_2311":43252},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2783":1259,"_24069":1133,"_16893":43254,"_5":16788,"_22829":42924,"_2311":43255},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2783":1260,"_24069":1133,"_16893":43257,"_5":16788,"_22829":42924,"_2311":43258},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2783":1261,"_24069":1133,"_16893":43260,"_5":16788,"_22829":42928,"_2311":43261},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2783":1262,"_24069":1133,"_16893":43263,"_5":16788,"_22829":42928,"_2311":43264},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2783":1263,"_24069":1133,"_16893":43266,"_5":16788,"_22829":42928,"_2311":43267},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2783":1264,"_24069":1133,"_16893":43269,"_5":16788,"_22829":42932,"_2311":43270},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2783":1265,"_24069":1133,"_16893":43272,"_5":16788,"_22829":42932,"_2311":43273},[],"The full flow from the device's perspective is:",{"_2783":1266,"_24069":1133,"_16893":43275,"_5":16788,"_22829":42932,"_2311":43276},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2783":1267,"_24069":1133,"_16893":43278,"_5":16788,"_22829":42936,"_2311":43279},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2783":1268,"_24069":1133,"_16893":43281,"_5":16788,"_22829":42936,"_2311":43282},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2783":1269,"_24069":1133,"_16893":43284,"_5":16788,"_22829":42936,"_2311":43285},[],"For the JITP flow to work correctly:",{"_2783":1270,"_24069":1133,"_16893":43287,"_5":16788,"_22829":42936,"_2311":43288},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2783":1271,"_24069":1133,"_16893":43290,"_5":16788,"_22829":42936,"_2311":43291},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2783":1272,"_24069":1133,"_16893":43293,"_5":16788,"_22829":42936,"_2311":43294},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2783":1273,"_24069":1133,"_16893":43296,"_5":16788,"_22829":42936,"_2311":43297},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2783":1274,"_24069":1133,"_16893":43299,"_5":16788,"_22829":42940,"_2311":43300},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2783":1275,"_24069":1133,"_16893":43302,"_5":16788,"_22829":42940,"_2311":43303},[],"Status in Lamassu",{"_2783":1276,"_24069":1133,"_16893":43305,"_5":16788,"_22829":42940,"_2311":43306},[],"Revocation reason",{"_2783":1277,"_24069":1133,"_16893":43308,"_5":16788,"_22829":42940,"_2311":43309},[],"Status in AWS IoT Core",{"_2783":1278,"_24069":1133,"_16893":43311,"_5":16788,"_22829":42940,"_2311":43312},[],"`Active`",{"_2783":1279,"_24069":1133,"_16893":43314,"_5":16788,"_22829":42940,"_2311":43315},[],"None",{"_2783":1280,"_24069":1133,"_16893":43317,"_5":16788,"_22829":42940,"_2311":43318},[],"`ACTIVE`",{"_2783":1281,"_24069":1133,"_16893":43320,"_5":16788,"_22829":42940,"_2311":43321},[],"`Revoked`",{"_2783":1282,"_24069":1133,"_16893":43323,"_5":16788,"_22829":42940,"_2311":43324},[],"`certificateHold`",{"_2783":1283,"_24069":1133,"_16893":43326,"_5":16788,"_22829":42940,"_2311":43327},[],"`INACTIVE`",{"_2783":1284,"_24069":1133,"_16893":43329,"_5":16788,"_22829":42940,"_2311":43321},[],{"_2783":1285,"_24069":1133,"_16893":43331,"_5":16788,"_22829":42940,"_2311":43332},[],"Any other reason",{"_2783":1286,"_24069":1133,"_16893":43334,"_5":16788,"_22829":42940,"_2311":43335},[],"`REVOKED`",{"_2783":1287,"_24069":1133,"_16893":43337,"_5":16788,"_22829":42940,"_2311":43338},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2783":1288,"_24069":1133,"_16893":43340,"_5":16788,"_22829":42944,"_2311":43341},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2783":1289,"_24069":1133,"_16893":43343,"_5":16788,"_22829":42944,"_2311":43344},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2783":1290,"_24069":1133,"_16893":43346,"_5":16788,"_22829":42944,"_2311":43347},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2783":1291,"_24069":1133,"_16893":43349,"_5":16788,"_22829":42948,"_2311":43350},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2783":1292,"_24069":1133,"_16893":43352,"_5":16788,"_22829":42948,"_2311":43353},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2783":1293,"_24069":1133,"_16893":43355,"_5":16788,"_22829":42952,"_2311":43356},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2783":1294,"_24069":1133,"_16893":43358,"_5":16788,"_22829":42952,"_2311":43359},[],"There are two action types:",{"_2783":1295,"_24069":1133,"_16893":43361,"_5":16788,"_22829":42952,"_2311":43362},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2783":1296,"_24069":1133,"_16893":43364,"_5":16788,"_22829":42952,"_2311":43365},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2783":1297,"_24069":1133,"_16893":43367,"_5":16788,"_22829":42952,"_2311":43368},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2783":1298,"_24069":1133,"_16893":43370,"_5":16788,"_22829":42956,"_2311":43371},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2783":1299,"_24069":1133,"_16893":43373,"_5":16788,"_22829":42956,"_2311":43374},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2783":1300,"_24069":1133,"_16893":43376,"_5":16788,"_22829":42956,"_2311":43377},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2783":1301,"_24069":1133,"_16893":43379,"_5":16788,"_22829":42960,"_2311":43380},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2783":1302,"_24069":1133,"_16893":43382,"_5":16788,"_22829":42960,"_2311":43383},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2783":1303,"_24069":1133,"_16893":43385,"_5":16788,"_22829":42960,"_2311":43386},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2783":1304,"_24069":1133,"_16893":43388,"_5":16788,"_22829":42960,"_2311":43389},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2783":1305,"_24069":1133,"_16893":43391,"_5":16788,"_22829":42960,"_2311":43392},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2783":1306,"_24069":1133,"_16893":43394,"_5":16788,"_22829":42960,"_2311":43395},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2783":1307,"_24069":1133,"_16893":43397,"_5":16788,"_22829":42960,"_2311":43398},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2783":1308,"_24069":1133,"_16893":43400,"_5":16788,"_22829":42960,"_2311":43401},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2783":1309,"_24069":1133,"_16893":43403,"_5":16788,"_22829":42960,"_2311":43404},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2783":1310,"_24069":1133,"_16893":43406,"_5":16788,"_22829":42960,"_2311":43407},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2783":1311,"_24069":1133,"_16893":43409,"_5":16788,"_22829":42960,"_2311":43410},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2783":1312,"_24069":1133,"_16893":43412,"_5":16788,"_22829":42960,"_2311":43413},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2783":1313,"_24069":1133,"_16893":43415,"_5":16788,"_22829":42960,"_2311":43416},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2783":1314,"_24069":1133,"_16893":43418,"_5":16788,"_22829":42960,"_2311":43419},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2783":1315,"_24069":1133,"_16893":43421,"_5":16788,"_22829":42960,"_2311":43422},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2783":1316,"_24069":1133,"_16893":43424,"_5":16788,"_22829":42960,"_2311":43425},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2783":1317,"_24069":1133,"_16893":43427,"_5":16788,"_22829":42960,"_2311":43428},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2783":1318,"_24069":1133,"_16893":43430,"_5":16788,"_22829":42960,"_2311":43431},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2783":1319,"_24069":1133,"_16893":43433,"_5":16788,"_22829":42960,"_2311":43434},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":1320,"_24069":1133,"_16893":43436,"_5":16788,"_22829":42960,"_2311":43437},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2783":1321,"_24069":1133,"_16893":43439,"_5":16788,"_22829":42960,"_2311":43440},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2783":1322,"_24069":1322,"_5":11891,"_2311":41556,"_24405":43442,"_16893":43443,"_22829":1322},[39337,40681,41556],[],{"_2783":1323,"_24069":1322,"_16893":43445,"_5":16788,"_22829":1322,"_2311":43446},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2783":1324,"_24069":1322,"_5":24402,"_16893":43448,"_22829":43449,"_2311":43450},[],"/docs/pr-preview/pr-27/platform/iot-fleets/overview#start-here","Start here",{"_2783":1325,"_24069":1322,"_5":24402,"_16893":43452,"_22829":43453,"_2311":41554},[],"/docs/pr-preview/pr-27/platform/iot-fleets/overview#devices-and-identities",{"_2783":1326,"_24069":1322,"_5":24402,"_16893":43455,"_22829":43456,"_2311":41737},[],"/docs/pr-preview/pr-27/platform/iot-fleets/overview#enrollment-with-pki",{"_2783":1327,"_24069":1322,"_5":24402,"_16893":43458,"_22829":43459,"_2311":42877},[],"/docs/pr-preview/pr-27/platform/iot-fleets/overview#integrations",{"_2783":1328,"_24069":1322,"_5":24402,"_16893":43461,"_22829":43462,"_2311":43463},[],"/docs/pr-preview/pr-27/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2783":1329,"_24069":1322,"_16893":43465,"_5":16788,"_22829":1322,"_2311":43466},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2783":1330,"_24069":1322,"_16893":43468,"_5":16788,"_22829":43449,"_2311":43469},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2783":1331,"_24069":1322,"_16893":43471,"_5":16788,"_22829":43449,"_2311":43472},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2783":1332,"_24069":1322,"_16893":43474,"_5":16788,"_22829":43453,"_2311":43475},[],"Resource",{"_2783":1333,"_24069":1322,"_16893":43477,"_5":16788,"_22829":43453,"_2311":43478},[],"What it represents",{"_2783":1334,"_24069":1322,"_16893":43480,"_5":16788,"_22829":43453,"_2311":43481},[],"**Device**",{"_2783":1335,"_24069":1322,"_16893":43483,"_5":16788,"_22829":43453,"_2311":43484},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2783":1336,"_24069":1322,"_16893":43486,"_5":16788,"_22829":43453,"_2311":43487},[],"**Identity**",{"_2783":1337,"_24069":1322,"_16893":43489,"_5":16788,"_22829":43453,"_2311":43490},[],"The device's association with its certificates: an active version and a history.",{"_2783":1338,"_24069":1322,"_16893":43492,"_5":16788,"_22829":43453,"_2311":43493},[],"**DMS**",{"_2783":1339,"_24069":1322,"_16893":43495,"_5":16788,"_22829":43453,"_2311":43496},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2783":1340,"_24069":1322,"_16893":43498,"_5":16788,"_22829":43453,"_2311":43499},[],"**Fleet**",{"_2783":1341,"_24069":1322,"_16893":43501,"_5":16788,"_22829":43453,"_2311":43502},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2783":1342,"_24069":1322,"_16893":43504,"_5":16788,"_22829":43453,"_2311":43505},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2783":1343,"_24069":1322,"_16893":43507,"_5":16788,"_22829":43453,"_2311":43508},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2783":1344,"_24069":1322,"_16893":43510,"_5":16788,"_22829":43456,"_2311":43511},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2783":1345,"_24069":1322,"_16893":43513,"_5":16788,"_22829":43456,"_2311":43514},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2783":1346,"_24069":1322,"_16893":43516,"_5":16788,"_22829":43456,"_2311":43517},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2783":1347,"_24069":1322,"_16893":43519,"_5":16788,"_22829":43456,"_2311":43520},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2783":1348,"_24069":1322,"_16893":43522,"_5":16788,"_22829":43456,"_2311":43523},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2783":1349,"_24069":1322,"_16893":43525,"_5":16788,"_22829":43456,"_2311":43526},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2783":1350,"_24069":1322,"_16893":43528,"_5":16788,"_22829":43456,"_2311":43529},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":1351,"_24069":1322,"_16893":43531,"_5":16788,"_22829":43456,"_2311":43532},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2783":1352,"_24069":1322,"_16893":43534,"_5":16788,"_22829":43459,"_2311":43535},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2783":1353,"_24069":1322,"_16893":43537,"_5":16788,"_22829":43459,"_2311":43538},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2783":1354,"_24069":1322,"_16893":43540,"_5":16788,"_22829":43462,"_2311":43541},[],"Participant",{"_2783":1355,"_24069":1322,"_16893":43543,"_5":16788,"_22829":43462,"_2311":43544},[],"Responsibility",{"_2783":1356,"_24069":1322,"_16893":43546,"_5":16788,"_22829":43462,"_2311":43547},[],"PKI administrator",{"_2783":1357,"_24069":1322,"_16893":43549,"_5":16788,"_22829":43462,"_2311":43550},[],"CA, issuance profile, chain and revocation publication.",{"_2783":1358,"_24069":1322,"_16893":43552,"_5":16788,"_22829":43462,"_2311":43553},[],"Provisioning administrator",{"_2783":1359,"_24069":1322,"_16893":43555,"_5":16788,"_22829":43462,"_2311":43556},[],"DMS, admission, authentication per operation and inventory.",{"_2783":1360,"_24069":1322,"_16893":43558,"_5":16788,"_22829":43462,"_2311":43559},[],"Device integrator",{"_2783":1361,"_24069":1322,"_16893":43561,"_5":16788,"_22829":43462,"_2311":43562},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2783":1362,"_24069":1322,"_16893":43564,"_5":16788,"_22829":43462,"_2311":43565},[],"Consumer integrator",{"_2783":1363,"_24069":1322,"_16893":43567,"_5":16788,"_22829":43462,"_2311":43568},[],"Trusted issuers, validation and device permissions in the destination.",{"_2783":1364,"_24069":1322,"_16893":43570,"_5":16788,"_22829":43462,"_2311":43571},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2783":1365,"_24069":1365,"_5":11891,"_2311":43573,"_24405":43574,"_16893":43576,"_22829":1365},"Enroll and connect your first device",[39337,40681,41556,43575],"Getting started",[],{"_2783":1366,"_24069":1365,"_16893":43578,"_5":16788,"_22829":1365,"_2311":43579},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2783":1367,"_24069":1365,"_5":24402,"_16893":43581,"_22829":43582,"_2311":39347},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2783":1368,"_24069":1365,"_5":24402,"_16893":43584,"_22829":43585,"_2311":43586},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2783":1369,"_24069":1365,"_5":24402,"_16893":43588,"_22829":43589,"_2311":43590},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2783":1370,"_24069":1365,"_5":24402,"_16893":43592,"_22829":43593,"_2311":43594},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2783":1371,"_24069":1365,"_5":24402,"_16893":43596,"_22829":43597,"_2311":43598},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2783":1372,"_24069":1365,"_5":24402,"_16893":43600,"_22829":43601,"_2311":43602},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2783":1373,"_24069":1365,"_5":24402,"_16893":43604,"_22829":43605,"_2311":43606},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2783":1374,"_24069":1365,"_5":24402,"_16893":43608,"_22829":43609,"_2311":43610},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2783":1375,"_24069":1365,"_16893":43612,"_5":16788,"_22829":1365,"_2311":43613},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2783":1376,"_24069":1365,"_16893":43615,"_5":16788,"_22829":43582,"_2311":43616},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2783":1377,"_24069":1365,"_16893":43618,"_5":16788,"_22829":43582,"_2311":43619},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2783":1378,"_24069":1365,"_16893":43621,"_5":16788,"_22829":43582,"_2311":43622},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2783":1379,"_24069":1365,"_16893":43624,"_5":16788,"_22829":43582,"_2311":43625},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2783":1380,"_24069":1365,"_16893":43627,"_5":16788,"_22829":43582,"_2311":43628},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2783":1381,"_24069":1365,"_16893":43630,"_5":16788,"_22829":43585,"_2311":43631},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2783":1382,"_24069":1365,"_16893":43633,"_5":16788,"_22829":43585,"_2311":43634},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2783":1383,"_24069":1365,"_16893":43636,"_5":16788,"_22829":43589,"_2311":43637},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2783":1384,"_24069":1365,"_16893":43639,"_5":16788,"_22829":43589,"_2311":43640},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2783":1385,"_24069":1365,"_16893":43642,"_5":16788,"_22829":43589,"_2311":43643},[],"Setting",{"_2783":1386,"_24069":1365,"_16893":43645,"_5":16788,"_22829":43589,"_2311":43646},[],"Evaluation value",{"_2783":1387,"_24069":1365,"_16893":43648,"_5":16788,"_22829":43589,"_2311":43649},[],"Enrollment CA",{"_2783":1388,"_24069":1365,"_16893":43651,"_5":16788,"_22829":43589,"_2311":43652},[],"Issuing root from `device-root.pem`.",{"_2783":1389,"_24069":1365,"_16893":43654,"_5":16788,"_22829":43589,"_2311":41863},[],{"_2783":1390,"_24069":1365,"_16893":43656,"_5":16788,"_22829":43589,"_2311":43657},[],"The 1-hour leaf profile you just prepared.",{"_2783":1391,"_24069":1365,"_16893":43659,"_5":16788,"_22829":43589,"_2311":43660},[],"Protocol / Registration Mode",{"_2783":1392,"_24069":1365,"_16893":43662,"_5":16788,"_22829":43589,"_2311":43663},[],"`EST_RFC7030` / `JITP`.",{"_2783":1393,"_24069":1365,"_16893":43665,"_5":16788,"_22829":43589,"_2311":43666},[],"Verify CSR Signature",{"_2783":1394,"_24069":1365,"_16893":43668,"_5":16788,"_22829":43589,"_2311":43669},[],"Enabled.",{"_2783":1395,"_24069":1365,"_16893":43671,"_5":16788,"_22829":43589,"_2311":43672},[],"Enable Replaceable Enrollment",{"_2783":1396,"_24069":1365,"_16893":43674,"_5":16788,"_22829":43589,"_2311":43675},[],"Disabled; the ID must be new.",{"_2783":1397,"_24069":1365,"_16893":43677,"_5":16788,"_22829":43589,"_2311":43678},[],"Initial authentication",{"_2783":1398,"_24069":1365,"_16893":43680,"_5":16788,"_22829":43589,"_2311":43681},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2783":1399,"_24069":1365,"_16893":43683,"_5":16788,"_22829":43589,"_2311":43684},[],"Renewal authentication",{"_2783":1400,"_24069":1365,"_16893":43686,"_5":16788,"_22829":43589,"_2311":43687},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2783":1401,"_24069":1365,"_16893":43689,"_5":16788,"_22829":43589,"_2311":43690},[],"Additional Validation CAs / Enable Expired Renewal",{"_2783":1402,"_24069":1365,"_16893":43692,"_5":16788,"_22829":43589,"_2311":43693},[],"Empty list for this direct issuance / disabled.",{"_2783":1403,"_24069":1365,"_16893":43695,"_5":16788,"_22829":43589,"_2311":43696},[],"Re-enrollment Delta",{"_2783":1404,"_24069":1365,"_16893":43698,"_5":16788,"_22829":43589,"_2311":43699},[],"1 hour.",{"_2783":1405,"_24069":1365,"_16893":43701,"_5":16788,"_22829":43589,"_2311":43702},[],"Preventive / Critical Delta",{"_2783":1406,"_24069":1365,"_16893":43704,"_5":16788,"_22829":43589,"_2311":43705},[],"30 minutes / 10 minutes.",{"_2783":1407,"_24069":1365,"_16893":43707,"_5":16788,"_22829":43589,"_2311":43708},[],"Revoke on Re-enrollment",{"_2783":1408,"_24069":1365,"_16893":43710,"_5":16788,"_22829":43589,"_2311":43711},[],"Disabled to test the successor before retiring the previous identity.",{"_2783":1409,"_24069":1365,"_16893":43713,"_5":16788,"_22829":43589,"_2311":41871},[],{"_2783":1410,"_24069":1365,"_16893":43715,"_5":16788,"_22829":43589,"_2311":43716},[],"Disabled; the operational key is generated in the client.",{"_2783":1411,"_24069":1365,"_16893":43718,"_5":16788,"_22829":43589,"_2311":43719},[],"CA Distribution",{"_2783":1412,"_24069":1365,"_16893":43721,"_5":16788,"_22829":43589,"_2311":43722},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2783":1413,"_24069":1365,"_16893":43724,"_5":16788,"_22829":43589,"_2311":43725},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2783":1414,"_24069":1365,"_16893":43727,"_5":16788,"_22829":43593,"_2311":43728},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2783":1415,"_24069":1365,"_16893":43730,"_5":16788,"_22829":43593,"_2311":43731},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2783":1416,"_24069":1365,"_16893":43733,"_5":16788,"_22829":43597,"_2311":43734},[],"Generate a new key and CSR with the selected identifier:",{"_2783":1417,"_24069":1365,"_16893":43736,"_5":16788,"_22829":43597,"_2311":43737},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2783":1418,"_24069":1365,"_16893":43739,"_5":16788,"_22829":43597,"_2311":43740},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2783":1419,"_24069":1365,"_16893":43742,"_5":16788,"_22829":43601,"_2311":43743},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2783":1420,"_24069":1365,"_16893":43745,"_5":16788,"_22829":43601,"_2311":43746},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2783":1421,"_24069":1365,"_16893":43748,"_5":16788,"_22829":43605,"_2311":43749},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2783":1422,"_24069":1365,"_16893":43751,"_5":16788,"_22829":43605,"_2311":43752},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2783":1423,"_24069":1365,"_16893":43754,"_5":16788,"_22829":43605,"_2311":43755},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2783":1424,"_24069":1365,"_16893":43757,"_5":16788,"_22829":43605,"_2311":43758},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2783":1425,"_24069":1365,"_16893":43760,"_5":16788,"_22829":43605,"_2311":43761},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2783":1426,"_24069":1365,"_16893":43763,"_5":16788,"_22829":43609,"_2311":43764},[],"Check",{"_2783":1427,"_24069":1365,"_16893":43766,"_5":16788,"_22829":43609,"_2311":43767},[],"Expected result",{"_2783":1428,"_24069":1365,"_16893":43769,"_5":16788,"_22829":43609,"_2311":43770},[],"Registration",{"_2783":1429,"_24069":1365,"_16893":43772,"_5":16788,"_22829":43609,"_2311":43773},[],"ID created automatically and correct DMS.",{"_2783":1430,"_24069":1365,"_16893":43775,"_5":16788,"_22829":43609,"_2311":43776},[],"Certificate",{"_2783":1431,"_24069":1365,"_16893":43778,"_5":16788,"_22829":43609,"_2311":43779},[],"CN, profile, serial and key verified.",{"_2783":1432,"_24069":1365,"_16893":43781,"_5":16788,"_22829":43609,"_2311":43782},[],"Inventory",{"_2783":1433,"_24069":1365,"_16893":43784,"_5":16788,"_22829":43609,"_2311":43785},[],"Received serial visible as the current identity and in history.",{"_2783":1434,"_24069":1365,"_16893":43787,"_5":16788,"_22829":43609,"_2311":43788},[],"Consumer",{"_2783":1435,"_24069":1365,"_16893":43790,"_5":16788,"_22829":43609,"_2311":43791},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2783":1436,"_24069":1365,"_16893":43793,"_5":16788,"_22829":43609,"_2311":43794},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2783":1437,"_24069":1365,"_16893":43796,"_5":16788,"_22829":43609,"_2311":43797},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2783":1438,"_24069":1438,"_5":11891,"_2311":41572,"_24405":43799,"_16893":43800,"_22829":1438},[39337,40681,41556,43575],[],{"_2783":1439,"_24069":1438,"_16893":43802,"_5":16788,"_22829":1438,"_2311":43803},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2783":1440,"_24069":1438,"_5":24402,"_16893":43805,"_22829":43806,"_2311":39347},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2783":1441,"_24069":1438,"_5":24402,"_16893":43808,"_22829":43809,"_2311":43810},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2783":1442,"_24069":1438,"_5":24402,"_16893":43812,"_22829":43813,"_2311":43814},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2783":1443,"_24069":1438,"_5":24402,"_16893":43816,"_22829":43817,"_2311":43818},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2783":1444,"_24069":1438,"_5":24402,"_16893":43820,"_22829":43821,"_2311":43822},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2783":1445,"_24069":1438,"_5":24402,"_16893":43824,"_22829":43825,"_2311":43826},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2783":1446,"_24069":1438,"_5":24402,"_16893":43828,"_22829":43829,"_2311":43767},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2783":1447,"_24069":1438,"_5":24402,"_16893":43831,"_22829":43832,"_2311":43833},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2783":1448,"_24069":1438,"_5":24402,"_16893":43835,"_22829":43836,"_2311":43837},[],"/docs/pr-preview/pr-27/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2783":1449,"_24069":1438,"_16893":43839,"_5":16788,"_22829":1438,"_2311":43840},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2783":1450,"_24069":1438,"_16893":43842,"_5":16788,"_22829":1438,"_2311":43843},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2783":1451,"_24069":1438,"_16893":43845,"_5":16788,"_22829":43806,"_2311":43846},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2783":1452,"_24069":1438,"_16893":43848,"_5":16788,"_22829":43806,"_2311":43849},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2783":1453,"_24069":1438,"_16893":43851,"_5":16788,"_22829":43806,"_2311":43852},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2783":1454,"_24069":1438,"_16893":43854,"_5":16788,"_22829":43806,"_2311":43855},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2783":1455,"_24069":1438,"_16893":43857,"_5":16788,"_22829":43809,"_2311":43858},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2783":1456,"_24069":1438,"_16893":43860,"_5":16788,"_22829":43809,"_2311":43861},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2783":1457,"_24069":1438,"_16893":43863,"_5":16788,"_22829":43809,"_2311":43864},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2783":1458,"_24069":1438,"_16893":43866,"_5":16788,"_22829":43809,"_2311":43867},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2783":1459,"_24069":1438,"_16893":43869,"_5":16788,"_22829":43809,"_2311":43870},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2783":1460,"_24069":1438,"_16893":43872,"_5":16788,"_22829":43809,"_2311":43873},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2783":1461,"_24069":1438,"_16893":43875,"_5":16788,"_22829":43809,"_2311":43876},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2783":1462,"_24069":1438,"_16893":43878,"_5":16788,"_22829":43809,"_2311":43879},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2783":1463,"_24069":1438,"_16893":43881,"_5":16788,"_22829":43813,"_2311":43882},[],"Open **Managed Devices** and the registration action. Complete:",{"_2783":1464,"_24069":1438,"_16893":43884,"_5":16788,"_22829":43813,"_2311":43885},[],"**Device ID**: `device-001`.",{"_2783":1465,"_24069":1438,"_16893":43887,"_5":16788,"_22829":43813,"_2311":43888},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2783":1466,"_24069":1438,"_16893":43890,"_5":16788,"_22829":43813,"_2311":43891},[],"**Icon** and **Tags**: optional classification.",{"_2783":1467,"_24069":1438,"_16893":43893,"_5":16788,"_22829":43813,"_2311":43894},[],"Confirm registration.",{"_2783":1468,"_24069":1438,"_16893":43896,"_5":16788,"_22829":43817,"_2311":43897},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2783":1469,"_24069":1438,"_16893":43899,"_5":16788,"_22829":43817,"_2311":43900},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2783":1470,"_24069":1438,"_16893":43902,"_5":16788,"_22829":43821,"_2311":43903},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2783":1471,"_24069":1438,"_16893":43905,"_5":16788,"_22829":43821,"_2311":43906},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2783":1472,"_24069":1438,"_16893":43908,"_5":16788,"_22829":43825,"_2311":43909},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2783":1473,"_24069":1438,"_16893":43911,"_5":16788,"_22829":43825,"_2311":43912},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2783":1474,"_24069":1438,"_16893":43914,"_5":16788,"_22829":43829,"_2311":43764},[],{"_2783":1475,"_24069":1438,"_16893":43916,"_5":16788,"_22829":43829,"_2311":43917},[],"Result",{"_2783":1476,"_24069":1438,"_16893":43919,"_5":16788,"_22829":43829,"_2311":43920},[],"Device",{"_2783":1477,"_24069":1438,"_16893":43922,"_5":16788,"_22829":43829,"_2311":43923},[],"`device-001` appears in inventory with the expected DMS.",{"_2783":1478,"_24069":1438,"_16893":43925,"_5":16788,"_22829":43829,"_2311":43926},[],"Current identity",{"_2783":1479,"_24069":1438,"_16893":43928,"_5":16788,"_22829":43829,"_2311":43929},[],"The associated certificate matches the one you verified in PKI.",{"_2783":1480,"_24069":1438,"_16893":43931,"_5":16788,"_22829":43829,"_2311":43932},[],"History",{"_2783":1481,"_24069":1438,"_16893":43934,"_5":16788,"_22829":43829,"_2311":43935},[],"The associated issuance appears with its serial number and dates.",{"_2783":1482,"_24069":1438,"_16893":43937,"_5":16788,"_22829":43829,"_2311":43938},[],"Key and certificate",{"_2783":1483,"_24069":1438,"_16893":43940,"_5":16788,"_22829":43829,"_2311":43941},[],"You have the verified pair ready to install on the device.",{"_2783":1484,"_24069":1438,"_16893":43943,"_5":16788,"_22829":43832,"_2311":43944},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2783":1485,"_24069":1438,"_16893":43946,"_5":16788,"_22829":43832,"_2311":43947},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2783":1486,"_24069":1438,"_16893":43949,"_5":16788,"_22829":43832,"_2311":43950},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2783":1487,"_24069":1438,"_16893":43952,"_5":16788,"_22829":43832,"_2311":43953},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2783":1488,"_24069":1438,"_16893":43955,"_5":16788,"_22829":43836,"_2311":43956},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2783":1489,"_24069":1438,"_16893":43958,"_5":16788,"_22829":43836,"_2311":43959},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2783":1490,"_24069":1438,"_16893":43961,"_5":16788,"_22829":43836,"_2311":43962},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2783":1491,"_24069":1491,"_5":11891,"_2311":43964,"_24405":43965,"_16893":43966,"_22829":1491},"Lamassu IoT Platform",[39337,40681],[],{"_2783":1492,"_24069":1491,"_16893":43968,"_5":16788,"_22829":1491,"_2311":43969},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2783":1493,"_24069":1491,"_5":24402,"_16893":43971,"_22829":43972,"_2311":43450},[],"/docs/pr-preview/pr-27/platform/overview#start-here",{"_2783":1494,"_24069":1491,"_5":24402,"_16893":43974,"_22829":43975,"_2311":43976},[],"/docs/pr-preview/pr-27/platform/overview#choose-your-path","Choose your path",{"_2783":1495,"_24069":1491,"_5":24402,"_16893":43978,"_22829":43979,"_2311":43980},[],"/docs/pr-preview/pr-27/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2783":1496,"_24069":1491,"_5":24402,"_16893":43982,"_22829":43983,"_2311":43984},[],"/docs/pr-preview/pr-27/platform/overview#core-capabilities","Core capabilities",{"_2783":1497,"_24069":1491,"_5":24402,"_16893":43986,"_22829":43987,"_2311":43988},[],"/docs/pr-preview/pr-27/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2783":1498,"_24069":1491,"_5":24402,"_16893":43990,"_22829":43991,"_2311":43992},[],"/docs/pr-preview/pr-27/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2783":1499,"_24069":1491,"_5":24402,"_16893":43994,"_22829":43995,"_2311":43996},[],"/docs/pr-preview/pr-27/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2783":1500,"_24069":1491,"_5":24402,"_16893":43998,"_22829":43999,"_2311":44000},[],"/docs/pr-preview/pr-27/platform/overview#automate-device-identities","Automate device identities",{"_2783":1501,"_24069":1491,"_5":24402,"_16893":44002,"_22829":44003,"_2311":44004},[],"/docs/pr-preview/pr-27/platform/overview#publish-validation-status","Publish validation status",{"_2783":1502,"_24069":1491,"_5":24402,"_16893":44006,"_22829":44007,"_2311":44008},[],"/docs/pr-preview/pr-27/platform/overview#react-to-events","React to events",{"_2783":1503,"_24069":1491,"_5":24402,"_16893":44010,"_22829":44011,"_2311":44012},[],"/docs/pr-preview/pr-27/platform/overview#operational-reference","Operational reference",{"_2783":1504,"_24069":1491,"_16893":44014,"_5":16788,"_22829":1491,"_2311":44015},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2783":1505,"_24069":1491,"_16893":44017,"_5":16788,"_22829":43972,"_2311":44018},[],"Choose the result you need:",{"_2783":1506,"_24069":1491,"_16893":44020,"_5":16788,"_22829":43972,"_2311":44021},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2783":1507,"_24069":1491,"_16893":44023,"_5":16788,"_22829":43972,"_2311":44024},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2783":1508,"_24069":1491,"_16893":44026,"_5":16788,"_22829":43972,"_2311":44027},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2783":1509,"_24069":1491,"_16893":44029,"_5":16788,"_22829":43975,"_2311":44030},[],"Section",{"_2783":1510,"_24069":1491,"_16893":44032,"_5":16788,"_22829":43975,"_2311":44033},[],"What you manage",{"_2783":1511,"_24069":1491,"_16893":44035,"_5":16788,"_22829":43975,"_2311":44036},[],"Entry point",{"_2783":1512,"_24069":1491,"_16893":44038,"_5":16788,"_22829":43975,"_2311":44039},[],"**PKI**",{"_2783":1513,"_24069":1491,"_16893":44041,"_5":16788,"_22829":43975,"_2311":44042},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2783":1514,"_24069":1491,"_16893":44044,"_5":16788,"_22829":43975,"_2311":44045},[],"PKI overview",{"_2783":1515,"_24069":1491,"_16893":44047,"_5":16788,"_22829":43975,"_2311":44048},[],"**IoT Fleets**",{"_2783":1516,"_24069":1491,"_16893":44050,"_5":16788,"_22829":43975,"_2311":44051},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2783":1517,"_24069":1491,"_16893":44053,"_5":16788,"_22829":43975,"_2311":44054},[],"IoT Fleets overview",{"_2783":1518,"_24069":1491,"_16893":44056,"_5":16788,"_22829":43975,"_2311":44057},[],"**Administration**",{"_2783":1519,"_24069":1491,"_16893":44059,"_5":16788,"_22829":43975,"_2311":44060},[],"Operator permissions, audit and event subscriptions.",{"_2783":1520,"_24069":1491,"_16893":44062,"_5":16788,"_22829":43975,"_2311":40679},[],{"_2783":1521,"_24069":1491,"_16893":44064,"_5":16788,"_22829":43975,"_2311":44065},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2783":1522,"_24069":1491,"_16893":44067,"_5":16788,"_22829":43979,"_2311":44068},[],"An identity's journey connects four responsibilities:",{"_2783":1523,"_24069":1491,"_16893":44070,"_5":16788,"_22829":43979,"_2311":44071},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2783":1524,"_24069":1491,"_16893":44073,"_5":16788,"_22829":43979,"_2311":44074},[],"The provisioning administrator configures the DMS and initial trust.",{"_2783":1525,"_24069":1491,"_16893":44076,"_5":16788,"_22829":43979,"_2311":44077},[],"The device client requests a certificate and installs it with the matching key.",{"_2783":1526,"_24069":1491,"_16893":44079,"_5":16788,"_22829":43979,"_2311":44080},[],"The consumer validates the identity and applies its access permissions.",{"_2783":1527,"_24069":1491,"_16893":44082,"_5":16788,"_22829":43979,"_2311":44083},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2783":1528,"_24069":1491,"_16893":44085,"_5":16788,"_22829":43987,"_2311":44086},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2783":1529,"_24069":1491,"_16893":44088,"_5":16788,"_22829":43991,"_2311":44089},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2783":1530,"_24069":1491,"_16893":44091,"_5":16788,"_22829":43995,"_2311":44092},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2783":1531,"_24069":1491,"_16893":44094,"_5":16788,"_22829":43999,"_2311":44095},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2783":1532,"_24069":1491,"_16893":44097,"_5":16788,"_22829":44003,"_2311":44098},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2783":1533,"_24069":1491,"_16893":44100,"_5":16788,"_22829":44007,"_2311":44101},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2783":1534,"_24069":1491,"_16893":44103,"_5":16788,"_22829":44011,"_2311":43544},[],{"_2783":1535,"_24069":1491,"_16893":44105,"_5":16788,"_22829":44011,"_2311":44106},[],"What it prepares or checks",{"_2783":1536,"_24069":1491,"_16893":44108,"_5":16788,"_22829":44011,"_2311":43547},[],{"_2783":1537,"_24069":1491,"_16893":44110,"_5":16788,"_22829":44011,"_2311":44111},[],"Key custody, CA hierarchy, profiles and validation.",{"_2783":1538,"_24069":1491,"_16893":44113,"_5":16788,"_22829":44011,"_2311":44114},[],"Fleet administrator",{"_2783":1539,"_24069":1491,"_16893":44116,"_5":16788,"_22829":44011,"_2311":44117},[],"DMS, device admission, renewal policy and inventory.",{"_2783":1540,"_24069":1491,"_16893":44119,"_5":16788,"_22829":44011,"_2311":43559},[],{"_2783":1541,"_24069":1491,"_16893":44121,"_5":16788,"_22829":44011,"_2311":44122},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2783":1542,"_24069":1491,"_16893":44124,"_5":16788,"_22829":44011,"_2311":43565},[],{"_2783":1543,"_24069":1491,"_16893":44126,"_5":16788,"_22829":44011,"_2311":44127},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2783":1544,"_24069":1491,"_16893":44129,"_5":16788,"_22829":44011,"_2311":44130},[],"Infrastructure operator",{"_2783":1545,"_24069":1491,"_16893":44132,"_5":16788,"_22829":44011,"_2311":44133},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2783":1546,"_24069":1491,"_16893":44135,"_5":16788,"_22829":44011,"_2311":44136},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2783":1547,"_24069":1547,"_5":11891,"_2311":44138,"_24405":44139,"_16893":44142,"_22829":1547},"CA hierarchy and rotation",[39337,40681,44140,44141],"PKI","Keys, authorities and certificates",[],{"_2783":1548,"_24069":1547,"_16893":44144,"_5":16788,"_22829":1547,"_2311":44145},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2783":1549,"_24069":1547,"_5":24402,"_16893":44147,"_22829":44148,"_2311":44149},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2783":1550,"_24069":1547,"_5":24402,"_16893":44151,"_22829":44152,"_2311":44153},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2783":1551,"_24069":1547,"_5":24402,"_16893":44155,"_22829":44156,"_2311":44157},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2783":1552,"_24069":1547,"_5":24402,"_16893":44159,"_22829":44160,"_2311":44161},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2783":1553,"_24069":1547,"_5":24402,"_16893":44163,"_22829":44164,"_2311":44165},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2783":1554,"_24069":1547,"_5":24402,"_16893":44167,"_22829":44168,"_2311":44169},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2783":1555,"_24069":1547,"_5":24402,"_16893":44171,"_22829":44172,"_2311":44173},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2783":1556,"_24069":1547,"_5":24402,"_16893":44175,"_22829":44176,"_2311":44177},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2783":1557,"_24069":1547,"_5":24402,"_16893":44179,"_22829":44180,"_2311":44181},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2783":1558,"_24069":1547,"_5":24402,"_16893":44183,"_22829":44184,"_2311":44185},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2783":1559,"_24069":1547,"_5":24402,"_16893":44187,"_22829":44188,"_2311":44189},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2783":1560,"_24069":1547,"_5":24402,"_16893":44191,"_22829":44192,"_2311":44193},[],"/docs/pr-preview/pr-27/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2783":1561,"_24069":1547,"_16893":44195,"_5":16788,"_22829":1547,"_2311":44196},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2783":1562,"_24069":1547,"_16893":44198,"_5":16788,"_22829":1547,"_2311":44199},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2783":1563,"_24069":1547,"_16893":44201,"_5":16788,"_22829":44148,"_2311":44202},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2783":1564,"_24069":1547,"_16893":44204,"_5":16788,"_22829":44148,"_2311":44205},[],"environment, such as production and preproduction;",{"_2783":1565,"_24069":1547,"_16893":44207,"_5":16788,"_22829":44148,"_2311":44208},[],"owner or operating team;",{"_2783":1566,"_24069":1547,"_16893":44210,"_5":16788,"_22829":44148,"_2311":44211},[],"device family or manufacturing process;",{"_2783":1567,"_24069":1547,"_16893":44213,"_5":16788,"_22829":44148,"_2311":44214},[],"region or regulatory requirement;",{"_2783":1568,"_24069":1547,"_16893":44216,"_5":16788,"_22829":44148,"_2311":44217},[],"cryptographic engine or key policy;",{"_2783":1569,"_24069":1547,"_16893":44219,"_5":16788,"_22829":44148,"_2311":44220},[],"maintenance window and renewal cadence.",{"_2783":1570,"_24069":1547,"_16893":44222,"_5":16788,"_22829":44148,"_2311":44223},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2783":1571,"_24069":1547,"_16893":44225,"_5":16788,"_22829":44148,"_2311":44226},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2783":1572,"_24069":1547,"_16893":44228,"_5":16788,"_22829":44152,"_2311":44229},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2783":1573,"_24069":1547,"_16893":44231,"_5":16788,"_22829":44152,"_2311":44232},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2783":1574,"_24069":1547,"_16893":44234,"_5":16788,"_22829":44152,"_2311":44235},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2783":1575,"_24069":1547,"_16893":44237,"_5":16788,"_22829":44156,"_2311":44238},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2783":1576,"_24069":1547,"_16893":44240,"_5":16788,"_22829":44156,"_2311":44241},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2783":1577,"_24069":1547,"_16893":44243,"_5":16788,"_22829":44156,"_2311":44244},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2783":1578,"_24069":1547,"_16893":44246,"_5":16788,"_22829":44156,"_2311":44247},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2783":1579,"_24069":1547,"_16893":44249,"_5":16788,"_22829":44164,"_2311":44250},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2783":1580,"_24069":1547,"_16893":44252,"_5":16788,"_22829":44168,"_2311":44253},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2783":1581,"_24069":1547,"_16893":44255,"_5":16788,"_22829":44172,"_2311":44256},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2783":1582,"_24069":1547,"_16893":44258,"_5":16788,"_22829":44176,"_2311":44259},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2783":1583,"_24069":1547,"_16893":44261,"_5":16788,"_22829":44180,"_2311":44262},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2783":1584,"_24069":1547,"_16893":44264,"_5":16788,"_22829":44184,"_2311":44265},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2783":1585,"_24069":1547,"_16893":44267,"_5":16788,"_22829":44188,"_2311":44268},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2783":1586,"_24069":1547,"_16893":44270,"_5":16788,"_22829":44188,"_2311":44271},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2783":1587,"_24069":1547,"_16893":44273,"_5":16788,"_22829":44188,"_2311":44274},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2783":1588,"_24069":1547,"_16893":44276,"_5":16788,"_22829":44188,"_2311":44277},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2783":1589,"_24069":1547,"_16893":44279,"_5":16788,"_22829":44192,"_2311":44280},[],"The new chain ends in an anchor installed by the consumer.",{"_2783":1590,"_24069":1547,"_16893":44282,"_5":16788,"_22829":44192,"_2311":44283},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2783":1591,"_24069":1547,"_16893":44285,"_5":16788,"_22829":44192,"_2311":44286},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2783":1592,"_24069":1547,"_16893":44288,"_5":16788,"_22829":44192,"_2311":44289},[],"Re-enrollment accepts the old identity during the planned period.",{"_2783":1593,"_24069":1547,"_16893":44291,"_5":16788,"_22829":44192,"_2311":44292},[],"OCSP and CRL respond for the authorities that remain active.",{"_2783":1594,"_24069":1547,"_16893":44294,"_5":16788,"_22829":44192,"_2311":44295},[],"No DMS is left accidentally issuing from the old CA.",{"_2783":1595,"_24069":1547,"_16893":44297,"_5":16788,"_22829":44192,"_2311":44298},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2783":1596,"_24069":1596,"_5":11891,"_2311":44300,"_24405":44301,"_16893":44302,"_22829":1596},"Certification authorities",[39337,40681,44140,44141],[],{"_2783":1597,"_24069":1596,"_16893":44304,"_5":16788,"_22829":1596,"_2311":44305},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2783":1598,"_24069":1596,"_5":24402,"_16893":44307,"_22829":44308,"_2311":44309},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2783":1599,"_24069":1596,"_5":24402,"_16893":44311,"_22829":44312,"_2311":44313},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2783":1600,"_24069":1596,"_5":24402,"_16893":44315,"_22829":44316,"_2311":39347},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#before-you-begin",{"_2783":1601,"_24069":1596,"_5":24402,"_16893":44318,"_22829":44319,"_2311":44320},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2783":1602,"_24069":1596,"_5":24402,"_16893":44322,"_22829":44323,"_2311":44324},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2783":1603,"_24069":1596,"_5":24402,"_16893":44326,"_22829":44327,"_2311":44328},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2783":1604,"_24069":1596,"_5":24402,"_16893":44330,"_22829":44331,"_2311":44332},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2783":1605,"_24069":1596,"_5":24402,"_16893":44334,"_22829":44335,"_2311":44336},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2783":1606,"_24069":1596,"_5":24402,"_16893":44338,"_22829":44339,"_2311":44340},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2783":1607,"_24069":1596,"_5":24402,"_16893":44342,"_22829":44343,"_2311":44344},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2783":1608,"_24069":1596,"_5":24402,"_16893":44346,"_22829":44347,"_2311":44348},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2783":1609,"_24069":1596,"_5":24402,"_16893":44350,"_22829":44351,"_2311":44352},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2783":1610,"_24069":1596,"_5":24402,"_16893":44354,"_22829":44355,"_2311":44356},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2783":1611,"_24069":1596,"_5":24402,"_16893":44358,"_22829":44359,"_2311":44360},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2783":1612,"_24069":1596,"_5":24402,"_16893":44362,"_22829":44363,"_2311":44364},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2783":1613,"_24069":1596,"_5":24402,"_16893":44366,"_22829":44367,"_2311":44368},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2783":1614,"_24069":1596,"_5":24402,"_16893":44370,"_22829":44371,"_2311":44372},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2783":1615,"_24069":1596,"_5":24402,"_16893":44374,"_22829":44375,"_2311":44376},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2783":1616,"_24069":1596,"_5":24402,"_16893":44378,"_22829":44379,"_2311":44380},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2783":1617,"_24069":1596,"_5":24402,"_16893":44382,"_22829":44383,"_2311":44384},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2783":1618,"_24069":1596,"_5":24402,"_16893":44386,"_22829":44387,"_2311":44388},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2783":1619,"_24069":1596,"_5":24402,"_16893":44390,"_22829":44391,"_2311":44392},[],"/docs/pr-preview/pr-27/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2783":1620,"_24069":1596,"_16893":44394,"_5":16788,"_22829":1596,"_2311":44395},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2783":1621,"_24069":1596,"_16893":44397,"_5":16788,"_22829":1596,"_2311":44398},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2783":1622,"_24069":1596,"_16893":44400,"_5":16788,"_22829":1596,"_2311":44401},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2783":1623,"_24069":1596,"_16893":44403,"_5":16788,"_22829":44308,"_2311":44404},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2783":1624,"_24069":1596,"_16893":44406,"_5":16788,"_22829":44308,"_2311":44407},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2783":1625,"_24069":1596,"_16893":44409,"_5":16788,"_22829":44308,"_2311":44410},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2783":1626,"_24069":1596,"_16893":44412,"_5":16788,"_22829":44308,"_2311":44413},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2783":1627,"_24069":1596,"_16893":44415,"_5":16788,"_22829":44308,"_2311":44416},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2783":1628,"_24069":1596,"_16893":44418,"_5":16788,"_22829":44316,"_2311":44419},[],"Decide whether the CA will be a root or an intermediate.",{"_2783":1629,"_24069":1596,"_16893":44421,"_5":16788,"_22829":44316,"_2311":44422},[],"Choose the engine that will keep the key.",{"_2783":1630,"_24069":1596,"_16893":44424,"_5":16788,"_22829":44316,"_2311":44425},[],"Define a validity longer than that of the certificates it will issue.",{"_2783":1631,"_24069":1596,"_16893":44427,"_5":16788,"_22829":44316,"_2311":44428},[],"For an intermediate CA, make sure the parent CA is active.",{"_2783":1632,"_24069":1596,"_16893":44430,"_5":16788,"_22829":44319,"_2311":44431},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2783":1633,"_24069":1596,"_16893":44433,"_5":16788,"_22829":44323,"_2311":44434},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2783":1634,"_24069":1596,"_16893":44436,"_5":16788,"_22829":44323,"_2311":44437},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2783":1635,"_24069":1596,"_16893":44439,"_5":16788,"_22829":44327,"_2311":44440},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2783":1636,"_24069":1596,"_16893":44442,"_5":16788,"_22829":44331,"_2311":44443},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2783":1637,"_24069":1596,"_16893":44445,"_5":16788,"_22829":44331,"_2311":44446},[],"`C`: two-letter ISO 3166-1 country code.",{"_2783":1638,"_24069":1596,"_16893":44448,"_5":16788,"_22829":44331,"_2311":44449},[],"`ST`: state or province.",{"_2783":1639,"_24069":1596,"_16893":44451,"_5":16788,"_22829":44331,"_2311":44452},[],"`L`: locality.",{"_2783":1640,"_24069":1596,"_16893":44454,"_5":16788,"_22829":44331,"_2311":44455},[],"`O`: organization.",{"_2783":1641,"_24069":1596,"_16893":44457,"_5":16788,"_22829":44331,"_2311":44458},[],"`OU`: organizational unit.",{"_2783":1642,"_24069":1596,"_16893":44460,"_5":16788,"_22829":44331,"_2311":44461},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2783":1643,"_24069":1596,"_16893":44463,"_5":16788,"_22829":44335,"_2311":44464},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2783":1644,"_24069":1596,"_16893":44466,"_5":16788,"_22829":44335,"_2311":44467},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2783":1645,"_24069":1596,"_16893":44469,"_5":16788,"_22829":44339,"_2311":44470},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2783":1646,"_24069":1596,"_16893":44472,"_5":16788,"_22829":44339,"_2311":44473},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2783":1647,"_24069":1596,"_16893":44475,"_5":16788,"_22829":44343,"_2311":44476},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2783":1648,"_24069":1596,"_16893":44478,"_5":16788,"_22829":44343,"_2311":44479},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2783":1649,"_24069":1596,"_16893":44481,"_5":16788,"_22829":44347,"_2311":44482},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2783":1650,"_24069":1596,"_16893":44484,"_5":16788,"_22829":44351,"_2311":44485},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2783":1651,"_24069":1596,"_16893":44487,"_5":16788,"_22829":44355,"_2311":44488},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2783":1652,"_24069":1596,"_16893":44490,"_5":16788,"_22829":44359,"_2311":44491},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2783":1653,"_24069":1596,"_16893":44493,"_5":16788,"_22829":44363,"_2311":44494},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2783":1654,"_24069":1596,"_16893":44496,"_5":16788,"_22829":44363,"_2311":44497},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2783":1655,"_24069":1596,"_16893":44499,"_5":16788,"_22829":44367,"_2311":44500},[],"Open a CA from the inventory to review:",{"_2783":1656,"_24069":1596,"_16893":44502,"_5":16788,"_22829":44367,"_2311":44503},[],"Status and validity period.",{"_2783":1657,"_24069":1596,"_16893":44505,"_5":16788,"_22829":44367,"_2311":44506},[],"Certificate and chain in PEM format.",{"_2783":1658,"_24069":1596,"_16893":44508,"_5":16788,"_22829":44367,"_2311":44509},[],"Number of active, expired and revoked certificates.",{"_2783":1659,"_24069":1596,"_16893":44511,"_5":16788,"_22829":44367,"_2311":44512},[],"Certificates issued in **Issued Certificates**.",{"_2783":1660,"_24069":1596,"_16893":44514,"_5":16788,"_22829":44367,"_2311":44515},[],"The CRL linked to the authority.",{"_2783":1661,"_24069":1596,"_16893":44517,"_5":16788,"_22829":44367,"_2311":44518},[],"Metadata and the associated cryptographic engine.",{"_2783":1662,"_24069":1596,"_16893":44520,"_5":16788,"_22829":44367,"_2311":44521},[],"You can filter the inventory by name, status and CA type.",{"_2783":1663,"_24069":1596,"_16893":44523,"_5":16788,"_22829":44371,"_2311":44524},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2783":1664,"_24069":1596,"_16893":44526,"_5":16788,"_22829":44371,"_2311":44527},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2783":1665,"_24069":1596,"_16893":44529,"_5":16788,"_22829":44371,"_2311":44530},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2783":1666,"_24069":1596,"_16893":44532,"_5":16788,"_22829":44371,"_2311":44533},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2783":1667,"_24069":1596,"_16893":44535,"_5":16788,"_22829":44375,"_2311":44536},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2783":1668,"_24069":1596,"_16893":44538,"_5":16788,"_22829":44379,"_2311":44539},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2783":1669,"_24069":1596,"_16893":44541,"_5":16788,"_22829":44383,"_2311":44542},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2783":1670,"_24069":1596,"_16893":44544,"_5":16788,"_22829":44387,"_2311":44545},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2783":1671,"_24069":1596,"_16893":44547,"_5":16788,"_22829":44391,"_2311":44548},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2783":1672,"_24069":1596,"_16893":44550,"_5":16788,"_22829":44391,"_2311":44551},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2783":1673,"_24069":1673,"_5":11891,"_2311":44553,"_24405":44554,"_16893":44555,"_22829":1673},"Certificate profiles",[39337,40681,44140,44141],[],{"_2783":1674,"_24069":1673,"_16893":44557,"_5":16788,"_22829":1673,"_2311":44558},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2783":1675,"_24069":1673,"_5":24402,"_16893":44560,"_22829":44561,"_2311":44562},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2783":1676,"_24069":1673,"_5":24402,"_16893":44564,"_22829":44565,"_2311":44566},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#validity","Validity",{"_2783":1677,"_24069":1673,"_5":24402,"_16893":44568,"_22829":44569,"_2311":44570},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2783":1678,"_24069":1673,"_5":24402,"_16893":44572,"_22829":44573,"_2311":44574},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2783":1679,"_24069":1673,"_5":24402,"_16893":44576,"_22829":44577,"_2311":44578},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#subject","Subject",{"_2783":1680,"_24069":1673,"_5":24402,"_16893":44580,"_22829":44581,"_2311":44582},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2783":1681,"_24069":1673,"_5":24402,"_16893":44584,"_22829":44585,"_2311":44586},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2783":1682,"_24069":1673,"_5":24402,"_16893":44588,"_22829":44589,"_2311":44590},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2783":1683,"_24069":1673,"_5":24402,"_16893":44592,"_22829":44593,"_2311":44594},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2783":1684,"_24069":1673,"_5":24402,"_16893":44596,"_22829":44597,"_2311":44598},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2783":1685,"_24069":1673,"_5":24402,"_16893":44600,"_22829":44601,"_2311":44602},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2783":1686,"_24069":1673,"_5":24402,"_16893":44604,"_22829":44605,"_2311":44606},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2783":1687,"_24069":1673,"_5":24402,"_16893":44608,"_22829":44609,"_2311":44610},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2783":1688,"_24069":1673,"_5":24402,"_16893":44612,"_22829":44613,"_2311":44614},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2783":1689,"_24069":1673,"_5":24402,"_16893":44616,"_22829":44617,"_2311":44618},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#design-examples","Design examples",{"_2783":1690,"_24069":1673,"_5":24402,"_16893":44620,"_22829":44621,"_2311":44622},[],"/docs/pr-preview/pr-27/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2783":1691,"_24069":1673,"_16893":44624,"_5":16788,"_22829":1673,"_2311":44625},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2783":1692,"_24069":1673,"_16893":44627,"_5":16788,"_22829":1673,"_2311":44628},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2783":1693,"_24069":1673,"_16893":44630,"_5":16788,"_22829":44565,"_2311":44631},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2783":1694,"_24069":1673,"_16893":44633,"_5":16788,"_22829":44565,"_2311":44634},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2783":1695,"_24069":1673,"_16893":44636,"_5":16788,"_22829":44569,"_2311":44637},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2783":1696,"_24069":1673,"_16893":44639,"_5":16788,"_22829":44573,"_2311":44640},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2783":1697,"_24069":1673,"_16893":44642,"_5":16788,"_22829":44573,"_2311":44643},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2783":1698,"_24069":1673,"_16893":44645,"_5":16788,"_22829":44573,"_2311":44646},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2783":1699,"_24069":1673,"_16893":44648,"_5":16788,"_22829":44577,"_2311":44649},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2783":1700,"_24069":1673,"_16893":44651,"_5":16788,"_22829":44581,"_2311":44652},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2783":1701,"_24069":1673,"_16893":44654,"_5":16788,"_22829":44581,"_2311":44655},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2783":1702,"_24069":1673,"_16893":44657,"_5":16788,"_22829":44585,"_2311":44658},[],"The cryptographic enforcement can:",{"_2783":1703,"_24069":1673,"_16893":44660,"_5":16788,"_22829":44585,"_2311":44661},[],"allow or block RSA keys;",{"_2783":1704,"_24069":1673,"_16893":44663,"_5":16788,"_22829":44585,"_2311":44664},[],"limit the supported RSA sizes;",{"_2783":1705,"_24069":1673,"_16893":44666,"_5":16788,"_22829":44585,"_2311":44667},[],"allow or block ECDSA keys;",{"_2783":1706,"_24069":1673,"_16893":44669,"_5":16788,"_22829":44585,"_2311":44670},[],"limit the supported ECDSA sizes or curves.",{"_2783":1707,"_24069":1673,"_16893":44672,"_5":16788,"_22829":44585,"_2311":44673},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2783":1708,"_24069":1673,"_16893":44675,"_5":16788,"_22829":44589,"_2311":44676},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2783":1709,"_24069":1673,"_16893":44678,"_5":16788,"_22829":44589,"_2311":42210},[],{"_2783":1710,"_24069":1673,"_16893":44680,"_5":16788,"_22829":44589,"_2311":44681},[],"First choice",{"_2783":1711,"_24069":1673,"_16893":44683,"_5":16788,"_22829":44589,"_2311":44684},[],"Second choice",{"_2783":1712,"_24069":1673,"_16893":44686,"_5":16788,"_22829":44589,"_2311":44687},[],"If neither is supplied",{"_2783":1713,"_24069":1673,"_16893":44689,"_5":16788,"_22829":44589,"_2311":44690},[],"Direct signing with a CA",{"_2783":1714,"_24069":1673,"_16893":44692,"_5":16788,"_22829":44589,"_2311":44693},[],"`issuance_profile` embedded in the request",{"_2783":1715,"_24069":1673,"_16893":44695,"_5":16788,"_22829":44589,"_2311":44696},[],"Request `issuance_profile_id`",{"_2783":1716,"_24069":1673,"_16893":44698,"_5":16788,"_22829":44589,"_2311":44699},[],"CA default profile (`profile_id`).",{"_2783":1717,"_24069":1673,"_16893":44701,"_5":16788,"_22829":44589,"_2311":44702},[],"Issuance through a DMS",{"_2783":1718,"_24069":1673,"_16893":44704,"_5":16788,"_22829":44589,"_2311":44705},[],"`settings.issuance_profile_id`",{"_2783":1719,"_24069":1673,"_16893":44707,"_5":16788,"_22829":44589,"_2311":44708},[],"`settings.issuance_profile` embedded in the DMS",{"_2783":1720,"_24069":1673,"_16893":44710,"_5":16788,"_22829":44589,"_2311":44711},[],"Enrollment CA default profile.",{"_2783":1721,"_24069":1673,"_16893":44713,"_5":16788,"_22829":44589,"_2311":44714},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2783":1722,"_24069":1673,"_16893":44716,"_5":16788,"_22829":44589,"_2311":44717},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2783":1723,"_24069":1673,"_16893":44719,"_5":16788,"_22829":44597,"_2311":44720},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2783":1724,"_24069":1673,"_16893":44722,"_5":16788,"_22829":44601,"_2311":44723},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2783":1725,"_24069":1673,"_16893":44725,"_5":16788,"_22829":44605,"_2311":44726},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2783":1726,"_24069":1673,"_16893":44728,"_5":16788,"_22829":44609,"_2311":44729},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2783":1727,"_24069":1673,"_16893":44731,"_5":16788,"_22829":44613,"_2311":44732},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2783":1728,"_24069":1673,"_16893":44734,"_5":16788,"_22829":44613,"_2311":44735},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2783":1729,"_24069":1673,"_16893":44737,"_5":16788,"_22829":44617,"_2311":44738},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2783":1730,"_24069":1673,"_16893":44740,"_5":16788,"_22829":44617,"_2311":44741},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2783":1731,"_24069":1673,"_16893":44743,"_5":16788,"_22829":44617,"_2311":44744},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2783":1732,"_24069":1673,"_16893":44746,"_5":16788,"_22829":44617,"_2311":44747},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2783":1733,"_24069":1673,"_16893":44749,"_5":16788,"_22829":44621,"_2311":44750},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2783":1734,"_24069":1673,"_16893":44752,"_5":16788,"_22829":44621,"_2311":44753},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2783":1735,"_24069":1735,"_5":11891,"_2311":44755,"_24405":44756,"_16893":44758,"_22829":1735},"Certificate validation",[39337,40681,44140,44757],"Validation",[],{"_2783":1736,"_24069":1735,"_16893":44760,"_5":16788,"_22829":1735,"_2311":44761},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2783":1737,"_24069":1735,"_5":24402,"_16893":44763,"_22829":44764,"_2311":44765},[],"/docs/pr-preview/pr-27/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2783":1738,"_24069":1735,"_5":24402,"_16893":44767,"_22829":44768,"_2311":44769},[],"/docs/pr-preview/pr-27/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2783":1739,"_24069":1735,"_5":24402,"_16893":44771,"_22829":44772,"_2311":44773},[],"/docs/pr-preview/pr-27/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2783":1740,"_24069":1735,"_16893":44775,"_5":16788,"_22829":1735,"_2311":44776},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2783":1741,"_24069":1735,"_16893":44778,"_5":16788,"_22829":44764,"_2311":44779},[],"Verify these criteria together:",{"_2783":1742,"_24069":1735,"_16893":44781,"_5":16788,"_22829":44764,"_2311":43764},[],{"_2783":1743,"_24069":1735,"_16893":44783,"_5":16788,"_22829":44764,"_2311":44784},[],"Required result",{"_2783":1744,"_24069":1735,"_16893":44786,"_5":16788,"_22829":44764,"_2311":44787},[],"Chain and signature",{"_2783":1745,"_24069":1735,"_16893":44789,"_5":16788,"_22829":44764,"_2311":44790},[],"Valid chain to a root deliberately installed in the consumer.",{"_2783":1746,"_24069":1735,"_16893":44792,"_5":16788,"_22829":44764,"_2311":44793},[],"Dates",{"_2783":1747,"_24069":1735,"_16893":44795,"_5":16788,"_22829":44764,"_2311":44796},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2783":1748,"_24069":1735,"_16893":44798,"_5":16788,"_22829":44764,"_2311":40384},[],{"_2783":1749,"_24069":1735,"_16893":44800,"_5":16788,"_22829":44764,"_2311":44801},[],"Name, SAN or identifier matches the expected peer.",{"_2783":1750,"_24069":1735,"_16893":44803,"_5":16788,"_22829":44764,"_2311":39720},[],{"_2783":1751,"_24069":1735,"_16893":44805,"_5":16788,"_22829":44764,"_2311":44806},[],"KU, EKU and constraints permit the specific operation.",{"_2783":1752,"_24069":1735,"_16893":44808,"_5":16788,"_22829":44764,"_2311":44809},[],"Revocation",{"_2783":1753,"_24069":1735,"_16893":44811,"_5":16788,"_22829":44764,"_2311":44812},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2783":1754,"_24069":1735,"_16893":44814,"_5":16788,"_22829":44764,"_2311":44815},[],"Authorization",{"_2783":1755,"_24069":1735,"_16893":44817,"_5":16788,"_22829":44764,"_2311":44818},[],"The application permits that identity to perform the action.",{"_2783":1756,"_24069":1735,"_16893":44820,"_5":16788,"_22829":44764,"_2311":44821},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2783":1757,"_24069":1735,"_16893":44823,"_5":16788,"_22829":44768,"_2311":44824},[],"Mechanism",{"_2783":1758,"_24069":1735,"_16893":44826,"_5":16788,"_22829":44768,"_2311":44827},[],"When to use it",{"_2783":1759,"_24069":1735,"_16893":44829,"_5":16788,"_22829":44768,"_2311":44830},[],"What you must maintain",{"_2783":1760,"_24069":1735,"_16893":44832,"_5":16788,"_22829":44768,"_2311":44833},[],"OCSP",{"_2783":1761,"_24069":1735,"_16893":44835,"_5":16788,"_22829":44768,"_2311":44836},[],"Status query for a specific certificate.",{"_2783":1762,"_24069":1735,"_16893":44838,"_5":16788,"_22829":44768,"_2311":44839},[],"Responder access, signature verification and cache/freshness policy.",{"_2783":1763,"_24069":1735,"_16893":44841,"_5":16788,"_22829":44768,"_2311":44842},[],"CRL",{"_2783":1764,"_24069":1735,"_16893":44844,"_5":16788,"_22829":44768,"_2311":44845},[],"Local checks for many certificates or offline operation.",{"_2783":1765,"_24069":1735,"_16893":44847,"_5":16788,"_22829":44768,"_2311":44848},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2783":1766,"_24069":1735,"_16893":44850,"_5":16788,"_22829":44768,"_2311":44851},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2783":1767,"_24069":1735,"_16893":44853,"_5":16788,"_22829":44768,"_2311":44854},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2783":1768,"_24069":1735,"_16893":44856,"_5":16788,"_22829":44772,"_2311":44857},[],"Accept a current, authorized certificate with a known chain.",{"_2783":1769,"_24069":1735,"_16893":44859,"_5":16788,"_22829":44772,"_2311":44860},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2783":1770,"_24069":1735,"_16893":44862,"_5":16788,"_22829":44772,"_2311":44863},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2783":1771,"_24069":1735,"_16893":44865,"_5":16788,"_22829":44772,"_2311":44866},[],"Check that a new connection with that identity is rejected.",{"_2783":1772,"_24069":1735,"_16893":44868,"_5":16788,"_22829":44772,"_2311":44869},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2783":1773,"_24069":1735,"_16893":44871,"_5":16788,"_22829":44772,"_2311":44872},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2783":1774,"_24069":1735,"_16893":44874,"_5":16788,"_22829":44772,"_2311":44875},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2783":1775,"_24069":1735,"_16893":44877,"_5":16788,"_22829":44772,"_2311":44878},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":1776,"_24069":1735,"_16893":44880,"_5":16788,"_22829":44772,"_2311":44881},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2783":1777,"_24069":1777,"_5":11891,"_2311":44883,"_24405":44884,"_16893":44885,"_22829":1777},"Certificates",[39337,40681,44140,44141],[],{"_2783":1778,"_24069":1777,"_16893":44887,"_5":16788,"_22829":1777,"_2311":44888},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2783":1779,"_24069":1777,"_5":24402,"_16893":44890,"_22829":44891,"_2311":44892},[],"/docs/pr-preview/pr-27/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2783":1780,"_24069":1777,"_5":24402,"_16893":44894,"_22829":44895,"_2311":44896},[],"/docs/pr-preview/pr-27/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2783":1781,"_24069":1777,"_5":24402,"_16893":44898,"_22829":44899,"_2311":44900},[],"/docs/pr-preview/pr-27/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2783":1782,"_24069":1777,"_5":24402,"_16893":44902,"_22829":44903,"_2311":44904},[],"/docs/pr-preview/pr-27/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2783":1783,"_24069":1777,"_5":24402,"_16893":44906,"_22829":44907,"_2311":44908},[],"/docs/pr-preview/pr-27/platform/pki/certificates#open-the-action","Open the action",{"_2783":1784,"_24069":1777,"_5":24402,"_16893":44910,"_22829":44911,"_2311":44912},[],"/docs/pr-preview/pr-27/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2783":1785,"_24069":1777,"_5":24402,"_16893":44914,"_22829":44915,"_2311":44916},[],"/docs/pr-preview/pr-27/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2783":1786,"_24069":1777,"_5":24402,"_16893":44918,"_22829":44919,"_2311":44920},[],"/docs/pr-preview/pr-27/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2783":1787,"_24069":1777,"_5":24402,"_16893":44922,"_22829":44923,"_2311":44924},[],"/docs/pr-preview/pr-27/platform/pki/certificates#continue","Continue",{"_2783":1788,"_24069":1777,"_16893":44926,"_5":16788,"_22829":1777,"_2311":44927},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2783":1789,"_24069":1777,"_16893":44929,"_5":16788,"_22829":44891,"_2311":44930},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2783":1790,"_24069":1777,"_16893":44932,"_5":16788,"_22829":44891,"_2311":44933},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2783":1791,"_24069":1777,"_16893":44935,"_5":16788,"_22829":44895,"_2311":44936},[],"Download the PEM and inspect it:",{"_2783":1792,"_24069":1777,"_16893":44938,"_5":16788,"_22829":44895,"_2311":44939},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2783":1793,"_24069":1777,"_16893":44941,"_5":16788,"_22829":44899,"_2311":44942},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2783":1794,"_24069":1777,"_16893":44944,"_5":16788,"_22829":44899,"_2311":44945},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2783":1795,"_24069":1777,"_16893":44947,"_5":16788,"_22829":44899,"_2311":44948},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2783":1796,"_24069":1777,"_16893":44950,"_5":16788,"_22829":44899,"_2311":44951},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2783":1797,"_24069":1777,"_16893":44953,"_5":16788,"_22829":44899,"_2311":44954},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2783":1798,"_24069":1777,"_16893":44956,"_5":16788,"_22829":44899,"_2311":44957},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2783":1799,"_24069":1777,"_16893":44959,"_5":16788,"_22829":44899,"_2311":44960},[],"For browser key generation, follow Issue your first certificate.",{"_2783":1800,"_24069":1777,"_16893":44962,"_5":16788,"_22829":44903,"_2311":44963},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2783":1801,"_24069":1777,"_16893":44965,"_5":16788,"_22829":44907,"_2311":44966},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2783":1802,"_24069":1777,"_16893":44968,"_5":16788,"_22829":44911,"_2311":44969},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2783":1803,"_24069":1777,"_16893":44971,"_5":16788,"_22829":44915,"_2311":44972},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2783":1804,"_24069":1777,"_16893":44974,"_5":16788,"_22829":44915,"_2311":44975},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2783":1805,"_24069":1777,"_16893":44977,"_5":16788,"_22829":44915,"_2311":44978},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2783":1806,"_24069":1777,"_16893":44980,"_5":16788,"_22829":44919,"_2311":44981},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2783":1807,"_24069":1777,"_16893":44983,"_5":16788,"_22829":44919,"_2311":44984},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2783":1808,"_24069":1777,"_16893":44986,"_5":16788,"_22829":44919,"_2311":44987},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2783":1809,"_24069":1777,"_16893":44989,"_5":16788,"_22829":44923,"_2311":44990},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":1810,"_24069":1777,"_16893":44992,"_5":16788,"_22829":44923,"_2311":44993},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2783":1811,"_24069":1811,"_5":11891,"_2311":44995,"_24405":44996,"_16893":44998,"_22829":1811},"Certificate lifecycle",[39337,40681,44140,44997],"Concepts",[],{"_2783":1812,"_24069":1811,"_16893":45000,"_5":16788,"_22829":1811,"_2311":45001},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2783":1813,"_24069":1811,"_5":24402,"_16893":45003,"_22829":45004,"_2311":45005},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2783":1814,"_24069":1811,"_5":24402,"_16893":45007,"_22829":45008,"_2311":45009},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2783":1815,"_24069":1811,"_5":24402,"_16893":45011,"_22829":45012,"_2311":45013},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2783":1816,"_24069":1811,"_5":24402,"_16893":45015,"_22829":45016,"_2311":45017},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2783":1817,"_24069":1811,"_5":24402,"_16893":45019,"_22829":45020,"_2311":45021},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2783":1818,"_24069":1811,"_5":24402,"_16893":45023,"_22829":45024,"_2311":45025},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2783":1819,"_24069":1811,"_5":24402,"_16893":45027,"_22829":45028,"_2311":45029},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2783":1820,"_24069":1811,"_5":24402,"_16893":45031,"_22829":45032,"_2311":45033},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2783":1821,"_24069":1811,"_5":24402,"_16893":45035,"_22829":45036,"_2311":45037},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2783":1822,"_24069":1811,"_5":24402,"_16893":45039,"_22829":45040,"_2311":45041},[],"/docs/pr-preview/pr-27/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2783":1823,"_24069":1811,"_16893":45043,"_5":16788,"_22829":1811,"_2311":45044},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2783":1824,"_24069":1811,"_16893":45046,"_5":16788,"_22829":45008,"_2311":45047},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2783":1825,"_24069":1811,"_16893":45049,"_5":16788,"_22829":45012,"_2311":45050},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2783":1826,"_24069":1811,"_16893":45052,"_5":16788,"_22829":45016,"_2311":45053},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2783":1827,"_24069":1811,"_16893":45055,"_5":16788,"_22829":45020,"_2311":45056},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2783":1828,"_24069":1811,"_16893":45058,"_5":16788,"_22829":45024,"_2311":45059},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2783":1829,"_24069":1811,"_16893":45061,"_5":16788,"_22829":45028,"_2311":45062},[],"Lamassu persists four X.509 states:",{"_2783":1830,"_24069":1811,"_16893":45064,"_5":16788,"_22829":45028,"_2311":45065},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2783":1831,"_24069":1811,"_16893":45067,"_5":16788,"_22829":45028,"_2311":45068},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2783":1832,"_24069":1811,"_16893":45070,"_5":16788,"_22829":45028,"_2311":45071},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2783":1833,"_24069":1811,"_16893":45073,"_5":16788,"_22829":45028,"_2311":45074},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2783":1834,"_24069":1811,"_16893":45076,"_5":16788,"_22829":45028,"_2311":45077},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2783":1835,"_24069":1811,"_16893":45079,"_5":16788,"_22829":45032,"_2311":45080},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2783":1836,"_24069":1811,"_16893":45082,"_5":16788,"_22829":45032,"_2311":45083},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2783":1837,"_24069":1811,"_16893":45085,"_5":16788,"_22829":45032,"_2311":45086},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2783":1838,"_24069":1811,"_16893":45088,"_5":16788,"_22829":45036,"_2311":45089},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2783":1839,"_24069":1811,"_16893":45091,"_5":16788,"_22829":45036,"_2311":45092},[],"Before confirming:",{"_2783":1840,"_24069":1811,"_16893":45094,"_5":16788,"_22829":45036,"_2311":45095},[],"Identify DMSs, devices and services that trust that chain.",{"_2783":1841,"_24069":1811,"_16893":45097,"_5":16788,"_22829":45036,"_2311":45098},[],"Distribute the new chain of trust.",{"_2783":1842,"_24069":1811,"_16893":45100,"_5":16788,"_22829":45036,"_2311":45101},[],"Reissue the necessary identities.",{"_2783":1843,"_24069":1811,"_16893":45103,"_5":16788,"_22829":45036,"_2311":45104},[],"Check OCSP and CRL from a real consumer.",{"_2783":1844,"_24069":1811,"_16893":45106,"_5":16788,"_22829":45036,"_2311":45107},[],"Revoke the old CA once no legitimate traffic remains.",{"_2783":1845,"_24069":1811,"_16893":45109,"_5":16788,"_22829":45036,"_2311":45110},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2783":1846,"_24069":1811,"_16893":45112,"_5":16788,"_22829":45040,"_2311":45113},[],"Certificates entering the preventive or critical renewal window.",{"_2783":1847,"_24069":1811,"_16893":45115,"_5":16788,"_22829":45040,"_2311":45116},[],"Repeated enrollment or re-enrollment failures.",{"_2783":1848,"_24069":1811,"_16893":45118,"_5":16788,"_22829":45040,"_2311":45119},[],"Status changes and revocation reasons.",{"_2783":1849,"_24069":1811,"_16893":45121,"_5":16788,"_22829":45040,"_2311":45122},[],"OCSP and CRL publication and validity.",{"_2783":1850,"_24069":1811,"_16893":45124,"_5":16788,"_22829":45040,"_2311":45125},[],"Dependencies still presenting a replaced certificate.",{"_2783":1851,"_24069":1811,"_16893":45127,"_5":16788,"_22829":45040,"_2311":45128},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2783":1852,"_24069":1852,"_5":11891,"_2311":45130,"_24405":45131,"_16893":45132,"_22829":1852},"Trust model",[39337,40681,44140,44997],[],{"_2783":1853,"_24069":1852,"_16893":45134,"_5":16788,"_22829":1852,"_2311":45135},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2783":1854,"_24069":1852,"_5":24402,"_16893":45137,"_22829":45138,"_2311":45139},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2783":1855,"_24069":1852,"_5":24402,"_16893":45141,"_22829":45142,"_2311":45143},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2783":1856,"_24069":1852,"_5":24402,"_16893":45145,"_22829":45146,"_2311":45147},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2783":1857,"_24069":1852,"_5":24402,"_16893":45149,"_22829":45150,"_2311":45151},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2783":1858,"_24069":1852,"_5":24402,"_16893":45153,"_22829":45154,"_2311":45155},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2783":1859,"_24069":1852,"_5":24402,"_16893":45157,"_22829":45158,"_2311":45159},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2783":1860,"_24069":1852,"_5":24402,"_16893":45161,"_22829":45162,"_2311":45163},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2783":1861,"_24069":1852,"_5":24402,"_16893":45165,"_22829":45166,"_2311":45167},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2783":1862,"_24069":1852,"_5":24402,"_16893":45169,"_22829":45170,"_2311":45171},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2783":1863,"_24069":1852,"_5":24402,"_16893":45173,"_22829":45174,"_2311":45175},[],"/docs/pr-preview/pr-27/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2783":1864,"_24069":1852,"_16893":45177,"_5":16788,"_22829":1852,"_2311":45178},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2783":1865,"_24069":1852,"_16893":45180,"_5":16788,"_22829":45142,"_2311":45181},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2783":1866,"_24069":1852,"_16893":45183,"_5":16788,"_22829":45146,"_2311":45184},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2783":1867,"_24069":1852,"_16893":45186,"_5":16788,"_22829":45150,"_2311":45187},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2783":1868,"_24069":1852,"_16893":45189,"_5":16788,"_22829":45154,"_2311":45190},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2783":1869,"_24069":1852,"_16893":45192,"_5":16788,"_22829":45158,"_2311":45193},[],"The device proves it can enroll according to the DMS policy.",{"_2783":1870,"_24069":1852,"_16893":45195,"_5":16788,"_22829":45158,"_2311":45196},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2783":1871,"_24069":1852,"_16893":45198,"_5":16788,"_22829":45158,"_2311":45199},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2783":1872,"_24069":1852,"_16893":45201,"_5":16788,"_22829":45158,"_2311":45202},[],"The device installs the certificate and the chain it needs.",{"_2783":1873,"_24069":1852,"_16893":45204,"_5":16788,"_22829":45158,"_2311":45205},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2783":1874,"_24069":1852,"_16893":45207,"_5":16788,"_22829":45158,"_2311":45208},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2783":1875,"_24069":1852,"_16893":45210,"_5":16788,"_22829":45162,"_2311":45211},[],"A DMS relates three sets that are worth designing separately:",{"_2783":1876,"_24069":1852,"_16893":45213,"_5":16788,"_22829":45162,"_2311":45214},[],"**Enrollment CA:** signs the new identities.",{"_2783":1877,"_24069":1852,"_16893":45216,"_5":16788,"_22829":45162,"_2311":45217},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2783":1878,"_24069":1852,"_16893":45219,"_5":16788,"_22829":45162,"_2311":45220},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2783":1879,"_24069":1852,"_16893":45222,"_5":16788,"_22829":45162,"_2311":45223},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2783":1880,"_24069":1852,"_16893":45225,"_5":16788,"_22829":45166,"_2311":45226},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2783":1881,"_24069":1852,"_16893":45228,"_5":16788,"_22829":45166,"_2311":45229},[],"that the current date is between `Not Before` and `Not After`;",{"_2783":1882,"_24069":1852,"_16893":45231,"_5":16788,"_22829":45166,"_2311":45232},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2783":1883,"_24069":1852,"_16893":45234,"_5":16788,"_22829":45166,"_2311":45235},[],"that names, SANs and subject match the expected identity;",{"_2783":1884,"_24069":1852,"_16893":45237,"_5":16788,"_22829":45166,"_2311":45238},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2783":1885,"_24069":1852,"_16893":45240,"_5":16788,"_22829":45166,"_2311":45241},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2783":1886,"_24069":1852,"_16893":45243,"_5":16788,"_22829":45166,"_2311":45244},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2783":1887,"_24069":1852,"_16893":45246,"_5":16788,"_22829":45170,"_2311":45247},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2783":1888,"_24069":1852,"_16893":45249,"_5":16788,"_22829":45174,"_2311":45250},[],"Keep the root out of daily operations, or with very restricted access.",{"_2783":1889,"_24069":1852,"_16893":45252,"_5":16788,"_22829":45174,"_2311":45253},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2783":1890,"_24069":1852,"_16893":45255,"_5":16788,"_22829":45174,"_2311":45256},[],"Assign explicit profiles to every use case.",{"_2783":1891,"_24069":1852,"_16893":45258,"_5":16788,"_22829":45174,"_2311":45259},[],"Distribute the new trust before starting a rotation.",{"_2783":1892,"_24069":1852,"_16893":45261,"_5":16788,"_22829":45174,"_2311":45262},[],"Keep enough overlap to renew a disconnected fleet.",{"_2783":1893,"_24069":1852,"_16893":45264,"_5":16788,"_22829":45174,"_2311":45265},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2783":1894,"_24069":1852,"_16893":45267,"_5":16788,"_22829":45174,"_2311":45268},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2783":1895,"_24069":1895,"_5":11891,"_2311":45270,"_24405":45271,"_16893":45272,"_22829":1895},"Revocation lists (CRL)",[39337,40681,44140,44757],[],{"_2783":1896,"_24069":1895,"_16893":45274,"_5":16788,"_22829":1895,"_2311":45275},[],"Generate and distribute signed lists to validate certificates offline.",{"_2783":1897,"_24069":1895,"_5":24402,"_16893":45277,"_22829":45278,"_2311":45279},[],"/docs/pr-preview/pr-27/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2783":1898,"_24069":1895,"_5":24402,"_16893":45281,"_22829":45282,"_2311":45283},[],"/docs/pr-preview/pr-27/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2783":1899,"_24069":1895,"_5":24402,"_16893":45285,"_22829":45286,"_2311":45287},[],"/docs/pr-preview/pr-27/platform/pki/crl#crl-contents","CRL contents",{"_2783":1900,"_24069":1895,"_5":24402,"_16893":45289,"_22829":45290,"_2311":45291},[],"/docs/pr-preview/pr-27/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2783":1901,"_24069":1895,"_5":24402,"_16893":45293,"_22829":45294,"_2311":45295},[],"/docs/pr-preview/pr-27/platform/pki/crl#va-role-management-api","VA role management API",{"_2783":1902,"_24069":1895,"_5":24402,"_16893":45297,"_22829":45298,"_2311":45299},[],"/docs/pr-preview/pr-27/platform/pki/crl#from-the-interface","From the interface",{"_2783":1903,"_24069":1895,"_5":24402,"_16893":45301,"_22829":45302,"_2311":45303},[],"/docs/pr-preview/pr-27/platform/pki/crl#references","References",{"_2783":1904,"_24069":1895,"_16893":45305,"_5":16788,"_22829":1895,"_2311":45306},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2783":1905,"_24069":1895,"_16893":45308,"_5":16788,"_22829":45278,"_2311":45309},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2783":1906,"_24069":1895,"_16893":45311,"_5":16788,"_22829":45278,"_2311":45312},[],"`crl_options` field",{"_2783":1907,"_24069":1895,"_16893":45314,"_5":16788,"_22829":45278,"_2311":39720},[],{"_2783":1908,"_24069":1895,"_16893":45316,"_5":16788,"_22829":45278,"_2311":45317},[],"Backend initial value",{"_2783":1909,"_24069":1895,"_16893":45319,"_5":16788,"_22829":45278,"_2311":45320},[],"`validity`",{"_2783":1910,"_24069":1895,"_16893":45322,"_5":16788,"_22829":45278,"_2311":45323},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2783":1911,"_24069":1895,"_16893":45325,"_5":16788,"_22829":45278,"_2311":45326},[],"7 days.",{"_2783":1912,"_24069":1895,"_16893":45328,"_5":16788,"_22829":45278,"_2311":45329},[],"`refresh_interval`",{"_2783":1913,"_24069":1895,"_16893":45331,"_5":16788,"_22829":45278,"_2311":45332},[],"Time since publication that triggers scheduled renewal.",{"_2783":1914,"_24069":1895,"_16893":45334,"_5":16788,"_22829":45278,"_2311":45335},[],"6 days and 23 hours.",{"_2783":1915,"_24069":1895,"_16893":45337,"_5":16788,"_22829":45278,"_2311":45338},[],"`regenerate_on_revoke`",{"_2783":1916,"_24069":1895,"_16893":45340,"_5":16788,"_22829":45278,"_2311":45341},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2783":1917,"_24069":1895,"_16893":45343,"_5":16788,"_22829":45278,"_2311":45344},[],"`true`.",{"_2783":1918,"_24069":1895,"_16893":45346,"_5":16788,"_22829":45278,"_2311":45347},[],"`subject_key_id_signer`",{"_2783":1919,"_24069":1895,"_16893":45349,"_5":16788,"_22829":45278,"_2311":45350},[],"Configuration field initialized with the CA’s SKI.",{"_2783":1920,"_24069":1895,"_16893":45352,"_5":16788,"_22829":45278,"_2311":45353},[],"CA SKI.",{"_2783":1921,"_24069":1895,"_16893":45355,"_5":16788,"_22829":45278,"_2311":45356},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2783":1922,"_24069":1895,"_16893":45358,"_5":16788,"_22829":45278,"_2311":45359},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2783":1923,"_24069":1895,"_16893":45361,"_5":16788,"_22829":45282,"_2311":45362},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2783":1924,"_24069":1895,"_16893":45364,"_5":16788,"_22829":45282,"_2311":45365},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2783":1925,"_24069":1895,"_16893":45367,"_5":16788,"_22829":45282,"_2311":45368},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2783":1926,"_24069":1895,"_16893":45370,"_5":16788,"_22829":45286,"_2311":45371},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2783":1927,"_24069":1895,"_16893":45373,"_5":16788,"_22829":45286,"_2311":45374},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2783":1928,"_24069":1895,"_16893":45376,"_5":16788,"_22829":45290,"_2311":45377},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2783":1929,"_24069":1895,"_16893":45379,"_5":16788,"_22829":45290,"_2311":45380},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2783":1930,"_24069":1895,"_16893":45382,"_5":16788,"_22829":45290,"_2311":45383},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2783":1931,"_24069":1895,"_16893":45385,"_5":16788,"_22829":45290,"_2311":45386},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2783":1932,"_24069":1895,"_16893":45388,"_5":16788,"_22829":45290,"_2311":45389},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2783":1933,"_24069":1895,"_16893":45391,"_5":16788,"_22829":45294,"_2311":45392},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2783":1934,"_24069":1895,"_16893":45394,"_5":16788,"_22829":45294,"_2311":42213},[],{"_2783":1935,"_24069":1895,"_16893":45396,"_5":16788,"_22829":45294,"_2311":45397},[],"Relative path",{"_2783":1936,"_24069":1895,"_16893":45399,"_5":16788,"_22829":45294,"_2311":42210},[],{"_2783":1937,"_24069":1895,"_16893":45401,"_5":16788,"_22829":45294,"_2311":45402},[],"`GET`",{"_2783":1938,"_24069":1895,"_16893":45404,"_5":16788,"_22829":45294,"_2311":45405},[],"`/v1/roles/{ca-ski}`",{"_2783":1939,"_24069":1895,"_16893":45407,"_5":16788,"_22829":45294,"_2311":45408},[],"Read `crl_options` and `latest_crl`.",{"_2783":1940,"_24069":1895,"_16893":45410,"_5":16788,"_22829":45294,"_2311":45411},[],"`PUT`",{"_2783":1941,"_24069":1895,"_16893":45413,"_5":16788,"_22829":45294,"_2311":45405},[],{"_2783":1942,"_24069":1895,"_16893":45415,"_5":16788,"_22829":45294,"_2311":45416},[],"Replace CRL configuration.",{"_2783":1943,"_24069":1895,"_16893":45418,"_5":16788,"_22829":45294,"_2311":45419},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2783":1944,"_24069":1895,"_16893":45421,"_5":16788,"_22829":45294,"_2311":45422},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2783":1945,"_24069":1895,"_16893":45424,"_5":16788,"_22829":45298,"_2311":45425},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2783":1946,"_24069":1895,"_16893":45427,"_5":16788,"_22829":45302,"_2311":45428},[],"RFC 5280: X.509 and CRL profile.",{"_2783":1947,"_24069":1895,"_16893":45430,"_5":16788,"_22829":45302,"_2311":45431},[],"OpenSSL: openssl-crl.",{"_2783":1948,"_24069":1895,"_16893":45433,"_5":16788,"_22829":45302,"_2311":45434},[],"OpenSSL: openssl-verify.",{"_2783":1949,"_24069":1895,"_16893":45436,"_5":16788,"_22829":45302,"_2311":45437},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":1950,"_24069":1895,"_16893":45439,"_5":16788,"_22829":45302,"_2311":45440},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2783":1951,"_24069":1951,"_5":11891,"_2311":45442,"_24405":45443,"_16893":45444,"_22829":1951},"Keys and cryptographic engines",[39337,40681,44140,44141],[],{"_2783":1952,"_24069":1951,"_16893":45446,"_5":16788,"_22829":1951,"_2311":45447},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2783":1953,"_24069":1951,"_5":24402,"_16893":45449,"_22829":45450,"_2311":45451},[],"/docs/pr-preview/pr-27/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2783":1954,"_24069":1951,"_5":24402,"_16893":45453,"_22829":45454,"_2311":45455},[],"/docs/pr-preview/pr-27/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2783":1955,"_24069":1951,"_5":24402,"_16893":45457,"_22829":45458,"_2311":45459},[],"/docs/pr-preview/pr-27/platform/pki/key-management#file-system","File System",{"_2783":1956,"_24069":1951,"_5":24402,"_16893":45461,"_22829":45462,"_2311":45463},[],"/docs/pr-preview/pr-27/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2783":1957,"_24069":1951,"_5":24402,"_16893":45465,"_22829":45466,"_2311":45467},[],"/docs/pr-preview/pr-27/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2783":1958,"_24069":1951,"_5":24402,"_16893":45469,"_22829":45470,"_2311":45471},[],"/docs/pr-preview/pr-27/platform/pki/key-management#aws-kms","AWS KMS",{"_2783":1959,"_24069":1951,"_5":24402,"_16893":45473,"_22829":45474,"_2311":45475},[],"/docs/pr-preview/pr-27/platform/pki/key-management#pkcs11","PKCS#11",{"_2783":1960,"_24069":1951,"_5":24402,"_16893":45477,"_22829":45478,"_2311":45479},[],"/docs/pr-preview/pr-27/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2783":1961,"_24069":1951,"_5":24402,"_16893":45481,"_22829":45482,"_2311":45483},[],"/docs/pr-preview/pr-27/platform/pki/key-management#key-inventory","Key inventory",{"_2783":1962,"_24069":1951,"_5":24402,"_16893":45485,"_22829":45486,"_2311":45487},[],"/docs/pr-preview/pr-27/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2783":1963,"_24069":1951,"_5":24402,"_16893":45489,"_22829":45490,"_2311":45491},[],"/docs/pr-preview/pr-27/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2783":1964,"_24069":1951,"_5":24402,"_16893":45493,"_22829":45494,"_2311":45495},[],"/docs/pr-preview/pr-27/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2783":1965,"_24069":1951,"_5":24402,"_16893":45497,"_22829":45498,"_2311":45499},[],"/docs/pr-preview/pr-27/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2783":1966,"_24069":1951,"_5":24402,"_16893":45501,"_22829":45502,"_2311":45503},[],"/docs/pr-preview/pr-27/platform/pki/key-management#view-details","View details",{"_2783":1967,"_24069":1951,"_5":24402,"_16893":45505,"_22829":45506,"_2311":45507},[],"/docs/pr-preview/pr-27/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2783":1968,"_24069":1951,"_5":24402,"_16893":45509,"_22829":45510,"_2311":45511},[],"/docs/pr-preview/pr-27/platform/pki/key-management#sign","Sign",{"_2783":1969,"_24069":1951,"_5":24402,"_16893":45513,"_22829":45514,"_2311":45515},[],"/docs/pr-preview/pr-27/platform/pki/key-management#verify","Verify",{"_2783":1970,"_24069":1951,"_5":24402,"_16893":45517,"_22829":45518,"_2311":45519},[],"/docs/pr-preview/pr-27/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2783":1971,"_24069":1951,"_5":24402,"_16893":45521,"_22829":45522,"_2311":45523},[],"/docs/pr-preview/pr-27/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2783":1972,"_24069":1951,"_5":24402,"_16893":45525,"_22829":45526,"_2311":45527},[],"/docs/pr-preview/pr-27/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2783":1973,"_24069":1951,"_16893":45529,"_5":16788,"_22829":1951,"_2311":45530},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2783":1974,"_24069":1951,"_16893":45532,"_5":16788,"_22829":1951,"_2311":45533},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2783":1975,"_24069":1951,"_16893":45535,"_5":16788,"_22829":45450,"_2311":45536},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2783":1976,"_24069":1951,"_16893":45538,"_5":16788,"_22829":45450,"_2311":45539},[],"In practice, it lets you:",{"_2783":1977,"_24069":1951,"_16893":45541,"_5":16788,"_22829":45450,"_2311":45542},[],"Generate new key pairs from Lamassu IoT.",{"_2783":1978,"_24069":1951,"_16893":45544,"_5":16788,"_22829":45450,"_2311":45545},[],"Import keys created externally.",{"_2783":1979,"_24069":1951,"_16893":45547,"_5":16788,"_22829":45450,"_2311":45548},[],"Delegate custody and cryptographic operations to external engines.",{"_2783":1980,"_24069":1951,"_16893":45550,"_5":16788,"_22829":45450,"_2311":45551},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2783":1981,"_24069":1951,"_16893":45553,"_5":16788,"_22829":45454,"_2311":45554},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2783":1982,"_24069":1951,"_16893":45556,"_5":16788,"_22829":45454,"_2311":45557},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2783":1983,"_24069":1951,"_16893":45559,"_5":16788,"_22829":45454,"_2311":45560},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2783":1984,"_24069":1951,"_16893":45562,"_5":16788,"_22829":45458,"_2311":45563},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2783":1985,"_24069":1951,"_16893":45565,"_5":16788,"_22829":45462,"_2311":45566},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2783":1986,"_24069":1951,"_16893":45568,"_5":16788,"_22829":45466,"_2311":45569},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2783":1987,"_24069":1951,"_16893":45571,"_5":16788,"_22829":45470,"_2311":45572},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2783":1988,"_24069":1951,"_16893":45574,"_5":16788,"_22829":45474,"_2311":45575},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2783":1989,"_24069":1951,"_16893":45577,"_5":16788,"_22829":45478,"_2311":45578},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2783":1990,"_24069":1951,"_16893":45580,"_5":16788,"_22829":45478,"_2311":45581},[],"Lamassu shows the enabled engines in the console.",{"_2783":1991,"_24069":1951,"_16893":45583,"_5":16788,"_22829":45478,"_2311":45584},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2783":1992,"_24069":1951,"_16893":45586,"_5":16788,"_22829":45478,"_2311":45587},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2783":1993,"_24069":1951,"_16893":45589,"_5":16788,"_22829":45482,"_2311":45590},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2783":1994,"_24069":1951,"_16893":45592,"_5":16788,"_22829":45482,"_2311":45593},[],"The table includes the following fields:",{"_2783":1995,"_24069":1951,"_16893":45595,"_5":16788,"_22829":45482,"_2311":45596},[],"**Name**: descriptive name of the key.",{"_2783":1996,"_24069":1951,"_16893":45598,"_5":16788,"_22829":45482,"_2311":45599},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2783":1997,"_24069":1951,"_16893":45601,"_5":16788,"_22829":45482,"_2311":45602},[],"**Strength**: visual indicator of cryptographic strength.",{"_2783":1998,"_24069":1951,"_16893":45604,"_5":16788,"_22829":45482,"_2311":45605},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2783":1999,"_24069":1951,"_16893":45607,"_5":16788,"_22829":45482,"_2311":45608},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2783":2000,"_24069":1951,"_16893":45610,"_5":16788,"_22829":45482,"_2311":45611},[],"**Aliases**: alternative names associated with the key.",{"_2783":2001,"_24069":1951,"_16893":45613,"_5":16788,"_22829":45482,"_2311":45614},[],"**Tags**: labels for classification and search.",{"_2783":2002,"_24069":1951,"_16893":45616,"_5":16788,"_22829":45482,"_2311":45617},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2783":2003,"_24069":1951,"_16893":45619,"_5":16788,"_22829":45482,"_2311":45620},[],"From this view you also reach the most common actions:",{"_2783":2004,"_24069":1951,"_16893":45622,"_5":16788,"_22829":45482,"_2311":45623},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2783":2005,"_24069":1951,"_16893":45625,"_5":16788,"_22829":45482,"_2311":45626},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2783":2006,"_24069":1951,"_16893":45628,"_5":16788,"_22829":45482,"_2311":45629},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2783":2007,"_24069":1951,"_16893":45631,"_5":16788,"_22829":45482,"_2311":45632},[],"**Delete Key** to remove the key from the system.",{"_2783":2008,"_24069":1951,"_16893":45634,"_5":16788,"_22829":45486,"_2311":45635},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2783":2009,"_24069":1951,"_16893":45637,"_5":16788,"_22829":45490,"_2311":45638},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2783":2010,"_24069":1951,"_16893":45640,"_5":16788,"_22829":45490,"_2311":45641},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2783":2011,"_24069":1951,"_16893":45643,"_5":16788,"_22829":45490,"_2311":45644},[],"**Key Name**: unique and descriptive name.",{"_2783":2012,"_24069":1951,"_16893":45646,"_5":16788,"_22829":45490,"_2311":45647},[],"**Crypto Engine**: engine that will keep the key.",{"_2783":2013,"_24069":1951,"_16893":45649,"_5":16788,"_22829":45490,"_2311":45650},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2783":2014,"_24069":1951,"_16893":45652,"_5":16788,"_22829":45490,"_2311":45653},[],"**Tags**: metadata to classify the key.",{"_2783":2015,"_24069":1951,"_16893":45655,"_5":16788,"_22829":45490,"_2311":45656},[],"**Metadata**: additional information for advanced uses.",{"_2783":2016,"_24069":1951,"_16893":45658,"_5":16788,"_22829":45494,"_2311":45659},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2783":2017,"_24069":1951,"_16893":45661,"_5":16788,"_22829":45494,"_2311":45662},[],"When you have an exportable private key and the destination engine supports import.",{"_2783":2018,"_24069":1951,"_16893":45664,"_5":16788,"_22829":45494,"_2311":45665},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2783":2019,"_24069":1951,"_16893":45667,"_5":16788,"_22829":45494,"_2311":45668},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2783":2020,"_24069":1951,"_16893":45670,"_5":16788,"_22829":45494,"_2311":45671},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2783":2021,"_24069":1951,"_16893":45673,"_5":16788,"_22829":45494,"_2311":45674},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2783":2022,"_24069":1951,"_16893":45676,"_5":16788,"_22829":45494,"_2311":45677},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2783":2023,"_24069":1951,"_16893":45679,"_5":16788,"_22829":45494,"_2311":45680},[],"**Tags**: labels for organization and search.",{"_2783":2024,"_24069":1951,"_16893":45682,"_5":16788,"_22829":45494,"_2311":45683},[],"**Metadata**: additional optional information.",{"_2783":2025,"_24069":1951,"_16893":45685,"_5":16788,"_22829":45494,"_2311":45686},[],"**Private Key (PEM)**: private key in PEM format.",{"_2783":2026,"_24069":1951,"_16893":45688,"_5":16788,"_22829":45494,"_2311":45689},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2783":2027,"_24069":1951,"_16893":45691,"_5":16788,"_22829":45498,"_2311":45692},[],"Each registered key has a detail view and several operational actions.",{"_2783":2028,"_24069":1951,"_16893":45694,"_5":16788,"_22829":45502,"_2311":45695},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2783":2029,"_24069":1951,"_16893":45697,"_5":16788,"_22829":45502,"_2311":45698},[],"The **Overview** tab shows, among others, these fields:",{"_2783":2030,"_24069":1951,"_16893":45700,"_5":16788,"_22829":45502,"_2311":45701},[],"**Key Name**: descriptive name.",{"_2783":2031,"_24069":1951,"_16893":45703,"_5":16788,"_22829":45502,"_2311":45704},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2783":2032,"_24069":1951,"_16893":45706,"_5":16788,"_22829":45502,"_2311":45707},[],"**Tags**: associated labels.",{"_2783":2033,"_24069":1951,"_16893":45709,"_5":16788,"_22829":45502,"_2311":45710},[],"**Aliases**: alternative names.",{"_2783":2034,"_24069":1951,"_16893":45712,"_5":16788,"_22829":45502,"_2311":45713},[],"**Crypto Engine**: engine where the key resides.",{"_2783":2035,"_24069":1951,"_16893":45715,"_5":16788,"_22829":45502,"_2311":45716},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2783":2036,"_24069":1951,"_16893":45718,"_5":16788,"_22829":45502,"_2311":45719},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2783":2037,"_24069":1951,"_16893":45721,"_5":16788,"_22829":45502,"_2311":45722},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2783":2038,"_24069":1951,"_16893":45724,"_5":16788,"_22829":45506,"_2311":45725},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2783":2039,"_24069":1951,"_16893":45727,"_5":16788,"_22829":45506,"_2311":45728},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2783":2040,"_24069":1951,"_16893":45730,"_5":16788,"_22829":45506,"_2311":45731},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2783":2041,"_24069":1951,"_16893":45733,"_5":16788,"_22829":45510,"_2311":45734},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2783":2042,"_24069":1951,"_16893":45736,"_5":16788,"_22829":45510,"_2311":45737},[],"Main fields:",{"_2783":2043,"_24069":1951,"_16893":45739,"_5":16788,"_22829":45510,"_2311":45740},[],"**Algorithm**: signing algorithm available for the key type.",{"_2783":2044,"_24069":1951,"_16893":45742,"_5":16788,"_22829":45510,"_2311":45743},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2783":2045,"_24069":1951,"_16893":45745,"_5":16788,"_22829":45510,"_2311":45746},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2783":2046,"_24069":1951,"_16893":45748,"_5":16788,"_22829":45510,"_2311":45749},[],"**Message**: content to sign.",{"_2783":2047,"_24069":1951,"_16893":45751,"_5":16788,"_22829":45510,"_2311":45752},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2783":2048,"_24069":1951,"_16893":45754,"_5":16788,"_22829":45514,"_2311":45755},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2783":2049,"_24069":1951,"_16893":45757,"_5":16788,"_22829":45514,"_2311":45737},[],{"_2783":2050,"_24069":1951,"_16893":45759,"_5":16788,"_22829":45514,"_2311":45760},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2783":2051,"_24069":1951,"_16893":45762,"_5":16788,"_22829":45514,"_2311":45763},[],"**Message Type**: `Raw` or `Digest`.",{"_2783":2052,"_24069":1951,"_16893":45765,"_5":16788,"_22829":45514,"_2311":45766},[],"**Payload Encoding**: encoding of the message.",{"_2783":2053,"_24069":1951,"_16893":45768,"_5":16788,"_22829":45514,"_2311":45769},[],"**Message**: original message or hash.",{"_2783":2054,"_24069":1951,"_16893":45771,"_5":16788,"_22829":45514,"_2311":45772},[],"**Signature**: signature to check.",{"_2783":2055,"_24069":1951,"_16893":45774,"_5":16788,"_22829":45514,"_2311":45775},[],"**Result**: indicator of the validation result.",{"_2783":2056,"_24069":1951,"_16893":45777,"_5":16788,"_22829":45518,"_2311":45778},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2783":2057,"_24069":1951,"_16893":45780,"_5":16788,"_22829":45518,"_2311":45781},[],"This flow is useful for:",{"_2783":2058,"_24069":1951,"_16893":45783,"_5":16788,"_22829":45518,"_2311":45784},[],"Requesting certificates from an external CA.",{"_2783":2059,"_24069":1951,"_16893":45786,"_5":16788,"_22829":45518,"_2311":45787},[],"Renewing an identity while keeping the same key.",{"_2783":2060,"_24069":1951,"_16893":45789,"_5":16788,"_22829":45518,"_2311":45790},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2783":2061,"_24069":1951,"_16893":45792,"_5":16788,"_22829":45518,"_2311":45793},[],"**Common Name (CN)**: main name of the identity.",{"_2783":2062,"_24069":1951,"_16893":45795,"_5":16788,"_22829":45518,"_2311":45796},[],"**Organization (O)**: organization or company.",{"_2783":2063,"_24069":1951,"_16893":45798,"_5":16788,"_22829":45518,"_2311":45799},[],"**Organizational Unit (OU)**: department or unit.",{"_2783":2064,"_24069":1951,"_16893":45801,"_5":16788,"_22829":45518,"_2311":45802},[],"**Country (C)**: two-letter country code.",{"_2783":2065,"_24069":1951,"_16893":45804,"_5":16788,"_22829":45518,"_2311":45805},[],"**State / Province (ST)**: state or province.",{"_2783":2066,"_24069":1951,"_16893":45807,"_5":16788,"_22829":45518,"_2311":45808},[],"**Locality (L)**: city or locality.",{"_2783":2067,"_24069":1951,"_16893":45810,"_5":16788,"_22829":45518,"_2311":45811},[],"**Email Address**: contact email.",{"_2783":2068,"_24069":1951,"_16893":45813,"_5":16788,"_22829":45518,"_2311":45814},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2783":2069,"_24069":1951,"_16893":45816,"_5":16788,"_22829":45518,"_2311":45817},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2783":2070,"_24069":1951,"_16893":45819,"_5":16788,"_22829":45522,"_2311":45820},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2783":2071,"_24069":1951,"_16893":45822,"_5":16788,"_22829":45522,"_2311":45823},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2783":2072,"_24069":1951,"_16893":45825,"_5":16788,"_22829":45526,"_2311":45826},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2783":2073,"_24069":2073,"_5":11891,"_2311":45828,"_24405":45829,"_16893":45830,"_22829":2073},"Online validation with OCSP",[39337,40681,44140,44757],[],{"_2783":2074,"_24069":2073,"_16893":45832,"_5":16788,"_22829":2073,"_2311":45833},[],"Query signed status and verify the responder’s response.",{"_2783":2075,"_24069":2073,"_5":24402,"_16893":45835,"_22829":45836,"_2311":45837},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2783":2076,"_24069":2073,"_5":24402,"_16893":45839,"_22829":45840,"_2311":45841},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2783":2077,"_24069":2073,"_5":24402,"_16893":45843,"_22829":45844,"_2311":45845},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2783":2078,"_24069":2073,"_5":24402,"_16893":45847,"_22829":45848,"_2311":45849},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2783":2079,"_24069":2073,"_5":24402,"_16893":45851,"_22829":45852,"_2311":45853},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2783":2080,"_24069":2073,"_5":24402,"_16893":45855,"_22829":45856,"_2311":45303},[],"/docs/pr-preview/pr-27/platform/pki/ocsp#references",{"_2783":2081,"_24069":2073,"_16893":45858,"_5":16788,"_22829":2073,"_2311":45859},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2783":2082,"_24069":2073,"_16893":45861,"_5":16788,"_22829":45836,"_2311":45862},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2783":2083,"_24069":2073,"_16893":45864,"_5":16788,"_22829":45836,"_2311":45865},[],"Record status",{"_2783":2084,"_24069":2073,"_16893":45867,"_5":16788,"_22829":45836,"_2311":45868},[],"Signed response",{"_2783":2085,"_24069":2073,"_16893":45870,"_5":16788,"_22829":45836,"_2311":43318},[],{"_2783":2086,"_24069":2073,"_16893":45872,"_5":16788,"_22829":45836,"_2311":45873},[],"`Good`.",{"_2783":2087,"_24069":2073,"_16893":45875,"_5":16788,"_22829":45836,"_2311":43335},[],{"_2783":2088,"_24069":2073,"_16893":45877,"_5":16788,"_22829":45836,"_2311":45878},[],"`Revoked`, with revocation reason and timestamp.",{"_2783":2089,"_24069":2073,"_16893":45880,"_5":16788,"_22829":45836,"_2311":45881},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2783":2090,"_24069":2073,"_16893":45883,"_5":16788,"_22829":45836,"_2311":45884},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2783":2091,"_24069":2073,"_16893":45886,"_5":16788,"_22829":45836,"_2311":45887},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2783":2092,"_24069":2073,"_16893":45889,"_5":16788,"_22829":45836,"_2311":45890},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2783":2093,"_24069":2073,"_16893":45892,"_5":16788,"_22829":45836,"_2311":45893},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2783":2094,"_24069":2073,"_16893":45895,"_5":16788,"_22829":45840,"_2311":45896},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2783":2095,"_24069":2073,"_16893":45898,"_5":16788,"_22829":45840,"_2311":45899},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2783":2096,"_24069":2073,"_16893":45901,"_5":16788,"_22829":45844,"_2311":45902},[],"The service accepts:",{"_2783":2097,"_24069":2073,"_16893":45904,"_5":16788,"_22829":45844,"_2311":42213},[],{"_2783":2098,"_24069":2073,"_16893":45906,"_5":16788,"_22829":45844,"_2311":45907},[],"VA service path",{"_2783":2099,"_24069":2073,"_16893":45909,"_5":16788,"_22829":45844,"_2311":45910},[],"Format",{"_2783":2100,"_24069":2073,"_16893":45912,"_5":16788,"_22829":45844,"_2311":45913},[],"`POST`",{"_2783":2101,"_24069":2073,"_16893":45915,"_5":16788,"_22829":45844,"_2311":45916},[],"`/ocsp`",{"_2783":2102,"_24069":2073,"_16893":45918,"_5":16788,"_22829":45844,"_2311":45919},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2783":2103,"_24069":2073,"_16893":45921,"_5":16788,"_22829":45844,"_2311":45402},[],{"_2783":2104,"_24069":2073,"_16893":45923,"_5":16788,"_22829":45844,"_2311":45924},[],"`/ocsp/{ocsp_request}`",{"_2783":2105,"_24069":2073,"_16893":45926,"_5":16788,"_22829":45844,"_2311":45927},[],"DER request encoded using padded URL Base64.",{"_2783":2106,"_24069":2073,"_16893":45929,"_5":16788,"_22829":45844,"_2311":45930},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2783":2107,"_24069":2073,"_16893":45932,"_5":16788,"_22829":45848,"_2311":45933},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2783":2108,"_24069":2073,"_16893":45935,"_5":16788,"_22829":45848,"_2311":45936},[],"Generate the request:",{"_2783":2109,"_24069":2073,"_16893":45938,"_5":16788,"_22829":45848,"_2311":45939},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2783":2110,"_24069":2073,"_16893":45941,"_5":16788,"_22829":45848,"_2311":45942},[],"Replace the example URL with the inspected endpoint:",{"_2783":2111,"_24069":2073,"_16893":45944,"_5":16788,"_22829":45848,"_2311":45945},[],"Verify the returned DER:",{"_2783":2112,"_24069":2073,"_16893":45947,"_5":16788,"_22829":45848,"_2311":45948},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2783":2113,"_24069":2073,"_16893":45950,"_5":16788,"_22829":45852,"_2311":45951},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2783":2114,"_24069":2073,"_16893":45953,"_5":16788,"_22829":45852,"_2311":45954},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2783":2115,"_24069":2073,"_16893":45956,"_5":16788,"_22829":45856,"_2311":45957},[],"RFC 6960: OCSP.",{"_2783":2116,"_24069":2073,"_16893":45959,"_5":16788,"_22829":45856,"_2311":45960},[],"OpenSSL: openssl-ocsp.",{"_2783":2117,"_24069":2073,"_16893":45962,"_5":16788,"_22829":45856,"_2311":45963},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2783":2118,"_24069":2073,"_16893":45965,"_5":16788,"_22829":45856,"_2311":45440},[],{"_2783":2119,"_24069":2119,"_5":11891,"_2311":44140,"_24405":45967,"_16893":45968,"_22829":2119},[39337,40681,44140],[],{"_2783":2120,"_24069":2119,"_16893":45970,"_5":16788,"_22829":2119,"_2311":45971},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2783":2121,"_24069":2119,"_5":24402,"_16893":45973,"_22829":45974,"_2311":43450},[],"/docs/pr-preview/pr-27/platform/pki/overview#start-here",{"_2783":2122,"_24069":2119,"_5":24402,"_16893":45976,"_22829":45977,"_2311":45978},[],"/docs/pr-preview/pr-27/platform/pki/overview#what-you-need","What you need",{"_2783":2123,"_24069":2119,"_5":24402,"_16893":45980,"_22829":45981,"_2311":43984},[],"/docs/pr-preview/pr-27/platform/pki/overview#core-capabilities",{"_2783":2124,"_24069":2119,"_5":24402,"_16893":45983,"_22829":45984,"_2311":43988},[],"/docs/pr-preview/pr-27/platform/pki/overview#build-your-trust-hierarchy",{"_2783":2125,"_24069":2119,"_5":24402,"_16893":45986,"_22829":45987,"_2311":43992},[],"/docs/pr-preview/pr-27/platform/pki/overview#protect-cryptographic-keys",{"_2783":2126,"_24069":2119,"_5":24402,"_16893":45989,"_22829":45990,"_2311":43996},[],"/docs/pr-preview/pr-27/platform/pki/overview#issue-and-control-certificates",{"_2783":2127,"_24069":2119,"_5":24402,"_16893":45992,"_22829":45993,"_2311":44004},[],"/docs/pr-preview/pr-27/platform/pki/overview#publish-validation-status",{"_2783":2128,"_24069":2119,"_5":24402,"_16893":45995,"_22829":45996,"_2311":45997},[],"/docs/pr-preview/pr-27/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2783":2129,"_24069":2119,"_5":24402,"_16893":45999,"_22829":46000,"_2311":44924},[],"/docs/pr-preview/pr-27/platform/pki/overview#continue",{"_2783":2130,"_24069":2119,"_16893":46002,"_5":16788,"_22829":2119,"_2311":46003},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2783":2131,"_24069":2119,"_16893":46005,"_5":16788,"_22829":45974,"_2311":46006},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2783":2132,"_24069":2119,"_16893":46008,"_5":16788,"_22829":45974,"_2311":46009},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2783":2133,"_24069":2119,"_16893":46011,"_5":16788,"_22829":45977,"_2311":46012},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2783":2134,"_24069":2119,"_16893":46014,"_5":16788,"_22829":45977,"_2311":46015},[],"An available cryptographic engine to keep the authority's key.",{"_2783":2135,"_24069":2119,"_16893":46017,"_5":16788,"_22829":45977,"_2311":46018},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2783":2136,"_24069":2119,"_16893":46020,"_5":16788,"_22829":45977,"_2311":46021},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2783":2137,"_24069":2119,"_16893":46023,"_5":16788,"_22829":45977,"_2311":46024},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2783":2138,"_24069":2119,"_16893":46026,"_5":16788,"_22829":45984,"_2311":46027},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2783":2139,"_24069":2119,"_16893":46029,"_5":16788,"_22829":45987,"_2311":46030},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2783":2140,"_24069":2119,"_16893":46032,"_5":16788,"_22829":45990,"_2311":46033},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2783":2141,"_24069":2119,"_16893":46035,"_5":16788,"_22829":45993,"_2311":46036},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2783":2142,"_24069":2119,"_16893":46038,"_5":16788,"_22829":45996,"_2311":46039},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2783":2143,"_24069":2119,"_16893":46041,"_5":16788,"_22829":45996,"_2311":46042},[],"its subject and extensions identify the expected client;",{"_2783":2144,"_24069":2119,"_16893":46044,"_5":16788,"_22829":45996,"_2311":46045},[],"its public key matches the client's private key;",{"_2783":2145,"_24069":2119,"_16893":46047,"_5":16788,"_22829":45996,"_2311":46048},[],"its chain reaches a root trusted by the consumer;",{"_2783":2146,"_24069":2119,"_16893":46050,"_5":16788,"_22829":45996,"_2311":46051},[],"its dates and usages allow the operation;",{"_2783":2147,"_24069":2119,"_16893":46053,"_5":16788,"_22829":45996,"_2311":46054},[],"the consumer applies revocation checks and authorization.",{"_2783":2148,"_24069":2119,"_16893":46056,"_5":16788,"_22829":45996,"_2311":46057},[],"The issuance path includes the first independent checks.",{"_2783":2149,"_24069":2119,"_16893":46059,"_5":16788,"_22829":46000,"_2311":46060},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2783":2150,"_24069":2119,"_16893":46062,"_5":16788,"_22829":46000,"_2311":46063},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2783":2151,"_24069":2119,"_16893":46065,"_5":16788,"_22829":46000,"_2311":46066},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2783":2152,"_24069":2152,"_5":11891,"_2311":46068,"_24405":46069,"_16893":46070,"_22829":2152},"Create your first CA",[39337,40681,44140,43575],[],{"_2783":2153,"_24069":2152,"_16893":46072,"_5":16788,"_22829":2152,"_2311":46073},[],"Create an evaluation root and check its certificate before issuing.",{"_2783":2154,"_24069":2152,"_5":24402,"_16893":46075,"_22829":46076,"_2311":39347},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2783":2155,"_24069":2152,"_5":24402,"_16893":46078,"_22829":46079,"_2311":46080},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2783":2156,"_24069":2152,"_5":24402,"_16893":46082,"_22829":46083,"_2311":46084},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2783":2157,"_24069":2152,"_5":24402,"_16893":46086,"_22829":46087,"_2311":46088},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2783":2158,"_24069":2152,"_5":24402,"_16893":46090,"_22829":46091,"_2311":46092},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2783":2159,"_24069":2152,"_5":24402,"_16893":46094,"_22829":46095,"_2311":46096},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2783":2160,"_24069":2152,"_5":24402,"_16893":46098,"_22829":46099,"_2311":46100},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2783":2161,"_24069":2152,"_5":24402,"_16893":46102,"_22829":46103,"_2311":43833},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2783":2162,"_24069":2152,"_5":24402,"_16893":46105,"_22829":46106,"_2311":39371},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2783":2163,"_24069":2152,"_16893":46108,"_5":16788,"_22829":2152,"_2311":46109},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2783":2164,"_24069":2152,"_16893":46111,"_5":16788,"_22829":46076,"_2311":46112},[],"Console access and permission to create keys and authorities.",{"_2783":2165,"_24069":2152,"_16893":46114,"_5":16788,"_22829":46076,"_2311":46115},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2783":2166,"_24069":2152,"_16893":46117,"_5":16788,"_22829":46076,"_2311":46118},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2783":2167,"_24069":2152,"_16893":46120,"_5":16788,"_22829":46076,"_2311":46121},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2783":2168,"_24069":2152,"_16893":46123,"_5":16788,"_22829":46079,"_2311":46124},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2783":2169,"_24069":2152,"_16893":46126,"_5":16788,"_22829":46079,"_2311":46127},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2783":2170,"_24069":2152,"_16893":46129,"_5":16788,"_22829":46083,"_2311":46130},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2783":2171,"_24069":2152,"_16893":46132,"_5":16788,"_22829":46083,"_2311":46133},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2783":2172,"_24069":2152,"_16893":46135,"_5":16788,"_22829":46087,"_2311":46136},[],"Select **Root CA** and complete:",{"_2783":2173,"_24069":2152,"_16893":46138,"_5":16788,"_22829":46087,"_2311":46139},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2783":2174,"_24069":2152,"_16893":46141,"_5":16788,"_22829":46087,"_2311":46142},[],"**Subject**: organization and country details for your evaluation.",{"_2783":2175,"_24069":2152,"_16893":46144,"_5":16788,"_22829":46087,"_2311":46145},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2783":2176,"_24069":2152,"_16893":46147,"_5":16788,"_22829":46087,"_2311":46148},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2783":2177,"_24069":2152,"_16893":46150,"_5":16788,"_22829":46087,"_2311":46151},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2783":2178,"_24069":2152,"_16893":46153,"_5":16788,"_22829":46091,"_2311":46154},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2783":2179,"_24069":2152,"_16893":46156,"_5":16788,"_22829":46095,"_2311":46157},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2783":2180,"_24069":2152,"_16893":46159,"_5":16788,"_22829":46095,"_2311":46160},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2783":2181,"_24069":2152,"_16893":46162,"_5":16788,"_22829":46099,"_2311":46163},[],"Run from the directory where you saved `ca.pem`:",{"_2783":2182,"_24069":2152,"_16893":46165,"_5":16788,"_22829":46099,"_2311":46166},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2783":2183,"_24069":2152,"_16893":46168,"_5":16788,"_22829":46099,"_2311":46169},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2783":2184,"_24069":2152,"_16893":46171,"_5":16788,"_22829":46103,"_2311":46172},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2783":2185,"_24069":2152,"_16893":46174,"_5":16788,"_22829":46103,"_2311":46175},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2783":2186,"_24069":2152,"_16893":46177,"_5":16788,"_22829":46103,"_2311":46178},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2783":2187,"_24069":2152,"_16893":46180,"_5":16788,"_22829":46103,"_2311":46181},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2783":2188,"_24069":2152,"_16893":46183,"_5":16788,"_22829":46106,"_2311":46184},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2783":2189,"_24069":2189,"_5":11891,"_2311":46186,"_24405":46187,"_16893":46188,"_22829":2189},"Issue and verify a certificate",[39337,40681,44140,43575],[],{"_2783":2190,"_24069":2189,"_16893":46190,"_5":16788,"_22829":2189,"_2311":46191},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2783":2191,"_24069":2189,"_5":24402,"_16893":46193,"_22829":46194,"_2311":39347},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2783":2192,"_24069":2189,"_5":24402,"_16893":46196,"_22829":46197,"_2311":46198},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2783":2193,"_24069":2189,"_5":24402,"_16893":46200,"_22829":46201,"_2311":46202},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2783":2194,"_24069":2189,"_5":24402,"_16893":46204,"_22829":46205,"_2311":46206},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2783":2195,"_24069":2189,"_5":24402,"_16893":46208,"_22829":46209,"_2311":46210},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2783":2196,"_24069":2189,"_5":24402,"_16893":46212,"_22829":46213,"_2311":46214},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2783":2197,"_24069":2189,"_5":24402,"_16893":46216,"_22829":46217,"_2311":46096},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2783":2198,"_24069":2189,"_5":24402,"_16893":46219,"_22829":46220,"_2311":46221},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2783":2199,"_24069":2189,"_5":24402,"_16893":46223,"_22829":46224,"_2311":46225},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2783":2200,"_24069":2189,"_5":24402,"_16893":46227,"_22829":46228,"_2311":46229},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2783":2201,"_24069":2189,"_5":24402,"_16893":46231,"_22829":46232,"_2311":43833},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2783":2202,"_24069":2189,"_5":24402,"_16893":46234,"_22829":46235,"_2311":39371},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/issue-certificate#next-step",{"_2783":2203,"_24069":2189,"_16893":46237,"_5":16788,"_22829":2189,"_2311":46238},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2783":2204,"_24069":2189,"_16893":46240,"_5":16788,"_22829":46194,"_2311":46241},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2783":2205,"_24069":2189,"_16893":46243,"_5":16788,"_22829":46194,"_2311":46244},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2783":2206,"_24069":2189,"_16893":46246,"_5":16788,"_22829":46194,"_2311":46247},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2783":2207,"_24069":2189,"_16893":46249,"_5":16788,"_22829":46194,"_2311":46250},[],"A client identifier: here we use `device-001`.",{"_2783":2208,"_24069":2189,"_16893":46252,"_5":16788,"_22829":46194,"_2311":46253},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2783":2209,"_24069":2189,"_16893":46255,"_5":16788,"_22829":46197,"_2311":46256},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2783":2210,"_24069":2189,"_16893":46258,"_5":16788,"_22829":46201,"_2311":46259},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2783":2211,"_24069":2189,"_16893":46261,"_5":16788,"_22829":46201,"_2311":46262},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2783":2212,"_24069":2189,"_16893":46264,"_5":16788,"_22829":46205,"_2311":46265},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2783":2213,"_24069":2189,"_16893":46267,"_5":16788,"_22829":46205,"_2311":46268},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2783":2214,"_24069":2189,"_16893":46270,"_5":16788,"_22829":46209,"_2311":46271},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2783":2215,"_24069":2189,"_16893":46273,"_5":16788,"_22829":46209,"_2311":46274},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2783":2216,"_24069":2189,"_16893":46276,"_5":16788,"_22829":46213,"_2311":46277},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2783":2217,"_24069":2189,"_16893":46279,"_5":16788,"_22829":46217,"_2311":46280},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2783":2218,"_24069":2189,"_16893":46282,"_5":16788,"_22829":46220,"_2311":46283},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2783":2219,"_24069":2189,"_16893":46285,"_5":16788,"_22829":46224,"_2311":46286},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2783":2220,"_24069":2189,"_16893":46288,"_5":16788,"_22829":46224,"_2311":46289},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2783":2221,"_24069":2189,"_16893":46291,"_5":16788,"_22829":46224,"_2311":46292},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2783":2222,"_24069":2189,"_16893":46294,"_5":16788,"_22829":46228,"_2311":46295},[],"In Bash, compare the two public-key digests:",{"_2783":2223,"_24069":2189,"_16893":46297,"_5":16788,"_22829":46228,"_2311":46298},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2783":2224,"_24069":2189,"_16893":46300,"_5":16788,"_22829":46228,"_2311":46301},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2783":2225,"_24069":2189,"_16893":46303,"_5":16788,"_22829":46232,"_2311":43917},[],{"_2783":2226,"_24069":2189,"_16893":46305,"_5":16788,"_22829":46232,"_2311":46306},[],"What to review",{"_2783":2227,"_24069":2189,"_16893":46308,"_5":16788,"_22829":46232,"_2311":46309},[],"The CA rejects issuance",{"_2783":2228,"_24069":2189,"_16893":46311,"_5":16788,"_22829":46232,"_2311":46312},[],"Permissions, CA state and key, algorithm and profile.",{"_2783":2229,"_24069":2189,"_16893":46314,"_5":16788,"_22829":46232,"_2311":46315},[],"Different subject or usages",{"_2783":2230,"_24069":2189,"_16893":46317,"_5":16788,"_22829":46232,"_2311":46318},[],"Applied profile and requested values.",{"_2783":2231,"_24069":2189,"_16893":46320,"_5":16788,"_22829":46232,"_2311":46321},[],"Issuer cannot be found",{"_2783":2232,"_24069":2189,"_16893":46323,"_5":16788,"_22829":46232,"_2311":46324},[],"Downloaded CA and required intermediate chain.",{"_2783":2233,"_24069":2189,"_16893":46326,"_5":16788,"_22829":46232,"_2311":46327},[],"Validity fails",{"_2783":2234,"_24069":2189,"_16893":46329,"_5":16788,"_22829":46232,"_2311":46330},[],"Certificate and CA dates, and the computer's clock.",{"_2783":2235,"_24069":2189,"_16893":46332,"_5":16788,"_22829":46232,"_2311":46333},[],"Public-key digests differ",{"_2783":2236,"_24069":2189,"_16893":46335,"_5":16788,"_22829":46232,"_2311":46336},[],"Certificate and key files from the same issuance.",{"_2783":2237,"_24069":2189,"_16893":46338,"_5":16788,"_22829":46232,"_2311":46339},[],"See PKI diagnostics to narrow an issuance failure.",{"_2783":2238,"_24069":2189,"_16893":46341,"_5":16788,"_22829":46235,"_2311":46342},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2783":2239,"_24069":2189,"_16893":46344,"_5":16788,"_22829":46235,"_2311":46345},[],"Manage certificates for inspection, status and revocation.",{"_2783":2240,"_24069":2189,"_16893":46347,"_5":16788,"_22829":46235,"_2311":46348},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2783":2241,"_24069":2189,"_16893":46350,"_5":16788,"_22829":46235,"_2311":46351},[],"Prepare EST for the device to request its next identities.",{"_2783":2242,"_24069":2189,"_16893":46353,"_5":16788,"_22829":46235,"_2311":46354},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2783":2243,"_24069":2243,"_5":11891,"_2311":46356,"_24405":46357,"_16893":46358,"_22829":2243},"PKI getting started",[39337,40681,44140,43575],[],{"_2783":2244,"_24069":2243,"_16893":46360,"_5":16788,"_22829":2243,"_2311":46361},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2783":2245,"_24069":2243,"_5":24402,"_16893":46363,"_22829":46364,"_2311":39347},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/overview#before-you-begin",{"_2783":2246,"_24069":2243,"_5":24402,"_16893":46366,"_22829":46367,"_2311":46368},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2783":2247,"_24069":2243,"_5":24402,"_16893":46370,"_22829":46371,"_2311":43767},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/overview#expected-result",{"_2783":2248,"_24069":2243,"_5":24402,"_16893":46373,"_22829":46374,"_2311":46375},[],"/docs/pr-preview/pr-27/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2783":2249,"_24069":2243,"_16893":46377,"_5":16788,"_22829":2243,"_2311":46378},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2783":2250,"_24069":2243,"_16893":46380,"_5":16788,"_22829":46364,"_2311":46381},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2783":2251,"_24069":2243,"_16893":46383,"_5":16788,"_22829":46364,"_2311":46384},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2783":2252,"_24069":2243,"_16893":46386,"_5":16788,"_22829":46364,"_2311":46387},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2783":2253,"_24069":2243,"_16893":46389,"_5":16788,"_22829":46364,"_2311":46390},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2783":2254,"_24069":2243,"_16893":46392,"_5":16788,"_22829":46364,"_2311":46393},[],"A working directory with restricted access for the downloaded key.",{"_2783":2255,"_24069":2243,"_16893":46395,"_5":16788,"_22829":46367,"_2311":46396},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2783":2256,"_24069":2243,"_16893":46398,"_5":16788,"_22829":46367,"_2311":46399},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2783":2257,"_24069":2243,"_16893":46401,"_5":16788,"_22829":46367,"_2311":46402},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2783":2258,"_24069":2243,"_16893":46404,"_5":16788,"_22829":46367,"_2311":46405},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2783":2259,"_24069":2243,"_16893":46407,"_5":16788,"_22829":46371,"_2311":46408},[],"File or resource",{"_2783":2260,"_24069":2243,"_16893":46410,"_5":16788,"_22829":46371,"_2311":43764},[],{"_2783":2261,"_24069":2243,"_16893":46412,"_5":16788,"_22829":46371,"_2311":46413},[],"Active root CA and `ca.pem`",{"_2783":2262,"_24069":2243,"_16893":46415,"_5":16788,"_22829":46371,"_2311":46416},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2783":2263,"_24069":2243,"_16893":46418,"_5":16788,"_22829":46371,"_2311":46419},[],"End-entity certificate and `device.crt`",{"_2783":2264,"_24069":2243,"_16893":46421,"_5":16788,"_22829":46371,"_2311":46422},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2783":2265,"_24069":2243,"_16893":46424,"_5":16788,"_22829":46371,"_2311":46425},[],"Private key `device.key`",{"_2783":2266,"_24069":2243,"_16893":46427,"_5":16788,"_22829":46371,"_2311":46428},[],"Its public key matches the one included in `device.crt`.",{"_2783":2267,"_24069":2243,"_16893":46430,"_5":16788,"_22829":46371,"_2311":46431},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2783":2268,"_24069":2243,"_16893":46433,"_5":16788,"_22829":46374,"_2311":46434},[],"To operate certificates, continue with Certificates and Validation.",{"_2783":2269,"_24069":2243,"_16893":46436,"_5":16788,"_22829":46374,"_2311":46437},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2783":2270,"_24069":2243,"_16893":46439,"_5":16788,"_22829":46374,"_2311":46440},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2783":2271,"_24069":2271,"_5":11891,"_2311":46442,"_24405":46443,"_16893":46444,"_22829":2271},"PKI troubleshooting",[39337,40681,44140,42961],[],{"_2783":2272,"_24069":2271,"_16893":46446,"_5":16788,"_22829":2271,"_2311":46447},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2783":2273,"_24069":2271,"_5":24402,"_16893":46449,"_22829":46450,"_2311":46451},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2783":2274,"_24069":2271,"_5":24402,"_16893":46453,"_22829":46454,"_2311":46455},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2783":2275,"_24069":2271,"_5":24402,"_16893":46457,"_22829":46458,"_2311":46459},[],"/docs/pr-preview/pr-27/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2783":2276,"_24069":2271,"_16893":46461,"_5":16788,"_22829":2271,"_2311":46462},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2783":2277,"_24069":2271,"_16893":46464,"_5":16788,"_22829":2271,"_2311":46465},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2783":2278,"_24069":2271,"_16893":46467,"_5":16788,"_22829":46450,"_2311":43764},[],{"_2783":2279,"_24069":2271,"_16893":46469,"_5":16788,"_22829":46450,"_2311":46470},[],"What to inspect",{"_2783":2280,"_24069":2271,"_16893":46472,"_5":16788,"_22829":46450,"_2311":39371},[],{"_2783":2281,"_24069":2271,"_16893":46474,"_5":16788,"_22829":46450,"_2311":46475},[],"CA",{"_2783":2282,"_24069":2271,"_16893":46477,"_5":16788,"_22829":46450,"_2311":46478},[],"Exists, is active and has usable dates.",{"_2783":2283,"_24069":2271,"_16893":46480,"_5":16788,"_22829":46450,"_2311":46481},[],"Authorities.",{"_2783":2284,"_24069":2271,"_16893":46483,"_5":16788,"_22829":46450,"_2311":46484},[],"Key",{"_2783":2285,"_24069":2271,"_16893":46486,"_5":16788,"_22829":46450,"_2311":46487},[],"The record has a usable private key and the engine can sign.",{"_2783":2286,"_24069":2271,"_16893":46489,"_5":16788,"_22829":46450,"_2311":46490},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2783":2287,"_24069":2271,"_16893":46492,"_5":16788,"_22829":46450,"_2311":46493},[],"CSR",{"_2783":2288,"_24069":2271,"_16893":46495,"_5":16788,"_22829":46450,"_2311":46496},[],"Correct PEM and verifiable signature.",{"_2783":2289,"_24069":2271,"_16893":46498,"_5":16788,"_22829":46450,"_2311":46499},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2783":2290,"_24069":2271,"_16893":46501,"_5":16788,"_22829":46450,"_2311":46502},[],"Profile",{"_2783":2291,"_24069":2271,"_16893":46504,"_5":16788,"_22829":46450,"_2311":46505},[],"Selected source, existing ID, allowed algorithm and size.",{"_2783":2292,"_24069":2271,"_16893":46507,"_5":16788,"_22829":46450,"_2311":46508},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2783":2293,"_24069":2271,"_16893":46510,"_5":16788,"_22829":46450,"_2311":43917},[],{"_2783":2294,"_24069":2271,"_16893":46512,"_5":16788,"_22829":46450,"_2311":46513},[],"Appropriate subject, SAN, usages and dates.",{"_2783":2295,"_24069":2271,"_16893":46515,"_5":16788,"_22829":46450,"_2311":46516},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2783":2296,"_24069":2271,"_16893":46518,"_5":16788,"_22829":46450,"_2311":46519},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2783":2297,"_24069":2271,"_16893":46521,"_5":16788,"_22829":46450,"_2311":46522},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2783":2298,"_24069":2271,"_16893":46524,"_5":16788,"_22829":46454,"_2311":46525},[],"Check each boundary independently:",{"_2783":2299,"_24069":2271,"_16893":46527,"_5":16788,"_22829":46454,"_2311":46528},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2783":2300,"_24069":2271,"_16893":46530,"_5":16788,"_22829":46454,"_2311":46531},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2783":2301,"_24069":2271,"_16893":46533,"_5":16788,"_22829":46454,"_2311":46534},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2783":2302,"_24069":2271,"_16893":46536,"_5":16788,"_22829":46454,"_2311":46537},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2783":2303,"_24069":2271,"_16893":46539,"_5":16788,"_22829":46454,"_2311":46540},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2783":2304,"_24069":2271,"_16893":46542,"_5":16788,"_22829":46454,"_2311":46543},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2783":2305,"_24069":2271,"_16893":46545,"_5":16788,"_22829":46458,"_2311":46546},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2783":2306,"_24069":2271,"_16893":46548,"_5":16788,"_22829":46458,"_2311":46549},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_46553":46554,"_46555":46556,"_46557":46558,"_46559":46560,"_14693":2333,"_55742":2333},"language","english","sortableProperties",[2311,24069,5,22829],"sortablePropertiesWithTypes",{"_2311":20125,"_24069":20125,"_5":20125,"_22829":20125},"sorts",{"_2311":46561,"_24069":48857,"_5":51152,"_22829":53447},{"_3710":46562,"_46563":46564,"_5":20125},{"_11654":6924,"_11974":5548,"_11981":5503,"_23326":5640,"_22912":2754,"_16026":2546,"_11675":3088,"_11682":2651,"_23288":4377,"_23627":3884,"_23637":2683,"_23301":4068,"_27826":5856,"_23648":16211,"_27831":23747,"_27834":3751,"_27837":3686,"_27840":18652,"_27843":2548,"_23949":2696,"_27848":2557,"_27850":18843,"_23985":6039,"_23939":5132,"_27854":2632,"_27857":5897,"_24127":6958,"_23666":19162,"_23944":11465,"_24003":5002,"_27863":4918,"_27865":3713,"_27867":3790,"_27869":2988,"_27871":8726,"_27873":3387,"_27875":2923,"_27877":4326,"_27879":2688,"_23339":18391,"_27882":8482,"_27884":2748,"_23333":4433,"_27887":4713,"_27889":21961,"_27891":5489,"_27894":6135,"_23369":2752,"_27898":19228,"_23279":15051,"_27901":6139,"_23306":4117,"_27904":9156,"_27906":2646,"_27909":5719,"_23980":5083,"_27912":4642,"_27914":5760,"_27917":2684,"_27919":13062,"_27921":7987,"_27923":8481,"_27925":6111,"_16029":6133,"_27928":20378,"_27930":6014,"_27932":5968,"_23660":7722,"_27935":11296,"_27937":4716,"_27939":4089,"_27941":5867,"_27943":14657,"_27945":3452,"_27947":3192,"_24055":2935,"_23687":3356,"_27951":4613,"_27953":4899,"_2